192_1769466694774172_8837029768878469303_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aj3fWyI5f1AQ7kNvwHt61YS&_nc_oc=AdoVUvNi5OLBGs6SOtkW-Zh3bPG667RSki9zQi3qnxkbvXbxAc2oFVSVaJHsjEizSNE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTDR9qM8m8GwzWRkuJRkyrloc9J67oeLyzaFF73sp3LgA&oe=6AFDB901"}, {"file_name": "screenshot_1.png", "id": "1648053246945793", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499620414_1648053250279126_4048155141077306472_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fBeypqz0t_8Q7kNvwHPVUEj&_nc_oc=AdqjJzArDchX2_Kfl9UZDcVCj0UzrV5zfAi8t9DSOlpC-OFiEpXozj3_ZlWYqpVyPZ8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTNKG_8U6K_9z_eOZhKc52k3weDbQ25v4hfGnz7_fTMBQ&oe=6AFDB1EF"}, {"file_name": "screenshot_3.png", "id": "1843782993305532", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499628456_1843782996638865_4905557601111236817_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zXAVSI7WI3kQ7kNvwEiVtND&_nc_oc=AdqF762KNINoOd505DU10g9dbEzQb1kdQKYi2RGfAg86s8_6Z8U9rWQ2uENpKA_Rdp8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS25GZvA0HtyJTN53odyy5nzO-rTU_90FyEc8sul544Hw&oe=6AFDC218"}, {"file_name": "screenshot_4.png", "id": "1926465011664842", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/593727470_1926465014998175_103146496200635232_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TIjBgH_Hnb4Q7kNvwGFJSsr&_nc_oc=Ado3UEWTDcMPx4WSW2pZjJy7YoD0xK0O0k3j6LvFV13B8RQCb83zrF46tbmDIEIoIZ8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS2yAoG66W-4lPxorcqP3OvlM_nNL7EQK52AbPpOMyeTg&oe=6AFDC813"}, {"file_name": "screenshot_5.png", "id": "2062819447725996", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/793173952_2062819451059329_1611003275032680935_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JThxJOzC0skQ7kNvwGcL8FY&_nc_oc=AdqMNVCuzW-jD4KnYlwGW66B68kQLz2-9oMR7uhddGbrlBDHt1sqckQWdmbo6bWs42M&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSWtNOcMkdSJr5oaKydcXxGDBQx29Dc7pTUEh3g7QjCFg&oe=6AFDC1C1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_cover.png", "id": "1421333472795997", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499627527_1421333476129330_18915893068604533_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VsHuwHP71YsQ7kNvwEXFJpC&_nc_oc=AdpKJe22Cx-0q_oRzdJbz_AM59zZBryEHlwEAzOaCMDsfsUOMw5B3qzrHybl6DR-wkQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSewG5heptUPxvG4VPg7sLRyELJSy6rbELwiycdKt4bXA&oe=6AFDCBA8"}, "display_name": "Tattoo Shop Simulator", "keywords": ["tattoo", "simulator", "ink", "art", "parlor"], "long_description": "Your chair. Your needles. Your reputation.\n\nREAL TATTOOING, LINE BY LINE\nGrab the stencil from the thermal printer and press it onto your customer's forearm - the purple transfer appears right where you put it. Dip the rotary pen in black and trace it. The machine buzzes to life the moment the needle touches skin. A light touch draws a fine line, a firm press lays a bold one, and pushing too deep makes your customer wince.\n\nPACK THE COLOUR\nSwitch to the coil machine, dip it in each ink the design calls for and fill it in. Wipe away the excess with a paper towel and see your work come through clean and bright.\n\nCUSTOMERS WITH THEIR OWN ORDERS\nNine different customers walk in with a design picked from your flash wall. They chat while you work, react when it hurts, and look down at the finished piece before they pay. Lining, colour packing, colour match, clean edges and a gentle hand all count - and great work earns big tips and a photo on your Wall of Fame.\n\nBUILD YOUR SHOP\nEach day brings new customers and new designs to master. Your money and reputation are saved between sessions.\n\nSANDBOX\nNo orders, no score, unlimited ink. Pick any customer and any design, print the stencil or stamp the finished tattoo straight on, laser it off and start again.\n\nA PARLOUR WITH ATMOSPHERE\nExposed brick, a red neon sign over a wall of classic flash, a leather waiting sofa, warm Edison bulbs and a cobbled street at night outside the window - with your own shop radio playing.", "short_description": "Run your own tattoo parlour in VR. Customers walk in off a neon-lit street, sit in your chair and lay their arm on the rest. Press the stencil on, line it with a buzzing rotary pen, pack the colour with a coil machine, wipe it clean and watch them react. Or ink anything you like in Sandbox."}]}, "developer_name": "Citiview Studios", "developer_privacy_policy_url": "https://citiview-games.pages.dev/tattooshopsimulator/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Citiview Studios", "support_website_url": null, "website_url": "https://citiview-games.pages.dev/tattooshopsimulator/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1387157264480809"}}]}, "scheduled_offers": {"count": 0, "nodes": []}, "baseline_offer": null, "is_approved": true, "firstOffer": {"nodes": []}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1387301354466400", "version": "1.0.1"}, "id"
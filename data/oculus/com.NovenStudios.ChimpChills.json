png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YyykFZXRc0IQ7kNvwHG5WGc&_nc_oc=AdrlsxShSDv9XX12SmmRZ0W3WPkE-TPnzMVNhZIJmr3KtMeAeFMA8xDy_NKPJXeX8p8&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQWw_0yaN5IbRQF2LNgIc8FOQwbSqWgVdHTMbsmefHeQA&oe=6B09A1CB"}, {"file_name": "New Project (89).png", "id": "930057559907322", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/499308349_930057563240655_8803087660890779206_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rzYpDTGTW58Q7kNvwGDAHZn&_nc_oc=AdrSwuyU9a77rDy_YSNDzHWp7pkQrkcHwDaEXHaCIaW-sif4ID9DTc7t63kfbwFP3vU&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRfdcJwJUduC06_ZA61VpTXSyvc0pOkHdpUpziRsffvQw&oe=6B09BE92"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "ChimpChills", "keywords": [], "long_description": "ChimpChills is a fast-paced VR movement game built around smooth locomotion, fun mechanics, and social chaos.\n\nMove freely using your hands, climb, jump, and launch yourself through maps designed for speed and creativity. Whether you're racing friends, exploring, or just messing around, every session feels different.\n\nBuilt for players who love movement-based VR games, ChimpChills focuses on:\n\u2022 Smooth and responsive locomotion\n\u2022 Fun, replayable environments\n\u2022 Social interaction and multiplayer chaos\n\u2022 Clean, simple mechanics that feel great to use\n\nThis game is currently in development, which means updates, improvements, and new features are coming over time.\n\nJump in early, explore the world, and be part of shaping ChimpChills.", "short_description": "Fast-paced monkey parkour with smooth movement, chaotic fun, and social vibes in VR."}]}, "developer_name": "NovenStudios", "developer_privacy_policy_url": "https://sites.google.com/view/chimp-chills/privacy-policy-chimpchills", "developer_terms_of_service_url": null, "publisher_name": "NovenStudios", "support
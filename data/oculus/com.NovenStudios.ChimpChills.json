gC3vZf6N2Tw4XS8iX8pycQpXKMS7xpoCxol7rCA9VYpuAx1gmbDtj1dyWfSm4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af1ydFLZXTRRBADvrMH-dEiuozwFQ41fjicimVxqPwYhHg&oe=69F0B6D2"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "ChimpChills", "keywords": [], "long_description": "ChimpChills is a fast-paced VR movement game built around smooth locomotion, fun mechanics, and social chaos.\n\nMove freely using your hands, climb, jump, and launch yourself through maps designed for speed and creativity. Whether you're racing friends, exploring, or just messing around, every session feels different.\n\nBuilt for players who love movement-based VR games, ChimpChills focuses on:\n\u2022 Smooth and responsive locomotion\n\u2022 Fun, replayable environments\n\u2022 Social interaction and multiplayer chaos\n\u2022 Clean, simple mechanics that feel great to use\n\nThis game is currently in development, which means updates, improvements, and new features are coming over time.\n\nJump in early, explore the world, and be part of shaping ChimpChills.", "short_description": "Fast-paced monkey parkour with smooth movement, chaotic fun, and social vibes in VR."}]}, "developer_name": "NovenStudios", "developer_privacy_policy_url": "https://sites.google.com/view/chimp-chills/privacy-policy-chimpchills", "developer_terms_of_service_url": null, "publisher_name": "NovenStudios", "support_website_url": null, "website_url": "https://sites.google.com/view/chimp-chills/about-chimpchills", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}, {"id": "1023770785722696"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "
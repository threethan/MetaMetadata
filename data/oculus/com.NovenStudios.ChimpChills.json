=6AA17B4B"}, {"file_name": "New Project (89).png", "id": "930057559907322", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/499308349_930057563240655_8803087660890779206_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dP2OaO4BLD0Q7kNvwElRcq4&_nc_oc=Ado9TqJppPxKTjIz6tgS0FPjlf6PsUh5jNG2es5Vt0pjBeCFpn4shRYybbbOmBojO3I&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLvV6xl_Rmf8ZzcnfYpCH0LzWreXSiG6YYuRxrEtVHI-g&oe=6AA15FD2"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "ChimpChills", "keywords": [], "long_description": "ChimpChills is a fast-paced VR movement game built around smooth locomotion, fun mechanics, and social chaos.\n\nMove freely using your hands, climb, jump, and launch yourself through maps designed for speed and creativity. Whether you're racing friends, exploring, or just messing around, every session feels different.\n\nBuilt for players who love movement-based VR games, ChimpChills focuses on:\n\u2022 Smooth and responsive locomotion\n\u2022 Fun, replayable environments\n\u2022 Social interaction and multiplayer chaos\n\u2022 Clean, simple mechanics that feel great to use\n\nThis game is currently in development, which means updates, improvements, and new features are coming over time.\n\nJump in early, explore the world, and be part of shaping ChimpChills.", "short_description": "Fast-paced monkey parkour with smooth movement, chaotic fun, and social vibes in VR."}]}, "developer_name": "NovenStudios", "developer_privacy_policy_url": "https://sites.google.com/view/chimp-chills/privacy-policy-chimpchills", "developer_terms_of_service_url": null, "publisher_name": "NovenStudios", "support_website_url": null, "website_url": "https://sites.google.com/view/chimp-chills/about-chimpchills", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2
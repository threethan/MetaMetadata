png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JvX__UY33yMQ7kNvwF-VbTI&_nc_oc=AdpPK75obQyVNYdcPkcfbFMSi4hskGNUz18QSwa_plY55QXZw0ThOMhuwbOEo5WiaRY&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTi8iFpbD8IlQKbNdzhJEcb_uFata2k3p1LG_F1zSvIMw&oe=6B030A4B"}, {"file_name": "New Project (89).png", "id": "930057559907322", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499308349_930057563240655_8803087660890779206_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rwt-YaXAzgIQ7kNvwFIlK8x&_nc_oc=AdrHaes1XuE_aC4l3wHnmJZRS2yOvNFeiJ1qr0dFkBlhcipie-VuSCy6QWhMGBl1PO8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSpyTSls9sAIAmVo7RzA9XUxBZzqMI0jVe027-x2UnC9w&oe=6B032712"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "ChimpChills", "keywords": [], "long_description": "ChimpChills is a fast-paced VR movement game built around smooth locomotion, fun mechanics, and social chaos.\n\nMove freely using your hands, climb, jump, and launch yourself through maps designed for speed and creativity. Whether you're racing friends, exploring, or just messing around, every session feels different.\n\nBuilt for players who love movement-based VR games, ChimpChills focuses on:\n\u2022 Smooth and responsive locomotion\n\u2022 Fun, replayable environments\n\u2022 Social interaction and multiplayer chaos\n\u2022 Clean, simple mechanics that feel great to use\n\nThis game is currently in development, which means updates, improvements, and new features are coming over time.\n\nJump in early, explore the world, and be part of shaping ChimpChills.", "short_description": "Fast-paced monkey parkour with smooth movement, chaotic fun, and social vibes in VR."}]}, "developer_name": "NovenStudios", "developer_privacy_policy_url": "https://sites.google.com/view/chimp-chills/privacy-policy-chimpchills", "developer_terms_of_service_url": null, "publisher_name": "NovenStudios", "support
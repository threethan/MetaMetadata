png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6KgKpEtRs6YQ7kNvwHpHrdE&_nc_oc=AdqHBuEXhM4wue4celwWEJYNGIn0zQ751FQIPFtkKTSjwuUKAtnDKPE2WYvHW66k2SM&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRTnymNzlP97F4VZAxVzzhDyiKF8MXAJNHoq6xeDGeHTQ&oe=6B08504B"}, {"file_name": "New Project (89).png", "id": "930057559907322", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/499308349_930057563240655_8803087660890779206_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rzYpDTGTW58Q7kNvwFbM-42&_nc_oc=AdpoVFa7mAe4Etn6njbVfUwsoDFAJRIOXb-GTx0_xOozE5oGMtGMukesa2ONEnpNP7w&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTTxM22qwlg1VisaActiqEIZqs9U7fwAdM5-Pl3w10STw&oe=6B086D12"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "ChimpChills", "keywords": [], "long_description": "ChimpChills is a fast-paced VR movement game built around smooth locomotion, fun mechanics, and social chaos.\n\nMove freely using your hands, climb, jump, and launch yourself through maps designed for speed and creativity. Whether you're racing friends, exploring, or just messing around, every session feels different.\n\nBuilt for players who love movement-based VR games, ChimpChills focuses on:\n\u2022 Smooth and responsive locomotion\n\u2022 Fun, replayable environments\n\u2022 Social interaction and multiplayer chaos\n\u2022 Clean, simple mechanics that feel great to use\n\nThis game is currently in development, which means updates, improvements, and new features are coming over time.\n\nJump in early, explore the world, and be part of shaping ChimpChills.", "short_description": "Fast-paced monkey parkour with smooth movement, chaotic fun, and social vibes in VR."}]}, "developer_name": "NovenStudios", "developer_privacy_policy_url": "https://sites.google.com/view/chimp-chills/privacy-policy-chimpchills", "developer_terms_of_service_url": null, "publisher_name": "NovenStudios", "support
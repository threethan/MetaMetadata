png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JvX__UY33yMQ7kNvwEPiaNX&_nc_oc=AdqZScFrYNJo-NLkBeaZCHlcSEMU4h27P6E16V3HgoFervhNRhYLo0liebm_hruvIFg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSK1uJOhY93Fdr7GfzrleU_DuhuYs8Gh-BfZmfX3jDsMw&oe=6B045BCB"}, {"file_name": "New Project (89).png", "id": "930057559907322", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499308349_930057563240655_8803087660890779206_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Xzh8c3I7zCYQ7kNvwETrEV_&_nc_oc=AdoF7VZLbM9yCAx0YCoz-sDzqcjpBV0hFwbIl5RRPGwnNTP540fTrTXubR-JxzeOPVk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRKh5Qii-CWnl8LNx0zvKPJCo88rVPconWlP8c27FMS6g&oe=6B047892"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "ChimpChills", "keywords": [], "long_description": "ChimpChills is a fast-paced VR movement game built around smooth locomotion, fun mechanics, and social chaos.\n\nMove freely using your hands, climb, jump, and launch yourself through maps designed for speed and creativity. Whether you're racing friends, exploring, or just messing around, every session feels different.\n\nBuilt for players who love movement-based VR games, ChimpChills focuses on:\n\u2022 Smooth and responsive locomotion\n\u2022 Fun, replayable environments\n\u2022 Social interaction and multiplayer chaos\n\u2022 Clean, simple mechanics that feel great to use\n\nThis game is currently in development, which means updates, improvements, and new features are coming over time.\n\nJump in early, explore the world, and be part of shaping ChimpChills.", "short_description": "Fast-paced monkey parkour with smooth movement, chaotic fun, and social vibes in VR."}]}, "developer_name": "NovenStudios", "developer_privacy_policy_url": "https://sites.google.com/view/chimp-chills/privacy-policy-chimpchills", "developer_terms_of_service_url": null, "publisher_name": "NovenStudios", "support
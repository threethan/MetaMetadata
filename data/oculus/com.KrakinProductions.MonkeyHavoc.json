795275_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=crohKIjUopkQ7kNvwE98fu5&_nc_oc=AdqjrInywkUf4jcBKIFoWygZ-XvHjQiztdf1zz37VKwvC3EQE6RzOUjaa9mrjOAPM_o&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIL7mVcdgq8gabOcxGxqGPQTHEwZoZmzESTk3H38yPUBw&oe=6AA6AE16"}, {"file_name": "5.png", "id": "540438542039147", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75395590_540438545372480_7329384731897725266_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o63r_XnnxaMQ7kNvwGF5Dtf&_nc_oc=AdoWXS7FOmq5cUnOLex7EVFE4EhaHf1qBxM8ltXpnWfkId_gtO2iSKODTsz3mAEk6NA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIYimfN6zT2lnjdlITwIRNrHruUXsaht8dooqWGR6SDCQ&oe=6AA6A5B5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Monkey Havoc Trailer Image.png", "id": "523796653745732", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974886_523796657079065_1178915653974772965_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VjHO4loNmNAQ7kNvwFbereA&_nc_oc=AdpnqRJBNOpF27sP8SbjvqhhqrUuJZo4-FXwoZKo0e-vtX1jOV72W98NO_t14pqXERk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK3ag5texeEFxpZkNwM6FViCGPYIH8Qb-7pNHZUySnNCg&oe=6AA6A833"}, "display_name": "Monkey Havoc", "keywords": ["Monkey", "Fan", "Game", "Gorilla", "Capuchin"], "long_description": "Welcome to Monkey Havoc, a game based off of the popular games 'Gorilla Tag' and 'Capuchin'. In Monkey Havoc you are able to freely move around many different maps with your friends, equip different styles of cosmetics, and compete in challenges to earn special cosmetics.\nThis game is constantly undergoing development and receiving updates to add more cosmetics, maps, and experiences.\nPlease let me know what to improve on by leaving a review and commenting on what could be better!\ud83d\ude0a\nContact Email: monkeyhavoccreator@gmail.com", "short_description": "Monkey Havoc is a 'Gorilla Tag' and 'Capuchin' fan game, made so that you and your friends can freely 
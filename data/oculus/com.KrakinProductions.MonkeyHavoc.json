9_1766831023204795275_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=90GTs2lEfdUQ7kNvwGVLbNI&_nc_oc=Adpi0MMRTqgpgpQHtY-wd_QhtPoGfNJopPjLKuK3mh-Xq6hEXyNd8jl9JZX8CHXK-XI&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIIFx1s_LRIo-v7RkY1m9WCDRSm8br8jXzVlmFZqqi5nw&oe=6AA95116"}, {"file_name": "5.png", "id": "540438542039147", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/75395590_540438545372480_7329384731897725266_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bcZh6Lfup0YQ7kNvwHPgtuZ&_nc_oc=Adpv4nuxeK4OxSMPvpfh0avUoByjP8e6_TOBv7uUc_s6XsT_CVVFukXA8VAvh8E-SaY&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI8A9iCeVgKddNZStzrfPbe9tF1h-ZFbOA8AHAKcW5xXg&oe=6AA948B5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Monkey Havoc Trailer Image.png", "id": "523796653745732", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/38974886_523796657079065_1178915653974772965_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P9_IQS98kYMQ7kNvwGy2_uC&_nc_oc=Adr8Ya8LJbblvGWzDfWtctOKKbGgQzm973TT8llqFglSM93l7qce97n2-IGUgdVYSRg&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLf-Iv_1g4q8j3PnpEo0VtSMIsXGX7Mjqcxmt09_nYbbA&oe=6AA94B33"}, "display_name": "Monkey Havoc", "keywords": ["Monkey", "Fan", "Game", "Gorilla", "Capuchin"], "long_description": "Welcome to Monkey Havoc, a game based off of the popular games 'Gorilla Tag' and 'Capuchin'. In Monkey Havoc you are able to freely move around many different maps with your friends, equip different styles of cosmetics, and compete in challenges to earn special cosmetics.\nThis game is constantly undergoing development and receiving updates to add more cosmetics, maps, and experiences.\nPlease let me know what to improve on by leaving a review and commenting on what could be better!\ud83d\ude0a\nContact Email: monkeyhavoccreator@gmail.com", "short_description": "Monkey Havoc is a 'Gorilla Tag' and 'Capuchin' fan game, made so that you and your
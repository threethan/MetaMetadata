795275_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SChT3ic9hxMQ7kNvwHU3ybo&_nc_oc=AdrS-hGAbZ2aNP0qzcOoWuGoDFNRWcj3N62NpzB53NeQi1hfh_W2_5OUdcgf47fnUTk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_25nB5ubbsa8Kn1PQ_6axcjpnRAuCiM3cBC5niubZ-VQ&oe=6A43CD96"}, {"file_name": "5.png", "id": "540438542039147", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75395590_540438545372480_7329384731897725266_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yhVTXkDftikQ7kNvwGUrxa4&_nc_oc=Ado8FrMB36u4CNvMrxY6hIH8VdURTsREUCDVPt7hKqCC4xI4LnWFCXRbHujfO6IExSE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_XqlkJvPHKNkcOT-IPYkeJcMJO4L7yQWyu_YRi_rlYxQ&oe=6A43C535"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Monkey Havoc Trailer Image.png", "id": "523796653745732", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974886_523796657079065_1178915653974772965_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Q8kIaYejNjYQ7kNvwHugaDa&_nc_oc=Adpep0vvOI3S58JUqUJPra9GzkSzg8GgbjTEssm3wtE7eEJB6gT82dYp0EKOtiTJXV8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_sSboCGv0f4qwjpeAXiV7C5Rv7FOc8UTwmQ1r1DD1vKQ&oe=6A43C7B3"}, "display_name": "Monkey Havoc", "keywords": ["Monkey", "Fan", "Game", "Gorilla", "Capuchin"], "long_description": "Welcome to Monkey Havoc, a game based off of the popular games 'Gorilla Tag' and 'Capuchin'. In Monkey Havoc you are able to freely move around many different maps with your friends, equip different styles of cosmetics, and compete in challenges to earn special cosmetics.\nThis game is constantly undergoing development and receiving updates to add more cosmetics, maps, and experiences.\nPlease let me know what to improve on by leaving a review and commenting on what could be better!\ud83d\ude0a\nContact Email: monkeyhavoccreator@gmail.com", "short_description": "Monkey Havoc is a 'Gorilla Tag' and 'Capuchin' fan game, made so that you and your friends can freely 
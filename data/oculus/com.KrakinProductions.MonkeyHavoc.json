795275_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LWId-3xhEw0Q7kNvwGT5Ber&_nc_oc=AdqToo-VrqfPKqSsqcQurHsdGJdr59HlONCEYAIawiApLyql5vNLpTUElg34KcZIHEI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8UHdFmu6qoPsVgPaGdB93K9llF5y8XjVXj3FVLHTY-Bw&oe=6A315896"}, {"file_name": "5.png", "id": "540438542039147", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75395590_540438545372480_7329384731897725266_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tSiF_Szv5B8Q7kNvwEiA-Fs&_nc_oc=Adq6d7wm-IQm5kc4TY84uQd-gN8IiAn8E__Zw7lME8iuZfsNpKmjfTeQn_y2mjRIImU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9SS9fvxkKdgd-tO7tJ8d_gzOlERp5i-nJivolvRbykhQ&oe=6A315035"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Monkey Havoc Trailer Image.png", "id": "523796653745732", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974886_523796657079065_1178915653974772965_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FnvXjjgHBxQQ7kNvwHAtsnx&_nc_oc=Ado6TL0BnRlo0b6OFLsLMmSgXJrPN7D4V-v7KeQkM28Xw35A5F4YaXoGB2urKepm8b4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_Jy_hUYvc1i3P7Phce9ZfYPUmsZeygQA-_zIAEPnDr7g&oe=6A3152B3"}, "display_name": "Monkey Havoc", "keywords": ["Monkey", "Fan", "Game", "Gorilla", "Capuchin"], "long_description": "Welcome to Monkey Havoc, a game based off of the popular games 'Gorilla Tag' and 'Capuchin'. In Monkey Havoc you are able to freely move around many different maps with your friends, equip different styles of cosmetics, and compete in challenges to earn special cosmetics.\nThis game is constantly undergoing development and receiving updates to add more cosmetics, maps, and experiences.\nPlease let me know what to improve on by leaving a review and commenting on what could be better!\ud83d\ude0a\nContact Email: monkeyhavoccreator@gmail.com", "short_description": "Monkey Havoc is a 'Gorilla Tag' and 'Capuchin' fan game, made so that you and your friends can freely 
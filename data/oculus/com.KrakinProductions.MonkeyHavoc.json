795275_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iGhwosH3o4MQ7kNvwG-wQxy&_nc_oc=AdoPV-IcVXbAM33yCMCCt6gaVht1utjCbE4YTLAoMaOwsr6cM7jTiXiA596w6iLqC2Y&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0h1Ks3PlVTnF-DoDZSpYzunvlO7jRW6rgKnq5E8sln8A&oe=69EF6D96"}, {"file_name": "5.png", "id": "540438542039147", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/75395590_540438545372480_7329384731897725266_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cez6MT3HMPAQ7kNvwHRuVhy&_nc_oc=AdrIf-eg2kmwZhvojrnEpQLnx2vOSHFkk4NzBNvAi-lnz3-aUsJW1_HZsEWYot0heII&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1oOcaFsc9lKKqWUmPh_1VjovzAq8WfktqwjBpqpl6P_Q&oe=69EF6535"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Monkey Havoc Trailer Image.png", "id": "523796653745732", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974886_523796657079065_1178915653974772965_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4flCid7QvnkQ7kNvwFi7PPe&_nc_oc=Adp4pk3JkPQy4wzV9fSWZjsK7UwmSamf5it4Wj9t2ZnvZSoZi9BAZbDPMZUiOyco8tQ&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af35WNDu2HQsdtVl7qKlPM5d4L6A_NDACNYhq_oWtE1V5w&oe=69EF67B3"}, "display_name": "Monkey Havoc", "keywords": ["Monkey", "Fan", "Game", "Gorilla", "Capuchin"], "long_description": "Welcome to Monkey Havoc, a game based off of the popular games 'Gorilla Tag' and 'Capuchin'. In Monkey Havoc you are able to freely move around many different maps with your friends, equip different styles of cosmetics, and compete in challenges to earn special cosmetics.\nThis game is constantly undergoing development and receiving updates to add more cosmetics, maps, and experiences.\nPlease let me know what to improve on by leaving a review and commenting on what could be better!\ud83d\ude0a\nContact Email: monkeyhavoccreator@gmail.com", "short_description": "Monkey Havoc is a 'Gorilla Tag' and 'Capuchin' fan game, made so that you and your friends can freely 
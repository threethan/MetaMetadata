795275_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5xtlX6Dru6YQ7kNvwFubdg2&_nc_oc=AdrTxchpoMS0U5Zuu__LOj6nXgXFtiVgYmFW8jDpLDIXuDM1VN4sm9EoW2L7s9fqcas&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0jccuMphBW_b1e3qaiPoqlQeL_xaEauwLWNsIvrQtu2Q&oe=69E8D616"}, {"file_name": "5.png", "id": "540438542039147", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75395590_540438545372480_7329384731897725266_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Zy-2WZWR3fsQ7kNvwEF8EfJ&_nc_oc=AdqtNkcc9t1PKdPgjfppDz-YE1HHTPJNUybZA1x9eJzHzCWRLWhjtkvs8K1FRA89UXI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af39g7Ua_JOQEyAt0-B1iiK4Wi0DYt4Edx6t59OKBon_Uw&oe=69E8CDB5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Monkey Havoc Trailer Image.png", "id": "523796653745732", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974886_523796657079065_1178915653974772965_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3FMY-Yn_8SoQ7kNvwE5g4oZ&_nc_oc=Adq_FMw75_XdIP9TUPfFmNnQ_cksdBRsSVfcxBOk7AyrufVA0FSanT9YXcpRCT3jn2w&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af07PvGpME-0KMXfXE4MgjbbeH5bpYA3LkOJnv1rBxtQlg&oe=69E8D033"}, "display_name": "Monkey Havoc", "keywords": ["Monkey", "Fan", "Game", "Gorilla", "Capuchin"], "long_description": "Welcome to Monkey Havoc, a game based off of the popular games 'Gorilla Tag' and 'Capuchin'. In Monkey Havoc you are able to freely move around many different maps with your friends, equip different styles of cosmetics, and compete in challenges to earn special cosmetics.\nThis game is constantly undergoing development and receiving updates to add more cosmetics, maps, and experiences.\nPlease let me know what to improve on by leaving a review and commenting on what could be better!\ud83d\ude0a\nContact Email: monkeyhavoccreator@gmail.com", "short_description": "Monkey Havoc is a 'Gorilla Tag' and 'Capuchin' fan game, made so that you and your friends can freely 
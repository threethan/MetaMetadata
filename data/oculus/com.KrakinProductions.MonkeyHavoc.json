795275_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9_aXE0MOBS8Q7kNvwGNRDHa&_nc_oc=AdqZbSEfevGbaqTC9oMI1LMt0A3hMiTF2wHse1jkEUuHMF2TjcOOBfT6OD93pd_mqig&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO4MpUKEr6g-yhk9Whb3BcZFmAFbR6ahad8ei5jN3DIKw&oe=6ACB9816"}, {"file_name": "5.png", "id": "540438542039147", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75395590_540438545372480_7329384731897725266_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pAFAADYZ5pMQ7kNvwHslZMu&_nc_oc=Adpzzicb6KWuiptXgk66bEOIoMEjxdElkfcZwOgmTym6gDqK8iT8nFS8_1fvUtylj9M&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMX9m4RHNCppWXMfwo8QFMa21ynpyZgIV_rnXDz64FYZQ&oe=6ACB8FB5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Monkey Havoc Trailer Image.png", "id": "523796653745732", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974886_523796657079065_1178915653974772965_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7z_XYrJw4WwQ7kNvwEI7tYa&_nc_oc=AdrzfR61Po6KulJm6acA3VPqCphZc3N-4jPs2ntqeIliYDCkRYNrduEKBpmKeGT5WyM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOOhAKGp9ZOr4bgvKGh9tSXQhNk03tATgr-B7sHtvCRVw&oe=6ACB9233"}, "display_name": "Monkey Havoc", "keywords": ["Monkey", "Fan", "Game", "Gorilla", "Capuchin"], "long_description": "Welcome to Monkey Havoc, a game based off of the popular games 'Gorilla Tag' and 'Capuchin'. In Monkey Havoc you are able to freely move around many different maps with your friends, equip different styles of cosmetics, and compete in challenges to earn special cosmetics.\nThis game is constantly undergoing development and receiving updates to add more cosmetics, maps, and experiences.\nPlease let me know what to improve on by leaving a review and commenting on what could be better!\ud83d\ude0a\nContact Email: monkeyhavoccreator@gmail.com", "short_description": "Monkey Havoc is a 'Gorilla Tag' and 'Capuchin' fan game, made so that you and your friends can freely 
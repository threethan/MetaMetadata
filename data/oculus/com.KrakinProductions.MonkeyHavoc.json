795275_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pX39wAGb-qQQ7kNvwGkSlWC&_nc_oc=AdqvpDGtBiLaxQ7c-azvNmFk16DT8MVuC9vgHQCZIfoeiTK9DwCJIjKF8KaQcw8ZvNk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSGAuVkHS3iOL7Xbntc3Lt9azLO-s3padOsxOf1fs2niA&oe=6AF8A356"}, {"file_name": "5.png", "id": "540438542039147", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75395590_540438545372480_7329384731897725266_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i8-6NFy4Bi0Q7kNvwG9HFvW&_nc_oc=AdpHU5AgyGvbPkJOv9s0qQR2oU4KoAn8f6fZe7L1XWmG0UJR2tAfvsk5q8pxrXA-ssQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTPcK5jJ6OAXyCzfkxy4EaRw-m64p_R0_dG5sbBpLOLAA&oe=6AF89AF5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Monkey Havoc Trailer Image.png", "id": "523796653745732", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974886_523796657079065_1178915653974772965_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LQ0zd0Z3Y7gQ7kNvwHcMRHU&_nc_oc=AdqOZLdKzYMQytK2gr1B2y2bwmaNJUcv0Mxn_yNVbkjTHIJa67g4AUBo_w6D_UvCoiA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSYFZD7nBMHcEVCREfCrQLptheWb8K14JFQ2hl1ZiNX4Q&oe=6AF89D73"}, "display_name": "Monkey Havoc", "keywords": ["Monkey", "Fan", "Game", "Gorilla", "Capuchin"], "long_description": "Welcome to Monkey Havoc, a game based off of the popular games 'Gorilla Tag' and 'Capuchin'. In Monkey Havoc you are able to freely move around many different maps with your friends, equip different styles of cosmetics, and compete in challenges to earn special cosmetics.\nThis game is constantly undergoing development and receiving updates to add more cosmetics, maps, and experiences.\nPlease let me know what to improve on by leaving a review and commenting on what could be better!\ud83d\ude0a\nContact Email: monkeyhavoccreator@gmail.com", "short_description": "Monkey Havoc is a 'Gorilla Tag' and 'Capuchin' fan game, made so that you and your friends can freely 
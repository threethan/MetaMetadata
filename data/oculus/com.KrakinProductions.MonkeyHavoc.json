795275_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-_gcK3b0KicQ7kNvwFCAV68&_nc_oc=AdqPuZ6d7cLdMoP4zlOxm34Pbvy3GzF00Gd2MZkKmSBzQYjTpz_eVyYkIwGruz6e34o&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCsfdtEKmaJbNN8nyKI9vfAyyqHQSc1CfTFtClQKuqD_g&oe=6A64C316"}, {"file_name": "5.png", "id": "540438542039147", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75395590_540438545372480_7329384731897725266_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TTkE1TQLR9wQ7kNvwFmE_eE&_nc_oc=AdrsJTzP9QxKIck0jbom7mxE_maB6i8oITzHbTyFsEl7k-VTHzFPnQA0n8PzorR5lbc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDTGMHjcPJQuVL9JXJtJjXp4TUPaYnAmbMwx45Mwt27TA&oe=6A64BAB5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Monkey Havoc Trailer Image.png", "id": "523796653745732", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974886_523796657079065_1178915653974772965_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AMMZWdAL8nwQ7kNvwEvQgIQ&_nc_oc=AdoUD2qef4gsms5cJ-zcG3iLl8ZOBhjZT8038QZO5agGaB3rHxRvSaQZhSGgC-U00ns&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDTsQzwcO2huAQd_-6PiSk9qaezvLg-8uFE1mBIBCj1VA&oe=6A64BD33"}, "display_name": "Monkey Havoc", "keywords": ["Monkey", "Fan", "Game", "Gorilla", "Capuchin"], "long_description": "Welcome to Monkey Havoc, a game based off of the popular games 'Gorilla Tag' and 'Capuchin'. In Monkey Havoc you are able to freely move around many different maps with your friends, equip different styles of cosmetics, and compete in challenges to earn special cosmetics.\nThis game is constantly undergoing development and receiving updates to add more cosmetics, maps, and experiences.\nPlease let me know what to improve on by leaving a review and commenting on what could be better!\ud83d\ude0a\nContact Email: monkeyhavoccreator@gmail.com", "short_description": "Monkey Havoc is a 'Gorilla Tag' and 'Capuchin' fan game, made so that you and your friends can freely 
795275_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vUcUufEpyD4Q7kNvwF1uOCF&_nc_oc=Adqrtk7gR-mvyk5HLiqgXpDnVnF_XWsdDyhj8RWZHcN3R6SJET0TwGVrrTx3KWyIBZE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQII7DSMVJDELmDWvxAA16pdtdf1ODws4uYgk4Yi57qU6g&oe=6AABF416"}, {"file_name": "5.png", "id": "540438542039147", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75395590_540438545372480_7329384731897725266_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bcZh6Lfup0YQ7kNvwFsxRB4&_nc_oc=AdoGZskggxVB8_CPjwJLO5ANbUBrWtraf9mJG2EiE7ysrpPR-r53uZTc7yq70npqhPA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKrHkxZnRoJlNluS8KDjs9Xq3hVuEKzs4bF-ACp-fK99w&oe=6AABEBB5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Monkey Havoc Trailer Image.png", "id": "523796653745732", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974886_523796657079065_1178915653974772965_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LwzV_Xtc4TMQ7kNvwH3u3kg&_nc_oc=AdqPaOTBYuU9LF3ueFCWm39iVA3Bs4WQWmHqhxIYAnJPVSdH4I4z68D4ADA_qWEyR5A&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJzfhepnuER8vep2OsRB5MVuHefbDqazQM0_bKalg3ctw&oe=6AABEE33"}, "display_name": "Monkey Havoc", "keywords": ["Monkey", "Fan", "Game", "Gorilla", "Capuchin"], "long_description": "Welcome to Monkey Havoc, a game based off of the popular games 'Gorilla Tag' and 'Capuchin'. In Monkey Havoc you are able to freely move around many different maps with your friends, equip different styles of cosmetics, and compete in challenges to earn special cosmetics.\nThis game is constantly undergoing development and receiving updates to add more cosmetics, maps, and experiences.\nPlease let me know what to improve on by leaving a review and commenting on what could be better!\ud83d\ude0a\nContact Email: monkeyhavoccreator@gmail.com", "short_description": "Monkey Havoc is a 'Gorilla Tag' and 'Capuchin' fan game, made so that you and your friends can freely 
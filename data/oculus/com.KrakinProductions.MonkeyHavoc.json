795275_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Men1bulAKQQQ7kNvwE5-TtE&_nc_oc=AdqUsshZo570apr49OzPfuAR0IBChbK4cGlWLtbfdjATTHsRo5rvBKnI8HuvDlcZ_Yk&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9FHSgi8QLy8U68MPL5aMwpCmtnaeh6ydNb1iZXute53A&oe=6A451F16"}, {"file_name": "5.png", "id": "540438542039147", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/75395590_540438545372480_7329384731897725266_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yhVTXkDftikQ7kNvwEdRWq3&_nc_oc=AdoLSkb3j8Pz4zzy8ECasMRwxgr3HrVJWlK3CIOAiXDom4o-omYYur8GhXO6hGq8GKc&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_Gyy2Y0Birkhso9NM-xAn9r359laHq8JE4ZGcYcZeWXA&oe=6A4516B5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Monkey Havoc Trailer Image.png", "id": "523796653745732", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38974886_523796657079065_1178915653974772965_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Q8kIaYejNjYQ7kNvwHdObZx&_nc_oc=AdoXThB7ecqTYqmZa3xl2m1KGkV19w_nh2vJTR0qHpbwHL9IEe_dgTu_VQVtqmx1P6s&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_wdRnHKv3oSXT9trDl9-8rMxG06Naj43DY6g3wkcsCWA&oe=6A451933"}, "display_name": "Monkey Havoc", "keywords": ["Monkey", "Fan", "Game", "Gorilla", "Capuchin"], "long_description": "Welcome to Monkey Havoc, a game based off of the popular games 'Gorilla Tag' and 'Capuchin'. In Monkey Havoc you are able to freely move around many different maps with your friends, equip different styles of cosmetics, and compete in challenges to earn special cosmetics.\nThis game is constantly undergoing development and receiving updates to add more cosmetics, maps, and experiences.\nPlease let me know what to improve on by leaving a review and commenting on what could be better!\ud83d\ude0a\nContact Email: monkeyhavoccreator@gmail.com", "short_description": "Monkey Havoc is a 'Gorilla Tag' and 'Capuchin' fan game, made so that you and your friends can freely 
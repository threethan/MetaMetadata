795275_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eX-KZP4WktMQ7kNvwEiAaz5&_nc_oc=Adrpj5LGIpgdKz38rVmQ671o5YRxF-TiDnEg8WASRjVqLr3fpMVOf2JOkq_0x6VIJdE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ0h9ggQdH5vEbDq-rMURnZbhorIPkFvx2PyGoOF7MAzQ&oe=6AB92316"}, {"file_name": "5.png", "id": "540438542039147", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75395590_540438545372480_7329384731897725266_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PT73cRHREP0Q7kNvwGjKnUb&_nc_oc=AdpWPDrNpRJfwTu2FwZeAWEFTykCn-D2XvSXk77X2SUtmhNy4oI31fhzPCQhRQFX2Jc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJKUnxX95-WPyEo12-xHMyoybn0O3_fZvp6WqJ42S-bOw&oe=6AB91AB5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Monkey Havoc Trailer Image.png", "id": "523796653745732", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974886_523796657079065_1178915653974772965_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c_SevkJ9K6kQ7kNvwFqzQ1U&_nc_oc=AdpIb0v9usx-Dll4zNmj6J1K34QAKk8Z04KnI4DnubbBf9Y_jYOJdCUdkEH2NOjm_Ww&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKLApLfdKvTN9HEVAkXG3Jr3Rvmbl-ps3cVoS4b2hTp2A&oe=6AB91D33"}, "display_name": "Monkey Havoc", "keywords": ["Monkey", "Fan", "Game", "Gorilla", "Capuchin"], "long_description": "Welcome to Monkey Havoc, a game based off of the popular games 'Gorilla Tag' and 'Capuchin'. In Monkey Havoc you are able to freely move around many different maps with your friends, equip different styles of cosmetics, and compete in challenges to earn special cosmetics.\nThis game is constantly undergoing development and receiving updates to add more cosmetics, maps, and experiences.\nPlease let me know what to improve on by leaving a review and commenting on what could be better!\ud83d\ude0a\nContact Email: monkeyhavoccreator@gmail.com", "short_description": "Monkey Havoc is a 'Gorilla Tag' and 'Capuchin' fan game, made so that you and your friends can freely 
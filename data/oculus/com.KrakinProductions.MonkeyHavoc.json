795275_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NHV43unp_zIQ7kNvwFKopsB&_nc_oc=Adr9AmPyStgNLkMSn8bqd9IYyuE4GA1U2-wLo_lZQVIHnPb-9CmVxmX67monsb1kVm4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af08fhDaI9y8JotpgH_EGK3qZr5dhNHMtZoBUXTBJP70PA&oe=69D3BE16"}, {"file_name": "5.png", "id": "540438542039147", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75395590_540438545372480_7329384731897725266_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2_iGNg4q8vsQ7kNvwEJITWB&_nc_oc=AdrLln1aMUHXermkGmRn_Dmx4xMfmtqMEH3XPxXOKczl3Y7joTH4AxA2bbQ3xtGvIuQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0jJrzEkIyD735TFEplKnvCjGg9a_5zyBh2HCXQx1M9mQ&oe=69D3B5B5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Monkey Havoc Trailer Image.png", "id": "523796653745732", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974886_523796657079065_1178915653974772965_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oXNFIkfjchgQ7kNvwFl_iI4&_nc_oc=Adqi1GFlFrA4l9DW_butKDd5HgYNKF9v37godRgNeUoT0sJDKxyFh1yFItMu9w2-O9A&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3hbvHumE-sRdy6Ju67D3ADy1jCFsQ8tHpgldlwNhge4Q&oe=69D3B833"}, "display_name": "Monkey Havoc", "keywords": ["Monkey", "Fan", "Game", "Gorilla", "Capuchin"], "long_description": "Welcome to Monkey Havoc, a game based off of the popular games 'Gorilla Tag' and 'Capuchin'. In Monkey Havoc you are able to freely move around many different maps with your friends, equip different styles of cosmetics, and compete in challenges to earn special cosmetics.\nThis game is constantly undergoing development and receiving updates to add more cosmetics, maps, and experiences.\nPlease let me know what to improve on by leaving a review and commenting on what could be better!\ud83d\ude0a\nContact Email: monkeyhavoccreator@gmail.com", "short_description": "Monkey Havoc is a 'Gorilla Tag' and 'Capuchin' fan game, made so that you and your friends can freely 
795275_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TmIs0bs5P-EQ7kNvwGJ4E2A&_nc_oc=AdqVtmWm-8x1UHa0kNXy3-XTNvcyISyiD0Dy8ELY5KWnLheaO9otw1SFa5lm3-2U5Nw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afzzap0v3SSo66G6S1ZLBHT6M8VICyAP2uf28dfZMNKPaQ&oe=69CD2696"}, {"file_name": "5.png", "id": "540438542039147", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75395590_540438545372480_7329384731897725266_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jL4h1-vU76IQ7kNvwGRA6rY&_nc_oc=Adq7LRVQs3Scj6u3F91drnUPCeUUxsZxLe0eH1Cw0B02EXbku9azToWFon1WrY7_sg0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afxi3NRrnjeOeQz-BuN-EJUOd80NDlHD_WJqKfsZIXHYAw&oe=69CD1E35"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Monkey Havoc Trailer Image.png", "id": "523796653745732", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974886_523796657079065_1178915653974772965_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9m0nBhXaFssQ7kNvwFiH66Q&_nc_oc=AdrfctuiKH6Vs-0UmC5MW5q6tG6r2B8ZW_Ub8RSQLXCL8EgCrXJB0h7cIqNQcu4--J4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyPbSjTrWHj_hht7tidUamiH-c2QTC8Wf88rxPDwzhBDA&oe=69CD20B3"}, "display_name": "Monkey Havoc", "keywords": ["Monkey", "Fan", "Game", "Gorilla", "Capuchin"], "long_description": "Welcome to Monkey Havoc, a game based off of the popular games 'Gorilla Tag' and 'Capuchin'. In Monkey Havoc you are able to freely move around many different maps with your friends, equip different styles of cosmetics, and compete in challenges to earn special cosmetics.\nThis game is constantly undergoing development and receiving updates to add more cosmetics, maps, and experiences.\nPlease let me know what to improve on by leaving a review and commenting on what could be better!\ud83d\ude0a\nContact Email: monkeyhavoccreator@gmail.com", "short_description": "Monkey Havoc is a 'Gorilla Tag' and 'Capuchin' fan game, made so that you and your friends can freely 
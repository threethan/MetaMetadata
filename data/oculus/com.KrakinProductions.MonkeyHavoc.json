795275_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xyqz_airmrAQ7kNvwGke7-J&_nc_oc=AdoWdfHXZZowz54dDB8bCKaTDEEtLrkkYJMX8aVv1q_KkECW9grONH-PynKFHEFdtBE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2M0BJXh9u3kVXuMOxFI9RWH77hTd-4aU8L1AaqYybG4A&oe=69E39016"}, {"file_name": "5.png", "id": "540438542039147", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75395590_540438545372480_7329384731897725266_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bjzNtRSBfWAQ7kNvwHcxYM_&_nc_oc=AdrYI1Zi47ajU4EysD-MkuCOA-8c5dIlq_KCUKZKSXhxCLAqjyXujE9poEWqsofrQEk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1KncbJKxa6v8XkajE6gNQQ3fyBWTsRxGvzXNggGe7wCA&oe=69E387B5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Monkey Havoc Trailer Image.png", "id": "523796653745732", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974886_523796657079065_1178915653974772965_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HnhP-voeXlsQ7kNvwGz6x2T&_nc_oc=Adp5mdMhtIQwXmG9ozFuTvDpccYoP7jUSS2gVAhA1Ajk4vpuGFolVzM2h5LDbzBP4HM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0CXY1Wt-rUYsZKRsiKbVezMt_KwkiY404-Cu76MMUvaA&oe=69E38A33"}, "display_name": "Monkey Havoc", "keywords": ["Monkey", "Fan", "Game", "Gorilla", "Capuchin"], "long_description": "Welcome to Monkey Havoc, a game based off of the popular games 'Gorilla Tag' and 'Capuchin'. In Monkey Havoc you are able to freely move around many different maps with your friends, equip different styles of cosmetics, and compete in challenges to earn special cosmetics.\nThis game is constantly undergoing development and receiving updates to add more cosmetics, maps, and experiences.\nPlease let me know what to improve on by leaving a review and commenting on what could be better!\ud83d\ude0a\nContact Email: monkeyhavoccreator@gmail.com", "short_description": "Monkey Havoc is a 'Gorilla Tag' and 'Capuchin' fan game, made so that you and your friends can freely 
795275_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nnxVWrdhBeEQ7kNvwEd11ii&_nc_oc=AdpCv1zmNlny6A-9MDbjeN7xd2-ltHe040NJUhN79UlnX_zcPCnOFGaurXL0CmNHH08&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL9lKqKPyrwg3NUisb6yp4MJ0r7OGY1phvcEgAS59V2ag&oe=6AAFE896"}, {"file_name": "5.png", "id": "540438542039147", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75395590_540438545372480_7329384731897725266_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=diN9a4pU-bYQ7kNvwHijvtE&_nc_oc=Adq7qhJ6rux5DkL1jPbXRKoevt9RK1stwnGWCkJBl6-2wIWXggo46hIAU4rBpy7ZSts&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJMQOGoCw5r7ocIWi1MnaEkDli1CsscGZRaqX9gMDmoZQ&oe=6AAFE035"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Monkey Havoc Trailer Image.png", "id": "523796653745732", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974886_523796657079065_1178915653974772965_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NduecmUnw7YQ7kNvwHLwvlv&_nc_oc=AdrBQkUyx7nABbN8IpQnZizJXCCsov2h_7VD-VjLWMgsJZYUJWP3VFiVLUd32t7Jcg4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJfd6ILayfc8n4RyWB2J-zsQglPGPSZSr8Dy8joGKvjpw&oe=6AAFE2B3"}, "display_name": "Monkey Havoc", "keywords": ["Monkey", "Fan", "Game", "Gorilla", "Capuchin"], "long_description": "Welcome to Monkey Havoc, a game based off of the popular games 'Gorilla Tag' and 'Capuchin'. In Monkey Havoc you are able to freely move around many different maps with your friends, equip different styles of cosmetics, and compete in challenges to earn special cosmetics.\nThis game is constantly undergoing development and receiving updates to add more cosmetics, maps, and experiences.\nPlease let me know what to improve on by leaving a review and commenting on what could be better!\ud83d\ude0a\nContact Email: monkeyhavoccreator@gmail.com", "short_description": "Monkey Havoc is a 'Gorilla Tag' and 'Capuchin' fan game, made so that you and your friends can freely 
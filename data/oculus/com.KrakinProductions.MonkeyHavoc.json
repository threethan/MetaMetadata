795275_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HFnwCX4wQIoQ7kNvwHgZbXf&_nc_oc=Adr7hZ4qix-OSftIWeMjr5KQOA5QmYxjtFRTxAkeiLXAbFMCd_Q56TDO8whWxjnlO-0&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQJlyEuOZL49jQRw3bfRw56vxdi4SZO5GENATEMOdbswQ&oe=6AE89916"}, {"file_name": "5.png", "id": "540438542039147", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/75395590_540438545372480_7329384731897725266_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V9L0Bu4fQ5UQ7kNvwFMJghB&_nc_oc=Adon5Q66JRflvFboeCbke4UWcJw3wKh9VnzFesZsl-oOuUKfL9zYODNMyviuSiZbyA8&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTbcI54GyQk2bLy6yOEK-V7yekX8sifwhCZl-30eUoCSQ&oe=6AE890B5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Monkey Havoc Trailer Image.png", "id": "523796653745732", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38974886_523796657079065_1178915653974772965_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H5vHfxmeOZkQ7kNvwEETqYh&_nc_oc=Adq_EWYMiWkzAabL745PcDQEk8J8EN_LpUM4JRh8CJY-981S_WBfHQaVf3pXFK9rbrg&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRMtin76MCbRZVHVVUsPOBlDmcENHyM9HYUtSd1i2TIpw&oe=6AE89333"}, "display_name": "Monkey Havoc", "keywords": ["Monkey", "Fan", "Game", "Gorilla", "Capuchin"], "long_description": "Welcome to Monkey Havoc, a game based off of the popular games 'Gorilla Tag' and 'Capuchin'. In Monkey Havoc you are able to freely move around many different maps with your friends, equip different styles of cosmetics, and compete in challenges to earn special cosmetics.\nThis game is constantly undergoing development and receiving updates to add more cosmetics, maps, and experiences.\nPlease let me know what to improve on by leaving a review and commenting on what could be better!\ud83d\ude0a\nContact Email: monkeyhavoccreator@gmail.com", "short_description": "Monkey Havoc is a 'Gorilla Tag' and 'Capuchin' fan game, made so that you and your friends can freely 
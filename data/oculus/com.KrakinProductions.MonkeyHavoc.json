795275_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XaSIlC-H-MAQ7kNvwEyzUoA&_nc_oc=Adr6PzDgA51b6K71HNhD6u1RM6vfOVNQRvS2VSiKSQYvFLv77-8OrRfCYZ0yYUbrv-k&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBYz4HDz54qUMKxJJD2UecQcGlaT2HEMYSsOINelmN_rA&oe=6A6DFD96"}, {"file_name": "5.png", "id": "540438542039147", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75395590_540438545372480_7329384731897725266_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jg5VbG-lDrgQ7kNvwG0dKjV&_nc_oc=Adp8pQLcpQVd0nqBy48of_7gyk90VgAt-ibFhRlFiSBzkWktCFTLhkGnCWCbb21JI3U&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBvqxtegNfzdlrF8d3P0XJl94Bz2zvccZNbfInPCRyKag&oe=6A6DF535"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Monkey Havoc Trailer Image.png", "id": "523796653745732", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974886_523796657079065_1178915653974772965_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=StNjzuMAzVYQ7kNvwG3KzkG&_nc_oc=AdoXttgJ9M-3aGrasrnxkgiGujRIriPnF5L5GPTdzUrSWpmVWF3JvwfpLgMNaPoZ1yc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDd10XCho3WUqu_qrrTAU9ckrpySRrcOLyxsY-0u2oTpg&oe=6A6DF7B3"}, "display_name": "Monkey Havoc", "keywords": ["Monkey", "Fan", "Game", "Gorilla", "Capuchin"], "long_description": "Welcome to Monkey Havoc, a game based off of the popular games 'Gorilla Tag' and 'Capuchin'. In Monkey Havoc you are able to freely move around many different maps with your friends, equip different styles of cosmetics, and compete in challenges to earn special cosmetics.\nThis game is constantly undergoing development and receiving updates to add more cosmetics, maps, and experiences.\nPlease let me know what to improve on by leaving a review and commenting on what could be better!\ud83d\ude0a\nContact Email: monkeyhavoccreator@gmail.com", "short_description": "Monkey Havoc is a 'Gorilla Tag' and 'Capuchin' fan game, made so that you and your friends can freely 
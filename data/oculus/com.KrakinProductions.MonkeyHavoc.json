795275_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SChT3ic9hxMQ7kNvwHGK_3V&_nc_oc=Adr2h8uoX7G3lBoI5tcCkwuzWWrHVCOMml-tpPO0KIYFVibdLHQ28McotfMyy4z2-90&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_T4eGYVaz56muGQVCFyFicjeQM9fDB9esCCDU_d-pc2g&oe=6A412A96"}, {"file_name": "5.png", "id": "540438542039147", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75395590_540438545372480_7329384731897725266_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bSmxKlCeMK4Q7kNvwFUe-2k&_nc_oc=AdpubPEbbR5fZ3UvSS4YcsICdNDsOTbQljmJy_aWQE-jmMlHl-eIcUO7RHCB2h13GIU&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af851Fkx3ufqynKElrO9PTzExN3V6gtPJJMzgDxJfyT3nA&oe=6A412235"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Monkey Havoc Trailer Image.png", "id": "523796653745732", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974886_523796657079065_1178915653974772965_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Q8kIaYejNjYQ7kNvwF3KsFo&_nc_oc=AdqP5A6YvKemB7QoXytoINgBmAI7uTZVFpSvpy6pjAWIPduqgdL_d16FJ2b8pLkYloc&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-BKPGLvyGzl_WM_5jJXJyv3d3riOHvsRLb5amKN4x2Ng&oe=6A4124B3"}, "display_name": "Monkey Havoc", "keywords": ["Monkey", "Fan", "Game", "Gorilla", "Capuchin"], "long_description": "Welcome to Monkey Havoc, a game based off of the popular games 'Gorilla Tag' and 'Capuchin'. In Monkey Havoc you are able to freely move around many different maps with your friends, equip different styles of cosmetics, and compete in challenges to earn special cosmetics.\nThis game is constantly undergoing development and receiving updates to add more cosmetics, maps, and experiences.\nPlease let me know what to improve on by leaving a review and commenting on what could be better!\ud83d\ude0a\nContact Email: monkeyhavoccreator@gmail.com", "short_description": "Monkey Havoc is a 'Gorilla Tag' and 'Capuchin' fan game, made so that you and your friends can freely 
795275_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9rIGVjfQ4xEQ7kNvwEbgt1o&_nc_oc=AdonVAkPV91Y3mcpeZKgZyml0OBY1snBJi8jXCaw-BqOrmfsIFkqJzjkWemsV03c4TM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEQDWo5Gpb2FBQHDoZOgOAfo8-iLeObfO8FcpaNsvPjaw&oe=6A788996"}, {"file_name": "5.png", "id": "540438542039147", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75395590_540438545372480_7329384731897725266_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NIaJqf6DW2QQ7kNvwGUn0_j&_nc_oc=AdreRmQUDgBNHTBTjPAIZedvgrSFgdMyRmcMFBfTeT2O8wmNK72ObT9X8ELZJEGtX0s&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGUJRw-hXAhvoCx8Gn8MfDnZlAK8vK1ive0gQv0lvrbMA&oe=6A788135"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Monkey Havoc Trailer Image.png", "id": "523796653745732", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974886_523796657079065_1178915653974772965_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-zLPcYt2cEsQ7kNvwHMbqqS&_nc_oc=Ado34uqpXQ1ut9J7CflgU9gwqEAl2sNq0BEalnFeipf-pxzSM_BtlIdL6hiqeJc2kCs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHq3osJkCxqK4ONSTyLeiJ0WB0E_CB7mnpMF7hEvinNKw&oe=6A7883B3"}, "display_name": "Monkey Havoc", "keywords": ["Monkey", "Fan", "Game", "Gorilla", "Capuchin"], "long_description": "Welcome to Monkey Havoc, a game based off of the popular games 'Gorilla Tag' and 'Capuchin'. In Monkey Havoc you are able to freely move around many different maps with your friends, equip different styles of cosmetics, and compete in challenges to earn special cosmetics.\nThis game is constantly undergoing development and receiving updates to add more cosmetics, maps, and experiences.\nPlease let me know what to improve on by leaving a review and commenting on what could be better!\ud83d\ude0a\nContact Email: monkeyhavoccreator@gmail.com", "short_description": "Monkey Havoc is a 'Gorilla Tag' and 'Capuchin' fan game, made so that you and your friends can freely 
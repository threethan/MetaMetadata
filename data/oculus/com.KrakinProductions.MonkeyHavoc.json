795275_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3Zr73UEnFn8Q7kNvwGY8Q48&_nc_oc=AdpBdDOWY2i3PmL4nx99UC6-VfQZsG7jRlMSXo2GRw4fowQq17ONzrYNpzM2fu6_LSI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGEGNqKwxLqFzshxWRU8dBCwvbPUqE2E9HGGKpAoux3RQ&oe=6A75E696"}, {"file_name": "5.png", "id": "540438542039147", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75395590_540438545372480_7329384731897725266_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NIaJqf6DW2QQ7kNvwESPvYM&_nc_oc=AdpKXZJsK0ybmsNUTHr2OIc-Kzj15ppSGu4r1e_SwfaQ2O6CSq-arBmvDRj_y20v5cg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHsQI-ZLPCPihn0FsA8v87Ja5D_DJzXay0CJ2jQFpDn3Q&oe=6A75DE35"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Monkey Havoc Trailer Image.png", "id": "523796653745732", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974886_523796657079065_1178915653974772965_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-zLPcYt2cEsQ7kNvwH4fKHQ&_nc_oc=AdrXg2eTYpsWVaZfxTpA9ioxfK4-Qh6gG8P2J0ySaxzAyIl11B2q77ZSxq8odBkRMXo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHXb6l_qT10Kj-6jyHtgQKCG0qq8gkSpjVt3Dos7w2vzA&oe=6A75E0B3"}, "display_name": "Monkey Havoc", "keywords": ["Monkey", "Fan", "Game", "Gorilla", "Capuchin"], "long_description": "Welcome to Monkey Havoc, a game based off of the popular games 'Gorilla Tag' and 'Capuchin'. In Monkey Havoc you are able to freely move around many different maps with your friends, equip different styles of cosmetics, and compete in challenges to earn special cosmetics.\nThis game is constantly undergoing development and receiving updates to add more cosmetics, maps, and experiences.\nPlease let me know what to improve on by leaving a review and commenting on what could be better!\ud83d\ude0a\nContact Email: monkeyhavoccreator@gmail.com", "short_description": "Monkey Havoc is a 'Gorilla Tag' and 'Capuchin' fan game, made so that you and your friends can freely 
795275_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J04VSdztTGUQ7kNvwGb1P0i&_nc_oc=Adp80t6X4StceiU3kyKabctvf0ojn8FMn1ye0WZmrheAmoRlWYrgdgit1RKGgRb0SVQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCw9NQrz9zNSj56JfYvU_hysFhX5QUntgCCyXk5lk7ekw&oe=6A6A0916"}, {"file_name": "5.png", "id": "540438542039147", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75395590_540438545372480_7329384731897725266_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DmM4pe9K7_QQ7kNvwFh614l&_nc_oc=AdpqVWaMKBjkqaxSsnZAvr1ENoFeaftx9BSPbROuytBWU5Z_K9-6CB7W8KePCbv0u8M&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAxuIqoDNmcgt2IW_jUqA-cwZiIOupUaJHkQQIsZ9pmvA&oe=6A6A00B5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Monkey Havoc Trailer Image.png", "id": "523796653745732", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974886_523796657079065_1178915653974772965_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XMLxML_29z0Q7kNvwFX6QEF&_nc_oc=Adof9ogv7iTmOBXu0AOC0-juhNF8MFfiw-N_kn41OqT4skQFkMOgTsDKDwyql2FZ0ME&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDzaMpc6prwWdeS5qBOmEQjrxx10A07NCF-0BHKbd6l_A&oe=6A6A0333"}, "display_name": "Monkey Havoc", "keywords": ["Monkey", "Fan", "Game", "Gorilla", "Capuchin"], "long_description": "Welcome to Monkey Havoc, a game based off of the popular games 'Gorilla Tag' and 'Capuchin'. In Monkey Havoc you are able to freely move around many different maps with your friends, equip different styles of cosmetics, and compete in challenges to earn special cosmetics.\nThis game is constantly undergoing development and receiving updates to add more cosmetics, maps, and experiences.\nPlease let me know what to improve on by leaving a review and commenting on what could be better!\ud83d\ude0a\nContact Email: monkeyhavoccreator@gmail.com", "short_description": "Monkey Havoc is a 'Gorilla Tag' and 'Capuchin' fan game, made so that you and your friends can freely 
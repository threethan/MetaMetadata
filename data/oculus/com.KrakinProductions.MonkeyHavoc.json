795275_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4TCYuORg2P8Q7kNvwE8MxBS&_nc_oc=AdpiKVWFLVE69T80q-7_PGO7ji6DdFDCjxRWGHIhTvkYyvYhLtsLb1tn-xbWGDQnIz0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxBKW6XliNy-WSfHHuOLO7CMes94WqaUq_m3v6GBURYgw&oe=69CE7816"}, {"file_name": "5.png", "id": "540438542039147", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75395590_540438545372480_7329384731897725266_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jL4h1-vU76IQ7kNvwE2_vG-&_nc_oc=Adpwno2YRuY_Bawb-GOMDcHeXXoL0NgHgyoj5VrCqSh0HANtjgkQWaF4VQ4KeON9h1A&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afw1T5LwOITjY2BZcD_HK-QkBM8U3sRS3sUmmLarBV7IKg&oe=69CE6FB5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Monkey Havoc Trailer Image.png", "id": "523796653745732", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974886_523796657079065_1178915653974772965_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9m0nBhXaFssQ7kNvwF5px6N&_nc_oc=AdotRiAy4grXCkXJvfzPzfraClCNuAXKQ9BvSg6ZwWNlcc9y-venZFdGOehIkBFfgQw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzhORCgxsmfJtK5wbY0_Em0lX51Mw8Al1ePmxxmMGHAjA&oe=69CE7233"}, "display_name": "Monkey Havoc", "keywords": ["Monkey", "Fan", "Game", "Gorilla", "Capuchin"], "long_description": "Welcome to Monkey Havoc, a game based off of the popular games 'Gorilla Tag' and 'Capuchin'. In Monkey Havoc you are able to freely move around many different maps with your friends, equip different styles of cosmetics, and compete in challenges to earn special cosmetics.\nThis game is constantly undergoing development and receiving updates to add more cosmetics, maps, and experiences.\nPlease let me know what to improve on by leaving a review and commenting on what could be better!\ud83d\ude0a\nContact Email: monkeyhavoccreator@gmail.com", "short_description": "Monkey Havoc is a 'Gorilla Tag' and 'Capuchin' fan game, made so that you and your friends can freely 
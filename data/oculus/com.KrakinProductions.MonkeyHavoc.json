795275_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4wPvEi7YYMgQ7kNvwGI2xZ5&_nc_oc=Adrq_emfPGCXm57J_6XDBj21fsOslw8VjAlr3NSXlWKh7kWaFp9N_lN8TCDgwaZqNZk&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8vZRHs7r0J6eSMHQh29NGpCicuFbaWiL3ixS4dKAYCYA&oe=6A300716"}, {"file_name": "5.png", "id": "540438542039147", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75395590_540438545372480_7329384731897725266_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tSiF_Szv5B8Q7kNvwHml_Hs&_nc_oc=AdrfBMEfACEhLhH9s11F02ykNmZ-huy6DVI4qwSwJVia-5VbTK6Lj9it0mV5nu9Phpg&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_R9xvAk3IKCoJVResFM2Xl4oYkrCH3zGuMzGZDLUIf7w&oe=6A2FFEB5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Monkey Havoc Trailer Image.png", "id": "523796653745732", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974886_523796657079065_1178915653974772965_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y5_9Pb-B89YQ7kNvwHRshF9&_nc_oc=AdoEli3Ln7_Aat8LIuYDnYUZ1jUUe9JaAAmr0yFO7ydwTOpvRZQJ7cTfsPPzO1FD0tw&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8p3TU5m8I4F1WnwICg5n2yvCbzn1rOFjn6FCuqpwrFBw&oe=6A300133"}, "display_name": "Monkey Havoc", "keywords": ["Monkey", "Fan", "Game", "Gorilla", "Capuchin"], "long_description": "Welcome to Monkey Havoc, a game based off of the popular games 'Gorilla Tag' and 'Capuchin'. In Monkey Havoc you are able to freely move around many different maps with your friends, equip different styles of cosmetics, and compete in challenges to earn special cosmetics.\nThis game is constantly undergoing development and receiving updates to add more cosmetics, maps, and experiences.\nPlease let me know what to improve on by leaving a review and commenting on what could be better!\ud83d\ude0a\nContact Email: monkeyhavoccreator@gmail.com", "short_description": "Monkey Havoc is a 'Gorilla Tag' and 'Capuchin' fan game, made so that you and your friends can freely 
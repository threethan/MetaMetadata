9_1766831023204795275_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vUcUufEpyD4Q7kNvwFSVjob&_nc_oc=AdodWD7nvceSMkdfd6ijKbh5beUouUZZLDFYt4pEx8KomUhxhrY2gOy-qo5SbY0tdxg&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLg6hjN5k80mABXljU5d9j17ErJkOAoRoOE1XsD7e_Upw&oe=6AAE9716"}, {"file_name": "5.png", "id": "540438542039147", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/75395590_540438545372480_7329384731897725266_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=diN9a4pU-bYQ7kNvwGZ3XZX&_nc_oc=Adr31leBIsshFT_OSlC6J4bndk0hcOvua1LJf3eusS4IT8uW3NHM9PeltMpo3ry8RHU&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJYQLnMefLR7ZxVk9fDR8yleNN36YQbjo5-vu9xcQR9Yg&oe=6AAE8EB5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Monkey Havoc Trailer Image.png", "id": "523796653745732", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/38974886_523796657079065_1178915653974772965_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LwzV_Xtc4TMQ7kNvwFgSfat&_nc_oc=AdrNpadHHTMj_TQd2AxaA34K8RSO2hc2NjDKrX7KHHrTVzjke5dYlYnYiSx-pV_Q2uo&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJeW4gQnLztY5Xx6Ft2F8jiNOTUPEsY4Dbn94hfVYEsWA&oe=6AAE9133"}, "display_name": "Monkey Havoc", "keywords": ["Monkey", "Fan", "Game", "Gorilla", "Capuchin"], "long_description": "Welcome to Monkey Havoc, a game based off of the popular games 'Gorilla Tag' and 'Capuchin'. In Monkey Havoc you are able to freely move around many different maps with your friends, equip different styles of cosmetics, and compete in challenges to earn special cosmetics.\nThis game is constantly undergoing development and receiving updates to add more cosmetics, maps, and experiences.\nPlease let me know what to improve on by leaving a review and commenting on what could be better!\ud83d\ude0a\nContact Email: monkeyhavoccreator@gmail.com", "short_description": "Monkey Havoc is a 'Gorilla Tag' and 'Capuchin' fan game, made so that you and your
795275_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HFnwCX4wQIoQ7kNvwHNluer&_nc_oc=AdpvFXZ61fdVFfkPCVPWz3JfTAoB_rv0Uwc1yV-qW1KStKfhSj8pNkNgHlMw4cU4NSU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ1gZoGzsKhEAMcncz9fu9hsOTxAf4Cv5IifjjTWii94Q&oe=6AE74796"}, {"file_name": "5.png", "id": "540438542039147", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75395590_540438545372480_7329384731897725266_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zwnNX7o6SDsQ7kNvwHXEiZH&_nc_oc=AdrImNUC-X2sfQ2YAXtrStOglkMMCpplg6yjgLbu11X2eDH6GPJC4MD0HiCZFdcpo6E&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSYxIpIT2Gp6LHyS5wpVQxeqXm75JFvuiB1bcIS2YP1-Q&oe=6AE73F35"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Monkey Havoc Trailer Image.png", "id": "523796653745732", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974886_523796657079065_1178915653974772965_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H5vHfxmeOZkQ7kNvwGTI21T&_nc_oc=AdrA0neGeZfKycEvJOuJHzeHIEy-74ppHZoWWufYf_tg5Fko6is7Co6buyIjog4pHWE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQtjTabGd9wZqG7xdyU23F1RL4DWFuSj3WdG_Uw3kzZig&oe=6AE741B3"}, "display_name": "Monkey Havoc", "keywords": ["Monkey", "Fan", "Game", "Gorilla", "Capuchin"], "long_description": "Welcome to Monkey Havoc, a game based off of the popular games 'Gorilla Tag' and 'Capuchin'. In Monkey Havoc you are able to freely move around many different maps with your friends, equip different styles of cosmetics, and compete in challenges to earn special cosmetics.\nThis game is constantly undergoing development and receiving updates to add more cosmetics, maps, and experiences.\nPlease let me know what to improve on by leaving a review and commenting on what could be better!\ud83d\ude0a\nContact Email: monkeyhavoccreator@gmail.com", "short_description": "Monkey Havoc is a 'Gorilla Tag' and 'Capuchin' fan game, made so that you and your friends can freely 
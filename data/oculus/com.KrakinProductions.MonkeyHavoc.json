795275_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3Zr73UEnFn8Q7kNvwE8_9uD&_nc_oc=AdpUeNwaJqgUlwmwKumZtJ4aQpbnDyNVvolhIUcdlAMIxtX5pfGJkGmNHlvyi69HB_o&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHVdyqNAU4LCtWRGLxIW4moQBwTCw3c_ET-uNlaNmjRzA&oe=6A773816"}, {"file_name": "5.png", "id": "540438542039147", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75395590_540438545372480_7329384731897725266_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NIaJqf6DW2QQ7kNvwF1Glvm&_nc_oc=Ado_XuecQ2EBmecix0LuA-dzSlBgOQdurVgRxBgEqDwBWblIsj5McQD67TOUeKT5_Ms&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG9OrmVQiZIvW19YiJUvIK23P-asnCKSdcCtd9z5M9ALw&oe=6A772FB5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Monkey Havoc Trailer Image.png", "id": "523796653745732", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974886_523796657079065_1178915653974772965_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-zLPcYt2cEsQ7kNvwHgWfy_&_nc_oc=AdqFHaad7kuADeXeI2lOC1fgvgLOsKgjHw9J1jjSnF6sPZQ3L7OFVqHxB1m9_JDrkXM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEOW1kC7eNqZDmROX4tOJ77b_ta8HvezaeUVJjsehpIuA&oe=6A773233"}, "display_name": "Monkey Havoc", "keywords": ["Monkey", "Fan", "Game", "Gorilla", "Capuchin"], "long_description": "Welcome to Monkey Havoc, a game based off of the popular games 'Gorilla Tag' and 'Capuchin'. In Monkey Havoc you are able to freely move around many different maps with your friends, equip different styles of cosmetics, and compete in challenges to earn special cosmetics.\nThis game is constantly undergoing development and receiving updates to add more cosmetics, maps, and experiences.\nPlease let me know what to improve on by leaving a review and commenting on what could be better!\ud83d\ude0a\nContact Email: monkeyhavoccreator@gmail.com", "short_description": "Monkey Havoc is a 'Gorilla Tag' and 'Capuchin' fan game, made so that you and your friends can freely 
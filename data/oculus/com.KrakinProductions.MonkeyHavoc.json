795275_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XpP5tpjOcx4Q7kNvwGJ7K4f&_nc_oc=Adrbh0tYQtsV7g7EN_xUHAdGzCQnW9OC7leHjoiL4vsB9JLRPstzHSD4QOtljH7r9rs&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-h04zh148QZ5c5vJCnxG7oPnZ0ruFqEFu4qCs8bkfzww&oe=6A3FD916"}, {"file_name": "5.png", "id": "540438542039147", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75395590_540438545372480_7329384731897725266_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bSmxKlCeMK4Q7kNvwGRuzR6&_nc_oc=AdrbGx1VZrg0aCIX6ph9pf-hOUmlOJ_DN15ndG0eMy_2tTjr5gc3rqqfJNaZU5k6dMo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_eMBvg4s_U0_3mc0fU6Tflai_VKcqjbyGDsBzhXC31aA&oe=6A3FD0B5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Monkey Havoc Trailer Image.png", "id": "523796653745732", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974886_523796657079065_1178915653974772965_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GKp_GKLfD0AQ7kNvwFW2cRp&_nc_oc=AdoQ9cUkDdnyhB-HB08jpSD8w9fbQdUYJG80zuBWa9kHgsJZENl5V1dCK6tsDFMeKT0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9Btr1sSIDzvgongkYU4jTg47tddUIXudJ2Z-QsQmzewA&oe=6A3FD333"}, "display_name": "Monkey Havoc", "keywords": ["Monkey", "Fan", "Game", "Gorilla", "Capuchin"], "long_description": "Welcome to Monkey Havoc, a game based off of the popular games 'Gorilla Tag' and 'Capuchin'. In Monkey Havoc you are able to freely move around many different maps with your friends, equip different styles of cosmetics, and compete in challenges to earn special cosmetics.\nThis game is constantly undergoing development and receiving updates to add more cosmetics, maps, and experiences.\nPlease let me know what to improve on by leaving a review and commenting on what could be better!\ud83d\ude0a\nContact Email: monkeyhavoccreator@gmail.com", "short_description": "Monkey Havoc is a 'Gorilla Tag' and 'Capuchin' fan game, made so that you and your friends can freely 
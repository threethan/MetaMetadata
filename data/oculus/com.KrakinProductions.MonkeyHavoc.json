795275_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9_aXE0MOBS8Q7kNvwGM82mI&_nc_oc=AdrMeV5mHlmmLyUhzF_HdnOvms73H3FHMelfzVuouXZVmEl3Ur8FoczxlloEqMVucbc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMJEbaWDA8pv2rX6omd0ypgKmIruxt6_CFPlnyt9c4b9A&oe=6ACE3B16"}, {"file_name": "5.png", "id": "540438542039147", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75395590_540438545372480_7329384731897725266_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NZI-vjC5BkgQ7kNvwEHvqeA&_nc_oc=Adr7V6C0tqDMEadkBne1dv4Ubat_chsbRbfwIxs4atrWRg2z7KClZa8p_giN6oneE_s&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPiGZQVkt64KiBv0uR9WqTk4UuO5BdcNKnLpC-vTqfQEw&oe=6ACE6AF5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Monkey Havoc Trailer Image.png", "id": "523796653745732", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974886_523796657079065_1178915653974772965_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7z_XYrJw4WwQ7kNvwGC7OfI&_nc_oc=AdrhHU5AZaTILGZ_0WCRppLNGyriBYdtNEAQo0p-adsCsQ-9PsT9Tq8ebljkzfxhZ8M&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNr2n5Li-dbYfT0seVe8sOtU6X2TPc-DZzrP5HLWaQzjA&oe=6ACE3533"}, "display_name": "Monkey Havoc", "keywords": ["Monkey", "Fan", "Game", "Gorilla", "Capuchin"], "long_description": "Welcome to Monkey Havoc, a game based off of the popular games 'Gorilla Tag' and 'Capuchin'. In Monkey Havoc you are able to freely move around many different maps with your friends, equip different styles of cosmetics, and compete in challenges to earn special cosmetics.\nThis game is constantly undergoing development and receiving updates to add more cosmetics, maps, and experiences.\nPlease let me know what to improve on by leaving a review and commenting on what could be better!\ud83d\ude0a\nContact Email: monkeyhavoccreator@gmail.com", "short_description": "Monkey Havoc is a 'Gorilla Tag' and 'Capuchin' fan game, made so that you and your friends can freely 
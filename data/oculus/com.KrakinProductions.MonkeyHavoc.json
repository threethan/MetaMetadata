795275_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W8cmmgwl3ZcQ7kNvwGg8YYa&_nc_oc=AdrVpCOxb71jv_eUk9Kjt827HDJvaB6_KsgoOYxJ3U-ObUqolZdZfKlRt-Iyiyif2Ok&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOlQWBDSwpULoyZOkbbVoeXfEhzlVVh-7GmA80bM4aBVQ&oe=6AE35316"}, {"file_name": "5.png", "id": "540438542039147", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/75395590_540438545372480_7329384731897725266_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K5ca8DSHl5QQ7kNvwG-2ZFK&_nc_oc=AdoioCu_1416t4dGIWoPM6J-2wz13NwCVVV0JyI0hzTrnWzL74TXnxpfI73XG-IFCdQ&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPuLfd2OOsCahxeszWsD8Iq8iiyBKcLCDy5Q0_f5yDB8A&oe=6AE34AB5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Monkey Havoc Trailer Image.png", "id": "523796653745732", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974886_523796657079065_1178915653974772965_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F-FhJYkTaDMQ7kNvwEEZVo7&_nc_oc=AdrHuL-U8EshArxjja813G0n2f3JWbPiCeRtbo_hVLQmzg-hgyIRsWj-gmeOg2dFRys&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNmyfA451D0JxgYwLOJN5ZFfE_YQt8zr-_Nf4PXZjsDrw&oe=6AE34D33"}, "display_name": "Monkey Havoc", "keywords": ["Monkey", "Fan", "Game", "Gorilla", "Capuchin"], "long_description": "Welcome to Monkey Havoc, a game based off of the popular games 'Gorilla Tag' and 'Capuchin'. In Monkey Havoc you are able to freely move around many different maps with your friends, equip different styles of cosmetics, and compete in challenges to earn special cosmetics.\nThis game is constantly undergoing development and receiving updates to add more cosmetics, maps, and experiences.\nPlease let me know what to improve on by leaving a review and commenting on what could be better!\ud83d\ude0a\nContact Email: monkeyhavoccreator@gmail.com", "short_description": "Monkey Havoc is a 'Gorilla Tag' and 'Capuchin' fan game, made so that you and your friends can freely 
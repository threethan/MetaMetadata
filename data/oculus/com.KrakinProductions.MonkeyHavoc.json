795275_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-aCtVQzRb00Q7kNvwGfLjph&_nc_oc=AdpW4G9QtxKHdv7GhpOuZ8nG5ymmDp3T2H12DhwGinx39oh45efpfD2IVlzrGTlY_38&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8tNqVqvksK6HgeYTzu02C-bvmaAYlaDYuMIzh8vAKk9A&oe=6A296F96"}, {"file_name": "5.png", "id": "540438542039147", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75395590_540438545372480_7329384731897725266_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EuRzjdXm2UUQ7kNvwH1cYvv&_nc_oc=AdoGtZ0kGJkLo4Jf0ax5eGFQ-onZB3Dpn_jfhnoOUxRQe9bAvXGPIQA9LrxnTvpJgbI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9BYbkdhjmj0ZSBoVqoe_Q40BpPEs5anXSYalVrbKDIdA&oe=6A296735"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Monkey Havoc Trailer Image.png", "id": "523796653745732", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974886_523796657079065_1178915653974772965_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CjQhP5vEJ8AQ7kNvwGhYT7B&_nc_oc=AdpcC2rEjQxUnJYy4UplrDHLN-e9rssGVCSqBAi8e3zjujMGB5FmLXcWLz5pjsKDRCU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_v-zoXqqYLYQtPYqTT0pc4_yEm3LoOeLYxsL6tzVlVQw&oe=6A2969B3"}, "display_name": "Monkey Havoc", "keywords": ["Monkey", "Fan", "Game", "Gorilla", "Capuchin"], "long_description": "Welcome to Monkey Havoc, a game based off of the popular games 'Gorilla Tag' and 'Capuchin'. In Monkey Havoc you are able to freely move around many different maps with your friends, equip different styles of cosmetics, and compete in challenges to earn special cosmetics.\nThis game is constantly undergoing development and receiving updates to add more cosmetics, maps, and experiences.\nPlease let me know what to improve on by leaving a review and commenting on what could be better!\ud83d\ude0a\nContact Email: monkeyhavoccreator@gmail.com", "short_description": "Monkey Havoc is a 'Gorilla Tag' and 'Capuchin' fan game, made so that you and your friends can freely 
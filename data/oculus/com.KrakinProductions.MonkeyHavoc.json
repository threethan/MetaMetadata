795275_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3l-F46UBTT4Q7kNvwHb5S4r&_nc_oc=Adq16SoGfwkbsk83L4SkdYS75-Rcafd2RmcW33oW2E8tvEMHU3IJdjyMx4s1oUc6SQQ&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJITTozBEC74FeLhYrAH5DB7A_ZtqqPQkuDqL15WImHnQ&oe=6AB68016"}, {"file_name": "5.png", "id": "540438542039147", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/75395590_540438545372480_7329384731897725266_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VY8INeVg4doQ7kNvwFHJxPH&_nc_oc=AdpgMcXZSCvkAcGn1zjLHQd8P5gSGM_AsqcxGM3MsHrzglgfi-9dxELedcNUuMsHVTA&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJCnL4OWAjObIJPTUDdSE8RC4DfltbdOk8RrRc_Wbxghg&oe=6AB677B5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Monkey Havoc Trailer Image.png", "id": "523796653745732", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38974886_523796657079065_1178915653974772965_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ba7d9OWujAIQ7kNvwHtPM7H&_nc_oc=AdogoQaBf6I3Ko0_oWr-n2WfP9v8n9xPrFEfrRxhePjfi1-TYjs79r4-p7dfzxyJoeo&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK3MkSy-0KhCF31W-Yy4hFyoBaEX29JB7DCEQzsyVizKQ&oe=6AB67A33"}, "display_name": "Monkey Havoc", "keywords": ["Monkey", "Fan", "Game", "Gorilla", "Capuchin"], "long_description": "Welcome to Monkey Havoc, a game based off of the popular games 'Gorilla Tag' and 'Capuchin'. In Monkey Havoc you are able to freely move around many different maps with your friends, equip different styles of cosmetics, and compete in challenges to earn special cosmetics.\nThis game is constantly undergoing development and receiving updates to add more cosmetics, maps, and experiences.\nPlease let me know what to improve on by leaving a review and commenting on what could be better!\ud83d\ude0a\nContact Email: monkeyhavoccreator@gmail.com", "short_description": "Monkey Havoc is a 'Gorilla Tag' and 'Capuchin' fan game, made so that you and your friends can freely 
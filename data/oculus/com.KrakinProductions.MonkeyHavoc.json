795275_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NdGclNi_w8wQ7kNvwF9F3R-&_nc_oc=AdobRXw_d5B3s8bxdevez5K1bMKsEqrvOg7O8jS6EU6RGTlTrKSYDiqjq9T_7NqGL0o&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3KJWconv8pjvBNMwI57yb0S0vb8Q9XilJttNobN8r-3w&oe=69F36216"}, {"file_name": "5.png", "id": "540438542039147", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/75395590_540438545372480_7329384731897725266_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1-YxS4OFGgUQ7kNvwFhHCUI&_nc_oc=AdrMJykIGVEL76P36GZXoQT1bLRAMwHAtS8o_5Ue_q37PSYiU0KeFCGgZ1dnjcPBsQY&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1Xz6DmDlxiPuKjapTXQ8THxOkPpNfnkWNpbnsTGookxg&oe=69F359B5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Monkey Havoc Trailer Image.png", "id": "523796653745732", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974886_523796657079065_1178915653974772965_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tzaArwWvKIAQ7kNvwE2WqkZ&_nc_oc=AdqTHEsB8PgMGTY8MV_i6BIDV0Uq7ZFIA3BRw1-h6g0-KnTQxARzUiCin1LSelFKOZ4&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2548EKJ09RW1RNnYTdI3SQWdeWXTb0puBBvEE_fqqcug&oe=69F35C33"}, "display_name": "Monkey Havoc", "keywords": ["Monkey", "Fan", "Game", "Gorilla", "Capuchin"], "long_description": "Welcome to Monkey Havoc, a game based off of the popular games 'Gorilla Tag' and 'Capuchin'. In Monkey Havoc you are able to freely move around many different maps with your friends, equip different styles of cosmetics, and compete in challenges to earn special cosmetics.\nThis game is constantly undergoing development and receiving updates to add more cosmetics, maps, and experiences.\nPlease let me know what to improve on by leaving a review and commenting on what could be better!\ud83d\ude0a\nContact Email: monkeyhavoccreator@gmail.com", "short_description": "Monkey Havoc is a 'Gorilla Tag' and 'Capuchin' fan game, made so that you and your friends can freely 
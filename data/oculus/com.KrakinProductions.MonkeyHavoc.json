9_1766831023204795275_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EW0-Vr4ZpJEQ7kNvwEmfkCd&_nc_oc=Adozr1ldpAQ0ln84g7-WsXW7FpPvS2v0TVMHG84SkaYwOcvgTL4gLfCV_cLVDWcCfLI&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-YiqwQYkdH5w6XqAEpMhFcf31nwnn11Hoqt1txYZ99Uw&oe=6A394196"}, {"file_name": "5.png", "id": "540438542039147", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/75395590_540438545372480_7329384731897725266_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xNMeMgSYHyUQ7kNvwHooGdh&_nc_oc=AdoF4PnVQpKFGzFf3KpbNSJ4nUgLMk3pcD_M---U9USWs3pstgjQoHywQtjB-tUePQE&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-BFr-J6VjY8Kx0IGVg21glo3ryhKwj2-8tqkk4x3mKNw&oe=6A393935"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Monkey Havoc Trailer Image.png", "id": "523796653745732", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/38974886_523796657079065_1178915653974772965_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=X4YkWC1XwNUQ7kNvwGwkHUk&_nc_oc=Adr24ctjMTsqQ0UvQI3rZ74TvCeOWolE2nksKfQDpZbyv6bPlPakivciB6QkOHkpARU&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_VkOYaa1m5lkfwNViElUiDY_RNn0dbaF0Z0g4j4eB4Fw&oe=6A393BB3"}, "display_name": "Monkey Havoc", "keywords": ["Monkey", "Fan", "Game", "Gorilla", "Capuchin"], "long_description": "Welcome to Monkey Havoc, a game based off of the popular games 'Gorilla Tag' and 'Capuchin'. In Monkey Havoc you are able to freely move around many different maps with your friends, equip different styles of cosmetics, and compete in challenges to earn special cosmetics.\nThis game is constantly undergoing development and receiving updates to add more cosmetics, maps, and experiences.\nPlease let me know what to improve on by leaving a review and commenting on what could be better!\ud83d\ude0a\nContact Email: monkeyhavoccreator@gmail.com", "short_description": "Monkey Havoc is a 'Gorilla Tag' and 'Capuchin' fan game, made so that you and your
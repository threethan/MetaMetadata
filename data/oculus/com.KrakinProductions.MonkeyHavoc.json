795275_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J04VSdztTGUQ7kNvwEtSSh8&_nc_oc=Adr-E5bkHUa96wdZv6M1DGfezrtVtyerBFe94XsbmC4n0yju9AD2k2ZnpYB-Li6Ma7w&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDeplKXbG2BL-bnbOQdeHmNWbwyDCcOcutPZJNY-ne2tw&oe=6A68B796"}, {"file_name": "5.png", "id": "540438542039147", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/75395590_540438545372480_7329384731897725266_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ppnjbfGfbgkQ7kNvwHjYhoh&_nc_oc=AdrrREu6xckL7Lk3WfP4y8oESMkxNB0_Wco-3gBlkYxsfHtz6Ko1kC3kqHZdY_8w45o&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDCsRcRf0bA05gL1UDSMZr5DiB5prrV6bYhRwupHEMXoA&oe=6A68AF35"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Monkey Havoc Trailer Image.png", "id": "523796653745732", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38974886_523796657079065_1178915653974772965_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zXk_LMlerNgQ7kNvwHH9Ibq&_nc_oc=AdrX_L4oob3mz5iLzgmZv6Ev0oZ2CQF4g_aGMt6ySeGs1Ce2y91_RVCktctwij62fZU&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDw2wefKacqW6b3nItH_Yahj8KHJRhcCFDcp2Sq2HYdRQ&oe=6A68B1B3"}, "display_name": "Monkey Havoc", "keywords": ["Monkey", "Fan", "Game", "Gorilla", "Capuchin"], "long_description": "Welcome to Monkey Havoc, a game based off of the popular games 'Gorilla Tag' and 'Capuchin'. In Monkey Havoc you are able to freely move around many different maps with your friends, equip different styles of cosmetics, and compete in challenges to earn special cosmetics.\nThis game is constantly undergoing development and receiving updates to add more cosmetics, maps, and experiences.\nPlease let me know what to improve on by leaving a review and commenting on what could be better!\ud83d\ude0a\nContact Email: monkeyhavoccreator@gmail.com", "short_description": "Monkey Havoc is a 'Gorilla Tag' and 'Capuchin' fan game, made so that you and your friends can freely 
795275_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9dkcd7RXfO0Q7kNvwE09PCf&_nc_oc=AdqemYbsxAp3RVE5XVuwOzSCB-hAcWko9jHv6ZT-p5UtPLJKMBEIgl3DNRTmZRvLKdw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDdZaDoKdiM4_AmsZQztkAHC3uAl3_HysU1auGXEDokGQ&oe=6A4FAB16"}, {"file_name": "5.png", "id": "540438542039147", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75395590_540438545372480_7329384731897725266_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H6HxYQuK30EQ7kNvwEczkEm&_nc_oc=AdqjrhbHNPKOTRh8lzMC0oNbujDv8nUb7dv_udStfGyb1bxGRbpMd3upRfWIetkfAXI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQABIFtG3f1qXOPRl0B38dHxjQlubyYqlAcolQi6NMyFCQ&oe=6A4FA2B5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Monkey Havoc Trailer Image.png", "id": "523796653745732", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974886_523796657079065_1178915653974772965_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gUPPzNGefvsQ7kNvwGjc-5D&_nc_oc=AdprYy3QNxUHEFPQUG0gSCPgXkAd7LCr4E_DG_aDR5f9Sn0slfjpPxk2oP3VUaCkdB0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCWyGOPxKmSz0Idz8qm4g1aBQjQVGlQIx1QhNQp_k5M2g&oe=6A4FA533"}, "display_name": "Monkey Havoc", "keywords": ["Monkey", "Fan", "Game", "Gorilla", "Capuchin"], "long_description": "Welcome to Monkey Havoc, a game based off of the popular games 'Gorilla Tag' and 'Capuchin'. In Monkey Havoc you are able to freely move around many different maps with your friends, equip different styles of cosmetics, and compete in challenges to earn special cosmetics.\nThis game is constantly undergoing development and receiving updates to add more cosmetics, maps, and experiences.\nPlease let me know what to improve on by leaving a review and commenting on what could be better!\ud83d\ude0a\nContact Email: monkeyhavoccreator@gmail.com", "short_description": "Monkey Havoc is a 'Gorilla Tag' and 'Capuchin' fan game, made so that you and your friends can freely 
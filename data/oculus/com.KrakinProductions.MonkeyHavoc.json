795275_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fN8aZg_p2dYQ7kNvwG-roFA&_nc_oc=Adpohyp6MdYqSnpCETtrYtnYF-cGdmH0Zcb6mGTYiVBhDv6fL5Xa-Dbd2tgqqFPD53E&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af49i5XyNi9l_jcICKlAuUuW9TG7yA4gFzdUKg_te7BJIw&oe=6A0F1196"}, {"file_name": "5.png", "id": "540438542039147", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/75395590_540438545372480_7329384731897725266_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IEZnB_Ypi08Q7kNvwG5WK3j&_nc_oc=AdrjYePKFsFCVrRSvSCAs50L7gIb3IDdqxOPTu2vPjhE5rQzwQ0vLi94y99S7V0mS5s&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7VEW85vUIqkBGQBi0GZT_P_gM4ZuziEts3_pQzeni4qw&oe=6A0F0935"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Monkey Havoc Trailer Image.png", "id": "523796653745732", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974886_523796657079065_1178915653974772965_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8ihiMxxZ3ggQ7kNvwEscVar&_nc_oc=AdovWd7ptMqKLy5DEyY3jznss7GWihI80QyW1g_Y6ExRV-gHGe9EPPV9rkTiOoO6YSs&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5H7ANTPblgw-ygwG9eh-tHaHS1Otkh0BPJMUtF9LDlKQ&oe=6A0F0BB3"}, "display_name": "Monkey Havoc", "keywords": ["Monkey", "Fan", "Game", "Gorilla", "Capuchin"], "long_description": "Welcome to Monkey Havoc, a game based off of the popular games 'Gorilla Tag' and 'Capuchin'. In Monkey Havoc you are able to freely move around many different maps with your friends, equip different styles of cosmetics, and compete in challenges to earn special cosmetics.\nThis game is constantly undergoing development and receiving updates to add more cosmetics, maps, and experiences.\nPlease let me know what to improve on by leaving a review and commenting on what could be better!\ud83d\ude0a\nContact Email: monkeyhavoccreator@gmail.com", "short_description": "Monkey Havoc is a 'Gorilla Tag' and 'Capuchin' fan game, made so that you and your friends can freely 
795275_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J04VSdztTGUQ7kNvwGH99Qq&_nc_oc=AdpOVe4Vva9ILbfyH1VrV-0nVw_9HBQxioDEetD1I81LYQXDHyxprlTM7I5ca0MAOws&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBjYCJLCLTM34l7rd7jNT9tE4PmssMqJWe7aEfqMQmK3A&oe=6A6B5A96"}, {"file_name": "5.png", "id": "540438542039147", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75395590_540438545372480_7329384731897725266_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DmM4pe9K7_QQ7kNvwFQBOKU&_nc_oc=AdqLQZmFEZHizdaCJBWEFoUYEZgdvpFOFCkJsSa--c9D3dSjzrO21ePylu4Q66FXj64&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB_DgNf8fhAEu6ikf2uAmqECo2PmNhWC_BbSwUfNKczIg&oe=6A6B5235"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Monkey Havoc Trailer Image.png", "id": "523796653745732", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974886_523796657079065_1178915653974772965_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XMLxML_29z0Q7kNvwGlD3ik&_nc_oc=AdrpX0TFBe0E0CjhIaU_Agzt8kpdUiH9vDXhYv0scI-kN8v5_mKOSwnOHtBbQpUbneY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBrkJ2McOE23ouh9Kq0NbFxpcT2rI76d-rOHZ6Ltthnfg&oe=6A6B54B3"}, "display_name": "Monkey Havoc", "keywords": ["Monkey", "Fan", "Game", "Gorilla", "Capuchin"], "long_description": "Welcome to Monkey Havoc, a game based off of the popular games 'Gorilla Tag' and 'Capuchin'. In Monkey Havoc you are able to freely move around many different maps with your friends, equip different styles of cosmetics, and compete in challenges to earn special cosmetics.\nThis game is constantly undergoing development and receiving updates to add more cosmetics, maps, and experiences.\nPlease let me know what to improve on by leaving a review and commenting on what could be better!\ud83d\ude0a\nContact Email: monkeyhavoccreator@gmail.com", "short_description": "Monkey Havoc is a 'Gorilla Tag' and 'Capuchin' fan game, made so that you and your friends can freely 
795275_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4TCYuORg2P8Q7kNvwHiXVvl&_nc_oc=AdrNawclY55U42xgTgajyvy-LMjAFxoijty2c8BRRF_zSN3gjqCP0WIOL-6RiEOF81s&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyG5zjgDNh7j_GlEEuvVQjC4ZG02X1z0wA5P0238adaSw&oe=69CFC996"}, {"file_name": "5.png", "id": "540438542039147", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75395590_540438545372480_7329384731897725266_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hzMe_Ly4AXoQ7kNvwGZlS70&_nc_oc=AdpP2NMIQ6pMioZHMiNbL5162vFsL0voNa0CMFWGZOFCih3NzY1e-HrvKVISg-onuIY&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afw9s-M9ZvrioXYLITruhQZj_OYmykESwJkGr8wDDJ0IgQ&oe=69CFC135"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Monkey Havoc Trailer Image.png", "id": "523796653745732", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974886_523796657079065_1178915653974772965_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MIPUzCS2RQ4Q7kNvwEFzmB3&_nc_oc=Adq9DBblksbr-rzSX0SsJoS_k-NtUYZfudrzDiaRxiocqhsOBVhrd1fv5OaSIV-AD18&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afwo-eGNRe7I6RoTqqrW4sdxsQF1tAYgjI-qBWEe13uRxw&oe=69CFC3B3"}, "display_name": "Monkey Havoc", "keywords": ["Monkey", "Fan", "Game", "Gorilla", "Capuchin"], "long_description": "Welcome to Monkey Havoc, a game based off of the popular games 'Gorilla Tag' and 'Capuchin'. In Monkey Havoc you are able to freely move around many different maps with your friends, equip different styles of cosmetics, and compete in challenges to earn special cosmetics.\nThis game is constantly undergoing development and receiving updates to add more cosmetics, maps, and experiences.\nPlease let me know what to improve on by leaving a review and commenting on what could be better!\ud83d\ude0a\nContact Email: monkeyhavoccreator@gmail.com", "short_description": "Monkey Havoc is a 'Gorilla Tag' and 'Capuchin' fan game, made so that you and your friends can freely 
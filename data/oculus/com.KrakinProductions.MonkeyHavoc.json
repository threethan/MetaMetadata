795275_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d_PrLSsDchsQ7kNvwEKVUjM&_nc_oc=AdpxBxAxx-NOf7qBxCD4u5ETiVxEoyrhK4DVxA1uUQBb2SA_Jfy8XnuWHFNGUhvjVUU&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMvzU4T0W2IA5JlVLTOTNLnhskC5m-slvRHiAAaC7FjgA&oe=6AC8F516"}, {"file_name": "5.png", "id": "540438542039147", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/75395590_540438545372480_7329384731897725266_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pAFAADYZ5pMQ7kNvwHKYOYZ&_nc_oc=AdqJtkdXrWsopII3buBwaTGWWHgS3IaqYWRreLv2qB73Mu8RCDw1I1dkUUympV2jtIU&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO-4j24NLIU3eAc_RTqDsrrhlncAXkJxFqyUwGxuPCH8w&oe=6AC8ECB5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Monkey Havoc Trailer Image.png", "id": "523796653745732", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38974886_523796657079065_1178915653974772965_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UscWCrXIPNAQ7kNvwHN3cPA&_nc_oc=Adp7cIYWzYnMnqNXO4cApWCAdFo_WmpSfGA_8mb-urssvdYcisFCg_2kDND916PA6EU&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM4u2aqTgQ5S6pZzROLl3eEtMjaF9abKzPWz713OL7F2g&oe=6AC8EF33"}, "display_name": "Monkey Havoc", "keywords": ["Monkey", "Fan", "Game", "Gorilla", "Capuchin"], "long_description": "Welcome to Monkey Havoc, a game based off of the popular games 'Gorilla Tag' and 'Capuchin'. In Monkey Havoc you are able to freely move around many different maps with your friends, equip different styles of cosmetics, and compete in challenges to earn special cosmetics.\nThis game is constantly undergoing development and receiving updates to add more cosmetics, maps, and experiences.\nPlease let me know what to improve on by leaving a review and commenting on what could be better!\ud83d\ude0a\nContact Email: monkeyhavoccreator@gmail.com", "short_description": "Monkey Havoc is a 'Gorilla Tag' and 'Capuchin' fan game, made so that you and your friends can freely 
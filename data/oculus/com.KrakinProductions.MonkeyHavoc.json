795275_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sLEu_RiWjrQQ7kNvwH7j7nH&_nc_oc=Adp-7EJHpk-CqtIWyVr-Tov2b1ZUvJMrTTRLgzPTdui8WXnyTcdjrr29xNW3NVn6bkc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN74HI9imYokxF1Gxl_F1r2jim_7GvP_qA83FNv-agACg&oe=6ABFBA96"}, {"file_name": "5.png", "id": "540438542039147", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75395590_540438545372480_7329384731897725266_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=roKUpbpNQ68Q7kNvwH9_aP7&_nc_oc=Adq_zTMyo8QRzAoIUubdEsHfbslCy6vVC4XVFYHQyAixfFtxE6pcn10oxhiQL_ZNTKc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOxoSYgP9VenOE-n2aTcxCXPYOvHEoDZbG__HpTZ1_ncg&oe=6ABFB235"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Monkey Havoc Trailer Image.png", "id": "523796653745732", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974886_523796657079065_1178915653974772965_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tRX_ObG82IEQ7kNvwFlBSof&_nc_oc=AdqzWtqkDyqL-WvsGVufmJFND3x1sADoaI-z_zcX_upfSRJadh0CjPwbqKgWc6nkMiU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOmNVvLKd4kQUr_S8hzP4yrYIO6KN6uJfVnTj5uOxK-4g&oe=6ABFB4B3"}, "display_name": "Monkey Havoc", "keywords": ["Monkey", "Fan", "Game", "Gorilla", "Capuchin"], "long_description": "Welcome to Monkey Havoc, a game based off of the popular games 'Gorilla Tag' and 'Capuchin'. In Monkey Havoc you are able to freely move around many different maps with your friends, equip different styles of cosmetics, and compete in challenges to earn special cosmetics.\nThis game is constantly undergoing development and receiving updates to add more cosmetics, maps, and experiences.\nPlease let me know what to improve on by leaving a review and commenting on what could be better!\ud83d\ude0a\nContact Email: monkeyhavoccreator@gmail.com", "short_description": "Monkey Havoc is a 'Gorilla Tag' and 'Capuchin' fan game, made so that you and your friends can freely 
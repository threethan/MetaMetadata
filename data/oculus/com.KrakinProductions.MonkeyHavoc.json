795275_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aqi0RuHgNSYQ7kNvwEi6w72&_nc_oc=AdpwIQKL3i0AeTURPKrY7mD-fZZfLs132IXz4UA-3JjSQTcIIE-GxDWeYJByBLjDmBI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLl_FqniEySxVd43MU5XojxFd9bd79AC44h3QuxCnVEzA&oe=6A9865D6"}, {"file_name": "5.png", "id": "540438542039147", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75395590_540438545372480_7329384731897725266_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hElk_4roPtsQ7kNvwGpOsTQ&_nc_oc=AdrmwWIxH4T6gzls_f7NJsEXcwajGBRGGoc-7ozsxrdvlriBmRiCNlnHMq-D_IyrqmM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIMrGNijTRyk8xSE1kpY5hSF9k3JKyPDgxjuSHiD99uEg&oe=6A985D75"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Monkey Havoc Trailer Image.png", "id": "523796653745732", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974886_523796657079065_1178915653974772965_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=X-6jl4xVe5wQ7kNvwEkJWJt&_nc_oc=AdoysXSQGHKEwTUOGHoNojeO8Pl2Fv1EB9vgCbA-rcfA5xM3aRyQwcpJgP3XlXB01MA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJangdOAmcV9AZM1oxjHv0tCI6x9AUFVq0xC6RENNTSIA&oe=6A985FF3"}, "display_name": "Monkey Havoc", "keywords": ["Monkey", "Fan", "Game", "Gorilla", "Capuchin"], "long_description": "Welcome to Monkey Havoc, a game based off of the popular games 'Gorilla Tag' and 'Capuchin'. In Monkey Havoc you are able to freely move around many different maps with your friends, equip different styles of cosmetics, and compete in challenges to earn special cosmetics.\nThis game is constantly undergoing development and receiving updates to add more cosmetics, maps, and experiences.\nPlease let me know what to improve on by leaving a review and commenting on what could be better!\ud83d\ude0a\nContact Email: monkeyhavoccreator@gmail.com", "short_description": "Monkey Havoc is a 'Gorilla Tag' and 'Capuchin' fan game, made so that you and your friends can freely 
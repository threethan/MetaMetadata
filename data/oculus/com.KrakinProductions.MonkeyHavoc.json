795275_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6EyEekbrIuYQ7kNvwH9jC2S&_nc_oc=Adqk16JYLkHEE640N2bY2lWzis0THucTA6cAjKZRwflmV_NmJNmYUqQ4X4GAiTCnxI8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1-6BA7iFEa5RzjaC0aV4jd2BENz94yU2_6d3zk0Z0yrQ&oe=69F8A816"}, {"file_name": "5.png", "id": "540438542039147", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75395590_540438545372480_7329384731897725266_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q0J_TEiC9PgQ7kNvwGU5JC1&_nc_oc=AdoksbMknyWPrx17ydpvBlxBU9KQ4Gk7eU7x9lxrD-YZp5Mm8S3AjcWXVr90yPapR5U&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1qAPAnaURf2KMy-xiufN8ZW59EQmaYBabs9ocE4mXZZg&oe=69F89FB5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Monkey Havoc Trailer Image.png", "id": "523796653745732", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974886_523796657079065_1178915653974772965_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JCmnWZ6hfzgQ7kNvwGVCCwt&_nc_oc=AdpdegbgalW8LF7DSK6l8EBkM7Ak5TqAZB_Y7V3jFma7kb8xu3D5hkILhHcJJ1AKfYo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af14nLyBlSFOa3UyxvfTgCZqrjW4rpd2Ys-0yyketT4NaA&oe=69F8A233"}, "display_name": "Monkey Havoc", "keywords": ["Monkey", "Fan", "Game", "Gorilla", "Capuchin"], "long_description": "Welcome to Monkey Havoc, a game based off of the popular games 'Gorilla Tag' and 'Capuchin'. In Monkey Havoc you are able to freely move around many different maps with your friends, equip different styles of cosmetics, and compete in challenges to earn special cosmetics.\nThis game is constantly undergoing development and receiving updates to add more cosmetics, maps, and experiences.\nPlease let me know what to improve on by leaving a review and commenting on what could be better!\ud83d\ude0a\nContact Email: monkeyhavoccreator@gmail.com", "short_description": "Monkey Havoc is a 'Gorilla Tag' and 'Capuchin' fan game, made so that you and your friends can freely 
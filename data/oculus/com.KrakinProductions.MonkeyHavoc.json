795275_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IqkvtkPj9hsQ7kNvwFmR8Lx&_nc_oc=Adrx9ZTPNYoJ6Pe-A9q054q51L6jIYr7Qs213sCRIs4NkOhGwZFt3dTFaiDtLbDsN2A&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afxt6NkDEKlq7CuphJKPPMu0oJRcPScO1KnfVMqV8LPedw&oe=69C93216"}, {"file_name": "5.png", "id": "540438542039147", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75395590_540438545372480_7329384731897725266_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uuaAAyahwz0Q7kNvwFETN3L&_nc_oc=Adrfpc5MdeHFXbd8bvnc60BpVEbF6o96_i_eFxuuEpZ6UnIhR9bV3UOyxGQpCnl28iw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyFqDk7M4HYINfiwP-Ei8J0ne_ownDnU7XQ-LMo0VzhOQ&oe=69C929B5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Monkey Havoc Trailer Image.png", "id": "523796653745732", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974886_523796657079065_1178915653974772965_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IMsk35votOMQ7kNvwHj2BS8&_nc_oc=AdpcdKOShqr20bUyjd9tsw_p8wzr881UP5bCCz2YLZwNhWOZ9lyd5sKFSmAN19k9rrw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyRcv8TUDS4TZ9OWaVUIVIU5XUEK73RtvGRVI8rUSHQoQ&oe=69C92C33"}, "display_name": "Monkey Havoc", "keywords": ["Monkey", "Fan", "Game", "Gorilla", "Capuchin"], "long_description": "Welcome to Monkey Havoc, a game based off of the popular games 'Gorilla Tag' and 'Capuchin'. In Monkey Havoc you are able to freely move around many different maps with your friends, equip different styles of cosmetics, and compete in challenges to earn special cosmetics.\nThis game is constantly undergoing development and receiving updates to add more cosmetics, maps, and experiences.\nPlease let me know what to improve on by leaving a review and commenting on what could be better!\ud83d\ude0a\nContact Email: monkeyhavoccreator@gmail.com", "short_description": "Monkey Havoc is a 'Gorilla Tag' and 'Capuchin' fan game, made so that you and your friends can freely 
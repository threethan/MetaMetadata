795275_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1oHcS74pV20Q7kNvwEoK7Vy&_nc_oc=AdqCVPgEvqQ7XrQElbyxCE0n0WqTVoeOJe6pcB2gvcK30P7KdUc1MKvsSQ1-86sHTEw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1dFMudCcW4CVZo5dYW09i4K0deSS-OcmGDMPBk2O_Mqw&oe=69ECCA96"}, {"file_name": "5.png", "id": "540438542039147", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75395590_540438545372480_7329384731897725266_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cVwkJMuKyEcQ7kNvwFrszm9&_nc_oc=AdqfO_iOVlQ2AhnAOb9jmCX6U0O8MF8BOvlc4XRoYILlN5bPiTobjpgRATUYxKhMHcM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0izIizL3mP187-0zUVQ3rCg0tprostDpt00rgAVw6qKw&oe=69ECC235"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Monkey Havoc Trailer Image.png", "id": "523796653745732", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974886_523796657079065_1178915653974772965_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DbfFuXHU_G0Q7kNvwFG3Wak&_nc_oc=AdrfNDj212EsUUpUkqb0y9vocQWLii2C8o2VabVwDfaJZ6KsuNkX49NS8Rs6Yktx960&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1cywnR7-db9n_5fByfd_V5ozYLSjrCaW4bFdoewIEs0w&oe=69ECC4B3"}, "display_name": "Monkey Havoc", "keywords": ["Monkey", "Fan", "Game", "Gorilla", "Capuchin"], "long_description": "Welcome to Monkey Havoc, a game based off of the popular games 'Gorilla Tag' and 'Capuchin'. In Monkey Havoc you are able to freely move around many different maps with your friends, equip different styles of cosmetics, and compete in challenges to earn special cosmetics.\nThis game is constantly undergoing development and receiving updates to add more cosmetics, maps, and experiences.\nPlease let me know what to improve on by leaving a review and commenting on what could be better!\ud83d\ude0a\nContact Email: monkeyhavoccreator@gmail.com", "short_description": "Monkey Havoc is a 'Gorilla Tag' and 'Capuchin' fan game, made so that you and your friends can freely 
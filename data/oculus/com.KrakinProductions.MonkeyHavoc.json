795275_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ADVzqbOXCPoQ7kNvwHCRmHm&_nc_oc=AdpJgKs9_jwq-FSWni_iylfCpxKPlFTS7yrrOCbNGjY2FJ3kpjt_PNEeEzojteJ8xn8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB8TdemXoWfhw4vlAwgNiY-O4lNAT9qyxLblBgT74UjEQ&oe=6A622016"}, {"file_name": "5.png", "id": "540438542039147", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75395590_540438545372480_7329384731897725266_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TTkE1TQLR9wQ7kNvwGy-X5U&_nc_oc=Adoavm11nGnryOksK1DehWCcyWuzPm2goD1SjPGJm6dFe4YKkuDv_DRiVkFhL8C9qCo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCnQP0YhHTj-20n1Yi-Hen7cJV80GGX7mq5T0yuWx-JNQ&oe=6A6217B5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Monkey Havoc Trailer Image.png", "id": "523796653745732", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974886_523796657079065_1178915653974772965_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AMMZWdAL8nwQ7kNvwHeLoyn&_nc_oc=AdqwTNG6p2EfYTMBkrS0Jc5esI1O2J_aMglxxNuWkFeSn08EWtyar-6UwAPpygm84eE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCImY2TJBznwzX08j8gA8m5RdgwfuQr9mRvtYnNNNqeqw&oe=6A621A33"}, "display_name": "Monkey Havoc", "keywords": ["Monkey", "Fan", "Game", "Gorilla", "Capuchin"], "long_description": "Welcome to Monkey Havoc, a game based off of the popular games 'Gorilla Tag' and 'Capuchin'. In Monkey Havoc you are able to freely move around many different maps with your friends, equip different styles of cosmetics, and compete in challenges to earn special cosmetics.\nThis game is constantly undergoing development and receiving updates to add more cosmetics, maps, and experiences.\nPlease let me know what to improve on by leaving a review and commenting on what could be better!\ud83d\ude0a\nContact Email: monkeyhavoccreator@gmail.com", "short_description": "Monkey Havoc is a 'Gorilla Tag' and 'Capuchin' fan game, made so that you and your friends can freely 
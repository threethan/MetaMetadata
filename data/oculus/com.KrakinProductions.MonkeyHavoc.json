9_1766831023204795275_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ct9VmgPnqNkQ7kNvwHz1tzK&_nc_oc=AdocSlO_FvH5qkDuZmIUH2FQLBuH6JntVcRAv6HI4LopV_A6U58Pj86aCbRLu9snduw&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE4TXrKp1-X1F8Gs0W_o5cpB3H0FXf4udBODxeVk3FF7w&oe=6A7D9756"}, {"file_name": "5.png", "id": "540438542039147", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/75395590_540438545372480_7329384731897725266_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MrkfUUbcRkAQ7kNvwG5iCtA&_nc_oc=Adpu3nUPeCj9sbdTsidY1nepUVui8FuwWEvXuPdW-RaFB6pOGjRyH8dHSXKCjbhDEc8&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFJQOIrrhli6C-6qCwIspHUc-MfeUaICfaJeEQy06I0vQ&oe=6A7DC735"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Monkey Havoc Trailer Image.png", "id": "523796653745732", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/38974886_523796657079065_1178915653974772965_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=815sSFYce4cQ7kNvwF9UdFK&_nc_oc=AdqMGRypUPiCl_eYCW-aNPadFDvcaqxYpN6150DnM2f0RraQ95dk7autG1jvjdZOh7I&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFPQP_5zEhiXMKlPk1SZhuNpSGuosC9wGUY3J0K5LmmKQ&oe=6A7DC9B3"}, "display_name": "Monkey Havoc", "keywords": ["Monkey", "Fan", "Game", "Gorilla", "Capuchin"], "long_description": "Welcome to Monkey Havoc, a game based off of the popular games 'Gorilla Tag' and 'Capuchin'. In Monkey Havoc you are able to freely move around many different maps with your friends, equip different styles of cosmetics, and compete in challenges to earn special cosmetics.\nThis game is constantly undergoing development and receiving updates to add more cosmetics, maps, and experiences.\nPlease let me know what to improve on by leaving a review and commenting on what could be better!\ud83d\ude0a\nContact Email: monkeyhavoccreator@gmail.com", "short_description": "Monkey Havoc is a 'Gorilla Tag' and 'Capuchin' fan game, made so that you and your
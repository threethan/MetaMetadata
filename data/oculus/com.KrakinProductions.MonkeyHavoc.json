795275_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sZgHOfWCtiQQ7kNvwG3oFCD&_nc_oc=Adr6F8nq-HLnL6GemRWZ3W2gXM8RDX094Tdhy-xHzYopn2883wQAFe5AY4EfWD1tgCA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG022iXPvdK1PR8CGo-YEUrFUne7vVGor-V6TeGr3A_cg&oe=6A831596"}, {"file_name": "5.png", "id": "540438542039147", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75395590_540438545372480_7329384731897725266_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rFQmAJrbCRMQ7kNvwETOtqe&_nc_oc=Adq4OKvLPVjE5d2i6_BOa7A3a0aoBjzPDbc3w35beIVY2r1xgA0Z2bMkzI9LKsQ1pRw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFvftVX2Agcv2doXmDchXIEiTN0lROCoyh1BHilE8uWQQ&oe=6A830D35"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Monkey Havoc Trailer Image.png", "id": "523796653745732", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974886_523796657079065_1178915653974772965_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v3adgAil0I8Q7kNvwEyNKnC&_nc_oc=AdqHP3--GfqP5X2dI2TrHqbjrTus9YJVYoaeWrrsT2xtnjo0QBuTID_t1DdFFQQ7hgE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE2pK3CiB1TT5X0F_lGSbPpdGH-PkQ5FdKxS9j1_ANCBg&oe=6A830FB3"}, "display_name": "Monkey Havoc", "keywords": ["Monkey", "Fan", "Game", "Gorilla", "Capuchin"], "long_description": "Welcome to Monkey Havoc, a game based off of the popular games 'Gorilla Tag' and 'Capuchin'. In Monkey Havoc you are able to freely move around many different maps with your friends, equip different styles of cosmetics, and compete in challenges to earn special cosmetics.\nThis game is constantly undergoing development and receiving updates to add more cosmetics, maps, and experiences.\nPlease let me know what to improve on by leaving a review and commenting on what could be better!\ud83d\ude0a\nContact Email: monkeyhavoccreator@gmail.com", "short_description": "Monkey Havoc is a 'Gorilla Tag' and 'Capuchin' fan game, made so that you and your friends can freely 
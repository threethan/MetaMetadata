795275_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BIb5kWmNjDEQ7kNvwGq_-mu&_nc_oc=Adq-jBDTJnLwzts8dYuFE7eNIGKWdca7NUbkdZ6M99jv-rAot1h5RgD7NYmhg9ZzW80&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afz9m5nOIqQVDSiE7dAVURjWfo10vcwms_p5oXuXYAJkcA&oe=69C53D96"}, {"file_name": "5.png", "id": "540438542039147", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/75395590_540438545372480_7329384731897725266_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rpIOteHO_9QQ7kNvwH4D5hC&_nc_oc=AdqCa-PwTvxK55ryxg_sbR2klTwmSCNZX4lTa0Z-3Q_y5pXyMH_Pbi6mguqs0aYqZf8&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzhUHSGG_2LxkC5okMuYlfMf9Y3WgqwOqbQu-oLwcjo5A&oe=69C53535"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Monkey Havoc Trailer Image.png", "id": "523796653745732", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974886_523796657079065_1178915653974772965_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nVmNcm4UAZcQ7kNvwGFR8xM&_nc_oc=AdqMiwltgMje_6uq54eQa3b3PBkD88uUkxulEIpEPxQYyaA5fpPYDSXIPFaLpcnJFxQ&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afy58jCnXN8bGn2ZR-ItlQ_gbZ3JhjyAsaTGF3KkQjh3zw&oe=69C537B3"}, "display_name": "Monkey Havoc", "keywords": ["Monkey", "Fan", "Game", "Gorilla", "Capuchin"], "long_description": "Welcome to Monkey Havoc, a game based off of the popular games 'Gorilla Tag' and 'Capuchin'. In Monkey Havoc you are able to freely move around many different maps with your friends, equip different styles of cosmetics, and compete in challenges to earn special cosmetics.\nThis game is constantly undergoing development and receiving updates to add more cosmetics, maps, and experiences.\nPlease let me know what to improve on by leaving a review and commenting on what could be better!\ud83d\ude0a\nContact Email: monkeyhavoccreator@gmail.com", "short_description": "Monkey Havoc is a 'Gorilla Tag' and 'Capuchin' fan game, made so that you and your friends can freely 
795275_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YDetaY1sw-YQ7kNvwGRf7yP&_nc_oc=AdqvvknbAfVyZvi8mS_fZo9v1aebAsvOj3SmfFP2IcLHat85GMM6WCEr-nRG_RIM4tE&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM8Vf0ZzN7CgyLMIKz5A-72isYQtq87yeGBXjVa2q5XLw&oe=6ADCBB96"}, {"file_name": "5.png", "id": "540438542039147", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75395590_540438545372480_7329384731897725266_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RjIbaCKwjLsQ7kNvwF1rS4h&_nc_oc=AdpxRU9LyKIITNqsAjfL85I15A50Gygb0qz7xyF1tEPAcIamJXRdDMY-zqUyyrm0NOo&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMlhQfMYRza0E1RCXvAdxQuinJv6hHWjgOCFZgOh3mA0w&oe=6ADCB335"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Monkey Havoc Trailer Image.png", "id": "523796653745732", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974886_523796657079065_1178915653974772965_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2pgHEtzxKYEQ7kNvwFQrJgM&_nc_oc=Adr9ULVOVu6fnroF2mURe6m5iN_cVHlhFnxbw_PfqQ5vTytBZYXqUqTCf-Yp0ATJv1E&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNXQ4QW5G-ZtRj3_ZjbbZVfUNuRN0r8XY0_l36FAb-AGQ&oe=6ADCB5B3"}, "display_name": "Monkey Havoc", "keywords": ["Monkey", "Fan", "Game", "Gorilla", "Capuchin"], "long_description": "Welcome to Monkey Havoc, a game based off of the popular games 'Gorilla Tag' and 'Capuchin'. In Monkey Havoc you are able to freely move around many different maps with your friends, equip different styles of cosmetics, and compete in challenges to earn special cosmetics.\nThis game is constantly undergoing development and receiving updates to add more cosmetics, maps, and experiences.\nPlease let me know what to improve on by leaving a review and commenting on what could be better!\ud83d\ude0a\nContact Email: monkeyhavoccreator@gmail.com", "short_description": "Monkey Havoc is a 'Gorilla Tag' and 'Capuchin' fan game, made so that you and your friends can freely 
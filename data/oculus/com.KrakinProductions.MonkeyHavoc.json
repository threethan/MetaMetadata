795275_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eX-KZP4WktMQ7kNvwGqqFKr&_nc_oc=AdqFyncBQWJcC5zpJ-QQoXelAO4BALy6b3GJ_THOD1tUjIOK_3UDQ04zo62qJH-RzJc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKRC60U2eaBhX6DQif4ayia37rTP14qUnadu5cOdfHbDg&oe=6ABA7496"}, {"file_name": "5.png", "id": "540438542039147", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75395590_540438545372480_7329384731897725266_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PT73cRHREP0Q7kNvwHp7L5X&_nc_oc=AdoByPjVpMIBPxcehSmn9djFJnLbqLzUMPuW4PfL4ckA1XxysgL5b0oxypFr0XFUJVc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL9CxS8BhzBiQ8wH0guU-xMuOe9zDFD8vCKZ2qYjJezVg&oe=6ABA6C35"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Monkey Havoc Trailer Image.png", "id": "523796653745732", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974886_523796657079065_1178915653974772965_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c_SevkJ9K6kQ7kNvwETGKAr&_nc_oc=AdqbjQ7jErG5pSvdfB5IB080V7FW2uYZGNgHu8NymiilH_PzA56AcYfZyMYI-KyTQVE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLBeBcDDwvkX84FL9hLq7XzscfofkJgfFxOEXskivqsig&oe=6ABA6EB3"}, "display_name": "Monkey Havoc", "keywords": ["Monkey", "Fan", "Game", "Gorilla", "Capuchin"], "long_description": "Welcome to Monkey Havoc, a game based off of the popular games 'Gorilla Tag' and 'Capuchin'. In Monkey Havoc you are able to freely move around many different maps with your friends, equip different styles of cosmetics, and compete in challenges to earn special cosmetics.\nThis game is constantly undergoing development and receiving updates to add more cosmetics, maps, and experiences.\nPlease let me know what to improve on by leaving a review and commenting on what could be better!\ud83d\ude0a\nContact Email: monkeyhavoccreator@gmail.com", "short_description": "Monkey Havoc is a 'Gorilla Tag' and 'Capuchin' fan game, made so that you and your friends can freely 
795275_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZYeja5LxiZQQ7kNvwHxRO98&_nc_oc=Ado5cN9kh3UesJGe-nhJzaaHurtBUvC71nK6jDsjZ1MUB_N3iRyjhjp-wfSIMkfjxUI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3ITYKt_XOLIEsbZp_wMfMioH5Lu2J1FJn8eUz8_9A9Lg&oe=69E0ED16"}, {"file_name": "5.png", "id": "540438542039147", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75395590_540438545372480_7329384731897725266_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lNySnJ3wk00Q7kNvwENsfhU&_nc_oc=AdqzXsWlMVDeVOc8ecL4OqQPGNXgw5GZ0ci3XFp4VycEQvKgj04RQB9jrmL-rSC4RKo&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1mmD2YoOpgVhStUShXAYq1TVGjes6DgXCaEzxLRbYTdg&oe=69E0E4B5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Monkey Havoc Trailer Image.png", "id": "523796653745732", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974886_523796657079065_1178915653974772965_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Kt-WWXSma4QQ7kNvwFrKRC6&_nc_oc=AdpEi1aXeDpTOQWboKNeHEjB9vKiu8OLPYo4W2_AFxSNCksr5dGvaXFiPVmhi1cQn0Y&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af14RqAoAPSJZim_XYqYylP5X-12nOLZwnB7DSq0GhwcFQ&oe=69E0E733"}, "display_name": "Monkey Havoc", "keywords": ["Monkey", "Fan", "Game", "Gorilla", "Capuchin"], "long_description": "Welcome to Monkey Havoc, a game based off of the popular games 'Gorilla Tag' and 'Capuchin'. In Monkey Havoc you are able to freely move around many different maps with your friends, equip different styles of cosmetics, and compete in challenges to earn special cosmetics.\nThis game is constantly undergoing development and receiving updates to add more cosmetics, maps, and experiences.\nPlease let me know what to improve on by leaving a review and commenting on what could be better!\ud83d\ude0a\nContact Email: monkeyhavoccreator@gmail.com", "short_description": "Monkey Havoc is a 'Gorilla Tag' and 'Capuchin' fan game, made so that you and your friends can freely 
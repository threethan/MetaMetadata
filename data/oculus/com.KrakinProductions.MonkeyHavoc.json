795275_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pX39wAGb-qQQ7kNvwGeFBaY&_nc_oc=AdoXimvRAYveY3OjwTRqn7_i_nrTkWriuwd7I2j8SKVhuWuwovEwY4s8HvVXCvRSWvU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTnR3HbZ_oTriydIEtZRChwQaefUF7KD8ErueDvB0fYQA&oe=6AF71996"}, {"file_name": "5.png", "id": "540438542039147", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75395590_540438545372480_7329384731897725266_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SqSD6BDR_nAQ7kNvwGUwQ1g&_nc_oc=Ado7vey-l1Qew9qbAJ-aCNhFY5MsFACRYT2pm3irUhecB7lIrwQFYZooP8_uKra7iXw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTcTJPC_ackG1AI9qLpybg6zkSKE6_3qDTlcQfMcec-hQ&oe=6AF74975"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Monkey Havoc Trailer Image.png", "id": "523796653745732", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974886_523796657079065_1178915653974772965_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LQ0zd0Z3Y7gQ7kNvwEIaDbD&_nc_oc=AdpnH5Gzxk-6BTWs8GbbylXPD57WAJ98DBqofQtGTIMfNV1OZfok567cEQ6itoeJTK4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSjNobwwZDR7ZkPNN_wHq4APFKPtZfC2m4cgMd0miaEpw&oe=6AF74BF3"}, "display_name": "Monkey Havoc", "keywords": ["Monkey", "Fan", "Game", "Gorilla", "Capuchin"], "long_description": "Welcome to Monkey Havoc, a game based off of the popular games 'Gorilla Tag' and 'Capuchin'. In Monkey Havoc you are able to freely move around many different maps with your friends, equip different styles of cosmetics, and compete in challenges to earn special cosmetics.\nThis game is constantly undergoing development and receiving updates to add more cosmetics, maps, and experiences.\nPlease let me know what to improve on by leaving a review and commenting on what could be better!\ud83d\ude0a\nContact Email: monkeyhavoccreator@gmail.com", "short_description": "Monkey Havoc is a 'Gorilla Tag' and 'Capuchin' fan game, made so that you and your friends can freely 
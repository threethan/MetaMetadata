9_1766831023204795275_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6uzTcDpV25kQ7kNvwE9_p_8&_nc_oc=AdqVO8PN-bI-w_B-aUqE1G2BtKn5C1UQarAXNzAwo1_ZWRPRITF7MhmqyOheihG8Pww&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af903v07ZRqiWiorUSMkTHYgwR-V_jr7jq2mZGKsIqOqZA&oe=6A22D816"}, {"file_name": "5.png", "id": "540438542039147", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/75395590_540438545372480_7329384731897725266_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wHtkPugO_zEQ7kNvwFrjPlE&_nc_oc=AdqArBNzBZMUVFjKNjSmKpsGeWyKq3ex8tYNyPhcL8n8EYJxcjg1niwOjEfyczJpz3g&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_iV7BGI3R8KqOLsDU5DS0MFA9prLbD_zrYYa4FmXjo_Q&oe=6A22CFB5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Monkey Havoc Trailer Image.png", "id": "523796653745732", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/38974886_523796657079065_1178915653974772965_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wONqnRFmx-wQ7kNvwGwVi51&_nc_oc=Adp_kwusq5681ep6lOP4eFaWJyvjomHMTPGIFO3DlFVNO8scIyE4d3yVMBD1VOzHIms&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9v34ffQ5GwVKGoWFs3KppDaYa-24K0dYrrpmrwMiOPsg&oe=6A22D233"}, "display_name": "Monkey Havoc", "keywords": ["Monkey", "Fan", "Game", "Gorilla", "Capuchin"], "long_description": "Welcome to Monkey Havoc, a game based off of the popular games 'Gorilla Tag' and 'Capuchin'. In Monkey Havoc you are able to freely move around many different maps with your friends, equip different styles of cosmetics, and compete in challenges to earn special cosmetics.\nThis game is constantly undergoing development and receiving updates to add more cosmetics, maps, and experiences.\nPlease let me know what to improve on by leaving a review and commenting on what could be better!\ud83d\ude0a\nContact Email: monkeyhavoccreator@gmail.com", "short_description": "Monkey Havoc is a 'Gorilla Tag' and 'Capuchin' fan game, made so that you and your
795275_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yTGHjz1flIoQ7kNvwEysQww&_nc_oc=AdpMWyH5XcXGv8xZA0LM0AgHf6Vq5r8avOJ5lgFyYtUV6UubuD6VHTnrWDCLjaEpZiY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB8EV1Q4iMo0oEYQwCxwVCe4PB2WSK2X4upodREMr8JEQ&oe=6A5E2B96"}, {"file_name": "5.png", "id": "540438542039147", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75395590_540438545372480_7329384731897725266_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-G-7BufGxiAQ7kNvwFfW45L&_nc_oc=AdqWN4FyD10yBXwNowQ-4g8vnY0A62RZG9efGDSq0jYNTT-iX62Jn9kTgrN-zV2vp5c&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBTWMaVI8kElxilRKsANh9dz-IDBpiPpLWR_sO-3tpdrw&oe=6A5E2335"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Monkey Havoc Trailer Image.png", "id": "523796653745732", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974886_523796657079065_1178915653974772965_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=InaxfhIm_eoQ7kNvwG5kvV3&_nc_oc=Ado9pu0sTVWWk7UkBIEQbApeKh6pj_rfKK3XHsfq_9LngDvdfFuJb-vPrnwd5ch36Xk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAQt6H5TbHMXJGVjfnm8NGNR7vmAD7vXbINzUZ5T7ImZQ&oe=6A5E25B3"}, "display_name": "Monkey Havoc", "keywords": ["Monkey", "Fan", "Game", "Gorilla", "Capuchin"], "long_description": "Welcome to Monkey Havoc, a game based off of the popular games 'Gorilla Tag' and 'Capuchin'. In Monkey Havoc you are able to freely move around many different maps with your friends, equip different styles of cosmetics, and compete in challenges to earn special cosmetics.\nThis game is constantly undergoing development and receiving updates to add more cosmetics, maps, and experiences.\nPlease let me know what to improve on by leaving a review and commenting on what could be better!\ud83d\ude0a\nContact Email: monkeyhavoccreator@gmail.com", "short_description": "Monkey Havoc is a 'Gorilla Tag' and 'Capuchin' fan game, made so that you and your friends can freely 
795275_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_Lve4snyw_IQ7kNvwES6Dbp&_nc_oc=AdplnxqGFVf4rPcCsJV5uSaZ7CUifiiaCmjjcMpwKyCLLY2DbICysIWAA6uvywyswMI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6W7n8hZSXE5lmSe9MT-6uCs2j8WFqebBz5moCoYMYG1w&oe=6A203516"}, {"file_name": "5.png", "id": "540438542039147", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75395590_540438545372480_7329384731897725266_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PTX54mZBCNIQ7kNvwFDrzDg&_nc_oc=AdoeOrmFZs4VxMrzdNO2k-HctSyL8wkRDOK6Ey-hw3UfiGnSSI6MRWdLz_R4OV8gink&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7SD4V_XNeAIewqpYZsTK4wJSF0yPOvZoSL22wEvmBi9g&oe=6A202CB5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Monkey Havoc Trailer Image.png", "id": "523796653745732", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974886_523796657079065_1178915653974772965_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Vj7jt8nUC80Q7kNvwHEd0dp&_nc_oc=Adq8PBeRu6QmqXjK4HrV74xrnXs13-fczgtUYa6onQ1y2p3yxqejj0kYL_doNOvThVc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af56h98iwzUR9Uqndcquzha3zQk0QW7hTqhw5SnZZM4g-w&oe=6A202F33"}, "display_name": "Monkey Havoc", "keywords": ["Monkey", "Fan", "Game", "Gorilla", "Capuchin"], "long_description": "Welcome to Monkey Havoc, a game based off of the popular games 'Gorilla Tag' and 'Capuchin'. In Monkey Havoc you are able to freely move around many different maps with your friends, equip different styles of cosmetics, and compete in challenges to earn special cosmetics.\nThis game is constantly undergoing development and receiving updates to add more cosmetics, maps, and experiences.\nPlease let me know what to improve on by leaving a review and commenting on what could be better!\ud83d\ude0a\nContact Email: monkeyhavoccreator@gmail.com", "short_description": "Monkey Havoc is a 'Gorilla Tag' and 'Capuchin' fan game, made so that you and your friends can freely 
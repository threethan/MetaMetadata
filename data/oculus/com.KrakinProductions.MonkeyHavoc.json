795275_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aqi0RuHgNSYQ7kNvwEsR8Lp&_nc_oc=AdpaS4CMlM9T4vnsJJ2LYHKNjaqIVLgfNwuxlp6NuzJXZ6CK4n17Tws1vSBq0nbKJYA&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKqw3q6M7ibEFkIiQQRt7wSG4lO22q9EXNGhSszn30eGw&oe=6A9AD096"}, {"file_name": "5.png", "id": "540438542039147", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75395590_540438545372480_7329384731897725266_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ug5oXZMgqEcQ7kNvwHd_D5k&_nc_oc=Adoim_W67YD7Q6hOeg9XX9rsmJeePY443P78s8d0feZVz9BHfVOz8Y4FpjmTcOutaSs&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJvEC6Cg-MgbByhjR_cvK_cJM3NYd6Ap0BxtQDjXG__Tw&oe=6A9AC835"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Monkey Havoc Trailer Image.png", "id": "523796653745732", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974886_523796657079065_1178915653974772965_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=X-6jl4xVe5wQ7kNvwErQ5LZ&_nc_oc=AdpnK3Nx6SOpOthpouOKWZpaII6fBbDU9yoAK1E75fpPf4D-0HBKrJKx6W8kxpijk_E&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIxR-bv45JjeqzJNjf8H41k3IN9yN_POWBordfgHw_Xlw&oe=6A9ACAB3"}, "display_name": "Monkey Havoc", "keywords": ["Monkey", "Fan", "Game", "Gorilla", "Capuchin"], "long_description": "Welcome to Monkey Havoc, a game based off of the popular games 'Gorilla Tag' and 'Capuchin'. In Monkey Havoc you are able to freely move around many different maps with your friends, equip different styles of cosmetics, and compete in challenges to earn special cosmetics.\nThis game is constantly undergoing development and receiving updates to add more cosmetics, maps, and experiences.\nPlease let me know what to improve on by leaving a review and commenting on what could be better!\ud83d\ude0a\nContact Email: monkeyhavoccreator@gmail.com", "short_description": "Monkey Havoc is a 'Gorilla Tag' and 'Capuchin' fan game, made so that you and your friends can freely 
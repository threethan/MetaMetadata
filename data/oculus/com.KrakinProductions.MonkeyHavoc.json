795275_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c7K1fuCC-QUQ7kNvwGXXuS6&_nc_oc=Adr8rDXfPMXDnBd8xKi8EeZymPHaApgbFD3pNsvMgeRPnxnFJ3dznBB6Jr4ZDyQgcPg&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOr-UNS61UIgwRl06lE1850agjqwbrh4HguF4eAVNOLDA&oe=6AD3B956"}, {"file_name": "5.png", "id": "540438542039147", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/75395590_540438545372480_7329384731897725266_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_-cg1iaiZpoQ7kNvwGRuqL9&_nc_oc=AdocU3vt5i5ZlqGoV-uM_tJG-FsHlv9BUqD9gqQfpCH11SfIs8e7Q47EuUOcwvKS1ok&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMxpR-NbctGwb5EVf77dvDa-cDRNYvMkxJMaMlVAurKDg&oe=6AD3B0F5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Monkey Havoc Trailer Image.png", "id": "523796653745732", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974886_523796657079065_1178915653974772965_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=St4Bveg6wREQ7kNvwGKkdaU&_nc_oc=AdpyzEFls0AYfZ65XmI2a-XhkLaBZxAqXOmxfzstbO_XA70miCD5AuMYpVRCVi5j6Oo&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP6nTBjcgbsvl0yMCE7aFY7rdAJw7OjypOCo83eWXjSfg&oe=6AD3B373"}, "display_name": "Monkey Havoc", "keywords": ["Monkey", "Fan", "Game", "Gorilla", "Capuchin"], "long_description": "Welcome to Monkey Havoc, a game based off of the popular games 'Gorilla Tag' and 'Capuchin'. In Monkey Havoc you are able to freely move around many different maps with your friends, equip different styles of cosmetics, and compete in challenges to earn special cosmetics.\nThis game is constantly undergoing development and receiving updates to add more cosmetics, maps, and experiences.\nPlease let me know what to improve on by leaving a review and commenting on what could be better!\ud83d\ude0a\nContact Email: monkeyhavoccreator@gmail.com", "short_description": "Monkey Havoc is a 'Gorilla Tag' and 'Capuchin' fan game, made so that you and your friends can freely 
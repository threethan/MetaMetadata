795275_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TmIs0bs5P-EQ7kNvwF0TIhl&_nc_oc=AdqO9yNgXACNsVzONJM7tT6JEqFZf9VP0PyU5d_Kjvbht9UzSuza32CNIQQrFsUmB-8&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwStpVgeEkDJpeTavBnuw3St7NJ7V6VZ5gJNpwu3HZc4Q&oe=69CBD516"}, {"file_name": "5.png", "id": "540438542039147", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75395590_540438545372480_7329384731897725266_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jL4h1-vU76IQ7kNvwHvVAJp&_nc_oc=AdpglBHIOGftLqwRdh7STZHN3NOXdFlr7NBMtObXOoH6i689omYnf-wm1olXvTWY88c&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzwkyXXYw5tWG8KkwQRjiFusFOSjXTOUTtR5u8bMUrIZw&oe=69CBCCB5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Monkey Havoc Trailer Image.png", "id": "523796653745732", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974886_523796657079065_1178915653974772965_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9m0nBhXaFssQ7kNvwFkupXy&_nc_oc=AdpO4AIznbBEZ4wmtLVQGbUVFiLyF7vpSSJ4XK8piG38V5yh55nDvLkRsFjNzNF1dNw&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyyLcUUfAaQ5sIrgHDaqzmMXvWEP1GVC4G_XsKpPIeIrg&oe=69CBCF33"}, "display_name": "Monkey Havoc", "keywords": ["Monkey", "Fan", "Game", "Gorilla", "Capuchin"], "long_description": "Welcome to Monkey Havoc, a game based off of the popular games 'Gorilla Tag' and 'Capuchin'. In Monkey Havoc you are able to freely move around many different maps with your friends, equip different styles of cosmetics, and compete in challenges to earn special cosmetics.\nThis game is constantly undergoing development and receiving updates to add more cosmetics, maps, and experiences.\nPlease let me know what to improve on by leaving a review and commenting on what could be better!\ud83d\ude0a\nContact Email: monkeyhavoccreator@gmail.com", "short_description": "Monkey Havoc is a 'Gorilla Tag' and 'Capuchin' fan game, made so that you and your friends can freely 
795275_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=90GTs2lEfdUQ7kNvwH20OEy&_nc_oc=Adollf_N4002PBXPoT_IzDeM1jj9YIFHHT5Ttsc21wFsW3tPTf708LN0zKg6Ft_8UsM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKteuct1VDX-ocERlAh7hRiSauS6dSwTv0w9WKNHwbfEw&oe=6AA7FF96"}, {"file_name": "5.png", "id": "540438542039147", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75395590_540438545372480_7329384731897725266_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o63r_XnnxaMQ7kNvwEdFIs3&_nc_oc=AdqNdCE25rmC_orBnjWUG4UAOmsGk5QeEoLKCjqa09P33FKZlYgCbe8jvaqry2XU9gI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLtVKKI8BjnrIgdMJvRwQIEuRym-pZNEXidtrc1X7J8Mg&oe=6AA7F735"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Monkey Havoc Trailer Image.png", "id": "523796653745732", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974886_523796657079065_1178915653974772965_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P9_IQS98kYMQ7kNvwFeV_al&_nc_oc=Adrv6b7OQpkcEbpQTdPxkhh-K3mL8UyYfZq49jwLRUMdh8-cSBraiug6m25QESi7TOk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIuXcmnShwR9nbM_RmqaF8wPyh9YkCNop2YPxh32STOdA&oe=6AA7F9B3"}, "display_name": "Monkey Havoc", "keywords": ["Monkey", "Fan", "Game", "Gorilla", "Capuchin"], "long_description": "Welcome to Monkey Havoc, a game based off of the popular games 'Gorilla Tag' and 'Capuchin'. In Monkey Havoc you are able to freely move around many different maps with your friends, equip different styles of cosmetics, and compete in challenges to earn special cosmetics.\nThis game is constantly undergoing development and receiving updates to add more cosmetics, maps, and experiences.\nPlease let me know what to improve on by leaving a review and commenting on what could be better!\ud83d\ude0a\nContact Email: monkeyhavoccreator@gmail.com", "short_description": "Monkey Havoc is a 'Gorilla Tag' and 'Capuchin' fan game, made so that you and your friends can freely 
9_1766831023204795275_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Men1bulAKQQQ7kNvwE_yKIY&_nc_oc=Adqj2zB44RsW6efNj4XsFHQ-0S3z5nabyPQ92XCt4ynCahdw4TUtpq05NkrN6EolfLw&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8aofTciBREP8CTQrHhkpFIDM61if-LxdG76I1DugXl2Q&oe=6A467096"}, {"file_name": "5.png", "id": "540438542039147", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/75395590_540438545372480_7329384731897725266_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5GfN53XzKVIQ7kNvwGVp7aK&_nc_oc=AdpJC1s8DoMGdxpB5bzi4upND2QiI2Wt3TQ02o8RPzqCsMf3EIug8rVFlMxggq7Y76U&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_xuKuq7MDsSYcyushlCSoQWWS2l2MxYzqBHzZ70IQ7Uw&oe=6A466835"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Monkey Havoc Trailer Image.png", "id": "523796653745732", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/38974886_523796657079065_1178915653974772965_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bVTQmsy2evIQ7kNvwFypkz9&_nc_oc=AdqZisbJbmtsotCEW45a52i2Ue_7D9eqCvq_R0NLi4j3fgua83KPQfy5bi_CTt1E8Lg&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8pRueMQgNQa1-WzONy94foApn7BmbzdO2mS0yEGaaqWg&oe=6A466AB3"}, "display_name": "Monkey Havoc", "keywords": ["Monkey", "Fan", "Game", "Gorilla", "Capuchin"], "long_description": "Welcome to Monkey Havoc, a game based off of the popular games 'Gorilla Tag' and 'Capuchin'. In Monkey Havoc you are able to freely move around many different maps with your friends, equip different styles of cosmetics, and compete in challenges to earn special cosmetics.\nThis game is constantly undergoing development and receiving updates to add more cosmetics, maps, and experiences.\nPlease let me know what to improve on by leaving a review and commenting on what could be better!\ud83d\ude0a\nContact Email: monkeyhavoccreator@gmail.com", "short_description": "Monkey Havoc is a 'Gorilla Tag' and 'Capuchin' fan game, made so that you and your
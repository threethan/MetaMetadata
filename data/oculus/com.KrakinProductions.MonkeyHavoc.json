795275_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LWId-3xhEw0Q7kNvwHoQkCd&_nc_oc=AdqycplI8mTVlcdoR1T86OloreJSCG0YNQDJ8EVzw--WOLB64jo51ebSHfS70MLkASY&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af83e9DrV6gHTC43go8FQEzpJsqTQB2_AF2sUNeQr62D_g&oe=6A32AA16"}, {"file_name": "5.png", "id": "540438542039147", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/75395590_540438545372480_7329384731897725266_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oVnPakNUpX0Q7kNvwGa0-Yy&_nc_oc=Adq0VHLFmvK4Q0DCU4wJVrAKr9Xzkc_31KVLfD0KdvbMmNcifvDI4Ez7BPNuyf2l5Wc&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_xQ9_m1atYaUgPuLsc0xmYC2Ee5UUkg0h4ff0-RAzKlw&oe=6A32A1B5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Monkey Havoc Trailer Image.png", "id": "523796653745732", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38974886_523796657079065_1178915653974772965_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FnvXjjgHBxQQ7kNvwHkniR6&_nc_oc=Adr0IKgLRoFdOBfhAFUcHlPyy_62ELdQi-OGZv0FRRkgpYU9DG_RroNosMgfNYgr0lU&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_ZmTrYdm_OSpShKI8XMJVRuIZI82ZtaVXR0cp1cnIdLg&oe=6A32A433"}, "display_name": "Monkey Havoc", "keywords": ["Monkey", "Fan", "Game", "Gorilla", "Capuchin"], "long_description": "Welcome to Monkey Havoc, a game based off of the popular games 'Gorilla Tag' and 'Capuchin'. In Monkey Havoc you are able to freely move around many different maps with your friends, equip different styles of cosmetics, and compete in challenges to earn special cosmetics.\nThis game is constantly undergoing development and receiving updates to add more cosmetics, maps, and experiences.\nPlease let me know what to improve on by leaving a review and commenting on what could be better!\ud83d\ude0a\nContact Email: monkeyhavoccreator@gmail.com", "short_description": "Monkey Havoc is a 'Gorilla Tag' and 'Capuchin' fan game, made so that you and your friends can freely 
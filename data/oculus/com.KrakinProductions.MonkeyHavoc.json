795275_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5xtlX6Dru6YQ7kNvwH2vpgo&_nc_oc=AdqjXGoAqM1faFzvnCFdlfZQFme7h1ipVLwbilFQFKNM69za9r21VpJkHaFn3xp_W6Y&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2COpiOlm1FCCGS3EhelU2EVrRbBW7Vnofk8b0SxT9owA&oe=69E78496"}, {"file_name": "5.png", "id": "540438542039147", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/75395590_540438545372480_7329384731897725266_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Zy-2WZWR3fsQ7kNvwHk9MCe&_nc_oc=AdoWcbOngJUXRXZHEJP390fG6puQVAgQRZY0dcGjCh02Frn4Dwp5vO9YT4ITDI0ZKi4&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af38PmhDUp4YuKGzJUGnUc0gNJif9iYko9e1yjPHiD_BIA&oe=69E77C35"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Monkey Havoc Trailer Image.png", "id": "523796653745732", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38974886_523796657079065_1178915653974772965_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3FMY-Yn_8SoQ7kNvwFrSWDO&_nc_oc=Adre1AWhjpn97tLTL9Q-rJP9WzuK8RwJA1dOHs_O8WzNrrRG-OqwJMT2wGTqsZKnGUU&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1K730Q1uo3tcmRqdkFdQeWM4ZBiNaIZzxVwOvYp_UPEg&oe=69E77EB3"}, "display_name": "Monkey Havoc", "keywords": ["Monkey", "Fan", "Game", "Gorilla", "Capuchin"], "long_description": "Welcome to Monkey Havoc, a game based off of the popular games 'Gorilla Tag' and 'Capuchin'. In Monkey Havoc you are able to freely move around many different maps with your friends, equip different styles of cosmetics, and compete in challenges to earn special cosmetics.\nThis game is constantly undergoing development and receiving updates to add more cosmetics, maps, and experiences.\nPlease let me know what to improve on by leaving a review and commenting on what could be better!\ud83d\ude0a\nContact Email: monkeyhavoccreator@gmail.com", "short_description": "Monkey Havoc is a 'Gorilla Tag' and 'Capuchin' fan game, made so that you and your friends can freely 
795275_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cslG3jBj_0YQ7kNvwEfrvMk&_nc_oc=Adr0eTDYLgcgY2dChUrgqIZoVv0cRB_7usZkXS1C-mmO90nsR4_LRJ6iaZ3MDCp18Ao&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQId-FDjWL8nGp0du8dYVMxdiOBTzAHnLqU09weh9zODdw&oe=6AA2B996"}, {"file_name": "5.png", "id": "540438542039147", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75395590_540438545372480_7329384731897725266_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o9Ep2mpkrtQQ7kNvwHFXMCO&_nc_oc=AdrxLeo6Dqy69HUOLxRVmIDbA_rSx0vSo70h6-3JYuG7Agrm66jKyl3Ciof6QKlbFCY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ8U3EwyS0vwj2LRsRXoaz6fGo7bFJ1w7rJjfl9W7aCwA&oe=6AA2B135"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Monkey Havoc Trailer Image.png", "id": "523796653745732", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974886_523796657079065_1178915653974772965_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hcl4Q-WxyG0Q7kNvwHsR3xd&_nc_oc=AdqjL-3T08EzOlEOc18fwkViKJ9vFpbhAvVuKWzOO0Y2cg1a_5Gpbq_9fJtgb_hT1y0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLbYjngCgyw9_okMkd68ePyjrT9RKWAjuIPSk9FJBr5ug&oe=6AA2B3B3"}, "display_name": "Monkey Havoc", "keywords": ["Monkey", "Fan", "Game", "Gorilla", "Capuchin"], "long_description": "Welcome to Monkey Havoc, a game based off of the popular games 'Gorilla Tag' and 'Capuchin'. In Monkey Havoc you are able to freely move around many different maps with your friends, equip different styles of cosmetics, and compete in challenges to earn special cosmetics.\nThis game is constantly undergoing development and receiving updates to add more cosmetics, maps, and experiences.\nPlease let me know what to improve on by leaving a review and commenting on what could be better!\ud83d\ude0a\nContact Email: monkeyhavoccreator@gmail.com", "short_description": "Monkey Havoc is a 'Gorilla Tag' and 'Capuchin' fan game, made so that you and your friends can freely 
795275_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RaPMvjl8sDkQ7kNvwHGJmIt&_nc_oc=AdpiEDbln4H8Gxw2cPyI_WS-0w0HgctWmUzE5qu7iNsB04HQb6Jdo3SMIuc6EJMBhs4&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHJkVTtAPIZpUkmOp7l2KTo7plPpPS474pIurgkaLlDOA&oe=6A9400D6"}, {"file_name": "5.png", "id": "540438542039147", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/75395590_540438545372480_7329384731897725266_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hsu6PqI7SroQ7kNvwEGrjCH&_nc_oc=Adrgt3bbdkoCrVxMSfkNgQWCHZl5PpSCaZEP14SEtgQq1q8Q7tCDFGqWhG1tg1ngOv4&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGRsk2I75W1AnFYAuz6BLAxdZPgcBMxCInTdlPMmC_SpQ&oe=6A9430B5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Monkey Havoc Trailer Image.png", "id": "523796653745732", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/38974886_523796657079065_1178915653974772965_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ii-FDQNdi_AQ7kNvwG0sBi5&_nc_oc=AdrRUbaX1UvGD7JxVjuz-30sdsLbScEhomBZc6lP29fyL7KOVn8sV04rTRer6jDE4bk&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHuS2b6txRyEwu03bUavC2f_Wh8h5kWo1MD_5D988G9QQ&oe=6A943333"}, "display_name": "Monkey Havoc", "keywords": ["Monkey", "Fan", "Game", "Gorilla", "Capuchin"], "long_description": "Welcome to Monkey Havoc, a game based off of the popular games 'Gorilla Tag' and 'Capuchin'. In Monkey Havoc you are able to freely move around many different maps with your friends, equip different styles of cosmetics, and compete in challenges to earn special cosmetics.\nThis game is constantly undergoing development and receiving updates to add more cosmetics, maps, and experiences.\nPlease let me know what to improve on by leaving a review and commenting on what could be better!\ud83d\ude0a\nContact Email: monkeyhavoccreator@gmail.com", "short_description": "Monkey Havoc is a 'Gorilla Tag' and 'Capuchin' fan game, made so that you and your friends can freely 
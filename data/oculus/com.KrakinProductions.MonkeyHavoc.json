1129_1766831023204795275_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z6lQvrGvIlcQ7kNvwGHuH8j&_nc_oc=Ado3a6Y362tqt48luWMp0p3-SUXgKuHEQI03HpmOavfEh6WgDIGgiiqr36oIpwVzVXQ&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHwTAT5ywbHmdl1cndXBBE5O137SalriHSrSmsdRhlp6w&oe=6A8EBAD6"}, {"file_name": "5.png", "id": "540438542039147", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/75395590_540438545372480_7329384731897725266_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tikv2SNHMHQQ7kNvwGVlEXE&_nc_oc=Adri2Kk_RKYRRKF8omEZePs0Rt3VIlcam05lKeidrhrj6AtwFBLuf4x8BTFg9rgBqtE&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEwMzQQv__yu-YUaRvhCcuOC_0m0faP7UeC_9Z12nW4jQ&oe=6A8EEAB5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Monkey Havoc Trailer Image.png", "id": "523796653745732", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/38974886_523796657079065_1178915653974772965_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AtKNDvR302EQ7kNvwG98JR_&_nc_oc=Adq7ZetgHj6UFIaS4oLh-x6NtLAqUS3dfyEevktdDuEl5eBLE5-XjPKDGVjTzJIDjec&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQECyRmAYYvpqejLhMt7VZBpLTQ5RNbPOj00XYHOTbO_kQ&oe=6A8EED33"}, "display_name": "Monkey Havoc", "keywords": ["Monkey", "Fan", "Game", "Gorilla", "Capuchin"], "long_description": "Welcome to Monkey Havoc, a game based off of the popular games 'Gorilla Tag' and 'Capuchin'. In Monkey Havoc you are able to freely move around many different maps with your friends, equip different styles of cosmetics, and compete in challenges to earn special cosmetics.\nThis game is constantly undergoing development and receiving updates to add more cosmetics, maps, and experiences.\nPlease let me know what to improve on by leaving a review and commenting on what could be better!\ud83d\ude0a\nContact Email: monkeyhavoccreator@gmail.com", "short_description": "Monkey Havoc is a 'Gorilla Tag' and 'Capuchin' fan game, made so that you and yo
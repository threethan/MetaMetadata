795275_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VXvkjx49vX0Q7kNvwHedFZ-&_nc_oc=AdqbXC_CKSV8VNOHwpYz5WdKEMC_wGnsjLr79FL4tjMpr2nQQpLj0cxmBXeTOm0p23I&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRGG0TSZIVWS6uPTEf_EMS_xopzMhQmCJypFMRi3bylCA&oe=6AF1D396"}, {"file_name": "5.png", "id": "540438542039147", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75395590_540438545372480_7329384731897725266_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mDWCynZXtLQQ7kNvwHakLRw&_nc_oc=AdpoL14oYhAg-jFbElso4A5_ruf4hOsDv8p4hHyB2eWq8-x0D2uxdeOnocbi_bFT520&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRwMZqzkUHAv9j6l8gCXujVqBb4Ti0J_Vp56WRZEacoGA&oe=6AF20375"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Monkey Havoc Trailer Image.png", "id": "523796653745732", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974886_523796657079065_1178915653974772965_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ook4yIhIYNMQ7kNvwEp3RJ1&_nc_oc=AdrWjvLf5f8LlZQshU2HYgMBrGZ88V0dIzo_1iaJgkiRzbohwERx9UZliNdSeyv6JFY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQc4SeDZ4IfQYk4ssoVF5g3uTFm-flvHDJTpjega-Gbxg&oe=6AF205F3"}, "display_name": "Monkey Havoc", "keywords": ["Monkey", "Fan", "Game", "Gorilla", "Capuchin"], "long_description": "Welcome to Monkey Havoc, a game based off of the popular games 'Gorilla Tag' and 'Capuchin'. In Monkey Havoc you are able to freely move around many different maps with your friends, equip different styles of cosmetics, and compete in challenges to earn special cosmetics.\nThis game is constantly undergoing development and receiving updates to add more cosmetics, maps, and experiences.\nPlease let me know what to improve on by leaving a review and commenting on what could be better!\ud83d\ude0a\nContact Email: monkeyhavoccreator@gmail.com", "short_description": "Monkey Havoc is a 'Gorilla Tag' and 'Capuchin' fan game, made so that you and your friends can freely 
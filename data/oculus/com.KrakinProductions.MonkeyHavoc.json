795275_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sZgHOfWCtiQQ7kNvwGP0beM&_nc_oc=AdqD8XNtqudBujl_hti2Xorq6r0NhjoqVi6TAGAvumvHpuKGksH-6bVsc4YwyrfUWeI&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGei6KocFwAN8v2Vmkw_FAqtsg7cEqRxW9vJyToyjVaGg&oe=6A81C416"}, {"file_name": "5.png", "id": "540438542039147", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/75395590_540438545372480_7329384731897725266_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rFQmAJrbCRMQ7kNvwEA_gKg&_nc_oc=AdrtCR8aiTeCeo5Cil3CCXeQh532Q7aMhhGdQ6CxEIbiPfiFvGgYpwL7cnSvekYsWN8&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH2TaLHbADBYitjGCDAEZQ70SW5hwda5MzMxbWuqyUiVg&oe=6A81BBB5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Monkey Havoc Trailer Image.png", "id": "523796653745732", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38974886_523796657079065_1178915653974772965_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v3adgAil0I8Q7kNvwGlGA2m&_nc_oc=Adpi7JRfLV-AndrHlFyraFK8GtIGorbm5I6YkL22NfERi02VFFmnBsv12Rg5E-iw1lk&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGG9ZB57m7SOSXf3id5fT1IBlxNaE1rDtWmp4CY5MXnoQ&oe=6A81BE33"}, "display_name": "Monkey Havoc", "keywords": ["Monkey", "Fan", "Game", "Gorilla", "Capuchin"], "long_description": "Welcome to Monkey Havoc, a game based off of the popular games 'Gorilla Tag' and 'Capuchin'. In Monkey Havoc you are able to freely move around many different maps with your friends, equip different styles of cosmetics, and compete in challenges to earn special cosmetics.\nThis game is constantly undergoing development and receiving updates to add more cosmetics, maps, and experiences.\nPlease let me know what to improve on by leaving a review and commenting on what could be better!\ud83d\ude0a\nContact Email: monkeyhavoccreator@gmail.com", "short_description": "Monkey Havoc is a 'Gorilla Tag' and 'Capuchin' fan game, made so that you and your friends can freely 
795275_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RaPMvjl8sDkQ7kNvwFXX-_q&_nc_oc=Adp_XSjklJqh_Z-_Qyf92IewOdRb_eYNg_HsVZpAVH3wQol1tQ0uRDbw_Z9tH4yYZV8&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGr6sHmj-7rU7zIhMTEh14VJq3BAWBe4Ka030CS-Get_w&oe=6A974C96"}, {"file_name": "5.png", "id": "540438542039147", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/75395590_540438545372480_7329384731897725266_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hElk_4roPtsQ7kNvwHwBCeu&_nc_oc=AdrNuqzzbsZLFkig6eXP5_iYtwYcYFjNv6VUDUzRTOnDHTqfWgKLPLZ_FFc-C_N4aog&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFMatxNAPWLw5ntFRRjrGx90Nm-5ScFv9Z8HQSbBllr5Q&oe=6A974435"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Monkey Havoc Trailer Image.png", "id": "523796653745732", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/38974886_523796657079065_1178915653974772965_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I6j12cpf-IkQ7kNvwHBQ-9H&_nc_oc=AdoFti5GdE9DMFMGasYMwnU1P061Z127mfmCjZe1Xob8LzkHb_l6W_-ZHQ10eo2J38I&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE1IFphjXMHG-rdr8Fu0BhgXomgBPp3_wmtv0mil6_3qg&oe=6A9746B3"}, "display_name": "Monkey Havoc", "keywords": ["Monkey", "Fan", "Game", "Gorilla", "Capuchin"], "long_description": "Welcome to Monkey Havoc, a game based off of the popular games 'Gorilla Tag' and 'Capuchin'. In Monkey Havoc you are able to freely move around many different maps with your friends, equip different styles of cosmetics, and compete in challenges to earn special cosmetics.\nThis game is constantly undergoing development and receiving updates to add more cosmetics, maps, and experiences.\nPlease let me know what to improve on by leaving a review and commenting on what could be better!\ud83d\ude0a\nContact Email: monkeyhavoccreator@gmail.com", "short_description": "Monkey Havoc is a 'Gorilla Tag' and 'Capuchin' fan game, made so that you and your friends can freely 
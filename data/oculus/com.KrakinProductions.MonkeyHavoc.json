795275_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9_aXE0MOBS8Q7kNvwF0v7cf&_nc_oc=AdrF4krRuDi6VqcLx6-eVwVtGg1Okj4NpEniJNgWeLB-ZEyWB8Y5ZGOIpwbMvAqGe_Q&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM5iU0QDlxy_fdZ4s5rUFzNXfqC9y6dURedBao1XPOtwg&oe=6ACCE996"}, {"file_name": "5.png", "id": "540438542039147", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75395590_540438545372480_7329384731897725266_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NZI-vjC5BkgQ7kNvwFZPCu_&_nc_oc=AdrP6o3nL-EObghsDPk-bZiMq5QHqLRkaAXko-LvqAGajoWdoNGvIIACPF1Dy68DR2Y&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMjd__FqJEiwmr3NzM7nhBZIdblwVO4uB2m_2YgzDtpfA&oe=6ACCE135"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Monkey Havoc Trailer Image.png", "id": "523796653745732", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974886_523796657079065_1178915653974772965_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7z_XYrJw4WwQ7kNvwFwduM6&_nc_oc=Ado1O4fI68aT8db0-foWouVkJBMwbQrD1ZG7utINAULkcQTdp2dPDcU9qSl7Rjzx97I&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNSI6j0QaiYQ_6ehTdaqORosOVAsOXpL0e3JXXwIL7zzA&oe=6ACCE3B3"}, "display_name": "Monkey Havoc", "keywords": ["Monkey", "Fan", "Game", "Gorilla", "Capuchin"], "long_description": "Welcome to Monkey Havoc, a game based off of the popular games 'Gorilla Tag' and 'Capuchin'. In Monkey Havoc you are able to freely move around many different maps with your friends, equip different styles of cosmetics, and compete in challenges to earn special cosmetics.\nThis game is constantly undergoing development and receiving updates to add more cosmetics, maps, and experiences.\nPlease let me know what to improve on by leaving a review and commenting on what could be better!\ud83d\ude0a\nContact Email: monkeyhavoccreator@gmail.com", "short_description": "Monkey Havoc is a 'Gorilla Tag' and 'Capuchin' fan game, made so that you and your friends can freely 
795275_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3Zr73UEnFn8Q7kNvwF3KNJP&_nc_oc=AdoeS6_ohg_Kag8vxJu9FOWoU6Rk74qEH6kMElfklv4EwJBlVJCyoU8-o2JMUKMKBNA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGwnfL9Br5kkXGOgvgq9VjGK9zo6SBesEcTUx8Dw4yBYQ&oe=6A749516"}, {"file_name": "5.png", "id": "540438542039147", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75395590_540438545372480_7329384731897725266_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qebDuilGjL8Q7kNvwFXCdoo&_nc_oc=AdpbIrhEYbmDRpJ88B1PptktoC1rHnqVJrLYQmSahYf1Blu4W0-oaXHWACes1M5UwI0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEVTphfcg8Hi2SRAABKKtEVN9GFDu_Uv8JPaQI63r8LTQ&oe=6A748CB5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Monkey Havoc Trailer Image.png", "id": "523796653745732", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974886_523796657079065_1178915653974772965_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ovldoah5ZfMQ7kNvwF_ZitH&_nc_oc=Adqe9Ez6dDiUdT1G2lAyzahe0zMM7f35BSIUD4-JrM2WhupQx1thZdkGuOahU58mCNg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFnVAi7aUK29x-n7e-LIcEog9YIikOPEwChFt5NSziGJg&oe=6A748F33"}, "display_name": "Monkey Havoc", "keywords": ["Monkey", "Fan", "Game", "Gorilla", "Capuchin"], "long_description": "Welcome to Monkey Havoc, a game based off of the popular games 'Gorilla Tag' and 'Capuchin'. In Monkey Havoc you are able to freely move around many different maps with your friends, equip different styles of cosmetics, and compete in challenges to earn special cosmetics.\nThis game is constantly undergoing development and receiving updates to add more cosmetics, maps, and experiences.\nPlease let me know what to improve on by leaving a review and commenting on what could be better!\ud83d\ude0a\nContact Email: monkeyhavoccreator@gmail.com", "short_description": "Monkey Havoc is a 'Gorilla Tag' and 'Capuchin' fan game, made so that you and your friends can freely 
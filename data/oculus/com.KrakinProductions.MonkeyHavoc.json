795275_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nJTqVVe8QBIQ7kNvwG0YZZP&_nc_oc=AdoFyrE1ArCli4NVPSQIhiTpHibSne0eSjYEAnwGXmi14iFJRrdpLxgH8WZDTT5RBX8&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF0Z-xLySnnbDTEQSMVD9qvYfSMh3T5sJ7pRMVaELe5Mg&oe=6A71F216"}, {"file_name": "5.png", "id": "540438542039147", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75395590_540438545372480_7329384731897725266_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qebDuilGjL8Q7kNvwFEXvde&_nc_oc=AdrRRSGlGTkjJ9Oe_Dk7isHJg-cKMi8eN_zN8Kb62cfkcED_XZCvmb8THtI1jwrqZ_E&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFUVKesjfQYu2XnjwW49ikKrG9EbUvZD3EIeA7BKi-EfQ&oe=6A71E9B5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Monkey Havoc Trailer Image.png", "id": "523796653745732", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974886_523796657079065_1178915653974772965_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ovldoah5ZfMQ7kNvwECH_ly&_nc_oc=AdpfseSMavvkKfZ7-3nnO4xB11gMIXcKcl0FbC-Byo7Ny0o5waor40seCGtIaGfBOeQ&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGB9Z4qnCy2XLOzcqVFJ4VzCU5fDADe_dIXeurWFq3Cqw&oe=6A71EC33"}, "display_name": "Monkey Havoc", "keywords": ["Monkey", "Fan", "Game", "Gorilla", "Capuchin"], "long_description": "Welcome to Monkey Havoc, a game based off of the popular games 'Gorilla Tag' and 'Capuchin'. In Monkey Havoc you are able to freely move around many different maps with your friends, equip different styles of cosmetics, and compete in challenges to earn special cosmetics.\nThis game is constantly undergoing development and receiving updates to add more cosmetics, maps, and experiences.\nPlease let me know what to improve on by leaving a review and commenting on what could be better!\ud83d\ude0a\nContact Email: monkeyhavoccreator@gmail.com", "short_description": "Monkey Havoc is a 'Gorilla Tag' and 'Capuchin' fan game, made so that you and your friends can freely 
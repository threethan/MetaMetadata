795275_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-_gcK3b0KicQ7kNvwEdrH1g&_nc_oc=AdpJlQuTtwA_Kre6lhGhcYeMiGg0brRoSBsLSfx5143Nkpj2Q3snfZGG7Ea21mYO2HU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC18XPswDqsh0cFkd_ZWhb01SoV4P_kHBwkb8ikJVCuAg&oe=6A676616"}, {"file_name": "5.png", "id": "540438542039147", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75395590_540438545372480_7329384731897725266_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ppnjbfGfbgkQ7kNvwEhCZRY&_nc_oc=AdqCmU5SBNfXxZHALZ6kdTSUuiKtmOx51zJToB9He0wvUDKkw-lasz3ILetzdMn4Cb8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDf1sLL1mVFrLVAkW7CK-ivIS8F9GU3yrc12Ii4TQo1Gw&oe=6A675DB5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Monkey Havoc Trailer Image.png", "id": "523796653745732", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974886_523796657079065_1178915653974772965_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zXk_LMlerNgQ7kNvwG2j-Mw&_nc_oc=AdryIgxGrkoryyZid1cc2k70ZQMMXRWUBEcNJPq7bmh5TIPNIZbpMX9nwq00C0vG8SI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDk4DDyGq4JlT6-olSJccLDxfsbM5u9OYpEX08swF9ftA&oe=6A676033"}, "display_name": "Monkey Havoc", "keywords": ["Monkey", "Fan", "Game", "Gorilla", "Capuchin"], "long_description": "Welcome to Monkey Havoc, a game based off of the popular games 'Gorilla Tag' and 'Capuchin'. In Monkey Havoc you are able to freely move around many different maps with your friends, equip different styles of cosmetics, and compete in challenges to earn special cosmetics.\nThis game is constantly undergoing development and receiving updates to add more cosmetics, maps, and experiences.\nPlease let me know what to improve on by leaving a review and commenting on what could be better!\ud83d\ude0a\nContact Email: monkeyhavoccreator@gmail.com", "short_description": "Monkey Havoc is a 'Gorilla Tag' and 'Capuchin' fan game, made so that you and your friends can freely 
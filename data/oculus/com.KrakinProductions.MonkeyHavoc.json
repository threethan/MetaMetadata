795275_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CEwuykXC-gcQ7kNvwGJkQId&_nc_oc=AdpTunY2R7mZFl930EEOtpbwJg0BdHKAdOK_nl2KNiWqJemAPhWXLi88vxXYOlxx7Os&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCHEY2MhYWI11a7Azp514TvSP0EXm57F-pQhRshlphvJw&oe=6A4BB696"}, {"file_name": "5.png", "id": "540438542039147", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75395590_540438545372480_7329384731897725266_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xNXAF-ukctwQ7kNvwHhBLG4&_nc_oc=AdqhZthuljKEsOTGCcJrKNcFFwRih8DjihFpOonszefMn44u7BnOQrF_nCw1CxmaLQQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAqGd9HYqh9lA9QrNennMjJLCD3P-nJQsabxQbDCh2ARw&oe=6A4BAE35"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Monkey Havoc Trailer Image.png", "id": "523796653745732", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974886_523796657079065_1178915653974772965_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YlMFR34swfYQ7kNvwGLkDAA&_nc_oc=AdrNPJB7i-aZ1uhq5-Clg9nWUsZDsr14z6FFBdCQM4_e_oMlFzm7HdeBCTq9_QN1hl0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAaem0uc_3QFMdL3o8KDzpXXxxhuYKgYEtuRId5oTgGzw&oe=6A4BB0B3"}, "display_name": "Monkey Havoc", "keywords": ["Monkey", "Fan", "Game", "Gorilla", "Capuchin"], "long_description": "Welcome to Monkey Havoc, a game based off of the popular games 'Gorilla Tag' and 'Capuchin'. In Monkey Havoc you are able to freely move around many different maps with your friends, equip different styles of cosmetics, and compete in challenges to earn special cosmetics.\nThis game is constantly undergoing development and receiving updates to add more cosmetics, maps, and experiences.\nPlease let me know what to improve on by leaving a review and commenting on what could be better!\ud83d\ude0a\nContact Email: monkeyhavoccreator@gmail.com", "short_description": "Monkey Havoc is a 'Gorilla Tag' and 'Capuchin' fan game, made so that you and your friends can freely 
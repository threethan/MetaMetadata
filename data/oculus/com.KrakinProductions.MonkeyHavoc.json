795275_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-_gcK3b0KicQ7kNvwELoY7T&_nc_oc=AdoflKSKuO14qWckC84yw4sbtJK2GvIuOSXVOTBp2O-RUCBwUqGdW3VLEeUU4chqwPk&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBpfWw3hHRf0qJVEtWBbFW3DE6XOLKC2B8oS2eBJ0qNLQ&oe=6A661496"}, {"file_name": "5.png", "id": "540438542039147", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/75395590_540438545372480_7329384731897725266_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ppnjbfGfbgkQ7kNvwEJgOTt&_nc_oc=AdqzQj0gOEeKJlfflrvXb70Zq23RRNknXSxmL1VArN6bX3Jb2IhyZcoeZu2aULBtiTQ&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAahMH-iqkB6xnN_5jpxxn9XbhlWTRuV3YMJGiw-YlWDg&oe=6A660C35"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Monkey Havoc Trailer Image.png", "id": "523796653745732", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974886_523796657079065_1178915653974772965_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zXk_LMlerNgQ7kNvwEcHe8O&_nc_oc=AdpNKUaTxagD_iZy9E3eB4f8tfCbYvTuuV9Yh2T2-hgSDE6IDowDQu7PHkqG8lyFUzY&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDWdR3hwW3Spj9h_Op5qHdw9lC2dOZkabAvjmUrsJxLVw&oe=6A660EB3"}, "display_name": "Monkey Havoc", "keywords": ["Monkey", "Fan", "Game", "Gorilla", "Capuchin"], "long_description": "Welcome to Monkey Havoc, a game based off of the popular games 'Gorilla Tag' and 'Capuchin'. In Monkey Havoc you are able to freely move around many different maps with your friends, equip different styles of cosmetics, and compete in challenges to earn special cosmetics.\nThis game is constantly undergoing development and receiving updates to add more cosmetics, maps, and experiences.\nPlease let me know what to improve on by leaving a review and commenting on what could be better!\ud83d\ude0a\nContact Email: monkeyhavoccreator@gmail.com", "short_description": "Monkey Havoc is a 'Gorilla Tag' and 'Capuchin' fan game, made so that you and your friends can freely 
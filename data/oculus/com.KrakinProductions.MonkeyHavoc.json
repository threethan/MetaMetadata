795275_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=43AF955MetcQ7kNvwG12ohU&_nc_oc=AdpDfkxDfbVe3vCUEhQYZXFohIdMd6NkytxPqGMT1DT3SudQtsn2C2-V_AI5Sl0L-6Q&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6JUZoJbOl9muEl9Bxh-qOOwNhI54AzgJcnwh_GAtN0EQ&oe=6A1AEF16"}, {"file_name": "5.png", "id": "540438542039147", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/75395590_540438545372480_7329384731897725266_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k1Lqa9byczIQ7kNvwFGXAkj&_nc_oc=AdrpNLQg1uGsvnC69FrGS3RpsMHLHKu_gbejHvSAsIs9VwhcH3YabXRgZfk5zrJ3YEQ&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4Sa-6aSMW19zM7n8yScPSRqOvLaDAuzFopMH_N1MOr3A&oe=6A1AE6B5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Monkey Havoc Trailer Image.png", "id": "523796653745732", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38974886_523796657079065_1178915653974772965_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Hgg5T93mGF4Q7kNvwHpGzrb&_nc_oc=Adr6QXMY2dwksl99uVCVOiO2KrJkI1HmCiz9R2x1rmflBjcvGBRT0ahgIGtFJny4CQg&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af559fzHo4ycvhSyl15HAmUxUJICf-d-b6jj3RJAa1qdNA&oe=6A1AE933"}, "display_name": "Monkey Havoc", "keywords": ["Monkey", "Fan", "Game", "Gorilla", "Capuchin"], "long_description": "Welcome to Monkey Havoc, a game based off of the popular games 'Gorilla Tag' and 'Capuchin'. In Monkey Havoc you are able to freely move around many different maps with your friends, equip different styles of cosmetics, and compete in challenges to earn special cosmetics.\nThis game is constantly undergoing development and receiving updates to add more cosmetics, maps, and experiences.\nPlease let me know what to improve on by leaving a review and commenting on what could be better!\ud83d\ude0a\nContact Email: monkeyhavoccreator@gmail.com", "short_description": "Monkey Havoc is a 'Gorilla Tag' and 'Capuchin' fan game, made so that you and your friends can freely 
795275_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W8cmmgwl3ZcQ7kNvwFwqlJR&_nc_oc=AdoYpWS39wP6FIyC5VknJzcgCvb_96m5zTCpczjq5Vh_XB3XPOAvJNqrXdGlEu0nz5o&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMtvU0YumPr2a7RTeKUIH7lbPnX0UCLZSiqnSHF8YRehg&oe=6AE5F616"}, {"file_name": "5.png", "id": "540438542039147", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75395590_540438545372480_7329384731897725266_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zwnNX7o6SDsQ7kNvwGWfJKk&_nc_oc=AdoulSFHyIsdZb0iUylzYR0UdOph9qCi4Yv1Bcnwu6V90BT0tp3wYWH4waM3873xTeo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPUa2YWVPnRa0eAp5vtAm174uWyCTEdam54FhCrVRFTCg&oe=6AE5EDB5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Monkey Havoc Trailer Image.png", "id": "523796653745732", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974886_523796657079065_1178915653974772965_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F-FhJYkTaDMQ7kNvwGljjcR&_nc_oc=Ados4xnrXm4CLbqU7wRY-dirMA2LbbjgEK601_jEBNPojUYr0sNu6HlUQW8t-3TspOQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNKWNIdPi2Qyf9TV0wzOibWSv7KehwNOaL2jcCusoXQCw&oe=6AE5F033"}, "display_name": "Monkey Havoc", "keywords": ["Monkey", "Fan", "Game", "Gorilla", "Capuchin"], "long_description": "Welcome to Monkey Havoc, a game based off of the popular games 'Gorilla Tag' and 'Capuchin'. In Monkey Havoc you are able to freely move around many different maps with your friends, equip different styles of cosmetics, and compete in challenges to earn special cosmetics.\nThis game is constantly undergoing development and receiving updates to add more cosmetics, maps, and experiences.\nPlease let me know what to improve on by leaving a review and commenting on what could be better!\ud83d\ude0a\nContact Email: monkeyhavoccreator@gmail.com", "short_description": "Monkey Havoc is a 'Gorilla Tag' and 'Capuchin' fan game, made so that you and your friends can freely 
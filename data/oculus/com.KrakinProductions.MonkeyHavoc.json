795275_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8NGfou41SHsQ7kNvwFWWhfr&_nc_oc=Ado72qQ-i2aEDe0WMg3AA2OKhb5O0Vf2ZlCKTIItLFWafNcxK10dbPHT5ffU81vBOgQ&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRbnp3ifKRsOXhMJfhJfqKzGjroQgKJgE8-SoRsr4M3IQ&oe=6AF32516"}, {"file_name": "5.png", "id": "540438542039147", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75395590_540438545372480_7329384731897725266_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mDWCynZXtLQQ7kNvwEJP6d_&_nc_oc=Adp0MTmuEuI5sLTrt9YxhIFMPqmexKMeUrTCcw8MEzi9j8X4evl9gfsKkSXmjwVUyLo&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQROfOzSmGWYIawTzsLdzN0Vz3oZEkUCg8tWmcBhuMFQjA&oe=6AF354F5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Monkey Havoc Trailer Image.png", "id": "523796653745732", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974886_523796657079065_1178915653974772965_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S7ITibVblBAQ7kNvwGCRDZf&_nc_oc=AdpKAKOK-QF_skfNLg1BstqxuTZdBlJsBIsr0F-qZw_GFSs7XJ7Pj8iCERHeEZqSQFs&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQw-X4FABGCzcqJn6xNWYsjOP4abSRFls0SWNZGHoE8Kw&oe=6AF35773"}, "display_name": "Monkey Havoc", "keywords": ["Monkey", "Fan", "Game", "Gorilla", "Capuchin"], "long_description": "Welcome to Monkey Havoc, a game based off of the popular games 'Gorilla Tag' and 'Capuchin'. In Monkey Havoc you are able to freely move around many different maps with your friends, equip different styles of cosmetics, and compete in challenges to earn special cosmetics.\nThis game is constantly undergoing development and receiving updates to add more cosmetics, maps, and experiences.\nPlease let me know what to improve on by leaving a review and commenting on what could be better!\ud83d\ude0a\nContact Email: monkeyhavoccreator@gmail.com", "short_description": "Monkey Havoc is a 'Gorilla Tag' and 'Capuchin' fan game, made so that you and your friends can freely 
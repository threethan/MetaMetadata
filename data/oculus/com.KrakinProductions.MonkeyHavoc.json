9_1766831023204795275_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S4-bB2tj_EMQ7kNvwEWWXHv&_nc_oc=AdpmvBBvKnBsVeBZRYDYJsUPddX7UOGWPqEI5mCtY8lmJ6uOPayKnx_CDD1uogDR_NI&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5e0SO9QaG23bhq_dMalrMUGXJHS6Smr-UBxzDwTxJ1gg&oe=6A11B496"}, {"file_name": "5.png", "id": "540438542039147", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/75395590_540438545372480_7329384731897725266_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IEZnB_Ypi08Q7kNvwFesFcD&_nc_oc=Adp-7JWVjCif1x-JarfDtHr2lsvVaLr3hYvAkhB2mXNMOPXlEqt-bg9phQ3kp9jMRfc&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5ltCMWqvu5odkjWevruTVDSWfoTYBKQDfwoIvrFsRRGQ&oe=6A11AC35"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Monkey Havoc Trailer Image.png", "id": "523796653745732", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/38974886_523796657079065_1178915653974772965_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KxNh0K1H3goQ7kNvwH41aTp&_nc_oc=Ado-R2nXK_27UfntEEkFIBWmQQ4szHPIKtHQcPtQeNO860Uwy2mg0gh1LsAkVnkT2F0&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7jQ_0BOmEuIz30xeps46H2yx7un_P77kGnQRZJs-J0UA&oe=6A11AEB3"}, "display_name": "Monkey Havoc", "keywords": ["Monkey", "Fan", "Game", "Gorilla", "Capuchin"], "long_description": "Welcome to Monkey Havoc, a game based off of the popular games 'Gorilla Tag' and 'Capuchin'. In Monkey Havoc you are able to freely move around many different maps with your friends, equip different styles of cosmetics, and compete in challenges to earn special cosmetics.\nThis game is constantly undergoing development and receiving updates to add more cosmetics, maps, and experiences.\nPlease let me know what to improve on by leaving a review and commenting on what could be better!\ud83d\ude0a\nContact Email: monkeyhavoccreator@gmail.com", "short_description": "Monkey Havoc is a 'Gorilla Tag' and 'Capuchin' fan game, made so that you and your
795275_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uYeX-XrKitcQ7kNvwEszgeq&_nc_oc=AdqbjDd5RBsLFoWVqAFl72QIVaidMhK67LDNfIt_Upknv4jFyBNeiGaPnM5ODD9UlHQ&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE2qVAqbHbnNuifwYG_a23jOkjzcoHSfiSITzMX61--yw&oe=6A915DD6"}, {"file_name": "5.png", "id": "540438542039147", "uri": "https://scontent-hkg1-1.oculuscdn.com/v/t64.5771-25/75395590_540438545372480_7329384731897725266_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hsu6PqI7SroQ7kNvwHyzoD1&_nc_oc=AdoQ5awYdCm3zHHdBJo4lsWYDQjhSytpMgztsUiDNcfSlGX5irww3p8mi6Y3JUBC9Xw&_nc_zt=3&_nc_ht=scontent-hkg1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHlQBBynSNjfR-52Cs7i256FLc3VQFjJiaw2KCnWDj38A&oe=6A918DB5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Monkey Havoc Trailer Image.png", "id": "523796653745732", "uri": "https://scontent-hkg1-1.oculuscdn.com/v/t64.5771-25/38974886_523796657079065_1178915653974772965_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ii-FDQNdi_AQ7kNvwF-Vluo&_nc_oc=AdrzSuiGzAzZfMHIuVuvP5pfp3YZUvgG537TgKnwVXzVv6QrvsLQjhxf_tyA4MrqJa0&_nc_zt=3&_nc_ht=scontent-hkg1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEwiUYsxBa7OgVc4GGoOOc3sop1fpveQRwIzh5cxiyUUA&oe=6A919033"}, "display_name": "Monkey Havoc", "keywords": ["Monkey", "Fan", "Game", "Gorilla", "Capuchin"], "long_description": "Welcome to Monkey Havoc, a game based off of the popular games 'Gorilla Tag' and 'Capuchin'. In Monkey Havoc you are able to freely move around many different maps with your friends, equip different styles of cosmetics, and compete in challenges to earn special cosmetics.\nThis game is constantly undergoing development and receiving updates to add more cosmetics, maps, and experiences.\nPlease let me know what to improve on by leaving a review and commenting on what could be better!\ud83d\ude0a\nContact Email: monkeyhavoccreator@gmail.com", "short_description": "Monkey Havoc is a 'Gorilla Tag' and 'Capuchin' fan game, made so that you and your friends can freely 
795275_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d_PrLSsDchsQ7kNvwFDnQGr&_nc_oc=AdqNapTdzlZV2D9mHK2gShMQj4sQmFdYUVNNQDo3b9KOlHfZXufx7RG40Ow4RrVL7GM&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO-CuS0xCqJ0TXeMFzgvSN_38VKdk5VAejdNA52Piz_og&oe=6AC7A396"}, {"file_name": "5.png", "id": "540438542039147", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/75395590_540438545372480_7329384731897725266_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dvf9OoIpHMQQ7kNvwEOUk3M&_nc_oc=AdpdL0NU9vGNwqupEKP8uSO1Lv2rWhWiV3YscUrYCDk-pWcdohtvMCBel9PqCd22ZeY&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNB0dhQSERklN1MDOLwY5kvV09qOd2IrO4i3t_ELS52fQ&oe=6AC79B35"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Monkey Havoc Trailer Image.png", "id": "523796653745732", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38974886_523796657079065_1178915653974772965_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UscWCrXIPNAQ7kNvwHissDZ&_nc_oc=AdoePcxSA_9VuOJuPhmTTlU5EO2an9bzz9LN_xmjt5IVBtgFiagtymeBxJmYug0CKgo&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOGw5WV1ukf6obXqsbkXD_L7uJYkuGsOb3vgaCMM5W4YQ&oe=6AC79DB3"}, "display_name": "Monkey Havoc", "keywords": ["Monkey", "Fan", "Game", "Gorilla", "Capuchin"], "long_description": "Welcome to Monkey Havoc, a game based off of the popular games 'Gorilla Tag' and 'Capuchin'. In Monkey Havoc you are able to freely move around many different maps with your friends, equip different styles of cosmetics, and compete in challenges to earn special cosmetics.\nThis game is constantly undergoing development and receiving updates to add more cosmetics, maps, and experiences.\nPlease let me know what to improve on by leaving a review and commenting on what could be better!\ud83d\ude0a\nContact Email: monkeyhavoccreator@gmail.com", "short_description": "Monkey Havoc is a 'Gorilla Tag' and 'Capuchin' fan game, made so that you and your friends can freely 
795275_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9rIGVjfQ4xEQ7kNvwFlwtPc&_nc_oc=AdrjGLxjz9LkNqzpqXnoBI5C2MBxGXe4mdujhZYEOpcKWZw7CHoMU6s3yXpP4p8YcDU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH1O-3B-8d2Nmq57c3vm0095-sDY0HZQPyYI6EGPwsQtw&oe=6A79DB16"}, {"file_name": "5.png", "id": "540438542039147", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75395590_540438545372480_7329384731897725266_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CX8Yl8JZ_MMQ7kNvwHF4Ame&_nc_oc=AdqBR9NErv9NcsP2YIFMzXm_FPpkmWQD7-DiAyTnnFigerHmc6IOYPGf8xsnEPgqIoU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQERpsNueSivepA0YsUB1iS2b3yEawir4pdk8Eq4vQvVuQ&oe=6A79D2B5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Monkey Havoc Trailer Image.png", "id": "523796653745732", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974886_523796657079065_1178915653974772965_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=edmvAoKaLYQQ7kNvwEuirFN&_nc_oc=AdoHlGfGe62Y5T_uE01BK_8F8VhVm6dmqYkEXds49jDgyncWjy_erYYOcmgRUJbLuVk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFiuN0rhiMRYBu3zCe0JrOZxWVcZ3_QgEOPlCazGsiiRw&oe=6A79D533"}, "display_name": "Monkey Havoc", "keywords": ["Monkey", "Fan", "Game", "Gorilla", "Capuchin"], "long_description": "Welcome to Monkey Havoc, a game based off of the popular games 'Gorilla Tag' and 'Capuchin'. In Monkey Havoc you are able to freely move around many different maps with your friends, equip different styles of cosmetics, and compete in challenges to earn special cosmetics.\nThis game is constantly undergoing development and receiving updates to add more cosmetics, maps, and experiences.\nPlease let me know what to improve on by leaving a review and commenting on what could be better!\ud83d\ude0a\nContact Email: monkeyhavoccreator@gmail.com", "short_description": "Monkey Havoc is a 'Gorilla Tag' and 'Capuchin' fan game, made so that you and your friends can freely 
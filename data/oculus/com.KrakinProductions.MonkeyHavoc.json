795275_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cslG3jBj_0YQ7kNvwE5AtSc&_nc_oc=AdrpHUKbmLnEeqr8x6s7riC-W5oiesGWi_OO6xpGTHjqcMhKR44LjvURLtMsbCzkcwI&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKX-e2F-T2sgLP3t7v6fzILCp9a4SBnoJ8XXqrBBO4RvA&oe=6AA16816"}, {"file_name": "5.png", "id": "540438542039147", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/75395590_540438545372480_7329384731897725266_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o9Ep2mpkrtQQ7kNvwFit9RX&_nc_oc=AdrER13B6ui0yOFOnAQkYqgZh8-vHO9-e1Pd1fBdjm0ujb9AZwA3jbIqb28Fc8aAroQ&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLzSLghRiKxXLdR7FOX0Py4RpkeQoYwRQTufM3Mkanlzw&oe=6AA15FB5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Monkey Havoc Trailer Image.png", "id": "523796653745732", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38974886_523796657079065_1178915653974772965_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hcl4Q-WxyG0Q7kNvwEtqstS&_nc_oc=AdrlYJW1jt0BA7y1FzdhoEhGABBUSzg15JP6TBp9JsnAgbntqIwnsu7DZ4cxKtdyqV4&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKbZFknVEc5Y4HgHyVrewC7IpEXn9K1TX_TO_y--WfM7A&oe=6AA16233"}, "display_name": "Monkey Havoc", "keywords": ["Monkey", "Fan", "Game", "Gorilla", "Capuchin"], "long_description": "Welcome to Monkey Havoc, a game based off of the popular games 'Gorilla Tag' and 'Capuchin'. In Monkey Havoc you are able to freely move around many different maps with your friends, equip different styles of cosmetics, and compete in challenges to earn special cosmetics.\nThis game is constantly undergoing development and receiving updates to add more cosmetics, maps, and experiences.\nPlease let me know what to improve on by leaving a review and commenting on what could be better!\ud83d\ude0a\nContact Email: monkeyhavoccreator@gmail.com", "short_description": "Monkey Havoc is a 'Gorilla Tag' and 'Capuchin' fan game, made so that you and your friends can freely 
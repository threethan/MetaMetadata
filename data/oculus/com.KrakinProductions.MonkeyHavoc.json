795275_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LWId-3xhEw0Q7kNvwHtMcy9&_nc_oc=Adq6flxyh9FNWZgb6lAOqKbovpnkCDk-ZEpQpaIGv9dmuplnE7ND6vVecZTe9fcR4qQ&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-RLEsj58M4RVsyxRc0bd-WRH-D1hfMdXRc19lRSneemw&oe=6A33FB96"}, {"file_name": "5.png", "id": "540438542039147", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75395590_540438545372480_7329384731897725266_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oVnPakNUpX0Q7kNvwGCcDzP&_nc_oc=AdpJoW4PZ_7-WcQainnWGJj34mxQUL6wx0ncWrwSGGQKlhnMTX2yf89SS7ayefVsqvA&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8Gh-EkkhaAnW9d8bspXVkZCHgKaHKjEQEEFmMsq94dgw&oe=6A33F335"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Monkey Havoc Trailer Image.png", "id": "523796653745732", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974886_523796657079065_1178915653974772965_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FnvXjjgHBxQQ7kNvwEx9cjL&_nc_oc=Adr8Xbrm5JQcAHvNM3KcElLtSJquomGCK3Q7Dp1b6iqAEkI3ID7925ekwuvNkU6hfhM&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-v715u-5jQurIVFidi_ctUAlh0hADz4w3u7SJ2aMmLaA&oe=6A33F5B3"}, "display_name": "Monkey Havoc", "keywords": ["Monkey", "Fan", "Game", "Gorilla", "Capuchin"], "long_description": "Welcome to Monkey Havoc, a game based off of the popular games 'Gorilla Tag' and 'Capuchin'. In Monkey Havoc you are able to freely move around many different maps with your friends, equip different styles of cosmetics, and compete in challenges to earn special cosmetics.\nThis game is constantly undergoing development and receiving updates to add more cosmetics, maps, and experiences.\nPlease let me know what to improve on by leaving a review and commenting on what could be better!\ud83d\ude0a\nContact Email: monkeyhavoccreator@gmail.com", "short_description": "Monkey Havoc is a 'Gorilla Tag' and 'Capuchin' fan game, made so that you and your friends can freely 
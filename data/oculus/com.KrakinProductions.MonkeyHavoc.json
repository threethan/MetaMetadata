795275_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zv3Wk5eZvosQ7kNvwHfoF6Y&_nc_oc=AdodIVOkQpuPaYzyYUqCjVSJWpec_WuMnW_l3avddwSwgOihviyvG-HwN6Uwls60ePE&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBQ9DuGNbl1w2hr09fW5OSYVKxhghUN_i7ds7Q_4Zyspg&oe=6A539F96"}, {"file_name": "5.png", "id": "540438542039147", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/75395590_540438545372480_7329384731897725266_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H2v3a1j7BF0Q7kNvwFMirG6&_nc_oc=AdoIzynVvlIV1IVfGSnEUw7NOEoAPb1iHru7Bd5kP9c4XDSW9hhIQI-mLv9zkRK7gTE&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCUPpQATfAve_hq4SthwFpi7pwcPjZEBWi5L5CTiErCgg&oe=6A539735"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Monkey Havoc Trailer Image.png", "id": "523796653745732", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38974886_523796657079065_1178915653974772965_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xdugsXPyL7sQ7kNvwE27l-t&_nc_oc=Adop2mtQWAhQgFatFbdFPR8ZDTjlctDrJoKodO2zc7jUOoJyEKueJTS3Xr1WJ2e3kzc&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB5IjEL-2IR4kGCT7hsGBeVOkGV3-a-dB0DUV628SKkRA&oe=6A5399B3"}, "display_name": "Monkey Havoc", "keywords": ["Monkey", "Fan", "Game", "Gorilla", "Capuchin"], "long_description": "Welcome to Monkey Havoc, a game based off of the popular games 'Gorilla Tag' and 'Capuchin'. In Monkey Havoc you are able to freely move around many different maps with your friends, equip different styles of cosmetics, and compete in challenges to earn special cosmetics.\nThis game is constantly undergoing development and receiving updates to add more cosmetics, maps, and experiences.\nPlease let me know what to improve on by leaving a review and commenting on what could be better!\ud83d\ude0a\nContact Email: monkeyhavoccreator@gmail.com", "short_description": "Monkey Havoc is a 'Gorilla Tag' and 'Capuchin' fan game, made so that you and your friends can freely 
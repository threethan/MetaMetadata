795275_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6uzTcDpV25kQ7kNvwGBx-iz&_nc_oc=Adqs0sWyaFX1sW-abJdUFQTT_DuJIHd1w2mcAyAqt-XtLmS7zd7tCV9dWJjiNcSkU64&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9M2DRb6pvqgBaQ6T9YkkorxsjM7j3UJlFPGebZOKcstA&oe=6A242996"}, {"file_name": "5.png", "id": "540438542039147", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/75395590_540438545372480_7329384731897725266_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wHtkPugO_zEQ7kNvwEcQO0Z&_nc_oc=Adq3s4Tl08jNIzLNzEGZxBrGrdjmP_3YvA49MAmVt7-VugwOH2yRZIUhxUxdjT_qoLU&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_-m2f6myTrrz1rwrbtCjMijOlQOiywEqrKhGgZWwvL7Q&oe=6A242135"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Monkey Havoc Trailer Image.png", "id": "523796653745732", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974886_523796657079065_1178915653974772965_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wONqnRFmx-wQ7kNvwFGPJrI&_nc_oc=AdqbJZlYxvWesM4dxlhZsBFF_WD6V3UDYRD5Zo2PgC1SoK2UF03-HbL5GT92DSx3DNw&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_UyAHw6ZtWzDZZpDK5iPQQNpyX-_A-D48-kXcXyiAIwg&oe=6A2423B3"}, "display_name": "Monkey Havoc", "keywords": ["Monkey", "Fan", "Game", "Gorilla", "Capuchin"], "long_description": "Welcome to Monkey Havoc, a game based off of the popular games 'Gorilla Tag' and 'Capuchin'. In Monkey Havoc you are able to freely move around many different maps with your friends, equip different styles of cosmetics, and compete in challenges to earn special cosmetics.\nThis game is constantly undergoing development and receiving updates to add more cosmetics, maps, and experiences.\nPlease let me know what to improve on by leaving a review and commenting on what could be better!\ud83d\ude0a\nContact Email: monkeyhavoccreator@gmail.com", "short_description": "Monkey Havoc is a 'Gorilla Tag' and 'Capuchin' fan game, made so that you and your friends can freely 
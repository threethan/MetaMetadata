795275_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xyqz_airmrAQ7kNvwFZem1I&_nc_oc=AdqhiK09gXoeov1dOBN_pk97__34V_wpUDhjOmxMk6v9s2VCkj_cihWiFopl7yQsScE&_nc_zt=3&_nc_ht=scontent-lhr8-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2sU4QgP_puYZg7z4dnEkZ9N07t7m1dOP26T0i8u-IzbA&oe=69E23E96"}, {"file_name": "5.png", "id": "540438542039147", "uri": "https://scontent-lhr8-2.oculuscdn.com/v/t64.5771-25/75395590_540438545372480_7329384731897725266_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lNySnJ3wk00Q7kNvwGugnvv&_nc_oc=Adot2Qq5COUizC2D1elKmTN22OooD_C1cepXc0xcDjkvYZXVHE5Wu4Ejv0ftJzBO8qM&_nc_zt=3&_nc_ht=scontent-lhr8-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af38qjw6moux2Jx6ny4V5RNAwVV6abOaoGUIYkJvg7uTJA&oe=69E23635"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Monkey Havoc Trailer Image.png", "id": "523796653745732", "uri": "https://scontent-lhr8-2.oculuscdn.com/v/t64.5771-25/38974886_523796657079065_1178915653974772965_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Kt-WWXSma4QQ7kNvwENg2kH&_nc_oc=AdqyDn052C8B4xnOiZj7jCLGqbfoJAOHEdx117DkNs4Wv2EPOOHUKUmk5Wxxz47no5I&_nc_zt=3&_nc_ht=scontent-lhr8-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2XPbpQ5B9JDK0ERwczJzPkbcOGGg7sJa8Q6C2waDF3-w&oe=69E238B3"}, "display_name": "Monkey Havoc", "keywords": ["Monkey", "Fan", "Game", "Gorilla", "Capuchin"], "long_description": "Welcome to Monkey Havoc, a game based off of the popular games 'Gorilla Tag' and 'Capuchin'. In Monkey Havoc you are able to freely move around many different maps with your friends, equip different styles of cosmetics, and compete in challenges to earn special cosmetics.\nThis game is constantly undergoing development and receiving updates to add more cosmetics, maps, and experiences.\nPlease let me know what to improve on by leaving a review and commenting on what could be better!\ud83d\ude0a\nContact Email: monkeyhavoccreator@gmail.com", "short_description": "Monkey Havoc is a 'Gorilla Tag' and 'Capuchin' fan game, made so that you and your friends can freely 
795275_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4XPghTv-yR0Q7kNvwE1Ka8A&_nc_oc=Adr3PF5h-llTOL_QKtcHkAFSxwwJa_HXOnnIPezUlX6IZ2dzzPczFtK2a9wlR9yWwQw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPHXFx7bWEm8mIOehiaSo_Eqpdzw0ZtVV8B7AQ0G95HDA&oe=6ACF8C96"}, {"file_name": "5.png", "id": "540438542039147", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75395590_540438545372480_7329384731897725266_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NZI-vjC5BkgQ7kNvwFXnV7M&_nc_oc=AdoLA7cVEQt_3lZrRPtafQCYIkgnexaumf6lXWnzcLOzqZYjDdNeq-SrqD_9oVM9w3g&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPPvehP8vrYiDc-l7mgCO-k_BICaRM2Al9eu4DitIy2Zg&oe=6ACF8435"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Monkey Havoc Trailer Image.png", "id": "523796653745732", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974886_523796657079065_1178915653974772965_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xXWwWfD2KxoQ7kNvwFMsAcc&_nc_oc=Adq3ookhETJkOGP9UDoKx95rvedn0UnC6Aj0oL_H0CKlU2MaJuB8pr1TKz-f1iTV5VA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOwzYAmylM3XFpPabByacOIPIm3hdsLWSvx62_Q6FnFpQ&oe=6ACF86B3"}, "display_name": "Monkey Havoc", "keywords": ["Monkey", "Fan", "Game", "Gorilla", "Capuchin"], "long_description": "Welcome to Monkey Havoc, a game based off of the popular games 'Gorilla Tag' and 'Capuchin'. In Monkey Havoc you are able to freely move around many different maps with your friends, equip different styles of cosmetics, and compete in challenges to earn special cosmetics.\nThis game is constantly undergoing development and receiving updates to add more cosmetics, maps, and experiences.\nPlease let me know what to improve on by leaving a review and commenting on what could be better!\ud83d\ude0a\nContact Email: monkeyhavoccreator@gmail.com", "short_description": "Monkey Havoc is a 'Gorilla Tag' and 'Capuchin' fan game, made so that you and your friends can freely 
795275_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NHV43unp_zIQ7kNvwHkUg-c&_nc_oc=AdqfySOC4Ke4yby79MDkM_F-_TmPy5LrLf47AXXZPlOHRdajRJxWTeePZZS3CUcO_LI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2FWgUx70_2kYkzoY5bIKYA1kJyR2j3nOrxPY37LpHAmQ&oe=69D50F96"}, {"file_name": "5.png", "id": "540438542039147", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75395590_540438545372480_7329384731897725266_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2_iGNg4q8vsQ7kNvwFtrhv4&_nc_oc=Adr1mbdSU3TOaa6IQaEE_e2bPYCTYEZxaeNmmm4QogCGl1XA-Dyh_PWCOgqPMCikj0k&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3KKGqqCWhxb55TsbXSQYMeJh0YGx8onyAPsbHX-nsldw&oe=69D50735"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Monkey Havoc Trailer Image.png", "id": "523796653745732", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974886_523796657079065_1178915653974772965_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oXNFIkfjchgQ7kNvwH1pO9Q&_nc_oc=AdpXlTBTlq93_7RNJF10RJA-O-4SWY4Ja_JcsRYKval1RTD8dRmQZNtRhFFP7dXqxus&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1830mhal3znoeXGSRGobrrL5RZd9wcWa5-jJNDgFAiDw&oe=69D509B3"}, "display_name": "Monkey Havoc", "keywords": ["Monkey", "Fan", "Game", "Gorilla", "Capuchin"], "long_description": "Welcome to Monkey Havoc, a game based off of the popular games 'Gorilla Tag' and 'Capuchin'. In Monkey Havoc you are able to freely move around many different maps with your friends, equip different styles of cosmetics, and compete in challenges to earn special cosmetics.\nThis game is constantly undergoing development and receiving updates to add more cosmetics, maps, and experiences.\nPlease let me know what to improve on by leaving a review and commenting on what could be better!\ud83d\ude0a\nContact Email: monkeyhavoccreator@gmail.com", "short_description": "Monkey Havoc is a 'Gorilla Tag' and 'Capuchin' fan game, made so that you and your friends can freely 
795275_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cslG3jBj_0YQ7kNvwGLlhVX&_nc_oc=Ado5pNg_ndyblj98wM4A3AY0E0TRYTLpi81GkamrO3zy1-dO6ZtyWvNbJHC9tby2q60&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIK83lHSUGfTB5QNIx5Uzwdb3BvP6owb_6L06RuVYcZTQ&oe=6AA01696"}, {"file_name": "5.png", "id": "540438542039147", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/75395590_540438545372480_7329384731897725266_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KyBzv8Czm5wQ7kNvwE7onTD&_nc_oc=AdrcemybFf4FjeLkZa6vQMODU0jdIMgPzBwSMoJ6jJtVgeY_GQqK-qT1s4xOP9qk6sY&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKQnqaHCEgrnRkSOTtkVv4pWcBGe4ubkfaPYo3F-nCuQA&oe=6AA00E35"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Monkey Havoc Trailer Image.png", "id": "523796653745732", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38974886_523796657079065_1178915653974772965_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nFewmkZFRnwQ7kNvwGC6AHa&_nc_oc=Adou0AgzH5zcVn1sffQHRRKJ39fZOycheYWfp0y12yLUNk8Ihee8_LJz5vaZEDVg2HA&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKqq8Ak0YlUqiSs0JAdmGWn8LIKI67HWJObW8yCiLZukg&oe=6AA010B3"}, "display_name": "Monkey Havoc", "keywords": ["Monkey", "Fan", "Game", "Gorilla", "Capuchin"], "long_description": "Welcome to Monkey Havoc, a game based off of the popular games 'Gorilla Tag' and 'Capuchin'. In Monkey Havoc you are able to freely move around many different maps with your friends, equip different styles of cosmetics, and compete in challenges to earn special cosmetics.\nThis game is constantly undergoing development and receiving updates to add more cosmetics, maps, and experiences.\nPlease let me know what to improve on by leaving a review and commenting on what could be better!\ud83d\ude0a\nContact Email: monkeyhavoccreator@gmail.com", "short_description": "Monkey Havoc is a 'Gorilla Tag' and 'Capuchin' fan game, made so that you and your friends can freely 
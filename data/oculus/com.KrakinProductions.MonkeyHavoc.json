795275_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q2HAbxhs4RcQ7kNvwG2--RK&_nc_oc=Adr-ELJ-2Z2R7ZGlPibq-5jitOJBbokwVjk5w3yZWxnd6iag_VDRZ9DH82BtfD-DwOU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6nfCSB_ICutYkaTHKtngKdMJvusU0iLOD_iFfCFfSZtA&oe=6A087A16"}, {"file_name": "5.png", "id": "540438542039147", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75395590_540438545372480_7329384731897725266_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ylJ5Nti4RbwQ7kNvwER62CK&_nc_oc=AdpADGmMuCGmaFhq1f8AKW2gH-WBjSE0eAdZEmCzQfih1PeOZFbol6jK0EJz1HfN8JE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4Ax0M-n85X8U6ATyAhcvLKFZOobWF_BmLZQtBFUAf2eQ&oe=6A0871B5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Monkey Havoc Trailer Image.png", "id": "523796653745732", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974886_523796657079065_1178915653974772965_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FtT5gO5PN7cQ7kNvwHgyzy9&_nc_oc=AdrES4tHl_eiEeoG8YQkBMB0gN6-2YiM-UT0vCXN52gPZY_pq4Ayf-X5gu1kinmYGVg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4cAzx4BAvopj6eIjleZasoye-qanrmEdupoOKjp60rPA&oe=6A087433"}, "display_name": "Monkey Havoc", "keywords": ["Monkey", "Fan", "Game", "Gorilla", "Capuchin"], "long_description": "Welcome to Monkey Havoc, a game based off of the popular games 'Gorilla Tag' and 'Capuchin'. In Monkey Havoc you are able to freely move around many different maps with your friends, equip different styles of cosmetics, and compete in challenges to earn special cosmetics.\nThis game is constantly undergoing development and receiving updates to add more cosmetics, maps, and experiences.\nPlease let me know what to improve on by leaving a review and commenting on what could be better!\ud83d\ude0a\nContact Email: monkeyhavoccreator@gmail.com", "short_description": "Monkey Havoc is a 'Gorilla Tag' and 'Capuchin' fan game, made so that you and your friends can freely 
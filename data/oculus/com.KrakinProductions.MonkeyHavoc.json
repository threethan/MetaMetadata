795275_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YDetaY1sw-YQ7kNvwHHoCmH&_nc_oc=Adr0kTQiqUeToIXj6dTt9jTs0JDLh_keCbZIjxj0XsKiNJT5x9h513LtOzcrrOWJoMc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNOQtCh7-bxCgdCVVp_kqyuT1otO2N4QaBZMx8Lx3mh0A&oe=6ADE0D16"}, {"file_name": "5.png", "id": "540438542039147", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75395590_540438545372480_7329384731897725266_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RjIbaCKwjLsQ7kNvwG23CIx&_nc_oc=Adoaig5mTal8Ddn7j9-HQcAiWou98doYejJhXGU7fO1jOby13T-Xs2MFcKX2aOEYUPQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOwMYI30w_ePvoV0Tc0dsliwUaZ8lM3mcUEoipFzDuakQ&oe=6ADE04B5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Monkey Havoc Trailer Image.png", "id": "523796653745732", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974886_523796657079065_1178915653974772965_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2pgHEtzxKYEQ7kNvwGxKCg3&_nc_oc=AdrG95-pYDTNfC0sBEXLzokckIX1a_8txxOrqiSGYsxW4zow26iMbbCDdQuFjbnr_lI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNSqjW5ADnX-bV3eI9lmeF6Ultwkz-IU-tA_tEsUUKqxw&oe=6ADE0733"}, "display_name": "Monkey Havoc", "keywords": ["Monkey", "Fan", "Game", "Gorilla", "Capuchin"], "long_description": "Welcome to Monkey Havoc, a game based off of the popular games 'Gorilla Tag' and 'Capuchin'. In Monkey Havoc you are able to freely move around many different maps with your friends, equip different styles of cosmetics, and compete in challenges to earn special cosmetics.\nThis game is constantly undergoing development and receiving updates to add more cosmetics, maps, and experiences.\nPlease let me know what to improve on by leaving a review and commenting on what could be better!\ud83d\ude0a\nContact Email: monkeyhavoccreator@gmail.com", "short_description": "Monkey Havoc is a 'Gorilla Tag' and 'Capuchin' fan game, made so that you and your friends can freely 
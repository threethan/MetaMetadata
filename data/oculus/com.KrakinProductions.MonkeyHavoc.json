795275_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZYeja5LxiZQQ7kNvwGrw0W8&_nc_oc=AdryA954N5TGQjCa5EOiE3S1kc9lB2MWB4a65R9D5vSs23d8MFH5xunpyJVar4T7lJ0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0N3sGuREwXjSEdVS5EufE3H8dAb43qV2IP9Ksn4ywQJg&oe=69DF9B96"}, {"file_name": "5.png", "id": "540438542039147", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75395590_540438545372480_7329384731897725266_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lNySnJ3wk00Q7kNvwFhK3Qb&_nc_oc=AdoD1Ui5hiUBzLxyuY8gISKf-hQ7OPH5sKaFbip40poGrTQZNHDeHM_6eFxDuXbkVDo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af22i3oJmFStqOO8Q4Rl6CyN0tzbM-QbR1xx2KkqU1v9-A&oe=69DF9335"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Monkey Havoc Trailer Image.png", "id": "523796653745732", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974886_523796657079065_1178915653974772965_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Kt-WWXSma4QQ7kNvwFGlfAh&_nc_oc=AdqCXiKIiy_kOGAaFwpftmuLiBk3to3nzoIwq2YB_ZQ0zFktNOyIQcmrnmmCVPABeME&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2cBetjCOeDIj2fwCVLXdWeTdGfPpiXrK-eY_AFAhUfnw&oe=69DF95B3"}, "display_name": "Monkey Havoc", "keywords": ["Monkey", "Fan", "Game", "Gorilla", "Capuchin"], "long_description": "Welcome to Monkey Havoc, a game based off of the popular games 'Gorilla Tag' and 'Capuchin'. In Monkey Havoc you are able to freely move around many different maps with your friends, equip different styles of cosmetics, and compete in challenges to earn special cosmetics.\nThis game is constantly undergoing development and receiving updates to add more cosmetics, maps, and experiences.\nPlease let me know what to improve on by leaving a review and commenting on what could be better!\ud83d\ude0a\nContact Email: monkeyhavoccreator@gmail.com", "short_description": "Monkey Havoc is a 'Gorilla Tag' and 'Capuchin' fan game, made so that you and your friends can freely 
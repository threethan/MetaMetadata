795275_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Q1wUeIQKEl0Q7kNvwEpcetl&_nc_oc=AdqWBu0uEd78Giyxf7gwBKmt5XDtnyceC6AkY0kx8lTomXAmuGJP7wKegccpBe3_vlQ&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4KVWQp-7xuZ9FcS-gLZQ3AHXwBx9ITE-RTxGONW72e2A&oe=6A0C6E96"}, {"file_name": "5.png", "id": "540438542039147", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/75395590_540438545372480_7329384731897725266_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fhTpiQNkXr4Q7kNvwHPSymy&_nc_oc=AdomTOThzR1I94jmhTrCEt0X4NUKLKBpFkvl03HXOPtXfOOaVp2b5fRyRgJMW71P_Xo&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5aQsatAk08UPyW0mHBi_TtO9j1g95Ras_febkIVZx-eg&oe=6A0C6635"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Monkey Havoc Trailer Image.png", "id": "523796653745732", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38974886_523796657079065_1178915653974772965_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hL6pmp9prCMQ7kNvwGbHUug&_nc_oc=AdqxsT2zVDuu7tSOsin2Hh7kn4OtUaRNk9eg_7vn_HaqU0RZBS-nHx2GNIApEoVzOS0&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4vyz5y_Jz3e5tCCQnG3N3pM5epItUmRpr7om6bpbtQrg&oe=6A0C68B3"}, "display_name": "Monkey Havoc", "keywords": ["Monkey", "Fan", "Game", "Gorilla", "Capuchin"], "long_description": "Welcome to Monkey Havoc, a game based off of the popular games 'Gorilla Tag' and 'Capuchin'. In Monkey Havoc you are able to freely move around many different maps with your friends, equip different styles of cosmetics, and compete in challenges to earn special cosmetics.\nThis game is constantly undergoing development and receiving updates to add more cosmetics, maps, and experiences.\nPlease let me know what to improve on by leaving a review and commenting on what could be better!\ud83d\ude0a\nContact Email: monkeyhavoccreator@gmail.com", "short_description": "Monkey Havoc is a 'Gorilla Tag' and 'Capuchin' fan game, made so that you and your friends can freely 
795275_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SChT3ic9hxMQ7kNvwFwR9d5&_nc_oc=AdodUboqYGjxcVKNH78yqWYQS_R8o7JnETMPrCCYAwCFrd97EzYmdcQn8qg-v8ZXReY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-JcuEEJuwuwC2TUTczXYb47jtkvi1nTQMtfNiXMwO6pw&oe=6A427C16"}, {"file_name": "5.png", "id": "540438542039147", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75395590_540438545372480_7329384731897725266_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yhVTXkDftikQ7kNvwG9J0qy&_nc_oc=Adrf15KI6a1wFZai0gBBG7S7QWy2mUuDjPFyFDYQazZVlMVuRValnqXyPx-ZiBiQtq0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-qa12XMwsBikJyJV1sV5WEYMimUkJJKhQj2tm9dtdN2w&oe=6A4273B5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Monkey Havoc Trailer Image.png", "id": "523796653745732", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974886_523796657079065_1178915653974772965_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Q8kIaYejNjYQ7kNvwF_o5gV&_nc_oc=AdrMAZUhWLh-6MEKBMWwM9Im2BVAU7Iol75K-l0pk_n14uzhJERqKbXkP5CEtVBUn2Q&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_AOGlV7qHqTlTPWN4bDZfqsGWVtK4oex_M6MaLAp1kCg&oe=6A427633"}, "display_name": "Monkey Havoc", "keywords": ["Monkey", "Fan", "Game", "Gorilla", "Capuchin"], "long_description": "Welcome to Monkey Havoc, a game based off of the popular games 'Gorilla Tag' and 'Capuchin'. In Monkey Havoc you are able to freely move around many different maps with your friends, equip different styles of cosmetics, and compete in challenges to earn special cosmetics.\nThis game is constantly undergoing development and receiving updates to add more cosmetics, maps, and experiences.\nPlease let me know what to improve on by leaving a review and commenting on what could be better!\ud83d\ude0a\nContact Email: monkeyhavoccreator@gmail.com", "short_description": "Monkey Havoc is a 'Gorilla Tag' and 'Capuchin' fan game, made so that you and your friends can freely 
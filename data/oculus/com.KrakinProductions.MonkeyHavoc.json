795275_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8NGfou41SHsQ7kNvwE9bjij&_nc_oc=Adr-9nyvENzhdtK6o9Dz42J7nFPvcHs9dEnDMOl5-U_XLlKCA5ZBF-sJYKi4rhDyZCI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQbNClRSoD4EhNsdqL9AvtncBtemcQfzT6RInZ3YvVRfA&oe=6AF5C816"}, {"file_name": "5.png", "id": "540438542039147", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75395590_540438545372480_7329384731897725266_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SqSD6BDR_nAQ7kNvwG0zEwD&_nc_oc=Adq8swgavQfuLvP60glpoukFeFrc11vEkQ1-GgNlYJitr4MFlI-IafQ-UmBPoPgl_yI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRi4VkTldwKAUksb9uOl1y6r27QBUsxpEBy6hIE-Zcnkg&oe=6AF5BFB5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Monkey Havoc Trailer Image.png", "id": "523796653745732", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974886_523796657079065_1178915653974772965_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S7ITibVblBAQ7kNvwFaZx0g&_nc_oc=AdoDzOQta8SrdvIo-yPibnlVuy16RE6u5VdW1veVHMkQXug1wJ_B7pAlRvk0sxGj0Js&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRutWDZUg0C80eKffN1p5u8zr06FRkAybRDosEFZFU5ow&oe=6AF5C233"}, "display_name": "Monkey Havoc", "keywords": ["Monkey", "Fan", "Game", "Gorilla", "Capuchin"], "long_description": "Welcome to Monkey Havoc, a game based off of the popular games 'Gorilla Tag' and 'Capuchin'. In Monkey Havoc you are able to freely move around many different maps with your friends, equip different styles of cosmetics, and compete in challenges to earn special cosmetics.\nThis game is constantly undergoing development and receiving updates to add more cosmetics, maps, and experiences.\nPlease let me know what to improve on by leaving a review and commenting on what could be better!\ud83d\ude0a\nContact Email: monkeyhavoccreator@gmail.com", "short_description": "Monkey Havoc is a 'Gorilla Tag' and 'Capuchin' fan game, made so that you and your friends can freely 
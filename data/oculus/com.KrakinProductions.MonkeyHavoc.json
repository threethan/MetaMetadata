795275_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=plKHkCfYWUYQ7kNvwFPqgJA&_nc_oc=AdrYkM6adtdLWjlD-mCM7KkN6PMVfVucpeKGWmNQ64ud1v1QUxCCTGMsC1ngukjuaSs&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4qbhOGET6Z2aYz43E3FuAOgiUQhrvX73GX6mmGhgp-yw&oe=69FDEE16"}, {"file_name": "5.png", "id": "540438542039147", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/75395590_540438545372480_7329384731897725266_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MqO9bIzHLqUQ7kNvwH4ByOL&_nc_oc=AdqdA8blIRkAARC7INz90h3_XW30t9TS6Xn9xLDIjMB3P6oKq50unccMY4VbknCRwFQ&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4Ow2eQ3feRKNW3IHV4avJj2ylfszhw5N20bk2OjhiTLw&oe=69FDE5B5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Monkey Havoc Trailer Image.png", "id": "523796653745732", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974886_523796657079065_1178915653974772965_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=02MOR5PuJkIQ7kNvwFfdDIJ&_nc_oc=AdpDZ6Y9vQdfj2o9XhGoBbP_yzSnLRFGni8a1YOnrFNzej8PXaqCLkKFz25ZRf3I-so&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af79ZuCXeGmFT7xxiy1ikJr8dAncMH6MELbqh6pFDJMmPw&oe=69FDE833"}, "display_name": "Monkey Havoc", "keywords": ["Monkey", "Fan", "Game", "Gorilla", "Capuchin"], "long_description": "Welcome to Monkey Havoc, a game based off of the popular games 'Gorilla Tag' and 'Capuchin'. In Monkey Havoc you are able to freely move around many different maps with your friends, equip different styles of cosmetics, and compete in challenges to earn special cosmetics.\nThis game is constantly undergoing development and receiving updates to add more cosmetics, maps, and experiences.\nPlease let me know what to improve on by leaving a review and commenting on what could be better!\ud83d\ude0a\nContact Email: monkeyhavoccreator@gmail.com", "short_description": "Monkey Havoc is a 'Gorilla Tag' and 'Capuchin' fan game, made so that you and your friends can freely 
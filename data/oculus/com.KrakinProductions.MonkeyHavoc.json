795275_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TmIs0bs5P-EQ7kNvwFwMhAl&_nc_oc=Adq3uI8K-oiai96ATySoU5Pcd0cm4di6hrgGUcO-IxOtzn23nKLYW3V0Hw6gQHT-0vU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afw4FbfGleZwY7a8MXUCyjtzwzBP_OyRt-IBq3uKGGkqXQ&oe=69CA8396"}, {"file_name": "5.png", "id": "540438542039147", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75395590_540438545372480_7329384731897725266_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uuaAAyahwz0Q7kNvwGa5m3_&_nc_oc=AdrvAezblmApiANIPKe8xsVVqPcMwMuYmBOx6nRE6uaSOqCh0uOFVAVXl8mUH6RXl7c&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afx_coFzoo5YREJvC3D3129-3Xhp2pwpS6jFyfyTGFqhRQ&oe=69CA7B35"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Monkey Havoc Trailer Image.png", "id": "523796653745732", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974886_523796657079065_1178915653974772965_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IMsk35votOMQ7kNvwESrTab&_nc_oc=Ado4oTOZqRpK_wfJZpsPhaRmfgAVeNAIjio3EA3TaY7y56fD2HFBF53pemeIJzFFTPM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyA_YfrnyxsfUGmp66li-WSPSrrYF8BGXOT4xMqd_ue5g&oe=69CA7DB3"}, "display_name": "Monkey Havoc", "keywords": ["Monkey", "Fan", "Game", "Gorilla", "Capuchin"], "long_description": "Welcome to Monkey Havoc, a game based off of the popular games 'Gorilla Tag' and 'Capuchin'. In Monkey Havoc you are able to freely move around many different maps with your friends, equip different styles of cosmetics, and compete in challenges to earn special cosmetics.\nThis game is constantly undergoing development and receiving updates to add more cosmetics, maps, and experiences.\nPlease let me know what to improve on by leaving a review and commenting on what could be better!\ud83d\ude0a\nContact Email: monkeyhavoccreator@gmail.com", "short_description": "Monkey Havoc is a 'Gorilla Tag' and 'Capuchin' fan game, made so that you and your friends can freely 
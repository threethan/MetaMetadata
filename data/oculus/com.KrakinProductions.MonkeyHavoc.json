795275_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4XPghTv-yR0Q7kNvwEiSW5r&_nc_oc=AdoT5ny2XCEHpntZc2x8umVsWXaKHutRt6RMAp2Gm0YwNfmo_xwacICqk5uexm4wDpo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMs1pqHkV2IY19JHUyJVdth3lO6EkA91OB1wAIQw2va-w&oe=6AD22F96"}, {"file_name": "5.png", "id": "540438542039147", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75395590_540438545372480_7329384731897725266_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_-cg1iaiZpoQ7kNvwGt2xmV&_nc_oc=AdqXgwPUfWfNjoggzwL_E3zLYHxYeEcLPrdH1GWQvHRjHYQpNJaXFvNkA2mity1-kmc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPQvZDmMYdwGTdwTt4F26WR0bTiXN8ENynY3uua00JYug&oe=6AD22735"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Monkey Havoc Trailer Image.png", "id": "523796653745732", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974886_523796657079065_1178915653974772965_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xXWwWfD2KxoQ7kNvwGWs47u&_nc_oc=AdoF2rmjqxDJmKKVXC3MDPn_6fn2Oa9yhHjgHVXtie-BpJvCg-zNn-SzWHbcHh7XCaA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPQEfGoFKpFovsmFm49NXUB5ZVYAl1fQfeMVwb9NcD2SA&oe=6AD229B3"}, "display_name": "Monkey Havoc", "keywords": ["Monkey", "Fan", "Game", "Gorilla", "Capuchin"], "long_description": "Welcome to Monkey Havoc, a game based off of the popular games 'Gorilla Tag' and 'Capuchin'. In Monkey Havoc you are able to freely move around many different maps with your friends, equip different styles of cosmetics, and compete in challenges to earn special cosmetics.\nThis game is constantly undergoing development and receiving updates to add more cosmetics, maps, and experiences.\nPlease let me know what to improve on by leaving a review and commenting on what could be better!\ud83d\ude0a\nContact Email: monkeyhavoccreator@gmail.com", "short_description": "Monkey Havoc is a 'Gorilla Tag' and 'Capuchin' fan game, made so that you and your friends can freely 
795275_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8CafioYmf-cQ7kNvwE-7EWB&_nc_oc=Adp-4gy6cK8sr86ECS097n2eqCLfiDMmnZi2nkIy_M8wSoaPcW4wOoDI_7_SN7PUH7Q&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9Syrpebi-H9WLNa1RsSndTlA-e7GHuqgMwWOPLjzsqxg&oe=6A257B16"}, {"file_name": "5.png", "id": "540438542039147", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75395590_540438545372480_7329384731897725266_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wHtkPugO_zEQ7kNvwFM3e84&_nc_oc=AdquP_hSF_i-cM5JehqusHi1pvG7TC5KEoFtqxGcigJmZuHqek_1-uaMvRSroKWU2H4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9aHYDVw0bZ8VjuxFOuNmr3KIkl68QykTcWZzpZUZWQZQ&oe=6A2572B5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Monkey Havoc Trailer Image.png", "id": "523796653745732", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974886_523796657079065_1178915653974772965_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hIV2hUN7gOIQ7kNvwFv3q1R&_nc_oc=AdpK8us2nFcxfAywGJHhNOEY3uvEdGeMqfusxs7mfS7G5uCKjaXg_DmYg3kajZFwY00&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9i2_NYn5SBOlOrMmOqBdUeFkzbRl8Dszp0o_emxTx3lg&oe=6A257533"}, "display_name": "Monkey Havoc", "keywords": ["Monkey", "Fan", "Game", "Gorilla", "Capuchin"], "long_description": "Welcome to Monkey Havoc, a game based off of the popular games 'Gorilla Tag' and 'Capuchin'. In Monkey Havoc you are able to freely move around many different maps with your friends, equip different styles of cosmetics, and compete in challenges to earn special cosmetics.\nThis game is constantly undergoing development and receiving updates to add more cosmetics, maps, and experiences.\nPlease let me know what to improve on by leaving a review and commenting on what could be better!\ud83d\ude0a\nContact Email: monkeyhavoccreator@gmail.com", "short_description": "Monkey Havoc is a 'Gorilla Tag' and 'Capuchin' fan game, made so that you and your friends can freely 
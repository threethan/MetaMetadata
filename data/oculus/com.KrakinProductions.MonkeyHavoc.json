795275_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BIb5kWmNjDEQ7kNvwFj22QJ&_nc_oc=AdoviRdAhx_0SZPGA0IMgDTa2lCYOFpo4IblyiXS2OlPsSpEbQ0IYUCqZ_1z86_6-CU&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfysrnVkluXMocZflRalenUSORnbd1ZeZ8oDy-3ae9k--Q&oe=69C3EC16"}, {"file_name": "5.png", "id": "540438542039147", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75395590_540438545372480_7329384731897725266_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rpIOteHO_9QQ7kNvwHSKUbN&_nc_oc=AdrAqin60rRMwbndNO9jp_C4LMILTgmB2lYB89RzsZAF-77oF0P0HiuvNpXjLnKgdhg&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwaX_lLRx3wi9kQlaF1uVoRtieI-Xchnw0jjmVqlY6wkQ&oe=69C3E3B5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Monkey Havoc Trailer Image.png", "id": "523796653745732", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974886_523796657079065_1178915653974772965_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nVmNcm4UAZcQ7kNvwHRoZLi&_nc_oc=AdqBYa0uwGDTen-lpi4JsZ1bkaP7Hb8PXGbv_-ksubLxNwy9ZBz05JONKEV8NRc6UYw&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwLWsvBWWLkFe93qgpaKutl_n1EdfN1Lj6OdKhoL_X78Q&oe=69C3E633"}, "display_name": "Monkey Havoc", "keywords": ["Monkey", "Fan", "Game", "Gorilla", "Capuchin"], "long_description": "Welcome to Monkey Havoc, a game based off of the popular games 'Gorilla Tag' and 'Capuchin'. In Monkey Havoc you are able to freely move around many different maps with your friends, equip different styles of cosmetics, and compete in challenges to earn special cosmetics.\nThis game is constantly undergoing development and receiving updates to add more cosmetics, maps, and experiences.\nPlease let me know what to improve on by leaving a review and commenting on what could be better!\ud83d\ude0a\nContact Email: monkeyhavoccreator@gmail.com", "short_description": "Monkey Havoc is a 'Gorilla Tag' and 'Capuchin' fan game, made so that you and your friends can freely 
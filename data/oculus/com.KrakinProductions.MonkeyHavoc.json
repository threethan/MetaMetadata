795275_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W8cmmgwl3ZcQ7kNvwG7u-th&_nc_oc=AdqdKholJKogYpnywvpY_UWkhZbCiN9XsTMBkh1Pmvl1J98GP_SNvz_tE6Af7V_tixU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM68hnupfy15o_SroMbyh6vXdqpzhj7Q22xb1Kcz_wlag&oe=6AE4A496"}, {"file_name": "5.png", "id": "540438542039147", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75395590_540438545372480_7329384731897725266_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zwnNX7o6SDsQ7kNvwEC1ZX7&_nc_oc=AdpA0It226ZfPvvq5ykiYUKKiVK4lsiXBnnMV9pG6wD96TcMgsM-JfhIp95ETS7oCP8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPdfLUIiRA00KEfuS3B6ZJKWuwikhwWufl9PgmlrLhe9Q&oe=6AE49C35"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Monkey Havoc Trailer Image.png", "id": "523796653745732", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974886_523796657079065_1178915653974772965_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F-FhJYkTaDMQ7kNvwG9_BJc&_nc_oc=AdpTgyOWMpgh88J10dHyHwkmqV70m40dQlp2beb952iGpWid5tbnngZw9YYB_ukaMws&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMNvqiu_y-dB_uBdp8iHOv-gz1slxv6Yp58TLwjIGJksw&oe=6AE49EB3"}, "display_name": "Monkey Havoc", "keywords": ["Monkey", "Fan", "Game", "Gorilla", "Capuchin"], "long_description": "Welcome to Monkey Havoc, a game based off of the popular games 'Gorilla Tag' and 'Capuchin'. In Monkey Havoc you are able to freely move around many different maps with your friends, equip different styles of cosmetics, and compete in challenges to earn special cosmetics.\nThis game is constantly undergoing development and receiving updates to add more cosmetics, maps, and experiences.\nPlease let me know what to improve on by leaving a review and commenting on what could be better!\ud83d\ude0a\nContact Email: monkeyhavoccreator@gmail.com", "short_description": "Monkey Havoc is a 'Gorilla Tag' and 'Capuchin' fan game, made so that you and your friends can freely 
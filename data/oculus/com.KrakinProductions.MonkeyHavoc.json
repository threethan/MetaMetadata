795275_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S4-bB2tj_EMQ7kNvwH26ofC&_nc_oc=AdpU2mVd7c3WW2ktiZS_1FXEbzgH9cZdq26h77tdiXuDbNPvsoFtLGJ9eNJVCrjF3sc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5tfOCy_RCxxpuP2rPau3juzxWHsvsnzK5eH7VTr8N74Q&oe=6A145796"}, {"file_name": "5.png", "id": "540438542039147", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75395590_540438545372480_7329384731897725266_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rAo5NhwFvxkQ7kNvwGCdjHi&_nc_oc=AdrugCi8sxE_uGOflid_JEa8MNW0zqhZa4XSTovheSsuRUgi4ozqafFOyC1oIYNNTtk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5M6_NF2-SztuQwr2wyG4bKpiZJvIBiFYgONgdjS5Ti_g&oe=6A144F35"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Monkey Havoc Trailer Image.png", "id": "523796653745732", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974886_523796657079065_1178915653974772965_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KxNh0K1H3goQ7kNvwENliQp&_nc_oc=AdpMr0Yr6VBIU3rUo09b0yna6P5w8fqZR57vfSt6RB9CjRtjR925uzp4XutG5oUbDl4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7ykQo5vpwNM50StRMmG0PZ3ye-o1D2yHkAl9lbsivNDg&oe=6A1451B3"}, "display_name": "Monkey Havoc", "keywords": ["Monkey", "Fan", "Game", "Gorilla", "Capuchin"], "long_description": "Welcome to Monkey Havoc, a game based off of the popular games 'Gorilla Tag' and 'Capuchin'. In Monkey Havoc you are able to freely move around many different maps with your friends, equip different styles of cosmetics, and compete in challenges to earn special cosmetics.\nThis game is constantly undergoing development and receiving updates to add more cosmetics, maps, and experiences.\nPlease let me know what to improve on by leaving a review and commenting on what could be better!\ud83d\ude0a\nContact Email: monkeyhavoccreator@gmail.com", "short_description": "Monkey Havoc is a 'Gorilla Tag' and 'Capuchin' fan game, made so that you and your friends can freely 
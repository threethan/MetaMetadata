795275_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=43AF955MetcQ7kNvwEcwqTg&_nc_oc=AdqlkTM_dFGrIid_GtATN9Zb2DVW9SZL8-1HoK4G5fcxUdSSLsNILmmvndb6Z4wGqko&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4ZGDwzU6S2j1kN08OTHnw56Yd4exQrnT5uZaP7geivdA&oe=6A1C4096"}, {"file_name": "5.png", "id": "540438542039147", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/75395590_540438545372480_7329384731897725266_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k1Lqa9byczIQ7kNvwEWezE3&_nc_oc=Adq_MsQTJNkw7plAWY9lTCIWlDGq58RJwzsPUcxjJKgnvjSjHdBqA2S2E8dAUtE1JsI&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7jEcmMx1Zm5CxiobVwGcc4i-yz73LNnzDzr15zPLMSsA&oe=6A1C3835"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Monkey Havoc Trailer Image.png", "id": "523796653745732", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38974886_523796657079065_1178915653974772965_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Hgg5T93mGF4Q7kNvwEMNXZM&_nc_oc=AdrYRgvM8zf3bVDDFpdqRoFQ3PLxjxcMoCn66Hi2AIViPqJvqWsEGezm3Rk5VtdnEsc&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4BgPeWwfu_eHcz9_Byl_NOst3gAsP0STACjgoxGM45eA&oe=6A1C3AB3"}, "display_name": "Monkey Havoc", "keywords": ["Monkey", "Fan", "Game", "Gorilla", "Capuchin"], "long_description": "Welcome to Monkey Havoc, a game based off of the popular games 'Gorilla Tag' and 'Capuchin'. In Monkey Havoc you are able to freely move around many different maps with your friends, equip different styles of cosmetics, and compete in challenges to earn special cosmetics.\nThis game is constantly undergoing development and receiving updates to add more cosmetics, maps, and experiences.\nPlease let me know what to improve on by leaving a review and commenting on what could be better!\ud83d\ude0a\nContact Email: monkeyhavoccreator@gmail.com", "short_description": "Monkey Havoc is a 'Gorilla Tag' and 'Capuchin' fan game, made so that you and your friends can freely 
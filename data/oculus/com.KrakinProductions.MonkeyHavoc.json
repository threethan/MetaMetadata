795275_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nnxVWrdhBeEQ7kNvwHKVaS_&_nc_oc=Adoy_eRVoIbLW-sOUq8nNlmRE44mkktKhwQuSbkd_-bhK1q3CgCwP8__IhLPlXtW4zw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIoP7q9nys6PfEUqeZCTqYggQIVLku6rNh4eAwDgGBq9Q&oe=6AB28B96"}, {"file_name": "5.png", "id": "540438542039147", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75395590_540438545372480_7329384731897725266_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dGNcR5ObUEIQ7kNvwEA4hHy&_nc_oc=AdrK0gVAT8RTMiqgBVdDi7qpOK3p1ua034Iq_wv4gNXSTHiJuX1xtNBGIwIaMWaMxlQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ01dk4xJsyMPeHu-3IwaadDO7F5eYRcMfaHiZaZNsDSw&oe=6AB28335"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Monkey Havoc Trailer Image.png", "id": "523796653745732", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974886_523796657079065_1178915653974772965_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NduecmUnw7YQ7kNvwHcHTU-&_nc_oc=AdrtmnyRdJsdkSVfq1op3D9hbn9wYqG9FOBdavEVda9JDrjkm1T4eUPCiJF6A1c2HVM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLobOY59v36rYwM5UAsowPK88f4oQecSkCrS4FzbszUPw&oe=6AB285B3"}, "display_name": "Monkey Havoc", "keywords": ["Monkey", "Fan", "Game", "Gorilla", "Capuchin"], "long_description": "Welcome to Monkey Havoc, a game based off of the popular games 'Gorilla Tag' and 'Capuchin'. In Monkey Havoc you are able to freely move around many different maps with your friends, equip different styles of cosmetics, and compete in challenges to earn special cosmetics.\nThis game is constantly undergoing development and receiving updates to add more cosmetics, maps, and experiences.\nPlease let me know what to improve on by leaving a review and commenting on what could be better!\ud83d\ude0a\nContact Email: monkeyhavoccreator@gmail.com", "short_description": "Monkey Havoc is a 'Gorilla Tag' and 'Capuchin' fan game, made so that you and your friends can freely 
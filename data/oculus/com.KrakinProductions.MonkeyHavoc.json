795275_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9J_aWFUyfMkQ7kNvwF4rEaV&_nc_oc=AdrGq-6FqwrE-_2F4IAqgAQEY22K2ItYag3DMRppvQn9qBrgaJDCBzDfu7W-gPhN3YM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRpLmeJ_tclZb9I-25TMnYLkiH9aXTQyWBIbpr7Tr1AtA&oe=6AEB3C16"}, {"file_name": "5.png", "id": "540438542039147", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75395590_540438545372480_7329384731897725266_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V9L0Bu4fQ5UQ7kNvwF8Rc_Q&_nc_oc=AdraO83O4U9QxBvblvcvbGQNnfuCJu49ZH2-SSdGm2M8PD9vYB9B00PNNVM_GBp6j4E&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQbm6XB_hlyo5QuEyzxT8yewHem6y2NYAYpavo9VANFmg&oe=6AEB33B5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Monkey Havoc Trailer Image.png", "id": "523796653745732", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974886_523796657079065_1178915653974772965_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=deP0BiAbkHYQ7kNvwFtn4oH&_nc_oc=AdoSXw-7BTln0h9eUg_URwGzt5CamWiTxIJHCwPtfQMdiSeq_dNYHPgO9Km2EWlvOHA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSt1yaj2RNFeA0lTIFZMpl3wtegSaHEyH4Inxzb4VtgbQ&oe=6AEB3633"}, "display_name": "Monkey Havoc", "keywords": ["Monkey", "Fan", "Game", "Gorilla", "Capuchin"], "long_description": "Welcome to Monkey Havoc, a game based off of the popular games 'Gorilla Tag' and 'Capuchin'. In Monkey Havoc you are able to freely move around many different maps with your friends, equip different styles of cosmetics, and compete in challenges to earn special cosmetics.\nThis game is constantly undergoing development and receiving updates to add more cosmetics, maps, and experiences.\nPlease let me know what to improve on by leaving a review and commenting on what could be better!\ud83d\ude0a\nContact Email: monkeyhavoccreator@gmail.com", "short_description": "Monkey Havoc is a 'Gorilla Tag' and 'Capuchin' fan game, made so that you and your friends can freely 
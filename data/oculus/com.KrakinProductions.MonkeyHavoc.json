795275_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Qi6j8exKydYQ7kNvwFGROCm&_nc_oc=AdqzBD2qLzMpBOaK3VmIj8d2eTN06rbj5p2GnIr4L72swNzUHpCzss8J8R9KeNRlIVM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3I33OYYGBKJq6UgFu21RG7sYyOUNXvrhUawpADkUlVmw&oe=69D66116"}, {"file_name": "5.png", "id": "540438542039147", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75395590_540438545372480_7329384731897725266_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2_iGNg4q8vsQ7kNvwEETG_S&_nc_oc=AdpcUzWdbdSlWJNLEyEFqZR9yMzhVoBnJNfxq9GiQSmJjzhZowPyZu1kqIChStJPEVo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2Xs-dgFF8i0K5XfcwUT9IqmoA64RwuXPKOjndLLKTEmw&oe=69D658B5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Monkey Havoc Trailer Image.png", "id": "523796653745732", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974886_523796657079065_1178915653974772965_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oXNFIkfjchgQ7kNvwH5SUM7&_nc_oc=AdodoGMmlfVCLVjZaqU9l6CFLCstZAM_zTMXGimWtpsFPtEvQGJwUxhRpWUwg2hb_2I&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1d2QjlhaWWIIYMQn_rR6FiFToHp2DM5Tv3U-W6ljV88w&oe=69D65B33"}, "display_name": "Monkey Havoc", "keywords": ["Monkey", "Fan", "Game", "Gorilla", "Capuchin"], "long_description": "Welcome to Monkey Havoc, a game based off of the popular games 'Gorilla Tag' and 'Capuchin'. In Monkey Havoc you are able to freely move around many different maps with your friends, equip different styles of cosmetics, and compete in challenges to earn special cosmetics.\nThis game is constantly undergoing development and receiving updates to add more cosmetics, maps, and experiences.\nPlease let me know what to improve on by leaving a review and commenting on what could be better!\ud83d\ude0a\nContact Email: monkeyhavoccreator@gmail.com", "short_description": "Monkey Havoc is a 'Gorilla Tag' and 'Capuchin' fan game, made so that you and your friends can freely 
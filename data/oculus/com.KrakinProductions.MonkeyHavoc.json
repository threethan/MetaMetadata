9_1766831023204795275_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QqKyUtvErNQQ7kNvwFkwhCa&_nc_oc=AdrRQx5QDci4VlwiJugg_0xcvxTP0YsdpLe4GFBo6b02Uid2crVmTNxunTccSb5OjGs&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_LfPFZgDVhKcVxt0TTA2fzrlLs0aSnleRFzkAXRKTt0w&oe=6A369E96"}, {"file_name": "5.png", "id": "540438542039147", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/75395590_540438545372480_7329384731897725266_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xNMeMgSYHyUQ7kNvwFVCch6&_nc_oc=AdokeJk7BbeHQ8jyYywMSoaLyrp_wFgoGwgSaBinzxE0Q7hHjCqAA04TQKnL8_qZySk&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-NpvSDEAWIBIio5p4aqpwiw440Ux_2rUacQ0-G_u305Q&oe=6A369635"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Monkey Havoc Trailer Image.png", "id": "523796653745732", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/38974886_523796657079065_1178915653974772965_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eGIPZZUwUkIQ7kNvwEQwLRV&_nc_oc=Adrnu_OSp1AIaF3swsKgLA411OXM1tnQ1AlWBc0VRBzr0HtuqzfYtXGcNAZT4u6v8tQ&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af85llAV6_mpK72WxNdXGTcAXLlvErCj22igKcpRlEdhDg&oe=6A3698B3"}, "display_name": "Monkey Havoc", "keywords": ["Monkey", "Fan", "Game", "Gorilla", "Capuchin"], "long_description": "Welcome to Monkey Havoc, a game based off of the popular games 'Gorilla Tag' and 'Capuchin'. In Monkey Havoc you are able to freely move around many different maps with your friends, equip different styles of cosmetics, and compete in challenges to earn special cosmetics.\nThis game is constantly undergoing development and receiving updates to add more cosmetics, maps, and experiences.\nPlease let me know what to improve on by leaving a review and commenting on what could be better!\ud83d\ude0a\nContact Email: monkeyhavoccreator@gmail.com", "short_description": "Monkey Havoc is a 'Gorilla Tag' and 'Capuchin' fan game, made so that you and your
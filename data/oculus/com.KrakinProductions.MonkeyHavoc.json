795275_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6EyEekbrIuYQ7kNvwE4ZApK&_nc_oc=AdpA8L2AXBffx8o4GDYPY5IYiRIEMcUumWyQNFA4vkQugsJTTqZCN0HLUgmW6GmW6lY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af01mqf8UnaRbhPPw9A2mF0waLVQCFxQAegqSQnzbJS_Yw&oe=69F75696"}, {"file_name": "5.png", "id": "540438542039147", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75395590_540438545372480_7329384731897725266_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q0J_TEiC9PgQ7kNvwGStI2h&_nc_oc=Ado0t4SgoZbuzk3WiOw7fdHmzqwMRBxtcLMqFvRsGoxIQT2qX4LjOCx6qR7CHw6kOTU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0pw7a23_AA7WN6BsBGzP9tW-421cZHZwudiKoDxz4xIA&oe=69F74E35"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Monkey Havoc Trailer Image.png", "id": "523796653745732", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974886_523796657079065_1178915653974772965_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JCmnWZ6hfzgQ7kNvwEqYUbv&_nc_oc=Adr597xmvzMlgRyS9eLEU6Yo15wGGobLt1gqDkPKJipBXxn5ybiRLd-sffWcLXEQmpw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af26e-AZb3nceZisa5nLIE70ykrmAQJTnF2149c0WYaCdw&oe=69F750B3"}, "display_name": "Monkey Havoc", "keywords": ["Monkey", "Fan", "Game", "Gorilla", "Capuchin"], "long_description": "Welcome to Monkey Havoc, a game based off of the popular games 'Gorilla Tag' and 'Capuchin'. In Monkey Havoc you are able to freely move around many different maps with your friends, equip different styles of cosmetics, and compete in challenges to earn special cosmetics.\nThis game is constantly undergoing development and receiving updates to add more cosmetics, maps, and experiences.\nPlease let me know what to improve on by leaving a review and commenting on what could be better!\ud83d\ude0a\nContact Email: monkeyhavoccreator@gmail.com", "short_description": "Monkey Havoc is a 'Gorilla Tag' and 'Capuchin' fan game, made so that you and your friends can freely 
795275_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1oHcS74pV20Q7kNvwGwXGVe&_nc_oc=Adr4KCyZppAiqUChy3GiuazN6UBDnGEbYXiVubcVvu-RoOrWa__bGMfIBYwcm3SrCWY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2q6WVyjNHflm-R6gVF4F4FZdPPrtIorEi7q27KvUa8Zw&oe=69EA2796"}, {"file_name": "5.png", "id": "540438542039147", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75395590_540438545372480_7329384731897725266_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Zy-2WZWR3fsQ7kNvwE9nyPa&_nc_oc=Adrw7MREyfn61FWegExlZEZWQwFpo-pDxeQFGz-jmGzrbKBIkicqbHMgnI-Bb68zfY4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3bVronmjwDBgkV1yD14DBU-gPNtdAlQ0oJqxjBcdBpNw&oe=69EA1F35"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Monkey Havoc Trailer Image.png", "id": "523796653745732", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974886_523796657079065_1178915653974772965_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3FMY-Yn_8SoQ7kNvwFnOR9b&_nc_oc=Adr24-_cyJjIAMp_ehx_2PPOVFF3S2yQcY8kFgIZMA3GycEDjLTTDsM01h4XqSFMb64&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3Y2Cx1kpA0K_Hgf06JBaeFrQnAl6cQ1XjYeUy84pf0Mg&oe=69EA21B3"}, "display_name": "Monkey Havoc", "keywords": ["Monkey", "Fan", "Game", "Gorilla", "Capuchin"], "long_description": "Welcome to Monkey Havoc, a game based off of the popular games 'Gorilla Tag' and 'Capuchin'. In Monkey Havoc you are able to freely move around many different maps with your friends, equip different styles of cosmetics, and compete in challenges to earn special cosmetics.\nThis game is constantly undergoing development and receiving updates to add more cosmetics, maps, and experiences.\nPlease let me know what to improve on by leaving a review and commenting on what could be better!\ud83d\ude0a\nContact Email: monkeyhavoccreator@gmail.com", "short_description": "Monkey Havoc is a 'Gorilla Tag' and 'Capuchin' fan game, made so that you and your friends can freely 
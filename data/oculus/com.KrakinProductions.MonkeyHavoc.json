795275_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5xtlX6Dru6YQ7kNvwGe7ERN&_nc_oc=AdqgzTadzupcRxVgq-NxtOiuQbntM7p63Bnl7u4IrmlaDARuGhj65x_4UpypF6XYP6o&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3p5H4YaPV5JtXKw-3UJzGGuDxl5BkwteQDq5SUWyxxmA&oe=69E63316"}, {"file_name": "5.png", "id": "540438542039147", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/75395590_540438545372480_7329384731897725266_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bjzNtRSBfWAQ7kNvwG_Fxy8&_nc_oc=AdqdsGgu3z4D33lDjqi7lmdsjJIfh9EWhBiUY-eMe-wfIBNAGtOMAF2M8F-2wVxk_80&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3M9AoQs0zHNzdGfbQCPU0CA1a1AVc9Ima0annnXpO15g&oe=69E62AB5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Monkey Havoc Trailer Image.png", "id": "523796653745732", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974886_523796657079065_1178915653974772965_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HnhP-voeXlsQ7kNvwH8Dent&_nc_oc=Adp6GqqoXgbx0OvfboOf_Ey5NBn2DY44c9iXxDG7J1FZoNFLHCCpThQA6rLFlNTyGZs&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af09jbIqWcHgTukjswFQJn4JmXMt6tBlYoMGij4fpH7gbw&oe=69E62D33"}, "display_name": "Monkey Havoc", "keywords": ["Monkey", "Fan", "Game", "Gorilla", "Capuchin"], "long_description": "Welcome to Monkey Havoc, a game based off of the popular games 'Gorilla Tag' and 'Capuchin'. In Monkey Havoc you are able to freely move around many different maps with your friends, equip different styles of cosmetics, and compete in challenges to earn special cosmetics.\nThis game is constantly undergoing development and receiving updates to add more cosmetics, maps, and experiences.\nPlease let me know what to improve on by leaving a review and commenting on what could be better!\ud83d\ude0a\nContact Email: monkeyhavoccreator@gmail.com", "short_description": "Monkey Havoc is a 'Gorilla Tag' and 'Capuchin' fan game, made so that you and your friends can freely 
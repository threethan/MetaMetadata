795275_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZYeja5LxiZQQ7kNvwG6GLvO&_nc_oc=AdpvAg0bfvtlGJUvKcOb_SQsQV0Wq4EoVgy3tYezYizpbOYqgqX2IE2S0K5olo6aJcE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af07hxjWFsRuw3ySjFIszAz05IKmITlkwP2BgWp4RGHU-w&oe=69DE4A16"}, {"file_name": "5.png", "id": "540438542039147", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75395590_540438545372480_7329384731897725266_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Gfr091vgn3AQ7kNvwGZjW2X&_nc_oc=Adqj5aOlHyMX9q-9MwjzvBGUyoE6PQ5MZ3Y1VUd0QcWOpt3bmacsd_Pf8j2dBGMHbvo&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0UimPgx46qhjimlRdVi1ONjCt7dKgCEkxPICf8VHMLLg&oe=69DE41B5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Monkey Havoc Trailer Image.png", "id": "523796653745732", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974886_523796657079065_1178915653974772965_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XCHJ3ZQf22YQ7kNvwGiey2N&_nc_oc=Adq_wW-wLu6JZ-FqR94q0DXPcSszUT9Ua3f4CfHoFbiaudB-FVieK6oPgWw9fFmEfDs&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0jISA-OHzrlr_rVE2l3lDbZnHoVSaepenU6PB9LUfeEg&oe=69DE4433"}, "display_name": "Monkey Havoc", "keywords": ["Monkey", "Fan", "Game", "Gorilla", "Capuchin"], "long_description": "Welcome to Monkey Havoc, a game based off of the popular games 'Gorilla Tag' and 'Capuchin'. In Monkey Havoc you are able to freely move around many different maps with your friends, equip different styles of cosmetics, and compete in challenges to earn special cosmetics.\nThis game is constantly undergoing development and receiving updates to add more cosmetics, maps, and experiences.\nPlease let me know what to improve on by leaving a review and commenting on what could be better!\ud83d\ude0a\nContact Email: monkeyhavoccreator@gmail.com", "short_description": "Monkey Havoc is a 'Gorilla Tag' and 'Capuchin' fan game, made so that you and your friends can freely 
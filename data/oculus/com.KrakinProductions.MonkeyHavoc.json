795275_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3hqTqrHJjaAQ7kNvwHqdVVx&_nc_oc=Ado_MojEsuV4r0AJ_4h_TqSZKGgOLl5e52ojBZWVvaUmimCXBcaM_FPeb8BTDZyXD1Q&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPcEgIEhLXswIHk7lTf-LxCySAmxwsmxnHhBRa1IbrWfg&oe=6AC50096"}, {"file_name": "5.png", "id": "540438542039147", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/75395590_540438545372480_7329384731897725266_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dvf9OoIpHMQQ7kNvwGby3sd&_nc_oc=AdqUb06SYnBIOhgbGSAA0-RdObqkK_8dIy9vXcijT4w-5pBplMIzgT3nvAaY15P9Pb0&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPc6AFn-td3ceXbHwtAQ5R0KfI1WBVwzVfcs5nFvzTlSA&oe=6AC4F835"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Monkey Havoc Trailer Image.png", "id": "523796653745732", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38974886_523796657079065_1178915653974772965_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rtngvOORzbAQ7kNvwFHVN0p&_nc_oc=Adp8NIxFZErm57vHBkqxPYN55rQD529rkS8BSY1S38TDXUrtbejZy1qIwiXBzvOUYgo&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOkq8apBK4R7s28Vl91zaNdNIPzE6yuOH8_omBaXCX9PQ&oe=6AC4FAB3"}, "display_name": "Monkey Havoc", "keywords": ["Monkey", "Fan", "Game", "Gorilla", "Capuchin"], "long_description": "Welcome to Monkey Havoc, a game based off of the popular games 'Gorilla Tag' and 'Capuchin'. In Monkey Havoc you are able to freely move around many different maps with your friends, equip different styles of cosmetics, and compete in challenges to earn special cosmetics.\nThis game is constantly undergoing development and receiving updates to add more cosmetics, maps, and experiences.\nPlease let me know what to improve on by leaving a review and commenting on what could be better!\ud83d\ude0a\nContact Email: monkeyhavoccreator@gmail.com", "short_description": "Monkey Havoc is a 'Gorilla Tag' and 'Capuchin' fan game, made so that you and your friends can freely 
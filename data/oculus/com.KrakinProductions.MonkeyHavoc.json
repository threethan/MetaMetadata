795275_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nnxVWrdhBeEQ7kNvwHFv8cI&_nc_oc=AdpHERrPzDSeL4Xzd2wxuAmBVL3UmaCMpS36sEopRIFTozPrrGvdTIVNkaJ-gCjL2mU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIf73PBh64SLCYBcuQ51jHXJdjldKlelHbSHpZn4jW0HA&oe=6AB13A16"}, {"file_name": "5.png", "id": "540438542039147", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75395590_540438545372480_7329384731897725266_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dGNcR5ObUEIQ7kNvwH1IV8f&_nc_oc=Ado-uUT-WsXlBLKBz6lfIMeOdow5mu4CxAEMSXR5nvicaZ_lK179mzILE8wU8u6RnIc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKa9ZuGgDOtWY8A5H2ncrfZ5vB3KBNqRzXj8sh1TR3Dgg&oe=6AB131B5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Monkey Havoc Trailer Image.png", "id": "523796653745732", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974886_523796657079065_1178915653974772965_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NduecmUnw7YQ7kNvwF6J8R8&_nc_oc=AdpSgn07Zq9m_OGa3gNq-rqGFiPgeNEQ1_qMT8HNkZZa3qmTJSZZApqCN_23AZBeMW4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKVVAXmTcioVpWqJV9OkBjO5l4JlIjUM0EpY_JL2Z3Llw&oe=6AB13433"}, "display_name": "Monkey Havoc", "keywords": ["Monkey", "Fan", "Game", "Gorilla", "Capuchin"], "long_description": "Welcome to Monkey Havoc, a game based off of the popular games 'Gorilla Tag' and 'Capuchin'. In Monkey Havoc you are able to freely move around many different maps with your friends, equip different styles of cosmetics, and compete in challenges to earn special cosmetics.\nThis game is constantly undergoing development and receiving updates to add more cosmetics, maps, and experiences.\nPlease let me know what to improve on by leaving a review and commenting on what could be better!\ud83d\ude0a\nContact Email: monkeyhavoccreator@gmail.com", "short_description": "Monkey Havoc is a 'Gorilla Tag' and 'Capuchin' fan game, made so that you and your friends can freely 
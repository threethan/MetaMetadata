1129_1766831023204795275_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z6lQvrGvIlcQ7kNvwErcySp&_nc_oc=AdqTLF7JF7PdleW6nEpIXaSy7zwgqHIVHmckqeJaBKF_W3LFqyTlIWUYfInA36t-lAs&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFZmrWkPAoBZB4tTuUoNiUK32_XtvB5SXBJb0mE2gmi0g&oe=6A8D6956"}, {"file_name": "5.png", "id": "540438542039147", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/75395590_540438545372480_7329384731897725266_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tikv2SNHMHQQ7kNvwFm3YDY&_nc_oc=AdrSMxC8ooQw6DcfUjs4ypttP6nZAH15IOmLf2VBWMlRxbtkakBUxJYhvZAd0fYqRYs&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFCdrDppdiFpb5-1MT6ajqa_fUC6mh4DWBegjgGkq3ZBg&oe=6A8D9935"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Monkey Havoc Trailer Image.png", "id": "523796653745732", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/38974886_523796657079065_1178915653974772965_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AtKNDvR302EQ7kNvwHM3tC2&_nc_oc=Adp3pD3TFAsVGiOMdTWP3hQSNzRqo-0sW5UKXFWymmyjhDgwCDqPY2HK9uDKl1_hbys&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGvoqp-Gobvlc7Xgd0vJXwLsgkC95ALcgt5rYDWObW60g&oe=6A8D9BB3"}, "display_name": "Monkey Havoc", "keywords": ["Monkey", "Fan", "Game", "Gorilla", "Capuchin"], "long_description": "Welcome to Monkey Havoc, a game based off of the popular games 'Gorilla Tag' and 'Capuchin'. In Monkey Havoc you are able to freely move around many different maps with your friends, equip different styles of cosmetics, and compete in challenges to earn special cosmetics.\nThis game is constantly undergoing development and receiving updates to add more cosmetics, maps, and experiences.\nPlease let me know what to improve on by leaving a review and commenting on what could be better!\ud83d\ude0a\nContact Email: monkeyhavoccreator@gmail.com", "short_description": "Monkey Havoc is a 'Gorilla Tag' and 'Capuchin' fan game, made so that you and yo
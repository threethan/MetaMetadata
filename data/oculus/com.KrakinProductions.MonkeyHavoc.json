795275_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HFnwCX4wQIoQ7kNvwE2Natx&_nc_oc=Adr3pJIGWrTS08Z_7hL3A19JcKkOyrTttMxl6b6JSPm9knbs1vZemBHjZsz0m6QDyVs&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRzyCKGI49jBHxJPiguPU_iMBvfKwjhNet8MMP-6uSHGg&oe=6AE9EA96"}, {"file_name": "5.png", "id": "540438542039147", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75395590_540438545372480_7329384731897725266_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V9L0Bu4fQ5UQ7kNvwH9PUfv&_nc_oc=AdodZPSREDisKelCmg1ggNfjyNNPMmbPRSoL0yUD6kEZ_ZojId1WtCE3ByfFodU9nMI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR_Lw-jPcNK7vQnBeGXWbXV1nNEJEucCeD7fcFRtHLV4A&oe=6AE9E235"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Monkey Havoc Trailer Image.png", "id": "523796653745732", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974886_523796657079065_1178915653974772965_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H5vHfxmeOZkQ7kNvwHdcmSM&_nc_oc=AdpLj-eMI1Vk2T_P-t0n2VB15oZpwRMPjccIBPVUQ6-k47_E_gb2TDGmR57BS2WKHqE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT-UmBqMGQsDZZRAnaWP9n4I8QGFzQwZ_iGxvqVbiMKPg&oe=6AE9E4B3"}, "display_name": "Monkey Havoc", "keywords": ["Monkey", "Fan", "Game", "Gorilla", "Capuchin"], "long_description": "Welcome to Monkey Havoc, a game based off of the popular games 'Gorilla Tag' and 'Capuchin'. In Monkey Havoc you are able to freely move around many different maps with your friends, equip different styles of cosmetics, and compete in challenges to earn special cosmetics.\nThis game is constantly undergoing development and receiving updates to add more cosmetics, maps, and experiences.\nPlease let me know what to improve on by leaving a review and commenting on what could be better!\ud83d\ude0a\nContact Email: monkeyhavoccreator@gmail.com", "short_description": "Monkey Havoc is a 'Gorilla Tag' and 'Capuchin' fan game, made so that you and your friends can freely 
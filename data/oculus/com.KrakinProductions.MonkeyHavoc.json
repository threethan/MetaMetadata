795275_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L-TtM2v8gI4Q7kNvwHii2rQ&_nc_oc=AdppsVFGErYTrTkcD1jXlCimTo01NJ7bWtITrSkTv1N3B4qwXRuWp-JMppUZn60LAnM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJGAXfBDGI4RfxeXzOzN_8x6Z8h7Qu0VIRRHAUpu2OXEw&oe=6A9C2216"}, {"file_name": "5.png", "id": "540438542039147", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75395590_540438545372480_7329384731897725266_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ug5oXZMgqEcQ7kNvwEx-2T9&_nc_oc=AdqVsp91n2pIUaEgAbQAqj1IyUNfsg78HPHptGj_EBA7trnH3I1Db0BhV2BeJJlGEfk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQInmlH-bKeyPUtTrAwdxhL2CqZmk7tQWHXm78YEdCGW7Q&oe=6A9C19B5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Monkey Havoc Trailer Image.png", "id": "523796653745732", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974886_523796657079065_1178915653974772965_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nFewmkZFRnwQ7kNvwFjWimG&_nc_oc=AdrJJhj_Mh9Rcmn4ZrcD7mNy7xnINyh1yebDoq0VVnJoGFkMpPoLPCPr71bVqYlKFcM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL6k3z0SktxwzamZM8E4hS4q-0p1aK6ZFK1jKnIfpU8aA&oe=6A9C1C33"}, "display_name": "Monkey Havoc", "keywords": ["Monkey", "Fan", "Game", "Gorilla", "Capuchin"], "long_description": "Welcome to Monkey Havoc, a game based off of the popular games 'Gorilla Tag' and 'Capuchin'. In Monkey Havoc you are able to freely move around many different maps with your friends, equip different styles of cosmetics, and compete in challenges to earn special cosmetics.\nThis game is constantly undergoing development and receiving updates to add more cosmetics, maps, and experiences.\nPlease let me know what to improve on by leaving a review and commenting on what could be better!\ud83d\ude0a\nContact Email: monkeyhavoccreator@gmail.com", "short_description": "Monkey Havoc is a 'Gorilla Tag' and 'Capuchin' fan game, made so that you and your friends can freely 
795275_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=plKHkCfYWUYQ7kNvwEk7iu7&_nc_oc=Adrma3nozKVb4Ujz3RYuTFewxScl_zbu1hSLbbCUGLdNyF0RejnKzchgcAmgaDxlkcM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6Zh2Q0X6ER5nVF5_-2Ifm8Cx8cUKjcG08Fx686Lh4Ogw&oe=6A009116"}, {"file_name": "5.png", "id": "540438542039147", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75395590_540438545372480_7329384731897725266_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Uz8a--yZsG4Q7kNvwFpLV8x&_nc_oc=AdpGxz4Hk7aaKGIfw5caX8GF4DprxyXiqeAvDSeBONzw858OVGgmUAGrqy6JV7OPByc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4_BiMgNbj0vAvxVjoV6wdO0BhWiKt3XpUgak0TuT0NEg&oe=6A0088B5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Monkey Havoc Trailer Image.png", "id": "523796653745732", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974886_523796657079065_1178915653974772965_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_yGFuCSjdTEQ7kNvwFSYBdY&_nc_oc=Ado6TxfdA-AouyKBHDGfj8S0RyHcpJBpzaH5FnTqLK4WkKDCw2FuxQrPPtuhX9iV6aw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4dMPwnradF0wD8sZdh1NCwnIujBYOgyOyNm7a5-MNraA&oe=6A008B33"}, "display_name": "Monkey Havoc", "keywords": ["Monkey", "Fan", "Game", "Gorilla", "Capuchin"], "long_description": "Welcome to Monkey Havoc, a game based off of the popular games 'Gorilla Tag' and 'Capuchin'. In Monkey Havoc you are able to freely move around many different maps with your friends, equip different styles of cosmetics, and compete in challenges to earn special cosmetics.\nThis game is constantly undergoing development and receiving updates to add more cosmetics, maps, and experiences.\nPlease let me know what to improve on by leaving a review and commenting on what could be better!\ud83d\ude0a\nContact Email: monkeyhavoccreator@gmail.com", "short_description": "Monkey Havoc is a 'Gorilla Tag' and 'Capuchin' fan game, made so that you and your friends can freely 
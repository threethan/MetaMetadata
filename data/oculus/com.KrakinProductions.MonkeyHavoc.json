795275_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4wvZqGqTgbMQ7kNvwG2Ge-H&_nc_oc=AdrF6BWkpPMQPVM8NIGMcjx462KcFFV12OM7bUXnWInFdd_FggjAVoCVF6fW38GqtNc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDdSyTaqnyI7he_XIHynz_cLeGk9vUoas5sPExUv76bbA&oe=6A5B8896"}, {"file_name": "5.png", "id": "540438542039147", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75395590_540438545372480_7329384731897725266_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BpixoI6lUNgQ7kNvwHOrTy5&_nc_oc=AdrmiSmzPmtXVrnhsg5-tNUF-j95tSGe6pm6AwN4GV7NnCD8_0aW1WIxJ_E5MnvWVug&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD1kxjNomt0NARek0Bb_UsvOU0VEd0upudN5bHQ2O4w9w&oe=6A5B8035"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Monkey Havoc Trailer Image.png", "id": "523796653745732", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974886_523796657079065_1178915653974772965_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z6vIg_EMW78Q7kNvwHenb-D&_nc_oc=Ado14tRFfb5hcwBCbAyBf8DDx368Keh7cdw4IAgZn6DZpJ6q3N00HzKCMXsRrfgvQ5Y&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDAywCW8NumjXZU_KKvaKzGw6KPr-XcwgOWBtsg2q4WzQ&oe=6A5B82B3"}, "display_name": "Monkey Havoc", "keywords": ["Monkey", "Fan", "Game", "Gorilla", "Capuchin"], "long_description": "Welcome to Monkey Havoc, a game based off of the popular games 'Gorilla Tag' and 'Capuchin'. In Monkey Havoc you are able to freely move around many different maps with your friends, equip different styles of cosmetics, and compete in challenges to earn special cosmetics.\nThis game is constantly undergoing development and receiving updates to add more cosmetics, maps, and experiences.\nPlease let me know what to improve on by leaving a review and commenting on what could be better!\ud83d\ude0a\nContact Email: monkeyhavoccreator@gmail.com", "short_description": "Monkey Havoc is a 'Gorilla Tag' and 'Capuchin' fan game, made so that you and your friends can freely 
795275_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DiWZ2Ctdf8MQ7kNvwFpJw5d&_nc_oc=Adphl2xSXKI7H6StOrEuv9KQo-7l39cVK-Nfw0nv5zzTXDyTI3jxNj4GZwpOAL2o72Y&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIpoUApJ6-DYzZflsF8S1z7e2FFZDBdQpVyHaaJz8ziZQ&oe=6ABE6916"}, {"file_name": "5.png", "id": "540438542039147", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75395590_540438545372480_7329384731897725266_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=roKUpbpNQ68Q7kNvwGPYGe5&_nc_oc=AdqEnP0p7hL07aeFt3AkWbRt_VzI2tgr5cuFPS68VPHe5EDI0bMwYX6iSFPP1BFU7Jg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ2YKaOO01lMGH-l134dvcGdHJZPbLtS_Vl-thANYXsDA&oe=6ABE60B5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Monkey Havoc Trailer Image.png", "id": "523796653745732", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974886_523796657079065_1178915653974772965_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uR-tQTFQCNMQ7kNvwFAUGTJ&_nc_oc=Adr6IlZY7csQExWKDMULFNLoL7AJ9UzM4S55JWe4dVIvD5d0_M9peZ7shj-31FZ9AWc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIkiBI3rx6fjQxfLa0Ck8VjUIFxxgqX_yFQi-WK-EEJTg&oe=6ABE6333"}, "display_name": "Monkey Havoc", "keywords": ["Monkey", "Fan", "Game", "Gorilla", "Capuchin"], "long_description": "Welcome to Monkey Havoc, a game based off of the popular games 'Gorilla Tag' and 'Capuchin'. In Monkey Havoc you are able to freely move around many different maps with your friends, equip different styles of cosmetics, and compete in challenges to earn special cosmetics.\nThis game is constantly undergoing development and receiving updates to add more cosmetics, maps, and experiences.\nPlease let me know what to improve on by leaving a review and commenting on what could be better!\ud83d\ude0a\nContact Email: monkeyhavoccreator@gmail.com", "short_description": "Monkey Havoc is a 'Gorilla Tag' and 'Capuchin' fan game, made so that you and your friends can freely 
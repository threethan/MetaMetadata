795275_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3l-F46UBTT4Q7kNvwHJ-tRg&_nc_oc=Adp6va5uBDlHqzdU2gHhVQjQesMQIGvn0xyvrL0EjDTMj3c2AhXS-nywEINzF4MMEo8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLykO1NRW3_QaqDojziIpGG7Q0gfD3tesGhjm6x6fEocA&oe=6AB52E96"}, {"file_name": "5.png", "id": "540438542039147", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75395590_540438545372480_7329384731897725266_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VY8INeVg4doQ7kNvwGB6L7j&_nc_oc=AdoawxhlIMp8DbGfYqhd9Ytc77Btzsoh-W61i9oPOkGVQduSzt1qMO862_b6gEkf6pM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJY1jeSVQ70-K1Rmbm_bqa3BvxC8OqqvMPVzj9pT5Yjqg&oe=6AB52635"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Monkey Havoc Trailer Image.png", "id": "523796653745732", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974886_523796657079065_1178915653974772965_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ba7d9OWujAIQ7kNvwHKgXKy&_nc_oc=Adr0XXTMcfz16E2a_GlXal3GNbfad7_qf02OGPNF3UkOUywGEzJzOPrAeQaUkDWMQ9c&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI2g-vcZpy-YmTNxhJ4IxqK2tqEOSeGuMx_hzWi2j5vrA&oe=6AB528B3"}, "display_name": "Monkey Havoc", "keywords": ["Monkey", "Fan", "Game", "Gorilla", "Capuchin"], "long_description": "Welcome to Monkey Havoc, a game based off of the popular games 'Gorilla Tag' and 'Capuchin'. In Monkey Havoc you are able to freely move around many different maps with your friends, equip different styles of cosmetics, and compete in challenges to earn special cosmetics.\nThis game is constantly undergoing development and receiving updates to add more cosmetics, maps, and experiences.\nPlease let me know what to improve on by leaving a review and commenting on what could be better!\ud83d\ude0a\nContact Email: monkeyhavoccreator@gmail.com", "short_description": "Monkey Havoc is a 'Gorilla Tag' and 'Capuchin' fan game, made so that you and your friends can freely 
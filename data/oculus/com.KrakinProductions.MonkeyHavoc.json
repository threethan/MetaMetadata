795275_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Q1wUeIQKEl0Q7kNvwFDndnr&_nc_oc=AdrD_-GTe04z_mbppnIJOWsvdjBEe0MSnFHUnfTA_XFSZnncHcYp_d9Lmw0So29FKaM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7a6O54T77ciL5SRaZUardSVG4vrbC5cNHx8P19lqWO3g&oe=6A0B1D16"}, {"file_name": "5.png", "id": "540438542039147", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75395590_540438545372480_7329384731897725266_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fhTpiQNkXr4Q7kNvwEFyndS&_nc_oc=AdqPWZdu82KlwxOk6vqLltspII4gOS9p7U3rfPTDkGj5WKVESnA2GB--YmYz3f_3-5w&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6WeEieNg0rfx_Ah-tJMykcOmpsU7LsrwCzvoKpiImykQ&oe=6A0B14B5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Monkey Havoc Trailer Image.png", "id": "523796653745732", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974886_523796657079065_1178915653974772965_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hL6pmp9prCMQ7kNvwELa_8P&_nc_oc=AdrqJrF8xwdJ-WX4MTf7-1EPSykWpMHyc6iGeb297dbrV9MB2dH_blH4Lw-WcummVFc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5RL1GQlZL63oLho0tN7iBD60q6BSAv4EiS4G4cRCrZrg&oe=6A0B1733"}, "display_name": "Monkey Havoc", "keywords": ["Monkey", "Fan", "Game", "Gorilla", "Capuchin"], "long_description": "Welcome to Monkey Havoc, a game based off of the popular games 'Gorilla Tag' and 'Capuchin'. In Monkey Havoc you are able to freely move around many different maps with your friends, equip different styles of cosmetics, and compete in challenges to earn special cosmetics.\nThis game is constantly undergoing development and receiving updates to add more cosmetics, maps, and experiences.\nPlease let me know what to improve on by leaving a review and commenting on what could be better!\ud83d\ude0a\nContact Email: monkeyhavoccreator@gmail.com", "short_description": "Monkey Havoc is a 'Gorilla Tag' and 'Capuchin' fan game, made so that you and your friends can freely 
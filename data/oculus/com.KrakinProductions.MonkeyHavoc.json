795275_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iGhwosH3o4MQ7kNvwERN-io&_nc_oc=AdozIgg9zudfhOBC74VZvpEAoxEs2TEb1yOG5nWtSfsvr5DymyFZB9rgfjnNJX0Ms5Q&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2U52DsDYEZ3Gf78AF-3pIiIfj_o3tvce0t7JXaJxfEfw&oe=69EE1C16"}, {"file_name": "5.png", "id": "540438542039147", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75395590_540438545372480_7329384731897725266_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cVwkJMuKyEcQ7kNvwF2wQd2&_nc_oc=AdoZMZr9cxZyhT8azm5SYSS8kMdzU5jIwrjuYa-VsixmeSLHlw_Z8yvshX8ZU16tp-A&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0q2bBXXZvPZ7lhMhoPdwFa6eVEqXx81_eS1kN5suuMaQ&oe=69EE13B5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Monkey Havoc Trailer Image.png", "id": "523796653745732", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974886_523796657079065_1178915653974772965_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DbfFuXHU_G0Q7kNvwHi6PRl&_nc_oc=Adof81OybKmrGj9z7L_aTIe-lObo_OMW2a045Rs7wsnSfFN9EXecwhKDVAjaJY554ms&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0_N6yI6n8dI--Yxj2aIctietMtS1X5SaoIx5RrX8XpsQ&oe=69EE1633"}, "display_name": "Monkey Havoc", "keywords": ["Monkey", "Fan", "Game", "Gorilla", "Capuchin"], "long_description": "Welcome to Monkey Havoc, a game based off of the popular games 'Gorilla Tag' and 'Capuchin'. In Monkey Havoc you are able to freely move around many different maps with your friends, equip different styles of cosmetics, and compete in challenges to earn special cosmetics.\nThis game is constantly undergoing development and receiving updates to add more cosmetics, maps, and experiences.\nPlease let me know what to improve on by leaving a review and commenting on what could be better!\ud83d\ude0a\nContact Email: monkeyhavoccreator@gmail.com", "short_description": "Monkey Havoc is a 'Gorilla Tag' and 'Capuchin' fan game, made so that you and your friends can freely 
795275_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VXvkjx49vX0Q7kNvwHV67FO&_nc_oc=AdrlZEskeiRNv6rP4skciwtDO-WYnx1u7yvUWtsrJvoLOddqo1iEXSzw5-5OCadnqYg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTr9TUvH6JI1dKK2BZmczwPM8gR3VJTO4AVAVkBRENlWg&oe=6AEF3096"}, {"file_name": "5.png", "id": "540438542039147", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75395590_540438545372480_7329384731897725266_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tZ836KZXQHoQ7kNvwGk5B-V&_nc_oc=Adrc9nLxjn9NGo0NtFF4_0DuZQf422_e6QWRUfPvxhY3NlNZ4wZfsHbmn_H-j40ouDI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRLrcJYFfKZuSzXNJcWNst3FRiVc2JZ9I6dTvpqsaWhwQ&oe=6AEF6075"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Monkey Havoc Trailer Image.png", "id": "523796653745732", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974886_523796657079065_1178915653974772965_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ook4yIhIYNMQ7kNvwHtglqJ&_nc_oc=Adoksrk20uU3R8LCt1Z0wGXxBhbHCK0OLWx3WyxlCzMvpOl63W2IBNmAPUq4PMhduI8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQROAq9fZSlUDcFcPpw9t8klgt5FxJM7TuRE4zZ71ZGr_g&oe=6AEF62F3"}, "display_name": "Monkey Havoc", "keywords": ["Monkey", "Fan", "Game", "Gorilla", "Capuchin"], "long_description": "Welcome to Monkey Havoc, a game based off of the popular games 'Gorilla Tag' and 'Capuchin'. In Monkey Havoc you are able to freely move around many different maps with your friends, equip different styles of cosmetics, and compete in challenges to earn special cosmetics.\nThis game is constantly undergoing development and receiving updates to add more cosmetics, maps, and experiences.\nPlease let me know what to improve on by leaving a review and commenting on what could be better!\ud83d\ude0a\nContact Email: monkeyhavoccreator@gmail.com", "short_description": "Monkey Havoc is a 'Gorilla Tag' and 'Capuchin' fan game, made so that you and your friends can freely 
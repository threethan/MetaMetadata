795275_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3hqTqrHJjaAQ7kNvwHhGrlo&_nc_oc=Adqq3NqY1s0kErcRo7Wj6qpxyiRfMThOEPOTzqrZIIuqUvbi_1eRCRWPwfjJC5QkWoc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO28zmfHGqRX8z1pPU-R31WRa7Aa2Q9-XQ1bJS-9-TPXg&oe=6AC3AF16"}, {"file_name": "5.png", "id": "540438542039147", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75395590_540438545372480_7329384731897725266_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8pUEOvSGrSYQ7kNvwE8EDMj&_nc_oc=Adqt-Q9El30mZY-LUFe1KkB54XpqOHoVoB_Lqx9Do96Zrx8IVJmWiMshbFae5HuvWlA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPZ7R41namNnIAnoCnWApFk3uljBEr_VliHEXksGKSvdg&oe=6AC3A6B5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Monkey Havoc Trailer Image.png", "id": "523796653745732", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974886_523796657079065_1178915653974772965_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rtngvOORzbAQ7kNvwEoXsYt&_nc_oc=AdotSuWuaKuHcKb7JMET7SmFqzU2JTjKDOm1rcYKOj9jo7H_lQXBn9FomsHIFzBXez0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMP4UEb_GI25dTDMc-tQlqXWdVf_U1eKb39QEr6PRQ2WQ&oe=6AC3A933"}, "display_name": "Monkey Havoc", "keywords": ["Monkey", "Fan", "Game", "Gorilla", "Capuchin"], "long_description": "Welcome to Monkey Havoc, a game based off of the popular games 'Gorilla Tag' and 'Capuchin'. In Monkey Havoc you are able to freely move around many different maps with your friends, equip different styles of cosmetics, and compete in challenges to earn special cosmetics.\nThis game is constantly undergoing development and receiving updates to add more cosmetics, maps, and experiences.\nPlease let me know what to improve on by leaving a review and commenting on what could be better!\ud83d\ude0a\nContact Email: monkeyhavoccreator@gmail.com", "short_description": "Monkey Havoc is a 'Gorilla Tag' and 'Capuchin' fan game, made so that you and your friends can freely 
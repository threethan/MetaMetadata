795275_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=plKHkCfYWUYQ7kNvwENDwih&_nc_oc=Ado45hZWfRgwPYwmk9uzDhKHzs4zVZKjAZt0RGmIPj32LV2OW7Ygo7ohK-Rxhzt4lO0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af43rI0ZkicTaeJpGI5Xo5EYNqdv2udZeGItLg2nVMtZFA&oe=69FF3F96"}, {"file_name": "5.png", "id": "540438542039147", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75395590_540438545372480_7329384731897725266_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Uz8a--yZsG4Q7kNvwHUHng8&_nc_oc=AdoTKF7aY9RRiVulREgZGFtjD85hskM5OAt7_g_nx0Aa4IhD5ocuyfAgk8EsGbSezfU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af66h5pwb5g_GY-flc9YMXH0GZS9mf2bYjKple23HNsy7w&oe=69FF3735"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Monkey Havoc Trailer Image.png", "id": "523796653745732", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974886_523796657079065_1178915653974772965_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_yGFuCSjdTEQ7kNvwHzKMKZ&_nc_oc=AdqqnY_oJbtma6aIE9x_Xz64RvRSV8H6gMtKfHljhT6pJiWuzL4rld1qOkHphZsl5Lc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7zOcSEifmZC6WuWlhZfZV7FJ3nV4jlLPZCSKrrXKARlw&oe=69FF39B3"}, "display_name": "Monkey Havoc", "keywords": ["Monkey", "Fan", "Game", "Gorilla", "Capuchin"], "long_description": "Welcome to Monkey Havoc, a game based off of the popular games 'Gorilla Tag' and 'Capuchin'. In Monkey Havoc you are able to freely move around many different maps with your friends, equip different styles of cosmetics, and compete in challenges to earn special cosmetics.\nThis game is constantly undergoing development and receiving updates to add more cosmetics, maps, and experiences.\nPlease let me know what to improve on by leaving a review and commenting on what could be better!\ud83d\ude0a\nContact Email: monkeyhavoccreator@gmail.com", "short_description": "Monkey Havoc is a 'Gorilla Tag' and 'Capuchin' fan game, made so that you and your friends can freely 
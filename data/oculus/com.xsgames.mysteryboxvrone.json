wHHhejCG5sdiUeFkxzEeU9lUfpu0yW6WhfgsuiK0lsHg&oe=69CCFE04"}, {"file_name": "5.png", "id": "467916352871409", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39003282_467916356204742_1871921057092171900_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a1ElLFiTY8YQ7kNvwGHn2lv&_nc_oc=AdrzCdzzVotN3lMIt2VnZA2Ca_wE1Nn8J02qjj0ZfW1WzUazBML7gQCw0Ibc46dBc1A&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzlhA70BYLkj0EIO3oyxiLzYQlSFVXrr5jryNUQMaef9A&oe=69CD1AE2"}, {"file_name": "3.png", "id": "1934382610375855", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974473_1934382613709188_7156337812617042679_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=64YmulHcdHoQ7kNvwGJQ2k3&_nc_oc=Adqp0ak00P_inOCQEPPJ0P-4OAEH11Bqjs0L1FwgJG_ZXKXvoqpH8GmsPs4CHe68miw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzqVgq9ujhcX43DgHLIrkWocJY8YN8igyp2XpWjnac3mw&oe=69CD04F3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape.png", "id": "1524760081483769", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974531_1524760084817102_6497712644828891067_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UohQ9sJ-RxsQ7kNvwF9ocQa&_nc_oc=Adr0Y-zqtCppF6T6dt0yInK8rWvLxaPAPpIvpmV5st46lwwkoBGzwKftS39OvHSaDe8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afy_QjICo69q9j4S7rON9zMKV2qXSU0hhC0SBCUR1DmX2w&oe=69CD03EF"}, "display_name": "Mystery Box VR: Hidden Secrets", "keywords": [], "long_description": " AN IMMERSIVE VR PUZZLE EXPERIENCE\nInteract with objects, handles, buttons, and wheels on each side. Crack enigmas and collect hidden puzzle tiles on a random side of the boxes.\n\nYou won't be able to compare reality with fiction.\n\n# DISCOVER INVENTIONS\nOnce you unlock all 8 boxes of a Level Pack, you can compose a puzzle and discover a brief history of an invention.\n\nIt's not always easy to escape the room, so use all your IQ to crack the riddles. There's a logic behind all of them, even where it seems it's not!\n\n# IMMERSIVE SOUNDTRACK\nPlay the game with your headphones to get immersed in this amazing adventure.\n\n# HINTS\nGot stuck on some enigma? No worries, you can still get a helpful hint! You can also get in touch with me in case you really can't make it through a riddle, I'll be glad to help ;)\n\n# MULTILANGUAGE\nAvailable in English, French, Italian, German, Spanish, Russian, and Japanese.\n\nThe game language will change automatically based on the language settings of your device", "short_description": "A VR escape room game where you have to solve intriguing riddles to open boxes and discover nice stories about popular inventions!"}, {"images": {"nodes": [{"file_name": "$R36BSY5.png", "id": "3678762505771822", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031430_3678762509105155_2151975047074617165_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jnIfI89YnJAQ7kNvwHM1SDB&_nc_oc=Adp6UlDHTFrXH6wLeN6owWbfOPyRhOk_X-4Rz-wocQlxM0lZ4U8D8jgVJX5SS9cmAt4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxZF0oo6ePmmYObAb_b71wB2DGwK_pWBb5rWi3AJFl2vA&oe=69CCFFE5"}, {"file_name": "$R81V725.png", "id": "2720695481426567", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75262743_2720695484759900_604086922326600035_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9VV7VRNjOqsQ7kNvwGGa2dt&_nc_oc=AdofnAVRuNcuxC1pOUKQNIK_6IAp35u6djwTdy6DTCKa6LVTr993ectzVZ9gdB8jkaQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afx9g_ChTa4laEoxisN1CagdXHFtRyaIosZSKxyx5VKY9A&oe=69CCFECD"}, {"file_name": "$RQ3SN6U.png", "id": "1552311425628973", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982519_1552311428962306_1218130395049083834_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s37lZdS-BloQ7kNvwHcOHoe&_nc_oc=Ado7qVQ8HC8_YoqQME6QkKPUHmpa30YJ0JLFL8LfTRv1WtdL-JUDYnpXMV9fQ6CKxPU&_nc_zt=3&_nc_ht=
FUAMjELuv6UfrGkI1QT425bGZL7t3SoXnuECADZROPtg&oe=6A7B0404"}, {"file_name": "5.png", "id": "467916352871409", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39003282_467916356204742_1871921057092171900_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sB_YGeS_OoUQ7kNvwGzuXib&_nc_oc=Adofc89FL5sZnO6BhGXUN_kf1cBwbbCJ-RWZhBMn052LdTnXmcPBojFb8EJc8nEirak&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFONdIRD_d1ZDVFlO8o7qhql2V2vbTUENFPFovB1o2YVw&oe=6A7B20E2"}, {"file_name": "3.png", "id": "1934382610375855", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974473_1934382613709188_7156337812617042679_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=auHKFdSw4boQ7kNvwHTWean&_nc_oc=AdqiwiiFDCnS7TxwfJjnzuuqVa6xOR5k-pJe0GzndKkgLq9HV7cbpXGOLfoHVKUuJu0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHWLTka45THqzEChsmHBtRz-0ZSPXg6a_ZOWAoEFJH6Hw&oe=6A7B0AF3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape.png", "id": "1524760081483769", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974531_1524760084817102_6497712644828891067_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PXzfjSNr0qcQ7kNvwFre2pF&_nc_oc=AdocXqOW7CtPTpX2rIfm48dtnrbIs4FP75JK1nrV-wZ7AXTFfzNFBSiCHI-VTljWPLQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE8dIC7qHvTuyMUyKiZRmPPAdAfPDaososnL7NCqWFqHQ&oe=6A7B09EF"}, "display_name": "Mystery Box VR: Hidden Secrets", "keywords": [], "long_description": " AN IMMERSIVE VR PUZZLE EXPERIENCE\nInteract with objects, handles, buttons, and wheels on each side. Crack enigmas and collect hidden puzzle tiles on a random side of the boxes.\n\nYou won't be able to compare reality with fiction.\n\n# DISCOVER INVENTIONS\nOnce you unlock all 8 boxes of a Level Pack, you can compose a puzzle and discover a brief history of an invention.\n\nIt's not always easy to escape the room, so use all your IQ to crack the riddles. There's a logic behind all of them, even where it seems it's not!\n\n# IMMERSIVE SOUNDTRACK\nPlay the game with your headphones to get immersed in this amazing adventure.\n\n# HINTS\nGot stuck on some enigma? No worries, you can still get a helpful hint! You can also get in touch with me in case you really can't make it through a riddle, I'll be glad to help ;)\n\n# MULTILANGUAGE\nAvailable in English, French, Italian, German, Spanish, Russian, and Japanese.\n\nThe game language will change automatically based on the language settings of your device", "short_description": "A VR escape room game where you have to solve intriguing riddles to open boxes and discover nice stories about popular inventions!"}, {"images": {"nodes": [{"file_name": "$R36BSY5.png", "id": "3678762505771822", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031430_3678762509105155_2151975047074617165_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mBen32FCM04Q7kNvwH5FPQO&_nc_oc=Ado8TjhmRu4v0QNhvRAPig4JseBiADPT38xzt3O6-PhROmlGZb8wryYmvYujCZauyFo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHU_VHdxOumi_Mou25Cniz7w5FiPvpycAmWXDcEDyq4nQ&oe=6A7B05E5"}, {"file_name": "$R81V725.png", "id": "2720695481426567", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75262743_2720695484759900_604086922326600035_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IOqqRB2BlEAQ7kNvwEnNu2L&_nc_oc=AdpY-UInye6x4aYIzOGjAYGmXpZym4cdgol3DnBRzudoduxyuWzxvL4UBZrAyQlf-8M&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG3D_81YdOZzouX43iVtGxARc3IkRp1l6SDCHOJCTqwQQ&oe=6A7B04CD"}, {"file_name": "$RQ3SN6U.png", "id": "1552311425628973", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982519_1552311428962306_1218130395049083834_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xx9Ag-Hg0pYQ7kNvwGcw4Ye&_nc_oc=Adoz3EiT4I1GrfIH4m2CKMDdxoq1y_olEaTH6mNiPpP86gMsYc_n5oO1ZcZgIG5cOMA&_nc_zt=3&_nc_ht=
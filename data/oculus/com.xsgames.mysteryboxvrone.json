934382610375855", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974473_1934382613709188_7156337812617042679_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ShV67huo4FUQ7kNvwFyVzlL&_nc_oc=Adrj7RV6U1703nsrcvP5OSD749TuxxHZreJICbQZDx6YeVO6ByjKQckdyGHUncjuTek&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRQlznBJUStq6x6UpL_bP0IqUgwqvHo9qNcEji8qGUqjQ&oe=6B070233"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape_coverart.png", "id": "897861905346420", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982672_897861908679753_3996777238831042692_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KG603g9zR-gQ7kNvwEOf6zr&_nc_oc=Adq1ghEsiovlH4ymAxY6xy3B6WO3PtqRyw0pBmdRjXt7EQS5G1q2B44-evDzcIroXV4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRQb2NLWuazoD26AjihneL398fzvPjTUVY4IEmvzVl8Og&oe=6B0704AB"}, "display_name": "Mystery Box VR: Hidden Secrets Escape", "keywords": ["puzzle", "escape", "room", "trivia", "brainteaser"], "long_description": "# AN IMMERSIVE VR PUZZLE EXPERIENCE\nInteract with objects, handles, buttons, and wheels on each side. Crack enigmas and collect hidden puzzle tiles on a random side of the boxes.\n\nYou won't be able to compare reality with fiction.\n\n# DISCOVER INVENTIONS\nOnce you unlock all 8 boxes of a Level Pack, you can compose a puzzle and discover a brief history of an invention.\n\nIt's not always easy to escape the room, so use all your IQ to crack the riddles. There's a logic behind all of them, even where it seems it's not!\n\n# IMMERSIVE SOUNDTRACK\nPlay the game with your headphones to get immersed in this amazing adventure.\n\n# HINTS\nGot stuck on some enigma? No worries, you can still get a helpful hint! You can also get in touch with me in case you really can't make it through a riddle, I'll be glad to help ;)\n\n# MULTILANGUAGE\nAvailable in English, French, Italian, German, Spanish, Russian, and Japanese.\n\nThe game language will change automatically based on the language settings of your device", "short_description": "Crack awesome puzzles around many boxes, and discover the history of the world's most popular inventions!"}, {"images": {"nodes": [{"file_name": "logoTransparent.png", "id": "3812261432362188", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974562_3812261435695521_5176404439574971225_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VmBsVzhj_qUQ7kNvwHyEqPk&_nc_oc=AdrZs_zbTl4sx-SXoRxWGz9JySAtczl9Fplc4QC-G9hay-AEgx1IFSGSP4dBLhpQeZI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT2SxBdGDuCpqFhn8fSnX6o6NhGccPGRD99l-aTFdRRHw&oe=6B06F256"}, {"file_name": "portrait_coverart.png", "id": "1953342038506987", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982581_1953342045173653_4906879878373922307_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WewV9DpMgdcQ7kNvwGDy_et&_nc_oc=AdrEfR6ue_HsMrKMb0nbcPkvc1iwJ5Vh_BwFa-mGBQxA3R9arQerysgyvIsShTQ6lQ8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTywGSO048fuzohKLKQCsxeZ2DE3wNiH5RUEWMHX4M4og&oe=6B07137D"}, {"file_name": "landscape_coverart.png", "id": "1300403051139202", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75462955_1300403057805868_2288822001409671177_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Fe8n1LMIWJwQ7kNvwHejLg8&_nc_oc=AdqqL8wRQQ25mdUIJChXky8fa2RAfdJj-fN8FL6kHBoxONmVanCzbuh2a5jHQ_LcJ4I&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSOUowRcUYe_3tsTOTpNjqrjWssOhgxR-aIc25e_hXW-g&oe=6B070420"}, {"file_name": "square_coverart.png", "id": "914408640187392", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39036626_914408643520725_6339598287132
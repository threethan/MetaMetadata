8sLw&oe=69A6DF62"}, {"file_name": "3.png", "id": "1934382610375855", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974473_1934382613709188_7156337812617042679_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sxauZFBfxmMQ7kNvwHRS0sB&_nc_oc=Adm0B3GsM2d3Sgngy-_M3i3-PBKVSmXIrrO_njpshRW1wTTU1gEptsXnMo-fsaQAB08&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfupZ3NAHKb0bVTosqZXjfJeDgF0FuZk5rQm8L-W79ep-w&oe=69A6C973"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape.png", "id": "1524760081483769", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974531_1524760084817102_6497712644828891067_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gnG27X-rzggQ7kNvwGMA7Sn&_nc_oc=Adls6j--WGSxT1uxKBMyYsN-DSvg2EhEPGCVQSFXYT6eobw0RxWZssamlo5PaDZl2PQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfvQ1JiWiPZKkHUPiO_1-iXsQyyA9y1g1o3KCUAXQSbT2w&oe=69A6C86F"}, "display_name": "Mystery Box VR: Hidden Secrets", "keywords": [], "long_description": " AN IMMERSIVE VR PUZZLE EXPERIENCE\nInteract with objects, handles, buttons, and wheels on each side. Crack enigmas and collect hidden puzzle tiles on a random side of the boxes.\n\nYou won't be able to compare reality with fiction.\n\n# DISCOVER INVENTIONS\nOnce you unlock all 8 boxes of a Level Pack, you can compose a puzzle and discover a brief history of an invention.\n\nIt's not always easy to escape the room, so use all your IQ to crack the riddles. There's a logic behind all of them, even where it seems it's not!\n\n# IMMERSIVE SOUNDTRACK\nPlay the game with your headphones to get immersed in this amazing adventure.\n\n# HINTS\nGot stuck on some enigma? No worries, you can still get a helpful hint! You can also get in touch with me in case you really can't make it through a riddle, I'll be glad to help ;)\n\n# MULTILANGUAGE\nAvailable in English, French, Italian, German, Spanish, Russian, and Japanese.\n\nThe game language will change automatically based on the language settings of your device", "short_description": "A VR escape room game where you have to solve intriguing riddles to open boxes and discover nice stories about popular inventions!"}, {"images": {"nodes": [{"file_name": "$R36BSY5.png", "id": "3678762505771822", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031430_3678762509105155_2151975047074617165_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_-J6cMzTySsQ7kNvwEU2qXO&_nc_oc=AdmaJgLFYuyxr5w8tbhqt580HHMcA8VeG5F9Fj-RgC2s7Vz40fpLJ1PVZE96BtpTj60&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AftZ4huJFIZjotwpXteZrAgp7j7EQpRQzJX9wU-NiGFYQw&oe=69A6C465"}, {"file_name": "$R81V725.png", "id": "2720695481426567", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75262743_2720695484759900_604086922326600035_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XNhMdQEdOLQQ7kNvwGIAJ1y&_nc_oc=AdlOtuOXHf8ltqk8pSS1xTXXuBtnuXkQm92Lw5JLvbk9gsWTC_7pbWamSerBPr-xvDM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afvse4wCRSV7AXZiY0eyOeHbszDcFf9neOPEZSlci3Rnng&oe=69A6C34D"}, {"file_name": "$RQ3SN6U.png", "id": "1552311425628973", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982519_1552311428962306_1218130395049083834_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qFGpsVSg4EsQ7kNvwHFk6-a&_nc_oc=AdnFZYO6Z3AmeF_qmnkDBCn5mDSwbdwD-nCGuSIyShgcBMBdqdMdnSVHhrW8LR7ySRo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfuG3VCNrLQakd4ntCbxRCL7ZM3ErFJFAqbhbmUthfIVkg&oe=69A6CEA9"}, {"file_name": "38982645_1000853181732648_5055517427829171192_n.png", "id": "1043990680394008", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031625_1043990683727341_3557431131423146005_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NJk_jHs7yAMQ7kNvwGeeprK&_nc_oc=Adnu4xq6k9QvpKvftyENnohYFB9hhsHBM6DiMiDwwEOCzMHZ6FNR0TIzZcHvnsTOaxw&_nc_zt=3&_nc_ht=scontent-iad3-1
nc_ss=7f20f&oh=00_AQKC99liGitQmM9M8H73hUd0sgp34wQhk-d9LAXjpTro5g&oe=6AA960C4"}, {"file_name": "5.png", "id": "467916352871409", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/39003282_467916356204742_1871921057092171900_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0mtlw1ZTugIQ7kNvwFtegAj&_nc_oc=Adrz8z7MpZl_5hSh3dS4sulSZKJoogVlvXSmjnlldW9AJgnbqxdtE_6ODksnplzxFnA&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIiYsTbG-yAGpJeIhH_vUMlOOZcU0xZzpWPb05Wt1YInw&oe=6AA94562"}, {"file_name": "3.png", "id": "1934382610375855", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/38974473_1934382613709188_7156337812617042679_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7Td24-Ca-9YQ7kNvwE6bvCb&_nc_oc=AdoZzHV1BFa1Y6KvJZ0KAzAq7rYq8JV7jxn0KnJnEU4x-8v3CRFwsHAHFdJvtSoH0_o&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJJXnaisQtQm9xAD8A9G7nX-lR79LBYc9hoQJNEQQfFlw&oe=6AA967B3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape.png", "id": "1524760081483769", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/38974531_1524760084817102_6497712644828891067_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1UObAv9fq6QQ7kNvwHI2ErR&_nc_oc=AdpSsUcfGWfMi4PDz8tjoP-L5nN6Z3eVs4zhV-YDBi-_3ripoaykJ0famZIuNQC6Zug&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKX9TIIr6ctsMkGwunRzoeRu_In7j6oU_PA--KDRFUQwQ&oe=6AA966AF"}, "display_name": "Mystery Box VR: Hidden Secrets", "keywords": [], "long_description": " AN IMMERSIVE VR PUZZLE EXPERIENCE\nInteract with objects, handles, buttons, and wheels on each side. Crack enigmas and collect hidden puzzle tiles on a random side of the boxes.\n\nYou won't be able to compare reality with fiction.\n\n# DISCOVER INVENTIONS\nOnce you unlock all 8 boxes of a Level Pack, you can compose a puzzle and discover a brief history of an invention.\n\nIt's not always easy to escape the room, so use all your IQ to crack the riddles. There's a logic behind all of them, even where it seems it's not!\n\n# IMMERSIVE SOUNDTRACK\nPlay the game with your headphones to get immersed in this amazing adventure.\n\n# HINTS\nGot stuck on some enigma? No worries, you can still get a helpful hint! You can also get in touch with me in case you really can't make it through a riddle, I'll be glad to help ;)\n\n# MULTILANGUAGE\nAvailable in English, French, Italian, German, Spanish, Russian, and Japanese.\n\nThe game language will change automatically based on the language settings of your device", "short_description": "A VR escape room game where you have to solve intriguing riddles to open boxes and discover nice stories about popular inventions!"}, {"images": {"nodes": [{"file_name": "$R36BSY5.png", "id": "3678762505771822", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/39031430_3678762509105155_2151975047074617165_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GKtfdn4sZ6AQ7kNvwGRTNz0&_nc_oc=AdqAchmDD7oRlp57alOwZxbcXUxU6pF_XJycZPtapoY2ht-CFBupdIAYwUCB4JcwRSY&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL5v7AwkpndcdFLZIxkGfwyG0T4A0jJu79eQC8nYs9h1A&oe=6AA962A5"}, {"file_name": "$R81V725.png", "id": "2720695481426567", "image_type": "APP_IMG_ICON", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/75262743_2720695484759900_604086922326600035_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bNtvm_ejkd0Q7kNvwG1d6L9&_nc_oc=AdqYLA3agJTSX2bjYSt_o12o7tgRkhzmQ9cA9W5YPxuvYsOMwuubwOSCenPUpaY8MpU&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKKk_4EIJBdg7b-TYHHV7S9jyGyPmXCSRnxUtmmN7dddA&oe=6AA9618D"}, {"file_name": "$RQ3SN6U.png", "id": "1552311425628973", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/38982519_1552311428962306_1218130395049083834_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bR3_bM_dQS8Q7kNvwG4Sf6x&_nc_oc=AdqyB3ln89RlE_5wZXnlue5Trbkl2zQH1oO88W1PuoYpgBzuUEg6bsgsBgNC
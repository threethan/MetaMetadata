BW7VD_aAAiiroXLxL0zt_OgZ_DXmzcuTkjLeS80xOdww&oe=6A5B6004"}, {"file_name": "5.png", "id": "467916352871409", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39003282_467916356204742_1871921057092171900_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gfMjMVstw0EQ7kNvwH-930t&_nc_oc=Adom6YyHAQAhDDjV9WsMtDQJJ-bKLs3-dXxrXJ4w2I4vM-5s7fdG0swniR4kU6Qrdxc&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBiR2LQja4ePvVYsIUlJ2SJNvziCQ1IEA8DeSsApUSa1g&oe=6A5B7CE2"}, {"file_name": "3.png", "id": "1934382610375855", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974473_1934382613709188_7156337812617042679_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KYf0ZT147eoQ7kNvwFTFML5&_nc_oc=AdoIfRaI9vzxAIqGTrYmXZV_EnWMQSGCYxifbjNW0AQrNy9HYQZnAZp4VcvloCNNHCA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA0Q3Q9r-dncztN3R1lFk93hisDURFzE-Q1aX3sct6ZPw&oe=6A5B66F3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape.png", "id": "1524760081483769", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974531_1524760084817102_6497712644828891067_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-a63X8tpH40Q7kNvwFKp9Bi&_nc_oc=AdqfegfjyJfOl9gOU5rpvz1qC5nS4Zblg5TnvClsBLnLJGMal9CCsgPAhFcFr3GnQq4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCH4Gu34yN3C5jKpF2Jj8up1VPKniIDzg71OV8ypfRR8w&oe=6A5B65EF"}, "display_name": "Mystery Box VR: Hidden Secrets", "keywords": [], "long_description": " AN IMMERSIVE VR PUZZLE EXPERIENCE\nInteract with objects, handles, buttons, and wheels on each side. Crack enigmas and collect hidden puzzle tiles on a random side of the boxes.\n\nYou won't be able to compare reality with fiction.\n\n# DISCOVER INVENTIONS\nOnce you unlock all 8 boxes of a Level Pack, you can compose a puzzle and discover a brief history of an invention.\n\nIt's not always easy to escape the room, so use all your IQ to crack the riddles. There's a logic behind all of them, even where it seems it's not!\n\n# IMMERSIVE SOUNDTRACK\nPlay the game with your headphones to get immersed in this amazing adventure.\n\n# HINTS\nGot stuck on some enigma? No worries, you can still get a helpful hint! You can also get in touch with me in case you really can't make it through a riddle, I'll be glad to help ;)\n\n# MULTILANGUAGE\nAvailable in English, French, Italian, German, Spanish, Russian, and Japanese.\n\nThe game language will change automatically based on the language settings of your device", "short_description": "A VR escape room game where you have to solve intriguing riddles to open boxes and discover nice stories about popular inventions!"}, {"images": {"nodes": [{"file_name": "$R36BSY5.png", "id": "3678762505771822", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031430_3678762509105155_2151975047074617165_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YRmPD2doEx8Q7kNvwEVr5QI&_nc_oc=AdrDgHO6E5wYgfhu3uDRxbftw2P6Z5Q2qf5nSysVbwkyksVZjOJOqjj2gLyzw5Zy0FA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAXOlnwx06FrnfZOTbL0QmYF8hclXC6iuzMt9bA0FFHKw&oe=6A5B61E5"}, {"file_name": "$R81V725.png", "id": "2720695481426567", "image_type": "APP_IMG_ICON", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75262743_2720695484759900_604086922326600035_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Xlxu1WTQS-8Q7kNvwEdq_cK&_nc_oc=AdpPTGx7QKTblOYpzRYjYDz2BVd7FJPJDZuORPiCRgzLruJWwSBSfaYyTygik3qPRAs&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBTDpsHQD4HC7mBsr4QTNXKpj9EpLBgoGDXEEU2j99wRg&oe=6A5B60CD"}, {"file_name": "$RQ3SN6U.png", "id": "1552311425628973", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982519_1552311428962306_1218130395049083834_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0dZ7NLrzPSMQ7kNvwHQS4BU&_nc_oc=AdqVT2tLEBH7UgGHKfNMUDlfHiucbARAk9fg7dvlBBlK15Syu2elP6yzO6PerxzN6yw&_nc_zt=3&_nc_ht=
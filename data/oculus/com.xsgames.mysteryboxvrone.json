P7A0a8Cy2onkiooe20eTmMom0PL_1or4l3XXz901kpSA&oe=6AC904C4"}, {"file_name": "5.png", "id": "467916352871409", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/39003282_467916356204742_1871921057092171900_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Fx3N4IMeC0EQ7kNvwFhnV2N&_nc_oc=AdoxyhUWicaXhKqXkZ7FWTAs-Yq0gvvxVJWpE5ZE0EGM4E3izpFG-rP5Z7twO1OHvDI&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPKMy1bDZNhXPpXs_jtNPozc3lltl9WG0FR88IdXlIIGA&oe=6AC8E962"}, {"file_name": "3.png", "id": "1934382610375855", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38974473_1934382613709188_7156337812617042679_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J8QjMCmRfGYQ7kNvwFZD6PV&_nc_oc=AdqN81weyuko5DqCveWVUJoDlqgddoARCAEz_yOJh5QsWe37ZMGuEY7RsjAKc4M5oCo&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPaFn6QLWNvlihKZFLvDA9PtO2bjF3HFnSOpmbMQUVTWQ&oe=6AC90BB3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape.png", "id": "1524760081483769", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38974531_1524760084817102_6497712644828891067_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Qm77SO_d7RAQ7kNvwE1HSw5&_nc_oc=AdpQ7i1wqXwktWL85NukKJ26aEbJcniipzlGq23bWVVgXrH4OHUvqkKTKxrAt8rIHk0&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOnS7MDpI4DLPXweRXYrCZHsKdpXO97Rrff4VpvWTdyNg&oe=6AC90AAF"}, "display_name": "Mystery Box VR: Hidden Secrets", "keywords": [], "long_description": " AN IMMERSIVE VR PUZZLE EXPERIENCE\nInteract with objects, handles, buttons, and wheels on each side. Crack enigmas and collect hidden puzzle tiles on a random side of the boxes.\n\nYou won't be able to compare reality with fiction.\n\n# DISCOVER INVENTIONS\nOnce you unlock all 8 boxes of a Level Pack, you can compose a puzzle and discover a brief history of an invention.\n\nIt's not always easy to escape the room, so use all your IQ to crack the riddles. There's a logic behind all of them, even where it seems it's not!\n\n# IMMERSIVE SOUNDTRACK\nPlay the game with your headphones to get immersed in this amazing adventure.\n\n# HINTS\nGot stuck on some enigma? No worries, you can still get a helpful hint! You can also get in touch with me in case you really can't make it through a riddle, I'll be glad to help ;)\n\n# MULTILANGUAGE\nAvailable in English, French, Italian, German, Spanish, Russian, and Japanese.\n\nThe game language will change automatically based on the language settings of your device", "short_description": "A VR escape room game where you have to solve intriguing riddles to open boxes and discover nice stories about popular inventions!"}, {"images": {"nodes": [{"file_name": "$R36BSY5.png", "id": "3678762505771822", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/39031430_3678762509105155_2151975047074617165_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u2XexYMM2cQQ7kNvwHVbg9p&_nc_oc=AdqAO2ad-YM9NBcwIx9QXGhWVsP03asTgQ4xTrkzc8rtwflDUPGgivrP9tgygPRg7zA&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMzAXo7ORh4cnQEVX43M_4QBcRsXs2KpVY-l6AdFg5wXg&oe=6AC906A5"}, {"file_name": "$R81V725.png", "id": "2720695481426567", "image_type": "APP_IMG_ICON", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/75262743_2720695484759900_604086922326600035_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gs8zp7BsOVoQ7kNvwG7oYPB&_nc_oc=AdpL2Glf647B-o4EuF6HN8aUle1R3cASjfQzttYDJEkwNSdV3EE8ayf-J2dVXxIiPc8&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM1rhMMj-c8MlfnifPapzIkp9FDasARpzuWgLoFxCsynQ&oe=6AC9058D"}, {"file_name": "$RQ3SN6U.png", "id": "1552311425628973", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38982519_1552311428962306_1218130395049083834_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c-4TLDjhyUsQ7kNvwGJeTvN&_nc_oc=AdqeMJOys4M4hSqdblWbwPmlDzTISOtzwBnHlJ6po-_a0VGpgOP4aq_vWV6u-0NZzwY&_nc_zt=3&_nc_ht=
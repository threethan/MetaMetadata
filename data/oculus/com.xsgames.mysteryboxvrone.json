oculuscdn.com/v/t64.5771-25/39003282_467916356204742_1871921057092171900_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A712amC3bgcQ7kNvwHXxBPP&_nc_oc=AdmBqpAplWVz3nXEY6x4lgvbV9ccMEe74gEFJFkH3RXJP2qRns2ctCAAlagtQwYjZxQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfuEOWKR6AXQvyqi3TQtc10g_8Br8kT2FIQkizBb2nw0wQ&oe=69A830E2"}, {"file_name": "3.png", "id": "1934382610375855", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974473_1934382613709188_7156337812617042679_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g9fn6Gui0_sQ7kNvwERN8Cs&_nc_oc=AdmCo7UdhMGk4_W7UtGT99ORmLdVJ_rl8E_7jDPtqIk6G3TILTdWIz--J54eykpdR84&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfvUbyEMKQ6dPlYhFNBD8XdZavTGjWPfFjbxB50RdHT5HQ&oe=69A81AF3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape.png", "id": "1524760081483769", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974531_1524760084817102_6497712644828891067_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gnG27X-rzggQ7kNvwFib-PN&_nc_oc=AdkxntBbRbzEN6sP9UBVqkGsHyCw8k4jFhnXvmcF_ybS9nakijOS__etnxE7d01_FSE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfvqzG8GVDkhaz17Z2F0Cbfsu5huu98pQmmgJM7KH9_YgQ&oe=69A819EF"}, "display_name": "Mystery Box VR: Hidden Secrets", "keywords": [], "long_description": " AN IMMERSIVE VR PUZZLE EXPERIENCE\nInteract with objects, handles, buttons, and wheels on each side. Crack enigmas and collect hidden puzzle tiles on a random side of the boxes.\n\nYou won't be able to compare reality with fiction.\n\n# DISCOVER INVENTIONS\nOnce you unlock all 8 boxes of a Level Pack, you can compose a puzzle and discover a brief history of an invention.\n\nIt's not always easy to escape the room, so use all your IQ to crack the riddles. There's a logic behind all of them, even where it seems it's not!\n\n# IMMERSIVE SOUNDTRACK\nPlay the game with your headphones to get immersed in this amazing adventure.\n\n# HINTS\nGot stuck on some enigma? No worries, you can still get a helpful hint! You can also get in touch with me in case you really can't make it through a riddle, I'll be glad to help ;)\n\n# MULTILANGUAGE\nAvailable in English, French, Italian, German, Spanish, Russian, and Japanese.\n\nThe game language will change automatically based on the language settings of your device", "short_description": "A VR escape room game where you have to solve intriguing riddles to open boxes and discover nice stories about popular inventions!"}, {"images": {"nodes": [{"file_name": "$R36BSY5.png", "id": "3678762505771822", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031430_3678762509105155_2151975047074617165_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_-J6cMzTySsQ7kNvwGinlk3&_nc_oc=AdnTy5z_UMv1doqADJYkHpRW2R0gGrrxk1jKF3VMOTWzvrxMQdF5Eevi4JlFLs5vbbM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfvkpcKN_Y5bZQwNreoR5FCiDh4zkdE9Pcw0yvzc_jofnA&oe=69A815E5"}, {"file_name": "$R81V725.png", "id": "2720695481426567", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75262743_2720695484759900_604086922326600035_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x6YxJkxic10Q7kNvwH6wijK&_nc_oc=AdkxLnZpvbIeNSOiCiwSRBI0rg4m5AbtVTDh9sS_BmyKCzLlpSb0dxYjGSATXDtp1uE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AftA1AFZeLk9SOWJ0UEtOq_ZLBhlqVPeiwyb1fhI0kKoxA&oe=69A814CD"}, {"file_name": "$RQ3SN6U.png", "id": "1552311425628973", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982519_1552311428962306_1218130395049083834_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qFGpsVSg4EsQ7kNvwETVjiD&_nc_oc=AdnKFF9OfOCdZ5WL0wNd1vWDE27rjH-65jwRBMaapTaZUyH6Z0xIjGzdUewUN2aWq8g&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfslBLO3obMa8HgDopmpOxG_VIVzexCd2fQlzrJCCOUEqw&oe=69A82029"}, {"file_name": "38982645_1000853181732648_505551742782
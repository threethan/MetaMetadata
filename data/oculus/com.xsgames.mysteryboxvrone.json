9ZXYGnXxdUrj906OrrXWSZqasQc-D8InVBIrtebC2_rQ&oe=6A2AD0C4"}, {"file_name": "5.png", "id": "467916352871409", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39003282_467916356204742_1871921057092171900_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ErOE7J4cY9gQ7kNvwGp-Oq8&_nc_oc=AdprJgbFK8iZHaEiaw5iGfGNEiZs4GCKhR0xE7pkIPxIPOzRcCgOkQ-IBcTvVnXQpTI&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_zagcEw38NifjghoPQ8o3l93etdFis0JtuRZa8hTuLJA&oe=6A2AB562"}, {"file_name": "3.png", "id": "1934382610375855", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974473_1934382613709188_7156337812617042679_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DG2Xt89Dq4cQ7kNvwHm-6ZQ&_nc_oc=AdrHhI1Gj1w-1eSsyf3Tw-2ef-louMNnH5ne72npGjmShzeRixPOHBuIVQWBkuZDwGo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-Nwnyug9ArY6dAeKcmGdB5a_XfsqBeRb5_kZ846o2r8A&oe=6A2AD7B3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape.png", "id": "1524760081483769", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974531_1524760084817102_6497712644828891067_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_TKuk91nOKsQ7kNvwGOcLjs&_nc_oc=AdrP7PNNEcPL6zkDPker0_g4r7i134rXYUKJlcP6QntJkgWZ_SSY6MkzKtCsQXk7u4c&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-0kaz1dYclJPrKj_eZjJptLnDOUcVp1Al8KqOqv6sbHQ&oe=6A2AD6AF"}, "display_name": "Mystery Box VR: Hidden Secrets", "keywords": [], "long_description": " AN IMMERSIVE VR PUZZLE EXPERIENCE\nInteract with objects, handles, buttons, and wheels on each side. Crack enigmas and collect hidden puzzle tiles on a random side of the boxes.\n\nYou won't be able to compare reality with fiction.\n\n# DISCOVER INVENTIONS\nOnce you unlock all 8 boxes of a Level Pack, you can compose a puzzle and discover a brief history of an invention.\n\nIt's not always easy to escape the room, so use all your IQ to crack the riddles. There's a logic behind all of them, even where it seems it's not!\n\n# IMMERSIVE SOUNDTRACK\nPlay the game with your headphones to get immersed in this amazing adventure.\n\n# HINTS\nGot stuck on some enigma? No worries, you can still get a helpful hint! You can also get in touch with me in case you really can't make it through a riddle, I'll be glad to help ;)\n\n# MULTILANGUAGE\nAvailable in English, French, Italian, German, Spanish, Russian, and Japanese.\n\nThe game language will change automatically based on the language settings of your device", "short_description": "A VR escape room game where you have to solve intriguing riddles to open boxes and discover nice stories about popular inventions!"}, {"images": {"nodes": [{"file_name": "$R36BSY5.png", "id": "3678762505771822", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031430_3678762509105155_2151975047074617165_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7y7GWKmahVoQ7kNvwEI4lX_&_nc_oc=AdoNeLyfaKAQwBBivUai3Vtx2UMtJNcViDRuYfSAU1LbUyeHK8p2JUOb_kkBdmxjMOA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8MpZSVPxqhlzEd_rp8dVZ6QZoR6xZmMOcVRRXqbmklfg&oe=6A2AD2A5"}, {"file_name": "$R81V725.png", "id": "2720695481426567", "image_type": "APP_IMG_ICON", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75262743_2720695484759900_604086922326600035_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yjV5r7i7aWAQ7kNvwH4nwJg&_nc_oc=Adr5bzhi5UTr57sTxFvINTjdHjQuC_TriivfZe1woKu5FgdSP9H20GSexqL0Wl8h-xY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9fJi19H3cgH8rCIZMe9axMaDbxzo-YGHZcDUA8nGu06Q&oe=6A2AD18D"}, {"file_name": "$RQ3SN6U.png", "id": "1552311425628973", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982519_1552311428962306_1218130395049083834_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VIcirpHbD9wQ7kNvwGeiHOu&_nc_oc=Adp7RNXpJwAohUizkoeCCJPG427SSiVPTY43uOsyCLU0oI1bMaPKZ2CAB4VJhTqFozw&_nc_zt=3&_nc_ht=
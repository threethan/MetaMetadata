S0_dzxF0y4tv1cga4qRiLqJ3MtNL4bCmhRwe3tugO6Ag&oe=6AF1E344"}, {"file_name": "5.png", "id": "467916352871409", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39003282_467916356204742_1871921057092171900_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RcI6rS3fj4kQ7kNvwHDTajs&_nc_oc=AdqeuQm_qeEIyQ-LQBI88WjBF4KSmN0Fc6meOIWmwhvlqfCf8mTF-T3Yg9oe4rZ79sA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSiPXqgDZICx1ImiElhAb21Fw3rs9aAVc0X_u2lKV8_jg&oe=6AF20022"}, {"file_name": "3.png", "id": "1934382610375855", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974473_1934382613709188_7156337812617042679_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pPP-NlkeVqIQ7kNvwFd6IeZ&_nc_oc=AdpHcZGG4az_VY1E_QHYpivjWJxAerLjdlzVYFR9yNMeK435Eoa3BmScxjiNcCqnh7M&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTubsOpeQ3eo5btNyfpsmiiUwSz5o6aXqSZppxltJa96A&oe=6AF1EA33"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape.png", "id": "1524760081483769", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974531_1524760084817102_6497712644828891067_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Cj6izO9pyxcQ7kNvwFK25w1&_nc_oc=AdpQ6Ro7gpbXbEB-bYsyarWpIKHsfgEDa8CTILPAqeeLaPiZ8Dq8vQisTngkzmpn944&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ8Y-rRL2vk7DHj41k5FHNO8WZiI9lUKWnIVCN0NisANQ&oe=6AF1E92F"}, "display_name": "Mystery Box VR: Hidden Secrets", "keywords": [], "long_description": " AN IMMERSIVE VR PUZZLE EXPERIENCE\nInteract with objects, handles, buttons, and wheels on each side. Crack enigmas and collect hidden puzzle tiles on a random side of the boxes.\n\nYou won't be able to compare reality with fiction.\n\n# DISCOVER INVENTIONS\nOnce you unlock all 8 boxes of a Level Pack, you can compose a puzzle and discover a brief history of an invention.\n\nIt's not always easy to escape the room, so use all your IQ to crack the riddles. There's a logic behind all of them, even where it seems it's not!\n\n# IMMERSIVE SOUNDTRACK\nPlay the game with your headphones to get immersed in this amazing adventure.\n\n# HINTS\nGot stuck on some enigma? No worries, you can still get a helpful hint! You can also get in touch with me in case you really can't make it through a riddle, I'll be glad to help ;)\n\n# MULTILANGUAGE\nAvailable in English, French, Italian, German, Spanish, Russian, and Japanese.\n\nThe game language will change automatically based on the language settings of your device", "short_description": "A VR escape room game where you have to solve intriguing riddles to open boxes and discover nice stories about popular inventions!"}, {"images": {"nodes": [{"file_name": "$R36BSY5.png", "id": "3678762505771822", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031430_3678762509105155_2151975047074617165_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9uPP7aXUz3AQ7kNvwEg8CG4&_nc_oc=AdpaZPRJYBORph4jmN_S_pZsnVTIUV9PpPXEWbpV--_8SLh0ztaEGawMmlD10eW0xCw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQt4Tcj8cn2WYLevKT5tsvEHXOLiEl_0xj2oOIDyEm7eA&oe=6AF1E525"}, {"file_name": "$R81V725.png", "id": "2720695481426567", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75262743_2720695484759900_604086922326600035_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XGZJhtiZoFMQ7kNvwFvKE3Y&_nc_oc=Adq9TYTtP0a4QWyX930baiDKh3UWGzfCEifjLw7QPvnz5cHr3uGWi6qprQomGR2JJOc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSG9Zc4XpgEpf4C3jM7E2NBzCcHNKNGWiOWZ1yamNxSNA&oe=6AF1E40D"}, {"file_name": "$RQ3SN6U.png", "id": "1552311425628973", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982519_1552311428962306_1218130395049083834_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Q-82AWqTsTMQ7kNvwEGvgU9&_nc_oc=AdpRdvXZCPer6iaNUVXS6bSmgbixw3axAXUimAkSQ925CzOXXeokNblcPGXVP55KTUY&_nc_zt=3&_nc_ht=
-78tGgDYOOvRtkIUmbUeJU4AvilMh4tG85yKn-l7RR5Q&oe=6A452EC4"}, {"file_name": "5.png", "id": "467916352871409", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39003282_467916356204742_1871921057092171900_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MzufMR8pp_EQ7kNvwExJbXw&_nc_oc=AdpFC0admFGBmTSVUbnFtcY1iKTZwLbHq5qfQciVucfz4UF6KxCC1jZKOWjUS6U5W3g&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8-5s5OWSewML4JvC7epVmRcnXGeS5i_eXIfk0WESngzQ&oe=6A451362"}, {"file_name": "3.png", "id": "1934382610375855", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38974473_1934382613709188_7156337812617042679_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BnjajQEWy9cQ7kNvwHFj7VL&_nc_oc=AdoxqP8m6PcTHRZolhWmCnu9cum6KzkRJC8rsSYW6tur8mAvC5FLgE4GjdGvXfJtpLs&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9QiXzxizT6LCzVQF-LkwWB9XAqUed4sYAgEzqFW9lQpA&oe=6A4535B3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape.png", "id": "1524760081483769", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38974531_1524760084817102_6497712644828891067_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DRKjDrw24koQ7kNvwFq0HfC&_nc_oc=AdreIMlNa7zG2aDDbZLPGDppkIKe0oHTEj871_x4O67SX3P-aUsB5q0YhBBEE7o6gOE&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8NCf_gAg0o3CBR4FjiWFGcr4rAWn51yZS3E-wRIrvSrQ&oe=6A4534AF"}, "display_name": "Mystery Box VR: Hidden Secrets", "keywords": [], "long_description": " AN IMMERSIVE VR PUZZLE EXPERIENCE\nInteract with objects, handles, buttons, and wheels on each side. Crack enigmas and collect hidden puzzle tiles on a random side of the boxes.\n\nYou won't be able to compare reality with fiction.\n\n# DISCOVER INVENTIONS\nOnce you unlock all 8 boxes of a Level Pack, you can compose a puzzle and discover a brief history of an invention.\n\nIt's not always easy to escape the room, so use all your IQ to crack the riddles. There's a logic behind all of them, even where it seems it's not!\n\n# IMMERSIVE SOUNDTRACK\nPlay the game with your headphones to get immersed in this amazing adventure.\n\n# HINTS\nGot stuck on some enigma? No worries, you can still get a helpful hint! You can also get in touch with me in case you really can't make it through a riddle, I'll be glad to help ;)\n\n# MULTILANGUAGE\nAvailable in English, French, Italian, German, Spanish, Russian, and Japanese.\n\nThe game language will change automatically based on the language settings of your device", "short_description": "A VR escape room game where you have to solve intriguing riddles to open boxes and discover nice stories about popular inventions!"}, {"images": {"nodes": [{"file_name": "$R36BSY5.png", "id": "3678762505771822", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39031430_3678762509105155_2151975047074617165_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z5SLRtMHrp0Q7kNvwE71F4a&_nc_oc=AdpzhsZ810vE_4R1QVmNnhIdxw_KFSHOoC-_2XhVvh7phxpTl83HsxCGhftAOwmoeU8&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_yySCqwFaTuTROU6HhIYJ4SZv0F3Gc5ibgSp6BPpAwcg&oe=6A4530A5"}, {"file_name": "$R81V725.png", "id": "2720695481426567", "image_type": "APP_IMG_ICON", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75262743_2720695484759900_604086922326600035_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uUEsYVmGYyUQ7kNvwGBAz3a&_nc_oc=AdqHFwllDqz18NFe5w7sY7cag_By6Z6Kad4C4YOQxu7Sl1kbtQk03Y5tpmJT6Axycv0&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8kvJ3D6XzYwb07Y7BIPq9MmK-GKZsUcUfsWHL6HCo5xQ&oe=6A452F8D"}, {"file_name": "$RQ3SN6U.png", "id": "1552311425628973", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982519_1552311428962306_1218130395049083834_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QHPufo2j8-0Q7kNvwG2Xwt8&_nc_oc=AdphIttd3ojqbDv2p5ImkOkVFPclg-ntxoJ8J9E8tHpDtS79PN3kuZltuu3UvS7lmaY&_nc_zt=3&_nc_ht=
HLeO0a-Y-9jSMNFWt0Gg0WFvEQ3_XctkFxbW7GeZWYcw&oe=6A804A04"}, {"file_name": "5.png", "id": "467916352871409", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/39003282_467916356204742_1871921057092171900_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ulo6P3uXyHAQ7kNvwF5-55W&_nc_oc=AdplIrckypGDJg11uX2CQ5x1HkGpsSyuP-GKtncqN4zzdU8Vp53fW6dS-Xt0_bfnjXE&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFtmVsMCfemvzEMZgHDoU0XGX9NaS8acP1L1q6eDrM1ng&oe=6A8066E2"}, {"file_name": "3.png", "id": "1934382610375855", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38974473_1934382613709188_7156337812617042679_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9VYUuC_JU6cQ7kNvwHd9rnR&_nc_oc=AdqnKq3curXW3KrSi94OHjcjSKzYEbhl3brI-tOMJpiB734CxRV_RF42XGsVbEGTZak&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHQ4dw3dETmBHKt8hrcQ4w4WOxmFn8ISqy0ir1krsXmDw&oe=6A8050F3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape.png", "id": "1524760081483769", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38974531_1524760084817102_6497712644828891067_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S4zDneBS-BQQ7kNvwFduvOG&_nc_oc=AdrF-vR6PK-DISP9ZM74dCqmcghPuEXFBLjxZhfqt7ea9TwCyJqtXqsYSss8xLCW7x4&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHlaxnVdwXgxbEf1R2BoxHmHgeb-hCn9qkwHOnXhdR2yw&oe=6A804FEF"}, "display_name": "Mystery Box VR: Hidden Secrets", "keywords": [], "long_description": " AN IMMERSIVE VR PUZZLE EXPERIENCE\nInteract with objects, handles, buttons, and wheels on each side. Crack enigmas and collect hidden puzzle tiles on a random side of the boxes.\n\nYou won't be able to compare reality with fiction.\n\n# DISCOVER INVENTIONS\nOnce you unlock all 8 boxes of a Level Pack, you can compose a puzzle and discover a brief history of an invention.\n\nIt's not always easy to escape the room, so use all your IQ to crack the riddles. There's a logic behind all of them, even where it seems it's not!\n\n# IMMERSIVE SOUNDTRACK\nPlay the game with your headphones to get immersed in this amazing adventure.\n\n# HINTS\nGot stuck on some enigma? No worries, you can still get a helpful hint! You can also get in touch with me in case you really can't make it through a riddle, I'll be glad to help ;)\n\n# MULTILANGUAGE\nAvailable in English, French, Italian, German, Spanish, Russian, and Japanese.\n\nThe game language will change automatically based on the language settings of your device", "short_description": "A VR escape room game where you have to solve intriguing riddles to open boxes and discover nice stories about popular inventions!"}, {"images": {"nodes": [{"file_name": "$R36BSY5.png", "id": "3678762505771822", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/39031430_3678762509105155_2151975047074617165_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IePZYcabk4AQ7kNvwFxx_vL&_nc_oc=AdqwHPfT3mtNmfZugaNpkrjk9UC2gRBDUsOEOmSvyLuHdq3kPRMULKjHCl3isWAuSlE&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGMIipJ29HJsGUomp6sT3QamS19doi3-SMYhxAp8xh4qQ&oe=6A804BE5"}, {"file_name": "$R81V725.png", "id": "2720695481426567", "image_type": "APP_IMG_ICON", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/75262743_2720695484759900_604086922326600035_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0ReQfUKVOsMQ7kNvwEMM7Vu&_nc_oc=AdpQgkej38SKANiFXw85rjtR62FebSKPZkW7zMlFYw1VNtM5898txA2HRcrN1UwkrWY&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHuIiLDwW0mRCRf3tA2lPR6PGqpXe7_7GhGSW8uJ8Bb9w&oe=6A804ACD"}, {"file_name": "$RQ3SN6U.png", "id": "1552311425628973", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38982519_1552311428962306_1218130395049083834_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rXasxUfX2bwQ7kNvwFwDPBK&_nc_oc=AdrWEKk_ZvWBK-ITnJ67KEOEArLlFrqajgPawWjeMCiYiaYPpO4a1u24V9CkHoKRlXs&_nc_zt=3&_nc_ht=
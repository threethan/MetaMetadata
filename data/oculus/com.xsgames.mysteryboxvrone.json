NHZvVG5QZtAzxCxk3j8sNovVQ-A2jjwuobtq1SpYpR2A&oe=6AE4B444"}, {"file_name": "5.png", "id": "467916352871409", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39003282_467916356204742_1871921057092171900_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_mNb3kctKG0Q7kNvwGLdGmT&_nc_oc=Adq1ZQTRuuBvzk6WioEg6BjI7roV_FVBfMK-xacbdEdit0zCE6ds7s5f87X_unPGBmo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM10tR6MR3HchdxUDWKAwt0EJruRhtNURKPJLaJm3LBbQ&oe=6AE498E2"}, {"file_name": "3.png", "id": "1934382610375855", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974473_1934382613709188_7156337812617042679_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IeixxBK3TOUQ7kNvwHxWtJX&_nc_oc=Adqp2aAz2AX0t0ncGKuuv_WyTVymIXWWIkzaiMmEZqo3mFVLHtU7N4drEoqU5Qhr55w&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPC02iprZ7MC5A88f4AT4hpUr2ILMjUljH5GsunnlwALA&oe=6AE4BB33"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape.png", "id": "1524760081483769", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974531_1524760084817102_6497712644828891067_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iF8cQ6D866cQ7kNvwG0pYud&_nc_oc=AdrJORQFm1_kUrxIAqlBK8fXiCmqG28o569wwifq1JC7huoekxNWVRQBzSt8U7HTk34&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPkMZGS71XmVN-kjBuiG_h4C4YWnMq-DIJDyIogPteoKg&oe=6AE4BA2F"}, "display_name": "Mystery Box VR: Hidden Secrets", "keywords": [], "long_description": " AN IMMERSIVE VR PUZZLE EXPERIENCE\nInteract with objects, handles, buttons, and wheels on each side. Crack enigmas and collect hidden puzzle tiles on a random side of the boxes.\n\nYou won't be able to compare reality with fiction.\n\n# DISCOVER INVENTIONS\nOnce you unlock all 8 boxes of a Level Pack, you can compose a puzzle and discover a brief history of an invention.\n\nIt's not always easy to escape the room, so use all your IQ to crack the riddles. There's a logic behind all of them, even where it seems it's not!\n\n# IMMERSIVE SOUNDTRACK\nPlay the game with your headphones to get immersed in this amazing adventure.\n\n# HINTS\nGot stuck on some enigma? No worries, you can still get a helpful hint! You can also get in touch with me in case you really can't make it through a riddle, I'll be glad to help ;)\n\n# MULTILANGUAGE\nAvailable in English, French, Italian, German, Spanish, Russian, and Japanese.\n\nThe game language will change automatically based on the language settings of your device", "short_description": "A VR escape room game where you have to solve intriguing riddles to open boxes and discover nice stories about popular inventions!"}, {"images": {"nodes": [{"file_name": "$R36BSY5.png", "id": "3678762505771822", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031430_3678762509105155_2151975047074617165_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qq6PUHIdOj4Q7kNvwGQ2ubO&_nc_oc=Adohq3Uwc7C67AWFidJszs5XcWsLV-y_gBL629IGD1kkyBsInOdsfBbmJWYKkFPeV3I&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNkc9jhONzEZDlx6o-I6ZQ5lHZBeqJi-y1b5hYpf6-UqQ&oe=6AE4B625"}, {"file_name": "$R81V725.png", "id": "2720695481426567", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75262743_2720695484759900_604086922326600035_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aLnZjC3dTA0Q7kNvwGmzVIa&_nc_oc=Ado7HjIaMQO7cQ5pBl-P-cTqpMSPd4MqJ-Nt6q8E7P2gytcQF1fZQOJLlrmA9UVCOYc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPzSYREaAwxtM3_uLHy4A0yDvPZ02u_Yuir-xcIUlA4Uw&oe=6AE4B50D"}, {"file_name": "$RQ3SN6U.png", "id": "1552311425628973", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982519_1552311428962306_1218130395049083834_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BrYZg0ipzK8Q7kNvwG0k9p9&_nc_oc=AdrgZ234gU9aNDGNYcZddIcKdDbHY5a5iwv4S5sMnoTo8Zwp475uz1yaEJnyDM0eAKw&_nc_zt=3&_nc_ht=
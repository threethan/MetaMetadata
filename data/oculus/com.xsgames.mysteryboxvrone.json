-n9JgKmTBAtX6K4rWkmooqdTDdu9JZDJO2E7JPZK0RWQ&oe=6A2EC544"}, {"file_name": "5.png", "id": "467916352871409", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39003282_467916356204742_1871921057092171900_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5KzEtlYn7eUQ7kNvwG7Sw-r&_nc_oc=Adp15uYZ3oxJyJVbBy7xRpa5J8uv8luC55aVHouDp-joTWBI3MBG3r76k5thIhw_7k4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_FGiJHXHusR1buxrMxDbDXEw_PsFIyBrMCq9s9T_fkSQ&oe=6A2EA9E2"}, {"file_name": "3.png", "id": "1934382610375855", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974473_1934382613709188_7156337812617042679_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hZHQ2FjHNqQQ7kNvwE8vayw&_nc_oc=Adr-cVvstGVOCh1pUDrQueB6sKCtQD9O4zN0tflDucKjIDTebNPX9ZIyd5eqPHR-zQI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-_a6o8hyKlLTTrK_UfoRabfTktU_W1X7yQU7PbP3d1LA&oe=6A2ECC33"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape.png", "id": "1524760081483769", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974531_1524760084817102_6497712644828891067_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Zj1GAZR9UHUQ7kNvwGBe7WY&_nc_oc=AdoiAKgEx3eDBqVGYBESJZ1rvYh2xwUQXxPH4quU0_ZmnEeIgjfnyKn8d2xkSgwAAS4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-Nam8wqJFQOXwL_sDgu3-3JAe1SFlda3Z39NQZpo1QeA&oe=6A2ECB2F"}, "display_name": "Mystery Box VR: Hidden Secrets", "keywords": [], "long_description": " AN IMMERSIVE VR PUZZLE EXPERIENCE\nInteract with objects, handles, buttons, and wheels on each side. Crack enigmas and collect hidden puzzle tiles on a random side of the boxes.\n\nYou won't be able to compare reality with fiction.\n\n# DISCOVER INVENTIONS\nOnce you unlock all 8 boxes of a Level Pack, you can compose a puzzle and discover a brief history of an invention.\n\nIt's not always easy to escape the room, so use all your IQ to crack the riddles. There's a logic behind all of them, even where it seems it's not!\n\n# IMMERSIVE SOUNDTRACK\nPlay the game with your headphones to get immersed in this amazing adventure.\n\n# HINTS\nGot stuck on some enigma? No worries, you can still get a helpful hint! You can also get in touch with me in case you really can't make it through a riddle, I'll be glad to help ;)\n\n# MULTILANGUAGE\nAvailable in English, French, Italian, German, Spanish, Russian, and Japanese.\n\nThe game language will change automatically based on the language settings of your device", "short_description": "A VR escape room game where you have to solve intriguing riddles to open boxes and discover nice stories about popular inventions!"}, {"images": {"nodes": [{"file_name": "$R36BSY5.png", "id": "3678762505771822", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031430_3678762509105155_2151975047074617165_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-qZDe3ONweUQ7kNvwFbRn1h&_nc_oc=AdrCrE7BpzjUPLrIPdKRycpQYGAJib3zfxy85W0FkEeTflF9We7WBIdyf9eI8NVnIKQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-IsaKMoIG4jA5lWWOCZijQGfaBleIGjz0pFfDcIdNZUw&oe=6A2EC725"}, {"file_name": "$R81V725.png", "id": "2720695481426567", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75262743_2720695484759900_604086922326600035_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6Mvk1ln67i8Q7kNvwGpQjKL&_nc_oc=Adr5mQErk91dfbu-x8bvLQ1o_jBUQWbFtjWpjvuUvL1cCQ4OgGrTwhkoQ6omm5eJE-c&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9MnSDSxXZ3ELTSGUc8JG-iTtvebg6OIrl0IERMPOssuw&oe=6A2EC60D"}, {"file_name": "$RQ3SN6U.png", "id": "1552311425628973", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982519_1552311428962306_1218130395049083834_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DGkjeuMFwNoQ7kNvwGcFz1e&_nc_oc=AdpTEe1lMr91Gewsg1-I7mKt2yL2PXF4F9Fhw3u7DZIGKJx0kekIYpMwKJvlOrzqAEA&_nc_zt=3&_nc_ht=
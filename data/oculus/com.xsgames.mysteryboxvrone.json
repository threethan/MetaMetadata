oculuscdn.com/v/t64.5771-25/39003282_467916356204742_1871921057092171900_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nNIYA6z0BzgQ7kNvwEy45UH&_nc_oc=AdluWZo7JZez1LDR7OJl2l9Nx6bj0M51UV9DNj2e05FlMc19BcfwLYp-ZiWGcd7tvns&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfwDK_b49hEzkdFJ6g74ryFAbEiroQ59K1VcGSTj32-Lyw&oe=69B802E2"}, {"file_name": "3.png", "id": "1934382610375855", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974473_1934382613709188_7156337812617042679_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dpnxhLi8FlUQ7kNvwGdL0Yw&_nc_oc=AdnNh9ES0rdB0hbxPRviNlD2Ot46X4L8Weus4ERr99nI3WqVkwonVX3ODk6zCWnbLr4&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfzstNIHo9gA6YNhkhpTjMAdRHDt7QlQlqKWJaYu0ueKoA&oe=69B7ECF3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape.png", "id": "1524760081483769", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974531_1524760084817102_6497712644828891067_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Rs3FlcN1C9oQ7kNvwHJdGoY&_nc_oc=AdkjDojC5CtLhTq8L4bLqCsEQVeLotykzqRTykBIVoridtqXtfb4g_YdjHOBmbHQsdE&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfzLITYRHoLkNhNAGTN1ytba85AxvAXJX5OQQJrJYWeWHg&oe=69B7EBEF"}, "display_name": "Mystery Box VR: Hidden Secrets", "keywords": [], "long_description": " AN IMMERSIVE VR PUZZLE EXPERIENCE\nInteract with objects, handles, buttons, and wheels on each side. Crack enigmas and collect hidden puzzle tiles on a random side of the boxes.\n\nYou won't be able to compare reality with fiction.\n\n# DISCOVER INVENTIONS\nOnce you unlock all 8 boxes of a Level Pack, you can compose a puzzle and discover a brief history of an invention.\n\nIt's not always easy to escape the room, so use all your IQ to crack the riddles. There's a logic behind all of them, even where it seems it's not!\n\n# IMMERSIVE SOUNDTRACK\nPlay the game with your headphones to get immersed in this amazing adventure.\n\n# HINTS\nGot stuck on some enigma? No worries, you can still get a helpful hint! You can also get in touch with me in case you really can't make it through a riddle, I'll be glad to help ;)\n\n# MULTILANGUAGE\nAvailable in English, French, Italian, German, Spanish, Russian, and Japanese.\n\nThe game language will change automatically based on the language settings of your device", "short_description": "A VR escape room game where you have to solve intriguing riddles to open boxes and discover nice stories about popular inventions!"}, {"images": {"nodes": [{"file_name": "$R36BSY5.png", "id": "3678762505771822", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031430_3678762509105155_2151975047074617165_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=znCUPmUK3ZoQ7kNvwHvRB5G&_nc_oc=AdmURRxiP8kahguHjviB4IqW3YnwIm-UPr2tSmsaDsEpX7QesS1beMpi_PS9CMFGBCo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfwUDlfEgdlumfnKd6MNVlXIwJJLnKVe9_8P1CAUsT0AXg&oe=69B7E7E5"}, {"file_name": "$R81V725.png", "id": "2720695481426567", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75262743_2720695484759900_604086922326600035_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UpDarz2DELsQ7kNvwEJ-HMR&_nc_oc=Adl9v1tHpzoJA8XWB5vdY8uBiavdyAJkm4m-zcxU7PC9PKXuRm4FRrddXu6SU7XhR8c&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfwS7dR0ett77Kf4aoI_b_iDfiuTYWKwf7BnQIq2Vk5x1g&oe=69B7E6CD"}, {"file_name": "$RQ3SN6U.png", "id": "1552311425628973", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982519_1552311428962306_1218130395049083834_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wOmlAPHiR7EQ7kNvwHTpiHq&_nc_oc=AdmJ1QwnwxEOGGZzK7XvEBXNEOBCpoqVD5yEy21K7XFqhtokfWxQGhSy9hjURuED7HM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_Afz-jLNd9uCkcwcN8rFWJrzOvsZDkZTYCWFY-P6rHsvm4g&oe=69B7F229"}, {"file_name": "38982645_1000853181732648_505551742782
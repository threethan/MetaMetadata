oculuscdn.com/v/t64.5771-25/39003282_467916356204742_1871921057092171900_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c095WwueC5sQ7kNvwF3oW7c&_nc_oc=AdmgJOF9GSKAJxYfakrvYV2lXwVCfkePN_PgFL3JTKcL6x4Sg0kKnuboeExnZOZ6wHU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfykCqidh7OpboJbywuAd4UWGfHH0zwtykGGTDy4-i9f1Q&oe=69AEC862"}, {"file_name": "3.png", "id": "1934382610375855", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974473_1934382613709188_7156337812617042679_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lpdja4OjZrkQ7kNvwEjXdGV&_nc_oc=Admt2ArrmgGX46MiQNcM2-M9Nr9mSVBbb4voz3txMO3_hDsClPVbFHbXFXKURcJY1yw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfywPIRAJzE2sy1OwrBX4OiVekF4x_ZXsdi8eGunRC62_A&oe=69AEB273"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape.png", "id": "1524760081483769", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974531_1524760084817102_6497712644828891067_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PPr2kdLCyRUQ7kNvwGKNjy1&_nc_oc=AdkK5HuoYZBSkWORBL3rtgIU_nH6rRirbTv7XvewO2dvattYMfhsfJ8MQpgM6yk-a0k&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afw07AsowIPDj1XWJ9UTSagcSVl15RKBk31EGMIQOnczRw&oe=69AEB16F"}, "display_name": "Mystery Box VR: Hidden Secrets", "keywords": [], "long_description": " AN IMMERSIVE VR PUZZLE EXPERIENCE\nInteract with objects, handles, buttons, and wheels on each side. Crack enigmas and collect hidden puzzle tiles on a random side of the boxes.\n\nYou won't be able to compare reality with fiction.\n\n# DISCOVER INVENTIONS\nOnce you unlock all 8 boxes of a Level Pack, you can compose a puzzle and discover a brief history of an invention.\n\nIt's not always easy to escape the room, so use all your IQ to crack the riddles. There's a logic behind all of them, even where it seems it's not!\n\n# IMMERSIVE SOUNDTRACK\nPlay the game with your headphones to get immersed in this amazing adventure.\n\n# HINTS\nGot stuck on some enigma? No worries, you can still get a helpful hint! You can also get in touch with me in case you really can't make it through a riddle, I'll be glad to help ;)\n\n# MULTILANGUAGE\nAvailable in English, French, Italian, German, Spanish, Russian, and Japanese.\n\nThe game language will change automatically based on the language settings of your device", "short_description": "A VR escape room game where you have to solve intriguing riddles to open boxes and discover nice stories about popular inventions!"}, {"images": {"nodes": [{"file_name": "$R36BSY5.png", "id": "3678762505771822", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031430_3678762509105155_2151975047074617165_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uCjDl7xUpWEQ7kNvwEIk2EH&_nc_oc=AdkZo2yczoyC_MuvatlquzJjLfkH5ktTNUeMFhLvdoNHEuaWBWSn_JbTAIRF9aRJu1A&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfxAd3Vppmf8k3W8vpX3Rl9XHJt4LnkPO-3cqkUxEJfPDw&oe=69AEAD65"}, {"file_name": "$R81V725.png", "id": "2720695481426567", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75262743_2720695484759900_604086922326600035_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zIy1RLhO_wIQ7kNvwG4jgsk&_nc_oc=AdnnKu77wS_gbFefwf1QX-KMxAfzsNUtDv1ApyTcXVehqm7DzPDLoGGeJy0cKVxMTJ0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afx60PcumzEhD2hYruhap9S50Yz1dYv-1kS_t1ksCfVbDA&oe=69AEAC4D"}, {"file_name": "$RQ3SN6U.png", "id": "1552311425628973", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982519_1552311428962306_1218130395049083834_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D0gsCZKDokgQ7kNvwEljLwN&_nc_oc=Adn4HoDl3JR4geF2acLpEvRdw5sPUGqQwGXaX54lYaR7KiQAPJ-m0RTIZCW9Ua1SJV0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfxvYZcFVJqT_7r_wnMkUvTFreOtk3vHUfXMOJzpz3Fz-A&oe=69AEB7A9"}, {"file_name": "38982645_1000853181732648_505551742782
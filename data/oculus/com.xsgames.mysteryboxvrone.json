HLEiViogH6L8laZoYIvxoAMGTy54M31ISz-TfOb3kEfQ&oe=6A901C04"}, {"file_name": "5.png", "id": "467916352871409", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39003282_467916356204742_1871921057092171900_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BM3TwgzpbHYQ7kNvwH8gIly&_nc_oc=AdrvLdNeNpfhlL2TtD3sIC0NHtBtDNSuxYMBz9rm3n99VBdU34mdPsrE2Ixtizryyw8&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEoRN6g7MMzPFhKBNwzOlnuxLzhgY_JVjQfv3qvaroJdA&oe=6A9038E2"}, {"file_name": "3.png", "id": "1934382610375855", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38974473_1934382613709188_7156337812617042679_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jbe3J5WaKn8Q7kNvwGVGS0p&_nc_oc=AdpwAvWMCmixUOPgPYlvrJbRSOA19fwwbw2k-ECeJixcaUAscvZyWiN15_t-pBGzRH8&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGw_GWne5igj58QQWvA6QA4xT5ZPCwDNT5fcqMzt-digg&oe=6A9022F3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape.png", "id": "1524760081483769", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38974531_1524760084817102_6497712644828891067_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4d3YnYNtx_YQ7kNvwElNMBb&_nc_oc=AdowSLtAsLGK5Fn3HItJsYuOPP-Ea0x3rl7PQnMs-hgt9oRorT1n7hGPLqHiL0HoBIQ&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE0WuUVFmiEj2VgIknSrpW2lWFk6tTbfOlvQSiNWx3Gxg&oe=6A9021EF"}, "display_name": "Mystery Box VR: Hidden Secrets", "keywords": [], "long_description": " AN IMMERSIVE VR PUZZLE EXPERIENCE\nInteract with objects, handles, buttons, and wheels on each side. Crack enigmas and collect hidden puzzle tiles on a random side of the boxes.\n\nYou won't be able to compare reality with fiction.\n\n# DISCOVER INVENTIONS\nOnce you unlock all 8 boxes of a Level Pack, you can compose a puzzle and discover a brief history of an invention.\n\nIt's not always easy to escape the room, so use all your IQ to crack the riddles. There's a logic behind all of them, even where it seems it's not!\n\n# IMMERSIVE SOUNDTRACK\nPlay the game with your headphones to get immersed in this amazing adventure.\n\n# HINTS\nGot stuck on some enigma? No worries, you can still get a helpful hint! You can also get in touch with me in case you really can't make it through a riddle, I'll be glad to help ;)\n\n# MULTILANGUAGE\nAvailable in English, French, Italian, German, Spanish, Russian, and Japanese.\n\nThe game language will change automatically based on the language settings of your device", "short_description": "A VR escape room game where you have to solve intriguing riddles to open boxes and discover nice stories about popular inventions!"}, {"images": {"nodes": [{"file_name": "$R36BSY5.png", "id": "3678762505771822", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39031430_3678762509105155_2151975047074617165_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PQnnB5bHV9EQ7kNvwGbrRqR&_nc_oc=AdozyTETCcqV0-8gxrIGFWxj33I8n0vjH_JBK6VJeIwm1owbHrUjso30yZ9o6B3hDWc&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFjG585Ft6cZUfS6P2GT1reuCiKg0il9n6Ag9j0QeBGOA&oe=6A901DE5"}, {"file_name": "$R81V725.png", "id": "2720695481426567", "image_type": "APP_IMG_ICON", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75262743_2720695484759900_604086922326600035_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Wfo7NtJW9LQQ7kNvwEwl1oX&_nc_oc=AdoZ1br751LhIU4anjqz5cBWChjbBQJVCKR26YvB_2oSH19JG0DqRJB45kIyuA2GUMc&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH7USyaVqmIpi51qg1LEhOWTPms5o-3sWAy_oSq9wOgTg&oe=6A901CCD"}, {"file_name": "$RQ3SN6U.png", "id": "1552311425628973", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982519_1552311428962306_1218130395049083834_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f2HaORYpxI4Q7kNvwHtOs5U&_nc_oc=Ado5aRgruAF0O2mmyJpNh-OLFln728YKCJk9PCoGB_PINJ0kKtoW3Pld2alc67oRm_E&_nc_zt=3&_nc_ht=
xE9-IHV0NBwtUoPU5JnRZ4TPMnS025azS7wJYfHpxoYg&oe=69C90984"}, {"file_name": "5.png", "id": "467916352871409", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39003282_467916356204742_1871921057092171900_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2NL8YS9kwaQQ7kNvwELFOcR&_nc_oc=AdrF24md5EvMUGLx3-LweuDi4JcuFpO7C_EqIJXriCObMgXw50Mxs4roiD4ox0aV5uU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfykxEap66NM-s0xPIw-3gWei8hAKJmm0qaBzsMrfGxQfw&oe=69C92662"}, {"file_name": "3.png", "id": "1934382610375855", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974473_1934382613709188_7156337812617042679_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SkNDWoJshjsQ7kNvwHaW9Nk&_nc_oc=Adqpi7azISFM4Rj5chVUpQbxBa4ewGRMYe24Z0NEwkttDxacptX59IEE1X1pnXbh_OQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afxxkxq0RLUatbmrKK6C5JihOzeaTWQiLJU-rcAJ60A7SA&oe=69C91073"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape.png", "id": "1524760081483769", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974531_1524760084817102_6497712644828891067_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kUIExVRwu0QQ7kNvwE4CJ7O&_nc_oc=AdrtEekUxu_OkMBFDwONcthAxCAOxYEr3DvHpIKW4Q__Co5gfnw15IDML8yQOIIS4lg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfztOKpHH24RT2DkwLBd2A3WVHXKip5D94DZnYek3q27kw&oe=69C90F6F"}, "display_name": "Mystery Box VR: Hidden Secrets", "keywords": [], "long_description": " AN IMMERSIVE VR PUZZLE EXPERIENCE\nInteract with objects, handles, buttons, and wheels on each side. Crack enigmas and collect hidden puzzle tiles on a random side of the boxes.\n\nYou won't be able to compare reality with fiction.\n\n# DISCOVER INVENTIONS\nOnce you unlock all 8 boxes of a Level Pack, you can compose a puzzle and discover a brief history of an invention.\n\nIt's not always easy to escape the room, so use all your IQ to crack the riddles. There's a logic behind all of them, even where it seems it's not!\n\n# IMMERSIVE SOUNDTRACK\nPlay the game with your headphones to get immersed in this amazing adventure.\n\n# HINTS\nGot stuck on some enigma? No worries, you can still get a helpful hint! You can also get in touch with me in case you really can't make it through a riddle, I'll be glad to help ;)\n\n# MULTILANGUAGE\nAvailable in English, French, Italian, German, Spanish, Russian, and Japanese.\n\nThe game language will change automatically based on the language settings of your device", "short_description": "A VR escape room game where you have to solve intriguing riddles to open boxes and discover nice stories about popular inventions!"}, {"images": {"nodes": [{"file_name": "$R36BSY5.png", "id": "3678762505771822", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031430_3678762509105155_2151975047074617165_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kMYLg0x_3NgQ7kNvwGdIdbm&_nc_oc=AdohoUMcKWVZSXY4c6RGKglTmL4sgv5c1VIAog00LDRJxYzHl-yjMiXEqQBFbf9xZHE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyUZ2JsFmy17G1YIzLVY4zEUtSEUiIFtkvJZvs3vbWEvQ&oe=69C90B65"}, {"file_name": "$R81V725.png", "id": "2720695481426567", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75262743_2720695484759900_604086922326600035_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b9g5szjVON0Q7kNvwFmIXBz&_nc_oc=AdoReIiLOn8bRD8NzvCUFc2SKX3P28F2mre5h00VpQn4MHSt07V9fC1rB4oFRsBMZg0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afx-i0jZvKlKnudpOfKDEgPxddEy_WlPxb6QGlyhOD4iFw&oe=69C90A4D"}, {"file_name": "$RQ3SN6U.png", "id": "1552311425628973", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982519_1552311428962306_1218130395049083834_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sKuaDkgnPesQ7kNvwHTSNG6&_nc_oc=AdrtTLRH1SjNR0fQPzQ_voXJQeCCnKvEl6I6ellMYc2SloLfdYIXmXWu6qwXlYpErXY&_nc_zt=3&_nc_ht=
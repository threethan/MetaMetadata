KU49PvBYKXj28hurgfYx6nkrEdHd46suEZaOa0MDUIIQ&oe=6AA6BDC4"}, {"file_name": "5.png", "id": "467916352871409", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39003282_467916356204742_1871921057092171900_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0mtlw1ZTugIQ7kNvwGcTDVi&_nc_oc=AdojeQCUM5QASrKBBOd_LsEgqztm2e5mqqb6Pbo7e83rlhmxpe2mQM2Q35qVbXgi1cE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKWvWOOfaEKPsNOODIwE5wE8yOdJz1v3FApXr51VRKLPg&oe=6AA6A262"}, {"file_name": "3.png", "id": "1934382610375855", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974473_1934382613709188_7156337812617042679_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CblUJRquxL0Q7kNvwGW-cJH&_nc_oc=AdrTRJSZtG5rZvWDxN_T2fxMwEmG-1uZ9KTi9Nc4gso4JhpxkgHrclWi-F8pvxePhpw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLwDSdH3G2q9wn8JMFVb_9UIqZ4pwYLjWS5vLcW1ddWAg&oe=6AA6C4B3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape.png", "id": "1524760081483769", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974531_1524760084817102_6497712644828891067_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1UObAv9fq6QQ7kNvwHi9Hac&_nc_oc=AdqfkOY242sBRpIWwKKMfEh90JUjFzuCbtkUt_efD2uDhjM7n9vXjVC_F8dvRsOcjBI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKQuyFUqoeiBBNMbnxUx7IeOUfD7Iqi4t-L-NVCDXuL-w&oe=6AA6C3AF"}, "display_name": "Mystery Box VR: Hidden Secrets", "keywords": [], "long_description": " AN IMMERSIVE VR PUZZLE EXPERIENCE\nInteract with objects, handles, buttons, and wheels on each side. Crack enigmas and collect hidden puzzle tiles on a random side of the boxes.\n\nYou won't be able to compare reality with fiction.\n\n# DISCOVER INVENTIONS\nOnce you unlock all 8 boxes of a Level Pack, you can compose a puzzle and discover a brief history of an invention.\n\nIt's not always easy to escape the room, so use all your IQ to crack the riddles. There's a logic behind all of them, even where it seems it's not!\n\n# IMMERSIVE SOUNDTRACK\nPlay the game with your headphones to get immersed in this amazing adventure.\n\n# HINTS\nGot stuck on some enigma? No worries, you can still get a helpful hint! You can also get in touch with me in case you really can't make it through a riddle, I'll be glad to help ;)\n\n# MULTILANGUAGE\nAvailable in English, French, Italian, German, Spanish, Russian, and Japanese.\n\nThe game language will change automatically based on the language settings of your device", "short_description": "A VR escape room game where you have to solve intriguing riddles to open boxes and discover nice stories about popular inventions!"}, {"images": {"nodes": [{"file_name": "$R36BSY5.png", "id": "3678762505771822", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031430_3678762509105155_2151975047074617165_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a69X5QerOJYQ7kNvwFaMXee&_nc_oc=Adpw3jbu_2cnKklgkfn3F6hgwtg7laXkbU-Xq9YNi7jGdBwNMWKL-t69TWtHW6brrto&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLKat3aCkClv7Us6Kn39ZJy3gySWSn-pG6Hk1DYBLy-8g&oe=6AA6BFA5"}, {"file_name": "$R81V725.png", "id": "2720695481426567", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75262743_2720695484759900_604086922326600035_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7lQ7eg1R9hUQ7kNvwHDMZxp&_nc_oc=AdpYi90xjwdmyfPQbmmFPPw__xcNQM1Y401ReAtWWO7J17ozbSsPoRhyIbrsT3cZq-k&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKPuyO4tuk6ZnAxQJzNZNwa8GsbxpVkRyAr57TDlDzCMw&oe=6AA6BE8D"}, {"file_name": "$RQ3SN6U.png", "id": "1552311425628973", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982519_1552311428962306_1218130395049083834_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wHcABVb4LiYQ7kNvwGp2vnT&_nc_oc=AdpV65_zNerCsYq3NFpHq5E1VedulRwXYXtRavGf-i4Yt_4nSYK30tB-uycIgUZ9xWQ&_nc_zt=3&_nc_ht=
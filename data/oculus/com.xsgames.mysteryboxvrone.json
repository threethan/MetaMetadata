Q95S0uyS-HVu_9HJua8Sg-XnfgxWxESIIMqxgc1Ih9Qw&oe=6AF72944"}, {"file_name": "5.png", "id": "467916352871409", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39003282_467916356204742_1871921057092171900_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=10pBO92NHhEQ7kNvwFq2SAU&_nc_oc=AdqRIVcXw-r86RpF9kR4dmfZK9p4CZqYn34aB__QKo-dPRJjGRJockbQNgWmab67Bsc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRwV390sDw2tPJ2Bc5rxpydhTTmUWmqAAQkEhnXw33Arw&oe=6AF74622"}, {"file_name": "3.png", "id": "1934382610375855", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974473_1934382613709188_7156337812617042679_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HSDiqKByD_UQ7kNvwHhvE7Y&_nc_oc=Ado_Gi-mwE7wDj9YSjDdF8yENBJh323F7ucMtqzb2ko0WYB4_EUtZEyvQYjNeHZVuFk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQPMMrSq3YwBFiZGO4WOlP3FX2tXhnnovmwh8TybzPfZQ&oe=6AF73033"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape.png", "id": "1524760081483769", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974531_1524760084817102_6497712644828891067_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m-RqDXosyyIQ7kNvwEquiUI&_nc_oc=Adp_Hgf-_IrWQO5HOgXqwvzlwdibgl4vRR_w1p7ZlkBThFuMGw7NqOZWqEQFRKnEAJE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSMzRb6GXO0hLITzvPINEQsO9dsKhFCdygEZ01GtUOy3Q&oe=6AF72F2F"}, "display_name": "Mystery Box VR: Hidden Secrets", "keywords": [], "long_description": " AN IMMERSIVE VR PUZZLE EXPERIENCE\nInteract with objects, handles, buttons, and wheels on each side. Crack enigmas and collect hidden puzzle tiles on a random side of the boxes.\n\nYou won't be able to compare reality with fiction.\n\n# DISCOVER INVENTIONS\nOnce you unlock all 8 boxes of a Level Pack, you can compose a puzzle and discover a brief history of an invention.\n\nIt's not always easy to escape the room, so use all your IQ to crack the riddles. There's a logic behind all of them, even where it seems it's not!\n\n# IMMERSIVE SOUNDTRACK\nPlay the game with your headphones to get immersed in this amazing adventure.\n\n# HINTS\nGot stuck on some enigma? No worries, you can still get a helpful hint! You can also get in touch with me in case you really can't make it through a riddle, I'll be glad to help ;)\n\n# MULTILANGUAGE\nAvailable in English, French, Italian, German, Spanish, Russian, and Japanese.\n\nThe game language will change automatically based on the language settings of your device", "short_description": "A VR escape room game where you have to solve intriguing riddles to open boxes and discover nice stories about popular inventions!"}, {"images": {"nodes": [{"file_name": "$R36BSY5.png", "id": "3678762505771822", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031430_3678762509105155_2151975047074617165_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Eejqr2YHEMAQ7kNvwHSquZ7&_nc_oc=AdomkdztsA6qg_8FlS4lQpUWtTCZ92Hx067pDNDCHiR6v6v5g-Q_DUjlEJ8-z4B3Y4M&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR5H-MXw8eqG5JMsqX3U5AsDkC_wii1OyRAKzFQJzI3fQ&oe=6AF72B25"}, {"file_name": "$R81V725.png", "id": "2720695481426567", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75262743_2720695484759900_604086922326600035_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1iP6G2iIr04Q7kNvwGdsFJE&_nc_oc=AdqwLraG8Vbfu1UEjhBBEiYW4lP8lJGvECI8UK9_Shw924RGf7VonRu7VluscwAYGLg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRzwVCmBZU-E0kwSzlz0TAPVEXzvXgm-w9K40FGq54OdA&oe=6AF72A0D"}, {"file_name": "$RQ3SN6U.png", "id": "1552311425628973", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982519_1552311428962306_1218130395049083834_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vSPJdjLqdawQ7kNvwHiuIa5&_nc_oc=AdqsKaay3ZKD3Gr1yVvjFDmmlaz9s3n6H8VmJ8pK2kjphVtesV6bjiTqmliRcTEDR4s&_nc_zt=3&_nc_ht=
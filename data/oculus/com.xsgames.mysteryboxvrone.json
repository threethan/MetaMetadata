Tx9FLzzUo8Z-cbBo4eWn0gMIP-6C_YP90HZSRXYlplXQ&oe=6AE8A8C4"}, {"file_name": "5.png", "id": "467916352871409", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/39003282_467916356204742_1871921057092171900_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=10Tgbi_cgtgQ7kNvwHcF6EY&_nc_oc=AdrFwD1H9DrM1lE8YuOIuTRHEex-SQhl-GAdcGFpNbxKzG6xMp614ZravYgYVB8Ib3g&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRB0Dl3cGhnN6UNmqxr8ZuK8k2ikYAIuCsdcg-AbuWwcw&oe=6AE88D62"}, {"file_name": "3.png", "id": "1934382610375855", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38974473_1934382613709188_7156337812617042679_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k-c6xB5Xq7wQ7kNvwEzrD0-&_nc_oc=AdqramWmLIN1L2UIqPmIEfOH0hjugl7kTn4d1d_VT0UMG_rwaboZUqDSsO17rw25h70&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQtdotSDxekzrV0d_njZ-7OBPaxd3ZjVmUqCjIs_PiMLw&oe=6AE8AFB3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape.png", "id": "1524760081483769", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38974531_1524760084817102_6497712644828891067_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oEPsAm7AwyAQ7kNvwG49QRO&_nc_oc=AdridEI9_RQw3rePd_4Qpz9Sy4SERS3pVabdzGbNZK-ZiYgNJsSmati_80-dBNahRP0&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTzOB9BVGjncK6G28jqsAaumtyT5xoVh12_0uRy2gb3RQ&oe=6AE8AEAF"}, "display_name": "Mystery Box VR: Hidden Secrets", "keywords": [], "long_description": " AN IMMERSIVE VR PUZZLE EXPERIENCE\nInteract with objects, handles, buttons, and wheels on each side. Crack enigmas and collect hidden puzzle tiles on a random side of the boxes.\n\nYou won't be able to compare reality with fiction.\n\n# DISCOVER INVENTIONS\nOnce you unlock all 8 boxes of a Level Pack, you can compose a puzzle and discover a brief history of an invention.\n\nIt's not always easy to escape the room, so use all your IQ to crack the riddles. There's a logic behind all of them, even where it seems it's not!\n\n# IMMERSIVE SOUNDTRACK\nPlay the game with your headphones to get immersed in this amazing adventure.\n\n# HINTS\nGot stuck on some enigma? No worries, you can still get a helpful hint! You can also get in touch with me in case you really can't make it through a riddle, I'll be glad to help ;)\n\n# MULTILANGUAGE\nAvailable in English, French, Italian, German, Spanish, Russian, and Japanese.\n\nThe game language will change automatically based on the language settings of your device", "short_description": "A VR escape room game where you have to solve intriguing riddles to open boxes and discover nice stories about popular inventions!"}, {"images": {"nodes": [{"file_name": "$R36BSY5.png", "id": "3678762505771822", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/39031430_3678762509105155_2151975047074617165_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yWdw9yM2iPoQ7kNvwFo4O78&_nc_oc=AdpgYjyNbX1BzlbqfYInCPNU1ELRIah2kB5zQ4hrrzl2zcq0LPEkIjAh7jVkKpDjZUI&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTGDeazVrwYLk5CRY8y6STJs4t10SCczqYUAcLJwW3REw&oe=6AE8AAA5"}, {"file_name": "$R81V725.png", "id": "2720695481426567", "image_type": "APP_IMG_ICON", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/75262743_2720695484759900_604086922326600035_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6UmypCW4fe8Q7kNvwFum_i1&_nc_oc=AdpkyRdjR6LUk5UkVUs-vTYcIG3mYDiJiy3VltputpHxqOqqwooAUsiThMH_VCd-BBM&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT9RKI4ebEz1Cf_hMTpyn8r9I5GfyYvKFdKBzKgoj_ixg&oe=6AE8A98D"}, {"file_name": "$RQ3SN6U.png", "id": "1552311425628973", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38982519_1552311428962306_1218130395049083834_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jkLJYok55P0Q7kNvwFop2mt&_nc_oc=AdqOBtz46B8bFYnzHten2CX7l3flR-CyfDcEBLKk49VEcGsD-chl4Us9QdZev6pWPIk&_nc_zt=3&_nc_ht=
NTeMqYelwVIKLgqIHrRgOPZthUT3J2Li6m-TnxgYxzTQ&oe=6AC7B344"}, {"file_name": "5.png", "id": "467916352871409", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/39003282_467916356204742_1871921057092171900_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Fx3N4IMeC0EQ7kNvwHuogw7&_nc_oc=Adph3uPg1rMJwD1QuXYfFn7znS3AapOJdnuGjx1DKKo3H3bipNkDrlnJnA-8pUqo_6U&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPQGlaP9YCZUg66N49tjckm9pL2JwlfZJ_5azV5UsTeVQ&oe=6AC797E2"}, {"file_name": "3.png", "id": "1934382610375855", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38974473_1934382613709188_7156337812617042679_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8sBy9lDNLWwQ7kNvwFcQNnE&_nc_oc=AdoNL_3Y9ukwRwzEWVbXx09InvLjskGLr8bHgTB8m1o4-Z6Hc7rXpLSeUe-bNRL0U_s&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMA4V_2IFBU7q-vYA8E9Ep0g7RtakW6JIuym2HxSvrHzA&oe=6AC7BA33"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape.png", "id": "1524760081483769", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38974531_1524760084817102_6497712644828891067_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Qm77SO_d7RAQ7kNvwEQmrlU&_nc_oc=Adrv5KitmCVGqDj429cQopBefKNAFzQf869L_l7RqPyyTWXfFDAQeokxP6VmrSjuqMM&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMnnICc2MqglwMpQvsbai77C77sYx1NXyuFumkvEds2NA&oe=6AC7B92F"}, "display_name": "Mystery Box VR: Hidden Secrets", "keywords": [], "long_description": " AN IMMERSIVE VR PUZZLE EXPERIENCE\nInteract with objects, handles, buttons, and wheels on each side. Crack enigmas and collect hidden puzzle tiles on a random side of the boxes.\n\nYou won't be able to compare reality with fiction.\n\n# DISCOVER INVENTIONS\nOnce you unlock all 8 boxes of a Level Pack, you can compose a puzzle and discover a brief history of an invention.\n\nIt's not always easy to escape the room, so use all your IQ to crack the riddles. There's a logic behind all of them, even where it seems it's not!\n\n# IMMERSIVE SOUNDTRACK\nPlay the game with your headphones to get immersed in this amazing adventure.\n\n# HINTS\nGot stuck on some enigma? No worries, you can still get a helpful hint! You can also get in touch with me in case you really can't make it through a riddle, I'll be glad to help ;)\n\n# MULTILANGUAGE\nAvailable in English, French, Italian, German, Spanish, Russian, and Japanese.\n\nThe game language will change automatically based on the language settings of your device", "short_description": "A VR escape room game where you have to solve intriguing riddles to open boxes and discover nice stories about popular inventions!"}, {"images": {"nodes": [{"file_name": "$R36BSY5.png", "id": "3678762505771822", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/39031430_3678762509105155_2151975047074617165_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u2XexYMM2cQQ7kNvwEJxrcG&_nc_oc=AdrcnjDMDpVemgqIw_0juqIXQPwZ9ZipqyEvc7JzQCVu4sZQhliV-GjFR-ooHiWNrCI&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPPm2Hwbt1hU4fc4odvWiCdDvQCnEzr95CKYqV7OZyS7w&oe=6AC7B525"}, {"file_name": "$R81V725.png", "id": "2720695481426567", "image_type": "APP_IMG_ICON", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/75262743_2720695484759900_604086922326600035_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FdRHVNHxXhAQ7kNvwHZ4aV9&_nc_oc=AdpnQje9af522svVubItE1jfDQ906pK8-GM339plmRqy4waZZ_7ld6SPFJ2BSRfUJCg&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMgn1Wd3qoNOba3Dbbh1eH5aG8nYDAQ0FZ7_ZJXNyofrQ&oe=6AC7B40D"}, {"file_name": "$RQ3SN6U.png", "id": "1552311425628973", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38982519_1552311428962306_1218130395049083834_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c-4TLDjhyUsQ7kNvwGdGlAJ&_nc_oc=AdoGixoUxUUyWnAogd877gg8UCjW-no2s0jr-45RzGRp7p8xx2MmZPqWKQKTd7Z3C5A&_nc_zt=3&_nc_ht=
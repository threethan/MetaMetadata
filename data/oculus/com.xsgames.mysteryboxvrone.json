30zfThx_peisKZYgQoBpoZGL5AiCe-OOdRjPe7rM-X0g&oe=69DE2184"}, {"file_name": "5.png", "id": "467916352871409", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39003282_467916356204742_1871921057092171900_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2xW7RFYK8FcQ7kNvwH0_Rnl&_nc_oc=AdpvVu80lsDxlaeww-_2XUmVsKGppv47Px8M-V4_qkInJrdgzyXpvBIp2nfcUMJNJg4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1XqYzGoRy8GHB-_bUD2ds8hexIHrBL1co7w3gZOP61Ww&oe=69DE3E62"}, {"file_name": "3.png", "id": "1934382610375855", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974473_1934382613709188_7156337812617042679_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5tPaQvxgezsQ7kNvwHA9mno&_nc_oc=AdoXDCxWKVfjsb5TxOISvlwNWsuxMLYDS9SDGxbpZ7cBx0kqn1TY7m0wws3ppXmQbSA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2hfpp__viGPGD4dOx7ZlfUU2Da0U3P4NQTQg7jH7dzdA&oe=69DE2873"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape.png", "id": "1524760081483769", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974531_1524760084817102_6497712644828891067_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RV6LqbxZfH0Q7kNvwHPGZsE&_nc_oc=Adqk8h2aUPrGsSF0kEqEw6eKjXiTNPoqojTx-2bCQ3-qBNHW-wCnWj5nAPWa3H65acA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3zwtDKgmiqZd89-1YPJ34O4ovAJls9NgXniAWlQZmnQg&oe=69DE276F"}, "display_name": "Mystery Box VR: Hidden Secrets", "keywords": [], "long_description": " AN IMMERSIVE VR PUZZLE EXPERIENCE\nInteract with objects, handles, buttons, and wheels on each side. Crack enigmas and collect hidden puzzle tiles on a random side of the boxes.\n\nYou won't be able to compare reality with fiction.\n\n# DISCOVER INVENTIONS\nOnce you unlock all 8 boxes of a Level Pack, you can compose a puzzle and discover a brief history of an invention.\n\nIt's not always easy to escape the room, so use all your IQ to crack the riddles. There's a logic behind all of them, even where it seems it's not!\n\n# IMMERSIVE SOUNDTRACK\nPlay the game with your headphones to get immersed in this amazing adventure.\n\n# HINTS\nGot stuck on some enigma? No worries, you can still get a helpful hint! You can also get in touch with me in case you really can't make it through a riddle, I'll be glad to help ;)\n\n# MULTILANGUAGE\nAvailable in English, French, Italian, German, Spanish, Russian, and Japanese.\n\nThe game language will change automatically based on the language settings of your device", "short_description": "A VR escape room game where you have to solve intriguing riddles to open boxes and discover nice stories about popular inventions!"}, {"images": {"nodes": [{"file_name": "$R36BSY5.png", "id": "3678762505771822", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031430_3678762509105155_2151975047074617165_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YVFoDO5KZWcQ7kNvwEWTEUR&_nc_oc=AdoD5HbJzCIsjmZyGFyLVIOJGBQf1C2GbFrvnAU20Z_rIgf-UgYScD79i2kdCNbngHc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2gVWOwAZMmpUCG_0VHAHTokSf4yPvhzRXJxkn1epS72A&oe=69DE2365"}, {"file_name": "$R81V725.png", "id": "2720695481426567", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75262743_2720695484759900_604086922326600035_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C1uhwJC9RV4Q7kNvwFz5HXS&_nc_oc=Adod5Z0g5jHHYdZpvayN5Wejx0Rr_KLgIvIAf0059k77aFUI81a4unqRVrTkPkzNvvM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2-nr2R_HGvYe84JG9Vai8kpmzAnAtgY3jqtgYiLSonDA&oe=69DE224D"}, {"file_name": "$RQ3SN6U.png", "id": "1552311425628973", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982519_1552311428962306_1218130395049083834_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XmWbYQn0rpEQ7kNvwHDlIqY&_nc_oc=AdpRXC9b0dGB5_Xkky359HNN-D80hPh4gwIwvMKGc1GvmykiGIODBzl_IUhabIoHTK0&_nc_zt=3&_nc_ht=
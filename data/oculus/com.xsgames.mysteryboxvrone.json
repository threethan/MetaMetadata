3l-A&oe=69A58DE2"}, {"file_name": "3.png", "id": "1934382610375855", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974473_1934382613709188_7156337812617042679_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sxauZFBfxmMQ7kNvwGCjHuO&_nc_oc=AdkBnjAuuzGQKJOfRtLFY1zLaH3wNeJy-XiAGt4arErbRrtawooDlQDECbh7WSP31vs&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&oh=00_Afu_vEtiq1-R0eAxJUDRX7ipQ1o4FhENe8Cj1aOs6LZEpQ&oe=69A577F3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape.png", "id": "1524760081483769", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974531_1524760084817102_6497712644828891067_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gnG27X-rzggQ7kNvwGD6Yx-&_nc_oc=AdlEqfGQCty3qJngVGDMEVu-W92CJMBnw7BnYZPcIPNSyPJ-nN8B6lEcEw9RrMxPN00&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&oh=00_AftOPuiEuCgJ3mxqpyiwr1uVlKUh2aWaJWarYCYL6v_iAA&oe=69A576EF"}, "display_name": "Mystery Box VR: Hidden Secrets", "keywords": [], "long_description": " AN IMMERSIVE VR PUZZLE EXPERIENCE\nInteract with objects, handles, buttons, and wheels on each side. Crack enigmas and collect hidden puzzle tiles on a random side of the boxes.\n\nYou won't be able to compare reality with fiction.\n\n# DISCOVER INVENTIONS\nOnce you unlock all 8 boxes of a Level Pack, you can compose a puzzle and discover a brief history of an invention.\n\nIt's not always easy to escape the room, so use all your IQ to crack the riddles. There's a logic behind all of them, even where it seems it's not!\n\n# IMMERSIVE SOUNDTRACK\nPlay the game with your headphones to get immersed in this amazing adventure.\n\n# HINTS\nGot stuck on some enigma? No worries, you can still get a helpful hint! You can also get in touch with me in case you really can't make it through a riddle, I'll be glad to help ;)\n\n# MULTILANGUAGE\nAvailable in English, French, Italian, German, Spanish, Russian, and Japanese.\n\nThe game language will change automatically based on the language settings of your device", "short_description": "A VR escape room game where you have to solve intriguing riddles to open boxes and discover nice stories about popular inventions!"}, {"images": {"nodes": [{"file_name": "$R36BSY5.png", "id": "3678762505771822", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39031430_3678762509105155_2151975047074617165_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mKl5I_PCVRUQ7kNvwGZEezJ&_nc_oc=AdmLVKOpvZiS9ml9BgAmgdapy0dUj5_vBuFupCr79OVLp3qBiMGcnxmD7E9aLvERdPY&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_AfuU7U9AhxwRU6VLCQWk1vLu8Q0TNguXXiXNfZxLGGN7dg&oe=69A572E5"}, {"file_name": "$R81V725.png", "id": "2720695481426567", "image_type": "APP_IMG_ICON", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/75262743_2720695484759900_604086922326600035_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XNhMdQEdOLQQ7kNvwFmiciA&_nc_oc=AdnLpJ8aAg82BOX_SIrCUM79PoP13zcY45aPhImrINnS57xdUN-DJCfIuq0yEKk984w&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_AfuZVYPgKAuTgKO7OshRzUxIcSoBFm4o_0c8w77xuBWeOA&oe=69A571CD"}, {"file_name": "$RQ3SN6U.png", "id": "1552311425628973", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38982519_1552311428962306_1218130395049083834_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RqvImO5dZ5AQ7kNvwF6C43_&_nc_oc=Adl7ebIOanvCJ9aY5vYYgTcMEQJ4COTKHZVCwMV58GLQvsvnIk74cCQ1AJj5WnAYAek&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_AfsnyWbddeYMOHO3heoKfoAuGYsV9Pj4yEXRaalidckwVA&oe=69A57D29"}, {"file_name": "38982645_1000853181732648_5055517427829171192_n.png", "id": "1043990680394008", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39031625_1043990683727341_3557431131423146005_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r_fpF86hMDoQ7kNvwGN0jQ_&_nc_oc=AdkW1LAJsZ78Y7iQ1HxR2uLzSJsPR1rFUAj396v0g4WynHwMSL4-DQqklnXu5BJG2Uo&_nc_zt=3&_nc_ht=scontent-atl3-2
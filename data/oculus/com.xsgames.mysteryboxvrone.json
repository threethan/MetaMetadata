r6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEfnOUIfN145aCUqmrjEwMavnIA4U8QMuxpFza9yeE-Jw&oe=6A8D7904"}, {"file_name": "5.png", "id": "467916352871409", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/39003282_467916356204742_1871921057092171900_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J0IvyZF5fu8Q7kNvwG_rehl&_nc_oc=AdrNRopkoyoM_HNw-f3MyRA_93KobRhwkHVeCdvM6gJUP1NiA-EZZPQS6pmv6LIzfcM&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFF9rKKw60nCUDjjWdde708Y00OgDMEUlm3qmB1rzHAaQ&oe=6A8D95E2"}, {"file_name": "3.png", "id": "1934382610375855", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/38974473_1934382613709188_7156337812617042679_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jbe3J5WaKn8Q7kNvwGZvKmI&_nc_oc=AdpPTxpwFhZkX_KziVaOvN8heNg8unrAUAmU34YSdSkReGyAwx5czo7JIHE_L4LDj48&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHxJ0nRR0WSDnQs8PVhgnjzHfe9GNE50oHFnEiDpqBkrg&oe=6A8D7FF3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape.png", "id": "1524760081483769", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/38974531_1524760084817102_6497712644828891067_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kAPrwTQO1PwQ7kNvwGaFXeQ&_nc_oc=AdqjzIDbpXKPLs7h5S1btQ7ZT0YbFdBad8ALmMrpQ80fAlK3nKaHchY_RZPs3XE2XMw&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGvKmLHaghIOYQKaDwq-ZH-WP1mISmQK3kUQ3tog69X9g&oe=6A8D7EEF"}, "display_name": "Mystery Box VR: Hidden Secrets", "keywords": [], "long_description": " AN IMMERSIVE VR PUZZLE EXPERIENCE\nInteract with objects, handles, buttons, and wheels on each side. Crack enigmas and collect hidden puzzle tiles on a random side of the boxes.\n\nYou won't be able to compare reality with fiction.\n\n# DISCOVER INVENTIONS\nOnce you unlock all 8 boxes of a Level Pack, you can compose a puzzle and discover a brief history of an invention.\n\nIt's not always easy to escape the room, so use all your IQ to crack the riddles. There's a logic behind all of them, even where it seems it's not!\n\n# IMMERSIVE SOUNDTRACK\nPlay the game with your headphones to get immersed in this amazing adventure.\n\n# HINTS\nGot stuck on some enigma? No worries, you can still get a helpful hint! You can also get in touch with me in case you really can't make it through a riddle, I'll be glad to help ;)\n\n# MULTILANGUAGE\nAvailable in English, French, Italian, German, Spanish, Russian, and Japanese.\n\nThe game language will change automatically based on the language settings of your device", "short_description": "A VR escape room game where you have to solve intriguing riddles to open boxes and discover nice stories about popular inventions!"}, {"images": {"nodes": [{"file_name": "$R36BSY5.png", "id": "3678762505771822", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/39031430_3678762509105155_2151975047074617165_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XOkwkKMXEFYQ7kNvwHgFuR-&_nc_oc=AdrXlwxJJA5JHam_Jj1jTcpn0FXcviAtejDoifMqpAOOWN8KE9IG-7hBxNR2SJHJWfA&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGu25_F9_UU5RdohCeupt2_O-es44DqYh1XgQb0cxfXYg&oe=6A8D7AE5"}, {"file_name": "$R81V725.png", "id": "2720695481426567", "image_type": "APP_IMG_ICON", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/75262743_2720695484759900_604086922326600035_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Wfo7NtJW9LQQ7kNvwEgY7wh&_nc_oc=AdqfANh_Wi0yAxJylcxQJZ6j7B-8c6NJjFQKgbGhtba6ZNyIoo6AunAsZKE2K8m6w1U&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEUpYoNk5S-qdcln58f2DawC4z0SlcyoCyqulFgbNk2yw&oe=6A8D79CD"}, {"file_name": "$RQ3SN6U.png", "id": "1552311425628973", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/38982519_1552311428962306_1218130395049083834_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HCyHiYncnQYQ7kNvwE4-jOA&_nc_oc=AdoIxAoUSqiLGKlHPB6nzAYmJXdFUhwo5tVxiwu
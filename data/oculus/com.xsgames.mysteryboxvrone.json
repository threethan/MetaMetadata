1PlzpHi_uOAoLrq69OB8coG7LPs1f0i1oZ9B5YWhUxXg&oe=69E24E44"}, {"file_name": "5.png", "id": "467916352871409", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/39003282_467916356204742_1871921057092171900_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c4R1xlAu_aEQ7kNvwFoJOsJ&_nc_oc=AdoBVbc2jbet2zqa7IEZdHYk5c7LDRTbHIWcTX5O2c2qoaelktdab9DSQlIISjSTPzY&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2fe_UTOWNshOtYzUT5ggr6f8x12h8vvXdL8yAeNiSs5g&oe=69E232E2"}, {"file_name": "3.png", "id": "1934382610375855", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/38974473_1934382613709188_7156337812617042679_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dj5KnVXF7AIQ7kNvwGd3Jbh&_nc_oc=AdrYJC0KpxI-IDVL4EkBaUAuoQ5M9F1kYC42aQpmLcplKYt0J05I0gWk4PKiEZX6KKg&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3VBQwnsgQgHhDfh_fpL54P7BhSiuqerQNvZbR9mLjgaQ&oe=69E21CF3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape.png", "id": "1524760081483769", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/38974531_1524760084817102_6497712644828891067_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wUleitmcP6AQ7kNvwGUrJWd&_nc_oc=AdoV-YmATnIs_rRvmKs6x-6WuIYqZ6-d10Zd3ueFI8kY0L84lJ_KrK8nwCTXmQ-CX-A&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2ynU9_Z0Dv4XQX8D0zme7aAqevjuF2fCk6TVOxakn0_Q&oe=69E21BEF"}, "display_name": "Mystery Box VR: Hidden Secrets", "keywords": [], "long_description": " AN IMMERSIVE VR PUZZLE EXPERIENCE\nInteract with objects, handles, buttons, and wheels on each side. Crack enigmas and collect hidden puzzle tiles on a random side of the boxes.\n\nYou won't be able to compare reality with fiction.\n\n# DISCOVER INVENTIONS\nOnce you unlock all 8 boxes of a Level Pack, you can compose a puzzle and discover a brief history of an invention.\n\nIt's not always easy to escape the room, so use all your IQ to crack the riddles. There's a logic behind all of them, even where it seems it's not!\n\n# IMMERSIVE SOUNDTRACK\nPlay the game with your headphones to get immersed in this amazing adventure.\n\n# HINTS\nGot stuck on some enigma? No worries, you can still get a helpful hint! You can also get in touch with me in case you really can't make it through a riddle, I'll be glad to help ;)\n\n# MULTILANGUAGE\nAvailable in English, French, Italian, German, Spanish, Russian, and Japanese.\n\nThe game language will change automatically based on the language settings of your device", "short_description": "A VR escape room game where you have to solve intriguing riddles to open boxes and discover nice stories about popular inventions!"}, {"images": {"nodes": [{"file_name": "$R36BSY5.png", "id": "3678762505771822", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/39031430_3678762509105155_2151975047074617165_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A3RfYpNNg94Q7kNvwFGTV_u&_nc_oc=Adq17LDpbzL7PbzREc_KXUyRo05PIN0s1Sbu14SlN61QkrbSZ08A63JiMrIzWYXwn7I&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1L0z9dQ2BPMSk0MHNn0dzFMQq-23FmQHiCYq-_19AvOA&oe=69E25025"}, {"file_name": "$R81V725.png", "id": "2720695481426567", "image_type": "APP_IMG_ICON", "uri": "https://scontent-lhr8-1.oculuscdn.com/v/t64.5771-25/75262743_2720695484759900_604086922326600035_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EZGaiXNV2GUQ7kNvwESHZVs&_nc_oc=AdpnFKoBM3jBM6MlSdB5SyryP9hiaZJW68TrwYaQR0i9p7ubWU5aXGLEt2Yssx339zk&_nc_zt=3&_nc_ht=scontent-lhr8-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3HZYUUou2j6pMgNyAyasUMx6VbcooMWY0SbJsFHKXGXQ&oe=69E24F0D"}, {"file_name": "$RQ3SN6U.png", "id": "1552311425628973", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-lhr8-1.oculuscdn.com/v/t64.5771-25/38982519_1552311428962306_1218130395049083834_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wjGHhjMEfi4Q7kNvwE-dohl&_nc_oc=AdojpWwB6vDrDJD--cYjq9m02glDJpOfMc5mzsDznS0eC_ZiwAVbSFzFvRVCiuLh_U8&_nc_zt=3&_nc_ht=
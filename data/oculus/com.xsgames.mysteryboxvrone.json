KjUIaUle5ipsCMomXOugjO5r1uWtnQGkR4eRWZFW6Hmw&oe=6A983D44"}, {"file_name": "5.png", "id": "467916352871409", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39003282_467916356204742_1871921057092171900_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TiNLFfe1Qb0Q7kNvwF9w_5P&_nc_oc=Adpzrgo7YWz7ywTkcOtl0vUnr7adIjGRCmamQJAtjmTdyUJmATlPQNtDsV3jdPjL5oI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIGedI5fRkqJDuamYGTpqs011nQQcfDRTS76yh13jvXyQ&oe=6A985A22"}, {"file_name": "3.png", "id": "1934382610375855", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974473_1934382613709188_7156337812617042679_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UgWEJ_CnWL8Q7kNvwHVkI70&_nc_oc=AdrSufogMq8J6MWMWle_BlluO7NDaGISpgk6cszdkXw9hMbmCHUpCxxMY7xl7o80dsU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIumkzZj29sEFPaRVx2fHqcPQM7i3vSO2h8YkVtSQMLFA&oe=6A984433"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape.png", "id": "1524760081483769", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974531_1524760084817102_6497712644828891067_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iFqw4STvjO8Q7kNvwFAAHKR&_nc_oc=AdpK-Vyg_ZsBI6YUlksNozCsNDi-AxpUArPS1rpzTp7IvKHUQXDEC_SJ7Bu1JPO9vuc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJZpf5BUPLwDGOwHLvMK3klX5jZvFi-xHd5SW7S59Md-A&oe=6A98432F"}, "display_name": "Mystery Box VR: Hidden Secrets", "keywords": [], "long_description": " AN IMMERSIVE VR PUZZLE EXPERIENCE\nInteract with objects, handles, buttons, and wheels on each side. Crack enigmas and collect hidden puzzle tiles on a random side of the boxes.\n\nYou won't be able to compare reality with fiction.\n\n# DISCOVER INVENTIONS\nOnce you unlock all 8 boxes of a Level Pack, you can compose a puzzle and discover a brief history of an invention.\n\nIt's not always easy to escape the room, so use all your IQ to crack the riddles. There's a logic behind all of them, even where it seems it's not!\n\n# IMMERSIVE SOUNDTRACK\nPlay the game with your headphones to get immersed in this amazing adventure.\n\n# HINTS\nGot stuck on some enigma? No worries, you can still get a helpful hint! You can also get in touch with me in case you really can't make it through a riddle, I'll be glad to help ;)\n\n# MULTILANGUAGE\nAvailable in English, French, Italian, German, Spanish, Russian, and Japanese.\n\nThe game language will change automatically based on the language settings of your device", "short_description": "A VR escape room game where you have to solve intriguing riddles to open boxes and discover nice stories about popular inventions!"}, {"images": {"nodes": [{"file_name": "$R36BSY5.png", "id": "3678762505771822", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031430_3678762509105155_2151975047074617165_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Om1R5LOiU2sQ7kNvwGVsyu2&_nc_oc=AdocwEk8GqpLrO6NownJJOYAa53xbkUlrE8UtR5-pLyWPigjLrSOkJEb35WtHfUmwkg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKWTffVbBgR8Fo2Soa7GYuN9zLjx3RmmDPYDr2n0_4ZKw&oe=6A983F25"}, {"file_name": "$R81V725.png", "id": "2720695481426567", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75262743_2720695484759900_604086922326600035_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OeCk1Ie9r7UQ7kNvwFCkqaO&_nc_oc=AdoUrsUHmAJB2vsDHsPHVemO0RtzoayU-yqHRZa7sQu82CoWTm3s8UtZOM6qyI9DIwo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKnhSWg9h5YvujPxEJl8DmbrPMlqX4QsIFBKOxAXND69Q&oe=6A983E0D"}, {"file_name": "$RQ3SN6U.png", "id": "1552311425628973", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982519_1552311428962306_1218130395049083834_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XN-WQH1ndEcQ7kNvwEdMoWU&_nc_oc=AdqckYFxc1B-vvQGX9a6Nzpm0MADaZkMHhVVaRVHhceFJoFmweeFuPbSCKQbXYKoLl4&_nc_zt=3&_nc_ht=
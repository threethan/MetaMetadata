3NRYnrEIoNaoudFZXaWlyUT8_gB3GjBhcIYJQnN3Cy7g&oe=69D78A04"}, {"file_name": "5.png", "id": "467916352871409", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/39003282_467916356204742_1871921057092171900_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-_AhFsnGvUIQ7kNvwEkAjbK&_nc_oc=AdqByyXGYVa9dLTebsGWi7-jt9-UCFOCeCZwXdoxu9r0ip6TQkLkjl4Xu3TheQSssPY&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0NhCvSZ-bOkQnFSU7dphOl8yfIUeTHWmJgIMMKDO5QAQ&oe=69D7A6E2"}, {"file_name": "3.png", "id": "1934382610375855", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/38974473_1934382613709188_7156337812617042679_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dgRRQTuDp4YQ7kNvwFknZlG&_nc_oc=Adpc2QXVmLhcjYEa-J0Kg9RHHjm2qTvjYlDh-YeLdyRLNj8hksjaFZYgOuCwH-j2DEk&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3TN9ko8e10wiig_eS5rvW-I9H9hJW-oQikhCymnCUMjQ&oe=69D790F3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape.png", "id": "1524760081483769", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/38974531_1524760084817102_6497712644828891067_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CJfFlCRxjgkQ7kNvwHCAW4P&_nc_oc=AdpKHp7uHLP5x3KIiyihu4Ja-crVUFh0NXfIdjs0WupNJ7OYRVieYw36fMJ4q-OkyOs&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1GDBn1kihemOpbELV5Zm3TZWGFWIII1LtEOWXrd3vP7Q&oe=69D78FEF"}, "display_name": "Mystery Box VR: Hidden Secrets", "keywords": [], "long_description": " AN IMMERSIVE VR PUZZLE EXPERIENCE\nInteract with objects, handles, buttons, and wheels on each side. Crack enigmas and collect hidden puzzle tiles on a random side of the boxes.\n\nYou won't be able to compare reality with fiction.\n\n# DISCOVER INVENTIONS\nOnce you unlock all 8 boxes of a Level Pack, you can compose a puzzle and discover a brief history of an invention.\n\nIt's not always easy to escape the room, so use all your IQ to crack the riddles. There's a logic behind all of them, even where it seems it's not!\n\n# IMMERSIVE SOUNDTRACK\nPlay the game with your headphones to get immersed in this amazing adventure.\n\n# HINTS\nGot stuck on some enigma? No worries, you can still get a helpful hint! You can also get in touch with me in case you really can't make it through a riddle, I'll be glad to help ;)\n\n# MULTILANGUAGE\nAvailable in English, French, Italian, German, Spanish, Russian, and Japanese.\n\nThe game language will change automatically based on the language settings of your device", "short_description": "A VR escape room game where you have to solve intriguing riddles to open boxes and discover nice stories about popular inventions!"}, {"images": {"nodes": [{"file_name": "$R36BSY5.png", "id": "3678762505771822", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/39031430_3678762509105155_2151975047074617165_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ilpCUmwhlm4Q7kNvwG9N8Lg&_nc_oc=AdqeH9aVdj83L91NEg65VnrkRW_0b54IqdguRkBYQdvJ7XJriiftvWAHgGLEhcyvA2I&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3hRROyt9LqdLXN6i71zzefFcpdD5lF4W-zNk_75we2Rw&oe=69D78BE5"}, {"file_name": "$R81V725.png", "id": "2720695481426567", "image_type": "APP_IMG_ICON", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/75262743_2720695484759900_604086922326600035_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=svA-GaDpOIIQ7kNvwFGdqLo&_nc_oc=AdqGqd_2Jr5oL5kNOssJ9gS52DbbsH9dQ6b7ONqQBey1wPv7YwGcm9OF6C5u20mFyQY&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3Qm74INTP4opVglr1z-a-fusW-Pcl5feYOxAHABms_eQ&oe=69D78ACD"}, {"file_name": "$RQ3SN6U.png", "id": "1552311425628973", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/38982519_1552311428962306_1218130395049083834_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IflNVjOjXwwQ7kNvwF7-nS7&_nc_oc=AdqZ7sRSUTsiUxKBRsxK5utty2ZYv6Fv-tw-ag92dZUWlRAp5jezCLC8pjK2Rn0B6ok&_nc_zt=3&_nc_ht=
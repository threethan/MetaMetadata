-qu8bq5xoZ6hz-rt0rcIXZ9WP5M_oL4AZpJxMiwljykg&oe=6A3016C4"}, {"file_name": "5.png", "id": "467916352871409", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39003282_467916356204742_1871921057092171900_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qZ2JqO2gijoQ7kNvwHAW3iQ&_nc_oc=AdrLGEeGSChT0U-DYBiGpL0F6248gYHevgGAUV-_q2mZZER2py-5H3avbyWzwh2_y9g&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af85ePrQRJE29K5GtcssCvQBPBLX81lF8gsiseJdq8Yxnw&oe=6A2FFB62"}, {"file_name": "3.png", "id": "1934382610375855", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974473_1934382613709188_7156337812617042679_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hZHQ2FjHNqQQ7kNvwHqqltW&_nc_oc=AdqHB2TtF-2F70bDpoVgdL1kL2m1pD-i69xB2P3UBxd9n_g5xrCkkfN9PzzJbRFQgnI&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-xAW_ukAxT0MQBiikiFIewnlmFx1q_mnuEQI49W7gWug&oe=6A301DB3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape.png", "id": "1524760081483769", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974531_1524760084817102_6497712644828891067_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uPRBnKxWONgQ7kNvwFaGjnz&_nc_oc=Ado_bAC5zAPri6rN3uZHCigg7cKsqb9GKiYbUA9TYsbDAiJMwIIxSA0Exdmn9tK2JCw&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-rjUXCt4L6ExmzopuT-h-3HwzjjQXSfmb6i6ES_R_MyQ&oe=6A301CAF"}, "display_name": "Mystery Box VR: Hidden Secrets", "keywords": [], "long_description": " AN IMMERSIVE VR PUZZLE EXPERIENCE\nInteract with objects, handles, buttons, and wheels on each side. Crack enigmas and collect hidden puzzle tiles on a random side of the boxes.\n\nYou won't be able to compare reality with fiction.\n\n# DISCOVER INVENTIONS\nOnce you unlock all 8 boxes of a Level Pack, you can compose a puzzle and discover a brief history of an invention.\n\nIt's not always easy to escape the room, so use all your IQ to crack the riddles. There's a logic behind all of them, even where it seems it's not!\n\n# IMMERSIVE SOUNDTRACK\nPlay the game with your headphones to get immersed in this amazing adventure.\n\n# HINTS\nGot stuck on some enigma? No worries, you can still get a helpful hint! You can also get in touch with me in case you really can't make it through a riddle, I'll be glad to help ;)\n\n# MULTILANGUAGE\nAvailable in English, French, Italian, German, Spanish, Russian, and Japanese.\n\nThe game language will change automatically based on the language settings of your device", "short_description": "A VR escape room game where you have to solve intriguing riddles to open boxes and discover nice stories about popular inventions!"}, {"images": {"nodes": [{"file_name": "$R36BSY5.png", "id": "3678762505771822", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39031430_3678762509105155_2151975047074617165_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-qZDe3ONweUQ7kNvwHtSBSO&_nc_oc=AdqLkut2o6MFKxe4eiEy9-ZQiNYsbW55vtu1kp73ADbXYhu2E54Xhh3b90alNl03dp4&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8D7oKL4y5_BMEdYf8N1dwBi2caq4Yps_tvYHW0ZAn4pQ&oe=6A3018A5"}, {"file_name": "$R81V725.png", "id": "2720695481426567", "image_type": "APP_IMG_ICON", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/75262743_2720695484759900_604086922326600035_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6Mvk1ln67i8Q7kNvwHh2tGt&_nc_oc=AdqfT1JU1PM8T65daQMIb5ljitq1WB-ibvZte8gKl226SmRNHaYG-2go0tuxq5sCpk0&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8NAJATWK_HZu6YfZXDRA5HRIawl2rRGYhUA0-S42Z3aQ&oe=6A30178D"}, {"file_name": "$RQ3SN6U.png", "id": "1552311425628973", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38982519_1552311428962306_1218130395049083834_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DGkjeuMFwNoQ7kNvwEjzeMX&_nc_oc=AdpgUM62djN9w26QFJ-S6IPJxf3l8bl7dmSgZSy-dzh3xYR_9H57dk3dUb9JqYZRtu4&_nc_zt=3&_nc_ht=
K7MjKJgSO4uE3-9PPuLJ3-AcoOzFmE2j3tWwrtNdv9XQ&oe=6AA177C4"}, {"file_name": "5.png", "id": "467916352871409", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/39003282_467916356204742_1871921057092171900_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pwxF88PNXooQ7kNvwHT2CdO&_nc_oc=AdoavwPs4BNJ6HN4HP9ZOj7kRpf57AupwQQbrY1Nf-VlJqdWh6Q63mtduvuZLg7bgN4&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLbJg-ObDVPG5R9HHpArmGD9OjanbmCZNWV1zyhQeAT-w&oe=6AA15C62"}, {"file_name": "3.png", "id": "1934382610375855", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38974473_1934382613709188_7156337812617042679_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H8DJ7V_k284Q7kNvwGP5Cjl&_nc_oc=AdoZCIqOIlIoPAwKLjmsMszISXyChTemnTANP1Z-D4uMPIQLkBhG_4ZQMlWwYVxLIV0&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ6YyvGE0iiBDT9CKyCpjy7mb8E3TofosuPFuGcHPiU5g&oe=6AA17EB3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape.png", "id": "1524760081483769", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38974531_1524760084817102_6497712644828891067_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ptFLZBBesRoQ7kNvwECEDbs&_nc_oc=AdrtFm-fVZVmFNEAvjSvrQ4XHEwMTToQBs6W_1283GFCvOKhVziqwkg0iMDkS3CCPjQ&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLf5Bxf-OKj4Ie2CJQl7Yw3Zwoij9dmZUK5G6cnPW7qWQ&oe=6AA17DAF"}, "display_name": "Mystery Box VR: Hidden Secrets", "keywords": [], "long_description": " AN IMMERSIVE VR PUZZLE EXPERIENCE\nInteract with objects, handles, buttons, and wheels on each side. Crack enigmas and collect hidden puzzle tiles on a random side of the boxes.\n\nYou won't be able to compare reality with fiction.\n\n# DISCOVER INVENTIONS\nOnce you unlock all 8 boxes of a Level Pack, you can compose a puzzle and discover a brief history of an invention.\n\nIt's not always easy to escape the room, so use all your IQ to crack the riddles. There's a logic behind all of them, even where it seems it's not!\n\n# IMMERSIVE SOUNDTRACK\nPlay the game with your headphones to get immersed in this amazing adventure.\n\n# HINTS\nGot stuck on some enigma? No worries, you can still get a helpful hint! You can also get in touch with me in case you really can't make it through a riddle, I'll be glad to help ;)\n\n# MULTILANGUAGE\nAvailable in English, French, Italian, German, Spanish, Russian, and Japanese.\n\nThe game language will change automatically based on the language settings of your device", "short_description": "A VR escape room game where you have to solve intriguing riddles to open boxes and discover nice stories about popular inventions!"}, {"images": {"nodes": [{"file_name": "$R36BSY5.png", "id": "3678762505771822", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/39031430_3678762509105155_2151975047074617165_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=77k6yN2RitIQ7kNvwEtYoO4&_nc_oc=AdrL6tnhCiUDbah383aULPUxtohxMqGMyTmgeimNamiVluCDMXjWYKnQZ5xwZ3l_KaM&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJEA4_ePRcJxhOm5Gq-5VYgGku_X0ICNLaK58xSOVfqLA&oe=6AA179A5"}, {"file_name": "$R81V725.png", "id": "2720695481426567", "image_type": "APP_IMG_ICON", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/75262743_2720695484759900_604086922326600035_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-FQP_65cPM0Q7kNvwFLF8l6&_nc_oc=Adr4leimpm63eSIVut05D8FIDcYdczEa-tDxSU3KtF5P-p0CDIizWpi6Md6VKwE8YOo&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKwNqFzLjIvlTCoX5UkEbToMNkCCZYKY6xK6CxtessZ3g&oe=6AA1788D"}, {"file_name": "$RQ3SN6U.png", "id": "1552311425628973", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38982519_1552311428962306_1218130395049083834_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f-ZAOiB4PacQ7kNvwG096Do&_nc_oc=AdoZP6sLRLlqbZ_vMzZL0pF8EFmm_Buy71KfjJte8m2Kc44nXiOs6BTOcteNhmzv1DQ&_nc_zt=3&_nc_ht=
culuscdn.com&_nc_ss=7f30f&oh=00_AQWH6akWcVxIjIohVt2lqYvgMZHNualM_yzC8-AA94uvHg&oe=6B1052A2"}, {"file_name": "3.png", "id": "1934382610375855", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974473_1934382613709188_7156337812617042679_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ev-Nu8b93J8Q7kNvwFq_l46&_nc_oc=AdolhwCmQqeNJGHairbGbqgjpTqeKoFXCr6lXml3dGczVypXd97IzXVRiFS6HECqDx0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWb2WGq6dzWfZ_Ut4nomJZzfzIRlcfmcd8Qr7qpMKRLbQ&oe=6B103CB3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape_coverart.png", "id": "897861905346420", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982672_897861908679753_3996777238831042692_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fRWQDnqJTM8Q7kNvwGBEKo1&_nc_oc=Adrg1NGmFHgjq8NGu1KP_nTQ2OITP6a5StjgWcCDUwwrEA70MSZ_l_j1VffRttAcnrU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQUHkE9TeJ6Bxl9BevdaZxrtKmAWZrOHYk9MiBNE1-AV5g&oe=6B103F2B"}, "display_name": "Mystery Box VR: Hidden Secrets Escape", "keywords": ["puzzle", "escape", "room", "trivia", "brainteaser"], "long_description": "# AN IMMERSIVE VR PUZZLE EXPERIENCE\nInteract with objects, handles, buttons, and wheels on each side. Crack enigmas and collect hidden puzzle tiles on a random side of the boxes.\n\nYou won't be able to compare reality with fiction.\n\n# DISCOVER INVENTIONS\nOnce you unlock all 8 boxes of a Level Pack, you can compose a puzzle and discover a brief history of an invention.\n\nIt's not always easy to escape the room, so use all your IQ to crack the riddles. There's a logic behind all of them, even where it seems it's not!\n\n# IMMERSIVE SOUNDTRACK\nPlay the game with your headphones to get immersed in this amazing adventure.\n\n# HINTS\nGot stuck on some enigma? No worries, you can still get a helpful hint! You can also get in touch with me in case you really can't make it 
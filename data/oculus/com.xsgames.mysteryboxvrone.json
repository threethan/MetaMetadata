FQtY3s4_CTjq0PDkZ-Q-IS3mpvi0J6BZgbFXsmPJoWWA&oe=6A770F84"}, {"file_name": "5.png", "id": "467916352871409", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39003282_467916356204742_1871921057092171900_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yhaliy8f3KsQ7kNvwG17naU&_nc_oc=Ado0HnTZYwd2fWoIK5cX9KA2TppVqxYME-uyseFhOw5awAqXLYr7iogkpzld1F_gvpo&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFBMOVp2gOxdY41er3xBv_PraCSVEJbbOuIDu13fAjytg&oe=6A772C62"}, {"file_name": "3.png", "id": "1934382610375855", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974473_1934382613709188_7156337812617042679_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KPiG156k8TMQ7kNvwF6Tn_Y&_nc_oc=AdrH3oDE0Zkpex39mdDPGb0eNe3g3cP4D_IMe-y1QQqJtizfFsEnU-rkCOlNWo-q-SU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFuY8yH94OswNmMH0711wsw9HmIZ1szsP11ssDCwpznUQ&oe=6A771673"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape.png", "id": "1524760081483769", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974531_1524760084817102_6497712644828891067_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DNNCLxqj8M4Q7kNvwFAwlPa&_nc_oc=AdoQv53SR6Z_4WvbTheps8YfMgnzxnbsbAkkhfuBoT0rZqjBUgePtD0nnagTQkx-SNk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEyOuqxxkQVjYPkMDzNYj58OmAYv2shN0bL4WGdtqNbUA&oe=6A77156F"}, "display_name": "Mystery Box VR: Hidden Secrets", "keywords": [], "long_description": " AN IMMERSIVE VR PUZZLE EXPERIENCE\nInteract with objects, handles, buttons, and wheels on each side. Crack enigmas and collect hidden puzzle tiles on a random side of the boxes.\n\nYou won't be able to compare reality with fiction.\n\n# DISCOVER INVENTIONS\nOnce you unlock all 8 boxes of a Level Pack, you can compose a puzzle and discover a brief history of an invention.\n\nIt's not always easy to escape the room, so use all your IQ to crack the riddles. There's a logic behind all of them, even where it seems it's not!\n\n# IMMERSIVE SOUNDTRACK\nPlay the game with your headphones to get immersed in this amazing adventure.\n\n# HINTS\nGot stuck on some enigma? No worries, you can still get a helpful hint! You can also get in touch with me in case you really can't make it through a riddle, I'll be glad to help ;)\n\n# MULTILANGUAGE\nAvailable in English, French, Italian, German, Spanish, Russian, and Japanese.\n\nThe game language will change automatically based on the language settings of your device", "short_description": "A VR escape room game where you have to solve intriguing riddles to open boxes and discover nice stories about popular inventions!"}, {"images": {"nodes": [{"file_name": "$R36BSY5.png", "id": "3678762505771822", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031430_3678762509105155_2151975047074617165_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ubfOKf3MSGYQ7kNvwHaRLqu&_nc_oc=AdpHOf-vvxpuRWOZgktSzQ_WTIX73PCu4bkBMhAfLHz-k9xJMMEeB3REnti7f8er-p4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG3CAPDLTO9U1yYcYAzKrJ8nWNewviqZtVugV5dgehreg&oe=6A771165"}, {"file_name": "$R81V725.png", "id": "2720695481426567", "image_type": "APP_IMG_ICON", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75262743_2720695484759900_604086922326600035_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dlQzlVuxhg4Q7kNvwHRIgLf&_nc_oc=AdrkBRbfV_KEA9uhQf2tasQe4GY7K_XhXcbIlzBAxf3EJ1XZk3eSp85YkN5UCUMz2GU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEe4XBJjoGZEoQieMXNRQ0elT22poePjxQ4jmEO5v6Jkg&oe=6A77104D"}, {"file_name": "$RQ3SN6U.png", "id": "1552311425628973", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982519_1552311428962306_1218130395049083834_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XWQBTnVkUOwQ7kNvwG-i_P7&_nc_oc=AdqYDS7hEAh9q9lP_XClJGSgHl35zx0uGoTMNsRy5Q4hgXS4PLP7-sJlaPjJ6kCEals&_nc_zt=3&_nc_ht=
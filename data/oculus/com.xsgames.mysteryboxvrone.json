E4FTCnuO7MgLzmrJRxrFZasO8ZdYXOa_BaANAgtadhRg&oe=6A843E84"}, {"file_name": "5.png", "id": "467916352871409", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39003282_467916356204742_1871921057092171900_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4TiyZ1VYdtQQ7kNvwH7Rddj&_nc_oc=AdrxFgOHWtXGMeU-lusRcu5g296OwbwSee_BeT6LC0R93jZ9HCzKCclgJOPM3dx8VsU&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGVStuWmSRuwUMrAA3ibrtsLtdXgK5-w69cHwBzHMjruA&oe=6A845B62"}, {"file_name": "3.png", "id": "1934382610375855", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974473_1934382613709188_7156337812617042679_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=slmk--1hXw4Q7kNvwGIy6X4&_nc_oc=AdoX7LXtDSRLy5c3T82gcHR6NDIen-0ft0Ut9Vb60d62aWRKY0Bf9DqQihb3k7tjJV4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHiwDH_3sJCGUIVcWRuOLobmOD5FMqDlTrq0lOroV7Y1w&oe=6A844573"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape.png", "id": "1524760081483769", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974531_1524760084817102_6497712644828891067_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FKzC0Q58MMwQ7kNvwGEjqd6&_nc_oc=AdoebEtEwqe60R6s8N1hyJ4pR93aX_74jcqdBoZjlYgMT6bUh_lZ4rYeSv4UJ2TcRqA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGtMHCrBi3LRjtrh6oV7KGnGtS7QbbjDIdYYRjbRs22OQ&oe=6A84446F"}, "display_name": "Mystery Box VR: Hidden Secrets", "keywords": [], "long_description": " AN IMMERSIVE VR PUZZLE EXPERIENCE\nInteract with objects, handles, buttons, and wheels on each side. Crack enigmas and collect hidden puzzle tiles on a random side of the boxes.\n\nYou won't be able to compare reality with fiction.\n\n# DISCOVER INVENTIONS\nOnce you unlock all 8 boxes of a Level Pack, you can compose a puzzle and discover a brief history of an invention.\n\nIt's not always easy to escape the room, so use all your IQ to crack the riddles. There's a logic behind all of them, even where it seems it's not!\n\n# IMMERSIVE SOUNDTRACK\nPlay the game with your headphones to get immersed in this amazing adventure.\n\n# HINTS\nGot stuck on some enigma? No worries, you can still get a helpful hint! You can also get in touch with me in case you really can't make it through a riddle, I'll be glad to help ;)\n\n# MULTILANGUAGE\nAvailable in English, French, Italian, German, Spanish, Russian, and Japanese.\n\nThe game language will change automatically based on the language settings of your device", "short_description": "A VR escape room game where you have to solve intriguing riddles to open boxes and discover nice stories about popular inventions!"}, {"images": {"nodes": [{"file_name": "$R36BSY5.png", "id": "3678762505771822", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031430_3678762509105155_2151975047074617165_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kDdeyixfcfYQ7kNvwFr1QF0&_nc_oc=AdrJvh_nFiyrgCCGnOtEtzPbfuAUA4O14hyyS6tUWxM0Prewn8CqIUWCnxFEBOcaVmc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHtc8Bj9tSoSgRUplh5QPTr-OL_ffX_E000dCKqG5TvvQ&oe=6A844065"}, {"file_name": "$R81V725.png", "id": "2720695481426567", "image_type": "APP_IMG_ICON", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75262743_2720695484759900_604086922326600035_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6psLyBricCUQ7kNvwGopQ_j&_nc_oc=AdpPFKvY3_rYzmYZ7StmR9ejlNObUXkinSALUgDGefPfOtkfwu923kTqzubdUor_1XI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH2hMBm20gwoMRmBcNEQqbOrtV2jQxgGPSSgOJhDi2Ciw&oe=6A843F4D"}, {"file_name": "$RQ3SN6U.png", "id": "1552311425628973", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982519_1552311428962306_1218130395049083834_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mM538yIBAvcQ7kNvwG4wPc1&_nc_oc=Adp9TjC2jRvqHCG3tmC19kWIC5xOUrkbmLRFXKHUQvNvhhyJLOOxtT5VQvNdqrobcJI&_nc_zt=3&_nc_ht=
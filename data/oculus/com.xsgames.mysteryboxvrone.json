zZ6Q&oe=699EF662"}, {"file_name": "3.png", "id": "1934382610375855", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974473_1934382613709188_7156337812617042679_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tYL9Qt5kFLMQ7kNvwGcMTNa&_nc_oc=AdluaF7i9swGfOTxUd9Q_rIJ8xephsFIVN-ezqwn_JAoIj12wWDw_Duav8M7b_DIBFs&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AfsApoZ0e_yDet98tOD75fFX1TZu4Y5lm5D6aknLrgrf4A&oe=699EE073"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape.png", "id": "1524760081483769", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974531_1524760084817102_6497712644828891067_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1knUNwNtwr4Q7kNvwF6e8ll&_nc_oc=AdnI8pAw7gHAgLMCdMT1Wa5ctHIMzHczk8KhYKq2QBVWuUWkCj5Lo0T9BxyP5lTmiRE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_Afuqyy-yLJH8XWa_IjaVB4CSWNzt69O_TnlOhFxORNxcKA&oe=699EDF6F"}, "display_name": "Mystery Box VR: Hidden Secrets", "keywords": [], "long_description": " AN IMMERSIVE VR PUZZLE EXPERIENCE\nInteract with objects, handles, buttons, and wheels on each side. Crack enigmas and collect hidden puzzle tiles on a random side of the boxes.\n\nYou won't be able to compare reality with fiction.\n\n# DISCOVER INVENTIONS\nOnce you unlock all 8 boxes of a Level Pack, you can compose a puzzle and discover a brief history of an invention.\n\nIt's not always easy to escape the room, so use all your IQ to crack the riddles. There's a logic behind all of them, even where it seems it's not!\n\n# IMMERSIVE SOUNDTRACK\nPlay the game with your headphones to get immersed in this amazing adventure.\n\n# HINTS\nGot stuck on some enigma? No worries, you can still get a helpful hint! You can also get in touch with me in case you really can't make it through a riddle, I'll be glad to help ;)\n\n# MULTILANGUAGE\nAvailable in English, French, Italian, German, Spanish, Russian, and Japanese.\n\nThe game language will change automatically based on the language settings of your device", "short_description": "A VR escape room game where you have to solve intriguing riddles to open boxes and discover nice stories about popular inventions!"}, {"images": {"nodes": [{"file_name": "$R36BSY5.png", "id": "3678762505771822", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031430_3678762509105155_2151975047074617165_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3oaXKUFYhnoQ7kNvwECBZYy&_nc_oc=Adn6ST5dvCJrpv9R6t_Opow16A4YWJvJnuR6Mx9wmLaHecJtLUL3U863TyORS9wMjdk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_Aftv-BzTMPo--kAnyDFQgTBPcKyEjt1f7_U3POeFlixoZg&oe=699EDB65"}, {"file_name": "$R81V725.png", "id": "2720695481426567", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75262743_2720695484759900_604086922326600035_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kZGlZmAc9LQQ7kNvwFP-MvC&_nc_oc=AdmXuTUqfFzMQpJ7F6lwi39zkLvblJS_S4bEt6FMFwI3lsfkw3bipGHDVxeab8r164o&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AftlagBFif397p24qm4cJvBVzDFHA0ptScBV8dyXwEeH1A&oe=699EDA4D"}, {"file_name": "$RQ3SN6U.png", "id": "1552311425628973", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982519_1552311428962306_1218130395049083834_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jFxLD1qPFY4Q7kNvwFxGq07&_nc_oc=Adk33lpfL37QZGPvb-XFFTUr55FBJLfSyN2sfPti0QjCYx5pPeFrOygof38Kz1R5ZVk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AfvbDYnO7C_120XjL3b3qQ3jKu6JjZ4ZEIpECz7QyrHqPA&oe=699EE5A9"}, {"file_name": "38982645_1000853181732648_5055517427829171192_n.png", "id": "1043990680394008", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031625_1043990683727341_3557431131423146005_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B445TmBWlQgQ7kNvwEzWFjv&_nc_oc=Admc4kqs76H0FWnqvNJlDBkwqU13lTt2yOIiuSh_HBjl8EAK8PJ8d0kLCxP8gOpfueo&_nc_zt=3&_nc_ht=scontent-ams2-1
67PekuKQSlrSGoKu5-MArLwkqMnJIqoLZ5uhMpIv5MJw&oe=6A185BC4"}, {"file_name": "5.png", "id": "467916352871409", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39003282_467916356204742_1871921057092171900_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6XZGJYljMBoQ7kNvwG2z4Ab&_nc_oc=AdrbaKtbnwWvBoNCfJ1ykohv_jik-fpEtFycdFZMBflfl7-JwFmzOuynpSATYuvgt88&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7ZfP4lcvwuM8nQaXjud-Mi5flaYxeYRDgpfkM_8FU40g&oe=6A184062"}, {"file_name": "3.png", "id": "1934382610375855", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974473_1934382613709188_7156337812617042679_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M54Zx1EASW0Q7kNvwEinK5x&_nc_oc=AdpWHey15Tl5DWP6DRJSyiBTEyqS-1uwSmdNR3pqBVKfMandoFOqnJTITGb4HNLPQvU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7kFDwrvYdfRJiBD4Ga_weHxDIgoqj3gl1ho_vq6I0ehg&oe=6A1862B3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape.png", "id": "1524760081483769", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974531_1524760084817102_6497712644828891067_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OFt5CveQvogQ7kNvwHZbU5T&_nc_oc=AdpLs3BbLpxptR6cPPlcBarz0sfPZ2wfwP9Hb2GcznshIE6xWKDZN2xxJnDj0eb24NE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5FgNDK5kmnYeWyfPaO8QS_QVxjjMPOgtgp0Pl4e2dXKA&oe=6A1861AF"}, "display_name": "Mystery Box VR: Hidden Secrets", "keywords": [], "long_description": " AN IMMERSIVE VR PUZZLE EXPERIENCE\nInteract with objects, handles, buttons, and wheels on each side. Crack enigmas and collect hidden puzzle tiles on a random side of the boxes.\n\nYou won't be able to compare reality with fiction.\n\n# DISCOVER INVENTIONS\nOnce you unlock all 8 boxes of a Level Pack, you can compose a puzzle and discover a brief history of an invention.\n\nIt's not always easy to escape the room, so use all your IQ to crack the riddles. There's a logic behind all of them, even where it seems it's not!\n\n# IMMERSIVE SOUNDTRACK\nPlay the game with your headphones to get immersed in this amazing adventure.\n\n# HINTS\nGot stuck on some enigma? No worries, you can still get a helpful hint! You can also get in touch with me in case you really can't make it through a riddle, I'll be glad to help ;)\n\n# MULTILANGUAGE\nAvailable in English, French, Italian, German, Spanish, Russian, and Japanese.\n\nThe game language will change automatically based on the language settings of your device", "short_description": "A VR escape room game where you have to solve intriguing riddles to open boxes and discover nice stories about popular inventions!"}, {"images": {"nodes": [{"file_name": "$R36BSY5.png", "id": "3678762505771822", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031430_3678762509105155_2151975047074617165_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y_wbhNyqj5oQ7kNvwF85Kwb&_nc_oc=Adqq3GALi4oxyw1g2BPTv4e0REIldhAZgmKqKep4UThwSgDk-OPqFL1BlsCIWy9gRro&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5Y3y-ogas7q0O3XkkPKq0SV0NYJX5_y9bPxs7dMse5Ig&oe=6A185DA5"}, {"file_name": "$R81V725.png", "id": "2720695481426567", "image_type": "APP_IMG_ICON", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75262743_2720695484759900_604086922326600035_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oKSnrwpohUAQ7kNvwH2tjGK&_nc_oc=AdpvRJJFNT_ShbOV9unRKYbPsF6UkIPDFpAvE1WZZjwI4GUxjOMJc_aJvugpFenVXuk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5C23xtHPkm14tc5qkeAMUUrYkDLYw4mFjZWe8lUo2Qjw&oe=6A185C8D"}, {"file_name": "$RQ3SN6U.png", "id": "1552311425628973", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982519_1552311428962306_1218130395049083834_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZgOFrcAZKc4Q7kNvwEesScW&_nc_oc=AdrafcKjjKWCjxB4exS5eqlUjf-1RH8w3Y_fwLpEg3jaBFTVr54DZU9bpZSwUK70hLg&_nc_zt=3&_nc_ht=
N_XGQX57iMkGGhsej1z1CZC9eXcsyap7Uv5g8FYMjXOg&oe=6AE21144"}, {"file_name": "5.png", "id": "467916352871409", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39003282_467916356204742_1871921057092171900_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_mNb3kctKG0Q7kNvwGlFjmf&_nc_oc=AdrBnJpq1_LvAFG6wgCdrlFbt8YaOPBcZynhbQokGhO-PjCmFlEWIoqXys0nBuDPuBY&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOG5aJbfhP0dr98f1DzIQQ87z5kj_zMUmbbmNwyM7AU3Q&oe=6AE1F5E2"}, {"file_name": "3.png", "id": "1934382610375855", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974473_1934382613709188_7156337812617042679_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JVNRziCGz6wQ7kNvwFkR13O&_nc_oc=AdolN-Sw7Bt7GRp7objVj85WTpXFKa3WbOv3HfdZWQry5n3VfQcgclbMfRa6kMGUrc4&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPsP44IVjFRnl_Mim_eoFUoOnfY411UGdau41-7ETsCdg&oe=6AE21833"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape.png", "id": "1524760081483769", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974531_1524760084817102_6497712644828891067_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iF8cQ6D866cQ7kNvwGk_J6L&_nc_oc=AdqRRnU2B6cpaJcpEWF5DNDZ_8PXf259bHwFUPJyB7y9OqZQi3HM5yg2R_xVR9LazRo&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNFDFLyjY3SU56RvP-LB3gl7fFONafU1LNrRD0TG0KqLA&oe=6AE2172F"}, "display_name": "Mystery Box VR: Hidden Secrets", "keywords": [], "long_description": " AN IMMERSIVE VR PUZZLE EXPERIENCE\nInteract with objects, handles, buttons, and wheels on each side. Crack enigmas and collect hidden puzzle tiles on a random side of the boxes.\n\nYou won't be able to compare reality with fiction.\n\n# DISCOVER INVENTIONS\nOnce you unlock all 8 boxes of a Level Pack, you can compose a puzzle and discover a brief history of an invention.\n\nIt's not always easy to escape the room, so use all your IQ to crack the riddles. There's a logic behind all of them, even where it seems it's not!\n\n# IMMERSIVE SOUNDTRACK\nPlay the game with your headphones to get immersed in this amazing adventure.\n\n# HINTS\nGot stuck on some enigma? No worries, you can still get a helpful hint! You can also get in touch with me in case you really can't make it through a riddle, I'll be glad to help ;)\n\n# MULTILANGUAGE\nAvailable in English, French, Italian, German, Spanish, Russian, and Japanese.\n\nThe game language will change automatically based on the language settings of your device", "short_description": "A VR escape room game where you have to solve intriguing riddles to open boxes and discover nice stories about popular inventions!"}, {"images": {"nodes": [{"file_name": "$R36BSY5.png", "id": "3678762505771822", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39031430_3678762509105155_2151975047074617165_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B5Npk-DQOsoQ7kNvwHyDlQa&_nc_oc=AdqldRhgT_HHtlGHalSOXSJbvndCbozfl3NUw_ai6W3qmz03Sk6tYIcAdRTFIjnJ3iw&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNdrFOSFeXzyKy5ynPad4-69CLTMnGdBM8XQeVP_fH9xg&oe=6AE21325"}, {"file_name": "$R81V725.png", "id": "2720695481426567", "image_type": "APP_IMG_ICON", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75262743_2720695484759900_604086922326600035_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pE0JaHZppJgQ7kNvwEmoA4l&_nc_oc=Ado4SRRq_q4W7Gq8GewP-uYsiPDOwlQSPIjZg1KwpBLCYKBG-V_sicvmjxrTsQGFHBc&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNoZh2o4-jXipILYmI-Cx0jg6ZbPwZ8XZH9_YYGgMcNbQ&oe=6AE2120D"}, {"file_name": "$RQ3SN6U.png", "id": "1552311425628973", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982519_1552311428962306_1218130395049083834_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AZ9FOJ24hFcQ7kNvwGN91Yx&_nc_oc=AdpV2gpHlhTKh6ZHOi1HT-7H-lbbmwYZTqMN6bh-ZllHG8Ro9vgc96sJtA30dkfVD6Y&_nc_zt=3&_nc_ht=
7tJqMwFS63b1sXFKnSL9aPi4GSQvqMsTsJ0TZbF-9HYw&oe=6A2044C4"}, {"file_name": "5.png", "id": "467916352871409", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39003282_467916356204742_1871921057092171900_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WeSjJuTv6cEQ7kNvwERG9to&_nc_oc=AdqWUBMvFTG0mBVYyS0LVBzvKFanI4R-wHmOJOWKtokQ80SYUDyUc0pGFrNY1t207wU&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7cx_onEqNrWyLZuldS0jH6JZK9gocwgv-NxYo9VZI0Kw&oe=6A202962"}, {"file_name": "3.png", "id": "1934382610375855", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974473_1934382613709188_7156337812617042679_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GbgUeM1Uk2MQ7kNvwFTJoOu&_nc_oc=AdpZ9X_Y_66Gxz-RkbAoPrqbgSvrFfH9NOk-vi26XYeZED5tcmL7ya-tWeib3wnadm0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5H5HFs3x0VZohBa3hr5Vdv_SbRz2uBt6mzPixXNjCyZA&oe=6A204BB3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape.png", "id": "1524760081483769", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974531_1524760084817102_6497712644828891067_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hQabwWWRKu4Q7kNvwFZz48W&_nc_oc=AdrtHi9FieixSNYnv2Yj0Ev-5QIckyzEgm_VUdcfyy-uy5muQaOJgol-nFimNXyWwKA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7pnWdNDpY6jCtlTON5JSySE_xuNAZkTVkx_quDl1MijA&oe=6A204AAF"}, "display_name": "Mystery Box VR: Hidden Secrets", "keywords": [], "long_description": " AN IMMERSIVE VR PUZZLE EXPERIENCE\nInteract with objects, handles, buttons, and wheels on each side. Crack enigmas and collect hidden puzzle tiles on a random side of the boxes.\n\nYou won't be able to compare reality with fiction.\n\n# DISCOVER INVENTIONS\nOnce you unlock all 8 boxes of a Level Pack, you can compose a puzzle and discover a brief history of an invention.\n\nIt's not always easy to escape the room, so use all your IQ to crack the riddles. There's a logic behind all of them, even where it seems it's not!\n\n# IMMERSIVE SOUNDTRACK\nPlay the game with your headphones to get immersed in this amazing adventure.\n\n# HINTS\nGot stuck on some enigma? No worries, you can still get a helpful hint! You can also get in touch with me in case you really can't make it through a riddle, I'll be glad to help ;)\n\n# MULTILANGUAGE\nAvailable in English, French, Italian, German, Spanish, Russian, and Japanese.\n\nThe game language will change automatically based on the language settings of your device", "short_description": "A VR escape room game where you have to solve intriguing riddles to open boxes and discover nice stories about popular inventions!"}, {"images": {"nodes": [{"file_name": "$R36BSY5.png", "id": "3678762505771822", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031430_3678762509105155_2151975047074617165_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2ZlDI-jaHHMQ7kNvwHv72a9&_nc_oc=AdoBJohRxknuNdSH4G77kO4pG-YiWj58A6JI2NWfNUXZ98Jh4eDts2hk3We3UodPjys&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7alC0U25gfYBuCutpKWk3UMwN1kUb8-aDQ9qAHXzTnvQ&oe=6A2046A5"}, {"file_name": "$R81V725.png", "id": "2720695481426567", "image_type": "APP_IMG_ICON", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75262743_2720695484759900_604086922326600035_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8YTpD_IlhsMQ7kNvwG6oxIp&_nc_oc=AdpvlC2CseLUrWysakYsV8eZkL05sy6wrm1DDmQQtWoB5CriDCkwlv8OIkKmDFlp5ME&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5vUCKAdt0C7Dl1o5a-KtNqok2mlZ6CtPMd5e_nhgnn8g&oe=6A20458D"}, {"file_name": "$RQ3SN6U.png", "id": "1552311425628973", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982519_1552311428962306_1218130395049083834_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NoCqdmUsMfAQ7kNvwE4WO8g&_nc_oc=AdoJZ5neWQ4vRlZvncWJQusnRlyCuaGoQIes_roBTn9QacE-LgSCr99mLMpgs9XCryU&_nc_zt=3&_nc_ht=
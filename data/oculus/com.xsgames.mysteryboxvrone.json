1-pRM1UJZO-kUeHRU13zYxK9Tixnur1ReZo8CEYGdlew&oe=69F8B7C4"}, {"file_name": "5.png", "id": "467916352871409", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39003282_467916356204742_1871921057092171900_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nyyUHmJAcX0Q7kNvwG5_Y0Y&_nc_oc=AdpbupU-QST6vPoIh1_574LnCC2p99seT2wtXvImOdVu3AEgXEl4CD0PQYl-Ky8QSFk&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0mUyW2pBUppm2Q2sSObvMTXWEm0RLp4TyBf5yZCiuF0g&oe=69F89C62"}, {"file_name": "3.png", "id": "1934382610375855", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974473_1934382613709188_7156337812617042679_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4eVgmOC7lC8Q7kNvwEgty4_&_nc_oc=Adq2AinkF_FPm58bBbHgqfnQjh_-0gcJfJz3h6hHJKuhwtL9YIPQSI-mz1BZ4MGnfGo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af16dFBGnELF5zK_tela8M0clxVI2QfXzsiSI-dDiRHHug&oe=69F8BEB3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape.png", "id": "1524760081483769", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974531_1524760084817102_6497712644828891067_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=naSaRH9zIMgQ7kNvwFJQNrK&_nc_oc=AdqEj9UuYwrpC_jmlids4eXwgXoFYgfFBvXaBqCNQw0xRmBQr9YPPoEOK9n96zC3keI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af16AWmAJO9TUAVL-YgST_jdsq0RqzO8l0WZtqoQ8t8G5g&oe=69F8BDAF"}, "display_name": "Mystery Box VR: Hidden Secrets", "keywords": [], "long_description": " AN IMMERSIVE VR PUZZLE EXPERIENCE\nInteract with objects, handles, buttons, and wheels on each side. Crack enigmas and collect hidden puzzle tiles on a random side of the boxes.\n\nYou won't be able to compare reality with fiction.\n\n# DISCOVER INVENTIONS\nOnce you unlock all 8 boxes of a Level Pack, you can compose a puzzle and discover a brief history of an invention.\n\nIt's not always easy to escape the room, so use all your IQ to crack the riddles. There's a logic behind all of them, even where it seems it's not!\n\n# IMMERSIVE SOUNDTRACK\nPlay the game with your headphones to get immersed in this amazing adventure.\n\n# HINTS\nGot stuck on some enigma? No worries, you can still get a helpful hint! You can also get in touch with me in case you really can't make it through a riddle, I'll be glad to help ;)\n\n# MULTILANGUAGE\nAvailable in English, French, Italian, German, Spanish, Russian, and Japanese.\n\nThe game language will change automatically based on the language settings of your device", "short_description": "A VR escape room game where you have to solve intriguing riddles to open boxes and discover nice stories about popular inventions!"}, {"images": {"nodes": [{"file_name": "$R36BSY5.png", "id": "3678762505771822", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031430_3678762509105155_2151975047074617165_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FEhb-MZ-5bwQ7kNvwFx0wAK&_nc_oc=Ado_DPyvtQWvFuAAwMVyYTkVr-BQ6aNOyr_42wY8VAUkuZxpALcNXciV8GE__phObCY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af26iTDa8w7Im0NjM02oC0tV4UUZ4xJBVNovgZ36wExcyg&oe=69F8B9A5"}, {"file_name": "$R81V725.png", "id": "2720695481426567", "image_type": "APP_IMG_ICON", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75262743_2720695484759900_604086922326600035_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5BMvBEE7nxYQ7kNvwEAXWBQ&_nc_oc=AdqtP_rt3uLU15vjCQ-EnwWgPLI9Y2pxtvpKuR_PA2PJFu9_ozNae4x-nFd0MkCoOaE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2s8EorzjigPh5NDhGxBZ24NRRZUEOEWsrhL1jY4cWZCg&oe=69F8B88D"}, {"file_name": "$RQ3SN6U.png", "id": "1552311425628973", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982519_1552311428962306_1218130395049083834_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DAkLOXd4VcYQ7kNvwHlzP7i&_nc_oc=Adoo-NiYqvSxFi4gxReBLKAke-Cdclh4OQ5vme0skJEBjt-cg3No4-j7N_aYIyZyeXM&_nc_zt=3&_nc_ht=
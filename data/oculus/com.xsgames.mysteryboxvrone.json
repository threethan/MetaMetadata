LFrc2AFhWJAcybCgsTrDw553Uz7mWfOZ5nf_ytkF1wDQ&oe=6AB149C4"}, {"file_name": "5.png", "id": "467916352871409", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39003282_467916356204742_1871921057092171900_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rBAQ3HTNJl4Q7kNvwFdsD-Q&_nc_oc=AdqCK8mTCwk3WuZ57OdiHqglePrRoJymZ08bBQFvqISJ_fTg0ZYrKLufAtcBNxnOzbk&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIYNoXf2j-BAEeUkMnZiGm2AfGsLzzeXPolS007ZHONIg&oe=6AB12E62"}, {"file_name": "3.png", "id": "1934382610375855", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974473_1934382613709188_7156337812617042679_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m0lI_t0upD0Q7kNvwFKQtna&_nc_oc=AdqOdh4t7R-kg02wSehCOf8n1XBiR1LEoxIMlMSblk4FNCHwYW8MUUk88D4A30jN_4o&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLFucBG-tY4sJbY2heWuKSTVS7_rpT6H7Ol3rRaU8cCug&oe=6AB150B3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape.png", "id": "1524760081483769", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974531_1524760084817102_6497712644828891067_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V7ybxxtlMXsQ7kNvwGWE9SN&_nc_oc=Adru08QLkMUjxtAyebuk8-MLYKZwuTs9ixnmGAKvvyt1poBr3AYCZ8khJe3OL2zxvUU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLfwO9nwQB-U-64dI2--Ptr3Z9MA_IP66nciygdIDcIAA&oe=6AB14FAF"}, "display_name": "Mystery Box VR: Hidden Secrets", "keywords": [], "long_description": " AN IMMERSIVE VR PUZZLE EXPERIENCE\nInteract with objects, handles, buttons, and wheels on each side. Crack enigmas and collect hidden puzzle tiles on a random side of the boxes.\n\nYou won't be able to compare reality with fiction.\n\n# DISCOVER INVENTIONS\nOnce you unlock all 8 boxes of a Level Pack, you can compose a puzzle and discover a brief history of an invention.\n\nIt's not always easy to escape the room, so use all your IQ to crack the riddles. There's a logic behind all of them, even where it seems it's not!\n\n# IMMERSIVE SOUNDTRACK\nPlay the game with your headphones to get immersed in this amazing adventure.\n\n# HINTS\nGot stuck on some enigma? No worries, you can still get a helpful hint! You can also get in touch with me in case you really can't make it through a riddle, I'll be glad to help ;)\n\n# MULTILANGUAGE\nAvailable in English, French, Italian, German, Spanish, Russian, and Japanese.\n\nThe game language will change automatically based on the language settings of your device", "short_description": "A VR escape room game where you have to solve intriguing riddles to open boxes and discover nice stories about popular inventions!"}, {"images": {"nodes": [{"file_name": "$R36BSY5.png", "id": "3678762505771822", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031430_3678762509105155_2151975047074617165_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qf1Tda_VFNYQ7kNvwH3TdFt&_nc_oc=Adq7Lfn4C1FlzXtohNv7fi4TPck9a1NdYPZTtZjxdKUYZkRaJH_g4qYfc8EkPDWzZTk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJoPGE9LlmGhUPvtVm0lXfgUYbRCcSBnAwnJ1u72WR45g&oe=6AB14BA5"}, {"file_name": "$R81V725.png", "id": "2720695481426567", "image_type": "APP_IMG_ICON", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75262743_2720695484759900_604086922326600035_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=taUYVMWZvakQ7kNvwF5zKt_&_nc_oc=AdoVcrUdlZkWlxH3VN6b2hthtyAHmOpFEFqlwP0kMe5XUm4b1om-ZzKbV2Aj2t5C36Q&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKgUrDhTzYXVWUk-UEXZoQ2iTPYT3uVtY-zQ20P5S3Ryg&oe=6AB14A8D"}, {"file_name": "$RQ3SN6U.png", "id": "1552311425628973", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982519_1552311428962306_1218130395049083834_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iRwvyehGUKcQ7kNvwEpl_69&_nc_oc=AdpiimYHoCmfcEjJDGR8kNXkBqj-w69wHhdb_Vofp8if5JBLFsQ5vqUri6FWSuZeuoU&_nc_zt=3&_nc_ht=
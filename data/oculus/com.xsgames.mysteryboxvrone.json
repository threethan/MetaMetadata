ycOed1YXpblsXv61HGYcLoeCdgISD1Ww1MVUroeA-h7A&oe=69C51504"}, {"file_name": "5.png", "id": "467916352871409", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39003282_467916356204742_1871921057092171900_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PK8aExZtfnQQ7kNvwFMXY7p&_nc_oc=AdqZceV5Xwe1_nvaDtMKHuXJXyhEmLCjDlf2SFLRupD74B6APagrQdZhO_PTFQs8rdw&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzZxgLo1L6Xvww0wb51qOm7FuR4we3_jj-2JLWRHp4ClQ&oe=69C531E2"}, {"file_name": "3.png", "id": "1934382610375855", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974473_1934382613709188_7156337812617042679_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iJSdAMIdPusQ7kNvwG6_4g8&_nc_oc=AdpSZqT9lWMxBCZUz4EGctv3jHyaz3Gh7MjYJNguKk8U8kg-kgND5LK0VG81aVHsBrE&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyzQqPjU7SpMXwNyFUvfdQ0EBZJkitcBvIIwQnm523UTQ&oe=69C51BF3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape.png", "id": "1524760081483769", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974531_1524760084817102_6497712644828891067_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=22CibaUnaaEQ7kNvwHFX9Xe&_nc_oc=Adpen5yISCRDkgFc5xO24y95Ddlkbt7Y9JL2GgMyUNM23Ymo0Rw7NrdpmMmtPObuClA&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxrmuiUKncjGqVoQTnO_2RAV8VyJItYTki-F3iUXlWgqQ&oe=69C51AEF"}, "display_name": "Mystery Box VR: Hidden Secrets", "keywords": [], "long_description": " AN IMMERSIVE VR PUZZLE EXPERIENCE\nInteract with objects, handles, buttons, and wheels on each side. Crack enigmas and collect hidden puzzle tiles on a random side of the boxes.\n\nYou won't be able to compare reality with fiction.\n\n# DISCOVER INVENTIONS\nOnce you unlock all 8 boxes of a Level Pack, you can compose a puzzle and discover a brief history of an invention.\n\nIt's not always easy to escape the room, so use all your IQ to crack the riddles. There's a logic behind all of them, even where it seems it's not!\n\n# IMMERSIVE SOUNDTRACK\nPlay the game with your headphones to get immersed in this amazing adventure.\n\n# HINTS\nGot stuck on some enigma? No worries, you can still get a helpful hint! You can also get in touch with me in case you really can't make it through a riddle, I'll be glad to help ;)\n\n# MULTILANGUAGE\nAvailable in English, French, Italian, German, Spanish, Russian, and Japanese.\n\nThe game language will change automatically based on the language settings of your device", "short_description": "A VR escape room game where you have to solve intriguing riddles to open boxes and discover nice stories about popular inventions!"}, {"images": {"nodes": [{"file_name": "$R36BSY5.png", "id": "3678762505771822", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39031430_3678762509105155_2151975047074617165_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G3bpbjbwFo0Q7kNvwF3zZiC&_nc_oc=AdrMxr2phoKAhjyzjlHDl2JP66BmDwLXgeFKo1BNds_UyRokBsYfhllpQ9gZ1j0-1fE&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afy1AWXNrYWR0Lk0Tw4PveoDz5f4zPwXRVMbJ4DfQnwFAQ&oe=69C516E5"}, {"file_name": "$R81V725.png", "id": "2720695481426567", "image_type": "APP_IMG_ICON", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/75262743_2720695484759900_604086922326600035_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=--M8Bprnd7kQ7kNvwExZG3T&_nc_oc=AdoTfC_Z_StAsEyNYoxQc5tHTkkmCWIQ_3wJVO-YOGOCLwjirfQPYKzjIs-P7uaQWjw&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyLI0qPx8sGeaqsC3n-YQGJayxuxfxwrUuQFRvFR-jnKw&oe=69C515CD"}, {"file_name": "$RQ3SN6U.png", "id": "1552311425628973", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38982519_1552311428962306_1218130395049083834_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ashleXd6g20Q7kNvwHT2ujf&_nc_oc=AdqY0k_of60u2c54df7D7_Ct3LM9GDy7YxppTyjJvB8-zfW6pJ4LHSvKkJ7VwmjDKgQ&_nc_zt=3&_nc_ht=
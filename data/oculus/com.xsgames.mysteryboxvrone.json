QivHf7Y_mZeMxg2zWx7MBC7hVjPDMxYDWn-jynxHfEfA&oe=6AE75744"}, {"file_name": "5.png", "id": "467916352871409", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39003282_467916356204742_1871921057092171900_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=10Tgbi_cgtgQ7kNvwGD87KV&_nc_oc=AdpEBG4zl2IxIvY3hfvNsLtqJoksZzKgl-nkuaj617OeOFMPew4PSgekZjwy8fMlmlM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRdsq5F_5LN5TLHVXLgTjWValMUTx906Wu3ejhIlGzYyQ&oe=6AE73BE2"}, {"file_name": "3.png", "id": "1934382610375855", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974473_1934382613709188_7156337812617042679_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IeixxBK3TOUQ7kNvwGGTgxb&_nc_oc=Adoaph5WNq0JIwdqp1IUo7qKgNJuQ4nglgQPRrVK3xtMB2Qn0OUFR-WeoYuCFf4soTA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRi-Vt--rLUFZtYKs3wmMCYuTGcRi1RkWJrdIPgKiXyqw&oe=6AE75E33"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape.png", "id": "1524760081483769", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974531_1524760084817102_6497712644828891067_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oEPsAm7AwyAQ7kNvwHprftc&_nc_oc=AdoNtX9ChwNWH_PtTC08Rn_qUNbknuOwqfueBDusEmqnfytmHEqmsQgVPamuohS32jE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR6j1_9hc5gFtZb2LHrkKTwvZgf1bWMedZj0l-E38uCPA&oe=6AE75D2F"}, "display_name": "Mystery Box VR: Hidden Secrets", "keywords": [], "long_description": " AN IMMERSIVE VR PUZZLE EXPERIENCE\nInteract with objects, handles, buttons, and wheels on each side. Crack enigmas and collect hidden puzzle tiles on a random side of the boxes.\n\nYou won't be able to compare reality with fiction.\n\n# DISCOVER INVENTIONS\nOnce you unlock all 8 boxes of a Level Pack, you can compose a puzzle and discover a brief history of an invention.\n\nIt's not always easy to escape the room, so use all your IQ to crack the riddles. There's a logic behind all of them, even where it seems it's not!\n\n# IMMERSIVE SOUNDTRACK\nPlay the game with your headphones to get immersed in this amazing adventure.\n\n# HINTS\nGot stuck on some enigma? No worries, you can still get a helpful hint! You can also get in touch with me in case you really can't make it through a riddle, I'll be glad to help ;)\n\n# MULTILANGUAGE\nAvailable in English, French, Italian, German, Spanish, Russian, and Japanese.\n\nThe game language will change automatically based on the language settings of your device", "short_description": "A VR escape room game where you have to solve intriguing riddles to open boxes and discover nice stories about popular inventions!"}, {"images": {"nodes": [{"file_name": "$R36BSY5.png", "id": "3678762505771822", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031430_3678762509105155_2151975047074617165_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yWdw9yM2iPoQ7kNvwGlUotd&_nc_oc=AdoXW_yoST6udBZ2O4udBrhBbO7PQrRvZDWg8xGQ66R7eq9KxxZ-QfirbYLLqLgF7GA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRXTkI7TRjHjGbEEPftvpy8qLx1oL7gdFzbewtrqnwIDg&oe=6AE75925"}, {"file_name": "$R81V725.png", "id": "2720695481426567", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75262743_2720695484759900_604086922326600035_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aLnZjC3dTA0Q7kNvwHXDiuH&_nc_oc=Adp1XnQPylrB21e4GpT-tKWNoQMErWD0qUJmw_HB2oylOz754RGPaRs9e2CUN-2SFoY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRBJn-YJb1MWa63KcCINZToLoXRLOBeUds7FxzBg9lAeg&oe=6AE7580D"}, {"file_name": "$RQ3SN6U.png", "id": "1552311425628973", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982519_1552311428962306_1218130395049083834_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jkLJYok55P0Q7kNvwHJv2nx&_nc_oc=AdoIz174ddXfPxReb0TGySPYKK2262dxjvXvmeHUikJTYPxqRT0S2s4pHYrAKjek_-0&_nc_zt=3&_nc_ht=
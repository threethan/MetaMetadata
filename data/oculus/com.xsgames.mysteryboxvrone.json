-9gP3JayxEHGW-5OWfxzwnVZnLO6wd0UI9-xP-cNVzWg&oe=6A43DD44"}, {"file_name": "5.png", "id": "467916352871409", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39003282_467916356204742_1871921057092171900_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MzufMR8pp_EQ7kNvwHYnV_3&_nc_oc=Ado5sB44G8cEse_Q8lIgbgqePmrkxF1z4CBNqrUYtQkv47sfCj0MZBRoLdsnnNTgm-c&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9AOd4w6h5bHFnHflGlTxpy6rS8MWP2oWV1_JvyfznjtA&oe=6A43C1E2"}, {"file_name": "3.png", "id": "1934382610375855", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974473_1934382613709188_7156337812617042679_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BnjajQEWy9cQ7kNvwH1MCtR&_nc_oc=AdrqnEyeKHPmvjhJ2LC5bjJYCDUuk5RGXYOw8Uxy3I8jHa5F3C9uQPB3WRQc3QysjFc&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8c5rWIQROiTscUXgHJW_Qpndwa7qQytwCUGlwqLiw7dQ&oe=6A43E433"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape.png", "id": "1524760081483769", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974531_1524760084817102_6497712644828891067_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DRKjDrw24koQ7kNvwGcRBiK&_nc_oc=AdrP1pbFNuj7Dl9TNkNiA5x348cbWlkZpdEHUBoR-Xw9tSge8vPYNH0egP_ki81cyzk&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_e-_ri012pIJHCw-SdfhMT_MLeIroZ2U7IL5twXB06Wg&oe=6A43E32F"}, "display_name": "Mystery Box VR: Hidden Secrets", "keywords": [], "long_description": " AN IMMERSIVE VR PUZZLE EXPERIENCE\nInteract with objects, handles, buttons, and wheels on each side. Crack enigmas and collect hidden puzzle tiles on a random side of the boxes.\n\nYou won't be able to compare reality with fiction.\n\n# DISCOVER INVENTIONS\nOnce you unlock all 8 boxes of a Level Pack, you can compose a puzzle and discover a brief history of an invention.\n\nIt's not always easy to escape the room, so use all your IQ to crack the riddles. There's a logic behind all of them, even where it seems it's not!\n\n# IMMERSIVE SOUNDTRACK\nPlay the game with your headphones to get immersed in this amazing adventure.\n\n# HINTS\nGot stuck on some enigma? No worries, you can still get a helpful hint! You can also get in touch with me in case you really can't make it through a riddle, I'll be glad to help ;)\n\n# MULTILANGUAGE\nAvailable in English, French, Italian, German, Spanish, Russian, and Japanese.\n\nThe game language will change automatically based on the language settings of your device", "short_description": "A VR escape room game where you have to solve intriguing riddles to open boxes and discover nice stories about popular inventions!"}, {"images": {"nodes": [{"file_name": "$R36BSY5.png", "id": "3678762505771822", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031430_3678762509105155_2151975047074617165_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T8QOtkEN4VAQ7kNvwGNPbf7&_nc_oc=AdqDFxo-VsNmwOGXYsq3h92PECMaDxCfiiYwC6vIc_MmB_6XOeMpia4qzUDh4LtKz6Q&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_MFEut9ibTwhPDk4ZI1yVy31pUm7TKiVcX7ydbZRxqfw&oe=6A43DF25"}, {"file_name": "$R81V725.png", "id": "2720695481426567", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75262743_2720695484759900_604086922326600035_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uUEsYVmGYyUQ7kNvwHcFAqm&_nc_oc=AdpqSlRay5H1jd_-rzIbabHhQwNKCX4eLaFlgBuYOepO4XDhFFGbXRWpmrwd3hXqPDA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9iHvr4kpLgZHhI6CxFUUDC2sU6FzpRAlCv6sT87BWfIw&oe=6A43DE0D"}, {"file_name": "$RQ3SN6U.png", "id": "1552311425628973", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982519_1552311428962306_1218130395049083834_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rehVSG4TarUQ7kNvwFet-8x&_nc_oc=AdpMya3PB9NwEiW01HDO1QwojSeSD9tLYteoEusOASLJboZhtFjwufSIL_6SjGJL8tM&_nc_zt=3&_nc_ht=
MMwy35ewWzcW92BXG6UvagQCOzAabt1xifn1PVjfX-ww&oe=6AE0BFC4"}, {"file_name": "5.png", "id": "467916352871409", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39003282_467916356204742_1871921057092171900_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=chBK1qCR8L8Q7kNvwHcku-Q&_nc_oc=Ado_oryaHjjPH03zAfsRTK1YdzWZaTaSfIUbrdP41vkVb9dCivwgt51DPxUY6fDfV0Q&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN41TYqSQZEhBusNAGr2UKM8TiB36OkFVCCgdRC328ShQ&oe=6AE0A462"}, {"file_name": "3.png", "id": "1934382610375855", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974473_1934382613709188_7156337812617042679_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JVNRziCGz6wQ7kNvwHhsik_&_nc_oc=Adptl1hPcONrpEgODayhEnSK6I0uWA00VgYkoPbj3oyY5byLEJPw_osR8__0GbXJiSs&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNVD1nRlzSOmorGC-soGLl0-2W_Zob1etAqqYmvLoezDw&oe=6AE0C6B3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape.png", "id": "1524760081483769", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974531_1524760084817102_6497712644828891067_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NQBf84qakuMQ7kNvwGYZrmB&_nc_oc=AdrY6qjXoqaPmtzl-5NXVCqEK9SG7WdWGuh1RRWfpQBgzcyHBzPmbz_h8LEVazD-0Wg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM8d9kNWZabEwLygqAecShPtfsmwwMzQhwq_8DhEk5y-g&oe=6AE0C5AF"}, "display_name": "Mystery Box VR: Hidden Secrets", "keywords": [], "long_description": " AN IMMERSIVE VR PUZZLE EXPERIENCE\nInteract with objects, handles, buttons, and wheels on each side. Crack enigmas and collect hidden puzzle tiles on a random side of the boxes.\n\nYou won't be able to compare reality with fiction.\n\n# DISCOVER INVENTIONS\nOnce you unlock all 8 boxes of a Level Pack, you can compose a puzzle and discover a brief history of an invention.\n\nIt's not always easy to escape the room, so use all your IQ to crack the riddles. There's a logic behind all of them, even where it seems it's not!\n\n# IMMERSIVE SOUNDTRACK\nPlay the game with your headphones to get immersed in this amazing adventure.\n\n# HINTS\nGot stuck on some enigma? No worries, you can still get a helpful hint! You can also get in touch with me in case you really can't make it through a riddle, I'll be glad to help ;)\n\n# MULTILANGUAGE\nAvailable in English, French, Italian, German, Spanish, Russian, and Japanese.\n\nThe game language will change automatically based on the language settings of your device", "short_description": "A VR escape room game where you have to solve intriguing riddles to open boxes and discover nice stories about popular inventions!"}, {"images": {"nodes": [{"file_name": "$R36BSY5.png", "id": "3678762505771822", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031430_3678762509105155_2151975047074617165_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B5Npk-DQOsoQ7kNvwF1TQSr&_nc_oc=AdpeqxwFMStYau80hy85nhmlfAo3k1N5PnuaRSD-vPd928fFtCPfpfp5Lje-0MuIiUE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNIIav7iz5-YuE1YEme_5GgbcwDrmkR_QyLgtIZkTlBoQ&oe=6AE0C1A5"}, {"file_name": "$R81V725.png", "id": "2720695481426567", "image_type": "APP_IMG_ICON", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75262743_2720695484759900_604086922326600035_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pE0JaHZppJgQ7kNvwF6axum&_nc_oc=AdoYsbPqn2n229A-A6cweXU0YS9cAbgARGV2f7uCyW6bq8Kb9n6jvH00twpFpTCgw5U&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNnEVNoWzVSMQ25JnMYlF3571l8B0iLcwV3iiyJFyjJGQ&oe=6AE0C08D"}, {"file_name": "$RQ3SN6U.png", "id": "1552311425628973", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982519_1552311428962306_1218130395049083834_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AZ9FOJ24hFcQ7kNvwHhim5q&_nc_oc=AdokKqB8Cp-cXCZU3bwB3RB-VC_O0fknoA3ZwlosBMv_mM4oXm6twnPchAL_YUOi6BQ&_nc_zt=3&_nc_ht=
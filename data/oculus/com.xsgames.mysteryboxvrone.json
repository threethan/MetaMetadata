934382610375855", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38974473_1934382613709188_7156337812617042679_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tgn9IGp_05YQ7kNvwHEbVOy&_nc_oc=AdrVzGlDP-4by_IFQZ417ycnrRa_tO85dojtcd9czJxyU_S8kA8WKf2n1POkhK9V0yA&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSlpEGQeOhjF6C--56zqVxkZ8fTcf3zPtwI2vDXyMWmPg&oe=6AFB24B3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape_coverart.png", "id": "897861905346420", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38982672_897861908679753_3996777238831042692_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VCNHLBJZ0tkQ7kNvwFGVsBB&_nc_oc=AdoWrzTEjVkABWNLwpLWv8_MJKvxB7Kf4iCmWL7JsaNDmldgPwkWcEeARXwbMfvccJ0&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTtFM2UUzvLhaH5nmlyqwKUahQIY_XaT28Zrw2UpXUU2w&oe=6AFB272B"}, "display_name": "Mystery Box VR: Hidden Secrets Escape", "keywords": ["puzzle", "escape", "room", "trivia", "brainteaser"], "long_description": "# AN IMMERSIVE VR PUZZLE EXPERIENCE\nInteract with objects, handles, buttons, and wheels on each side. Crack enigmas and collect hidden puzzle tiles on a random side of the boxes.\n\nYou won't be able to compare reality with fiction.\n\n# DISCOVER INVENTIONS\nOnce you unlock all 8 boxes of a Level Pack, you can compose a puzzle and discover a brief history of an invention.\n\nIt's not always easy to escape the room, so use all your IQ to crack the riddles. There's a logic behind all of them, even where it seems it's not!\n\n# IMMERSIVE SOUNDTRACK\nPlay the game with your headphones to get immersed in this amazing adventure.\n\n# HINTS\nGot stuck on some enigma? No worries, you can still get a helpful hint! You can also get in touch with me in case you really can't make it through a riddle, I'll be glad to help ;)\n\n# MULTILANGUAGE\nAvailable in English, French, Italian, German, Spanish, Russian, and Japanese.\n\nThe game language will change automatically based on the language settings of your device", "short_description": "Crack awesome puzzles around many boxes, and discover the history of the world's most popular inventions!"}, {"images": {"nodes": [{"file_name": "logoTransparent.png", "id": "3812261432362188", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38974562_3812261435695521_5176404439574971225_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uXXeQ_G0DlUQ7kNvwEqV0Bj&_nc_oc=Adp4bx7TPsGA1dTTh3qrm0dDORCnQoa3926dqSD74_MKDqWoHgnKB2ld3XtXuxun9KE&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQThcF2lUmvYoP5TghxTkAQbkAvFmPI9g8R0R8g3ZH9YTQ&oe=6AFB14D6"}, {"file_name": "portrait_coverart.png", "id": "1953342038506987", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38982581_1953342045173653_4906879878373922307_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lx9lNuTX6RMQ7kNvwEL7Wbb&_nc_oc=Ado7WenZIM-JsdeBn5rhzFjnbx7-AHFuAK781f2Ta9U0UIf-wk4RBOfO051NYJxqGmA&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSmVbvs3GmTKgf-GZXT6Spb4RCj7Ag4veLVSq5KHY3rNg&oe=6AFB35FD"}, {"file_name": "landscape_coverart.png", "id": "1300403051139202", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/75462955_1300403057805868_2288822001409671177_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=teTK0EVsvnkQ7kNvwFyHp0Z&_nc_oc=AdoNMP0C64uT-2DZrwFpufMPkK92eS5TR3hl0DQIos4mZ7J1mwBq2OV9zXE5QN1fi_I&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQlt4hXEwlKgXoXDf5Q6SzJZ96p4gjL8rdJctwDIjpHhw&oe=6AFB26A0"}, {"file_name": "square_coverart.png", "id": "914408640187392", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/39036626_914408643520725_6339598287132
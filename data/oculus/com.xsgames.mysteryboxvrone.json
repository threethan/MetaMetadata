HYoLJbacEzpU6frxYj2JNHv-Db4NrVtcmOLVQppn4sYQ&oe=6A74A4C4"}, {"file_name": "5.png", "id": "467916352871409", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39003282_467916356204742_1871921057092171900_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2qdTpt2K4QwQ7kNvwEP49z1&_nc_oc=Adr1AEMZhe1DdSzEQU4mzQNqkcC8PUNYxjNc7oQrhtgJrFaYZn7DqrEHnsYmf-Onj_c&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHxEjaewNj_HAcJeBxHrsRKMz875QflCrvYJp32p-uctQ&oe=6A748962"}, {"file_name": "3.png", "id": "1934382610375855", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974473_1934382613709188_7156337812617042679_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ifFPPSONnIkQ7kNvwEBkFmx&_nc_oc=AdrX2iVjOBpUzGDFg_YwCw1G9l9OT1cYg3Vqu6dhYg4eNt9ynwU4dmBxEuaBstyDeGU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGMXvgzFS6pDVp4fR5U7_LYuyUnejYdCHjaqpFdihnlBA&oe=6A747373"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape.png", "id": "1524760081483769", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974531_1524760084817102_6497712644828891067_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M3tT88uFps4Q7kNvwGfVXTm&_nc_oc=AdpW_yb18tBsbbgldWDXjlDTBnzxVVGa9VMgNO9tFIji3cIT9dCf1YBGW9g0i4xuHZ8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFbAI_YwFuBcsXmxoUIZaBLtdk1LRhD1J2dIXs-qYVW5w&oe=6A74726F"}, "display_name": "Mystery Box VR: Hidden Secrets", "keywords": [], "long_description": " AN IMMERSIVE VR PUZZLE EXPERIENCE\nInteract with objects, handles, buttons, and wheels on each side. Crack enigmas and collect hidden puzzle tiles on a random side of the boxes.\n\nYou won't be able to compare reality with fiction.\n\n# DISCOVER INVENTIONS\nOnce you unlock all 8 boxes of a Level Pack, you can compose a puzzle and discover a brief history of an invention.\n\nIt's not always easy to escape the room, so use all your IQ to crack the riddles. There's a logic behind all of them, even where it seems it's not!\n\n# IMMERSIVE SOUNDTRACK\nPlay the game with your headphones to get immersed in this amazing adventure.\n\n# HINTS\nGot stuck on some enigma? No worries, you can still get a helpful hint! You can also get in touch with me in case you really can't make it through a riddle, I'll be glad to help ;)\n\n# MULTILANGUAGE\nAvailable in English, French, Italian, German, Spanish, Russian, and Japanese.\n\nThe game language will change automatically based on the language settings of your device", "short_description": "A VR escape room game where you have to solve intriguing riddles to open boxes and discover nice stories about popular inventions!"}, {"images": {"nodes": [{"file_name": "$R36BSY5.png", "id": "3678762505771822", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031430_3678762509105155_2151975047074617165_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ubfOKf3MSGYQ7kNvwFk7sUi&_nc_oc=Adp0OQLOI6nCX9UezOLlO-jfNh3_12NjoIjsPRKrUeGlvPItaSNvP1072mNZNflNrgE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGh-kSQjxcytHlpuztC1QnYVpL2QMPpglhQE8TF5hg9eA&oe=6A74A6A5"}, {"file_name": "$R81V725.png", "id": "2720695481426567", "image_type": "APP_IMG_ICON", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75262743_2720695484759900_604086922326600035_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T0TQXPqI-cMQ7kNvwEQ2ONQ&_nc_oc=AdpykAK-gQ9ZuIPcpc9QCKK6_E1I7gCUPo_ASL_AatxUv3eNtGnw9JZCDl8JfQFt8K8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHdyDm3cLdJfydLbab0aXuNXB7ASJQfC4yOVeNewwZ6rQ&oe=6A74A58D"}, {"file_name": "$RQ3SN6U.png", "id": "1552311425628973", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982519_1552311428962306_1218130395049083834_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XWQBTnVkUOwQ7kNvwEfKFHF&_nc_oc=Ado-DTVHaNGsb2tYYS5U6JnzIeyqhqMD6ugIJ1exmJRxUbSfYqshwpttYph2QLgbWTM&_nc_zt=3&_nc_ht=
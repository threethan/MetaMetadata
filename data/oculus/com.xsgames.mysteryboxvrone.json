8_uM3Yf-GUBekvjAU25tIeRlHhu0OKHG-bnc2fJa95ew&oe=6A3FE8C4"}, {"file_name": "5.png", "id": "467916352871409", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39003282_467916356204742_1871921057092171900_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SDrgiPx58-cQ7kNvwGFZNKY&_nc_oc=AdpLFvtR6b__Y1R4r8wrhYNmDwOJgdDJBu-mu9HhaEaBk4ui2S44v7h0xT8hAdktTLk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-iNMzn6ssFXLUY93Dw2KKRi-WvYA-g-N57BuJowFJNJw&oe=6A3FCD62"}, {"file_name": "3.png", "id": "1934382610375855", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974473_1934382613709188_7156337812617042679_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xAXFgyuiGLoQ7kNvwF25Q_n&_nc_oc=AdoCfS3O3XV9cmaYfRBxjvtkjA-VsbzvB5acwq4IguU4fFTOH4Vvf865Zps5jnwRt_A&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_QdhfF2_xg2lSUIfSvmRhH6EhzDnidyIlCmul_3s_ViQ&oe=6A3FEFB3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape.png", "id": "1524760081483769", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974531_1524760084817102_6497712644828891067_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XNEzD2zC-usQ7kNvwHRn_QM&_nc_oc=AdoWcr3Nv8Y35Cyck4sT2NJ8JHPjkIra6mXfuZM208pHsY5j2PdU3lLcfuCchCzqAmg&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_Fq9nb0T-Thl81xS6brKAVUrph8x2cqR2pqCLM-HgD6g&oe=6A3FEEAF"}, "display_name": "Mystery Box VR: Hidden Secrets", "keywords": [], "long_description": " AN IMMERSIVE VR PUZZLE EXPERIENCE\nInteract with objects, handles, buttons, and wheels on each side. Crack enigmas and collect hidden puzzle tiles on a random side of the boxes.\n\nYou won't be able to compare reality with fiction.\n\n# DISCOVER INVENTIONS\nOnce you unlock all 8 boxes of a Level Pack, you can compose a puzzle and discover a brief history of an invention.\n\nIt's not always easy to escape the room, so use all your IQ to crack the riddles. There's a logic behind all of them, even where it seems it's not!\n\n# IMMERSIVE SOUNDTRACK\nPlay the game with your headphones to get immersed in this amazing adventure.\n\n# HINTS\nGot stuck on some enigma? No worries, you can still get a helpful hint! You can also get in touch with me in case you really can't make it through a riddle, I'll be glad to help ;)\n\n# MULTILANGUAGE\nAvailable in English, French, Italian, German, Spanish, Russian, and Japanese.\n\nThe game language will change automatically based on the language settings of your device", "short_description": "A VR escape room game where you have to solve intriguing riddles to open boxes and discover nice stories about popular inventions!"}, {"images": {"nodes": [{"file_name": "$R36BSY5.png", "id": "3678762505771822", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031430_3678762509105155_2151975047074617165_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Nw7-df-V050Q7kNvwHLplxz&_nc_oc=AdpksnnKx9z1veFw7fTzBW3Rh8eoGzMfqeN8j6PQsI2n-xQcc_zS-u4L67oLQ5zyKIM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-112SEGnw_Y9_V3mFIPyH-UGLMO5MXLrWIFFGw0gLLVQ&oe=6A3FEAA5"}, {"file_name": "$R81V725.png", "id": "2720695481426567", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75262743_2720695484759900_604086922326600035_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TYpfzZiyoPUQ7kNvwFqJCjY&_nc_oc=AdoXY7AQsJr5LfRW8Yi657By3aelHKp8IJH-bYozHj2IbXzqD-Vr_6lpsT36HDA5dUc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af91UBGnYf8yRGQIhlewjA1MENaA0L-0jBCOr-YfOoMA0w&oe=6A3FE98D"}, {"file_name": "$RQ3SN6U.png", "id": "1552311425628973", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982519_1552311428962306_1218130395049083834_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ByUqvsrSJiEQ7kNvwE7jGVn&_nc_oc=Adr5_ZDk4T2hG6p0uffAvxMEb35EpK2MpZFg-v73v1Wgb2TQYNcsOvavN24f9TdwQ8g&_nc_zt=3&_nc_ht=
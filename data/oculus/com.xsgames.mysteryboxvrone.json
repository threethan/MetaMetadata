CI8GiHxMlgd0-CPzNJKHTMx-EYmJqp3hmAQgQVhY9Bpg&oe=6A5CB184"}, {"file_name": "5.png", "id": "467916352871409", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39003282_467916356204742_1871921057092171900_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gfMjMVstw0EQ7kNvwHmSL6P&_nc_oc=AdpuXUvEY0U4bmcJnG_SM15lct7NvG0t7u3_ZVP-uEdhy0xuNY57Nry1mxqWxqFdmPU&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDLo4S_7bHIKLgpcGJ4QUWnF5dGlwi7S2TSptP5NVWR-Q&oe=6A5CCE62"}, {"file_name": "3.png", "id": "1934382610375855", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974473_1934382613709188_7156337812617042679_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KYf0ZT147eoQ7kNvwGRVfes&_nc_oc=Adqau0hd6S54BxOOsFRYyHy3YnPQiZyB0EGlOgbE6EPsO_y4qiQFoLLXXXZnLhQd2Tc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBvmeL8JegE8_OVKXmR9b36bbd29jUIVPnSa9P7XxWgcA&oe=6A5CB873"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape.png", "id": "1524760081483769", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974531_1524760084817102_6497712644828891067_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-a63X8tpH40Q7kNvwFJmauO&_nc_oc=AdoJ0aobLHv1wXzOo-prnfpX6DgJkV2T7_1Yl2IgeG1FVb95VUJrhpAENwnTlw_oboE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB-kNst0vB6OZWZWm73zUoKzUTO1BYekAHbwgV7IzZCpQ&oe=6A5CB76F"}, "display_name": "Mystery Box VR: Hidden Secrets", "keywords": [], "long_description": " AN IMMERSIVE VR PUZZLE EXPERIENCE\nInteract with objects, handles, buttons, and wheels on each side. Crack enigmas and collect hidden puzzle tiles on a random side of the boxes.\n\nYou won't be able to compare reality with fiction.\n\n# DISCOVER INVENTIONS\nOnce you unlock all 8 boxes of a Level Pack, you can compose a puzzle and discover a brief history of an invention.\n\nIt's not always easy to escape the room, so use all your IQ to crack the riddles. There's a logic behind all of them, even where it seems it's not!\n\n# IMMERSIVE SOUNDTRACK\nPlay the game with your headphones to get immersed in this amazing adventure.\n\n# HINTS\nGot stuck on some enigma? No worries, you can still get a helpful hint! You can also get in touch with me in case you really can't make it through a riddle, I'll be glad to help ;)\n\n# MULTILANGUAGE\nAvailable in English, French, Italian, German, Spanish, Russian, and Japanese.\n\nThe game language will change automatically based on the language settings of your device", "short_description": "A VR escape room game where you have to solve intriguing riddles to open boxes and discover nice stories about popular inventions!"}, {"images": {"nodes": [{"file_name": "$R36BSY5.png", "id": "3678762505771822", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031430_3678762509105155_2151975047074617165_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8h7sr1DVsWUQ7kNvwHmRb-d&_nc_oc=AdpQh63X7nJG5uBQh2qSxKGdBlcHwkL-vEOGzyKd2rr-SBc_-1Fk0pioElAU47RAENc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCmEn2qo2vsASHbJlN5yH6d-lPfPfF1MgBXJj_lhHhNYA&oe=6A5CB365"}, {"file_name": "$R81V725.png", "id": "2720695481426567", "image_type": "APP_IMG_ICON", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75262743_2720695484759900_604086922326600035_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Xlxu1WTQS-8Q7kNvwHCxyEg&_nc_oc=AdqEEDmMGxkxKaz-_U4h1UPtUOoVLm3i_AkO_caORyNKRK6ypjGO4rPj2e2mfbcKB_Y&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDUsk9jybviwib3p8EuS-htMv1uNKpBKuXQOdhCGclCpg&oe=6A5CB24D"}, {"file_name": "$RQ3SN6U.png", "id": "1552311425628973", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982519_1552311428962306_1218130395049083834_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kXLOTrgizmsQ7kNvwGHMyu4&_nc_oc=Adr_V6mrs1nIupS30Yp9a1n-R-p5bG8VArFxxigUsqCEkrjYgEdQILbPFs6EbA3vXpA&_nc_zt=3&_nc_ht=
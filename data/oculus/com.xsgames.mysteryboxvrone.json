QAMRuSilYtSnxjNiiS0IRf9wMcClELHRjpemwBAKVQaQ&oe=6AF9CC44"}, {"file_name": "5.png", "id": "467916352871409", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39003282_467916356204742_1871921057092171900_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NWEJuoBfNeMQ7kNvwEq3AoQ&_nc_oc=AdolZ1UeKgH3_k1sAZcJJm6IhJ7gcX4jlwZ8Uzzl3VG8tXNCJDdBKuk1T1jdhHbw8oM&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSlWIr9jC-mspyquz7wZWsxrc6E3bfavYOt3mLIc3H21A&oe=6AF9E922"}, {"file_name": "3.png", "id": "1934382610375855", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974473_1934382613709188_7156337812617042679_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tgn9IGp_05YQ7kNvwF4Ucui&_nc_oc=AdrsDlOrANtkEQgvw4DwBBz2SFTbbzOJYI-QmMwFCg7DKd4jM1x6CFI-bbMAxcF5MS0&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQpsuO-huDOx8CFxhfvc2broD7YAT7nMQyVWynDSYgV_w&oe=6AF9D333"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape.png", "id": "1524760081483769", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974531_1524760084817102_6497712644828891067_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=t4nPUeFwTv0Q7kNvwHzVAYw&_nc_oc=Adp6I4bt8-lQyrJQY9GQyQ2Nf1bDNwBl6-Vrd6p3YYeqwrmocGnIB-L0yGp0Z9hHAts&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSYYm06UGFrzPyfJDM8aCB8x8uZ1l-xKS7cAYY9xuRD5g&oe=6AF9D22F"}, "display_name": "Mystery Box VR: Hidden Secrets", "keywords": [], "long_description": " AN IMMERSIVE VR PUZZLE EXPERIENCE\nInteract with objects, handles, buttons, and wheels on each side. Crack enigmas and collect hidden puzzle tiles on a random side of the boxes.\n\nYou won't be able to compare reality with fiction.\n\n# DISCOVER INVENTIONS\nOnce you unlock all 8 boxes of a Level Pack, you can compose a puzzle and discover a brief history of an invention.\n\nIt's not always easy to escape the room, so use all your IQ to crack the riddles. There's a logic behind all of them, even where it seems it's not!\n\n# IMMERSIVE SOUNDTRACK\nPlay the game with your headphones to get immersed in this amazing adventure.\n\n# HINTS\nGot stuck on some enigma? No worries, you can still get a helpful hint! You can also get in touch with me in case you really can't make it through a riddle, I'll be glad to help ;)\n\n# MULTILANGUAGE\nAvailable in English, French, Italian, German, Spanish, Russian, and Japanese.\n\nThe game language will change automatically based on the language settings of your device", "short_description": "A VR escape room game where you have to solve intriguing riddles to open boxes and discover nice stories about popular inventions!"}, {"images": {"nodes": [{"file_name": "$R36BSY5.png", "id": "3678762505771822", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39031430_3678762509105155_2151975047074617165_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Eejqr2YHEMAQ7kNvwFBGakz&_nc_oc=AdqO3MtI6j2Q6prRHBbwWTEhwQBJM4dbiqKS6TBm3l-mTiTXFUsUs-vNpsscUWMq7S4&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR_4IygWFJvFCRP-kqQ7hPSP93qOK-ZXHC0Z1bBIqR7GQ&oe=6AF9CE25"}, {"file_name": "$R81V725.png", "id": "2720695481426567", "image_type": "APP_IMG_ICON", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/75262743_2720695484759900_604086922326600035_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ueno0W4_KYcQ7kNvwEs8y2h&_nc_oc=Adr3urwmnb071b14Ocg8Zv_dlNZP7Ii3GvhLdfPuEnNjkFbR5FASNHbcntfml5Cr_Os&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSW0RevgZdJ3m7zI7bc04STlND4B-dZbkXBLkVTJw1zzg&oe=6AF9CD0D"}, {"file_name": "$RQ3SN6U.png", "id": "1552311425628973", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38982519_1552311428962306_1218130395049083834_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vSPJdjLqdawQ7kNvwEeH7o2&_nc_oc=AdoPehLOx___zk9WbWemeiVpk1c4Z1JfyCChGNrXDo54Aqk8CZyrW_Ga4htEta5tvt8&_nc_zt=3&_nc_ht=
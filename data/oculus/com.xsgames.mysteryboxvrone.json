57v8vT11rvOVo-xgZpSFJrAlGsjzSGFItp97FecuRzSw&oe=6A19AD44"}, {"file_name": "5.png", "id": "467916352871409", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39003282_467916356204742_1871921057092171900_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6XZGJYljMBoQ7kNvwHcwSkD&_nc_oc=Adq8T5C4mswGegn5d50S6kCQvHuZomqjjPW-lLg0BShPRERDSQM1NmQCWlMnMU_4h7k&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6jYB9TvavnI4jfEjJza17jTQB1a5J7EATytqb49q3TQw&oe=6A1991E2"}, {"file_name": "3.png", "id": "1934382610375855", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974473_1934382613709188_7156337812617042679_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M54Zx1EASW0Q7kNvwEo6iEV&_nc_oc=AdoRGKE8cX_DV9XhFe207-fbtFZ_da4Fve_J5asPAqF5ARglZpX2ArSUzITPZaki_YE&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7qg_bpTQ9d95FFuO57rUIQ5k3JrukwrMntTAtsnbtb1w&oe=6A19B433"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape.png", "id": "1524760081483769", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974531_1524760084817102_6497712644828891067_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OFt5CveQvogQ7kNvwEs42lx&_nc_oc=AdqEnums7l5Xx0Y33bfoeBq3pM64_hoA4vNp93Mu0-Oaaj_P0j992HjfLGurc2rjppE&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6DrDEQy7li-dXznLZCldwdo6QzkCnKtKczuHNEL0dm0w&oe=6A19B32F"}, "display_name": "Mystery Box VR: Hidden Secrets", "keywords": [], "long_description": " AN IMMERSIVE VR PUZZLE EXPERIENCE\nInteract with objects, handles, buttons, and wheels on each side. Crack enigmas and collect hidden puzzle tiles on a random side of the boxes.\n\nYou won't be able to compare reality with fiction.\n\n# DISCOVER INVENTIONS\nOnce you unlock all 8 boxes of a Level Pack, you can compose a puzzle and discover a brief history of an invention.\n\nIt's not always easy to escape the room, so use all your IQ to crack the riddles. There's a logic behind all of them, even where it seems it's not!\n\n# IMMERSIVE SOUNDTRACK\nPlay the game with your headphones to get immersed in this amazing adventure.\n\n# HINTS\nGot stuck on some enigma? No worries, you can still get a helpful hint! You can also get in touch with me in case you really can't make it through a riddle, I'll be glad to help ;)\n\n# MULTILANGUAGE\nAvailable in English, French, Italian, German, Spanish, Russian, and Japanese.\n\nThe game language will change automatically based on the language settings of your device", "short_description": "A VR escape room game where you have to solve intriguing riddles to open boxes and discover nice stories about popular inventions!"}, {"images": {"nodes": [{"file_name": "$R36BSY5.png", "id": "3678762505771822", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031430_3678762509105155_2151975047074617165_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gnfq_UQS5vgQ7kNvwFExfr8&_nc_oc=AdpV_2HaACe2AHDB4oQx-DAjUJXnl8YJ6p0xubLEV-I-L0vwW4j3BN2WBs--5xPh8N4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7ICcosD3Yibj9YvvVaf-nomSt-4LaBjS2FubK8g6ZQzA&oe=6A19AF25"}, {"file_name": "$R81V725.png", "id": "2720695481426567", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75262743_2720695484759900_604086922326600035_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oKSnrwpohUAQ7kNvwGtHHiQ&_nc_oc=AdqguRxqXdf_caLFAnKAxGdRc8zquPOKlF67VNBe_pzJqn8C3njc8YfXT96R0qKQD78&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6xuJnnfSB3R5_MP-PK3mp9FoJoB3a9sN3wNfgbzZukhA&oe=6A19AE0D"}, {"file_name": "$RQ3SN6U.png", "id": "1552311425628973", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982519_1552311428962306_1218130395049083834_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nO9WkHKaXTwQ7kNvwFsTu6c&_nc_oc=AdroL6APLVE03I78v7e_ozatSKYumzX0kkV4TM2FrHU-B5ibhOBCXY_FsnIlt37oyuk&_nc_zt=3&_nc_ht=
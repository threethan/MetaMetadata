FMbD1dAy7MpMiLHj69_02sv8rCQOdTUHg7PMf3pij4yg&oe=6A75F644"}, {"file_name": "5.png", "id": "467916352871409", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39003282_467916356204742_1871921057092171900_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2qdTpt2K4QwQ7kNvwHcMWFc&_nc_oc=Adpp07ZXAQUDhz81kxZvPSX12RKSga_q1BVnVfQK8pP9YPWD4sHtrCj88I8M9biDtJI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEkLra2TbVFQn-bzlFmxKRJH6Nrde0il8SgAHzTI3WU5A&oe=6A75DAE2"}, {"file_name": "3.png", "id": "1934382610375855", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974473_1934382613709188_7156337812617042679_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KPiG156k8TMQ7kNvwGLvogw&_nc_oc=Adqcxw2Tdb_JoqF8KBXb2aG0CS1ftxRuQ6JktO2dZFCB8DqrpvMF4DIJN2EmB_mxpwY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHYU-gCn6taXu_jzScl98gnrWc5pwnLBrs5jS7v5dYIRQ&oe=6A75C4F3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape.png", "id": "1524760081483769", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974531_1524760084817102_6497712644828891067_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M3tT88uFps4Q7kNvwEVmOEi&_nc_oc=Adouzo2hjM7SM74lpz0-Feg5ogFGtTq__sEYOm-Roy2OxJe4chLbs9zGFTNa5BP8CrU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG3miPKm10c2OxDhDai8izox5BqDi5e1ltWITAJBGvJ8w&oe=6A75C3EF"}, "display_name": "Mystery Box VR: Hidden Secrets", "keywords": [], "long_description": " AN IMMERSIVE VR PUZZLE EXPERIENCE\nInteract with objects, handles, buttons, and wheels on each side. Crack enigmas and collect hidden puzzle tiles on a random side of the boxes.\n\nYou won't be able to compare reality with fiction.\n\n# DISCOVER INVENTIONS\nOnce you unlock all 8 boxes of a Level Pack, you can compose a puzzle and discover a brief history of an invention.\n\nIt's not always easy to escape the room, so use all your IQ to crack the riddles. There's a logic behind all of them, even where it seems it's not!\n\n# IMMERSIVE SOUNDTRACK\nPlay the game with your headphones to get immersed in this amazing adventure.\n\n# HINTS\nGot stuck on some enigma? No worries, you can still get a helpful hint! You can also get in touch with me in case you really can't make it through a riddle, I'll be glad to help ;)\n\n# MULTILANGUAGE\nAvailable in English, French, Italian, German, Spanish, Russian, and Japanese.\n\nThe game language will change automatically based on the language settings of your device", "short_description": "A VR escape room game where you have to solve intriguing riddles to open boxes and discover nice stories about popular inventions!"}, {"images": {"nodes": [{"file_name": "$R36BSY5.png", "id": "3678762505771822", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031430_3678762509105155_2151975047074617165_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ubfOKf3MSGYQ7kNvwG0UUL_&_nc_oc=AdpxT7ASiilkVou5jkHnUytQ7njjE26J9oSudj0aqLtY4sfBWIt2giJGoTWDvR6tsE8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGNpQAxoTIryA5oMj9zaQL8YHDS3Ob93XpA2vaWi8fo2g&oe=6A75F825"}, {"file_name": "$R81V725.png", "id": "2720695481426567", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75262743_2720695484759900_604086922326600035_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dlQzlVuxhg4Q7kNvwH2tK4c&_nc_oc=Ado46BUkTv8WvA0uMIZu00oMJ8lQhDgKnIlwk6tyEuQCPCekZd47AOq3d20CNa526ss&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEZiRKsZpNKlysDkgAmI5FNVX0PIWFnop-SNhuuxwfdjw&oe=6A75F70D"}, {"file_name": "$RQ3SN6U.png", "id": "1552311425628973", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982519_1552311428962306_1218130395049083834_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XWQBTnVkUOwQ7kNvwHjbdqG&_nc_oc=AdoOnXOQERXAZk_bLKJcodWWCacMxM5t4klRrvzCTgdV6SStHw6QEhGfYnUMzolnlVU&_nc_zt=3&_nc_ht=
C8mLBCeHD4qDWC7rnQnIWbuBWHcbKJln3O6GLbEc_IRQ&oe=6A5A46C4"}, {"file_name": "5.png", "id": "467916352871409", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39003282_467916356204742_1871921057092171900_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QBVflbKl50oQ7kNvwFrhZBV&_nc_oc=AdoVgH-EyTdeSpYwI6Np5aWkzKO59h2e2m-IpzVrNuGxSe-56KskMZt8_7ifDZZpX9o&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDc4nC8jKOgT7-cObvuUEF6MCYEc6t9bgsR8SWG1XEYRw&oe=6A5A2B62"}, {"file_name": "3.png", "id": "1934382610375855", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974473_1934382613709188_7156337812617042679_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KYf0ZT147eoQ7kNvwFoiahY&_nc_oc=Adpy4re-FjCvR91Cr-rJHJwpxHyYIEQmht6TivsWNn4ub5YlDrV__xEagSnaHWYBwP4&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC_tu-zyVEVdd19r5HYCWaLKhmV0R1MiKJKuJSmbagJqA&oe=6A5A1573"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape.png", "id": "1524760081483769", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974531_1524760084817102_6497712644828891067_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D-9vpuirp_IQ7kNvwGF1Fsk&_nc_oc=Adq1S0WEbzPsqWCZXuJZLzoCn1CPmlnPZHbpC9ojgIA8xr5fpBB4osL9kX0AI-SIcgM&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAcVT7WGqIEDgVKdcQZYcMtec-zxmi2DxDIwf3x4unUnQ&oe=6A5A146F"}, "display_name": "Mystery Box VR: Hidden Secrets", "keywords": [], "long_description": " AN IMMERSIVE VR PUZZLE EXPERIENCE\nInteract with objects, handles, buttons, and wheels on each side. Crack enigmas and collect hidden puzzle tiles on a random side of the boxes.\n\nYou won't be able to compare reality with fiction.\n\n# DISCOVER INVENTIONS\nOnce you unlock all 8 boxes of a Level Pack, you can compose a puzzle and discover a brief history of an invention.\n\nIt's not always easy to escape the room, so use all your IQ to crack the riddles. There's a logic behind all of them, even where it seems it's not!\n\n# IMMERSIVE SOUNDTRACK\nPlay the game with your headphones to get immersed in this amazing adventure.\n\n# HINTS\nGot stuck on some enigma? No worries, you can still get a helpful hint! You can also get in touch with me in case you really can't make it through a riddle, I'll be glad to help ;)\n\n# MULTILANGUAGE\nAvailable in English, French, Italian, German, Spanish, Russian, and Japanese.\n\nThe game language will change automatically based on the language settings of your device", "short_description": "A VR escape room game where you have to solve intriguing riddles to open boxes and discover nice stories about popular inventions!"}, {"images": {"nodes": [{"file_name": "$R36BSY5.png", "id": "3678762505771822", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39031430_3678762509105155_2151975047074617165_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YRmPD2doEx8Q7kNvwF8s1dC&_nc_oc=AdpaILd1VH0L-IDuE709nNiA8-hyr-oHY7QbEQXKOifc4tPgeUcMWIwI1BlTsSWaxys&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDlPg2fJiSixVA0vAxVl-SpEe6cpq3wJugQXqWjHFEFJA&oe=6A5A48A5"}, {"file_name": "$R81V725.png", "id": "2720695481426567", "image_type": "APP_IMG_ICON", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/75262743_2720695484759900_604086922326600035_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Xlxu1WTQS-8Q7kNvwFqwDF4&_nc_oc=AdqDjDdDu8NAhErEefTL2fyE_i_QZpyd3CKC7-XcPfdKftlWyOfaMAVaX-RDZa0IocI&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAu6W7hxxR22j_WIvTt96ANFH_FzJHhHPknNkv93eSgaQ&oe=6A5A478D"}, {"file_name": "$RQ3SN6U.png", "id": "1552311425628973", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38982519_1552311428962306_1218130395049083834_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0dZ7NLrzPSMQ7kNvwET4y21&_nc_oc=Ado1RGMsZd1Kolq_oMXhE31u8-8mL-GJe-1J7HqWoVTZWqIwAX_6Oi_vbD1LpCUe4rg&_nc_zt=3&_nc_ht=
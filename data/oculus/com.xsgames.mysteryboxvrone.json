934382610375855", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974473_1934382613709188_7156337812617042679_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KSxdCWyez7gQ7kNvwE6i6f0&_nc_oc=AdoIyCIQ8hJ1xXDnMkw3amtdAN2A5K4fTn79ftsJACdO7ksbiXgbDlpMRzoJc10Bxo8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQW4it47WEKhadm3SPeMKvBs7kPQo6CETQXoPWUxYZTcJQ&oe=6B0F2373"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape_coverart.png", "id": "897861905346420", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982672_897861908679753_3996777238831042692_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fRWQDnqJTM8Q7kNvwG85TiW&_nc_oc=AdrQ_x5ACxv7ct6LiTF7XUSWw1N1U_VjdVNTUWIbeLdJpxrsXQix0HA5s-FCCzg0c8c&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVPMQ2PU-5GD8nJt59jvoR9Fbomw60wveZho-dLKOJxqQ&oe=6B0EEDAB"}, "display_name": "Mystery Box VR: Hidden Secrets Escape", "keywords": ["puzzle", "escape", "room", "trivia", "brainteaser"], "long_description": "# AN IMMERSIVE VR PUZZLE EXPERIENCE\nInteract with objects, handles, buttons, and wheels on each side. Crack enigmas and collect hidden puzzle tiles on a random side of the boxes.\n\nYou won't be able to compare reality with fiction.\n\n# DISCOVER INVENTIONS\nOnce you unlock all 8 boxes of a Level Pack, you can compose a puzzle and discover a brief history of an invention.\n\nIt's not always easy to escape the room, so use all your IQ to crack the riddles. There's a logic behind all of them, even where it seems it's not!\n\n# IMMERSIVE SOUNDTRACK\nPlay the game with your headphones to get immersed in this amazing adventure.\n\n# HINTS\nGot stuck on some enigma? No worries, you can still get a helpful hint! You can also get in touch with me in case you really can't make it through a riddle, I'll be glad to help ;)\n\n# MULTILANGUAGE\nAvailable in English, French, Italian, German, Spanish, Russian, and Japanese.\n\nThe game language will change automatically based on the language settings of your device", "short_description": "Crack awesome puzzles around many boxes, and discover the history of the world's most popular inventions!"}, {"images": {"nodes": [{"file_name": "logoTransparent.png", "id": "3812261432362188", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974562_3812261435695521_5176404439574971225_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Uldfhok_E2MQ7kNvwFlsZSW&_nc_oc=AdrdWXeWi_9E8NR7ec4NWUEgDbDI7PzedSTkmqKkVLj7rSYNx6PmkjNDh3AqezMg3a8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVkNpepBSGpixaH90lkJp86fS57H2xmgyupE5TuMs0hQg&oe=6B0F1396"}, {"file_name": "portrait_coverart.png", "id": "1953342038506987", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982581_1953342045173653_4906879878373922307_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Dr99sHP95ccQ7kNvwEYC4lU&_nc_oc=AdpH6-CClYAgEBobIvZedUpKU9th7zO_4MkfAs0FhZwXhDIQAKiXQxN3sD8xDt03ECA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQUn72JPsMZELkx2o3j-Z50fAmXFQKHDK9qwqm8Qyy7cgQ&oe=6B0EFC7D"}, {"file_name": "landscape_coverart.png", "id": "1300403051139202", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75462955_1300403057805868_2288822001409671177_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w5EXsJPZexIQ7kNvwHikJLA&_nc_oc=AdrK1sR1ZNROWQlzrrZra6QDzZviLiEk_fmSkFsgIj7LTTf-8slMaug8z1NHNYfmiiU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQU9z4Rm9h9g55fTZ7OzqE5lmC_kfQtK5WDnr5lrh4s8EQ&oe=6B0EED20"}, {"file_name": "square_coverart.png", "id": "914408640187392", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39036626_914408643520725_6339598287132
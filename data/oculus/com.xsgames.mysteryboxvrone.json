D4uTK4kpogp0NzYyn8H7msgNKrlXLUuJxUsPnbsUQ89w&oe=6A688F04"}, {"file_name": "5.png", "id": "467916352871409", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39003282_467916356204742_1871921057092171900_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QvvQN8Tao1sQ7kNvwHV7xpp&_nc_oc=Adq7K4gkYnWcO2RZSamFnCbEHaTmci6LrohDMnXrrWiAs5nmFDvmgU2kb_x4CmjJqgo&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBJoAI_D4_8lpjXX9qXsIyBLagez9BRBLsWGLGvhDwU7w&oe=6A68ABE2"}, {"file_name": "3.png", "id": "1934382610375855", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38974473_1934382613709188_7156337812617042679_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2upa2w1b5UcQ7kNvwGKo045&_nc_oc=AdrhfsMyTMP5SU6XyWOmzyin3rmkDL-K-AmVYDeNFZr2-UdLZns1H2GKf-ODFoxw8os&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAecs_oulnSwFMndGIGzTDstLrtj0dCm6SrN4QB3NLwLw&oe=6A6895F3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape.png", "id": "1524760081483769", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38974531_1524760084817102_6497712644828891067_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mQrlYBu0Y1YQ7kNvwHoI19C&_nc_oc=AdoWo8n8P38Jgu9DaUysrJSyUDEYKC31PaUB9jQgYKPSXcndiGQDB0dymMtbL3Ywyas&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAHqEu_f6CQRbdNkjOfuR28kGWlizxn6Omc3jyZA-0rQA&oe=6A6894EF"}, "display_name": "Mystery Box VR: Hidden Secrets", "keywords": [], "long_description": " AN IMMERSIVE VR PUZZLE EXPERIENCE\nInteract with objects, handles, buttons, and wheels on each side. Crack enigmas and collect hidden puzzle tiles on a random side of the boxes.\n\nYou won't be able to compare reality with fiction.\n\n# DISCOVER INVENTIONS\nOnce you unlock all 8 boxes of a Level Pack, you can compose a puzzle and discover a brief history of an invention.\n\nIt's not always easy to escape the room, so use all your IQ to crack the riddles. There's a logic behind all of them, even where it seems it's not!\n\n# IMMERSIVE SOUNDTRACK\nPlay the game with your headphones to get immersed in this amazing adventure.\n\n# HINTS\nGot stuck on some enigma? No worries, you can still get a helpful hint! You can also get in touch with me in case you really can't make it through a riddle, I'll be glad to help ;)\n\n# MULTILANGUAGE\nAvailable in English, French, Italian, German, Spanish, Russian, and Japanese.\n\nThe game language will change automatically based on the language settings of your device", "short_description": "A VR escape room game where you have to solve intriguing riddles to open boxes and discover nice stories about popular inventions!"}, {"images": {"nodes": [{"file_name": "$R36BSY5.png", "id": "3678762505771822", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39031430_3678762509105155_2151975047074617165_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yktsoRUXY78Q7kNvwHI05Lt&_nc_oc=Adob5Gqu3kz3H-cs2scYwY7ZwIqC9T5Z-YRKVZiwezo5-Tbzs4N8JtyZaDPcGLRLIqI&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBk2VQ1AjsodcJ9yk2QY_PvNfFCWMh4BCWmQD9XAz4X4Q&oe=6A6890E5"}, {"file_name": "$R81V725.png", "id": "2720695481426567", "image_type": "APP_IMG_ICON", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75262743_2720695484759900_604086922326600035_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5_ss3kzpapAQ7kNvwFkBmZF&_nc_oc=Adq7OA9PT1HzIi-k6pMPnnrEZ0lGtzvFVf2JuEJin4eLHR76BRjL0xJR2uZEextt35U&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDuAGwxXcNtpp1lFRqF_ma0qTRa5y68wkkGhzKC9Cdx3g&oe=6A688FCD"}, {"file_name": "$RQ3SN6U.png", "id": "1552311425628973", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982519_1552311428962306_1218130395049083834_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ekVuDoUbgFoQ7kNvwFIcfMS&_nc_oc=Adr4l3u9Ni4ZWHfW1fEdtChSryTw13wEk-LoTFFapl4AViozEMmEV_CqYc1C0Ltk9zI&_nc_zt=3&_nc_ht=
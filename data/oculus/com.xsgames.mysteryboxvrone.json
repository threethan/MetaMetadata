6J9MuvZq0_0pv3D9tMP1xgYtpHPJ54EvV_x8GBTQln5g&oe=6A170A44"}, {"file_name": "5.png", "id": "467916352871409", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39003282_467916356204742_1871921057092171900_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g5kt4o103m0Q7kNvwEoo5-E&_nc_oc=Adq8K8X0qGGDvoVBCfbCl6p0ogUbI_PcxxWqr0ieK4IzDrFHngR-i62WTQvbsq_iFaM&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5i0w2jGi1ne8DSonNGr7bVvhtYdMiFQQ70_9zuL2wUTg&oe=6A16EEE2"}, {"file_name": "3.png", "id": "1934382610375855", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974473_1934382613709188_7156337812617042679_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M54Zx1EASW0Q7kNvwGvbtsA&_nc_oc=AdqvsBni2DwXZEfDZN1SPfiftkEq-NrkEkbbqijCBqpl46O1N8iXbc1AxeocqrVamNw&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5Hn1PAtdA3weVKfGPz2L5IO2n6rbisWXGU5EtXvQ2EDA&oe=6A171133"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape.png", "id": "1524760081483769", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974531_1524760084817102_6497712644828891067_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5RAjU1MEJ1EQ7kNvwFlmDqb&_nc_oc=AdrmoyVDVeahpNhvAN9Jjf_5yd7vnPFToMnz6ll4znFJBcxE_Ht-OYPJgyGyas6mN2M&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7h8glP_Z9dxTecWtu3WrM7_DMjaeo7hULsAAffj-AhBQ&oe=6A17102F"}, "display_name": "Mystery Box VR: Hidden Secrets", "keywords": [], "long_description": " AN IMMERSIVE VR PUZZLE EXPERIENCE\nInteract with objects, handles, buttons, and wheels on each side. Crack enigmas and collect hidden puzzle tiles on a random side of the boxes.\n\nYou won't be able to compare reality with fiction.\n\n# DISCOVER INVENTIONS\nOnce you unlock all 8 boxes of a Level Pack, you can compose a puzzle and discover a brief history of an invention.\n\nIt's not always easy to escape the room, so use all your IQ to crack the riddles. There's a logic behind all of them, even where it seems it's not!\n\n# IMMERSIVE SOUNDTRACK\nPlay the game with your headphones to get immersed in this amazing adventure.\n\n# HINTS\nGot stuck on some enigma? No worries, you can still get a helpful hint! You can also get in touch with me in case you really can't make it through a riddle, I'll be glad to help ;)\n\n# MULTILANGUAGE\nAvailable in English, French, Italian, German, Spanish, Russian, and Japanese.\n\nThe game language will change automatically based on the language settings of your device", "short_description": "A VR escape room game where you have to solve intriguing riddles to open boxes and discover nice stories about popular inventions!"}, {"images": {"nodes": [{"file_name": "$R36BSY5.png", "id": "3678762505771822", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39031430_3678762509105155_2151975047074617165_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y_wbhNyqj5oQ7kNvwGC7fGd&_nc_oc=Adqrc4OohJSZ-vVNdbddDkYSP8cOrLsxUeHEj-IjB2PSZ79TPu6w_21XfmDwmNCTKJo&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af43nTUz9HdFqdoFXbQssIwmdWFd-6M1fvHWDOO2TjfUOA&oe=6A170C25"}, {"file_name": "$R81V725.png", "id": "2720695481426567", "image_type": "APP_IMG_ICON", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/75262743_2720695484759900_604086922326600035_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oKSnrwpohUAQ7kNvwEcqCb6&_nc_oc=Adro_LRJYEg7nAtcBFcRR0_O2S214PUjyZCdCT8Z-aVJloAK67g_nG_uTx_sXrAxx9w&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7d1_sN81W7bFkUsTPAbCfJdqBZcH_I0H5NbYgNj2KlVQ&oe=6A170B0D"}, {"file_name": "$RQ3SN6U.png", "id": "1552311425628973", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38982519_1552311428962306_1218130395049083834_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZgOFrcAZKc4Q7kNvwFPT-i_&_nc_oc=Adqn8HPQI02IHbXbWC4QWRO33BljcotqapD8gnAEJAXX43KCm4n_4TYtzpfbWL7Zq2w&_nc_zt=3&_nc_ht=
4zKy0LHjL7ie7ngaBuaYP3nKSg00o4TJV8fsYOGrh45Q&oe=6A1EF344"}, {"file_name": "5.png", "id": "467916352871409", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39003282_467916356204742_1871921057092171900_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CJ_5dFS0kEQQ7kNvwHboMxa&_nc_oc=AdqUcOXoorvbfWCogDi64sAEFdp0Bz2QtOhzG2TFpeZIhlsx73FQVI2A2C4cK2yt9ZQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7HaIU_O-Yy8PuvfEnyG-r6cNyYjNGh_kOAENESMOIXgw&oe=6A1ED7E2"}, {"file_name": "3.png", "id": "1934382610375855", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974473_1934382613709188_7156337812617042679_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GbgUeM1Uk2MQ7kNvwFf5rob&_nc_oc=AdpBs_wzNNrkbYt-YRB3IXNY1zqiwBG3SVuxLwUyvr2wnGaQrCS0cRcZ2g-EwOgArag&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4rdZZG-tTQMhvgPhWVUWb728yLX5TlgFjaRTK6FKa6tA&oe=6A1EFA33"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape.png", "id": "1524760081483769", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974531_1524760084817102_6497712644828891067_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-1vldexJwcYQ7kNvwFGqpuM&_nc_oc=AdouafMj493K2JAcKkfW-_dLJykDGLzqhUXxaqxDEmDVmsxFvBNYcQmD7mSgNhK8Et8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6AVWpJ_4px-1b_OMoQqnk4k1d8khMcFDG_G9OWfWRJDA&oe=6A1EF92F"}, "display_name": "Mystery Box VR: Hidden Secrets", "keywords": [], "long_description": " AN IMMERSIVE VR PUZZLE EXPERIENCE\nInteract with objects, handles, buttons, and wheels on each side. Crack enigmas and collect hidden puzzle tiles on a random side of the boxes.\n\nYou won't be able to compare reality with fiction.\n\n# DISCOVER INVENTIONS\nOnce you unlock all 8 boxes of a Level Pack, you can compose a puzzle and discover a brief history of an invention.\n\nIt's not always easy to escape the room, so use all your IQ to crack the riddles. There's a logic behind all of them, even where it seems it's not!\n\n# IMMERSIVE SOUNDTRACK\nPlay the game with your headphones to get immersed in this amazing adventure.\n\n# HINTS\nGot stuck on some enigma? No worries, you can still get a helpful hint! You can also get in touch with me in case you really can't make it through a riddle, I'll be glad to help ;)\n\n# MULTILANGUAGE\nAvailable in English, French, Italian, German, Spanish, Russian, and Japanese.\n\nThe game language will change automatically based on the language settings of your device", "short_description": "A VR escape room game where you have to solve intriguing riddles to open boxes and discover nice stories about popular inventions!"}, {"images": {"nodes": [{"file_name": "$R36BSY5.png", "id": "3678762505771822", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031430_3678762509105155_2151975047074617165_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2ZlDI-jaHHMQ7kNvwGcBO6I&_nc_oc=AdqOM47zNtrRw193tBcL_FydDEGqskFDARFUbLem83NKtZYvQaroE5PCCdNgldYHF-c&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5PL7zV4etoxqJve41NVO_AfODWgtSweHTcQBFGwQd1Wg&oe=6A1EF525"}, {"file_name": "$R81V725.png", "id": "2720695481426567", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75262743_2720695484759900_604086922326600035_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8YTpD_IlhsMQ7kNvwHBVwP9&_nc_oc=AdpfdzDtxiSBWV7MZVdKI8TjFGFdqjRbpjOmEyeV_-rlhv6I8eIl-nLqFYKl2VNpnl8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6YJP50jDK6Hzy8XqhL-ndvsusgB3n-aTgEnQkla6oRMQ&oe=6A1EF40D"}, {"file_name": "$RQ3SN6U.png", "id": "1552311425628973", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982519_1552311428962306_1218130395049083834_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NoCqdmUsMfAQ7kNvwGe63PI&_nc_oc=AdoByKELZJiol17CfEVDQwRant3Fk9ZnAUPd6gkK49OohKjY9WovYHFT7D-VqBjCMMg&_nc_zt=3&_nc_ht=
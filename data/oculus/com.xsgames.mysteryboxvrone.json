s://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/39003282_467916356204742_1871921057092171900_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C465XMaV2qwQ7kNvwEttF6B&_nc_oc=Adn8fVwG8uPjD8p-uMHiDKVtqh4c_uz41D-kgz29nntRNPvsre5MY9Az_mQfQNNOSKs&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=8&oh=00_Afxmza33pbVWPuAMpr79P1Vu65YiYs19UmVWVL5HVR0oUg&oe=69AAD3E2"}, {"file_name": "3.png", "id": "1934382610375855", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/38974473_1934382613709188_7156337812617042679_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g9fn6Gui0_sQ7kNvwF3rBT_&_nc_oc=AdkulRj_J7T6hjvVTbwSuoDDSFN616wXFmn_BTfcIkzGG3mCs4V4KVCmLIIApcc8J-w&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=8&oh=00_AfxjP9oE3wA3f53DiX8OIQ8JX07dpKrVUn2TkCgj9a12qQ&oe=69AABDF3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape.png", "id": "1524760081483769", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/38974531_1524760084817102_6497712644828891067_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4eGKdO0LpHIQ7kNvwGZUPP4&_nc_oc=AdlZk1Haq8WcDX9S1r-fpTyxq5BTt74dDw3oeSN_reXOPujykQO5jhXdiHQF2gnY__k&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=8&oh=00_Afwdr3cMd3obhEiLYdQfKSzYBf7wUB75iOHGDCU682-LMw&oe=69AABCEF"}, "display_name": "Mystery Box VR: Hidden Secrets", "keywords": [], "long_description": " AN IMMERSIVE VR PUZZLE EXPERIENCE\nInteract with objects, handles, buttons, and wheels on each side. Crack enigmas and collect hidden puzzle tiles on a random side of the boxes.\n\nYou won't be able to compare reality with fiction.\n\n# DISCOVER INVENTIONS\nOnce you unlock all 8 boxes of a Level Pack, you can compose a puzzle and discover a brief history of an invention.\n\nIt's not always easy to escape the room, so use all your IQ to crack the riddles. There's a logic behind all of them, even where it seems it's not!\n\n# IMMERSIVE SOUNDTRACK\nPlay the game with your headphones to get immersed in this amazing adventure.\n\n# HINTS\nGot stuck on some enigma? No worries, you can still get a helpful hint! You can also get in touch with me in case you really can't make it through a riddle, I'll be glad to help ;)\n\n# MULTILANGUAGE\nAvailable in English, French, Italian, German, Spanish, Russian, and Japanese.\n\nThe game language will change automatically based on the language settings of your device", "short_description": "A VR escape room game where you have to solve intriguing riddles to open boxes and discover nice stories about popular inventions!"}, {"images": {"nodes": [{"file_name": "$R36BSY5.png", "id": "3678762505771822", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/39031430_3678762509105155_2151975047074617165_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sQi1z9ERDl8Q7kNvwHefUR7&_nc_oc=Adl4N-LbqVPu8LwY1tJ7c7RyKEKYmLmHiJOK_D1CPdtcBQ2kK_C7RGDLXlFY4kEfS60&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=8&oh=00_AfyT922k4zLghc8WgXDCIyVUpQUjfRZFTe-vDnDYOoHAug&oe=69AAB8E5"}, {"file_name": "$R81V725.png", "id": "2720695481426567", "image_type": "APP_IMG_ICON", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/75262743_2720695484759900_604086922326600035_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x6YxJkxic10Q7kNvwHhvvKa&_nc_oc=AdlSGCedlPGDH9DM2y1uXxgMCRiQ97KAR3Lwq-exWfz8Aazf_7WW1rdxg6kzdyBs6pg&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=8&oh=00_AfzctCKrlmvFKoLwB7V7Hw6AWkflJGObGpMnfRlkYtVslA&oe=69AAB7CD"}, {"file_name": "$RQ3SN6U.png", "id": "1552311425628973", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/38982519_1552311428962306_1218130395049083834_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PNmlVpahiC8Q7kNvwEbaW3b&_nc_oc=Admn86GBiQ6o42NypSqGEly2luBwE8ev9Z8ZO5UKVgnmMXt6c-dRQyKtjanIBF04-fs&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=8&oh=00_AfwH3ZAVmir8oSS5EAW5120WPQyZ76gdNLvWkzm0GUNZvg&oe=69AAC329"}, {"file_name": "38982645_10008
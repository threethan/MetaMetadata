5erDFDENYhm9jcRBFV8IzTIzwk_By7tZOQEKEw1DJtDg&oe=6A00A0C4"}, {"file_name": "5.png", "id": "467916352871409", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39003282_467916356204742_1871921057092171900_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sDZB5jIsWZ4Q7kNvwFoQy6y&_nc_oc=AdriUOFWe-lLhDk43s2yOzZ7FcZfMLC8uh6hNjXpLMOD0_EUQxX3E_GKPociH0gFEFw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7i3R9uC0nu3O0JL8oJTxfhU1GPmZBobfspef3LMje16w&oe=6A008562"}, {"file_name": "3.png", "id": "1934382610375855", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974473_1934382613709188_7156337812617042679_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FY5fOzh_KHkQ7kNvwHblpla&_nc_oc=AdptHe-gcAhuqNvCPg4SzPdRCd6pVRFDL8E-TmISlvi-UBCsru6nBkIJWnB52SNjRoU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6364M644yxXJL5AIcuVUAMRwKdIzwZRewiWRUP4s0T7Q&oe=6A006F73"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape.png", "id": "1524760081483769", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974531_1524760084817102_6497712644828891067_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VCgSacJElNwQ7kNvwHdIMqD&_nc_oc=AdpgF2iihBQZXy943Doj-ehRL7VH7QkIxpSTCle7oW-DZHUiKOiAUd9912uVxw1iTj0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af75EQYPnRt19aO-sIeVBSbsbCGSc782Pxkd7onQoKDZjA&oe=6A00A6AF"}, "display_name": "Mystery Box VR: Hidden Secrets", "keywords": [], "long_description": " AN IMMERSIVE VR PUZZLE EXPERIENCE\nInteract with objects, handles, buttons, and wheels on each side. Crack enigmas and collect hidden puzzle tiles on a random side of the boxes.\n\nYou won't be able to compare reality with fiction.\n\n# DISCOVER INVENTIONS\nOnce you unlock all 8 boxes of a Level Pack, you can compose a puzzle and discover a brief history of an invention.\n\nIt's not always easy to escape the room, so use all your IQ to crack the riddles. There's a logic behind all of them, even where it seems it's not!\n\n# IMMERSIVE SOUNDTRACK\nPlay the game with your headphones to get immersed in this amazing adventure.\n\n# HINTS\nGot stuck on some enigma? No worries, you can still get a helpful hint! You can also get in touch with me in case you really can't make it through a riddle, I'll be glad to help ;)\n\n# MULTILANGUAGE\nAvailable in English, French, Italian, German, Spanish, Russian, and Japanese.\n\nThe game language will change automatically based on the language settings of your device", "short_description": "A VR escape room game where you have to solve intriguing riddles to open boxes and discover nice stories about popular inventions!"}, {"images": {"nodes": [{"file_name": "$R36BSY5.png", "id": "3678762505771822", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031430_3678762509105155_2151975047074617165_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8qSUF7PSfaIQ7kNvwG8FpLN&_nc_oc=AdqZYBotdI3fiMweT_F7sHZcsJOMRw3yqA_hN1cUKQ4cjpZGNd_9sb9AVBH12L-U5VI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4keJEoOTzfQvSkCbCmWVin8AA084owPPjuOa-m4I6M7w&oe=6A00A2A5"}, {"file_name": "$R81V725.png", "id": "2720695481426567", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75262743_2720695484759900_604086922326600035_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UOLPL5g8Ga8Q7kNvwEZIE_k&_nc_oc=AdqxqobkYzvMvAXWEMmUKBqmDtN7DrgA8JL2z5HyOPXziqijPK15Vaj_NATxBgqx7Ew&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4o9c1RWDqVxrhorG0VyNjtMkN_3NNydFPHhxN0PUo4YA&oe=6A00A18D"}, {"file_name": "$RQ3SN6U.png", "id": "1552311425628973", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982519_1552311428962306_1218130395049083834_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ecafbifwA1wQ7kNvwEXByZI&_nc_oc=AdriPQTeADWI4ygqKy_4vl80pRI-ZMBOWn0-cShI8OLKCnDTJ_qanFzLbY3psawZa8A&_nc_zt=3&_nc_ht=
6guZEh_VmoRbw9SyVll3oUrO0HYy01Bg92q_zAnJoc1g&oe=6A1315C4"}, {"file_name": "5.png", "id": "467916352871409", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/39003282_467916356204742_1871921057092171900_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XL6RBML6uD8Q7kNvwHHnZ73&_nc_oc=AdqZRczJIQBUdZQ2Um2C_yqweCnVb2fXgF9WVYYGr4li1dPi15NM9fGs8nlL5dSrUCs&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4yPuVnrr6LDMnYElaqVQWYv1lBHv8uYogrrlsxUItPIA&oe=6A12FA62"}, {"file_name": "3.png", "id": "1934382610375855", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38974473_1934382613709188_7156337812617042679_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k6lKK9C5B3sQ7kNvwGLVAUv&_nc_oc=AdpWUaQIOQTYPIeZ2jDHFTVNxZG9l_poYmzFwG57YAWLXGm54cJRoMgyUOBrkAYZZiM&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5O_V5bn8u0aK5V3jYOazA3mL2j3XxAwJLT6H5pJmPiMw&oe=6A131CB3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape.png", "id": "1524760081483769", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38974531_1524760084817102_6497712644828891067_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q5VWurG7QAUQ7kNvwE1iePk&_nc_oc=AdrcjSaqxKwPtS0kqrbMnpiZ_frP5-cHxs-v5Wf4OWfU4xyv7XSJIASQ2xDpUV9BgeE&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af41-JGhayYNYFo4FqBElzJiUVZ87C8LYt_yYa4QFtTUbw&oe=6A131BAF"}, "display_name": "Mystery Box VR: Hidden Secrets", "keywords": [], "long_description": " AN IMMERSIVE VR PUZZLE EXPERIENCE\nInteract with objects, handles, buttons, and wheels on each side. Crack enigmas and collect hidden puzzle tiles on a random side of the boxes.\n\nYou won't be able to compare reality with fiction.\n\n# DISCOVER INVENTIONS\nOnce you unlock all 8 boxes of a Level Pack, you can compose a puzzle and discover a brief history of an invention.\n\nIt's not always easy to escape the room, so use all your IQ to crack the riddles. There's a logic behind all of them, even where it seems it's not!\n\n# IMMERSIVE SOUNDTRACK\nPlay the game with your headphones to get immersed in this amazing adventure.\n\n# HINTS\nGot stuck on some enigma? No worries, you can still get a helpful hint! You can also get in touch with me in case you really can't make it through a riddle, I'll be glad to help ;)\n\n# MULTILANGUAGE\nAvailable in English, French, Italian, German, Spanish, Russian, and Japanese.\n\nThe game language will change automatically based on the language settings of your device", "short_description": "A VR escape room game where you have to solve intriguing riddles to open boxes and discover nice stories about popular inventions!"}, {"images": {"nodes": [{"file_name": "$R36BSY5.png", "id": "3678762505771822", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/39031430_3678762509105155_2151975047074617165_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h4l9p0LZF4UQ7kNvwEnhpOY&_nc_oc=AdoxSM8dXDTtiUvnA27jNz4njYDQ-S8I5ue8tBmQyL8kQh4B96zK8-ncsTQPIVbe8zY&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4x5jRx9ULKlS68mNNXi9hioM9o7gKS3pQppXXRY34oxA&oe=6A1317A5"}, {"file_name": "$R81V725.png", "id": "2720695481426567", "image_type": "APP_IMG_ICON", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/75262743_2720695484759900_604086922326600035_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LUI23E8JQUYQ7kNvwEWkaQr&_nc_oc=AdqFQ9e1NxZ3Hu3lm2ro7vxFriGJREFShQlNKShH_EH3DifBfudyVlWcSRSy0TirgW8&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6rMsbtFlmSjA7wDYxgN-muVlWh2MJRC4DTM-MdwAonhg&oe=6A13168D"}, {"file_name": "$RQ3SN6U.png", "id": "1552311425628973", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38982519_1552311428962306_1218130395049083834_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A6A1j3G1e6kQ7kNvwEI72yi&_nc_oc=AdrEW4NbU8VLNv6YrIvISJwZU5hH_MV514ncaTw6WitWdZltX3z4McqbZdhjatQ-NUY&_nc_zt=3&_nc_ht=
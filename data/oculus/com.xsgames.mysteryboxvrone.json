7_6079827820297623902_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hqEuGjWc_YkQ7kNvwFKz7kf&_nc_oc=AdkFjOCxovEFtco-Hyg2F5qnrZgK_IOfdtnILqdpIisjKc4UONAlnpBDwgBZcG4KnWs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afv9uH8xwAVNPG3v4YYGatLQDNYBzj3Njz21fbszaKt-3A&oe=6999A272"}, {"file_name": "ml.png", "id": "758804276241553", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/86627649_758804279574886_1746818431198727649_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_E6eDTJvqYIQ7kNvwEZoDVD&_nc_oc=AdnPsLVdj4skGmeCCnfxC8DhxMYxhS4OwyEAGaevaxdNxA3r33GLeirhnIwmCLKGClo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfuqeZpz-G9BcBJ-ZNCHu6GJa5Ois6FE-hX0otnMl0z6bQ&oe=6999B3C7"}, {"file_name": "$RWJKXUS.png", "id": "406345889120457", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974920_406345892453790_2806525102226368153_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=t_T8u4gY4b8Q7kNvwG8oQuj&_nc_oc=AdncdYYm91gMAg5AkIUp_ePgs1ZUVt7bOOvR8Bn6bgd_EFTmqMOT8SZiHdtmUozJXYA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AftxgD5oYekPH-dpxwP2MY947REFPyS59X94yaPUDG8-Hg&oe=6999C038"}]}, "id": "476818348415672", "locale": "it_IT", "screenshots": [{"file_name": "4.png", "id": "499755402636525", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39035304_499755405969858_5224076533156194641_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sSRQMU-lKhoQ7kNvwHZbDDr&_nc_oc=Adnt3uZMb27OVlipPNMLorS_mCYZZ9PmnAicEXyPPFQ4B1cBMPKBNHvGhFsdsaAJKd4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfurZ9d_N9lpCHDRpxJOX_TD4_QHwotLMmSHMi_NHq3hdw&oe=6999C118"}, {"file_name": "1.png", "id": "996476465820891", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/57574726_996476469154224_2905129728707462238_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ei1pDF0lBkcQ7kNvwE3FlgF&_nc_oc=Adl8iz4KfWXib5H19J1pGpsQpCtJi-rCr2ffeiVng4nnMnMkDOON4sK5fzCJZwtIids&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfsJzqaUB3NJek3gMQmfgzTjDHUJ-l37ETjLInO5bMpuJQ&oe=6999BC48"}, {"file_name": "2.png", "id": "2203761473315962", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75469623_2203761476649295_9180026026436178997_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Zshsifm1T-UQ7kNvwFFePNo&_nc_oc=Adkjft7_H_xaTnHXQK2ow-UMCq1u4Zm2MDAVJNTNF4XPLFoKr19RBampv2rPOsDhSjc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Afsuq4SP5T_M2BsLpL8YJh-7senAI_b_eTwf3beILfSf6A&oe=6999B171"}, {"file_name": "5.png", "id": "1600206790893068", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974920_1600206794226401_7626143159008067194_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IWFvePZatkIQ7kNvwHqoNhU&_nc_oc=AdkZpA7byboFVzMtZB1-10mKjU-Hkd9Ue7PlodxkoHB37m0fq5GCkcyxIZtPBXyat_I&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afv1xMf47qbcR-qXA6WtYqyqIBROzJIA15_oq3IiWTYY5w&oe=6999BE0A"}, {"file_name": "3.png", "id": "1053463469622332", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75395599_1053463472955665_4671093965273907425_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4WBDhi6Wzp8Q7kNvwEraZC7&_nc_oc=Admghg0KI3rHMQfV4WyLI4sDYuMQJR2E5FG8H_bW_9m2FBCmrRBFYmftOhdvYrSb7sg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfvNW_ylOxfigJAc6rAo7-7IPWsQg30oii7qu0IiDt9MVA&oe=6999B16E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape.png", "id": "827399829365065", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75262743_827399832698398_2324097237178561690_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G7d-wS_XbT8Q7kNvwEnxY2B&_nc_oc=AdlS9PT5lwXsYlidWKXFEaVhYPprupD4MUHCWbwTUn_ImVtLaP113xVD_Z2Qeq8XDWo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfsFI5UDvVH2z0t8NDMeX8KjNXBpw-x-7HQWfZo1TogUJQ&oe=6999C08F"}, "display_name": "Mystery Box VR: Hidden Secrets", "keywords": [], "long_description": "# UN'ESPERIENZA DI GIOCO UNICA\nInteragisci con oggetti, maniglie, pulsanti e ruote su ciascun lato. Risolvi gli enigmi e raccogli le tessere del puzzle nascoste su un lato casuale delle scatole.\n\n# SEMBRA COS\u00cc REALE!\nNon sarai in grado di confrontare la realt\u00e0 con la finzione.\n\n\n# SCOPRI LE INVENZIONI\nUna volta sbloccate tutte le 8 caselle di un pacchetto livelli, puoi comporre un puzzle e scoprire una breve storia di un'invenzione.\n\n\n# PENSA FUORI DAGLI SCHEMI\nNon \u00e8 sempre facile fuggire dalla stanza, quindi usa tutto il tuo QI per risolvere gli enigmi. C'\u00e8 una logica dietro a tutti, anche dove sembra che non lo sia!\n\n# AUDIO D'ATMOSFERA\nGioca con le cuffie per immergerti in questa fantastica avventura.\n\n# ]SUGGERIMENTI DISPONIBILI\nSei rimasto bloccato su qualche enigma? Nessun problema, puoi comunque ricevere un suggerimento utile! Puoi anche contattarmi nel caso in cui davvero non riesci a risolvere un indovinello, sar\u00f2 felice di aiutarti ;)\n\n\n# SUPPORTO MULTILINGUA\nDisponibile in inglese, francese, italiano, tedesco, spagnolo, russo e giapponese.\n\nLa lingua del gioco cambier\u00e0 automaticamente in base alle impostazioni della lingua del tuo dispositivo", "short_description": "Un gioco VR di escape room in cui devi risolvere enigmi intriganti per aprire scatole e scoprire simpatiche storie su invenzioni popolari!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://xsgames.co/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "XSGames", "support_website_url": null, "website_url": "https://xsgames.co/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor"
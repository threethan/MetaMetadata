63ltBw3_IaxDisXRCBIxsD7LDkDnSp8CJZctKG9IsaQQ&oe=69FF4F44"}, {"file_name": "5.png", "id": "467916352871409", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39003282_467916356204742_1871921057092171900_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mQoc8ZCk6PEQ7kNvwHVHoS3&_nc_oc=AdrRjixBy1NdOY_0wo9k294uGf8xUrvkUO9nHQ5Tr_jlrVtbRQPIZBnCyOViARbo040&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af449gkic0yks6r7ZuMm8V34TzOIt0Xmn6qY7o__UV7AIw&oe=69FF33E2"}, {"file_name": "3.png", "id": "1934382610375855", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974473_1934382613709188_7156337812617042679_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FY5fOzh_KHkQ7kNvwElvDGD&_nc_oc=AdrWpQYn1Avkk8uKgByfXVK0BFihGmbmi8S-rRoeyo1UwUjoY8ORhMZ4D2rRU135FiI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af48858MbeGcfjc1juMpcP669c-AAL5iflZYqFZpsdRhLQ&oe=69FF1DF3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape.png", "id": "1524760081483769", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974531_1524760084817102_6497712644828891067_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x88o4Trox9AQ7kNvwGXtwM5&_nc_oc=Adr1g4bAHhLIT44gp6CY-i33LfGR4yqRiD40zTLElwG9poKvlN5b9EQM7LuLz_BKU_o&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4jZZ5mUs024EiTqGC_hYyxENQwXm64kK_fYC9FHT85hA&oe=69FF1CEF"}, "display_name": "Mystery Box VR: Hidden Secrets", "keywords": [], "long_description": " AN IMMERSIVE VR PUZZLE EXPERIENCE\nInteract with objects, handles, buttons, and wheels on each side. Crack enigmas and collect hidden puzzle tiles on a random side of the boxes.\n\nYou won't be able to compare reality with fiction.\n\n# DISCOVER INVENTIONS\nOnce you unlock all 8 boxes of a Level Pack, you can compose a puzzle and discover a brief history of an invention.\n\nIt's not always easy to escape the room, so use all your IQ to crack the riddles. There's a logic behind all of them, even where it seems it's not!\n\n# IMMERSIVE SOUNDTRACK\nPlay the game with your headphones to get immersed in this amazing adventure.\n\n# HINTS\nGot stuck on some enigma? No worries, you can still get a helpful hint! You can also get in touch with me in case you really can't make it through a riddle, I'll be glad to help ;)\n\n# MULTILANGUAGE\nAvailable in English, French, Italian, German, Spanish, Russian, and Japanese.\n\nThe game language will change automatically based on the language settings of your device", "short_description": "A VR escape room game where you have to solve intriguing riddles to open boxes and discover nice stories about popular inventions!"}, {"images": {"nodes": [{"file_name": "$R36BSY5.png", "id": "3678762505771822", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031430_3678762509105155_2151975047074617165_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8qSUF7PSfaIQ7kNvwHtXQ6t&_nc_oc=AdqAkwrK_DrFYGwSxSokKHeoZCbQBvQcydTXUM-wqh4bIaygCJw70HsAA89P64kbij0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af42Hv9jGOZUpqTO1Fp6i1PM964JzNTO3pgBtqTpB70ITQ&oe=69FF5125"}, {"file_name": "$R81V725.png", "id": "2720695481426567", "image_type": "APP_IMG_ICON", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75262743_2720695484759900_604086922326600035_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UOLPL5g8Ga8Q7kNvwGgBdLH&_nc_oc=Ado6oVWZ5So7Z9QhYWwtzB4kH03Gb4X51TBiiuN2pV4-J-v-htvCxR4Pi2MKADpkEbs&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4ofUMpi295whIQB817aLddCvh1NFpqMCApjRRKU3N5IA&oe=69FF500D"}, {"file_name": "$RQ3SN6U.png", "id": "1552311425628973", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982519_1552311428962306_1218130395049083834_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ecafbifwA1wQ7kNvwHSbBkc&_nc_oc=Adozo3-9FLw6k6R070E_aB35Ao_rAiMkptmzl30n_2Hadux9lr1bnFievAmXZYqgruk&_nc_zt=3&_nc_ht=
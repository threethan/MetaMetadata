MSWCc0SpL_PnVS4hOXTXVIQ6haI32OY-K_oFeZ7ZpnmQ&oe=6AC26D44"}, {"file_name": "5.png", "id": "467916352871409", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39003282_467916356204742_1871921057092171900_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c9ONxuIER0IQ7kNvwEHvodd&_nc_oc=Ado9mtBA7Wj4IGtmKIx3FC0FK4pKZU18xfRGNfNGgulev7UkRcS3vrGZm6bAwM1XvxQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNgmWR_m6XxnFDQFrPfvkfYPpGn-kR3myOOBAzym-lK6w&oe=6AC251E2"}, {"file_name": "3.png", "id": "1934382610375855", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974473_1934382613709188_7156337812617042679_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_iSw7HZJllgQ7kNvwELjZS5&_nc_oc=Adp3scCP-GR0D5ryswAqGQCQhhdIufRd6qSJfoeO3OhbxkMYiQkg02gMUBIugC_dkjs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOBHULejfrLYN_OjbpoOf2CjB4huItrnN-JkswhqC0IDQ&oe=6AC27433"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape.png", "id": "1524760081483769", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974531_1524760084817102_6497712644828891067_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xcRMDoes9IkQ7kNvwE8RaOL&_nc_oc=Ado1uJ5ZJ25pkb1of08av8t-Gp7n5HYAIFrmBkOnN0PeHkuKY2AU5n3nKAHD3WWwAKY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPs92OEsbhEOmew08_G5k8xUjiQF_S4CPlH3J1iETVtBA&oe=6AC2732F"}, "display_name": "Mystery Box VR: Hidden Secrets", "keywords": [], "long_description": " AN IMMERSIVE VR PUZZLE EXPERIENCE\nInteract with objects, handles, buttons, and wheels on each side. Crack enigmas and collect hidden puzzle tiles on a random side of the boxes.\n\nYou won't be able to compare reality with fiction.\n\n# DISCOVER INVENTIONS\nOnce you unlock all 8 boxes of a Level Pack, you can compose a puzzle and discover a brief history of an invention.\n\nIt's not always easy to escape the room, so use all your IQ to crack the riddles. There's a logic behind all of them, even where it seems it's not!\n\n# IMMERSIVE SOUNDTRACK\nPlay the game with your headphones to get immersed in this amazing adventure.\n\n# HINTS\nGot stuck on some enigma? No worries, you can still get a helpful hint! You can also get in touch with me in case you really can't make it through a riddle, I'll be glad to help ;)\n\n# MULTILANGUAGE\nAvailable in English, French, Italian, German, Spanish, Russian, and Japanese.\n\nThe game language will change automatically based on the language settings of your device", "short_description": "A VR escape room game where you have to solve intriguing riddles to open boxes and discover nice stories about popular inventions!"}, {"images": {"nodes": [{"file_name": "$R36BSY5.png", "id": "3678762505771822", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031430_3678762509105155_2151975047074617165_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VN1PVFLY0nsQ7kNvwGgAwU0&_nc_oc=Adqw7vXqwGFBSYMUVyKW9WsgRjJorJdST8ZqZI_4ezyzHRBfGNwI13ifoubFT-DKjzI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOKmfjYUTcMUBJvsrXTpVugkTLeiYCnPRAqedbYUZbztQ&oe=6AC26F25"}, {"file_name": "$R81V725.png", "id": "2720695481426567", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75262743_2720695484759900_604086922326600035_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CkWDAycxBMMQ7kNvwFuoFjm&_nc_oc=AdpqyIWTYRovW8uNWPcSanmNvxj4AkvRHXFlzqNwRfAnSYf4LVkdhGswC7ojTPRHn1w&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPHuMT8j4GFxvTbzrs_cZke-svUYgk7JC_7Jq_b-ixXdg&oe=6AC26E0D"}, {"file_name": "$RQ3SN6U.png", "id": "1552311425628973", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982519_1552311428962306_1218130395049083834_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z-dCaHFidjIQ7kNvwHQWE7o&_nc_oc=AdozQV6guuI9A5QO39Q00u7iJJXQszOt9aDMXqskDmF5ikL72Kdbo70F4aiRCdSoOUA&_nc_zt=3&_nc_ht=
Dn4pdqdlJNa_eVaTXgdIxLfW14Pa6V1hcfK0wVrGYe3Q&oe=6A4D17C4"}, {"file_name": "5.png", "id": "467916352871409", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39003282_467916356204742_1871921057092171900_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YlhM-7SQHI4Q7kNvwHkncRx&_nc_oc=Adquky_x-KC5kDcmNAyEOFCuRp-oOZiWm3wIOCKn5BPid0jNir0ldLgbUhTSj01xcI8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAOE0X7ImY8Xmen_59EF5yMo3qn3AYCcREtLOiAALSbJg&oe=6A4CFC62"}, {"file_name": "3.png", "id": "1934382610375855", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974473_1934382613709188_7156337812617042679_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2aJtXEJCZ-AQ7kNvwFLjKUy&_nc_oc=Adp-467ev3d0HnwYIuhm_yvT6gkfD5NS1PzAmVC9olyjUeAwpjXBVDZqhkYmqaQZ_xI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQByYnkdSo6S1v66nOeeEu2aWLWKas90GVtiTcGACbLJFQ&oe=6A4CE673"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape.png", "id": "1524760081483769", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974531_1524760084817102_6497712644828891067_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=122i4hkOLOoQ7kNvwHxR3V5&_nc_oc=Adps4M_xuWc-k3nhZWEc0EUKAzsruhZhcEHB8COdAtqGk5iQSuGITmY5MstUY07REBE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB_Q5Y0NbY6B0R-4m3ltBDhZlJ21VfCua2s2YHCryk-YQ&oe=6A4D1DAF"}, "display_name": "Mystery Box VR: Hidden Secrets", "keywords": [], "long_description": " AN IMMERSIVE VR PUZZLE EXPERIENCE\nInteract with objects, handles, buttons, and wheels on each side. Crack enigmas and collect hidden puzzle tiles on a random side of the boxes.\n\nYou won't be able to compare reality with fiction.\n\n# DISCOVER INVENTIONS\nOnce you unlock all 8 boxes of a Level Pack, you can compose a puzzle and discover a brief history of an invention.\n\nIt's not always easy to escape the room, so use all your IQ to crack the riddles. There's a logic behind all of them, even where it seems it's not!\n\n# IMMERSIVE SOUNDTRACK\nPlay the game with your headphones to get immersed in this amazing adventure.\n\n# HINTS\nGot stuck on some enigma? No worries, you can still get a helpful hint! You can also get in touch with me in case you really can't make it through a riddle, I'll be glad to help ;)\n\n# MULTILANGUAGE\nAvailable in English, French, Italian, German, Spanish, Russian, and Japanese.\n\nThe game language will change automatically based on the language settings of your device", "short_description": "A VR escape room game where you have to solve intriguing riddles to open boxes and discover nice stories about popular inventions!"}, {"images": {"nodes": [{"file_name": "$R36BSY5.png", "id": "3678762505771822", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031430_3678762509105155_2151975047074617165_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4Iv24_yp4KQQ7kNvwG6e7lc&_nc_oc=AdpS1LMeeHblgDIYtNnlFJq5gPMS0cPelj4zxT03KiXFceIdf98vWmr5F861zCLH6O4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAXl7yuPpALC_dw2jkvAMZYboHyUbWQH3kcn4AQf_gb6g&oe=6A4D19A5"}, {"file_name": "$R81V725.png", "id": "2720695481426567", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75262743_2720695484759900_604086922326600035_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LYLqFUqlb34Q7kNvwGWxaok&_nc_oc=Adr_dRPoC9ta36zHnHXENIcnb_IJeddMRdeHiGYaYEd2tWuf-eUADONv3GMJ9TbCDC4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQATiGDPNDOOjOJo4MVXjrUqGXrmo0oTR2k4HOhVWwAOow&oe=6A4D188D"}, {"file_name": "$RQ3SN6U.png", "id": "1552311425628973", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982519_1552311428962306_1218130395049083834_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8jRv1LmKW48Q7kNvwGh_4oQ&_nc_oc=AdqcQhJi2n-z9sojChONToN6_h3OUgrn8UqcJRIMsvUTk-TdsBvK--ieaz9MYNC8USA&_nc_zt=3&_nc_ht=
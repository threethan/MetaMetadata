JHvE_59WJKOvr9-yyhT5IIZaCM-PNWiRZEaUcwJ9nIlA&oe=6AA2C944"}, {"file_name": "5.png", "id": "467916352871409", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39003282_467916356204742_1871921057092171900_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NtQacdhNjXAQ7kNvwH9GL-0&_nc_oc=AdqwRTatX0NJktose-8X61qmNLSJmdDS0c9Rtysf6_fpWVgrwGMfdlWJA_teC3cLiRY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLUwNl9L65-n-eY0xV0HPQfvqnG8Iv4HyaO6oFS4SSf3Q&oe=6AA2ADE2"}, {"file_name": "3.png", "id": "1934382610375855", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974473_1934382613709188_7156337812617042679_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H8DJ7V_k284Q7kNvwEMBbEM&_nc_oc=AdoAIqxI7eHVD6v2cjEpuToDXEibv51tmokBnYa8XHzamTa9TjPqzzqS-ucF2DkLGIg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKhlXMZ5BIX9rsXvuc_7wBoS0Rrl8gXWxYCErDwQ63Aqw&oe=6AA2D033"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape.png", "id": "1524760081483769", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974531_1524760084817102_6497712644828891067_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DiMbG4V7FhMQ7kNvwFBe_uU&_nc_oc=AdrcDOqbSwxi-eZzNuwGsqlsza5pojPTDukWicvG6Ie_sHu4c6kUypbNoys99BWBHII&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKzDk1aJdApzRBM2am962llaAyVzsU4UFYDAu2vsDyizA&oe=6AA2CF2F"}, "display_name": "Mystery Box VR: Hidden Secrets", "keywords": [], "long_description": " AN IMMERSIVE VR PUZZLE EXPERIENCE\nInteract with objects, handles, buttons, and wheels on each side. Crack enigmas and collect hidden puzzle tiles on a random side of the boxes.\n\nYou won't be able to compare reality with fiction.\n\n# DISCOVER INVENTIONS\nOnce you unlock all 8 boxes of a Level Pack, you can compose a puzzle and discover a brief history of an invention.\n\nIt's not always easy to escape the room, so use all your IQ to crack the riddles. There's a logic behind all of them, even where it seems it's not!\n\n# IMMERSIVE SOUNDTRACK\nPlay the game with your headphones to get immersed in this amazing adventure.\n\n# HINTS\nGot stuck on some enigma? No worries, you can still get a helpful hint! You can also get in touch with me in case you really can't make it through a riddle, I'll be glad to help ;)\n\n# MULTILANGUAGE\nAvailable in English, French, Italian, German, Spanish, Russian, and Japanese.\n\nThe game language will change automatically based on the language settings of your device", "short_description": "A VR escape room game where you have to solve intriguing riddles to open boxes and discover nice stories about popular inventions!"}, {"images": {"nodes": [{"file_name": "$R36BSY5.png", "id": "3678762505771822", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031430_3678762509105155_2151975047074617165_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=77k6yN2RitIQ7kNvwGoVCN7&_nc_oc=AdqYW2JbCYF-oYASuByFqwu3B424f3Gjx1eFT16GSYiOKKOhnBJtg46Z0m8sjQFTZgI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI9hMILALHqkqBV0oKxiBt4_q894bjp-2KbuBvsACbJDQ&oe=6AA2CB25"}, {"file_name": "$R81V725.png", "id": "2720695481426567", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75262743_2720695484759900_604086922326600035_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-FQP_65cPM0Q7kNvwF9qXIx&_nc_oc=AdoonvChCXAV-DznBr81CGh6pBk9hUu10sLThLDld03EYGZWdn0-VzmIN99TbQ4ja6I&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKPaE0A4yeBrmclMm0EVu0Y7rCRET_gOTER6ELwLWiCMg&oe=6AA2CA0D"}, {"file_name": "$RQ3SN6U.png", "id": "1552311425628973", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982519_1552311428962306_1218130395049083834_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f-ZAOiB4PacQ7kNvwEaqm9V&_nc_oc=AdqZZzya5mmooFafZ_bIl5TyZYQEhirbEqCQu9Lo5gA6UKQFLNY-7LSyln7VGV2R5P0&_nc_zt=3&_nc_ht=
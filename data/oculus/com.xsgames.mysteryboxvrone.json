Lu6i3tSd_LbyPE7T2aqMg-SgM8tiYT0JESH1ju6k3GpQ&oe=6ABD2744"}, {"file_name": "5.png", "id": "467916352871409", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39003282_467916356204742_1871921057092171900_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1UwAcoGgqqYQ7kNvwEVjtOJ&_nc_oc=Adoae51tFTrLM0jXgV2PuOngBMBojqEMm8KTxtZ9CDe_gSfnDQVaose6Wqn2KL3-Xkk&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIGWlMpLM2x6H6zI-BIC6_yjAF1yBpyyM3eMm76oxWtkA&oe=6ABD0BE2"}, {"file_name": "3.png", "id": "1934382610375855", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974473_1934382613709188_7156337812617042679_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vnuLThSyrVQQ7kNvwHSiq9v&_nc_oc=AdpQyT6aDcT0cmyN7tP31457m2F3xkSFn7oRdA7kXSEWxhUlk9IC7xrJzxj-eiN4un4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK9Wgr09Z85qAeu-g3jUgnxplLx7WLnqkXW3PW3m6k7Rg&oe=6ABD2E33"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape.png", "id": "1524760081483769", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974531_1524760084817102_6497712644828891067_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fRt1lxEZQoUQ7kNvwH9fkCy&_nc_oc=Adph4tqZxaej5a8rkqSpLlXsrYgXj2v3vbSumWXZa1CuuIRJFBoRvOfFuNMEONH0LGM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJFn9SaT9AqjZ-DE8nyeVkrslejViMGcrFTqdw5-wj6Ig&oe=6ABD2D2F"}, "display_name": "Mystery Box VR: Hidden Secrets", "keywords": [], "long_description": " AN IMMERSIVE VR PUZZLE EXPERIENCE\nInteract with objects, handles, buttons, and wheels on each side. Crack enigmas and collect hidden puzzle tiles on a random side of the boxes.\n\nYou won't be able to compare reality with fiction.\n\n# DISCOVER INVENTIONS\nOnce you unlock all 8 boxes of a Level Pack, you can compose a puzzle and discover a brief history of an invention.\n\nIt's not always easy to escape the room, so use all your IQ to crack the riddles. There's a logic behind all of them, even where it seems it's not!\n\n# IMMERSIVE SOUNDTRACK\nPlay the game with your headphones to get immersed in this amazing adventure.\n\n# HINTS\nGot stuck on some enigma? No worries, you can still get a helpful hint! You can also get in touch with me in case you really can't make it through a riddle, I'll be glad to help ;)\n\n# MULTILANGUAGE\nAvailable in English, French, Italian, German, Spanish, Russian, and Japanese.\n\nThe game language will change automatically based on the language settings of your device", "short_description": "A VR escape room game where you have to solve intriguing riddles to open boxes and discover nice stories about popular inventions!"}, {"images": {"nodes": [{"file_name": "$R36BSY5.png", "id": "3678762505771822", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031430_3678762509105155_2151975047074617165_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Kyiry5-JgvkQ7kNvwEOtxyF&_nc_oc=AdrMP1QZ6pnz43z-4eVfFp7G9Odr2tmJHY4uFPwvsJ3_yGe3_xSgBcSzT0600BHCw0U&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJYC7PG0AHRfmrmxIETTcSsju8K-_c_v8Lz_ow5aNSKnQ&oe=6ABD2925"}, {"file_name": "$R81V725.png", "id": "2720695481426567", "image_type": "APP_IMG_ICON", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75262743_2720695484759900_604086922326600035_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pRFYNnbN_9cQ7kNvwGXUjW3&_nc_oc=Adq8Npe8GapUkhzEXodaN0URRBY6Pedfx0Mywcm0gfiKvL9oR1gVHGh82DYkDARa8TA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKjQu5oCW0CYH3unDMz-e8Y1QuipFxfipG_a7PYHD9EMA&oe=6ABD280D"}, {"file_name": "$RQ3SN6U.png", "id": "1552311425628973", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982519_1552311428962306_1218130395049083834_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YDxrfButeyMQ7kNvwHrNDWC&_nc_oc=AdoVhoqAs9HSkVh7p7MH_eoXbdb4zTdzHQudJ16CTe0KPVvT9BJElewCKD85Sx5M-iQ&_nc_zt=3&_nc_ht=
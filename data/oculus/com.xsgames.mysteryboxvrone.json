JOaqF3mrmwhfy7jgNkJhVRQ3t5SRbevvGuDAY8jtVIWw&oe=6AAD5544"}, {"file_name": "5.png", "id": "467916352871409", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39003282_467916356204742_1871921057092171900_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bLZgz68agl0Q7kNvwH7VPsm&_nc_oc=Ado0M8DH2klnR7s5lBSDaTZvLVdwNqdj92_pHjNEuc5PSOUGzz_iDK_bYFJh8wcNxv0&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLIAAubxW1tqJqhkTJOeUdznZBzCF4FpnEk8GeO0F3p8Q&oe=6AAD39E2"}, {"file_name": "3.png", "id": "1934382610375855", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974473_1934382613709188_7156337812617042679_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1MIgXfjqlbwQ7kNvwGuljiv&_nc_oc=AdoLrKL39Dwe3cTVI1kK6rdlBs_dAkc61hgw68qTWl_W8VB73xWJCdWlhObYstWiiqY&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJa8oluObKqPg1vzo-85-Di-GOGNSfwS5t_QvE-FG3k9A&oe=6AAD5C33"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape.png", "id": "1524760081483769", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974531_1524760084817102_6497712644828891067_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DB3TPWyecXoQ7kNvwFlxcLo&_nc_oc=AdqPCT2lGgujjrz5EwAKCGoD-nUqgWLVp68JZalrhJ9AkQeXshaie6aQtcI0ffJHy3U&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK1uTfVpTwftL5sCvyIOrIsLOK1mXD9XSLdBtJQgpCNkg&oe=6AAD5B2F"}, "display_name": "Mystery Box VR: Hidden Secrets", "keywords": [], "long_description": " AN IMMERSIVE VR PUZZLE EXPERIENCE\nInteract with objects, handles, buttons, and wheels on each side. Crack enigmas and collect hidden puzzle tiles on a random side of the boxes.\n\nYou won't be able to compare reality with fiction.\n\n# DISCOVER INVENTIONS\nOnce you unlock all 8 boxes of a Level Pack, you can compose a puzzle and discover a brief history of an invention.\n\nIt's not always easy to escape the room, so use all your IQ to crack the riddles. There's a logic behind all of them, even where it seems it's not!\n\n# IMMERSIVE SOUNDTRACK\nPlay the game with your headphones to get immersed in this amazing adventure.\n\n# HINTS\nGot stuck on some enigma? No worries, you can still get a helpful hint! You can also get in touch with me in case you really can't make it through a riddle, I'll be glad to help ;)\n\n# MULTILANGUAGE\nAvailable in English, French, Italian, German, Spanish, Russian, and Japanese.\n\nThe game language will change automatically based on the language settings of your device", "short_description": "A VR escape room game where you have to solve intriguing riddles to open boxes and discover nice stories about popular inventions!"}, {"images": {"nodes": [{"file_name": "$R36BSY5.png", "id": "3678762505771822", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39031430_3678762509105155_2151975047074617165_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OrJrJX8A_n8Q7kNvwFjwM43&_nc_oc=AdqEPDuoq1bMGawrnn5LqkSqPK2VNYBO3gQSLVfyy7iQFGVk3nUWS8cs3mlcLBeNw_I&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJSYo1XsIELRWV2hp5We2mCuqZcpdDxcr1G4MQh9EPQWA&oe=6AAD5725"}, {"file_name": "$R81V725.png", "id": "2720695481426567", "image_type": "APP_IMG_ICON", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/75262743_2720695484759900_604086922326600035_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SFtGowUZtxIQ7kNvwFGJ_Oe&_nc_oc=AdoEEDX18dRTQIJ6a29guxRFHQFFl7rv73k5Hn9AMQA7LPeOdUK8dd5FlpLbryb5y1M&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKpinGiCrc0vF7uAQ8PY7NXt4fuVe1jtWXEIYqAyJnyDQ&oe=6AAD560D"}, {"file_name": "$RQ3SN6U.png", "id": "1552311425628973", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38982519_1552311428962306_1218130395049083834_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OmJh96gD-6wQ7kNvwH2AoPO&_nc_oc=AdrjLEzLOQsdme6CEAysCpXe_-9oK7SWc8NbCAjW6JxIl2HkbOUi14BmaygUXh9xPmI&_nc_zt=3&_nc_ht=
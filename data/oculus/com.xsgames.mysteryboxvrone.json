2k2FBVb0agVvD9euWDhA8s1R8Tg1niIEPQSdADNUuhmQ&oe=69E4B904"}, {"file_name": "5.png", "id": "467916352871409", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39003282_467916356204742_1871921057092171900_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v7TR56NKjikQ7kNvwGTRvue&_nc_oc=AdpimhrpuOkUl1KtB8uY3QYHAqqvfkQFwifb68u5j2doDRtbv9H-3Y9vXujn9KSr-xw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3Fcm-GlyiBdJ_20pMDULbxfGI9VDO-AmgCQmnsmInrQQ&oe=69E4D5E2"}, {"file_name": "3.png", "id": "1934382610375855", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974473_1934382613709188_7156337812617042679_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Pc6yK5bdpBEQ7kNvwFbMENO&_nc_oc=AdqlESRBUwMTXTJ91mHkiUM1eENbWZjm4BaB171UIQc84Kc8XRI0NNO_fyWHOeydMVI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0Wq1xyo-jqs6_T1cMf10_fhN_2Q0Ilrgbht41jCTLY9w&oe=69E4BFF3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape.png", "id": "1524760081483769", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974531_1524760084817102_6497712644828891067_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4vCQCHiAyCQQ7kNvwGo81kn&_nc_oc=AdoAnJ3CE4ilwAlRiA4vkKcs-v4BmCbGPaZa37EvPU2nZIwvfGDX_KlcZCspYjF--k4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2J4fmF4yOtMBPzns6k2yO8FR4TEFrTtRHaGMF9SRZ2mQ&oe=69E4BEEF"}, "display_name": "Mystery Box VR: Hidden Secrets", "keywords": [], "long_description": " AN IMMERSIVE VR PUZZLE EXPERIENCE\nInteract with objects, handles, buttons, and wheels on each side. Crack enigmas and collect hidden puzzle tiles on a random side of the boxes.\n\nYou won't be able to compare reality with fiction.\n\n# DISCOVER INVENTIONS\nOnce you unlock all 8 boxes of a Level Pack, you can compose a puzzle and discover a brief history of an invention.\n\nIt's not always easy to escape the room, so use all your IQ to crack the riddles. There's a logic behind all of them, even where it seems it's not!\n\n# IMMERSIVE SOUNDTRACK\nPlay the game with your headphones to get immersed in this amazing adventure.\n\n# HINTS\nGot stuck on some enigma? No worries, you can still get a helpful hint! You can also get in touch with me in case you really can't make it through a riddle, I'll be glad to help ;)\n\n# MULTILANGUAGE\nAvailable in English, French, Italian, German, Spanish, Russian, and Japanese.\n\nThe game language will change automatically based on the language settings of your device", "short_description": "A VR escape room game where you have to solve intriguing riddles to open boxes and discover nice stories about popular inventions!"}, {"images": {"nodes": [{"file_name": "$R36BSY5.png", "id": "3678762505771822", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031430_3678762509105155_2151975047074617165_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A3RfYpNNg94Q7kNvwHpdwuW&_nc_oc=Adq6Q00hbIYGuTIVpV55iXIPBKGHtUCXc_M2AlExs0K7qDuUUzKa_DKIzwuqhnJF78I&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3il5jBwbYjjv9ilIX9z9fWvEPzlge6wb0JoKolQF_aUw&oe=69E4BAE5"}, {"file_name": "$R81V725.png", "id": "2720695481426567", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75262743_2720695484759900_604086922326600035_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y_AHIxX8bHgQ7kNvwGYH6pW&_nc_oc=AdqlQ4C2ZU3j2olugi82oKMNQkxmExEU6qQxQwtDNWCc4p4se1n-ujb689u7CHPh2yg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3JIJnPeUlegErfecfw6Z6YoXoeSes-Su69OB3_EI6Ndw&oe=69E4B9CD"}, {"file_name": "$RQ3SN6U.png", "id": "1552311425628973", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982519_1552311428962306_1218130395049083834_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wjGHhjMEfi4Q7kNvwFj0TJn&_nc_oc=AdrI25M2P-MSuk2-4W3d5zFOb03pkRjXX6WBg2YRwwj6Sf8EtIqy8btcAFnielwcPVg&_nc_zt=3&_nc_ht=
y7_DceGNLAnQ9g0ImwxbKofVQD4LLg_UDVRyxdUYkBqA&oe=69CA5B04"}, {"file_name": "5.png", "id": "467916352871409", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39003282_467916356204742_1871921057092171900_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2NL8YS9kwaQQ7kNvwFdWQOr&_nc_oc=Adr2MZa7NPORo0FfFclOo324qQnhLOwATEDilMJeG14A5pyxxyqUurPP2yyEqbcF0Rw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afxq8WYeyElgT3lZTubgGJ0UwXVjAgH4P8yTOFfFBWKWZw&oe=69CA77E2"}, {"file_name": "3.png", "id": "1934382610375855", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974473_1934382613709188_7156337812617042679_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SkNDWoJshjsQ7kNvwHltypa&_nc_oc=AdpyXMCEsalr4u7iG2jZJNTe9t-tRF3ThXCiUzXdZu0Kzye8sXa-5dSOjEVfQIs-Fuk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzE4HyiRN5O9AFb2V6FDtWjb1RjBE7MAzzxNrAJTZuBIQ&oe=69CA61F3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape.png", "id": "1524760081483769", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974531_1524760084817102_6497712644828891067_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kUIExVRwu0QQ7kNvwGGV6lt&_nc_oc=Ado93Bpr3ySkv-HCvsa8xpDTKuLMSs6GSfXXqgMgMF1jwXYkghfNnAJ1vfVAXWvNEVg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyvuWgzI_SNKHq1BSbgY9wd5alOjxy8ptfhpiLh3BgOyw&oe=69CA60EF"}, "display_name": "Mystery Box VR: Hidden Secrets", "keywords": [], "long_description": " AN IMMERSIVE VR PUZZLE EXPERIENCE\nInteract with objects, handles, buttons, and wheels on each side. Crack enigmas and collect hidden puzzle tiles on a random side of the boxes.\n\nYou won't be able to compare reality with fiction.\n\n# DISCOVER INVENTIONS\nOnce you unlock all 8 boxes of a Level Pack, you can compose a puzzle and discover a brief history of an invention.\n\nIt's not always easy to escape the room, so use all your IQ to crack the riddles. There's a logic behind all of them, even where it seems it's not!\n\n# IMMERSIVE SOUNDTRACK\nPlay the game with your headphones to get immersed in this amazing adventure.\n\n# HINTS\nGot stuck on some enigma? No worries, you can still get a helpful hint! You can also get in touch with me in case you really can't make it through a riddle, I'll be glad to help ;)\n\n# MULTILANGUAGE\nAvailable in English, French, Italian, German, Spanish, Russian, and Japanese.\n\nThe game language will change automatically based on the language settings of your device", "short_description": "A VR escape room game where you have to solve intriguing riddles to open boxes and discover nice stories about popular inventions!"}, {"images": {"nodes": [{"file_name": "$R36BSY5.png", "id": "3678762505771822", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031430_3678762509105155_2151975047074617165_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jnIfI89YnJAQ7kNvwEBlDUx&_nc_oc=AdpVed6u2VxWWOFTJCMS_UkCIDW_uUBFDqNzz29QJ3vskZ5Fu_3UfZQs-IoBSmlKJGk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afzz27ToBh3MG8xrIctnq6S8LJbKDcuQQq0c8dx2llytYA&oe=69CA5CE5"}, {"file_name": "$R81V725.png", "id": "2720695481426567", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75262743_2720695484759900_604086922326600035_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b9g5szjVON0Q7kNvwEutb97&_nc_oc=AdoYm8jNuqN_pZFEece-DDLTQnRW0C6N2oVWF4uB64qNAN3Eg_jsoBj0E9pt7xIGQqA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwKKsHRGsMUxj1u2VoEWtxBOufrRdLRzntNkH_tHP2PyA&oe=69CA5BCD"}, {"file_name": "$RQ3SN6U.png", "id": "1552311425628973", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982519_1552311428962306_1218130395049083834_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s37lZdS-BloQ7kNvwH-hzp1&_nc_oc=Adqt_VwwJbXy8l5ioGF97ruHvt_7lsG-C35_HX2Mx78RNTsxKuNNI__wDgViCT1EIDM&_nc_zt=3&_nc_ht=
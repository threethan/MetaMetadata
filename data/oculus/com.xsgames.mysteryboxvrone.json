SyN5bTtLziWzM6G3W4zDoORXEYBvGTyySGjSG6NSQUvw&oe=6AF091C4"}, {"file_name": "5.png", "id": "467916352871409", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39003282_467916356204742_1871921057092171900_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4qKfki0MVLUQ7kNvwEYUVnU&_nc_oc=AdqV_OpujMSyxtsU8tvNYPyNvvlNCnma_cy1Afl_jdtFx8ArS9V-rxOfRjdcHRSNTD4&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRIqgoHuG2gE71zZpyV7uSK9mseIZLxBJGWh6b85lvDMQ&oe=6AF0AEA2"}, {"file_name": "3.png", "id": "1934382610375855", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974473_1934382613709188_7156337812617042679_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pPP-NlkeVqIQ7kNvwFRFwrZ&_nc_oc=AdrPLNQ5sb-uIVmsYbbAgoBvafm-Jh-5nF6HLmwHkj0QTqLuQ_P8sLCV7eborwK2P9g&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSv2_h1MZj1LAcBdYA_26Chk-LY-2-mJ0qHgMYeotEcFQ&oe=6AF098B3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape.png", "id": "1524760081483769", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974531_1524760084817102_6497712644828891067_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e2CiPTxN7lsQ7kNvwHQg4-s&_nc_oc=Adp89Wctgjf3jT0TXG3rP_FzQY6oOIqjQMBLs6xWZlokOXCAGBlZlZg5Tl2WX0dkM7M&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQbuadBmBMyVVjnuMpcRSX2n6XO6yuGJjguxknZC5on3g&oe=6AF097AF"}, "display_name": "Mystery Box VR: Hidden Secrets", "keywords": [], "long_description": " AN IMMERSIVE VR PUZZLE EXPERIENCE\nInteract with objects, handles, buttons, and wheels on each side. Crack enigmas and collect hidden puzzle tiles on a random side of the boxes.\n\nYou won't be able to compare reality with fiction.\n\n# DISCOVER INVENTIONS\nOnce you unlock all 8 boxes of a Level Pack, you can compose a puzzle and discover a brief history of an invention.\n\nIt's not always easy to escape the room, so use all your IQ to crack the riddles. There's a logic behind all of them, even where it seems it's not!\n\n# IMMERSIVE SOUNDTRACK\nPlay the game with your headphones to get immersed in this amazing adventure.\n\n# HINTS\nGot stuck on some enigma? No worries, you can still get a helpful hint! You can also get in touch with me in case you really can't make it through a riddle, I'll be glad to help ;)\n\n# MULTILANGUAGE\nAvailable in English, French, Italian, German, Spanish, Russian, and Japanese.\n\nThe game language will change automatically based on the language settings of your device", "short_description": "A VR escape room game where you have to solve intriguing riddles to open boxes and discover nice stories about popular inventions!"}, {"images": {"nodes": [{"file_name": "$R36BSY5.png", "id": "3678762505771822", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39031430_3678762509105155_2151975047074617165_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9uPP7aXUz3AQ7kNvwHaEWDz&_nc_oc=AdrurWD3MVv4XDxdKKnCFxBaaY3DZHqgImRNeJxvdJqro4npj_qLHSyxqAaf3iDlDOw&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTxy2N_qo40L2P_jNzC0CYLONPH66U-NKDEVqCA8Jmxkg&oe=6AF093A5"}, {"file_name": "$R81V725.png", "id": "2720695481426567", "image_type": "APP_IMG_ICON", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75262743_2720695484759900_604086922326600035_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XGZJhtiZoFMQ7kNvwHjPjZc&_nc_oc=Adp5Ntj1ugD2AdrHxqk34_xiwKwpxj28-kuzOaQWoRsFm2HTEW_AmbGOgFEFOpoRsCo&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSZwKHfxT9X1ZKcB710Izen6dQDwaKLNo1avdc8gnA_Ww&oe=6AF0928D"}, {"file_name": "$RQ3SN6U.png", "id": "1552311425628973", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982519_1552311428962306_1218130395049083834_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Q-82AWqTsTMQ7kNvwEXSWM3&_nc_oc=AdpCsWk3r7wlTi3J7fLIyST8qr047jRjccH1mhFxJUeBFd3Tyqy1Qv32d9UqHkijcFQ&_nc_zt=3&_nc_ht=
wz-sLZKuZQ2tqscvO1mnN8UU1VgYXOSXyzCedfYOiEsw&oe=69C27204"}, {"file_name": "5.png", "id": "467916352871409", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39003282_467916356204742_1871921057092171900_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Uo1T39u1R38Q7kNvwGQTIit&_nc_oc=AdotJfY694CJ47MFN3lxHrcRUZ-IbRiTHdr9gabkwAo_YUeTwXjZDcE44ybqZF4HDfs&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzPGj327AOT60NqtNII9rT46AjNC9WRcA9VPi3Dzlc_Zw&oe=69C28EE2"}, {"file_name": "3.png", "id": "1934382610375855", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38974473_1934382613709188_7156337812617042679_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9JIu21zT6YgQ7kNvwEvZoO5&_nc_oc=Adqo-DFJSWxcQtCs5BJBZzRzoUBGsAyqQ0pM0C4gBWfCUOnsnnWlkimPe3bt5QZVJrI&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afwc2EcYAqsZc12cFs_CWAwX2dTKdjZpuCR69Flf3psFZw&oe=69C278F3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape.png", "id": "1524760081483769", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38974531_1524760084817102_6497712644828891067_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C05ssKrefBUQ7kNvwFxXJOz&_nc_oc=AdqS-RSKIHapRLnFCHy1in4U2YO40aaQGahpzkrTIQ5mWMZ9hMsCJ-J1SCUk-b_e5dM&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxbawNK3bvQN0PaSnCetkO23q0Y_owyb3QlyzhXjUVU4w&oe=69C277EF"}, "display_name": "Mystery Box VR: Hidden Secrets", "keywords": [], "long_description": " AN IMMERSIVE VR PUZZLE EXPERIENCE\nInteract with objects, handles, buttons, and wheels on each side. Crack enigmas and collect hidden puzzle tiles on a random side of the boxes.\n\nYou won't be able to compare reality with fiction.\n\n# DISCOVER INVENTIONS\nOnce you unlock all 8 boxes of a Level Pack, you can compose a puzzle and discover a brief history of an invention.\n\nIt's not always easy to escape the room, so use all your IQ to crack the riddles. There's a logic behind all of them, even where it seems it's not!\n\n# IMMERSIVE SOUNDTRACK\nPlay the game with your headphones to get immersed in this amazing adventure.\n\n# HINTS\nGot stuck on some enigma? No worries, you can still get a helpful hint! You can also get in touch with me in case you really can't make it through a riddle, I'll be glad to help ;)\n\n# MULTILANGUAGE\nAvailable in English, French, Italian, German, Spanish, Russian, and Japanese.\n\nThe game language will change automatically based on the language settings of your device", "short_description": "A VR escape room game where you have to solve intriguing riddles to open boxes and discover nice stories about popular inventions!"}, {"images": {"nodes": [{"file_name": "$R36BSY5.png", "id": "3678762505771822", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39031430_3678762509105155_2151975047074617165_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G3bpbjbwFo0Q7kNvwE-I9Bs&_nc_oc=AdooxE6edLRrI1tuP--WfiPN5wp9GMzEqSWSh_cs7KZHsa4sl-rPN8V7uwDAoAR4iHU&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzE53hs67n20Cbh1rlLquFlOEOtu8SzlCTzTJdFFseXhw&oe=69C273E5"}, {"file_name": "$R81V725.png", "id": "2720695481426567", "image_type": "APP_IMG_ICON", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/75262743_2720695484759900_604086922326600035_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YLnpoeq0PDoQ7kNvwE0J1Yv&_nc_oc=Adrjqh3qnwfhJOXJKKWhAeSqWze00fOfYAFt3ScWXHUK43A-7s5PPoerK5A1YoSpBCg&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwAeCXHL1ka10b3ltjJQqL4WhPnrAusFS6vMby6aPbDrQ&oe=69C272CD"}, {"file_name": "$RQ3SN6U.png", "id": "1552311425628973", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982519_1552311428962306_1218130395049083834_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ashleXd6g20Q7kNvwGxzOe3&_nc_oc=Adpxmuhpl3opSxATiv2Hcrj9MNREvYVzllT0jdDgSNxkuWXE899afBexiIRWtdpB1Bg&_nc_zt=3&_nc_ht=
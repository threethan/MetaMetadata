8-FBdKL5VvKvKCBu8_NWoWdu8SJq48LPHm8JaZjPSq6w&oe=6A413A44"}, {"file_name": "5.png", "id": "467916352871409", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39003282_467916356204742_1871921057092171900_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SDrgiPx58-cQ7kNvwE0zsqX&_nc_oc=AdpSnDGFC7zi1J2KZiffGVnHtKr9ZM6piq8bQ_LAy1_V0f9yDW8xXaKL1iS6FhWZyJY&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8mqmNldQhIG_WcCe8cSOcN7vWok45EP1_oFfaO2m4gsQ&oe=6A411EE2"}, {"file_name": "3.png", "id": "1934382610375855", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974473_1934382613709188_7156337812617042679_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xAXFgyuiGLoQ7kNvwGulWjz&_nc_oc=AdqyvyCe-SjkY5Y_7H4qPnSdUvcMEUYcstfkb5Dq7xW0gZcxgp6rhhBwwZbE6WyCECA&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8QSFTmCU6K7DMWzPd4qqGhoIxYqZnL6byIMPfDjVp4dA&oe=6A414133"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape.png", "id": "1524760081483769", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974531_1524760084817102_6497712644828891067_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XNEzD2zC-usQ7kNvwFCcLmx&_nc_oc=AdqoFJ1HHFHcs8lc10G9SaWxoHAFQd8szpAnsd2r0FYDgSPjV3gChXR3EX-I3gNk9rw&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8y6fktnxXLb83T2fOJXGmQnqMLdnEfCXj2LIkgNksNOg&oe=6A41402F"}, "display_name": "Mystery Box VR: Hidden Secrets", "keywords": [], "long_description": " AN IMMERSIVE VR PUZZLE EXPERIENCE\nInteract with objects, handles, buttons, and wheels on each side. Crack enigmas and collect hidden puzzle tiles on a random side of the boxes.\n\nYou won't be able to compare reality with fiction.\n\n# DISCOVER INVENTIONS\nOnce you unlock all 8 boxes of a Level Pack, you can compose a puzzle and discover a brief history of an invention.\n\nIt's not always easy to escape the room, so use all your IQ to crack the riddles. There's a logic behind all of them, even where it seems it's not!\n\n# IMMERSIVE SOUNDTRACK\nPlay the game with your headphones to get immersed in this amazing adventure.\n\n# HINTS\nGot stuck on some enigma? No worries, you can still get a helpful hint! You can also get in touch with me in case you really can't make it through a riddle, I'll be glad to help ;)\n\n# MULTILANGUAGE\nAvailable in English, French, Italian, German, Spanish, Russian, and Japanese.\n\nThe game language will change automatically based on the language settings of your device", "short_description": "A VR escape room game where you have to solve intriguing riddles to open boxes and discover nice stories about popular inventions!"}, {"images": {"nodes": [{"file_name": "$R36BSY5.png", "id": "3678762505771822", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39031430_3678762509105155_2151975047074617165_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T8QOtkEN4VAQ7kNvwF6nzlK&_nc_oc=AdreqzKL2IIg8JtPvxh5BIqHLIXRNHZa-7ubrHSQ8RgJGPndHIhGf5mzqYXDOb3HN6o&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_fquXvXkIvzUPM6rf5w6te1-Ehrrjz2ULSEE0vmXmSoA&oe=6A413C25"}, {"file_name": "$R81V725.png", "id": "2720695481426567", "image_type": "APP_IMG_ICON", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/75262743_2720695484759900_604086922326600035_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TYpfzZiyoPUQ7kNvwF2U02u&_nc_oc=AdpSocaHJuXbGgVgTBFvTOPZmNanP0Xzhif_qWVkWuJxjjadIcEVhP0PaEXw8pk2G-A&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8_7inAWYnaMghlL6b1_pBVXihqGnfrHXDSdP5-T8xwWg&oe=6A413B0D"}, {"file_name": "$RQ3SN6U.png", "id": "1552311425628973", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38982519_1552311428962306_1218130395049083834_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rehVSG4TarUQ7kNvwHJI12K&_nc_oc=Adru90-OSKgRU9IIIM506a3NpmABCmNl_rO9a1p0zNrKa9-a4w_cjR-87bnVtESsuO0&_nc_zt=3&_nc_ht=
BR5e37f2JKYXMw0YMHgog-ywVFAe0cUzcJIW5mthpZUA&oe=6A5500C4"}, {"file_name": "5.png", "id": "467916352871409", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39003282_467916356204742_1871921057092171900_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LFCNeKMBjV8Q7kNvwG1EnG0&_nc_oc=Adri-v85Ow74r2W0-QAZX6vXqnKlFeiYghd87K0JDEOISC1pJz4sY_PPiZdrVkV6dHc&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCTgr8jPLcqVq35g0ZJDeGwI-M-caAzWR4o_keqX9GV1g&oe=6A54E562"}, {"file_name": "3.png", "id": "1934382610375855", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38974473_1934382613709188_7156337812617042679_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hoYXp5ZJ-W4Q7kNvwHe6Z29&_nc_oc=AdppOHOpCHu_djnMQuzGc_Toyfk4zJUkFgCvRwKwCF5v6WWJgTUQ5fU6-6JwiOH-bP4&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCDUib_5rjoUtzV6T860t4N3BFAwE2no-ShvnYwT8J4BA&oe=6A5507B3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape.png", "id": "1524760081483769", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38974531_1524760084817102_6497712644828891067_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U4nHU9UqWhsQ7kNvwFNW9bR&_nc_oc=Adq5ggYqH2sbaecd6a5AXqMFdZuLO2_Q5HdL_TfjQ2Hf1s76o8YvUuJcm8ucXV1c-o4&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDQm3ieWZOZDITHgO0Z4JPrc_EMaS-wT997UiLMSv2-gA&oe=6A5506AF"}, "display_name": "Mystery Box VR: Hidden Secrets", "keywords": [], "long_description": " AN IMMERSIVE VR PUZZLE EXPERIENCE\nInteract with objects, handles, buttons, and wheels on each side. Crack enigmas and collect hidden puzzle tiles on a random side of the boxes.\n\nYou won't be able to compare reality with fiction.\n\n# DISCOVER INVENTIONS\nOnce you unlock all 8 boxes of a Level Pack, you can compose a puzzle and discover a brief history of an invention.\n\nIt's not always easy to escape the room, so use all your IQ to crack the riddles. There's a logic behind all of them, even where it seems it's not!\n\n# IMMERSIVE SOUNDTRACK\nPlay the game with your headphones to get immersed in this amazing adventure.\n\n# HINTS\nGot stuck on some enigma? No worries, you can still get a helpful hint! You can also get in touch with me in case you really can't make it through a riddle, I'll be glad to help ;)\n\n# MULTILANGUAGE\nAvailable in English, French, Italian, German, Spanish, Russian, and Japanese.\n\nThe game language will change automatically based on the language settings of your device", "short_description": "A VR escape room game where you have to solve intriguing riddles to open boxes and discover nice stories about popular inventions!"}, {"images": {"nodes": [{"file_name": "$R36BSY5.png", "id": "3678762505771822", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39031430_3678762509105155_2151975047074617165_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IIabnyfXwPwQ7kNvwEFDUQC&_nc_oc=AdrcD1v_KQfgydX3HUj-GfY9bWXYgYyXACS6RpzZhEo6kXU86pvaHwb8qtZjquAcReI&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBr8qx3zniV4f35IfhLli3dHZfS_c3BN-Gb1Bho2YtdBA&oe=6A5502A5"}, {"file_name": "$R81V725.png", "id": "2720695481426567", "image_type": "APP_IMG_ICON", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75262743_2720695484759900_604086922326600035_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dvrixJtRIhMQ7kNvwFxDzRI&_nc_oc=Adr3fEK7yN6opa5W5VZBuUi7km2_SPy4teDD0Qx43JLPg6rv5rZxfU2Be8Dj1qTzUPY&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBWBMZsDJl5Fw4gUnpo02DNlWc2uygY6s_qQlW62TZIxQ&oe=6A55018D"}, {"file_name": "$RQ3SN6U.png", "id": "1552311425628973", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982519_1552311428962306_1218130395049083834_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fsDcVZN9k5EQ7kNvwHMRSbP&_nc_oc=Adq0A35Oqdkzjl1oSDpSY2nSpqxj_NKYcnS4CJ8DPqmCmTLioLbYYPAOY4wI6rvwzFU&_nc_zt=3&_nc_ht=
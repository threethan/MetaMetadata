wTbIYbXzFK9j6NukV6_8dbrVbd1QiJefidD73Yk_ePxQ&oe=69CE4F84"}, {"file_name": "5.png", "id": "467916352871409", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39003282_467916356204742_1871921057092171900_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a1ElLFiTY8YQ7kNvwGrem6h&_nc_oc=Adp138hnKH_P0IWioVEe1MDaFJMbd1ZpOFChj9F4xVMVGF6x3KhDOsoRk7uKFpgsDbo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyHElJ9dyD2zT9IVKrwD6tkGHIdXqqhWIZz0QLWDVpxPA&oe=69CE6C62"}, {"file_name": "3.png", "id": "1934382610375855", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974473_1934382613709188_7156337812617042679_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=64YmulHcdHoQ7kNvwHtdyXd&_nc_oc=AdoPC24nXS-wHMgN6FuWKyvNSqdFqYkwNtPCpDMxkPmgWx2mNds7ZKKVZbygfSRmBhs&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwPOs3NqLnjDatyWnZ5OFbLizxresHJYrlO-Fpp3BXFog&oe=69CE5673"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape.png", "id": "1524760081483769", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974531_1524760084817102_6497712644828891067_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UohQ9sJ-RxsQ7kNvwFxFigX&_nc_oc=AdrIK5rm1NtjwjESm7R_PCK1ei6kzx7M1UU1MIvUP2YBnHY0dc70cuXE3RQsf-IiW6o&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyLgIYkDpIYOLgH6mgBvm6HPB53sGiquuvvg7Zguquxjw&oe=69CE556F"}, "display_name": "Mystery Box VR: Hidden Secrets", "keywords": [], "long_description": " AN IMMERSIVE VR PUZZLE EXPERIENCE\nInteract with objects, handles, buttons, and wheels on each side. Crack enigmas and collect hidden puzzle tiles on a random side of the boxes.\n\nYou won't be able to compare reality with fiction.\n\n# DISCOVER INVENTIONS\nOnce you unlock all 8 boxes of a Level Pack, you can compose a puzzle and discover a brief history of an invention.\n\nIt's not always easy to escape the room, so use all your IQ to crack the riddles. There's a logic behind all of them, even where it seems it's not!\n\n# IMMERSIVE SOUNDTRACK\nPlay the game with your headphones to get immersed in this amazing adventure.\n\n# HINTS\nGot stuck on some enigma? No worries, you can still get a helpful hint! You can also get in touch with me in case you really can't make it through a riddle, I'll be glad to help ;)\n\n# MULTILANGUAGE\nAvailable in English, French, Italian, German, Spanish, Russian, and Japanese.\n\nThe game language will change automatically based on the language settings of your device", "short_description": "A VR escape room game where you have to solve intriguing riddles to open boxes and discover nice stories about popular inventions!"}, {"images": {"nodes": [{"file_name": "$R36BSY5.png", "id": "3678762505771822", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031430_3678762509105155_2151975047074617165_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g6YUKXQ22jwQ7kNvwH06dyZ&_nc_oc=Adrzw0Bg4SUH7mwbmB_VC77HCH-38oltq5qshqkL2RRID8owKQz-gIgnQujID_PAfCw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afx2l21Hxx-4-OXCjJqzm2zHTqapWVVS8LE7XlTs0NnHdw&oe=69CE5165"}, {"file_name": "$R81V725.png", "id": "2720695481426567", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75262743_2720695484759900_604086922326600035_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9VV7VRNjOqsQ7kNvwEzwJb3&_nc_oc=AdpfV-GpGYPpJk5RIOZgN6d7KpaeNqaX75gPJ4xFZMYkQgOeMQmjddWb0KrOHZyiURQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxZWgi6nVHs8zxqtFC8ysIEk47M_tW54SRmADNCj-ionA&oe=69CE504D"}, {"file_name": "$RQ3SN6U.png", "id": "1552311425628973", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982519_1552311428962306_1218130395049083834_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oI84xxbW7_QQ7kNvwEiYO61&_nc_oc=AdoBCxRY6wqdVuS3pUSV_fidrhpiKKazYkdFDKcy61Hurkq3ma4aU_oVj-gNISCXjg4&_nc_zt=3&_nc_ht=
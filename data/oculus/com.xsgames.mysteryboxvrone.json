oculuscdn.com/v/t64.5771-25/39003282_467916356204742_1871921057092171900_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c095WwueC5sQ7kNvwEX98UZ&_nc_oc=Adm3P0EECdRk6WoVGtyhyLhVP5N6bUWB8IxzueRXagiJcvDsAUPw_CSsLr1Bkh115iE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afwsk0aXp8qUTy-nx5eMSk0bdOSEVp8L7S2aw9iSCQj_OA&oe=69AD76E2"}, {"file_name": "3.png", "id": "1934382610375855", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974473_1934382613709188_7156337812617042679_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lpdja4OjZrkQ7kNvwHQ3NfU&_nc_oc=AdkqxK9e7_HkNG2a-PVx4Le8d2JFH4hKugRQD6gCa13xagPaIoZLMGStbsIVs1jdjtY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfwqLOnXwAcEIcoljSbi0v4lZdk3Bmw4ykXQ_53n4VIR2A&oe=69AD60F3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape.png", "id": "1524760081483769", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974531_1524760084817102_6497712644828891067_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PPr2kdLCyRUQ7kNvwGn2jTR&_nc_oc=AdnkjjYh2t-TVUB7ykmWUvCBuc7O_M3JUvBcD-HAdVzuKU0Y_yHZqQvHWdAORTzphRE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfxBBdtyFtkxQ_kvKJLp-eFqmVU-j1ptHTtQwj5IsW-b8A&oe=69AD5FEF"}, "display_name": "Mystery Box VR: Hidden Secrets", "keywords": [], "long_description": " AN IMMERSIVE VR PUZZLE EXPERIENCE\nInteract with objects, handles, buttons, and wheels on each side. Crack enigmas and collect hidden puzzle tiles on a random side of the boxes.\n\nYou won't be able to compare reality with fiction.\n\n# DISCOVER INVENTIONS\nOnce you unlock all 8 boxes of a Level Pack, you can compose a puzzle and discover a brief history of an invention.\n\nIt's not always easy to escape the room, so use all your IQ to crack the riddles. There's a logic behind all of them, even where it seems it's not!\n\n# IMMERSIVE SOUNDTRACK\nPlay the game with your headphones to get immersed in this amazing adventure.\n\n# HINTS\nGot stuck on some enigma? No worries, you can still get a helpful hint! You can also get in touch with me in case you really can't make it through a riddle, I'll be glad to help ;)\n\n# MULTILANGUAGE\nAvailable in English, French, Italian, German, Spanish, Russian, and Japanese.\n\nThe game language will change automatically based on the language settings of your device", "short_description": "A VR escape room game where you have to solve intriguing riddles to open boxes and discover nice stories about popular inventions!"}, {"images": {"nodes": [{"file_name": "$R36BSY5.png", "id": "3678762505771822", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031430_3678762509105155_2151975047074617165_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sQi1z9ERDl8Q7kNvwF0zD0h&_nc_oc=AdlaFLUepTz2gB93ktkFM72MfOoPfloV86_AwoSRhYfuCiO6_a72Q3ZPSRmytqA-70Y&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afy-tCnHw5LMk5gjs7lHc7SkVrkluuJXB42zkFdgWxPQNg&oe=69AD5BE5"}, {"file_name": "$R81V725.png", "id": "2720695481426567", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75262743_2720695484759900_604086922326600035_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zIy1RLhO_wIQ7kNvwErwX9B&_nc_oc=AdkYnI5z_8DBnMiRtGQpYsn_ekIwK840o6SVudwK71duKzKHvkAGLA0YIWIrXkUZS1Q&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfwQ73mLBfY0Q1LlHC5BYK4CwvffMr_gBeytZkwLVSIK2g&oe=69AD5ACD"}, {"file_name": "$RQ3SN6U.png", "id": "1552311425628973", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982519_1552311428962306_1218130395049083834_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PNmlVpahiC8Q7kNvwHb1-qS&_nc_oc=AdlfVUw9zwy3ReDdyCGfjU3avKZFfvULk2ldS8ipcWR0lUjQtVv_NWHBhAEtsIadorw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afy4OyWRTw-isMD9ym-06HlyrU_lKknaKjxsYQB93drRpQ&oe=69AD6629"}, {"file_name": "38982645_1000853181732648_505551742782
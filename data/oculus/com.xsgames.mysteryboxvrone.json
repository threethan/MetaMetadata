oculuscdn.com/v/t64.5771-25/39003282_467916356204742_1871921057092171900_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C465XMaV2qwQ7kNvwFNm_mf&_nc_oc=Adn8Rq18PWuH2hyS19MtRSVPKqLs8Ns4B7sigy3Hu14YRmaFj-lIaZS7rain7tQGu8I&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AftNFvNKtyHrna2aI9gRJxozgxEvlXxDUcJsA2NiekJRTg&oe=69A98262"}, {"file_name": "3.png", "id": "1934382610375855", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974473_1934382613709188_7156337812617042679_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g9fn6Gui0_sQ7kNvwFA8Ldq&_nc_oc=Adl90KVxWegQR8unHLGJRFQeQ1agEJZSBSkz33WdgJyiP6Pm5XGCri50VCRqDJZuAns&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_Afs3VgHK_FKyCRqLMTN6OxajTy-vgNrZguMHVV2i-1tL-w&oe=69A96C73"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape.png", "id": "1524760081483769", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974531_1524760084817102_6497712644828891067_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4eGKdO0LpHIQ7kNvwG8m7Tc&_nc_oc=AdksWOAujlBJm-6MgzZ2lGzPKA2_vrFHkEHrQjkIsdI-oGOP9i7-nbKDv1UV81Vq_J0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_Afv_wsUkQ_GwCT2jBIc6y_7qoqW3MJlTyB7JmafK6cWu9w&oe=69A96B6F"}, "display_name": "Mystery Box VR: Hidden Secrets", "keywords": [], "long_description": " AN IMMERSIVE VR PUZZLE EXPERIENCE\nInteract with objects, handles, buttons, and wheels on each side. Crack enigmas and collect hidden puzzle tiles on a random side of the boxes.\n\nYou won't be able to compare reality with fiction.\n\n# DISCOVER INVENTIONS\nOnce you unlock all 8 boxes of a Level Pack, you can compose a puzzle and discover a brief history of an invention.\n\nIt's not always easy to escape the room, so use all your IQ to crack the riddles. There's a logic behind all of them, even where it seems it's not!\n\n# IMMERSIVE SOUNDTRACK\nPlay the game with your headphones to get immersed in this amazing adventure.\n\n# HINTS\nGot stuck on some enigma? No worries, you can still get a helpful hint! You can also get in touch with me in case you really can't make it through a riddle, I'll be glad to help ;)\n\n# MULTILANGUAGE\nAvailable in English, French, Italian, German, Spanish, Russian, and Japanese.\n\nThe game language will change automatically based on the language settings of your device", "short_description": "A VR escape room game where you have to solve intriguing riddles to open boxes and discover nice stories about popular inventions!"}, {"images": {"nodes": [{"file_name": "$R36BSY5.png", "id": "3678762505771822", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031430_3678762509105155_2151975047074617165_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_-J6cMzTySsQ7kNvwFPimkw&_nc_oc=AdlPENA-8p5ZauX-sE2_YxXE-OiPhUF3J8FnCm9ckJlz5zsmAqN50jbTjbZmgkFtJBo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_Afv-AvO41TVzosCvnOoC67HBPW_L4PqD_ooybs0guiLEgg&oe=69A96765"}, {"file_name": "$R81V725.png", "id": "2720695481426567", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75262743_2720695484759900_604086922326600035_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x6YxJkxic10Q7kNvwHfL7FV&_nc_oc=AdkTTSVPVYTqr_OIov5StheB3cDfnHv8c_iQ2a-eBUOHn1-4uo_rFR9VBQ8ZLBXg9XU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfusJYFY2nz8ssg2dCC8CcazIGChlkwuH7_bvqWnYpI6VQ&oe=69A9664D"}, {"file_name": "$RQ3SN6U.png", "id": "1552311425628973", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982519_1552311428962306_1218130395049083834_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qFGpsVSg4EsQ7kNvwEr6sHN&_nc_oc=AdkuwcUTHVkltgEmXnKJV8V-y_eHNLexMgaa8eZLchAz4RXHqtrnJ2JdJOnFrcvLqZM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfsCPLAcXfUlWwqhP2HXx5kUv2k6RpmFusIyQofmqdBB9A&oe=69A971A9"}, {"file_name": "38982645_1000853181732648_505551742782
oculuscdn.com/v/t64.5771-25/39003282_467916356204742_1871921057092171900_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WRXTJV8CGTEQ7kNvwHQNGY6&_nc_oc=Adl8Y2pEe6iCL7Vxve80AjfkSEZhcPVXDg4j7oc5a2H2tvrU0yy9y5CUJUHUbtCE-B4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfzBJtxHot-EOyjTG9ITrUBL_fijR-eFK0Naingi3BrNRQ&oe=69BFEBE2"}, {"file_name": "3.png", "id": "1934382610375855", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974473_1934382613709188_7156337812617042679_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9JIu21zT6YgQ7kNvwFteTzZ&_nc_oc=AdnIkOA_fVersq9xE8fYWhxkldrmSiu_MfqAeJRAp6Km29L3yPaVsUqqPyoJwKoZcFM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfyQnly8W_2i5aFe9nQ2JArnj8PYLHq9ReMQJLf2xyzN4A&oe=69BFD5F3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape.png", "id": "1524760081483769", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974531_1524760084817102_6497712644828891067_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WX5-vvJ7SskQ7kNvwGWAivk&_nc_oc=AdnaiSgXiHpmUJySJYQlSPcLuYeuJUnWhOLrbGVwRkU__8eVEHsATXrZ6LoRpfln2Uk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_Afzdz6LMpaIU7Xb5Lt7bjxWZK5Gdy2q6bWSkJz0LLHienQ&oe=69BFD4EF"}, "display_name": "Mystery Box VR: Hidden Secrets", "keywords": [], "long_description": " AN IMMERSIVE VR PUZZLE EXPERIENCE\nInteract with objects, handles, buttons, and wheels on each side. Crack enigmas and collect hidden puzzle tiles on a random side of the boxes.\n\nYou won't be able to compare reality with fiction.\n\n# DISCOVER INVENTIONS\nOnce you unlock all 8 boxes of a Level Pack, you can compose a puzzle and discover a brief history of an invention.\n\nIt's not always easy to escape the room, so use all your IQ to crack the riddles. There's a logic behind all of them, even where it seems it's not!\n\n# IMMERSIVE SOUNDTRACK\nPlay the game with your headphones to get immersed in this amazing adventure.\n\n# HINTS\nGot stuck on some enigma? No worries, you can still get a helpful hint! You can also get in touch with me in case you really can't make it through a riddle, I'll be glad to help ;)\n\n# MULTILANGUAGE\nAvailable in English, French, Italian, German, Spanish, Russian, and Japanese.\n\nThe game language will change automatically based on the language settings of your device", "short_description": "A VR escape room game where you have to solve intriguing riddles to open boxes and discover nice stories about popular inventions!"}, {"images": {"nodes": [{"file_name": "$R36BSY5.png", "id": "3678762505771822", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031430_3678762509105155_2151975047074617165_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wFTYDDa7yhUQ7kNvwFEXIn3&_nc_oc=AdnZtLB9Z5yV5EiuPagqkMgikpddINnn5EtOFP52gbyEShBhHw4tbo9JomQgbjAc-a0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfxoBFRcQ-ep7p2eZf7afWTGRsvtM0QJE-c6x5KkeeIIMg&oe=69BFD0E5"}, {"file_name": "$R81V725.png", "id": "2720695481426567", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75262743_2720695484759900_604086922326600035_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YLnpoeq0PDoQ7kNvwFnViqI&_nc_oc=Adl1eruvMCeVLlEDaDpRnif2dXf90GRoyatmig-iUJUpG_DmuwsUShvJdLDJYpFsYXc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_Afw8FZ4_zPzt5z7es3j8GV9A55tyLoB3SquqrviiR_cegA&oe=69BFCFCD"}, {"file_name": "$RQ3SN6U.png", "id": "1552311425628973", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982519_1552311428962306_1218130395049083834_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bdRfbMG-qt4Q7kNvwFae_If&_nc_oc=AdkLrFAO8wV1wSRSRSN2k9NsaLKzx-y7cBc_SxH4mb5Ok3ukj1l1Fk3WCw2b-t-PC1M&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_Afz-2hezY5R-hS23wypgef6gu8JhA9MCYRTWlQzzhMEHLw&oe=69BFDB29"}, {"file_name": "38982645_1000853181732648_505551742782
oculuscdn.com/v/t64.5771-25/39003282_467916356204742_1871921057092171900_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WRXTJV8CGTEQ7kNvwGgVpw9&_nc_oc=AdmF8P80ZCOH8cRufvX8OjeRI2l7rJzMHHy_PZozPlbLeVLNXSQeWm3DLNQMOVl5-lo&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_Afw7JplVDX7f8bPFe6WeatA-H96O5H27Hrgzkfsdg5MXcQ&oe=69BE9A62"}, {"file_name": "3.png", "id": "1934382610375855", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974473_1934382613709188_7156337812617042679_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0U0dVVF_GIkQ7kNvwG8gW7b&_nc_oc=AdluoI2AbWPw9VJs20fkJPepk25Orwe8DcSOk5xKILzIsITsTA5vwhyyewDfQjNZ5mc&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_Afw4rvQOpjh6ZlZ_IwoAxOGmsj8VJOSaS8d5OgViczNdNQ&oe=69BE8473"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape.png", "id": "1524760081483769", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974531_1524760084817102_6497712644828891067_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WX5-vvJ7SskQ7kNvwEeNEl-&_nc_oc=AdkO7So8QJ6-Y9gn-bdXN1Uoy15LYRj-nWquT-fIHLB2Qa-KsA2b68SIifvUpwnrd3o&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfxaDE40cEILC73HZwPiyvraKxvYOyFxs2QdLYx-FoPAuA&oe=69BE836F"}, "display_name": "Mystery Box VR: Hidden Secrets", "keywords": [], "long_description": " AN IMMERSIVE VR PUZZLE EXPERIENCE\nInteract with objects, handles, buttons, and wheels on each side. Crack enigmas and collect hidden puzzle tiles on a random side of the boxes.\n\nYou won't be able to compare reality with fiction.\n\n# DISCOVER INVENTIONS\nOnce you unlock all 8 boxes of a Level Pack, you can compose a puzzle and discover a brief history of an invention.\n\nIt's not always easy to escape the room, so use all your IQ to crack the riddles. There's a logic behind all of them, even where it seems it's not!\n\n# IMMERSIVE SOUNDTRACK\nPlay the game with your headphones to get immersed in this amazing adventure.\n\n# HINTS\nGot stuck on some enigma? No worries, you can still get a helpful hint! You can also get in touch with me in case you really can't make it through a riddle, I'll be glad to help ;)\n\n# MULTILANGUAGE\nAvailable in English, French, Italian, German, Spanish, Russian, and Japanese.\n\nThe game language will change automatically based on the language settings of your device", "short_description": "A VR escape room game where you have to solve intriguing riddles to open boxes and discover nice stories about popular inventions!"}, {"images": {"nodes": [{"file_name": "$R36BSY5.png", "id": "3678762505771822", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39031430_3678762509105155_2151975047074617165_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wFTYDDa7yhUQ7kNvwHfZX-b&_nc_oc=AdnVjMRto7dN0LdTRN5gVnPyWxq4hwq4HXrpPgWH7iswjcaybVK4GaSqQYzTti6ZIZU&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfzXvNRT9EByHlxCzLVTo5Scm6i92CUxnQLZYVudYvyZMA&oe=69BE7F65"}, {"file_name": "$R81V725.png", "id": "2720695481426567", "image_type": "APP_IMG_ICON", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75262743_2720695484759900_604086922326600035_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JHo5dRyJK3EQ7kNvwHgikjs&_nc_oc=AdkaimZvdqnHWhqdk5C3KSdtGfm4VhewUfk-QChtfqCHXq8Y6V9SBPhtqbU6XNzQAQ4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_Afx6NTd_p5zkXnXSdPhK4wgWiGwEJgiOrBF0UCwFuWi66g&oe=69BE7E4D"}, {"file_name": "$RQ3SN6U.png", "id": "1552311425628973", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982519_1552311428962306_1218130395049083834_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bdRfbMG-qt4Q7kNvwFuwWit&_nc_oc=AdntzAlw4YWBfzsibw3tgxVwX2icvx97g0xryZmFOJ8pEFbx_ZTmdogZKscFy9sHf_Q&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_Afwk8j9322flXGMYlEj8JV_p6eCMryB6sF2bUhU6oNt51g&oe=69BE89A9"}, {"file_name": "38982645_1000853181732648_505551742782
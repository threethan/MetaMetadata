ExgGtCKm0A-yYn6muw1okWf40QD6fiTHiG1unpSl7bYw&oe=6A7C5584"}, {"file_name": "5.png", "id": "467916352871409", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39003282_467916356204742_1871921057092171900_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sB_YGeS_OoUQ7kNvwEdViF8&_nc_oc=AdrRSfP793cZvBO4fpCZCuO6-H75AJEBZ6l0lX3SmuNxovvjdLtMEoRqKj2jyP6Ow6Y&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGPF-FCFxrvUdpN_s_RcV6Fhw6E_e5UcbpjgcsV6GNC7g&oe=6A7C7262"}, {"file_name": "3.png", "id": "1934382610375855", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974473_1934382613709188_7156337812617042679_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=auHKFdSw4boQ7kNvwESWqcv&_nc_oc=AdplvxtHddHVdLzD6IhJ2R_5Vsy7FLrsjrhQ_w2MlJollRpULljDsXa1tT4bPmTH9us&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEw8-uQNEux7r2TSnHCxxvkGYCIcfM-XJz1YFs8MuPcQQ&oe=6A7C5C73"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape.png", "id": "1524760081483769", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974531_1524760084817102_6497712644828891067_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PXzfjSNr0qcQ7kNvwFvcxCv&_nc_oc=AdqlV3trTr2LHMeONiF-VPIuyBYSGEQ4amkycoFa8t-4hUtkKDdODImYH6v9HUw6JXI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGd5SZCOTEUyeQ_fZnYO3fQHfEH6x1n7b3kgcq7tuC2Ig&oe=6A7C5B6F"}, "display_name": "Mystery Box VR: Hidden Secrets", "keywords": [], "long_description": " AN IMMERSIVE VR PUZZLE EXPERIENCE\nInteract with objects, handles, buttons, and wheels on each side. Crack enigmas and collect hidden puzzle tiles on a random side of the boxes.\n\nYou won't be able to compare reality with fiction.\n\n# DISCOVER INVENTIONS\nOnce you unlock all 8 boxes of a Level Pack, you can compose a puzzle and discover a brief history of an invention.\n\nIt's not always easy to escape the room, so use all your IQ to crack the riddles. There's a logic behind all of them, even where it seems it's not!\n\n# IMMERSIVE SOUNDTRACK\nPlay the game with your headphones to get immersed in this amazing adventure.\n\n# HINTS\nGot stuck on some enigma? No worries, you can still get a helpful hint! You can also get in touch with me in case you really can't make it through a riddle, I'll be glad to help ;)\n\n# MULTILANGUAGE\nAvailable in English, French, Italian, German, Spanish, Russian, and Japanese.\n\nThe game language will change automatically based on the language settings of your device", "short_description": "A VR escape room game where you have to solve intriguing riddles to open boxes and discover nice stories about popular inventions!"}, {"images": {"nodes": [{"file_name": "$R36BSY5.png", "id": "3678762505771822", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031430_3678762509105155_2151975047074617165_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TabCGj2h_-EQ7kNvwGekRZU&_nc_oc=AdqBdxtx_fTsu6uijk-GrtBKekuyKqScV9_DS7pgR3JE0ckqeGol2Q4wzA-usKPNLyo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGBdfMrdAfXflX58yYrx_S5ukKo_93xqodTRY0OMjjyjQ&oe=6A7C5765"}, {"file_name": "$R81V725.png", "id": "2720695481426567", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75262743_2720695484759900_604086922326600035_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IOqqRB2BlEAQ7kNvwEqVdf6&_nc_oc=AdpqCRSnGDESwQxWzrbqZJu903UC6BXJpEG09N6ugUcRgxcjEpNBlrEsyl7sMBvEy98&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEU3nRNlYsQOcBFOh0MT9SqyVGOOjnFzcG-UyQ8VaHNsA&oe=6A7C564D"}, {"file_name": "$RQ3SN6U.png", "id": "1552311425628973", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982519_1552311428962306_1218130395049083834_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PywjoRwZmEoQ7kNvwEjmQB1&_nc_oc=AdpPHQ8FkhHTmdIS58ZBjY8PlREcLNX9y_wh_NWtSI0K9IfTFQ_NUGqkbQgs6MtjD7Y&_nc_zt=3&_nc_ht=
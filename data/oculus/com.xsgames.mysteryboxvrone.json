3tDnYK3rrmEvul8C7jTc3_c8JoakiygGCFTWqs34H_tA&oe=69D4E704"}, {"file_name": "5.png", "id": "467916352871409", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39003282_467916356204742_1871921057092171900_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-_AhFsnGvUIQ7kNvwGacLnJ&_nc_oc=AdpmOsVMKQnMCIW8SvyQDtEA49Y5G2Q4l-ga-OmnxI5Sfj2Ti8yDLqJaYcJDPqR7gX0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2J2lqsMncaLNTY720WiowHkPUS_59xspE1sXB8FInvmw&oe=69D503E2"}, {"file_name": "3.png", "id": "1934382610375855", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974473_1934382613709188_7156337812617042679_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1g2KGztdVjEQ7kNvwHu34zA&_nc_oc=AdqZmYq3skkSERhUstbqDApFlraGhtA261w4jwfzlG_AHzs27GbxLkrdyQoH9Ww8tXQ&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3xRaOvhcRFpkWTo4BheIbni03yO2jz5Cws6IuMkMEM9A&oe=69D4EDF3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape.png", "id": "1524760081483769", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974531_1524760084817102_6497712644828891067_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CJfFlCRxjgkQ7kNvwFCNKxr&_nc_oc=AdqlIJtMuecMWsOnelVVE-qGCpSSuTK9DuuDqM-XjLK1LtU1fQLL1405oD4dTJv4zB0&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af35QPfGQpY-J-h-r-twywGpz_0sitNahby8-TUYY4G3XA&oe=69D4ECEF"}, "display_name": "Mystery Box VR: Hidden Secrets", "keywords": [], "long_description": " AN IMMERSIVE VR PUZZLE EXPERIENCE\nInteract with objects, handles, buttons, and wheels on each side. Crack enigmas and collect hidden puzzle tiles on a random side of the boxes.\n\nYou won't be able to compare reality with fiction.\n\n# DISCOVER INVENTIONS\nOnce you unlock all 8 boxes of a Level Pack, you can compose a puzzle and discover a brief history of an invention.\n\nIt's not always easy to escape the room, so use all your IQ to crack the riddles. There's a logic behind all of them, even where it seems it's not!\n\n# IMMERSIVE SOUNDTRACK\nPlay the game with your headphones to get immersed in this amazing adventure.\n\n# HINTS\nGot stuck on some enigma? No worries, you can still get a helpful hint! You can also get in touch with me in case you really can't make it through a riddle, I'll be glad to help ;)\n\n# MULTILANGUAGE\nAvailable in English, French, Italian, German, Spanish, Russian, and Japanese.\n\nThe game language will change automatically based on the language settings of your device", "short_description": "A VR escape room game where you have to solve intriguing riddles to open boxes and discover nice stories about popular inventions!"}, {"images": {"nodes": [{"file_name": "$R36BSY5.png", "id": "3678762505771822", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031430_3678762509105155_2151975047074617165_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A4cTAAm09AMQ7kNvwGYuNxm&_nc_oc=Adrtm29Hi9RIgQw-vIQO9amQOkqqB9-zLqGxceIH5O0xZ2XEFLATsiIKSY_DTbOoNEk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3uWhqUNY6nP1cOjf1eRkgCKgX4Sez9I93S4rmVh264pg&oe=69D4E8E5"}, {"file_name": "$R81V725.png", "id": "2720695481426567", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75262743_2720695484759900_604086922326600035_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EyO8hmUt7HEQ7kNvwHGNFa2&_nc_oc=AdqlZasj7Os_JpQOMW1RjS55sP5lkMSN8UeoeZVERKoY9VH-T9KkSDYkqw47yEHJ7_M&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0DLr7mBgO-OzYekbwhQsYBVrUK78CwwMLRHK8W5kOTyQ&oe=69D4E7CD"}, {"file_name": "$RQ3SN6U.png", "id": "1552311425628973", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982519_1552311428962306_1218130395049083834_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QZJLSY_B1-kQ7kNvwG5ZArX&_nc_oc=Adq6TcXaCK7e6LTZQKi42b1a4SH8q3Js3_64MSUMs_fLfsEYB5mM1fyIOROcCSXfhsE&_nc_zt=3&_nc_ht=
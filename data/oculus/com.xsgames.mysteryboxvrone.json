_JUw&oe=69A047E2"}, {"file_name": "3.png", "id": "1934382610375855", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974473_1934382613709188_7156337812617042679_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QcE4vAXF8rIQ7kNvwE1L2S-&_nc_oc=Adkq4YPbhoh-5kDvi0VIH7pevgycm2ek9PAeemtWsb_Q4rCjKUwmpiKOlqelIHHgxMg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfuCa-0YZI1VZOgU_fEXu-SitVzN758xe_vfGhkSReXcgA&oe=69A031F3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape.png", "id": "1524760081483769", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974531_1524760084817102_6497712644828891067_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1knUNwNtwr4Q7kNvwGpmNhn&_nc_oc=AdlrjOSEsamA9jUR-qU8PUCOJ8GVX7ntFCQzPx-i8Zv61lwL-hgRDzptnT340P0HYFA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfuP6fyt4m7IKiPg_A5Q9bb1ZWW2YznXssXAwSlodCIsqg&oe=69A030EF"}, "display_name": "Mystery Box VR: Hidden Secrets", "keywords": [], "long_description": " AN IMMERSIVE VR PUZZLE EXPERIENCE\nInteract with objects, handles, buttons, and wheels on each side. Crack enigmas and collect hidden puzzle tiles on a random side of the boxes.\n\nYou won't be able to compare reality with fiction.\n\n# DISCOVER INVENTIONS\nOnce you unlock all 8 boxes of a Level Pack, you can compose a puzzle and discover a brief history of an invention.\n\nIt's not always easy to escape the room, so use all your IQ to crack the riddles. There's a logic behind all of them, even where it seems it's not!\n\n# IMMERSIVE SOUNDTRACK\nPlay the game with your headphones to get immersed in this amazing adventure.\n\n# HINTS\nGot stuck on some enigma? No worries, you can still get a helpful hint! You can also get in touch with me in case you really can't make it through a riddle, I'll be glad to help ;)\n\n# MULTILANGUAGE\nAvailable in English, French, Italian, German, Spanish, Russian, and Japanese.\n\nThe game language will change automatically based on the language settings of your device", "short_description": "A VR escape room game where you have to solve intriguing riddles to open boxes and discover nice stories about popular inventions!"}, {"images": {"nodes": [{"file_name": "$R36BSY5.png", "id": "3678762505771822", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031430_3678762509105155_2151975047074617165_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3oaXKUFYhnoQ7kNvwGRCq_9&_nc_oc=Adm8Kg8FwfOOfsetXVs4vjyw0BmpfOWPeRoJTNiWh1ZIaWsJWcNGhF8BLKBKOpsQprI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfvnYVTEo_6OoeRQ3huUvh82a_IzB1pmO7y4_8bm6bOl5w&oe=69A02CE5"}, {"file_name": "$R81V725.png", "id": "2720695481426567", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75262743_2720695484759900_604086922326600035_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qPgpUoXR6-gQ7kNvwFDyjYI&_nc_oc=AdnyD13jMdyXWPUL5ts9Stl_V2_vFAEe4-YuEWXNIk0YXr-Q5X6I_kFc_J7Ze1E6i98&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afvr70aS3-FqHR4-y83bP8tNNfjyVkZYU7Wc9Xv9UrFg6g&oe=69A02BCD"}, {"file_name": "$RQ3SN6U.png", "id": "1552311425628973", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982519_1552311428962306_1218130395049083834_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jFxLD1qPFY4Q7kNvwFqiv4l&_nc_oc=AdkuepJBzJufH9DO97Nd2FsJYURyubPmALvXOG3NqGZ6m505jFxL6O-FVScKuT0D-a0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AftuklD3SPntq-wHxqWEAityXMFZDwcRY2cA_UrlYjadEg&oe=69A03729"}, {"file_name": "38982645_1000853181732648_5055517427829171192_n.png", "id": "1043990680394008", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031625_1043990683727341_3557431131423146005_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B445TmBWlQgQ7kNvwG3Rw54&_nc_oc=Admuz8o_E1o4bhzxFazsFZDgf_hEH6HqIi77tdi404WQJUkA-vfVcUM5bQ3HIwLnHpw&_nc_zt=3&_nc_ht=scontent-iad3-1
Cidk4k4WGbddmSWDoIflCeJtQ50cPFbRKhbKWA9kZAmg&oe=6A6B6A44"}, {"file_name": "5.png", "id": "467916352871409", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39003282_467916356204742_1871921057092171900_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5IpeZoJhoEoQ7kNvwGn9CWq&_nc_oc=Adr3XAopbGhGkbTrn6xDXt6cEKS0x37S-UjvRU_pHPuSBeb85FexccRWzae_cU2B2ZI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDbw8PI_lMNJIRH31S86YRr2TwDXQMXxoNqrdfipFukfw&oe=6A6B4EE2"}, {"file_name": "3.png", "id": "1934382610375855", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974473_1934382613709188_7156337812617042679_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KOYiLY0m3k4Q7kNvwEobIHT&_nc_oc=AdrqdHB_yRn2J9GOqsUwX4wEMKnoYQXWuThVDdWS6E7QwfvX0HygZDWo5rCyObHn0lE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAB_F8Mrr_jdCV964jjVuY_6msH4hAdflJ0U_FE6TReHQ&oe=6A6B38F3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape.png", "id": "1524760081483769", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974531_1524760084817102_6497712644828891067_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QDYuHfl4np0Q7kNvwGUsoQA&_nc_oc=Adoqe9hZms59zB5Pcv3Uf6OquZndCXFXtpdveE3Jm6z6hNiBEMJkIP8PO8RXkNF8lk0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA455x_A3VUYgpL-wNFEqTdSXbd_16o3r5gMKpFMK9m6Q&oe=6A6B37EF"}, "display_name": "Mystery Box VR: Hidden Secrets", "keywords": [], "long_description": " AN IMMERSIVE VR PUZZLE EXPERIENCE\nInteract with objects, handles, buttons, and wheels on each side. Crack enigmas and collect hidden puzzle tiles on a random side of the boxes.\n\nYou won't be able to compare reality with fiction.\n\n# DISCOVER INVENTIONS\nOnce you unlock all 8 boxes of a Level Pack, you can compose a puzzle and discover a brief history of an invention.\n\nIt's not always easy to escape the room, so use all your IQ to crack the riddles. There's a logic behind all of them, even where it seems it's not!\n\n# IMMERSIVE SOUNDTRACK\nPlay the game with your headphones to get immersed in this amazing adventure.\n\n# HINTS\nGot stuck on some enigma? No worries, you can still get a helpful hint! You can also get in touch with me in case you really can't make it through a riddle, I'll be glad to help ;)\n\n# MULTILANGUAGE\nAvailable in English, French, Italian, German, Spanish, Russian, and Japanese.\n\nThe game language will change automatically based on the language settings of your device", "short_description": "A VR escape room game where you have to solve intriguing riddles to open boxes and discover nice stories about popular inventions!"}, {"images": {"nodes": [{"file_name": "$R36BSY5.png", "id": "3678762505771822", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031430_3678762509105155_2151975047074617165_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yktsoRUXY78Q7kNvwFzIkZC&_nc_oc=Adp1hpX0ULLDSUdubp1E_0bacfLcvooqBVMQsc84Dc-87hpjQGGenfK04mepNO4dy5o&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD5HJvT5Qagy1KAD_5-FgOSgz_AsW4GteBAFz6JMzTIdQ&oe=6A6B6C25"}, {"file_name": "$R81V725.png", "id": "2720695481426567", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75262743_2720695484759900_604086922326600035_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tcljYjz-edoQ7kNvwFRfYHC&_nc_oc=AdrtXtxwhi7AeqbCk-2jc-3MOHaxoKbEKpLnnTrhCS7fx9OH3gOIzxuUdO-crOruRLw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDqBZsWjoIN0BzmZl006OKPGPstJSSbL9r7d1wDHr6A2Q&oe=6A6B6B0D"}, {"file_name": "$RQ3SN6U.png", "id": "1552311425628973", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982519_1552311428962306_1218130395049083834_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ekVuDoUbgFoQ7kNvwFJQhPt&_nc_oc=AdpZ2f4reFKs4GdKRGsAehgS9sWh4cDxJKzjXiA5ZAvmke67vsR5lnc-yYn4y9D3c0E&_nc_zt=3&_nc_ht=
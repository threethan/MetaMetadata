MXu91Lw4OzLw9suztE3fbmHlCRuBzyKXgzLegynrbv7A&oe=6ACBA7C4"}, {"file_name": "5.png", "id": "467916352871409", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39003282_467916356204742_1871921057092171900_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sub-zabo9WUQ7kNvwHNMEbL&_nc_oc=Adp5kAXjf0ociFvtYrNCi3tn1Tjt57Pq56iuhwjiwtfgszMk15cvDLPesNjkMU1o0zI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOabfJmbVFnEQeQbrcpDfVFSu4AP5A7TjRbwMziBmo-NA&oe=6ACBC4A2"}, {"file_name": "3.png", "id": "1934382610375855", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974473_1934382613709188_7156337812617042679_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J8QjMCmRfGYQ7kNvwF01tJI&_nc_oc=AdqJGqIn5gCERBQHgQI_oIR5cATKGvHvhDXW7zsY9Grt2IUaMlTDggQINHhPTiZjtMc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN4WUb7ZSA48Ej3lAYh_ecUSlXtWdP7t1WXEP_b7bZlhA&oe=6ACBAEB3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape.png", "id": "1524760081483769", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974531_1524760084817102_6497712644828891067_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r6RGmlq3zzcQ7kNvwFOf5OK&_nc_oc=AdrkwvotNOo6pfssJk9TSkRqAkC6F9diijd8Yw2cx3B9gsWFVwWdOqWVOTtvd2r6InY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNfK_s0ApgYMhucZ-bAB8GeLq5LqYDmYo7AjuABp0it-A&oe=6ACBADAF"}, "display_name": "Mystery Box VR: Hidden Secrets", "keywords": [], "long_description": " AN IMMERSIVE VR PUZZLE EXPERIENCE\nInteract with objects, handles, buttons, and wheels on each side. Crack enigmas and collect hidden puzzle tiles on a random side of the boxes.\n\nYou won't be able to compare reality with fiction.\n\n# DISCOVER INVENTIONS\nOnce you unlock all 8 boxes of a Level Pack, you can compose a puzzle and discover a brief history of an invention.\n\nIt's not always easy to escape the room, so use all your IQ to crack the riddles. There's a logic behind all of them, even where it seems it's not!\n\n# IMMERSIVE SOUNDTRACK\nPlay the game with your headphones to get immersed in this amazing adventure.\n\n# HINTS\nGot stuck on some enigma? No worries, you can still get a helpful hint! You can also get in touch with me in case you really can't make it through a riddle, I'll be glad to help ;)\n\n# MULTILANGUAGE\nAvailable in English, French, Italian, German, Spanish, Russian, and Japanese.\n\nThe game language will change automatically based on the language settings of your device", "short_description": "A VR escape room game where you have to solve intriguing riddles to open boxes and discover nice stories about popular inventions!"}, {"images": {"nodes": [{"file_name": "$R36BSY5.png", "id": "3678762505771822", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031430_3678762509105155_2151975047074617165_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Q3clvNHtzocQ7kNvwGTQE-6&_nc_oc=AdoxUEEIwecaKhwpGRH4E3yc4s9FF_87pKcp0uvGi4tJw3WIbPfGcNqX-QzN8HZ9jEw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPFCByCSVMS9wmTZICmNQBp6QTJ74EyZC4w5siSK4i2Jg&oe=6ACBA9A5"}, {"file_name": "$R81V725.png", "id": "2720695481426567", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75262743_2720695484759900_604086922326600035_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gs8zp7BsOVoQ7kNvwEsL30-&_nc_oc=AdpJbLkydrBOYzWH8TYrOnJ_qS3qExKOZX4Hcs_3j3zLQMHewKeTUYSEJlPseBuwrio&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPZ0bkg3GQpKZb2K8mzgNfflA79ZGvazUoJx_5xkVmyZQ&oe=6ACBA88D"}, {"file_name": "$RQ3SN6U.png", "id": "1552311425628973", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982519_1552311428962306_1218130395049083834_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4Miye65zFQUQ7kNvwEPnTPF&_nc_oc=AdoQOsl4Sb20-hE5nfgRxN7YSBzUElOssfOP_yzsboOSHr72X80CoED-0tw3gsPPwZM&_nc_zt=3&_nc_ht=
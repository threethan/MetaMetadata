MJ0EXccjeoTepJwykgjZazMwPQQBRY26cPr1pFwN7Y2g&oe=6ADE1CC4"}, {"file_name": "5.png", "id": "467916352871409", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39003282_467916356204742_1871921057092171900_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=chBK1qCR8L8Q7kNvwFPz_PG&_nc_oc=AdpCut1GDr20v6GyMz1XW6NHAHP8JUZTOWH8Fk-zTFdQm_cEYCXTkvRqCEiqonkeA-I&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPXkgEBFhAKxzRWJbckFDOiKvifLvxuVOVj0XtzwoRSCA&oe=6ADE0162"}, {"file_name": "3.png", "id": "1934382610375855", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974473_1934382613709188_7156337812617042679_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MJ7HdUWs29kQ7kNvwG7yrz9&_nc_oc=Adpiaba7Qaw1WtBavycn7BZqHXJrrt-rylArD8FLfTIsgtSS6bvDJq4BFmJTj4LtmpI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN1RGK-pyfff883BOPnX5UfV4pr_b83U5-M58oo4NeVqQ&oe=6ADE23B3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape.png", "id": "1524760081483769", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974531_1524760084817102_6497712644828891067_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NQBf84qakuMQ7kNvwFWHdRd&_nc_oc=Adr1dno3N8m1Gmt7dy2ohdZofDYYsbeaCrwfficSornmFIjspFXoEjIXvrM_TKEy-bw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNIUy88vtzHF66R2kcWDNra2vBLjcXixYXExpgP_HAboQ&oe=6ADE22AF"}, "display_name": "Mystery Box VR: Hidden Secrets", "keywords": [], "long_description": " AN IMMERSIVE VR PUZZLE EXPERIENCE\nInteract with objects, handles, buttons, and wheels on each side. Crack enigmas and collect hidden puzzle tiles on a random side of the boxes.\n\nYou won't be able to compare reality with fiction.\n\n# DISCOVER INVENTIONS\nOnce you unlock all 8 boxes of a Level Pack, you can compose a puzzle and discover a brief history of an invention.\n\nIt's not always easy to escape the room, so use all your IQ to crack the riddles. There's a logic behind all of them, even where it seems it's not!\n\n# IMMERSIVE SOUNDTRACK\nPlay the game with your headphones to get immersed in this amazing adventure.\n\n# HINTS\nGot stuck on some enigma? No worries, you can still get a helpful hint! You can also get in touch with me in case you really can't make it through a riddle, I'll be glad to help ;)\n\n# MULTILANGUAGE\nAvailable in English, French, Italian, German, Spanish, Russian, and Japanese.\n\nThe game language will change automatically based on the language settings of your device", "short_description": "A VR escape room game where you have to solve intriguing riddles to open boxes and discover nice stories about popular inventions!"}, {"images": {"nodes": [{"file_name": "$R36BSY5.png", "id": "3678762505771822", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031430_3678762509105155_2151975047074617165_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mDbv-FMJ0MEQ7kNvwHh1moy&_nc_oc=AdqJjelRBEzW3-qjJR7Zf73jfrGxUNYK4sYLr2d-fjC4kYnMEJFYKCcljzTmDH7UMR8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPezjt8oAcCN9KPilWHQ7XLiVLqkfU0K6frYyjyNJvIVA&oe=6ADE1EA5"}, {"file_name": "$R81V725.png", "id": "2720695481426567", "image_type": "APP_IMG_ICON", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75262743_2720695484759900_604086922326600035_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=X_piOz10lD0Q7kNvwEX_NKU&_nc_oc=AdqzKqiyl3mi3ORAnL0SdttIWy98AN9HWjWioCLVaHe98Xgzjew8P5pJAyd01GsQKDs&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN5_QoxUvajINcxBhdPezsSXR5fRk_G9aIePF75pndocQ&oe=6ADE1D8D"}, {"file_name": "$RQ3SN6U.png", "id": "1552311425628973", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982519_1552311428962306_1218130395049083834_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2fNiINTEnb4Q7kNvwF8I_tp&_nc_oc=AdoGVm8ttI6uBOQ2kBeFmbOoRdrqmg1WT1uA6MVS9gx3yfTxl3wTI1MPRUYwHtK7POo&_nc_zt=3&_nc_ht=
6xIKHSvITuTwT9_lMbg3Ps0n3piSbdCVf2p11bV8bVzA&oe=6A0DCFC4"}, {"file_name": "5.png", "id": "467916352871409", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39003282_467916356204742_1871921057092171900_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vVLiaiFU1dgQ7kNvwGYLDwD&_nc_oc=Adq-jhLRC2nC9h-YrB_uJBOz0gsm70zrVIhk0Df-QATL9jYNtxwdWHO1s7GmVcn--64&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5-Pto1Rn_KaR0dI068iM2aNtksjjvkbaUnbJ5Sh9OfNg&oe=6A0DB462"}, {"file_name": "3.png", "id": "1934382610375855", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974473_1934382613709188_7156337812617042679_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=paC6jcB2i58Q7kNvwE0vfM_&_nc_oc=Adr49ejPfzd2UAK_UL7pJVO5W3S9qrkIoz-QtSFadj-arJ7vwxVCQqO0eyO74WjsgHk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4q8fLz0gyQumGA_99iyDiMZDtUd6zdCyFTsFg8vgYvTg&oe=6A0DD6B3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape.png", "id": "1524760081483769", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974531_1524760084817102_6497712644828891067_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ssiNuv60_hMQ7kNvwGXyL3i&_nc_oc=AdpkpUU03P6ww6dMY2f3VMMcqKgGog4bPvlgQMAKBgl6dAvx43_sNKY90CqFLdcEr24&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7l-RriG7Wp0c9h6qaCN-0nN75XvwSpB33-PNWEc2zjUg&oe=6A0DD5AF"}, "display_name": "Mystery Box VR: Hidden Secrets", "keywords": [], "long_description": " AN IMMERSIVE VR PUZZLE EXPERIENCE\nInteract with objects, handles, buttons, and wheels on each side. Crack enigmas and collect hidden puzzle tiles on a random side of the boxes.\n\nYou won't be able to compare reality with fiction.\n\n# DISCOVER INVENTIONS\nOnce you unlock all 8 boxes of a Level Pack, you can compose a puzzle and discover a brief history of an invention.\n\nIt's not always easy to escape the room, so use all your IQ to crack the riddles. There's a logic behind all of them, even where it seems it's not!\n\n# IMMERSIVE SOUNDTRACK\nPlay the game with your headphones to get immersed in this amazing adventure.\n\n# HINTS\nGot stuck on some enigma? No worries, you can still get a helpful hint! You can also get in touch with me in case you really can't make it through a riddle, I'll be glad to help ;)\n\n# MULTILANGUAGE\nAvailable in English, French, Italian, German, Spanish, Russian, and Japanese.\n\nThe game language will change automatically based on the language settings of your device", "short_description": "A VR escape room game where you have to solve intriguing riddles to open boxes and discover nice stories about popular inventions!"}, {"images": {"nodes": [{"file_name": "$R36BSY5.png", "id": "3678762505771822", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031430_3678762509105155_2151975047074617165_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pK3rXYbRCREQ7kNvwGK2WKf&_nc_oc=AdrnhDoJ0VxLj0mkbQh2t7G2Z2yoHAdupKGjTaivEI1Q4Rt5F94wkUiMFa7yYLhcuxA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7LwnkfIM-AmwDwwZ3zXw-T26Rb9zN06wDOdhr4zWWZ2g&oe=6A0DD1A5"}, {"file_name": "$R81V725.png", "id": "2720695481426567", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75262743_2720695484759900_604086922326600035_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2EO0t3CVuuwQ7kNvwFC6nfh&_nc_oc=AdqP-GClrA_XJwW9LRIOcZ3v76-ub70DtWMq_KZOFC3LV-LeH0_MSX7b8A5sVbL-qCU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6JXeya-jCcJqe7GPxDkEY9RZENLfNgjBfzVsbHptlNdA&oe=6A0DD08D"}, {"file_name": "$RQ3SN6U.png", "id": "1552311425628973", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982519_1552311428962306_1218130395049083834_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SuG5LxbtaO4Q7kNvwE2UzV6&_nc_oc=AdrKFJHL8WG0fMRlhF6bTN66t1JjEuKjFpKtnlZEvQwkquWSAMJk6uPccT1tWB5PCQw&_nc_zt=3&_nc_ht=
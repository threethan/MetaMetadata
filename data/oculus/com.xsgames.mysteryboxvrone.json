_ny6UtMuG-vNx5N-Jsy_2GpbXKNV-0hj0iXIeJ9mPsSw&oe=6A340B44"}, {"file_name": "5.png", "id": "467916352871409", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39003282_467916356204742_1871921057092171900_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n9qQJxf_BmUQ7kNvwFWuFgW&_nc_oc=AdoHmgfxV24xKkhOBLBwm_Mie74EtVOM9Rczq3yuEXIoXDGI7v4IW7JP9FyIzXox3Hs&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af80eiDKrpxxpMoYdT4SqMuqNdYa8n_7dcDISPIxHD1j3A&oe=6A33EFE2"}, {"file_name": "3.png", "id": "1934382610375855", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974473_1934382613709188_7156337812617042679_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yxXpkd_y8IgQ7kNvwENM29p&_nc_oc=Ado2JJ5O2csIyH4_kOZFooiKJboZSS0f4geaPlANKlupQp0uaHuMNfAh1-b-sL9dBbc&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-hR9LCyY-vSjXOB4-Xd4FqFmnCbSb0gaIiDt2BysM6Gw&oe=6A341233"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape.png", "id": "1524760081483769", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974531_1524760084817102_6497712644828891067_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IhQwZg4qoCoQ7kNvwHTyk9p&_nc_oc=AdowxlKQNYm-1eYR2B-_oLv1wb2suDr_LnuO8GGm_Qzzl6fxmT3Wgge_2LADQcGUoDI&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_ZEcYlzkw9wVsV5m7twGH6ibFn6kd-uJuI0JQUCtBM7g&oe=6A34112F"}, "display_name": "Mystery Box VR: Hidden Secrets", "keywords": [], "long_description": " AN IMMERSIVE VR PUZZLE EXPERIENCE\nInteract with objects, handles, buttons, and wheels on each side. Crack enigmas and collect hidden puzzle tiles on a random side of the boxes.\n\nYou won't be able to compare reality with fiction.\n\n# DISCOVER INVENTIONS\nOnce you unlock all 8 boxes of a Level Pack, you can compose a puzzle and discover a brief history of an invention.\n\nIt's not always easy to escape the room, so use all your IQ to crack the riddles. There's a logic behind all of them, even where it seems it's not!\n\n# IMMERSIVE SOUNDTRACK\nPlay the game with your headphones to get immersed in this amazing adventure.\n\n# HINTS\nGot stuck on some enigma? No worries, you can still get a helpful hint! You can also get in touch with me in case you really can't make it through a riddle, I'll be glad to help ;)\n\n# MULTILANGUAGE\nAvailable in English, French, Italian, German, Spanish, Russian, and Japanese.\n\nThe game language will change automatically based on the language settings of your device", "short_description": "A VR escape room game where you have to solve intriguing riddles to open boxes and discover nice stories about popular inventions!"}, {"images": {"nodes": [{"file_name": "$R36BSY5.png", "id": "3678762505771822", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39031430_3678762509105155_2151975047074617165_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IiFbLjG75AQQ7kNvwHAb-xj&_nc_oc=Adprt_qLRzj5OlvGXWr9ZjadF-uVDbNJ2XJrRfHDtcUzaDK24Mp_DEIYR8oKEpZMFyA&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9O7DRkMrMl6ITDWWGjXMENlZ3R4qwbzY6dQfDdLyJMqQ&oe=6A340D25"}, {"file_name": "$R81V725.png", "id": "2720695481426567", "image_type": "APP_IMG_ICON", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/75262743_2720695484759900_604086922326600035_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZQA9PCXqgpAQ7kNvwEJThv8&_nc_oc=AdqKFVMIN4Lpxto-CCAF4reiCAgUwdQcp2nqurYj-JwS-IGTMMAGWG_g87aCOFC191s&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_FqZOf7aLGOX8-9DOSeMS-Lwjgc_z0kMX6XOJQ2-dFgg&oe=6A340C0D"}, {"file_name": "$RQ3SN6U.png", "id": "1552311425628973", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38982519_1552311428962306_1218130395049083834_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9ts5AtAVlnYQ7kNvwGymlZI&_nc_oc=AdoL-OHiIcBBUamA1kSyLkhvhNkOmHDqLUJZMJ4HADR3KefLJgZUmJnWbELyADDf9YM&_nc_zt=3&_nc_ht=
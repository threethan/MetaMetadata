L7Da7CcXXiL8hmxb6kqjsVjW911pbt2q95kcag5Xyf9w&oe=6AB29B44"}, {"file_name": "5.png", "id": "467916352871409", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39003282_467916356204742_1871921057092171900_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w3CGWsvEl5oQ7kNvwEEB1sV&_nc_oc=AdpfUzfS_REaN-ztHXD3X3BsY42yJp-HqSBL68rHiWM6gNkqK_Tp7NtXZnCx-JyBnNE&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJjoGVHcxetOyILpv4tUKNN4m2TVd7gzP7WSVDVoRfUfQ&oe=6AB27FE2"}, {"file_name": "3.png", "id": "1934382610375855", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974473_1934382613709188_7156337812617042679_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m0lI_t0upD0Q7kNvwGIbOX0&_nc_oc=AdqiqkhgQ58Jj71JOdNmsCWjw1sJH9Hx1Df5VQpd6y3eAUCJrqmQOsI04TA6cI9Pq_w&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL4-yevBGBPc4BcNJn2r237OkQDsQO-P7Dap0O1PsvdqA&oe=6AB2A233"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape.png", "id": "1524760081483769", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974531_1524760084817102_6497712644828891067_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SV5NYsiB1cwQ7kNvwE-Ryj9&_nc_oc=Ado7khp3szy9AEVr-idatJgW4PcoJWfI8bvLFxzqkXT0YovrHlRautRhtPabtCo2UFg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLdtPHxKPXvV6h6T9llq0VxLSR6eJtM2L0jzdRF8rjwiQ&oe=6AB2A12F"}, "display_name": "Mystery Box VR: Hidden Secrets", "keywords": [], "long_description": " AN IMMERSIVE VR PUZZLE EXPERIENCE\nInteract with objects, handles, buttons, and wheels on each side. Crack enigmas and collect hidden puzzle tiles on a random side of the boxes.\n\nYou won't be able to compare reality with fiction.\n\n# DISCOVER INVENTIONS\nOnce you unlock all 8 boxes of a Level Pack, you can compose a puzzle and discover a brief history of an invention.\n\nIt's not always easy to escape the room, so use all your IQ to crack the riddles. There's a logic behind all of them, even where it seems it's not!\n\n# IMMERSIVE SOUNDTRACK\nPlay the game with your headphones to get immersed in this amazing adventure.\n\n# HINTS\nGot stuck on some enigma? No worries, you can still get a helpful hint! You can also get in touch with me in case you really can't make it through a riddle, I'll be glad to help ;)\n\n# MULTILANGUAGE\nAvailable in English, French, Italian, German, Spanish, Russian, and Japanese.\n\nThe game language will change automatically based on the language settings of your device", "short_description": "A VR escape room game where you have to solve intriguing riddles to open boxes and discover nice stories about popular inventions!"}, {"images": {"nodes": [{"file_name": "$R36BSY5.png", "id": "3678762505771822", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031430_3678762509105155_2151975047074617165_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qf1Tda_VFNYQ7kNvwFn2IjW&_nc_oc=AdrSwggRk9mcQnX0rYel_ESEoziD9J5IcjuJA97PHIlSJ01FLiEa04mLRB0PnXRTC0Q&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIa26HUmD1rgl6md4nfxndQ9Kwa0en58J8XzbDfv9KaNw&oe=6AB29D25"}, {"file_name": "$R81V725.png", "id": "2720695481426567", "image_type": "APP_IMG_ICON", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75262743_2720695484759900_604086922326600035_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=taUYVMWZvakQ7kNvwEpJofl&_nc_oc=AdrI177cUrs-I_bBbtvWUxOBOXq-72aTE68i6q4_wELOUPnkjvrU2cgMQUcVjaPfAo4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLGU5qmZhO24b25jMRCNcQIzQZwvRq0fV3VcupgpuS3hA&oe=6AB29C0D"}, {"file_name": "$RQ3SN6U.png", "id": "1552311425628973", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982519_1552311428962306_1218130395049083834_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iRwvyehGUKcQ7kNvwET1IVn&_nc_oc=AdoEWhkbaE_HRnJ4312NClEm3ft6Ka5XYf2IcTOu9A56PkZHeCxaUV9nj0nsLqChCYw&_nc_zt=3&_nc_ht=
03SqUIIG617SzTuI2a_naTiuD0MwAbrAvJQl0fIKyrWg&oe=69F371C4"}, {"file_name": "5.png", "id": "467916352871409", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39003282_467916356204742_1871921057092171900_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sx3YeF0b-F8Q7kNvwEhqpd-&_nc_oc=Ado1nARGpayWQGf3NPXxPR2lEfvGvDni7c-z5UobrYOU7dsBAxDIYo6ekvVXVW1c5Vc&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0i95dVVAhFnato3aQjbZinQ8AfbOuPEDWptBvBq64B7Q&oe=69F35662"}, {"file_name": "3.png", "id": "1934382610375855", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974473_1934382613709188_7156337812617042679_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=croQcA-CEQ4Q7kNvwHSIBba&_nc_oc=AdrJKUp2t_CQ0lLVP5FJ7ses9MUnw_PsJm6LSqddAWhfMizgpuQ1LtrSEdVNbcXCpRQ&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2gvnMZObr8wpqDzBtq_V6yHgxWkgqIYTr8sXauSomzeA&oe=69F34073"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape.png", "id": "1524760081483769", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974531_1524760084817102_6497712644828891067_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kQZsbJu2DM8Q7kNvwF18Y9W&_nc_oc=AdoxuUC53EcQ_0fAI1W-cV_XCf77GHyt5ky3mbDTLu5yG2utXw3YmEhUZ4KV3XL4tDk&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2B7QYXl7G0d7r__eYKX7NmK1_WQVC4Wc-jcUqtvkiUcQ&oe=69F33F6F"}, "display_name": "Mystery Box VR: Hidden Secrets", "keywords": [], "long_description": " AN IMMERSIVE VR PUZZLE EXPERIENCE\nInteract with objects, handles, buttons, and wheels on each side. Crack enigmas and collect hidden puzzle tiles on a random side of the boxes.\n\nYou won't be able to compare reality with fiction.\n\n# DISCOVER INVENTIONS\nOnce you unlock all 8 boxes of a Level Pack, you can compose a puzzle and discover a brief history of an invention.\n\nIt's not always easy to escape the room, so use all your IQ to crack the riddles. There's a logic behind all of them, even where it seems it's not!\n\n# IMMERSIVE SOUNDTRACK\nPlay the game with your headphones to get immersed in this amazing adventure.\n\n# HINTS\nGot stuck on some enigma? No worries, you can still get a helpful hint! You can also get in touch with me in case you really can't make it through a riddle, I'll be glad to help ;)\n\n# MULTILANGUAGE\nAvailable in English, French, Italian, German, Spanish, Russian, and Japanese.\n\nThe game language will change automatically based on the language settings of your device", "short_description": "A VR escape room game where you have to solve intriguing riddles to open boxes and discover nice stories about popular inventions!"}, {"images": {"nodes": [{"file_name": "$R36BSY5.png", "id": "3678762505771822", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39031430_3678762509105155_2151975047074617165_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v0HKqFefVK4Q7kNvwHfaFAL&_nc_oc=Ado83k5tfFsUtaykQbWkGJLrJfMCv4_7ENv_CebLDPYl3ZzEjdIconniN72Gt-wsOJ0&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1UFLRmJYyqDE8XAFeN_leYID0XJIjvD7ez4gdTf9jegQ&oe=69F373A5"}, {"file_name": "$R81V725.png", "id": "2720695481426567", "image_type": "APP_IMG_ICON", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/75262743_2720695484759900_604086922326600035_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CTPYwstLWbwQ7kNvwG7YFfZ&_nc_oc=AdrjGHhun3pAGHvM3mTdeIi6nX8P-PjJQuTPvh1RAQ6yDDdjdQM0Dn6fhJwHYJfwulQ&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0_9vhonmhsjx0EVHgV40oFe7ErxtE5iyI9BStZXipN1g&oe=69F3728D"}, {"file_name": "$RQ3SN6U.png", "id": "1552311425628973", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38982519_1552311428962306_1218130395049083834_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=t3ZowUAlbwYQ7kNvwE7tnGw&_nc_oc=Adqw4I7-AvvJljOPiYzX898ZpEo4eoIAbklBej3muB-rLEYmvrdUDnfyQbVYNhopypI&_nc_zt=3&_nc_ht=
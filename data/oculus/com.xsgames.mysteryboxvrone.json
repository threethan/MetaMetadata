=1-7&_nc_sid=6e7a0a&_nc_ohc=sx3YeF0b-F8Q7kNvwHUHTra&_nc_oc=AdpLs-qX0ajBk_hHmm52-3L_GgK0dEPFKgeLRySpCxDdCxpZjZZ7hX97FOUK1z0zqA4&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_Af1CoID4FBiMVL47MehFR9jvgUgZEDJ02RwLJRqSiCzUVw&oe=69F204E2"}, {"file_name": "3.png", "id": "1934382610375855", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974473_1934382613709188_7156337812617042679_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GBdKfpmO3FAQ7kNvwFFW3p4&_nc_oc=AdpA_p01U3eWQ2qh6Y77-IdyMfXiLxA84_BlTu2Pmlg0xom25OI_pMgcyM8xavL8348&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1338Q8MBixpyByRebc9mRW6m25EJQM0ry_ndf_wWGfSg&oe=69F1EEF3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape.png", "id": "1524760081483769", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974531_1524760084817102_6497712644828891067_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kQZsbJu2DM8Q7kNvwGCy47V&_nc_oc=AdokEhDdf5XVHxwvfXDPw_pNkYs-XAacvRn0h6JCufPDIIdts6LTBodSkCboK4ChH58&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&oh=00_Af3mcHVBnY7WxZxBLLt88Uqw4MRV2AMb3dBpxM2JVb1wDg&oe=69F1EDEF"}, "display_name": "Mystery Box VR: Hidden Secrets", "keywords": [], "long_description": " AN IMMERSIVE VR PUZZLE EXPERIENCE\nInteract with objects, handles, buttons, and wheels on each side. Crack enigmas and collect hidden puzzle tiles on a random side of the boxes.\n\nYou won't be able to compare reality with fiction.\n\n# DISCOVER INVENTIONS\nOnce you unlock all 8 boxes of a Level Pack, you can compose a puzzle and discover a brief history of an invention.\n\nIt's not always easy to escape the room, so use all your IQ to crack the riddles. There's a logic behind all of them, even where it seems it's not!\n\n# IMMERSIVE SOUNDTRACK\nPlay the game with your headphones to get immersed in this amazing adventure.\n\n# HINTS\nGot stuck on some enigma? No worries, you can still get a helpful hint! You can also get in touch with me in case you really can't make it through a riddle, I'll be glad to help ;)\n\n# MULTILANGUAGE\nAvailable in English, French, Italian, German, Spanish, Russian, and Japanese.\n\nThe game language will change automatically based on the language settings of your device", "short_description": "A VR escape room game where you have to solve intriguing riddles to open boxes and discover nice stories about popular inventions!"}, {"images": {"nodes": [{"file_name": "$R36BSY5.png", "id": "3678762505771822", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39031430_3678762509105155_2151975047074617165_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v0HKqFefVK4Q7kNvwEVs6gE&_nc_oc=Adpj3ylpBysF_OAk8y8HCuzsySwTSYEbzqJl8uBi6k4eUeWDE9lurDtHgiQuM46JIMw&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_Af1GeDN29fHQ3CTUDRm0a6eZfOc6Pvc43BIeriCP_c5reg&oe=69F1E9E5"}, {"file_name": "$R81V725.png", "id": "2720695481426567", "image_type": "APP_IMG_ICON", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/75262743_2720695484759900_604086922326600035_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EO4_Bus1OAgQ7kNvwEIZ-ct&_nc_oc=AdrnmW3mUAcMhBxmKA0BdsTXgk_DaeVtAkn_4WQt2qWgH6rWbQdlHaeRaKsv7ikm7U8&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_Af1r6uWZPAiRd02HapE4O092w3_wMnfwngY2t6_qgkkATA&oe=69F1E8CD"}, {"file_name": "$RQ3SN6U.png", "id": "1552311425628973", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38982519_1552311428962306_1218130395049083834_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=t3ZowUAlbwYQ7kNvwEvJ5ho&_nc_oc=Adp_FYYCLFkymm5d2ahNhRFsRk9Y2AqInIZtVdqBUelGgRMVYS1g4ZHOqYleWfuIYuU&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1Xr_OZrS9VT3cJZpXD-1Zsx8aNyq2r02esZSQa0EA5-Q&oe=69F1F429"}, {"file_name": "38982645_1000853181732648_5055517427829171192_n.png", "id": "1043990680394008", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-atl3-2.oculus
Cqed9mWid0K6EEhIeQvUBcpmBymaM4iK-MJkWpC2zv0g&oe=6A6775C4"}, {"file_name": "5.png", "id": "467916352871409", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39003282_467916356204742_1871921057092171900_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QvvQN8Tao1sQ7kNvwEDCkT8&_nc_oc=AdpCEIFeNOg5FmkT-EIwu14KnKMVO6MKPByq3TjKvnfkaYAJNi8PpJB7C1-In15OZl0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCKHTK38Jpyb8Tr2kGNGWwagCslBliYB6UXgkeUrWzNUw&oe=6A675A62"}, {"file_name": "3.png", "id": "1934382610375855", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974473_1934382613709188_7156337812617042679_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2upa2w1b5UcQ7kNvwGYP_Li&_nc_oc=Adrdh4G5xm8jBYFf1INWpSRdOJ-XAklsIIDqh9JNfxtErKio7r_Db0y6KA7MLg0M9AE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQALl00vN2ahlOQnrCsEVlz8jEWGjBPJ8ElrV6YS91L2Sw&oe=6A674473"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape.png", "id": "1524760081483769", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974531_1524760084817102_6497712644828891067_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mQrlYBu0Y1YQ7kNvwEaijlM&_nc_oc=Adrz36270mVtlfPhla-78sJFO5bXxj7F1jVnSaVPEmAJWmQpyKnu1vA7gjp6n4BxYuA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBX6aVrJ72pkTfcj0-JjlTtA8r2xZi5pLimCW-3uD81pw&oe=6A677BAF"}, "display_name": "Mystery Box VR: Hidden Secrets", "keywords": [], "long_description": " AN IMMERSIVE VR PUZZLE EXPERIENCE\nInteract with objects, handles, buttons, and wheels on each side. Crack enigmas and collect hidden puzzle tiles on a random side of the boxes.\n\nYou won't be able to compare reality with fiction.\n\n# DISCOVER INVENTIONS\nOnce you unlock all 8 boxes of a Level Pack, you can compose a puzzle and discover a brief history of an invention.\n\nIt's not always easy to escape the room, so use all your IQ to crack the riddles. There's a logic behind all of them, even where it seems it's not!\n\n# IMMERSIVE SOUNDTRACK\nPlay the game with your headphones to get immersed in this amazing adventure.\n\n# HINTS\nGot stuck on some enigma? No worries, you can still get a helpful hint! You can also get in touch with me in case you really can't make it through a riddle, I'll be glad to help ;)\n\n# MULTILANGUAGE\nAvailable in English, French, Italian, German, Spanish, Russian, and Japanese.\n\nThe game language will change automatically based on the language settings of your device", "short_description": "A VR escape room game where you have to solve intriguing riddles to open boxes and discover nice stories about popular inventions!"}, {"images": {"nodes": [{"file_name": "$R36BSY5.png", "id": "3678762505771822", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031430_3678762509105155_2151975047074617165_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NC0_7j53zcoQ7kNvwFR9lLA&_nc_oc=Ado_GCOIABH4ok5RBoMl4rONkjvjBiaSXSWsT0uBxGDlTbdewQFWQxPlL8Sm2HQ9vr0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC1AvPlbbOzbSHEihMCXbTpvkUlODn66BYxmsyUhWcD1g&oe=6A6777A5"}, {"file_name": "$R81V725.png", "id": "2720695481426567", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75262743_2720695484759900_604086922326600035_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5_ss3kzpapAQ7kNvwFJ6sk6&_nc_oc=AdoCR857k3F66owoiCm5ifEdC4D0E6tZgmc_7UEwPkQ6IX79p1fDEEUSUD7UfrEvZ8w&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAmTEMQghae99nQO9FxrKaNxHz3J1srtgwau3_MO97mng&oe=6A67768D"}, {"file_name": "$RQ3SN6U.png", "id": "1552311425628973", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982519_1552311428962306_1218130395049083834_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VXUf-6D1lDsQ7kNvwHXuW0g&_nc_oc=AdpdbxIhsNhUvgTZ_GJzpmguHSpXYy-EkcurO2D6fnYTpL5OeAV04eUJ7XBXgXRN43Q&_nc_zt=3&_nc_ht=
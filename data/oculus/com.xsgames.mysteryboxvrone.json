Ck4Zq8ejjrDb4GJa2AoQ-rjTt0Yu_qxQ5wFZuIzCwdIA&oe=6A4BC644"}, {"file_name": "5.png", "id": "467916352871409", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39003282_467916356204742_1871921057092171900_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YlhM-7SQHI4Q7kNvwGeQ3Jd&_nc_oc=AdoaoianH_NIF3dbZ6HmMkWqjZpsuuwz2SNfOK7CJ-aOGWcuh05sC00_Dz-QqE2dJE0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAaysAVaEXBgI2TpdwD5TKNKaKGxBEVdIfZKaYFj6Kp4g&oe=6A4BAAE2"}, {"file_name": "3.png", "id": "1934382610375855", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974473_1934382613709188_7156337812617042679_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2aJtXEJCZ-AQ7kNvwEjTrOT&_nc_oc=Adrwee65XRIqu3lzIbfQ9-FDP5g4Ot8UFKZ3jo9AOdEqEslXKGQKar3T2xcC-NemB4Q&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDYn-1wZeJlOfN1pgsMB-cgENAmjDj9lf8mKcU7qazbzQ&oe=6A4BCD33"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape.png", "id": "1524760081483769", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974531_1524760084817102_6497712644828891067_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=122i4hkOLOoQ7kNvwGNtAdg&_nc_oc=Adr0MfZxl506b44xjqp5LrNixgWlbrfoLZpp-vp7t2SfmTGyHI7Ddtx2CxRljRh2OrQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBR8E_zSEX9TOT4-ZYbCxHHCxb7B5rVv4l2t2vOo9xtVA&oe=6A4BCC2F"}, "display_name": "Mystery Box VR: Hidden Secrets", "keywords": [], "long_description": " AN IMMERSIVE VR PUZZLE EXPERIENCE\nInteract with objects, handles, buttons, and wheels on each side. Crack enigmas and collect hidden puzzle tiles on a random side of the boxes.\n\nYou won't be able to compare reality with fiction.\n\n# DISCOVER INVENTIONS\nOnce you unlock all 8 boxes of a Level Pack, you can compose a puzzle and discover a brief history of an invention.\n\nIt's not always easy to escape the room, so use all your IQ to crack the riddles. There's a logic behind all of them, even where it seems it's not!\n\n# IMMERSIVE SOUNDTRACK\nPlay the game with your headphones to get immersed in this amazing adventure.\n\n# HINTS\nGot stuck on some enigma? No worries, you can still get a helpful hint! You can also get in touch with me in case you really can't make it through a riddle, I'll be glad to help ;)\n\n# MULTILANGUAGE\nAvailable in English, French, Italian, German, Spanish, Russian, and Japanese.\n\nThe game language will change automatically based on the language settings of your device", "short_description": "A VR escape room game where you have to solve intriguing riddles to open boxes and discover nice stories about popular inventions!"}, {"images": {"nodes": [{"file_name": "$R36BSY5.png", "id": "3678762505771822", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031430_3678762509105155_2151975047074617165_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MdtFJHqOlJIQ7kNvwFp4DaS&_nc_oc=AdosdTunu1rl6dop4jX36JzJLBxHWJq0VysQXp-FCgQf079Go3bt0vxLMnCQL7YK5Kg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD5tYzVQiVsembEuIOw3gNSw6fg3XioVdCjm_CDODA84Q&oe=6A4BC825"}, {"file_name": "$R81V725.png", "id": "2720695481426567", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75262743_2720695484759900_604086922326600035_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LYLqFUqlb34Q7kNvwECdvEC&_nc_oc=AdqU9o5lIHe8GPUGJI9M0gWbP-Zl6K0b7fipuW82FRQ_1i_l6FnkwiY5W-83Rl6raNs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD5hbdqDQi-ydkp_x8jLKdY79356IBDF87XAWo_Mijtzw&oe=6A4BC70D"}, {"file_name": "$RQ3SN6U.png", "id": "1552311425628973", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982519_1552311428962306_1218130395049083834_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CsH5IP9sg3YQ7kNvwGSJo2i&_nc_oc=AdozYQknySedvc-svjjqKNaPK6VMPetD5EOO9UUsYIYFpEWHqeB4R-UFeZ8ZIHfyv3w&_nc_zt=3&_nc_ht=
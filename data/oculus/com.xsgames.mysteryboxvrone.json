KR_kiqkmEU2CM3uTqdbBEkgiGO51FsZlWMG4TMdnJ9dA&oe=6ABE78C4"}, {"file_name": "5.png", "id": "467916352871409", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39003282_467916356204742_1871921057092171900_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QbkiB0DqVjAQ7kNvwGOnxZc&_nc_oc=AdqYnVtZxfPy7XlXR8lDo81-awi5i8HcCuyhudKviSPu6mzY0Q59OywugyB-Zuczz2I&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLNMey2ikgS96jgQTbwtOevNbck2-I6JSsROyFUHtriAA&oe=6ABE5D62"}, {"file_name": "3.png", "id": "1934382610375855", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974473_1934382613709188_7156337812617042679_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vnuLThSyrVQQ7kNvwHnikOm&_nc_oc=Ado0lfqO4o2VjcqTFeqXFPI1tMunXWJtSV7d3ZnoP_HPr96zHmg-7CuVFLLYqO58LHE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIEAjg-UhzmkseYdOrHtIJDrSIjaBa1R4bdFMdF-Ywkzg&oe=6ABE7FB3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape.png", "id": "1524760081483769", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974531_1524760084817102_6497712644828891067_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uc9g0X1OnS8Q7kNvwFrYnrG&_nc_oc=AdoS1fuO91p9q-BMPRupkTWWNZk3tY143OV7_W8nNYV2y1dMeBy9BxglNIZv8YNgOcE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI9hqg-Dtq_ydn-WCeg_5cV7jIouUR3FcpD9cTHMzf-PA&oe=6ABE7EAF"}, "display_name": "Mystery Box VR: Hidden Secrets", "keywords": [], "long_description": " AN IMMERSIVE VR PUZZLE EXPERIENCE\nInteract with objects, handles, buttons, and wheels on each side. Crack enigmas and collect hidden puzzle tiles on a random side of the boxes.\n\nYou won't be able to compare reality with fiction.\n\n# DISCOVER INVENTIONS\nOnce you unlock all 8 boxes of a Level Pack, you can compose a puzzle and discover a brief history of an invention.\n\nIt's not always easy to escape the room, so use all your IQ to crack the riddles. There's a logic behind all of them, even where it seems it's not!\n\n# IMMERSIVE SOUNDTRACK\nPlay the game with your headphones to get immersed in this amazing adventure.\n\n# HINTS\nGot stuck on some enigma? No worries, you can still get a helpful hint! You can also get in touch with me in case you really can't make it through a riddle, I'll be glad to help ;)\n\n# MULTILANGUAGE\nAvailable in English, French, Italian, German, Spanish, Russian, and Japanese.\n\nThe game language will change automatically based on the language settings of your device", "short_description": "A VR escape room game where you have to solve intriguing riddles to open boxes and discover nice stories about popular inventions!"}, {"images": {"nodes": [{"file_name": "$R36BSY5.png", "id": "3678762505771822", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031430_3678762509105155_2151975047074617165_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Kyiry5-JgvkQ7kNvwG2aJbB&_nc_oc=Adqi2XulSQcI6v0tpzcVse6-ltAZx3RN-8QczukQxrbNJBIbnrCjcnZM5pPAbVf7RJY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL9k4uzDTvsIUIrX5SHQaBNf4ZNzug67yLt_frZONPn6g&oe=6ABE7AA5"}, {"file_name": "$R81V725.png", "id": "2720695481426567", "image_type": "APP_IMG_ICON", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75262743_2720695484759900_604086922326600035_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pRFYNnbN_9cQ7kNvwEU3bCC&_nc_oc=AdqckZMm5sqJ5ftY4Vjq5o9KWBaS-KOguCYwSDOblwDFJUIRaW9yEB4gptReZKmCHMQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKQZhBcnQE-QTyYhU6z2HoDGgKZJ8GwAPOvEMlqgP39jw&oe=6ABE798D"}, {"file_name": "$RQ3SN6U.png", "id": "1552311425628973", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982519_1552311428962306_1218130395049083834_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YDxrfButeyMQ7kNvwElz4iC&_nc_oc=AdoxhdHp7eqe88KIl7SYTsU9hrStHWF6C9vwVwB8mIz_kEutwMgTQpQGpvMQiospoO0&_nc_zt=3&_nc_ht=
wKZbo8q5IqONZnaFYH893oRL4zqGaV5zUDZbzK7lupXw&oe=69CFA104"}, {"file_name": "5.png", "id": "467916352871409", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39003282_467916356204742_1871921057092171900_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a1ElLFiTY8YQ7kNvwG_KiEg&_nc_oc=AdpSLO0wlH4y_QVQWF7zVaQ6jTbYhcJnUjI3MavHiIYfSYA7jkZ0ex1HMl-BekiwXeg&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afy9yBWo5MYIJGlE4-BoohPF8g-qttKO9DgFRYb0P2xtNQ&oe=69CFBDE2"}, {"file_name": "3.png", "id": "1934382610375855", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974473_1934382613709188_7156337812617042679_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K9A2Z-YlKqIQ7kNvwH1OU3M&_nc_oc=AdqD_iCRCUfNxYy3WMzXoYEio_HPPd8Drh2YxnMLQnmq1JPH0cMeKGPFsFatkecoJZA&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwiCEVt-yFespWUta7YFb67t535FBYOh59-RLdvj5SqXA&oe=69CFA7F3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape.png", "id": "1524760081483769", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974531_1524760084817102_6497712644828891067_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UohQ9sJ-RxsQ7kNvwHCoe9A&_nc_oc=AdrfPiRVAb3bACptcE3KhN8DO9oIVt-4vIwiCruMVGxNyqCu4SS_qurPz1gR01mGCWY&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzHbNHGOPGpGLIk-3-MDTX9GWGuUdgyWpy3tKdyBugiYg&oe=69CFA6EF"}, "display_name": "Mystery Box VR: Hidden Secrets", "keywords": [], "long_description": " AN IMMERSIVE VR PUZZLE EXPERIENCE\nInteract with objects, handles, buttons, and wheels on each side. Crack enigmas and collect hidden puzzle tiles on a random side of the boxes.\n\nYou won't be able to compare reality with fiction.\n\n# DISCOVER INVENTIONS\nOnce you unlock all 8 boxes of a Level Pack, you can compose a puzzle and discover a brief history of an invention.\n\nIt's not always easy to escape the room, so use all your IQ to crack the riddles. There's a logic behind all of them, even where it seems it's not!\n\n# IMMERSIVE SOUNDTRACK\nPlay the game with your headphones to get immersed in this amazing adventure.\n\n# HINTS\nGot stuck on some enigma? No worries, you can still get a helpful hint! You can also get in touch with me in case you really can't make it through a riddle, I'll be glad to help ;)\n\n# MULTILANGUAGE\nAvailable in English, French, Italian, German, Spanish, Russian, and Japanese.\n\nThe game language will change automatically based on the language settings of your device", "short_description": "A VR escape room game where you have to solve intriguing riddles to open boxes and discover nice stories about popular inventions!"}, {"images": {"nodes": [{"file_name": "$R36BSY5.png", "id": "3678762505771822", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39031430_3678762509105155_2151975047074617165_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g6YUKXQ22jwQ7kNvwFxUB36&_nc_oc=AdrkJ1xu6dqwX61HVAzn2p_Ff7_NLi7bADs79UaVCWrFuM4rPNKH-RflelyHyI9GvdY&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyOWi7ssnlbjsXDeAflfIomF4l2kQktC93zWDO7WVQYAQ&oe=69CFA2E5"}, {"file_name": "$R81V725.png", "id": "2720695481426567", "image_type": "APP_IMG_ICON", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/75262743_2720695484759900_604086922326600035_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ni4Or0FI0qgQ7kNvwE2R0lr&_nc_oc=AdpzcgLtA4892qY2675f7tPqC51ewbs9VqoAsB_QB2MaUVKCtCK4oCE3AhMD67qfYl0&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyGeViuKmQOAPEMuAhd-ExhMSgDTpj2t7eyXrXOucQG0g&oe=69CFA1CD"}, {"file_name": "$RQ3SN6U.png", "id": "1552311425628973", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38982519_1552311428962306_1218130395049083834_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oI84xxbW7_QQ7kNvwFvGi6N&_nc_oc=Adr1dopStkKpIoMqhywaxO8yjO7Voq_6A8cBnkQGAIkDy4mbEdZkhrj54q2a_bvOwC8&_nc_zt=3&_nc_ht=
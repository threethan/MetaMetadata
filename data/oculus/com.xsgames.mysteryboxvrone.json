CEy_-7etzcu9EbHEMRzio7aLiZ4M739wIjs2lF5n_1fQ&oe=6A64D2C4"}, {"file_name": "5.png", "id": "467916352871409", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39003282_467916356204742_1871921057092171900_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JRupKCU8BWAQ7kNvwEQ5oup&_nc_oc=Adqc4tROvOzKREZ3xMd2f2m_A2N9KtDXiruqrNmA-s80hNLOqjY6V_ttUD489R8UIjs&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC5SoFg413fDvYkEA6TPgAfnbrHgM1VKQOEY716fFT2RA&oe=6A64B762"}, {"file_name": "3.png", "id": "1934382610375855", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974473_1934382613709188_7156337812617042679_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s77qzT6yfzYQ7kNvwFZGWlB&_nc_oc=AdqZbQcILYS8sffn1_r4vwpsuwRrtGEZkDDrHAmiWAS0xohbj78dHiD7jHMUzTXt13o&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDhvmAGsZLtLOmvqrgQEg05tHuWnYExTeO8YfOUH9NaLQ&oe=6A64A173"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape.png", "id": "1524760081483769", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974531_1524760084817102_6497712644828891067_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mfpLlmCwN-cQ7kNvwGwo-9d&_nc_oc=AdqWZHgJTUsEeKojz6x6EbO7f30xk7EfC-gm6ZHTyMP3tbBss6OIqZOlvC0h_UiV8cc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQArY72kZ2N-M03YEuJIxf5wOW13VSOO0geyEArndxQppA&oe=6A64A06F"}, "display_name": "Mystery Box VR: Hidden Secrets", "keywords": [], "long_description": " AN IMMERSIVE VR PUZZLE EXPERIENCE\nInteract with objects, handles, buttons, and wheels on each side. Crack enigmas and collect hidden puzzle tiles on a random side of the boxes.\n\nYou won't be able to compare reality with fiction.\n\n# DISCOVER INVENTIONS\nOnce you unlock all 8 boxes of a Level Pack, you can compose a puzzle and discover a brief history of an invention.\n\nIt's not always easy to escape the room, so use all your IQ to crack the riddles. There's a logic behind all of them, even where it seems it's not!\n\n# IMMERSIVE SOUNDTRACK\nPlay the game with your headphones to get immersed in this amazing adventure.\n\n# HINTS\nGot stuck on some enigma? No worries, you can still get a helpful hint! You can also get in touch with me in case you really can't make it through a riddle, I'll be glad to help ;)\n\n# MULTILANGUAGE\nAvailable in English, French, Italian, German, Spanish, Russian, and Japanese.\n\nThe game language will change automatically based on the language settings of your device", "short_description": "A VR escape room game where you have to solve intriguing riddles to open boxes and discover nice stories about popular inventions!"}, {"images": {"nodes": [{"file_name": "$R36BSY5.png", "id": "3678762505771822", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031430_3678762509105155_2151975047074617165_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NC0_7j53zcoQ7kNvwHxoNN6&_nc_oc=AdprbIDpgKNILgEdQilft1tlj5zD-SjpGa7TwobFouqUZc6_DFXGWiYZUyR7ewI4mpU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDE22ucDlPMv4Ed6UIjMEB43M0mHOQTrPXSXYx6GvxEGA&oe=6A649C65"}, {"file_name": "$R81V725.png", "id": "2720695481426567", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75262743_2720695484759900_604086922326600035_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aWp710nGOBwQ7kNvwF31mKi&_nc_oc=AdrtsJZb1T_irqkv31m5tZyZTifmoLrARhDLWfmry4U7VjilZhQ9MV4myetdapfOxHM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCl2s-T6aF2z1JUF_O8ZBfKQvw8KZ8HBJKIqEukMomVlQ&oe=6A64D38D"}, {"file_name": "$RQ3SN6U.png", "id": "1552311425628973", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982519_1552311428962306_1218130395049083834_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VXUf-6D1lDsQ7kNvwGeu5jy&_nc_oc=AdpQX-5dWY98DF0pOJ58mI_Od5qF0vqjJ4jhm3sTlz1TBH9ar7fwEOFqqpRBwKu55Ws&_nc_zt=3&_nc_ht=
LReKMUdVWszR9n-80RQjOQ3hBU6ibv5aq-8t2j7WqHng&oe=6AB7E144"}, {"file_name": "5.png", "id": "467916352871409", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39003282_467916356204742_1871921057092171900_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UBWBABwaq3QQ7kNvwGWPwRc&_nc_oc=AdpdBFUatliQVqyrYMhUv4kK4eGsKCWHE70twF4EHM8ijfApKnmLuj6xSRgI3INjcwA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKXe7obpqOcVtruOaMYw24Qnudwqad0F_FYukIPrrxtdA&oe=6AB7C5E2"}, {"file_name": "3.png", "id": "1934382610375855", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974473_1934382613709188_7156337812617042679_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-jxC_iYfMJ4Q7kNvwFtXE5u&_nc_oc=AdqcEWz9FyKsG3bHhlwS3ldKLDgOvycKzAJHQjp7fQAQrlERCh8owa77SQ8FO19Fmug&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKpGv5qmCvjY6QC2SyNsr4zGcpJ0_x5SEY_6gvxgIzMFA&oe=6AB7E833"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape.png", "id": "1524760081483769", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974531_1524760084817102_6497712644828891067_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7Jof5wr8ZNsQ7kNvwFN24W5&_nc_oc=AdprDoJaTlxdrnyZsraliaZBdqsWrNYbTD7Hra898yCRsMHKBO0CzxAqWd_MgJf57OI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ6cfIZVU8X9Ia4qZjvqp0LU5h7Uhcma3IRtdzNKdB-Gw&oe=6AB7E72F"}, "display_name": "Mystery Box VR: Hidden Secrets", "keywords": [], "long_description": " AN IMMERSIVE VR PUZZLE EXPERIENCE\nInteract with objects, handles, buttons, and wheels on each side. Crack enigmas and collect hidden puzzle tiles on a random side of the boxes.\n\nYou won't be able to compare reality with fiction.\n\n# DISCOVER INVENTIONS\nOnce you unlock all 8 boxes of a Level Pack, you can compose a puzzle and discover a brief history of an invention.\n\nIt's not always easy to escape the room, so use all your IQ to crack the riddles. There's a logic behind all of them, even where it seems it's not!\n\n# IMMERSIVE SOUNDTRACK\nPlay the game with your headphones to get immersed in this amazing adventure.\n\n# HINTS\nGot stuck on some enigma? No worries, you can still get a helpful hint! You can also get in touch with me in case you really can't make it through a riddle, I'll be glad to help ;)\n\n# MULTILANGUAGE\nAvailable in English, French, Italian, German, Spanish, Russian, and Japanese.\n\nThe game language will change automatically based on the language settings of your device", "short_description": "A VR escape room game where you have to solve intriguing riddles to open boxes and discover nice stories about popular inventions!"}, {"images": {"nodes": [{"file_name": "$R36BSY5.png", "id": "3678762505771822", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031430_3678762509105155_2151975047074617165_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FUhudNTv87kQ7kNvwGOJLnA&_nc_oc=Ado94bElW0JP4zQRU-357MxQzkQnxpofdfaVzk0oyQJs2X0v3YHmRpyDLyny5MfMXJQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLEo2nFS408r-Ui0M4NI0xDZexE7XJ1qTRXreZPaEVhog&oe=6AB7E325"}, {"file_name": "$R81V725.png", "id": "2720695481426567", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75262743_2720695484759900_604086922326600035_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mID2rYPM-ycQ7kNvwFReGvM&_nc_oc=Adq5Ke8521ZVdbvArvox4zDnfa0TJhowML8c6Q_DYqg807GQbqtNnyfHoZCtwA8JJrQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKkF0Cvh-RU9ynCnfm4slwvdYVFjlstARQfAO5IagZdBA&oe=6AB7E20D"}, {"file_name": "$RQ3SN6U.png", "id": "1552311425628973", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982519_1552311428962306_1218130395049083834_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U9KL9ecHVVIQ7kNvwHcRk57&_nc_oc=AdobjH54vF1lVRZSp4_EOQ9TVu-IppJSpecixLC-hYr-FsEG9XaCJ38n1iv1WKyliNc&_nc_zt=3&_nc_ht=
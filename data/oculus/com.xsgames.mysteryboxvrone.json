RCWm4LIHZgsC5XaIZwzXQew5KGnjmkB_osTb-dxx5biA&oe=6AEDEEC4"}, {"file_name": "5.png", "id": "467916352871409", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39003282_467916356204742_1871921057092171900_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4qKfki0MVLUQ7kNvwE1ZWMi&_nc_oc=Adrv9fKmdHmeUmi9jaEvy8McvE1iWyiD-E7Fbgpye8aaytahliX3EaAyCzrstR3a9hI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSsxuztVEsYgdLhU45Pwvz4iFKokqWIIiH8c3G_nbdsMA&oe=6AEE0BA2"}, {"file_name": "3.png", "id": "1934382610375855", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974473_1934382613709188_7156337812617042679_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wX1617g0PDgQ7kNvwFsyXAP&_nc_oc=AdrCJrtX6_yfefae8rBlrIfeSNB0kt2eQeo58VgJ6D-BAyz92KhHVyAI_Ona_S_ARY8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTqxKUehV-NjDOYhKwOnuB_ZkMMmPpFrHkBynMxV5Lw0A&oe=6AEDF5B3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape.png", "id": "1524760081483769", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974531_1524760084817102_6497712644828891067_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e2CiPTxN7lsQ7kNvwESgx_G&_nc_oc=AdqQmApFzsyrRe1lv92v29YtuqkeOj4EHjUo_zof3yP7CFPjN99TqAU115_EYpZs2Z4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSl9wuyqC1LSIx8UnJufLoPFy6ZbS9ZkpENylE3kaT1kw&oe=6AEDF4AF"}, "display_name": "Mystery Box VR: Hidden Secrets", "keywords": [], "long_description": " AN IMMERSIVE VR PUZZLE EXPERIENCE\nInteract with objects, handles, buttons, and wheels on each side. Crack enigmas and collect hidden puzzle tiles on a random side of the boxes.\n\nYou won't be able to compare reality with fiction.\n\n# DISCOVER INVENTIONS\nOnce you unlock all 8 boxes of a Level Pack, you can compose a puzzle and discover a brief history of an invention.\n\nIt's not always easy to escape the room, so use all your IQ to crack the riddles. There's a logic behind all of them, even where it seems it's not!\n\n# IMMERSIVE SOUNDTRACK\nPlay the game with your headphones to get immersed in this amazing adventure.\n\n# HINTS\nGot stuck on some enigma? No worries, you can still get a helpful hint! You can also get in touch with me in case you really can't make it through a riddle, I'll be glad to help ;)\n\n# MULTILANGUAGE\nAvailable in English, French, Italian, German, Spanish, Russian, and Japanese.\n\nThe game language will change automatically based on the language settings of your device", "short_description": "A VR escape room game where you have to solve intriguing riddles to open boxes and discover nice stories about popular inventions!"}, {"images": {"nodes": [{"file_name": "$R36BSY5.png", "id": "3678762505771822", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031430_3678762509105155_2151975047074617165_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NCIl_6hxvKgQ7kNvwF10Fo2&_nc_oc=Ado7m9K2uX7WQh8xoCw_IYHFCjHvKsTbb21i7TXZZnaLdYUI8gonhw6u3kbRlFROKoI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR87rCC4HcO2-lTV-wDiOrJthAv2-V3JO8cQ0Wt4rmLyA&oe=6AEDF0A5"}, {"file_name": "$R81V725.png", "id": "2720695481426567", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75262743_2720695484759900_604086922326600035_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=62DWBcgDEjAQ7kNvwFRn-QO&_nc_oc=AdoFD5wv9tsm0vd8vrL12M_3Zfch2NhzIjh16acNrzwbiEM_g9OVu_fBWksYp6-1jzM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT1lb2hTOUd4m4l4KX5l5L-a9ZASTY3NJCnnn0n8ZQWpA&oe=6AEDEF8D"}, {"file_name": "$RQ3SN6U.png", "id": "1552311425628973", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982519_1552311428962306_1218130395049083834_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AnPUsIlYtIwQ7kNvwEnB6iR&_nc_oc=AdrAI4JtE2dZiMnIvF2mpUREoYmYVpJl7HJlUG8XRTpX2g-L-_LCBwrbPjMCTQMwaeY&_nc_zt=3&_nc_ht=
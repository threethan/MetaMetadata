EeDCBV7DkHeRAwTXXTJjsaHjoIAyhcsQdzTvE5v5vcYg&oe=6A941084"}, {"file_name": "5.png", "id": "467916352871409", "uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/39003282_467916356204742_1871921057092171900_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tcPqwkcqiHUQ7kNvwECZK5X&_nc_oc=AdoTR23Qu0ZDg15zFCnnKpNyQy6TebtQDTqUoz0qtL9SU1vgV9ESptR9KoD-cMYZYos&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEHAxuXl5hziR7ZGZk-ag2XnBjaH-FhuBCtmWytsYfdEg&oe=6A942D62"}, {"file_name": "3.png", "id": "1934382610375855", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/38974473_1934382613709188_7156337812617042679_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wkfSq0-TOhgQ7kNvwFsE1R-&_nc_oc=Adqrx2PnTff57CK2dKxMDdYn9X3wnD7tnmxH1_56UxjJ2E4kxyOWqu6jrsIrE7K_U4Y&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFSUEKKYeDyj3nyoVlCib7SketfQdYZ-3y26-fozYt1ww&oe=6A941773"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape.png", "id": "1524760081483769", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/38974531_1524760084817102_6497712644828891067_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QfSgZ0VQfcEQ7kNvwFW7cAj&_nc_oc=AdoeUU5ftC9HMtg7J4yKkmJk-2cljh2JlrJn0TIbRGFAcqaKiDyvDPZ2MVymyErPHD8&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFSzSDm3hQmbdtyRcJtysM2RDua-KPxf87EaPbpN5yYWQ&oe=6A94166F"}, "display_name": "Mystery Box VR: Hidden Secrets", "keywords": [], "long_description": " AN IMMERSIVE VR PUZZLE EXPERIENCE\nInteract with objects, handles, buttons, and wheels on each side. Crack enigmas and collect hidden puzzle tiles on a random side of the boxes.\n\nYou won't be able to compare reality with fiction.\n\n# DISCOVER INVENTIONS\nOnce you unlock all 8 boxes of a Level Pack, you can compose a puzzle and discover a brief history of an invention.\n\nIt's not always easy to escape the room, so use all your IQ to crack the riddles. There's a logic behind all of them, even where it seems it's not!\n\n# IMMERSIVE SOUNDTRACK\nPlay the game with your headphones to get immersed in this amazing adventure.\n\n# HINTS\nGot stuck on some enigma? No worries, you can still get a helpful hint! You can also get in touch with me in case you really can't make it through a riddle, I'll be glad to help ;)\n\n# MULTILANGUAGE\nAvailable in English, French, Italian, German, Spanish, Russian, and Japanese.\n\nThe game language will change automatically based on the language settings of your device", "short_description": "A VR escape room game where you have to solve intriguing riddles to open boxes and discover nice stories about popular inventions!"}, {"images": {"nodes": [{"file_name": "$R36BSY5.png", "id": "3678762505771822", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/39031430_3678762509105155_2151975047074617165_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ePnWJJptdSMQ7kNvwEEhUUQ&_nc_oc=Adp0_UDhOz9Vat2yOGFdhZZTx7wYcKvjsIowM9cqP0WMhEka4uw8O75MOeNkZAfxDZI&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEfvM_6QZpaTmi0Kiuro89jwVeNzFPwJbwCJwtl59uE_A&oe=6A941265"}, {"file_name": "$R81V725.png", "id": "2720695481426567", "image_type": "APP_IMG_ICON", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/75262743_2720695484759900_604086922326600035_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jsG7AtjjXYEQ7kNvwF_5GBs&_nc_oc=Adq1W14coR6X9cIM_cybjGk8FmdQRSMt4oJXBc8Z6mVGx3tvGTLm42YbPORWvQRbSig&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHtSPSHe9dnqxSh4izXt6WxZmpHtQuXgb5ez1VAhS9BIQ&oe=6A94114D"}, {"file_name": "$RQ3SN6U.png", "id": "1552311425628973", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/38982519_1552311428962306_1218130395049083834_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RroGpL4EAcQQ7kNvwH-93Eh&_nc_oc=AdqKQxGBCItgtUuwpiBaIFvwHhS0WY-0oPaB4w1c0PK6IWCStypiOYb33eo-7HqDHOc&_nc_zt=3&_nc_ht=
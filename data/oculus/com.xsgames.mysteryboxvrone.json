7_6079827820297623902_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hqEuGjWc_YkQ7kNvwE9uVY4&_nc_oc=AdmKOsPpQRFBVCMnzmqVMy2IUsKHFPbqaNTY-_D3FfOr7wgF1R-YRZMMKqWTDED143o&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&oh=00_Afv9lAOtlhpGx32G_bqQugoD1iyKaakf6WFhc0yrQ0nT7g&oe=699850F2"}, {"file_name": "ml.png", "id": "758804276241553", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/86627649_758804279574886_1746818431198727649_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QBm_MQ2oCPMQ7kNvwH0o2s-&_nc_oc=AdksI9OazqhDNh-oaige4x9KOqCsUjr6Csf_KnHXlFghG976xU6iNH5KctWLxWnABUc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&oh=00_Aft9qC7MzeQTkjUzXWs0ZzBw9V7OpAQW_72U2Z38-Oc57A&oe=69986247"}, {"file_name": "$RWJKXUS.png", "id": "406345889120457", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974920_406345892453790_2806525102226368153_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cK07sQvx3qEQ7kNvwEEnOoZ&_nc_oc=AdldITkiVyK53KTmExIXxH0YnB4g6nvDASiS8GYneo2VzwK_Z2mSQFHLtzo9uX128bM&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&oh=00_AfvFRb2jUIWTTgxpL9V0qVJZ4iMz1DJgTGWsWBWpdDL9SQ&oe=69986EB8"}]}, "id": "476818348415672", "locale": "it_IT", "screenshots": [{"file_name": "4.png", "id": "499755402636525", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39035304_499755405969858_5224076533156194641_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=arSZ1uvtjacQ7kNvwETA_D8&_nc_oc=AdlXxa71T5R0KjC6nTCwvmMci9FfhKbYFKkOafZ-Tv77TV0W9A_JJHOr_EgbduSW474&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&oh=00_AfsgSH0Onax23FArF4ue1p-LsF9A9yStQxIV-SM8IH6vKA&oe=69986F98"}, {"file_name": "1.png", "id": "996476465820891", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/57574726_996476469154224_2905129728707462238_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ei1pDF0lBkcQ7kNvwGfJV9v&_nc_oc=AdlEDzF3mqhfOyyKJPV0HRNZA8nuyxjgHURE_3L1MoQ0Fqn8FyBJQfLK65811qGLXBI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&oh=00_AfuZEOr5QL_xavUYMX0nDt2bGueO6sMQYYR8XKYfxc6Zww&oe=69986AC8"}, {"file_name": "2.png", "id": "2203761473315962", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75469623_2203761476649295_9180026026436178997_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Zshsifm1T-UQ7kNvwEptsKi&_nc_oc=AdkOuKT-ZSCDM80mcGZ7L_RU_x2TgzNi0A8r26I0_9VA7tMbJOFc4KXlgoDUW03skWs&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&oh=00_AfvbcRWY-dgfmCvifW8pn-qthk3vdA4cvuaGTuw9Q3YG4Q&oe=69985FF1"}, {"file_name": "5.png", "id": "1600206790893068", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974920_1600206794226401_7626143159008067194_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IWFvePZatkIQ7kNvwEAbcUr&_nc_oc=AdnsxWB-iVp4pH3__TU6vVgWqC7z_i25BWaUiCtfRwWHjv9TD0fiDoD97BShePQHPKU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&oh=00_AfvhLR1TF_1mMoAxdhtHT9p4okpFTbrilI8Zv_OWuzVBNA&oe=69986C8A"}, {"file_name": "3.png", "id": "1053463469622332", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75395599_1053463472955665_4671093965273907425_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FouT603twBQQ7kNvwGGeRWv&_nc_oc=Admc1hDioSEWoN5yyVhjYfyMuaIER5vcXZAf0xXDpKtCvhEMIz4ThKTrIe7UMdjka1I&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&oh=00_AfvE8dHSlOFR-6__Lewk-P5YP0fabqYhhzcSQA4hJBLx-A&oe=69985FEE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape.png", "id": "827399829365065", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75262743_827399832698398_2324097237178561690_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G7d-wS_XbT8Q7kNvwG_nCtJ&_nc_oc=AdnT9VQeDAqjGuqnN3R67MpbKmsv3OVY0GiuuNmYfK4c6dVxU4JRLylosdX7QSiMARg&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&oh=00_AftGGtj93eigFU9Cgz95N1OGkc3mMCu4ORNNvsh-634BqQ&oe=69986F0F"}, "display_name": "Mystery Box VR: Hidden Secrets", "keywords": [], "long_description": "# UN'ESPERIENZA DI GIOCO UNICA\nInteragisci con oggetti, maniglie, pulsanti e ruote su ciascun lato. Risolvi gli enigmi e raccogli le tessere del puzzle nascoste su un lato casuale delle scatole.\n\n# SEMBRA COS\u00cc REALE!\nNon sarai in grado di confrontare la realt\u00e0 con la finzione.\n\n\n# SCOPRI LE INVENZIONI\nUna volta sbloccate tutte le 8 caselle di un pacchetto livelli, puoi comporre un puzzle e scoprire una breve storia di un'invenzione.\n\n\n# PENSA FUORI DAGLI SCHEMI\nNon \u00e8 sempre facile fuggire dalla stanza, quindi usa tutto il tuo QI per risolvere gli enigmi. C'\u00e8 una logica dietro a tutti, anche dove sembra che non lo sia!\n\n# AUDIO D'ATMOSFERA\nGioca con le cuffie per immergerti in questa fantastica avventura.\n\n# ]SUGGERIMENTI DISPONIBILI\nSei rimasto bloccato su qualche enigma? Nessun problema, puoi comunque ricevere un suggerimento utile! Puoi anche contattarmi nel caso in cui davvero non riesci a risolvere un indovinello, sar\u00f2 felice di aiutarti ;)\n\n\n# SUPPORTO MULTILINGUA\nDisponibile in inglese, francese, italiano, tedesco, spagnolo, russo e giapponese.\n\nLa lingua del gioco cambier\u00e0 automaticamente in base alle impostazioni della lingua del tuo dispositivo", "short_description": "Un gioco VR di escape room in cui devi risolvere enigmi intriganti per aprire scatole e scoprire simpatiche storie su invenzioni popolari!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://xsgames.co/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "XSGames", "support_website_url": null, "website_url": "https://xsgames.co/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor"
BWn0szv2YHK3dbkPh3egJOegTPUj-rJQcm1q3k9Fe_yQ&oe=6A492344"}, {"file_name": "5.png", "id": "467916352871409", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39003282_467916356204742_1871921057092171900_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2y8uKbGcf5IQ7kNvwGdC1Nf&_nc_oc=Adrcm8neegzd4by2YcAKDaiiuJ_BSmnL_vCW2s17NAjZirHLz4QxQSKSVSadE4P68_g&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBfMuggYXpctncBhJxScJCMLnL-acUgpm-hVUUVuMxEUQ&oe=6A4907E2"}, {"file_name": "3.png", "id": "1934382610375855", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974473_1934382613709188_7156337812617042679_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1tcL5KkxqKAQ7kNvwH0B8k-&_nc_oc=Ado4OSPoS_ttDFh1Y2p85OJsouHRU3-ediAjvZxfrJT4pmQ1uSVt7wgo3goMH2ki2Bw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDVjJzJdojlz_pa8mODTcFNd2UjZxDNV48kr7jSjqDbFg&oe=6A492A33"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape.png", "id": "1524760081483769", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974531_1524760084817102_6497712644828891067_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P0-xFnl4IacQ7kNvwGoy36U&_nc_oc=AdrriOgOevZw_drDiMtZgEbYYWztLzABvyFqL7YBnxlg4-nvsVqA-EG5jDLCBrc1lJM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA9i2ArKIYa5Omjgl1hxoasJgieTIu6zXAEwI3kR0G98w&oe=6A49292F"}, "display_name": "Mystery Box VR: Hidden Secrets", "keywords": [], "long_description": " AN IMMERSIVE VR PUZZLE EXPERIENCE\nInteract with objects, handles, buttons, and wheels on each side. Crack enigmas and collect hidden puzzle tiles on a random side of the boxes.\n\nYou won't be able to compare reality with fiction.\n\n# DISCOVER INVENTIONS\nOnce you unlock all 8 boxes of a Level Pack, you can compose a puzzle and discover a brief history of an invention.\n\nIt's not always easy to escape the room, so use all your IQ to crack the riddles. There's a logic behind all of them, even where it seems it's not!\n\n# IMMERSIVE SOUNDTRACK\nPlay the game with your headphones to get immersed in this amazing adventure.\n\n# HINTS\nGot stuck on some enigma? No worries, you can still get a helpful hint! You can also get in touch with me in case you really can't make it through a riddle, I'll be glad to help ;)\n\n# MULTILANGUAGE\nAvailable in English, French, Italian, German, Spanish, Russian, and Japanese.\n\nThe game language will change automatically based on the language settings of your device", "short_description": "A VR escape room game where you have to solve intriguing riddles to open boxes and discover nice stories about popular inventions!"}, {"images": {"nodes": [{"file_name": "$R36BSY5.png", "id": "3678762505771822", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031430_3678762509105155_2151975047074617165_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MdtFJHqOlJIQ7kNvwG7GL2b&_nc_oc=Adr8iEZfDZXg5SeQpuov_xGqS-A6YuQ4QNOcWoCF364EICi9y3IATaK0KW6RsWYSVPE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB6dqnYS8xj4MWGjloxhRvkwMdKu3vGrq26ggBvjFZU7A&oe=6A492525"}, {"file_name": "$R81V725.png", "id": "2720695481426567", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75262743_2720695484759900_604086922326600035_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ROjyII5sDLgQ7kNvwGF5N6S&_nc_oc=AdqTo2S5QwOOsOsQOhpGL6ebAC3jJDOOkc4vQ4yQ_ygkpni6Ix8GbOXZPMdOQSwN5bc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDM9fYB7tSN-NwZ3eK0tRxRkWY391RTPzRzkvstezDqwg&oe=6A49240D"}, {"file_name": "$RQ3SN6U.png", "id": "1552311425628973", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982519_1552311428962306_1218130395049083834_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CsH5IP9sg3YQ7kNvwFIG8QG&_nc_oc=Adokz2Vx2oC1YhOSR8iwk01VTBivXvXg4NHCVVeIT2Obo_5ewYAbVdUBCD1oizynbbs&_nc_zt=3&_nc_ht=
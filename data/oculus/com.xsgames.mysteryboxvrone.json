UjVA&oe=699DA4E2"}, {"file_name": "3.png", "id": "1934382610375855", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974473_1934382613709188_7156337812617042679_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tYL9Qt5kFLMQ7kNvwFX0qG5&_nc_oc=Adn21c0MwIkzvnfdhZDg9fuh_x1_BjAmATszNVwDPhc1W6BohDgtwytrYYUPhSCgfIE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfsZZjc_tJ6l_1xhypgYUD7zsro7NUXtxDiblrldGyJqGg&oe=699D8EF3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape.png", "id": "1524760081483769", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974531_1524760084817102_6497712644828891067_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1knUNwNtwr4Q7kNvwH65mt6&_nc_oc=AdmTeV38VKK2oHGFMLncw6Yz6T8gBaQqVZWIv6K61m8vccxcOY7bHZZvnTDIw2yis5o&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfubyaxPf_LYJDGBJBFtB1E-J7g3DQESP5ZAdB_ELGBing&oe=699D8DEF"}, "display_name": "Mystery Box VR: Hidden Secrets", "keywords": [], "long_description": " AN IMMERSIVE VR PUZZLE EXPERIENCE\nInteract with objects, handles, buttons, and wheels on each side. Crack enigmas and collect hidden puzzle tiles on a random side of the boxes.\n\nYou won't be able to compare reality with fiction.\n\n# DISCOVER INVENTIONS\nOnce you unlock all 8 boxes of a Level Pack, you can compose a puzzle and discover a brief history of an invention.\n\nIt's not always easy to escape the room, so use all your IQ to crack the riddles. There's a logic behind all of them, even where it seems it's not!\n\n# IMMERSIVE SOUNDTRACK\nPlay the game with your headphones to get immersed in this amazing adventure.\n\n# HINTS\nGot stuck on some enigma? No worries, you can still get a helpful hint! You can also get in touch with me in case you really can't make it through a riddle, I'll be glad to help ;)\n\n# MULTILANGUAGE\nAvailable in English, French, Italian, German, Spanish, Russian, and Japanese.\n\nThe game language will change automatically based on the language settings of your device", "short_description": "A VR escape room game where you have to solve intriguing riddles to open boxes and discover nice stories about popular inventions!"}, {"images": {"nodes": [{"file_name": "$R36BSY5.png", "id": "3678762505771822", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031430_3678762509105155_2151975047074617165_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IfDq_Odo1UcQ7kNvwEJNpRf&_nc_oc=AdkM3V1sVGreWhQiuRE_nPnuWda9SNfxjR0c8YaLZHmN0iGJ8VEwCaM1kqPOtM0obhU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afv5Jf-G_nZMko8tFFpRcRrvga_j_Q5Y5ygacRFFg0WQyA&oe=699D89E5"}, {"file_name": "$R81V725.png", "id": "2720695481426567", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75262743_2720695484759900_604086922326600035_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kZGlZmAc9LQQ7kNvwGxkTFg&_nc_oc=Adk-lY-ELBo-aPPhBwQNSZKcpmvjurt8bfQXsvV9_xUy0_Hed0N0MZaibwMJ-0QSqhk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afteee_36elImS8APUF31_TFn4QXWtFcEK-5KwTqqbq5YA&oe=699D88CD"}, {"file_name": "$RQ3SN6U.png", "id": "1552311425628973", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982519_1552311428962306_1218130395049083834_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j3rdhixELg4Q7kNvwEdhRVL&_nc_oc=Adm4aUu4p_w8nq53psw5NR-NeMeb748ovfLT9DggRlwS9GMdVKhwEHitEIqSeSY7UjQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfsJMhHloERMlBe_dC6-xqZmceeBK2Q7eOc5gZiV3T42aw&oe=699D9429"}, {"file_name": "38982645_1000853181732648_5055517427829171192_n.png", "id": "1043990680394008", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031625_1043990683727341_3557431131423146005_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DJdq8G5f7B8Q7kNvwFmHs-l&_nc_oc=AdnsrhrFLCZlhrBHIwUQw6_uNq0s8ACLLCj0-NzTtlOHoL4ZAH_70cITWKqqxr8pBRk&_nc_zt=3&_nc_ht=scontent-iad3-1
DYOhuO_JwGWnBQ2wk09cfnAYmuB_fgOrC4t4LxeZ5_4A&oe=6A510C44"}, {"file_name": "5.png", "id": "467916352871409", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39003282_467916356204742_1871921057092171900_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fcfN-MiXhCUQ7kNvwGVNVdd&_nc_oc=AdoH9QjJgJC2BFubr3xKxmfB_uCVEMIbBBsoS2RTVa71NgdZ04ygo_uWsG0HZVxONJ4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBYL4wqH1JIGR9QbI4iROIEYRWk52grgAMAkFa0HC1JUA&oe=6A50F0E2"}, {"file_name": "3.png", "id": "1934382610375855", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974473_1934382613709188_7156337812617042679_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VJr4eAy-PkIQ7kNvwEeV95_&_nc_oc=AdowLac79dq00qsm_41RADSGtrHt9hdSTB1MRs91N95OowaI4QDb2YBV_azFl4YbNVI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAk6FIEI_2I9KTjmp293_M7H_pJsxTfsLBb46h-LFUxtQ&oe=6A511333"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape.png", "id": "1524760081483769", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974531_1524760084817102_6497712644828891067_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=11cBqJpksPgQ7kNvwFaZK3C&_nc_oc=AdoOuwp3NCGedkmIyHLZqmuItDbRVWkZAZL4hdEYC7l5z8XHELG8pDNMlHRsup1duGs&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBArsGmzrfym9sU2CvEMfwQrAr2wYTSTi6JnNq9DXIAFQ&oe=6A51122F"}, "display_name": "Mystery Box VR: Hidden Secrets", "keywords": [], "long_description": " AN IMMERSIVE VR PUZZLE EXPERIENCE\nInteract with objects, handles, buttons, and wheels on each side. Crack enigmas and collect hidden puzzle tiles on a random side of the boxes.\n\nYou won't be able to compare reality with fiction.\n\n# DISCOVER INVENTIONS\nOnce you unlock all 8 boxes of a Level Pack, you can compose a puzzle and discover a brief history of an invention.\n\nIt's not always easy to escape the room, so use all your IQ to crack the riddles. There's a logic behind all of them, even where it seems it's not!\n\n# IMMERSIVE SOUNDTRACK\nPlay the game with your headphones to get immersed in this amazing adventure.\n\n# HINTS\nGot stuck on some enigma? No worries, you can still get a helpful hint! You can also get in touch with me in case you really can't make it through a riddle, I'll be glad to help ;)\n\n# MULTILANGUAGE\nAvailable in English, French, Italian, German, Spanish, Russian, and Japanese.\n\nThe game language will change automatically based on the language settings of your device", "short_description": "A VR escape room game where you have to solve intriguing riddles to open boxes and discover nice stories about popular inventions!"}, {"images": {"nodes": [{"file_name": "$R36BSY5.png", "id": "3678762505771822", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031430_3678762509105155_2151975047074617165_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LQYj8U7J2C4Q7kNvwHU1xjw&_nc_oc=AdpDoH0qRwHmTPL_h0waa05RHWteOLjFeHotgYBwFFES8eTt6K2fCEkUX_oFTUGu-sY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCJgMYwiWRItbwfJTs95oUsOQxPbEAURCl6wZy-hAdRTg&oe=6A510E25"}, {"file_name": "$R81V725.png", "id": "2720695481426567", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75262743_2720695484759900_604086922326600035_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_ekkGIZEWHIQ7kNvwHSUSbu&_nc_oc=Ado5A8bnVpHp2O09TbEfEHGOwCjyupH0fp8oQAlu4NF2BxOpCqD0nwgi-KJnGinrLJo&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCNTub8-vulKWZsHX7A4ojkeNvMmhVHsVAQuVwepXtGlQ&oe=6A510D0D"}, {"file_name": "$RQ3SN6U.png", "id": "1552311425628973", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982519_1552311428962306_1218130395049083834_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O_sHojBB8OkQ7kNvwFHk_G9&_nc_oc=AdpD-UJyRpV01cY7jP-MlovTYgngNNZBBnXXSOnIwihviOUgrP9kH0vVFcoJJgERIsQ&_nc_zt=3&_nc_ht=
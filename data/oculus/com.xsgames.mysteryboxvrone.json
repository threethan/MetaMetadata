A37ub13Z_rOI7v2-Uu2QFb5WzTRgNrmXQH3tPwSjN5hA&oe=6A69E084"}, {"file_name": "5.png", "id": "467916352871409", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39003282_467916356204742_1871921057092171900_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QvvQN8Tao1sQ7kNvwFgsxTT&_nc_oc=AdpmWmZ-wk1oBmR5Wn34T2TtTSTpiJjjAVK253RI29BQn1YepkMxhJ9QXYHRt-DSbCk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDMsnjLxXlJ8p6wLpc-RfMMYLbvGqNoB-sSxdEIx9nLpA&oe=6A69FD62"}, {"file_name": "3.png", "id": "1934382610375855", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974473_1934382613709188_7156337812617042679_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KOYiLY0m3k4Q7kNvwEcuMV7&_nc_oc=AdqJW7N5lsd4EwR6OSw7T-DDb2Uk-lN-V0YZmZAy6BeCnGQGvQuPtNuFQEZRKq7FEbU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCmPVRnKN1gWvuqHNYiEXmXeSpwQDry1E-tyCIs1tsU3Q&oe=6A69E773"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape.png", "id": "1524760081483769", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974531_1524760084817102_6497712644828891067_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mQrlYBu0Y1YQ7kNvwFkt6ml&_nc_oc=Adq6peOlhGKyZDXENDbOCsCzbghBsQmSVXisPFEkqcGONoaV-Os_VxPiSabT5gBmHQ0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAN-CZ2yTffnYRe8V6Ye0_OiI6z8ovdrF6jH83Q-x904w&oe=6A69E66F"}, "display_name": "Mystery Box VR: Hidden Secrets", "keywords": [], "long_description": " AN IMMERSIVE VR PUZZLE EXPERIENCE\nInteract with objects, handles, buttons, and wheels on each side. Crack enigmas and collect hidden puzzle tiles on a random side of the boxes.\n\nYou won't be able to compare reality with fiction.\n\n# DISCOVER INVENTIONS\nOnce you unlock all 8 boxes of a Level Pack, you can compose a puzzle and discover a brief history of an invention.\n\nIt's not always easy to escape the room, so use all your IQ to crack the riddles. There's a logic behind all of them, even where it seems it's not!\n\n# IMMERSIVE SOUNDTRACK\nPlay the game with your headphones to get immersed in this amazing adventure.\n\n# HINTS\nGot stuck on some enigma? No worries, you can still get a helpful hint! You can also get in touch with me in case you really can't make it through a riddle, I'll be glad to help ;)\n\n# MULTILANGUAGE\nAvailable in English, French, Italian, German, Spanish, Russian, and Japanese.\n\nThe game language will change automatically based on the language settings of your device", "short_description": "A VR escape room game where you have to solve intriguing riddles to open boxes and discover nice stories about popular inventions!"}, {"images": {"nodes": [{"file_name": "$R36BSY5.png", "id": "3678762505771822", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031430_3678762509105155_2151975047074617165_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yktsoRUXY78Q7kNvwF4vjGl&_nc_oc=AdrqF7eDY-jNDlTQQ8yik98_ERCOsABxVLe74NqE_TAGSDUvL-fIzz6y4mM23t1i82o&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC1hvG0y6nQCpfca22W8R5tx0m17B_HI75a8D7hP8kofQ&oe=6A69E265"}, {"file_name": "$R81V725.png", "id": "2720695481426567", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75262743_2720695484759900_604086922326600035_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tcljYjz-edoQ7kNvwEctt_3&_nc_oc=AdpSCX746vA8hnytchggsd4t60JcBbXfTDYflkJSqbcSnBymukTna20GWsh_KZ_r9Ho&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCybg09GeH8oW29O_HNfVN3SYQAxGKwmICFomhbVJSdkA&oe=6A69E14D"}, {"file_name": "$RQ3SN6U.png", "id": "1552311425628973", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982519_1552311428962306_1218130395049083834_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ekVuDoUbgFoQ7kNvwF1dJyk&_nc_oc=AdpROq_DcBcmYNStUNE_KwlWZrfiei-xkXFvM4FiV3gdPeql2LltZBLhfcLPyRrV9BE&_nc_zt=3&_nc_ht=
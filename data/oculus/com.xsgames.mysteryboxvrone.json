ErqKFlN2nkWjaEWA7uT8yT1f51F0kZ3HsZ1zS27YK6tw&oe=6A7201C4"}, {"file_name": "5.png", "id": "467916352871409", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39003282_467916356204742_1871921057092171900_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-2-C91txbOEQ7kNvwFnSulm&_nc_oc=AdpYTTa-YT2qZ_Nk2WLqxCMK4jvQlsqh9EHQ1-3LIjXcnTSySPnRBggRCdGm8gMTzC0&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGCIRn-YVO0mtcgqeY-WTR93hxva7a3V11B10KymD6cdw&oe=6A71E662"}, {"file_name": "3.png", "id": "1934382610375855", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974473_1934382613709188_7156337812617042679_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ifFPPSONnIkQ7kNvwGtTYwx&_nc_oc=AdpJid_Jz0UHAFdK4ttDIcNHGsCI4udgjfMfj3dTW3J6j_vOaiPuXSyXQyut7MoR9DE&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFxMKDl2lqd84_FD90vRYIFCwld5oIWBLJxWqRji2_NpQ&oe=6A71D073"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape.png", "id": "1524760081483769", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974531_1524760084817102_6497712644828891067_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WOS5dWZWEr8Q7kNvwGmLwOr&_nc_oc=AdqSHGhVK_ejPMcgnS2CBcx8GIQtX2YRkA-gwBTrpdTrLCq1oYuLNwbGkbIrgKh9hhw&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG0ibjvmvgb772OZIXliE7nejioGaHgllj8glVp_b0ZgA&oe=6A71CF6F"}, "display_name": "Mystery Box VR: Hidden Secrets", "keywords": [], "long_description": " AN IMMERSIVE VR PUZZLE EXPERIENCE\nInteract with objects, handles, buttons, and wheels on each side. Crack enigmas and collect hidden puzzle tiles on a random side of the boxes.\n\nYou won't be able to compare reality with fiction.\n\n# DISCOVER INVENTIONS\nOnce you unlock all 8 boxes of a Level Pack, you can compose a puzzle and discover a brief history of an invention.\n\nIt's not always easy to escape the room, so use all your IQ to crack the riddles. There's a logic behind all of them, even where it seems it's not!\n\n# IMMERSIVE SOUNDTRACK\nPlay the game with your headphones to get immersed in this amazing adventure.\n\n# HINTS\nGot stuck on some enigma? No worries, you can still get a helpful hint! You can also get in touch with me in case you really can't make it through a riddle, I'll be glad to help ;)\n\n# MULTILANGUAGE\nAvailable in English, French, Italian, German, Spanish, Russian, and Japanese.\n\nThe game language will change automatically based on the language settings of your device", "short_description": "A VR escape room game where you have to solve intriguing riddles to open boxes and discover nice stories about popular inventions!"}, {"images": {"nodes": [{"file_name": "$R36BSY5.png", "id": "3678762505771822", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39031430_3678762509105155_2151975047074617165_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-SQd8dFjRWMQ7kNvwESyDvM&_nc_oc=AdqDKsWTFUgXBgo_7pBDC3eIyAImw-XIiciviXOWme_TKQAcbXSoukjHPjXUIySdT3o&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHVHn8miOdXHNrkBODzGCzuSdSMGX5v2KvI1xP3oiRIhg&oe=6A7203A5"}, {"file_name": "$R81V725.png", "id": "2720695481426567", "image_type": "APP_IMG_ICON", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/75262743_2720695484759900_604086922326600035_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T0TQXPqI-cMQ7kNvwEV1JnY&_nc_oc=AdrjK0Kj5TMos6V4vCyj051vEBNaZplcGOoD8BYiHo6k-Q_hmlEjs1aEaDebqsob0Nw&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHtFFtA1Q69dZmoqmy87HjxXG5G_Q-ghQMwNIuc0LdhXg&oe=6A72028D"}, {"file_name": "$RQ3SN6U.png", "id": "1552311425628973", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38982519_1552311428962306_1218130395049083834_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T47td3dzGmwQ7kNvwGcb-6G&_nc_oc=AdqYuBVfJq2cgf-4g9xmMF0chzu4C3XJmzvh-mGB23AW15rFVNAu5NyZ2uYy-5csa9Y&_nc_zt=3&_nc_ht=
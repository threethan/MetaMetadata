0DEJ_r8aJsFmmEQ5ryGtbXB3xopuVb8yPVLTWvdZ0m7g&oe=69F614C4"}, {"file_name": "5.png", "id": "467916352871409", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/39003282_467916356204742_1871921057092171900_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PvT-cwi-sIYQ7kNvwErmd2i&_nc_oc=AdqRQLZvexuVIN7D7FZcei3cr5MwXLlDYgJDSwdgJWSobRw6PuRu9p_HXoaYFOhjFcE&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af33Z7gGgCn4cfg7v33cLk0N9HDQh5c9Au0xdmWySP7AaQ&oe=69F5F962"}, {"file_name": "3.png", "id": "1934382610375855", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/38974473_1934382613709188_7156337812617042679_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=croQcA-CEQ4Q7kNvwFZrWko&_nc_oc=AdrYXkoS2K9oCDtLgu3t7C5k7a6oxUSTMoGRWAvXX8qp1cvvPQx7aQqm1Ba7sW_FLvA&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1odlVv2SlzOGi6holS5cxqMCB8QFGDnkqiScWrGWeDGQ&oe=69F61BB3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape.png", "id": "1524760081483769", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/38974531_1524760084817102_6497712644828891067_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UP51b_7NTokQ7kNvwHi_H6H&_nc_oc=AdodjhJlW4S_IyWdKw_VGydb_A7DsG3x7NRZQjBbbD3r3lrpMXftUD_p0MH-7rBTGPU&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2oW0dumk0VO6e7EeCRxL1pt1EGY4zY25iCG5MhGeIEdw&oe=69F61AAF"}, "display_name": "Mystery Box VR: Hidden Secrets", "keywords": [], "long_description": " AN IMMERSIVE VR PUZZLE EXPERIENCE\nInteract with objects, handles, buttons, and wheels on each side. Crack enigmas and collect hidden puzzle tiles on a random side of the boxes.\n\nYou won't be able to compare reality with fiction.\n\n# DISCOVER INVENTIONS\nOnce you unlock all 8 boxes of a Level Pack, you can compose a puzzle and discover a brief history of an invention.\n\nIt's not always easy to escape the room, so use all your IQ to crack the riddles. There's a logic behind all of them, even where it seems it's not!\n\n# IMMERSIVE SOUNDTRACK\nPlay the game with your headphones to get immersed in this amazing adventure.\n\n# HINTS\nGot stuck on some enigma? No worries, you can still get a helpful hint! You can also get in touch with me in case you really can't make it through a riddle, I'll be glad to help ;)\n\n# MULTILANGUAGE\nAvailable in English, French, Italian, German, Spanish, Russian, and Japanese.\n\nThe game language will change automatically based on the language settings of your device", "short_description": "A VR escape room game where you have to solve intriguing riddles to open boxes and discover nice stories about popular inventions!"}, {"images": {"nodes": [{"file_name": "$R36BSY5.png", "id": "3678762505771822", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/39031430_3678762509105155_2151975047074617165_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FEhb-MZ-5bwQ7kNvwFOXSm5&_nc_oc=AdpeBaY4dA5tCpde9NjxWIdeEFzJFTeptTy6jw2QyTXPvlwOrvJ4AtZEwbcU8pLu9mE&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3gKB-N7kzgzeCMORJ3swzqh7UjJf9CsnCvgu4nAHbtlw&oe=69F616A5"}, {"file_name": "$R81V725.png", "id": "2720695481426567", "image_type": "APP_IMG_ICON", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/75262743_2720695484759900_604086922326600035_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CTPYwstLWbwQ7kNvwEIcuGX&_nc_oc=AdoekdPxKhLUPleBUwcYephAwjGEAbgegOifi4R3YJIMMyK3afweXLt3gKgIThogQCY&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0W3HEQp33HrP4LMfWSTvLHjHbZWrRIsHsYVwd7ttkz0g&oe=69F6158D"}, {"file_name": "$RQ3SN6U.png", "id": "1552311425628973", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/38982519_1552311428962306_1218130395049083834_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DAkLOXd4VcYQ7kNvwHa62AK&_nc_oc=AdoRkJxtSC1n2M4vut6S8ou5J0z_qs70sl8Y-1ANZb1rD5jSLTKpu4m5ft3jpUbT_wE&_nc_zt=3&_nc_ht=
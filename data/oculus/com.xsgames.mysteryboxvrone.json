934382610375855", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974473_1934382613709188_7156337812617042679_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xoQgwt4O4c4Q7kNvwGaP-fI&_nc_oc=Ado1wz4OfjKTyEiCyb8PeEqVf91BVqRlZyPPUPzVYy14ge82QfhaRR0IalWLR20p1l4&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRZd70naB_ws6DCHzLf_vUQtP3VMtFeL9ZMqAxrSgzr_w&oe=6B0B2EF3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape_coverart.png", "id": "897861905346420", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38982672_897861908679753_3996777238831042692_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JxmW-bvMny8Q7kNvwGGNF0m&_nc_oc=AdqSYLVU_EF-KFNZ46-ZjgToeRxWQU7KqwdDeH55Eor4Be14kcUbJRFlk3GnlvgD3uw&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRCt-HUh5cJF5ZxVPqdduBkZOXS9TeTZc61wuwXVt2xsQ&oe=6B0B316B"}, "display_name": "Mystery Box VR: Hidden Secrets Escape", "keywords": ["puzzle", "escape", "room", "trivia", "brainteaser"], "long_description": "# AN IMMERSIVE VR PUZZLE EXPERIENCE\nInteract with objects, handles, buttons, and wheels on each side. Crack enigmas and collect hidden puzzle tiles on a random side of the boxes.\n\nYou won't be able to compare reality with fiction.\n\n# DISCOVER INVENTIONS\nOnce you unlock all 8 boxes of a Level Pack, you can compose a puzzle and discover a brief history of an invention.\n\nIt's not always easy to escape the room, so use all your IQ to crack the riddles. There's a logic behind all of them, even where it seems it's not!\n\n# IMMERSIVE SOUNDTRACK\nPlay the game with your headphones to get immersed in this amazing adventure.\n\n# HINTS\nGot stuck on some enigma? No worries, you can still get a helpful hint! You can also get in touch with me in case you really can't make it through a riddle, I'll be glad to help ;)\n\n# MULTILANGUAGE\nAvailable in English, French, Italian, German, Spanish, Russian, and Japanese.\n\nThe game language will change automatically based on the language settings of your device", "short_description": "Crack awesome puzzles around many boxes, and discover the history of the world's most popular inventions!"}, {"images": {"nodes": [{"file_name": "logoTransparent.png", "id": "3812261432362188", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974562_3812261435695521_5176404439574971225_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Wx_qUPIukYQQ7kNvwEO3phy&_nc_oc=AdqlG_h-gR6qCppVVRAvqjTBaoJEGDNUAcawBELkDA63g4Hq6VSbuNFLxAG2hDy9Z7A&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRelxTH7dABEUosqlwP_PwemCpGP1PSYhM1j_E9PJLstA&oe=6B0B1F16"}, {"file_name": "portrait_coverart.png", "id": "1953342038506987", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38982581_1953342045173653_4906879878373922307_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Zv-Bi9REH_4Q7kNvwFriX8t&_nc_oc=AdpdEDL7rd05OWz9JQC4bR4wTi77wUKSfnVAjaozUIwQDaeduuOZ2_1jbznRdcGmUHc&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSijYYBPGYDpvx-bPuV0Lpxmy1SGMMa2KFRpKJXD2tmog&oe=6B0B403D"}, {"file_name": "landscape_coverart.png", "id": "1300403051139202", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/75462955_1300403057805868_2288822001409671177_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cMv0nF2Tr1gQ7kNvwGhv5PX&_nc_oc=AdocE0GMVe9TT2oLoP7FGsbb4NZfm-dWhYf1_rkkfEjwXez_7rv-7e-WtdBA9YL0cYE&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRQKTiykQBOykBP-lfJk6RBZC6CJZTYbg2JBiMSzYRV2A&oe=6B0B30E0"}, {"file_name": "square_coverart.png", "id": "914408640187392", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39036626_914408643520725_6339598287132
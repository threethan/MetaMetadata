7UyGgICAT5h0mNmvK9NZNFifls9x6OEdR_ZoAp8mKnqw&oe=69FB5AC4"}, {"file_name": "5.png", "id": "467916352871409", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39003282_467916356204742_1871921057092171900_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nyyUHmJAcX0Q7kNvwFnKXFo&_nc_oc=AdpWFRHQ3T6mng0wVV-23iIovs994ZCo-E8YYRRngo4Kq0tsnaJQ5NlAkVinwRbih_g&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7Vlx0cW-uCu1j0ulbWdfZ_6VPYDISsa6i9OGvmO6h6JQ&oe=69FB3F62"}, {"file_name": "3.png", "id": "1934382610375855", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974473_1934382613709188_7156337812617042679_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tzPybgxsmdEQ7kNvwGFaVXj&_nc_oc=Adp-xmKZJqLPcKu8oRi8VuI9Cc2vq064gfFovGeP8Mcr0EtPzrVv2u-bxLD60v7s8gA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af63Fy8v5EsfNd9s1nc1ee4PxTGNdAM1WKVbo_TWlotNUw&oe=69FB2973"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape.png", "id": "1524760081483769", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974531_1524760084817102_6497712644828891067_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=naSaRH9zIMgQ7kNvwFxiisu&_nc_oc=AdpEvx4h4wPxwOkh9rJ21YT4QiV_cNVg1hSHEE0Cz8vBZZnR1idvw-Gk_ZsEJxCajFs&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4cJYdAC_VC6ZjyvZj9U8ywUi4MYd8wAZ3YgBV6yCivNw&oe=69FB286F"}, "display_name": "Mystery Box VR: Hidden Secrets", "keywords": [], "long_description": " AN IMMERSIVE VR PUZZLE EXPERIENCE\nInteract with objects, handles, buttons, and wheels on each side. Crack enigmas and collect hidden puzzle tiles on a random side of the boxes.\n\nYou won't be able to compare reality with fiction.\n\n# DISCOVER INVENTIONS\nOnce you unlock all 8 boxes of a Level Pack, you can compose a puzzle and discover a brief history of an invention.\n\nIt's not always easy to escape the room, so use all your IQ to crack the riddles. There's a logic behind all of them, even where it seems it's not!\n\n# IMMERSIVE SOUNDTRACK\nPlay the game with your headphones to get immersed in this amazing adventure.\n\n# HINTS\nGot stuck on some enigma? No worries, you can still get a helpful hint! You can also get in touch with me in case you really can't make it through a riddle, I'll be glad to help ;)\n\n# MULTILANGUAGE\nAvailable in English, French, Italian, German, Spanish, Russian, and Japanese.\n\nThe game language will change automatically based on the language settings of your device", "short_description": "A VR escape room game where you have to solve intriguing riddles to open boxes and discover nice stories about popular inventions!"}, {"images": {"nodes": [{"file_name": "$R36BSY5.png", "id": "3678762505771822", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031430_3678762509105155_2151975047074617165_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tbUdYHhM2rkQ7kNvwEZ5oyf&_nc_oc=Adr2JAdJUAjiONwwoWszd7hIlQYbtX0RsX3tmrlNttMnFd9QH35KNGfc3p3XGrPTw3M&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5Scvnlrqojja8tPN4xjMAcRsCo_SpcWqyME3e1dDkvCA&oe=69FB5CA5"}, {"file_name": "$R81V725.png", "id": "2720695481426567", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75262743_2720695484759900_604086922326600035_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u0fQbb-Hn2UQ7kNvwG-DYvY&_nc_oc=AdpsrncXuU17oZIriTWaJPZkTZIqxY8bCFoD3NAANvfJo-iUtmcr0_qpFg-Y45DDnhk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7SJc-K0ne-vpx0ZPEiXFOg6VqbR7pIrGpe-aRXIDaqwg&oe=69FB5B8D"}, {"file_name": "$RQ3SN6U.png", "id": "1552311425628973", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982519_1552311428962306_1218130395049083834_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oY0fBImjCR4Q7kNvwGu-Klq&_nc_oc=Adr2DzazNvMcMIB3VsZYFr6514DTk-J4lXspkRkkF4qf3ENmp_LVY0BbiaNOX7-joGY&_nc_zt=3&_nc_ht=
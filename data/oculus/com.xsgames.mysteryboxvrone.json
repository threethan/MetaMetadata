_z5FRZr2yzJPSQVoDkSRvGrbUv_biklY99ACEVBm1_qg&oe=6A243944"}, {"file_name": "5.png", "id": "467916352871409", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39003282_467916356204742_1871921057092171900_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SsGfM5NpRrkQ7kNvwEGCjYf&_nc_oc=AdqoUpW4JPw5WPUlecYr4VDdu8JRaEWn6C9g-Gmh-kfwJ8cJrJbH_m1C54MMcUT_6Yg&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-78Hq10XdMWUGf0vBAJwkQ8XQpieiwPXW-z4XBNRvdqg&oe=6A241DE2"}, {"file_name": "3.png", "id": "1934382610375855", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974473_1934382613709188_7156337812617042679_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3U4WkmPCYwUQ7kNvwFQxv1R&_nc_oc=Adpg6BN9NglnjA9s-eDfXi0Z2-QyHaFAUXqA8QC49X_Im2O_ixtakMv2kTf9mcFg9RY&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9LptODGN98Gri0m45SkLqek6LCNY83rmfTfgELlf2FVQ&oe=6A244033"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape.png", "id": "1524760081483769", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974531_1524760084817102_6497712644828891067_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sdKXxI_1y3EQ7kNvwFH4m0D&_nc_oc=Adr2ifJ4LUfS2aIFiFoijZwvJc8xJ8iHc0j_S2CrTabb-rG7XhFMC3POwDlmm4z4Le0&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9K3FMsS6ijI0rk6syJoiekI8E6FEm0-OhjlQyhm8WmEA&oe=6A243F2F"}, "display_name": "Mystery Box VR: Hidden Secrets", "keywords": [], "long_description": " AN IMMERSIVE VR PUZZLE EXPERIENCE\nInteract with objects, handles, buttons, and wheels on each side. Crack enigmas and collect hidden puzzle tiles on a random side of the boxes.\n\nYou won't be able to compare reality with fiction.\n\n# DISCOVER INVENTIONS\nOnce you unlock all 8 boxes of a Level Pack, you can compose a puzzle and discover a brief history of an invention.\n\nIt's not always easy to escape the room, so use all your IQ to crack the riddles. There's a logic behind all of them, even where it seems it's not!\n\n# IMMERSIVE SOUNDTRACK\nPlay the game with your headphones to get immersed in this amazing adventure.\n\n# HINTS\nGot stuck on some enigma? No worries, you can still get a helpful hint! You can also get in touch with me in case you really can't make it through a riddle, I'll be glad to help ;)\n\n# MULTILANGUAGE\nAvailable in English, French, Italian, German, Spanish, Russian, and Japanese.\n\nThe game language will change automatically based on the language settings of your device", "short_description": "A VR escape room game where you have to solve intriguing riddles to open boxes and discover nice stories about popular inventions!"}, {"images": {"nodes": [{"file_name": "$R36BSY5.png", "id": "3678762505771822", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39031430_3678762509105155_2151975047074617165_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5jOG_F3LB7QQ7kNvwEnGWCN&_nc_oc=AdrRHSCsvDfctCs5YM7GYbYdVlC7tHE7AzFdXjqwNxwgZAKC6l4cc3vlFJ0TAyA-uTk&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8SC7QXAXOztXZ8rV3IinYStnr54yPwcxpLXB1qcUEcCQ&oe=6A243B25"}, {"file_name": "$R81V725.png", "id": "2720695481426567", "image_type": "APP_IMG_ICON", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/75262743_2720695484759900_604086922326600035_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1KMMa831a8cQ7kNvwHnRF30&_nc_oc=AdpXMdfF_ieLv97G3yRX5JRtBuR-B8avOuDb5XszrOtkl4_Wxjb_RNFc26i_zh0ZNy4&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_yh7uAEw82dWQJ1PujTssNq7bYjIu161IzDOxtHfeI3w&oe=6A243A0D"}, {"file_name": "$RQ3SN6U.png", "id": "1552311425628973", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38982519_1552311428962306_1218130395049083834_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hnrVsoeuM8cQ7kNvwGV9HqI&_nc_oc=Ado4Utpn1J4rTz8gDRCY7PImJWsWo4HOTKuogKVIeyCG_lh8lN15azuIsQOFwvZagog&_nc_zt=3&_nc_ht=
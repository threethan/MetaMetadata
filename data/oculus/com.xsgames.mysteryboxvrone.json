ybCOPcwEvl9xDo808RtbrcrL30s_syahs-u9VkoSFbng&oe=69C3C384"}, {"file_name": "5.png", "id": "467916352871409", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39003282_467916356204742_1871921057092171900_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Uo1T39u1R38Q7kNvwHs7xd2&_nc_oc=AdoCK4IMnFRjj-5YnF8nUGZiRRFir_cNxUQy9BoVXkrC-01aXv_voEUuehB8EzGNQhE&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyMmBR44kaQsKDLXRzfEM-3HsaBP0IgA_PAks1Xl7jeYw&oe=69C3E062"}, {"file_name": "3.png", "id": "1934382610375855", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974473_1934382613709188_7156337812617042679_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iJSdAMIdPusQ7kNvwFSBdT5&_nc_oc=AdonKCyf4YEOYvSBP38OlrC8n6w1ThuUCli1NDojXaCQI3mnuiCN9X76Q3cO0G4CE3M&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afz3qyPXH9_TFecErqH5RcyBfVrOgj5F7MypksexHpz14A&oe=69C3CA73"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape.png", "id": "1524760081483769", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974531_1524760084817102_6497712644828891067_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C05ssKrefBUQ7kNvwFadhsg&_nc_oc=AdqOrKKvRYBKCuX3iFd7kl8LIToKAJErStDzA4v-Y0BcqDPaf3lTXdOwj-0MNqke29A&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afy5nPatgRFu2JJl81qhTSBSlEj8TxCqmBXYi3ut6Y7kCg&oe=69C3C96F"}, "display_name": "Mystery Box VR: Hidden Secrets", "keywords": [], "long_description": " AN IMMERSIVE VR PUZZLE EXPERIENCE\nInteract with objects, handles, buttons, and wheels on each side. Crack enigmas and collect hidden puzzle tiles on a random side of the boxes.\n\nYou won't be able to compare reality with fiction.\n\n# DISCOVER INVENTIONS\nOnce you unlock all 8 boxes of a Level Pack, you can compose a puzzle and discover a brief history of an invention.\n\nIt's not always easy to escape the room, so use all your IQ to crack the riddles. There's a logic behind all of them, even where it seems it's not!\n\n# IMMERSIVE SOUNDTRACK\nPlay the game with your headphones to get immersed in this amazing adventure.\n\n# HINTS\nGot stuck on some enigma? No worries, you can still get a helpful hint! You can also get in touch with me in case you really can't make it through a riddle, I'll be glad to help ;)\n\n# MULTILANGUAGE\nAvailable in English, French, Italian, German, Spanish, Russian, and Japanese.\n\nThe game language will change automatically based on the language settings of your device", "short_description": "A VR escape room game where you have to solve intriguing riddles to open boxes and discover nice stories about popular inventions!"}, {"images": {"nodes": [{"file_name": "$R36BSY5.png", "id": "3678762505771822", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39031430_3678762509105155_2151975047074617165_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G3bpbjbwFo0Q7kNvwEHg_JK&_nc_oc=AdpGIdR2RVZnDOhfWogpIAWoKLd6EKtTYcCxSoUF-9SYxaQBgA4r6ViMNc6-R1yghng&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afx67d1xEj2n6zsOLU698eyuy_1f_ReSjhpTST7ZDWW-hA&oe=69C3C565"}, {"file_name": "$R81V725.png", "id": "2720695481426567", "image_type": "APP_IMG_ICON", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/75262743_2720695484759900_604086922326600035_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=--M8Bprnd7kQ7kNvwF0CFTl&_nc_oc=AdokfPY3TYY12cZAPBUvBPiX0ZG9OKs9ZvmLY8_CWd89FNuCixeuG6d4hjFo7F38Lp4&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwkNH8MMzJYs1hj2XcLLTrSszIzUjbDQ-QeRygVAMfBYA&oe=69C3C44D"}, {"file_name": "$RQ3SN6U.png", "id": "1552311425628973", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38982519_1552311428962306_1218130395049083834_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ashleXd6g20Q7kNvwGt_jO-&_nc_oc=AdpD4n2e_VvOrdViiSxJsNPv0p2S7mzS8yvhoSW5cMGzPbJANN7XJqM9j3FQEqey28k&_nc_zt=3&_nc_ht=
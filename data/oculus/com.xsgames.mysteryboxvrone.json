Fplc1bZyjLAyBYfLrZdNf7A2v8HTpykK7j-n5MYGHGOQ&oe=6A789944"}, {"file_name": "5.png", "id": "467916352871409", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39003282_467916356204742_1871921057092171900_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yhaliy8f3KsQ7kNvwGiJyoo&_nc_oc=AdrPXZmDHfq6p_jnVSYX1a4IO6l4Hu5iVsALdehcPzGDFlmeQy8HDljYZMr89v_piOE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHBt4GWABra8yHkPq-3QbON3URjE0d5NMJ9Q05PPbrPqw&oe=6A787DE2"}, {"file_name": "3.png", "id": "1934382610375855", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974473_1934382613709188_7156337812617042679_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KPiG156k8TMQ7kNvwHT1EL8&_nc_oc=Adp_qPnI1W1s4ZdK860z3S1uSZsj4sNoGSGTYwh8LQbGMQvqf3NIVIeDzeBxaRy-spc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFCP43yE_5flPP4dgFXqYoJH8-fbxCJMl4aHXcLu4e0jw&oe=6A7867F3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape.png", "id": "1524760081483769", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974531_1524760084817102_6497712644828891067_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DNNCLxqj8M4Q7kNvwGxNtCw&_nc_oc=Adpzn5RPFHlH4MZbk_5ohR4q1xPXq9K_tCc7cFwgWMmPxeofP7Scvk5wUtrBkVoFxJk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHWQihajPhADxY3cDCsXbuTCN4bHtmXe6NA7Ylg-hBnwg&oe=6A7866EF"}, "display_name": "Mystery Box VR: Hidden Secrets", "keywords": [], "long_description": " AN IMMERSIVE VR PUZZLE EXPERIENCE\nInteract with objects, handles, buttons, and wheels on each side. Crack enigmas and collect hidden puzzle tiles on a random side of the boxes.\n\nYou won't be able to compare reality with fiction.\n\n# DISCOVER INVENTIONS\nOnce you unlock all 8 boxes of a Level Pack, you can compose a puzzle and discover a brief history of an invention.\n\nIt's not always easy to escape the room, so use all your IQ to crack the riddles. There's a logic behind all of them, even where it seems it's not!\n\n# IMMERSIVE SOUNDTRACK\nPlay the game with your headphones to get immersed in this amazing adventure.\n\n# HINTS\nGot stuck on some enigma? No worries, you can still get a helpful hint! You can also get in touch with me in case you really can't make it through a riddle, I'll be glad to help ;)\n\n# MULTILANGUAGE\nAvailable in English, French, Italian, German, Spanish, Russian, and Japanese.\n\nThe game language will change automatically based on the language settings of your device", "short_description": "A VR escape room game where you have to solve intriguing riddles to open boxes and discover nice stories about popular inventions!"}, {"images": {"nodes": [{"file_name": "$R36BSY5.png", "id": "3678762505771822", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031430_3678762509105155_2151975047074617165_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mBen32FCM04Q7kNvwGCL3Qw&_nc_oc=Adouc8FI0kJ606DpXVw7RepOfSnDcO7A-dAaytBTcTbZK3Ep0aTGYgLyWrhhIME0n2k&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG3pJQnEvl_4WkFWJbqlMUaVAEzRWPaU2oeDrXZVcvj3w&oe=6A789B25"}, {"file_name": "$R81V725.png", "id": "2720695481426567", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75262743_2720695484759900_604086922326600035_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dlQzlVuxhg4Q7kNvwF9LUAf&_nc_oc=AdpvCxUAOYYBpn6CRfnyPr1vsGYnLSEUcFJ6fEBQBXEpChvNOb_FIuF4DDX6lRs2h4Q&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFRFXWti7U4ZVsV3eNtTqJRTpJORbjM7Z1VrPOG68xp8Q&oe=6A789A0D"}, {"file_name": "$RQ3SN6U.png", "id": "1552311425628973", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982519_1552311428962306_1218130395049083834_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xx9Ag-Hg0pYQ7kNvwHscclr&_nc_oc=Adolj4JktweyspNdzBNjUcQ-3N4RpZiYs4Repdafsakh-24HJc-WdnW-bzsANnHP7Rw&_nc_zt=3&_nc_ht=
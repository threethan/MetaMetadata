2PMYdMNUw3UT_0UNOpuIcA_LUl0Deilpp9CE1xia8Dxw&oe=69D39584"}, {"file_name": "5.png", "id": "467916352871409", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39003282_467916356204742_1871921057092171900_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rGARsleA0KwQ7kNvwH4SA0t&_nc_oc=AdqO8RnqnO5qTVcLo5j3U11A-ESY9q1llNav90NracfM_OUuUI2Q52ubsRjEZ8yDlhw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3eiJkCj1lcnuhglOdrf7RwtSYudtMZKZ72nh2wtjDCQw&oe=69D3B262"}, {"file_name": "3.png", "id": "1934382610375855", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974473_1934382613709188_7156337812617042679_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1g2KGztdVjEQ7kNvwGDstOe&_nc_oc=Adri-KiICoKGQORs9RQt3lYweDeo31wSSoMnsqruRErVGyvOwV6QG4TVPWNzEc1kRY0&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af28r_1bEw3AjWBIrIC3w2QbNd5qr32r30FTYU4JFpRhuA&oe=69D39C73"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape.png", "id": "1524760081483769", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974531_1524760084817102_6497712644828891067_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I4uzclrEZv4Q7kNvwEaR-NA&_nc_oc=Adrj34dzLTmyszPB3mU52XIC_JvrFNekbhLDjS-yb-_1rdmBrBdPPyFHqGIrU2sC-2U&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0O_v8tl9jCafJrihVjVxkDO57S-04M27jEDTsHUdLhvg&oe=69D39B6F"}, "display_name": "Mystery Box VR: Hidden Secrets", "keywords": [], "long_description": " AN IMMERSIVE VR PUZZLE EXPERIENCE\nInteract with objects, handles, buttons, and wheels on each side. Crack enigmas and collect hidden puzzle tiles on a random side of the boxes.\n\nYou won't be able to compare reality with fiction.\n\n# DISCOVER INVENTIONS\nOnce you unlock all 8 boxes of a Level Pack, you can compose a puzzle and discover a brief history of an invention.\n\nIt's not always easy to escape the room, so use all your IQ to crack the riddles. There's a logic behind all of them, even where it seems it's not!\n\n# IMMERSIVE SOUNDTRACK\nPlay the game with your headphones to get immersed in this amazing adventure.\n\n# HINTS\nGot stuck on some enigma? No worries, you can still get a helpful hint! You can also get in touch with me in case you really can't make it through a riddle, I'll be glad to help ;)\n\n# MULTILANGUAGE\nAvailable in English, French, Italian, German, Spanish, Russian, and Japanese.\n\nThe game language will change automatically based on the language settings of your device", "short_description": "A VR escape room game where you have to solve intriguing riddles to open boxes and discover nice stories about popular inventions!"}, {"images": {"nodes": [{"file_name": "$R36BSY5.png", "id": "3678762505771822", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031430_3678762509105155_2151975047074617165_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A4cTAAm09AMQ7kNvwHpODfS&_nc_oc=Adpd7_98bncqlG7md8eLpHh6pkwFytslp6AERjtpfvrPzIEyTN2QhYyNRMKyxnFzaYc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2xrolLWHIdblL9-diMUukLgwgsY7W0VxG6CwMbf98OHw&oe=69D39765"}, {"file_name": "$R81V725.png", "id": "2720695481426567", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75262743_2720695484759900_604086922326600035_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EyO8hmUt7HEQ7kNvwF1MHYM&_nc_oc=Adog_BWjMAUGccK5vCmSAgVxUqlnoQ0HvgiCPTOU8gtKUO4izJpbsxPW_w05tPrtiDM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3_NKuP5NTAq7ZB99zBVXkGxwllgYnjQUYsV8d_4-NAAw&oe=69D3964D"}, {"file_name": "$RQ3SN6U.png", "id": "1552311425628973", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982519_1552311428962306_1218130395049083834_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QZJLSY_B1-kQ7kNvwGG8yJw&_nc_oc=Adq-4KfvjdCyliqDuucpTaLuVfvMROiaW-CmgHKMRFK9iHwR4GQTNAPM7Gl7dlIlegw&_nc_zt=3&_nc_ht=
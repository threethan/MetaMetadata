4odq_NP5vpdQ88H0izoMQytTj5vqQ2s59P4jj9kP45Tw&oe=6A15B8C4"}, {"file_name": "5.png", "id": "467916352871409", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39003282_467916356204742_1871921057092171900_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g5kt4o103m0Q7kNvwFoUGTC&_nc_oc=AdqKy_GqJDxo1FCQl6oqtRpceqmLUecfinkZWESmLyvDtehqKHV3jt9w9ZqS86CMqbE&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5x72QbD35lrzdfIeqoz-wDPryOlzaM3cpCj5u36CzVIw&oe=6A159D62"}, {"file_name": "3.png", "id": "1934382610375855", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38974473_1934382613709188_7156337812617042679_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k6lKK9C5B3sQ7kNvwGyYNpi&_nc_oc=AdqD1L1oCctCQ9KFvTKyYqPNx1N6g20WOUp1BZ4HgVZN96Fg0NaCgDseso1HVMBY2jc&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4bdVYFDxwq09n36pKxvNpGNfNPQTRTa02ktAicUn8Y-A&oe=6A15BFB3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape.png", "id": "1524760081483769", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38974531_1524760084817102_6497712644828891067_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5RAjU1MEJ1EQ7kNvwF7E1Ly&_nc_oc=AdrlVqGwwH4ZPwUo9Ao2wZ4Bl8afPypa12Rm3sjBuC626lfPRgI_WUtWekIQpCnIm1o&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6xxDgHOhI1v1N4YbOhPOUnAMvyZ0dK7-1AsOO8FBpKZw&oe=6A15BEAF"}, "display_name": "Mystery Box VR: Hidden Secrets", "keywords": [], "long_description": " AN IMMERSIVE VR PUZZLE EXPERIENCE\nInteract with objects, handles, buttons, and wheels on each side. Crack enigmas and collect hidden puzzle tiles on a random side of the boxes.\n\nYou won't be able to compare reality with fiction.\n\n# DISCOVER INVENTIONS\nOnce you unlock all 8 boxes of a Level Pack, you can compose a puzzle and discover a brief history of an invention.\n\nIt's not always easy to escape the room, so use all your IQ to crack the riddles. There's a logic behind all of them, even where it seems it's not!\n\n# IMMERSIVE SOUNDTRACK\nPlay the game with your headphones to get immersed in this amazing adventure.\n\n# HINTS\nGot stuck on some enigma? No worries, you can still get a helpful hint! You can also get in touch with me in case you really can't make it through a riddle, I'll be glad to help ;)\n\n# MULTILANGUAGE\nAvailable in English, French, Italian, German, Spanish, Russian, and Japanese.\n\nThe game language will change automatically based on the language settings of your device", "short_description": "A VR escape room game where you have to solve intriguing riddles to open boxes and discover nice stories about popular inventions!"}, {"images": {"nodes": [{"file_name": "$R36BSY5.png", "id": "3678762505771822", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39031430_3678762509105155_2151975047074617165_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y_wbhNyqj5oQ7kNvwF55nA9&_nc_oc=AdpSiQV7RqYX6_pvc5knG6EUAGOY7eH-yW41VHp-O5wGc-9SoVpdgJ5wXWtqUNVd_go&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af48_zX_HM8TU4D7yBG1Pw6_qXRfh44J4L7z0sBxTUAW2w&oe=6A15BAA5"}, {"file_name": "$R81V725.png", "id": "2720695481426567", "image_type": "APP_IMG_ICON", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75262743_2720695484759900_604086922326600035_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LUI23E8JQUYQ7kNvwHoStI4&_nc_oc=AdrAanV2AMGG016lUBp0lYICcg31GOT01-0XXhdvYxLeLE1Q0-ejPwPLUgEYMM0MTaM&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6yh8zG10ugdUFKdK6brJrlAyLEn7zosWpBAPy-bRk0rA&oe=6A15B98D"}, {"file_name": "$RQ3SN6U.png", "id": "1552311425628973", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982519_1552311428962306_1218130395049083834_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZgOFrcAZKc4Q7kNvwFWlUY4&_nc_oc=AdouY1oJgGDj4Q_eQo1DEPzAW-fm7bDdC5ehI4W89FWp-WraDSzoYKmyFKIC4lv-XFM&_nc_zt=3&_nc_ht=
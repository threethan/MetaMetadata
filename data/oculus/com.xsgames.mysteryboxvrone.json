91llyaSxQNsG3jL8BpmTC4YOJ_9qjepzj2zC6fS9UHMQ&oe=6A32B9C4"}, {"file_name": "5.png", "id": "467916352871409", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/39003282_467916356204742_1871921057092171900_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qZ2JqO2gijoQ7kNvwGjyu5W&_nc_oc=AdpnRG_FGnobJjtufuh8e4QNK6V0Hiy3N5so_HazeqnaH13tMmqrbku6dMftku_xvH0&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8rxkV45COjj9XTqxFXrbMs4ypFQwqnYRMCm5QjRKMlMQ&oe=6A329E62"}, {"file_name": "3.png", "id": "1934382610375855", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/38974473_1934382613709188_7156337812617042679_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yxXpkd_y8IgQ7kNvwHZNFqp&_nc_oc=Adr0Kk7lAOnRO4atcgvdmwWrMoKWWWcgaSGhsrjKhfJE127tsVRPhSbwNmAnjcuLk-U&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8vQJ3qdwkDQR-glOqxHOME9KIEkTPOMuPux4eYWA1ROw&oe=6A32C0B3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape.png", "id": "1524760081483769", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/38974531_1524760084817102_6497712644828891067_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uPRBnKxWONgQ7kNvwGdVjiS&_nc_oc=AdrAOpGZeh74WAip882BQUT1WA5nP1yuWB85M1N49qsBMJarkRsywQRZPZbQcktemkA&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-6CSs-TUpSCWvoBUIqie2nd1NpOjb1lrd5QNrDhaauiw&oe=6A32BFAF"}, "display_name": "Mystery Box VR: Hidden Secrets", "keywords": [], "long_description": " AN IMMERSIVE VR PUZZLE EXPERIENCE\nInteract with objects, handles, buttons, and wheels on each side. Crack enigmas and collect hidden puzzle tiles on a random side of the boxes.\n\nYou won't be able to compare reality with fiction.\n\n# DISCOVER INVENTIONS\nOnce you unlock all 8 boxes of a Level Pack, you can compose a puzzle and discover a brief history of an invention.\n\nIt's not always easy to escape the room, so use all your IQ to crack the riddles. There's a logic behind all of them, even where it seems it's not!\n\n# IMMERSIVE SOUNDTRACK\nPlay the game with your headphones to get immersed in this amazing adventure.\n\n# HINTS\nGot stuck on some enigma? No worries, you can still get a helpful hint! You can also get in touch with me in case you really can't make it through a riddle, I'll be glad to help ;)\n\n# MULTILANGUAGE\nAvailable in English, French, Italian, German, Spanish, Russian, and Japanese.\n\nThe game language will change automatically based on the language settings of your device", "short_description": "A VR escape room game where you have to solve intriguing riddles to open boxes and discover nice stories about popular inventions!"}, {"images": {"nodes": [{"file_name": "$R36BSY5.png", "id": "3678762505771822", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/39031430_3678762509105155_2151975047074617165_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IiFbLjG75AQQ7kNvwGEp9tT&_nc_oc=AdoJOY925K-2iQFlrzdsOvZ2ozPLgj5xWCXt04ZFt7m4MEC_0Rpi0gfwpgAMtmD0p5c&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9jEoyphPZuPApDI1ZyvTA9asyI5vVGtH-XitsjQF6tQw&oe=6A32BBA5"}, {"file_name": "$R81V725.png", "id": "2720695481426567", "image_type": "APP_IMG_ICON", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/75262743_2720695484759900_604086922326600035_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZQA9PCXqgpAQ7kNvwFgNUqB&_nc_oc=AdpdjepaZ195C4jnJKPdcjywJsvHacacIzZtKFdWwBHxeBGThiueK_a_afuKWe3tc7s&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8YizEgfw1wWSiei_GkmSzPs8BuAFJfvaeeYAU0EiBL6w&oe=6A32BA8D"}, {"file_name": "$RQ3SN6U.png", "id": "1552311425628973", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/38982519_1552311428962306_1218130395049083834_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9ts5AtAVlnYQ7kNvwH5X2Qe&_nc_oc=AdqisEi4ofKyHm9R4gRDOTNOS7uUXBwJAWA3OZIBcrqvc53X_poX16nJFsN1KAvxT5U&_nc_zt=3&_nc_ht=
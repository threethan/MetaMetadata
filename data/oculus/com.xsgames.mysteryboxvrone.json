9cYVfU6SoBMtQ4OJnW3Vq3nKWX9L3hDZPemh3liNrFJw&oe=6A37FFC4"}, {"file_name": "5.png", "id": "467916352871409", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39003282_467916356204742_1871921057092171900_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DyM82iimzVYQ7kNvwHyTZFT&_nc_oc=Adru8WTNlIq0NtrvwJLQqP9K17u7ZjYKUjVcs_UWz6imM36OlUw1UZm4NEWMmxBPQPY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9cG97jLJV1jIzcHhOqNOkUfh7ap53p1QPH9kP5lzDOIw&oe=6A37E462"}, {"file_name": "3.png", "id": "1934382610375855", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974473_1934382613709188_7156337812617042679_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MsTwwUSP5yoQ7kNvwEMSNAb&_nc_oc=AdopWl_cmb_4a0NpvnZfUNrgiB8l1WTi62QD6Wcd156mm9RByRj2hai38IqR79E8axo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-fSimoUIYyvpKB1ZyLSGEdwF-2PhJ6PruTfP8qViMfnw&oe=6A3806B3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape.png", "id": "1524760081483769", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974531_1524760084817102_6497712644828891067_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ueWvJZfgk4MQ7kNvwFLaA19&_nc_oc=Adpd9fDtHtIywo7o-jxpEnWuWk7Q_sjHpv8BMxm1w_xwPf2uvy3mfwjxgFhtCA8KaAs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8VdgsBBj88J3pBDftyRrzo-Jy4vU91Jr4LVOEIFMzYeg&oe=6A3805AF"}, "display_name": "Mystery Box VR: Hidden Secrets", "keywords": [], "long_description": " AN IMMERSIVE VR PUZZLE EXPERIENCE\nInteract with objects, handles, buttons, and wheels on each side. Crack enigmas and collect hidden puzzle tiles on a random side of the boxes.\n\nYou won't be able to compare reality with fiction.\n\n# DISCOVER INVENTIONS\nOnce you unlock all 8 boxes of a Level Pack, you can compose a puzzle and discover a brief history of an invention.\n\nIt's not always easy to escape the room, so use all your IQ to crack the riddles. There's a logic behind all of them, even where it seems it's not!\n\n# IMMERSIVE SOUNDTRACK\nPlay the game with your headphones to get immersed in this amazing adventure.\n\n# HINTS\nGot stuck on some enigma? No worries, you can still get a helpful hint! You can also get in touch with me in case you really can't make it through a riddle, I'll be glad to help ;)\n\n# MULTILANGUAGE\nAvailable in English, French, Italian, German, Spanish, Russian, and Japanese.\n\nThe game language will change automatically based on the language settings of your device", "short_description": "A VR escape room game where you have to solve intriguing riddles to open boxes and discover nice stories about popular inventions!"}, {"images": {"nodes": [{"file_name": "$R36BSY5.png", "id": "3678762505771822", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031430_3678762509105155_2151975047074617165_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UDvKE-eNqykQ7kNvwHj2MWB&_nc_oc=AdpaNBiIobCR1VOPM6JlvocokSHWA86Fogs8GPIJu2jJjgEHW_wpI1gnyfIFp0EnfpQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-CGrQpkP0xg9GYJgcMDgB6tUlUdIQggjNOmjyLxBDADA&oe=6A3801A5"}, {"file_name": "$R81V725.png", "id": "2720695481426567", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75262743_2720695484759900_604086922326600035_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aZi5efE1pEAQ7kNvwGuoTZZ&_nc_oc=Adq0oLwoFWAj68ORYUdpTnuUeblt5ybdUu_gP5J9yYjxfcamoCmhHLR9cVRDx_SYGF4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9U_ek_QdSyp4jcdJAVcADy24F9CVAOhipxXMC9ki4q_Q&oe=6A38008D"}, {"file_name": "$RQ3SN6U.png", "id": "1552311425628973", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982519_1552311428962306_1218130395049083834_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dgu9dmo4AJIQ7kNvwEjhUF1&_nc_oc=Adr51aAHmWXGb-HcmaMg6bVWgCTWrt7FxMQoF2PzJJK_jZxM_Z2L8U-3LQ9bUJhc_U0&_nc_zt=3&_nc_ht=
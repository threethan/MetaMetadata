Ox5QdYv-1ygBWjhms3eYSvsDfWF0_2gU-1WS3abu73Dw&oe=6AE362C4"}, {"file_name": "5.png", "id": "467916352871409", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39003282_467916356204742_1871921057092171900_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_mNb3kctKG0Q7kNvwFmq9gU&_nc_oc=AdpN9zHmta6F9gF3iNiGOnW8aYFqikTV4ZLltNhv2P7PZ9TbOjMaSJy7422ZwMjNku0&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM-rxYXnuFXdZF86zrLF7wRFpvAsIhW0e_WVdgXhoz0NA&oe=6AE34762"}, {"file_name": "3.png", "id": "1934382610375855", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974473_1934382613709188_7156337812617042679_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JVNRziCGz6wQ7kNvwERRP5Y&_nc_oc=AdpUzzrMJcgiPJuoMm6tLjVMizKmEpKX_cVdOk8gNiRI3T_v3rwtluDzQ7xLdG797QE&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN2CZQ_9rRubE66WEZBsa6xGX2ZcNVSV0ta8G_wehUgIw&oe=6AE369B3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape.png", "id": "1524760081483769", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974531_1524760084817102_6497712644828891067_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iF8cQ6D866cQ7kNvwFpJsLt&_nc_oc=Adry0grnFfsjVmqhhGAYjh7mRUO32Qd-eyIVQHMFXoxzue8qJEAJE6sCS5IcqnCRxYE&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPzFKSQkI00UWjdi8I75Pu-zvxLwXA2-y8Hr7DmAWHvpA&oe=6AE368AF"}, "display_name": "Mystery Box VR: Hidden Secrets", "keywords": [], "long_description": " AN IMMERSIVE VR PUZZLE EXPERIENCE\nInteract with objects, handles, buttons, and wheels on each side. Crack enigmas and collect hidden puzzle tiles on a random side of the boxes.\n\nYou won't be able to compare reality with fiction.\n\n# DISCOVER INVENTIONS\nOnce you unlock all 8 boxes of a Level Pack, you can compose a puzzle and discover a brief history of an invention.\n\nIt's not always easy to escape the room, so use all your IQ to crack the riddles. There's a logic behind all of them, even where it seems it's not!\n\n# IMMERSIVE SOUNDTRACK\nPlay the game with your headphones to get immersed in this amazing adventure.\n\n# HINTS\nGot stuck on some enigma? No worries, you can still get a helpful hint! You can also get in touch with me in case you really can't make it through a riddle, I'll be glad to help ;)\n\n# MULTILANGUAGE\nAvailable in English, French, Italian, German, Spanish, Russian, and Japanese.\n\nThe game language will change automatically based on the language settings of your device", "short_description": "A VR escape room game where you have to solve intriguing riddles to open boxes and discover nice stories about popular inventions!"}, {"images": {"nodes": [{"file_name": "$R36BSY5.png", "id": "3678762505771822", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39031430_3678762509105155_2151975047074617165_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qq6PUHIdOj4Q7kNvwFYUEk8&_nc_oc=AdphobjkiwnFBQvCIrZZXMNUEBIVYlFfVgsRXByNXE9LVJdc6DhnUvcidTOSksc_QEg&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNmR8E0oU2fLtO5oRqsqBptB_TWyzVkaRcUwh3qoH5yLQ&oe=6AE364A5"}, {"file_name": "$R81V725.png", "id": "2720695481426567", "image_type": "APP_IMG_ICON", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/75262743_2720695484759900_604086922326600035_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pE0JaHZppJgQ7kNvwExYwga&_nc_oc=AdrEb6i7GJkFAS85iDzzTZnOvaCaw0nqrK-oyIvuy9UPkhYGNDmw2icfrZcExV_GerU&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPMPuXhQuB7JskHCfUfqaxx7ZyTfTFkZC_2eUrR7XSM4w&oe=6AE3638D"}, {"file_name": "$RQ3SN6U.png", "id": "1552311425628973", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38982519_1552311428962306_1218130395049083834_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BrYZg0ipzK8Q7kNvwEsmypA&_nc_oc=AdqxPE7-SlEfJfBpcCyTuhoOt1jaL0B1cJ5HS1LbZ6nl0hcdUPrTDsRRaNbpwUwvMZM&_nc_zt=3&_nc_ht=
r6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHCUS5JK4GHSthNJ7OUXKoEi8W0Zny2MbevLjCwsov7uA&oe=6A8ECA84"}, {"file_name": "5.png", "id": "467916352871409", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/39003282_467916356204742_1871921057092171900_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BM3TwgzpbHYQ7kNvwEMgFWm&_nc_oc=Adqj8V6tir9qWo0MJEjF1k6qwgY2LVrRxmPrfVKDAA_zWspCeCR-uAIdcab3Y88ze54&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHkCK06NcdbnjcNnC2uzWvVn1Yu665U7Fc_zKt8glZGcg&oe=6A8EE762"}, {"file_name": "3.png", "id": "1934382610375855", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/38974473_1934382613709188_7156337812617042679_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jbe3J5WaKn8Q7kNvwGESUUT&_nc_oc=Adpe-q4sppyChxlpkfnzFU8Zd__xAaMT1GSy54xT0JD71hOeKQmImr9XXTaQywI-Q3Q&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG0_rn_bRyjrRjJNUiBIrIP_t6CI0qs3ialsRQMLW_-wg&oe=6A8ED173"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape.png", "id": "1524760081483769", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/38974531_1524760084817102_6497712644828891067_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4d3YnYNtx_YQ7kNvwFAeXFg&_nc_oc=AdqxEAoq42xqv8jHlEQSAAcrvz4axeBERQTVs4JO4nAd5h6TGApG-EdYaToGpjp6GCk&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEbFMZszEL60gpdHsVx4WiOVqBi549FSrd7mlW-Lv641g&oe=6A8ED06F"}, "display_name": "Mystery Box VR: Hidden Secrets", "keywords": [], "long_description": " AN IMMERSIVE VR PUZZLE EXPERIENCE\nInteract with objects, handles, buttons, and wheels on each side. Crack enigmas and collect hidden puzzle tiles on a random side of the boxes.\n\nYou won't be able to compare reality with fiction.\n\n# DISCOVER INVENTIONS\nOnce you unlock all 8 boxes of a Level Pack, you can compose a puzzle and discover a brief history of an invention.\n\nIt's not always easy to escape the room, so use all your IQ to crack the riddles. There's a logic behind all of them, even where it seems it's not!\n\n# IMMERSIVE SOUNDTRACK\nPlay the game with your headphones to get immersed in this amazing adventure.\n\n# HINTS\nGot stuck on some enigma? No worries, you can still get a helpful hint! You can also get in touch with me in case you really can't make it through a riddle, I'll be glad to help ;)\n\n# MULTILANGUAGE\nAvailable in English, French, Italian, German, Spanish, Russian, and Japanese.\n\nThe game language will change automatically based on the language settings of your device", "short_description": "A VR escape room game where you have to solve intriguing riddles to open boxes and discover nice stories about popular inventions!"}, {"images": {"nodes": [{"file_name": "$R36BSY5.png", "id": "3678762505771822", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/39031430_3678762509105155_2151975047074617165_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XOkwkKMXEFYQ7kNvwGxjdaM&_nc_oc=AdoryuLpC9TGrPsC3V10eVN2cHtGowy1R89RcwxgCYigbv6rUFNBlWX872pqkXkPXmg&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGRBTi_CZI6oCm9V-P3mTdHb_Qb2tajjJi1dNiSnCQugA&oe=6A8ECC65"}, {"file_name": "$R81V725.png", "id": "2720695481426567", "image_type": "APP_IMG_ICON", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/75262743_2720695484759900_604086922326600035_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Wfo7NtJW9LQQ7kNvwHLJ_cg&_nc_oc=Adq2iQOZDMflk-r8nY066OLO3UFYY6zT91SsBrWJF6vMcXpTK9L-qTuFXZim7wTFf5o&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFxY4T8EuanaeTSuUghK0uB_Kj7qxQS_MRnbyaMIFAh6w&oe=6A8ECB4D"}, {"file_name": "$RQ3SN6U.png", "id": "1552311425628973", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/38982519_1552311428962306_1218130395049083834_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HCyHiYncnQYQ7kNvwF95QER&_nc_oc=Ado6p-j4sO_FK8U164d7ZelJ0yJle1VZ5s7Nuj8
Nm2gFRQZe9K4h-f3pR_KfBqUOaTPVub-dFiecuXB_pXQ&oe=6AC51044"}, {"file_name": "5.png", "id": "467916352871409", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/39003282_467916356204742_1871921057092171900_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c9ONxuIER0IQ7kNvwGZOq0n&_nc_oc=Adr5SF79EpZ2NeKz6hIC5b9EP0SleronATEK7OQsiGc5J01C9_jQKCjX_H_Rk3spVgs&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOGY0bSp9KIJcpwM7Df-CU4YgUAinjv1WyAf2CAMhsyjw&oe=6AC4F4E2"}, {"file_name": "3.png", "id": "1934382610375855", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38974473_1934382613709188_7156337812617042679_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8sBy9lDNLWwQ7kNvwER2Twl&_nc_oc=Adp12LTx-CYOgguhHSwjy0_P7LTk6PN9uQShQ46xQIjkU7V6ROVTkm-bSKyiQhh13ig&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOXGCRk1MNphvnoBAxLYoKHaLaAoOAvfDWdwugJDDBSaA&oe=6AC51733"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape.png", "id": "1524760081483769", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38974531_1524760084817102_6497712644828891067_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xcRMDoes9IkQ7kNvwFrjdLX&_nc_oc=AdqZK0yTC_5DO4_Q8Xt9tkBa77vGda0Cv5chlO4g7Ir5Cbd1bdNfgv206pwxZUCbpN4&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOE5cBn62SYT5CLBLxXz8GfB0i7suB0Vh7eqw2SPbQO8Q&oe=6AC5162F"}, "display_name": "Mystery Box VR: Hidden Secrets", "keywords": [], "long_description": " AN IMMERSIVE VR PUZZLE EXPERIENCE\nInteract with objects, handles, buttons, and wheels on each side. Crack enigmas and collect hidden puzzle tiles on a random side of the boxes.\n\nYou won't be able to compare reality with fiction.\n\n# DISCOVER INVENTIONS\nOnce you unlock all 8 boxes of a Level Pack, you can compose a puzzle and discover a brief history of an invention.\n\nIt's not always easy to escape the room, so use all your IQ to crack the riddles. There's a logic behind all of them, even where it seems it's not!\n\n# IMMERSIVE SOUNDTRACK\nPlay the game with your headphones to get immersed in this amazing adventure.\n\n# HINTS\nGot stuck on some enigma? No worries, you can still get a helpful hint! You can also get in touch with me in case you really can't make it through a riddle, I'll be glad to help ;)\n\n# MULTILANGUAGE\nAvailable in English, French, Italian, German, Spanish, Russian, and Japanese.\n\nThe game language will change automatically based on the language settings of your device", "short_description": "A VR escape room game where you have to solve intriguing riddles to open boxes and discover nice stories about popular inventions!"}, {"images": {"nodes": [{"file_name": "$R36BSY5.png", "id": "3678762505771822", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/39031430_3678762509105155_2151975047074617165_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W6eyVsav-YQQ7kNvwGu0kxp&_nc_oc=Adq3bDXKPLkp4gsNyOiNv0Hfm8o2_WHuYJuQ7d8zlrdUsllixMKff4MpBXPf3YKpICg&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPJn7yhm7AtyPDbMcY_62qtVovJ-kRfZBEUaKqxBfyBUA&oe=6AC51225"}, {"file_name": "$R81V725.png", "id": "2720695481426567", "image_type": "APP_IMG_ICON", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/75262743_2720695484759900_604086922326600035_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FdRHVNHxXhAQ7kNvwH6okqN&_nc_oc=Adrk2z781S3ppPEodcQBazf9s9j7YbCGV_FY_W-OmzqYuRqTgq59R0QaX4zW01md-Lc&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPbKAi4gxIhEn7yAtvqSsw3DlDRSsNdKpQ-jgTZ9A7VBw&oe=6AC5110D"}, {"file_name": "$RQ3SN6U.png", "id": "1552311425628973", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38982519_1552311428962306_1218130395049083834_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L8YQnxG372cQ7kNvwE8t21G&_nc_oc=AdrABEqVCrIsaOgPKPgMdGbHKogVEWyNYtVwY9s1uwDeLB8bCzNhOuEeSYqAUaowRCY&_nc_zt=3&_nc_ht=
x9Kht6JHu_H4Lnc7BEUzBPA-PCbuExKd23aH3MPpNI1Q&oe=69C66684"}, {"file_name": "5.png", "id": "467916352871409", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39003282_467916356204742_1871921057092171900_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PK8aExZtfnQQ7kNvwGxCOpx&_nc_oc=AdoDxrk6RtjPjxdMvXN4aJ6j8hnCahYqvSRaCGRY1ENy9aOO125Nd11zHB1hD98fnQY&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwclYR_7WQGWvkWsBmE4k1VY4ZzDkDPDJ8WAABP6pS3nw&oe=69C68362"}, {"file_name": "3.png", "id": "1934382610375855", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974473_1934382613709188_7156337812617042679_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iJSdAMIdPusQ7kNvwGHQmn5&_nc_oc=AdppmtHc4T4jKWKiNCCwZgsfU1YbUj3dSr_U7toEMtO6IRkDkQHRWbcyxrRoiDTXS88&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwCxty_tychIiFAbcSlgKTgjhVU2wsiOLBEg30w6Bwojw&oe=69C66D73"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape.png", "id": "1524760081483769", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974531_1524760084817102_6497712644828891067_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=22CibaUnaaEQ7kNvwG4plJ3&_nc_oc=AdoBDIG26vUVIFoJx9ykwN5n3I2S_Dp2p4X6pPY3KLuXEoD7EjNFh_Oxj94sATaQfaY&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyTH5HR6Ld6zam47LHlmSsFp2WLjNpwrhTjsBZVg3ecyA&oe=69C66C6F"}, "display_name": "Mystery Box VR: Hidden Secrets", "keywords": [], "long_description": " AN IMMERSIVE VR PUZZLE EXPERIENCE\nInteract with objects, handles, buttons, and wheels on each side. Crack enigmas and collect hidden puzzle tiles on a random side of the boxes.\n\nYou won't be able to compare reality with fiction.\n\n# DISCOVER INVENTIONS\nOnce you unlock all 8 boxes of a Level Pack, you can compose a puzzle and discover a brief history of an invention.\n\nIt's not always easy to escape the room, so use all your IQ to crack the riddles. There's a logic behind all of them, even where it seems it's not!\n\n# IMMERSIVE SOUNDTRACK\nPlay the game with your headphones to get immersed in this amazing adventure.\n\n# HINTS\nGot stuck on some enigma? No worries, you can still get a helpful hint! You can also get in touch with me in case you really can't make it through a riddle, I'll be glad to help ;)\n\n# MULTILANGUAGE\nAvailable in English, French, Italian, German, Spanish, Russian, and Japanese.\n\nThe game language will change automatically based on the language settings of your device", "short_description": "A VR escape room game where you have to solve intriguing riddles to open boxes and discover nice stories about popular inventions!"}, {"images": {"nodes": [{"file_name": "$R36BSY5.png", "id": "3678762505771822", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39031430_3678762509105155_2151975047074617165_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kMYLg0x_3NgQ7kNvwFxptru&_nc_oc=Adp4wLvc6Wb-qnMWGYb8XO2U3lBvKE3AvhqMzNVN1B7npUzXA1GPocdVXvHRLM0FMa0&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afx41ibU5B7iSuWYRwSZ9evib-OROAWiPqpMD1sjM5xwIQ&oe=69C66865"}, {"file_name": "$R81V725.png", "id": "2720695481426567", "image_type": "APP_IMG_ICON", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/75262743_2720695484759900_604086922326600035_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=--M8Bprnd7kQ7kNvwFG9wV0&_nc_oc=Adp7pikNzSPEkAj2SylW2VC_CSkYWMXGur1XmQUpuQJYdczNwiXKhHzUGoZwn51pJmY&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxWGYRHevJjpbPQILP8i8fBJv5ZgGWEYryT1j_FOuBvzw&oe=69C6674D"}, {"file_name": "$RQ3SN6U.png", "id": "1552311425628973", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38982519_1552311428962306_1218130395049083834_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sKuaDkgnPesQ7kNvwGNP2rV&_nc_oc=AdpEYexNMRZEb2TCDzzofgtULDKv4ttuNQmtZjbpN-lNDo6ekNopZf8qf84wFjki3zQ&_nc_zt=3&_nc_ht=
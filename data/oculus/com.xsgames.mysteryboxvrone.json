IKNO8ifGTnQqR1VY2wBbFiOsEDuDzdBO2j17iVqq7zLQ&oe=6ABA8444"}, {"file_name": "5.png", "id": "467916352871409", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39003282_467916356204742_1871921057092171900_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1UwAcoGgqqYQ7kNvwE9_YL2&_nc_oc=AdoBETOApPJ6x_5lgEm7csbjgGBJqnsg94TDpyx_csRJw6Sn1uctT5eNAbg-ouYkCKU&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJT2zUCGsKFXBDFTsEZ2buCmpWdRIzaKG80tHe3zf1U7A&oe=6ABA68E2"}, {"file_name": "3.png", "id": "1934382610375855", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974473_1934382613709188_7156337812617042679_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0wZ_wo7bdUIQ7kNvwGIMMRX&_nc_oc=AdonH7dfYNVMzuvCgvb6vPTAQBiUg6-J1tTHuFSodSI-VKvY1S8HBoQZf20sQRL1R2c&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK4W_A5QDtp2Wvb2TlQ6fROJFZts9c8VMP1Rz1hAg1EWQ&oe=6ABA8B33"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape.png", "id": "1524760081483769", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974531_1524760084817102_6497712644828891067_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fRt1lxEZQoUQ7kNvwHjSiiK&_nc_oc=AdqONVyoRltycl8dwDNfj6sUWDL_VoPIqKmReIarTD8ntHQH3GO7LdLWK5b0BPqV0hc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJhA-LHbBJfBZ1v2FCS0FxjYDKDRYxIiXxupsVscUQyOg&oe=6ABA8A2F"}, "display_name": "Mystery Box VR: Hidden Secrets", "keywords": [], "long_description": " AN IMMERSIVE VR PUZZLE EXPERIENCE\nInteract with objects, handles, buttons, and wheels on each side. Crack enigmas and collect hidden puzzle tiles on a random side of the boxes.\n\nYou won't be able to compare reality with fiction.\n\n# DISCOVER INVENTIONS\nOnce you unlock all 8 boxes of a Level Pack, you can compose a puzzle and discover a brief history of an invention.\n\nIt's not always easy to escape the room, so use all your IQ to crack the riddles. There's a logic behind all of them, even where it seems it's not!\n\n# IMMERSIVE SOUNDTRACK\nPlay the game with your headphones to get immersed in this amazing adventure.\n\n# HINTS\nGot stuck on some enigma? No worries, you can still get a helpful hint! You can also get in touch with me in case you really can't make it through a riddle, I'll be glad to help ;)\n\n# MULTILANGUAGE\nAvailable in English, French, Italian, German, Spanish, Russian, and Japanese.\n\nThe game language will change automatically based on the language settings of your device", "short_description": "A VR escape room game where you have to solve intriguing riddles to open boxes and discover nice stories about popular inventions!"}, {"images": {"nodes": [{"file_name": "$R36BSY5.png", "id": "3678762505771822", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031430_3678762509105155_2151975047074617165_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FUhudNTv87kQ7kNvwG9t820&_nc_oc=AdrBL5oyqN4uXU3p0Xim0OFZa02NQrqVfJ2b8ff64DZlLjCqoe2JJiPT9PWZw6b5N2Q&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLQdt9WAAS3pFIyfpWq-dFLlzRbcdROCfl6DSdJNU5ETw&oe=6ABA8625"}, {"file_name": "$R81V725.png", "id": "2720695481426567", "image_type": "APP_IMG_ICON", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75262743_2720695484759900_604086922326600035_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZAr6iCLjBL4Q7kNvwEpFSN2&_nc_oc=Adoz5x6O_zyvbF0VkO_hT-Tf7wsj-m07uZhcfshYQgi5H1zqJSpLIQN3I7PSoKpfEDM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ1bwDpUqnOvpUbQJ-pus10Pp5rBSnSJn2m7z9ni4_PxA&oe=6ABA850D"}, {"file_name": "$RQ3SN6U.png", "id": "1552311425628973", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982519_1552311428962306_1218130395049083834_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U9KL9ecHVVIQ7kNvwF3k7Iv&_nc_oc=AdrPutdIVcjP-Z12mAnrlZOTscwU7RMkcmKTLfjCFoAU4boX2-Cv-I6JGV2D7drESN8&_nc_zt=3&_nc_ht=
Lx8ILzZalifLhK5F884Nob3YHnwCq7ckft1cFL9SyrOg&oe=6AB932C4"}, {"file_name": "5.png", "id": "467916352871409", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39003282_467916356204742_1871921057092171900_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UBWBABwaq3QQ7kNvwEo1-Un&_nc_oc=Adpd58C7FwCberoJIhdOhdJdrIMrjvGQxWUFRTIPX38SkDNiuKOjYhZ5oRz7jgwclss&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLvqgTCUq0eglFWZ9V7kkk6ijCXe0FBW8GGNOgtSfUdSA&oe=6AB91762"}, {"file_name": "3.png", "id": "1934382610375855", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974473_1934382613709188_7156337812617042679_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0wZ_wo7bdUIQ7kNvwGiDGaa&_nc_oc=AdqgWHuaMNMELa6mrovIDRTFt78AdS2C2ftlu9-E7pcy7YmKJtEIwkLe_YisRkt4ssA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIy_0ZBtIvOhPTNYI4AeXDa7qy5IhqgdSLRqIVbqevn9g&oe=6AB939B3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape.png", "id": "1524760081483769", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974531_1524760084817102_6497712644828891067_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7Jof5wr8ZNsQ7kNvwFtsOAN&_nc_oc=AdpGeWqcgSZKo40_7kHK7196B8mYz7Drig33iBolRedT2b4P0eK_4fOngBPtSuNWyyM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLRcguVcfxW3eLoUsvk3uqMVh5_EDe6XpPLCtKubc4_Sg&oe=6AB938AF"}, "display_name": "Mystery Box VR: Hidden Secrets", "keywords": [], "long_description": " AN IMMERSIVE VR PUZZLE EXPERIENCE\nInteract with objects, handles, buttons, and wheels on each side. Crack enigmas and collect hidden puzzle tiles on a random side of the boxes.\n\nYou won't be able to compare reality with fiction.\n\n# DISCOVER INVENTIONS\nOnce you unlock all 8 boxes of a Level Pack, you can compose a puzzle and discover a brief history of an invention.\n\nIt's not always easy to escape the room, so use all your IQ to crack the riddles. There's a logic behind all of them, even where it seems it's not!\n\n# IMMERSIVE SOUNDTRACK\nPlay the game with your headphones to get immersed in this amazing adventure.\n\n# HINTS\nGot stuck on some enigma? No worries, you can still get a helpful hint! You can also get in touch with me in case you really can't make it through a riddle, I'll be glad to help ;)\n\n# MULTILANGUAGE\nAvailable in English, French, Italian, German, Spanish, Russian, and Japanese.\n\nThe game language will change automatically based on the language settings of your device", "short_description": "A VR escape room game where you have to solve intriguing riddles to open boxes and discover nice stories about popular inventions!"}, {"images": {"nodes": [{"file_name": "$R36BSY5.png", "id": "3678762505771822", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031430_3678762509105155_2151975047074617165_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FUhudNTv87kQ7kNvwHu-jq7&_nc_oc=AdqlxsJfbUsYc_tzfP47GARGKVWGsAm4Lflt2YZN3RB_ou1i5Lexp7OoTdfM3j4aUBk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKk9UjNJ0I4m1jzsvnEt8nyHOoGBfoalSVIEKJ-VkAJ0w&oe=6AB934A5"}, {"file_name": "$R81V725.png", "id": "2720695481426567", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75262743_2720695484759900_604086922326600035_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZAr6iCLjBL4Q7kNvwHPGLq_&_nc_oc=AdoWsvTreiqKwD3Gyb7bVa0vhVM0ZOGxj3kEdg_L959iX1-rNJRsSFg9CsanXHAFYjI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJkZt3Lv290aE2Nf0oZz8y51DdMDBokMbrigDj9kyFC7g&oe=6AB9338D"}, {"file_name": "$RQ3SN6U.png", "id": "1552311425628973", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982519_1552311428962306_1218130395049083834_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U9KL9ecHVVIQ7kNvwHamFLR&_nc_oc=AdonVWjFYoY9qNIA8_PYRRiQJi-Ks6zfMixxdlUGVoH1IRU3W3hcSF_kghnRjx8Shd4&_nc_zt=3&_nc_ht=
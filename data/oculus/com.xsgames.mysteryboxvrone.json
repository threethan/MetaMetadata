B9jZRc30oYqB3Kzl2MQ6Sh68qorkBvLxHmc_tFJuuPVw&oe=6A4A74C4"}, {"file_name": "5.png", "id": "467916352871409", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39003282_467916356204742_1871921057092171900_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2y8uKbGcf5IQ7kNvwHlga4_&_nc_oc=AdozJqlQLMR2XyiVX_X1_0CBRj4VfqtMtrhgPYCKZycAfTP6vB06zlRu9f3WL_KPzFA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAHJG74XbKNBNmbxlxYmct5vKxfu_RMy-gTm2rQWR_0OQ&oe=6A4A5962"}, {"file_name": "3.png", "id": "1934382610375855", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974473_1934382613709188_7156337812617042679_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2aJtXEJCZ-AQ7kNvwH9Qndd&_nc_oc=AdoK-tQAB_7HXAy7ETEEwkrIoowlcnksPALWQhyxRqe7x2YBvlXc00VvYI2V_Lyilnc&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCD5368YWKFLgUvkp3QevA6gyGez_ri8CpGeA12FvSKQQ&oe=6A4A7BB3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape.png", "id": "1524760081483769", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974531_1524760084817102_6497712644828891067_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P0-xFnl4IacQ7kNvwHIvfNm&_nc_oc=AdqTU4Eba4iJGRO-T_oWr3epF24ZMFQpJ1ZD6i5pvQYs1nSAqPmbi1AjzC-WaMPvBos&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC0g2NbEPe5FVtvKrxDOJwWji-TkjJQR9nLuUS2uOfGCw&oe=6A4A7AAF"}, "display_name": "Mystery Box VR: Hidden Secrets", "keywords": [], "long_description": " AN IMMERSIVE VR PUZZLE EXPERIENCE\nInteract with objects, handles, buttons, and wheels on each side. Crack enigmas and collect hidden puzzle tiles on a random side of the boxes.\n\nYou won't be able to compare reality with fiction.\n\n# DISCOVER INVENTIONS\nOnce you unlock all 8 boxes of a Level Pack, you can compose a puzzle and discover a brief history of an invention.\n\nIt's not always easy to escape the room, so use all your IQ to crack the riddles. There's a logic behind all of them, even where it seems it's not!\n\n# IMMERSIVE SOUNDTRACK\nPlay the game with your headphones to get immersed in this amazing adventure.\n\n# HINTS\nGot stuck on some enigma? No worries, you can still get a helpful hint! You can also get in touch with me in case you really can't make it through a riddle, I'll be glad to help ;)\n\n# MULTILANGUAGE\nAvailable in English, French, Italian, German, Spanish, Russian, and Japanese.\n\nThe game language will change automatically based on the language settings of your device", "short_description": "A VR escape room game where you have to solve intriguing riddles to open boxes and discover nice stories about popular inventions!"}, {"images": {"nodes": [{"file_name": "$R36BSY5.png", "id": "3678762505771822", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031430_3678762509105155_2151975047074617165_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MdtFJHqOlJIQ7kNvwE_jVb2&_nc_oc=Adpvn4szY5-cjp3OEY6FYDD_YWFDDJPPKi8EkKlkbAfO6wPdEM6NOW64zc6kGTOG5ZI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCpc3cyuEwNi3lyjR93l6K2fEDWIqBuDSRbC3EMr9_ihg&oe=6A4A76A5"}, {"file_name": "$R81V725.png", "id": "2720695481426567", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75262743_2720695484759900_604086922326600035_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LYLqFUqlb34Q7kNvwGYvFS0&_nc_oc=AdqmNh1Mw5G99zPLXD-YhXom5rnTkH7qitsRH10gNLAmj-t153oPkoiYsRGA4O-2yek&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC0tTwJjSgqhkpdDQI3xDq7fN_S40UF9Blesk2lItTD6A&oe=6A4A758D"}, {"file_name": "$RQ3SN6U.png", "id": "1552311425628973", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982519_1552311428962306_1218130395049083834_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CsH5IP9sg3YQ7kNvwHk3EBN&_nc_oc=AdobE1XdV3lcnoDW5BRp4dfzGLwbQC-WB8iIVeQGWv_P5wLeuAzjNk8PNZdoUTiYSQg&_nc_zt=3&_nc_ht=
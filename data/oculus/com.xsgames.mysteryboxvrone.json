QTzEH_Aci148p3GY5dWPATC3cVsWFahHH06z31Z5L-Ag&oe=6AF87AC4"}, {"file_name": "5.png", "id": "467916352871409", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39003282_467916356204742_1871921057092171900_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=10pBO92NHhEQ7kNvwHiAVVP&_nc_oc=Adr3ein70NqzgEOX7sji53gKfBe_7fQXS0z7xJjCxnD6c3CHvsr-63u7D0dYn8a1UIk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSq68DSl5QQyzg4WYyWpFds4NP5LTJJ70S8AbdMxRctEg&oe=6AF897A2"}, {"file_name": "3.png", "id": "1934382610375855", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974473_1934382613709188_7156337812617042679_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tgn9IGp_05YQ7kNvwHKCuH9&_nc_oc=AdrKzF2xGFuin8CMuLPdVzDPYuZo3zZW9F6gWTSHu4x6vmmx6574CSFn1ZhWQcc10Ok&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTveypmfqy_SfcoORbDcWOCp34-TuviWY_n59epLUUERw&oe=6AF881B3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape.png", "id": "1524760081483769", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974531_1524760084817102_6497712644828891067_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m-RqDXosyyIQ7kNvwGl3U2C&_nc_oc=AdqJsCHLJcUWxWTXbPuyV7yow0Mr3lngmT7n4GEpfKNvvV6rlgP1pbHAyNj9MdnAlNA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTI8blyhnU2gstMKTHXh2fHUUHrZEoTi2Tqq8SNzhy-tQ&oe=6AF880AF"}, "display_name": "Mystery Box VR: Hidden Secrets", "keywords": [], "long_description": " AN IMMERSIVE VR PUZZLE EXPERIENCE\nInteract with objects, handles, buttons, and wheels on each side. Crack enigmas and collect hidden puzzle tiles on a random side of the boxes.\n\nYou won't be able to compare reality with fiction.\n\n# DISCOVER INVENTIONS\nOnce you unlock all 8 boxes of a Level Pack, you can compose a puzzle and discover a brief history of an invention.\n\nIt's not always easy to escape the room, so use all your IQ to crack the riddles. There's a logic behind all of them, even where it seems it's not!\n\n# IMMERSIVE SOUNDTRACK\nPlay the game with your headphones to get immersed in this amazing adventure.\n\n# HINTS\nGot stuck on some enigma? No worries, you can still get a helpful hint! You can also get in touch with me in case you really can't make it through a riddle, I'll be glad to help ;)\n\n# MULTILANGUAGE\nAvailable in English, French, Italian, German, Spanish, Russian, and Japanese.\n\nThe game language will change automatically based on the language settings of your device", "short_description": "A VR escape room game where you have to solve intriguing riddles to open boxes and discover nice stories about popular inventions!"}, {"images": {"nodes": [{"file_name": "$R36BSY5.png", "id": "3678762505771822", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031430_3678762509105155_2151975047074617165_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Eejqr2YHEMAQ7kNvwHYzYp3&_nc_oc=Adpb1o-uIZ8ljucDYcX5DZzW35R6BXwy19ZwV1yilhTcdWvNaPXGqDo_KVv1zr01mO0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTJUI2xItl69h-aMzLIEi6OQegBVu-UmKtx1DdKCjrzog&oe=6AF87CA5"}, {"file_name": "$R81V725.png", "id": "2720695481426567", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75262743_2720695484759900_604086922326600035_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ueno0W4_KYcQ7kNvwG5LrOB&_nc_oc=AdpjTsFS8nGaMiIzEmTQ1ES5RD4Ns-tc7WsGU1Q_Jrt7yokW--S22Pvi1KFLIvKgPpo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSMrPR2r1MV-bryplA9WzuCJ4Q6eS0oqRNneI3S98QZdQ&oe=6AF87B8D"}, {"file_name": "$RQ3SN6U.png", "id": "1552311425628973", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982519_1552311428962306_1218130395049083834_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vSPJdjLqdawQ7kNvwHMVioB&_nc_oc=AdqtiqOxyIgPDILLBaMB2Jwhcz7zlDbBJBE8MCcVkxY7P1bz-wjI2kt5tLSLeEvY6SA&_nc_zt=3&_nc_ht=
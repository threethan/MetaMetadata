nc_ss=7f20f&oh=00_Af9lmLC0QhKU7LM3WSOqNCFgB9dUMa4xSGvYuPAsDGXiGQ&oe=6A36AE44"}, {"file_name": "5.png", "id": "467916352871409", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/39003282_467916356204742_1871921057092171900_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n9qQJxf_BmUQ7kNvwEibhck&_nc_oc=Adpg95hDjF_268XGIgHaT6zxh-eVwcjkNy9dqBmVF2hfzHpCRmOFxrslu-ixSseZYQM&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-r4n4qNW8496ZzNRMox-9OKuEsqzZ9FzOF6Anhr623PA&oe=6A3692E2"}, {"file_name": "3.png", "id": "1934382610375855", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/38974473_1934382613709188_7156337812617042679_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MsTwwUSP5yoQ7kNvwGggeDQ&_nc_oc=Adpr9OcsAR8TfX9kVB-qti8kGtfd0C34ifKXn5GJ_8gTyugvbtXyO9pVkr8k5LiW-00&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-HUiOGdh7KcZ70cK-yAhlorTq9bYUxKumsNJPqyHD8FQ&oe=6A36B533"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape.png", "id": "1524760081483769", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/38974531_1524760084817102_6497712644828891067_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IhQwZg4qoCoQ7kNvwHGGlSO&_nc_oc=AdoMVfmmOXtPbFabJJJMDifaj_Ny8SFiFtHO0JiDRi-xQ2GllNL1RBGrBTJPwYFPlHA&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af984msD6FIWjUX9opPMV5EnPbD1e-6rT6HjjH8wjmh0tA&oe=6A36B42F"}, "display_name": "Mystery Box VR: Hidden Secrets", "keywords": [], "long_description": " AN IMMERSIVE VR PUZZLE EXPERIENCE\nInteract with objects, handles, buttons, and wheels on each side. Crack enigmas and collect hidden puzzle tiles on a random side of the boxes.\n\nYou won't be able to compare reality with fiction.\n\n# DISCOVER INVENTIONS\nOnce you unlock all 8 boxes of a Level Pack, you can compose a puzzle and discover a brief history of an invention.\n\nIt's not always easy to escape the room, so use all your IQ to crack the riddles. There's a logic behind all of them, even where it seems it's not!\n\n# IMMERSIVE SOUNDTRACK\nPlay the game with your headphones to get immersed in this amazing adventure.\n\n# HINTS\nGot stuck on some enigma? No worries, you can still get a helpful hint! You can also get in touch with me in case you really can't make it through a riddle, I'll be glad to help ;)\n\n# MULTILANGUAGE\nAvailable in English, French, Italian, German, Spanish, Russian, and Japanese.\n\nThe game language will change automatically based on the language settings of your device", "short_description": "A VR escape room game where you have to solve intriguing riddles to open boxes and discover nice stories about popular inventions!"}, {"images": {"nodes": [{"file_name": "$R36BSY5.png", "id": "3678762505771822", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/39031430_3678762509105155_2151975047074617165_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UDvKE-eNqykQ7kNvwEv63L0&_nc_oc=Adojtzt7ZZI9M-Kk0At8fCct5q1tXXmCRX7BPD1Y1Cv4VqnERYVEBD5y7at2jWcu0GQ&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af881l4iTiGXID9pydnh0UJ9S3bhAR45Q3yhQnHVITUfKw&oe=6A36B025"}, {"file_name": "$R81V725.png", "id": "2720695481426567", "image_type": "APP_IMG_ICON", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/75262743_2720695484759900_604086922326600035_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aZi5efE1pEAQ7kNvwEYkKvW&_nc_oc=AdoXGlrJQfpWOvgZwUqb3Ba6btlkvc801z5u3OWI4sUbLc_FIFCViyA_KNB9HyNwJoI&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9B8xijLV5-vg9hH_TbYHN2HQYnaFLPtLvczD3aW4W8Ug&oe=6A36AF0D"}, {"file_name": "$RQ3SN6U.png", "id": "1552311425628973", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/38982519_1552311428962306_1218130395049083834_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dgu9dmo4AJIQ7kNvwFJ7f55&_nc_oc=AdqnjASWHJOLLdAoKu5BEXLsROxkDU8b5hhE9lPdDtXm5rXJyOLIxhRyoicp
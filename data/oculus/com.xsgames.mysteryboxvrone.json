NrDAAII_I7fVNTFZvC0H--KenWtFwSlJfq1aM3GwK5zw&oe=6AC661C4"}, {"file_name": "5.png", "id": "467916352871409", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39003282_467916356204742_1871921057092171900_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Fx3N4IMeC0EQ7kNvwHw9FJw&_nc_oc=AdpghzTpr4ujdzH_OnN0fByDzNTOJnHhkRrtTfLKXhptcsdWirpdtLGHXEo9HR0xVpA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM4KDXcKi-bmMwvXSElcYUHAhqNlq1K2Ugmq4WKHHtQnA&oe=6AC64662"}, {"file_name": "3.png", "id": "1934382610375855", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974473_1934382613709188_7156337812617042679_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8sBy9lDNLWwQ7kNvwG7KobH&_nc_oc=AdocPBmMF-2kjJo524D1xerQp8_chQ4hnBNq13g0jXhmBYl16X-I1jWdkxVoT5HuFmk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPT3Yc1HNOxlYbddpeG08sexx0z31YAkre5VROqd_z5EA&oe=6AC668B3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape.png", "id": "1524760081483769", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974531_1524760084817102_6497712644828891067_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Qm77SO_d7RAQ7kNvwHXWWV8&_nc_oc=AdpAT9lhJLhP5FZjfIwF4zfHDgw3z-q_jY63XLWLZ9YXQRkyyZCn0t30MXMSdFDJOmw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPHhTNas4GbfZF8V4eio5TNzE1ilZNFICuJih33sGV9rg&oe=6AC667AF"}, "display_name": "Mystery Box VR: Hidden Secrets", "keywords": [], "long_description": " AN IMMERSIVE VR PUZZLE EXPERIENCE\nInteract with objects, handles, buttons, and wheels on each side. Crack enigmas and collect hidden puzzle tiles on a random side of the boxes.\n\nYou won't be able to compare reality with fiction.\n\n# DISCOVER INVENTIONS\nOnce you unlock all 8 boxes of a Level Pack, you can compose a puzzle and discover a brief history of an invention.\n\nIt's not always easy to escape the room, so use all your IQ to crack the riddles. There's a logic behind all of them, even where it seems it's not!\n\n# IMMERSIVE SOUNDTRACK\nPlay the game with your headphones to get immersed in this amazing adventure.\n\n# HINTS\nGot stuck on some enigma? No worries, you can still get a helpful hint! You can also get in touch with me in case you really can't make it through a riddle, I'll be glad to help ;)\n\n# MULTILANGUAGE\nAvailable in English, French, Italian, German, Spanish, Russian, and Japanese.\n\nThe game language will change automatically based on the language settings of your device", "short_description": "A VR escape room game where you have to solve intriguing riddles to open boxes and discover nice stories about popular inventions!"}, {"images": {"nodes": [{"file_name": "$R36BSY5.png", "id": "3678762505771822", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031430_3678762509105155_2151975047074617165_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W6eyVsav-YQQ7kNvwEzU6jV&_nc_oc=AdrYnsww2rnfGwD9290dT7gQ-2EJkZb3QEK03gbNgh_DgzO6Ph_OUNU41Lqn41zZmDY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMpooqNSIC0DnWozlQgOb-EjYe9HH0atDp5kDJot13trg&oe=6AC663A5"}, {"file_name": "$R81V725.png", "id": "2720695481426567", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75262743_2720695484759900_604086922326600035_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FdRHVNHxXhAQ7kNvwGy81cJ&_nc_oc=AdrraZDD27LZ3QQVnlRBGGj1HmA8ydoKBksA9L-_cZawXEbnIsIH055HvpupKrV7IBE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOjA2aRVxQ6Y0-TDFTxgmBsqBUnI2dXsKOKXhsDLQE09Q&oe=6AC6628D"}, {"file_name": "$RQ3SN6U.png", "id": "1552311425628973", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982519_1552311428962306_1218130395049083834_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L8YQnxG372cQ7kNvwF1n_Rs&_nc_oc=Adq4UrCFw3zbiLB5XLu0HtLasf6XtDFFo28IAu866DGqTCdrAGa2gudPqV8S1VA_gqc&_nc_zt=3&_nc_ht=
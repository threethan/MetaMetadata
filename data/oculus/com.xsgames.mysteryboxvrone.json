PcoxRcA7KOWcNUzPJ188MtCbbmKayfLqTYfq7y3rC8Vw&oe=6AC3BEC4"}, {"file_name": "5.png", "id": "467916352871409", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39003282_467916356204742_1871921057092171900_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c9ONxuIER0IQ7kNvwFXA4v_&_nc_oc=AdrgntZ3RtHaTjf3k2yK2xSGY023WpPl0-cmibblmdStaWOpxZJ11mhh82g6pAjW7Eg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO4TUTgZxD9PARRyBvFASFwsA5-C6S2AZqMBcDWsf68gQ&oe=6AC3DBA2"}, {"file_name": "3.png", "id": "1934382610375855", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974473_1934382613709188_7156337812617042679_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_iSw7HZJllgQ7kNvwFXE-Vy&_nc_oc=Adrsm4y0gx_Fl56nBDnxPOWCAWNBYCfKQ530mXjkBxdTmq3txmig7VFsO6R9gHSlb3U&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP7IDaTZXvkFrWW1hyOW_veM1P8FlYpIwjprx_HDahGLQ&oe=6AC3C5B3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape.png", "id": "1524760081483769", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974531_1524760084817102_6497712644828891067_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xcRMDoes9IkQ7kNvwHxhfR0&_nc_oc=AdrhFc87i1YSllYcRYwi3TyhGFoMRZ1nXLJ0oySJsrvX3qaKb9D9J5AXU83ugx1FuEc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMIyu8i3kcGgpBA6iWXKIVabMJy38R7GsEfZEJc-Lk8OQ&oe=6AC3C4AF"}, "display_name": "Mystery Box VR: Hidden Secrets", "keywords": [], "long_description": " AN IMMERSIVE VR PUZZLE EXPERIENCE\nInteract with objects, handles, buttons, and wheels on each side. Crack enigmas and collect hidden puzzle tiles on a random side of the boxes.\n\nYou won't be able to compare reality with fiction.\n\n# DISCOVER INVENTIONS\nOnce you unlock all 8 boxes of a Level Pack, you can compose a puzzle and discover a brief history of an invention.\n\nIt's not always easy to escape the room, so use all your IQ to crack the riddles. There's a logic behind all of them, even where it seems it's not!\n\n# IMMERSIVE SOUNDTRACK\nPlay the game with your headphones to get immersed in this amazing adventure.\n\n# HINTS\nGot stuck on some enigma? No worries, you can still get a helpful hint! You can also get in touch with me in case you really can't make it through a riddle, I'll be glad to help ;)\n\n# MULTILANGUAGE\nAvailable in English, French, Italian, German, Spanish, Russian, and Japanese.\n\nThe game language will change automatically based on the language settings of your device", "short_description": "A VR escape room game where you have to solve intriguing riddles to open boxes and discover nice stories about popular inventions!"}, {"images": {"nodes": [{"file_name": "$R36BSY5.png", "id": "3678762505771822", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031430_3678762509105155_2151975047074617165_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W6eyVsav-YQQ7kNvwGD_qRV&_nc_oc=Adob245LKcMwAbhUEzjEEq0BWsJPq0db2G-6_BQr5NMb_IHzZgh-qE46KxYw9SrQnn4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPTyd03WnGfEGlRjfyt9hx1-AagCSZ55LxUzISoHv9QXw&oe=6AC3C0A5"}, {"file_name": "$R81V725.png", "id": "2720695481426567", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75262743_2720695484759900_604086922326600035_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CkWDAycxBMMQ7kNvwEudsAh&_nc_oc=AdqQrU0HbcKz8_hjBHkkjdtFcN8-31DnSYY5lPpgVoB9DTiJJ1Q4PmrIRaQF-LNqs3I&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNNxw6_R65EeMbZif8Zh1x7FxL1ubv_QziF5T1_tX3znA&oe=6AC3BF8D"}, {"file_name": "$RQ3SN6U.png", "id": "1552311425628973", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982519_1552311428962306_1218130395049083834_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L8YQnxG372cQ7kNvwHgZiZy&_nc_oc=AdoC-OrkzJ8ZSbv2h9CyIXrQymKTVD9L4_M9RauJXZOpwfyDXGPDdxAc-s9PhLqbRqw&_nc_zt=3&_nc_ht=
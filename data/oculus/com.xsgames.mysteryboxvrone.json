OZItBmHKTXN8rnCI20W2tQ2Nh775HRHpLkJKuCjqD08Q&oe=6ACE4AC4"}, {"file_name": "5.png", "id": "467916352871409", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39003282_467916356204742_1871921057092171900_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hUGMmn9zWBYQ7kNvwGLajrF&_nc_oc=Adpvi_avP9abjDya3q-g_ZkYH3UHZlnfVkPnm9dcq1q-up01voLPKXVFNI6uwr54hPg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP0qg-U-Z-YdhlZosM63w63YdB98TFb8E2itwDHgjDCwA&oe=6ACE67A2"}, {"file_name": "3.png", "id": "1934382610375855", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974473_1934382613709188_7156337812617042679_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8F2qVGXjIc8Q7kNvwGbClZo&_nc_oc=Adpfcj7X6D0ZdVpOmHpHQg0WNa97dKAqWbkxIzJbj-Zhuhgl9PcK1a-LgeXIfeEA8EM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM2bEssx37sbCm6l3x2f_kdGn49MDkigZINGlcJEd6NDg&oe=6ACE51B3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape.png", "id": "1524760081483769", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974531_1524760084817102_6497712644828891067_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eyg-K22Kxc8Q7kNvwHaOWGD&_nc_oc=Adpjj3eoJV196sZzihf3yJGqqhXaqpGBMTdvjbBJg3YC30euGXV9itVv0YSa9rS83mY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO135dHaU487qluUZ4fSkKWEu7jxSpPNZtKbfUye88g9A&oe=6ACE50AF"}, "display_name": "Mystery Box VR: Hidden Secrets", "keywords": [], "long_description": " AN IMMERSIVE VR PUZZLE EXPERIENCE\nInteract with objects, handles, buttons, and wheels on each side. Crack enigmas and collect hidden puzzle tiles on a random side of the boxes.\n\nYou won't be able to compare reality with fiction.\n\n# DISCOVER INVENTIONS\nOnce you unlock all 8 boxes of a Level Pack, you can compose a puzzle and discover a brief history of an invention.\n\nIt's not always easy to escape the room, so use all your IQ to crack the riddles. There's a logic behind all of them, even where it seems it's not!\n\n# IMMERSIVE SOUNDTRACK\nPlay the game with your headphones to get immersed in this amazing adventure.\n\n# HINTS\nGot stuck on some enigma? No worries, you can still get a helpful hint! You can also get in touch with me in case you really can't make it through a riddle, I'll be glad to help ;)\n\n# MULTILANGUAGE\nAvailable in English, French, Italian, German, Spanish, Russian, and Japanese.\n\nThe game language will change automatically based on the language settings of your device", "short_description": "A VR escape room game where you have to solve intriguing riddles to open boxes and discover nice stories about popular inventions!"}, {"images": {"nodes": [{"file_name": "$R36BSY5.png", "id": "3678762505771822", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031430_3678762509105155_2151975047074617165_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Q3clvNHtzocQ7kNvwEuSIFi&_nc_oc=AdpgccaQZOmAjSqCpxAAjlsAh5LSOxv0T1Vpp3ZXUQIDrsMzvPVG3Uq0fFwP7wxsvxc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOEbyHxu3KQ7g4uwtfGYNxKl22NNX3_Ayz8mEwQ5Ah3iw&oe=6ACE4CA5"}, {"file_name": "$R81V725.png", "id": "2720695481426567", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75262743_2720695484759900_604086922326600035_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-Z9abiq98bwQ7kNvwHMZk1P&_nc_oc=AdrmznIPOe_c5wi0ZayYAj4umaDM5vs8KB44PDA2SNWVcwJNJukGY7nTzlqtxMDIZ3M&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOjaDshtpyzAzX_QosLvi3Fen-dgr24u6x7_CYhIWb2mQ&oe=6ACE4B8D"}, {"file_name": "$RQ3SN6U.png", "id": "1552311425628973", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982519_1552311428962306_1218130395049083834_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4Miye65zFQUQ7kNvwFEEgxb&_nc_oc=AdouXGcZGG8z8fivmgZqQ3thKX-zQ9ZK2Hvh--8pUJDrY_7lTTmMO-SakQNvKV0LyzY&_nc_zt=3&_nc_ht=
3v4exlbZwN9ceuW42vDb3lXqPFupo9IQHDxLH1oU6Rrg&oe=69EF7D44"}, {"file_name": "5.png", "id": "467916352871409", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39003282_467916356204742_1871921057092171900_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jhoVSmIYNOwQ7kNvwFeYmlv&_nc_oc=AdolNw1bEHl1OytIJgF_O339OwP2UIdf5y6L1X0pEB9kkkSj3wZVZBrQzTQLb4_YVmY&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1_oyMwIlLZNVaMvkMcEHBYTjqsXP3Lg7DiYmuoRVLUcA&oe=69EF61E2"}, {"file_name": "3.png", "id": "1934382610375855", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974473_1934382613709188_7156337812617042679_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GBdKfpmO3FAQ7kNvwFRxJuO&_nc_oc=AdpjAVw0LlW3Ac65mvk1z5yLiq4a3Q8IPYHZaPjhDVL52aTcJs0n8G0Bm2CQRUjKKVM&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0dfGx9cSjIbVss_Mfp88G6qlUx6ImhMDfcP-Kf1yIRKQ&oe=69EF4BF3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape.png", "id": "1524760081483769", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974531_1524760084817102_6497712644828891067_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CClqrMKyiagQ7kNvwG2MX68&_nc_oc=AdoXaRr_BPjTLAPTiDVZIHmyhn3C7eJiCwwIEhSlNr8ZZIoLriN_tjZ5KHWJeohvcnc&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af36UnRNvcj1-zusQpb5q7JVBUY94f35VcZ7UMoFbnqObA&oe=69EF4AEF"}, "display_name": "Mystery Box VR: Hidden Secrets", "keywords": [], "long_description": " AN IMMERSIVE VR PUZZLE EXPERIENCE\nInteract with objects, handles, buttons, and wheels on each side. Crack enigmas and collect hidden puzzle tiles on a random side of the boxes.\n\nYou won't be able to compare reality with fiction.\n\n# DISCOVER INVENTIONS\nOnce you unlock all 8 boxes of a Level Pack, you can compose a puzzle and discover a brief history of an invention.\n\nIt's not always easy to escape the room, so use all your IQ to crack the riddles. There's a logic behind all of them, even where it seems it's not!\n\n# IMMERSIVE SOUNDTRACK\nPlay the game with your headphones to get immersed in this amazing adventure.\n\n# HINTS\nGot stuck on some enigma? No worries, you can still get a helpful hint! You can also get in touch with me in case you really can't make it through a riddle, I'll be glad to help ;)\n\n# MULTILANGUAGE\nAvailable in English, French, Italian, German, Spanish, Russian, and Japanese.\n\nThe game language will change automatically based on the language settings of your device", "short_description": "A VR escape room game where you have to solve intriguing riddles to open boxes and discover nice stories about popular inventions!"}, {"images": {"nodes": [{"file_name": "$R36BSY5.png", "id": "3678762505771822", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39031430_3678762509105155_2151975047074617165_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0-ojdQZ6QnAQ7kNvwEHPvEM&_nc_oc=AdqZUnOGOX05ADaOoIt2LYmEa4ETTNivubY3wi0V2M9ggGBEA_mfYZ23KxYrSQnRcSo&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1aB-v_CpCRHrKmYFNUfT-pcf3qZNSOvjfvz0tqNa5Iug&oe=69EF7F25"}, {"file_name": "$R81V725.png", "id": "2720695481426567", "image_type": "APP_IMG_ICON", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/75262743_2720695484759900_604086922326600035_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EO4_Bus1OAgQ7kNvwFwVW6a&_nc_oc=Adp1WgM7xvTG0JSDg48Z2DgXVBxgU77CY1fWqilweXuj0OR7CTexxD67fgWxWmxS4us&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1IyISyVxyD28gV8yt1Lkn3rZ5n7rBO1cIP8zwC4YqvCw&oe=69EF7E0D"}, {"file_name": "$RQ3SN6U.png", "id": "1552311425628973", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38982519_1552311428962306_1218130395049083834_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iG6gSn6Eyh8Q7kNvwGYB3ru&_nc_oc=AdoaEri_PK3HvKbHHIzruGH-oWTEbD9HJDvT7sqHkSwCkoHbyr_lHrGDHn0HVz8M_qA&_nc_zt=3&_nc_ht=
7lmHfL8XvHVzYhguzN4B1-y7BI8nkhGD6VJB8cgBoPAg&oe=69FA0944"}, {"file_name": "5.png", "id": "467916352871409", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39003282_467916356204742_1871921057092171900_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nyyUHmJAcX0Q7kNvwHSkBL9&_nc_oc=AdqKX_pcWxQogf0OhdL0P2J4e6h2-w7GAAD-kvm3hrX118uO--M9dzSfTl3BNVArukk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6UOafWSvIx1wz6xcD063wFXDaB89E4NBC_aSM1NeL_Wg&oe=69F9EDE2"}, {"file_name": "3.png", "id": "1934382610375855", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974473_1934382613709188_7156337812617042679_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4eVgmOC7lC8Q7kNvwFJPDgs&_nc_oc=Adoi7G3YEAN_M-qP8HJH_sYYnZ0M7OqBHD5izv1DQyyaO_LQ3RP0RdEU3PhMxuWlX_Y&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7yGFyt4mmYBtyZ4Hnx3g5Tp20XwawGfdnYIVD8XvpYng&oe=69FA1033"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape.png", "id": "1524760081483769", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974531_1524760084817102_6497712644828891067_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=naSaRH9zIMgQ7kNvwE2Jhgk&_nc_oc=AdqUu9p3Xl44kilvCA695N8vqtAWwCeO51dpE2-UhxpYQy80SQjcrDrhFltaDpeJKQU&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6G5ddG8_3cVZ7WBFCbum_rkgklieNzMqVOoXhSSPrz9w&oe=69FA0F2F"}, "display_name": "Mystery Box VR: Hidden Secrets", "keywords": [], "long_description": " AN IMMERSIVE VR PUZZLE EXPERIENCE\nInteract with objects, handles, buttons, and wheels on each side. Crack enigmas and collect hidden puzzle tiles on a random side of the boxes.\n\nYou won't be able to compare reality with fiction.\n\n# DISCOVER INVENTIONS\nOnce you unlock all 8 boxes of a Level Pack, you can compose a puzzle and discover a brief history of an invention.\n\nIt's not always easy to escape the room, so use all your IQ to crack the riddles. There's a logic behind all of them, even where it seems it's not!\n\n# IMMERSIVE SOUNDTRACK\nPlay the game with your headphones to get immersed in this amazing adventure.\n\n# HINTS\nGot stuck on some enigma? No worries, you can still get a helpful hint! You can also get in touch with me in case you really can't make it through a riddle, I'll be glad to help ;)\n\n# MULTILANGUAGE\nAvailable in English, French, Italian, German, Spanish, Russian, and Japanese.\n\nThe game language will change automatically based on the language settings of your device", "short_description": "A VR escape room game where you have to solve intriguing riddles to open boxes and discover nice stories about popular inventions!"}, {"images": {"nodes": [{"file_name": "$R36BSY5.png", "id": "3678762505771822", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031430_3678762509105155_2151975047074617165_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tbUdYHhM2rkQ7kNvwGrgtP5&_nc_oc=AdpRG8rPdAOdDa9UAaOm4v5SrJ74rcO0gVlIsITOecH5Bz5AOWyHST4pM-5Xdczb1jY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6txzDtYthUKu4owNbymh48E5SlA7rZss7dswA-aqdVJg&oe=69FA0B25"}, {"file_name": "$R81V725.png", "id": "2720695481426567", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75262743_2720695484759900_604086922326600035_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5BMvBEE7nxYQ7kNvwE9JAZ1&_nc_oc=Adoo5T7IHdg7bF4mNVdCbOgxGYmcbEp6knx2orz9ixZKGpuQlZaAs1lm8XWyl79_rnc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7W7--aICozrc-hUOzzr9iXOkriLaHa2k_6r88GY7o0nQ&oe=69FA0A0D"}, {"file_name": "$RQ3SN6U.png", "id": "1552311425628973", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982519_1552311428962306_1218130395049083834_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oY0fBImjCR4Q7kNvwF-PfbD&_nc_oc=AdrkZT_icC6qYW9Zf5hNb3n5w4_6PAAuHLP758NX60HskzA_G8c7SOgq70jtNmCT5o4&_nc_zt=3&_nc_ht=
z4jHWK8q6axIIlrKQwe00fV5nSe6-4ZVqToQTA1qQr4w&oe=69CBAC84"}, {"file_name": "5.png", "id": "467916352871409", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39003282_467916356204742_1871921057092171900_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2NL8YS9kwaQQ7kNvwEYuAIq&_nc_oc=Adp41n_78wXf0U45B6P5vRmOWZyaqS1iSA_FLx0EQFkEEd5va0RF0JFVePFNpfDdh5Y&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afx1PlEUquCyrTfgSJ6eLzgTEgc44SZBG7igT8LCB9xT4g&oe=69CBC962"}, {"file_name": "3.png", "id": "1934382610375855", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974473_1934382613709188_7156337812617042679_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=64YmulHcdHoQ7kNvwFhLxI2&_nc_oc=AdqTUzzawDCLYdxqtU5tHMkHH-NWSSHwip70fAgvLnuqdgi5Ulj5kYaurSo5yPw9w6E&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfycevHTZw4pLpBHwTb-DyDtzJgdlupLrcsLarkbd2Z86g&oe=69CBB373"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape.png", "id": "1524760081483769", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974531_1524760084817102_6497712644828891067_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kUIExVRwu0QQ7kNvwEGB2Lc&_nc_oc=AdonZHsi9pHG2cKaS9e6xV35krPdaXGzaR1Vtk58LmNMRawcUSzeNtCQnefp8_Vr2lM&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afzszjc5fW8HZtathxOBCVnJQrh3ESfzEzqzr93VtQT3QQ&oe=69CBB26F"}, "display_name": "Mystery Box VR: Hidden Secrets", "keywords": [], "long_description": " AN IMMERSIVE VR PUZZLE EXPERIENCE\nInteract with objects, handles, buttons, and wheels on each side. Crack enigmas and collect hidden puzzle tiles on a random side of the boxes.\n\nYou won't be able to compare reality with fiction.\n\n# DISCOVER INVENTIONS\nOnce you unlock all 8 boxes of a Level Pack, you can compose a puzzle and discover a brief history of an invention.\n\nIt's not always easy to escape the room, so use all your IQ to crack the riddles. There's a logic behind all of them, even where it seems it's not!\n\n# IMMERSIVE SOUNDTRACK\nPlay the game with your headphones to get immersed in this amazing adventure.\n\n# HINTS\nGot stuck on some enigma? No worries, you can still get a helpful hint! You can also get in touch with me in case you really can't make it through a riddle, I'll be glad to help ;)\n\n# MULTILANGUAGE\nAvailable in English, French, Italian, German, Spanish, Russian, and Japanese.\n\nThe game language will change automatically based on the language settings of your device", "short_description": "A VR escape room game where you have to solve intriguing riddles to open boxes and discover nice stories about popular inventions!"}, {"images": {"nodes": [{"file_name": "$R36BSY5.png", "id": "3678762505771822", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39031430_3678762509105155_2151975047074617165_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jnIfI89YnJAQ7kNvwE1MGrF&_nc_oc=AdqDqBQptB4ftKkrPyblABbW5eqR7bDQ0DFsLGhgA4oQUcr6jdvo4UaH5kyd4Jsz830&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwZR_7GAdnrPKg9E6wr7w94aemgKOXOog2fCqGUL4GcwQ&oe=69CBAE65"}, {"file_name": "$R81V725.png", "id": "2720695481426567", "image_type": "APP_IMG_ICON", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/75262743_2720695484759900_604086922326600035_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9VV7VRNjOqsQ7kNvwHDHl6C&_nc_oc=AdqfsfAVTiiJ7h9JuS78-teWChCkmYPfl_LdqJRpHpnMDbZtpr6avZuj9Ap_3mjvbU4&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Afwo4HijHUvHPyN-AL4ybMy6kuiFyvxEzOG4m5K_YGDnGQ&oe=69CBAD4D"}, {"file_name": "$RQ3SN6U.png", "id": "1552311425628973", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38982519_1552311428962306_1218130395049083834_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s37lZdS-BloQ7kNvwHE76s5&_nc_oc=AdrQ5I3lktth1yAtKm2S78BBBf4mwUMYxVnZYWDWJu4Ke3eMCPS6WMdtHoveJtRlR-k&_nc_zt=3&_nc_ht=
7KVnFKYOqodiFfCYD8kVDDQeTOVHwGd1Db7HN0cyGUKw&oe=6A1AFEC4"}, {"file_name": "5.png", "id": "467916352871409", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/39003282_467916356204742_1871921057092171900_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6XZGJYljMBoQ7kNvwHP1xjG&_nc_oc=Adq8j-2cXflsaqvhWnKmDjJSbCwHgfYsBW55LAqtranvd-OWmsYb3mlBvjQa9dRe-3s&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4VFDpD6MEjKgbfRKxIcMsi_aaAEuu49ykBcAz0xIDzxA&oe=6A1AE362"}, {"file_name": "3.png", "id": "1934382610375855", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/38974473_1934382613709188_7156337812617042679_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dupyzk9Tg-wQ7kNvwH6rHxO&_nc_oc=AdocybPbUupcxotjG-FDg1oQRERTlVxf7AHT6AIkGoEXWUHnmT7pEjQFveN7Pqt0QSc&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7HHM8ceaxPYmJm6U3iWFAgc2oE_4dPygBX6Hq47IPBTA&oe=6A1B05B3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape.png", "id": "1524760081483769", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/38974531_1524760084817102_6497712644828891067_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OFt5CveQvogQ7kNvwGmDYhw&_nc_oc=Adra7k0iUR9VDVfyKZBin2ED-f0mhdsU63oHAXJGhqQy9iOqC6sBTESrFVxgRmUVbNU&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6K0yDD9lPwv3YA7N7TaqdJRLEQrtSpfCjSXaJzi9VkCA&oe=6A1B04AF"}, "display_name": "Mystery Box VR: Hidden Secrets", "keywords": [], "long_description": " AN IMMERSIVE VR PUZZLE EXPERIENCE\nInteract with objects, handles, buttons, and wheels on each side. Crack enigmas and collect hidden puzzle tiles on a random side of the boxes.\n\nYou won't be able to compare reality with fiction.\n\n# DISCOVER INVENTIONS\nOnce you unlock all 8 boxes of a Level Pack, you can compose a puzzle and discover a brief history of an invention.\n\nIt's not always easy to escape the room, so use all your IQ to crack the riddles. There's a logic behind all of them, even where it seems it's not!\n\n# IMMERSIVE SOUNDTRACK\nPlay the game with your headphones to get immersed in this amazing adventure.\n\n# HINTS\nGot stuck on some enigma? No worries, you can still get a helpful hint! You can also get in touch with me in case you really can't make it through a riddle, I'll be glad to help ;)\n\n# MULTILANGUAGE\nAvailable in English, French, Italian, German, Spanish, Russian, and Japanese.\n\nThe game language will change automatically based on the language settings of your device", "short_description": "A VR escape room game where you have to solve intriguing riddles to open boxes and discover nice stories about popular inventions!"}, {"images": {"nodes": [{"file_name": "$R36BSY5.png", "id": "3678762505771822", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/39031430_3678762509105155_2151975047074617165_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gnfq_UQS5vgQ7kNvwH9q6hW&_nc_oc=AdqFjM14bZSUUTu-OhC6nTAyan9puLGsDNAZEmt9u1YXY-8iAlXEY-2k3UY3EEeI-Qg&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4EjZTgsmnBYu-i3lo0tAaIQVEe3h1qnueIi5C0p8tWmA&oe=6A1B00A5"}, {"file_name": "$R81V725.png", "id": "2720695481426567", "image_type": "APP_IMG_ICON", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/75262743_2720695484759900_604086922326600035_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Nwm9vbWAD4MQ7kNvwGi_4jo&_nc_oc=AdrufvlLWGTx952RZN-qQkkaurq4Ku6n_xL9kwjHngXvOI3kvXLvVn4J-V0dCqYW8jY&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6IF1CxwspRR0lvx4Iz7bBn9HUrcnQiwUbdptcYRrA1cQ&oe=6A1AFF8D"}, {"file_name": "$RQ3SN6U.png", "id": "1552311425628973", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/38982519_1552311428962306_1218130395049083834_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nO9WkHKaXTwQ7kNvwHQrq7g&_nc_oc=AdqnvENI7DHFChCc-bcTnu15kjN8fakQR4FzlTQKSMpXVWFnKim7aUWzJ-vGXvxDi-Y&_nc_zt=3&_nc_ht=
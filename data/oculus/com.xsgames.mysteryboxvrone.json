N61YMQEWXFen-PaYzNStjgVR0eFzmD6AguZVKYcyrqlA&oe=6AC11BC4"}, {"file_name": "5.png", "id": "467916352871409", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39003282_467916356204742_1871921057092171900_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QbkiB0DqVjAQ7kNvwGr2BJX&_nc_oc=AdoKaXz7mljAtMiemQui7zfcTYj4UPlvwcsy_J-JpWf-hd_ndXCMWSIZ8Y8BE5aEdUQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNBEsUErg216EzwmETU_aZte6FeDpqxmCjPtV2QWjOGhQ&oe=6AC10062"}, {"file_name": "3.png", "id": "1934382610375855", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974473_1934382613709188_7156337812617042679_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_iSw7HZJllgQ7kNvwHwUbqn&_nc_oc=AdqB9yzmct2i5JJXURl42fKCZixKUj_Qa6u38F9CFmXDj3GjhjgKYD7xIKiP22ktnHk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOv-9fCquKp-4JkBPJU40AEe6RkHh2tRVcmhweoXEg5Ng&oe=6AC122B3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape.png", "id": "1524760081483769", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974531_1524760084817102_6497712644828891067_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uc9g0X1OnS8Q7kNvwEIetIT&_nc_oc=AdoBZ1o5S9OegkhxELYuV9dMbImPfgxwuyTmjRWWjRYf-UWpDJH7RoUDG9j3WAGDDAA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPgD6xsaFkmensOga-70Xpr5zzMGey3-gpmTgnRZlLAQw&oe=6AC121AF"}, "display_name": "Mystery Box VR: Hidden Secrets", "keywords": [], "long_description": " AN IMMERSIVE VR PUZZLE EXPERIENCE\nInteract with objects, handles, buttons, and wheels on each side. Crack enigmas and collect hidden puzzle tiles on a random side of the boxes.\n\nYou won't be able to compare reality with fiction.\n\n# DISCOVER INVENTIONS\nOnce you unlock all 8 boxes of a Level Pack, you can compose a puzzle and discover a brief history of an invention.\n\nIt's not always easy to escape the room, so use all your IQ to crack the riddles. There's a logic behind all of them, even where it seems it's not!\n\n# IMMERSIVE SOUNDTRACK\nPlay the game with your headphones to get immersed in this amazing adventure.\n\n# HINTS\nGot stuck on some enigma? No worries, you can still get a helpful hint! You can also get in touch with me in case you really can't make it through a riddle, I'll be glad to help ;)\n\n# MULTILANGUAGE\nAvailable in English, French, Italian, German, Spanish, Russian, and Japanese.\n\nThe game language will change automatically based on the language settings of your device", "short_description": "A VR escape room game where you have to solve intriguing riddles to open boxes and discover nice stories about popular inventions!"}, {"images": {"nodes": [{"file_name": "$R36BSY5.png", "id": "3678762505771822", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031430_3678762509105155_2151975047074617165_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VN1PVFLY0nsQ7kNvwF7INfP&_nc_oc=AdpVzVqKgQs3r0E7xLkcPnAni45_Vcdtrs9BjtszFEhL9HZGrmUSVHqg7EzR_taN2kc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPeruTyJ9is8M4QEThCQvzkSjsn0kwTjgsiDUJuIj-FQA&oe=6AC11DA5"}, {"file_name": "$R81V725.png", "id": "2720695481426567", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75262743_2720695484759900_604086922326600035_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CkWDAycxBMMQ7kNvwHQ6y8y&_nc_oc=AdoT62qGx9UPE-ldRYQ7fd9adA9rtDca3vUrwbZ0DE4mf__euqWwhDZ_RBPB-51UwEE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO6fQCl_aN2g-FS56kqXdEipLCJw3qn0D1Iw_TwBHUytQ&oe=6AC11C8D"}, {"file_name": "$RQ3SN6U.png", "id": "1552311425628973", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982519_1552311428962306_1218130395049083834_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z-dCaHFidjIQ7kNvwHvkdyY&_nc_oc=AdqPZwI3Ikll7Dpqi_KudO1sJK-i7w9Gh6Gk-FfdtvkoxMK3bkvx1mIF71QI7MbkNG0&_nc_zt=3&_nc_ht=
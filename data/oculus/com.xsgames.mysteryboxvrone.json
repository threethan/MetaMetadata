_7sRNITzNDiDQjHg0W8ccmjtWAA-mHGIsHmdV-FaYxMg&oe=6A3E9744"}, {"file_name": "5.png", "id": "467916352871409", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39003282_467916356204742_1871921057092171900_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u-4cxe5SnLUQ7kNvwHH13Rr&_nc_oc=AdpFHfTcyJbW2oQnCUVzc4SPZ8ZD_03mY0T7nZuvfG97H03Fu3qOvyjjSYCidRXR5us&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9pAaOF3iW5d_ove-yHXY86vPJ_8LvXfvZ06r0jaBRbEw&oe=6A3E7BE2"}, {"file_name": "3.png", "id": "1934382610375855", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974473_1934382613709188_7156337812617042679_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xAXFgyuiGLoQ7kNvwHyys1m&_nc_oc=AdoIh0KY8ptLUS5BXe15pwu7IcWUl0Lwl0w7IMV8UiJg1ovjE1dGn4xpJqLfSejgiM8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-flA-Q5ggi2kZouBpQGBCMN2omI6cgr7Nme7qWRRD0bQ&oe=6A3E9E33"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape.png", "id": "1524760081483769", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974531_1524760084817102_6497712644828891067_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NJhhIyb9z-UQ7kNvwEoR5xZ&_nc_oc=Adp0ax5IReVoI7ykdiL6BxU5jieVQlWF3SixmBnTtxBcQHdxkCZ39nFqgpVn8aOdlpo&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_7iKDKAJ1GDbp0F5aIELL6E-BIGfOyPs1I4IMF8_7XKA&oe=6A3E9D2F"}, "display_name": "Mystery Box VR: Hidden Secrets", "keywords": [], "long_description": " AN IMMERSIVE VR PUZZLE EXPERIENCE\nInteract with objects, handles, buttons, and wheels on each side. Crack enigmas and collect hidden puzzle tiles on a random side of the boxes.\n\nYou won't be able to compare reality with fiction.\n\n# DISCOVER INVENTIONS\nOnce you unlock all 8 boxes of a Level Pack, you can compose a puzzle and discover a brief history of an invention.\n\nIt's not always easy to escape the room, so use all your IQ to crack the riddles. There's a logic behind all of them, even where it seems it's not!\n\n# IMMERSIVE SOUNDTRACK\nPlay the game with your headphones to get immersed in this amazing adventure.\n\n# HINTS\nGot stuck on some enigma? No worries, you can still get a helpful hint! You can also get in touch with me in case you really can't make it through a riddle, I'll be glad to help ;)\n\n# MULTILANGUAGE\nAvailable in English, French, Italian, German, Spanish, Russian, and Japanese.\n\nThe game language will change automatically based on the language settings of your device", "short_description": "A VR escape room game where you have to solve intriguing riddles to open boxes and discover nice stories about popular inventions!"}, {"images": {"nodes": [{"file_name": "$R36BSY5.png", "id": "3678762505771822", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031430_3678762509105155_2151975047074617165_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Nw7-df-V050Q7kNvwG7NTEm&_nc_oc=AdrS86l-lmPDFIwACv8Af7MoaR6PmSUCUv6i9P4wQU_zdfA6D5YPTJxG_UrUskhfCKE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-rqO_4SfvHAh0qlqZg7-szmnBHUhIWZd3M_V2A8uxs2Q&oe=6A3E9925"}, {"file_name": "$R81V725.png", "id": "2720695481426567", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75262743_2720695484759900_604086922326600035_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TYpfzZiyoPUQ7kNvwGaTWjG&_nc_oc=AdpJ-feXM7BRVFRMqbNztup-7X3ppoWrXW-e956HdaIRqk17s1-woKtrYbimZw38Bm0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8OQF8mXUWvfhsMnl-zOdXqUiVfUK8EKhyXDRUxYcuInw&oe=6A3E980D"}, {"file_name": "$RQ3SN6U.png", "id": "1552311425628973", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982519_1552311428962306_1218130395049083834_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ByUqvsrSJiEQ7kNvwFOh5vr&_nc_oc=AdpYvFxjBOdcpnJp4CfuW--lT_f4pqICdA6N19nn-7fPDrcNSVXmlzNq9t3YHlvQUY4&_nc_zt=3&_nc_ht=
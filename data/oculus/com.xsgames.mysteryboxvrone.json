DNy_N6k0qupWE4r7mM6Q3B1eKXGDnELxXtR02a7qZgSQ&oe=6A565244"}, {"file_name": "5.png", "id": "467916352871409", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/39003282_467916356204742_1871921057092171900_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LFCNeKMBjV8Q7kNvwEyBL9-&_nc_oc=AdpKAWAV65o3BnZZ082TtH10yFHWqnmgUnSwDo48ANxsTsAcLrqklWj46J_qBLCO7Kw&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCcUYKM2qviX4WW-pv8PSa6jC8vdtSbGPQiOBOIm2VAYg&oe=6A5636E2"}, {"file_name": "3.png", "id": "1934382610375855", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/38974473_1934382613709188_7156337812617042679_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=43uyPAhr6KYQ7kNvwGg_AW6&_nc_oc=AdqbmEdP_rqG-hdLuIopBYiNo6lnun6BSUbSoEr-f7TJDV8rbgPvmafGCtqGFPe-Hvk&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBz3yBx6CJKV0cyM9f1HGAd4UJkvCem8VrnGIC5LJR7jg&oe=6A565933"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape.png", "id": "1524760081483769", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/38974531_1524760084817102_6497712644828891067_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U4nHU9UqWhsQ7kNvwGWqYO7&_nc_oc=Adqcp6o5MeYfnqLKekx8hOalWouHjOuyS2-px086T4hc_gk3zw5jY3LJYu1x7NCnejs&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDcNkDX6jgXaIf9hdU8e-VI4R0UmGFgqldeVH_UpLb2FQ&oe=6A56582F"}, "display_name": "Mystery Box VR: Hidden Secrets", "keywords": [], "long_description": " AN IMMERSIVE VR PUZZLE EXPERIENCE\nInteract with objects, handles, buttons, and wheels on each side. Crack enigmas and collect hidden puzzle tiles on a random side of the boxes.\n\nYou won't be able to compare reality with fiction.\n\n# DISCOVER INVENTIONS\nOnce you unlock all 8 boxes of a Level Pack, you can compose a puzzle and discover a brief history of an invention.\n\nIt's not always easy to escape the room, so use all your IQ to crack the riddles. There's a logic behind all of them, even where it seems it's not!\n\n# IMMERSIVE SOUNDTRACK\nPlay the game with your headphones to get immersed in this amazing adventure.\n\n# HINTS\nGot stuck on some enigma? No worries, you can still get a helpful hint! You can also get in touch with me in case you really can't make it through a riddle, I'll be glad to help ;)\n\n# MULTILANGUAGE\nAvailable in English, French, Italian, German, Spanish, Russian, and Japanese.\n\nThe game language will change automatically based on the language settings of your device", "short_description": "A VR escape room game where you have to solve intriguing riddles to open boxes and discover nice stories about popular inventions!"}, {"images": {"nodes": [{"file_name": "$R36BSY5.png", "id": "3678762505771822", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/39031430_3678762509105155_2151975047074617165_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IIabnyfXwPwQ7kNvwHTr2xD&_nc_oc=Adra3Zs75768EC97R_A8mIQv8pzA4Y4qpXLIECix6hT_y2S5s6EI_8tdd3liWpnvd1o&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCvWlqszyC-rIinA_W9UY2yjlqSoxlyieOb7arV_O0dmw&oe=6A565425"}, {"file_name": "$R81V725.png", "id": "2720695481426567", "image_type": "APP_IMG_ICON", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/75262743_2720695484759900_604086922326600035_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gipQZ8cL2pMQ7kNvwEEwIsR&_nc_oc=AdpJt1fmY31gSN1vRTAwo5Zf_OtkO_avwcp36ALmBvUb102MpG73_-wvTsrKMhl5a88&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD5J2hsWKC9nWIbhiHLdyoq-INV36pbiayUJJ2H9PVthQ&oe=6A56530D"}, {"file_name": "$RQ3SN6U.png", "id": "1552311425628973", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/38982519_1552311428962306_1218130395049083834_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fsDcVZN9k5EQ7kNvwFINLaq&_nc_oc=AdoTPFpsk_D9vGlj0V8IZK2c2BbAv4iHvr1HIIfjRbklsWhtaOL7OmV3U7RDbQ4kgPc&_nc_zt=3&_nc_ht=
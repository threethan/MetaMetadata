3v4OD0Nqb5eua_UaVcJZIuZXrxMdlKmimMIjlU0DuhQA&oe=69EDF384"}, {"file_name": "5.png", "id": "467916352871409", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39003282_467916356204742_1871921057092171900_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jhoVSmIYNOwQ7kNvwGvcgA3&_nc_oc=Adq4d-bAEUNjrqV8dFTDwIQ3ZpfFOCyc_PPptKe3DNETpZFAULDE1f5cq7ozlhMnjFA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1d5zL8fTZuR1Ff5GGxptKH_ZgirWHy3zDxErYmSPl3QA&oe=69EE1062"}, {"file_name": "3.png", "id": "1934382610375855", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974473_1934382613709188_7156337812617042679_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dVkMoe2UiTwQ7kNvwFxVJ_O&_nc_oc=AdoGdN6HnYi4R1fTDL1lV8TsaqkemCA9i8KPZ1jmIAgHeALjH6hr6CFm5_EVpy8rxUA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3Ie6hcmTXxQvdSjy6DTNNt9BmwKVl43taqVJ311guJRA&oe=69EDFA73"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape.png", "id": "1524760081483769", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974531_1524760084817102_6497712644828891067_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CClqrMKyiagQ7kNvwHhBvhR&_nc_oc=AdqlTBDVHQlZ7ibvVwdgth2ALH4dTkwJdv6mIzvKoMC20nrBMej4xtT8sNTUwB3gQTw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1guhmnyFDBgyvUeiTTbb_II6n3oTDR6nI7HjFNkZcNCw&oe=69EDF96F"}, "display_name": "Mystery Box VR: Hidden Secrets", "keywords": [], "long_description": " AN IMMERSIVE VR PUZZLE EXPERIENCE\nInteract with objects, handles, buttons, and wheels on each side. Crack enigmas and collect hidden puzzle tiles on a random side of the boxes.\n\nYou won't be able to compare reality with fiction.\n\n# DISCOVER INVENTIONS\nOnce you unlock all 8 boxes of a Level Pack, you can compose a puzzle and discover a brief history of an invention.\n\nIt's not always easy to escape the room, so use all your IQ to crack the riddles. There's a logic behind all of them, even where it seems it's not!\n\n# IMMERSIVE SOUNDTRACK\nPlay the game with your headphones to get immersed in this amazing adventure.\n\n# HINTS\nGot stuck on some enigma? No worries, you can still get a helpful hint! You can also get in touch with me in case you really can't make it through a riddle, I'll be glad to help ;)\n\n# MULTILANGUAGE\nAvailable in English, French, Italian, German, Spanish, Russian, and Japanese.\n\nThe game language will change automatically based on the language settings of your device", "short_description": "A VR escape room game where you have to solve intriguing riddles to open boxes and discover nice stories about popular inventions!"}, {"images": {"nodes": [{"file_name": "$R36BSY5.png", "id": "3678762505771822", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031430_3678762509105155_2151975047074617165_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0-ojdQZ6QnAQ7kNvwHFPifA&_nc_oc=Adrjb3LXuSXjIQyo6Sa5D_X9srL2EvqGDDbxj9sgzZdM3NyfUQVJBjUkk4bLmowQn1Q&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0ARKg6Ca49YwXyz4U4sxMF8kWA_D2I2ZhFwH7wVK239w&oe=69EDF565"}, {"file_name": "$R81V725.png", "id": "2720695481426567", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75262743_2720695484759900_604086922326600035_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E-IvY6_8KpQQ7kNvwHh8PeG&_nc_oc=Adq1G4Ij1HBdk74zAefsZy9vMBgyaxz_atwdpyGvFIyRFLZZoPOQvGr3reLUQhDiSPk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2oaiy7G0crEXB9_ClezfANQF5wgIN0L_hccSNNFSbQMg&oe=69EDF44D"}, {"file_name": "$RQ3SN6U.png", "id": "1552311425628973", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982519_1552311428962306_1218130395049083834_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iG6gSn6Eyh8Q7kNvwFmLfcs&_nc_oc=AdroHy2YBVPBPwdZ1YIHtBUnCibNm0Y1Dk8zvYr0GpCaxsGnOWtrNC47TwFMrtZr2Wg&_nc_zt=3&_nc_ht=
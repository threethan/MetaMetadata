9NTPvT2RkNveARfG-73COloeaDtT_yMnHgN1zgRypl_g&oe=6A297F44"}, {"file_name": "5.png", "id": "467916352871409", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39003282_467916356204742_1871921057092171900_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ErOE7J4cY9gQ7kNvwHv8DJu&_nc_oc=Adq9xdRxOoK7ZDulkie0x0VkMO5SA1XbpRbOrTyebDPfDIegwa0hz3M9Nw-ruO6ZEGw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af__l-ms4VqoGQ-hR3CHVy5DH7wpLMv7D6js-BwzQ12v5g&oe=6A2963E2"}, {"file_name": "3.png", "id": "1934382610375855", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974473_1934382613709188_7156337812617042679_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y2iT7YugXmUQ7kNvwGUpQB6&_nc_oc=AdrjurWbrGoGNCj_9gTKp9cF-2lXUATdabuHXkCXwU0F5PPlfNdd8vAarEG5cpiZ9zM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-519dQ1s3NrpSE-4Pq6QdOMK6nsCe7EyiUKWz521T6vQ&oe=6A298633"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape.png", "id": "1524760081483769", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974531_1524760084817102_6497712644828891067_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_TKuk91nOKsQ7kNvwHd9h7m&_nc_oc=AdqkGUTla0LeShDUoB2SycHrLyJRm7zRf9SD9Bvr5RWIFZdIjX7-OJxlAv66W7GJeLU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8QXqZPE39ideGtOL8FiZuKe9VjEPXz71BydX1GHCzpZw&oe=6A29852F"}, "display_name": "Mystery Box VR: Hidden Secrets", "keywords": [], "long_description": " AN IMMERSIVE VR PUZZLE EXPERIENCE\nInteract with objects, handles, buttons, and wheels on each side. Crack enigmas and collect hidden puzzle tiles on a random side of the boxes.\n\nYou won't be able to compare reality with fiction.\n\n# DISCOVER INVENTIONS\nOnce you unlock all 8 boxes of a Level Pack, you can compose a puzzle and discover a brief history of an invention.\n\nIt's not always easy to escape the room, so use all your IQ to crack the riddles. There's a logic behind all of them, even where it seems it's not!\n\n# IMMERSIVE SOUNDTRACK\nPlay the game with your headphones to get immersed in this amazing adventure.\n\n# HINTS\nGot stuck on some enigma? No worries, you can still get a helpful hint! You can also get in touch with me in case you really can't make it through a riddle, I'll be glad to help ;)\n\n# MULTILANGUAGE\nAvailable in English, French, Italian, German, Spanish, Russian, and Japanese.\n\nThe game language will change automatically based on the language settings of your device", "short_description": "A VR escape room game where you have to solve intriguing riddles to open boxes and discover nice stories about popular inventions!"}, {"images": {"nodes": [{"file_name": "$R36BSY5.png", "id": "3678762505771822", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031430_3678762509105155_2151975047074617165_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7y7GWKmahVoQ7kNvwE1pc6J&_nc_oc=AdpXlYj5TdkV-5Vm0m-wt58G_JVdyQCiy2qZVHl9VJQeVQfICZBKNfu8HROw-lzmae8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8zyUZ4MHqUTDsBAPkYfEJ76Pl2E9hYtpMsjvcEVSUSdg&oe=6A298125"}, {"file_name": "$R81V725.png", "id": "2720695481426567", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75262743_2720695484759900_604086922326600035_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=df3r2R4NcNoQ7kNvwG227G_&_nc_oc=Adosj0U6DZc9ZtIupeNA2gKnxS_4vfl8gscd5GVqGZnA1798qwctPdTVz8632NTrRD4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-Ho1x7fe-S_4TRZg4r_7RN1nfMbiEo_Wyeh1UKAGFxYw&oe=6A29800D"}, {"file_name": "$RQ3SN6U.png", "id": "1552311425628973", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982519_1552311428962306_1218130395049083834_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VIcirpHbD9wQ7kNvwEerPf-&_nc_oc=AdrJTrBSvvBKGJz5puMSPJblH_eqjdk3EOMJ7rnrh0ppNBUUL3qBxNZBqoTlP_2e7Fs&_nc_zt=3&_nc_ht=
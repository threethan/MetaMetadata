8OtOUjrNpqwELKgFizhO_xuIXpnjtc5gjAl1ZhnlYIQw&oe=6A258AC4"}, {"file_name": "5.png", "id": "467916352871409", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39003282_467916356204742_1871921057092171900_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SsGfM5NpRrkQ7kNvwFluvbr&_nc_oc=AdoZBZdFOv7yWipf8vE8Yz4Zh4CdaORenfRTQmQEfkDhON_-VaWKl8HXMeycr096APQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8XqPTQQw4UrIsJMtp8REeIt8vlooSyM5su1naCyFIvrg&oe=6A256F62"}, {"file_name": "3.png", "id": "1934382610375855", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974473_1934382613709188_7156337812617042679_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3U4WkmPCYwUQ7kNvwGKsuHu&_nc_oc=Adq1R1UWXxORDB44_okOfg9UjCISwjMBXvk2f3lqO1Ix9aomXecjI893IHJsanmbpBE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_gCgGmjehLy9YtA1IUiPj5E9fsnI808l3JhkZrjeOuGw&oe=6A2591B3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape.png", "id": "1524760081483769", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974531_1524760084817102_6497712644828891067_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sdKXxI_1y3EQ7kNvwGEq71e&_nc_oc=AdqKaUDIv7__SxRorDeVz1CLfPJaXw0S_BD4iRTD8vlt5S9LjPETlqk60_F3hIZt8y0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-fZBtb6rwNwhCfOJuB7zLcUYOhT3qjkK2bTnTGlmFHxA&oe=6A2590AF"}, "display_name": "Mystery Box VR: Hidden Secrets", "keywords": [], "long_description": " AN IMMERSIVE VR PUZZLE EXPERIENCE\nInteract with objects, handles, buttons, and wheels on each side. Crack enigmas and collect hidden puzzle tiles on a random side of the boxes.\n\nYou won't be able to compare reality with fiction.\n\n# DISCOVER INVENTIONS\nOnce you unlock all 8 boxes of a Level Pack, you can compose a puzzle and discover a brief history of an invention.\n\nIt's not always easy to escape the room, so use all your IQ to crack the riddles. There's a logic behind all of them, even where it seems it's not!\n\n# IMMERSIVE SOUNDTRACK\nPlay the game with your headphones to get immersed in this amazing adventure.\n\n# HINTS\nGot stuck on some enigma? No worries, you can still get a helpful hint! You can also get in touch with me in case you really can't make it through a riddle, I'll be glad to help ;)\n\n# MULTILANGUAGE\nAvailable in English, French, Italian, German, Spanish, Russian, and Japanese.\n\nThe game language will change automatically based on the language settings of your device", "short_description": "A VR escape room game where you have to solve intriguing riddles to open boxes and discover nice stories about popular inventions!"}, {"images": {"nodes": [{"file_name": "$R36BSY5.png", "id": "3678762505771822", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031430_3678762509105155_2151975047074617165_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CAORMJyHZiMQ7kNvwFAaVza&_nc_oc=Ado6HBeGs6XjTkzFCfttEuZ3QVuHetEjkS4IKwa8hqrXBbkzNA_4TKv5FvJUo94j8TA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-zfjL4d6wPmaFLPJ3KhrP8k4uU9wZMDKpHkJsrB0Z2gg&oe=6A258CA5"}, {"file_name": "$R81V725.png", "id": "2720695481426567", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75262743_2720695484759900_604086922326600035_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1KMMa831a8cQ7kNvwGzoTMT&_nc_oc=AdqXsIeemPJj8m7H8xaiSjJQ3Xe35CWgTbLPdwKyLRdOxPELXaxwxVHou9tz0e-RiFc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8ILgXfe-syiHla3Va0Qfu3bBi3ugmdkOhOJkaDKfx7Qw&oe=6A258B8D"}, {"file_name": "$RQ3SN6U.png", "id": "1552311425628973", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982519_1552311428962306_1218130395049083834_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QEIK9iC_SgoQ7kNvwGxPyJF&_nc_oc=AdrI7GTjxFqPvnU4cMjkbfJ2kn6vd-Nd20a8sUjTfYL-QlYY31puO0MkQYZvke8hGks&_nc_zt=3&_nc_ht=
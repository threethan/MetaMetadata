TAv0KPrqI3ipd1OEQ4UUYwMmMEvEs0HkNpZciSVi_JXQ&oe=6AF48644"}, {"file_name": "5.png", "id": "467916352871409", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39003282_467916356204742_1871921057092171900_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RcI6rS3fj4kQ7kNvwE-ZhRs&_nc_oc=Adpa6wq_fXU6m1gHKZ9ac1ro5o5mr4uIvT1tZZPS1iWjRRny3VMrzbdb47BUVYzD-KU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS1_GcuyIPka3MeH7Ozx5a-f0bV89D_gjjIyjCMdGMCPQ&oe=6AF4A322"}, {"file_name": "3.png", "id": "1934382610375855", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974473_1934382613709188_7156337812617042679_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HSDiqKByD_UQ7kNvwESpbMJ&_nc_oc=AdoyKSm50NXb4okPnsoXTSjiUt4TiKLJX4IaEwQkASonTuk78fhiNjfnnQF2GDNYQGw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQeqTzvDJAfgC_S4eQvvBWPqHKFKWFVnDCkg3Hog5TCXg&oe=6AF48D33"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape.png", "id": "1524760081483769", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974531_1524760084817102_6497712644828891067_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Cj6izO9pyxcQ7kNvwGxnJa_&_nc_oc=Adq-LKHqBE7bBRvWgSsDDl91GKF9RTyVmaEA7ayeSr2T4fgmkxdCuK79O48MzRRmml0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSy1PndI3beaM-1nQ3BFr4ZCbhyxPLWEW-EJh3LunyvBg&oe=6AF48C2F"}, "display_name": "Mystery Box VR: Hidden Secrets", "keywords": [], "long_description": " AN IMMERSIVE VR PUZZLE EXPERIENCE\nInteract with objects, handles, buttons, and wheels on each side. Crack enigmas and collect hidden puzzle tiles on a random side of the boxes.\n\nYou won't be able to compare reality with fiction.\n\n# DISCOVER INVENTIONS\nOnce you unlock all 8 boxes of a Level Pack, you can compose a puzzle and discover a brief history of an invention.\n\nIt's not always easy to escape the room, so use all your IQ to crack the riddles. There's a logic behind all of them, even where it seems it's not!\n\n# IMMERSIVE SOUNDTRACK\nPlay the game with your headphones to get immersed in this amazing adventure.\n\n# HINTS\nGot stuck on some enigma? No worries, you can still get a helpful hint! You can also get in touch with me in case you really can't make it through a riddle, I'll be glad to help ;)\n\n# MULTILANGUAGE\nAvailable in English, French, Italian, German, Spanish, Russian, and Japanese.\n\nThe game language will change automatically based on the language settings of your device", "short_description": "A VR escape room game where you have to solve intriguing riddles to open boxes and discover nice stories about popular inventions!"}, {"images": {"nodes": [{"file_name": "$R36BSY5.png", "id": "3678762505771822", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031430_3678762509105155_2151975047074617165_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L35lklFUzGwQ7kNvwHOU1dZ&_nc_oc=AdpjaiCiSswd4JDb-Ze56tOrCKM5iyLw6FAUyqxXLdI9pPyRb3Fa1Dww8SPQud9Cpto&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQXD1KE2-p0mbmqDZnY9lbXqcpxRr4c3Lm46kKAUjgoLQ&oe=6AF48825"}, {"file_name": "$R81V725.png", "id": "2720695481426567", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75262743_2720695484759900_604086922326600035_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1iP6G2iIr04Q7kNvwGBpxeV&_nc_oc=AdqIFi8H0Fl4HuzKrHfmL-Y3uSONhSR6_vc7bF4CPFBKUWn8rhNh0xYH74Ij7_vjq_M&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRRPfWBc2_J7OQRJ7__v6Q6U6HF5vIVI9OEgZLZdtT31g&oe=6AF4870D"}, {"file_name": "$RQ3SN6U.png", "id": "1552311425628973", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982519_1552311428962306_1218130395049083834_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ivuJwpZbrHAQ7kNvwGl-Z8n&_nc_oc=AdrjLkS6rxFzPkeFoZK8yZLcUoAiKukYB_pkUwtkpE1vGgDTRFmNrry42y_ceYiHJIQ&_nc_zt=3&_nc_ht=
G1H6o-lNQQ8sOgSWtq9x-zyihjLSfJOpIMEuJMJpexng&oe=6A7EF884"}, {"file_name": "5.png", "id": "467916352871409", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39003282_467916356204742_1871921057092171900_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ulo6P3uXyHAQ7kNvwEUOpYU&_nc_oc=AdpzT-v5GPjBz5Pu8wLpGdVhkZR4bMUqNH7q0HCq3v0556il1F0vAlw0jC2-tPFRlgo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGCiGpOUp1RKi_q92BDlqCpaREcKRoAVCZHTPG5BplTnQ&oe=6A7F1562"}, {"file_name": "3.png", "id": "1934382610375855", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974473_1934382613709188_7156337812617042679_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9VYUuC_JU6cQ7kNvwFXSvZB&_nc_oc=AdrlKu9uUEjwKNmLbFiAwk0xGr3QME9c2QLo5UzVx-HtMy6XexjjqgSTqkfyHXyN03o&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQErlsoDVpoxpEgauYqvutHvv52vBaNnBeRXYzwU7od2PA&oe=6A7EFF73"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape.png", "id": "1524760081483769", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974531_1524760084817102_6497712644828891067_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S4zDneBS-BQQ7kNvwEu-YSx&_nc_oc=AdrNDWF7CcfAKkDlknzYYxmYhCp1iHoW7wMjOoaqkz66oGRVkUytAnPn4Cv365BbNcI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF_2O9kwecxvRsXF4V-ur2IXjNw3GoMv8lc_5EF0FXYMQ&oe=6A7EFE6F"}, "display_name": "Mystery Box VR: Hidden Secrets", "keywords": [], "long_description": " AN IMMERSIVE VR PUZZLE EXPERIENCE\nInteract with objects, handles, buttons, and wheels on each side. Crack enigmas and collect hidden puzzle tiles on a random side of the boxes.\n\nYou won't be able to compare reality with fiction.\n\n# DISCOVER INVENTIONS\nOnce you unlock all 8 boxes of a Level Pack, you can compose a puzzle and discover a brief history of an invention.\n\nIt's not always easy to escape the room, so use all your IQ to crack the riddles. There's a logic behind all of them, even where it seems it's not!\n\n# IMMERSIVE SOUNDTRACK\nPlay the game with your headphones to get immersed in this amazing adventure.\n\n# HINTS\nGot stuck on some enigma? No worries, you can still get a helpful hint! You can also get in touch with me in case you really can't make it through a riddle, I'll be glad to help ;)\n\n# MULTILANGUAGE\nAvailable in English, French, Italian, German, Spanish, Russian, and Japanese.\n\nThe game language will change automatically based on the language settings of your device", "short_description": "A VR escape room game where you have to solve intriguing riddles to open boxes and discover nice stories about popular inventions!"}, {"images": {"nodes": [{"file_name": "$R36BSY5.png", "id": "3678762505771822", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031430_3678762509105155_2151975047074617165_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TabCGj2h_-EQ7kNvwE1ujFf&_nc_oc=Ado2-51eH_YgXo46YjFV6yGbRMweCXCQf1aZl5XX6Av1iNFxgI7zHOxT4IxL9ovc2TY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEU3Ygn43O5xsgXXgMtCjQE3gUby4ePzbd_nz-pgWsL1w&oe=6A7EFA65"}, {"file_name": "$R81V725.png", "id": "2720695481426567", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75262743_2720695484759900_604086922326600035_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0ReQfUKVOsMQ7kNvwHEQyVf&_nc_oc=AdqUUxbuDAQ0v-MU2dkYji0bZdBaMLonKLNPpOHbsxg2ydwvM0ym3mDv3dGaz8Nqapw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHAMcN1T8y4QZBvEgyvxxiQk9lYqafCP5olR08d89EZyA&oe=6A7EF94D"}, {"file_name": "$RQ3SN6U.png", "id": "1552311425628973", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982519_1552311428962306_1218130395049083834_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PywjoRwZmEoQ7kNvwH6FdDZ&_nc_oc=AdrkuocYXwahj-mkt9s3Rnm_L-0MdjcXRve91vpQ6hCgJi-sTdfy7YLiEkLilagumZw&_nc_zt=3&_nc_ht=
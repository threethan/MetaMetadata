FMuSo8ouaw05034LdT7c3LLQhzRwwJvsiX1YEFtHpenw&oe=6A95D284"}, {"file_name": "5.png", "id": "467916352871409", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39003282_467916356204742_1871921057092171900_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tcPqwkcqiHUQ7kNvwEqz3Qd&_nc_oc=AdqHdzj2V_QWrWSZqMNlLFaG0uMq1_5aLIaIRHpcfpWYO_J2gUcklJcNmgr5s2GTivU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGFdYHJmJ9QkD8yvo0LTkOYY6G_iq1OpP167krDvGlOAA&oe=6A95B722"}, {"file_name": "3.png", "id": "1934382610375855", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974473_1934382613709188_7156337812617042679_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UgWEJ_CnWL8Q7kNvwEyske5&_nc_oc=AdrxYgvt8nGgiiLSJEht8X-BpZ7OJ0Jf2XGzLVGlUs_dFTgnOp0c8p3JaUWTokKTRVw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHIBGv-8PB17BHsC763WBfk7xSkj2srpLd7--bsaO1Eww&oe=6A95D973"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape.png", "id": "1524760081483769", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974531_1524760084817102_6497712644828891067_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QfSgZ0VQfcEQ7kNvwFSGNQ3&_nc_oc=Adrydpv99N4k5Z-jJCjpv8DTKDlGC-9Xhdk1mHjgilCoevFP1TwVJNIbl7CChgpE0Ao&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGSrVqD1vwQo-rJEVpyXXa0xfKS7HZDBeqrWg29lrr4jw&oe=6A95D86F"}, "display_name": "Mystery Box VR: Hidden Secrets", "keywords": [], "long_description": " AN IMMERSIVE VR PUZZLE EXPERIENCE\nInteract with objects, handles, buttons, and wheels on each side. Crack enigmas and collect hidden puzzle tiles on a random side of the boxes.\n\nYou won't be able to compare reality with fiction.\n\n# DISCOVER INVENTIONS\nOnce you unlock all 8 boxes of a Level Pack, you can compose a puzzle and discover a brief history of an invention.\n\nIt's not always easy to escape the room, so use all your IQ to crack the riddles. There's a logic behind all of them, even where it seems it's not!\n\n# IMMERSIVE SOUNDTRACK\nPlay the game with your headphones to get immersed in this amazing adventure.\n\n# HINTS\nGot stuck on some enigma? No worries, you can still get a helpful hint! You can also get in touch with me in case you really can't make it through a riddle, I'll be glad to help ;)\n\n# MULTILANGUAGE\nAvailable in English, French, Italian, German, Spanish, Russian, and Japanese.\n\nThe game language will change automatically based on the language settings of your device", "short_description": "A VR escape room game where you have to solve intriguing riddles to open boxes and discover nice stories about popular inventions!"}, {"images": {"nodes": [{"file_name": "$R36BSY5.png", "id": "3678762505771822", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031430_3678762509105155_2151975047074617165_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ePnWJJptdSMQ7kNvwFks3cK&_nc_oc=Adr_aLn0h1mjSC_PgdyO4fSBrdAon_0zrs-gAmkjmIQo9rlDQLDa4glVfOc62_lQCXo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGx8cJPLsZgfHmoytDN9cWcAy986p0GpdtiGO6EKPvoVA&oe=6A95D465"}, {"file_name": "$R81V725.png", "id": "2720695481426567", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75262743_2720695484759900_604086922326600035_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OeCk1Ie9r7UQ7kNvwEQUZvf&_nc_oc=Adp0RhmpILY22bx25kT_RQ7FaybMOlP9VC6G-voJWpY9Aa0UvKcw032SZTKqe5UBZV8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH5RZQFtIj5Bt3AoKUAHSpZWL-SWvPRDu8SujFPwH_GAg&oe=6A95D34D"}, {"file_name": "$RQ3SN6U.png", "id": "1552311425628973", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982519_1552311428962306_1218130395049083834_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RroGpL4EAcQQ7kNvwEIhl1S&_nc_oc=Adq9B_79Emmxr60QAchzVPITgKJ0mGOz1wpD_hrhhZ0Ngc4qzCql5dx8yPMW1f-iU_E&_nc_zt=3&_nc_ht=
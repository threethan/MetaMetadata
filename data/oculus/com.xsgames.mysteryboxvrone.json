O7369PHSE7hkABQSc5GZ8BgEa769M1kGtDolvieqMo-w&oe=6AE605C4"}, {"file_name": "5.png", "id": "467916352871409", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39003282_467916356204742_1871921057092171900_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=10Tgbi_cgtgQ7kNvwEcTVOH&_nc_oc=Adqgz3JDq94SUvHw2nrZup8_blARsytXDUM9Mm3KUX4N6Bnse7tsi4c7uT0Tf_KLxWA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOJNZL2HYN10x7buJpTwLUB_lSaxTsUSeR_VXeH-ZyWjw&oe=6AE5EA62"}, {"file_name": "3.png", "id": "1934382610375855", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974473_1934382613709188_7156337812617042679_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IeixxBK3TOUQ7kNvwEK0_03&_nc_oc=Adp6vByc6ZpjB_RKiKYyq9NnP8zrSwGDgU0OWnK-krPZPhI2C9P3o0AyXYpQYxdJLv0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN82V1ydpgo0LE7RoIgU3KIrTA76_1Qih5_3ShUOwfQlA&oe=6AE60CB3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape.png", "id": "1524760081483769", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974531_1524760084817102_6497712644828891067_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oEPsAm7AwyAQ7kNvwELr063&_nc_oc=AdolVs1ZhPL17pRxTZwlymVEGr3b9CiwoM7l4Dnlrm_ojJHKgWvUKn9BOkpV5FNVeqs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPi456HAzcx6_5VmMtqNqql7Uxh4hlqWQVHI-u8QesRPw&oe=6AE60BAF"}, "display_name": "Mystery Box VR: Hidden Secrets", "keywords": [], "long_description": " AN IMMERSIVE VR PUZZLE EXPERIENCE\nInteract with objects, handles, buttons, and wheels on each side. Crack enigmas and collect hidden puzzle tiles on a random side of the boxes.\n\nYou won't be able to compare reality with fiction.\n\n# DISCOVER INVENTIONS\nOnce you unlock all 8 boxes of a Level Pack, you can compose a puzzle and discover a brief history of an invention.\n\nIt's not always easy to escape the room, so use all your IQ to crack the riddles. There's a logic behind all of them, even where it seems it's not!\n\n# IMMERSIVE SOUNDTRACK\nPlay the game with your headphones to get immersed in this amazing adventure.\n\n# HINTS\nGot stuck on some enigma? No worries, you can still get a helpful hint! You can also get in touch with me in case you really can't make it through a riddle, I'll be glad to help ;)\n\n# MULTILANGUAGE\nAvailable in English, French, Italian, German, Spanish, Russian, and Japanese.\n\nThe game language will change automatically based on the language settings of your device", "short_description": "A VR escape room game where you have to solve intriguing riddles to open boxes and discover nice stories about popular inventions!"}, {"images": {"nodes": [{"file_name": "$R36BSY5.png", "id": "3678762505771822", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031430_3678762509105155_2151975047074617165_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qq6PUHIdOj4Q7kNvwEHezFj&_nc_oc=AdpI0WbtnTjYmRYm1ABYJKraXjhIM5UX_nqo93i3KtyOPLqqwK5YHtcJXZ74CULxq3I&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNpiVJ5dSxktxhbSeubZCfCxUV35fjBPXoVcsJ87zSVFA&oe=6AE607A5"}, {"file_name": "$R81V725.png", "id": "2720695481426567", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75262743_2720695484759900_604086922326600035_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aLnZjC3dTA0Q7kNvwG-GXwj&_nc_oc=AdoJjlH-wpSGqL165VE1mXBdVJdoktl9a_zY6mCvLCZNl2fDXsiIA-pQuAGUEyCL0vs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOheRkdgyYI3PncSDk36m7tmzCH58HljP3vB8r38ju9jA&oe=6AE6068D"}, {"file_name": "$RQ3SN6U.png", "id": "1552311425628973", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982519_1552311428962306_1218130395049083834_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BrYZg0ipzK8Q7kNvwGisYuw&_nc_oc=Adp8BXM_u5CwMNW86clS6-ve2-w0av1R2PlBgIID4wlDl_0jrDs8w8gbmdvtH4OjRBs&_nc_zt=3&_nc_ht=
5MGAQBndnzGlGMCJFXrXzK032xQ3LVTVOQUs4XtL8mxQ&oe=69FDFDC4"}, {"file_name": "5.png", "id": "467916352871409", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39003282_467916356204742_1871921057092171900_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mQoc8ZCk6PEQ7kNvwGxaYjR&_nc_oc=Adr_B9lKYHsnq9xJpkTtNjC9MwhSgyCSTpFnsny4L8f4uaGb_c5mBPJRP5NVxneTBnk&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7SQkdCqXtLaUF9qrG8x_mpQ7c2OoQBMnrywuugGpF8Aw&oe=69FDE262"}, {"file_name": "3.png", "id": "1934382610375855", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974473_1934382613709188_7156337812617042679_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tzPybgxsmdEQ7kNvwG6Db2U&_nc_oc=AdrznVbYh0qIQ1vZ2tMsa0FJUSFpQdeP0wBwe2BzDFwvwmxkpzSVVqdno9ECB0x4xwk&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6l9H4_BiU5FxrJL_K3Pqldk9_vuDrxHVkQ_3g6PJjk6A&oe=69FDCC73"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape.png", "id": "1524760081483769", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974531_1524760084817102_6497712644828891067_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x88o4Trox9AQ7kNvwE0nmTB&_nc_oc=AdrTtdpWAcAcQhkyEsICn-Enk8XvcYybgf2vvaQV27pMBXxKmgA1b_ZxjlqyGsAXHRk&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4Dtb7bNIimY4yhot_2JWlFingNgPtFG7vLjKlJWgzH-A&oe=69FE03AF"}, "display_name": "Mystery Box VR: Hidden Secrets", "keywords": [], "long_description": " AN IMMERSIVE VR PUZZLE EXPERIENCE\nInteract with objects, handles, buttons, and wheels on each side. Crack enigmas and collect hidden puzzle tiles on a random side of the boxes.\n\nYou won't be able to compare reality with fiction.\n\n# DISCOVER INVENTIONS\nOnce you unlock all 8 boxes of a Level Pack, you can compose a puzzle and discover a brief history of an invention.\n\nIt's not always easy to escape the room, so use all your IQ to crack the riddles. There's a logic behind all of them, even where it seems it's not!\n\n# IMMERSIVE SOUNDTRACK\nPlay the game with your headphones to get immersed in this amazing adventure.\n\n# HINTS\nGot stuck on some enigma? No worries, you can still get a helpful hint! You can also get in touch with me in case you really can't make it through a riddle, I'll be glad to help ;)\n\n# MULTILANGUAGE\nAvailable in English, French, Italian, German, Spanish, Russian, and Japanese.\n\nThe game language will change automatically based on the language settings of your device", "short_description": "A VR escape room game where you have to solve intriguing riddles to open boxes and discover nice stories about popular inventions!"}, {"images": {"nodes": [{"file_name": "$R36BSY5.png", "id": "3678762505771822", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39031430_3678762509105155_2151975047074617165_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8qSUF7PSfaIQ7kNvwGTyZXh&_nc_oc=Adq6rmaZ46H9UCSTxY0W1AWqXoZDnPSaZh_atKSYFXd-9CDoBBLf7gMdIkQMDIz8Oks&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4qcNwZ_Ldb4WujKs3TnReqVdrDiQGxDHl2I-vyKNtFmg&oe=69FDFFA5"}, {"file_name": "$R81V725.png", "id": "2720695481426567", "image_type": "APP_IMG_ICON", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/75262743_2720695484759900_604086922326600035_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u0fQbb-Hn2UQ7kNvwEccd4O&_nc_oc=Adok9UoRHeehsTeWPAerhSM96wlEyeWEAHbT0WgURxYLKSNJSaBN1jMzBjN_p6FWh6s&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6OJdq5tGMdomwUrgz-OUwaNlXwWRQhitu7yUL00RLiOw&oe=69FDFE8D"}, {"file_name": "$RQ3SN6U.png", "id": "1552311425628973", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38982519_1552311428962306_1218130395049083834_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ecafbifwA1wQ7kNvwF8RPOA&_nc_oc=Adr1Yvt5Ewag5-c1-JwI22PFkQtOp6rxYRXYLVmMiqHnYKIV_mOkhFYXoEHNtdd_2_8&_nc_zt=3&_nc_ht=
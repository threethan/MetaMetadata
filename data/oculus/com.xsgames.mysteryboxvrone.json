Qpie9-E0bA4xFckSQizE2Rq44p8QYDwQp0QZBpoG7rjg&oe=6AEF4044"}, {"file_name": "5.png", "id": "467916352871409", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39003282_467916356204742_1871921057092171900_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4qKfki0MVLUQ7kNvwHgdlVy&_nc_oc=Ado_CRh6KfQuNZC2B6_a1RkjXlgbTzOYlKB5Q02DzuoWaTS2CofJqHzHMnz2q1aSk9k&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQQZS1uBhXDEL0qpYKnXTee1IOiNA6h3082S-abuWMlgg&oe=6AEF5D22"}, {"file_name": "3.png", "id": "1934382610375855", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974473_1934382613709188_7156337812617042679_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wX1617g0PDgQ7kNvwHqARW8&_nc_oc=AdoRCK2C6MiaOEihXHMLEhlTnQXXl1bPiU4SRvxcuZxcvTK4duRLkGoXGAMK2NPylTM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT_JwKBMsBoMfl8lHNXdg9NdYCB2iQ4SatZ-sW-2oJS_w&oe=6AEF4733"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape.png", "id": "1524760081483769", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974531_1524760084817102_6497712644828891067_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e2CiPTxN7lsQ7kNvwGtvhnQ&_nc_oc=Adq5eT59AU2sNi8QnKfs0U7uU6gyh588aiNV9Uym3sbK0czFy0NyNMb_Y_bsX3aCTns&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSGBZ0hTxh3Z_SejvWP89uE2QOHxgILF_cQ1Ri60HDjMg&oe=6AEF462F"}, "display_name": "Mystery Box VR: Hidden Secrets", "keywords": [], "long_description": " AN IMMERSIVE VR PUZZLE EXPERIENCE\nInteract with objects, handles, buttons, and wheels on each side. Crack enigmas and collect hidden puzzle tiles on a random side of the boxes.\n\nYou won't be able to compare reality with fiction.\n\n# DISCOVER INVENTIONS\nOnce you unlock all 8 boxes of a Level Pack, you can compose a puzzle and discover a brief history of an invention.\n\nIt's not always easy to escape the room, so use all your IQ to crack the riddles. There's a logic behind all of them, even where it seems it's not!\n\n# IMMERSIVE SOUNDTRACK\nPlay the game with your headphones to get immersed in this amazing adventure.\n\n# HINTS\nGot stuck on some enigma? No worries, you can still get a helpful hint! You can also get in touch with me in case you really can't make it through a riddle, I'll be glad to help ;)\n\n# MULTILANGUAGE\nAvailable in English, French, Italian, German, Spanish, Russian, and Japanese.\n\nThe game language will change automatically based on the language settings of your device", "short_description": "A VR escape room game where you have to solve intriguing riddles to open boxes and discover nice stories about popular inventions!"}, {"images": {"nodes": [{"file_name": "$R36BSY5.png", "id": "3678762505771822", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031430_3678762509105155_2151975047074617165_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9uPP7aXUz3AQ7kNvwECDjky&_nc_oc=Adr0L4yHwST6FdP4R1RU6JKQ2EBHmpt23EHgVzu9ADKPQuzt-2pr4nnjauSkGEq3EHo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTx2MjTjGjBJDh7uIS_UXIs99-e_GIwqCMUudzF_r0bhA&oe=6AEF4225"}, {"file_name": "$R81V725.png", "id": "2720695481426567", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75262743_2720695484759900_604086922326600035_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=62DWBcgDEjAQ7kNvwHGLagK&_nc_oc=AdrF6nbI3Btphpk06jlOGWixt6g5JeGHidy3Ak6dmpWSbnQzdQWfqeKvEefIHhBD1Kc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQoJXiALpEyc7TS9qY4nGbqfmVxlc6bAEJOBZd08Db9ZA&oe=6AEF410D"}, {"file_name": "$RQ3SN6U.png", "id": "1552311425628973", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982519_1552311428962306_1218130395049083834_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Q-82AWqTsTMQ7kNvwFzmG6s&_nc_oc=Adqj_vBSi0QywDWr43F23OO7M00u9XwANsMKOQwnNVhXTQyPlUxvAViNW_rV79z6JLM&_nc_zt=3&_nc_ht=
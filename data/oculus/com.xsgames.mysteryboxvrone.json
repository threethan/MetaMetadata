PDzY9rKS745G46WFgpJHC1rQD1SDG9p_-hX01Yl_HpbA&oe=6ABFCA44"}, {"file_name": "5.png", "id": "467916352871409", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39003282_467916356204742_1871921057092171900_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QbkiB0DqVjAQ7kNvwEQNuvl&_nc_oc=AdrfhM9apawA5Gpfz5cFUzt1x4AVFyOCuyA0yM_E-pPV1t3PHji8Ivm0B85pIVzrl20&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMfF64o_6k97ajN-fABeyHPrkl0x48ey4QNRae9cdrkYA&oe=6ABFAEE2"}, {"file_name": "3.png", "id": "1934382610375855", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974473_1934382613709188_7156337812617042679_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vnuLThSyrVQQ7kNvwEG2LPS&_nc_oc=Ado3aIFdBNmeGBz4KG2S-KcgUPDxehFpEu-GDBLWjwodchGp6ny_B3Dsi-vOIQFoOAA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO3lymGXQaTWivbpkiNMH05MhoO_wRsGUOYRfbCyxJRlA&oe=6ABFD133"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape.png", "id": "1524760081483769", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974531_1524760084817102_6497712644828891067_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uc9g0X1OnS8Q7kNvwF1lDkO&_nc_oc=AdrQOE_AUtDFExbo5ZWAu-4nAj8pZzDqt4zF3AJi5x7umKtMRT1yfe3L5OtAFPpINPM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMQEQdzdM4dHhVMICK5Q7vYVvqWUGDWUbt8SKFLPNPJVg&oe=6ABFD02F"}, "display_name": "Mystery Box VR: Hidden Secrets", "keywords": [], "long_description": " AN IMMERSIVE VR PUZZLE EXPERIENCE\nInteract with objects, handles, buttons, and wheels on each side. Crack enigmas and collect hidden puzzle tiles on a random side of the boxes.\n\nYou won't be able to compare reality with fiction.\n\n# DISCOVER INVENTIONS\nOnce you unlock all 8 boxes of a Level Pack, you can compose a puzzle and discover a brief history of an invention.\n\nIt's not always easy to escape the room, so use all your IQ to crack the riddles. There's a logic behind all of them, even where it seems it's not!\n\n# IMMERSIVE SOUNDTRACK\nPlay the game with your headphones to get immersed in this amazing adventure.\n\n# HINTS\nGot stuck on some enigma? No worries, you can still get a helpful hint! You can also get in touch with me in case you really can't make it through a riddle, I'll be glad to help ;)\n\n# MULTILANGUAGE\nAvailable in English, French, Italian, German, Spanish, Russian, and Japanese.\n\nThe game language will change automatically based on the language settings of your device", "short_description": "A VR escape room game where you have to solve intriguing riddles to open boxes and discover nice stories about popular inventions!"}, {"images": {"nodes": [{"file_name": "$R36BSY5.png", "id": "3678762505771822", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031430_3678762509105155_2151975047074617165_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VN1PVFLY0nsQ7kNvwHUIwOs&_nc_oc=AdpsiCZ3eHuELdKM-qVrYCO5Epl7BFWOw8BORGDOef0mWrStEzQhN-lQD68hG2nwlHA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPVOXTMuW4glOfUiHhgdTBdvhFbym7PetuH6DReaToyNw&oe=6ABFCC25"}, {"file_name": "$R81V725.png", "id": "2720695481426567", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75262743_2720695484759900_604086922326600035_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pRFYNnbN_9cQ7kNvwFphPi_&_nc_oc=AdrOq7p3rAwAgro6nJjxh58FixfU-wdWsov-4cV6VIMsShh13yv4loSyeFYqXQR3lQ0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOnoVvLR8EiQAD0B2wPMC5akg8PemPloFOA8WziOj3wNQ&oe=6ABFCB0D"}, {"file_name": "$RQ3SN6U.png", "id": "1552311425628973", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982519_1552311428962306_1218130395049083834_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z-dCaHFidjIQ7kNvwFjfRBG&_nc_oc=AdqdsRhY7CXX0pm2odIlXokV29-LQgYLl4g44lboopLgdePmXjPNJNXEDpqY4NiZsoc&_nc_zt=3&_nc_ht=
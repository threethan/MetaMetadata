CWQROKT-KkrXGVI1jbrGX0khcrfbhnZ-Mh-NKHcRB6wA&oe=6A5F8CC4"}, {"file_name": "5.png", "id": "467916352871409", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39003282_467916356204742_1871921057092171900_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PHaJ55mO0AEQ7kNvwE5ZYkA&_nc_oc=Ado0AiYUfDyV7AXAYKkvYiFeRfHIBqMdWRzlR8UXv5qptZrHs2QcjUdZ3RUXKD7mEyI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB6p6m-05_SVOV9b1oSzkYMthHYKQV9LxSoEf0PwcPhFQ&oe=6A5F7162"}, {"file_name": "3.png", "id": "1934382610375855", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974473_1934382613709188_7156337812617042679_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=If7Sg9b1r7gQ7kNvwFroWxM&_nc_oc=AdpQ5Q4TFgSikYk2eY3E6MrnyhOLCP8I_UW_pyVBcjWM4mYcwmUE54ue-JAKwPrd4Hc&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA3r_HiiXYMPNO73TfLvLtNBJhS5okdxvx85Rfk4ddd0g&oe=6A5F5B73"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape.png", "id": "1524760081483769", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974531_1524760084817102_6497712644828891067_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kLNFM-SprAcQ7kNvwEP1ZUL&_nc_oc=Adp9_foEyujyXIF6SY5DMeA4iATwEd7i3jLZcpB3ImpEjCO5b9Nw7ifaT_MxXM3C8Q4&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBO76yI2os7SiaOItGmmikJd9xFJyduDTFkVxG1WUG5LA&oe=6A5F5A6F"}, "display_name": "Mystery Box VR: Hidden Secrets", "keywords": [], "long_description": " AN IMMERSIVE VR PUZZLE EXPERIENCE\nInteract with objects, handles, buttons, and wheels on each side. Crack enigmas and collect hidden puzzle tiles on a random side of the boxes.\n\nYou won't be able to compare reality with fiction.\n\n# DISCOVER INVENTIONS\nOnce you unlock all 8 boxes of a Level Pack, you can compose a puzzle and discover a brief history of an invention.\n\nIt's not always easy to escape the room, so use all your IQ to crack the riddles. There's a logic behind all of them, even where it seems it's not!\n\n# IMMERSIVE SOUNDTRACK\nPlay the game with your headphones to get immersed in this amazing adventure.\n\n# HINTS\nGot stuck on some enigma? No worries, you can still get a helpful hint! You can also get in touch with me in case you really can't make it through a riddle, I'll be glad to help ;)\n\n# MULTILANGUAGE\nAvailable in English, French, Italian, German, Spanish, Russian, and Japanese.\n\nThe game language will change automatically based on the language settings of your device", "short_description": "A VR escape room game where you have to solve intriguing riddles to open boxes and discover nice stories about popular inventions!"}, {"images": {"nodes": [{"file_name": "$R36BSY5.png", "id": "3678762505771822", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031430_3678762509105155_2151975047074617165_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8h7sr1DVsWUQ7kNvwFPnR6_&_nc_oc=AdrOkrUi9IuxquRYFcXPZZMcXwSKGuqJlf4vZalRqqpThpz8WVxzhrR12iKGXHASCCc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBJKzHw_OdV6k1rIG9ZbSAAhLjVJOl64ThYceBN2GVkxw&oe=6A5F5665"}, {"file_name": "$R81V725.png", "id": "2720695481426567", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75262743_2720695484759900_604086922326600035_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=inT74WQNhQkQ7kNvwFmUG0I&_nc_oc=Adqes4h5O-jo3ikbIYb1Df_bvaE_088lbtxJFcrcc60cVUealIIg0xUhTDCOB3REAhc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDom71gbDCJWN01jID8scRFOmm9pXGFaKWB2JlYYRL6tQ&oe=6A5F8D8D"}, {"file_name": "$RQ3SN6U.png", "id": "1552311425628973", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982519_1552311428962306_1218130395049083834_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kXLOTrgizmsQ7kNvwGxQxnt&_nc_oc=AdoWt2f6ftum96WHgzVKjOrQbR2QkrYCl-GtenAdvvVxFh6QoIACtlKhI8MPeCJs-x0&_nc_zt=3&_nc_ht=
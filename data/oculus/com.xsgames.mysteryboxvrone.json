w8mH4SxiU9uEE9hpOeCox6rXQRtQYw_oqX1ILVpEAQOg&oe=69D0F284"}, {"file_name": "5.png", "id": "467916352871409", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39003282_467916356204742_1871921057092171900_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rGARsleA0KwQ7kNvwEHVbLL&_nc_oc=AdobU6PxDZL6If57iQF-MxUQuQo0fEuzEHtgW9G_6pcsK901xAJFSCJN4K2DGrx1DY0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afykkc4HFjrezsO46nCpyj5I21Vpe67c2YkrDesBih5H8w&oe=69D10F62"}, {"file_name": "3.png", "id": "1934382610375855", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974473_1934382613709188_7156337812617042679_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K9A2Z-YlKqIQ7kNvwHXvQRw&_nc_oc=Adr3ADKcmsItm9nZumZc3w00KrwPQPEakFrXHTDUka9R9wtKTvDQeoHQVjeu1nyuZrY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwSl1Me67cDN7AQONwxDMyb7CdpQgM7-wWvQCWrwvLkRQ&oe=69D0F973"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape.png", "id": "1524760081483769", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974531_1524760084817102_6497712644828891067_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I4uzclrEZv4Q7kNvwEw9VfZ&_nc_oc=Adogdhmsjvp2vR-HpVOboMm9oGCRAS4bgGwqkAMVubPwhveE0_mfqjI91rr84Yfo4VE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afzl-Bk5PcjXbB0CvtyKAVgkNCQJ1bWGmun4L1x77HGxDg&oe=69D0F86F"}, "display_name": "Mystery Box VR: Hidden Secrets", "keywords": [], "long_description": " AN IMMERSIVE VR PUZZLE EXPERIENCE\nInteract with objects, handles, buttons, and wheels on each side. Crack enigmas and collect hidden puzzle tiles on a random side of the boxes.\n\nYou won't be able to compare reality with fiction.\n\n# DISCOVER INVENTIONS\nOnce you unlock all 8 boxes of a Level Pack, you can compose a puzzle and discover a brief history of an invention.\n\nIt's not always easy to escape the room, so use all your IQ to crack the riddles. There's a logic behind all of them, even where it seems it's not!\n\n# IMMERSIVE SOUNDTRACK\nPlay the game with your headphones to get immersed in this amazing adventure.\n\n# HINTS\nGot stuck on some enigma? No worries, you can still get a helpful hint! You can also get in touch with me in case you really can't make it through a riddle, I'll be glad to help ;)\n\n# MULTILANGUAGE\nAvailable in English, French, Italian, German, Spanish, Russian, and Japanese.\n\nThe game language will change automatically based on the language settings of your device", "short_description": "A VR escape room game where you have to solve intriguing riddles to open boxes and discover nice stories about popular inventions!"}, {"images": {"nodes": [{"file_name": "$R36BSY5.png", "id": "3678762505771822", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031430_3678762509105155_2151975047074617165_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g6YUKXQ22jwQ7kNvwGk_IK-&_nc_oc=AdpBONhZzgJSGYLgBbd84mSjmS0Ce9rdASekLwBsUYyhl_x7I2AfEcQtyXBJwn1HZzo&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzMvwB-_ZoBLQLreAw7MW_DUM90S16341RklE8p_O0mtQ&oe=69D0F465"}, {"file_name": "$R81V725.png", "id": "2720695481426567", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75262743_2720695484759900_604086922326600035_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ni4Or0FI0qgQ7kNvwE_PwXo&_nc_oc=Adpe_Clw5Nu07KGJsrz0K3kD5fxwJOjhOg8rtLqoVMDMWJ43ddhPS0ATW57vcD449fA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxKTI6yBWO4C8gxn6BSKTLD3Sq4022Brr97lZw0jH5vMA&oe=69D0F34D"}, {"file_name": "$RQ3SN6U.png", "id": "1552311425628973", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982519_1552311428962306_1218130395049083834_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oI84xxbW7_QQ7kNvwEncjcE&_nc_oc=Adr3v9g5YP7ip38ipvW4MXUWikLwfJG01nKe0S1R46XkTTYwc6gbYBbR47BR7vcNQYs&_nc_zt=3&_nc_ht=
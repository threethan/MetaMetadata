KpM8jhKzZdmCPn77luvTUdqc0L13Kkt09d0xqU4Nut1A&oe=6AA56C44"}, {"file_name": "5.png", "id": "467916352871409", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39003282_467916356204742_1871921057092171900_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NtQacdhNjXAQ7kNvwE6ZgMW&_nc_oc=AdqdEZ8V0-9iZ31-Dj-aOw-7zbReFKHt3wtSQCMc_S7t_IUUbc9KwWLrWgd8JWVyvEE&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKAf8x2iItahFbyeesPyowWXNWGH8Oe7mdV0p_qbHNYxQ&oe=6AA550E2"}, {"file_name": "3.png", "id": "1934382610375855", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974473_1934382613709188_7156337812617042679_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CblUJRquxL0Q7kNvwHiaVec&_nc_oc=AdoxTnUki1aRhEJB2AZMu3RItALRZ-jYaaVGw3YgeGB7d91D7CcxM-hrBAcINAi7vXQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLQttU6ltsog16ItG6XAZfgKBGxMN9O9YlmINEgm21mAw&oe=6AA57333"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape.png", "id": "1524760081483769", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974531_1524760084817102_6497712644828891067_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DiMbG4V7FhMQ7kNvwExjAid&_nc_oc=AdqZLZezjxyY73Z7VycyLrt-FOM-n6jY6_iIijM9caXJOpjLuUdy9OEKZrv4mmj62EI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJX88JsNa0lEhzTYisADW8GN4ESSgrAfttgvuUvnVPlVw&oe=6AA5722F"}, "display_name": "Mystery Box VR: Hidden Secrets", "keywords": [], "long_description": " AN IMMERSIVE VR PUZZLE EXPERIENCE\nInteract with objects, handles, buttons, and wheels on each side. Crack enigmas and collect hidden puzzle tiles on a random side of the boxes.\n\nYou won't be able to compare reality with fiction.\n\n# DISCOVER INVENTIONS\nOnce you unlock all 8 boxes of a Level Pack, you can compose a puzzle and discover a brief history of an invention.\n\nIt's not always easy to escape the room, so use all your IQ to crack the riddles. There's a logic behind all of them, even where it seems it's not!\n\n# IMMERSIVE SOUNDTRACK\nPlay the game with your headphones to get immersed in this amazing adventure.\n\n# HINTS\nGot stuck on some enigma? No worries, you can still get a helpful hint! You can also get in touch with me in case you really can't make it through a riddle, I'll be glad to help ;)\n\n# MULTILANGUAGE\nAvailable in English, French, Italian, German, Spanish, Russian, and Japanese.\n\nThe game language will change automatically based on the language settings of your device", "short_description": "A VR escape room game where you have to solve intriguing riddles to open boxes and discover nice stories about popular inventions!"}, {"images": {"nodes": [{"file_name": "$R36BSY5.png", "id": "3678762505771822", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031430_3678762509105155_2151975047074617165_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a69X5QerOJYQ7kNvwHTRzPh&_nc_oc=AdpBCnKF5OjBsbrv5hDxOACpP_cHrw3qfsGWDwTXLQcpOt-eBKx1MSh1VCZiFJE2X-g&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJkb8WktjSL6Pme75Sw39MPumsBk7BUPCToUta4T-Li7A&oe=6AA56E25"}, {"file_name": "$R81V725.png", "id": "2720695481426567", "image_type": "APP_IMG_ICON", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75262743_2720695484759900_604086922326600035_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7lQ7eg1R9hUQ7kNvwFV_IMH&_nc_oc=Adrr_cSZdigmgG8uXi-_ywY_xXuKZ8J8eXpkwcWvu_iAl6abXj6jKD4wuz2sdAeZKFU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIzHEfEsxkbYmu_N6JrEE-Bbm-Sr2Gqx0HxVxmQ42iChA&oe=6AA56D0D"}, {"file_name": "$RQ3SN6U.png", "id": "1552311425628973", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982519_1552311428962306_1218130395049083834_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wHcABVb4LiYQ7kNvwEmKF6y&_nc_oc=AdoLa6roEYBouwRRzYAHEQb2Aq6gjPvb2gMivsfLBHHHSdIDdEGo-oQQS7x11Ar0pDw&_nc_zt=3&_nc_ht=
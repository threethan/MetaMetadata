&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xq7M8s0OhvoQ7kNvwEa5UE3&_nc_oc=AdqnawbLTbqAxm0KKwfEwhBad8A3M1DGDfRQt-eRZ4mX6UHIAUXd4paBB4YU5ch6u7A&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQWPyXPg1OQMPzYGRhknlLD2P-GGtDKqBkNki84jysusw&oe=6B048108"}, {"file_name": "2.png", "id": "2203761473315962", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75469623_2203761476649295_9180026026436178997_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=38Y1kOpcu5kQ7kNvwEg2rFc&_nc_oc=AdoV3iriU4Mt_yTYqRu5_u2IQRpN4dzKu3XQL01vr3HvLsogTh5CVE89wkrX-xJwALU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSw0HKDKJWdVtIHyWskcNntE6LaP-MImZI8I8UjBchPMw&oe=6B047631"}, {"file_name": "5.png", "id": "1600206790893068", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974920_1600206794226401_7626143159008067194_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d88eaDnuqgMQ7kNvwFFgbIT&_nc_oc=AdoyTi-UOlLYotmg1OzRv4PsdnORBOLwWUaj4ktK4LTqxks65ratoYQatCylAX0tuow&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRcDFSNY_L7ZVjDH60MiJLxF_kSyewDQOSsc1ZxNmqeYQ&oe=6B0482CA"}, {"file_name": "3.png", "id": "1053463469622332", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75395599_1053463472955665_4671093965273907425_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-ZJ70XLVJJQQ7kNvwGRWeUP&_nc_oc=AdpXreiP-3xRIDzq0ApE_RhdaUaTAK_12U5oB5KMIyfJJVyXIxUjb1z5Q6kR0yrd_Iw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRD4g3MJrgzQjEe-u6ycSIkclZD3T-Y_f7bhwsdGA-qHQ&oe=6B04762E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape_coverart.png", "id": "1539093960065384", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982581_1539093963398717_8886613911254029402_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=abAUi40Q5cQQ7kNvwEQhadU&_nc_oc=AdpHX2XGqZmsBSa6p5oD2Mo6mDTT2suTsR13KnpB6_qyhSdUdHsbkBUQxFLVywzmgyU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSmuo0AIJpLbT6EpIRZ4_oF6dFyJNlq9iEsLuZzMe7Pig&oe=6B048AD2"}, "display_name": "Mystery Box VR: Hidden Secrets Escape", "keywords": ["escape", "room", "trivia", "puzzle", "mistero"], "long_description": "# UN'ESPERIENZA DI GIOCO UNICA\nInteragisci con oggetti, maniglie, pulsanti e ruote su ciascun lato. Risolvi gli enigmi e raccogli le tessere del puzzle nascoste su un lato casuale delle scatole.\n\n# SEMBRA COS\u00cc REALE!\nNon sarai in grado di confrontare la realt\u00e0 con la finzione.\n\n\n# SCOPRI LE INVENZIONI\nUna volta sbloccate tutte le 8 caselle di un pacchetto livelli, puoi comporre un puzzle e scoprire una breve storia di un'invenzione.\n\n\n# PENSA FUORI DAGLI SCHEMI\nNon \u00e8 sempre facile fuggire dalla stanza, quindi usa tutto il tuo QI per risolvere gli enigmi. C'\u00e8 una logica dietro a tutti, anche dove sembra che non lo sia!\n\n# AUDIO D'ATMOSFERA\nGioca con le cuffie per immergerti in questa fantastica avventura.\n\n# ]SUGGERIMENTI DISPONIBILI\nSei rimasto bloccato su qualche enigma? Nessun problema, puoi comunque ricevere un suggerimento utile! Puoi anche contattarmi nel caso in cui davvero non riesci a risolvere un indovinello, sar\u00f2 felice di aiutarti ;)\n\n\n# SUPPORTO MULTILINGUA\nDisponibile in inglese, francese, italiano, tedesco, spagnolo, russo e giapponese.\n\nLa lingua del gioco cambier\u00e0 automaticamente in base alle impostazioni della lingua del tuo dispositivo", "short_description": "Un gioco escape room in cui devi risolvere enigmi intriganti per aprire scatole e scoprire simpatiche storie su invenzioni popolari!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://xsgames.co/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "XSGames", "support_website_url": "https://xsgames.co/", "website_url": "https://xsgames.co/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_t
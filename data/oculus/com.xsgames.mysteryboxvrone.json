KVPNmAKPrb2YYU8xq09ZmEFE2n8B2asm7nbgiNSN6IZA&oe=6AB3ECC4"}, {"file_name": "5.png", "id": "467916352871409", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39003282_467916356204742_1871921057092171900_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w3CGWsvEl5oQ7kNvwGBIL1q&_nc_oc=AdqEO8POx1ID6yPYYhtVHlJ9-hI9LPIuclMCgEHRuyFdJHXd_KD5yzZ9YeDNqd7jhjU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKf-pK54v6utVwhRnQ2hrNm4W6PWURP_IFjkZw_VxoVOA&oe=6AB3D162"}, {"file_name": "3.png", "id": "1934382610375855", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974473_1934382613709188_7156337812617042679_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m0lI_t0upD0Q7kNvwHKLvUf&_nc_oc=AdqbPSIPHojbmk3gK9iafdAaYM_FEzKjwuQsM1FUXLfs1_t6ZLuxaPsEcQtIxFdLJBo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIaZMaVQWVAiP17FBIn256oHUl8Kv_E-pgQw_TDUXCxgA&oe=6AB3F3B3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape.png", "id": "1524760081483769", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974531_1524760084817102_6497712644828891067_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SV5NYsiB1cwQ7kNvwE1O0ke&_nc_oc=AdrVs1rkOR2NALnbGFp6QmuCk_1PNFzpI5bAuM9F8efRdfZpgRUXeRJrx_b6G67yihw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLZvze84irTgq-jJnrvZ2Ap96tuwgqv7mT1s0SHCITQ8w&oe=6AB3F2AF"}, "display_name": "Mystery Box VR: Hidden Secrets", "keywords": [], "long_description": " AN IMMERSIVE VR PUZZLE EXPERIENCE\nInteract with objects, handles, buttons, and wheels on each side. Crack enigmas and collect hidden puzzle tiles on a random side of the boxes.\n\nYou won't be able to compare reality with fiction.\n\n# DISCOVER INVENTIONS\nOnce you unlock all 8 boxes of a Level Pack, you can compose a puzzle and discover a brief history of an invention.\n\nIt's not always easy to escape the room, so use all your IQ to crack the riddles. There's a logic behind all of them, even where it seems it's not!\n\n# IMMERSIVE SOUNDTRACK\nPlay the game with your headphones to get immersed in this amazing adventure.\n\n# HINTS\nGot stuck on some enigma? No worries, you can still get a helpful hint! You can also get in touch with me in case you really can't make it through a riddle, I'll be glad to help ;)\n\n# MULTILANGUAGE\nAvailable in English, French, Italian, German, Spanish, Russian, and Japanese.\n\nThe game language will change automatically based on the language settings of your device", "short_description": "A VR escape room game where you have to solve intriguing riddles to open boxes and discover nice stories about popular inventions!"}, {"images": {"nodes": [{"file_name": "$R36BSY5.png", "id": "3678762505771822", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031430_3678762509105155_2151975047074617165_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f4Y4wZIEydMQ7kNvwGArbEt&_nc_oc=Adr5BJ1M8y0y3HGgRyGlaKcf0Hx8ijctZqhOqVBBfL8-xA5JchLcUyi0EC6e_zDJp5A&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLYb6ZcRQw4p9DveAwjg9HrbvhcNDM5i2OTLD_MwfkPhg&oe=6AB3EEA5"}, {"file_name": "$R81V725.png", "id": "2720695481426567", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75262743_2720695484759900_604086922326600035_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=taUYVMWZvakQ7kNvwFPSd-K&_nc_oc=AdrhHXegaV0yxo3t-bhbVUfm-gL_FPlpT0RgDx6F-6ze6QVLAj-0ezn6fAd0mOgsoRc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJghLR2UIoXX_WpsfYpEeACr4aPUz84ZxKFfw_vMsL00w&oe=6AB3ED8D"}, {"file_name": "$RQ3SN6U.png", "id": "1552311425628973", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982519_1552311428962306_1218130395049083834_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fTGJXBIiuB0Q7kNvwEkuCkm&_nc_oc=AdqXACzV8wGB3yZlcyz_zaLXHDZrQT5W2gK-sb31EBWrKKvGlyE1wT7KdP9RKKYQa_A&_nc_zt=3&_nc_ht=
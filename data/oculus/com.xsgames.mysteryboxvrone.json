934382610375855", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974473_1934382613709188_7156337812617042679_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xoQgwt4O4c4Q7kNvwG18ihn&_nc_oc=Adq4-jwdU2Wiw30PJqGxeteHAnF-Ez4pEXpxaodA4Y2nyBMf4MpwBDIWefHuTA4_FnM&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQjreZLOVNXErTez13xUrHjBeJ3_fLJuAlYYzzFpJItKQ&oe=6B09A533"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape_coverart.png", "id": "897861905346420", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/38982672_897861908679753_3996777238831042692_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JxmW-bvMny8Q7kNvwGJ40cW&_nc_oc=AdoTAuA20hRboxm6KhHnrr1KMcQ709ZMSYBZAohiR6AD2JFXMPaQW5Pxh9tMjvrDoU0&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT1hoFEECqTFPGg7niubex5MP48XKU9zRLjTXFTI7L8Kg&oe=6B09A7AB"}, "display_name": "Mystery Box VR: Hidden Secrets Escape", "keywords": ["puzzle", "escape", "room", "trivia", "brainteaser"], "long_description": "# AN IMMERSIVE VR PUZZLE EXPERIENCE\nInteract with objects, handles, buttons, and wheels on each side. Crack enigmas and collect hidden puzzle tiles on a random side of the boxes.\n\nYou won't be able to compare reality with fiction.\n\n# DISCOVER INVENTIONS\nOnce you unlock all 8 boxes of a Level Pack, you can compose a puzzle and discover a brief history of an invention.\n\nIt's not always easy to escape the room, so use all your IQ to crack the riddles. There's a logic behind all of them, even where it seems it's not!\n\n# IMMERSIVE SOUNDTRACK\nPlay the game with your headphones to get immersed in this amazing adventure.\n\n# HINTS\nGot stuck on some enigma? No worries, you can still get a helpful hint! You can also get in touch with me in case you really can't make it through a riddle, I'll be glad to help ;)\n\n# MULTILANGUAGE\nAvailable in English, French, Italian, German, Spanish, Russian, and Japanese.\n\nThe game language will change automatically based on the language settings of your device", "short_description": "Crack awesome puzzles around many boxes, and discover the history of the world's most popular inventions!"}, {"images": {"nodes": [{"file_name": "logoTransparent.png", "id": "3812261432362188", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974562_3812261435695521_5176404439574971225_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Wx_qUPIukYQQ7kNvwGu8yJM&_nc_oc=AdoZkecuNkFSberWioLZtZ6zVkuHbSgxhwUA3FsQTn6P16BAR5oTbKV9xRnVhZnE42M&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ-4MCLrUGy0fKh_vydrQdeK87R5_UBF_QgcTs3mVj2mg&oe=6B09CD96"}, {"file_name": "portrait_coverart.png", "id": "1953342038506987", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/38982581_1953342045173653_4906879878373922307_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Zv-Bi9REH_4Q7kNvwELWXKG&_nc_oc=AdoUPcE6MtO9kqBAMnrDttaeruDzSNMXg0rdqJQG97cCz1Bm-3HM7w5kCfI0Aq7xyIw&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQShs8Pt-7EvoX9XYu8aMJis53NU9TvOpQWpDfIUb80EVw&oe=6B09B67D"}, {"file_name": "landscape_coverart.png", "id": "1300403051139202", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75462955_1300403057805868_2288822001409671177_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cMv0nF2Tr1gQ7kNvwG9cN34&_nc_oc=AdpF827TFVBY1L4g1bieQw6nuDdB8tXYs8_que6LyCFo62umRXBV-zwPvvGqcZR007o&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRiySOnKEKe3XeSSe8ZLmIH9SvLndYiwlnx_vsdNG1Oxg&oe=6B09A720"}, {"file_name": "square_coverart.png", "id": "914408640187392", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/39036626_914408643520725_6339598287132
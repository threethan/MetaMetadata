A3BOdp3QyfpqiF4dCZm7XwQYKl-5KDUD4h0ljps6w5hQ&oe=6A576B84"}, {"file_name": "5.png", "id": "467916352871409", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39003282_467916356204742_1871921057092171900_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QBVflbKl50oQ7kNvwG85YjM&_nc_oc=AdqoSq_qMO_oNNurJ9cdniaWqmIrW4y_bo0exnH8zTQL8QE14VvKfofXUvIX_uW88Qc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBL6fLxLD9-9S8PDb_k58gxrqSKshAdEDiKknfacIFyJg&oe=6A578862"}, {"file_name": "3.png", "id": "1934382610375855", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974473_1934382613709188_7156337812617042679_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=43uyPAhr6KYQ7kNvwHRCWcM&_nc_oc=AdrjicF0xlE1MO9drIf09ytsY-TfSUcVQuWSjnmicYShV0FFWkMkPFk57XccBGi5sAA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBjpNvU64cYOZHqGlxiCuiOQShUjGcUD8IUlDnErBJQmg&oe=6A577273"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape.png", "id": "1524760081483769", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974531_1524760084817102_6497712644828891067_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D-9vpuirp_IQ7kNvwEBAJjp&_nc_oc=Adp5kB_V8A2JxPtJ8gZ6ZyRaS4wNdln_jxrNFgsue34evgoVkW06av6uioaYNq6DlHU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBu-wf2O5rc_SHWRcypV8PeZaM1oMqWAMV5QG8psOJlJg&oe=6A57716F"}, "display_name": "Mystery Box VR: Hidden Secrets", "keywords": [], "long_description": " AN IMMERSIVE VR PUZZLE EXPERIENCE\nInteract with objects, handles, buttons, and wheels on each side. Crack enigmas and collect hidden puzzle tiles on a random side of the boxes.\n\nYou won't be able to compare reality with fiction.\n\n# DISCOVER INVENTIONS\nOnce you unlock all 8 boxes of a Level Pack, you can compose a puzzle and discover a brief history of an invention.\n\nIt's not always easy to escape the room, so use all your IQ to crack the riddles. There's a logic behind all of them, even where it seems it's not!\n\n# IMMERSIVE SOUNDTRACK\nPlay the game with your headphones to get immersed in this amazing adventure.\n\n# HINTS\nGot stuck on some enigma? No worries, you can still get a helpful hint! You can also get in touch with me in case you really can't make it through a riddle, I'll be glad to help ;)\n\n# MULTILANGUAGE\nAvailable in English, French, Italian, German, Spanish, Russian, and Japanese.\n\nThe game language will change automatically based on the language settings of your device", "short_description": "A VR escape room game where you have to solve intriguing riddles to open boxes and discover nice stories about popular inventions!"}, {"images": {"nodes": [{"file_name": "$R36BSY5.png", "id": "3678762505771822", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031430_3678762509105155_2151975047074617165_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IIabnyfXwPwQ7kNvwEZS9M5&_nc_oc=AdpktOZS6mc02TSw3SVV_lWFNe_WynEhdDOtoJsmt5_l5HekdxwmtkqlNZVpK2Vuz-I&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBv1X7tv703q1fx9vlL0mK_NhEYi17QJOf9bfX1EEbFlQ&oe=6A576D65"}, {"file_name": "$R81V725.png", "id": "2720695481426567", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75262743_2720695484759900_604086922326600035_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gipQZ8cL2pMQ7kNvwHYehoI&_nc_oc=Ado2AsHpaMMYNRcFp2T6tWvffHpGZCWeKgISno7t0d1wXXK5lRgObY9ytAQiLlwt5FU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCm_MCF2iMBm3-IN5ShS0piIFp7cAV7VpeEwpDtbMA-CA&oe=6A576C4D"}, {"file_name": "$RQ3SN6U.png", "id": "1552311425628973", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982519_1552311428962306_1218130395049083834_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fsDcVZN9k5EQ7kNvwHosp75&_nc_oc=AdoAzdOGzob8a7JLF361mwV6-WBIUJ4m4rEBxdHM_Ch8g20-apsEHfoW-NfXGV2IelA&_nc_zt=3&_nc_ht=
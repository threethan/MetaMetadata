oculuscdn.com/v/t64.5771-25/39003282_467916356204742_1871921057092171900_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vugACsjBkwUQ7kNvwFRl5dU&_nc_oc=Adn5VRHlGhRV4-afsVO1aKJ3-My_2XCid1X_1kGb_Wi3JFcN1n5EDkIuKkF3q8M3rVA&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=8&oh=00_Afy0OoPoyUADyookTimuT-G4528hlNiZGdswm-vrg_T0bg&oe=69BAA5E2"}, {"file_name": "3.png", "id": "1934382610375855", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974473_1934382613709188_7156337812617042679_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dpnxhLi8FlUQ7kNvwEbDcRQ&_nc_oc=AdlHHhFhUaoC4qewcIevAu9leHWTXf4J7i7A_lAXTdedNVTndc1ZpnPHDZJ5u3GO8mo&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=8&oh=00_AfynFlcrVwLdYqWwbMRqRIjzqhOX9x97dw5aMSQN71cmXw&oe=69BA8FF3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape.png", "id": "1524760081483769", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974531_1524760084817102_6497712644828891067_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JD8agOtHBsgQ7kNvwG8VSKK&_nc_oc=Adkgv1aa_-PEFhLuJXoCcbY8N8uth-kBzOJSACFqyf3YbdBce2vwj5NaplGbZl2jAXc&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=8&oh=00_Afxasj6dfv9-oIlL_9Q68FGVAytK4-nRaD02UeTgX0J32A&oe=69BA8EEF"}, "display_name": "Mystery Box VR: Hidden Secrets", "keywords": [], "long_description": " AN IMMERSIVE VR PUZZLE EXPERIENCE\nInteract with objects, handles, buttons, and wheels on each side. Crack enigmas and collect hidden puzzle tiles on a random side of the boxes.\n\nYou won't be able to compare reality with fiction.\n\n# DISCOVER INVENTIONS\nOnce you unlock all 8 boxes of a Level Pack, you can compose a puzzle and discover a brief history of an invention.\n\nIt's not always easy to escape the room, so use all your IQ to crack the riddles. There's a logic behind all of them, even where it seems it's not!\n\n# IMMERSIVE SOUNDTRACK\nPlay the game with your headphones to get immersed in this amazing adventure.\n\n# HINTS\nGot stuck on some enigma? No worries, you can still get a helpful hint! You can also get in touch with me in case you really can't make it through a riddle, I'll be glad to help ;)\n\n# MULTILANGUAGE\nAvailable in English, French, Italian, German, Spanish, Russian, and Japanese.\n\nThe game language will change automatically based on the language settings of your device", "short_description": "A VR escape room game where you have to solve intriguing riddles to open boxes and discover nice stories about popular inventions!"}, {"images": {"nodes": [{"file_name": "$R36BSY5.png", "id": "3678762505771822", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39031430_3678762509105155_2151975047074617165_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mbcVYu0WZHgQ7kNvwGdqDaz&_nc_oc=AdmBP4zxLTiASzbwhQkdccmfmfAfbC8io4vDToh2Ef7di6Xn77DZyN4oDZnTavcC_hY&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=8&oh=00_AfxYmFcIZlVTA-uzM7sn4ZnMiRBoP1MbJ6eIQ2FsqPJ-3A&oe=69BA8AE5"}, {"file_name": "$R81V725.png", "id": "2720695481426567", "image_type": "APP_IMG_ICON", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/75262743_2720695484759900_604086922326600035_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UpDarz2DELsQ7kNvwE_5XcW&_nc_oc=AdnhClFi6-nbC0SHpFdr7cPcu12Poy7K8L7PqKMkqDBydLYpN7W3o5W1JOZ0PXH5Tmk&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_AfxeeGWPhqwkdDP2PAxs0tqh4teUtQZ5fMemJmPAwEAB0w&oe=69BA89CD"}, {"file_name": "$RQ3SN6U.png", "id": "1552311425628973", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38982519_1552311428962306_1218130395049083834_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VAYu0C5WcR4Q7kNvwH9W1DR&_nc_oc=Adkd6mmwhC3d69orjHnSM14Nnjkq6sgEX13YKF7iut3GmK0a1EWm-igKhVHY-xPb-Cw&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_AfyDKNUVqSwqS_kJhylCRQlsMJFIJSXFgQCE1Z4cocpT-A&oe=69BA9529"}, {"file_name": "38982645_1000853181732648_505551742782
&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UFVfNO2YcvgQ7kNvwHKSjLe&_nc_oc=Adq6scyZJecZ9ZIdzqdWL3wLqs-id3BjfiDISgVfgNAGwWbQFSNQ7mx6UAy9zQ9z79s&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRtEFtHk-N7JfdMkRaq3t1d3_sws94_kwPh4YC0-6c60Q&oe=6B0C6A08"}, {"file_name": "2.png", "id": "2203761473315962", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75469623_2203761476649295_9180026026436178997_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a3sJHdvYklgQ7kNvwHcIXrA&_nc_oc=AdqwDDjAv7dBmy9v2_b-xkmOZq4RfmAKmjZUXNvHWnejqo-sFTgBSn4Hf6qiiaxStu4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTTLwItFB3G0f2o2wNyNet0TMSnzdDD5EpB8L61ejVAIQ&oe=6B0C5F31"}, {"file_name": "5.png", "id": "1600206790893068", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974920_1600206794226401_7626143159008067194_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=scpaO0VHOzsQ7kNvwHFhKxl&_nc_oc=AdoMF52Po-dXpjzkr843HZ37tprE71ICt8t4G-s3hzZNm32UKDZ5kOVF-NFkYY439RE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRILr-We6T9Bhfa0-CN4JOYx5pI-axDJ7yHLTp_gR5CZg&oe=6B0C6BCA"}, {"file_name": "3.png", "id": "1053463469622332", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75395599_1053463472955665_4671093965273907425_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HU_czkykk9oQ7kNvwFDjw9q&_nc_oc=Adpj5haiQ-nXfxzMDYH2STK8xf8IEXe4ujeovARHdS6kQ_9yTpifhhkVTYr_uJpAhpw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQSjwxnFIJ93uWACHCDJNgzQrcmurPoNVk5J99jrw5ugQ&oe=6B0C5F2E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape_coverart.png", "id": "1539093960065384", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982581_1539093963398717_8886613911254029402_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YWsxgDLcj9sQ7kNvwFB7BaJ&_nc_oc=AdqixRsugun8w3wUHRc0DkzUg-S83PrKaxY4-wbcgndSMPAMmEbjCngbU32wl-_8sz4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQXGZrQJSl64CeLKH6J6NSK4rHXSx5ZTOBt1AF2sPcbSw&oe=6B0C73D2"}, "display_name": "Mystery Box VR: Hidden Secrets Escape", "keywords": ["escape", "room", "trivia", "puzzle", "mistero"], "long_description": "# UN'ESPERIENZA DI GIOCO UNICA\nInteragisci con oggetti, maniglie, pulsanti e ruote su ciascun lato. Risolvi gli enigmi e raccogli le tessere del puzzle nascoste su un lato casuale delle scatole.\n\n# SEMBRA COS\u00cc REALE!\nNon sarai in grado di confrontare la realt\u00e0 con la finzione.\n\n\n# SCOPRI LE INVENZIONI\nUna volta sbloccate tutte le 8 caselle di un pacchetto livelli, puoi comporre un puzzle e scoprire una breve storia di un'invenzione.\n\n\n# PENSA FUORI DAGLI SCHEMI\nNon \u00e8 sempre facile fuggire dalla stanza, quindi usa tutto il tuo QI per risolvere gli enigmi. C'\u00e8 una logica dietro a tutti, anche dove sembra che non lo sia!\n\n# AUDIO D'ATMOSFERA\nGioca con le cuffie per immergerti in questa fantastica avventura.\n\n# ]SUGGERIMENTI DISPONIBILI\nSei rimasto bloccato su qualche enigma? Nessun problema, puoi comunque ricevere un suggerimento utile! Puoi anche contattarmi nel caso in cui davvero non riesci a risolvere un indovinello, sar\u00f2 felice di aiutarti ;)\n\n\n# SUPPORTO MULTILINGUA\nDisponibile in inglese, francese, italiano, tedesco, spagnolo, russo e giapponese.\n\nLa lingua del gioco cambier\u00e0 automaticamente in base alle impostazioni della lingua del tuo dispositivo", "short_description": "Un gioco escape room in cui devi risolvere enigmi intriganti per aprire scatole e scoprire simpatiche storie su invenzioni popolari!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://xsgames.co/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "XSGames", "support_website_url": "https://xsgames.co/", "website_url": "https://xsgames.co/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_t
5S-AG6q3glZ0blzAwvVxhIYUqUZ0ZYNooBTDxxM9c38A&oe=6A01F244"}, {"file_name": "5.png", "id": "467916352871409", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39003282_467916356204742_1871921057092171900_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sDZB5jIsWZ4Q7kNvwGeiNGw&_nc_oc=AdpnWVGu50-A17eXu-vGm_HJcXqAXXiZ_Xy-GS1BoZFti8MAV3vBOZyMr69tlery0M8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5GdVl5ePuCznWaU_6WbIvOkb7oSGTjx_n655W7E3-4oQ&oe=6A01D6E2"}, {"file_name": "3.png", "id": "1934382610375855", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974473_1934382613709188_7156337812617042679_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FY5fOzh_KHkQ7kNvwHwFxqu&_nc_oc=AdqNglku70aUPdCdLpu7o2llJdZQN-Q9hlUbovkCpg8GQe_HLrZzGpKal8_aHVG0Udw&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6GDqWzItB4tIrgomOMXNgyQ_i-dHIsjOlbEU_HIHnWgg&oe=6A01F933"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape.png", "id": "1524760081483769", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974531_1524760084817102_6497712644828891067_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VCgSacJElNwQ7kNvwFSFfXn&_nc_oc=AdrqWbWelXiBqHp2fRkpjD-BOXcdIBueAEvecEvHD4CQZNAIlBno3SJDfQTP2J_p1wM&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6OJ1GdhuovuDrDw7foo9wmjXFSjJiAQF9FBSoPXkQ24A&oe=6A01F82F"}, "display_name": "Mystery Box VR: Hidden Secrets", "keywords": [], "long_description": " AN IMMERSIVE VR PUZZLE EXPERIENCE\nInteract with objects, handles, buttons, and wheels on each side. Crack enigmas and collect hidden puzzle tiles on a random side of the boxes.\n\nYou won't be able to compare reality with fiction.\n\n# DISCOVER INVENTIONS\nOnce you unlock all 8 boxes of a Level Pack, you can compose a puzzle and discover a brief history of an invention.\n\nIt's not always easy to escape the room, so use all your IQ to crack the riddles. There's a logic behind all of them, even where it seems it's not!\n\n# IMMERSIVE SOUNDTRACK\nPlay the game with your headphones to get immersed in this amazing adventure.\n\n# HINTS\nGot stuck on some enigma? No worries, you can still get a helpful hint! You can also get in touch with me in case you really can't make it through a riddle, I'll be glad to help ;)\n\n# MULTILANGUAGE\nAvailable in English, French, Italian, German, Spanish, Russian, and Japanese.\n\nThe game language will change automatically based on the language settings of your device", "short_description": "A VR escape room game where you have to solve intriguing riddles to open boxes and discover nice stories about popular inventions!"}, {"images": {"nodes": [{"file_name": "$R36BSY5.png", "id": "3678762505771822", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031430_3678762509105155_2151975047074617165_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2nn_jMYQG_YQ7kNvwFNPQ5G&_nc_oc=AdqdAKlZh7U9mSdIGnXF1hC7gbQza9imb9S-DkzhN1d4XFIc4lChykKOHga0JUIK6ak&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7mjN9fs7mKlDre0Srv2BL4TsiiQCQuU33g5ukkrjZn2A&oe=6A01F425"}, {"file_name": "$R81V725.png", "id": "2720695481426567", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75262743_2720695484759900_604086922326600035_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UOLPL5g8Ga8Q7kNvwGUyk96&_nc_oc=AdrksOF_wbnAMLOlyHeXL9obBoh9soaXsHLPHwiZvJwXsR_iLac9qV7DTGqb6KwC-lk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6E5e0FOvaOhSFfScxkNHN87rvLctu_91cBFc52rEHLnQ&oe=6A01F30D"}, {"file_name": "$RQ3SN6U.png", "id": "1552311425628973", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982519_1552311428962306_1218130395049083834_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VINS1rQ9bygQ7kNvwEK7DZ_&_nc_oc=Adq9ky0nIGl6WsK-Fgeva7ZtuMHfVDaGlT_oOVK0epk_crgHLo76zeE6Jc6A02q4r58&_nc_zt=3&_nc_ht=
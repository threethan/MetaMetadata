34odrft87S6gvRVPZ3PyDQ0RHJIJquJntZR6JSK4AmhA&oe=69ECA204"}, {"file_name": "5.png", "id": "467916352871409", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39003282_467916356204742_1871921057092171900_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jhoVSmIYNOwQ7kNvwFbfSRx&_nc_oc=AdpYBuno60vDp6zdV0cKqk4DhfHCcArEtEj6R_eQKf1quw1OTiYZ6eLTbzS4r30egXQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0T0a2A1HyUDPLFk1a8OcDzxm7DdFASD_6VsdVEHimwoA&oe=69ECBEE2"}, {"file_name": "3.png", "id": "1934382610375855", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974473_1934382613709188_7156337812617042679_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dVkMoe2UiTwQ7kNvwH21Cgj&_nc_oc=Adpy7zm6nrmmZmEnT7qiJaiRfj_QNdm6H5gYoGdQ1PNVvd1ZuDBK9O4HVN43CNxS_dU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2530PTsd1Udi_6jTH01HxAoJSqwUmuuwFucaNkvejkyA&oe=69ECA8F3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape.png", "id": "1524760081483769", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974531_1524760084817102_6497712644828891067_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CClqrMKyiagQ7kNvwFDXfsf&_nc_oc=Adqh7Ps_v4euQ01BrFLIaYhF8REVFuSK19gSw9I080dWgLQZDcU0oi-APCHb8LyaP4k&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1MhmkhGq98adOa2clwKlUtv5TUBYuqC39fvVCrvLumFQ&oe=69ECA7EF"}, "display_name": "Mystery Box VR: Hidden Secrets", "keywords": [], "long_description": " AN IMMERSIVE VR PUZZLE EXPERIENCE\nInteract with objects, handles, buttons, and wheels on each side. Crack enigmas and collect hidden puzzle tiles on a random side of the boxes.\n\nYou won't be able to compare reality with fiction.\n\n# DISCOVER INVENTIONS\nOnce you unlock all 8 boxes of a Level Pack, you can compose a puzzle and discover a brief history of an invention.\n\nIt's not always easy to escape the room, so use all your IQ to crack the riddles. There's a logic behind all of them, even where it seems it's not!\n\n# IMMERSIVE SOUNDTRACK\nPlay the game with your headphones to get immersed in this amazing adventure.\n\n# HINTS\nGot stuck on some enigma? No worries, you can still get a helpful hint! You can also get in touch with me in case you really can't make it through a riddle, I'll be glad to help ;)\n\n# MULTILANGUAGE\nAvailable in English, French, Italian, German, Spanish, Russian, and Japanese.\n\nThe game language will change automatically based on the language settings of your device", "short_description": "A VR escape room game where you have to solve intriguing riddles to open boxes and discover nice stories about popular inventions!"}, {"images": {"nodes": [{"file_name": "$R36BSY5.png", "id": "3678762505771822", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031430_3678762509105155_2151975047074617165_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-3kU9V1Zn6kQ7kNvwEuV78b&_nc_oc=AdrYe0SEwmnLA7BQMZI3YeQJQApTcku8jqixpE7XqAPygssYYumTU6kTXOI8nez3gWc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0R9ABjg12qoV_hgMkD8bQoINaddd57m3WWVKTdj3cXmw&oe=69ECA3E5"}, {"file_name": "$R81V725.png", "id": "2720695481426567", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75262743_2720695484759900_604086922326600035_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E-IvY6_8KpQQ7kNvwHAlXen&_nc_oc=Ado3Tq3pftJ1k1vQ87eT42Dr-P8R4oBodVX-3CNxyfNg8sAQY_mVxDWMDhnsyvy-jEs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3J46W9JTb9VrBIRMupeBbkyJdNxWAVsagRoR1g-rh1Lw&oe=69ECA2CD"}, {"file_name": "$RQ3SN6U.png", "id": "1552311425628973", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982519_1552311428962306_1218130395049083834_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Gf7T_v6OUGsQ7kNvwFzjMxR&_nc_oc=AdqBgCZD436q_smbhjp5JkkF2dxJtfD6GSkLXl__67aCgMJfDvnHB2WutFctu7ZT-es&_nc_zt=3&_nc_ht=
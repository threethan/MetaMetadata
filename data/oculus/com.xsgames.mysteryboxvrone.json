8CGzfch4GbqVGV0A5STY9fJHpPaYbiGQXfcfbuBUiCNg&oe=6A47D1C4"}, {"file_name": "5.png", "id": "467916352871409", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39003282_467916356204742_1871921057092171900_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2y8uKbGcf5IQ7kNvwEYwa2R&_nc_oc=Adpu63FHluyrr6WFdfYrhAjNWYnLm_IP7eL0sheU4pQCek7FktYTN3PvYRyXc7n9-tQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-Na-DjYFG-DLK69uQOD48mUTkCFXk2-SOM8nsoETsajA&oe=6A47B662"}, {"file_name": "3.png", "id": "1934382610375855", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974473_1934382613709188_7156337812617042679_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1tcL5KkxqKAQ7kNvwGQwIlt&_nc_oc=AdpDY1IJNGDlLzY0r7GZIcLs5Ge2014VneK8_Od6B5C5zrPFMt8NG7ncteg531oMp2E&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_-zrxv5oUzAbyctvWAPhUDTZYiebe1W8OX3GH3hWvDhA&oe=6A47D8B3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape.png", "id": "1524760081483769", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974531_1524760084817102_6497712644828891067_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P0-xFnl4IacQ7kNvwGkRclv&_nc_oc=Ado8I3EFZUB8ZBK5hLD0FOFYE5NVKgGnwf87YyKsBhzzXSZaYIJ0bHEuAFEcrvPFJ9w&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9NmoabdOoZ7K7k_Ii0KJagnSfmUfzA_nw88EZhrsoZsQ&oe=6A47D7AF"}, "display_name": "Mystery Box VR: Hidden Secrets", "keywords": [], "long_description": " AN IMMERSIVE VR PUZZLE EXPERIENCE\nInteract with objects, handles, buttons, and wheels on each side. Crack enigmas and collect hidden puzzle tiles on a random side of the boxes.\n\nYou won't be able to compare reality with fiction.\n\n# DISCOVER INVENTIONS\nOnce you unlock all 8 boxes of a Level Pack, you can compose a puzzle and discover a brief history of an invention.\n\nIt's not always easy to escape the room, so use all your IQ to crack the riddles. There's a logic behind all of them, even where it seems it's not!\n\n# IMMERSIVE SOUNDTRACK\nPlay the game with your headphones to get immersed in this amazing adventure.\n\n# HINTS\nGot stuck on some enigma? No worries, you can still get a helpful hint! You can also get in touch with me in case you really can't make it through a riddle, I'll be glad to help ;)\n\n# MULTILANGUAGE\nAvailable in English, French, Italian, German, Spanish, Russian, and Japanese.\n\nThe game language will change automatically based on the language settings of your device", "short_description": "A VR escape room game where you have to solve intriguing riddles to open boxes and discover nice stories about popular inventions!"}, {"images": {"nodes": [{"file_name": "$R36BSY5.png", "id": "3678762505771822", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031430_3678762509105155_2151975047074617165_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z5SLRtMHrp0Q7kNvwGsOaFV&_nc_oc=Adqvq2BZLOMm05vXMaDej_X7eiFfRRjA5oPW2dS4LPFPM1cfXZCUaRW-6wseNMGm844&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9936b6zSIuT5ePrs5_TuySNptpz_7Q6VJPsWuPDjCh0Q&oe=6A47D3A5"}, {"file_name": "$R81V725.png", "id": "2720695481426567", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75262743_2720695484759900_604086922326600035_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ROjyII5sDLgQ7kNvwEwDe8B&_nc_oc=Adpznc_njtM82G7z-412YzD1meBFek-R_bqSeLMw4XDeB1KBxJBfSz3PjQ0zWd20ozE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8WiWOcCHG7KeecxNbUjrbAmlhSzr8pKM3OhfWG1USjrQ&oe=6A47D28D"}, {"file_name": "$RQ3SN6U.png", "id": "1552311425628973", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982519_1552311428962306_1218130395049083834_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QHPufo2j8-0Q7kNvwF94C_x&_nc_oc=AdrE-d1ShsEvFXjjwQY8I9dP1lXtobg33W59SDnrpHmSbUL98tR0_Et743QBxGyhAn0&_nc_zt=3&_nc_ht=
SvqcYjg8BpiVqb968y20CTHsYCwd_HkbU93cW_hFtkhQ&oe=6AF5D7C4"}, {"file_name": "5.png", "id": "467916352871409", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39003282_467916356204742_1871921057092171900_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=10pBO92NHhEQ7kNvwF7S9k-&_nc_oc=Ado2sKab33OXmTBaXfjEvNMZi3-1ZmZWpl-guwRMyuzb5zkmMrf1QZMJF9yhFf6wAmI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQuFLqnPR_zYg56duPDyS1C7Oa4J_maT5tJ2KIneuIaCA&oe=6AF5F4A2"}, {"file_name": "3.png", "id": "1934382610375855", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974473_1934382613709188_7156337812617042679_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HSDiqKByD_UQ7kNvwGP3sVp&_nc_oc=Adom50gXSOG6UnRkZeWQ7PDv1fTzGs83SYkI3sLzICy_DFVZq-3vL0GUaewdwXnzThw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT9wrVG79nG5fPG-fHYT_3BEoA2fTYIpFRM0AX8UVIWeg&oe=6AF5DEB3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape.png", "id": "1524760081483769", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974531_1524760084817102_6497712644828891067_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m-RqDXosyyIQ7kNvwEiG_H6&_nc_oc=AdpgiBmkrUzb1LhvO5ehzpI1TmhyazVJnJckFmoZUu9eR16DLRt_sn6xicLDso54L3Q&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSMAcuwPDb7ICFoCayh2jteMMbUAI2seak4Yhk6DG4kIQ&oe=6AF5DDAF"}, "display_name": "Mystery Box VR: Hidden Secrets", "keywords": [], "long_description": " AN IMMERSIVE VR PUZZLE EXPERIENCE\nInteract with objects, handles, buttons, and wheels on each side. Crack enigmas and collect hidden puzzle tiles on a random side of the boxes.\n\nYou won't be able to compare reality with fiction.\n\n# DISCOVER INVENTIONS\nOnce you unlock all 8 boxes of a Level Pack, you can compose a puzzle and discover a brief history of an invention.\n\nIt's not always easy to escape the room, so use all your IQ to crack the riddles. There's a logic behind all of them, even where it seems it's not!\n\n# IMMERSIVE SOUNDTRACK\nPlay the game with your headphones to get immersed in this amazing adventure.\n\n# HINTS\nGot stuck on some enigma? No worries, you can still get a helpful hint! You can also get in touch with me in case you really can't make it through a riddle, I'll be glad to help ;)\n\n# MULTILANGUAGE\nAvailable in English, French, Italian, German, Spanish, Russian, and Japanese.\n\nThe game language will change automatically based on the language settings of your device", "short_description": "A VR escape room game where you have to solve intriguing riddles to open boxes and discover nice stories about popular inventions!"}, {"images": {"nodes": [{"file_name": "$R36BSY5.png", "id": "3678762505771822", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031430_3678762509105155_2151975047074617165_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L35lklFUzGwQ7kNvwGSb2CG&_nc_oc=AdrfK7dnGR_-UvmTFOWAWhUL-G0CEKIVXh1VuQATa_iAl-QBk1NIIFej1MvVN8LpMSc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTX2gELXUMgFa0o01TcHpGDyOItuurFOUWGqye64aT0hg&oe=6AF5D9A5"}, {"file_name": "$R81V725.png", "id": "2720695481426567", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75262743_2720695484759900_604086922326600035_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1iP6G2iIr04Q7kNvwGbZLsA&_nc_oc=Adq0Ks_GJW-nMU6fGahCL7HqWlYhjsNO9ueeuBIcTw9UQDUFvXHZcr7OC_3tehfGLRo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQStFEBhvZXO_pVnr8momFEy9vusEbMMBln80hssVIKIAA&oe=6AF5D88D"}, {"file_name": "$RQ3SN6U.png", "id": "1552311425628973", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982519_1552311428962306_1218130395049083834_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ivuJwpZbrHAQ7kNvwG-1A5B&_nc_oc=Adoa_xeilHPUnGxqaBoGRMLNavVVGgwVHAxMmYJAbUn_MqJxSdCPJadmHX4Lsn09vKo&_nc_zt=3&_nc_ht=
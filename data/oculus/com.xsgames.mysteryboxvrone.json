FtOdLgjJOSc-ppJvvYKF11lpn9_XH1Fs4wN-SHzJeI0w&oe=6A86E184"}, {"file_name": "5.png", "id": "467916352871409", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39003282_467916356204742_1871921057092171900_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sFAPI_R-uCYQ7kNvwFbfVRd&_nc_oc=Adqt_fltA1QUJAPg54cCjt_N0yFTlgEZQB0TSUi4NFd2EDkJebV4CSSgD8O3phLi7I4&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFEToFHO9BWNdeB-CPPgfmaKntlyD9if6e0hTH8JpUnxA&oe=6A86FE62"}, {"file_name": "3.png", "id": "1934382610375855", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974473_1934382613709188_7156337812617042679_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r9Ra2wldkIUQ7kNvwF5Z9Tp&_nc_oc=AdpOqaGy0EuDjb3i61tQO7soCYCcaU46x9n4xjbiw5XDOuNRn_bX4VVFf8XGjrxF8eM&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHFTRHwoQ7fDhW1eqVKEUhQhbdIIh3vz0vCNEfRa1BJHA&oe=6A86E873"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape.png", "id": "1524760081483769", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974531_1524760084817102_6497712644828891067_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VGDSsTtMcgoQ7kNvwHPgNUT&_nc_oc=AdpkMtmoyjqhlc1WJyM2WhFc6diqVmMjziwh01WVoKdBpUekn6IMIFw6cQo8FnoNReg&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFL4UM61TE3G6RYnSPcmpEn8KerOFCrC2euJLIKkCFdZA&oe=6A86E76F"}, "display_name": "Mystery Box VR: Hidden Secrets", "keywords": [], "long_description": " AN IMMERSIVE VR PUZZLE EXPERIENCE\nInteract with objects, handles, buttons, and wheels on each side. Crack enigmas and collect hidden puzzle tiles on a random side of the boxes.\n\nYou won't be able to compare reality with fiction.\n\n# DISCOVER INVENTIONS\nOnce you unlock all 8 boxes of a Level Pack, you can compose a puzzle and discover a brief history of an invention.\n\nIt's not always easy to escape the room, so use all your IQ to crack the riddles. There's a logic behind all of them, even where it seems it's not!\n\n# IMMERSIVE SOUNDTRACK\nPlay the game with your headphones to get immersed in this amazing adventure.\n\n# HINTS\nGot stuck on some enigma? No worries, you can still get a helpful hint! You can also get in touch with me in case you really can't make it through a riddle, I'll be glad to help ;)\n\n# MULTILANGUAGE\nAvailable in English, French, Italian, German, Spanish, Russian, and Japanese.\n\nThe game language will change automatically based on the language settings of your device", "short_description": "A VR escape room game where you have to solve intriguing riddles to open boxes and discover nice stories about popular inventions!"}, {"images": {"nodes": [{"file_name": "$R36BSY5.png", "id": "3678762505771822", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39031430_3678762509105155_2151975047074617165_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kDdeyixfcfYQ7kNvwGZgokZ&_nc_oc=AdrYgdyQtuqkDKt5ruXpkXEfueGnOPN2I9RqfDMAOSIqjzqMWLX6vUEhK9DGVOpNrRY&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFa1AMCJvYrTQCBcaUAsC6bxSoL15q2nAq356fGkt8WhA&oe=6A86E365"}, {"file_name": "$R81V725.png", "id": "2720695481426567", "image_type": "APP_IMG_ICON", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/75262743_2720695484759900_604086922326600035_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nJZHQ2He9JEQ7kNvwFSVLq6&_nc_oc=Adp4mTqhCxhQE0JAF0m4U9OmhNmjKZOFSKCGWPpHf-zm6McHTP-ynLNl7l-AOjgEMCU&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFJgMuGECrqq97Cygb3tyFV60xDkcU5Vhy1UHn_89hSLw&oe=6A86E24D"}, {"file_name": "$RQ3SN6U.png", "id": "1552311425628973", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38982519_1552311428962306_1218130395049083834_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mM538yIBAvcQ7kNvwFHzm4M&_nc_oc=AdpesgOXo6UHPMT9csLhvRT9QoaRPmigTsLSCableImmSlLsxE3-QvxYqG2m9bP793M&_nc_zt=3&_nc_ht=
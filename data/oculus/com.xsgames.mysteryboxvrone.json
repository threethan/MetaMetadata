04PkUV3wTWXqiz7hLAFzoe-TDIFPGJHcRBhFpahtCY_w&oe=69E75C04"}, {"file_name": "5.png", "id": "467916352871409", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/39003282_467916356204742_1871921057092171900_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v7TR56NKjikQ7kNvwF3iLal&_nc_oc=AdrjS08P1YM0mStlUxIooVXN23cG8DjZBGmqY1YIPjyIKLQ7teuwpcQ5UpnHV7WJPYo&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0AT1yqn9hraTLh9JWuEe_5xqsAFTByDhicWDYJuG79kQ&oe=69E778E2"}, {"file_name": "3.png", "id": "1934382610375855", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38974473_1934382613709188_7156337812617042679_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Fz2HJf9NJi8Q7kNvwF44g6O&_nc_oc=Adqn-o7sUmdt8zRJa_kXAo9ZORJE2VdAbIolVE-L-Gv4KFN2P2TDt-2KpZlWDQPJvQI&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3h8Z9kMmeaIwLgh0mn7Aar5R2dsiTB9NueAAm3ZygVDA&oe=69E762F3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape.png", "id": "1524760081483769", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38974531_1524760084817102_6497712644828891067_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4vCQCHiAyCQQ7kNvwGPpGF9&_nc_oc=AdpuvM0NfZ7ePX4feFNPsT2cPwDiUxTF9K4AIhJQDLRfbvYVIX-pyIzkTsh4Osr3bZg&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af34NiKC7IwKDbf1hdizJmMUtQY-v22Y5UH6aRONQ_qEDQ&oe=69E761EF"}, "display_name": "Mystery Box VR: Hidden Secrets", "keywords": [], "long_description": " AN IMMERSIVE VR PUZZLE EXPERIENCE\nInteract with objects, handles, buttons, and wheels on each side. Crack enigmas and collect hidden puzzle tiles on a random side of the boxes.\n\nYou won't be able to compare reality with fiction.\n\n# DISCOVER INVENTIONS\nOnce you unlock all 8 boxes of a Level Pack, you can compose a puzzle and discover a brief history of an invention.\n\nIt's not always easy to escape the room, so use all your IQ to crack the riddles. There's a logic behind all of them, even where it seems it's not!\n\n# IMMERSIVE SOUNDTRACK\nPlay the game with your headphones to get immersed in this amazing adventure.\n\n# HINTS\nGot stuck on some enigma? No worries, you can still get a helpful hint! You can also get in touch with me in case you really can't make it through a riddle, I'll be glad to help ;)\n\n# MULTILANGUAGE\nAvailable in English, French, Italian, German, Spanish, Russian, and Japanese.\n\nThe game language will change automatically based on the language settings of your device", "short_description": "A VR escape room game where you have to solve intriguing riddles to open boxes and discover nice stories about popular inventions!"}, {"images": {"nodes": [{"file_name": "$R36BSY5.png", "id": "3678762505771822", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/39031430_3678762509105155_2151975047074617165_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SFQzbCp1j3sQ7kNvwG5zHAw&_nc_oc=AdrQXbe97akgH_u18RMQXMo_cQPwMcOX5O_pV8Z5oJccYrml5XQGnC_C0JtkFyK9Bck&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af08HqWbgwZrbDYZaT_cYrOGL5RVvRmnVlWz5i1o0mJEmw&oe=69E75DE5"}, {"file_name": "$R81V725.png", "id": "2720695481426567", "image_type": "APP_IMG_ICON", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/75262743_2720695484759900_604086922326600035_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jEJom_-9AHIQ7kNvwERMP1U&_nc_oc=Adqv6iSNYdRPG0o7g7wgwINCD0Q1qJUaW-DPQcEPZviP64CyANKBwu4y-I82mCigSP8&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0CAVfLzA-HbjXa2iEu_RAv-yS-wKgbIwKTDH4Q_kuPGw&oe=69E75CCD"}, {"file_name": "$RQ3SN6U.png", "id": "1552311425628973", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38982519_1552311428962306_1218130395049083834_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3IpkNCyuN6AQ7kNvwFpDXQY&_nc_oc=AdrkvzaaqPR7QJKFwCQLDCDMJcFkqSFKC3-Sifpq-7rR2P1jCZS4IX72v5DjSW_yzOE&_nc_zt=3&_nc_ht=
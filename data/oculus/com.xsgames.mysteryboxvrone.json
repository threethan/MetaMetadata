nc_ss=7f20f&oh=00_Af-TW8Omg68K3djYBrozQg1eLPHmaI7-EbIEG_k4wmU7mw&oe=6A468044"}, {"file_name": "5.png", "id": "467916352871409", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/39003282_467916356204742_1871921057092171900_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MzufMR8pp_EQ7kNvwGhXF9f&_nc_oc=Ado_nqMgtkK6DQga901wSJcrLNeD0fdjdBENMuGLM8GzBdnNXQOvw5kyNpYbsKBbzv4&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af88EOwwaQ2TekSOJ57JsK5t14lzIH0RCvBsTtONqN1nKA&oe=6A4664E2"}, {"file_name": "3.png", "id": "1934382610375855", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/38974473_1934382613709188_7156337812617042679_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1tcL5KkxqKAQ7kNvwHIWAqW&_nc_oc=AdopYPypeisyLw-4HxycjjKDCFFPQVPS6qY3914uAahdY66McvaPdUGhRm0mwGuwNkA&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9hHtSl8MXpXobuKsY0SY5mfrOLc67Ug2xiATG-kt05qw&oe=6A468733"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape.png", "id": "1524760081483769", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/38974531_1524760084817102_6497712644828891067_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DRKjDrw24koQ7kNvwFcsVRh&_nc_oc=Adoj-cbZint5itH0WHWRjtS3Msfqn0v0mJ3UUqpaAclQXZe6MdEBzgxgP69zCRc3xj0&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_X4T71trgUcbwDNxOgTQc2G54m5IKVZ49IJuLb-XQiUQ&oe=6A46862F"}, "display_name": "Mystery Box VR: Hidden Secrets", "keywords": [], "long_description": " AN IMMERSIVE VR PUZZLE EXPERIENCE\nInteract with objects, handles, buttons, and wheels on each side. Crack enigmas and collect hidden puzzle tiles on a random side of the boxes.\n\nYou won't be able to compare reality with fiction.\n\n# DISCOVER INVENTIONS\nOnce you unlock all 8 boxes of a Level Pack, you can compose a puzzle and discover a brief history of an invention.\n\nIt's not always easy to escape the room, so use all your IQ to crack the riddles. There's a logic behind all of them, even where it seems it's not!\n\n# IMMERSIVE SOUNDTRACK\nPlay the game with your headphones to get immersed in this amazing adventure.\n\n# HINTS\nGot stuck on some enigma? No worries, you can still get a helpful hint! You can also get in touch with me in case you really can't make it through a riddle, I'll be glad to help ;)\n\n# MULTILANGUAGE\nAvailable in English, French, Italian, German, Spanish, Russian, and Japanese.\n\nThe game language will change automatically based on the language settings of your device", "short_description": "A VR escape room game where you have to solve intriguing riddles to open boxes and discover nice stories about popular inventions!"}, {"images": {"nodes": [{"file_name": "$R36BSY5.png", "id": "3678762505771822", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/39031430_3678762509105155_2151975047074617165_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z5SLRtMHrp0Q7kNvwHrbT4N&_nc_oc=AdqqdumvMiKVtP9ZjVGJ-z3ExjxIyZRjHC8l7n0QzLJQzyNcrT0h7RL7L7pmcqlRX8U&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9o88865Pwf2r96RR8m6z7Mqkqrp9rS3hpvJDVIrRMZrw&oe=6A468225"}, {"file_name": "$R81V725.png", "id": "2720695481426567", "image_type": "APP_IMG_ICON", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/75262743_2720695484759900_604086922326600035_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ROjyII5sDLgQ7kNvwEVG0TU&_nc_oc=AdpAn54_hOzE9X6rWnOZ1LIfeYCASfmaCXiU_nX5UYAq5N6zDqUvWgaUXVsv7TZsAS8&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8MMfspotZIbwHuHlon1vJGvI5zEa2aDyP6aSkrNwKHow&oe=6A46810D"}, {"file_name": "$RQ3SN6U.png", "id": "1552311425628973", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/38982519_1552311428962306_1218130395049083834_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QHPufo2j8-0Q7kNvwFiANgp&_nc_oc=AdqA7Im3Rz6KRrEC0OLDtx07S_nX4HZiJTmCezwwYS0uN0qhSZIkRtFBG6mh
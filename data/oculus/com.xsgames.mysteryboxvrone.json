7NbMDleR3hIv3WPynIF910nQeAsGQjs-2M4XddtcOwFw&oe=6A1C5044"}, {"file_name": "5.png", "id": "467916352871409", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/39003282_467916356204742_1871921057092171900_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CJ_5dFS0kEQQ7kNvwHkDYzr&_nc_oc=Adp1RKZLgNt7X2D3Ll6NJ1Kv7ksx-EDqiZte5y3kFj0K-ZqFMc011HHHBD73r1wpPwM&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4V-zClDxSraUUtwpVmBE4DDA-AW-hCE3LgssjuC8i8Zg&oe=6A1C34E2"}, {"file_name": "3.png", "id": "1934382610375855", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38974473_1934382613709188_7156337812617042679_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dupyzk9Tg-wQ7kNvwHF6D7u&_nc_oc=AdpIfLh8bRIRyKeZj54wZnrcULNU6RFbt9fAQjIxn2rOkdE0-n6iW5n19hNnTPPlQHk&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af43hvrw1MZmNaiF_VO5v7Io_NiofKB29yt4vKOQjy3VDQ&oe=6A1C5733"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape.png", "id": "1524760081483769", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38974531_1524760084817102_6497712644828891067_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-1vldexJwcYQ7kNvwFhrd5l&_nc_oc=AdoO1EOCYXldSXIq0yIJwFSf8qmQhn7yc2c4JIEpiEjkxhW40qNmw7byzRH4ZtLId9c&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af68QkZmNN-2fQUlZvYsgeLmLHgVLWh7LWv-HQboOuZPEw&oe=6A1C562F"}, "display_name": "Mystery Box VR: Hidden Secrets", "keywords": [], "long_description": " AN IMMERSIVE VR PUZZLE EXPERIENCE\nInteract with objects, handles, buttons, and wheels on each side. Crack enigmas and collect hidden puzzle tiles on a random side of the boxes.\n\nYou won't be able to compare reality with fiction.\n\n# DISCOVER INVENTIONS\nOnce you unlock all 8 boxes of a Level Pack, you can compose a puzzle and discover a brief history of an invention.\n\nIt's not always easy to escape the room, so use all your IQ to crack the riddles. There's a logic behind all of them, even where it seems it's not!\n\n# IMMERSIVE SOUNDTRACK\nPlay the game with your headphones to get immersed in this amazing adventure.\n\n# HINTS\nGot stuck on some enigma? No worries, you can still get a helpful hint! You can also get in touch with me in case you really can't make it through a riddle, I'll be glad to help ;)\n\n# MULTILANGUAGE\nAvailable in English, French, Italian, German, Spanish, Russian, and Japanese.\n\nThe game language will change automatically based on the language settings of your device", "short_description": "A VR escape room game where you have to solve intriguing riddles to open boxes and discover nice stories about popular inventions!"}, {"images": {"nodes": [{"file_name": "$R36BSY5.png", "id": "3678762505771822", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/39031430_3678762509105155_2151975047074617165_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gnfq_UQS5vgQ7kNvwFH4nyu&_nc_oc=AdpIcwsDbVSI-UWzgjw0lFRBKcpnjoduYPdD2yleANlUEvt1cnwqfPqtV4BnLiFOi1s&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6CHWF6ggEs40wNJbI8Aytc-et22O3mJeWlUcaONu6XpA&oe=6A1C5225"}, {"file_name": "$R81V725.png", "id": "2720695481426567", "image_type": "APP_IMG_ICON", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/75262743_2720695484759900_604086922326600035_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Nwm9vbWAD4MQ7kNvwElBeQX&_nc_oc=AdoNi6I979QsvkPOzS_SZPN_soS8lZJSgBlruLXQl1U1nNCT0de6SXK_nh2sEJ8GzDM&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6Q7z331mjm_GFUD3paWLD_17Ud4DksqYodTxDV8vr8rA&oe=6A1C510D"}, {"file_name": "$RQ3SN6U.png", "id": "1552311425628973", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/38982519_1552311428962306_1218130395049083834_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nO9WkHKaXTwQ7kNvwEbB2Zj&_nc_oc=AdoM7xGL1jdbCCEcXuOdTd4C5vsWiVl_ZH4aJ0j1TgBWAdjjHufiTCXnKEMQDcvI2tc&_nc_zt=3&_nc_ht=
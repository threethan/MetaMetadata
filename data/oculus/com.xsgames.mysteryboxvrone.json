15uu6N-HnxcB8UBCtdD9WqLvz6jERdf3N4YSRsO_utPw&oe=69D27C44"}, {"file_name": "5.png", "id": "467916352871409", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39003282_467916356204742_1871921057092171900_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rGARsleA0KwQ7kNvwFOoVOG&_nc_oc=AdrIL40603tNlO6tdpgHLaSxPwckWa5v_J3vARawYNvQ08je0OtkVLmUOJXX0o0VQD4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0VR5lEU-ZbHRT1yrpHOPRnY_6kEyV5GNEOj7Rrt3GbVw&oe=69D260E2"}, {"file_name": "3.png", "id": "1934382610375855", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974473_1934382613709188_7156337812617042679_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K9A2Z-YlKqIQ7kNvwFch41d&_nc_oc=AdqI3BHRTgV4B-697tyy_WgNovQQOM26UI7WZvG5lo5MrtnrrFk7CaHd3vLBC8Pp_lE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1FVPRMe0Y2Rfu-evEak4D0c6tnCcIb8AD7Be9rpEJ4eA&oe=69D24AF3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape.png", "id": "1524760081483769", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974531_1524760084817102_6497712644828891067_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I4uzclrEZv4Q7kNvwGYRoRv&_nc_oc=AdoJg_HggHEEZZ7b3Pb50LlYam7_KGPzmCw-8LIOCduYfiI7z1Kthtj_KJGS6w2CPbg&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af19_C73J0kc6oMQXIwGFhOe5iY593Udg6q6-GGZj-WTaw&oe=69D249EF"}, "display_name": "Mystery Box VR: Hidden Secrets", "keywords": [], "long_description": " AN IMMERSIVE VR PUZZLE EXPERIENCE\nInteract with objects, handles, buttons, and wheels on each side. Crack enigmas and collect hidden puzzle tiles on a random side of the boxes.\n\nYou won't be able to compare reality with fiction.\n\n# DISCOVER INVENTIONS\nOnce you unlock all 8 boxes of a Level Pack, you can compose a puzzle and discover a brief history of an invention.\n\nIt's not always easy to escape the room, so use all your IQ to crack the riddles. There's a logic behind all of them, even where it seems it's not!\n\n# IMMERSIVE SOUNDTRACK\nPlay the game with your headphones to get immersed in this amazing adventure.\n\n# HINTS\nGot stuck on some enigma? No worries, you can still get a helpful hint! You can also get in touch with me in case you really can't make it through a riddle, I'll be glad to help ;)\n\n# MULTILANGUAGE\nAvailable in English, French, Italian, German, Spanish, Russian, and Japanese.\n\nThe game language will change automatically based on the language settings of your device", "short_description": "A VR escape room game where you have to solve intriguing riddles to open boxes and discover nice stories about popular inventions!"}, {"images": {"nodes": [{"file_name": "$R36BSY5.png", "id": "3678762505771822", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031430_3678762509105155_2151975047074617165_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A4cTAAm09AMQ7kNvwGk7yee&_nc_oc=AdqBoVFTxyKOA9zE51Lz-3swhoYCe5vUoSvsVwhhDuZDkgWnHVOkJydh-pSFXw7S9bc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0BD6NOb_OoD8BFhZXG7qB9hzF02WqU1BvElVjHl5u3tQ&oe=69D27E25"}, {"file_name": "$R81V725.png", "id": "2720695481426567", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75262743_2720695484759900_604086922326600035_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ni4Or0FI0qgQ7kNvwFf-K6k&_nc_oc=Adq0v3TO6A8MGxjBUE-C50--iDyfUODcCa02K6IjqIf2IKEE95FXKWuOqskd4J3ds1s&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af13Rcw8NoOzFO7RcWRTluPr6-mG0BlAAjwNFaFUb2puXw&oe=69D27D0D"}, {"file_name": "$RQ3SN6U.png", "id": "1552311425628973", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982519_1552311428962306_1218130395049083834_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QZJLSY_B1-kQ7kNvwF6ENGG&_nc_oc=AdqXdGTNEC5Ih0M3rSeG7zB0Zb7oI2IIoU90QPdl1_FZLpslG4yP0mME8tCC3wOXP-s&_nc_zt=3&_nc_ht=
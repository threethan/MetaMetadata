2jLhB1CvJRw2Qf66sQpeXuBqhTlCG4_rDbjXBF8ktVhw&oe=69EB88C4"}, {"file_name": "5.png", "id": "467916352871409", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39003282_467916356204742_1871921057092171900_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hDYDB3mACqgQ7kNvwFVcs_A&_nc_oc=AdooGIgbQWdOErCVkJSdMI952D7il86cbN3Jc7R7CkWDHotnR0r3_qVvG4cZrSFQpu4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2InY9m7a1hhnJ1tjEJpQchQw6phXKkjThv7cOtd8p_lw&oe=69EB6D62"}, {"file_name": "3.png", "id": "1934382610375855", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974473_1934382613709188_7156337812617042679_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dVkMoe2UiTwQ7kNvwGcadYs&_nc_oc=AdpfS4L5DRupC3AQxOGavj8Sxubrlv9b7KrWVTHGvoQHK0i8fSa5ZRwJHSTVrTfIpOM&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3a5UlhDwMPDdjkMm8adEGnmcxAnDgiLYfim2QOr4fkSA&oe=69EB5773"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape.png", "id": "1524760081483769", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974531_1524760084817102_6497712644828891067_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_c2ksM2-VSQQ7kNvwHYWE0F&_nc_oc=Ado_9s5foEK_eejSUQQcOV4V57cwIsD9K4wUmXYtG0uqyZt_Zlg751NDpGHIXvIC4sA&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0ovZzs8ewHPnJn9HWMOVpuSJ2Jop39XtGJ1BD-F55ESQ&oe=69EB566F"}, "display_name": "Mystery Box VR: Hidden Secrets", "keywords": [], "long_description": " AN IMMERSIVE VR PUZZLE EXPERIENCE\nInteract with objects, handles, buttons, and wheels on each side. Crack enigmas and collect hidden puzzle tiles on a random side of the boxes.\n\nYou won't be able to compare reality with fiction.\n\n# DISCOVER INVENTIONS\nOnce you unlock all 8 boxes of a Level Pack, you can compose a puzzle and discover a brief history of an invention.\n\nIt's not always easy to escape the room, so use all your IQ to crack the riddles. There's a logic behind all of them, even where it seems it's not!\n\n# IMMERSIVE SOUNDTRACK\nPlay the game with your headphones to get immersed in this amazing adventure.\n\n# HINTS\nGot stuck on some enigma? No worries, you can still get a helpful hint! You can also get in touch with me in case you really can't make it through a riddle, I'll be glad to help ;)\n\n# MULTILANGUAGE\nAvailable in English, French, Italian, German, Spanish, Russian, and Japanese.\n\nThe game language will change automatically based on the language settings of your device", "short_description": "A VR escape room game where you have to solve intriguing riddles to open boxes and discover nice stories about popular inventions!"}, {"images": {"nodes": [{"file_name": "$R36BSY5.png", "id": "3678762505771822", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031430_3678762509105155_2151975047074617165_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-3kU9V1Zn6kQ7kNvwHlVtez&_nc_oc=Ado8JvEb1hTp6kByRieZESGAptNqe1wWJxrFSAK5sjHxxhB0Sywauz3yc6PRRwAIj40&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3oGKh1BkGDTNV28_B1Q1gi_L3h6n7uBETOBL2yMpMkMw&oe=69EB8AA5"}, {"file_name": "$R81V725.png", "id": "2720695481426567", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75262743_2720695484759900_604086922326600035_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E-IvY6_8KpQQ7kNvwG6hAG-&_nc_oc=AdpELydaVPGKQt4sFFoyv91LaPpNG8UPUDOXK5W8lLXSKWaFt_UpsUwLy04imHCqaQc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0BZ6i_33BPAQN3WpbDrBDLsciy7e2qH8NA9wsVc26qRA&oe=69EB898D"}, {"file_name": "$RQ3SN6U.png", "id": "1552311425628973", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982519_1552311428962306_1218130395049083834_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Gf7T_v6OUGsQ7kNvwHdaY9E&_nc_oc=AdovfWaZhlNotLNRT8QpkxA2nhai6DfP9-9pKjBMVwutS8vF0f-AI9LgGkQrGPh89Zo&_nc_zt=3&_nc_ht=
NOm-mgbZRhBsKUj-_NINoWg5rbaT3N88S1wtO0QtkNDA&oe=6AD23F44"}, {"file_name": "5.png", "id": "467916352871409", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39003282_467916356204742_1871921057092171900_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kMxUxsilTDcQ7kNvwFcJail&_nc_oc=Adr5kPrglaHl6oBdyA1YjuKPw0DMd2jjWhOa0xL2ddHq_vFQO6omYzezi-4hqtkkF3c&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOugxns_X8amS5EGsUW-P3tI_k-Nm--T-3CRkUOMui7tw&oe=6AD223E2"}, {"file_name": "3.png", "id": "1934382610375855", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974473_1934382613709188_7156337812617042679_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3B4IWAK8k2oQ7kNvwHvQctl&_nc_oc=AdowlJ1b-whTZxyYY2UnGq-NZeA1Oxkatuj5qaLicZE36bFqJK3LYWE3MNk3HALVylI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOKW0J_a702kLQHKBoSCTO-FTM-Tspyt2h7CIbsAlOBXA&oe=6AD24633"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape.png", "id": "1524760081483769", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974531_1524760084817102_6497712644828891067_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5BnXZsJxVQEQ7kNvwERm51u&_nc_oc=Adq9N26CABOcIAAf6c-4kkN9KKdwwQZfYsOJ4v4FMDNVUr8qPJpejw5eQdQdRXBcBDs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN9TMqfMVbUYTYBNM9k-bdcNz_dvB-A34AqFmMilF8SLA&oe=6AD2452F"}, "display_name": "Mystery Box VR: Hidden Secrets", "keywords": [], "long_description": " AN IMMERSIVE VR PUZZLE EXPERIENCE\nInteract with objects, handles, buttons, and wheels on each side. Crack enigmas and collect hidden puzzle tiles on a random side of the boxes.\n\nYou won't be able to compare reality with fiction.\n\n# DISCOVER INVENTIONS\nOnce you unlock all 8 boxes of a Level Pack, you can compose a puzzle and discover a brief history of an invention.\n\nIt's not always easy to escape the room, so use all your IQ to crack the riddles. There's a logic behind all of them, even where it seems it's not!\n\n# IMMERSIVE SOUNDTRACK\nPlay the game with your headphones to get immersed in this amazing adventure.\n\n# HINTS\nGot stuck on some enigma? No worries, you can still get a helpful hint! You can also get in touch with me in case you really can't make it through a riddle, I'll be glad to help ;)\n\n# MULTILANGUAGE\nAvailable in English, French, Italian, German, Spanish, Russian, and Japanese.\n\nThe game language will change automatically based on the language settings of your device", "short_description": "A VR escape room game where you have to solve intriguing riddles to open boxes and discover nice stories about popular inventions!"}, {"images": {"nodes": [{"file_name": "$R36BSY5.png", "id": "3678762505771822", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031430_3678762509105155_2151975047074617165_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Dlpu9UE1778Q7kNvwFkfpQ0&_nc_oc=AdqBWt3u8sGz-iTezqAnxYwQWIGyhjFpLDdCGTLi-DEt6U4_3bn2LdHFNJaf9S4Bitk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMNq8zJgFDKJ_6BR1k2zBnWOAYguOoI2gDsTZ0cAoQ99w&oe=6AD24125"}, {"file_name": "$R81V725.png", "id": "2720695481426567", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75262743_2720695484759900_604086922326600035_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_yBDZjoD0xYQ7kNvwGLJTKp&_nc_oc=AdqpJYEQYw0Fd5gjS7XaoluMGnFKCSWfpkfpwR3hLisJGTEjPXVQn58VGFQwTl67JJ4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMvs-JqaDVBEQVteWK6LnWoZmN-c1v7r1X_LD5qHTzEqA&oe=6AD2400D"}, {"file_name": "$RQ3SN6U.png", "id": "1552311425628973", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982519_1552311428962306_1218130395049083834_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TqPYzj6IPcIQ7kNvwHJ9-aj&_nc_oc=AdpS9woDhgyEb2jCsccQNuXhNXI39xKkG4iXa723j15rtC1nPW29jf5aVZ2-3ip5rhA&_nc_zt=3&_nc_ht=
J0UepOUwtFznvON2Unm_UmUEjKp9GtBMTS9VmePCPNPg&oe=6AB53E44"}, {"file_name": "5.png", "id": "467916352871409", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39003282_467916356204742_1871921057092171900_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w3CGWsvEl5oQ7kNvwEH6tot&_nc_oc=Adqob1JpFWPp-8cnzRSCdz4IpMevH9fGB0CX7xhshkb2TAi7AUmL5xTQ4KWW0lte5Pg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJJ9tP326iH_0wJ53koYcCrkb_Uc2VRHCkWAwHVyTgo7A&oe=6AB522E2"}, {"file_name": "3.png", "id": "1934382610375855", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974473_1934382613709188_7156337812617042679_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-jxC_iYfMJ4Q7kNvwFEHkYq&_nc_oc=Adp69pX7bFdWy_8mrnwjkCZD_YKRu-MLGIi7SKT42g9bNPe42JNP7HOtAPkU9IEZ4NA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJVwrsaSDj9OHCG2ouDCmFscfN92AohER3RiJliMkVejw&oe=6AB54533"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape.png", "id": "1524760081483769", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974531_1524760084817102_6497712644828891067_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SV5NYsiB1cwQ7kNvwHD0aeA&_nc_oc=Adq8aekw8cXMOJQL-PoNLAAXuGoQERIXwYsXSbT9gOXasdLzr9iS2WITbCz4iAqyqCE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLEDrjt1hyu9za4Sb9iTXf37p3NFs18aj8ajSHvhLvXMA&oe=6AB5442F"}, "display_name": "Mystery Box VR: Hidden Secrets", "keywords": [], "long_description": " AN IMMERSIVE VR PUZZLE EXPERIENCE\nInteract with objects, handles, buttons, and wheels on each side. Crack enigmas and collect hidden puzzle tiles on a random side of the boxes.\n\nYou won't be able to compare reality with fiction.\n\n# DISCOVER INVENTIONS\nOnce you unlock all 8 boxes of a Level Pack, you can compose a puzzle and discover a brief history of an invention.\n\nIt's not always easy to escape the room, so use all your IQ to crack the riddles. There's a logic behind all of them, even where it seems it's not!\n\n# IMMERSIVE SOUNDTRACK\nPlay the game with your headphones to get immersed in this amazing adventure.\n\n# HINTS\nGot stuck on some enigma? No worries, you can still get a helpful hint! You can also get in touch with me in case you really can't make it through a riddle, I'll be glad to help ;)\n\n# MULTILANGUAGE\nAvailable in English, French, Italian, German, Spanish, Russian, and Japanese.\n\nThe game language will change automatically based on the language settings of your device", "short_description": "A VR escape room game where you have to solve intriguing riddles to open boxes and discover nice stories about popular inventions!"}, {"images": {"nodes": [{"file_name": "$R36BSY5.png", "id": "3678762505771822", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031430_3678762509105155_2151975047074617165_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f4Y4wZIEydMQ7kNvwFG7n59&_nc_oc=AdoogTxLU0LZOsPeO0PPb17oZSIkrmAXISytvMQ8ZO9veS-XKZdMFtQ4ASqQbXRx2Us&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI4xyy3HZ7qXoDJPYWSBt_ET6qAhktYv-qmli6gi-HQ9A&oe=6AB54025"}, {"file_name": "$R81V725.png", "id": "2720695481426567", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75262743_2720695484759900_604086922326600035_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mID2rYPM-ycQ7kNvwHyx6RI&_nc_oc=AdqT1SGUJwfy-d11hL4S8i9uEwFqxPh1CrVGaY5EFMroFRyiQxMMuGtKrY7KHU9TfN8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQId15T7ZJqseAcetPfgPtnD3APlxJxfg3g1laX6HuHkqA&oe=6AB53F0D"}, {"file_name": "$RQ3SN6U.png", "id": "1552311425628973", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982519_1552311428962306_1218130395049083834_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fTGJXBIiuB0Q7kNvwFq8P_g&_nc_oc=AdqhOjlgLcX7MxG5Z_7KA4Q6on7k7G_FCLFJUmmEXkLvb_mRtYbxmImVVNAL4I4Uw58&_nc_zt=3&_nc_ht=
8gz3v6I_yR8jBous7DRO1ZdxYa3NRdmm2Dx5VzYRhJqQ&oe=6A282DC4"}, {"file_name": "5.png", "id": "467916352871409", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39003282_467916356204742_1871921057092171900_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ErOE7J4cY9gQ7kNvwEXhWeA&_nc_oc=AdpfwzJnlGVC73QgB99NHHVcYVbucsBUotxURgJKL_kvwuWQKoSGNFc96EzRS18DZ78&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8ykrTK-5aMpRLWZwdMrb1OlLgD9Nryqts_4wKKkQXVfQ&oe=6A281262"}, {"file_name": "3.png", "id": "1934382610375855", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974473_1934382613709188_7156337812617042679_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y2iT7YugXmUQ7kNvwFiXRGX&_nc_oc=AdrOlZYofPOjqFlMs_Ud5Psx-jYfExKkapO1A9XyoXJNIScHGINL_lLcZhKVXO7kZgI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-0cRDzLomMVg9fuqfGe_uRCoCeuGJN1yMgAF6NGyi03w&oe=6A2834B3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape.png", "id": "1524760081483769", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974531_1524760084817102_6497712644828891067_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_TKuk91nOKsQ7kNvwG4cXuj&_nc_oc=AdqtOYnHKzjQQ-4qOMMrZ5uT4nwWKECC8qh87Jf2oAV7LBcoshje9mfgm5GvZeKJp3s&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-KHUcrTZdiesaY8A1bt-ievIPFPUj470c1obMZRQlglQ&oe=6A2833AF"}, "display_name": "Mystery Box VR: Hidden Secrets", "keywords": [], "long_description": " AN IMMERSIVE VR PUZZLE EXPERIENCE\nInteract with objects, handles, buttons, and wheels on each side. Crack enigmas and collect hidden puzzle tiles on a random side of the boxes.\n\nYou won't be able to compare reality with fiction.\n\n# DISCOVER INVENTIONS\nOnce you unlock all 8 boxes of a Level Pack, you can compose a puzzle and discover a brief history of an invention.\n\nIt's not always easy to escape the room, so use all your IQ to crack the riddles. There's a logic behind all of them, even where it seems it's not!\n\n# IMMERSIVE SOUNDTRACK\nPlay the game with your headphones to get immersed in this amazing adventure.\n\n# HINTS\nGot stuck on some enigma? No worries, you can still get a helpful hint! You can also get in touch with me in case you really can't make it through a riddle, I'll be glad to help ;)\n\n# MULTILANGUAGE\nAvailable in English, French, Italian, German, Spanish, Russian, and Japanese.\n\nThe game language will change automatically based on the language settings of your device", "short_description": "A VR escape room game where you have to solve intriguing riddles to open boxes and discover nice stories about popular inventions!"}, {"images": {"nodes": [{"file_name": "$R36BSY5.png", "id": "3678762505771822", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031430_3678762509105155_2151975047074617165_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CAORMJyHZiMQ7kNvwF0s7yu&_nc_oc=AdoROAjC-t36fExLCavRpUL9f9CTDwjmhQr4Y-ceYbnxt9qLKmL3fw01UFn0Ir9RgJM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9-tfHfDB0DM_12CWUEde0Hn2OTVHi6tNoxcrsQc3Khag&oe=6A282FA5"}, {"file_name": "$R81V725.png", "id": "2720695481426567", "image_type": "APP_IMG_ICON", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75262743_2720695484759900_604086922326600035_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=df3r2R4NcNoQ7kNvwGN3sE4&_nc_oc=AdqJZMCsJEdVzJrohRrsAQ9eFzxGhsrZs69OnElv3Z8WrHkB-orTtR1iordCOe5zV0o&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-rPNwkyzK9oTclxGtPqWy54haG6IPfeks0qDIIpflbMA&oe=6A282E8D"}, {"file_name": "$RQ3SN6U.png", "id": "1552311425628973", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982519_1552311428962306_1218130395049083834_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QEIK9iC_SgoQ7kNvwF4SFZ2&_nc_oc=AdpZUCWOP2mzKFTQQuh9JOqsR3sltybSWAimz3h3Xs2_p2tQd7cieyX1i6DSfdmMzcU&_nc_zt=3&_nc_ht=
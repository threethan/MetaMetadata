nc_ss=7f20f&oh=00_AQKgNB4WAxdN69tdPrYLtrezPI1kq0ibNv2HPH6xa35LRQ&oe=6AA41AC4"}, {"file_name": "5.png", "id": "467916352871409", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/39003282_467916356204742_1871921057092171900_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NtQacdhNjXAQ7kNvwEkWpcv&_nc_oc=AdoWA2usIsivOUAKZyxOUu4M66OMnaOpub5Av0ucVBH57s78AwZNUbiHVFv1sBkn3Tg&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKMRG98sp5cZ5s9DTLh7PaAEmc22w5x8QCYNgm3u_4OJQ&oe=6AA3FF62"}, {"file_name": "3.png", "id": "1934382610375855", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/38974473_1934382613709188_7156337812617042679_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H8DJ7V_k284Q7kNvwFcbcdT&_nc_oc=AdoO6xBiQnzt82aazIzYXg_NSXSwJZ42spfXQ1UDFH0vP3LVl03zE67isJIYQsbzap8&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJNA9in4kl3s_L0ZSALUEgapDcrxoOUwriD0jswYp8nIg&oe=6AA421B3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape.png", "id": "1524760081483769", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/38974531_1524760084817102_6497712644828891067_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DiMbG4V7FhMQ7kNvwFbomjg&_nc_oc=Adpt2-AAA7837usi9KFOx0AOE9h0bsOt3lS9qErTH3QmHBKdxcalU9LQdFGst-iKDhU&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKLR5YniSL2vV8LRgz7bsOOYJ7uzvpQv9twFbdJkacajg&oe=6AA420AF"}, "display_name": "Mystery Box VR: Hidden Secrets", "keywords": [], "long_description": " AN IMMERSIVE VR PUZZLE EXPERIENCE\nInteract with objects, handles, buttons, and wheels on each side. Crack enigmas and collect hidden puzzle tiles on a random side of the boxes.\n\nYou won't be able to compare reality with fiction.\n\n# DISCOVER INVENTIONS\nOnce you unlock all 8 boxes of a Level Pack, you can compose a puzzle and discover a brief history of an invention.\n\nIt's not always easy to escape the room, so use all your IQ to crack the riddles. There's a logic behind all of them, even where it seems it's not!\n\n# IMMERSIVE SOUNDTRACK\nPlay the game with your headphones to get immersed in this amazing adventure.\n\n# HINTS\nGot stuck on some enigma? No worries, you can still get a helpful hint! You can also get in touch with me in case you really can't make it through a riddle, I'll be glad to help ;)\n\n# MULTILANGUAGE\nAvailable in English, French, Italian, German, Spanish, Russian, and Japanese.\n\nThe game language will change automatically based on the language settings of your device", "short_description": "A VR escape room game where you have to solve intriguing riddles to open boxes and discover nice stories about popular inventions!"}, {"images": {"nodes": [{"file_name": "$R36BSY5.png", "id": "3678762505771822", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/39031430_3678762509105155_2151975047074617165_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a69X5QerOJYQ7kNvwEgd-nW&_nc_oc=Ado_L2sjZ_ZXnYKBdvplxjYOeNCzwaDsZQ-q9v0pxCbt79EpRZ-x2gafHz-F4UE5xzs&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLVzDMZQV6CpjAu0cbsY41Rwm0T5zNJnmYmvEX3r6X_Rw&oe=6AA41CA5"}, {"file_name": "$R81V725.png", "id": "2720695481426567", "image_type": "APP_IMG_ICON", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/75262743_2720695484759900_604086922326600035_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-FQP_65cPM0Q7kNvwHUySiL&_nc_oc=AdqZDvfx-ge3StkOro6q7C6g2FUQmRpppxYi-SDhwthGamejB2iWGJfVcRpfyYsjNtA&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJIGGtGmGU5XxdhHKM0nD1gWiPRiLqEwIY32vzYhI9Z8w&oe=6AA41B8D"}, {"file_name": "$RQ3SN6U.png", "id": "1552311425628973", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/38982519_1552311428962306_1218130395049083834_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wHcABVb4LiYQ7kNvwH5CsUD&_nc_oc=Adp5NGcdP9LhILw8_bvEiZSEkpcZcTuEK5yfBlJrFE7d50XNh-SZdkuScwB3
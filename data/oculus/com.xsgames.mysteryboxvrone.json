JV6yq7AOr82dPHo73FZQEiVy5QNK2vRaA1vxw3fq1qJw&oe=6AB68FC4"}, {"file_name": "5.png", "id": "467916352871409", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39003282_467916356204742_1871921057092171900_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UBWBABwaq3QQ7kNvwHQaMTk&_nc_oc=Adr-V_y5nKAXYH1b-_F4X62C8Ek62_Lx10Vr3dmglgQFermBQO11VdAs1XK6O50CTLY&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJI-iBlbPVWCx3J-usgLrXKWFMjrcgnzpoI5ySo_rjJIQ&oe=6AB67462"}, {"file_name": "3.png", "id": "1934382610375855", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38974473_1934382613709188_7156337812617042679_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-jxC_iYfMJ4Q7kNvwEQR5bX&_nc_oc=AdpwRTbgzAL8sLbmFf2zdT3S-GjTygvdlQWmBoB61coDwko0jgkBTXH37WK-ZBEpv3Q&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIhn5LIgYeFyrIrl7qWkp8P1CfkOZvmQUY3TNyw8dj11Q&oe=6AB696B3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape.png", "id": "1524760081483769", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38974531_1524760084817102_6497712644828891067_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7Jof5wr8ZNsQ7kNvwE5-qd7&_nc_oc=AdpsTM7HSQeJXQELvWQy9Ckk4xbgcGEzsNlLyKfKClHBJNX1-rueXxJxka2cHODPt6Q&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJANfeIF1VL7DBsvnUq31pJpfiFPmtKhAnwgk2HetoNSg&oe=6AB695AF"}, "display_name": "Mystery Box VR: Hidden Secrets", "keywords": [], "long_description": " AN IMMERSIVE VR PUZZLE EXPERIENCE\nInteract with objects, handles, buttons, and wheels on each side. Crack enigmas and collect hidden puzzle tiles on a random side of the boxes.\n\nYou won't be able to compare reality with fiction.\n\n# DISCOVER INVENTIONS\nOnce you unlock all 8 boxes of a Level Pack, you can compose a puzzle and discover a brief history of an invention.\n\nIt's not always easy to escape the room, so use all your IQ to crack the riddles. There's a logic behind all of them, even where it seems it's not!\n\n# IMMERSIVE SOUNDTRACK\nPlay the game with your headphones to get immersed in this amazing adventure.\n\n# HINTS\nGot stuck on some enigma? No worries, you can still get a helpful hint! You can also get in touch with me in case you really can't make it through a riddle, I'll be glad to help ;)\n\n# MULTILANGUAGE\nAvailable in English, French, Italian, German, Spanish, Russian, and Japanese.\n\nThe game language will change automatically based on the language settings of your device", "short_description": "A VR escape room game where you have to solve intriguing riddles to open boxes and discover nice stories about popular inventions!"}, {"images": {"nodes": [{"file_name": "$R36BSY5.png", "id": "3678762505771822", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39031430_3678762509105155_2151975047074617165_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f4Y4wZIEydMQ7kNvwFQIyyj&_nc_oc=Adqgf32e6aUZ_SJyBZEN8yPgw4uJdAxq5O0WUxHbhutu3UmCkwRnztITqxfhRuUgWp8&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI1jawfHG5tbxlnH38LO91-zTgXGSZzLGPV8W2Ned8oTQ&oe=6AB691A5"}, {"file_name": "$R81V725.png", "id": "2720695481426567", "image_type": "APP_IMG_ICON", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75262743_2720695484759900_604086922326600035_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mID2rYPM-ycQ7kNvwFyCY6S&_nc_oc=AdoJ8YiOsEr7LptbgqbLel0FMJyTM8elVo4IITfQvTN3ytK9IsYdFPLyh056AnvUEXk&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKkOSvqpMIVrqQaS2aFIMFN8MKDGzKYd4anCUddMEqAow&oe=6AB6908D"}, {"file_name": "$RQ3SN6U.png", "id": "1552311425628973", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982519_1552311428962306_1218130395049083834_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fTGJXBIiuB0Q7kNvwHZHXq-&_nc_oc=AdqmEMv4_BWT8_QElV_Uo2EFlBYfyi8Y0Xu6pvmIZDbHeGEusT8xYYP8es69Tr5jpFk&_nc_zt=3&_nc_ht=
934382610375855", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974473_1934382613709188_7156337812617042679_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KSxdCWyez7gQ7kNvwEjQ0sS&_nc_oc=AdoQkuMS3k6mvoZxU2RHkB2vkFEfdpwxcopApGZf1URtWoTF9JD8xW_kDd1rGjERuS0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTaRxv1moATxaFEPFe-RwjcQ-bQoD8LcNhWrgIHJXjCQA&oe=6B0D99B3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape_coverart.png", "id": "897861905346420", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982672_897861908679753_3996777238831042692_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fRWQDnqJTM8Q7kNvwEfRoOp&_nc_oc=Adrrt5GBxzj2mbPEZqtaTT0e5YelcMJex743Ii0xwVKfSaHggkDPr7uXiI4vP_rDSl8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQ44V6N8Rp0PPEG7NX_5L__gJo2D_SzxziUFOjwa3F1QQ&oe=6B0D9C2B"}, "display_name": "Mystery Box VR: Hidden Secrets Escape", "keywords": ["puzzle", "escape", "room", "trivia", "brainteaser"], "long_description": "# AN IMMERSIVE VR PUZZLE EXPERIENCE\nInteract with objects, handles, buttons, and wheels on each side. Crack enigmas and collect hidden puzzle tiles on a random side of the boxes.\n\nYou won't be able to compare reality with fiction.\n\n# DISCOVER INVENTIONS\nOnce you unlock all 8 boxes of a Level Pack, you can compose a puzzle and discover a brief history of an invention.\n\nIt's not always easy to escape the room, so use all your IQ to crack the riddles. There's a logic behind all of them, even where it seems it's not!\n\n# IMMERSIVE SOUNDTRACK\nPlay the game with your headphones to get immersed in this amazing adventure.\n\n# HINTS\nGot stuck on some enigma? No worries, you can still get a helpful hint! You can also get in touch with me in case you really can't make it through a riddle, I'll be glad to help ;)\n\n# MULTILANGUAGE\nAvailable in English, French, Italian, German, Spanish, Russian, and Japanese.\n\nThe game language will change automatically based on the language settings of your device", "short_description": "Crack awesome puzzles around many boxes, and discover the history of the world's most popular inventions!"}, {"images": {"nodes": [{"file_name": "logoTransparent.png", "id": "3812261432362188", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974562_3812261435695521_5176404439574971225_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Uldfhok_E2MQ7kNvwFi0Hnb&_nc_oc=AdqElwKbympdLm4J4F11cUYheGTiCxGGO2pKFfKL2X4ArPE1QVskLvGNsRfeeF1OiIk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQxjYTqkcM5z9DDwX8JDS7FENc234TMuzuRFSspoDwNRA&oe=6B0DC216"}, {"file_name": "portrait_coverart.png", "id": "1953342038506987", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982581_1953342045173653_4906879878373922307_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Dr99sHP95ccQ7kNvwEZkqFr&_nc_oc=Adp1TJ4e6gQ3-8-j5BiFAPblUfTOq-eqZL1tKZ7q2MJG9oX0cEsd97T9Mjm1YtrGcFE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSZ9UFxWSmKOszer12ItdAWQwob_yUlcj7tOW-1YqROYw&oe=6B0DAAFD"}, {"file_name": "landscape_coverart.png", "id": "1300403051139202", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75462955_1300403057805868_2288822001409671177_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w5EXsJPZexIQ7kNvwGOTrcq&_nc_oc=AdpSTSVZp7aPjRT7jUIyXm7-JD7_fHuJHCKGfmCYe3HHHsMPEfpk9Zqp-qvhMm0SoQI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRhpCjpv9_tFbo0C0QoY7Gshv83BCJnVmFnwMXMfja7dw&oe=6B0D9BA0"}, {"file_name": "square_coverart.png", "id": "914408640187392", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39036626_914408643520725_6339598287132
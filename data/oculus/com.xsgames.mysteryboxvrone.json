16IC4YW077Nl_8irtDxn0Tco9DMwM-ieiN97NCecWLRA&oe=69F76644"}, {"file_name": "5.png", "id": "467916352871409", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39003282_467916356204742_1871921057092171900_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PvT-cwi-sIYQ7kNvwFmwM7k&_nc_oc=Ado7Q2O1pINF6NgoNY3pm0TZ4su5KSW2UAYdEc1yQmd-LEcCmlWZK6jNOAVW_PmygeM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3abnY0ZBF4_zG9BfsvXiOvl8tCsWzsj5WeGmAFmPvdQw&oe=69F74AE2"}, {"file_name": "3.png", "id": "1934382610375855", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974473_1934382613709188_7156337812617042679_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4eVgmOC7lC8Q7kNvwHD07ib&_nc_oc=AdpjmCJbA_2YCHd-ZMom9OGq2i2ioDxoKs3wjdvtS9Hw7uoXguNsfTGv03YSiymJorc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1babqPbNQGtDUvZdmVLuEZLpnxKvnfYmsiL6C6IgthfA&oe=69F76D33"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape.png", "id": "1524760081483769", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974531_1524760084817102_6497712644828891067_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UP51b_7NTokQ7kNvwGxpHO9&_nc_oc=Adrg-naAwkSHCrHsefKqw5BcBu7ZMeGuUEichuINO5M3lNYg5hnNhdb6vUjb_H-_ZMY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1nijmKYC9UweqmbuV6YCCpqccI5fDn-fWPo9kThRxtuw&oe=69F76C2F"}, "display_name": "Mystery Box VR: Hidden Secrets", "keywords": [], "long_description": " AN IMMERSIVE VR PUZZLE EXPERIENCE\nInteract with objects, handles, buttons, and wheels on each side. Crack enigmas and collect hidden puzzle tiles on a random side of the boxes.\n\nYou won't be able to compare reality with fiction.\n\n# DISCOVER INVENTIONS\nOnce you unlock all 8 boxes of a Level Pack, you can compose a puzzle and discover a brief history of an invention.\n\nIt's not always easy to escape the room, so use all your IQ to crack the riddles. There's a logic behind all of them, even where it seems it's not!\n\n# IMMERSIVE SOUNDTRACK\nPlay the game with your headphones to get immersed in this amazing adventure.\n\n# HINTS\nGot stuck on some enigma? No worries, you can still get a helpful hint! You can also get in touch with me in case you really can't make it through a riddle, I'll be glad to help ;)\n\n# MULTILANGUAGE\nAvailable in English, French, Italian, German, Spanish, Russian, and Japanese.\n\nThe game language will change automatically based on the language settings of your device", "short_description": "A VR escape room game where you have to solve intriguing riddles to open boxes and discover nice stories about popular inventions!"}, {"images": {"nodes": [{"file_name": "$R36BSY5.png", "id": "3678762505771822", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031430_3678762509105155_2151975047074617165_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FEhb-MZ-5bwQ7kNvwHrK3yJ&_nc_oc=AdrUesYNIUmBBOAL65KB8ZBGEEuS26dE2AUqcVaEl9D0c_S7eQLkXE9m4bGXWpHNvDI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1VlskA96xuUKEhHl6zd_cblUsWeT8FcVNNrPIxA0bDrA&oe=69F76825"}, {"file_name": "$R81V725.png", "id": "2720695481426567", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75262743_2720695484759900_604086922326600035_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5BMvBEE7nxYQ7kNvwHdhbhH&_nc_oc=AdovOHktBavIhnybUb8ugBbUl_5E-37o_O87KPOiplCL3AzqhKEnkIc2to3BVuIzgAE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1Nm236uSSoQe-x_iBUqYMc8acnPO0YCT18Htq0zhRIiA&oe=69F7670D"}, {"file_name": "$RQ3SN6U.png", "id": "1552311425628973", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982519_1552311428962306_1218130395049083834_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DAkLOXd4VcYQ7kNvwHhmz09&_nc_oc=AdocVjFrZNHv8Djs5DGYFUdKCF4wUlXrg7DJRqtnyRoQIYMC-Rs7uT477AWAKU0oSzU&_nc_zt=3&_nc_ht=
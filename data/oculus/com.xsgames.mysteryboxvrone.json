L-ow&oe=69A2EAE2"}, {"file_name": "3.png", "id": "1934382610375855", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974473_1934382613709188_7156337812617042679_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QcE4vAXF8rIQ7kNvwG18A1D&_nc_oc=AdlcoF4u1dRPRJOV0W80gC54L8X_fygudvOhrpxiXi4IyEMZg4MtZ_yJSvYUnexDBNw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Afuq19Je9YPS--S-1eD61oUEOh9-lYlbZNKL2IWUMVfs1A&oe=69A2D4F3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape.png", "id": "1524760081483769", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974531_1524760084817102_6497712644828891067_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1_uWU0R5MAEQ7kNvwFwUYLP&_nc_oc=AdkmZB7YD-kAX9oaBFziKYawBxkYMdNbZ59ftOvvw_ejcQwiU2XTwfkM4xFEXoFGv98&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfudOYxhxIq8HJEThpjAi_d9aNa3pQDLBrs43Fg5FevQ3Q&oe=69A2D3EF"}, "display_name": "Mystery Box VR: Hidden Secrets", "keywords": [], "long_description": " AN IMMERSIVE VR PUZZLE EXPERIENCE\nInteract with objects, handles, buttons, and wheels on each side. Crack enigmas and collect hidden puzzle tiles on a random side of the boxes.\n\nYou won't be able to compare reality with fiction.\n\n# DISCOVER INVENTIONS\nOnce you unlock all 8 boxes of a Level Pack, you can compose a puzzle and discover a brief history of an invention.\n\nIt's not always easy to escape the room, so use all your IQ to crack the riddles. There's a logic behind all of them, even where it seems it's not!\n\n# IMMERSIVE SOUNDTRACK\nPlay the game with your headphones to get immersed in this amazing adventure.\n\n# HINTS\nGot stuck on some enigma? No worries, you can still get a helpful hint! You can also get in touch with me in case you really can't make it through a riddle, I'll be glad to help ;)\n\n# MULTILANGUAGE\nAvailable in English, French, Italian, German, Spanish, Russian, and Japanese.\n\nThe game language will change automatically based on the language settings of your device", "short_description": "A VR escape room game where you have to solve intriguing riddles to open boxes and discover nice stories about popular inventions!"}, {"images": {"nodes": [{"file_name": "$R36BSY5.png", "id": "3678762505771822", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031430_3678762509105155_2151975047074617165_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mKl5I_PCVRUQ7kNvwHdUE4T&_nc_oc=AdkhaLqpUuUzmwOq3UKD8bQ7p844gI09qCKB9DxnGRTDD4oAda2c7HUV-dTMLTgc5Dw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AftTvUeQkZTShcIAfy6JyH4IjvBvQ4foE8sgiHKhSGiYBg&oe=69A2CFE5"}, {"file_name": "$R81V725.png", "id": "2720695481426567", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75262743_2720695484759900_604086922326600035_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qPgpUoXR6-gQ7kNvwGMOivm&_nc_oc=AdlkJ41v6QsSMbHpIR3_mEmnb6r6qPKa0mjFNLvFgx8Xy29nzfJkwDYWWNdXqJMU7e4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfuStD5udOXJ11NI_l5A2CXujC_jVaDECjXbz7JT1mTu3A&oe=69A2CECD"}, {"file_name": "$RQ3SN6U.png", "id": "1552311425628973", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982519_1552311428962306_1218130395049083834_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RqvImO5dZ5AQ7kNvwHW6oiJ&_nc_oc=AdkIyDi2N215AoRpovDBbEDNGYVKLd9B05NKtGLzSx0szD0oQfKMnOoNe06jxKpKleY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfviYD6g9maW3Hw_qKx7xPA2xuChMMiKHzCNaqXhaW8YlQ&oe=69A2DA29"}, {"file_name": "38982645_1000853181732648_5055517427829171192_n.png", "id": "1043990680394008", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031625_1043990683727341_3557431131423146005_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r_fpF86hMDoQ7kNvwE1EBPu&_nc_oc=AdkkaxGIiyACBqKOvNXFF-zk73lrPgIn00X6c9iBq-5NKQiuu55eI6Z5Mq9L1mGVniY&_nc_zt=3&_nc_ht=scontent-iad3-1
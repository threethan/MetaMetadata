BOg3cOC_pPnsOtIR0ayVlUNAwIo88AautPBW3zOvfQ0A&oe=6A53AF44"}, {"file_name": "5.png", "id": "467916352871409", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39003282_467916356204742_1871921057092171900_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LFCNeKMBjV8Q7kNvwF20nft&_nc_oc=AdrnkMbyGL5j_cEaDWKeLxhjk8EUBBRs4iCKxF4-HSCnJXCqsvMGi58aHjfcDU7gdlA&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAH4NaAtr13K_Wt_r4SEnLO9tGlBG7D-kj2zHD8xE-P9A&oe=6A5393E2"}, {"file_name": "3.png", "id": "1934382610375855", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38974473_1934382613709188_7156337812617042679_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hoYXp5ZJ-W4Q7kNvwEDZCNf&_nc_oc=AdrysX5Bz-HDmPccz_qdzhXdRyjBve5dJEwLkxDuVqluckQcKzET4rC84rRXM3i6B0o&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA7leVaUNf78c6IcIqDI096Fl8CM7fpFs9RjxLIjJYpiw&oe=6A537DF3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape.png", "id": "1524760081483769", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38974531_1524760084817102_6497712644828891067_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U4nHU9UqWhsQ7kNvwF5-hkt&_nc_oc=AdpxVSsUX0ZR44AY_0zbu2edD45j5CS1Mfbea6IeGSKC8EaCpPEN2JkH2V9ucCSHlMI&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCbo2b59LnkWVaYNXJY-_uvx8h5Rv8PY8Srhh6c0kA-7g&oe=6A537CEF"}, "display_name": "Mystery Box VR: Hidden Secrets", "keywords": [], "long_description": " AN IMMERSIVE VR PUZZLE EXPERIENCE\nInteract with objects, handles, buttons, and wheels on each side. Crack enigmas and collect hidden puzzle tiles on a random side of the boxes.\n\nYou won't be able to compare reality with fiction.\n\n# DISCOVER INVENTIONS\nOnce you unlock all 8 boxes of a Level Pack, you can compose a puzzle and discover a brief history of an invention.\n\nIt's not always easy to escape the room, so use all your IQ to crack the riddles. There's a logic behind all of them, even where it seems it's not!\n\n# IMMERSIVE SOUNDTRACK\nPlay the game with your headphones to get immersed in this amazing adventure.\n\n# HINTS\nGot stuck on some enigma? No worries, you can still get a helpful hint! You can also get in touch with me in case you really can't make it through a riddle, I'll be glad to help ;)\n\n# MULTILANGUAGE\nAvailable in English, French, Italian, German, Spanish, Russian, and Japanese.\n\nThe game language will change automatically based on the language settings of your device", "short_description": "A VR escape room game where you have to solve intriguing riddles to open boxes and discover nice stories about popular inventions!"}, {"images": {"nodes": [{"file_name": "$R36BSY5.png", "id": "3678762505771822", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39031430_3678762509105155_2151975047074617165_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LQYj8U7J2C4Q7kNvwEkpin-&_nc_oc=Adojaykx9fNOfy8Jpyo5B07tzF1i9BBavh5TkjT83GEJN_n1W1djc9jhw8Myj_KKs90&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCbiXnPWKq5jlH1vi6dgCTAuwNA4Dk3bvocbSfSWKHjLw&oe=6A53B125"}, {"file_name": "$R81V725.png", "id": "2720695481426567", "image_type": "APP_IMG_ICON", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75262743_2720695484759900_604086922326600035_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dvrixJtRIhMQ7kNvwGqjnFA&_nc_oc=AdqGMVJoBVmvJCjCdAbm5RmPn4LMZZ1sGcZ8Z-Ka5675IuvDwKuk3NqJzoEMEhBLEj4&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCtqRs3M3E6AiX6rMB8OR16l07uDha2YSlkIgTBvrWGEQ&oe=6A53B00D"}, {"file_name": "$RQ3SN6U.png", "id": "1552311425628973", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982519_1552311428962306_1218130395049083834_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O_sHojBB8OkQ7kNvwGdXHfO&_nc_oc=AdrA9z-SYPL6yZTQg7DvOF5bbAXZ3xQlqT3Hyv3EWbKSTsLV5zyYRPVSjuqQC9m3G80&_nc_zt=3&_nc_ht=
oculuscdn.com/v/t64.5771-25/39003282_467916356204742_1871921057092171900_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vugACsjBkwUQ7kNvwFvlWMw&_nc_oc=Adlejb4Y_mPPWO3Uj5tojgZ9K2JSTDgVL1k0L4mV4T_jJ5M02vRHdDpZoA-AqzDOB9k&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfwZIvzn3dmp-PWdB_MK0un-GXUio3TS-eZVV5mLoE6q3g&oe=69B95462"}, {"file_name": "3.png", "id": "1934382610375855", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974473_1934382613709188_7156337812617042679_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dpnxhLi8FlUQ7kNvwH9bwDS&_nc_oc=AdmrWBs2Wo6gODOe0VKt9i5XUgRGsKNuAlG6TQoKidsstLwN8V4ImUb7OiYxecBjf90&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfxOqn0sAjFrEsVFSws_TsxDMmK7ji7czovcsZClw2jOOg&oe=69B93E73"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape.png", "id": "1524760081483769", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974531_1524760084817102_6497712644828891067_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JD8agOtHBsgQ7kNvwG3ttg9&_nc_oc=AdkGwYXGEATGVXcMYRyf94Xz_VC6Bw48hK4bPwXdScnqfimhkJcEhc6XfsORkhK6s14&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfyOr66BhKmoWWciv7IcD9WorA6Jte-8r1ad_2AoPMuO0g&oe=69B93D6F"}, "display_name": "Mystery Box VR: Hidden Secrets", "keywords": [], "long_description": " AN IMMERSIVE VR PUZZLE EXPERIENCE\nInteract with objects, handles, buttons, and wheels on each side. Crack enigmas and collect hidden puzzle tiles on a random side of the boxes.\n\nYou won't be able to compare reality with fiction.\n\n# DISCOVER INVENTIONS\nOnce you unlock all 8 boxes of a Level Pack, you can compose a puzzle and discover a brief history of an invention.\n\nIt's not always easy to escape the room, so use all your IQ to crack the riddles. There's a logic behind all of them, even where it seems it's not!\n\n# IMMERSIVE SOUNDTRACK\nPlay the game with your headphones to get immersed in this amazing adventure.\n\n# HINTS\nGot stuck on some enigma? No worries, you can still get a helpful hint! You can also get in touch with me in case you really can't make it through a riddle, I'll be glad to help ;)\n\n# MULTILANGUAGE\nAvailable in English, French, Italian, German, Spanish, Russian, and Japanese.\n\nThe game language will change automatically based on the language settings of your device", "short_description": "A VR escape room game where you have to solve intriguing riddles to open boxes and discover nice stories about popular inventions!"}, {"images": {"nodes": [{"file_name": "$R36BSY5.png", "id": "3678762505771822", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031430_3678762509105155_2151975047074617165_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=znCUPmUK3ZoQ7kNvwHStkOi&_nc_oc=Adk-EHmg0tKyVRJuoOFdSLKAUW-i9ywfwxyV29TKKpTsR_yxACRD6Na1oHdYnQ4LTWs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfxBveLqTYaPCd5SUJFgx5RjPUGL58b93iZGa9X9Ru8bAw&oe=69B93965"}, {"file_name": "$R81V725.png", "id": "2720695481426567", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75262743_2720695484759900_604086922326600035_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UpDarz2DELsQ7kNvwHIa9Ye&_nc_oc=AdkmFD16OwIriC09N8jSt0kDQN58aHOvpENviMmDM5QY1kqDjjcvuFkUzqwOn--yXpM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_Afy2Nqne1jSllkmoiOCbaGsev0A8Da0COK1a7fNoJgIE_Q&oe=69B9384D"}, {"file_name": "$RQ3SN6U.png", "id": "1552311425628973", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982519_1552311428962306_1218130395049083834_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wOmlAPHiR7EQ7kNvwFPqc3f&_nc_oc=AdlAQJCiaSyqAWOBYgYX6Hfzr9FRb1gIE7jwj9EuhPrp-X-HozgUDojrdm9n9fvKE4E&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfzSWmGPb7dvppvCVO8PwpHG9xKr6oQRY-yWJanUHECZMw&oe=69B943A9"}, {"file_name": "38982645_1000853181732648_505551742782
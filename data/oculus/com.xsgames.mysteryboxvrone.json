J4qwBLEbdTcgV2P1kk_cNil2yiJgmkJdKAsso4PQOTSQ&oe=6A9AE044"}, {"file_name": "5.png", "id": "467916352871409", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39003282_467916356204742_1871921057092171900_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=luA9NtXlIkwQ7kNvwHACw4C&_nc_oc=AdrSvRqWfwVc8apE_DKe9dwi6aiGl6DkpS1toUKEzUXELdA0Qd7NSJClbcNggYK0j2Q&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKoDkJ8EiMCSH8aB3k1Z4OnMspBICMZ8qrfDVycgklA-w&oe=6A9AC4E2"}, {"file_name": "3.png", "id": "1934382610375855", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974473_1934382613709188_7156337812617042679_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vpqxZ-nxRRQQ7kNvwHEKTDa&_nc_oc=Adr_59nqC0Y40hzOEjG07XZhB7QoeiybhPj-wMNx6Z9uOFd9l6w9MfhxMET2e5fSg-0&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK9a7L14uqugI_DeXqN2FfA_T1dMMOtBp0gPJJvKU_hHQ&oe=6A9AE733"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape.png", "id": "1524760081483769", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974531_1524760084817102_6497712644828891067_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Bm1YPPgiS2oQ7kNvwE1Q3ve&_nc_oc=AdoaeZPIfL3GPqsosF5kyE1XPsk7wmsdzAXxvJmi6wGWYd36W38edax58Oi1KV5jJ6k&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKKd1TUWv9yvo9DqR_h7trgchfog8sI7dzbpWWlbE0dSQ&oe=6A9AE62F"}, "display_name": "Mystery Box VR: Hidden Secrets", "keywords": [], "long_description": " AN IMMERSIVE VR PUZZLE EXPERIENCE\nInteract with objects, handles, buttons, and wheels on each side. Crack enigmas and collect hidden puzzle tiles on a random side of the boxes.\n\nYou won't be able to compare reality with fiction.\n\n# DISCOVER INVENTIONS\nOnce you unlock all 8 boxes of a Level Pack, you can compose a puzzle and discover a brief history of an invention.\n\nIt's not always easy to escape the room, so use all your IQ to crack the riddles. There's a logic behind all of them, even where it seems it's not!\n\n# IMMERSIVE SOUNDTRACK\nPlay the game with your headphones to get immersed in this amazing adventure.\n\n# HINTS\nGot stuck on some enigma? No worries, you can still get a helpful hint! You can also get in touch with me in case you really can't make it through a riddle, I'll be glad to help ;)\n\n# MULTILANGUAGE\nAvailable in English, French, Italian, German, Spanish, Russian, and Japanese.\n\nThe game language will change automatically based on the language settings of your device", "short_description": "A VR escape room game where you have to solve intriguing riddles to open boxes and discover nice stories about popular inventions!"}, {"images": {"nodes": [{"file_name": "$R36BSY5.png", "id": "3678762505771822", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39031430_3678762509105155_2151975047074617165_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Om1R5LOiU2sQ7kNvwEdsTDe&_nc_oc=Ado0K4HWRESYsN8Xl3iIHSrkWkMelIfwQ6b-zaSVfO7AB-WJQ0kyEraOHjNYCmvoGR8&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLL2n2Ic6zNv2nkgGFAhbE5ObXNYmHnZrgWfpWM38-pRg&oe=6A9AE225"}, {"file_name": "$R81V725.png", "id": "2720695481426567", "image_type": "APP_IMG_ICON", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/75262743_2720695484759900_604086922326600035_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m5WbgtuZ9tQQ7kNvwGATGvS&_nc_oc=AdpIAn20XtaBvGZyT_G0yo_PsBg3u7C6kIEzCD6-gkS8LoqAJf41qaGBOTCjLb2DP4o&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJT91jf781GQS0ulDLTUGmx-z72qxSyLzixNUtTQAMpJg&oe=6A9AE10D"}, {"file_name": "$RQ3SN6U.png", "id": "1552311425628973", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38982519_1552311428962306_1218130395049083834_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XN-WQH1ndEcQ7kNvwGnD6K-&_nc_oc=AdqhsBiQQcZSVLB6boVwALakdH5IWWf_gPWS-1BD6zsSEp93Dq-cZr369_QoaGwduzo&_nc_zt=3&_nc_ht=
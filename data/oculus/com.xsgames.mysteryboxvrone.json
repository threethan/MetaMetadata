&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cRG0SoKzqagQ7kNvwHWIega&_nc_oc=AdoBgpUvFBPiF6Pas3jOd8eqloaMKKMU_zvWCqhiTKkqx6wEXlDN3P7QhEYTUnXHOCI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQMO5gJWb_0z4QLBpEYIu5vlK7T4hjU4l8dhFGIx7-CBw&oe=6B072408"}, {"file_name": "2.png", "id": "2203761473315962", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75469623_2203761476649295_9180026026436178997_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9CQb3t82B10Q7kNvwEpLkZt&_nc_oc=Ado5WWrQOVl5dbv1AxtOVHcNr9bWCEE3IE2OyOLkzvPed2XaletXXEO6sAN11A00Mnc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQPFH2kEqPQlc-5xgOm53ySDE6n-duhicwsq5OdI5pQ0w&oe=6B071931"}, {"file_name": "5.png", "id": "1600206790893068", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974920_1600206794226401_7626143159008067194_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d88eaDnuqgMQ7kNvwHP86Yu&_nc_oc=AdqyZ4YSdZXfgSsJvarcjFQrAhzkMTwgSdfJObOyTlOiORo5DhlU0o2KmoVaNPs6Yvc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTjdJ66IxVU0UBihCdZm0JWFRbSJYb4uGgw6n7lWmP1mg&oe=6B0725CA"}, {"file_name": "3.png", "id": "1053463469622332", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75395599_1053463472955665_4671093965273907425_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Re5ACnTQZhMQ7kNvwEd1SUC&_nc_oc=AdpqHHti_VcsoSHw7mn9LSAHgcXzPNW3fINiwVM5r1jP6-MZwpIxgJeGSxuDc-i5Wos&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS9uliV9cf0Y5bmnbt5nmHZs5U7OsY0g1fQCGj9R1q2Lw&oe=6B07192E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape_coverart.png", "id": "1539093960065384", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982581_1539093963398717_8886613911254029402_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=abAUi40Q5cQQ7kNvwGfje_k&_nc_oc=Adq_6dUXeOW5DMK8ByYKbWjbQqow9HGVyhvpvvmNowzZILJ6ElxVKZ5LGHtHQvQxUi4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQCWyri_ph7yD34cNehRaiC1XVMMFhUD0Cix06XBxfqfQ&oe=6B06F592"}, "display_name": "Mystery Box VR: Hidden Secrets Escape", "keywords": ["escape", "room", "trivia", "puzzle", "mistero"], "long_description": "# UN'ESPERIENZA DI GIOCO UNICA\nInteragisci con oggetti, maniglie, pulsanti e ruote su ciascun lato. Risolvi gli enigmi e raccogli le tessere del puzzle nascoste su un lato casuale delle scatole.\n\n# SEMBRA COS\u00cc REALE!\nNon sarai in grado di confrontare la realt\u00e0 con la finzione.\n\n\n# SCOPRI LE INVENZIONI\nUna volta sbloccate tutte le 8 caselle di un pacchetto livelli, puoi comporre un puzzle e scoprire una breve storia di un'invenzione.\n\n\n# PENSA FUORI DAGLI SCHEMI\nNon \u00e8 sempre facile fuggire dalla stanza, quindi usa tutto il tuo QI per risolvere gli enigmi. C'\u00e8 una logica dietro a tutti, anche dove sembra che non lo sia!\n\n# AUDIO D'ATMOSFERA\nGioca con le cuffie per immergerti in questa fantastica avventura.\n\n# ]SUGGERIMENTI DISPONIBILI\nSei rimasto bloccato su qualche enigma? Nessun problema, puoi comunque ricevere un suggerimento utile! Puoi anche contattarmi nel caso in cui davvero non riesci a risolvere un indovinello, sar\u00f2 felice di aiutarti ;)\n\n\n# SUPPORTO MULTILINGUA\nDisponibile in inglese, francese, italiano, tedesco, spagnolo, russo e giapponese.\n\nLa lingua del gioco cambier\u00e0 automaticamente in base alle impostazioni della lingua del tuo dispositivo", "short_description": "Un gioco escape room in cui devi risolvere enigmi intriganti per aprire scatole e scoprire simpatiche storie su invenzioni popolari!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://xsgames.co/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "XSGames", "support_website_url": "https://xsgames.co/", "website_url": "https://xsgames.co/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_t
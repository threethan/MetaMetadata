3Br-wL10OTsRgOUXQMf9r4BwXfoMEIyJSDvBgwNE4hCQ&oe=69E642C4"}, {"file_name": "5.png", "id": "467916352871409", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39003282_467916356204742_1871921057092171900_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v7TR56NKjikQ7kNvwEtMnxc&_nc_oc=Adpat15Sxk1wfUxK5umWppx2kBxFYx-hJhI05iozWK7E6cJv4WHn9e6FFeyxkhhOLaU&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2m2YEHPPzyNYglRhe3dSVtBmVLTP7KFDMQKSjG_g3xQQ&oe=69E62762"}, {"file_name": "3.png", "id": "1934382610375855", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974473_1934382613709188_7156337812617042679_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Pc6yK5bdpBEQ7kNvwEfG0V2&_nc_oc=AdqkhERCIUaYrD68k7xOdPd-_ylH3oN57iW882eCIy4A16sXGTptGICjTE6MLhXkn4w&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1vaaJEAc9xPwoQ9hsFe1HLa21LKAJp0wwcczDUsvJv3g&oe=69E61173"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape.png", "id": "1524760081483769", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974531_1524760084817102_6497712644828891067_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4vCQCHiAyCQQ7kNvwEA73Ey&_nc_oc=Adqx3BJCPbmTufzwActWhI0HSLJKfPQu-QSLRkRxDQuDmJ95oDch5w34qcnpvP88wnA&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0B84HpQsqPYz8HdHP6KmuSLxjpnBPe14hq2i9cFqB6Ig&oe=69E6106F"}, "display_name": "Mystery Box VR: Hidden Secrets", "keywords": [], "long_description": " AN IMMERSIVE VR PUZZLE EXPERIENCE\nInteract with objects, handles, buttons, and wheels on each side. Crack enigmas and collect hidden puzzle tiles on a random side of the boxes.\n\nYou won't be able to compare reality with fiction.\n\n# DISCOVER INVENTIONS\nOnce you unlock all 8 boxes of a Level Pack, you can compose a puzzle and discover a brief history of an invention.\n\nIt's not always easy to escape the room, so use all your IQ to crack the riddles. There's a logic behind all of them, even where it seems it's not!\n\n# IMMERSIVE SOUNDTRACK\nPlay the game with your headphones to get immersed in this amazing adventure.\n\n# HINTS\nGot stuck on some enigma? No worries, you can still get a helpful hint! You can also get in touch with me in case you really can't make it through a riddle, I'll be glad to help ;)\n\n# MULTILANGUAGE\nAvailable in English, French, Italian, German, Spanish, Russian, and Japanese.\n\nThe game language will change automatically based on the language settings of your device", "short_description": "A VR escape room game where you have to solve intriguing riddles to open boxes and discover nice stories about popular inventions!"}, {"images": {"nodes": [{"file_name": "$R36BSY5.png", "id": "3678762505771822", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39031430_3678762509105155_2151975047074617165_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SFQzbCp1j3sQ7kNvwEO6sTE&_nc_oc=AdrarEqA8G18CjcNjEeNjtlefJjhBhlA9xBb31L1qgQ0-4vC36wIX4zzW7Yge2l9XoQ&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3yEOY3EZuJxtoPl7TOMvDC4RbWmG6vcrk5BST44eVs9A&oe=69E644A5"}, {"file_name": "$R81V725.png", "id": "2720695481426567", "image_type": "APP_IMG_ICON", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/75262743_2720695484759900_604086922326600035_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y_AHIxX8bHgQ7kNvwFXv49Y&_nc_oc=AdoQbFNtqqMS7hZ9JiJoC7A7DNsEppDOdSvKAQbKPBKSoWoPshsKhOgpD0TQTFjSzRs&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af17JBzAoJGpO0G-_8angMULiUmmYp4wkxL_oVkZajHPag&oe=69E6438D"}, {"file_name": "$RQ3SN6U.png", "id": "1552311425628973", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38982519_1552311428962306_1218130395049083834_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3IpkNCyuN6AQ7kNvwFPxMAA&_nc_oc=AdpXrzlBBughoRDeSkhbCq1J7ljL2SBzgJUqnkrjVKtEbCXrPX0Li5OlbmN8TgmmyiY&_nc_zt=3&_nc_ht=
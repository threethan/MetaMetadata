DQ1wXs8H-0cnnrB9WwgqLCvpA1mc-nVe70Er0X9fKOsw&oe=6A6DD504"}, {"file_name": "5.png", "id": "467916352871409", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39003282_467916356204742_1871921057092171900_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5IpeZoJhoEoQ7kNvwHT0C29&_nc_oc=Ado6Ir3f1PvbSGenh0MmeLJTPis1zGdFxS1cUwBxy3s-h7a4EXnv75jvIXZm-QFqom0&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBvxuzRT1FJ49JPb07aQi8jdRmGomeN5_-kmYCfoCNaCg&oe=6A6DF1E2"}, {"file_name": "3.png", "id": "1934382610375855", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974473_1934382613709188_7156337812617042679_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VBC8zhruEgwQ7kNvwHJNuk5&_nc_oc=Adp7-leTQ7kupPuKr0n8EVwIEVKe1bOmiageRajce3sO0bY6SARavBhzcgCfHxkRnRY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC18oP2fIRtk1nIv6WsUBcZaZ9IyXiGzA59PUBWYQoanA&oe=6A6DDBF3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape.png", "id": "1524760081483769", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974531_1524760084817102_6497712644828891067_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QDYuHfl4np0Q7kNvwHC7Owz&_nc_oc=Adrqxy0Uoy0_GeXDLG3MonG1YvJhBZjIsDSrNoOvP895XBJhggg4yg2bLlzKKtYpohM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBphMPchVwq1fSbyYW88eMXkhLr95VsDXf5Y6ApxehwOA&oe=6A6DDAEF"}, "display_name": "Mystery Box VR: Hidden Secrets", "keywords": [], "long_description": " AN IMMERSIVE VR PUZZLE EXPERIENCE\nInteract with objects, handles, buttons, and wheels on each side. Crack enigmas and collect hidden puzzle tiles on a random side of the boxes.\n\nYou won't be able to compare reality with fiction.\n\n# DISCOVER INVENTIONS\nOnce you unlock all 8 boxes of a Level Pack, you can compose a puzzle and discover a brief history of an invention.\n\nIt's not always easy to escape the room, so use all your IQ to crack the riddles. There's a logic behind all of them, even where it seems it's not!\n\n# IMMERSIVE SOUNDTRACK\nPlay the game with your headphones to get immersed in this amazing adventure.\n\n# HINTS\nGot stuck on some enigma? No worries, you can still get a helpful hint! You can also get in touch with me in case you really can't make it through a riddle, I'll be glad to help ;)\n\n# MULTILANGUAGE\nAvailable in English, French, Italian, German, Spanish, Russian, and Japanese.\n\nThe game language will change automatically based on the language settings of your device", "short_description": "A VR escape room game where you have to solve intriguing riddles to open boxes and discover nice stories about popular inventions!"}, {"images": {"nodes": [{"file_name": "$R36BSY5.png", "id": "3678762505771822", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031430_3678762509105155_2151975047074617165_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MTxXUwAJXE0Q7kNvwGEaBv3&_nc_oc=AdpK2BdoncO7dg5qVlQ0Pn90sOiGqj_I6a4xyyOmi2FD_pD5whVhkdLpkZap_Sy7DkU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBxvL7bBiDYfjEdndgEOCXlFRzZIn357eJ9m6mJt06bxA&oe=6A6DD6E5"}, {"file_name": "$R81V725.png", "id": "2720695481426567", "image_type": "APP_IMG_ICON", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75262743_2720695484759900_604086922326600035_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tRZFeSP8BWwQ7kNvwH-UTmi&_nc_oc=AdpDiPGArG1khVV6Ljw3cAxso2z6wcA6ZooNGDHEdMCDR4VH538x7X4ZPZPQOf40Xsw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCoUFJrbV9qJg4D2h2jx-NC30fp-z0Mbh0hm8Su7oWxBw&oe=6A6DD5CD"}, {"file_name": "$RQ3SN6U.png", "id": "1552311425628973", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982519_1552311428962306_1218130395049083834_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1YaAl40-JyQQ7kNvwFJkEEc&_nc_oc=Adr2eoXr7Dpjk1Cr_oYYaX10Wqe5rTUdabfcTWWoGVVr-cin8VucE_8T-tn0BI0cSjk&_nc_zt=3&_nc_ht=
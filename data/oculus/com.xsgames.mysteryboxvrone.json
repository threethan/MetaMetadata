0AZMfzNIyefKYPm2Y2NUUss-WCpZFfOH0PmijGLmycBQ&oe=69F4C344"}, {"file_name": "5.png", "id": "467916352871409", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39003282_467916356204742_1871921057092171900_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PvT-cwi-sIYQ7kNvwHbUyK2&_nc_oc=AdqxCV8MgFwMksAHUd0HNNeec2fqRyC2Kuz6mQ1CukaLlFxHVoZlyq5DfH9jT0rXoNk&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3FtLrDmAEQ_f6LTeZD1OqN11qY0bOjK_gVX2iv2_k49w&oe=69F4A7E2"}, {"file_name": "3.png", "id": "1934382610375855", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974473_1934382613709188_7156337812617042679_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=croQcA-CEQ4Q7kNvwHB2z9J&_nc_oc=Adoth4HQTOKFVXBFVQ3w_Tqc9EOu-4okK3PBxA7LD4ib5WbQ3U-7UTV81s8ZG3wmLVg&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2iRjx51uJfB2pz6piNDNxzVCUJNd09ijzUIa7_MbGwgQ&oe=69F491F3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape.png", "id": "1524760081483769", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974531_1524760084817102_6497712644828891067_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UP51b_7NTokQ7kNvwFDAckm&_nc_oc=Adp3UIT1_3bvaKrcL7eAchTrkSQFPCHpP_XtTHBh6O9o5x-YQDteGcZ1jsUIe3d3guQ&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0Z_QsguOksQ7YWNr_kJrsZU-0eFWsmyqe-iqsGdjNG5A&oe=69F4C92F"}, "display_name": "Mystery Box VR: Hidden Secrets", "keywords": [], "long_description": " AN IMMERSIVE VR PUZZLE EXPERIENCE\nInteract with objects, handles, buttons, and wheels on each side. Crack enigmas and collect hidden puzzle tiles on a random side of the boxes.\n\nYou won't be able to compare reality with fiction.\n\n# DISCOVER INVENTIONS\nOnce you unlock all 8 boxes of a Level Pack, you can compose a puzzle and discover a brief history of an invention.\n\nIt's not always easy to escape the room, so use all your IQ to crack the riddles. There's a logic behind all of them, even where it seems it's not!\n\n# IMMERSIVE SOUNDTRACK\nPlay the game with your headphones to get immersed in this amazing adventure.\n\n# HINTS\nGot stuck on some enigma? No worries, you can still get a helpful hint! You can also get in touch with me in case you really can't make it through a riddle, I'll be glad to help ;)\n\n# MULTILANGUAGE\nAvailable in English, French, Italian, German, Spanish, Russian, and Japanese.\n\nThe game language will change automatically based on the language settings of your device", "short_description": "A VR escape room game where you have to solve intriguing riddles to open boxes and discover nice stories about popular inventions!"}, {"images": {"nodes": [{"file_name": "$R36BSY5.png", "id": "3678762505771822", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39031430_3678762509105155_2151975047074617165_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v0HKqFefVK4Q7kNvwHkZ2YN&_nc_oc=Adp68m380BL2IUwFmugKXT3p0CdC_okX2zC60ZSZFqXJb2bW06HWoIP19scODi3F8f4&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1CKIs1DYgiQvrxf0sQznKhJNDBPGIZ_yCa66yANzoqfg&oe=69F4C525"}, {"file_name": "$R81V725.png", "id": "2720695481426567", "image_type": "APP_IMG_ICON", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/75262743_2720695484759900_604086922326600035_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CTPYwstLWbwQ7kNvwGVZCOS&_nc_oc=AdpLnnKRBCK2BdBZQzj_5IOOdAuvnWMB0pgeZFuKB3Y5iPs66onbBRuePPoRdFkq5Js&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3XycgEx2ey_JhgCAEL3prK19EKUvd0JgbmOwYYv4y99g&oe=69F4C40D"}, {"file_name": "$RQ3SN6U.png", "id": "1552311425628973", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38982519_1552311428962306_1218130395049083834_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=t3ZowUAlbwYQ7kNvwGd21Oy&_nc_oc=AdrdKBa9IT9GKvSNFrQQNKAR-9w0prabNPHNU0LscEW01aEExaDLR_TUcudHIMkAyTw&_nc_zt=3&_nc_ht=
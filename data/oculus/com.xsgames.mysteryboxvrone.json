oculuscdn.com/v/t64.5771-25/39003282_467916356204742_1871921057092171900_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nNIYA6z0BzgQ7kNvwHfEXYi&_nc_oc=Adnh5U1rS8Dl9Vo4HUcB1PXcy0ckjnJYrBkuoZdsNwoWgX_a7TZjGUHFXH3-BRvJC3g&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_Afym13onY-waeO_IOM1qhfK2wG9D_qGtv27GoyRYXIKI_w&oe=69B6B162"}, {"file_name": "3.png", "id": "1934382610375855", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974473_1934382613709188_7156337812617042679_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2C1EPFxSneAQ7kNvwFFj8tP&_nc_oc=Adl870TbR8d_ckcUWRTpDIu0mVOPcnIXNfVPR4pygN847vvK0wwyZITQIMSUcNU3GRQ&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfzcsoPVdlMHDTZcdFN1e5WCojqGGYXT11bPE9CrFBlwQg&oe=69B69B73"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape.png", "id": "1524760081483769", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974531_1524760084817102_6497712644828891067_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Rs3FlcN1C9oQ7kNvwE4zhqK&_nc_oc=Adk_jgWayw4gPmiSvS1DcmMvpa5DFrHGt_BBHXXz8Kdit-aR8c-qf_J6stKj9-W8RCk&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfyRj0lqyb3h5KZhSS7-PpFGTjp0jlp0L1RE3ad-437KWw&oe=69B69A6F"}, "display_name": "Mystery Box VR: Hidden Secrets", "keywords": [], "long_description": " AN IMMERSIVE VR PUZZLE EXPERIENCE\nInteract with objects, handles, buttons, and wheels on each side. Crack enigmas and collect hidden puzzle tiles on a random side of the boxes.\n\nYou won't be able to compare reality with fiction.\n\n# DISCOVER INVENTIONS\nOnce you unlock all 8 boxes of a Level Pack, you can compose a puzzle and discover a brief history of an invention.\n\nIt's not always easy to escape the room, so use all your IQ to crack the riddles. There's a logic behind all of them, even where it seems it's not!\n\n# IMMERSIVE SOUNDTRACK\nPlay the game with your headphones to get immersed in this amazing adventure.\n\n# HINTS\nGot stuck on some enigma? No worries, you can still get a helpful hint! You can also get in touch with me in case you really can't make it through a riddle, I'll be glad to help ;)\n\n# MULTILANGUAGE\nAvailable in English, French, Italian, German, Spanish, Russian, and Japanese.\n\nThe game language will change automatically based on the language settings of your device", "short_description": "A VR escape room game where you have to solve intriguing riddles to open boxes and discover nice stories about popular inventions!"}, {"images": {"nodes": [{"file_name": "$R36BSY5.png", "id": "3678762505771822", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39031430_3678762509105155_2151975047074617165_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=znCUPmUK3ZoQ7kNvwEkRWZO&_nc_oc=AdkXIBY92vdmVubAI33bhaKZfWojKi8xEedQVl4kOkrIEDez99KYHvw13o4k8Paa9U0&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfxcKdAMUPLHLYqG5jLXsQi1d1cFCfH6KiQ9mU9PoDpISA&oe=69B69665"}, {"file_name": "$R81V725.png", "id": "2720695481426567", "image_type": "APP_IMG_ICON", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75262743_2720695484759900_604086922326600035_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d_4pHy4rrL4Q7kNvwG3KmwW&_nc_oc=Adms9X9U6R3YhbUNp6OCmyiEo1pdlieBoI1xdfAvuhUIiCwjUgHH1z_BQFI1sBHYVF0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfxLprcuX4m5MROjipjXVhEiRDuPPTzJyLzbl0yLYyzdzw&oe=69B6954D"}, {"file_name": "$RQ3SN6U.png", "id": "1552311425628973", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982519_1552311428962306_1218130395049083834_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wOmlAPHiR7EQ7kNvwH-qtsX&_nc_oc=AdkZ1doKcoIr83bY34VNR62WBB7gL3iE-du27V45T_MPryyXVLmvrbw3nTRMJNKQajQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_Afy9FF6pzK9EMpnZLq6j_2IJW9U0jAN8O3pa6WdWF8M5gA&oe=69B6A0A9"}, {"file_name": "38982645_1000853181732648_505551742782
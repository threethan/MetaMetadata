07UNE7l7kMjvbi-4HMYJBUE0XyGX5_Cw3mzi9CfArwNg&oe=69DB7E84"}, {"file_name": "5.png", "id": "467916352871409", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39003282_467916356204742_1871921057092171900_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fyDJ3uVB0y8Q7kNvwF7obC1&_nc_oc=Adpjw63EaXbvtH9Ei3-xj3PyD9BMnZfUiqw_zPJOSUBPQbvgprgngLXnWVp6hG7Yx0I&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2NWPqqvFU90fW-CRl19mqumPMPVI2eVgPgCPlEyHIoNg&oe=69DB9B62"}, {"file_name": "3.png", "id": "1934382610375855", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974473_1934382613709188_7156337812617042679_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5tPaQvxgezsQ7kNvwEbPfDg&_nc_oc=AdoJon7ZtnhjlICY5ITjVSJga87VCcHKlCyDZrlK1L2KdFMbgw2duBy3AFJ9kiWcQ50&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3_5jAYRMqRqzhMc_EQFpY68atcjwD04OFusaj9_KXBcw&oe=69DB8573"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape.png", "id": "1524760081483769", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974531_1524760084817102_6497712644828891067_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=his7Q8bPNZ0Q7kNvwHsyos8&_nc_oc=Adpo8Cc44F4J0oxyLgG2pxqwxBxF5ZRE3ZDw06RuOjNuKCFCpnAc2vKGC9AckcgeZT0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1X-Es1OLUCoMJe5bW7CF3ijfxlS_eLnSVO10iJuEkLZQ&oe=69DB846F"}, "display_name": "Mystery Box VR: Hidden Secrets", "keywords": [], "long_description": " AN IMMERSIVE VR PUZZLE EXPERIENCE\nInteract with objects, handles, buttons, and wheels on each side. Crack enigmas and collect hidden puzzle tiles on a random side of the boxes.\n\nYou won't be able to compare reality with fiction.\n\n# DISCOVER INVENTIONS\nOnce you unlock all 8 boxes of a Level Pack, you can compose a puzzle and discover a brief history of an invention.\n\nIt's not always easy to escape the room, so use all your IQ to crack the riddles. There's a logic behind all of them, even where it seems it's not!\n\n# IMMERSIVE SOUNDTRACK\nPlay the game with your headphones to get immersed in this amazing adventure.\n\n# HINTS\nGot stuck on some enigma? No worries, you can still get a helpful hint! You can also get in touch with me in case you really can't make it through a riddle, I'll be glad to help ;)\n\n# MULTILANGUAGE\nAvailable in English, French, Italian, German, Spanish, Russian, and Japanese.\n\nThe game language will change automatically based on the language settings of your device", "short_description": "A VR escape room game where you have to solve intriguing riddles to open boxes and discover nice stories about popular inventions!"}, {"images": {"nodes": [{"file_name": "$R36BSY5.png", "id": "3678762505771822", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031430_3678762509105155_2151975047074617165_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T33KLF-vSkQQ7kNvwE_mKi2&_nc_oc=Adra1Qo4nQB9gmKQrqKu8gqBEia7bPPNOaTcMGtg7GWmxffc3NeBzxxHRhqiWDqiZd8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1Ac0MQacGGnYYM-c-1DutoMkZ6ofCUMNtyUE8R-AiRGg&oe=69DB8065"}, {"file_name": "$R81V725.png", "id": "2720695481426567", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75262743_2720695484759900_604086922326600035_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C1uhwJC9RV4Q7kNvwG2qmNG&_nc_oc=Adrk_vNd50yWBg2tdz4ziQ-yiA8aA1f3Kh_yhD6hZdX2WTFyK1R7L54DTQxX0MsB3Y4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1R5b-yrHooNLhfLj4UhbmFxxJ5Hb-aM6WS9-rY9gzdnQ&oe=69DB7F4D"}, {"file_name": "$RQ3SN6U.png", "id": "1552311425628973", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982519_1552311428962306_1218130395049083834_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=juWwt7Nu2DsQ7kNvwHTiM7Z&_nc_oc=Adp7d5LR9JRdyJ0Ze5KtNJwK8ffQcJHXEeRoWSgnIp2as3-mUg26qH8f1DLrQdmif0E&_nc_zt=3&_nc_ht=
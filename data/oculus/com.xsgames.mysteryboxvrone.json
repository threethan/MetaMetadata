oculuscdn.com/v/t64.5771-25/39003282_467916356204742_1871921057092171900_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DrCKn-jmMhEQ7kNvwFwYDFW&_nc_oc=Adkm4zrYujz88KdSGWM1jTT3lE6_ST0EgH0fX_drlaYXBr_uN_63yDBeQs8oMv-4kf8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfyiyGHWAASxfwB6wr5_x4AZqToli6C0j3WK0-AA-zAESg&oe=69B2BCE2"}, {"file_name": "3.png", "id": "1934382610375855", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974473_1934382613709188_7156337812617042679_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yZSxb3aoSjEQ7kNvwEHEluJ&_nc_oc=AdmBulAlelBSRxlkmcMDym8_usW9ux3u3evmE1wEW8-3kOi6wYSWjuVSeO910CKpPpA&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfzlBvSLiGe1O3uw8VGZCDC3QIiLiyhbi_Sqj-f43lUOdw&oe=69B2A6F3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape.png", "id": "1524760081483769", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974531_1524760084817102_6497712644828891067_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vsBrAafxQN4Q7kNvwF6EcD-&_nc_oc=AdmzHVdB8rwHH7u-WwDpP-Tc_TXJmv1hCvU4uGd1CR8CxYHcqCUfn4ZOsBXZxt88flQ&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfyITvXOR9yQmHU4QbtU7ulYQn0v0wdN-06baPbgMA_JdA&oe=69B2A5EF"}, "display_name": "Mystery Box VR: Hidden Secrets", "keywords": [], "long_description": " AN IMMERSIVE VR PUZZLE EXPERIENCE\nInteract with objects, handles, buttons, and wheels on each side. Crack enigmas and collect hidden puzzle tiles on a random side of the boxes.\n\nYou won't be able to compare reality with fiction.\n\n# DISCOVER INVENTIONS\nOnce you unlock all 8 boxes of a Level Pack, you can compose a puzzle and discover a brief history of an invention.\n\nIt's not always easy to escape the room, so use all your IQ to crack the riddles. There's a logic behind all of them, even where it seems it's not!\n\n# IMMERSIVE SOUNDTRACK\nPlay the game with your headphones to get immersed in this amazing adventure.\n\n# HINTS\nGot stuck on some enigma? No worries, you can still get a helpful hint! You can also get in touch with me in case you really can't make it through a riddle, I'll be glad to help ;)\n\n# MULTILANGUAGE\nAvailable in English, French, Italian, German, Spanish, Russian, and Japanese.\n\nThe game language will change automatically based on the language settings of your device", "short_description": "A VR escape room game where you have to solve intriguing riddles to open boxes and discover nice stories about popular inventions!"}, {"images": {"nodes": [{"file_name": "$R36BSY5.png", "id": "3678762505771822", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031430_3678762509105155_2151975047074617165_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NzpCYikjf_oQ7kNvwHEA5x4&_nc_oc=AdkhwukGLSBKxIYwlQacjVhfLUZBbn4IV1lYKSqN5B4EVI4eD5z8WxN5hWEdzEv3b0o&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfxJ_TOOrUlmGtg5rZvpspiohLFwFgCifN6IPpp5c9FF6Q&oe=69B2A1E5"}, {"file_name": "$R81V725.png", "id": "2720695481426567", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75262743_2720695484759900_604086922326600035_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vyqluxzvlLoQ7kNvwEkvlwh&_nc_oc=AdlRGyXr-D09mLW9M0CvBCPBDgmskTnh3_DS6uJD70WAlNf3dJy6_JcJ2ODIup4sjWI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfxWcam51GjXpVPAn7syjK336QMsbzTJxBHg8RYDlkH6MQ&oe=69B2A0CD"}, {"file_name": "$RQ3SN6U.png", "id": "1552311425628973", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982519_1552311428962306_1218130395049083834_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jVSTOEIJFbcQ7kNvwFw5Psy&_nc_oc=AdltoIMEgHxD4cA_YbOObZ5ibVnr1GB8GvVJEugaQvWt4SYu0iyoO4B04cYDN8rqGRA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_Afza4PVZnEHC7PjogVAR1v0P4SboKj6TyLIzk51-96HTtQ&oe=69B2AC29"}, {"file_name": "38982645_1000853181732648_505551742782
J8SwjXyLjR9NReN73jXQP28hk1Nahhaj6rfqdSsfJjHw&oe=6ABBD5C4"}, {"file_name": "5.png", "id": "467916352871409", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39003282_467916356204742_1871921057092171900_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1UwAcoGgqqYQ7kNvwHHIdse&_nc_oc=AdrmY_2fxFw6InFOfQ33QD-5ODA1Fza4YGLs47RDYHpeuLiDSho2uEwtHKiV3opfvgg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKxFCCgXDcx0ELX_E2voCyG5rUJL-bG1Vf14M1d1142yA&oe=6ABBBA62"}, {"file_name": "3.png", "id": "1934382610375855", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974473_1934382613709188_7156337812617042679_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0wZ_wo7bdUIQ7kNvwGzVtRz&_nc_oc=AdrQA9pA9iKHop_kgOOCkTd4cfv9GO3d4zMQDshKXIe37uIMRwJQLvy882HjuM1iIDc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL4YAWNLz9yyNSxsvR6C95G2YCef-W8ipH-smXmP3cU3Q&oe=6ABBDCB3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape.png", "id": "1524760081483769", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974531_1524760084817102_6497712644828891067_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fRt1lxEZQoUQ7kNvwEgT-Oc&_nc_oc=Adq6jwq_ZwLvyi43bKAoV5pxatzkzAO-o5PBCI3kYQKuvCofDSnPCYahny5n6fLXmZc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJDS6YjpEG6ugH6M7EMxNtS-DnO6595iodDsBh5rSDF1Q&oe=6ABBDBAF"}, "display_name": "Mystery Box VR: Hidden Secrets", "keywords": [], "long_description": " AN IMMERSIVE VR PUZZLE EXPERIENCE\nInteract with objects, handles, buttons, and wheels on each side. Crack enigmas and collect hidden puzzle tiles on a random side of the boxes.\n\nYou won't be able to compare reality with fiction.\n\n# DISCOVER INVENTIONS\nOnce you unlock all 8 boxes of a Level Pack, you can compose a puzzle and discover a brief history of an invention.\n\nIt's not always easy to escape the room, so use all your IQ to crack the riddles. There's a logic behind all of them, even where it seems it's not!\n\n# IMMERSIVE SOUNDTRACK\nPlay the game with your headphones to get immersed in this amazing adventure.\n\n# HINTS\nGot stuck on some enigma? No worries, you can still get a helpful hint! You can also get in touch with me in case you really can't make it through a riddle, I'll be glad to help ;)\n\n# MULTILANGUAGE\nAvailable in English, French, Italian, German, Spanish, Russian, and Japanese.\n\nThe game language will change automatically based on the language settings of your device", "short_description": "A VR escape room game where you have to solve intriguing riddles to open boxes and discover nice stories about popular inventions!"}, {"images": {"nodes": [{"file_name": "$R36BSY5.png", "id": "3678762505771822", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031430_3678762509105155_2151975047074617165_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Kyiry5-JgvkQ7kNvwG5mBn8&_nc_oc=AdoGLNRJLnhltorZoIj6n2gBQBJDZnHBpzREud4SLusG_-moiPCL1dwTUFHdVMoxrdE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLU3j0kJ4-Dq5ryxm1EgAtOy-ubJI5mb-AJbKni7cA2_w&oe=6ABBD7A5"}, {"file_name": "$R81V725.png", "id": "2720695481426567", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75262743_2720695484759900_604086922326600035_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZAr6iCLjBL4Q7kNvwEM8Lx4&_nc_oc=AdpQk6HUt46ajPZSN7Bb_f0p3loYiOiz9knL1bzh674oyQ03jDRZE4ij25xI_HfxGFY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL2812X3_NkqiSCYrjPmJ3GsRQ2XahvQo_jSU2pZ7ucsg&oe=6ABBD68D"}, {"file_name": "$RQ3SN6U.png", "id": "1552311425628973", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982519_1552311428962306_1218130395049083834_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YDxrfButeyMQ7kNvwHzkzPS&_nc_oc=AdqbI4SD7xfO8AugFSSPoTmb_L_dGAryxaxLhJ_OxZB5TmFcGJvxGvktRaCyMQx31GI&_nc_zt=3&_nc_ht=
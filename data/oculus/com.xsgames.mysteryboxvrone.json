M57lV19d2vcFf551VgugVixHDPYFqWpOrlG54ECiYnGA&oe=6ACF9C44"}, {"file_name": "5.png", "id": "467916352871409", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39003282_467916356204742_1871921057092171900_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hUGMmn9zWBYQ7kNvwGUPo5i&_nc_oc=AdpMtLGMfW5Aljz6mU3yUgjP2rMs87OWoAkbQ_1l3lbjng76Shc5Xiu4JbzMYutETTw&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNJfq76dCjyYXx8GAIMBSLXqc31ywfAkXUpObCcBGuMCQ&oe=6ACFB922"}, {"file_name": "3.png", "id": "1934382610375855", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974473_1934382613709188_7156337812617042679_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8F2qVGXjIc8Q7kNvwG5ZIY3&_nc_oc=AdoQ4kb6j7X90vqRcaFrBohG0AknswT_Jr5rlR2Lw3aESIIzdFuvEoAWlwmDb7M86b4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO-AHGSm6ZBX2E7byfG94eSPsJYFqCE6TiUuGyNIZBZUg&oe=6ACFA333"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape.png", "id": "1524760081483769", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974531_1524760084817102_6497712644828891067_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eyg-K22Kxc8Q7kNvwF1QAgO&_nc_oc=AdpIkE_7vJ0V4A6m3JGYIS8CSUsyA4SaGUmk0j0-fVRlKgHUtPAKkNZuqCsZHPGwMjo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNBedhs880bhkIOiq0LDkwjM_UcWfuW2gErz2lUH6rULQ&oe=6ACFA22F"}, "display_name": "Mystery Box VR: Hidden Secrets", "keywords": [], "long_description": " AN IMMERSIVE VR PUZZLE EXPERIENCE\nInteract with objects, handles, buttons, and wheels on each side. Crack enigmas and collect hidden puzzle tiles on a random side of the boxes.\n\nYou won't be able to compare reality with fiction.\n\n# DISCOVER INVENTIONS\nOnce you unlock all 8 boxes of a Level Pack, you can compose a puzzle and discover a brief history of an invention.\n\nIt's not always easy to escape the room, so use all your IQ to crack the riddles. There's a logic behind all of them, even where it seems it's not!\n\n# IMMERSIVE SOUNDTRACK\nPlay the game with your headphones to get immersed in this amazing adventure.\n\n# HINTS\nGot stuck on some enigma? No worries, you can still get a helpful hint! You can also get in touch with me in case you really can't make it through a riddle, I'll be glad to help ;)\n\n# MULTILANGUAGE\nAvailable in English, French, Italian, German, Spanish, Russian, and Japanese.\n\nThe game language will change automatically based on the language settings of your device", "short_description": "A VR escape room game where you have to solve intriguing riddles to open boxes and discover nice stories about popular inventions!"}, {"images": {"nodes": [{"file_name": "$R36BSY5.png", "id": "3678762505771822", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031430_3678762509105155_2151975047074617165_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Dlpu9UE1778Q7kNvwHxqWco&_nc_oc=AdpSDBU2vX4Qfc7VomR2jO6WEabkcnehzmDIaaRkhUwhsoGZ_vjvXKpl4n0uoGEC-88&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMZcQoMycUjzujFz6nu7CjgHaoQM6bDqEZD62OXutaq_A&oe=6ACF9E25"}, {"file_name": "$R81V725.png", "id": "2720695481426567", "image_type": "APP_IMG_ICON", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75262743_2720695484759900_604086922326600035_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-Z9abiq98bwQ7kNvwF4MDr-&_nc_oc=AdoCo2VlCuWP_E4cwMUPk7n9cY0U5Jw-bdibHyBUP0tJdL9b1VtGCW5XxE0a11XFDtA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPqkNygnjG0bqzcj2AUSlx--rof2HS6619ynayAlngh8g&oe=6ACF9D0D"}, {"file_name": "$RQ3SN6U.png", "id": "1552311425628973", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982519_1552311428962306_1218130395049083834_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TqPYzj6IPcIQ7kNvwGRkYAq&_nc_oc=AdprbtOM9Pc9MYh5rpAwnhRLi-5DOrLkvZ6plX54CjcrtW_kUEu76Y8CIMPSJVpXCqs&_nc_zt=3&_nc_ht=
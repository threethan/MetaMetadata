NoBKRu8LGSExebG2K5zIrrqaPpJMCbB6C7cU_27DWinw&oe=6ADCCB44"}, {"file_name": "5.png", "id": "467916352871409", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39003282_467916356204742_1871921057092171900_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uAnFCOVmvN0Q7kNvwFfx40K&_nc_oc=AdrELCP7nuOWGNShZoLWw2p5AP9nbsw3jPTrv46KAzyZaAxsm8jn-0NLw7OAfZgnsaQ&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPdQvA_itGZ5uehOpJIPPpanhPJkzCEWr1sAVk48tTePA&oe=6ADCAFE2"}, {"file_name": "3.png", "id": "1934382610375855", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974473_1934382613709188_7156337812617042679_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MJ7HdUWs29kQ7kNvwFBhuzL&_nc_oc=Adp5GdvdTRNCp8NH2OtRor8FGlS3QIC77PWg_TU0whG7csOxNXxH5h_GxWNDmMLBiwA&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMbH5_0hRRfGVOoMXbGuu5owPpS0hym-NQZn2JKdpnQkQ&oe=6ADCD233"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape.png", "id": "1524760081483769", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974531_1524760084817102_6497712644828891067_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WxZbBS9VYkQQ7kNvwEdq8AJ&_nc_oc=AdqQk3XH3tTg7xljt_Q1mlTpK8aUnwquD2A6wqjDq7UNCYaEgctDm4QLZUeKFXQBdi0&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPR6_mX6ZsVzMCZHt5A_1nvLgcyrVRIg5xAKz5FcSnwPg&oe=6ADCD12F"}, "display_name": "Mystery Box VR: Hidden Secrets", "keywords": [], "long_description": " AN IMMERSIVE VR PUZZLE EXPERIENCE\nInteract with objects, handles, buttons, and wheels on each side. Crack enigmas and collect hidden puzzle tiles on a random side of the boxes.\n\nYou won't be able to compare reality with fiction.\n\n# DISCOVER INVENTIONS\nOnce you unlock all 8 boxes of a Level Pack, you can compose a puzzle and discover a brief history of an invention.\n\nIt's not always easy to escape the room, so use all your IQ to crack the riddles. There's a logic behind all of them, even where it seems it's not!\n\n# IMMERSIVE SOUNDTRACK\nPlay the game with your headphones to get immersed in this amazing adventure.\n\n# HINTS\nGot stuck on some enigma? No worries, you can still get a helpful hint! You can also get in touch with me in case you really can't make it through a riddle, I'll be glad to help ;)\n\n# MULTILANGUAGE\nAvailable in English, French, Italian, German, Spanish, Russian, and Japanese.\n\nThe game language will change automatically based on the language settings of your device", "short_description": "A VR escape room game where you have to solve intriguing riddles to open boxes and discover nice stories about popular inventions!"}, {"images": {"nodes": [{"file_name": "$R36BSY5.png", "id": "3678762505771822", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39031430_3678762509105155_2151975047074617165_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mDbv-FMJ0MEQ7kNvwGl_CBz&_nc_oc=AdriYOHyUtkiVDwZrKG5GFhCsT9dX4bgyJIxumZdbjhQllrtzZvUVDsB1w6_erh2ePA&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNatneQC24AB6-sV3zxLoFPoulY8_EY_4NNe0Pbsf3tiA&oe=6ADCCD25"}, {"file_name": "$R81V725.png", "id": "2720695481426567", "image_type": "APP_IMG_ICON", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/75262743_2720695484759900_604086922326600035_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=X_piOz10lD0Q7kNvwEm96vM&_nc_oc=AdpNVhTOOoX55ljUqNGEvnZkfERrfDZ_LidTFRVIwNSk1TnCUZJKcLluxMvoPoXggSg&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMHwFr8rU60LO-R8rEAy6zdCSq2TN-RpHI6A2P9f2DxSw&oe=6ADCCC0D"}, {"file_name": "$RQ3SN6U.png", "id": "1552311425628973", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38982519_1552311428962306_1218130395049083834_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2fNiINTEnb4Q7kNvwHodbk0&_nc_oc=AdqfGN9FoWZT_k-gKRc_XGo8v76eBqDNB7ovTAoXE3SImrmPEdOv_OCbq3FLgwpLmjM&_nc_zt=3&_nc_ht=
B5vX7yPASMEB0bPQ3yJNcSHXZwgOe-H_umQ24YxswOVQ&oe=6A622FC4"}, {"file_name": "5.png", "id": "467916352871409", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39003282_467916356204742_1871921057092171900_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PHaJ55mO0AEQ7kNvwG2mwdK&_nc_oc=Adqu2sCh6wqjc57gNB_Fq931fMkrWSCBWCO96mY6RHbztjTXn0hEAuIluc3EsRAmk_M&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAdnJU_2J1EsI8z6W3d5d8j6rkI5xI5lfEFYU6q5kBZ5g&oe=6A621462"}, {"file_name": "3.png", "id": "1934382610375855", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974473_1934382613709188_7156337812617042679_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s77qzT6yfzYQ7kNvwEqhnoL&_nc_oc=AdpuWd0yTzqo-8QbpVXztWIqBzefes7IdZYZAuZz2VWpe5sF8UErptpFv3Lxsq-LmlQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAfZwhRl3xj5SPKNfC6wtewh3-XAhGU0Bt6PUpqt3FgaQ&oe=6A61FE73"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape.png", "id": "1524760081483769", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974531_1524760084817102_6497712644828891067_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kLNFM-SprAcQ7kNvwE99AcY&_nc_oc=Adrgvs5nDCZ8U9wXmGWd_rbICT0ekxa3TVxzXVV6N9TDwzwQPGphBSek7jCozEu2kCI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCFNdqF9cIcOqncoRnVAEKY7XxEoBv_PjViZyBUqP2Ikw&oe=6A61FD6F"}, "display_name": "Mystery Box VR: Hidden Secrets", "keywords": [], "long_description": " AN IMMERSIVE VR PUZZLE EXPERIENCE\nInteract with objects, handles, buttons, and wheels on each side. Crack enigmas and collect hidden puzzle tiles on a random side of the boxes.\n\nYou won't be able to compare reality with fiction.\n\n# DISCOVER INVENTIONS\nOnce you unlock all 8 boxes of a Level Pack, you can compose a puzzle and discover a brief history of an invention.\n\nIt's not always easy to escape the room, so use all your IQ to crack the riddles. There's a logic behind all of them, even where it seems it's not!\n\n# IMMERSIVE SOUNDTRACK\nPlay the game with your headphones to get immersed in this amazing adventure.\n\n# HINTS\nGot stuck on some enigma? No worries, you can still get a helpful hint! You can also get in touch with me in case you really can't make it through a riddle, I'll be glad to help ;)\n\n# MULTILANGUAGE\nAvailable in English, French, Italian, German, Spanish, Russian, and Japanese.\n\nThe game language will change automatically based on the language settings of your device", "short_description": "A VR escape room game where you have to solve intriguing riddles to open boxes and discover nice stories about popular inventions!"}, {"images": {"nodes": [{"file_name": "$R36BSY5.png", "id": "3678762505771822", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031430_3678762509105155_2151975047074617165_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tnE8cRUZho0Q7kNvwHxgnS0&_nc_oc=Adrwily0bhekop69qyGtJ1LMALPKLXAk_0QuL1DjE17y6adqdI6hkg2bNVlW8n4bdGw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBmI-ExhcQh3Wc3tv8BZ0DlFuYpoGfPVBSXTgm5oIUW5g&oe=6A6231A5"}, {"file_name": "$R81V725.png", "id": "2720695481426567", "image_type": "APP_IMG_ICON", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75262743_2720695484759900_604086922326600035_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aWp710nGOBwQ7kNvwHJjvmd&_nc_oc=AdrCczrUDc_nzj0l1Zr_WLGMUgz0oQNs2gcU1sjWOMuf1Kus0EwlFcdxmkvlkVZguQY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCqwUPLLpkrIh0g3nsk5LowspWXBE-QEmJFnPtukCLlMg&oe=6A62308D"}, {"file_name": "$RQ3SN6U.png", "id": "1552311425628973", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982519_1552311428962306_1218130395049083834_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=81BrDIPtdqUQ7kNvwHmjRRk&_nc_oc=AdqIjxu5WQYJ2cvJ1-JPAXPVoUQfI9FD2s9hThKhrRq501yg1DlpQIflI8pNIgVftYo&_nc_zt=3&_nc_ht=
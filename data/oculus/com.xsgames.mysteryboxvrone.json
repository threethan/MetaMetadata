67WBy3M1wP1_z-AoEFeoWuZFxHv2RpskobWJgWVaW1sA&oe=6A1DA1C4"}, {"file_name": "5.png", "id": "467916352871409", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39003282_467916356204742_1871921057092171900_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CJ_5dFS0kEQQ7kNvwFGOcpx&_nc_oc=AdqGX4fLMkiTyUZ_bneUeonB38AkoLWBE_6kMvppfSLf-98eUA0X83auURHXlxCe8CE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7dJQfgNEhwBc4KC9HmgHXzPTUPT3-FO4nkq_q-a-3xEQ&oe=6A1D8662"}, {"file_name": "3.png", "id": "1934382610375855", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974473_1934382613709188_7156337812617042679_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dupyzk9Tg-wQ7kNvwEBlHDN&_nc_oc=AdpjZikQGk3ruKalkjCMFBX6gCssKGtVGBC9tvAOs88Cztxmg56m3fCN8qUhpmAma5Y&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6k-DD825kE3niLCt7vFDXfsZIeqiLYq4L6rpe-HO8lrA&oe=6A1DA8B3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape.png", "id": "1524760081483769", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974531_1524760084817102_6497712644828891067_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-1vldexJwcYQ7kNvwFHvoJZ&_nc_oc=AdpPBULt1iYKVYS6yArq3uzlQkXpbp9UoQSDrANOFAdx7MARsjvovR7gfwZ02XFjAjQ&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7kTgpZbkl-YY5OOIsFgG6kcM0wjj4CXUQtTdgGV8AuRg&oe=6A1DA7AF"}, "display_name": "Mystery Box VR: Hidden Secrets", "keywords": [], "long_description": " AN IMMERSIVE VR PUZZLE EXPERIENCE\nInteract with objects, handles, buttons, and wheels on each side. Crack enigmas and collect hidden puzzle tiles on a random side of the boxes.\n\nYou won't be able to compare reality with fiction.\n\n# DISCOVER INVENTIONS\nOnce you unlock all 8 boxes of a Level Pack, you can compose a puzzle and discover a brief history of an invention.\n\nIt's not always easy to escape the room, so use all your IQ to crack the riddles. There's a logic behind all of them, even where it seems it's not!\n\n# IMMERSIVE SOUNDTRACK\nPlay the game with your headphones to get immersed in this amazing adventure.\n\n# HINTS\nGot stuck on some enigma? No worries, you can still get a helpful hint! You can also get in touch with me in case you really can't make it through a riddle, I'll be glad to help ;)\n\n# MULTILANGUAGE\nAvailable in English, French, Italian, German, Spanish, Russian, and Japanese.\n\nThe game language will change automatically based on the language settings of your device", "short_description": "A VR escape room game where you have to solve intriguing riddles to open boxes and discover nice stories about popular inventions!"}, {"images": {"nodes": [{"file_name": "$R36BSY5.png", "id": "3678762505771822", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031430_3678762509105155_2151975047074617165_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2ZlDI-jaHHMQ7kNvwGXxeyF&_nc_oc=Adr9KUU57_4MthqNabGgmvLR_C3ro6RgWrzQTNlQCi5UGJMsEE-yzbMS5PV8YAXAVSE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4PDdOakcG6_oROZdiTWI9MHPf2bxACZ8JbTIc97HGqMw&oe=6A1DA3A5"}, {"file_name": "$R81V725.png", "id": "2720695481426567", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75262743_2720695484759900_604086922326600035_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Nwm9vbWAD4MQ7kNvwEg0OuJ&_nc_oc=AdqzSG2nrQRuYCEmFX1m4nsp6dW4ksOdgWm9TI9AEA0559yBVRg7wtsLVc0zj7X4_Qc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6W0I4guL-8fjEH_EEia4p6kiTgWK5Ry3EbAH3L3SFhJg&oe=6A1DA28D"}, {"file_name": "$RQ3SN6U.png", "id": "1552311425628973", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982519_1552311428962306_1218130395049083834_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NoCqdmUsMfAQ7kNvwHgeHB4&_nc_oc=AdqK94ab_zB4EKDaf9I_9u3tpEeMK-sGaayZoxYz0K-yr4QQrgNiIy-qulOeDLHu9G8&_nc_zt=3&_nc_ht=
CIyawBgFZHmI8G3hVSctaJXXt2wsJFd72srcNceExwPQ&oe=6A6CBBC4"}, {"file_name": "5.png", "id": "467916352871409", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39003282_467916356204742_1871921057092171900_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5IpeZoJhoEoQ7kNvwF3oI7O&_nc_oc=AdoLw5xLgL-bpeEasXuMo0Xjc7Z8PjZuL5lWyGbe8xgNu1iMoUa2d89pOjE9hB61h8c&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB8LRCIEt0q_BSnEj24gFqPYEaOW4HchqNtr6lDIuhImQ&oe=6A6CA062"}, {"file_name": "3.png", "id": "1934382610375855", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974473_1934382613709188_7156337812617042679_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KOYiLY0m3k4Q7kNvwGF5aOa&_nc_oc=Adp9pEyYA4dOk236aRJd8S9RKNXzaBZtePHTiWpXDsCgKhFZaD7Mxxx0cKQNYkTq16w&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCiuGecfQor0bnTGk0vE1iXVps-QHlfoIjpk7CkTGbMYQ&oe=6A6CC2B3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape.png", "id": "1524760081483769", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974531_1524760084817102_6497712644828891067_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QDYuHfl4np0Q7kNvwHSePBt&_nc_oc=Ado6LuCCJpAvORLjBsOx2GHnNA64zkBgY3_fV5jgY40Vf-MmavpA7PTBThFo4LUHzlw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAVl7OypNnsldf7l_uQyP_c1njozA-M6gxC3Qg2N-Fwgg&oe=6A6CC1AF"}, "display_name": "Mystery Box VR: Hidden Secrets", "keywords": [], "long_description": " AN IMMERSIVE VR PUZZLE EXPERIENCE\nInteract with objects, handles, buttons, and wheels on each side. Crack enigmas and collect hidden puzzle tiles on a random side of the boxes.\n\nYou won't be able to compare reality with fiction.\n\n# DISCOVER INVENTIONS\nOnce you unlock all 8 boxes of a Level Pack, you can compose a puzzle and discover a brief history of an invention.\n\nIt's not always easy to escape the room, so use all your IQ to crack the riddles. There's a logic behind all of them, even where it seems it's not!\n\n# IMMERSIVE SOUNDTRACK\nPlay the game with your headphones to get immersed in this amazing adventure.\n\n# HINTS\nGot stuck on some enigma? No worries, you can still get a helpful hint! You can also get in touch with me in case you really can't make it through a riddle, I'll be glad to help ;)\n\n# MULTILANGUAGE\nAvailable in English, French, Italian, German, Spanish, Russian, and Japanese.\n\nThe game language will change automatically based on the language settings of your device", "short_description": "A VR escape room game where you have to solve intriguing riddles to open boxes and discover nice stories about popular inventions!"}, {"images": {"nodes": [{"file_name": "$R36BSY5.png", "id": "3678762505771822", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031430_3678762509105155_2151975047074617165_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MTxXUwAJXE0Q7kNvwELYdRR&_nc_oc=AdpzEK9dU4DhnzknJyvgsAEQZknvcKNQsbZ9vulkldxrYOFwFzWcntyG7T8MYocHRgQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAtJwrAuJmAzbZ1SobiXcN8NlxrxDQ767tORCbu_rrQbA&oe=6A6CBDA5"}, {"file_name": "$R81V725.png", "id": "2720695481426567", "image_type": "APP_IMG_ICON", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75262743_2720695484759900_604086922326600035_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tcljYjz-edoQ7kNvwF4HCCy&_nc_oc=AdpWCXfFPchSHCZyzbOcea5Dyec5itD-vo6kIGYLHEH4UFcPCwFavMHE2nnZmAaj5WE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA3N9SSTrtfKy610crJs2xGuzGfHueLuHNiPPxlnuCeig&oe=6A6CBC8D"}, {"file_name": "$RQ3SN6U.png", "id": "1552311425628973", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982519_1552311428962306_1218130395049083834_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1YaAl40-JyQQ7kNvwEQGvXs&_nc_oc=AdpZO6WdDJjEKb_MZsd5xv6CjkNx8Se41Q38fZ_ZzfpUhtMwdRZQpj1wACxRVrEbRnc&_nc_zt=3&_nc_ht=
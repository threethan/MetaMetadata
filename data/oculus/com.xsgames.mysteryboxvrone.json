GDp3Dv-jBw--uE5jiWMjwO5tn3JKQLmF58Lzn9ixh1CQ&oe=6A79B284"}, {"file_name": "5.png", "id": "467916352871409", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39003282_467916356204742_1871921057092171900_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yhaliy8f3KsQ7kNvwGv-u6b&_nc_oc=Adolx0sJK83LhJ6mk_dMufOC9aYVl9WQCoDo8qpyjGOsgyvgvXQsG1v2nIMZ6Y6mCXM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEDV_QZQgUdt8nIeWSc7XbfWwX5Thym2g1AQaVdQcDV0w&oe=6A79CF62"}, {"file_name": "3.png", "id": "1934382610375855", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974473_1934382613709188_7156337812617042679_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=auHKFdSw4boQ7kNvwH0M4RV&_nc_oc=AdqoYQxN1s2wuWNvS2kI4BYWjBtCQyWZaMlpf_XnBeyMhNrEH_wBSDeckywoOpYS-9I&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHVNxTwqfjqxT9ChPuSA1nL_IZbP2B12vTQbMEwJWtA5A&oe=6A79B973"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape.png", "id": "1524760081483769", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974531_1524760084817102_6497712644828891067_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DNNCLxqj8M4Q7kNvwE7uRbH&_nc_oc=Adp9hqoop64cznT0ljM5MbgC-MxeRCpKZHjCF5SWQOIR_hV41SW1Bhf_yDlfP9AxE7E&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEkcLHlw2I2bJYE9h5998n68IzdkevK7swmhd_6AWG_Ag&oe=6A79B86F"}, "display_name": "Mystery Box VR: Hidden Secrets", "keywords": [], "long_description": " AN IMMERSIVE VR PUZZLE EXPERIENCE\nInteract with objects, handles, buttons, and wheels on each side. Crack enigmas and collect hidden puzzle tiles on a random side of the boxes.\n\nYou won't be able to compare reality with fiction.\n\n# DISCOVER INVENTIONS\nOnce you unlock all 8 boxes of a Level Pack, you can compose a puzzle and discover a brief history of an invention.\n\nIt's not always easy to escape the room, so use all your IQ to crack the riddles. There's a logic behind all of them, even where it seems it's not!\n\n# IMMERSIVE SOUNDTRACK\nPlay the game with your headphones to get immersed in this amazing adventure.\n\n# HINTS\nGot stuck on some enigma? No worries, you can still get a helpful hint! You can also get in touch with me in case you really can't make it through a riddle, I'll be glad to help ;)\n\n# MULTILANGUAGE\nAvailable in English, French, Italian, German, Spanish, Russian, and Japanese.\n\nThe game language will change automatically based on the language settings of your device", "short_description": "A VR escape room game where you have to solve intriguing riddles to open boxes and discover nice stories about popular inventions!"}, {"images": {"nodes": [{"file_name": "$R36BSY5.png", "id": "3678762505771822", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031430_3678762509105155_2151975047074617165_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mBen32FCM04Q7kNvwFlXJNL&_nc_oc=Adp37WoCInerCF34VO9sp3iObH7mn97z8AR8kq6TcIvqx-OvQeQY5y9EYPiKhfbwgX4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGDoNlSxJeLTFVr5HpaKIuc7rw1y5Nqx4eE4JIP_6XgVQ&oe=6A79B465"}, {"file_name": "$R81V725.png", "id": "2720695481426567", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75262743_2720695484759900_604086922326600035_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IOqqRB2BlEAQ7kNvwGhX2EN&_nc_oc=AdqARYutT9NFH-v1IAxzOiG4LA7d5iFBxKbB7TLwVph0b0LVrkdw2Hst-QdE6bVaUT8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGsopPStyzxPV9fDdrGR0zi21WWNuuXpq2kYxLx_yonZQ&oe=6A79B34D"}, {"file_name": "$RQ3SN6U.png", "id": "1552311425628973", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982519_1552311428962306_1218130395049083834_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xx9Ag-Hg0pYQ7kNvwGtE8YU&_nc_oc=Adrsy88J2RT1TsUYRXSS6tNFuJi0URUm909kzLnrrsCf011c9afuEIkTDHoQ-rFRJTc&_nc_zt=3&_nc_ht=
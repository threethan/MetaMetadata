1exrXWYiytvJi16oaIIePGG6h6rtyAD6umQpAI_nH8FA&oe=69DA2D04"}, {"file_name": "5.png", "id": "467916352871409", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39003282_467916356204742_1871921057092171900_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fyDJ3uVB0y8Q7kNvwHVaWw-&_nc_oc=AdrpGS2q3QCzKfdy4YM7xSrYQWz73pVXcX7LD8dY1rEUKAo5QCgTEwZRFbD6L7u2gmE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3fyb_ccE4dfkTjXlYK3PWCRIP_nwrKplI9be99jRA1YA&oe=69DA49E2"}, {"file_name": "3.png", "id": "1934382610375855", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974473_1934382613709188_7156337812617042679_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dgRRQTuDp4YQ7kNvwGbMAwN&_nc_oc=AdrktSZh8nLLkjZhnd9Z391_elL0lQVEMgZX29io7xA3L37DEuww6wHUoB6Adb9cmCM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0l9s0PGlk3ZV14fRV7V94acxpPomFExkjMlglwTSOiYQ&oe=69DA33F3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape.png", "id": "1524760081483769", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974531_1524760084817102_6497712644828891067_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=his7Q8bPNZ0Q7kNvwEdr8lj&_nc_oc=AdpjmPxyQFb6r-o9SkyEr7BLCGf-59hQ77sc_eYZ-utOFhRjGRDmK8fKZuj0iVKwav0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3UdLnbg7ORJmPJxL5W3-QYmXYT-6KeuSS2iOQusSoN6g&oe=69DA32EF"}, "display_name": "Mystery Box VR: Hidden Secrets", "keywords": [], "long_description": " AN IMMERSIVE VR PUZZLE EXPERIENCE\nInteract with objects, handles, buttons, and wheels on each side. Crack enigmas and collect hidden puzzle tiles on a random side of the boxes.\n\nYou won't be able to compare reality with fiction.\n\n# DISCOVER INVENTIONS\nOnce you unlock all 8 boxes of a Level Pack, you can compose a puzzle and discover a brief history of an invention.\n\nIt's not always easy to escape the room, so use all your IQ to crack the riddles. There's a logic behind all of them, even where it seems it's not!\n\n# IMMERSIVE SOUNDTRACK\nPlay the game with your headphones to get immersed in this amazing adventure.\n\n# HINTS\nGot stuck on some enigma? No worries, you can still get a helpful hint! You can also get in touch with me in case you really can't make it through a riddle, I'll be glad to help ;)\n\n# MULTILANGUAGE\nAvailable in English, French, Italian, German, Spanish, Russian, and Japanese.\n\nThe game language will change automatically based on the language settings of your device", "short_description": "A VR escape room game where you have to solve intriguing riddles to open boxes and discover nice stories about popular inventions!"}, {"images": {"nodes": [{"file_name": "$R36BSY5.png", "id": "3678762505771822", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031430_3678762509105155_2151975047074617165_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T33KLF-vSkQQ7kNvwG3INBX&_nc_oc=AdoXdSPnDoZT1Hn1bm0XuJvG5yzg5JLBBDBPHt87_KjBFkWnnoRgylRGOgRdBIgGO-0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3AnK13bkatpa8nvkUyJK7YwdU00NrVn_OPDcNVkJbUEQ&oe=69DA2EE5"}, {"file_name": "$R81V725.png", "id": "2720695481426567", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75262743_2720695484759900_604086922326600035_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=svA-GaDpOIIQ7kNvwH1gmDZ&_nc_oc=AdqZicj1ndLm_zBniGukt-X0qpvJ_e0ZZ_uRGG5HhB5neRiFNWGcl1kPca8IQXduwhA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3GWtzOoAZ0blzr6cWZei0RMnIEhMZOUcYYfLXp_HuOmQ&oe=69DA2DCD"}, {"file_name": "$RQ3SN6U.png", "id": "1552311425628973", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982519_1552311428962306_1218130395049083834_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=juWwt7Nu2DsQ7kNvwEu7ht1&_nc_oc=AdqCjwLuJagas32-za4jqkdFA-o7lWz1Tm5y457ishovlkdS_jPC0r1ro_1t2YlAzPo&_nc_zt=3&_nc_ht=
S_YWZkYZgKw42_mX3A6f2wW78P6XRLVj-QMjRG4iz4aA&oe=6AE9FA44"}, {"file_name": "5.png", "id": "467916352871409", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39003282_467916356204742_1871921057092171900_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MgUAaWxKuxoQ7kNvwFrai0D&_nc_oc=AdqXak4CgkX-DBTs_KoEsLOhHvQqEY0wl61TjrCLpMgeLo7FCteTMyY4EQbUYKGIM0Y&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRbnHjzzbnJCkhLndDNBfw0kVlGyO6fR1xmmvn0op2HZg&oe=6AE9DEE2"}, {"file_name": "3.png", "id": "1934382610375855", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974473_1934382613709188_7156337812617042679_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k-c6xB5Xq7wQ7kNvwFUqJyM&_nc_oc=AdptiZgsuqM6VhVsuRLaNPgReOtRq3-NwrIn93CouOtZhkmsMgvlQMSxoGs8ITa9pAI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS2GWgzuN3PgWe_pinhX5aLpSAMZ8ANmH19MyE7OgJzwA&oe=6AEA0133"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape.png", "id": "1524760081483769", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974531_1524760084817102_6497712644828891067_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ICKTRBeXEK8Q7kNvwEcmMr5&_nc_oc=Adrs_Ptvyb2V367QGzkcXmyIyG5VKXDXwX09x7J0yXMaKW0-VFhd689mHJV89VkVQjk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSXZ5_5tecjs-KFLv2tD3cAzEv0HOInclIsAlpAUQxmJw&oe=6AEA002F"}, "display_name": "Mystery Box VR: Hidden Secrets", "keywords": [], "long_description": " AN IMMERSIVE VR PUZZLE EXPERIENCE\nInteract with objects, handles, buttons, and wheels on each side. Crack enigmas and collect hidden puzzle tiles on a random side of the boxes.\n\nYou won't be able to compare reality with fiction.\n\n# DISCOVER INVENTIONS\nOnce you unlock all 8 boxes of a Level Pack, you can compose a puzzle and discover a brief history of an invention.\n\nIt's not always easy to escape the room, so use all your IQ to crack the riddles. There's a logic behind all of them, even where it seems it's not!\n\n# IMMERSIVE SOUNDTRACK\nPlay the game with your headphones to get immersed in this amazing adventure.\n\n# HINTS\nGot stuck on some enigma? No worries, you can still get a helpful hint! You can also get in touch with me in case you really can't make it through a riddle, I'll be glad to help ;)\n\n# MULTILANGUAGE\nAvailable in English, French, Italian, German, Spanish, Russian, and Japanese.\n\nThe game language will change automatically based on the language settings of your device", "short_description": "A VR escape room game where you have to solve intriguing riddles to open boxes and discover nice stories about popular inventions!"}, {"images": {"nodes": [{"file_name": "$R36BSY5.png", "id": "3678762505771822", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031430_3678762509105155_2151975047074617165_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yWdw9yM2iPoQ7kNvwH1njxf&_nc_oc=Adpnxewfdb0kEL3BQalbwMYEudtvbsVleobeuPchXIZq_9y3efJXOdRzUakRwamFF_s&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTYUpaE8SNrsKbPSDKm-MTt_MIBn-Voturz58WkArSzuQ&oe=6AE9FC25"}, {"file_name": "$R81V725.png", "id": "2720695481426567", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75262743_2720695484759900_604086922326600035_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6UmypCW4fe8Q7kNvwHskPuU&_nc_oc=AdomXrThjeHOlqbcK2AoWTrrr6jXXw1j9o530oO2bnALD7naMOOqu8Kv9b_fRli30lI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRtc6Ne6TtgUCYQnQiyEuSaN7oumsXkR31IP1A1R_9reQ&oe=6AE9FB0D"}, {"file_name": "$RQ3SN6U.png", "id": "1552311425628973", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982519_1552311428962306_1218130395049083834_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jkLJYok55P0Q7kNvwGIf6m8&_nc_oc=AdpbP9d_0Oc4PitdsWy006NRqu0w9WFCCLrUXycQGLoRlUc_5GTV-qaB7jKvrG2ZsQw&_nc_zt=3&_nc_ht=
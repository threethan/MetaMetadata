Fc6AOVfG0h58P3vALzCTM8-BoxodmEGJqPr3QKSTOiZg&oe=6A883304"}, {"file_name": "5.png", "id": "467916352871409", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/39003282_467916356204742_1871921057092171900_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sFAPI_R-uCYQ7kNvwFQFeX8&_nc_oc=AdqA6APgsqfe8Kgb5zvExDNvvUwEt4hw0y-Zd-2Y5kRdtWNP83EPqBTNcWffu8pOVRw&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF9SBFviTq_jNSwJLmyB9TkUO-M5PwmMzoutie-1N7diw&oe=6A884FE2"}, {"file_name": "3.png", "id": "1934382610375855", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/38974473_1934382613709188_7156337812617042679_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r9Ra2wldkIUQ7kNvwF1wvzu&_nc_oc=AdpAsY8HcSlkoEeqCnsUvS6E-bol4uc3FDj2UfiJR2mWiHbuFv__8yUxmEk7h8redOY&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG6LailCnjBGJlM6rL-IJbAC77FN3DOpmR5kb3yU09xOQ&oe=6A8839F3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape.png", "id": "1524760081483769", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/38974531_1524760084817102_6497712644828891067_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VGDSsTtMcgoQ7kNvwFEjO_D&_nc_oc=AdrEeQjfwsg3iHD4OYhmHT3ta2GNsaXxJiecoVYG-a4NcBKZfuQc1B0Pfze_C3OPiHo&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFV15PCa3Q3M7G9ozn3OMMWc1defuNFd91qZTUvA4c7JA&oe=6A8838EF"}, "display_name": "Mystery Box VR: Hidden Secrets", "keywords": [], "long_description": " AN IMMERSIVE VR PUZZLE EXPERIENCE\nInteract with objects, handles, buttons, and wheels on each side. Crack enigmas and collect hidden puzzle tiles on a random side of the boxes.\n\nYou won't be able to compare reality with fiction.\n\n# DISCOVER INVENTIONS\nOnce you unlock all 8 boxes of a Level Pack, you can compose a puzzle and discover a brief history of an invention.\n\nIt's not always easy to escape the room, so use all your IQ to crack the riddles. There's a logic behind all of them, even where it seems it's not!\n\n# IMMERSIVE SOUNDTRACK\nPlay the game with your headphones to get immersed in this amazing adventure.\n\n# HINTS\nGot stuck on some enigma? No worries, you can still get a helpful hint! You can also get in touch with me in case you really can't make it through a riddle, I'll be glad to help ;)\n\n# MULTILANGUAGE\nAvailable in English, French, Italian, German, Spanish, Russian, and Japanese.\n\nThe game language will change automatically based on the language settings of your device", "short_description": "A VR escape room game where you have to solve intriguing riddles to open boxes and discover nice stories about popular inventions!"}, {"images": {"nodes": [{"file_name": "$R36BSY5.png", "id": "3678762505771822", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/39031430_3678762509105155_2151975047074617165_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gZ_TfERnMz0Q7kNvwGnca8o&_nc_oc=AdpNZf5-rEBHTG-GiWjpFp7YEhiRXOenfQ50bbfVhTwnDqpqCwdvyQyi9hmkNoNCbM8&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGXFz22SCCIAAlx31X0JIKPa04BYrmI3wG6VIXl_OMLPw&oe=6A8834E5"}, {"file_name": "$R81V725.png", "id": "2720695481426567", "image_type": "APP_IMG_ICON", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/75262743_2720695484759900_604086922326600035_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nJZHQ2He9JEQ7kNvwFIriyy&_nc_oc=AdosSLCxV2KFtOCBG_xYhLQR8m9py64c-bVk4JlHuQadgk3G2z-4jKCoUl7JqN2iq64&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGVyYHsAkwUXUUhwOtJ6EllkEhswVnW6RGYe1oDNaz8RQ&oe=6A8833CD"}, {"file_name": "$RQ3SN6U.png", "id": "1552311425628973", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/38982519_1552311428962306_1218130395049083834_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=urfsbveJpZ4Q7kNvwFtTIeB&_nc_oc=AdojS8ff5EXMVQ74Bakw0A_DPTwsM56mku2Ppjw7xiliWGf8EKHxyJVPY3J1wps3CLQ&_nc_zt=3&_nc_ht=
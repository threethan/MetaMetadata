KEczNDXw5SKqAREQZponYVYK5fUZEZfYm9uCsjF8ZY0g&oe=6AAAB244"}, {"file_name": "5.png", "id": "467916352871409", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39003282_467916356204742_1871921057092171900_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bLZgz68agl0Q7kNvwHyv9qU&_nc_oc=AdpUJCwvSjaAY52A0R1Oz_75uHpGJH0q4TGCeCUNL4_2dfSs6fqDZ57tpqD0XL_HV3g&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJFtvlT4I2e0VMmabAjixa4zK2Z8ggD9rq2-sxO-o6qsg&oe=6AAA96E2"}, {"file_name": "3.png", "id": "1934382610375855", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974473_1934382613709188_7156337812617042679_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7Td24-Ca-9YQ7kNvwFCTGfR&_nc_oc=AdpTDn8ZVLOMiqk58lhkTtPbuAw65CNAeT8f-__KoXONgdJ_H26v9_89fO4TA2ib67k&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLXM2rYhHakxX22iTThBUXv_967MRBdYZSiX0QDhOuFkQ&oe=6AAAB933"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape.png", "id": "1524760081483769", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974531_1524760084817102_6497712644828891067_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DB3TPWyecXoQ7kNvwGcHR2y&_nc_oc=AdqxVM1lmfAw0K6m04YmXPU0rkXENrvtXHNBBVbjECcQjOg-jOhAYxdsi4z7dYuoAso&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKw5MK8WIlyv75jgO2ewwcHrjaHdPt244tOZpWJfZgnQA&oe=6AAAB82F"}, "display_name": "Mystery Box VR: Hidden Secrets", "keywords": [], "long_description": " AN IMMERSIVE VR PUZZLE EXPERIENCE\nInteract with objects, handles, buttons, and wheels on each side. Crack enigmas and collect hidden puzzle tiles on a random side of the boxes.\n\nYou won't be able to compare reality with fiction.\n\n# DISCOVER INVENTIONS\nOnce you unlock all 8 boxes of a Level Pack, you can compose a puzzle and discover a brief history of an invention.\n\nIt's not always easy to escape the room, so use all your IQ to crack the riddles. There's a logic behind all of them, even where it seems it's not!\n\n# IMMERSIVE SOUNDTRACK\nPlay the game with your headphones to get immersed in this amazing adventure.\n\n# HINTS\nGot stuck on some enigma? No worries, you can still get a helpful hint! You can also get in touch with me in case you really can't make it through a riddle, I'll be glad to help ;)\n\n# MULTILANGUAGE\nAvailable in English, French, Italian, German, Spanish, Russian, and Japanese.\n\nThe game language will change automatically based on the language settings of your device", "short_description": "A VR escape room game where you have to solve intriguing riddles to open boxes and discover nice stories about popular inventions!"}, {"images": {"nodes": [{"file_name": "$R36BSY5.png", "id": "3678762505771822", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031430_3678762509105155_2151975047074617165_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GKtfdn4sZ6AQ7kNvwFGXgj_&_nc_oc=AdrgtxmPIcVSOTbMQ9Vsbwax5KxEn9Zzn5wGBNtG7Pl_IBZ7dKE-Zx-6MZWcnbaS2pM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJYUACX123sexoZyqNrR4R8QIcQNSawRO0PPGfOfq3XRg&oe=6AAAB425"}, {"file_name": "$R81V725.png", "id": "2720695481426567", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75262743_2720695484759900_604086922326600035_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bNtvm_ejkd0Q7kNvwG-Scaf&_nc_oc=AdoQoHQV1KQkt2XdvJYkwmUhnNyx-mXi-xL7ZX1P4j2ZhZjeJezPirRUdc9Zhk32uOw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK53taM76_ZWfEH_I3PcTZOhunIA1kQOQaY1A3X4LLkBA&oe=6AAAB30D"}, {"file_name": "$RQ3SN6U.png", "id": "1552311425628973", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982519_1552311428962306_1218130395049083834_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bR3_bM_dQS8Q7kNvwFY28sO&_nc_oc=AdoCL7ATdVxz_wGD2SySB9pTDH9NPXvYA8gpl1lSCgunqNgoRtgBwX57bDsdtFikW1o&_nc_zt=3&_nc_ht=
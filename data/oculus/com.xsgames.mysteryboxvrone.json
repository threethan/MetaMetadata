E2ZAY7OyU3AYYkJ9lA9oSaILjJm1RWR9lqJJ8OWKy85Q&oe=6A898484"}, {"file_name": "5.png", "id": "467916352871409", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39003282_467916356204742_1871921057092171900_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sFAPI_R-uCYQ7kNvwE2t_Un&_nc_oc=AdreD4tZrl8BGKH24d1WZmqYDJWysAIIfJJ0gyBpnBFRAwzyFDGvXix9U2C_qmWYm6M&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHII5eV5BaR9hqyn02_afXv6LpKY3GxhXnY6rvwkGO4PA&oe=6A89A162"}, {"file_name": "3.png", "id": "1934382610375855", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974473_1934382613709188_7156337812617042679_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iypWcf_2E60Q7kNvwFNfj4F&_nc_oc=Adr-_tDimzrPtI496aeimhpwIkkNw9qkP9U-6BlxHfdzeqo_ErZu75Ru0DT-_QyAFOw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF-BvN9vnh_ucylZXARu2N2W_wQ6oI44O6nWZKR862maw&oe=6A898B73"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape.png", "id": "1524760081483769", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974531_1524760084817102_6497712644828891067_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VGDSsTtMcgoQ7kNvwHdQZ9p&_nc_oc=AdobY2g22tCyfa3EVmYukBuPKI-jf-eH6j-2nkscywKRSsEWbJIrjJAPU46E4SM49iY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGaCbaUGxYIz2u-hydNwxXEvcV19szqXxj9t_XIfrKeDQ&oe=6A898A6F"}, "display_name": "Mystery Box VR: Hidden Secrets", "keywords": [], "long_description": " AN IMMERSIVE VR PUZZLE EXPERIENCE\nInteract with objects, handles, buttons, and wheels on each side. Crack enigmas and collect hidden puzzle tiles on a random side of the boxes.\n\nYou won't be able to compare reality with fiction.\n\n# DISCOVER INVENTIONS\nOnce you unlock all 8 boxes of a Level Pack, you can compose a puzzle and discover a brief history of an invention.\n\nIt's not always easy to escape the room, so use all your IQ to crack the riddles. There's a logic behind all of them, even where it seems it's not!\n\n# IMMERSIVE SOUNDTRACK\nPlay the game with your headphones to get immersed in this amazing adventure.\n\n# HINTS\nGot stuck on some enigma? No worries, you can still get a helpful hint! You can also get in touch with me in case you really can't make it through a riddle, I'll be glad to help ;)\n\n# MULTILANGUAGE\nAvailable in English, French, Italian, German, Spanish, Russian, and Japanese.\n\nThe game language will change automatically based on the language settings of your device", "short_description": "A VR escape room game where you have to solve intriguing riddles to open boxes and discover nice stories about popular inventions!"}, {"images": {"nodes": [{"file_name": "$R36BSY5.png", "id": "3678762505771822", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031430_3678762509105155_2151975047074617165_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gZ_TfERnMz0Q7kNvwGr0Jau&_nc_oc=AdpfiAXVq7BMLWfFvKRKaT1EOn_2LP_EXx53pmYLab_ee5_bSbyMybzdxA91A8iXkFg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHI0OBJdwXq4EsW-xYK01lgGhpJ1vQ9FjwIG_ngZcKFMg&oe=6A898665"}, {"file_name": "$R81V725.png", "id": "2720695481426567", "image_type": "APP_IMG_ICON", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75262743_2720695484759900_604086922326600035_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4MTCceR7KigQ7kNvwG989VB&_nc_oc=AdpJxnOCXMMUcAsDH2KUkZLKRfrJH9I8CTbEFnASqDVBIqRvWrqG23KpQc_hGWuyTSU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGT9KLpgxcrQEbwQ-7Q2QQBF4dfM7fpYkgy-CGFH6flGg&oe=6A89854D"}, {"file_name": "$RQ3SN6U.png", "id": "1552311425628973", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982519_1552311428962306_1218130395049083834_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=urfsbveJpZ4Q7kNvwFzGIY1&_nc_oc=AdoIxKz-Kbkh4dROTcgqcaGsXmK8nfMxdne56EiJ1H19f4VZyycfvzhJqBimdj7vGuQ&_nc_zt=3&_nc_ht=
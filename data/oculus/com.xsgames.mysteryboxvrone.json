CKYJOkXcxZT95YrUnkZ4-JKB9hPtlTJLNah-b4IfEgng&oe=6A525DC4"}, {"file_name": "5.png", "id": "467916352871409", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39003282_467916356204742_1871921057092171900_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fcfN-MiXhCUQ7kNvwGgzIQC&_nc_oc=AdrnUpJdU1pXj6MZ4eHvZz8-eu3gdb2nOB3FaiHgJ75H48J2u0B6SORBPRyurjd891k&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCdQuBiTebcm5bibLtolgEPLUtNxtNrwL7lwALMoM7Sgg&oe=6A524262"}, {"file_name": "3.png", "id": "1934382610375855", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974473_1934382613709188_7156337812617042679_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hoYXp5ZJ-W4Q7kNvwE6Xd5s&_nc_oc=AdrgbTulsCQriOGzeVfS4eSPd41hgsIapDCEQWAZOqbmrlmVjl_VqHBsKTNcl3SJ4X8&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQACEsBcam_VJV0JC9fv3rATrA7H5zyPWz9XUDQSJEm9YQ&oe=6A5264B3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape.png", "id": "1524760081483769", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974531_1524760084817102_6497712644828891067_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=11cBqJpksPgQ7kNvwGhCby7&_nc_oc=AdpC2G8tfCUQE24ufvRXqCBABMD6XeWiFCmhYreHoKRPDfsgXnrFUMaqH1Xtf-YW7uY&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD3wjXEynORbnpjUUM-skE-geX9Qqo3MfwEj8EJiUUhVw&oe=6A5263AF"}, "display_name": "Mystery Box VR: Hidden Secrets", "keywords": [], "long_description": " AN IMMERSIVE VR PUZZLE EXPERIENCE\nInteract with objects, handles, buttons, and wheels on each side. Crack enigmas and collect hidden puzzle tiles on a random side of the boxes.\n\nYou won't be able to compare reality with fiction.\n\n# DISCOVER INVENTIONS\nOnce you unlock all 8 boxes of a Level Pack, you can compose a puzzle and discover a brief history of an invention.\n\nIt's not always easy to escape the room, so use all your IQ to crack the riddles. There's a logic behind all of them, even where it seems it's not!\n\n# IMMERSIVE SOUNDTRACK\nPlay the game with your headphones to get immersed in this amazing adventure.\n\n# HINTS\nGot stuck on some enigma? No worries, you can still get a helpful hint! You can also get in touch with me in case you really can't make it through a riddle, I'll be glad to help ;)\n\n# MULTILANGUAGE\nAvailable in English, French, Italian, German, Spanish, Russian, and Japanese.\n\nThe game language will change automatically based on the language settings of your device", "short_description": "A VR escape room game where you have to solve intriguing riddles to open boxes and discover nice stories about popular inventions!"}, {"images": {"nodes": [{"file_name": "$R36BSY5.png", "id": "3678762505771822", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031430_3678762509105155_2151975047074617165_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LQYj8U7J2C4Q7kNvwH0g1Y0&_nc_oc=Adrf9-RlKjw0Ndw8YndvOsqY9_WhCOUtYZa3OZ--f0Mawk-V5F7EJ-XotnMxsAcGOLk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCW9F_MuZFQ9cUs5Hi2KVyUUyFJgo8Zm2rbeYzt26qTtw&oe=6A525FA5"}, {"file_name": "$R81V725.png", "id": "2720695481426567", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75262743_2720695484759900_604086922326600035_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dvrixJtRIhMQ7kNvwHVFPNj&_nc_oc=Adprjl4i-a90x9goJfJeT7HrwOtWTrOgSq6zUJmK2ngK4auNeVsoN7m-2yBmRuuDszc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBLJZW48F_iafkmU55B9m_Mg-x5Vb9jFlo097JUQCc5kA&oe=6A525E8D"}, {"file_name": "$RQ3SN6U.png", "id": "1552311425628973", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982519_1552311428962306_1218130395049083834_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O_sHojBB8OkQ7kNvwGpMw4s&_nc_oc=AdoprVgJSDS4Pq5-ZCtT1C_zmVrmXZMceFxBVsAUVluv_OQnt2Zp4b_adYZeN5xtqlI&_nc_zt=3&_nc_ht=
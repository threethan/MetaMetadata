yo2OOe28m31f_m1DWx3opdiEUbN1dLmz-uKuOhUU2eJA&oe=69C7B804"}, {"file_name": "5.png", "id": "467916352871409", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/39003282_467916356204742_1871921057092171900_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PK8aExZtfnQQ7kNvwEJZ6_N&_nc_oc=AdrC6xKrvW_C9bhCPmtE59tbMcKam-MXcXsJU7QfbXC88sWZ7JMvMXt5Oem6Nt5wbuQ&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwRKsPKi4EzLfNKCEOu98ca5J4Qi5Y0X6RNXGRN3NdbiQ&oe=69C7D4E2"}, {"file_name": "3.png", "id": "1934382610375855", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/38974473_1934382613709188_7156337812617042679_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SkNDWoJshjsQ7kNvwEZuhbk&_nc_oc=Ado679WetU29jgUpO83zTyOeERXO40bMRP-hzg_faNS4gd0Io23xvweJWwrgD304Y4Y&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzMYcklUBq_jkdlW2EyLKw3qSSmQab2Jg9yrWp8RGbA1Q&oe=69C7BEF3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape.png", "id": "1524760081483769", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/38974531_1524760084817102_6497712644828891067_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=22CibaUnaaEQ7kNvwG3XTfR&_nc_oc=AdqF_GohK4pzMywC_gGKq9dAy6AUBLQop1srJW1zN34ZluqtReALm7QXRGQiKqIB5LU&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxyyfG5UNTelbTdst6usYUrhc110zkT_nPAtuDShvRQ7Q&oe=69C7BDEF"}, "display_name": "Mystery Box VR: Hidden Secrets", "keywords": [], "long_description": " AN IMMERSIVE VR PUZZLE EXPERIENCE\nInteract with objects, handles, buttons, and wheels on each side. Crack enigmas and collect hidden puzzle tiles on a random side of the boxes.\n\nYou won't be able to compare reality with fiction.\n\n# DISCOVER INVENTIONS\nOnce you unlock all 8 boxes of a Level Pack, you can compose a puzzle and discover a brief history of an invention.\n\nIt's not always easy to escape the room, so use all your IQ to crack the riddles. There's a logic behind all of them, even where it seems it's not!\n\n# IMMERSIVE SOUNDTRACK\nPlay the game with your headphones to get immersed in this amazing adventure.\n\n# HINTS\nGot stuck on some enigma? No worries, you can still get a helpful hint! You can also get in touch with me in case you really can't make it through a riddle, I'll be glad to help ;)\n\n# MULTILANGUAGE\nAvailable in English, French, Italian, German, Spanish, Russian, and Japanese.\n\nThe game language will change automatically based on the language settings of your device", "short_description": "A VR escape room game where you have to solve intriguing riddles to open boxes and discover nice stories about popular inventions!"}, {"images": {"nodes": [{"file_name": "$R36BSY5.png", "id": "3678762505771822", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/39031430_3678762509105155_2151975047074617165_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kMYLg0x_3NgQ7kNvwE9cNkv&_nc_oc=AdpeGAEpcEDwdKU-Yqs2yi2C9kF5-BjDrDH8XhNwNkANu_bUZgOyuyi0jvR1JhViJCI&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzQCEJEDCPp1K65N2XRV_ZuEUnkIFGHOo9az9C7JtIwaA&oe=69C7B9E5"}, {"file_name": "$R81V725.png", "id": "2720695481426567", "image_type": "APP_IMG_ICON", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/75262743_2720695484759900_604086922326600035_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b9g5szjVON0Q7kNvwHPHglD&_nc_oc=AdrIFt5OPSsgco1iZvBkihVfE98m4rCvezEgsyow3qsjM-mfL_N_3Rb-EChbOgvqoHw&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzVBjFdrnZ7w_VoE4mOvsgin_AIuwuteq1rcLpEKk2S3Q&oe=69C7B8CD"}, {"file_name": "$RQ3SN6U.png", "id": "1552311425628973", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/38982519_1552311428962306_1218130395049083834_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sKuaDkgnPesQ7kNvwFT0o21&_nc_oc=AdpmK7ujFl9JKo7RKPC14QG6rZXNJ4Vfon6qb3xGgamQW8QeEICwSJK7sGz7sFSfvTU&_nc_zt=3&_nc_ht=
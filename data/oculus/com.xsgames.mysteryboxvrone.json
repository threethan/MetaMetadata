nc_ss=7f20f&oh=00_AQKQUZUkcHjVmf5hOuDKWcdZg96u3uvW9O1sFHVbW_rtig&oe=6AAEA6C4"}, {"file_name": "5.png", "id": "467916352871409", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/39003282_467916356204742_1871921057092171900_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rBAQ3HTNJl4Q7kNvwGJB_5F&_nc_oc=AdrQkaZghtlru-iOhoj6Ug8qgxvxTV5LIf92TPF7sNKqVw_zwXBATXwt6HGsEt5XAUU&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLtZh_7JNdnB5ZJrwxOmtyDlRrpmsZ04B4hubtQmfNSFQ&oe=6AAE8B62"}, {"file_name": "3.png", "id": "1934382610375855", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/38974473_1934382613709188_7156337812617042679_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1MIgXfjqlbwQ7kNvwFqL6FO&_nc_oc=AdpffJ2nwz-nkxyagEbdy8-r8m0yjQq_rqRt6I-vYuJsFVBHyQzaspr-pkqwL-3a-qo&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQItvStcCVEhTir1K11r1F4V4_Oo6q4LUtzGuUg9kbX2RQ&oe=6AAEADB3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape.png", "id": "1524760081483769", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/38974531_1524760084817102_6497712644828891067_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V7ybxxtlMXsQ7kNvwEMZEN1&_nc_oc=AdpHLH6icAWhV4VVsUBL06jV2hoh2di8PZzO9Fi_oJQDRfN_ushra6jJjS7mWHoSsZ4&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKieidAkbxWKfo70WfLSDtmorOVwjEsapmEU7h7cYXWqQ&oe=6AAEACAF"}, "display_name": "Mystery Box VR: Hidden Secrets", "keywords": [], "long_description": " AN IMMERSIVE VR PUZZLE EXPERIENCE\nInteract with objects, handles, buttons, and wheels on each side. Crack enigmas and collect hidden puzzle tiles on a random side of the boxes.\n\nYou won't be able to compare reality with fiction.\n\n# DISCOVER INVENTIONS\nOnce you unlock all 8 boxes of a Level Pack, you can compose a puzzle and discover a brief history of an invention.\n\nIt's not always easy to escape the room, so use all your IQ to crack the riddles. There's a logic behind all of them, even where it seems it's not!\n\n# IMMERSIVE SOUNDTRACK\nPlay the game with your headphones to get immersed in this amazing adventure.\n\n# HINTS\nGot stuck on some enigma? No worries, you can still get a helpful hint! You can also get in touch with me in case you really can't make it through a riddle, I'll be glad to help ;)\n\n# MULTILANGUAGE\nAvailable in English, French, Italian, German, Spanish, Russian, and Japanese.\n\nThe game language will change automatically based on the language settings of your device", "short_description": "A VR escape room game where you have to solve intriguing riddles to open boxes and discover nice stories about popular inventions!"}, {"images": {"nodes": [{"file_name": "$R36BSY5.png", "id": "3678762505771822", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/39031430_3678762509105155_2151975047074617165_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OrJrJX8A_n8Q7kNvwEeRzJ6&_nc_oc=AdoKc0u4nLiAC2PuGHoxMPf-XVoNPwXlNOLaiK7Zc2tLNAktMPctbAZEvrE2VM4MXoM&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIEWMEWmS9Immob1WVq6Zt6SrC1U4NIIsZ4rNGoM4phLQ&oe=6AAEA8A5"}, {"file_name": "$R81V725.png", "id": "2720695481426567", "image_type": "APP_IMG_ICON", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/75262743_2720695484759900_604086922326600035_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SFtGowUZtxIQ7kNvwFuVDfB&_nc_oc=AdrACqvgDBiRHKHiMYHP2wf7O97gsOx73zN5uZ2Q1h8L_hFxg5ulGMDmG0SlaPSaSNk&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKmAWONY9NFMpiIrYnFnqfQ0MAYgp3FZIz6yzjODHv0iA&oe=6AAEA78D"}, {"file_name": "$RQ3SN6U.png", "id": "1552311425628973", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/38982519_1552311428962306_1218130395049083834_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OmJh96gD-6wQ7kNvwEi4_kT&_nc_oc=AdqVzqKlL7rYIQlW23JplVSmnjBn4jiP92jw_Nsl51L9NVBg1w9iGnKxs6Rk
6XiqiCUlHZTfPEIT-nZ2Xab_lA66pQFnHj1KZpKIbRsw&oe=6A146744"}, {"file_name": "5.png", "id": "467916352871409", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39003282_467916356204742_1871921057092171900_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g5kt4o103m0Q7kNvwFVhMiZ&_nc_oc=AdrD00-zx1v-pDSb6Eo2UT5NgX1W-6EQ1MJrr0LPpXq1mxOHj2bOxw8c-CEYUDu-pkM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af53J9IlFYaeub5FtVxgvFaESK7RsX8WoyTI4wAQ7zCi4A&oe=6A144BE2"}, {"file_name": "3.png", "id": "1934382610375855", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974473_1934382613709188_7156337812617042679_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k6lKK9C5B3sQ7kNvwGobb74&_nc_oc=AdpsKa0Hfdp-YvmcU3YQU5ge87Ejw9-viKgPC6p9LnJPmP8P9YQxu85IKhdCAhEvF6w&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7qikmpWwukcssE9WATk-eIBTCArkmNzOx8IfZx7EOZNw&oe=6A146E33"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape.png", "id": "1524760081483769", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974531_1524760084817102_6497712644828891067_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5RAjU1MEJ1EQ7kNvwHUgS0o&_nc_oc=AdrxJ8dW4CmjA1Wnn7T4x3Q2NC6IqPkXGJ2NcTbMp9movNnhCnL12-h5MxTi789mVj0&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6Pad-wI9PShKc9OIEOKQ7yiAYmbGSNYX60h2HFoVfTqQ&oe=6A146D2F"}, "display_name": "Mystery Box VR: Hidden Secrets", "keywords": [], "long_description": " AN IMMERSIVE VR PUZZLE EXPERIENCE\nInteract with objects, handles, buttons, and wheels on each side. Crack enigmas and collect hidden puzzle tiles on a random side of the boxes.\n\nYou won't be able to compare reality with fiction.\n\n# DISCOVER INVENTIONS\nOnce you unlock all 8 boxes of a Level Pack, you can compose a puzzle and discover a brief history of an invention.\n\nIt's not always easy to escape the room, so use all your IQ to crack the riddles. There's a logic behind all of them, even where it seems it's not!\n\n# IMMERSIVE SOUNDTRACK\nPlay the game with your headphones to get immersed in this amazing adventure.\n\n# HINTS\nGot stuck on some enigma? No worries, you can still get a helpful hint! You can also get in touch with me in case you really can't make it through a riddle, I'll be glad to help ;)\n\n# MULTILANGUAGE\nAvailable in English, French, Italian, German, Spanish, Russian, and Japanese.\n\nThe game language will change automatically based on the language settings of your device", "short_description": "A VR escape room game where you have to solve intriguing riddles to open boxes and discover nice stories about popular inventions!"}, {"images": {"nodes": [{"file_name": "$R36BSY5.png", "id": "3678762505771822", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031430_3678762509105155_2151975047074617165_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h4l9p0LZF4UQ7kNvwFI7eOW&_nc_oc=AdrsgvVOEhaMU9KY8qgfdfpNEf6su3hldwTn4mB7_zRQMLOU1ycmecOriEGzjnksU50&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5aQk_4N3bBp6msOJ_SyR1OVmYVi-qFUvF43xvTwiK9ZA&oe=6A146925"}, {"file_name": "$R81V725.png", "id": "2720695481426567", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75262743_2720695484759900_604086922326600035_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LUI23E8JQUYQ7kNvwFYgNCC&_nc_oc=Adq-zqVvQuiIqRLAfCjiJdeLUAl0654Qe3z77pKnMngyOQ3Fok_9AngK3fxP9aTLtGc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5k7kU-b790gjOE13jJJUtDrlv1PHxfncvRm99118nsHw&oe=6A14680D"}, {"file_name": "$RQ3SN6U.png", "id": "1552311425628973", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982519_1552311428962306_1218130395049083834_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A6A1j3G1e6kQ7kNvwGkyLvu&_nc_oc=AdoX1iPt6qsATgMRQvtrBMaO2zoNCMUgBwJhMF8VzI153SbRc9IdAtOwmAQkBkdbdnE&_nc_zt=3&_nc_ht=
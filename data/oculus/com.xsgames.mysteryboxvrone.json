90ZGACWnN44bXWamdQ13df1ilHRMUmoJgE0oXLRbiSGQ&oe=6A316844"}, {"file_name": "5.png", "id": "467916352871409", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39003282_467916356204742_1871921057092171900_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qZ2JqO2gijoQ7kNvwFbOz6Y&_nc_oc=AdrZQtbz-lOQbCG0vtui41YCWBmyJuuQQhn7zOwJFB-w2F9hhho1M7HBAum6aQPh5Yo&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8s_dDPP5rkkB4Z3pVERVX4aiXxg00TtD5qMma6D_MkBw&oe=6A314CE2"}, {"file_name": "3.png", "id": "1934382610375855", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974473_1934382613709188_7156337812617042679_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hZHQ2FjHNqQQ7kNvwHeBWtO&_nc_oc=AdqD-5EnB7A8CMajPeJxTAbfvjKYLJGbBsmvbaCDWfdlltQ53NmNTSSqvbPVTzcNdbE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_RTaOIIg0A38AMSFX070En5X-KX8MF04aaM7jHyOHlxQ&oe=6A316F33"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape.png", "id": "1524760081483769", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974531_1524760084817102_6497712644828891067_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uPRBnKxWONgQ7kNvwGqQid1&_nc_oc=AdouD7EjaPDpztkS2kU8P9S8cxBC1hIf0n7RNapUuaO7yq7p1kMVAHzwrFjjh4wEzZs&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-YarDsQaJbo5y5atOcQKwqc97j0lQOh9zo4wgl_FkiSw&oe=6A316E2F"}, "display_name": "Mystery Box VR: Hidden Secrets", "keywords": [], "long_description": " AN IMMERSIVE VR PUZZLE EXPERIENCE\nInteract with objects, handles, buttons, and wheels on each side. Crack enigmas and collect hidden puzzle tiles on a random side of the boxes.\n\nYou won't be able to compare reality with fiction.\n\n# DISCOVER INVENTIONS\nOnce you unlock all 8 boxes of a Level Pack, you can compose a puzzle and discover a brief history of an invention.\n\nIt's not always easy to escape the room, so use all your IQ to crack the riddles. There's a logic behind all of them, even where it seems it's not!\n\n# IMMERSIVE SOUNDTRACK\nPlay the game with your headphones to get immersed in this amazing adventure.\n\n# HINTS\nGot stuck on some enigma? No worries, you can still get a helpful hint! You can also get in touch with me in case you really can't make it through a riddle, I'll be glad to help ;)\n\n# MULTILANGUAGE\nAvailable in English, French, Italian, German, Spanish, Russian, and Japanese.\n\nThe game language will change automatically based on the language settings of your device", "short_description": "A VR escape room game where you have to solve intriguing riddles to open boxes and discover nice stories about popular inventions!"}, {"images": {"nodes": [{"file_name": "$R36BSY5.png", "id": "3678762505771822", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031430_3678762509105155_2151975047074617165_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IiFbLjG75AQQ7kNvwHGBkup&_nc_oc=AdqiO266UmE8uu8jlX9BE_f5mCNYcZEH-3Sv5xJLa4uEnOdotLhdMLE5gcIQ2jgHxqk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9WUDQjEfYs5NpIlERX_D7bcR1lsJ3z23Vg0linYErOvg&oe=6A316A25"}, {"file_name": "$R81V725.png", "id": "2720695481426567", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75262743_2720695484759900_604086922326600035_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6Mvk1ln67i8Q7kNvwGv5QvS&_nc_oc=Adrgpv719Ksb9ooDyMg2XpUh5LOsyPcRTv_rSZ3gDx9Nc3owuPnK8qIz7n6FA4pdbuU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_lR1qO583XB2d7igZxj6_81U8KkSTbdKR9q2uFv-uh-Q&oe=6A31690D"}, {"file_name": "$RQ3SN6U.png", "id": "1552311425628973", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982519_1552311428962306_1218130395049083834_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9ts5AtAVlnYQ7kNvwFKXzEJ&_nc_oc=AdrHwUE2JZfovU4FFn49CU15ADlqT55Yr5BH5AQYlnBAoTRhBRZvYgu72O8iVTN30Ao&_nc_zt=3&_nc_ht=
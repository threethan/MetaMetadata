E7h8_ORg9JLk0R-Unxs4j0p9yIDp5DY_-VmGxsDfg34g&oe=6A735344"}, {"file_name": "5.png", "id": "467916352871409", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39003282_467916356204742_1871921057092171900_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2qdTpt2K4QwQ7kNvwFDMCP-&_nc_oc=AdqN9FxgtC5Jvpj5WIxdB2AzKReAd5MKRf1UaQKJvBOYGwME2K067G8Dli8xaBG98Os&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHKR1c7q5YW0zHsXzVkHETduXxl7PyxLnSQ_z8psFB-wg&oe=6A7337E2"}, {"file_name": "3.png", "id": "1934382610375855", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974473_1934382613709188_7156337812617042679_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ifFPPSONnIkQ7kNvwFPR8rZ&_nc_oc=AdpT_n6leWTGKAASeW3hDL6YZnZ-CpBuL0SSKe_MVw9sO9LEPfLlI0GovnSmV0N7Xow&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEZjrRfg-LY4QeubrH7TdGoiBMHVp4os9cvofhE4bVItA&oe=6A7321F3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape.png", "id": "1524760081483769", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974531_1524760084817102_6497712644828891067_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M3tT88uFps4Q7kNvwFIXRp7&_nc_oc=Adrcvztw5SBDTXHVzCjyVux-xOSmqkKH9HNWcKFpLjItw8iEsJQ809M5yX1J1R3rzkQ&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEBqTQcIg3Bx--jWHDkRdel4rIKXITOEEw5Vw3irvEQkA&oe=6A7320EF"}, "display_name": "Mystery Box VR: Hidden Secrets", "keywords": [], "long_description": " AN IMMERSIVE VR PUZZLE EXPERIENCE\nInteract with objects, handles, buttons, and wheels on each side. Crack enigmas and collect hidden puzzle tiles on a random side of the boxes.\n\nYou won't be able to compare reality with fiction.\n\n# DISCOVER INVENTIONS\nOnce you unlock all 8 boxes of a Level Pack, you can compose a puzzle and discover a brief history of an invention.\n\nIt's not always easy to escape the room, so use all your IQ to crack the riddles. There's a logic behind all of them, even where it seems it's not!\n\n# IMMERSIVE SOUNDTRACK\nPlay the game with your headphones to get immersed in this amazing adventure.\n\n# HINTS\nGot stuck on some enigma? No worries, you can still get a helpful hint! You can also get in touch with me in case you really can't make it through a riddle, I'll be glad to help ;)\n\n# MULTILANGUAGE\nAvailable in English, French, Italian, German, Spanish, Russian, and Japanese.\n\nThe game language will change automatically based on the language settings of your device", "short_description": "A VR escape room game where you have to solve intriguing riddles to open boxes and discover nice stories about popular inventions!"}, {"images": {"nodes": [{"file_name": "$R36BSY5.png", "id": "3678762505771822", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031430_3678762509105155_2151975047074617165_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-SQd8dFjRWMQ7kNvwHd_o8k&_nc_oc=Adp_CNiM7yQkt1TIauAk1jL5pWBAVMvc4AdtkYtf2_sQKZ-DSfleGK2G9vv12gUw3hs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEZVSAN6muhQHzzhqZ2muZfjLvG0G1stylQO749n7xAvA&oe=6A735525"}, {"file_name": "$R81V725.png", "id": "2720695481426567", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75262743_2720695484759900_604086922326600035_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T0TQXPqI-cMQ7kNvwE0oCJU&_nc_oc=Adoi__mgZ3C_aM026NNIl8YFsgSrc1FqIXO_wY1BxhtwDX4gk-MlQJBl52XI8HJmnBI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGYtGnMWVQMFytD19rL3EqILfQQfUQGmbS7hPmPjHlhzA&oe=6A73540D"}, {"file_name": "$RQ3SN6U.png", "id": "1552311425628973", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982519_1552311428962306_1218130395049083834_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T47td3dzGmwQ7kNvwGSLpO4&_nc_oc=AdpzjWm3hKlSQPsT7l45MdGBRBit3YNQOSlHI-2RBHFGJgqq05SBzgdQvwGPu4WfD98&_nc_zt=3&_nc_ht=
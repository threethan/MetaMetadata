oculuscdn.com/v/t64.5771-25/39003282_467916356204742_1871921057092171900_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nNIYA6z0BzgQ7kNvwFMYBHG&_nc_oc=Adn8A6Lz_oXjXsrb2G4pLp7_Owse93CRxB3YKonNmqqPQw_uXBuvleKE_GdwGg0OXVo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_Afxfh_3OF2wy03DU7ZlvUsFWVbw-uqGxhhsZFMnFUwqNlw&oe=69B55FE2"}, {"file_name": "3.png", "id": "1934382610375855", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974473_1934382613709188_7156337812617042679_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2C1EPFxSneAQ7kNvwEIUCY4&_nc_oc=AdlndKOXDKF9TV9InHoVozaKABvEvnWuNhNqmjIQXj2ZO26Sy_BpjWH-bY9A3O2uBCE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_Afx1OWIKVpVKvlNA34l-9__BqN59GDn3-xYrLjucVonppQ&oe=69B549F3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape.png", "id": "1524760081483769", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974531_1524760084817102_6497712644828891067_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Rs3FlcN1C9oQ7kNvwFPxMwe&_nc_oc=Admuc80kSeJhGNTUukKs_XSLAoXSlgld_uFQRnrF5zDgQOb44yWlNMURNemzRbmB_go&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfyYsUHlqoHnOVQzzKwU-93gyVJRmEZewb2Jxchyb6Ka8w&oe=69B548EF"}, "display_name": "Mystery Box VR: Hidden Secrets", "keywords": [], "long_description": " AN IMMERSIVE VR PUZZLE EXPERIENCE\nInteract with objects, handles, buttons, and wheels on each side. Crack enigmas and collect hidden puzzle tiles on a random side of the boxes.\n\nYou won't be able to compare reality with fiction.\n\n# DISCOVER INVENTIONS\nOnce you unlock all 8 boxes of a Level Pack, you can compose a puzzle and discover a brief history of an invention.\n\nIt's not always easy to escape the room, so use all your IQ to crack the riddles. There's a logic behind all of them, even where it seems it's not!\n\n# IMMERSIVE SOUNDTRACK\nPlay the game with your headphones to get immersed in this amazing adventure.\n\n# HINTS\nGot stuck on some enigma? No worries, you can still get a helpful hint! You can also get in touch with me in case you really can't make it through a riddle, I'll be glad to help ;)\n\n# MULTILANGUAGE\nAvailable in English, French, Italian, German, Spanish, Russian, and Japanese.\n\nThe game language will change automatically based on the language settings of your device", "short_description": "A VR escape room game where you have to solve intriguing riddles to open boxes and discover nice stories about popular inventions!"}, {"images": {"nodes": [{"file_name": "$R36BSY5.png", "id": "3678762505771822", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031430_3678762509105155_2151975047074617165_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NzpCYikjf_oQ7kNvwHD58ic&_nc_oc=Adkaia58w04sHlTDH91ZM779iHUWPEfr-ysdk1WtJPS7MQkuYEd2SqF6o3_jI_zBrks&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfzbWbJwAynLdJeJ7Z4-pklFj-BVc6nt8fuW5UsbomXQlQ&oe=69B544E5"}, {"file_name": "$R81V725.png", "id": "2720695481426567", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75262743_2720695484759900_604086922326600035_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d_4pHy4rrL4Q7kNvwElJdpk&_nc_oc=AdkkcUdxUEtqIG8gDhV3C3IK1vk-KJ8dtJgX82ulwO2hzM5O5iYdAz29prvLsjDp6ws&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfzM6xZTi0xlCf0vpvp60FvGMRkK3bjRxZYH1jzG2Wq4XA&oe=69B543CD"}, {"file_name": "$RQ3SN6U.png", "id": "1552311425628973", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982519_1552311428962306_1218130395049083834_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jVSTOEIJFbcQ7kNvwF-Fips&_nc_oc=AdlsDuwRdxNa-HNAq5OBGWU-Pqt0NwsYSesciZioyIX17IRQOnLrzAUtvlp5RCJPE2E&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfwJKxxn__JB5s7unYy9x3ogJzeqo87Ja9hh87CoUIodYw&oe=69B54F29"}, {"file_name": "38982645_1000853181732648_505551742782
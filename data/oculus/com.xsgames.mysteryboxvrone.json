DzO0zoMkueusyFmN0gdWDXy3N7rs9xmEuqFwn5wEbr6Q&oe=6A4FBAC4"}, {"file_name": "5.png", "id": "467916352871409", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39003282_467916356204742_1871921057092171900_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fcfN-MiXhCUQ7kNvwF-a2pq&_nc_oc=Adqi61U4kYYNLvxa-qqBVAFzdHvcVuUzvKG_tTtzl3HiGquWBVRIPXQHzHs8NiWtv4A&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCqrgepv7O7gultkumz5LOHPAmth5hUdhQ1A0V7PZX72g&oe=6A4F9F62"}, {"file_name": "3.png", "id": "1934382610375855", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974473_1934382613709188_7156337812617042679_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VJr4eAy-PkIQ7kNvwHT2mUC&_nc_oc=AdqG19bIEkBEixgZP9xLdo7lDDXL5EeUdjzTIfMlHH7rTBBJcEww2BtkG0CkjRP2Ajc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCS5UWg7pjwFsXgVscETODfvjDmFDoIiP58WDNoCbH3vg&oe=6A4FC1B3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape.png", "id": "1524760081483769", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974531_1524760084817102_6497712644828891067_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=11cBqJpksPgQ7kNvwGkfxJW&_nc_oc=Adqu6Gp33jdnLn2Libu7EuNoa_s-Zeks9vOZIWIOac11wKAiclopInsCXM8qlVx_xJI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDNGkTdclsIIxolIZSQjnvpponbwQyPa0jG8EXCPk90Fg&oe=6A4FC0AF"}, "display_name": "Mystery Box VR: Hidden Secrets", "keywords": [], "long_description": " AN IMMERSIVE VR PUZZLE EXPERIENCE\nInteract with objects, handles, buttons, and wheels on each side. Crack enigmas and collect hidden puzzle tiles on a random side of the boxes.\n\nYou won't be able to compare reality with fiction.\n\n# DISCOVER INVENTIONS\nOnce you unlock all 8 boxes of a Level Pack, you can compose a puzzle and discover a brief history of an invention.\n\nIt's not always easy to escape the room, so use all your IQ to crack the riddles. There's a logic behind all of them, even where it seems it's not!\n\n# IMMERSIVE SOUNDTRACK\nPlay the game with your headphones to get immersed in this amazing adventure.\n\n# HINTS\nGot stuck on some enigma? No worries, you can still get a helpful hint! You can also get in touch with me in case you really can't make it through a riddle, I'll be glad to help ;)\n\n# MULTILANGUAGE\nAvailable in English, French, Italian, German, Spanish, Russian, and Japanese.\n\nThe game language will change automatically based on the language settings of your device", "short_description": "A VR escape room game where you have to solve intriguing riddles to open boxes and discover nice stories about popular inventions!"}, {"images": {"nodes": [{"file_name": "$R36BSY5.png", "id": "3678762505771822", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031430_3678762509105155_2151975047074617165_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4Iv24_yp4KQQ7kNvwEOVXNM&_nc_oc=AdpFjnWJ-tAMaRfXpkoa1YHryh01CDfa194RZRkHr6YpZuZrm5EJKHaESYWD0cUA__o&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAl4sBm5_jQNpIgNfa0T3IcgD8zfArYD3LOBvAmXzc4fQ&oe=6A4FBCA5"}, {"file_name": "$R81V725.png", "id": "2720695481426567", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75262743_2720695484759900_604086922326600035_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_ekkGIZEWHIQ7kNvwFbVogE&_nc_oc=AdodwE8E7YVaJsDHQ4uLGa2QYfSZNW09Dc3o_FxWXtV0O8C0_SBdIRz2hJgxSuFwNUc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDGL0JqEljdQI1ufhiZX86Jor3-4dhrnJ3co_vL_YtlIQ&oe=6A4FBB8D"}, {"file_name": "$RQ3SN6U.png", "id": "1552311425628973", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982519_1552311428962306_1218130395049083834_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8jRv1LmKW48Q7kNvwGRu49k&_nc_oc=AdqL_YsUvxnvOxryuVP4q0gi2yBqHst6XF74tO1-FP63T7_CF3ugzYOQnG2JMny1l7g&_nc_zt=3&_nc_ht=
934382610375855", "uri": "https://scontent-dfw5-3.oculuscdn.com/v/t64.5771-25/38974473_1934382613709188_7156337812617042679_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xoQgwt4O4c4Q7kNvwFKBKsK&_nc_oc=AdpUzDel2U5rO_nA_h6DJ_kuTegvsKe1WTi58yHDgdvQN5jr6JcApMw12M-RI3rUtN8&_nc_zt=3&_nc_ht=scontent-dfw5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRuHBAbqfnaCY1YfSthvMYi0fi1Nyc50L-Q7AxOCTvgkQ&oe=6B0853B3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape_coverart.png", "id": "897861905346420", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38982672_897861908679753_3996777238831042692_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KG603g9zR-gQ7kNvwFt3NA7&_nc_oc=AdqrGyzCUroYTQWA-KcZhZGEZ7WJ_XjjA2bYsig2D4pgZYunh2KXeGpF8k6ArHn-K9g&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTonvuTs1yvfpAH4VlSDg7Ik4XWusJkcvd57hdLWNLiOA&oe=6B08562B"}, "display_name": "Mystery Box VR: Hidden Secrets Escape", "keywords": ["puzzle", "escape", "room", "trivia", "brainteaser"], "long_description": "# AN IMMERSIVE VR PUZZLE EXPERIENCE\nInteract with objects, handles, buttons, and wheels on each side. Crack enigmas and collect hidden puzzle tiles on a random side of the boxes.\n\nYou won't be able to compare reality with fiction.\n\n# DISCOVER INVENTIONS\nOnce you unlock all 8 boxes of a Level Pack, you can compose a puzzle and discover a brief history of an invention.\n\nIt's not always easy to escape the room, so use all your IQ to crack the riddles. There's a logic behind all of them, even where it seems it's not!\n\n# IMMERSIVE SOUNDTRACK\nPlay the game with your headphones to get immersed in this amazing adventure.\n\n# HINTS\nGot stuck on some enigma? No worries, you can still get a helpful hint! You can also get in touch with me in case you really can't make it through a riddle, I'll be glad to help ;)\n\n# MULTILANGUAGE\nAvailable in English, French, Italian, German, Spanish, Russian, and Japanese.\n\nThe game language will change automatically based on the language settings of your device", "short_description": "Crack awesome puzzles around many boxes, and discover the history of the world's most popular inventions!"}, {"images": {"nodes": [{"file_name": "logoTransparent.png", "id": "3812261432362188", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/38974562_3812261435695521_5176404439574971225_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VmBsVzhj_qUQ7kNvwFASCZe&_nc_oc=AdrfUJHR2vCaBrjqfAUVwISaFfK3kIG6ag5e4cMafdF9uyQETo2Kbhgwo-79EBlEEJU&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSZp0lJJh0gP5k-cB6s-qjBI2QNKDzUHobhQv4l29it0Q&oe=6B0843D6"}, {"file_name": "portrait_coverart.png", "id": "1953342038506987", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/38982581_1953342045173653_4906879878373922307_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WewV9DpMgdcQ7kNvwGAnjAn&_nc_oc=AdqWoLL7Vv0S4YTPmuJ9i_wg91IgSh9Zqxg1huAXIaXLK60jNwnGD6uiwkKjJIGCDAc&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTRU1RBgSXGBmIC4xlqnkvxv2E4IAmDKW7TkRoHMfUIxQ&oe=6B0864FD"}, {"file_name": "landscape_coverart.png", "id": "1300403051139202", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/75462955_1300403057805868_2288822001409671177_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Fe8n1LMIWJwQ7kNvwFN7LdN&_nc_oc=Adre_ryKEy-TVSKeHBxRavEkxjISOHB4FViZe6-eA05DRY4ZLCXocQgr5uonAKbQkhc&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQMOrtRtLFvFG0UOBD1pGQwfGqwAoFdGn_bUL_blLzhDg&oe=6B0855A0"}, {"file_name": "square_coverart.png", "id": "914408640187392", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39036626_914408643520725_6339598287132
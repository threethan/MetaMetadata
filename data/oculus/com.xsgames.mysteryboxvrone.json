r6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGUtGKxBRc_U1m-XnrtuBZpJ46iNopLbEjLVXrRYriisQ&oe=6A859004"}, {"file_name": "5.png", "id": "467916352871409", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/39003282_467916356204742_1871921057092171900_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4TiyZ1VYdtQQ7kNvwEttufA&_nc_oc=AdrEptVODGBfLC7mN9XWqgkq9fg9H9-uKit0exeh7Ru7331raUimRYF7TScQgwYeMDM&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHI3sciZcyGPQteh4Jy8JrW2W1sI9otJfwVO8QiQv3zLg&oe=6A85ACE2"}, {"file_name": "3.png", "id": "1934382610375855", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/38974473_1934382613709188_7156337812617042679_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r9Ra2wldkIUQ7kNvwGSUEBI&_nc_oc=Adq8Cw27JXVoGQTOuEiiwuXGWcANp41PIIVcAP8PB0JELLMYnetS6zV-Fpi1fsdRKmg&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGj0Gb3-7WLOhyEBsTIIsbRRMGyYs4CJ7RTNwhb1ozPkA&oe=6A8596F3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape.png", "id": "1524760081483769", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/38974531_1524760084817102_6497712644828891067_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FKzC0Q58MMwQ7kNvwFUPcM0&_nc_oc=AdoxbchSu5_k3WWaV_AkC30h9zFlK5priwnhQyHtHUr6uxCOz3XmLrPA3k5t_-t66vk&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHhaUf2LSRcJb7wBGoLJLclH4Y8YqYULcM1YMi76EBoUw&oe=6A8595EF"}, "display_name": "Mystery Box VR: Hidden Secrets", "keywords": [], "long_description": " AN IMMERSIVE VR PUZZLE EXPERIENCE\nInteract with objects, handles, buttons, and wheels on each side. Crack enigmas and collect hidden puzzle tiles on a random side of the boxes.\n\nYou won't be able to compare reality with fiction.\n\n# DISCOVER INVENTIONS\nOnce you unlock all 8 boxes of a Level Pack, you can compose a puzzle and discover a brief history of an invention.\n\nIt's not always easy to escape the room, so use all your IQ to crack the riddles. There's a logic behind all of them, even where it seems it's not!\n\n# IMMERSIVE SOUNDTRACK\nPlay the game with your headphones to get immersed in this amazing adventure.\n\n# HINTS\nGot stuck on some enigma? No worries, you can still get a helpful hint! You can also get in touch with me in case you really can't make it through a riddle, I'll be glad to help ;)\n\n# MULTILANGUAGE\nAvailable in English, French, Italian, German, Spanish, Russian, and Japanese.\n\nThe game language will change automatically based on the language settings of your device", "short_description": "A VR escape room game where you have to solve intriguing riddles to open boxes and discover nice stories about popular inventions!"}, {"images": {"nodes": [{"file_name": "$R36BSY5.png", "id": "3678762505771822", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/39031430_3678762509105155_2151975047074617165_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kDdeyixfcfYQ7kNvwH1Wxln&_nc_oc=AdrCOYK4GIKXqtJqo4OSmeJk86BQudE2WHgX47OzXdZYJuYJiTaY_gohCSR_d6Mjrws&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF-Zr2G8CKxO_EKF8xW95tUMGjcmXHPcFSr5AIX0y1YBQ&oe=6A8591E5"}, {"file_name": "$R81V725.png", "id": "2720695481426567", "image_type": "APP_IMG_ICON", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/75262743_2720695484759900_604086922326600035_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nJZHQ2He9JEQ7kNvwFzIiki&_nc_oc=AdqCqxnay40cyELz9xAfM89tSmqhBO4Rumc2rg9P7OVeW6jHR-kl_bBELUPoC2dQXK8&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEtVPHJ5IhJQ0Ezqa3bbTP6iKB8vbkM64cebzdhG7bF3Q&oe=6A8590CD"}, {"file_name": "$RQ3SN6U.png", "id": "1552311425628973", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/38982519_1552311428962306_1218130395049083834_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mM538yIBAvcQ7kNvwFmtiOT&_nc_oc=Adqr46q2bXIFeal-eIfleLrCAetr5esv8Z1A0GG
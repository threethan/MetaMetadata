6wlipuVjFGDEZTeZcZycafcRLovtsStZ3NdnBd69vdnA&oe=6A073844"}, {"file_name": "5.png", "id": "467916352871409", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39003282_467916356204742_1871921057092171900_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=X74pQESu-9cQ7kNvwFSWMqX&_nc_oc=AdrApP0AcYQOL04Le_8hIgDN7VHLaawyafIuqcSoFzT92wuaeg5Reys2450X4tt7IBY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4cmAxiMVB-spapHDbhb7NS7DzbY3FE6uqbd107TuoljQ&oe=6A071CE2"}, {"file_name": "3.png", "id": "1934382610375855", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974473_1934382613709188_7156337812617042679_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CYonODTUnqoQ7kNvwEvU7Q9&_nc_oc=AdptOkBWxERfnbQBrY7wG-dfMW_TbaJiVdktoqy2lPriENofg0A6VnO0ULTmlJ3mW_o&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6w7L2_s1xOLoz3-6atvHs-rlv57dhBfBcj83oKjPdMLg&oe=6A073F33"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape.png", "id": "1524760081483769", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974531_1524760084817102_6497712644828891067_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FRfKSJwkP7cQ7kNvwE5_6T4&_nc_oc=AdqipzvMNNk88RFARPcJdh-3cG9qxfIPJqoczm12OuNw9hWr0xoHvP3KUdCT7HffIpA&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7culHJ239MAGaV4GrX_0DjHA1Pi-HptM-K9dTILDeUhg&oe=6A073E2F"}, "display_name": "Mystery Box VR: Hidden Secrets", "keywords": [], "long_description": " AN IMMERSIVE VR PUZZLE EXPERIENCE\nInteract with objects, handles, buttons, and wheels on each side. Crack enigmas and collect hidden puzzle tiles on a random side of the boxes.\n\nYou won't be able to compare reality with fiction.\n\n# DISCOVER INVENTIONS\nOnce you unlock all 8 boxes of a Level Pack, you can compose a puzzle and discover a brief history of an invention.\n\nIt's not always easy to escape the room, so use all your IQ to crack the riddles. There's a logic behind all of them, even where it seems it's not!\n\n# IMMERSIVE SOUNDTRACK\nPlay the game with your headphones to get immersed in this amazing adventure.\n\n# HINTS\nGot stuck on some enigma? No worries, you can still get a helpful hint! You can also get in touch with me in case you really can't make it through a riddle, I'll be glad to help ;)\n\n# MULTILANGUAGE\nAvailable in English, French, Italian, German, Spanish, Russian, and Japanese.\n\nThe game language will change automatically based on the language settings of your device", "short_description": "A VR escape room game where you have to solve intriguing riddles to open boxes and discover nice stories about popular inventions!"}, {"images": {"nodes": [{"file_name": "$R36BSY5.png", "id": "3678762505771822", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031430_3678762509105155_2151975047074617165_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YWUdCqHWNNgQ7kNvwEXvd7A&_nc_oc=Ado_5LXXWg_2GYCE5B29Stsn0uD4RPp-nhHIZOZMcSKnYIhLH8ML7aeN5BI90KXUTQE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af46VWTK9T5DWAtgb3AIJUDpOinOsvSvpRdTM83PTeo3mw&oe=6A073A25"}, {"file_name": "$R81V725.png", "id": "2720695481426567", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75262743_2720695484759900_604086922326600035_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E7rNyCNEymcQ7kNvwHM4d08&_nc_oc=AdqBG4bf0yVSF8flLlYfX7MdBHgtOe5A8lNC7lCLClbQyIIHokB9YqRx4kEsSY6tN44&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6bdiT3c8Uz5f98FdbuFPBkMJpq-42g7LVXiN4QyCCP9w&oe=6A07390D"}, {"file_name": "$RQ3SN6U.png", "id": "1552311425628973", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982519_1552311428962306_1218130395049083834_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gW_pnxgRd_QQ7kNvwEYeEOB&_nc_oc=Adp9A6W7etMXBovUx9rlWzWTJGyB2__W0OevwAgkKYrZZ95wdhZm-QTIYNWFlYqXpDA&_nc_zt=3&_nc_ht=
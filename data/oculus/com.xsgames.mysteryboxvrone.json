CkKBLrLXlrjO_x4KRcMF7seYB2h4kJPgLZV1qV_cIlMA&oe=6A6F2684"}, {"file_name": "5.png", "id": "467916352871409", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39003282_467916356204742_1871921057092171900_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-2-C91txbOEQ7kNvwFpN9C_&_nc_oc=AdpyGZa31uleOiTpZcCNMAl-1oFrdIK8tIRrebrURxjDZaekhxTB9dmtUnuH531bGrY&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQALNzd4gZGsSVV_Xdk4krE7yNUeupfLgZcvacOrnKurjg&oe=6A6F4362"}, {"file_name": "3.png", "id": "1934382610375855", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974473_1934382613709188_7156337812617042679_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VBC8zhruEgwQ7kNvwHWH-4c&_nc_oc=Ado6fkISZayqj5qBb52HGUen9hoGlyzNXsuSeHcFq3PXQheJCWtoeIPVcbq4SWSmSiM&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAuZyo5cXwIxQuTx0AemC6nPb_Dg4AiJfVAsBMOFnwvGQ&oe=6A6F2D73"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape.png", "id": "1524760081483769", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974531_1524760084817102_6497712644828891067_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WOS5dWZWEr8Q7kNvwEz9lKC&_nc_oc=AdrJzufEEGnbweNLJ1anEEu7_7ZfDVv_cBjHDtmg7YQ0a9tmxwrjDSBJHY5jUO9lyTg&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAfVXltPYeh5Oawhensq-Y0NiJFWdMJYKhklQfgH3v-rw&oe=6A6F2C6F"}, "display_name": "Mystery Box VR: Hidden Secrets", "keywords": [], "long_description": " AN IMMERSIVE VR PUZZLE EXPERIENCE\nInteract with objects, handles, buttons, and wheels on each side. Crack enigmas and collect hidden puzzle tiles on a random side of the boxes.\n\nYou won't be able to compare reality with fiction.\n\n# DISCOVER INVENTIONS\nOnce you unlock all 8 boxes of a Level Pack, you can compose a puzzle and discover a brief history of an invention.\n\nIt's not always easy to escape the room, so use all your IQ to crack the riddles. There's a logic behind all of them, even where it seems it's not!\n\n# IMMERSIVE SOUNDTRACK\nPlay the game with your headphones to get immersed in this amazing adventure.\n\n# HINTS\nGot stuck on some enigma? No worries, you can still get a helpful hint! You can also get in touch with me in case you really can't make it through a riddle, I'll be glad to help ;)\n\n# MULTILANGUAGE\nAvailable in English, French, Italian, German, Spanish, Russian, and Japanese.\n\nThe game language will change automatically based on the language settings of your device", "short_description": "A VR escape room game where you have to solve intriguing riddles to open boxes and discover nice stories about popular inventions!"}, {"images": {"nodes": [{"file_name": "$R36BSY5.png", "id": "3678762505771822", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39031430_3678762509105155_2151975047074617165_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MTxXUwAJXE0Q7kNvwHn4Bjq&_nc_oc=Adqwbz-YN2L8hvssQC1yiG4KXoGk8jq62m0o8nxQAmjwB8-FzzP4zy8VqSaeS7DHt1Y&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCJI1TOx-TCXadkqR8xbcAnVEwEQCVv3tufrO0CUP2F-g&oe=6A6F2865"}, {"file_name": "$R81V725.png", "id": "2720695481426567", "image_type": "APP_IMG_ICON", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/75262743_2720695484759900_604086922326600035_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tRZFeSP8BWwQ7kNvwFYJ2J6&_nc_oc=AdqrFOUjlSMrLBTzZP2fj8lDzzgsJIzH4Y4JBc-onaZ-wA5PvIfbuSqqClceSlWltoY&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB3zgiZxNqmK2KmdXkgRdQx4tcLouc-BCh2AMQXJJtfmg&oe=6A6F274D"}, {"file_name": "$RQ3SN6U.png", "id": "1552311425628973", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38982519_1552311428962306_1218130395049083834_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1YaAl40-JyQQ7kNvwFkfzVf&_nc_oc=AdqE1rZjphMboQ23Kc62xcuZVqOlTyPe7BrZjDYSB7buJQ8I4tofhW1P-SY4KkWtWHg&_nc_zt=3&_nc_ht=
oculuscdn.com/v/t64.5771-25/39003282_467916356204742_1871921057092171900_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vugACsjBkwUQ7kNvwGyDZqG&_nc_oc=AdnHBuTfVNeQAh44H9MhTtLQqluw_zF2UsSD7f_01zl6Ai0khZf9hpfpF7RnwsC_PEk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_Afwxf9ZtlDGITUkaaHutlbAmGKXsmlmH5TmYhgQr2o7_tA&oe=69BBF762"}, {"file_name": "3.png", "id": "1934382610375855", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974473_1934382613709188_7156337812617042679_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0U0dVVF_GIkQ7kNvwHpZI9n&_nc_oc=Admv69C_Wi6UW3PEi878IlmjD8QZvzobvHl2A_EFkqWmrmPI65UsQZnCyvo4oyKPEaY&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfwpshwHTPkLuY9JjrFOXR5E89li1xiviqZCkqPDxyFRFA&oe=69BBE173"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape.png", "id": "1524760081483769", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974531_1524760084817102_6497712644828891067_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JD8agOtHBsgQ7kNvwFnHxpU&_nc_oc=AdmfGFX6civ6iyau9NZaHABJ9SFPfyMQvjZmH9p5vPG8nFo8WpXjQMy3cpJEkfh-Xoc&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfyH6TN3sH5uRHwgZQV_AZG5wJJ6Ilsd9vvNbgP5AuFNow&oe=69BBE06F"}, "display_name": "Mystery Box VR: Hidden Secrets", "keywords": [], "long_description": " AN IMMERSIVE VR PUZZLE EXPERIENCE\nInteract with objects, handles, buttons, and wheels on each side. Crack enigmas and collect hidden puzzle tiles on a random side of the boxes.\n\nYou won't be able to compare reality with fiction.\n\n# DISCOVER INVENTIONS\nOnce you unlock all 8 boxes of a Level Pack, you can compose a puzzle and discover a brief history of an invention.\n\nIt's not always easy to escape the room, so use all your IQ to crack the riddles. There's a logic behind all of them, even where it seems it's not!\n\n# IMMERSIVE SOUNDTRACK\nPlay the game with your headphones to get immersed in this amazing adventure.\n\n# HINTS\nGot stuck on some enigma? No worries, you can still get a helpful hint! You can also get in touch with me in case you really can't make it through a riddle, I'll be glad to help ;)\n\n# MULTILANGUAGE\nAvailable in English, French, Italian, German, Spanish, Russian, and Japanese.\n\nThe game language will change automatically based on the language settings of your device", "short_description": "A VR escape room game where you have to solve intriguing riddles to open boxes and discover nice stories about popular inventions!"}, {"images": {"nodes": [{"file_name": "$R36BSY5.png", "id": "3678762505771822", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031430_3678762509105155_2151975047074617165_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mbcVYu0WZHgQ7kNvwEa1CUX&_nc_oc=AdmxJJLERp16_sNuq6D-9lGgfJMkHIbwfZBC1fK4n3dhSbdA3KTPns0-NkvMp_uJKC8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfwrMh_lH2LlXYOvLL3NKO1RmgqtJzvgnMVUDbZu5wFwWw&oe=69BBDC65"}, {"file_name": "$R81V725.png", "id": "2720695481426567", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75262743_2720695484759900_604086922326600035_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JHo5dRyJK3EQ7kNvwFjNslK&_nc_oc=AdkpIQIKhE2txClcRSynoY7M5f--0tFbyRV_YFzfklbwKetSTXL27MZcG0eqNVJFH60&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfwqgJ0yS0QjD06T8QYtQvliVPJ2GU9OKvJe1DX0int2cw&oe=69BBDB4D"}, {"file_name": "$RQ3SN6U.png", "id": "1552311425628973", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982519_1552311428962306_1218130395049083834_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VAYu0C5WcR4Q7kNvwH--vG9&_nc_oc=AdlnbT8f0aUM1L8dAgUfEvXaOXHhOactpw7zTtXv6CxtTFl2lBBLgEaHg_uQQgvfF7A&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_Afxv-LaGp5XR49EjsFMgVH3uIo6wMZ86ARMY9-Cf_wbjOg&oe=69BBE6A9"}, {"file_name": "38982645_1000853181732648_505551742782
FtqkTkiVv5nmbzfbpBrOZ6JhEQCFQEa_fAt_VAb8Nprg&oe=6A707804"}, {"file_name": "5.png", "id": "467916352871409", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39003282_467916356204742_1871921057092171900_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-2-C91txbOEQ7kNvwG7mS7m&_nc_oc=AdrwQr-_qubgQJaBl2lgxhTqpvOhQea4uK47-5X0neCZf-mL2D6jwqLbNX1BKHVz0Fo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQER6Kj-AB70PEfWnECfe5W_rgh-2YePF55Jj_eOA6wXVw&oe=6A7094E2"}, {"file_name": "3.png", "id": "1934382610375855", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974473_1934382613709188_7156337812617042679_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VBC8zhruEgwQ7kNvwEYO6z1&_nc_oc=AdpqCeEJJGqJwaJxIpgPXi9zav-rCAXc7MIk1tdZnLzgg82SUUR1W6csMg1q7XNs1is&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFM5Bac8Uf-agUEWkwxHlFqUoZyt5jTA_IdW_j7BewsKw&oe=6A707EF3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape.png", "id": "1524760081483769", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974531_1524760084817102_6497712644828891067_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WOS5dWZWEr8Q7kNvwG7iv1e&_nc_oc=Adp2962EjfRakK5IzTrGreVgk6rTe33QYD5GLC1Ur3gXSVZcA5JJV604_4CzBsV5rrg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGj9p9ey-cRiqawfsBwPMOPZZHoGI7zSCkOsJmbY1LbTg&oe=6A707DEF"}, "display_name": "Mystery Box VR: Hidden Secrets", "keywords": [], "long_description": " AN IMMERSIVE VR PUZZLE EXPERIENCE\nInteract with objects, handles, buttons, and wheels on each side. Crack enigmas and collect hidden puzzle tiles on a random side of the boxes.\n\nYou won't be able to compare reality with fiction.\n\n# DISCOVER INVENTIONS\nOnce you unlock all 8 boxes of a Level Pack, you can compose a puzzle and discover a brief history of an invention.\n\nIt's not always easy to escape the room, so use all your IQ to crack the riddles. There's a logic behind all of them, even where it seems it's not!\n\n# IMMERSIVE SOUNDTRACK\nPlay the game with your headphones to get immersed in this amazing adventure.\n\n# HINTS\nGot stuck on some enigma? No worries, you can still get a helpful hint! You can also get in touch with me in case you really can't make it through a riddle, I'll be glad to help ;)\n\n# MULTILANGUAGE\nAvailable in English, French, Italian, German, Spanish, Russian, and Japanese.\n\nThe game language will change automatically based on the language settings of your device", "short_description": "A VR escape room game where you have to solve intriguing riddles to open boxes and discover nice stories about popular inventions!"}, {"images": {"nodes": [{"file_name": "$R36BSY5.png", "id": "3678762505771822", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031430_3678762509105155_2151975047074617165_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-SQd8dFjRWMQ7kNvwEw9XbH&_nc_oc=AdpEsD-XmFgoQ7QcGtmC0AmxlMj3uOurnN7nl_5y14mE4FfHqAiyMcQ_oMHVJeSH7qc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHacekkdMyYXfjGkTkHyflj8umwx8vDYP1RLrJxW4ws6w&oe=6A7079E5"}, {"file_name": "$R81V725.png", "id": "2720695481426567", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75262743_2720695484759900_604086922326600035_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tRZFeSP8BWwQ7kNvwH7HQp6&_nc_oc=Adr14VG9pXNu8dOa_acFSGkXQTkIyPAA-nXC5NAaKPP0xzgf7t6JuBm7OmRQDEWSVYI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEZ7BSk9Pt9JKVkF8B195Z0QDiF3sEJKF18-Q4T0r3I_g&oe=6A7078CD"}, {"file_name": "$RQ3SN6U.png", "id": "1552311425628973", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982519_1552311428962306_1218130395049083834_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T47td3dzGmwQ7kNvwEr_gta&_nc_oc=Ado7uwGeYPKFNkbsbHtdITbg2G8aD2fgAedv7YGd5E7PCSbUMFTm7ILI8ZA9Smog2Q8&_nc_zt=3&_nc_ht=
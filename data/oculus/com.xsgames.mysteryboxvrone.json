BkN0hXBieL9gUi-TtCuLUF-Lj9HGHZdhDmp8GDNgIc8A&oe=6A662444"}, {"file_name": "5.png", "id": "467916352871409", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39003282_467916356204742_1871921057092171900_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JRupKCU8BWAQ7kNvwEl1VB8&_nc_oc=AdqRcpoCAt_GkUAPC7LGYniHUmguLILZMqS-P5V8n_0t_ylS1YTG4mBPC7hQ76nK3D4&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB2Hdabh0Ghdysx7sCFeLlTMtr4gn8h8H5ohvmlYI3Cew&oe=6A6608E2"}, {"file_name": "3.png", "id": "1934382610375855", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974473_1934382613709188_7156337812617042679_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2upa2w1b5UcQ7kNvwHYtSB7&_nc_oc=AdrDwVPeWhvwwVJ0XLcokqdWtQAWNXemVP2Jn3KeoZ3SQndMPkkwJscqDtKAiv1YpIs&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBYqVYkqvyOEVDYHXSaKMqULQTU5uKQYDIHr6bwSWOxvA&oe=6A65F2F3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape.png", "id": "1524760081483769", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974531_1524760084817102_6497712644828891067_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mfpLlmCwN-cQ7kNvwF5SrOP&_nc_oc=AdqWULSNf2t2jiDxRGWyM6ZnweH0XcV2yAlPHJONTb5Qb46W8N8-QhnyGjDxE5ZDf1o&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC3_bnSkyrfHtdz8nfJnnvMRvZJWrEVoTE42ocXk52G0Q&oe=6A65F1EF"}, "display_name": "Mystery Box VR: Hidden Secrets", "keywords": [], "long_description": " AN IMMERSIVE VR PUZZLE EXPERIENCE\nInteract with objects, handles, buttons, and wheels on each side. Crack enigmas and collect hidden puzzle tiles on a random side of the boxes.\n\nYou won't be able to compare reality with fiction.\n\n# DISCOVER INVENTIONS\nOnce you unlock all 8 boxes of a Level Pack, you can compose a puzzle and discover a brief history of an invention.\n\nIt's not always easy to escape the room, so use all your IQ to crack the riddles. There's a logic behind all of them, even where it seems it's not!\n\n# IMMERSIVE SOUNDTRACK\nPlay the game with your headphones to get immersed in this amazing adventure.\n\n# HINTS\nGot stuck on some enigma? No worries, you can still get a helpful hint! You can also get in touch with me in case you really can't make it through a riddle, I'll be glad to help ;)\n\n# MULTILANGUAGE\nAvailable in English, French, Italian, German, Spanish, Russian, and Japanese.\n\nThe game language will change automatically based on the language settings of your device", "short_description": "A VR escape room game where you have to solve intriguing riddles to open boxes and discover nice stories about popular inventions!"}, {"images": {"nodes": [{"file_name": "$R36BSY5.png", "id": "3678762505771822", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39031430_3678762509105155_2151975047074617165_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NC0_7j53zcoQ7kNvwEQK4ZR&_nc_oc=Adqwba0G7wf3MIqDfM4PtAScEqlRyH1RAMw2XXi2UDuF7CbWhA7jryq-_G8xdIAR6cg&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDFqceDErPXASmdDkd5-upnFI4iTlE3lQqo3XUMiSgCgA&oe=6A662625"}, {"file_name": "$R81V725.png", "id": "2720695481426567", "image_type": "APP_IMG_ICON", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/75262743_2720695484759900_604086922326600035_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5_ss3kzpapAQ7kNvwGYgcbn&_nc_oc=AdoKIv2rFP_PPNGhTIETEGL8D3VLw-TIOA3eOLbL_OUnAwCDz0Id4piRyoMZVFIuHp4&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD08lchGGpKNGIgJ1TjC1lOmKLj-bA-D4DE5wYcC2vdwQ&oe=6A66250D"}, {"file_name": "$RQ3SN6U.png", "id": "1552311425628973", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38982519_1552311428962306_1218130395049083834_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VXUf-6D1lDsQ7kNvwE0yjDQ&_nc_oc=Adq5jsY8-BKKLU8UXDsSms5XdbwHAAyV6HWmEYL4ueAjXq5VWxiq5mWBRegw-RAxmqw&_nc_zt=3&_nc_ht=
NHTG6dChOFdaSN-4YTWJ6JRAb0a3a9Ft5Irc1_QYH2jQ&oe=6ACA5644"}, {"file_name": "5.png", "id": "467916352871409", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39003282_467916356204742_1871921057092171900_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sub-zabo9WUQ7kNvwGDzYqv&_nc_oc=AdoCCCkhGI0CIyQmbUQdAJs6jKETFZrOUcDwQKZZXr4E2QZ8netYQv_Mk4COio7bOP4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOC0wzx4hAF8rhN8R6TZf0A29uJHPoDsT_vgzjO5aBx0g&oe=6ACA7322"}, {"file_name": "3.png", "id": "1934382610375855", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974473_1934382613709188_7156337812617042679_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J8QjMCmRfGYQ7kNvwF-6db4&_nc_oc=AdoD78a2Acaifm7DSgcmwXEyTKPfu_F214r_AKcHnZq2qal8fF4oaE_T_1iHlLOpHcg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM4oWTh_ge1OUFvsWQsjWe0HUM-I3xYRg1iVjSkp_RFVQ&oe=6ACA5D33"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape.png", "id": "1524760081483769", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974531_1524760084817102_6497712644828891067_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r6RGmlq3zzcQ7kNvwH4WPnA&_nc_oc=AdoU32aqMB0yW19vk40j1jlkSVJHRKVTBitq0bNW61zzQoaAdLf1BI7GCR9wAs-9LSk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNiCdRD8CvcBQJJXsu6YGa5sWIwExwPMxQ35eJWmi7QPw&oe=6ACA5C2F"}, "display_name": "Mystery Box VR: Hidden Secrets", "keywords": [], "long_description": " AN IMMERSIVE VR PUZZLE EXPERIENCE\nInteract with objects, handles, buttons, and wheels on each side. Crack enigmas and collect hidden puzzle tiles on a random side of the boxes.\n\nYou won't be able to compare reality with fiction.\n\n# DISCOVER INVENTIONS\nOnce you unlock all 8 boxes of a Level Pack, you can compose a puzzle and discover a brief history of an invention.\n\nIt's not always easy to escape the room, so use all your IQ to crack the riddles. There's a logic behind all of them, even where it seems it's not!\n\n# IMMERSIVE SOUNDTRACK\nPlay the game with your headphones to get immersed in this amazing adventure.\n\n# HINTS\nGot stuck on some enigma? No worries, you can still get a helpful hint! You can also get in touch with me in case you really can't make it through a riddle, I'll be glad to help ;)\n\n# MULTILANGUAGE\nAvailable in English, French, Italian, German, Spanish, Russian, and Japanese.\n\nThe game language will change automatically based on the language settings of your device", "short_description": "A VR escape room game where you have to solve intriguing riddles to open boxes and discover nice stories about popular inventions!"}, {"images": {"nodes": [{"file_name": "$R36BSY5.png", "id": "3678762505771822", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031430_3678762509105155_2151975047074617165_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u2XexYMM2cQQ7kNvwEw6z86&_nc_oc=AdqUtQDYqcKxJ85y5VTZeWh4zRJ12WJG4rzD4FDx0SlI4lmN4BwE3ht0AyJDHpSf0kU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNBrGKT0qLXlF78TBenHb0z1nrz5n_8ZCZv8jInV7aW4Q&oe=6ACA5825"}, {"file_name": "$R81V725.png", "id": "2720695481426567", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75262743_2720695484759900_604086922326600035_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gs8zp7BsOVoQ7kNvwEmcfdY&_nc_oc=AdpfMxDmTf-KMXFHRpY70XaY5cz4O2Ao1leUDXFNVRWVXOUYH7QUimyuZpO8juteDQs&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP6d3rR0CG_wfcBEN1_amWYQT6whX4xL8HpA_LDy07Wzg&oe=6ACA570D"}, {"file_name": "$RQ3SN6U.png", "id": "1552311425628973", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982519_1552311428962306_1218130395049083834_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c-4TLDjhyUsQ7kNvwHTis9U&_nc_oc=AdpwzgVNsyZO3remBzuHh8O-hb26Whvi-rd78fpPXJO_NWOcuAxxKHB4TMWTau1Crw8&_nc_zt=3&_nc_ht=
3Umy9mELXbzSODXJlkDwPHYwY4MkF7p2QC2E3FdtKjhw&oe=69D8DB84"}, {"file_name": "5.png", "id": "467916352871409", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39003282_467916356204742_1871921057092171900_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fyDJ3uVB0y8Q7kNvwECsmDZ&_nc_oc=AdqDYcsvGNspbFpnfkx3zDKbQEzGHxVdJHtM9WTm79-1fuYjlsECZQZa3u6hHFGHDqs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2KL3XFuctkapZWrZg9AJ41zTQxP--DWZAPzx406R4yvA&oe=69D8F862"}, {"file_name": "3.png", "id": "1934382610375855", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974473_1934382613709188_7156337812617042679_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dgRRQTuDp4YQ7kNvwHk7A_3&_nc_oc=AdpINdouKbZS4VS8MNOxLa_tWopKukdgYWvRVs5Ff9X3RF8sw_xkGK6QS4ZWPUQXehY&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2VE1DFSe_KmhC0Dav_OSvUiCl_rdI2Zn0Jdy5DNfK7Gw&oe=69D8E273"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape.png", "id": "1524760081483769", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974531_1524760084817102_6497712644828891067_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=his7Q8bPNZ0Q7kNvwGIBqJB&_nc_oc=Adre-CD8HdiA-JWMy9GPZ9KXGuFhzFQYDS1mhSjFDAcfR2iaxv3PonEDvPP91hxfyG0&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0skYp3I_vBxkDgxy5jU4JYUaQoAbA21fqQN4qv-x1-hQ&oe=69D8E16F"}, "display_name": "Mystery Box VR: Hidden Secrets", "keywords": [], "long_description": " AN IMMERSIVE VR PUZZLE EXPERIENCE\nInteract with objects, handles, buttons, and wheels on each side. Crack enigmas and collect hidden puzzle tiles on a random side of the boxes.\n\nYou won't be able to compare reality with fiction.\n\n# DISCOVER INVENTIONS\nOnce you unlock all 8 boxes of a Level Pack, you can compose a puzzle and discover a brief history of an invention.\n\nIt's not always easy to escape the room, so use all your IQ to crack the riddles. There's a logic behind all of them, even where it seems it's not!\n\n# IMMERSIVE SOUNDTRACK\nPlay the game with your headphones to get immersed in this amazing adventure.\n\n# HINTS\nGot stuck on some enigma? No worries, you can still get a helpful hint! You can also get in touch with me in case you really can't make it through a riddle, I'll be glad to help ;)\n\n# MULTILANGUAGE\nAvailable in English, French, Italian, German, Spanish, Russian, and Japanese.\n\nThe game language will change automatically based on the language settings of your device", "short_description": "A VR escape room game where you have to solve intriguing riddles to open boxes and discover nice stories about popular inventions!"}, {"images": {"nodes": [{"file_name": "$R36BSY5.png", "id": "3678762505771822", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031430_3678762509105155_2151975047074617165_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ilpCUmwhlm4Q7kNvwFXYcxS&_nc_oc=AdpUY9as0yr16f0RKz_NaAlfeHk_4roet6VcSw5it1ORR0VFo0Vhq1DsKSM9BYO9Ew0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af10qmOO9sY1MwPg12j0W_JRUsfGk3ZFbaFawyjLQKJUYQ&oe=69D8DD65"}, {"file_name": "$R81V725.png", "id": "2720695481426567", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75262743_2720695484759900_604086922326600035_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=svA-GaDpOIIQ7kNvwEMezM3&_nc_oc=Adpss57NNUyBbvFV9UEuoQwZRjX6vk8ChEIHtdwovdAOERWsNasgUUqbeIL4k7lBcCA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1DzhHqAQAsX4pt3m68i_xPDb9mKOYo2zln5_K2Kw0zTQ&oe=69D8DC4D"}, {"file_name": "$RQ3SN6U.png", "id": "1552311425628973", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982519_1552311428962306_1218130395049083834_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IflNVjOjXwwQ7kNvwG3YE2U&_nc_oc=Adq22LhVZqd6dnReV_6Mfm62PjyDy1jl6oFR4PLjiVZlJV9Naeyhj8DQBK1oR98BXj0&_nc_zt=3&_nc_ht=
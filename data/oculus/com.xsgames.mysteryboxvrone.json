7Wd6nBpaIvT80fMnnUXyLL7d8V41So81rD-cvhcZqM1A&oe=6A049544"}, {"file_name": "5.png", "id": "467916352871409", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39003282_467916356204742_1871921057092171900_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=X74pQESu-9cQ7kNvwGCTJK9&_nc_oc=Adp6Z0g22cIKiKANhBcvTR_uzYCweVCzhMzFve91ZLvQek8yfz97ENf9U-ib2GSkRxw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4vVRDyL7SndIV93Vq6-duc479NpxEqkVFTtEthwRbLuQ&oe=6A0479E2"}, {"file_name": "3.png", "id": "1934382610375855", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974473_1934382613709188_7156337812617042679_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tc1EVpcD5VIQ7kNvwElAJha&_nc_oc=Adr88ethiarZcmoDO1tGWdgP2hdCLqmPMLK0-hWmsCTW1g6N-6ROsyR3ZtHe-qUZacY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5T_fG3NMWef5hp7MTykvRqY8rqNTCNyX_j2xB6Rz7gwg&oe=6A0463F3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape.png", "id": "1524760081483769", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974531_1524760084817102_6497712644828891067_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FRfKSJwkP7cQ7kNvwEwvTJ9&_nc_oc=AdoA9lEi0kqIo_ZtmrQqVH4iaJYdprt_ls-Al9ObhfPsF2I_ssq5GPUy2Izs_DdDt_A&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6Piaw7C_PCw_f22XSwGP0r6z5pR3PFbnMwAOL7T34G-w&oe=6A0462EF"}, "display_name": "Mystery Box VR: Hidden Secrets", "keywords": [], "long_description": " AN IMMERSIVE VR PUZZLE EXPERIENCE\nInteract with objects, handles, buttons, and wheels on each side. Crack enigmas and collect hidden puzzle tiles on a random side of the boxes.\n\nYou won't be able to compare reality with fiction.\n\n# DISCOVER INVENTIONS\nOnce you unlock all 8 boxes of a Level Pack, you can compose a puzzle and discover a brief history of an invention.\n\nIt's not always easy to escape the room, so use all your IQ to crack the riddles. There's a logic behind all of them, even where it seems it's not!\n\n# IMMERSIVE SOUNDTRACK\nPlay the game with your headphones to get immersed in this amazing adventure.\n\n# HINTS\nGot stuck on some enigma? No worries, you can still get a helpful hint! You can also get in touch with me in case you really can't make it through a riddle, I'll be glad to help ;)\n\n# MULTILANGUAGE\nAvailable in English, French, Italian, German, Spanish, Russian, and Japanese.\n\nThe game language will change automatically based on the language settings of your device", "short_description": "A VR escape room game where you have to solve intriguing riddles to open boxes and discover nice stories about popular inventions!"}, {"images": {"nodes": [{"file_name": "$R36BSY5.png", "id": "3678762505771822", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031430_3678762509105155_2151975047074617165_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2nn_jMYQG_YQ7kNvwGN4gnk&_nc_oc=AdoTFUSlHZfstLrE074RJBQ4Q0u44euFEYxKFb8Dheizq7bPY9gju2HsFvNPcq840Aw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5owuqcjeAywqWTo6OISzrvoF3F_qOSznjy0ZamqEdH7g&oe=6A049725"}, {"file_name": "$R81V725.png", "id": "2720695481426567", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75262743_2720695484759900_604086922326600035_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QjQcp7X5A7sQ7kNvwEBiiD9&_nc_oc=AdrkrVWciQR8owlJIKsbGb2NqzWefIXsd_qaUyuSnc2XYdpQGjgBD0aNyAAfxlTItCw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6MOkVzl1bx_VZbYmmXkK0BtCE35KY6pO6eO5hcVxnOGg&oe=6A04960D"}, {"file_name": "$RQ3SN6U.png", "id": "1552311425628973", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982519_1552311428962306_1218130395049083834_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VINS1rQ9bygQ7kNvwEDBNR5&_nc_oc=AdoqKF4LszPjTxZcXHCXw5IiENKv3MLZmJkIhaFN_mFR4YgO9IWnr9ZHjnel6PReXZA&_nc_zt=3&_nc_ht=
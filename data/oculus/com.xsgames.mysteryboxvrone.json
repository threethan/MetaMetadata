Oxd7uxw6CeTyJJnp-WpV5VKd33qsJy3zdz7PSNyO4T2Q&oe=6ADF6E44"}, {"file_name": "5.png", "id": "467916352871409", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39003282_467916356204742_1871921057092171900_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=chBK1qCR8L8Q7kNvwGrKMi_&_nc_oc=AdpFl7cmc_nw-yOe_C2sd57CrUxUnKu9DoiOUK9jw7V-_Ou49yfeHv2MIZpqR-TTmhE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPgmPSXC7WyCFdR-dO7BA9iYishnaDp9EnEaRcVzfwVeQ&oe=6ADF52E2"}, {"file_name": "3.png", "id": "1934382610375855", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974473_1934382613709188_7156337812617042679_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MJ7HdUWs29kQ7kNvwH5va1Y&_nc_oc=AdqRBcaIMVXMPL9YC1yaT5zeqComSQH6MxY3qp0qGWaTb7aCJVIHDahJib7kVFOCN-g&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN-Djg5hqiK9AApS7Wc9wPQlYpyIKAcPL5J_sfepPd2YA&oe=6ADF7533"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape.png", "id": "1524760081483769", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974531_1524760084817102_6497712644828891067_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NQBf84qakuMQ7kNvwEdMfZD&_nc_oc=AdpjrMPtAOvXi9weA-rhWX4agWPzKhQobbK3dEHh1NucThwWfHmpi2r22RDylRaianM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOhY5hezfMFa295fqf78sqm7MSyKy7d5_D4uR4OJ0lHPg&oe=6ADF742F"}, "display_name": "Mystery Box VR: Hidden Secrets", "keywords": [], "long_description": " AN IMMERSIVE VR PUZZLE EXPERIENCE\nInteract with objects, handles, buttons, and wheels on each side. Crack enigmas and collect hidden puzzle tiles on a random side of the boxes.\n\nYou won't be able to compare reality with fiction.\n\n# DISCOVER INVENTIONS\nOnce you unlock all 8 boxes of a Level Pack, you can compose a puzzle and discover a brief history of an invention.\n\nIt's not always easy to escape the room, so use all your IQ to crack the riddles. There's a logic behind all of them, even where it seems it's not!\n\n# IMMERSIVE SOUNDTRACK\nPlay the game with your headphones to get immersed in this amazing adventure.\n\n# HINTS\nGot stuck on some enigma? No worries, you can still get a helpful hint! You can also get in touch with me in case you really can't make it through a riddle, I'll be glad to help ;)\n\n# MULTILANGUAGE\nAvailable in English, French, Italian, German, Spanish, Russian, and Japanese.\n\nThe game language will change automatically based on the language settings of your device", "short_description": "A VR escape room game where you have to solve intriguing riddles to open boxes and discover nice stories about popular inventions!"}, {"images": {"nodes": [{"file_name": "$R36BSY5.png", "id": "3678762505771822", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031430_3678762509105155_2151975047074617165_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B5Npk-DQOsoQ7kNvwGvGmDp&_nc_oc=AdppYF-tYHjfN_FRgzOGtjyaEu0_-qiG3-XCRm1buOpRmluVdYpUzEtKpXUv3QD6Ru8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOcsALw1IrStxZ7WzLCX1K6TirQ3bbWRBVZZoyu1z6TEA&oe=6ADF7025"}, {"file_name": "$R81V725.png", "id": "2720695481426567", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75262743_2720695484759900_604086922326600035_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=X_piOz10lD0Q7kNvwFV0vMU&_nc_oc=Ado45mvYqXhFx7HTMcwpqCDKuxeaRKfC2oMZH9LvyBBf2dB96TVfLg6sq6vsAx0c8ng&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMHVkWzJY_FLfx_4mZ_u_KgeUQSmI0WWAGcWv_xP3h1rQ&oe=6ADF6F0D"}, {"file_name": "$RQ3SN6U.png", "id": "1552311425628973", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982519_1552311428962306_1218130395049083834_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AZ9FOJ24hFcQ7kNvwH-Uw_z&_nc_oc=AdrkarOc1Bg43EQa9bRm4D7H36muW3fIJ3Ksfv5HYKP2ZujtBleJ9F9pbrMz_fCFs9k&_nc_zt=3&_nc_ht=
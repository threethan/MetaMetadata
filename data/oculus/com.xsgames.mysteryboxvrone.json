oculuscdn.com/v/t64.5771-25/39003282_467916356204742_1871921057092171900_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WRXTJV8CGTEQ7kNvwFHp1lN&_nc_oc=AdnqlV8ba3nLOGl7_HAH_6ZuK4Hb80jN2T9nqYs1_V8vEtCFSoHZL9oobpXBxPN_1Bg&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=8&oh=00_AfzD0LeUMSh0vSgNCd8f1LxlC4LlcDMG1TtbvvWePHb1CA&oe=69BD48E2"}, {"file_name": "3.png", "id": "1934382610375855", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974473_1934382613709188_7156337812617042679_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0U0dVVF_GIkQ7kNvwF43r2c&_nc_oc=AdnaLJzwbsHLQlggazXM-xmcME7OCJ_luUQQ9qGfifNJqfgjWJd7enJbArrJH_mUo1s&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=8&oh=00_AfznQi1eSImIfC4dJJeK0hmxHRblrR4w08oMO16JT_9ByQ&oe=69BD32F3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape.png", "id": "1524760081483769", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974531_1524760084817102_6497712644828891067_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WX5-vvJ7SskQ7kNvwEI_Kyf&_nc_oc=AdmAuRKoJjis25Ny3hGzarzp6FL6YlVTQWQcYKZNKsAxMW11QvSolQlohvtltDwpLI8&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=8&oh=00_AfyCTRdZOrTicQp_WYt5TO_7qtLJCRUDX82ylzWrLtsd1A&oe=69BD31EF"}, "display_name": "Mystery Box VR: Hidden Secrets", "keywords": [], "long_description": " AN IMMERSIVE VR PUZZLE EXPERIENCE\nInteract with objects, handles, buttons, and wheels on each side. Crack enigmas and collect hidden puzzle tiles on a random side of the boxes.\n\nYou won't be able to compare reality with fiction.\n\n# DISCOVER INVENTIONS\nOnce you unlock all 8 boxes of a Level Pack, you can compose a puzzle and discover a brief history of an invention.\n\nIt's not always easy to escape the room, so use all your IQ to crack the riddles. There's a logic behind all of them, even where it seems it's not!\n\n# IMMERSIVE SOUNDTRACK\nPlay the game with your headphones to get immersed in this amazing adventure.\n\n# HINTS\nGot stuck on some enigma? No worries, you can still get a helpful hint! You can also get in touch with me in case you really can't make it through a riddle, I'll be glad to help ;)\n\n# MULTILANGUAGE\nAvailable in English, French, Italian, German, Spanish, Russian, and Japanese.\n\nThe game language will change automatically based on the language settings of your device", "short_description": "A VR escape room game where you have to solve intriguing riddles to open boxes and discover nice stories about popular inventions!"}, {"images": {"nodes": [{"file_name": "$R36BSY5.png", "id": "3678762505771822", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39031430_3678762509105155_2151975047074617165_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mbcVYu0WZHgQ7kNvwFQcNfU&_nc_oc=AdmQw2O-c-k1KjC4Zs5eGwmMH_qPEwqn51ZZiM1WXowLlhef5cNX6ZzIljym0W80Iao&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=8&oh=00_AfxX08tf4nbY5UAr5Y6Gg5W5K8OWtobFMWiZ__4IXz9Ggw&oe=69BD2DE5"}, {"file_name": "$R81V725.png", "id": "2720695481426567", "image_type": "APP_IMG_ICON", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/75262743_2720695484759900_604086922326600035_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JHo5dRyJK3EQ7kNvwFwPMTh&_nc_oc=AdlekIxNJlErdNQvEC_fZ9DcM_YpX3pxu5zTTJDZVNArZACd_g5Gc7Ark_Pr3eXGd5E&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=8&oh=00_AfwKDWhQFACnKy47OV46GO0NISQyEt6fdrO2TXgZFDIrIQ&oe=69BD2CCD"}, {"file_name": "$RQ3SN6U.png", "id": "1552311425628973", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38982519_1552311428962306_1218130395049083834_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VAYu0C5WcR4Q7kNvwHRjLWz&_nc_oc=AdnBdl6mk3oirCmg1auGjrnuIUT7MZ3dWIVniSaEdB91L3kwDU_iMs0IWMiFEVfVrgU&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=8&oh=00_Afwnr_9zcFriuJdli3dlqKCnBh_MDB-FUeCwUtu2grRnDA&oe=69BD3829"}, {"file_name": "38982645_1000853181732648_505551742782
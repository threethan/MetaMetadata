DFFg&oe=69F0B362"}, {"file_name": "3.png", "id": "1934382610375855", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974473_1934382613709188_7156337812617042679_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GBdKfpmO3FAQ7kNvwEZdB83&_nc_oc=AdpHQ0d8w0aa82D-DyI4R84SJQswqieIEgyAXsPMKDzC6R1F-65ixO01rNMwODfVrvQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af0gv2SKpxVnXr0erv2HQzNeY95kS35urk_TveVO17wFWQ&oe=69F09D73"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape.png", "id": "1524760081483769", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974531_1524760084817102_6497712644828891067_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kQZsbJu2DM8Q7kNvwFxPUry&_nc_oc=Adp3FWGWnK3MdFwOdkbjlfW2L1QpAX8ZoBYhohnkOEpWsfj5C5m475LWZp15wNZgpSM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af2jiFktCdfAE9w-C4J4rJtDARCvjkFHpVkKzMo33DIWlg&oe=69F09C6F"}, "display_name": "Mystery Box VR: Hidden Secrets", "keywords": [], "long_description": " AN IMMERSIVE VR PUZZLE EXPERIENCE\nInteract with objects, handles, buttons, and wheels on each side. Crack enigmas and collect hidden puzzle tiles on a random side of the boxes.\n\nYou won't be able to compare reality with fiction.\n\n# DISCOVER INVENTIONS\nOnce you unlock all 8 boxes of a Level Pack, you can compose a puzzle and discover a brief history of an invention.\n\nIt's not always easy to escape the room, so use all your IQ to crack the riddles. There's a logic behind all of them, even where it seems it's not!\n\n# IMMERSIVE SOUNDTRACK\nPlay the game with your headphones to get immersed in this amazing adventure.\n\n# HINTS\nGot stuck on some enigma? No worries, you can still get a helpful hint! You can also get in touch with me in case you really can't make it through a riddle, I'll be glad to help ;)\n\n# MULTILANGUAGE\nAvailable in English, French, Italian, German, Spanish, Russian, and Japanese.\n\nThe game language will change automatically based on the language settings of your device", "short_description": "A VR escape room game where you have to solve intriguing riddles to open boxes and discover nice stories about popular inventions!"}, {"images": {"nodes": [{"file_name": "$R36BSY5.png", "id": "3678762505771822", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031430_3678762509105155_2151975047074617165_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0-ojdQZ6QnAQ7kNvwGieWMJ&_nc_oc=AdqdTpJxAJykAGJEum5E43fyd6G5QzU1sFmKzshd_oUG7PIz0awsDIWimB_lAJ_0TpE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af1saHOlcSbklBcZQVBoSBw2NRVf6fI74N8nDl0-2pGRkg&oe=69F0D0A5"}, {"file_name": "$R81V725.png", "id": "2720695481426567", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75262743_2720695484759900_604086922326600035_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EO4_Bus1OAgQ7kNvwGr-g9U&_nc_oc=Ado9BUgbaxgrlN1CsZ9_xMVdBFAlUcS-pwzAjt0ekEn55v3DzmtOS44h-nMwvx5-eKs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Af2fArQLS4G1XvRWzDoxY1QqyZzXJu6bO0OzlhcTuI_kkQ&oe=69F0CF8D"}, {"file_name": "$RQ3SN6U.png", "id": "1552311425628973", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982519_1552311428962306_1218130395049083834_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iG6gSn6Eyh8Q7kNvwElkbm3&_nc_oc=AdrAyUirbnFpsT4Z434PMh3oDNNByC5i1bQj5g0kmVBy7MOtonxJBaK-ZfFPw3J-i-A&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Af0M2EJH9WqJPewh6lUro3eayi063hL98itEPUIU5KJdKg&oe=69F0A2A9"}, {"file_name": "38982645_1000853181732648_5055517427829171192_n.png", "id": "1043990680394008", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031625_1043990683727341_3557431131423146005_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q6ZWI6Ki99wQ7kNvwE39haD&_nc_oc=Ado-IOKYWjzg8kZrRxg09N1aqiW2C0HPRYIHJBZMsCo3FQmOYly1xLXhtv6xIdXmOf8&_nc_zt=3&_nc_ht=scontent-iad6-1
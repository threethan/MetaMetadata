4a_FAWtq7x8V5-NroyPNfh_AcrL2ikkhGGkntXW0RLxw&oe=6A09DB44"}, {"file_name": "5.png", "id": "467916352871409", "uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/39003282_467916356204742_1871921057092171900_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cej8UMDi2oYQ7kNvwFeZRlw&_nc_oc=AdohsWNyRrgwg2zu5rRNdhety-T5iWaelaDb8FeSGF553eiRizvO7bfF7tQovb8JVy4&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7_9V6UUp6kEplHZHDrntuaemCk-kD7ypSJK-TwyjX5iQ&oe=6A09BFE2"}, {"file_name": "3.png", "id": "1934382610375855", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/38974473_1934382613709188_7156337812617042679_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CYonODTUnqoQ7kNvwEm22HC&_nc_oc=AdoyA49Y30ZKrtE6oA2r2Cz1rAL_I3SCxzhHRG6isI_46doMAyOuFeUT6nzGEn8k-YA&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af49tOAshKN8JaE1gndoLijcJaN13RHJFsPFCeVoFqtoEg&oe=6A09E233"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape.png", "id": "1524760081483769", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/38974531_1524760084817102_6497712644828891067_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8xC85qk-ikMQ7kNvwHkcWpE&_nc_oc=Adog-rSWwtOv7V0gzZykFivSiX5FPTN9D0sbMkIkq7l_ADEKvUyYaKsHsGfwOzjJgIY&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6IcSqnaoYitz1JKTZRSgPlKa9XyjFGK7ePXVzX5N0e7A&oe=6A09E12F"}, "display_name": "Mystery Box VR: Hidden Secrets", "keywords": [], "long_description": " AN IMMERSIVE VR PUZZLE EXPERIENCE\nInteract with objects, handles, buttons, and wheels on each side. Crack enigmas and collect hidden puzzle tiles on a random side of the boxes.\n\nYou won't be able to compare reality with fiction.\n\n# DISCOVER INVENTIONS\nOnce you unlock all 8 boxes of a Level Pack, you can compose a puzzle and discover a brief history of an invention.\n\nIt's not always easy to escape the room, so use all your IQ to crack the riddles. There's a logic behind all of them, even where it seems it's not!\n\n# IMMERSIVE SOUNDTRACK\nPlay the game with your headphones to get immersed in this amazing adventure.\n\n# HINTS\nGot stuck on some enigma? No worries, you can still get a helpful hint! You can also get in touch with me in case you really can't make it through a riddle, I'll be glad to help ;)\n\n# MULTILANGUAGE\nAvailable in English, French, Italian, German, Spanish, Russian, and Japanese.\n\nThe game language will change automatically based on the language settings of your device", "short_description": "A VR escape room game where you have to solve intriguing riddles to open boxes and discover nice stories about popular inventions!"}, {"images": {"nodes": [{"file_name": "$R36BSY5.png", "id": "3678762505771822", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/39031430_3678762509105155_2151975047074617165_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aqJTBZbpsd4Q7kNvwFYED66&_nc_oc=AdrIX2PbpznhrGdcP7aqRqT6g1QzTOtS15blhOGBYzGpKnriqotfJ6gMJloULGCGlVU&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5fFLfKpxvjcYCdZctf4sg3MedK0uFwE8_-cy7NCmsnHw&oe=6A09DD25"}, {"file_name": "$R81V725.png", "id": "2720695481426567", "image_type": "APP_IMG_ICON", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/75262743_2720695484759900_604086922326600035_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E7rNyCNEymcQ7kNvwGuxCZ8&_nc_oc=AdoKPh6d9FbrVYUfEpN3l5fOQqPJf8N4xsqNJS2xH-r3YOZ2E-p5JVHSiQ531Fy4Cv0&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7_wxb1W1-wcXUSrb_SO9HotwnrvJI4gcQn4PponkKWkw&oe=6A09DC0D"}, {"file_name": "$RQ3SN6U.png", "id": "1552311425628973", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/38982519_1552311428962306_1218130395049083834_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZT62dKO0qyQQ7kNvwFHo6k_&_nc_oc=AdoLzm7EKB1mwNikePrRIabGJhOz1Wo3R23QaIDwq_Lj3XXvCfOyV6X00xwNiZwHZ-Y&_nc_zt=3&_nc_ht=
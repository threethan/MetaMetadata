_9870ojgwuP0wfX60C94gB-PkpRNu-cbBJwc_AtKqAbQ&oe=6A219644"}, {"file_name": "5.png", "id": "467916352871409", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39003282_467916356204742_1871921057092171900_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WeSjJuTv6cEQ7kNvwGPaeQO&_nc_oc=AdrTqqOwX9kKgvc6VR4seaq5VH1qJHlRpe_qSk-ZftJV4ApxQy7aKXXLnbm8sWQwjdM&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_CbW3IqRZj3sO3ZBTpwem7L8A6CQrjbY_ZrHjFkv0skg&oe=6A217AE2"}, {"file_name": "3.png", "id": "1934382610375855", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974473_1934382613709188_7156337812617042679_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GbgUeM1Uk2MQ7kNvwELCwsp&_nc_oc=AdrF9SkojEzNUJMvHbmQ_gD1jvowm6qIehBMoJAlkILXJ_89dWDYwlxYEXZYoN4GGUE&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8TkdB1qMedb1o8qjKuQ8qFHJz4NLrbUsA9q4IgkWmhuQ&oe=6A219D33"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape.png", "id": "1524760081483769", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974531_1524760084817102_6497712644828891067_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hQabwWWRKu4Q7kNvwFXW9Vn&_nc_oc=AdpjDi7hr2xm0swD5zNP1PgU3I4qeBYBjvxi9bxcAun1MoI1y0UnPVp6IwI4dbJ0XY0&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8nzbMg79GRlNFyqfLPJDXv7cWe8ZBcy4Q_1_DEsrzm0w&oe=6A219C2F"}, "display_name": "Mystery Box VR: Hidden Secrets", "keywords": [], "long_description": " AN IMMERSIVE VR PUZZLE EXPERIENCE\nInteract with objects, handles, buttons, and wheels on each side. Crack enigmas and collect hidden puzzle tiles on a random side of the boxes.\n\nYou won't be able to compare reality with fiction.\n\n# DISCOVER INVENTIONS\nOnce you unlock all 8 boxes of a Level Pack, you can compose a puzzle and discover a brief history of an invention.\n\nIt's not always easy to escape the room, so use all your IQ to crack the riddles. There's a logic behind all of them, even where it seems it's not!\n\n# IMMERSIVE SOUNDTRACK\nPlay the game with your headphones to get immersed in this amazing adventure.\n\n# HINTS\nGot stuck on some enigma? No worries, you can still get a helpful hint! You can also get in touch with me in case you really can't make it through a riddle, I'll be glad to help ;)\n\n# MULTILANGUAGE\nAvailable in English, French, Italian, German, Spanish, Russian, and Japanese.\n\nThe game language will change automatically based on the language settings of your device", "short_description": "A VR escape room game where you have to solve intriguing riddles to open boxes and discover nice stories about popular inventions!"}, {"images": {"nodes": [{"file_name": "$R36BSY5.png", "id": "3678762505771822", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39031430_3678762509105155_2151975047074617165_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5jOG_F3LB7QQ7kNvwFZ2W9L&_nc_oc=AdqeZ7ZaDCgc2Dw98q4a1n27ywUZeY0BEoVGG-KZ1ZI1Vrc7sIK0JFg4z4lbFJFomcw&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9-7EqTZeAqlRpFIRXJPm89c3M99Xey-oWBVnJerw-pWQ&oe=6A219825"}, {"file_name": "$R81V725.png", "id": "2720695481426567", "image_type": "APP_IMG_ICON", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/75262743_2720695484759900_604086922326600035_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8YTpD_IlhsMQ7kNvwHr-Z4_&_nc_oc=Ado3Pye4H9YOcQSIX1J_Kbon1eKaeumnzm8Xr0rJqYSuT_oo1Gh78W4msKIPbnNDcCg&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8u-A5agWlknjjImsMMYtfVdMpSg_4jTuHqwXfJCCM4gw&oe=6A21970D"}, {"file_name": "$RQ3SN6U.png", "id": "1552311425628973", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38982519_1552311428962306_1218130395049083834_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hnrVsoeuM8cQ7kNvwG_xpSC&_nc_oc=Adpb0WD3kM8IMNZkOmdc1XflTRxEr8BgrnXJqSy7KvWoRPL8sQgc-uMDiuXa9tdH9Bc&_nc_zt=3&_nc_ht=
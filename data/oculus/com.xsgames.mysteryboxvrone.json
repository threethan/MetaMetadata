oculuscdn.com/v/t64.5771-25/39003282_467916356204742_1871921057092171900_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Uo1T39u1R38Q7kNvwFQMqPJ&_nc_oc=AdpLjJMpUVy8a0zX9rvkRTW7s6x5a3oGgE6hJ7mqJDB6CUaq-OM9llt6OP_oZ2mNygw&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=8&oh=00_AfwLwR1hnZYsSrxCsN3iN4PSogbf8IwSLNgaUxDEybbnOg&oe=69C13D62"}, {"file_name": "3.png", "id": "1934382610375855", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974473_1934382613709188_7156337812617042679_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9JIu21zT6YgQ7kNvwHcAJcP&_nc_oc=AdpBGTMNuEub2u0mb8PP5PhjyjDDjR-AXABUMA8MQmENFzFt6IFfLn3f1_litwlpsPQ&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=8&oh=00_Afx6yiQ9TwlLHE_NqKvTWTlm4HAVEdI6qHf4e4yOEt5uDQ&oe=69C12773"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape.png", "id": "1524760081483769", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974531_1524760084817102_6497712644828891067_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C05ssKrefBUQ7kNvwHMN9rY&_nc_oc=AdqtmuDIUnb7UKfkVS3Fm4mECKBk-5ivMIMlkXOTNQrruQVPmULfrJuHabp8NhVGee8&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=8&oh=00_Afz1p98LITYlNv1evQ00UCBgjz7dCGrLIcWkAnRW_cmU9A&oe=69C1266F"}, "display_name": "Mystery Box VR: Hidden Secrets", "keywords": [], "long_description": " AN IMMERSIVE VR PUZZLE EXPERIENCE\nInteract with objects, handles, buttons, and wheels on each side. Crack enigmas and collect hidden puzzle tiles on a random side of the boxes.\n\nYou won't be able to compare reality with fiction.\n\n# DISCOVER INVENTIONS\nOnce you unlock all 8 boxes of a Level Pack, you can compose a puzzle and discover a brief history of an invention.\n\nIt's not always easy to escape the room, so use all your IQ to crack the riddles. There's a logic behind all of them, even where it seems it's not!\n\n# IMMERSIVE SOUNDTRACK\nPlay the game with your headphones to get immersed in this amazing adventure.\n\n# HINTS\nGot stuck on some enigma? No worries, you can still get a helpful hint! You can also get in touch with me in case you really can't make it through a riddle, I'll be glad to help ;)\n\n# MULTILANGUAGE\nAvailable in English, French, Italian, German, Spanish, Russian, and Japanese.\n\nThe game language will change automatically based on the language settings of your device", "short_description": "A VR escape room game where you have to solve intriguing riddles to open boxes and discover nice stories about popular inventions!"}, {"images": {"nodes": [{"file_name": "$R36BSY5.png", "id": "3678762505771822", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39031430_3678762509105155_2151975047074617165_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wFTYDDa7yhUQ7kNvwGLK1GN&_nc_oc=AdqKx1HZWAOzlsKVNsPEeUEayj8QyUrlWGdy8arcvS5mrMQiGDWYzHQz_M5Px3dIa4k&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=8&oh=00_AfwLt4eurlkTiaafpQA_0z9gGUi52FK7r6jX0BHvebHBUA&oe=69C12265"}, {"file_name": "$R81V725.png", "id": "2720695481426567", "image_type": "APP_IMG_ICON", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/75262743_2720695484759900_604086922326600035_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YLnpoeq0PDoQ7kNvwG63Mk7&_nc_oc=AdrkO42yLTu5ZSEjtEEhrTEYu5kYJGBH3c0BzwNB3L9SZOMAdpdgV2QpewEe4G9bDmI&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_Afz1jpVl9fg5iSpdYIMqSe5pGD6htAUOy0MLOJC2u9HUsw&oe=69C1214D"}, {"file_name": "$RQ3SN6U.png", "id": "1552311425628973", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38982519_1552311428962306_1218130395049083834_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bdRfbMG-qt4Q7kNvwE26dUd&_nc_oc=AdpTm-Swubm6ng5O8nxUQR0mVgSfw7MGk0DQKMYWPWqyBlnCNP881KhKPLXJIWonN60&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_AfyDIwZ2l5McvF6aNTc5rhUdbuC8vySuLDQKjVOwvCC3fw&oe=69C12CA9"}, {"file_name": "38982645_1000853181732648_505551742782
6267Nk6l11Q-6cNl8dxYjtwXxvI7YTu-5XTttQWTwBTQ&oe=6A1072C4"}, {"file_name": "5.png", "id": "467916352871409", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/39003282_467916356204742_1871921057092171900_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XL6RBML6uD8Q7kNvwHN7BaB&_nc_oc=AdoIt4NHR98EM2pUV12aJlKbw5-Un-ID6LRqwZPJ8ISiDFuwIZ0mT2KFr8qYUIU-68M&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af72Uo64JyWnyGkf_1ruTTDEuwQro2vY4kW3qAPvD5atIA&oe=6A105762"}, {"file_name": "3.png", "id": "1934382610375855", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/38974473_1934382613709188_7156337812617042679_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1jTTxvLvzsQQ7kNvwGq8GIV&_nc_oc=Adog7biowLQUaDyk4p6UThm3s3ZQn0CA48Z5z1E-51lxrxrYw8LCEHc96GchlkKorJU&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5LSQkTG1rVonCeX7UvvKL9vQ9h60vZ6E5ApwQcOt-QvQ&oe=6A1079B3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape.png", "id": "1524760081483769", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/38974531_1524760084817102_6497712644828891067_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q5VWurG7QAUQ7kNvwEnbuhd&_nc_oc=Adq3LXi3VgF-4J9D3fK4jIc0j-AmjGS6F4vP8PFDp1kIXdqhfNuuwZmxjy-tQ9w8HXU&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4AhyNTVJqVrl-XKE--P98K8dOkrGl6y-crPX-Ll_L8Yg&oe=6A1078AF"}, "display_name": "Mystery Box VR: Hidden Secrets", "keywords": [], "long_description": " AN IMMERSIVE VR PUZZLE EXPERIENCE\nInteract with objects, handles, buttons, and wheels on each side. Crack enigmas and collect hidden puzzle tiles on a random side of the boxes.\n\nYou won't be able to compare reality with fiction.\n\n# DISCOVER INVENTIONS\nOnce you unlock all 8 boxes of a Level Pack, you can compose a puzzle and discover a brief history of an invention.\n\nIt's not always easy to escape the room, so use all your IQ to crack the riddles. There's a logic behind all of them, even where it seems it's not!\n\n# IMMERSIVE SOUNDTRACK\nPlay the game with your headphones to get immersed in this amazing adventure.\n\n# HINTS\nGot stuck on some enigma? No worries, you can still get a helpful hint! You can also get in touch with me in case you really can't make it through a riddle, I'll be glad to help ;)\n\n# MULTILANGUAGE\nAvailable in English, French, Italian, German, Spanish, Russian, and Japanese.\n\nThe game language will change automatically based on the language settings of your device", "short_description": "A VR escape room game where you have to solve intriguing riddles to open boxes and discover nice stories about popular inventions!"}, {"images": {"nodes": [{"file_name": "$R36BSY5.png", "id": "3678762505771822", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/39031430_3678762509105155_2151975047074617165_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pK3rXYbRCREQ7kNvwGqLs-k&_nc_oc=Adq6kq9TYU_1yI6dStt24lM5jhX5I5mLJH4ClPIhxiXdPYfa57_dLPZyggIohmiOj-U&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5C3WKypjhKR3Cv2Dp6qV1qcFdXo6svSHkeKvuzGemBMg&oe=6A1074A5"}, {"file_name": "$R81V725.png", "id": "2720695481426567", "image_type": "APP_IMG_ICON", "uri": "https://scontent-lhr8-1.oculuscdn.com/v/t64.5771-25/75262743_2720695484759900_604086922326600035_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GG8uWdIx76wQ7kNvwGEGrqr&_nc_oc=AdqfWRxokEkP1QkIoce2_xqfO4p7JZhh9T3LUmxuTKLIy8QOJqLu1BIRF3hL9DIu-Oc&_nc_zt=3&_nc_ht=scontent-lhr8-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af59cU0psyVxhiSYEv5yBlz4h98STtFbgzzh49J_m6LEjQ&oe=6A10738D"}, {"file_name": "$RQ3SN6U.png", "id": "1552311425628973", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-lhr8-1.oculuscdn.com/v/t64.5771-25/38982519_1552311428962306_1218130395049083834_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SuG5LxbtaO4Q7kNvwFE0IGG&_nc_oc=AdquRJVHu7aticaVpgjQJIhhmc5PNoPiFXJrRj8_JCOYjvIfOc8i3x93o2umbRZNywQ&_nc_zt=3&_nc_ht=
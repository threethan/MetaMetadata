nt-ord5-1.oculuscdn.com/v/t64.5771-25/57574726_996476469154224_2905129728707462238_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oKkEY8oOHz0Q7kNvwHxCAF4&_nc_oc=AdkY_qzKc-s1zM_ucnsl12VvvWgacF9p5ABRXRYiIFJ9ikrE6DBgW3xFf6QR0BBevcU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_Afvscy7SiJvAwOI9lMIw_t1mhT-YjK-HyQ2HJZezHvCK9A&oe=699C5F48"}, {"file_name": "2.png", "id": "2203761473315962", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75469623_2203761476649295_9180026026436178997_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tyVqyN-pIQIQ7kNvwGIjFfC&_nc_oc=AdlY-VV_XU2nToUrOfPsFzqPc_xNYoOYdq5CQfMTs5D9InQM72fDDNIj9-kPEOqF5Bc&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_Afv0QFxOSGUJSFRrq04j98CX4T5s4Omo2VMXQuRipJIfEA&oe=699C5471"}, {"file_name": "5.png", "id": "1600206790893068", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974920_1600206794226401_7626143159008067194_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eKOpMOEXHUkQ7kNvwEe3cRz&_nc_oc=AdmF5CkxSoFKaBaVnkL4nBuUgyTxTJe63_ioIs4OVc6rPtrGuLw_VChC3uu6IrrLzPY&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_Aftw4uUrHF3Dn_lINSDCb8-vMTJBPzLJPLR_YaUwh1_63w&oe=699C610A"}, {"file_name": "3.png", "id": "1053463469622332", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75395599_1053463472955665_4671093965273907425_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4WBDhi6Wzp8Q7kNvwFGCnyp&_nc_oc=Adksz0IxjGCM6tZ6paX_50mcNZAjuTgQ26CGaQBQfgmcUgzr1udR5KSjSSABQrbXiSI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_AfvFUNQLka1RrGC-g-Cz21SvRp_7wnumU1M2EWerfUzX6Q&oe=699C546E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape.png", "id": "827399829365065", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75262743_827399832698398_2324097237178561690_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=obA8oxS7LDQQ7kNvwF471yc&_nc_oc=AdlD1KcjjCEA__YABGxTyCz-n3Yk-AKjr-GJ-raHfCktcbrkiNLio82BdhNf7-77bJg&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfsuZIKMVtPLc43ZKrtsrqxSAjmoEWpYoo6jYf8-MwCL8Q&oe=699C638F"}, "display_name": "Mystery Box VR: Hidden Secrets", "keywords": [], "long_description": "# UN'ESPERIENZA DI GIOCO UNICA\nInteragisci con oggetti, maniglie, pulsanti e ruote su ciascun lato. Risolvi gli enigmi e raccogli le tessere del puzzle nascoste su un lato casuale delle scatole.\n\n# SEMBRA COS\u00cc REALE!\nNon sarai in grado di confrontare la realt\u00e0 con la finzione.\n\n\n# SCOPRI LE INVENZIONI\nUna volta sbloccate tutte le 8 caselle di un pacchetto livelli, puoi comporre un puzzle e scoprire una breve storia di un'invenzione.\n\n\n# PENSA FUORI DAGLI SCHEMI\nNon \u00e8 sempre facile fuggire dalla stanza, quindi usa tutto il tuo QI per risolvere gli enigmi. C'\u00e8 una logica dietro a tutti, anche dove sembra che non lo sia!\n\n# AUDIO D'ATMOSFERA\nGioca con le cuffie per immergerti in questa fantastica avventura.\n\n# ]SUGGERIMENTI DISPONIBILI\nSei rimasto bloccato su qualche enigma? Nessun problema, puoi comunque ricevere un suggerimento utile! Puoi anche contattarmi nel caso in cui davvero non riesci a risolvere un indovinello, sar\u00f2 felice di aiutarti ;)\n\n\n# SUPPORTO MULTILINGUA\nDisponibile in inglese, francese, italiano, tedesco, spagnolo, russo e giapponese.\n\nLa lingua del gioco cambier\u00e0 automaticamente in base alle impostazioni della lingua del tuo dispositivo", "short_description": "Un gioco VR di escape room in cui devi risolvere enigmi intriganti per aprire scatole e scoprire simpatiche storie su invenzioni popolari!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://xsgames.co/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "XSGames", "support_website_url": null, "website_url": "https://xsgames.co/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "it", "ru", "de", "fr", "ja", "es"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8009010552547218"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1492753298037057"}]}, "baseline_offer": {"id": "1492753298037057"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1723067263, "status": "PUBLISHED", "id": "1492753298037057"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "25369396962748641", "version": "1.4"}, "id": "374461648749950", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "7984514264996847", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "25369396962748641"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "374461648749950"}]}, "change_log": "Fixed some minor bugs", "created_date": 1763990588, "id": "25369396962748641", "version": "1.4", "version_code": 14, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "7984514264996847", "is_concept": false, "latest_released_binary
nc_ss=7f20f&oh=00_Af-FNeFTgmpPekHQCaabXgrST-o8PZKG_xLZQL5xzeOjRQ&oe=6A22E7C4"}, {"file_name": "5.png", "id": "467916352871409", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/39003282_467916356204742_1871921057092171900_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WeSjJuTv6cEQ7kNvwGdNkQs&_nc_oc=Adqi6UaIC9q-Tnh1cuzStTd9lL5nKojW4ol8cDdNBYU641KrFkTMIgkDiXqnHOeU0G4&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_6nC823KnIOBKU-BOV5OYGJoS1N8ga0UCwD9cpeSbaRA&oe=6A22CC62"}, {"file_name": "3.png", "id": "1934382610375855", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/38974473_1934382613709188_7156337812617042679_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3U4WkmPCYwUQ7kNvwHzR5jf&_nc_oc=AdqbEUXE4Ud0TZ4iJ5Mq7eVoRuSNFkjK-Ugs5r9MnethfnnJeGMAh-yFANc8Jk3xSIs&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_3SUr0kmBCKqKmjO8JZrF4C5Wkw1U5BRnFm6hueOf5eg&oe=6A22EEB3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape.png", "id": "1524760081483769", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/38974531_1524760084817102_6497712644828891067_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hQabwWWRKu4Q7kNvwHzT04h&_nc_oc=Adp-5Uy3v4sLOwWlKuvdIxzqLYcqFLcl_U_CGo33UESR2psL1afcnMIQIz8UcuxJWEY&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-VYLPolD9t7VGjhqhi2wvJ8EQ-NYQdytuA1mKrZItFEA&oe=6A22EDAF"}, "display_name": "Mystery Box VR: Hidden Secrets", "keywords": [], "long_description": " AN IMMERSIVE VR PUZZLE EXPERIENCE\nInteract with objects, handles, buttons, and wheels on each side. Crack enigmas and collect hidden puzzle tiles on a random side of the boxes.\n\nYou won't be able to compare reality with fiction.\n\n# DISCOVER INVENTIONS\nOnce you unlock all 8 boxes of a Level Pack, you can compose a puzzle and discover a brief history of an invention.\n\nIt's not always easy to escape the room, so use all your IQ to crack the riddles. There's a logic behind all of them, even where it seems it's not!\n\n# IMMERSIVE SOUNDTRACK\nPlay the game with your headphones to get immersed in this amazing adventure.\n\n# HINTS\nGot stuck on some enigma? No worries, you can still get a helpful hint! You can also get in touch with me in case you really can't make it through a riddle, I'll be glad to help ;)\n\n# MULTILANGUAGE\nAvailable in English, French, Italian, German, Spanish, Russian, and Japanese.\n\nThe game language will change automatically based on the language settings of your device", "short_description": "A VR escape room game where you have to solve intriguing riddles to open boxes and discover nice stories about popular inventions!"}, {"images": {"nodes": [{"file_name": "$R36BSY5.png", "id": "3678762505771822", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/39031430_3678762509105155_2151975047074617165_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5jOG_F3LB7QQ7kNvwEN4ZkR&_nc_oc=AdpJIndTJnsdwcC8RHx2ltbD9pzIPRzKwpdu6eyZEzf7QnZ0OjWCl_BuiDKTBsXcvnQ&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_i1k_hrSBkEd45WPA3R2mF3vywVeMZ0N0kmgQp7G1syA&oe=6A22E9A5"}, {"file_name": "$R81V725.png", "id": "2720695481426567", "image_type": "APP_IMG_ICON", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/75262743_2720695484759900_604086922326600035_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1KMMa831a8cQ7kNvwF8715_&_nc_oc=AdrcrZup0qXFkFT05qkyEPcLsGbPmnQnCJrBycpyLsp_Ah8Sz5XUTh916xu-ebnjSPo&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-e0F8xgbZNiO_dLqA9Sh9e15rkdywsA1f6Wub5ArT8ow&oe=6A22E88D"}, {"file_name": "$RQ3SN6U.png", "id": "1552311425628973", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/38982519_1552311428962306_1218130395049083834_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hnrVsoeuM8cQ7kNvwGpi88l&_nc_oc=AdrMQjCBLi9uS3aqcILz5YYOEf_K-snZKnlI8PjGONBCAyZdCBFDHkiWLfR5
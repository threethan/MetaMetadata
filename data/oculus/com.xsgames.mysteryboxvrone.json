74PkCiGJxwTBpvGdATVNOIUjDsYJO_gIbnYhCcehsDkg&oe=69FCAC44"}, {"file_name": "5.png", "id": "467916352871409", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39003282_467916356204742_1871921057092171900_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mQoc8ZCk6PEQ7kNvwHtrKCw&_nc_oc=AdqS5-l12YTkEuHhmX9gCfs66rZ_1k1wMuFtOc4l28ugZTM-GOkd_fji7DGD98RdlMc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7evOseyuFw7vwhzBJp07dwQHA2ieBkwSIvAygQ7n1Taw&oe=69FC90E2"}, {"file_name": "3.png", "id": "1934382610375855", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974473_1934382613709188_7156337812617042679_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tzPybgxsmdEQ7kNvwHlatVM&_nc_oc=AdqLiLHxCSWG5Puul2FQu1a1K8UZEuCzX0F53sXmSTtJLzLswomHVdzMsmcX3wTVxiI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4ndxrO68H2-Ctz3M03g0mon8F8BM5Mp32JjXuwmLKJMA&oe=69FCB333"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape.png", "id": "1524760081483769", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974531_1524760084817102_6497712644828891067_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x88o4Trox9AQ7kNvwGCAzKJ&_nc_oc=AdrwcR9uxwmRUu9BYRo6K7KCf88tDpkv6B7Re2ZepwGSp7DH0o0PRNrP5KBOMi-rn7w&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6W2UvK84WAW1F_O8mhrhI5bG4KBKS-6ymVHyqIwruDqA&oe=69FCB22F"}, "display_name": "Mystery Box VR: Hidden Secrets", "keywords": [], "long_description": " AN IMMERSIVE VR PUZZLE EXPERIENCE\nInteract with objects, handles, buttons, and wheels on each side. Crack enigmas and collect hidden puzzle tiles on a random side of the boxes.\n\nYou won't be able to compare reality with fiction.\n\n# DISCOVER INVENTIONS\nOnce you unlock all 8 boxes of a Level Pack, you can compose a puzzle and discover a brief history of an invention.\n\nIt's not always easy to escape the room, so use all your IQ to crack the riddles. There's a logic behind all of them, even where it seems it's not!\n\n# IMMERSIVE SOUNDTRACK\nPlay the game with your headphones to get immersed in this amazing adventure.\n\n# HINTS\nGot stuck on some enigma? No worries, you can still get a helpful hint! You can also get in touch with me in case you really can't make it through a riddle, I'll be glad to help ;)\n\n# MULTILANGUAGE\nAvailable in English, French, Italian, German, Spanish, Russian, and Japanese.\n\nThe game language will change automatically based on the language settings of your device", "short_description": "A VR escape room game where you have to solve intriguing riddles to open boxes and discover nice stories about popular inventions!"}, {"images": {"nodes": [{"file_name": "$R36BSY5.png", "id": "3678762505771822", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031430_3678762509105155_2151975047074617165_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tbUdYHhM2rkQ7kNvwHhcwK9&_nc_oc=AdrwFntCm_88Cb2ZMviRX1b7j01ARnQp2TECjoJp95GtYSdX7wOHhMvZBvOV0_Nm2yk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5Tl_uF_5zV76ml1km9KP_YWv3CYg4GFDfQ-LOrxryTzQ&oe=69FCAE25"}, {"file_name": "$R81V725.png", "id": "2720695481426567", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75262743_2720695484759900_604086922326600035_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u0fQbb-Hn2UQ7kNvwEcf-Ls&_nc_oc=AdpC74es_ZrLSJt6YoTa5sm21eXp0fkjvA4ahUHMm56vZP4GxOTywRi0fY7ODI11nYc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5Vze62Cki-oi1XOTYRVk8Nxsy6efiexp2YeRz6YYDidw&oe=69FCAD0D"}, {"file_name": "$RQ3SN6U.png", "id": "1552311425628973", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982519_1552311428962306_1218130395049083834_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oY0fBImjCR4Q7kNvwGsfFYv&_nc_oc=AdrSQiUBCLZ4Hi0O9XbaMFxAsxsXmb2tm5GmAVq_yOJCRiURfeBLMC1tbX8hA_3-Swg&_nc_zt=3&_nc_ht=
LnRnTfiWyRAR_NY6ce01uO2pyVLvLeD0T74bBt-Ija1Q&oe=6AAFF844"}, {"file_name": "5.png", "id": "467916352871409", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39003282_467916356204742_1871921057092171900_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rBAQ3HTNJl4Q7kNvwHOXZDt&_nc_oc=AdoRqNG5RiG-yynqv1x2De48SD6dTiv1DdQT-lr525ioI782vOE6RaYotyjgES-eujU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLcsSX1Hpg5tl9YSjP9tZrsoQH-tQBJIvXms4KfHkuVjg&oe=6AAFDCE2"}, {"file_name": "3.png", "id": "1934382610375855", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974473_1934382613709188_7156337812617042679_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1MIgXfjqlbwQ7kNvwEavIRz&_nc_oc=AdpUFk8iUBF8A_fUm-VQ9CzaPhO7Q1XQFB-wCldGEvlNvkEd_Uqmbb8Vc01bMs7J-1E&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL_hIo_FPlHQHasR18-LOH23TyBHhckmeZcD4seNlPebQ&oe=6AAFFF33"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape.png", "id": "1524760081483769", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974531_1524760084817102_6497712644828891067_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V7ybxxtlMXsQ7kNvwERuYhS&_nc_oc=Adp1-S_bGk-5miGbtHi8h8Wz6Uk1gen2MaRXZqLw_9Xq--92ZKUvKuIyeZs5d3GPROQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJpjYnXP-ud9GzXLbab-IAFRRPrXSxvQlZACH9zpw0o2Q&oe=6AAFFE2F"}, "display_name": "Mystery Box VR: Hidden Secrets", "keywords": [], "long_description": " AN IMMERSIVE VR PUZZLE EXPERIENCE\nInteract with objects, handles, buttons, and wheels on each side. Crack enigmas and collect hidden puzzle tiles on a random side of the boxes.\n\nYou won't be able to compare reality with fiction.\n\n# DISCOVER INVENTIONS\nOnce you unlock all 8 boxes of a Level Pack, you can compose a puzzle and discover a brief history of an invention.\n\nIt's not always easy to escape the room, so use all your IQ to crack the riddles. There's a logic behind all of them, even where it seems it's not!\n\n# IMMERSIVE SOUNDTRACK\nPlay the game with your headphones to get immersed in this amazing adventure.\n\n# HINTS\nGot stuck on some enigma? No worries, you can still get a helpful hint! You can also get in touch with me in case you really can't make it through a riddle, I'll be glad to help ;)\n\n# MULTILANGUAGE\nAvailable in English, French, Italian, German, Spanish, Russian, and Japanese.\n\nThe game language will change automatically based on the language settings of your device", "short_description": "A VR escape room game where you have to solve intriguing riddles to open boxes and discover nice stories about popular inventions!"}, {"images": {"nodes": [{"file_name": "$R36BSY5.png", "id": "3678762505771822", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031430_3678762509105155_2151975047074617165_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qf1Tda_VFNYQ7kNvwH3xV6S&_nc_oc=Adonvq7HHYIZJg2Lh2bxEAjEY0P2GoiARcGmxRwcgqGnmfuEDTqYdHBK1U16HzGFPYI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKxL4VES_Pm5g-q8G8uUYUDbgqWVnKaH2SCIdZ0NDVAeg&oe=6AAFFA25"}, {"file_name": "$R81V725.png", "id": "2720695481426567", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75262743_2720695484759900_604086922326600035_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SFtGowUZtxIQ7kNvwHyUgpy&_nc_oc=AdoXbKHXmHhOdd7cc4Iggs7xJqPH0kocqGKpnSB2l97oydCst5CoeppNrUxzO5XjiTg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLvAGsm4BLiH7wSA8wo1CfHy-Ce1-DKTqvvP1sBr2PXMQ&oe=6AAFF90D"}, {"file_name": "$RQ3SN6U.png", "id": "1552311425628973", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982519_1552311428962306_1218130395049083834_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iRwvyehGUKcQ7kNvwGKdhWf&_nc_oc=Adp8MKnlQb47wjkc5goDSsA-UWE38bVn1qGBSDMDM6GgLL1STNrqXt66hY2r48GHiuM&_nc_zt=3&_nc_ht=
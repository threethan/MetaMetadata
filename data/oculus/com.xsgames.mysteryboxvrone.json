934382610375855", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974473_1934382613709188_7156337812617042679_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NI8rieCIN1EQ7kNvwGTWG5s&_nc_oc=Adr7lr5ZRwnQFxXaG-UlA3SzD8_GnGAqZ8vkVpTc0r1orWqKpyg6MWT-Tmbd6gh48Wk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRMNbpnzslreE3ew-z4PRcEzZr5_K6iDEmu7TvRNCNLyw&oe=6B006AB3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape_coverart.png", "id": "897861905346420", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982672_897861908679753_3996777238831042692_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9fcl2bd7A30Q7kNvwGH-s0k&_nc_oc=AdoT5qyD96gA5MYGx_WCO9ejxZWN91Jd40Hw7iLhxhX_cnNZxDazOC2IbEI8EjNlWi4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQFTo3ZIn8LOHbhIEP3bYqlJdrlFoFj7TeWDQPb5x1VlQ&oe=6B006D2B"}, "display_name": "Mystery Box VR: Hidden Secrets Escape", "keywords": ["puzzle", "escape", "room", "trivia", "brainteaser"], "long_description": "# AN IMMERSIVE VR PUZZLE EXPERIENCE\nInteract with objects, handles, buttons, and wheels on each side. Crack enigmas and collect hidden puzzle tiles on a random side of the boxes.\n\nYou won't be able to compare reality with fiction.\n\n# DISCOVER INVENTIONS\nOnce you unlock all 8 boxes of a Level Pack, you can compose a puzzle and discover a brief history of an invention.\n\nIt's not always easy to escape the room, so use all your IQ to crack the riddles. There's a logic behind all of them, even where it seems it's not!\n\n# IMMERSIVE SOUNDTRACK\nPlay the game with your headphones to get immersed in this amazing adventure.\n\n# HINTS\nGot stuck on some enigma? No worries, you can still get a helpful hint! You can also get in touch with me in case you really can't make it through a riddle, I'll be glad to help ;)\n\n# MULTILANGUAGE\nAvailable in English, French, Italian, German, Spanish, Russian, and Japanese.\n\nThe game language will change automatically based on the language settings of your device", "short_description": "Crack awesome puzzles around many boxes, and discover the history of the world's most popular inventions!"}, {"images": {"nodes": [{"file_name": "logoTransparent.png", "id": "3812261432362188", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974562_3812261435695521_5176404439574971225_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g66-8J5rjHYQ7kNvwGj0Tk0&_nc_oc=AdrnYK82xCgxvNGMi6bzALMC2FIoQ-GYoBho8PXb2LybOkI3GugtY4LX2ZTKRQixtFY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSqhsqbFoEmKw38JWIUrTz8zWKxGJ6ZEhT7y2diuPMXfA&oe=6B005AD6"}, {"file_name": "portrait_coverart.png", "id": "1953342038506987", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982581_1953342045173653_4906879878373922307_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4_IPEfT47zEQ7kNvwHU6hGm&_nc_oc=AdoIKHWuFKSBPMKds6Ib2vfJC1mtMDEhrJwmx1OanCw1EhHFC0_0jxhb0sCkv5kXLeo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS1Snfnkygxo4wUdbUelZl4DTIs5uEHZCl32h0SwCHLnA&oe=6B007BFD"}, {"file_name": "landscape_coverart.png", "id": "1300403051139202", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75462955_1300403057805868_2288822001409671177_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U21MaCHU4W8Q7kNvwG1HLRF&_nc_oc=Adpw0qYHSbO0Hj4PplxJ2QjDurAG7vqvOp0iu1plDCsCeY_we104Apf1bY7LXtc5jd4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSDoMyGcLa-EFQwBmcXs0A15vY7c0qoRDX3GZT2pHxLlg&oe=6B006CA0"}, {"file_name": "square_coverart.png", "id": "914408640187392", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39036626_914408643520725_6339598287132
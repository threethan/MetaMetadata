934382610375855", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974473_1934382613709188_7156337812617042679_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zKUV62pjn80Q7kNvwGkUAcv&_nc_oc=Ado9Mcyep-TKsoh-6TC0MrRDF_te0QxZTyj2HcbW8LH9-KwIn92vE9mh7HUjq1_X1LY&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSmIeer5BRUDds7r7zlMPQGAs2Fr8h_taB8bsYkDOJ0OA&oe=6AFC7633"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape_coverart.png", "id": "897861905346420", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/38982672_897861908679753_3996777238831042692_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VCNHLBJZ0tkQ7kNvwGVINgk&_nc_oc=Adr1PsKGTv3ZwiaU9GVLioR90m918AFaRaMyzZ_nLVqS4fj33usyxA76RUM9RrFHaUk&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTwLgVPuSzlSirZ1pGBC8F9eIDHx3bR3nGoNN0AXFJoBw&oe=6AFC78AB"}, "display_name": "Mystery Box VR: Hidden Secrets Escape", "keywords": ["puzzle", "escape", "room", "trivia", "brainteaser"], "long_description": "# AN IMMERSIVE VR PUZZLE EXPERIENCE\nInteract with objects, handles, buttons, and wheels on each side. Crack enigmas and collect hidden puzzle tiles on a random side of the boxes.\n\nYou won't be able to compare reality with fiction.\n\n# DISCOVER INVENTIONS\nOnce you unlock all 8 boxes of a Level Pack, you can compose a puzzle and discover a brief history of an invention.\n\nIt's not always easy to escape the room, so use all your IQ to crack the riddles. There's a logic behind all of them, even where it seems it's not!\n\n# IMMERSIVE SOUNDTRACK\nPlay the game with your headphones to get immersed in this amazing adventure.\n\n# HINTS\nGot stuck on some enigma? No worries, you can still get a helpful hint! You can also get in touch with me in case you really can't make it through a riddle, I'll be glad to help ;)\n\n# MULTILANGUAGE\nAvailable in English, French, Italian, German, Spanish, Russian, and Japanese.\n\nThe game language will change automatically based on the language settings of your device", "short_description": "Crack awesome puzzles around many boxes, and discover the history of the world's most popular inventions!"}, {"images": {"nodes": [{"file_name": "logoTransparent.png", "id": "3812261432362188", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974562_3812261435695521_5176404439574971225_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uXXeQ_G0DlUQ7kNvwElApou&_nc_oc=Ado6C3frJyzsI6XtZIyqvJSYvFikGQSDSByaC1rsByyirD9HZmz9mA-3T_73aXAc6Ms&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRbg3tbqyH2hNv5hwBWvOTlE_E-awVdgfWCGoz6RI3ubQ&oe=6AFC6656"}, {"file_name": "portrait_coverart.png", "id": "1953342038506987", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/38982581_1953342045173653_4906879878373922307_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lx9lNuTX6RMQ7kNvwFhu75E&_nc_oc=AdoRIqc5lLXwKUwwiLeyHsBYqFlC3UCK5F-d-nJM2bw3qsCyvMeW65WZyq2A_YEnxdM&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTnpZOkV58-W-gZ8-5hCX-KqWeKqc4voPbefcxw_wIYCw&oe=6AFC877D"}, {"file_name": "landscape_coverart.png", "id": "1300403051139202", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75462955_1300403057805868_2288822001409671177_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=teTK0EVsvnkQ7kNvwH3THp1&_nc_oc=AdrGEJYl0loXvZf7KkmJPbLeGS79G4BlchP8Du91KsZy9sBEJYFGynFlInqcd0Qj9Ls&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRNl9M58Sv5j6Ldip7_HXm2BQN_CVROryMwpfcdDBrEsQ&oe=6AFC7820"}, {"file_name": "square_coverart.png", "id": "914408640187392", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/39036626_914408643520725_6339598287132
GvRqJwXZ2irYTEV6_ebmVReAMxyrIBAy27cCB1RGaEbg&oe=6A82ED04"}, {"file_name": "5.png", "id": "467916352871409", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39003282_467916356204742_1871921057092171900_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4TiyZ1VYdtQQ7kNvwF0MsI9&_nc_oc=Adq1-e0s1G4xxFnYTjVtL8UfEUPw_b-CFYcDVXiGedrNA6NPoSuwoWel40jJSTKGmnI&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFlQMq23jId_f5R8xtUhnhg9u3CAhrUMOQr-23n1VhGhQ&oe=6A8309E2"}, {"file_name": "3.png", "id": "1934382610375855", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974473_1934382613709188_7156337812617042679_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=slmk--1hXw4Q7kNvwF3p0k1&_nc_oc=Adr_ZHil2FxWojOf9CoPcA2Zg9jjklVgWbwWspjJQM78mt9X0pzq5nYRml7l5-2h778&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGoqYOr-CZ8NJ05JXwcvQESwt2srxCnlOFaT22cF9gvrA&oe=6A82F3F3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape.png", "id": "1524760081483769", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974531_1524760084817102_6497712644828891067_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FKzC0Q58MMwQ7kNvwE8M81c&_nc_oc=AdoIFUneDiye-mYBgBOJmeA_cqGFTwHfYvJBnrgQKuDhF6sKZMxkfZYsuVRFf-TnvP8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHtWE5uX7EDJUPteqnNrJSd4Z8X5HMdPDOeybzqK5HvuQ&oe=6A82F2EF"}, "display_name": "Mystery Box VR: Hidden Secrets", "keywords": [], "long_description": " AN IMMERSIVE VR PUZZLE EXPERIENCE\nInteract with objects, handles, buttons, and wheels on each side. Crack enigmas and collect hidden puzzle tiles on a random side of the boxes.\n\nYou won't be able to compare reality with fiction.\n\n# DISCOVER INVENTIONS\nOnce you unlock all 8 boxes of a Level Pack, you can compose a puzzle and discover a brief history of an invention.\n\nIt's not always easy to escape the room, so use all your IQ to crack the riddles. There's a logic behind all of them, even where it seems it's not!\n\n# IMMERSIVE SOUNDTRACK\nPlay the game with your headphones to get immersed in this amazing adventure.\n\n# HINTS\nGot stuck on some enigma? No worries, you can still get a helpful hint! You can also get in touch with me in case you really can't make it through a riddle, I'll be glad to help ;)\n\n# MULTILANGUAGE\nAvailable in English, French, Italian, German, Spanish, Russian, and Japanese.\n\nThe game language will change automatically based on the language settings of your device", "short_description": "A VR escape room game where you have to solve intriguing riddles to open boxes and discover nice stories about popular inventions!"}, {"images": {"nodes": [{"file_name": "$R36BSY5.png", "id": "3678762505771822", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031430_3678762509105155_2151975047074617165_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IePZYcabk4AQ7kNvwEeRlJ2&_nc_oc=AdpdLdBQ901TFguAPVOxig-qvoWZhDe5PeGG3SzJ-O97KUYQd0VHTgrSd1Rugjk3BP4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFYwpSio3yaPp2AJYExw7jgAk8h2XmuHDQrS9UXJVeQtw&oe=6A82EEE5"}, {"file_name": "$R81V725.png", "id": "2720695481426567", "image_type": "APP_IMG_ICON", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75262743_2720695484759900_604086922326600035_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6psLyBricCUQ7kNvwGqaGLC&_nc_oc=AdoDR4tSSKLxlO_cGhDuuIE22UWrPO3Fs6jop20Tmn6UZ8KkxvQPdxOC6jhcByB41r8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHlZ-Lctsok3JRhvzxMb_IvgXOVZAca8XKSawq9Shqatg&oe=6A82EDCD"}, {"file_name": "$RQ3SN6U.png", "id": "1552311425628973", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982519_1552311428962306_1218130395049083834_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rXasxUfX2bwQ7kNvwHrMZ3k&_nc_oc=Adrz0v5yk1O1zawEmHApNP9pW2SEfVOprvIpDvh9IYg6TEILHYTMJd-uM6iYKgc4Ly4&_nc_zt=3&_nc_ht=
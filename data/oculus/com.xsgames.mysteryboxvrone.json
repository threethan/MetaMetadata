AyDPnBYUpGLWcV4ZFCYLsUjn2V7Qt5gBRRuTl1FPpUpA&oe=6A5E0304"}, {"file_name": "5.png", "id": "467916352871409", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39003282_467916356204742_1871921057092171900_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gfMjMVstw0EQ7kNvwF54Avr&_nc_oc=Adr5Boo1H4kOfQActHu9NfsBERdwhcjq4i09EWV-I1nk3FwJI3DCLNbZsdmO7XJNCaY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBJBbsFESzfQzrsnqqx_mqEMWDJvzF4-ueWsSheD7Hs7Q&oe=6A5E1FE2"}, {"file_name": "3.png", "id": "1934382610375855", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974473_1934382613709188_7156337812617042679_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=If7Sg9b1r7gQ7kNvwHjT0eB&_nc_oc=Adr7Z3CT5KYkIq-LQGLhmuPMJ_nRH2CvzSOFJ_b0d-ppjz4gdYWiA33G4GGvwUeZ8OQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDbSurd--JEzIvR5D3QiKOQdEVnf3Uwb_anVTLgjjwaVg&oe=6A5E09F3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape.png", "id": "1524760081483769", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974531_1524760084817102_6497712644828891067_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-a63X8tpH40Q7kNvwFbaoMA&_nc_oc=AdoplSGWMStS4JQWFO-fJ2Hrw1DHW-kV7zRfjiwNhNuafE4yrvj9G71sUod7M9sbOfc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBLU55bv6q69g5hnlDNYVIb8yqeFUW9KU1mfrp-pq73lg&oe=6A5E08EF"}, "display_name": "Mystery Box VR: Hidden Secrets", "keywords": [], "long_description": " AN IMMERSIVE VR PUZZLE EXPERIENCE\nInteract with objects, handles, buttons, and wheels on each side. Crack enigmas and collect hidden puzzle tiles on a random side of the boxes.\n\nYou won't be able to compare reality with fiction.\n\n# DISCOVER INVENTIONS\nOnce you unlock all 8 boxes of a Level Pack, you can compose a puzzle and discover a brief history of an invention.\n\nIt's not always easy to escape the room, so use all your IQ to crack the riddles. There's a logic behind all of them, even where it seems it's not!\n\n# IMMERSIVE SOUNDTRACK\nPlay the game with your headphones to get immersed in this amazing adventure.\n\n# HINTS\nGot stuck on some enigma? No worries, you can still get a helpful hint! You can also get in touch with me in case you really can't make it through a riddle, I'll be glad to help ;)\n\n# MULTILANGUAGE\nAvailable in English, French, Italian, German, Spanish, Russian, and Japanese.\n\nThe game language will change automatically based on the language settings of your device", "short_description": "A VR escape room game where you have to solve intriguing riddles to open boxes and discover nice stories about popular inventions!"}, {"images": {"nodes": [{"file_name": "$R36BSY5.png", "id": "3678762505771822", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031430_3678762509105155_2151975047074617165_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8h7sr1DVsWUQ7kNvwEEVKAU&_nc_oc=AdoLjIMvnh5v_-ofCdgkcVlgh-9X9lTYjzhTZBvEty7YoLdLluSghjXrqHs65Cc5JDk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAZ-mPfmtU8l-gpfQ1LspPnqKYXRsf8rVgzxAaFR6XoHg&oe=6A5E04E5"}, {"file_name": "$R81V725.png", "id": "2720695481426567", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75262743_2720695484759900_604086922326600035_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=inT74WQNhQkQ7kNvwFLlfqX&_nc_oc=AdrdhLbfrplMwCgxHnj7jzpSan4CXvAJwSHbyH12uOSPDxvVnWrWRzxGgC-NB1M5Duw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBeJVpBpixupRRwUVVBX3BpaVl2yoZyfSd_kFWOklnLww&oe=6A5E03CD"}, {"file_name": "$RQ3SN6U.png", "id": "1552311425628973", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982519_1552311428962306_1218130395049083834_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kXLOTrgizmsQ7kNvwHQouKB&_nc_oc=AdqNrRTHUJ1VRObf0sp2Xjlq8GULDOhv-so3-qgUcQ9i0Cjx5hYHW3ueT3KwHyf8wQE&_nc_zt=3&_nc_ht=
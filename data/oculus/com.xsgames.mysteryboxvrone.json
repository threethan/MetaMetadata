nc_ss=7f20f&oh=00_AQFTG0WlSlw3SfUZXJXzI2VLGqiGne7ZXmri_WKCDUz1Lw&oe=6A7DA704"}, {"file_name": "5.png", "id": "467916352871409", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/39003282_467916356204742_1871921057092171900_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sB_YGeS_OoUQ7kNvwFx-sP4&_nc_oc=AdqmhQYblWNtrc6VRKkcnnCnuiwzYDhz_Q3tJS9Vg7g7P-SvFFDK5r5zQ5VoqAkTBy8&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFflWoQchXL5Z64AecYMwzep-m_QpurfegRBbExBF70qA&oe=6A7DC3E2"}, {"file_name": "3.png", "id": "1934382610375855", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/38974473_1934382613709188_7156337812617042679_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9VYUuC_JU6cQ7kNvwG0OKel&_nc_oc=AdoXLAzNEckVrmX5xUOV9Awr9my0kjTREB-0MbmPSNQg_-dG7tsWr_QMHbfNPgbDEM4&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFyVhoUDjXU5y5jxCFoVab5PKvFMEKWqKfRhJU3hl-57Q&oe=6A7DADF3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape.png", "id": "1524760081483769", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/38974531_1524760084817102_6497712644828891067_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PXzfjSNr0qcQ7kNvwHDS2jm&_nc_oc=AdpRFltuCe_MIlqNS1XIGdhBE-WmCwUPZYc7mLdQiSJhgDjiH6MSS_hJrlYEQGiZoqs&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHd7D-RiS3VijjY05PSfy_KCm-8P1sFYt0rf3qnRYeB1w&oe=6A7DACEF"}, "display_name": "Mystery Box VR: Hidden Secrets", "keywords": [], "long_description": " AN IMMERSIVE VR PUZZLE EXPERIENCE\nInteract with objects, handles, buttons, and wheels on each side. Crack enigmas and collect hidden puzzle tiles on a random side of the boxes.\n\nYou won't be able to compare reality with fiction.\n\n# DISCOVER INVENTIONS\nOnce you unlock all 8 boxes of a Level Pack, you can compose a puzzle and discover a brief history of an invention.\n\nIt's not always easy to escape the room, so use all your IQ to crack the riddles. There's a logic behind all of them, even where it seems it's not!\n\n# IMMERSIVE SOUNDTRACK\nPlay the game with your headphones to get immersed in this amazing adventure.\n\n# HINTS\nGot stuck on some enigma? No worries, you can still get a helpful hint! You can also get in touch with me in case you really can't make it through a riddle, I'll be glad to help ;)\n\n# MULTILANGUAGE\nAvailable in English, French, Italian, German, Spanish, Russian, and Japanese.\n\nThe game language will change automatically based on the language settings of your device", "short_description": "A VR escape room game where you have to solve intriguing riddles to open boxes and discover nice stories about popular inventions!"}, {"images": {"nodes": [{"file_name": "$R36BSY5.png", "id": "3678762505771822", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/39031430_3678762509105155_2151975047074617165_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TabCGj2h_-EQ7kNvwFx5UEg&_nc_oc=Adrk4uuk5FpmEtUitjFs32HWwMX84ZRaDJAOI0-BBZD9gTD762qQFAf6bWTkkKjyOhU&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH9D38ITYjLLV35eVlJkfxlKZb4ml2QW2ZgkqJq-V_MRA&oe=6A7DA8E5"}, {"file_name": "$R81V725.png", "id": "2720695481426567", "image_type": "APP_IMG_ICON", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/75262743_2720695484759900_604086922326600035_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0ReQfUKVOsMQ7kNvwFF7NWA&_nc_oc=AdqZQqzY6OVH9ULoiX1SmG_yxmjiFOGc6fyXbfnim2LG0VW8AilIo_z87e8ANGMFmks&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHxKrkhKFJ5oGliFrzpjmf_QgwdaDG5OE7ZY5eFReCL4A&oe=6A7DA7CD"}, {"file_name": "$RQ3SN6U.png", "id": "1552311425628973", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/38982519_1552311428962306_1218130395049083834_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PywjoRwZmEoQ7kNvwHoMBlq&_nc_oc=AdpI7sYluehWvv_NA_lQQB3_ZwRXh834oTXY4EDh9Hz7-dlBRKQFjivPbtUu
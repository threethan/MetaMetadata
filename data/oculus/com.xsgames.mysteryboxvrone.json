oculuscdn.com/v/t64.5771-25/39003282_467916356204742_1871921057092171900_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c095WwueC5sQ7kNvwF-5XNn&_nc_oc=Adm77PNFeQf0qxxUJHpcjlO3LjKQnSfITa7fPfqZ_V0njvnJyP6BiJ6jys-3_h4YkZU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfwlCMGsPTsIOZrFGqeWLoPA3z5Ki40Gx1IOCH8jp2PvkQ&oe=69B019E2"}, {"file_name": "3.png", "id": "1934382610375855", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974473_1934382613709188_7156337812617042679_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yZSxb3aoSjEQ7kNvwFJ6Z2B&_nc_oc=Adk9O2WtPTnWOMiPRGCzVBfc2NG87Skpi3Z7M5x0fDSMcRfyNr74q3mVJkma1vb77X4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfzK9o6slh44gSp0v2lhI234Ma38zZRlkuX9Kkzxdq99hg&oe=69B003F3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape.png", "id": "1524760081483769", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974531_1524760084817102_6497712644828891067_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PPr2kdLCyRUQ7kNvwG1rok7&_nc_oc=AdlPNvNwsgV758eyoxR6Ah9RnxS_6P_-wUWurmz0PFdgz8Crjfl17KIYJ4HSkd5u0XE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfyVQrIlK4ZW98tuLEEP-Qv879dX9GhuIF4aDrwqVGMDLA&oe=69B002EF"}, "display_name": "Mystery Box VR: Hidden Secrets", "keywords": [], "long_description": " AN IMMERSIVE VR PUZZLE EXPERIENCE\nInteract with objects, handles, buttons, and wheels on each side. Crack enigmas and collect hidden puzzle tiles on a random side of the boxes.\n\nYou won't be able to compare reality with fiction.\n\n# DISCOVER INVENTIONS\nOnce you unlock all 8 boxes of a Level Pack, you can compose a puzzle and discover a brief history of an invention.\n\nIt's not always easy to escape the room, so use all your IQ to crack the riddles. There's a logic behind all of them, even where it seems it's not!\n\n# IMMERSIVE SOUNDTRACK\nPlay the game with your headphones to get immersed in this amazing adventure.\n\n# HINTS\nGot stuck on some enigma? No worries, you can still get a helpful hint! You can also get in touch with me in case you really can't make it through a riddle, I'll be glad to help ;)\n\n# MULTILANGUAGE\nAvailable in English, French, Italian, German, Spanish, Russian, and Japanese.\n\nThe game language will change automatically based on the language settings of your device", "short_description": "A VR escape room game where you have to solve intriguing riddles to open boxes and discover nice stories about popular inventions!"}, {"images": {"nodes": [{"file_name": "$R36BSY5.png", "id": "3678762505771822", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031430_3678762509105155_2151975047074617165_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uCjDl7xUpWEQ7kNvwHKltlx&_nc_oc=AdmQJVIjIqWDk_LsEqOlRVUiNaRlOpqgrHGySOIEmog5OstTMujnrQONQQosq0GsSvI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afy-zIxnRdSlZPfDUxFmHa7CC97Sa--qJrHvHIKlp32zxw&oe=69AFFEE5"}, {"file_name": "$R81V725.png", "id": "2720695481426567", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75262743_2720695484759900_604086922326600035_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vyqluxzvlLoQ7kNvwGObzoh&_nc_oc=AdkjExQUgpOspOHEKjK4kPw83NsyaCilGKRhSiUanF9CeWscf63rV5R1mQS-0i-jypk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfzV8KkB8vd6N8bUnwUClgQLYIMAtYqcMgJ2SCJGan_l8g&oe=69AFFDCD"}, {"file_name": "$RQ3SN6U.png", "id": "1552311425628973", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982519_1552311428962306_1218130395049083834_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D0gsCZKDokgQ7kNvwH2svjQ&_nc_oc=AdlK8CE4lgGsRpY-SUAN4cBt-R47xOGVsUJpmLO2Sbj9jfvF2vZvRiqARuT4LLQxrkI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfztVAmSkZfSsvxCw9xBfFp8tkuXKOOmSQzrKWdrlqZESg&oe=69B00929"}, {"file_name": "38982645_1000853181732648_505551742782
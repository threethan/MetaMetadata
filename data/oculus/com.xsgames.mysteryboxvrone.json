oculuscdn.com/v/t64.5771-25/39003282_467916356204742_1871921057092171900_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DrCKn-jmMhEQ7kNvwGeMPgE&_nc_oc=AdkwGjyY5vki7NAst_w0JIS5YbFR2KV5kXCJhl1hI3upWzlGD6TGjLYxiTdedA-1aCw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfwOee2y_a9c7dyXV-vFeUxgkH5iBXlTpBsLFzhG5zIe3A&oe=69B40E62"}, {"file_name": "3.png", "id": "1934382610375855", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974473_1934382613709188_7156337812617042679_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2C1EPFxSneAQ7kNvwFTBKI8&_nc_oc=AdmCZaDl2aRQKsKq5w9uURnhFosbbv1-J3oIzhUuUZ7FNUwUEraNS3_6MQhglflb3sU&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfwCi1oeHE3oyo37yLGkg_n3gyUIRgwRZCdfEMGuYRKPEA&oe=69B3F873"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape.png", "id": "1524760081483769", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974531_1524760084817102_6497712644828891067_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vsBrAafxQN4Q7kNvwENWJNk&_nc_oc=AdkVO9vv18tq5dYrxYhRuhkcTgu2XvDt9u0Fp0iW9L1RW_4PwrBZqKL0BczarVu_4fg&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfyMJ9YMsidplZwICLW0QygffQuQcP3Npy79G6-ys-vEdw&oe=69B3F76F"}, "display_name": "Mystery Box VR: Hidden Secrets", "keywords": [], "long_description": " AN IMMERSIVE VR PUZZLE EXPERIENCE\nInteract with objects, handles, buttons, and wheels on each side. Crack enigmas and collect hidden puzzle tiles on a random side of the boxes.\n\nYou won't be able to compare reality with fiction.\n\n# DISCOVER INVENTIONS\nOnce you unlock all 8 boxes of a Level Pack, you can compose a puzzle and discover a brief history of an invention.\n\nIt's not always easy to escape the room, so use all your IQ to crack the riddles. There's a logic behind all of them, even where it seems it's not!\n\n# IMMERSIVE SOUNDTRACK\nPlay the game with your headphones to get immersed in this amazing adventure.\n\n# HINTS\nGot stuck on some enigma? No worries, you can still get a helpful hint! You can also get in touch with me in case you really can't make it through a riddle, I'll be glad to help ;)\n\n# MULTILANGUAGE\nAvailable in English, French, Italian, German, Spanish, Russian, and Japanese.\n\nThe game language will change automatically based on the language settings of your device", "short_description": "A VR escape room game where you have to solve intriguing riddles to open boxes and discover nice stories about popular inventions!"}, {"images": {"nodes": [{"file_name": "$R36BSY5.png", "id": "3678762505771822", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031430_3678762509105155_2151975047074617165_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NzpCYikjf_oQ7kNvwGBkXLt&_nc_oc=Adm8miFp80NwrwX5P7_ihJG79SRQxQ8HmPb9yrotFqisXL8DY_jwEOkmGG1LQGyjkrY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_Afym9Wa442yb0uCn-MWvYkm6VPUtS7XEF6mdiucWlj8xNw&oe=69B3F365"}, {"file_name": "$R81V725.png", "id": "2720695481426567", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75262743_2720695484759900_604086922326600035_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d_4pHy4rrL4Q7kNvwHEHMGa&_nc_oc=AdkpUfS7bBmfSbuqo0xQbZgvtp4jZAyw7cYcswVe5BUkzqQY_CiMXeU9kiWzcWpqmLo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfxmZeqZQhHJkr3yisAWMIO6z3om7A1KEDzxul3VDHkvDg&oe=69B3F24D"}, {"file_name": "$RQ3SN6U.png", "id": "1552311425628973", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982519_1552311428962306_1218130395049083834_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jVSTOEIJFbcQ7kNvwGIuPOG&_nc_oc=AdmnqNxoLBupHsWRr-EKBlsOIghB-jO90a-KDTjEWJ3CSnGq61A8rM8vcDnOyttmPH8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfyCY01ioVEzyK3Wj67yISL4aF46_z583eTfmXKPVEYyNg&oe=69B3FDA9"}, {"file_name": "38982645_1000853181732648_505551742782
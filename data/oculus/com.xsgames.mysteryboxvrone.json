4PJpj5hQkZK76cYC-jAL24NylTWu6CaridTc_Z14w8_A&oe=6A0C7E44"}, {"file_name": "5.png", "id": "467916352871409", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/39003282_467916356204742_1871921057092171900_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vVLiaiFU1dgQ7kNvwExjILV&_nc_oc=Adqr2dba0SZU4wCnWa0z-t1c5KLwBRjW_anp5XeK9_mijxSNjLb0469b52hXnjGph08&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4w0o54af_-eGWORCzh0V8_FMNudpkFoBggIg16JkQzog&oe=6A0C62E2"}, {"file_name": "3.png", "id": "1934382610375855", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38974473_1934382613709188_7156337812617042679_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=paC6jcB2i58Q7kNvwGLUZ98&_nc_oc=Adq5fBlT3Wo1paUQLUH0avdgP33gkItyJCTGvxt18nB69vIAIdFEJP8xEJulj2wx6_w&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4aaRUxNAVK2bNNULe4JLtUmiRF56M7TFbWfWOk7Y5UiQ&oe=6A0C8533"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape.png", "id": "1524760081483769", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38974531_1524760084817102_6497712644828891067_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ssiNuv60_hMQ7kNvwHfpbpL&_nc_oc=AdpytQiOHtn00NANpe1E7iiCH-90qPBrT9A9zuyeMGKHiBKVz8BUY4EkQ5H9Z_ZZLkY&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4NcYhmZ8Hpqb2cyelRDvCG_cRPzKO-rLo9I5fUk5AHPg&oe=6A0C842F"}, "display_name": "Mystery Box VR: Hidden Secrets", "keywords": [], "long_description": " AN IMMERSIVE VR PUZZLE EXPERIENCE\nInteract with objects, handles, buttons, and wheels on each side. Crack enigmas and collect hidden puzzle tiles on a random side of the boxes.\n\nYou won't be able to compare reality with fiction.\n\n# DISCOVER INVENTIONS\nOnce you unlock all 8 boxes of a Level Pack, you can compose a puzzle and discover a brief history of an invention.\n\nIt's not always easy to escape the room, so use all your IQ to crack the riddles. There's a logic behind all of them, even where it seems it's not!\n\n# IMMERSIVE SOUNDTRACK\nPlay the game with your headphones to get immersed in this amazing adventure.\n\n# HINTS\nGot stuck on some enigma? No worries, you can still get a helpful hint! You can also get in touch with me in case you really can't make it through a riddle, I'll be glad to help ;)\n\n# MULTILANGUAGE\nAvailable in English, French, Italian, German, Spanish, Russian, and Japanese.\n\nThe game language will change automatically based on the language settings of your device", "short_description": "A VR escape room game where you have to solve intriguing riddles to open boxes and discover nice stories about popular inventions!"}, {"images": {"nodes": [{"file_name": "$R36BSY5.png", "id": "3678762505771822", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/39031430_3678762509105155_2151975047074617165_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aqJTBZbpsd4Q7kNvwENlnXL&_nc_oc=Adp2zu1cM8JxwZuEPFooUli5WT_XQAHhnLrrcE-Z96xSyGGZJR_RSSlonsbHSvgIdHI&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6ZnsUjCZrBHZPzKrueACO3FUCzHUHX4JPFD-6VgJ5kwg&oe=6A0C8025"}, {"file_name": "$R81V725.png", "id": "2720695481426567", "image_type": "APP_IMG_ICON", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/75262743_2720695484759900_604086922326600035_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2EO0t3CVuuwQ7kNvwHt0x4Y&_nc_oc=Adp2WI-mjpNDKJ_7dOZLFuA4gYSL85u3bmWEU8z76QOY4RRN26eaULoHYcOLVblbLL0&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4A1-ormL-gyMkXv_7rUrjJ7YLzS7O9drPNDNVFbUKykw&oe=6A0C7F0D"}, {"file_name": "$RQ3SN6U.png", "id": "1552311425628973", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38982519_1552311428962306_1218130395049083834_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZT62dKO0qyQQ7kNvwGVwd_s&_nc_oc=AdprqQX4sVpXfQymYw4MtgYaoBmwQguy08Zap0zJZRHDx7PUeKRBtn7o1YU2OO7EDNQ&_nc_zt=3&_nc_ht=
0GdBMZVdGZMRNSeYZ4IkZzvwsMAGu8UegiCgMR3G-luw&oe=69E36784"}, {"file_name": "5.png", "id": "467916352871409", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39003282_467916356204742_1871921057092171900_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c4R1xlAu_aEQ7kNvwE_0gYb&_nc_oc=AdqMVET9MS9bujp-NyNpVhk7XPmJW0LpTn2J-resdJR5bEqBxqVIPFuCLrcAzR_i_b4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1YH6WGsSHNGS4dy9HVjQSiWvlWeFO_Rmt8Tt-DTNDkIg&oe=69E38462"}, {"file_name": "3.png", "id": "1934382610375855", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974473_1934382613709188_7156337812617042679_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Pc6yK5bdpBEQ7kNvwFR1OXI&_nc_oc=Adp34qI6CmkTDfMcoxG_nKnE8ep8ldXR_yxoGEtVOxtXUxRqGNtwH8JiPDaKIOjUpzE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3m-p6I9504a9Ogu8MbBx_snniNonYwLAYFjEWFR4YlVg&oe=69E36E73"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape.png", "id": "1524760081483769", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974531_1524760084817102_6497712644828891067_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wUleitmcP6AQ7kNvwGRhOsX&_nc_oc=Adr3BY8ywwL7K_3juxBuzGmy0D7LkWOl7xa4MTYkxN0_z_yK-LaesjT325HXQUFXvyc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3oxVO7EqUPzqAuiAAYur7E1qd8PfyMSRvPeBIZGGMVFw&oe=69E36D6F"}, "display_name": "Mystery Box VR: Hidden Secrets", "keywords": [], "long_description": " AN IMMERSIVE VR PUZZLE EXPERIENCE\nInteract with objects, handles, buttons, and wheels on each side. Crack enigmas and collect hidden puzzle tiles on a random side of the boxes.\n\nYou won't be able to compare reality with fiction.\n\n# DISCOVER INVENTIONS\nOnce you unlock all 8 boxes of a Level Pack, you can compose a puzzle and discover a brief history of an invention.\n\nIt's not always easy to escape the room, so use all your IQ to crack the riddles. There's a logic behind all of them, even where it seems it's not!\n\n# IMMERSIVE SOUNDTRACK\nPlay the game with your headphones to get immersed in this amazing adventure.\n\n# HINTS\nGot stuck on some enigma? No worries, you can still get a helpful hint! You can also get in touch with me in case you really can't make it through a riddle, I'll be glad to help ;)\n\n# MULTILANGUAGE\nAvailable in English, French, Italian, German, Spanish, Russian, and Japanese.\n\nThe game language will change automatically based on the language settings of your device", "short_description": "A VR escape room game where you have to solve intriguing riddles to open boxes and discover nice stories about popular inventions!"}, {"images": {"nodes": [{"file_name": "$R36BSY5.png", "id": "3678762505771822", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031430_3678762509105155_2151975047074617165_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A3RfYpNNg94Q7kNvwGCb6d8&_nc_oc=AdqNne0hg81ghf8c7U2P6qSuINLNCibEyBzaCEFS8Krr3tuPKCJe9rlsx8PyVW3KCPs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3w9N0voHZVPytYrnG12iFJRUg2NUQihhZwMxOAgxrSpg&oe=69E36965"}, {"file_name": "$R81V725.png", "id": "2720695481426567", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75262743_2720695484759900_604086922326600035_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y_AHIxX8bHgQ7kNvwHCZLb0&_nc_oc=AdoVEC_SkPpw_zlJ4AlM-T36vd4sfmEUd-I3-ilU7WW82_fEU3QB5niu798CnQlSvCY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2gQozdVHAj8qVQZi8cuRzBJ2RZdA-d23QnmA4QbwOdcg&oe=69E3684D"}, {"file_name": "$RQ3SN6U.png", "id": "1552311425628973", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982519_1552311428962306_1218130395049083834_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wjGHhjMEfi4Q7kNvwFgNXpe&_nc_oc=AdqPuZgfvuLoj1R8bU-_hNm9wezsInciWGfM8FX_wO_yLFTZmUkmTzfN-vZCQakbm0Q&_nc_zt=3&_nc_ht=
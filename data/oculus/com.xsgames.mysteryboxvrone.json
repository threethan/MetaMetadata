SFV3POwYVt77_2iD_WqREogqRmKfZb8XupL7SCmwLNOw&oe=6AEB4BC4"}, {"file_name": "5.png", "id": "467916352871409", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39003282_467916356204742_1871921057092171900_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MgUAaWxKuxoQ7kNvwHyHc1f&_nc_oc=AdrNC2XzMoKNKw13yeaYtBAtie8IArdKDjA7PsLV7J4rmoE_fThSl2Ok_shX_74ORzI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTtyFYRB_gfGfAzdrPYqmhn42aP4GVhypHyy04hNQGBbw&oe=6AEB3062"}, {"file_name": "3.png", "id": "1934382610375855", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974473_1934382613709188_7156337812617042679_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k-c6xB5Xq7wQ7kNvwGN-gD2&_nc_oc=AdpunESzj1jVhyxXw6VrseKN-meaZPTeEi28z0ajGuJOBU9BC8hcIK2ERcCOtOwMwqY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTh_d5RTXhoyEeFpE88gc6zW7Y4f7T-GkzGMfO4RqGuhw&oe=6AEB52B3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape.png", "id": "1524760081483769", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974531_1524760084817102_6497712644828891067_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ICKTRBeXEK8Q7kNvwHuI951&_nc_oc=AdqV23tVXUsyyYsfv62JJ3ixVgMMR2ATtdTMrzwJvJRBj1gLRH0Hn_INzZD_lWTdPZc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTf2DbyoVIiLJXSx6aQzquYyQOA3WHZeDB2j78yCX3AdA&oe=6AEB51AF"}, "display_name": "Mystery Box VR: Hidden Secrets", "keywords": [], "long_description": " AN IMMERSIVE VR PUZZLE EXPERIENCE\nInteract with objects, handles, buttons, and wheels on each side. Crack enigmas and collect hidden puzzle tiles on a random side of the boxes.\n\nYou won't be able to compare reality with fiction.\n\n# DISCOVER INVENTIONS\nOnce you unlock all 8 boxes of a Level Pack, you can compose a puzzle and discover a brief history of an invention.\n\nIt's not always easy to escape the room, so use all your IQ to crack the riddles. There's a logic behind all of them, even where it seems it's not!\n\n# IMMERSIVE SOUNDTRACK\nPlay the game with your headphones to get immersed in this amazing adventure.\n\n# HINTS\nGot stuck on some enigma? No worries, you can still get a helpful hint! You can also get in touch with me in case you really can't make it through a riddle, I'll be glad to help ;)\n\n# MULTILANGUAGE\nAvailable in English, French, Italian, German, Spanish, Russian, and Japanese.\n\nThe game language will change automatically based on the language settings of your device", "short_description": "A VR escape room game where you have to solve intriguing riddles to open boxes and discover nice stories about popular inventions!"}, {"images": {"nodes": [{"file_name": "$R36BSY5.png", "id": "3678762505771822", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031430_3678762509105155_2151975047074617165_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NCIl_6hxvKgQ7kNvwFV7Mnu&_nc_oc=AdrczeQK-2jOd3gQsEOgD8A-iXyINDmRlI8_4NbtBWSUGbFZm0w3EeEXZeDgjGGmlMs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT3h_qNz1JzwyzWmu2wdJ9oCIQNlqpIsdpD7OUMTd-2hQ&oe=6AEB4DA5"}, {"file_name": "$R81V725.png", "id": "2720695481426567", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75262743_2720695484759900_604086922326600035_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6UmypCW4fe8Q7kNvwFjld3J&_nc_oc=Adq46ul-uxq08gsuGnLglfZTifRkhbrsQDToPsX3G7BA5bF_zbL7JlUCd8pWMemkCqY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRUNRdE5CrcT-I4uROMAa_BoCLl8h9Ouh0XZ720cZ34ZA&oe=6AEB4C8D"}, {"file_name": "$RQ3SN6U.png", "id": "1552311425628973", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982519_1552311428962306_1218130395049083834_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AnPUsIlYtIwQ7kNvwHdYtQC&_nc_oc=AdodPqfKbloqkYZqgetDSXVJ0Hu7-s4i105XSt5Lw1aeMfY2GD1en5VFGZ7fDGOBalU&_nc_zt=3&_nc_ht=
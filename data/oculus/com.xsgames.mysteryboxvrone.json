2sO8dbZGFkuvSbAfvxvSHW1hHcktPuIaV_6NnPh8n52g&oe=69E8AD84"}, {"file_name": "5.png", "id": "467916352871409", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39003282_467916356204742_1871921057092171900_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hDYDB3mACqgQ7kNvwFnhT1H&_nc_oc=Adq2WXTJLK2xRTzZCmJwXw14uiu-RmR-uJk7qVOhnB3qComE0EcuFbaB3E87Vt1ao3w&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3Cow1VMzKcWFIKjy2weu9Z44rjaAgCrawJaSJmwcV4JA&oe=69E8CA62"}, {"file_name": "3.png", "id": "1934382610375855", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974473_1934382613709188_7156337812617042679_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Fz2HJf9NJi8Q7kNvwFSi8qS&_nc_oc=Adrq6VEcZ6vAMe_MPYKemwIDASkIhEMYmrfyoj_pGe9Xi2cZzcmHqlVe9UdEpE-J0xE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2EeBn_9Bp28H7nv6xwfh3oKBLGOCfPBlkFLezZZSgHHQ&oe=69E8B473"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape.png", "id": "1524760081483769", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974531_1524760084817102_6497712644828891067_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_c2ksM2-VSQQ7kNvwHTtTKM&_nc_oc=Ado4DzK8wClwY1jG3VZOx90bwMTvnyzH0xxqsSp33Xl2RN7nIOUA7KTkq3avLDquBuc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af02ETzI7HHapmvP5REUAKQQiTXqDs4xOfZ5sQy6KdeORw&oe=69E8B36F"}, "display_name": "Mystery Box VR: Hidden Secrets", "keywords": [], "long_description": " AN IMMERSIVE VR PUZZLE EXPERIENCE\nInteract with objects, handles, buttons, and wheels on each side. Crack enigmas and collect hidden puzzle tiles on a random side of the boxes.\n\nYou won't be able to compare reality with fiction.\n\n# DISCOVER INVENTIONS\nOnce you unlock all 8 boxes of a Level Pack, you can compose a puzzle and discover a brief history of an invention.\n\nIt's not always easy to escape the room, so use all your IQ to crack the riddles. There's a logic behind all of them, even where it seems it's not!\n\n# IMMERSIVE SOUNDTRACK\nPlay the game with your headphones to get immersed in this amazing adventure.\n\n# HINTS\nGot stuck on some enigma? No worries, you can still get a helpful hint! You can also get in touch with me in case you really can't make it through a riddle, I'll be glad to help ;)\n\n# MULTILANGUAGE\nAvailable in English, French, Italian, German, Spanish, Russian, and Japanese.\n\nThe game language will change automatically based on the language settings of your device", "short_description": "A VR escape room game where you have to solve intriguing riddles to open boxes and discover nice stories about popular inventions!"}, {"images": {"nodes": [{"file_name": "$R36BSY5.png", "id": "3678762505771822", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031430_3678762509105155_2151975047074617165_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SFQzbCp1j3sQ7kNvwHmU6J6&_nc_oc=AdqzFLWQQqKPbXC6XmshpOLLo32bO_AcJ1Sv0pbrW80d674R4Ht8yjU2NGuBGZRunTU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3VhBTOvOepLQpgrOyHWXL-IoaUkdcRzJ2KnTRHTfk60Q&oe=69E8AF65"}, {"file_name": "$R81V725.png", "id": "2720695481426567", "image_type": "APP_IMG_ICON", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75262743_2720695484759900_604086922326600035_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jEJom_-9AHIQ7kNvwHQIWlW&_nc_oc=AdpS8_-x5WKZiiszwPsRVMyBeEO5orfKtDLFlNZvGK-JAOkzgFtTIzainTgH0FWv2mE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3KoaChudQyRl5gKjge72nXE7X2UfgomohKZIQTM9fQpg&oe=69E8AE4D"}, {"file_name": "$RQ3SN6U.png", "id": "1552311425628973", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982519_1552311428962306_1218130395049083834_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3IpkNCyuN6AQ7kNvwHYRAx9&_nc_oc=Ado8N5ze7vBKCfXfAxGCHfUOQnzv72AeWvHiro8Fu5FGc6dgY0-JZr5K6Ah9Jye1Qd4&_nc_zt=3&_nc_ht=
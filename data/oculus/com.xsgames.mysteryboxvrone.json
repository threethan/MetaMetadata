5ncS0wAFI7qCQPWWc8iP7nvXTfU9uVHVLD-W6eRzQpBg&oe=6A0343C4"}, {"file_name": "5.png", "id": "467916352871409", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39003282_467916356204742_1871921057092171900_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sDZB5jIsWZ4Q7kNvwEFyhcR&_nc_oc=AdrRDzBwXaVPD9OaYZAknYp2CW8HFQzJLFjjn7ifWBnOxxKX3y2K_yetRUqVTu5BcdE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7PX-JRx81DxtSGWrMOR9Y1UuiCQAgAEKjilQlZRTsryg&oe=6A032862"}, {"file_name": "3.png", "id": "1934382610375855", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974473_1934382613709188_7156337812617042679_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tc1EVpcD5VIQ7kNvwEEVnR2&_nc_oc=AdpvvIFC5KtOJaiEdx9oZq0b-jaoX1JYeRYsdVZ9WpuM8iyTYLlrWjSD6LJ0rqc1fwM&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5GKdvHZSk8S_EzsVLanCnngL6twQel3mnoxOI09k1apQ&oe=6A034AB3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape.png", "id": "1524760081483769", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974531_1524760084817102_6497712644828891067_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VCgSacJElNwQ7kNvwG_D4UI&_nc_oc=AdqswNi51eYG6icrgMqvAHjzFmO-b7fJenhDnvHy-Pp3VxXcVXs8-aikDx9TbCEvnO0&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7wyRJek3K-iL2WyVPoRRx5-q1xHxp5UNznmfnDh8N_sw&oe=6A0349AF"}, "display_name": "Mystery Box VR: Hidden Secrets", "keywords": [], "long_description": " AN IMMERSIVE VR PUZZLE EXPERIENCE\nInteract with objects, handles, buttons, and wheels on each side. Crack enigmas and collect hidden puzzle tiles on a random side of the boxes.\n\nYou won't be able to compare reality with fiction.\n\n# DISCOVER INVENTIONS\nOnce you unlock all 8 boxes of a Level Pack, you can compose a puzzle and discover a brief history of an invention.\n\nIt's not always easy to escape the room, so use all your IQ to crack the riddles. There's a logic behind all of them, even where it seems it's not!\n\n# IMMERSIVE SOUNDTRACK\nPlay the game with your headphones to get immersed in this amazing adventure.\n\n# HINTS\nGot stuck on some enigma? No worries, you can still get a helpful hint! You can also get in touch with me in case you really can't make it through a riddle, I'll be glad to help ;)\n\n# MULTILANGUAGE\nAvailable in English, French, Italian, German, Spanish, Russian, and Japanese.\n\nThe game language will change automatically based on the language settings of your device", "short_description": "A VR escape room game where you have to solve intriguing riddles to open boxes and discover nice stories about popular inventions!"}, {"images": {"nodes": [{"file_name": "$R36BSY5.png", "id": "3678762505771822", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031430_3678762509105155_2151975047074617165_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2nn_jMYQG_YQ7kNvwE9OYDj&_nc_oc=AdqrMEXwMqhbUuQIAuDZXqCUqxk0VOC2y_dE7XNcbzXYWwN3k7xU_DdvHRIyotnIXw0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7D3xAA7_tPYbySP49_mfmHRGD8f7yZwH0vD97C2e1f5A&oe=6A0345A5"}, {"file_name": "$R81V725.png", "id": "2720695481426567", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75262743_2720695484759900_604086922326600035_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QjQcp7X5A7sQ7kNvwEB45MF&_nc_oc=AdogO1S9YMCRn-G7CcBMi20V2ihgDa7lKGAwRh9pMpSejhCUE-xgG7wDhLA50jsf3I8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7aDqXQb06_qrPTMXXFXu3Mh510rfevvycvICJxBA8HqA&oe=6A03448D"}, {"file_name": "$RQ3SN6U.png", "id": "1552311425628973", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982519_1552311428962306_1218130395049083834_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VINS1rQ9bygQ7kNvwFSnOMM&_nc_oc=AdpFqJgT2t0uaSo9I4Jl8Iek2hmtkleJ9XeHYoCN2J3nIoNhNeQC0bnQ4HehOLGU5z0&_nc_zt=3&_nc_ht=
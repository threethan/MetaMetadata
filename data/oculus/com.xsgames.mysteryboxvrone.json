3kxStD1yktADbUw4MeH5l-EENy95_DhEAXqaIOo7k4fw&oe=69DCD004"}, {"file_name": "5.png", "id": "467916352871409", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39003282_467916356204742_1871921057092171900_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2xW7RFYK8FcQ7kNvwEEQlB_&_nc_oc=AdqO4qmcQrWoAPmlg8tk6AzZKPvyrmP2i9bOmLHNeGJBzGNMLuFaFW5LSDkZ2kVDt2I&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af18btHJAAPQ8HP76QcrM-OmDHtRbBJ6YsjdM-FjlvD_AQ&oe=69DCECE2"}, {"file_name": "3.png", "id": "1934382610375855", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974473_1934382613709188_7156337812617042679_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5tPaQvxgezsQ7kNvwFkDRpr&_nc_oc=Adqf216Pl5mVQfDzUMlP4Uc6fwKxYGpv4hCUmGyfavTk82ntp81iDWi3_RY3jj6Rc7U&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3nAKlUR6AuMaW09T_mTTHwOQ3lbVLIzSMdx3TwPPRAKA&oe=69DCD6F3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape.png", "id": "1524760081483769", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974531_1524760084817102_6497712644828891067_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RV6LqbxZfH0Q7kNvwFDWnQP&_nc_oc=AdoIZ3kqe6lsSki76JYIew1dY4mdquXTTBjYii8P85PaiYDN_Z-W7hVOUHtWwcIPNBM&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1rjSR_Oq4NWsPczra9Im0U1-JRG918Qjp23hCGG5NQdw&oe=69DCD5EF"}, "display_name": "Mystery Box VR: Hidden Secrets", "keywords": [], "long_description": " AN IMMERSIVE VR PUZZLE EXPERIENCE\nInteract with objects, handles, buttons, and wheels on each side. Crack enigmas and collect hidden puzzle tiles on a random side of the boxes.\n\nYou won't be able to compare reality with fiction.\n\n# DISCOVER INVENTIONS\nOnce you unlock all 8 boxes of a Level Pack, you can compose a puzzle and discover a brief history of an invention.\n\nIt's not always easy to escape the room, so use all your IQ to crack the riddles. There's a logic behind all of them, even where it seems it's not!\n\n# IMMERSIVE SOUNDTRACK\nPlay the game with your headphones to get immersed in this amazing adventure.\n\n# HINTS\nGot stuck on some enigma? No worries, you can still get a helpful hint! You can also get in touch with me in case you really can't make it through a riddle, I'll be glad to help ;)\n\n# MULTILANGUAGE\nAvailable in English, French, Italian, German, Spanish, Russian, and Japanese.\n\nThe game language will change automatically based on the language settings of your device", "short_description": "A VR escape room game where you have to solve intriguing riddles to open boxes and discover nice stories about popular inventions!"}, {"images": {"nodes": [{"file_name": "$R36BSY5.png", "id": "3678762505771822", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031430_3678762509105155_2151975047074617165_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T33KLF-vSkQQ7kNvwF3PTmO&_nc_oc=AdohiCAIRXcFF8i-FJdVms9BCOQX8CPl_Wgkf-IPI5CtAtWSJYKwv9GHAyoS7ayNCXs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af39AvEniuI7aCm90ztRlHNEDkirg1j8R2f0U6Rpn8PPyA&oe=69DCD1E5"}, {"file_name": "$R81V725.png", "id": "2720695481426567", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75262743_2720695484759900_604086922326600035_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C1uhwJC9RV4Q7kNvwFnbI-K&_nc_oc=Adr1aE6xKwgA4rG_SkInMlBrzuWWH4VLDziVsYy8In5WbGDUpNa6taL-ncMy-_O0UlE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2ooKGcnlHU3IdNLHms-jTfisnV-HcbVyo4YpgoQUqUrQ&oe=69DCD0CD"}, {"file_name": "$RQ3SN6U.png", "id": "1552311425628973", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982519_1552311428962306_1218130395049083834_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=juWwt7Nu2DsQ7kNvwEpgTgn&_nc_oc=AdrNQYnSaxVChH5wKocTYde_rMXqul9gA8TdVh86s7e-qKmD7bzYEKIp3fGHEB0XSI0&_nc_zt=3&_nc_ht=
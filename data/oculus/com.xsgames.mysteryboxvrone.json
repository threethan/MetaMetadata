FRCMkfnYwSiiG3Y4rqan2Tjicy_tgPpSq2yOYEKu47Ew&oe=6A8AD604"}, {"file_name": "5.png", "id": "467916352871409", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39003282_467916356204742_1871921057092171900_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J0IvyZF5fu8Q7kNvwFNx8ZZ&_nc_oc=AdoKQW_t5WytzXGesF8D4RQLeKqiXO_wGKRKVTfdpBgKWo1Yc6SbU6uENBLQwSs8VOE&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHv-XtWM4SDrT0HracKNLlTyl6Ricif85t3dyZDgtUU7g&oe=6A8AF2E2"}, {"file_name": "3.png", "id": "1934382610375855", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974473_1934382613709188_7156337812617042679_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iypWcf_2E60Q7kNvwHZRxbW&_nc_oc=Adq7uD5vGGvWKC2yBEK3MxOw7f9SM3nhJmq273r9_uYKGZE-W9y3TXy66oAzEFxYH30&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEP8jBwQsDSoB1OGgdDfv6BsRfWlEITHzTpuedoIz_dvw&oe=6A8ADCF3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape.png", "id": "1524760081483769", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974531_1524760084817102_6497712644828891067_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kAPrwTQO1PwQ7kNvwHPkmKg&_nc_oc=AdrEksVTvxGhzCPZhLPuX1JVbiDhhSxP4klwADsGaUeS72Vw6T3c0i-ALzN3T6oFzLE&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEfu-FZ0HputRFbRfmOJAlM6y1pW2ziSZsKBtM0tl164Q&oe=6A8ADBEF"}, "display_name": "Mystery Box VR: Hidden Secrets", "keywords": [], "long_description": " AN IMMERSIVE VR PUZZLE EXPERIENCE\nInteract with objects, handles, buttons, and wheels on each side. Crack enigmas and collect hidden puzzle tiles on a random side of the boxes.\n\nYou won't be able to compare reality with fiction.\n\n# DISCOVER INVENTIONS\nOnce you unlock all 8 boxes of a Level Pack, you can compose a puzzle and discover a brief history of an invention.\n\nIt's not always easy to escape the room, so use all your IQ to crack the riddles. There's a logic behind all of them, even where it seems it's not!\n\n# IMMERSIVE SOUNDTRACK\nPlay the game with your headphones to get immersed in this amazing adventure.\n\n# HINTS\nGot stuck on some enigma? No worries, you can still get a helpful hint! You can also get in touch with me in case you really can't make it through a riddle, I'll be glad to help ;)\n\n# MULTILANGUAGE\nAvailable in English, French, Italian, German, Spanish, Russian, and Japanese.\n\nThe game language will change automatically based on the language settings of your device", "short_description": "A VR escape room game where you have to solve intriguing riddles to open boxes and discover nice stories about popular inventions!"}, {"images": {"nodes": [{"file_name": "$R36BSY5.png", "id": "3678762505771822", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39031430_3678762509105155_2151975047074617165_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gZ_TfERnMz0Q7kNvwFbtCz-&_nc_oc=Adp_O3qYxybmsCOkkcJNfk4tykG5a4VdvXNUWMwiG35bgakIrq7mwnIady--0Itk-pU&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHEMqW2LCBc25mmh9yLIs97etpRHQEuM-CaZ181Da-bkg&oe=6A8AD7E5"}, {"file_name": "$R81V725.png", "id": "2720695481426567", "image_type": "APP_IMG_ICON", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/75262743_2720695484759900_604086922326600035_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4MTCceR7KigQ7kNvwGudINg&_nc_oc=AdrwLxXrq3ywKZ2aAt4H-fEdzn1tMdBpjdPTst7jpO1MNgkt2snMVVqfGYQO06K7K9U&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHzoulP-zTjfNB-xAuBzk4hxyOIJ1BKG6MO7b5T9GByXg&oe=6A8AD6CD"}, {"file_name": "$RQ3SN6U.png", "id": "1552311425628973", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38982519_1552311428962306_1218130395049083834_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=urfsbveJpZ4Q7kNvwFu0Btl&_nc_oc=AdriHZa6bq4iGCljxXJZFkgBkAKmNg5M4D2Fhv6slNdYdpBIy1SdmvJhQ3f1iU7-nzw&_nc_zt=3&_nc_ht=
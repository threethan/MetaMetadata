3Ni3c9agTl0oHE8gPSktxZ0yMMLINmeczpM-pb9MISfQ&oe=69DF7304"}, {"file_name": "5.png", "id": "467916352871409", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39003282_467916356204742_1871921057092171900_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2xW7RFYK8FcQ7kNvwFdhRqM&_nc_oc=AdqyaIhNdJ_Y5Ts52WohIm7rdcLuICNfQUvsyYVpgWHSI8uLsXtSJPNlcOP4RRGc77c&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0FnKd4cNqyUR8iqMkI7uJhkDU3GoQbXYhZA6-3g7u9wQ&oe=69DF8FE2"}, {"file_name": "3.png", "id": "1934382610375855", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974473_1934382613709188_7156337812617042679_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dj5KnVXF7AIQ7kNvwHOc928&_nc_oc=AdosCnaCl32GO-1d63Q6FszSivmc9eXmzw_sxU_9SKrwljNGlv5_p3a0y_m0lY6VGXo&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0SEPPSrxShxmAOttuVqOuxt_qLlL0ISCBKfMlL77UNhQ&oe=69DF79F3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape.png", "id": "1524760081483769", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974531_1524760084817102_6497712644828891067_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RV6LqbxZfH0Q7kNvwFozqha&_nc_oc=AdqxH6EZeLE7sKZaJVTOYZM1ZRCQPGI63DGcTZ8COu53k1GiN2SP8FSavulQnm1HYFM&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af27wwvXA-zM1Lht9FEGwlcND1tJRgRQl6_5NDAh-j-1kw&oe=69DF78EF"}, "display_name": "Mystery Box VR: Hidden Secrets", "keywords": [], "long_description": " AN IMMERSIVE VR PUZZLE EXPERIENCE\nInteract with objects, handles, buttons, and wheels on each side. Crack enigmas and collect hidden puzzle tiles on a random side of the boxes.\n\nYou won't be able to compare reality with fiction.\n\n# DISCOVER INVENTIONS\nOnce you unlock all 8 boxes of a Level Pack, you can compose a puzzle and discover a brief history of an invention.\n\nIt's not always easy to escape the room, so use all your IQ to crack the riddles. There's a logic behind all of them, even where it seems it's not!\n\n# IMMERSIVE SOUNDTRACK\nPlay the game with your headphones to get immersed in this amazing adventure.\n\n# HINTS\nGot stuck on some enigma? No worries, you can still get a helpful hint! You can also get in touch with me in case you really can't make it through a riddle, I'll be glad to help ;)\n\n# MULTILANGUAGE\nAvailable in English, French, Italian, German, Spanish, Russian, and Japanese.\n\nThe game language will change automatically based on the language settings of your device", "short_description": "A VR escape room game where you have to solve intriguing riddles to open boxes and discover nice stories about popular inventions!"}, {"images": {"nodes": [{"file_name": "$R36BSY5.png", "id": "3678762505771822", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031430_3678762509105155_2151975047074617165_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YVFoDO5KZWcQ7kNvwGk0Hvu&_nc_oc=Adr6W1I68zdvL-79efBrLjk1sXXs8GgtZAQmO6Dk6WWjcL-cCtJ3fH5LbMLhXxn3n2E&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0tKtTk5uNa22iZ93x_cFIef6Js5P8KY6pg_7PryOfafg&oe=69DF74E5"}, {"file_name": "$R81V725.png", "id": "2720695481426567", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75262743_2720695484759900_604086922326600035_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EZGaiXNV2GUQ7kNvwH38LTa&_nc_oc=AdrR9OQbybm-wGz12aQB_rYRgpbfQAjD6I39kE2mgGVaKfUufOm7L_kqb16YQFSBeto&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2yQSQz552sR1bMPuBkdUFL-wsGr8U8YyQ_FC-W_9gTwQ&oe=69DF73CD"}, {"file_name": "$RQ3SN6U.png", "id": "1552311425628973", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982519_1552311428962306_1218130395049083834_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XmWbYQn0rpEQ7kNvwFpMhWW&_nc_oc=Ado-xnv_C3MYdfp7Ehg6Kh-8w3hB8nOig4LLApayhnliOAYWSk1udgaQr2Xium8Naag&_nc_zt=3&_nc_ht=
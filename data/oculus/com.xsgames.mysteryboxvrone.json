9z2PU2CG_cHCmV-jbqFmOoOL-yCe3ChZmS1QubMkQ3Tg&oe=6A428BC4"}, {"file_name": "5.png", "id": "467916352871409", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39003282_467916356204742_1871921057092171900_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SDrgiPx58-cQ7kNvwFBXTrC&_nc_oc=Adp6WXUlJzJAWtbu1zfN_uiKnSuDhwxA3LL9o_NgYJUJaVJgQmT425CbKOFiCYtoDnk&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-c7cc7eDPX8jXeiVVTZc0fMTne4r7rScrQnbmD-GuTyQ&oe=6A427062"}, {"file_name": "3.png", "id": "1934382610375855", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974473_1934382613709188_7156337812617042679_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BnjajQEWy9cQ7kNvwFQ4ak1&_nc_oc=AdrB-rW6SF0UXlbliLzoOQwd3L7SeNHsh5v8oxnlxdkJ_aejNSF4SVgWVUBM04B8_aY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_pj_8bKXoLIVkq7VfJtEDIq3WPrsbGUeODhcSGWf0Tpw&oe=6A4292B3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape.png", "id": "1524760081483769", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974531_1524760084817102_6497712644828891067_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XNEzD2zC-usQ7kNvwF3ge7X&_nc_oc=Adr9qo63sCqOGiOqRs5EdnRFo0tbdKh8xTSyoA7FObpJiDA0ybNGl1NbyhBxL7xkFhs&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_JKhcD-mt3tCmCuTvQZGMKJPq6KhYGoyLHRhf8Q67TUQ&oe=6A4291AF"}, "display_name": "Mystery Box VR: Hidden Secrets", "keywords": [], "long_description": " AN IMMERSIVE VR PUZZLE EXPERIENCE\nInteract with objects, handles, buttons, and wheels on each side. Crack enigmas and collect hidden puzzle tiles on a random side of the boxes.\n\nYou won't be able to compare reality with fiction.\n\n# DISCOVER INVENTIONS\nOnce you unlock all 8 boxes of a Level Pack, you can compose a puzzle and discover a brief history of an invention.\n\nIt's not always easy to escape the room, so use all your IQ to crack the riddles. There's a logic behind all of them, even where it seems it's not!\n\n# IMMERSIVE SOUNDTRACK\nPlay the game with your headphones to get immersed in this amazing adventure.\n\n# HINTS\nGot stuck on some enigma? No worries, you can still get a helpful hint! You can also get in touch with me in case you really can't make it through a riddle, I'll be glad to help ;)\n\n# MULTILANGUAGE\nAvailable in English, French, Italian, German, Spanish, Russian, and Japanese.\n\nThe game language will change automatically based on the language settings of your device", "short_description": "A VR escape room game where you have to solve intriguing riddles to open boxes and discover nice stories about popular inventions!"}, {"images": {"nodes": [{"file_name": "$R36BSY5.png", "id": "3678762505771822", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031430_3678762509105155_2151975047074617165_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T8QOtkEN4VAQ7kNvwHtYa1V&_nc_oc=AdoqS8vB_Jfm2mMHxtK2i-FLMmWlSWA4qVLwK3pA7W_qVmfhbt7xgewPUFOSYzktKOQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9bv3lDiGS6bUS-o5gbSlQQfmGrZ82h5TOZhZK_oX5kFw&oe=6A428DA5"}, {"file_name": "$R81V725.png", "id": "2720695481426567", "image_type": "APP_IMG_ICON", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75262743_2720695484759900_604086922326600035_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uUEsYVmGYyUQ7kNvwGEvRqI&_nc_oc=AdqIm7GIfj1xCbQ2d1DCkucFNZWbaMpkhACEVjmkEZXe6PNzM5LcB2YkGNFmyiSZBqc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-vXQLSP3GcnY9G6ByzC-KlV9KJhlknJur0i-HAic09Tg&oe=6A428C8D"}, {"file_name": "$RQ3SN6U.png", "id": "1552311425628973", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982519_1552311428962306_1218130395049083834_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rehVSG4TarUQ7kNvwGJTYMn&_nc_oc=Adr2LrDfVjCUq4SHLeMZthB7KLmnNu5YGJAGZWfBIpW6sm5bV_8kiS1uQ5-hE8rntls&_nc_zt=3&_nc_ht=
nc_ss=7f20f&oh=00_Af6xuUbXEsBI60x_6GxF_tHu0SYw4NRo79889MtQGYgIVA&oe=6A11C444"}, {"file_name": "5.png", "id": "467916352871409", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/39003282_467916356204742_1871921057092171900_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XL6RBML6uD8Q7kNvwFO0Shx&_nc_oc=Adp_Do1znLFfw3ESR3dfUsM5Pm9v3BHzCeWgT9_Ydvv0wlFAOOcouR9xMN5K9_xkkdA&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5WtuZSuvGTJaJ3igQnldI2OLh_6w8wPEdwxxASEohQPQ&oe=6A11A8E2"}, {"file_name": "3.png", "id": "1934382610375855", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/38974473_1934382613709188_7156337812617042679_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1jTTxvLvzsQQ7kNvwGXqghi&_nc_oc=AdrgNC_UZVqAa_b5z6TNIxVGmWaYIDZkXf490dR_zfminavR6zz0eQaqiZXbEhMOALk&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7DCvISVdHabBPZxrbJkI_DGg7ninOHj-08nR5SoYkY-Q&oe=6A11CB33"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape.png", "id": "1524760081483769", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/38974531_1524760084817102_6497712644828891067_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q5VWurG7QAUQ7kNvwHk5K6i&_nc_oc=AdqXegBCvvXtylTCTLEjP0hoTfhvj7CAuTjE1KayFP5nJAFTEWyE0tYsi-xXbYEisZE&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4b8M2W59zV20hlfFomHP5NZXfJ4qS9sgiVVRAoSsaJsQ&oe=6A11CA2F"}, "display_name": "Mystery Box VR: Hidden Secrets", "keywords": [], "long_description": " AN IMMERSIVE VR PUZZLE EXPERIENCE\nInteract with objects, handles, buttons, and wheels on each side. Crack enigmas and collect hidden puzzle tiles on a random side of the boxes.\n\nYou won't be able to compare reality with fiction.\n\n# DISCOVER INVENTIONS\nOnce you unlock all 8 boxes of a Level Pack, you can compose a puzzle and discover a brief history of an invention.\n\nIt's not always easy to escape the room, so use all your IQ to crack the riddles. There's a logic behind all of them, even where it seems it's not!\n\n# IMMERSIVE SOUNDTRACK\nPlay the game with your headphones to get immersed in this amazing adventure.\n\n# HINTS\nGot stuck on some enigma? No worries, you can still get a helpful hint! You can also get in touch with me in case you really can't make it through a riddle, I'll be glad to help ;)\n\n# MULTILANGUAGE\nAvailable in English, French, Italian, German, Spanish, Russian, and Japanese.\n\nThe game language will change automatically based on the language settings of your device", "short_description": "A VR escape room game where you have to solve intriguing riddles to open boxes and discover nice stories about popular inventions!"}, {"images": {"nodes": [{"file_name": "$R36BSY5.png", "id": "3678762505771822", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/39031430_3678762509105155_2151975047074617165_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h4l9p0LZF4UQ7kNvwGtHm04&_nc_oc=Adrj7kLR8g56g1JAMn-Z-zsXe-wTuFP6N8sVykAuTf8fHQfMlg_YeBsfRtxR4bmxcB8&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5qn7cZdX48hcOchDeMW7Tbn0NdWqGHJUdYKnWCkYnShA&oe=6A11C625"}, {"file_name": "$R81V725.png", "id": "2720695481426567", "image_type": "APP_IMG_ICON", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/75262743_2720695484759900_604086922326600035_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GG8uWdIx76wQ7kNvwF2vBu6&_nc_oc=Adq8G4phA0BIZB4HgKzKpfyhrJVGnc1U01thaQjTk4PPGb2vVPIWrkccO74Ha3F5XoA&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5SVwrZQFyanZG3LkoftCgeuhT-ZrRmD3dF5iQt5ndTrQ&oe=6A11C50D"}, {"file_name": "$RQ3SN6U.png", "id": "1552311425628973", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/38982519_1552311428962306_1218130395049083834_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A6A1j3G1e6kQ7kNvwG6nUA_&_nc_oc=Adp-CniQsTXYMZKPp4uvzE4_J8cGLtoNjVENV1DRQHa469em_xeLvXOk4Gdy
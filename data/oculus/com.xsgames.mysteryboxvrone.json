ErQknm7U2Zu0Y5zmv7NWwkozlv5oylAVbtDSdtpYtW_g&oe=6A916D84"}, {"file_name": "5.png", "id": "467916352871409", "uri": "https://scontent-hkg1-1.oculuscdn.com/v/t64.5771-25/39003282_467916356204742_1871921057092171900_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BM3TwgzpbHYQ7kNvwGVFCzf&_nc_oc=AdrZ6P4iCakCwVyj2x9kDR-Ps7hqh73AB8q3SlJhS28qBsjE1JmkVkCD2ffIJ8YUrAw&_nc_zt=3&_nc_ht=scontent-hkg1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHee2Kb3kuOab4RBElqGGXmrwIpC4ymuu8qOqzkgGu3bQ&oe=6A918A62"}, {"file_name": "3.png", "id": "1934382610375855", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/38974473_1934382613709188_7156337812617042679_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wkfSq0-TOhgQ7kNvwEhl0Yi&_nc_oc=AdpPFLkdVwqRJZMaKRGOP0X7KgSRAtEI87rUcxAptDWiT42nAJjUvg4wRFT02JLVKGM&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFIESJ_nBWzZ8N-Y50Vm8uScu-1wNSV_8BZu-XF3ufn2Q&oe=6A917473"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape.png", "id": "1524760081483769", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/38974531_1524760084817102_6497712644828891067_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4d3YnYNtx_YQ7kNvwHiz3t6&_nc_oc=Ado96v82AK56M4Z8WUpeKayOw4zWYv_iQLfQQeA8-FcF9X3qk4EsoJh9HCxpPQz-uJo&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHA9Y-SztT68N7oz6rJMiywO08818-oz2fyz9E1aaIPXw&oe=6A91736F"}, "display_name": "Mystery Box VR: Hidden Secrets", "keywords": [], "long_description": " AN IMMERSIVE VR PUZZLE EXPERIENCE\nInteract with objects, handles, buttons, and wheels on each side. Crack enigmas and collect hidden puzzle tiles on a random side of the boxes.\n\nYou won't be able to compare reality with fiction.\n\n# DISCOVER INVENTIONS\nOnce you unlock all 8 boxes of a Level Pack, you can compose a puzzle and discover a brief history of an invention.\n\nIt's not always easy to escape the room, so use all your IQ to crack the riddles. There's a logic behind all of them, even where it seems it's not!\n\n# IMMERSIVE SOUNDTRACK\nPlay the game with your headphones to get immersed in this amazing adventure.\n\n# HINTS\nGot stuck on some enigma? No worries, you can still get a helpful hint! You can also get in touch with me in case you really can't make it through a riddle, I'll be glad to help ;)\n\n# MULTILANGUAGE\nAvailable in English, French, Italian, German, Spanish, Russian, and Japanese.\n\nThe game language will change automatically based on the language settings of your device", "short_description": "A VR escape room game where you have to solve intriguing riddles to open boxes and discover nice stories about popular inventions!"}, {"images": {"nodes": [{"file_name": "$R36BSY5.png", "id": "3678762505771822", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/39031430_3678762509105155_2151975047074617165_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PQnnB5bHV9EQ7kNvwFLkIkh&_nc_oc=AdoQNd0QJ09SaEDqyyRnxbv3YwETqz_KC4AvS4iBuPF5YSpNAgR019JMIunmnRAii8I&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEmwC-DO7QQTbs9g5kA3PAR9w_AxcrcI6thrqZQYBhA4Q&oe=6A916F65"}, {"file_name": "$R81V725.png", "id": "2720695481426567", "image_type": "APP_IMG_ICON", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/75262743_2720695484759900_604086922326600035_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jsG7AtjjXYEQ7kNvwFHPvRE&_nc_oc=AdoP5C3TEw5rWIUTeMohjQ-cmbHAN2_0DYNBECWIJzsfO4RX2r9VplkbhuNoO59oD-4&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGAAfCl_WyGyM1vmUO9g1xGfwk7L0kZNVUfx1T-raafXw&oe=6A916E4D"}, {"file_name": "$RQ3SN6U.png", "id": "1552311425628973", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-hkg4-2.oculuscdn.com/v/t64.5771-25/38982519_1552311428962306_1218130395049083834_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f2HaORYpxI4Q7kNvwHwqpyd&_nc_oc=Adr4x5kgCBBalTQN6dk78ksTJoKKcNBWXHGyiZeeei7n3whKhg1wGEijiCTocR9YVi4&_nc_zt=3&_nc_ht=
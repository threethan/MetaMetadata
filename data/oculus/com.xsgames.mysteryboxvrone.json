Lft08cCm0znlBavlkJexQg5wyqn41Jtjr90jcB8D06mA&oe=6AA80F44"}, {"file_name": "5.png", "id": "467916352871409", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39003282_467916356204742_1871921057092171900_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0mtlw1ZTugIQ7kNvwExPY5t&_nc_oc=Adq-knue_Pv11KPlzX76XzQvCajxFwTaug2P0pT_KiXIdiB-lZ-AajI8_Qme-dk2eU8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKrms_lim3Od6pxuH2pE3Gtj6LMbunsXbwNGrpUw6H4SQ&oe=6AA7F3E2"}, {"file_name": "3.png", "id": "1934382610375855", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974473_1934382613709188_7156337812617042679_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CblUJRquxL0Q7kNvwESk4H7&_nc_oc=AdrmwOMpzbRKzTFwUb_Rlz8tpdTj_VOvv0esE2BWF-IDotOTAV2ZN1SIxbCCh_H-gBw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLUZ5qiDn-iVNNF0aDA_STJhWQxR15Xljd9DtsoBHTkjA&oe=6AA81633"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape.png", "id": "1524760081483769", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974531_1524760084817102_6497712644828891067_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1UObAv9fq6QQ7kNvwEfqj_m&_nc_oc=AdosUh2GziVxZMBonDh8ZvyjPxSIuNi3GGcholOPspofDwybl-vLAx79YNMszYKJaxo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLmUz0TBd9eRvAD6fE6G9j4rPBM5-VKMhsKOJ_5VHuAyw&oe=6AA8152F"}, "display_name": "Mystery Box VR: Hidden Secrets", "keywords": [], "long_description": " AN IMMERSIVE VR PUZZLE EXPERIENCE\nInteract with objects, handles, buttons, and wheels on each side. Crack enigmas and collect hidden puzzle tiles on a random side of the boxes.\n\nYou won't be able to compare reality with fiction.\n\n# DISCOVER INVENTIONS\nOnce you unlock all 8 boxes of a Level Pack, you can compose a puzzle and discover a brief history of an invention.\n\nIt's not always easy to escape the room, so use all your IQ to crack the riddles. There's a logic behind all of them, even where it seems it's not!\n\n# IMMERSIVE SOUNDTRACK\nPlay the game with your headphones to get immersed in this amazing adventure.\n\n# HINTS\nGot stuck on some enigma? No worries, you can still get a helpful hint! You can also get in touch with me in case you really can't make it through a riddle, I'll be glad to help ;)\n\n# MULTILANGUAGE\nAvailable in English, French, Italian, German, Spanish, Russian, and Japanese.\n\nThe game language will change automatically based on the language settings of your device", "short_description": "A VR escape room game where you have to solve intriguing riddles to open boxes and discover nice stories about popular inventions!"}, {"images": {"nodes": [{"file_name": "$R36BSY5.png", "id": "3678762505771822", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031430_3678762509105155_2151975047074617165_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GKtfdn4sZ6AQ7kNvwHtILSW&_nc_oc=AdpJMR9_WnC3lx4ZTd_MSTSv71gDjF-kU6nUJna7qO6kEPfA5Kvf95RcZQgnBo4foUs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLNTr1V6QZBlrKcYSGScB_-zLfB5uEeXLqi0Uk4cuN-jw&oe=6AA81125"}, {"file_name": "$R81V725.png", "id": "2720695481426567", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75262743_2720695484759900_604086922326600035_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7lQ7eg1R9hUQ7kNvwFo6bBm&_nc_oc=Ado9umSFKCJqj5cXILaQXnWe8sDpfaxMDF92pQe5d3rXEkLE3D95f3HE_Yw0Vbphcp0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIDoRx0LjsPz8rlFRwJoZViZXtLj7fKz8wNOL1xPDb6-Q&oe=6AA8100D"}, {"file_name": "$RQ3SN6U.png", "id": "1552311425628973", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982519_1552311428962306_1218130395049083834_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bR3_bM_dQS8Q7kNvwGienPp&_nc_oc=Adp1tBb05ivrD0NueKaFYIaE-Q-kvAJiC9L7cOzBI5xwepuO1IYuuKPD8si6JDKBWSU&_nc_zt=3&_nc_ht=
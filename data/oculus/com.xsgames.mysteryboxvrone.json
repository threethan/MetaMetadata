934382610375855", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974473_1934382613709188_7156337812617042679_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zKUV62pjn80Q7kNvwF4Ots7&_nc_oc=Ado134gFRYidO58FO3GTnrWcHdLN-Ksgb6mbKh1YAOzASsAbIdcsZ43gKAVxnNch9BE&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ7bHJDs_9_G_sxOZRf9Euh2Uij2oMsV3gKOVDhgnDGvA&oe=6AFF1933"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape_coverart.png", "id": "897861905346420", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/38982672_897861908679753_3996777238831042692_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9fcl2bd7A30Q7kNvwGhVsZy&_nc_oc=AdrLBKpibM_Jeu1Caq8KfEdGrVAomvL3VZrVuKB8LEI6Hg2Ixk-kTzB9I930uBEuK4Y&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRl4kbaCjUDFu7rioBenGO3itCHA6qARZpnUvv1eXPgnQ&oe=6AFF1BAB"}, "display_name": "Mystery Box VR: Hidden Secrets Escape", "keywords": ["puzzle", "escape", "room", "trivia", "brainteaser"], "long_description": "# AN IMMERSIVE VR PUZZLE EXPERIENCE\nInteract with objects, handles, buttons, and wheels on each side. Crack enigmas and collect hidden puzzle tiles on a random side of the boxes.\n\nYou won't be able to compare reality with fiction.\n\n# DISCOVER INVENTIONS\nOnce you unlock all 8 boxes of a Level Pack, you can compose a puzzle and discover a brief history of an invention.\n\nIt's not always easy to escape the room, so use all your IQ to crack the riddles. There's a logic behind all of them, even where it seems it's not!\n\n# IMMERSIVE SOUNDTRACK\nPlay the game with your headphones to get immersed in this amazing adventure.\n\n# HINTS\nGot stuck on some enigma? No worries, you can still get a helpful hint! You can also get in touch with me in case you really can't make it through a riddle, I'll be glad to help ;)\n\n# MULTILANGUAGE\nAvailable in English, French, Italian, German, Spanish, Russian, and Japanese.\n\nThe game language will change automatically based on the language settings of your device", "short_description": "Crack awesome puzzles around many boxes, and discover the history of the world's most popular inventions!"}, {"images": {"nodes": [{"file_name": "logoTransparent.png", "id": "3812261432362188", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974562_3812261435695521_5176404439574971225_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g66-8J5rjHYQ7kNvwEzK30k&_nc_oc=AdqT6Zk0nbt-YphWuGr9DQyEXhhFd7VvvibGwEgXt_-VTOs7JjDAlN1_svZZqKFd8w4&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRFFBycS_pbpOwkW_D_uNhOxRrcjHSstdk97M-oCeVJyA&oe=6AFF0956"}, {"file_name": "portrait_coverart.png", "id": "1953342038506987", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/38982581_1953342045173653_4906879878373922307_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4_IPEfT47zEQ7kNvwFqdt72&_nc_oc=Adr685af6jhjWYd3Xn6ZBWebJ4oQVX6vEYFAFOG6YTDaTd6jO5LE5nqZP_OopGpWim0&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRHGk9yx5aJ1ccNYdr269wWL59UuQ24VqHNkZ-OjpZv5g&oe=6AFF2A7D"}, {"file_name": "landscape_coverart.png", "id": "1300403051139202", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75462955_1300403057805868_2288822001409671177_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U21MaCHU4W8Q7kNvwGCCGVR&_nc_oc=Adpxkca3n6RV4UFR9xWtQG-N5WSOzR_OrmwRv48QpwRL-xtF-3aU09akdzzn7-FQNvg&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRx3DpvccUVjfS1vi8eNilUGpPbY2zQfkRmVvceDSdZWQ&oe=6AFF1B20"}, {"file_name": "square_coverart.png", "id": "914408640187392", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/39036626_914408643520725_6339598287132
6Oew2JIlG0PXltfM45j0jl44YBahLwl_Ql3k_ErCF3vQ&oe=6A0F2144"}, {"file_name": "5.png", "id": "467916352871409", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39003282_467916356204742_1871921057092171900_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vVLiaiFU1dgQ7kNvwG43Baa&_nc_oc=Adp3tamygVjSAQikdFNjp5w_OIhm8g4Xwgg3v4wlSdOffXkzMIWPaHodA6QNP4augmU&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6o28tmzHZ7J-BT405PXk6O1nGKgGtGLHQ5tRPZfa-OOw&oe=6A0F05E2"}, {"file_name": "3.png", "id": "1934382610375855", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974473_1934382613709188_7156337812617042679_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1jTTxvLvzsQQ7kNvwGf9Qf2&_nc_oc=AdoGlD-iHlO0qTZBMz8GYSNQVpoa_Wi_ZnE7ol7sGx3OkB2_kMfwCT9FOe3YFrmbLSY&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4QSeUSnUK737rdKJgkcrRdzesRQufUx5mG65uhclHtJw&oe=6A0F2833"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape.png", "id": "1524760081483769", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974531_1524760084817102_6497712644828891067_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ssiNuv60_hMQ7kNvwE7iXyF&_nc_oc=AdrpD80jK9nnujMG_6ufB_pfH7zq4YF5V0qxzRUucJ1SoiHGF9PMXJajx_yIyunQoLg&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af671yt5omgFWjVwCH17fyjHwDLPCMQcTlOlSDlsz53SgA&oe=6A0F272F"}, "display_name": "Mystery Box VR: Hidden Secrets", "keywords": [], "long_description": " AN IMMERSIVE VR PUZZLE EXPERIENCE\nInteract with objects, handles, buttons, and wheels on each side. Crack enigmas and collect hidden puzzle tiles on a random side of the boxes.\n\nYou won't be able to compare reality with fiction.\n\n# DISCOVER INVENTIONS\nOnce you unlock all 8 boxes of a Level Pack, you can compose a puzzle and discover a brief history of an invention.\n\nIt's not always easy to escape the room, so use all your IQ to crack the riddles. There's a logic behind all of them, even where it seems it's not!\n\n# IMMERSIVE SOUNDTRACK\nPlay the game with your headphones to get immersed in this amazing adventure.\n\n# HINTS\nGot stuck on some enigma? No worries, you can still get a helpful hint! You can also get in touch with me in case you really can't make it through a riddle, I'll be glad to help ;)\n\n# MULTILANGUAGE\nAvailable in English, French, Italian, German, Spanish, Russian, and Japanese.\n\nThe game language will change automatically based on the language settings of your device", "short_description": "A VR escape room game where you have to solve intriguing riddles to open boxes and discover nice stories about popular inventions!"}, {"images": {"nodes": [{"file_name": "$R36BSY5.png", "id": "3678762505771822", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39031430_3678762509105155_2151975047074617165_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pK3rXYbRCREQ7kNvwHtVBOc&_nc_oc=AdqRDYUiAxtNwbP-8ZYgdGL63EqSayGI5wYMs7prWfYrQxvfUGCTUOJZkp1jCcEGFWE&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5IfINHj4pqslUTQmqe-URpl-_qR7D8j9OKMRM4lGoDcQ&oe=6A0F2325"}, {"file_name": "$R81V725.png", "id": "2720695481426567", "image_type": "APP_IMG_ICON", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/75262743_2720695484759900_604086922326600035_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GG8uWdIx76wQ7kNvwGIdmEU&_nc_oc=AdrgtOn1YEJGneexXJG_lWGxo9BA0IHJnr2feBWGl6cyz_rPtXa_KiVP9PLiFKIIGHI&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5QQSLqm8dOizkFIlzWe89RHfSK0c8pSl3Wa9l8B3PUdw&oe=6A0F220D"}, {"file_name": "$RQ3SN6U.png", "id": "1552311425628973", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38982519_1552311428962306_1218130395049083834_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SuG5LxbtaO4Q7kNvwEzKuLD&_nc_oc=Adr3dIZeKsX_FAhPVXpNJg-nT7O7zBLmfYhCOiMdUbPDT49mV7rZYYokU2vhwDqBY8M&_nc_zt=3&_nc_ht=
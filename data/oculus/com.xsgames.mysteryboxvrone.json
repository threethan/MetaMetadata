3Tz2-PZBAJITLc7RM00EIX9U5XwPK3XZg0E9kjOXHeFA&oe=69D63884"}, {"file_name": "5.png", "id": "467916352871409", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39003282_467916356204742_1871921057092171900_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-_AhFsnGvUIQ7kNvwFOZpGD&_nc_oc=Adr4N06QA6cHCjWM_LrWSRBn8yfU6ShmNGOha0hVgRsmfmj18mo-1BhsaxQ5hGVb-IA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2B9Rn-aW0KCqThxQEK5dPhy5lOP4dSdDCQF10Ur8nHgQ&oe=69D65562"}, {"file_name": "3.png", "id": "1934382610375855", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974473_1934382613709188_7156337812617042679_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1g2KGztdVjEQ7kNvwEe99gm&_nc_oc=AdrJn1IsCC4UHd34BoFWcLvjMoqca7Z8AKu9f0BWQtZPDg9yCQoVCleMjbacdmqwL5U&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3eyY4OGrwl6MJqoCUjmJ4f47ba8oNu6R55uHGNq_qNzQ&oe=69D63F73"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape.png", "id": "1524760081483769", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974531_1524760084817102_6497712644828891067_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CJfFlCRxjgkQ7kNvwH0TCBR&_nc_oc=AdqDTRTKb6GJJPVgUnalu3SaILvLaabtA6oHK2s8eVHuJMRwrnWU3zzm42HKxuEnmkk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2rynFtlIkkTccMKM0X2_7ZYxDTLzGq_uGYO_8AgPCc6g&oe=69D63E6F"}, "display_name": "Mystery Box VR: Hidden Secrets", "keywords": [], "long_description": " AN IMMERSIVE VR PUZZLE EXPERIENCE\nInteract with objects, handles, buttons, and wheels on each side. Crack enigmas and collect hidden puzzle tiles on a random side of the boxes.\n\nYou won't be able to compare reality with fiction.\n\n# DISCOVER INVENTIONS\nOnce you unlock all 8 boxes of a Level Pack, you can compose a puzzle and discover a brief history of an invention.\n\nIt's not always easy to escape the room, so use all your IQ to crack the riddles. There's a logic behind all of them, even where it seems it's not!\n\n# IMMERSIVE SOUNDTRACK\nPlay the game with your headphones to get immersed in this amazing adventure.\n\n# HINTS\nGot stuck on some enigma? No worries, you can still get a helpful hint! You can also get in touch with me in case you really can't make it through a riddle, I'll be glad to help ;)\n\n# MULTILANGUAGE\nAvailable in English, French, Italian, German, Spanish, Russian, and Japanese.\n\nThe game language will change automatically based on the language settings of your device", "short_description": "A VR escape room game where you have to solve intriguing riddles to open boxes and discover nice stories about popular inventions!"}, {"images": {"nodes": [{"file_name": "$R36BSY5.png", "id": "3678762505771822", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031430_3678762509105155_2151975047074617165_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ilpCUmwhlm4Q7kNvwGhiz5o&_nc_oc=AdohzM3RSwUl8_JjJv4RuAVCQRqCnocpB5KjFXxvkdkxZXwvkfYRVn6-Tv2kjegpyxg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af12wakWd17fLdYHrOKrd56rQNdk4rTH82D3Eno3DMYbYw&oe=69D63A65"}, {"file_name": "$R81V725.png", "id": "2720695481426567", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75262743_2720695484759900_604086922326600035_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EyO8hmUt7HEQ7kNvwF3tZwd&_nc_oc=AdpNTzw1WvCwCf6JGHz46AEEHJGLC14k14kbnsmaBd7InhZ5WyW9Z-duGyidN_W9uTs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3XrORTeUQBVuDt304NCb_vipZe_iHHVTgfTLnKcqb3BA&oe=69D6394D"}, {"file_name": "$RQ3SN6U.png", "id": "1552311425628973", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982519_1552311428962306_1218130395049083834_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IflNVjOjXwwQ7kNvwF1Xgy5&_nc_oc=Adoo6RC8yby6gYhebeOWbRUM9SIiImSxvaFSHWG5sM6mGvFhllmBEC8cfFFUfTlcLCU&_nc_zt=3&_nc_ht=
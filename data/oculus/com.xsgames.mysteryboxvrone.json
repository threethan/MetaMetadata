91tBYMx4gYL1uYhh2qukOcfuhBn6AQNnUdgjzk0meJcw&oe=6A3AA2C4"}, {"file_name": "5.png", "id": "467916352871409", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39003282_467916356204742_1871921057092171900_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DyM82iimzVYQ7kNvwH925l4&_nc_oc=AdoGVOGhx1W-5AxVY8OPW31Odidcn-hMthpTJqm-7Xp0BO61y_eVI0XoyeN2Gzz-gdU&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af84B6NjD5Cycyt9DHCJG32Yi0NviUtTM8v-2IXcuByaQg&oe=6A3A8762"}, {"file_name": "3.png", "id": "1934382610375855", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974473_1934382613709188_7156337812617042679_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GQA1MQfeKYIQ7kNvwE1aKVQ&_nc_oc=AdpnIjQzUddIkPHeIXlIxhm4YzoqAIjRspLD2c7Rvt7WgRaCy4kT8F_nh7pMSQSLAUA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9B6__oShMWrIQRKCIjjbuRhbznZQXzzX89tVwb2rz9jw&oe=6A3AA9B3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape.png", "id": "1524760081483769", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974531_1524760084817102_6497712644828891067_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ueWvJZfgk4MQ7kNvwHFBf5r&_nc_oc=Adrkq5vn-lb8nrnDPPPnCvPZy_Bs_GdSzYqs2EQz_TpCyx7Y9-TLY4tL79c9FLjfU_A&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9gP6IzM6xb-_yLlffsCOkvOfYSB0LMZE2I5hlEtdF5Gw&oe=6A3AA8AF"}, "display_name": "Mystery Box VR: Hidden Secrets", "keywords": [], "long_description": " AN IMMERSIVE VR PUZZLE EXPERIENCE\nInteract with objects, handles, buttons, and wheels on each side. Crack enigmas and collect hidden puzzle tiles on a random side of the boxes.\n\nYou won't be able to compare reality with fiction.\n\n# DISCOVER INVENTIONS\nOnce you unlock all 8 boxes of a Level Pack, you can compose a puzzle and discover a brief history of an invention.\n\nIt's not always easy to escape the room, so use all your IQ to crack the riddles. There's a logic behind all of them, even where it seems it's not!\n\n# IMMERSIVE SOUNDTRACK\nPlay the game with your headphones to get immersed in this amazing adventure.\n\n# HINTS\nGot stuck on some enigma? No worries, you can still get a helpful hint! You can also get in touch with me in case you really can't make it through a riddle, I'll be glad to help ;)\n\n# MULTILANGUAGE\nAvailable in English, French, Italian, German, Spanish, Russian, and Japanese.\n\nThe game language will change automatically based on the language settings of your device", "short_description": "A VR escape room game where you have to solve intriguing riddles to open boxes and discover nice stories about popular inventions!"}, {"images": {"nodes": [{"file_name": "$R36BSY5.png", "id": "3678762505771822", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031430_3678762509105155_2151975047074617165_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XzfLEkW3TPYQ7kNvwEh7nlQ&_nc_oc=Adpw_tm-YVwiA-MzqN7wJtFJmIA4ie6UVWmNAOnyMvZjwlXfJJUbd130pUbatdHVWFs&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8J-hCTylZnNHFAzUgIV6neQX2rlOEo5xLXR41LChR7Nw&oe=6A3AA4A5"}, {"file_name": "$R81V725.png", "id": "2720695481426567", "image_type": "APP_IMG_ICON", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75262743_2720695484759900_604086922326600035_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w19PK5vF-TIQ7kNvwFpbTmv&_nc_oc=AdqxnasdrGRycaXFiEw-bJt_XcVd8-dW7-u1W5wgKoiSm-xfveR_b3BYvm23jSD_6p0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8TcPosp83yXSsu3xrcCLKG1h8kOLXz9U20sZaFrRaKAg&oe=6A3AA38D"}, {"file_name": "$RQ3SN6U.png", "id": "1552311425628973", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982519_1552311428962306_1218130395049083834_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NQHS287xR_EQ7kNvwFpVffK&_nc_oc=Adqk-itoeWeENU3anCvnk0EbKUTTHnn4GLS2_bSFN_ElRy3yBl13BGCLRXad1-8Hkb0&_nc_zt=3&_nc_ht=
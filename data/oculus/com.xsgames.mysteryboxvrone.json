3EWBLpLCON-r_GC1SP84KcsGIawAO1hdFc85b8j4O5dA&oe=69EA3744"}, {"file_name": "5.png", "id": "467916352871409", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39003282_467916356204742_1871921057092171900_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hDYDB3mACqgQ7kNvwFVOnpL&_nc_oc=AdqTyEQGoxrxeVRKaDN5HM5vRsQRXbEWz4BjbJ2GvzMyAw1VVPEVRE6dlb7sv_PkIHk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af15mSZRBqM-xkABYly2xSrE4VMopFGHXigmJvZuLCWedA&oe=69EA1BE2"}, {"file_name": "3.png", "id": "1934382610375855", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974473_1934382613709188_7156337812617042679_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Fz2HJf9NJi8Q7kNvwF-VHLR&_nc_oc=AdrkEQPS8rkrLbV3CGrn_BIsER9wkzpljtfxq-zbmld_xvzWe9MdNmm8mZ5IeApnKwQ&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3ufMoSgWdTVfk1G0WxlkC4I1QR1PS0iafJNZQpIEobkA&oe=69EA05F3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape.png", "id": "1524760081483769", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974531_1524760084817102_6497712644828891067_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_c2ksM2-VSQQ7kNvwETEGcU&_nc_oc=AdoV8_pxA9T5Srjw7-hcRXldNQQ7ko9Yl8UigKv7wPiikXpjtqQIBjV5gwmGYBn_kPA&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1UpbPvDIcYOFQ1mExfL2zp-FOHRJJRLLclXRsX6XM2bg&oe=69EA04EF"}, "display_name": "Mystery Box VR: Hidden Secrets", "keywords": [], "long_description": " AN IMMERSIVE VR PUZZLE EXPERIENCE\nInteract with objects, handles, buttons, and wheels on each side. Crack enigmas and collect hidden puzzle tiles on a random side of the boxes.\n\nYou won't be able to compare reality with fiction.\n\n# DISCOVER INVENTIONS\nOnce you unlock all 8 boxes of a Level Pack, you can compose a puzzle and discover a brief history of an invention.\n\nIt's not always easy to escape the room, so use all your IQ to crack the riddles. There's a logic behind all of them, even where it seems it's not!\n\n# IMMERSIVE SOUNDTRACK\nPlay the game with your headphones to get immersed in this amazing adventure.\n\n# HINTS\nGot stuck on some enigma? No worries, you can still get a helpful hint! You can also get in touch with me in case you really can't make it through a riddle, I'll be glad to help ;)\n\n# MULTILANGUAGE\nAvailable in English, French, Italian, German, Spanish, Russian, and Japanese.\n\nThe game language will change automatically based on the language settings of your device", "short_description": "A VR escape room game where you have to solve intriguing riddles to open boxes and discover nice stories about popular inventions!"}, {"images": {"nodes": [{"file_name": "$R36BSY5.png", "id": "3678762505771822", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031430_3678762509105155_2151975047074617165_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-3kU9V1Zn6kQ7kNvwFMtmGV&_nc_oc=AdrROxkSb6aRNlTsxkClgrLmpO8QWu_xTr99rnaWK6oZszuyelWOyE38yG0kFa-elWM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1Y5wkvNSnfJxpLeZAzK61lpZ6u5jAmnu-yyUuZEqwy_g&oe=69EA3925"}, {"file_name": "$R81V725.png", "id": "2720695481426567", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75262743_2720695484759900_604086922326600035_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jEJom_-9AHIQ7kNvwFOiO0s&_nc_oc=AdpoT2pVq15OGlO5SYcVnFu3Vy-PB_yCI2V6W2pSAMowVy-LX97QruDbcIDhIG_aPbM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2jyEFhH8bMCkFnXEzdOx-jLw0cRwmEt4nORWVdIqmlfQ&oe=69EA380D"}, {"file_name": "$RQ3SN6U.png", "id": "1552311425628973", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982519_1552311428962306_1218130395049083834_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Gf7T_v6OUGsQ7kNvwEBMoJR&_nc_oc=Adp_jUJEdRDYEe01dmNeTDHXQcUjEYGk-gXQ6F4nFtfePnF15dQeCM9ckwNidRTDCdI&_nc_zt=3&_nc_ht=
_tr9W6WK5DBKpl1lA_DnDjm937yL7sVt62oFEye75qiw&oe=6A355CC4"}, {"file_name": "5.png", "id": "467916352871409", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39003282_467916356204742_1871921057092171900_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n9qQJxf_BmUQ7kNvwGnJhuJ&_nc_oc=Ado_h7OthMHhzalk_peNUK4Xoz10GvhebeCZcPH7qXEVSaz1T0PtDxR3WXXUyEh5Y8o&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_VCHJiAe-Is-qm69ZiPU-AgroCnY0d3IvtgdsJtbkLWw&oe=6A354162"}, {"file_name": "3.png", "id": "1934382610375855", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974473_1934382613709188_7156337812617042679_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yxXpkd_y8IgQ7kNvwHNLehp&_nc_oc=Adpqwh4bfJUCavN9Y1Kt1ox-WkBRGWurnJ4o11jVeJbrM7z0uzivaRh9xYaHXjwdjrU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-Uf-ufCuffB-VYQSyfUJ1v-sQmpdYkrTzsZCU-V6W4cw&oe=6A3563B3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape.png", "id": "1524760081483769", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974531_1524760084817102_6497712644828891067_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IhQwZg4qoCoQ7kNvwFmUeEi&_nc_oc=AdpJpHRQ7SNbePK2PGPiIkEVbGTCaSkHFXw0XMUqZVsEHqj-k0_tp7CtL5qSVh-GnxY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8jnO0LVHuDDndZ8dYnk6LHdYBcydtPPX7XVo2svLUNbA&oe=6A3562AF"}, "display_name": "Mystery Box VR: Hidden Secrets", "keywords": [], "long_description": " AN IMMERSIVE VR PUZZLE EXPERIENCE\nInteract with objects, handles, buttons, and wheels on each side. Crack enigmas and collect hidden puzzle tiles on a random side of the boxes.\n\nYou won't be able to compare reality with fiction.\n\n# DISCOVER INVENTIONS\nOnce you unlock all 8 boxes of a Level Pack, you can compose a puzzle and discover a brief history of an invention.\n\nIt's not always easy to escape the room, so use all your IQ to crack the riddles. There's a logic behind all of them, even where it seems it's not!\n\n# IMMERSIVE SOUNDTRACK\nPlay the game with your headphones to get immersed in this amazing adventure.\n\n# HINTS\nGot stuck on some enigma? No worries, you can still get a helpful hint! You can also get in touch with me in case you really can't make it through a riddle, I'll be glad to help ;)\n\n# MULTILANGUAGE\nAvailable in English, French, Italian, German, Spanish, Russian, and Japanese.\n\nThe game language will change automatically based on the language settings of your device", "short_description": "A VR escape room game where you have to solve intriguing riddles to open boxes and discover nice stories about popular inventions!"}, {"images": {"nodes": [{"file_name": "$R36BSY5.png", "id": "3678762505771822", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031430_3678762509105155_2151975047074617165_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UDvKE-eNqykQ7kNvwF8s9GR&_nc_oc=AdqEoixG1M9t3QZuZYDp-DWiN4bp1JL1xtEIkkv9SKVhOdouf5vN7FoqCEZ3RL9kahE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9H5RUVjvzW2wuRoKYBT4Y6qdwUVFo7ry3YdPDAlWwBcQ&oe=6A355EA5"}, {"file_name": "$R81V725.png", "id": "2720695481426567", "image_type": "APP_IMG_ICON", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75262743_2720695484759900_604086922326600035_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZQA9PCXqgpAQ7kNvwGQ9B0m&_nc_oc=AdpRv3iKxfdWLBCHZzfF43kj0fnbsS4H7ZQKgMEOR9YHdxLkLjhVD_dmRPh9oY-13Rk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9VQfij3h-45HubavTcrt5x2FrHfYRy43a5PIbfGzjFIw&oe=6A355D8D"}, {"file_name": "$RQ3SN6U.png", "id": "1552311425628973", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982519_1552311428962306_1218130395049083834_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dgu9dmo4AJIQ7kNvwFVl0zw&_nc_oc=AdoERcI3NyzGwjicyofhs0wqcQ0lqy97r43lV4MY6qOpMCaqxW86FE6ui5Ps6QCHK4M&_nc_zt=3&_nc_ht=
8wt9epthaEu1qCADAKs-IqwEn_RRKx9Ik5PREddbbSSQ&oe=6A3BF444"}, {"file_name": "5.png", "id": "467916352871409", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39003282_467916356204742_1871921057092171900_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u-4cxe5SnLUQ7kNvwGMpfRW&_nc_oc=Adq650nPoBIW7OzMnaVhSCb3raKGbfcvQQPcr7ZEwFrmqzK_Rs8vHKW6jqWNj_ubAOk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-gJ6KcOY-RcIDino78OyZ42L7hV0o-doC-ffuUxbCHeg&oe=6A3BD8E2"}, {"file_name": "3.png", "id": "1934382610375855", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974473_1934382613709188_7156337812617042679_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GQA1MQfeKYIQ7kNvwF1TUx4&_nc_oc=AdrsEytHkDPO7gNhH-qWWIC7LJrY3cVdktlIy4geRYPHSnB_O3wNw5xAyacYBpO_TnY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8LBEn_N62ZEsX1CrNGQFySzMslzF_6RJlz_rh1YQms0g&oe=6A3BFB33"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape.png", "id": "1524760081483769", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974531_1524760084817102_6497712644828891067_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NJhhIyb9z-UQ7kNvwE_6sYv&_nc_oc=Adr9Z1633iKbyANIxRHyiN6Vz2jfj8DD_o2_awup5QVQVLdmik7EW8X497xTiF5nZiM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9f7I9kq1C_VFHjUZCtcoYqU9Pbg8S_GfQ9yC4p7bzNYw&oe=6A3BFA2F"}, "display_name": "Mystery Box VR: Hidden Secrets", "keywords": [], "long_description": " AN IMMERSIVE VR PUZZLE EXPERIENCE\nInteract with objects, handles, buttons, and wheels on each side. Crack enigmas and collect hidden puzzle tiles on a random side of the boxes.\n\nYou won't be able to compare reality with fiction.\n\n# DISCOVER INVENTIONS\nOnce you unlock all 8 boxes of a Level Pack, you can compose a puzzle and discover a brief history of an invention.\n\nIt's not always easy to escape the room, so use all your IQ to crack the riddles. There's a logic behind all of them, even where it seems it's not!\n\n# IMMERSIVE SOUNDTRACK\nPlay the game with your headphones to get immersed in this amazing adventure.\n\n# HINTS\nGot stuck on some enigma? No worries, you can still get a helpful hint! You can also get in touch with me in case you really can't make it through a riddle, I'll be glad to help ;)\n\n# MULTILANGUAGE\nAvailable in English, French, Italian, German, Spanish, Russian, and Japanese.\n\nThe game language will change automatically based on the language settings of your device", "short_description": "A VR escape room game where you have to solve intriguing riddles to open boxes and discover nice stories about popular inventions!"}, {"images": {"nodes": [{"file_name": "$R36BSY5.png", "id": "3678762505771822", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031430_3678762509105155_2151975047074617165_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XzfLEkW3TPYQ7kNvwHQtR1t&_nc_oc=Adpwb7YRAbCoZfJHiICdM1vrWM5Zjc-feAyTmp74FLqUcuh06R-8F8nLqNk0J2t0X8s&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8936FAoiDbXxX33O03VA7aQ5fBckGPyG3Ga2EMVcoSzw&oe=6A3BF625"}, {"file_name": "$R81V725.png", "id": "2720695481426567", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75262743_2720695484759900_604086922326600035_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w19PK5vF-TIQ7kNvwFunc8A&_nc_oc=AdqOt6bhJeHqrMnrjccEXv-lDfbvuG4VO7poUDuENY10XSmH6xPOb3U51bB1pEw5U5g&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8P4tCT3z9YDKbYbKSRlZcnDlNO5redCXoF6iTVtRuvOg&oe=6A3BF50D"}, {"file_name": "$RQ3SN6U.png", "id": "1552311425628973", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982519_1552311428962306_1218130395049083834_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NQHS287xR_EQ7kNvwFDObiY&_nc_oc=AdqxFfKqoLeWwt8KM4LMamOVd__-GnDQfWiCZ8jdY-yli94g7pZa6-byooldx1gZ1ys&_nc_zt=3&_nc_ht=
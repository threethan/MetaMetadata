598625663250866", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499618025_598625666584199_2892983507206096415_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DIZNBuQRBuoQ7kNvwGH8NXM&_nc_oc=AdpfIIlrt6H5MoNSK-oBCk4GD1-YUfuCtSymSh7dMrNYcZlgEklkdA6iEw7rNCyNgVU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ9OX4uhp2G_PMyqwDKPfGZCKtEIC2XJnM8jYOlOTE17w&oe=6A9D7647"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Screenshot_02.png", "id": "908280564753762", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499307558_908280568087095_3786144712708057165_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ybjPBlBXyhcQ7kNvwFsKqdJ&_nc_oc=AdrMDV1XhhJt354PFpyfB5PGZm1lFXbJmXjl9g8Mb453gVV75Cdsk_-JBdRXB_li2s8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJDd8Nr3yWlZI1qqJivdX5KQtj4eEYyl33rNOTRtCCuhQ&oe=6A9D8256"}, "display_name": "Wound Care Simulator", "keywords": ["CNA", "nurse", "nursing", "training", "simulator"], "long_description": "The Wound Care Simulator from XR Guru immerses nurses and medical trainees in a realistic virtual environment to practice wound care techniques. Step-by-step guidance ensures users master the skills needed to clean, dress, and document wound care safely and effectively. \n\nWith multi-language support (English, Spanish, French, and Arabic), this simulator ensures inclusivity and accessibility for a global audience.   \n\nThe experience is enhanced by an AI companion, acting as a virtual mentor, to answer questions to reinforce learning. \n \n# Key Features:  \n - Multi-Language Support: Tailored instructions and narrations in four major languages to cater to diverse learners.  \n - AI Companion: An interactive assistant that responds to user queries and provides clarifications to meet learning needs. (NOTE: Generative AI is still experimental) \n\n# Learning Objectives: \n- Understand proper wound cleaning and dressing techniques. \n- Apply best practices to prevent infection and promote healing. \n- Ensure patient comfort and safety during wound care procedures. \n- Document wound care procedures accurately for medical records. \n\nThis VR training enhances confidence and proficiency in performing wound care in clinical settings. ", "short_description": "Learn and practice effective wound care techniques in a virtual environment."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.holopundits.com/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Holo Pundits", "support_website_url": null, "website_url": "https://www.holopundits.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "478089301798119"}, {"id": "514087707868786"}, {"id": "1043107547362485"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ar", "fr", "es_MX"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "23948137981446694"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PUBLISHED", "id": "2577216379284505"}, {"status": "PUBLISHED", "id": "1431979071157373"}]}, "baseline_offer": {"id": "2577216379284505"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1749744360, "status": "PUBLISHED", "id": "2577216379284505"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "24357005973893224", "version": "2.0"}, "id": "590101406713546", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"_
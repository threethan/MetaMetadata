nt-iad6-1.oculuscdn.com/v/t64.5771-25/593784242_27575394018825764_762794698687175289_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ow27NC5ZssYQ7kNvwGkDLDw&_nc_oc=AdoAeoIdJrqVy32j7gdAt2EL7BJPH1UwGxaS5lQiEnjlqb4FCdSeag2Yn3kzQl2S4No&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTIhsbnl2j711n19tlEYDrQWss1JtqnwRK8bbNpdIjuWQ&oe=6B0C60C8"}, {"file_name": "1.png", "id": "1652694406591470", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499619382_1652694409924803_8839422553750319858_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lG3hfvooaRwQ7kNvwExlU0o&_nc_oc=AdovthgfSMAhat_UhQuzdqMCjh97MKsCIaOFYZzJYT6OFW73Af1_8wjVqGjgNaWP88U&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQR2U-LQfT1SQLqcflThUZsWo6vCSd3m057sDOcZ6sDFQ&oe=6B0C74B9"}, {"file_name": "2.png", "id": "2242657642978975", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499628454_2242657652978974_1100468260243361324_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=54SOeRgXVAEQ7kNvwFxStNp&_nc_oc=AdpxG9lJjS-2UXDJqhk0uJWPX4NCxSv9w3PF8GhbIXfRTSQyEPalcY__ffkWHbZFGvw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQMOqXt8iUr94ty9GekY-lHBVz7TzIRk7gVNlI2-flU8g&oe=6B0C7139"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Fishing Bait Chaos", "keywords": ["Fishing", "FishingSimulator", "FishSimulator", "RealFishing", "RealFinishingSimulator"], "long_description": "Welcome to Fishing Bait Chaos, a colorful VR fishing simulator blending relaxing real fishing moments with hilarious surprises. Enjoy a playful fishing adventure where every cast brings something new.\n\nExplore 15 fishing environments, from snowy lakes and peaceful forests to city waters, rivers, the open sea, and glowing lava lakes. Discover nighttime views, realistic looking water, and soothing sounds as you settle into your favorite spot in Fishing Chaos Simulator.\n\nCustomize your fishing simulator experience with different rods, hooks, and bait. Cast your line, wait for a bite, hook a fish, and reel it in. Enjoy real fishing-inspired interactions in a stylized world, whether you prefer a peaceful trip or the thrill of the next big catch.\n\nBut this isn't always a peaceful fishing simulator! Noisy opponents and teasing companions may interrupt your session. When they get too annoying, grab them and pull them into the water for a funny splash.\n\nAfter each trip, visit your personal aquarium room to admire the fish you've caught.\n\n**Features:**\n- 15 fishing locations, including snow, forest, city, rivers, sea, and lava lake\n- Night views, realistic water visuals, and relaxing sounds\n- Different fishing rods, hooks, and bait\n- Hands-on casting, hooking, and reeling\n- Playful opponents and companions\n- Aquarium room to showcase your catches\n\nFish, relax, and embrace the chaos in Fishing Bait Chaos your next VR fishing simulator adventure!", "short_description": "Explore Fishing Bait Chaos, a colorful VR fishing simulator packed with relaxing real fishing moments and playful surprises! Visit 15 beautiful environments, from snowy lakes and forests to cities, rivers, the sea, and glowing lava waters. Cast with different rods, hooks, and bait in this hands-on fishing simulator. Enjoy realistic-looking water and calming sounds, then splash teasing companions into the water. Display your catches in your own aquarium room!"}]}, "developer_name": "Rebel Studio", "developer_privacy_policy_url": "https://sites.google.com/view/rebelsgamestudio/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Rebel Studio", "support_website_url": null, "website_url": "https://sites.google.com/view/rebelsgamestudio", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external
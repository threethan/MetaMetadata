oc=AdofHVwkZdqE9YJfJAXVgLscIyBh7ZGL6mKDbtyOlQRxy5KA4neHdxsJ3aEJJ1_a5g8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQUVL-o6S8wI8VkkIvvUxSL0S46qvejvzevqCc9gYSuZ5w&oe=6B103CCD"}, {"file_name": "Screen1a.png", "id": "1553347813168907", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/593845024_1553347816502240_5447899725807624276_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gOg_7-FQ6woQ7kNvwHGaOdb&_nc_oc=AdoXhFxq_LIULsdfj2sFe6jgM3fbJ5tIgP2uXZCJACR95X-K2ICgh2FzG-tDv4lu-Pg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWG9msxqN2OHUtC3fZ5gg1Az_M_-iKtb4oCLOKrC7gC2A&oe=6B105C98"}, {"file_name": "Screen2a.png", "id": "1025642683285976", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499312310_1025642686619309_2235692943901100181_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yBIxsiDM9WAQ7kNvwHbtavv&_nc_oc=AdrrlxsBXBtsxohiLc4z9J3z_N9lI_-LF7t3flCPAW7ANM0PCJkc3J2J8I3sSCrVU_8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQX2I4e2zDTZJoCsMcSR5Iy640NhJyz8p53U2ob0t2Fx4w&oe=6B1049DC"}, {"file_name": "Screen3a.png", "id": "1396107182336961", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499307962_1396107189003627_8037258508810549417_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SoIC7h6waIAQ7kNvwF0tkwb&_nc_oc=Adq75qOpDQc4yC1GHWTNkI6mVFoHkQ-hvcAncmLBi8jq85nMHUt7YOqKKI7l1Y_Vf4I&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQX5PBq_Fn3OEbE5t4o-G-LLCgCeCTQe62HxVoUuHiTwUw&oe=6B105D5C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverArtFinal.png", "id": "1709036710290021", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499311585_1709036713623354_2653463974806640911_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lSawjsZYDz0Q7kNvwFQyzEC&_nc_oc=AdqHOyqsOAA2ik5AnDmYV00kGHAen20Bo9MaubUWk3MVYuh5SXvEP7MtWcmIEuzlrbI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQV9i8jHPGKyJVBqAcihGGgAPBf47VzwFLkCNVFGP8mwDQ&oe=6B1063F7"}, "display_name": "Six Seven", "keywords": [], "long_description": "Enter the world of Slice The Rhythm, where music and combat become one.\n\nFace waves of incoming enemies and defeat them with perfectly timed attacks synchronized to the beat. Every strike, dodge, and combo depends on your rhythm, precision, and reflexes.\n\nBuild score multipliers, maintain long combo chains, and push your skills to the limit as the music intensifies. The better your timing, the higher your score.\n\nFeatures:\n\n\u2022 Rhythm-based combat gameplay\n\u2022 Slash enemies to the beat\n\u2022 Combo and score multiplier system\n\u2022 Immersive VR action\n\u2022 Multiple music tracks\n\u2022 Increasing challenge and intensity\n\u2022 Designed exclusively for virtual reality\n\nWhether you're a rhythm game fan or an action enthusiast, Slice The Rhythm delivers a unique blend of music, combat, and adrenaline-pumping VR gameplay.\n\nCan you survive the rhythm and achieve the ultimate combo?", "short_description": "Fight to the beat, slash enemies with precision, and build massive combos in this action-packed VR rhythm experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://nohell-studio.com/?page_id=202", "developer_terms_of_service_url": null, "publisher_name": "NoHell Studio", "support_website_url": null, "website_url": "https://nohell-studio.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2710427532541308"}, {"id": "1592192974313489"}, {"id": "1672577396871977"}, {"id": "459781504968480"}, {"id": "644354873106712"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_g
oc=AdqcvQC-6Vx3ydeMdgTtpKx8odtq3LRR9YYPFhKxXFug3kUIkjHulbs_pLGX1u12WJY&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRDg-MnSFhaVsJ1AtEUosb5xpDfqkBvnBWVOfuUav7c2A&oe=6B0B2F0D"}, {"file_name": "Screen1a.png", "id": "1553347813168907", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/593845024_1553347816502240_5447899725807624276_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0eeJrQY5NEoQ7kNvwFxYqcT&_nc_oc=AdrsCnq-v6_h4SFl_MMRhhjSqqb0lBPzOt0al-_aJAIcXaNx7-9SRc66cNa_jaXikFk&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQNacI2mZXl17anZvpnLdkzo6PdXmBvxQUmPuvE4Tah6g&oe=6B0B1698"}, {"file_name": "Screen2a.png", "id": "1025642683285976", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499312310_1025642686619309_2235692943901100181_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5-U9_wpTBYUQ7kNvwEVc98M&_nc_oc=AdpX7bddosqwV_yQchxSYR_yPdq_7xlyuLF4AZhgvTGkMKcolDIPZ-n_gUvjSq2aaCU&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRkB2ZHMvphfp-YhC9NW6h7ft3ei1kqlbcqU3jL2Q3jVg&oe=6B0B3C1C"}, {"file_name": "Screen3a.png", "id": "1396107182336961", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499307962_1396107189003627_8037258508810549417_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pqBv9n8fUu0Q7kNvwGKPxPl&_nc_oc=AdqpfJ9N7IaAJlmrygpxUA9lgs7ilycumWst-2zGf3iFnhwqJnZPm6UF6L4xokJLR4E&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRE-Y7bxOMQ-vXvBi-GN8H0Z6dKVGd0uPUEvfbkR7dx9w&oe=6B0B175C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverArtFinal.png", "id": "1709036710290021", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499311585_1709036713623354_2653463974806640911_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_D2sdv0v3MQQ7kNvwFNtdAw&_nc_oc=AdqMYW6TpQxZxqIlFzCrasjZaxmdm8cymLLwHYA4xKcMvWdDKppP9kmHoVa9xeQ4ZM0&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQR2ldo01Jr7SH8oweZPA-hBxWfYeijJMTyFhXEkN5ghbg&oe=6B0B1DF7"}, "display_name": "Six Seven", "keywords": [], "long_description": "Enter the world of Slice The Rhythm, where music and combat become one.\n\nFace waves of incoming enemies and defeat them with perfectly timed attacks synchronized to the beat. Every strike, dodge, and combo depends on your rhythm, precision, and reflexes.\n\nBuild score multipliers, maintain long combo chains, and push your skills to the limit as the music intensifies. The better your timing, the higher your score.\n\nFeatures:\n\n\u2022 Rhythm-based combat gameplay\n\u2022 Slash enemies to the beat\n\u2022 Combo and score multiplier system\n\u2022 Immersive VR action\n\u2022 Multiple music tracks\n\u2022 Increasing challenge and intensity\n\u2022 Designed exclusively for virtual reality\n\nWhether you're a rhythm game fan or an action enthusiast, Slice The Rhythm delivers a unique blend of music, combat, and adrenaline-pumping VR gameplay.\n\nCan you survive the rhythm and achieve the ultimate combo?", "short_description": "Fight to the beat, slash enemies with precision, and build massive combos in this action-packed VR rhythm experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://nohell-studio.com/?page_id=202", "developer_terms_of_service_url": null, "publisher_name": "NoHell Studio", "support_website_url": null, "website_url": "https://nohell-studio.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2710427532541308"}, {"id": "1592192974313489"}, {"id": "1672577396871977"}, {"id": "459781504968480"}, {"id": "644354873106712"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_g
oc=AdpEUkErrLB07cOHGSCh2KqRNlmufrPrAVaguGbh3Y8P9_Gdwo5XWooNV02cBIhOTrw&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSaVVbgb4GffO8cXlyZB6cmT4yV71T40tjtIZVbqP-WmA&oe=6B09A54D"}, {"file_name": "Screen1a.png", "id": "1553347813168907", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/593845024_1553347816502240_5447899725807624276_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4_vvW9CKggEQ7kNvwG-EOfx&_nc_oc=AdqljQdazkDgEuTcAeFhBKrUqcE-eyPAUjkpmQtpMCl_RuQ_7F26y_HRxqNWBCuInRI&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTsfh6t83ik1PyALFbuepStrP1W5bdmfCwnQFQBV5OzFw&oe=6B09C518"}, {"file_name": "Screen2a.png", "id": "1025642683285976", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499312310_1025642686619309_2235692943901100181_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5-U9_wpTBYUQ7kNvwGU7DuM&_nc_oc=AdqXtMMlnM0EM79GFHydVuCAqiDUXt-Dwtk040Gv3aEYzbW5b9KrhvPkS-a9wzKF7Tc&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTw6JtIJC8zLY5F_venp5r0A2wBxbC5nKa0AeuubDGJpw&oe=6B09B25C"}, {"file_name": "Screen3a.png", "id": "1396107182336961", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499307962_1396107189003627_8037258508810549417_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pqBv9n8fUu0Q7kNvwF3rfTk&_nc_oc=Ado0UDVlDGCwLBJusBw5AlVLaDQLk1ZTTxEyq5Vf5qjzZLN5qIaG19crK61eg2UtrFc&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTdayE0ZfdfWmWBh6U-UxJidFADiU8sd7n0lJPcuLVnXQ&oe=6B09C5DC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverArtFinal.png", "id": "1709036710290021", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499311585_1709036713623354_2653463974806640911_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_D2sdv0v3MQQ7kNvwGzZCMS&_nc_oc=Adp_DwrBU7F3xXLYBDQhAJAOJ1CzVXB3_EoHZiOrrcIPXmprqz2yZyyINIQtA7M4blg&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSyeaw1fmHtdLeBWuD1Y6Yi1yynrCEhvMJGjpONzfpSLg&oe=6B09CC77"}, "display_name": "Six Seven", "keywords": [], "long_description": "Enter the world of Slice The Rhythm, where music and combat become one.\n\nFace waves of incoming enemies and defeat them with perfectly timed attacks synchronized to the beat. Every strike, dodge, and combo depends on your rhythm, precision, and reflexes.\n\nBuild score multipliers, maintain long combo chains, and push your skills to the limit as the music intensifies. The better your timing, the higher your score.\n\nFeatures:\n\n\u2022 Rhythm-based combat gameplay\n\u2022 Slash enemies to the beat\n\u2022 Combo and score multiplier system\n\u2022 Immersive VR action\n\u2022 Multiple music tracks\n\u2022 Increasing challenge and intensity\n\u2022 Designed exclusively for virtual reality\n\nWhether you're a rhythm game fan or an action enthusiast, Slice The Rhythm delivers a unique blend of music, combat, and adrenaline-pumping VR gameplay.\n\nCan you survive the rhythm and achieve the ultimate combo?", "short_description": "Fight to the beat, slash enemies with precision, and build massive combos in this action-packed VR rhythm experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://nohell-studio.com/?page_id=202", "developer_terms_of_service_url": null, "publisher_name": "NoHell Studio", "support_website_url": null, "website_url": "https://nohell-studio.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2710427532541308"}, {"id": "1592192974313489"}, {"id": "1672577396871977"}, {"id": "459781504968480"}, {"id": "644354873106712"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_g
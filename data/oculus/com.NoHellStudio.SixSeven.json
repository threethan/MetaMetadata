ile_name": "Screen1a.png", "id": "1553347813168907", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/593845024_1553347816502240_5447899725807624276_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IDNixA9LH6QQ7kNvwH77cTN&_nc_oc=Ador2_jAWmIZXXO183CpK9livS_ozbqkRuNcJaF_jC74DSQv0y5QrEEzKd4QEh5RGNQ&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIds6ouR-aAqZm0jPJ3QUuM3jchTNBMyIOhWoE-UHaztA&oe=6AA94F58"}, {"file_name": "Screen2a.png", "id": "1025642683285976", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/499312310_1025642686619309_2235692943901100181_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ROvBHd77-KEQ7kNvwHtKWX9&_nc_oc=Adq_j4PxnpkWUoHLtcHjCYxmz7VgYNsjrhevLDBiQXl5oVrO7dZLqelJuLw-oN1vUYs&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIt_BlnL6bHU7rTccxlN9_pTQMZLNcfj4a5lfusmqSw7A&oe=6AA93C9C"}, {"file_name": "Screen3a.png", "id": "1396107182336961", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/499307962_1396107189003627_8037258508810549417_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o0aiQYZF08oQ7kNvwEt1noy&_nc_oc=Adp60D7Pe1JBxXuucpuoUtdKreLzXWexQHlo0kyEsjh7xLHLlE4HKOCs3QGu4WOpWTo&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJA0-MrKKPkZHWsb_3-ODbFAydOPeBMAIqS2bBVb_zRTA&oe=6AA9501C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverArtFinal.png", "id": "1709036710290021", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/499311585_1709036713623354_2653463974806640911_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Xnx2_eHdxHgQ7kNvwFdXZa7&_nc_oc=AdofFT4eFaGKfluwNyVOYbJ4w-araXiuZmfJUEhWoST5irfdW3SWj_2eWelMw__DI_k&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL0ZoCZph6G6a2iRB38DsSfLRXFlxskOTnP61MdUAZtsA&oe=6AA956B7"}, "display_name": "Six Seven", "keywords": [], "long_description": "Enter the world of Slice The Rhythm, where music and combat become one.\n\nFace waves of incoming enemies and defeat them with perfectly timed attacks synchronized to the beat. Every strike, dodge, and combo depends on your rhythm, precision, and reflexes.\n\nBuild score multipliers, maintain long combo chains, and push your skills to the limit as the music intensifies. The better your timing, the higher your score.\n\nFeatures:\n\n\u2022 Rhythm-based combat gameplay\n\u2022 Slash enemies to the beat\n\u2022 Combo and score multiplier system\n\u2022 Immersive VR action\n\u2022 Multiple music tracks\n\u2022 Increasing challenge and intensity\n\u2022 Designed exclusively for virtual reality\n\nWhether you're a rhythm game fan or an action enthusiast, Slice The Rhythm delivers a unique blend of music, combat, and adrenaline-pumping VR gameplay.\n\nCan you survive the rhythm and achieve the ultimate combo?", "short_description": "Fight to the beat, slash enemies with precision, and build massive combos in this action-packed VR rhythm experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://nohell-studio.com/?page_id=202", "developer_terms_of_service_url": null, "publisher_name": "NoHell Studio", "support_website_url": null, "website_url": "https://nohell-studio.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2710427532541308"}, {"id": "1592192974313489"}, {"id": "1672577396871977"}, {"id": "459781504968480"}, {"id": "644354873106712"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "2787023825017562"}}]}, "scheduled_offers"
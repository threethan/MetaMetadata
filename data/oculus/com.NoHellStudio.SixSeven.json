e": "Screen1a.png", "id": "1553347813168907", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/593845024_1553347816502240_5447899725807624276_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RZR7Z4s0kmIQ7kNvwHOt3wU&_nc_oc=AdobTpgOSe5fATbm0HSs8tQePRdkj85i8UdfdGlpy8huKH_ZSi9wApHu3DtQfa9V9bg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTJVircMoSrPp1QlI1nMsTWWoFsrwwJrZIZ3_EizZtfVg&oe=6AF717D8"}, {"file_name": "Screen2a.png", "id": "1025642683285976", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499312310_1025642686619309_2235692943901100181_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GVlL3ywtVTgQ7kNvwH8G29h&_nc_oc=AdogEnbth_muh_wWRnC-SBmZam_JcKFlWz7nqHzu_ruLFsr23nJI3gUoBzZZC-6mN_0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSXW25fIjP04LHa8FiZYNM82q8fqzUPUOmb1f1qmiHBHg&oe=6AF73D5C"}, {"file_name": "Screen3a.png", "id": "1396107182336961", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499307962_1396107189003627_8037258508810549417_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9hDinCmFyvUQ7kNvwE0Bf85&_nc_oc=AdqtMtyrDAJidpUFKyMlVYgf8sfR-4fOo7wus3d-jRItambIBG1qzkYjKCLJbCKlrto&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQROvVbGP1j-z95kqPGt0G8iy1vmJcgT-dERwJ9NDqSuzA&oe=6AF7189C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverArtFinal.png", "id": "1709036710290021", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499311585_1709036713623354_2653463974806640911_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E202hoFmsNoQ7kNvwHObV1t&_nc_oc=Adqwr6j1J7dFPcNPphkD-uLb1KeQqpSyeWZ3VXNXrt4qQlWBf7lj6qlqjYEs_8iPAtQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTnPkeGRmavbtrKKjdgRbMuYcvEzbMLHtbdchZzwhJ_uw&oe=6AF71F37"}, "display_name": "Six Seven", "keywords": [], "long_description": "Enter the world of Slice The Rhythm, where music and combat become one.\n\nFace waves of incoming enemies and defeat them with perfectly timed attacks synchronized to the beat. Every strike, dodge, and combo depends on your rhythm, precision, and reflexes.\n\nBuild score multipliers, maintain long combo chains, and push your skills to the limit as the music intensifies. The better your timing, the higher your score.\n\nFeatures:\n\n\u2022 Rhythm-based combat gameplay\n\u2022 Slash enemies to the beat\n\u2022 Combo and score multiplier system\n\u2022 Immersive VR action\n\u2022 Multiple music tracks\n\u2022 Increasing challenge and intensity\n\u2022 Designed exclusively for virtual reality\n\nWhether you're a rhythm game fan or an action enthusiast, Slice The Rhythm delivers a unique blend of music, combat, and adrenaline-pumping VR gameplay.\n\nCan you survive the rhythm and achieve the ultimate combo?", "short_description": "Fight to the beat, slash enemies with precision, and build massive combos in this action-packed VR rhythm experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://nohell-studio.com/?page_id=202", "developer_terms_of_service_url": null, "publisher_name": "NoHell Studio", "support_website_url": null, "website_url": "https://nohell-studio.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2710427532541308"}, {"id": "1592192974313489"}, {"id": "1672577396871977"}, {"id": "459781504968480"}, {"id": "644354873106712"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "2787023825017562"}}]}, "scheduled_offers": {"count":
oc=AdoW7uLdu7MYmyRqM-JAiJOh-EbFC6HaI-r_LNcCDPNBzPuAUjfU8e-gEfNsHbOGymk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSLi7F406J7gjK3WK7xRSdxHcwWnQfZbjPOvlkmvBOEzA&oe=6B01BC4D"}, {"file_name": "Screen1a.png", "id": "1553347813168907", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/593845024_1553347816502240_5447899725807624276_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bGmMHvrUrgAQ7kNvwGSv7mz&_nc_oc=AdqYB-uUhgAvNkhKAis_R3QTPArdnlMSg0pZEdCOaK4sWs-8c_keDnSwGTYKSt5eRsc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQcrXIEbiPjKIAb6wqEZozpboQjBwP-TqRfN74CCVxUjQ&oe=6B01DC18"}, {"file_name": "Screen2a.png", "id": "1025642683285976", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499312310_1025642686619309_2235692943901100181_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ExZ367PT8KsQ7kNvwHkPyeL&_nc_oc=AdpIYgXQC55e5xKxTtP36agHxE9dfPTjfxGdaVFl069CY5tZT51UVkb77RDV1acz0Ss&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQw-bvlAOJ3PhSImR_KFpid9uTekVkpWo0093su2rgwoA&oe=6B01C95C"}, {"file_name": "Screen3a.png", "id": "1396107182336961", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499307962_1396107189003627_8037258508810549417_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ON3PzkjjcoUQ7kNvwEwrjTm&_nc_oc=AdrLkrqGKzYSejtgbQ8OR28rYuvn9lQ4NLe8WyA79sK60UjcTOKUCsVvUo_1KDALsbk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT46G8k1ZcLVOofm28TLN6uLygO6ytpdb-94-0kjBnRFg&oe=6B01DCDC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverArtFinal.png", "id": "1709036710290021", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499311585_1709036713623354_2653463974806640911_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D3Hhk9XNo2QQ7kNvwGzGQRH&_nc_oc=AdrBNn7hkVZH0V1CNf8VcvwulTITmpaWP26N3igTZf4tRW4xqw5xA4O1cyiAwwWd03I&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTH2iLKhIxfmjbvN1DOQK8XSnaoKr6vSAjGk4o8pO1LRQ&oe=6B01E377"}, "display_name": "Six Seven", "keywords": [], "long_description": "Enter the world of Slice The Rhythm, where music and combat become one.\n\nFace waves of incoming enemies and defeat them with perfectly timed attacks synchronized to the beat. Every strike, dodge, and combo depends on your rhythm, precision, and reflexes.\n\nBuild score multipliers, maintain long combo chains, and push your skills to the limit as the music intensifies. The better your timing, the higher your score.\n\nFeatures:\n\n\u2022 Rhythm-based combat gameplay\n\u2022 Slash enemies to the beat\n\u2022 Combo and score multiplier system\n\u2022 Immersive VR action\n\u2022 Multiple music tracks\n\u2022 Increasing challenge and intensity\n\u2022 Designed exclusively for virtual reality\n\nWhether you're a rhythm game fan or an action enthusiast, Slice The Rhythm delivers a unique blend of music, combat, and adrenaline-pumping VR gameplay.\n\nCan you survive the rhythm and achieve the ultimate combo?", "short_description": "Fight to the beat, slash enemies with precision, and build massive combos in this action-packed VR rhythm experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://nohell-studio.com/?page_id=202", "developer_terms_of_service_url": null, "publisher_name": "NoHell Studio", "support_website_url": null, "website_url": "https://nohell-studio.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2710427532541308"}, {"id": "1592192974313489"}, {"id": "1672577396871977"}, {"id": "459781504968480"}, {"id": "644354873106712"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_g
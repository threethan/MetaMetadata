tching game in VR!\n\nThe game responds to your head movements for a truly unique experience.\n\nThe pace keeps increasing and the pressure mounts, so try to last as long as you can. See if you can beat the high score.\n\nRemove entire chains of blocks to rack up points. Choose from several color and shape options to keep the gameplay fresh!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://newarteest.wordpress.com/privacy-statement/", "developer_terms_of_service_url": null, "publisher_name": "Snowclone Interactive", "support_website_url": null, "website_url": "https://newarteest.wordpress.com/demolo/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["PUZZLE", "ARCADE", "CASUAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "677231559962088"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/38974696_335328337204211_4360128954971979776_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NgJJTLfWI9YQ7kNvwGV1mqq&_nc_oc=AdkzmQSOJOt4s_aSgLzcOZZp03YBR8Trg_FPEgjAonP_6lK2WxMtie_R99mo20b9Rqw&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&oh=00_Afvhiq9mCH3YBjr8aMYNRpcVd6vPEipoSb8V8dj508dUsg&oe=69A18E80"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Demolo", "platform": "ANDROID", "context_category": null, "context_topics": [], "release_date": 1540922625, "lastRevision": {"nodes": [{"id": "2228435357196891", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp
8gaMkkS5XI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfuXjqL5aHPwO6T3NhNYDZUFk1pw83K6EMkkHttb_fckkw&oe=69A2EB88"}, {"file_name": "WhatsApp Image 2025-03-01 at 10.22.49.png", "id": "1324131648708706", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473393538_1324131652042039_1262363812047328060_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HJ3mgfwgyeMQ7kNvwEyQd7-&_nc_oc=Admvi24-YONrqDoge-3FAjnnNEhAxE-2XQTWR9LeIwvG4OPo4awsFERm5HH2hnQuGA4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Afuix98_6esk4Mr79zWo7hfOFWcBaoLMM5RQ06C_GGY1HQ&oe=69A2CABB"}, {"file_name": "WhatsApp Image 2025-03-01 at 10.22.13.png", "id": "1188762646142369", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473393762_1188762656142368_7226567719445604910_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xraIKCI6r2YQ7kNvwFTYVD7&_nc_oc=Admd7FV9rzRT4pbsbF2wKQ0Yphc3gnIHnLj_XAIyLSolh2Xe26j_eV1CsDTPBoGXRVA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfsmPLOxR1Quvfu8Fnuh7XsgJeJcxrzcHtWomDQIvPXufg&oe=69A2E969"}, {"file_name": "WhatsApp Image 2025-03-01 at 10.17.25.png", "id": "648049524382511", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473393333_648049531049177_1845830959384804623_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Nil5Z1Zh19wQ7kNvwEUTirx&_nc_oc=AdkgDLgvDWqH6xQszEXn5MaQmwwM-Ujxis4qcX7rXhI87UJjltVZ6dO-Pu7_05Yfz70&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfuXgn5bW_4A-u8rE7pQFI7R54C7OvRypAVgZRKQsoKFag&oe=69A2F81F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Logo (1).png", "id": "1147904073459396", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473392192_1147904076792729_362792060725379133_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MBL_67PhxJMQ7kNvwFz0aar&_nc_oc=Adm4sCwowEABRPx5K3vkFfp9ImgiRKHfIk7lBjsTvLP7ZSNr13V46AOHN0_56zTs7E8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AftY0hDg2hHvLyPY3BQanJviNGkpVDTZncC4rKXVwkuNgA&oe=69A2CF55"}, "display_name": "Lima-Lima Cave, Antarctica", "keywords": ["Antarctica", "Archaeology", "Hunting", "19thCentury", "History"], "long_description": "How about embarking on an adventure to 19th-century Antarctica? Join us in exploring how the history of ancient marine mammal hunters connects with the archaeology conducted in the region today.  \n\nThis app is a collaboration between the **Laboratory of Interactive Archaeology and Electronic Simulations (ARISE)** at the **Federal University of Rio Grande** and the **Laboratory for Antarctic Studies in Human Sciences (LEACH)** at the **Federal University of Minas Gerais**.  \n\nEntirely developed by archaeologists using **three-dimensional scans conducted in Antarctic territory**, this app is a product funded by the **PROANTAR Call for Proposals from CNPq (Process 440862/2023-0)**.  \n\n\ud83d\udd0e Learn more about Antarctic Archaeology at: http://leach.ufmg.br\n\ud83c\udfae Discover other archaeology apps and games: https://arise.furg.br", "short_description": "Embark on this adventure through the frozen continent! Learn how ancient hunters lived in 19th-century Antarctica and how Archaeology is uncovering the human past in the region."}]}, "developer_name": null, "developer_privacy_policy_url": "https://arise.furg.br/politica-de-privacidade", "developer_terms_of_service_url": null, "publisher_name": "Alex Martire", "support_website_url": null, "website_url": "https://arise.furg.br/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "pt_BR"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDIN
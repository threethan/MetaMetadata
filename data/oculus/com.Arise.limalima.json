lease_date": 1741085520, "lastRevision": {"nodes": [{"id": "9426898690664005", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "9426898653997342", "is_first_party": false, "enables_in_app_ads": false, "is_concept": false, "platform": "ANDROID_6DOF"}, "iarc_cert": {"id": "1927923437617024"}, "iarc_email": null, "msrp": null, "translations": {"nodes": [{"images": {"nodes": []}, "id": "2741332672921478", "locale": "pt_BR", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Caverna Lima-Lima, Ant\u00e1rtica", "keywords": ["Ant\u00e1rtica", "Arqueologia", "Ca\u00e7a", "Hist\u00f3ria", "S\u00e9culo19"], "long_description": "Que tal embarcar em uma aventura para a Ant\u00e1rtida do s\u00e9culo XIX?\nVamos juntos conhecer como a Hist\u00f3ria dos antigos ca\u00e7adores de mam\u00edferos dialoga com a Arqueologia feita hoje em dia no local.\n\nEsse app \u00e9 uma parceria entre o Laborat\u00f3rio Arqueologia Interativa e Simula\u00e7\u00f5es Eletr\u00f4nicas (ARISE) da Universidade Federal do Rio Grande e o Laborat\u00f3rio de Estudos Ant\u00e1rticos em Ci\u00eancias Humanas (LEACH) da Universidade Federal de Minas Gerais.\n\nTotalmente produzido por arque\u00f3logos a partir de escaneamentos tridimensionais realizados em territ\u00f3rio ant\u00e1rtico, esse app \u00e9 um produto financiado pelo Edital PROANTAR do CNPq (Processo 440862/2023-0).\n\n\ud83d\udd0e Saiba mais sobre Arqueologia Ant\u00e1rtica em: http://leach.ufmg.br\n\ud83c\udfae Conhe\u00e7a outros apps e jogos de Arqueologia: https://arise.furg.br", "short_description": "Embarque nessa aventura pelo continente gelado! Saiba como os antigos ca\u00e7adores viviam na Ant\u00e1rtida do s\u00e9culo XIX e como a Arqueologia est\u00e1 descobrindo o passado humano na regi\u00e3o."}, {"images": {"nodes": [{"file_name": "Logo-5 (4).png", "id": "4101073646846212", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473393511_4101073650179545_6540848548820581282_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N2Yg6isYuCEQ7kNvwFPt9t0&_nc_oc=Adqar0xGNFZu2Z4zoUgezk4Iiwy7mSwZmrXBmREpgiOmP0CvPNiwhsZ6vSv3U-wPE3o&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHdW3MvjtqPqs7im0oeHzpZYPmvu-_ZVwD-ntu3bx9oTw&oe=6A89952F"}, {"file_name": "Logo-3.png", "id": "2784150625117534", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473393718_2784150628450867_3027386803359071343_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SJZvDkPG3o0Q7kNvwH0dXIQ&_nc_oc=Adq2CEFiynJJN0rlLbhkVifb86eOGoexWQev_EaFkpsEThWakgXio9mksF1nCYHC-EE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHzGb2tXq3wq11wqeeaazxWbAMoigB0sDqnv7P76a3wkg&oe=6A8980EA"}, {"file_name": "Logo-5.png", "id": "1868967543925764", "image_type": "APP_IMG_ICON", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473392022_1868967547259097_1635507280577244303_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2-fEV2K9fOYQ7kNvwG6I3Yc&_nc_oc=AdpYitkygu6rLQHd-xqzicx3EDzaFoC13VKWipR6kG4K5Sa-EcKbTWq3HwbHhthwfdA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEEBMwJbkwCWUnp2zO0Ayrv99Hzf0h3-LU4Kax0uuPSAQ&oe=6A8989EB"}, {"file_name": "Logo-5 (1).png", "id": "1384199782747292", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473391888_1384199786080625_7321753540726049404_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cvD0f964LdgQ7kNvwGDrV6u&_nc_oc=Adp6esqOzjKhXTEextin7vosJVHybqRbZMDkajsOzU-F8aGusLrIW3DQpf7-cVJWNDs&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEltCQ_UmYxipgRuFUMfkCA7fmWzmlcAh5ZsMwbr8DIag&oe=6A89978F"}, {"file_name": "Logo-4.png", "id": "1314865776449920", "image_type": "APP_IMG_HERO", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473392309_1314865779783253_689021345418372126
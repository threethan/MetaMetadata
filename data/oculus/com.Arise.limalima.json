t6oaem8gLNqbt0&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA1Enl_BUHP2b2m6_b5djACX8sl2RyIBsnMexKEhbDsBA&oe=6A5B6155"}, "display_name": "Lima-Lima Cave, Antarctica", "keywords": ["Antarctica", "Archaeology", "Hunting", "19thCentury", "History"], "long_description": "How about embarking on an adventure to 19th-century Antarctica? Join us in exploring how the history of ancient marine mammal hunters connects with the archaeology conducted in the region today.  \n\nThis app is a collaboration between the **Laboratory of Interactive Archaeology and Electronic Simulations (ARISE)** at the **Federal University of Rio Grande** and the **Laboratory for Antarctic Studies in Human Sciences (LEACH)** at the **Federal University of Minas Gerais**.  \n\nEntirely developed by archaeologists using **three-dimensional scans conducted in Antarctic territory**, this app is a product funded by the **PROANTAR Call for Proposals from CNPq (Process 440862/2023-0)**.  \n\n\ud83d\udd0e Learn more about Antarctic Archaeology at: http://leach.ufmg.br\n\ud83c\udfae Discover other archaeology apps and games: https://arise.furg.br", "short_description": "Embark on this adventure through the frozen continent! Learn how ancient hunters lived in 19th-century Antarctica and how Archaeology is uncovering the human past in the region."}]}, "developer_name": null, "developer_privacy_policy_url": "https://arise.furg.br/politica-de-privacidade", "developer_terms_of_service_url": null, "publisher_name": "Alex Martire", "support_website_url": null, "website_url": "https://arise.furg.br/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memor
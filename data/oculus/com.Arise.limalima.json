b=1-7&_nc_sid=6e7a0a&_nc_ohc=SKEvMl4ZxU4Q7kNvwGwfhhU&_nc_oc=AdoTFtfYp1nycIeB0G75rbMfNAPmAiKTQQMzHDNtNIlKTz9gPN51cDOybLIzKHU5tR4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIeobIZZFq_2goaMkhDdJhkGq_rVdGEPt7uBKvpEQsh3Q&oe=6A9EBA08"}, {"file_name": "WhatsApp Image 2025-03-01 at 10.22.49.png", "id": "1324131648708706", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473393538_1324131652042039_1262363812047328060_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YLKcq1U0e8IQ7kNvwESfepl&_nc_oc=AdoN6PQ42ZDay58UwEMj8ZQeEfnBy6NeNo3bzPBKhWRnuXPCfdZZFN-xZ1XltZhSqmg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKU7dUzP7CFow10P77bkaSrz2mVa8w_gwdjaKe4D-_qpQ&oe=6A9ED17B"}, {"file_name": "WhatsApp Image 2025-03-01 at 10.22.13.png", "id": "1188762646142369", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473393762_1188762656142368_7226567719445604910_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fQ_FMqDinzsQ7kNvwFC0ZzD&_nc_oc=AdpklzW3AUoDexT_IF9T4244IrskodlsNxgofkIQu4T93prwl61wPiQ9xPOHW3pcHSM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKQfEScLE7R5TKttc-dbiH51YlIJEYAzLklLof6ZiSZsQ&oe=6A9EB7E9"}, {"file_name": "WhatsApp Image 2025-03-01 at 10.17.25.png", "id": "648049524382511", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473393333_648049531049177_1845830959384804623_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I_O9QryAsW8Q7kNvwEjXU2C&_nc_oc=AdpDk6SbmnwpYWmMN8nQciq_oL2rSf9amkjMR5mqDLVVwG8eXizOkHZQqmeedZJxqPE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKYVG2y7ctkHYt9pDmkpBaKCO2OBj_GkdQPQUFuL5-whw&oe=6A9EC69F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Logo (1).png", "id": "1147904073459396", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473392192_1147904076792729_362792060725379133_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m1uXz_hQB64Q7kNvwGS4-gU&_nc_oc=AdohIvRYCrB7qCSwQKWkwRWWuwMckGyesXRfz-ilzqJYdWHOgFvXfYRJ3czQVV9PomQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKtov9EmwKXFO4tkRdnmSnYO_uC351XWdZwfJ6Sc22ilw&oe=6A9ED615"}, "display_name": "Lima-Lima Cave, Antarctica", "keywords": ["Antarctica", "Archaeology", "Hunting", "19thCentury", "History"], "long_description": "How about embarking on an adventure to 19th-century Antarctica? Join us in exploring how the history of ancient marine mammal hunters connects with the archaeology conducted in the region today.  \n\nThis app is a collaboration between the **Laboratory of Interactive Archaeology and Electronic Simulations (ARISE)** at the **Federal University of Rio Grande** and the **Laboratory for Antarctic Studies in Human Sciences (LEACH)** at the **Federal University of Minas Gerais**.  \n\nEntirely developed by archaeologists using **three-dimensional scans conducted in Antarctic territory**, this app is a product funded by the **PROANTAR Call for Proposals from CNPq (Process 440862/2023-0)**.  \n\n\ud83d\udd0e Learn more about Antarctic Archaeology at: http://leach.ufmg.br\n\ud83c\udfae Discover other archaeology apps and games: https://arise.furg.br", "short_description": "Embark on this adventure through the frozen continent! Learn how ancient hunters lived in 19th-century Antarctica and how Archaeology is uncovering the human past in the region."}]}, "developer_name": null, "developer_privacy_policy_url": "https://arise.furg.br/politica-de-privacidade", "developer_terms_of_service_url": null, "publisher_name": "Alex Martire", "support_website_url": null, "website_url": "https://arise.furg.br/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memor
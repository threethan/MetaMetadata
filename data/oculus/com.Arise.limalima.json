lease_date": 1741085520, "lastRevision": {"nodes": [{"id": "9426898690664005", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "9426898653997342", "is_first_party": false, "enables_in_app_ads": false, "is_concept": false, "platform": "ANDROID_6DOF"}, "iarc_cert": {"id": "1927923437617024"}, "iarc_email": null, "msrp": null, "translations": {"nodes": [{"images": {"nodes": []}, "id": "2741332672921478", "locale": "pt_BR", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Caverna Lima-Lima, Ant\u00e1rtica", "keywords": ["Ant\u00e1rtica", "Arqueologia", "Ca\u00e7a", "Hist\u00f3ria", "S\u00e9culo19"], "long_description": "Que tal embarcar em uma aventura para a Ant\u00e1rtida do s\u00e9culo XIX?\nVamos juntos conhecer como a Hist\u00f3ria dos antigos ca\u00e7adores de mam\u00edferos dialoga com a Arqueologia feita hoje em dia no local.\n\nEsse app \u00e9 uma parceria entre o Laborat\u00f3rio Arqueologia Interativa e Simula\u00e7\u00f5es Eletr\u00f4nicas (ARISE) da Universidade Federal do Rio Grande e o Laborat\u00f3rio de Estudos Ant\u00e1rticos em Ci\u00eancias Humanas (LEACH) da Universidade Federal de Minas Gerais.\n\nTotalmente produzido por arque\u00f3logos a partir de escaneamentos tridimensionais realizados em territ\u00f3rio ant\u00e1rtico, esse app \u00e9 um produto financiado pelo Edital PROANTAR do CNPq (Processo 440862/2023-0).\n\n\ud83d\udd0e Saiba mais sobre Arqueologia Ant\u00e1rtica em: http://leach.ufmg.br\n\ud83c\udfae Conhe\u00e7a outros apps e jogos de Arqueologia: https://arise.furg.br", "short_description": "Embarque nessa aventura pelo continente gelado! Saiba como os antigos ca\u00e7adores viviam na Ant\u00e1rtida do s\u00e9culo XIX e como a Arqueologia est\u00e1 descobrindo o passado humano na regi\u00e3o."}, {"images": {"nodes": [{"file_name": "Logo-5 (4).png", "id": "4101073646846212", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473393511_4101073650179545_6540848548820581282_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OCNBhXE4N4sQ7kNvwF6DgDa&_nc_oc=AdqMjyggn4qAoNVaAT4Rx5nr-koLnhMk0gN1zsBK17xtQ9MvPLbmk7E27u6mPSG1bGo&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6HoLBsZ4Ka2HxeGp-ixBLx3JL92nyrW4401ysfCdV-GQ&oe=6A0B052F"}, {"file_name": "Logo-3.png", "id": "2784150625117534", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473393718_2784150628450867_3027386803359071343_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QU5RZkwDUwQQ7kNvwHPCHrs&_nc_oc=Adq1mKC1SvrgGZixs5kEtHgkLWdKwpGAQMRd7MfK9mc6TrDBJ_8TdiOkmYellusHxSc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5YlIvBM10cLVsyhakOGu0X26sbk2Y940TWFRSjq3OEvw&oe=6A0B292A"}, {"file_name": "Logo-5.png", "id": "1868967543925764", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473392022_1868967547259097_1635507280577244303_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5IK9wt2PIOYQ7kNvwFnW6Df&_nc_oc=AdolWw7vgchrTtYoY7V35NlfSq_rLYur_nGoqFxRTAP6BtBz_efpiq4z5Mh_3d6F3lM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6uA0YQGlxMBqvprfukPIwceojU8q-FWbnHpxgqAyO72g&oe=6A0B322B"}, {"file_name": "Logo-5 (1).png", "id": "1384199782747292", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473391888_1384199786080625_7321753540726049404_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c9C8lcG7VOsQ7kNvwEjy4AI&_nc_oc=AdquIM-CtAlqFuCZa2m1M8Z6MBmJzUR5-g45duF7kN4VdBo8JlIb3wE4QR-S9F_w74k&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6HDrfq1QL2KHwXH1GDl9QTDFuPxZcZqn7In69kfmVD4A&oe=6A0B078F"}, {"file_name": "Logo-4.png", "id": "1314865776449920", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473392309_1314865779783253_689021345418372126
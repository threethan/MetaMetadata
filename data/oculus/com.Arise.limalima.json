lease_date": 1741085520, "lastRevision": {"nodes": [{"id": "9426898690664005", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "9426898653997342", "is_first_party": false, "enables_in_app_ads": false, "is_concept": false, "platform": "ANDROID_6DOF"}, "iarc_cert": {"id": "1927923437617024"}, "iarc_email": null, "msrp": null, "translations": {"nodes": [{"images": {"nodes": []}, "id": "2741332672921478", "locale": "pt_BR", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Caverna Lima-Lima, Ant\u00e1rtica", "keywords": ["Ant\u00e1rtica", "Arqueologia", "Ca\u00e7a", "Hist\u00f3ria", "S\u00e9culo19"], "long_description": "Que tal embarcar em uma aventura para a Ant\u00e1rtida do s\u00e9culo XIX?\nVamos juntos conhecer como a Hist\u00f3ria dos antigos ca\u00e7adores de mam\u00edferos dialoga com a Arqueologia feita hoje em dia no local.\n\nEsse app \u00e9 uma parceria entre o Laborat\u00f3rio Arqueologia Interativa e Simula\u00e7\u00f5es Eletr\u00f4nicas (ARISE) da Universidade Federal do Rio Grande e o Laborat\u00f3rio de Estudos Ant\u00e1rticos em Ci\u00eancias Humanas (LEACH) da Universidade Federal de Minas Gerais.\n\nTotalmente produzido por arque\u00f3logos a partir de escaneamentos tridimensionais realizados em territ\u00f3rio ant\u00e1rtico, esse app \u00e9 um produto financiado pelo Edital PROANTAR do CNPq (Processo 440862/2023-0).\n\n\ud83d\udd0e Saiba mais sobre Arqueologia Ant\u00e1rtica em: http://leach.ufmg.br\n\ud83c\udfae Conhe\u00e7a outros apps e jogos de Arqueologia: https://arise.furg.br", "short_description": "Embarque nessa aventura pelo continente gelado! Saiba como os antigos ca\u00e7adores viviam na Ant\u00e1rtida do s\u00e9culo XIX e como a Arqueologia est\u00e1 descobrindo o passado humano na regi\u00e3o."}, {"images": {"nodes": [{"file_name": "Logo-5 (4).png", "id": "4101073646846212", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/473393511_4101073650179545_6540848548820581282_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rpgbalrgoqAQ7kNvwGK75K7&_nc_oc=Adqb2UmDuMb2NRa6qDzJLldZJHANg0nkw8cxYhqfUEKMTJdbjpX6RLrjR1sWKaq68U4&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9Dvqdm-FoKN6Uzwt-_bFL3XZ1xN4OscdSbahhcztVKtw&oe=6A36BEEF"}, {"file_name": "Logo-3.png", "id": "2784150625117534", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/473393718_2784150628450867_3027386803359071343_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1s306NSKWCEQ7kNvwFmDKoY&_nc_oc=AdrZbtHL_A4nTH0-2uvlMpW3rv7Vtd6pRno2aooqwnBZppe_E3i-KHjVUkWvczIi1u4&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9FvFUmZHigZRJKu9NGfmHwg9lgbQiK9XXnLSnbQbyNWw&oe=6A36AAAA"}, {"file_name": "Logo-5.png", "id": "1868967543925764", "image_type": "APP_IMG_ICON", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/473392022_1868967547259097_1635507280577244303_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4bkDejrTuGUQ7kNvwHBlEeI&_nc_oc=Adr1KMgWnciSuKkzOkHr2wniE9CDXOnBBUf1aZr3yha7O-IiXTHVPGAyU9dbhcIPI0Q&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8TU89HQx1bjWBg8f2sTjobsynKs7g4XrlH3cOlJl_sKQ&oe=6A36B3AB"}, {"file_name": "Logo-5 (1).png", "id": "1384199782747292", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/473391888_1384199786080625_7321753540726049404_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IqmOIfOd_eIQ7kNvwG_COsX&_nc_oc=AdpVtVkAHeBw1Txt_-TTxGRLnxEoNozgSte89j5c2L_FwcEwJHk1y7QUt9de9Rpqas8&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9ECdCktBRE29J7BzkPCM1GY4cwcTcNKSK4-j78T3U9JA&oe=6A36C14F"}, {"file_name": "Logo-4.png", "id": "1314865776449920", "image_type": "APP_IMG_HERO", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/473392309_1314865779783253_6890213454183721
trailer": null, "video_trailer_thumbnail": {"file_name": "Logo (1).png", "id": "1147904073459396", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473392192_1147904076792729_362792060725379133_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Nva8DxSj29cQ7kNvwGAPM4c&_nc_oc=AdoDjfLTBEey1mUe9UBvgRovCovXYo0CRIRUcWyYclTYcxQl5EcknBwmn4DHIe82ipY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR6woWe8_lfA7fCM5sRVvNTRrWX23gZzXaPi8lZaBbFaA&oe=6B030815"}, "display_name": "Lima-Lima Cave, Antarctica", "keywords": ["Antarctica", "Archaeology", "Hunting", "19thCentury", "History"], "long_description": "How about embarking on an adventure to 19th-century Antarctica? Join us in exploring how the history of ancient marine mammal hunters connects with the archaeology conducted in the region today.  \n\nThis app is a collaboration between the **Laboratory of Interactive Archaeology and Electronic Simulations (ARISE)** at the **Federal University of Rio Grande** and the **Laboratory for Antarctic Studies in Human Sciences (LEACH)** at the **Federal University of Minas Gerais**.  \n\nEntirely developed by archaeologists using **three-dimensional scans conducted in Antarctic territory**, this app is a product funded by the **PROANTAR Call for Proposals from CNPq (Process 440862/2023-0)**.  \n\n\ud83d\udd0e Learn more about Antarctic Archaeology at: http://leach.ufmg.br\n\ud83c\udfae Discover other archaeology apps and games: https://arise.furg.br", "short_description": "Embark on this adventure through the frozen continent! Learn how ancient hunters lived in 19th-century Antarctica and how Archaeology is uncovering the human past in the region."}]}, "developer_name": null, "developer_privacy_policy_url": "https://arise.furg.br/politica-de-privacidade", "developer_terms_of_service_url": null, "publisher_name": "Alex Martire", "support_website_url": null, "website_url": "https://arise.furg.br/", "category": null, "comfort_rating": "C
b=1-7&_nc_sid=6e7a0a&_nc_ohc=_FscmXCx7s8Q7kNvwHIQ_Ov&_nc_oc=AdoTTQe1dzz8IHg6ZdH09g8mkTJ6RBcOAb_tnFRw41dju-4pjRTe3PaoqwO4cWUcXf0&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4kgZf0PXjkEJj79CRvmTO8KcfV4X8HJh1AuDow-cDhfg&oe=6A01D788"}, {"file_name": "WhatsApp Image 2025-03-01 at 10.22.49.png", "id": "1324131648708706", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473393538_1324131652042039_1262363812047328060_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tBa5ywpSLh4Q7kNvwGv5Vs0&_nc_oc=AdpIZq96nFBJ4a48VsuEdEa3IrrtsG4Tji033Xurle9VKQxawQnAove9v1wHijxiHuE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af72d8TfyZtrv9s9f3mj3KOEImmVyu2sRpUTknEpOxeiKA&oe=6A01EEFB"}, {"file_name": "WhatsApp Image 2025-03-01 at 10.22.13.png", "id": "1188762646142369", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473393762_1188762656142368_7226567719445604910_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aWgqDY2CuhEQ7kNvwEKTmAQ&_nc_oc=Adp1WIVTfBrWV60lZ81qZ7uWmb2Y6TE8c6JQ6Q0eSJdinnd4GqzuB4G30n0EXvSWutw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af76UxzRcTd5Jqvx8bzjWUdak3l0afphfIoGFzHhj_qqHw&oe=6A01D569"}, {"file_name": "WhatsApp Image 2025-03-01 at 10.17.25.png", "id": "648049524382511", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473393333_648049531049177_1845830959384804623_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CL7hZn8Tkg4Q7kNvwEFZTu4&_nc_oc=AdrHyWGOsJOJE7ubZF4Kq-vDp6hoxtjrJJFNLs5eAOTQVptz5WQMjoK06gBHRsv_New&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4TlcyDj0WX_GPFR2Au4j_Pb7D5xvYoMtEqYJftyPzRxQ&oe=6A01E41F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Logo (1).png", "id": "1147904073459396", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473392192_1147904076792729_362792060725379133_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j6tKX0yPg4sQ7kNvwH6CwSt&_nc_oc=Adq3RnZ4a-p3JiwEw98gSaUuQculRqwiFJ-CfJjIS0dFFiBYYKoZQwMNHuCkWSc4PiI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6BwP0w42-Y8R9e_ulIUOGdvW5taZb_r_BHqZoI-ePzGQ&oe=6A01F395"}, "display_name": "Lima-Lima Cave, Antarctica", "keywords": ["Antarctica", "Archaeology", "Hunting", "19thCentury", "History"], "long_description": "How about embarking on an adventure to 19th-century Antarctica? Join us in exploring how the history of ancient marine mammal hunters connects with the archaeology conducted in the region today.  \n\nThis app is a collaboration between the **Laboratory of Interactive Archaeology and Electronic Simulations (ARISE)** at the **Federal University of Rio Grande** and the **Laboratory for Antarctic Studies in Human Sciences (LEACH)** at the **Federal University of Minas Gerais**.  \n\nEntirely developed by archaeologists using **three-dimensional scans conducted in Antarctic territory**, this app is a product funded by the **PROANTAR Call for Proposals from CNPq (Process 440862/2023-0)**.  \n\n\ud83d\udd0e Learn more about Antarctic Archaeology at: http://leach.ufmg.br\n\ud83c\udfae Discover other archaeology apps and games: https://arise.furg.br", "short_description": "Embark on this adventure through the frozen continent! Learn how ancient hunters lived in 19th-century Antarctica and how Archaeology is uncovering the human past in the region."}]}, "developer_name": null, "developer_privacy_policy_url": "https://arise.furg.br/politica-de-privacidade", "developer_terms_of_service_url": null, "publisher_name": "Alex Martire", "support_website_url": null, "website_url": "https://arise.furg.br/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memor
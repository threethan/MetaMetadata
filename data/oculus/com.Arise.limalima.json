kiDs9I9itY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AftYvERVAmcfOgEmK0CVbelY4PVJzjyzgYcnqiiuPagjUw&oe=69A6E008"}, {"file_name": "WhatsApp Image 2025-03-01 at 10.22.49.png", "id": "1324131648708706", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473393538_1324131652042039_1262363812047328060_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YwF8L8OB4wIQ7kNvwETW7J-&_nc_oc=AdlLB4d6A4a-ZXgwnFzB-Wxv0JPCWcsZc3jP3z2AusZgb490kazfNODNQt9ZvNWrsl8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AftT1xFeg-76iGDgWoTi5xZp9ktjiiswi4YSr--L7SCFGg&oe=69A6BF3B"}, {"file_name": "WhatsApp Image 2025-03-01 at 10.22.13.png", "id": "1188762646142369", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473393762_1188762656142368_7226567719445604910_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CgmigfJePc0Q7kNvwFWymGP&_nc_oc=AdlPv7Qp2BEbD1H0QRiTMFxAqDVPogTeFgD-qCKE3lMnrqSriEePzAsSV-RX2KMxHdk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfsaYVc7HZl03S_vejBk9uPUy8hwSPbKmVUmfiuw3hYYSA&oe=69A6DDE9"}, {"file_name": "WhatsApp Image 2025-03-01 at 10.17.25.png", "id": "648049524382511", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473393333_648049531049177_1845830959384804623_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hqci02FpJA8Q7kNvwEcBAuU&_nc_oc=AdksdW6jtfBr-VRiQ25RJakWQurpoSDbnDYqI55YaekkfYQvuZYZeaYyoqXJNM5jK3s&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfvlsrLT_3RrgfA8QlxAK2podFXWupuCAFQbEZ0MI-vAqg&oe=69A6EC9F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Logo (1).png", "id": "1147904073459396", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473392192_1147904076792729_362792060725379133_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BebwcZwEMLIQ7kNvwFMr_ur&_nc_oc=AdkFRK8hSlquGLAAm0WBR_ewBzb3tcpxLQKPsFRkuLR0FWanX6Mkusqt3mkgBTf3C1Y&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afup2ImXlWHgHCNIoQq29NmnvjXUV9Uk7e499TNGqFW4Fw&oe=69A6C3D5"}, "display_name": "Lima-Lima Cave, Antarctica", "keywords": ["Antarctica", "Archaeology", "Hunting", "19thCentury", "History"], "long_description": "How about embarking on an adventure to 19th-century Antarctica? Join us in exploring how the history of ancient marine mammal hunters connects with the archaeology conducted in the region today.  \n\nThis app is a collaboration between the **Laboratory of Interactive Archaeology and Electronic Simulations (ARISE)** at the **Federal University of Rio Grande** and the **Laboratory for Antarctic Studies in Human Sciences (LEACH)** at the **Federal University of Minas Gerais**.  \n\nEntirely developed by archaeologists using **three-dimensional scans conducted in Antarctic territory**, this app is a product funded by the **PROANTAR Call for Proposals from CNPq (Process 440862/2023-0)**.  \n\n\ud83d\udd0e Learn more about Antarctic Archaeology at: http://leach.ufmg.br\n\ud83c\udfae Discover other archaeology apps and games: https://arise.furg.br", "short_description": "Embark on this adventure through the frozen continent! Learn how ancient hunters lived in 19th-century Antarctica and how Archaeology is uncovering the human past in the region."}]}, "developer_name": null, "developer_privacy_policy_url": "https://arise.furg.br/politica-de-privacidade", "developer_terms_of_service_url": null, "publisher_name": "Alex Martire", "support_website_url": null, "website_url": "https://arise.furg.br/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "pt_BR"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDIN
_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LO4dQNznvEMQ7kNvwGPnBvk&_nc_oc=AdqxiboV9TrcxuLLPAaG2DgYbYRo00zYptLA20gftVHyOUiXzGyMX9nBJND5RPtU1rg&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_vue0K58ASoVWSopmsiMhXAAkJqTtH6bUg4NbrlHosYw&oe=6A30203B"}, {"file_name": "Updated_Screenshot_4_Oculus.png", "id": "456272123384556", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39001726_456272126717889_6151231868675041051_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RSYC90ikUscQ7kNvwGXvxP9&_nc_oc=AdqzFPw6pYh1Jss_WdwLSzXOicHePAL9fCj2YUkf5fnT3CJWF0InbWgD2UoNEC2k7z8&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_3EYbJZA48x93DfqKp37R5rlYIEnDKJD4Q9O72vQo_Yw&oe=6A3015E2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover-Landscape.png", "id": "999779757647287", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39036641_999779760980620_7423226441179076258_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J0Y4JnUHp8wQ7kNvwFJlzA8&_nc_oc=Adr89czoKXc0bWYx2j638Anl-H7asyARXjT01EynbFHD3efMTVcv9c2ASBthd96p-QY&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8DTygUUmFkVRJeTuHKxtjsGW9sFllFI4dJV_wRLD50DQ&oe=6A3018D3"}, "display_name": "Give The People What They Want", "keywords": [], "long_description": "In Give the People What They Want, you play as a lowly mining robot who has been promoted to the service industry. It's a tough job, customers can be very demanding, and you'll need to adapt to whatever people need based on the jobs you're given. You will need to learn how to optimize to get people what they want in the shortest amount of time and deal with their increasingly complex requests to show that you can be a good quality service bot.\n\nKey Features:\n3 different stages with unique environments and items\nBonus challenges that will let you earn extra points\nCustomizable robot body system to be the best bot you can be\n\n\nIt's a tough job, but someone's gotta do it, and apparently, there's nobody else who wants to. So it's up to you to Give the People What They Want. Will you succeed as the best service bot ever? Or are you destined for the scrap heap? ", "short_description": "A VR Game where you take on odd jobs, become your ideal self, and throw things at customers' faces."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.starlightvintagestudios.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Starlight Vintage Studios", "support_website_url": null, "website_url": "https://starlightvintagestudios.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "5889862721059601"}}]}, "scheduled_offers": {"count": 0, "nodes": []}, "baseline_offer": null, "is_approved": true, "firstOffer": {"nodes": []}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "9329297837141481", "version": "1.3.2"}, "id": "2452581891560977", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "8461886807215926", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "9329297837141481"}, "release_status": "RELEASED"}, "binary_rele
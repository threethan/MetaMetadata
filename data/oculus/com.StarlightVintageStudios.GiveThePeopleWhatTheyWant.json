1545_4931694670950153394_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hGN5SfFrPC8Q7kNvwF_zlsN&_nc_oc=AdoRuRqrFWKKmJEv_clWiwLbt75i0fIEek-s-ogktDWCc7lYBApZC2Ahavvd-r51JKY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKeXUv7PsJR02ZWc7GnGzi-CLLT-gAR9ZXQd7GFgIcsng&oe=6A985EAC"}, {"file_name": "GTP-MetaScreenshot04.png", "id": "1268488450404035", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974924_1268488453737368_7408781568125309811_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A8tMMeJ2n2YQ7kNvwFVkSBg&_nc_oc=Adq0-oNs81rlihJ1tFivcm8ozT3NCVU-NhMKG4IV6V5IVmoTxYHGek77UcUvr7iIxNY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLmeoge1j_CGTP3_5WdFLWk3mljsnTilm1aCUACP9nVXg&oe=6A98336E"}, {"file_name": "GTP-MetaScreenshot01.png", "id": "1132538277408339", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982613_1132538280741672_3561373941679093613_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q6T3xRbmyZgQ7kNvwHGHEB2&_nc_oc=Adr8wlGtdU_sAxDgpS9lZbi_pMno47r6mzS_kwHZyx8f6cDo7M-nv2qd74T4OhVmiJg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIT2SZou2y8DoKR_6fTwDzkEopalux0E_kJFgsV4C2jVw&oe=6A98494B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover-Landscape.png", "id": "999779757647287", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39036641_999779760980620_7423226441179076258_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mrtuzEK5GbgQ7kNvwGPSgGJ&_nc_oc=AdpQGzHoyT2F6tLmENhmNkOTr_7K7Dx1hx3jCDe3gyLsnTBKL3_dvd7yJU3_iey1z0Y&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIfVfUdGWNiO94FubjaPAZ9E5CZLqOhw7KqIg6Y6u2XmA&oe=6A983F53"}, "display_name": "Give The People What They Want", "keywords": [], "long_description": "In Give the People What They Want, you play as a lowly mining robot who has been promoted to the service industry. It's a tough job, customers can be very demanding, and you'll need to adapt to whatever people need based on the jobs you're given. You will need to learn how to optimize to get people what they want in the shortest amount of time and deal with their increasingly complex requests to show that you can be a good quality service bot.\n\nKey Features:\n3 different stages with unique environments and items\nBonus challenges that will let you earn extra points\nCustomizable robot body system to be the best bot you can be\n\n\nIt's a tough job, but someone's gotta do it, and apparently, there's nobody else who wants to. So it's up to you to Give the People What They Want. Will you succeed as the best service bot ever? Or are you destined for the scrap heap? ", "short_description": "A VR Game where you take on odd jobs, become your ideal self, and throw things at customers' faces."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.starlightvintagestudios.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Starlight Vintage Studios", "support_website_url": null, "website_url": "https://starlightvintagestudios.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1097095507628917"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974583_1093614677983865_5973055568815117516_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f1Y
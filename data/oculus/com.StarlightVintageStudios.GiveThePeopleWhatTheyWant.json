_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zdAYD2DiFKAQ7kNvwGKNFti&_nc_oc=AdqIZxoVDr29G-oGsHFycKvonDz8h0Ru56Yf1NV7dg0SVUSxhk47NHbVz6x2HMEmSRA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBkkaeQGea28FR68WLz3Fn0Gt-3zFwMFUZgEeDHJjNvug&oe=6A5774FB"}, {"file_name": "Updated_Screenshot_4_Oculus.png", "id": "456272123384556", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39001726_456272126717889_6151231868675041051_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7SI6CaOZjAgQ7kNvwG61z_R&_nc_oc=AdryE9loWLRyMqFa3Uqo9W0Y0dOOggiZgRMI8tUGdX9p7pU6dwmYyMTMXYzeYdfamDc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB6N6uZdTYtFhorb77G3ptr49iUTf4YgmRPEvr8eb22Bg&oe=6A576AA2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover-Landscape.png", "id": "999779757647287", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39036641_999779760980620_7423226441179076258_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FdBGfG19Q9AQ7kNvwFafYcP&_nc_oc=AdoaIZ7T-vLVZLHUgZXfqIYZAG8HDcT5-GnT-zHu6zVxFMJzQaeVwvQsB0jG5sobEHs&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBcIV8rRPj88FBnE8qg6QlCqeunn4IkIs_TMLGxtxtV2A&oe=6A576D93"}, "display_name": "Give The People What They Want", "keywords": [], "long_description": "In Give the People What They Want, you play as a lowly mining robot who has been promoted to the service industry. It's a tough job, customers can be very demanding, and you'll need to adapt to whatever people need based on the jobs you're given. You will need to learn how to optimize to get people what they want in the shortest amount of time and deal with their increasingly complex requests to show that you can be a good quality service bot.\n\nKey Features:\n3 different stages with unique environments and items\nBonus challenges that will let you earn extra points\nCustomizable robot body system to be the best bot you can be\n\n\nIt's a tough job, but someone's gotta do it, and apparently, there's nobody else who wants to. So it's up to you to Give the People What They Want. Will you succeed as the best service bot ever? Or are you destined for the scrap heap? ", "short_description": "A VR Game where you take on odd jobs, become your ideal self, and throw things at customers' faces."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.starlightvintagestudios.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Starlight Vintage Studios", "support_website_url": null, "website_url": "https://starlightvintagestudios.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "5889862721059601"}}]}, "scheduled_offers": {"count": 0, "nodes": []}, "baseline_offer": null, "is_approved": true, "firstOffer": {"nodes": []}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "9329297837141481", "version": "1.3.2"}, "id": "2452581891560977", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "8461886807215926", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "9329297837141481"}, "release_status": "RELEASED"}, "binary_rele
1d6hyD58jhSh21QG8jXRXYcb2CWSCA7dfHmb_38VQkY_XhxQiEvuSfs&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AfvXHk-KrO9l_8HUOhU9J8kdYqIT95lA4sNRceMpVPozrw&oe=699EFAEC"}, {"file_name": "GTP-MetaScreenshot04.png", "id": "1268488450404035", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974924_1268488453737368_7408781568125309811_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Kjyl0q4c6jsQ7kNvwEE5TY8&_nc_oc=AdlTQllv37NnBFcw2VdhDSOIXfXKJPBCZfMnNhxcpCW-m5hyh9_pJlfnxgLvT9eY-mA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AfvoPQK1Bz9Yf7Kv9BXUE8Mf28ug8u1KirZo77IL_RLFOw&oe=699F07EE"}, {"file_name": "GTP-MetaScreenshot01.png", "id": "1132538277408339", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982613_1132538280741672_3561373941679093613_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PVz3SL3cvlMQ7kNvwH3amNZ&_nc_oc=AdnvbAmq1dT06_ABsHTvIR3NVGTK1E8J4pUX6sAkffzoPCstOWsPACLxMxLHvnpdzK8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AfsSSQKY4l1UwffxKOQc6tDGbCfJ0NjI2CS_lOXBiUZWHg&oe=699EE58B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover-Landscape.png", "id": "999779757647287", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39036641_999779760980620_7423226441179076258_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=stHqG59uVqgQ7kNvwGdlnC3&_nc_oc=AdlcfGcejbDBtmilr4CuPrXE9D50TISL8UwmydySJJVCypWbVuaCE55gVsyhDgu1fKw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_Afvmg1D6tpyqow-04liLtm6dlv7qpLDXH3cZtBbssmbvOA&oe=699EDB93"}, "display_name": "Give The People What They Want", "keywords": [], "long_description": "In Give the People What They Want, you play as a lowly mining robot who has been promoted to the service industry. It's a tough job, customers can be very demanding, and you'll need to adapt to whatever people need based on the jobs you're given. You will need to learn how to optimize to get people what they want in the shortest amount of time and deal with their increasingly complex requests to show that you can be a good quality service bot.\n\nKey Features:\n3 different stages with unique environments and items\nBonus challenges that will let you earn extra points\nCustomizable robot body system to be the best bot you can be\n\n\nIt's a tough job, but someone's gotta do it, and apparently, there's nobody else who wants to. So it's up to you to Give the People What They Want. Will you succeed as the best service bot ever? Or are you destined for the scrap heap? ", "short_description": "A VR Game where you take on odd jobs, become your ideal self, and throw things at customers' faces."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.starlightvintagestudios.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Starlight Vintage Studios", "support_website_url": null, "website_url": "https://starlightvintagestudios.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1097095507628917"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974583_1093614677983865_5973055568815117516_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VbSNwJqatZ4Q7kNvwErCuBu&_nc_oc=AdkDwmUWoKWXz6DCUOA8IOk5oAd6GA_H4j3w5gwMpH_nyTWkWEIaPVpSVBMajQVjOv8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_Afv2FRwWvzzTyE_I_lmNM
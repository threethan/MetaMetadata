n.com&_nc_ss=7f20f&oh=00_AQTT-mEeUpS7GzlK0812oGH4QdRqrDroWzL_rMrnVvtD9g&oe=6B09CEB0"}, {"file_name": "GTP-MetaScreenshot03.png", "id": "857097335678212", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/57569472_857097339011545_4931694670950153394_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U8SGs-QCIrEQ7kNvwGXZMG8&_nc_oc=AdoAMUNc7CGzjA7Yu-zklfhlOJjeuCrPFo66eXcGg1Oou78AI3Sj53XKrmqtc_h9_OM&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQUXy-UmEQNMLOYhVbSN3A7rH9zkPkxlIyRluXSXFRspw&oe=6B09BFAC"}, {"file_name": "GTP-MetaScreenshot04.png", "id": "1268488450404035", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/38974924_1268488453737368_7408781568125309811_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4PZqn_P-3RYQ7kNvwG64Pi1&_nc_oc=AdrvK0v4c1povVt1LXnYkA0vx_3Rpq_cSzTmGY21cqMQOIjUaBlkLUf_susfrkC3lRI&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTVAUq9LgJF7pY64rWW2g5aHTt3Xk1rA5METEjztF0_dA&oe=6B09CCAE"}, {"file_name": "GTP-MetaScreenshot01.png", "id": "1132538277408339", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/38982613_1132538280741672_3561373941679093613_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2QQGK50UXgIQ7kNvwELPXwW&_nc_oc=Adocyve_xNYhDAwWTFVPZoDaD9dt-5loHwQZ2heLP8_nD3fPbdH-DlGc2TLqRdWRopQ&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQkr5oGzSO4H_yjEBlfVSTlA9keAemUNI_rI2AaLQKWxw&oe=6B09AA4B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover-Landscape.png", "id": "999779757647287", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39036641_999779760980620_7423226441179076258_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FgaNuaZ78V0Q7kNvwHRUeuD&_nc_oc=AdqHU1E0T8s-acJXCpnXwwecXjzBaO5tShfTZBPdFRrrHSzBAvTsPEZqxp_T6cn_sWI&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRGlMMD_vMnzVRgbkmGRS_6YhKYUcPPxFnFK09wKyqKXQ&oe=6B09A053"}, "display_name": "Give The People What They Want", "keywords": [], "long_description": "In Give the People What They Want, you play as a lowly mining robot who has been promoted to the service industry. It's a tough job, customers can be very demanding, and you'll need to adapt to whatever people need based on the jobs you're given. You will need to learn how to optimize to get people what they want in the shortest amount of time and deal with their increasingly complex requests to show that you can be a good quality service bot.\n\nKey Features:\n3 different stages with unique environments and items\nBonus challenges that will let you earn extra points\nCustomizable robot body system to be the best bot you can be\n\n\nIt's a tough job, but someone's gotta do it, and apparently, there's nobody else who wants to. So it's up to you to Give the People What They Want. Will you succeed as the best service bot ever? Or are you destined for the scrap heap? ", "short_description": "A VR Game where you take on odd jobs, become your ideal self, and throw things at customers' faces."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.starlightvintagestudios.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Starlight Vintage Studios", "support_website_url": null, "website_url": "https://starlightvintagestudios.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_S
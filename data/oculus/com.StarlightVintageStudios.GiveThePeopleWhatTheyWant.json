1545_4931694670950153394_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=smgS1Y3WmgIQ7kNvwHJKYcm&_nc_oc=AdqSlUQrnhxEs6Ypk-EU7QwDxa3kDbbe9wnSLd5DfLztjR_ogK8-OhwkOKCUf5v7ztg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0oQWij6_jukPADdXrqZO5JC3JYi_T9afeZNuZ7Bzz2nw&oe=69ECC36C"}, {"file_name": "GTP-MetaScreenshot04.png", "id": "1268488450404035", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974924_1268488453737368_7408781568125309811_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nKmjpOOPKTAQ7kNvwH1yQP2&_nc_oc=AdoUfvndoQ05v5RosG-Aw6TQEXl5w0GOoqjaPvSWaCGsTxWuO6eSHegwylm2BnOneV8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af05D4gK1s_0b0umVVJ_G_D5Prgll0eIFtvuU2-k0XNYWA&oe=69ECD06E"}, {"file_name": "GTP-MetaScreenshot01.png", "id": "1132538277408339", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982613_1132538280741672_3561373941679093613_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jh2cZgwsisIQ7kNvwGnLWi4&_nc_oc=AdqOYbf3bpS5eDdTlt8hkO1k4-UbBYiZL6-WGFZCdgeBTNN7qHot5xTYXlDrCUueWfw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af24UIeUFJpytxQyycNukE8GEmMXgkHXQ1IvqHjGGXVH2Q&oe=69ECAE0B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover-Landscape.png", "id": "999779757647287", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39036641_999779760980620_7423226441179076258_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zAJhcizU0moQ7kNvwEAX3Ug&_nc_oc=AdqI4VIcOTWFe1S1bOsLh8v1kWoeD1pkqROrVJFQy9oEsebKEb3UqSCMV8fI1QbGBo8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af02qP-_xdkcIc7aI1bx2pjr9ZqND4zdpNQ_mxlUQRKsEQ&oe=69ECA413"}, "display_name": "Give The People What They Want", "keywords": [], "long_description": "In Give the People What They Want, you play as a lowly mining robot who has been promoted to the service industry. It's a tough job, customers can be very demanding, and you'll need to adapt to whatever people need based on the jobs you're given. You will need to learn how to optimize to get people what they want in the shortest amount of time and deal with their increasingly complex requests to show that you can be a good quality service bot.\n\nKey Features:\n3 different stages with unique environments and items\nBonus challenges that will let you earn extra points\nCustomizable robot body system to be the best bot you can be\n\n\nIt's a tough job, but someone's gotta do it, and apparently, there's nobody else who wants to. So it's up to you to Give the People What They Want. Will you succeed as the best service bot ever? Or are you destined for the scrap heap? ", "short_description": "A VR Game where you take on odd jobs, become your ideal self, and throw things at customers' faces."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.starlightvintagestudios.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Starlight Vintage Studios", "support_website_url": null, "website_url": "https://starlightvintagestudios.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1097095507628917"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974583_1093614677983865_5973055568815117516_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZVo
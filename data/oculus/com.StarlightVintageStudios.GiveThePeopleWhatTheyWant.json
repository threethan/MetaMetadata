n.com&_nc_ss=7f20f&oh=00_AQTDkp9-xT44YdSGMJu0sTCn4p4fNrOzs1_Y-OtdcIqMBg&oe=6AFF0A70"}, {"file_name": "GTP-MetaScreenshot03.png", "id": "857097335678212", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/57569472_857097339011545_4931694670950153394_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G78GWzNYdVsQ7kNvwEo0s5I&_nc_oc=AdoLajpR-0cUL0Y8GeiPsGpTfHY9kPMl42A0_u6RwFtE-pHgrqPe-Y1Kza2tOpHH6Ro&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSFPAHrBfyA68oT7CdwmntCYyqkGSQrMwsAUT-X8m_oqw&oe=6AFF33AC"}, {"file_name": "GTP-MetaScreenshot04.png", "id": "1268488450404035", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/38974924_1268488453737368_7408781568125309811_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SpxV9D_eWK8Q7kNvwGq9bMr&_nc_oc=AdpmPrRNXYJ9CGBM9Z36RByJ4vQGAaHpyO43owv--9e4mrxUl-41YOcVrTNNce611d4&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSLuAnZK7pYAiSIxWa0WE75j1t1Ixix7ZW-QlMxgvvUNA&oe=6AFF086E"}, {"file_name": "GTP-MetaScreenshot01.png", "id": "1132538277408339", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/38982613_1132538280741672_3561373941679093613_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o9LsY8TmNXoQ7kNvwGxpxrD&_nc_oc=Adp4r2dBCKx1R5VRG6_jh30K4gDjM5-8D1NiMCL4jJE3ayWhjDg6S0xQViNgHt6pX6A&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRwP2PyirkLdXWkQlCT1ssT4DDI7iTmBcXV-gWlc1OkfQ&oe=6AFF1E4B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover-Landscape.png", "id": "999779757647287", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39036641_999779760980620_7423226441179076258_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WhRh4j54epwQ7kNvwElbRh_&_nc_oc=AdpUmo-E3YbEP2VY2x1dt2Q9EVv_zqQLzfByxHAnYPv8YXHlzeWwpzRYXvcYeKEJzkE&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRsM7f0xEWGP_lqeH7vgtXaK6Y6NHYSNIIVX-_TSicihA&oe=6AFF1453"}, "display_name": "Give The People What They Want", "keywords": [], "long_description": "In Give the People What They Want, you play as a lowly mining robot who has been promoted to the service industry. It's a tough job, customers can be very demanding, and you'll need to adapt to whatever people need based on the jobs you're given. You will need to learn how to optimize to get people what they want in the shortest amount of time and deal with their increasingly complex requests to show that you can be a good quality service bot.\n\nKey Features:\n3 different stages with unique environments and items\nBonus challenges that will let you earn extra points\nCustomizable robot body system to be the best bot you can be\n\n\nIt's a tough job, but someone's gotta do it, and apparently, there's nobody else who wants to. So it's up to you to Give the People What They Want. Will you succeed as the best service bot ever? Or are you destined for the scrap heap? ", "short_description": "A VR Game where you take on odd jobs, become your ideal self, and throw things at customers' faces."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.starlightvintagestudios.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Starlight Vintage Studios", "support_website_url": null, "website_url": "https://starlightvintagestudios.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_S
&oh=00_AftzUFNuDCfY0rMoONFpJtgSFYarIh40S3Kr3jOckAfNog&oe=69A6F40C"}, {"file_name": "1008x1440.png", "id": "473981512077033", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982518_473981515410366_5571885850947011923_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=X2JD5_ji6LkQ7kNvwEmxsoz&_nc_oc=AdkTwCj6X92PB2BQCCa3sbNmjCdDwuxRAI182Vf8D67PZel66MlCPyGO820xLzyjPDE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfujP7Wu562doV19sqaH4qCI9NC0WmTN9Wvdi0pSaTZqTw&oe=69A6EE98"}]}, "id": "861301175878314", "locale": "en_US", "screenshots": [{"file_name": "2560x1440 (1).png", "id": "1242580393405131", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974594_1242580396738464_7600342908274045866_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zaLlkRovanQQ7kNvwHSHC9q&_nc_oc=AdnvMD-pXT60VK0FeZI07jbNq_VTwe80hb_kdsubhzT5ComZ2bSmGDcgseXosrxsLXY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfuWngjlQLmA7FTnHj-Uc-J6orLU9o6M9afyb6TXgdppyQ&oe=69A6C67B"}, {"file_name": "2560x1440 (3).png", "id": "866033444949053", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974681_866033448282386_1060735077748256107_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eaf7ysEyuHMQ7kNvwFSUVk-&_nc_oc=AdmeTKbvadqm2Wb4Mt4cuB-6s48iMaDyjA6GSqibsOrPAzWtdQXFDux-v5wjlW0e9IM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfvlgOahlL57SkDVMHWutbsb4yauDRx1dzJkqHn8JDF8mQ&oe=69A6C118"}, {"file_name": "2560x1440 (4).png", "id": "443547678685303", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974547_443547682018636_6322347026334124666_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ls7buQZ0gjoQ7kNvwFmkOyz&_nc_oc=Admt1eoFgw9avlQyszRu0rmq9S9pvICM0GXb0WBdM9UD9S8x7OY3GBC1ndxrp9Q_WDI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfvDIQAW9JEaOKtqt5IMo8qbHjBe4tilaTI7yYV71iLIXA&oe=69A6E434"}, {"file_name": "2560x1440 (5).png", "id": "878891567525558", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974867_878891570858891_8040644650588623139_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eA9-ta8eEpMQ7kNvwG2jvnD&_nc_oc=AdnIZue4LWVuT9BlIgaiI8EP91JZjOmL2eJSVh8syMPkjVo-VlmrYwd5sfLs7SimvA4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Afvef1jaedjnlLRHwuC9SiHROO_MkaWEYf3hEr8kex7Dxg&oe=69A6C301"}, {"file_name": "2560x1440 (6).png", "id": "522360993660696", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974782_522361000327362_1265686494838610386_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vi0gZGz2ElgQ7kNvwF4kntb&_nc_oc=AdlvrATuV1dwbG8LRaYvSOX-XQrGjW7qOwY9IuubXfdX66Tozab5Eu5yWFno3-kt7mI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Afu7T_ngCbAQEiOY3oT5E-WERka4SI4aGs0H1O8_f-KK_Q&oe=69A6C542"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440 (7).png", "id": "859600769565255", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/65228806_859600772898588_578693433817766136_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D4Hmc4foOGIQ7kNvwF0FVmz&_nc_oc=Adl9y_Q2EHST8r0HpCoEi-lpq6VqwqaqYUHX0JRvGsLe4uHXrSyRcdJBHjW7KbyIldM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AftJEgLVzGknU4VN11FYhNRLI_jl2RlUHjXRhK22VBrong&oe=69A6D91A"}, "display_name": "Feeling Fire Gun", "keywords": ["FeelingFireGun", "TTTcorporation"], "long_description": "\"Feeling Fire Gun\" is a groundbreaking VR application that seamlessly melds hyper-realistic firearm simulation with boundless creativity in a vast virtual playground. This immersive experience offers users the unique opportunity to wield meticulously crafted digital firearms that mirror their real-world counterparts in look, feel, and function, complete with authentic sounds and recoil.\n\nBut \"Feeling Fire Gun\" goes far beyond simple target practice. It empowers users to become architects of their virtual realms, allowing them to conjure, manipulate, and interact with a diverse array of objects. From crafting intricate structures to designing challenging obstacle courses, the only limit is the user's imagination.\n\nSet in an expansive, multi-terrain world, players can traverse their creations through various modes of locomotion, be it walking, teleporting, or even defying gravity. This freedom of movement complements the app's versatile gameplay modes, which include a sandbox-style free mode for uninhibited exploration and creation, a series of skill-testing challenges, and a dynamic multiplayer environment for shared experiences.", "short_description": "\"Feeling Fire Gun\" isn't just a game; it's a platform that bridges the gap between realistic simulation and creative expression."}]}, "developer_name": null, "developer_privacy_policy_url": "https://tttcorporation.xyz/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "TTTcorporation", "support_website_url": null, "website_url": "https://tttcorporation.xyz/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1990104051447093"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "7957890484330737"}}]}, "scheduled_offers": {"count": 0, "nodes": []}, "baseline_offer": null, "is_approved": true, "firstOffer": {"nodes": []}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "8056505367802581", "version": "0.4"}, "id": "1046600470143803", "channel_name": "LIVE"}]}, "is_for_oculus_keys_on
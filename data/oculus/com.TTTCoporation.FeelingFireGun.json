&oh=00_AfuMbk3uuMGOhauTLPy5t67uglhyhFGyCKQFMI1Cf1eSEA&oe=69A2C74C"}, {"file_name": "1008x1440.png", "id": "473981512077033", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982518_473981515410366_5571885850947011923_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XQj6VBWD9eMQ7kNvwGvfbo1&_nc_oc=AdlnKwHhGF12ESA5g28FjunFN3DHOzteGoI12mOaR2TE0QkQeoYm3lwpHbV2GEvyXE4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AftsA-V_ee4egZOLJaC7aMgR3F6qZZanWvauS3i0YcM5NA&oe=69A2FA18"}]}, "id": "861301175878314", "locale": "en_US", "screenshots": [{"file_name": "2560x1440 (1).png", "id": "1242580393405131", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974594_1242580396738464_7600342908274045866_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VpF7Lwhk7UwQ7kNvwGDDuiZ&_nc_oc=AdnaRA4EypfQnCYn3uSSvTVxonej108jpFhsbxzB8ZmhPDhp5J2iPvCwi2cswUB_FlM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AftZ0VxLEsBfSPODk0SBq15WA01MEG3ASG8kW7ipVa6o3w&oe=69A2D1FB"}, {"file_name": "2560x1440 (3).png", "id": "866033444949053", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974681_866033448282386_1060735077748256107_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7qU97n_xt8cQ7kNvwE4K9g0&_nc_oc=AdkHRe4cIeB7kAC473U49rztpcMUu6bYTanMpNVUq3a4t3yYRhC3f-amt7UGKVPGWVg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afs5CuWrw1PdM3JVBNRqwLz4yDo0bLthZSlc7zbb1YLVww&oe=69A2CC98"}, {"file_name": "2560x1440 (4).png", "id": "443547678685303", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974547_443547682018636_6322347026334124666_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nCJc19pajVgQ7kNvwHidxnP&_nc_oc=AdlPG7QYXmv2Q39XrhTjiDFDDzuUR5F4fhP48792qAODKef1CcUd34kTd-7JiNrLe9Q&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afspose649CI5sH3Pztx8TYa-nQNeMFeFWTGERbiDCdgiA&oe=69A2EFB4"}, {"file_name": "2560x1440 (5).png", "id": "878891567525558", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974867_878891570858891_8040644650588623139_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E_zRgkuD6aEQ7kNvwG9Hbnr&_nc_oc=AdnS26kdrYkMOJL7Y4U_0OiM3RsiAbzzWrX-_Ir7ApL3eGHjMkePRILxGdMl6bHd4JE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfuYYvT-j6CdGMkpdfuzjPS99YW_jT1gbXU5F0d_w0vzzQ&oe=69A2CE81"}, {"file_name": "2560x1440 (6).png", "id": "522360993660696", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974782_522361000327362_1265686494838610386_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hyRasw00a5AQ7kNvwGyNiDy&_nc_oc=AdmY8DG8IEyWrSaByZLZGbsMaJwwolR_fv8q0KBtQyTXexaodxX1asuIDnkDZ3O1eIE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AftwBdz1SgQs2tkOz9gkD0SL7mxRVp5nL3vYMKXwSdK_UA&oe=69A2D0C2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440 (7).png", "id": "859600769565255", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/65228806_859600772898588_578693433817766136_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=p_YLYi8k04cQ7kNvwEkDP1u&_nc_oc=AdlsKhOuozAygV2SMpvZD6UxOZYJv_7z2bmkX1odQg_VzJPxlFx8i7Fa3blQZmsrtI8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Aft3reUHzCNd9zuc57Ozw-5V9bWzzr72BMoKQGkkhzwAow&oe=69A2E49A"}, "display_name": "Feeling Fire Gun", "keywords": ["FeelingFireGun", "TTTcorporation"], "long_description": "\"Feeling Fire Gun\" is a groundbreaking VR application that seamlessly melds hyper-realistic firearm simulation with boundless creativity in a vast virtual playground. This immersive experience offers users the unique opportunity to wield meticulously crafted digital firearms that mirror their real-world counterparts in look, feel, and function, complete with authentic sounds and recoil.\n\nBut \"Feeling Fire Gun\" goes far beyond simple target practice. It empowers users to become architects of their virtual realms, allowing them to conjure, manipulate, and interact with a diverse array of objects. From crafting intricate structures to designing challenging obstacle courses, the only limit is the user's imagination.\n\nSet in an expansive, multi-terrain world, players can traverse their creations through various modes of locomotion, be it walking, teleporting, or even defying gravity. This freedom of movement complements the app's versatile gameplay modes, which include a sandbox-style free mode for uninhibited exploration and creation, a series of skill-testing challenges, and a dynamic multiplayer environment for shared experiences.", "short_description": "\"Feeling Fire Gun\" isn't just a game; it's a platform that bridges the gap between realistic simulation and creative expression."}]}, "developer_name": null, "developer_privacy_policy_url": "https://tttcorporation.xyz/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "TTTcorporation", "support_website_url": null, "website_url": "https://tttcorporation.xyz/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1990104051447093"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "7957890484330737"}}]}, "scheduled_offers": {"count": 0, "nodes": []}, "baseline_offer": null, "is_approved": true, "firstOffer": {"nodes": []}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "8056505367802581", "version": "0.4"}, "id": "1046600470143803", "channel_name": "LIVE"}]}, "is_for_oculus_keys_on
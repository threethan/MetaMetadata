4666_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xQRaYfr01t8Q7kNvwHQnq55&_nc_oc=AdqBs2Jcfke9Tois3kYXRODTacisd6giKbnEX2hhMsTKbJrchqMSgNenBXms05Zxjko&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQZ8deyfAnv12RXh7xA9-RhuRWAjvTOPgAPODXya-FFZQ&oe=6AFC90F4"}, {"file_name": "2560x1440 (5).png", "id": "878891567525558", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974867_878891570858891_8040644650588623139_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yeVxbYrmaC0Q7kNvwHCPPB8&_nc_oc=AdqEo_HoPoSff1Z5S25LXsP0spAAkw2qTF3Yhvn6DTkJJPsbWEHyvflky9HpLegtmDU&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQKRCkB2HffIQznc7qMIa1n2_Wo0S0mEHXb0fOTFBzhVw&oe=6AFC6FC1"}, {"file_name": "2560x1440 (6).png", "id": "522360993660696", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974782_522361000327362_1265686494838610386_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yi55g8Jqt-cQ7kNvwGxzI0Q&_nc_oc=AdpOkQiw9bOd94YKh13dhVOjGP8aJDc_FBFx8v1C-me0czNqBTuTwHUckrxWqao2R3I&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSpkQOT0_0L8bA93ZKqLK5ZgguUMLfKFli4uy-WW-z2yw&oe=6AFC7202"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440 (7).png", "id": "859600769565255", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/65228806_859600772898588_578693433817766136_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mLuvCN8FA9UQ7kNvwHEHpWQ&_nc_oc=Adr7g-5bvi2jzti0hFvCcOF33EfaKUO-wGUuzvI1zMubP7ixrVDcLp8cWP3uS2kXIJk&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRP2bXV59l7ivsTSXG74q7IwOEt5f7t9Y_GirNssBDRcw&oe=6AFC85DA"}, "display_name": "Feeling Fire Gun", "keywords": ["FeelingFireGun", "TTTcorporation"], "long_description": "\"Feeling Fire Gun\" is a groundbreaking VR application that seamlessly melds hyper-realistic firearm simulation with boundless creativity in a vast virtual playground. This immersive experience offers users the unique opportunity to wield meticulously crafted digital firearms that mirror their real-world counterparts in look, feel, and function, complete with authentic sounds and recoil.\n\nBut \"Feeling Fire Gun\" goes far beyond simple target practice. It empowers users to become architects of their virtual realms, allowing them to conjure, manipulate, and interact with a diverse array of objects. From crafting intricate structures to designing challenging obstacle courses, the only limit is the user's imagination.\n\nSet in an expansive, multi-terrain world, players can traverse their creations through various modes of locomotion, be it walking, teleporting, or even defying gravity. This freedom of movement complements the app's versatile gameplay modes, which include a sandbox-style free mode for uninhibited exploration and creation, a series of skill-testing challenges, and a dynamic multiplayer environment for shared experiences.", "short_description": "\"Feeling Fire Gun\" isn't just a game; it's a platform that bridges the gap between realistic simulation and creative expression."}]}, "developer_name": null, "developer_privacy_policy_url": "https://tttcorporation.xyz/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "TTTcorporation", "support_website_url": null, "website_url": "https://tttcorporation.xyz/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1990104051447093"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULU
&oh=00_Afu_USjpSG1OteAY71rEbH-GIiUmWTkKjonkSlbBaRD8GA&oe=69A4510C"}, {"file_name": "1008x1440.png", "id": "473981512077033", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982518_473981515410366_5571885850947011923_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XQj6VBWD9eMQ7kNvwFTKin6&_nc_oc=AdnPe5ZRs8JE12KO8GxX1pmnIaHDftp5--Wi0sg1tiVSa1OZbA6XEpzQjb3A09pGzYY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AfsBF4VP81fcNB4DOvNC-FHKXqHzMoCyRexwN4_qZud1kg&oe=69A44B98"}]}, "id": "861301175878314", "locale": "en_US", "screenshots": [{"file_name": "2560x1440 (1).png", "id": "1242580393405131", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974594_1242580396738464_7600342908274045866_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VpF7Lwhk7UwQ7kNvwHeyQHg&_nc_oc=Adm7KHz5ZcO9sjKhw-LyCfRiy4rUUdk3fYkmJR82lBsSt25sii2zaTxat90WRH73abo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_AfuCBbmPk7umYyNuvE_EgCqausRc1E35U-OkEca3IhPGRA&oe=69A4237B"}, {"file_name": "2560x1440 (3).png", "id": "866033444949053", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974681_866033448282386_1060735077748256107_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7qU97n_xt8cQ7kNvwExr7vu&_nc_oc=AdlH_mB376k3PbWGcR5I28fkHRLywyzYAoOXFB4znyVz7qW8tGqStzh_dYZq2PiK5oQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AfsAs-4dJaWtqbwGTqGeRWavS08P7CCBSwW6JBfRH3Fxfw&oe=69A41E18"}, {"file_name": "2560x1440 (4).png", "id": "443547678685303", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974547_443547682018636_6322347026334124666_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nCJc19pajVgQ7kNvwFX_6Ry&_nc_oc=Adlp5J42hEtmlnkfn7YhR3QKYq3h2PIuBTlIxSq5Qv3DPfrSPfKJZ_hKG9vsyBLr2fM&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_Afs-0wepYrO_iyirf7PSMzxEt33E8hU4qQQ0Ybf5HWUX7Q&oe=69A44134"}, {"file_name": "2560x1440 (5).png", "id": "878891567525558", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974867_878891570858891_8040644650588623139_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eA9-ta8eEpMQ7kNvwESEjqN&_nc_oc=AdnEzTyfJ2hj1nTpZKD2_yIYCzq_uDILDnrMHf8nVpcPlftdxvvtJRdG1SrC77OqGLQ&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AftHntdh0LEDUND1RZ9bvchk7ykCX6J5BKYcO1C2iF_n1g&oe=69A42001"}, {"file_name": "2560x1440 (6).png", "id": "522360993660696", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974782_522361000327362_1265686494838610386_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vi0gZGz2ElgQ7kNvwE5SR7P&_nc_oc=AdkPxraHrT-veDXRa-62tLP-PWtfV5-ON8rfzF9vHCA3hlvaB2PnNT7trWwLKODhz04&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AfsF8dyY6GtrWgF3Suw6CS2g5Cwn_IxoCQspM9RXf14IPw&oe=69A42242"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440 (7).png", "id": "859600769565255", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/65228806_859600772898588_578693433817766136_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=p_YLYi8k04cQ7kNvwGCU6_Z&_nc_oc=AdnduazgBN9OcRfkDPQ_0C-I5Q50Ns1P3kaYapKf2zBsRdCKhUaGCRsVBQdl7g-D3xE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AfsJ4X7dnmeeNGIV6GAuNrAcHdUgWz4sMpZsvXgOUCtzlA&oe=69A4361A"}, "display_name": "Feeling Fire Gun", "keywords": ["FeelingFireGun", "TTTcorporation"], "long_description": "\"Feeling Fire Gun\" is a groundbreaking VR application that seamlessly melds hyper-realistic firearm simulation with boundless creativity in a vast virtual playground. This immersive experience offers users the unique opportunity to wield meticulously crafted digital firearms that mirror their real-world counterparts in look, feel, and function, complete with authentic sounds and recoil.\n\nBut \"Feeling Fire Gun\" goes far beyond simple target practice. It empowers users to become architects of their virtual realms, allowing them to conjure, manipulate, and interact with a diverse array of objects. From crafting intricate structures to designing challenging obstacle courses, the only limit is the user's imagination.\n\nSet in an expansive, multi-terrain world, players can traverse their creations through various modes of locomotion, be it walking, teleporting, or even defying gravity. This freedom of movement complements the app's versatile gameplay modes, which include a sandbox-style free mode for uninhibited exploration and creation, a series of skill-testing challenges, and a dynamic multiplayer environment for shared experiences.", "short_description": "\"Feeling Fire Gun\" isn't just a game; it's a platform that bridges the gap between realistic simulation and creative expression."}]}, "developer_name": null, "developer_privacy_policy_url": "https://tttcorporation.xyz/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "TTTcorporation", "support_website_url": null, "website_url": "https://tttcorporation.xyz/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1990104051447093"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "7957890484330737"}}]}, "scheduled_offers": {"count": 0, "nodes": []}, "baseline_offer": null, "is_approved": true, "firstOffer": {"nodes": []}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "8056505367802581", "version": "0.4"}, "id": "1046600470143803", "channel_name": "LIVE"}]}, "is_for_oculus_keys_on
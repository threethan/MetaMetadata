4666_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FP1buT_6KT4Q7kNvwHnlhpy&_nc_oc=Adq4DjMmykvBHVVcFcAqMu9p6ACPrf6ZKP8qErhvpQCp6g80clOXRsZTJM8Z0hE3nC4&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTo0Hj-cg_a3chzZb5Yg-fA3eZiqwb0bfs_VQXO29WA2Q&oe=6B0B1174"}, {"file_name": "2560x1440 (5).png", "id": "878891567525558", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974867_878891570858891_8040644650588623139_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oYt2tzMzc-0Q7kNvwFItMKK&_nc_oc=AdoEm0tQd0ZaSs110E4o4VulHQ_Hn5i2HcFxNZd__SeypLR0Na0MeH7aemH06pIJxmI&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQiaXhJR0HwWsL2wYKdbc2kJ1QjLI0Tj5PN6YFFrSpWrQ&oe=6B0B2881"}, {"file_name": "2560x1440 (6).png", "id": "522360993660696", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974782_522361000327362_1265686494838610386_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ro4HNSLbLxgQ7kNvwGcpc-G&_nc_oc=AdotcnwmXnn2LqQLRoZGO221Pu8wvTm4CreN86Of1oTXlxFCwOLU4F3QQeEs_67TQGc&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTBLOOj_rY7xr329bdflyjdVrFzS1z7nNj4zo8IoP5Pmw&oe=6B0B2AC2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440 (7).png", "id": "859600769565255", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/65228806_859600772898588_578693433817766136_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gVxhS7uiXvsQ7kNvwHOJ_3R&_nc_oc=Adp23pW-0d0_nVgfsGLGhZvOSPs8X0N4GWdV0ROuqDzkH_mujQjxfWHRvl3A1CUA9pI&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRTtswxblpl0tQdmTeohgPXAV2SuwLx6_5yCAaWkplIIw&oe=6B0B3E9A"}, "display_name": "Feeling Fire Gun", "keywords": ["FeelingFireGun", "TTTcorporation"], "long_description": "\"Feeling Fire Gun\" is a groundbreaking VR application that seamlessly melds hyper-realistic firearm simulation with boundless creativity in a vast virtual playground. This immersive experience offers users the unique opportunity to wield meticulously crafted digital firearms that mirror their real-world counterparts in look, feel, and function, complete with authentic sounds and recoil.\n\nBut \"Feeling Fire Gun\" goes far beyond simple target practice. It empowers users to become architects of their virtual realms, allowing them to conjure, manipulate, and interact with a diverse array of objects. From crafting intricate structures to designing challenging obstacle courses, the only limit is the user's imagination.\n\nSet in an expansive, multi-terrain world, players can traverse their creations through various modes of locomotion, be it walking, teleporting, or even defying gravity. This freedom of movement complements the app's versatile gameplay modes, which include a sandbox-style free mode for uninhibited exploration and creation, a series of skill-testing challenges, and a dynamic multiplayer environment for shared experiences.", "short_description": "\"Feeling Fire Gun\" isn't just a game; it's a platform that bridges the gap between realistic simulation and creative expression."}]}, "developer_name": null, "developer_privacy_policy_url": "https://tttcorporation.xyz/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "TTTcorporation", "support_website_url": null, "website_url": "https://tttcorporation.xyz/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1990104051447093"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULU
891567525558", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974867_878891570858891_8040644650588623139_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d3c1jQhvg2sQ7kNvwFG-Pw6&_nc_oc=AdpGd7FyvanLIY7D5crGggYCLq66W8gZShsP2cpaeTHAq_Tnf4Okq5t2mKq29NEBKtU&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&oh=00_Af0PuX1HnO7oVxo7uV_mLR_OfEnxAJQeohGtkS881rxsxA&oe=69F1E881"}, {"file_name": "2560x1440 (6).png", "id": "522360993660696", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974782_522361000327362_1265686494838610386_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MS71GZPUF8YQ7kNvwHw1G5b&_nc_oc=Adqka3ciS03UMrlMLi6P__vQqzuJeKz9JbpaGPR0ScP6L_zeJzbKtuA3G1pGE16PAPg&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&oh=00_Af3AlEULD_YogzlhdkzeYBRbKVy6ji6Z8LiEsz5skWlxLw&oe=69F1EAC2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440 (7).png", "id": "859600769565255", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/65228806_859600772898588_578693433817766136_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RkuJvTgLXKQQ7kNvwHCrKym&_nc_oc=AdrIpZvIjRc7mSWyORjjZFJcRPpOuChN_N51YiLyILMdnKmmqa6NBq-NQP51tJ1HXOY&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&oh=00_Af10C2aKjV01ERKa-Gi_nMl4S38eMxLx5G2CPuJG4-nCxA&oe=69F1FE9A"}, "display_name": "Feeling Fire Gun", "keywords": ["FeelingFireGun", "TTTcorporation"], "long_description": "\"Feeling Fire Gun\" is a groundbreaking VR application that seamlessly melds hyper-realistic firearm simulation with boundless creativity in a vast virtual playground. This immersive experience offers users the unique opportunity to wield meticulously crafted digital firearms that mirror their real-world counterparts in look, feel, and function, complete with authentic sounds and recoil.\n\nBut \"Feeling Fire Gun\" goes far beyond simple target practice. It empowers users to become architects of their virtual realms, allowing them to conjure, manipulate, and interact with a diverse array of objects. From crafting intricate structures to designing challenging obstacle courses, the only limit is the user's imagination.\n\nSet in an expansive, multi-terrain world, players can traverse their creations through various modes of locomotion, be it walking, teleporting, or even defying gravity. This freedom of movement complements the app's versatile gameplay modes, which include a sandbox-style free mode for uninhibited exploration and creation, a series of skill-testing challenges, and a dynamic multiplayer environment for shared experiences.", "short_description": "\"Feeling Fire Gun\" isn't just a game; it's a platform that bridges the gap between realistic simulation and creative expression."}]}, "developer_name": null, "developer_privacy_policy_url": "https://tttcorporation.xyz/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "TTTcorporation", "support_website_url": null, "website_url": "https://tttcorporation.xyz/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1990104051447093"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "7957890484330737"}}]}, "scheduled_offers": {"count": 0, "nodes": []}, "baseline_offer": null, "is_approved": true, "firstOffer": {"nodes": []}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "8056505367802581", "version": "0.4"
&oh=00_AfspwjZnft5OqpeOykaQckQOCy2pXwBbS19ndhC7gVtH0g&oe=69A56A4C"}, {"file_name": "1008x1440.png", "id": "473981512077033", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38982518_473981515410366_5571885850947011923_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=X2JD5_ji6LkQ7kNvwECHahl&_nc_oc=Adm6udneAEuWN5oB-moykuFWG4ogVE_EURLNWRvnF0hppQ7NzDvvdD9Ie8DOCihZVrs&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_Afv0_QMFi46YM7UOKknJ0OkgGfeGdskLYMv2KINCbiVt_Q&oe=69A59D18"}]}, "id": "861301175878314", "locale": "en_US", "screenshots": [{"file_name": "2560x1440 (1).png", "id": "1242580393405131", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974594_1242580396738464_7600342908274045866_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zaLlkRovanQQ7kNvwH3JjAU&_nc_oc=AdncS0KHiw2BFR_-Jybmkc3H2KyFm7ZRIAbxk8w1wnIiU6pAAEruMQMAOrZU9o6ZhzY&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_AftP5OrRAKzq1dnajlz0mpRM6ROTzeg5G9so3dFnpZ3qQQ&oe=69A574FB"}, {"file_name": "2560x1440 (3).png", "id": "866033444949053", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974681_866033448282386_1060735077748256107_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7qU97n_xt8cQ7kNvwEyR58M&_nc_oc=AdmYMTsh8qodYhzcUg_yp_ultkFfzXOSEzOVnsX3QXUr0t1dVzcOi5fDqrkG5e0aqJg&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_Aft3EsqoY0cNTKWz77RyAOEdlantL-25P9HGstxtuRIyJA&oe=69A56F98"}, {"file_name": "2560x1440 (4).png", "id": "443547678685303", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974547_443547682018636_6322347026334124666_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nCJc19pajVgQ7kNvwGGqvBW&_nc_oc=AdkLcaIsZLgkBfY9lXxiDWloteBtIQejnuPJzhYr4vqswPeAu77y-2GZXOKJUDBmY8Y&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_AfsZJXbg0o1FYlo6u8KbXWOZfwePiaU3_ffJVjYpWXJAOA&oe=69A592B4"}, {"file_name": "2560x1440 (5).png", "id": "878891567525558", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974867_878891570858891_8040644650588623139_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eA9-ta8eEpMQ7kNvwEwCc_g&_nc_oc=AdkUb161fCCAVrqTdOP2PBCxjrNEarLlGEBKU0EkqKHSMPULsaI0qSmSiWZjPwSmiYU&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&oh=00_AftTW0vedIruwFhvb8wUk2jLEbGurhjpf1ZXd2hoJ0cp7g&oe=69A57181"}, {"file_name": "2560x1440 (6).png", "id": "522360993660696", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974782_522361000327362_1265686494838610386_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vi0gZGz2ElgQ7kNvwFVcq44&_nc_oc=Adma87YvySUgWltaINYAxzh0x-N_U0qXnTL6WxXpo-p17bMPe10c0VB4a4XbjCN0U40&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&oh=00_AftwQn8GdxeA_NqRSPo4hNSEmrxtlgAphyELS9jT2SXL_A&oe=69A573C2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440 (7).png", "id": "859600769565255", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/65228806_859600772898588_578693433817766136_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=p_YLYi8k04cQ7kNvwFNZWiz&_nc_oc=Adk6zMCnx0BsP1igeJewDPMbhRsztNfou2IIlYd-0HHY1SrQVJ8PL1pHa2o5UfVFZFg&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&oh=00_AfudijndIO6RXDKWLl9f3tVOL6m31E5qWXEiP69twZhBlA&oe=69A5879A"}, "display_name": "Feeling Fire Gun", "keywords": ["FeelingFireGun", "TTTcorporation"], "long_description": "\"Feeling Fire Gun\" is a groundbreaking VR application that seamlessly melds hyper-realistic firearm simulation with boundless creativity in a vast virtual playground. This immersive experience offers users the unique opportunity to wield meticulously crafted digital firearms that mirror their real-world counterparts in look, feel, and function, complete with authentic sounds and recoil.\n\nBut \"Feeling Fire Gun\" goes far beyond simple target practice. It empowers users to become architects of their virtual realms, allowing them to conjure, manipulate, and interact with a diverse array of objects. From crafting intricate structures to designing challenging obstacle courses, the only limit is the user's imagination.\n\nSet in an expansive, multi-terrain world, players can traverse their creations through various modes of locomotion, be it walking, teleporting, or even defying gravity. This freedom of movement complements the app's versatile gameplay modes, which include a sandbox-style free mode for uninhibited exploration and creation, a series of skill-testing challenges, and a dynamic multiplayer environment for shared experiences.", "short_description": "\"Feeling Fire Gun\" isn't just a game; it's a platform that bridges the gap between realistic simulation and creative expression."}]}, "developer_name": null, "developer_privacy_policy_url": "https://tttcorporation.xyz/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "TTTcorporation", "support_website_url": null, "website_url": "https://tttcorporation.xyz/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1990104051447093"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "7957890484330737"}}]}, "scheduled_offers": {"count": 0, "nodes": []}, "baseline_offer": null, "is_approved": true, "firstOffer": {"nodes": []}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "8056505367802581", "version": "0.4"}, "id": "1046600470143803", "channel_name": "LIVE"}]}, "is_for_oculus_keys_on
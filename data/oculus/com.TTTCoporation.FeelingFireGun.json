&oh=00_Afv2w8HDeLlrIuZcCQ6be5OA9pIP2n5Og9VFQSyiPnbjbg&oe=69A0244C"}, {"file_name": "1008x1440.png", "id": "473981512077033", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982518_473981515410366_5571885850947011923_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=voWzVMEDj0EQ7kNvwG8oUaE&_nc_oc=AdnCJIwBg_vLrAlsIKuppYBU4XhsdZ-N2SqvkIdyeqF1jvffgxe5vAXxgElYfAOVIN0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Aft8KK7ZjWhsusIyJAdLbSEJCPGqt9utDJ1emOZb6Xwd8Q&oe=69A05718"}]}, "id": "861301175878314", "locale": "en_US", "screenshots": [{"file_name": "2560x1440 (1).png", "id": "1242580393405131", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974594_1242580396738464_7600342908274045866_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PVaGkxEmM5gQ7kNvwHPcgke&_nc_oc=Adkwra6CdFHLni6g5rXeLTU6JJpGV3yzqt8u09YWh5dpGSOp1kW65usiaJLe0G-Enn4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Aftm_wmvWIugx5CyOYiIpzi2BqPDtwXV8a010ngY11iIuw&oe=69A02EFB"}, {"file_name": "2560x1440 (3).png", "id": "866033444949053", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974681_866033448282386_1060735077748256107_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nsLE25nxLF4Q7kNvwEPsQJB&_nc_oc=Adm5UxB0KFV1JLvDr0zXalUAHQUqFRhCsRYu_TIUezO8Nfsve_KcRkXHX97l53b07dk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfveVMmv-vUvg0gypxMKF2Fj4jjjRcDqxuX4YnKWd8iU-g&oe=69A02998"}, {"file_name": "2560x1440 (4).png", "id": "443547678685303", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974547_443547682018636_6322347026334124666_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fSNOBsyQDDUQ7kNvwGvKhtq&_nc_oc=AdlFhe4zR0ReqJ5XY6HlgWPD-WVuJIl0cSbtzy54HBB3bTaN_2Lmz6RayleQabi6CCU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfthR7K8SrEjyldwc0CW-aVozvU0jtk5uLQwEjh-Tv3z_A&oe=69A04CB4"}, {"file_name": "2560x1440 (5).png", "id": "878891567525558", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974867_878891570858891_8040644650588623139_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E_zRgkuD6aEQ7kNvwF9xcRo&_nc_oc=AdmqEntjcksRiikCmJc9DGnK08IihH1EnOTErVofqYak-AY5XoR5iGfIn3sssagxPTo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AftahjNflej-y4gUFrOnStUi6FLejv14CytciwicujpWfQ&oe=69A02B81"}, {"file_name": "2560x1440 (6).png", "id": "522360993660696", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974782_522361000327362_1265686494838610386_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hyRasw00a5AQ7kNvwEkW3mx&_nc_oc=AdniHiO8-GTWuxw5ikNKLGQVjJ5qwR5NQ_RDQ2eYBH-JtADt6V8BebzgLuxhVGuBAVg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AftIUTImIGkdq8qOJ0d1gRMzKuBzyV127LYuu2_8hTcfAg&oe=69A02DC2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440 (7).png", "id": "859600769565255", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/65228806_859600772898588_578693433817766136_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jvE1qznpLcIQ7kNvwEe8mF9&_nc_oc=AdmP0ykBdJgLt-8okPT_xcIC_9j7PmU3a6xR5MiAHolt-u1insMMt6QeC8D4RdaKEec&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfuxIposiJqLIx3QgS25G3JnSuqBFoz94aWCz5u7_cjvLw&oe=69A0419A"}, "display_name": "Feeling Fire Gun", "keywords": ["FeelingFireGun", "TTTcorporation"], "long_description": "\"Feeling Fire Gun\" is a groundbreaking VR application that seamlessly melds hyper-realistic firearm simulation with boundless creativity in a vast virtual playground. This immersive experience offers users the unique opportunity to wield meticulously crafted digital firearms that mirror their real-world counterparts in look, feel, and function, complete with authentic sounds and recoil.\n\nBut \"Feeling Fire Gun\" goes far beyond simple target practice. It empowers users to become architects of their virtual realms, allowing them to conjure, manipulate, and interact with a diverse array of objects. From crafting intricate structures to designing challenging obstacle courses, the only limit is the user's imagination.\n\nSet in an expansive, multi-terrain world, players can traverse their creations through various modes of locomotion, be it walking, teleporting, or even defying gravity. This freedom of movement complements the app's versatile gameplay modes, which include a sandbox-style free mode for uninhibited exploration and creation, a series of skill-testing challenges, and a dynamic multiplayer environment for shared experiences.", "short_description": "\"Feeling Fire Gun\" isn't just a game; it's a platform that bridges the gap between realistic simulation and creative expression."}]}, "developer_name": null, "developer_privacy_policy_url": "https://tttcorporation.xyz/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "TTTcorporation", "support_website_url": null, "website_url": "https://tttcorporation.xyz/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1990104051447093"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "7957890484330737"}}]}, "scheduled_offers": {"count": 0, "nodes": []}, "baseline_offer": null, "is_approved": true, "firstOffer": {"nodes": []}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "8056505367802581", "version": "0.4"}, "id": "1046600470143803", "channel_name": "LIVE"}]}, "is_for_oculus_keys_on
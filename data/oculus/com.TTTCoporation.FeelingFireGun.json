4666_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fNpFa6V9RZQQ7kNvwFWNheA&_nc_oc=Ado-PBE15jPvJ8jdHjxzvWTNfvzRKd_TTgKZ4WyopROwSGGrfob1n5nzUPxijSFU4mM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ22J-G_rHDswqHDU5V1s5zUOC0ZuPWHTYk7SzMe8AsCA&oe=6B032874"}, {"file_name": "2560x1440 (5).png", "id": "878891567525558", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974867_878891570858891_8040644650588623139_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T7Yngq0RaWQQ7kNvwHTRr5c&_nc_oc=AdqEcbLA-lHNX_XkDEXs2Cm4hE-TZKQMwHCbmx-Z2z0Vcle_6_6AZoXg4wxzI08BbF0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQs05ySo_jkKJqqZk-jMyWQ8r4Hp0kTiB3ztmRGUR0Q-Q&oe=6B030741"}, {"file_name": "2560x1440 (6).png", "id": "522360993660696", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974782_522361000327362_1265686494838610386_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Zb_p0JVpvDoQ7kNvwGkvAhx&_nc_oc=Ado-sEQzzx0Tex2wAPNOnIZCJF-kXRE7F1vxsYDgIjPSqRVqUu9HhV84uOXRHNbMSOs&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTTn3IVF2EO0tiaA203NVHYaZlGa1ExQOoW94fBdBGw6g&oe=6B030982"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440 (7).png", "id": "859600769565255", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/65228806_859600772898588_578693433817766136_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NcH5il35j2gQ7kNvwFo6AMo&_nc_oc=Adr-VZCMcCoNE5y6Mo8y78E_kY7DICjPGXdLqgU5yvKEp2pnwKsB1tvpEDfZ3rv7w-A&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ5eYqg7cNUsnxUJQbWF3RdDQW8_lmnuagdhNmGE-9v7g&oe=6B031D5A"}, "display_name": "Feeling Fire Gun", "keywords": ["FeelingFireGun", "TTTcorporation"], "long_description": "\"Feeling Fire Gun\" is a groundbreaking VR application that seamlessly melds hyper-realistic firearm simulation with boundless creativity in a vast virtual playground. This immersive experience offers users the unique opportunity to wield meticulously crafted digital firearms that mirror their real-world counterparts in look, feel, and function, complete with authentic sounds and recoil.\n\nBut \"Feeling Fire Gun\" goes far beyond simple target practice. It empowers users to become architects of their virtual realms, allowing them to conjure, manipulate, and interact with a diverse array of objects. From crafting intricate structures to designing challenging obstacle courses, the only limit is the user's imagination.\n\nSet in an expansive, multi-terrain world, players can traverse their creations through various modes of locomotion, be it walking, teleporting, or even defying gravity. This freedom of movement complements the app's versatile gameplay modes, which include a sandbox-style free mode for uninhibited exploration and creation, a series of skill-testing challenges, and a dynamic multiplayer environment for shared experiences.", "short_description": "\"Feeling Fire Gun\" isn't just a game; it's a platform that bridges the gap between realistic simulation and creative expression."}]}, "developer_name": null, "developer_privacy_policy_url": "https://tttcorporation.xyz/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "TTTcorporation", "support_website_url": null, "website_url": "https://tttcorporation.xyz/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1990104051447093"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULU
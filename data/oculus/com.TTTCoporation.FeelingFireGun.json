&oh=00_Af14wIyvpg2CBdPPRBSFK1owC1gtU1CmhhrtAlGjT6e9WA&oe=69F0C80C"}, {"file_name": "1008x1440.png", "id": "473981512077033", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982518_473981515410366_5571885850947011923_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Krg_7UnJ5Z0Q7kNvwH8QKsZ&_nc_oc=Ado93PeiUKmPqINXVQBX-9Ae2WtOJvSSHUoZwGRVET9_pihDfVi0DCHRLOvyYATtXNM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af1Y53fARbX-_Sas29qnZ_bacVWS-MMzlOrJxf-QLOV6Qw&oe=69F0C298"}]}, "id": "861301175878314", "locale": "en_US", "screenshots": [{"file_name": "2560x1440 (1).png", "id": "1242580393405131", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974594_1242580396738464_7600342908274045866_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WyiCL-B40vgQ7kNvwGCP3rW&_nc_oc=AdrCCiv0RlzW3XRCMC2YdOzInZeYaVblzrQlkE5IhFhxxQukJmc1TXiUsQZE2R7RQz0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Af06tQlF-3vYxze9K2ApmMNWCdsgDkd0vgsd5AHmeeL0sw&oe=69F09A7B"}, {"file_name": "2560x1440 (3).png", "id": "866033444949053", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974681_866033448282386_1060735077748256107_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JW81PB0xVcQQ7kNvwG1nB81&_nc_oc=AdqqOOKWGCQtaU8IyFvJwIcRZf0FYeqCffAz9-_c0NAkot8_fWgK7-QjXVcq6dxg0s4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Af2Cqq95n0m47WWCaqECdJGqN7ypqq-XAhq0v4ZW6_z-0g&oe=69F0CD58"}, {"file_name": "2560x1440 (4).png", "id": "443547678685303", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974547_443547682018636_6322347026334124666_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7FEei8YG_sEQ7kNvwEgcDLe&_nc_oc=AdqP2yo590PMl8jkYhFl1KLZPI7ohuEXuI0oGEMx68-WzRZDtOkvia_z2ynxrT2fI-s&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af0OGOd2c2W_mgzp0QWnR1TTGzcu3BKhXRF9bGbzICG_8Q&oe=69F0B834"}, {"file_name": "2560x1440 (5).png", "id": "878891567525558", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974867_878891570858891_8040644650588623139_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d3c1jQhvg2sQ7kNvwGtx8ci&_nc_oc=Adra4S463OCC_USczqMPExvvQvpf8Skn1E0PiWMsokJKEMqYhJGL3Ps1XB3SHPahKc8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af0kiD8UKv-_jc6pYvfEgqA0Fb4FFpZ45GbR1rot1L_9sw&oe=69F0CF41"}, {"file_name": "2560x1440 (6).png", "id": "522360993660696", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974782_522361000327362_1265686494838610386_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MS71GZPUF8YQ7kNvwEec_Qx&_nc_oc=AdrsxYCHOQVay8wJLD3DDnqIUOBfhpvBZfODcVjAZN-IOruhv3d4EiV_0aO_Hj9DR3w&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Af1tUwj9DWo5rwltnm8p8ieaI5x60CYp7CyE3Y1n39y1OA&oe=69F0D182"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440 (7).png", "id": "859600769565255", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/65228806_859600772898588_578693433817766136_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wuDzThgiJEYQ7kNvwFq8kDw&_nc_oc=Adpnn1SJJmJoeoh71_RmYzpu_9ukDp7WnnLJJqR6-IthbV2F1rWnbjF-X1MYPmZeq9o&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Af34W-eTxZKxnCbqIRy-Y6-24en0bG3b8smfaIm-1vASuA&oe=69F0AD1A"}, "display_name": "Feeling Fire Gun", "keywords": ["FeelingFireGun", "TTTcorporation"], "long_description": "\"Feeling Fire Gun\" is a groundbreaking VR application that seamlessly melds hyper-realistic firearm simulation with boundless creativity in a vast virtual playground. This immersive experience offers users the unique opportunity to wield meticulously crafted digital firearms that mirror their real-world counterparts in look, feel, and function, complete with authentic sounds and recoil.\n\nBut \"Feeling Fire Gun\" goes far beyond simple target practice. It empowers users to become architects of their virtual realms, allowing them to conjure, manipulate, and interact with a diverse array of objects. From crafting intricate structures to designing challenging obstacle courses, the only limit is the user's imagination.\n\nSet in an expansive, multi-terrain world, players can traverse their creations through various modes of locomotion, be it walking, teleporting, or even defying gravity. This freedom of movement complements the app's versatile gameplay modes, which include a sandbox-style free mode for uninhibited exploration and creation, a series of skill-testing challenges, and a dynamic multiplayer environment for shared experiences.", "short_description": "\"Feeling Fire Gun\" isn't just a game; it's a platform that bridges the gap between realistic simulation and creative expression."}]}, "developer_name": null, "developer_privacy_policy_url": "https://tttcorporation.xyz/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "TTTcorporation", "support_website_url": null, "website_url": "https://tttcorporation.xyz/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1990104051447093"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "7957890484330737"}}]}, "scheduled_offers": {"count": 0, "nodes": []}, "baseline_offer": null, "is_approved": true, "firstOffer": {"nodes": []}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "8056505367802581", "version": "0.4"}, "id": "1046600470143803", "channel_name": "LIVE"}]}, "is_for_oculus_keys_on
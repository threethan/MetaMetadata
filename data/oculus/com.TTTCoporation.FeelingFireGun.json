&oh=00_Afv9s33RN2-olBvNWkIfuFF3mTHE8GkASIVC_9pRV7aUfg&oe=699C680C"}, {"file_name": "1008x1440.png", "id": "473981512077033", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982518_473981515410366_5571885850947011923_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f2oX6f_GMrgQ7kNvwFGGj6V&_nc_oc=Adn1M4OlvfT-9DDGYBuSCln5hUmTJQdsegxiNEUVrI8oZ-xWHVqZnCiP8CCdVHk4k94&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AfsyqtlhWIV4gnpd0HHlc6dqBZsquhwi0HLh9YAMIE453A&oe=699C6298"}]}, "id": "861301175878314", "locale": "en_US", "screenshots": [{"file_name": "2560x1440 (1).png", "id": "1242580393405131", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974594_1242580396738464_7600342908274045866_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b8uZUt2B8tAQ7kNvwEmLrCn&_nc_oc=AdmyzEljXS0_ksCHbrkjHHt2ZfouCaFnHoj97rA3dkMuq_0GW4-BFGS5MFPaqaunfmg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_AfvXO6ArPxTvBvul1lsyIo-VLsAg2N_aVL-gOUfvAGOoBg&oe=699C3A7B"}, {"file_name": "2560x1440 (3).png", "id": "866033444949053", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974681_866033448282386_1060735077748256107_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x4dnOJGGilEQ7kNvwEYDpoK&_nc_oc=AdnQHyqoLM9u8lOvDsR3XtdftZSj8vpkx-OPW5woDY__eHD3dxt8_g8_ihVXvmHsEeo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AfuauRCXpKTtWYeTH7EhnIK-DC-PWW5zZdin_9L903L2JA&oe=699C3518"}, {"file_name": "2560x1440 (4).png", "id": "443547678685303", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974547_443547682018636_6322347026334124666_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l-oKeXOdyH0Q7kNvwEteJpE&_nc_oc=Adn4b2Fenv6416L7YYGljSU79wmIfOP9Kdl1bloH-VUdw8Sy0EJQme-aOocFivK0rDk&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AftvHJjwq8fYCc1Oy6oF63TgyJjoGYJGRJMMXZFh8dRxCg&oe=699C5834"}, {"file_name": "2560x1440 (5).png", "id": "878891567525558", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974867_878891570858891_8040644650588623139_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ipdS9ziS9u4Q7kNvwELl1gn&_nc_oc=Adn0UdDK8YI_TPdG8ZbIGHLkEq1X5YZwX0uwTR1p3cfaFNC95iBxiLPxjztlQC8vq90&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AftszJA16OaPfRqvHsb7AOErN41Y4Sx57TMQhi7NuSIv7g&oe=699C3701"}, {"file_name": "2560x1440 (6).png", "id": "522360993660696", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974782_522361000327362_1265686494838610386_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c6TVtVPJHIoQ7kNvwHYT0hk&_nc_oc=Adm29HMn9RqSG026Dt3WqYCnKN4R0upQ7jAi7BVkYU4waEY58whHHNt4uARzXdWgZ1g&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AfuZ_hhLTnrYCAiLJVXJLl-jbOmHacRWM3_g066qJCR0DQ&oe=699C3942"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440 (7).png", "id": "859600769565255", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/65228806_859600772898588_578693433817766136_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2ewogHAXdygQ7kNvwHOikT2&_nc_oc=Adlxr1mDVvi-hVPlXYKCWVLCsrPPyBsdpoAr7b6EbeD4noa_HVbx7zEoGtFOV18F3H0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AfulQBpHev56b1A7mt9BNSMoLD3ACXsaFe7X3DrPlC_MYw&oe=699C4D1A"}, "display_name": "Feeling Fire Gun", "keywords": ["FeelingFireGun", "TTTcorporation"], "long_description": "\"Feeling Fire Gun\" is a groundbreaking VR application that seamlessly melds hyper-realistic firearm simulation with boundless creativity in a vast virtual playground. This immersive experience offers users the unique opportunity to wield meticulously crafted digital firearms that mirror their real-world counterparts in look, feel, and function, complete with authentic sounds and recoil.\n\nBut \"Feeling Fire Gun\" goes far beyond simple target practice. It empowers users to become architects of their virtual realms, allowing them to conjure, manipulate, and interact with a diverse array of objects. From crafting intricate structures to designing challenging obstacle courses, the only limit is the user's imagination.\n\nSet in an expansive, multi-terrain world, players can traverse their creations through various modes of locomotion, be it walking, teleporting, or even defying gravity. This freedom of movement complements the app's versatile gameplay modes, which include a sandbox-style free mode for uninhibited exploration and creation, a series of skill-testing challenges, and a dynamic multiplayer environment for shared experiences.", "short_description": "\"Feeling Fire Gun\" isn't just a game; it's a platform that bridges the gap between realistic simulation and creative expression."}]}, "developer_name": null, "developer_privacy_policy_url": "https://tttcorporation.xyz/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "TTTcorporation", "support_website_url": null, "website_url": "https://tttcorporation.xyz/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1990104051447093"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "7957890484330737"}}]}, "scheduled_offers": {"count": 0, "nodes": []}, "baseline_offer": null, "is_approved": true, "firstOffer": {"nodes": []}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "8056505367802581", "version": "0.4"}, "id": "1046600470143803", "channel_name": "LIVE"}]}, "is_for_oculus_keys_on
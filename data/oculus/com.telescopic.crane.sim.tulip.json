6qYU1M3k4KJemNCCdRV2_oQ42eUPXB6zbg&oe=6A1DA7E9"}, {"file_name": "7.png", "id": "561830273441123", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982555_561830276774456_469955335624093920_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EdeleOcqaBIQ7kNvwHStpPt&_nc_oc=Adrrk3hx9ynM4VhGCjrUgJb6DPW8MlxhFT9RH0_0Wv73-4J5lJI0xCoL_8mblKtKdKs&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af43iGK-EW106TOV_yfvl-YvmrCEogndXLpkesnzDasf1Q&oe=6A1D8889"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Telescopic Crane Sim - Construction Game", "keywords": ["ConstructionGame", "CraneSimulator", "CraneGame", "TelescopicCrane", "Construction"], "long_description": "The VR Telescopic Crane Simulator offers an immersive experience for aspiring operators and enthusiasts alike. Navigate diverse environments, including construction sites, sea ports, and challenging terrains, while mastering telescopic crane operations. This simulator emphasizes realism with detailed controls, dynamic weather effects, and lifelike physics, providing both entertainment and educational value. Develop critical skills in lifting, balancing, and maneuvering heavy loads with precision. Perfect for training, education, or simply enjoying the thrill of operating a powerful crane, this VR experience combines fun and functionality for all users.", "short_description": "Experience the precision and power of heavy machinery with the VR Telescopic Crane Simulator. Master complex crane operations across various real-world environments like construction sites and ports, ensuring safety and accuracy in every lift."}]}, "developer_name": null, "developer_privacy_policy_url": "https://tulipapps.com/meta-quest-privacy.html", "developer_terms_of_service_url": null, "publisher_name": "TulipApps", "support_website_url": null, "website_url": "https://www.tulipapps.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {
video_trailer_thumbnail": null, "display_name": "Telescopic Crane Sim - Construction Game", "keywords": ["ConstructionGame", "CraneSimulator", "CraneGame", "TelescopicCrane", "Construction"], "long_description": "The VR Telescopic Crane Simulator offers an immersive experience for aspiring operators and enthusiasts alike. Navigate diverse environments, including construction sites, sea ports, and challenging terrains, while mastering telescopic crane operations. This simulator emphasizes realism with detailed controls, dynamic weather effects, and lifelike physics, providing both entertainment and educational value. Develop critical skills in lifting, balancing, and maneuvering heavy loads with precision. Perfect for training, education, or simply enjoying the thrill of operating a powerful crane, this VR experience combines fun and functionality for all users.", "short_description": "Experience the precision and power of heavy machinery with the VR Telescopic Crane Simulator. Master complex crane operations across various real-world environments like construction sites and ports, ensuring safety and accuracy in every lift."}]}, "developer_name": null, "developer_privacy_policy_url": "https://tulipapps.com/meta-quest-privacy.html", "developer_terms_of_service_url": null, "publisher_name": "TulipApps", "support_website_url": null, "website_url": "https://www.tulipapps.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "1043107547362485"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player
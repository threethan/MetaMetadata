-25/38974841_422789949030294_3940831948353784904_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eoGyguvGK8sQ7kNvwHewE8X&_nc_oc=AdrEx05dqYTuMxGdABsZym2GnMy4YyKQpUfsYm_38tuk3CjemuCgONTlk3IMZzPB-oU&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8dp6h0C7SWH_ByXMBYSpfcN6hML-eOxQ9kR8Eo4ReXGA&oe=6A4664B7"}, {"file_name": "2.png", "id": "146163027328423", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/38974864_146163030661756_6147462314113852275_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ATtf-yKoUSIQ7kNvwFeu_3e&_nc_oc=AdqNoH45lti_a8_P-FDPCCuWKs7AYJQUuNiE78smcJftaxAecYtyVuIbLzAh7apm40w&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_cjcKtRTDtkUhsnkl-39LCWzG10-lKpV04yyuLwurBQA&oe=6A467EE0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "1.png", "id": "941319500010102", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/39001691_941319503343435_2136109628830733637_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XooXofJWgI0Q7kNvwEXjTd9&_nc_oc=AdrYfMQcPGwCmljY0IkYwJxtzzLRxiFgRBY7QGzo0o9NGOHshUUyMw3DUujXlyUniJo&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_k3NXkeN693Bz7XgxFvuAoeVXAyRvL7jLrYwg2WkXAmQ&oe=6A468A38"}, "display_name": "SweeperVR", "keywords": [], "long_description": "Minesweeper has finally come to Virtual Reality! Flag, count, and open cells in this fully 3D reinvention of the classic game.\n\nFeatures:\n- View the entire minefield in cube view, or highlight an individual plane\n- Fully customizable minefield spawning parameters, with difficulty presets\n- Drag, drop, scale, and rotate the minefield to locate mines from any angle\n- Standard Minesweeper game mechanics and timer\n\nProfessional mine-defusers and newbies alike will be able to enjoy the challenges and gameplay of SweeperVR!", "short_description": "Minesweeper has finally come to Virtual Reality! Flag, count, and open cells in this fully 3D, yet familiar, reinvention of the classic game. Profe
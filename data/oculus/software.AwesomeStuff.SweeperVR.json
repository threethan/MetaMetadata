_422789949030294_3940831948353784904_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2HEXjhST8egQ7kNvwHpaG95&_nc_oc=AdrJaJj7HUD_K3fE9CvNwhuUeiJ_npZkHxiePfjgR45fcil3SN4I4LzPeIgNj4mGGQw&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIBoM0eXZajun2Fz_Jhcs1pGMqNGXUFXvaOZAgNVyCaNA&oe=6AA15C37"}, {"file_name": "2.png", "id": "146163027328423", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38974864_146163030661756_6147462314113852275_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YX1u8-noHsAQ7kNvwFLM8FE&_nc_oc=AdpxzLJ1pWxPb-TkBFS2loaHCRPJbgWMC9W3Y7HGB9nfCp6gDImhtlsd-fg5ERD06XQ&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKh43LB2hrjhxhOof7ExGgv5ZCU_SYtjMtcJwUndS9BIw&oe=6AA17660"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "1.png", "id": "941319500010102", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/39001691_941319503343435_2136109628830733637_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AXVXWb2vw10Q7kNvwF32ePx&_nc_oc=AdqQvOXt0OD2gUKVgXQBPDykEF_XZlcb8Ri8Fuohf4SuoTyYYCuXoCFd29b6l-fTfgU&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIzojCvRckHcQFy8vifCti4nyX3YqI3oACsAemLAXoQ3g&oe=6AA14978"}, "display_name": "SweeperVR", "keywords": [], "long_description": "Minesweeper has finally come to Virtual Reality! Flag, count, and open cells in this fully 3D reinvention of the classic game.\n\nFeatures:\n- View the entire minefield in cube view, or highlight an individual plane\n- Fully customizable minefield spawning parameters, with difficulty presets\n- Drag, drop, scale, and rotate the minefield to locate mines from any angle\n- Standard Minesweeper game mechanics and timer\n\nProfessional mine-defusers and newbies alike will be able to enjoy the challenges and gameplay of SweeperVR!", "short_description": "Minesweeper has finally come to Virtual Reality! Flag, count, and open cells in this fully 3D, yet familiar, reinvention of the classic game. Professional mine-defusers and newbies alike will be able to enjoy the challenges and gameplay of SweeperVR."}]}, "developer_name": null, "developer_privacy_policy_url": "http://awesomestuff.software/privacy-policy/SweeperVR.html", "developer_terms_of_service_url": null, "publisher_name": "Awesome Stuff Software", "support_website_url": "http://awesomestuff.software/contact", "website_url": "http://www.awesomestuff.software/games/sweepervr/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "ARCADE", "PUZZLE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8509888879032713"}}]}, "scheduled_offers": {"count": 0, "nodes": []}, "baseline_offer": null, "is_approved": true, "firstOffer": {"nodes": []}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "3776786852428612", "version": "1.2.0"}, "id": "471351527362495", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "3703048619802436", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "3776786852428612"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "471351527362495"}]}, "change_log": null, "created_date": 1615689848, "id": "37767868524286
.com/v/t64.5771-25/38974841_422789949030294_3940831948353784904_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YzXKAPI-K5wQ7kNvwFEvdyf&_nc_oc=AdoZFtZe7QxuRP2b77PZirqsKkDyBHwa6-un_QCC2Xn2BNCNyQtmlGCREh1hSogvk-8&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEnYf5kwDvG64zt7tn-UKmIXg7oTxSiOoG_MeFbaXlBcQ&oe=6A85ACB7"}, {"file_name": "2.png", "id": "146163027328423", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/38974864_146163030661756_6147462314113852275_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i8mmR2dtygsQ7kNvwFBn3gf&_nc_oc=AdrfS3GBk7kVs_jvxJuWiVwWfCDanu8U0m_ay9M2EnJRXYNtaNbDb0ojzCu2gbWLjss&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGQoPQ2ON3cvbuztnI3K15VFXTeYLtO7sY2gBN4yTlBGA&oe=6A858EA0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "1.png", "id": "941319500010102", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/39001691_941319503343435_2136109628830733637_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jf5GulL07JgQ7kNvwHQ6P6z&_nc_oc=Adr_VuvelF5XBOFBE02Wj3QhIt-nS9eeAn35BvO1rDOAPXsiXm0ZMYtZYiO7I8hv8po&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG-13w6ENysU7Bs2mwV2nCpSvSezFxD9GTVwrYL78jAxQ&oe=6A8599F8"}, "display_name": "SweeperVR", "keywords": [], "long_description": "Minesweeper has finally come to Virtual Reality! Flag, count, and open cells in this fully 3D reinvention of the classic game.\n\nFeatures:\n- View the entire minefield in cube view, or highlight an individual plane\n- Fully customizable minefield spawning parameters, with difficulty presets\n- Drag, drop, scale, and rotate the minefield to locate mines from any angle\n- Standard Minesweeper game mechanics and timer\n\nProfessional mine-defusers and newbies alike will be able to enjoy the challenges and gameplay of SweeperVR!", "short_description": "Minesweeper has finally come to Virtual Reality! Flag, count, and open cells in this fully 3D, yet familiar, reinvention of the c
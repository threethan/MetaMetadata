f\u3001VR\u306e\u89b3\u5bdf\u30ae\u30e3\u30e9\u30ea\u30fc\u3092\u821e\u53f0\u306b\u3057\u305f\u4e00\u4eba\u7528\u306e\u30df\u30cb\u30b2\u30fc\u30e0\u96c6\u3067\u3059\u3002\u30ae\u30e3\u30e9\u30ea\u30fc\u3092\u898b\u6e21\u3057\u3001\u6c17\u3065\u3044\u305f\u6a21\u69d8\u3084\u76ee\u5370\u3092\u30b3\u30f3\u30c8\u30ed\u30fc\u30e9\u30fc\u3067\u9078\u3073\u307e\u3059\u3002\n\n- **\u65b9\u5411\u3048\u3089\u3073\u30fb\u6a21\u69d8\u63a2\u3057** \u2014 \u30ac\u30dc\u30fc\u30eb\u30d1\u30c3\u30c1\u3068\u547c\u3070\u308c\u308b\u3001\u660e\u6697\u304c\u306a\u3081\u3089\u304b\u306b\u5909\u308f\u308b\u7e1e\u6a21\u69d8\u3092\u4f7f\u3044\u307e\u3059\u3002\u7e1e\u306e\u5411\u304d\u3092\u7b54\u3048\u305f\u308a\u3001\u4f3c\u305f\u6a21\u69d8\u306e\u4e2d\u304b\u3089\u898b\u672c\u3068\u540c\u3058\u3082\u306e\u3092\u63a2\u3057\u305f\u308a\u3057\u307e\u3059\u3002\n- **\u3086\u3063\u304f\u308a\u8ffd\u3046\u30fb\u8907\u6570\u306e\u76ee\u5370\u3092\u8ffd\u3046** \u2014 \u52d5\u304f\u6a21\u69d8\u306b\u76ee\u3092\u5411\u3051\u3066\u3001\u7e1e\u306e\u5411\u304d\u304c\u5909\u308f\u3063\u305f\u3089\u7b54\u3048\u307e\u3059\u3002\u8907\u6570\u306e\u76ee\u5370\u304c\u52d5\u304f\u7a2e\u76ee\u3067\u306f\u3001\u6700\u521d\u306b\u7dd1\u8272\u3060\u3063\u305f\u76ee\u5370\u3092\u899a\u3048\u3001\u52d5\u304d\u304c\u6b62\u307e\u3063\u305f\u3089\u9078\u3073\u307e\u3059\u3002\n- **\u5468\u8fba\u30bf\u30fc\u30b2\u30c3\u30c8\u63a2\u3057\u30fb\u76ee\u5370\u30ea\u30ec\u30fc** \u2014 \u8996\u7dda\u3092\u79fb\u3057\u306a\u304c\u3089\u3001\u30ae\u30e3\u30e9\u30ea\u30fc\u306e\u3042\u3061\u3053\u3061\u306b\u73fe\u308c\u308b\u6570\u5b57\u3084\u5f62\u3092\u63a2\u3057\u307e\u3059\u3002\n- **\u5965\u884c\u304d\u5f53\u3066** \u2014 \u7a7a\u9593\u306b\u6d6e\u304b\u3076\u8f2a\u306e\u4e2d\u304b\u3089\u3001\u3044\u3061\u3070\u3093\u624b\u524d\u3092\u9078\u3073\u307e\u3059\u3002\u9060\u8fd1\u30ea\u30ec\u30fc\u3067\u306f\u3001\u3044\u3061\u3070\u3093\u5965\u3068\u624b\u524d\u306e\u8f2a\u3092\u4ea4\u4e92\u306b\u9078\u3073\u307e\u3059\u3002\n\n\u96e3\u6613\u5ea6\u3084\u8868\u793a\u30b5\u30a4\u30ba\u3092\u9078\u3073\u3001\u6b63\u7b54\u7387\u30fb\u56de\u7b54\u6642\u9593\u30fb\u5f97\u70b9\u3092\u30d7\u30ec\u30a4\u8a18\u9332\u3067\u898b\u8fd4\u305b\u307e\u3059\u3002\u3072\u3068\u606f\u3064\u304d\u305f\u3044\u3068\u304d\u306f\u3001\u4f11\u61a9\u30fb\u307e\u3070\u305f\u304d\u30ac\u30a4\u30c9\u3084\u3001\u30af\u30a4\u30ba\u306a\u3057\u3067\u3086\u3063\u304f\u308a\u52d5\u304f\u76ee\u5370\u3092\u8ffd\u3046\u30e2\u30fc\u30c9\u3092\u4f7f\u3048\u307e\u3059\u3002\u65e5\u672c\u8a9e\u3068\u82f1\u8a9e\u306b\u5bfe\u5fdc\u3057\u3066\u3044\u307e\u3059\u3002", "short_description": "\u30ac\u30dc\u30fc\u30eb\u30d1\u30c3\u30c1\u3092\u4f7f\u3063\u305f\u3001Meta Quest\u306e\u76ee\u306e\u30c8\u30ec\u30fc\u30cb\u30f3\u30b0\u30b2\u30fc\u30e0\u3002\u307c\u3093\u3084\u308a\u3057\u305f\u7e1e\u6a21\u69d8\u306e\u5411\u304d\u3092\u5f53\u3066\u3001\u52d5\u304f\u76ee\u5370\u3092\u76ee\u3067\u8ffd\u3044\u3001\u5965\u884c\u304d\u306e\u9055\u3044\u3092\u898b\u6bd4\u3079\u307e\u3059\u3002"}, {"images": {"nodes": [{"file_name": "PatternLab-Cover-Portrait-EN-1008x1440.png", "id": "3084693511868397", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499623551_3084693515201730_9011299455214829795_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hAQlQIOuvIMQ7kNvwELzWeX&_nc_oc=AdrJPs_IA5VZOQ8Lu7jhOyFRyhdkZ0qe451PIoUE7jU5sKLPD9tzXYpnYG1-yLiDQq4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSh7YvjnQ0ZGT3Pqgr3U8pHbWviQh0hcVAzS6qI_8TgcA&oe=6B0DD1A1"}, {"file_name": "Hero-Cover-3000x900.png", "id": "2347465992685486", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499627477_2347465996018819_1489699312825112915_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZPznIJ1q0eQQ7kNvwHDE59q&_nc_oc=AdpykhZinkZRoRRkgF-zgLVLLPrjeMOwe0vnbxumXOdFH3BhF5R6vauYB5AFOHOmMz8&_nc_zt=3&_nc_ht=scontent-o
ohc=Y6caVgNsZ0gQ7kNvwFfmX0d&_nc_oc=AdoqB_Sofo9Dbf3CKJR5_fQFkQfGmPPNOTXdVhzi26dpFD0V-GgiPfEUQx4KbczkOBw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQW8MGv-g3NGfqz6vSq9AXUTsbby4uqivWdYNHc5Mu2CZg&oe=6B0F0B9E"}, {"file_name": "05-Near-Far-Relay-2560x1440.png", "id": "2922746031438745", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/593877129_2922746034772078_1290643895182926008_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OkNoYjBWxaMQ7kNvwHjFcgU&_nc_oc=AdoZAORcs2DMKx55rCLPFooD-diMIoqnh8lKJUb0GBeQLAIL1-Nh4WAfvZkb4TCXU_Q&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXxKGbT81Exx5rfKaJfhe923M-ipyJ4_QhDSTsfm2PE1w&oe=6B0F0296"}, {"file_name": "02-Pattern-Matching-2560x1440.png", "id": "1778705140076584", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499620316_1778705203409911_5477082779560868980_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qxUsc7M9kyUQ7kNvwGZ_VDw&_nc_oc=AdplOQW96Qu0Geov5MvA9cs1po17RPs4CIejtLFxoJfJgZsaywgaxWMlulrDytFVJHI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVdvj5gVCXut2EeCCGHGV-o3r2bgNvu0hn6R4OSNQAxKA&oe=6B0F08E9"}, {"file_name": "03-Peripheral-Target-Search-2560x1440.png", "id": "1095575026649998", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499624583_1095575029983331_507274484602051840_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zohbbSaT1aMQ7kNvwGJEfKV&_nc_oc=AdoTdxlQc64cC9BO6lZZmHxF66zlHhvNiSiICk0Qdt2k8dmG_5mJDLcevkn2Vl1FvSY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXhPB4l1M7W3hnVCFxCpA3VX9zjPOzf4tgc_XbB5uwFwg&oe=6B0F22D5"}, {"file_name": "01-Observation-Gallery-2560x1440.png", "id": "1619101676656404", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499627477_1619101679989737_8115229760662615328_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oQe4ouH7iRwQ7kNvwFo7BXI&_nc_oc=AdpwqEuA0E7gUI941PwMpkKZ-G_hh5DcGsnZmt3Cx1QbofwItvYR_61ha9Ibu01DWs4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVt7zEWro17BftQt2GiFL4QHJmkL-MYqOl_r9u9u0AfCw&oe=6B0F00BB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer-Cover-2560x1440.png", "id": "1113734238236637", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499627502_1113734241569970_8585398850464757189_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8OiuX3VoGEYQ7kNvwHK7DHS&_nc_oc=Adq9nEizCSL_RjabFDmhHldvJxTlREVaEP-Fq45SlntktodnGnSVewx4RwOR7UFa3zc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQV6TADzS_GpaGs4ro1kQnM5lgFkae1oQ5ivhOp_60X4Og&oe=6B0F1096"}, "display_name": "Pattern Lab", "keywords": ["eyetraining", "gaborpatch", "visualtraining", "pattern", "puzzle"], "long_description": "One pattern matches the sample. Several markers are on the move. Can you tell which is which? Pattern Lab is a collection of single-player VR mini-games set in the Observation Gallery. Look around the room, then point and select with your controller.\n\n- **Pattern direction and pattern matching** \u2014 Work with Gabor patches, softly shaded stripe patterns. Identify which way the stripes run or find the pattern that matches the sample.\n- **Slow follow and track multiple markers** \u2014 Follow a moving pattern and spot when its stripes change direction, or remember which markers started green and select them after they stop.\n- **Peripheral target search and marker relay** \u2014 Shift your attention around the gallery to find numbers, symbols, and shapes.\n- **Depth guessing** \u2014 Pick the closest floating ring. In Near-Far Relay, alternate between the farthest and closest rings.\n\nChoose your difficulty and display size, then review your accuracy, response times, and scores in Play History. When you want to pause, open the Rest & Blink guide or try following a slowly moving marker without a quiz. Available in English and Japanese.", "short_description": "Train your eyes with Gabor patches in Pattern Lab, a VR game for Meta Quest. Spot the direction of soft-edged stripes, follow moving targets, and compare depth in a series of visual challenges."}]}, "developer_name": "Nii Games", "developer_privacy_policy_url": "https://nii-games-privacy.nysk07.chatgpt.site/pattern-lab-privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Nii Games", "support_website_url": null, "website_url": "https://nii-games-privacy.nysk07.chatgpt.site/pattern-lab", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ja"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1404546882751242"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499627379_1925494408613588_2046766869413274993_n.png?stp=dst-png_s360x360&_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=11SyAbjOFrkQ7kNvwHa2air&_nc_oc=Adr1VNGRdevMiM4iR8QxEzdCiTeGAu9R6Ozb-6EGVAijx9OzTySW7kyeTAILaOvntEw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVD8ss59HC4Pz_B9z8wLQ67FUYg9ziO3SQ74SgC2983hg&oe=6B0F22D4"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Pattern Lab", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Puzzle", "id": "377978390272490"}], "release_date": 1794403620, "lastRevision": {"nodes": [{"id": "1396351440237453", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "1396351423570788", "is_first_party": false, "enables_in_app_ads": false, "is_concept": false, "platform": "ANDROID_6DOF"}, "iarc_cert": {"id": "4417372508501961"}, "iarc_email": null, "msrp": null, "translations": {"nodes": [{"images": {"nodes": []}, "id": "3682378575246315", "locale": "ja_JP", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "\u30d1\u30bf\u30fc\u30f3\u30e9\u30dc", "keywords": ["\u89b3\u5bdf\u529b", "\u6a21\u69d8\u63a2\u3057", "\u30ac\u30dc\u30fc\u30eb\u30d1\u30c3\u30c1", "VR\u30d1\u30ba\u30eb", "\u5965\u884c\u304d"], "long_description": "\u4f3c\u305f\u6a21\u69d8\u306e\u4e2d\u306b\u3001\u898b\u672c\u3068\u540c\u3058\u3082\u306e\u304c\u3072\u3068\u3064\u3002\u52d5\u304f\u76ee\u5370\u304c\u6b62\u307e\u3063\u305f\u3068\u304d\u3001\u6700\u521d\u306b\u5149\u3063\u3066\u3044\u305f\u306e\u306f\u3069\u308c\uff1f \u30d1\u30bf\u30fc\u30f3\u30e9\u30dc\u306f\u3001VR\u306e\u89b3\u5bdf\u30ae\u30e3\u30e9\u30ea\u30fc\u3092\u821e\u53f0\u306b\u3057\u305f\u4e00\u4eba\u7528\u306e\u30df\u30cb\u30b2\u30fc\u30e0\u96c6\u3067\u3059\u3002\u30ae\u30e3\u30e9\u30ea\u30fc\u3092\u898b\u6e21\u3057\u3001\u6c17\u3065\u3044\u305f\u6a21\u69d8\u3084\u76ee\u5370\u3092\u30b3\u30f3\u30c8\u30ed\u30fc\u30e9\u30fc\u3067\u9078\u3073\u307e\u3059\u3002\n\n- **\u65b9\u5411\u3048\u3089\u3073\u30fb\u6a21\u69d8\u63a2\u3057** \u2014 \u30ac\u30dc\u30fc\u30eb\u30d1\u30c3\u30c1\u3068\u547c\u3070\u308c\u308b\u3001\u660e\u6697\u304c\u306a\u3081\u3089\u304b\u306b\u5909\u308f\u308b\u7e1e\u6a21\u69d8\u3092\u4f7f\u3044\u307e\u3059\u3002\u7e1e\u306e\u5411\u304d\u3092\u7b54\u3048\u305f\u308a\u3001\u4f3c\u305f\u6a21\u69d8\u306e\u4e2d\u304b\u3089\u898b\u672c\u3068\u540c\u3058\u3082\u306e\u3092\u63a2\u3057\u305f\u308a\u3057\u307e\u3059\u3002\n- **\u3086\u3063\u304f\u308a\u8ffd\u3046\u30fb\u8907\u6570\u306e\u76ee\u5370\u3092\u8ffd\u3046** \u2014 \u52d5\u304f\u6a21\u69d8\u306b\u76ee\u3092\u5411\u3051\u3066\u3001\u7e1e\u306e\u5411\u304d\u304c\u5909\u308f\u3063\u305f\u3089\u7b54\u3048\u307e\u3059\u3002\u8907\u6570\u306e\u76ee\u5370\u304c\u52d5\u304f\u7a2e\u76ee\u3067\u306f\u3001\u6700\u521d\u306b\u7dd1\u8272\u3060\u3063\u305f\u76ee\u5370\u3092\u899a\u3048\u3001\u52d5\u304d\u304c\u6b62\u307e\u3063\u305f\u3089\u9078\u3073\u307e\u3059\u3002\n- **\u5468\u8fba\u30bf\u30fc\u30b2\u30c3\u30c8\u63a2\u3057\u30fb\u76ee\u5370\u30ea\u30ec\u30fc** \u2014 \u8996\u7dda\u3092\u79fb\u3057\u306a\u304c\u3089\u3001\u30ae\u30e3\u30e9\u30ea\u30fc\u306e\u3042\u3061\u3053\u3061\u306b\u73fe\u308c\u308b\u6570\u5b57\u3084\u5f62\u3092\u63a2\u3057\u307e\u3059\u3002\n- **\u5965\u884c\u304d\u5f53\u3066** \u2014 \u7a7a\u9593\u306b\u6d6e\u304b\u3076\u8f2a\u306e\u4e2d\u304b\u3089\u3001\u3044\u3061\u3070\u3093\u624b\u524d\u3092\u9078\u3073\u307e\u3059\u3002\u9060\u8fd1\u30ea\u30ec\u30fc\u3067\u306f\u3001\u3044\u3061\u3070\u3093\u5965\u3068\u624b\u524d\u306e\u8f2a\u3092\u4ea4\u4e92\u306b\u9078\u3073\u307e\u3059\u3002\n\n\u96e3\u6613\u5ea6\u3084\u8868\u793a\u30b5\u30a4\u30ba\u3092\u9078\u3073\u3001\u6b63\u7b54\u7387\u30fb\u56de\u7b54\u6642\u9593\u30fb\u5f97\u70b9\u3092\u30d7\u30ec\u30a4\u8a18\u9332\u3067\u898b\u8fd4\u305b\u307e\u3059\u3002\u3072\u3068\u606f\u3064\u304d\u305f\u3044\u3068\u304d\u306f\u3001\u4f11\u61a9\u30fb\u307e\u3070\u305f\u304d\u30ac\u30a4\u30c9\u3084\u3001\u30af\u30a4\u30ba\u306a\u3057\u3067\u3086\u3063\u304f\u308a\u52d5\u304f\u76ee\u5370\u3092\u8ffd\u3046\u30e2\u30fc\u30c9\u3092\u4f7f\u3048\u307e\u3059\u3002\u65e5\u672c\u8a9e\u3068\u82f1\u8a9e\u306b\u5bfe\u5fdc\u3057\u3066\u3044\u307e\u3059\u3002", "short_description": "\u898b\u308b\u529b\u306b\u6311\u3080\u30017\u3064\u306eVR\u30df\u30cb\u30b2\u30fc\u30e0\u3002\u30ac\u30dc\u30fc\u30eb\u30d1\u30c3\u30c1\u306e\u7e1e\u306e\u5411\u304d\u3092\u898b\u5206\u3051\u3001\u52d5\u304f\u76ee\u5370\u3092\u8ffd\u3044\u3001\u62
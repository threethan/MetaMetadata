Py89&_nc_oc=AdpAv4zRx3sPwc6Wp_MTJlESp6vnf7alwAeqLWtKKdv4mgGvt4wRHGfYPxldCJYnHto&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3dFRASG8CmqLNktzEbHfDcknJJguYsEHwXS7b7sH-cRA&oe=69D639BE"}, {"file_name": "screenshot-0.png", "id": "711374158163846", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491819934_711374161497179_5219986979726633511_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8GJJV5uPDMYQ7kNvwHfJoxv&_nc_oc=AdqLWhQ7q7WH3rZ3bs786TaiA1UaNRc8tkuFnwWv_Retgs66i8d3wdplnAIh5yiabTo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2F8fgYzZt0DBL5jr6mepWjXlW1KfIrGS1ZHvKi-E8B3A&oe=69D6504D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover-video.png", "id": "740381481685081", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499623569_740381485018414_2207102974461887046_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6nbWWbVlpQAQ7kNvwFGsw4n&_nc_oc=AdrzZ2vShdjELgKfglGI9VqEQI8cgjKQZT5Z_sR3IqLTf3zP2ieevX9NE6WSuNXIDxo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0FDZ5KexgeUNi0oAUOkGPxQ_q8sfzheMzoshInkSXBlA&oe=69D644F9"}, "display_name": "2bfit", "keywords": ["fit", "exercise", "fun", "stretch"], "long_description": "This is an easy way to exercise, especially the upper body.  You can focus longer and enjoy moving around when you can see balls to interact with.\nAfter a minute (or 60 seconds) you can feel my shoulders and arms a little bit.  And if you keep you feet in place (don't rotate), you can stretch more.  If you go through a wall, the 2bfit area moves along with you.  This makes it easy to stay in a clear area. Enjoy the burn.", "short_description": "To be fit, or not to be fit. That is the question. \nMove around and score points by catching balls that drop and rotate.\nOther balls just hang around. Try not moving your feet.  Don't forget the\nballs behind you.  See your surroundings while you get fit.  Move thru a wall to move your 2bfit area."}]}, "developer
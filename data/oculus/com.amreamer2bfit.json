vTnj69fqx55ASyRasZ4SjXZR0K4cGcabmeXRJcaGepa10Kq2IX5ZAo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfsidIrsPJ0GhxXF8nDVYLbDyPEiY0uLv5lQXCc1XNEhCQ&oe=69A987F8"}, {"file_name": "2bfit-update1.png", "id": "1273832591007574", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491827725_1273832594340907_7679835096266954535_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fbDL3myf1aQQ7kNvwHrtL4i&_nc_oc=AdlD5hJZJGDCqXX7wph_pf9M1s1FkoRkjkGT0ReT6jhFOsjRGhYBdh9MqVLlYa-IsOY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfuV2UsYNHL3Cq8oxPN5kaQRL0GXLnuA8K9IFuSBuIUpJw&oe=69A97E8B"}, {"file_name": "2bfit-update3.png", "id": "4127365670925682", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499307311_4127365674259015_7679022573858290498_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HIkJaBhoUdwQ7kNvwEqoPXs&_nc_oc=AdnoGbKmzGqF0sfewUbmCqCcyMdLV064cDiZV0C0LcQDAtkHhMjUAX0tiQkQhdRup0o&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AftWSZ7hAGHLw9XYVtODd-2PkQOJr6kcBIOpil5wOCiRfQ&oe=69A97ADB"}, {"file_name": "2bfit-update4.png", "id": "4236623229995296", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491827718_4236623233328629_551381304740174737_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sTMBZzTEhnoQ7kNvwHRFfEV&_nc_oc=Adla2g8P-kgvgx6Ux9cjlUA-vSLfMy6FOLZObKm8_smYAq_MBwVTIpS785ylVQjW_24&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_Afv-xBPEqphDLWit7nItMuMhf8pvrEq6RXt1NJsehQLqKA&oe=69A980FF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover-video.png", "id": "740381481685081", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499623569_740381485018414_2207102974461887046_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DENbTKOPfw0Q7kNvwH8bw8q&_nc_oc=AdkIHX1EGvQI67QJc-bBxsP8cqodvMuLhGMyVk1vFAKUDvw79Dq62gzuzQoOgSr1Rh0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_Aft9_1o5y1xkLcmALuRYwReavYRMzUK-CNpDSOocIfMMzw&oe=69A971F9"}, "display_name": "2bfit", "keywords": ["fit", "exercise", "fun", "stretch"], "long_description": "This is an easy way to exercise, especially the upper body.  You can focus longer and enjoy moving around when you can see balls to interact with.\nAfter a minute (or 60 seconds) you can feel my shoulders and arms a little bit.  And if you keep you feet in place (don't rotate), you can stretch more.  If you go through a wall, the 2bfit area moves along with you.  This makes it easy to stay in a clear area. Enjoy the burn.", "short_description": "To be fit, or not to be fit. That is the question. \nMove around and score points by catching balls that drop and rotate.\nOther balls just hang around. Try not moving your feet.  Don't forget the\nballs behind you.  See your surroundings while you get fit.  Move thru a wall to move your 2bfit area."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1lWHEKMjXnD5KMPReMX33Brbi3goEyEwAAFv75cz--QU/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "amre-amer.com", "support_website_url": null, "website_url": "https://amre-amer.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25023755790560223"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491821954_2335969400139423_7260507335481471188_n.png?stp=dst-png_s360x360&_nc_cat=10
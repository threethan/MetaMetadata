7kNvwEnE8uF&_nc_oc=AdqUqpAJHnymABAR54fySMBkrkhh8Sqm4YnVXMNUmVuCRBd2BZ9o0C2hjdnUsM-CZ8A&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTXRzMPOOvmisaSZaqCJw1w2Thje1sHwbljorpiNE5pPA&oe=6AEDD8F8"}, {"file_name": "2bfit-update1.png", "id": "1273832591007574", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491827725_1273832594340907_7679835096266954535_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TNC9CIx2SZMQ7kNvwHj4DGc&_nc_oc=AdrPvO3_ASdlfngciq1d84rpPyTNNQ0kXrMBpP3lyWOtf14_uGQ9XoWdBLMt83qCcU8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ3oqdmSBVH6YAnQ4U2nkgNviUpBNJv_uQrRS-fhlJeeg&oe=6AEE07CB"}, {"file_name": "2bfit-update3.png", "id": "4127365670925682", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499307311_4127365674259015_7679022573858290498_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qLiF87c3ARYQ7kNvwGiwvC_&_nc_oc=AdoIr0vNz_Eo81FpTfw-1dH5caWs7jVcptTvS-xHprrJpLuvgGjf0nGWmw4EOBGN0ko&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS4qxNXwYEJuvXbEIpaQpOMQh1MuvzQ66-WyMmzFPlIrw&oe=6AEE041B"}, {"file_name": "2bfit-update4.png", "id": "4236623229995296", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491827718_4236623233328629_551381304740174737_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r_th7pR5NRkQ7kNvwH9PXUr&_nc_oc=AdpT0uR6AKGbHTMQSb4wBwXieMB9VzCKUzJuP7oZkH9u2d0EnwlEJbmH7mYxXy_YhY4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRrpx8euqAwB4N7H2ygzO53yx8_I-CyVvTeW9ijgzfQlg&oe=6AEE0A3F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover-video.png", "id": "740381481685081", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499623569_740381485018414_2207102974461887046_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ViK-nm_O0LYQ7kNvwEwLr-E&_nc_oc=AdoD2qdvSthHyV6nXnXHWCKbQlYkRS8Q0DSrnk-5P4YHRGw93agEqDUTwErDoi5v8wI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTXloOUcpSlJ9-YLWZrdS26XNBejuOKuVKpKi-yuSa99g&oe=6AEDFB39"}, "display_name": "2bfit", "keywords": ["fit", "exercise", "fun", "stretch"], "long_description": "This is an easy way to exercise, especially the upper body.  You can focus longer and enjoy moving around when you can see balls to interact with.\nAfter a minute (or 60 seconds) you can feel my shoulders and arms a little bit.  And if you keep you feet in place (don't rotate), you can stretch more.  If you go through a wall, the 2bfit area moves along with you.  This makes it easy to stay in a clear area. Enjoy the burn.", "short_description": "To be fit, or not to be fit. That is the question. \nMove around and score points by catching balls that drop and rotate.\nOther balls just hang around. Try not moving your feet.  Don't forget the\nballs behind you.  See your surroundings while you get fit.  Move thru a wall to move your 2bfit area."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1lWHEKMjXnD5KMPReMX33Brbi3goEyEwAAFv75cz--QU/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "amre-amer.com", "support_website_url": null, "website_url": "https://amre-amer.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25023755790560223"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491821954_2335969400139423_72605
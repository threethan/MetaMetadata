scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_Afyo3VA_ub0aZwAW6T6M0_OV8BMsk0Q0EO7cbvadQkeOYg&oe=69B7E73E"}, {"file_name": "screenshot-0.png", "id": "711374158163846", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491819934_711374161497179_5219986979726633511_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y_rt3C4JQSoQ7kNvwEIybYL&_nc_oc=AdlOGG7ve0TPENZH3jDCb6CJrZIrHBiposg9jg8b6uAoW_G04pE6g5AGtd3Hyg09zOw&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afw04b_J4gNxR7RI9U7YxMZQnpA31OnVjxrw2dxiD0N2WQ&oe=69B7FDCD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover-video.png", "id": "740381481685081", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499623569_740381485018414_2207102974461887046_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GAZ-O0QNFzIQ7kNvwF4ISr7&_nc_oc=AdmhCnXkzLrh7kjJkHsJT3wEKDYi39zAQuUPr0MOBMwtL6uG2CBKLrVvqomvhfFuprI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfxCOMPrP-C0G4obhFhh_SAAlwmqi87m0wY4NmXQsWuC0g&oe=69B7F279"}, "display_name": "2bfit", "keywords": ["fit", "exercise", "fun", "stretch"], "long_description": "This is an easy way to exercise, especially the upper body.  You can focus longer and enjoy moving around when you can see balls to interact with.\nAfter a minute (or 60 seconds) you can feel my shoulders and arms a little bit.  And if you keep you feet in place (don't rotate), you can stretch more.  If you go through a wall, the 2bfit area moves along with you.  This makes it easy to stay in a clear area. Enjoy the burn.", "short_description": "To be fit, or not to be fit. That is the question. \nMove around and score points by catching balls that drop and rotate.\nOther balls just hang around. Try not moving your feet.  Don't forget the\nballs behind you.  See your surroundings while you get fit.  Move thru a wall to move your 2bfit area."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1lWHEKMjXnD5KMPReMX33Brbi3
7kNvwHvgzcC&_nc_oc=AdrhMNC8dur8fvNdA_bfvNEP4XQbj9FC0Crtyl-nL7eyzCpn7C_1eaJvlyXNp8eGzCw&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0RlR07tMvKWuX1vSEJb4rm685RyAx0P-uRsSkjIMYP-w&oe=69D7AC78"}, {"file_name": "2bfit-update1.png", "id": "1273832591007574", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/491827725_1273832594340907_7679835096266954535_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B-0pWF3rZxYQ7kNvwH7ixnJ&_nc_oc=AdrYBG8f8je1C668toZafTqcXzJSqUf3utkNgiZT3ihhW02CQ6NLe2GUungZ-IxayRk&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2WvjT-6PvBcbwELuzGmYU76Ks8kmpMbugJ7jkP5BE7Pg&oe=69D7A30B"}, {"file_name": "2bfit-update3.png", "id": "4127365670925682", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/499307311_4127365674259015_7679022573858290498_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Lzs6GMiFezsQ7kNvwGxs6b2&_nc_oc=Adrw5AVE2GROev3FJW71r2dS0XPzgqRD34jlMpHmxB7EzamBldt_PByxAesVifiReZg&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1YIaonWHhCaru2v_APLG1vr7h0TVKIKZr81_eN8Jg6Bg&oe=69D79F5B"}, {"file_name": "2bfit-update4.png", "id": "4236623229995296", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/491827718_4236623233328629_551381304740174737_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1MKiGD36v3UQ7kNvwEBtrGa&_nc_oc=AdrSzEf3g0ybXyRhGZ2ZvlnImjHjf2xn-fDTCWRzf9HfLRZmf_5OY07R-yrfMPkQmLY&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3911EHK9PZ2L7IujO4QFfcKGWzLLh-WjOdTZTKcjVbBA&oe=69D7A57F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover-video.png", "id": "740381481685081", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/499623569_740381485018414_2207102974461887046_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6nbWWbVlpQAQ7kNvwFHexWZ&_nc_oc=AdqBTWC_WkIswv15p3023rumZGo2Bj1_zPijAn91knRNdVzHRBSAmf39azA3OeFyEXg&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1Lciz6WT76C7RyNDejqbk0QiV8Lt7-lfDR2kOo1QbXJA&oe=69D79679"}, "display_name": "2bfit", "keywords": ["fit", "exercise", "fun", "stretch"], "long_description": "This is an easy way to exercise, especially the upper body.  You can focus longer and enjoy moving around when you can see balls to interact with.\nAfter a minute (or 60 seconds) you can feel my shoulders and arms a little bit.  And if you keep you feet in place (don't rotate), you can stretch more.  If you go through a wall, the 2bfit area moves along with you.  This makes it easy to stay in a clear area. Enjoy the burn.", "short_description": "To be fit, or not to be fit. That is the question. \nMove around and score points by catching balls that drop and rotate.\nOther balls just hang around. Try not moving your feet.  Don't forget the\nballs behind you.  See your surroundings while you get fit.  Move thru a wall to move your 2bfit area."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1lWHEKMjXnD5KMPReMX33Brbi3goEyEwAAFv75cz--QU/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "amre-amer.com", "support_website_url": null, "website_url": "https://amre-amer.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25023755790560223"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/491821954_2335969400139423_72605
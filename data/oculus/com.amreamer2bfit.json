dEoL&_nc_oc=Adqgf8jZXOTPfDJ5M90zy1M652EeRNI-pLV7TigGE8LfjZ7mD5Vqo7AURH5BScpr9XQ&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0eIEz9bNd6Hn0folm8FIlbCXIgrPEg89vUXBxwK2gCIQ&oe=69E643FE"}, {"file_name": "screenshot-0.png", "id": "711374158163846", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/491819934_711374161497179_5219986979726633511_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tICpdZHBawkQ7kNvwHBgZEA&_nc_oc=AdoN2DH9uL0PilxCficws5pp-uvdxP74GyxnaevgxXDS-YX6zVhQdBCv1_KQSwqBaNY&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0AJIWIjiXSg-ht8auvV722sCFs5QKru1PwtW5nPP7sqA&oe=69E6224D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover-video.png", "id": "740381481685081", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499623569_740381485018414_2207102974461887046_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kRgREOUMtjgQ7kNvwHhOhBM&_nc_oc=AdqqC8oBxX-de11lLErMYve4WUWj3uj6Ax1QxDRzcgtBOzVfMpcI3OAS25OTTDb9Ebw&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2MkYyhuva-VXxapXP8QEQERBAjLRQE3WpIQNxoliAkTw&oe=69E616F9"}, "display_name": "2bfit", "keywords": ["fit", "exercise", "fun", "stretch"], "long_description": "This is an easy way to exercise, especially the upper body.  You can focus longer and enjoy moving around when you can see balls to interact with.\nAfter a minute (or 60 seconds) you can feel my shoulders and arms a little bit.  And if you keep you feet in place (don't rotate), you can stretch more.  If you go through a wall, the 2bfit area moves along with you.  This makes it easy to stay in a clear area. Enjoy the burn.", "short_description": "To be fit, or not to be fit. That is the question. \nMove around and score points by catching balls that drop and rotate.\nOther balls just hang around. Try not moving your feet.  Don't forget the\nballs behind you.  See your surroundings while you get fit.  Move thru a wall to move your 2bfit area."}]}, "developer
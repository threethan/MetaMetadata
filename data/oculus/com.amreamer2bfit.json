NIOs&_nc_oc=Adr3e9RuugdNew3vxEEWi_S0YDcS2pJUsPtNZNM0DwJqfZiyQ9k0h5_Ly1cpnGC-mWw&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIpBTRe63qi3rkzPGv6355pC43jcZAr3UEBO87v2nONbA&oe=6AA0277E"}, {"file_name": "screenshot-0.png", "id": "711374158163846", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/491819934_711374161497179_5219986979726633511_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XLbvMrgX1lIQ7kNvwE5cEvY&_nc_oc=AdrNws9ciO-JHB8vlvfbeMgurzb8ZOananwZVDk45SyyWVpop8ZOB3YAv4PA6zoxgks&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKPIHXDZdM4lO4E4MjvhbbQ7jeGxqCJQokXk09Hsm5jsw&oe=6AA005CD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover-video.png", "id": "740381481685081", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/499623569_740381485018414_2207102974461887046_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0TY4cMjYj98Q7kNvwEQtLUB&_nc_oc=Adr59wtIuq7Xvvr2o9N6rJyR21fJMpTNIvnfI0TbxeiXgwktPPtCrOuBX7MUXBUFoik&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI62s__Nr44D_2pdPFNO4nsO4bcs4-jrepCUcibKf9R-Q&oe=6A9FFA79"}, "display_name": "2bfit", "keywords": ["fit", "exercise", "fun", "stretch"], "long_description": "This is an easy way to exercise, especially the upper body.  You can focus longer and enjoy moving around when you can see balls to interact with.\nAfter a minute (or 60 seconds) you can feel my shoulders and arms a little bit.  And if you keep you feet in place (don't rotate), you can stretch more.  If you go through a wall, the 2bfit area moves along with you.  This makes it easy to stay in a clear area. Enjoy the burn.", "short_description": "To be fit, or not to be fit. That is the question. \nMove around and score points by catching balls that drop and rotate.\nOther balls just hang around. Try not moving your feet.  Don't forget the\nballs behind you.  See your surroundings while you get fit.  Move thru a wall to move your 2bfit area."}]}, "developer
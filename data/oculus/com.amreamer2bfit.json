c=N5veTCWLB2wQ7kNvwFQ3n8_&_nc_oc=AdqVVYodsCFM9xWSRDtlmVfLv8xuxPP5icajH-5N9JzCCUrxp_y0ITpo7XkgMtANxmg&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9IsLt3UCUVbZKowbhkeHNpB7imBOyRnKdnb0zyvLyyfA&oe=6A466A78"}, {"file_name": "2bfit-update1.png", "id": "1273832591007574", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/491827725_1273832594340907_7679835096266954535_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NrnVjJNDTdwQ7kNvwH0-GSF&_nc_oc=AdoIK34NVCg6TkOcGcfI0J1kIUKFuRB9Sg3_Cs6XnvL899mNcuJ0PRA8W_1u-gVAY0M&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9nhcMaS0sU7br3JGo5RecrkZ0n7B8p6hev9wRvRHh47A&oe=6A46610B"}, {"file_name": "2bfit-update3.png", "id": "4127365670925682", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/499307311_4127365674259015_7679022573858290498_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e6wu_FyYg60Q7kNvwFhu_Ko&_nc_oc=AdpbIDLodbJD3rLV5dRdmQJVNzplMZ3WcBnCLM6rbC9V4hkhjcaivMEaWFni49CERFU&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8iCtEM01ZI33Aa0nipO2M4Q2cIF3l0spv2KEI90xvXnw&oe=6A465D5B"}, {"file_name": "2bfit-update4.png", "id": "4236623229995296", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/491827718_4236623233328629_551381304740174737_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wXgB_yVd1AIQ7kNvwGXsJkI&_nc_oc=AdrsxONcUEXJXH9LLtPXTs6AGp0VU6qrQ1Vu3Vk16A5o-wNPqAHygs65TucS-lLUNKk&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9__jd1m-YdLRAhvm_Fh930Le6Hz9BqfDmD7LfkJ-8MWQ&oe=6A46637F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover-video.png", "id": "740381481685081", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/499623569_740381485018414_2207102974461887046_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o7bhbg_B2LQQ7kNvwEwlFIo&_nc_oc=AdqE4DUxEKADOxdHEs-fksBdntJo2P5vga2qLFb2wcBWtjE_f5HqgkeGlTgUr0fbRtE&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-z0RRzDiYlr8JmNqNdjb1nGQZV2aXjqQn9AhQJxF91lw&oe=6A468CB9"}, "display_name": "2bfit", "keywords": ["fit", "exercise", "fun", "stretch"], "long_description": "This is an easy way to exercise, especially the upper body.  You can focus longer and enjoy moving around when you can see balls to interact with.\nAfter a minute (or 60 seconds) you can feel my shoulders and arms a little bit.  And if you keep you feet in place (don't rotate), you can stretch more.  If you go through a wall, the 2bfit area moves along with you.  This makes it easy to stay in a clear area. Enjoy the burn.", "short_description": "To be fit, or not to be fit. That is the question. \nMove around and score points by catching balls that drop and rotate.\nOther balls just hang around. Try not moving your feet.  Don't forget the\nballs behind you.  See your surroundings while you get fit.  Move thru a wall to move your 2bfit area."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1lWHEKMjXnD5KMPReMX33Brbi3goEyEwAAFv75cz--QU/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "amre-amer.com", "support_website_url": null, "website_url": "https://amre-amer.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25023755790560223"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/491821954_233
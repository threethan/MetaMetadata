nqbS&_nc_oc=AdpVnO1-KVDuKkzazGtfE0933qmlU7pA9Yr02zEFhow-MBneYuLxv2mLneuiYTJI6rA&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1wMe5vGHTWP17EUp3HSNUlrmiR2WprTZtZ3pAf1u3edw&oe=69F372FE"}, {"file_name": "screenshot-0.png", "id": "711374158163846", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/491819934_711374161497179_5219986979726633511_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A-LhG7JlJRsQ7kNvwFIYwem&_nc_oc=AdqH9xbZWJuFsLVTuE7VQM93C1OAKXmK9bJ2YSpsCfR7P1j2kCGRg_Big_OWAxD_qeU&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2dE4VR4NS3tClPgUUag_2dco03cH0RSnhYf8kTphZFPg&oe=69F3514D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover-video.png", "id": "740381481685081", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499623569_740381485018414_2207102974461887046_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3uLWII7BJeYQ7kNvwFRjjZ6&_nc_oc=Ado0sL7FHs-4qKIbme_TI5QXVTApSr66nmskVPqyONf1xkeFKt90DD7_xdwmD86YrGM&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2ZccJxBBHvgbAYrx8nlCR2M6BaftIgui4lAWFfIvQdMg&oe=69F345F9"}, "display_name": "2bfit", "keywords": ["fit", "exercise", "fun", "stretch"], "long_description": "This is an easy way to exercise, especially the upper body.  You can focus longer and enjoy moving around when you can see balls to interact with.\nAfter a minute (or 60 seconds) you can feel my shoulders and arms a little bit.  And if you keep you feet in place (don't rotate), you can stretch more.  If you go through a wall, the 2bfit area moves along with you.  This makes it easy to stay in a clear area. Enjoy the burn.", "short_description": "To be fit, or not to be fit. That is the question. \nMove around and score points by catching balls that drop and rotate.\nOther balls just hang around. Try not moving your feet.  Don't forget the\nballs behind you.  See your surroundings while you get fit.  Move thru a wall to move your 2bfit area."}]}, "developer
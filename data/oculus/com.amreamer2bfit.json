h4VW&_nc_oc=Adr2w1fxnEeQQgUzSHYfrTptA8M28RDHu7to-q0Lj_NHB8DuhxxAOMepqdMc7CvNiBY&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBzOGB6JnG30fn7hLyekA_glE5xm-STaKlgp03nznIlEQ&oe=6A53B07E"}, {"file_name": "screenshot-0.png", "id": "711374158163846", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/491819934_711374161497179_5219986979726633511_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l6pUmm0HruQQ7kNvwGMBqsZ&_nc_oc=AdoUSQ3l7MFeR_2aFXYrbunDVJvAsm4NVZegcVTr_bBr5aakUQ_1pjTnpJrIoF8gaW8&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDtH7iVljHDVCMWur0QLQ-Z0OLmV75VypAjn2V5KUCp7A&oe=6A538ECD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover-video.png", "id": "740381481685081", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499623569_740381485018414_2207102974461887046_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V3Jr5tOh5AIQ7kNvwFQbRPB&_nc_oc=AdpvAOjMfbK0_lR1ICAHKmIv8VORPqRfdcKzPBsAo0hQQa4txA5peQo0xPi2JquQ7rE&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC5Bh7ruamp41ZPdSKzdPUm4YozevZLUq9iRt-ZUm65Og&oe=6A538379"}, "display_name": "2bfit", "keywords": ["fit", "exercise", "fun", "stretch"], "long_description": "This is an easy way to exercise, especially the upper body.  You can focus longer and enjoy moving around when you can see balls to interact with.\nAfter a minute (or 60 seconds) you can feel my shoulders and arms a little bit.  And if you keep you feet in place (don't rotate), you can stretch more.  If you go through a wall, the 2bfit area moves along with you.  This makes it easy to stay in a clear area. Enjoy the burn.", "short_description": "To be fit, or not to be fit. That is the question. \nMove around and score points by catching balls that drop and rotate.\nOther balls just hang around. Try not moving your feet.  Don't forget the\nballs behind you.  See your surroundings while you get fit.  Move thru a wall to move your 2bfit area."}]}, "developer
nWqz&_nc_oc=Adp2LCNOTWSvyS8qTiZiv9pi8vpDNT85oG65iwL54zHZPnknIuuWJgM2sdvYxF_S9T8&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af07RLtZWbvb6bTJv5dLJZdIQvN14x538WIx_q3BUfxSsw&oe=69E8AEBE"}, {"file_name": "screenshot-0.png", "id": "711374158163846", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491819934_711374161497179_5219986979726633511_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tICpdZHBawkQ7kNvwEbPKs-&_nc_oc=Adr7WxI4daCmJRc82n1AMgkaywyLAql4oRix0fityB2dU1O-891clFXhAsoCi0Eb8CI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af151Y9s-ueVxwyp-ZBC0NknZRHKyRAbRYtXdPdwoM93cw&oe=69E8C54D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover-video.png", "id": "740381481685081", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499623569_740381485018414_2207102974461887046_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kRgREOUMtjgQ7kNvwEhErLY&_nc_oc=Adq-Y1XJ2TpJcczGdYeQjxnaFDeuHzY1luHRCDHP1Z2IqOIvKI3FpgALSzeY_s5li7E&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2MYo54zhMP3fJr2wS_FyEzy_CMlhtafRnlDGobH6xIYA&oe=69E8B9F9"}, "display_name": "2bfit", "keywords": ["fit", "exercise", "fun", "stretch"], "long_description": "This is an easy way to exercise, especially the upper body.  You can focus longer and enjoy moving around when you can see balls to interact with.\nAfter a minute (or 60 seconds) you can feel my shoulders and arms a little bit.  And if you keep you feet in place (don't rotate), you can stretch more.  If you go through a wall, the 2bfit area moves along with you.  This makes it easy to stay in a clear area. Enjoy the burn.", "short_description": "To be fit, or not to be fit. That is the question. \nMove around and score points by catching balls that drop and rotate.\nOther balls just hang around. Try not moving your feet.  Don't forget the\nballs behind you.  See your surroundings while you get fit.  Move thru a wall to move your 2bfit area."}]}, "developer
bmWP&_nc_oc=AdqJxJ6dDaoDrf6wrovgHxR9uewwD-LQyQD9Yk5XEzb7ng7hvz5ezPpzBehms_Mi15Y&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR62Yl6L-aBJxBRLZDDCZppS-_Ztou5tCG4rlWCAfzaPg&oe=6AE8A9FE"}, {"file_name": "screenshot-0.png", "id": "711374158163846", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/491819934_711374161497179_5219986979726633511_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k17RGzrMWwYQ7kNvwEasbJ1&_nc_oc=Adr6K3Ltkrri63COP7kcmUPN0gFsynS1PeL4SVEqw0h93tiUoSryaJCcgqXQeIVchIA&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQkGYknfPmtBVRrg9wkPPKRhHBqNG03YuyxaJ__IphP0Q&oe=6AE8C08D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover-video.png", "id": "740381481685081", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/499623569_740381485018414_2207102974461887046_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zorR1bCsU1AQ7kNvwEyx4TI&_nc_oc=AdrsfXPpbpFyTooXyoPdYHzzlHx2BY2ctkMdP9atVN1n_Lv0KbXix-pLAXmVo1bjFMw&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRR7cCnZByDNwBvj1adxZco23Xt7HeBGO6lIiotBpUUng&oe=6AE8B539"}, "display_name": "2bfit", "keywords": ["fit", "exercise", "fun", "stretch"], "long_description": "This is an easy way to exercise, especially the upper body.  You can focus longer and enjoy moving around when you can see balls to interact with.\nAfter a minute (or 60 seconds) you can feel my shoulders and arms a little bit.  And if you keep you feet in place (don't rotate), you can stretch more.  If you go through a wall, the 2bfit area moves along with you.  This makes it easy to stay in a clear area. Enjoy the burn.", "short_description": "To be fit, or not to be fit. That is the question. \nMove around and score points by catching balls that drop and rotate.\nOther balls just hang around. Try not moving your feet.  Don't forget the\nballs behind you.  See your surroundings while you get fit.  Move thru a wall to move your 2bfit area."}]}, "developer
7kNvwHWnDqZ&_nc_oc=AdqCLFshYAoGV3oqSl1EuNfcA13hoaVj2TiXgxhryPR_Akhl9BdmU3hWTDv_V0q_3Ow&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af40r_zA48P9ZthtQ7Jc5zuwmZCAhmQp7t5VJjDJBPGuLQ&oe=6A0F0B78"}, {"file_name": "2bfit-update1.png", "id": "1273832591007574", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/491827725_1273832594340907_7679835096266954535_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fj-lw5cuxUQQ7kNvwF3lauC&_nc_oc=AdoD-V9bQKjQWMxj26BSN-NIXVPGa8QqLOYFuHrBC_7zjAhfTB_JTXmEVflslITt5y8&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6fV76RnSegPGdr8Qah93CnN9aBmOCW7TuMDhWBox2MSA&oe=6A0F020B"}, {"file_name": "2bfit-update3.png", "id": "4127365670925682", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499307311_4127365674259015_7679022573858290498_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5hyhsJAbrM0Q7kNvwFxEAZa&_nc_oc=AdrHmdeiT5Cmd9lhOB_9nXLu6Xzk_XYRzp7fV9bgVVtTmZnl_GMtHVOUXCLbg2NICb0&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af51lKNvvy7Of2vPAND8FOrha3CoU3BSkaK2shLph-Csng&oe=6A0EFE5B"}, {"file_name": "2bfit-update4.png", "id": "4236623229995296", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/491827718_4236623233328629_551381304740174737_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Jj_hYt_FeCwQ7kNvwEiESy1&_nc_oc=AdoPNBEanSXotJn7qVRlX2Xazz5Nd0DWn6DKUUeEYFAzZ-ubYBw55xToAldqHfwUV3Q&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7hYYk3_yLl8LMuvo1txDa3y5Xa8_h-X75jUf1hJMfEww&oe=6A0F047F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover-video.png", "id": "740381481685081", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499623569_740381485018414_2207102974461887046_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zWBw2kIxokoQ7kNvwEA6Jj0&_nc_oc=AdpgvY_2_1DFE6f0InnwXFaVDJiJf-_hCx8aLLUMjL-vs9TZseWS0W4Yn2utQn9G1Ag&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4fM3_aHA_aUfv6T5JNrv2aRqwEJreheIn5Fr1VMz4i0w&oe=6A0EF579"}, "display_name": "2bfit", "keywords": ["fit", "exercise", "fun", "stretch"], "long_description": "This is an easy way to exercise, especially the upper body.  You can focus longer and enjoy moving around when you can see balls to interact with.\nAfter a minute (or 60 seconds) you can feel my shoulders and arms a little bit.  And if you keep you feet in place (don't rotate), you can stretch more.  If you go through a wall, the 2bfit area moves along with you.  This makes it easy to stay in a clear area. Enjoy the burn.", "short_description": "To be fit, or not to be fit. That is the question. \nMove around and score points by catching balls that drop and rotate.\nOther balls just hang around. Try not moving your feet.  Don't forget the\nballs behind you.  See your surroundings while you get fit.  Move thru a wall to move your 2bfit area."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1lWHEKMjXnD5KMPReMX33Brbi3goEyEwAAFv75cz--QU/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "amre-amer.com", "support_website_url": null, "website_url": "https://amre-amer.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25023755790560223"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/491821954_2335969400139423_72605
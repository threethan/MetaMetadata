L8JK&_nc_oc=Adpeq6nTy8P62yJ0rwNCg0Vaybby6fXxicOB-QsplOKBe6Fc8Wmv96tvP4_WAAkb-_I&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af11OnU2iLfdy91UKUR0DCH-F0_DtPRHfmZsnnqHUHIoQw&oe=69EA387E"}, {"file_name": "screenshot-0.png", "id": "711374158163846", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491819934_711374161497179_5219986979726633511_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=345iMteiW5UQ7kNvwG4-99V&_nc_oc=AdohWVAzDsS0pO0zA6hSyoc4SadPoKcHnyfpatQ1LI0c6ZwTVjDW5UB7flv3och2lQA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1HslJKIYodWHUsLiM2IVQezjXldjsP5kS6n7qblCPNgg&oe=69EA16CD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover-video.png", "id": "740381481685081", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499623569_740381485018414_2207102974461887046_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kLnfEcorhcgQ7kNvwFiFpHV&_nc_oc=Adph4c2fcX-xKLbDW5e4sO4-JERTxroB85e_xBuU_040jb4-eXsrtBiqSp-ET9SxHHk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3xooJIqci09jYg9Q-xtMmPV9MpjYl50816mrNoyyLTFw&oe=69EA0B79"}, "display_name": "2bfit", "keywords": ["fit", "exercise", "fun", "stretch"], "long_description": "This is an easy way to exercise, especially the upper body.  You can focus longer and enjoy moving around when you can see balls to interact with.\nAfter a minute (or 60 seconds) you can feel my shoulders and arms a little bit.  And if you keep you feet in place (don't rotate), you can stretch more.  If you go through a wall, the 2bfit area moves along with you.  This makes it easy to stay in a clear area. Enjoy the burn.", "short_description": "To be fit, or not to be fit. That is the question. \nMove around and score points by catching balls that drop and rotate.\nOther balls just hang around. Try not moving your feet.  Don't forget the\nballs behind you.  See your surroundings while you get fit.  Move thru a wall to move your 2bfit area."}]}, "developer
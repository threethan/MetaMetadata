=6e7a0a&_nc_ohc=QMQbvG643NYQ7kNvwHlYGrp&_nc_oc=Adq7OCycd_W01MVrYfIuLANaNZiZjipZY-EDNg_yqp2GLtiTzaEq2dRupiHc-0211KQ&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHcQrM9e-EU1_M26_o2EmkJQbBh4wjNB8Ryb2JCu1bNTw&oe=6A7DA83E"}, {"file_name": "screenshot-0.png", "id": "711374158163846", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/491819934_711374161497179_5219986979726633511_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vbjiQPpA_4UQ7kNvwF8rw3d&_nc_oc=AdoUybXkV22QDo-EW0qJmZLznTfOFldQpCXnVRddBNnF5mIUz-tpo0zHnyOd7TNj0eQ&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEnazBNicMQpp26zTgKSWTqnFPqxza6tH_t0E5pw6SflA&oe=6A7DBECD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover-video.png", "id": "740381481685081", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/499623569_740381485018414_2207102974461887046_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Yq1bXh-8T60Q7kNvwGpQInX&_nc_oc=Adp_e9OVk9Jz-VSHCE6nbnfuVTtNTMQifCrdyVVeu0sf_nV2o3u-7ExM_NzjkBACCkk&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHpBNPVpHOHIAhQL60_x7jXhnrqrbnhi0h_AmPwg4dpag&oe=6A7DB379"}, "display_name": "2bfit", "keywords": ["fit", "exercise", "fun", "stretch"], "long_description": "This is an easy way to exercise, especially the upper body.  You can focus longer and enjoy moving around when you can see balls to interact with.\nAfter a minute (or 60 seconds) you can feel my shoulders and arms a little bit.  And if you keep you feet in place (don't rotate), you can stretch more.  If you go through a wall, the 2bfit area moves along with you.  This makes it easy to stay in a clear area. Enjoy the burn.", "short_description": "To be fit, or not to be fit. That is the question. \nMove around and score points by catching balls that drop and rotate.\nOther balls just hang around. Try not moving your feet.  Don't forget the\nballs behind you.  See your surroundings while you get fit.  Move thru a wall to move your 2bfit area."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1lWHEKMjXnD5KMPReMX33Brbi3goEyEwAAFv75cz--QU/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "amre-amer.com", "support_website_url": null, "website_url": "https://amre-amer.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24828507350085069"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1367003834403285"}]}, "baseline_offer": {"id": "1367003834403285"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1752249420, "status": "PUBLISHED", "id": "1367003834403285"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "24828674460068358", "version": "0.1.0"}, "id": "1456486325490290", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "24822641337338337", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "24828674460068358"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1456486325490290"}]}, "change_log": null, "created_date": 1752240526, "id": "24828674
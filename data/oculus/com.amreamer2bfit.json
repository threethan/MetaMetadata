cO_0&_nc_oc=AdrqCyP0mkU2eXf9B74ZCdhJqo3ODOOS9w8kSxcTu9SK5o0G_aJCcPKmLm2Cr8-EbFs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6ilR--nR16zC8n__VQfpX54HujiScR_82QpBroDsK1zA&oe=69FA0A7E"}, {"file_name": "screenshot-0.png", "id": "711374158163846", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491819934_711374161497179_5219986979726633511_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dOeCFnVQfLwQ7kNvwHq2ONt&_nc_oc=AdpaZ00atR8Kl0jiyRvfewDLtGqCjf1zEB8zAYuwOou78vVfr3ikh78lHQH8mIdaHeY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4dSTBh2MP4EZGiFWKR4rg0rxDxIU744PfERLthrW3fbQ&oe=69F9E8CD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover-video.png", "id": "740381481685081", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499623569_740381485018414_2207102974461887046_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NrUy7M3rbzQQ7kNvwFZ9FT_&_nc_oc=AdoBXu8sZ2KaSnnfkeriXCsO7anjz5056V_1YsP8WF2JKWWF4F4D3oCnJ4cN5FsikOI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4zHFNW4-bGpvOXNBmnuNpryR_3LqoSraZWuNKz1bFFcA&oe=69F9DD79"}, "display_name": "2bfit", "keywords": ["fit", "exercise", "fun", "stretch"], "long_description": "This is an easy way to exercise, especially the upper body.  You can focus longer and enjoy moving around when you can see balls to interact with.\nAfter a minute (or 60 seconds) you can feel my shoulders and arms a little bit.  And if you keep you feet in place (don't rotate), you can stretch more.  If you go through a wall, the 2bfit area moves along with you.  This makes it easy to stay in a clear area. Enjoy the burn.", "short_description": "To be fit, or not to be fit. That is the question. \nMove around and score points by catching balls that drop and rotate.\nOther balls just hang around. Try not moving your feet.  Don't forget the\nballs behind you.  See your surroundings while you get fit.  Move thru a wall to move your 2bfit area."}]}, "developer
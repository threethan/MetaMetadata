L8ko&_nc_oc=Adpe5KcwdlpHCPwKdZee2BjsLMmskloItBSw3XMtKnHZShtLT1z8jWnzgvuEJ143TUY&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHHmK4JImzt0HxCDvE3mPzwj8NaubtLyfJ2B44haGqTwQ&oe=6A88343E"}, {"file_name": "screenshot-0.png", "id": "711374158163846", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/491819934_711374161497179_5219986979726633511_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f6JNfPmCRJEQ7kNvwHSx_Qr&_nc_oc=AdrYbtEifxLr7GyeIQ5iKCuYzAr6Ov7eVJpR6RDMGHYtezTJV-TBSuMP8V6cLOyyqM0&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGrM7JtcOY1dyGxiE85jocTQgE0N6lg6f_sutG5Byv56A&oe=6A884ACD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover-video.png", "id": "740381481685081", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/499623569_740381485018414_2207102974461887046_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tbfiUyOmdtoQ7kNvwE7mAGp&_nc_oc=AdqFjrUxshfYUs4Mq_SAdFh0dMLmaOn5pjdOB-UwzxRK7prEdsnGlCCAIwmZikMoRWo&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGJhGJs9mD9WRH0_DDlF6-VjW4kRkDEnKHV_F3BDZmxaw&oe=6A883F79"}, "display_name": "2bfit", "keywords": ["fit", "exercise", "fun", "stretch"], "long_description": "This is an easy way to exercise, especially the upper body.  You can focus longer and enjoy moving around when you can see balls to interact with.\nAfter a minute (or 60 seconds) you can feel my shoulders and arms a little bit.  And if you keep you feet in place (don't rotate), you can stretch more.  If you go through a wall, the 2bfit area moves along with you.  This makes it easy to stay in a clear area. Enjoy the burn.", "short_description": "To be fit, or not to be fit. That is the question. \nMove around and score points by catching balls that drop and rotate.\nOther balls just hang around. Try not moving your feet.  Don't forget the\nballs behind you.  See your surroundings while you get fit.  Move thru a wall to move your 2bfit area."}]}, "developer
XSg4&_nc_oc=AdqzYTqWoy3TdsB82qk9aA3fZfiXL53xTe5nW9PhAMlvEdQGOCTvTXbGscyt4RPGJEQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyeaWmw3KeWuhQdabDlxXbd3xBIKxf39DAv7OhhQJIISA&oe=69CCFF3E"}, {"file_name": "screenshot-0.png", "id": "711374158163846", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491819934_711374161497179_5219986979726633511_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eLV3sZaIijkQ7kNvwFvHB5G&_nc_oc=AdqWi94XZzjyuxhFp2WhFamQ-_yAUPEl18NsbLi7AZnqQjkKv2FYEYw6H22yXe79ezc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzAitjpEQUfSAlfxXG1Sv_nsO_RuKbEqOULKHQd3i7S4A&oe=69CD15CD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover-video.png", "id": "740381481685081", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499623569_740381485018414_2207102974461887046_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e1RXW3RnvMUQ7kNvwG5aokH&_nc_oc=AdoaluQG0RhEVsckhKAt5YhajlDMejFiXyUEhZLln0neJF6VjFOJ5brfLYdGFx8GOcc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afwr9_FmIilRN-3nfgpSAhkIOndnSOV91_YZUnmgJZqxAw&oe=69CD0A79"}, "display_name": "2bfit", "keywords": ["fit", "exercise", "fun", "stretch"], "long_description": "This is an easy way to exercise, especially the upper body.  You can focus longer and enjoy moving around when you can see balls to interact with.\nAfter a minute (or 60 seconds) you can feel my shoulders and arms a little bit.  And if you keep you feet in place (don't rotate), you can stretch more.  If you go through a wall, the 2bfit area moves along with you.  This makes it easy to stay in a clear area. Enjoy the burn.", "short_description": "To be fit, or not to be fit. That is the question. \nMove around and score points by catching balls that drop and rotate.\nOther balls just hang around. Try not moving your feet.  Don't forget the\nballs behind you.  See your surroundings while you get fit.  Move thru a wall to move your 2bfit area."}]}, "developer
NYED&_nc_oc=AdoCObHYKk1F2N7-ATn7KK8QdWjBB6Ar_KpONt8JJ9EAlxkQow2L8ypVEy6eSXR0yt8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOHvPAx28RHvjlzYC6qbbqRf7qxilnpBebVJJKoHsd4Jw&oe=6AC3BFFE"}, {"file_name": "screenshot-0.png", "id": "711374158163846", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491819934_711374161497179_5219986979726633511_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hGIt_rBw8cIQ7kNvwHXbWwq&_nc_oc=Adrw6kCTBOcPYRrghHa-7btNKgmz4Zllp4zCjPncdpG2UuJyVCzN7DVv19JpqVgUGY4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOnCoccFmaKpdlX1zPjw6slsqvvTw2aHaeqN_Olu9AIdw&oe=6AC3D68D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover-video.png", "id": "740381481685081", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499623569_740381485018414_2207102974461887046_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c1nBewbGkTsQ7kNvwGXCwQy&_nc_oc=AdrTkiJQ3r0VUaezuJqaK4OoeX19d9lpY4poyEDg9cYpcJNUoCnsbGmJy64crQxCKrU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNGRliW4P2ujAXxaBhv8KE9N69x9fJFQ7bD4Wlq59hqXw&oe=6AC3CB39"}, "display_name": "2bfit", "keywords": ["fit", "exercise", "fun", "stretch"], "long_description": "This is an easy way to exercise, especially the upper body.  You can focus longer and enjoy moving around when you can see balls to interact with.\nAfter a minute (or 60 seconds) you can feel my shoulders and arms a little bit.  And if you keep you feet in place (don't rotate), you can stretch more.  If you go through a wall, the 2bfit area moves along with you.  This makes it easy to stay in a clear area. Enjoy the burn.", "short_description": "To be fit, or not to be fit. That is the question. \nMove around and score points by catching balls that drop and rotate.\nOther balls just hang around. Try not moving your feet.  Don't forget the\nballs behind you.  See your surroundings while you get fit.  Move thru a wall to move your 2bfit area."}]}, "developer
_xCQ&_nc_oc=AdpZo9MH8vPCYasCcuOuhOdsqL_KrOyiiKQTAmqk5saUrmlV7QEhbeu11AXVtxdr-1c&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQObMzDkwatKtiLb_rItQFXa8YJED0ifBqp_I0NlrXhKoA&oe=6ADCCC7E"}, {"file_name": "screenshot-0.png", "id": "711374158163846", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/491819934_711374161497179_5219986979726633511_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l8lmbEWUYKEQ7kNvwHSGQLm&_nc_oc=AdoB2zJtunky_A2m0CY6IkyUbejIdRadtQwAuu6ZMVfRaV1YpZK6yPZma0iKkOH83Wk&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN_7IQir2iNJoX5hNZG9GveyRCYt-0zcCmoUrdHqIHX1g&oe=6ADCAACD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover-video.png", "id": "740381481685081", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499623569_740381485018414_2207102974461887046_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fX3F27MPqZsQ7kNvwGYvukS&_nc_oc=AdprExeeQYNhN2I_So34EpbSBQJmmcxnHHYEOx0-cPz_OT0pdgcRLzd-fb45CaQ_k_s&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOPT_Rn-JdNx3br8cDD856ixHS15jDqFle6uiYUTZxvFg&oe=6ADCD7B9"}, "display_name": "2bfit", "keywords": ["fit", "exercise", "fun", "stretch"], "long_description": "This is an easy way to exercise, especially the upper body.  You can focus longer and enjoy moving around when you can see balls to interact with.\nAfter a minute (or 60 seconds) you can feel my shoulders and arms a little bit.  And if you keep you feet in place (don't rotate), you can stretch more.  If you go through a wall, the 2bfit area moves along with you.  This makes it easy to stay in a clear area. Enjoy the burn.", "short_description": "To be fit, or not to be fit. That is the question. \nMove around and score points by catching balls that drop and rotate.\nOther balls just hang around. Try not moving your feet.  Don't forget the\nballs behind you.  See your surroundings while you get fit.  Move thru a wall to move your 2bfit area."}]}, "developer
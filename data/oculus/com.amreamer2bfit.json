pgee&_nc_oc=AdrD8AuTtc54XHbREokJ-LtZv8FjBY1VwPYt4uqW_EXVFt_6ey7Wzdj10mugcTyaTS4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8Lw5T-YEZfL6Z-dr3y4uf6LY4qa1qs3Z5_QS_db_sdhQ&oe=6A29807E"}, {"file_name": "screenshot-0.png", "id": "711374158163846", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491819934_711374161497179_5219986979726633511_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LZA4bJnKKX4Q7kNvwEEDM7N&_nc_oc=Adp2rJv3oQIEhRa7Sg-Brf21eyDQLPDF8EhFxd4JqsRgPAsUfUlmU2Ekc5iA2qm261Y&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_tkDqvzu0AKGVdY_MbW7oJdFswWjPGuwbsf4OsA_aW-A&oe=6A295ECD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover-video.png", "id": "740381481685081", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499623569_740381485018414_2207102974461887046_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eB9HmBpWQbwQ7kNvwHBfcaX&_nc_oc=AdrC1oCK8O_TkcPxY5tXHPGBcXix2brisusCSWVfIlmHc4udUuo3t0jx8FnffUyVmvs&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_OEWXYDWSNUQ3d5IhPzvudub0Sq5vFwZLqHfOi6yy1xw&oe=6A295379"}, "display_name": "2bfit", "keywords": ["fit", "exercise", "fun", "stretch"], "long_description": "This is an easy way to exercise, especially the upper body.  You can focus longer and enjoy moving around when you can see balls to interact with.\nAfter a minute (or 60 seconds) you can feel my shoulders and arms a little bit.  And if you keep you feet in place (don't rotate), you can stretch more.  If you go through a wall, the 2bfit area moves along with you.  This makes it easy to stay in a clear area. Enjoy the burn.", "short_description": "To be fit, or not to be fit. That is the question. \nMove around and score points by catching balls that drop and rotate.\nOther balls just hang around. Try not moving your feet.  Don't forget the\nballs behind you.  See your surroundings while you get fit.  Move thru a wall to move your 2bfit area."}]}, "developer
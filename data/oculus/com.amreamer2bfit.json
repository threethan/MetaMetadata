9cHq5Dq0Q7kNvwGdeJCl&_nc_oc=Ado-jQAHFbUjyvCUZys_e2FnVLmY_TECPq_DGDqmugNHbdzx8Vr0nSDA0o6ElHUOKW4&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFTzqMHnmRlnDYN83W_ea9T1iG0oo8HS6s_3EpLeYlKvA&oe=6A8EECF8"}, {"file_name": "2bfit-update1.png", "id": "1273832591007574", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/491827725_1273832594340907_7679835096266954535_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_cPnpgzeTTgQ7kNvwFpYBdm&_nc_oc=AdqZI8saKeclf8xyWQrmpUhcxU8UfmruE48GjjgvjTdniQ33MQepM5byCgPLQaBY3RE&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGtpGxuzm3VkroPEvJzmE-lhLyohUPasU8Lkd9Rb0Vh_w&oe=6A8EE38B"}, {"file_name": "2bfit-update3.png", "id": "4127365670925682", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/499307311_4127365674259015_7679022573858290498_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PNh6K6zfMQYQ7kNvwHY7o-Q&_nc_oc=AdptCKjmihjab6CjfQ23HxD6k56S-laNMHW2iBaUi85HOBGag1g_pRhJZCqYynSODj4&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGx8nMkRMH9QTfDxVK4c3Ye4JD95uhNuguQeBz4ZAghFA&oe=6A8EDFDB"}, {"file_name": "2bfit-update4.png", "id": "4236623229995296", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/491827718_4236623233328629_551381304740174737_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cq4EHOMiNqkQ7kNvwGWwGs0&_nc_oc=Adr1GFUiOM32AtJzD0HPOS_NUScQII6dHtPMd_m_HIoXyz3MZTwkFxbLkWDxl4Si7uY&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGX60H6Zb24xqyIduAjQAUi9LEDV6M35wOayRcN30sHQQ&oe=6A8EE5FF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover-video.png", "id": "740381481685081", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/499623569_740381485018414_2207102974461887046_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O8262yaB0AkQ7kNvwHG7gYX&_nc_oc=AdoHuJaS9FS_0rJZuEyy559PuFogAOVuCwmVgYM7FGpWQSGuS00h9x-_aN9CXH4i3kw&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEtMbApw_HQFplf-7PZJKtEAM_MJio6cDQn0yxShC6H1Q&oe=6A8ED6F9"}, "display_name": "2bfit", "keywords": ["fit", "exercise", "fun", "stretch"], "long_description": "This is an easy way to exercise, especially the upper body.  You can focus longer and enjoy moving around when you can see balls to interact with.\nAfter a minute (or 60 seconds) you can feel my shoulders and arms a little bit.  And if you keep you feet in place (don't rotate), you can stretch more.  If you go through a wall, the 2bfit area moves along with you.  This makes it easy to stay in a clear area. Enjoy the burn.", "short_description": "To be fit, or not to be fit. That is the question. \nMove around and score points by catching balls that drop and rotate.\nOther balls just hang around. Try not moving your feet.  Don't forget the\nballs behind you.  See your surroundings while you get fit.  Move thru a wall to move your 2bfit area."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1lWHEKMjXnD5KMPReMX33Brbi3goEyEwAAFv75cz--QU/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "amre-amer.com", "support_website_url": null, "website_url": "https://amre-amer.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25023755790560223"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/491821954_23359694
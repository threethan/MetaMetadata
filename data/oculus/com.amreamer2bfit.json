content-sjc6-1.oculuscdn.com&oh=00_AfsOqD0IGBTzx3plAKIDRoSKsUre1BbZrRiT9_O4EXAbAQ&oe=69986478"}, {"file_name": "2bfit-update1.png", "id": "1273832591007574", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491827725_1273832594340907_7679835096266954535_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_NHHD0bQ-PoQ7kNvwFn5wDx&_nc_oc=Admuu4BRPOAfT7OWtSGGSJCvlVEVhBonr4QNvzkqdsbX2j2u5gD2BZgNa5WRLvkpiQY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&oh=00_AfvZW4w9eAg-oHQkvMN8Kg3mkOFG2j1gR1vR4xFo-Z-IxA&oe=69985B0B"}, {"file_name": "2bfit-update3.png", "id": "4127365670925682", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499307311_4127365674259015_7679022573858290498_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pJ-zz9Zy8BQQ7kNvwFSjG6K&_nc_oc=Adlqc5rHAWL1g7z-MIGZ-2vHkjDdTpBo4Wgx-Lws1LXQSemRANRG3kfTSO42D4oUCCw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&oh=00_Afu-g-NC-YiyBwXgoUOKJDGsBaka2ya4Y6onwJHUtvu2Ow&oe=6998575B"}, {"file_name": "2bfit-update4.png", "id": "4236623229995296", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491827718_4236623233328629_551381304740174737_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hgqAWgoZ-BgQ7kNvwHCWv5y&_nc_oc=AdkQ17LWUrfnHuqsal9qZ3BZAQek-Ox4rMBPN60rSfEwi_CK_rEMJwaRPFoisy4EzeQ&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&oh=00_AfvKEcHJpCQK5tqCFLK6nmFYDeqOCPh_qXlb4JWKsyLdbw&oe=69985D7F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover-video.png", "id": "740381481685081", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499623569_740381485018414_2207102974461887046_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZDCt8iF3X-8Q7kNvwEAwm2B&_nc_oc=AdnLQzPp7q3AljGB8tB3d4e5HpOtY-4StwVFbCq6jEjowvnZxHix-I0xkoDq3ArwcU0&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&oh=00_AfsB8sCbelfXeYUlKcprt7jEIF7n3fep_3Q3YhPN-6bq9w&oe=69984E79"}, "display_name": "2bfit", "keywords": ["fit", "exercise", "fun", "stretch"], "long_description": "This is an easy way to exercise, especially the upper body.  You can focus longer and enjoy moving around when you can see balls to interact with.\nAfter a minute (or 60 seconds) you can feel my shoulders and arms a little bit.  And if you keep you feet in place (don't rotate), you can stretch more.  If you go through a wall, the 2bfit area moves along with you.  This makes it easy to stay in a clear area. Enjoy the burn.", "short_description": "To be fit, or not to be fit. That is the question. \nMove around and score points by catching balls that drop and rotate.\nOther balls just hang around. Try not moving your feet.  Don't forget the\nballs behind you.  See your surroundings while you get fit.  Move thru a wall to move your 2bfit area."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1lWHEKMjXnD5KMPReMX33Brbi3goEyEwAAFv75cz--QU/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "amre-amer.com", "support_website_url": null, "website_url": "https://amre-amer.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25023755790560223"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491821954_2335969400139423_7260507335481471188_n.png?stp=dst-png_s360x360&_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fzCDyQnUJ6QQ7kNvwHvYKOZ&_nc_oc=AdmoTpENHbQC2oOTknjczyNgBxVsU5nlmmCQRcyPfX9eVOoZZfNyc
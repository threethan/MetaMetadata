j6gd&_nc_oc=AdqpX2WKtBevKRLwn7c3JDfI_QZkeYRQRZwlKLscAu_pn4QPpQ9giNeOBI4B1m-af4U&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPVehtd5QHQiaWQYdh-hVhcVb6xvGL1U64LmlgyQzqYVw&oe=6AC662FE"}, {"file_name": "screenshot-0.png", "id": "711374158163846", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491819934_711374161497179_5219986979726633511_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hGIt_rBw8cIQ7kNvwEJ8eXW&_nc_oc=AdqzFRSWqylKafk3ReyOORf-ZEHiaX3WxRhiX0ZSAhk4AnD5SJGYbtK6y51cdKWBLkU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNncy6-HkKGRpceAskV_6GWKXifqK1yu5mmIivjQuszvQ&oe=6AC6414D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover-video.png", "id": "740381481685081", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499623569_740381485018414_2207102974461887046_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c1nBewbGkTsQ7kNvwF4Bfno&_nc_oc=AdohiWL-epUPkTprWjMW6i4pnpib1eV6OGhp_yvoi-phrXjym73cSa6PewrhVsdUzhM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNISnGFjweXlG4RzBpqRKm23A8eSqMfQfLDHe_6UHR37w&oe=6AC66E39"}, "display_name": "2bfit", "keywords": ["fit", "exercise", "fun", "stretch"], "long_description": "This is an easy way to exercise, especially the upper body.  You can focus longer and enjoy moving around when you can see balls to interact with.\nAfter a minute (or 60 seconds) you can feel my shoulders and arms a little bit.  And if you keep you feet in place (don't rotate), you can stretch more.  If you go through a wall, the 2bfit area moves along with you.  This makes it easy to stay in a clear area. Enjoy the burn.", "short_description": "To be fit, or not to be fit. That is the question. \nMove around and score points by catching balls that drop and rotate.\nOther balls just hang around. Try not moving your feet.  Don't forget the\nballs behind you.  See your surroundings while you get fit.  Move thru a wall to move your 2bfit area."}]}, "developer
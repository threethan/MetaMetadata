cvKQ&_nc_oc=AdpbT8YB993qOLsR-NTSBdRXtMFmpv7NeCcoAufWAdV3rZY_bJ_lON5HP1Vlc61_2jA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6EaBkFwXpIP7R2LgfWBfzhi2TpoepOnsSA7PxapXXKJg&oe=6A0B2DFE"}, {"file_name": "screenshot-0.png", "id": "711374158163846", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491819934_711374161497179_5219986979726633511_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RV5EwkFOPc8Q7kNvwF5Hnrl&_nc_oc=AdrgE9XhlwReU3LcZk2d3-OQUn6RVHgPzfXXxJdJYi4sUHdokzHBLMAViEWEwT9aKac&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4BAPsRpVGq-AlCwQGs-vP7lJq77wVLViurx-yUEhb3NQ&oe=6A0B0C4D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover-video.png", "id": "740381481685081", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499623569_740381485018414_2207102974461887046_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0xI966oUO_0Q7kNvwFLTrm-&_nc_oc=AdozV_1zG7rFCMCQuV81sajHJD_RIVSJx0OBpvaQTLSyNf4vU7uLy05W6oBzwrjzRUI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5A70ueHZUqoa_F3BbAyBVJi73ZirV17kF_kN19st2-wQ&oe=6A0B00F9"}, "display_name": "2bfit", "keywords": ["fit", "exercise", "fun", "stretch"], "long_description": "This is an easy way to exercise, especially the upper body.  You can focus longer and enjoy moving around when you can see balls to interact with.\nAfter a minute (or 60 seconds) you can feel my shoulders and arms a little bit.  And if you keep you feet in place (don't rotate), you can stretch more.  If you go through a wall, the 2bfit area moves along with you.  This makes it easy to stay in a clear area. Enjoy the burn.", "short_description": "To be fit, or not to be fit. That is the question. \nMove around and score points by catching balls that drop and rotate.\nOther balls just hang around. Try not moving your feet.  Don't forget the\nballs behind you.  See your surroundings while you get fit.  Move thru a wall to move your 2bfit area."}]}, "developer
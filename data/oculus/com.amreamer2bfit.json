c=ok2DZkAFgmYQ7kNvwG-_QQl&_nc_oc=AdqgSzvu5LIr20RGEh4NBzmOAh358-dxOykMBVFNRf0ZhNsb8hxLGYffu3mxlbOLWf4&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEabxl8y_Yt6I7gCwWv54tN-sJt2yY7kh3BFPJM8z7f0A&oe=6A7DC978"}, {"file_name": "2bfit-update1.png", "id": "1273832591007574", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/491827725_1273832594340907_7679835096266954535_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fxE3w-nT8YgQ7kNvwEJZKYv&_nc_oc=Adp6a3x1x20qfU-SQdAGcK5bHlfpVJUFWlrvIdfeXQvxSjaGT5YyX-P0-PXPCX44cXE&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGXxuaTXuOvdluqHr6TLc6A07GY2jaaqWrlWBrxROBVZQ&oe=6A7DC00B"}, {"file_name": "2bfit-update3.png", "id": "4127365670925682", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/499307311_4127365674259015_7679022573858290498_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MDkgD8JgDkkQ7kNvwEpiisA&_nc_oc=AdrTxnZche_rt6m71lCslszJbIOlMQm7YuKBYwT18iOwQYxt7KXtHK-vbVwH59YJUp0&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH-wHe2LNLBSwnf5Vybr-4nSBqIwfsx6cORDtgPrkh8jA&oe=6A7DBC5B"}, {"file_name": "2bfit-update4.png", "id": "4236623229995296", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/491827718_4236623233328629_551381304740174737_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yFAiLui68I8Q7kNvwEHzTLm&_nc_oc=Ado963L8z6RRCYft872duUL0oeKY1_DL8tsXqtNdngbNRbycwp4mWYHvlVgwnls1s44&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG9yDZ3AR1idJ2LIHqDGVyS6mJKeNWdmI2gn4obj-LhNA&oe=6A7DC27F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover-video.png", "id": "740381481685081", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/499623569_740381485018414_2207102974461887046_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Yq1bXh-8T60Q7kNvwGpQInX&_nc_oc=Adp_e9OVk9Jz-VSHCE6nbnfuVTtNTMQifCrdyVVeu0sf_nV2o3u-7ExM_NzjkBACCkk&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHpBNPVpHOHIAhQL60_x7jXhnrqrbnhi0h_AmPwg4dpag&oe=6A7DB379"}, "display_name": "2bfit", "keywords": ["fit", "exercise", "fun", "stretch"], "long_description": "This is an easy way to exercise, especially the upper body.  You can focus longer and enjoy moving around when you can see balls to interact with.\nAfter a minute (or 60 seconds) you can feel my shoulders and arms a little bit.  And if you keep you feet in place (don't rotate), you can stretch more.  If you go through a wall, the 2bfit area moves along with you.  This makes it easy to stay in a clear area. Enjoy the burn.", "short_description": "To be fit, or not to be fit. That is the question. \nMove around and score points by catching balls that drop and rotate.\nOther balls just hang around. Try not moving your feet.  Don't forget the\nballs behind you.  See your surroundings while you get fit.  Move thru a wall to move your 2bfit area."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1lWHEKMjXnD5KMPReMX33Brbi3goEyEwAAFv75cz--QU/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "amre-amer.com", "support_website_url": null, "website_url": "https://amre-amer.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25023755790560223"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/491821954_233
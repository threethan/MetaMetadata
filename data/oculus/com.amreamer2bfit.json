/491819934_711374161497179_5219986979726633511_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rX5GtXkt5usQ7kNvwH5pttO&_nc_oc=AdpwYdygqLaWcKb3I6VlnHFeNINlX6EjQ8uhZ2U9pDVi9opxQj6CdqPyWh3PZSS_L6U&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Af1CN0ejSN7bwd5Ap4OTFVlJKIyjfbM9Mnszh_qPCYp0jg&oe=69F0AE4D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover-video.png", "id": "740381481685081", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499623569_740381485018414_2207102974461887046_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y8dMO4pgL5cQ7kNvwGgsgqr&_nc_oc=Adp9IVMySiyMkFzjQ60ixVKqSdCfAOCXakCGJiRDFTTFjkepdwFedJJDMAnxWwjNSPk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Af2WiV2QUIvg6rWr9l3VwB_H76C34xFe295uXBjUdooGtQ&oe=69F0A2F9"}, "display_name": "2bfit", "keywords": ["fit", "exercise", "fun", "stretch"], "long_description": "This is an easy way to exercise, especially the upper body.  You can focus longer and enjoy moving around when you can see balls to interact with.\nAfter a minute (or 60 seconds) you can feel my shoulders and arms a little bit.  And if you keep you feet in place (don't rotate), you can stretch more.  If you go through a wall, the 2bfit area moves along with you.  This makes it easy to stay in a clear area. Enjoy the burn.", "short_description": "To be fit, or not to be fit. That is the question. \nMove around and score points by catching balls that drop and rotate.\nOther balls just hang around. Try not moving your feet.  Don't forget the\nballs behind you.  See your surroundings while you get fit.  Move thru a wall to move your 2bfit area."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1lWHEKMjXnD5KMPReMX33Brbi3goEyEwAAFv75cz--QU/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "amre-amer.com", "support_website_url": null, "website_url": "https://amre-amer.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", 
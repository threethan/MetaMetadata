7kNvwHdSo1o&_nc_oc=AdoP-etAWcek65zNF9q97wokuY30UizVhAcLlKFxbv-yQJh58CNdUxo-EwoTDR3uavM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9SZXWfqRT4Kt4G76AcI78QmPlhYX9ybNTjAclBMUT0EA&oe=6A315278"}, {"file_name": "2bfit-update1.png", "id": "1273832591007574", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491827725_1273832594340907_7679835096266954535_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YNNPlif52lYQ7kNvwEZuatd&_nc_oc=AdqRo-I1y4MnHY5AXjYfNFcamETEAWNrUrkHXiY9kPmpGNGzySVuc72dJ-KmjX8z--U&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-Q7A21aUzAL8n_Y7r_SZ5g2PT5MZ-rTejv8z7G6ON_JQ&oe=6A31490B"}, {"file_name": "2bfit-update3.png", "id": "4127365670925682", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499307311_4127365674259015_7679022573858290498_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KstOrAulUzkQ7kNvwG7tl-n&_nc_oc=AdoJlW6G16VZELbByyQ1SNdnHR4xdYV5QHeS53hI5RgRnbx2MzlxnOhsRfto2Ttc0ZI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_A6Z5p7bx9ZxLm5mgp0Fon7Cc4rnYVlqMW67VkA0jHAw&oe=6A31455B"}, {"file_name": "2bfit-update4.png", "id": "4236623229995296", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491827718_4236623233328629_551381304740174737_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LFFDXssR458Q7kNvwH8wLMB&_nc_oc=AdrDPtlhN3Gt6vWM3zJZ4h80nBd2H4poxuvWouixo9-Tfdv-c5WBxdWalIrVCffUNuE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8Ik-uk37ZW_RaLdE7KhD7P9ihOmekeu0AijW1UY3WKVw&oe=6A314B7F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover-video.png", "id": "740381481685081", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499623569_740381485018414_2207102974461887046_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Zx5RgMh1AY8Q7kNvwGxa-gr&_nc_oc=AdqIbH-ybDj0SZLK2ZjtK5UAfRNQrwZtPHwi0TlY5vRI_e-qKqvdohJUlY09VezxQP0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_R2GnjfBHiiu9d9xXtWaQF0-Liv0LXpdcldt-BjPKGIQ&oe=6A3174B9"}, "display_name": "2bfit", "keywords": ["fit", "exercise", "fun", "stretch"], "long_description": "This is an easy way to exercise, especially the upper body.  You can focus longer and enjoy moving around when you can see balls to interact with.\nAfter a minute (or 60 seconds) you can feel my shoulders and arms a little bit.  And if you keep you feet in place (don't rotate), you can stretch more.  If you go through a wall, the 2bfit area moves along with you.  This makes it easy to stay in a clear area. Enjoy the burn.", "short_description": "To be fit, or not to be fit. That is the question. \nMove around and score points by catching balls that drop and rotate.\nOther balls just hang around. Try not moving your feet.  Don't forget the\nballs behind you.  See your surroundings while you get fit.  Move thru a wall to move your 2bfit area."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1lWHEKMjXnD5KMPReMX33Brbi3goEyEwAAFv75cz--QU/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "amre-amer.com", "support_website_url": null, "website_url": "https://amre-amer.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25023755790560223"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491821954_2335969400139423_72605
scontent-atl3-2.oculuscdn.com&_nc_ss=8&oh=00_Afw89yvPGe7P8G-zc30S0vS4pow5iqjsUnORfGe-mZ5OCA&oe=69C121BE"}, {"file_name": "screenshot-0.png", "id": "711374158163846", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/491819934_711374161497179_5219986979726633511_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hju98bmkCj0Q7kNvwFAwup7&_nc_oc=AdrXEyAe1JWQOVB8tFCRWXCSbb85MxcO5OvDfiiF5IUGAaQjj98xtmHnZGhilmnRVEw&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=8&oh=00_AfzSA4eHnUjNEtqRWNS8-xo98FWIb6mJBVA5tOn8X2xSFg&oe=69C1384D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover-video.png", "id": "740381481685081", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499623569_740381485018414_2207102974461887046_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2Hk3CMZdZWsQ7kNvwES8IHS&_nc_oc=AdphgA_MpVnZTmfFvylmkMnRTf0CZG4scJ-XPl4N1GmuLf4uYWltCXJMnAQtyb6zly0&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=8&oh=00_Afzt6fehTvLd-nM_Fc8cXj11-H6fGF1slTiHSE7hqpR0fw&oe=69C12CF9"}, "display_name": "2bfit", "keywords": ["fit", "exercise", "fun", "stretch"], "long_description": "This is an easy way to exercise, especially the upper body.  You can focus longer and enjoy moving around when you can see balls to interact with.\nAfter a minute (or 60 seconds) you can feel my shoulders and arms a little bit.  And if you keep you feet in place (don't rotate), you can stretch more.  If you go through a wall, the 2bfit area moves along with you.  This makes it easy to stay in a clear area. Enjoy the burn.", "short_description": "To be fit, or not to be fit. That is the question. \nMove around and score points by catching balls that drop and rotate.\nOther balls just hang around. Try not moving your feet.  Don't forget the\nballs behind you.  See your surroundings while you get fit.  Move thru a wall to move your 2bfit area."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1lWHEKMjXnD5KMPReMX33Brbi3
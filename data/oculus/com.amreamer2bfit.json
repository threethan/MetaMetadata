scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfxTYgSbKUs3r-P3rBzqaG1fsH0ek8rsJlRO4lgoGhO2aw&oe=69B5443E"}, {"file_name": "screenshot-0.png", "id": "711374158163846", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491819934_711374161497179_5219986979726633511_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=86wZKGFBltAQ7kNvwGPW3Dt&_nc_oc=AdnXTjgVMcrOVLI1rqgrxvSY2_U6IIWO8jwvhd-vui3esXODk8oAZBFcyIBTbronzJQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfxtPlzDYLAC8U3zpkrnmK0lLqBRzqyfzNoFLmcTukA4gw&oe=69B55ACD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover-video.png", "id": "740381481685081", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499623569_740381485018414_2207102974461887046_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vmr_1mC1plIQ7kNvwGOYerv&_nc_oc=Adkd8jvvlZIp4ZNVlUH5peThQ2C7zLHDgR4hIVaYEyxJOW6q1BykB227GY8UPCHoZXE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfywPyRxC2m8Xz9VPzy2wLuAHO2Glcc3JnSS_QySy78Hyg&oe=69B54F79"}, "display_name": "2bfit", "keywords": ["fit", "exercise", "fun", "stretch"], "long_description": "This is an easy way to exercise, especially the upper body.  You can focus longer and enjoy moving around when you can see balls to interact with.\nAfter a minute (or 60 seconds) you can feel my shoulders and arms a little bit.  And if you keep you feet in place (don't rotate), you can stretch more.  If you go through a wall, the 2bfit area moves along with you.  This makes it easy to stay in a clear area. Enjoy the burn.", "short_description": "To be fit, or not to be fit. That is the question. \nMove around and score points by catching balls that drop and rotate.\nOther balls just hang around. Try not moving your feet.  Don't forget the\nballs behind you.  See your surroundings while you get fit.  Move thru a wall to move your 2bfit area."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1lWHEKMjXnD5KMPReMX33Brbi3
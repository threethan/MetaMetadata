7kNvwH1DCQa&_nc_oc=Adq5WM0EYX6VZAVp9WuuYkMdM7es1TvOi44AZFS2np4FdFPI_0HkrDP7_BByQQaRmkc&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG4PuaYSyOyFir--wJAMN-ez1JqAb5002gY8Yzls-E6zQ&oe=6A81BDF8"}, {"file_name": "2bfit-update1.png", "id": "1273832591007574", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/491827725_1273832594340907_7679835096266954535_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yRXd4X5V_1kQ7kNvwHDtW5C&_nc_oc=Adp3qE0lty9Aoi62lfTHjPrHrnCTZBm0bGkqMhcZLf4gE-kEcEQTrxf1XmtGqmKryso&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEvLfJxcgtaJ6e8jt1NKK2IjOLESCzSapxK-PRKdlbrtw&oe=6A81B48B"}, {"file_name": "2bfit-update3.png", "id": "4127365670925682", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/499307311_4127365674259015_7679022573858290498_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rGGX2ASV9r0Q7kNvwFuKXXb&_nc_oc=AdqHrXG-pSKx2CmdRSSrt4O8q3UZiP-rtDyyzEiD1FdAPyR4ZUG0giiLOJdNbfiRz8w&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEMMDgbI5o4EzJ1sli-L32ZeLCv6wx_Vh6Pyq4XUZuRzg&oe=6A81B0DB"}, {"file_name": "2bfit-update4.png", "id": "4236623229995296", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/491827718_4236623233328629_551381304740174737_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w3VbtvNRCQ8Q7kNvwGiKHP7&_nc_oc=AdqSyhxxeOLIO8QsEfZpA95clZfCp2FT0DbmWWS9Dq-GjszWGv0cemKNlQOxfIdm1i4&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGIhOR6GUpuJWJFAu12i_vHpDzsexk0LdUKVFEDFRROew&oe=6A81B6FF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover-video.png", "id": "740381481685081", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/499623569_740381485018414_2207102974461887046_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QLo4ZZBi4eMQ7kNvwFuENxa&_nc_oc=Ado42kzU4ycTU0e_Rk0n5O3ejMgGtkvb7uBl_-sSxRFqzGZCeUjfwZ8FYq5wtlvFNtQ&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHdzt4DX3KhmY-_NaoOJhSgbyNctqzwko7hlduEjrr0pA&oe=6A81A7F9"}, "display_name": "2bfit", "keywords": ["fit", "exercise", "fun", "stretch"], "long_description": "This is an easy way to exercise, especially the upper body.  You can focus longer and enjoy moving around when you can see balls to interact with.\nAfter a minute (or 60 seconds) you can feel my shoulders and arms a little bit.  And if you keep you feet in place (don't rotate), you can stretch more.  If you go through a wall, the 2bfit area moves along with you.  This makes it easy to stay in a clear area. Enjoy the burn.", "short_description": "To be fit, or not to be fit. That is the question. \nMove around and score points by catching balls that drop and rotate.\nOther balls just hang around. Try not moving your feet.  Don't forget the\nballs behind you.  See your surroundings while you get fit.  Move thru a wall to move your 2bfit area."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1lWHEKMjXnD5KMPReMX33Brbi3goEyEwAAFv75cz--QU/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "amre-amer.com", "support_website_url": null, "website_url": "https://amre-amer.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25023755790560223"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/491821954_2335969400139423_72605
content-ord5-3.oculuscdn.com&oh=00_AfvJ_H4YIjjqnrh_NlCVw0DKEFguVSJeYsylzPa1zD7fmA&oe=699C58F8"}, {"file_name": "2bfit-update1.png", "id": "1273832591007574", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491827725_1273832594340907_7679835096266954535_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pwFO4Jflp_sQ7kNvwGDtYsV&_nc_oc=AdkvJD69bD_SrF3xkmxix_tFl5wvYihHSBSDguTS1-eltXvexuWQFG2Nlf2jm-8KTu0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_Afvwn4Se8e1ulKwDfuuNHopbQ2nxzzwUlw1R6lc59zTRWw&oe=699C4F8B"}, {"file_name": "2bfit-update3.png", "id": "4127365670925682", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499307311_4127365674259015_7679022573858290498_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2EfqzqXRi8wQ7kNvwEJQqbq&_nc_oc=Adm0wkXbQXcYflH87ohcqF87fZLS6Znfs-ghJDWxolbAsJ9ll097C6PaiKxX9DoV7xA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_AftT8_-j4zORsGUJVQxDkEfwY0Y3iUZYCioPlOXOBRSAJA&oe=699C4BDB"}, {"file_name": "2bfit-update4.png", "id": "4236623229995296", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491827718_4236623233328629_551381304740174737_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D6TLml0YG6AQ7kNvwGFCcuc&_nc_oc=AdmZfE8CldvpfGakNi3aRlXXAR9tvR-mJbO8DF6AQdqg5IrrgYm9oCuUyd-gJej3aD4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AfuacJVcwbehmcJfHB2fMRZkLC4I9lnMOtr8z3MOBco5eQ&oe=699C51FF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover-video.png", "id": "740381481685081", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499623569_740381485018414_2207102974461887046_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RbPabhjPgrIQ7kNvwGFs-iX&_nc_oc=Adkz3XEZMDnbBfKeyA2WD6Wjj0kCp9p6OTq324M-BWQSMcLg-GcLPsK0tU6TB4c-o90&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_Aft4qMQj5cbQ2YLOzhkRatx-OFPkZYJXdpd9g6yDiAuM1g&oe=699C42F9"}, "display_name": "2bfit", "keywords": ["fit", "exercise", "fun", "stretch"], "long_description": "This is an easy way to exercise, especially the upper body.  You can focus longer and enjoy moving around when you can see balls to interact with.\nAfter a minute (or 60 seconds) you can feel my shoulders and arms a little bit.  And if you keep you feet in place (don't rotate), you can stretch more.  If you go through a wall, the 2bfit area moves along with you.  This makes it easy to stay in a clear area. Enjoy the burn.", "short_description": "To be fit, or not to be fit. That is the question. \nMove around and score points by catching balls that drop and rotate.\nOther balls just hang around. Try not moving your feet.  Don't forget the\nballs behind you.  See your surroundings while you get fit.  Move thru a wall to move your 2bfit area."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1lWHEKMjXnD5KMPReMX33Brbi3goEyEwAAFv75cz--QU/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "amre-amer.com", "support_website_url": null, "website_url": "https://amre-amer.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25023755790560223"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491821954_2335969400139423_7260507335481471188_n.png?stp=dst-png_s360x360&_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cUVp6oPj2o4Q7kNvwEpYHnA&_nc_oc=AdlUcexD98dPU_cH5kq61PLI_CTDGypXDLIz9nYYXYsjsROVrRxCn
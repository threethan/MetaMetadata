7kNvwEcTps2&_nc_oc=Adp4-oTf2W07-tSzxODyMt0Ergz_vpTsk_ING9vIe-Dxrsil0zhGOIda6UVUiK218Ao&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFesrRhBEKvI5CPO7vE6lr5Deecs7LeQRHRg2NeGKeTwA&oe=6A7F1AF8"}, {"file_name": "2bfit-update1.png", "id": "1273832591007574", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491827725_1273832594340907_7679835096266954535_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fxE3w-nT8YgQ7kNvwEVpp8R&_nc_oc=AdrYgQYuQuXWQmLJOuWh53zI62CIz5RIDiDBOiy9ZRSLQGUnAe-UgS4cgplzXGb4SYg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGjWJ6-Gdn3KyNBtbl_OGnPIWuPMfIttImhf0dejsaaAQ&oe=6A7F118B"}, {"file_name": "2bfit-update3.png", "id": "4127365670925682", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499307311_4127365674259015_7679022573858290498_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MDkgD8JgDkkQ7kNvwHdzc3G&_nc_oc=Adq52X87heYPq2pA-G0-glBWrqNxUlsxVaI2VotkoxpIekz2lzNn1zRU_4eUsdcF2Fw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGvG2qy-cXAdMLOsfxEbWEpr1nExjTUD61N0XvdRpbs7g&oe=6A7F0DDB"}, {"file_name": "2bfit-update4.png", "id": "4236623229995296", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491827718_4236623233328629_551381304740174737_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w3VbtvNRCQ8Q7kNvwG-FBiS&_nc_oc=AdoyUcOw41Zj_y7p1Nan0Fxv-CpT_0TcEac07Ac2jXQCtqwDJbSriAxnNKSoA6tHWOM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEiKpYvu4B_cEwnG2I3Qe8vM7PMKIrX2ZJL-Q_3pilsGA&oe=6A7F13FF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover-video.png", "id": "740381481685081", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499623569_740381485018414_2207102974461887046_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Yq1bXh-8T60Q7kNvwEVaDmP&_nc_oc=AdqYnlZskFNhW5JwEY3bzwz7ZK5oAXIsX0WdDqpZVbEFtYXXhE4ERXAZ0wMFiMw1Km4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEVBM4hhaU2O66NBrtd0wAJwBS_lTWGH3wFWyS7qMFQJg&oe=6A7F04F9"}, "display_name": "2bfit", "keywords": ["fit", "exercise", "fun", "stretch"], "long_description": "This is an easy way to exercise, especially the upper body.  You can focus longer and enjoy moving around when you can see balls to interact with.\nAfter a minute (or 60 seconds) you can feel my shoulders and arms a little bit.  And if you keep you feet in place (don't rotate), you can stretch more.  If you go through a wall, the 2bfit area moves along with you.  This makes it easy to stay in a clear area. Enjoy the burn.", "short_description": "To be fit, or not to be fit. That is the question. \nMove around and score points by catching balls that drop and rotate.\nOther balls just hang around. Try not moving your feet.  Don't forget the\nballs behind you.  See your surroundings while you get fit.  Move thru a wall to move your 2bfit area."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1lWHEKMjXnD5KMPReMX33Brbi3goEyEwAAFv75cz--QU/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "amre-amer.com", "support_website_url": null, "website_url": "https://amre-amer.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25023755790560223"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491821954_2335969400139423_72605
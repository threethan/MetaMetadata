7kNvwGdo2x9&_nc_oc=AdonNNTjLLC05HN5O_HJsk16EDB_DtfNW-Bx-_segVfD-xZ5W2rnWUqgQ4bmDHqL4Q0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPJDGAdClghWgc42e7g_KofLJoasdZhp8XIQaqIK2dccw&oe=6ADF5878"}, {"file_name": "2bfit-update1.png", "id": "1273832591007574", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491827725_1273832594340907_7679835096266954535_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9lWkDoClrdAQ7kNvwEAB5kg&_nc_oc=Adp3tfXh-QAhzw9qEVJ5MXErZL9zvfv_1rtfGSxLldd7bDD-XvQYZUU2IjPde4dNaQQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMxYcx44Sd_JtZ3Io-AFXeyGEBli7-KKXJJ9EnXrivEyA&oe=6ADF4F0B"}, {"file_name": "2bfit-update3.png", "id": "4127365670925682", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499307311_4127365674259015_7679022573858290498_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tDZtrBSD-KcQ7kNvwETFGg9&_nc_oc=AdoeJ6WYtsuhGxHxFQXMVsknuaXC2MAmcq1moSb2YsEr1eoLDhV0Ec_SEUM9T_vvEDU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP0VcTwXDzuEQkuC8JsLUxlBqRG0Ak2JFuQVceNSguXAg&oe=6ADF4B5B"}, {"file_name": "2bfit-update4.png", "id": "4236623229995296", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491827718_4236623233328629_551381304740174737_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PEMvKeXISc0Q7kNvwELqp5F&_nc_oc=AdqvZi4fBhGTM8XkonbWarZemsXD9VzJ65hjNMn_M5cXTNamd0YWVLP7-41w2ZtgzP8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOCym68EVay01AC_LxqAVzoZoG5M-HxzJMq2RcrU63i-w&oe=6ADF517F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover-video.png", "id": "740381481685081", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499623569_740381485018414_2207102974461887046_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Srr2KZB8lpEQ7kNvwHfSXjM&_nc_oc=Adow2Z_LPXr24NfLsuV8EgYJiwL4-cN3PwYMylFgJq7hzN3Ix-yPz4_vwOBBdRyOojs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMvQjjiPWBfyZy2y8QN5xSdZS4eZVh1K6MNH6HE0N2x1w&oe=6ADF7AB9"}, "display_name": "2bfit", "keywords": ["fit", "exercise", "fun", "stretch"], "long_description": "This is an easy way to exercise, especially the upper body.  You can focus longer and enjoy moving around when you can see balls to interact with.\nAfter a minute (or 60 seconds) you can feel my shoulders and arms a little bit.  And if you keep you feet in place (don't rotate), you can stretch more.  If you go through a wall, the 2bfit area moves along with you.  This makes it easy to stay in a clear area. Enjoy the burn.", "short_description": "To be fit, or not to be fit. That is the question. \nMove around and score points by catching balls that drop and rotate.\nOther balls just hang around. Try not moving your feet.  Don't forget the\nballs behind you.  See your surroundings while you get fit.  Move thru a wall to move your 2bfit area."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1lWHEKMjXnD5KMPReMX33Brbi3goEyEwAAFv75cz--QU/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "amre-amer.com", "support_website_url": null, "website_url": "https://amre-amer.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25023755790560223"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491821954_2335969400139423_72605
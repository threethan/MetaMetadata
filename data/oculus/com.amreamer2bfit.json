/491819934_711374161497179_5219986979726633511_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nq1GOqJeKIsQ7kNvwHCapMV&_nc_oc=Adky6eMZ2ylFNbq8JZWS3zPlHagS2W8kiIJ8vzfBXPs-TJnoeii-FGptdbdEY9XDfqA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AftxGGXedJWFI99TM27uw-LwAnB0KvPGApuZjTed43X28g&oe=69A042CD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover-video.png", "id": "740381481685081", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499623569_740381485018414_2207102974461887046_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9hRZrdtM9HEQ7kNvwHionGn&_nc_oc=Admq00xAOXF-mOUuaUkeX2izGJv6hAOCJdq3Fd8AJtf07BeBlfwE1EuO-vkBErKYwu0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AftI2T6QMkoh-ty-l8rWvOiRDYRo65xBiEv285v3Eb-QfA&oe=69A03779"}, "display_name": "2bfit", "keywords": ["fit", "exercise", "fun", "stretch"], "long_description": "This is an easy way to exercise, especially the upper body.  You can focus longer and enjoy moving around when you can see balls to interact with.\nAfter a minute (or 60 seconds) you can feel my shoulders and arms a little bit.  And if you keep you feet in place (don't rotate), you can stretch more.  If you go through a wall, the 2bfit area moves along with you.  This makes it easy to stay in a clear area. Enjoy the burn.", "short_description": "To be fit, or not to be fit. That is the question. \nMove around and score points by catching balls that drop and rotate.\nOther balls just hang around. Try not moving your feet.  Don't forget the\nballs behind you.  See your surroundings while you get fit.  Move thru a wall to move your 2bfit area."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1lWHEKMjXnD5KMPReMX33Brbi3goEyEwAAFv75cz--QU/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "amre-amer.com", "support_website_url": null, "website_url": "https://amre-amer.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", 
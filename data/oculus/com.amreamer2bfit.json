7kNvwGfHE_L&_nc_oc=Ado_zgPXVVRvelXgHSloSG8WdV4F_Lp-q2MPOyQuBJWYjWlIpPT_r2syAKvW-SKrnt8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKzhYGiVDgM9f5Z3lv5awE1IR4TcreO11S86js2rRePeQ&oe=6ABA6E78"}, {"file_name": "2bfit-update1.png", "id": "1273832591007574", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491827725_1273832594340907_7679835096266954535_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TYi1DpG19WcQ7kNvwHSNBT2&_nc_oc=AdpkUbsBWgiA2TprSzeBYMGQzjW9GDqdjgdb9YI40LemJjY4DxlR8ThCRvTIljqrHJk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKED-xGY1IYQDc9bU74qWUbJFSO0ZyeLCsq7bCM73V6aQ&oe=6ABA650B"}, {"file_name": "2bfit-update3.png", "id": "4127365670925682", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499307311_4127365674259015_7679022573858290498_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tLadRtHPLJ0Q7kNvwEoHo1N&_nc_oc=Adqp_tIwsxbo8iZGwHuueOWOxFGwa1D4l1bT6I1xkpgxe3scGXh6pQl3YEbxf1iL8ew&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJFdK5kO-DlCkNXfs0yJ7D2oUsuFbdj_UWJY6kGk-BUHg&oe=6ABA615B"}, {"file_name": "2bfit-update4.png", "id": "4236623229995296", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491827718_4236623233328629_551381304740174737_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=p10nVnZkhpgQ7kNvwER4tBr&_nc_oc=Adpf2lB2v1J37yY-rmyPWdmt63-n-UldwLgl6erefIxvd87oY5jqoSVexF1UiRgcgzU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLsePQckqVfBM4Y6eKKbvupatRBdYeFVKVcv_QIh2WIWQ&oe=6ABA677F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover-video.png", "id": "740381481685081", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499623569_740381485018414_2207102974461887046_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Zzhm6pV_5YQQ7kNvwF8cJ7o&_nc_oc=Adq2RAb5fLgA3yWEzFtx2GJ6nZDuahoi6vOm3yHRKP2nBVba48yJS7zgNCI1ErfaDVU&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJPgtWdCQK3exN_Ny0vF6yZj5cCws8R_fMQEobPb8ekTA&oe=6ABA90B9"}, "display_name": "2bfit", "keywords": ["fit", "exercise", "fun", "stretch"], "long_description": "This is an easy way to exercise, especially the upper body.  You can focus longer and enjoy moving around when you can see balls to interact with.\nAfter a minute (or 60 seconds) you can feel my shoulders and arms a little bit.  And if you keep you feet in place (don't rotate), you can stretch more.  If you go through a wall, the 2bfit area moves along with you.  This makes it easy to stay in a clear area. Enjoy the burn.", "short_description": "To be fit, or not to be fit. That is the question. \nMove around and score points by catching balls that drop and rotate.\nOther balls just hang around. Try not moving your feet.  Don't forget the\nballs behind you.  See your surroundings while you get fit.  Move thru a wall to move your 2bfit area."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1lWHEKMjXnD5KMPReMX33Brbi3goEyEwAAFv75cz--QU/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "amre-amer.com", "support_website_url": null, "website_url": "https://amre-amer.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25023755790560223"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491821954_2335969400139423_72605
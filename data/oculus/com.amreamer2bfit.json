7kNvwG2RVuL&_nc_oc=AdpudNCSLdqZcLe06DIy8lnRW3XeXeI8R0v6rnd25gYZi1bkv5-jUMMhpmdCBG45CQU&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-T69KN-8AknclA1eVT8AKOaAZmHgJUtUf1ej5PlCF7Ww&oe=6A32A3F8"}, {"file_name": "2bfit-update1.png", "id": "1273832591007574", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/491827725_1273832594340907_7679835096266954535_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YNNPlif52lYQ7kNvwGpIOZK&_nc_oc=Adq8W9PRM-pRyz8booVCX5tLhcRgrz1hJLzvDkaiZtBUipLLdqJQMIYP8Hx7DVVH6jQ&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af95bZiA51u-vv8tms8M8NJfVTZIP1bJXWS52AClKz70Xw&oe=6A329A8B"}, {"file_name": "2bfit-update3.png", "id": "4127365670925682", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/499307311_4127365674259015_7679022573858290498_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BGph5V4-R_UQ7kNvwGn7Sf8&_nc_oc=Adr2zXgYWxxdiaWRq5F6y_1zPW5oKP77rpWSR0PPblSm7XsntSrx0P0dWbtYfs3_42s&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-brst_mupxvwUARmxKjXILN3Hcnj25yO66ODgr_84a3Q&oe=6A3296DB"}, {"file_name": "2bfit-update4.png", "id": "4236623229995296", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/491827718_4236623233328629_551381304740174737_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LFFDXssR458Q7kNvwHxrzpo&_nc_oc=AdrS5aCVcl6v3DeOP7BzN_HGSBv_GmGoKmZj8MpokN0ZubfeniEizNv4IgeTOMwMg5Q&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8NPMIri-J8ZBw6YnDt01OEmZ1XBUuzIT6N8mMmBJzW0Q&oe=6A329CFF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover-video.png", "id": "740381481685081", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/499623569_740381485018414_2207102974461887046_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Zx5RgMh1AY8Q7kNvwH8yJGB&_nc_oc=AdoFOIwCijWSqCXX6ewdQkJbbdjSc9atNH-Q7VEjWqOit57wYEm9KTWoKDpSqxAZo2w&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af82SCH8iIPF1h3ohxwaO3Xpxtaw63z9Mi0tD_JNk9CvNA&oe=6A32C639"}, "display_name": "2bfit", "keywords": ["fit", "exercise", "fun", "stretch"], "long_description": "This is an easy way to exercise, especially the upper body.  You can focus longer and enjoy moving around when you can see balls to interact with.\nAfter a minute (or 60 seconds) you can feel my shoulders and arms a little bit.  And if you keep you feet in place (don't rotate), you can stretch more.  If you go through a wall, the 2bfit area moves along with you.  This makes it easy to stay in a clear area. Enjoy the burn.", "short_description": "To be fit, or not to be fit. That is the question. \nMove around and score points by catching balls that drop and rotate.\nOther balls just hang around. Try not moving your feet.  Don't forget the\nballs behind you.  See your surroundings while you get fit.  Move thru a wall to move your 2bfit area."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1lWHEKMjXnD5KMPReMX33Brbi3goEyEwAAFv75cz--QU/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "amre-amer.com", "support_website_url": null, "website_url": "https://amre-amer.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25023755790560223"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/491821954_2335969400139423_72605
7kNvwHeZuY9&_nc_oc=Adrjchh81L7P5_AjTHVFwZIL9tx-MTmjBuvg8Znt9OgbLKncfuN-9EP0UD9XG8axM7U&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDNU1eylosQ55gHGqH7qi-ZvrFw1Az8mPQWT2JPiOQ9Xg&oe=6A54EAF8"}, {"file_name": "2bfit-update1.png", "id": "1273832591007574", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/491827725_1273832594340907_7679835096266954535_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wFtE5EhVoCwQ7kNvwFIi9Qa&_nc_oc=Adoa0VIZVWrC4pAniCghLtVN2IeYnz8ih_9Hoj8s6GUCsSZ29Ik1vG7PVMf9fkgdO2o&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDisBYqfR-CY_x3TAi1ikMOnAwdeQt7Nq7b-_1kwbU4dA&oe=6A54E18B"}, {"file_name": "2bfit-update3.png", "id": "4127365670925682", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/499307311_4127365674259015_7679022573858290498_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NNMNxdcMJ0IQ7kNvwEsJzvY&_nc_oc=Adp5xfVl-OoS_LWuHrwDC9W90_Ojtdetn_5Vxktc7vkxWfQNNTSHORUYafALOdX_L4M&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBcn87b0ZFgbU0-HsTDIL843qHIU4kiH2k5TBOEU3t5fw&oe=6A54DDDB"}, {"file_name": "2bfit-update4.png", "id": "4236623229995296", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491827718_4236623233328629_551381304740174737_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=thOahrEBpV8Q7kNvwHny2EP&_nc_oc=Adr5rATJl8S2Rj9Ya1DkPm0zzIslSTEFeOy8nZdpAdVMezItQbH8lo7tW3GV6icmHsY&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCBPhP3Q4xCNr4u8GSF1w0i6Rh_Q_uKTUsMOyS3Sc_vpA&oe=6A54E3FF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover-video.png", "id": "740381481685081", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499623569_740381485018414_2207102974461887046_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UuRzhkgovY8Q7kNvwHfCiLk&_nc_oc=AdqWcDKGHsaO2uqlZUueh4ND9Vbp0Guscr5LqL-XJQO7tOmkU-G9Sv-2E3NcU1Yb00o&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDZHccM5O6LQe5li0sAseaxrc3NJtSnkBQwl3BgHZmpuQ&oe=6A54D4F9"}, "display_name": "2bfit", "keywords": ["fit", "exercise", "fun", "stretch"], "long_description": "This is an easy way to exercise, especially the upper body.  You can focus longer and enjoy moving around when you can see balls to interact with.\nAfter a minute (or 60 seconds) you can feel my shoulders and arms a little bit.  And if you keep you feet in place (don't rotate), you can stretch more.  If you go through a wall, the 2bfit area moves along with you.  This makes it easy to stay in a clear area. Enjoy the burn.", "short_description": "To be fit, or not to be fit. That is the question. \nMove around and score points by catching balls that drop and rotate.\nOther balls just hang around. Try not moving your feet.  Don't forget the\nballs behind you.  See your surroundings while you get fit.  Move thru a wall to move your 2bfit area."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1lWHEKMjXnD5KMPReMX33Brbi3goEyEwAAFv75cz--QU/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "amre-amer.com", "support_website_url": null, "website_url": "https://amre-amer.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25023755790560223"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491821954_2335969400139423_72605
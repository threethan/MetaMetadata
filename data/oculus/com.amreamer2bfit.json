7kNvwETM3Cf&_nc_oc=Adr7WpMcPP0nLydt5KqoK32mTjQMF-2XQf6GJk9hHd2KTOLVE1ocDtMXStsh8dQt7a8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3i9XEpja6OWrMJ8c7qIfh2Cldo04cVJdjWGF0NuNe5bw&oe=69DA4F78"}, {"file_name": "2bfit-update1.png", "id": "1273832591007574", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491827725_1273832594340907_7679835096266954535_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=beLqeiZcrYYQ7kNvwExFfI0&_nc_oc=AdqlAlXkPy4voPC_NnKoskpn57eqtcaCcCzk_MGdB2HArK4A7oB3hnV9gvfmpDo8tYU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1V3mRINB0Akk-JAf6Jx1gD3ptkTmVEpzrTh-AtC5TGjw&oe=69DA460B"}, {"file_name": "2bfit-update3.png", "id": "4127365670925682", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499307311_4127365674259015_7679022573858290498_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Lzs6GMiFezsQ7kNvwHzcxsE&_nc_oc=AdogO8TliS9njiSMoKTp3G-gkGv76OEvBWhjqV6068xnWrYp-SN9_tqo9vcVgdEurUY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0CiXIFP5nB_jTmDen10g7VRk4IHkRWhXgbgooewpyTPw&oe=69DA425B"}, {"file_name": "2bfit-update4.png", "id": "4236623229995296", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491827718_4236623233328629_551381304740174737_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z1p3TvXKy4UQ7kNvwErnyrI&_nc_oc=Ado4ddm_2W0dHbhesoad6I9geMApbt37ELYEIz4_PwALRoeHbwZ8sjHR81CA09SxWFI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1O5TVG3F6ybmLuS32QfzZK6AJpIiIOAkhEMKl3tLWXwA&oe=69DA487F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover-video.png", "id": "740381481685081", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499623569_740381485018414_2207102974461887046_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PXYcuz4HK-sQ7kNvwGAV6K4&_nc_oc=Adow9gllHe1LXMrsJpObM4eI2waQO83LPN8DWuA3pqgU5ug65KFRSiJJ1He9Th_T-cU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2chPyuzEQ9uLA0dQfyiwEeuacCPRCNdG5Zx0aiBgWaYA&oe=69DA3979"}, "display_name": "2bfit", "keywords": ["fit", "exercise", "fun", "stretch"], "long_description": "This is an easy way to exercise, especially the upper body.  You can focus longer and enjoy moving around when you can see balls to interact with.\nAfter a minute (or 60 seconds) you can feel my shoulders and arms a little bit.  And if you keep you feet in place (don't rotate), you can stretch more.  If you go through a wall, the 2bfit area moves along with you.  This makes it easy to stay in a clear area. Enjoy the burn.", "short_description": "To be fit, or not to be fit. That is the question. \nMove around and score points by catching balls that drop and rotate.\nOther balls just hang around. Try not moving your feet.  Don't forget the\nballs behind you.  See your surroundings while you get fit.  Move thru a wall to move your 2bfit area."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1lWHEKMjXnD5KMPReMX33Brbi3goEyEwAAFv75cz--QU/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "amre-amer.com", "support_website_url": null, "website_url": "https://amre-amer.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25023755790560223"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491821954_2335969400139423_72605
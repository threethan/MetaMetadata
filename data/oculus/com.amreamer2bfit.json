7kNvwGaDYFi&_nc_oc=AdqHsO6erhoWldpxK7u0e4voJnna2WwdRFpWh_dYtn8bej9HSxJvX8gBWbFnhv0d-nA&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAMsRvG-mc4l2OiOE9svC7JIrziZzL206AFssuKpTmDng&oe=6A563C78"}, {"file_name": "2bfit-update1.png", "id": "1273832591007574", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/491827725_1273832594340907_7679835096266954535_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wFtE5EhVoCwQ7kNvwHf7L27&_nc_oc=Ado4o-AYFhA6-ntKkjuiYAfMZcxq8LM7qaDyQVs4GG0RUWJGADl9ri0Zr2InDM-fxGE&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAGYV1xuu6KgI86Psm1Fd8RTRTPp4TfrdHHm5Ff5yN7zA&oe=6A56330B"}, {"file_name": "2bfit-update3.png", "id": "4127365670925682", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/499307311_4127365674259015_7679022573858290498_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0bcg8LIV6BcQ7kNvwGbsSWT&_nc_oc=AdqHlKz_T0V1DxToni7oySQm9Bq9uM6xPyblVkGvB5P9hnRrGkHtt2VIGD1WiFCBZrg&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBdyWCm_BZ1hKAAF0NIC5UfmdNjzc6luFrHPhnMngcwPg&oe=6A562F5B"}, {"file_name": "2bfit-update4.png", "id": "4236623229995296", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/491827718_4236623233328629_551381304740174737_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=thOahrEBpV8Q7kNvwFIDvjW&_nc_oc=AdrTqEWrYkbBUEs8CqRSmzdybiSmL7zral7Q1NEmOUE58zCrCdC5SthEvDJLCCDPoU0&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBd4dpz2frgA7D-8N6-UFwgG7At6IILGUbDTjVkClhPEw&oe=6A56357F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover-video.png", "id": "740381481685081", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/499623569_740381485018414_2207102974461887046_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UuRzhkgovY8Q7kNvwFHGPjM&_nc_oc=AdqnX64OWytQdH_DRimU2ZOQD883_aeKpKUWEULdLcYM4JV32cyxc2GN3NXnPc4xe9o&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA8CDOFcsaE8X5UAyZTKxgIwLljrRIJzXZViVPoX31EdQ&oe=6A562679"}, "display_name": "2bfit", "keywords": ["fit", "exercise", "fun", "stretch"], "long_description": "This is an easy way to exercise, especially the upper body.  You can focus longer and enjoy moving around when you can see balls to interact with.\nAfter a minute (or 60 seconds) you can feel my shoulders and arms a little bit.  And if you keep you feet in place (don't rotate), you can stretch more.  If you go through a wall, the 2bfit area moves along with you.  This makes it easy to stay in a clear area. Enjoy the burn.", "short_description": "To be fit, or not to be fit. That is the question. \nMove around and score points by catching balls that drop and rotate.\nOther balls just hang around. Try not moving your feet.  Don't forget the\nballs behind you.  See your surroundings while you get fit.  Move thru a wall to move your 2bfit area."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1lWHEKMjXnD5KMPReMX33Brbi3goEyEwAAFv75cz--QU/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "amre-amer.com", "support_website_url": null, "website_url": "https://amre-amer.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25023755790560223"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/491821954_2335969400139423_72605
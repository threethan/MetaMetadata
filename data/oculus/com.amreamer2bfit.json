j6P1&_nc_oc=Adotj_wZHMZmON4X_ZgZrRIgss24gUruqBTGdT9T3SLugNgoFyldEqTjSwGp5KD0RFg&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af43ObCmSsQ39K9FTsKAc8cx5Xg5V8ftM2QTHilF-tN5Sg&oe=6A185CFE"}, {"file_name": "screenshot-0.png", "id": "711374158163846", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491819934_711374161497179_5219986979726633511_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I9zTEsismUIQ7kNvwHTxSEJ&_nc_oc=AdoXQwnNLZVl_hALXhI_mXfl4MqMUdB3Yur0ILVHb_uNEsQB7V-2baU7Uj3rUbprMnk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6WcsQEMjPMU6ZuOi-FSRnc6SGAB-6asB-JFHe54s_mQQ&oe=6A183B4D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover-video.png", "id": "740381481685081", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499623569_740381485018414_2207102974461887046_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8NiRcWtC3MEQ7kNvwHRr0i6&_nc_oc=AdrG-MPacz3EAVKCQm1aib8RodObjVRjC0pQyFKDF_lozAWwdQUoaJLVbMR5mP1qQm0&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7QAEuW2Wv9PgdxMAw4-6J04ueTs-vRXyQQi_MKyi7dTg&oe=6A186839"}, "display_name": "2bfit", "keywords": ["fit", "exercise", "fun", "stretch"], "long_description": "This is an easy way to exercise, especially the upper body.  You can focus longer and enjoy moving around when you can see balls to interact with.\nAfter a minute (or 60 seconds) you can feel my shoulders and arms a little bit.  And if you keep you feet in place (don't rotate), you can stretch more.  If you go through a wall, the 2bfit area moves along with you.  This makes it easy to stay in a clear area. Enjoy the burn.", "short_description": "To be fit, or not to be fit. That is the question. \nMove around and score points by catching balls that drop and rotate.\nOther balls just hang around. Try not moving your feet.  Don't forget the\nballs behind you.  See your surroundings while you get fit.  Move thru a wall to move your 2bfit area."}]}, "developer
7kNvwFxfZpQ&_nc_oc=AdrYRKUaqAdbQspyCf12N_h60u5B0JN74VV9emujdP36cv3Be8A4-sD9Ki42x6jXXlw&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPDWMj2r7-bEYzVUHrkj8UpnAFn_oYoQes1TgcR3ZQ0cg&oe=6AD3B338"}, {"file_name": "2bfit-update1.png", "id": "1273832591007574", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/491827725_1273832594340907_7679835096266954535_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D9AEP3FheTQQ7kNvwFvcrGS&_nc_oc=AdpJ7iO1t5it1SgGpcprtrHSitjx-3CRgKNIUi3VcJFVvTB_OjZ7aCA4rwpCFQ_hcZU&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNVTfkZgRnBHQhAaaG0tAvYVVGejqMchmGTnOlcgxlwnA&oe=6AD3A9CB"}, {"file_name": "2bfit-update3.png", "id": "4127365670925682", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499307311_4127365674259015_7679022573858290498_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BTqcK8ifCmIQ7kNvwFOl7sY&_nc_oc=AdoXUphXXDjLf0n5UyX7NZp5LvB01Vdqpua-ZkZoHtJN0srQSeryAGQWT26bgz4mDRs&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOBm0nB6gI-7j_UVreuwJyEXHr7LZRf8YQDLgMNkeHcTQ&oe=6AD3A61B"}, {"file_name": "2bfit-update4.png", "id": "4236623229995296", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/491827718_4236623233328629_551381304740174737_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jJCCUZ7JTVoQ7kNvwFQ3zf5&_nc_oc=Adrnna9_s5ih4CAM2E3QFLWDQoo3_Dqxd4c_JW3pzldUagZ53SneI7HAw18EnoKANTQ&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOW9RPLbQBjCF00fAJMiRHhSXZqCYO34p1nnHyJe0MJNQ&oe=6AD3AC3F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover-video.png", "id": "740381481685081", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499623569_740381485018414_2207102974461887046_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cq-S7UuiKBQQ7kNvwGW5Ca2&_nc_oc=Adp8DoD1y_26jBbU_qJzW6icpY5EQFpWSEN1KXLHyy7_Q06jvud10eeW0gYN-Y2pg38&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM4YymcoZcwVx8xeoLt0n5tW9OlXVNQtSeCfG9ZUNJzxA&oe=6AD39D39"}, "display_name": "2bfit", "keywords": ["fit", "exercise", "fun", "stretch"], "long_description": "This is an easy way to exercise, especially the upper body.  You can focus longer and enjoy moving around when you can see balls to interact with.\nAfter a minute (or 60 seconds) you can feel my shoulders and arms a little bit.  And if you keep you feet in place (don't rotate), you can stretch more.  If you go through a wall, the 2bfit area moves along with you.  This makes it easy to stay in a clear area. Enjoy the burn.", "short_description": "To be fit, or not to be fit. That is the question. \nMove around and score points by catching balls that drop and rotate.\nOther balls just hang around. Try not moving your feet.  Don't forget the\nballs behind you.  See your surroundings while you get fit.  Move thru a wall to move your 2bfit area."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1lWHEKMjXnD5KMPReMX33Brbi3goEyEwAAFv75cz--QU/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "amre-amer.com", "support_website_url": null, "website_url": "https://amre-amer.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25023755790560223"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/491821954_2335969400139423_72605
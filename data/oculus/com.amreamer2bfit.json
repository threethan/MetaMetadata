7kNvwF-ea4v&_nc_oc=AdomZn7561juV_fCP7vqJ3YWsn2u1AZvj0UM8XKsu_25F8HBlZZ85tm04LNVIpLQR9k&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af129yhRP69Nr2HHajK2Npg-oVPim3Ydrh5UCzHJF32Ecw&oe=69E8CFF8"}, {"file_name": "2bfit-update1.png", "id": "1273832591007574", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491827725_1273832594340907_7679835096266954535_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ra2Ge1ci7ogQ7kNvwEwBJlQ&_nc_oc=Adohzz7sgqC3Nv3S7b2tDrzop0WEeDu1armcWyqPRiCA8jpvkC9aCRAlmG9ifAwaL7w&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2lfibKYz9Xu9a40W979aYwVeLP0kHAVSPQ8LrjnP9qVA&oe=69E8C68B"}, {"file_name": "2bfit-update3.png", "id": "4127365670925682", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499307311_4127365674259015_7679022573858290498_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i5BHmGNPvQQQ7kNvwEYS2Fn&_nc_oc=Adog-yT2bs6Doq55-cvfSIHynCPL2aavAXYUFReN8X46QAxm6QHTAmsp_Gg7z6TvITA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1xwijePozO6_WRlOqYs3HHSQckdu-b0nystkdudAnQqQ&oe=69E8C2DB"}, {"file_name": "2bfit-update4.png", "id": "4236623229995296", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491827718_4236623233328629_551381304740174737_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wM5ONN1x7N4Q7kNvwGzmwmc&_nc_oc=Adrj_0aAaoNRUja_eb6pl5d5zZPdszejJ3hlUR1_kQirEECs6IpyRUbx8fS9MnOuz2o&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1ZTcsSibdV-EWSvi3l9U_j6wwqPkTTWgPvxfb3N2MV7A&oe=69E8C8FF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover-video.png", "id": "740381481685081", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499623569_740381485018414_2207102974461887046_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kRgREOUMtjgQ7kNvwEhErLY&_nc_oc=Adq-Y1XJ2TpJcczGdYeQjxnaFDeuHzY1luHRCDHP1Z2IqOIvKI3FpgALSzeY_s5li7E&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2MYo54zhMP3fJr2wS_FyEzy_CMlhtafRnlDGobH6xIYA&oe=69E8B9F9"}, "display_name": "2bfit", "keywords": ["fit", "exercise", "fun", "stretch"], "long_description": "This is an easy way to exercise, especially the upper body.  You can focus longer and enjoy moving around when you can see balls to interact with.\nAfter a minute (or 60 seconds) you can feel my shoulders and arms a little bit.  And if you keep you feet in place (don't rotate), you can stretch more.  If you go through a wall, the 2bfit area moves along with you.  This makes it easy to stay in a clear area. Enjoy the burn.", "short_description": "To be fit, or not to be fit. That is the question. \nMove around and score points by catching balls that drop and rotate.\nOther balls just hang around. Try not moving your feet.  Don't forget the\nballs behind you.  See your surroundings while you get fit.  Move thru a wall to move your 2bfit area."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1lWHEKMjXnD5KMPReMX33Brbi3goEyEwAAFv75cz--QU/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "amre-amer.com", "support_website_url": null, "website_url": "https://amre-amer.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25023755790560223"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491821954_2335969400139423_72605
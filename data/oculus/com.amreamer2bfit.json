ZhaT&_nc_oc=AdqIlMgWRrjWKqeUQ8sS357XHRINpBK5Ft_ivcERH1DZ2Aur338HwA9OkZOD9VgktOw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af40oG8sVGfr1udyEDAkpyF7uHCKBb2AMI4J9ysoicpM4w&oe=6A0DD0FE"}, {"file_name": "screenshot-0.png", "id": "711374158163846", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491819934_711374161497179_5219986979726633511_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iuWWmaULrpUQ7kNvwGCwoN-&_nc_oc=AdrvaMuplmVI9p-ZWCP_64JXYR_kKe0Eq8ObGgTZiDZm_jKtm72c40rAIwSMgoUwt4A&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6wqwOWoIDIIwtrU6k-Vs939R8DaBFgYm_S7nMGGxwI-A&oe=6A0DAF4D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover-video.png", "id": "740381481685081", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499623569_740381485018414_2207102974461887046_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zWBw2kIxokoQ7kNvwHzJXhX&_nc_oc=AdofvkeWLPfw7yb91h6MNrND3nqCax8UK4F7P89fRl9nknVAZQ8Mq_EHKA1ezWEwyYg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af53t8eEM_iMKiF3R2Xrn9ZxPM_3PcLtF-hlYMszl82GFQ&oe=6A0DA3F9"}, "display_name": "2bfit", "keywords": ["fit", "exercise", "fun", "stretch"], "long_description": "This is an easy way to exercise, especially the upper body.  You can focus longer and enjoy moving around when you can see balls to interact with.\nAfter a minute (or 60 seconds) you can feel my shoulders and arms a little bit.  And if you keep you feet in place (don't rotate), you can stretch more.  If you go through a wall, the 2bfit area moves along with you.  This makes it easy to stay in a clear area. Enjoy the burn.", "short_description": "To be fit, or not to be fit. That is the question. \nMove around and score points by catching balls that drop and rotate.\nOther balls just hang around. Try not moving your feet.  Don't forget the\nballs behind you.  See your surroundings while you get fit.  Move thru a wall to move your 2bfit area."}]}, "developer
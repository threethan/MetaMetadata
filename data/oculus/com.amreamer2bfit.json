7kNvwFeYHkG&_nc_oc=AdrTPRI7GhX6uvaY1ZK-8Fslk8upUWt4D0IWoHAQMGV15m2Ev-lhZQIvbWci9EDVKg4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTqjDJnBuZgrlV-t6xoDDfvLxSr8QoOlGX_yb6ysq9Jjw&oe=6AF47078"}, {"file_name": "2bfit-update1.png", "id": "1273832591007574", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491827725_1273832594340907_7679835096266954535_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PuBV_hO7buYQ7kNvwHT8qhX&_nc_oc=AdqzNfAt2rniZyVEDlBFiv2f6Si1NppY7aOsxJX9eoWq9mO4wai0HHVkST6Lr8vCXbY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQZTWah_dObpBbmmDvTu2sJSoJPJ_7uCAqCmFfuM6xppg&oe=6AF49F4B"}, {"file_name": "2bfit-update3.png", "id": "4127365670925682", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499307311_4127365674259015_7679022573858290498_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4c9pIJ0voZIQ7kNvwHAuZMF&_nc_oc=AdqvJt5aCEz0K-n2zBZTHH8YGDtPn2-U59aIzQL_ElkROSdPKoJr67nzAYdYQ1z7m44&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTBy3eGfS0OPMXxDbkCP6h6nv-fiWD9nO7OoL8qFwMu7A&oe=6AF49B9B"}, {"file_name": "2bfit-update4.png", "id": "4236623229995296", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491827718_4236623233328629_551381304740174737_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FUeKXvou6ywQ7kNvwFtl5RU&_nc_oc=AdqP2Nmlit0_V1CuwUK66TihM05AEfrGh03foPG44ftO2hynU2XYmKLT9UTAwHh_N9Q&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ1HBllZc0GZKBCMloaCGKTuUbhVAvD6rCEST0l4-Lc1w&oe=6AF4A1BF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover-video.png", "id": "740381481685081", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499623569_740381485018414_2207102974461887046_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JApkHHhc8VEQ7kNvwEmtbQg&_nc_oc=AdoTswcS0skEszyu25nKbI3U6fI9ybw93oQgfJJk_AY5kj2zMlkxJNfCd72mrtdR4ow&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ2KSYp_kTusU9oyZ0HYG0yhcYn7CtQxHdodwD_kB398g&oe=6AF492B9"}, "display_name": "2bfit", "keywords": ["fit", "exercise", "fun", "stretch"], "long_description": "This is an easy way to exercise, especially the upper body.  You can focus longer and enjoy moving around when you can see balls to interact with.\nAfter a minute (or 60 seconds) you can feel my shoulders and arms a little bit.  And if you keep you feet in place (don't rotate), you can stretch more.  If you go through a wall, the 2bfit area moves along with you.  This makes it easy to stay in a clear area. Enjoy the burn.", "short_description": "To be fit, or not to be fit. That is the question. \nMove around and score points by catching balls that drop and rotate.\nOther balls just hang around. Try not moving your feet.  Don't forget the\nballs behind you.  See your surroundings while you get fit.  Move thru a wall to move your 2bfit area."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1lWHEKMjXnD5KMPReMX33Brbi3goEyEwAAFv75cz--QU/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "amre-amer.com", "support_website_url": null, "website_url": "https://amre-amer.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25023755790560223"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491821954_2335969400139423_72605
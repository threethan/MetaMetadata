scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfvLE6wWesSd8kxJZHVbZdvbDCddJA3pOXSHZL6s1_Kl_Q&oe=69A966BE"}, {"file_name": "screenshot-0.png", "id": "711374158163846", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491819934_711374161497179_5219986979726633511_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_cZqc7jKNsUQ7kNvwEyd9UL&_nc_oc=Adkn852EgLzl0yURyAE8qQex7MncBF6ddL05NhGUZt0yD037ZgSIw8-H55Y_A1IpwyY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_Aft5BHK7J8C2uJ7zsamgyu4fse4NdGskENp-GJSdpQFJgw&oe=69A97D4D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover-video.png", "id": "740381481685081", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499623569_740381485018414_2207102974461887046_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DENbTKOPfw0Q7kNvwH8bw8q&_nc_oc=AdkIHX1EGvQI67QJc-bBxsP8cqodvMuLhGMyVk1vFAKUDvw79Dq62gzuzQoOgSr1Rh0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_Aft9_1o5y1xkLcmALuRYwReavYRMzUK-CNpDSOocIfMMzw&oe=69A971F9"}, "display_name": "2bfit", "keywords": ["fit", "exercise", "fun", "stretch"], "long_description": "This is an easy way to exercise, especially the upper body.  You can focus longer and enjoy moving around when you can see balls to interact with.\nAfter a minute (or 60 seconds) you can feel my shoulders and arms a little bit.  And if you keep you feet in place (don't rotate), you can stretch more.  If you go through a wall, the 2bfit area moves along with you.  This makes it easy to stay in a clear area. Enjoy the burn.", "short_description": "To be fit, or not to be fit. That is the question. \nMove around and score points by catching balls that drop and rotate.\nOther balls just hang around. Try not moving your feet.  Don't forget the\nballs behind you.  See your surroundings while you get fit.  Move thru a wall to move your 2bfit area."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1lWHEKMjXnD5KMPReMX33Brbi3
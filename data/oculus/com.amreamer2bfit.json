7kNvwGESmVM&_nc_oc=Adr1QcHNowKofRt5kPhfFcNI8hriyH3uJwEPJUqUj2WK4vOdPMFeDljjTrWov6vh_K8&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0eKY6kGhs0XM46-dDlothteRu8cl7s9QBfo5StU8c1Bw&oe=69D3B7F8"}, {"file_name": "2bfit-update1.png", "id": "1273832591007574", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491827725_1273832594340907_7679835096266954535_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w1D3UMHUW2QQ7kNvwEghdl4&_nc_oc=AdpsQpmRiZ4fynW3nQKmD2UyOaM1Nf6xwIHixeZlFFbfIANDiYsIdIe9xQ_LIYJc5S4&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1849zl9AuXdyEZI84jwiTCyAocm6iSXJ4b6gtn8zqPYQ&oe=69D3AE8B"}, {"file_name": "2bfit-update3.png", "id": "4127365670925682", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499307311_4127365674259015_7679022573858290498_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P-LOZEXtylYQ7kNvwEuqxyc&_nc_oc=Adofx2srySiJLbWawp8F2kIAbc5NrAUjCFle79l4oFRlSPEtvVZHPwt52Iatl2CiiUk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af18ZZZ_yFvB9T9mrSd_1dTfC9kC_KSQQuLy-GtDfbdkyg&oe=69D3AADB"}, {"file_name": "2bfit-update4.png", "id": "4236623229995296", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491827718_4236623233328629_551381304740174737_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d2Elccx-SxEQ7kNvwFSBRHd&_nc_oc=AdrH7x_Z7oCLefOg_qbz-hU4AvSKEKu4XBHhE4sM3v1iuU1uwUAUMJ6RBKBQvei6UqA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af36M4y2Nj2E05FSthrtqqeiNN5QQEPc0rBdPrkBq1lhmw&oe=69D3B0FF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover-video.png", "id": "740381481685081", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499623569_740381485018414_2207102974461887046_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1RogVxkQCg8Q7kNvwFRENN6&_nc_oc=Adpj-ZHIZDVToot1u3fIS3EIo_rraPRiMWe3i7XYY26_u2Wvmz-qOX0YqNUJdQs9vLs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1j6l5MkjWui9LQXVjdxMnTV8CADVAYBE4_Qy_GJp8F7A&oe=69D3A1F9"}, "display_name": "2bfit", "keywords": ["fit", "exercise", "fun", "stretch"], "long_description": "This is an easy way to exercise, especially the upper body.  You can focus longer and enjoy moving around when you can see balls to interact with.\nAfter a minute (or 60 seconds) you can feel my shoulders and arms a little bit.  And if you keep you feet in place (don't rotate), you can stretch more.  If you go through a wall, the 2bfit area moves along with you.  This makes it easy to stay in a clear area. Enjoy the burn.", "short_description": "To be fit, or not to be fit. That is the question. \nMove around and score points by catching balls that drop and rotate.\nOther balls just hang around. Try not moving your feet.  Don't forget the\nballs behind you.  See your surroundings while you get fit.  Move thru a wall to move your 2bfit area."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1lWHEKMjXnD5KMPReMX33Brbi3goEyEwAAFv75cz--QU/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "amre-amer.com", "support_website_url": null, "website_url": "https://amre-amer.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25023755790560223"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491821954_2335969400139423_72605
aDi3&_nc_oc=Adq2FXgA3EXrwl_8hxDLtftAQoXHSX0vFzK1G1JPobHLRVX6Z9hwVK3wUy606OvgN4o&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3JqfIvvyjw4oahdiNKfKfFmhH3wRskRYb989euHOizEA&oe=69EB89FE"}, {"file_name": "screenshot-0.png", "id": "711374158163846", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491819934_711374161497179_5219986979726633511_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=345iMteiW5UQ7kNvwGUbL6O&_nc_oc=AdpjbzeikPlC08x9D7E8VaIExGD7hiS0q-TQkgM8rgFVQcgWDDn3OuxtdULujpYwNtM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1nuwA9Gz85gkRdyX589voPluovslF3w45alsWgClyO4Q&oe=69EB684D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover-video.png", "id": "740381481685081", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499623569_740381485018414_2207102974461887046_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kLnfEcorhcgQ7kNvwGOOwfv&_nc_oc=Adrqr4_B89wWnnTcb4ZqDhKfUWO5xft3i-NoABqXa2XSL7sE0QyqFBll70bfDGZLrRo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3Y1wEqGYQS5r32xb3HHgN2_lN6JFBUTVNHxGFEpSFsYg&oe=69EB5CF9"}, "display_name": "2bfit", "keywords": ["fit", "exercise", "fun", "stretch"], "long_description": "This is an easy way to exercise, especially the upper body.  You can focus longer and enjoy moving around when you can see balls to interact with.\nAfter a minute (or 60 seconds) you can feel my shoulders and arms a little bit.  And if you keep you feet in place (don't rotate), you can stretch more.  If you go through a wall, the 2bfit area moves along with you.  This makes it easy to stay in a clear area. Enjoy the burn.", "short_description": "To be fit, or not to be fit. That is the question. \nMove around and score points by catching balls that drop and rotate.\nOther balls just hang around. Try not moving your feet.  Don't forget the\nballs behind you.  See your surroundings while you get fit.  Move thru a wall to move your 2bfit area."}]}, "developer
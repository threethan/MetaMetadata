-atl3-2.oculuscdn.com&oh=00_Af3l5l0rj6cBGvDPCRvR7lJz9Q3B4kILITcMMFzj0SRcjA&oe=69F1E93E"}, {"file_name": "screenshot-0.png", "id": "711374158163846", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/491819934_711374161497179_5219986979726633511_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A-LhG7JlJRsQ7kNvwHKVzCo&_nc_oc=AdpTfjybMZZhe_QDSVxc_6lM0F6soHBgChnW_kxGas8pxHkG5hWx_MdZUbr_qmr5z08&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3I5il42_HrGG5LpOPJ__eDBq16qy6fSiSIWQ5BygRFCQ&oe=69F1FFCD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover-video.png", "id": "740381481685081", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499623569_740381485018414_2207102974461887046_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3uLWII7BJeYQ7kNvwEDlmco&_nc_oc=AdoNvp5GR9rmSkrqWs2EeZGwlxX1diwwoSydrcBMHLb1OQOI85lt2Sdq20JGICEJY1U&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3iXRpX3vCYMjaRH2AYDs9L1sgrQHeAYHznkezV2NM5yw&oe=69F1F479"}, "display_name": "2bfit", "keywords": ["fit", "exercise", "fun", "stretch"], "long_description": "This is an easy way to exercise, especially the upper body.  You can focus longer and enjoy moving around when you can see balls to interact with.\nAfter a minute (or 60 seconds) you can feel my shoulders and arms a little bit.  And if you keep you feet in place (don't rotate), you can stretch more.  If you go through a wall, the 2bfit area moves along with you.  This makes it easy to stay in a clear area. Enjoy the burn.", "short_description": "To be fit, or not to be fit. That is the question. \nMove around and score points by catching balls that drop and rotate.\nOther balls just hang around. Try not moving your feet.  Don't forget the\nballs behind you.  See your surroundings while you get fit.  Move thru a wall to move your 2bfit area."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1lWHEKMjXnD5KMPReMX33Brbi3goEyEwAAF
lGsB&_nc_oc=Adof7A8TQt7WXiLHajuAj4pHqHrttlttcES9p3eu555QTysasaJWdQ2M2Y1RFpRAjcU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEK4lgIQtddgcagGHpX3CK6DRB9JxM9rTzTrdOmAywD1w&oe=6A73547E"}, {"file_name": "screenshot-0.png", "id": "711374158163846", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491819934_711374161497179_5219986979726633511_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3AAM0yug2BAQ7kNvwEZWfXF&_nc_oc=AdqsbwilatFCuH9gErYzkw5lSO-RP-F5gtl5ipJtCpppbXso6GQyapsUHtJv_DOjWH8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEJOsR-d18ZplznJuXsmWECzTsl3v8KTYSKB1aWUj8CFw&oe=6A7332CD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover-video.png", "id": "740381481685081", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499623569_740381485018414_2207102974461887046_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l5nYrAMEgQYQ7kNvwFJ8_XA&_nc_oc=AdpAc6HPEUNQFJrx5ayAI74HCg4sHQuTjVwhK4W9Ny54XhlhlGoSBRyYx4n5MZsVpuQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHsQqu7u_XAMm1OBi45SjqX_rUmj8orKMrXbZ-C2tz99g&oe=6A732779"}, "display_name": "2bfit", "keywords": ["fit", "exercise", "fun", "stretch"], "long_description": "This is an easy way to exercise, especially the upper body.  You can focus longer and enjoy moving around when you can see balls to interact with.\nAfter a minute (or 60 seconds) you can feel my shoulders and arms a little bit.  And if you keep you feet in place (don't rotate), you can stretch more.  If you go through a wall, the 2bfit area moves along with you.  This makes it easy to stay in a clear area. Enjoy the burn.", "short_description": "To be fit, or not to be fit. That is the question. \nMove around and score points by catching balls that drop and rotate.\nOther balls just hang around. Try not moving your feet.  Don't forget the\nballs behind you.  See your surroundings while you get fit.  Move thru a wall to move your 2bfit area."}]}, "developer
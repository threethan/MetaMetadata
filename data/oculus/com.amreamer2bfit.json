content-iad3-1.oculuscdn.com&oh=00_Afte4-_NKT47ZG78gRzTpoVkSLU4J-tsCPz_dMngBQJb0A&oe=69A6E4F8"}, {"file_name": "2bfit-update1.png", "id": "1273832591007574", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491827725_1273832594340907_7679835096266954535_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fbDL3myf1aQQ7kNvwEjdzHT&_nc_oc=AdlFQCxYXdJi6oj-XCrvKqF1Kdx19MhJu2UTygJRsCCncLRRuXL5l3qQb_BEsPGztD0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Aftn0C1TfLfH4nU4u-XP-kty2lVN40bo5NzNo9fzENfrNQ&oe=69A6DB8B"}, {"file_name": "2bfit-update3.png", "id": "4127365670925682", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499307311_4127365674259015_7679022573858290498_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7zZg7gZTxHsQ7kNvwFZiuYj&_nc_oc=AdkNcnUikGJqrnN0jbUmiDlpXftFLoY1i5O-IFk0vQcvZINs6LLkgqX0MSLL-K6Q7JM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afvk0DiE5TDZgV2fQmPGysuVERYAlXcmFp8-pZ5_k5Vauw&oe=69A6D7DB"}, {"file_name": "2bfit-update4.png", "id": "4236623229995296", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491827718_4236623233328629_551381304740174737_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5m9T8WMvCfwQ7kNvwFxHYs8&_nc_oc=Adm-UEifFzKQYH8V4TTUG7UT4WcvSXl4c31r7j4G9srgrCmaIK2l4eM_2m-lTqtpB90&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AftC_MuTMBeqnSteSv1y9myp3u2uk8Oeq5YpZZphE5Q3SQ&oe=69A6DDFF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover-video.png", "id": "740381481685081", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499623569_740381485018414_2207102974461887046_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DENbTKOPfw0Q7kNvwEBRGcQ&_nc_oc=Adk6s3sh_2J7KjqCxv0GDGf6rHCpITwnlfB9ICutJOeH5V06dEEOD8dnRjDw-R9iQhI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Aft4_X69nCqS1f5ZpwGbpoFF0DPrj_hGYsg1PnUaisObuw&oe=69A6CEF9"}, "display_name": "2bfit", "keywords": ["fit", "exercise", "fun", "stretch"], "long_description": "This is an easy way to exercise, especially the upper body.  You can focus longer and enjoy moving around when you can see balls to interact with.\nAfter a minute (or 60 seconds) you can feel my shoulders and arms a little bit.  And if you keep you feet in place (don't rotate), you can stretch more.  If you go through a wall, the 2bfit area moves along with you.  This makes it easy to stay in a clear area. Enjoy the burn.", "short_description": "To be fit, or not to be fit. That is the question. \nMove around and score points by catching balls that drop and rotate.\nOther balls just hang around. Try not moving your feet.  Don't forget the\nballs behind you.  See your surroundings while you get fit.  Move thru a wall to move your 2bfit area."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1lWHEKMjXnD5KMPReMX33Brbi3goEyEwAAFv75cz--QU/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "amre-amer.com", "support_website_url": null, "website_url": "https://amre-amer.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25023755790560223"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491821954_2335969400139423_7260507335481471188_n.png?stp=dst-png_s360x360&_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8qcTDjyLh6YQ7kNvwHRvvJl&_nc_oc=AdlMb_h53m1gviGsLGtwFiqa0ZPX5zbTi2O_ixh-SziiE1cNN1zgk
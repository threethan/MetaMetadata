scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfxPbc_P5iEhWpQetEwQCPXaPx9PekxawjG3z4AUPGbjQA&oe=69AD5B3E"}, {"file_name": "screenshot-0.png", "id": "711374158163846", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491819934_711374161497179_5219986979726633511_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F7pdFG9XbOsQ7kNvwE_90yj&_nc_oc=AdkTytgK74-GR7Jlaid1AV1JKT34tl7_SOvQY85WCMkLJasARvXTRx5JFTWaDhhMR7E&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfwFgTnz3SV1Tc_RjsM38bimr99DJ_216heLqpmfJXFrBQ&oe=69AD71CD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover-video.png", "id": "740381481685081", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499623569_740381485018414_2207102974461887046_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K18Oqwa4pdEQ7kNvwGWY1UR&_nc_oc=AdlPI2xBYTfEICVz8tsx6TVnrpVzLfYFCul28o0oJBJNIPIAK2bgf3SxA86giO4Zzd8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afz86HAdRjNv5PuqpfxgX0EIMpeQkndYyN-PnKPbXl9B6Q&oe=69AD6679"}, "display_name": "2bfit", "keywords": ["fit", "exercise", "fun", "stretch"], "long_description": "This is an easy way to exercise, especially the upper body.  You can focus longer and enjoy moving around when you can see balls to interact with.\nAfter a minute (or 60 seconds) you can feel my shoulders and arms a little bit.  And if you keep you feet in place (don't rotate), you can stretch more.  If you go through a wall, the 2bfit area moves along with you.  This makes it easy to stay in a clear area. Enjoy the burn.", "short_description": "To be fit, or not to be fit. That is the question. \nMove around and score points by catching balls that drop and rotate.\nOther balls just hang around. Try not moving your feet.  Don't forget the\nballs behind you.  See your surroundings while you get fit.  Move thru a wall to move your 2bfit area."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1lWHEKMjXnD5KMPReMX33Brbi3
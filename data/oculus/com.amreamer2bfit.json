7kNvwGGjNiR&_nc_oc=Adrl9ipNUIVd1mLWXtlJMJX9fC8gc-bjbCWgSAk3vBvC2tbMR74AjE2khBLAB4nZU3s&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_AgdIb7fvHSHbKGJWhjhjNbUPF-GjeBJjSPHIXzcLOrQ&oe=6A2D5DF8"}, {"file_name": "2bfit-update1.png", "id": "1273832591007574", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491827725_1273832594340907_7679835096266954535_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=feB7X1-SpaQQ7kNvwFkMxZF&_nc_oc=AdoS3tOHbJv7GLQi1R2PSADLj5hKQ12507NlHn8HKzLMNRHAEd2kMhTYwSbCvjoUIkw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9zZiqSJN0bFIX5qLnl2olgnn2z6kADhR2DvwqqBysNvQ&oe=6A2D548B"}, {"file_name": "2bfit-update3.png", "id": "4127365670925682", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499307311_4127365674259015_7679022573858290498_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2Cx43r6XojcQ7kNvwFtN2QU&_nc_oc=AdrK9F2Xoc-uC6-uv5dzgkT-wxZ2EOJD6885QxdKhY6CyEmddGlyW9S3jcuBi7CbJ9U&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_UFjzaMZejI6SA7s6Et3zU4VxIcaQN3BcU4T6dzKr-dw&oe=6A2D50DB"}, {"file_name": "2bfit-update4.png", "id": "4236623229995296", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491827718_4236623233328629_551381304740174737_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MioMTjRippQQ7kNvwG4naQ-&_nc_oc=AdoGwNZAuPR_zBIYWd8dNrdxttyqOwI3hV8fqJOM6SNkP7odQ6YEQhjGzOrkqBK7O98&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af83nh36qMBFPtE5v_8O1SSIbSzPE_ohFhqoa25zictHNg&oe=6A2D56FF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover-video.png", "id": "740381481685081", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499623569_740381485018414_2207102974461887046_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YN11HPSNWEcQ7kNvwHRFEiR&_nc_oc=Ado-OGgwqNwb-Eqr0Vg0SkOu-hyesamzXHWlruRQgRNiwHkAPuAwiL68bpnhAHP5waA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-1vPt8Vzqt_eBjhUvACe6ETa3Z3yWZQmg1c6OLj4rXfw&oe=6A2D47F9"}, "display_name": "2bfit", "keywords": ["fit", "exercise", "fun", "stretch"], "long_description": "This is an easy way to exercise, especially the upper body.  You can focus longer and enjoy moving around when you can see balls to interact with.\nAfter a minute (or 60 seconds) you can feel my shoulders and arms a little bit.  And if you keep you feet in place (don't rotate), you can stretch more.  If you go through a wall, the 2bfit area moves along with you.  This makes it easy to stay in a clear area. Enjoy the burn.", "short_description": "To be fit, or not to be fit. That is the question. \nMove around and score points by catching balls that drop and rotate.\nOther balls just hang around. Try not moving your feet.  Don't forget the\nballs behind you.  See your surroundings while you get fit.  Move thru a wall to move your 2bfit area."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1lWHEKMjXnD5KMPReMX33Brbi3goEyEwAAFv75cz--QU/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "amre-amer.com", "support_website_url": null, "website_url": "https://amre-amer.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25023755790560223"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491821954_2335969400139423_72605
0rl2&_nc_oc=AdpNgQ8DSAI85cdu6lG0ciz4YfRthT7m-UGmh7jVXsRMI3uDobSbI4-R6KhRblyKGog&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8ZoxCKS9XxQ-X7yOR_H6cREgSNGQ0v8pplJitIBaDm_g&oe=6A21977E"}, {"file_name": "screenshot-0.png", "id": "711374158163846", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/491819934_711374161497179_5219986979726633511_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y8xOyWvIO8EQ7kNvwGPt9Bc&_nc_oc=Adp4hYdFHBCPiTKVm8UzJOFnTQFeio9QAG6j2Oslj-ADxQrvo4oVBnuRntcWoQpBTyM&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_c9RraIDKTValmeIZ9abWeGCoK8VJhuQMVmlNhYs2sxw&oe=6A2175CD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover-video.png", "id": "740381481685081", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499623569_740381485018414_2207102974461887046_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j8uHOWDFjPQQ7kNvwFm_cLs&_nc_oc=AdqZfMtcQwTLZqVOmbvrPM4PDa20pCyFIwfFVZsvbJOSIKLnoTv3FPditqqCoE7jdaU&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_m9C50c2WXdd7xYE0SPS8VCmiEOQ08F0Klt30tHbeuCQ&oe=6A21A2B9"}, "display_name": "2bfit", "keywords": ["fit", "exercise", "fun", "stretch"], "long_description": "This is an easy way to exercise, especially the upper body.  You can focus longer and enjoy moving around when you can see balls to interact with.\nAfter a minute (or 60 seconds) you can feel my shoulders and arms a little bit.  And if you keep you feet in place (don't rotate), you can stretch more.  If you go through a wall, the 2bfit area moves along with you.  This makes it easy to stay in a clear area. Enjoy the burn.", "short_description": "To be fit, or not to be fit. That is the question. \nMove around and score points by catching balls that drop and rotate.\nOther balls just hang around. Try not moving your feet.  Don't forget the\nballs behind you.  See your surroundings while you get fit.  Move thru a wall to move your 2bfit area."}]}, "developer
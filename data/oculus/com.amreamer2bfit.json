79Wf&_nc_oc=AdrBJKiW2GE8YWRQt0TCvWTcX7Qg0nnSiM7FDGTKd08JAajllRTROdq94FKMnrY7xv8&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwwF8x6UeZnoixkFqFVa-XqC5X40nVlaDt6mtv5QM0rhA&oe=69CFA23E"}, {"file_name": "screenshot-0.png", "id": "711374158163846", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/491819934_711374161497179_5219986979726633511_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UIrP2MI8MCcQ7kNvwEvuaJO&_nc_oc=AdqSA7Wp5I96klrbdpovWGgiDPnl8KvRvbQUk0gaZBSNJydsE1TA5wbmaaPThAk9wXg&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzhpE1v8DoTGo4mMWU1KCTeH05uN6XIa7J2sV7yBwoorw&oe=69CFB8CD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover-video.png", "id": "740381481685081", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499623569_740381485018414_2207102974461887046_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TU3zrgQZs_cQ7kNvwEE3syG&_nc_oc=AdrUlhW1C68GaZzaa-Os4vkP6lKvinThlhVu88y_uMtzK2PIWb02znjDBzI0i0Jce58&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzEL6bxBkbR-c74Fl3cIdtaY1mtsRfxg9jqV97mF4XJ3g&oe=69CFAD79"}, "display_name": "2bfit", "keywords": ["fit", "exercise", "fun", "stretch"], "long_description": "This is an easy way to exercise, especially the upper body.  You can focus longer and enjoy moving around when you can see balls to interact with.\nAfter a minute (or 60 seconds) you can feel my shoulders and arms a little bit.  And if you keep you feet in place (don't rotate), you can stretch more.  If you go through a wall, the 2bfit area moves along with you.  This makes it easy to stay in a clear area. Enjoy the burn.", "short_description": "To be fit, or not to be fit. That is the question. \nMove around and score points by catching balls that drop and rotate.\nOther balls just hang around. Try not moving your feet.  Don't forget the\nballs behind you.  See your surroundings while you get fit.  Move thru a wall to move your 2bfit area."}]}, "developer
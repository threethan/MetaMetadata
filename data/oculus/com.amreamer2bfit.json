content-iad3-1.oculuscdn.com&oh=00_AfufmgiDl-nUM0QtrUfc4ZgLokyp5UkWffjh9Vklks7xvQ&oe=69A2F078"}, {"file_name": "2bfit-update1.png", "id": "1273832591007574", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491827725_1273832594340907_7679835096266954535_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IkW9pUppKGYQ7kNvwFa4PRz&_nc_oc=AdkLrY-Qb_l16ZZ5EqH1dUcISOs1RmR6_csm09M-XdWMrigsWipoz16EtyJQRzz5BBA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfuWQOjbPM52WlRuWXrDnrrXqmxuWOxIJBZEUxUrIa64TA&oe=69A2E70B"}, {"file_name": "2bfit-update3.png", "id": "4127365670925682", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499307311_4127365674259015_7679022573858290498_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a-VIi8abkz4Q7kNvwFSwseS&_nc_oc=AdmV3A7jbvlNqtSyiW5Sqox8i50JryJpZxVX327D-L4kNaiKbCJGjq-Sfqn4bpSnqiY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afv0hIPXLDOf91uCu-nqjf4kOACc0r9BAH64J-TbhuaVDA&oe=69A2E35B"}, {"file_name": "2bfit-update4.png", "id": "4236623229995296", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491827718_4236623233328629_551381304740174737_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xpIqK_8mi0MQ7kNvwGO2u1a&_nc_oc=AdnD41uOmn6zWaDEEqm3hh1kB24U_seFqgH_YKTF9FjQVbQI6-UpSqmyUSGc1t1Us10&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfsUS1F3ZFHs8uFXH2-B7Lf-hGBcumiwRDKG4FNMIdlCFQ&oe=69A2E97F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover-video.png", "id": "740381481685081", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499623569_740381485018414_2207102974461887046_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hornVAEM2V4Q7kNvwHLD3LX&_nc_oc=Adl94srSTu0oNQiQXMic__tuyXomvOd2Ccv6woUw20PZyrjWrhXiLhxc1Hj6Y88Q4Ls&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AftkSIUgzveBZx0W_vSontyHy7Dq65iENWr1QR1inA8M8w&oe=69A2DA79"}, "display_name": "2bfit", "keywords": ["fit", "exercise", "fun", "stretch"], "long_description": "This is an easy way to exercise, especially the upper body.  You can focus longer and enjoy moving around when you can see balls to interact with.\nAfter a minute (or 60 seconds) you can feel my shoulders and arms a little bit.  And if you keep you feet in place (don't rotate), you can stretch more.  If you go through a wall, the 2bfit area moves along with you.  This makes it easy to stay in a clear area. Enjoy the burn.", "short_description": "To be fit, or not to be fit. That is the question. \nMove around and score points by catching balls that drop and rotate.\nOther balls just hang around. Try not moving your feet.  Don't forget the\nballs behind you.  See your surroundings while you get fit.  Move thru a wall to move your 2bfit area."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1lWHEKMjXnD5KMPReMX33Brbi3goEyEwAAFv75cz--QU/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "amre-amer.com", "support_website_url": null, "website_url": "https://amre-amer.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25023755790560223"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491821954_2335969400139423_7260507335481471188_n.png?stp=dst-png_s360x360&_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8KtQUpPnAFAQ7kNvwGlWCMV&_nc_oc=AdkJFhR2PngPDNOVNtjOn7O6gEG2XCGWMR1ZFpa27X3pn8ZSQCU9g
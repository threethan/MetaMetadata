7kNvwFoHiEE&_nc_oc=AdrXny83bPhl2x63OPWTf1aFx-vszpbUdeZEoC35A7ncpAdx6VldHuG2FdsW55zZQkk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK3QrPoGFt18NDMn8Z__mcd8GCROv3XvlHyQWaOgMfzXA&oe=6A9C1BF8"}, {"file_name": "2bfit-update1.png", "id": "1273832591007574", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491827725_1273832594340907_7679835096266954535_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GHHI_mJhHiMQ7kNvwHBICN7&_nc_oc=AdqSNhv2Kq6MhCE692vmne99NN6oIrD9n3SWZIuT9a9s_vibCjoC8gbu-vJGBLSDY7I&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIY7K4fjr1BSY1cVgowQs1nLZjitrhQl5YTJpeU7YcnHQ&oe=6A9C128B"}, {"file_name": "2bfit-update3.png", "id": "4127365670925682", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499307311_4127365674259015_7679022573858290498_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r1wRZ3H3UjsQ7kNvwGcSL2T&_nc_oc=AdrGgt1P90CoC5MM9ccoyd932M7Z0pItaE9-bgdAWJM3UAHP2jh7YFlsc_PBb8UFY5Y&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIdwsDp8PbdNbmS1FYpk3FEv1As6EHG7DYY04YjGnNQRw&oe=6A9C0EDB"}, {"file_name": "2bfit-update4.png", "id": "4236623229995296", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491827718_4236623233328629_551381304740174737_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ExhrpQ_KrmYQ7kNvwGn5_6Y&_nc_oc=AdodOJkBoKawR2EOxIo4xwFf7zlRjk35dSE4Q-Kh2UEcT9CV58HkKInpFlFvktUQ8c0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKH-gjdT82gvAQFFz9tfex_ahat8OBMjiLCCcSq6opDeg&oe=6A9C14FF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover-video.png", "id": "740381481685081", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499623569_740381485018414_2207102974461887046_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=htOPBagxQfIQ7kNvwHXtbAT&_nc_oc=AdpCbhLi0N1v2w24qoMrr9Fj1OLAPRf9FNiV5HaZbnqjHXigQtZMy4PtiHxxNHdwn9o&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ14EnbUsIURpjLQhOZRUKQI7qhCSKe39RAeSCz5Xy5ig&oe=6A9C3E39"}, "display_name": "2bfit", "keywords": ["fit", "exercise", "fun", "stretch"], "long_description": "This is an easy way to exercise, especially the upper body.  You can focus longer and enjoy moving around when you can see balls to interact with.\nAfter a minute (or 60 seconds) you can feel my shoulders and arms a little bit.  And if you keep you feet in place (don't rotate), you can stretch more.  If you go through a wall, the 2bfit area moves along with you.  This makes it easy to stay in a clear area. Enjoy the burn.", "short_description": "To be fit, or not to be fit. That is the question. \nMove around and score points by catching balls that drop and rotate.\nOther balls just hang around. Try not moving your feet.  Don't forget the\nballs behind you.  See your surroundings while you get fit.  Move thru a wall to move your 2bfit area."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1lWHEKMjXnD5KMPReMX33Brbi3goEyEwAAFv75cz--QU/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "amre-amer.com", "support_website_url": null, "website_url": "https://amre-amer.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25023755790560223"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491821954_2335969400139423_72605
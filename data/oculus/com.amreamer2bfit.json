d2Ae&_nc_oc=AdofgkstcMwlHb1LgEpBFtG96tLt8WRf2bbBf06-BpormZtWq7OzzXtkY4Zw1QMIuYU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7VN7M4uahus06PCCau3jOsTAe5Z-Dfdcizmoz4PhsN7w&oe=6A1EF47E"}, {"file_name": "screenshot-0.png", "id": "711374158163846", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491819934_711374161497179_5219986979726633511_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9eCN5ZZIr9IQ7kNvwG2bR2U&_nc_oc=AdrT0w7Kzdb_lmIlMC7misY5tAJD8bL5Uh_jlQYkQX7MUfe0OITUkwd8WBLrAQskCxM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6vfjkucBYdpXrfLKjnZocaMHUbHcH-_ikS2h2ZVBByEg&oe=6A1ED2CD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover-video.png", "id": "740381481685081", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499623569_740381485018414_2207102974461887046_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2xcxIJtrLRcQ7kNvwEHatIT&_nc_oc=AdrSh8C6HNf25YSB0bJELszsoVPdFyx69SXrJdZY16eboNZG-PoGVTSgtd4rhyHHTVM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af41AxCUqXw06rtS7cP_mf3tjjuZNKxZaZLCCEbuMdt14g&oe=6A1EFFB9"}, "display_name": "2bfit", "keywords": ["fit", "exercise", "fun", "stretch"], "long_description": "This is an easy way to exercise, especially the upper body.  You can focus longer and enjoy moving around when you can see balls to interact with.\nAfter a minute (or 60 seconds) you can feel my shoulders and arms a little bit.  And if you keep you feet in place (don't rotate), you can stretch more.  If you go through a wall, the 2bfit area moves along with you.  This makes it easy to stay in a clear area. Enjoy the burn.", "short_description": "To be fit, or not to be fit. That is the question. \nMove around and score points by catching balls that drop and rotate.\nOther balls just hang around. Try not moving your feet.  Don't forget the\nballs behind you.  See your surroundings while you get fit.  Move thru a wall to move your 2bfit area."}]}, "developer
7kNvwEmerGR&_nc_oc=AdrHrA1ziU0_0u8QgzplUkp88fSuvJQbA-VWqb0g7nFmcmQIFdlm4qvs2aC8l5ID1EU&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHvPcufj5BGmX4PLQJwX77JoNB73VoGBi2NK0lcIo5yXg&oe=6A881D38"}, {"file_name": "2bfit-update1.png", "id": "1273832591007574", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/491827725_1273832594340907_7679835096266954535_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QiAlcwTasvoQ7kNvwGJ0C9e&_nc_oc=Adp7X9j0ZTl2_zVOcdSub1U5QJ0iv295KtmCdH1jNHjE_Y6T8oe-PVAXWjjHPt6zeQk&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGvnuke_NQZ0cLtBRFf8bC-hh5drwt-TMYa2EwanEvsKw&oe=6A884C0B"}, {"file_name": "2bfit-update3.png", "id": "4127365670925682", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/499307311_4127365674259015_7679022573858290498_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pmt2XyyG1M0Q7kNvwFL6pzr&_nc_oc=Ado_UQK_gDgkKgH_4ivZy4ZZEl5s70LresAelzCJ2J3iNZwzp27ua4JO512EjenayXs&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGIDMvLAZmgicDCaJ6jJlwnn73n-GtuNsh2Ky8emaz3-w&oe=6A88485B"}, {"file_name": "2bfit-update4.png", "id": "4236623229995296", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/491827718_4236623233328629_551381304740174737_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cCzuV8hKmrUQ7kNvwEgGzEc&_nc_oc=AdrRRgWj0UzKvYmwO9EEc5vEHezMNAdG8toAMNI1Tv2X1LdNBy-gSGGa6B5Qb77G1B0&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGAysz7qk6zyYDlwiYWfXiwU7Vs9Fqc8cnqtWfnKriMwg&oe=6A884E7F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover-video.png", "id": "740381481685081", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/499623569_740381485018414_2207102974461887046_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tbfiUyOmdtoQ7kNvwE7mAGp&_nc_oc=AdqFjrUxshfYUs4Mq_SAdFh0dMLmaOn5pjdOB-UwzxRK7prEdsnGlCCAIwmZikMoRWo&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGJhGJs9mD9WRH0_DDlF6-VjW4kRkDEnKHV_F3BDZmxaw&oe=6A883F79"}, "display_name": "2bfit", "keywords": ["fit", "exercise", "fun", "stretch"], "long_description": "This is an easy way to exercise, especially the upper body.  You can focus longer and enjoy moving around when you can see balls to interact with.\nAfter a minute (or 60 seconds) you can feel my shoulders and arms a little bit.  And if you keep you feet in place (don't rotate), you can stretch more.  If you go through a wall, the 2bfit area moves along with you.  This makes it easy to stay in a clear area. Enjoy the burn.", "short_description": "To be fit, or not to be fit. That is the question. \nMove around and score points by catching balls that drop and rotate.\nOther balls just hang around. Try not moving your feet.  Don't forget the\nballs behind you.  See your surroundings while you get fit.  Move thru a wall to move your 2bfit area."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1lWHEKMjXnD5KMPReMX33Brbi3goEyEwAAFv75cz--QU/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "amre-amer.com", "support_website_url": null, "website_url": "https://amre-amer.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25023755790560223"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/491821954_2335969400139423_72605
scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfzuLTd9EfbEiNuO7grZe2IlDtPucR6_YT3eSnx2o87DRw&oe=69BBDBBE"}, {"file_name": "screenshot-0.png", "id": "711374158163846", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491819934_711374161497179_5219986979726633511_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-KrYOZRkv7EQ7kNvwFNS3_p&_nc_oc=AdnXOBm8KH189BoAD3TSDfaFC3qlw73GeE7DD3lRcns_WkO9_DinK--y521t1Pe0OIc&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfxTAjIw00PNwRulCCuPJbjctPJM8AjH5vdmvQgWaZ8jnw&oe=69BBF24D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover-video.png", "id": "740381481685081", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499623569_740381485018414_2207102974461887046_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YjTpkBBECT4Q7kNvwFhxw9Y&_nc_oc=Adk8JG4auqVBm2_ucpagAf1JXZCqWvrq_PRbLy1ipONgbnJIqbSDDBVOLFwwFBOcsFo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_Afx3JwSUvo1mD2FaLYhwxgJAxy-8AmCZVJJbp_BfXcux9g&oe=69BBE6F9"}, "display_name": "2bfit", "keywords": ["fit", "exercise", "fun", "stretch"], "long_description": "This is an easy way to exercise, especially the upper body.  You can focus longer and enjoy moving around when you can see balls to interact with.\nAfter a minute (or 60 seconds) you can feel my shoulders and arms a little bit.  And if you keep you feet in place (don't rotate), you can stretch more.  If you go through a wall, the 2bfit area moves along with you.  This makes it easy to stay in a clear area. Enjoy the burn.", "short_description": "To be fit, or not to be fit. That is the question. \nMove around and score points by catching balls that drop and rotate.\nOther balls just hang around. Try not moving your feet.  Don't forget the\nballs behind you.  See your surroundings while you get fit.  Move thru a wall to move your 2bfit area."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1lWHEKMjXnD5KMPReMX33Brbi3
7kNvwHOAJsR&_nc_oc=AdoiwZA982SPXe1qdBbJpozn1pWaqpv0oUFn6rjrws4RSuQLiQmntHQ_lH7cHvVOMGA&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6pn8fQY9dPd4QcTJkJLcCgt0AnTZ6rux8KMdeBQRjPHA&oe=6A12FFF8"}, {"file_name": "2bfit-update1.png", "id": "1273832591007574", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/491827725_1273832594340907_7679835096266954535_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0y7kk-9SKaMQ7kNvwF73qCU&_nc_oc=AdouRHnDwWZ8pxWCCXY_s0U_DP5IBi8vDP9l3HAPBfCb-l9mt_LcEIaWOwmjdYgQMTI&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4HhXvt_NlnTr0W_sGTTIDX5SaJufg4MsDlwVfyFAZH8Q&oe=6A12F68B"}, {"file_name": "2bfit-update3.png", "id": "4127365670925682", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499307311_4127365674259015_7679022573858290498_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PXzf6d9CKrUQ7kNvwHhTmR7&_nc_oc=AdpyUqKgeIIntPGifUhL7aRfq6c-O6rOBfqbpsrfHfjwcpi9hq1WjRnCTbHimo1IiH4&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7JPPCxb10JJ9P1NsoXMr-3bf2tSxOJ50qDKPYM3aCGag&oe=6A12F2DB"}, {"file_name": "2bfit-update4.png", "id": "4236623229995296", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/491827718_4236623233328629_551381304740174737_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L-LecqQu6uUQ7kNvwHaYnhn&_nc_oc=AdonNL9KatfOdYDUghrkaW_HS8cRuh6VyMYzW63R7YwxDc73zXKJ6RFBDjrucyF6hHU&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af72jFWowTk7AljIO2nwaPDC3Vcp7WkaEt0f2uP_5p_j7A&oe=6A12F8FF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover-video.png", "id": "740381481685081", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/499623569_740381485018414_2207102974461887046_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NFt3UdlF5cEQ7kNvwHETe1X&_nc_oc=AdrE1zKDopC4TAuPVykvcio_XzibAhZparyv-rjv1thFfytfosP-ev3u9va5trd-m68&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7KF8RlESLpP8WCYhxs0DSJzWBdRJxhIpkU2CjUUtvBkA&oe=6A132239"}, "display_name": "2bfit", "keywords": ["fit", "exercise", "fun", "stretch"], "long_description": "This is an easy way to exercise, especially the upper body.  You can focus longer and enjoy moving around when you can see balls to interact with.\nAfter a minute (or 60 seconds) you can feel my shoulders and arms a little bit.  And if you keep you feet in place (don't rotate), you can stretch more.  If you go through a wall, the 2bfit area moves along with you.  This makes it easy to stay in a clear area. Enjoy the burn.", "short_description": "To be fit, or not to be fit. That is the question. \nMove around and score points by catching balls that drop and rotate.\nOther balls just hang around. Try not moving your feet.  Don't forget the\nballs behind you.  See your surroundings while you get fit.  Move thru a wall to move your 2bfit area."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1lWHEKMjXnD5KMPReMX33Brbi3goEyEwAAFv75cz--QU/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "amre-amer.com", "support_website_url": null, "website_url": "https://amre-amer.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25023755790560223"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/491821954_2335969400139423_72605
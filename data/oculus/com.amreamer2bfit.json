RsA9&_nc_oc=AdqVtWvINFBqEG2uV0ZLeYDhEWthlLvhIzE_JMveAl0AI7V0bV9ZMNl-LkhRaLj4KM4&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af66zjr9_7APdj5O4uUhZEbHoqimR1ogdsUn_bq4xoe3Rw&oe=6A09DC7E"}, {"file_name": "screenshot-0.png", "id": "711374158163846", "uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/491819934_711374161497179_5219986979726633511_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RV5EwkFOPc8Q7kNvwF3zmR5&_nc_oc=AdqZ_5R-k3sW8dy3-Q2EI5H9i0vaRjx7RoTRnfLVco4W1sYQ7yz9y1ItSshsyYB_bAM&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5aui6SJFDVN-Yb2lxlkwD_gnhzaEsjX1OTn8ZRjX30FQ&oe=6A09BACD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover-video.png", "id": "740381481685081", "uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/499623569_740381485018414_2207102974461887046_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0xI966oUO_0Q7kNvwEJ4L_Y&_nc_oc=Adp5fTXJfaLBjWeVpeCQLcbROLPJFNYI72zyXo4J67QOaHwkxO9juupPmqonnHUv1os&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5833mbH9-70RgQsN6tM8vOj4tD0mQwlphpvEEnVwoGYg&oe=6A09AF79"}, "display_name": "2bfit", "keywords": ["fit", "exercise", "fun", "stretch"], "long_description": "This is an easy way to exercise, especially the upper body.  You can focus longer and enjoy moving around when you can see balls to interact with.\nAfter a minute (or 60 seconds) you can feel my shoulders and arms a little bit.  And if you keep you feet in place (don't rotate), you can stretch more.  If you go through a wall, the 2bfit area moves along with you.  This makes it easy to stay in a clear area. Enjoy the burn.", "short_description": "To be fit, or not to be fit. That is the question. \nMove around and score points by catching balls that drop and rotate.\nOther balls just hang around. Try not moving your feet.  Don't forget the\nballs behind you.  See your surroundings while you get fit.  Move thru a wall to move your 2bfit area."}]}, "developer
7kNvwFO4A88&_nc_oc=Adrdsn6sjDmnTzv-iEmC53RwtxepvYPVQ-jxK50EaXhPnVaP5FfSds2GvDgOBc1U2G8&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6IfoQUAg0f-4VF35SyLFGQ5jjuYl_t2Fm_VIMH4BohOQ&oe=6A15A2F8"}, {"file_name": "2bfit-update1.png", "id": "1273832591007574", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/491827725_1273832594340907_7679835096266954535_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MfN1RGlo7G4Q7kNvwGJi-S7&_nc_oc=Adow-Z13hy7xwMSu0xuHsw7v_19lzeAAeQEowCth8kEZJJKEhspx-c9gDRfgh6fwaZ4&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af67ygt_fzlxQQxt6AHCA96OXuG8LanFS1NfhRI8rzt_CQ&oe=6A15998B"}, {"file_name": "2bfit-update3.png", "id": "4127365670925682", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/499307311_4127365674259015_7679022573858290498_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PXzf6d9CKrUQ7kNvwEdaOvQ&_nc_oc=Adqe8yCm9ToOMZPZTF8601uftBbKvphl88rMWPsmVpODTxEIv_WA0ITzX6WJlQAYWJk&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4hf07cvHBOKnu8Ski2HOln8IsbRCbSJfvFtiQRfTPSlw&oe=6A1595DB"}, {"file_name": "2bfit-update4.png", "id": "4236623229995296", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491827718_4236623233328629_551381304740174737_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JqIoS_vaR4AQ7kNvwE96GvR&_nc_oc=AdpqkJGYnZ2EiQOgCn-n9t2eTmnhJRzeBfkevz_iiACFqGFRkQHaoYjsdtGSoNW6msk&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5NnNpcjLGsMnBwr_UVmhbNtdjI08HiiXiHmDDqW3yCog&oe=6A159BFF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover-video.png", "id": "740381481685081", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499623569_740381485018414_2207102974461887046_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8NiRcWtC3MEQ7kNvwFLzWhQ&_nc_oc=AdpteFmNI9wQaTyNDBkqx70efg8g8pAtcOQdAtQ9wQOIDzEERU7X4ZDrZaTV4wwj_sY&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5rn7vNju308PLpuPpQPuaIHVJVmXIpZ2jFqBoCxCBavQ&oe=6A15C539"}, "display_name": "2bfit", "keywords": ["fit", "exercise", "fun", "stretch"], "long_description": "This is an easy way to exercise, especially the upper body.  You can focus longer and enjoy moving around when you can see balls to interact with.\nAfter a minute (or 60 seconds) you can feel my shoulders and arms a little bit.  And if you keep you feet in place (don't rotate), you can stretch more.  If you go through a wall, the 2bfit area moves along with you.  This makes it easy to stay in a clear area. Enjoy the burn.", "short_description": "To be fit, or not to be fit. That is the question. \nMove around and score points by catching balls that drop and rotate.\nOther balls just hang around. Try not moving your feet.  Don't forget the\nballs behind you.  See your surroundings while you get fit.  Move thru a wall to move your 2bfit area."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1lWHEKMjXnD5KMPReMX33Brbi3goEyEwAAFv75cz--QU/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "amre-amer.com", "support_website_url": null, "website_url": "https://amre-amer.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25023755790560223"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491821954_2335969400139423_72605
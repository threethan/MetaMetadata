_YM_&_nc_oc=AdrE9yX8iJAB0cFadQCy6rWSXBqDV8oA6lhgz2GyJ_n6TpzUmP1-5UzsZPcHx4cbh2E&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK5yOUy6eBbeMZy1dPq-V7GKgsMKvdoNOhL5sp7HfhA8w&oe=6AA56D7E"}, {"file_name": "screenshot-0.png", "id": "711374158163846", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491819934_711374161497179_5219986979726633511_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gjqmTAqQJJkQ7kNvwGI-uwF&_nc_oc=AdrcpCHnbx3xquTAJfkrXX6iuZtQ1z7kS0Vo3R7ep3VRXEClDkFuwLsv5bDGJFa7vyA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJzejGAo2H67LJWsKpO5D6kJH0l4Gy1T8X6P6GkqFi2Gg&oe=6AA54BCD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover-video.png", "id": "740381481685081", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499623569_740381485018414_2207102974461887046_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=11oTx7sKa7QQ7kNvwFONFUY&_nc_oc=Adp0-Gsk1MFPhGT5CciJzJPH81v31RxXQUZI8poW6tSNkBL1QuwqCALGvI7Zxwk7oGA&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLf7uOq6EsoG6_7lavMg8xJvrL0S8wD5GQGyJt8E81yKg&oe=6AA54079"}, "display_name": "2bfit", "keywords": ["fit", "exercise", "fun", "stretch"], "long_description": "This is an easy way to exercise, especially the upper body.  You can focus longer and enjoy moving around when you can see balls to interact with.\nAfter a minute (or 60 seconds) you can feel my shoulders and arms a little bit.  And if you keep you feet in place (don't rotate), you can stretch more.  If you go through a wall, the 2bfit area moves along with you.  This makes it easy to stay in a clear area. Enjoy the burn.", "short_description": "To be fit, or not to be fit. That is the question. \nMove around and score points by catching balls that drop and rotate.\nOther balls just hang around. Try not moving your feet.  Don't forget the\nballs behind you.  See your surroundings while you get fit.  Move thru a wall to move your 2bfit area."}]}, "developer
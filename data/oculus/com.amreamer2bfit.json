cTp0&_nc_oc=AdrHXgUAJDGJYEOmoCpXhtZQw0f0_2Ei_6RPk3-yeVRR_6DzKuKeD9S67-9E4P4HeOc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8kDN5KAG5oJ73SoNDGtQbRHzdEpHZFzoQgZj3fUVK78w&oe=6A3800FE"}, {"file_name": "screenshot-0.png", "id": "711374158163846", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491819934_711374161497179_5219986979726633511_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9OB9gGHUnx4Q7kNvwFRCC7A&_nc_oc=AdpW_qFFYqtlnMyjEc7t6kfgteVap3JRkFO9s-z0xqSUAnQwB8cW-7dBSGQ88NxZQp0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8tgbGVjD32PkqsF0Vo02mONBz-QcxoMwLFZ5ZRE25jwA&oe=6A38178D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover-video.png", "id": "740381481685081", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499623569_740381485018414_2207102974461887046_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LSTZ8iBOrYgQ7kNvwEVQFAq&_nc_oc=Adoulkec_5Ur8lnyTqlmxC2OIJ1Pvmahp4lY9CffpuASI0ncCMpsNuHfpcg9Lds2HLA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_SsAz7bSe1aKO4MG3s1zkJhscgQcxeRw-laTXY9LlQRg&oe=6A380C39"}, "display_name": "2bfit", "keywords": ["fit", "exercise", "fun", "stretch"], "long_description": "This is an easy way to exercise, especially the upper body.  You can focus longer and enjoy moving around when you can see balls to interact with.\nAfter a minute (or 60 seconds) you can feel my shoulders and arms a little bit.  And if you keep you feet in place (don't rotate), you can stretch more.  If you go through a wall, the 2bfit area moves along with you.  This makes it easy to stay in a clear area. Enjoy the burn.", "short_description": "To be fit, or not to be fit. That is the question. \nMove around and score points by catching balls that drop and rotate.\nOther balls just hang around. Try not moving your feet.  Don't forget the\nballs behind you.  See your surroundings while you get fit.  Move thru a wall to move your 2bfit area."}]}, "developer
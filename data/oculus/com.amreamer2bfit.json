c=qOzrnxU2uPQQ7kNvwGgyB4D&_nc_oc=AdpCX3afPPysOYLtLnvC_voTg90eunV3DevUaRuaBNNtQ6fIwcksVla3OzDO-Ho6XOs&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-CTGXs0g2p3VxhGTjBKXx6gnhmsoB7bWC9zuM3l8oZUQ&oe=6A369878"}, {"file_name": "2bfit-update1.png", "id": "1273832591007574", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/491827725_1273832594340907_7679835096266954535_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=laiigyA0Qi4Q7kNvwHlfN1S&_nc_oc=AdrfovIWM2Etzlhtqd9FA7oTAqgx4XRm-DlMreixGcMvZCdcdSpZupRLrhlVcsB8y8c&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9DC8bezBi0rb7P1PSffpbOWVSSrE8PZKbPLrrAf7SKmA&oe=6A36C74B"}, {"file_name": "2bfit-update3.png", "id": "4127365670925682", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/499307311_4127365674259015_7679022573858290498_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KAZtg7t80rUQ7kNvwFP_drX&_nc_oc=Adq82wFx6-pFeu5Q5ciaJQzlxl9d6PHMrze9yleIWzayxT-I8tQMLzLuUxNj7izuwcc&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af83EpIsWnfb-U6bLG1O4seNnHek96pRTpk8O8QmsUZNPA&oe=6A36C39B"}, {"file_name": "2bfit-update4.png", "id": "4236623229995296", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/491827718_4236623233328629_551381304740174737_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qsoBDhVOLLIQ7kNvwGIh5xo&_nc_oc=AdpjtzcsDjv6CtdwiauWSqV2d3Dqp2dmEGqUmdHvTiXzFLa5rB5wr_1Qb765YlVHkoE&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9fZLpzHy87c9XtVL5MCeFtP48zpWKnx9RUTT7YHvemlg&oe=6A36917F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover-video.png", "id": "740381481685081", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/499623569_740381485018414_2207102974461887046_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LSTZ8iBOrYgQ7kNvwG5P6o6&_nc_oc=AdpFX9SuZbeOG5OEhZ8zwwM3QciIQYfIh6PIsr_8Vv533yHShUk8R82zdHo4XGVUxvk&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af88J-aDaeKwjVohDbuE10rtEQAsLdmONAsKp-w08vpcBQ&oe=6A36BAB9"}, "display_name": "2bfit", "keywords": ["fit", "exercise", "fun", "stretch"], "long_description": "This is an easy way to exercise, especially the upper body.  You can focus longer and enjoy moving around when you can see balls to interact with.\nAfter a minute (or 60 seconds) you can feel my shoulders and arms a little bit.  And if you keep you feet in place (don't rotate), you can stretch more.  If you go through a wall, the 2bfit area moves along with you.  This makes it easy to stay in a clear area. Enjoy the burn.", "short_description": "To be fit, or not to be fit. That is the question. \nMove around and score points by catching balls that drop and rotate.\nOther balls just hang around. Try not moving your feet.  Don't forget the\nballs behind you.  See your surroundings while you get fit.  Move thru a wall to move your 2bfit area."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1lWHEKMjXnD5KMPReMX33Brbi3goEyEwAAFv75cz--QU/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "amre-amer.com", "support_website_url": null, "website_url": "https://amre-amer.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25023755790560223"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/491821954_233
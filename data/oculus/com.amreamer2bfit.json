c=wy-wmcNITvEQ7kNvwF2dZl_&_nc_oc=AdpiBmKiRJdhgcrU1AEXQVsFP9HoT2RZSC3bt2PjrgbKoyBjTLmHfYKChJaQgSOx23U&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ8HD14UK5V7SEl04rouUxHZUfNswpQBw_pl-VmRcSYTg&oe=6AAE90F8"}, {"file_name": "2bfit-update1.png", "id": "1273832591007574", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/491827725_1273832594340907_7679835096266954535_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uc9YIs7in-4Q7kNvwG8Zigs&_nc_oc=AdrzYHoXZF506x9fTyuABvyodqhPpUidsBAq88L7I4H3hUj43oz2NPY150U1vN8iy30&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLftGDzjG0loOSnk68pmKwn1Zg2njlVYrA1-lQ766ddFA&oe=6AAE878B"}, {"file_name": "2bfit-update3.png", "id": "4127365670925682", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/499307311_4127365674259015_7679022573858290498_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Iql5VliUIxIQ7kNvwFRigzc&_nc_oc=AdouvQpllLBsAic_n4BPeV1d1O3SWAUGEQsZ5ppzwEAdJEmsZTrFjFc841UUNbyhjkA&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLvvea3SmfB5F-jAYpelO9a920eD8E-6gJztCr2cbtxTQ&oe=6AAE83DB"}, {"file_name": "2bfit-update4.png", "id": "4236623229995296", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/491827718_4236623233328629_551381304740174737_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iVO2TW36UmIQ7kNvwG8NLeH&_nc_oc=AdqJi-KYceefVQgKJ6qAAaL5ZoC6_BlHg83a25kGcQR4GoqprAkpFxeuWmpJnLbjgJk&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKpGYSmWRSSXs8MygR65E7IP9vEqITNnc7Lc_VmZvsH8w&oe=6AAE89FF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover-video.png", "id": "740381481685081", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/499623569_740381485018414_2207102974461887046_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5W2YNvnYGhAQ7kNvwEquB8O&_nc_oc=Adp_pbJJkDdWe18sUVeJfwoOpkKLvl6N1J-6zB2aa6-_3vI1e27FOTYbHwULGvSaBdA&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLv1-JRUDcNHxTil-1ZbAEMS8NdmVxF_4jc88M6UMsELg&oe=6AAEB339"}, "display_name": "2bfit", "keywords": ["fit", "exercise", "fun", "stretch"], "long_description": "This is an easy way to exercise, especially the upper body.  You can focus longer and enjoy moving around when you can see balls to interact with.\nAfter a minute (or 60 seconds) you can feel my shoulders and arms a little bit.  And if you keep you feet in place (don't rotate), you can stretch more.  If you go through a wall, the 2bfit area moves along with you.  This makes it easy to stay in a clear area. Enjoy the burn.", "short_description": "To be fit, or not to be fit. That is the question. \nMove around and score points by catching balls that drop and rotate.\nOther balls just hang around. Try not moving your feet.  Don't forget the\nballs behind you.  See your surroundings while you get fit.  Move thru a wall to move your 2bfit area."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1lWHEKMjXnD5KMPReMX33Brbi3goEyEwAAFv75cz--QU/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "amre-amer.com", "support_website_url": null, "website_url": "https://amre-amer.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25023755790560223"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/491821954_233
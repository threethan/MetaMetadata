7kNvwGrK0gU&_nc_oc=AdqNiDqWABD0EX48KGd0vqfYYufKpibLSDBtqCJLWAVWq21dg0ySFpc3xVks9BffmB0&_nc_zt=3&_nc_ht=scontent-lhr8-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6PxiLHsuvyXGooxbxeLx709LojNZAmtqxiVyYf46jYiA&oe=6A105CF8"}, {"file_name": "2bfit-update1.png", "id": "1273832591007574", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/491827725_1273832594340907_7679835096266954535_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fj-lw5cuxUQQ7kNvwGFS53T&_nc_oc=Adp0lS5U7dBjMIWvOtzuibQA7iXKHoW-Bc-3wPkeFMZRTyWfz4bRCll_DvMLoYuov6o&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6PrLIu8kXo2gt7JiL7qY8Z_XtjeQroQhs0f4RqkUB-Cw&oe=6A10538B"}, {"file_name": "2bfit-update3.png", "id": "4127365670925682", "uri": "https://scontent-lhr8-2.oculuscdn.com/v/t64.5771-25/499307311_4127365674259015_7679022573858290498_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5hyhsJAbrM0Q7kNvwEM28ia&_nc_oc=Adr9NEAk9-KOK9sjxFZwQRgn_qSgz1gq5lhFNrJcuGHQR7_gPhuCAsiFAmV6NMN0Czg&_nc_zt=3&_nc_ht=scontent-lhr8-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5DXJrD_5TXYaLNEexCs5jWzYb_dFBCXIjG4C15ppbzGg&oe=6A104FDB"}, {"file_name": "2bfit-update4.png", "id": "4236623229995296", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/491827718_4236623233328629_551381304740174737_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L-LecqQu6uUQ7kNvwGZI63i&_nc_oc=Adq4tmF7Ac2duF2DBytkYi7kFxcJRfgkw6QkQL49cbCrnCopTIhOoSlKBKWqe_BNYOo&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7QZmiWVgYQBwmf4sZ2wxrZJFMFUGHc7Qter8V935uZwA&oe=6A1055FF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover-video.png", "id": "740381481685081", "uri": "https://scontent-lhr8-2.oculuscdn.com/v/t64.5771-25/499623569_740381485018414_2207102974461887046_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zWBw2kIxokoQ7kNvwFCbBuW&_nc_oc=AdocdXivWkC1_cJQB4lsyb4lF7LgdjSTXmsuVWS6Om_6IJuXT2NZ1Jv1-0cmDx8nEgI&_nc_zt=3&_nc_ht=scontent-lhr8-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7WNbaPUcJ6ItAu9TeOGpfbF87O6XBd1Mszcf9jHKqAGA&oe=6A107F39"}, "display_name": "2bfit", "keywords": ["fit", "exercise", "fun", "stretch"], "long_description": "This is an easy way to exercise, especially the upper body.  You can focus longer and enjoy moving around when you can see balls to interact with.\nAfter a minute (or 60 seconds) you can feel my shoulders and arms a little bit.  And if you keep you feet in place (don't rotate), you can stretch more.  If you go through a wall, the 2bfit area moves along with you.  This makes it easy to stay in a clear area. Enjoy the burn.", "short_description": "To be fit, or not to be fit. That is the question. \nMove around and score points by catching balls that drop and rotate.\nOther balls just hang around. Try not moving your feet.  Don't forget the\nballs behind you.  See your surroundings while you get fit.  Move thru a wall to move your 2bfit area."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1lWHEKMjXnD5KMPReMX33Brbi3goEyEwAAFv75cz--QU/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "amre-amer.com", "support_website_url": null, "website_url": "https://amre-amer.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25023755790560223"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lhr8-1.oculuscdn.com/v/t64.5771-25/491821954_2335969400139423_72605
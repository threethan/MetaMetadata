7kNvwFY7XIg&_nc_oc=AdonAL6aM6_EOns2AqgC91hiciRrWMVtCPXGp6Kkzgv_tEs40qsSk2Wav-J7PPAIhvI&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9Rs_dSs-ONoCC2ktUYriPCWBvoGmlOvfJEclpjB0RTOw&oe=6A26C678"}, {"file_name": "2bfit-update1.png", "id": "1273832591007574", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/491827725_1273832594340907_7679835096266954535_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LBcMMKFx6GcQ7kNvwFT-4Jn&_nc_oc=Ado6hb1u-pX0cefAa4KK0ByZ9mx5Doj4zR9v2HgwKOwr9gP3wZbjy8Vm7ewX2E--AHA&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_Wwf8qjP0U_qIXysfbfrDuwkdrLx88MSsUO1cgWX3rZw&oe=6A26BD0B"}, {"file_name": "2bfit-update3.png", "id": "4127365670925682", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499307311_4127365674259015_7679022573858290498_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f9PO80Q58-IQ7kNvwECSlqn&_nc_oc=Adqc5zkIJC_afS1yjJgSYgN0HDFY3BGvN_UG9UVUUkEoyVajuJIF-PxSa6LZIr3hpu4&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8KhYAicxkZ7Gqw4-Qq2OxOWDWK-DLShebqiyPPNqgJAw&oe=6A26B95B"}, {"file_name": "2bfit-update4.png", "id": "4236623229995296", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/491827718_4236623233328629_551381304740174737_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Kb-zxLUdnBsQ7kNvwEkysa5&_nc_oc=AdotXW83HvZN4VKGMXgE6koONXe9COYd8ZnhsXreNt7ln38iq52QrdkPF7k8brYTsms&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af98wYHVG49gez4LAioO0MosM1WfExqkn36a57LxCNyCJQ&oe=6A26BF7F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover-video.png", "id": "740381481685081", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499623569_740381485018414_2207102974461887046_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RM-WVBk7MVYQ7kNvwFEVnFm&_nc_oc=AdpVrHvAJ1P1jI6tvV7hZdPRjcODCsJGl3PJZFwIF1azfe2AgR0YkcSeTVwMu8KidIQ&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_WJLzr1Hc04fsZTwvoOUfNk1SziS_deFE4Hy8jw0XlNw&oe=6A26E8B9"}, "display_name": "2bfit", "keywords": ["fit", "exercise", "fun", "stretch"], "long_description": "This is an easy way to exercise, especially the upper body.  You can focus longer and enjoy moving around when you can see balls to interact with.\nAfter a minute (or 60 seconds) you can feel my shoulders and arms a little bit.  And if you keep you feet in place (don't rotate), you can stretch more.  If you go through a wall, the 2bfit area moves along with you.  This makes it easy to stay in a clear area. Enjoy the burn.", "short_description": "To be fit, or not to be fit. That is the question. \nMove around and score points by catching balls that drop and rotate.\nOther balls just hang around. Try not moving your feet.  Don't forget the\nballs behind you.  See your surroundings while you get fit.  Move thru a wall to move your 2bfit area."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1lWHEKMjXnD5KMPReMX33Brbi3goEyEwAAFv75cz--QU/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "amre-amer.com", "support_website_url": null, "website_url": "https://amre-amer.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25023755790560223"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/491821954_2335969400139423_72605
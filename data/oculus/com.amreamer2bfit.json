c=ncO9uTp-c9wQ7kNvwHpBsP6&_nc_oc=AdryDjCiT27oWJ-jJFtuYPfdejVwbbX6JBCUpWxqfX-zqGyritUUXa1ZKokbZHufUDI&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKauSGmf-o3WaWdAiTCzefYAth9gJWIBxb5UsHsKY-hgw&oe=6AA404F8"}, {"file_name": "2bfit-update1.png", "id": "1273832591007574", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/491827725_1273832594340907_7679835096266954535_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IkJ-XJIwG0QQ7kNvwEWETc_&_nc_oc=Adq6_dCTdP8IlAdLHSFwvLgutFXvYzsztQCdn0Iqs5YIN8ijh78BY_iyPlegoJPHE3g&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJMEwuv_Hb0tMhOt_uNWDMTBeoY3nX7lgfggR_ZMBwDIg&oe=6AA3FB8B"}, {"file_name": "2bfit-update3.png", "id": "4127365670925682", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/499307311_4127365674259015_7679022573858290498_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P-AFzbUT_JsQ7kNvwFW9mcB&_nc_oc=AdoWH30oNnOuGFVoUntEJX8-5O00eAPvkckqrStKohqt_6p1o0dKAhqcz5Z8jl6FWlM&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLDVhKRdCYixQE0XfH2Cwu0QlsjETczppou4yw8txOCQg&oe=6AA3F7DB"}, {"file_name": "2bfit-update4.png", "id": "4236623229995296", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/491827718_4236623233328629_551381304740174737_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YBBs26d2w84Q7kNvwFWPVbV&_nc_oc=AdqHKa05Aqpb4iMU_BoM0H94EcvDxrxZEnU9reldbUOZjrlyHM0mnRIrqcDB7Zwtomc&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJIQDPXtkwkeDzxtWh_yAoIpX_80ry_rwEIaWabChzbvg&oe=6AA3FDFF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover-video.png", "id": "740381481685081", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/499623569_740381485018414_2207102974461887046_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=11oTx7sKa7QQ7kNvwF7NHaC&_nc_oc=AdqwnVFlBAhxrRdvrV-30eE-28B0clW9dksmmiYmOppLiLGOhEn3Bxi9xq1vHYJrVzk&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLR0wrTDHh1mjG-LNzTiDv856duyumyVypUq3_6CioqdQ&oe=6AA3EEF9"}, "display_name": "2bfit", "keywords": ["fit", "exercise", "fun", "stretch"], "long_description": "This is an easy way to exercise, especially the upper body.  You can focus longer and enjoy moving around when you can see balls to interact with.\nAfter a minute (or 60 seconds) you can feel my shoulders and arms a little bit.  And if you keep you feet in place (don't rotate), you can stretch more.  If you go through a wall, the 2bfit area moves along with you.  This makes it easy to stay in a clear area. Enjoy the burn.", "short_description": "To be fit, or not to be fit. That is the question. \nMove around and score points by catching balls that drop and rotate.\nOther balls just hang around. Try not moving your feet.  Don't forget the\nballs behind you.  See your surroundings while you get fit.  Move thru a wall to move your 2bfit area."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1lWHEKMjXnD5KMPReMX33Brbi3goEyEwAAFv75cz--QU/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "amre-amer.com", "support_website_url": null, "website_url": "https://amre-amer.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25023755790560223"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/491821954_233
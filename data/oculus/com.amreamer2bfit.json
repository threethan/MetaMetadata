bduz&_nc_oc=AdpsykomG5zVvO3LL-AWdNS8U9AZvccQaMFxOFJviDs4iW89LTqn9xPkdOCT53Hnqy0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG80el1lJHnPjATH0BgJfZjRJM8ywtyHP3z0ffVgVCKpA&oe=6A70793E"}, {"file_name": "screenshot-0.png", "id": "711374158163846", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491819934_711374161497179_5219986979726633511_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3AAM0yug2BAQ7kNvwEQnEww&_nc_oc=AdqL-FLYTKi5lV4oRMDqWnO2JZnF5BmAVsue0tJTMWbr2tnsTOgOGQ9bi68w1TBi7XA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG2bKDTflcPqAmxginzk4cM00tLvU-TB0n23kHTJwve5A&oe=6A708FCD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover-video.png", "id": "740381481685081", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499623569_740381485018414_2207102974461887046_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l5nYrAMEgQYQ7kNvwGm5KQI&_nc_oc=AdoSTkKN2iDnqmbMhtrnBFm23gwO3NTT2KcPhjl0YaLykCwKGDV9TefgGVppOZ09GDY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFURKqqvR5lggcd5d1Pce4tGAqhFFWYcsts45FyHIc-Mw&oe=6A708479"}, "display_name": "2bfit", "keywords": ["fit", "exercise", "fun", "stretch"], "long_description": "This is an easy way to exercise, especially the upper body.  You can focus longer and enjoy moving around when you can see balls to interact with.\nAfter a minute (or 60 seconds) you can feel my shoulders and arms a little bit.  And if you keep you feet in place (don't rotate), you can stretch more.  If you go through a wall, the 2bfit area moves along with you.  This makes it easy to stay in a clear area. Enjoy the burn.", "short_description": "To be fit, or not to be fit. That is the question. \nMove around and score points by catching balls that drop and rotate.\nOther balls just hang around. Try not moving your feet.  Don't forget the\nballs behind you.  See your surroundings while you get fit.  Move thru a wall to move your 2bfit area."}]}, "developer
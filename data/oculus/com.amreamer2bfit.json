rEBF&_nc_oc=AdqRumA5hZS4z5xhoDOzL3ACJrOwYnlV04-EaBgRlQGfyTOwiDsYcMx5WqBoAZtLOIk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4dQWR6nQFLla8e5v5aJ4U1AfgSFCzzlhKoEzrNFPB27w&oe=69FCAD7E"}, {"file_name": "screenshot-0.png", "id": "711374158163846", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491819934_711374161497179_5219986979726633511_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dOeCFnVQfLwQ7kNvwHPLGwn&_nc_oc=AdqVOpEiyVYB2bbK3c8vXjOQ4SWMcvotOc4jMRr9MftjD7eQLS59ISiE8zGWMECqWi8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7KibNxsTA9cseV28l-cHywAlyjFO1Wqqwy6yBFGix65w&oe=69FC8BCD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover-video.png", "id": "740381481685081", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499623569_740381485018414_2207102974461887046_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NrUy7M3rbzQQ7kNvwF9PSwa&_nc_oc=AdoCTQr9kHwwGkavHT9JkIUP6e2gUpIfVVfo1VLGVtW0qdhajCiCa_EOJAgTjJo6MF0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5GhfZJ77qVSEs5fM0U0hJ-D7l_GSDvnabZxARsa09Btg&oe=69FC8079"}, "display_name": "2bfit", "keywords": ["fit", "exercise", "fun", "stretch"], "long_description": "This is an easy way to exercise, especially the upper body.  You can focus longer and enjoy moving around when you can see balls to interact with.\nAfter a minute (or 60 seconds) you can feel my shoulders and arms a little bit.  And if you keep you feet in place (don't rotate), you can stretch more.  If you go through a wall, the 2bfit area moves along with you.  This makes it easy to stay in a clear area. Enjoy the burn.", "short_description": "To be fit, or not to be fit. That is the question. \nMove around and score points by catching balls that drop and rotate.\nOther balls just hang around. Try not moving your feet.  Don't forget the\nballs behind you.  See your surroundings while you get fit.  Move thru a wall to move your 2bfit area."}]}, "developer
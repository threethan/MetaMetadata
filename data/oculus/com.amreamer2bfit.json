7kNvwFOC45x&_nc_oc=AdorBwKAp4bGVrjU0Y5URhXfusr5UgxiCZmFwq19-g9Db5jV7G9_jyzSVH1FCB98aoQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDynmV6TIZnVj8whc4ofqamiqZ2cy2dIBuKtQa-_cn-XA&oe=6A6CA5F8"}, {"file_name": "2bfit-update1.png", "id": "1273832591007574", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491827725_1273832594340907_7679835096266954535_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CzMxWNw1sV8Q7kNvwE-dPqt&_nc_oc=Adp4N04vULoNtZ3VEHBZmgV8OUcVFSItXAh5eqIj_818KW_UzABfgK2iHHQkXC89VfE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD4qpihgyQZdlJnSZ_weN0fHU8tf5Y1bStlJnK6mRFSrw&oe=6A6C9C8B"}, {"file_name": "2bfit-update3.png", "id": "4127365670925682", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499307311_4127365674259015_7679022573858290498_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D23RL3TrIasQ7kNvwGWcL_e&_nc_oc=AdrQrWBsHbXTXic1TMqhI5RJtUR9LRbO_pf0WkdUoxJHQFJJNMaErSJqm34D54vYAeI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBAgSBB37U-_Q1AptwH6IxFSR7AmN_D_ueJdvfK58Dmiw&oe=6A6C98DB"}, {"file_name": "2bfit-update4.png", "id": "4236623229995296", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491827718_4236623233328629_551381304740174737_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i_5Oxojx7CwQ7kNvwFjeFAp&_nc_oc=AdqFogNE1MwXmj3zZCTnd4OEwtamZfmloYviv85KEfmLIjDHhPy8NByiTb8QLOyuE1k&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBiEQ6jFq1D8zRLCk7RoBLaIItydqPr9zPtpav4MhtATg&oe=6A6C9EFF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover-video.png", "id": "740381481685081", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499623569_740381485018414_2207102974461887046_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NTb7lbImcWMQ7kNvwF8BQNT&_nc_oc=AdqLEMxfjNXAIzs76kh3uE8Bxb7Djniy33HOa9TpsYMO5roTDoIivX0QWTJmkU6rVIM&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCw-rXoI_8w1wyAQzzz80wF94lc064oSm--XbdYWOGMlA&oe=6A6C8FF9"}, "display_name": "2bfit", "keywords": ["fit", "exercise", "fun", "stretch"], "long_description": "This is an easy way to exercise, especially the upper body.  You can focus longer and enjoy moving around when you can see balls to interact with.\nAfter a minute (or 60 seconds) you can feel my shoulders and arms a little bit.  And if you keep you feet in place (don't rotate), you can stretch more.  If you go through a wall, the 2bfit area moves along with you.  This makes it easy to stay in a clear area. Enjoy the burn.", "short_description": "To be fit, or not to be fit. That is the question. \nMove around and score points by catching balls that drop and rotate.\nOther balls just hang around. Try not moving your feet.  Don't forget the\nballs behind you.  See your surroundings while you get fit.  Move thru a wall to move your 2bfit area."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1lWHEKMjXnD5KMPReMX33Brbi3goEyEwAAFv75cz--QU/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "amre-amer.com", "support_website_url": null, "website_url": "https://amre-amer.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25023755790560223"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491821954_2335969400139423_72605
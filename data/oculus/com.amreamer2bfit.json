7kNvwHtowfw&_nc_oc=AdoWpZcg1Mch4yixv8fx1gd1kEtOrf-1j8YYwtx6qA_KoIBCfmZjSnLxq7foRvtosWY&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM0jtY8cc-Gf99egMPXZO-N8jqLQKx9LsygHGO91Z36Ng&oe=6AE34CF8"}, {"file_name": "2bfit-update1.png", "id": "1273832591007574", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/491827725_1273832594340907_7679835096266954535_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f9toy4s3a8EQ7kNvwGNP377&_nc_oc=AdoWwEkPVhqG2xe8LQVmwQcgaE8gH2Fd2eW0bRSL_SWGpVqaNDmO2mYkyGLSMOcIjYk&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPqpQ1jvo5DJ6XjkHOEmBO_B3KfuDYGOPlCbZSbyqjaxw&oe=6AE3438B"}, {"file_name": "2bfit-update3.png", "id": "4127365670925682", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499307311_4127365674259015_7679022573858290498_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CgqlkY61QNoQ7kNvwFYqfv1&_nc_oc=AdrwEBOnnexH8NsXkqCiOvAX7G1AUHe44vE31xPC2CoLf1dPhTdowWrMRnoTYuoidCw&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNxjtG9FX4ofZkQp6FFOatHqdvoHgUNrsyhGRPgmcqbcQ&oe=6AE33FDB"}, {"file_name": "2bfit-update4.png", "id": "4236623229995296", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/491827718_4236623233328629_551381304740174737_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-T-3cOWM9wAQ7kNvwHqHRbI&_nc_oc=AdolybUBXMQznkUQA1Ryc_bCy3LqDoLSORbqFsMFt91KN3M1aVdRjg-apEAKeS2qddc&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMJ-LfCIEfKfukjpZIrO9RsadP_-ryyFr_q4sT3JyBKAw&oe=6AE345FF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover-video.png", "id": "740381481685081", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499623569_740381485018414_2207102974461887046_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XGSaQ_C8TrEQ7kNvwGfyes_&_nc_oc=AdrYPycDIeHbiJBdn5SpmgmFn0g7l--rnyhOpEC1wYfQjb4LwnwDpFz4o0qDUk3_02k&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNHme9eTvEaVWULGwMWIGhpDNsdSl6bsxeeDALGubkx5Q&oe=6AE36F39"}, "display_name": "2bfit", "keywords": ["fit", "exercise", "fun", "stretch"], "long_description": "This is an easy way to exercise, especially the upper body.  You can focus longer and enjoy moving around when you can see balls to interact with.\nAfter a minute (or 60 seconds) you can feel my shoulders and arms a little bit.  And if you keep you feet in place (don't rotate), you can stretch more.  If you go through a wall, the 2bfit area moves along with you.  This makes it easy to stay in a clear area. Enjoy the burn.", "short_description": "To be fit, or not to be fit. That is the question. \nMove around and score points by catching balls that drop and rotate.\nOther balls just hang around. Try not moving your feet.  Don't forget the\nballs behind you.  See your surroundings while you get fit.  Move thru a wall to move your 2bfit area."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1lWHEKMjXnD5KMPReMX33Brbi3goEyEwAAFv75cz--QU/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "amre-amer.com", "support_website_url": null, "website_url": "https://amre-amer.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25023755790560223"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/491821954_2335969400139423_72605
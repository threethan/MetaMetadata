7kNvwGOKW15&_nc_oc=AdoQ40Oo2qTOhsSTJBYywIuq4Q10l8VxdJuR3-9IlAsw8VWDsWbo_vouVukosQu6yEM&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFzJl9cGK8Ia-8AxIglkO7cIr5jV3LdKskz2ajDiVb3lA&oe=6A92E178"}, {"file_name": "2bfit-update1.png", "id": "1273832591007574", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/491827725_1273832594340907_7679835096266954535_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dx_o-zzbANkQ7kNvwHuTYLw&_nc_oc=Adrhxre4folbe1DH-YPebcU0ftCA9Db9S2tzC0B7yap2v7fwPFdFdV68cKs59pbOqjU&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEkVf1cZltaCzR7SHd3-5NvMp8k_QyUg_fw-Jl456Xvbg&oe=6A92D80B"}, {"file_name": "2bfit-update3.png", "id": "4127365670925682", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/499307311_4127365674259015_7679022573858290498_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VpQpl-nn7Q0Q7kNvwF0MUI_&_nc_oc=AdpR7CXhdZrahfchKYx2Y-ygh11qcxKlF0ndGNjeArysLdkNS-1lNWGaJx7z0S8f0hE&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHu-WTvHd5IikewEpanPraZLWnGZAvMfdA862ectmYC4g&oe=6A92D45B"}, {"file_name": "2bfit-update4.png", "id": "4236623229995296", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491827718_4236623233328629_551381304740174737_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HJWUa1jV4esQ7kNvwEg945P&_nc_oc=AdpyY8qAOte-Kk1MdkJ5oKzosD6QdqqzAh56Y59PXiyk21bJFM8TZ2c1k21CQfZHr6I&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEeWoyTfcTYbxaO2_4KIQaLek7CIL5aoobsFZciKr_MTA&oe=6A92DA7F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover-video.png", "id": "740381481685081", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499623569_740381485018414_2207102974461887046_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WcJHjG7n2v0Q7kNvwGdYaYP&_nc_oc=AdoicRVJiD9kc4_pTC8RRQsGudjH77dkSmqgBSz8MFdbhGxksyVairsozEwkqvth-M4&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEcoXiwnwA4Mo1L2dPxIjs8v2qLJFbPxD5Bl4r0ljJqvg&oe=6A92CB79"}, "display_name": "2bfit", "keywords": ["fit", "exercise", "fun", "stretch"], "long_description": "This is an easy way to exercise, especially the upper body.  You can focus longer and enjoy moving around when you can see balls to interact with.\nAfter a minute (or 60 seconds) you can feel my shoulders and arms a little bit.  And if you keep you feet in place (don't rotate), you can stretch more.  If you go through a wall, the 2bfit area moves along with you.  This makes it easy to stay in a clear area. Enjoy the burn.", "short_description": "To be fit, or not to be fit. That is the question. \nMove around and score points by catching balls that drop and rotate.\nOther balls just hang around. Try not moving your feet.  Don't forget the\nballs behind you.  See your surroundings while you get fit.  Move thru a wall to move your 2bfit area."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1lWHEKMjXnD5KMPReMX33Brbi3goEyEwAAFv75cz--QU/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "amre-amer.com", "support_website_url": null, "website_url": "https://amre-amer.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25023755790560223"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491821954_2335969400139423_72605
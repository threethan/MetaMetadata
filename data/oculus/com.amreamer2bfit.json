7kNvwHQABCi&_nc_oc=Ado-VwMxDpz4cFfhPRbUC6QjsLh15bBcjkRUVYqLbd8ysZExtVBvsDyPxMpT9tdbtI4&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH3kkAqK0ag5zpdvv2sGLRUcEGfSVZsmxk_LbV1MAHQbg&oe=6A93FAB8"}, {"file_name": "2bfit-update1.png", "id": "1273832591007574", "uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/491827725_1273832594340907_7679835096266954535_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EmRlNNZ-Nm8Q7kNvwFMpXDy&_nc_oc=AdrGZzMU1kVn_Y3RhTWuqQbsPJ6KA4oInLxV84xAg0DJ0dapWCCNy0uRGFfprfxe9fw&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHjwf0GY3UaawzD_zgXdkorjx7qy_JjHiq_YCk5wYFIUA&oe=6A94298B"}, {"file_name": "2bfit-update3.png", "id": "4127365670925682", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/499307311_4127365674259015_7679022573858290498_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VpQpl-nn7Q0Q7kNvwHov8g-&_nc_oc=AdoT5WXvS7mWvcfd2DFklDVXUhBia9X0ZxiScUMx90PWk0J54Ow-aigXI9_w81JmHRs&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH1D-JQEK9omsPJ-eGYNiO6K7RTiaA7XN7l204Q-AXlGw&oe=6A9425DB"}, {"file_name": "2bfit-update4.png", "id": "4236623229995296", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/491827718_4236623233328629_551381304740174737_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HJWUa1jV4esQ7kNvwG7jvdj&_nc_oc=Adq0O1gRyceUzhZDxEPYVOLNrzbG2tJzC6LLx8q6JaaE89NP9d_y2vCEABu9cwW8oK4&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFBTr7Tp4TQdHsmq4cB-DqV_2LYMM1BSASRcqzswf38sg&oe=6A942BFF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover-video.png", "id": "740381481685081", "uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/499623569_740381485018414_2207102974461887046_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rTcR1CfVXFMQ7kNvwHX3LS5&_nc_oc=Adr5GvRjKbrPKMQ5kjknRyNMDT0H3_ocMB67qZwU31agfXLV7J__t1as2omvEg50sNg&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQESRNNhDCESkBQQ9RVSxHRsnUiiBuPNZ6nZYc-7hc-SKA&oe=6A941CF9"}, "display_name": "2bfit", "keywords": ["fit", "exercise", "fun", "stretch"], "long_description": "This is an easy way to exercise, especially the upper body.  You can focus longer and enjoy moving around when you can see balls to interact with.\nAfter a minute (or 60 seconds) you can feel my shoulders and arms a little bit.  And if you keep you feet in place (don't rotate), you can stretch more.  If you go through a wall, the 2bfit area moves along with you.  This makes it easy to stay in a clear area. Enjoy the burn.", "short_description": "To be fit, or not to be fit. That is the question. \nMove around and score points by catching balls that drop and rotate.\nOther balls just hang around. Try not moving your feet.  Don't forget the\nballs behind you.  See your surroundings while you get fit.  Move thru a wall to move your 2bfit area."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1lWHEKMjXnD5KMPReMX33Brbi3goEyEwAAFv75cz--QU/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "amre-amer.com", "support_website_url": null, "website_url": "https://amre-amer.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25023755790560223"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/491821954_2335969400139423_72605
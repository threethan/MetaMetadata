gJhY&_nc_oc=AdqIPclY6IqtVPVhUn5g3tSW7hDsxAwvWiCzUDZ6KHGuN9ogP9FEztKtdflY5JpQDzM&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG8_MH6gICH4sPo1rK_eIFsPICWbVA4UEMgFZff00skAg&oe=6A804B3E"}, {"file_name": "screenshot-0.png", "id": "711374158163846", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/491819934_711374161497179_5219986979726633511_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3hFMllXP13cQ7kNvwGZ18AS&_nc_oc=Adr_tqYr5c7dmB55yS0lDbrT247xUdyA588TuMYHBVtoMS-SXDjiUGSWKUWa928Ie6c&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF2x1h-qULHczmBgVymzGa5-rcik8afOXKZgNu6ynHG_A&oe=6A8061CD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover-video.png", "id": "740381481685081", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/499623569_740381485018414_2207102974461887046_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QLo4ZZBi4eMQ7kNvwFqoVR-&_nc_oc=Adov5S-KfYhA1ah6lE9XO22_Qi6aWoyphnqfvW3uHi6lSv8_Y8GxtZ0QknnMqGfdWto&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEhUbM9jR3E8-iRRGtaAQbgHyp_MMoJSSCQZgbyC8lLRQ&oe=6A805679"}, "display_name": "2bfit", "keywords": ["fit", "exercise", "fun", "stretch"], "long_description": "This is an easy way to exercise, especially the upper body.  You can focus longer and enjoy moving around when you can see balls to interact with.\nAfter a minute (or 60 seconds) you can feel my shoulders and arms a little bit.  And if you keep you feet in place (don't rotate), you can stretch more.  If you go through a wall, the 2bfit area moves along with you.  This makes it easy to stay in a clear area. Enjoy the burn.", "short_description": "To be fit, or not to be fit. That is the question. \nMove around and score points by catching balls that drop and rotate.\nOther balls just hang around. Try not moving your feet.  Don't forget the\nballs behind you.  See your surroundings while you get fit.  Move thru a wall to move your 2bfit area."}]}, "developer
/491819934_711374161497179_5219986979726633511_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZrRLIEtPdqAQ7kNvwEj4APR&_nc_oc=AdleleYfrHakHTKBAGPOJazk-durdY5E0Wu98S14dZF1B62qUhvOTM2lywp8mcoQJcM&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_AfvNCyxaGWAcT51-w2CHGa89e4p4Jen3xKCvV__RfTwbRQ&oe=69A588CD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover-video.png", "id": "740381481685081", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499623569_740381485018414_2207102974461887046_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hornVAEM2V4Q7kNvwF1Lnb7&_nc_oc=Adk_nczAPw4g3d-3gj0XNSeLCi0ZAndFOR0vuaraM0D0Tv3zrWlUMLn2G8OQwkAWRJU&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&oh=00_AfvGiFCRDscWcjXFhiZwlq_FkOi0rAYRd2d2OSlOFURumQ&oe=69A57D79"}, "display_name": "2bfit", "keywords": ["fit", "exercise", "fun", "stretch"], "long_description": "This is an easy way to exercise, especially the upper body.  You can focus longer and enjoy moving around when you can see balls to interact with.\nAfter a minute (or 60 seconds) you can feel my shoulders and arms a little bit.  And if you keep you feet in place (don't rotate), you can stretch more.  If you go through a wall, the 2bfit area moves along with you.  This makes it easy to stay in a clear area. Enjoy the burn.", "short_description": "To be fit, or not to be fit. That is the question. \nMove around and score points by catching balls that drop and rotate.\nOther balls just hang around. Try not moving your feet.  Don't forget the\nballs behind you.  See your surroundings while you get fit.  Move thru a wall to move your 2bfit area."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1lWHEKMjXnD5KMPReMX33Brbi3goEyEwAAFv75cz--QU/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "amre-amer.com", "support_website_url": null, "website_url": "https://amre-amer.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", 
c=F_fivJg0bx0Q7kNvwEXFP3z&_nc_oc=Adph3RjsYZOB7A7_1nbH1YY1a6rMSNYTpZW6fYhFjSY_C52W1UXvgMtWkp-5MpuujA0&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQISsmD381oaZB-AxXei-3wytKy_DZkClrziTbpKSyiBLQ&oe=6AA94AF8"}, {"file_name": "2bfit-update1.png", "id": "1273832591007574", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/491827725_1273832594340907_7679835096266954535_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=puNeuuSq_eUQ7kNvwEHdXAX&_nc_oc=Adpn_qxSKr26m-oUQBjhudWvQ0STULDxUkeecihNoAgBtxGo6a11X_gG36Rkl-LU2ug&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLaVOFQCpxRn9ljh-vM4StVEGNFCKhNOPqeqZHUmYrRsw&oe=6AA9418B"}, {"file_name": "2bfit-update3.png", "id": "4127365670925682", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/499307311_4127365674259015_7679022573858290498_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TrLzMF_i_EUQ7kNvwHYrWxc&_nc_oc=AdpuH05ZF4EqbDlAeoRSgC-nvTqDxTuaWk7S0BZL5pGTDZ7GaF9OloiNjGm-9gUooGY&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL2dYXtTK8nA-oHYwWII5QuJWK1OW9sE2c6P1rOGMvfHQ&oe=6AA93DDB"}, {"file_name": "2bfit-update4.png", "id": "4236623229995296", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/491827718_4236623233328629_551381304740174737_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jDWtgFKNplMQ7kNvwF_s2QN&_nc_oc=Adp8bxpKqyrTWp7ZaDCDGdlNtY-x0Q080lhrB_Gr6A9xUMPFKg_378tHpZq1DxvciA8&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJmJH1doXbGBoK_6E-KB1YP4GfW3ULWIxS34mi7Q8armg&oe=6AA943FF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover-video.png", "id": "740381481685081", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/499623569_740381485018414_2207102974461887046_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PCjJY4cJOuoQ7kNvwF650wR&_nc_oc=Adps9ZsephpR2WHA8BsU3OMQy1NIWxTylIr9Lxv43B113ekNLzZU_iwB2hDEwnhaFvg&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIEVH2cHew6XE0-bIppLGidS9BN5A3LtlNGA1iUEDijfw&oe=6AA934F9"}, "display_name": "2bfit", "keywords": ["fit", "exercise", "fun", "stretch"], "long_description": "This is an easy way to exercise, especially the upper body.  You can focus longer and enjoy moving around when you can see balls to interact with.\nAfter a minute (or 60 seconds) you can feel my shoulders and arms a little bit.  And if you keep you feet in place (don't rotate), you can stretch more.  If you go through a wall, the 2bfit area moves along with you.  This makes it easy to stay in a clear area. Enjoy the burn.", "short_description": "To be fit, or not to be fit. That is the question. \nMove around and score points by catching balls that drop and rotate.\nOther balls just hang around. Try not moving your feet.  Don't forget the\nballs behind you.  See your surroundings while you get fit.  Move thru a wall to move your 2bfit area."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1lWHEKMjXnD5KMPReMX33Brbi3goEyEwAAFv75cz--QU/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "amre-amer.com", "support_website_url": null, "website_url": "https://amre-amer.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25023755790560223"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/491821954_233
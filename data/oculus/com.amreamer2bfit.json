7kNvwHyVdlf&_nc_oc=Ado7goCfWwC1vSx0RrXY7F7jEQgv8ExJRutNlnTVCQI5nDtyUVtvSjZL2EOqFk8j41k&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKrCZXLXdqjm3A5INsaayHIUk2KqRmwqXROOGTW7Wv3Lg&oe=6A9ACA78"}, {"file_name": "2bfit-update1.png", "id": "1273832591007574", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/491827725_1273832594340907_7679835096266954535_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=514zOIRikrUQ7kNvwGwyoBl&_nc_oc=AdpzncEI9PfeQh6ZEr90V6REpc9-xH3ieOBfHXwCPaizBZbc99DiudGJ33fdalmlaNw&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKE_cEmfAtMEfyjbifAQg-v1s6Y5KqFV0JVsSRWjOXI8Q&oe=6A9AC10B"}, {"file_name": "2bfit-update3.png", "id": "4127365670925682", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499307311_4127365674259015_7679022573858290498_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r1wRZ3H3UjsQ7kNvwG9RdNH&_nc_oc=AdqMQ1p2JVZuNz-de6VPcHOUgY2UibG6GpMUz9xBom9CdJnNN0bQN34qJF6ToJBjjS4&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKSBx5_vudkh2kdoXd9EDhKVxWGe3FSwZJXE3i_cWzVPg&oe=6A9AF59B"}, {"file_name": "2bfit-update4.png", "id": "4236623229995296", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/491827718_4236623233328629_551381304740174737_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ExhrpQ_KrmYQ7kNvwEKXTEU&_nc_oc=AdrKwwbrpsut_A3GgYkEfEvribeNURYrgotbLRz-wxDHHrwu6KHFQe4CZsLN5cM-I5U&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKdHM0mLLxpcW7RAvbFsVvXNMJ3NIBFyzJbUlLelGWiKA&oe=6A9AC37F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover-video.png", "id": "740381481685081", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499623569_740381485018414_2207102974461887046_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7htFOmlReTsQ7kNvwE2lghd&_nc_oc=AdpO9T6L92Pp9LstMhWGcfHXgyEeuwpaXb9cDaQNYsVVYTVq-JjK1qZWXvGYd-xNhqc&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLduu5V4bNAUXtgg5CbERUeobqLi_Ac2qu4fh_RSr56cQ&oe=6A9AECB9"}, "display_name": "2bfit", "keywords": ["fit", "exercise", "fun", "stretch"], "long_description": "This is an easy way to exercise, especially the upper body.  You can focus longer and enjoy moving around when you can see balls to interact with.\nAfter a minute (or 60 seconds) you can feel my shoulders and arms a little bit.  And if you keep you feet in place (don't rotate), you can stretch more.  If you go through a wall, the 2bfit area moves along with you.  This makes it easy to stay in a clear area. Enjoy the burn.", "short_description": "To be fit, or not to be fit. That is the question. \nMove around and score points by catching balls that drop and rotate.\nOther balls just hang around. Try not moving your feet.  Don't forget the\nballs behind you.  See your surroundings while you get fit.  Move thru a wall to move your 2bfit area."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1lWHEKMjXnD5KMPReMX33Brbi3goEyEwAAFv75cz--QU/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "amre-amer.com", "support_website_url": null, "website_url": "https://amre-amer.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25023755790560223"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/491821954_2335969400139423_72605
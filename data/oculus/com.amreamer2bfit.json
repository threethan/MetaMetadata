7kNvwGchkQH&_nc_oc=AdpEO7xOYNDLEA0-_AfrwrUW8XVE-Ee_KN270h9ImUIp4gBqH4a23OKM-7oSAqkfCHA&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxHyM_DUPBF1ln5rQun4FBks1VU43eVjzuBdPPJJCSn5Q&oe=69CFC378"}, {"file_name": "2bfit-update1.png", "id": "1273832591007574", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/491827725_1273832594340907_7679835096266954535_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n3bfKaRHRc0Q7kNvwHurAuM&_nc_oc=AdqD61LrWM2gEoZK4nGemBb_YiDVVTau11yNwqZ73idHyLLZiPLbA_fi_FYwxcYfJwQ&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxKrmo5YpgA8Rmk_XqggFSjD0ybyrdi6-r2vdWEeE11oQ&oe=69CFBA0B"}, {"file_name": "2bfit-update3.png", "id": "4127365670925682", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499307311_4127365674259015_7679022573858290498_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wr7oPLldXkgQ7kNvwF6n5Nv&_nc_oc=AdpLWDvopXtIGTtqkye_CvzwIlngULLh1Sa7qIFK9r0NegBJrXYA7rl7Q6FBJ_TeoC8&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afx9Mu-387hjj-J7I_Sre5bygnwKEXjsCfllwb1bgUn1Yg&oe=69CFB65B"}, {"file_name": "2bfit-update4.png", "id": "4236623229995296", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/491827718_4236623233328629_551381304740174737_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0Cas9jZJj6UQ7kNvwGoyT1h&_nc_oc=Adq1Jmlnrs9WtYgtmwOkEqMVuNHyGq9gQhfzFcyujCakfQ9hCmzwByiQ2pD7B10lKCw&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxFqxzizmChezsq5uTkvBaI1cdyTU4UQjHqfnkfU8TdtQ&oe=69CFBC7F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover-video.png", "id": "740381481685081", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499623569_740381485018414_2207102974461887046_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TU3zrgQZs_cQ7kNvwEE3syG&_nc_oc=AdrUlhW1C68GaZzaa-Os4vkP6lKvinThlhVu88y_uMtzK2PIWb02znjDBzI0i0Jce58&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzEL6bxBkbR-c74Fl3cIdtaY1mtsRfxg9jqV97mF4XJ3g&oe=69CFAD79"}, "display_name": "2bfit", "keywords": ["fit", "exercise", "fun", "stretch"], "long_description": "This is an easy way to exercise, especially the upper body.  You can focus longer and enjoy moving around when you can see balls to interact with.\nAfter a minute (or 60 seconds) you can feel my shoulders and arms a little bit.  And if you keep you feet in place (don't rotate), you can stretch more.  If you go through a wall, the 2bfit area moves along with you.  This makes it easy to stay in a clear area. Enjoy the burn.", "short_description": "To be fit, or not to be fit. That is the question. \nMove around and score points by catching balls that drop and rotate.\nOther balls just hang around. Try not moving your feet.  Don't forget the\nballs behind you.  See your surroundings while you get fit.  Move thru a wall to move your 2bfit area."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1lWHEKMjXnD5KMPReMX33Brbi3goEyEwAAFv75cz--QU/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "amre-amer.com", "support_website_url": null, "website_url": "https://amre-amer.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25023755790560223"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/491821954_2335969400139423_72605
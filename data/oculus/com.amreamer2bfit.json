l6dU&_nc_oc=Adoa0lSer78_lNUiFprCLch-aHVL3j_Zcz-nLQ_fJ_Bg6X6H4eBGjNb48qiLJjYFdvg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC8bHrkJcEHHchf3tuNmVKnIAyKVdzUcnfTHWV0f7tQJw&oe=6A5F55BE"}, {"file_name": "screenshot-0.png", "id": "711374158163846", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491819934_711374161497179_5219986979726633511_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Kx74Bfm11EYQ7kNvwEIv1HB&_nc_oc=AdoKYhzjXRe_zBTOG0mpoIuaHk9KiVprIf07s5DABx5TcXynOj7hd6XWeiuIg3ngk4c&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQANc6Xi-x74uOJhua5U6aMzbKmmU-hymUqyw0TPMl_1-Q&oe=6A5F6C4D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover-video.png", "id": "740381481685081", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499623569_740381485018414_2207102974461887046_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LLqs2yyV4PwQ7kNvwE_LXuH&_nc_oc=Ado4uIC7vzCge8AZWSLwzLslqSxwLk42sB54Myzyie3u528mS9Bs6UEkokkYGIe7vKg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBjXSfPsQ3z8NkmhUOYPayHRQWd5a5eMwZf0Y8i8WonGA&oe=6A5F60F9"}, "display_name": "2bfit", "keywords": ["fit", "exercise", "fun", "stretch"], "long_description": "This is an easy way to exercise, especially the upper body.  You can focus longer and enjoy moving around when you can see balls to interact with.\nAfter a minute (or 60 seconds) you can feel my shoulders and arms a little bit.  And if you keep you feet in place (don't rotate), you can stretch more.  If you go through a wall, the 2bfit area moves along with you.  This makes it easy to stay in a clear area. Enjoy the burn.", "short_description": "To be fit, or not to be fit. That is the question. \nMove around and score points by catching balls that drop and rotate.\nOther balls just hang around. Try not moving your feet.  Don't forget the\nballs behind you.  See your surroundings while you get fit.  Move thru a wall to move your 2bfit area."}]}, "developer
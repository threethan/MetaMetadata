YfXf&_nc_oc=AdrHUHljaeXO3l3j7SgbwFxkW2oziOsSO5nnExxOrLs8A6VZ4L-p_XkKW5PG5xbUYXw&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMVLCgzK-0l5gNUfpEyDUVloHcIdLXNq632GGzWtuRADg&oe=6AE2127E"}, {"file_name": "screenshot-0.png", "id": "711374158163846", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491819934_711374161497179_5219986979726633511_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1HmZalQvCrcQ7kNvwGOEtoe&_nc_oc=Adq1gOa06hs_BRbWupP3kny20bLxd2KsqdR1PMtgSfjCcsBPnx4e4P79K7pQfmRfBRg&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOa1e1LPlW9Q0nbNDmQg144awnRHd-BiJCXbBROTbV9Iw&oe=6AE1F0CD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover-video.png", "id": "740381481685081", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499623569_740381485018414_2207102974461887046_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Srr2KZB8lpEQ7kNvwHUYZTr&_nc_oc=AdrH_BlPsHkKuJcpc8hRKT5dHxbkyemyOwYTemkf1ETbbsVC9jnUe_BB9Csl3kjNpIs&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPkrZGLNo9Tqq1BSFc7G9dtR61npOdfx2GmL3UBYPnyXA&oe=6AE1E579"}, "display_name": "2bfit", "keywords": ["fit", "exercise", "fun", "stretch"], "long_description": "This is an easy way to exercise, especially the upper body.  You can focus longer and enjoy moving around when you can see balls to interact with.\nAfter a minute (or 60 seconds) you can feel my shoulders and arms a little bit.  And if you keep you feet in place (don't rotate), you can stretch more.  If you go through a wall, the 2bfit area moves along with you.  This makes it easy to stay in a clear area. Enjoy the burn.", "short_description": "To be fit, or not to be fit. That is the question. \nMove around and score points by catching balls that drop and rotate.\nOther balls just hang around. Try not moving your feet.  Don't forget the\nballs behind you.  See your surroundings while you get fit.  Move thru a wall to move your 2bfit area."}]}, "developer
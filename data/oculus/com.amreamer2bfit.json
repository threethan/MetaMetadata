yRIzEPlUQ7kNvwGgXTQh&_nc_oc=AdoFW8XnQXj7_M77uX96c3Ro2cW55yzOl2cYOtVapvoovGCAkjT4-6l8iwchnHOM1V4&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE3EMxhNTf3wcXXixmnESrEkv7k5OnNHR8tXwp0uXuxCg&oe=6A857A38"}, {"file_name": "2bfit-update1.png", "id": "1273832591007574", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/491827725_1273832594340907_7679835096266954535_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BXUyDmQpIpkQ7kNvwGkOVmf&_nc_oc=AdpGGGbTyVG8Yk2dY0HGYKC-MpNxno4FHqWicKjLU0hOQTkbnlEBd_8W8mxxwXqjA-w&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHB8h3edTQoyFZ1hoLaDzpjHOLenymOE0DSoZH_guklfw&oe=6A85A90B"}, {"file_name": "2bfit-update3.png", "id": "4127365670925682", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/499307311_4127365674259015_7679022573858290498_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pmt2XyyG1M0Q7kNvwHiocWq&_nc_oc=AdqcyhmVuN6Djd-UHkGJBdj90-OuTw4Px87Efu7gcsIjsjEpeoIUpZ0bv3qOvmOZ3pQ&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE5_znsVAjqgpalpkoYB2E9FzQn1HgaVhytpESUxgYaXg&oe=6A85A55B"}, {"file_name": "2bfit-update4.png", "id": "4236623229995296", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/491827718_4236623233328629_551381304740174737_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uOWagvY543YQ7kNvwEKtxQX&_nc_oc=AdqHD5bJdeCMBeg1dkbLhHqRpSe8ipzuQLtzTrdXncItZz94e40k42JDi61qcmJ_Lv4&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH80JLbCEKxmiS8TeOAeZwaWsICJbTxs6KvsB8MiB_GMw&oe=6A85AB7F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover-video.png", "id": "740381481685081", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/499623569_740381485018414_2207102974461887046_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OatdeMN6BNQQ7kNvwFb7U30&_nc_oc=Adp8KEFoP4TQsK3Hl_p58u-C5NGLSKUr0mfju0ztHtkw6DTsscx4BxdBLRMwoOJNTzY&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFbIpszadGYjHUUdXKPRNOVwq64f37Jm5c0p2OpgW8q_w&oe=6A859C79"}, "display_name": "2bfit", "keywords": ["fit", "exercise", "fun", "stretch"], "long_description": "This is an easy way to exercise, especially the upper body.  You can focus longer and enjoy moving around when you can see balls to interact with.\nAfter a minute (or 60 seconds) you can feel my shoulders and arms a little bit.  And if you keep you feet in place (don't rotate), you can stretch more.  If you go through a wall, the 2bfit area moves along with you.  This makes it easy to stay in a clear area. Enjoy the burn.", "short_description": "To be fit, or not to be fit. That is the question. \nMove around and score points by catching balls that drop and rotate.\nOther balls just hang around. Try not moving your feet.  Don't forget the\nballs behind you.  See your surroundings while you get fit.  Move thru a wall to move your 2bfit area."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1lWHEKMjXnD5KMPReMX33Brbi3goEyEwAAFv75cz--QU/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "amre-amer.com", "support_website_url": null, "website_url": "https://amre-amer.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25023755790560223"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/491821954_23359694
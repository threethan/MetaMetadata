7kNvwFkzLwE&_nc_oc=AdoduaPvOvX5-clZyLDVOopTMJ8AA-_h5ky0_SwyEwo_747wKNhE3KI3TjMfsiU-UrI&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6MGZOX_eCKyvC6Xu76AGX4aanK3BXyPqhlDjhLG7S0GA&oe=6A09C578"}, {"file_name": "2bfit-update1.png", "id": "1273832591007574", "uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/491827725_1273832594340907_7679835096266954535_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bcFHxqEXnykQ7kNvwFUACRs&_nc_oc=Adr_Nc82cvbgEwf7IxNZU4l39KrrbASg9FmANRpXe3zCuQljZZfMJYpko5ihRC0VXQY&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7mHUiYkkcf4Hp1ocer1yLM5OnKt4lLMuicGqm81zcC8Q&oe=6A09BC0B"}, {"file_name": "2bfit-update3.png", "id": "4127365670925682", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/499307311_4127365674259015_7679022573858290498_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8ZQVE_1eflwQ7kNvwG2OUFr&_nc_oc=AdpywZOjqQQvifBgxYj6_7DhKWvG2tXCH4-HtYItEtspXyBUNJP4aa7taFw1zs9mHRY&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af60evEkV6Bx55fqGgYFTUB3NFHSTIeUFgjLgFxw7v3AEQ&oe=6A09B85B"}, {"file_name": "2bfit-update4.png", "id": "4236623229995296", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/491827718_4236623233328629_551381304740174737_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5FLbsrzlzLcQ7kNvwEVGJVW&_nc_oc=Ado2ayHjv4zRZL2u02mKUnaHYeKHGblYE3xOfhTPpGx73xhiC_Qn2GqraOsdlox1gcc&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6YXYZACFIZ7hNPILazI5fIFtX8YrI5-yDfckQMnSSRmA&oe=6A09BE7F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover-video.png", "id": "740381481685081", "uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/499623569_740381485018414_2207102974461887046_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0xI966oUO_0Q7kNvwEJ4L_Y&_nc_oc=Adp5fTXJfaLBjWeVpeCQLcbROLPJFNYI72zyXo4J67QOaHwkxO9juupPmqonnHUv1os&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5833mbH9-70RgQsN6tM8vOj4tD0mQwlphpvEEnVwoGYg&oe=6A09AF79"}, "display_name": "2bfit", "keywords": ["fit", "exercise", "fun", "stretch"], "long_description": "This is an easy way to exercise, especially the upper body.  You can focus longer and enjoy moving around when you can see balls to interact with.\nAfter a minute (or 60 seconds) you can feel my shoulders and arms a little bit.  And if you keep you feet in place (don't rotate), you can stretch more.  If you go through a wall, the 2bfit area moves along with you.  This makes it easy to stay in a clear area. Enjoy the burn.", "short_description": "To be fit, or not to be fit. That is the question. \nMove around and score points by catching balls that drop and rotate.\nOther balls just hang around. Try not moving your feet.  Don't forget the\nballs behind you.  See your surroundings while you get fit.  Move thru a wall to move your 2bfit area."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1lWHEKMjXnD5KMPReMX33Brbi3goEyEwAAFv75cz--QU/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "amre-amer.com", "support_website_url": null, "website_url": "https://amre-amer.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25023755790560223"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/491821954_2335969400139423_72605
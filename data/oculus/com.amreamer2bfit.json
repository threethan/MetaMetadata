cqCt&_nc_oc=AdqPULk8TZpVsGJrSYTUMlg8Y_Gmcm6YNlrJdkBJpI6pklfpXsFHvbSlcOz_r6qiilg&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQItoNOOS4VdiOptf6a-G9d_9MGFaoNtmoiVUp9_IX6tnQ&oe=6AB14AFE"}, {"file_name": "screenshot-0.png", "id": "711374158163846", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491819934_711374161497179_5219986979726633511_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=apN2UzrQSxkQ7kNvwEBZ86t&_nc_oc=AdpitCjxJ7-y_kG4kAy9fQimU0jYbbk4anY2iDDYE5jJUPGfIL2MBEw8IxoQMN0ltmk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKFEDAMP_vJFyLQRRX3o2ybtjdfDF72FVFBjmPSQJAeBA&oe=6AB1294D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover-video.png", "id": "740381481685081", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499623569_740381485018414_2207102974461887046_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fziTdaYhTLYQ7kNvwGpONgg&_nc_oc=AdrlozxpDGZ6N-MyRPXu2xGlBS3gIMNPR5_Zkp5XHMJkRc-JNZfEHv6g97x6fywqoI8&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL7ZEXmdk-2XXnQtLar2HoaEHmXD1QONDV9gcZop3nOUA&oe=6AB15639"}, "display_name": "2bfit", "keywords": ["fit", "exercise", "fun", "stretch"], "long_description": "This is an easy way to exercise, especially the upper body.  You can focus longer and enjoy moving around when you can see balls to interact with.\nAfter a minute (or 60 seconds) you can feel my shoulders and arms a little bit.  And if you keep you feet in place (don't rotate), you can stretch more.  If you go through a wall, the 2bfit area moves along with you.  This makes it easy to stay in a clear area. Enjoy the burn.", "short_description": "To be fit, or not to be fit. That is the question. \nMove around and score points by catching balls that drop and rotate.\nOther balls just hang around. Try not moving your feet.  Don't forget the\nballs behind you.  See your surroundings while you get fit.  Move thru a wall to move your 2bfit area."}]}, "developer
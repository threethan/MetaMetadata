7kNvwEJekJV&_nc_oc=AdoNKRrq3jT5lZs5U_6rugYHG7stqyemlGZo4iUWyFbT1allMgxWVNfC_J9tWu1rtGE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHOCq51Q6OiT7g_IhhdhFYpaTBvTQ40RDIb9hCM4F5rqQ&oe=6A8460F8"}, {"file_name": "2bfit-update1.png", "id": "1273832591007574", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491827725_1273832594340907_7679835096266954535_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BXUyDmQpIpkQ7kNvwH0J05O&_nc_oc=AdpnYAvm5OvDX4DZz8yXzzm9txHjET-fTj6yh2MeHBdpg5rSyOLq9OJwOSbOWOzY6Cs&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGfT26aMCROVuo7yPYCP6MGal2vAMlrJY9tZPDFygxtxw&oe=6A84578B"}, {"file_name": "2bfit-update3.png", "id": "4127365670925682", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499307311_4127365674259015_7679022573858290498_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rGGX2ASV9r0Q7kNvwGvSVNs&_nc_oc=Adrb3HYAFt_RbZXXNPG7u_F5U_0grSWLAcL29USzzmTDcSJL8x_Rs57ATkPduphUmT4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFkpNZGDFa7ylHEINc6NfOgR7sa1A0XF4kGKXHVa938kA&oe=6A8453DB"}, {"file_name": "2bfit-update4.png", "id": "4236623229995296", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491827718_4236623233328629_551381304740174737_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uOWagvY543YQ7kNvwGL7bVc&_nc_oc=AdqK2SuVMMxzXPRcMv8Hm4aq2_07b3tb5WrWNjXW9ufuzBbLqnEMLR7jrRnigFNBOJ0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG6mJANGRFZ36X863TdQGMiqa4RWnaf0oqLygczQaPFfA&oe=6A8459FF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover-video.png", "id": "740381481685081", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499623569_740381485018414_2207102974461887046_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OatdeMN6BNQQ7kNvwGzaaCD&_nc_oc=AdrOFPL3L1PW9TWqvRp0ic3A2VOE3m-k_jrQqh_UeC2vdj7sXYen-XMMQDyxQnoEtCA&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHWtEiFL_DccIuzeSlwJdVohjLfQRhpQ3R77WtQGufqhA&oe=6A844AF9"}, "display_name": "2bfit", "keywords": ["fit", "exercise", "fun", "stretch"], "long_description": "This is an easy way to exercise, especially the upper body.  You can focus longer and enjoy moving around when you can see balls to interact with.\nAfter a minute (or 60 seconds) you can feel my shoulders and arms a little bit.  And if you keep you feet in place (don't rotate), you can stretch more.  If you go through a wall, the 2bfit area moves along with you.  This makes it easy to stay in a clear area. Enjoy the burn.", "short_description": "To be fit, or not to be fit. That is the question. \nMove around and score points by catching balls that drop and rotate.\nOther balls just hang around. Try not moving your feet.  Don't forget the\nballs behind you.  See your surroundings while you get fit.  Move thru a wall to move your 2bfit area."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1lWHEKMjXnD5KMPReMX33Brbi3goEyEwAAFv75cz--QU/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "amre-amer.com", "support_website_url": null, "website_url": "https://amre-amer.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25023755790560223"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491821954_2335969400139423_72605
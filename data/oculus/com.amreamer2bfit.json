u-l2&_nc_oc=AdpKlBRSAFU4jh2wctF9o17yL0gbr5sqzGn5hhIlrS2onGCMRhta1RxYaNYx9bdJ7gg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH_E1GrvX5umV5UGX2HbpL_22dvztsFC8q9u-iH0ddc8g&oe=6A7C56BE"}, {"file_name": "screenshot-0.png", "id": "711374158163846", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491819934_711374161497179_5219986979726633511_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vbjiQPpA_4UQ7kNvwGieBRU&_nc_oc=AdrrIFIz5uZOjdkmz8VbIqv2h8c1FfmLOWJzvjqw91HJd-GZfl_VNl_kFyvo9lu2mJ0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHeyzwcsZJQ4DabkHMRA6-hSISZc8P6E1VD1dOYGRN51w&oe=6A7C6D4D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover-video.png", "id": "740381481685081", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499623569_740381485018414_2207102974461887046_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Yq1bXh-8T60Q7kNvwERxcvp&_nc_oc=AdrIA8Dgbt8FyFZgc6yM7qZBjCd4D2yhwAHTYOhbOG7pFt6U3aRseERJ-0smy9QBE5Q&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH_6vAXBR7LlFKDqNwTGtJzvQW8ngRG5zFaLBx84sjXJA&oe=6A7C61F9"}, "display_name": "2bfit", "keywords": ["fit", "exercise", "fun", "stretch"], "long_description": "This is an easy way to exercise, especially the upper body.  You can focus longer and enjoy moving around when you can see balls to interact with.\nAfter a minute (or 60 seconds) you can feel my shoulders and arms a little bit.  And if you keep you feet in place (don't rotate), you can stretch more.  If you go through a wall, the 2bfit area moves along with you.  This makes it easy to stay in a clear area. Enjoy the burn.", "short_description": "To be fit, or not to be fit. That is the question. \nMove around and score points by catching balls that drop and rotate.\nOther balls just hang around. Try not moving your feet.  Don't forget the\nballs behind you.  See your surroundings while you get fit.  Move thru a wall to move your 2bfit area."}]}, "developer
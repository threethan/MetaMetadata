7kNvwF3Rh-A&_nc_oc=AdpsVZ3D2OTlvISGJOzmC2gMNBsvsc2pa9jGYXlUUiyf5Ffn8n50xV9vEqmvthAciNs&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAVEkbaqzXccS08GECgmXHnFPkxmT-1MvAQQuW_XN_6Dw&oe=6A5A30F8"}, {"file_name": "2bfit-update1.png", "id": "1273832591007574", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/491827725_1273832594340907_7679835096266954535_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=t8PKTh3FT3MQ7kNvwEkskom&_nc_oc=AdpWa9EZTPwLvLFeTpESmrb5bdWrm-bSQt06jvv-ZsHy08lVhrbLqYb10L7SgGB4xDI&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBnLbGfthsgh0ahkp-ft1jc_HXIhPbHnp2pM2Vm2Ffoew&oe=6A5A278B"}, {"file_name": "2bfit-update3.png", "id": "4127365670925682", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499307311_4127365674259015_7679022573858290498_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qlDGEUTNweMQ7kNvwGFW_Ur&_nc_oc=AdrM3VUZSNsnyHHtL5NiCXgsLQAaGZCzt3khG3H20Vx6hEooQzwqgnVw2xqvdxgxT44&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDXer-3kG1K4mOulBotrRm8IJcDr1LHnsEu1fxbjXISjA&oe=6A5A23DB"}, {"file_name": "2bfit-update4.png", "id": "4236623229995296", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/491827718_4236623233328629_551381304740174737_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hNsqiuBnSYsQ7kNvwH9cqPc&_nc_oc=AdoyvCcTFt3kUGb3gKc6SUSBFIFJ7ttIoFrPzdJUgBTZnC0XyzEmxQVPKcLrlGGYKKw&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDSV4QuGEdEYtou19dP-uXW3LkKvskcfwRQWDqFNt1HeA&oe=6A5A29FF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover-video.png", "id": "740381481685081", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499623569_740381485018414_2207102974461887046_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EmSBRnWCWZAQ7kNvwHzyrdv&_nc_oc=AdqxLD4z5fFaPLKTx1Z5EUk1SQZh0vu9Eut3GPzVIMG8OHGCUCWdXyEwOxuDpdWzSv4&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAyNUz545moXQ-3bZ_rgR8pgp7drxJp746dRAUT2LX0mA&oe=6A5A1AF9"}, "display_name": "2bfit", "keywords": ["fit", "exercise", "fun", "stretch"], "long_description": "This is an easy way to exercise, especially the upper body.  You can focus longer and enjoy moving around when you can see balls to interact with.\nAfter a minute (or 60 seconds) you can feel my shoulders and arms a little bit.  And if you keep you feet in place (don't rotate), you can stretch more.  If you go through a wall, the 2bfit area moves along with you.  This makes it easy to stay in a clear area. Enjoy the burn.", "short_description": "To be fit, or not to be fit. That is the question. \nMove around and score points by catching balls that drop and rotate.\nOther balls just hang around. Try not moving your feet.  Don't forget the\nballs behind you.  See your surroundings while you get fit.  Move thru a wall to move your 2bfit area."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1lWHEKMjXnD5KMPReMX33Brbi3goEyEwAAFv75cz--QU/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "amre-amer.com", "support_website_url": null, "website_url": "https://amre-amer.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25023755790560223"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/491821954_2335969400139423_72605
p418&_nc_oc=AdphI7AkTh4OKmIrey3jsHhpOhaWC2mjuN1p1-mfeX6a_A87cO9st8c7VNDO6q14FIU&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afz8A15zb-QF9mi3WE-Yvs-I-u3tCcJvovzOf84kNIVh-Q&oe=69C3C4BE"}, {"file_name": "screenshot-0.png", "id": "711374158163846", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/491819934_711374161497179_5219986979726633511_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nW1MgTGSpjsQ7kNvwEnC77B&_nc_oc=AdoAs4JtoBQwkYCa-ZKf4uAhg5OnSrhz6GspEd7XZY6_s-pqRXKIBpT0_fqzvQsK6Tc&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxxOJlVIn9Ef7aDPye8XDHx8NHe-X5h-ihiNBviuJPQBg&oe=69C3DB4D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover-video.png", "id": "740381481685081", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499623569_740381485018414_2207102974461887046_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Bd4f688JdV0Q7kNvwGmtLmL&_nc_oc=AdrhiUcpgIDJYSN9z7kLIV95b60NGDRcgkOzqayepENgxw0uIJEv0X3BO9C0xbPT3sY&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzH2DBJ-oe0HzRdBA7AfgWUPnbyxs7HNQF_mqxsCLuJ2w&oe=69C3CFF9"}, "display_name": "2bfit", "keywords": ["fit", "exercise", "fun", "stretch"], "long_description": "This is an easy way to exercise, especially the upper body.  You can focus longer and enjoy moving around when you can see balls to interact with.\nAfter a minute (or 60 seconds) you can feel my shoulders and arms a little bit.  And if you keep you feet in place (don't rotate), you can stretch more.  If you go through a wall, the 2bfit area moves along with you.  This makes it easy to stay in a clear area. Enjoy the burn.", "short_description": "To be fit, or not to be fit. That is the question. \nMove around and score points by catching balls that drop and rotate.\nOther balls just hang around. Try not moving your feet.  Don't forget the\nballs behind you.  See your surroundings while you get fit.  Move thru a wall to move your 2bfit area."}]}, "developer
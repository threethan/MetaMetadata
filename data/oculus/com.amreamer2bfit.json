epeR&_nc_oc=Adph9kjU1thgNvADmyI6pQufK4FHEtDg82Iqt2hyFVa2O0_3sRwxL7FeQOXlOH-Hq64&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6qBlp8QjiuWDGDJaeJcOjjf0gBABT1JMDOwjoO0Da0kg&oe=69FDFEFE"}, {"file_name": "screenshot-0.png", "id": "711374158163846", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/491819934_711374161497179_5219986979726633511_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hZjX_CH7_JgQ7kNvwHxOVn-&_nc_oc=AdqGcxtYOQrmL_Y1bcup_rv6rYsE-5JhmrlokjSJlZkiBUYUIO_mWNYtJjKJdD4_wgc&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4Q6mvc6aG1YVwAdpodmhCfAdKS88lVQAg2NWQPDbCoTA&oe=69FDDD4D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover-video.png", "id": "740381481685081", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499623569_740381485018414_2207102974461887046_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Gn3L-pjmJywQ7kNvwH7gARr&_nc_oc=Adp0_MPFxppZmoQ5ktFOneUbPufN2Hrqrp5u3dLCMN9VbOviZ1iXrrMksQaWd9BaOrA&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7HATR3WoLh40LLk-Hlnt0M1aBwdYX4yLSAsttVVeeqPw&oe=69FDD1F9"}, "display_name": "2bfit", "keywords": ["fit", "exercise", "fun", "stretch"], "long_description": "This is an easy way to exercise, especially the upper body.  You can focus longer and enjoy moving around when you can see balls to interact with.\nAfter a minute (or 60 seconds) you can feel my shoulders and arms a little bit.  And if you keep you feet in place (don't rotate), you can stretch more.  If you go through a wall, the 2bfit area moves along with you.  This makes it easy to stay in a clear area. Enjoy the burn.", "short_description": "To be fit, or not to be fit. That is the question. \nMove around and score points by catching balls that drop and rotate.\nOther balls just hang around. Try not moving your feet.  Don't forget the\nballs behind you.  See your surroundings while you get fit.  Move thru a wall to move your 2bfit area."}]}, "developer
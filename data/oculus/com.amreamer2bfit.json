7kNvwFWMByW&_nc_oc=AdrPjgFqTJIzLgrr0DQ4N5-1CeRMfDdIuDD834SI49q3Cmlfbbu3FIdp8zyecbYNMUc&_nc_zt=3&_nc_ht=scontent-lhr8-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1KHFjUVpIJKmHMPvhw8_1DLZmbaNOGeuwmeM13MVWqNg&oe=69E23878"}, {"file_name": "2bfit-update1.png", "id": "1273832591007574", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/491827725_1273832594340907_7679835096266954535_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vY0g6XQYFr0Q7kNvwHAcfO3&_nc_oc=AdqPnxxra3v_pBaBoiYQFUh0D4jxk3-VaBLcFwwbk5DwfPXZkyu1gHKmYTKv2IEzMFk&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af27W8PE3nUi3SVsSQzc1dwcALCC8PKrxRVeEZVNRiMEWQ&oe=69E22F0B"}, {"file_name": "2bfit-update3.png", "id": "4127365670925682", "uri": "https://scontent-lhr8-2.oculuscdn.com/v/t64.5771-25/499307311_4127365674259015_7679022573858290498_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0yCZl3R1fPkQ7kNvwGRzOkY&_nc_oc=AdoNl5Qu-l9znSPPTPZ5hRyDML_evMI-VpMy2d1wG--nMAWZ4suduBdScJmf0b31KDo&_nc_zt=3&_nc_ht=scontent-lhr8-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0tJXA5ORNGJaLv9g_ar58KXtSS7wk4Q9W1dGukEsEQXQ&oe=69E22B5B"}, {"file_name": "2bfit-update4.png", "id": "4236623229995296", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/491827718_4236623233328629_551381304740174737_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-gNGTpVgf38Q7kNvwH_uWkf&_nc_oc=Adoh2WELFXEyRMzJN2-v7M9WLsrXD77yIKXb9Z8kJaw8kc7TvyrkKE8dqUG2ZoCEq0I&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1aYIp5I2dt9yrmkc500uR894w6qiVqvM9zst-p1Yc_Ag&oe=69E2317F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover-video.png", "id": "740381481685081", "uri": "https://scontent-lhr8-2.oculuscdn.com/v/t64.5771-25/499623569_740381485018414_2207102974461887046_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SsxQ-88DhLMQ7kNvwFrB5B-&_nc_oc=AdrrU9k5L4hYQCCOx24KOCxD48K_kc33pEoHRu6otC1K9cRU-LFfjFxEOZFL-aMVTIs&_nc_zt=3&_nc_ht=scontent-lhr8-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2ppLpxNKpALHXsqSiEs7_LhU9pksbt8L24hhjOtYb-CA&oe=69E22279"}, "display_name": "2bfit", "keywords": ["fit", "exercise", "fun", "stretch"], "long_description": "This is an easy way to exercise, especially the upper body.  You can focus longer and enjoy moving around when you can see balls to interact with.\nAfter a minute (or 60 seconds) you can feel my shoulders and arms a little bit.  And if you keep you feet in place (don't rotate), you can stretch more.  If you go through a wall, the 2bfit area moves along with you.  This makes it easy to stay in a clear area. Enjoy the burn.", "short_description": "To be fit, or not to be fit. That is the question. \nMove around and score points by catching balls that drop and rotate.\nOther balls just hang around. Try not moving your feet.  Don't forget the\nballs behind you.  See your surroundings while you get fit.  Move thru a wall to move your 2bfit area."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1lWHEKMjXnD5KMPReMX33Brbi3goEyEwAAFv75cz--QU/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "amre-amer.com", "support_website_url": null, "website_url": "https://amre-amer.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25023755790560223"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lhr8-1.oculuscdn.com/v/t64.5771-25/491821954_2335969400139423_72605
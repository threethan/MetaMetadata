7kNvwGD1m0W&_nc_oc=AdoGwURpMbzsHxmGbbHWSDZuQ5AbQnc-BRbSbf6eDJoOoTUL3qLNJuwTRmZB9XDis3U&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3u36ye2B8iuDkXr8UJh4ptacdXwcmHZdP6N3eXUoChjg&oe=69F35BF8"}, {"file_name": "2bfit-update1.png", "id": "1273832591007574", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/491827725_1273832594340907_7679835096266954535_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=capl2qSQ8fkQ7kNvwEA2bhy&_nc_oc=Ado5QWo-1c0lP7t1GVMCCVr5U3FWoCocGFr88bCbu46sbxN7IsYyetFRrJfyk1MxaNk&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2TGJhvLlS-A42DNFgGHfukbSPnFNcfOiBsZFiV9mIO0w&oe=69F3528B"}, {"file_name": "2bfit-update3.png", "id": "4127365670925682", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499307311_4127365674259015_7679022573858290498_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L4_tG_7ur9kQ7kNvwE7iVIj&_nc_oc=AdqvBOAbemQLzVfwCgmOzEpum53uZLxpnAyLJsDfdzc83t2hhmVt6M6tED-Nv1Ilxhc&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1VfsGZW33cknHlwZp_cSReYoCtquNw5Jb8UEw7_FzWMg&oe=69F34EDB"}, {"file_name": "2bfit-update4.png", "id": "4236623229995296", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/491827718_4236623233328629_551381304740174737_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IxuXqcrgHt8Q7kNvwHT8Nr4&_nc_oc=Adrh07lMxo3SI_gJUz8ufgfEkjTGCaollWD9LxcjUkcDQrc7UYqy3DtfbcAA2KcltT4&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0_HsJ1zGWK7VFGsZNK7PZn76kbobUQMYvJUXm-zBHLLw&oe=69F354FF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover-video.png", "id": "740381481685081", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499623569_740381485018414_2207102974461887046_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3uLWII7BJeYQ7kNvwFRjjZ6&_nc_oc=Ado0sL7FHs-4qKIbme_TI5QXVTApSr66nmskVPqyONf1xkeFKt90DD7_xdwmD86YrGM&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2ZccJxBBHvgbAYrx8nlCR2M6BaftIgui4lAWFfIvQdMg&oe=69F345F9"}, "display_name": "2bfit", "keywords": ["fit", "exercise", "fun", "stretch"], "long_description": "This is an easy way to exercise, especially the upper body.  You can focus longer and enjoy moving around when you can see balls to interact with.\nAfter a minute (or 60 seconds) you can feel my shoulders and arms a little bit.  And if you keep you feet in place (don't rotate), you can stretch more.  If you go through a wall, the 2bfit area moves along with you.  This makes it easy to stay in a clear area. Enjoy the burn.", "short_description": "To be fit, or not to be fit. That is the question. \nMove around and score points by catching balls that drop and rotate.\nOther balls just hang around. Try not moving your feet.  Don't forget the\nballs behind you.  See your surroundings while you get fit.  Move thru a wall to move your 2bfit area."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1lWHEKMjXnD5KMPReMX33Brbi3goEyEwAAFv75cz--QU/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "amre-amer.com", "support_website_url": null, "website_url": "https://amre-amer.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25023755790560223"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/491821954_2335969400139423_72605
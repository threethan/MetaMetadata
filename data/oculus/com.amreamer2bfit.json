scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_Afza4NVNfSFqwjFqOeL3sAFNdpPDlXfV3P09EJUSBi9jbA&oe=69B14FBE"}, {"file_name": "screenshot-0.png", "id": "711374158163846", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491819934_711374161497179_5219986979726633511_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lnln-Keh-C8Q7kNvwHnuubu&_nc_oc=Adk38kzE_q6p9n_vhbU8u2qC6hqQbWgWMqqcwEbGjZxQ51YvJKGiNlgLsxMMAoxAvuc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_Afw3a_W77LZsdkZRMd9bhFogDhr2gUmQUuSTlFtHFlChKg&oe=69B1664D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover-video.png", "id": "740381481685081", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499623569_740381485018414_2207102974461887046_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fMRBYnXNL2IQ7kNvwE9btRv&_nc_oc=Adk6ljFDIjjpGfKzd-hC6pWGEjIumz6j6jfxhxXVZZQ1pYnKYPtgW0mCaoqeCey3PyU&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_Afz3xL09tf8E4MDoDFstVjnpRC43-zMfDkDMaxh_3NMfqA&oe=69B15AF9"}, "display_name": "2bfit", "keywords": ["fit", "exercise", "fun", "stretch"], "long_description": "This is an easy way to exercise, especially the upper body.  You can focus longer and enjoy moving around when you can see balls to interact with.\nAfter a minute (or 60 seconds) you can feel my shoulders and arms a little bit.  And if you keep you feet in place (don't rotate), you can stretch more.  If you go through a wall, the 2bfit area moves along with you.  This makes it easy to stay in a clear area. Enjoy the burn.", "short_description": "To be fit, or not to be fit. That is the question. \nMove around and score points by catching balls that drop and rotate.\nOther balls just hang around. Try not moving your feet.  Don't forget the\nballs behind you.  See your surroundings while you get fit.  Move thru a wall to move your 2bfit area."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1lWHEKMjXnD5KMPReMX33Brbi3
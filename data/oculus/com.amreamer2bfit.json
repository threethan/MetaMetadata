7kNvwGoWDhh&_nc_oc=AdrU0K5IisO6l6wo6DASjLav5jRojc7CV9ivwEY6ABzeaAuHOX_jC5WUlCWztsSFMmQ&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afxy-Lb6nDrMpohP2WxhRoMa9Z1YNPgCMGxRgmZ4bCT2hg&oe=69C53778"}, {"file_name": "2bfit-update1.png", "id": "1273832591007574", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/491827725_1273832594340907_7679835096266954535_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2Fl1bwJEQjIQ7kNvwG8NrNZ&_nc_oc=Adrh3vosxxfSh3zqxN0FvtlntRR8Ki7feFVQL_Qbr2PvVMQwKrTN7VbFqHPPhflrVa4&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afw1SV7HohGfS4wYbO0amqvDRjNnge_ZuSUf98KgCcKD2A&oe=69C52E0B"}, {"file_name": "2bfit-update3.png", "id": "4127365670925682", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499307311_4127365674259015_7679022573858290498_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wxhoI26X-mMQ7kNvwGzkSJ_&_nc_oc=AdqYkC0LlkVVPDUsOhVDbso0qxYG5Ax8BvBAs91-5s-_fBBOFTyswzeD2T9pZin_r9g&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzHOXpY1-KqqiOQJ3wLCghxya1EIUB7JxqF1pS77Vl-1Q&oe=69C52A5B"}, {"file_name": "2bfit-update4.png", "id": "4236623229995296", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/491827718_4236623233328629_551381304740174737_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XH6nEyREwEwQ7kNvwF5W4Ak&_nc_oc=AdrcuF9kpKcWxJs0WL8XjOsC09KC1qV8aDsS63t6YxEN29vgF6_8x_b3CSlbk6dsGH8&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afy1KixTxtfpaQLIrOs35NxRElNHuPqqwf5ZigBB_SWITw&oe=69C5307F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover-video.png", "id": "740381481685081", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499623569_740381485018414_2207102974461887046_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Bd4f688JdV0Q7kNvwHv6QYe&_nc_oc=AdqV08g6GSf5VcGLSSIdG1ks8rVO893Yylezk4cAzVqHv2Vh1y8UT25va1hMSaZGozo&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxIAZIfiKiDQS93ZmjXwxnBTgSLKV6MkUy9dYiG9GEjXw&oe=69C52179"}, "display_name": "2bfit", "keywords": ["fit", "exercise", "fun", "stretch"], "long_description": "This is an easy way to exercise, especially the upper body.  You can focus longer and enjoy moving around when you can see balls to interact with.\nAfter a minute (or 60 seconds) you can feel my shoulders and arms a little bit.  And if you keep you feet in place (don't rotate), you can stretch more.  If you go through a wall, the 2bfit area moves along with you.  This makes it easy to stay in a clear area. Enjoy the burn.", "short_description": "To be fit, or not to be fit. That is the question. \nMove around and score points by catching balls that drop and rotate.\nOther balls just hang around. Try not moving your feet.  Don't forget the\nballs behind you.  See your surroundings while you get fit.  Move thru a wall to move your 2bfit area."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1lWHEKMjXnD5KMPReMX33Brbi3goEyEwAAFv75cz--QU/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "amre-amer.com", "support_website_url": null, "website_url": "https://amre-amer.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25023755790560223"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/491821954_2335969400139423_72605
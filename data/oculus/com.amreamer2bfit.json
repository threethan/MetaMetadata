7kNvwFuogkW&_nc_oc=Adp9ch93gg4y0zWex_OEHXITjHezCfinCuXHNn9f5Ch8w50Mv1dB0iCOMD0KR-xFmp0&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQpGhYOvD47G3efanU761frzAPjPd8HNpVezDzMefm_Aw&oe=6AF9B678"}, {"file_name": "2bfit-update1.png", "id": "1273832591007574", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/491827725_1273832594340907_7679835096266954535_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vkIPx3WpriQQ7kNvwHDbvmn&_nc_oc=AdqX8FgmoqSVO6EMk6zbq1JX4qJIpL4oXe_yJ6WS5exUKJwPQ7HqTZia6QuVb6unf1Y&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRciUX7yXYA3Aubsxn_JfhFFph9yn6h76EHtU2fD5NczQ&oe=6AF9E54B"}, {"file_name": "2bfit-update3.png", "id": "4127365670925682", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499307311_4127365674259015_7679022573858290498_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xMicHLFNnlwQ7kNvwHH94rT&_nc_oc=Adq2K3VDlWNAjUURj5ROAV-R3wobwTGah-e1hc_Ulzqi1V0EQbZTn45xWDFn6Pm5rtY&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSaP0T009iymy13P1mVKSxoBMT2IWF6S65xVVEq-h9U2Q&oe=6AF9E19B"}, {"file_name": "2bfit-update4.png", "id": "4236623229995296", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/491827718_4236623233328629_551381304740174737_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xCY8LwppuIoQ7kNvwFmMmi9&_nc_oc=AdruSVD-qqg87SFYqlTQsW3kVC1n9lMjSjecEbBY97WjKgBTdZ5gpkz0kYVZA6PnabE&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRjcwuHGblQGuta66xKYKpvXtmUsPa68Nn297VfLnMasA&oe=6AF9E7BF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover-video.png", "id": "740381481685081", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499623569_740381485018414_2207102974461887046_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hLNfyfdyzJUQ7kNvwEfUzY8&_nc_oc=Adq8iFnk-YKNAS_p7H_FC9IL1sB_qytTZzxcmnD8X59oXcVS6kYv5ItFP175G7iet3Y&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSDEWRm68YpmrPfPWIP8PfZfybBPyC3XgIY6Uz03vMuCg&oe=6AF9D8B9"}, "display_name": "2bfit", "keywords": ["fit", "exercise", "fun", "stretch"], "long_description": "This is an easy way to exercise, especially the upper body.  You can focus longer and enjoy moving around when you can see balls to interact with.\nAfter a minute (or 60 seconds) you can feel my shoulders and arms a little bit.  And if you keep you feet in place (don't rotate), you can stretch more.  If you go through a wall, the 2bfit area moves along with you.  This makes it easy to stay in a clear area. Enjoy the burn.", "short_description": "To be fit, or not to be fit. That is the question. \nMove around and score points by catching balls that drop and rotate.\nOther balls just hang around. Try not moving your feet.  Don't forget the\nballs behind you.  See your surroundings while you get fit.  Move thru a wall to move your 2bfit area."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1lWHEKMjXnD5KMPReMX33Brbi3goEyEwAAFv75cz--QU/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "amre-amer.com", "support_website_url": null, "website_url": "https://amre-amer.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25023755790560223"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/491821954_2335969400139423_72605
dOwV&_nc_oc=AdrAJ-15bgEDh5oQY0wueJNqpSY7uHzgJlB_LFMHn9ls__eNo_6JReOiE01PJrq1NSg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIjKopS1OZ09M85QtFyqZTsC3b2-z0BYbvZ-gdLhkXDqQ&oe=6AA6BEFE"}, {"file_name": "screenshot-0.png", "id": "711374158163846", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491819934_711374161497179_5219986979726633511_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gjqmTAqQJJkQ7kNvwF4ibPe&_nc_oc=AdqK-SIYPj67RncgxMUXV0rQajADgzDE9X-0Mz6ZDFpvic7ydxZI1eT6zDiyDwhATK8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKsx3PK0cHAc5Q7YBIerFJpQMFcJvacHMGv63sniklQqQ&oe=6AA69D4D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover-video.png", "id": "740381481685081", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499623569_740381485018414_2207102974461887046_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=11oTx7sKa7QQ7kNvwHmnyJI&_nc_oc=Adq99G4oH5zMfc9IBxhStSL23l7_9WsD1LLNcB1fy384BcS6p37lJOkW_Q2I9cP1iEI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIoCUbEoucfldxywyjmXXhKZ2JCrvc5S0aKh6bnSbwQkw&oe=6AA691F9"}, "display_name": "2bfit", "keywords": ["fit", "exercise", "fun", "stretch"], "long_description": "This is an easy way to exercise, especially the upper body.  You can focus longer and enjoy moving around when you can see balls to interact with.\nAfter a minute (or 60 seconds) you can feel my shoulders and arms a little bit.  And if you keep you feet in place (don't rotate), you can stretch more.  If you go through a wall, the 2bfit area moves along with you.  This makes it easy to stay in a clear area. Enjoy the burn.", "short_description": "To be fit, or not to be fit. That is the question. \nMove around and score points by catching balls that drop and rotate.\nOther balls just hang around. Try not moving your feet.  Don't forget the\nballs behind you.  See your surroundings while you get fit.  Move thru a wall to move your 2bfit area."}]}, "developer
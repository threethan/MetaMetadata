dgvu&_nc_oc=AdqPuPwPBQLZmF7QPa329w7nlKTnzKDE4656O9ivRtILmC8JVrNcUirBMo4APF4B9hU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3YrD7XTpZmMc1LgtmodMsdioofqqKWHkqO29zR1bOoXw&oe=69D396BE"}, {"file_name": "screenshot-0.png", "id": "711374158163846", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491819934_711374161497179_5219986979726633511_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=16hdCQi5c6kQ7kNvwHTQZUR&_nc_oc=AdpdCtQrsuSX8sJ-n9bz_KJJR34aBhJ0a0jILZZOPqzRV94WWcbSaKk2_ayA5E5GKqE&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1coRmj9pVzU4X3tMavEzvauYqIjVdanIf-Nht6dkqY-Q&oe=69D3AD4D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover-video.png", "id": "740381481685081", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499623569_740381485018414_2207102974461887046_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1RogVxkQCg8Q7kNvwFRENN6&_nc_oc=Adpj-ZHIZDVToot1u3fIS3EIo_rraPRiMWe3i7XYY26_u2Wvmz-qOX0YqNUJdQs9vLs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1j6l5MkjWui9LQXVjdxMnTV8CADVAYBE4_Qy_GJp8F7A&oe=69D3A1F9"}, "display_name": "2bfit", "keywords": ["fit", "exercise", "fun", "stretch"], "long_description": "This is an easy way to exercise, especially the upper body.  You can focus longer and enjoy moving around when you can see balls to interact with.\nAfter a minute (or 60 seconds) you can feel my shoulders and arms a little bit.  And if you keep you feet in place (don't rotate), you can stretch more.  If you go through a wall, the 2bfit area moves along with you.  This makes it easy to stay in a clear area. Enjoy the burn.", "short_description": "To be fit, or not to be fit. That is the question. \nMove around and score points by catching balls that drop and rotate.\nOther balls just hang around. Try not moving your feet.  Don't forget the\nballs behind you.  See your surroundings while you get fit.  Move thru a wall to move your 2bfit area."}]}, "developer
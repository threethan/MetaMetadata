c=hIl4Bm1M9fEQ7kNvwEQCovV&_nc_oc=Adq7ITGgmwS3Q2HcQ9GZPdVIKMA575r7tKCFknfLWG6YalnPoPMVzIV4sXYNixiuOTY&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af85hXhhgeVSjs8umD-DRQpM96Nr5s_AU8GN2nxbwZKZLQ&oe=6A22D1F8"}, {"file_name": "2bfit-update1.png", "id": "1273832591007574", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/491827725_1273832594340907_7679835096266954535_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JlcCQ1Ngw7kQ7kNvwFYKS0q&_nc_oc=AdpeM1fPDufz4vSjZIzfXAQLdawKv7LFkbCf_DJ_THrDHtYtLm-bMBiO6baNyvGmO0E&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-egPCTjxW2j8nnu6X-uNQ9mGbYgTpWCQxvKXxk0VMzRQ&oe=6A2300CB"}, {"file_name": "2bfit-update3.png", "id": "4127365670925682", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/499307311_4127365674259015_7679022573858290498_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5DjOgOTp0d4Q7kNvwGZdQdi&_nc_oc=AdoW--vQvJk2CPpQt9jq53-rRpvmKwwWPZh4qt5RVahBkZpHTh6RvHMn9z42CbVP7vY&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-OWxuSfz7wGtoWuAJDm3yzlSkks_KKqMeS1EAL23KhGw&oe=6A22FD1B"}, {"file_name": "2bfit-update4.png", "id": "4236623229995296", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/491827718_4236623233328629_551381304740174737_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ltn0rhqyGHMQ7kNvwHYsCWY&_nc_oc=Ado08muo0r3Zfpkpy1IiWAp7yec-fkeF17s0tsJ8eYS_uEx92h2L0OZXVwpL-ddfkgU&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af84JMw0JGiKS9yuI4bFt6gbeE6linHgXCIcZ6CY-kC-IQ&oe=6A23033F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover-video.png", "id": "740381481685081", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/499623569_740381485018414_2207102974461887046_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j8uHOWDFjPQQ7kNvwFfccRB&_nc_oc=AdodBxUHiuXpNCtFWvGqK3-TLYOPiycLoTO_R8yEPW-ozIx9YSdpkMW-Ry2nzFdwzF0&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-t55oQSLS2NGf-ZzfTm-Kh1czpGtiu3drIDYs-JWh5Iw&oe=6A22F439"}, "display_name": "2bfit", "keywords": ["fit", "exercise", "fun", "stretch"], "long_description": "This is an easy way to exercise, especially the upper body.  You can focus longer and enjoy moving around when you can see balls to interact with.\nAfter a minute (or 60 seconds) you can feel my shoulders and arms a little bit.  And if you keep you feet in place (don't rotate), you can stretch more.  If you go through a wall, the 2bfit area moves along with you.  This makes it easy to stay in a clear area. Enjoy the burn.", "short_description": "To be fit, or not to be fit. That is the question. \nMove around and score points by catching balls that drop and rotate.\nOther balls just hang around. Try not moving your feet.  Don't forget the\nballs behind you.  See your surroundings while you get fit.  Move thru a wall to move your 2bfit area."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1lWHEKMjXnD5KMPReMX33Brbi3goEyEwAAFv75cz--QU/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "amre-amer.com", "support_website_url": null, "website_url": "https://amre-amer.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25023755790560223"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/491821954_233
p-m6&_nc_oc=AdphO5k_iklD6i4mrlHO59uZLfWos6tyGC97w6TYBqC5biAuwMomgMUvjGyz_8OQPOM&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEiFWINVID20x2w7D5zddncDQR7ccY5HRJg-4rJGPb69w&oe=6A92C03E"}, {"file_name": "screenshot-0.png", "id": "711374158163846", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/491819934_711374161497179_5219986979726633511_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x6CVYxIgEY0Q7kNvwEQIrAK&_nc_oc=Adqb5TYWUw-9R7uVEeT_rZ0fhgP_PUou8vvsfQnhR_rdMGOebRmTIIN6rt5v2doSiNs&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH1kIVnI3ZkbbCC4PMuBw4kAzmYEnbF_vHtOiwU5P4llA&oe=6A92D6CD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover-video.png", "id": "740381481685081", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499623569_740381485018414_2207102974461887046_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WcJHjG7n2v0Q7kNvwGdYaYP&_nc_oc=AdoicRVJiD9kc4_pTC8RRQsGudjH77dkSmqgBSz8MFdbhGxksyVairsozEwkqvth-M4&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEcoXiwnwA4Mo1L2dPxIjs8v2qLJFbPxD5Bl4r0ljJqvg&oe=6A92CB79"}, "display_name": "2bfit", "keywords": ["fit", "exercise", "fun", "stretch"], "long_description": "This is an easy way to exercise, especially the upper body.  You can focus longer and enjoy moving around when you can see balls to interact with.\nAfter a minute (or 60 seconds) you can feel my shoulders and arms a little bit.  And if you keep you feet in place (don't rotate), you can stretch more.  If you go through a wall, the 2bfit area moves along with you.  This makes it easy to stay in a clear area. Enjoy the burn.", "short_description": "To be fit, or not to be fit. That is the question. \nMove around and score points by catching balls that drop and rotate.\nOther balls just hang around. Try not moving your feet.  Don't forget the\nballs behind you.  See your surroundings while you get fit.  Move thru a wall to move your 2bfit area."}]}, "developer
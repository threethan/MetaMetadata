7kNvwEAD4Av&_nc_oc=Adq8t4M4MjY4hl1HouwHTztN4WzVXN600eBY4U3g01jvOglPUcH3fDcAmk9pu_CJZmM&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBnPz_V82JSPERrZ0XvyG0In5-XciAjz7KU5DQR7vl-2A&oe=6A6F48F8"}, {"file_name": "2bfit-update1.png", "id": "1273832591007574", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/491827725_1273832594340907_7679835096266954535_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CzMxWNw1sV8Q7kNvwE4J3BJ&_nc_oc=AdqPkBfG0JQMHo-cYkBA5n_4xQ59HJon7uQO7o9cGSZkE-jl_HTgCkoehpfOL6xw7Xo&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC5QW2d04NTzIoVVnKzuY2PYt1_rDR-2N6J_KOYTnJCTg&oe=6A6F3F8B"}, {"file_name": "2bfit-update3.png", "id": "4127365670925682", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499307311_4127365674259015_7679022573858290498_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4W9rkISpG6sQ7kNvwHVis5I&_nc_oc=AdrPvEBQomwzAt89HCheIrhDVKSEgxtMz13wHyEBZrGm5Uh34Cm_k5ztcGjfWPX-Yvo&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCemQgNsiOW2nOUzR5cXiM9zm91Cf9F4CNrB_4A6ps7bw&oe=6A6F3BDB"}, {"file_name": "2bfit-update4.png", "id": "4236623229995296", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/491827718_4236623233328629_551381304740174737_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UPB4NdM9MI4Q7kNvwFG3WoO&_nc_oc=Ado1_pSIMkSM81h933mIT4ekAWyRdpbeI04hZJEwGSRDJrjRqu2iE34myA5mly6TTwE&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDyIzfiOgCbF5uP4gsplTAm-Fzu21rG2BoYgvWMV2puJg&oe=6A6F41FF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover-video.png", "id": "740381481685081", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499623569_740381485018414_2207102974461887046_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NTb7lbImcWMQ7kNvwFKv6e_&_nc_oc=AdpM-RgZtMq1Gbc-ui5d-kRUAfnnojBwjwJX7cKeeMOiY8OZR7WehiP3OUI7YEqPCJ8&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBpvWeDI3poOOJRnHRgz2mvoFPUGVf1eeLX3rscSlJmLg&oe=6A6F32F9"}, "display_name": "2bfit", "keywords": ["fit", "exercise", "fun", "stretch"], "long_description": "This is an easy way to exercise, especially the upper body.  You can focus longer and enjoy moving around when you can see balls to interact with.\nAfter a minute (or 60 seconds) you can feel my shoulders and arms a little bit.  And if you keep you feet in place (don't rotate), you can stretch more.  If you go through a wall, the 2bfit area moves along with you.  This makes it easy to stay in a clear area. Enjoy the burn.", "short_description": "To be fit, or not to be fit. That is the question. \nMove around and score points by catching balls that drop and rotate.\nOther balls just hang around. Try not moving your feet.  Don't forget the\nballs behind you.  See your surroundings while you get fit.  Move thru a wall to move your 2bfit area."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1lWHEKMjXnD5KMPReMX33Brbi3goEyEwAAFv75cz--QU/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "amre-amer.com", "support_website_url": null, "website_url": "https://amre-amer.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25023755790560223"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/491821954_2335969400139423_72605
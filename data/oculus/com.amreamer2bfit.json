RnLA&_nc_oc=Adp9gnpI1J5dBHUEeERdSycD64nwWdXssg5cVhAN1g-5LULUemJquSzE4ijffHDn50U&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQLYC0yHLHsMx8-qwB4JEcNgtYTlhEQnTFS7rrj0RhUvQ&oe=6AEF417E"}, {"file_name": "screenshot-0.png", "id": "711374158163846", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491819934_711374161497179_5219986979726633511_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bhgVrjLEGYsQ7kNvwE8YWAJ&_nc_oc=AdpwyWnpAYyQ5H-UCoZ9Kks1FqyISev5V6tOsPejHq3KbRAOfsn1drh5dEeHIGwv-LU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT0XiCt6uQhmViawr4BEEKiersDHypEMFvKx81yNIde6Q&oe=6AEF580D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover-video.png", "id": "740381481685081", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499623569_740381485018414_2207102974461887046_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9Axv363-pWQQ7kNvwGYgCrK&_nc_oc=AdqxPSw5c5pLrRWZfrPkdupn62uqbOOwvbfhznJKqAuS3swTeKfUIia6-v6mdzk3f1s&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQWGE2HKkVGQH3yb4JNDpqCa5_deCo8JKDvHFkBlzt5PQ&oe=6AEF4CB9"}, "display_name": "2bfit", "keywords": ["fit", "exercise", "fun", "stretch"], "long_description": "This is an easy way to exercise, especially the upper body.  You can focus longer and enjoy moving around when you can see balls to interact with.\nAfter a minute (or 60 seconds) you can feel my shoulders and arms a little bit.  And if you keep you feet in place (don't rotate), you can stretch more.  If you go through a wall, the 2bfit area moves along with you.  This makes it easy to stay in a clear area. Enjoy the burn.", "short_description": "To be fit, or not to be fit. That is the question. \nMove around and score points by catching balls that drop and rotate.\nOther balls just hang around. Try not moving your feet.  Don't forget the\nballs behind you.  See your surroundings while you get fit.  Move thru a wall to move your 2bfit area."}]}, "developer
pofx_AO0O1r6dFATiRnf8FVlMRdPOCK-BOu4J5NUMt2vIZibqAcOQQ&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfzVpyegwSX7McfRm8rQ3CsjaRIgHBG4v9sKAqVSySKfKg&oe=69AC2AF8"}, {"file_name": "2bfit-update1.png", "id": "1273832591007574", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491827725_1273832594340907_7679835096266954535_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8pBrPSd0LUMQ7kNvwHGxjPZ&_nc_oc=Adlr8-WkH5mFWRW1IQ_cjHLwyX0A4AHFEvjH7W08wP9xu_UfNE9-WTcSiHTd9JlWfH8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_Afzb7rT8KSLdqt2p19ae-WsnrDHSpLztpOiSb5d0lJcWVQ&oe=69AC218B"}, {"file_name": "2bfit-update3.png", "id": "4127365670925682", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499307311_4127365674259015_7679022573858290498_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vC8Chgt_a0AQ7kNvwGNLX-c&_nc_oc=Adkj77ek7avXESzifHDbSJfC1R-U1vRLaggOcoZhEv7DwMaBg7nVX5VtXeTBlrpGVnc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfyfAxypObZpA-VHy4ak4RrPqv1K1wiaqnxGTSFGZPH1QA&oe=69AC1DDB"}, {"file_name": "2bfit-update4.png", "id": "4236623229995296", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491827718_4236623233328629_551381304740174737_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sTMBZzTEhnoQ7kNvwGLOV_A&_nc_oc=Adlmc09GJmZfTHhA6z69IBNOXtgSCLTM_QC7aOwAobz5R9WW1oKbqsKDPXZpPzVdXhI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfwVHVpLcyyRvzCmy11YIyRKfUpAUZauIV1m8Ro8Y4Ayyg&oe=69AC23FF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover-video.png", "id": "740381481685081", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499623569_740381485018414_2207102974461887046_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K18Oqwa4pdEQ7kNvwGH0udZ&_nc_oc=Adm4VhYYfSlWZ4gz7YpvXTJYUoif_fckuUa_m3duIxQvvaYtzb4EfdPjE9jC8i72FBM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfyoT-xwUEQJB8MnGBkWF7XxF-Gh0KJt86yqDLG3Xved0Q&oe=69AC14F9"}, "display_name": "2bfit", "keywords": ["fit", "exercise", "fun", "stretch"], "long_description": "This is an easy way to exercise, especially the upper body.  You can focus longer and enjoy moving around when you can see balls to interact with.\nAfter a minute (or 60 seconds) you can feel my shoulders and arms a little bit.  And if you keep you feet in place (don't rotate), you can stretch more.  If you go through a wall, the 2bfit area moves along with you.  This makes it easy to stay in a clear area. Enjoy the burn.", "short_description": "To be fit, or not to be fit. That is the question. \nMove around and score points by catching balls that drop and rotate.\nOther balls just hang around. Try not moving your feet.  Don't forget the\nballs behind you.  See your surroundings while you get fit.  Move thru a wall to move your 2bfit area."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1lWHEKMjXnD5KMPReMX33Brbi3goEyEwAAFv75cz--QU/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "amre-amer.com", "support_website_url": null, "website_url": "https://amre-amer.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25023755790560223"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491821954_2335969400139423_7260507335481471188_n.png?stp=dst-png_s360x360&_nc_cat=10
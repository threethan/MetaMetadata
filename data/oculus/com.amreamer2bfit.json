CYOz&_nc_oc=AdqEUO815_2IbegjehiMUeDLZQQo7jPquYiWj26WLJ6QCu2O4fWqQ_JhZWxIrExl7U0&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO6jZDI0ifd7d6Tmhw704aLHRN8qT2QLJYLTQMJ0PkyeA&oe=6AE0C0FE"}, {"file_name": "screenshot-0.png", "id": "711374158163846", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491819934_711374161497179_5219986979726633511_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1HmZalQvCrcQ7kNvwHe1GJx&_nc_oc=AdoyHOYuaH66QG5j7K0ILt963gFVpQJOGJo1MDLyad90kShpu1Ub2RXMD2SqH31x_3Y&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNsEIxUKK9eOca6PJm8N0wT1Ir3CvEx_K5mCqn8-pYD6Q&oe=6AE09F4D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover-video.png", "id": "740381481685081", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499623569_740381485018414_2207102974461887046_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Srr2KZB8lpEQ7kNvwFnAYhT&_nc_oc=AdpGKIYy_CO-2svi103F1mDWMa3AZatV984HnyRUdLc9SZ4zsjLmhHtTg2mNuH1fYFA&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO3qbethPMFYGIuCrSo4U1j1h6dVwlDrihWG8HS86hbLw&oe=6AE0CC39"}, "display_name": "2bfit", "keywords": ["fit", "exercise", "fun", "stretch"], "long_description": "This is an easy way to exercise, especially the upper body.  You can focus longer and enjoy moving around when you can see balls to interact with.\nAfter a minute (or 60 seconds) you can feel my shoulders and arms a little bit.  And if you keep you feet in place (don't rotate), you can stretch more.  If you go through a wall, the 2bfit area moves along with you.  This makes it easy to stay in a clear area. Enjoy the burn.", "short_description": "To be fit, or not to be fit. That is the question. \nMove around and score points by catching balls that drop and rotate.\nOther balls just hang around. Try not moving your feet.  Don't forget the\nballs behind you.  See your surroundings while you get fit.  Move thru a wall to move your 2bfit area."}]}, "developer
7kNvwFfGNEZ&_nc_oc=AdqaZiSl9C1ymlevddh2FFcl1IJpW3maDCMwoV7PV9uawp6ZROc9wAKKjUvLp2xHctw&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxrNuAc_cGtuU7DUgAR5NfdVEknrGxWTvkVI0_ZtYTE7A&oe=69C29478"}, {"file_name": "2bfit-update1.png", "id": "1273832591007574", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/491827725_1273832594340907_7679835096266954535_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2Fl1bwJEQjIQ7kNvwHfChZd&_nc_oc=Adqkx5JKnLn652ieWU9cvWMspuMUsEHbGnp5Mk81LFs8qoMAE399-c5kF8pW3s_v_nk&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxDL8f0jpk7u6IkPimFn4FjJ-z9XkrtoCbODN_K8Z-iWw&oe=69C28B0B"}, {"file_name": "2bfit-update3.png", "id": "4127365670925682", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/499307311_4127365674259015_7679022573858290498_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N-ydjklwE3sQ7kNvwEiyDN6&_nc_oc=Ado6o9kyXsREcrcHo9ch4yRlQh3nQWvX_xUt_6jrmhftHSzNILCDeKXyfjrRg7FHOe0&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzGgT8-1Rq2rBQFOe1CkO8a6Mz7HSpyl-4Wh85lHCdo3g&oe=69C2875B"}, {"file_name": "2bfit-update4.png", "id": "4236623229995296", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491827718_4236623233328629_551381304740174737_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TaDj1Ek6g8QQ7kNvwE66xIV&_nc_oc=AdoQ5IpjOP5sxWma4pCfaixfG_BNoqmerNsXteK_ElYRfkeMXpMJJnQSBERKp7qV4zw&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyJeIxFGZAUgODRA7UZFMRFw-e87iOL8uXpmGDYh1lLfg&oe=69C28D7F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover-video.png", "id": "740381481685081", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499623569_740381485018414_2207102974461887046_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Bd4f688JdV0Q7kNvwEgg6Tc&_nc_oc=AdpFylXqylc7DrbbwTFNZ8g4Pw-loBN0M0yGkc5KeAU3D1Sh2pgdljQEXq7_2SgsY1E&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afw8b6djjTkGUK5UCYOhutY0pgBTZ1RnW5a5bUVTtZPgJA&oe=69C27E79"}, "display_name": "2bfit", "keywords": ["fit", "exercise", "fun", "stretch"], "long_description": "This is an easy way to exercise, especially the upper body.  You can focus longer and enjoy moving around when you can see balls to interact with.\nAfter a minute (or 60 seconds) you can feel my shoulders and arms a little bit.  And if you keep you feet in place (don't rotate), you can stretch more.  If you go through a wall, the 2bfit area moves along with you.  This makes it easy to stay in a clear area. Enjoy the burn.", "short_description": "To be fit, or not to be fit. That is the question. \nMove around and score points by catching balls that drop and rotate.\nOther balls just hang around. Try not moving your feet.  Don't forget the\nballs behind you.  See your surroundings while you get fit.  Move thru a wall to move your 2bfit area."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1lWHEKMjXnD5KMPReMX33Brbi3goEyEwAAFv75cz--QU/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "amre-amer.com", "support_website_url": null, "website_url": "https://amre-amer.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25023755790560223"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/491821954_2335969400139423_72605
aKZv&_nc_oc=AdqdcuUkW3rSUoYsijlyTqJ7GGoyqOSKMn2dyu2AC8-374WD0XNObf9jS6KvbNaOJNA&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD52r1cjcX1mqmg71WSx8iQ9xjIKDnOfJIVcB3gc9H6mw&oe=6A5B613E"}, {"file_name": "screenshot-0.png", "id": "711374158163846", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491819934_711374161497179_5219986979726633511_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xgyrry89hgYQ7kNvwERinrs&_nc_oc=AdqWM3lC-DvV7FoMi88_QrTSwC4IMyf67alqNfeWjMWeoyCdP6_3iqP6LR-5En08Qvo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC1HPg0TU4QYrgWvFRTojDULeaM9_eubGyPClCngqsCuA&oe=6A5B77CD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover-video.png", "id": "740381481685081", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499623569_740381485018414_2207102974461887046_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EmSBRnWCWZAQ7kNvwGA76eJ&_nc_oc=AdpqvlwDyWlsDACTHwuJgG_7MwuqOAIB_BE0LYLboe--ysoTCd-fefuz72Za-y4LpEk&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBX8zgZeywYS3Ht6wdlzr6g_OPmOJeUiE3QnY9wlXKmOg&oe=6A5B6C79"}, "display_name": "2bfit", "keywords": ["fit", "exercise", "fun", "stretch"], "long_description": "This is an easy way to exercise, especially the upper body.  You can focus longer and enjoy moving around when you can see balls to interact with.\nAfter a minute (or 60 seconds) you can feel my shoulders and arms a little bit.  And if you keep you feet in place (don't rotate), you can stretch more.  If you go through a wall, the 2bfit area moves along with you.  This makes it easy to stay in a clear area. Enjoy the burn.", "short_description": "To be fit, or not to be fit. That is the question. \nMove around and score points by catching balls that drop and rotate.\nOther balls just hang around. Try not moving your feet.  Don't forget the\nballs behind you.  See your surroundings while you get fit.  Move thru a wall to move your 2bfit area."}]}, "developer
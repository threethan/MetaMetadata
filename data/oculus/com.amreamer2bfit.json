c=yuHL2Li08YIQ7kNvwHJi2W5&_nc_oc=Adp2lKH6sr8gbeCSMMj3qjy1FXqLNb-0cx39Pz4wvWhzldai2RUVaGODIHhO4JlcpI0&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_ajSUb_nlDoUZxRegF81dJK4Y9cg9wJzBIZr6SsIjX1Q&oe=6A393B78"}, {"file_name": "2bfit-update1.png", "id": "1273832591007574", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/491827725_1273832594340907_7679835096266954535_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a7iz2ZBPT_kQ7kNvwF7BLda&_nc_oc=AdoQVG-R5W8r8CWEO3TASPt6cEB9qV2LhnHxy9daeIi0hzeMwAmrbwYwfHOYrPTKh1c&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9mHMoCqp7gpuZAt7n5fLRHQOIU5-iTc1U9Y142dXzjXw&oe=6A39320B"}, {"file_name": "2bfit-update3.png", "id": "4127365670925682", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/499307311_4127365674259015_7679022573858290498_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KAZtg7t80rUQ7kNvwE6HAf2&_nc_oc=AdptF9bDfTouEaXBMX07_gdGI71nSG6vLii63uPUDwJXCiDvGpWzKppDwUC5c6olaeM&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_QsGOGIdI1vPHF2jHxp13tFYfUDFZhQfHCI6IJJIDBkg&oe=6A392E5B"}, {"file_name": "2bfit-update4.png", "id": "4236623229995296", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/491827718_4236623233328629_551381304740174737_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5lF4bhJOTZMQ7kNvwEMSay4&_nc_oc=Adrp1WYkOKNZ5SwELeMnKKCP5AauCRr9yguB1zmIqgQNPP5SfkFN5ps8l5HQbbVc1EU&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_NNZMpSUvZh1VdAMQy2eI3hsUYBwAchaf0Epl-VzMlbA&oe=6A39347F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover-video.png", "id": "740381481685081", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/499623569_740381485018414_2207102974461887046_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q85A4gISe84Q7kNvwFmuRH0&_nc_oc=Adqtmow_o5DtiM8bviUcrDK_qLhhqaQ0QkAZVYr5Uqihti5SVijSpYlUyb4myNVnYUY&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-sVySOAzU-MUkOfXZM5yuwxZRzwhCtWaQsvSg8zjPU8g&oe=6A395DB9"}, "display_name": "2bfit", "keywords": ["fit", "exercise", "fun", "stretch"], "long_description": "This is an easy way to exercise, especially the upper body.  You can focus longer and enjoy moving around when you can see balls to interact with.\nAfter a minute (or 60 seconds) you can feel my shoulders and arms a little bit.  And if you keep you feet in place (don't rotate), you can stretch more.  If you go through a wall, the 2bfit area moves along with you.  This makes it easy to stay in a clear area. Enjoy the burn.", "short_description": "To be fit, or not to be fit. That is the question. \nMove around and score points by catching balls that drop and rotate.\nOther balls just hang around. Try not moving your feet.  Don't forget the\nballs behind you.  See your surroundings while you get fit.  Move thru a wall to move your 2bfit area."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1lWHEKMjXnD5KMPReMX33Brbi3goEyEwAAFv75cz--QU/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "amre-amer.com", "support_website_url": null, "website_url": "https://amre-amer.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25023755790560223"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/491821954_233
re hands-on experimentation meets cutting-edge technology for an educational adventure like no other.", "short_description": "Explore the world of chemistry in an unprecedented way, where hands-on experimentation meets cutting-edge technology for an educational adventure like no other. This package includes collection of 1 experiment.  This application supports two languages, Korean and English."}]}, "developer_name": null, "developer_privacy_policy_url": "https://training.contentsda.kr/privacy-policy-en/", "developer_terms_of_service_url": "https://training.contentsda.kr/terms-and-conditions-en/", "publisher_name": "ContentsDa Inc", "support_website_url": null, "website_url": "https://training.contentsda.kr/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ko"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "7079744192083151"}}]}, "scheduled_offers": {"count": 7, "nodes": [{"status": "PUBLISHED", "id": "434124532578119"}, {"status": "PUBLISHED", "id": "864114798800833"}, {"status": "PUBLISHED", "id": "839733031273756"}, {"status": "PUBLISHED", "id": "724954159589814"}, {"status": "PUBLISHED", "id": "406987098915282"}, {"status": "PUBLISHED", "id": "396216180020864"}, {"status": "PUBLISHED", "id": "382467041516162"}]}, "baseline_offer": {"id": "434124532578119"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1727848920, "status": "PUBLISHED", "id": "434124532578119"}]}, "liveChannel": {"nodes": [{"latest_s
 fangame that offers players a unique blend of fun and competitive gameplay. With four engaging game modes, players can enjoy a variety of experiences, all while showcasing their agility and teamwork skills in a vibrant, monkey-themed environment.\nDive into the world of \"Random Taggers\" and experience the thrill of monkeying around with friends and players from around the globe! Whether you prefer casual play or intense competition, there's something for everyone in this dynamic fangame.", "short_description": "A new interesting Gorilla Tag Fan-Game, Using Their Loco-Motion"}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1UEE2Ms-IIa0Zp4uq-r5kfgScprw-tevWpfwS9t84HZk/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Asteroid Inc.", "support_website_url": null, "website_url": "https://html.cafe/xeedc09b2", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}, {"id": "1023770785722696"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "28878387868441648"}}]}, "scheduled_offers": {"count": 0, "nodes": []}, "baseline_offer": null, "is_approved": true, "firstOffer": {"nodes": []}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "29201296302817468", "version": "1.1.62"}, "id": "606941035589418", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "
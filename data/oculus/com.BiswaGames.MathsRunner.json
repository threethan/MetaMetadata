paUwvE8Es1pjIOl1iZuPtFB2f73k710OqsV6Ryrey0t6PRs7M&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRL5iX0J6OIB8YpoEKFsL6EfGaSIDfHGtee4k6pLhM7IA&oe=6AEF4113"}, {"file_name": "b.png", "id": "929020942186716", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031357_929020945520049_7258003095729423937_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0mzqVbYF214Q7kNvwHZbvOt&_nc_oc=AdrTkUr7gHYQwzrUjgnc1u1SMJ4fIDtkd3Z63Nwz0LD4i7wNxyyHGf2jgA73YBFZ3lw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQcNTde0g8AmjG3xA4-lAuA6ya01AwcjTYjrQnSe9Em_A&oe=6AEF36F3"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Maths Runner", "keywords": [], "long_description": "Welcome to Maths Runner, where the thrill of high-speed racing meets the fascinating world of infinite mathematics! Immerse yourself in a captivating gaming experience that challenges your mathematical skills while you navigate through an endless, dynamically generated racecourse\nGameplay: Maths Runner is not your typical Infinite Running game. Instead of traditional tracks, players find themselves on an ever-changing mathematical landscape. The game dynamically generates mathematical equations that serve as the road, and your goal is to solve them to keep your racer zooming forward. The equations become progressively challenging, ensuring that players of all skill levels are engaged.\nFeatures\n1. Infinite Tracks: No two races are the same. The game's procedural generation ensures an endless variety of mathematical challenges, keeping players on their toes.\n2. Math Challenges: Solve equations to pave the way for your racer. \n3. Power-Ups: Collect power-ups that provide temporary advantages. \n4. Leaderboards and Achievements: Track your progress, compare scores with friends, and earn achievements based on your mathematical accomplishments. Climb the global leaderboards to establish yourself as the ultimate Maths Runner\nEducational Value\nMaths Runner is designed for entertainment and to enhance mathematical skills. By integrating mathematical problem-solving into the gameplay, players can enjoy a fun and educational experience that reinforces their understanding of mathematical concepts", "short_description": "Maths Runner : Immerse yourself in a fast-paced, infinite running adventure where each step requires solving dynamic math problems. Dash through ever-changing landscapes, conquering obstacles by quickly and accurately solving equations. Test your mental agility, set high scores, and enhance your math skills on the go!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.biswagames.com/privacy_policy/app/MathsRunner.html", "developer_terms_of_service_url": null, "publisher_name": "Biswa Games Private Ltd", "support_website_url": null, "website_url": "https://www.biswagames.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1043107547362485"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "GAMEPAD"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "7499950150050151"}}]}, "scheduled_offers": {"count": 5, "nodes": [{"status": "PUBLISHED", "id": "1589757515696732"}, {"status": "PUBLISHED", "id": "1510930183540894"}, {"status": "PUBLISHED", "id": "1211185710833023"}, {"status": "PUBLISHED", "id": "1523915768924872"}, {"status": "PUBLISHED", "id": "346992954926714"}]}, "baseline_offer": {"id": "1523915768924872"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1773421200, 
fZ5QRL4tOLrjVyiqzx1L5p2Q9ftVq4HzfbzgG-DB3bOXaY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0fjTwSbjPZ8oVk4U3ldR2MK_KQJncOwkXFlmpvDZr3RQ&oe=69D3C52B"}, {"file_name": "\uc9c4\ub85cVR\uc2a4\uc0f73.png", "id": "971948314036183", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75617326_971948317369516_8606007663128987721_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=si7MxtoD0FsQ7kNvwEB0kik&_nc_oc=AdpQye8R1A-s7F_NRjvDm0o8zPQMVKg_VN-NKVyy-n4-J2YVjpiknz-5RGurauu8X0M&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2_zmoT-KJtxyqPP75IPvUWCjiOxEPEr7Nt5ZIqQDGJiw&oe=69D39370"}, {"file_name": "\uc9c4\ub85cVR\uc2a4\uc0f74.png", "id": "634367035507703", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75395592_634367038841036_7868073951372862517_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d9FeX9jUjtAQ7kNvwHIb0K-&_nc_oc=AdrqzcGdR-ghNb2x2VzabooajMkxvToWUujBPRRibALkn6CZxAU8uBLnv8GTYoscWFE&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0Jp9vAoCFpGK-bLD2FFK314e2Q-XJzeTeq0KEzSsVH4w&oe=69D3B641"}, {"file_name": "\uc9c4\ub85cVR\uc2a4\uc0f75.png", "id": "339921848372381", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39035458_339921851705714_5977948961318500410_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Mnzb7U0fQEoQ7kNvwHFTiag&_nc_oc=AdovcfF4fUIScbAGLiewU9aYUHz0KrU5dnFdN6EHJzg2g46eYjezJXddrxmUk5JK0ig&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1oJ7UvoKiUMs8fRbbk098kvQtgGgbIZnytZdnoGmwNwQ&oe=69D3A809"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover.png", "id": "800332375123311", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75286676_800332378456644_6145057191089602821_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8ME1LcrLETwQ7kNvwHEaxUx&_nc_oc=Adq-xcU7Okl9uPSlftV33Knbu9ir8EjfJ-BSkMN7obkoLk9f66qGtSzp13Oov7WlMhI&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0LOdT2tFKl-ZryE3xfESuj-To7PW_RS7kOTqxWbimLDQ&oe=69D39A84"}, "display_name": "Metarverse Creator", "keywords": [], "long_description": "\ubcf8 \ud504\ub85c\uadf8\ub7a8\uc740, NIPA(\uc815\ubcf4\ud1b5\uc2e0\uc0b0\uc5c5\uc9c4\ud765\uc6d0)\uacfc K-META(\ud55c\uad6d\uba54\ud0c0\ubc84\uc2a4\uc0b0\uc5c5\ud611\ud68c)\uac00 \n2022\ub144 \uac1c\ubc1c\ud55c \uc2e4\uac10\uad50\uc721 \ucf58\ud150\uce20 VR \ud504\ub85c\uadf8\ub7a8\uc785\ub2c8\ub2e4.\n\n2019\ub144\ubd80\ud130 NIPA\ub294 4\ucc28 \uc0b0\uc5c5\ud601\uba85 \uc2dc\ub300\ub97c \ub300\ube44\ud574 \ubbf8\ub798 \uc9c1\uc5c5 \ud658\uacbd \ubcc0\ud654\ub97c \ubc18\uc601\ud55c \n\uccb4\uacc4\uc801\uc778 \uc9c4\ub85c\uccb4\ud5d8 \uad50\uc721 \ud504\ub85c\uadf8\ub7a8\ub4e4\uc744 \uac1c\ubc1c\ud558\uc600\uace0, \n\uadf8 \uc77c\ud658\uc73c\ub85c, \ubcf8 \ud504\ub85c\uadf8\ub7a8\uc740 \uba54\ud0c0\ubc84\uc2a4 \ud06c\ub9ac\uc5d0\uc774\ud130\ub97c \uc18c\uc7ac\ub85c \ud558\uc5ec \ud504\ub85c\uadf8\ub798\ubc0d \ub418\uc5c8\uc2b5\ub2c8\ub2e4.\n\n\ubb34\uc5c7\uc774\ub4e0 \ub420 \uc218 \uc788\uace0, \uc5b4\ub514\ub4e0\uc9c0 \uac08 \uc218 \uc788\ub294 \uba54\ud0c0\ubc84\uc2a4\ub77c\ub294 \uacf5\uac04\uc5d0 \ub300\ud55c \uc774\ud574\ub97c \ub113\ud788\uace0, \n\uba54\ud0c0\ubc84\uc2a4 \uad00\ub828 \uc720\ub9dd \uc9c1\ubb34 \uc18c\uac1c\ub97c \uc704\ud574 \uccb4\ud5d8 \uc8fc\uc81c\ubcc4 \ub098\ub9cc\uc758 \ub9de\ucda4\ud615 \uce90\ub9ad\ud130 \ub514\uc790\uc778 \ubc0f \uacf5\uac04 \uccb4\ud5d8, \n\uadf8\ub9ac\uace0 \uce90\ub9ad\ud130\ub97c NFT \ubc1c\ud589\ud558\ub294 \uacfc\uc815\uae4c\uc9c0\uc758 \u2018\uba54\ud0c0\ubc84\uc2a4 \ud06c\ub9ac\uc5d0\uc774\ud130 \uc774\ucf54\ub178\ubbf8\u2019 \ub97c \uacbd\ud5d8\ud569\ub2c8\ub2e4. \n\n\uc790\uc2e0\uc774 \uafb8\ubbfc \uce90\ub9ad\ud130\ub85c \uba54\ud0c0\ubc84\uc2a4\ub97c \ud0d0\ud5d8\ud558\ub294 \ubab0\uc785\uc801\uc778 \uccb4\ud5d8\uc740, \n\ubbf8\ub798\uc758 \uc720\ub9dd\ud55c \uc0b0\uc5c5\uad70\uc73c\ub85c\uc368 - \uba54\ud0c0\ubc84\uc2a4 \ud06c\ub9ac\uc5d0\uc774\ud130\uc5d0 \uc880 \ub354 \uad00\uc2ec\uc744 \uac16\ub294\ub370 \uae30\uc5ec\ud560 \uac83\uc774\ub77c \ubbff\uc2b5\ub2c8\ub2e4.\n\uc218\uc900\ub192\uac8c \uad6c\ud604\ub41c \uba54\ud0c0\ubc84\uc2a4 \ud06c\ub9ac\uc5d0\uc774\ud130, VR\ub85c \uacbd\ud5d8\ud558\uc138\uc694.\n\nstep1 \ud29c\ud1a0\ub9ac\uc5bc\nstep2 \uc774\ub2ec\uc758 \uc6b0\uc218 \uce90\ub9ad\ud130 \ud22c\ud45c\nstep3~5 (\uacfc\uac70,\ud604\uc7ac,\ubbf8\ub798) \uce90\ub9ad\ud130 \uafb8\ubbf8\uae30\nstep6 \uacfc\uac70\ud559\uad50 \ud0d0\ud5d8\nstep7 \ud604\uc7ac\ud559\uad50 \ud0d0\ud5d8\nstep8 \ubbf8\ub798\ud559\uad50 \ud0d0\ud5d8\nstep9 \uce90\ub9ad\ud130 NFT \ubc1c\ud589(\uac00\uc0c1 \uccb4\ud5d8)\nstep10 \ucd94\ucc9c! \uc9c1\uc5c5\uad70 \ud14c\uc2a4\ud2b8 / \uba54\ud0c0\ubc84\uc2a4 \uc724\ub9ac\uad50\uc721\n\n* \ubcf8 VR \ucf58\ud150\uce20\uac00 \ub9e4\ub825\uc801\uc774\uc5c8\ub2e4\uba74, \ud55c\uad6d\uba54\ud0c0\ubc84\uc2a4\uc0b0\uc5c5\ud611\ud68c \ubb38\uc758\ud558\uc138\uc694. \n<2023\ub144 \ucc3e\uc544\uac00\ub294 \ub9de\ucda4\ud615 \uc2e4\uac10\uad50\uc721 \uc9c4\ub85c\uccb4\ud5d8 \ud504\ub85c\uadf8\ub7a8>\uc774 \ub2f9\uc2e0\uc744, \n\ub2f9\uc2e0\uc758 \uccad\uc18c\ub144\uc744 \uae30\ub2e4\ub9ac\uace0 \uc788\uc2b5\ub2c8\ub2e4. ", "short_description": "\uc815\ubcf4\ud1b5\uc2e0\uc0b0\uc5c5\uc9c4\ud765\uc6d0(NIPA) K-META(\ud55c\uad6d\uba54\ud0c0\ubc84\uc2a4\uc0b0\uc5c5\ud611\ud68c)\uac00 \uac1c\ubc1c\ud55c \uccad\uc18c\ub144 \ub300\uc0c1 \uc9c4\ub85c\uccb4\ud5d8 \ud504\ub85c\uadf8\ub7a8\uc785\ub2c8\ub2e4. "}, {"images": {"nodes": []}, "id": "292324223427893", "locale": "ko_KR", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Metarverse Creator", "keywords": [], "long_description": "\ubcf8 \ud504\ub85c\uadf8\ub7a8\uc740, NIPA(\uc815\ubcf4\ud1b5\uc2e0\uc0b0\uc5c5\uc9c4\ud765\uc6d0)\uacfc K-META(\ud55c\uad6d\uba54\ud0c0\ubc84\uc2a4\uc0b0\uc5c5\ud611\ud68c)\uac00 \n2022\ub144 \uac1c\ubc1c\ud55c \uc2e4\uac10\uad50\uc721 \ucf58\ud150\uce20 VR \ud504\ub85c\uadf8\ub7a8\uc785\ub2c8\ub2e4.\n\n2019\ub144\ubd80\ud130 NIPA\ub294 4\ucc28 \uc0b0\uc5c5\ud601\uba85 \uc2dc\ub300\ub97c \ub300\ube44\ud574 \ubbf8\ub798 \uc9c1\uc5c5 \ud658\uacbd \ubcc0\ud654\ub97c \ubc18\uc601\ud55c \n\uccb4\uacc4\uc801\uc778 \uc9c4\ub85c\uccb4\ud5d8 \uad50\uc721 \ud504\ub85c\uadf8\ub7a8\ub4e4\uc744 \uac1c\ubc1c\ud558\uc600\uace0, \n\uadf8 \uc77c\ud658\uc73c\ub85c, \ubcf8 \ud504\ub85c\uadf8\ub7a8\uc740 \uba54\ud0c0\ubc84\uc2a4 \ud06c\ub9ac\uc5d0\uc774\ud130\ub97c \uc18c\uc7ac\ub85c \ud558\uc5ec \ud504\ub85c\uadf8\ub798\ubc0d \ub418\uc5c8\uc2b5\ub2c8\ub2e4.\n\n\ubb34\uc5c7\uc774\ub4e0 \ub420 \uc218 \uc788\uace0, \uc5b4\ub514\ub4e0\uc9c0 \uac08 \uc218 \uc788\ub294 \uba54\ud0c0\ubc84\uc2a4\ub77c\ub294 \uacf5\uac04\uc5d0 \ub300\ud55c \uc774\ud574\ub97c \ub113\ud788\uace0, \n\uba54\ud0c0\ubc84\uc2a4 \uad00\ub828 \uc720\ub9dd \uc9c1\ubb34 \uc18c\uac1c\ub97c \uc704\ud574 \uccb4\ud5d8 \uc8fc\uc81c\ubcc4 \ub098\ub9cc\uc758 \ub9de\ucda4\ud615 \uce90\ub9ad\ud130 \ub514\uc790\uc778 \ubc0f \uacf5\uac04 \uccb4\ud5d8, \n\uadf8\ub9ac\uace0 \uce90\ub9ad\ud130\ub97c NFT \ubc1c\ud589\ud558\ub294 \uacfc\uc815\uae4c\uc9c0\uc758 \u2018\uba54\ud0c0\ubc84\uc2a4 \ud06c\ub9ac\uc5d0\uc774\ud130 \uc774\ucf54\ub178\ubbf8\u2019 \ub97c \uacbd\ud5d8\ud569\ub2c8\ub2e4. \n\n\uc790\uc2e0\uc774 \uafb8\ubbfc \uce90\ub9ad\ud130\ub85c \uba54\ud0c0\ubc84\uc2a4\ub97c \ud0d0\ud5d8\ud558\ub294 \ubab0\uc785\uc801\uc778 \uccb4\ud5d8\uc740, \n\ubbf8\ub798\uc758 \uc720\ub9dd\ud55c \uc0b0\uc5c5\uad70\uc73c\ub85c\uc368 - \uba54\ud0c0\ubc84\uc2a4 \ud06c\ub9ac\uc5d0\uc774\ud130\uc5d0 \uc880 \ub354 \uad00\uc2ec\uc744 \uac16\ub294\ub370 \uae30\uc5ec\ud560 \uac83\uc774\ub77c \ubbff\uc2b5\ub2c8\ub2e4.\n\uc218\uc900\ub192\uac8c \uad6c\ud604\ub41c \uba54\ud0c0\ubc84\uc2a4 \ud06c\ub9ac\uc5d0\uc774\ud130, VR\ub85c \uacbd\ud5d8\ud558\uc138\uc694.\n\nstep1 \ud29c\ud1a0\ub9ac\uc5bc\nstep2 \uc774\ub2ec\uc758 \uc6b0\uc218 \uce90\ub9ad\ud130 \ud22c\ud45c\nstep3~5 (\uacfc\uac70,\ud604\uc7ac,\ubbf8\ub798) \uce90\ub9ad\ud130 \uafb8\ubbf8\uae30\nstep6 \uacfc\uac70\ud559\uad50 \ud0d0\ud5d8\nstep7 \ud604\uc7ac\ud559\uad50 \ud0d0\ud5d8\nstep8 \ubbf8\ub798\ud559\uad50 \ud0d0\ud5d8\nstep9 \uce90\ub9ad\ud130 NFT \ubc1c\ud589(\uac00\uc0c1 \uccb4\ud5d8)\nstep10 \ucd94\ucc9c! \uc9c1\uc5c5\uad70 \ud14c\uc2a4\ud2b8 / \uba54\ud0c0\ubc84\uc2a4 \uc724\ub9ac\uad50\uc721\n\n* \ubcf8 VR \ucf58\ud150\uce20\uac00 \ub9e4\ub825\uc801\uc774\uc5c8\ub2e4\uba74, \ud55c\uad6d\uba54\ud0c0\ubc84\uc2a4\uc0b0\uc5c5\ud611\ud68c \ubb38\uc758\ud558\uc138\uc694. \n<2023\ub144 \ucc3e\uc544\uac00\ub294 \ub9de\ucda4\ud615 \uc2e4\uac10\uad50\uc721 \uc9c4\ub85c\uccb4\ud5d8 \ud504\ub85c\uadf8\ub7a8>\uc774 \ub2f9\uc2e0\uc744, \n\ub2f9\uc2e0\uc758 \uccad\uc18c\ub144\uc744 \uae30\ub2e4\ub9ac\uace0 \uc788\uc2b5\ub2c8\ub2e4. ", "short_description": "\uc815\ubcf4\ud1b5\uc2e0\uc0b0\uc5c5\uc9c4\ud765\uc6d0(NIPA) K-META(\ud55c\uad6d\uba54\ud0c0\ubc84\uc2a4\uc0b0\uc5c5\ud611\ud68c)\uac00 \uac1c\ubc1c\ud55c \uccad\uc18c\ub144 \ub300\uc0c1 \uc9c4\ub85c\uccb4\ud5d8 \ud504\ub85c\uadf8\ub7a8\uc785\ub2c8\ub2e4. "}]}, "developer_name": null, "developer_privacy_policy_url": "http://coin7.co.kr/privacy/CareerVR/PrivatePolicy.html", "developer_terms_of_service_url": null, "publisher_name": "K-META \ud55c\uad6d\uba54\ud0c0\ubc84\uc2a4\uc0b0\uc5c5\ud611\ud68c", "support_website_url": null, "website_url": "https://www.k-meta.or.kr/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "964192628026433"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"
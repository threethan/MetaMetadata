afrDGSYN3cpL9Yh3cTkPCSHC_lNFXkq4-IQwRyY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfsZ-YbjgKljW_LfkRbNY8wjvA2Krby8TX5UNRBLLo93Jw&oe=699D9472"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer Thumbnail.png", "id": "1003097757117807", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/57569468_1003097767117806_5720121769644944108_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fdcXhkQ4GdwQ7kNvwHXRKJB&_nc_oc=AdkVSYwbG0hE8I9rfGMi_L4mw1OaOAYzl4-E0Wiccquqh2BcVoiIzeppcWCyJJhQvCk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Afs4w1T5Qkn7nsOf32gPFpHKsQMzdH0y-q28fIMUjQiPQQ&oe=699D89D4"}, "display_name": "EnvisionVR", "keywords": [], "long_description": "Our EnvisionVR app allows you to view your future projects in high-fidelity Virtual Reality.\n\nCreate virtual inspections of your off-the-plan properties in VR. You can talk to buyers in real-time, explain what they are seeing and navigate them throughout the property.\n\nOff-the-plan properties have been sold in the same way for years with brochures, high-quality photo renders, and stylish display suites. Whilst they do the trick, here at EnvisionVR we like to take things to the next level. That's why we created our world-first EnvisionVR app which allows you to view your future project in high-fidelity Virtual Reality and Augmented Reality using a VR headset or smart device. Our VR experiences are completely mobile, multi-person and collaborative coupled with an easy- to-use interface that will enhance your sales process.", "short_description": "Our EnvisionVR app allows you to view your future projects in high-fidelity Virtual Reality.\n\nCreate virtual inspections of your off-the-plan properties in VR. You can talk to buyers in real-time, explain what they are seeing and navigate them throughout the property."}]}, "developer_name": null, "developer_privacy_policy_url": "https://envisionvr.net/app-privacy-policy/", "developer_terms_of_service_url": "https://envisionvr.ne
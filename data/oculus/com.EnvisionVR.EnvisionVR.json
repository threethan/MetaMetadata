FeL20Q7kNvwGwMjYt&_nc_oc=AdrPwA7aNl8LilpKk3R1qErBtOqpJEtqU25fE5xHZmomuiA8bo0rQzbHHaaT-sRSxIA&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_Af38LtcHSEffUY_K9cOjasHFNxFiko2CigAZzX-uuiNl-A&oe=69F1EEF0"}, {"file_name": "Screenshot 1.png", "id": "919430915620427", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38982450_919430918953760_3431993627679132075_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CG6BljTVJwYQ7kNvwHeBarI&_nc_oc=Adol1kfnHLhEBXZMUDMpNHeaO7exTvSP36vqOmhZCfZiKcEGwpWeQSsrgQvcjrcdqeI&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&oh=00_Af0aFVvm6SYcQ2uJXNWOY7VWQjpqzX-KucUyBMFaBZ_uLA&oe=69F1F472"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer Thumbnail.png", "id": "1003097757117807", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/57569468_1003097767117806_5720121769644944108_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ogz1njZlLVYQ7kNvwE0MjFm&_nc_oc=AdodHvg3gbkdaHy7YQdmnKsNwKtf7MewnfKcib1larhyFXsNp2lc19jykcVBT5hCbjE&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&oh=00_Af0xLB4td3jb624rWzPg69TjXwP51DNi3U4PRjBPeFqu_g&oe=69F1E9D4"}, "display_name": "EnvisionVR", "keywords": [], "long_description": "Our EnvisionVR app allows you to view your future projects in high-fidelity Virtual Reality.\n\nCreate virtual inspections of your off-the-plan properties in VR. You can talk to buyers in real-time, explain what they are seeing and navigate them throughout the property.\n\nOff-the-plan properties have been sold in the same way for years with brochures, high-quality photo renders, and stylish display suites. Whilst they do the trick, here at EnvisionVR we like to take things to the next level. That's why we created our world-first EnvisionVR app which allows you to view your future project in high-fidelity Virtual Reality and Augmented Reality using a VR headset or smart device. Our VR experiences are completely mobile, multi-person and collaborative coupled with an easy- to-use interface that will enhance your sales process.", "short_description": "Our EnvisionVR app allows you to view your future projects in high-fidelity Virtual Reality.\n\nCreate virtual inspections of your off-the-plan properties in VR. You can talk to buyers in real-time, explain what they are seeing and navigate them throughout the property."}]}, "developer_name": null, "developer_privacy_policy_url": "https://envisionvr.net/app-privacy-policy/", "developer_terms_of_service_url": "https://envisionvr.net/app-terms-of-use/", "publisher_name": "Envision VR Pty Ltd", "support_website_url": null, "website_url": "https://envisionvr.net/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["UTILITY"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "MULTI_USER"], "id": "472978657736445"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PUBLISHED", "id": "771801522485846"}, {"status": "PUBLISHED", "id": "424431802146958"}]}, "baseline_offer": {"id": "771801522485846"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1757989200, "status": "PUBLISHED", "id": "771801522485846"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "25836288359346586", "version": "6.1.009"}, "id": "872482230142594", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "bina
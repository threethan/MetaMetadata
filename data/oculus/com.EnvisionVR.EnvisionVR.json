077517136_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ci7jDDWUn3kQ7kNvwH4GWJc&_nc_oc=AdpdMSDP60VxVZJE6M2hdwYh5EED_6AuyX7T7LRohcKW75CA_l40N7j__ZA7UNKSyiI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKvlDz-uW3fc8ihIvWJaAcPHlDM6YmJByur-JHY5cV3mQ&oe=6AAC0AB0"}, {"file_name": "Screenshot 1.png", "id": "919430915620427", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982450_919430918953760_3431993627679132075_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WjgfbHJ0kCIQ7kNvwHvHKbw&_nc_oc=Adoxq9e1opq4AFdW1EZqczn18o68LuouWLlKNXuFCVBwFn-6rINUq1DNgLs_6tNhAiQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKdKmf-zdVKxw_nXh0g0UC19mE1-jq1X3j-y_R18qHrlQ&oe=6AAC1032"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer Thumbnail.png", "id": "1003097757117807", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/57569468_1003097767117806_5720121769644944108_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g-3DjG_QJVgQ7kNvwFjNPS_&_nc_oc=AdqlHHye4OwZpg-3IVT2gWuCt0FsPWaff0MKL53h6Jz80slFi4S2fHZzYiWT9xyaVvE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLLSJ254BZ-Xf4mU_ToGORkCxasAsFWO7GHq84o-UDS6A&oe=6AAC0594"}, "display_name": "EnvisionVR", "keywords": [], "long_description": "Our EnvisionVR app allows you to view your future projects in high-fidelity Virtual Reality.\n\nCreate virtual inspections of your off-the-plan properties in VR. You can talk to buyers in real-time, explain what they are seeing and navigate them throughout the property.\n\nOff-the-plan properties have been sold in the same way for years with brochures, high-quality photo renders, and stylish display suites. Whilst they do the trick, here at EnvisionVR we like to take things to the next level. That's why we created our world-first EnvisionVR app which allows you to view your future project in high-fidelity Virtual Reality and Augmented Reality using a VR headset or smart device. Our VR experiences are completely mobile, multi-person and collaborative coupled with an easy- to-use interface that will enhance your sales process.", "short_description": "Our EnvisionVR app allows you to view your future projects in high-fidelity Virtual Reality.\n\nCreate virtual inspections of your off-the-plan properties in VR. You can talk to buyers in real-time, explain what they are seeing and navigate them throughout the property."}]}, "developer_name": null, "developer_privacy_policy_url": "https://envisionvr.net/app-privacy-policy/", "developer_terms_of_service_url": "https://envisionvr.net/app-terms-of-use/", "publisher_name": "Envision VR Pty Ltd", "support_website_url": null, "website_url": "https://envisionvr.net/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["UTILITY"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "MULTI_USER"], "id": "472978657736445"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PUBLISHED", "id": "771801522485846"}, {"status": "PUBLISHED", "id": "424431802146958"}]}, "baseline_offer": {"id": "771801522485846"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1757989200, "status": "PUBLISHED", "id": "771801522485846"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "27885449134430488", "version": "8.0.038"}, "id": "872482230142594", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false
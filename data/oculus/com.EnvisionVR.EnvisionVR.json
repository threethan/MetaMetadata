077517136_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=14lxhewMAWwQ7kNvwGDJ1ak&_nc_oc=Adr2K5yO1HCoJaOMuFvciq1z_XOhfFvOem_BtA_cXP1T8WIi1DXh_Ewz6PCIYNdbO6I&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6U4gsJJS2F3n1gxibg-qHciqvAZyVa0_QroEh1jcmjLg&oe=69FE04B0"}, {"file_name": "Screenshot 1.png", "id": "919430915620427", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38982450_919430918953760_3431993627679132075_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HNr44FCjtZIQ7kNvwGe9UhS&_nc_oc=AdqX0dGSnwwKQDBQrfybEx9ByBtrPOMhwmtrJe7hErLCuybIBNdjAOqHkELt1ad-KzE&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5i7Ap3IEED9NG8FG4z6Mcth7iLcqf2TqeMuJjkJKgvyQ&oe=69FDD1F2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer Thumbnail.png", "id": "1003097757117807", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/57569468_1003097767117806_5720121769644944108_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hU3qMvmJFyEQ7kNvwEnvyT6&_nc_oc=AdqySUh7Rbml84Z--_aGuBOFNAI57V6lLFuqAszJikUQ1FfzJHUmTpwcDv-ys79LUco&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5nnR3Fb5bCU00P7zIj2LppCIELXuEYotG0C840ZktkPQ&oe=69FDFF94"}, "display_name": "EnvisionVR", "keywords": [], "long_description": "Our EnvisionVR app allows you to view your future projects in high-fidelity Virtual Reality.\n\nCreate virtual inspections of your off-the-plan properties in VR. You can talk to buyers in real-time, explain what they are seeing and navigate them throughout the property.\n\nOff-the-plan properties have been sold in the same way for years with brochures, high-quality photo renders, and stylish display suites. Whilst they do the trick, here at EnvisionVR we like to take things to the next level. That's why we created our world-first EnvisionVR app which allows you to view your future project in high-fidelity Virtual Reality and Augmented Reality using a VR headset or smart device. Our VR experiences are completely mobile, multi-person and collaborative coupled with an easy- to-use interface that will enhance your sales process.", "short_description": "Our EnvisionVR app allows you to view your future projects in high-fidelity Virtual Reality.\n\nCreate virtual inspections of your off-the-plan properties in VR. You can talk to buyers in real-time, explain what they are seeing and navigate them throughout the property."}]}, "developer_name": null, "developer_privacy_policy_url": "https://envisionvr.net/app-privacy-policy/", "developer_terms_of_service_url": "https://envisionvr.net/app-terms-of-use/", "publisher_name": "Envision VR Pty Ltd", "support_website_url": null, "website_url": "https://envisionvr.net/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["UTILITY"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "MULTI_USER"], "id": "472978657736445"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PUBLISHED", "id": "771801522485846"}, {"status": "PUBLISHED", "id": "424431802146958"}]}, "baseline_offer": {"id": "771801522485846"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1757989200, "status": "PUBLISHED", "id": "771801522485846"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "25836288359346586", "version": "6.1.009"}, "id": "872482230142594", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false
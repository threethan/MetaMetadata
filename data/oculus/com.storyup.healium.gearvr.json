-dsfamjXZ20aZ3BxguMakUPuu_h0WMIuM&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9BHU03-f6FJP7POdSfM3cInMCwiYx8PAAe2GQuDU3zHQ&oe=6A2184AC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Untitled design (1).png", "id": "2858722084348705", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39036607_2858722087682038_2665872789385916237_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=184v2mgvSCMQ7kNvwEM8FiM&_nc_oc=AdqrBFlH5joJwzsGHln7zZoyyj-Qq6yhkrsQ7V7Yvl02ykX_C36fofHB1yTwPNqfaKw&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8Lnzr27pxeUphmYgFhbzbHUkT3gveZpLMEabWV8j1FAg&oe=6A218E72"}, "display_name": "Healium", "keywords": ["MEDITATION", "MINDFULNESS", "relax", "calm", "nature"], "long_description": "Beautiful escapes and stories that feed your soul and recalibrate your digital diet.  Float through a crystal forest, make the flurries fly inside a magic snowglobe or trace a mandalynth. Your thoughts have POWER not only in the virtual world but the real world as well. This is the lite version of our app. To experience Healium Pro with a Brainlink Lite EEG headband, a data fitness dashboard, our video curriculum on neuromeditation, and updated content, please email hello@tryhealium.com. Note: this is a self-awareness tool and is not a treatment or diagnostic tool for any disease or medical condition. ", "short_description": "Beautiful nature escapes and stories that feed your soul and recalibrate your digital diet. "}]}, "developer_name": "StoryUP, Inc. dba Healium", "developer_privacy_policy_url": "https://tryhealium.com/privacy-policy", "developer_terms_of_service_url": "https://www.tryhealium.com/terms-and-conditions/", "publisher_name": "StoryUP, Inc. dba Healium", "support_website_url": "https://www.tryhealium.com/faq/", "website_url": "https://www.tryhealium.com/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics"
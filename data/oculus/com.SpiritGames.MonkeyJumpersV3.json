i": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499308043_3787909771357309_4366711686465143906_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ibtcp_mZb5MQ7kNvwH4iv6L&_nc_oc=Ado_Az_vqweqfrRdrDmFmuvUqJDRdOoeBQWWx-cR0wtL2zA2_dI4xJq3sk3PkSR9RcE&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSA08cHc3dRKDZfUJivhTIAd_RCgeuchv8QSLuzZsT6SA&oe=6AFB2B71"}, {"file_name": "MJV3 3_1440p_05.10.2026_21-13-30.png", "id": "1654799169499187", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/754914855_1654799172832520_61650822324673101_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GGIsNwmVDRcQ7kNvwEOCiSA&_nc_oc=Adr2dY06shDUUQJwuiVezc9x0VFScRWVpLv1UsxdS6GrKEf3ZahtqMNtipFc5WJw7Q8&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRfmZl1WnPBDOOXZot_wCHlc-qT6t58bVYq0KotwqV85g&oe=6AFB319C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Monkey Jumpers VR", "keywords": ["Monkey", "Gorilla", "Baboon", "Jump", "Jmancurly"], "long_description": "\ud83d\udc12 WELCOME TO MONKEY JUMPERS VR!\n\nA multiplayer VR experience packed with climbing, movement, tag, and fun! Explore creative maps, compete with friends, earn rewards, and customize your monkey.\n\n\ud83d\ude80 MAPS TO EXPLORE:\n\ud83e\ude90 Zero Gravity \u2013 Defy physics!\n\ud83d\udd25 Rising Lava \u2013 Stay above the lava and earn rewards!\n\ud83e\uddd7 Parkour \u2013 Conquer obstacles and earn rewards!\n\ud83d\udecd\ufe0f Mall \u2013 Shop for cosmetics and hang out!\n\ud83d\udd2a Murder Mystery \u2013 Survive the murderer!\n\u26f0\ufe0f King of the Hill \u2013 Fight for the top with FLING HAMMERS!\n\n\ud83c\udfae GAME MODES\n\ud83e\udda0 Infection \u2013 Tag others before getting tagged!\n\ud83e\udded Ranked \u2013 Climb the ranks and prove your skills!\n\ud83d\ude48 Casual \u2013 Explore and practice at your own pace!\n\n\u2728 CORE FEATURES\n\ud83c\udfa8 Customize your monkey's color\n\u2699\ufe0f Adjustable graphics settings\n\u270d\ufe0f Personalized names\n\ud83d\udd11 Public and private rooms\n\ud83c\udfc6 Leaderboards and secure reporting\n\n\ud83d\udc40AND MUCH MORE!\n\n\ud83d\udd25 READY TO JUMP IN? Grab your friends, challenge other monkeys, explore every map, and prove you have what it takes to reach the top!\n\n\ud83d\udc12 YOUR NEXT ADVENTURE STARTS NOW. PLAY MONKEY JUMPERS VR TODAY!", "short_description": "Monkey Jumpers VR is a fast-paced multiplayer VR climbing game where you run, jump, and swing through unique maps like Zero Gravity, Rising Lava, and Parkour. Play with friends in Casual or Infection mode, customize your monkey, and explore the shop for endless fun!"}]}, "developer_name": "ghxsty", "developer_privacy_policy_url": "https://sites.google.com/view/monkey-jumpers-llc/privacy-policy", "developer_terms_of_service_url": "https://sites.google.com/view/monkey-jumpers-llc/terms-of-service", "publisher_name": "Spirit Games ", "support_website_url": "https://sites.google.com/view/monkey-jumpers-llc/support", "website_url": "https://sites.google.com/view/monkey-jumpers-llc/home?read_current=1", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "29441867832073038"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/499620532_1112434
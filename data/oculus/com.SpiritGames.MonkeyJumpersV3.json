nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7xGLR8AhetAQ7kNvwHMVX4h&_nc_oc=AdrMqM2buI-8o5fzGOJBGnoO7iTezaOXZcV5Bs1VO_bZu4bYtPecz7MFhtrYHQYWE0Q&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS4Vv4MxohTb90_nngK6fvYZtLvAGRD1lGqofa8vq--UQ&oe=6AFB23CE"}, {"file_name": "MJV3 1_1440p_31.08.2025_21-12-30.png", "id": "1761134464529640", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/491827096_1761134471196306_6910459204752813650_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wQZSp5xCE3cQ7kNvwHJmNHS&_nc_oc=AdoXcTfMvgZe4t8TLcp0wzyXJFhaCG5b7qIQnCkreQdrkugbWgoj4XrwM2qJQVPerOI&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQoQMDb4O6iRwceLJ91lowVOF8tBexMXD6u0LV_2wVGSw&oe=6AFB2676"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Monkey Jumpers V3", "keywords": ["Monkey", "Gorilla", "Chimp", "Baboon", "Tag"], "long_description": "Monkey Jumpers V3 is the next evolution of the Monkey Jumpers series \u2014 a multiplayer VR experience inspired by fast-paced climbing and tag-style gameplay. Race across walls, leap between platforms, and swing your way through creative environments while competing with friends or hanging out casually.\n\nMaps to Explore:\n\n\ud83e\ude90 Zero Gravity \u2013 Defy physics and leap higher than ever.\n\n\ud83d\udd25 Rising Lava \u2013 Stay off the ground or get burned as lava rises around you.\n\n\ud83e\uddd7 Parkour \u2013 Test your skill with jumps, climbs, and obstacles.\n\n\ud83d\udecd\ufe0f Shop \u2013 Hang out, find cosmetics, and customize your monkey\u2019s look.\n\nGame Modes:\n\n\ud83e\udda0 Infection \u2013 Tag others before you get tagged yourself.\n\n\ud83d\ude48 Casual \u2013 Explore maps and practice movement with no pressure.\n\nCore Features:\n\n\ud83c\udfa8 Color changing to make your monkey your own.\n\n\u2699\ufe0f Adjustable graphics and quality settings for smooth gameplay.\n\n\u270d\ufe0f Name changing to personalize your profile.\n\n\ud83d\udd11 Join private or public rooms to play how you want.\n\n\ud83c\udfc6 Leaderboard system with secure reporting to keep games fair.\n\nWhether you\u2019re competing to be the fastest climber, surviving the lava, or just chilling in the shop, Monkey Jumpers V3 gives you endless ways to play, customize, and connect.", "short_description": "Monkey Jumpers V3 is a fast-paced multiplayer VR climbing game where you run, jump, and swing through unique maps like Zero Gravity, Rising Lava, and Parkour. Play with friends in Casual or Infection mode, customize your monkey, and explore the shop for endless fun!"}]}, "developer_name": "ghxsty", "developer_privacy_policy_url": "https://sites.google.com/view/monkey-jumpers-llc/privacy-policy", "developer_terms_of_service_url": "https://sites.google.com/view/monkey-jumpers-llc/terms-of-service", "publisher_name": "Spirit Games", "support_website_url": null, "website_url": "https://sites.google.com/view/monkey-jumpers-llc/home?read_current=1", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "24933034729623060"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1956718435168549"}]}, "baseline_offer": {"id": "1956718435168549"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1757455200, "status": "PUBLISHED", "id": "1956718435168
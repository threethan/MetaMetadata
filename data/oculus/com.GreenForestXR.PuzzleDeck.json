276198429684_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eOLs6FC6noMQ7kNvwEYy928&_nc_oc=AdofOHzftOrjivH69tawPlAppKut6jbjCtj-IQgnaIE61gC587zt1IQ-UXhnZli1OA8&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH0PGM211nfJFHdwftNq7aty41eFjXoDW1_aa5Ph-L2Ng&oe=6A7D9D23"}, {"file_name": "Screenshots_5.png", "id": "1293934396177986", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/499307505_1293934399511319_6908541319493325468_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PCmS-aqszk8Q7kNvwFXqIs9&_nc_oc=AdrisygX78PPqRfsbnJogSgSl7_8kXXzHhVndZ5hEMnlwgWomDIGT9uZb1MduaLbRk4&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF_di6riLcx11dqmN6lIKZvPB1GCkHrQXSAHYOP1372lQ&oe=6A7DCAF5"}, {"file_name": "Screenshots_2.png", "id": "934774526133689", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/499303140_934774529467022_7945644030852261457_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pG_nFAdtfjQQ7kNvwHwlYCH&_nc_oc=AdosM5Eklx3HAtL5zDO13D6eRm16oeTqyFhrtQjKJN92-mNr68OuNlcvw5kMCxoYg8c&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH4Pff24SfsPHYak2xtNsBkvXnO0m5hvz2BDxpc5mxYAg&oe=6A7D9F80"}, {"file_name": "Screenshots_4.png", "id": "2443467659492849", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/499311597_2443467662826182_2710033976610390550_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GaozIlcPUWAQ7kNvwEutd4z&_nc_oc=AdrAOw0JhjguKGVBr-APRhP2dxxUgGrZCtI8cYXTDzzDgSVd7IcElDD9_R4DV3itxqQ&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFAJDmQp6pxIq79EEmdQ2gKnhJdhLZbDbNoiftsudwdeA&oe=6A7D9884"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_Screenshot.png", "id": "1458578349083089", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/499307311_1458578352416422_679664406557939941_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rELPP4HSOy4Q7kNvwHfgk8a&_nc_oc=AdpC1tmPnjvI37VMn86FrDVkJ2877oBpKT4R2ZaRBDwts85R2tqZDGh8Vfk7zrXa9TY&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHiVnEXS20X-_rZW2XBw5NV5Eohe43bkGac4YXOGWyisg&oe=6A7DB7FB"}, "display_name": "Puzzle Deck", "keywords": [], "long_description": "PuzzleDeck is for people who love to build. Pick up a hand-crafted tin toy puzzle, piece it together with your hands in the space in front of you, and finish each one with a reveal that only spatial computing can deliver. A Great White Shark, life-sized, right there in the room with you.\n\nWhen the final piece clicks into place, the puzzle reveals itself at true scale. Build a Blue Whale and walk around it. Build a shark and meet it at the size it actually is. Each reveal is the payoff that makes every puzzle worth finishing.\nThe Ocean Series. Three iconic ocean animals styled as vintage tin toys: a Great White Shark, a Blue Whale, and an Orca. Build all three to complete the series.\n\nFree, and made for everyone. Suitable for players of all ages, including kids. No advertising, no chat, no data collection. Just the experience.\nBy Green Forest XR. An independent indie studio building spatial tools that bring the digital and physical together. New themed Puzzle Kits are planned post-launch.", "short_description": "Build hand-crafted tin toy puzzles, piece by piece. Then meet each one at full size in your living room. PuzzleDeck is a collectible spatial puzzle experience. Build a Great White Shark and see what 6 metres really looks like. Build a Blue Whale and walk around it at true scale. The Ocean Series is free while in Beta. No ads, no chat, no pressure. Just building."}]}, "developer_name": null, "developer_privacy_policy_url": "https://greenforestxr.io/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Green Forest XR", "support_website_url": null, "website_url": "https://greenforestxr.io/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_
": "809536231902388", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499304938_809536235235721_4289016802026956729_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uOQZqxsja6UQ7kNvwGoyTeW&_nc_oc=AdrQxLTynXYdzAFdNO7zclVfomuvXNoyZiTIZgRvxmlc1KfDTf7bilsPGOcdoAMXiGU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_nlQuka8Ow0EGIvnIsG2-Ew6o73wQd4Tf5Zw4rkeBGtw&oe=6A2D6564"}]}, "id": "818642754228285", "locale": "en_US", "screenshots": [{"file_name": "Screenshot_1.png", "id": "1617849999504098", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499308010_1617850002837431_262267568755372791_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4fdpVq5AZW8Q7kNvwEli-2-&_nc_oc=AdpJ46qU-5y-pOKIHNGbtKeyFNHC8P_ga9f-eEXhh08v3ywOAYFtW2uNPgUwBnadurA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_3Tf0pmT5mHIObfwyD8HQwqHvvmm4pEbkS_uaI0N2L-g&oe=6A2D7065"}, {"file_name": "Screenshots_3.png", "id": "1460205252258799", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499303672_1460205255592132_1860223276198429684_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jwYQcatmAJkQ7kNvwE_hvpE&_nc_oc=AdrB6K_oPuaT7TINxvconqmgCEtTiIHTA312I3wg8GENL26dG1wp_-twFR8hG8n90MA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8DGarMpi6AYe-7gDqKGTA93bT-q3cwhRT6kXvVlL9tKQ&oe=6A2D69E3"}, {"file_name": "Screenshots_5.png", "id": "1293934396177986", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499307505_1293934399511319_6908541319493325468_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KbOeR6n6_PkQ7kNvwHD8QUS&_nc_oc=AdpQcFzWLRgkyxtboTFH1hmmRnNdWPpJC_j7lIpcUrmhkcYCI50Labh6uqjujT2TCYw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af92tnUNaekQAqAwWOLUgPvhZjcqgfge2GFjoYXYDp8FVw&oe=6A2D5F75"}, {"file_name": "Screenshots_2.png", "id": "934774526133689", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499303140_934774529467022_7945644030852261457_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xkVdZM3-m2kQ7kNvwFJpu5B&_nc_oc=Ado93taNuUbbL6r2JNFaOqaYOoWZV4jBYxp-jkVz8vkZ7HNmx-UVDdX4GcbfgQq8dJU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8B3gZfeOWiaz9gjF-abO8U6465M8TrB6GycubuOKFzjg&oe=6A2D6C40"}, {"file_name": "Screenshots_4.png", "id": "2443467659492849", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499311597_2443467662826182_2710033976610390550_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oqcz73o_0QkQ7kNvwEf_oGV&_nc_oc=AdrcyXJGjKELuitJbczcXYE-_heKD0QfhNBuEtfBlunuP6IAzVHfaSQYZVNMxp0cGWc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9oUTSYSV_y3cm8Ys2ytKaRDMFK8m2FWMsrbnzSgVP0Yg&oe=6A2D6544"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_Screenshot.png", "id": "1458578349083089", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499307311_1458578352416422_679664406557939941_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0dmFm8a7Q8gQ7kNvwE-5QcS&_nc_oc=Adp9mWnTsZ0Wl70jkcysKdFa_UUByI1mPfjhJIxEToa_ZK6cwUg_XLajkKv1veOIpSU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-zKcgVMFAxE8VI_oVrdIPA01E37GtuXD982jcc3PVL7g&oe=6A2D4C7B"}, "display_name": "Puzzle Deck", "keywords": [], "long_description": "PuzzleDeck is for people who love to build. Pick up a hand-crafted tin toy puzzle, piece it together with your hands in the space in front of you, and finish each one with a reveal that only spatial computing can deliver. A Great White Shark, life-sized, right there in the room with you.\n\nWhen the final piece clicks into place, the puzzle reveals itself at true scale. Build a Blue Whale and walk around it. Build a shark and meet it at the size it actually is. Each reveal is the payoff that makes every puzzle worth finishing.\nThe Ocean Series. Three iconic ocean animals styled as vintage tin toys: a Great White Shark, a Blue Whale, and an Orca. Build all three to complete the series.\n\nFree, and made for everyone. Suitable for players of all ages, including kids. No advertising, no chat, no data collection. Just the experience.\nBy Green Forest XR. An independent indie studio building spatial tools that bring the digital and physical together. New themed Puzzle Kits are planned post-launch.", "short_description": "Build hand-crafted tin toy puzzles, piece by piece. Then meet each one at full size in your living room. PuzzleDeck is a collectible spatial puzzle experience. Build a Great White Shark and see what 6 metres really looks like. Build a Blue Whale and walk around it at true scale. The Ocean Series is free while in Beta. No ads, no chat, no pressure. Just building."}]}, "developer_name": null, "developer_privacy_policy_url": "https://greenforestxr.io/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Green Forest XR", "support_website_url": null, "website_url": "https://greenforestxr.io/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "27000539029540437"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499308103_1602973624331600_4482919571313751154_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XDVeQd9Tv44Q7kNvwGqDpch&_nc_oc=AdqOOjzkfsfLfvtSodNwA1rDr7D6dJlJLmZPOgMJTa0H3F8GElBGNGblo6dNbLXuL0c&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f2
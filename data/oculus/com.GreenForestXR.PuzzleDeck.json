_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC9hlAvzR1t9TgjVneEX0dgoNEirnjuIw550dVC90aEsw&oe=6A54F6E3"}, {"file_name": "Screenshots_5.png", "id": "1293934396177986", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499307505_1293934399511319_6908541319493325468_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gQnabwp-310Q7kNvwHiHkkX&_nc_oc=Adoz00xvODlOBwCy9kOohuqW89gW6XtJkTgRKhmcFN2SB-UXEXQ95Z5zrf7ff9In-Lk&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCZ-mcZsp6O-KV6EDEazh1aie6aMcu7Gk16zmNxsRX0rg&oe=6A54EC75"}, {"file_name": "Screenshots_2.png", "id": "934774526133689", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/499303140_934774529467022_7945644030852261457_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FXIxZZYyAJgQ7kNvwHYDqMq&_nc_oc=AdoynsL6mp7oVnaDVnCrk_1FgqNJFWpKbYRbhzKCTDe6ZBpnR2VGlphgUD6-1Xn_PLE&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCa7q4tgz3TuoT8AeKEA6P1zWWdpZgymbli6EajCYkUYQ&oe=6A54F940"}, {"file_name": "Screenshots_4.png", "id": "2443467659492849", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499311597_2443467662826182_2710033976610390550_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cF4T-6lWlI4Q7kNvwHN9QA_&_nc_oc=AdrBSkbESj8rlGleERUBeAc2l-1Zwae1L-aYJC6XC30idb6fmVWbQPyIqha94zU0Npo&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD16q3smSVJQxvO8-NndqSrIaGe6QJwLsY17i1VM5kBEw&oe=6A54F244"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_Screenshot.png", "id": "1458578349083089", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499307311_1458578352416422_679664406557939941_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QMJ7umnUxK8Q7kNvwFZ1pRw&_nc_oc=AdrtAlUH2xGRJiymDevcuqm88fC6Zfwk_uaBORh34158Fyd7gwtvxNDsV4fJbwLXAIU&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCqaab79IcPjbHb0UKBfLfxHNxkOV5IZ2zY1XOifgRN2A&oe=6A54D97B"}, "display_name": "Puzzle Deck", "keywords": [], "long_description": "PuzzleDeck is for people who love to build. Pick up a hand-crafted tin toy puzzle, piece it together with your hands in the space in front of you, and finish each one with a reveal that only spatial computing can deliver. A Great White Shark, life-sized, right there in the room with you.\n\nWhen the final piece clicks into place, the puzzle reveals itself at true scale. Build a Blue Whale and walk around it. Build a shark and meet it at the size it actually is. Each reveal is the payoff that makes every puzzle worth finishing.\nThe Ocean Series. Three iconic ocean animals styled as vintage tin toys: a Great White Shark, a Blue Whale, and an Orca. Build all three to complete the series.\n\nFree, and made for everyone. Suitable for players of all ages, including kids. No advertising, no chat, no data collection. Just the experience.\nBy Green Forest XR. An independent indie studio building spatial tools that bring the digital and physical together. New themed Puzzle Kits are planned post-launch.", "short_description": "Build hand-crafted tin toy puzzles, piece by piece. Then meet each one at full size in your living room. PuzzleDeck is a collectible spatial puzzle experience. Build a Great White Shark and see what 6 metres really looks like. Build a Blue Whale and walk around it at true scale. The Ocean Series is free while in Beta. No ads, no chat, no pressure. Just building."}]}, "developer_name": null, "developer_privacy_policy_url": "https://greenforestxr.io/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Green Forest XR", "support_website_url": null, "website_url": "https://greenforestxr.io/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area
": "809536231902388", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499304938_809536235235721_4289016802026956729_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cbOjzgx-JqEQ7kNvwFbNB2v&_nc_oc=AdqDSY3P_u2yzGg_Sv5UqRXKrTn3XamyJFh7ZbFaXmgUaX5mTRobi7Iswdr91geyk0k&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-j1CVCcmluKeQvQCKWno796VSVPCUXMHct_t8aYkLHNA&oe=6A47C364"}]}, "id": "818642754228285", "locale": "en_US", "screenshots": [{"file_name": "Screenshot_1.png", "id": "1617849999504098", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499308010_1617850002837431_262267568755372791_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Nj8fKXkrq1wQ7kNvwEhXWbN&_nc_oc=AdoqVy0TBXErYNky1EhIqUxVJMDomjUwqOweIisTpiQOj8Dp-21naKyZHkK9kA2-h_g&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9Jequk0f-tyM4Oi2nfV47y5Tn5JyKo-pTfEqySHi9seQ&oe=6A47CE65"}, {"file_name": "Screenshots_3.png", "id": "1460205252258799", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499303672_1460205255592132_1860223276198429684_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5Gj713ZGHYIQ7kNvwFAJloX&_nc_oc=AdqfTY7qmYjM07Q-EymYuTvtodTum1Aq50MaJ87FQleiAd7WpyB4z8-moKmzi82XO3s&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9S5AXHC0e5vROc6wI4f6gz9dnYh1NeKGRX_P79dyOWOg&oe=6A47C7E3"}, {"file_name": "Screenshots_5.png", "id": "1293934396177986", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499307505_1293934399511319_6908541319493325468_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7ofgBMk6ZMkQ7kNvwGmVXOc&_nc_oc=AdrES3FLhJXdMCxorLFGRQxDvOBTF6O4WR5cM7vSYCysOh59EahKHIqAcZxaICog0nI&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8Yhjc3RWO3HOU0kbIAFP3l64GIjroNA_ZnzeYlfOnZ1g&oe=6A47BD75"}, {"file_name": "Screenshots_2.png", "id": "934774526133689", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499303140_934774529467022_7945644030852261457_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Mhg_aYmuzAsQ7kNvwFrbFUD&_nc_oc=AdqFJerzCs9V8_P6qADXw9waGeH8fhPJmBFV34oEUae5KMpjVBgve4u_0M52LWnn_UY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-3FcqwvQfwFTTZWA_65l9XAlJsVNzRg6TuXCPAcqlsmQ&oe=6A47CA40"}, {"file_name": "Screenshots_4.png", "id": "2443467659492849", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499311597_2443467662826182_2710033976610390550_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9F7CM7V3UagQ7kNvwFiT4ry&_nc_oc=AdrOO0yvb9opeKhs5NlSmDD5Y64CwBJVv6vVuiGYO8-UfsHSKLuALeIkI8bsaBWRJHo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9QoMR9j__kigHvIJEPcC-OrAdCwxMwCUBANv2mN2_iYw&oe=6A47C344"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_Screenshot.png", "id": "1458578349083089", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499307311_1458578352416422_679664406557939941_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GTxHdvr0oucQ7kNvwFrH5Ib&_nc_oc=AdqhgOmXBxKnAvM4dskyKjx9raFa4BFoBZn-ZtdNH4TKWQbkLys58TksL5hQjH_VDvI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-B4h2MAjVC1wxOYevGK_VP1S8sG79NZuM1CNeTxBpglg&oe=6A47E2BB"}, "display_name": "Puzzle Deck", "keywords": [], "long_description": "PuzzleDeck is for people who love to build. Pick up a hand-crafted tin toy puzzle, piece it together with your hands in the space in front of you, and finish each one with a reveal that only spatial computing can deliver. A Great White Shark, life-sized, right there in the room with you.\n\nWhen the final piece clicks into place, the puzzle reveals itself at true scale. Build a Blue Whale and walk around it. Build a shark and meet it at the size it actually is. Each reveal is the payoff that makes every puzzle worth finishing.\nThe Ocean Series. Three iconic ocean animals styled as vintage tin toys: a Great White Shark, a Blue Whale, and an Orca. Build all three to complete the series.\n\nFree, and made for everyone. Suitable for players of all ages, including kids. No advertising, no chat, no data collection. Just the experience.\nBy Green Forest XR. An independent indie studio building spatial tools that bring the digital and physical together. New themed Puzzle Kits are planned post-launch.", "short_description": "Build hand-crafted tin toy puzzles, piece by piece. Then meet each one at full size in your living room. PuzzleDeck is a collectible spatial puzzle experience. Build a Great White Shark and see what 6 metres really looks like. Build a Blue Whale and walk around it at true scale. The Ocean Series is free while in Beta. No ads, no chat, no pressure. Just building."}]}, "developer_name": null, "developer_privacy_policy_url": "https://greenforestxr.io/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Green Forest XR", "support_website_url": null, "website_url": "https://greenforestxr.io/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "27000539029540437"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499308103_1602973624331600_4482919571313751154_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kRGl-P6ARl0Q7kNvwF7EhZg&_nc_oc=AdpUlWH4eTU9h1hFUS5a2A5wcF3bTz3FX8yYr5vwJ9VbzqXV92W1z-lhR5aa9T0GtuQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f2
_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9jANazvwdSzxug1JHD4Ycu63SlmdMP5hIiEDpBQY2nSA&oe=6A297563"}, {"file_name": "Screenshots_5.png", "id": "1293934396177986", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499307505_1293934399511319_6908541319493325468_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zq-kDY7dsSoQ7kNvwGzzivq&_nc_oc=Adq2pNP_wciu3RCinAUY5YyZlbbrlRBpK2G18HGgRBERYxT3b9zxRgavrsL--UfGAZk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-2KZj8MVsXX4qoEK9JAm2MnJgnC6JBK5tfVVuTfhutZA&oe=6A296AF5"}, {"file_name": "Screenshots_2.png", "id": "934774526133689", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499303140_934774529467022_7945644030852261457_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-BrMM3cn4RsQ7kNvwGTHqRB&_nc_oc=Adr2uCMNJglnaJ-djHjq7JxxDtg0Vb0O0Qn3hb7BPJnBC95KlZ5IWKbddeYdujc5wE8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8Nk09qJWAwWooRW0NZp1SVm79Y49M38HYKKpoaa64LrQ&oe=6A2977C0"}, {"file_name": "Screenshots_4.png", "id": "2443467659492849", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499311597_2443467662826182_2710033976610390550_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1luYXxvCVKkQ7kNvwGRemVw&_nc_oc=Adop6yBMSsxyzTjfrhXubmcgPfgvsfbZ7bqYYw9IvjR-D0IufWD07dwxzAxBoRK7OYE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9D9X3AKkO9oitV63J6zHxdpXkpK5-tyENvA2v5veVPdg&oe=6A2970C4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_Screenshot.png", "id": "1458578349083089", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499307311_1458578352416422_679664406557939941_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Po6j6fbDVvAQ7kNvwFJzSqO&_nc_oc=AdrBIhT02Q9d2EqYRYD4vSCQVXHWqKzKMABOZz14WO5Mb2B9VIN0XGBCGoAL9JXWW44&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8fXdKmOXJ6WUjbfCi23wPTE069YroAmgG-jj8a3uO-Ng&oe=6A2957FB"}, "display_name": "Puzzle Deck", "keywords": [], "long_description": "PuzzleDeck is for people who love to build. Pick up a hand-crafted tin toy puzzle, piece it together with your hands in the space in front of you, and finish each one with a reveal that only spatial computing can deliver. A Great White Shark, life-sized, right there in the room with you.\n\nWhen the final piece clicks into place, the puzzle reveals itself at true scale. Build a Blue Whale and walk around it. Build a shark and meet it at the size it actually is. Each reveal is the payoff that makes every puzzle worth finishing.\nThe Ocean Series. Three iconic ocean animals styled as vintage tin toys: a Great White Shark, a Blue Whale, and an Orca. Build all three to complete the series.\n\nFree, and made for everyone. Suitable for players of all ages, including kids. No advertising, no chat, no data collection. Just the experience.\nBy Green Forest XR. An independent indie studio building spatial tools that bring the digital and physical together. New themed Puzzle Kits are planned post-launch.", "short_description": "Build hand-crafted tin toy puzzles, piece by piece. Then meet each one at full size in your living room. PuzzleDeck is a collectible spatial puzzle experience. Build a Great White Shark and see what 6 metres really looks like. Build a Blue Whale and walk around it at true scale. The Ocean Series is free while in Beta. No ads, no chat, no pressure. Just building."}]}, "developer_name": null, "developer_privacy_policy_url": "https://greenforestxr.io/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Green Forest XR", "support_website_url": null, "website_url": "https://greenforestxr.io/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area
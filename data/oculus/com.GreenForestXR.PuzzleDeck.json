_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8m2IyjkxxMlUfQWl1aeaO21f0qotW6HWOwlun1FPDXPw&oe=6A2C1863"}, {"file_name": "Screenshots_5.png", "id": "1293934396177986", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/499307505_1293934399511319_6908541319493325468_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KbOeR6n6_PkQ7kNvwE9ZiBQ&_nc_oc=AdoL9gFfmWSat1uTUtaVASFH0r7bc1mO5f1McqeFRbpLCj6RVb-W7F7G-yoUsMmjEsk&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9jHrXjrVTs3msong98tW6nihDGXevTByurM-Ha4i0w2A&oe=6A2C0DF5"}, {"file_name": "Screenshots_2.png", "id": "934774526133689", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/499303140_934774529467022_7945644030852261457_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xkVdZM3-m2kQ7kNvwHwbD34&_nc_oc=AdqSXTijYliytJQuDyG9VKpvPPBk8aPK2luIBuzGm49YTg4If1dTQFEwc_WEsbb1_A0&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_hBcYWmXq8bzck_98LHFD3uHXkk8sik-IruBj6iI2nww&oe=6A2C1AC0"}, {"file_name": "Screenshots_4.png", "id": "2443467659492849", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/499311597_2443467662826182_2710033976610390550_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1luYXxvCVKkQ7kNvwFJSkPy&_nc_oc=AdqpGwX_lgqJTa7XHEGmBC0X2lPcFxqXwyiW7SwzSmYsdXxqF1U-XkL0TC91p1rT2Iw&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_HWsyqIxhNbwIrU5h1YXRmuDcFSu4AtVBX1th0VhqwPg&oe=6A2C13C4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_Screenshot.png", "id": "1458578349083089", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/499307311_1458578352416422_679664406557939941_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0dmFm8a7Q8gQ7kNvwHHNrOo&_nc_oc=Ado-JBpQ7IVXVKHWyHowsXi2MTRlA0uqQqTtraqpTA_7CFJfocXOosPa_jUMb6ETLhY&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-FWo9tw0tjFAgbjm5x4tEvWL0H2O-oQ2_L9vM30eqZXw&oe=6A2C333B"}, "display_name": "Puzzle Deck", "keywords": [], "long_description": "PuzzleDeck is for people who love to build. Pick up a hand-crafted tin toy puzzle, piece it together with your hands in the space in front of you, and finish each one with a reveal that only spatial computing can deliver. A Great White Shark, life-sized, right there in the room with you.\n\nWhen the final piece clicks into place, the puzzle reveals itself at true scale. Build a Blue Whale and walk around it. Build a shark and meet it at the size it actually is. Each reveal is the payoff that makes every puzzle worth finishing.\nThe Ocean Series. Three iconic ocean animals styled as vintage tin toys: a Great White Shark, a Blue Whale, and an Orca. Build all three to complete the series.\n\nFree, and made for everyone. Suitable for players of all ages, including kids. No advertising, no chat, no data collection. Just the experience.\nBy Green Forest XR. An independent indie studio building spatial tools that bring the digital and physical together. New themed Puzzle Kits are planned post-launch.", "short_description": "Build hand-crafted tin toy puzzles, piece by piece. Then meet each one at full size in your living room. PuzzleDeck is a collectible spatial puzzle experience. Build a Great White Shark and see what 6 metres really looks like. Build a Blue Whale and walk around it at true scale. The Ocean Series is free while in Beta. No ads, no chat, no pressure. Just building."}]}, "developer_name": null, "developer_privacy_policy_url": "https://greenforestxr.io/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Green Forest XR", "support_website_url": null, "website_url": "https://greenforestxr.io/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area
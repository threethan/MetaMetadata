_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_aCqK1AqZps8kp1Fx9uP5Aiw_Y9C995qCQ9ozAbAfsOw&oe=6A300CE3"}, {"file_name": "Screenshots_5.png", "id": "1293934396177986", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499307505_1293934399511319_6908541319493325468_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dM4LHdSmWicQ7kNvwF-T4ks&_nc_oc=AdqFdBEz1Nx5MdUuCrh7yCWX5w9wiQ_jOnYl3XKphBZcLHkp3hF5kSjXrOclB4NNYfo&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af921kufiTl8vQ7tqKEeyjIWaPn95TffXP9go7fanMSy6Q&oe=6A300275"}, {"file_name": "Screenshots_2.png", "id": "934774526133689", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499303140_934774529467022_7945644030852261457_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CFnNraUjUqwQ7kNvwHbVY-O&_nc_oc=AdoxOp-1ty9ak8inOxra400UpUBj2DpjhT6kxDp1vK19co0BtuYzI0qOhl5zIo0t-IM&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8IM3RqT60fIbFwMMPuqsi4dU1JstNpyWy2UVN0jJFY7A&oe=6A300F40"}, {"file_name": "Screenshots_4.png", "id": "2443467659492849", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499311597_2443467662826182_2710033976610390550_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oqcz73o_0QkQ7kNvwHArvEC&_nc_oc=Adrok0-sXRO6-NQiYwMgDea0psfDrVgmgJCo5jVvlZrdW2n8bkTZ_RH82bSim-HTydM&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9D7sYQFu_4pd7o5ihh1TO0jnAW5II7PRNOF9EnH6LOKg&oe=6A300844"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_Screenshot.png", "id": "1458578349083089", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499307311_1458578352416422_679664406557939941_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1SeN5XEo-b4Q7kNvwH8JSP1&_nc_oc=AdoOnk_KU7AW_TTZcnumJZ83HXCDq4INpFpez5SclPqC_fP-rxgIl_z5i5ahc_MuLxM&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8eKw1nnu0shQTMLTIPxj2KtaGYM-XqHUnNwD9jh-whlQ&oe=6A2FEF7B"}, "display_name": "Puzzle Deck", "keywords": [], "long_description": "PuzzleDeck is for people who love to build. Pick up a hand-crafted tin toy puzzle, piece it together with your hands in the space in front of you, and finish each one with a reveal that only spatial computing can deliver. A Great White Shark, life-sized, right there in the room with you.\n\nWhen the final piece clicks into place, the puzzle reveals itself at true scale. Build a Blue Whale and walk around it. Build a shark and meet it at the size it actually is. Each reveal is the payoff that makes every puzzle worth finishing.\nThe Ocean Series. Three iconic ocean animals styled as vintage tin toys: a Great White Shark, a Blue Whale, and an Orca. Build all three to complete the series.\n\nFree, and made for everyone. Suitable for players of all ages, including kids. No advertising, no chat, no data collection. Just the experience.\nBy Green Forest XR. An independent indie studio building spatial tools that bring the digital and physical together. New themed Puzzle Kits are planned post-launch.", "short_description": "Build hand-crafted tin toy puzzles, piece by piece. Then meet each one at full size in your living room. PuzzleDeck is a collectible spatial puzzle experience. Build a Great White Shark and see what 6 metres really looks like. Build a Blue Whale and walk around it at true scale. The Ocean Series is free while in Beta. No ads, no chat, no pressure. Just building."}]}, "developer_name": null, "developer_privacy_policy_url": "https://greenforestxr.io/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Green Forest XR", "support_website_url": null, "website_url": "https://greenforestxr.io/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area
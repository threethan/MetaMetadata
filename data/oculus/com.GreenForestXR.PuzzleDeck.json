": "809536231902388", "image_type": "APP_IMG_HERO", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499304938_809536235235721_4289016802026956729_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TTODVX2kvUYQ7kNvwHdhYj3&_nc_oc=AdpQ0eOg-CucL-pQp9ZDRItun97vQJSVg2MecHKVHARVeTYxbOaLq81Q9519VqKF3Z4&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_SWN9A2EZ-vKPWjzki7-tJBrm_KmnlhXByW-B5BMDGYw&oe=6A300864"}]}, "id": "818642754228285", "locale": "en_US", "screenshots": [{"file_name": "Screenshot_1.png", "id": "1617849999504098", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499308010_1617850002837431_262267568755372791_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F3KPL4C1pugQ7kNvwGl3No9&_nc_oc=AdpN7LUc4Fn8iUO0-acn9MMC_esPgJS27m46-nn_ouPVDqg_Ll9CYUudmTL6QI4SInI&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8W7Q2NKF97lQVPSwBbVhqHkH3MwkA4HXkQwUgMyBrVAw&oe=6A301365"}, {"file_name": "Screenshots_3.png", "id": "1460205252258799", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499303672_1460205255592132_1860223276198429684_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7pigSJhdCUkQ7kNvwGJlvyL&_nc_oc=Adp7Yhq92Dmaj9NT2RQdm_7lI5X-r5C0c95wpQBe2P3_DbJXRyo8XNB-60Lql0ZFfnw&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_aCqK1AqZps8kp1Fx9uP5Aiw_Y9C995qCQ9ozAbAfsOw&oe=6A300CE3"}, {"file_name": "Screenshots_5.png", "id": "1293934396177986", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499307505_1293934399511319_6908541319493325468_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dM4LHdSmWicQ7kNvwF-T4ks&_nc_oc=AdqFdBEz1Nx5MdUuCrh7yCWX5w9wiQ_jOnYl3XKphBZcLHkp3hF5kSjXrOclB4NNYfo&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af921kufiTl8vQ7tqKEeyjIWaPn95TffXP9go7fanMSy6Q&oe=6A300275"}, {"file_name": "Screenshots_2.png", "id": "934774526133689", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499303140_934774529467022_7945644030852261457_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CFnNraUjUqwQ7kNvwHbVY-O&_nc_oc=AdoxOp-1ty9ak8inOxra400UpUBj2DpjhT6kxDp1vK19co0BtuYzI0qOhl5zIo0t-IM&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8IM3RqT60fIbFwMMPuqsi4dU1JstNpyWy2UVN0jJFY7A&oe=6A300F40"}, {"file_name": "Screenshots_4.png", "id": "2443467659492849", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499311597_2443467662826182_2710033976610390550_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oqcz73o_0QkQ7kNvwHArvEC&_nc_oc=Adrok0-sXRO6-NQiYwMgDea0psfDrVgmgJCo5jVvlZrdW2n8bkTZ_RH82bSim-HTydM&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9D7sYQFu_4pd7o5ihh1TO0jnAW5II7PRNOF9EnH6LOKg&oe=6A300844"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_Screenshot.png", "id": "1458578349083089", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499307311_1458578352416422_679664406557939941_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1SeN5XEo-b4Q7kNvwH8JSP1&_nc_oc=AdoOnk_KU7AW_TTZcnumJZ83HXCDq4INpFpez5SclPqC_fP-rxgIl_z5i5ahc_MuLxM&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8eKw1nnu0shQTMLTIPxj2KtaGYM-XqHUnNwD9jh-whlQ&oe=6A2FEF7B"}, "display_name": "Puzzle Deck", "keywords": [], "long_description": "PuzzleDeck is for people who love to build. Pick up a hand-crafted tin toy puzzle, piece it together with your hands in the space in front of you, and finish each one with a reveal that only spatial computing can deliver. A Great White Shark, life-sized, right there in the room with you.\n\nWhen the final piece clicks into place, the puzzle reveals itself at true scale. Build a Blue Whale and walk around it. Build a shark and meet it at the size it actually is. Each reveal is the payoff that makes every puzzle worth finishing.\nThe Ocean Series. Three iconic ocean animals styled as vintage tin toys: a Great White Shark, a Blue Whale, and an Orca. Build all three to complete the series.\n\nFree, and made for everyone. Suitable for players of all ages, including kids. No advertising, no chat, no data collection. Just the experience.\nBy Green Forest XR. An independent indie studio building spatial tools that bring the digital and physical together. New themed Puzzle Kits are planned post-launch.", "short_description": "Build hand-crafted tin toy puzzles, piece by piece. Then meet each one at full size in your living room. PuzzleDeck is a collectible spatial puzzle experience. Build a Great White Shark and see what 6 metres really looks like. Build a Blue Whale and walk around it at true scale. The Ocean Series is free while in Beta. No ads, no chat, no pressure. Just building."}]}, "developer_name": null, "developer_privacy_policy_url": "https://greenforestxr.io/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Green Forest XR", "support_website_url": null, "website_url": "https://greenforestxr.io/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "27000539029540437"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499308103_1602973624331600_4482919571313751154_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=exuV6uJrIEIQ7kNvwHaq9Ow&_nc_oc=AdrWOoMYvZWYF9vaf6kD9Ogttei04zydrzEqj3VTZQxxkDohIqjoDr47gbq1uZ_mG3E&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f2
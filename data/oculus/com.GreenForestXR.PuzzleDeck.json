_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCUl2llyTHILt6JVG4ETjdqzi-WLRjL233wxj80FptxIw&oe=6A510263"}, {"file_name": "Screenshots_5.png", "id": "1293934396177986", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499307505_1293934399511319_6908541319493325468_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zrxXhJ_8ZosQ7kNvwG1-vb4&_nc_oc=Ado6_Id_ZfKc8RuiCKP2PsYBxAGICihd2GxfRwRYYdr_4HW-nj2Lhs0jIgE86R6_XJg&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBExvLHVo4rV5sJbN5HkdeCUK0tl3WIKG1qW00G4-Md1A&oe=6A50F7F5"}, {"file_name": "Screenshots_2.png", "id": "934774526133689", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499303140_934774529467022_7945644030852261457_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tcY97KWioIUQ7kNvwG34liH&_nc_oc=AdrDND4Vb8rFOZXjmz2OdVjnWlFozq7FHbQSz7o79pNGYtpb-xnh3ekUOSzL4tRwdiM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCzJQMszzVQudu9DbgoV7JXQAwjNkKeREjNtGzvEI_VzQ&oe=6A5104C0"}, {"file_name": "Screenshots_4.png", "id": "2443467659492849", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499311597_2443467662826182_2710033976610390550_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=naNR019xzg0Q7kNvwGKsKOv&_nc_oc=AdqjKFBybgMzDs1TuadflkdUCP1qHmvOef_3B-rFIhnSV3ayPYVxz35mclkL1B3IGA0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCxI_2eD-RQNl4a2iV_5xmyAANkwcXNiRBFde38r2CpZw&oe=6A50FDC4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_Screenshot.png", "id": "1458578349083089", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499307311_1458578352416422_679664406557939941_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NoMPo4EqkVAQ7kNvwF_L7fu&_nc_oc=AdoJbhujaRWkL39czu_GjeCCxntWzEaMAOR0C6APBbl04OmZ9HaL9ClMJ50pIBHY90A&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAuEgmz2j-wO64TBhZl_HLeb-EDP3gAJUXjLWgJH7WsOg&oe=6A50E4FB"}, "display_name": "Puzzle Deck", "keywords": [], "long_description": "PuzzleDeck is for people who love to build. Pick up a hand-crafted tin toy puzzle, piece it together with your hands in the space in front of you, and finish each one with a reveal that only spatial computing can deliver. A Great White Shark, life-sized, right there in the room with you.\n\nWhen the final piece clicks into place, the puzzle reveals itself at true scale. Build a Blue Whale and walk around it. Build a shark and meet it at the size it actually is. Each reveal is the payoff that makes every puzzle worth finishing.\nThe Ocean Series. Three iconic ocean animals styled as vintage tin toys: a Great White Shark, a Blue Whale, and an Orca. Build all three to complete the series.\n\nFree, and made for everyone. Suitable for players of all ages, including kids. No advertising, no chat, no data collection. Just the experience.\nBy Green Forest XR. An independent indie studio building spatial tools that bring the digital and physical together. New themed Puzzle Kits are planned post-launch.", "short_description": "Build hand-crafted tin toy puzzles, piece by piece. Then meet each one at full size in your living room. PuzzleDeck is a collectible spatial puzzle experience. Build a Great White Shark and see what 6 metres really looks like. Build a Blue Whale and walk around it at true scale. The Ocean Series is free while in Beta. No ads, no chat, no pressure. Just building."}]}, "developer_name": null, "developer_privacy_policy_url": "https://greenforestxr.io/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Green Forest XR", "support_website_url": null, "website_url": "https://greenforestxr.io/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area
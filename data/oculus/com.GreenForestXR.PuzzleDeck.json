_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af925_nRuZmPfOMfbYzvtMUTxUJu9ptt4WjT7eQ0FtT7Xg&oe=6A37F5E3"}, {"file_name": "Screenshots_5.png", "id": "1293934396177986", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499307505_1293934399511319_6908541319493325468_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pruBdaKTEq8Q7kNvwGXK0kP&_nc_oc=Adr4sWqwglXjtSJLFfblYBDTmohA5e90kfGb8LTM1mdQTzKq3mKZB8SHMt-vW4uSHdc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9VtS1jgUPkKERzKpRrgedFnE-fV9Ji7HFnRdZSzF2qbQ&oe=6A37EB75"}, {"file_name": "Screenshots_2.png", "id": "934774526133689", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499303140_934774529467022_7945644030852261457_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gryZZ-0doaIQ7kNvwHXGzFc&_nc_oc=AdrTLMP8SimIdELBFOj-3Jt3-CU3-S8YyGbqTbnLSZCmyB5jCEGYFPAD0uRhOEMLT5Y&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9Q0JGSOMHArnHL1ktdVJCLXcRomPZVVqv-eiBCnIdG0A&oe=6A37F840"}, {"file_name": "Screenshots_4.png", "id": "2443467659492849", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499311597_2443467662826182_2710033976610390550_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3MAfKHJzfwoQ7kNvwH3eTSm&_nc_oc=AdqXOt6iAdhRx-pJLQhuCzW9VbDpH9FxQGO_LobwP-Yo_OOVjXuvaJdIcJU1pRIfv6Q&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af94AxmxJimVBJqrhT4tdlPMahWsXWAUNwFkJbbKMN90ww&oe=6A37F144"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_Screenshot.png", "id": "1458578349083089", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499307311_1458578352416422_679664406557939941_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7I0GniTUyy4Q7kNvwHGSVS8&_nc_oc=AdqqPKOknPT37vSi1-Lb0lYjEKBUvusDJGhuX_EnydfOjNyp9J8LAqhmKyW_uJG3GIc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af93kj5rCRtcYiTV7r4S8dr9RZq10k3qB5M4Nzw1XrJtMA&oe=6A3810BB"}, "display_name": "Puzzle Deck", "keywords": [], "long_description": "PuzzleDeck is for people who love to build. Pick up a hand-crafted tin toy puzzle, piece it together with your hands in the space in front of you, and finish each one with a reveal that only spatial computing can deliver. A Great White Shark, life-sized, right there in the room with you.\n\nWhen the final piece clicks into place, the puzzle reveals itself at true scale. Build a Blue Whale and walk around it. Build a shark and meet it at the size it actually is. Each reveal is the payoff that makes every puzzle worth finishing.\nThe Ocean Series. Three iconic ocean animals styled as vintage tin toys: a Great White Shark, a Blue Whale, and an Orca. Build all three to complete the series.\n\nFree, and made for everyone. Suitable for players of all ages, including kids. No advertising, no chat, no data collection. Just the experience.\nBy Green Forest XR. An independent indie studio building spatial tools that bring the digital and physical together. New themed Puzzle Kits are planned post-launch.", "short_description": "Build hand-crafted tin toy puzzles, piece by piece. Then meet each one at full size in your living room. PuzzleDeck is a collectible spatial puzzle experience. Build a Great White Shark and see what 6 metres really looks like. Build a Blue Whale and walk around it at true scale. The Ocean Series is free while in Beta. No ads, no chat, no pressure. Just building."}]}, "developer_name": null, "developer_privacy_policy_url": "https://greenforestxr.io/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Green Forest XR", "support_website_url": null, "website_url": "https://greenforestxr.io/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area
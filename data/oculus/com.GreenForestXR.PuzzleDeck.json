1-25/499307505_1293934399511319_6908541319493325468_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=t_huGe_bwoEQ7kNvwEHETAE&_nc_oc=AdrwWi5YnZdKcnLjjpHJoWWENLGGpaV5ba4xob5e5XAh9-laB6mnis7VG3h4l193HDI&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC5A_tcg-3YKy8TP3xB28GetFZ5kCQoZJDbuyL_aEwwog&oe=6A660FF5"}, {"file_name": "Screenshots_2.png", "id": "934774526133689", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/499303140_934774529467022_7945644030852261457_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2976J5cLtUsQ7kNvwGBcTAj&_nc_oc=AdoiW8eFq1MhRK_zWLp0-eHxxGagk_ZUhVXsegw4LpljlLHwM0mjytZFoWuIN7TC1ik&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBMiI0MNZdQt_tNMNz2KLpvQEs1jn-Z27Snc1K_r6vDtA&oe=6A661CC0"}, {"file_name": "Screenshots_4.png", "id": "2443467659492849", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499311597_2443467662826182_2710033976610390550_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=26i4aa0ilFAQ7kNvwHAmRtf&_nc_oc=AdovSMRB2OptwycqOCAigAIx-9pWP68DsszrH-DKWtQT2t6ELBwsDIrvztldeT3bNew&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBobSwsw53EbAjKYHzUJpqjRW6P_qEX5OtfS58VbzDhdQ&oe=6A6615C4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_Screenshot.png", "id": "1458578349083089", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499307311_1458578352416422_679664406557939941_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bHr5uFJ-8LIQ7kNvwFfyqfN&_nc_oc=AdqCUGLYN-zkxdygNu9Cz5YUVCLHcWglzM2RmSpf1UAxwugt1kXKigyQKW6bpqvVvR8&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBalpfIBpOW_V0LPbXTCTJArvkw5l3p0rHvrU_LcnHUEA&oe=6A65FCFB"}, "display_name": "Puzzle Deck", "keywords": [], "long_description": "PuzzleDeck is for people who love to build. Pick up a hand-crafted tin toy puzzle, piece it together with your hands in the space in front of you, and finish each one with a reveal that only spatial computing can deliver. A Great White Shark, life-sized, right there in the room with you.\n\nWhen the final piece clicks into place, the puzzle reveals itself at true scale. Build a Blue Whale and walk around it. Build a shark and meet it at the size it actually is. Each reveal is the payoff that makes every puzzle worth finishing.\nThe Ocean Series. Three iconic ocean animals styled as vintage tin toys: a Great White Shark, a Blue Whale, and an Orca. Build all three to complete the series.\n\nFree, and made for everyone. Suitable for players of all ages, including kids. No advertising, no chat, no data collection. Just the experience.\nBy Green Forest XR. An independent indie studio building spatial tools that bring the digital and physical together. New themed Puzzle Kits are planned post-launch.", "short_description": "Build hand-crafted tin toy puzzles, piece by piece. Then meet each one at full size in your living room. PuzzleDeck is a collectible spatial puzzle experience. Build a Great White Shark and see what 6 metres really looks like. Build a Blue Whale and walk around it at true scale. The Ocean Series is free while in Beta. No ads, no chat, no pressure. Just building."}]}, "developer_name": null, "developer_privacy_policy_url": "https://greenforestxr.io/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Green Forest XR", "support_website_url": null, "website_url": "https://greenforestxr.io/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STAND
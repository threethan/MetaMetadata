205252258799", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/499303672_1460205255592132_1860223276198429684_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TaeNaHW9YlMQ7kNvwExQn4R&_nc_oc=Ado25dkhj187NBMioY5T1euz-OJDOKnhaDw0LZdU0WDru60kx5cIrCnznCsRxjh9fNs&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT0IcJyqgYJZ7fnrDqNdWKMVuWlKPQZlfcQ9YKAI9T53w&oe=6AFC6563"}, {"file_name": "Screenshots_5.png", "id": "1293934396177986", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499307505_1293934399511319_6908541319493325468_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v0WCPVLR2kUQ7kNvwGRUUMa&_nc_oc=Adqxv7ENVCTsYgwZtj-TAD_4WjBe180mwlcgfEyNPvWbc2mPQA6zBZ0qt_R2pludDZc&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRlivGgyAg5OMq6HCiRR-BZuc89s62OvHkHQxz8lKdWGw&oe=6AFC9335"}, {"file_name": "Screenshots_2.png", "id": "934774526133689", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499303140_934774529467022_7945644030852261457_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZUF1bmxtaHgQ7kNvwEFLOBp&_nc_oc=Adr9oNQTBmUPDmKM19I2peXtYsSrOfOX_tw0XjaLstLNvoVeBoOYgieFftPYlIsJso0&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQbxwvwW6M_P6G38M2thTUPQ1H9EfS3iN2EM53HIU42dA&oe=6AFC67C0"}, {"file_name": "Screenshots_4.png", "id": "2443467659492849", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499311597_2443467662826182_2710033976610390550_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l6IdcEpGizMQ7kNvwHneHwv&_nc_oc=Adp0vuwG57I0yRrpXGGA-kGtVLJ3A4p4AsKaDVjtn-7tQNRIcNJ331Oe419ulTUkgCg&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRl_0hOydDgu7NkMeZbhDBUW698brZ9Jx3nIwz9UEGsyQ&oe=6AFC60C4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_Screenshot.png", "id": "1458578349083089", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499307311_1458578352416422_679664406557939941_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mx_1x4_76eoQ7kNvwGb3c4i&_nc_oc=AdpJzOD8uJ3HYiTboSL7GJaALCXE9MeY_5QD_vWx7VQWrJ_S81cFanCzayspTI4r6CI&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR_RHKfmIQwarqkSY6hQjGlpcCNUMfBUFH4X0OaI9UzHg&oe=6AFC803B"}, "display_name": "Puzzle Deck", "keywords": [], "long_description": "PuzzleDeck is for people who love to build. Pick up a hand-crafted tin toy puzzle, piece it together with your hands in the space in front of you, and finish each one with a reveal that only spatial computing can deliver. A Great White Shark, life-sized, right there in the room with you.\n\nWhen the final piece clicks into place, the puzzle reveals itself at true scale. Build a Blue Whale and walk around it. Build a shark and meet it at the size it actually is. Each reveal is the payoff that makes every puzzle worth finishing.\nThe Ocean Series. Three iconic ocean animals styled as vintage tin toys: a Great White Shark, a Blue Whale, and an Orca. Build all three to complete the series.\n\nFree, and made for everyone. Suitable for players of all ages, including kids. No advertising, no chat, no data collection. Just the experience.\nBy Green Forest XR. An independent indie studio building spatial tools that bring the digital and physical together. New themed Puzzle Kits are planned post-launch.", "short_description": "Build hand-crafted tin toy puzzles, piece by piece. Then meet each one at full size in your living room. PuzzleDeck is a collectible spatial puzzle experience. Build a Great White Shark and see what 6 metres really looks like. Build a Blue Whale and walk around it at true scale. The Ocean Series is free while in Beta. No ads, no chat, no pressure. Just building."}]}, "developer_name": null, "developer_privacy_policy_url": "https://greenforestxr.io/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Green Forest XR", "
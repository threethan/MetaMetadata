_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB_Oym8zkdjziWTNYhMb3_fzITXqOffwM9T4lqIOEKrpg&oe=6A564863"}, {"file_name": "Screenshots_5.png", "id": "1293934396177986", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/499307505_1293934399511319_6908541319493325468_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Zri7zbZhSbEQ7kNvwGGZBb2&_nc_oc=AdpSVgvXDuwgiOm2fogO5mRIGNvqXwVnPoZMH0zlE10zrf6Uo6h16dK5iqx154s3kIk&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBOxS5KjJAKvq_zxv9TWNhw5sp9hc1IFmYe_x_BPw1KJQ&oe=6A563DF5"}, {"file_name": "Screenshots_2.png", "id": "934774526133689", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/499303140_934774529467022_7945644030852261457_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b_2tx0OxyXEQ7kNvwGuVyk6&_nc_oc=AdqGjGt1C1mKKjyCVp1cTiUrPgBHEVYqIhWSYyYfpqO-aeRmjRabXm-kWZMyyBM6fLo&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDvW-5rq758oCmKbmHpA3DO5TMvPxqd_NjJ79k4n88gqw&oe=6A564AC0"}, {"file_name": "Screenshots_4.png", "id": "2443467659492849", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/499311597_2443467662826182_2710033976610390550_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cF4T-6lWlI4Q7kNvwHWWfbt&_nc_oc=AdrKuBlgEE0ExuP_gU1D_tjjAUuCSNhzEzopSRGD4UWhP0tPiKvuAaIIDbUl04wXjHw&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDszGi-mUBqXIk8xuOeSOd0C1C9zJGn7cdW-TPY3e49aw&oe=6A5643C4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_Screenshot.png", "id": "1458578349083089", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/499307311_1458578352416422_679664406557939941_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QMJ7umnUxK8Q7kNvwF9pE-A&_nc_oc=AdpZvvKs3XDJok1gf3Vkw73Hm3E_ZaBl5trggzF6gznTQ04gQqdQAuGztLe_I3Qmzyc&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBEYGaUWRhFAk3u9fpHiJTwnxp3sCcibKotqH8LTQYC7Q&oe=6A562AFB"}, "display_name": "Puzzle Deck", "keywords": [], "long_description": "PuzzleDeck is for people who love to build. Pick up a hand-crafted tin toy puzzle, piece it together with your hands in the space in front of you, and finish each one with a reveal that only spatial computing can deliver. A Great White Shark, life-sized, right there in the room with you.\n\nWhen the final piece clicks into place, the puzzle reveals itself at true scale. Build a Blue Whale and walk around it. Build a shark and meet it at the size it actually is. Each reveal is the payoff that makes every puzzle worth finishing.\nThe Ocean Series. Three iconic ocean animals styled as vintage tin toys: a Great White Shark, a Blue Whale, and an Orca. Build all three to complete the series.\n\nFree, and made for everyone. Suitable for players of all ages, including kids. No advertising, no chat, no data collection. Just the experience.\nBy Green Forest XR. An independent indie studio building spatial tools that bring the digital and physical together. New themed Puzzle Kits are planned post-launch.", "short_description": "Build hand-crafted tin toy puzzles, piece by piece. Then meet each one at full size in your living room. PuzzleDeck is a collectible spatial puzzle experience. Build a Great White Shark and see what 6 metres really looks like. Build a Blue Whale and walk around it at true scale. The Ocean Series is free while in Beta. No ads, no chat, no pressure. Just building."}]}, "developer_name": null, "developer_privacy_policy_url": "https://greenforestxr.io/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Green Forest XR", "support_website_url": null, "website_url": "https://greenforestxr.io/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area
205252258799", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/499303672_1460205255592132_1860223276198429684_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u1AJyPGyrb8Q7kNvwGHkPNh&_nc_oc=Ado3rPyxwwxLxyf3JerD_-xM5BimBcvw7pGuPg0mm6TmiWybzAh3SNg-a0dAhH7NITU&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTsMTCGW3_CZz6t8IYBeVFdYYK62acg_PuAoTZkRWW07w&oe=6B09CCA3"}, {"file_name": "Screenshots_5.png", "id": "1293934396177986", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499307505_1293934399511319_6908541319493325468_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TDIBgWFMceIQ7kNvwGugnqu&_nc_oc=AdrQD_wO8oS_1S6uLd4rir_br7Uoq6YjzeKyobaxMGezc957LBmEc7NHiKhHnEetmBA&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSCWLM-e8KiJqu-e8R_6Z4jb1GojgbPijACa8LNBAwQVw&oe=6B09C235"}, {"file_name": "Screenshots_2.png", "id": "934774526133689", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499303140_934774529467022_7945644030852261457_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_h0EJLePG2EQ7kNvwFnH02D&_nc_oc=Ado1vJm1gn8u5gVBkZueedqQ1cIdkMRtzFfPJmNArH2ydhH5RR5KGTyaDilgfHzK4Lg&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSdGVSH_dm4uzq_B3VEH7t2h_1tBoCxyLlDDmbXY6KPYA&oe=6B09CF00"}, {"file_name": "Screenshots_4.png", "id": "2443467659492849", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499311597_2443467662826182_2710033976610390550_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=82tJaVhN110Q7kNvwFWtuO_&_nc_oc=AdrbJ7fDEfDgv7r7jQym0S9vG6q6akKb1wMnqV7YgPEx7LATKPcPFoMm8U6su4UvUa8&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTqiWE0wFYLmlV_30Coi8T3b28uPoOVG-1319brwGQCAw&oe=6B09C804"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_Screenshot.png", "id": "1458578349083089", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499307311_1458578352416422_679664406557939941_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BuvL4UKQrOgQ7kNvwGS71iE&_nc_oc=AdoPM8gv9hSs32kje1QRRX_BaH98a2h9yZXH1qDpSsGuXym6UPeIjde-0NYdA0bYWJM&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRvgQ8YgXes7zaQDhGB4SUneG9V2F-bmIPSMXpgeu26kQ&oe=6B09AF3B"}, "display_name": "Puzzle Deck", "keywords": [], "long_description": "PuzzleDeck is for people who love to build. Pick up a hand-crafted tin toy puzzle, piece it together with your hands in the space in front of you, and finish each one with a reveal that only spatial computing can deliver. A Great White Shark, life-sized, right there in the room with you.\n\nWhen the final piece clicks into place, the puzzle reveals itself at true scale. Build a Blue Whale and walk around it. Build a shark and meet it at the size it actually is. Each reveal is the payoff that makes every puzzle worth finishing.\nThe Ocean Series. Three iconic ocean animals styled as vintage tin toys: a Great White Shark, a Blue Whale, and an Orca. Build all three to complete the series.\n\nFree, and made for everyone. Suitable for players of all ages, including kids. No advertising, no chat, no data collection. Just the experience.\nBy Green Forest XR. An independent indie studio building spatial tools that bring the digital and physical together. New themed Puzzle Kits are planned post-launch.", "short_description": "Build hand-crafted tin toy puzzles, piece by piece. Then meet each one at full size in your living room. PuzzleDeck is a collectible spatial puzzle experience. Build a Great White Shark and see what 6 metres really looks like. Build a Blue Whale and walk around it at true scale. The Ocean Series is free while in Beta. No ads, no chat, no pressure. Just building."}]}, "developer_name": null, "developer_privacy_policy_url": "https://greenforestxr.io/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Green Forest XR", "
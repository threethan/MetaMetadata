8429684_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tfmYWsaXHjkQ7kNvwEl5tBG&_nc_oc=AdpmzP4W17gRPp-iLWevP8TADJ_9WDaKb0r15y9Euqi1WNfvG_Ha8SIUwdnVqHbHp9M&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHAKnDybIl2QsO_VzXE1_eG0rmRuBwe7wyS0JyPvLAFjw&oe=6A7C4BA3"}, {"file_name": "Screenshots_5.png", "id": "1293934396177986", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499307505_1293934399511319_6908541319493325468_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RCa_o93k2xkQ7kNvwGVWbPV&_nc_oc=AdpFQpxFqCNTiiuyTB36QYmByHEchMVAX2us2iAgp7hTUbej9RemB2Gjm_8F3jZAlZE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE0aTRD2evdHT37AeQm45tyiAtSB3d1_HMfUrSn_AWIBA&oe=6A7C7975"}, {"file_name": "Screenshots_2.png", "id": "934774526133689", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499303140_934774529467022_7945644030852261457_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4Qyip592py0Q7kNvwEG5Kpb&_nc_oc=Adrf97Us7izhu6I9mxSS0ezjceGYVPQ5Y3na1F0NmBZeO5WUFEvESJ-rw6elMugLgmk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHS7dgcYJQPzRYP6sZiMZNojKw2oB_GQSC05TBWm6WaJg&oe=6A7C4E00"}, {"file_name": "Screenshots_4.png", "id": "2443467659492849", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499311597_2443467662826182_2710033976610390550_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GaozIlcPUWAQ7kNvwE-jslM&_nc_oc=AdqcKnW__oIkwaXTgVBecMo9Alks0v7cdU5H8_4fmQ6uqCQa0R9B3-GBCKr20VH1prk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGJL26I_zGwcqizzEg6ieMzQGIHZPIXlgxBgDwSwZBnCA&oe=6A7C4704"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_Screenshot.png", "id": "1458578349083089", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499307311_1458578352416422_679664406557939941_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rELPP4HSOy4Q7kNvwHh-pox&_nc_oc=AdoPusBLgMT4N36MRpw4gFUhE_oAHqmxm8BPafWkZ4CUhyM2TJ6dVvoJ1W9xbK0n7MM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEbtftl8bn9XyrLoO1WZdAnsFGQlOdE4Im71ZygLhezNQ&oe=6A7C667B"}, "display_name": "Puzzle Deck", "keywords": [], "long_description": "PuzzleDeck is for people who love to build. Pick up a hand-crafted tin toy puzzle, piece it together with your hands in the space in front of you, and finish each one with a reveal that only spatial computing can deliver. A Great White Shark, life-sized, right there in the room with you.\n\nWhen the final piece clicks into place, the puzzle reveals itself at true scale. Build a Blue Whale and walk around it. Build a shark and meet it at the size it actually is. Each reveal is the payoff that makes every puzzle worth finishing.\nThe Ocean Series. Three iconic ocean animals styled as vintage tin toys: a Great White Shark, a Blue Whale, and an Orca. Build all three to complete the series.\n\nFree, and made for everyone. Suitable for players of all ages, including kids. No advertising, no chat, no data collection. Just the experience.\nBy Green Forest XR. An independent indie studio building spatial tools that bring the digital and physical together. New themed Puzzle Kits are planned post-launch.", "short_description": "Build hand-crafted tin toy puzzles, piece by piece. Then meet each one at full size in your living room. PuzzleDeck is a collectible spatial puzzle experience. Build a Great White Shark and see what 6 metres really looks like. Build a Blue Whale and walk around it at true scale. The Ocean Series is free while in Beta. No ads, no chat, no pressure. Just building."}]}, "developer_name": null, "developer_privacy_policy_url": "https://greenforestxr.io/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Green Forest XR", "support_website_url": null, "website_url": "https://greenforestxr.io/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics
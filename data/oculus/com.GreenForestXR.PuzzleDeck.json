205252258799", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499303672_1460205255592132_1860223276198429684_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TbAepufpf1kQ7kNvwGOLWMT&_nc_oc=Adr6jESxY117dEWd0d6-NDXJc9rA6OU58JtywPo1CDnhC7vXQlqIzCxXdjPa4bFNlhY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSQjqhv5dGhOaJ85fwA7lu8Ph7NSmWPbp1mc92kUcTZCw&oe=6B0DC123"}, {"file_name": "Screenshots_5.png", "id": "1293934396177986", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499307505_1293934399511319_6908541319493325468_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KRhDxDxvkrYQ7kNvwGHWC9x&_nc_oc=AdpHq-0oiQ_1JpDjm9v9NFjCigEBw_iUzFGBEBtoq8moz4gfyifa9SxzN4b365vXQ04&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQS3X275V_TNssbhMt-uUo9pfKN9hwp3iQlxjHdYk3Grg&oe=6B0DB6B5"}, {"file_name": "Screenshots_2.png", "id": "934774526133689", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499303140_934774529467022_7945644030852261457_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0wMJSA9GJ_kQ7kNvwEjS304&_nc_oc=Ado4wovtAA576oj8sisdgXwI9qK4IoKKtPpw3Th9ynRXKX0CpdcC_qHn5no-rUUvYRg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTV3Awm0a78gpCdIK1fjNKVROPRowgJ8kqNn3AQwy9Dng&oe=6B0DC380"}, {"file_name": "Screenshots_4.png", "id": "2443467659492849", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499311597_2443467662826182_2710033976610390550_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gS3WHyhphGwQ7kNvwEL_bhs&_nc_oc=AdrrM7PAoa6NJcV2DaKxvsH302jsS4cO63NR0d2DJy9o-MFidlt1xebHP9J0kcoIKu4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTU77KpPoIywYY9vxanrM-qn1iOhw-5q5jp9f_zDwHvQw&oe=6B0DBC84"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_Screenshot.png", "id": "1458578349083089", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499307311_1458578352416422_679664406557939941_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ejnTVEhajp0Q7kNvwGFa2JX&_nc_oc=AdoZBRZzkKSF16ME1L7x3ctPC7DXSWBw2F_4ufBhxdga89XRACq48GFKS8-1EzAPuWM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQggwX-bJoGOL2xm5aVQxyeMMfPT2ihWmCQRQMgySynBw&oe=6B0DA3BB"}, "display_name": "Puzzle Deck", "keywords": [], "long_description": "PuzzleDeck is for people who love to build. Pick up a hand-crafted tin toy puzzle, piece it together with your hands in the space in front of you, and finish each one with a reveal that only spatial computing can deliver. A Great White Shark, life-sized, right there in the room with you.\n\nWhen the final piece clicks into place, the puzzle reveals itself at true scale. Build a Blue Whale and walk around it. Build a shark and meet it at the size it actually is. Each reveal is the payoff that makes every puzzle worth finishing.\nThe Ocean Series. Three iconic ocean animals styled as vintage tin toys: a Great White Shark, a Blue Whale, and an Orca. Build all three to complete the series.\n\nFree, and made for everyone. Suitable for players of all ages, including kids. No advertising, no chat, no data collection. Just the experience.\nBy Green Forest XR. An independent indie studio building spatial tools that bring the digital and physical together. New themed Puzzle Kits are planned post-launch.", "short_description": "Build hand-crafted tin toy puzzles, piece by piece. Then meet each one at full size in your living room. PuzzleDeck is a collectible spatial puzzle experience. Build a Great White Shark and see what 6 metres really looks like. Build a Blue Whale and walk around it at true scale. The Ocean Series is free while in Beta. No ads, no chat, no pressure. Just building."}]}, "developer_name": null, "developer_privacy_policy_url": "https://greenforestxr.io/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Green Forest XR", "
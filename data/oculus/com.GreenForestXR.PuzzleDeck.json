205252258799", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499303672_1460205255592132_1860223276198429684_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u1AJyPGyrb8Q7kNvwG1hUO1&_nc_oc=AdrqP2oQpclvWqa7YAzRk5ZRzhL_AQfo8iKoIAPzLzBRa1PtBcqBREhWB0QmnztfE4M&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRpCwDSjhYBf7apuDO3Cfxb2J6TB28mPT7a7r9OPspKVA&oe=6B0B1E23"}, {"file_name": "Screenshots_5.png", "id": "1293934396177986", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499307505_1293934399511319_6908541319493325468_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TDIBgWFMceIQ7kNvwFmyqUt&_nc_oc=Adqxar9GLXePsDou2oa1bWVm0pamu8mizqrQkGQiwY0hnm070xbecmRmwupX7vKOI8k&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSqeACkpT0JVs4FMkrrpwUqP-TsoHRodp_B8E4GzNqYJA&oe=6B0B13B5"}, {"file_name": "Screenshots_2.png", "id": "934774526133689", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499303140_934774529467022_7945644030852261457_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_h0EJLePG2EQ7kNvwFeSNL0&_nc_oc=AdqmmxLShc1vLgENtcVhBmrq7mAzOMNmvoL3Jw1VLaXKQl07mNNTG8neOJfy-GFRhuE&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQT_n32ZEl_sDC3THP65gspFUD3a87l6DfugVRmZlUEpdA&oe=6B0B2080"}, {"file_name": "Screenshots_4.png", "id": "2443467659492849", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499311597_2443467662826182_2710033976610390550_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gS3WHyhphGwQ7kNvwESpsS3&_nc_oc=AdoO0Vzaa515YM9-M3R-OG5NThFelh4wSpkBozsHsPcyFCLbNF7zUO5xrpOFqYoAh-c&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQNeL66-ExO-KbQRcGCFW-6lBo4MZ0w-SrB6os7QD5UPg&oe=6B0B1984"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_Screenshot.png", "id": "1458578349083089", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499307311_1458578352416422_679664406557939941_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BuvL4UKQrOgQ7kNvwFnOSQM&_nc_oc=AdpXLMoiP4LixnZ8hK3r8LE9x54eEylp9A8mGBC7sjLBMGFNAycGy_tw6ihOUGltrQQ&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSKRvM8KbE_1mRdqCSEPLCsszIGwW4CkZuoNVgsslJBOg&oe=6B0B38FB"}, "display_name": "Puzzle Deck", "keywords": [], "long_description": "PuzzleDeck is for people who love to build. Pick up a hand-crafted tin toy puzzle, piece it together with your hands in the space in front of you, and finish each one with a reveal that only spatial computing can deliver. A Great White Shark, life-sized, right there in the room with you.\n\nWhen the final piece clicks into place, the puzzle reveals itself at true scale. Build a Blue Whale and walk around it. Build a shark and meet it at the size it actually is. Each reveal is the payoff that makes every puzzle worth finishing.\nThe Ocean Series. Three iconic ocean animals styled as vintage tin toys: a Great White Shark, a Blue Whale, and an Orca. Build all three to complete the series.\n\nFree, and made for everyone. Suitable for players of all ages, including kids. No advertising, no chat, no data collection. Just the experience.\nBy Green Forest XR. An independent indie studio building spatial tools that bring the digital and physical together. New themed Puzzle Kits are planned post-launch.", "short_description": "Build hand-crafted tin toy puzzles, piece by piece. Then meet each one at full size in your living room. PuzzleDeck is a collectible spatial puzzle experience. Build a Great White Shark and see what 6 metres really looks like. Build a Blue Whale and walk around it at true scale. The Ocean Series is free while in Beta. No ads, no chat, no pressure. Just building."}]}, "developer_name": null, "developer_privacy_policy_url": "https://greenforestxr.io/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Green Forest XR", "
t=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u2AQzMtUbmQQ7kNvwGCKErb&_nc_oc=Adqa-cBY3VXFiQJUneCYSWjDHcPAmwh6ZO506tO_hkTUc9-dmAxVidIPmKDTCIEVsQE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAgEnQLZL7nJdJX9nnZ-AxQUbvRBWGhWB7wnSUsHkfNuA&oe=6A4BBEC0"}, {"file_name": "Screenshots_4.png", "id": "2443467659492849", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499311597_2443467662826182_2710033976610390550_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6PSOFzm2GlgQ7kNvwHgndiu&_nc_oc=AdowIvxSVeXx7hxTLQDssOtep47-pvGIX0kZUmOZL4VwmkhsM6uZdlLEqd6c-k56t_w&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD7O6z05Z0moHQQUUb_hW_aUdpIfrP-Tw-aWWmIPQu5Qw&oe=6A4BB7C4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_Screenshot.png", "id": "1458578349083089", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499307311_1458578352416422_679664406557939941_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y8JL9xMjAzwQ7kNvwEs6ize&_nc_oc=AdpHgHaf3drneQJ3KWQHdcqKUJKYIzZPgN3yJYlU-9W0czYgDn-3ATehrMb65xWv-PI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAGW1Es_MjkCBMdNoVl-H1U-PNIKHJ1XDvoei_tsuJPig&oe=6A4B9EFB"}, "display_name": "Puzzle Deck", "keywords": [], "long_description": "PuzzleDeck is for people who love to build. Pick up a hand-crafted tin toy puzzle, piece it together with your hands in the space in front of you, and finish each one with a reveal that only spatial computing can deliver. A Great White Shark, life-sized, right there in the room with you.\n\nWhen the final piece clicks into place, the puzzle reveals itself at true scale. Build a Blue Whale and walk around it. Build a shark and meet it at the size it actually is. Each reveal is the payoff that makes every puzzle worth finishing.\nThe Ocean Series. Three iconic ocean animals styled as vintage tin toys: a Great White Shark, a Blue Whale, and an Orca. Build all three to complete the series.\n\nFree, and made for everyone. Suitable for players of all ages, including kids. No advertising, no chat, no data collection. Just the experience.\nBy Green Forest XR. An independent indie studio building spatial tools that bring the digital and physical together. New themed Puzzle Kits are planned post-launch.", "short_description": "Build hand-crafted tin toy puzzles, piece by piece. Then meet each one at full size in your living room. PuzzleDeck is a collectible spatial puzzle experience. Build a Great White Shark and see what 6 metres really looks like. Build a Blue Whale and walk around it at true scale. The Ocean Series is free while in Beta. No ads, no chat, no pressure. Just building."}]}, "developer_name": null, "developer_privacy_policy_url": "https://greenforestxr.io/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Green Forest XR", "support_website_url": null, "website_url": "https://greenforestxr.io/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "27000539029540437"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499308103_1602973624331600_4482919571313751154_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7t6VvqBTfm4Q7kNvwGlEcDm&_nc_oc=AdpnicApHMq1HtqEXyRWqlAtSEPfpyQ-a4edLpFBIdDycbhl2kSpBiUFAwtB5aHPiZg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f2
": "809536231902388", "image_type": "APP_IMG_HERO", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499304938_809536235235721_4289016802026956729_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yNufhIPVVSEQ7kNvwHNjLOr&_nc_oc=AdoQ5ACdDSMosib7-q3SOKhLOkAM-uqFPlgWjZ3db2LeRqmhUDVL8bUHyF53dQmJ3sI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9GojXbNh0put2ig3CtJkIZoQ8v_NM3kP7kZBIN7WM30A&oe=6A427D64"}]}, "id": "818642754228285", "locale": "en_US", "screenshots": [{"file_name": "Screenshot_1.png", "id": "1617849999504098", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499308010_1617850002837431_262267568755372791_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o4rfljKVzGIQ7kNvwFBQIeB&_nc_oc=AdqqD3ZeJwtIW2OBDmNTlbrITt6LAKQFHzYQ8PzMndiP7oo5xDKFS8XRluWeDGL_RBc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af84__rzl0tdsto-oZT8FjHvNqrPcQq50KzdhqlaUEs5hQ&oe=6A428865"}, {"file_name": "Screenshots_3.png", "id": "1460205252258799", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499303672_1460205255592132_1860223276198429684_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VXCgVjomCwkQ7kNvwF0DXIk&_nc_oc=AdpXAz0xfzSYAzwy6OMUQ3kcIy9ouuAxLNYE_5w5h2XS-D7kkANiigTajPq2FSWUkr8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_fYhHbsvfCZmbnMjEVvCE8WvCIBoKFUY1zL7GghkaLQA&oe=6A4281E3"}, {"file_name": "Screenshots_5.png", "id": "1293934396177986", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499307505_1293934399511319_6908541319493325468_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k830kuwEr-gQ7kNvwEIDhse&_nc_oc=AdqkK9zXyvPebFL4GWsri3nvIE0J4JGLB7u2AYdgk1SBbRA8I_c-UA2XbYt087yD4oc&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_-qOEN0qKaakNwLp07ru-5w_5PRUAb1SiXva8F1LLtGQ&oe=6A427775"}, {"file_name": "Screenshots_2.png", "id": "934774526133689", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499303140_934774529467022_7945644030852261457_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pggn_HHbAn0Q7kNvwGvdRy6&_nc_oc=AdoTzpbMURAGGgEEwL9RNL-kHRbCuvlraLpckOhAv-5XXgAbO5oF-eipXbnT2KH93p0&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-n21EowQvVgn7dC3fXQtYYVcFa4GDxLZNPOQbgvGhxMg&oe=6A428440"}, {"file_name": "Screenshots_4.png", "id": "2443467659492849", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499311597_2443467662826182_2710033976610390550_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o1LZQbOrHIYQ7kNvwHhWI1j&_nc_oc=AdpMYYgfhqquQAmABzwRcLe4HRrMUz7pUULjCA3GHx4noGx3GPwSeugJVv1AChIYio4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_7eesN0vuq56xl5M_kSIEfF5P4iZLHkx0lN1xYwdlpvA&oe=6A427D44"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_Screenshot.png", "id": "1458578349083089", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499307311_1458578352416422_679664406557939941_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kZQLIyzLWsEQ7kNvwEvR5a5&_nc_oc=Adr39OH7gTNIlp43d80G96X0ZZHNk4Pk95sZ4771JBGeweA-3JLx13uE5f6H5sqZZmo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_5WKIX_MWgXTjbRK3lYr7t_HqHisn-57skCDaHR_ohKg&oe=6A42647B"}, "display_name": "Puzzle Deck", "keywords": [], "long_description": "PuzzleDeck is for people who love to build. Pick up a hand-crafted tin toy puzzle, piece it together with your hands in the space in front of you, and finish each one with a reveal that only spatial computing can deliver. A Great White Shark, life-sized, right there in the room with you.\n\nWhen the final piece clicks into place, the puzzle reveals itself at true scale. Build a Blue Whale and walk around it. Build a shark and meet it at the size it actually is. Each reveal is the payoff that makes every puzzle worth finishing.\nThe Ocean Series. Three iconic ocean animals styled as vintage tin toys: a Great White Shark, a Blue Whale, and an Orca. Build all three to complete the series.\n\nFree, and made for everyone. Suitable for players of all ages, including kids. No advertising, no chat, no data collection. Just the experience.\nBy Green Forest XR. An independent indie studio building spatial tools that bring the digital and physical together. New themed Puzzle Kits are planned post-launch.", "short_description": "Build hand-crafted tin toy puzzles, piece by piece. Then meet each one at full size in your living room. PuzzleDeck is a collectible spatial puzzle experience. Build a Great White Shark and see what 6 metres really looks like. Build a Blue Whale and walk around it at true scale. The Ocean Series is free while in Beta. No ads, no chat, no pressure. Just building."}]}, "developer_name": null, "developer_privacy_policy_url": "https://greenforestxr.io/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Green Forest XR", "support_website_url": null, "website_url": "https://greenforestxr.io/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "27000539029540437"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499308103_1602973624331600_4482919571313751154_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TD3wBQt0Rq0Q7kNvwFZme_9&_nc_oc=Adq_iCOiDgOFUphobBZbi0PIQCjCehTM2ULPkAOkblfVgTtdUYfXrVlrHoBVziQlEDE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f2
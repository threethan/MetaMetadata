29684_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eOLs6FC6noMQ7kNvwEG86rd&_nc_oc=Adrm23UZRI6EFdabXu-oJ8q_M8fSZW3pTLZw5gTQhF2B2Fu0eUFO_esXWpPLF379DfE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHNK21bs4d-zG8weaR0weVSGfc-I8MuHnmFtqCWJgu-ww&oe=6A7EEEA3"}, {"file_name": "Screenshots_5.png", "id": "1293934396177986", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499307505_1293934399511319_6908541319493325468_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PCmS-aqszk8Q7kNvwFrNJai&_nc_oc=AdqUtPR1TdIuqYQi8C5A1xUGLG8rfplqz-tvpKmMM1Ed_Et8hDBnBz7guZLRSpnFisk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGS2w3Bq40Pmp0T6UjNwEw6wUmO0BU-ncDhlwKsQv_I7Q&oe=6A7F1C75"}, {"file_name": "Screenshots_2.png", "id": "934774526133689", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499303140_934774529467022_7945644030852261457_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pG_nFAdtfjQQ7kNvwGn_VZC&_nc_oc=AdoCQtFOCNY05c17DOY09GRGdcZMuNHgRQDv7iQtNgG55XmD6f0u8znbNbCLgSPI2tM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGCDHXtjR6Tpe-8znGkEE3CkKVjaF-ku7horM9DD9ewyg&oe=6A7EF100"}, {"file_name": "Screenshots_4.png", "id": "2443467659492849", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499311597_2443467662826182_2710033976610390550_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GaozIlcPUWAQ7kNvwFi4AA9&_nc_oc=Adrt1WfWXk_F5OiQw6j9ExQ-MfuD7MbVkx1ZMfMtz9adxuoOLXc1m39g3ltm_eZCZaw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH1P0b10J-QKypL3Ye8qkQa5FwPOEljsnqtGMJtRwIq3w&oe=6A7F2244"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_Screenshot.png", "id": "1458578349083089", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499307311_1458578352416422_679664406557939941_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z4VJ1mWJNGgQ7kNvwG1hsdp&_nc_oc=AdpOeX1coZfETfQp2gPeSoBzSwAa6E25wDNUE_WiOiq1OOPqHIs2Kzj4m4qZo38Bbhs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE5w-z10kiXCnDT71_jrZIx_L6VQyG24LSsnGwlTU4nQg&oe=6A7F097B"}, "display_name": "Puzzle Deck", "keywords": [], "long_description": "PuzzleDeck is for people who love to build. Pick up a hand-crafted tin toy puzzle, piece it together with your hands in the space in front of you, and finish each one with a reveal that only spatial computing can deliver. A Great White Shark, life-sized, right there in the room with you.\n\nWhen the final piece clicks into place, the puzzle reveals itself at true scale. Build a Blue Whale and walk around it. Build a shark and meet it at the size it actually is. Each reveal is the payoff that makes every puzzle worth finishing.\nThe Ocean Series. Three iconic ocean animals styled as vintage tin toys: a Great White Shark, a Blue Whale, and an Orca. Build all three to complete the series.\n\nFree, and made for everyone. Suitable for players of all ages, including kids. No advertising, no chat, no data collection. Just the experience.\nBy Green Forest XR. An independent indie studio building spatial tools that bring the digital and physical together. New themed Puzzle Kits are planned post-launch.", "short_description": "Build hand-crafted tin toy puzzles, piece by piece. Then meet each one at full size in your living room. PuzzleDeck is a collectible spatial puzzle experience. Build a Great White Shark and see what 6 metres really looks like. Build a Blue Whale and walk around it at true scale. The Ocean Series is free while in Beta. No ads, no chat, no pressure. Just building."}]}, "developer_name": null, "developer_privacy_policy_url": "https://greenforestxr.io/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Green Forest XR", "support_website_url": null, "website_url": "https://greenforestxr.io/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics":
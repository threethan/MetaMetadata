205252258799", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499303672_1460205255592132_1860223276198429684_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wcrlFM8ZNioQ7kNvwHyMIVg&_nc_oc=AdqiScT3RbwinukmmAT-IwWDlGzFVXOEQ3cQdhPmnhVPLmUhnAi8sOw4c2PiLHEQqdM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTtxOKn33sSFl-TO5TtQE91caYXfJQ6oepRhlHre5PRUg&oe=6B0486A3"}, {"file_name": "Screenshots_5.png", "id": "1293934396177986", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499307505_1293934399511319_6908541319493325468_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L7LOAir3890Q7kNvwFnE3d7&_nc_oc=AdoYKU0aoQ8Oen6Onns4dz9k1lMZ4vjDuG81vq21iRGWOgLWIVcyz7EgPAsaMWD34LY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR-jRHimaQg8byORH8Ati2l8Ust3RSH-2sidhAuoCsGsA&oe=6B047C35"}, {"file_name": "Screenshots_2.png", "id": "934774526133689", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499303140_934774529467022_7945644030852261457_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vc0B57Pz7PQQ7kNvwEsxpg4&_nc_oc=Adpjdfyqwg8U6YWQ9qN56PS7f8OgUnkDKs5o4gizUp9fkSCZz2n1zsp5VFui6IaJZO0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ3oEakRouR30dYJJPKMozlUVxLt4XRnnletVtOh8n3bQ&oe=6B048900"}, {"file_name": "Screenshots_4.png", "id": "2443467659492849", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499311597_2443467662826182_2710033976610390550_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aN58TFCQ9c0Q7kNvwGnPX2J&_nc_oc=Ado-xtOPQd1-KevHgtK8lAKDK81elGAWG7EiXny7Pu4QS7GYL2Z2ICpOY7WB6i_YjOE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTauJ5VQZs1QKzM2n_yAa0IyhK9PiFw7hqVlIKepQkctw&oe=6B048204"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_Screenshot.png", "id": "1458578349083089", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499307311_1458578352416422_679664406557939941_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZHxuEJP6CzIQ7kNvwEM--jK&_nc_oc=AdrsHobFNk2oY5uofDFN6Ioa5SjrAmhH6dW84P5dcrfKKHd578JCpbHnvYGEhAhKW_I&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRJaUBO6sDYWqBib8klvK3KIKF1pgWM5omNuCpaaIx21w&oe=6B04693B"}, "display_name": "Puzzle Deck", "keywords": [], "long_description": "PuzzleDeck is for people who love to build. Pick up a hand-crafted tin toy puzzle, piece it together with your hands in the space in front of you, and finish each one with a reveal that only spatial computing can deliver. A Great White Shark, life-sized, right there in the room with you.\n\nWhen the final piece clicks into place, the puzzle reveals itself at true scale. Build a Blue Whale and walk around it. Build a shark and meet it at the size it actually is. Each reveal is the payoff that makes every puzzle worth finishing.\nThe Ocean Series. Three iconic ocean animals styled as vintage tin toys: a Great White Shark, a Blue Whale, and an Orca. Build all three to complete the series.\n\nFree, and made for everyone. Suitable for players of all ages, including kids. No advertising, no chat, no data collection. Just the experience.\nBy Green Forest XR. An independent indie studio building spatial tools that bring the digital and physical together. New themed Puzzle Kits are planned post-launch.", "short_description": "Build hand-crafted tin toy puzzles, piece by piece. Then meet each one at full size in your living room. PuzzleDeck is a collectible spatial puzzle experience. Build a Great White Shark and see what 6 metres really looks like. Build a Blue Whale and walk around it at true scale. The Ocean Series is free while in Beta. No ads, no chat, no pressure. Just building."}]}, "developer_name": null, "developer_privacy_policy_url": "https://greenforestxr.io/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Green Forest XR", "
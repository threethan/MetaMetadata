205252258799", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499303672_1460205255592132_1860223276198429684_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gcmOBjgQT2cQ7kNvwG0mD3D&_nc_oc=Adq4baOPYmPubz8soRrG-Q4XWeU5dK8qG7Mgxf0o4b1Vf5QPNSKnH-AJwD2yChIn_2c&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTMiTUy0G-eaZVGIr40DypLdTakrhLazWsOjyHsmGs02Q&oe=6B0059E3"}, {"file_name": "Screenshots_5.png", "id": "1293934396177986", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499307505_1293934399511319_6908541319493325468_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XMeQFYyRDowQ7kNvwG8knMb&_nc_oc=Adogl7ru04CVJVrSbeoKR5-RpniRI5I6SXRHMy1psFdbYPtKiD0wwIduvwAlUVnTOyk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSV3MUMB4mN5Anom44pT2AIPtP3yfxOzKzgpPm5LKYnDw&oe=6B0087B5"}, {"file_name": "Screenshots_2.png", "id": "934774526133689", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499303140_934774529467022_7945644030852261457_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6IZNgbW8ouYQ7kNvwHNr73y&_nc_oc=AdrOojRnEgw-l_mQAdGafJGqb2WH7UU46r7v3rNkxtMJPexN3r9PtD19OtCKPJZWz58&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS-7v0kijVA-QsOczRJadEhVD5tq-FlEQ0ih6-jcBopxA&oe=6B005C40"}, {"file_name": "Screenshots_4.png", "id": "2443467659492849", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499311597_2443467662826182_2710033976610390550_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vPygEcoSvxYQ7kNvwE_7bZI&_nc_oc=AdqlMpplciiHwAzNpKf_XQuFHdCFtNbcntH27tQtuE3UcPSoKR1ZjY7j9TvRBh7rIHg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQWLabij4bKOjDCkdN48ekklKB811-dswmDH7H9YvXKmg&oe=6B005544"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_Screenshot.png", "id": "1458578349083089", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499307311_1458578352416422_679664406557939941_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-SC5IYisvuwQ7kNvwGDqCLG&_nc_oc=Adqg_kjqttSOO486wc68R23UAcmudeN74bKm1vTwUIuGHOT_KQ1bsFjfjdCxNhcdDrE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTuJgL3AZ44e-K3WnCVJmCt3fG6vm5wtDn9ESXg0egnhQ&oe=6B0074BB"}, "display_name": "Puzzle Deck", "keywords": [], "long_description": "PuzzleDeck is for people who love to build. Pick up a hand-crafted tin toy puzzle, piece it together with your hands in the space in front of you, and finish each one with a reveal that only spatial computing can deliver. A Great White Shark, life-sized, right there in the room with you.\n\nWhen the final piece clicks into place, the puzzle reveals itself at true scale. Build a Blue Whale and walk around it. Build a shark and meet it at the size it actually is. Each reveal is the payoff that makes every puzzle worth finishing.\nThe Ocean Series. Three iconic ocean animals styled as vintage tin toys: a Great White Shark, a Blue Whale, and an Orca. Build all three to complete the series.\n\nFree, and made for everyone. Suitable for players of all ages, including kids. No advertising, no chat, no data collection. Just the experience.\nBy Green Forest XR. An independent indie studio building spatial tools that bring the digital and physical together. New themed Puzzle Kits are planned post-launch.", "short_description": "Build hand-crafted tin toy puzzles, piece by piece. Then meet each one at full size in your living room. PuzzleDeck is a collectible spatial puzzle experience. Build a Great White Shark and see what 6 metres really looks like. Build a Blue Whale and walk around it at true scale. The Ocean Series is free while in Beta. No ads, no chat, no pressure. Just building."}]}, "developer_name": null, "developer_privacy_policy_url": "https://greenforestxr.io/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Green Forest XR", "
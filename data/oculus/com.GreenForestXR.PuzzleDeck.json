_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5NOEX-ItZs2lfmuMGLDTTEsjn0C1sWhu6PTs0nmdoVgA&oe=6A203AE3"}, {"file_name": "Screenshots_5.png", "id": "1293934396177986", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499307505_1293934399511319_6908541319493325468_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8_uv5miwiqMQ7kNvwHGtIT0&_nc_oc=AdoQkm50kBOTuXeIqOSdILOjMxRabqd07POevkNMlzV-anzbjoGErNPHQUOiDu44sWs&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5HTQ-M83zeJeUBjAI-bKLnNpV9mYPTQXcizlR9gLZEwg&oe=6A203075"}, {"file_name": "Screenshots_2.png", "id": "934774526133689", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499303140_934774529467022_7945644030852261457_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Hj6H4KnD_eEQ7kNvwG0-Hyx&_nc_oc=AdqxYKg-uQ96fQsHzgdd-AZFm9FKB8Y5YXHDwM2moeRcq-Ml-e9yK_R-QUASYZrWbLE&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5RW46UVsBrYfYHb-u-K1v3chsunISw6A96UHi4MFC3Fg&oe=6A203D40"}, {"file_name": "Screenshots_4.png", "id": "2443467659492849", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499311597_2443467662826182_2710033976610390550_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sb8DcbSgZlUQ7kNvwGd7xKN&_nc_oc=AdrdLcD17A4384sDAZWtDGR_IQFHB34zoCWyCTYKRvnxoDHzi3vLD1_hZjkmpkCaPtI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5cYp-HLH4tYhIAjpPOIG2C_Lyr2rbJZ3mUH0G_kgXKmQ&oe=6A203644"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_Screenshot.png", "id": "1458578349083089", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499307311_1458578352416422_679664406557939941_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Dau5GnObQ-oQ7kNvwGwG9lA&_nc_oc=Adp_DOwOQwiafNbTlXU7f_vqAg5ftyk6P1iQ30-o8SyeXGI2JvpTaH1tIDnNnpnm4iQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4Gfyv4NlUxZWOKH1qB7BkAtmnugKSGtVI85Q1uqAhcFw&oe=6A201D7B"}, "display_name": "Puzzle Deck", "keywords": [], "long_description": "PuzzleDeck is for people who love to build. Pick up a hand-crafted tin toy puzzle, piece it together with your hands in the space in front of you, and finish each one with a reveal that only spatial computing can deliver. A Great White Shark, life-sized, right there in the room with you.\n\nWhen the final piece clicks into place, the puzzle reveals itself at true scale. Build a Blue Whale and walk around it. Build a shark and meet it at the size it actually is. Each reveal is the payoff that makes every puzzle worth finishing.\nThe Ocean Series. Three iconic ocean animals styled as vintage tin toys: a Great White Shark, a Blue Whale, and an Orca. Build all three to complete the series.\n\nFree, and made for everyone. Suitable for players of all ages, including kids. No advertising, no chat, no data collection. Just the experience.\nBy Green Forest XR. An independent indie studio building spatial tools that bring the digital and physical together. New themed Puzzle Kits are planned post-launch.", "short_description": "Build hand-crafted tin toy puzzles, piece by piece. Then meet each one at full size in your living room. PuzzleDeck is a collectible spatial puzzle experience. Build a Great White Shark and see what 6 metres really looks like. Build a Blue Whale and walk around it at true scale. The Ocean Series is free while in Beta. No ads, no chat, no pressure. Just building."}]}, "developer_name": null, "developer_privacy_policy_url": "https://greenforestxr.io/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Green Forest XR", "support_website_url": null, "website_url": "https://greenforestxr.io/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area
5_1708395287079553_6414152336838671300_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fwd7BkhbrlQQ7kNvwFVHhb2&_nc_oc=AdoAYxSAfhdrxnOcMcm9UD_cNKKECaIDityCkhY1P0fQNjYOurmOH1Xdm1H_ZK92N68&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIIYuR5lhWny811k9fZSXaqp2cRv5WO8mmxbhi5Z6ma3A&oe=6AA00E4A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "1-screenshot.png", "id": "1612770703805830", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/654944867_1612770707139163_5001528027016336546_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MVwpEtyg_SEQ7kNvwHYYFRZ&_nc_oc=Ado5qiG53Q3v4GdY3OiwZktEcwRT6WM-iOgd2e4Vwqhl8x_SohLsCLLIChIK3bIvI-Y&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJP6SEBqWjXGe7Ie3o3Z01xZlHMy5OE-v11R7DDnu94Cg&oe=6A9FF84D"}, "display_name": "Puzzle Deck", "keywords": [], "long_description": "PuzzleDeck is for people who love to build. Pick up a hand-crafted tin toy puzzle, piece it together with your hands in the space in front of you, and finish each one with a reveal that only spatial computing can deliver. A Great White Shark, life-sized, right there in the room with you.\n\nWhen the final piece clicks into place, the puzzle reveals itself at true scale. Build a Blue Whale and walk around it. Build a shark and meet it at the size it actually is. Each reveal is the payoff that makes every puzzle worth finishing.\nThe Ocean Series. Three iconic ocean animals styled as vintage tin toys: a Great White Shark, a Blue Whale, and an Orca. Build all three to complete the series.\n\nFree, and made for everyone. Suitable for players of all ages, including kids. No advertising, no chat, no data collection. Just the experience.\nBy Green Forest XR. An independent indie studio building spatial tools that bring the digital and physical together. New themed Puzzle Kits are planned post-launch.", "short_description": "Build hand-crafted tin toy puzzles, piece by piece. Then meet each one at full size in your living room. PuzzleDeck is a collectible spatial puzzle experience. Build a Great White Shark and see what 6 metres really looks like. Build a Blue Whale and walk around it at true scale. The Ocean Series is free while in Beta. No ads, no chat, no pressure. Just building."}]}, "developer_name": null, "developer_privacy_policy_url": "https://greenforestxr.io/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Green Forest XR", "support_website_url": null, "website_url": "https://greenforestxr.io/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "28163103996617262"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/499308103_1602973624331600_4482919571313751154_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6B1b_aGtJIEQ7kNvwFJoPp2&_nc_oc=AdrMyIZ4vabAH02hGyFz5kzA1h6EaHRu02T0rkvQS-dPqz8LgqkLjcDFN3Yw9qjrO6g&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLgatBE6vdNAfB3eUEIsTPNk1JkVdTasXSAY7ruIOLYzw&oe=6AA00A28"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Puzzle Deck", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Puzzle", "id": "377978390272490"}], "release_date": 1778079600, "lastRevision": {"nod
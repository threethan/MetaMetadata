29684_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eOLs6FC6noMQ7kNvwERRqvG&_nc_oc=Ado0TEJ5BLDSNnKdQUVP7d8TNTeSwRuqS-sl1IcCjysb9gDZDbCwifI67BSdUbaytXw&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGEN4Ak3JLKkPsi4le8jPZhFhOLdOhacxg1PCgFKGd8zw&oe=6A804023"}, {"file_name": "Screenshots_5.png", "id": "1293934396177986", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/499307505_1293934399511319_6908541319493325468_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PCmS-aqszk8Q7kNvwEr2ABD&_nc_oc=AdqXoRx8QiL3nZlS6SMPJb4L8ORwcysZU2KT0iHeZ2KorkzrdnUHSw7XhBTg5YmUYQM&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHEcNwUgB4X2cltc7N2MMm2cwLmNE3caMf-ElbJ0eJMYA&oe=6A806DF5"}, {"file_name": "Screenshots_2.png", "id": "934774526133689", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/499303140_934774529467022_7945644030852261457_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pG_nFAdtfjQQ7kNvwE5Xl8q&_nc_oc=AdqzmdC1f5EsijFuTbqK4ZW6CO6f06efDGJid7BxacTAN8k1eMbLxeu8w63_Ug_3iCM&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEZ3Ccvpe-6sebpcsgDwzYYIJ1k1YT-cvYBvkM9HLtHcA&oe=6A804280"}, {"file_name": "Screenshots_4.png", "id": "2443467659492849", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/499311597_2443467662826182_2710033976610390550_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=p92viVlD49oQ7kNvwF8UxJl&_nc_oc=AdqtQ8ON1jsF3uaJv1NLVxYdUHJ5AjbAR99PuG4jvgyfWUF8JPzKf6L1UYzPq9kJO94&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEq5Ux6YBpgPCo4vflueW9eMntbCWXMp7UhhEBiVgypHg&oe=6A8073C4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_Screenshot.png", "id": "1458578349083089", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/499307311_1458578352416422_679664406557939941_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z4VJ1mWJNGgQ7kNvwGxA0qD&_nc_oc=AdpFppJog0iPHbKJWWhTU-A22svzZExnDiIqcY8fHdDDjajbaejTwLsmfwykPDJ74is&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEbfaLSWU0qWGx-sKpfgPrkVPz1UR9FylWu_hsCKnjang&oe=6A805AFB"}, "display_name": "Puzzle Deck", "keywords": [], "long_description": "PuzzleDeck is for people who love to build. Pick up a hand-crafted tin toy puzzle, piece it together with your hands in the space in front of you, and finish each one with a reveal that only spatial computing can deliver. A Great White Shark, life-sized, right there in the room with you.\n\nWhen the final piece clicks into place, the puzzle reveals itself at true scale. Build a Blue Whale and walk around it. Build a shark and meet it at the size it actually is. Each reveal is the payoff that makes every puzzle worth finishing.\nThe Ocean Series. Three iconic ocean animals styled as vintage tin toys: a Great White Shark, a Blue Whale, and an Orca. Build all three to complete the series.\n\nFree, and made for everyone. Suitable for players of all ages, including kids. No advertising, no chat, no data collection. Just the experience.\nBy Green Forest XR. An independent indie studio building spatial tools that bring the digital and physical together. New themed Puzzle Kits are planned post-launch.", "short_description": "Build hand-crafted tin toy puzzles, piece by piece. Then meet each one at full size in your living room. PuzzleDeck is a collectible spatial puzzle experience. Build a Great White Shark and see what 6 metres really looks like. Build a Blue Whale and walk around it at true scale. The Ocean Series is free while in Beta. No ads, no chat, no pressure. Just building."}]}, "developer_name": null, "developer_privacy_policy_url": "https://greenforestxr.io/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Green Forest XR", "support_website_url": null, "website_url": "https://greenforestxr.io/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics":
205252258799", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499303672_1460205255592132_1860223276198429684_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gcmOBjgQT2cQ7kNvwExZqx_&_nc_oc=Adq1zNPFmFR59IAcH6B1J6LgdxaJvlx8OSDFU-VLEzMwSSihScDfS-OxIcW9N8bU-1Q&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRE-GLnUK7pNyxCgcz6i0MpJVD6Hd6PHpSKrQHlqCQoAA&oe=6B033523"}, {"file_name": "Screenshots_5.png", "id": "1293934396177986", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499307505_1293934399511319_6908541319493325468_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XMeQFYyRDowQ7kNvwEMPmrP&_nc_oc=AdqFr03NpR4T9RxOVxsmQUZ1sEfyX7174gZWYTE0U7LaCD6uquOKwdQ5XyHqlHdFLik&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSwSRtUX23irHcsozSFKWG2S26OsWpdDOsNzMGWloHgZA&oe=6B032AB5"}, {"file_name": "Screenshots_2.png", "id": "934774526133689", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499303140_934774529467022_7945644030852261457_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6IZNgbW8ouYQ7kNvwHJJkOw&_nc_oc=AdpH8InqQtFb3bp1MMO-nAwzqd4mOXuQHQkvXUqJrf5wFr3c37qCRDzTWX3J-mZkQqw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSRCm5sFE7dvtkIXWsoyWcbbhL7tNKwGMWR00cpzx46Zw&oe=6B033780"}, {"file_name": "Screenshots_4.png", "id": "2443467659492849", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499311597_2443467662826182_2710033976610390550_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aN58TFCQ9c0Q7kNvwFHsOQ-&_nc_oc=Adr1HmHW7DzVialjSXa2hvMxmHJGCHmaMuuDUMGcmWmYqvk0UMImoCORFMjZPpF3eNg&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRWtUvqaZY8u1tYxQXuCX68aFYTVvaveA-4Z0cB_QBI5g&oe=6B033084"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_Screenshot.png", "id": "1458578349083089", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499307311_1458578352416422_679664406557939941_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZHxuEJP6CzIQ7kNvwG7ZWXS&_nc_oc=AdrSRbcHDFkJ8Vb7S_-SaJGdlT_cwFqTvbAg4OtL_CyFONZ7MgNCdsuBcs38hqZd-hc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSKxtqsS774OPw3t_pl0I04DK2LkHZfdF3ktil1G4rVng&oe=6B0317BB"}, "display_name": "Puzzle Deck", "keywords": [], "long_description": "PuzzleDeck is for people who love to build. Pick up a hand-crafted tin toy puzzle, piece it together with your hands in the space in front of you, and finish each one with a reveal that only spatial computing can deliver. A Great White Shark, life-sized, right there in the room with you.\n\nWhen the final piece clicks into place, the puzzle reveals itself at true scale. Build a Blue Whale and walk around it. Build a shark and meet it at the size it actually is. Each reveal is the payoff that makes every puzzle worth finishing.\nThe Ocean Series. Three iconic ocean animals styled as vintage tin toys: a Great White Shark, a Blue Whale, and an Orca. Build all three to complete the series.\n\nFree, and made for everyone. Suitable for players of all ages, including kids. No advertising, no chat, no data collection. Just the experience.\nBy Green Forest XR. An independent indie studio building spatial tools that bring the digital and physical together. New themed Puzzle Kits are planned post-launch.", "short_description": "Build hand-crafted tin toy puzzles, piece by piece. Then meet each one at full size in your living room. PuzzleDeck is a collectible spatial puzzle experience. Build a Great White Shark and see what 6 metres really looks like. Build a Blue Whale and walk around it at true scale. The Ocean Series is free while in Beta. No ads, no chat, no pressure. Just building."}]}, "developer_name": null, "developer_privacy_policy_url": "https://greenforestxr.io/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Green Forest XR", "
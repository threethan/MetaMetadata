": "809536231902388", "image_type": "APP_IMG_HERO", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/499304938_809536235235721_4289016802026956729_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MhIVBEqGifsQ7kNvwG-b1o7&_nc_oc=AdojSdSMl0jP49fJve-_FmI-XQNovkq8NskdGGE-hEvF09Hx4n4aXt71PPFTP_Q21kU&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_gAhjj4PyRuS64O_m81dXZU8jUtMzBOPNsX9olH15Yog&oe=6A242AE4"}]}, "id": "818642754228285", "locale": "en_US", "screenshots": [{"file_name": "Screenshot_1.png", "id": "1617849999504098", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499308010_1617850002837431_262267568755372791_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1cs7w_HN8WIQ7kNvwFyAUM5&_nc_oc=Adoj8hPin-Cp-OPyQfsM_TTLoKNSo5ZsEKmsobxiKmrHcYRPWUI8MV2G6lceardDMlw&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_opAWp16424SQsqpQ25Nx9JbnJSkjKikkDenCzmnaH6Q&oe=6A2435E5"}, {"file_name": "Screenshots_3.png", "id": "1460205252258799", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/499303672_1460205255592132_1860223276198429684_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QGqQaGfY3hMQ7kNvwGn_XWj&_nc_oc=AdrFSzJmA-XbitUM5luZdd9ItDRk190TWKrOhaCNWmPZZSgXYhmsRO6vquXVhn6t_iI&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af970N5yufrjP1_u4l7QVMnkfeiKAwaI08LPoJxZ_OFhQQ&oe=6A242F63"}, {"file_name": "Screenshots_5.png", "id": "1293934396177986", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/499307505_1293934399511319_6908541319493325468_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3HviKVV7wpwQ7kNvwHW-7Ci&_nc_oc=AdpB9EjsUGKNvC78rR80XbDOIMgUUa__d9eltej4khM-k_t0BML9LT5v14nUZ1981dw&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8CYMhCi5GjvdlUOFea27RKyC27jSHCicyK_5hBItoK8w&oe=6A2424F5"}, {"file_name": "Screenshots_2.png", "id": "934774526133689", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499303140_934774529467022_7945644030852261457_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WVrI9ANNaKIQ7kNvwFtKeRR&_nc_oc=AdqOjfUAHIt2WqSCr3eixGDzV_qP3myrNIlDOivgOAW2YH8Zb7XGQ85bRxzcB8C_NYs&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-uCktRHCk9uq3TAAPu6P2gsX71-e072qWNdQ3N1m6lXQ&oe=6A2431C0"}, {"file_name": "Screenshots_4.png", "id": "2443467659492849", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499311597_2443467662826182_2710033976610390550_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m1SyGp-Bj1oQ7kNvwHjFdaE&_nc_oc=AdqF_G65TWCybHv_W9q6eiSFi1ic-9jZ4DuSk9_JFgeU0fVyaNNu4fLqoIisF4apqWo&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-lebxF8PRre86OmBIGIzZy0E8F7R9ceReo7kVnxHCZCQ&oe=6A242AC4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_Screenshot.png", "id": "1458578349083089", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499307311_1458578352416422_679664406557939941_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5ApUiv-FjzwQ7kNvwHMML_c&_nc_oc=AdpaAgrb3cK9-o3Cx0uRCBkzUVUFe5HVjypiQ4a9ISGbnCZKgktZIoQmYZzgvDLLbOU&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-swlLvtWYzmlTXvd_bCdi1TggEvuvKIAKAt0BrIme7ag&oe=6A244A3B"}, "display_name": "Puzzle Deck", "keywords": [], "long_description": "PuzzleDeck is for people who love to build. Pick up a hand-crafted tin toy puzzle, piece it together with your hands in the space in front of you, and finish each one with a reveal that only spatial computing can deliver. A Great White Shark, life-sized, right there in the room with you.\n\nWhen the final piece clicks into place, the puzzle reveals itself at true scale. Build a Blue Whale and walk around it. Build a shark and meet it at the size it actually is. Each reveal is the payoff that makes every puzzle worth finishing.\nThe Ocean Series. Three iconic ocean animals styled as vintage tin toys: a Great White Shark, a Blue Whale, and an Orca. Build all three to complete the series.\n\nFree, and made for everyone. Suitable for players of all ages, including kids. No advertising, no chat, no data collection. Just the experience.\nBy Green Forest XR. An independent indie studio building spatial tools that bring the digital and physical together. New themed Puzzle Kits are planned post-launch.", "short_description": "Build hand-crafted tin toy puzzles, piece by piece. Then meet each one at full size in your living room. PuzzleDeck is a collectible spatial puzzle experience. Build a Great White Shark and see what 6 metres really looks like. Build a Blue Whale and walk around it at true scale. The Ocean Series is free while in Beta. No ads, no chat, no pressure. Just building."}]}, "developer_name": null, "developer_privacy_policy_url": "https://greenforestxr.io/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Green Forest XR", "support_website_url": null, "website_url": "https://greenforestxr.io/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "27000539029540437"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/499308103_1602973624331600_4482919571313751154_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=p9bx3f0tdTYQ7kNvwEEkfgG&_nc_oc=Adou_eyOcr9Rjg_CTknLYArmMhUKVq6b6oqsvTP8D1tCfm7Lw7AOhDToo-6qsDmb_-A&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f2
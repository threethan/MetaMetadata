1-25/499307505_1293934399511319_6908541319493325468_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Zri7zbZhSbEQ7kNvwFjpMM1&_nc_oc=AdrpOr1QDQwlT5FqOW89l3wge5L_tXgz03h5vaws4Fx68e3XY44opd2WCEm7j-A1Q2Q&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDL0D1CKcVtr8M0PjjN-dEmelC9IMtrxDctIX2VQ-4ymw&oe=6A58E0F5"}, {"file_name": "Screenshots_2.png", "id": "934774526133689", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/499303140_934774529467022_7945644030852261457_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b_2tx0OxyXEQ7kNvwHYj9Ig&_nc_oc=AdoXqVYy8LCwLFjRGOfQwZnAqJmXGFRmEuRBZaAslQ9_cK-e7Zhc6FltVETSB8X1EWM&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAkQ0EYyOFuT2YK3qmAUPkH7aLfBgJcJ_Nt_PydasosDg&oe=6A58EDC0"}, {"file_name": "Screenshots_4.png", "id": "2443467659492849", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/499311597_2443467662826182_2710033976610390550_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZbHOiHjN3ogQ7kNvwFmqfH_&_nc_oc=AdojiBIxpoel_4yqJwWSjsYvcugXiGfxqyFnL8yaUkUFj2dVV5nt9rMdMe44S8vVm0w&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBy2l3rofJuw3MPCfsf6jaSmqM4etlcGS_buUKfcpPa5w&oe=6A58E6C4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_Screenshot.png", "id": "1458578349083089", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/499307311_1458578352416422_679664406557939941_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VAxkNkfu6XcQ7kNvwF1ETYu&_nc_oc=AdpvC-u29HX3fXOx5MFuh-p5sTvtYR1ukVgPk6X2p2yXEw4tMw1PROtDB0xDJUPnc0s&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCW0mSQjFr44P3tSYV6c-6YGYmh0S6bYvx3wGK_M9eZAw&oe=6A58CDFB"}, "display_name": "Puzzle Deck", "keywords": [], "long_description": "PuzzleDeck is for people who love to build. Pick up a hand-crafted tin toy puzzle, piece it together with your hands in the space in front of you, and finish each one with a reveal that only spatial computing can deliver. A Great White Shark, life-sized, right there in the room with you.\n\nWhen the final piece clicks into place, the puzzle reveals itself at true scale. Build a Blue Whale and walk around it. Build a shark and meet it at the size it actually is. Each reveal is the payoff that makes every puzzle worth finishing.\nThe Ocean Series. Three iconic ocean animals styled as vintage tin toys: a Great White Shark, a Blue Whale, and an Orca. Build all three to complete the series.\n\nFree, and made for everyone. Suitable for players of all ages, including kids. No advertising, no chat, no data collection. Just the experience.\nBy Green Forest XR. An independent indie studio building spatial tools that bring the digital and physical together. New themed Puzzle Kits are planned post-launch.", "short_description": "Build hand-crafted tin toy puzzles, piece by piece. Then meet each one at full size in your living room. PuzzleDeck is a collectible spatial puzzle experience. Build a Great White Shark and see what 6 metres really looks like. Build a Blue Whale and walk around it at true scale. The Ocean Series is free while in Beta. No ads, no chat, no pressure. Just building."}]}, "developer_name": null, "developer_privacy_policy_url": "https://greenforestxr.io/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Green Forest XR", "support_website_url": null, "website_url": "https://greenforestxr.io/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STAND
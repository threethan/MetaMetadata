5_1708395287079553_6414152336838671300_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wTF3RGUJoUgQ7kNvwHZOmtE&_nc_oc=Adqgj-vG_lv6l0g3ZxkMhCrKwLQanITz30WTs4N5VQo5ISMDB1SmAQg2iqZuQBAWdbE&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTnEiwN2EOr5k8sN1yX9pucz-IKfIP-yEpvBqom-ksPng&oe=6AF9B44A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "1-screenshot.png", "id": "1612770703805830", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/654944867_1612770707139163_5001528027016336546_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6yyZuxacxS4Q7kNvwFVNNYm&_nc_oc=Adq_ylXo40nyYg3kgQh84uEEU-5hcswgZ6yt3Z7mW8QHjIy7Rsa6eegP27davHsVhNg&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRO9NIdGma3m9LpdKtdz2t_qBeYIgHaPgHDKfbXXKtfiA&oe=6AF9D68D"}, "display_name": "Puzzle Deck", "keywords": [], "long_description": "PuzzleDeck is for people who love to build. Pick up a hand-crafted tin toy puzzle, piece it together with your hands in the space in front of you, and finish each one with a reveal that only spatial computing can deliver. A Great White Shark, life-sized, right there in the room with you.\n\nWhen the final piece clicks into place, the puzzle reveals itself at true scale. Build a Blue Whale and walk around it. Build a shark and meet it at the size it actually is. Each reveal is the payoff that makes every puzzle worth finishing.\nThe Ocean Series. Three iconic ocean animals styled as vintage tin toys: a Great White Shark, a Blue Whale, and an Orca. Build all three to complete the series.\n\nFree, and made for everyone. Suitable for players of all ages, including kids. No advertising, no chat, no data collection. Just the experience.\nBy Green Forest XR. An independent indie studio building spatial tools that bring the digital and physical together. New themed Puzzle Kits are planned post-launch.", "short_description": "Build hand-crafted tin toy puzzles, piece by piece. Then meet each one at full size in your living room. PuzzleDeck is a collectible spatial puzzle experience. Build a Great White Shark and see what 6 metres really looks like. Build a Blue Whale and walk around it at true scale. The Ocean Series is free while in Beta. No ads, no chat, no pressure. Just building."}]}, "developer_name": null, "developer_privacy_policy_url": "https://greenforestxr.io/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Green Forest XR", "support_website_url": null, "website_url": "https://greenforestxr.io/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "28163103996617262"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/499308103_1602973624331600_4482919571313751154_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G05B9AEvcRQQ7kNvwG1HzcB&_nc_oc=AdrQcXx_AZJNFrqCOw5qhoVzQAPzs2gC3rMkUdu5jrwups9KYRB--0eYqM8rUY0Ji2Y&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSaDfIkgcdOjTXXDrqu-rUHsu1izSfKvDA_yHSW8R67Mg&oe=6AF9E868"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Puzzle Deck", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Puzzle", "id": "377978390272490"}], "release_date": 1778079600, "lastRevision": {"nod
1-25/499307505_1293934399511319_6908541319493325468_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vMF4t0VzPAAQ7kNvwHvQaON&_nc_oc=Adq0opFSeJKvx131WrkLZ7XG0-oy9uJ3U4Y3f__EHSIfXT_xzDPgRFwroIalFzD5Xek&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH2wovPfwd6QS-GkxXId6Sk5Niok419g7oUq2KGcPfQ8Q&oe=6A733EF5"}, {"file_name": "Screenshots_2.png", "id": "934774526133689", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499303140_934774529467022_7945644030852261457_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rtF0W2b8ONwQ7kNvwHMM9C-&_nc_oc=Adq_VGvoRyEzVGVOGNLP3amYwtLIgHsvG5iLzLefip2Tc8mTRR6ETGE0_2MdWQVMd6s&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEaj4ZmQs7Lz6JbEmkm38Whllo8JINgqQo9qSfwgmsC7A&oe=6A734BC0"}, {"file_name": "Screenshots_4.png", "id": "2443467659492849", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499311597_2443467662826182_2710033976610390550_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NntOxHpp9lsQ7kNvwGIXziB&_nc_oc=AdqW2IxWBsJl8T_evHnrlYgc2_6_xIs4FxfCZHw2-bQ_UeDPYzvjJMab3isCLQLFtd0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGwN08yTO3bQ2Z_GRiaAiBGL_U9NEFuOeZnQVCK7t6exw&oe=6A7344C4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_Screenshot.png", "id": "1458578349083089", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499307311_1458578352416422_679664406557939941_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Jqe3F_jGL4gQ7kNvwEhEy-1&_nc_oc=AdqCUzNI8RFD5Bsb_UWHPwSamtBolFRGz5izEFs8UScNPC5pgnf6-Q00jBS4LGFaavE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGsLe5V3_9oXfkv4k8QGLQNkwOVV82KQboYOyPGwzAaPA&oe=6A732BFB"}, "display_name": "Puzzle Deck", "keywords": [], "long_description": "PuzzleDeck is for people who love to build. Pick up a hand-crafted tin toy puzzle, piece it together with your hands in the space in front of you, and finish each one with a reveal that only spatial computing can deliver. A Great White Shark, life-sized, right there in the room with you.\n\nWhen the final piece clicks into place, the puzzle reveals itself at true scale. Build a Blue Whale and walk around it. Build a shark and meet it at the size it actually is. Each reveal is the payoff that makes every puzzle worth finishing.\nThe Ocean Series. Three iconic ocean animals styled as vintage tin toys: a Great White Shark, a Blue Whale, and an Orca. Build all three to complete the series.\n\nFree, and made for everyone. Suitable for players of all ages, including kids. No advertising, no chat, no data collection. Just the experience.\nBy Green Forest XR. An independent indie studio building spatial tools that bring the digital and physical together. New themed Puzzle Kits are planned post-launch.", "short_description": "Build hand-crafted tin toy puzzles, piece by piece. Then meet each one at full size in your living room. PuzzleDeck is a collectible spatial puzzle experience. Build a Great White Shark and see what 6 metres really looks like. Build a Blue Whale and walk around it at true scale. The Ocean Series is free while in Beta. No ads, no chat, no pressure. Just building."}]}, "developer_name": null, "developer_privacy_policy_url": "https://greenforestxr.io/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Green Forest XR", "support_website_url": null, "website_url": "https://greenforestxr.io/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STAND
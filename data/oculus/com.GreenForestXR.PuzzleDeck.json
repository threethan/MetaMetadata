205252258799", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499303672_1460205255592132_1860223276198429684_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TbAepufpf1kQ7kNvwHWdkMJ&_nc_oc=Adp62ucUtWSoYf_Cpy4QWOeIjNqQjPW95So1qtx_aideTYG0DGNStv5CkL8iPpbA1CA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRgKPlcQi_yCiCkSpBIBWPFCgoyiJNdb0nuxcIMtEjjaA&oe=6B0C6FA3"}, {"file_name": "Screenshots_5.png", "id": "1293934396177986", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499307505_1293934399511319_6908541319493325468_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KRhDxDxvkrYQ7kNvwHlhDYC&_nc_oc=Adp5nWqUoQwz-Z8ZAmt4Kjr-vZssFj2wnu1ahDnON4ylYbznoIHkjBpM3xGpmQChvLc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRaTZF-A-IRorX1hapOJvgmilU9xoFox2mgXnbxt5yz4w&oe=6B0C6535"}, {"file_name": "Screenshots_2.png", "id": "934774526133689", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499303140_934774529467022_7945644030852261457_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0wMJSA9GJ_kQ7kNvwGAVv_k&_nc_oc=Adq_Kl66TRiEgNN_c-XInly7VecaWU4f26kdU7KJ-mcIaqbq9ImR6c2TMe1AWpr_gbA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQR9ezn97ESqK8eumnOHsR5_BeICe7tMo2SgxKYhQk2n2A&oe=6B0C7200"}, {"file_name": "Screenshots_4.png", "id": "2443467659492849", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499311597_2443467662826182_2710033976610390550_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gS3WHyhphGwQ7kNvwEax9kI&_nc_oc=AdpweVFipVnQUh_Z8Ly7_EUzaDdd8F2CXK3ILZPKmJQE1umqNEWwP7q0eUNrttiK3DQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQ6dDbUmssZWF73C02myB87ysZExTg0b0OdS0uzw2uaPw&oe=6B0C6B04"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_Screenshot.png", "id": "1458578349083089", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499307311_1458578352416422_679664406557939941_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BuvL4UKQrOgQ7kNvwHYbIIX&_nc_oc=Adp1rSr-nPjRRn3juqqt8JK6M2k451imLSZEIaz9upo5ZgYDftLYwT7ms8AOG1iqPY8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQqhbOF3ZfUC1bNcP0x3zg9mfvr8e6YL_S-fNMzh4xvZA&oe=6B0C523B"}, "display_name": "Puzzle Deck", "keywords": [], "long_description": "PuzzleDeck is for people who love to build. Pick up a hand-crafted tin toy puzzle, piece it together with your hands in the space in front of you, and finish each one with a reveal that only spatial computing can deliver. A Great White Shark, life-sized, right there in the room with you.\n\nWhen the final piece clicks into place, the puzzle reveals itself at true scale. Build a Blue Whale and walk around it. Build a shark and meet it at the size it actually is. Each reveal is the payoff that makes every puzzle worth finishing.\nThe Ocean Series. Three iconic ocean animals styled as vintage tin toys: a Great White Shark, a Blue Whale, and an Orca. Build all three to complete the series.\n\nFree, and made for everyone. Suitable for players of all ages, including kids. No advertising, no chat, no data collection. Just the experience.\nBy Green Forest XR. An independent indie studio building spatial tools that bring the digital and physical together. New themed Puzzle Kits are planned post-launch.", "short_description": "Build hand-crafted tin toy puzzles, piece by piece. Then meet each one at full size in your living room. PuzzleDeck is a collectible spatial puzzle experience. Build a Great White Shark and see what 6 metres really looks like. Build a Blue Whale and walk around it at true scale. The Ocean Series is free while in Beta. No ads, no chat, no pressure. Just building."}]}, "developer_name": null, "developer_privacy_policy_url": "https://greenforestxr.io/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Green Forest XR", "
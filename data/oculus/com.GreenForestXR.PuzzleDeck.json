_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-xlKrA8rjq2KWdM2Z3kYKV1dnQ5BkXWyZOQuyJ6UpogQ&oe=6A3D3BE3"}, {"file_name": "Screenshots_5.png", "id": "1293934396177986", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499307505_1293934399511319_6908541319493325468_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=odanBzgQzkkQ7kNvwFg5pzB&_nc_oc=Adr51k6X3DmYisO2xdbb5FpaWMLMDmLr1QrXE3ZCYubyo6UdnVmYogIvTyXQv-4n0WM&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-bs1_1EY1HQAtZ17W9XQeiSVYu03pv6JWF79qc_681EQ&oe=6A3D3175"}, {"file_name": "Screenshots_2.png", "id": "934774526133689", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499303140_934774529467022_7945644030852261457_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sqrrFvvkt60Q7kNvwGWxcFd&_nc_oc=AdqLUqTIK-lQTo3z6VuyoGMiKvcdgvAdyZmN_nLHucTMy42Q_s-SzoQUYtV5VLCzieE&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_GEY0JjaGcw9aNHMX1pV68yzCJF71t-WZnxLNHyHWZwg&oe=6A3D3E40"}, {"file_name": "Screenshots_4.png", "id": "2443467659492849", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499311597_2443467662826182_2710033976610390550_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G03l1P2l4AAQ7kNvwHpey3X&_nc_oc=AdqxnrxZfb15YjJbzOShdaNVsCHmnJ-lFrBAU_-By3VBh6AXsRnCPB072F88WoHKEiA&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-QePhBmLjrPFVvBSc0k_obX5LA7qlO-aJF_XwpWPWKTA&oe=6A3D3744"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_Screenshot.png", "id": "1458578349083089", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499307311_1458578352416422_679664406557939941_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v0Cq0wLDo0cQ7kNvwF6pz1A&_nc_oc=AdqIeEAua0i4Wxj3xXM7QT4A6aGJFw00jWiZs68gGc9hnPUqf-O_J7GZhR_XB9zxHjc&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9r3Bjyvr7G_JlLW4etnpghBcwUEXAdHfrv0uXS3lAYcg&oe=6A3D56BB"}, "display_name": "Puzzle Deck", "keywords": [], "long_description": "PuzzleDeck is for people who love to build. Pick up a hand-crafted tin toy puzzle, piece it together with your hands in the space in front of you, and finish each one with a reveal that only spatial computing can deliver. A Great White Shark, life-sized, right there in the room with you.\n\nWhen the final piece clicks into place, the puzzle reveals itself at true scale. Build a Blue Whale and walk around it. Build a shark and meet it at the size it actually is. Each reveal is the payoff that makes every puzzle worth finishing.\nThe Ocean Series. Three iconic ocean animals styled as vintage tin toys: a Great White Shark, a Blue Whale, and an Orca. Build all three to complete the series.\n\nFree, and made for everyone. Suitable for players of all ages, including kids. No advertising, no chat, no data collection. Just the experience.\nBy Green Forest XR. An independent indie studio building spatial tools that bring the digital and physical together. New themed Puzzle Kits are planned post-launch.", "short_description": "Build hand-crafted tin toy puzzles, piece by piece. Then meet each one at full size in your living room. PuzzleDeck is a collectible spatial puzzle experience. Build a Great White Shark and see what 6 metres really looks like. Build a Blue Whale and walk around it at true scale. The Ocean Series is free while in Beta. No ads, no chat, no pressure. Just building."}]}, "developer_name": null, "developer_privacy_policy_url": "https://greenforestxr.io/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Green Forest XR", "support_website_url": null, "website_url": "https://greenforestxr.io/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area
1-25/499307505_1293934399511319_6908541319493325468_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B8QbgDKe8BQQ7kNvwG3AAZa&_nc_oc=Adq7CXbmSqg1uMVcfqSVewKYXIEhX7hHbcyzmMxakNkz1kgWKQ8R9xtI48KDSU5q_Xo&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDCNICFG6GqrUhlBxHNttFE8NLZ2mLMas8PEIMh1AVP4Q&oe=6A621B75"}, {"file_name": "Screenshots_2.png", "id": "934774526133689", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499303140_934774529467022_7945644030852261457_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0PX8w4Qd-IcQ7kNvwElhmE0&_nc_oc=AdpW9CK3RHCdUJTimroSBJzVk6mGsNBZWd7HuzGkCteJ3dtyCBl0OBTwZBqWZIE1PnY&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAHWGEyxDkZUWK6UBdJG6P9yzspKe_c2Ld9uSRPwh-hLA&oe=6A622840"}, {"file_name": "Screenshots_4.png", "id": "2443467659492849", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499311597_2443467662826182_2710033976610390550_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qOZkz7-jjPwQ7kNvwG8gl3D&_nc_oc=Adr9i6lnbR-hMNdQv3db4ziusUkWk1-KGMXkrPikiEV5F9SLW8pUTsYeHWe6GqwvoKM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCEPojujLYFxPziiDs8hheeulsMqwNv0MKDLMRi2hpqGg&oe=6A622144"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_Screenshot.png", "id": "1458578349083089", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499307311_1458578352416422_679664406557939941_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7TsS54UbTN8Q7kNvwFD2F2U&_nc_oc=Adplu_MY3uw9kviaLubKt76eU_vlSaZ3YsMtabnhdl6IxsZsaN36g3NpC1OQqTlmzi8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC1Zlp4Jc5ge-Tu8rRIYWggrFAxUVadly1nfPh3jOsdDA&oe=6A62087B"}, "display_name": "Puzzle Deck", "keywords": [], "long_description": "PuzzleDeck is for people who love to build. Pick up a hand-crafted tin toy puzzle, piece it together with your hands in the space in front of you, and finish each one with a reveal that only spatial computing can deliver. A Great White Shark, life-sized, right there in the room with you.\n\nWhen the final piece clicks into place, the puzzle reveals itself at true scale. Build a Blue Whale and walk around it. Build a shark and meet it at the size it actually is. Each reveal is the payoff that makes every puzzle worth finishing.\nThe Ocean Series. Three iconic ocean animals styled as vintage tin toys: a Great White Shark, a Blue Whale, and an Orca. Build all three to complete the series.\n\nFree, and made for everyone. Suitable for players of all ages, including kids. No advertising, no chat, no data collection. Just the experience.\nBy Green Forest XR. An independent indie studio building spatial tools that bring the digital and physical together. New themed Puzzle Kits are planned post-launch.", "short_description": "Build hand-crafted tin toy puzzles, piece by piece. Then meet each one at full size in your living room. PuzzleDeck is a collectible spatial puzzle experience. Build a Great White Shark and see what 6 metres really looks like. Build a Blue Whale and walk around it at true scale. The Ocean Series is free while in Beta. No ads, no chat, no pressure. Just building."}]}, "developer_name": null, "developer_privacy_policy_url": "https://greenforestxr.io/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Green Forest XR", "support_website_url": null, "website_url": "https://greenforestxr.io/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STAND
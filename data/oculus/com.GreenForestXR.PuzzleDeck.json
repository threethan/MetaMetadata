205252258799", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499303672_1460205255592132_1860223276198429684_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0S4PglQL4isQ7kNvwHtzteq&_nc_oc=Adpj6jgdy4GdMFNrlP45Km4rK7CNwV80bvaPQNo-fukMCRrhuEAnBvyY8YSFcRT-e9I&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRy6piWkxr8dQAgL6BDVzKxlFmlgAddbajc3h73ylGhOw&oe=6AFB4C23"}, {"file_name": "Screenshots_5.png", "id": "1293934396177986", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499307505_1293934399511319_6908541319493325468_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZWdgI4jJJ4kQ7kNvwH-GPfl&_nc_oc=AdpKquX2nKGN3NP6l56mF7ZIoZZJTZAfWtY97Y7YO2xGQ_4MtoY6PT8fUFfVmd7mSw0&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRb3zUSv_fESxpAnMiw5qqEa5Up20kcl_w_vSp0q2bMEw&oe=6AFB41B5"}, {"file_name": "Screenshots_2.png", "id": "934774526133689", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/499303140_934774529467022_7945644030852261457_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n4w4PZqV7UgQ7kNvwGVgcRE&_nc_oc=AdolSK1_wUuPK6DM65-vVisp5X5k2Fk6VGmTCMmTwgIh0ggvRRJPd70Qhwfk96t-7yw&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR4Zd2tocwhurMUa0Gahnc4kySiSSzlgv9wo5GWiQvFJg&oe=6AFB1640"}, {"file_name": "Screenshots_4.png", "id": "2443467659492849", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499311597_2443467662826182_2710033976610390550_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l6IdcEpGizMQ7kNvwEPLZaO&_nc_oc=AdrEr8Jjt1H55q3eWogLdXju6rEkAkY6SXY3CehWoGDAmLHAujLy8N9iSHWPrmSAVT0&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQNFUQpCrhWMVlnAB7RengNHwgyO-pgd8bb9jECsgb19g&oe=6AFB4784"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_Screenshot.png", "id": "1458578349083089", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499307311_1458578352416422_679664406557939941_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mx_1x4_76eoQ7kNvwFOohzi&_nc_oc=AdoQ45ab4ccvJbruOYar0au318zY49QZm6cjknI4bikwLyHFc71-sOajKo1lXxVWkKI&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRCTOR9QiAzl0um2r-CvtUR7xSemCRaa5LxWSErQQLkjw&oe=6AFB2EBB"}, "display_name": "Puzzle Deck", "keywords": [], "long_description": "PuzzleDeck is for people who love to build. Pick up a hand-crafted tin toy puzzle, piece it together with your hands in the space in front of you, and finish each one with a reveal that only spatial computing can deliver. A Great White Shark, life-sized, right there in the room with you.\n\nWhen the final piece clicks into place, the puzzle reveals itself at true scale. Build a Blue Whale and walk around it. Build a shark and meet it at the size it actually is. Each reveal is the payoff that makes every puzzle worth finishing.\nThe Ocean Series. Three iconic ocean animals styled as vintage tin toys: a Great White Shark, a Blue Whale, and an Orca. Build all three to complete the series.\n\nFree, and made for everyone. Suitable for players of all ages, including kids. No advertising, no chat, no data collection. Just the experience.\nBy Green Forest XR. An independent indie studio building spatial tools that bring the digital and physical together. New themed Puzzle Kits are planned post-launch.", "short_description": "Build hand-crafted tin toy puzzles, piece by piece. Then meet each one at full size in your living room. PuzzleDeck is a collectible spatial puzzle experience. Build a Great White Shark and see what 6 metres really looks like. Build a Blue Whale and walk around it at true scale. The Ocean Series is free while in Beta. No ads, no chat, no pressure. Just building."}]}, "developer_name": null, "developer_privacy_policy_url": "https://greenforestxr.io/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Green Forest XR", "
205252258799", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499303672_1460205255592132_1860223276198429684_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TaeNaHW9YlMQ7kNvwGPv__p&_nc_oc=AdrX3DF4vdemPhUS8tVikHdPNsMXYwc0k3EmWWbkwsRO7ZEuAVUfj0pjDFdaQbOaC9U&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTB3YDBHxSe5qKHy_jcyjObzTQ9nA1egy_e9q1bbQR4qA&oe=6AFDB6E3"}, {"file_name": "Screenshots_5.png", "id": "1293934396177986", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499307505_1293934399511319_6908541319493325468_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v0WCPVLR2kUQ7kNvwFJJqGv&_nc_oc=AdpToXK2wT1G4wfTEG_4V8wzul3XgTH4cPJmOVFZ4hDZVLe210YgNg8wyy3w7rtfrqo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRcBT6K7t46hgUNbFMmK1BbZS8CviPqTeMEeNnUJr6gQg&oe=6AFDE4B5"}, {"file_name": "Screenshots_2.png", "id": "934774526133689", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499303140_934774529467022_7945644030852261457_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZUF1bmxtaHgQ7kNvwHkmyYJ&_nc_oc=AdqJmhscEH-Ox6p8s44uWAlJnIVZgZa2aPPyo0fSIRJXOYLR54zAwQckukz3GqrCqQE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ_FBwNIl56QgE-xFgTKKrpqOO90euvSNc41BPGocIZ0A&oe=6AFDB940"}, {"file_name": "Screenshots_4.png", "id": "2443467659492849", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499311597_2443467662826182_2710033976610390550_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l6IdcEpGizMQ7kNvwGsiELn&_nc_oc=AdoUEuqzNYikn_m8a0vOpqW9ygbRrKlDzIiPYhucGp5_VMaqCnJD69PmzZmwUS-LNXE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQkd6w3fchoKzO7aXjdRFeWW-kjW4-V0aL8Ij85XRTU9A&oe=6AFDB244"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_Screenshot.png", "id": "1458578349083089", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499307311_1458578352416422_679664406557939941_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-SC5IYisvuwQ7kNvwHxqXxE&_nc_oc=AdrLz5f7wAoAUo3Wnr2ECbNM42t0CS_Ob7JiEUyMXUO32enNvK57dpcoGhhGpGkiv5U&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSHZfuSHOrj0GMZTKakRxvoEPg7Wt6Ymwpt10NwiMeLpQ&oe=6AFDD1BB"}, "display_name": "Puzzle Deck", "keywords": [], "long_description": "PuzzleDeck is for people who love to build. Pick up a hand-crafted tin toy puzzle, piece it together with your hands in the space in front of you, and finish each one with a reveal that only spatial computing can deliver. A Great White Shark, life-sized, right there in the room with you.\n\nWhen the final piece clicks into place, the puzzle reveals itself at true scale. Build a Blue Whale and walk around it. Build a shark and meet it at the size it actually is. Each reveal is the payoff that makes every puzzle worth finishing.\nThe Ocean Series. Three iconic ocean animals styled as vintage tin toys: a Great White Shark, a Blue Whale, and an Orca. Build all three to complete the series.\n\nFree, and made for everyone. Suitable for players of all ages, including kids. No advertising, no chat, no data collection. Just the experience.\nBy Green Forest XR. An independent indie studio building spatial tools that bring the digital and physical together. New themed Puzzle Kits are planned post-launch.", "short_description": "Build hand-crafted tin toy puzzles, piece by piece. Then meet each one at full size in your living room. PuzzleDeck is a collectible spatial puzzle experience. Build a Great White Shark and see what 6 metres really looks like. Build a Blue Whale and walk around it at true scale. The Ocean Series is free while in Beta. No ads, no chat, no pressure. Just building."}]}, "developer_name": null, "developer_privacy_policy_url": "https://greenforestxr.io/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Green Forest XR", "
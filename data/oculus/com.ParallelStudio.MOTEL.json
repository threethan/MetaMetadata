OeUvnmfXT8c&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=8&oh=00_Afzu6jrIa33Q-lmzpRLfSPDadKPgmuTKnnU4rOTsD-sQsA&oe=69BA83D1"}, {"file_name": "migrated_image.png", "id": "544703409511940", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/12522199_131697227244106_814250366_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IQanN07YANkQ7kNvwG1gDM-&_nc_oc=AdnAv4OGQno-AiVPUZPIqelKA4mxWMCdaITBS4IIaJ7fimdGml8yultWpzWOaXqCluA&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=8&oh=00_Afwae29zK5i-23_wlQ8NlJ1jiTKRWMNYcg2w4EsuAhfgdA&oe=69BAB348"}, {"file_name": "migrated_image.png", "id": "264628114537266", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/12680260_240524789656314_1180019102_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yOYvi5t6fb8Q7kNvwFrz-YD&_nc_oc=Adl96p74LP_pCZ5iORht7g7k5tgDSJ4vU5shlvJ5WpjG553A60uX5VByODkKe-GOeac&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=8&oh=00_Afwur8MLCxbtA1lBjECuWRt7yvcJQsJube2-eKjCs8eWRA&oe=69BAA1B6"}, {"file_name": "migrated_image.png", "id": "160862711668837", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/12448853_1318777048151234_251025723_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=etdVA6y2Cw4Q7kNvwFX8r35&_nc_oc=AdmMk1kt_9nheqhK4qGtrV2YtG9-emfI2Wasrf8zwCE-QWpw8Q-XK4Awmk8BLLbyOtM&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=8&oh=00_Afy5sUL4uKATU9Mbzw9iRC67Am1fTDPN0UROTK1hPlHWkw&oe=69BA9DA4"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Dark Days", "keywords": ["Thriller", "Horror", "Adventure", "Escaperoom", "Storydriven"], "long_description": "/!\\ Note: 2GB of your device storage is needed to complete the install process (final size: 668 MB)\n\n\"Dark Days is probably the most visually complete game on the Gear VR\" -MobileVRDaily\n\n\"A Creepy and Surprising Psychological Thriller\" -UploadVR\n\nThe team that created White Night has gathered once again to offer you a hauntingly unique VR experience. Somewhere between Twin Peaks and The X-\u00adFiles, Dark Days is a new fantastic virtual reality adventure. You will have to discover what\u2019s going on with an eerie desert motel and its surroundings by solving a number of puzzles. Immerse yourself in the rich environments you will come across, but be careful and smart! Something is roaming around you... \n\n\u274f A supernatural adventure full of revelations \n\u274f Accessible gameplay and random puzzles \n\u274f Be prepared for jump scares! \n\nTechnical contact : contact@parallel-studio.com", "short_description": "\"Dark Days is probably the most visually complete game on the Gear VR\" -MobileVRDaily Somewhere between Twin Peaks and The X-\u00adFiles, Dark Days is a new fantastic virtual reality adventure. You will have to discover what\u2019s going on with an eerie desert motel and its surroundings by solving a number of puzzles. Immerse yourself in the rich environments you will come across, but be careful and smart! Something is roaming around you..."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.parallel-studio.com/", "developer_terms_of_service_url": "http://www.parallel-studio.com/", "publisher_name": "Oculus Studio", "support_website_url": null, "website_url": "http://www.parallel-studio.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ADVENTURE", "EXPLORATION", "HORROR", "NARRATIVE", "PUZZLE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "fr", "zh_CN", "ko", "de", "es_MX"], "supported_input_devices": ["TOUCHPAD", "GAMEPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "4789571044489703"}, "review_messages": []}]}, "cover_square_image": {"uri":
XRZ-GD9KSpIhYG_CT6DGKcvZvhfSuzaj-2uytAP_RqY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5J3qQAVtbQanG3Np6qeO1b9prwywqYmNPIb7-9q9JSxw&oe=6A0B2791"}, {"file_name": "migrated_image.png", "id": "544703409511940", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12522199_131697227244106_814250366_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qWH-BO484S0Q7kNvwHo45xA&_nc_oc=AdqekzkP5k43Sw5KsXwiZnWUV01PXO8lSat0yA8rpelRnghrWXrpwhnt6SAZ6bNiG4w&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6l4_U2w6nCn6BEEy09YpGKffhRaU5dydK-XB7qQZmlbA&oe=6A0B1EC8"}, {"file_name": "migrated_image.png", "id": "264628114537266", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12680260_240524789656314_1180019102_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XwqIc58eRIcQ7kNvwFAa7es&_nc_oc=AdqVbep-YTJ7D6wgnAUTTkZTbgwxsP52lkl1_iaf1urwIJz1ezMAxSNQcKDSMI6bog0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5BYPijeEPJgXWbO1NXEOftd9Vq9WJA4b_1iM8DdwG3sA&oe=6A0B0D36"}, {"file_name": "migrated_image.png", "id": "160862711668837", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12448853_1318777048151234_251025723_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dVRuGJGTAL0Q7kNvwEha9qJ&_nc_oc=AdrLRIR5KKdp-TWxmNbnnpZtxdmk87KB9zPCpniq80s4VLQ5UkQYJTrjeHXV7hgAe1I&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7e4nm1DzYkyTj22qvALj8zXDOJcabo_9d3W8LXIZC_6Q&oe=6A0B0924"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Dark Days", "keywords": ["Thriller", "Horror", "Adventure", "Escaperoom", "Storydriven"], "long_description": "/!\\ Note: 2GB of your device storage is needed to complete the install process (final size: 668 MB)\n\n\"Dark Days is probably the most visually complete game on the Gear VR\" -MobileVRDaily\n\n\"A Creepy and Surprising Psychological Thriller\" -UploadVR\n\nThe team that created White Night has gathered once again to offer you a hauntingly unique VR experience. Somewhere between Twin Peaks and The X-\u00adFiles, Dark Days is a new fantastic virtual reality adventure. You will have to discover what\u2019s going on with an eerie desert motel and its surroundings by solving a number of puzzles. Immerse yourself in the rich environments you will come across, but be careful and smart! Something is roaming around you... \n\n\u274f A supernatural adventure full of revelations \n\u274f Accessible gameplay and random puzzles \n\u274f Be prepared for jump scares! \n\nTechnical contact : contact@parallel-studio.com", "short_description": "\"Dark Days is probably the most visually complete game on the Gear VR\" -MobileVRDaily Somewhere between Twin Peaks and The X-\u00adFiles, Dark Days is a new fantastic virtual reality adventure. You will have to discover what\u2019s going on with an eerie desert motel and its surroundings by solving a number of puzzles. Immerse yourself in the rich environments you will come across, but be careful and smart! Something is roaming around you..."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.parallel-studio.com/", "developer_terms_of_service_url": "http://www.parallel-studio.com/", "publisher_name": "Oculus Studio", "support_website_url": null, "website_url": "http://www.parallel-studio.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ADVENTURE", "EXPLORATION", "HORROR", "NARRATIVE", "PUZZLE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "fr", "zh_CN", "ko", "de", "es_MX"], "supported_input_devices": ["TOUCHPAD", "GAMEPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "4789571044489703"}, "review
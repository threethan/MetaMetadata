8xxHLO3N-lwFvW8buenH-QS5VCEXPVm_jt4Ms8wj1yY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBvX1fEgLFFJD4EUgEt6F8bwh5VmbsAGM8f9mINcNJPZQ&oe=6A579E91"}, {"file_name": "migrated_image.png", "id": "544703409511940", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/12522199_131697227244106_814250366_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m8IU40KepUEQ7kNvwHB1qP1&_nc_oc=Adpq10Vzoz4r81H2SVvk7tPWBSNvAH1WprfL68kt1f1-TzFFxCF-i0ZDuCwJ0GcedIc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCTAjmfPL4OKGBSmjuaei3rUIukfpmYnKIrXoTJ2WXvWg&oe=6A5795C8"}, {"file_name": "migrated_image.png", "id": "264628114537266", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/12680260_240524789656314_1180019102_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hueGgglvKnoQ7kNvwFWPboe&_nc_oc=AdqiyVPW--RivfvtfwDL9ewDz0vzJB5b-Fz0KNQBsRkksDsSz7zL33dhHyah6m27_B4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDrmAU3XurYgIXpAGdhd9zyH05J-8fVK9XtZBfGbS7TLQ&oe=6A578436"}, {"file_name": "migrated_image.png", "id": "160862711668837", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12448853_1318777048151234_251025723_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=naneWx0oIsMQ7kNvwHeG_Xr&_nc_oc=Ado5Sgo9A78z6Jyxzy69Yyl0WWhmKNrNMPhFzc9PAVr6gRrTRudHYPqdpFsQKHesnGs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBoi11GSfs36IgnPbG78CkwSvRy3MC8Vxm_19WjijiNmg&oe=6A578024"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Dark Days", "keywords": ["Thriller", "Horror", "Adventure", "Escaperoom", "Storydriven"], "long_description": "/!\\ Note: 2GB of your device storage is needed to complete the install process (final size: 668 MB)\n\n\"Dark Days is probably the most visually complete game on the Gear VR\" -MobileVRDaily\n\n\"A Creepy and Surprising Psychological Thriller\" -UploadVR\n\nThe team that created White Night has gathered once again to offer you a hauntingly unique VR experience. Somewhere between Twin Peaks and The X-\u00adFiles, Dark Days is a new fantastic virtual reality adventure. You will have to discover what\u2019s going on with an eerie desert motel and its surroundings by solving a number of puzzles. Immerse yourself in the rich environments you will come across, but be careful and smart! Something is roaming around you... \n\n\u274f A supernatural adventure full of revelations \n\u274f Accessible gameplay and random puzzles \n\u274f Be prepared for jump scares! \n\nTechnical contact : contact@parallel-studio.com", "short_description": "\"Dark Days is probably the most visually complete game on the Gear VR\" -MobileVRDaily Somewhere between Twin Peaks and The X-\u00adFiles, Dark Days is a new fantastic virtual reality adventure. You will have to discover what\u2019s going on with an eerie desert motel and its surroundings by solving a number of puzzles. Immerse yourself in the rich environments you will come across, but be careful and smart! Something is roaming around you..."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.parallel-studio.com/", "developer_terms_of_service_url": "http://www.parallel-studio.com/", "publisher_name": "Oculus Studio", "support_website_url": null, "website_url": "http://www.parallel-studio.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ADVENTURE", "EXPLORATION", "HORROR", "NARRATIVE", "PUZZLE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "fr", "zh_CN", "ko", "de", "es_MX"], "supported_input_devices": ["TOUCHPAD", "GAMEPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "4789571044489703"}, "review
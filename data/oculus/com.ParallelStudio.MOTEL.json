380623", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/12448899_1155455737837776_10203191_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nL5dF-5ga10Q7kNvwE5xcQs&_nc_oc=AdoYkZRgZEF5VPAZUPcTMjPlGZ1WJFsUYxjXBxhRI6gTfOYdGC1V6__IPNITxpfiFgM&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQShypzZ9_hm7VESGBA0LzAX6qmt-I1ugpdr7zS1DYC65w&oe=6AFB1891"}, {"file_name": "migrated_image.png", "id": "544703409511940", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/12522199_131697227244106_814250366_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WhAo32AuhXIQ7kNvwHlvNoZ&_nc_oc=Ado-xmOFixZTnRKSW6k6CtI_EeWOujdNPXxdf8G8LQbxWxMFHWE6cewS6XeeA63eBYc&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQUWmZSIQLxwJr5k5mmRDRCGg21EthIaM-J8JMBjiQsRQ&oe=6AFB4808"}, {"file_name": "migrated_image.png", "id": "264628114537266", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/12680260_240524789656314_1180019102_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ScwC_GcE7k8Q7kNvwENjbqD&_nc_oc=AdrbB3pu7FKGSLXzefi5-smgTvc_wanSGXjl1ZZREuSPxbyqFKOIBOF1N21ycYI5LAo&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTCP8oR9XmG9OW80gkIhQFdFO5gEHJoRoBApKXP8p9Vkw&oe=6AFB3676"}, {"file_name": "migrated_image.png", "id": "160862711668837", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/12448853_1318777048151234_251025723_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xVC2ZAt7HmQQ7kNvwGZn_YK&_nc_oc=AdpK9kw5boyBA9t3bMafMyJ1qW7hwMmUJzMO9cPwJXsZMdQCm6Dm1ZjdOpTxBKejLmk&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTjNvXqsRnFBe7z-tCRZdjYwXft8J3wEEHc9fwRkkXImQ&oe=6AFB3264"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Dark Days", "keywords": ["Thriller", "Horror", "Adventure", "Escaperoom", "Storydriven"], "long_description": "/!\\ Note: 2GB of your device storage is needed to complete the install process (final size: 668 MB)\n\n\"Dark Days is probably the most visually complete game on the Gear VR\" -MobileVRDaily\n\n\"A Creepy and Surprising Psychological Thriller\" -UploadVR\n\nThe team that created White Night has gathered once again to offer you a hauntingly unique VR experience. Somewhere between Twin Peaks and The X-\u00adFiles, Dark Days is a new fantastic virtual reality adventure. You will have to discover what\u2019s going on with an eerie desert motel and its surroundings by solving a number of puzzles. Immerse yourself in the rich environments you will come across, but be careful and smart! Something is roaming around you... \n\n\u274f A supernatural adventure full of revelations \n\u274f Accessible gameplay and random puzzles \n\u274f Be prepared for jump scares! \n\nTechnical contact : contact@parallel-studio.com", "short_description": "\"Dark Days is probably the most visually complete game on the Gear VR\" -MobileVRDaily Somewhere between Twin Peaks and The X-\u00adFiles, Dark Days is a new fantastic virtual reality adventure. You will have to discover what\u2019s going on with an eerie desert motel and its surroundings by solving a number of puzzles. Immerse yourself in the rich environments you will come across, but be careful and smart! Something is roaming around you..."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.parallel-studio.com/", "developer_terms_of_service_url": "http://www.parallel-studio.com/", "publisher_name": "Oculus Studio", "support_website_url": null, "website_url": "http://www.parallel-studio.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ADVENTURE", "EXPLORATION", "HORROR", "NARRATIVE", "PUZZLE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_me
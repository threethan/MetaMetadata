ZiAXL_NosHDmGrcYPD2mfEmSc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN2CptFbSBcWfs7wEcJ13R-tDh_mVPlDz9afnbJqc9wyw&oe=6ACA76B5"}, {"file_name": "05.png", "id": "576278887576989", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974676_576278890910322_8375992525443890862_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9yP9dHVYNLUQ7kNvwH82pvg&_nc_oc=AdrxoQ1ESxwzUXOaHMCJ7s-upP5mhwxa38xlscNIi6Tt2hSa7FUIcFftvYVWVKYnpew&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPdVApXlXcrkJgo-I40b4-nLD4AryruHxBWWdTSzdVBHA&oe=6ACA4693"}, {"file_name": "02 - ep_02.png", "id": "2169411846580059", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974733_2169411849913392_6884717731277004138_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8ehi1IW-KFAQ7kNvwGnriKE&_nc_oc=Adqs6L0ei-gfq9vpjXyHpln_99hB-AcvoXAtbBVN94NSgPB2M5ppgjUrvQoVsU4Quy8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM6ROnhbcbzdAowv3-SNBbwdbCqdTogDlmvpbMPrcYxHA&oe=6ACA4F7E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Image.png", "id": "3449120438745077", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031368_3449120445411743_8172886076690248831_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3VIAH8xj35sQ7kNvwFNof-I&_nc_oc=AdpQ6Q-vWfI41L1e1P_EKxL70C_UGg2sC7iAF2A1WuKgWv8xwp-kpnEE08AQKaPJaiA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMslhX9x_BEGNwjqqKHf1ymvZ35kEN4LeAMAFKZ7o3iAg&oe=6ACA5E86"}, "display_name": "David Slade Mysteries: Case Files", "keywords": [], "long_description": "Take to the dark and violent streets of downtown Riverside, where you investigate gruesome and violent homicides using a range of Forensic tools and your wits! Inspired by the classic Police Quest adventure series, reborn & reimagined for VR. \n\nIncludes two epic episodes!\n\nEpisode One - Apartment 202: Fresh out of the academy, you're thrown face-first into the dark and violent underbelly of Riverside. Investigate your first homicide, outwit a killer and solve a string of murders decades old.\n\nEpisode Two - Memories Of The Past: 5 Years after the events of the Apartment 202 case, you come face to face with horrors, unlike anything you have ever witnessed. In a game of cat and mouse, you must outwit the killers hot on your trail.\n\nDefinitive Edition Features:\n - Use forensic tools to examine, collect & process evidence, to build your case.\n- Localization (English Audio & Subtitles + Spanish, French, Portuguese, Chinese, Russian)\n - Full spoken dialogue (English + Subtitles)\n - Full cinematic soundtrack by renowned composer Michael Gordon Shapiro.\n- Remastered visuals and core code, from the ground up!\n- Remastered HD Cinematic Cutscenes.\n- and much more.\n\nFOR SUPPORT & TIPS:\n\n**This game is designed to be challenging and does not hold your hand, So if you need: support, tips & tricks, please hop over to my discord: https://discord.gg/aNWAu4p8kE Where we can help.", "short_description": "David Slade Mysteries: Case Files - Definitive Edition is an episodic VR adventure series inspired by the classic Police Quest adventure games, reimagined for VR. Set in the gritty dark streets of River Side, where David must solve gruesome and mysterious homicides. Using forensic tools and his wits to examine, document, and gather evidence. Are you up to the task?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.gearworxprod.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Gear Worx Productions", "support_website_url": "https://www.gearworxprod.com/support", "website_url": "http://www.gearworxprod.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE", "EXPLORATION", "HORROR"], "has_in_a
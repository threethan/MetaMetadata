p4JtuNJJpRnKnqSUNJpQHcf5s_MCmsajvNWfeJgNAg&oe=6A4CFA0E"}, {"file_name": "MS4.png", "id": "909227208452573", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499298387_909227211785906_465658878683935205_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L3v2T1gYqMEQ7kNvwF2QwfV&_nc_oc=Ado0Ogov0NfwKPlYbRQlm1ATzdWU3s2my7OL3jZhcUnyVo7LUifvpb5A7q8b-4YCLD4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCK4C645gPISQz1gjLKkvhrMPEvyhlADKQJMeWZvC9kVA&oe=6A4CF33A"}, {"file_name": "MS5.png", "id": "1820428488676422", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499294650_1820428492009755_4834379194881149957_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QqMdbQb0H7MQ7kNvwGOs3Tf&_nc_oc=AdrTKHzmB4YfVX9yueV-AC75Yusd3tTLcbSnxjaCTzvOBjoorNBL-iLoVG1yCe-Xk0M&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBs9fdpPfIRjGU1hpy5Au7xjW2f_u3CbNjUcOKts55flQ&oe=6A4D011F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "MinesweeperVRPanel_Landscape.png", "id": "1173317541492437", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499298900_1173317544825770_8429585309347445504_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_RioGkcfdx8Q7kNvwFqHOtN&_nc_oc=AdoF2RS8lVD1KLhE2VytZQ6Z4XVowfE8gpEOi1Kkd79cFlyK0F7QB_9uAB2dyB42eHs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBT-qCt_69FIhmYtNlMWShusrnw9DeC3K9TtKIcl_EHaQ&oe=6A4D1F6F"}, "display_name": "Minesweeper - VR Panel", "keywords": ["2D", "retro", "casual", "quick", "mine"], "long_description": "Minesweeper \u2013 VR Panel brings the classic puzzle game to Meta Quest in a multitasking-friendly VR panel.\n\n# **Play classic Minesweeper in a lightweight VR panel**\nThe game can stay open alongside other apps and experiences. Clear a few tiles while watching videos, chatting, or taking a break, all without leaving what you are already doing in Quest.\n\n# **The classic puzzle you know and love**\nMinesweeper \u2013 VR Panel features familiar rules and gameplay with multiple difficulty levels, from beginner to expert. Unlock different visual themes to customize the board and make each session feel a little different.\n\n# **Designed specifically as a VR Panel App**\nMinesweeper \u2013 VR Panel lets you enjoy a timeless logic puzzle without taking over your entire VR experience. Play at your own pace while keeping other content within easy reach.", "short_description": "Minesweeper \u2013 VR Panel brings the classic puzzle game to Meta Quest in a lightweight VR panel. Clear mines across multiple difficulty levels, unlock visual themes, and play while multitasking alongside other apps and experiences in Quest."}]}, "developer_name": null, "developer_privacy_policy_url": "https://petricoregames.com/privacy-policy/", "developer_terms_of_service_url": "https://petricoregames.com/tos/", "publisher_name": "Petricore", "support_website_url": "https://petricoregames.com/#contact", "website_url": "https://petricoregames.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26363507183256355"}}]}, "scheduled_offers": {"count": 4, "nodes": [{"status": "PUBLISHED", "id": "982804034728745"}, {"status": "PUBLISHED", "id": "1663009948024797"}, {"status": "PUBLISHED", "id": "25425817027095703"}, {"status": "PUBLISHED", "id": "2000565570503199"}]}, "baseline_offer": {"id": "2
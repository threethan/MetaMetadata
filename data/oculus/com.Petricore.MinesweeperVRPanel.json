ontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499298387_909227211785906_465658878683935205_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-5t6e_cAHREQ7kNvwEzonTY&_nc_oc=AdrZxFW7IPtY-0eYVVXSZSo5a3Pcj_sjFJman5ZKIHeXEar3omUtmfXusIrS9lbSdkc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL9E4TdE_KVOR9twiuLYLoO1vepUXVOrTpVknW4UFLeuw&oe=6AA547BA"}, {"file_name": "MS5.png", "id": "1820428488676422", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499294650_1820428492009755_4834379194881149957_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xneVz4s_yJIQ7kNvwG7tX8y&_nc_oc=AdresyPUT981j547S6uOZ8ZTBHhYYSm0xJ_CcmkdIoNvy5X1Xaqb3BUosbc-rm6ZpwE&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJU6rD_uMlnZELZPTcZwV-KpGazBWlzz8_SeorL97rV1A&oe=6AA5559F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "MinesweeperVRPanel_Landscape.png", "id": "1173317541492437", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499298900_1173317544825770_8429585309347445504_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bYX55ej-6kAQ7kNvwF_MvSd&_nc_oc=AdpsVgU0cOzu83KKDsa6K3Plc6DBOiGHqBxAqVwc1QXtq_MZvK3Tu9_paaicA3WZM-k&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIi10bV3T9TiPsClLXt6R4_toQbYHVa36haNMk5kfX91g&oe=6AA573EF"}, "display_name": "Minesweeper - VR Panel", "keywords": ["2D", "retro", "casual", "quick", "mine"], "long_description": "Minesweeper \u2013 VR Panel brings the classic puzzle game to Meta Quest in a multitasking-friendly VR panel.\n\n# **Play classic Minesweeper in a lightweight VR panel**\nThe game can stay open alongside other apps and experiences. Clear a few tiles while watching videos, chatting, or taking a break, all without leaving what you are already doing in Quest.\n\n# **The classic puzzle you know and love**\nMinesweeper \u2013 VR Panel features familiar rules and gameplay with multiple difficulty levels, from beginner to expert. Unlock different visual themes to customize the board and make each session feel a little different.\n\n# **Designed specifically as a VR Panel App**\nMinesweeper \u2013 VR Panel lets you enjoy a timeless logic puzzle without taking over your entire VR experience. Play at your own pace while keeping other content within easy reach.", "short_description": "Minesweeper \u2013 VR Panel brings the classic puzzle game to Meta Quest in a lightweight VR panel. Clear mines across multiple difficulty levels, unlock visual themes, and play while multitasking alongside other apps and experiences in Quest."}]}, "developer_name": null, "developer_privacy_policy_url": "https://petricoregames.com/privacy-policy/", "developer_terms_of_service_url": "https://petricoregames.com/tos/", "publisher_name": "Petricore", "support_website_url": "https://petricoregames.com/#contact", "website_url": "https://petricoregames.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26363507183256355"}}]}, "scheduled_offers": {"count": 5, "nodes": [{"status": "PUBLISHED", "id": "1778657586461745"}, {"status": "PUBLISHED", "id": "982804034728745"}, {"status": "PUBLISHED", "id": "1663009948024797"}, {"status": "PUBLISHED", "id": "25425817027095703"}, {"status": "PUBLISHED", "id": "2000565570503199"}]}, "baseline_offer": {"id": "2000565570503199"}, "is_approved": true, "firstOffer": {"nodes": [{"start_ti
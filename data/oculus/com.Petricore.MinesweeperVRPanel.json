uscdn.com/v/t64.5771-25/499298900_1173317544825770_8429585309347445504_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1cwvRiXnV-UQ7kNvwHmyBQ2&_nc_oc=Adlfo7bfFgGws4tiZdEBhhl1W6BD8Scwuc6KCZq3vunHOcaxzz7cAK5_i1vjTzy7Ik0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfyMDpkoG13lf-o5FsjvjPziXur_iLck8SevCdMCzCppPg&oe=69B004AF"}, "display_name": "Minesweeper - VR Panel", "keywords": ["2D", "retro", "casual", "quick", "mine"], "long_description": "Minesweeper \u2013 VR Panel brings the classic puzzle game to Meta Quest in a multitasking-friendly VR panel.\n\n# **Play classic Minesweeper in a lightweight VR panel**\nThe game can stay open alongside other apps and experiences. Clear a few tiles while watching videos, chatting, or taking a break, all without leaving what you are already doing in Quest.\n\n# **The classic puzzle you know and love**\nMinesweeper \u2013 VR Panel features familiar rules and gameplay with multiple difficulty levels, from beginner to expert. Unlock different visual themes to customize the board and make each session feel a little different.\n\n# **Designed specifically as a VR Panel App**\nMinesweeper \u2013 VR Panel lets you enjoy a timeless logic puzzle without taking over your entire VR experience. Play at your own pace while keeping other content within easy reach.", "short_description": "Minesweeper \u2013 VR Panel brings the classic puzzle game to Meta Quest in a lightweight VR panel. Clear mines across multiple difficulty levels, unlock visual themes, and play while multitasking alongside other apps and experiences in Quest."}]}, "developer_name": null, "developer_privacy_policy_url": "https://petricoregames.com/privacy-policy/", "developer_terms_of_service_url": "https://petricoregames.com/tos/", "publisher_name": "Petricore", "support_website_url": "https://petricoregames.com/#contact", "website_url": "https://petricoregames.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_c
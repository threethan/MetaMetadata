ontent-ord5-2.oculuscdn.com/v/t64.5771-25/499298387_909227211785906_465658878683935205_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vIHOPgPsvOAQ7kNvwFzXXRR&_nc_oc=AdrvuGVCw3l4aN06xL20JhuYr7CNiHQKOUuBuVT6YH1k7A9YqD-XRXf659MGDj0Bsfo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBdlC7qsoZQsxH2ExGqvUWm9-KmhEHWtK-4QiBg-YwZTw&oe=6A635CBA"}, {"file_name": "MS5.png", "id": "1820428488676422", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499294650_1820428492009755_4834379194881149957_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l-yYwr3AlDUQ7kNvwE9elsb&_nc_oc=AdotsQQY0C2nrJDt1PPS1btYjr3yHmxrCeISnmrGVTvKS4pCvRDcAcP_hViJ5-c7QyU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDARejlrXbkAtFwsxHX8bYqnpQo6uf1lvZgpk4_HPsVIw&oe=6A636A9F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "MinesweeperVRPanel_Landscape.png", "id": "1173317541492437", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499298900_1173317544825770_8429585309347445504_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=baFIfTtlIYAQ7kNvwGl-e8K&_nc_oc=Adq0aQ2k7T2n16ftzBGr1ciTDBDVEdBnkyU5N8ZoNQ-F3z10_1hQfdr3YADMtAx2F9w&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA4wB3922_1ZkdrZxWru7uhy3dKpQ_4GNH6MKshKUMYmQ&oe=6A6350AF"}, "display_name": "Minesweeper - VR Panel", "keywords": ["2D", "retro", "casual", "quick", "mine"], "long_description": "Minesweeper \u2013 VR Panel brings the classic puzzle game to Meta Quest in a multitasking-friendly VR panel.\n\n# **Play classic Minesweeper in a lightweight VR panel**\nThe game can stay open alongside other apps and experiences. Clear a few tiles while watching videos, chatting, or taking a break, all without leaving what you are already doing in Quest.\n\n# **The classic puzzle you know and love**\nMinesweeper \u2013 VR Panel features familiar rules and gameplay with multiple difficulty levels, from beginner to expert. Unlock different visual themes to customize the board and make each session feel a little different.\n\n# **Designed specifically as a VR Panel App**\nMinesweeper \u2013 VR Panel lets you enjoy a timeless logic puzzle without taking over your entire VR experience. Play at your own pace while keeping other content within easy reach.", "short_description": "Minesweeper \u2013 VR Panel brings the classic puzzle game to Meta Quest in a lightweight VR panel. Clear mines across multiple difficulty levels, unlock visual themes, and play while multitasking alongside other apps and experiences in Quest."}]}, "developer_name": null, "developer_privacy_policy_url": "https://petricoregames.com/privacy-policy/", "developer_terms_of_service_url": "https://petricoregames.com/tos/", "publisher_name": "Petricore", "support_website_url": "https://petricoregames.com/#contact", "website_url": "https://petricoregames.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26363507183256355"}}]}, "scheduled_offers": {"count": 4, "nodes": [{"status": "PUBLISHED", "id": "982804034728745"}, {"status": "PUBLISHED", "id": "1663009948024797"}, {"status": "PUBLISHED", "id": "25425817027095703"}, {"status": "PUBLISHED", "id": "2000565570503199"}]}, "baseline_offer": {"id": "2000565570503199"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1784566800, "status": "PUBLISHED", "id": "9828
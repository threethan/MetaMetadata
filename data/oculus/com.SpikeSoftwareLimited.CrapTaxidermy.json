y", "funny", "weird"], "long_description": "Welcome to the wonderful world of Crap Taxidermy!\n\nCrap Taxidermy lets you test your questionable skills on a selection of animals in a sandbox environment. Pose your models in ridiculous ways and add silly props. Share  your wonderful creations with other players. View and rate other player's creations in the in-game gallery.\n\nVisit us at https://spike.software/games/craptax.html or on our discord server!", "short_description": "Crap Taxidermy lets you test your questionable skills on a selection of animals in a sandbox environment. Pose your models in ridiculous ways and add silly props. Share  your wonderful creations with other players. View and rate other player's creations in the in-game gallery."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1d29t46q2DkkUNrN_HE4N5cTPlnRlWs018WrjtFfrCAA/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Spike Software Limited", "support_website_url": null, "website_url": "https://spike.software/games/craptax.html", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25405975039098829"}}]}, "scheduled_offers": {"count": 3, "nodes": [{"status": "PUBLISHED", "id": "955079403651070"}, {"status": "PUBLISHED", "id": "4291859024475384"}, {"status": "PUBLISHED", "id": "1393972462020651"}]}, "baseline_offe
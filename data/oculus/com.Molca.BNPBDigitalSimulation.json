64.5771-25/473391898_1066089808900951_2589706314154615872_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5RAkHN65zg0Q7kNvwGLFaLo&_nc_oc=Adr_vuDeg4CpRzW9Pvo5e3-CrECxog6O4QdpwClFOAglsznc6Hx8uzDMwhJcDuloBBc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO9Ilgabb23IZ_QFM_5VO2Nf88MwTZ8DXj3f_hFqJC2uQ&oe=6ADF4A41"}, {"file_name": "screen_2560x1440_2025-04-30_08-43-54.png", "id": "1705574263388513", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473393406_1705574270055179_5207072205147326006_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7gsh8i0OmKoQ7kNvwELqVvL&_nc_oc=Adps5FMH56rPNJGQhQ95GBAThuo5fILDepC0QtVnJcBXrd54gojibSRzl07BZiCRBRQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP02LsFF7nA7KYKDwY7malx8ydf6xavN55e3kR1X2yQ3g&oe=6ADF6DC6"}, {"file_name": "screen_2560x1440_2025-04-30_08-44-12.png", "id": "533427963163306", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473393388_533427966496639_1896536541903108669_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZByyJwlIDA8Q7kNvwEEDkCy&_nc_oc=AdoTNeHzTGp9PHenHvWusmisJURYFymMx4NgDcBdLttZFaq50RtCqhXCptsUkIcQIhc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOhesEY5E681I4vbCLRrMaqsfN7uq2yqF3ELzi0tz8lfA&oe=6ADF5C8E"}, {"file_name": "screen_2560x1440_2025-04-30_08-43-32.png", "id": "701048266016081", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473391898_701048269349414_3953282802320149947_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=crWp6enoQXIQ7kNvwEvwk3d&_nc_oc=Adq6K6FHcbWGaBD7t2YjAHdqmOUEnLs2a96jxbIwT7zEmhXr7fj471vYraHCGTchMvY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPK_nRRQ1J8gn7d43kU_9_x9xITnqtRi63-SR2TktWSUw&oe=6ADF525D"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VR Simulasi Bencana", "keywords": [], "long_description": "Aplikasi VR Simulasi Bencanamenghadirkan pengalaman nyata gempa bumi dan tsunami. Dirancang untuk pengguna usia 10 tahun ke atas, simulasi ini memberikan edukasi tentang langkah-langkah menghadapi bencana di daerah rawan seperti Bali, Jembrana, dan Maluku.\nFitur utama:\n- Simulasi Gempa: Rasakan getaran, lihat kerusakan bangunan, dan pelajari cara berlindung yang aman.\n- Simulasi Tsunami: Kenali tanda awal tsunami, dengarkan sirine peringatan, dan ikuti rute evakuasi yang benar.\n- Evaluasi Interaktif: Dapatkan skor dan masukan atas keputusan Anda, dengan saran untuk sesi berikutnya.\nPelajari cara melindungi diri dengan cara yang menarik dan aman, meningkatkan kesadaran dan kesiapsiagaan Anda terhadap bencana.", "short_description": "Aplikasi VR Simulasi Bencana merupakan aplikasi yang membantu pengguna memahami prosedur evakuasi, mengenali tanda bahaya, dan mempraktikkan tindakan penyelamatan dengan aman."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/inovtek3-privacy-policy-vr/vr-simulasi", "developer_terms_of_service_url": null, "publisher_name": "BNPB Inovtek", "support_website_url": null, "website_url": "https://www.instagram.com/bnpb_indonesia/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["id"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24264747573124991"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491822808_1790519628489462_9214497593081753807_n.png?stp=dst-png_s360x360&_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u_b
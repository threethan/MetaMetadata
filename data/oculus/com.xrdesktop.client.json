_oc=AdqfjBOMSXMGn1qgW9QjDwyObxz4UK6RhEAoBbHDRps-5W_Ls0acqBHH0DWN305JXAY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT16XLZoB9vFFUGJ19rYz1oOxw_I1clkpPkgR1Li6ms9Q&oe=6AF49353"}, {"file_name": "Screenshot 2026-10-22 174730.png", "id": "1080270694822105", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/596061819_1080270704822104_2274484248970778369_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yNWd6ES3bccQ7kNvwHFIdl8&_nc_oc=AdrP9gY4_8gb80tQoli69mIhBiNr-qKVBPWtyV1y6E9X9Np8-BtMsFyBALpy6JzQxiM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTaFyVtab7HYfCHTMaQXUo9olNlPOPPV6YEhv5fL6S5Zg&oe=6AF49094"}, {"file_name": "Screenshot 2026-10-22 174806.png", "id": "1633803821487637", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/595123887_1633803824820970_7820754113196869291_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Cw8nFSjFFkIQ7kNvwGPRB1V&_nc_oc=Adq_nsKuLd6weTikzFQe3hA8f7qZJjTGzI8F8zQuILKuuQicHwCAI4cM3xO6nxmXfzo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQphoYzttRArnd6kzZDOYw61gtPA6Xd8nUPuR_Aa6oHmg&oe=6AF46E11"}, {"file_name": "Screenshot 2026-10-22 174905.png", "id": "29279069625060741", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/595129854_29279069638394073_6220082894066186054_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EaHxqqWL_TMQ7kNvwEMTJFF&_nc_oc=Adrz21Gy7e-hv-QtHTJsECv2_aJIKpKVHRCAq34I1C3T69wYosJ7qw2Eb5jKGAbfMr4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQebGBze5EtUv4C7BXQUu7S_EQqwKYXxoyXBh-9bLzR4A&oe=6AF4990B"}, {"file_name": "Screenshot 2026-10-22 174930.png", "id": "1594949015741034", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/604331240_1594949019074367_8988258529914760445_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-NMQoorxi4YQ7kNvwHDYqrp&_nc_oc=AdpbutIprFRKsEWFlPFZAKDovNU6eByz05aw0MVmM8UNfCWrRzesteCpDayPo0FZLCk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR4mBONN3RCD_WW3vkGSRCqN9BpjweKhmlsMfAXtTIFng&oe=6AF49361"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "xr desktop 2030.png", "id": "2000813690588574", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/595119480_2000813697255240_6114697783825911619_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DcmpPc9OwqcQ7kNvwEMs76y&_nc_oc=AdoZg41KhQx9tuBClZmMt8OK1pgc3pDVRy47O6Fxap2ChW32b5I-3TtdbS1YIJgO9-0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRJSQ08Nqu-N3Sdf15VQuUSL-traurV2FcIIqUjR9Gu2A&oe=6AF4A52D"}, "display_name": "XR Virtual Desktop", "keywords": [], "long_description": "YOUR COMPUTER, WITHOUT LIMITS\nStream your Windows PC or Mac to Meta Quest over Wi-Fi with low latency and a sharp picture. Work, browse, code, watch and play on giant screens. No cables.\n\nYOUR PRIVATE VR CINEMA\n\u2022 Watch on a giant 16-meter screen in a full movie theater.\n\u2022 Pick any seat. The hall glows with the colors of your movie.\n\u2022 3D Side-by-Side and Over-Under movies in true 3D.\n{1136210618814875}\nMULTI-MONITOR WORKSPACE\n\u2022 Add a left and right screen in one click: virtual monitors are created for you, no extra hardware.\n\u2022 Move windows between screens like a real desk. Resize, move and curve every screen.\n\n\nWIRELESS PC VR GAMES (Windows)\nPlay your VR PC games library without a Link cable, with smooth head-motion correction and full controller support.\n\nVR OR MIXED REALITY\nSwitch to passthrough in one tap and see your real keyboard while you type.\n\nCONTROL IT YOUR WAY\nControllers or hand tracking: pinch to click, drag, scroll and type.\n\nSOUND IN YOUR HEADSET, NO ECHO\nYour computer's audio plays in the headset while its speakers mute automatically.\n\nGET STARTED\n1. Get the free companion app for Windows or Mac: sites.google.com/view/xrdesktop\n2. Open XR Desktop on Quest and pick your computer.\n3. Approve the headset, and you're in.  \n\n", "short_description": "Stream your Windows PC or Mac to Meta Quest with high-quality streaming and low latency, wirelessly. Work on up to three giant virtual monitors, watch movies in your own private VR cinema with a 16-meter screen, enjoy 3D films with ambient light, and play PC VR games without a cable. VR or mixed reality, controllers or hand tracking: your computer, without limits."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/xrdesktop/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "8 owl studio", "support_website_url": "https://sites.google.com/view/xrdesktop/home", "website_url": "https://sites.google.com/view/xrdesktop/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "393222478507326"}, {"id": "1063584910766706"}, {"id": "1055187466124150"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26783084361388808"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491823940_1160411789780793_7512063435657348424_n.png?stp=dst-png_s360x360&_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bgpYS7GvP34Q7kNvwEWkT6l&_nc_oc=AdqJ9fQl-M3jcCQfBfh0wrjx3GJ3ixSjptpCPS_QDn1FOSPk2-SlNTnUGQzppaMq9bc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRsgNtFy4XvTHh4f503jNogG9IzsdAyAYWNRho7UG7QEQ&oe=6AF4867F"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "XR Virtual Desktop", "platform": "ANDROID_6DOF", "context_category": {"context_category":
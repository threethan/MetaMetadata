974642_2937630136495979_5216385130504498698_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JIizZK4gFrYQ7kNvwGFItWQ&_nc_oc=AdqKMAGVgloP6GLnzbGp7KzAMrl4NLZSoMGXCEPRNP66y9Bga8b9o1L7EUv5csbRmLk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEFmL-tbv_kiS77KGCVxjP0PRMd40EjnOjlIeotx3Dh1w&oe=6A75C411"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440_ytThumb.png", "id": "456597678928871", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974698_456597682262204_606698615353364989_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f-YPp--sUaIQ7kNvwFC_nnN&_nc_oc=AdqiJXF1ZHsW8H5ibg3NX7ud3-IMtce6WE5IRD-7my1wQ8d7cuQ9Ox823J9XJI_jjWo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE-F8wPcSVf0tVKZp8Jaq5RPOwj5DsNtUZ1gU6zC71cRQ&oe=6A75E3BA"}, "display_name": "A Township Tale", "keywords": ["Multiplayer", "Fantasy", "RPG"], "long_description": "Band together with your friends to explore a forgotten world filled with adventure, danger, and ancient secrets.\n\nDiscover an abandoned town that you will turn into a sanctuary in this wild, untamed land. \n\nBecome blacksmiths, warriors, miners, and woodcutters as you build up your town and gear and prepare for your next adventure!\n\nJourney across a vast medieval world filled with mysteries and ancient secrets.\n\nBuild your town and equip it with powerful crafting areas to make specialized gear for the journey ahead.\n\nClaim your role in town. Will you be a Warrior? A Blacksmith? A Crafter? Each is a key part of a thriving town, and governs how you level up and progress.\n\nBattle wicked creatures from across the land. Your party will be tested in wits and sheer skill!\n\nExplore dark caves, where terrible monsters and great treasures await. The deeper you delve, the nastier the monsters. But where else could unclaimed fortunes lie?\n\nWill your story become legend, or will you end in tragedy?", "short_description": "Band together with your friends to explore a forgotten world filled with adventure, danger, and ancient secrets. \n\nDiscover an abandoned town that you will turn into a sanctuary in this wild, untamed land. Become blacksmiths, warriors, miners, and woodcutters as you build up your town and gear and prepare for your next adventure!\n\nBut be wary. \n\nDangers lurk in the dark below, and terrible monsters await between you and untold riches.\n\nWill your story become legend, or will you end in tragedy?"}]}, "developer_name": "Alta", "developer_privacy_policy_url": "https://townshiptale.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Alta", "support_website_url": "https://townshiptale.com/tech-support", "website_url": "https://townshiptale.com/", "category": "EARLY_ACCESS", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "1990104051447093"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE", "RPG", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER", "CO_OP"], "id": "1004147003517116"}}]}, "scheduled_offers": {"count": 37, "nodes": [{"status": "PENDING", "id": "922307315870597"}, {"status": "PENDING", "id": "7139521869408095"}, {"status": "PUBLISHED", "id": "176041001163471"}, {"status": "PENDING", "id": "970628647441907"}, {"status": "PUBLISHED", "id": "1291963378089610"}, {"status": "PUBLISHED", "id": "800049438202808"}, {"status": "PENDING", "id": "3671367976424669"}, {"status": "PENDING", "id": "541027360374995"}, {"status": "PUBLISHED", "id": "4330083950769
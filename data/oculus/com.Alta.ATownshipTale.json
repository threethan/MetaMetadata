": "Compilation.00_16_44_04.Still016.png", "id": "817655492491172", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974591_817655495824505_5243358596941317289_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PEsmarCDgNUQ7kNvwHsaaGP&_nc_oc=Admcbw5iIQm25d7dVXlkdhPvE-UE2UMjvpYtTptas4fxyEn5qtfjsNPzz0d_prabH2U&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfyWxbCrYTDX-rECUkGg6t6mPof-8y7PnufMr4q22dvv7A&oe=69B934F4"}, {"file_name": "Compilation.00_01_16_59.Still002.png", "id": "335560001404023", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982467_335560004737356_2979074049230854365_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cr2HgomNEHMQ7kNvwGO77sU&_nc_oc=AdnUItd8JoumLhM0GJ5kalbiH0UiGrkWacvzOCIe7y94o3hwIcTJSmxE_yK0CfQKzhY&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afy7ASo18xHwZUDDCDhWq1FGcJXB2xR1LLKUzzVjrsVnZg&oe=69B9388F"}, {"file_name": "Compilation.00_14_27_60.Still013.png", "id": "4701134366582994", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39036661_4701134369916327_835261371963444317_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6DHBPvloAVAQ7kNvwF3jvKt&_nc_oc=Adnn44LEMigVgi-Jyf6-KCPlXgyyJQuOIc1acziJZl9ATRB63Ey5w6XCDQ1PTWXKxN4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfyZefo-EEDw4lxzwi8gtw0HiRzNd6xbhF1R9jtMjNd2Tw&oe=69B96560"}, {"file_name": "Compilation.00_10_18_26.Still008.png", "id": "317955936437473", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974573_317955939770806_2865934159432417104_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nAURLEqkAd0Q7kNvwGI9x0B&_nc_oc=AdmooRxVk7hfTCyvdmGaosYfzRjxvNcf0REaZaMTJ9ud5bX31k999GC8EkbJhZumw-c&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfzrmucTANNMaE3vF8P_jHqD_TGYbL69zag_NaxHzvy5qQ&oe=69B92F53"}, {"file_name": "Compilation.00_20_10_39.Still024.png", "id": "2937630133162646", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974642_2937630136495979_5216385130504498698_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hNiXMMgcLhYQ7kNvwHEf5wZ&_nc_oc=AdlfMdVkKFdU7DkdRcaorVPOlZ3gDFI8O_M72BYJ-VkLGNgLCufGQRzOFVYvhgSZq2A&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfwFMmAWFsj-EGAGQ_j-Bq9A40-6b-nU6Qnpb6YucgzGmg&oe=69B93D91"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440_ytThumb.png", "id": "456597678928871", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974698_456597682262204_606698615353364989_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E08aTGAaNZMQ7kNvwGcLF3g&_nc_oc=AdnV_YQ6kQpzC4UGFVg1xADPNgIctZYbYKc2pOdzFFalbipeSTxD-MRq5ABKvhldujw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_Afyz6lXMgrWAKTL0m4HpRH5tPuWGnLgLpWE83b2d6RQ9EA&oe=69B95D3A"}, "display_name": "A Township Tale", "keywords": ["Multiplayer", "Fantasy", "RPG"], "long_description": "Band together with your friends to explore a forgotten world filled with adventure, danger, and ancient secrets.\n\nDiscover an abandoned town that you will turn into a sanctuary in this wild, untamed land. \n\nBecome blacksmiths, warriors, miners, and woodcutters as you build up your town and gear and prepare for your next adventure!\n\nJourney across a vast medieval world filled with mysteries and ancient secrets.\n\nBuild your town and equip it with powerful crafting areas to make specialized gear for the journey ahead.\n\nClaim your role in town. Will you be a Warrior? A Blacksmith? A Crafter? Each is a key part of a thriving town, and governs how you level up and progress.\n\nBattle wicked creatures from across the land. Your party will be tested in wits and sheer skill!\n\nExplore dark caves, where terrible monsters and great treasures await. The deeper you delve, the nastier the monsters. But where else could unclaimed fortunes lie?\n\nWill your story become legend, or will you end in tragedy?", "short_description": "Band together with your friends to explore a forgotten world filled with adventure, danger, and ancient secrets. \n\nDiscover an abandoned town that you will turn into a sanctuary in this wild, untamed land. Become blacksmiths, warriors, miners, and woodcutters as you build up your town and gear and prepare for your next adventure!\n\nBut be wary. \n\nDangers lurk in the dark below, and terrible monsters await between you and untold riches.\n\nWill your story become legend, or will you end in tragedy?"}]}, "developer_name": "Alta", "developer_privacy_policy_url": "https://townshiptale.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Alta", "support_website_url": "https://townshiptale.com/tech-support", "website_url": "https://townshiptale.com/", "category": "EARLY_ACCESS", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "1990104051447093"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE", "RPG", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER", "CO_OP"], "id": "1004147003517116"}}]}, "scheduled_offers": {"count": 37, "nodes": [{"status": "PENDING", "id": "922307315870597"}, {"status": "PENDING", "id": "7139521869408095"}, {"status": "PUBLISHED", "id": "176041001163471"}, {"status": "PENDING", "id": "970628647441907"}, {"status": "PUBLISHED", "id": "1291963378089610"}, {"status": "PUBLISHED", "id": "800049438202808"}, {"status": "PENDING", "id": "3671367976424669"}, {"status": "PENDING", "id": "541027360374995"}, {"status": "PUBLISHED", "id": "433008395076972"}, {"status": "PUBLISHED", "id": "1248474662690303"},
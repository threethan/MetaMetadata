": "Compilation.00_16_44_04.Still016.png", "id": "817655492491172", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974591_817655495824505_5243358596941317289_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3JfdSBTvoQ0Q7kNvwG6l1iM&_nc_oc=AdlhF2bOxnGkt8UjjuTdG9fiKceK18BXzql7uJR6eu1ZMlSUqdTe3I-1BXoSO8ax43E&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_Afv4lNYIbV6XlnVLGDVbjs95lzz6OqRi8mDeFXypAdIzdw&oe=69A962F4"}, {"file_name": "Compilation.00_01_16_59.Still002.png", "id": "335560001404023", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982467_335560004737356_2979074049230854365_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qU5RtKDEzB0Q7kNvwElMvgJ&_nc_oc=AdnKYBicIWBeHCGjUqKoFl4jY4cte480Sz96XECIjQEwSkaDEC_eQTJ-rGU3z-SVwk8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfuKDgD0Rp9fdvHYGyRCys0VOqGMvr1nyveS0y3q1eQ1-Q&oe=69A9668F"}, {"file_name": "Compilation.00_14_27_60.Still013.png", "id": "4701134366582994", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39036661_4701134369916327_835261371963444317_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F4oIlxgkFWQQ7kNvwEBPcgq&_nc_oc=AdkeqPlB-kaGs677vfoB9Ohg3SmA10xmODcd93xhEdH1SG6jRtgGYtCQBg02jFBe45M&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AftRMDG7rpTALAJK2pSW3pezX1zDJfc_E4U1a25UOV4uNQ&oe=69A99360"}, {"file_name": "Compilation.00_10_18_26.Still008.png", "id": "317955936437473", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974573_317955939770806_2865934159432417104_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MfsZvPmumgYQ7kNvwEk3yQi&_nc_oc=Adn0wYgyRXDObtege4RANhVMT1aXIVXJc0RcYvg_iezBKbC1ymQobmecQFjX0k2SbZs&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfvsNEOGxF2_xwZRSiUKYcrl5XIKPvqcmhzX7038jur16g&oe=69A99593"}, {"file_name": "Compilation.00_20_10_39.Still024.png", "id": "2937630133162646", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974642_2937630136495979_5216385130504498698_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0SDAv99p9ewQ7kNvwHMZFea&_nc_oc=Adks4vOGmF4SOm32qUigHi11bXBW6Ta3ZwetpiKP_3mcK8PRcCBl1xIBEz8qNGQFjt4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_Afv7Dzkzn6qbTkFFSsKxp95Fd7CLcJFGSaaF-bJi8nZBpA&oe=69A96B91"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440_ytThumb.png", "id": "456597678928871", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974698_456597682262204_606698615353364989_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nQKzosoWpvQQ7kNvwHE4iCm&_nc_oc=AdljtHIjgKkTvk01dad00-NJs9IOEJUswcoc3uZP-yy2vATvqXeAiN0y3NVP-TW-LkQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AftkbxOswEgWpj0o41viIV8YjYEIv5CtNptGo08Iui619g&oe=69A98B3A"}, "display_name": "A Township Tale", "keywords": ["Multiplayer", "Fantasy", "RPG"], "long_description": "Band together with your friends to explore a forgotten world filled with adventure, danger, and ancient secrets.\n\nDiscover an abandoned town that you will turn into a sanctuary in this wild, untamed land. \n\nBecome blacksmiths, warriors, miners, and woodcutters as you build up your town and gear and prepare for your next adventure!\n\nJourney across a vast medieval world filled with mysteries and ancient secrets.\n\nBuild your town and equip it with powerful crafting areas to make specialized gear for the journey ahead.\n\nClaim your role in town. Will you be a Warrior? A Blacksmith? A Crafter? Each is a key part of a thriving town, and governs how you level up and progress.\n\nBattle wicked creatures from across the land. Your party will be tested in wits and sheer skill!\n\nExplore dark caves, where terrible monsters and great treasures await. The deeper you delve, the nastier the monsters. But where else could unclaimed fortunes lie?\n\nWill your story become legend, or will you end in tragedy?", "short_description": "Band together with your friends to explore a forgotten world filled with adventure, danger, and ancient secrets. \n\nDiscover an abandoned town that you will turn into a sanctuary in this wild, untamed land. Become blacksmiths, warriors, miners, and woodcutters as you build up your town and gear and prepare for your next adventure!\n\nBut be wary. \n\nDangers lurk in the dark below, and terrible monsters await between you and untold riches.\n\nWill your story become legend, or will you end in tragedy?"}]}, "developer_name": "Alta", "developer_privacy_policy_url": "https://townshiptale.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Alta", "support_website_url": "https://townshiptale.com/tech-support", "website_url": "https://townshiptale.com/", "category": "EARLY_ACCESS", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "1990104051447093"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE", "RPG", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER", "CO_OP"], "id": "1004147003517116"}}]}, "scheduled_offers": {"count": 37, "nodes": [{"status": "PENDING", "id": "922307315870597"}, {"status": "PENDING", "id": "7139521869408095"}, {"status": "PUBLISHED", "id": "176041001163471"}, {"status": "PENDING", "id": "970628647441907"}, {"status": "PUBLISHED", "id": "1291963378089610"}, {"status": "PUBLISHED", "id": "800049438202808"}, {"status": "PENDING", "id": "3671367976424669"}, {"status": "PENDING", "id": "541027360374995"}, {"status": "PUBLISHED", "id": "433008395076972"}, {"status": "PUBLISHED", "id": "1248474662690303"},
74642_2937630136495979_5216385130504498698_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XPY9L70sc28Q7kNvwHwIMZm&_nc_oc=AdptxzKDMbkblDxingHvnNaqcwy6oAPV4jy0yTiEc-0cb9gy_Y1waUxLI4-G_1rA19E&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKAQ0YnyRxtwR4uUXU9zkChnQG6gaoLEErsbioWVCnzPQ&oe=6ABBDBD1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440_ytThumb.png", "id": "456597678928871", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974698_456597682262204_606698615353364989_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6Sul4NOUXV0Q7kNvwF9l_JA&_nc_oc=AdpLHhjQC27to0FrOPxoGhFD6DYYBtkwkf8EQlRGNY1FTIpodJFHtinlAU4f3_-1YXY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKKk5cAFDNda7Cee9ATwGXaBCi51B5fVcmSsclq74qFKg&oe=6ABBC33A"}, "display_name": "A Township Tale", "keywords": ["Multiplayer", "Fantasy", "RPG"], "long_description": "Band together with your friends to explore a forgotten world filled with adventure, danger, and ancient secrets.\n\nDiscover an abandoned town that you will turn into a sanctuary in this wild, untamed land. \n\nBecome blacksmiths, warriors, miners, and woodcutters as you build up your town and gear and prepare for your next adventure!\n\nJourney across a vast medieval world filled with mysteries and ancient secrets.\n\nBuild your town and equip it with powerful crafting areas to make specialized gear for the journey ahead.\n\nClaim your role in town. Will you be a Warrior? A Blacksmith? A Crafter? Each is a key part of a thriving town, and governs how you level up and progress.\n\nBattle wicked creatures from across the land. Your party will be tested in wits and sheer skill!\n\nExplore dark caves, where terrible monsters and great treasures await. The deeper you delve, the nastier the monsters. But where else could unclaimed fortunes lie?\n\nWill your story become legend, or will you end in tragedy?", "short_description": "Band together with your friends to explore a forgotten world filled with adventure, danger, and ancient secrets. \n\nDiscover an abandoned town that you will turn into a sanctuary in this wild, untamed land. Become blacksmiths, warriors, miners, and woodcutters as you build up your town and gear and prepare for your next adventure!\n\nBut be wary. \n\nDangers lurk in the dark below, and terrible monsters await between you and untold riches.\n\nWill your story become legend, or will you end in tragedy?"}]}, "developer_name": "Alta", "developer_privacy_policy_url": "https://townshiptale.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Alta", "support_website_url": "https://townshiptale.com/tech-support", "website_url": "https://townshiptale.com/", "category": "EARLY_ACCESS", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "1990104051447093"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE", "RPG", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER", "CO_OP"], "id": "1004147003517116"}}]}, "scheduled_offers": {"count": 0, "nodes": []}, "baseline_offer": null, "is_approved": true, "firstOffer": {"nodes": []}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "7629503373752701", "version": "main-1.7.2.1.42203"}, "id": "251562972692629", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBin
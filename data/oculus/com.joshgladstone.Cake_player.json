3VrlEz47KB2vbXp3TCWVvIKA11YD6mNAs3V9NDPet3vbYJBctg4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQW38_4EfdKwaTsl8t4KvpfWTBPJUnWLtlZa317gGB4iw&oe=6AF1D5A7"}, {"file_name": "screenshot5.png", "id": "1159226328848603", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974845_1159226332181936_7508469070715327871_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YVAykS_NTe8Q7kNvwF3Pc75&_nc_oc=AdpOBhlJp8V4EVenyb8zJFWNq6WFMDi2DHcgDEYXDNCvpNDChW6NUPzFXrZyi3XN8ww&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRhXSyIuVWq6VkFxfvnQnQZcmaal3ZDXeRT-ZfIExQ9Dw&oe=6AF1D8C0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CakePlayerTrailer.png", "id": "1659453028131798", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031367_1659453031465131_7452527225029025688_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KYwNRoHHKJkQ7kNvwFvXgTR&_nc_oc=Adp-rRn_ptPLiEcxMXSvoX_F6V-nYrrvhh2QlCxo8FQYVK_lTCYGRzo9PQZFw-uurwE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSeWsf_CyUmlT0J1iX3mloOoFrl524fnS_YQlljjk2owg&oe=6AF20313"}, "display_name": "Cake Player: Light Field Video", "keywords": [], "long_description": "**Cake_player** is the only way to view the delicious futuristic media format 'Light Field Layered Depth Video', packing up to eight layers of gooey volumetric goodness into a delicious treat you can view in all six glorious degrees of freedom!\n\n**Key Features:**\n- **Exclusive 6DoF technology:** Cake_player is the **ONLY** way to view video from experimental Light Field camera arrays, allowing you to move around and view movies from multiple angles.\n- **Layered Depth Video:** The latest in occlusion-free 6DoF viewing, also allows for reflections and transparency!\n- **Passthrough Mixed-Reality:** Watch volumetric videos in your own room. Put a portal on your wall to another place!\n\nPrepare your appetite for **Cake Player**, the only Light Field Layered Depth Video player. Try a slice of the future of movies today!\n\n**(May only work in the United States due to video hosting issues)**", "short_description": "Prepare your appetite for Cake Player, the only way to view Light Field Layered Depth Light Video -- a layer cake of gooey volumetric goodness that allows for occlusion free 6DoF viewing with some view-dependent effects such as transparency and reflection. Try a slice of the future of movies today!\n\n(May only work in the United States due to video hosting issues)"}]}, "developer_name": "Josh Gladstone", "developer_privacy_policy_url": "http://joshgladstone.com/cake_player_privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Josh Gladstone", "support_website_url": null, "website_url": "http://joshgladstone.com/cake_player.html", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}, {"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["MEDIA_PLAYER"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "595143482567477"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "613277207507783"}]}, "baseline_offer": {"id": "613277207507783"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1716482220, "status": "PUBLISHED", "id": "613277207507783"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "7540640266030596", "version": ".48"}, "id": "3106907072943863", "channel_name": "LIV
c_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wX85SL8whDYQ7kNvwGVozRw&_nc_oc=Ado-tloFmxLASZS_NWcY2LmdpDIfTFhGtLIStIRu_ljFKHueNv7MbWU92ofqwaZGOiY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAW1rlop8zqRBV3yNHs5Jg2zIRBWj2T4-DcLzyfQT99Gg&oe=6A4A77A9"}]}, "id": "1288677052676289", "locale": "en_US", "screenshots": [{"file_name": "1.png", "id": "1170082264899723", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473392317_1170082268233056_8130172728782899541_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TeBRPEhFq0YQ7kNvwHl-2QM&_nc_oc=AdqMltRvip_bV50j9xgmM_XZtUe8QrPtRYH2DtmbJcstsOPFm570WHwaNt4_u9NovyE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBM6_O1r5G1y-TeMUiLCZA27ejknNG2KOcApI6OriIlbA&oe=6A4A5EE3"}, {"file_name": "4.png", "id": "2349351465458293", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473391961_2349351468791626_7952329700315640286_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s_PCtxwMsHQQ7kNvwENlwK9&_nc_oc=AdrtU1nI1el4e7JLsvJCq1svAbU-aWvSsikYCHt80QtbRoGe47oBPirKfuZBYqVu38o&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA_KKxSPNx7OftLFcCW5SvUPK-yVD9_WZYp6Wq0IbtZkw&oe=6A4A5FF9"}, {"file_name": "5.png", "id": "1748766392352358", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473397732_1748766395685691_1490919553456083188_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a6vbBd7ZtskQ7kNvwHea9aP&_nc_oc=AdpxDeD9FcGbbY_ruHTPSG6h8ydKGaAJxf0e4GAjP8858hBulTfnoQQZIF577cRrXyk&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAsSmZdxbf_teywdR3ZiPlp7TgyNlbEqdyKNii8VbWC2A&oe=6A4A6D78"}, {"file_name": "2.png", "id": "8938936049541846", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473394167_8938936052875179_7517157935128036843_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wmUpsgzte5oQ7kNvwH38FN7&_nc_oc=AdrH7glHtbipgptDzwdZ_va5_6YKP5g6jngPNU1WB3lK_w71NVnxK-G_MJoT82AvQJg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDdEfpyq1fU9gusWjJ1SCW9UVzhIYTvxjSBcBK-EfGmKQ&oe=6A4A7FD9"}, {"file_name": "33.png", "id": "3642183412741039", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491823867_3642183416074372_7208071619438657616_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-X8rwdWkVswQ7kNvwHufc8V&_nc_oc=Adp81olJsMF_MQ1xFekRaZ09-kb96VO9t3YuRry-MwRifXQX7-5CcqSRZKGLEvLWROY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAo0TUOlnC5elNexEFdfKem0yEi3A822YtIHz6X7sbiAg&oe=6A4A7325"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "2D Calculator", "keywords": ["calculator"], "long_description": "With this calculator you can do basic calculations and you will have more future features to make it more productive.\n\nHow to use:\n1 - Enter the First Number: Start by typing the first number.\n2 - Choose an Operator: Select the mathematical operator for the calculation:\n+ for addition.\n- for subtraction.\n* for multiplication.\n/ for division.\n% for percentage.\n3 - Enter the Second Number: Type the second number to complete the operation.\n4 - Press the Equals (=) Button: View the result of your calculation.\n\nSteps to Find the Square Root:\n1 - Enter the Number: Begin by typing the number you want to find the square root of.\n2 - Select the Square Root Operator (\u221a): Choose the square root symbol to indicate the operation.\n\nView the Result: The calculator will instantly display the square root of the entered number.\n\nPress the H button to view the history of operations performed.\n", "short_description": "2D calculator for basic calculations."}, {"images": {"nodes": []}, "id": "703716859163444", "locale": "es_LA", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Calculadora", "keywords": ["calculador"], "long_description": "Con esta calculadora, podr\u00e1 realizar c\u00e1lculos b\u00e1sicos y, en el futuro, dispondr\u00e1 de m\u00e1s funciones para que sea m\u00e1s productiva.\n\nC\u00f3mo usar:\n\n1 - Introduzca el primer n\u00famero: Comience escribiendo el primer n\u00famero.\n2 - Elija un operador: Seleccione el operador matem\u00e1tico para el c\u00e1lculo:\n+ para suma.\n- para resta.\n* para multiplicaci\u00f3n.\n/ para divisi\u00f3n.\n% para porcentaje.\n3 - Introduzca el segundo n\u00famero: Escriba el segundo n\u00famero para completar la operaci\u00f3n.\n4 - Pulse el bot\u00f3n Igual (=): Vea el resultado de su c\u00e1lculo.\n\nPasos para hallar la ra\u00edz cuadrada:\n1 - Introduzca el n\u00famero: Comience escribiendo el n\u00famero del que desea hallar la ra\u00edz cuadrada.\n2 - Seleccione el operador de ra\u00edz cuadrada (\u221a): Elija el s\u00edmbolo de ra\u00edz cuadrada para indicar la operaci\u00f3n.\n\nVer el resultado: La calculadora mostrar\u00e1 instant\u00e1neamente la ra\u00edz cuadrada del n\u00famero introducido.\n\nPulse el bot\u00f3n H para ver el historial de operaciones realizadas.", "short_description": "Calculadora 2D para c\u00e1lculos b\u00e1sicos."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1v6QMsCl-7ObxOUjB7RUmbdDAmHeu1omfWwKBQuAeUmk/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Hector Rafael Nu\u00f1ez Suriel", "support_website_url": null, "website_url": "https://sites.google.com/view/calculator-2d/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "393222478507326"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes"
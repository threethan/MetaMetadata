274864", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491830893_695227026608197_3283315053072586854_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HMLW72pUUYsQ7kNvwG4kzBb&_nc_oc=Adru2QVQbG17rjf7ftf8-jhlE76ZM1_HtWW82gShBcTPudVKCSmYj5htXP1nf6jl1QM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRgvUWrV-UBCLhOT1rtarszp_0U6qzGFJ95Qmp-s5f0mQ&oe=6AEB593A"}, {"file_name": "icono.png", "id": "678010241365328", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473391889_678010248031994_3080791420700766413_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3G0am51rlC8Q7kNvwGaOwcR&_nc_oc=AdrkCjan9MS-sndg-A9lAudR0dYqa4Tbs00KH89PIxpz4KVIpSy7KF6pKBy-os4gv7A&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTykiq4YQjydU7nChVuSyTNhDnYaE_pFvam4K0WCbEk2w&oe=6AEB4EA9"}]}, "id": "1288677052676289", "locale": "en_US", "screenshots": [{"file_name": "1.png", "id": "1170082264899723", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473392317_1170082268233056_8130172728782899541_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yzQDpLs-EyYQ7kNvwE5EP3o&_nc_oc=AdpyN1V0pN88_lHwRTB1vhzquwFRC34aS8dHPwVBq0ZxEJ5F_jVn1GbeoTixMVjEceU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTkOyqOI9le2QtVXtXonxCO5a9hHCw9tffuTduZghpGWA&oe=6AEB35E3"}, {"file_name": "4.png", "id": "2349351465458293", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473391961_2349351468791626_7952329700315640286_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IJ28ARq1WzoQ7kNvwH0001S&_nc_oc=AdpTsGML6jTSnJQXMZdbBX25t31t--PaZkxmHtysjyRIt9S1utzDs7Y5Jm5ZfTibao4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTrMaUON5MuWBmySt3pzezYtGc310nrsDWsS-GJIuSvyg&oe=6AEB36F9"}, {"file_name": "5.png", "id": "1748766392352358", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473397732_1748766395685691_1490919553456083188_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AoNfJ6Fhd4UQ7kNvwFM9Izn&_nc_oc=Adq_whiy5XYQkW-X1G604eE72vJzinueCz2-P3OvBoQCEyYpSMgBXZBDFC1qWsL_8Rk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQzB_OPNrVsfhZmx5Ee_gWwO_zVh_evzSaPUGBP0hGL5A&oe=6AEB4478"}, {"file_name": "2.png", "id": "8938936049541846", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473394167_8938936052875179_7517157935128036843_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BLuUHpktmLUQ7kNvwGBxWS-&_nc_oc=AdrS5TOdLz7h6hbVWQxyWYHXp3ohL32bO716JKSToaxQiGvm7OXaknIX2y7ro23lxqc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTKwoEUOEqNV0sAKkOcECrIfXm0zQBMRvFa2LAoO8Xakw&oe=6AEB56D9"}, {"file_name": "33.png", "id": "3642183412741039", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491823867_3642183416074372_7208071619438657616_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=baTNEcZwlQwQ7kNvwEhdvEk&_nc_oc=AdrFB6RWVwG_5n_mip7ZJZKF0iCTRyDwUdzOR7rikiI0qswxO7uC37uZkPYVruBOPps&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR0PWjT-9hgYXby-pO9YFQEIOvq4pAr36ArEmwFOAu2FQ&oe=6AEB4A25"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "2D Calculator", "keywords": ["calculator"], "long_description": "With this calculator you can do basic calculations and you will have more future features to make it more productive.\n\nHow to use:\n1 - Enter the First Number: Start by typing the first number.\n2 - Choose an Operator: Select the mathematical operator for the calculation:\n+ for addition.\n- for subtraction.\n* for multiplication.\n/ for division.\n% for percentage.\n3 - Enter the Second Number: Type the second number to complete the operation.\n4 - Press the Equals (=) Button: View the result of your calculation.\n\nSteps to Find the Square Root:\n1 - Enter the Number: Begin by typing the number you want to find the square root of.\n2 - Select the Square Root Operator (\u221a): Choose the square root symbol to indicate the operation.\n\nView the Result: The calculator will instantly display the square root of the entered number.\n\nPress the H button to view the history of operations performed.\n", "short_description": "2D calculator for basic calculations."}, {"images": {"nodes": []}, "id": "703716859163444", "locale": "es_LA", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Calculadora", "keywords": ["calculador"], "long_description": "Con esta calculadora, podr\u00e1 realizar c\u00e1lculos b\u00e1sicos y, en el futuro, dispondr\u00e1 de m\u00e1s funciones para que sea m\u00e1s productiva.\n\nC\u00f3mo usar:\n\n1 - Introduzca el primer n\u00famero: Comience escribiendo el primer n\u00famero.\n2 - Elija un operador: Seleccione el operador matem\u00e1tico para el c\u00e1lculo:\n+ para suma.\n- para resta.\n* para multiplicaci\u00f3n.\n/ para divisi\u00f3n.\n% para porcentaje.\n3 - Introduzca el segundo n\u00famero: Escriba el segundo n\u00famero para completar la operaci\u00f3n.\n4 - Pulse el bot\u00f3n Igual (=): Vea el resultado de su c\u00e1lculo.\n\nPasos para hallar la ra\u00edz cuadrada:\n1 - Introduzca el n\u00famero: Comience escribiendo el n\u00famero del que desea hallar la ra\u00edz cuadrada.\n2 - Seleccione el operador de ra\u00edz cuadrada (\u221a): Elija el s\u00edmbolo de ra\u00edz cuadrada para indicar la operaci\u00f3n.\n\nVer el resultado: La calculadora mostrar\u00e1 instant\u00e1neamente la ra\u00edz cuadrada del n\u00famero introducido.\n\nPulse el bot\u00f3n H para ver el historial de operaciones realizadas.", "short_description": "Calculadora 2D para c\u00e1lculos b\u00e1sicos."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1v6QMsCl-7ObxOUjB7RUmbdDAmHeu1omfWwKBQuAeUmk/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Hector Rafael Nu\u00f1ez Suriel", "support_website_url": null, "website_url": "https://sites.google.com/view/calculator-2d/home", "category": 
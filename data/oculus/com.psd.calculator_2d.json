LrGNjiWzPi8A6qPafQ-mA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQqHsCH894KAKOStseX-uiAVSb2CQc_5SERjLc37eTidQ&oe=6AFDE439"}, {"file_name": "5.png", "id": "1748766392352358", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473397732_1748766395685691_1490919553456083188_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PKKvomQhQvIQ7kNvwFfpcOL&_nc_oc=AdqxfQJNTCjYRMB6wjPnARxeO48gX1a5bMau9MSTmQSA4ysPJQypqp5Vx5IYQtt3yZY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSyQh2HO26Zki7kfh1L2wVyO7pRXZ7XYIzZs_FTpcFz1g&oe=6AFDB978"}, {"file_name": "2.png", "id": "8938936049541846", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473394167_8938936052875179_7517157935128036843_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PSKog8pbz-kQ7kNvwEZbnmM&_nc_oc=AdoAS2Bmux52GL072iSsBXHcNJntBQD7dXOHmnQHRSpi9d_ydruExhLQM79K4Rm8i30&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSmOhJgEddxo7kddxV0VdOUeTuOFOdIcZUmKxiXBzXRzQ&oe=6AFDCBD9"}, {"file_name": "33.png", "id": "3642183412741039", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491823867_3642183416074372_7208071619438657616_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DfLzSXGzjL4Q7kNvwGNB0oe&_nc_oc=AdpYNR2cf8Loy7J8p5vjoFvtwdXO8zBkrl6_q4tDWwC8Bjs82nNzoKZokX17qNiuDd4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS4_lFpwJgQ4nRzcv4cJV-Z-_9D6gFF5Zeb0xn0Sk-MKA&oe=6AFDBF25"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "2D Calculator", "keywords": ["calculator"], "long_description": "With this calculator you can do basic calculations and you will have more future features to make it more productive.\n\nHow to use:\n1 - Enter the First Number: Start by typing the first number.\n2 - Choose an Operator: Select the mathematical operator for the calculation:\n+ for addition.\n- for subtraction.\n* for multiplication.\n/ for division.\n% for percentage.\n3 - Enter the Second Number: Type the second number to complete the operation.\n4 - Press the Equals (=) Button: View the result of your calculation.\n\nSteps to Find the Square Root:\n1 - Enter the Number: Begin by typing the number you want to find the square root of.\n2 - Select the Square Root Operator (\u221a): Choose the square root symbol to indicate the operation.\n\nView the Result: The calculator will instantly display the square root of the entered number.\n\nPress the H button to view the history of operations performed.\n", "short_description": "2D calculator for basic calculations."}, {"images": {"nodes": []}, "id": "703716859163444", "locale": "es_LA", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Calculadora", "keywords": ["calculador"], "long_description": "Con esta calculadora, podr\u00e1 realizar c\u00e1lculos b\u00e1sicos y, en el futuro, dispondr\u00e1 de m\u00e1s funciones para que sea m\u00e1s productiva.\n\nC\u00f3mo usar:\n\n1 - Introduzca el primer n\u00famero: Comience escribiendo el primer n\u00famero.\n2 - Elija un operador: Seleccione el operador matem\u00e1tico para el c\u00e1lculo:\n+ para suma.\n- para resta.\n* para multiplicaci\u00f3n.\n/ para divisi\u00f3n.\n% para porcentaje.\n3 - Introduzca el segundo n\u00famero: Escriba el segundo n\u00famero para completar la operaci\u00f3n.\n4 - Pulse el bot\u00f3n Igual (=): Vea el resultado de su c\u00e1lculo.\n\nPasos para hallar la ra\u00edz cuadrada:\n1 - Introduzca el n\u00famero: Comience escribiendo el n\u00famero del que desea hallar la ra\u00edz cuadrada.\n2 - Seleccione el operador de ra\u00edz cuadrada (\u221a): Elija el s\u00edmbolo de ra\u00edz cuadrada para indicar la operaci\u00f3n.\n\nVer el resultado: La calculadora mostrar\u00e1 instant\u00e1neamente la ra\u00edz cuadrada del n\u00famero introducido.\n\nPulse el bot\u00f3n H para ver el historial de operaciones realizadas.", "short_description": 
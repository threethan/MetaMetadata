274864", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491830893_695227026608197_3283315053072586854_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Q1IoDiYFaBcQ7kNvwEELPM8&_nc_oc=Adqp9qnLGGaZz_WWE1QkqxGYs1zJLpC7_o916BREWLo6-1nhPTcG_8wywIv3IT1HCIY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOQM_athDncNLQBsxhf7f8LK3mWEd94uVEpvJ79eSFKYw&oe=6AE094FA"}, {"file_name": "icono.png", "id": "678010241365328", "image_type": "APP_IMG_ICON", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473391889_678010248031994_3080791420700766413_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VgVKZsdxP9UQ7kNvwFICceb&_nc_oc=AdqUJbwR4JLZRYJ22HiunnAB2HSvzLgr9uj2EVaK_9gbGXIkhd4C0XE6LkCOAqyuXtk&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNHa0m4SRIiNBczT-1Dg37sbFcV-o0BgXLKmes2e0oQpg&oe=6AE0C2A9"}]}, "id": "1288677052676289", "locale": "en_US", "screenshots": [{"file_name": "1.png", "id": "1170082264899723", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473392317_1170082268233056_8130172728782899541_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5wy6RJV6h94Q7kNvwE5fEun&_nc_oc=AdoZ6uv7ViW25B9jR4w1QPyD8-anIOtsFnmM6zxLGJeCQ7MymPjqkNdw3D64Tra5r1E&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO6UtdK25kWS-PQ-1aRVO3W-_V7rUJjqgnaTfeZW1eucg&oe=6AE0A9E3"}, {"file_name": "4.png", "id": "2349351465458293", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473391961_2349351468791626_7952329700315640286_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RtYwJi-Q49MQ7kNvwEtwl9a&_nc_oc=AdoGYAHkP3TjXUkwbEeqf5LWCSJak5ssZprWWh8GNf9QdBp3VhhcU0gXzQXfWDimiSs&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPZXgWQbNRcZXYka2GESvOXGG5IBSySAVgzMfTmmfeJ4w&oe=6AE0AAF9"}, {"file_name": "5.png", "id": "1748766392352358", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473397732_1748766395685691_1490919553456083188_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=94YzRJPJ0bUQ7kNvwFj7IIG&_nc_oc=AdoRQ3m_PODbMd1OKXJHohO6Bl0bAS28FTObS-xfYf5QOz0CwgrYzi0lJmjMEX4hyck&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPBp7XitaajQjfparK_JU4F60LOJs5SNnScar3_T_LnWg&oe=6AE0B878"}, {"file_name": "2.png", "id": "8938936049541846", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473394167_8938936052875179_7517157935128036843_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iqBTf8pxjMMQ7kNvwEnvrOD&_nc_oc=Ado-8J6A7ArGrIKl71Eh_SsgLSUAZSOyKUX-4WAx3x8KpuIKcM6M-DQHm97NO6-FUpg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN_n0dmcawJcG3HklwUQ_cwW6AU8eAr2kSsJ_QqWAKg-Q&oe=6AE0CAD9"}, {"file_name": "33.png", "id": "3642183412741039", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491823867_3642183416074372_7208071619438657616_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-96D_4G2I7kQ7kNvwEr2DJX&_nc_oc=Adqe6UGbTwBE36keDMklPKlp6cNgOyHz5zCezKqvpPNwhjqI46rext3LAJA-YMFwVa0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM0dbu-B-8weReRpqEVGfj6zJhrUEoi3KQLRgsGjj2tFw&oe=6AE0BE25"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "2D Calculator", "keywords": ["calculator"], "long_description": "With this calculator you can do basic calculations and you will have more future features to make it more productive.\n\nHow to use:\n1 - Enter the First Number: Start by typing the first number.\n2 - Choose an Operator: Select the mathematical operator for the calculation:\n+ for addition.\n- for subtraction.\n* for multiplication.\n/ for division.\n% for percentage.\n3 - Enter the Second Number: Type the second number to complete the operation.\n4 - Press the Equals (=) Button: View the result of your calculation.\n\nSteps to Find the Square Root:\n1 - Enter the Number: Begin by typing the number you want to find the square root of.\n2 - Select the Square Root Operator (\u221a): Choose the square root symbol to indicate the operation.\n\nView the Result: The calculator will instantly display the square root of the entered number.\n\nPress the H button to view the history of operations performed.\n", "short_description": "2D calculator for basic calculations."}, {"images": {"nodes": []}, "id": "703716859163444", "locale": "es_LA", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Calculadora", "keywords": ["calculador"], "long_description": "Con esta calculadora, podr\u00e1 realizar c\u00e1lculos b\u00e1sicos y, en el futuro, dispondr\u00e1 de m\u00e1s funciones para que sea m\u00e1s productiva.\n\nC\u00f3mo usar:\n\n1 - Introduzca el primer n\u00famero: Comience escribiendo el primer n\u00famero.\n2 - Elija un operador: Seleccione el operador matem\u00e1tico para el c\u00e1lculo:\n+ para suma.\n- para resta.\n* para multiplicaci\u00f3n.\n/ para divisi\u00f3n.\n% para porcentaje.\n3 - Introduzca el segundo n\u00famero: Escriba el segundo n\u00famero para completar la operaci\u00f3n.\n4 - Pulse el bot\u00f3n Igual (=): Vea el resultado de su c\u00e1lculo.\n\nPasos para hallar la ra\u00edz cuadrada:\n1 - Introduzca el n\u00famero: Comience escribiendo el n\u00famero del que desea hallar la ra\u00edz cuadrada.\n2 - Seleccione el operador de ra\u00edz cuadrada (\u221a): Elija el s\u00edmbolo de ra\u00edz cuadrada para indicar la operaci\u00f3n.\n\nVer el resultado: La calculadora mostrar\u00e1 instant\u00e1neamente la ra\u00edz cuadrada del n\u00famero introducido.\n\nPulse el bot\u00f3n H para ver el historial de operaciones realizadas.", "short_description": "Calculadora 2D para c\u00e1lculos b\u00e1sicos."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1v6QMsCl-7ObxOUjB7RUmbdDAmHeu1omfWwKBQuAeUmk/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Hector Rafael Nu\u00f1ez Suriel", "support_website_url": null, "website_url": "https://sites.google.com/view/calculator-2d/home", "category": 
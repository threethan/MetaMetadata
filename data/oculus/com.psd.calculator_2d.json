274864", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491830893_695227026608197_3283315053072586854_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HMLW72pUUYsQ7kNvwETC0pN&_nc_oc=AdrJjXnXYKhh4pU5Sf4N1_gDMrckFXvaB9_3EXIdEdGo4veUZdQgBGrfu4aixFuA9zE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTd4vIpGPMOs7pNsNs28FfD7FLv5CbeaVgbMo6-gG5tfg&oe=6AEA07BA"}, {"file_name": "icono.png", "id": "678010241365328", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473391889_678010248031994_3080791420700766413_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3G0am51rlC8Q7kNvwHfA7xC&_nc_oc=Adoi5FA_rlpSuQUnISmsR3Xo7N80hQJ3quEMNF1BxTaxq_cCOhOeLjFJ7UiFGV_HudQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRo0JSfeViMbdjdmwjzeYToRXO8FPwY2NARgzn5A1Xh9Q&oe=6AE9FD29"}]}, "id": "1288677052676289", "locale": "en_US", "screenshots": [{"file_name": "1.png", "id": "1170082264899723", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473392317_1170082268233056_8130172728782899541_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Q06Dkn8hVl8Q7kNvwEPjh2Z&_nc_oc=Adpz_Bo7H5UsESF0eUzOR105FWBVWwjoOpqLycD9kbHO2fLVgK2OEY2yOAEbhSaWE2s&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSVWuFRfkI5Gn4tIYrQ7Cs93vuiu3ScHudLR1Wx3hY6Eg&oe=6AE9E463"}, {"file_name": "4.png", "id": "2349351465458293", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473391961_2349351468791626_7952329700315640286_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IJ28ARq1WzoQ7kNvwEsDmGj&_nc_oc=AdoM_ORlD42x0a7X9QPzCYhSSYzy3c_MUOqmXWohUFbAbB93V6NUaTatkVNSuo4OWgQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSPJzI6KECJBgeaYzRg__KnYpbq8vu6eQMA76D0uVF-GA&oe=6AE9E579"}, {"file_name": "5.png", "id": "1748766392352358", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473397732_1748766395685691_1490919553456083188_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AoNfJ6Fhd4UQ7kNvwFaGkds&_nc_oc=AdqjZsbfI1jO7dhSvXtdxVv-e5k972jxyzhJFPCIXtl65H7GctL0ng1vElUMduOANfY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS-UprnLDqT361keKEU_Gk0wwzuhLEPv_ePgIhjT7I2zQ&oe=6AE9F2F8"}, {"file_name": "2.png", "id": "8938936049541846", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473394167_8938936052875179_7517157935128036843_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BLuUHpktmLUQ7kNvwH2xU35&_nc_oc=AdrvIv1Jo_L3K8nHJFv1QOwni1NrFwENFr54Js2OJS2Us3x7NEQ5B2-LoaFl2w5ye3Q&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR7ZT_882u1MbZ7lqc8xY16mf4Wt_OGPY3deHPU3T2ANg&oe=6AEA0559"}, {"file_name": "33.png", "id": "3642183412741039", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491823867_3642183416074372_7208071619438657616_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=baTNEcZwlQwQ7kNvwF228os&_nc_oc=AdrY7J264n6vL2R7n91sZyeKaKe3EMV6fh3sliLzdHTZc-8u2k0UDVSZqlBgLFJMyGQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ6lea1glC9xR1mu0_a-5WBRwXjjfKPurKLwiHDsUOQ4g&oe=6AE9F8A5"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "2D Calculator", "keywords": ["calculator"], "long_description": "With this calculator you can do basic calculations and you will have more future features to make it more productive.\n\nHow to use:\n1 - Enter the First Number: Start by typing the first number.\n2 - Choose an Operator: Select the mathematical operator for the calculation:\n+ for addition.\n- for subtraction.\n* for multiplication.\n/ for division.\n% for percentage.\n3 - Enter the Second Number: Type the second number to complete the operation.\n4 - Press the Equals (=) Button: View the result of your calculation.\n\nSteps to Find the Square Root:\n1 - Enter the Number: Begin by typing the number you want to find the square root of.\n2 - Select the Square Root Operator (\u221a): Choose the square root symbol to indicate the operation.\n\nView the Result: The calculator will instantly display the square root of the entered number.\n\nPress the H button to view the history of operations performed.\n", "short_description": "2D calculator for basic calculations."}, {"images": {"nodes": []}, "id": "703716859163444", "locale": "es_LA", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Calculadora", "keywords": ["calculador"], "long_description": "Con esta calculadora, podr\u00e1 realizar c\u00e1lculos b\u00e1sicos y, en el futuro, dispondr\u00e1 de m\u00e1s funciones para que sea m\u00e1s productiva.\n\nC\u00f3mo usar:\n\n1 - Introduzca el primer n\u00famero: Comience escribiendo el primer n\u00famero.\n2 - Elija un operador: Seleccione el operador matem\u00e1tico para el c\u00e1lculo:\n+ para suma.\n- para resta.\n* para multiplicaci\u00f3n.\n/ para divisi\u00f3n.\n% para porcentaje.\n3 - Introduzca el segundo n\u00famero: Escriba el segundo n\u00famero para completar la operaci\u00f3n.\n4 - Pulse el bot\u00f3n Igual (=): Vea el resultado de su c\u00e1lculo.\n\nPasos para hallar la ra\u00edz cuadrada:\n1 - Introduzca el n\u00famero: Comience escribiendo el n\u00famero del que desea hallar la ra\u00edz cuadrada.\n2 - Seleccione el operador de ra\u00edz cuadrada (\u221a): Elija el s\u00edmbolo de ra\u00edz cuadrada para indicar la operaci\u00f3n.\n\nVer el resultado: La calculadora mostrar\u00e1 instant\u00e1neamente la ra\u00edz cuadrada del n\u00famero introducido.\n\nPulse el bot\u00f3n H para ver el historial de operaciones realizadas.", "short_description": "Calculadora 2D para c\u00e1lculos b\u00e1sicos."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1v6QMsCl-7ObxOUjB7RUmbdDAmHeu1omfWwKBQuAeUmk/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Hector Rafael Nu\u00f1ez Suriel", "support_website_url": null, "website_url": "https://sites.google.com/view/calculator-2d/home", "category": 
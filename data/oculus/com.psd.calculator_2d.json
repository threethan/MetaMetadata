274864", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/491830893_695227026608197_3283315053072586854_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eDBET7G3rGgQ7kNvwFFOG7_&_nc_oc=AdodVyK6Shw492BtAojmyN4tNrh1kO6zaTZRDATxHlU6FOUhaVsCJw2anUsSo-S7uV8&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMfH6C2cBor1Gzn8-UT2Or-taLWRFCzOmdfhguWKwEKqw&oe=6AE337FA"}, {"file_name": "icono.png", "id": "678010241365328", "image_type": "APP_IMG_ICON", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/473391889_678010248031994_3080791420700766413_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LPUIczPi-SgQ7kNvwG9Mjl0&_nc_oc=AdqC2itrw9db18D8tqy2KVTUtVUZ2QvwSQWUAENbVY_WxPD4iQMhmC7_Ta5qWifp2i0&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMRTe6Bge4zOXM2kZCjR1ddWAu07z5wbAqJrRF65_UqGg&oe=6AE365A9"}]}, "id": "1288677052676289", "locale": "en_US", "screenshots": [{"file_name": "1.png", "id": "1170082264899723", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/473392317_1170082268233056_8130172728782899541_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zaF_YC6dglsQ7kNvwGZnXRY&_nc_oc=AdqXG_6FNSj_UV7xqxLxNmsGYX0hOKOOjnsBSBZEaS-nGQRJuNcM0CBIc97KA0ccccs&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMpXJV8W_jcMtgxXi1Ngv8pF1pNSpZpTinjgz-fTiYcvw&oe=6AE34CE3"}, {"file_name": "4.png", "id": "2349351465458293", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/473391961_2349351468791626_7952329700315640286_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ipoqkojuOeYQ7kNvwHAHjpA&_nc_oc=AdqOJYy3_6DKL5aCl9S0ArlsoK-wbXdFX_cXYzSeDNUhbpEcTFrp-fuoI8QrQMI3PVc&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMJmKRvSFmjbri-F131GyTtyfPDBSubcuTnzjEM8hXlQQ&oe=6AE34DF9"}, {"file_name": "5.png", "id": "1748766392352358", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/473397732_1748766395685691_1490919553456083188_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B_lnSrwMB8kQ7kNvwHMH0ro&_nc_oc=AdrXiORksXVpD7HC-433nqm6zI1q2pyDlx_JdG_BTFiRdIlMZL2cSGmdyL4p1bg7cHA&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPxlYVoe6ZbKWjaZ1GkoJwjV9aH8DmeUsl6JnUuJK2wxQ&oe=6AE35B78"}, {"file_name": "2.png", "id": "8938936049541846", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/473394167_8938936052875179_7517157935128036843_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iqBTf8pxjMMQ7kNvwHF7xRJ&_nc_oc=AdqalfpfRK3Xh9IPSSbe5_c0tMSSw42b63cYlQsCCaQVRsUKvFFGg03de7MSDsJjM-g&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMBCkv8BpARluVTbjP-5J5nT6OqWnPWLQpeprk1hOPErg&oe=6AE36DD9"}, {"file_name": "33.png", "id": "3642183412741039", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/491823867_3642183416074372_7208071619438657616_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JtGnaZZJhNQQ7kNvwGKhsIQ&_nc_oc=AdoWaaBxHq0QOjhGEL25KrzhcNX2-1idSV0SFpKjtz8WQIhtEE1lanBE9wDmamoOt94&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOThE2wf8N74CqQ3oHtgZ-u8AkRL9h2s8qq41oaPLt14A&oe=6AE36125"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "2D Calculator", "keywords": ["calculator"], "long_description": "With this calculator you can do basic calculations and you will have more future features to make it more productive.\n\nHow to use:\n1 - Enter the First Number: Start by typing the first number.\n2 - Choose an Operator: Select the mathematical operator for the calculation:\n+ for addition.\n- for subtraction.\n* for multiplication.\n/ for division.\n% for percentage.\n3 - Enter the Second Number: Type the second number to complete the operation.\n4 - Press the Equals (=) Button: View the result of your calculation.\n\nSteps to Find the Square Root:\n1 - Enter the Number: Begin by typing the number you want to find the square root of.\n2 - Select the Square Root Operator (\u221a): Choose the square root symbol to indicate the operation.\n\nView the Result: The calculator will instantly display the square root of the entered number.\n\nPress the H button to view the history of operations performed.\n", "short_description": "2D calculator for basic calculations."}, {"images": {"nodes": []}, "id": "703716859163444", "locale": "es_LA", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Calculadora", "keywords": ["calculador"], "long_description": "Con esta calculadora, podr\u00e1 realizar c\u00e1lculos b\u00e1sicos y, en el futuro, dispondr\u00e1 de m\u00e1s funciones para que sea m\u00e1s productiva.\n\nC\u00f3mo usar:\n\n1 - Introduzca el primer n\u00famero: Comience escribiendo el primer n\u00famero.\n2 - Elija un operador: Seleccione el operador matem\u00e1tico para el c\u00e1lculo:\n+ para suma.\n- para resta.\n* para multiplicaci\u00f3n.\n/ para divisi\u00f3n.\n% para porcentaje.\n3 - Introduzca el segundo n\u00famero: Escriba el segundo n\u00famero para completar la operaci\u00f3n.\n4 - Pulse el bot\u00f3n Igual (=): Vea el resultado de su c\u00e1lculo.\n\nPasos para hallar la ra\u00edz cuadrada:\n1 - Introduzca el n\u00famero: Comience escribiendo el n\u00famero del que desea hallar la ra\u00edz cuadrada.\n2 - Seleccione el operador de ra\u00edz cuadrada (\u221a): Elija el s\u00edmbolo de ra\u00edz cuadrada para indicar la operaci\u00f3n.\n\nVer el resultado: La calculadora mostrar\u00e1 instant\u00e1neamente la ra\u00edz cuadrada del n\u00famero introducido.\n\nPulse el bot\u00f3n H para ver el historial de operaciones realizadas.", "short_description": "Calculadora 2D para c\u00e1lculos b\u00e1sicos."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1v6QMsCl-7ObxOUjB7RUmbdDAmHeu1omfWwKBQuAeUmk/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Hector Rafael Nu\u00f1ez Suriel", "support_website_url": null, "website_url": "https://sites.google.com/view/calculator-2d/home", "category": 
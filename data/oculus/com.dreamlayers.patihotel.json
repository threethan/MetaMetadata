22089998966290_3748006176215988505_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1FymA1x0RiwQ7kNvwG4vlCe&_nc_oc=Adq29s6eiyLdOThBcGQ6eKYpgYX3H-dO_03JwUcimmQNmkYaXG2BQeeCj-T2XMGBZvI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQUXY_qlI9QbDyDmD8LktH90VKxumCwWftPkocggHyDmig&oe=6B1040E2"}, "display_name": "Pati Hotel", "keywords": [], "long_description": "Welcome to Pati Hotel! Puppies, kittens, bunnies, pandas, penguins and more are waiting at the door.\n\nTap to fill the food bowl, make bubbles, catch the ball, and switch off the lamp for a nap. Collect 36 friends across 12 species, including rare and crowned legendary guests. Expand to eight rooms and unlock a garden, grooming salon, vet clinic and Paw Spa. Choose from six room themes, complete daily goals and play three minigames.\n\nPati Hotel is a single-player pet-care game with 12 languages. Play offline, with no ads or in-app purchases.", "short_description": "Build your own pet hotel! Feed, bathe, play with and tuck in adorable guests and collect 36 friends. No ads, no internet, one-time purchase."}]}, "developer_name": null, "developer_privacy_policy_url": "https://pati-hotel-quest.netlify.app/#privacy", "developer_terms_of_service_url": null, "publisher_name": "Dream Layers Studio", "support_website_url": "https://pati-hotel-quest.netlify.app/#support", "website_url": "https://pati-hotel-quest.netlify.app/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "tr", "de", "it", "ru", "ja", "ko", "id", "pt_BR", "zh_CN", "es", "fr"], "supp
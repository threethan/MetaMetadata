m6G1dumxQTw7ThA&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3BJtLTkMkDV5Xnj3rEThlqHCgAAYPN7KfjJulst6INQw&oe=69F36750"}, {"file_name": "4.png", "id": "1752140042431050", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/491821782_1752140049097716_5207635900878794220_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lSvmu0lBCoMQ7kNvwE3BV1q&_nc_oc=AdpJxrm_40NAZS5JMVRcVXJdAvxkfa3jFWhgJkV5nstODAv6kbX3rFn7j_qYn90EIzY&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2TumtaTJzt1KV-aU3Sdtr9m4iJSNDCF-N9cbzF4B1ziA&oe=69F347DC"}, {"file_name": "5.png", "id": "2026868694872560", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/491821099_2026868698205893_7773513040006310927_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lpJqu_L0JngQ7kNvwFKApFW&_nc_oc=Adpo-3P97UV3BIDlN3iShvcovjTIPZigoxHRb7EJ6bhHLdG6vEx_O0LIPXu0goXbuz8&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0vtUnHcTXFsPE-cuUe_eTJpOInwIteQ2l1YlZJvknraA&oe=69F3579A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Panda Cooking Master", "keywords": ["slicing", "cooking", "panda", "restaurant", "ninja"], "long_description": "**You are a panda running the most chaotic ramen shop in all of Asia. \ud83c\udf5c**\n\nIngredients fly through the air, customers are hungry, and your blade is the only thing standing between a perfect bowl of tonkotsu and an absolute disaster.\n\n**Slice the right ingredients mid-air to cook the perfect recipe! \ud83d\udd2a**\n\n{1367339365435340}\n\n**Too slow and you'll miss it, too careless and you'll end up serving mystery soup to very confused customers.**\n\n{943074245395273}\n\nTrain your eye. Trust your blade. Master every recipe one clean slice at a time.\n\nFast hands. Sharp blade. Hungry panda.\n\nBecome the Ramen Master. \ud83d\udc3c", "short_description": "A panda chef. A flying ingredient. One clean slice.\nRun the most chaotic ramen shop in Asia. Cut the right ingredients mid-air t
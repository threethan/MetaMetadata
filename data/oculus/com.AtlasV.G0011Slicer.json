ile_name": "4.png", "id": "1752140042431050", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/491821782_1752140049097716_5207635900878794220_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mGzlSRWCB3EQ7kNvwECBiBA&_nc_oc=Adov_TWB3vDhx3UkUrJn7eHTVk4tU2y2tbmPZaVRCPyH6gW0xmnqxJQZoVKDJJKADuA&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMceXTdd5bWiuf067rI5vGisz8pCXVBLutCNoccitClfQ&oe=6AC9131C"}, {"file_name": "5.png", "id": "2026868694872560", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/491821099_2026868698205893_7773513040006310927_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NSghsgp1VTwQ7kNvwH4NGmd&_nc_oc=Adomn6vydzNWA6ByWmvY5xLupBzY4gulSuEb2gkNWpM6VN_TSmSnvDeDPoQ1sGcY6dU&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMgAi5Ty9LnTcrFT-3czRJw3UhrnWg9YG72IkxLiIpHzg&oe=6AC8EA9A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Panda Cooking -Soup Slicing Master", "keywords": ["slicing", "cooking", "panda", "restaurant", "ninja"], "long_description": "**You are a panda running the most chaotic ramen shop in all of Asia. \ud83c\udf5c**\n\nIngredients fly through the air, customers are hungry, and your blade is the only thing standing between a perfect bowl of tonkotsu and an absolute disaster.\n\n**Slice the right ingredients mid-air to cook the perfect recipe! \ud83d\udd2a**\n\n{1367339365435340}\n\n**Too slow and you'll miss it, too careless and you'll end up serving mystery soup to very confused customers.**\n\n{943074245395273}\n\nTrain your eye. Trust your blade. Master every recipe one clean slice at a time.\n\nFast hands. Sharp blade. Hungry panda.\n\nBecome the Ramen Master. \ud83d\udc3c", "short_description": "A panda chef. A flying ingredient. One clean slice.\nRun the most chaotic ramen shop in Asia. Cut the right ingredients mid-air to craft the perfect recipe, or serve your customers a bowl of pure regret!\nHow sharp is your blade?"}]}, "developer_name": "Atlab V", "developer_privacy_policy_url": "https://www.arianestudios.com/panda-cooking-master-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Ariane Studios", "support_website_url": null, "website_url": "https://atlasv.io/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "27539501469063508"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/491821704_1618640569463654_8805273169201015434_n.png?stp=dst-png_s360x360&_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WfT-3lrPSM4Q7kNvwES1H-0&_nc_oc=Adqw9YYJ1W3P1aF0UJwECsZhkvBcy6PxMWgsidD-sGJO2n1t_bRtiWRv1HGYQ-KOQxg&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO0t5_lWEq54_0NUFnCYcoJBo5OfCIyj1tlL12FCWMp6A&oe=6AC91450"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Panda Cooking -Soup Slicing Master", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Simulation", "id": "331529188132278"}], "release_date": 1774972800, "lastRevision": {"nodes": [{"id": "26019623984384605", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "26019623917717945", "is_first_party": false, "enables_in_app_ads": false, "is_concept": false, "pl
64.5771-25/491823351_1270007984598634_3016022008313048313_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WkqHBux9h2cQ7kNvwEJZVoM&_nc_oc=AdoNAAIzJCS0i3H-YVza9t4_gyUhfBM7SXpjYAxjskp2ZfFOklfxUYkdh4EYvNTYG6g&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAu8AaHO2jN3GNfeyxn_k_QavOUU4aGep3M0G9PhHZz7A&oe=6A54F650"}, {"file_name": "4.png", "id": "1752140042431050", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491821782_1752140049097716_5207635900878794220_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O2xN9uZQRngQ7kNvwHd8ahh&_nc_oc=Adqn2snNcTg6ndUb74MDoJ3uuNapvpPxD78lBHDBYzsoTtQIDqSEe8HTA5YfAymaMZE&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDt0ehyfYy4OmMYCEWT14WAX9NOclDlAjtsNr2ecPTNHA&oe=6A54D6DC"}, {"file_name": "5.png", "id": "2026868694872560", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491821099_2026868698205893_7773513040006310927_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B_QfO7CZIfkQ7kNvwESnC7r&_nc_oc=Adpwpp91s81IMxXtHITZc93rRTb7hrvFTbt1ZkN1R8K4G-JEChMmnPKcaPp4tWYjVds&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQADqHLPEsl2MhKeE9cw0EAQshyvyI5W-NLi1S5zuKxSLw&oe=6A54E69A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Panda Cooking Master", "keywords": ["slicing", "cooking", "panda", "restaurant", "ninja"], "long_description": "**You are a panda running the most chaotic ramen shop in all of Asia. \ud83c\udf5c**\n\nIngredients fly through the air, customers are hungry, and your blade is the only thing standing between a perfect bowl of tonkotsu and an absolute disaster.\n\n**Slice the right ingredients mid-air to cook the perfect recipe! \ud83d\udd2a**\n\n{1367339365435340}\n\n**Too slow and you'll miss it, too careless and you'll end up serving mystery soup to very confused customers.**\n\n{943074245395273}\n\nTrain your eye. Trust your blade. Master every recipe one clean slice at a time.\n\nFast hands. Sharp blade. Hungry panda.\n\nBecome the Ramen Master. \ud83d\udc3c", "short_description": "A panda chef. A flying ingredient. One clean slice.\nRun the most chaotic ramen shop in Asia. Cut the right ingredients mid-air to craft the perfect recipe, or serve your customers a bowl of pure regret.\nHow sharp is your blade?"}]}, "developer_name": "Atlab V", "developer_privacy_policy_url": "https://www.arianestudios.com/panda-cooking-master-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Ariane Studios", "support_website_url": null, "website_url": "https://atlasv.io/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26019623947717942"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "950350677467624"}]}, "baseline_offer": {"id": "950350677467624"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1774972800, "status": "PUBLISHED", "id": "950350677467624"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "26332254706454863", "version": "1.0.0.35"}, "id": "1679266166572375", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "26019623917717945", "is_concept": false, "latest_released_binar
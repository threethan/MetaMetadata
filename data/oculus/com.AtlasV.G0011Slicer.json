-1.oculuscdn.com/v/t64.5771-25/491823270_929672103305618_7291021816671196507_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8QPs8QZLWEYQ7kNvwH3QCWV&_nc_oc=Ado6KTg6uUYSilaEdO9J1f65HEhIBlPITRPyh-kf53jIdVnvhi0MHCIhKatW1CwWhyI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3TmP4Te0dWWp-yc5_srIwR2ozuiBSGvsuA4XZRxOS4iQ&oe=69F8B7E9"}, {"file_name": "3.png", "id": "1270007981265301", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491823351_1270007984598634_3016022008313048313_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l5OWlE0WRZgQ7kNvwHmOJ5f&_nc_oc=AdqqoZm9g7WKNFG6Fgtb5EptAhl60VFhL8RtBC_84iYTTAVMAFuIuZB4se939e8e664&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0CWR53F6u8cA9nai3rqd8Vk2BIr4Vg6y2M5PGZke_VuQ&oe=69F8AD50"}, {"file_name": "4.png", "id": "1752140042431050", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491821782_1752140049097716_5207635900878794220_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9VPy3kzx93UQ7kNvwHOG_pC&_nc_oc=Ado12Dn88d3ctuuzlO3wtZMg7BJ9Llrt0Y518BXWIHxsvlKnSpCLlYApNRAkpEDB-lM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af25rH1ToRsX3Ruce3hY8bKKhFE4F2N2FsEXY_EtF3cWuQ&oe=69F88DDC"}, {"file_name": "5.png", "id": "2026868694872560", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491821099_2026868698205893_7773513040006310927_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XC-RivpJCrkQ7kNvwFsGB47&_nc_oc=AdrQf03rNQQ4TG7JK5TNqqB5cAxZ5Sj1khSr3iuWwsmch5e2rrYnMwYUElRBW5Z5uWE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1cXnRngRM7K1sbp1seAdgWlxhjjesyrNH-_9FTh9wzEQ&oe=69F89D9A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Panda Cooking Master", "keywords": ["slicing", "cooking", "panda", "restaurant", "ninja"], "long_description": "**You are a panda running the most chaotic ramen shop in all of Asia. \ud83c\udf5c**\n\nIngredients fly through the air, customers are hungry, and your blade is the only thing standing between a perfect bowl of tonkotsu and an absolute disaster.\n\n**Slice the right ingredients mid-air to cook the perfect recipe! \ud83d\udd2a**\n\n{1367339365435340}\n\n**Too slow and you'll miss it, too careless and you'll end up serving mystery soup to very confused customers.**\n\n{943074245395273}\n\nTrain your eye. Trust your blade. Master every recipe one clean slice at a time.\n\nFast hands. Sharp blade. Hungry panda.\n\nBecome the Ramen Master. \ud83d\udc3c", "short_description": "A panda chef. A flying ingredient. One clean slice.\nRun the most chaotic ramen shop in Asia. Cut the right ingredients mid-air to craft the perfect recipe, or serve your customers a bowl of pure regret.\nHow sharp is your blade?"}]}, "developer_name": "Atlab V", "developer_privacy_policy_url": "https://www.arianestudios.com/panda-cooking-master-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Ariane Studios", "support_website_url": null, "website_url": "https://atlasv.io/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26019623947717942"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "950350677467624"}]}, "baseline_offer": {"id": "950350677467624"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1774972800, "status": "PUBLISHED", "id": "950350677467624"}]}, "liveChannel": {"nodes": [{"lat
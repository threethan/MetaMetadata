771-25/491823351_1270007984598634_3016022008313048313_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mfmYba3wFW8Q7kNvwGpSobO&_nc_oc=AdrkEhubXQmhCfOXDl37wkcO_4px-6_tmq0i2fQwU0E9OioZAyhDCuwJOn5VgJelRWs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXiL9jUP9OIbujVWJy8xPhoB6O3R9finG9R9ZdpozISqQ&oe=6B106390"}, {"file_name": "4.png", "id": "1752140042431050", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491821782_1752140049097716_5207635900878794220_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MYO2zLXyVbMQ7kNvwGWFOgP&_nc_oc=AdpcyA4BHIYXyPwO9oYQvPJbTWin8XOM90OburjrvUUoiX65jg6ozv3fscZpp4kYBJs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWmQY-TrFAagdSEkZNu2IvAQOa17_j-Kg_R9BODDItyCw&oe=6B10441C"}, {"file_name": "5.png", "id": "2026868694872560", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491821099_2026868698205893_7773513040006310927_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KpiDVOCcuYkQ7kNvwGOL8KC&_nc_oc=Adr_Rck969LdrGseclekqPentRL0bY0pJVu7n5B7rPPGbQ8z33OZ_aWTg-bHLOb9cK4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVdCbxZO4ryoCBOXaJEjXMar20fT2NNsQwKQoTW4joVSQ&oe=6B1053DA"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Panda Cooking -Soup Slicing Master", "keywords": ["slicing", "cooking", "panda", "restaurant", "ninja"], "long_description": "**You are a panda running the most chaotic ramen shop in all of Asia. \ud83c\udf5c**\n\nIngredients fly through the air, customers are hungry, and your blade is the only thing standing between a perfect bowl of tonkotsu and an absolute disaster.\n\n**Slice the right ingredients mid-air to cook the perfect recipe! \ud83d\udd2a**\n\n{1367339365435340}\n\n**Too slow and you'll miss it, too careless and you'll end up serving mystery soup to very confused customers.**\n\n{943074245395273}\n\nTrain your eye. Trust your blade. Master every recipe one clean slice at a time.\n\nFast hands. Sharp blade. Hungry panda.\n\nBecome the Ramen Master. \ud83d\udc3c", "short_description": "A panda chef. A flying ingredient. One clean slice.\nRun the most chaotic ramen shop in Asia. Cut the right ingredients mid-air to craft the perfect recipe, or serve your customers a bowl of pure regret!\nHow sharp is your blade?"}]}, "developer_name": "Atlab V", "developer_privacy_policy_url": "https://www.arianestudios.com/panda-cooking-master-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Ariane Studios", "support_website_url": null, "website_url": "https://atlasv.io/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "27539501469063508"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491821704_1618640569463654_8805273169201015434_n.png?stp=dst-png_s360x360&_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Qfg6GfDlcKoQ7kNvwF0jwGP&_nc_oc=AdpDGPPyhVDl9C1kgpiOwEEqje6TbtKCe4TDJdJcwkNs8vGK6h8D416w7GP1-WAgbaE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVDMtgnkGDzL_5E4muoTOjuJMlDORgZu2i4D4Q33C8E1w&oe=6B104550"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Panda Cooking -Soup Slicing Master", "platform": "ANDROID_6DOF", "context_category": {"context_
771-25/491823351_1270007984598634_3016022008313048313_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZTU4VMC2p38Q7kNvwGx9Zs0&_nc_oc=AdpbCFfxC0lj2TPc8i-IdFE_rdQ320pw9A8Hgq9FPNOcS1LGl-xO7TB42Su--GYBKls&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWWneQKPeE7Dr7WQLCqMCR2jwyOsbRvX2rShLEKOcZXIw&oe=6B0F1210"}, {"file_name": "4.png", "id": "1752140042431050", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491821782_1752140049097716_5207635900878794220_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MYO2zLXyVbMQ7kNvwGzIyui&_nc_oc=Adq9MOqHGgSl4AHhhvHEMjzLhwRY5g2Tox4XB_YtmP5kjQI071zvpUdYRpx_k8vvduM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXHxtutg5zvkyoKabs3UW_EAo0LXs6lSoyYtFwMzYbeMg&oe=6B0EF29C"}, {"file_name": "5.png", "id": "2026868694872560", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491821099_2026868698205893_7773513040006310927_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vADVeFuVrIkQ7kNvwF3Zg3T&_nc_oc=Adp-z_2GhDu7IqyOa8ksbuJv-FdtSpRpEKpQPsDA-2SRKwpsFW8dBHM_rXG5JZx7cRM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVAc6Uj2t9-dM_DE8_K3jGhfgZ8SlwsvloTe1gS0Xp_yQ&oe=6B0F025A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Panda Cooking -Soup Slicing Master", "keywords": ["slicing", "cooking", "panda", "restaurant", "ninja"], "long_description": "**You are a panda running the most chaotic ramen shop in all of Asia. \ud83c\udf5c**\n\nIngredients fly through the air, customers are hungry, and your blade is the only thing standing between a perfect bowl of tonkotsu and an absolute disaster.\n\n**Slice the right ingredients mid-air to cook the perfect recipe! \ud83d\udd2a**\n\n{1367339365435340}\n\n**Too slow and you'll miss it, too careless and you'll end up serving mystery soup to very confused customers.**\n\n{943074245395273}\n\nTrain your eye. Trust your blade. Master every recipe one clean slice at a time.\n\nFast hands. Sharp blade. Hungry panda.\n\nBecome the Ramen Master. \ud83d\udc3c", "short_description": "A panda chef. A flying ingredient. One clean slice.\nRun the most chaotic ramen shop in Asia. Cut the right ingredients mid-air to craft the perfect recipe, or serve your customers a bowl of pure regret!\nHow sharp is your blade?"}]}, "developer_name": "Atlab V", "developer_privacy_policy_url": "https://www.arianestudios.com/panda-cooking-master-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Ariane Studios", "support_website_url": null, "website_url": "https://atlasv.io/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "27539501469063508"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491821704_1618640569463654_8805273169201015434_n.png?stp=dst-png_s360x360&_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5ZY3FzXyhx0Q7kNvwFTbRDt&_nc_oc=Adqkw_H0kZoF3zwY6xGklsZf-27MFs7xU0_8DDTVBZ3jqsWelL5QV9va2UsS0Fftnnk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVxAAdDfyKEwkE5c3xkwVB6UTD1um7JXyo_GdsPkKQlVg&oe=6B0EF3D0"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Panda Cooking -Soup Slicing Master", "platform": "ANDROID_6DOF", "context_category": {"context_
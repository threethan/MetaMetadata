81_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PLHTRUwS-ykQ7kNvwFWBopj&_nc_oc=AdmGusmGY-EBKNSJB5mGBwJWdHgQ6IIgpVLzRdKsMOTk7Kt2mQ92TqdyOdfSTeIswTk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AfsgFSAJj047UBTDEbxYDwyZAHxijoWYoP70Qmji1MYHNw&oe=699B109A"}]}, "id": "3094825087368140", "locale": "en_US", "screenshots": [{"file_name": "screen4.png", "id": "1897576971139905", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491821081_1897576974473238_6012602603688686732_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=41I7ynl7YwQQ7kNvwH_SPgP&_nc_oc=Adn2DqPEkeXq8CBStneR11qLv8NUWoz2d8gbS5Wdb3txQ8lAix253ARSCPBeAJlTVrw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_AfswWMhu-6z3nD6kgCubXw1GfG9s30Bp4Dvu2cctqQpYgQ&oe=699B14FC"}, {"file_name": "screen5.png", "id": "1389821939428458", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491824322_1389821946095124_8207700636436265801_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZPhwEp8_NvsQ7kNvwEf-HUB&_nc_oc=AdkXiKvWA-5JXt7PCYsBF9Lj_lpTWykvYqFGPY5qUIgAQmKLjLIbIqbgSb5uU8qXkxw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_AfteHY9cspV6xxIvFDd4sLIdsbBtdvCNbCl7qkSqInqstA&oe=699AF85E"}, {"file_name": "s1.png", "id": "318780111304792", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974776_318780117971458_2654408182135967797_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zTK5uIR9KREQ7kNvwGUbdpX&_nc_oc=AdklixlS797xN6WUzo4ti1v5P5TfXXtyJIGcaEoWpQbc436dy1Ht9ko1RxNj_Ok2voc&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfvcsnM_mDWZ167huoYDRT0Imy572H7w9EVDPRezfApiAw&oe=699AF823"}, {"file_name": "s2.png", "id": "1120491249241440", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/57570301_1120491252574773_2492706531371093963_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O5vvtfCCZYMQ7kNvwExdYnm&_nc_oc=AdlqJFb_lhqekjcw_oNs2q0_kc6v_e-cJMaGj9m8DNCAG762bJPiw76mXN88vHbfoAI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_AftVk6O4K-K5_DSXBTWdJBUGNdoS4iaDI5sMvbfro27TbQ&oe=699B0504"}, {"file_name": "s4.png", "id": "437303129199364", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39035326_437303132532697_7909222666923155644_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tAsRhZFHheYQ7kNvwGOjusJ&_nc_oc=AdkTCK4io_NNK-UwRqRA0i_VY262h_S8rKDQU0HCGaPzoLIyvIuHuOB2CWN0P6Gnm8s&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfthRBTjl0Bv3Wx9mXWMIY1W_hywKBxiVlH8ZLQeSd99uw&oe=699AFADF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Airport 2560x1440.png", "id": "2332060143980366", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491818860_2332060150647032_12179299875644636_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rrdOfGSpWnQQ7kNvwGgULY6&_nc_oc=Adk5gghL6_Na2FMDWtdZtENzRoxK8BNJyspGF_mslKVHVmTI1ZstFlm9OLPGi-S89FM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AfuBXQZ-jRqqXfVUVNzC0FkyySjAQ-KwDd2ECmnwCfzHhg&oe=699AF51F"}, "display_name": "I Am Security", "keywords": ["night", "club", "boxing", "airport", "security"], "long_description": "**SCAN AND CHECK**\n\nYour main task is to identify who can enter the club and who can't. Guests will line up, and you must decide if they are allowed in based on certain criteria. Some guests might try to sneak in with prohibited items, and it's up to you to find these hidden objects. Use a range of tools, like metal detectors and scanners, to inspect the guests and uncover anything suspicious.\n{423604820697059}\n\n**CLEAN THE VISITORS**\n\nClean the visitors, remove tattoos, and splash water!\n\n\n**MAKE FANCY HAIRCUTS**\n\nYou can make haircuts, shave, and even make the hair grow!\n\n**SELL AND BUY ITEMS**\n\nThe game offers a shop where you can buy new items and tools to make things more interesting. These upgrades will help you improve your security skills and make your job easier. With every level, the difficulty increases, and you\u2019ll encounter more complex scenarios and tougher decisions.\n{515449900947775}\n\n**HAVE FUN**\n\nUse a lot of fun and cool items, that you can use on the visitors and have fun!\n\"I Am Security\" is all about quick thinking and sharp attention to detail. Will you be able to spot the troublemakers and keep the club safe? Play now and find out!\n", "short_description": "Security\u2019s call, catch them all."}]}, "developer_name": null, "developer_privacy_policy_url": "https://newfolderstudio.com/privacy-policy/meta-en", "developer_terms_of_service_url": null, "publisher_name": "NEW FOLDER GAMES LTD", "support_website_url": null, "website_url": "https://newfolderstudio.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2710427532541308"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "34208463225405546"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491823837_1674657110229150_5564443658004678086_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=p7VSEUbWxcQQ7kNvwG9r79S&_nc_oc=AdlSoAN8IJVGMuorCIS9dJIPr44ZmpmmezM-JeXD4J4UV9ydli833dSqJYJCWb_39Qc&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_Afup5GiEedckvb_IAw7lcpftz8AofWQkyfnGhGwlNj8vNw&oe=699B13A6"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "I Am Security", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Action", "id": "459781504968480"}, {"topi
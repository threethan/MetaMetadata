y 512 x 512 logo.png", "id": "781891947444822", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39003282_781891950778155_6625273941062104281_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VfOrUVt85RwQ7kNvwHszoR6&_nc_oc=AdpX7dcMGjwSvze_016O3QVnqYSpAr89kCtuWxEwCGoKJzqiMmfoC8vbLceUySxV-Ww&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPEj9vBLMaVqquM1_Gs8omylUGlwSIppiIYFGmomQfh8A&oe=6AC10F1A"}]}, "id": "3094825087368140", "locale": "en_US", "screenshots": [{"file_name": "screen4.png", "id": "1897576971139905", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491821081_1897576974473238_6012602603688686732_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wGmlZ7kqzRYQ7kNvwG7NC_a&_nc_oc=Adp_TIV2AuHT77Tz5TIh2-9mHCYWtsrZTQlO7m5NoPVD2yRb2hpVccE7sVUWIQW9eVw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOgmhBkC3BwZLL-0rnzuXZj21okLKFBI9HGiW9stv6oug&oe=6AC1137C"}, {"file_name": "screen5.png", "id": "1389821939428458", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491824322_1389821946095124_8207700636436265801_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ql_t0TNFGD4Q7kNvwEAt-bJ&_nc_oc=Adp9OG7s9CQVYVyqVxkr8CFQfUHmZ-hT_FS_8XKo7ew-8SDLo7sMQkdzggPiFJXiHN4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN7wQ164BsVd3OzXjRuGRJFNfAQm35MzCn6DiI02-rleg&oe=6AC12F1E"}, {"file_name": "s1.png", "id": "318780111304792", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974776_318780117971458_2654408182135967797_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SVpVbwnossgQ7kNvwEmuLsq&_nc_oc=Ado0iMayOiz801Oq0G09vyibyb1Zp11RNLbER-z7GUmZctYPhSnGzWOs0L70v0QPsJM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMVugMfZLZY0gtP-MJeLEeuKvpk2RV6qarJokkZ5I4asQ&oe=6AC12EE3"}, {"file_name": "s2.png", "id": "1120491249241440", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/57570301_1120491252574773_2492706531371093963_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zoMfl7eXihAQ7kNvwECRpY7&_nc_oc=AdpwDNeQu1r81jeewYlVg20NdHDKPPWO830PcmJz5OZmVWGy2YPiMuGTcHi_dlIaRnA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPdWa-XqDt_1ZOC5-IG2GoWHCGoCg5wMvS-T56IO2fegw&oe=6AC10384"}, {"file_name": "s4.png", "id": "437303129199364", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39035326_437303132532697_7909222666923155644_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fGmINI4dRpoQ7kNvwFEmyKF&_nc_oc=AdoInD4TBpS5DfqjoF2doLX4n_1tjzlJFTkEgcHgumGwkU2AsP1wjg2FDKfsneTg31s&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN3l1cdWJL6EEH_vKlKr1ezcYDlktfw2ICoE5QpuywJkw&oe=6AC1319F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Airport 2560x1440.png", "id": "2332060143980366", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491818860_2332060150647032_12179299875644636_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=do1F2lq_0v8Q7kNvwH93Hm_&_nc_oc=AdoeE39XteV__rx-YYTFWYSGliVqkKfNTr0m-L-O0bv8taZdj3Dw4G8xPVY20X-2uUs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMlXPje6qntvSMhrezoUVIgLUiK6vhKTBTeKmq6PtTXGQ&oe=6AC12BDF"}, "display_name": "I Am Security", "keywords": ["night", "club", "boxing", "airport", "security"], "long_description": "**SCAN AND CHECK**\n\nYour main task is to identify who can enter the club and who can't. Guests will line up, and you must decide if they are allowed in based on certain criteria. Some guests might try to sneak in with prohibited items, and it's up to you to find these hidden objects. Use a range of tools, like metal detectors and scanners, to inspect the guests and uncover anything suspicious.\n{423604820697059}\n\n**CLEAN THE VISITORS**\n\nClean the visitors, remove tattoos, and splash water!\n\n\n**MAKE FANCY HAIRCUTS**\n\nYou can make haircuts, shave, and even make the hair grow!\n\n**SELL AND BUY ITEMS**\n\nThe game offers a shop where you can buy new items and tools to make things more interesting. These upgrades will help you improve your security skills and make your job easier. With every level, the difficulty increases, and you\u2019ll encounter more complex scenarios and tougher decisions.\n{515449900947775}\n\n**HAVE FUN**\n\nUse a lot of fun and cool items, that you can use on the visitors and have fun!\n\"I Am Security\" is all about quick thinking and sharp attention to detail. Will you be able to spot the troublemakers and keep the club safe? Play now and find out!\n", "short_description": "Security\u2019s call, catch them all."}]}, "developer_name": null, "developer_privacy_policy_url": "https://newfolderstudio.com/privacy-policy/meta-en", "developer_terms_of_service_url": null, "publisher_name": "NEW FOLDER GAMES LTD", "support_website_url": null, "website_url": "https://newfolderstudio.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2710427532541308"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "34208463225405546"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491823837_1674657110229150_5564443658004678086_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WBsEmdZXCtsQ7kNvwH1pLWu&_nc_oc=AdoCzGSjbA-P76a0yktXPBXO5xkxEjMCZwR1rNi-UuddL3FtjvztWicCCdvrDpdN8M8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMbQh-bHZaIhS5aypHP3F_GJxkJoGvXengmZ30ZV3Ue-Q&oe=
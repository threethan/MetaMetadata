y 512 x 512 logo.png", "id": "781891947444822", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39003282_781891950778155_6625273941062104281_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DdbPYg5CX94Q7kNvwFPzGQD&_nc_oc=AdqcIkZvGiRu24ICD3aY_bjhKUDiLJ-a3u1fUbvIy4DT6D1-m0Hr2b5lD3_JGcrTHmA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN2xJRx9Fz6d1XBncTDtPwxRadkkqZacx7AAN3LHoBHxA&oe=6AC6551A"}]}, "id": "3094825087368140", "locale": "en_US", "screenshots": [{"file_name": "screen4.png", "id": "1897576971139905", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491821081_1897576974473238_6012602603688686732_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N_TozzEC1D0Q7kNvwG_bgIf&_nc_oc=AdpfjrLGW07haOXPS5iT7Or7w3AzDCj7vQMuUqn_EtnL7sum8nSv5FuVh-rGQ2CejGM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMvrDOh9_A6cvm4qNtrTL1s_ZKptA-Q_JazR-zAezTvaQ&oe=6AC6597C"}, {"file_name": "screen5.png", "id": "1389821939428458", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491824322_1389821946095124_8207700636436265801_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i1PW0VA44R8Q7kNvwGBEqQJ&_nc_oc=AdoTSftjNJeCRPjaO2OI1sOGrvSDhlins188h9_fY2oi0af4UgOADNdMZMGxhbwHVhs&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOMzzLZEbQMBarH-mWNzQE8NZq-VCikWca7_u0GLwkEdg&oe=6AC6751E"}, {"file_name": "s1.png", "id": "318780111304792", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974776_318780117971458_2654408182135967797_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Nu2lSc5AmakQ7kNvwF_ZHSU&_nc_oc=AdqnYOFuOfqMw68DIfBZcunR8zSHoUJitV2JbLxHTCqvGSNlqgKj13UziaWbyFB9bMU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMy1PuKGEmvnQ9jkC-NNdaoNSfyxt0GoGOI1UzvjRSJqQ&oe=6AC674E3"}, {"file_name": "s2.png", "id": "1120491249241440", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/57570301_1120491252574773_2492706531371093963_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MWijeth9U4oQ7kNvwHOS70n&_nc_oc=AdpIB0tDeFDu3Ft4omP7Pkg0Npi7000ZWeHqWa3-C9KauyBFUcuVLA4uQZmIqU4akW0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP4sNccS_E7MFM1HhY3aX6mcmrX96TiE51zpa4cr8DuJg&oe=6AC64984"}, {"file_name": "s4.png", "id": "437303129199364", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39035326_437303132532697_7909222666923155644_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZZiI5OdJZIcQ7kNvwFiI8hb&_nc_oc=Adrp3yWY0VYt3xJQfLcpfW4RfVRhUIKAV66R0zQDFK80hA45nhEgi1QwUXaaIz3r7Pw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOWR2NdSMUsc5xwH9KJR0ahz7VHoYZyH95yqsbiBwFQQA&oe=6AC6779F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Airport 2560x1440.png", "id": "2332060143980366", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491818860_2332060150647032_12179299875644636_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pXOP99IZZNUQ7kNvwHy5hTb&_nc_oc=AdpDHdRH0N0C_CLptdOp8-k6UWpu2Ez8-d6a769opUk6t2SBkvATVDizocj3tH9nsUI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMenFr_YE15DTP6iC9pkJBi7U5_B0xl9kckJRryiHRZJw&oe=6AC671DF"}, "display_name": "I Am Security", "keywords": ["night", "club", "boxing", "airport", "security"], "long_description": "**SCAN AND CHECK**\n\nYour main task is to identify who can enter the club and who can't. Guests will line up, and you must decide if they are allowed in based on certain criteria. Some guests might try to sneak in with prohibited items, and it's up to you to find these hidden objects. Use a range of tools, like metal detectors and scanners, to inspect the guests and uncover anything suspicious.\n{423604820697059}\n\n**CLEAN THE VISITORS**\n\nClean the visitors, remove tattoos, and splash water!\n\n\n**MAKE FANCY HAIRCUTS**\n\nYou can make haircuts, shave, and even make the hair grow!\n\n**SELL AND BUY ITEMS**\n\nThe game offers a shop where you can buy new items and tools to make things more interesting. These upgrades will help you improve your security skills and make your job easier. With every level, the difficulty increases, and you\u2019ll encounter more complex scenarios and tougher decisions.\n{515449900947775}\n\n**HAVE FUN**\n\nUse a lot of fun and cool items, that you can use on the visitors and have fun!\n\"I Am Security\" is all about quick thinking and sharp attention to detail. Will you be able to spot the troublemakers and keep the club safe? Play now and find out!\n", "short_description": "Security\u2019s call, catch them all."}]}, "developer_name": null, "developer_privacy_policy_url": "https://newfolderstudio.com/privacy-policy/meta-en", "developer_terms_of_service_url": null, "publisher_name": "NEW FOLDER GAMES LTD", "support_website_url": null, "website_url": "https://newfolderstudio.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2710427532541308"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "34208463225405546"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491823837_1674657110229150_5564443658004678086_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m1pscxNibAMQ7kNvwHdT6tj&_nc_oc=Adofma0RKkKw0OwqoToHfNt0auJfH_RO60MqGpNMtmi7QWStUmMV9jSTNOo7_CT3QfI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPqyNHTBbWemhtxN16v0F98-iif3oHLNK67x4WiEF4Uww&oe=
y 512 x 512 logo.png", "id": "781891947444822", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39003282_781891950778155_6625273941062104281_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RsGisZbT06kQ7kNvwEG5LRJ&_nc_oc=AdpfU-wOIHjZJzBKkNdi_QukpW79OvpsechFtfIRJ3fjmPheJcrzWO2BR3UZwgJRHOk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBPr2LhzDvDI8hB0XgCdmSZCbC6ZtQ6KgfiCmpXUkRmHA&oe=6A50FF9A"}]}, "id": "3094825087368140", "locale": "en_US", "screenshots": [{"file_name": "screen4.png", "id": "1897576971139905", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491821081_1897576974473238_6012602603688686732_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qGmBeYvfr9sQ7kNvwFtPwSa&_nc_oc=Ado6ExuCRXYIgceJF90leWxZbZudKWPvNctQL3BXpJySnnFNiQ8ZiqUupErtfLXPTjw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCKd3Zq8vONXTrpVOy9IEevb59XTeOkZ8wL_bQVhgVPWQ&oe=6A5103FC"}, {"file_name": "screen5.png", "id": "1389821939428458", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491824322_1389821946095124_8207700636436265801_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j6UBKX_Sq-QQ7kNvwHtWrPD&_nc_oc=AdpIHXcDaBsXy0fsATb46ESHEhv3DvKeu-g815wq1gCGmr8LYl1w3IGyTtOIZWZ-7cc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCjx4Kiih5_37W-lUBD34zWOKzBTlaqiy__sS3U6cGQLg&oe=6A50E75E"}, {"file_name": "s1.png", "id": "318780111304792", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974776_318780117971458_2654408182135967797_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D3_MUmG-988Q7kNvwG-zXXr&_nc_oc=AdpjwtiqojkgSP9xozarrsPchHgbQu2treSN9hBaOWAkJtRgbWUBeYjw2D3of7fFpeg&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDES2GmHUUSNT6mPePf317hA4Weqfk3GqfTb5uRJlFYPw&oe=6A50E723"}, {"file_name": "s2.png", "id": "1120491249241440", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/57570301_1120491252574773_2492706531371093963_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v0K5KvkW6tMQ7kNvwHLh5wd&_nc_oc=Adrgi1yT_n_5_1OcsyfuSyb3iv4u27-iiRKWf5MJnTUDcLdqiMPHu4aRzqgEDseVEuI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDv231vnqntS8CNUcpKxZmwrxFu9j1_IAkpIGfKVXboPA&oe=6A50F404"}, {"file_name": "s4.png", "id": "437303129199364", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39035326_437303132532697_7909222666923155644_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zXA0mu0PVM0Q7kNvwEHAVJ1&_nc_oc=AdoGfkzPp_7b4e9IZOLf-fZjhwlksQ8mCTFvsuGD0G5wqnHeswOh5ftyaRlgoNr6tyA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBZxtrr20Cz3kVthryy5jzOJLaBBKwigq60hcR7O2a4Kg&oe=6A50E9DF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Airport 2560x1440.png", "id": "2332060143980366", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491818860_2332060150647032_12179299875644636_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Q8YcQR-pDwUQ7kNvwHAYxV-&_nc_oc=Adq2q2Bj25ynFcR90iQ9KJoKq2vQevfzoBsA7LCP005RNrTgUBWRrYps5HaxtVSuURI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAtadLQ5xdqcGGrnrqhsmZ-EeZXpOR1SQxaz0LPgo4k4g&oe=6A50E41F"}, "display_name": "I Am Security", "keywords": ["night", "club", "boxing", "airport", "security"], "long_description": "**SCAN AND CHECK**\n\nYour main task is to identify who can enter the club and who can't. Guests will line up, and you must decide if they are allowed in based on certain criteria. Some guests might try to sneak in with prohibited items, and it's up to you to find these hidden objects. Use a range of tools, like metal detectors and scanners, to inspect the guests and uncover anything suspicious.\n{423604820697059}\n\n**CLEAN THE VISITORS**\n\nClean the visitors, remove tattoos, and splash water!\n\n\n**MAKE FANCY HAIRCUTS**\n\nYou can make haircuts, shave, and even make the hair grow!\n\n**SELL AND BUY ITEMS**\n\nThe game offers a shop where you can buy new items and tools to make things more interesting. These upgrades will help you improve your security skills and make your job easier. With every level, the difficulty increases, and you\u2019ll encounter more complex scenarios and tougher decisions.\n{515449900947775}\n\n**HAVE FUN**\n\nUse a lot of fun and cool items, that you can use on the visitors and have fun!\n\"I Am Security\" is all about quick thinking and sharp attention to detail. Will you be able to spot the troublemakers and keep the club safe? Play now and find out!\n", "short_description": "Security\u2019s call, catch them all."}]}, "developer_name": null, "developer_privacy_policy_url": "https://newfolderstudio.com/privacy-policy/meta-en", "developer_terms_of_service_url": null, "publisher_name": "NEW FOLDER GAMES LTD", "support_website_url": null, "website_url": "https://newfolderstudio.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2710427532541308"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "34208463225405546"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491823837_1674657110229150_5564443658004678086_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1sRalyIt9uIQ7kNvwEmFi0i&_nc_oc=AdpQW2jp13JR5xeuIVxVD44PdkWAFkZZQbDOERitseoqztCFbJZjyDFMd5zaZAmiFHc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCgwZan9-TcUIipwce1efoLQb3XbvBPKH-VHldwyv_WwA&oe=
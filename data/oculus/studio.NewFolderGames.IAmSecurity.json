y 512 x 512 logo.png", "id": "781891947444822", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39003282_781891950778155_6625273941062104281_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hDkl6KNl8cUQ7kNvwHMxGwf&_nc_oc=AdoWBmdKKgXZitIAfrWPyXWJpcmmeESXJvVyzAZQgfvD0jmW-qZdIT62H1xukbyCC0A&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJPtctkBPLP_OvQvOoiOloB0wmFE_3PYAT5rdayDGedhQ&oe=6A99821A"}]}, "id": "3094825087368140", "locale": "en_US", "screenshots": [{"file_name": "screen4.png", "id": "1897576971139905", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491821081_1897576974473238_6012602603688686732_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F37SJryZXBQQ7kNvwHuHqch&_nc_oc=Adr3oH9qnIc8rJcGJRLKIxrcsiVDDdItnDX4_x3Qn8sdGSt9TK_-TjBCGR8S6YIwWgE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKqqFvR5DVrJqf05fRUA_hPDpl0G3OLRLFcJT5PhHoOhw&oe=6A99867C"}, {"file_name": "screen5.png", "id": "1389821939428458", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491824322_1389821946095124_8207700636436265801_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Cn3o2_tVeUUQ7kNvwFxskcz&_nc_oc=AdqwLStUNuIDsNFY-FDGUY-L1kUPN3f4u8Zmq6ioIerVvwY1V-62qPX_aAxO5hoeF-U&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLm2HawKH1uspBxrPudUjhIp0Jc5URY3qLaSb5pH0NLuw&oe=6A99A21E"}, {"file_name": "s1.png", "id": "318780111304792", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974776_318780117971458_2654408182135967797_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f_8vu6C0sAIQ7kNvwH9fR4v&_nc_oc=AdpqEVyYLerfoaWBTP_75PAuRyMT0r6kiHnBaZWIMARbKuLmttTPqkk0J92wzIOyhUQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLTMDaBr1UXZqDm7bennDTVdOvAMWbVNKZPnWtuFOdwwg&oe=6A99A1E3"}, {"file_name": "s2.png", "id": "1120491249241440", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/57570301_1120491252574773_2492706531371093963_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v0XHpxLdLkEQ7kNvwHBeAB-&_nc_oc=AdpeOD0k7n0HzecGeiwIMUBXtpjuVmzHZAvPvK4g44y_4JICcDJL0VwFrh22G8Zztzo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJIrYaGBsQsaSvR2fTC0JamW2bHYw-hRoexesR6DcLaSA&oe=6A997684"}, {"file_name": "s4.png", "id": "437303129199364", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39035326_437303132532697_7909222666923155644_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bYvIjgDZWaEQ7kNvwH4AKgy&_nc_oc=AdqrN5AlAWnUpJkTl3BQbSLOm_1vRzfjFW41fsGRBke9qs9YYN2x8Mfd6uALzTVJ2Zw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLH69FXT1_6dw9SvIq3URyZ0z36OUoxtakDqlGYibdzGA&oe=6A996C5F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Airport 2560x1440.png", "id": "2332060143980366", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491818860_2332060150647032_12179299875644636_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qR5KFzA-F8IQ7kNvwHp-pfM&_nc_oc=AdqrW9fXopH0UGC9rCsReM3ffQHAAjJ6gzDOmAdl_upzYVAvrJmR-oR25tMwLg70hkY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJKFeP2-4lAocenvkM1-x97YXsXTeydaWPyIvSbEnS2Qw&oe=6A999EDF"}, "display_name": "I Am Security", "keywords": ["night", "club", "boxing", "airport", "security"], "long_description": "**SCAN AND CHECK**\n\nYour main task is to identify who can enter the club and who can't. Guests will line up, and you must decide if they are allowed in based on certain criteria. Some guests might try to sneak in with prohibited items, and it's up to you to find these hidden objects. Use a range of tools, like metal detectors and scanners, to inspect the guests and uncover anything suspicious.\n{423604820697059}\n\n**CLEAN THE VISITORS**\n\nClean the visitors, remove tattoos, and splash water!\n\n\n**MAKE FANCY HAIRCUTS**\n\nYou can make haircuts, shave, and even make the hair grow!\n\n**SELL AND BUY ITEMS**\n\nThe game offers a shop where you can buy new items and tools to make things more interesting. These upgrades will help you improve your security skills and make your job easier. With every level, the difficulty increases, and you\u2019ll encounter more complex scenarios and tougher decisions.\n{515449900947775}\n\n**HAVE FUN**\n\nUse a lot of fun and cool items, that you can use on the visitors and have fun!\n\"I Am Security\" is all about quick thinking and sharp attention to detail. Will you be able to spot the troublemakers and keep the club safe? Play now and find out!\n", "short_description": "Security\u2019s call, catch them all."}]}, "developer_name": null, "developer_privacy_policy_url": "https://newfolderstudio.com/privacy-policy/meta-en", "developer_terms_of_service_url": null, "publisher_name": "NEW FOLDER GAMES LTD", "support_website_url": null, "website_url": "https://newfolderstudio.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2710427532541308"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "34208463225405546"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491823837_1674657110229150_5564443658004678086_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TAj8e7XFGqcQ7kNvwHINAvo&_nc_oc=AdonkaZWlbD_JtSvTiB900HRyX9rIo9b7VCoVZ4ikaFbjXDVv6IzOa-f2vS5ILFfyQ8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIEzx32dO0UsBv5LOYTMHwVTcu0iJgLtIipX925fkFD1w&oe=
y 512 x 512 logo.png", "id": "781891947444822", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/39003282_781891950778155_6625273941062104281_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PagE74QU63QQ7kNvwHTmwrw&_nc_oc=AdpYF7ZZ4q1YqjJA-cpoZZY-RLBExf85cr3liIiddpqaAwKMo_Jz8mfDKY0mjpvfg6g&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB9b1eToUfoOVyRCySEqTu7U54R87RS-29nNNvlYbEnFA&oe=6A56459A"}]}, "id": "3094825087368140", "locale": "en_US", "screenshots": [{"file_name": "screen4.png", "id": "1897576971139905", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/491821081_1897576974473238_6012602603688686732_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RkVf7yb0y4UQ7kNvwG7HxFJ&_nc_oc=Ado7UKT0pgGsSY02R6-3GT_m30jGTu92QPrWbjDRVcaqBN1n8sLlQHHfaAjnD6GXz74&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA03Q-LFRXEe3XveeYBQLH70WgmINeeCr-s55-4iUJAfg&oe=6A5649FC"}, {"file_name": "screen5.png", "id": "1389821939428458", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/491824322_1389821946095124_8207700636436265801_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WB4qIyBbPiUQ7kNvwHvzJT8&_nc_oc=AdrOMSmWrIMrksZrz1_r01a2DmuDh1QRxlZ1rr-ZLdYqAa0I_Ib-1NkwNPJlA7mfn3U&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAvQCah8U-ZGOb4t__11N1uTWKxUNK-uAS70S8SkJ_HdA&oe=6A562D5E"}, {"file_name": "s1.png", "id": "318780111304792", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/38974776_318780117971458_2654408182135967797_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LE7pTZhbyfgQ7kNvwGo8515&_nc_oc=AdqZ5tnQf1cNImOeh-xC580zLD8uRIyyeclUhwGYssJtOkrtpuEevEff-HOLBrr0ZEw&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBAPb9hQjGnb_VTkH1OjryoK-1mI7VtO94hPyccN297KQ&oe=6A562D23"}, {"file_name": "s2.png", "id": "1120491249241440", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/57570301_1120491252574773_2492706531371093963_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Vtp_DNBVkQYQ7kNvwFDwH9U&_nc_oc=AdpMuXiGUM7oRdJDrKIOiOEofZWXzpTifHxn8cY0qNv0cbieGIryiLm1ncMB3HkDAh8&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDl_yB0O5icmVws36g4pv35DPs2Y7Qk4oDqG-iTOHuM_g&oe=6A563A04"}, {"file_name": "s4.png", "id": "437303129199364", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/39035326_437303132532697_7909222666923155644_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pHOyYe8hl0QQ7kNvwEzdnbo&_nc_oc=AdrHOyoreUBxNOW6czCvAP_uljzYDbYUFnLsi3LINeNkXzTf9pLFueARWlK-kVkXRVU&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCv-8BFki3MOYLieHmC_Mmim2oqG5t3hUBw7CTaIbuj2w&oe=6A562FDF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Airport 2560x1440.png", "id": "2332060143980366", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/491818860_2332060150647032_12179299875644636_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FvRdnxmzTygQ7kNvwFKzSnM&_nc_oc=AdrLv-ZpG2KveZoXgs2rjFEm6zC_1egGgkOuaKGsbcjbaaXuIi8pZRtL0IrsXrOIk6U&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDmgvs_FRQyi4PGmHWKGK5_V6LBwcLhVqRroR802BfhQw&oe=6A562A1F"}, "display_name": "I Am Security", "keywords": ["night", "club", "boxing", "airport", "security"], "long_description": "**SCAN AND CHECK**\n\nYour main task is to identify who can enter the club and who can't. Guests will line up, and you must decide if they are allowed in based on certain criteria. Some guests might try to sneak in with prohibited items, and it's up to you to find these hidden objects. Use a range of tools, like metal detectors and scanners, to inspect the guests and uncover anything suspicious.\n{423604820697059}\n\n**CLEAN THE VISITORS**\n\nClean the visitors, remove tattoos, and splash water!\n\n\n**MAKE FANCY HAIRCUTS**\n\nYou can make haircuts, shave, and even make the hair grow!\n\n**SELL AND BUY ITEMS**\n\nThe game offers a shop where you can buy new items and tools to make things more interesting. These upgrades will help you improve your security skills and make your job easier. With every level, the difficulty increases, and you\u2019ll encounter more complex scenarios and tougher decisions.\n{515449900947775}\n\n**HAVE FUN**\n\nUse a lot of fun and cool items, that you can use on the visitors and have fun!\n\"I Am Security\" is all about quick thinking and sharp attention to detail. Will you be able to spot the troublemakers and keep the club safe? Play now and find out!\n", "short_description": "Security\u2019s call, catch them all."}]}, "developer_name": null, "developer_privacy_policy_url": "https://newfolderstudio.com/privacy-policy/meta-en", "developer_terms_of_service_url": null, "publisher_name": "NEW FOLDER GAMES LTD", "support_website_url": null, "website_url": "https://newfolderstudio.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2710427532541308"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "34208463225405546"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/491823837_1674657110229150_5564443658004678086_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=p08dRWqm2VsQ7kNvwFuDQm8&_nc_oc=Adr8P0kn8ct7oq1QLpwc8PGMDt1aDXW1lvc5_Um3sd8phRZ8-WiLk81YsEKr8I6cMH0&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAUkUp0Cpq5vI5gOQaVw9xjxL9mQtXlBYuRxPQLds2Low&oe=
81_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3aflnmk2rAEQ7kNvwFLeWIv&_nc_oc=AdkZ9mGkvqyKqrV2HFEVhFyXtT77saafPTZMnz3SL3oOoD68abkNsfhmgXhW4PF1fF4&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&oh=00_AfvHu3OpFU_Jv8HaYMZkUhRPGHWMoZ975acTpEHG0wdU6Q&oe=69A1A81A"}]}, "id": "3094825087368140", "locale": "en_US", "screenshots": [{"file_name": "screen4.png", "id": "1897576971139905", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/491821081_1897576974473238_6012602603688686732_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J2NFb7-JKYYQ7kNvwEH2SFA&_nc_oc=Adkz1i6cLkoFdav_MxN0C0m1HOgA5OGvkwC8X7PLYhuv8e2W1mcuVktXJwa8GX45QUw&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&oh=00_AfvcY1S80xNZeQ1sJWpkxoPn19dyrL4C2SIB01boSDIv4Q&oe=69A1AC7C"}, {"file_name": "screen5.png", "id": "1389821939428458", "uri": "https://scontent-hkg1-1.oculuscdn.com/v/t64.5771-25/491824322_1389821946095124_8207700636436265801_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1DWpPYgJR00Q7kNvwF2lNQD&_nc_oc=AdkdF5dYC3BG8PP8bCiHIT1_XKg8kUDGLZDp6vQY8-Ppx8HDfagzWZBAcLWXBZF5F9s&_nc_zt=3&_nc_ht=scontent-hkg1-1.oculuscdn.com&oh=00_Aft_Hl5MHphQmqZRZw4FlQF9D-8Dk9eyGymPu4KLUnWZsQ&oe=69A18FDE"}, {"file_name": "s1.png", "id": "318780111304792", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/38974776_318780117971458_2654408182135967797_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NJ3Jm9d2GDAQ7kNvwGKWmRm&_nc_oc=AdkB5-agmWq_5PK-4hR5Bs0Z4r8pVRdnZi1UrJxRAcY8SwDocqB_-7Yd8QOFbRDUBXo&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&oh=00_AfuUaYjXJvQVeNYtNx21h5H_MhmxTkK3xdwXf9-9do1Flw&oe=69A18FA3"}, {"file_name": "s2.png", "id": "1120491249241440", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/57570301_1120491252574773_2492706531371093963_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LJBuNqolycQQ7kNvwHxT-S4&_nc_oc=AdkMXs7ZzcluGUncX5rLw2Xz_kNzUhZyfOcBKXvGCeCRCUzN-vXnYdiVtOrWxZ3qow4&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&oh=00_AfspyktuFGUvbnp5V39rj0xTmLtcBsUSF6lhuoan4fx6Gw&oe=69A19C84"}, {"file_name": "s4.png", "id": "437303129199364", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/39035326_437303132532697_7909222666923155644_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aS8TT7GTKR8Q7kNvwE2txP7&_nc_oc=AdlD0kLeR0euYQoJ_-a3TvjO4rZ-2YKIyt59VNm82fbKf-zrgh_P75vI6wOTOGfVciE&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&oh=00_AftfpNCrSRyAs_rTR49o6MeLlYfowya65Q10q6_YAFCZZw&oe=69A1925F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Airport 2560x1440.png", "id": "2332060143980366", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/491818860_2332060150647032_12179299875644636_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o5GirxwUX4wQ7kNvwHtb3YM&_nc_oc=AdlqBx8bU4zzcJrzcqAtICdKOoEw5yaZyw8z20ei4-4S8tKYtZFAo8N9xwiWqxBFNIw&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&oh=00_Afurm_kf1SqvLFnoWfU6oRLjxhb2PVjg3sniUu4aPTlaKw&oe=69A18C9F"}, "display_name": "I Am Security", "keywords": ["night", "club", "boxing", "airport", "security"], "long_description": "**SCAN AND CHECK**\n\nYour main task is to identify who can enter the club and who can't. Guests will line up, and you must decide if they are allowed in based on certain criteria. Some guests might try to sneak in with prohibited items, and it's up to you to find these hidden objects. Use a range of tools, like metal detectors and scanners, to inspect the guests and uncover anything suspicious.\n{423604820697059}\n\n**CLEAN THE VISITORS**\n\nClean the visitors, remove tattoos, and splash water!\n\n\n**MAKE FANCY HAIRCUTS**\n\nYou can make haircuts, shave, and even make the hair grow!\n\n**SELL AND BUY ITEMS**\n\nThe game offers a shop where you can buy new items and tools to make things more interesting. These upgrades will help you improve your security skills and make your job easier. With every level, the difficulty increases, and you\u2019ll encounter more complex scenarios and tougher decisions.\n{515449900947775}\n\n**HAVE FUN**\n\nUse a lot of fun and cool items, that you can use on the visitors and have fun!\n\"I Am Security\" is all about quick thinking and sharp attention to detail. Will you be able to spot the troublemakers and keep the club safe? Play now and find out!\n", "short_description": "Security\u2019s call, catch them all."}]}, "developer_name": null, "developer_privacy_policy_url": "https://newfolderstudio.com/privacy-policy/meta-en", "developer_terms_of_service_url": null, "publisher_name": "NEW FOLDER GAMES LTD", "support_website_url": null, "website_url": "https://newfolderstudio.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2710427532541308"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "34208463225405546"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/491823837_1674657110229150_5564443658004678086_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Vv47e6vkY68Q7kNvwHK7pri&_nc_oc=AdnENFyjyDy-eeYRHfRCXBT7lN8o85wdQsQ_dFjjRcHkXj8KJxmRxAJEM1OnbxoIrYM&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&oh=00_AfueY5KRfAV94j6aY-m9SicbTE4ZK2VbS3NZwNr1cSv7xw&oe=69A1AB26"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "I Am Security", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Action", "id": "459781504968480"}, {"topi
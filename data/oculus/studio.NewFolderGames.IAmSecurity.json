c_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K1DllQV6YtMQ7kNvwFzTDqt&_nc_oc=AdpLNE5wLHYF2BGKECs3K1jfoXI4C26Y7EkIh-D7Ii-o0LS8a3OxyGr6AH2gy2nmWsw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCdozrwb8tC5VZtr8KqiaK2dFsE7Ucrv-350opnvSKD4w&oe=6A60C604"}, {"file_name": "s4.png", "id": "437303129199364", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39035326_437303132532697_7909222666923155644_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KM3e-N35gyAQ7kNvwHsSdli&_nc_oc=AdpsFjIBLv45sfUa_cYa93rlCqEVfsO1lTGI274dxMYTFq5P7h5bV6kA8HF1mXCuj38&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCPzBXuJVsE4haNuahVf8bEJ5QNTXre-UoYkfIojWvRCg&oe=6A60BBDF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Airport 2560x1440.png", "id": "2332060143980366", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491818860_2332060150647032_12179299875644636_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4ocTuUEXircQ7kNvwEBecan&_nc_oc=Ado74Uo0Qq8R_hz6T8wRdIFIoeIDshKEBKeQTQ9BPDLZeQ9AYZWJqAZiWZ2SrtLYkoc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDTU2p7zT0KHcho7tZpYuWkoQPESswj51v9Vmknl7-oLA&oe=6A60B61F"}, "display_name": "I Am Security", "keywords": ["night", "club", "boxing", "airport", "security"], "long_description": "**SCAN AND CHECK**\n\nYour main task is to identify who can enter the club and who can't. Guests will line up, and you must decide if they are allowed in based on certain criteria. Some guests might try to sneak in with prohibited items, and it's up to you to find these hidden objects. Use a range of tools, like metal detectors and scanners, to inspect the guests and uncover anything suspicious.\n{423604820697059}\n\n**CLEAN THE VISITORS**\n\nClean the visitors, remove tattoos, and splash water!\n\n\n**MAKE FANCY HAIRCUTS**\n\nYou can make haircuts, shave, and even make the hair grow!\n\n**SELL AND BUY ITEMS**\n\nThe game offers a shop where you can buy new items and tools to make things more interesting. These upgrades will help you improve your security skills and make your job easier. With every level, the difficulty increases, and you\u2019ll encounter more complex scenarios and tougher decisions.\n{515449900947775}\n\n**HAVE FUN**\n\nUse a lot of fun and cool items, that you can use on the visitors and have fun!\n\"I Am Security\" is all about quick thinking and sharp attention to detail. Will you be able to spot the troublemakers and keep the club safe? Play now and find out!\n", "short_description": "Security\u2019s call, catch them all."}]}, "developer_name": null, "developer_privacy_policy_url": "https://newfolderstudio.com/privacy-policy/meta-en", "developer_terms_of_service_url": null, "publisher_name": "NEW FOLDER GAMES LTD", "support_website_url": null, "website_url": "https://newfolderstudio.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2710427532541308"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "34208463225405546"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491823837_1674657110229150_5564443658004678086_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Tc0B6DrqOBsQ7kNvwH5dQds&_nc_oc=Adr6a_KvbWmD7nMOMcofkE3a2L_GqX58ALFNRumPw2J1gfNlWctnB85RwPMT65KKJMg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAjGpEm6wvGFfuIw7Ysqq_3lStbahSC5_u34AvmPwhhGQ&oe=
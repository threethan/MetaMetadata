81_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PLHTRUwS-ykQ7kNvwFsPKOr&_nc_oc=AdlaPT70GyLNydnJHRnAEF48TWqWHkVENiQTXzZnzy7EF26QNIwMpgielshl0WcaB3c&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AfsbobS0pRIpC9FaqospBkN0xhKIXIc_Fgqxf4Bq0WtYlQ&oe=699C621A"}]}, "id": "3094825087368140", "locale": "en_US", "screenshots": [{"file_name": "screen4.png", "id": "1897576971139905", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491821081_1897576974473238_6012602603688686732_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=41I7ynl7YwQQ7kNvwFxxxt1&_nc_oc=AdnThmH1cH2r86RImunU8rEVf_p9Yih0U7p5xxGTaLSWQax3FIKuK8iMAQ8CnYGUQ9A&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_Afvk0YUYYRC3TJi8EaZ-OCwga53CfwkhGnhKxxNaw09sQg&oe=699C667C"}, {"file_name": "screen5.png", "id": "1389821939428458", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491824322_1389821946095124_8207700636436265801_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m21PeNupVVYQ7kNvwFp5ST_&_nc_oc=AdnoNPejpFGovU5CcJLo6p4sPUiwnOkjde7H1pa0Sx3B-4maAvvjNM0aGxj73Bd_cnc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_Afs3l-rA7KM-1fWWPTDBEyJtTcgWB6h6j5XK4ZcDeahKag&oe=699C49DE"}, {"file_name": "s1.png", "id": "318780111304792", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974776_318780117971458_2654408182135967797_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zTK5uIR9KREQ7kNvwErd7fd&_nc_oc=AdlHs5DQbSOb6CUc4UTxZb687dpa89DjlZNwBQPtV5qSdrSm213epZb0VEMlJyCHR5I&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_Afs4wJZjTDBPoTBdsv-ZX-fatYfgFp8VeqR3yGwnnzKESA&oe=699C49A3"}, {"file_name": "s2.png", "id": "1120491249241440", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/57570301_1120491252574773_2492706531371093963_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O5vvtfCCZYMQ7kNvwHXPuyw&_nc_oc=Adm_6_cYsxOnxG2gi8vCT0nhqsjt6DuQp4VviSB--lufWvNBtZMyHzv6naIaCs1GIG8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_Aftsd-bIJLJ3eXrwzBefPSApFIF1SNHmnMI1d4PwG_2S2g&oe=699C5684"}, {"file_name": "s4.png", "id": "437303129199364", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39035326_437303132532697_7909222666923155644_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aYKkgbkA_7gQ7kNvwEKHRI-&_nc_oc=AdnrYVuRiH74udHaDCT3Rx7FHRX0290bFUq7cxwU9mVDKX0whjWKdj--3BARYIXGCR0&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_Aft3SLecre1J2xNgjfMOtx8pepMEbfAQjqqZFWYddLeKeQ&oe=699C4C5F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Airport 2560x1440.png", "id": "2332060143980366", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491818860_2332060150647032_12179299875644636_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zCRSV1CGwcMQ7kNvwHdeNKL&_nc_oc=AdnTOkmWwJuY3tbyvubVE6b0aUz2lqTNrlCEKwBc8RlqMTWrJoJknqA1KD1AObf7szM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AfuKuwO8KhawxvLqjNR8uRT13EDyRP21wFuqd1uroUpmOg&oe=699C469F"}, "display_name": "I Am Security", "keywords": ["night", "club", "boxing", "airport", "security"], "long_description": "**SCAN AND CHECK**\n\nYour main task is to identify who can enter the club and who can't. Guests will line up, and you must decide if they are allowed in based on certain criteria. Some guests might try to sneak in with prohibited items, and it's up to you to find these hidden objects. Use a range of tools, like metal detectors and scanners, to inspect the guests and uncover anything suspicious.\n{423604820697059}\n\n**CLEAN THE VISITORS**\n\nClean the visitors, remove tattoos, and splash water!\n\n\n**MAKE FANCY HAIRCUTS**\n\nYou can make haircuts, shave, and even make the hair grow!\n\n**SELL AND BUY ITEMS**\n\nThe game offers a shop where you can buy new items and tools to make things more interesting. These upgrades will help you improve your security skills and make your job easier. With every level, the difficulty increases, and you\u2019ll encounter more complex scenarios and tougher decisions.\n{515449900947775}\n\n**HAVE FUN**\n\nUse a lot of fun and cool items, that you can use on the visitors and have fun!\n\"I Am Security\" is all about quick thinking and sharp attention to detail. Will you be able to spot the troublemakers and keep the club safe? Play now and find out!\n", "short_description": "Security\u2019s call, catch them all."}]}, "developer_name": null, "developer_privacy_policy_url": "https://newfolderstudio.com/privacy-policy/meta-en", "developer_terms_of_service_url": null, "publisher_name": "NEW FOLDER GAMES LTD", "support_website_url": null, "website_url": "https://newfolderstudio.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2710427532541308"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "34208463225405546"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491823837_1674657110229150_5564443658004678086_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FVRJvF5T81kQ7kNvwH5OOEK&_nc_oc=AdnY-iqjGQVxkBdeZ81QuxHAs4FQ5pmGSMHVzHoXspQckHw-8BfB7dj-j28pBi6UPrM&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_Afun-WOjRCqkPU7kQXNvMwYq0zba61FjxJXx5rWyd-b8BA&oe=699C6526"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "I Am Security", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Action", "id": "459781504968480"}, {"topi
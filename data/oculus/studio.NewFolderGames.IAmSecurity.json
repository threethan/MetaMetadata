81_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PLHTRUwS-ykQ7kNvwH9tnof&_nc_oc=AdkKrxJQIszWb_e3Me1NK2wG2sva1zlpSI1qBTWvtELL7aUtWOm-czg4ecegYMotwAs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AftdHOlsJ7WCyT0pLcQA1Ssrx-MmwHbgADclcM358b4YYQ&oe=699DB39A"}]}, "id": "3094825087368140", "locale": "en_US", "screenshots": [{"file_name": "screen4.png", "id": "1897576971139905", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491821081_1897576974473238_6012602603688686732_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U8V0ta358xcQ7kNvwGAic6F&_nc_oc=AdnJv8eqIrUCQHJkHPuHWPkhucROxnfOTwIXZO2na1vdn8XXsA0u2kWcWybFi0TLtEs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfuTQ9xF-eLov82p8lr5d5cFqqJrOOJp3ANm8z3BfxkR8A&oe=699DB7FC"}, {"file_name": "screen5.png", "id": "1389821939428458", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491824322_1389821946095124_8207700636436265801_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m21PeNupVVYQ7kNvwHU_XAO&_nc_oc=AdkQ8Jkqwv4H_trvnvnrKvxohwecdh9yDhdWZbpNk6ntH7Rye523QOAts_tGGEXEuhA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfuAPYWmJXsNQuaJKO6vaIMdfi5wW6gtMIKO3y1wX_2WXA&oe=699D9B5E"}, {"file_name": "s1.png", "id": "318780111304792", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974776_318780117971458_2654408182135967797_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zONqk3OfsVsQ7kNvwEidb-j&_nc_oc=AdngKsKEoc7Ypzy5N382EdFjv0WU10JjVf5BCh8lCn6cZ7VQcqeSsTIVHzkEHgLahOw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Aft6oHhZm4bCAkHyt6QFQu-IlRmipWqOgsPlj9OnVgowpw&oe=699D9B23"}, {"file_name": "s2.png", "id": "1120491249241440", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/57570301_1120491252574773_2492706531371093963_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NaZKs9ZpBukQ7kNvwFISk_d&_nc_oc=AdnJbH717BGdn1_KzoxHVCAWa-MohRFSbb6QvXvQnQeAYzidNGR25GoR56oGlze9Umg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfthTYpI7Dw1QIfTAw5ATZ9mF2fqMg27GR-i_SVTILedlg&oe=699DA804"}, {"file_name": "s4.png", "id": "437303129199364", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39035326_437303132532697_7909222666923155644_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aYKkgbkA_7gQ7kNvwEOn5dH&_nc_oc=Adm_nWSeJRyWXDS_X--UPh1j7pLXRnAXbgpvYHmJn6ayPphq8dz8o4RwDvD7FqjK_Hs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afs-_nSIWaaeF19PlrvaWfGtOopU0c-7zHn48fltLvxoyw&oe=699D9DDF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Airport 2560x1440.png", "id": "2332060143980366", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491818860_2332060150647032_12179299875644636_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zCRSV1CGwcMQ7kNvwGkRPK2&_nc_oc=AdmX7LGLadj2oyhWcZNaAnww3NHa9wwAygRbZFyRTdMsyfManWCQ6KArEXqSb3ECWvA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afv-nVHTDruFSVoTPH5hrQWtciFxL3fNCT5N8HERmS1o8g&oe=699D981F"}, "display_name": "I Am Security", "keywords": ["night", "club", "boxing", "airport", "security"], "long_description": "**SCAN AND CHECK**\n\nYour main task is to identify who can enter the club and who can't. Guests will line up, and you must decide if they are allowed in based on certain criteria. Some guests might try to sneak in with prohibited items, and it's up to you to find these hidden objects. Use a range of tools, like metal detectors and scanners, to inspect the guests and uncover anything suspicious.\n{423604820697059}\n\n**CLEAN THE VISITORS**\n\nClean the visitors, remove tattoos, and splash water!\n\n\n**MAKE FANCY HAIRCUTS**\n\nYou can make haircuts, shave, and even make the hair grow!\n\n**SELL AND BUY ITEMS**\n\nThe game offers a shop where you can buy new items and tools to make things more interesting. These upgrades will help you improve your security skills and make your job easier. With every level, the difficulty increases, and you\u2019ll encounter more complex scenarios and tougher decisions.\n{515449900947775}\n\n**HAVE FUN**\n\nUse a lot of fun and cool items, that you can use on the visitors and have fun!\n\"I Am Security\" is all about quick thinking and sharp attention to detail. Will you be able to spot the troublemakers and keep the club safe? Play now and find out!\n", "short_description": "Security\u2019s call, catch them all."}]}, "developer_name": null, "developer_privacy_policy_url": "https://newfolderstudio.com/privacy-policy/meta-en", "developer_terms_of_service_url": null, "publisher_name": "NEW FOLDER GAMES LTD", "support_website_url": null, "website_url": "https://newfolderstudio.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2710427532541308"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "34208463225405546"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491823837_1674657110229150_5564443658004678086_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FVRJvF5T81kQ7kNvwEevLe7&_nc_oc=AdlS0na-o6cDC90iPxB4hG-C7WJgr7TB0u9xY0aLoJ8Gc3yy0qax8L33cPH3uhTydsw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfvkhiQ_O-yZhEY5HkliglBoIaZKHZ0X5WX8xKecHDBCLw&oe=699DB6A6"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "I Am Security", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Action", "id": "459781504968480"}, {"topi
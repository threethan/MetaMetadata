y 512 x 512 logo.png", "id": "781891947444822", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/39003282_781891950778155_6625273941062104281_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aSBYCE1hzYgQ7kNvwF3wXiu&_nc_oc=AdqJ451qxEZxQuliveJ9QcAcYgtYrnLAd5qOqWKLHyxRC_WkceTwJe2416WBoFVDo4M&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF32GlDhNfS5jxt9KFshB1WffgcirE1YddpTuBH8Jqyfw&oe=6A7D9A5A"}]}, "id": "3094825087368140", "locale": "en_US", "screenshots": [{"file_name": "screen4.png", "id": "1897576971139905", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/491821081_1897576974473238_6012602603688686732_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BipwPCwB52gQ7kNvwEpM5di&_nc_oc=Ado0haRQ116gEHD0KSfHW4lYq5371ZtNkpkw_u7Hv5rheCxjY0gxg7nAohCx9tKIVRQ&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHJm53YDmogSZIlv72_EiDcefuHaofxGRkTsBVh1nq81A&oe=6A7D9EBC"}, {"file_name": "screen5.png", "id": "1389821939428458", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/491824322_1389821946095124_8207700636436265801_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=egh9IHourkUQ7kNvwGhS78v&_nc_oc=AdoumOT8hNG4m0cb80rOiGeKPK08DbbKKpQGzDFHRFvQT2jLd4hpesO4YIGe4kYof7Q&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGDHSRawXqOGzEFfE10SIYPeAgKj-ZNDduWK2LLDondXg&oe=6A7DBA5E"}, {"file_name": "s1.png", "id": "318780111304792", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/38974776_318780117971458_2654408182135967797_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CjEQNjIkFL0Q7kNvwGvembA&_nc_oc=AdqOz9PJlhPDRs6_nCG836R6phwoWOAPi4DkFCs20V_8aWU-kbWrrrPcnT40PyvWV0M&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEw2cGqkjiqJEP0rTBhxwyqdxcbzV3TcyLxAvcMIS5mog&oe=6A7DBA23"}, {"file_name": "s2.png", "id": "1120491249241440", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/57570301_1120491252574773_2492706531371093963_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WmHA0gDDtoAQ7kNvwGXJeHY&_nc_oc=AdoNxw12cJWMSs0XWTA-a45F1YLj9LTL3-9GVeIhSRdDsaEtuiK8LY_IX2Kpl3o8uV8&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFO_bSlQRLY9KNnnKZ7PQ207caWMgoOu76HfAyjJ8xm6g&oe=6A7DC704"}, {"file_name": "s4.png", "id": "437303129199364", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/39035326_437303132532697_7909222666923155644_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8oWTIOEjbAIQ7kNvwHIWrGa&_nc_oc=Adr2Ysn0mFj3lDGcIX8E7SqiBTbuCyEtobpSZqanOUeCS1-Syakq_V-fkVbk4xQl2WQ&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGrISJz1y4iGDZfjJ2G-10yUsrqS1xBBhnZIUbr23Ioug&oe=6A7DBCDF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Airport 2560x1440.png", "id": "2332060143980366", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/491818860_2332060150647032_12179299875644636_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NRqSaVPn5skQ7kNvwGsRcg8&_nc_oc=Adpj5cG0k3oarApNYqaFao9s_TR1dlW7UssDTxoXZThj0WXEB2_cOCU2_QKDwWPhvMk&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEgTfUq4pNd2GXklounEUXT3GEvDleaP0AfjJXtSqI7QA&oe=6A7DB71F"}, "display_name": "I Am Security", "keywords": ["night", "club", "boxing", "airport", "security"], "long_description": "**SCAN AND CHECK**\n\nYour main task is to identify who can enter the club and who can't. Guests will line up, and you must decide if they are allowed in based on certain criteria. Some guests might try to sneak in with prohibited items, and it's up to you to find these hidden objects. Use a range of tools, like metal detectors and scanners, to inspect the guests and uncover anything suspicious.\n{423604820697059}\n\n**CLEAN THE VISITORS**\n\nClean the visitors, remove tattoos, and splash water!\n\n\n**MAKE FANCY HAIRCUTS**\n\nYou can make haircuts, shave, and even make the hair grow!\n\n**SELL AND BUY ITEMS**\n\nThe game offers a shop where you can buy new items and tools to make things more interesting. These upgrades will help you improve your security skills and make your job easier. With every level, the difficulty increases, and you\u2019ll encounter more complex scenarios and tougher decisions.\n{515449900947775}\n\n**HAVE FUN**\n\nUse a lot of fun and cool items, that you can use on the visitors and have fun!\n\"I Am Security\" is all about quick thinking and sharp attention to detail. Will you be able to spot the troublemakers and keep the club safe? Play now and find out!\n", "short_description": "Security\u2019s call, catch them all."}]}, "developer_name": null, "developer_privacy_policy_url": "https://newfolderstudio.com/privacy-policy/meta-en", "developer_terms_of_service_url": null, "publisher_name": "NEW FOLDER GAMES LTD", "support_website_url": null, "website_url": "https://newfolderstudio.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2710427532541308"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "34208463225405546"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/491823837_1674657110229150_5564443658004678086_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jJw-jP9wUGUQ7kNvwEMoE9s&_nc_oc=Adrqsy7H_Xcobo2QC6BNPHATX3wpY84mUdvfpx5pU2VnjKWVnSKJwY6IAfuiLUCdm2k&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE79SnIhUEnMI517zHbMDa_N5x1tfpZnSvQSP8B2G
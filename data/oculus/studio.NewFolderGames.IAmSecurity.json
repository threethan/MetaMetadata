y 512 x 512 logo.png", "id": "781891947444822", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39003282_781891950778155_6625273941062104281_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JWfcygMcagEQ7kNvwHZX8ub&_nc_oc=AdpbZL7PUAGC-z_3R3mp6WsSKklqlbRrwFfPWDMg_8hg7bOb-Ay2ekyEVup-o3I0ZpY&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAwBJaExIo3RPptOtQDTAmMxspm0U1mog6TBdhw_XQfHA&oe=6A68BA9A"}]}, "id": "3094825087368140", "locale": "en_US", "screenshots": [{"file_name": "screen4.png", "id": "1897576971139905", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491821081_1897576974473238_6012602603688686732_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EcUqY61EH8UQ7kNvwG4TzD-&_nc_oc=AdqTgKoel3zubw7MrnLXJpgn-XoYsyT7b0_WvhpafsFW_Dz-GV-a3zMsR6DopcHrsb4&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCqMtNbzShKts6u05PtkxR-N-48g5z0QciEJypVf05N4A&oe=6A68BEFC"}, {"file_name": "screen5.png", "id": "1389821939428458", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/491824322_1389821946095124_8207700636436265801_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7FBjPVSIZvcQ7kNvwFUKxaX&_nc_oc=AdqQZbT6RwDKID7pDPkWlpYRBN2bUsHyttPOctxzvuwiAmOnjsreINuaIKPdquX_EvI&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD4Y6tys-nLEJidxFNFVlqsywGO6jx9N9Qt9hi7aUIZIw&oe=6A68A25E"}, {"file_name": "s1.png", "id": "318780111304792", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974776_318780117971458_2654408182135967797_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qywnOI258PQQ7kNvwGdnAN2&_nc_oc=AdpOrLOe1efEjaSwbO0efuy6UWvzHHeRFguyl8bV1xVkARYhpgaRKmdzkIefjB9Y9Cw&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDNWRFMDbg03Qgla4ZwBQn8VfVvlamOR03KCg2-eLHPQg&oe=6A68A223"}, {"file_name": "s2.png", "id": "1120491249241440", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/57570301_1120491252574773_2492706531371093963_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OBqfAr9nB10Q7kNvwHNudMG&_nc_oc=AdpDhwosxRAQCZWJ4HHS8XQ2or6_LU5GuPd-yAhgDclI9Bjco8mdLn9PtbKByn9_uPE&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAzjsWVkpK3nROmODX8HIbsRuWYYCO5nwcmAbq5dgpfdg&oe=6A68AF04"}, {"file_name": "s4.png", "id": "437303129199364", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39035326_437303132532697_7909222666923155644_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Nb1KLhyZYDwQ7kNvwEwXVZd&_nc_oc=AdqX_sTGhyl4R9mAny7QGqEHqaGZeBlXgmXtTWFctKyyTgpBY6ta3l_JC65D7Zdx3QA&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCd83mS6bF6aw5XZ5ywbbA-ogDizmaoDSDplEFoCvfSMQ&oe=6A68A4DF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Airport 2560x1440.png", "id": "2332060143980366", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/491818860_2332060150647032_12179299875644636_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MMpxlCivCrAQ7kNvwFRhnBz&_nc_oc=AdpzRCB6R903z2qrHUjO8d4isAA4iGXL-B_dJ19jq8HcGfxiTLynXC28lEl6CEWtK0A&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBaJdKsjJ-fy_ClrKYSPt15-m6R0a3B4amVkwy06cAeIg&oe=6A689F1F"}, "display_name": "I Am Security", "keywords": ["night", "club", "boxing", "airport", "security"], "long_description": "**SCAN AND CHECK**\n\nYour main task is to identify who can enter the club and who can't. Guests will line up, and you must decide if they are allowed in based on certain criteria. Some guests might try to sneak in with prohibited items, and it's up to you to find these hidden objects. Use a range of tools, like metal detectors and scanners, to inspect the guests and uncover anything suspicious.\n{423604820697059}\n\n**CLEAN THE VISITORS**\n\nClean the visitors, remove tattoos, and splash water!\n\n\n**MAKE FANCY HAIRCUTS**\n\nYou can make haircuts, shave, and even make the hair grow!\n\n**SELL AND BUY ITEMS**\n\nThe game offers a shop where you can buy new items and tools to make things more interesting. These upgrades will help you improve your security skills and make your job easier. With every level, the difficulty increases, and you\u2019ll encounter more complex scenarios and tougher decisions.\n{515449900947775}\n\n**HAVE FUN**\n\nUse a lot of fun and cool items, that you can use on the visitors and have fun!\n\"I Am Security\" is all about quick thinking and sharp attention to detail. Will you be able to spot the troublemakers and keep the club safe? Play now and find out!\n", "short_description": "Security\u2019s call, catch them all."}]}, "developer_name": null, "developer_privacy_policy_url": "https://newfolderstudio.com/privacy-policy/meta-en", "developer_terms_of_service_url": null, "publisher_name": "NEW FOLDER GAMES LTD", "support_website_url": null, "website_url": "https://newfolderstudio.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2710427532541308"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "34208463225405546"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/491823837_1674657110229150_5564443658004678086_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qJ1Of43UrP0Q7kNvwHMXXd0&_nc_oc=AdoxIM35DRCfu6mvvl50uHfaVl9bneocKPjnDAMs-DU4R_cSq6sGFHyVY8NV5k9tqpo&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCB4XyjAXUiRIXK4jCtRCJ6I1DPyTzlv9oAnSJ5xOFJlQ&oe=
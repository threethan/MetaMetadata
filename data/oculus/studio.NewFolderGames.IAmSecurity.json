y 512 x 512 logo.png", "id": "781891947444822", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39003282_781891950778155_6625273941062104281_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VfOrUVt85RwQ7kNvwEoq6Ed&_nc_oc=AdroixvC3bha5vnmj3zq0zpfJqQzhU_i2xAiodBI-U6B7D5yl6PMockCV8QYfvMISjo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNxNRjgupkFqXiKIGOLu2bnGqApLHTOr8T1Bv0oue3VtQ&oe=6ABFBD9A"}]}, "id": "3094825087368140", "locale": "en_US", "screenshots": [{"file_name": "screen4.png", "id": "1897576971139905", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491821081_1897576974473238_6012602603688686732_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wGmlZ7kqzRYQ7kNvwEruwoY&_nc_oc=Adr1UYGqYTIIDerdRJoTdah4xL6kSIAgzS9Rm5zzGC9c9pgROocXa3qY3v-Xk5ZakQ4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMF_v51WOJCDQEHYXMgOtsZbY8eyhmJ-5zdqy6E-OJZcg&oe=6ABFC1FC"}, {"file_name": "screen5.png", "id": "1389821939428458", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491824322_1389821946095124_8207700636436265801_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WR0M9Xw-HNsQ7kNvwEjLiL4&_nc_oc=AdrAyKoS7avrjvA0bBPAeOrPqoGazNq5KJ1qcGs1aaEJSn8b7UAYRbEqnUnlnAzCvtU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPv_FdJi4B43L6-mduReUN05uwCZWMonGWBy3lo7lEI6A&oe=6ABFDD9E"}, {"file_name": "s1.png", "id": "318780111304792", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974776_318780117971458_2654408182135967797_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SVpVbwnossgQ7kNvwHoiJTv&_nc_oc=AdqRKcvaqP28xcu5Z1MMIeSMtE52apDkhg3cxRsWEouAiJ-S83eUtayEjxadk45145A&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM3Oxmu7166W9qUW9bnXNIkY4XoSNqqG6T-n23XtAMa3A&oe=6ABFDD63"}, {"file_name": "s2.png", "id": "1120491249241440", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/57570301_1120491252574773_2492706531371093963_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zoMfl7eXihAQ7kNvwFtH9Rz&_nc_oc=Adr1OnSIdQEzutaKE2XVxLPfrQFaBSfkxYOTevgC5h1W_zgpKKlwka_LORf3YgpwBh8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOtasjSEoGt7m7Gl8r8dNopEHngAy-4I71m0WRxfTkh8w&oe=6ABFB204"}, {"file_name": "s4.png", "id": "437303129199364", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39035326_437303132532697_7909222666923155644_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SidR6XdmbBcQ7kNvwFAv8mz&_nc_oc=Adp9GvINcRnujTLO-ZyGGdDxp6C6vKoRwyFHS59Gz7go2WNNrBlGBbunxe-FUlAOXvo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNto8YrX-QuIEHA28aHCKm7_ABnVLQGTVU-6iejBsbZFg&oe=6ABFE01F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Airport 2560x1440.png", "id": "2332060143980366", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491818860_2332060150647032_12179299875644636_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e8Dlsq9lAHYQ7kNvwHkLwG1&_nc_oc=AdpFaQ-qhNDb5pYB0OfVKskUMqZ07EVpQntOyt1YeCSM-LYSyMX76zJ1Xmz0OrqX5u0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNpgpwjGzfXyPbBi-stfZyZXhHsIxEF-VJIcdHHuEWgbA&oe=6ABFDA5F"}, "display_name": "I Am Security", "keywords": ["night", "club", "boxing", "airport", "security"], "long_description": "**SCAN AND CHECK**\n\nYour main task is to identify who can enter the club and who can't. Guests will line up, and you must decide if they are allowed in based on certain criteria. Some guests might try to sneak in with prohibited items, and it's up to you to find these hidden objects. Use a range of tools, like metal detectors and scanners, to inspect the guests and uncover anything suspicious.\n{423604820697059}\n\n**CLEAN THE VISITORS**\n\nClean the visitors, remove tattoos, and splash water!\n\n\n**MAKE FANCY HAIRCUTS**\n\nYou can make haircuts, shave, and even make the hair grow!\n\n**SELL AND BUY ITEMS**\n\nThe game offers a shop where you can buy new items and tools to make things more interesting. These upgrades will help you improve your security skills and make your job easier. With every level, the difficulty increases, and you\u2019ll encounter more complex scenarios and tougher decisions.\n{515449900947775}\n\n**HAVE FUN**\n\nUse a lot of fun and cool items, that you can use on the visitors and have fun!\n\"I Am Security\" is all about quick thinking and sharp attention to detail. Will you be able to spot the troublemakers and keep the club safe? Play now and find out!\n", "short_description": "Security\u2019s call, catch them all."}]}, "developer_name": null, "developer_privacy_policy_url": "https://newfolderstudio.com/privacy-policy/meta-en", "developer_terms_of_service_url": null, "publisher_name": "NEW FOLDER GAMES LTD", "support_website_url": null, "website_url": "https://newfolderstudio.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2710427532541308"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "34208463225405546"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491823837_1674657110229150_5564443658004678086_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7OG_et5evy8Q7kNvwErCrK0&_nc_oc=AdoVoCmie4QIhkyxtgfYZDTGtYdtblBHaCB3P-k98GHYUsqVIV8dvdfLBCTANu9Ynzc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOXVFQCwrRRuabhpn1GN0AkoJ4NCQvN0PxWiqj8JD4Y9Q&oe=
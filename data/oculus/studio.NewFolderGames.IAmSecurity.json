81_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3aflnmk2rAEQ7kNvwHeZqTN&_nc_oc=AdluHapI3p098oHK8WCr03OEjHZsXeeY12E2muwiY9ZOlHvv1oG0m6EEM85UXA_5u2o&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfurH-wt0BEsqwafO1EKSaRPSz676gABwh6k4Plwo8HB-Q&oe=69A0569A"}]}, "id": "3094825087368140", "locale": "en_US", "screenshots": [{"file_name": "screen4.png", "id": "1897576971139905", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491821081_1897576974473238_6012602603688686732_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U8V0ta358xcQ7kNvwHD-FJS&_nc_oc=AdmK7gDaVnIifFYNskqVbD54y5SJ9DXIGnvYveH0bvXw8VtQXzO2PUQaBhYZXm0pDKw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AftYOGOep5EpALYm7KWul5ni14eaGMtKkhbd0by1ThaXfg&oe=69A05AFC"}, {"file_name": "screen5.png", "id": "1389821939428458", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491824322_1389821946095124_8207700636436265801_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1DWpPYgJR00Q7kNvwEFJks6&_nc_oc=AdmHuEZB3D5WnOkkJ8suwbnGJhWys4Xo5mV8n7beu3Sjjlpls2njb4hAFO-C_Aea_3o&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfvQvD5EQdrXlUwPGnoQxt3y--wz3XO04Bk7To-nWv9fjw&oe=69A03E5E"}, {"file_name": "s1.png", "id": "318780111304792", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974776_318780117971458_2654408182135967797_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zONqk3OfsVsQ7kNvwEtZQvs&_nc_oc=AdmhcEVOs1e1CtDescCr6ueqWosOe35xfyb6wc266yK6XkdtMsPg5H1X5r91wMkCfcM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfuABhKWp9nO9Efz9EH67_fK0iWU0G2IFDySoKrq1r1_lw&oe=69A03E23"}, {"file_name": "s2.png", "id": "1120491249241440", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/57570301_1120491252574773_2492706531371093963_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NaZKs9ZpBukQ7kNvwExINGL&_nc_oc=AdmXWCR5qXn5BfvTiewIqW1v2x1U0rvStHwV1dBTvNOdSBZQOIJGEXULcZOpqPQ1mzo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AftAOt0aPepFG4R3kIgIWxKovoyo_tqhlrXTPk1cbcKnXA&oe=69A04B04"}, {"file_name": "s4.png", "id": "437303129199364", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39035326_437303132532697_7909222666923155644_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aS8TT7GTKR8Q7kNvwFrOcmY&_nc_oc=AdkWyTcbjIwdR786Uq3vK3etbJKx9UE2yQyBJZe5OkcfKj5bzWMK0BsYjLKOa-eCdNg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfsFMM-DGzfL0Sd-mDahWVL7k16i7ut2g0bgrtNTKyJ1SQ&oe=69A040DF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Airport 2560x1440.png", "id": "2332060143980366", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491818860_2332060150647032_12179299875644636_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o5GirxwUX4wQ7kNvwFlPlh1&_nc_oc=Adn84P20G01i-Wskj7yOdgsHvyKLpdzu0kCHvCJBMjNTQ1ofr6sy2ZqNlCPf4UaNmUE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfvgLGqSAewapRrRdLX4rI6_v_8Ok4-iNntOszujl45HOw&oe=69A03B1F"}, "display_name": "I Am Security", "keywords": ["night", "club", "boxing", "airport", "security"], "long_description": "**SCAN AND CHECK**\n\nYour main task is to identify who can enter the club and who can't. Guests will line up, and you must decide if they are allowed in based on certain criteria. Some guests might try to sneak in with prohibited items, and it's up to you to find these hidden objects. Use a range of tools, like metal detectors and scanners, to inspect the guests and uncover anything suspicious.\n{423604820697059}\n\n**CLEAN THE VISITORS**\n\nClean the visitors, remove tattoos, and splash water!\n\n\n**MAKE FANCY HAIRCUTS**\n\nYou can make haircuts, shave, and even make the hair grow!\n\n**SELL AND BUY ITEMS**\n\nThe game offers a shop where you can buy new items and tools to make things more interesting. These upgrades will help you improve your security skills and make your job easier. With every level, the difficulty increases, and you\u2019ll encounter more complex scenarios and tougher decisions.\n{515449900947775}\n\n**HAVE FUN**\n\nUse a lot of fun and cool items, that you can use on the visitors and have fun!\n\"I Am Security\" is all about quick thinking and sharp attention to detail. Will you be able to spot the troublemakers and keep the club safe? Play now and find out!\n", "short_description": "Security\u2019s call, catch them all."}]}, "developer_name": null, "developer_privacy_policy_url": "https://newfolderstudio.com/privacy-policy/meta-en", "developer_terms_of_service_url": null, "publisher_name": "NEW FOLDER GAMES LTD", "support_website_url": null, "website_url": "https://newfolderstudio.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2710427532541308"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "34208463225405546"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491823837_1674657110229150_5564443658004678086_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Vv47e6vkY68Q7kNvwHO0I-S&_nc_oc=AdnAx8lecLELXCK91n2Y-JE1VgyrG0L5B5NuQQqiNl6qX0tS5FohHos9Q8WxHs9Sb5c&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfsOpCQ95r8EBXxIzOD2DqGGzEgTY3eYzmhcsK3xct5lAw&oe=69A059A6"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "I Am Security", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Action", "id": "459781504968480"}, {"topi
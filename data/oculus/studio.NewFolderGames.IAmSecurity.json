y 512 x 512 logo.png", "id": "781891947444822", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/39003282_781891950778155_6625273941062104281_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HPvVyx9HDxYQ7kNvwHiFECq&_nc_oc=Adoh3SREj2FeZnqRDxuEjkjeoBu7ROJmsI6J1ICxmUvAuI-Z2qhbhsnr0aKeoofduYo&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9HHHpoNYBtLaBHviBI42Nr8v8mWWJafnvfOJO5uZAezQ&oe=6A39449A"}]}, "id": "3094825087368140", "locale": "en_US", "screenshots": [{"file_name": "screen4.png", "id": "1897576971139905", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/491821081_1897576974473238_6012602603688686732_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W917mJI5hgMQ7kNvwFGUIM5&_nc_oc=Adp5g_9UpicwpEiluvt4q7wmD6NDWEzng6HK09hQrSa0CiR-QcGwDGh_OAHlUVKBbqE&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af84M-lVrBBIfxiAxn7R8QjNTHHZzFGnk7ulaFFmHJZwCw&oe=6A3948FC"}, {"file_name": "screen5.png", "id": "1389821939428458", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/491824322_1389821946095124_8207700636436265801_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9yJ_IBetqpwQ7kNvwFp_hpa&_nc_oc=AdrOP5BtYw3KhlwKzgKAvfOBajK6jLD7IbVMBuNfwvanwkHS72SCBZi_vyDG4E_PEqo&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af92e1UMtIIMmA-Y_J3SpTD0vI-GNUb_mLnrtv4FDHosOw&oe=6A392C5E"}, {"file_name": "s1.png", "id": "318780111304792", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/38974776_318780117971458_2654408182135967797_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KlaG_rFUymwQ7kNvwE6_HKt&_nc_oc=AdqmD8Ie6Qxi30BuKkWW8KTb43aaPVD7-caNttybnANdYggpEUAfapsldWxia_5HaYw&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-u-cL6RG0RKqu4dMlxFVnj71wDW8s5ah87-LI_edcdZw&oe=6A392C23"}, {"file_name": "s2.png", "id": "1120491249241440", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/57570301_1120491252574773_2492706531371093963_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LSOtd5dfz-EQ7kNvwHAWxKX&_nc_oc=AdroojKWtH5ZaY1IKoTtEJOnP8eSC_Ul6CY8GULGpt16yNk2s90fl4v4UA6F2RDFpSQ&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-vORU72xdbGiLeQIrjSmxFLIM2qEp9xyukDUql2UJMaw&oe=6A393904"}, {"file_name": "s4.png", "id": "437303129199364", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/39035326_437303132532697_7909222666923155644_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JTiInd9rHBoQ7kNvwGh3ENr&_nc_oc=AdqJPMniEdj4qGVr7emBoC7Xd2iNeaMWnspyyK3hUnLMM4OKan6mzLIYlNvWFq86NhE&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8NOfH5bdvsFZExffe-LTdZYBXWYIXydgrkMmUtjR88pw&oe=6A392EDF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Airport 2560x1440.png", "id": "2332060143980366", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/491818860_2332060150647032_12179299875644636_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ye6WmG-4E-oQ7kNvwHwpQXR&_nc_oc=Adpmzgz23wEAyZH3QwmP58lO_y_7kD5T2R2sikG5-BDCpVePxUTpIL-UZLfhuOzqtEE&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_mLD5OENm0kM4-Ouht7aGyjfmOrLkR6sifEEhUdIs1MA&oe=6A39615F"}, "display_name": "I Am Security", "keywords": ["night", "club", "boxing", "airport", "security"], "long_description": "**SCAN AND CHECK**\n\nYour main task is to identify who can enter the club and who can't. Guests will line up, and you must decide if they are allowed in based on certain criteria. Some guests might try to sneak in with prohibited items, and it's up to you to find these hidden objects. Use a range of tools, like metal detectors and scanners, to inspect the guests and uncover anything suspicious.\n{423604820697059}\n\n**CLEAN THE VISITORS**\n\nClean the visitors, remove tattoos, and splash water!\n\n\n**MAKE FANCY HAIRCUTS**\n\nYou can make haircuts, shave, and even make the hair grow!\n\n**SELL AND BUY ITEMS**\n\nThe game offers a shop where you can buy new items and tools to make things more interesting. These upgrades will help you improve your security skills and make your job easier. With every level, the difficulty increases, and you\u2019ll encounter more complex scenarios and tougher decisions.\n{515449900947775}\n\n**HAVE FUN**\n\nUse a lot of fun and cool items, that you can use on the visitors and have fun!\n\"I Am Security\" is all about quick thinking and sharp attention to detail. Will you be able to spot the troublemakers and keep the club safe? Play now and find out!\n", "short_description": "Security\u2019s call, catch them all."}]}, "developer_name": null, "developer_privacy_policy_url": "https://newfolderstudio.com/privacy-policy/meta-en", "developer_terms_of_service_url": null, "publisher_name": "NEW FOLDER GAMES LTD", "support_website_url": null, "website_url": "https://newfolderstudio.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2710427532541308"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "34208463225405546"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/491823837_1674657110229150_5564443658004678086_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ryFsMmJIXgwQ7kNvwEIVsxF&_nc_oc=AdptwdQRz8UsSuqsnbuYPw3-_5L8v11I3qjusZ702Hcy1AC5g95tQ_JkQCx15uGh6kM&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-luMls6ALKEj1siDOwICQ87C9cQs7cI7A9RwNsW-
.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N8L9jQaw-TMQ7kNvwFg1v3q&_nc_oc=Adq_I3F4cCRaPBRVszkNSFTN6TyfQszFouBqMTlNXSHQ-6PvYMJ-23Viw2enl7lZxVk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQScGSc-rO-DclPyBSeG_SfyO-FXR2X2PsCJ0ytXMyDzrQ&oe=6AEA1160"}, {"file_name": "s4.png", "id": "437303129199364", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39035326_437303132532697_7909222666923155644_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sX1O1-Lp6AIQ7kNvwGDkW7M&_nc_oc=AdpKG48HhuP8brDLhEtR9Z3x0NMx3eaoUhPfv2wj1BK7yZ1OtiA3vjCwPgzYrz76SRs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSUSuJwaeSjc1kilNeYT_VSHHbW9uncE0jAqKRB4uA5pw&oe=6AEA101F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "I am sequrity 2560 x 1440.png", "id": "1398406160866186", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974689_1398406164199519_4655403560096238791_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ad8I6nmy7ggQ7kNvwHKrCvx&_nc_oc=AdrhNs-yKNdc1dwPeaXCh_JcXXgmHn1HIPjaaLEce_j_Pw8_DfsLKyomoXaPbsyjpUA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS5fnDdk3gE_z3kspSTFIIt9R6O0W3y73FJe5ADNyDn5Q&oe=6AE9E323"}, "display_name": "I Am Security", "keywords": [], "long_description": "EARLY ACCESS\n\nStep into the shoes of a club security guard in \"I Am Security,\" where your job is to keep the club safe and ensure only the right guests get inside. As a security guard, you\u2019ll face a variety of challenges that will test your observation and decision-making skills.\n\nYour main task is to identify who can enter the club and who can't. Guests will line up, and you must decide if they are allowed in based on certain criteria. Some guests might try to sneak in with prohibited items, and it's up to you to find these hidden objects. Use a range of tools, like metal detectors and scanners, to inspect the guests and uncover anything suspicious.\n\nTo make things more interesting, the game offers a shop where you can buy new items and tools. These upgrades will help you improve your security skills and make your job easier. With every level, the difficulty increases, and you\u2019ll encounter more complex scenarios and tougher decisions.\n\n\"I Am Security\" is all about quick thinking and sharp attention to detail. Will you be able to spot the troublemakers and keep the club safe? Play now and find out!", "short_description": "Security\u2019s call, catch them all."}]}, "developer_name": null, "developer_privacy_policy_url": "https://newfolderstudio.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "NEW FOLDER GAMES LTD", "support_website_url": null, "website_url": "https://newfolderstudio.com/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26261730430078905"}}]}, "scheduled_offers": {"count": 11, "nodes": [{"status": "PUBLISHED", "id": "1397575792214021"}, {"status": "PUBLISHED", "id": "1330651328986093"}, {"status": "PUBLISHED", "id": "711537507911518"}, {"status": "PUBLISHED", "id": "1372444560572762"}, {"status": "PUBLISHED", "id": "985814946758233"}, {"status": "PUBLISHED", "id": "546521821448237"}, {"status": "PUBLISHED", "id": "527555226431429"}, {"status": "PUBLISHED", "id": "443759852041147"}, {"status": "CANCELLED", "id": "976300467630456"}, {"status": "CANCELLED", "id": "348785128201479"}, {"status": "PUBLISHED", "id": "1838789666
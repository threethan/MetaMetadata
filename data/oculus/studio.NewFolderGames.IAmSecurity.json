y 512 x 512 logo.png", "id": "781891947444822", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/39003282_781891950778155_6625273941062104281_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l9eXjiKB5X0Q7kNvwHRWl35&_nc_oc=AdphTnoRAiCszdNEtTPbqIwbRmDeutgkAo5NvH1LPJUyq7beJvQkofN-LyznNcQKslk&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_PzRSIFMUHMF6yzYFS2FxNTAZ3_PtW5UPF6gjN3tgaZQ&oe=6A46739A"}]}, "id": "3094825087368140", "locale": "en_US", "screenshots": [{"file_name": "screen4.png", "id": "1897576971139905", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/491821081_1897576974473238_6012602603688686732_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rJAf4oKh1HoQ7kNvwHevu0n&_nc_oc=AdqnIFvuUXVmjcGAyMWq8q5xy7YSw2WOfAYcCPRlBVhRhUM3SA4AIOsPpTf_1H--RrY&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-vGYMRqiP6Hy58Gh2kG56L8cOL7mP8FSGB1op5FLt_dQ&oe=6A4677FC"}, {"file_name": "screen5.png", "id": "1389821939428458", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/491824322_1389821946095124_8207700636436265801_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A2i1qpgalikQ7kNvwHW4YS_&_nc_oc=Adp4HTBIS36w9otBjW8kV6t79nmwguoiyV18LjtnsGTmFMaBd838Zv4zEkhJXYkn7r4&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8dJFX4ImDJpJ-vedqJlW_cP30jaiJ6f3xfebX84cXt3w&oe=6A465B5E"}, {"file_name": "s1.png", "id": "318780111304792", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/38974776_318780117971458_2654408182135967797_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XYeovSHFUlAQ7kNvwEHd3pS&_nc_oc=AdodA_4ga--MQri0kxel98ZW9XkoPfUaWHoY7C363NXfzlIbALaZFhyLmeZjgBbq6Tw&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_AiAC58lpvtg8qhZ46EztEAdyV44Nug9GBGG44qtHS0A&oe=6A465B23"}, {"file_name": "s2.png", "id": "1120491249241440", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/57570301_1120491252574773_2492706531371093963_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YfgTR-5w9PcQ7kNvwG35RGm&_nc_oc=AdqW2t5NUNbtUExmeO4QICKRttHVDPZ5ag8BW26KEpT0WizyYxLi3CmgAf3qw7IVdoU&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-1lM2GnNPzu8tm87fL8G2dq04q5ktFBOP1TU3Wr9ZjPg&oe=6A466804"}, {"file_name": "s4.png", "id": "437303129199364", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/39035326_437303132532697_7909222666923155644_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5tH4QzIxWxUQ7kNvwEhSIQj&_nc_oc=AdrX6Gufko4fk7A1dJBXN3ro9cTwmBY-K5-zB59x4hB4zst0qp3yrPh1McG40k1m1-c&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8gvZPRYju6aWGoF8V3lyY4N83uzg2HCcQsa3nc6oa06A&oe=6A465DDF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Airport 2560x1440.png", "id": "2332060143980366", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/491818860_2332060150647032_12179299875644636_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Sj-SJTP-XcgQ7kNvwHg1bil&_nc_oc=AdqXaPVlksN1grlmhosvRBKZPXuORicvofha-aJg55erh8hZwme8tTK2f6l02NEvTCQ&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_LtwSkZtUJJQKYEfThC6r9Xg1cUIdzX6eHKzsx9oJLkw&oe=6A46905F"}, "display_name": "I Am Security", "keywords": ["night", "club", "boxing", "airport", "security"], "long_description": "**SCAN AND CHECK**\n\nYour main task is to identify who can enter the club and who can't. Guests will line up, and you must decide if they are allowed in based on certain criteria. Some guests might try to sneak in with prohibited items, and it's up to you to find these hidden objects. Use a range of tools, like metal detectors and scanners, to inspect the guests and uncover anything suspicious.\n{423604820697059}\n\n**CLEAN THE VISITORS**\n\nClean the visitors, remove tattoos, and splash water!\n\n\n**MAKE FANCY HAIRCUTS**\n\nYou can make haircuts, shave, and even make the hair grow!\n\n**SELL AND BUY ITEMS**\n\nThe game offers a shop where you can buy new items and tools to make things more interesting. These upgrades will help you improve your security skills and make your job easier. With every level, the difficulty increases, and you\u2019ll encounter more complex scenarios and tougher decisions.\n{515449900947775}\n\n**HAVE FUN**\n\nUse a lot of fun and cool items, that you can use on the visitors and have fun!\n\"I Am Security\" is all about quick thinking and sharp attention to detail. Will you be able to spot the troublemakers and keep the club safe? Play now and find out!\n", "short_description": "Security\u2019s call, catch them all."}]}, "developer_name": null, "developer_privacy_policy_url": "https://newfolderstudio.com/privacy-policy/meta-en", "developer_terms_of_service_url": null, "publisher_name": "NEW FOLDER GAMES LTD", "support_website_url": null, "website_url": "https://newfolderstudio.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2710427532541308"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "34208463225405546"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/491823837_1674657110229150_5564443658004678086_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gayA9CS_u4MQ7kNvwFbelYZ&_nc_oc=AdouBcOHJncYt33jv2H5C6siFz9vXuPmLJTM9B8m_gfd9HaL7zwnAow2tjn6AUWSqHA&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9_PAjJVRMsL_EBXRRXbW1Y5S2PmjUZg7YYAl7nq1
81_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EUJHaQy0lkMQ7kNvwEkfIQ3&_nc_oc=Adle1y_bfB9GKJyfdMzYB2BH7p70in2xrvhQXQ9MErZ98R7wkSzV4U9xxyc1po52AF8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfuAfNmxx0H9Pa5xHWS43iM36C9piaihHmbOmvtRf45fbg&oe=6999BF1A"}]}, "id": "3094825087368140", "locale": "en_US", "screenshots": [{"file_name": "screen4.png", "id": "1897576971139905", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491821081_1897576974473238_6012602603688686732_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=41I7ynl7YwQQ7kNvwEatxL8&_nc_oc=Adm4UCsNqAO7Uso9ncvWwK1po_ZV0f_XDisMpaKgZQGrdmFD-n-IMbBGjM45KvLZd0k&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfvwRGlYK_vOrChc-O6_Bt7YIFxK_wsCf6urNj6Kgb8KBg&oe=6999C37C"}, {"file_name": "screen5.png", "id": "1389821939428458", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491824322_1389821946095124_8207700636436265801_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZPhwEp8_NvsQ7kNvwGaaBwh&_nc_oc=AdkjJI6ml3ROzkcsdJSVUYd67bn1eLBCDhTAIOoODTqjnbzdmzYwYNWOvgjwcvPJM-Y&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afv13xxrEyx9qP8g_KB3OjZ23Gl6SOo1ka_udCZHky1AZQ&oe=6999A6DE"}, {"file_name": "s1.png", "id": "318780111304792", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974776_318780117971458_2654408182135967797_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zTK5uIR9KREQ7kNvwFINzil&_nc_oc=AdlpaEZ3MOuVKs7L-RC-CrCVPPsjf_Y_2_vgUbMRlJ4vzBLK1E9yrAkutef7Mi5ncJE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfvbgHegKCWwPqRR9TbaCjswRLpn7cWXAw9MvaC9xNUACw&oe=6999A6A3"}, {"file_name": "s2.png", "id": "1120491249241440", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/57570301_1120491252574773_2492706531371093963_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O5vvtfCCZYMQ7kNvwF32c-o&_nc_oc=AdmMrCEFYgiioRS2roCn3zO7gWSTFMpNgdfpfKK65jVqpramKHvWYdP2-UkXkeG9O1Q&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfuOSapgrRiuTwhGbK6byYBpgFGk_J77PZ4ekAYvOPdfxA&oe=6999B384"}, {"file_name": "s4.png", "id": "437303129199364", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39035326_437303132532697_7909222666923155644_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tAsRhZFHheYQ7kNvwH4G1H9&_nc_oc=AdlSECxlBglIZbJpt9lEm6S0P9B3rEwOiQ_dHVeD_Uv1D5rJeriJleJNrOaHAZGSD40&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfsmV7fwzH33Clj9E4nnj9YXuLkqI84SdsNOfKn5RWaxaQ&oe=6999A95F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Airport 2560x1440.png", "id": "2332060143980366", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491818860_2332060150647032_12179299875644636_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rrdOfGSpWnQQ7kNvwFJ0p1a&_nc_oc=Adkv7zIfPIURrm7mDtnyJcGVgekehL-hvdWvcOBCm_W8vu2OPRwwzPUQkoNS-c_tNLo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfuSQ2oicPEiD2vDY082VYqJNO7mSvPxFQ4VBZDh6DJ8wg&oe=6999A39F"}, "display_name": "I Am Security", "keywords": ["night", "club", "boxing", "airport", "security"], "long_description": "**SCAN AND CHECK**\n\nYour main task is to identify who can enter the club and who can't. Guests will line up, and you must decide if they are allowed in based on certain criteria. Some guests might try to sneak in with prohibited items, and it's up to you to find these hidden objects. Use a range of tools, like metal detectors and scanners, to inspect the guests and uncover anything suspicious.\n{423604820697059}\n\n**CLEAN THE VISITORS**\n\nClean the visitors, remove tattoos, and splash water!\n\n\n**MAKE FANCY HAIRCUTS**\n\nYou can make haircuts, shave, and even make the hair grow!\n\n**SELL AND BUY ITEMS**\n\nThe game offers a shop where you can buy new items and tools to make things more interesting. These upgrades will help you improve your security skills and make your job easier. With every level, the difficulty increases, and you\u2019ll encounter more complex scenarios and tougher decisions.\n{515449900947775}\n\n**HAVE FUN**\n\nUse a lot of fun and cool items, that you can use on the visitors and have fun!\n\"I Am Security\" is all about quick thinking and sharp attention to detail. Will you be able to spot the troublemakers and keep the club safe? Play now and find out!\n", "short_description": "Security\u2019s call, catch them all."}]}, "developer_name": null, "developer_privacy_policy_url": "https://newfolderstudio.com/privacy-policy/meta-en", "developer_terms_of_service_url": null, "publisher_name": "NEW FOLDER GAMES LTD", "support_website_url": null, "website_url": "https://newfolderstudio.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2710427532541308"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "34208463225405546"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491823837_1674657110229150_5564443658004678086_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=p7VSEUbWxcQQ7kNvwFkurj6&_nc_oc=AdnuJa2JyIx3rQnWwn8sWRf4VjudaBa3aXd-7P4GQu10WfsrC66B5e2LMOg-4_KLB14&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Aft7HPqhnkRUOCk5iZFSsGD_UyWPqEMLtv65s8oiSBZTOg&oe=6999C226"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "I Am Security", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Action", "id": "459781504968480"}, {"topi
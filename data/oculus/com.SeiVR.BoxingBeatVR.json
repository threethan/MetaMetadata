560x1440.png", "id": "1621467789661898", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/908839700_1621467792995231_4335402743175679300_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4vAYu0RwMrUQ7kNvwH6uK4D&_nc_oc=AdobbE-pzfkfZRe42j6sn8btFPCM0SqTYvifnpBF_7oublPJ0PAY5XSyTE4Y5lyVmIg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRGPMrCaMCpAP7O5tfWOTgK1a4QZvPds00cyg9LuSa0QA&oe=6B0C4F7B"}, {"file_name": "BoxingBeatVR_Screenshot_08_2560x1440.png", "id": "1658753692354805", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/908887025_1658753695688138_1174791313504115160_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TmKSDbstLDYQ7kNvwHqnxQh&_nc_oc=Ado71b-x-6CkUZzlszsPhOFYs3Xw2aFgXrBthmXDRgs9IauwaSDsxuUgtys3nYxWxvU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRIiDKCJ_Dr1ZbNZOBsrukSf7HLsWscokIcdyewTUtcCw&oe=6B0C7F14"}, {"file_name": "BoxingBeatVR_Screenshot_05_2560x1440.png", "id": "1446401180504992", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/908839681_1446401183838325_1607139906225628217_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hE5dzx36sG4Q7kNvwFwqLoM&_nc_oc=Adof5iyEzt3ZW5eVXxf5vtiUKyCUx1bOmojwRi9S1uwxXCHHAIaaq3qukoRD9p2UUt0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSzzeqwlwOozUldm_XkV48HsZhgWwJdBbbMznBbMZxxsQ&oe=6B0C7627"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BoxingBeatVR_Cover_Landscape_2560x1440.png", "id": "1172394781879081", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/908839690_1172394785212414_2543266327164439007_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xWR48BfFziIQ7kNvwHyXEFT&_nc_oc=Adqq4KknsqPOrV6adeztiULIkpMCMuAwHXca-FKaLIbHAxkAE2038Mx5L44N4ts-Whg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTH4j6wPF_mnAhmxR9vxJPIrLrhfoDKdPUyFFmXodZhxA&oe=6B0C71E1"}, "display_name": "Boxing Beat VR", "keywords": ["rhythm", "boxing", "fitness", "music", "workout"], "long_description": "Lace up your cybernetic gloves and fight to the beat in Boxing Beat VR \u2014 a high-energy VR rhythm boxing and fitness arcade built for Meta Quest.\n\nEvery jab, cross, hook, and uppercut hits in sync with hard-hitting trap and electronic beats. Match left cyan and right crimson targets as they race down the neon runway, trigger glowing shockwave bursts, and build unstoppable streaks to ignite Climax Overdrive!\n\nWHAT'S INSIDE:\n\u2022 Neon Rhythm Boxing Arena: Battle through 4 adrenaline-charged tracks (Trap Beat, Rhythmic Trap, Trap Drill, Aggressive Trap) across Easy, Medium, and Hard difficulties with escalating tempo and stage lighting.\n\u2022 Free VR Training Gym: Warm up and sharpen your form anytime with physics-driven Speed Bags, Pendulum Heavy Bags, and an interactive Boxing Arcade power-punch machine with live LED force scoring.\n\u2022 Smart Command Hub & Global Leaderboards: Track your Combat Rating (CR), beat your personal bests, and compete across Global, Around Me, and Friends leaderboards.\n\u2022 Interactive VR Tutorial: Master timing, stance, and punch angles in minutes\u2014perfect for both quick cardio sessions and high-score runs.\n\u2022 Play Your Way: Supports Seated, Standing, and Roomscale play with Meta Quest Touch Controllers and responsive haptic feedback.", "short_description": "Feel the bass in every punch! Step into a neon rhythm boxing arena on Meta Quest\u2014smash synced beat targets, unleash Climax Overdrive combos, test your punch power on the Boxing Arcade machine, and climb the Global Leaderboard."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/seivr/privacy", "developer_terms_of_service_url": null, "publisher_name": "Jone Sei", "support_website_url": null, "website_url": "https://sites.google.com/view/seivr/games", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_
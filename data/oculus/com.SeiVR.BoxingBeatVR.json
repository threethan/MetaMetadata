31_4335402743175679300_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HBj1u7Tsut8Q7kNvwGOIrN-&_nc_oc=AdoQJuVX64BsT9eKzmQGes8nGh0PaFVCEWtZaTONKppow0FBpQnMqXQp7av2ysMtt3E&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRqOMquVf0Th1RTsiIX7e-KuEZp7jAvCPvJHY1M6Vd4xg&oe=6B0B363B"}, {"file_name": "BoxingBeatVR_Screenshot_08_2560x1440.png", "id": "1658753692354805", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/908887025_1658753695688138_1174791313504115160_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TmKSDbstLDYQ7kNvwHD6ibw&_nc_oc=AdoOrQZZ8WJNVkIpfNe1heLI4PlKpw2Ia6zjbJMDnPVZCA0e8VsxYNCzZYLB2ap711Y&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSMWAIhK26d9B5l3GWIo2DXPAPnvsgMSjWSYkgyClpkcA&oe=6B0B2D94"}, {"file_name": "BoxingBeatVR_Screenshot_05_2560x1440.png", "id": "1446401180504992", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/908839681_1446401183838325_1607139906225628217_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hE5dzx36sG4Q7kNvwGoYtAd&_nc_oc=AdprX51BpyGNwjbAem-kuPuvmzi4Pz__jW4om4v-DnIc4HLtTMY6-30I6gKoMCcWjvY&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSwEjBLy5soPPR_tekp3cNla0qFFYO25wAiaWT9vlzo1w&oe=6B0B24A7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BoxingBeatVR_Cover_Landscape_2560x1440.png", "id": "1172394781879081", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/908839690_1172394785212414_2543266327164439007_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XsSiUinJat4Q7kNvwGZovf2&_nc_oc=Adqb-zKx2q_Ab1ZjRkgDFSnpf0xe1h-Pziv3T48gyNgJxz7ojnQj31t7s818_iEk0nU&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQT5ww7bsntzH_-AkrGMc6Aa4L4XBmASPvI8TCUj-1enMA&oe=6B0B2061"}, "display_name": "Boxing Beat VR", "keywords": ["rhythm", "boxing", "fitness", "music", "workout"], "long_description": "Lace up your cybernetic gloves and fight to the beat in Boxing Beat VR \u2014 a high-energy VR rhythm boxing and fitness arcade built for Meta Quest.\n\nEvery jab, cross, hook, and uppercut hits in sync with hard-hitting trap and electronic beats. Match left cyan and right crimson targets as they race down the neon runway, trigger glowing shockwave bursts, and build unstoppable streaks to ignite Climax Overdrive!\n\nWHAT'S INSIDE:\n\u2022 Neon Rhythm Boxing Arena: Battle through 4 adrenaline-charged tracks (Trap Beat, Rhythmic Trap, Trap Drill, Aggressive Trap) across Easy, Medium, and Hard difficulties with escalating tempo and stage lighting.\n\u2022 Free VR Training Gym: Warm up and sharpen your form anytime with physics-driven Speed Bags, Pendulum Heavy Bags, and an interactive Boxing Arcade power-punch machine with live LED force scoring.\n\u2022 Smart Command Hub & Global Leaderboards: Track your Combat Rating (CR), beat your personal bests, and compete across Global, Around Me, and Friends leaderboards.\n\u2022 Interactive VR Tutorial: Master timing, stance, and punch angles in minutes\u2014perfect for both quick cardio sessions and high-score runs.\n\u2022 Play Your Way: Supports Seated, Standing, and Roomscale play with Meta Quest Touch Controllers and responsive haptic feedback.", "short_description": "Feel the bass in every punch! Step into a neon rhythm boxing arena on Meta Quest\u2014smash synced beat targets, unleash Climax Overdrive combos, test your punch power on the Boxing Arcade machine, and climb the Global Leaderboard."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/seivr/privacy", "developer_terms_of_service_url": null, "publisher_name": "Jone Sei", "support_website_url": null, "website_url": "https://sites.google.com/view/seivr/games", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286
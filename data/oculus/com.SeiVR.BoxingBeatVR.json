hGJnRSe0MQ2JtgjUV0xg&oe=6B0DBE99"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "LANSCAPE.png", "id": "4115156435432634", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473393771_4115156438765967_2701576754759248569_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cYskzuDcE4EQ7kNvwGrbp14&_nc_oc=AdpDuRAAVDuM_AqwCfliB6fw6EOEEpzEVyE8zRuHMTyMU0ImmOXbvWq9zsL4UaOZIxQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTa3QOvInF4prrvPbFZj4gbH-k3dXjmT-_nH_2HX6ygDQ&oe=6B0D9C32"}, "display_name": "Boxing Beat VR", "keywords": ["VRBoxingGame", "RhythmBoxing", "VirtualRealityFitness", "MusicBoxing", "InteractiveWorkout"], "long_description": "\ud83e\udd4a Boxing Beat VR \ud83c\udfb6\n\nWelcome to Boxing Beat VR, an immersive virtual reality experience that fuses the intensity of boxing with the pulsating energy of music!\n\n   Key Features:\n\n   Rhythmic Boxing Gameplay: Engage in dynamic boxing sessions where each punch, dodge, and move aligns with the beat, creating a seamless blend of music and motion.\n\n   Variety of Tracks and Levels: Choose from a wide selection of songs across multiple genres, each offering unique challenges and difficulty levels, catering to both newcomers and seasoned fighters.\n\nFitness and Fun Combined: Experience a full-body workout that doesn't feel like exercise. Improve your fitness and reflexes while enjoying an exhilarating gaming session.\n\n   Stunning Visuals and Immersive Sound: Dive into vibrant environments with high-quality graphics and immersive soundscapes that keep you engaged and motivated.\n\n   Gear up, feel the rhythm, and let your fists fly in Boxing Beat VR\u2014where every punch is a step closer to mastering the beat!", "short_description": "\ud83e\udd4a Boxing Beat VR \ud83c\udfb6\n\nStep into the ring where rhythm meets boxing! In Boxing Beat VR, punch to the beat, tackle diverse tracks, and rise through challenging levels to become the ultimate rhythm boxing champion."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/seivr/privacy", "developer_terms_of_service_url": null, "publisher_name": "Jone Sei", "support_website_url": null, "website_url": "https://sites.google.com/view/seivr/games", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2710427532541308"}, {"id": "1672577396871977"}, {"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9624941060884764"}}]}, "scheduled_offers": {"count": 11, "nodes": [{"status": "PUBLISHED", "id": "2782486568835911"}, {"status": "PUBLISHED", "id": "1069700318997891"}, {"status": "PUBLISHED", "id": "2351448902014021"}, {"status": "PUBLISHED", "id": "3229989480507424"}, {"status": "PUBLISHED", "id": "824031203865067"}, {"status": "PUBLISHED", "id": "1338805877516448"}, {"status": "PUBLISHED", "id": "1394634695627245"}, {"status": "PUBLISHED", "id": "1891264824786746"}, {"status": "PUBLISHED", "id": "834931632537772"}, {"status": "PUBLISHED", "id": "766892072620193"}, {"status": "PUBLISHED", "id": "1212097473812164"}]}, "baseline_offer": {"id": "2782486568835911"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1795480920, "status": "PUBLISHED", "id": "2782486568835911"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "29554115320874043", "version": "0.6"}, "id": "207
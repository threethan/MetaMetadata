&_nc_ss=7f30f&oh=00_AQRDhHyvGZMtRiCAVzcQv1zsTM2am3AHlxDNfMucd591mQ&oe=6B0D9D96"}, {"file_name": "BoxingBeatVR_Screenshot_02_2560x1440.png", "id": "1621467789661898", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/908839700_1621467792995231_4335402743175679300_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4vAYu0RwMrUQ7kNvwHBG69p&_nc_oc=AdownJphUu06HS4eMmPs188hS1ePXEjqbn1Ke26TQOf5zJCFCRSwsCVYrlZMcU_hDMM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTbxOQrFjEu2-Tdil1YMlAuQTJmRgnerN0lDB1KcEKDOg&oe=6B0DA0FB"}, {"file_name": "BoxingBeatVR_Screenshot_08_2560x1440.png", "id": "1658753692354805", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/908887025_1658753695688138_1174791313504115160_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TmKSDbstLDYQ7kNvwGuF8JD&_nc_oc=AdrKXoz9pltd46XUrntRws489MgTvNuVGMNjkAl2tFa1uKOcP7MxbOity8YqeQuxVG0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTZ0qxL6MJxCzQwKj6tZguOYRvUDlKX_lXoIw1PhOnvjg&oe=6B0DD094"}, {"file_name": "BoxingBeatVR_Screenshot_05_2560x1440.png", "id": "1446401180504992", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/908839681_1446401183838325_1607139906225628217_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hE5dzx36sG4Q7kNvwFuueOI&_nc_oc=Ado_MxBk95oj0j9y2CXoib0H-lOZRGSt9vpflP1vNyCvV-pVXfCOY9YrQNJDm8e8zsc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQFUgs4SgdwDDnKhgOgyz-7epZbj3BboHAE5MGvgXMrJA&oe=6B0DC7A7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BoxingBeatVR_Cover_Landscape_2560x1440.png", "id": "1172394781879081", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/908839690_1172394785212414_2543266327164439007_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xWR48BfFziIQ7kNvwG7t65q&_nc_oc=AdoYpWLPievHNS7ik9FwWKZZnE1JjKIHLHGh_5fF8ZexdTY53Ka__YgKnpy2OYQRYWA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTuI-wVCP0JZI_rK-Ht9CHehufxd9yVg_TKmtM61ZHGlQ&oe=6B0DC361"}, "display_name": "Boxing Beat VR", "keywords": ["rhythm", "boxing", "fitness", "music", "workout"], "long_description": "Lace up your cybernetic gloves and fight to the beat in Boxing Beat VR \u2014 a high-energy VR rhythm boxing and fitness arcade built for Meta Quest.\n\nEvery jab, cross, hook, and uppercut hits in sync with hard-hitting trap and electronic beats. Match left cyan and right crimson targets as they race down the neon runway, trigger glowing shockwave bursts, and build unstoppable streaks to ignite Climax Overdrive!\n\nWHAT'S INSIDE:\n\u2022 Neon Rhythm Boxing Arena: Battle through 4 adrenaline-charged tracks (Trap Beat, Rhythmic Trap, Trap Drill, Aggressive Trap) across Easy, Medium, and Hard difficulties with escalating tempo and stage lighting.\n\u2022 Free VR Training Gym: Warm up and sharpen your form anytime with physics-driven Speed Bags, Pendulum Heavy Bags, and an interactive Boxing Arcade power-punch machine with live LED force scoring.\n\u2022 Smart Command Hub & Global Leaderboards: Track your Combat Rating (CR), beat your personal bests, and compete across Global, Around Me, and Friends leaderboards.\n\u2022 Interactive VR Tutorial: Master timing, stance, and punch angles in minutes\u2014perfect for both quick cardio sessions and high-score runs.\n\u2022 Play Your Way: Supports Seated, Standing, and Roomscale play with Meta Quest Touch Controllers and responsive haptic feedback.", "short_description": "Feel the bass in every punch! Step into a neon rhythm boxing arena on Meta Quest\u2014smash synced beat targets, unleash Climax Overdrive combos, test your punch power on the Boxing Arcade machine, and climb the Global Leaderboard."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/seivr/privacy", "developer_terms_of_service_url": null, "publisher_name": "Jone Sei", "support_website_url": null, "web
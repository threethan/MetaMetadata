EPnRfIsO3kQ7kNvwEAIglI&_nc_oc=Adr44rU0Bxaez9ZZSDYnLpB2vIfk58nzsPWi4W1SGSCUpjm8U9lPw6f_t1fcYk_Rsuc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQAipI1kA4AUyiBlxZN0BgAKoW3RDxBGGdjKgwP3wFxtg&oe=6AF49B5D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "IMG_3591.png", "id": "686069001012634", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491820354_686069004345967_4018849721252894990_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y91cHKH_RWgQ7kNvwFnZ7Jh&_nc_oc=AdoqpTkxr0tOV6cNusmV_tmOuj14YQp6DFKH8e19BdwD1wsuMyKJ_-WD1YLPFAQ7sUY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRT6NQSuRxgXB7xv4G4RbdE-VxzuDSXbSbof2lFHKcNkw&oe=6AF4937A"}, "display_name": "Trouble In Paradise VR", "keywords": ["platformer", "fighting", "action"], "long_description": "Can you handle a grand adventure of 26 levels, increasing difficulty and NO CHECKPOINTS?! If so\u2026\n\nThere is TROUBLE IN PARADISE!\n\nTrouble in paradise takes place in the tropical town of North Beach Village where Chico and his townspeople are just having a normal day in the Barrio when suddenly, it has been taken over by Captain Jefe! His henchmen quickly take over the village and surrounding cities! It\u2019s up to Chico and his awesome crew of awesome homies to defend the town and nearby cities with his Mighty Bat!", "short_description": "Dive into an unforgiving adventure where you unlock characters, control vehicles, and master your weapons. Solve puzzles, relax by beaches, and shop at local markets. Collect 'kilos\u2019 for snacks. Enjoy retro visuals, hand-drawn cutscenes with amateur voiceovers, and a groovy original soundtrack."}]}, "developer_name": null, "developer_privacy_policy_url": "https://vistalargagames.straw.page/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Vista Larga Games", "support_website_url": null, "website_url": "https://vistalargagames.straw.page/", "category": null, "comfort_rating": "COMFORTA
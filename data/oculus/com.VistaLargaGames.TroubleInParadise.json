ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-7hlqxiOSnXImvoUw8qYIblX8ebIJzXVR5yRFIYgtArQ&oe=6A465D1D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "IMG_3591.png", "id": "686069001012634", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/491820354_686069004345967_4018849721252894990_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iu6tVcz-NgoQ7kNvwGtI9HL&_nc_oc=AdoXDQGVkOANNMIjUFjz_0uiUFWGRGfSPA9ddouVI2e0gWrozchGldgWPvtbfc_2cXE&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9CrAUJG38aftJdLYN0YLskUr2bxD3MBhmgL3_CuRuSig&oe=6A468D7A"}, "display_name": "Trouble In Paradise VR", "keywords": ["platformer", "fighting", "action"], "long_description": "Can you handle a grand adventure of 26 levels, increasing difficulty and NO CHECKPOINTS?! If so\u2026\n\nThere is TROUBLE IN PARADISE!\n\nTrouble in paradise takes place in the tropical town of North Beach Village where Chico and his townspeople are just having a normal day in the Barrio when suddenly, it has been taken over by Captain Jefe! His henchmen quickly take over the village and surrounding cities! It\u2019s up to Chico and his awesome crew of awesome homies to defend the town and nearby cities with his Mighty Bat!", "short_description": "Dive into an unforgiving adventure where you unlock characters, control vehicles, and master your weapons. Solve puzzles, relax by beaches, and shop at local markets. Collect 'kilos\u2019 for snacks. Enjoy retro visuals, hand-drawn cutscenes with amateur voiceovers, and a groovy original soundtrack."}]}, "developer_name": null, "developer_privacy_policy_url": "https://vistalargagames.straw.page/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Vista Larga Games", "support_website_url": null, "website_url": "https://vistalargagames.straw.page/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"
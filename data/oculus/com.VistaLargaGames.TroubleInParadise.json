5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQFndQ3ingtOF7ID9_awVJFDhOp0pAssQ_O_VeDO83yqg&oe=6AFF066E"}, {"file_name": "IMG_3577.png", "id": "1049262626620297", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491824081_1049262629953630_7118617558976124031_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sgPsAZ-WnyoQ7kNvwH7vyhB&_nc_oc=Adp9C0DgQgRFlSikka64s0v_HMOWXjdDcJ6uqQ_cEA17m53irXkBUX2cZmsAqjQ8ltk&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSNjVNv5ug_EKSb4S9eTECnq0_zQxVYigzjkLMldJRnJQ&oe=6AFF275D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "IMG_3591.png", "id": "686069001012634", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491820354_686069004345967_4018849721252894990_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TlKEBeZZ8vYQ7kNvwEDapXv&_nc_oc=Adr-bEA-KYlNsRCN9URfNY0IQL7YIpUOB6RiTY__iqlSidtqimQEtQZjbn1KLAW-S2U&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQN95IZFcwKK2-Gdry-WeG5X2nFGx5927I7k1q-QRHW6A&oe=6AFF1F7A"}, "display_name": "Trouble In Paradise VR", "keywords": ["platformer", "fighting", "action"], "long_description": "Can you handle a grand adventure of 26 levels, increasing difficulty and NO CHECKPOINTS?! If so\u2026\n\nThere is TROUBLE IN PARADISE!\n\nTrouble in paradise takes place in the tropical town of North Beach Village where Chico and his townspeople are just having a normal day in the Barrio when suddenly, it has been taken over by Captain Jefe! His henchmen quickly take over the village and surrounding cities! It\u2019s up to Chico and his awesome crew of awesome homies to defend the town and nearby cities with his Mighty Bat!", "short_description": "Dive into an unforgiving adventure where you unlock characters, control vehicles, and master your weapons. Solve puzzles, relax by beaches, and shop at local markets. Collect 'kilos\u2019 for snacks. Enjoy retro visuals, hand-drawn cutscenes with amateur voiceovers, and a groovy original soundtrack."}]}, "developer_name": null, "developer_privacy_policy_url": "https://vistalargagames.straw.page/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Vista Larga Games", "support_website_url": null, "website_url": "https://vistalargagames.straw.page/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "528142316460358"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "30490007513916337"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PUBLISHED", "id": "2063862747757076"}, {"status": "PUBLISHED", "id": "958395069645595"}]}, "baseline_offer": {"id": "2063862747757076"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1762427460, "status": "PUBLISHED", "id": "2063862747757076"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "31013151344935282", "version": "1.0"}, "id": "1221214882839224", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "30464729643110791", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "31013151344935282"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1221214882839224"}]},
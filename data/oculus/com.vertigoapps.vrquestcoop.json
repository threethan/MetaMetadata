s=7f30f&oh=00_AQTyzG1qpJR1f5oI9h7-KiZEWVj-1jNNH9wiDR7LCVVGKQ&oe=6B0DD0FE"}, {"file_name": "captura 4.png", "id": "1147372207692436", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499312338_1147372211025769_2627418799408822735_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YPjUAKl9z5gQ7kNvwERydvE&_nc_oc=Adq2eKYwHAOAvjEHd2waoKbLpl955QBcztKy4SyGPjubjj3-b6cYNLYMQwEg94GkOOA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQ7FLk9UYjEPz8nQ0HXEfriqHxdki-kUqru2hsOe0fEEA&oe=6B0DA6B7"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Vertigo Zombies", "keywords": ["zombie", "survival", "horror", "shooter", "halloween"], "long_description": "VERTIGO ZOMBIE is a VR zombie survival shooter for up to 4 players in the same room. No internet, no accounts: put all headsets on the same Wi-Fi and play.\n\n2 game modes: realistic and simplified, to cater to different types of players. Also includes a left-handed/right-handed option.\n\nEach match is 5 minutes of pure tension. A horde of zombies \u2014walkers, runners, tanks and throwers\u2014 assaults an abandoned factory. Your mission: survive.\n\n- 4 zombie types with distinct behaviors: tanks soak up bullets, throwers lob dodgeable projectiles.\n- Headshots: +100 points and a credit bonus.\n- Credit economy: every kill pays out. Spend on medkits (+50 HP) or upgrade your pistol through 3 levels (2 \u2192 3 \u2192 5 shots/sec, more damage, bigger rounds).\n- Grenades: throw them with an arm gesture.\n- Wrist upgrade menu: glance at your watch and buy without putting down your weapon.\n- Procedural arena: an abandoned factory with flickering, dying lights.\n\nTrue local co-op: up to 4 headsets (Quest 2 and Quest 3) in one room, each with its own avatar, hands and weapon. The host creates the room and shares a 3-digit code; the rest join in seconds.\n\nNo microtransactions, no ads, no data collection. A one-time-purchase experience built to play with friends.", "short_description": "4-player local co-op VR zombie survival. Survive 5-minute waves in an abandoned factory: shoot, upgrade your weapon, hold the line."}]}, "developer_name": null, "developer_privacy_policy_url": "https://vertigoapps.com/privacidad.html", "developer_terms_of_service_url": null, "publisher_name": "V\u00e9rtigo Apps", "support_website_url": "https://vertigoapps.com/", "website_url": "https://vertigoapps.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}, {"id": "644354873106712"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["es", "es_AR", "es_CL", "es_CO", "es_MX", "es_PE", "es_PR", "es_VE"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "CO_OP", "MULTI_USER"], "id": "1419850691220443"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/908771306_2063474954169644_3132653919857136957_n.png?stp=dst-png_s360x360&_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ahPQDD0GnP8Q7kNvwFe8uyO&_nc_oc=AdocRVpD211lL24eza_ZNyA3J1VQ00U3M5EczRxb5Lz4XBOyjYqyTPiRkASv-wEfvcc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQS_5uwX3s8_UwDW9OObw6m4E1sjvbkrIMLk35WYGDZO2A&oe=6B0DC6AF"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Vertigo Zombies", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Shooter", "id": "3744040
ed_date": 1553867247, "id": "2743212045693734", "version": "1.41", "version_code": 6, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1371929766155309", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "2756293567718915"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1043584572357586"}]}, "change_log": "Stability improvements for file browser", "created_date": 1481202795, "id": "1515940328420918", "version": "1.3.1", "version_code": 5, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1371929766155309", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "2756293567718915"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1043584572357586"}]}, "change_log": "- Shiny has been equipped with stock music (\"Shiny Music\") to make sure the game is playable even without external music sources\r\n- The Song Selection Screen now features a file browser in order to select the folders and/or files that should be scanned for music source detection\r\n- Loading Screen Timing & Responsiveness improved\r\n- Performance improved & Renderscale (Visual Quality) improved", "created_date": 1477908461, "id": "1464823013532650", "version": "1.3", "version_code": 4, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1371929766155309", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "2756293567718915"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1043584572357586"}]}, "change_log": "We've fixed the issues outlined in the test report. Additional info on two issues:\n1) \"The app continues to run for approximately 10 seconds after removing the headset.\" This is apparently a hardware issue: https://forums.oculus.com/developer/discussion/36785/gearvr-standby-mode-not-pausing-application\n2) \"The loading screens last longer than 4 seconds and don't have any loading animation.\" The loading sequence duration depends on the song, which is being imported. A longer song equals a longer loading screen. We've removed elements like the particles from the loading scene and added an additional explanation to avoid confusion about the app having potentially freezed.", "created_date": 1471265352, "id": "1383290505019235", "version": "1.2", "version_code": 3, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}]}}, "viewer": {"user": null}}}
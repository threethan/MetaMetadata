id": "1004347199090868", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/491824328_1004347205757534_492762586801624500_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=izXiCsBye_MQ7kNvwE3Xiqs&_nc_oc=AdoyMscZcEBr8CY2CuEalJGQbRbA9JqdG_8ZveGmHwDrkOWiBjF_m0yh19WzoI_kTus&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQOe4sJwtWNgpQFhMEQ0OExfdAVmY91umClxEPB3hz5BA&oe=6AF9D7D7"}, {"file_name": "ss2.png", "id": "1069768795616817", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/491820910_1069768802283483_4610995521594135687_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nJs_R-KoRkMQ7kNvwHHSLy6&_nc_oc=AdqgUCT7l2twOR0zueLvh4QIzJCWasoqew7eaqRohWDJA1zgRC5Nqye3eYoBGQr0uc4&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRK2180lGPzIOcNym7pmNyzTMNuyWNk0u_WANDeiw5oiw&oe=6AF9BBA6"}, {"file_name": "ss3.png", "id": "1065038949550150", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/491823259_1065038952883483_7798115157552070041_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cgzo243CiAwQ7kNvwEc38iA&_nc_oc=AdrBXnQ2E-8KRcU7GWdQ899f0iOzE2sqX_nWSHHyABKY2g3tHUWKpNw-B-y3PhcsBkg&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRuxmFmFZCk7bGnS095RFORgs9n2SsctKyuYcqur-8oQw&oe=6AF9D87A"}, {"file_name": "ss4.png", "id": "1748916252799813", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/491823910_1748916262799812_8673216499777066606_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G_eDD9PLBBQQ7kNvwEaATKL&_nc_oc=AdrjRNGyFkLwnTWEec2Q4v9Bf_gcNDjzbSrtNNrboiEPVdtrGdIzU6Az1KESGf3lLZ0&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQLq-XNSbImMd2VUIcJZutteIRfYf1CZI73DhJZWqDNMg&oe=6AF9C107"}, {"file_name": "ss5.png", "id": "4097768890522775", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/491824318_4097768900522774_100577852223745294_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sQs7BGAG_5AQ7kNvwHUUh-v&_nc_oc=AdpbDtsBbrq9gDgRsZI227R_GvvFkxFF-T5oivB4ew1i0z7f7dhdWHym4gRyH_SXny4&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQtsVMdVkoYNnr2HR-Q_KTtQXOH6kLVM5nbRA0PkZKrvQ&oe=6AF9D426"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ss1.png", "id": "1042090438205777", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/491827646_1042090444872443_2259670401269122809_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7ds6v2QOzDUQ7kNvwE-yGCK&_nc_oc=AdpK_eFNbLdIWipwzAfs_5YicY2Hlyw7ztSyApUG5CnXB8A76MhxFh1GO5T4cgk6SI4&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTexSU92wHUHNhfwx3dCtkzqANOIRMpYPQYGYy1zXXklA&oe=6AF9D644"}, "display_name": "RunnerVR", "keywords": ["Runner", "Traffic", "Endless", "VR", "Racing"], "long_description": "Gear up for the ultimate high-speed VR survival test!\n\nStep directly onto a roaring highway where every second counts. RunnerVR takes the addictive, fast-paced action of classic endless runners and throws you headfirst into immersive Virtual Reality.\n\nThere are no brakes, no second chances, and no stopping. As you auto-run forward, you\u2019ll need quick reflexes and head-turning awareness to dodge unpredictable traffic, weave through tight lane shifts, and push your limits for the ultimate high score.\n\nKey Features:\nHeart-Pounding VR Perspective: Experience true 1:1 scale speed as massive trucks, sleek cars, and unpredictable vehicles rush right past your face.\n\nSimple Mechanics, Addictive Gameplay: Easy to pick up for anyone, but brutal to master. Just look, steer, dodge, and keep moving!\n\nHigh-Stakes Hazards: One wrong move, one glance away, or one clip of a bumper, and it\u2019s game over.\n\nLeaderboards & High Scores: Beat your personal bests and challenge friends to see who can survive the high-speed chaos the longest.\n\nHow far can you run before the traffic catches up? Put on your headset and test your instincts today!", "short_description": "Feel the adrenaline in RunnerVR as you dodge high-speed traffic on foot! Keep running, weave through tight gaps, and survive the ultimate VR endless racer."}]}, "developer_name": null, "developer_privacy_policy_url": "https://illustratorgraphics.blogspot.com/p/privacy-policy-this-privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Villain Game Studio", "support_website_url": null, "website_url": "https://illustratorgraphics.blogspot.com/p/privacy-policy-this-privacy-policy.html", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1290039447527144"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/491823351_1920780458562122_2988340437764757820_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N0x1_4mDbzMQ7kNvwHZ7gnY&_nc_oc=AdotzFlrwIkLdxJ0ggVKNpmieW9RerS5MJc4lDeD_loJ1Z9axsGUJZW-3lArFucC7xM&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTEL4eFk4Q9-_wJz69YKCN9XDlkdxtgmq_9RHc-rDzY0w&oe=6AF9CC2F"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "RunnerVR", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Action", "id": "459781504968480"}, {"topic_name": "Arcade", "id": "1592192974313489"}], "release_date": 1785851940, "lastRevision": {"nodes": [{"id": "123489
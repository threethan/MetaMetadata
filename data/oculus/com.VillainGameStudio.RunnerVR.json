ng", "id": "1004347199090868", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/491824328_1004347205757534_492762586801624500_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yhHwmKz6mZwQ7kNvwG2z7xg&_nc_oc=Adrg485W2mjn-8FfI6kqu44l7ZzU4yYuA13dH9D9Sy9mTeQ2HgSvf1sFkyYOYPzpOXo&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL1Za1uUOXU-GFXwZ7yl4XrdVGkHsXZpktyjk3ePBc6iw&oe=6AA96C57"}, {"file_name": "ss2.png", "id": "1069768795616817", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/491820910_1069768802283483_4610995521594135687_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Oq95KHxAyUYQ7kNvwG5Qj7x&_nc_oc=AdpH5Pk9Oqq2bih8m1Y_Ij1woQulGcjfU_IMWAHQV88rGm1rHa_a_JR2LZUJuLM1yoU&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIYte9dYNV8jE1f75lyrIL09wD7UiBW82UlU5AyVX4YUA&oe=6AA95026"}, {"file_name": "ss3.png", "id": "1065038949550150", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/491823259_1065038952883483_7798115157552070041_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EQynVXpT6DUQ7kNvwF90v50&_nc_oc=Adr1KtWEodAqF5FAlYyGiuTMtR27Ygyy_2jOEqQDltanvwr1HN58QbMj9EKFiuE3Beg&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL0BHAPsoeCR-trkUexDGzR3XYvRBGs8mzPNR90rVedlA&oe=6AA934BA"}, {"file_name": "ss4.png", "id": "1748916252799813", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/491823910_1748916262799812_8673216499777066606_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K3L2US06xsYQ7kNvwFNcuXb&_nc_oc=AdpNe54W8VjqIIR3w00k0YMYPPDMHiFxuAK8DeUeQxrHl5ev1BI_uyLz-RAwrQAKOYo&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLbY5l2K_u9zkmA7zCruhbfwRSXznjfglk54vnBh-BTvg&oe=6AA95587"}, {"file_name": "ss5.png", "id": "4097768890522775", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/491824318_4097768900522774_100577852223745294_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IKdbnQj2PC4Q7kNvwGfa5nx&_nc_oc=AdoxYy0dsr9Ik8rqR4MPsfV_sbfu4UPaokbjI1_2oAVDwry2rqkSxxBg6L2-iNwXte8&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL-93ZHn5JSi1HKIV4N4A72h0d1mI9iX1lyJnvLkmpJ7Q&oe=6AA968A6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ss1.png", "id": "1042090438205777", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/491827646_1042090444872443_2259670401269122809_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eBXNVvYHMfYQ7kNvwEjihfj&_nc_oc=AdoFi2Vyn-2tpzlk0kyMTpm2u1xL2au4FUF2ioW5NIUyUXmtMA4zOn6BMGgXPsyFKl8&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLz8gLGilsQKOjLQKyY2H6w5uccQuSl9yGZ3Xy3r3JHCQ&oe=6AA96AC4"}, "display_name": "RunnerVR", "keywords": ["Runner", "Traffic", "Endless", "VR", "Racing"], "long_description": "Gear up for the ultimate high-speed VR survival test!\n\nStep directly onto a roaring highway where every second counts. RunnerVR takes the addictive, fast-paced action of classic endless runners and throws you headfirst into immersive Virtual Reality.\n\nThere are no brakes, no second chances, and no stopping. As you auto-run forward, you\u2019ll need quick reflexes and head-turning awareness to dodge unpredictable traffic, weave through tight lane shifts, and push your limits for the ultimate high score.\n\nKey Features:\nHeart-Pounding VR Perspective: Experience true 1:1 scale speed as massive trucks, sleek cars, and unpredictable vehicles rush right past your face.\n\nSimple Mechanics, Addictive Gameplay: Easy to pick up for anyone, but brutal to master. Just look, steer, dodge, and keep moving!\n\nHigh-Stakes Hazards: One wrong move, one glance away, or one clip of a bumper, and it\u2019s game over.\n\nLeaderboards & High Scores: Beat your personal bests and challenge friends to see who can survive the high-speed chaos the longest.\n\nHow far can you run before the traffic catches up? Put on your headset and test your instincts today!", "short_description": "Feel the adrenaline in RunnerVR as you dodge high-speed traffic on foot! Keep running, weave through tight gaps, and survive the ultimate VR endless racer."}]}, "developer_name": null, "developer_privacy_policy_url": "https://illustratorgraphics.blogspot.com/p/privacy-policy-this-privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Villain Game Studio", "support_website_url": null, "website_url": "https://illustratorgraphics.blogspot.com/p/privacy-policy-this-privacy-policy.html", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1290039447527144"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/491823351_1920780458562122_2988340437764757820_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H9MLA_fg1SwQ7kNvwFtjmT7&_nc_oc=Adrq-Sl75uY_xzVlJTgLaop43Hik-PM2U3mX2hKc36z0PcNntmPe7W8nk3kdqBWmhJE&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI1-e3eK_W1b8WfUQQpefrvL0O-5i209K7ksGtsckxy5g&oe=6AA960AF"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "RunnerVR", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Action", "id": "459781504968480"}, {"topic_name": "Arcade", "id": "1592192974313489"}], "release_date": 1785851940, "lastRevision": {"nodes": [{"id
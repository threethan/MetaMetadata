id": "1004347199090868", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491824328_1004347205757534_492762586801624500_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jB32p7R552QQ7kNvwFTgLKj&_nc_oc=AdoRM4JIyZBnhbFH9YThClyY4U7fpWDZhVZ0F1zU2FRO8V26UApNqsRoQD4ANKLCGlU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM6Bhk0y1JdRnwBTgyV4SHL4fhjfspxffLKgI4p3vxxIw&oe=6AE61157"}, {"file_name": "ss2.png", "id": "1069768795616817", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491820910_1069768802283483_4610995521594135687_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tlENBYRXELMQ7kNvwF6Y8zl&_nc_oc=AdpCgyiLTDdv1hFWVyIzv3IsHV6i-ITGsNz3tDxRgq2ppO1LsQCOGMOIwocnlKrEOlE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO98w9Dsc5GH2h99HM8t9-BH6G_Qxc_gSVVaGBQr3lYEg&oe=6AE5F526"}, {"file_name": "ss3.png", "id": "1065038949550150", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823259_1065038952883483_7798115157552070041_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MIpHSEDSAPUQ7kNvwH_Szi0&_nc_oc=Adovp4n4WAhgQAZwOTziDkOf2VowxinWX57pGhgAoCM5o-0HBtPRRDqXnRPBnb03Ok8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMuKJ29n1oSj619lInwMYwq7urrqC42GwlfUe3ix1U8ZA&oe=6AE611FA"}, {"file_name": "ss4.png", "id": "1748916252799813", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491823910_1748916262799812_8673216499777066606_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TnsBX5ikk7cQ7kNvwE9lGHO&_nc_oc=Adoy-qdynALExliA6ZWCZHIkbPNknPFecBPxqqy90UAXyWkUr-vSkvNBO7JnwKNcxJs&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOUyTM7MpY2VjxUAB64hfpURAHR4Vx1L1IradlL3SqDgw&oe=6AE5FA87"}, {"file_name": "ss5.png", "id": "4097768890522775", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491824318_4097768900522774_100577852223745294_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c9My84qktzIQ7kNvwFI_aoN&_nc_oc=AdqLlcDqfN8FKjqoJfX7bBQFtSf7DcTIoqIxEoesipLu7vxo7MwspunuVHQmY77UiCs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOEWom2tURTtTI2YI13K5cRCUPuuP-m6JuTFoqfGr-REA&oe=6AE60DA6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ss1.png", "id": "1042090438205777", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491827646_1042090444872443_2259670401269122809_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Fntf879owA8Q7kNvwG06hL4&_nc_oc=Adp0TXcgJx3So3G-TH1tk1BlYaQy2eHdcq1K_j8PLTGIMC70svb9DEfgjnvYzKTNyGM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP5_lwaf8lnvVHmRDq7k5Ye__c1OHZ589uV3Yw6i9cYQQ&oe=6AE60FC4"}, "display_name": "RunnerVR", "keywords": ["Runner", "Traffic", "Endless", "VR", "Racing"], "long_description": "Gear up for the ultimate high-speed VR survival test!\n\nStep directly onto a roaring highway where every second counts. RunnerVR takes the addictive, fast-paced action of classic endless runners and throws you headfirst into immersive Virtual Reality.\n\nThere are no brakes, no second chances, and no stopping. As you auto-run forward, you\u2019ll need quick reflexes and head-turning awareness to dodge unpredictable traffic, weave through tight lane shifts, and push your limits for the ultimate high score.\n\nKey Features:\nHeart-Pounding VR Perspective: Experience true 1:1 scale speed as massive trucks, sleek cars, and unpredictable vehicles rush right past your face.\n\nSimple Mechanics, Addictive Gameplay: Easy to pick up for anyone, but brutal to master. Just look, steer, dodge, and keep moving!\n\nHigh-Stakes Hazards: One wrong move, one glance away, or one clip of a bumper, and it\u2019s game over.\n\nLeaderboards & High Scores: Beat your personal bests and challenge friends to see who can survive the high-speed chaos the longest.\n\nHow far can you run before the traffic catches up? Put on your headset and test your instincts today!", "short_description": "Feel the adrenaline in RunnerVR as you dodge high-speed traffic on foot! Keep running, weave through tight gaps, and survive the ultimate VR endless racer."}]}, "developer_name": null, "developer_privacy_policy_url": "https://illustratorgraphics.blogspot.com/p/privacy-policy-this-privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Villain Game Studio", "support_website_url": null, "website_url": "https://illustratorgraphics.blogspot.com/p/privacy-policy-this-privacy-policy.html", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1290039447527144"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823351_1920780458562122_2988340437764757820_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gfQgcNNECR4Q7kNvwHXBZop&_nc_oc=AdrHW9Q8eiyyHbn_f1zL6FyLJHEOovZhB-5tyXNgLqfz0yc5HEXOj1ANrOdmuUQ-ETQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNvXfsA1azXCstHrupAl1QFUOrdYDCjdp_BGn1j__S4PQ&oe=6AE605AF"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "RunnerVR", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Action", "id": "459781504968480"}, {"topic_name": "Arcade", "id": "1592192974313489"}], "release_date": 1785851940, "lastRevision": {"nodes": [{"id": "123489
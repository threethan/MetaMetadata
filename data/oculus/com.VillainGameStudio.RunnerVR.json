id": "1004347199090868", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491824328_1004347205757534_492762586801624500_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yFyzBvj_wCcQ7kNvwGykW84&_nc_oc=AdoYTrinSn245DT0npobXEXEToYacooX8Z-4dRU_G6FCeOdJjJCrdAZy-jYwoYaAOrk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKhpfweMrz9zx3wNgtuxjIX9FCmKpgSXl87WHqAOgSTEg&oe=6A9EA817"}, {"file_name": "ss2.png", "id": "1069768795616817", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491820910_1069768802283483_4610995521594135687_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PMJIf06p958Q7kNvwHNEn-D&_nc_oc=Adp8om66UzPFBkedO-MaTAlBx5i1qlxTR1W-TmobSxy1oO03tBv2sz1h_fpR1gkMucY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLg3Clz8mdwyhjuB7TezIz3XQSJ4WhlaGfiiGIHkyNxqw&oe=6A9EC426"}, {"file_name": "ss3.png", "id": "1065038949550150", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823259_1065038952883483_7798115157552070041_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1CNdHjVQOTcQ7kNvwHGEg2C&_nc_oc=Adp3OWGIsvSl2RAH0oC3pCN0cLeOtS6Dsq0SWidkzu5tVyP7xQSqTF07m04bJEVqfvw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ3sze2ihMD9s49l6NQP7bKZP6Qi58PBPgWkmuBlBSm5A&oe=6A9EA8BA"}, {"file_name": "ss4.png", "id": "1748916252799813", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491823910_1748916262799812_8673216499777066606_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nD9ZcJb02UkQ7kNvwECcQXF&_nc_oc=AdojNuRpQYGlv7E8RsBpVG4arT8J9z0ME6G5FFTnkBWSeBbeFnOGwZFavMzNWpyeg1c&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJaXV-Py999BNk3y8zINDtuvi7e3YlPYomfIEqDECKV4g&oe=6A9EC987"}, {"file_name": "ss5.png", "id": "4097768890522775", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491824318_4097768900522774_100577852223745294_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SX9NiWAQvzIQ7kNvwFXoLQp&_nc_oc=AdoH7iiPR05GjtVQCZasV7a4eeheRearcFOe_Y_p3VO5SwOB5lauMMp6BK3opg6m6fg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKFqpCxNyha_kMZppuxHcjis8Fmoi4npf8jE3YTtq8TxQ&oe=6A9EDCA6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ss1.png", "id": "1042090438205777", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491827646_1042090444872443_2259670401269122809_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ijRrCjVp8_EQ7kNvwFt4YlB&_nc_oc=Adq5pSb5QdnwiTVtt-fe2_lTwrintLxMUBHrlDtalTAuRz25MebvOfblhMP9OG8pVaU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLGM5T8Keijx_JCIwbpOgF_L6AQQPNulQDAs4kvTcspng&oe=6A9EDEC4"}, "display_name": "RunnerVR", "keywords": ["Runner", "Traffic", "Endless", "VR", "Racing"], "long_description": "Gear up for the ultimate high-speed VR survival test!\n\nStep directly onto a roaring highway where every second counts. RunnerVR takes the addictive, fast-paced action of classic endless runners and throws you headfirst into immersive Virtual Reality.\n\nThere are no brakes, no second chances, and no stopping. As you auto-run forward, you\u2019ll need quick reflexes and head-turning awareness to dodge unpredictable traffic, weave through tight lane shifts, and push your limits for the ultimate high score.\n\nKey Features:\nHeart-Pounding VR Perspective: Experience true 1:1 scale speed as massive trucks, sleek cars, and unpredictable vehicles rush right past your face.\n\nSimple Mechanics, Addictive Gameplay: Easy to pick up for anyone, but brutal to master. Just look, steer, dodge, and keep moving!\n\nHigh-Stakes Hazards: One wrong move, one glance away, or one clip of a bumper, and it\u2019s game over.\n\nLeaderboards & High Scores: Beat your personal bests and challenge friends to see who can survive the high-speed chaos the longest.\n\nHow far can you run before the traffic catches up? Put on your headset and test your instincts today!", "short_description": "Feel the adrenaline in RunnerVR as you dodge high-speed traffic on foot! Keep running, weave through tight gaps, and survive the ultimate VR endless racer."}]}, "developer_name": null, "developer_privacy_policy_url": "https://illustratorgraphics.blogspot.com/p/privacy-policy-this-privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Villain Game Studio", "support_website_url": null, "website_url": "https://illustratorgraphics.blogspot.com/p/privacy-policy-this-privacy-policy.html", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1290039447527144"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823351_1920780458562122_2988340437764757820_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cs_KHfOuJP4Q7kNvwE87iQ3&_nc_oc=AdrF5PeUIhY923NsmHZ6zIEt0nkvS1xwEPxKG0JiwepC88RV4e1x71Vh-tirqYd38h8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKkB4rBjf4GuckxNp4Y2ZGRiC5Xt9zxh40vXMijqCuAWg&oe=6A9ED4AF"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "RunnerVR", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Action", "id": "459781504968480"}, {"topic_name": "Arcade", "id": "1592192974313489"}], "release_date": 1785851940, "lastRevision": {"nodes": [{"id": "123489
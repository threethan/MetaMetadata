id": "1004347199090868", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/491824328_1004347205757534_492762586801624500_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vc7JTCh4MBoQ7kNvwEyiEzs&_nc_oc=AdrOMB_7d4iUDu5aNFrq7HnFZhMjg8GhTLvh1HGw47IIYPDRpophPgBcMS_NN7C4TBY&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPxnTVoiwQmDhfrL2iGYN-qLSIROT4S4TVV40oqScRc4w&oe=6AD0F957"}, {"file_name": "ss2.png", "id": "1069768795616817", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/491820910_1069768802283483_4610995521594135687_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yKRU0jEG5VkQ7kNvwGIRzzW&_nc_oc=Adrmp65U8L3mKmqUcExCN_6sxXFro8dl5hYmMLHLYWO9zbk7rnp-KnewsMM9hFFqDWk&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOKX-oaxZ6Pfy8XKHjn36jSMdwnl-tOlfdOawDEINgGgA&oe=6AD0DD26"}, {"file_name": "ss3.png", "id": "1065038949550150", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/491823259_1065038952883483_7798115157552070041_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iFQ_0nBy454Q7kNvwH4QE6D&_nc_oc=Adoeqr3QcCg7jZU6KTXhGMCvfw9wvV-cJVM326sJGETFI4h468p02msdizd3471VEH4&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO5jJSO811glU7ekIRazcinVXiGh_IMNS8P7SEeRWJhIA&oe=6AD0F9FA"}, {"file_name": "ss4.png", "id": "1748916252799813", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/491823910_1748916262799812_8673216499777066606_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UHm7xzQJa3YQ7kNvwE9kVzl&_nc_oc=AdrMAnz1zwRZ4upQaVEegGzWxYPAZlKE5Hx8TlK-sxAj2AK99cjtsEomyLB7GEXSR1E&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPnkgvetbcI1ynr2nrrVH_EDPD-XhCqNYISBU7aRTFvhg&oe=6AD0E287"}, {"file_name": "ss5.png", "id": "4097768890522775", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/491824318_4097768900522774_100577852223745294_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HXidMvyJAWIQ7kNvwFCWAX_&_nc_oc=AdqvfJ9ebCaRTS6nhSnlsUJ4d7PZV0CQu6eJ3_XOdF0xt5Vcs9yc5MsDGNAkY_4A0cU&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOslHGr196jkK4hC8iqZJqd2jjU_NRX7bzCLkliXO0udQ&oe=6AD0F5A6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ss1.png", "id": "1042090438205777", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/491827646_1042090444872443_2259670401269122809_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vAQNxev4SFcQ7kNvwHUIt3-&_nc_oc=Adrsl4ga0HUa9Lp2smfV1fzfbfhUhl7KfR3p1iJVr7sTQC22asXr13y12C6IUMFoWts&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNdMxnDYS3Pq2h8ZxhGQh7sUwl-GdVjN5J2DS-KsXUfTQ&oe=6AD0F7C4"}, "display_name": "RunnerVR", "keywords": ["Runner", "Traffic", "Endless", "VR", "Racing"], "long_description": "Gear up for the ultimate high-speed VR survival test!\n\nStep directly onto a roaring highway where every second counts. RunnerVR takes the addictive, fast-paced action of classic endless runners and throws you headfirst into immersive Virtual Reality.\n\nThere are no brakes, no second chances, and no stopping. As you auto-run forward, you\u2019ll need quick reflexes and head-turning awareness to dodge unpredictable traffic, weave through tight lane shifts, and push your limits for the ultimate high score.\n\nKey Features:\nHeart-Pounding VR Perspective: Experience true 1:1 scale speed as massive trucks, sleek cars, and unpredictable vehicles rush right past your face.\n\nSimple Mechanics, Addictive Gameplay: Easy to pick up for anyone, but brutal to master. Just look, steer, dodge, and keep moving!\n\nHigh-Stakes Hazards: One wrong move, one glance away, or one clip of a bumper, and it\u2019s game over.\n\nLeaderboards & High Scores: Beat your personal bests and challenge friends to see who can survive the high-speed chaos the longest.\n\nHow far can you run before the traffic catches up? Put on your headset and test your instincts today!", "short_description": "Feel the adrenaline in RunnerVR as you dodge high-speed traffic on foot! Keep running, weave through tight gaps, and survive the ultimate VR endless racer."}]}, "developer_name": null, "developer_privacy_policy_url": "https://illustratorgraphics.blogspot.com/p/privacy-policy-this-privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Villain Game Studio", "support_website_url": null, "website_url": "https://illustratorgraphics.blogspot.com/p/privacy-policy-this-privacy-policy.html", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1290039447527144"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/491823351_1920780458562122_2988340437764757820_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1ZyEjNKj1u0Q7kNvwHuHuho&_nc_oc=Ado7dAktXrNxprY1KFgnWuUa49BZeDFcw6rRQg85U7_WejfgPE-Ig69oaLyuCa2LfZE&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMKKPEOrnTVq2m_SuaH7Cj_o-FgTaYuv1yE11c_Lbn16A&oe=6AD0EDAF"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "RunnerVR", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Action", "id": "459781504968480"}, {"topic_name": "Arcade", "id": "1592192974313489"}], "release_date": 1785851940, "lastRevision": {"nodes": [{"id": "123489
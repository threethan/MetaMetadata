id": "1004347199090868", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491824328_1004347205757534_492762586801624500_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WRtSuH_6FYsQ7kNvwF_Ryn1&_nc_oc=AdpL6U-185nrULyA52Tc_XfIc1mIQCQAvNZu-Ka6NSIwOZ9xzaAefoiC4JUdOmD_hdE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLm6pxBWvhcFa2Lnaxf_pjkYHUy909eVeQLl5WPI7jebw&oe=6AA53F97"}, {"file_name": "ss2.png", "id": "1069768795616817", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491820910_1069768802283483_4610995521594135687_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=t11tL5h-HSwQ7kNvwHmyLht&_nc_oc=AdoN0DIH73J7RivQpX95HU6knq5Tpi_I-8rdyRL3tmheokXRslB4x6dyZMBihRKMh_Y&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK7MJXyTy_7w6FZWIYHk1aSxh2zWJXhDpmhvPB_PoMYVg&oe=6AA55BA6"}, {"file_name": "ss3.png", "id": "1065038949550150", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491823259_1065038952883483_7798115157552070041_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rQStM0J7iMMQ7kNvwGOx3lB&_nc_oc=AdpxPeDRipOm9zJhmbsliEwWQw2YkMmMt2Wu1XeL-_q0RbDbu7g_OMP_YTDhG4mQbxI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI2vX1OuFNmdiAMr5ZQIfYVWDVq1qObEvyv0ujXL9T9Xg&oe=6AA5403A"}, {"file_name": "ss4.png", "id": "1748916252799813", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491823910_1748916262799812_8673216499777066606_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vgBXG7ErwXQQ7kNvwE5Lktg&_nc_oc=AdqJ5V1lmwLhus0E3vrJf6s3jXdrV3fYWWZhmFoVa1a8-7Maeu1t7z-9UtugwERKFjU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK4cCh2SiZBnvE1aPG2xxJXkw_viWEg4E3Dr4ecW8Hu2g&oe=6AA56107"}, {"file_name": "ss5.png", "id": "4097768890522775", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491824318_4097768900522774_100577852223745294_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DYY42i_mLBsQ7kNvwFrbUWj&_nc_oc=Adq3HuM_P4jSW2LABLDWjZL15PpIk-LBspgAHKGPqXiPEhBXD8rmAblmmj3aKczIL7Q&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKxHBslqV7RpuE5kzkHv53_8jIk5MZWvx_K9Y2LTZy5eg&oe=6AA57426"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ss1.png", "id": "1042090438205777", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491827646_1042090444872443_2259670401269122809_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5rvdLNH3ykAQ7kNvwGy5Qk1&_nc_oc=AdoN3IBQYOpw3_zTUZwHJV6npF1Yiem144WHanqgrhguZJ1o1dqQ37xWiTml0ZrUkzE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKMlG6S2fo3TKPJ8BEH8Wd_bFzhx01uBKCHs3HQ-nq8DA&oe=6AA57644"}, "display_name": "RunnerVR", "keywords": ["Runner", "Traffic", "Endless", "VR", "Racing"], "long_description": "Gear up for the ultimate high-speed VR survival test!\n\nStep directly onto a roaring highway where every second counts. RunnerVR takes the addictive, fast-paced action of classic endless runners and throws you headfirst into immersive Virtual Reality.\n\nThere are no brakes, no second chances, and no stopping. As you auto-run forward, you\u2019ll need quick reflexes and head-turning awareness to dodge unpredictable traffic, weave through tight lane shifts, and push your limits for the ultimate high score.\n\nKey Features:\nHeart-Pounding VR Perspective: Experience true 1:1 scale speed as massive trucks, sleek cars, and unpredictable vehicles rush right past your face.\n\nSimple Mechanics, Addictive Gameplay: Easy to pick up for anyone, but brutal to master. Just look, steer, dodge, and keep moving!\n\nHigh-Stakes Hazards: One wrong move, one glance away, or one clip of a bumper, and it\u2019s game over.\n\nLeaderboards & High Scores: Beat your personal bests and challenge friends to see who can survive the high-speed chaos the longest.\n\nHow far can you run before the traffic catches up? Put on your headset and test your instincts today!", "short_description": "Feel the adrenaline in RunnerVR as you dodge high-speed traffic on foot! Keep running, weave through tight gaps, and survive the ultimate VR endless racer."}]}, "developer_name": null, "developer_privacy_policy_url": "https://illustratorgraphics.blogspot.com/p/privacy-policy-this-privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Villain Game Studio", "support_website_url": null, "website_url": "https://illustratorgraphics.blogspot.com/p/privacy-policy-this-privacy-policy.html", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1290039447527144"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491823351_1920780458562122_2988340437764757820_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SqmtkHmmnCcQ7kNvwHlSrUG&_nc_oc=AdqQ5qiF-d8drjTpwxxpFamZwNDRetMqeZ5-_CTTN1ZnRNPMtpc8Chb3Ay3cNi7RRuQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKLHiMcO1g4tDtDcBj6ljodbuZjx0OyaTQKhjDD2i8jug&oe=6AA56C2F"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "RunnerVR", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Action", "id": "459781504968480"}, {"topic_name": "Arcade", "id": "1592192974313489"}], "release_date": 1785851940, "lastRevision": {"nodes": [{"id": "123489
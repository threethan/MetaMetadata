id": "1004347199090868", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/491824328_1004347205757534_492762586801624500_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UjRoJMbbv3gQ7kNvwGZiagu&_nc_oc=Ado5CpvvcpcogDgMvA-2iLGjUdGkQp0SH1nD4XqHNrKo6HLgoBrjgPcNnFRu1lTn8GA&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJE4ca63AOPZZDqc4u_yYNCHg8yyseH6wvx8dX_yYvwYg&oe=6AA14B17"}, {"file_name": "ss2.png", "id": "1069768795616817", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/491820910_1069768802283483_4610995521594135687_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n_0Jc1kTRacQ7kNvwHGQQZy&_nc_oc=AdqaXIaEesyLQPt6fOkhzkVtnUQUUcMGEwQ5z4ipM1VksSJIsXiXPhvNSNJBFNr2wb0&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJccTd_2gUEcuAasp17FELhNxQCiaWsny_tmSMRmZS2kA&oe=6AA16726"}, {"file_name": "ss3.png", "id": "1065038949550150", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/491823259_1065038952883483_7798115157552070041_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_mgLE1jK3KoQ7kNvwFgn_cX&_nc_oc=AdqC6ApqNCN-I9k02QPTL4degnQhyeiO5C6b4A8qoPwKek73rK2yBOMBAahTNqtn1vI&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKLYB-HJtTGmMVx1tRregYhebmk1ZTlNssAcDP-SKSJ-A&oe=6AA14BBA"}, {"file_name": "ss4.png", "id": "1748916252799813", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/491823910_1748916262799812_8673216499777066606_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VHAA0Zl_aA8Q7kNvwE-uX2z&_nc_oc=Adrg3t92FccjGJPJIYaLmkCtKid0YySK7BN8a2R8GdYGrKosy3ecoBetHRwssi1Y1OA&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIUAltwu1eEbZhpp02il_Zb0kFaboylnTKHh9MZZSPWdQ&oe=6AA16C87"}, {"file_name": "ss5.png", "id": "4097768890522775", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/491824318_4097768900522774_100577852223745294_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n3jOGUC32b4Q7kNvwEGs0GQ&_nc_oc=Adoimv5WO73BkrgaG83UO9-BfWbUu6fxg8YpEvW6jWc5_ZU1P9Zl88zLEAig0cXHeVw&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIg6mEsnDSz2cip-7tLvEbdhlVSvljJ-r7fdR6pLzo0kw&oe=6AA17FA6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ss1.png", "id": "1042090438205777", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/491827646_1042090444872443_2259670401269122809_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bZ9jFMTPfRoQ7kNvwHlw6H1&_nc_oc=Adq_B2zIUj6hHLApKWpmWm19JMy2I-eMHKkXSQoHc0p43SqDj4RykFGufpOas4ic6ss&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI_S5znj2FjfjzElu5-FjiQ1Rz_H-ecndTKb8Ep83XDjQ&oe=6AA14984"}, "display_name": "RunnerVR", "keywords": ["Runner", "Traffic", "Endless", "VR", "Racing"], "long_description": "Gear up for the ultimate high-speed VR survival test!\n\nStep directly onto a roaring highway where every second counts. RunnerVR takes the addictive, fast-paced action of classic endless runners and throws you headfirst into immersive Virtual Reality.\n\nThere are no brakes, no second chances, and no stopping. As you auto-run forward, you\u2019ll need quick reflexes and head-turning awareness to dodge unpredictable traffic, weave through tight lane shifts, and push your limits for the ultimate high score.\n\nKey Features:\nHeart-Pounding VR Perspective: Experience true 1:1 scale speed as massive trucks, sleek cars, and unpredictable vehicles rush right past your face.\n\nSimple Mechanics, Addictive Gameplay: Easy to pick up for anyone, but brutal to master. Just look, steer, dodge, and keep moving!\n\nHigh-Stakes Hazards: One wrong move, one glance away, or one clip of a bumper, and it\u2019s game over.\n\nLeaderboards & High Scores: Beat your personal bests and challenge friends to see who can survive the high-speed chaos the longest.\n\nHow far can you run before the traffic catches up? Put on your headset and test your instincts today!", "short_description": "Feel the adrenaline in RunnerVR as you dodge high-speed traffic on foot! Keep running, weave through tight gaps, and survive the ultimate VR endless racer."}]}, "developer_name": null, "developer_privacy_policy_url": "https://illustratorgraphics.blogspot.com/p/privacy-policy-this-privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Villain Game Studio", "support_website_url": null, "website_url": "https://illustratorgraphics.blogspot.com/p/privacy-policy-this-privacy-policy.html", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1290039447527144"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/491823351_1920780458562122_2988340437764757820_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cs_KHfOuJP4Q7kNvwGi4abf&_nc_oc=AdrFGwSoavTH7Lp8OiBBODIb_Lp9I4AH8ei0pMFfW_ClRjqIY9AUrmgpV7lHESYewOg&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK9eEXzZjzgYWMKvFTX-T5YfJ8MCcC8p88bwYTBM2-xXg&oe=6AA177AF"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "RunnerVR", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Action", "id": "459781504968480"}, {"topic_name": "Arcade", "id": "1592192974313489"}], "release_date": 1785851940, "lastRevision": {"nodes": [{"id": "123489
ng", "id": "1004347199090868", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/491824328_1004347205757534_492762586801624500_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UjRoJMbbv3gQ7kNvwHZF4Xx&_nc_oc=Adr8_-goxGEYhUi1RXHUZDXLAVpt9z4s90PwdPDdIIA9mA7JQ0sU-nnSU9bosmODnOc&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKihWEoWL7qh-haDckCZJOkNWmbl7Umd80sGs3bR6xifQ&oe=6AA42657"}, {"file_name": "ss2.png", "id": "1069768795616817", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/491820910_1069768802283483_4610995521594135687_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n_0Jc1kTRacQ7kNvwG5oL-O&_nc_oc=Adp4wL1dDpbl_Q2DAR22QyfMgn-bbDOOCct-Ue5NJwfz3okwpe2k1lQkmwenc3AMkv8&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK_U82mL4M8ivRwUnvoyjfipcDorPqjOdu-7tvcXmxsvw&oe=6AA40A26"}, {"file_name": "ss3.png", "id": "1065038949550150", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/491823259_1065038952883483_7798115157552070041_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rQStM0J7iMMQ7kNvwGeRrgy&_nc_oc=Ado9Qbtb76p-j84nDcpay2k8-uAQ0W0jTr-vPG6bATuD9jbOcNNVIjvLORLFt-IbWKM&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLdEQUqF4ctMEFAZOBCU2mKsfx--Jn6fbxTPUjBrzhjVQ&oe=6AA3EEBA"}, {"file_name": "ss4.png", "id": "1748916252799813", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/491823910_1748916262799812_8673216499777066606_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VHAA0Zl_aA8Q7kNvwEk_74B&_nc_oc=AdqT5c85y5MNtEy-TSrqE9seulFkWoW5T9jyC5SUIwulpl6rawezUiXbWVZD55yDL9w&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLEICHyS6ykGJGrCAKFO8DAfRyow3zZzNqPUocuDIBU-g&oe=6AA40F87"}, {"file_name": "ss5.png", "id": "4097768890522775", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/491824318_4097768900522774_100577852223745294_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n3jOGUC32b4Q7kNvwGvQhLV&_nc_oc=AdqPxiIEk1NkSV_Q_dAK1yHH-nk9cU6Y0ZwLvEh8-QsLbf3GZyAHL_V4WDCceOmH9nA&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJEQmrWlg5yYeZ_-DgL5ejoZARv4MfK2LNOUiFHype4EQ&oe=6AA422A6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ss1.png", "id": "1042090438205777", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/491827646_1042090444872443_2259670401269122809_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bZ9jFMTPfRoQ7kNvwFLVJuR&_nc_oc=AdqQLlGUtfIuvuysw5tud76uQUL-eOYvUH4tVYp_MRNGsAu5PomWvtpPwQ5wjVZSnBk&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL6PXlDM92jWFIL8qNrqCtAD8JvyeJ9mnDXKT5FTDCONw&oe=6AA424C4"}, "display_name": "RunnerVR", "keywords": ["Runner", "Traffic", "Endless", "VR", "Racing"], "long_description": "Gear up for the ultimate high-speed VR survival test!\n\nStep directly onto a roaring highway where every second counts. RunnerVR takes the addictive, fast-paced action of classic endless runners and throws you headfirst into immersive Virtual Reality.\n\nThere are no brakes, no second chances, and no stopping. As you auto-run forward, you\u2019ll need quick reflexes and head-turning awareness to dodge unpredictable traffic, weave through tight lane shifts, and push your limits for the ultimate high score.\n\nKey Features:\nHeart-Pounding VR Perspective: Experience true 1:1 scale speed as massive trucks, sleek cars, and unpredictable vehicles rush right past your face.\n\nSimple Mechanics, Addictive Gameplay: Easy to pick up for anyone, but brutal to master. Just look, steer, dodge, and keep moving!\n\nHigh-Stakes Hazards: One wrong move, one glance away, or one clip of a bumper, and it\u2019s game over.\n\nLeaderboards & High Scores: Beat your personal bests and challenge friends to see who can survive the high-speed chaos the longest.\n\nHow far can you run before the traffic catches up? Put on your headset and test your instincts today!", "short_description": "Feel the adrenaline in RunnerVR as you dodge high-speed traffic on foot! Keep running, weave through tight gaps, and survive the ultimate VR endless racer."}]}, "developer_name": null, "developer_privacy_policy_url": "https://illustratorgraphics.blogspot.com/p/privacy-policy-this-privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Villain Game Studio", "support_website_url": null, "website_url": "https://illustratorgraphics.blogspot.com/p/privacy-policy-this-privacy-policy.html", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1290039447527144"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/491823351_1920780458562122_2988340437764757820_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SqmtkHmmnCcQ7kNvwH_tYl1&_nc_oc=AdoTlT0vTzKwmsqx0srA3Xr2kQfytc8jcQNH2HqdojqxcDoQOnkVcmjooVTCQuOlqBA&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQICBmec752pSiUa2dGDyJI02cyKhspmOI9IdhLWbvRvew&oe=6AA41AAF"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "RunnerVR", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Action", "id": "459781504968480"}, {"topic_name": "Arcade", "id": "1592192974313489"}], "release_date": 1785851940, "lastRevision": {"nodes": [{"id
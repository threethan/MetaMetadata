_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR8g61DGaEOcj1xSyKC31ObeLbMMng3Vi2Z5Bt8AeyFrA&oe=6AE9E000"}, {"file_name": "ss5.png", "id": "1350972039934593", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/604293968_1350972043267926_2247327148489400437_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dExsss-YsxsQ7kNvwHQzolb&_nc_oc=AdqSq48Oh67ODmNlE-7JqffVcLqy9VUzIUrJOwMMBRvyUjewhPtFpIaK6TF8Z5Pb4WA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQsEU4qm_9-LMUYo7CZE4OVnd9hmTZBgLOAhSzEz6fYEQ&oe=6AE9EF02"}, {"file_name": "ss4.png", "id": "1026347026813357", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491823790_1026347030146690_3048147207987739152_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XvkSLFeDvXMQ7kNvwGsVkdw&_nc_oc=AdoBmrobn3Pasddji7LA_IRiL0dD2srXfgzIYQXJaQQqVtQYMPHW1vVWHyLcmYOTAyg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQEfsRgHe3A3jF78ktDLEPcoJdNCIwpiSSJ0cOdvDk4vg&oe=6AE9FB0F"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "RunnerVR", "keywords": ["Runner", "Traffic", "Endless", "VR"], "long_description": "Gear up for the ultimate high-speed VR survival test!\n\nStep directly onto a roaring highway where every second counts. [Game Title] takes the addictive, fast-paced action of classic endless runners and throws you headfirst into immersive Virtual Reality.\n\nThere are no brakes, no second chances, and no stopping. As you auto-run forward, you\u2019ll need quick reflexes and head-turning awareness to dodge unpredictable traffic, weave through tight lane shifts, and push your limits for the ultimate high score.\n\nKey Features:\nHeart-Pounding VR Perspective: Experience true 1:1 scale speed as massive trucks, sleek cars, and unpredictable vehicles rush right past your face.\n\nSimple Mechanics, Addictive Gameplay: Easy to pick up for anyone, but brutal to master. Just look, steer, dodge, and keep moving!\n\nHigh-Stakes Hazards: One wrong move, one glance away, or one clip of a bumper, and it\u2019s game over.\n\nLeaderboards & High Scores: Beat your personal bests and challenge friends to see who can survive the high-speed chaos the longest.\n\nHow far can you run before the traffic catches up? Put on your headset and test your instincts today!", "short_description": "Feel the adrenaline as you dodge high-speed traffic on foot! Keep running, weave through tight gaps, and survive the ultimate VR end-less racer."}]}, "developer_name": null, "developer_privacy_policy_url": "https://illustratorgraphics.blogspot.com/p/privacy-policy-this-privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Villain Game Studio", "support_website_url": null, "website_url": "https://illustratorgraphics.blogspot.com/p/privacy-policy-this-privacy-policy.html", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2776542286000603"}, {"id": "1592192974313489"}, {"id": "673385183287495"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1242311228966633"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PUBLISHED", "id": "1534802417712347"}, {"status": "PUBLISHED", "id": "1066115379095165"}]}, "baseline_offer": {"id": "1066115379095165"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1787166000, "status": "PUBLISHED", "id": "1534802417712347"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "A
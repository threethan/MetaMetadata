PIt8QVTCY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMX2jePoHX_BuUM5brWCt6wIEjSX0giVPdQo6j_-0662Q&oe=6ACA5E26"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ss1.png", "id": "1042090438205777", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491827646_1042090444872443_2259670401269122809_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=imw8zKY92HwQ7kNvwFDNoT-&_nc_oc=AdqRc_zZizPDP1vrrEVHef8lM97oWw63pvyFbBbOInF_Yl6P97ZEJBYMWpX3oiLZ_jU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNCsGVvFKq_k7eDaCGwnqoSQSsSxBo7E6yT8v6bnKEymQ&oe=6ACA6044"}, "display_name": "RunnerVR", "keywords": ["Runner", "Traffic", "Endless", "VR", "Racing"], "long_description": "Gear up for the ultimate high-speed VR survival test!\n\nStep directly onto a roaring highway where every second counts. RunnerVR takes the addictive, fast-paced action of classic endless runners and throws you headfirst into immersive Virtual Reality.\n\nThere are no brakes, no second chances, and no stopping. As you auto-run forward, you\u2019ll need quick reflexes and head-turning awareness to dodge unpredictable traffic, weave through tight lane shifts, and push your limits for the ultimate high score.\n\nKey Features:\nHeart-Pounding VR Perspective: Experience true 1:1 scale speed as massive trucks, sleek cars, and unpredictable vehicles rush right past your face.\n\nSimple Mechanics, Addictive Gameplay: Easy to pick up for anyone, but brutal to master. Just look, steer, dodge, and keep moving!\n\nHigh-Stakes Hazards: One wrong move, one glance away, or one clip of a bumper, and it\u2019s game over.\n\nLeaderboards & High Scores: Beat your personal bests and challenge friends to see who can survive the high-speed chaos the longest.\n\nHow far can you run before the traffic catches up? Put on your headset and test your instincts today!", "short_description": "Feel the adrenaline in RunnerVR as you dodge high-speed traffic on foot! Keep running, weave through tight gaps, and survive the ultimate VR endless racer."}]}, "developer_name": null, "developer_privacy_policy_url": "https://illustratorgraphics.blogspot.com/p/privacy-policy-this-privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Villain Game Studio", "support_website_url": null, "website_url": "https://illustratorgraphics.blogspot.com/p/privacy-policy-this-privacy-policy.html", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1290039447527144"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491823351_1920780458562122_2988340437764757820_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vIqblpHguuUQ7kNvwEjodzO&_nc_oc=AdpkJvO_iVr6fYCIkWdGmOs4SiBSBAOprrhUr1WM0gqhXAOPHM8aDU9NlUR4yE7kMnQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPW5W9wUD7Zy6tvEXaKvfHcPAFNQy5qe9JAA96YIW7mjQ&oe=6ACA562F"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "RunnerVR", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Action", "id": "459781504968480"}, {"topic_name": "Arcade", "id": "1592192974313489"}], "release_date": 1785851940, "lastRevision": {"nodes": [{"id": "123489
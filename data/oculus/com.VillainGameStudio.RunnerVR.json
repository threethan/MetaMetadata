id": "1004347199090868", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491824328_1004347205757534_492762586801624500_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yhHwmKz6mZwQ7kNvwGEK6sa&_nc_oc=Adop3FixBxCr3WS_W_H2piNEELDiWJYWdBeesRXxOBwUWlLZXvpMK7NnPYPnznTX6_c&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIfCeXCCzCktp4LdIS2jU_cZUeeQl7s9BUP0Eyj7ny2Pg&oe=6AAC0F57"}, {"file_name": "ss2.png", "id": "1069768795616817", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491820910_1069768802283483_4610995521594135687_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Oq95KHxAyUYQ7kNvwH0g1SH&_nc_oc=AdoCyohKaB9sgiSDPa-UcQSXUxABOdzhJFbPox6hvbdXXoz2qJuf6eU2v_ZLkFROkSY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIjRDdmZizRXERGtOwq5Sj2pPwhjzG99wMSSQIjbEGFdA&oe=6AABF326"}, {"file_name": "ss3.png", "id": "1065038949550150", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823259_1065038952883483_7798115157552070041_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FQbqp9-w4x8Q7kNvwGaTJpW&_nc_oc=AdqN5EClnmKnDl1SLePvPS1ihtUOraEt08Qt38v5Jwp6p-d5nNvqchnKOrvFY4psgMA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJTI1heaQjBbpL2e6RCjgk3FKx7Urae79L5H_jKfUd7tw&oe=6AAC0FFA"}, {"file_name": "ss4.png", "id": "1748916252799813", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491823910_1748916262799812_8673216499777066606_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K3L2US06xsYQ7kNvwFuGFxW&_nc_oc=AdqQJz2Pno7KrnJiud_Y3Gja_wq0Q79WWcLZYtAzMJRpU1H8VVvNp8xdpH5Jl1wzRQ0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKYkhY4R5HqNUeIHVAPkV-dpQLc3Aw41Yn5lNX2-SZw7g&oe=6AABF887"}, {"file_name": "ss5.png", "id": "4097768890522775", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491824318_4097768900522774_100577852223745294_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IKdbnQj2PC4Q7kNvwHuHAaB&_nc_oc=AdpWSAnIacnDllh9IRQ6i8Rvr5HO4rjgcmwuiWhLLRJ-pEuU5RWWAmh4bm7Wu_IISiY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJBn-mtyGf3tbdudeC94VPN5DUu0fKh-ALbxVyC7W1mHQ&oe=6AAC0BA6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ss1.png", "id": "1042090438205777", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491827646_1042090444872443_2259670401269122809_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eBXNVvYHMfYQ7kNvwFZ16vR&_nc_oc=AdpWe3FeX8di7RfnRJfraInGo876qb6kEe-ivMXpHX86f3_NZ9NEv-MvHk5t5Lnsohk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJlrnVyWGRBdUnC01NKqfIkGYT_Lc3RVD81tao1n4Jyug&oe=6AAC0DC4"}, "display_name": "RunnerVR", "keywords": ["Runner", "Traffic", "Endless", "VR", "Racing"], "long_description": "Gear up for the ultimate high-speed VR survival test!\n\nStep directly onto a roaring highway where every second counts. RunnerVR takes the addictive, fast-paced action of classic endless runners and throws you headfirst into immersive Virtual Reality.\n\nThere are no brakes, no second chances, and no stopping. As you auto-run forward, you\u2019ll need quick reflexes and head-turning awareness to dodge unpredictable traffic, weave through tight lane shifts, and push your limits for the ultimate high score.\n\nKey Features:\nHeart-Pounding VR Perspective: Experience true 1:1 scale speed as massive trucks, sleek cars, and unpredictable vehicles rush right past your face.\n\nSimple Mechanics, Addictive Gameplay: Easy to pick up for anyone, but brutal to master. Just look, steer, dodge, and keep moving!\n\nHigh-Stakes Hazards: One wrong move, one glance away, or one clip of a bumper, and it\u2019s game over.\n\nLeaderboards & High Scores: Beat your personal bests and challenge friends to see who can survive the high-speed chaos the longest.\n\nHow far can you run before the traffic catches up? Put on your headset and test your instincts today!", "short_description": "Feel the adrenaline in RunnerVR as you dodge high-speed traffic on foot! Keep running, weave through tight gaps, and survive the ultimate VR endless racer."}]}, "developer_name": null, "developer_privacy_policy_url": "https://illustratorgraphics.blogspot.com/p/privacy-policy-this-privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Villain Game Studio", "support_website_url": null, "website_url": "https://illustratorgraphics.blogspot.com/p/privacy-policy-this-privacy-policy.html", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1290039447527144"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823351_1920780458562122_2988340437764757820_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NAbW-6V4ABoQ7kNvwHw98td&_nc_oc=AdrPDTUliGZXc1vtCPDn3S94ENrkpP320_mrZb1gOQodyrS_M4dn8Yjpl8LNOzO5b8M&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJZzLUjfZBy7FQO8yIxAFWQNxciNifSLDC_T-K5GhBkYA&oe=6AAC03AF"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "RunnerVR", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Action", "id": "459781504968480"}, {"topic_name": "Arcade", "id": "1592192974313489"}], "release_date": 1785851940, "lastRevision": {"nodes": [{"id": "123489
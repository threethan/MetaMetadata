id": "1004347199090868", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491824328_1004347205757534_492762586801624500_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y6wkPq5TlEoQ7kNvwHwVWlN&_nc_oc=AdoGddra-1OlA_nG4bv6OL3MKCIv3qJfypWkDlVm4oXhCo3I8VUYQv4lw2SO6a4b3QQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK_SeAjaJ8QPyZHnWMp0mO-tnoJY82tmLJ6Ct_kv9tM9Q&oe=6AB15557"}, {"file_name": "ss2.png", "id": "1069768795616817", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491820910_1069768802283483_4610995521594135687_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7o69qKyfMDQQ7kNvwH-K_yK&_nc_oc=AdrQa5kcJuj1OjcuKFAGuT2TVsGRclxMBzO2H6zHlE6FaTthyFsJ5luqcjT99ax7DWo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIiu9h5NzfXG0y8jfuiwgB3ecueAfZG67aURMpDENqQmg&oe=6AB13926"}, {"file_name": "ss3.png", "id": "1065038949550150", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491823259_1065038952883483_7798115157552070041_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K0q7KrZDSJgQ7kNvwFlVzHp&_nc_oc=AdpYkFgihudCvk-W4wOBN-61Q9vcPzdpCu2IGEzMol4E2ywEkwUDll87i60sXrb28Ok&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIGKCx9sQ7gaC0Xw9TdtoVdDOkicuf15PnHtlfMPzkU6w&oe=6AB155FA"}, {"file_name": "ss4.png", "id": "1748916252799813", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491823910_1748916262799812_8673216499777066606_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wG5q94WWg0gQ7kNvwEJJToW&_nc_oc=AdpEXwO2hC-ecAb4mX56HiU89nwa6rgSXC4J5f2aIxufBND1L0MAq1BfAo_KXrjGumY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKfEUFXhHJ48RcdO_rZdSuvxHLWgpI6CjnfrznRMErGiQ&oe=6AB13E87"}, {"file_name": "ss5.png", "id": "4097768890522775", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491824318_4097768900522774_100577852223745294_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZemGra4Bw1UQ7kNvwFX3Ljo&_nc_oc=AdoLyERNdF_NxWG1s0HrG2Ij6ZLPwskGjfUBuug1wc81QRp-udMWTQHgIYvlu8QBeDk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKd1B2Yo6nyR3AQWeAKopFdCqo08Z65C9YF7steKhvatw&oe=6AB151A6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ss1.png", "id": "1042090438205777", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491827646_1042090444872443_2259670401269122809_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NvOdWlnp3aYQ7kNvwFMqht6&_nc_oc=AdqhJTgx5PhiqIXyi0o3QKZIp99Xya8SxvT6leuVNkAa2r7Zc8fVtoNxKbHfDAElsr8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQITBTyafCXroFxM3kgjnSLlXtak-rLmRPdefNUV4OOuKA&oe=6AB153C4"}, "display_name": "RunnerVR", "keywords": ["Runner", "Traffic", "Endless", "VR", "Racing"], "long_description": "Gear up for the ultimate high-speed VR survival test!\n\nStep directly onto a roaring highway where every second counts. RunnerVR takes the addictive, fast-paced action of classic endless runners and throws you headfirst into immersive Virtual Reality.\n\nThere are no brakes, no second chances, and no stopping. As you auto-run forward, you\u2019ll need quick reflexes and head-turning awareness to dodge unpredictable traffic, weave through tight lane shifts, and push your limits for the ultimate high score.\n\nKey Features:\nHeart-Pounding VR Perspective: Experience true 1:1 scale speed as massive trucks, sleek cars, and unpredictable vehicles rush right past your face.\n\nSimple Mechanics, Addictive Gameplay: Easy to pick up for anyone, but brutal to master. Just look, steer, dodge, and keep moving!\n\nHigh-Stakes Hazards: One wrong move, one glance away, or one clip of a bumper, and it\u2019s game over.\n\nLeaderboards & High Scores: Beat your personal bests and challenge friends to see who can survive the high-speed chaos the longest.\n\nHow far can you run before the traffic catches up? Put on your headset and test your instincts today!", "short_description": "Feel the adrenaline in RunnerVR as you dodge high-speed traffic on foot! Keep running, weave through tight gaps, and survive the ultimate VR endless racer."}]}, "developer_name": null, "developer_privacy_policy_url": "https://illustratorgraphics.blogspot.com/p/privacy-policy-this-privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Villain Game Studio", "support_website_url": null, "website_url": "https://illustratorgraphics.blogspot.com/p/privacy-policy-this-privacy-policy.html", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1290039447527144"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491823351_1920780458562122_2988340437764757820_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RQ3HtRfVy3YQ7kNvwFJ9-xg&_nc_oc=Ado0VlmHtkA-EKKj0rhGWL2nklTJWxYP7PPi-oMPdsStDLRa0gQUY6eU3wAP41SWjWk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJheP7WNmDwZL2KeKHBuQsbYG4AEDzeULmkVRaibmK2Jw&oe=6AB149AF"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "RunnerVR", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Action", "id": "459781504968480"}, {"topic_name": "Arcade", "id": "1592192974313489"}], "release_date": 1785851940, "lastRevision": {"nodes": [{"id": "123489
id": "1004347199090868", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/491824328_1004347205757534_492762586801624500_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V6ud_AJBHM8Q7kNvwH5z5_e&_nc_oc=Adq9HTekBjk3qEEFUOYkbFPaYvwhiEN2-PNLuHE8Kn_AeN7z3dE3S_VBKf3UiASTAMs&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMC9MuWI4Csab4mUZP6vs-Mo7L0b1VJxPDa-1OySuMaRg&oe=6AC7BED7"}, {"file_name": "ss2.png", "id": "1069768795616817", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/491820910_1069768802283483_4610995521594135687_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=625v7HEiMm4Q7kNvwEk_xQz&_nc_oc=AdqV1xKrBSekMG_WequT5fgBESAiegoBg0VRPaj84WHJDQk__x9QcnUjLhQJUTJXqi8&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN3ocaM_lK_Bt35SxDca9aM9oe2MD2lqKVSvnh6l5Gtrg&oe=6AC7A2A6"}, {"file_name": "ss3.png", "id": "1065038949550150", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/491823259_1065038952883483_7798115157552070041_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nUVkuDAw2SYQ7kNvwFxh0Rn&_nc_oc=Adqtzl4VVHWlXqjcTl61lHSlu_OLW4e1NuNt3upiq4u24cdLI2Ego275IaHJ_Yhi6Q8&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOPlIHZILgG6LAQdnYCYhCovBpD3ZovebLv_yOSiG9sfw&oe=6AC7BF7A"}, {"file_name": "ss4.png", "id": "1748916252799813", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/491823910_1748916262799812_8673216499777066606_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b9BDCxudvmkQ7kNvwHHDsr3&_nc_oc=AdohWIY58BG9OWoituX7AnoFZMT5bUqkRo6oKsIQEVXEDd_NQZ_xTcOZz8ONhHJlMGk&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOUGuCLbfSOT_rll2vHGAjbckEIhb3S1G8xE5myeN7JHA&oe=6AC7A807"}, {"file_name": "ss5.png", "id": "4097768890522775", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/491824318_4097768900522774_100577852223745294_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=82HrSTbNnhoQ7kNvwEMoiB8&_nc_oc=Adra7tAMUe3s0nQ81JK6OM8TUILrSXYhg6ktammHsz4FSFP9cOyMu47PeyVO-XkE6fQ&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQONXF8a6HepvaSnrH1dKW5UuC8aGNW1zRfohjdhpyKgsQ&oe=6AC7BB26"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ss1.png", "id": "1042090438205777", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/491827646_1042090444872443_2259670401269122809_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=63s_VCfiGEAQ7kNvwG-Kk-V&_nc_oc=AdpLVT3H8UmByxHjUaUsnadSyNjG662ae6l-vr3usfhvPe3duZHJYlM_KP4JInP2OJc&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPCpLtVzVmm4JpvK9A5Q2VBIlUjJYTol0_aSQGGwo-jFg&oe=6AC7BD44"}, "display_name": "RunnerVR", "keywords": ["Runner", "Traffic", "Endless", "VR", "Racing"], "long_description": "Gear up for the ultimate high-speed VR survival test!\n\nStep directly onto a roaring highway where every second counts. RunnerVR takes the addictive, fast-paced action of classic endless runners and throws you headfirst into immersive Virtual Reality.\n\nThere are no brakes, no second chances, and no stopping. As you auto-run forward, you\u2019ll need quick reflexes and head-turning awareness to dodge unpredictable traffic, weave through tight lane shifts, and push your limits for the ultimate high score.\n\nKey Features:\nHeart-Pounding VR Perspective: Experience true 1:1 scale speed as massive trucks, sleek cars, and unpredictable vehicles rush right past your face.\n\nSimple Mechanics, Addictive Gameplay: Easy to pick up for anyone, but brutal to master. Just look, steer, dodge, and keep moving!\n\nHigh-Stakes Hazards: One wrong move, one glance away, or one clip of a bumper, and it\u2019s game over.\n\nLeaderboards & High Scores: Beat your personal bests and challenge friends to see who can survive the high-speed chaos the longest.\n\nHow far can you run before the traffic catches up? Put on your headset and test your instincts today!", "short_description": "Feel the adrenaline in RunnerVR as you dodge high-speed traffic on foot! Keep running, weave through tight gaps, and survive the ultimate VR endless racer."}]}, "developer_name": null, "developer_privacy_policy_url": "https://illustratorgraphics.blogspot.com/p/privacy-policy-this-privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Villain Game Studio", "support_website_url": null, "website_url": "https://illustratorgraphics.blogspot.com/p/privacy-policy-this-privacy-policy.html", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1290039447527144"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/491823351_1920780458562122_2988340437764757820_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Hmh7y9EShIMQ7kNvwGIdp1w&_nc_oc=AdqZK4NNM5P3xsn2uMJ4_-Rh0jrcGLfFG4_k-gLTlF1I_oIWCPZVO3hwBecxhBm7fKQ&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO5qcWFh3p_VkTrSlEv0wCkPOr1tAPewrb6FPTl6pYeqA&oe=6AC7B32F"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "RunnerVR", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Action", "id": "459781504968480"}, {"topic_name": "Arcade", "id": "1592192974313489"}], "release_date": 1785851940, "lastRevision": {"nodes": [{"id": "123489
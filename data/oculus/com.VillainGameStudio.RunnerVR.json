id": "1004347199090868", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491824328_1004347205757534_492762586801624500_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OFDI8njnnuAQ7kNvwGyjlWn&_nc_oc=AdrRR8eWZyYgvBXBPGDMZid7YFSka8xp0qzGUjUGe643I6VvZWIKZcGuWY6F8otUOUE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPh0Yv85w_i78wUWqQc0o8EGPlX87eT2fs7_DZrQVxwLA&oe=6ADF79D7"}, {"file_name": "ss2.png", "id": "1069768795616817", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491820910_1069768802283483_4610995521594135687_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7oS3JrJe4m4Q7kNvwE4ocTA&_nc_oc=Adqoo_j2zD3W_iAkuLz0H8_jeZvFWBgrQIAm-omwPWVFj3_T3J2K7fhIeY4UnGhOgQ0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPr7BIurYtf0K2FJYmz77U9dP46Exib3x_ogmLyGqel7w&oe=6ADF5DA6"}, {"file_name": "ss3.png", "id": "1065038949550150", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491823259_1065038952883483_7798115157552070041_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xMXdR8-d8doQ7kNvwF6Y-AJ&_nc_oc=AdoBOuO86QI0O6vHdZJc_QE2kWYrWB2NQz1ZriW3MNAqIUGcMZkMiDBSwrRZGlol9Xo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP6fdqP_DRjvgVDOD6gZHe8f57PawIlCcuunoQTKIm_nA&oe=6ADF7A7A"}, {"file_name": "ss4.png", "id": "1748916252799813", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491823910_1748916262799812_8673216499777066606_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sqoxbtc0UREQ7kNvwFRrtKd&_nc_oc=Adol8gSF6wVVEyqNrtERuqpyuDdsCjV5u7bklZxO3VStVGbLXY945rX5dXPn-CFWw3I&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMA0GFjNYPQjMQmAvrf2uNFlMt7P7ZcC5OiQFsru2J67g&oe=6ADF6307"}, {"file_name": "ss5.png", "id": "4097768890522775", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491824318_4097768900522774_100577852223745294_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=leJHfS_AiqoQ7kNvwHrvPBq&_nc_oc=AdpeQRCYZTAKBGv3iV8ix9wr7DXB5PU9VGiux7lEA9U1PYqZ9M9AAgZFktlVQjwM4z0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM5qU2VShm2FND295p7qGBPhJILDcOZo2JR8IB-0AuimQ&oe=6ADF7626"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ss1.png", "id": "1042090438205777", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491827646_1042090444872443_2259670401269122809_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JWv-jOAgy_MQ7kNvwEgYD8z&_nc_oc=AdoJ5Tg2fgPVGBo7y6mCPmMLWULmaruhv921O3nhjWvsRUD-34NTAHhNl4XziQOF2c4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOqWeW7rnd8-LZwg-Em8I_GhNMkHJ43DgXXcaC2I8IoKA&oe=6ADF7844"}, "display_name": "RunnerVR", "keywords": ["Runner", "Traffic", "Endless", "VR", "Racing"], "long_description": "Gear up for the ultimate high-speed VR survival test!\n\nStep directly onto a roaring highway where every second counts. RunnerVR takes the addictive, fast-paced action of classic endless runners and throws you headfirst into immersive Virtual Reality.\n\nThere are no brakes, no second chances, and no stopping. As you auto-run forward, you\u2019ll need quick reflexes and head-turning awareness to dodge unpredictable traffic, weave through tight lane shifts, and push your limits for the ultimate high score.\n\nKey Features:\nHeart-Pounding VR Perspective: Experience true 1:1 scale speed as massive trucks, sleek cars, and unpredictable vehicles rush right past your face.\n\nSimple Mechanics, Addictive Gameplay: Easy to pick up for anyone, but brutal to master. Just look, steer, dodge, and keep moving!\n\nHigh-Stakes Hazards: One wrong move, one glance away, or one clip of a bumper, and it\u2019s game over.\n\nLeaderboards & High Scores: Beat your personal bests and challenge friends to see who can survive the high-speed chaos the longest.\n\nHow far can you run before the traffic catches up? Put on your headset and test your instincts today!", "short_description": "Feel the adrenaline in RunnerVR as you dodge high-speed traffic on foot! Keep running, weave through tight gaps, and survive the ultimate VR endless racer."}]}, "developer_name": null, "developer_privacy_policy_url": "https://illustratorgraphics.blogspot.com/p/privacy-policy-this-privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Villain Game Studio", "support_website_url": null, "website_url": "https://illustratorgraphics.blogspot.com/p/privacy-policy-this-privacy-policy.html", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1290039447527144"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491823351_1920780458562122_2988340437764757820_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x8fLWfApjhAQ7kNvwFLqAPc&_nc_oc=AdoQMOL_70bK9TfLjZSIsPWby-2EBfYOQcw16QSrNnpWfBDRv0EPbMu4L2V_cdIi6eA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPmapescikKQb3YBAaRrD0wP2BTrG0Ey-zU9flRAJORlA&oe=6ADF6E2F"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "RunnerVR", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Action", "id": "459781504968480"}, {"topic_name": "Arcade", "id": "1592192974313489"}], "release_date": 1785851940, "lastRevision": {"nodes": [{"id": "123489
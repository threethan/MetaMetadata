id": "1004347199090868", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491824328_1004347205757534_492762586801624500_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SEBI7pg2_8kQ7kNvwHEkQM4&_nc_oc=AdpUpfK9Rnqgg31I49x62saXWcXQyhnty_qPVfr4uFLb3l6kFAnp_eJCE2VxYux5Yew&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKpRIKq3y4vlU4StX_TC72BNyq3dtBCwvJa5UJ_AVrnOQ&oe=6ABA8FD7"}, {"file_name": "ss2.png", "id": "1069768795616817", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491820910_1069768802283483_4610995521594135687_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_lejxFLA0ioQ7kNvwG8F-S0&_nc_oc=AdrkZ23Del0dpZuNTT9eDGOGi_X1hu1v0SdrMZ8jvKdpBC9KpM6w3pbtdEFlqfltiI8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK_9SP_TQY8RERZK3b95PqU2rLVT9eQtDNRmYSFCp5m4w&oe=6ABA73A6"}, {"file_name": "ss3.png", "id": "1065038949550150", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491823259_1065038952883483_7798115157552070041_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qdjfxIDx2NQQ7kNvwGD6M8j&_nc_oc=AdpZHSWa1KKSItDehs1P_fxbuHuDknxqN0waJw2iQ1PPM_O6pugmVB_v36D1TIzp7u8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIHUKzM_eG49CIOVLcQlHOex76O2ttlNPu8FCH3vCfhvg&oe=6ABA907A"}, {"file_name": "ss4.png", "id": "1748916252799813", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491823910_1748916262799812_8673216499777066606_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uLRlBcgmcZ4Q7kNvwHV24OC&_nc_oc=Ado6CFf4ssVungAqVetlruFVQ6ly2MJcELqsMNysV39KA2fwP4FFU5avb7Dljzw3hY4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLE_YEr0oA5JaKJ0m6Sat0bfAPNfOlG0rwQ3hyQ3A7r-A&oe=6ABA7907"}, {"file_name": "ss5.png", "id": "4097768890522775", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491824318_4097768900522774_100577852223745294_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Wq92VujZ1O0Q7kNvwEU8zKc&_nc_oc=Adoj6mK1Y20FrHfpxVO3zhYdN4039UO_oxJWPOA3RiEnhZqXZFRDcG1L5b8Y_o0yoIE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL7gHSVdJD87X1LRYFd7QLqddfo5gnmvjhge7h4BlFViA&oe=6ABA8C26"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ss1.png", "id": "1042090438205777", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491827646_1042090444872443_2259670401269122809_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F4pWB9mEzucQ7kNvwF8SDJ2&_nc_oc=AdouOzTGMrTSrLeVCZBimha0KHf82fSlvuwhfSOF06XeuKywVUo5LDfZWx8VgZ4b1Cw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJLlyUMt3VMyFZP-jWsReA6uF3VxB2KpZxBoMXlpoANdQ&oe=6ABA8E44"}, "display_name": "RunnerVR", "keywords": ["Runner", "Traffic", "Endless", "VR", "Racing"], "long_description": "Gear up for the ultimate high-speed VR survival test!\n\nStep directly onto a roaring highway where every second counts. RunnerVR takes the addictive, fast-paced action of classic endless runners and throws you headfirst into immersive Virtual Reality.\n\nThere are no brakes, no second chances, and no stopping. As you auto-run forward, you\u2019ll need quick reflexes and head-turning awareness to dodge unpredictable traffic, weave through tight lane shifts, and push your limits for the ultimate high score.\n\nKey Features:\nHeart-Pounding VR Perspective: Experience true 1:1 scale speed as massive trucks, sleek cars, and unpredictable vehicles rush right past your face.\n\nSimple Mechanics, Addictive Gameplay: Easy to pick up for anyone, but brutal to master. Just look, steer, dodge, and keep moving!\n\nHigh-Stakes Hazards: One wrong move, one glance away, or one clip of a bumper, and it\u2019s game over.\n\nLeaderboards & High Scores: Beat your personal bests and challenge friends to see who can survive the high-speed chaos the longest.\n\nHow far can you run before the traffic catches up? Put on your headset and test your instincts today!", "short_description": "Feel the adrenaline in RunnerVR as you dodge high-speed traffic on foot! Keep running, weave through tight gaps, and survive the ultimate VR endless racer."}]}, "developer_name": null, "developer_privacy_policy_url": "https://illustratorgraphics.blogspot.com/p/privacy-policy-this-privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Villain Game Studio", "support_website_url": null, "website_url": "https://illustratorgraphics.blogspot.com/p/privacy-policy-this-privacy-policy.html", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1290039447527144"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491823351_1920780458562122_2988340437764757820_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VSOfx0fpK3YQ7kNvwGGNSde&_nc_oc=AdoPzG1AFrwzIb9hjtVWq8W3xq3kAVpv2OiR7GF8ixyIJy8pygy9iWBt2U8afBULJFY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKN3SjXDMQun-JZzB_SLtR1sY-W-Qy20MELvQfeg7MNyA&oe=6ABA842F"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "RunnerVR", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Action", "id": "459781504968480"}, {"topic_name": "Arcade", "id": "1592192974313489"}], "release_date": 1785851940, "lastRevision": {"nodes": [{"id": "123489
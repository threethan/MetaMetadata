ng", "id": "1004347199090868", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/491824328_1004347205757534_492762586801624500_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n09dXbYUF_kQ7kNvwH8-4U3&_nc_oc=AdrAQ9k1fTuVpDVwgZ-_YWpxRXO2AyP2QkUk0VVZ7JcJZ5SGxELCp20sAo4edN--U2I&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIOoDgTUjXjpCdXgE9WWp5PEGH5uTCNNuErKKydbPmwkw&oe=6AAEB257"}, {"file_name": "ss2.png", "id": "1069768795616817", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/491820910_1069768802283483_4610995521594135687_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LCmc9cafKP0Q7kNvwGyll5H&_nc_oc=Adr3ktH2fd_0nNlVJ3CZLIBqDX_tV5iFWxdzCzaAtOroigfaknBls34iv1ylC4g-JMc&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ-w1G_KWeA9AYt0u804LouhKLFQqXsmzEEz4f3gyPXag&oe=6AAE9626"}, {"file_name": "ss3.png", "id": "1065038949550150", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/491823259_1065038952883483_7798115157552070041_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FQbqp9-w4x8Q7kNvwG70GA4&_nc_oc=Adr-syrMh0gZXxqb7Bn-2Y6Jxg7Iz7hEI9TaH3pIdRGJOiJKbyqbGM5fS7ufVqt9xCQ&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLJ2PqIfdBcVsFVV36eHVAoUZrlut8JgZRS7k6-Tch0Gw&oe=6AAEB2FA"}, {"file_name": "ss4.png", "id": "1748916252799813", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/491823910_1748916262799812_8673216499777066606_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2F4PrKgMMDUQ7kNvwGautnw&_nc_oc=AdqVcK8NCB4mk7Vc82tYmAG0WRJY-ya50NudsLMxPFfgQ61mPKy9HyH8_IStMEjWKU0&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLUdi50pROxDBWwLyizGK-nod-MBXWrkGHxCjKApxfAUA&oe=6AAE9B87"}, {"file_name": "ss5.png", "id": "4097768890522775", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/491824318_4097768900522774_100577852223745294_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yxxwIQZZP-UQ7kNvwE-UyFj&_nc_oc=AdrONDlwnUKmeq0dCmxsvfKbuWAqdD_0FPvmtQKMfQKMdza5M623jvhJmshSy36Fox8&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ2iOGlLzLTocqP0mprQ01ccwRzzj7rdbuw8GO7aKohaw&oe=6AAEAEA6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ss1.png", "id": "1042090438205777", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/491827646_1042090444872443_2259670401269122809_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eL4IoPQXnOIQ7kNvwGdd8rk&_nc_oc=AdpGzXMjnSvQJ4ex8GlC3lQ3KkqqK5-xIxXt6JITqbiWl4fX0I9WgRgaxiQHkK7bEds&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIY0l4k4e2pyC-PjxsCsLC9ZBvOm0TeIGFuPDl9uz4QBQ&oe=6AAEB0C4"}, "display_name": "RunnerVR", "keywords": ["Runner", "Traffic", "Endless", "VR", "Racing"], "long_description": "Gear up for the ultimate high-speed VR survival test!\n\nStep directly onto a roaring highway where every second counts. RunnerVR takes the addictive, fast-paced action of classic endless runners and throws you headfirst into immersive Virtual Reality.\n\nThere are no brakes, no second chances, and no stopping. As you auto-run forward, you\u2019ll need quick reflexes and head-turning awareness to dodge unpredictable traffic, weave through tight lane shifts, and push your limits for the ultimate high score.\n\nKey Features:\nHeart-Pounding VR Perspective: Experience true 1:1 scale speed as massive trucks, sleek cars, and unpredictable vehicles rush right past your face.\n\nSimple Mechanics, Addictive Gameplay: Easy to pick up for anyone, but brutal to master. Just look, steer, dodge, and keep moving!\n\nHigh-Stakes Hazards: One wrong move, one glance away, or one clip of a bumper, and it\u2019s game over.\n\nLeaderboards & High Scores: Beat your personal bests and challenge friends to see who can survive the high-speed chaos the longest.\n\nHow far can you run before the traffic catches up? Put on your headset and test your instincts today!", "short_description": "Feel the adrenaline in RunnerVR as you dodge high-speed traffic on foot! Keep running, weave through tight gaps, and survive the ultimate VR endless racer."}]}, "developer_name": null, "developer_privacy_policy_url": "https://illustratorgraphics.blogspot.com/p/privacy-policy-this-privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Villain Game Studio", "support_website_url": null, "website_url": "https://illustratorgraphics.blogspot.com/p/privacy-policy-this-privacy-policy.html", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1290039447527144"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/491823351_1920780458562122_2988340437764757820_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RQ3HtRfVy3YQ7kNvwFutf5O&_nc_oc=AdpR0cdSbqX9HN73eL0CnZAUin4p35u5pSfj-WGAKmlVQSLgbxOnHmf5rz5vQwusQpE&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJVcVNbJQP88Wu_T0QNR0dMmrACHAU7EZOh8s7ky1oHNA&oe=6AAEA6AF"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "RunnerVR", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Action", "id": "459781504968480"}, {"topic_name": "Arcade", "id": "1592192974313489"}], "release_date": 1785851940, "lastRevision": {"nodes": [{"id
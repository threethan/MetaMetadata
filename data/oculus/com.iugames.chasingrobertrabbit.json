2798765736878123", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/12482172_545890772430920_5739429140549861376_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TT4_XGB4I6AQ7kNvwE1zJ17&_nc_oc=AdkvpkCUdOh-493mcV3B3N1xnVroXvbvn5EQ6IT9QCu_-2vUgDALwBxkN_KAxz4wSyM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfthZ_60mvQV2fntLSD1GkyWiLku7G7e9P4ejNsUPIeSXQ&oe=699DB1F2"}, {"file_name": "migrated_image.png", "id": "1388395454680116", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/12533876_163744050923621_8287985935686041600_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8_k3G2s0xBYQ7kNvwE2DYjs&_nc_oc=Adl4HK7TFsxO3rettZa5_2wYpQW0uT5dcTI0pyl7t8-BO6ZpRNUMN0uqL3rDR5ltVLQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AftBKeeMs8lcNPobd-AFNqAh-6Fm5CadvfPOVR68867nZg&oe=699DAD8B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_art - 2.png", "id": "829541637228382", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/12427537_829541640561715_4290524620483723264_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rkqHkd0rJ_AQ7kNvwF3ARz-&_nc_oc=AdlN9oOa9I2tVoX2KR9PR9r8lYf7Tmd3ihX9slEB3SWlm0lu0LlGj2LycOXpBd4lHV8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfuQ6C2JLb4HYk3y7BiA-06M7bn2l7QkH9zVo9XWjgGoBw&oe=699D94B6"}, "display_name": "Chasing Robert Rabbit", "keywords": ["cartoon", "rabbit", "fun"], "long_description": "This old film projector you've just received in your office has some very strange properties: it lets real people get inside cartoons, and people from cartoons go out in the real world.\n Unfortunately it let Robert the cartoon Rabbit sneak inside your office and steal all your gold. Now you have no choice but to follow him inside all his cartoon adventures, and take back your gold!\n\nFight against a super realistic AI enemy. Always watch your back! This is not a game, it's a real hunt!\nCollect your gold across different levels to unlock and buy crazy cartoon weapons, and unlock new levels! \n\nThree levels currently available:\n-The Labyrinth\n-The Museum\n-Candy World", "short_description": "A one-to-one hunt against a crazy AI!\n\nRobert Rabbit stole your gold and went back hiding in his cartoon. Chase him across all his cartoon episodes to take back your gold!\n\nFight against a super realistic AI enemy. Always watch your back! This is not a game, it's a real hunt!\nCollect your gold across different episodes to unlock and buy crazy cartoon weapons.  \n\nThree levels currently available:\n-Hit the Rabbit\n-Night at the Museum\n-Candy Crush"}]}, "developer_name": "InterUniversal Games", "developer_privacy_policy_url": "https://www.chasingrobertrabbit.com/terms-of-service-and-privacy-policy", "developer_terms_of_service_url": "https://www.chasingrobertrabbit.com/terms-of-service-and-privacy-policy", "publisher_name": "InterUniversal Games", "support_website_url": null, "website_url": "http://chasingrobertrabbit.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ACTION", "ADVENTURE", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD", "GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "3152848178284211"}}]}, "scheduled_offers": {"count": 0, "nodes": []}, "baseline_offer": null, "is_approved": true, "firstOffer": {"nodes": []}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "2185435178139393", "version": "1.2.5"}, "id": "443021942765090", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBi
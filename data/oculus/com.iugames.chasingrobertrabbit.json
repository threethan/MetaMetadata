-2.oculuscdn.com/v/t64.5771-25/12386259_152790418727863_4170456404542357504_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A5dAbFhtkK8Q7kNvwGzmi90&_nc_oc=Adrhsbnu95j6P8lNasNkga-7G-2cxmXzryBikKIQEfqtd03BqHkTqj_N2rKetN9LbRU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNWozK1QEQjdGGxGDAAvmOPYAUF_kh9sfkiMRcffqpAlg&oe=6ACE4DB4"}, {"file_name": "migrated_image.png", "id": "215645256181208", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/11162732_1971227563202281_2310204144775856128_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2rq9No9qzVMQ7kNvwGE3Naa&_nc_oc=AdolvBlAdNDreqBJLH5155H-LhDAWbmfA9w0n0JJdrpsHD7IUCT70lIx-pV2z1QtZms&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPXaiACvjv3gjptKzVD1yQBQuTrHydcErePX8v17w-yxA&oe=6ACE355E"}, {"file_name": "migrated_image.png", "id": "2798765736878123", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/12482172_545890772430920_5739429140549861376_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aPOcsBt6dzYQ7kNvwFdjW1j&_nc_oc=Adp4OAzMltnEGrA2mteKYwi0SC2wuvjGY_nJZl1tnpSVx7FLAIoSielBVysT0U2TRTo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPFH-KLnkNlRfEj5wMZALsxSIC7Qo9webByO-oCWpNNgg&oe=6ACE3C72"}, {"file_name": "migrated_image.png", "id": "1388395454680116", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/12533876_163744050923621_8287985935686041600_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xWhIx7KxYnsQ7kNvwETs-ol&_nc_oc=AdpE0BcG9vyYzbZRXh9RnzGR-SpY6N4QDPpIlTmMkPRwxvcKC7Zo_EvzQxKZhUeeAUE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN_TDWpSfdVxDJjylVX2pNpFno6JZD8TGgdJjUTsVP9gQ&oe=6ACE380B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_art - 2.png", "id": "829541637228382", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12427537_829541640561715_4290524620483723264_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M4_DKgdsjsYQ7kNvwEAFOca&_nc_oc=AdqqLnyX1bR4kD8AowW_PmYRC13gy2C2hskKI7RXXK1vG-Jo6ihL1ThGMg2wI7FPBS4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOJnXJnzTNhwCWl82J2DavKAzSrdWIiMX1uBgkSRXXfuw&oe=6ACE5776"}, "display_name": "Chasing Robert Rabbit", "keywords": ["cartoon", "rabbit", "fun"], "long_description": "This old film projector you've just received in your office has some very strange properties: it lets real people get inside cartoons, and people from cartoons go out in the real world.\n Unfortunately it let Robert the cartoon Rabbit sneak inside your office and steal all your gold. Now you have no choice but to follow him inside all his cartoon adventures, and take back your gold!\n\nFight against a super realistic AI enemy. Always watch your back! This is not a game, it's a real hunt!\nCollect your gold across different levels to unlock and buy crazy cartoon weapons, and unlock new levels! \n\nThree levels currently available:\n-The Labyrinth\n-The Museum\n-Candy World", "short_description": "A one-to-one hunt against a crazy AI!\n\nRobert Rabbit stole your gold and went back hiding in his cartoon. Chase him across all his cartoon episodes to take back your gold!\n\nFight against a super realistic AI enemy. Always watch your back! This is not a game, it's a real hunt!\nCollect your gold across different episodes to unlock and buy crazy cartoon weapons.  \n\nThree levels currently available:\n-Hit the Rabbit\n-Night at the Museum\n-Candy Crush"}]}, "developer_name": "InterUniversal Games", "developer_privacy_policy_url": "https://www.chasingrobertrabbit.com/terms-of-service-and-privacy-policy", "developer_terms_of_service_url": "https://www.chasingrobertrabbit.com/terms-of-service-and-privacy-policy", "publisher_name": "InterUniversal Games", "support_website_url": null, "website_url": "http://chasingrobertrabbit.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ACTION", "ADVENTURE", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD", "GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "3152848178284211"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/11162696_1452076451543047_2573838557483368448_n.png?stp=dst-png_s360x360&_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Sb1DQgYVWJcQ7kNvwFx0Lxz&_nc_oc=AdqSyFp-LMOS2jPYmnvQKUU9y17XZoFcR-YifJOh8DxfGMJI6DtTZ9Y7VCknfy1s6vY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNEAngyLXpgS1IKn8Hr87AkSY4fJHkuhBGpR2fcqRYG8g&oe=6ACE5375"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Chasing Robert Rabbit", "platform": "ANDROID", "context_category": null, "context_topics": [], "release_date": 1517334118, "lastRevision": {"nodes": [{"id": "1854044491590779", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "1996253540390892", "is_first_party": false, "enables_in_app_ads": false, "is_concept": false, "platform": "ANDROID"}, "iarc_cert": {"id": "316755615401071"}, "iarc_email": null, "msrp": null, "translations": {"nodes": [{"images": {"nodes": [{"file_name": "migrated_image.png", "id": "881911458908510", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/11162707_273713989800733_5864140254792908800_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YOU_dEzfUioQ7kNvwFleXwG&_nc_oc=AdqiKkOzN4D-ONeaWqf5O7W-d38ldenuFDeyGhcLaBFfHBjyBQywxxWoYBCLgvZa9t0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOL-WeOuwfx0mbl-WqIk8t8E0VNjMlGzvtkb1NpNxeuog&oe=6AC
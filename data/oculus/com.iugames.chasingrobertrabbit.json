-2.oculuscdn.com/v/t64.5771-25/12386259_152790418727863_4170456404542357504_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IV4EDIjpbnMQ7kNvwHy9lWK&_nc_oc=AdpGgrkXdUc9ShaLU3SHWWtJx2isF8uXR10wx6ZYMzwLS6q13CtbhDdkMw_SGzXNh2U&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3CUyTGgd7H1_xmDwYCq-IIeHpUxmdOlnjL8RgqhPO0Qg&oe=69EB8BB4"}, {"file_name": "migrated_image.png", "id": "215645256181208", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/11162732_1971227563202281_2310204144775856128_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1jI9VbHnbVcQ7kNvwGxn2Yc&_nc_oc=AdqML9dY897TKpfQg3yGZJSpalApmcUCMpJ_Ja0PxPmsMLjBgCBkPErTgx-5c7Q-uaM&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2bURPG8GjtUbKeGMyagfhUhkXAtf82ys2eVFpLJCmCIQ&oe=69EB735E"}, {"file_name": "migrated_image.png", "id": "2798765736878123", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12482172_545890772430920_5739429140549861376_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BpkFqReQmW4Q7kNvwGNkcZB&_nc_oc=Adpopj83s0j14qK8Pdrr8Bi39VTzrvA9BZwKjYeipjYccagIIOWySSX9hthQ7MF-jM0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1Et94ks2gqp4upAOEqUbJ_V9nJ3SG-KHRc_zsGRvkTuw&oe=69EB7A72"}, {"file_name": "migrated_image.png", "id": "1388395454680116", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/12533876_163744050923621_8287985935686041600_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Fux6Vonx9XkQ7kNvwGxQ5Gj&_nc_oc=AdrP8XmUgrrPasMZDlevAsh5rBebMX7dFQbJxkUPjwHtDD-LzkkNA48xIfWW0sUyQyw&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1PWxga8MFeIPV3vVPsE0lDWPGPjsyfjNeNefDMZ546lQ&oe=69EB760B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_art - 2.png", "id": "829541637228382", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/12427537_829541640561715_4290524620483723264_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HQAE25zTWpgQ7kNvwFPpb_9&_nc_oc=AdoCD8UnoANn40ZtXqKytxwd2Df29H950nhQ252jOqCoWq6JBB3xtWCyjfKd807JzTE&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1BqBFmZv4cpDOxHwfk7dPYRhsJ4oiMrArSMUg3n1iDmA&oe=69EB5D36"}, "display_name": "Chasing Robert Rabbit", "keywords": ["cartoon", "rabbit", "fun"], "long_description": "This old film projector you've just received in your office has some very strange properties: it lets real people get inside cartoons, and people from cartoons go out in the real world.\n Unfortunately it let Robert the cartoon Rabbit sneak inside your office and steal all your gold. Now you have no choice but to follow him inside all his cartoon adventures, and take back your gold!\n\nFight against a super realistic AI enemy. Always watch your back! This is not a game, it's a real hunt!\nCollect your gold across different levels to unlock and buy crazy cartoon weapons, and unlock new levels! \n\nThree levels currently available:\n-The Labyrinth\n-The Museum\n-Candy World", "short_description": "A one-to-one hunt against a crazy AI!\n\nRobert Rabbit stole your gold and went back hiding in his cartoon. Chase him across all his cartoon episodes to take back your gold!\n\nFight against a super realistic AI enemy. Always watch your back! This is not a game, it's a real hunt!\nCollect your gold across different episodes to unlock and buy crazy cartoon weapons.  \n\nThree levels currently available:\n-Hit the Rabbit\n-Night at the Museum\n-Candy Crush"}]}, "developer_name": "InterUniversal Games", "developer_privacy_policy_url": "https://www.chasingrobertrabbit.com/terms-of-service-and-privacy-policy", "developer_terms_of_service_url": "https://www.chasingrobertrabbit.com/terms-of-service-and-privacy-policy", "publisher_name": "InterUniversal Games", "support_website_url": null, "website_url": "http://chasingrobertrabbit.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ACTION", "ADVENTURE", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD", "GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "3152848178284211"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/11162696_1452076451543047_2573838557483368448_n.png?stp=dst-png_s360x360&_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wJp2cDPBWyQQ7kNvwGflgpP&_nc_oc=Adp11CFOdIC7Gln9jnDCgm0NniyX-q8USQWTvO-LvDZFDA_Va0vcm8ziKDfWeFdkOlg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3qaJmgWj83l7UAtI1NrtZmck0jgRMnKmibHOFH-bZK5w&oe=69EB5935"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Chasing Robert Rabbit", "platform": "ANDROID", "context_category": null, "context_topics": [], "release_date": 1517334118, "lastRevision": {"nodes": [{"id": "1854044491590779", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "1996253540390892", "is_first_party": false, "enables_in_app_ads": false, "is_concept": false, "platform": "ANDROID"}, "iarc_cert": {"id": "316755615401071"}, "iarc_email": null, "msrp": null, "translations": {"nodes": [{"images": {"nodes": [{"file_name": "migrated_image.png", "id": "881911458908510", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/11162707_273713989800733_5864140254792908800_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=X4lUhDfnGfcQ7kNvwHXopHz&_nc_oc=AdqViDgEQ1qm8rcxd32eGp9ebV-tMtNlaRBs68jfT7nVF3bbTGcpXMW2_KCf9Fbj93A&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3NUuRbp2yDdpYWHv5iWZ3xDNh-krJAMxChOoOCdIj7BQ&oe=69E
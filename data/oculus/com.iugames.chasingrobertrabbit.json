-1.oculuscdn.com/v/t64.5771-25/12386259_152790418727863_4170456404542357504_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y-2nqz_hwdMQ7kNvwEp0inT&_nc_oc=AdqO4YoUEr1SxCTxrZGKskmEkAOOZ9zlTVafKc1LNkVjxv9e_HKrWykSQb85VCjxqqQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDsOizhPPvmgAwIJTu6lSiLDGuVt8_-QlDzXhhYd0PYEw&oe=6A576E74"}, {"file_name": "migrated_image.png", "id": "215645256181208", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/11162732_1971227563202281_2310204144775856128_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uTvlkz1E65kQ7kNvwETQfcc&_nc_oc=Adrmtp-L339shZ8N4y7tMsg3o_72yIF9UzRSox67QO8I8Jv6HZbzDKsGnqKG9r13znk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB227LAXAEA9DMWOAFHPlkKey8o4yRRONuCF_73czz1iA&oe=6A578E5E"}, {"file_name": "migrated_image.png", "id": "2798765736878123", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/12482172_545890772430920_5739429140549861376_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8svAeBycDzgQ7kNvwE3f2V4&_nc_oc=AdqsyRr3kmegY11dL0rBK2MXUWwB3FPIT0yIxV3kN1iTi5l8LtwELQ-2URMJYceE9QY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAc9YhFeMGzSc3Y9OsYcnOWqWZ3aZ7BkEq1ptAYwmrkTg&oe=6A579572"}, {"file_name": "migrated_image.png", "id": "1388395454680116", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12533876_163744050923621_8287985935686041600_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ShZv5-XNSJYQ7kNvwGD4CxY&_nc_oc=AdrTdW7VGOWN3ApmNGiK4fw10tH8YQF1f-p0CKAQCVgaFJMGYq5g-X9gtsiYFKBY2K4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD4XfIHn3c0D682IF1AZKoEv3yTfTClzbwzwqUMkcqnQQ&oe=6A57910B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_art - 2.png", "id": "829541637228382", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12427537_829541640561715_4290524620483723264_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ggk11DCUOeAQ7kNvwHEJrUt&_nc_oc=AdoP9Rnel3gNOuPm0gu52BtV4uVeJib2m0FoY5ppmXAzzIGJjgbhQjsNo0k1GVaDf04&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBR7EajGtbFipZpBwNj_j8QOFTgBfE41llUAYxAuQUrPA&oe=6A577836"}, "display_name": "Chasing Robert Rabbit", "keywords": ["cartoon", "rabbit", "fun"], "long_description": "This old film projector you've just received in your office has some very strange properties: it lets real people get inside cartoons, and people from cartoons go out in the real world.\n Unfortunately it let Robert the cartoon Rabbit sneak inside your office and steal all your gold. Now you have no choice but to follow him inside all his cartoon adventures, and take back your gold!\n\nFight against a super realistic AI enemy. Always watch your back! This is not a game, it's a real hunt!\nCollect your gold across different levels to unlock and buy crazy cartoon weapons, and unlock new levels! \n\nThree levels currently available:\n-The Labyrinth\n-The Museum\n-Candy World", "short_description": "A one-to-one hunt against a crazy AI!\n\nRobert Rabbit stole your gold and went back hiding in his cartoon. Chase him across all his cartoon episodes to take back your gold!\n\nFight against a super realistic AI enemy. Always watch your back! This is not a game, it's a real hunt!\nCollect your gold across different episodes to unlock and buy crazy cartoon weapons.  \n\nThree levels currently available:\n-Hit the Rabbit\n-Night at the Museum\n-Candy Crush"}]}, "developer_name": "InterUniversal Games", "developer_privacy_policy_url": "https://www.chasingrobertrabbit.com/terms-of-service-and-privacy-policy", "developer_terms_of_service_url": "https://www.chasingrobertrabbit.com/terms-of-service-and-privacy-policy", "publisher_name": "InterUniversal Games", "support_website_url": null, "website_url": "http://chasingrobertrabbit.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ACTION", "ADVENTURE", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD", "GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "3152848178284211"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/11162696_1452076451543047_2573838557483368448_n.png?stp=dst-png_s360x360&_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SRtquuzBPBIQ7kNvwFDrBA2&_nc_oc=AdrXTsIyUAezMvmXs1BHQuZX_XmygAEI0eOS25D9ninY48duNeQoiAsbC7EqXFi0vII&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA0JPoVR9ih7iitZ8jWrqpivA_Uvipe0ItXLuem76ucjw&oe=6A577435"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Chasing Robert Rabbit", "platform": "ANDROID", "context_category": null, "context_topics": [], "release_date": 1517334118, "lastRevision": {"nodes": [{"id": "1854044491590779", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "1996253540390892", "is_first_party": false, "enables_in_app_ads": false, "is_concept": false, "platform": "ANDROID"}, "iarc_cert": {"id": "316755615401071"}, "iarc_email": null, "msrp": null, "translations": {"nodes": [{"images": {"nodes": [{"file_name": "migrated_image.png", "id": "881911458908510", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/11162707_273713989800733_5864140254792908800_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aPK4uSIW4W4Q7kNvwH5PqG5&_nc_oc=AdrScvcKAzhTck7TsMaxCaJvPgkfSMJsj67X4jX0ExC83V1uaDJ4cnStWG_7HNX2cSw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCXhyGemA7MW3-rCpm8OfwSYPCAlpfuttBopgw0IdF-Ug&oe=6A5
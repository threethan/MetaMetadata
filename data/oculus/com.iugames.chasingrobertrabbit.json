-1.oculuscdn.com/v/t64.5771-25/12386259_152790418727863_4170456404542357504_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tj-IwXi_Jr8Q7kNvwGwLXVX&_nc_oc=Adr3HIvTZBlDtiNreFcLB_zpx6uxenXFm25flR02RiCSHaLr4BxmVhfOFIOTJcy_LAM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8f7W_XbA17tTPliY6o-ZYjcN84S3kEcd8tj5jt2P6Vpw&oe=6A298234"}, {"file_name": "migrated_image.png", "id": "215645256181208", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/11162732_1971227563202281_2310204144775856128_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gsOUysvlCEEQ7kNvwHRs-me&_nc_oc=Ado_OTsGE3VoDd4BJPUbnXqJjbS48Qbxb3aPmYYvly4dTABNEB4nvFopAADalJyCoIc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-cfmJ1OHdOEPFShPclG890FfDchXaTdG6prSkBa5ZXYg&oe=6A2969DE"}, {"file_name": "migrated_image.png", "id": "2798765736878123", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12482172_545890772430920_5739429140549861376_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LYuzxfw4F1IQ7kNvwFNYMpi&_nc_oc=Adq-jRcj5QsvyWtpdru0a_blipPUFs4KAJqT9B8gzjXJLfxGBfBLpcLkc_S9vnMWgFQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9BEq7LqQRR5mmba6Zi2gDimJu5L0yQnxu-fxUvaDorgQ&oe=6A2970F2"}, {"file_name": "migrated_image.png", "id": "1388395454680116", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12533876_163744050923621_8287985935686041600_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_IvR7YsE0sAQ7kNvwFBVAKD&_nc_oc=AdrkC3NLmpJhE7pUOK1bXMq-U38Rr_TtV57C3HYeSTlIAyY5Qs5GwRQBTu7x-p0uibY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-olFF3l0HK30iXYt9wYKTJhpFzCGlqsktIbGyjXTTpHA&oe=6A296C8B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_art - 2.png", "id": "829541637228382", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12427537_829541640561715_4290524620483723264_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j8PtRwSgtYoQ7kNvwFXmqpn&_nc_oc=AdqHYCCiK0X-ffCW894CUoTdkxCULEe2LDae4pP9gk1XzTizQBnq26sFJ6yV8wTw_F4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9uHoWkXaEFuTWEOjJVlNLNU-grxNJHLTqRPk8e1kWKHQ&oe=6A2953B6"}, "display_name": "Chasing Robert Rabbit", "keywords": ["cartoon", "rabbit", "fun"], "long_description": "This old film projector you've just received in your office has some very strange properties: it lets real people get inside cartoons, and people from cartoons go out in the real world.\n Unfortunately it let Robert the cartoon Rabbit sneak inside your office and steal all your gold. Now you have no choice but to follow him inside all his cartoon adventures, and take back your gold!\n\nFight against a super realistic AI enemy. Always watch your back! This is not a game, it's a real hunt!\nCollect your gold across different levels to unlock and buy crazy cartoon weapons, and unlock new levels! \n\nThree levels currently available:\n-The Labyrinth\n-The Museum\n-Candy World", "short_description": "A one-to-one hunt against a crazy AI!\n\nRobert Rabbit stole your gold and went back hiding in his cartoon. Chase him across all his cartoon episodes to take back your gold!\n\nFight against a super realistic AI enemy. Always watch your back! This is not a game, it's a real hunt!\nCollect your gold across different episodes to unlock and buy crazy cartoon weapons.  \n\nThree levels currently available:\n-Hit the Rabbit\n-Night at the Museum\n-Candy Crush"}]}, "developer_name": "InterUniversal Games", "developer_privacy_policy_url": "https://www.chasingrobertrabbit.com/terms-of-service-and-privacy-policy", "developer_terms_of_service_url": "https://www.chasingrobertrabbit.com/terms-of-service-and-privacy-policy", "publisher_name": "InterUniversal Games", "support_website_url": null, "website_url": "http://chasingrobertrabbit.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ACTION", "ADVENTURE", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD", "GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "3152848178284211"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/11162696_1452076451543047_2573838557483368448_n.png?stp=dst-png_s360x360&_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=afIKZDU2xpsQ7kNvwG7lLm4&_nc_oc=AdqnC8Y8AOLscVvJ82M2p80vg901XWG9aop1K8tHTgWpWHbNf1fBIhurdOWeHzktMgA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9fGGC-lNevG0MMF9qXKfh1suToj3rzO68MgmysIMZtlw&oe=6A2987F5"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Chasing Robert Rabbit", "platform": "ANDROID", "context_category": null, "context_topics": [], "release_date": 1517334118, "lastRevision": {"nodes": [{"id": "1854044491590779", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "1996253540390892", "is_first_party": false, "enables_in_app_ads": false, "is_concept": false, "platform": "ANDROID"}, "iarc_cert": {"id": "316755615401071"}, "iarc_email": null, "msrp": null, "translations": {"nodes": [{"images": {"nodes": [{"file_name": "migrated_image.png", "id": "881911458908510", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/11162707_273713989800733_5864140254792908800_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TL7FKH0DetMQ7kNvwFcNqtS&_nc_oc=AdpZTqZ1J6Awzw-y38S2V1fsGh25ZR3ZhJWIrVnupW5FgXbW52_3oOHvNMot7VWv37Q&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_Oaq6S1jXptUhjLmvhQZ02yd777Le_tYf2hEYoXEifRQ&oe=6A2
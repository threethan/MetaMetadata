-1.oculuscdn.com/v/t64.5771-25/12386259_152790418727863_4170456404542357504_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-zxz-3ionX4Q7kNvwG32zmu&_nc_oc=AdqqGuG2e_rieSUvKeEWEtX2cJlY3reBCwIrQPJXFLWLg8xlwbPb-O4blBDbECea-ZY&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0qNVrs7Qhytz9zVg387Gduh7CnC5Wo_g473YW2m_LJKw&oe=69D78CF4"}, {"file_name": "migrated_image.png", "id": "215645256181208", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/11162732_1971227563202281_2310204144775856128_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GzDKnMgOzrgQ7kNvwEF9kw4&_nc_oc=AdqFsb9XqW9on_mpFPHOCairfX4DAw_b6aP2o3mIvgprYxqK78GkEqt403FFvEdoQ1Q&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3giPHS1cGxTRfsA0A7qS9T78g__hKhcy1Gyz3QhjHMnA&oe=69D7ACDE"}, {"file_name": "migrated_image.png", "id": "2798765736878123", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/12482172_545890772430920_5739429140549861376_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3sG7BshK_ukQ7kNvwFTpatZ&_nc_oc=AdqRMZJ77dVb0keGdBa9HdxDhBhv_c3XTWawh456oasIbG261OO83HyIqi7b51y68lo&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af01uGtVPavFPzr_PPwTOmGwGEUgOifGL0f1JsROxWOLog&oe=69D7B3F2"}, {"file_name": "migrated_image.png", "id": "1388395454680116", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/12533876_163744050923621_8287985935686041600_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5ak2qikN23QQ7kNvwEs0CLx&_nc_oc=Adr3wxb7J2_-kBHPz35piadiO26PCz03fLXtTUL2NyWyQeXoNIXsuMc2Izw3jX-hEbw&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1LZBSGn7p-FKlcrdxG3GQBcP3ABZ_zYJ-KTLXMc1Q3uQ&oe=69D7AF8B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_art - 2.png", "id": "829541637228382", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/12427537_829541640561715_4290524620483723264_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JnD8nfbwfdwQ7kNvwGlYYeO&_nc_oc=AdrwTT218D6t0DBYXGsXk2jeiza3jaCRmlT1AIBb3Vj9pktuXipck77CWYD8Bgi3yK0&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0jLjjDfhSsgikLEBg02z7qGb2J41m5OCJFp94qM-r_Aw&oe=69D796B6"}, "display_name": "Chasing Robert Rabbit", "keywords": ["cartoon", "rabbit", "fun"], "long_description": "This old film projector you've just received in your office has some very strange properties: it lets real people get inside cartoons, and people from cartoons go out in the real world.\n Unfortunately it let Robert the cartoon Rabbit sneak inside your office and steal all your gold. Now you have no choice but to follow him inside all his cartoon adventures, and take back your gold!\n\nFight against a super realistic AI enemy. Always watch your back! This is not a game, it's a real hunt!\nCollect your gold across different levels to unlock and buy crazy cartoon weapons, and unlock new levels! \n\nThree levels currently available:\n-The Labyrinth\n-The Museum\n-Candy World", "short_description": "A one-to-one hunt against a crazy AI!\n\nRobert Rabbit stole your gold and went back hiding in his cartoon. Chase him across all his cartoon episodes to take back your gold!\n\nFight against a super realistic AI enemy. Always watch your back! This is not a game, it's a real hunt!\nCollect your gold across different episodes to unlock and buy crazy cartoon weapons.  \n\nThree levels currently available:\n-Hit the Rabbit\n-Night at the Museum\n-Candy Crush"}]}, "developer_name": "InterUniversal Games", "developer_privacy_policy_url": "https://www.chasingrobertrabbit.com/terms-of-service-and-privacy-policy", "developer_terms_of_service_url": "https://www.chasingrobertrabbit.com/terms-of-service-and-privacy-policy", "publisher_name": "InterUniversal Games", "support_website_url": null, "website_url": "http://chasingrobertrabbit.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ACTION", "ADVENTURE", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD", "GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "3152848178284211"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/11162696_1452076451543047_2573838557483368448_n.png?stp=dst-png_s360x360&_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_-87VW8upD0Q7kNvwGvoGLi&_nc_oc=Adpmur1HdpHzwX-eiS5O2vMb2C4SBjPo8HJRGuX2RPVHMc1iym1O1azHoHjmAgYPwWA&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3sw19jLjo1lwGCPtVVCh60_6NgyMNd_W8eDnW5w1dLeQ&oe=69D792B5"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Chasing Robert Rabbit", "platform": "ANDROID", "context_category": null, "context_topics": [], "release_date": 1517334118, "lastRevision": {"nodes": [{"id": "1854044491590779", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "1996253540390892", "is_first_party": false, "enables_in_app_ads": false, "is_concept": false, "platform": "ANDROID"}, "iarc_cert": {"id": "316755615401071"}, "iarc_email": null, "msrp": null, "translations": {"nodes": [{"images": {"nodes": [{"file_name": "migrated_image.png", "id": "881911458908510", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/11162707_273713989800733_5864140254792908800_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QMF4iFYzkpQQ7kNvwF9p3Tx&_nc_oc=AdqKWmsc-i17WN_kSfZcSmCPcPaKEXdHpkdUQ7EvyMYJCroLRIuvnSsLJT_Alz7e620&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1MAcphgr_YCnUYT1qv5B2ebow6hw88eqHsG3DQ3v1IHw&oe=69D
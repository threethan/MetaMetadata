-1.oculuscdn.com/v/t64.5771-25/12386259_152790418727863_4170456404542357504_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OusL-VoOJUEQ7kNvwF42YMQ&_nc_oc=AdoyOBjxdsAj-sAHyNuFzsAjoazLOGu5W8hQEBbb9ydl-pGvAiQIOy9efgF8vLBvy0E&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2XH2n7I7dm9aSePNGS5vb2o9atKJwUQmw5IudPfj0FUA&oe=69DE2474"}, {"file_name": "migrated_image.png", "id": "215645256181208", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/11162732_1971227563202281_2310204144775856128_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5k68GkObUcwQ7kNvwHokuhI&_nc_oc=AdragO9rE6qgZrMiZhdkwJaLRIIi_gdOuPzbaLBTVSHfb9qh1ggnKa9rY_ewC2SqXn8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0_SbWF_8U_i01YIoklIy3_oyepXCU6ArmFYGaTyw4bJw&oe=69DE445E"}, {"file_name": "migrated_image.png", "id": "2798765736878123", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12482172_545890772430920_5739429140549861376_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e4K6y0NiIaoQ7kNvwFh144X&_nc_oc=Adr2Z4HIvEtB4hcX_xDI0SKlcqtC0YstO36IM4y7A3lyv_RVP6jVykG82HZjBckcNss&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1VSzaYukYEQNTWs9FRD9Bx4MLujcmajraaQTOURAzRfw&oe=69DE4B72"}, {"file_name": "migrated_image.png", "id": "1388395454680116", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12533876_163744050923621_8287985935686041600_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y35c8S3ymckQ7kNvwFs0-jx&_nc_oc=AdqV4dVyEpP5BmXfAc8ITDtwF8W74zzd8DV-Zu7UJSmQT21U47aHLVszGwSWq3LrMII&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1HBwCrcljEp1a6oUYHUUkUALyJnbDvFhnQq2wcLt_2ww&oe=69DE470B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_art - 2.png", "id": "829541637228382", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12427537_829541640561715_4290524620483723264_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8bkzwfJ84FgQ7kNvwEsLoGa&_nc_oc=AdosPPE2zAC3qS_Jc0qvJ6zguBl-fejsnbGDUxXWiWu2OaxLwv6NuY3eGd0ukTC-msA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af34tiJnGRRS9AxrFit7umBIBainDRDXFjghMHVuzg6zxA&oe=69DE2E36"}, "display_name": "Chasing Robert Rabbit", "keywords": ["cartoon", "rabbit", "fun"], "long_description": "This old film projector you've just received in your office has some very strange properties: it lets real people get inside cartoons, and people from cartoons go out in the real world.\n Unfortunately it let Robert the cartoon Rabbit sneak inside your office and steal all your gold. Now you have no choice but to follow him inside all his cartoon adventures, and take back your gold!\n\nFight against a super realistic AI enemy. Always watch your back! This is not a game, it's a real hunt!\nCollect your gold across different levels to unlock and buy crazy cartoon weapons, and unlock new levels! \n\nThree levels currently available:\n-The Labyrinth\n-The Museum\n-Candy World", "short_description": "A one-to-one hunt against a crazy AI!\n\nRobert Rabbit stole your gold and went back hiding in his cartoon. Chase him across all his cartoon episodes to take back your gold!\n\nFight against a super realistic AI enemy. Always watch your back! This is not a game, it's a real hunt!\nCollect your gold across different episodes to unlock and buy crazy cartoon weapons.  \n\nThree levels currently available:\n-Hit the Rabbit\n-Night at the Museum\n-Candy Crush"}]}, "developer_name": "InterUniversal Games", "developer_privacy_policy_url": "https://www.chasingrobertrabbit.com/terms-of-service-and-privacy-policy", "developer_terms_of_service_url": "https://www.chasingrobertrabbit.com/terms-of-service-and-privacy-policy", "publisher_name": "InterUniversal Games", "support_website_url": null, "website_url": "http://chasingrobertrabbit.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ACTION", "ADVENTURE", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD", "GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "3152848178284211"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/11162696_1452076451543047_2573838557483368448_n.png?stp=dst-png_s360x360&_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SfvV3QxbFTsQ7kNvwFYxrCT&_nc_oc=AdpLx6qkNVvMWGiRwEkzU33aF4RpfoH3h4nAhRru8rApnjmu3RSFR7cTeoaZwLCk3do&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0uRDVTla8E2w4PwaHdGudsHk4_KMUJlLBC5akbduR5Qw&oe=69DE2A35"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Chasing Robert Rabbit", "platform": "ANDROID", "context_category": null, "context_topics": [], "release_date": 1517334118, "lastRevision": {"nodes": [{"id": "1854044491590779", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "1996253540390892", "is_first_party": false, "enables_in_app_ads": false, "is_concept": false, "platform": "ANDROID"}, "iarc_cert": {"id": "316755615401071"}, "iarc_email": null, "msrp": null, "translations": {"nodes": [{"images": {"nodes": [{"file_name": "migrated_image.png", "id": "881911458908510", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/11162707_273713989800733_5864140254792908800_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r57xGl8V3vwQ7kNvwGsJaBW&_nc_oc=AdpCNDR4Zq8cmFIJwPexN1whH_XBuL3ln9f3Rg2lgE99KwuUxtW36SH1gM4vAW7N27A&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3T1m8V2pNarCnH4IqhmDK9YqW8ecv6vYyjhebpJTcftw&oe=69D
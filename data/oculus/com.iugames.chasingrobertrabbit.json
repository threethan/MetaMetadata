-1.oculuscdn.com/v/t64.5771-25/12386259_152790418727863_4170456404542357504_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zjsF80eJo4gQ7kNvwGrl4sW&_nc_oc=Adq6j0IQSPYtzbEMWAqF_iVvHG9jERaSX66u14VgLGjdgsEbWqla0X3hlHOJmFohq2M&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH0tVNfCK7BYVCP7AfIO2BWXHlctmGcBCYo_GyMwTuwTw&oe=6A8835F4"}, {"file_name": "migrated_image.png", "id": "215645256181208", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/11162732_1971227563202281_2310204144775856128_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eDL744uZtJ4Q7kNvwFYBFO8&_nc_oc=AdoafL9buOMvDd1Qzvf0whZy9vKEjDqNCma97AV90CGjrT0a6F1RRzlMX_2YvAQKRtI&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEbLRqK8g3z0VCkRb--dvM9TtBiVO0ypwGnpm_SwugcWg&oe=6A881D9E"}, {"file_name": "migrated_image.png", "id": "2798765736878123", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/12482172_545890772430920_5739429140549861376_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cQcUL9qe30YQ7kNvwFHFMbd&_nc_oc=AdoGF971ZINSX4NMv5l_O70oNO9-d3TylvCt2JeEwyaBeeHS50CUBIbs2prJPaf_AZc&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHw2BDAIm7xW4gEJOBHSko8N1FuWuYtLl-5jr77EHQctQ&oe=6A8824B2"}, {"file_name": "migrated_image.png", "id": "1388395454680116", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/12533876_163744050923621_8287985935686041600_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fpzja94xp9YQ7kNvwF2JeJ1&_nc_oc=AdrD7zL9ipUC5Xub9pMaGEM8FGj4FaKnMrApSXSPzBGxI4L4eRwk5TdptFgQh-HPHY0&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGzICsot8sDxe2WP7kuzu6oNSsULNIHPmsOgO3AXDRf9g&oe=6A88204B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_art - 2.png", "id": "829541637228382", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/12427537_829541640561715_4290524620483723264_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s9Q2c0l48hwQ7kNvwGt8uUH&_nc_oc=Adrl2Jgot8LlxIui_5FOy-JZ1pzgIuORU04MKP73xeMyJcop6keUogtdvTA3FCg5I3s&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHUILwjNJPUHnaknE1QJDHKDGDo2pcy_bQb5fCEUpTNuQ&oe=6A883FB6"}, "display_name": "Chasing Robert Rabbit", "keywords": ["cartoon", "rabbit", "fun"], "long_description": "This old film projector you've just received in your office has some very strange properties: it lets real people get inside cartoons, and people from cartoons go out in the real world.\n Unfortunately it let Robert the cartoon Rabbit sneak inside your office and steal all your gold. Now you have no choice but to follow him inside all his cartoon adventures, and take back your gold!\n\nFight against a super realistic AI enemy. Always watch your back! This is not a game, it's a real hunt!\nCollect your gold across different levels to unlock and buy crazy cartoon weapons, and unlock new levels! \n\nThree levels currently available:\n-The Labyrinth\n-The Museum\n-Candy World", "short_description": "A one-to-one hunt against a crazy AI!\n\nRobert Rabbit stole your gold and went back hiding in his cartoon. Chase him across all his cartoon episodes to take back your gold!\n\nFight against a super realistic AI enemy. Always watch your back! This is not a game, it's a real hunt!\nCollect your gold across different episodes to unlock and buy crazy cartoon weapons.  \n\nThree levels currently available:\n-Hit the Rabbit\n-Night at the Museum\n-Candy Crush"}]}, "developer_name": "InterUniversal Games", "developer_privacy_policy_url": "https://www.chasingrobertrabbit.com/terms-of-service-and-privacy-policy", "developer_terms_of_service_url": "https://www.chasingrobertrabbit.com/terms-of-service-and-privacy-policy", "publisher_name": "InterUniversal Games", "support_website_url": null, "website_url": "http://chasingrobertrabbit.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ACTION", "ADVENTURE", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD", "GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "3152848178284211"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/11162696_1452076451543047_2573838557483368448_n.png?stp=dst-png_s360x360&_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=saixJLMzFGwQ7kNvwFkmABd&_nc_oc=Adoxx9xWlBMS9lD6nrSX76cP-oyxFtMeJzgajTTAN453ZdgBLboPelnAeoMk3PCO0TA&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHrw6DJOr3-6o6sO36LFIzRJR2Euk84Pew1uOa7lFkh7g&oe=6A883BB5"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Chasing Robert Rabbit", "platform": "ANDROID", "context_category": null, "context_topics": [], "release_date": 1517334118, "lastRevision": {"nodes": [{"id": "1854044491590779", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "1996253540390892", "is_first_party": false, "enables_in_app_ads": false, "is_concept": false, "platform": "ANDROID"}, "iarc_cert": {"id": "316755615401071"}, "iarc_email": null, "msrp": null, "translations": {"nodes": [{"images": {"nodes": [{"file_name": "migrated_image.png", "id": "881911458908510", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/11162707_273713989800733_5864140254792908800_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vD0RHprEZXQQ7kNvwGKdRi_&_nc_oc=AdpavvB0g8XPPcVYuCNvrQpAS9tGFQKxeydIlQsJFlm2eK02mi0jLZxOiAz7krF3Vz0&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF7NSn951inuebyLoqBzG0aYGZ6i_bV_HnO8ljt2_EUkA&oe=6A8
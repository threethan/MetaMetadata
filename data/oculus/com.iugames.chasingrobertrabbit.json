2798765736878123", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/12482172_545890772430920_5739429140549861376_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EkTCdStoVDUQ7kNvwGy3zik&_nc_oc=Adqhdx2mDiXPBwcjlqbuEi9hMHO4mHHMwtU8JDRXwPGgLjFkDbPBaEkhw7La-R_dskE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Af3d_Uk1zv_Hx_LOna_VIvkIwcaRiAtSsUeN2VdqNeHuyA&oe=69F0C072"}, {"file_name": "migrated_image.png", "id": "1388395454680116", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12533876_163744050923621_8287985935686041600_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mio0JQRp9icQ7kNvwGugEPh&_nc_oc=Adp6YkPERPdNuUHUnTeisoykuzzafPSxzg10ZeWBW5u68ISPXWgCFMGbA0YThUB9P4M&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af2bKXmWF4YiyFH62s26k7dL3C5fBNx37IyKfAj89jJS1g&oe=69F0BC0B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_art - 2.png", "id": "829541637228382", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12427537_829541640561715_4290524620483723264_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ds9Go4kMZ0MQ7kNvwHfRWz8&_nc_oc=Adquk2466QiG8fDiQnTcAcspk7HXxSytAt1YgBtzFtl4V61zhpGJozqNNypSgivW98o&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af2wHt-xeUUTl9-dREtW6UiEgGi06qYapAePq9dl_aKVXg&oe=69F0A336"}, "display_name": "Chasing Robert Rabbit", "keywords": ["cartoon", "rabbit", "fun"], "long_description": "This old film projector you've just received in your office has some very strange properties: it lets real people get inside cartoons, and people from cartoons go out in the real world.\n Unfortunately it let Robert the cartoon Rabbit sneak inside your office and steal all your gold. Now you have no choice but to follow him inside all his cartoon adventures, and take back your gold!\n\nFight against a super realistic AI enemy. Always watch your back! This is not a game, it's a real hunt!\nCollect your gold across different levels to unlock and buy crazy cartoon weapons, and unlock new levels! \n\nThree levels currently available:\n-The Labyrinth\n-The Museum\n-Candy World", "short_description": "A one-to-one hunt against a crazy AI!\n\nRobert Rabbit stole your gold and went back hiding in his cartoon. Chase him across all his cartoon episodes to take back your gold!\n\nFight against a super realistic AI enemy. Always watch your back! This is not a game, it's a real hunt!\nCollect your gold across different episodes to unlock and buy crazy cartoon weapons.  \n\nThree levels currently available:\n-Hit the Rabbit\n-Night at the Museum\n-Candy Crush"}]}, "developer_name": "InterUniversal Games", "developer_privacy_policy_url": "https://www.chasingrobertrabbit.com/terms-of-service-and-privacy-policy", "developer_terms_of_service_url": "https://www.chasingrobertrabbit.com/terms-of-service-and-privacy-policy", "publisher_name": "InterUniversal Games", "support_website_url": null, "website_url": "http://chasingrobertrabbit.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ACTION", "ADVENTURE", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD", "GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "3152848178284211"}}]}, "scheduled_offers": {"count": 0, "nodes": []}, "baseline_offer": null, "is_approved": true, "firstOffer": {"nodes": []}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "2185435178139393", "version": "1.2.5"}, "id": "443021942765090", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBi
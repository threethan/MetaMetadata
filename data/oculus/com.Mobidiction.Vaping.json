t=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQngejKZuBOitwxS2PAMs4G9d8nHYAeujYEuF1cYXOowg&oe=6B0B118B"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VapingVR", "keywords": [], "long_description": "This virtual reality experience is built in consultation with doctors who are addiction medicine specialists and have worked in the United Kingdom and in Australia. Our team of consulting Doctors have a special interest in adolescent health and youth addiction medicine.\n\nThe aim is to use this VR experience as a novel therapeutic intervention as it has a form of \u201cedutainment\u201d for young people who are struggling with the addiction of e-cigarettes which uses some engaging tactics in form of \u201cVR\u201d interactions.\nThe use of virtual reality is not only an appealing medium for the target user but, first of its kind built in Australia to enhance learning through engagement on the harmful effects of electronic cigarettes.", "short_description": "This virtual reality experience is built in consultation with doctors who are addiction medicine specialists and have worked in the United Kingdom and in Australia. Our team of consulting Doctors have a special interest in adolescent health and youth addiction medicine. The VR experience will help to educate those who are struggling with Vaping addiction as well as those who are curious about it's affects."}]}, "developer_name": null, "developer_privacy_policy_url": "https://patientvr.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Mobiddiction", "support_website_url": "https://support.mobiddiction.com/", "website_url": "https://patientvr.com/vapingvr", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "478089301798119"}, {"id": "810139357995560"}, {"id": "1043107547362485"}], "external_subscription_type": "REQU
O8n1kfdr5SfFwZ1mrZvP2Wwb0R80bHw&oe=6AFDBE92"}, {"file_name": "Screenshot 3.png", "id": "929195488873563", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75476593_929195492206896_211580893937506099_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8fOa1GGm3_gQ7kNvwEr5jrG&_nc_oc=AdoIuFukMSYLJLKe8GyXaIM8icq36zAaJZyN23ynD9ub2lL_UZD6nxM86ioTHpGGESI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRlI2ogn1lUZnVGZy7bkQWK39D9Ly4g_aJyQwO736LJdA&oe=6AFDE28B"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VapingVR", "keywords": [], "long_description": "This virtual reality experience is built in consultation with doctors who are addiction medicine specialists and have worked in the United Kingdom and in Australia. Our team of consulting Doctors have a special interest in adolescent health and youth addiction medicine.\n\nThe aim is to use this VR experience as a novel therapeutic intervention as it has a form of \u201cedutainment\u201d for young people who are struggling with the addiction of e-cigarettes which uses some engaging tactics in form of \u201cVR\u201d interactions.\nThe use of virtual reality is not only an appealing medium for the target user but, first of its kind built in Australia to enhance learning through engagement on the harmful effects of electronic cigarettes.", "short_description": "This virtual reality experience is built in consultation with doctors who are addiction medicine specialists and have worked in the United Kingdom and in Australia. Our team of consulting Doctors have a special interest in adolescent health and youth addiction medicine. The VR experience will help to educate those who are struggling with Vaping addiction as well as those who are curious about it's affects."}]}, "developer_name": null, "developer_privacy_policy_url": "https://patientvr.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Mobiddiction", "support_web
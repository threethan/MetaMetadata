2-1.oculuscdn.com/v/t64.5771-25/75230038_1316592416014793_3901201528642866637_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jTWQ7jjGku4Q7kNvwE3PtyS&_nc_oc=AdmE78mbLWIA_MhJEtTlH0mPSxytSxPBM-ghDRJS04z4jSnkoqahiXMlPuvCUWxyq-M&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfyKNvPq-FsKyYZ3A2igmIOiGXeJIIqkgDkCqmJsirPEEQ&oe=69AD6C96"}, {"file_name": "vlcsnap-2024-07-19-15h17m25s925.png", "id": "2253852241654521", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974688_2253852244987854_5726517220935198158_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nTYgTA0gC3YQ7kNvwGPA1Ye&_nc_oc=AdkgBLUVMMPyXi2ZR9sAqrloH3d_a7Y-E7qbwo48MQnQRwIQ6X1SXsBbgJf4IjWdss0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfxVjQWgLiKI0ZqgamEQQuUd4mpRhK8gXCa8mx_LAOl46g&oe=69AD66CB"}, {"file_name": "vlcsnap-2024-07-19-15h18m13s079.png", "id": "496257609955774", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39036629_496257613289107_1586315745250351762_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Exx06KCNNsIQ7kNvwHTfa3O&_nc_oc=AdlSsxbD4ZkVYexhAkazp30BlqPRooQ4hoNLwar_fLRPbv6ivakP7Hm82_e4y9rx6T4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfyziSv9rBTCqkYkeWLzewZDbWK6WB9fKfDuLHIxXL1uTQ&oe=69AD8384"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "LangScape.png", "id": "3826036104276304", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39036602_3826036107609637_4470162773859765169_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Kn51SZ9b6mkQ7kNvwGTzDq7&_nc_oc=AdmCUW1ezokt_iW4LMKzX4cfG6tMOJTZ7JisF0aoVqt3791HBNaU1Jc_PaQBx0NaY-M&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afym64Y-B9xTfL3EALzOJsANX_4dwPiR9sPUDCvRfvSg7w&oe=69AD8452"}, "display_name": "Retropy Pro", "keywords": [], "long_description": "Retropy Pro is the deluxe, premium version of Retropy with more puzzles, music selections, and exclusive VR environments.\n\nWith many different puzzles to choose from, get lost in the warm environments for hours on end. There are more genres of puzzles, mission modes, and increased puzzle piece count for players to enjoy.\n", "short_description": "Retropy Pro is a relaxing 3-D jigsaw puzzle game meant to inspire creativity and generate nostalgia.\n\nRestore everyday objects in a puzzling world that brings together exciting puzzles in a calming flow. \n\nRetropy is inspired by the meditative state of puzzling, which allows us to complete a familiar object and also strengthen our cognitive function. You can play standing or seated for maximum comfort and enjoyment. \n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://retropy.space/privacy", "developer_terms_of_service_url": "https://retropy.space/tos", "publisher_name": "Surf Punk Interactive", "support_website_url": null, "website_url": "https://retropy.space/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9266112893421765"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974521_880450180924076_4958185030622430502_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5ZjkLXVvZpoQ7kNvwHX7Zlo&_nc_oc=AdkzoT_lcxijwyESD0T43rsUSHNsm-zc8yzvxD6sfxdR9s80n5efFl4BxVCnc08B68k&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfyyUa5rV1gUIbR9DQOGUCPmdMLxPdsIaMpZjWfJBuIn6w&oe=
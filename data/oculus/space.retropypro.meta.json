2-1.oculuscdn.com/v/t64.5771-25/75230038_1316592416014793_3901201528642866637_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jTWQ7jjGku4Q7kNvwEw-3WX&_nc_oc=AdmPDUlZ7z5heg-WTVSSPPxIDM59_r_cs4mZ2uBXq_EE3rxgNm17J8AQn9K7Zo2xk4A&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afxhr_TjSEhKfLZ_s9B3GMpBSyfVNyencahFv66qIjqp4g&oe=69B00F96"}, {"file_name": "vlcsnap-2024-07-19-15h17m25s925.png", "id": "2253852241654521", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974688_2253852244987854_5726517220935198158_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wLLR6pJj9MkQ7kNvwHSYtAl&_nc_oc=Adn8vOpYWU_eBUgPnP5e3jyeUq2OuHMh_P4xqcJWQ61NoRWekVOVqI3QE8GraVEibmk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afwf_VGNqsxDqxTDJyv2G_275q4NLHUgnXNix8XaR7RjhQ&oe=69B009CB"}, {"file_name": "vlcsnap-2024-07-19-15h18m13s079.png", "id": "496257609955774", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39036629_496257613289107_1586315745250351762_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_DGJia_6tKcQ7kNvwH_0naV&_nc_oc=AdmwPWqDleTNN1eyGyftyRtCwO9hio_i6JaBbnN3W8BRpyujb6ljpkjySwmkdDYmosg&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afzv8GudBIHVXEwHUamOylP2JseWYN46chpc54PMEKgFdw&oe=69B02684"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "LangScape.png", "id": "3826036104276304", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39036602_3826036107609637_4470162773859765169_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JgCKMImAdRUQ7kNvwFtxRPK&_nc_oc=AdlizSTwAe4l2K9wBMNluUzCNYAxyjJqOj6xNrMgMldCUjW3g94L7-frXJtm4u8Fzw4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfxDf_Oi-vgcR5aFN6-7_9Y9fr3tH9z98_Ryg__V8kLnVg&oe=69B02752"}, "display_name": "Retropy Pro", "keywords": [], "long_description": "Retropy Pro is the deluxe, premium version of Retropy with more puzzles, music selections, and exclusive VR environments.\n\nWith many different puzzles to choose from, get lost in the warm environments for hours on end. There are more genres of puzzles, mission modes, and increased puzzle piece count for players to enjoy.\n", "short_description": "Retropy Pro is a relaxing 3-D jigsaw puzzle game meant to inspire creativity and generate nostalgia.\n\nRestore everyday objects in a puzzling world that brings together exciting puzzles in a calming flow. \n\nRetropy is inspired by the meditative state of puzzling, which allows us to complete a familiar object and also strengthen our cognitive function. You can play standing or seated for maximum comfort and enjoyment. \n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://retropy.space/privacy", "developer_terms_of_service_url": "https://retropy.space/tos", "publisher_name": "Surf Punk Interactive", "support_website_url": null, "website_url": "https://retropy.space/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9266112893421765"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974521_880450180924076_4958185030622430502_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2pl9eSbA9TYQ7kNvwESOk36&_nc_oc=Admf4F_VStK6Xw4d3EUQe2oPl0Zq31x7qK81wdKT3ij5RLDnWqqv84-FcfIA0Ly0OKk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfypCRyQiu76Hfz_MUUfZhRttbU4Z7433ZBJOdkIXxngww&oe=
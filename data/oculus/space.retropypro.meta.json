3-1.oculuscdn.com/v/t64.5771-25/75230038_1316592416014793_3901201528642866637_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7q23sQ2snq0Q7kNvwEq11MT&_nc_oc=Adm255CWJs4Pd8BgVHs6ztr_CYzgr4PZTKQOh-0f_TxXUvERn87GG_7jTs0F2VkTlrQ&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_Afxsz6jUxoCnDS3xU4ZMiniXbWyPf_UTXKHwIVzK92kGjg&oe=69B6A716"}, {"file_name": "vlcsnap-2024-07-19-15h17m25s925.png", "id": "2253852241654521", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974688_2253852244987854_5726517220935198158_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rnTZu0bQ4oYQ7kNvwEAVAuC&_nc_oc=AdmRnYVzaJqytfcm-tanHvG93XYuwOJFaedqJG6UfEMwbzyh1pwlnm4ZdWRJh8mPKD0&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfySx9YFqmJToVwNE-poMXNfPKAkJiIX0TnV0os5HpGliw&oe=69B6A14B"}, {"file_name": "vlcsnap-2024-07-19-15h18m13s079.png", "id": "496257609955774", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39036629_496257613289107_1586315745250351762_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g1URzTJ3V70Q7kNvwEOJNBy&_nc_oc=AdkTEtd8NcqmIow4QQSiesq4PNDZzsOVjQgE_Wj6ooATI4hYqONbLRkRNVTpeHrELmY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfyPNZj-c4bFNJxdsI-lHzwVydZeDEHR7_yR3FsQ45D7Yg&oe=69B6BE04"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "LangScape.png", "id": "3826036104276304", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39036602_3826036107609637_4470162773859765169_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DbHWi3erJ20Q7kNvwHIKZ9c&_nc_oc=Adl4bxwAYZ_0_38Xq-1X9g4ACnUxEek3FFOAyLi0ANfeps2wJS_bV56xit8hikwtmBs&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfyX4d97ODotYTI88pRCoUViRNOcXFYX8NwTdBjN_QSnZA&oe=69B6BED2"}, "display_name": "Retropy Pro", "keywords": [], "long_description": "Retropy Pro is the deluxe, premium version of Retropy with more puzzles, music selections, and exclusive VR environments.\n\nWith many different puzzles to choose from, get lost in the warm environments for hours on end. There are more genres of puzzles, mission modes, and increased puzzle piece count for players to enjoy.\n", "short_description": "Retropy Pro is a relaxing 3-D jigsaw puzzle game meant to inspire creativity and generate nostalgia.\n\nRestore everyday objects in a puzzling world that brings together exciting puzzles in a calming flow. \n\nRetropy is inspired by the meditative state of puzzling, which allows us to complete a familiar object and also strengthen our cognitive function. You can play standing or seated for maximum comfort and enjoyment. \n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://retropy.space/privacy", "developer_terms_of_service_url": "https://retropy.space/tos", "publisher_name": "Surf Punk Interactive", "support_website_url": null, "website_url": "https://retropy.space/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9266112893421765"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974521_880450180924076_4958185030622430502_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u670M-IF5z0Q7kNvwFFzi80&_nc_oc=Adme4yJzu9GpJ2ZR3tSO0F6iJ4J7WmXhsq8XH_qUSVCYReQrSLKzzDlT0EhqR0QBi6k&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_Afy5krIKNgQGsaloOB3cZOxctN0Y7TGRKesdllM5lZq0Hw&oe=
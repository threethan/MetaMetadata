2-1.oculuscdn.com/v/t64.5771-25/75230038_1316592416014793_3901201528642866637_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jTWQ7jjGku4Q7kNvwFpFjbH&_nc_oc=AdkL24LVKXPmYiGw5KEUrSBSO294qXvwcfMmkHlOoWsSzNuXv-8X0oNx6M6f40aeN94&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfzrIuD2yRA43ypBekA-257WurPinZZVlxNH3GZ88GJ1lA&oe=69AEBE16"}, {"file_name": "vlcsnap-2024-07-19-15h17m25s925.png", "id": "2253852241654521", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974688_2253852244987854_5726517220935198158_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nTYgTA0gC3YQ7kNvwFq5cdN&_nc_oc=AdkKVh0i-0ZW90re3M_1SJ170xHDX-3OPEa0g_RG2QwU3s_Y7rayTuU7neHlIRVJ3tY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afy0iAbb7WZe9ikHQBWr5fxH-bvDmTvqZYz0ZOOleOg6Rw&oe=69AEB84B"}, {"file_name": "vlcsnap-2024-07-19-15h18m13s079.png", "id": "496257609955774", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39036629_496257613289107_1586315745250351762_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_DGJia_6tKcQ7kNvwF_o3ve&_nc_oc=AdmngEOT2ZOaNbIvhaAbfUteTPKMPF4j3oeglaka_WKqJW1n0Z8GZ4xUOAFX2UvnYdE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfyhtozrZAVjNAWjcghc1QiuGTx3pULiuLz2jEumw87sxA&oe=69AED504"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "LangScape.png", "id": "3826036104276304", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39036602_3826036107609637_4470162773859765169_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JgCKMImAdRUQ7kNvwFlkHAn&_nc_oc=AdlDrozLTlMyu5V70M8e7ceqqhewOMThgAspTPMsTvAUfqkKXjw0XnpIncJiN4DSwmk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afx-Qtb_hjlmokVPkV7Mj69wYK1PFRSvS_nH8rFeHFzRJg&oe=69AED5D2"}, "display_name": "Retropy Pro", "keywords": [], "long_description": "Retropy Pro is the deluxe, premium version of Retropy with more puzzles, music selections, and exclusive VR environments.\n\nWith many different puzzles to choose from, get lost in the warm environments for hours on end. There are more genres of puzzles, mission modes, and increased puzzle piece count for players to enjoy.\n", "short_description": "Retropy Pro is a relaxing 3-D jigsaw puzzle game meant to inspire creativity and generate nostalgia.\n\nRestore everyday objects in a puzzling world that brings together exciting puzzles in a calming flow. \n\nRetropy is inspired by the meditative state of puzzling, which allows us to complete a familiar object and also strengthen our cognitive function. You can play standing or seated for maximum comfort and enjoyment. \n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://retropy.space/privacy", "developer_terms_of_service_url": "https://retropy.space/tos", "publisher_name": "Surf Punk Interactive", "support_website_url": null, "website_url": "https://retropy.space/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9266112893421765"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974521_880450180924076_4958185030622430502_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5ZjkLXVvZpoQ7kNvwGqj0Y7&_nc_oc=AdkCtvd2rKqrLoIluByqNgwLoFFM6pPkqTgow-myp1MjiAM6KjRb568iVBPWNUXpYAI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afzb6vUEho9XJ0yNHYe75IS24EhNkq-Lg2xVc-enYwdRgw&oe=
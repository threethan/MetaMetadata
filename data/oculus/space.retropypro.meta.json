2-1.oculuscdn.com/v/t64.5771-25/75230038_1316592416014793_3901201528642866637_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vZV6GTq4m3QQ7kNvwHbM-vo&_nc_oc=Adn_sIrd2JLr-ZtoiG1ORv5sewnMEcoW-oeF3x9V6_YGkdwCpS7DyJ_o4EjLULKFXeQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afv1oHDf5OBSjYPaLf_nJcoCHgw7YFITA6SzCgxLYgAYaQ&oe=69A82696"}, {"file_name": "vlcsnap-2024-07-19-15h17m25s925.png", "id": "2253852241654521", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974688_2253852244987854_5726517220935198158_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FHiPtrdpWzcQ7kNvwHXI-ss&_nc_oc=AdnqMakUybXo-v-nljHhIrJ-r2fAqXDXL3EHdgceXCIw8RXbx8IuljuKwkJRHjxlcV0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfsNtEDE4Z2WaXrD3N7ryU7vy98HMMSTUGqrCA4HSfLS_Q&oe=69A820CB"}, {"file_name": "vlcsnap-2024-07-19-15h18m13s079.png", "id": "496257609955774", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39036629_496257613289107_1586315745250351762_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h3hXSqlEAU4Q7kNvwFIluBP&_nc_oc=Adk2AEFEwSWuZbQx2QWtZfFevarurfZ9aMbRVjI1mxrH3IKihLkF3xY0uSaxWxgQ5Gg&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afu1Q0Q69M2zKs4s3ltDu1HdOK6DGXDCfYVRqeBZsrzc6w&oe=69A83D84"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "LangScape.png", "id": "3826036104276304", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39036602_3826036107609637_4470162773859765169_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jcx0-4dzSdcQ7kNvwHMt8o3&_nc_oc=Adkcb0oErfpHAGZZdxyVq6_-jYXzkh1Up6I706_2Akpvt6_7k3ZBLgLuZgkui7YUYXM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfucUc9YCKptwxVFa5EiAk8g78g5u_hMSIM0pyz7GWMP9g&oe=69A83E52"}, "display_name": "Retropy Pro", "keywords": [], "long_description": "Retropy Pro is the deluxe, premium version of Retropy with more puzzles, music selections, and exclusive VR environments.\n\nWith many different puzzles to choose from, get lost in the warm environments for hours on end. There are more genres of puzzles, mission modes, and increased puzzle piece count for players to enjoy.\n", "short_description": "Retropy Pro is a relaxing 3-D jigsaw puzzle game meant to inspire creativity and generate nostalgia.\n\nRestore everyday objects in a puzzling world that brings together exciting puzzles in a calming flow. \n\nRetropy is inspired by the meditative state of puzzling, which allows us to complete a familiar object and also strengthen our cognitive function. You can play standing or seated for maximum comfort and enjoyment. \n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://retropy.space/privacy", "developer_terms_of_service_url": "https://retropy.space/tos", "publisher_name": "Surf Punk Interactive", "support_website_url": null, "website_url": "https://retropy.space/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9266112893421765"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974521_880450180924076_4958185030622430502_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UULz3bOWF_wQ7kNvwGW_0R2&_nc_oc=AdnAGbpon1V4zlOcc26I4vXg6f04bNFvtDfMWFOZurnbl6tUy7yIAaY_wk7KOfW_e1Q&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afun96aoZ0crj__gq0CArHZvljCL-ZuK0J14kAJ0Lhk6-Q&oe=
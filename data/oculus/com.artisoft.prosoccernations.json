qy6TqUih7Xsc68_nuvVxYGCBz_8_T56SVjxounDZyLVxjsEtLFmXUlFQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJG0RBGBPgLjXxUMAUrcyMKLQClTUt3bgZyRFQUXpfNDw&oe=6AB2771F"}, {"file_name": "sc_3.png", "id": "1723735208911801", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491823296_1723735212245134_6304597483806070820_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hyOtyP6U26AQ7kNvwE8rpGL&_nc_oc=AdpKlw-t-DY5yTd4UJcY8kgiEJQAwZgp0Hx72N65qpTD_qb1tacKkptnON4sEtp88d4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKVTWT_Ot_UbSeNR4YnUMPoeb2L8vGpMCDncFRgdKCAUA&oe=6AB280EF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "hori.png", "id": "1022369397078706", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491823910_1022369403745372_4535650634855949305_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6-H0RsBqHtAQ7kNvwENMTDf&_nc_oc=AdqEK2TqBbHvBj1_G1Jnd4zgAHib04BhX6RIdYSMGl-CsDPUbcgzlg07Jwt-sbqwZwI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIKZsCBBx4WQVVZrAJuzgrTzd2JqBXZCagVZTbC5EVx9g&oe=6AB2835A"}, "display_name": "Pro Soccer Nations", "keywords": ["soccer", "football", "goalkeeper", "player", "match"], "long_description": "# **Pro Soccer Nations**\n\nExperience the excitement of international soccer (football) in VR! Take control of your field players and compete for glory in immersive full-length matches against intelligent AI opponents\u2014all **offline**, no internet required.\n\nChoose from **200+ national teams** and compete in world and continental tournaments, or create your own custom competitions with your favorite nations and rules.\n\nBuilt specifically for virtual reality, Pro Soccer Nations features comfortable movement designed to minimize VR discomfort while keeping you fully immersed in the action.\n\n**Features**\n\n* 200+ national teams\n* World & continental tournaments\n* Create custom tournaments\n* Control all field players\n* Intelligent AI opponents\n* Multiple difficulty levels\n* Various formations\n* Comfortable VR gameplay\n* Fully offline\u2014no internet required\n\n# **Lead Your Nation to Glory**\n\nEvery pass matters.\n\nEvery tackle counts.\n\nEvery goal brings you one step closer to becoming world champion.\n\nPut on your headset, step onto the pitch, and experience the passion, excitement, and drama of international soccer in Pro Soccer Nations.\n\n# **List of predefined tournaments**\n * World: 1994-2026\n * Europe: 1996-2024\n * South America: 2007-2024\n * North America: 2009-2025\n * Africa: 2008-2025\n * Asia: 2007-2023\n * Oceania: 2012-2024\n\nYou can play them as is or modify the teams. \nFor totally custom tournaments you can select 32, 24 or 16 teams template.", "short_description": "Experience international soccer in VR! Control all field players, choose from 200+ national teams, and compete in world and continental tournaments or create your own. Play full matches against intelligent AI with multiple difficulty levels and formations. Built for comfort with optimized VR movement. No internet required\u2014play offline anytime and lead your nation to victory!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://artisoft.pl/policies/sn_v1.html", "developer_terms_of_service_url": null, "publisher_name": "Artisoft", "support_website_url": null, "website_url": "https://soccernations.artisoft.pl/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "
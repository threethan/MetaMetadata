dn.com/v/t64.5771-25/12410473_1567596000213325_1917178453_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1NzFyyMJaX4Q7kNvwGVs79S&_nc_oc=AdlF_SXnIAKRcVTp4WL_TsIhmZ6GTW83Q05wioKIEqTmb3cmUhFxgU_OLE2vktXawkk&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=8&oh=00_Afy57kwZ8qgVkfTGHwSyJkBCNPNz_7NlRYsTUFiciMTLbA&oe=69AAE290"}, {"file_name": "migrated_image.png", "id": "3059343930764310", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/12139352_892849037525936_1211536448_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s1lC5x8m6ncQ7kNvwHP5mK-&_nc_oc=AdnKgWxfAMnq5IDWXpcTTFI25FjpNqv6flFbreDCGY-SBF_c5MColkyWWas1q-SU-As&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=8&oh=00_Afyt2XAa2W-QbMXb-5lt6OA6PLX2Zyz40QNopKp62qcNBQ&oe=69AAE526"}, {"file_name": "migrated_image.png", "id": "788568061546901", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/12138831_1807156119503210_723261408_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=p9PGfp0sGCAQ7kNvwHQS2RH&_nc_oc=AdmNNE7YtPbnQ81HnzXfGApnExVHwZYIZIBrFX11jrY97qVZG_eR6aJPFKWShof6mAg&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=8&oh=00_AfwknkRbb_CZ6mojgFSdmhN97ktrVpMnLUtdKTSXIsSD1A&oe=69AAC48A"}, {"file_name": "migrated_image.png", "id": "509563986392204", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/12331111_342083129464004_2102587776_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NkyxVfqt97oQ7kNvwHUe8_w&_nc_oc=Adlkk1FJ9GKx4ri6uv71VgawqN6XH842sM4thPGMu2D6aPUwPzincHnYDcBjTCRgpyw&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=8&oh=00_AfythS6Ls42xdU4kjs697dNa59oo5jipUOVgBcVwoCgbWw&oe=69AAD34C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Nerve", "keywords": ["dare", "truth", "nerve", "lionsgate", "vr"], "long_description": "Download the NERVE app to experience the dares from the film in first-person Virtual Reality, and more! Choose \"PLAYER\" to put yourself inside VR depictions of the crazy dares from the film, or choose \"WATCHER\" to see what other Players from around the world have already dared to do\u2026 More experiences for watchers and players are being added all the time, so keep checking back for new stuff.\n\nAre you a Watcher or a Player?\n\nNERVE \u2013 In Theaters July 27. Starring Emma Roberts, Dave Franco, Emily Meade, Miles Heizer, Juliette Lewis, Colson Baker, and Kimiko Glenn.\n\nIndustrious high school senior, Vee Delmonico [Roberts], has had it with living life on the sidelines. When pressured by friends to join the popular online game Nerve, Vee decides to sign up for just one dare in what seems like harmless fun. But the game begins to take a sinister turn with increasingly dangerous acts, leading her into a high stakes finale that will determine her entire future.\n\n#WatcherOrPlayer\nPlayNerve.com", "short_description": "Welcome to NERVE: A game like truth or dare, without the truth. Are you a watcher or a player?"}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.lionsgate.com/corporate/privacy/", "developer_terms_of_service_url": "http://www.lionsgate.com/corporate/terms/", "publisher_name": "Lionsgate Entertainment", "support_website_url": null, "website_url": "http://PlayNerve.com/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["MOVIE", "CASUAL", "SIMULATION", "NARRATIVE"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "470394754527592"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/12522273_554467804744192_1554625163_n.png?stp=dst-png_s36
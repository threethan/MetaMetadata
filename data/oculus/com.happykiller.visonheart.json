": [{"file_name": "\u65e0\u6807292\u9898.png", "id": "4294521127503690", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/499618277_4294521130837023_342169080628532739_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vtInBvr6xp8Q7kNvwGcVxDM&_nc_oc=AdpKBSHmwUrsdNRF1poD-K4z2jJ1hoWrqksGpAtMPxOCavHF23nczd9iEtKQq46Pp9k&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHtXHpxXmrUIgZV-yH86GlDUGVU8p2gFPEfjJRitpNC9Q&oe=6A7DBC82"}, {"file_name": "\u65e0\u68078976\u9898.png", "id": "1383711012879535", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/499618069_1383711016212868_2134543578991625848_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rt6AfE9qm24Q7kNvwFammlY&_nc_oc=AdqZKEXp9uwH6HdJVgX8yDVE5WAhMfMt2csBbaA5T0GNq4B1w2D-PN7XHp6BpW7A51Q&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFeE2FsCs8AJWbEaOxRcwx15paQyxKEBMyD8xACXYJguQ&oe=6A7DC9D9"}, {"file_name": "\u65e0\u68072992\u9898.png", "id": "1406805821147471", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/499618277_1406805824480804_8905777773217650264_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WP00fIY0YkYQ7kNvwEeccMK&_nc_oc=AdpXHodFVGAMOctPdbHHSi_lSxDcqvf2gvCn556DnsyjMxpwQTw7rgVYxtepRYZqNGU&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGXcBnjWWe_LeWR0IbeNu_z4CIAgJHpnpX7ZuHYrbB0bQ&oe=6A7DB004"}, {"file_name": "\u65e0\u68077685\u9898.png", "id": "2083454242454491", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/499618432_2083454245787824_5262935930103679004_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Mc1wWP3e0YEQ7kNvwFHHVf-&_nc_oc=AdoEJ4aW2ziD5fbOrDvaGu46Xqrfnnn9qeYk_Hcv58ZMkQPBtTVAstAAsGddw1TGNoY&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFLVn51rfcFGo3ualVyujQl9DMcw3ojkymyYcjYNeC_4w&oe=6A7DBAE1"}, {"file_name": "\u65e0\u680722\u9898.png", "id": "1545217903196438", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/499618069_1545217906529771_1518325879950376722_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lHxph9h8qaQQ7kNvwGOy_jW&_nc_oc=AdqpTEysZVFg1moqawgeT71i3GXTvJk9U_RhqFlk-vdYPwzJ1IfRybUNvDoBb_pvvCo&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH-mqEq6csr4hXNWUztw3BR9GshZjNpqk-Syn7zhjpwnw&oe=6A7DC86D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "567567.png", "id": "1429318398590098", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/499617831_1429318401923431_5913719611556792027_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hlfThFFsdHQQ7kNvwEZAelt&_nc_oc=AdpORbAw40y2GLCgrKxpOMUXfFeyUWYMcsYDDsff3v8YF2b3A99ajB4ws94_NsAlyrM&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEyGa_gpOl09ygevoG7zYCUgjH8j6sXphCdesPfZcBBGw&oe=6A7DABE6"}, "display_name": "KillerRunner", "keywords": ["runner", "killer", "run", "grab"], "long_description": "Join our Discord community to share levels,  and ideas:\nhttps://discord.gg/XuCNcSqX2P\n\n**The Ultimate Fusion of Hardcore Action and Infinite Creativity.**\n\nWelcome to a VR world where speed is survival. We combine the lightning-fast parkour of *Ghostrunner* with the creative freedom of *Mario Maker*.\n\n**\u2694\ufe0f High-Speed Cyber Combat**\nMaster the art of the blade. Swing through levels with your **grappling hook**, perform gravity-defying **wall runs**, and bounce off jump pads.\n*   **Deflect & Survive:** Don't just dodge\u2014**parry!** Block incoming fire with your sword and reflect bullets back at your enemies.\n*   **Fluid Movement:** Precision and flow are your best weapons.\n\n**\ud83d\udee0\ufe0f Build & Edit in Real-Time**\nWhy just play when you can create? Our powerful in-game editor lets you shape the world instantly.\n*   **Total Control:** Scale, move, and place every prop, trap, or enemy.\n*   **Smart Tools:** Use batch selection, rapid generation, and undo/redo to build complex stages in minutes.\n*   **Play vs. Edit:** Switch modes instantly to test your deadly creations on the fly.\n\n**\ud83c\udf10 Share, Remix, & Evolve**\nThe gameplay never ends with our global community features:\n*   **Cloud Sharing:** Upload your levels and challenge players worldwide.\n*   **Level Branching:** Play a community level, then create a **\"Branch\"** to modify and remix it into your own version.\n*   **Asset Extraction:** See a cool trap design in another player's level? Extract that section, save it to your library, and use it in your own masterpiece.\n\n**Slash, Dash, Build, and Share. Welcome to the future of VR action.**", "short_description": "Unleash your inner cyber-ninja in this high-octane VR action experience! Master the art of the blade: wall-run, grapple, and deflect bullets in adrenaline-pumping combat. But the fight is just the beginning. Inspired by \"Mario Maker,\" our real-time editor lets you build, remix, and share death-defying levels with the world. Create your legacy, or survive someone else's!"}]}, "developer_name": "Windward Studio", "developer_privacy_policy_url": "https://privacy-policy-flame-alpha.vercel.app/", "developer_terms_of_service_url": null, "publisher_name": "Windward Studio", "support_website_url": "https://discord.gg/XuCNcSqX2P", "website_url": "https://killer-runner.vercel.app/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}, {"id": "459781504968480"}, {"id": "1725996564472128"}, {"id": "528142316460358"}, {"id": "2710427532541308"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SIN
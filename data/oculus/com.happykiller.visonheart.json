fxEV-Hmf9sklhxQshcGBsqGQ&oe=6B0860A1"}, {"file_name": "\u65e0\u680722\u9898.png", "id": "1545217903196438", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/499618069_1545217906529771_1518325879950376722_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v9HM5UV-zmcQ7kNvwH376NY&_nc_oc=AdruBALMOtYYY6FihzyfCvqcTWj796Wwnshm25WHl_GTDQq5vpxS19odRMB9Iq9rQW8&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTrheygzMUl7bhnUy2caJL81jFeEN_GE7mL894uo-_GYA&oe=6B086E2D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "567567.png", "id": "1429318398590098", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/499617831_1429318401923431_5913719611556792027_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Zt4XhY1-0_YQ7kNvwEsodqw&_nc_oc=AdoA7lLjSpcIXZBCaPOmQ7cki3gomNpiD4xZYr-PTsQZP6g_bumPAr0DqF6qIYLrwmc&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQj7IbxB3DXs_XtwiEYKHeDvuJVYthrFLz6m6SZo5z-Yg&oe=6B0851A6"}, "display_name": "KillerRunner", "keywords": ["runner", "killer", "run", "grab"], "long_description": "Join our Discord community to share levels,  and ideas:\nhttps://discord.gg/XuCNcSqX2P\n\n**The Ultimate Fusion of Hardcore Action and Infinite Creativity.**\n\nWelcome to a VR world where speed is survival. We combine the lightning-fast parkour of *Ghostrunner* with the creative freedom of *Mario Maker*.\n\n**\u2694\ufe0f High-Speed Cyber Combat**\nMaster the art of the blade. Swing through levels with your **grappling hook**, perform gravity-defying **wall runs**, and bounce off jump pads.\n*   **Deflect & Survive:** Don't just dodge\u2014**parry!** Block incoming fire with your sword and reflect bullets back at your enemies.\n*   **Fluid Movement:** Precision and flow are your best weapons.\n\n**\ud83d\udee0\ufe0f Build & Edit in Real-Time**\nWhy just play when you can create? Our powerful in-game editor lets you shape the world instantly.\n*   **Total Control:** Scale, move, and place every prop, trap, or enemy.\n*   **Smart Tools:** Use batch selection, rapid generation, and undo/redo to build complex stages in minutes.\n*   **Play vs. Edit:** Switch modes instantly to test your deadly creations on the fly.\n\n**\ud83c\udf10 Share, Remix, & Evolve**\nThe gameplay never ends with our global community features:\n*   **Cloud Sharing:** Upload your levels and challenge players worldwide.\n*   **Level Branching:** Play a community level, then create a **\"Branch\"** to modify and remix it into your own version.\n*   **Asset Extraction:** See a cool trap design in another player's level? Extract that section, save it to your library, and use it in your own masterpiece.\n\n**Slash, Dash, Build, and Share. Welcome to the future of VR action.**", "short_description": "Unleash your inner cyber-ninja in this high-octane VR action experience! Master the art of the blade: wall-run, grapple, and deflect bullets in adrenaline-pumping combat. But the fight is just the beginning. Inspired by \"Mario Maker,\" our real-time editor lets you build, remix, and share death-defying levels with the world. Create your legacy, or survive someone else's!"}]}, "developer_name": "Windward Studio", "developer_privacy_policy_url": "https://privacy-policy-flame-alpha.vercel.app/", "developer_terms_of_service_url": null, "publisher_name": "Windward Studio", "support_website_url": "https://discord.gg/XuCNcSqX2P", "website_url": "https://killer-runner.vercel.app/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}, {"id": "459781504968480"}, {"id": "1725996564472128"}, {"id": "528142316460358"}, {"id": "2710427532541308"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null,
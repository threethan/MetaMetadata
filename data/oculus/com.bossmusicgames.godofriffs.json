X5nYuIpsEEEOMuozFlvksa4WQ&oe=699AEAF7"}, {"file_name": "Dock-0.8.4.1.png", "id": "309032437960286", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/57570288_309032441293619_7370802708223179366_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uGY2ymyueEAQ7kNvwHLq3FX&_nc_oc=AdkN9G0QgWhkUhLeUE0PewDrZptKebTGAbbymZt1VOKLzle0kVThACLMhbdkXl_01MI&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_Aftq-9GIb6gn7vo3rDbhNb6uUk5Ec6q04iVYPsMoQT9noQ&oe=699AE730"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Backup Launch Trailer thumbnail 2560x1440.png", "id": "1597776703890790", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974647_1597776707224123_4930136956665216959_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G-5GkYcSoLMQ7kNvwEvP7Mq&_nc_oc=AdleYgt3SeawPAiVHDZC6Rm0zIPbjJL-mSvAMnJpxukV068tMvSbDR288FVlv3oV_4I&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_Afvg-xNDj1LNyDpJGGQE7bFvvyYc4r7eA_IvMQ9VIRuayQ&oe=699B048D"}, "display_name": "God of Riffs", "keywords": [], "long_description": "Rock like the gods in God of Riffs, a rhythmic heavy metal VR game that's like a hard rock album cover come to life!\n\nSmash hellspawn to the beat with your twin guitar axes. Become the God of Riffs in this new pulse-pounding rhythm melee VR game! Wield twin guitar axes with the fury of a heavy metal GOD against swarms of skulls, demons, and more across the multiverse! Charge your weapons with heavy metal combos that send enemies flying and carve your name into heavy metal HIGH SCORE HISTORY! \n\nPlay 8 original tracks in 4 difficulty modes, across 6 unique levels.", "short_description": "Are you ready to rock!? Boss Music Games and VYERSOFT Corp present God of Riffs: an EPIC, adrenaline pumping, heavy metal VR rhythm game that's like a hard rock album cover come to life! \n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.godofriffs.com/gorprivacy", "developer_terms_of_service_url": null, "publisher_name": "Vyersoft
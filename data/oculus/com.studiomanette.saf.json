=1-7&_nc_sid=6e7a0a&_nc_ohc=iI8shrDd6hEQ7kNvwG1uo5r&_nc_oc=Adp0RFwNxdi6cZXgTwnDJ-61PbwRC91VTlR_LEBITmlJ9XefvDdom6NLECunFpzS728&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEA6iZxSo9Es6BaLacBapEfStBXNcFtMfaUcwaghEVTEg&oe=6A8C13B4"}, {"file_name": "Screenshot 3.png", "id": "1630592940965459", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491828799_1630592944298792_4665578834866823092_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h60QeZris90Q7kNvwF568Jg&_nc_oc=AdqaQYq4OjM7jpY8rTzfSZV7adrIweKn8sq5KNjhIJ8kHzoDy0Y6FAkGdvovhS892Ns&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH1zVOCDuBlFjcYHIbYkD2NgFlTWn3fVthHfaAdGf_Psw&oe=6A8C2568"}, {"file_name": "Screenshot 1.png", "id": "1315163926844716", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/507892119_1315163930178049_1948118922134222080_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sCWFwvdGpJ4Q7kNvwFVBCpX&_nc_oc=AdpkR4-Nm7lrXu6YVjfEN7jcnMl6nYKaZkcV4-MdSUa80x2T3Tl98goUCEXUB4CgjrI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEBn0UVZuQCX6NudYdpt1fOk8IJPc-xy0RHsgAhzs_Wqw&oe=6A8C3485"}, {"file_name": "Screenshot 5.png", "id": "1784264449180642", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823447_1784264452513975_4007837528725691068_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rXBocYfkmNUQ7kNvwFRZmwl&_nc_oc=AdoS3lcAzAQ-L2PwEr6jS62BfWBLfU_DSEfIqIQDt4dIaq8R6Ug8HiKc4vnRz-itRgg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFCy6OQ5bwCRkxsO-EyNKDRxODraE5a618FB18UBle6EQ&oe=6A8C2B80"}, {"file_name": "Screenshot 2.png", "id": "623664263366746", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491824560_623664270033412_6941099246110893690_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vg9pW7PE1L0Q7kNvwFhh7Yk&_nc_oc=AdrFl1Mt5vWQDXpOsH5a91P6VWiMMqjjDJqi-PvAtQtBEraMrkFxbsbsw50P8H3b50o&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGLzpK34ZLh-qtESMNQrpoE78df2vKQpDKxjHTBE9qxCg&oe=6A8C2470"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape.png", "id": "751695390628218", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499313110_751695393961551_7724464253174114486_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=501idzazB7cQ7kNvwGMXwYv&_nc_oc=AdpwQyJCgFadpKK4f3-yMkgRq_vTzl0IYak4dq8cu0kpfPEWX0-vVpx_u6nGDbRr-xw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHSRbroLOclCg2hgMCnz61ShUNXgkiT2DPhNOVyxHEhJQ&oe=6A8C1F9C"}, "display_name": "Less Than 5Gr of Saffron", "keywords": ["immigration", "VR", "memory"], "long_description": "\ud83c\udfc6 Winner of the Special Jury Prize at Venice Immersive 2025, step into an intimate VR story about memory, exile, and the invisible aftermath of survival.\n\nLess Than 5gr of Saffron follows Golnaz, a young Iranian woman rebuilding her life in Germany after a traumatic migration journey. One evening, exhausted and hungry, she comes across saffron in a supermarket \u2014 a rare and precious spice that immediately brings back memories of home.\n\n\nAs she prepares a simple meal, the scent and color of saffron begin to transform the space around her. The act of cooking becomes a passage between present and past, bringing Golnaz back to the journey she survived three years earlier: a dangerous boat crossing in which she lost her family.\n\n\n\ud83e\uddf3 EXPERIENCE MEMORY THROUGH SENSATION\n\nLess Than 5gr of Saffron uses virtual reality to place you inside Golnaz\u2019s emotional space. Through gesture, sound, atmosphere, and sensory memory, the experience invites you to feel how trauma can resurface in the quietest moments of everyday life.\n\n\ud83e\uddf3 A DIALOGUE-FREE IMMERSIVE STORY\n\nWithout dialogue, Less Than 5gr of Saffron crosses language barriers and offers a deeply human reflection on loss, belonging, and resilience.", "short_description": "Golnaz, a 23-year-old Iranian woman, tries to cope with her new life in Germany.\n\nShe finds a pack of saffron that reminds her of home. As she cooks rice with saffron, a comforting dish from her past, she does not expect this simple gesture to bring her back to the most traumatic event of her life. Three years earlier, she survived a tragic boat crossing in which she lost her family during a dangerous journey across the sea."}, {"images": {"nodes": []}, "id": "1021629707476994", "locale": "fr_FR", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Les larmes de Safran", "keywords": ["iran", "immigration", "drame", "VR"], "long_description": "Golnaz est une jeune immigr\u00e9e iranienne qui tente de s'adapter \u00e0 sa nouvelle vie en Allemagne. Un soir, de retour de son travail (assistante dans un centre d'accueil pour migrants de la banlieue berlinoise), elle meurt de faim et son r\u00e9frig\u00e9rateur est vide.\n\nElle d\u00e9cide d'aller au supermarch\u00e9 le plus proche. Le supermarch\u00e9 vient de recevoir un nouveau produit : du safran. M\u00eame s'il est tr\u00e8s cher pour elle, elle ne peut r\u00e9sister ; elle en ach\u00e8te un sachet. L'\u00e9motion la submerge. Elle ressent le besoin de cuisiner un repas maison pour surmonter son mal du pays. Elle pr\u00e9pare du riz et y ajoute du safran, un aliment r\u00e9confortant de son pass\u00e9. Mais elle ne s'attendait pas \u00e0 ce que ce moment la replonge dans les \u00e9v\u00e9nements les plus traumatisants de sa vie. Il y a trois ans, elle a surv\u00e9cu \u00e0 une noyade tragique qui a emport\u00e9 sa famille alors qu'elle voyageait ill\u00e9galement par bateau.", "short_description": "Golnaz, une immigr\u00e9e iranienne de 23 ans, tente de s'adapter \u00e0 sa nouvelle vie en Allemagne.\nElle trouve un paquet de safran qui lui rappelle son pays, l\u2019Iran. Golnaz pr\u00e9pare du riz pour y ajouter du safran, un plat r\u00e9confortant de son pass\u00e9. Mais elle ne s\u2019attendait pas \u00e0 ce que ce moment la ram\u00e8ne, aux \u00e9v\u00e8nements les plus traumatisants de sa jeune existence. Il y a trois ans, elle a surv\u00e9cu \u00e0 une noyade tragique qui a emport\u00e9 sa famille alors qu'elle voyageait ill\u00e9galement en bateau."}]}, "developer_name": "Ten2Ten, Studio Geppetto, Studio Manette, Blaktone Studios", "developer_privacy_policy_url": "https://atlasv.io/privacy_policy/LessThan5grofSaffron.html", "developer_terms_of_service_url": null, "publisher_name": "Ten2Ten, Atlas V, iNK Stories", "support_website_url": null, "website_url": "https://atlasv.io/project/less-than-5gr-of-saffron/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["fr", "de", "ko", "es", "nl", "ar", "ja", "fa", "zh_TW", "zh_HK", "en", "en_US"], "supported_input_devices": [], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "27172325442458907"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491831273_736520502171330_1738554180152172129_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=je5LD-4bwPwQ7kNvwFkY2I9&_nc_oc=AdqrmJYIhzm6sanDgeboXZkmzB-9gYpZJH5Smewunk1c-4hzs2F3zAsW7Gzzoke52dk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFHOMXWGP6lawnVrxReMU4zkfpDnAaUyBChiHPUjZIWeA&oe=6A8C23A8"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Less Than 5Gr of Saffron", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{
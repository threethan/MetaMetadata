14-14-39.png", "id": "1615023172819630", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499619148_1615023176152963_7706954661244723868_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eNOfMN4lJCkQ7kNvwGRN_bm&_nc_oc=AdmI6IfG8sojVHKNJK0P1_vEHfi4PErHi7Il0GbP14Ywy3WcBevN3TMbgGLChvgKm-I&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AftiPUXnieF3jncLfL-ng8vzeZl28QDOorH4dTs0t3CZug&oe=69A42435"}, {"file_name": "3.png", "id": "1527524578424567", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499308245_1527524581757900_1674788222980601486_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6KZnWN6nYG0Q7kNvwF4I2vW&_nc_oc=Adm8icRMz3WNFETJtNbBcZRVY8BqcP7-K7wn5y3LNOfG9XIS-J5UmIKZfUfmo2I6ebM&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfssF3wetKrO6M9Laa2Cng5PlySeTjwgHRbo67bqQn6BfA&oe=69A43C37"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "OverLoad", "keywords": ["Gorilla", "Pvp", "Overload", "Monkey"], "long_description": " # Join the fight\n                                                           \n\n In **Overload** \u2014 a fast-paced multiplayer shooter where you can battle solo or team up with friends. Choose from **10+ powerful weapons** , customize your look with tons of cosmetics, and build your squad by adding friends to your in-game list.\n\n\n\n# Overload currently features 3 thrilling modes:\n\n- **Duels** \u2013 Prove your skills in 1v1 showdowns\n\n- **Team Deathmatch** \u2013 Work together and dominate as a squad\n\n- **Deathmatch** \u2013 Every player for themselves, no mercy\n\n{1461129098441055}\n\n# What to Expect\n\n**Constant updates**: new maps, new guns, and fresh cosmetics\n\n**Daily**, **weekly**, **and monthly quests** to keep the action rewarding\n\n**Party up** and jump straight into the action with friends\n\n{798544342560458}", "short_description": " In **Overload** \u2014 a fast-paced multiplayer shooter where you can battle solo or team up with friends. Choose from **10+ powerful weapons** , customize your look with tons of cosmetics, and build your squad by adding friends to your in-game list."}]}, "developer_name": "5Vstudios", "developer_privacy_policy_url": "https://5vstudios.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "5Vstudios", "support_website_url": null, "website_url": "https://5vstudios.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1700921480735423"}, {"id": "3744040075834813"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "25314254394935951"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499619646_1181381977460043_3756049111659606630_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kPeqoJbx1SsQ7kNvwGQBTj6&_nc_oc=Adkn749b9LOS7WZhOiIQHtqyxlMpMhwidqP9UsZzYzf6bFMAjqXfRB5fEM_KXcJUAiA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AfvddUWSRsCEFTwn8pkJwYc7aWruSN4H9DsGE1cW6CHVDw&oe=69A4321F"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "OverLoad", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Action", "id": "459781504968480"}, {"topic_name": "Party Game", "id": "1700921480735423"}, {"topic_name": "Shooter", "id": "3744040075834813"}, {"topic_name": "Platformer", "id": "52814231646035
E46"}, {"file_name": "Adobe Express - file.png", "id": "1394034895441579", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/499618361_1394034898774912_7316074365548167227_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zd9RFMUfqrIQ7kNvwHY3pDt&_nc_oc=Adpc3ZXIygyaARlCqKcS5H7V-8Ez8NK_FMHek2W9T7_lTV8YLMXK-sucaePuAcAFcM0&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG3-JdopuI_l8rBg6slsTz_SYEhkDcBIJPeeJR55C--KQ&oe=6A859B66"}, {"file_name": "1.png", "id": "1419883032424623", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/491822446_1419883035757956_8670166550816756072_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dPPnyL43vw8Q7kNvwEwL5Mb&_nc_oc=Adp4LLgylq8GUIHjD5oRcXC1jRD5bjKNzy-B3ru2aoWit8q9zlbP3VynTo4LNl4kw1g&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEv39hBQf9UN8ZAa0RDfGYKyItOChxHTejOydRmMskKSQ&oe=6A859EF7"}, {"file_name": "3.png", "id": "1527524578424567", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/499308245_1527524581757900_1674788222980601486_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=noxu_AHL-8YQ7kNvwFEUSKw&_nc_oc=AdpT0_evQzMCDaEov36shDQX0xiBhTtYDNgsvVVQHfLboAk5U-qRM0rP2yampJdu3PA&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGDXiZqL6KYgNYkqeMgjkXJQlNJx8PBp4fP2H7SYjoh9w&oe=6A85ACB7"}, {"file_name": "5.png", "id": "1137691651625905", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/491831569_1137691654959238_3743815840852897955_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YP0YHo26cKAQ7kNvwGYZPws&_nc_oc=Adrbchrue-egId5_HCsRHUfzY_Ta3p3fa9o5EgOw_Z9zzGchfbyFu6f8abP9tS7AFdk&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHme0jQIfbO0rsyQ4wvTuV-J9Moo8MXF-kBfPKyaBt1jg&oe=6A859283"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "OverLoad", "keywords": [], "long_description": " # Join the fight\n                                                           \n\n In **Overload** \u2014 a fast-paced multiplayer shooter where you can battle solo or team up with friends. Choose from **10+ powerful weapons** , customize your look with tons of cosmetics, and build your squad by adding friends to your in-game list.\n\n\n\n# Overload currently features 3 thrilling modes:\n\n- **Duels** \u2013 Prove your skills in 1v1 showdowns\n\n- **Team Deathmatch** \u2013 Work together and dominate as a squad\n\n- **Deathmatch** \u2013 Every player for themselves, no mercy\n\n{1461129098441055}\n\n# What to Expect\n\n**Constant updates**: new maps, new guns, and fresh cosmetics\n\n**Daily**, **weekly**, **and monthly quests** to keep the action rewarding\n\n**Party up** and jump straight into the action with friends\n\n{798544342560458}", "short_description": " In **Overload** \u2014 a fast-paced multiplayer shooter where you can battle solo or team up with friends. Choose from **10+ powerful weapons** , customize your look with tons of cosmetics, and build your squad by adding friends to your in-game list."}]}, "developer_name": "5Vstudios", "developer_privacy_policy_url": "https://5vstudios.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "5Vstudios", "support_website_url": null, "website_url": "https://5vstudios.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1700921480735423"}, {"id": "528142316460358"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "2475
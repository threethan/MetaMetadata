nc_ss=7f20f&oh=00_Af74pAdmB80WMy-RvHhJQic5VyOl8HgKYHcubwd9S9Al7w&oe=6A085CE6"}, {"file_name": "Screenshot_2025-12-24_14-14-39.png", "id": "1615023172819630", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499619148_1615023176152963_7706954661244723868_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uDaALsTPJsIQ7kNvwG4ekuf&_nc_oc=Adou6g0b52zSlyVz7xW9B92euc7BzOGfn2KASvxLAJay2vs7OvP0BGJ58ce6nMmEohM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5BEMIifIwUIyMWKpcqaOGis2Ek-GshcbqKu_x-t65trA&oe=6A088E75"}, {"file_name": "3.png", "id": "1527524578424567", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499308245_1527524581757900_1674788222980601486_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8pTtVkMUpPQQ7kNvwGxe5Zh&_nc_oc=Adp6Pa97fIbiPGugT6oJ3hsLpz0OZFhmMylNTHXTLFySN57KZ5qsnp4JbumYMzrL1Io&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7kKh9J3gulUYdwqv4nRvj4T-Uc8gC5EkgbyiGnCpGHuQ&oe=6A086E37"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "OverLoad", "keywords": ["Gorilla", "Pvp", "Overload", "Monkey"], "long_description": " # Join the fight\n                                                           \n\n In **Overload** \u2014 a fast-paced multiplayer shooter where you can battle solo or team up with friends. Choose from **10+ powerful weapons** , customize your look with tons of cosmetics, and build your squad by adding friends to your in-game list.\n\n\n\n# Overload currently features 3 thrilling modes:\n\n- **Duels** \u2013 Prove your skills in 1v1 showdowns\n\n- **Team Deathmatch** \u2013 Work together and dominate as a squad\n\n- **Deathmatch** \u2013 Every player for themselves, no mercy\n\n{1461129098441055}\n\n# What to Expect\n\n**Constant updates**: new maps, new guns, and fresh cosmetics\n\n**Daily**, **weekly**, **and monthly quests** to keep the action rewarding\n\n**Party up** and jump straight into the action with friends\n\n{798544342560458}", "short_description": " In **Overload** \u2014 a fast-paced multiplayer shooter where you can battle solo or team up with friends. Choose from **10+ powerful weapons** , customize your look with tons of cosmetics, and build your squad by adding friends to your in-game list."}]}, "developer_name": "5Vstudios", "developer_privacy_policy_url": "https://5vstudios.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "5Vstudios", "support_website_url": null, "website_url": "https://5vstudios.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1700921480735423"}, {"id": "3744040075834813"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "25314254394935951"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499619646_1181381977460043_3756049111659606630_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cpFWvnWtfcQQ7kNvwFKVPHj&_nc_oc=Adpc-k8drBwYW6ziDc4c0pHMGZagQYle3Idqz1IsOV8b7BebNI8r7na2cxkKeU__BmM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5xmcgywFoV0H34rzZowhl15qruJ2SUteRJEQ3xI66c2w&oe=6A08641F"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "OverLoad", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Action", "id": "459781504968480"}, {"t
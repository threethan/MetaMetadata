aiJQqjPptJ1vTVKWGFXHL9vjxUYmLkDNDoHlRFTyos&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGi6Tr1uC7qzP0JLsgG58rnu_INtfNk2ukSdsRx5FE8nA&oe=6A86D18C"}, {"file_name": "SS 4.png", "id": "1129196536103749", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499295512_1129196539437082_1093866374798213816_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u5yPLWI1ae8Q7kNvwEdf71X&_nc_oc=AdpSl3frKA2_6NHqjcgMs0YPbQKliEozoGPRl6RfJn0cVORGy3bM1jfHfLWQjhvT8Nw&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEC5YLoh859AxhsXNEzcJ2JUlrgpLS3iQty8jZstuCxiw&oe=6A86D1E2"}, {"file_name": "SS 5.png", "id": "1054306643819996", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499300603_1054306647153329_5801160058980501844_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LJlCRkj1kmIQ7kNvwFhK5F4&_nc_oc=AdrVeRzqNiNUM7Uv_tjpD2cKyztEfJxmlIH2QkxobuzyFrkErZIegozu7aL4y1tut9c&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE0csEULm_qZE6tdjO0XAZhG0R3Mssmz4VLmLMleSmMOQ&oe=6A86E359"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "LandScape.png", "id": "2412847892456372", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499312468_2412847895789705_7878486737787679953_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5KraQGYqhvIQ7kNvwHb_NEK&_nc_oc=AdqHeIkY-r_acVrPD1LQH9zwiqkZzeNiKHOruDQhcesCtCzu6MoFXHmpSlAgTDdbTn8&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFFW1njD785QoscnbyW7ekBeQes2LULXGpMsgJa5XQxbw&oe=6A86F127"}, "display_name": "Monkum", "keywords": ["Tag", "GameModes", "physicsbasedmovement", "Multiplayer"], "long_description": "Welcome to Monkum \u2014 a VR Gorilla Tag based movement game where your hands are your only way to move. Swing, climb, jump, and launch yourself through unique environments built around skill, creativity, and fast-paced movement. Explore different maps, discover new routes, and master your movement as you play with friends and compete to become faster and better. Customize your monkey with unique cosmetics, experience fun challenges, and create unforgettable moments in a growing community. Whether you're practicing movement, exploring new areas, or just having fun with friends, Monkum is all about freedom, creativity, and creating your own adventure in VR.", "short_description": "Welcome to Monkum \u2014 a VR Gorilla Tag based movement game. We have lots of game modes and more to come soon... We have a amazing fan base, great community, and lots of cool people! You can play monkum to have fun with your friends and make amazing memories. So make sure to download Monkum and start your amazing journey today!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/12FRUrhs27FAheaKeM8ZWWMI_8ZXWde7fjqDCiQGbRxU/edit?usp=sharing", "developer_terms_of_service_url": "https://docs.google.com/document/d/1T1Ln0dL9-eUXDr05Ue5EL4fgNAp1dU1_Jid37Qfr__I/edit?usp=sharing", "publisher_name": "Monkum Productions", "support_website_url": null, "website_url": "https://canva.link/opxm2u2x35rp4iq", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "CO_OP", "MULTI_USER"], "id": "1219007374634525"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1582089863413589"}]}, "baseline_offer": {"id": "1582089863413589"}, "is_approved": true, "firs
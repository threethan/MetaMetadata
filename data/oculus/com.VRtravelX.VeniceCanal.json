", "locale": "en_US", "screenshots": [{"file_name": "Screen1.png", "id": "2028734340966326", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38984442_2028734344299659_6019009833524947019_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uWtiw5onVPsQ7kNvwFEhBM6&_nc_oc=Adl6WVWDRWIo_l4dPxie5_Sl6yzaMrTwCU6DaCF_UQw6dWsG1vXX_Q7RcejFMGvCk-c&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=8&oh=00_AfyRuCbIMURDCMW3eZ89S5m0PsB3OzCk_Zf-4T6g7HvbtQ&oe=69BD46F1"}, {"file_name": "screen2.png", "id": "988574326642217", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974502_988574333308883_4562143481278463949_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2QBE6lohWt4Q7kNvwEzcRgZ&_nc_oc=Adk5ZbSduYe6iY1YrFYDp7_dH6oKWAp2nttO9ifND-KcYMvC_VrDYGe1ssKGDoqNnOc&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=8&oh=00_AfxjdmmkjN5bN3QBiTksKChZCK90m6AInrXChDp_hyHFTA&oe=69BD46AA"}, {"file_name": "screen3.png", "id": "842965677774956", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974689_842965681108289_2134748528633395266_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LPUxUWeN_PgQ7kNvwFTyXUW&_nc_oc=AdkW-g0iKuqqsw6cPfeBZyAiJZ95_FCrgQDyJau6NUoFL0WhxtKz2lVgDnzgVpNtHPk&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=8&oh=00_AfxQbr3VWx_xYgfqMZEMS9riJCZ410F-yJH41v2T9cPutA&oe=69BD498B"}, {"file_name": "screen4.png", "id": "956912546335550", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39031315_956912549668883_4971371662291346131_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dmO8Gh95zHUQ7kNvwHUBNhf&_nc_oc=AdkpL8Eqq-nwKGUGDWFekobpQ-kf9MtQKqa7m-z1qsCQLMa57QQWUtCkCgcIbZ4rg8g&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=8&oh=00_Afy4KQrSl35CB55VcRNMbhPg8-Y70cIfe6_kSZA4cVyiOQ&oe=69BD5567"}, {"file_name": "screen5.png", "id": "972161514739604", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974652_972161518072937_5495587229220030959_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=49W8Q83nZF0Q7kNvwEyz1-R&_nc_oc=AdmMbo1nM3huZt7RPrPCnsENEirSvHX8PZ4OibWVrzYj1oKXbO3fjXJQRSzo0eq5wQo&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=8&oh=00_AfxjQRg3LV8Fxo5RB1qxf5jc4xPWvX0h2IuNDX0cL1ONXg&oe=69BD41B6"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Venice Vaporetto VR: Grand Canal Ride", "keywords": ["travel", "tourist", "sightseeing", "venice", "italy"], "long_description": "Discover the beauty of Venice on an immersive VR Vaporetto ride along the Grand Canal. Starting near the train station, glide through the city's waterways and marvel at stunning architecture, bustling gondolas, and lively boat traffic. With a 360\u00b0 view, you\u2019ll feel like you\u2019re truly there, taking in every detail of this magical city.\n\nThe ride takes you past some of Venice\u2019s most iconic locations, including the breathtaking Rialto Bridge. Hear the soothing sounds of water, the chatter of locals, and the calls of gondoliers as you soak in the vibrant life surrounding the canal. The reflections on the water and the historic facades create a captivating, serene atmosphere that feels timeless.\n\nThis VR experience offers the ultimate escape, letting you enjoy Venice from a tourist's perspective without crowds, stress, or weather concerns. Pause the journey anytime and pick up right where you left off. Discover Venice\u2019s charm at your own pace, immersing yourself in the sights and sounds of this world-famous city.\n\n#venice #italy #travel #grandcanal #vaporetto #gondola #vrexperience #tourism #tourist #sightseeing", "short_description": "Experience Venice like never before! Ride the Vaporetto along the Grand Canal, from the train station to St. Mark's Square, stopping at iconic spots like the Rialto Bridge. Watch gondolas and boats glide by, hear the city\u2019s lively sounds, and take in stunning views from a tourist\u2019s perspective. Relax at home, free from stress or heat, and pause or resume the journey whenever you like."}]}, "developer_name": null, 
xWgS5f9gB-2N4H7Gf1zmkKmNJk-a2qUNblYWnO2i4T1TgQSA2sGUgh44P8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC6hwnccbOKr2yxTM273i22P0gIRfvnJ4p4gFsHPlsaJA&oe=6A6B5B67"}, {"file_name": "screen5.png", "id": "972161514739604", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974652_972161518072937_5495587229220030959_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PcmI4GjhDT0Q7kNvwEFLA-e&_nc_oc=AdptZ5FB2VbJpSXjpvNLV5448KqIV51tFLhkR4HQL7S0LlxxgbSzd0E0Q9FK2lmgP7U&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDhzD22pWsZZvma_FpzMlYLNKvn9vzdRUiVtbplx9L3LA&oe=6A6B47B6"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Venice Vaporetto VR: Grand Canal Ride", "keywords": ["travel", "tourist", "sightseeing", "venice", "italy"], "long_description": "Discover the beauty of Venice on an immersive VR Vaporetto ride along the Grand Canal. Starting near the train station, glide through the city's waterways and marvel at stunning architecture, bustling gondolas, and lively boat traffic. With a 360\u00b0 view, you\u2019ll feel like you\u2019re truly there, taking in every detail of this magical city.\n\nThe ride takes you past some of Venice\u2019s most iconic locations, including the breathtaking Rialto Bridge. Hear the soothing sounds of water, the chatter of locals, and the calls of gondoliers as you soak in the vibrant life surrounding the canal. The reflections on the water and the historic facades create a captivating, serene atmosphere that feels timeless.\n\nThis VR experience offers the ultimate escape, letting you enjoy Venice from a tourist's perspective without crowds, stress, or weather concerns. Pause the journey anytime and pick up right where you left off. Discover Venice\u2019s charm at your own pace, immersing yourself in the sights and sounds of this world-famous city.\n\n#venice #italy #travel #grandcanal #vaporetto #gondola #vrexperience #tourism #tourist #sightseeing", "short_description": "Experience Venice like never before! Ride the Vaporetto along the Grand Canal, from the train station to St. Mark's Square, stopping at iconic spots like the Rialto Bridge. Watch gondolas and boats glide by, hear the city\u2019s lively sounds, and take in stunning views from a tourist\u2019s perspective. Relax at home, free from stress or heat, and pause or resume the journey whenever you like."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.vrtravelx.net/home/Venice-Vaporetto-VR-Grand-Canal-Ride", "developer_terms_of_service_url": null, "publisher_name": "VRtravelX", "support_website_url": null, "website_url": "http://VRtravelX.net/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9201504839882569"}}]}, "scheduled_offers": {"count": 13, "nodes": [{"status": "PUBLISHED", "id": "1941980373185880"}, {"status": "PUBLISHED", "id": "1001911812189728"}, {"status": "PUBLISHED", "id": "1648122506181110"}, {"status": "PUBLISHED", "id": "869361805905798"}, {"status": "PUBLISHED", "id": "3770366006427239"}, {"status": "PUBLISHED", "id": "2051232595634071"}, {"status": "PUBLISHED", "id": "1326825805612620"}, {"status": "PUBLISHED", "id": "1807306243233666"}, {"status": "PUBLISHED", "id": "1874944516676649"}, {"status": "PUBLISHED", "id": "654758723927510"}, {"status": "PUBLISHED", "id": "1733131863927229"}, {"status": "PUBLISHED", "id"
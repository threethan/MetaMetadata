25571531597", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39031423_834325574864930_8315226353867853407_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=roeiksZCoKEQ7kNvwGWu9C4&_nc_oc=Adq8gUcIF3CGmP6N8LIc5tehVI2X1oPE8T3QDgXvMAKOevRZcUmS-sBQwg8PDhZNSOo&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFg4K3p_Vz-GRafR5FcABScwhZU2UxiXdAfMRq118ma4A&oe=6A8ACA05"}, {"file_name": "Game_Room_6.png", "id": "485283489679170", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/38974763_485283493012503_5164190395246012611_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OX3u4ReQTbcQ7kNvwHeSX4c&_nc_oc=Adq1VB3yWxPo1LhBMkHYKSUISsbk8ZPwtSZ6tbKWi_vDwHVgTM_EXPMQOsb0qWB1UsA&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHumIgHeuOR4CZgOarHYLFuoufC8w-NLbPuXDFIFFoRvw&oe=6A8AEBE8"}, {"file_name": "Game_Room_13.png", "id": "546672083957284", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38982642_546672090623950_4652714039044074389_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WhtRPYiQYX4Q7kNvwFQuJgQ&_nc_oc=Adoicp_OiHpI9xdjYOYGetJ1dsY0pqLkHonBJRMrXTOg37zo_sqLh8x7pCHfD7RXPgE&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH7Q_uvA2L0hoB4_z02t48tuA-SPn0_D3x-j49slm1rYg&oe=6A8AD3FD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape.png", "id": "1992352341165327", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/75326673_1992352344498660_5689810170846410426_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DK0FbMseeQkQ7kNvwFo97Ao&_nc_oc=AdoMUvjI2JcGVPa6WOZi744Z1YR7FL48XaOJ3j9e5IRyL-nBjPJRhjTJmEnNeTH7C9g&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEjtNiiHRtWVV39eal4Sp4K1PIky-jagb5msLwWYUpBBw&oe=6A8AF050"}, "display_name": "Chamvr | Bowling & Arcade", "keywords": [], "long_description": "\ud83c\udfae Immerse Yourself in the Ultimate VR Bowling Experience! \ud83c\udf1f\n\nRediscover classic arcade games in stunning VR environments, and get ready for even more thrilling games on the horizon!\n\n\ud83d\udd79\ufe0f Features:\n\u2728 Online Multiplayer: Connect with friends and players from around the world as you compete in your favorite games.\n\n\ud83c\udfb3 8 Spectacular Bowling Lanes: Perfect your bowling skills in stunningly designed VR lanes. Rack up strikes, spares, and unforgettable moments!\n\n\ud83c\udfaa Arcade Extravaganza: We've brought the arcade to your VR headset! Try your hand at the ever-addictive Ski-ball, showcase your shooting prowess in Basketball, and prove your precision in Darts.\n\n\ud83c\udfb2 Classic Tabletop Games: Whether it's a battle of wits in Dominoes or a race to play the perfect card in Crazy Eights, we've got your favorite card games to enjoy with friends.\n\nJoin us today and be part of the VR gaming revolution! \ud83c\udf10\ud83d\udd79\ufe0f \n\nFor more info, and issues please email me at:\nbraulio@chamvr.com", "short_description": " Play Bowling and Arcade games with your VR friends"}]}, "developer_name": null, "developer_privacy_policy_url": "https://chamvr.com/privacy-notice", "developer_terms_of_service_url": null, "publisher_name": "Chamvr Inc", "support_website_url": null, "website_url": "https://www.chamvr.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ART_CREATIVITY", "SOCIAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "6093751260725287"}, "review_messages": []}]}, "cover_square
25571531597", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031423_834325574864930_8315226353867853407_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x3gGK-1lO7MQ7kNvwGx9Ec8&_nc_oc=Adoy0Z3qxl9OdsibrZ9_DQoD7RGiA9CLRAVXNBOpsnzZ-QP_xXpe6V5A8vpR2Z73z7s&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBDtg7cPm63OCXp_2iZhboAn2nvqVG731_M7CDSNaWkXQ&oe=6A4D0BC5"}, {"file_name": "Game_Room_6.png", "id": "485283489679170", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974763_485283493012503_5164190395246012611_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-PUcjpd9-2MQ7kNvwGam4Wc&_nc_oc=Adqg8mej3M9yDpf4Z_H7pcxISy-U_O5LXOkg_iv-F6Ri9JypJjVxpXLAoI0UrDzg03M&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBXlY86_52wDIXa83I41jXKQNJdEEDff228ujjaRva3pA&oe=6A4CF568"}, {"file_name": "Game_Room_13.png", "id": "546672083957284", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982642_546672090623950_4652714039044074389_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_cgX6g3GHFoQ7kNvwHN9_R7&_nc_oc=AdpjWW1IXkiVbBUhQQImobgC-n1IHwUMCBG1lKrZTztvK-6eV8dVEU8e5URdX4Go8iY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAqU8AcceIkZaPClXrdOA63nuvRfrbUt9pzq_kNl2JK9w&oe=6A4D15BD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape.png", "id": "1992352341165327", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75326673_1992352344498660_5689810170846410426_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A7gb1qSMApsQ7kNvwGY_qqs&_nc_oc=AdoK86hGAua9WCPATJ-13rmSLq_PZftrLj0RydIhNctLlNtoCEbetLhF1CS4PLGwRX8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB5bJln6mD-pF2iadzO0C3uXJ3H9vVB7VwqjDID9FwsWA&oe=6A4CF9D0"}, "display_name": "Chamvr | Bowling & Arcade", "keywords": [], "long_description": "\ud83c\udfae Immerse Yourself in the Ultimate VR Bowling Experience! \ud83c\udf1f\n\nRediscover classic arcade games in stunning VR environments, and get ready for even more thrilling games on the horizon!\n\n\ud83d\udd79\ufe0f Features:\n\u2728 Online Multiplayer: Connect with friends and players from around the world as you compete in your favorite games.\n\n\ud83c\udfb3 8 Spectacular Bowling Lanes: Perfect your bowling skills in stunningly designed VR lanes. Rack up strikes, spares, and unforgettable moments!\n\n\ud83c\udfaa Arcade Extravaganza: We've brought the arcade to your VR headset! Try your hand at the ever-addictive Ski-ball, showcase your shooting prowess in Basketball, and prove your precision in Darts.\n\n\ud83c\udfb2 Classic Tabletop Games: Whether it's a battle of wits in Dominoes or a race to play the perfect card in Crazy Eights, we've got your favorite card games to enjoy with friends.\n\nJoin us today and be part of the VR gaming revolution! \ud83c\udf10\ud83d\udd79\ufe0f \n\nFor more info, and issues please email me at:\nbraulio@chamvr.com", "short_description": " Play Bowling and Arcade games with your VR friends"}]}, "developer_name": null, "developer_privacy_policy_url": "https://chamvr.com/privacy-notice", "developer_terms_of_service_url": null, "publisher_name": "Chamvr Inc", "support_website_url": null, "website_url": "https://www.chamvr.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ART_CREATIVITY", "SOCIAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "6093751260725287"}, "review_messages": []}]}, "cover_square
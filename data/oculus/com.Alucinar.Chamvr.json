": "834325571531597", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/39031423_834325574864930_8315226353867853407_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0C7RnO0QB6EQ7kNvwHK_De8&_nc_oc=Adqy8NSq-XvSi2cqVdXSCTP_gEI45Cwn84MayUpbVzle5pF6F6u5CQjeLVz8wKc6Q98&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHdSS32TuVDnfhJ5Mvz2zdWpLcMVTD7XeW8zhZOwEHt6A&oe=6A8EBE85"}, {"file_name": "Game_Room_6.png", "id": "485283489679170", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/38974763_485283493012503_5164190395246012611_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iaex8kAKT3cQ7kNvwEaEeUT&_nc_oc=AdqxeQBwF7Y74fVRogvMKo2yhveG2gmg_DjJP7ESN2ZeLehgoIjsrYyUHf-nQJsctjk&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEmn5Zt-EkCp8TKw5D9th5YXutnKFi6o33wWmW2CeyfqA&oe=6A8EE068"}, {"file_name": "Game_Room_13.png", "id": "546672083957284", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/38982642_546672090623950_4652714039044074389_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x_5vV3fnKXAQ7kNvwGT1aIo&_nc_oc=Adp9gP_aOQM0HpO2faQAZRnA8yDqNcWF57B-FNn4MOpW7WozwiWvXbuThHkX1HAG24Y&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE-7KIJuTB6Y0ipubz_lJesC7dBzjoePEWO0zPIyfE0vA&oe=6A8EC87D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape.png", "id": "1992352341165327", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/75326673_1992352344498660_5689810170846410426_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h78hu0frQPMQ7kNvwGqKnZo&_nc_oc=AdrGo3LtKQ3BNpT2N8qafdWldrCXOYarKB3yGbhCWadGqHOx75iMBDthkBZSX5B1qrs&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHvkWFP9jcQRDeFcH3rMHk6rnAQFnHzMzayVqOGNJKa0A&oe=6A8EE4D0"}, "display_name": "Chamvr | Bowling & Arcade", "keywords": [], "long_description": "\ud83c\udfae Immerse Yourself in the Ultimate VR Bowling Experience! \ud83c\udf1f\n\nRediscover classic arcade games in stunning VR environments, and get ready for even more thrilling games on the horizon!\n\n\ud83d\udd79\ufe0f Features:\n\u2728 Online Multiplayer: Connect with friends and players from around the world as you compete in your favorite games.\n\n\ud83c\udfb3 8 Spectacular Bowling Lanes: Perfect your bowling skills in stunningly designed VR lanes. Rack up strikes, spares, and unforgettable moments!\n\n\ud83c\udfaa Arcade Extravaganza: We've brought the arcade to your VR headset! Try your hand at the ever-addictive Ski-ball, showcase your shooting prowess in Basketball, and prove your precision in Darts.\n\n\ud83c\udfb2 Classic Tabletop Games: Whether it's a battle of wits in Dominoes or a race to play the perfect card in Crazy Eights, we've got your favorite card games to enjoy with friends.\n\nJoin us today and be part of the VR gaming revolution! \ud83c\udf10\ud83d\udd79\ufe0f \n\nFor more info, and issues please email me at:\nbraulio@chamvr.com", "short_description": " Play Bowling and Arcade games with your VR friends"}]}, "developer_name": null, "developer_privacy_policy_url": "https://chamvr.com/privacy-notice", "developer_terms_of_service_url": null, "publisher_name": "Chamvr Inc", "support_website_url": null, "website_url": "https://www.chamvr.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ART_CREATIVITY", "SOCIAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "6093751260725287"}, "review_messages": []}]},
eenshots": [{"file_name": "ss_07819cabf4a79d2e44267a0ab0b030b82e219b2c.800x600.png", "id": "3527254340868881", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38982675_3527254344202214_499898235920882390_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4vgjO_fCtDEQ7kNvwFEbxyX&_nc_oc=AdpCSWs7t0CN0FWvXrIq0Zrp0oN8IfvNTjSDN7PFDeMmBAAX4FNGpO59CqNgJ4sxt-M&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA4JBGuez0tnOyieONmv9Goe1hUkKHehtNMwnZf1h7Y7g&oe=6A5A1EF5"}, {"file_name": "ss_232b8ef6f511364e8d26167d74e93722d5411501.800x600.png", "id": "2146391722416940", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38982460_2146391725750273_844457987034417022_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IGosj31QqpsQ7kNvwF9vaRh&_nc_oc=AdpCZXLuo8KB69vpVHB8WO0ncm7YH-TCBiOs0t6HdlSULfUr61n87Njo4cSzBaF1Ttk&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDWFx3gIgp0rBT_RaPmnI44-A5wuVG3lmq5xIboWuZDOA&oe=6A5A1EB9"}, {"file_name": "ss_af29a860d852d0d580fb5f92b8e8737bf7592247.800x600.png", "id": "217702990747223", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/39031334_217702994080556_9001069891864074749_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zgpwPOR_tLYQ7kNvwHUINi2&_nc_oc=AdqTGfuV5v4kZgfUdxK9xU-nlA9o7ROi5HMY3sMQKEveYMIPjstjBz0vZjwbYw4ndWY&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAdXTsNwylmPrSj1WGrfYcXcobBDLoHSycndf6o8JRncg&oe=6A5A352B"}, {"file_name": "ss_8d96e44d89ceeb7395963835a4392fa29091f948.800x600.png", "id": "205921982092305", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/38974711_205921985425638_886920728880015757_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ipv9SM4mi7MQ7kNvwHrz5dE&_nc_oc=AdpwzizRnG61gv5236bE4F0DDXu8lYhk7s7df10RKgBccDsWJr48foCII8pE9Rs6fKc&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCenixVFnVJKopzsLeWRlSYfu7iUJGD1_eBagYwQBGc7Q&oe=6A5A2258"}, {"file_name": "Screenshot_2.png", "id": "153091737294234", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974924_153091740627567_5433916334622815674_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qDGPN_nVOMYQ7kNvwEetAHS&_nc_oc=Adq9Lc4j6B8qvQGyYLt31-_SqgMgk2JJ6YIuqVOjIoqqy6Zy3CNG6w0_lnwsw23Twj0&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBDCgzjxfSbxehVOuU1MWFX9rTV869N0fk2l57Yf3AfZg&oe=6A5A467D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TrailerThumbnail.png", "id": "1853512388674312", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/491819845_1853512392007645_7833972248519173304_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lTpbaY8sTegQ7kNvwHY2CyA&_nc_oc=AdqFvK7KpKGdPlu3CGUaW9JgsDk8F68Wi-KRQZ0RsTfW4YQ-BtfO4RYaaz9FJW-wcOs&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQANSYSI31HULd3b57MG1Yzdaqr7AtR-vp6DYzcLSTqd3w&oe=6A5A4260"}, "display_name": "Hyperstacks", "keywords": ["combat", "parkour", "editor", "logic", "hyper"], "long_description": "**Hyperstacks is a world of handcrafted challenges, memorable characters, and community-made levels.**\n\nMeet its residents and play handcrafted stages built around **combat, parkour, and logic puzzles**. Take on character-led quests and explore a growing library of community creations.\n\n# GAMEPLAY LOOP\nProgress through campaign levels shaped by a cast of characters, each with their personality and style of challenge. Between levels, return to the lobby to interact with them, take on quests, and unlock new mechanics.\n\nMost Hyperstacks levels are built around three core pillars:\n- **Combat**  \nFight with VR weapons against melee and ranged enemies in intense encounters. React under pressure and use hazards, the environment, and even your own fists to survive.\n{936773679244297}\n- **Parkour**  \nClimb, zip, swing, swim, jump, and improvise through levels with grappling hooks, ziplines, jump platforms, teleporters, skating, hot lava, and more.\n{1690485755273254}\n\n- **Logic**  \nPowered by Greenlink, a flexible system for connecting interactions, Hyperstacks supports everything from simple puzzles to elaborate contraptions.\n{924001363734840}\n\n**Players can push these systems in unexpected directions, but these three pillars shape how Hyperstacks is designed and how its levels are introduced to you.**\n \n# THE LEVEL EDITOR IS AT THE CORE\n**Every campaign level is built with the same tools available to players.**\n\nThe in-game level editor uses a flexible grid-based system, letting players create levels with enemies, traps, movement mechanics, puzzles, logic systems, and colors and lighting.\n{1705303364230562}", "short_description": "A VR world of combat, parkour, logic-driven puzzles, memorable characters, and community-made levels.\nMeet its residents through quests and discover a growing library of player creations."}]}, "developer_name": null, "developer_privacy_policy_url": "https://squirrel-bytes.com/meta-hyperstacks-privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Squirrel Bytes", "support_website_url": null, "website_url": "https://hyperstacksgame.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}, {"id": "1990104051447093"}, {"id": "528142316460358"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "PUZZLE", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["de", "ru", "ko", "en", "it", "fr", "es", "ja", "zh_CN"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "35937694505876153"},
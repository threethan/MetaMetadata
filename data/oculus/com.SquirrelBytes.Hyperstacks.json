f29a860d852d0d580fb5f92b8e8737bf7592247.800x600.png", "id": "217702990747223", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031334_217702994080556_9001069891864074749_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RRqegh85uX0Q7kNvwHTtt5T&_nc_oc=Ado3jYycP5z0EKSVDKfwRaZ1C36yfOn5hBDrquUiPYZbqPKFYA1bJoQt1WmAg1rJjcA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTm3tSTFK1wZsbIUOREvKkPzLTRagTerqfuPyX16_2ifA&oe=6AEB3A2B"}, {"file_name": "ss_8d96e44d89ceeb7395963835a4392fa29091f948.800x600.png", "id": "205921982092305", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974711_205921985425638_886920728880015757_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hGrAZKxm-hsQ7kNvwEr1xBY&_nc_oc=AdooapFy2oaSN8HnDhsmvEOqXi7RKqY-QMWbStr-gDbEwIe-B_xuWb1CBWqSQC_OT0s&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTuB0yTuYx2d_zoHSTovuoX5zCRlnlm1Et5XeRCOyVdDA&oe=6AEB5F98"}, {"file_name": "Screenshot_2.png", "id": "153091737294234", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974924_153091740627567_5433916334622815674_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=88K0pVAN7kQQ7kNvwFnApV5&_nc_oc=AdrKeBcGb9h2JHV1ZbgV_eT-4W-rR7Z06I7YvXrKHZxeS75QRMbJG1FTJEvv0okMBEc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQy2Bcy8Sc0oeCQOwdinihnNIPtAQQ31f57vn7jAGnlzw&oe=6AEB4B7D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TrailerThumbnail.png", "id": "1853512388674312", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491819845_1853512392007645_7833972248519173304_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FI5af2TQt68Q7kNvwE_XmtR&_nc_oc=AdqaF_W-U6ceLV17TM-9Y_NZrKFyGeXrOjyMu_7plqZboXkZT8mSBoC76ljPY7XrAEc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTm-FVRlKIJjmiN9spxy-eMuXY_qu9AafZWypMpiIccHg&oe=6AEB4760"}, "display_name": "Hyperstacks", "keywords": ["combat", "parkour", "editor", "logic", "hyper"], "long_description": "**Hyperstacks is a world of handcrafted challenges, memorable characters, and community-made levels.**\n\nMeet its residents and play handcrafted stages built around **combat, parkour, and logic puzzles**. Take on character-led quests and explore a growing library of community creations.\n\n# GAMEPLAY LOOP\nProgress through campaign levels shaped by a cast of characters, each with their personality and style of challenge. Between levels, return to the lobby to interact with them, take on quests, and unlock new mechanics.\n\nMost Hyperstacks levels are built around three core pillars:\n- **Combat**  \nFight with VR weapons against melee and ranged enemies in intense encounters. React under pressure and use hazards, the environment, and even your own fists to survive.\n{936773679244297}\n- **Parkour**  \nClimb, zip, swing, swim, jump, and improvise through levels with grappling hooks, ziplines, jump platforms, teleporters, skating, hot lava, and more.\n{1690485755273254}\n\n- **Logic**  \nPowered by Greenlink, a flexible system for connecting interactions, Hyperstacks supports everything from simple puzzles to elaborate contraptions.\n{924001363734840}\n\n**Players can push these systems in unexpected directions, but these three pillars shape how Hyperstacks is designed and how its levels are introduced to you.**\n \n# THE LEVEL EDITOR IS AT THE CORE\n**Every campaign level is built with the same tools available to players.**\n\nThe in-game level editor uses a flexible grid-based system, letting players create levels with enemies, traps, movement mechanics, puzzles, logic systems, and colors and lighting.\n{1705303364230562}", "short_description": "A VR world of combat, parkour, logic-driven puzzles, memorable characters, and community-made levels.\nMeet its residents through quests and discover a growing library of player creations."}, {"images": {"nodes": [{"file_name": "Meta_Square_Chinese.png", "id": "3100520667004361", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491819845_3100520673671027_2947415179316808989_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mwamlIl06bwQ7kNvwGPiZJp&_nc_oc=AdqF0-5g5uPWiI2W4yyA0ovWurEmgJ2n14ibzSQx6Wp5t-mT-XVUBl86fttfHzufNzY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS2Yig08P1IiU1xUOdEisb_YOHjsDp6D1OWLWgcIHlzAQ&oe=6AEB41FA"}, {"file_name": "Meta_Portrait_Chinese.png", "id": "1344742150894290", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823812_1344742157560956_3866022420204310527_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AByW3KDcczUQ7kNvwGKt5zJ&_nc_oc=Adp0SbH92InBoGpILwukcA0W21mFbE5Fe0Kg_MpS2-GtBEIbhhLOGHFWamuRJKxCdeA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRrzGUC5uOU6J-zTbX4TCr13xUYPgamFbA9TUGtw_rBfw&oe=6AEB622F"}, {"file_name": "Meta_Hero_Chinese.png", "id": "974871085008315", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491824318_974871088341648_5200156850840335780_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dxZ5-mIYgHIQ7kNvwEvn5DL&_nc_oc=Adqmsy7K68Ggk567nhvUawDyWbNz4kh7Jlmtm2ju4K4ebOwrGRqLviGewTE3d7jxQfA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQH_m-5fVsEWI2nRjPcoKyJBQ_yWNv99d3YzA4K0NIIIA&oe=6AEB4907"}, {"file_name": "Meta_Landscape_Chinese.png", "id": "967906605777481", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823790_967906609110814_9153742702586604529_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6YiBCeyxOoYQ7kNvwHGGXai&_nc_oc=AdoOUF60D7pdZrBedRMDhvmeqmJ-dSYiIDzKEwEjOVYfns5VIH7FknK3NjvV9SrWGOY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQO4BUxEeOqMRJlWWFGir3EB0ZtSwt_LApMWrSwTfm9zw&oe=6AEB2EC4"}, {"file_name": "vr_screenshot_01.png", "id": "931637856342770", "image_type": "APP_IMG_CUBEMAP_SOURCE", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491828583_931637859676103_3319102803980754307_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nVM9zVcqd4IQ7kNvwGXIrh1&_nc_oc=Adq-muZWKXhrgETahTdB4-EdNHpVKlsqa_JAq0hedYg1EiFBN_ZVyR9_nh9xd1rUfW8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTxWZB6no7GjxRgRX1InQYjXQQADDCoR6L9WWaxqTt6WQ&oe=6AEB6053"}]}, "id": "994992366845384", "locale": "zh_CN", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Meta_Landscape_Chinese.png", "id": "1888526371861648", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491820892_1888526378528314_5502493121583461863_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nHPjfx2X0BMQ7kNvwGKzMpK&_nc_oc=AdoEOMkqG2mKRKYk9cnYnFKThht35XELDy5hadBsh9Oa2mcesCGxNLNuZuGGqVmY044&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ8-HcSQkEX05_2oVV7SU2_K9PpFliDr61F1iuv6vdcDw&oe=6AEB3A80"}, "display_name": "\u4ea5\u4f2f\u5236\u9020", "keywords": ["\u6218\u6597", "\u8dd1\u9177", "\u89e3\u8c1c", "\u5173\u5361\u7f16\u8f91\u5668"], "long_description": "**\u300a\u4ea5\u4f2f\u5236\u9020\u300b\u662f\u4e00\u4e2a\u6c47\u805a\u7cbe\u5fc3\u8bbe\u8ba1\u7684\u6311\u6218\u3001\u4e2a\u6027\u9c9c\u660e\u7684\u89d2\u8272\u4e0e\u73a9\u5bb6\u81ea\u5236\u5173\u5361\u7684\u4e16\u754c\u3002**\n\n\u7ed3\u8bc6\u8fd9\u91cc\u7684\u5c45\u6c11\uff0c\u4f53\u9a8c\u56f4\u7ed5 **\u6218\u6597\u3001\u8dd1\u9177\u4e0e\u903b\u8f91\u89e3\u8c1c** \u7cbe\u5fc3\u6253\u9020\u7684\u5173\u5361\u3002\u63a5\u53d6\u7531\u5404\u4e2a\u89d2\u8272\u5e26\u6765\u7684\u4efb\u52a1\uff0c\u5e76\u63a2\u7d22\u4e0d\u65ad\u6269\u5c55\u7684\u73a9\u5bb6\u521b\u4f5c\u5185\u5bb9\u5e93\u3002\n\n# \u6838\u5fc3\u73a9\u6cd5\u5faa\u73af\n\u5728\u7531\u4f17\u591a\u89d2\u8272\u4e32\u8054\u8d77\u6765\u7684\u6218\u5f79\u5173\u5361\u4e2d\u4e0d\u65ad\u63a8\u8fdb\uff1b\u6bcf\u4f4d\u89d2\u8272\u90fd\u62e5\u6709\u9c9c\u660e\u7684\u4e2a\u6027\uff0c\u4ee5\u53ca\u5404\u5177\u7279\u8272\u7684\u6311\u6218\u98ce\u683c\u3002\u6bcf\u5b8c\u6210\u4e00\u4e2a\u5173\u5361\u540e\uff0c\u4f60\u90fd\u53ef\u4ee5\u56de\u5230\u5927\u5385\u4e0e\u4ed6\u4eec\u4e92\u52a8\u3001\u63a5\u53d6\u4efb\u52a1\uff0c\u5e76\u89e3\u9501\u65b0\u7684\u673a\u5236\u3002\n\n\u300a\u4ea5\u4f2f\u5236\u9020\u300b\u7684\u5927\u591a\u6570\u5173\u5361\u90fd\u56f4\u7ed5\u4e09\u5927\u6838\u5fc3\u652f\u67f1\u5c55\u5f00\uff1a\n\n- **\u6218\u6597**  \n\u4f7f\u7528 VR \u6b66\u5668\uff0c\u5728\u6fc0\u70c8\u7684\u906d\u9047\u6218\u4e2d\u5bf9\u6297\u8fd1\u6218\u4e0e\u8fdc\u7a0b\u654c\u4eba\u3002\u5728\u9ad8\u538b\u4e4b\u4e0b\u8fc5\u901f\u53cd\u5e94\uff0c\u5229\u7528\u573a\u666f\u4e2d\u7684\u5371\u9669\u3001\u73af\u5883\u8981\u7d20\uff0c\u751a\u81f3\u76f4\u63a5\u6325\u62f3\u6c42\u751f\u3002\n{989248906982984}\n\n- **\u8dd1\u9177**  \n\u6500\u722c\u3001\u6ed1\u7d22\u3001\u6446\u8361\u3001\u6e38\u6cf3\u3001\u8df3\u8dc3\uff0c\u5e76\u5728\u5173\u5361\u4e2d\u7075\u6d3b\u5e94\u53d8\u3002\u501f\u52a9\u6293\u94a9\u3001\u6ed1\u7d22\u3001\u8df3\u53f0\u3001\u4f20\u9001\u5668\u3001\u6ed1\u884c\u3001\u70bd\u70ed\u5ca9\u6d46\u7b49\u591a\u79cd\u5143\u7d20\u4e00\u8def\u524d\u8fdb\u3002\n{913483548120279}\n\n- **\u903b\u8f91**  \n\u7531\u201c\u7eff\u9752\u94fe\u201d\u7cfb\u7edf\u9a71\u52a8\u2014\u2014\u8fd9\u662f\u4e00\u5957\u7075\u6d3b\u7684\u4ea4\u4e92\u8fde\u63a5\u7cfb\u7edf\u3002\u501f\u52a9\u5b83\uff0c\u300a\u4ea5\u4f2f\u5236\u9020\u300b\u65e2\u80fd\u5448\u73b0\u7b80\u5355\u76f4\u89c2\u7684\u8c1c\u9898\uff0c\u4e5f\u80fd\u6784\u5efa\u590d\u6742\u7cbe\u5de7\u7684\u673a\u5173\u88c5\u7f6e\u3002\n{1279891017427930}\n\n**\u73a9\u5bb6\u5f53\u7136\u4e5f\u53ef\u4ee5\u628a\u8fd9\u4e9b\u7cfb\u7edf\u73a9\u51fa\u610f\u60f3\u4e0d\u5230\u7684\u82b1\u6837\uff0c\u4f46\u8fd9\u4e09\u5927\u6838\u5fc3\u4ecd\u7136\u5b9a\u4e49\u4e86\u300a\u4ea5\u4f2f\u5236\u9020\u300b\u7684\u8bbe\u8ba1\u65b9\u5411\uff0c\u4ee5\u53ca\u4f60\u63a5\u89e6\u5404\u7c7b\u5173\u5361\u7684\u65b9\u5f0f\u3002**\n \n# \u5173\u5361\u7f16\u8f91\u5668\u662f\u6838\u5fc3\n**\u6218\u5f79\u4e2d\u7684\u6bcf\u4e00\u4e2a\u5173\u5361\uff0c\u90fd\u662f\u7528\u4e0e\u73a
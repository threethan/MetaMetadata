-09-17_22-40-30.png", "id": "275494520588765", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39036704_275494523922098_2426874895962552879_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SoyjirDGTRIQ7kNvwEEVebs&_nc_oc=AdpuQbD9U640j9abD9e6SYuCA9txo0aS7Lcu3cZu1eHslabC4oKkicQfZ_5AEwGF2LQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFIsS-b9swVbkf0jp7jy1KvaOPTpFhA7djnfwLzLb5YTA&oe=6A95E002"}, {"file_name": "screen_2560x1440_2020-09-17_22-46-29.png", "id": "238990151157199", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38984447_238990154490532_767541046175693257_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2PtOsDGPZWwQ7kNvwGptiIF&_nc_oc=AdqmcO3IQrP_xTy9jvEnGuWwIM6ZRv2bDjkysdIS-AnswBoAqomFna4wlXB6uLqeCWA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEULkC_rlgLvBZjDsqomdCiBP7HAc8YaaiT_uDfwiy4XA&oe=6A95CDF0"}, {"file_name": "screen_2560x1440_2020-09-17_22-45-52.png", "id": "153148369974995", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974693_153148373308328_3846551554399346998_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d-ADd4TkllEQ7kNvwGNqah8&_nc_oc=Adrq2Xqz26ZQMiC14A-P29_i3LNxrdco_95cLkX0rVZiNVyG8V-c4SwRTzs2PAwr4u4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQESRNvld9h25UNBw-c7b8HBuQm-DaaiFebnGRnYorUWmA&oe=6A95D4DD"}, {"file_name": "screen_2560x1440_2020-09-17_22-43-52.png", "id": "429953335104667", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974714_429953338438000_1630301928601733580_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UmMrFd2FA0IQ7kNvwHlep_S&_nc_oc=AdrV-cBxPkLpnl9qrnu6EaC0ebMVHw4REjAACkdQ23zz47mTQh_1EJ03crjFScZLfkk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGaxvh-JI-Cbv7Pl5iZuwwP7IAUYL9Q6UPaZOi7DqBa7A&oe=6A95D002"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screen_2560x1440_2020-09-17_22-47-51.png", "id": "230829075192600", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974887_230829078525933_560344683498926700_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f2Nm8Z_KIdwQ7kNvwGi9Red&_nc_oc=AdrlYb7g0-N1qWOt88vRC3Tn6zdXJFUIdZA7NYF1kRCzxKpk8zmL7RPjtdDs8Jxdjhg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGDtvCBNtQLyxW18AjI562LvNJHUroxvNb1EpTszUbkBw&oe=6A95AFFF"}, "display_name": "War Yards Beta", "keywords": [], "long_description": "War Yards is a 1v1 multiplayer shooter that approaches bullet time combat in a whole new way. The game utilizes a unique set of mechanics that allow each player to control the speed of their opponent\u2019s projectiles. Bullet time mode can be activated at any time, but while active it restricts the player to room-scale movement only and removes their ability to reload. These mechanics create an unparalleled combat experience that seamlessly blends fast paced action with tense strategy. War Yards combines these innovative gameplay systems with incredibly detailed stylized maps to make for a truly unforgettable VR western adventure.\n\nFeatures:\n- Challenge your friends to intense and highly strategic 1v1 duels.\n- Utilize incredibly unique multiplayer bullet time mechanics to outsmart your opponent.\n- Explore 4 highly detailed stylized maps inspired by classic western settings.\n- Enjoy the freedom of playing with users across nearly all VR platforms.", "short_description": "Step into the shoes of a legendary gunslinger and experience a new kind of VR multiplayer combat. War Yards utilizes a set of unique gameplay systems to seamlessly bring bullet time mechanics to multiplayer matches."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.iubenda.com/privacy-policy/24673521/legal", "developer_terms_of_service_url": null, "publisher_name": "Pixel Framers LLC", "support_website_url": null, "website_url": "https://www.waryards.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "con
-09-17_22-40-30.png", "id": "275494520588765", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39036704_275494523922098_2426874895962552879_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CxnAAHunwYcQ7kNvwFnFVKR&_nc_oc=AdqZecyB1OHyB_7K8VXfPJgfRoCgviKnJl0c0ceMI1BvrZyP2cy5EP9LU4ADO8LuDHA&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af51m0JJOd8FjytQp8LZAmVcauFskT2lPsoNVkP2mEqLRw&oe=6A070D82"}, {"file_name": "screen_2560x1440_2020-09-17_22-46-29.png", "id": "238990151157199", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38984447_238990154490532_767541046175693257_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EBHs9VCekcQQ7kNvwH49NJb&_nc_oc=AdpxRJtsD69D2Jt1Vk_Lht4KSSvxoQdJwsI8oGRVnuDTaJ3woNrNiHPnRhbJq-Ob9Gs&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5fZmnVLUb3Xh993hok7Kc9NlXBOL4rjb3wt75J2-aTAw&oe=6A0733B0"}, {"file_name": "screen_2560x1440_2020-09-17_22-45-52.png", "id": "153148369974995", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974693_153148373308328_3846551554399346998_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_Ufu0JRoIDYQ7kNvwEzVWXl&_nc_oc=AdpvCkvoOgpAx4s-lPQaASuU_tmvp7kUkJ0R_GVbli6pvQpg_FexeSm1UheosGvJi9Q&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af53JPl6A4w9f5Q6byGsgJAfLf4NlM_jz57sH7bmRd5jjw&oe=6A073A9D"}, {"file_name": "screen_2560x1440_2020-09-17_22-43-52.png", "id": "429953335104667", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974714_429953338438000_1630301928601733580_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KPayj7GMTGQQ7kNvwHnwra1&_nc_oc=Adrf19qNdX6JZiOD9krHNAqkk4WIh7vqfZvETiW0EIBc9xZ4R-f17_kB37XEcR83FYI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5D-FUBa5HA4pYMdY4PZGz3_lr6DVEl15ASdvnsKls5Gw&oe=6A0735C2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screen_2560x1440_2020-09-17_22-47-51.png", "id": "230829075192600", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974887_230829078525933_560344683498926700_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Q39_S_bx-agQ7kNvwFvg0Ts&_nc_oc=AdoLeCKL84Ot0uKprggzXhj2JQNMR9NgD_pLzn7gVMsLhx8VmppA1RKCrs2-FZRX2dQ&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7sO-8AaPaLcFPl3eNeIBXxiDNSoZUMU82E9EUIk6QrSg&oe=6A0715BF"}, "display_name": "War Yards Beta", "keywords": [], "long_description": "War Yards is a 1v1 multiplayer shooter that approaches bullet time combat in a whole new way. The game utilizes a unique set of mechanics that allow each player to control the speed of their opponent\u2019s projectiles. Bullet time mode can be activated at any time, but while active it restricts the player to room-scale movement only and removes their ability to reload. These mechanics create an unparalleled combat experience that seamlessly blends fast paced action with tense strategy. War Yards combines these innovative gameplay systems with incredibly detailed stylized maps to make for a truly unforgettable VR western adventure.\n\nFeatures:\n- Challenge your friends to intense and highly strategic 1v1 duels.\n- Utilize incredibly unique multiplayer bullet time mechanics to outsmart your opponent.\n- Explore 4 highly detailed stylized maps inspired by classic western settings.\n- Enjoy the freedom of playing with users across nearly all VR platforms.", "short_description": "Step into the shoes of a legendary gunslinger and experience a new kind of VR multiplayer combat. War Yards utilizes a set of unique gameplay systems to seamlessly bring bullet time mechanics to multiplayer matches."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.iubenda.com/privacy-policy/24673521/legal", "developer_terms_of_service_url": null, "publisher_name": "Pixel Framers LLC", "support_website_url": null, "website_url": "https://www.waryards.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "con
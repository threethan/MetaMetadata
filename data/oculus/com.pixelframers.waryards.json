-09-17_22-40-30.png", "id": "275494520588765", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/39036704_275494523922098_2426874895962552879_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PEdn8-nnO-EQ7kNvwHxaSwG&_nc_oc=AdqbtRo1nh4toYHN0bUNl3iYTEaPrJknAgqsymPjVdyrPOhD_jUCPwkbRrUmOS1S3LU&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKHcKxYLtvd8swRSDWRKVcABH5kQ1lwYBGXTw2VT7igJg&oe=6AA14D02"}, {"file_name": "screen_2560x1440_2020-09-17_22-46-29.png", "id": "238990151157199", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38984447_238990154490532_767541046175693257_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gZncLuPr2FMQ7kNvwFxnokg&_nc_oc=AdqIl84KJtCZWoakebdOws8Yppr9hUsi7bTi1oIGGSNl_3EmUX-2F-jnt0oO784Z3hw&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ6R9vSyJwoTC8Eyc-dNWk76pEYHVxtha-PjU1Lo_spYw&oe=6AA17330"}, {"file_name": "screen_2560x1440_2020-09-17_22-45-52.png", "id": "153148369974995", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38974693_153148373308328_3846551554399346998_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XrqHcjNOnicQ7kNvwExwBAA&_nc_oc=AdrwNHy0QsaUK4SSW2B07OPG6AdwRbEsvJS52QoyBNILBa3t05kPVdZEI4Q_3en_PDU&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLbGGEE5Fsa57vc5iLDQtsj2mlbMA76yuNnXi1j2kNQhg&oe=6AA17A1D"}, {"file_name": "screen_2560x1440_2020-09-17_22-43-52.png", "id": "429953335104667", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38974714_429953338438000_1630301928601733580_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z7hdOORow0QQ7kNvwGMRhQ3&_nc_oc=AdqptwM4nw7tZNFSjc1OhxEsefwGuOEDawr_GETM4SaIirZpgntPQthjUXZagVDM7fs&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI588adiAws4MYa_76MX1mUZLm5KzWsbrAmDFeKg4EweQ&oe=6AA17542"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screen_2560x1440_2020-09-17_22-47-51.png", "id": "230829075192600", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38974887_230829078525933_560344683498926700_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YwxLsMqrs7UQ7kNvwEX0eYU&_nc_oc=Adq22Zx-wPlL7BiQB0rNJg0O9bZe1rllIVS4n2Ce1MIi9hmgv_9xEr-O8EQU39-gXSk&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLm2ocRcfABMmmycXXdo4deZAKwXpYg64TKTX8IpEwqgQ&oe=6AA1553F"}, "display_name": "War Yards Beta", "keywords": [], "long_description": "War Yards is a 1v1 multiplayer shooter that approaches bullet time combat in a whole new way. The game utilizes a unique set of mechanics that allow each player to control the speed of their opponent\u2019s projectiles. Bullet time mode can be activated at any time, but while active it restricts the player to room-scale movement only and removes their ability to reload. These mechanics create an unparalleled combat experience that seamlessly blends fast paced action with tense strategy. War Yards combines these innovative gameplay systems with incredibly detailed stylized maps to make for a truly unforgettable VR western adventure.\n\nFeatures:\n- Challenge your friends to intense and highly strategic 1v1 duels.\n- Utilize incredibly unique multiplayer bullet time mechanics to outsmart your opponent.\n- Explore 4 highly detailed stylized maps inspired by classic western settings.\n- Enjoy the freedom of playing with users across nearly all VR platforms.", "short_description": "Step into the shoes of a legendary gunslinger and experience a new kind of VR multiplayer combat. War Yards utilizes a set of unique gameplay systems to seamlessly bring bullet time mechanics to multiplayer matches."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.iubenda.com/privacy-policy/24673521/legal", "developer_terms_of_service_url": null, "publisher_name": "Pixel Framers LLC", "support_website_url": null, "website_url": "https://www.waryards.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "con
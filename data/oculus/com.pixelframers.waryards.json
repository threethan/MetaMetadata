-09-17_22-40-30.png", "id": "275494520588765", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/39036704_275494523922098_2426874895962552879_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=szWtOLkBS6IQ7kNvwGulurb&_nc_oc=Adq3UeVNdONFbO2gXdfJ97wIXiOuHgl9-ju9L_kPZ5wrhrrKrOi__n43spmUs4dN5TA&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD-R8rANLKXvajQEUhdikUIiWbw6PaRYGzQs_VbdkVhIw&oe=6A562782"}, {"file_name": "screen_2560x1440_2020-09-17_22-46-29.png", "id": "238990151157199", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/38984447_238990154490532_767541046175693257_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QnX6pvoTJgQQ7kNvwHMrzEQ&_nc_oc=Adr2brZI9ULWVhhXWyv125Tt2y6odMnvNd6OMhSgx5YpIGe6G6miLJNpVOzRlt3OFOg&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB2cDQFZP55jE0MmK65-E4i7Igj3yjCA-78bJTDePsPjg&oe=6A564DB0"}, {"file_name": "screen_2560x1440_2020-09-17_22-45-52.png", "id": "153148369974995", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38974693_153148373308328_3846551554399346998_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9cG4qN59SjsQ7kNvwFRmX9D&_nc_oc=AdoL-j9E7vm_UNhQyP_9WmAKPsXL_YYXTrnXNEw4O82A_xI_jCtc_hXeV0X2CJ48mKQ&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD4X9NjkN6DFYKPu9_o2om8ycuYmBL2jMq3-RAkosW0Eg&oe=6A56549D"}, {"file_name": "screen_2560x1440_2020-09-17_22-43-52.png", "id": "429953335104667", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/38974714_429953338438000_1630301928601733580_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jc3cgNtMrCkQ7kNvwGFHPqf&_nc_oc=AdrkdbVnDoQX4PAw53CYZ65DqbjeOi5lbyx2l49NehSCRJUq_v9RYYmhHBoS2h66WhU&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD9MmrWZS3U_E4RknGdx_OhTu_fdeMHEMhRMgLiL4I8uw&oe=6A564FC2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screen_2560x1440_2020-09-17_22-47-51.png", "id": "230829075192600", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/38974887_230829078525933_560344683498926700_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H5xgeySgHUYQ7kNvwF3Xubr&_nc_oc=AdroqKaebvT9jylxfL1C7_nDvYn6AWnYXdj1xwxbDL23-nH6WWZXVE7mBKuM2VmD-y0&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA363XoUoMFdyje_cGPEdwQUa6Ky63FcFX5kjdIQZpHSA&oe=6A562FBF"}, "display_name": "War Yards Beta", "keywords": [], "long_description": "War Yards is a 1v1 multiplayer shooter that approaches bullet time combat in a whole new way. The game utilizes a unique set of mechanics that allow each player to control the speed of their opponent\u2019s projectiles. Bullet time mode can be activated at any time, but while active it restricts the player to room-scale movement only and removes their ability to reload. These mechanics create an unparalleled combat experience that seamlessly blends fast paced action with tense strategy. War Yards combines these innovative gameplay systems with incredibly detailed stylized maps to make for a truly unforgettable VR western adventure.\n\nFeatures:\n- Challenge your friends to intense and highly strategic 1v1 duels.\n- Utilize incredibly unique multiplayer bullet time mechanics to outsmart your opponent.\n- Explore 4 highly detailed stylized maps inspired by classic western settings.\n- Enjoy the freedom of playing with users across nearly all VR platforms.", "short_description": "Step into the shoes of a legendary gunslinger and experience a new kind of VR multiplayer combat. War Yards utilizes a set of unique gameplay systems to seamlessly bring bullet time mechanics to multiplayer matches."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.iubenda.com/privacy-policy/24673521/legal", "developer_terms_of_service_url": null, "publisher_name": "Pixel Framers LLC", "support_website_url": null, "website_url": "https://www.waryards.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "con
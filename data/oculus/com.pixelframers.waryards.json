, {"file_name": "screen_2560x1440_2020-09-17_22-43-52.png", "id": "429953335104667", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974714_429953338438000_1630301928601733580_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ijshdP5QyroQ7kNvwFZd117&_nc_oc=AdrKyGXaPqphcdL2zkmzfA-OFbO1dsv1pJzm-HtZwwxnO0TZeFiMrSTqxxrsgcZPS7g&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSvo3yK8bXUpHF-s4Bx5hf_YDi5XNhFIGJH9W7r6ZrNbw&oe=6B006142"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screen_2560x1440_2020-09-17_22-47-51.png", "id": "230829075192600", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974887_230829078525933_560344683498926700_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=olhoTeeyKTYQ7kNvwGMl9xT&_nc_oc=AdrH0RMsQyIFkFcDoSgam0Fr4NhlmChg6lpAoBETtjLmGb1wZHJXxSl-bAYMUvK51ho&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSAKWIawb7NSIHZUS3xe6IbGuSfiESOz3bts5-Vjb03Cg&oe=6B00797F"}, "display_name": "War Yards Beta", "keywords": [], "long_description": "War Yards is a 1v1 multiplayer shooter that approaches bullet time combat in a whole new way. The game utilizes a unique set of mechanics that allow each player to control the speed of their opponent\u2019s projectiles. Bullet time mode can be activated at any time, but while active it restricts the player to room-scale movement only and removes their ability to reload. These mechanics create an unparalleled combat experience that seamlessly blends fast paced action with tense strategy. War Yards combines these innovative gameplay systems with incredibly detailed stylized maps to make for a truly unforgettable VR western adventure.\n\nFeatures:\n- Challenge your friends to intense and highly strategic 1v1 duels.\n- Utilize incredibly unique multiplayer bullet time mechanics to outsmart your opponent.\n- Explore 4 highly detailed stylized maps inspired by classic western settings.\n- Enjoy the freedom of playing with users across nearly all VR platforms.", "short_description": "Step into the shoes of a legendary gunslinger and experience a new kind of VR multiplayer combat. War Yards utilizes a set of unique gameplay systems to seamlessly bring bullet time mechanics to multiplayer matches."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.iubenda.com/privacy-policy/24673521/legal", "developer_terms_of_service_url": null, "publisher_name": "Pixel Framers LLC", "support_website_url": null, "website_url": "https://www.waryards.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ARCADE", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "1333381993829083"}}]}, "scheduled_offers": {"count": 0, "nodes": []}, "baseline_offer": null, "is_approved": true, "firstOffer": {"nodes": []}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "6436589983033855", "version": "0.1.6"}, "id": "762517177716454", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "5673429859349875", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "6436589983033855"}, "release_status": "RELEASED"}, "binary_release_c
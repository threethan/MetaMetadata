-09-17_22-40-30.png", "id": "275494520588765", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39036704_275494523922098_2426874895962552879_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-rX2bxqynZEQ7kNvwHYh1xS&_nc_oc=AdpuGccNaE5d03zSKzuQNC-OZ2lsb3QNa5E8JJRUkrzDoy15VbQj45VbbLtLJzL48lM&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAY1hkW3eYC2FGil_ktl3dsB7Cm01L2HyD4uQj4MsKRBQ&oe=6A4A8242"}, {"file_name": "screen_2560x1440_2020-09-17_22-46-29.png", "id": "238990151157199", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38984447_238990154490532_767541046175693257_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=39dYO-aMmK4Q7kNvwHMOxtA&_nc_oc=AdpSV7gzB2cnb5uyEjpoYyaozq9gPBr2fbEsxyvDl18Y9HCxVv9HaIjPyuJNXe1z_-I&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB5ykVjp4E0UTpNdKRfXgvBWgtYx0rXvqGSyt20rkRMJQ&oe=6A4A7030"}, {"file_name": "screen_2560x1440_2020-09-17_22-45-52.png", "id": "153148369974995", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974693_153148373308328_3846551554399346998_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SViQOwXay2MQ7kNvwF-RgKx&_nc_oc=Adq6M3CG_kZl2nnzxQ56UNgSVu9drnpuSKaR4TjCG1vtSxzdLjnS0D1oEkmTToJPLwI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDSVD5zQ-7LXheIjyDGlZi4yTun1kdookH6beGiOOwLRA&oe=6A4A771D"}, {"file_name": "screen_2560x1440_2020-09-17_22-43-52.png", "id": "429953335104667", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974714_429953338438000_1630301928601733580_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JEcf15hTTX8Q7kNvwFu6ioh&_nc_oc=AdpisycW4FbXOje4ldxO11h7YO8aHu-0dU7LA3UHFvJpBggTrRig7ZD5d3kLxKE7Zpc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDnuKxtyig7t-53Y-59Cgy03chPAbaXUOuVttMZhXtnAQ&oe=6A4A7242"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screen_2560x1440_2020-09-17_22-47-51.png", "id": "230829075192600", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974887_230829078525933_560344683498926700_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PMIME5v-OggQ7kNvwEnpWmS&_nc_oc=Adq4FPm_eBagMyKzRVIrChn27Il7Rq7XfUgR4OALgtgFWLRfADidUaRgkBkkEeLSVSQ&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDz0HPUxF9RY40jGgQMf-XaOkiclRjkWG8QaZgt1vxZ_A&oe=6A4A523F"}, "display_name": "War Yards Beta", "keywords": [], "long_description": "War Yards is a 1v1 multiplayer shooter that approaches bullet time combat in a whole new way. The game utilizes a unique set of mechanics that allow each player to control the speed of their opponent\u2019s projectiles. Bullet time mode can be activated at any time, but while active it restricts the player to room-scale movement only and removes their ability to reload. These mechanics create an unparalleled combat experience that seamlessly blends fast paced action with tense strategy. War Yards combines these innovative gameplay systems with incredibly detailed stylized maps to make for a truly unforgettable VR western adventure.\n\nFeatures:\n- Challenge your friends to intense and highly strategic 1v1 duels.\n- Utilize incredibly unique multiplayer bullet time mechanics to outsmart your opponent.\n- Explore 4 highly detailed stylized maps inspired by classic western settings.\n- Enjoy the freedom of playing with users across nearly all VR platforms.", "short_description": "Step into the shoes of a legendary gunslinger and experience a new kind of VR multiplayer combat. War Yards utilizes a set of unique gameplay systems to seamlessly bring bullet time mechanics to multiplayer matches."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.iubenda.com/privacy-policy/24673521/legal", "developer_terms_of_service_url": null, "publisher_name": "Pixel Framers LLC", "support_website_url": null, "website_url": "https://www.waryards.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "con
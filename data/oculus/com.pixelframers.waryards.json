-09-17_22-40-30.png", "id": "275494520588765", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39036704_275494523922098_2426874895962552879_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xjJiIHQx9vIQ7kNvwHNY35o&_nc_oc=AdptanPOWaXdp6s1gKMJalReJqVDvQr_FZIaS3X2Ggr9lpa9VOXLfQpi56FXOg6qj2c&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5qggVactKkcVq2_VL2UjhiO0JmQC_2LEbEEWlMEPgArA&oe=69FB3002"}, {"file_name": "screen_2560x1440_2020-09-17_22-46-29.png", "id": "238990151157199", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38984447_238990154490532_767541046175693257_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IVVFh7ItSqsQ7kNvwHHHTrG&_nc_oc=AdoK0oewEZ1UjZeNJ9QM2KUYDYCOihrbZLzKe45ftunAryr4K59j9HrR7ARzO-205nc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4SCKlC2Rs4Awu8iuVJl4xPX1CTmlmxHR6iV99nhd7ODw&oe=69FB5630"}, {"file_name": "screen_2560x1440_2020-09-17_22-45-52.png", "id": "153148369974995", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974693_153148373308328_3846551554399346998_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Yp1-dG09fZcQ7kNvwEZcnGN&_nc_oc=Adrv7T71d8g5mzMuszvIfDkP_Oru67wfxW5oL5uAT9WtS6N103vf2f001-5i_yFfJaY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6QjWyr5zzKInWowBnJUU3Oe3Yg__ZD2ioRgWl_nNYJAw&oe=69FB5D1D"}, {"file_name": "screen_2560x1440_2020-09-17_22-43-52.png", "id": "429953335104667", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974714_429953338438000_1630301928601733580_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aAO4DDACpawQ7kNvwEJL6i-&_nc_oc=Adq5kf44BvfGtRyDEeqEA_4eZANkl5hoSTVnixSk7jAk9B9VGRm5utc6yeXMgKy8iyo&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5iOxJS1z_LOHzEEoWSLf7nF_V-vP_5oyIO53jzvr-jkg&oe=69FB5842"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screen_2560x1440_2020-09-17_22-47-51.png", "id": "230829075192600", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974887_230829078525933_560344683498926700_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PWQ2zi93bNwQ7kNvwFDOWGH&_nc_oc=Adp3rU_1NPPutNlIBvcQUl_PHgh5XHqXOvXnrL747Kw1W_4nmtjB9dKG0k_yj8rpC_E&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5fTZBb8RsuKLJw2EkDY4sovezI09e3jXmHXwWyia-PJw&oe=69FB383F"}, "display_name": "War Yards Beta", "keywords": [], "long_description": "War Yards is a 1v1 multiplayer shooter that approaches bullet time combat in a whole new way. The game utilizes a unique set of mechanics that allow each player to control the speed of their opponent\u2019s projectiles. Bullet time mode can be activated at any time, but while active it restricts the player to room-scale movement only and removes their ability to reload. These mechanics create an unparalleled combat experience that seamlessly blends fast paced action with tense strategy. War Yards combines these innovative gameplay systems with incredibly detailed stylized maps to make for a truly unforgettable VR western adventure.\n\nFeatures:\n- Challenge your friends to intense and highly strategic 1v1 duels.\n- Utilize incredibly unique multiplayer bullet time mechanics to outsmart your opponent.\n- Explore 4 highly detailed stylized maps inspired by classic western settings.\n- Enjoy the freedom of playing with users across nearly all VR platforms.", "short_description": "Step into the shoes of a legendary gunslinger and experience a new kind of VR multiplayer combat. War Yards utilizes a set of unique gameplay systems to seamlessly bring bullet time mechanics to multiplayer matches."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.iubenda.com/privacy-policy/24673521/legal", "developer_terms_of_service_url": null, "publisher_name": "Pixel Framers LLC", "support_website_url": null, "website_url": "https://www.waryards.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "con
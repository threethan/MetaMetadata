-09-17_22-40-30.png", "id": "275494520588765", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39036704_275494523922098_2426874895962552879_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VFV6bkCh9NwQ7kNvwFEmdye&_nc_oc=Ado2B177SAWGlavX0uimMQRZrlyPLkMIhQULWvT0-CTGdemLhaMKJwsO8AnVFBD5CSI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzQLYJ6gZXknYVZMEgHuhEPCvCtu4UR0vE88bUINzO_AA&oe=69D10002"}, {"file_name": "screen_2560x1440_2020-09-17_22-46-29.png", "id": "238990151157199", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38984447_238990154490532_767541046175693257_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VA6e7zVng2wQ7kNvwGS4pue&_nc_oc=Adqq2UxqwRHn4oCGjLtdB2Vejy-KoIeTwz6P1MayLJKrMN17VprePDJTfMFc5a4T1yI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzTgl1mePHwwxpJafyaRQ16rIEjIVMRLeynX6DJZqTRVA&oe=69D0EDF0"}, {"file_name": "screen_2560x1440_2020-09-17_22-45-52.png", "id": "153148369974995", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974693_153148373308328_3846551554399346998_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VsPILi5nq98Q7kNvwH1d1DX&_nc_oc=Adrk8aLTh_PNyjInihWxO9NnuHPUIXMm48p0tTXdhBmr5lm-8GB4b06v_Xf7r36n2L4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxIq8jJZxUxAsChiQxgOO0FkR-LLR1zb62CfS4pcvvdiA&oe=69D0F4DD"}, {"file_name": "screen_2560x1440_2020-09-17_22-43-52.png", "id": "429953335104667", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974714_429953338438000_1630301928601733580_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iBVPrcJLmgUQ7kNvwGolgP0&_nc_oc=AdovEM-0jQdSB-58n2LlQzrOukQTMz_kjHnAv-hAoV-v3ynL8fYcbHZxxpm-2JimGKA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwaP67qNiJkHcfPvBSHc-Twr4hljq6Te1IXXMQon2xMIQ&oe=69D0F002"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screen_2560x1440_2020-09-17_22-47-51.png", "id": "230829075192600", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974887_230829078525933_560344683498926700_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MbLtu0Fr3AUQ7kNvwFrc9iF&_nc_oc=AdrF8COZ0VqhibNuF7mIUT611BWyY3GgPuHGScZdH2wOL0y-QuBSMKx5NpnVeHdm0jI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwXvDn0Nbscra9BJMCedgcoSyA2u0rP60RsNzYMPE5yMA&oe=69D1083F"}, "display_name": "War Yards Beta", "keywords": [], "long_description": "War Yards is a 1v1 multiplayer shooter that approaches bullet time combat in a whole new way. The game utilizes a unique set of mechanics that allow each player to control the speed of their opponent\u2019s projectiles. Bullet time mode can be activated at any time, but while active it restricts the player to room-scale movement only and removes their ability to reload. These mechanics create an unparalleled combat experience that seamlessly blends fast paced action with tense strategy. War Yards combines these innovative gameplay systems with incredibly detailed stylized maps to make for a truly unforgettable VR western adventure.\n\nFeatures:\n- Challenge your friends to intense and highly strategic 1v1 duels.\n- Utilize incredibly unique multiplayer bullet time mechanics to outsmart your opponent.\n- Explore 4 highly detailed stylized maps inspired by classic western settings.\n- Enjoy the freedom of playing with users across nearly all VR platforms.", "short_description": "Step into the shoes of a legendary gunslinger and experience a new kind of VR multiplayer combat. War Yards utilizes a set of unique gameplay systems to seamlessly bring bullet time mechanics to multiplayer matches."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.iubenda.com/privacy-policy/24673521/legal", "developer_terms_of_service_url": null, "publisher_name": "Pixel Framers LLC", "support_website_url": null, "website_url": "https://www.waryards.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "con
-09-17_22-40-30.png", "id": "275494520588765", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39036704_275494523922098_2426874895962552879_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WpLFxXqVgTAQ7kNvwEK3B-6&_nc_oc=AdqB-kSwTL3vgBQwyyfhCLOn2rLAx82n681LrztP6Tk6O4bjSDzYDvb48-ZlysYxRt8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEHL43evURowCQhel7GHgQgTT9vtMlkXQh1Roo2kvCv1g&oe=6A8C3502"}, {"file_name": "screen_2560x1440_2020-09-17_22-46-29.png", "id": "238990151157199", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38984447_238990154490532_767541046175693257_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bz2j0nwMw5wQ7kNvwGUcROH&_nc_oc=Adq205VweMxiZlXilnRO_O-j7Cnid7c17pWD7KVRlEE_I8De6ARBg92LbVVb9BdO8SE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQER5twOmkj6T6O09fawbUFYJzn2EgUeLYpnLyd1vm8zQA&oe=6A8C22F0"}, {"file_name": "screen_2560x1440_2020-09-17_22-45-52.png", "id": "153148369974995", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974693_153148373308328_3846551554399346998_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x_5sapJaVSkQ7kNvwGa2hSH&_nc_oc=Adql6xpA1ohrSWm7SI6WPlFaZOEfp8IdmjNFMn_TLBntMP8_BVrIVdYs49B2yVxjAUg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH35jLSxlAAoImAtKw6P09pw-8-5OYSX4hILUwpDUTz9g&oe=6A8C29DD"}, {"file_name": "screen_2560x1440_2020-09-17_22-43-52.png", "id": "429953335104667", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974714_429953338438000_1630301928601733580_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7i3aHqfQKl8Q7kNvwF0kWDw&_nc_oc=AdrIqfktxAXmqpp94N5xQhkctMZxsTHkmrOacjvl70YjEyxBL_RPP1YjutWUMnDzS00&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHFPnCEfjTnhEdAoC46ufeI_Nwan9HIrtMN2Yw9bxmCWw&oe=6A8C2502"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screen_2560x1440_2020-09-17_22-47-51.png", "id": "230829075192600", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974887_230829078525933_560344683498926700_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iZ2Ody7GYtUQ7kNvwHUHHkT&_nc_oc=AdqQnZ_quFZFKAs4Bfw2GAMlXg3h1_AIqXyqzyvHR71fw-F7C6ZyUhsee0v06g9FxFM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHWDOMSK_dd9Ec0_Mrt0n4sm6eNttslC96In0hII3U_yQ&oe=6A8C3D3F"}, "display_name": "War Yards Beta", "keywords": [], "long_description": "War Yards is a 1v1 multiplayer shooter that approaches bullet time combat in a whole new way. The game utilizes a unique set of mechanics that allow each player to control the speed of their opponent\u2019s projectiles. Bullet time mode can be activated at any time, but while active it restricts the player to room-scale movement only and removes their ability to reload. These mechanics create an unparalleled combat experience that seamlessly blends fast paced action with tense strategy. War Yards combines these innovative gameplay systems with incredibly detailed stylized maps to make for a truly unforgettable VR western adventure.\n\nFeatures:\n- Challenge your friends to intense and highly strategic 1v1 duels.\n- Utilize incredibly unique multiplayer bullet time mechanics to outsmart your opponent.\n- Explore 4 highly detailed stylized maps inspired by classic western settings.\n- Enjoy the freedom of playing with users across nearly all VR platforms.", "short_description": "Step into the shoes of a legendary gunslinger and experience a new kind of VR multiplayer combat. War Yards utilizes a set of unique gameplay systems to seamlessly bring bullet time mechanics to multiplayer matches."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.iubenda.com/privacy-policy/24673521/legal", "developer_terms_of_service_url": null, "publisher_name": "Pixel Framers LLC", "support_website_url": null, "website_url": "https://www.waryards.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "con
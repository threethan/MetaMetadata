-09-17_22-40-30.png", "id": "275494520588765", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39036704_275494523922098_2426874895962552879_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rYxYsK2crWIQ7kNvwEMhgEo&_nc_oc=AdqWcULdTm9Na4QxN4EoFuI23gFqkuAJESbBCJo1BuWOcBOKWg9uWNFSo51OgnXfTrQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_ozGsL6d1Fi9O0Dn4G95XWM4sIu6RfogMhfrr47qzhiw&oe=6A356A42"}, {"file_name": "screen_2560x1440_2020-09-17_22-46-29.png", "id": "238990151157199", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38984447_238990154490532_767541046175693257_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WYiHiLzTvD8Q7kNvwGlc0Xp&_nc_oc=Adq7km_PxHaWyidF7NQ8PjstNlwCKKbcWWrl0BtOZB6aPoPAOfPxtH6UEwzufVHTv7A&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8DmCpvvdZJa9NIDBcqnrt3ymN1May_V5aS_pTlE2Lyvg&oe=6A355830"}, {"file_name": "screen_2560x1440_2020-09-17_22-45-52.png", "id": "153148369974995", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974693_153148373308328_3846551554399346998_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aW_wN_QrckEQ7kNvwELdT39&_nc_oc=Adq4snc9liLWajms_8TPnV7Ej9k8Z9a9bPs1J_hJYw3RhOmchKOIBGcG02rQZa1TyxU&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8LSujuAxL2ik3GVhy5bC5kHEmHDnFyjtZanD-5RY_B6A&oe=6A355F1D"}, {"file_name": "screen_2560x1440_2020-09-17_22-43-52.png", "id": "429953335104667", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974714_429953338438000_1630301928601733580_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NHUq7ji6qfUQ7kNvwGEalah&_nc_oc=AdppPyj5nCulbGUayHy8rrRrWwZaqsf9eo8Wxq7QqWYm_zJqY5SCkpob6nR3eP5OQQ4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-9sFZ8XqB_CYDHLF1ZsilfTitZOlp860ycgnvCBZnGvA&oe=6A355A42"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screen_2560x1440_2020-09-17_22-47-51.png", "id": "230829075192600", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974887_230829078525933_560344683498926700_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9KpezsxlvzsQ7kNvwEeG-_a&_nc_oc=AdrHpPpAp7FkENop42oYbwgrEazBL64n1a_ArrB0GRKnZaSx4QlmPPlIgBCk_zzCvaM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-4Mib1x4rcTtJ6nlCHyNiUgx-NUzJB6ILEbr6NbKLm6g&oe=6A35727F"}, "display_name": "War Yards Beta", "keywords": [], "long_description": "War Yards is a 1v1 multiplayer shooter that approaches bullet time combat in a whole new way. The game utilizes a unique set of mechanics that allow each player to control the speed of their opponent\u2019s projectiles. Bullet time mode can be activated at any time, but while active it restricts the player to room-scale movement only and removes their ability to reload. These mechanics create an unparalleled combat experience that seamlessly blends fast paced action with tense strategy. War Yards combines these innovative gameplay systems with incredibly detailed stylized maps to make for a truly unforgettable VR western adventure.\n\nFeatures:\n- Challenge your friends to intense and highly strategic 1v1 duels.\n- Utilize incredibly unique multiplayer bullet time mechanics to outsmart your opponent.\n- Explore 4 highly detailed stylized maps inspired by classic western settings.\n- Enjoy the freedom of playing with users across nearly all VR platforms.", "short_description": "Step into the shoes of a legendary gunslinger and experience a new kind of VR multiplayer combat. War Yards utilizes a set of unique gameplay systems to seamlessly bring bullet time mechanics to multiplayer matches."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.iubenda.com/privacy-policy/24673521/legal", "developer_terms_of_service_url": null, "publisher_name": "Pixel Framers LLC", "support_website_url": null, "website_url": "https://www.waryards.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "con
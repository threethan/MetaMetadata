-09-17_22-40-30.png", "id": "275494520588765", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39036704_275494523922098_2426874895962552879_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lyQdvpxPpD0Q7kNvwGDLi7V&_nc_oc=Adr9hLpZVTN47hq1HjMi7px1lYJvnXu74UGq5ogrqwZ_4vAW43u4XpjdxWqNNZd-Amk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1juogiCIMlsSjteJ15OmUPL6GKbWIdwqgadWi1s6Iw1Q&oe=69DA3A82"}, {"file_name": "screen_2560x1440_2020-09-17_22-46-29.png", "id": "238990151157199", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38984447_238990154490532_767541046175693257_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YqP8YsqcJ90Q7kNvwG479Bg&_nc_oc=Adphbxa1nHVEZwufZqq1AJtd9gbLiVE-thBcXYEO7uNx_VRQrM-GWQ872DfvRtBW4gc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af01j64_b14anWQRhYp4072BW38JKyCyp-oVhX0hxADcjA&oe=69DA60B0"}, {"file_name": "screen_2560x1440_2020-09-17_22-45-52.png", "id": "153148369974995", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974693_153148373308328_3846551554399346998_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PvaJmOX31f0Q7kNvwEhe8Cn&_nc_oc=AdrJc7IePrWBD21O0RkX7U9BMiD5aEewv4WWbjYnm1pnNczvZHSb1W3o0D3kXqlW6O4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af05sQ_HmbAworHuVRnLxuM7KGdUB3wlGD8rQsQwMnoliw&oe=69DA2F5D"}, {"file_name": "screen_2560x1440_2020-09-17_22-43-52.png", "id": "429953335104667", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974714_429953338438000_1630301928601733580_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=t-1TRHxexw8Q7kNvwEiAiUr&_nc_oc=Adqy2gltaoVYsMbMMM8XMLOMftW8GvN6UUok4xv4MJf27UELq-NM1TLt6t54TwL-_kQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2KQliv8q3Qiw7eq9kF-k5Tl7rZID4q2g6j_MZA1gad6Q&oe=69DA2A82"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screen_2560x1440_2020-09-17_22-47-51.png", "id": "230829075192600", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974887_230829078525933_560344683498926700_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CO5ld2dmAc4Q7kNvwHSK--0&_nc_oc=Adqx_r2CNLDV-YeuewK-Fx6nAzQutEQrkaj2oEulkzpjA88TAhbkXPzXSW_5y_XjBoU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2cn5nQdugRu3k4HW59e_CUe9a4-nlUyy9HzLTB8nrRZA&oe=69DA42BF"}, "display_name": "War Yards Beta", "keywords": [], "long_description": "War Yards is a 1v1 multiplayer shooter that approaches bullet time combat in a whole new way. The game utilizes a unique set of mechanics that allow each player to control the speed of their opponent\u2019s projectiles. Bullet time mode can be activated at any time, but while active it restricts the player to room-scale movement only and removes their ability to reload. These mechanics create an unparalleled combat experience that seamlessly blends fast paced action with tense strategy. War Yards combines these innovative gameplay systems with incredibly detailed stylized maps to make for a truly unforgettable VR western adventure.\n\nFeatures:\n- Challenge your friends to intense and highly strategic 1v1 duels.\n- Utilize incredibly unique multiplayer bullet time mechanics to outsmart your opponent.\n- Explore 4 highly detailed stylized maps inspired by classic western settings.\n- Enjoy the freedom of playing with users across nearly all VR platforms.", "short_description": "Step into the shoes of a legendary gunslinger and experience a new kind of VR multiplayer combat. War Yards utilizes a set of unique gameplay systems to seamlessly bring bullet time mechanics to multiplayer matches."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.iubenda.com/privacy-policy/24673521/legal", "developer_terms_of_service_url": null, "publisher_name": "Pixel Framers LLC", "support_website_url": null, "website_url": "https://www.waryards.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "con
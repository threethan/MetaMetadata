-09-17_22-40-30.png", "id": "275494520588765", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39036704_275494523922098_2426874895962552879_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-AL7MuiEbakQ7kNvwFIPZgc&_nc_oc=AdoOYzUKjRho-OkzLTgXXC7JQor30tw6qIo5G5YYE4kgxE-RPZP0b4dpe4J_pXbyuFs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSRmLPP0qtUiLQ5ynfkVfrkGGEEh1eQLzrlv2MpxsvHcw&oe=6AF1F0C2"}, {"file_name": "screen_2560x1440_2020-09-17_22-46-29.png", "id": "238990151157199", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38984447_238990154490532_767541046175693257_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=djQ4FSSWRZ0Q7kNvwG9CdUO&_nc_oc=Adp0-zPsq5l3Gofs5GP_cLsbDI3iZS89Pgl1KwQJF0FbWGQs17Ik44W_oHEMEkMweOA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSKpXmOadGjkn_AVPw8JA8E6WctviEX0z2IvfA_TBwaNQ&oe=6AF1DEB0"}, {"file_name": "screen_2560x1440_2020-09-17_22-45-52.png", "id": "153148369974995", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974693_153148373308328_3846551554399346998_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2ledQiXfRz4Q7kNvwEMBoyo&_nc_oc=AdoF1aHxx2LkWwI_3GZdb3ZGsaKHA90sPeHGg4zdB0V0giaZHgeKuNXPu8AOJsBTKGs&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT7QR7uK8dx_LasQ8eLE5fnYVxOPEsjnKaXBGsqYuuKnw&oe=6AF1E59D"}, {"file_name": "screen_2560x1440_2020-09-17_22-43-52.png", "id": "429953335104667", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974714_429953338438000_1630301928601733580_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C6BsuHPNhqMQ7kNvwHiSJhE&_nc_oc=Adry7eT3uXz6udy6DxWvVL00pyV02wKPYhMb07U4OJL_DKjgzo2Xyxh228CxIdQnmT8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRWCEBBVZuqfqhQ3sSAPj1GBnVaVK14HzNEG1kWhnCuqg&oe=6AF1E0C2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screen_2560x1440_2020-09-17_22-47-51.png", "id": "230829075192600", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974887_230829078525933_560344683498926700_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BLez7wAp6i0Q7kNvwGLw2RQ&_nc_oc=AdpsN53_TjR_BkMqBYu4v1R5RDqjFb-i32HG9GRVKk72eF4scEDSSHcjGSAmmh1pNnE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRUU4bWLo8HqwDtBD2IhOPAatM_GdKI4wNHhlMKDVqGDg&oe=6AF1F8FF"}, "display_name": "War Yards Beta", "keywords": [], "long_description": "War Yards is a 1v1 multiplayer shooter that approaches bullet time combat in a whole new way. The game utilizes a unique set of mechanics that allow each player to control the speed of their opponent\u2019s projectiles. Bullet time mode can be activated at any time, but while active it restricts the player to room-scale movement only and removes their ability to reload. These mechanics create an unparalleled combat experience that seamlessly blends fast paced action with tense strategy. War Yards combines these innovative gameplay systems with incredibly detailed stylized maps to make for a truly unforgettable VR western adventure.\n\nFeatures:\n- Challenge your friends to intense and highly strategic 1v1 duels.\n- Utilize incredibly unique multiplayer bullet time mechanics to outsmart your opponent.\n- Explore 4 highly detailed stylized maps inspired by classic western settings.\n- Enjoy the freedom of playing with users across nearly all VR platforms.", "short_description": "Step into the shoes of a legendary gunslinger and experience a new kind of VR multiplayer combat. War Yards utilizes a set of unique gameplay systems to seamlessly bring bullet time mechanics to multiplayer matches."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.iubenda.com/privacy-policy/24673521/legal", "developer_terms_of_service_url": null, "publisher_name": "Pixel Framers LLC", "support_website_url": null, "website_url": "https://www.waryards.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "con
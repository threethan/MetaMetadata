-09-17_22-40-30.png", "id": "275494520588765", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39036704_275494523922098_2426874895962552879_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G_5UAUW0Mi0Q7kNvwH2POMl&_nc_oc=AdoDqB5cedTDp7JeOIlNC2Tyodt9DkqdX4vHK-w5Qpf-zVY2T4Djte7t9X3QHsoYZ-8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEHnaJ-YxVKZnVdU982Y6vwnCBAA6plyly5ZKQtriiG2Q&oe=6A844C02"}, {"file_name": "screen_2560x1440_2020-09-17_22-46-29.png", "id": "238990151157199", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38984447_238990154490532_767541046175693257_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=knLBzfihFJkQ7kNvwGZO5dT&_nc_oc=AdpoU-L-vtYNJP8OX-FiSQlzV8ZNCSAOS3F3d8HfUqoJG9FMofpJXcsMDwRxsUisy78&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEzcxHAfouMlyoL8IzklVR_xzHuyJcqkax5D72Ck8sJcA&oe=6A8439F0"}, {"file_name": "screen_2560x1440_2020-09-17_22-45-52.png", "id": "153148369974995", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974693_153148373308328_3846551554399346998_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xKn3tZp5vfcQ7kNvwFX0xMi&_nc_oc=AdpSQ44ozFT5qY876SKv7w9L9yBR_hQHEeLN1C8natVhCsIHM9lGirADhZ4J-RpjQR8&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHCi6Qe6XeJPKmjEqnlUP3_SHMg-RPfIVt5K5cltNqJvg&oe=6A8440DD"}, {"file_name": "screen_2560x1440_2020-09-17_22-43-52.png", "id": "429953335104667", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974714_429953338438000_1630301928601733580_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aqis_qXW-rEQ7kNvwFUU8Ye&_nc_oc=AdocdPaTb7dx7zhIb0L40AxCQ8WahjCHRKMIKWg_cHtMlytKgKep5LiJSPY17RqUz_A&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFnqLodVC-e1qiUVG6XUkU-SYxOgvSnbKbW5oNEGMeL4g&oe=6A843C02"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screen_2560x1440_2020-09-17_22-47-51.png", "id": "230829075192600", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974887_230829078525933_560344683498926700_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ma-bPVUaK3sQ7kNvwFE6Hpn&_nc_oc=AdqmO0H5goJ6XSLt0169pdf09G1tbZ9XjbdeQ1vajv-kL_pBpo9FW0ktAamiPfjAA70&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGLsdMCX8nUChlewJVe6ujB3ycYdlLlKAmZD3--qCwgng&oe=6A84543F"}, "display_name": "War Yards Beta", "keywords": [], "long_description": "War Yards is a 1v1 multiplayer shooter that approaches bullet time combat in a whole new way. The game utilizes a unique set of mechanics that allow each player to control the speed of their opponent\u2019s projectiles. Bullet time mode can be activated at any time, but while active it restricts the player to room-scale movement only and removes their ability to reload. These mechanics create an unparalleled combat experience that seamlessly blends fast paced action with tense strategy. War Yards combines these innovative gameplay systems with incredibly detailed stylized maps to make for a truly unforgettable VR western adventure.\n\nFeatures:\n- Challenge your friends to intense and highly strategic 1v1 duels.\n- Utilize incredibly unique multiplayer bullet time mechanics to outsmart your opponent.\n- Explore 4 highly detailed stylized maps inspired by classic western settings.\n- Enjoy the freedom of playing with users across nearly all VR platforms.", "short_description": "Step into the shoes of a legendary gunslinger and experience a new kind of VR multiplayer combat. War Yards utilizes a set of unique gameplay systems to seamlessly bring bullet time mechanics to multiplayer matches."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.iubenda.com/privacy-policy/24673521/legal", "developer_terms_of_service_url": null, "publisher_name": "Pixel Framers LLC", "support_website_url": null, "website_url": "https://www.waryards.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "con
-09-17_22-40-30.png", "id": "275494520588765", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39036704_275494523922098_2426874895962552879_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lOhVpr6tU_0Q7kNvwEos0uh&_nc_oc=AdrVvOKnz4G3rkyTwqfuaM0-smNMC1wXbzT0-r9Nu1NtwxBrBUGZpN-m0tf-EsHCIlU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIPy4_odssHB5uJNxoFsR-_jCQ8h0HMhtDHHvFnkWYSWw&oe=6A999C42"}, {"file_name": "screen_2560x1440_2020-09-17_22-46-29.png", "id": "238990151157199", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38984447_238990154490532_767541046175693257_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xDLWuVkRhSAQ7kNvwFtKeUt&_nc_oc=AdrPpkWgJNni2p9YBcmOIqRn1j_rvmI6ZVuAfX1XnDRxPZ2au0MOy6e-6WziunEzMm8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLk9kqwunaaXxtwWeLa46BUfexQOsk3yA72m-YV_n9sTw&oe=6A998A30"}, {"file_name": "screen_2560x1440_2020-09-17_22-45-52.png", "id": "153148369974995", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974693_153148373308328_3846551554399346998_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dsCjMyiVGlEQ7kNvwGqH9ou&_nc_oc=Adr8wFGLZCElAAsDdi4iyvV724xclp3k_zOYCGLiDJp6hUvWcjtk1W4MCbVcaxlp3ac&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLT-SfkAn5zETgR3jRCb0vx7MVjg6qZxF8Y1TlzO-ehUQ&oe=6A99911D"}, {"file_name": "screen_2560x1440_2020-09-17_22-43-52.png", "id": "429953335104667", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974714_429953338438000_1630301928601733580_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TULv04dtw1EQ7kNvwHVn1Jy&_nc_oc=AdpOedhZqdkyLRZb53o755dmuCSYIszbYDks-OMm8ozoCzRD65u9wNuhnSZQYM85C9Y&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLk2-hnMJsDbz1U_Fj3gf1qZQOMefIt86iu126HCH3jLw&oe=6A998C42"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screen_2560x1440_2020-09-17_22-47-51.png", "id": "230829075192600", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974887_230829078525933_560344683498926700_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mMLABUIkwvMQ7kNvwHRrWB3&_nc_oc=Adpv6Ddpp6y971_yVji8qi8q2THCCnPUwk2E8DFCoI7BGZouY8AZz1UO5SZysH3i3lM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLG1hNzJbDexk4edouoYX-AlwyiXvEn1FXko76q6IIVyA&oe=6A99A47F"}, "display_name": "War Yards Beta", "keywords": [], "long_description": "War Yards is a 1v1 multiplayer shooter that approaches bullet time combat in a whole new way. The game utilizes a unique set of mechanics that allow each player to control the speed of their opponent\u2019s projectiles. Bullet time mode can be activated at any time, but while active it restricts the player to room-scale movement only and removes their ability to reload. These mechanics create an unparalleled combat experience that seamlessly blends fast paced action with tense strategy. War Yards combines these innovative gameplay systems with incredibly detailed stylized maps to make for a truly unforgettable VR western adventure.\n\nFeatures:\n- Challenge your friends to intense and highly strategic 1v1 duels.\n- Utilize incredibly unique multiplayer bullet time mechanics to outsmart your opponent.\n- Explore 4 highly detailed stylized maps inspired by classic western settings.\n- Enjoy the freedom of playing with users across nearly all VR platforms.", "short_description": "Step into the shoes of a legendary gunslinger and experience a new kind of VR multiplayer combat. War Yards utilizes a set of unique gameplay systems to seamlessly bring bullet time mechanics to multiplayer matches."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.iubenda.com/privacy-policy/24673521/legal", "developer_terms_of_service_url": null, "publisher_name": "Pixel Framers LLC", "support_website_url": null, "website_url": "https://www.waryards.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "con
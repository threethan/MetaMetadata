-09-17_22-40-30.png", "id": "275494520588765", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39036704_275494523922098_2426874895962552879_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rUdKWya0OcEQ7kNvwEjPg3m&_nc_oc=AdoInYOCwvKqLW3VqxhnlncAV7oQSAH8snSxMuRZbzbgcw2PaoDRXFf2cYuW-QTIa-c&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKWpQZMU0XZz9v2pqIoT-n2WyR0KPhyGDzps5gR2uU5Sw&oe=6AA7E482"}, {"file_name": "screen_2560x1440_2020-09-17_22-46-29.png", "id": "238990151157199", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38984447_238990154490532_767541046175693257_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8WTOuxb7Y3cQ7kNvwFdcB5w&_nc_oc=AdrC_dBWC7gWM7MiBuPfoqG5d0S467s2aJs9n7cXWNZjJ9AGXByYJ7-9ji1l1l0jJHg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK3KVnRYC8PxuwXoK7MPbCesYEh9RCC1wnUFpJQz2uxqQ&oe=6AA80AB0"}, {"file_name": "screen_2560x1440_2020-09-17_22-45-52.png", "id": "153148369974995", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974693_153148373308328_3846551554399346998_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nA8mIXf9HykQ7kNvwG6GnGP&_nc_oc=Adr3DJ8IPlqKjq7ac1ocFBNATEtWclrYXbsLYY8AN1Hm8JD51mn1qv2XHAogq6lQIxw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLPbWezs_IyGXz_gFOKPs14K9H_vH8opEuNf_QcTffqFw&oe=6AA8119D"}, {"file_name": "screen_2560x1440_2020-09-17_22-43-52.png", "id": "429953335104667", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974714_429953338438000_1630301928601733580_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=28vgscmSgkcQ7kNvwGKH1h4&_nc_oc=AdooJn_-uo1jkS0BuGzmLbu2R9S20UXrhPrJRCHGrzyvUPKIalxQj3JRuGLhbjW-D1k&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJEg6jmjobc8LgBXLS7KDV4XrYM6sxpahPhOHmtcWNSxg&oe=6AA80CC2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screen_2560x1440_2020-09-17_22-47-51.png", "id": "230829075192600", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974887_230829078525933_560344683498926700_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0oItObVTZ0gQ7kNvwFkG0E3&_nc_oc=AdoOd7WLSTu4mSutw5ZnNAsBElBE1f6lhAN7JoPgiXsvYypc3foOBkh1AnggeXngHNo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIVPC3pOm8J6RVuQhHYoqKFGBekC0P5uufHD0qIzDv6Fg&oe=6AA7ECBF"}, "display_name": "War Yards Beta", "keywords": [], "long_description": "War Yards is a 1v1 multiplayer shooter that approaches bullet time combat in a whole new way. The game utilizes a unique set of mechanics that allow each player to control the speed of their opponent\u2019s projectiles. Bullet time mode can be activated at any time, but while active it restricts the player to room-scale movement only and removes their ability to reload. These mechanics create an unparalleled combat experience that seamlessly blends fast paced action with tense strategy. War Yards combines these innovative gameplay systems with incredibly detailed stylized maps to make for a truly unforgettable VR western adventure.\n\nFeatures:\n- Challenge your friends to intense and highly strategic 1v1 duels.\n- Utilize incredibly unique multiplayer bullet time mechanics to outsmart your opponent.\n- Explore 4 highly detailed stylized maps inspired by classic western settings.\n- Enjoy the freedom of playing with users across nearly all VR platforms.", "short_description": "Step into the shoes of a legendary gunslinger and experience a new kind of VR multiplayer combat. War Yards utilizes a set of unique gameplay systems to seamlessly bring bullet time mechanics to multiplayer matches."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.iubenda.com/privacy-policy/24673521/legal", "developer_terms_of_service_url": null, "publisher_name": "Pixel Framers LLC", "support_website_url": null, "website_url": "https://www.waryards.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "con
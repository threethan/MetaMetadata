-09-17_22-40-30.png", "id": "275494520588765", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39036704_275494523922098_2426874895962552879_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gLTy9TK0nQgQ7kNvwG9VTsi&_nc_oc=AdqQcckIwzaPnBwYzC2wA3Vdh6z_BvL-V7WKgpAwmpJjA7aWitwVnA2wFje7TwDAwsg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQZM8EDB6ESRI7f0lTEIwQtF2gj_BomrP2sFusbmGqHUw&oe=6AF88842"}, {"file_name": "screen_2560x1440_2020-09-17_22-46-29.png", "id": "238990151157199", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38984447_238990154490532_767541046175693257_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wqUrTGZuPVIQ7kNvwG_3SVR&_nc_oc=Adp6hU1rw2iUNf5iL9UC-r00YdMdVgLLGybH4UuvRTSPKEayuGLzet0mLCLn50LJVW8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRfiKw6r0bC-t1Ro5jqHPq_p4zZynwxPwxa2Oh9kEM5Bw&oe=6AF87630"}, {"file_name": "screen_2560x1440_2020-09-17_22-45-52.png", "id": "153148369974995", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974693_153148373308328_3846551554399346998_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MnYeANuRWSEQ7kNvwENm6V7&_nc_oc=AdqJfNdabjtwgOUiEbmT61q58QP5pCMmjmyxKwP05Ov8riAno5uLHGIkfW63LGirCgg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTxqOkCBo2N9QdL17O4l064iGYv_8T5bYTg39ZncnMVhg&oe=6AF87D1D"}, {"file_name": "screen_2560x1440_2020-09-17_22-43-52.png", "id": "429953335104667", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974714_429953338438000_1630301928601733580_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7M3YE0ud3pYQ7kNvwEy_kBb&_nc_oc=AdpzyVj8A-yjHpsXXMhJiX8qn2huYV67_DSayXGeXfHyoBS-rpydkRSoChEcQoUW5-0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTzIFQGgZKdQx2nHlEfDihKDXY4Zn08f4XjDnLNCt0rHQ&oe=6AF87842"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screen_2560x1440_2020-09-17_22-47-51.png", "id": "230829075192600", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974887_230829078525933_560344683498926700_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jpdiRJN2vE4Q7kNvwGTHDb8&_nc_oc=AdryBjsCJgN7tPpWGBbJFzMLL4JP6Uf_yeJooULst4xyJyzRZ38AAnn9l6eIk5cGgwo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT2HK2FV0JoAiidd62vfZOLrDColPfnerfdaefmSrd0Lw&oe=6AF8907F"}, "display_name": "War Yards Beta", "keywords": [], "long_description": "War Yards is a 1v1 multiplayer shooter that approaches bullet time combat in a whole new way. The game utilizes a unique set of mechanics that allow each player to control the speed of their opponent\u2019s projectiles. Bullet time mode can be activated at any time, but while active it restricts the player to room-scale movement only and removes their ability to reload. These mechanics create an unparalleled combat experience that seamlessly blends fast paced action with tense strategy. War Yards combines these innovative gameplay systems with incredibly detailed stylized maps to make for a truly unforgettable VR western adventure.\n\nFeatures:\n- Challenge your friends to intense and highly strategic 1v1 duels.\n- Utilize incredibly unique multiplayer bullet time mechanics to outsmart your opponent.\n- Explore 4 highly detailed stylized maps inspired by classic western settings.\n- Enjoy the freedom of playing with users across nearly all VR platforms.", "short_description": "Step into the shoes of a legendary gunslinger and experience a new kind of VR multiplayer combat. War Yards utilizes a set of unique gameplay systems to seamlessly bring bullet time mechanics to multiplayer matches."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.iubenda.com/privacy-policy/24673521/legal", "developer_terms_of_service_url": null, "publisher_name": "Pixel Framers LLC", "support_website_url": null, "website_url": "https://www.waryards.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "con
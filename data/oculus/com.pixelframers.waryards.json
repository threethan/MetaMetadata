-09-17_22-40-30.png", "id": "275494520588765", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/39036704_275494523922098_2426874895962552879_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GQmRPRpt6CgQ7kNvwGeR5jI&_nc_oc=Adqd7Zs1nwkuJT8OxpXjZgZMoYNivMu_C6K7YOrBCoWzvBH_qj_hEgnjK0QXHzE8TLU&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3jclsydeyD2BYw9XWz86YnNczUdkVotGjlZDwSf-f0Aw&oe=69F49882"}, {"file_name": "screen_2560x1440_2020-09-17_22-46-29.png", "id": "238990151157199", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38984447_238990154490532_767541046175693257_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1Fcg7APm4DYQ7kNvwG4wSby&_nc_oc=AdpyRzAC9bgtcBPcTXCpu8AxsBf4trRLHxO-gyL4L4fMsgodsZ2LOu_WcQ8EPNFep_Q&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af26IV9Qw3fWlCg741FKjEpE1nonlPn8XUNlwHk66VM8Zw&oe=69F4BEB0"}, {"file_name": "screen_2560x1440_2020-09-17_22-45-52.png", "id": "153148369974995", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974693_153148373308328_3846551554399346998_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1Wf4BNT3OS8Q7kNvwH05MaV&_nc_oc=Ado5Wj8PgYyMZQOMiLukCRQHRIwvKm7qLwOvhT9Ciken_La4WQXBShrLOPeVylGeAtg&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1785WczxTqe8hnwpbSCWVDLp0NtLwanB-DeNeptV0k6A&oe=69F4C59D"}, {"file_name": "screen_2560x1440_2020-09-17_22-43-52.png", "id": "429953335104667", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974714_429953338438000_1630301928601733580_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q1l6cmKZvFgQ7kNvwFRHJUT&_nc_oc=Adqnr1oC4oXXnxYyMUQY0i6YX4zC5owmvDYE_Zc1vHm5uVEhXLHDSInKk8n83Nvpq68&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af07snrXzGMbjFFGwSvjB0XOWvhV6MyPW6Nlo_y15dir8A&oe=69F4C0C2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screen_2560x1440_2020-09-17_22-47-51.png", "id": "230829075192600", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974887_230829078525933_560344683498926700_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=px_OLzkTtEcQ7kNvwH-K_sa&_nc_oc=Adrf_rpKppyFsr4pjS-CLz3MfSWCwffA7v-d_czas7-yARQvFplGrif5eMEY2MDt_D4&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3GAKtBBKbSa2kUlRiJF7D-ljtVyE5cRCEg9lXd5uGrlQ&oe=69F4A0BF"}, "display_name": "War Yards Beta", "keywords": [], "long_description": "War Yards is a 1v1 multiplayer shooter that approaches bullet time combat in a whole new way. The game utilizes a unique set of mechanics that allow each player to control the speed of their opponent\u2019s projectiles. Bullet time mode can be activated at any time, but while active it restricts the player to room-scale movement only and removes their ability to reload. These mechanics create an unparalleled combat experience that seamlessly blends fast paced action with tense strategy. War Yards combines these innovative gameplay systems with incredibly detailed stylized maps to make for a truly unforgettable VR western adventure.\n\nFeatures:\n- Challenge your friends to intense and highly strategic 1v1 duels.\n- Utilize incredibly unique multiplayer bullet time mechanics to outsmart your opponent.\n- Explore 4 highly detailed stylized maps inspired by classic western settings.\n- Enjoy the freedom of playing with users across nearly all VR platforms.", "short_description": "Step into the shoes of a legendary gunslinger and experience a new kind of VR multiplayer combat. War Yards utilizes a set of unique gameplay systems to seamlessly bring bullet time mechanics to multiplayer matches."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.iubenda.com/privacy-policy/24673521/legal", "developer_terms_of_service_url": null, "publisher_name": "Pixel Framers LLC", "support_website_url": null, "website_url": "https://www.waryards.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "con
-09-17_22-40-30.png", "id": "275494520588765", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39036704_275494523922098_2426874895962552879_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PqaihdYLET0Q7kNvwE7HkuT&_nc_oc=AdqQKyN61pG1MIOusAn-rJxIR0V_6GUpgkRt9OewND45S7ortyDKFO9aiSZRUUeS-ec&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEtQP9BNYkN7L68_si_ah1I8Suewj_zGFL_H4lufBcYeA&oe=6A75CB82"}, {"file_name": "screen_2560x1440_2020-09-17_22-46-29.png", "id": "238990151157199", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38984447_238990154490532_767541046175693257_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hWLgOQnV0_gQ7kNvwFKlMRN&_nc_oc=Adr60ldlNlmWvD9XVYdcxhneElSc76QbrC826G98Xap48d2yewo-eC52rpziQ1u_aDA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGS2uwre6OlqA3CTtdXDxqMhFzTMNslT805tz2d8GTvqA&oe=6A75F1B0"}, {"file_name": "screen_2560x1440_2020-09-17_22-45-52.png", "id": "153148369974995", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974693_153148373308328_3846551554399346998_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-yp8G5XcEa4Q7kNvwGvopp7&_nc_oc=AdpaXV4QsxIwuhLqHBe4GDuEI7OltZwP9HoAh5BtusqtkLzbuiEmdU2FXcppB1eJjEE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHiNsSalv22Vw9CnByx4WOzdMtN8pQ7bYCSlfSD701-Aw&oe=6A75F89D"}, {"file_name": "screen_2560x1440_2020-09-17_22-43-52.png", "id": "429953335104667", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974714_429953338438000_1630301928601733580_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-4CA07Ox9jwQ7kNvwFjxB38&_nc_oc=Adq-6Ey1LNLpIeSvKpUadfSUT-SEBGimGypHsjGQPDI7fWAX1z4T12wk67O7b1UyT1Q&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF_LfbojClqpVlf-BCzPumdSwUcI74aNyIad0xKzdnqrQ&oe=6A75F3C2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screen_2560x1440_2020-09-17_22-47-51.png", "id": "230829075192600", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974887_230829078525933_560344683498926700_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Q6T3b0hegR0Q7kNvwG4--2O&_nc_oc=Adon8E-Qb3K8T7zWbLhNJuA6L47pqOCptziww5CLwGewfscj4P5KqQwzF2vAvKlsRls&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH_oLTyEDu-qUmjaEipL63tFKwOqQLguO8R_wtuthstag&oe=6A75D3BF"}, "display_name": "War Yards Beta", "keywords": [], "long_description": "War Yards is a 1v1 multiplayer shooter that approaches bullet time combat in a whole new way. The game utilizes a unique set of mechanics that allow each player to control the speed of their opponent\u2019s projectiles. Bullet time mode can be activated at any time, but while active it restricts the player to room-scale movement only and removes their ability to reload. These mechanics create an unparalleled combat experience that seamlessly blends fast paced action with tense strategy. War Yards combines these innovative gameplay systems with incredibly detailed stylized maps to make for a truly unforgettable VR western adventure.\n\nFeatures:\n- Challenge your friends to intense and highly strategic 1v1 duels.\n- Utilize incredibly unique multiplayer bullet time mechanics to outsmart your opponent.\n- Explore 4 highly detailed stylized maps inspired by classic western settings.\n- Enjoy the freedom of playing with users across nearly all VR platforms.", "short_description": "Step into the shoes of a legendary gunslinger and experience a new kind of VR multiplayer combat. War Yards utilizes a set of unique gameplay systems to seamlessly bring bullet time mechanics to multiplayer matches."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.iubenda.com/privacy-policy/24673521/legal", "developer_terms_of_service_url": null, "publisher_name": "Pixel Framers LLC", "support_website_url": null, "website_url": "https://www.waryards.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "con
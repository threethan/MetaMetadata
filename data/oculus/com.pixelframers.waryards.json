-09-17_22-40-30.png", "id": "275494520588765", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39036704_275494523922098_2426874895962552879_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Eer3Xijo05QQ7kNvwGewaXP&_nc_oc=AdpY_-RLSyxUSmRe6gJJseZjWIbfW4mU7GOcA8xQ-KF8NMVghjKPLZc79CIcQcmfZdc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJkYGNOqjk-LDmONLcqx06nx-N7bTxfjl8vADu6i3MTHQ&oe=6ABE8642"}, {"file_name": "screen_2560x1440_2020-09-17_22-46-29.png", "id": "238990151157199", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38984447_238990154490532_767541046175693257_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z6adBY34WM8Q7kNvwEmwg1m&_nc_oc=AdpWzhpHPbB8it85E2x0iQ3n9_HFYBs7cr24-bVn9HYmyanT_S9uvLND7sqgMfjk930&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKQ41DHUgNCfQlJawO7bjYLNmdbozhuh1QP4kVTiRpNMw&oe=6ABE7430"}, {"file_name": "screen_2560x1440_2020-09-17_22-45-52.png", "id": "153148369974995", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974693_153148373308328_3846551554399346998_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Fs4rwtCk5agQ7kNvwE9Ccv1&_nc_oc=AdqUy0BZ4ptLFJPDo4SSr8beIEE12jDctqmsOrD6Q-smApEiPOF51vNBeFOm99w5UFg&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI56fCQprhlmgw6O8OsOcAR32J4vDvZKLu6IqKOH3-Hjg&oe=6ABE7B1D"}, {"file_name": "screen_2560x1440_2020-09-17_22-43-52.png", "id": "429953335104667", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974714_429953338438000_1630301928601733580_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=p0l6wYjiej8Q7kNvwGiqOi3&_nc_oc=AdqUj_ScM8ZRxkGZvaHA7KVI5k5wdfmhKhT8FQtFSVL9gD-xkZ73pi4nJ5f26ubq02Y&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJzCpIAeCu-O8zZQNpBgzsY2-ybLsRR_JCeO_wOHCazcQ&oe=6ABE7642"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screen_2560x1440_2020-09-17_22-47-51.png", "id": "230829075192600", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974887_230829078525933_560344683498926700_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NNQkq1EfSxUQ7kNvwEOy5vr&_nc_oc=AdqlmS7iVXjvZmBSXzfgHWjGWQ05swFAhgLYJy_YKyy68JD2UriHanHNzrgbbX4mVxI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK0XlH1wunVkTuAedgz4zKbrZttD7K8WUtEfWV4gqNbyQ&oe=6ABE563F"}, "display_name": "War Yards Beta", "keywords": [], "long_description": "War Yards is a 1v1 multiplayer shooter that approaches bullet time combat in a whole new way. The game utilizes a unique set of mechanics that allow each player to control the speed of their opponent\u2019s projectiles. Bullet time mode can be activated at any time, but while active it restricts the player to room-scale movement only and removes their ability to reload. These mechanics create an unparalleled combat experience that seamlessly blends fast paced action with tense strategy. War Yards combines these innovative gameplay systems with incredibly detailed stylized maps to make for a truly unforgettable VR western adventure.\n\nFeatures:\n- Challenge your friends to intense and highly strategic 1v1 duels.\n- Utilize incredibly unique multiplayer bullet time mechanics to outsmart your opponent.\n- Explore 4 highly detailed stylized maps inspired by classic western settings.\n- Enjoy the freedom of playing with users across nearly all VR platforms.", "short_description": "Step into the shoes of a legendary gunslinger and experience a new kind of VR multiplayer combat. War Yards utilizes a set of unique gameplay systems to seamlessly bring bullet time mechanics to multiplayer matches."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.iubenda.com/privacy-policy/24673521/legal", "developer_terms_of_service_url": null, "publisher_name": "Pixel Framers LLC", "support_website_url": null, "website_url": "https://www.waryards.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "con
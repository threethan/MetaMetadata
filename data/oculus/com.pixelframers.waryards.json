-09-17_22-40-30.png", "id": "275494520588765", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39036704_275494523922098_2426874895962552879_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lzYLN-kVSzkQ7kNvwFzloah&_nc_oc=Adof94f4yJ5TgilK0CH6psph2YZll4-XTY6sWxMM7HzR8AnZsmAg2l8LwdiGXuHC6TA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM7DYfltlLLcvCMH3fU3YFqR9hrU-d2sNiOSXLa7Dfhlw&oe=6AE4C1C2"}, {"file_name": "screen_2560x1440_2020-09-17_22-46-29.png", "id": "238990151157199", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38984447_238990154490532_767541046175693257_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6x4AeazYvxwQ7kNvwHsXIB3&_nc_oc=Adqlq6EIvQPkHNb-7RBwd9ajGsFaWEFutvwds0z2yxxkYJqMZXurI0zeAOgR029LLks&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOMaP-2w2M5aY6Rans_7RvtWBsUceDiSTUiIaS6DVNu_w&oe=6AE4AFB0"}, {"file_name": "screen_2560x1440_2020-09-17_22-45-52.png", "id": "153148369974995", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974693_153148373308328_3846551554399346998_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0GlnFB2JR90Q7kNvwFSU6Hg&_nc_oc=AdqyeWBJTXUuRU_b3zou_WZZ5zNPTLk7f98inz49YOkvJEaAL7KsfpawzxIundrckN0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM3e6tuTldfeVUZs01vDTl62O-greEtNgpyPdpOAafXMw&oe=6AE4B69D"}, {"file_name": "screen_2560x1440_2020-09-17_22-43-52.png", "id": "429953335104667", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974714_429953338438000_1630301928601733580_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o5lyFeVLzrYQ7kNvwH0saBR&_nc_oc=AdpYFCMhYEjUr209dhVR35DjmYz97012bMGYx5QtYAlMbFENZroNymxOaAnuwZ8wjUc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMC_1es82Jq1LiwKCqN-EKMpV-oTd8z--1a6wnLLE0d9A&oe=6AE4B1C2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screen_2560x1440_2020-09-17_22-47-51.png", "id": "230829075192600", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974887_230829078525933_560344683498926700_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ect9SnYAJ5UQ7kNvwFVpLGy&_nc_oc=AdpDCtShCZ5aL4c9w-uHJaR5kClf_8FAKDBVKNhMh2E16J-K1vlpHbNDdcqExAy6Hko&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNwSu8tebFfbvpuMWHEg1ZJ3x6KmHtZFtQdoxsqB6_NEA&oe=6AE491BF"}, "display_name": "War Yards Beta", "keywords": [], "long_description": "War Yards is a 1v1 multiplayer shooter that approaches bullet time combat in a whole new way. The game utilizes a unique set of mechanics that allow each player to control the speed of their opponent\u2019s projectiles. Bullet time mode can be activated at any time, but while active it restricts the player to room-scale movement only and removes their ability to reload. These mechanics create an unparalleled combat experience that seamlessly blends fast paced action with tense strategy. War Yards combines these innovative gameplay systems with incredibly detailed stylized maps to make for a truly unforgettable VR western adventure.\n\nFeatures:\n- Challenge your friends to intense and highly strategic 1v1 duels.\n- Utilize incredibly unique multiplayer bullet time mechanics to outsmart your opponent.\n- Explore 4 highly detailed stylized maps inspired by classic western settings.\n- Enjoy the freedom of playing with users across nearly all VR platforms.", "short_description": "Step into the shoes of a legendary gunslinger and experience a new kind of VR multiplayer combat. War Yards utilizes a set of unique gameplay systems to seamlessly bring bullet time mechanics to multiplayer matches."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.iubenda.com/privacy-policy/24673521/legal", "developer_terms_of_service_url": null, "publisher_name": "Pixel Framers LLC", "support_website_url": null, "website_url": "https://www.waryards.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "con
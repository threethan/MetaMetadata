-09-17_22-40-30.png", "id": "275494520588765", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39036704_275494523922098_2426874895962552879_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-AL7MuiEbakQ7kNvwEDXi5Z&_nc_oc=Adoe511CaK37FEYLp9Ln-mnFFW9X7ElYmoFxb3tASye0juc64zI5T3DP7vhoo5VjcbI&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQAiJgbEDfm0P5zy_UAWTG1D4vivT3hjPRf23lvxclLcw&oe=6AF34242"}, {"file_name": "screen_2560x1440_2020-09-17_22-46-29.png", "id": "238990151157199", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38984447_238990154490532_767541046175693257_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=djQ4FSSWRZ0Q7kNvwE24DyI&_nc_oc=AdotW2Qt935AAaKCe2ETA6Gfc3elZYTA_56PsDucurlpVaUzJoxmROO6MkVYar9NVQI&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTBo1rggo56IsV1IjQrf7HvnCI_I3DHt6HDxrv2gs7Sag&oe=6AF33030"}, {"file_name": "screen_2560x1440_2020-09-17_22-45-52.png", "id": "153148369974995", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974693_153148373308328_3846551554399346998_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2ledQiXfRz4Q7kNvwE-M0KC&_nc_oc=AdoSBaJt8aqYOOMyDH4-IIHECYajtq6ZjghcI4EJ5fqcYfbBHeGNTEffXm5rQrqDp7s&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR8Tyd0nZETlabwUQiip_7paTeAagQ8iw_xoqz6E_Z-uQ&oe=6AF3371D"}, {"file_name": "screen_2560x1440_2020-09-17_22-43-52.png", "id": "429953335104667", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974714_429953338438000_1630301928601733580_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C6BsuHPNhqMQ7kNvwFqOE0k&_nc_oc=AdofA-Bj_ESWlFhIOZtfPl80nr2OhyyznUnV7mnXXJvGR_9V_xUj5PWMe1Vem2cG8r4&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSOv7aAgnPJtwNFAkiHkl9odUr2GotOY5rjkc91lNqt6A&oe=6AF33242"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screen_2560x1440_2020-09-17_22-47-51.png", "id": "230829075192600", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974887_230829078525933_560344683498926700_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BLez7wAp6i0Q7kNvwHOOS80&_nc_oc=Adq12X0xVJhZ8F_XY_FnT80t16PzF2x29_6ETX_bcXaeZ2wWarJdY7pRritnlr6OIU0&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQREoxQvIFa-ANJWPEgpnXpZV6D4hlwoggpKtP2bwLPCTg&oe=6AF34A7F"}, "display_name": "War Yards Beta", "keywords": [], "long_description": "War Yards is a 1v1 multiplayer shooter that approaches bullet time combat in a whole new way. The game utilizes a unique set of mechanics that allow each player to control the speed of their opponent\u2019s projectiles. Bullet time mode can be activated at any time, but while active it restricts the player to room-scale movement only and removes their ability to reload. These mechanics create an unparalleled combat experience that seamlessly blends fast paced action with tense strategy. War Yards combines these innovative gameplay systems with incredibly detailed stylized maps to make for a truly unforgettable VR western adventure.\n\nFeatures:\n- Challenge your friends to intense and highly strategic 1v1 duels.\n- Utilize incredibly unique multiplayer bullet time mechanics to outsmart your opponent.\n- Explore 4 highly detailed stylized maps inspired by classic western settings.\n- Enjoy the freedom of playing with users across nearly all VR platforms.", "short_description": "Step into the shoes of a legendary gunslinger and experience a new kind of VR multiplayer combat. War Yards utilizes a set of unique gameplay systems to seamlessly bring bullet time mechanics to multiplayer matches."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.iubenda.com/privacy-policy/24673521/legal", "developer_terms_of_service_url": null, "publisher_name": "Pixel Framers LLC", "support_website_url": null, "website_url": "https://www.waryards.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "con
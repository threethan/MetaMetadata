-09-17_22-40-30.png", "id": "275494520588765", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39036704_275494523922098_2426874895962552879_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rUdKWya0OcEQ7kNvwH1KdHj&_nc_oc=AdrQXKbJ16VUtZiFySS46_FlPCTcu_7ZB-Tj6kwS1JDtSuiVJ89JrosGuC8f3vqArvo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJgmPZ8j0-KmbCF6cYbyWZVhS7pl8m1kVNOaKZDOJXG4A&oe=6AA69302"}, {"file_name": "screen_2560x1440_2020-09-17_22-46-29.png", "id": "238990151157199", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38984447_238990154490532_767541046175693257_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8WTOuxb7Y3cQ7kNvwGnewc1&_nc_oc=AdrpN2QaiRbOkfjyZ35UEsGDGr9-iNXavn-1-QoN1aTJYDy6Dx5fn1mom7aYNbb1a-8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLYVLDjMQ3gQtvvnRw5izE9ENcsCahDVb4BOTbtufcOZw&oe=6AA6B930"}, {"file_name": "screen_2560x1440_2020-09-17_22-45-52.png", "id": "153148369974995", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974693_153148373308328_3846551554399346998_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nA8mIXf9HykQ7kNvwFEYiXk&_nc_oc=Adoj2Z3SmFTjpNdxKtBj94CYHMvYevYw4L7imvvTNcGWi2moXK8_aKiIJNPZaDlqMa0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKFBcm32NY-todC-Sg01IywmiqlD1C4GXGu7aXsFLF6yQ&oe=6AA6C01D"}, {"file_name": "screen_2560x1440_2020-09-17_22-43-52.png", "id": "429953335104667", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974714_429953338438000_1630301928601733580_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=28vgscmSgkcQ7kNvwFD8Wdk&_nc_oc=Adr76i5qndNX3ZJEk-hXyg5RPR-cMYy5VEwb_ALvM6WrTubQm9KEpOL54le6ymSkbu4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIfFAkosfk0g8TiQLqlh8GOIBo_ud0nMGGNH-hL8c96tA&oe=6AA6BB42"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screen_2560x1440_2020-09-17_22-47-51.png", "id": "230829075192600", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974887_230829078525933_560344683498926700_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0oItObVTZ0gQ7kNvwFwpqfb&_nc_oc=Ados34QD0oMsy5QAHTY7XU4V_257SvJqR8FUb3Mws3UdVavq1j3GCr7N5SkqyXnTeFo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJQ8Wc2kgxuNKPgxrCxpahY05hhCvWTKUnmt_LfymgAbA&oe=6AA69B3F"}, "display_name": "War Yards Beta", "keywords": [], "long_description": "War Yards is a 1v1 multiplayer shooter that approaches bullet time combat in a whole new way. The game utilizes a unique set of mechanics that allow each player to control the speed of their opponent\u2019s projectiles. Bullet time mode can be activated at any time, but while active it restricts the player to room-scale movement only and removes their ability to reload. These mechanics create an unparalleled combat experience that seamlessly blends fast paced action with tense strategy. War Yards combines these innovative gameplay systems with incredibly detailed stylized maps to make for a truly unforgettable VR western adventure.\n\nFeatures:\n- Challenge your friends to intense and highly strategic 1v1 duels.\n- Utilize incredibly unique multiplayer bullet time mechanics to outsmart your opponent.\n- Explore 4 highly detailed stylized maps inspired by classic western settings.\n- Enjoy the freedom of playing with users across nearly all VR platforms.", "short_description": "Step into the shoes of a legendary gunslinger and experience a new kind of VR multiplayer combat. War Yards utilizes a set of unique gameplay systems to seamlessly bring bullet time mechanics to multiplayer matches."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.iubenda.com/privacy-policy/24673521/legal", "developer_terms_of_service_url": null, "publisher_name": "Pixel Framers LLC", "support_website_url": null, "website_url": "https://www.waryards.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "con
-09-17_22-40-30.png", "id": "275494520588765", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39036704_275494523922098_2426874895962552879_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cKUzsorFyeUQ7kNvwHA3KCq&_nc_oc=AdoOo0SAUNP8ju9J1qlt1O85ShVBKuLq7p-kXz8xigkStfaejjkwvKkImnkFIXT5SUQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0B-kUGeTptvxPNbCq2qzy6-n2DEVdKeBjN1PBVQ7BCsA&oe=69D64602"}, {"file_name": "screen_2560x1440_2020-09-17_22-46-29.png", "id": "238990151157199", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38984447_238990154490532_767541046175693257_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QvFbZy7uEE0Q7kNvwGqwoGA&_nc_oc=AdoFBxWNeq8F-JW3ThAdZ57hEKWYmFrYdf7Bd3LgY03Km6GjGKPNIydI1iqd8B3hUeE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af066cviBaVB9yZeFNKnWj9WY9ajI2jvl7zfxLq5wfIfXg&oe=69D633F0"}, {"file_name": "screen_2560x1440_2020-09-17_22-45-52.png", "id": "153148369974995", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974693_153148373308328_3846551554399346998_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6bCsbHG8ZYMQ7kNvwEkc_Ob&_nc_oc=AdoxYsOMg8V_oy6t8zjd8NazlvJFgIqVxKAPCSEJtaJnnUYUq7XPE4CUdTXdBCh6wz4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1rSCHwMlnEVEnU-jvA-7h8SF_w191RCrfx3zmvU9XXCg&oe=69D63ADD"}, {"file_name": "screen_2560x1440_2020-09-17_22-43-52.png", "id": "429953335104667", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974714_429953338438000_1630301928601733580_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2AJ79oV6WzQQ7kNvwEN05ab&_nc_oc=AdojQwuaxGvfhabCv5sN4Eo1GzXJk0IFDkO351JAMj4cCrV4061VHzpzFkmhFk2dfTs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1wPLl_S-ZKONwf9vr6JknNQVyB1UeftIGFn3fnOu3n_Q&oe=69D63602"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screen_2560x1440_2020-09-17_22-47-51.png", "id": "230829075192600", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974887_230829078525933_560344683498926700_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j8qNPJEwQ4YQ7kNvwF8YYkR&_nc_oc=AdrOr7yAst4x0ONqt8FOKkMCh1XFPnFhts5V3IwgcCZEqGD-urYIrVL2CHiHtSSmYqU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af217PrpbWI1I8WegUVj8ymu70sjw_7W4zzw_ukkdFCYxg&oe=69D64E3F"}, "display_name": "War Yards Beta", "keywords": [], "long_description": "War Yards is a 1v1 multiplayer shooter that approaches bullet time combat in a whole new way. The game utilizes a unique set of mechanics that allow each player to control the speed of their opponent\u2019s projectiles. Bullet time mode can be activated at any time, but while active it restricts the player to room-scale movement only and removes their ability to reload. These mechanics create an unparalleled combat experience that seamlessly blends fast paced action with tense strategy. War Yards combines these innovative gameplay systems with incredibly detailed stylized maps to make for a truly unforgettable VR western adventure.\n\nFeatures:\n- Challenge your friends to intense and highly strategic 1v1 duels.\n- Utilize incredibly unique multiplayer bullet time mechanics to outsmart your opponent.\n- Explore 4 highly detailed stylized maps inspired by classic western settings.\n- Enjoy the freedom of playing with users across nearly all VR platforms.", "short_description": "Step into the shoes of a legendary gunslinger and experience a new kind of VR multiplayer combat. War Yards utilizes a set of unique gameplay systems to seamlessly bring bullet time mechanics to multiplayer matches."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.iubenda.com/privacy-policy/24673521/legal", "developer_terms_of_service_url": null, "publisher_name": "Pixel Framers LLC", "support_website_url": null, "website_url": "https://www.waryards.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "con
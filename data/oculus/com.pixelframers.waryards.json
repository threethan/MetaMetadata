-09-17_22-40-30.png", "id": "275494520588765", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39036704_275494523922098_2426874895962552879_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=szWtOLkBS6IQ7kNvwHaHVb1&_nc_oc=AdrzVDoIVt1Q0jA-Rb8YjG5MUSVSSJuWFPkdUcjQB-hEM4pMyWUkMR_E8PKW3j4hD-4&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDwpAFR9KaeVpeyCe1CIoeSC-TreUO-XvP9f6dwTkhJKg&oe=6A538482"}, {"file_name": "screen_2560x1440_2020-09-17_22-46-29.png", "id": "238990151157199", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38984447_238990154490532_767541046175693257_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QnX6pvoTJgQQ7kNvwEW0T63&_nc_oc=AdrLPw7AlPMog28iXGZ2Myb-oXpHIe91Cj-nR_MY_-rcLqDFpVGSqaidPXl9vusuHXA&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCH4f_XAV9SPeJZM9P8uHvf3sM_DuTFORjJV0cHflKe_g&oe=6A53AAB0"}, {"file_name": "screen_2560x1440_2020-09-17_22-45-52.png", "id": "153148369974995", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974693_153148373308328_3846551554399346998_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qGJ15ynfeKcQ7kNvwHk1WHw&_nc_oc=AdpOYmehA0cx1-JJ97E3SE2hXYSDVCeAJR8UifpPDfyH1K3gZ9bTVPOMsgFp3rhzEQw&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA9ior_u_0Gq5vL9sP0rb06dDLP15OLaWziVzQTibkZAg&oe=6A53795D"}, {"file_name": "screen_2560x1440_2020-09-17_22-43-52.png", "id": "429953335104667", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974714_429953338438000_1630301928601733580_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jc3cgNtMrCkQ7kNvwFuKewF&_nc_oc=AdrkzAjqow1ltAnK67IwyBUDroCLkpeY_yQ1wgrcneSuVE8LJsO24i9XSQ846NCIxd8&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD-cLDDQUK0xQwI3JQnfw7IWzBd6XaLJJfzQmOXTppq9A&oe=6A53ACC2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screen_2560x1440_2020-09-17_22-47-51.png", "id": "230829075192600", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38974887_230829078525933_560344683498926700_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H5xgeySgHUYQ7kNvwFq8vBk&_nc_oc=AdpgyVz0PxoyP-A4r8kbiPx4bfETGXqefu-jxdT6fb0HSslIPGoUCs54xS_GQetAa0M&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBP4wrIGWTTqBO_H_7bBjqC-V8Q1gYmenqRgTKzKWkbFQ&oe=6A538CBF"}, "display_name": "War Yards Beta", "keywords": [], "long_description": "War Yards is a 1v1 multiplayer shooter that approaches bullet time combat in a whole new way. The game utilizes a unique set of mechanics that allow each player to control the speed of their opponent\u2019s projectiles. Bullet time mode can be activated at any time, but while active it restricts the player to room-scale movement only and removes their ability to reload. These mechanics create an unparalleled combat experience that seamlessly blends fast paced action with tense strategy. War Yards combines these innovative gameplay systems with incredibly detailed stylized maps to make for a truly unforgettable VR western adventure.\n\nFeatures:\n- Challenge your friends to intense and highly strategic 1v1 duels.\n- Utilize incredibly unique multiplayer bullet time mechanics to outsmart your opponent.\n- Explore 4 highly detailed stylized maps inspired by classic western settings.\n- Enjoy the freedom of playing with users across nearly all VR platforms.", "short_description": "Step into the shoes of a legendary gunslinger and experience a new kind of VR multiplayer combat. War Yards utilizes a set of unique gameplay systems to seamlessly bring bullet time mechanics to multiplayer matches."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.iubenda.com/privacy-policy/24673521/legal", "developer_terms_of_service_url": null, "publisher_name": "Pixel Framers LLC", "support_website_url": null, "website_url": "https://www.waryards.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "con
-09-17_22-40-30.png", "id": "275494520588765", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39036704_275494523922098_2426874895962552879_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mX492xyIwl8Q7kNvwExo-9s&_nc_oc=AdoSjUCcQXoqCrprnd8908zenmdoxmqMrLNiaXbGgw9vBWL7uwER1oiNiPV0Tgr5vjs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJPwiwslfZSSwSTXfwz1fvJ6ZIDdKrxQm2b67RlcBSb5A&oe=6AB54BC2"}, {"file_name": "screen_2560x1440_2020-09-17_22-46-29.png", "id": "238990151157199", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38984447_238990154490532_767541046175693257_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_lOmg44D_eEQ7kNvwGLnD0j&_nc_oc=Adrlmzi4DdL9HTw1JoCL05xHWdkAqlq18lhio-QwqNNgQBQYtEBCDnWKmo109t00waI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIKe5ayDhn7HKrFme_VcfhwslpvdScuaJfBtY-NsxITqg&oe=6AB539B0"}, {"file_name": "screen_2560x1440_2020-09-17_22-45-52.png", "id": "153148369974995", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974693_153148373308328_3846551554399346998_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aa7L-pdK828Q7kNvwHDa_5G&_nc_oc=AdpuVyp1CIX-BO0yE0qkg4eDUQKGmk3_ovkdec0rZzL480LmtBVVdZ9eiZFOKw6GnIQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJzOHlXc_qumgo1QIwjKb8j5rNjquQWfiZhQwGR30CNDA&oe=6AB5409D"}, {"file_name": "screen_2560x1440_2020-09-17_22-43-52.png", "id": "429953335104667", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974714_429953338438000_1630301928601733580_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AZ0JStJNVSoQ7kNvwFYVje2&_nc_oc=AdqAzQOwF5YOeN80tdqSxvBxJH50Z1LDVTGryA7yEFKUazXEWTdGZ2h2W9EwdWeY5Z4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL_fgb-2LnCiY-FP7gaMsgsjZ7UQd5SD1KOzOU4FWspPQ&oe=6AB53BC2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screen_2560x1440_2020-09-17_22-47-51.png", "id": "230829075192600", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974887_230829078525933_560344683498926700_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aIZ6hMy7w9MQ7kNvwHAWZVv&_nc_oc=AdoBxDhSbiIgjXN7JCqIWqNmYaPYz98uUiUNnr5yHePryd5fApiZETkUnojGTi7vhPI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKhy0Kn0UCbACxXiv1xn_kCmWbHsRelI89q_uac1ZCNHQ&oe=6AB51BBF"}, "display_name": "War Yards Beta", "keywords": [], "long_description": "War Yards is a 1v1 multiplayer shooter that approaches bullet time combat in a whole new way. The game utilizes a unique set of mechanics that allow each player to control the speed of their opponent\u2019s projectiles. Bullet time mode can be activated at any time, but while active it restricts the player to room-scale movement only and removes their ability to reload. These mechanics create an unparalleled combat experience that seamlessly blends fast paced action with tense strategy. War Yards combines these innovative gameplay systems with incredibly detailed stylized maps to make for a truly unforgettable VR western adventure.\n\nFeatures:\n- Challenge your friends to intense and highly strategic 1v1 duels.\n- Utilize incredibly unique multiplayer bullet time mechanics to outsmart your opponent.\n- Explore 4 highly detailed stylized maps inspired by classic western settings.\n- Enjoy the freedom of playing with users across nearly all VR platforms.", "short_description": "Step into the shoes of a legendary gunslinger and experience a new kind of VR multiplayer combat. War Yards utilizes a set of unique gameplay systems to seamlessly bring bullet time mechanics to multiplayer matches."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.iubenda.com/privacy-policy/24673521/legal", "developer_terms_of_service_url": null, "publisher_name": "Pixel Framers LLC", "support_website_url": null, "website_url": "https://www.waryards.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "con
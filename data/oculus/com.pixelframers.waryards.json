-09-17_22-40-30.png", "id": "275494520588765", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39036704_275494523922098_2426874895962552879_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-AL7MuiEbakQ7kNvwG3hnX-&_nc_oc=AdoCBcY34PMqo8WB_3EbaBmrTfcDQU1yHbOz87Jg9JmVwl3ZsZyHUNYUV1SI6NDus-w&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTiIjaRARGA_gKZ4qhuwLvqZ8sjNuKsoMS7SoZoKtKydQ&oe=6AF493C2"}, {"file_name": "screen_2560x1440_2020-09-17_22-46-29.png", "id": "238990151157199", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38984447_238990154490532_767541046175693257_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=djQ4FSSWRZ0Q7kNvwFT3M1K&_nc_oc=Adqa1Rned_UcBUx8DEncLNK5gEXgLj46_FWtO-F18RrEUAvmRdhhgRoWM4C4TMCxy6M&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQaFu4kRCi1Z_i8Ar22WWEoHEKFcUAoOEGnActAOzvtBw&oe=6AF481B0"}, {"file_name": "screen_2560x1440_2020-09-17_22-45-52.png", "id": "153148369974995", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974693_153148373308328_3846551554399346998_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TP4Y1C8EpIIQ7kNvwHaQjQh&_nc_oc=Adp8RdtX_4QWJOGoSx1gU8YV4PDSQfdeG7E9RSyX3IirKt7xrd2i6V-D52hEZXmsN_4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTzUXsaqo0xD0QFWQzbjE1_AwDKm2yknB0KSYDF8melBA&oe=6AF4889D"}, {"file_name": "screen_2560x1440_2020-09-17_22-43-52.png", "id": "429953335104667", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974714_429953338438000_1630301928601733580_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C6BsuHPNhqMQ7kNvwEAKyR_&_nc_oc=AdofRDaJkE3pUKamFnGNQpt4aGzqUV_Vkb24wdJZqSIJg31N_Q8NL9wsd07Jkgj3cV4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR5Qqqa7gFmNF4iER1sKJPAFNEz9GwQReaaXJDi2aFZlw&oe=6AF483C2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screen_2560x1440_2020-09-17_22-47-51.png", "id": "230829075192600", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974887_230829078525933_560344683498926700_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kPf-ooHcFDIQ7kNvwHskz67&_nc_oc=AdrdqZ_HTXc8roxl7LVpk5P76PnBkCt9rkLawaCWo-apKP-PkDsgaz4P7-8HNoVbDRA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ5hkfyvQ5ZzHGN33szJQW6aO4HTmIJkxRUi3LkUi1WUw&oe=6AF49BFF"}, "display_name": "War Yards Beta", "keywords": [], "long_description": "War Yards is a 1v1 multiplayer shooter that approaches bullet time combat in a whole new way. The game utilizes a unique set of mechanics that allow each player to control the speed of their opponent\u2019s projectiles. Bullet time mode can be activated at any time, but while active it restricts the player to room-scale movement only and removes their ability to reload. These mechanics create an unparalleled combat experience that seamlessly blends fast paced action with tense strategy. War Yards combines these innovative gameplay systems with incredibly detailed stylized maps to make for a truly unforgettable VR western adventure.\n\nFeatures:\n- Challenge your friends to intense and highly strategic 1v1 duels.\n- Utilize incredibly unique multiplayer bullet time mechanics to outsmart your opponent.\n- Explore 4 highly detailed stylized maps inspired by classic western settings.\n- Enjoy the freedom of playing with users across nearly all VR platforms.", "short_description": "Step into the shoes of a legendary gunslinger and experience a new kind of VR multiplayer combat. War Yards utilizes a set of unique gameplay systems to seamlessly bring bullet time mechanics to multiplayer matches."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.iubenda.com/privacy-policy/24673521/legal", "developer_terms_of_service_url": null, "publisher_name": "Pixel Framers LLC", "support_website_url": null, "website_url": "https://www.waryards.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "con
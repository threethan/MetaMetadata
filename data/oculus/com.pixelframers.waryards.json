-09-17_22-40-30.png", "id": "275494520588765", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39036704_275494523922098_2426874895962552879_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-124yqLOR04Q7kNvwEQzLzE&_nc_oc=Ado846Fz8gqMHWhjUQnqpKjvlhAEBmN9P8XqIVgd_q98vnEQh0HJK9CQNMRAGYnAWhI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHInorYzEUi9c3kVaWoQH0p0To9-YeQJRbfr7Td0RXhHA&oe=6A79C002"}, {"file_name": "screen_2560x1440_2020-09-17_22-46-29.png", "id": "238990151157199", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38984447_238990154490532_767541046175693257_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l8F7l--XkoUQ7kNvwEyajUB&_nc_oc=AdrF6EB19ncrcRRjbdQcvX-qpitiAWt2-cbL8VRRxYFRNqQew3aDPvsJ-maOpROxNg0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFjBS0Fo1uUHq-vRfjDX52GL-96eQ-T12Kvqlf6zlmT9w&oe=6A79E630"}, {"file_name": "screen_2560x1440_2020-09-17_22-45-52.png", "id": "153148369974995", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974693_153148373308328_3846551554399346998_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uCsUsx1wrkgQ7kNvwFfPLJ7&_nc_oc=AdqAft16xObT2EQ4ukLkCfNF4QFfBN100nJqJON6ILg6RfIN_dBKq-aqPAhnfgm1jtw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFLnocM_UBFcpCMRHpxH68F5ESfvFDdhVcTsjxZ8JzDJQ&oe=6A79B4DD"}, {"file_name": "screen_2560x1440_2020-09-17_22-43-52.png", "id": "429953335104667", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974714_429953338438000_1630301928601733580_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bgz1inyKRjMQ7kNvwHCwgl7&_nc_oc=AdpDqmOQcPGbJD29wWoGGiFZHweZNIPPjcY_LlHa5BR-jXbEUnSS9YvApKs2RKDKrWA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGT48cgzScdJDa9uwbc9nvfJzX6FBGr1Jvlp29ghfxVeA&oe=6A79E842"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screen_2560x1440_2020-09-17_22-47-51.png", "id": "230829075192600", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974887_230829078525933_560344683498926700_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=X1wkgunXA04Q7kNvwHH5ikz&_nc_oc=AdqqJMQdKd1VnbHDpEMgE-0T1vVvQ3FSLF7-2NX-EFOxQNihPnHIE30H2vns3Ka-0GM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGKVso-o7j3J_eHPgLO8WIh3eBvMbFYdDlhrjrnDJo7MA&oe=6A79C83F"}, "display_name": "War Yards Beta", "keywords": [], "long_description": "War Yards is a 1v1 multiplayer shooter that approaches bullet time combat in a whole new way. The game utilizes a unique set of mechanics that allow each player to control the speed of their opponent\u2019s projectiles. Bullet time mode can be activated at any time, but while active it restricts the player to room-scale movement only and removes their ability to reload. These mechanics create an unparalleled combat experience that seamlessly blends fast paced action with tense strategy. War Yards combines these innovative gameplay systems with incredibly detailed stylized maps to make for a truly unforgettable VR western adventure.\n\nFeatures:\n- Challenge your friends to intense and highly strategic 1v1 duels.\n- Utilize incredibly unique multiplayer bullet time mechanics to outsmart your opponent.\n- Explore 4 highly detailed stylized maps inspired by classic western settings.\n- Enjoy the freedom of playing with users across nearly all VR platforms.", "short_description": "Step into the shoes of a legendary gunslinger and experience a new kind of VR multiplayer combat. War Yards utilizes a set of unique gameplay systems to seamlessly bring bullet time mechanics to multiplayer matches."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.iubenda.com/privacy-policy/24673521/legal", "developer_terms_of_service_url": null, "publisher_name": "Pixel Framers LLC", "support_website_url": null, "website_url": "https://www.waryards.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "con
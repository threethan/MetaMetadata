.oculuscdn.com&_nc_ss=8&oh=00_AfwcQ8ce66u_AXFMKx-6aPRvTgo_Lo0sJh6yYtDH1FtU_A&oe=69AFFA82"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screen_2560x1440_2020-09-17_22-47-51.png", "id": "230829075192600", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974887_230829078525933_560344683498926700_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AerQ5Qw6uM4Q7kNvwGZ1lF-&_nc_oc=AdmWqbc697MKWYypdcImhkI6raJBHWbV7ARQYTRE6lwg4cKu4aslESTBGg9eKZ-pUyQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfwYy9LxyvU4snOGMGLh8294VmmOwkMgfj2nhNxyY6GegA&oe=69B012BF"}, "display_name": "War Yards Beta", "keywords": [], "long_description": "War Yards is a 1v1 multiplayer shooter that approaches bullet time combat in a whole new way. The game utilizes a unique set of mechanics that allow each player to control the speed of their opponent\u2019s projectiles. Bullet time mode can be activated at any time, but while active it restricts the player to room-scale movement only and removes their ability to reload. These mechanics create an unparalleled combat experience that seamlessly blends fast paced action with tense strategy. War Yards combines these innovative gameplay systems with incredibly detailed stylized maps to make for a truly unforgettable VR western adventure.\n\nFeatures:\n- Challenge your friends to intense and highly strategic 1v1 duels.\n- Utilize incredibly unique multiplayer bullet time mechanics to outsmart your opponent.\n- Explore 4 highly detailed stylized maps inspired by classic western settings.\n- Enjoy the freedom of playing with users across nearly all VR platforms.", "short_description": "Step into the shoes of a legendary gunslinger and experience a new kind of VR multiplayer combat. War Yards utilizes a set of unique gameplay systems to seamlessly bring bullet time mechanics to multiplayer matches."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.iubenda.com/privacy-policy/24673521/legal", "d
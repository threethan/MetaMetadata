-09-17_22-40-30.png", "id": "275494520588765", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39036704_275494523922098_2426874895962552879_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GYnMmyH2qqcQ7kNvwF7efIR&_nc_oc=AdolyRupWFDBwBn_aX_jr9cs8dkoJ8UicCxljyeVpN7EJJ9YcwZzaxfUL1IOKDh-pVs&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKVQP0_Cu-SopF7fK08Q2JhsUbkq1uHzRqD1d-76fTMzw&oe=6ABA5982"}, {"file_name": "screen_2560x1440_2020-09-17_22-46-29.png", "id": "238990151157199", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38984447_238990154490532_767541046175693257_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eutcCmFk5AEQ7kNvwFqClUd&_nc_oc=Ado4-b0YETUHevfrr4phc7vvcqE4yxbnYh3oabTkIGF3ojoNf0QIhQVXqUBNSFxkiTA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK8y_-YYhopfjrxpXWV1q_j6MC3AdBdia_Ptegw2xUc-w&oe=6ABA7FB0"}, {"file_name": "screen_2560x1440_2020-09-17_22-45-52.png", "id": "153148369974995", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974693_153148373308328_3846551554399346998_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=orSP84QHzrkQ7kNvwEOPyCZ&_nc_oc=Adr8Jf0vL711agumnl8GbFBMAlH9EwuAh70pNL_Mwff89uda5ySNNpyEgaq9bdgBZWQ&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKS0TAEilKA9YFS7PSiHtASAmPfS3FT5oChp37HoJhC8Q&oe=6ABA869D"}, {"file_name": "screen_2560x1440_2020-09-17_22-43-52.png", "id": "429953335104667", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974714_429953338438000_1630301928601733580_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6oG60PRFK-EQ7kNvwH3ucou&_nc_oc=Adp0IFlCCzcrvjHp-GEYh_p68N7PMuf3JlpgyY64LdlBGav8gJp3ThoSmU5QQSwX_g4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKXXnF2GprvKGl8ZT-nMS7JbkppCMlnAKAD0zXUMCpxxQ&oe=6ABA81C2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screen_2560x1440_2020-09-17_22-47-51.png", "id": "230829075192600", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974887_230829078525933_560344683498926700_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2O3rIDrjXkgQ7kNvwFGK9qr&_nc_oc=AdpMwBpoBclgeEkPD-N3mdLG8wUeNE5RrEziRCuW9QZZXkmc7tTGwkNJi35ZKKAKTPg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIltFE0c7rO0YL_FH-nuy2x1aPq41plvn1so-f8IDkXOw&oe=6ABA61BF"}, "display_name": "War Yards Beta", "keywords": [], "long_description": "War Yards is a 1v1 multiplayer shooter that approaches bullet time combat in a whole new way. The game utilizes a unique set of mechanics that allow each player to control the speed of their opponent\u2019s projectiles. Bullet time mode can be activated at any time, but while active it restricts the player to room-scale movement only and removes their ability to reload. These mechanics create an unparalleled combat experience that seamlessly blends fast paced action with tense strategy. War Yards combines these innovative gameplay systems with incredibly detailed stylized maps to make for a truly unforgettable VR western adventure.\n\nFeatures:\n- Challenge your friends to intense and highly strategic 1v1 duels.\n- Utilize incredibly unique multiplayer bullet time mechanics to outsmart your opponent.\n- Explore 4 highly detailed stylized maps inspired by classic western settings.\n- Enjoy the freedom of playing with users across nearly all VR platforms.", "short_description": "Step into the shoes of a legendary gunslinger and experience a new kind of VR multiplayer combat. War Yards utilizes a set of unique gameplay systems to seamlessly bring bullet time mechanics to multiplayer matches."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.iubenda.com/privacy-policy/24673521/legal", "developer_terms_of_service_url": null, "publisher_name": "Pixel Framers LLC", "support_website_url": null, "website_url": "https://www.waryards.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "con
-09-17_22-40-30.png", "id": "275494520588765", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39036704_275494523922098_2426874895962552879_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5xk8_WiKTNEQ7kNvwEijDHo&_nc_oc=Ado6jRTZAVWRARxylxaEZNlS0byqtNluU0H-pqgsMkD-c3RFQEwTgS7t0HgO4qzJGUE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6UgLwECYnBxFueZo6EsTd-k4v3vurOrf7tpLKQYzYZJw&oe=6A0B0202"}, {"file_name": "screen_2560x1440_2020-09-17_22-46-29.png", "id": "238990151157199", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38984447_238990154490532_767541046175693257_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=11np-3uu-skQ7kNvwFZHNqV&_nc_oc=AdqBolst__RVHAF2-dJkDL78aFXlrIDqY9i7Jg_u8AAUiEO1ZgrHmqry1ZKpoKPAUA4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4MYjw6zsCnuF_oQ4JYPWkyTGzHWJ1xunvs8RObUJh6tQ&oe=6A0B2830"}, {"file_name": "screen_2560x1440_2020-09-17_22-45-52.png", "id": "153148369974995", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974693_153148373308328_3846551554399346998_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x94BznZ26lQQ7kNvwGtMCly&_nc_oc=AdpMsxswwZVTH2zpEgn26UEY3AYjvnCyvp0MKdV7yDLARSivArtoUcYWGRfH2raSWsc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7MyKnkD8wdAagGC41P_MfnRZA-efLx822B1v5Rt0_kRw&oe=6A0B2F1D"}, {"file_name": "screen_2560x1440_2020-09-17_22-43-52.png", "id": "429953335104667", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974714_429953338438000_1630301928601733580_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0H0BF4eq4y8Q7kNvwGS1Pds&_nc_oc=Adpah3tEMZer78C_ie4HGXuum9opQ1jFM3GMorkOX_iUi1Y0rfMnjJGzWS89X5JYCz4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5mjfSzOrkFPqxO2BWwcQIbEt67VvBrJNn36wBksJCe6w&oe=6A0B2A42"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screen_2560x1440_2020-09-17_22-47-51.png", "id": "230829075192600", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974887_230829078525933_560344683498926700_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qiICaB2sXfgQ7kNvwG_lZ8Y&_nc_oc=Adr_kpPLvJKjW6W6f1EZ7C6snpxHJkNNMs2NtxuOEpGVvt5H-WNW3IFpYEq_NklNWms&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5kMjfsdo-U0G_ZdpN5N2blsVSBOpC_IZBshc2ABwb8HA&oe=6A0B0A3F"}, "display_name": "War Yards Beta", "keywords": [], "long_description": "War Yards is a 1v1 multiplayer shooter that approaches bullet time combat in a whole new way. The game utilizes a unique set of mechanics that allow each player to control the speed of their opponent\u2019s projectiles. Bullet time mode can be activated at any time, but while active it restricts the player to room-scale movement only and removes their ability to reload. These mechanics create an unparalleled combat experience that seamlessly blends fast paced action with tense strategy. War Yards combines these innovative gameplay systems with incredibly detailed stylized maps to make for a truly unforgettable VR western adventure.\n\nFeatures:\n- Challenge your friends to intense and highly strategic 1v1 duels.\n- Utilize incredibly unique multiplayer bullet time mechanics to outsmart your opponent.\n- Explore 4 highly detailed stylized maps inspired by classic western settings.\n- Enjoy the freedom of playing with users across nearly all VR platforms.", "short_description": "Step into the shoes of a legendary gunslinger and experience a new kind of VR multiplayer combat. War Yards utilizes a set of unique gameplay systems to seamlessly bring bullet time mechanics to multiplayer matches."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.iubenda.com/privacy-policy/24673521/legal", "developer_terms_of_service_url": null, "publisher_name": "Pixel Framers LLC", "support_website_url": null, "website_url": "https://www.waryards.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "con
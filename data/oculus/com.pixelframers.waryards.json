6252767851326_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_NnVRq6673kQ7kNvwHEEcyC&_nc_oc=Ado5NSA-AwiUek9gD2DzdcxvMdj5lXTB8E1qOScfDoOM8JjdwqEUgOTIALMgnX_E1mk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8ABMYy_N4m1epcwvLFS6Jr3zn06VWgJASYlZELYbVWVQ&oe=6A2D47D9"}, {"file_name": "screen_2560x1440_2020-09-17_22-40-30.png", "id": "275494520588765", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39036704_275494523922098_2426874895962552879_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A7DQ_n-JIJ4Q7kNvwEiFRRN&_nc_oc=AdqDaF041lwUUpNSS3d1lpLQmIp3ZmNvYwhlNS6j-Vrw9sbatp2ysfIIcxxksxtTC-s&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9GgI_vAppRxL0aIY3y5_NYvrI5_MYytMXqB18QBZdLBg&oe=6A2D4902"}, {"file_name": "screen_2560x1440_2020-09-17_22-46-29.png", "id": "238990151157199", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38984447_238990154490532_767541046175693257_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U0k1LsZE6BMQ7kNvwGQUSF8&_nc_oc=Adq2RacA283ijkozkzeG_mgywlpVEAlf1TNm1E4gKo41-xbz6MklMjShv84ft3tiUYQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_TWBlKwZKLA0VkqUQlWWZN4YnpZVMm9RQzkr--YykUAg&oe=6A2D6F30"}, {"file_name": "screen_2560x1440_2020-09-17_22-45-52.png", "id": "153148369974995", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974693_153148373308328_3846551554399346998_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6_obTumTV9oQ7kNvwEqltx_&_nc_oc=AdoVStGhx4rjzJsLhhIZNg6m5APwB5AcXp-iHcOzWmz8bsG0gNPPDRYlsR-BjUhnWj4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8l0YxK2J74pHyopqB1dHbLfvEZ9mUjkGaVM5aDZ_OBag&oe=6A2D761D"}, {"file_name": "screen_2560x1440_2020-09-17_22-43-52.png", "id": "429953335104667", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974714_429953338438000_1630301928601733580_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Rp8LccSXnW0Q7kNvwHvX-h3&_nc_oc=AdpTFKDUxG4RRGvQIjVzpXEk7m5eR1V3JZ6NiR5yG1F9ywRndmnhsxx38xABm6JaCAU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_I_EMa9BlxqQIwOgBtHJLHfpVWCNVP_buBE5Uq3FDlxQ&oe=6A2D7142"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screen_2560x1440_2020-09-17_22-47-51.png", "id": "230829075192600", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974887_230829078525933_560344683498926700_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZjuXGUscwBUQ7kNvwHs3vev&_nc_oc=AdrkSgWBJPdynKV4FoY_vK_XmCKMfydX6A2j0tIjYlpNnaKKTkWkVo3HI1WK72oicMY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_ewNSPM3kboXYFjP-G_SG2v0mxVEAiDf7NgOD0IWNg2g&oe=6A2D513F"}, "display_name": "War Yards Beta", "keywords": [], "long_description": "War Yards is a 1v1 multiplayer shooter that approaches bullet time combat in a whole new way. The game utilizes a unique set of mechanics that allow each player to control the speed of their opponent\u2019s projectiles. Bullet time mode can be activated at any time, but while active it restricts the player to room-scale movement only and removes their ability to reload. These mechanics create an unparalleled combat experience that seamlessly blends fast paced action with tense strategy. War Yards combines these innovative gameplay systems with incredibly detailed stylized maps to make for a truly unforgettable VR western adventure.\n\nFeatures:\n- Challenge your friends to intense and highly strategic 1v1 duels.\n- Utilize incredibly unique multiplayer bullet time mechanics to outsmart your opponent.\n- Explore 4 highly detailed stylized maps inspired by classic western settings.\n- Enjoy the freedom of playing with users across nearly all VR platforms.", "short_description": "Step into the shoes of a legendary gunslinger and experience a new kind of VR multiplayer combat. War Yards utilizes a set of unique gameplay systems to seamlessly bring bullet time mechanics to multiplayer matches."}]}, "developer_name": null, "developer_privacy_policy_url": "https:
-09-17_22-40-30.png", "id": "275494520588765", "uri": "https://scontent-lhr8-1.oculuscdn.com/v/t64.5771-25/39036704_275494523922098_2426874895962552879_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7MD-XWoEOH0Q7kNvwF99ACr&_nc_oc=AdrJ76yeDnsbXIfyoh_T5SgH2dBNpJEor7sTsUyAKiG_6SA8TsJKGuUyrGhR6ddU1bQ&_nc_zt=3&_nc_ht=scontent-lhr8-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7dIVYxL9n8wjfGA3kwLWXBN39Cb33o6XuPZ8-_uTPsKw&oe=6A108042"}, {"file_name": "screen_2560x1440_2020-09-17_22-46-29.png", "id": "238990151157199", "uri": "https://scontent-lhr8-1.oculuscdn.com/v/t64.5771-25/38984447_238990154490532_767541046175693257_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qfj1B-QgbF4Q7kNvwF2iswl&_nc_oc=AdqvSc3LWoqlsqixQtZ1lkYc3XNZgR4DrClfQaik4xtxkU4BhSlsz4x4zkGg-MKzN9U&_nc_zt=3&_nc_ht=scontent-lhr8-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6DNz47_4DP5CmpRLiL3108AqRZR_ScqqNOKC55-m6C6Q&oe=6A106E30"}, {"file_name": "screen_2560x1440_2020-09-17_22-45-52.png", "id": "153148369974995", "uri": "https://scontent-lhr8-2.oculuscdn.com/v/t64.5771-25/38974693_153148373308328_3846551554399346998_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S4ZWWfiyjIsQ7kNvwFdPBDJ&_nc_oc=AdoKQ06Mn67COOxtTcIvukMS7eIRhB0H_AMa5PZtYosCMLbSCIMhcxQ_l6nOf8Dw2rY&_nc_zt=3&_nc_ht=scontent-lhr8-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7wCEo7CWAATlXKRx91LDXSj7Ef8-_bHkJKwnetdytOrQ&oe=6A10751D"}, {"file_name": "screen_2560x1440_2020-09-17_22-43-52.png", "id": "429953335104667", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/38974714_429953338438000_1630301928601733580_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jFJv_xMO8s8Q7kNvwHzoraF&_nc_oc=AdpN8OqDb5HQnr0cciaMUZbu8EGt2TBrmqFKEpKl5Ltq6W-6QZonAMBZTMtIKykBX8A&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4vpmMpmxrhqWs3WN2ywYHkfyQiheXEqfpQ_q9idH6X9w&oe=6A107042"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screen_2560x1440_2020-09-17_22-47-51.png", "id": "230829075192600", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/38974887_230829078525933_560344683498926700_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vHOaHGPCnkUQ7kNvwGmU0Xs&_nc_oc=Adq10EwpSH1wgYgs0fnbAVWUwmsqRmV56qLYJArgt5JNJPKNFmDt1g26OnDKpq-CfXA&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7IdzLpWc0GUaNbNl4ZBGktY7zFryJBf2AI-lH3sTtrQw&oe=6A10503F"}, "display_name": "War Yards Beta", "keywords": [], "long_description": "War Yards is a 1v1 multiplayer shooter that approaches bullet time combat in a whole new way. The game utilizes a unique set of mechanics that allow each player to control the speed of their opponent\u2019s projectiles. Bullet time mode can be activated at any time, but while active it restricts the player to room-scale movement only and removes their ability to reload. These mechanics create an unparalleled combat experience that seamlessly blends fast paced action with tense strategy. War Yards combines these innovative gameplay systems with incredibly detailed stylized maps to make for a truly unforgettable VR western adventure.\n\nFeatures:\n- Challenge your friends to intense and highly strategic 1v1 duels.\n- Utilize incredibly unique multiplayer bullet time mechanics to outsmart your opponent.\n- Explore 4 highly detailed stylized maps inspired by classic western settings.\n- Enjoy the freedom of playing with users across nearly all VR platforms.", "short_description": "Step into the shoes of a legendary gunslinger and experience a new kind of VR multiplayer combat. War Yards utilizes a set of unique gameplay systems to seamlessly bring bullet time mechanics to multiplayer matches."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.iubenda.com/privacy-policy/24673521/legal", "developer_terms_of_service_url": null, "publisher_name": "Pixel Framers LLC", "support_website_url": null, "website_url": "https://www.waryards.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "con
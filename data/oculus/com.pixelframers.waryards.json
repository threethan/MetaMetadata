-09-17_22-40-30.png", "id": "275494520588765", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39036704_275494523922098_2426874895962552879_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7PN0Kj8wt1kQ7kNvwGWSA3M&_nc_oc=AdpuDLWin9OOYLSJeaT7d3RPTewikOIPLO2dD3j0wQk4Sv958UaRqRnXAE07y7ikJaw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPntCC3mfdJs2Q2k0K6ZXIeeJXGQMuH-NnyOk8LnjXvhA&oe=6ACA63C2"}, {"file_name": "screen_2560x1440_2020-09-17_22-46-29.png", "id": "238990151157199", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38984447_238990154490532_767541046175693257_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eZ8HDYryAfYQ7kNvwGrYJub&_nc_oc=Adrucjxg2M4BoDTOcTfAqTCYZddVl4z8wclzHzYjVZ6OOWbKvNfgFJYhKmovpAWsicQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMLJEkSv32CzSiwH0jOFfuNzpF5a08NPuHey98khf6T5w&oe=6ACA51B0"}, {"file_name": "screen_2560x1440_2020-09-17_22-45-52.png", "id": "153148369974995", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974693_153148373308328_3846551554399346998_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jKyOnBHzkM4Q7kNvwHjlQ6a&_nc_oc=Adqof9zU7mhlSe7MzfIUavdCxvm-R3FdDQqmaYTp5t30r6gZgm-8vaE3yFY285XCO90&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOsA4j0Irmo2Xu9DGFRrZocWEckh1b-EFBkQoOATbtnJA&oe=6ACA589D"}, {"file_name": "screen_2560x1440_2020-09-17_22-43-52.png", "id": "429953335104667", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974714_429953338438000_1630301928601733580_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Bk_OMvYF1csQ7kNvwEFGHxx&_nc_oc=Adp4v5beZNDGZcznb8P0zPoO-QqrjrMwaDPrmsgC122a3K3aGu60WvQu_r-LPs3Houw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOfwMpI46vxR2NVa2PtiN8waUQynYFY9KCqCgMqDGGcNA&oe=6ACA53C2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screen_2560x1440_2020-09-17_22-47-51.png", "id": "230829075192600", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974887_230829078525933_560344683498926700_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PT_EbrTo4dsQ7kNvwHcSDXB&_nc_oc=AdrMuIUHkhLEfTzXu_d8LBVTp2m8LiluEINzvgS-vcyAxE0C7dvrxEbgmKv2lGQw2S8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO7EqFanbS4R1DWP4LaePrs86HngI-H1fb52TTL9LJ0_g&oe=6ACA6BFF"}, "display_name": "War Yards Beta", "keywords": [], "long_description": "War Yards is a 1v1 multiplayer shooter that approaches bullet time combat in a whole new way. The game utilizes a unique set of mechanics that allow each player to control the speed of their opponent\u2019s projectiles. Bullet time mode can be activated at any time, but while active it restricts the player to room-scale movement only and removes their ability to reload. These mechanics create an unparalleled combat experience that seamlessly blends fast paced action with tense strategy. War Yards combines these innovative gameplay systems with incredibly detailed stylized maps to make for a truly unforgettable VR western adventure.\n\nFeatures:\n- Challenge your friends to intense and highly strategic 1v1 duels.\n- Utilize incredibly unique multiplayer bullet time mechanics to outsmart your opponent.\n- Explore 4 highly detailed stylized maps inspired by classic western settings.\n- Enjoy the freedom of playing with users across nearly all VR platforms.", "short_description": "Step into the shoes of a legendary gunslinger and experience a new kind of VR multiplayer combat. War Yards utilizes a set of unique gameplay systems to seamlessly bring bullet time mechanics to multiplayer matches."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.iubenda.com/privacy-policy/24673521/legal", "developer_terms_of_service_url": null, "publisher_name": "Pixel Framers LLC", "support_website_url": null, "website_url": "https://www.waryards.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "con
-09-17_22-40-30.png", "id": "275494520588765", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/39036704_275494523922098_2426874895962552879_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cKUzsorFyeUQ7kNvwHHJnVo&_nc_oc=AdpZt2CBQtpc9xiHnD8qjxy5yGE73veZJeJU1OkDguFRZATndP0afMSJLHh52a1VD44&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af284v2EUH-O33KEc7786rd7E9vqNtO4AUfRdr7gA6PnCg&oe=69D79782"}, {"file_name": "screen_2560x1440_2020-09-17_22-46-29.png", "id": "238990151157199", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/38984447_238990154490532_767541046175693257_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QvFbZy7uEE0Q7kNvwHph6EP&_nc_oc=Ado6BbliJsyExkXGMlVb2UUMH3cR0RtpP--FtpAz1jNYBu6TEuTjDGbzJ9sEwE-HUNE&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af33vYzlCcUoivomHGyKxoB45nGNefoHtpWICaVZzIUSjQ&oe=69D7BDB0"}, {"file_name": "screen_2560x1440_2020-09-17_22-45-52.png", "id": "153148369974995", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38974693_153148373308328_3846551554399346998_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PvaJmOX31f0Q7kNvwF3KA96&_nc_oc=AdrPsaPI1wWy40tmzT8g4lYBJtQcRQTq7VBZa7V4jIUjCzs__noIf4fOohzfwaK4iiA&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0Dv5xEXRb9S_qn0rO-xDoKwmQGXhtWV5xOMSKM_GUnHg&oe=69D78C5D"}, {"file_name": "screen_2560x1440_2020-09-17_22-43-52.png", "id": "429953335104667", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/38974714_429953338438000_1630301928601733580_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2AJ79oV6WzQQ7kNvwHFo2FD&_nc_oc=Adq9MmvHdUUSKZ8sMOuNygw_OD1dhY9JajOCuIVYnUrUqiPUDSfzHf6BRxK18VUa5RQ&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3-95QFzWiDGTtF2VrGvLYSJYCBnAA7D05z-BMJmlgZhA&oe=69D78782"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screen_2560x1440_2020-09-17_22-47-51.png", "id": "230829075192600", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/38974887_230829078525933_560344683498926700_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j8qNPJEwQ4YQ7kNvwFQ8pvp&_nc_oc=Adrg349qkhVEoP_J5XBV7fLrT52JQCG8Ml3FNnUieJBsNyIPhquGrNg9L6ICEzIjY74&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af186sm27gWlsVUTTarM4177Q_IxQWwqGmHnaFRkyCh3kA&oe=69D79FBF"}, "display_name": "War Yards Beta", "keywords": [], "long_description": "War Yards is a 1v1 multiplayer shooter that approaches bullet time combat in a whole new way. The game utilizes a unique set of mechanics that allow each player to control the speed of their opponent\u2019s projectiles. Bullet time mode can be activated at any time, but while active it restricts the player to room-scale movement only and removes their ability to reload. These mechanics create an unparalleled combat experience that seamlessly blends fast paced action with tense strategy. War Yards combines these innovative gameplay systems with incredibly detailed stylized maps to make for a truly unforgettable VR western adventure.\n\nFeatures:\n- Challenge your friends to intense and highly strategic 1v1 duels.\n- Utilize incredibly unique multiplayer bullet time mechanics to outsmart your opponent.\n- Explore 4 highly detailed stylized maps inspired by classic western settings.\n- Enjoy the freedom of playing with users across nearly all VR platforms.", "short_description": "Step into the shoes of a legendary gunslinger and experience a new kind of VR multiplayer combat. War Yards utilizes a set of unique gameplay systems to seamlessly bring bullet time mechanics to multiplayer matches."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.iubenda.com/privacy-policy/24673521/legal", "developer_terms_of_service_url": null, "publisher_name": "Pixel Framers LLC", "support_website_url": null, "website_url": "https://www.waryards.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "con
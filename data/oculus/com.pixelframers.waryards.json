g_X3rc3RKGwbI&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AftOqlvwcd2B7dIK671tO2YnYq70gl1HA-1xhFW-u487jw&oe=699AF282"}, {"file_name": "screen_2560x1440_2020-09-17_22-46-29.png", "id": "238990151157199", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38984447_238990154490532_767541046175693257_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2MX-72c3sjQQ7kNvwH9ceRD&_nc_oc=AdnWDULTVzcXO84Mh4KzuUuPBsm0pkMdvybuwUM_Q0eq2R36-klv4Tj9wt0eEjcNpsY&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AftZl7fjLV-GujshzjLIWRHbEsZlOnU9cHZHz-_O8OKhDA&oe=699AE070"}, {"file_name": "screen_2560x1440_2020-09-17_22-45-52.png", "id": "153148369974995", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974693_153148373308328_3846551554399346998_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jRvbj2HCJTgQ7kNvwF576Ck&_nc_oc=Adk65M3mCHreS_tAhZ54018bs6x87Jpi8S8uET0gDOS6OnEwFvYOwya9Ye8Up1wiL7M&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AfsFt8A2vntX0nrpfsauTz7kN3Wq-s_5gQ7HVMCEeixgQg&oe=699AE75D"}, {"file_name": "screen_2560x1440_2020-09-17_22-43-52.png", "id": "429953335104667", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974714_429953338438000_1630301928601733580_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Kfe_Qqq0OGUQ7kNvwG4JRyq&_nc_oc=AdnmHwFc2uVxzWzIp9NtQW2tzYP0H69PmUHLmAWiWHkiK7-uwAyaLUrce1F57td0dtY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_Afu-9JqWc6YOW1m2gL82scli0PVGk-b9gXl9oG2kwCr3qg&oe=699AE282"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screen_2560x1440_2020-09-17_22-47-51.png", "id": "230829075192600", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974887_230829078525933_560344683498926700_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qAEt_xcBrb4Q7kNvwEXndQq&_nc_oc=AdmcutNtktEgC7jid9abUskmWGgksIFE1sLKbeRXl3KfexVIHObkgW9d3XkLBCmiaaI&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfuvsanzMi5zQV4FEYN91ywzxJGCRl8o-_xWWTUNl_mxgA&oe=699AFABF"}, "display_name": "War Yards Beta", "keywords": [], "long_description": "War Yards is a 1v1 multiplayer shooter that approaches bullet time combat in a whole new way. The game utilizes a unique set of mechanics that allow each player to control the speed of their opponent\u2019s projectiles. Bullet time mode can be activated at any time, but while active it restricts the player to room-scale movement only and removes their ability to reload. These mechanics create an unparalleled combat experience that seamlessly blends fast paced action with tense strategy. War Yards combines these innovative gameplay systems with incredibly detailed stylized maps to make for a truly unforgettable VR western adventure.\n\nFeatures:\n- Challenge your friends to intense and highly strategic 1v1 duels.\n- Utilize incredibly unique multiplayer bullet time mechanics to outsmart your opponent.\n- Explore 4 highly detailed stylized maps inspired by classic western settings.\n- Enjoy the freedom of playing with users across nearly all VR platforms.", "short_description": "Step into the shoes of a legendary gunslinger and experience a new kind of VR multiplayer combat. War Yards utilizes a set of unique gameplay systems to seamlessly bring bullet time mechanics to multiplayer matches."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.iubenda.com/privacy-policy/24673521/legal", "developer_terms_of_service_url": null, "publisher_name": "Pixel Framers LLC", "support_website_url": null, "website_url": "https://www.waryards.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ARCADE", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_i
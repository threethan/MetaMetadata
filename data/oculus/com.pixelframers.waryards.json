-09-17_22-40-30.png", "id": "275494520588765", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39036704_275494523922098_2426874895962552879_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iNgtk2r4z8gQ7kNvwFnjasu&_nc_oc=AdrsXs7BKdUJcczM-HbKaGHoaSwXEt-rmRr7U6sxJUyak-OdprQN_oBAUtJxIlymG90&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ2R4sNfLM0EPVqjQTpuuS6aRzvnDzkXBvqWtNMAurRlA&oe=6AEF4DC2"}, {"file_name": "screen_2560x1440_2020-09-17_22-46-29.png", "id": "238990151157199", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38984447_238990154490532_767541046175693257_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LIYUCqAKFesQ7kNvwE_T_tE&_nc_oc=AdonNkZhmenzG9DitDwh7hPjFDfo8TQOjfCXRyGG4HlGQ7TckpW0OPG3J7X_1rsqL00&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTwOm7tDaf29UGQhJAF5xTCZYXaKAlC_3hbwZjz8KReFA&oe=6AEF3BB0"}, {"file_name": "screen_2560x1440_2020-09-17_22-45-52.png", "id": "153148369974995", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974693_153148373308328_3846551554399346998_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oez8BHYzZJMQ7kNvwGH8XFN&_nc_oc=Ado_8q2Ok7gImnpZESSiP61WMyPjUaF8u7ZKTILWRlVbgIR-rX-ky11ro_6plKvaiXw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSIb2h81TBza7QRtEGtWLlqYkEYZ7imEnNCjreQcrknkw&oe=6AEF429D"}, {"file_name": "screen_2560x1440_2020-09-17_22-43-52.png", "id": "429953335104667", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974714_429953338438000_1630301928601733580_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f-_qj1N7cvQQ7kNvwG-e2Gv&_nc_oc=Adp4AvtVW7_0O92WqdIhEd3da0CN3xGIWNKGCC__8iodbaRd6QnQoz14GvypjpWcaDE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRoZiwczrkjTnJ9XVmsUxEDftrh6mQmOzLa7Nejazp65w&oe=6AEF3DC2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screen_2560x1440_2020-09-17_22-47-51.png", "id": "230829075192600", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974887_230829078525933_560344683498926700_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M5Hm2gJf2_0Q7kNvwF8dIyW&_nc_oc=AdoQ8xg64zVMA1ndlTJFMTU9h9I3aopC5dGTQFb1SfjRSHsGbVdH-OVSae24FrXUDM0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTvbNIy3gQ4smgwscOQrJi1t3gEIM3ArffDJryZQGCvQg&oe=6AEF55FF"}, "display_name": "War Yards Beta", "keywords": [], "long_description": "War Yards is a 1v1 multiplayer shooter that approaches bullet time combat in a whole new way. The game utilizes a unique set of mechanics that allow each player to control the speed of their opponent\u2019s projectiles. Bullet time mode can be activated at any time, but while active it restricts the player to room-scale movement only and removes their ability to reload. These mechanics create an unparalleled combat experience that seamlessly blends fast paced action with tense strategy. War Yards combines these innovative gameplay systems with incredibly detailed stylized maps to make for a truly unforgettable VR western adventure.\n\nFeatures:\n- Challenge your friends to intense and highly strategic 1v1 duels.\n- Utilize incredibly unique multiplayer bullet time mechanics to outsmart your opponent.\n- Explore 4 highly detailed stylized maps inspired by classic western settings.\n- Enjoy the freedom of playing with users across nearly all VR platforms.", "short_description": "Step into the shoes of a legendary gunslinger and experience a new kind of VR multiplayer combat. War Yards utilizes a set of unique gameplay systems to seamlessly bring bullet time mechanics to multiplayer matches."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.iubenda.com/privacy-policy/24673521/legal", "developer_terms_of_service_url": null, "publisher_name": "Pixel Framers LLC", "support_website_url": null, "website_url": "https://www.waryards.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "con
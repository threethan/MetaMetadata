-09-17_22-40-30.png", "id": "275494520588765", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39036704_275494523922098_2426874895962552879_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P4koD2lZeGIQ7kNvwFEuDhn&_nc_oc=Adpl_AxT1SVRvJxh0iYkIjDpLoc80yYTJ6pIkCxT7W-PFCgv7SjhFuqJ7sLs2Zxm_5s&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOX9y26cgoziDFGCeHzXIkrc3qhwVEoU7mxHw5W9-6bEw&oe=6AE61342"}, {"file_name": "screen_2560x1440_2020-09-17_22-46-29.png", "id": "238990151157199", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38984447_238990154490532_767541046175693257_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E0jvmZz4UhIQ7kNvwGWuuwP&_nc_oc=Adq4GbbroawsB4evphpruV7s4eMWfVf8iaCSWfRzWpSCTnfFMeOVaL8rYekiCE5vrKI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMPmFgDTwICOmZ3nHjRSYFK4GG54X5udOP-TJlP9-059w&oe=6AE60130"}, {"file_name": "screen_2560x1440_2020-09-17_22-45-52.png", "id": "153148369974995", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974693_153148373308328_3846551554399346998_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0GlnFB2JR90Q7kNvwE5bDHw&_nc_oc=Adp8iDx-TrwDlsut1UK9qEhC1yynuSeoqt9dfqkg3fSvGN6J9mNG4MsjDFrJewZv9Ck&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM16XNNwEXgqDu0QcXUilHeCmpJzSBAGXjTLIJf6DGmrA&oe=6AE6081D"}, {"file_name": "screen_2560x1440_2020-09-17_22-43-52.png", "id": "429953335104667", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974714_429953338438000_1630301928601733580_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P7owCmk7k74Q7kNvwH5gJYV&_nc_oc=Ado2fBR75Lo1jQCSdtdpTs_pP276pu-HwGPB1plcb11oGIbic6pf0fHzO9q06rjnues&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOYRun3wiAtrt6edC-yPLBSz1ILDDg3XIQCDnIOhHH57A&oe=6AE60342"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screen_2560x1440_2020-09-17_22-47-51.png", "id": "230829075192600", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974887_230829078525933_560344683498926700_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ei585A40QjEQ7kNvwE19b-e&_nc_oc=AdqxJeedCAYuj1WXwZSfApILVGvoJ8fEVGaYvg1P4_CcLidnNYF4oLhQ5RMpQ8-QnSo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP0mCgA1AlqQr73x6vtFq6GGhPfzRLhfuaZinNMwsf04Q&oe=6AE5E33F"}, "display_name": "War Yards Beta", "keywords": [], "long_description": "War Yards is a 1v1 multiplayer shooter that approaches bullet time combat in a whole new way. The game utilizes a unique set of mechanics that allow each player to control the speed of their opponent\u2019s projectiles. Bullet time mode can be activated at any time, but while active it restricts the player to room-scale movement only and removes their ability to reload. These mechanics create an unparalleled combat experience that seamlessly blends fast paced action with tense strategy. War Yards combines these innovative gameplay systems with incredibly detailed stylized maps to make for a truly unforgettable VR western adventure.\n\nFeatures:\n- Challenge your friends to intense and highly strategic 1v1 duels.\n- Utilize incredibly unique multiplayer bullet time mechanics to outsmart your opponent.\n- Explore 4 highly detailed stylized maps inspired by classic western settings.\n- Enjoy the freedom of playing with users across nearly all VR platforms.", "short_description": "Step into the shoes of a legendary gunslinger and experience a new kind of VR multiplayer combat. War Yards utilizes a set of unique gameplay systems to seamlessly bring bullet time mechanics to multiplayer matches."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.iubenda.com/privacy-policy/24673521/legal", "developer_terms_of_service_url": null, "publisher_name": "Pixel Framers LLC", "support_website_url": null, "website_url": "https://www.waryards.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "con
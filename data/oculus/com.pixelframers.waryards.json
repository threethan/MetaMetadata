-09-17_22-40-30.png", "id": "275494520588765", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39036704_275494523922098_2426874895962552879_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=80kwqolQBRMQ7kNvwHFa2hV&_nc_oc=AdpWi8jMpDkGDg9bPS-UOgqeqxryCitw5NBHO2xsWBVwrb55_Vmb-fKZ9GpwjYlBRf0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIjOgOA8D4wDsMPitIVgg6anWlzSSa7KuOPDxPw4yEK-g&oe=6AA54182"}, {"file_name": "screen_2560x1440_2020-09-17_22-46-29.png", "id": "238990151157199", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38984447_238990154490532_767541046175693257_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=htTz0Ffo0f0Q7kNvwH8m1F2&_nc_oc=AdrK-BkCFW17srTg9YT_RnWD3-f6Rr5JIUS7tf3MbYAWZKoQT9HRfHtK_l7Xx4hv5k8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKsy6_WQXRCG3U7UfMe81lass5odsG595OtJtaB4l-7LQ&oe=6AA567B0"}, {"file_name": "screen_2560x1440_2020-09-17_22-45-52.png", "id": "153148369974995", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974693_153148373308328_3846551554399346998_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nA8mIXf9HykQ7kNvwHU1wol&_nc_oc=AdpjXj2fOSQlaFGNyrXNbhr7JiHyfQ0zE7TXEJ4AdvDyxgZhjhCL6BZhiWcwf7324UI&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJH2nMiiOO1i4KSTI8Cwv_-o7zWokYSa3poaWfVDD-Y0A&oe=6AA56E9D"}, {"file_name": "screen_2560x1440_2020-09-17_22-43-52.png", "id": "429953335104667", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974714_429953338438000_1630301928601733580_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BNEHAkS1AJQQ7kNvwHU3dCf&_nc_oc=Ado6e2OqoESFtodMUZ6rDkh4_rSicv_Crw3bP0oNCX-My93NvyQspUHwS89w2R140cQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIBU_Hu9hyk6foteApQt_ibS9IByrbqdBcbYxKVAlotbg&oe=6AA569C2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screen_2560x1440_2020-09-17_22-47-51.png", "id": "230829075192600", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974887_230829078525933_560344683498926700_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-k23AkZrzmMQ7kNvwHzupqb&_nc_oc=AdqZdGBNJmpmwn9ETBOQuos52n48wbqaOj5OUl_vffQBCCSPGRTEp8eQYzOx0eoTkFA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL6S47STPv29qrjXFggiQELSKliFs6Nci4Uv08ibxqYtw&oe=6AA549BF"}, "display_name": "War Yards Beta", "keywords": [], "long_description": "War Yards is a 1v1 multiplayer shooter that approaches bullet time combat in a whole new way. The game utilizes a unique set of mechanics that allow each player to control the speed of their opponent\u2019s projectiles. Bullet time mode can be activated at any time, but while active it restricts the player to room-scale movement only and removes their ability to reload. These mechanics create an unparalleled combat experience that seamlessly blends fast paced action with tense strategy. War Yards combines these innovative gameplay systems with incredibly detailed stylized maps to make for a truly unforgettable VR western adventure.\n\nFeatures:\n- Challenge your friends to intense and highly strategic 1v1 duels.\n- Utilize incredibly unique multiplayer bullet time mechanics to outsmart your opponent.\n- Explore 4 highly detailed stylized maps inspired by classic western settings.\n- Enjoy the freedom of playing with users across nearly all VR platforms.", "short_description": "Step into the shoes of a legendary gunslinger and experience a new kind of VR multiplayer combat. War Yards utilizes a set of unique gameplay systems to seamlessly bring bullet time mechanics to multiplayer matches."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.iubenda.com/privacy-policy/24673521/legal", "developer_terms_of_service_url": null, "publisher_name": "Pixel Framers LLC", "support_website_url": null, "website_url": "https://www.waryards.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "con
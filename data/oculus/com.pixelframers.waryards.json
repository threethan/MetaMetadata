-09-17_22-40-30.png", "id": "275494520588765", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39036704_275494523922098_2426874895962552879_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lyQdvpxPpD0Q7kNvwH-30PT&_nc_oc=Adq5QhtQZbb7yMplLCuXvTfKrUrFdDenf-vlUivdYbYOoWUSNXlWGfGWTDUou8K4ANU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1_48RMWPopM740tqEbRBf-xhIivY0pRdYERHWa1PYKyA&oe=69DB8C02"}, {"file_name": "screen_2560x1440_2020-09-17_22-46-29.png", "id": "238990151157199", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38984447_238990154490532_767541046175693257_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YqP8YsqcJ90Q7kNvwHlPx-F&_nc_oc=AdqKqbvTx-pBcJy-tVHQlez4GdcMGYHpZu1YG8pLNji5UfDDFRQ9tp_Iw1gRGZLrx9U&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af36tHel8nSr_zWO5y2Y4ysIUHGxGOEmo89p5tgXb72Khg&oe=69DBB230"}, {"file_name": "screen_2560x1440_2020-09-17_22-45-52.png", "id": "153148369974995", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974693_153148373308328_3846551554399346998_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BbWgKPqlcW4Q7kNvwHysDpg&_nc_oc=AdrCeCjLEM-8oconPtw0h24zV4GVWkpJIdwFiTKvofNs1TEefcHMZmSIlrSSoBNy9aw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1TSZGN_Vwp6UCsSEUyQ3gh8zKDX80kaz4Xqe7K7r9R2A&oe=69DB80DD"}, {"file_name": "screen_2560x1440_2020-09-17_22-43-52.png", "id": "429953335104667", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974714_429953338438000_1630301928601733580_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=t-1TRHxexw8Q7kNvwHx0eh-&_nc_oc=AdolyreBEM11hIf61agFgmsD-FQWLEnY5Kj7OuW4ZUr7oCukXLW6W8XA1IBT0z_S46E&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af25oLBQWNl5B8kesxExFqt5w30jmQg1gJHvPxyZAAWY9A&oe=69DB7C02"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screen_2560x1440_2020-09-17_22-47-51.png", "id": "230829075192600", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974887_230829078525933_560344683498926700_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CO5ld2dmAc4Q7kNvwGWQKH8&_nc_oc=Adr2JSq2t6s4P700FaPH-401I5AP334-oZ6JK1VeuFqPJtBbT-VfclohMhQa8xr8Rdw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0q2fGKw7bZUh8ZOnsOunmdyFYTBuGRqDVpjd1ZRdPAww&oe=69DB943F"}, "display_name": "War Yards Beta", "keywords": [], "long_description": "War Yards is a 1v1 multiplayer shooter that approaches bullet time combat in a whole new way. The game utilizes a unique set of mechanics that allow each player to control the speed of their opponent\u2019s projectiles. Bullet time mode can be activated at any time, but while active it restricts the player to room-scale movement only and removes their ability to reload. These mechanics create an unparalleled combat experience that seamlessly blends fast paced action with tense strategy. War Yards combines these innovative gameplay systems with incredibly detailed stylized maps to make for a truly unforgettable VR western adventure.\n\nFeatures:\n- Challenge your friends to intense and highly strategic 1v1 duels.\n- Utilize incredibly unique multiplayer bullet time mechanics to outsmart your opponent.\n- Explore 4 highly detailed stylized maps inspired by classic western settings.\n- Enjoy the freedom of playing with users across nearly all VR platforms.", "short_description": "Step into the shoes of a legendary gunslinger and experience a new kind of VR multiplayer combat. War Yards utilizes a set of unique gameplay systems to seamlessly bring bullet time mechanics to multiplayer matches."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.iubenda.com/privacy-policy/24673521/legal", "developer_terms_of_service_url": null, "publisher_name": "Pixel Framers LLC", "support_website_url": null, "website_url": "https://www.waryards.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "con
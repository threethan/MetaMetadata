-09-17_22-40-30.png", "id": "275494520588765", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39036704_275494523922098_2426874895962552879_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KBlxSu7hUy0Q7kNvwFwayl0&_nc_oc=Adpp19E-h8MtwCY2Ksa23-acmZPDU7lE5hM93xhBTzlhzVpflty3bO7n27MNKM7LQfA&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6EBU2JQNQEWf7DqNzLrrg9lZVRkDV7w8JPBveu46m58w&oe=6A01C782"}, {"file_name": "screen_2560x1440_2020-09-17_22-46-29.png", "id": "238990151157199", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38984447_238990154490532_767541046175693257_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vnky81D8jEMQ7kNvwG0seM6&_nc_oc=AdrAWs6N0Yxi0XwMDVawkhR2-JI5WwLJrqvnVRvv02T4M6LzXlUYHNwV-yd6uhwUdsI&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5Nk7-CINp2CTFI8Eyi8MDYqYHfW67ISS_nc0LigBi_3Q&oe=6A01EDB0"}, {"file_name": "screen_2560x1440_2020-09-17_22-45-52.png", "id": "153148369974995", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974693_153148373308328_3846551554399346998_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6owXVpNGiw0Q7kNvwEzkL4L&_nc_oc=AdqmG4jmbC-1GFPqm6iKotFjoZwuG79oOY-iRsGEjIFM8aFjZh5sl62rHU_gf5vq04Y&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7IR36D0LEoMHc2DPOWR2PdMtJVCiCoLGbQmsRl8uJo5A&oe=6A01F49D"}, {"file_name": "screen_2560x1440_2020-09-17_22-43-52.png", "id": "429953335104667", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974714_429953338438000_1630301928601733580_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JDkvTuCBzxcQ7kNvwF1elFl&_nc_oc=AdqgPH_5k8L4K0dF28cTq7kHzsytUUa3WDyN8otBLvipYKbRJYIq1YLdbzLH4e9m08E&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6duknFT2h0N3Dcc_OH7HD2SF5bBHqiYbl1jV-H4ULZ0w&oe=6A01EFC2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screen_2560x1440_2020-09-17_22-47-51.png", "id": "230829075192600", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974887_230829078525933_560344683498926700_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RvqDNT1q8lwQ7kNvwFsvCPb&_nc_oc=AdowcfxnWTnkOFvlnb2b_wZ5D4t_ifBIt5QVXLS8S2Cb4E7uDZgbk6HuLcLwV4_y1sI&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6XIBr5TiCBoUCkS88eIrI_4XjLiNO2TUjJD6F9wUSgKA&oe=6A01CFBF"}, "display_name": "War Yards Beta", "keywords": [], "long_description": "War Yards is a 1v1 multiplayer shooter that approaches bullet time combat in a whole new way. The game utilizes a unique set of mechanics that allow each player to control the speed of their opponent\u2019s projectiles. Bullet time mode can be activated at any time, but while active it restricts the player to room-scale movement only and removes their ability to reload. These mechanics create an unparalleled combat experience that seamlessly blends fast paced action with tense strategy. War Yards combines these innovative gameplay systems with incredibly detailed stylized maps to make for a truly unforgettable VR western adventure.\n\nFeatures:\n- Challenge your friends to intense and highly strategic 1v1 duels.\n- Utilize incredibly unique multiplayer bullet time mechanics to outsmart your opponent.\n- Explore 4 highly detailed stylized maps inspired by classic western settings.\n- Enjoy the freedom of playing with users across nearly all VR platforms.", "short_description": "Step into the shoes of a legendary gunslinger and experience a new kind of VR multiplayer combat. War Yards utilizes a set of unique gameplay systems to seamlessly bring bullet time mechanics to multiplayer matches."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.iubenda.com/privacy-policy/24673521/legal", "developer_terms_of_service_url": null, "publisher_name": "Pixel Framers LLC", "support_website_url": null, "website_url": "https://www.waryards.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "con
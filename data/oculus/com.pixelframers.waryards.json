-09-17_22-40-30.png", "id": "275494520588765", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39036704_275494523922098_2426874895962552879_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JTSLtlJgCzwQ7kNvwETIra9&_nc_oc=Adr5VFPIDBYAaQBPSCE5wXhOMpSrIouB65ojOQLZh3vzIhKso17HUaRPLgzU72Y09Q8&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4kn1nwd5GYpMrtBom7qCIPbV4HOezcvFMRGR7Lk4k0_Q&oe=6A16DF82"}, {"file_name": "screen_2560x1440_2020-09-17_22-46-29.png", "id": "238990151157199", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38984447_238990154490532_767541046175693257_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RthV-JiRPLoQ7kNvwEyNTuQ&_nc_oc=AdoWci0fP5d2UXZ3TyO6MUqnQstR9N0x8BTjMGnCc6hdcerhkfAjXwgKdwwXf_CjD-4&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5NTA3BrmEVk8nVMTcXMMV_8ylSt7m5Qm6gEubNBVUEqg&oe=6A1705B0"}, {"file_name": "screen_2560x1440_2020-09-17_22-45-52.png", "id": "153148369974995", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974693_153148373308328_3846551554399346998_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7wCTAVMvwIMQ7kNvwELPwf_&_nc_oc=AdosvAPM4xzOFXDTAjdH8DwZzfNmZFD_Ykk3h7xZcEztOpVo1dMBElVIRgs-l7WxRJE&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4JQn5VFaNejyu8SyuAWAIW5ohLIb4sggGlM8ZKN0wkIw&oe=6A170C9D"}, {"file_name": "screen_2560x1440_2020-09-17_22-43-52.png", "id": "429953335104667", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974714_429953338438000_1630301928601733580_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pU6LKvfA3aAQ7kNvwHPDiSv&_nc_oc=AdpBor2DiaGUYMvguSKiQjH9Lk7OkQnrQZSBtVaqii7NZ3jrlM0XDUnC146NaOC7TNU&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5nyPbjtAoa47REa7MoxZLZrPCSZRe1gOyBCj6dGFJaXg&oe=6A1707C2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screen_2560x1440_2020-09-17_22-47-51.png", "id": "230829075192600", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974887_230829078525933_560344683498926700_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qRjvq7XAdp0Q7kNvwEBUvk9&_nc_oc=Adqbh5jjhSJSLqfzlYzyKzrwuZpqOL7jK2ieRUCQ009VP19rMBCWOYGxrXLNrWZKv3g&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5eIT2MYZtGO-2Rkr8ZCQ1ypQTAy9DtIEk2wlUXxhe-7w&oe=6A16E7BF"}, "display_name": "War Yards Beta", "keywords": [], "long_description": "War Yards is a 1v1 multiplayer shooter that approaches bullet time combat in a whole new way. The game utilizes a unique set of mechanics that allow each player to control the speed of their opponent\u2019s projectiles. Bullet time mode can be activated at any time, but while active it restricts the player to room-scale movement only and removes their ability to reload. These mechanics create an unparalleled combat experience that seamlessly blends fast paced action with tense strategy. War Yards combines these innovative gameplay systems with incredibly detailed stylized maps to make for a truly unforgettable VR western adventure.\n\nFeatures:\n- Challenge your friends to intense and highly strategic 1v1 duels.\n- Utilize incredibly unique multiplayer bullet time mechanics to outsmart your opponent.\n- Explore 4 highly detailed stylized maps inspired by classic western settings.\n- Enjoy the freedom of playing with users across nearly all VR platforms.", "short_description": "Step into the shoes of a legendary gunslinger and experience a new kind of VR multiplayer combat. War Yards utilizes a set of unique gameplay systems to seamlessly bring bullet time mechanics to multiplayer matches."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.iubenda.com/privacy-policy/24673521/legal", "developer_terms_of_service_url": null, "publisher_name": "Pixel Framers LLC", "support_website_url": null, "website_url": "https://www.waryards.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "con
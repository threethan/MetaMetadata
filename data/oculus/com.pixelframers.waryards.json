fiz24-4Ww9OGA&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_Afuy1aQP4VNYvfsShAjw0_n-ia8FErWhTQyCXV5-GqrleA&oe=699C4402"}, {"file_name": "screen_2560x1440_2020-09-17_22-46-29.png", "id": "238990151157199", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38984447_238990154490532_767541046175693257_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2MX-72c3sjQQ7kNvwFa0ors&_nc_oc=AdkIqVypa2FAyBfDUdEtHv3ItpCkJLp_CY2Eru08eWpoY2YrOacd4jDvuKYYQ2LoozE&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_Afsdzk3cnbHRuEhe-9HtfX5JP-grYTPqbHMIHP1NYxqVsQ&oe=699C31F0"}, {"file_name": "screen_2560x1440_2020-09-17_22-45-52.png", "id": "153148369974995", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974693_153148373308328_3846551554399346998_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WQn_mXiG9EAQ7kNvwHNslIf&_nc_oc=AdmpTkhU4liNAQja-R3JFMyPXUdYQqOrhOFM-VFJqN7Yx3VjAzweYmeHwHFmL_G1AsE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AfsVWk2Pqm6piK7EjTV8p1UuZkgNBVSMbZaPrZ9btIEHgA&oe=699C38DD"}, {"file_name": "screen_2560x1440_2020-09-17_22-43-52.png", "id": "429953335104667", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974714_429953338438000_1630301928601733580_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Kfe_Qqq0OGUQ7kNvwHu48IX&_nc_oc=AdkaQdRy_gUj6SI4L9B90krOcqSVn7-J8-779ieFBa4lEBzys61fRGzvCgpnJX93jPE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AfugDrytacLNi_nVi8YpSgixPuk7PW2SlMfSxei2sdsY_w&oe=699C3402"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screen_2560x1440_2020-09-17_22-47-51.png", "id": "230829075192600", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974887_230829078525933_560344683498926700_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qAEt_xcBrb4Q7kNvwGUK4OA&_nc_oc=AdnhnsGrYkEt-o3QZo2gYKKfOOOVvMvRr47UU0_fUZWp14FieJUvi4FrHqDBGytv2zg&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_Afv_8JmqeziB3WC2XpUFZ_ax-A1KfQR_tebwttECD8AS9Q&oe=699C4C3F"}, "display_name": "War Yards Beta", "keywords": [], "long_description": "War Yards is a 1v1 multiplayer shooter that approaches bullet time combat in a whole new way. The game utilizes a unique set of mechanics that allow each player to control the speed of their opponent\u2019s projectiles. Bullet time mode can be activated at any time, but while active it restricts the player to room-scale movement only and removes their ability to reload. These mechanics create an unparalleled combat experience that seamlessly blends fast paced action with tense strategy. War Yards combines these innovative gameplay systems with incredibly detailed stylized maps to make for a truly unforgettable VR western adventure.\n\nFeatures:\n- Challenge your friends to intense and highly strategic 1v1 duels.\n- Utilize incredibly unique multiplayer bullet time mechanics to outsmart your opponent.\n- Explore 4 highly detailed stylized maps inspired by classic western settings.\n- Enjoy the freedom of playing with users across nearly all VR platforms.", "short_description": "Step into the shoes of a legendary gunslinger and experience a new kind of VR multiplayer combat. War Yards utilizes a set of unique gameplay systems to seamlessly bring bullet time mechanics to multiplayer matches."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.iubenda.com/privacy-policy/24673521/legal", "developer_terms_of_service_url": null, "publisher_name": "Pixel Framers LLC", "support_website_url": null, "website_url": "https://www.waryards.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ARCADE", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_i
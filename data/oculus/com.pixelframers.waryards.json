Now54ORgWxFYw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfutW4JFX9YfW62tKysvBcG7Tp2a2f0czSXCxKRx-mvVdQ&oe=69A03882"}, {"file_name": "screen_2560x1440_2020-09-17_22-46-29.png", "id": "238990151157199", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38984447_238990154490532_767541046175693257_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CJovt0Pd-yEQ7kNvwEfxdFR&_nc_oc=AdlfjF30FFV6lJyFIHYuVXXJTfSB0BFAXEKGnR7njCguRPru8lOjluB50q6ji_iXkNs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afvmb8mrgefj2TaieU_RVpBHn3UUJ_opfJzAzbNxvdG7gQ&oe=69A02670"}, {"file_name": "screen_2560x1440_2020-09-17_22-45-52.png", "id": "153148369974995", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974693_153148373308328_3846551554399346998_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oE5HsDDIJuoQ7kNvwHqoakS&_nc_oc=Adnfhiwp7DB3ks7FiEeeTKRrF3rv8lSi07lhDGua7u-1Nil_5VZUHL_-vw-DhLvVNzM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Afv0NMVi1G98XrON_jH7DtVk8M_tOGsnwv_L7gnQ0uGlBg&oe=69A02D5D"}, {"file_name": "screen_2560x1440_2020-09-17_22-43-52.png", "id": "429953335104667", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974714_429953338438000_1630301928601733580_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qG7CyG_DNB0Q7kNvwHq-KBU&_nc_oc=Admpu0aoduKWZT5FmQlPYbYLRm_6YLkX6M9mSTLXggOUqJfJKfTxYhvKOQZxQnfKDq0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfvCpXF5os3oouhrXoUNdtLPUEbABqkD28bDAABWMCFB5A&oe=69A02882"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screen_2560x1440_2020-09-17_22-47-51.png", "id": "230829075192600", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974887_230829078525933_560344683498926700_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-x1QC6eE-ocQ7kNvwHjQy8g&_nc_oc=Adk9Eq-aePCWkCfYAAVVgLSTMyPSnKcP-rarNOL14paLRDtxuieuxh7IKM1QKRCmFRQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfuAxt3gDcMkXQkyYhJKZiZe4hLZmX5_yJGA7rv2opRybA&oe=69A040BF"}, "display_name": "War Yards Beta", "keywords": [], "long_description": "War Yards is a 1v1 multiplayer shooter that approaches bullet time combat in a whole new way. The game utilizes a unique set of mechanics that allow each player to control the speed of their opponent\u2019s projectiles. Bullet time mode can be activated at any time, but while active it restricts the player to room-scale movement only and removes their ability to reload. These mechanics create an unparalleled combat experience that seamlessly blends fast paced action with tense strategy. War Yards combines these innovative gameplay systems with incredibly detailed stylized maps to make for a truly unforgettable VR western adventure.\n\nFeatures:\n- Challenge your friends to intense and highly strategic 1v1 duels.\n- Utilize incredibly unique multiplayer bullet time mechanics to outsmart your opponent.\n- Explore 4 highly detailed stylized maps inspired by classic western settings.\n- Enjoy the freedom of playing with users across nearly all VR platforms.", "short_description": "Step into the shoes of a legendary gunslinger and experience a new kind of VR multiplayer combat. War Yards utilizes a set of unique gameplay systems to seamlessly bring bullet time mechanics to multiplayer matches."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.iubenda.com/privacy-policy/24673521/legal", "developer_terms_of_service_url": null, "publisher_name": "Pixel Framers LLC", "support_website_url": null, "website_url": "https://www.waryards.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ARCADE", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_i
-09-17_22-40-30.png", "id": "275494520588765", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39036704_275494523922098_2426874895962552879_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v2chZqdvQ9kQ7kNvwEeas6q&_nc_oc=AdpRC9hNC1JiWrgLueDCPmF2RoPkOQTogGVbEMT_q_8suM8RgauhfzPmEfmPO-JqVPY&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFMqXzQkd80a7c-RY69JYNZYMrzDyzOb8UipqedQrBNtQ&oe=6A902982"}, {"file_name": "screen_2560x1440_2020-09-17_22-46-29.png", "id": "238990151157199", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38984447_238990154490532_767541046175693257_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hq2wU4jrJgcQ7kNvwFiYT3t&_nc_oc=Adqt4e2w8eORUMWsS7-COlaklRDWmufl3Qr5Z86FnQq0PG671Q_rGatRrWBmuAlpNew&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHzlX42rR7sGWwKYZaj-jm4wDHkveeHj374GiRGm7UYhQ&oe=6A901770"}, {"file_name": "screen_2560x1440_2020-09-17_22-45-52.png", "id": "153148369974995", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974693_153148373308328_3846551554399346998_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N7GpYf5JRy8Q7kNvwH25tDC&_nc_oc=AdorpXN9Mv8vtwCIT-7BY-NEmXwjM77NJvBAZFNygEhE_LfqJSiZ4sPBoRW0XisBQ-A&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHy7jdB4xkbKy32elTKz8n5CEe93APwTSGB_DcWc0sk5A&oe=6A901E5D"}, {"file_name": "screen_2560x1440_2020-09-17_22-43-52.png", "id": "429953335104667", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974714_429953338438000_1630301928601733580_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nCfPoG-P6eMQ7kNvwHWDWFI&_nc_oc=AdptwWuu4e8MTIIWYHmb12c7BqLqnseHuQiFV7PPRqav3si0QfN6c3qGg74RkST3BnU&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGPEYWj0qmkw8PkrBZ-XRDx_e2WBZauZcpgDPJcdiP9vw&oe=6A901982"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screen_2560x1440_2020-09-17_22-47-51.png", "id": "230829075192600", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38974887_230829078525933_560344683498926700_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IvYeV9hmI8AQ7kNvwGiBvBJ&_nc_oc=AdqBQhahKRcI5SuZlpSI0oqPD-c9huc95pKVrAHRW2JlWFeXH-s8-Z6oFcuzt9FRw98&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHuss5gmE25IKvYAUW_yxTaw9ByzpwxeOkncCg8grJ6-g&oe=6A9031BF"}, "display_name": "War Yards Beta", "keywords": [], "long_description": "War Yards is a 1v1 multiplayer shooter that approaches bullet time combat in a whole new way. The game utilizes a unique set of mechanics that allow each player to control the speed of their opponent\u2019s projectiles. Bullet time mode can be activated at any time, but while active it restricts the player to room-scale movement only and removes their ability to reload. These mechanics create an unparalleled combat experience that seamlessly blends fast paced action with tense strategy. War Yards combines these innovative gameplay systems with incredibly detailed stylized maps to make for a truly unforgettable VR western adventure.\n\nFeatures:\n- Challenge your friends to intense and highly strategic 1v1 duels.\n- Utilize incredibly unique multiplayer bullet time mechanics to outsmart your opponent.\n- Explore 4 highly detailed stylized maps inspired by classic western settings.\n- Enjoy the freedom of playing with users across nearly all VR platforms.", "short_description": "Step into the shoes of a legendary gunslinger and experience a new kind of VR multiplayer combat. War Yards utilizes a set of unique gameplay systems to seamlessly bring bullet time mechanics to multiplayer matches."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.iubenda.com/privacy-policy/24673521/legal", "developer_terms_of_service_url": null, "publisher_name": "Pixel Framers LLC", "support_website_url": null, "website_url": "https://www.waryards.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "con
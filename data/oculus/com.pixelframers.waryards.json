-09-17_22-40-30.png", "id": "275494520588765", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39036704_275494523922098_2426874895962552879_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JTSLtlJgCzwQ7kNvwF4Mewb&_nc_oc=AdpcjzDjp9q8KymhF2VbjuFCqaFPjN397nWs2ldYxcw9PlZrrcFJ0cLqf3yzuWA-bRw&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4zxGHu64ps6AawnEOrXf47QadwjueAN7oqU19ao5zwKg&oe=6A1474C2"}, {"file_name": "screen_2560x1440_2020-09-17_22-46-29.png", "id": "238990151157199", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38984447_238990154490532_767541046175693257_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RthV-JiRPLoQ7kNvwHN0s_Z&_nc_oc=AdokEfColiks19mp3Puwoq6KQdLdkuTSnaYO-z0CGQLVesi0hNauF6AQ3qNs4QP0BCU&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5aFkkH69n9HVLNgyQM9gG4S4ogoeiF0WGGtLPc_cdaZQ&oe=6A1462B0"}, {"file_name": "screen_2560x1440_2020-09-17_22-45-52.png", "id": "153148369974995", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974693_153148373308328_3846551554399346998_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MST9SKH52XgQ7kNvwE7GSnf&_nc_oc=Adpnl55OFm8PxDHoPns1ny-cRrLZQXlyY6Fbui0wS0p_YS_w-fqOd1h0eWymlm3HUZQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6nxGy5RbOq7uXk5PCIqF-BzdypdBAjvNdWNpEQbb-zSg&oe=6A14699D"}, {"file_name": "screen_2560x1440_2020-09-17_22-43-52.png", "id": "429953335104667", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974714_429953338438000_1630301928601733580_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pU6LKvfA3aAQ7kNvwGZLh1E&_nc_oc=AdolzopNfAKXqFpRP1sYyFS1HWHQzLTDqHhi5JWBKoKipaqBfosGNgrvjdZM31iQ0Oo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5GEj_0LT2uyWA1-A6ZwQpQZAGvbGD7xf_hW1TF_z8AkA&oe=6A1464C2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screen_2560x1440_2020-09-17_22-47-51.png", "id": "230829075192600", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974887_230829078525933_560344683498926700_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qRjvq7XAdp0Q7kNvwF-GUAo&_nc_oc=AdqenJC8QYvQQx2MwKv1dO9AiuyvpKm30jKXim651rUwq6_2fdgy5pufQRcdy0glrRc&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6AsxAWCi1s2gs1EFD4rEfbdWEabvBv7RF7RaMmSTCj5w&oe=6A1444BF"}, "display_name": "War Yards Beta", "keywords": [], "long_description": "War Yards is a 1v1 multiplayer shooter that approaches bullet time combat in a whole new way. The game utilizes a unique set of mechanics that allow each player to control the speed of their opponent\u2019s projectiles. Bullet time mode can be activated at any time, but while active it restricts the player to room-scale movement only and removes their ability to reload. These mechanics create an unparalleled combat experience that seamlessly blends fast paced action with tense strategy. War Yards combines these innovative gameplay systems with incredibly detailed stylized maps to make for a truly unforgettable VR western adventure.\n\nFeatures:\n- Challenge your friends to intense and highly strategic 1v1 duels.\n- Utilize incredibly unique multiplayer bullet time mechanics to outsmart your opponent.\n- Explore 4 highly detailed stylized maps inspired by classic western settings.\n- Enjoy the freedom of playing with users across nearly all VR platforms.", "short_description": "Step into the shoes of a legendary gunslinger and experience a new kind of VR multiplayer combat. War Yards utilizes a set of unique gameplay systems to seamlessly bring bullet time mechanics to multiplayer matches."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.iubenda.com/privacy-policy/24673521/legal", "developer_terms_of_service_url": null, "publisher_name": "Pixel Framers LLC", "support_website_url": null, "website_url": "https://www.waryards.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "con
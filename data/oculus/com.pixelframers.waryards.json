-09-17_22-40-30.png", "id": "275494520588765", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39036704_275494523922098_2426874895962552879_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-G4vhQwBBhEQ7kNvwECuHhd&_nc_oc=AdqKm_bwtKqA_bvl2YEMLf11BFI1yprSt2wx__dciQtf2gOk-ljSZq5Ufvir1wyP2rk&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCm97pzi7DTeqtm1jB7OyEFEIIuTLUltd5gvv054c1AwA&oe=6A635682"}, {"file_name": "screen_2560x1440_2020-09-17_22-46-29.png", "id": "238990151157199", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38984447_238990154490532_767541046175693257_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6MTWVEP_wvUQ7kNvwEsdlw1&_nc_oc=AdqbdrayDsacqVHnbJxG27Vr_aDubkatKczCzu1c2tFLlrYZfNISleNZ3D8h_lAmMI0&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAzDHyemsH6AvHqeRe2rM0XEFWqDlWDA5bX3Hf4gJsjrw&oe=6A637CB0"}, {"file_name": "screen_2560x1440_2020-09-17_22-45-52.png", "id": "153148369974995", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974693_153148373308328_3846551554399346998_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ii3T6NAd17QQ7kNvwHFirJR&_nc_oc=Adp8fMrvnBoc41SzBRLvGGBJDgaDsLVwJ-Wq-qrbf7143DmpteS6u4IfmvHKMPVb87E&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCw-sXQtCMZfe2mNvWKJ-7n5LE-DOpsNh86LHLxWiGCYg&oe=6A63839D"}, {"file_name": "screen_2560x1440_2020-09-17_22-43-52.png", "id": "429953335104667", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974714_429953338438000_1630301928601733580_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VVdKBH5tyoIQ7kNvwFjw4gn&_nc_oc=AdrIKo6JD-lvAa40upibiw8F2I24tvA6x6yn8yMCQy9_lwL7Duep0aJ2LL_ImLWvM9g&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDHQfiaLpIPFkB4hosIVC75TyPILWnZ-C79Q2W-k6QKDg&oe=6A637EC2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screen_2560x1440_2020-09-17_22-47-51.png", "id": "230829075192600", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974887_230829078525933_560344683498926700_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0g_arhRlObsQ7kNvwEHPYs7&_nc_oc=AdpvyZZOvhDW17X9rOcbsu5wY86BUDsA-sBfUHlm9n-Fpf5iwqOz5JSf2sqf6fSitLY&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDxrcGoam-jhnVHnGxBvzs1tMztEOgFCIUHDbo1hvdtnA&oe=6A635EBF"}, "display_name": "War Yards Beta", "keywords": [], "long_description": "War Yards is a 1v1 multiplayer shooter that approaches bullet time combat in a whole new way. The game utilizes a unique set of mechanics that allow each player to control the speed of their opponent\u2019s projectiles. Bullet time mode can be activated at any time, but while active it restricts the player to room-scale movement only and removes their ability to reload. These mechanics create an unparalleled combat experience that seamlessly blends fast paced action with tense strategy. War Yards combines these innovative gameplay systems with incredibly detailed stylized maps to make for a truly unforgettable VR western adventure.\n\nFeatures:\n- Challenge your friends to intense and highly strategic 1v1 duels.\n- Utilize incredibly unique multiplayer bullet time mechanics to outsmart your opponent.\n- Explore 4 highly detailed stylized maps inspired by classic western settings.\n- Enjoy the freedom of playing with users across nearly all VR platforms.", "short_description": "Step into the shoes of a legendary gunslinger and experience a new kind of VR multiplayer combat. War Yards utilizes a set of unique gameplay systems to seamlessly bring bullet time mechanics to multiplayer matches."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.iubenda.com/privacy-policy/24673521/legal", "developer_terms_of_service_url": null, "publisher_name": "Pixel Framers LLC", "support_website_url": null, "website_url": "https://www.waryards.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "con
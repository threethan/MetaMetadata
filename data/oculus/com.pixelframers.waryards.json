-09-17_22-40-30.png", "id": "275494520588765", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39036704_275494523922098_2426874895962552879_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RhTPLiclny0Q7kNvwGcf6ZL&_nc_oc=Adoav7KhlBZT1uQkusaclsEIzDTWUej-9ARszDmP0aNxXXb5BAfJ8erDoyQw3g3kSLs&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2KZ8UPXFWF2mSYgxdjFFi3g2JHjk9P-MbBc74gHMtfLg&oe=69EB5E02"}, {"file_name": "screen_2560x1440_2020-09-17_22-46-29.png", "id": "238990151157199", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38984447_238990154490532_767541046175693257_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ESnU2nvr9JQQ7kNvwFj3lu8&_nc_oc=Adr7U9_Is4b4isY3BdEhxouyLirCceRZ5FIDPvZME_7bmc1eLoJyWdDlMuqKxjcRQdw&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3WeNFSmrOTQhefSU88lJReTNlp3AmmDOiRX4ecisWTww&oe=69EB8430"}, {"file_name": "screen_2560x1440_2020-09-17_22-45-52.png", "id": "153148369974995", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974693_153148373308328_3846551554399346998_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j6F-QRQ6GCgQ7kNvwF4xkwx&_nc_oc=AdpvTen_Do_Vk-IIjO78W6S6wsf78KpovNVGMSo9OSCL3tJE7x1SknpzF8Gvf3TEYGw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2I0XuKmDC2IR3fAQHmzgb8rCTQyoLthpS7jSdMu6cP2g&oe=69EB8B1D"}, {"file_name": "screen_2560x1440_2020-09-17_22-43-52.png", "id": "429953335104667", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974714_429953338438000_1630301928601733580_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=INc548lhLoAQ7kNvwG27idU&_nc_oc=AdqiUPCJJIcCDZXzU9Tk16PuQATa9n0bHHHmgOD-jwm_42r8bTVPkImRDtEU-yR55Yw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2jWl7OjH6nbmTvc8FkRLjKyZjD2X1lS0fRCJHHhUUfqw&oe=69EB8642"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screen_2560x1440_2020-09-17_22-47-51.png", "id": "230829075192600", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974887_230829078525933_560344683498926700_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W4QRqrIu78kQ7kNvwGnu5Uq&_nc_oc=AdoAAVvYBHTun-KTAUdDkofv6uWaNqc7WcnIrEa2p-L1EhqU0mzfDFvpydfjt_Xz-oc&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2W8nf_USijRjphjtLQOav5e_D2Zh_PmC5vkXpVShwewg&oe=69EB663F"}, "display_name": "War Yards Beta", "keywords": [], "long_description": "War Yards is a 1v1 multiplayer shooter that approaches bullet time combat in a whole new way. The game utilizes a unique set of mechanics that allow each player to control the speed of their opponent\u2019s projectiles. Bullet time mode can be activated at any time, but while active it restricts the player to room-scale movement only and removes their ability to reload. These mechanics create an unparalleled combat experience that seamlessly blends fast paced action with tense strategy. War Yards combines these innovative gameplay systems with incredibly detailed stylized maps to make for a truly unforgettable VR western adventure.\n\nFeatures:\n- Challenge your friends to intense and highly strategic 1v1 duels.\n- Utilize incredibly unique multiplayer bullet time mechanics to outsmart your opponent.\n- Explore 4 highly detailed stylized maps inspired by classic western settings.\n- Enjoy the freedom of playing with users across nearly all VR platforms.", "short_description": "Step into the shoes of a legendary gunslinger and experience a new kind of VR multiplayer combat. War Yards utilizes a set of unique gameplay systems to seamlessly bring bullet time mechanics to multiplayer matches."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.iubenda.com/privacy-policy/24673521/legal", "developer_terms_of_service_url": null, "publisher_name": "Pixel Framers LLC", "support_website_url": null, "website_url": "https://www.waryards.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "con
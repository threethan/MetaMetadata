-09-17_22-40-30.png", "id": "275494520588765", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39036704_275494523922098_2426874895962552879_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iNgtk2r4z8gQ7kNvwGp5kK-&_nc_oc=Adr7ruF6Bf9ank1ZxPIhtjSDBQseLoOEBOVH87LAVpdHFCrcdkQzFdKhyT8oVEXhNgc&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQhNkGdCylo6EPQD-Gie0dU3YvaOrJsbw73wFo1GNlyUQ&oe=6AF09F42"}, {"file_name": "screen_2560x1440_2020-09-17_22-46-29.png", "id": "238990151157199", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38984447_238990154490532_767541046175693257_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LIYUCqAKFesQ7kNvwFSmNvQ&_nc_oc=Adq_i77j0mAl6Gn99gxDLOP2CgaxxYdrMK1cPLjahzNTUEYgBmvF5bbRRdmSHffwYn8&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSV6PuCwYXbwAmDwV5dZg0CqGYRbvMu8xpmltukiKmjfg&oe=6AF08D30"}, {"file_name": "screen_2560x1440_2020-09-17_22-45-52.png", "id": "153148369974995", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974693_153148373308328_3846551554399346998_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2ledQiXfRz4Q7kNvwGoiWS6&_nc_oc=AdqVNPI7JAV-x6OwisRo5-5OtMBff3H9OyqhhRPKFnJOgFyQ5UwIs3Y0DPoo64hnkAE&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRKt84KH6PN_RWoxNsBntH6uPwegzRkHqrsIVs3Lul0Cw&oe=6AF0941D"}, {"file_name": "screen_2560x1440_2020-09-17_22-43-52.png", "id": "429953335104667", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974714_429953338438000_1630301928601733580_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f-_qj1N7cvQQ7kNvwFMrsOl&_nc_oc=Ado-WN0uga5g0j8OE44JrUfjtUBzqqc3vz2oNDmXI-k_9hpuZZGfqC_IRGUag6HrAqY&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRPEt7j9qJMObbeCDDlAyXrI-W7D4wG821afi84edH0hQ&oe=6AF08F42"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screen_2560x1440_2020-09-17_22-47-51.png", "id": "230829075192600", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974887_230829078525933_560344683498926700_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BLez7wAp6i0Q7kNvwF4Uox7&_nc_oc=Adovjoxslz_gr4MJ_MlEthj39nCVIwJ6BTuNzLOdVDRps5fu00pLhq03_GTRTm-f-qA&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRF0t3eMWtTUiyg2Ij2rjicK5OtizlB_nUU6opg3RK_Qg&oe=6AF0A77F"}, "display_name": "War Yards Beta", "keywords": [], "long_description": "War Yards is a 1v1 multiplayer shooter that approaches bullet time combat in a whole new way. The game utilizes a unique set of mechanics that allow each player to control the speed of their opponent\u2019s projectiles. Bullet time mode can be activated at any time, but while active it restricts the player to room-scale movement only and removes their ability to reload. These mechanics create an unparalleled combat experience that seamlessly blends fast paced action with tense strategy. War Yards combines these innovative gameplay systems with incredibly detailed stylized maps to make for a truly unforgettable VR western adventure.\n\nFeatures:\n- Challenge your friends to intense and highly strategic 1v1 duels.\n- Utilize incredibly unique multiplayer bullet time mechanics to outsmart your opponent.\n- Explore 4 highly detailed stylized maps inspired by classic western settings.\n- Enjoy the freedom of playing with users across nearly all VR platforms.", "short_description": "Step into the shoes of a legendary gunslinger and experience a new kind of VR multiplayer combat. War Yards utilizes a set of unique gameplay systems to seamlessly bring bullet time mechanics to multiplayer matches."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.iubenda.com/privacy-policy/24673521/legal", "developer_terms_of_service_url": null, "publisher_name": "Pixel Framers LLC", "support_website_url": null, "website_url": "https://www.waryards.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "con
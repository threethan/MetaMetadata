-09-17_22-40-30.png", "id": "275494520588765", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/39036704_275494523922098_2426874895962552879_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SKHWQvkSTpgQ7kNvwGdLolx&_nc_oc=AdqokqyG1Ak2ptY4WPmSYPLLQUCVKPK6cFzsttNtuCKLbofcNnu20c4cAQ6uQ9iROI8&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC19Z3aYrofOtGPsB_GX60s5qczf25DpKe-bVSYDjoQUg&oe=6A5A1C02"}, {"file_name": "screen_2560x1440_2020-09-17_22-46-29.png", "id": "238990151157199", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38984447_238990154490532_767541046175693257_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PkUor239jCUQ7kNvwG-m9Fq&_nc_oc=AdpyMSCePv1rsZrf31vRWlfARdx9MiehcOv5zOiZPU0ghi-JPiYVjlnXt2YWN5W5et4&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBvv6UEZugCKUR-l5m7DU5sBomPPVV9GNhAexkY79H6Ew&oe=6A5A4230"}, {"file_name": "screen_2560x1440_2020-09-17_22-45-52.png", "id": "153148369974995", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974693_153148373308328_3846551554399346998_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XrvPvt-SiDcQ7kNvwFBQogc&_nc_oc=AdrfoIbUxfX5NKq0r8gLKdlsqMa6oO5DLypfrHHGT2j-manENIF-osasu0Hc0odzek0&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQANBtsQzntXuB5eNYArDb8Y4M2zv-GOULUjZHuztZcsjg&oe=6A5A491D"}, {"file_name": "screen_2560x1440_2020-09-17_22-43-52.png", "id": "429953335104667", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974714_429953338438000_1630301928601733580_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ncyCDk2nSGMQ7kNvwEWH5IW&_nc_oc=Adqiif4CzQd1FbRX7wQhi0dfA6nN3aISj5DOt9R2M3usZSZ9BqzMxZbFq55eCOkKmL0&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB83yGTAOLpjxwvxyi5O3yfvq_I5a1bDbhG8ueBTVjqFg&oe=6A5A4442"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screen_2560x1440_2020-09-17_22-47-51.png", "id": "230829075192600", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974887_230829078525933_560344683498926700_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4sPbInCIQtsQ7kNvwEThq-Q&_nc_oc=AdqC3ny065zc1MbQqPmI0UWgOWB7F4gs2Nj0ShXeX6yTMVj40HTszaLH8k1nmAQ42oQ&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAOQ_RfWM9ever1gYf91jSlqJaLHBj_qozhYFmlYda7-A&oe=6A5A243F"}, "display_name": "War Yards Beta", "keywords": [], "long_description": "War Yards is a 1v1 multiplayer shooter that approaches bullet time combat in a whole new way. The game utilizes a unique set of mechanics that allow each player to control the speed of their opponent\u2019s projectiles. Bullet time mode can be activated at any time, but while active it restricts the player to room-scale movement only and removes their ability to reload. These mechanics create an unparalleled combat experience that seamlessly blends fast paced action with tense strategy. War Yards combines these innovative gameplay systems with incredibly detailed stylized maps to make for a truly unforgettable VR western adventure.\n\nFeatures:\n- Challenge your friends to intense and highly strategic 1v1 duels.\n- Utilize incredibly unique multiplayer bullet time mechanics to outsmart your opponent.\n- Explore 4 highly detailed stylized maps inspired by classic western settings.\n- Enjoy the freedom of playing with users across nearly all VR platforms.", "short_description": "Step into the shoes of a legendary gunslinger and experience a new kind of VR multiplayer combat. War Yards utilizes a set of unique gameplay systems to seamlessly bring bullet time mechanics to multiplayer matches."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.iubenda.com/privacy-policy/24673521/legal", "developer_terms_of_service_url": null, "publisher_name": "Pixel Framers LLC", "support_website_url": null, "website_url": "https://www.waryards.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "con
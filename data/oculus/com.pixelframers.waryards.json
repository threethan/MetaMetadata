-09-17_22-40-30.png", "id": "275494520588765", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39036704_275494523922098_2426874895962552879_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8rhLzt91irsQ7kNvwGM2d_I&_nc_oc=AdrLL6t_oUxhxNON6GKC9k85Iz8DxOyE-aZZSNsO_j5zFx1acQ5m25b8cKBw6-S3Xlk&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKZV8Ataesrq6Wk1Ld2swrOwfgc-g84KLQDw1I0VGQk9A&oe=6A9AEDC2"}, {"file_name": "screen_2560x1440_2020-09-17_22-46-29.png", "id": "238990151157199", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38984447_238990154490532_767541046175693257_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bS9WUZZFbk0Q7kNvwGcPvZz&_nc_oc=AdpuKv9d1hR0mdP7YkG8bN4dCSrggQTGvgYSzCQcNzfQLrarDyZqYAHF6ICn9XbNV5w&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJmhsAql9jMYxX-wcPRLWBLMz4KWK3xA7MtnPJ6t8za6Q&oe=6A9ADBB0"}, {"file_name": "screen_2560x1440_2020-09-17_22-45-52.png", "id": "153148369974995", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974693_153148373308328_3846551554399346998_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dsCjMyiVGlEQ7kNvwFLFAjO&_nc_oc=AdrZ7Nbi0c_8UwrICq1eaX1InOGwouITAPKLA9u8vfIxz4Cw8PGOrPVZx0DEwW6MAy4&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLfvmopajQCODJMpZbf2S1pal0wKgyUTvbkpe5_NKbjdg&oe=6A9AE29D"}, {"file_name": "screen_2560x1440_2020-09-17_22-43-52.png", "id": "429953335104667", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974714_429953338438000_1630301928601733580_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0KLuTayQckYQ7kNvwEr1BFr&_nc_oc=AdrH6gPnJm1bqaEJtvZY6vfIa_9BxfYrNquVes7wRFd-EaCu3qBfkml4Q0mTFlWysko&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJIxDcYXpymMbLqAZp2QhjvWXaNlmWqM7OdRJWEUFgM_g&oe=6A9ADDC2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screen_2560x1440_2020-09-17_22-47-51.png", "id": "230829075192600", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974887_230829078525933_560344683498926700_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mMLABUIkwvMQ7kNvwEudwOZ&_nc_oc=Adq0UBvEC34nUiQGTJk7VNl-fceaQe-YttIR8BAiPUUx8bgwhFvaKJRNafAKTVmrYrs&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIJ0RWjakPJwgfp-p3JmY2f0n1da6YFmbCogVl6ZO6-Tg&oe=6A9AF5FF"}, "display_name": "War Yards Beta", "keywords": [], "long_description": "War Yards is a 1v1 multiplayer shooter that approaches bullet time combat in a whole new way. The game utilizes a unique set of mechanics that allow each player to control the speed of their opponent\u2019s projectiles. Bullet time mode can be activated at any time, but while active it restricts the player to room-scale movement only and removes their ability to reload. These mechanics create an unparalleled combat experience that seamlessly blends fast paced action with tense strategy. War Yards combines these innovative gameplay systems with incredibly detailed stylized maps to make for a truly unforgettable VR western adventure.\n\nFeatures:\n- Challenge your friends to intense and highly strategic 1v1 duels.\n- Utilize incredibly unique multiplayer bullet time mechanics to outsmart your opponent.\n- Explore 4 highly detailed stylized maps inspired by classic western settings.\n- Enjoy the freedom of playing with users across nearly all VR platforms.", "short_description": "Step into the shoes of a legendary gunslinger and experience a new kind of VR multiplayer combat. War Yards utilizes a set of unique gameplay systems to seamlessly bring bullet time mechanics to multiplayer matches."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.iubenda.com/privacy-policy/24673521/legal", "developer_terms_of_service_url": null, "publisher_name": "Pixel Framers LLC", "support_website_url": null, "website_url": "https://www.waryards.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "con
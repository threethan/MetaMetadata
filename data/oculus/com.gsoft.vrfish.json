ll, "video_trailer_thumbnail": null, "display_name": "Ocean Wonder", "keywords": ["wonder", "ocean", "fish"], "long_description": "You will be transported to a submarine with an exceptional mission: clean the oceans and save marine life from human pollution. Once there you'll learn there's more mysteries than you expected. With the help of Neal the Clownfish, you'll have to solve a series of problems and puzzles to bring back life to this underwater paradise.\n In this first-person experience you'll be able to cultivate a variety of rare fish and come face to face with evil forces and sea monsters. You'll also pilot your own submarine to explore the depths of the ocean and its many mysteries. But never forget your mission to clean the ocean and the creatures that suffer the dangers of pollution. An underwater experience is waiting for you!", "short_description": "Buy Now \"VR Fantasy Ocean - Premium Edition\" to enjoy the beauty of the ocean. Pay for the first 2 chapters now and get the future 3 chapters for free! Enjoy the full five-chapter experience with the premium edition in this promotion period."}]}, "developer_name": "Game Hollywood", "developer_privacy_policy_url": "http://gamehollywood.com/", "developer_terms_of_service_url": "http://gamehollywood.com/", "publisher_name": "Game Hollywood", "support_website_url": null, "website_url": "http://gamehollywood.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE", "ARCADE", "EXPLORATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "46686789154819
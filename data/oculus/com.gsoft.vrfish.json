person experience you'll be able to cultivate a variety of rare fish and come face to face with evil forces and sea monsters. You'll also pilot your own submarine to explore the depths of the ocean and its many mysteries. But never forget your mission to clean the ocean and the creatures that suffer the dangers of pollution. An underwater experience is waiting for you!", "short_description": "Buy Now \"VR Fantasy Ocean - Premium Edition\" to enjoy the beauty of the ocean. Pay for the first 2 chapters now and get the future 3 chapters for free! Enjoy the full five-chapter experience with the premium edition in this promotion period."}]}, "developer_name": "Game Hollywood", "developer_privacy_policy_url": "http://gamehollywood.com/", "developer_terms_of_service_url": "http://gamehollywood.com/", "publisher_name": "Game Hollywood", "support_website_url": null, "website_url": "http://gamehollywood.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["SHOOTER", "EXPLORATION", "ADVENTURE", "EDUCATIONAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "673088130538881"}}]}, "scheduled_offers": {"count": 75, "nodes": [{"status": "PUBLISHED", "id": "634802553587795"}, {"status": "PUBLISHED", "id": "109363327160913"}, {"status": "PUBLISHED", "id": "819638215180599"}, {"status": "PUBLISHED", "id": "2684857014859345"}, {"status": "PUBLISHED", "id": "2768668559830063"}, {"status": "PUBLISHED", "id": "4596303377048215"}, {"status": "PUBLISHED", "id": "1243859599292710"}, {"status": "PUBLISHED", "id": "399757991043558"}, {"status": "PUBLIS
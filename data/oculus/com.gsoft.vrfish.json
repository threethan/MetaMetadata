cdn.com/v/t64.5771-25/12482255_471436043252999_525222445297172480_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jhaDcGB3E_8Q7kNvwHCoWfn&_nc_oc=Adq2Lxm-IGUDmO3A-LHQkz83N6CU0hXGqtAgcp5s3SDvsdPYqzh-8HxVQ_QbAvpuGzs&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af57E033XNKY6dufSxI3VXVkR37RkSPguh1RU7V1SLVInQ&oe=69FDF472"}, {"file_name": "migrated_image.png", "id": "2369635859805261", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/12482392_1818549891488341_7807048494450999296_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E7V37RIN_YMQ7kNvwHEZ2Qz&_nc_oc=AdoQ5NPsmE7oZKaaMU5k7HbCHNcA8haLb8qoYXm865C7WrWjwiCwEr4Txmxvqjq-WhU&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af61eznbBVfDlnx5McmaMXlc-qHnIJkgtoozsP8TduKAtw&oe=69FDD5AE"}, {"file_name": "migrated_image.png", "id": "1592652997557957", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/12427537_420853111677328_1328166684363587584_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fq9YbH5IvOAQ7kNvwEbDjo6&_nc_oc=Adrr8DDWCiDmx5NUbklqEZhV_My52kC-khHgUV6DpwYsFY9lkhaXLg11ur_f4tQMOXo&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7VfX1FVucPI6xhgWpl43nF_zoa-tQMH1bUl8JGkLaBCg&oe=69FDE293"}, {"file_name": "migrated_image.png", "id": "331615661131817", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/12482255_1880867965556984_7776137331353845760_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h0ZOLsl5TZ8Q7kNvwH0fVG0&_nc_oc=AdpHSnFh8QK3CkfqqbkFAoSiK188Q5Iow3E5cU8uNnKHSsBiepa4RLYi_VFXgRiStrk&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5zhz3hB4ou0hyBdGNRnVuV6g_CDxU6JR3uKJj3_IxPsQ&oe=69FDDB03"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Ocean Wonder", "keywords": ["wonder", "ocean", "fish"], "long_description": "You will be transported to a submarine with an exceptional mission: clean the oceans and save marine life from human pollution. Once there you'll learn there's more mysteries than you expected. With the help of Neal the Clownfish, you'll have to solve a series of problems and puzzles to bring back life to this underwater paradise.\n In this first-person experience you'll be able to cultivate a variety of rare fish and come face to face with evil forces and sea monsters. You'll also pilot your own submarine to explore the depths of the ocean and its many mysteries. But never forget your mission to clean the ocean and the creatures that suffer the dangers of pollution. An underwater experience is waiting for you!", "short_description": "Buy Now \"VR Fantasy Ocean - Premium Edition\" to enjoy the beauty of the ocean. Pay for the first 2 chapters now and get the future 3 chapters for free! Enjoy the full five-chapter experience with the premium edition in this promotion period."}]}, "developer_name": "Game Hollywood", "developer_privacy_policy_url": "http://gamehollywood.com/", "developer_terms_of_service_url": "http://gamehollywood.com/", "publisher_name": "Game Hollywood", "support_website_url": null, "website_url": "http://gamehollywood.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE", "ARCADE", "EXPLORATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "466867891548190"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/12331069_152663182028998_711760116277313536_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=whnk1I5QwxIQ7kNvwF4iw5e&_nc_oc=Ado_Bj_hRCrY3E2Av5bXP-M_EuwQ8mwaAQfxpdCLXxF_h7uWTE_WH
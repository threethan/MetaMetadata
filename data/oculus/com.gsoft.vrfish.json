cdn.com/v/t64.5771-25/12482255_471436043252999_525222445297172480_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R3B3rGvuALAQ7kNvwH1SLJS&_nc_oc=AdrhPsTk36tgwKE6CjlASuyRFa5CWeDu15WirjtR8o_4ZU9P19YS-qQDvVwm7vDT76E&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAGoStkJM17rbjGzkJ0yNKXsgeR81Sry3-De4CuOr7kYQ&oe=6A4E5FF2"}, {"file_name": "migrated_image.png", "id": "2369635859805261", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/12482392_1818549891488341_7807048494450999296_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sIpxbGUlyIIQ7kNvwFXXhDi&_nc_oc=AdoIEteK7AbYdttx3g0IDwhA2asr79gglzfefsUCw7JRb0CYtZIUuIc-5bGfDHc1rcY&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCCTd6MHile-y2UYCMUUHrHzVQih_QOecCYP4cLlANddA&oe=6A4E412E"}, {"file_name": "migrated_image.png", "id": "1592652997557957", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/12427537_420853111677328_1328166684363587584_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8mdkEY9PpugQ7kNvwEbI_ME&_nc_oc=AdqgOyKttHcavsVajEV04a9zrutLr5LOhn2ynqsPNrgLoftlBWprUQKntwJq0n6JW64&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD2ZbllU0L-yqtgW_vHESCaajPHM8urTHeKnLFDRISe5w&oe=6A4E4E13"}, {"file_name": "migrated_image.png", "id": "331615661131817", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/12482255_1880867965556984_7776137331353845760_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=21idtmxbfDMQ7kNvwHL3Fgj&_nc_oc=AdqQTqfdJG_tRKsdtPD0jnUJeJRhzjJH-avBjlYa-3mRSQ_3Vr7sUnfD3pXo9aVAPOs&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDXu_MwuIWiWGJxq37Fs0UhCKUigZ6_DLyNiFAH9MDk8Q&oe=6A4E4683"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Ocean Wonder", "keywords": ["wonder", "ocean", "fish"], "long_description": "You will be transported to a submarine with an exceptional mission: clean the oceans and save marine life from human pollution. Once there you'll learn there's more mysteries than you expected. With the help of Neal the Clownfish, you'll have to solve a series of problems and puzzles to bring back life to this underwater paradise.\n In this first-person experience you'll be able to cultivate a variety of rare fish and come face to face with evil forces and sea monsters. You'll also pilot your own submarine to explore the depths of the ocean and its many mysteries. But never forget your mission to clean the ocean and the creatures that suffer the dangers of pollution. An underwater experience is waiting for you!", "short_description": "Buy Now \"VR Fantasy Ocean - Premium Edition\" to enjoy the beauty of the ocean. Pay for the first 2 chapters now and get the future 3 chapters for free! Enjoy the full five-chapter experience with the premium edition in this promotion period."}]}, "developer_name": "Game Hollywood", "developer_privacy_policy_url": "http://gamehollywood.com/", "developer_terms_of_service_url": "http://gamehollywood.com/", "publisher_name": "Game Hollywood", "support_website_url": null, "website_url": "http://gamehollywood.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE", "ARCADE", "EXPLORATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "466867891548190"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/12331069_152663182028998_711760116277313536_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cfJ9PgG5zMEQ7kNvwHUTs8P&_nc_oc=AdpUh8IKTNyLoZocdP1Vmu6gNx632IXH-O_hvK9Isd226C0epwVIm
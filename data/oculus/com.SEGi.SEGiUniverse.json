xnf1kWUpJFJjWlb0fFOqUfMCdc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKbPegj0BoYygg7EwD4CtH3oIWaP88_Yv0GCpiPfDSvRQ&oe=6AA56826"}, {"file_name": "Theater.png", "id": "1704955430455348", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499622211_1704955433788681_6364941822553845998_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Fd6GP2pavIAQ7kNvwG8NP-E&_nc_oc=AdpqJG8ZRRN1hOtELzq8V4ZgOO94L3PeNAWRgF5VC8R-kGWKzSInuHYXhqVM1Dla2Xw&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKfS6Yej-7zC2kcmsOmlnREXUhON3WqmmoxakHRFAJqiA&oe=6AA5553D"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "SEGi Universe", "keywords": ["SEGiUniversity", "VirtualLearning", "SEGiUniverse", "VirtualUniversity", "VrCampus"], "long_description": "SEGi Universe is an immersive virtual campus experience created for SEGi University students. Step into a digital version of the university where you can explore campus environments, interact with fellow students, and participate in university activities in virtual reality.\n\nConnect with friends through real-time voice communication, discover campus spaces, and join live sessions, events, and community gatherings from anywhere. SEGi Universe brings learning, collaboration, and social interaction together in a shared virtual world designed to enhance the student experience.\n\nFeatures\n\ud83c\udfeb Explore a virtual SEGi University campus\n\ud83e\uddd1\u200d\ud83e\udd1d\u200d\ud83e\uddd1 Meet and interact with fellow students\n\ud83c\udfa4 Real-time voice communication\n\ud83c\udf93 Attend live sessions and university events\n\ud83c\udf10 Social and collaborative virtual environment\n\ud83d\ude80 Continuous updates and new features planned\n\nSEGi Universe is designed to create a connected, engaging, and innovative digital campus experience, helping students learn, socialize, and collaborate beyond the boundaries of the physical campus.\n\nVersion 1.0 \u2013 Initial Release. More locations, activities, customization options, and student-focused experiences will be added in future updates.", "short_description": "Meet friends, explore campus, and join live sessions in the SEGi Universe."}]}, "developer_name": null, "developer_privacy_policy_url": "https://segiuniverse.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "GTDD Department", "support_website_url": null, "website_url": "https://www.segi.edu.my/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "1132943536578280"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499620504_1045995911414862_3724414106792993358_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-YGUphEn5uwQ7kNvwEOzXm4&_nc_oc=AdoLKnQNCR0XgFh1qv-6NpiSY1P4xwrC2SD6422wXC_PbgR6RRqu9idWTCeKOXvnLmo&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIRoe_OejUyiDs7EE6nKCzNYTwHkhQ77ns1-yEO4KYmdg&oe=6AA57323"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "SEGi Universe", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_name": "Learning", "id": "1043107547362485"}], "release_date": 1785459420, "lastRevision": {"nodes": [{"id": "1109694315569869", "release_type": "SCHEDULED",
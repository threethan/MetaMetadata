_sid=6e7a0a&_nc_ohc=eeyoUVbSrWEQ7kNvwFdjTqS&_nc_oc=AdpBHb9gxa2gJdpQUvDX0OSrJW7KBpgYto84UzDAfHv1rziupBMWucXC8XGvdleMwwk&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4fMgNbEd2QleDexkcTgLniFkbXUbAzapK232mKwXTLZQ&oe=6A072180"}, {"file_name": "TrapYourFriendsSpinningTraps.png", "id": "1306255647045398", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974686_1306255650378731_106763229262083013_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r5lPcdyR0LUQ7kNvwGgIHwa&_nc_oc=AdqlGaDGLYStdzrLQ3fDF0q9sZ8ya96mBqTqmcAwfg9argtAudVGBrtX-zAUQ_fiklo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6G_oewnUX9o2nI5IB8UwhM1dNwHdNM6ceGGsHBwG5QdA&oe=6A071FA2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TrapYourFriendsScreenshot_WalkAwayFromTraps_Resized.png", "id": "578486334507873", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974638_578486337841206_4667129301511535973_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C5LYYFl3HswQ7kNvwESWbhy&_nc_oc=Adp09_7OOKQK2LiizCCP024s1ognhtmODFkjT-R5dnDie56TiJLE2RLF4x_6t9hyBso&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af42sSMQz_i6bZ_NgWBJ94mnQiF655D8jjRpDlu9lhth2g&oe=6A0718A2"}, "display_name": "Trap Your Friends", "keywords": ["mixedreality", "obstacles", "traps", "multiplayer", "run"], "long_description": "Challenge your friends in this thrilling **mixed reality** obstacle course game. Here's how it works:\n\n- Each player places one trap in the play space.\n- Race across the room to hit the button on the other side.\n- If you hit a trap, you're out for that round.\n- The faster you reach the button, the better.\n\nAfter each round, players place new traps and race again. The play area can be adjusted to fit any room size, so you and your friends can play together, even in different spaces.", "short_description": "Get ready for some mixed reality mayhem with your friends! Set traps all around your play space and race from one end t
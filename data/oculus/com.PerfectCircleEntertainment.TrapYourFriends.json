_sid=6e7a0a&_nc_ohc=VndbLUUBmLMQ7kNvwE7qZcq&_nc_oc=Adosn3WQESeIl4wUZ1QV1pRz763Yof7B08QaUVsrSFg8xEoPwK-k2iHtz9A9ge1__4Y&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCEAKlV_ISDoNvgNO6hpQj9RVfVOnhadyaTBKbxBqM3Fw&oe=6A524700"}, {"file_name": "TrapYourFriendsSpinningTraps.png", "id": "1306255647045398", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974686_1306255650378731_106763229262083013_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Uv3Y0LcsMvUQ7kNvwGX2LIg&_nc_oc=Ado87zUTZTUKaUnc19I6KyiX5p0HFSDabJQ9oI6qVmtk2GwfyizDAAUUzxcvVXfI1RQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAyaQkrxsf2lHQU1TihckpCDjuAyHsnzTgdBMZvrUeQwA&oe=6A524522"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TrapYourFriendsScreenshot_WalkAwayFromTraps_Resized.png", "id": "578486334507873", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974638_578486337841206_4667129301511535973_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IL1STQC9PpMQ7kNvwGVbqOj&_nc_oc=Adpm1mxkA8gQYJBoCoxRyFGZycJAiI8W_PPmXg0I6Hw5K8oToatF7wyQ-PaBuGk3lss&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBerAPqABs6W_AHRSJe4c_Sf9QmDhOYj26gYHaexNsTwA&oe=6A523E22"}, "display_name": "Trap Your Friends", "keywords": ["mixedreality", "obstacles", "traps", "multiplayer", "run"], "long_description": "Challenge your friends in this thrilling **mixed reality** obstacle course game. Here's how it works:\n\n- Each player places one trap in the play space.\n- Race across the room to hit the button on the other side.\n- If you hit a trap, you're out for that round.\n- The faster you reach the button, the better.\n\nAfter each round, players place new traps and race again. The play area can be adjusted to fit any room size, so you and your friends can play together, even in different spaces.", "short_description": "Get ready for some mixed reality mayhem with your friends! Set traps all around your play space and race from one end t
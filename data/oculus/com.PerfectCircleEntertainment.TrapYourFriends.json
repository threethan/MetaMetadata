_sid=6e7a0a&_nc_ohc=kukYIUmwiKwQ7kNvwGRbCie&_nc_oc=AdrEcxJ0RG4Dw-mQ81RgLbXu_nVMCSrQT-RDJ7NAzhRO3MtJLJnXEvp36psNcDDxh3U&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2WTZk3eL_UNso-qx1isliYU6s-cjVEZnPDwbST73ARyw&oe=69F4AC80"}, {"file_name": "TrapYourFriendsSpinningTraps.png", "id": "1306255647045398", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974686_1306255650378731_106763229262083013_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hcYRvmOZQSwQ7kNvwGVGb9_&_nc_oc=AdpQwskyYCFDobAwGExdKAihu3_z4aDAahnztgpgkZF8E8cSVoitCl2G8I_MHB-4KrU&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3Dm3SXOD87tjmdusMQrNtMqlkPC95cI3nxbYw7B9rH7Q&oe=69F4AAA2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TrapYourFriendsScreenshot_WalkAwayFromTraps_Resized.png", "id": "578486334507873", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974638_578486337841206_4667129301511535973_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1sAE5LLM8D0Q7kNvwGu_EqS&_nc_oc=AdoDKsEmtpMLk4UvQNUpi0JmTkq0GVkS9CCtfJuYiipmnZIKbPxCljEzV4GeD0YMZFg&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3Tzl5F3tGADAJKtPIKi84lKtJiMpRYo0Bp8mqRdFvx0g&oe=69F4A3A2"}, "display_name": "Trap Your Friends", "keywords": ["mixedreality", "obstacles", "traps", "multiplayer", "run"], "long_description": "Challenge your friends in this thrilling **mixed reality** obstacle course game. Here's how it works:\n\n- Each player places one trap in the play space.\n- Race across the room to hit the button on the other side.\n- If you hit a trap, you're out for that round.\n- The faster you reach the button, the better.\n\nAfter each round, players place new traps and race again. The play area can be adjusted to fit any room size, so you and your friends can play together, even in different spaces.", "short_description": "Get ready for some mixed reality mayhem with your friends! Set traps all around your play space and race from one end to the other. But watch out\u2014your friends are setting traps too! Dodge, dash, and outsmart them to make it to the finish line. It\u2019s a fast, fun, and chaotic race where anything can happen!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.trapyourfriends.com/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Perfect Circle Entertainment", "support_website_url": null, "website_url": "https://www.trapyourfriends.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1700921480735423"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER", "CO_OP"], "id": "8610716568992095"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "949408447211771"}]}, "baseline_offer": {"id": "949408447211771"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1732039200, "status": "PUBLISHED", "id": "949408447211771"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "24665234669780362", "version": "5.0.8"}, "id": "1305699657260502", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "8610716555658763", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "2
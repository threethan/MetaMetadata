_sid=6e7a0a&_nc_ohc=nxWEDWsHvVwQ7kNvwGNCylB&_nc_oc=Ado1P_oNHGbYfcJ5ZUWGmxwloKvybmujCu5jzXYVedbFbfSnFRuimzgrzdtcAYdY_d4&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-Fjc_foluspt2oFWkvmAnOcIWh7sm9gaapOb6YACClVg&oe=6A412380"}, {"file_name": "TrapYourFriendsSpinningTraps.png", "id": "1306255647045398", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974686_1306255650378731_106763229262083013_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YjPvk8b5QEUQ7kNvwHvMibf&_nc_oc=AdrhythT633PHqO9Tip0gVZWx8raEgUd4WG22Q8_Nq0dPjnJQgBws3EUfC3_qjJabFk&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_SJDQINQE6u5mtFPAGt3RRKX1aT8pPRLs2nd502ieDXg&oe=6A4121A2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TrapYourFriendsScreenshot_WalkAwayFromTraps_Resized.png", "id": "578486334507873", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974638_578486337841206_4667129301511535973_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YUaJuXQ5V8MQ7kNvwH9_O0N&_nc_oc=Adr61u-o8Y039pOuPVJJHk0_KW9E4hbLkKcjYdao_XJSEfHUTr_iSUqh4CpGV8WkPxE&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9agqqs8t-nbMD79HTHeO0y1CBpbcqdRa4YcKdSYZLvkQ&oe=6A411AA2"}, "display_name": "Trap Your Friends", "keywords": ["mixedreality", "obstacles", "traps", "multiplayer", "run"], "long_description": "Challenge your friends in this thrilling **mixed reality** obstacle course game. Here's how it works:\n\n- Each player places one trap in the play space.\n- Race across the room to hit the button on the other side.\n- If you hit a trap, you're out for that round.\n- The faster you reach the button, the better.\n\nAfter each round, players place new traps and race again. The play area can be adjusted to fit any room size, so you and your friends can play together, even in different spaces.", "short_description": "Get ready for some mixed reality mayhem with your friends! Set traps all around your play space and race from one end t
_sid=6e7a0a&_nc_ohc=VndbLUUBmLMQ7kNvwHTHH1g&_nc_oc=AdosZZcxeccXAvKUJcUbnFp5DDavDzmy8s_b2M7MHyw3r2gZsHUPVsCIye4PXq7n4Ek&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB3xqWKDEKgNfXLoprE26jFCepi5t3-JAzR8M0vtvPJ-w&oe=6A50F580"}, {"file_name": "TrapYourFriendsSpinningTraps.png", "id": "1306255647045398", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974686_1306255650378731_106763229262083013_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Uv3Y0LcsMvUQ7kNvwHBxNF-&_nc_oc=AdoxVPRKlXh--okuqeSTebOTGP7xK5cjEJVGpR5bQl6-QabJ8OW7oMryZhQC_-9OX5k&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDmqepDhPU2nd8t_iJ6whg-cKdkMpN5lS4EXQcNBtCUIA&oe=6A50F3A2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TrapYourFriendsScreenshot_WalkAwayFromTraps_Resized.png", "id": "578486334507873", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974638_578486337841206_4667129301511535973_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IL1STQC9PpMQ7kNvwGv9IGL&_nc_oc=AdoFNCFXjSr_O7HyUfjo51UsZWxNkXQYLRrj_bDGY-kl81TldJrah7WHkANljdU1fRk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQARWrf8LREw_8_te0q_Xit66ewYaEoS7Hh-hcj3axSvUQ&oe=6A50ECA2"}, "display_name": "Trap Your Friends", "keywords": ["mixedreality", "obstacles", "traps", "multiplayer", "run"], "long_description": "Challenge your friends in this thrilling **mixed reality** obstacle course game. Here's how it works:\n\n- Each player places one trap in the play space.\n- Race across the room to hit the button on the other side.\n- If you hit a trap, you're out for that round.\n- The faster you reach the button, the better.\n\nAfter each round, players place new traps and race again. The play area can be adjusted to fit any room size, so you and your friends can play together, even in different spaces.", "short_description": "Get ready for some mixed reality mayhem with your friends! Set traps all around your play space and race from one end t
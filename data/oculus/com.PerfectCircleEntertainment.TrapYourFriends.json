_sid=6e7a0a&_nc_ohc=9Sz3dD7dOgYQ7kNvwEC2wy8&_nc_oc=Adrq3fGWnKuTqZ7WsEfGccMHRkwFHC9KFtlkvIPynaJzevpfXyuqBR8Xip54rsY66Ck&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7Feprsh2C_v1F5a5GQoqua1OcJDI2NHEt7TPYFx-0I1g&oe=6A145080"}, {"file_name": "TrapYourFriendsSpinningTraps.png", "id": "1306255647045398", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974686_1306255650378731_106763229262083013_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Wn_raAXAcR4Q7kNvwF_3sFF&_nc_oc=Adq_Tci9C8Kw5JMrNXoqxGkvgb6TImtk351nyu9GIlDf-qF5jJZc6NgrwQrxwJgou30&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af71FZBV10zQGMssejjgFdM43VgQ3rXqYH5jSB5vtd5WHg&oe=6A144EA2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TrapYourFriendsScreenshot_WalkAwayFromTraps_Resized.png", "id": "578486334507873", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974638_578486337841206_4667129301511535973_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pjsgG_yBLhMQ7kNvwHqVVEo&_nc_oc=AdqP1tvBaTvrb9Ro-jrqBOoTJK3RqOOUkIbk211GqznUSaR_Nr80_YgEjwXzsU-h2JY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5XDpyhfykdMYBaJv8IR7JeyrW84j3Qi5tm0IPDfINmEg&oe=6A1447A2"}, "display_name": "Trap Your Friends", "keywords": ["mixedreality", "obstacles", "traps", "multiplayer", "run"], "long_description": "Challenge your friends in this thrilling **mixed reality** obstacle course game. Here's how it works:\n\n- Each player places one trap in the play space.\n- Race across the room to hit the button on the other side.\n- If you hit a trap, you're out for that round.\n- The faster you reach the button, the better.\n\nAfter each round, players place new traps and race again. The play area can be adjusted to fit any room size, so you and your friends can play together, even in different spaces.", "short_description": "Get ready for some mixed reality mayhem with your friends! Set traps all around your play space and race from one end t
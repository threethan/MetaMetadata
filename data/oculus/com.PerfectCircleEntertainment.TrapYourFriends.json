_sid=6e7a0a&_nc_ohc=_Kkg5u7IROkQ7kNvwFfm7Sj&_nc_oc=AdqRpKQO1x1foicO4WJS1gcdDbjs0Bsar2iAJuQFI9IFafQlFcdPw-ERc3nQpsYDeSQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1uY86h8aithp7PGT0xxeB9px8D7b5AyBAwb-lpd5wf4A&oe=69DA4E80"}, {"file_name": "TrapYourFriendsSpinningTraps.png", "id": "1306255647045398", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974686_1306255650378731_106763229262083013_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Q8MgwXJI61kQ7kNvwGizmqO&_nc_oc=AdqVNSw_KiqZEP_dn66gdeZcVX0KEARFiCMlOuVyPPId25E2UxV4bqESNYbXDdgHxhw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3r_wkpx87b1V0NJ5vAhaSCF2rtPQC0r4w7MHoMazdJeg&oe=69DA4CA2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TrapYourFriendsScreenshot_WalkAwayFromTraps_Resized.png", "id": "578486334507873", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974638_578486337841206_4667129301511535973_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NImQIpS7VjwQ7kNvwFoFmvz&_nc_oc=Adqz3dTnSSqqrR1iEFlDukHXoRU8PrDKPCm2i-Mru1cwgjojk6FUIBbTosL_AkLCkAQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3EuT3BwVjmYz4Poyxj8oKVRVWqpCoS2oAMFYae2CAiaQ&oe=69DA45A2"}, "display_name": "Trap Your Friends", "keywords": ["mixedreality", "obstacles", "traps", "multiplayer", "run"], "long_description": "Challenge your friends in this thrilling **mixed reality** obstacle course game. Here's how it works:\n\n- Each player places one trap in the play space.\n- Race across the room to hit the button on the other side.\n- If you hit a trap, you're out for that round.\n- The faster you reach the button, the better.\n\nAfter each round, players place new traps and race again. The play area can be adjusted to fit any room size, so you and your friends can play together, even in different spaces.", "short_description": "Get ready for some mixed reality mayhem with your friends! Set traps all around your play space and race from one end t
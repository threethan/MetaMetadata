_sid=6e7a0a&_nc_ohc=jmcVAef3PwwQ7kNvwEHy2l6&_nc_oc=Adq897NJ53iyLHzzJ5msI0pYB50y78fNjEd2tMbwf197m0vF2etZWqEXQKX2Rys0jE8&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8EaPt-60NguAsAiZs7LCA8drq5uGI492t8ErHCbmzzrg&oe=6A26C580"}, {"file_name": "TrapYourFriendsSpinningTraps.png", "id": "1306255647045398", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974686_1306255650378731_106763229262083013_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XIxi-UMjk1wQ7kNvwH-JhVz&_nc_oc=AdqI7Pybe2PqQIQ9ofrvHKAnB0LtMeEuoekNnguKPW4VtHAx4aC-obC020Oe7-XIzDA&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_BqGIKUJf3q0xiFCo215hEab9TXNnBKeI9K6PPvvQMiQ&oe=6A26C3A2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TrapYourFriendsScreenshot_WalkAwayFromTraps_Resized.png", "id": "578486334507873", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974638_578486337841206_4667129301511535973_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Mw4z68Smi_MQ7kNvwGZX3gN&_nc_oc=AdqljEZKZAkpi8WoKtWPo-4MG8i-2reGN2IedxRytggDaiXSZRvdygJpiRWsoup4Sgo&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-Af-xKyvofrGsKMrfi9mechzyzDqxtZ6Xnk_xAaVPICg&oe=6A26BCA2"}, "display_name": "Trap Your Friends", "keywords": ["mixedreality", "obstacles", "traps", "multiplayer", "run"], "long_description": "Challenge your friends in this thrilling **mixed reality** obstacle course game. Here's how it works:\n\n- Each player places one trap in the play space.\n- Race across the room to hit the button on the other side.\n- If you hit a trap, you're out for that round.\n- The faster you reach the button, the better.\n\nAfter each round, players place new traps and race again. The play area can be adjusted to fit any room size, so you and your friends can play together, even in different spaces.", "short_description": "Get ready for some mixed reality mayhem with your friends! Set traps all around your play space and race from one end t
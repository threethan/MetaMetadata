wEZrZ-t&_nc_oc=Adqxm5oBKuaefdudUJZ4teIpho6dwQufS4P_hthmNRXd5W6onLiLWYXajJTOWs_Yjgo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQE3yUgaKOpPYeQS8M3ly6kyKXOdS8AsYEjeKIx_Zq9Aw&oe=6B0DAF7F"}, {"file_name": "SpinningSpikesGround.png", "id": "969181338559354", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39001707_969181341892687_4778036540882902390_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E_5mQ2kDWSAQ7kNvwF6u0gJ&_nc_oc=AdomxBmgjLGYRSzJ9NaTtNCO_FqFDzw5wCpyVmKBs61uuliUp-qrGWFUq3Ezpp_72K8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQS2X7WcIpbGN-GdnB9hgSzx1bC1dsll1DomN7pr0jd1dA&oe=6B0DB440"}, {"file_name": "TrapYourFriendsSpinningTraps.png", "id": "1306255647045398", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974686_1306255650378731_106763229262083013_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1P-vwbbPamYQ7kNvwFlFrJy&_nc_oc=Ado7wQDr5tuf1O9J-DAME2RJF2DevOLdOl1gcfxYVZAo9Qe4Bl686C_ST6UhJo52CZg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSfewfi5OC5JxlNe4NtSZMnWnR1rjsGanqyhUgdpQ8QcQ&oe=6B0DB262"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TrapYourFriendsScreenshot_WalkAwayFromTraps_Resized.png", "id": "578486334507873", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974638_578486337841206_4667129301511535973_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V1YeCJ1MI60Q7kNvwEIr6uC&_nc_oc=AdrYSf0w4iFF-h83-9kECsKd5BbvptO5fLtpICZG9h-ZcgmlK4nphyTmkKwC1R3fxeM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRMlWQ8yl3fRmmRfEL6vdKlArSu5RVymR72SRr--_ZTgg&oe=6B0DAB62"}, "display_name": "Trap Your Friends", "keywords": ["mixedreality", "obstacles", "traps", "multiplayer", "run"], "long_description": "Challenge your friends in this thrilling **mixed reality** obstacle course game. Here's how it works:\n\n- Each player places one trap in the play space.\n- Race across the room to hit the button on the other side.\n- If you hit a trap, you're out for that round.\n- The faster you reach the button, the better.\n\nAfter each round, players place new traps and race again. The play area can be adjusted to fit any room size, so you and your friends can play together, even in different spaces.", "short_description": "Get ready for some mixed reality mayhem with your friends! Set traps all around your play space and race from one end to the other. But watch out\u2014your friends are setting traps too! Dodge, dash, and outsmart them to make it to the finish line. It\u2019s a fast, fun, and chaotic race where anything can happen!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.trapyourfriends.com/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Perfect Circle Entertainment", "support_website_url": null, "website_url": "https://www.trapyourfriends.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1700921480735423"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER", "CO_OP"], "id": "8610716568992095"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "949408447211771"}]}, "baseline_offer": {"id": "949408447211771"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1732039200, "status": "PUBLISHED", "id": "949408447211771"}]}, "liveChannel": {"nodes": [{"late
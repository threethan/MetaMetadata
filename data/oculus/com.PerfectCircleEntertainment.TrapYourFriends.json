_sid=6e7a0a&_nc_ohc=3OY3SgEbbaIQ7kNvwHngAFW&_nc_oc=AdqsGWMBvavG5t-KibFQvNQfsr8eH3w_PaVRNYKty9twOnf-QvcM5sR_yZ9eJFqt-FM&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af479nRxgogaWDhqhMNLlK3yvdGoZyX8fAkCiUF2_lxHAA&oe=6A202E00"}, {"file_name": "TrapYourFriendsSpinningTraps.png", "id": "1306255647045398", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974686_1306255650378731_106763229262083013_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iZOGPrjeOY4Q7kNvwHbD7vJ&_nc_oc=AdoAs4004wklRxcFT6Iy6SKRZaAe8BrWMqDWoBExmCO1ub1kluI3fEYEU-j8c0iIq7E&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6RYHRuHLjAlJEMwuClDa3AdsN4DpWHAbkD9HDL9IwAbw&oe=6A202C22"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TrapYourFriendsScreenshot_WalkAwayFromTraps_Resized.png", "id": "578486334507873", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974638_578486337841206_4667129301511535973_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Rkk7OxzfC7cQ7kNvwHuJfQV&_nc_oc=Adp0hbpYo0Op8GFLFaagPvD9aEW96ayC5t_-v_LgQJyWMmPh4N-H9WRFsAftZq8jGEU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6Ug5i8g9_F7vM9KvoLhAB1Xf6nTPFD2shBXDQFmRtRWw&oe=6A202522"}, "display_name": "Trap Your Friends", "keywords": ["mixedreality", "obstacles", "traps", "multiplayer", "run"], "long_description": "Challenge your friends in this thrilling **mixed reality** obstacle course game. Here's how it works:\n\n- Each player places one trap in the play space.\n- Race across the room to hit the button on the other side.\n- If you hit a trap, you're out for that round.\n- The faster you reach the button, the better.\n\nAfter each round, players place new traps and race again. The play area can be adjusted to fit any room size, so you and your friends can play together, even in different spaces.", "short_description": "Get ready for some mixed reality mayhem with your friends! Set traps all around your play space and race from one end t
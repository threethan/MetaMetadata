nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TYtIWXcfh8gQ7kNvwElNDYT&_nc_oc=AdpLdo1wu9_jiYaPsEmEseTnwFZKYKUWtRvpR__iF3OtdJVPCFqX5wLkQ8PLFPBs1e4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSxIzIQlNNmf4wucnZL4K85LW14T-QL_Nx-R-AKTfGjEQ&oe=6B046901"}, {"file_name": "3.mission-complete.png", "id": "1557714629484346", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499619668_1557714632817679_7453748550533466213_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ngAGkoUrF7gQ7kNvwGRgY27&_nc_oc=AdoJJandnhw_O8LUz-woIyyk_ZalUfH9iO48hGMwT3_6sqXu25x5JucpchXY8QmHFSs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQigrq23bpjkqZioDu8LnokXEICkgx0xpujVdzC651WIQ&oe=6B045CA9"}, {"file_name": "4.engine-room-console.png", "id": "1703198864087567", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499619681_1703198867420900_8564971524921059747_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yURfSH29y0cQ7kNvwE-qkx3&_nc_oc=Adpk4-2OQayyCy-AW40sDWsHjCfIDcEgdsa8wXfJf8i8TtQ7lzkr_nIzGj3oHkcpEl4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS5L2PibczMWiC2_L1-3uJ2cFwnZdxaGehENZVsAT_sZw&oe=6B047C09"}, {"file_name": "5.observatory.png", "id": "1593436605644367", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499624983_1593436608977700_6405424822980506767_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bHi0iVZL6hIQ7kNvwFl8Zf2&_nc_oc=AdoJhitNqyxWY5w4vafmnS7yC8kGI5CAMcNBWbd0c05NqNin3UrZSHc3TLITFg1RMPE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS67CyXeg5MLX-lQla6AEO0pJnYSpuqkAxSFLefoDoLyg&oe=6B046199"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_moon_2560x1440.png", "id": "1031214936367723", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499620504_1031214939701056_8813146852024938964_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aFnMiy6a4R4Q7kNvwGKqdjp&_nc_oc=AdpP2Mh2cG7egaaHy7thGF94q6Zgb_FACpZaUa6J6by0TIpN9ZmKdGUDzy3eHtC9hso&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSaWGpDGPomVYaz96K76fuldt1bUgWswZb7Y7aPzYHAfA&oe=6B045C55"}, "display_name": "Speakeasy3D", "keywords": ["speakingpractice", "languagelearning", "communicationskills", "aitutor", "interviewpractice"], "long_description": "Practice real conversations, out loud, with people who aren't real.\n\nSpeakeasy3D puts you somewhere you've never been, with someone you need to talk to. A hiring manager. A stranger at a party. A barista in a language you're learning. Step into the room. See who you're talking to. Feel what it's like before it counts.\n\nYou speak, they answer, and the conversation goes wherever you take it.\n\nNothing is scripted. Every scenario is generated fresh and personalized to you. They adapt to your pace, respond to what you actually say, and never judge. Run the same conversation ten times and it will go ten different ways.\n\nPRACTICE THINGS LIKE\n\n- Job interviews and performance reviews\n- Presentations and speaking up in meetings\n- Small talk, introductions, meeting new people\n- Difficult conversations: disagreeing, saying no, raising a problem\n- Everyday life in a language you're still learning\n\nLanguages include English, Spanish, Chinese, Portuguese, Japanese, Korean, and more.\n\nEvery session gives you clear objectives, real-time feedback, and a record of how you're doing over time.\n\nNo one is watching. No one is scoring you in front of anyone. You can get it wrong as many times as you need to.\n\nFREE: a conversation a day, every day. No card required.\nPREMIUM: longer conversations, and more of them. One subscription works across VR and web.\n\nFOR SCHOOLS AND CLINICS\nReal-time emotion tracking, learner dashboard, assignments, and reports.\nMore at speakeasy3d.com/professionals.", "short_description": "Rehearse job interviews, difficult conversations, and real-world speaking scenarios. Practice in your own language or learn a new one. Someone always talks back."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.speakeasy3d.com/privacy", "developer_terms_of_service_url": "https://www.speakeasy3d.com/terms", "publisher_name": "Speakeasy3D", "support_website_url": "https://www.speakeasy3d.com/support", "website_url": "https://www.speakeasy3d.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "35507074135573986"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "2031805050736570"}]}, "baseline_offer": {"id": "2031805050736570"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1789310520, "status": "PUBLISHED", "id": "2031805050736570"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "40449825211298829", "version": "1.0"}, "id": "2135937740537530", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "35507074085573991", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "40449825211298829"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": []}, "change_log": null, "created_date": 1795011928, "id": "40478711871743496", "version": "1.0", "version_code": 12, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "35507074085573991", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "40449825211298829"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "2135937740537530"}]}, "change_log": "\u2022 Missions build their own scene around you, and the next one is ready while you're in the lobby.\n\u2022 A weekly goal replaces the daily streak in the lobby. Meet it and the week turns gold, with fireworks.\n\u2022 New hand controls: pinch your palm for the menu, swipe your thumb to turn, and press panels by touch.\n\u2022 A hand guide shows you how to point and pinch.\n\u2022 Drag mission transcripts to scroll, jump to new lines, and see compact objective lists.\n\u2022 Grammar, vocabulary and the debrief arrive first. Pronunciation and fluency fill in when ready.\n\u2022 Sit in the ship's seats, and use the floor markers to get around.\n\u2022 Speak smoothly and earn bonus fuel.\n\u2022 Echo has 86 new lines.\n\u2022 New effects, from sparks to a breathing fuel cell, with Calm and Off settings.\n\u2022 Link your Speakeasy web account from the headset.\n\u2022 Choose whether to share usage data, with the Share usage switch in Settings.\n\u2022 Tutors no longer ask the same question twice.\n\u2022 Fixed a crash when a tutor was still downloading.", "created_date": 1794922941, "id": "40449825211298829", "version": "1.0", "version_code": 11, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "35507074085573991", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "40449825211298829"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "2135937740537530"}]}, "change_log": "\u2022 The ship has a new look, with new lighting throughout.\n\u2022 Fill your fuel cell and a blue pulse rolls out across the ship.\n\u2022 Premium players get the daily fuel top-up too.\n\u2022 Tutors' gestures now match what they say, and their faces follow their voices.\n\u2022 Tutors now speak in 30 different voices.\n\u2022 A new results card shows how each session went.\n\u2022 New sounds everywhere, with volume sliders in Settings.\n\u2022 Echo now spins and juggles the shaker while your mission is mixed.\n\u2022 Have a Speakeasy web account? You can switch to it from the Account panel.\n\u2022 Fewer false \"You're offline\" and \"No connection\" warnings, and long sessions now get their scores.", "created_date": 1793331444, "id": "39957427190538636", "version": "1.0", "version_code": 10, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "35507074085573991", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "40449825211298829"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "2135937740537530"}]}, "change_log": "\u2022 Fixed a crash on launch on Quest 2 and Quest 3S.\n\u2022 Seated play: your eye height now sets itself when you sit down.\n\u2022 Hints only appear when you press Hint.\n\u2022 Tapping a word now shows its meaning almost instantly.\n\u2022 New Exit button in missions. It checks before you leave, then shows your results.\n\u2022 Echo the bartender has a fresh new look.\n\u2022 The ship tour now picks up where you left off.", "created_date": 1792243837, "id": "39631468939801131", "version": "1.0", "version_code": 9, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "35507074085573991", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "40449825211298829"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "2135937740537530"}]}, "change_log": null, "created_date": 1788284758, "id": "38462650303349673", "version": "1.0", "version_code": 8, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}]}}, "viewer": {"user": null}}}
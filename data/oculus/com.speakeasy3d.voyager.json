": [{"file_name": "1.mission-select.png", "id": "2284383598973641", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499619672_2284383602306974_4421830063687590778_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=t3KmBE00Hz8Q7kNvwE1n_a-&_nc_oc=AdoOHIrfWlVeHlwJgdl6E1fVs8ZKw3TDK1iv6yJNHzw3G8-NtWOLF4rY1OaAy6nrm0Q&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT_7VsKJoKXpKJQkJTjtMQeXbkfgFIHpoxKtQqNkWuZzQ&oe=6AEDEE8B"}, {"file_name": "2.mission-beach-ja.png", "id": "4454086104842469", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499622315_4454086111509135_867161465027670304_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ar3vW1wAVX0Q7kNvwHKeV9i&_nc_oc=Adr8j3SPGlH7siDQfscL7JP0VjxCS6Y3W1zqImn3jSZqBE4Ske8dlaRJfWI35HsfPEk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSdhGz82nofQxJfdf8CHsEMtUGBDsFntPa_EOs22x1qhQ&oe=6AEDFF81"}, {"file_name": "3.mission-complete.png", "id": "1557714629484346", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499619668_1557714632817679_7453748550533466213_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UCBddOiF7oIQ7kNvwE6HWDa&_nc_oc=AdoTLtUGvMfP3jVYX277nuTcUlSkef2l78L8XaWB-Sak51gD56Rs1OMZvDBCHqfG5XI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQRhOXuQQ6xy_K6bmkODlQIq3AVwwaL5L7DFLvxAT_Jlg&oe=6AEDF329"}, {"file_name": "4.engine-room-console.png", "id": "1703198864087567", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499619681_1703198867420900_8564971524921059747_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=We77grMUh_YQ7kNvwFMFowt&_nc_oc=Adrgpyyogsg5JuVaG4euDsUIPnJdM7Cyds113bJWk98BPWa2grojdFBFB6bijrDQdrU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQNKlkhZOji7n1nHZCoJ90ZxRpvbsZRO8fPoorB4BFjaQ&oe=6AEDDA49"}, {"file_name": "5.observatory.png", "id": "1593436605644367", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499624983_1593436608977700_6405424822980506767_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TgvNPuIlpRgQ7kNvwGFCb8K&_nc_oc=Adroj5C85sJEyZUjJ8TdjtDeouEJ2bHTHtXcASUgaTEZC8gkNJ6odz-yOVtS-rVVIgg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS11NGyGIoX44m6EFlXRZYI55h1uyaW637gAlLiG6vIDw&oe=6AEDF819"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_moon_2560x1440.png", "id": "1031214936367723", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499620504_1031214939701056_8813146852024938964_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j537MDmZ1A0Q7kNvwGX1wiz&_nc_oc=AdqpsqH81D7M_vs0AQwwiv7sAHAXHFRp2mPYyrGV8qu2GLcjwoqfZg3O3ku4--50Iuc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSybSmi1XgByTI38ewccDsX3MF4pqvkmTOriEoBhE32Kg&oe=6AEDF2D5"}, "display_name": "Speakeasy3D", "keywords": ["speakingpractice", "languagelearning", "communicationskills", "aitutor", "interviewpractice"], "long_description": "Practice real conversations, out loud, with people who aren't real.\n\nSpeakeasy3D puts you somewhere you've never been, with someone you need to talk to. A hiring manager. A stranger at a party. A barista in a language you're learning. Step into the room. See who you're talking to. Feel what it's like before it counts.\n\nYou speak, they answer, and the conversation goes wherever you take it.\n\nNothing is scripted. Every scenario is generated fresh and personalized to you. They adapt to your pace, respond to what you actually say, and never judge. Run the same conversation ten times and it will go ten different ways.\n\nPRACTICE THINGS LIKE\n\n- Job interviews and performance reviews\n- Presentations and speaking up in meetings\n- Small talk, introductions, meeting new people\n- Difficult conversations: disagreeing, saying no, raising a problem\n- Everyday life in a language you're still learning\n\nLanguages include English, Spanish, Chinese, Portuguese, Japanese, Korean, and more.\n\nEvery session gives you clear objectives, real-time feedback, and a record of how you're doing over time.\n\nNo one is watching. No one is scoring you in front of anyone. You can get it wrong as many times as you need to.\n\nFREE: a conversation a day, every day. No card required.\nPREMIUM: longer conversations, and more of them. One subscription works across VR and web.\n\nFOR SCHOOLS AND CLINICS\nReal-time emotion tracking, learner dashboard, assignments, and reports.\nMore at speakeasy3d.com/professionals.", "short_description": "Rehearse job interviews, difficult conversations, and real-world speaking scenarios. Practice in your own language or learn a new one. Someone always talks back."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.speakeasy3d.com/privacy", "developer_terms_of_service_url": "https://www.speakeasy3d.com/terms", "publisher_name": "Speakeasy3D", "support_website_url": "https://www.speakeasy3d.com/support", "website_url": "https://www.speakeasy3d.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "35507074135573986"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499300661_1499523371931317_1958021944841961268_n.png?stp=dst-png_s360x360&_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NqwNKyplOyAQ7kNvwF9-4FM&_nc_oc=AdrqNaLjO3KblcO0iN3qL155SgQKwOtqMxFo7v_pQ3NNlciIROhPZ0a7qHlZLHedlC4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh
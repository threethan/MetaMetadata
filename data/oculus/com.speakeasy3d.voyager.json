ntent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS5L2PibczMWiC2_L1-3uJ2cFwnZdxaGehENZVsAT_sZw&oe=6B047C09"}, {"file_name": "5.observatory.png", "id": "1593436605644367", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499624983_1593436608977700_6405424822980506767_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bHi0iVZL6hIQ7kNvwFl8Zf2&_nc_oc=AdoJhitNqyxWY5w4vafmnS7yC8kGI5CAMcNBWbd0c05NqNin3UrZSHc3TLITFg1RMPE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS67CyXeg5MLX-lQla6AEO0pJnYSpuqkAxSFLefoDoLyg&oe=6B046199"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_moon_2560x1440.png", "id": "1031214936367723", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499620504_1031214939701056_8813146852024938964_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aFnMiy6a4R4Q7kNvwGKqdjp&_nc_oc=AdpP2Mh2cG7egaaHy7thGF94q6Zgb_FACpZaUa6J6by0TIpN9ZmKdGUDzy3eHtC9hso&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSaWGpDGPomVYaz96K76fuldt1bUgWswZb7Y7aPzYHAfA&oe=6B045C55"}, "display_name": "Speakeasy3D", "keywords": ["speakingpractice", "languagelearning", "communicationskills", "aitutor", "interviewpractice"], "long_description": "Practice real conversations, out loud, with people who aren't real.\n\nSpeakeasy3D puts you somewhere you've never been, with someone you need to talk to. A hiring manager. A stranger at a party. A barista in a language you're learning. Step into the room. See who you're talking to. Feel what it's like before it counts.\n\nYou speak, they answer, and the conversation goes wherever you take it.\n\nNothing is scripted. Every scenario is generated fresh and personalized to you. They adapt to your pace, respond to what you actually say, and never judge. Run the same conversation ten times and it will go ten different ways.\n\nPRACTICE THINGS LIKE\n\n- Job interviews and performance reviews\n- Presentations and speaking up in meetings\n- Small talk, introductions, meeting new people\n- Difficult conversations: disagreeing, saying no, raising a problem\n- Everyday life in a language you're still learning\n\nLanguages include English, Spanish, Chinese, Portuguese, Japanese, Korean, and more.\n\nEvery session gives you clear objectives, real-time feedback, and a record of how you're doing over time.\n\nNo one is watching. No one is scoring you in front of anyone. You can get it wrong as many times as you need to.\n\nFREE: a conversation a day, every day. No card required.\nPREMIUM: longer conversations, and more of them. One subscription works across VR and web.\n\nFOR SCHOOLS AND CLINICS\nReal-time emotion tracking, learner dashboard, assignments, and reports.\nMore at speakeasy3d.com/professionals.", "short_description": "Rehearse job interviews, difficult conversations, and real-world speaking scenarios. Practice in your own language or learn a new one. Someone always talks back."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.speakeasy3d.com/privacy", "developer_terms_of_service_url": "https://www.speakeasy3d.com/terms", "publisher_name": "Speakeasy3D", "support_website_url": "https://www.speakeasy3d.com/support", "website_url": "https://www.speakeasy3d.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "35507074135573986"}, "review_messages": []}
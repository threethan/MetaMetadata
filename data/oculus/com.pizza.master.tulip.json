248", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473391716_1169005151454581_8754893018437061468_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-1hkEt0DPHAQ7kNvwF0qO2J&_nc_oc=AdmA-rKNuiep-c8pvmbS5j_l125VP0appp_Gvc0AYmkUFJbHCdshO95Iwkx-kna8IOw&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfvrH5V6v3FJxifYPsuP4DepZfZYpB6YvBq3ZnAoXYVo7Q&oe=699B0352"}, {"file_name": "4.png", "id": "2368572783525284", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473391837_2368572786858617_4643564471657020341_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QBsf6LBptfAQ7kNvwFD_I4K&_nc_oc=AdkOFdZoDABl3ziY2Gtw2Wn9wZhNJkPFxZXMx_eEOA7wpTRXk8jNa4e_LPkvAsKK3iI&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfsH8oPtgJFMrLAa_Hf76Qr5edNYvYaa12-oO1QY8cvxOQ&oe=699AE0D1"}, {"file_name": "5.png", "id": "495042246984604", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473393158_495042250317937_2120724741945863745_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QhNWRRGEB70Q7kNvwGokZy2&_nc_oc=AdlpUB95NYclBDL2ydGppYkle9DAYbwU3QLiGNvRniArOJNGZIPcmT6nbH_-Jy4iIks&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AfuHWy7Jn1jZqnNG9aRJjtG5jShn4v0pmmBcQCH07nMY2w&oe=699AF41B"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Pizza Master VR - Pizza Cooking Game", "keywords": [], "long_description": "Welcome to Pizza Master VR, the ultimate virtual reality experience for pizza lovers and aspiring chefs! Step into a colorful, bustling pizzeria where your culinary skills are put to the test. In this immersive game, you\u2019ll have the opportunity to create a variety of delicious pizzas from scratch. \n\nGather fresh ingredients, knead your dough, and experiment with toppings to craft the perfect pie. Manage your time and resources wisely as you serve a diverse array of customers, each with unique tastes and preferences. \n\nWith intuitive controls and engaging gameplay, Pizza Master VR offers fun challenges and rewards that will keep you coming back for more. Whether you\u2019re a seasoned chef or a casual player, you\u2019ll enjoy the satisfying process of building your pizza empire. Are you ready to become the Pizza Master?", "short_description": "Dive into the delicious world of Pizza Master VR! Create, bake, and serve mouth-watering pizzas in a vibrant virtual kitchen. Perfect your recipes, manage your pizzeria, and satisfy your customers in this immersive cooking experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://tulipapps.com/meta-quest-privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Tulip Apps", "support_website_url": null, "website_url": "https://www.tulipapps.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "1043107547362485"}, {"id": "821934236779161"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "28279723208341884"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473392309_528120093028151_3723906438292141194_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3Zgse4i_qwMQ7kNvwF-wYuX&_nc_oc=AdlHHWGCoNF369aVpTADiE0tr-QQor0137_DNyHrjdEtHXkIJXemXIFxr5EmCH-sQ3E&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AftmxH9qhafEDER6VQGNK6ClQb8ZVEBxzXiNiarihgW7yw&oe=699B0332"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Pizza Master VR - Pizza
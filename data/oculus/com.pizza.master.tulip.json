o_trailer": null, "video_trailer_thumbnail": null, "display_name": "Pizza Master VR - Pizza Cooking Game", "keywords": [], "long_description": "Welcome to Pizza Master VR, the ultimate virtual reality experience for pizza lovers and aspiring chefs! Step into a colorful, bustling pizzeria where your culinary skills are put to the test. In this immersive game, you\u2019ll have the opportunity to create a variety of delicious pizzas from scratch. \n\nGather fresh ingredients, knead your dough, and experiment with toppings to craft the perfect pie. Manage your time and resources wisely as you serve a diverse array of customers, each with unique tastes and preferences. \n\nWith intuitive controls and engaging gameplay, Pizza Master VR offers fun challenges and rewards that will keep you coming back for more. Whether you\u2019re a seasoned chef or a casual player, you\u2019ll enjoy the satisfying process of building your pizza empire. Are you ready to become the Pizza Master?", "short_description": "Dive into the delicious world of Pizza Master VR! Create, bake, and serve mouth-watering pizzas in a vibrant virtual kitchen. Perfect your recipes, manage your pizzeria, and satisfy your customers in this immersive cooking experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://tulipapps.com/meta-quest-privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Tulip Apps", "support_website_url": null, "website_url": "https://www.tulipapps.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "1043107547362485"}, {"id": "821934236779161"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, 
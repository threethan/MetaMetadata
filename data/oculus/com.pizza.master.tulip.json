=6AA15DD2"}, {"file_name": "4.png", "id": "2368572783525284", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/473391837_2368572786858617_4643564471657020341_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=80zzawFpcOoQ7kNvwGrKI8o&_nc_oc=AdqQymg2bECAAi1v01-tpmzmVjTHjPIVPiT1pDgoTArKHc8vH0taA0od5Be1G0hhrHg&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKGDJ0hRrK_CVq37bmqKj-upcAQos_8rZZmfl1BTMrYfg&oe=6AA17391"}, {"file_name": "5.png", "id": "495042246984604", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/473393158_495042250317937_2120724741945863745_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sUysdDN_2i4Q7kNvwEk5Tu_&_nc_oc=AdqYVThkE260dt9bfBx9MYqx-NoNHfUxuUu2rw_Iz_CQEPD-ZzJZWACXibp5DN0iukQ&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJs7KsIh8RHMbbgHC3qguq7B3ifU_5yRhKG2iRFZ91Edw&oe=6AA14E9B"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Pizza Master VR - Pizza Cooking Game", "keywords": [], "long_description": "Welcome to Pizza Master VR, the ultimate virtual reality experience for pizza lovers and aspiring chefs! Step into a colorful, bustling pizzeria where your culinary skills are put to the test. In this immersive game, you\u2019ll have the opportunity to create a variety of delicious pizzas from scratch. \n\nGather fresh ingredients, knead your dough, and experiment with toppings to craft the perfect pie. Manage your time and resources wisely as you serve a diverse array of customers, each with unique tastes and preferences. \n\nWith intuitive controls and engaging gameplay, Pizza Master VR offers fun challenges and rewards that will keep you coming back for more. Whether you\u2019re a seasoned chef or a casual player, you\u2019ll enjoy the satisfying process of building your pizza empire. Are you ready to become the Pizza Master?", "short_description": "Dive into the delicious world of Pizza Master VR! Create, bake, and serve mouth-watering pizzas in a vibrant vir
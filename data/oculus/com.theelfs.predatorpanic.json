FUNXr5&_nc_oc=AdqnulHJSlvvIYeOAlklMGGPLqhl1p_lme2vJeSHALzllYJnMOo2HG-a9cdeWfRmbbw&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTQ2SO80zpQnJgndtjUGmHV2yLyar7bErTlPEW4wS81dQ&oe=6B099AA6"}]}, "id": "2671655253305363", "locale": "en_US", "screenshots": [{"file_name": "1_tranq_dart_trex.png", "id": "1506881711251217", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499619059_1506881714584550_5549942415800019265_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=citVIk2mvI0Q7kNvwFcxN4V&_nc_oc=AdrsuTjDWWeH2EhwKHD52YielLW5c26o-QKAd9Ecqk9Q4M0zP0eGsaN8YViyaTq9jeg&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQb_eg-1MavIFWmpKfCGpKLeJl6l2auCXPItV0znWD_tg&oe=6B09ABC4"}, {"file_name": "2_hatchery_eggs.png", "id": "906367295776882", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/499623558_906367299110215_428196896613600606_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6FAlDgfIHMwQ7kNvwEV4cfZ&_nc_oc=AdqOAX82_i3AbulR6TeYIa3awIYcT8VNystSIkEsrp30R2-FlYOWhnJuXo2O-Nl_oz0&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS1nX98MQC3CqoyNrffqrWZzvAOWxYNH3anFXh-e9NB7w&oe=6B09BAB3"}, {"file_name": "3_trex_cave.png", "id": "1638102284438113", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/593727470_1638102287771446_6470320548502860473_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HBlFcjtW_6kQ7kNvwGtzMQN&_nc_oc=AdpnFKRQ01IHJdRatirMJSdwACY8zANTIpa5NRjoHQAZ4F3aDtqd9Brf8zHodDowECk&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS6WPqnKMK_u_rI3ORz169LDDgmd243Gb1iw90UAps5MA&oe=6B09C76D"}, {"file_name": "4_lobby_friends.png", "id": "2290596058400803", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499620655_2290596061734136_2482598566572495394_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tAY5VcJfZ2YQ7kNvwE8F1F0&_nc_oc=AdqW-YY8A1thxiOlQwVASqPvbIfFy21WAzR9GQYYSvGLsHJ3ylk-D5byGew7tMDyiAU&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTDpsoizu8NQpapGbJvULS0128Do8NbhS514dca3EOvqg&oe=6B09C6E6"}, {"file_name": "5_spectrex_thermal.png", "id": "1609949894212204", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499628016_1609949897545537_4509681696136135918_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5xQr_1ijJvMQ7kNvwGANpCo&_nc_oc=AdotUL-pX7tPUtfmccCB37eWsDmcd7vHGmYFfzc7dzO5pbLVNFnzTLJHYNCwr_C8BD8&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT-7gO6pqsl5zC5kIbo-frzOhkVQSrjYhpFsoilHmnosQ&oe=6B09BFB2"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Predator Panic", "keywords": ["dinosaur", "monkey", "horror", "multiplayer", "heist"], "long_description": "Predator Panic is a VR heist with no buttons for walking. You move like a monkey: push off the ground, swing your arms and climb trees with your own hands.\n\nSTEAL THE EGGS\nSneak into nests guarded by real-size dinosaurs, by day or by night, and grab all the eggs you dare. Get caught and they spill.\n\nNEW: YOUR OWN CAMERA\nFilm videos and take photos in VR. It can follow you, see through your eyes or float still for the perfect shot.\n\nSIX HUNTERS\n- The Hatchery: sleeping raptors. One loud slap wakes them.\n- The Dried River: a Metriacanthosaurus rams the tree you hide in.\n- The Volcano: a T-Rex that only sees what moves.\n- The Paddock: the Spectrex turns invisible. Use thermal goggles.\n- The Ocean: dive to a shipwreck for Tylosaurus eggs.\n- The Frozen Peak: a Yutyrannus tracks you in the snow.\n\nBIG FREE PLAY\nA giant map for your whole room, every hunter at once and chaos every 2 minutes. Drive jeeps, survive!\n\nBELOW ZERO\nFind 6 clues to open the Mine Lift, then hide from what lives down there.\n\nGEAR UP\nSell eggs for coins. Buy grenades, tranq darts, flares, a mini-sub and 35 cosmetics.\n\nMINI GAMES\n- Zombie Waves: endless zombies, dual wield, leaderboards.\n- Dino Hunt: one player is the dinosaur, the rest escape.\n- Fossil Dig: dig up fossils. Beware the Spinosaurus!\n\nPLAY TOGETHER\nRoom codes or public rooms, up to 10 players, with proximity voice chat. Share fan art in our Discord!\n\nOnline play needs an internet connection. Mute, block and report tools are built in.", "short_description": "You're a monkey. They're dinosaurs. Swing, climb and sprint with your own arms through jungle, volcano, ruined paddock, open ocean and a frozen mountain to steal dinosaur eggs, then get out before you're caught. Play alone, or team up with friends online with proximity voice chat. Uncover the secret world Below Zero. Sell your eggs, deck out your monkey and gear up for the next heist. Or fight off zombie waves, hunt your friends as a dinosaur, or dig up fossils in the desert."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/e/2PACX-1vQMjGyBv-i-ccBx-KNN-Z-KArWTlefdxQGKYPZ4PJO6bLu2Z0fnub3BA43Q1AkSYvigMQ7hFTYZl0BG/pub", "developer_terms_of_service_url": null, "publisher_name": "THE ELFS", "support_website_url": null, "website_url": "https://docs.google.com/document/d/e/2PACX-1vRrjpTQ0-WCR16KDZ3o9tRJ9-JvSyauYlaK9YEc_moA_sH8NfCtjVOR9IzlEo026S42_aHEVDG2Qxit/pub", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "644354873106712"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER"], "id": "1
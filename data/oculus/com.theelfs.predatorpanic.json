00.png", "id": "1668436681510024", "image_type": "APP_IMG_HERO", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/673689288_1668436684843357_768037357695738885_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7FqdKJGiYEoQ7kNvwHDuoPJ&_nc_oc=AdrMJ4Kgj76QdnWVDxYsDlvHf3ho9SG6hZIeNetedTyjXB-qqrlON2G7qwMDr_OgofE&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRemC6d_Gc2-hCoa0rlqep6hZb2G2QMaK1h6dl8DPaQpg&oe=6B09A04D"}, {"file_name": "Cover_Square_1440x1440.png", "id": "1126851309927087", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/673819499_1126851313260420_9154707588230147183_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j0cW8VCoAw4Q7kNvwErj_LA&_nc_oc=AdqQR1sQUhU28foz6aN26hyOw0VVXm7l7ZIlUiiIBpThfx0VM9ZI9cWnwshrJLKZFtI&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRY2KBG_FNY0_f9Q387KBhEpRVwNHCY5CKVx03w9bxROQ&oe=6B09C3C1"}, {"file_name": "Icon_512x512.png", "id": "1102620385908919", "image_type": "APP_IMG_ICON", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/604355710_1102620389242252_805985217347596662_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eaoZyxV7uXgQ7kNvwFFVi9E&_nc_oc=AdrfRH4L4q5f4XJ6YBfNH_YXirmZ4e9BdQ4PAt65LbjDXONiJ84kkqi9OMNjhUC_xUY&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSPwAUc6wsVG68hT_Ghrbwtii3iiJUiOj1UDc_BxFdgDA&oe=6B09AE80"}, {"file_name": "uba_APP_IMG_COVER_LANDSCAPE.png", "id": "1093703286796056", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491831299_1093703290129389_1926611723527690975_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=srag7idPE_cQ7kNvwFUNXr5&_nc_oc=AdqnulHJSlvvIYeOAlklMGGPLqhl1p_lme2vJeSHALzllYJnMOo2HG-a9cdeWfRmbbw&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTQ2SO80zpQnJgndtjUGmHV2yLyar7bErTlPEW4wS81dQ&oe=6B099AA6"}]}, "id": "1441383964019269", "locale": "en_US", "screenshots": [{"file_name": "1_tranq_dart_trex.png", "id": "1506881711251217", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499619059_1506881714584550_5549942415800019265_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=citVIk2mvI0Q7kNvwFcxN4V&_nc_oc=AdrsuTjDWWeH2EhwKHD52YielLW5c26o-QKAd9Ecqk9Q4M0zP0eGsaN8YViyaTq9jeg&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQb_eg-1MavIFWmpKfCGpKLeJl6l2auCXPItV0znWD_tg&oe=6B09ABC4"}, {"file_name": "2_hatchery_eggs.png", "id": "906367295776882", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/499623558_906367299110215_428196896613600606_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6FAlDgfIHMwQ7kNvwEV4cfZ&_nc_oc=AdqOAX82_i3AbulR6TeYIa3awIYcT8VNystSIkEsrp30R2-FlYOWhnJuXo2O-Nl_oz0&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS1nX98MQC3CqoyNrffqrWZzvAOWxYNH3anFXh-e9NB7w&oe=6B09BAB3"}, {"file_name": "3_trex_cave.png", "id": "1638102284438113", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/593727470_1638102287771446_6470320548502860473_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HBlFcjtW_6kQ7kNvwGtzMQN&_nc_oc=AdpnFKRQ01IHJdRatirMJSdwACY8zANTIpa5NRjoHQAZ4F3aDtqd9Brf8zHodDowECk&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS6WPqnKMK_u_rI3ORz169LDDgmd243Gb1iw90UAps5MA&oe=6B09C76D"}, {"file_name": "4_lobby_friends.png", "id": "2290596058400803", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499620655_2290596061734136_2482598566572495394_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tAY5VcJfZ2YQ7kNvwE8F1F0&_nc_oc=AdqW-YY8A1thxiOlQwVASqPvbIfFy21WAzR9GQYYSvGLsHJ3ylk-D5byGew7tMDyiAU&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTDpsoizu8NQpapGbJvULS0128Do8NbhS514dca3EOvqg&oe=6B09C6E6"}, {"file_name": "5_spectrex_thermal.png", "id": "1609949894212204", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499628016_1609949897545537_4509681696136135918_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5xQr_1ijJvMQ7kNvwGANpCo&_nc_oc=AdotUL-pX7tPUtfmccCB37eWsDmcd7vHGmYFfzc7dzO5pbLVNFnzTLJHYNCwr_C8BD8&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT-7gO6pqsl5zC5kIbo-frzOhkVQSrjYhpFsoilHmnosQ&oe=6B09BFB2"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Predator Panic", "keywords": ["dinosaur", "monkey", "horror", "multiplayer", "heist"], "long_description": "Predator Panic is a VR heist with no buttons for walking. You move like a monkey: push off the ground, swing your arms and climb trees with your own hands.\n\nSTEAL THE EGGS\nSneak into nests guarded by real-size dinosaurs and grab as many eggs as you dare. Every egg makes your bag heavier and slower. Get caught and your eggs spill on the ground.\n\nFOUR HUNTERS, FOUR WAYS TO SURVIVE\n- The Hatchery: raptors sleep on their nests. One loud slap and they wake up.\n- The Dried River: a Metriacanthosaurus that hunts alone and rams the tree you're hiding in.\n- The Volcano: a T-Rex that only sees what moves. Freeze, or hide in the caves.\n- The Paddock: the Spectrex camouflages itself. Listen for it, or spot it with thermal goggles.\nThe longer you stay, the darker it gets and the sharper they hunt.\n\nGEAR UP\nSell eggs at the station's incubator for coins. Spend them on stun grenades, tranquilizer darts, flares, smoke bombs, bigger backpacks and thermal goggles, plus around 20 cosmetics, from leaf crowns to a T-Rex head helmet.\n\nPLAY TOGETHER\nJoin a room with a code or go public. Ride the party elevators down in a team of up to 6. The dinosaurs get tougher with every extra player, and every egg is shared with the whole team. Proximity voice chat lets you whisper plans, or scream.\n\nOr just climb the giant trees of the free-play jungle and try to stay away from the raptors.\n\nOnline play needs an internet connection. Mute, block and report tools are built in.", "short_description": "You're a monkey. They're dinosaurs. Swing, climb and sprint with your own arms through jungle, volcano and ruined paddock to steal dinosaur eggs from right under their noses, then get out before you're caught. Play alone, or team up with friends online and hear each other with proximity voice chat. Sell your eggs, deck out your monkey and gear up for the next heist."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/e/2PACX-1vQMjGyBv-i-ccBx-KNN-Z-KArWTlefdxQGKYPZ4PJO6bLu2Z0fnub3BA43Q1AkSYvigMQ7hFTYZl0BG/pub", "developer_terms_of_service_url": null, "publisher_name": "THE ELFS", "support_website_url": null, "website_url": "https://docs.google.com/document/d/e/2PACX-1vRrjpTQ0-WCR16KDZ3o9tRJ9-JvSyauYlaK9YEc_moA_sH8NfCtjVOR9IzlEo026S42_aHEVDG2Qxit/pub", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "644354873106712"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER"], "id": "1425212460672622"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1490841462861602"}]}, "baseline_offer": {"id": "1490841462861602"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1793453820, "status": "PUBLISHED", "id": "1490841462861602"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1481651595028708", "version": "0.18.1"}, "id": "2120728465479090", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1415746381619230", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1481651595028708"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "2120728465479090"}]}, "change_log": "Update 0.18.1\n\n- The game's files are packed in a new way, so the next updates can bring more levels and more dinosaurs.\n- A smaller download, with no change to how anything looks or sounds.", "created_date": 1795395783, "id": "1481651595028708", "version": "0.18.1", "version_code": 35, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": {"id": "1481650851695449"}, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1415746381619230", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1481651595028708"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "2120728465479090"}]}, "change_log": "Update 0.17.1: THE CAMERA IS NOW A BIG TABLET!\r\n\r\nNEW: THE CAMERA TABLET\r\n\r\nYour camera is now a big tablet, and you keep it on your back. Reach over your left shoulder and grip to take it.\r\nTouch the buttons round its screen with your other hand: the modes along the bottom, zoom on the left, and video, photo, record and MENU on the right.\r\nPull the trigger, or touch REC, to record a video or take a photo.\r\nIn FOLLOW, EYES and FLOAT the whole tablet flies.\r\nWith your egg bag on, the tablet rides on the back of the bag. Reach past the top of the bag for it.\r\nFIXES\r\n\r\nFixed Free Play's dinosaurs freezing for your friends when lots of them were out.", "created_date": 1795191557, "id": "1477329665460901", "version": "0.17.1", "version_code": 33, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1415746381619230", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1481651595028708"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "2120728465479090"}]}, "change_log": "Update 0.17.0: THE CAMERA!\r\n\r\nNEW: YOUR OWN CAMERA\r\n\r\nEveryone now has a camera clipped to the front of their belt. Reach down and grip to take it.\r\nPull the trigger to record a video or take a photo. Videos have the game's sound, your friends' voices and your own.\r\nPress MENU on its back to pick how it films:\r\nHANDHELD: films whatever you point it at.\r\nSELFIE: turns round and films you.\r\nFOLLOW: let go and it flies behind you (or a friend) and follows.\r\nEYES: films exactly what you (or a friend) see.\r\nFLOAT: let go and it stays in the air right there, for the perfect shot.\r\nThree shapes: 16:9, 9:16 (for shorts) and square.\r\nLooks: night vision, black and white, and old VHS tape.\r\nZoom, smoothness, a 3-2-1 photo timer, and CLEAN SHOT to hide menus and name tags.\r\nWhile the camera's away from you, a remote on your left wrist shows what it sees, starts and stops recording, and calls it back.\r\nMY VOICE: keep your own voice out of your videos. Turning your mic off in the wrist menu keeps it out too.\r\nEveryone sees your camera, with a red light while it records.\r\nVideos are saved on your headset in Movies, and photos in Pictures (both in a \"Predator Panic\" folder).\r\nFREE PLAY FIXES\r\n\r\nA friend who leaves Free Play and comes straight back in can see you again.\r\nEvents now happen at the same time for everyone in the room.\r\nA friend driving a jeep no longer looks like they're floating with no jeep.", "created_date": 1795149071, "id": "1476354582225076", "version": "0.17.0", "version_code": 32, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1415746381619230", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1481651595028708"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "2120728465479090"}]}, "change_log": "Update 0.16.0: DAY AND NIGHT!\r\n\r\nNEW: DAY AND NIGHT\r\n\r\nEvery level now has day and night. You start in the day, and after a few minutes the sun sets... with no warning.\r\nAt night, tap the side of your head to switch your head lamp on or off. It comes on by itself at sunset.\r\nIn the dark the dinosaurs only spot you up close, unless your lamp gives you away.\r\nTheir eyes glow in the dark.\r\nNight brings creepy music and night sounds: far-off roars, growls nearby and footsteps that shake the ground.\r\nSCARIER CATCHES\r\n\r\nEvery hunter now catches you its own way. Raptors claw at you, the Metriacanthosaurus rams you, the T-Rex comes down from above, the Spectrex appears out of nowhere, the Yutyrannus bursts out of the snow and the Tylosaurus drags you under.\r\nBelow Zero: the Troodon pack leaps at you from all sides, and B2's hunter slashes with its giant claws. Creepy music and sounds down there too.\r\nThe Ocean Cruiser's chomp is scarier: the lights flicker and die and the glass cracks.\r\nFREE PLAY\r\n\r\nNIGHT FALLS!: a new event that turns day into night for 2 minutes. Head lamps and jeep lights come on, and eyes glow in the dark. It replaces the blackout.\r\nThe volcano eruption is huge now: giant glowing rocks that leave burning craters, knock you flying, knock dinosaurs down and blow up jeeps!\r\nFIXES\r\n\r\nLevel 1, LIGHT FINGERS: the patrol raptor no longer knows every time you take an egg. It has to see you, or be right next to the nest.\r\nBigger backpacks now stay in your hand right where you grab them.\r\nB2: a rock wall no longer hides the lift, and the hunter can't get stuck behind a wall.\r\nThe Spinosaurus's eyes now glow on its eyes, not above them.", "created_date": 1795127200, "id": "1475940795599788", "version": "0.16.0", "version_code": 31, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1415746381619230", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1481651595028708"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "2120728465479090"}]}, "change_log": "Update 0.15.0: BIG FREE PLAY!\r\n\r\nNEW: BIG FREE PLAY\r\n- Go through the big blast door in the Expeditions hall to reach a giant new map. It replaces the old small jungle.\r\n- Everyone in your room who comes through lands on the same map, up to 10 players!\r\n- Every hunter is out at once: raptors, the Metriacanthosaurus, the T-Rex, the Spectrex, the Yutyrannus and a Spinosaurus. They roam everywhere, so split up and see who you run into.\r\n- In the desert, the Spinosaurus swims under the sand with only its sail showing... until it bursts out.\r\n- Every 2 minutes something big happens: a raptor stampede, a blackout where only their eyes glow, a volcano eruption, a giant boss or a lightning storm.\r\n- Drive old park jeeps with your friends. Big dinosaurs can flip them!\r\n- A map on your wrist shows you, your friends and the way back to camp.\r\n- Your gear refills here, so use it as much as you like.\r\n- The camp is the only safe place. Get caught and you wake up back there.\r\n\r\nSINGLE PLAYER\r\n- Every elevator has a new SINGLE PLAYER key. Step in alone, pick a level and press it to play on your own, even while you're in a room.", "created_date": 1794791099, "id": "1468661892994345", "version": "0.15.0", "version_code": 24, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}]}}, "viewer": {"user": null}}}
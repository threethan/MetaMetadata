Q7kNvwHQTFba&_nc_oc=AdmwI5OfBNcclsXIpFZIH-LahKa6sM9ZBM2dOqIffC-syM1sNa52Z5hzFafYLqn5jWY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_Afxczefz-WoR5AX-M2TK2kX0yztik9PqIADt6AQ_YwEFjg&oe=69B9498B"}, {"file_name": "Image_04.png", "id": "1529501658004327", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031363_1529501661337660_2665133323378119833_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6iX41cd0bFAQ7kNvwFqRRPl&_nc_oc=Adllz9zzo04dAFfyQVoGc8JfS7S9JEIQwHhNazcbfaOENkSaxeqAHcUIpO7CMpgE0vw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfzDNe0-9uGuJvvngskmyFXYJ0_6hcxwSOrSqBhYCR-JXQ&oe=69B9470D"}, {"file_name": "Image_05.png", "id": "824204526655177", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491827611_824204529988510_283305580378692137_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E_IUScF10FEQ7kNvwGWXKlH&_nc_oc=AdlnBH01jRcG8ymCsdyRNHDGUen0Gv7d2-miS2CVD1zDl33JdnmvDGmU1Tcksy9lvw0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_Afww8DbqBxmW_4JuvzylrpAyskb1P3QeQYB0ITk56jEwOQ&oe=69B94B52"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape.png", "id": "1374054834186854", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491820648_1374054840853520_6890075942571773963_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YlnFvFcsYg0Q7kNvwEK01a6&_nc_oc=Adl39k2Cmg0jHbVLiZaeVTRmSHaux4Ljncev0KMdCt5zJoAa7LFGwuVvK0exlgq0uPo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfzCMaTSnxl0pahhEcbetfYVxdhMUY4ZUk67gxsdNnH_-w&oe=69B950C6"}, "display_name": "RC Helicopter", "keywords": ["RC", "Helicopter", "Fly", "Drone", "Flight"], "long_description": "RC Helicopter is a video game simulating the flight of a small RC helicopter. Before playing the game, you need to scan the room in order to collide with real world objects.\n\nThe game includes 3 modes, free flight, drone race and demolition game.\n\nTry how to control such an RC helicopter right in your own room. With the difference that in this game the helicopter is unbreakable, so if you crash the helicopter into a wall, it won't be damaged and you can fly again.\n\nAnd enjoy all this starting from your room and the small helipad from where the helicopter takes off.\n\nTry how fast it will be on the racing circuit with a drone or demolish a few objects.", "short_description": "RC Helicopter is an mixed reality video game. Control your own small rc helicopter right in your room, try to control your own helicopter with the possibility of collision with real objects."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.alternative-vr.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Alternative VR", "support_website_url": null, "website_url": "https://www.alternative-vr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24827649896864210"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75303841_1636827486892876_1880226749718280975_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2TzPyfto_3sQ7kNvwFfm0Hv&_nc_oc=Adlq_fS5yo8uwcTTeJZFHAXr2IVyUVMsLZ6HVTTbVXBb3BqP7xyCTy9p2C8Vk2u_eYQ&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afw5iHy5_WoBOW2_zQMvxQ2tBI6Fcc8abnXEX7mbsT7Isg&oe=69B95360"}, "is_concept": false, "is_
}, {"file_name": "Image_04.png", "id": "1529501658004327", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031363_1529501661337660_2665133323378119833_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F5GR_8mLBZIQ7kNvwEploMP&_nc_oc=AdlgI0Qz4q_bKZuCAI5XiVmEBYi0qjFuachoFhpWZgkBgPcnNL9GIIN0FTQHz0xcVcM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AftvzS6NBFLx-ggv7o17g2LynZv4_1zW3dQV5hLCTCEUBQ&oe=69A03A8D"}, {"file_name": "Image_05.png", "id": "824204526655177", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491827611_824204529988510_283305580378692137_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BslpNnGl8RUQ7kNvwEQxTn2&_nc_oc=Adlm70BI11HQEsXMH9zvPGBMK4_8hIMk5ONFWKMpFCrc2fvRSXfCx-Fhqnp2uEvzweM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfuS1JYNBrci5JKCeKxw4MXlek0Xit2qg4Qt8SMM4tXatw&oe=69A03ED2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape.png", "id": "1374054834186854", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491820648_1374054840853520_6890075942571773963_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ydy15RLsVOAQ7kNvwEDfek2&_nc_oc=AdnxyNPHwkVjzXS5PLK2Utp4hhd2U5lYRx3gd2PhVXkLy3gydBTiUHAufwOo95Xj5TE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Aftho0qufJCa_80vVBRyQHyQQMafVXYa4Yk_B6DXidClJw&oe=69A04446"}, "display_name": "RC Helicopter", "keywords": ["RC", "Helicopter", "Fly", "Drone", "Flight"], "long_description": "RC Helicopter is a video game simulating the flight of a small RC helicopter. Before playing the game, you need to scan the room in order to collide with real world objects.\n\nThe game includes 3 modes, free flight, drone race and demolition game.\n\nTry how to control such an RC helicopter right in your own room. With the difference that in this game the helicopter is unbreakable, so if you crash the helicopter into a wall, it won't be damaged and you can fly again.\n\nAnd enjoy all this starting from your room and the small helipad from where the helicopter takes off.\n\nTry how fast it will be on the racing circuit with a drone or demolish a few objects.", "short_description": "RC Helicopter is an mixed reality video game. Control your own small rc helicopter right in your room, try to control your own helicopter with the possibility of collision with real objects."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.alternative-vr.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Alternative VR", "support_website_url": null, "website_url": "https://www.alternative-vr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24827649896864210"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75303841_1636827486892876_1880226749718280975_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y9K5tFyEhawQ7kNvwHA8GAG&_nc_oc=AdnIncqeoblnbAK9WJvY2u694VAP0DWJabiT4k4T1FlstEjCDtGpedmBVynBk963KUM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfuXUoRkDwVWQrj7y9dfIF818Kyb0i5BZNN4n807fn8AdA&oe=69A046E0"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "RC Helicopter", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Simulation", "id": "331529
Q7kNvwESpy_S&_nc_oc=Adl3IwzvP4GiuHXg2V8nYkDOEVszUE3jxaOpW-UkssqV6m8Y4EUFSGfAUuR8VVaoVTc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfxRDD09IMJgFCmgY4-XoveqPNZAuJUQnENyezujCalcKg&oe=69B2B20B"}, {"file_name": "Image_04.png", "id": "1529501658004327", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031363_1529501661337660_2665133323378119833_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M0M2mZy1lgcQ7kNvwESukpU&_nc_oc=Adm8Ov2jyTzi-7CTErO68WiHrVCaKuNGQavHVRkWM-au312MmryoPDzxqgf_inJjyDk&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfwmR99drRXhqhHoeVjD5WpVZqyz1bp2kRV8rhzMU5B6hA&oe=69B2AF8D"}, {"file_name": "Image_05.png", "id": "824204526655177", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491827611_824204529988510_283305580378692137_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lIfBcpPVCIcQ7kNvwFA8h58&_nc_oc=AdnR_nXRTVpj6pdxkgUKsd3ui60WnuqniT3MS34byZPB6-1z7BstQJThvlZyAto92vE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfwMbW4ayhriOrdF-w-XTZ6Ypv4t8_m7tyldCKwviWAkCA&oe=69B2B3D2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape.png", "id": "1374054834186854", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491820648_1374054840853520_6890075942571773963_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HPSvN54S_kgQ7kNvwG20zFF&_nc_oc=Adk3xuPC9DaCZz5-vHnFU65Mz37zQer363dX-oN8cY1hBi3rR7jVxKkFgh0mQmUXYy8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfzO-PV6FXddtREOJtqz41UxSWZxv-8wHBEBAWtZtetJTA&oe=69B2B946"}, "display_name": "RC Helicopter", "keywords": ["RC", "Helicopter", "Fly", "Drone", "Flight"], "long_description": "RC Helicopter is a video game simulating the flight of a small RC helicopter. Before playing the game, you need to scan the room in order to collide with real world objects.\n\nThe game includes 3 modes, free flight, drone race and demolition game.\n\nTry how to control such an RC helicopter right in your own room. With the difference that in this game the helicopter is unbreakable, so if you crash the helicopter into a wall, it won't be damaged and you can fly again.\n\nAnd enjoy all this starting from your room and the small helipad from where the helicopter takes off.\n\nTry how fast it will be on the racing circuit with a drone or demolish a few objects.", "short_description": "RC Helicopter is an mixed reality video game. Control your own small rc helicopter right in your room, try to control your own helicopter with the possibility of collision with real objects."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.alternative-vr.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Alternative VR", "support_website_url": null, "website_url": "https://www.alternative-vr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24827649896864210"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75303841_1636827486892876_1880226749718280975_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ITpwjXCWTUkQ7kNvwFzAhG_&_nc_oc=Adk_H7aTV4ENz3sefnCFodzMUDcYHxD_O-OcUVYaHpVrwKa6tjv-vUUpr_igvuYBHH8&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfxEDz7s0hXmogxsCpfkfdukGtEffh1iGgMwgu1igbgGXQ&oe=69B2BBE0"}, "is_concept": false, "is_
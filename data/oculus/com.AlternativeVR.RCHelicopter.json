Q7kNvwEoYy3l&_nc_oc=AdkEGH2VxTrWHfb4foaJgVjo_7FFSyQTV_ptL1sfKfBp5LrDcOybY3JoNCt2gssmqEk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfzSPpj5FFND40M3m0e5mr07R13BkYVMi5dGbT7-Ww5PTA&oe=69B6A68B"}, {"file_name": "Image_04.png", "id": "1529501658004327", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39031363_1529501661337660_2665133323378119833_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6iX41cd0bFAQ7kNvwFwXHgv&_nc_oc=AdlRLsKrYpRF4qTPExU61XeVKMHcrCP1a4iZu854z9j3ukVl4kiCN49yNgvwISBCixQ&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_Afy1jHc3gem3L-puZxyI5xfwDl2rzCjOX8vUxeOZs_ZMIQ&oe=69B6A40D"}, {"file_name": "Image_05.png", "id": "824204526655177", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491827611_824204529988510_283305580378692137_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yjfXn8HZwykQ7kNvwE-OMmL&_nc_oc=AdnSOKYNtrQJanQK8KMmFF8PpeR-LNw0K5MVqUWre7OqCPCZkllFN-oqgBI-Dk9Z9Qc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfzO1izYZg7Pyt7Y5tXSobMtkKxjjv9fNBBIIeKlp3pCHQ&oe=69B6A852"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape.png", "id": "1374054834186854", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491820648_1374054840853520_6890075942571773963_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J1khQCeWmf4Q7kNvwECv4Or&_nc_oc=Adl7tf55lH37bkhJRXa7q87RsMsEIzjTgNr_iRrKjjw-0Uf8OvjgQnFeFprhGOrvs1Q&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_Afwbm3Zmt0ZAu3YTmPzX7dqInEmjYQSxCk_8un8_PU_GAw&oe=69B6ADC6"}, "display_name": "RC Helicopter", "keywords": ["RC", "Helicopter", "Fly", "Drone", "Flight"], "long_description": "RC Helicopter is a video game simulating the flight of a small RC helicopter. Before playing the game, you need to scan the room in order to collide with real world objects.\n\nThe game includes 3 modes, free flight, drone race and demolition game.\n\nTry how to control such an RC helicopter right in your own room. With the difference that in this game the helicopter is unbreakable, so if you crash the helicopter into a wall, it won't be damaged and you can fly again.\n\nAnd enjoy all this starting from your room and the small helipad from where the helicopter takes off.\n\nTry how fast it will be on the racing circuit with a drone or demolish a few objects.", "short_description": "RC Helicopter is an mixed reality video game. Control your own small rc helicopter right in your room, try to control your own helicopter with the possibility of collision with real objects."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.alternative-vr.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Alternative VR", "support_website_url": null, "website_url": "https://www.alternative-vr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24827649896864210"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75303841_1636827486892876_1880226749718280975_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mXwyrYghqAEQ7kNvwGr4jWO&_nc_oc=Adl_RRBLqP1TNImAyfaNgRf-6TfxKgdJbFVrAhZaiaOc0O8Q2ltKmcqBQ29KDQ_fijw&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfxgKXBAmCzJqC62Uke7-N4BYwso0zkkZZA9vW1suQL2Jg&oe=69B6B060"}, "is_concept": false, "is_
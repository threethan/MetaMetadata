": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/39001688_1025343619230361_5639796744723679593_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QagleaXy_sUQ7kNvwHlkIUr&_nc_oc=AdpDGRcJ_q86ZLZq682sZli6jA2i1WmrVh4REWB_aWOrHi3FLDVThHKjIh8baUp9qqs&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-c2bxzLrx_atyZSom05dmKWJiT4Lg8d-Ip7nPBxGvCkw&oe=6A39634B"}, {"file_name": "Image_04.png", "id": "1529501658004327", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/39031363_1529501661337660_2665133323378119833_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qGdaHA3ZodAQ7kNvwELFONu&_nc_oc=Adpedw61su0ZLpdsF68NUj38qQRb4yMoupi4_YIhXlncYWlAzmVxjGBRcAOQFfzFfRQ&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_10SIdi2izOMSA5uMeWM4A2a3p3WOiPBU84FpcJ6O-ow&oe=6A3960CD"}, {"file_name": "Image_05.png", "id": "824204526655177", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/491827611_824204529988510_283305580378692137_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nm9qZRN14zUQ7kNvwFlyUnx&_nc_oc=AdpJcr9y4gw-kKIaKnxAqzb1_iYvmK7drY3DP_1QbYpSGMnnGdSx82ozwuFuOGdm7sQ&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8UZoKgaM0D6sb0kRbO631uKFERVmoAlz46LHZkqH5eRw&oe=6A392CD2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape.png", "id": "1374054834186854", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/491820648_1374054840853520_6890075942571773963_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ClfMc6hzlg4Q7kNvwFBIovQ&_nc_oc=AdotgM8GEPFlymff9EmrmyA1SorU_JrIOCeuBNY2GDbOPcG1cZZYu32IrWCVOrhvmMQ&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-6JjDDZwxOyFAdbA7utTpO2Zw0ANIf3CW-iLRUAL1lww&oe=6A393246"}, "display_name": "RC Helicopter", "keywords": ["RC", "Helicopter", "Fly", "Drone", "Flight"], "long_description": "RC Helicopter is a video game simulating the flight of a small RC helicopter. Before playing the game, you need to scan the room in order to collide with real world objects.\n\nThe game includes 3 modes, free flight, drone race and demolition game.\n\nTry how to control such an RC helicopter right in your own room. With the difference that in this game the helicopter is unbreakable, so if you crash the helicopter into a wall, it won't be damaged and you can fly again.\n\nAnd enjoy all this starting from your room and the small helipad from where the helicopter takes off.\n\nTry how fast it will be on the racing circuit with a drone or demolish a few objects.", "short_description": "RC Helicopter is an mixed reality video game. Control your own small rc helicopter right in your room, try to control your own helicopter with the possibility of collision with real objects."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.alternative-vr.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Alternative VR", "support_website_url": null, "website_url": "https://www.alternative-vr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24827649896864210"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/75303841_1636827486892876_1880226749718280975_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yITRMPkAzpMQ7kNvwH3qIX5&_nc_oc=Adoq-KUdsF3hSHtYTuJZ7VCEgQi9NdhOK-CF
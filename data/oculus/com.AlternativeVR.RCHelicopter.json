": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/39001688_1025343619230361_5639796744723679593_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M6sMUrITZ7gQ7kNvwFmVsMi&_nc_oc=Adp9PYpXvp3_JKUUPQGIuWxM6YNdd573H46LLtQvX-zKoDduIm9hzLMwBThP_5CQyWk&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLGBCw19XgQGdea_5NKmsl2mC3PnYtkhMzF_JUIo0mwXg&oe=6AAE808B"}, {"file_name": "Image_04.png", "id": "1529501658004327", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/39031363_1529501661337660_2665133323378119833_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KBaVQL2Tr2oQ7kNvwH1PmUH&_nc_oc=AdqRGDw4ojjzrgZsWU7Jc40802C2yz-R36fezL_gsFZIsLdE2Gs1vKCy4HTNkn9ZyW4&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLyR3j-SHpREFCYp0i7Ynat-5m90O6Ogw_t4CHdLXb8ow&oe=6AAE7E0D"}, {"file_name": "Image_05.png", "id": "824204526655177", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/491827611_824204529988510_283305580378692137_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HV6EDe5Phu8Q7kNvwHWRQcW&_nc_oc=AdpJQRJ0ZSewiwGCZYvVy50IPthvMHK0vtFHCzeU0KUZrV2r3LVY8KKyTNTMyoDXTT4&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ211b3ixJn15Es4D4TtbPOdHL29BsKuHFba4JB0dUj2w&oe=6AAE8252"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape.png", "id": "1374054834186854", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/491820648_1374054840853520_6890075942571773963_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aaW3e3KPf2gQ7kNvwGNvHh9&_nc_oc=AdpOD8DekUBGVoWbIS21t5X-pr9EA_CnE6jYj7GMRU11DncXkOmdhLqbP_wQrWwim-0&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKBQ2QlDIsHnWzYnSMGnXpo1xW-KJglBV8c9qyQTfAuUw&oe=6AAE87C6"}, "display_name": "RC Helicopter", "keywords": ["RC", "Helicopter", "Fly", "Drone", "Flight"], "long_description": "RC Helicopter is a video game simulating the flight of a small RC helicopter. Before playing the game, you need to scan the room in order to collide with real world objects.\n\nThe game includes 3 modes, free flight, drone race and demolition game.\n\nTry how to control such an RC helicopter right in your own room. With the difference that in this game the helicopter is unbreakable, so if you crash the helicopter into a wall, it won't be damaged and you can fly again.\n\nAnd enjoy all this starting from your room and the small helipad from where the helicopter takes off.\n\nTry how fast it will be on the racing circuit with a drone or demolish a few objects.", "short_description": "RC Helicopter is an mixed reality video game. Control your own small rc helicopter right in your room, try to control your own helicopter with the possibility of collision with real objects."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.alternative-vr.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Alternative VR", "support_website_url": null, "website_url": "https://www.alternative-vr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24827649896864210"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/75303841_1636827486892876_1880226749718280975_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ruPWMU9LRGoQ7kNvwEmPWt5&_nc_oc=Adq1nx767VDIX0w5q-Is_KQWAitrt4vs0t2O
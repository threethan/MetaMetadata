Q7kNvwFDfrdR&_nc_oc=AdnC35P7ILrubxIFzEHbFA9SZKQZaUtgmdU7XurYr1c5tf2fbXLVrLLAdxBdrkIw1tY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfxMqzRAUK9DiPbFLZgGh3o1dedD_uRId3yheOsre6dKSQ&oe=69BBEC8B"}, {"file_name": "Image_04.png", "id": "1529501658004327", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031363_1529501661337660_2665133323378119833_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AOM-3MxovaYQ7kNvwHLv_xR&_nc_oc=AdnjiIiq9QoEzuy0fobIrcJBZeMmN_rG2nt43chl9O7GefOcLaxqZG5z-Mw2dNSnVKQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_Afzarb-zKdhd5EPAnKSDF5vtPAoDblo55rhj37jrYQEepQ&oe=69BBEA0D"}, {"file_name": "Image_05.png", "id": "824204526655177", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491827611_824204529988510_283305580378692137_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E_IUScF10FEQ7kNvwGMr6J3&_nc_oc=AdkjlIXkl08cuVzqMAZWkEeu-Qe_XeyYlW8GY0SWEWpicoYCiKHv590Dv7H4KLgENhI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfwgWDcB1LGIo0fWxkOo5OJrhAzhBYhHbFrB1lnu_7waLQ&oe=69BBEE52"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape.png", "id": "1374054834186854", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491820648_1374054840853520_6890075942571773963_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YlnFvFcsYg0Q7kNvwGRMpl5&_nc_oc=AdnlAyeglmXmLpMC9NLl0pcDck35_by3GnOg_EJL4uvQtJWemzyi60505VVFZ9Bhd00&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfyMZfVQ-wZp4ULenLJ67Pd66s2LYHwA0aU6T5s3idzwZA&oe=69BBF3C6"}, "display_name": "RC Helicopter", "keywords": ["RC", "Helicopter", "Fly", "Drone", "Flight"], "long_description": "RC Helicopter is a video game simulating the flight of a small RC helicopter. Before playing the game, you need to scan the room in order to collide with real world objects.\n\nThe game includes 3 modes, free flight, drone race and demolition game.\n\nTry how to control such an RC helicopter right in your own room. With the difference that in this game the helicopter is unbreakable, so if you crash the helicopter into a wall, it won't be damaged and you can fly again.\n\nAnd enjoy all this starting from your room and the small helipad from where the helicopter takes off.\n\nTry how fast it will be on the racing circuit with a drone or demolish a few objects.", "short_description": "RC Helicopter is an mixed reality video game. Control your own small rc helicopter right in your room, try to control your own helicopter with the possibility of collision with real objects."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.alternative-vr.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Alternative VR", "support_website_url": null, "website_url": "https://www.alternative-vr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24827649896864210"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75303841_1636827486892876_1880226749718280975_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2TzPyfto_3sQ7kNvwH95rT6&_nc_oc=AdmMkx78OJlDK5y6QcYmV8wd5eWfQZqhsoMgnmvgdEvxi1GjVFsK5OIhzJuM1Hwh9Bg&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afw9GlTS8-m9Ym8uvwHUN8_tzAFCfRWnchlPjmScxrQQ8w&oe=69BBF660"}, "is_concept": false, "is_
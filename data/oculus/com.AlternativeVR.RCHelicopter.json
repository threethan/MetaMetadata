_JwxF_czWzIfn8sg&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTkvgbSOHXpe92SjfFtPmE8cOqoGvYB5Z2tMEyyDcUUqw&oe=6B0B3790"}, {"file_name": "Image_03.png", "id": "1025343615897028", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39001688_1025343619230361_5639796744723679593_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M8LacMQBwzsQ7kNvwH6OOx5&_nc_oc=Adq7sqSPPL2N_SuJL0LYbdhJDncxSDvsnCSYSCiBBsL6Mf8klyyzZhyoqRAczFOYYyU&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRtfleCI9Kz6QpHCEo9meQzfCimGmxu-tOirnoYxe-Pgg&oe=6B0B3A0B"}, {"file_name": "Image_04.png", "id": "1529501658004327", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39031363_1529501661337660_2665133323378119833_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hE4MNVUXRgMQ7kNvwHwQh3W&_nc_oc=AdrFeqpV_WmosFcJOP9Xztjja77dsNXEaZ23R-QGp11_yavm2sHtueErcN6DP_vIyTk&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTp2IULTzXmyOQjTz6VgyMV1atUCCV5J2v4ty4FAz5oqw&oe=6B0B378D"}, {"file_name": "Image_05.png", "id": "824204526655177", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/491827611_824204529988510_283305580378692137_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mjlkNTRnCpMQ7kNvwGm327y&_nc_oc=AdokJuqNp5ngyEfHI_Yh-fu1F5cqqbVvqTniiP6l3jDQKoQvM8OJ9qqDj3ts0jKzdUs&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSqUxgrbX5ylHz0tSsRA77CpNivOvCt6h2seJPej7sO0g&oe=6B0B3BD2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape.png", "id": "1374054834186854", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/491820648_1374054840853520_6890075942571773963_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9p4MyIhg_fkQ7kNvwGoLYry&_nc_oc=AdpcMVezdS9Z7VG8jukBXsMXWM-Vuk5FMkUcZ0O2LvEfqiJ8cB9UN0nvw8m69IMOJQ8&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSbwnIIkFZChjCLwPRoiSQhZyk3G3tJ_5JY8My4PId2rw&oe=6B0B4146"}, "display_name": "RC Helicopter", "keywords": ["RC", "Helicopter", "Fly", "Drone", "Flight"], "long_description": "RC Helicopter is a video game simulating the flight of a small RC helicopter. Before playing the game, you need to scan the room in order to collide with real world objects.\n\nThe game includes 3 modes, free flight, drone race and demolition game.\n\nTry how to control such an RC helicopter right in your own room. With the difference that in this game the helicopter is unbreakable, so if you crash the helicopter into a wall, it won't be damaged and you can fly again.\n\nAnd enjoy all this starting from your room and the small helipad from where the helicopter takes off.\n\nTry how fast it will be on the racing circuit with a drone or demolish a few objects.", "short_description": "RC Helicopter is an mixed reality video game. Control your own small rc helicopter right in your room, try to control your own helicopter with the possibility of collision with real objects."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.alternative-vr.com/privacy-policy/index.html", "developer_terms_of_service_url": null, "publisher_name": "Alternative VR", "support_website_url": null, "website_url": "https://www.alternative-vr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id
}, {"file_name": "Image_04.png", "id": "1529501658004327", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/39031363_1529501661337660_2665133323378119833_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F5GR_8mLBZIQ7kNvwGffx0_&_nc_oc=Adn48Brv9iCiKINsoOv74w7yBvasym4BHjt2d7OiNaIvfe6JShUZ9Lk1kFWjqsTTFPk&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&oh=00_Afvp8iMz0d-wwOYhfhBJeFf_paTl7vnsYAzeicGJEXGMBw&oe=69A18C0D"}, {"file_name": "Image_05.png", "id": "824204526655177", "uri": "https://scontent-hkg4-2.oculuscdn.com/v/t64.5771-25/491827611_824204529988510_283305580378692137_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fc_YW3iFI3oQ7kNvwEnRFRv&_nc_oc=AdmAEfgWQebckWu_UxjsqDuLXJ6KGsiy6P03PnW2BOtqEo2xaDVD3J850_ZRD_l0oY4&_nc_zt=3&_nc_ht=scontent-hkg4-2.oculuscdn.com&oh=00_AfuooaVv_i3cDiBoBe28mLJCMb5gI0HPUC8nvPYrKVVAmw&oe=69A19052"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape.png", "id": "1374054834186854", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/491820648_1374054840853520_6890075942571773963_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=387dDV-ZOMgQ7kNvwGnoKJw&_nc_oc=AdlzaVUX7SkfnKUkfNL-9urF9euolMyae0wQaSlzYqh9D2WuYesyu3uzNA522DTj1rA&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&oh=00_Afu8Xpr9Mt8u0ryjseNRwl9hf38IcA5rES3rxk5C_RCDCQ&oe=69A195C6"}, "display_name": "RC Helicopter", "keywords": ["RC", "Helicopter", "Fly", "Drone", "Flight"], "long_description": "RC Helicopter is a video game simulating the flight of a small RC helicopter. Before playing the game, you need to scan the room in order to collide with real world objects.\n\nThe game includes 3 modes, free flight, drone race and demolition game.\n\nTry how to control such an RC helicopter right in your own room. With the difference that in this game the helicopter is unbreakable, so if you crash the helicopter into a wall, it won't be damaged and you can fly again.\n\nAnd enjoy all this starting from your room and the small helipad from where the helicopter takes off.\n\nTry how fast it will be on the racing circuit with a drone or demolish a few objects.", "short_description": "RC Helicopter is an mixed reality video game. Control your own small rc helicopter right in your room, try to control your own helicopter with the possibility of collision with real objects."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.alternative-vr.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Alternative VR", "support_website_url": null, "website_url": "https://www.alternative-vr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24827649896864210"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/75303841_1636827486892876_1880226749718280975_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8DquflaYLTQQ7kNvwHVtvHe&_nc_oc=Adm0CtmvB2zWX6mUVcNIFYc6ukV40H2j-e0-HLVRCloIEMbtIlXl6W2aWn5AIcjXo9A&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&oh=00_AfufpXMjeisvsVTd6jytT2g4uzrYFd2wTiqemhl7WWmsIg&oe=69A19860"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "RC Helicopter", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Simulation", "id": "331529
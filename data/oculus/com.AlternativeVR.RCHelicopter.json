WmLa9Nr6GrHRwiw9w&oe=6ACBC0B5"}, {"file_name": "Image_005_0000.png", "id": "1891879414644733", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75429295_1891879421311399_3733364809390027089_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mu_yzRTqfL4Q7kNvwHVDtYZ&_nc_oc=Adp61vbPSUr8TPAMquQL-JWdHiBZzJgRuF7W-zdmj0uFcjNuvAaLqVAtrg28s2Yd0Qw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMTTIyjJnhfK_b875aNDS0jshIeiPbO5l1D34mBGb8NmA&oe=6ACBB21A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "RC Helicopter", "keywords": [], "long_description": "RC Helicopter is a video game simulating the flight of a small RC helicopter. Before playing the game, you need to scan the room in order to collide with real world objects.\n\nTry how to control such an RC helicopter right in your own room. With the difference that in this game the helicopter is unbreakable, so if you crash the helicopter into a wall, it won't be damaged and you can fly again.\n\nAnd enjoy all this starting from your room and the small helipad from where the helicopter takes off.", "short_description": "RC Helicopter is an mixed reality video game. Control your own small rc helicopter right in your room, try to control your own helicopter with the possibility of collision with real objects."}]}, "developer_name": null, "developer_privacy_policy_url": "https://bartad6.wixsite.com/bartidens/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Alternative VR", "support_website_url": null, "website_url": "https://bartad6.wixsite.com/bartidens", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recom
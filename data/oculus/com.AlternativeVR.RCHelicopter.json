Q7kNvwH_Nghq&_nc_oc=Adlm_eSoxm1_cFB7pDk4gTiQ9Y0b0jImAj0KvDK3MloFAZqkUTUkwGFJ-SJtDJEDXio&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=8&oh=00_AfzxWhdMcrpHobvCWj8ykQ-K_wfQlqeQ2z9e-GuWIbOGhA&oe=69BD3E0B"}, {"file_name": "Image_04.png", "id": "1529501658004327", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39031363_1529501661337660_2665133323378119833_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AOM-3MxovaYQ7kNvwHLVR3-&_nc_oc=Admn_STYTe6PodLV-eiKStOkp3eVOOap9lUxFldj8HzWKMV46MmFGjcovMylEDgbkaA&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=8&oh=00_AfzssyzBqln0mpGf6mWm9hc-VD4f5tRhCIfrtxt4HupqwQ&oe=69BD3B8D"}, {"file_name": "Image_05.png", "id": "824204526655177", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/491827611_824204529988510_283305580378692137_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FHQWU4g5BDAQ7kNvwEadN0O&_nc_oc=AdkVjzn-pisTgmE1eMLz0Z42rq5pFPyIfzxSg7hwPsP_I0vqZZPHNlruDgCJxQAoDVo&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=8&oh=00_AfzyFbJsh02usJCzQjkgjrZPVKFNfRJYuCTy-WNkkHRMhg&oe=69BD3FD2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape.png", "id": "1374054834186854", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/491820648_1374054840853520_6890075942571773963_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RvO1Dzma5MIQ7kNvwEHF99x&_nc_oc=AdlH_UDGdyqdxt81J2yqtBAKJtvxGUeXdkeosiE7DpfYqC3-PTJWaa7Jdedu2A3mY1w&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=8&oh=00_AfwsUvuknVdW3O9ZFl0s8QX783HKxyjDui7tUX-X2Ko0Fg&oe=69BD4546"}, "display_name": "RC Helicopter", "keywords": ["RC", "Helicopter", "Fly", "Drone", "Flight"], "long_description": "RC Helicopter is a video game simulating the flight of a small RC helicopter. Before playing the game, you need to scan the room in order to collide with real world objects.\n\nThe game includes 3 modes, free flight, drone race and demolition game.\n\nTry how to control such an RC helicopter right in your own room. With the difference that in this game the helicopter is unbreakable, so if you crash the helicopter into a wall, it won't be damaged and you can fly again.\n\nAnd enjoy all this starting from your room and the small helipad from where the helicopter takes off.\n\nTry how fast it will be on the racing circuit with a drone or demolish a few objects.", "short_description": "RC Helicopter is an mixed reality video game. Control your own small rc helicopter right in your room, try to control your own helicopter with the possibility of collision with real objects."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.alternative-vr.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Alternative VR", "support_website_url": null, "website_url": "https://www.alternative-vr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24827649896864210"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/75303841_1636827486892876_1880226749718280975_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QhIycgNE0LoQ7kNvwGFGl_6&_nc_oc=AdmERUOX879MVYCwWIF-Wp88sG4IEZn-gZp7Ria_HAJIiGTF-UEQqmpMs0HKLHimMgg&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=8&oh=00_AfwoEJuSdk7C-F8_q6VMLtL70tYeTGnb-O6cPWmj1BPBJg&oe=69BD47E0"}, "is_concept": false, "is_
Q7kNvwHOaKQx&_nc_oc=AdmS4bzcN9hGtU2nmp-OTB8KRTRk6n6LF4vQsGUi-hs4ln2I6lbdtQXWzCoezjznQH4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_Afx3iogxXmJR1s3PGkPmi32KUYez7Y8JKypJ-qvYp0_5cw&oe=69B4038B"}, {"file_name": "Image_04.png", "id": "1529501658004327", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031363_1529501661337660_2665133323378119833_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M0M2mZy1lgcQ7kNvwE_rjwB&_nc_oc=Adl_Fb0pPPkjfhxe1afTXlyvSI9ZCcJki8vLAzD0x3xLWVHDfU1HVVTY_7bvFzOClAc&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfzTwbV_0HuGTB9rbqZ53s_7hBa-Ao-OoO_OIITBZSiU6Q&oe=69B4010D"}, {"file_name": "Image_05.png", "id": "824204526655177", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491827611_824204529988510_283305580378692137_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lIfBcpPVCIcQ7kNvwGYGCKo&_nc_oc=AdmcYjS1_mvW4k01GDkKDTC3XARIsl8MHr0UN4gYLqlpsEpGLP2O2biKJCk8MGHT0yE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_Afx5vu8CUtl5zhXlkGsAwzRNIALFBwZAnxjFAlXkFhF92g&oe=69B40552"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape.png", "id": "1374054834186854", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491820648_1374054840853520_6890075942571773963_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HPSvN54S_kgQ7kNvwFx1rhV&_nc_oc=AdkUbClc8E2yd1RJWmlAOUQy1dcn2k36KY6q1pG2CX1aNLAr5vqzcr7we50yMMNHC4o&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfynMOT4tCyJLz9m0yRnQB694KYdhI589b3mZBA7Rhj5Sw&oe=69B40AC6"}, "display_name": "RC Helicopter", "keywords": ["RC", "Helicopter", "Fly", "Drone", "Flight"], "long_description": "RC Helicopter is a video game simulating the flight of a small RC helicopter. Before playing the game, you need to scan the room in order to collide with real world objects.\n\nThe game includes 3 modes, free flight, drone race and demolition game.\n\nTry how to control such an RC helicopter right in your own room. With the difference that in this game the helicopter is unbreakable, so if you crash the helicopter into a wall, it won't be damaged and you can fly again.\n\nAnd enjoy all this starting from your room and the small helipad from where the helicopter takes off.\n\nTry how fast it will be on the racing circuit with a drone or demolish a few objects.", "short_description": "RC Helicopter is an mixed reality video game. Control your own small rc helicopter right in your room, try to control your own helicopter with the possibility of collision with real objects."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.alternative-vr.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Alternative VR", "support_website_url": null, "website_url": "https://www.alternative-vr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24827649896864210"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75303841_1636827486892876_1880226749718280975_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ITpwjXCWTUkQ7kNvwH3SGPv&_nc_oc=AdkqGaVT4lvdOgIZh3YgtQ8BBmHinjxYcE443MuXZmiwt58YiPNXn26xinxxovEUt_A&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afwt48QX7_Xae1gFHI5MdOK6iN3Wc3TYS81TZqvWWnJp1w&oe=69B40D60"}, "is_concept": false, "is_
A-L5whFaKRQJshbc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXdjNWMK8J0XMcebIwiMyrZNScYJrzxqj-omsEJEC6egA&oe=6B104550"}, {"file_name": "Image_03.png", "id": "1025343615897028", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39001688_1025343619230361_5639796744723679593_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kYAny1oIp5wQ7kNvwH1F-2k&_nc_oc=AdpAzKGl-b0GUz7ng4kn7tYCgIiCgDsGgan8Cse1BFhpcjj8VUW5Fx5qToIxzWBfMPM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQX1-4hsnDSQDwOd6K1vQ_Wahe1nJvEkTtEU9H9jBY91UQ&oe=6B1047CB"}, {"file_name": "Image_04.png", "id": "1529501658004327", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031363_1529501661337660_2665133323378119833_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=20B6A-8RhSQQ7kNvwGwvVxg&_nc_oc=AdooBwN7_7lC4Rxn4Z9AX35PxZYY8l9kOM3mwrRxpjBrD1obGZERjwiyECAaTc0sGhg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQUlJJ4iBCDirE0QY2NyjlhDwj7GsIoK1lEusRL5MQkt-w&oe=6B10454D"}, {"file_name": "Image_05.png", "id": "824204526655177", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491827611_824204529988510_283305580378692137_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=066l-XOsYC4Q7kNvwH4mVSh&_nc_oc=Adqffaw7W8XvrYH7g_POO3gwZAFfbAM3oEO444FlJEF6_t2WeLkejzqtPgHJYv4VL-4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXscVIUU22P-25c9-4FoDAx-zLnUmDJXD2Fim9Y89htZQ&oe=6B104992"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape.png", "id": "1374054834186854", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491820648_1374054840853520_6890075942571773963_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Vu-O8XCZHjoQ7kNvwFyGt8G&_nc_oc=AdrcZL27-NEog3PnZjHhlCqisaZhJFm087tzCkcmF_wqPn3W3ekKc4ITdbsSEA47DIQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWIsU8350xgTANF2uaktztPzHg_nDNPSvT6ljs-xzhyiA&oe=6B104F06"}, "display_name": "RC Helicopter", "keywords": ["RC", "Helicopter", "Fly", "Drone", "Flight"], "long_description": "RC Helicopter is a video game simulating the flight of a small RC helicopter. Before playing the game, you need to scan the room in order to collide with real world objects.\n\nThe game includes 3 modes, free flight, drone race and demolition game.\n\nTry how to control such an RC helicopter right in your own room. With the difference that in this game the helicopter is unbreakable, so if you crash the helicopter into a wall, it won't be damaged and you can fly again.\n\nAnd enjoy all this starting from your room and the small helipad from where the helicopter takes off.\n\nTry how fast it will be on the racing circuit with a drone or demolish a few objects.", "short_description": "RC Helicopter is an mixed reality video game. Control your own small rc helicopter right in your room, try to control your own helicopter with the possibility of collision with real objects."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.alternative-vr.com/privacy-policy/index.html", "developer_terms_of_service_url": null, "publisher_name": "Alternative VR", "support_website_url": null, "website_url": "https://www.alternative-vr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id
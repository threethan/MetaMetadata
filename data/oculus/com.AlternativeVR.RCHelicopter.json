}, {"file_name": "Image_04.png", "id": "1529501658004327", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39031363_1529501661337660_2665133323378119833_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=umbOnYR1us0Q7kNvwH21i2w&_nc_oc=Adk062zwSrP11q-vQodsERc9_ger7dMDZHUoWblG_5hpmLgnF6vjUfDYHxmHzyJX170&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_Afs_Yh9WS0GSlEw0BeyDHEgFhL9wC23OmzLA5CsJSDnTKw&oe=69A5808D"}, {"file_name": "Image_05.png", "id": "824204526655177", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/491827611_824204529988510_283305580378692137_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5VMrDhZeYjcQ7kNvwGP39uq&_nc_oc=AdlEA7EysqMk803pqp_qBflfBZCd8ddDyvFe8NZkmEEdxp25dof7CU06f29mf5tXK4E&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_Afuex0KmOgWO0jXXduCcXp0WXQKLlzKSR99wHomh6GEGgQ&oe=69A584D2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape.png", "id": "1374054834186854", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/491820648_1374054840853520_6890075942571773963_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MksRBblaTOIQ7kNvwEm8DZA&_nc_oc=AdmQhTj4dpnSFcfOl9FlSQ_Al8b129cEumjxh5_V_vbkVLoyb5B1NcvYouToKEb1iwM&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_Afs8XVxm7u8pSwPB0ozdS55Cw1YZIu6Zewn4sZGRaShDpA&oe=69A58A46"}, "display_name": "RC Helicopter", "keywords": ["RC", "Helicopter", "Fly", "Drone", "Flight"], "long_description": "RC Helicopter is a video game simulating the flight of a small RC helicopter. Before playing the game, you need to scan the room in order to collide with real world objects.\n\nThe game includes 3 modes, free flight, drone race and demolition game.\n\nTry how to control such an RC helicopter right in your own room. With the difference that in this game the helicopter is unbreakable, so if you crash the helicopter into a wall, it won't be damaged and you can fly again.\n\nAnd enjoy all this starting from your room and the small helipad from where the helicopter takes off.\n\nTry how fast it will be on the racing circuit with a drone or demolish a few objects.", "short_description": "RC Helicopter is an mixed reality video game. Control your own small rc helicopter right in your room, try to control your own helicopter with the possibility of collision with real objects."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.alternative-vr.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Alternative VR", "support_website_url": null, "website_url": "https://www.alternative-vr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24827649896864210"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/75303841_1636827486892876_1880226749718280975_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zMalbbvSjyIQ7kNvwHtx6xc&_nc_oc=AdmSu4WaNFYyM1RqQwd1TFhr5W721_Dj13zQn80gpXOZE5ZdEoAxWmKX0_WziXgMnmA&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&oh=00_Afsuwd_E-MxNHfC0pIfoSZe7_sv4NXghpUyeDe6nHOW-UA&oe=69A58CE0"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "RC Helicopter", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Simulation", "id": "331529
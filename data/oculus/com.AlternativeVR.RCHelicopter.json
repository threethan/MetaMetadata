Q7kNvwGuOOor&_nc_oc=Adkb2GtQVoZBNJRiUyfgaE0bPPM_83grLh4s0IdctXFkexJl-Uq4xDXmTbVkS4ucQ-8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfxwAl2x7F7Odnb1VUBV8-aU8rCvBas8qeYaxgj4WtrHEw&oe=69B5550B"}, {"file_name": "Image_04.png", "id": "1529501658004327", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031363_1529501661337660_2665133323378119833_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M0M2mZy1lgcQ7kNvwFNYSaO&_nc_oc=Adknw6QmebECpR5blM8lAhZvRqpZ3dUcn-3qQlxfed1vUcSRMD4pT0B20a45D6u-_9M&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfwsJEY4mnMubif-RGKyso_cSHEt_GMIw5sfddAtyvabqw&oe=69B5528D"}, {"file_name": "Image_05.png", "id": "824204526655177", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491827611_824204529988510_283305580378692137_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yjfXn8HZwykQ7kNvwFtwr4U&_nc_oc=AdkeVlNhvoANLy6gPVcN6OeCgawwt27oEu4xbUK9iqF7vr3g5XYJYXLTEn_B0P34_bA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfxH_G3PSGu8jTKIevtoYRMgKzCi7jytdXMuhkfSsp0gNg&oe=69B556D2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape.png", "id": "1374054834186854", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491820648_1374054840853520_6890075942571773963_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J1khQCeWmf4Q7kNvwHF3KgG&_nc_oc=Adl8rr8dhcadFy1MDr4DeadRX57G8NSQrgdQ6g48p9vSKpzQORox7deGndvsq_6Judg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_Afx5OGIIxOmwqsV2THOr64kSywN2dIlN8lfX450bziFjyw&oe=69B55C46"}, "display_name": "RC Helicopter", "keywords": ["RC", "Helicopter", "Fly", "Drone", "Flight"], "long_description": "RC Helicopter is a video game simulating the flight of a small RC helicopter. Before playing the game, you need to scan the room in order to collide with real world objects.\n\nThe game includes 3 modes, free flight, drone race and demolition game.\n\nTry how to control such an RC helicopter right in your own room. With the difference that in this game the helicopter is unbreakable, so if you crash the helicopter into a wall, it won't be damaged and you can fly again.\n\nAnd enjoy all this starting from your room and the small helipad from where the helicopter takes off.\n\nTry how fast it will be on the racing circuit with a drone or demolish a few objects.", "short_description": "RC Helicopter is an mixed reality video game. Control your own small rc helicopter right in your room, try to control your own helicopter with the possibility of collision with real objects."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.alternative-vr.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Alternative VR", "support_website_url": null, "website_url": "https://www.alternative-vr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24827649896864210"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75303841_1636827486892876_1880226749718280975_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mXwyrYghqAEQ7kNvwHDwK5y&_nc_oc=Admx84-sIPxbA8XrBA_oZnu8uAJWibdhBki0Y9IvUgGM4268S1G5I52cxBtHPEn9CgE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfwtdVCWDCkemjTC3pllrOKLbYYdBy5FPZib9569BRWr6A&oe=69B55EE0"}, "is_concept": false, "is_
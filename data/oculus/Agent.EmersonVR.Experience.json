 Denison). With the aid of a rogue operative Alexandra (Lyndsy Fonseca), David has to retake charge of own actions and fight his way through the top security facility inside the most complex live-action VR film ever made.", "short_description": "In this immersive 360 degree first-person POV VR film, the viewer is dropped into a visceral, action-packed 3D cinematic experience usually seen in movie theaters, only this time YOU are the action hero."}]}, "developer_name": "Serein", "developer_privacy_policy_url": null, "developer_terms_of_service_url": null, "publisher_name": "Agent Emerson", "support_website_url": null, "website_url": "https://www.agentemerson.com/index.html", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "MOVIE", "NARRATIVE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "300452235442067"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "783978168679283"}]}, "baseline_offer": {"id": "783978168679283"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1580407259, "status": "PUBLISHED", "id": "783978168679283"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "2805511012803423", "version": "1.180"}, "id": "521473755110335", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "28001930466685
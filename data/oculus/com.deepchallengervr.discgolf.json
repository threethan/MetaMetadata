unoFQnqhDS8cKZsh1d1ByHPGiDTef1wmy2XwIZVxWw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSuWBYdD7ulhI0jtGCh5EzcgoeR_fT0NnrfMLhHTSUmOQ&oe=6B01E71F"}, "display_name": "Disc Golf All Stars", "keywords": ["discgolf", "frolf", "sports", "multiplayer", "outdoors"], "long_description": "\ud83e\udd4fTrue-to-life disc mechanics\nArm speed, spin and release angle make discs turn, glide and fade realistically.\n\n\u26f0\ufe0fBeautiful and challenging courses\nPlay 36 holes across Sedona, Arizona, and Acadia, Maine. Launch off ledges, bend around doglegs, thread tunnels, cross water and putt onto island baskets.\n\n\ud83d\udc65Multiplayer\nPlay with up to 5 friends.\n\n\ud83c\udfa5Disc follow cam\nA camera chases every throw to the chains.\n\n\ud83c\udd93Free trial\n2 holes free, then unlock all of Sedona, Acadia & multiplayer with 1 purchase.", "short_description": "\ud83e\udd4fTrue-to-life disc mechanics\nArm speed, spin and release angle make discs turn, glide and fade realistically.\n\n\u26f0\ufe0fBeautiful and challenging courses\nPlay 36 holes across Sedona, Arizona, and Acadia, Maine. Launch off ledges, bend around doglegs, thread tunnels, cross water and putt onto island baskets.\n\n\ud83d\udc65Multiplayer\nPlay with up to 5 friends.\n\n\ud83c\udfa5Disc follow cam\nA camera chases every throw to the chains.\n\n\ud83c\udd93Free trial\n2 holes free, then unlock all of Sedona, Acadia & multiplayer with 1 purchase."}]}, "developer_name": null, "developer_privacy_policy_url": "https://discgolf.deepchallengervr.com/privacy", "developer_terms_of_service_url": "https://discgolf.deepchallengervr.com/terms", "publisher_name": "Deep Challenger VR LLC", "support_website_url": "https://discgolf.deepchallengervr.com/support", "website_url": "https://www.deepchallengervr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "27765
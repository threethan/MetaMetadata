A&oe=6ACCFBB8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TRAILER-cover.png", "id": "1252290763466129", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499617729_1252290766799462_5162368087754235308_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hv2i92gOSiwQ7kNvwHtk0dV&_nc_oc=Adq05h0hxoCfifgqKS7q0DGixIh6eNUWfxsAGHUtYpygFsdvfGVzU3W5CtzvuE-1Qag&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN7ZcDvrEUebFtkycq4J_R6yryNheqRu08Folyf9qUxQg&oe=6ACD1370"}, "display_name": "GRIDFLOW", "keywords": ["Arcade", "Puzzle", "Shooter", "rhythm", "beat"], "long_description": "**Find Your Flow** \n\nThis minimalist VR reflex game is an abstract arcade experience focused on clarity, control, and composure under pressure. See clearly, think quickly, and respond accurately.\nEach enemy is defined by two simple traits: **color** and **shape**. Identify them instantly and respond with the correct hand and input. \nThe rules start simple, but intensity rises quickly. Enemies spawn faster, timers shrink, and hesitation becomes costly. High scores are earned through rhythm and restraint, not reckless speed. Chain precise responses, build combos, and stay in control.\n7 different game modes .**WarmUp Mode** eases you into the game **Casual Mode** offers maximum clarity for learning and confidence. **Hard Mode** removes all safety nets for a pure test of reflexes, memory, and focus.\nProgression rewards skill, not grind. Earn XP, unlock badges and achievements, and climb the global leaderboards to measure your precision against others. No gimmicks. No shortcuts. Just the right button.\n\n**Key Features**\n- Minimalist abstract visuals designed for maximum clarity in VR\n- Easy-to-learn, intuitive VR controls\n- Designed for short-long sessions and repeat play\n- Color and shape mechanics that test coordination, focus, and memory\n- Combo systems that reward rhythm, restraint, and flow\n- 7 different game modes(including a relaxed mode)\n- Global leaderboards to satisfy the competitive itch\n- Achievements, badges, and a progression system\n- Seasonal challenges starting with the Valentine Challenges that are  live now", "short_description": "GridFlow is an abstract arcade-puzzle shooter designed to gently challenge your focus and hand-eye coordination through simple, satisfying interactions. Hit the right shape with the right button and enjoy the rhythm as everything clicks into place.\nExplore a variety of game modes, from the calm simplicity of monoGrid with two shapes to more engaging experiences like DeepEnd Mode. Or try to get the best score with one life in LastWish Mode.\nClimb leaderboards, unlock fun badges and achievements."}]}, "developer_name": null, "developer_privacy_policy_url": "https://github.com/nitinkumar25195/PrivacyPolicy/blob/main/GRIDFLOW_PrivacyPolicy", "developer_terms_of_service_url": null, "publisher_name": "XALT Labs", "support_website_url": null, "website_url": "https://www.xaltlabs.in/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}, {"id": "3744040075834813"}, {"id": "459781504968480"}, {"id": "377978390272490"}, {"id": "1672577396871977"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25468285752867069"}}]}, "scheduled_offers": {"count": 11, "nodes": [{"status": "PUBLISHED", "id": "1121672410395083"}, {"status": "PUBLISHED", "id": "27895135296853362"}, {"status": "PUBLISHED", "id": "12078581881730
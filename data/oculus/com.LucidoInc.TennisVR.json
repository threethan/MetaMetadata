vwGIEiEP&_nc_oc=AdpNmprALxyLxPMG2hjYabu_L5WHEC-vxgHjXr2aS9ovQv-FZuXz6Ke053I9qAkzbeA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRN0uR5YqoP3m2O3mDvY5PN5AAkiqUR_To_MMvvdWU7cA&oe=6AF4A146"}, {"file_name": "7 (4).png", "id": "1995241587551526", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499324069_1995241590884859_8924115680121426925_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tgS8vMnRjLQQ7kNvwHvh8ZG&_nc_oc=AdpALoqXY6glNkUKL6ZaaGP4Pr6kqyLcITZYXudNyof-A62g767wndpLniPUKAKRiik&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQZ6lpqg5DjPlAo12sDf4BXE8eN8cY3THT8kHxO0kClAA&oe=6AF4A36C"}, {"file_name": "7 (3).png", "id": "721436627129251", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499314729_721436630462584_4493067889458061892_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q2odxU0IpzIQ7kNvwHdW5Eq&_nc_oc=AdrkVLiv6SU_yJe75BEqPo1DZAVrJkrgoVD7May5rQGv2L2iU9yF_htJiYYn-IRDx5w&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR9eTM8Yt9seQw9-QiqTYVm8lvgcq_SUxQGhNNldNbVEg&oe=6AF49B67"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Racket Rush", "keywords": ["Tennis", "hypercasual", "sports", "Sim"], "long_description": "Racket Rush : Practice Your Swing in Virtual Reality!\n\nStep onto the court and sharpen your tennis skills in this immersive VR training experience. In Tennis VR, you\u2019ll face a steady stream of tennis balls coming your way\u2014your goal is simple: hit as many as you can with your racket and rack up points!\n\nDesigned for players of all skill levels, this game is perfect for warming up your reflexes, improving hand-eye coordination, or just enjoying the thrill of hitting balls in a virtual tennis arena. Every hit earns you points, and every second counts\u2014can you beat your high score before the timer runs out?\n\nWhether you're looking for a quick session or an intense rally challenge, Tennis VR delivers fast-paced fun with intuitive mechanics and satisfying racket physics. It\u2019s tennis practice made accessible, engaging, and sweat-worthy in VR!\n\nKey Features:\n\nIntuitive racket controls with realistic hit feedback\n\nScore-based gameplay with a timed challenge\n\nSimple, clean visuals focused on performance and f", "short_description": "Train your swing in this fun and fast-paced tennis practice game!\nHit incoming balls with your racket to earn points. Test your reflexes, improve your timing, and aim for the highest score before time runs out. \n\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://lucido.life/policy/racketrush/", "developer_terms_of_service_url": null, "publisher_name": "Lucido Inc", "support_website_url": null, "website_url": "https://lucido.life/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24235136102760295"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499318455_9982516598453636_197911925187897197_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A0iaa5IpmcAQ7kNvwFMHUiy&_nc_oc=AdoLvAPYPF6T4HeUM42wdXnebYklEWa6WOzSpX8Ecn_pgLN9qqGC3AIap-bkAt0lR8M&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTH303_3BMNueLZE9xHGmEujCcUz4yxXhCEzbtNiT7huQ&oe=6AF4843B"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "disp
RQQ7kNvwHVIvPQ&_nc_oc=AdpngsJY6u8ptRl7PSzYcW19lm27GE9ERlzQHY7kgqFYLqGq3sZk-x5hzP8iBirJdZQ&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIaDou5RMSp4mUFzR7sK-rJlkTQ6nzw3psnbFpQVwz6kw&oe=6AA94386"}, {"file_name": "7 (4).png", "id": "1995241587551526", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/499324069_1995241590884859_8924115680121426925_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lMGqNciRhFcQ7kNvwEBlxkW&_nc_oc=AdqWrfho6ajvCl0rDSapP6p5ryiNBsycbSc75ta_n80f51a4lJbPpExBwwyf8qJeXOo&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIolqsoSQmK2Dlj-_JYhadxZJPjOU8vun5kqLmLEW-ciA&oe=6AA945AC"}, {"file_name": "7 (3).png", "id": "721436627129251", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/499314729_721436630462584_4493067889458061892_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wiF_HiVR1lcQ7kNvwHTnl1Z&_nc_oc=AdrXi5X4r2rEUay743GLQAGlVO-zBF_qMlvqCGjHNraZPXNx2oM2OpX3AbcfbobGF_Y&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJLq7-Zl8SbTO5DJDcJjwKAarSWlDTgQ4hNZ5nvg9cJYA&oe=6AA93DA7"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Racket Rush", "keywords": ["Tennis", "hypercasual", "sports", "Sim"], "long_description": "Racket Rush : Practice Your Swing in Virtual Reality!\n\nStep onto the court and sharpen your tennis skills in this immersive VR training experience. In Tennis VR, you\u2019ll face a steady stream of tennis balls coming your way\u2014your goal is simple: hit as many as you can with your racket and rack up points!\n\nDesigned for players of all skill levels, this game is perfect for warming up your reflexes, improving hand-eye coordination, or just enjoying the thrill of hitting balls in a virtual tennis arena. Every hit earns you points, and every second counts\u2014can you beat your high score before the timer runs out?\n\nWhether you're looking for a quick session or an intense rally challenge, Tennis VR delivers fast-paced fun with intuitive mechanics and satisfying racket physics. It\u2019s tennis practice made accessible, engaging, and sweat-worthy in VR!\n\nKey Features:\n\nIntuitive racket controls with realistic hit feedback\n\nScore-based gameplay with a timed challenge\n\nSimple, clean visuals focused on performance and f", "short_description": "Train your swing in this fun and fast-paced tennis practice game!\nHit incoming balls with your racket to earn points. Test your reflexes, improve your timing, and aim for the highest score before time runs out. \n\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://lucido.life/policy/racketrush/", "developer_terms_of_service_url": null, "publisher_name": "Lucido Inc", "support_website_url": null, "website_url": "https://lucido.life/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24235136102760295"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/499318455_9982516598453636_197911925187897197_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qUER2cLttVkQ7kNvwEIF8qP&_nc_oc=AdoTCTHZGwVfElmTbN5Xk3CV5ry8VxiuzKCZuU_R7wcFZmsOhTjQSUtYkNwQfCMMJkk&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL_0WY209FAvJTUwoibyJzHKx7pOnJKaMOmFPHPHx_eFw&oe=6AA95EBB"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": fals
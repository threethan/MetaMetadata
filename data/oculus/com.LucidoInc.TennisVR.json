vwGsLc1l&_nc_oc=AdpIFh-AHzYwxl9C6QLQqINvIdjquJSOrsQVi6BqUu2NcumyJ6YoIKz6ZeDX_MpMRAk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKUIqchdKyVKciDmVTWRObvXcTzKEBVwxtg2X5AXv0mWw&oe=6A997186"}, {"file_name": "7 (4).png", "id": "1995241587551526", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499324069_1995241590884859_8924115680121426925_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jpoT6J_XkhwQ7kNvwH-xBnk&_nc_oc=AdouYrQCKj1dhW5DXmXf9YnJ8f2Ay5ggBEQkdc7QzCjW2vJyrw9VO8y6Y0-QmxbUWBE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJlWhUuKef_etaTMDlJII4USR523rZ-Np9ZWkrK1AIpPA&oe=6A9973AC"}, {"file_name": "7 (3).png", "id": "721436627129251", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499314729_721436630462584_4493067889458061892_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1mn5tCgd_LAQ7kNvwFH8dr6&_nc_oc=Adp21IO2l36jhyzpqWtdR31MOfNN8a0D6JHRGJssF2tUDMfJwF3wSmwWSCLsGBqzNfM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIld4Olvd8tQFfIOC4q3Dzm8Ry0KkwIESKvmsgir0_Pag&oe=6A99A3E7"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Racket Rush", "keywords": ["Tennis", "hypercasual", "sports", "Sim"], "long_description": "Racket Rush : Practice Your Swing in Virtual Reality!\n\nStep onto the court and sharpen your tennis skills in this immersive VR training experience. In Tennis VR, you\u2019ll face a steady stream of tennis balls coming your way\u2014your goal is simple: hit as many as you can with your racket and rack up points!\n\nDesigned for players of all skill levels, this game is perfect for warming up your reflexes, improving hand-eye coordination, or just enjoying the thrill of hitting balls in a virtual tennis arena. Every hit earns you points, and every second counts\u2014can you beat your high score before the timer runs out?\n\nWhether you're looking for a quick session or an intense rally challenge, Tennis VR delivers fast-paced fun with intuitive mechanics and satisfying racket physics. It\u2019s tennis practice made accessible, engaging, and sweat-worthy in VR!\n\nKey Features:\n\nIntuitive racket controls with realistic hit feedback\n\nScore-based gameplay with a timed challenge\n\nSimple, clean visuals focused on performance and f", "short_description": "Train your swing in this fun and fast-paced tennis practice game!\nHit incoming balls with your racket to earn points. Test your reflexes, improve your timing, and aim for the highest score before time runs out. \n\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://lucido.life/policy/racketrush/", "developer_terms_of_service_url": null, "publisher_name": "Lucido Inc", "support_website_url": null, "website_url": "https://lucido.life/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24235136102760295"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499318455_9982516598453636_197911925187897197_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MOpCXWRVxgYQ7kNvwE797j-&_nc_oc=Adooy4Uvu-mdk7VbgO0GpZG06wCUm4zgl8aPjBZfVQ0DEI0zOSOg2VlkP39zYQiwnv4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKyiYeBORynKkLlQB8wKWBDszVeUApOD0O1RgCNDVz42Q&oe=6A998CBB"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "disp
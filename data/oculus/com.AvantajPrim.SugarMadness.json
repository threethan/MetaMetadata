3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEBe3bF8E3nZrnlIi21RuBV-20XOIzgQcsySvhGlQ1M0Q&oe=6A830A7F"}, {"file_name": "Screenshots_4 (1).png", "id": "1578878636118949", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473393909_1578878639452282_585427678064208453_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hMNWQAaSTNcQ7kNvwFghocr&_nc_oc=AdpZng7g1ZLdpfRs4LIJFotnUyuVZqH_xeQEeBBIrusyDI4YzVLLuLmCLM5oFCuwv-g&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF9AhdW2Kzv8DsDjMVwdVvbAIJwPvnpLZ8TVUBXR7HRwg&oe=6A82EB3F"}, {"file_name": "Screenshots_2 (1).png", "id": "2113651145766822", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473391911_2113651149100155_4129718244509439486_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JuoG3wEZcJUQ7kNvwEu67Ck&_nc_oc=AdrAk3vkGJkfRKMugkFQI4qakZQWGrgn34Q8m3REJFDwqyFAaX1KcfCj-oNARRS_rWc&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGw3tQ5rIA2Ji3ciM-olR5DDVjPMxC7rcWUDUD-SYkGMA&oe=6A82F266"}, {"file_name": "Screenshots_3.png", "id": "629472803165609", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391883_629472806498942_4884756001802653768_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TjzZvLqEgTsQ7kNvwF6znFT&_nc_oc=Adqgm2ZNZT5yL5Wy-prcSbKycY7wHRdpsBXTib7QuX4V4xK2gLR7wf78CdqbrOxsPko&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEMSoZ5zlJFOAucoWs3FxuphSGm0WyFSuUSk4PwGHmcZA&oe=6A831999"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Art landscape_2560x1440px.png", "id": "3805492576381541", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473392298_3805492579714874_6144670027525837356_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UNCUwomSudkQ7kNvwGKkWAs&_nc_oc=AdoWdkxyOcqSIlAcTgWthHF722yeKFlgu31SttNqEJjMHQJY6sLxN6Rd-71ZdrUUSTU&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGqmNbquf_pP0jFw9df4bX_nYRSTo8zOX0ogY2gwUPptQ&oe=6A82F360"}, "display_name": "Sugar Madness", "keywords": ["shooter", "multiplayer", "adventure", "arcade"], "long_description": "Sugar Madness is a fast-paced, immersive first-person shooter, where quick thinking, strategy, skill and adaptability are the only way to survive. Grab your gear, brace yourself for the sugar rush, and get ready to take down the Candymorph hordes in the candy-themed world. \n\nIn Sugar Madness, you\u2019re battling through a world gone completely off the rails. One minute, you\u2019re admiring the candy-coated landscapes of the once-thriving Candy Kingdom. The next you\u2019re ducking for cover as a swarm of mutant jawbreakers come hurtling at your face. \n\nAt the heart of this chaos is Dr. Sour\u2014a genius, a madman, and the reason everything\u2019s gone to hell in a candy basket. His failed experiments have twisted once-sweet confections into ravenous candymorphs, and it\u2019s up to you and your friends in multiplayer to clean up his mess!\n\nArmed with a wild arsenal\u2014from gumball shotguns to licorice whips\u2014you\u2019ll blast your way through a sugar-fueled gauntlet of bizarre enemies, intense rail shooter sequences, and downright ridiculous boss fights. \n\nMain Features:\n- vibrant multiple biomes\n- formidable bosses\n- multiplayer mode\n- fun mini-games\n\nWith a mix of single-player and multiplayer mayhem, unpredictable levels, and a Kingdom that refuses to go down without a fight, Sugar Madness is an all-out, over-the-top VR shooter.", "short_description": "Sugar Madness is a fast-paced, immersive first-person shooter, where quick thinking, strategy, skill and adaptability are the only way to survive. Grab your gear, brace yourself for the sugar rush, and get ready to take down the Candymorph hordes in the candy-themed world."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.jollyco.us/privacypolicy-sugarmadness/", "developer_terms_of_service_url": null, "publisher_name": "JollyCo LLC", "support_website_url": null, "website_url": "https://w
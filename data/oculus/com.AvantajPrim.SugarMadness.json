39_1596968796189571015_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WkiQdiAmJDIQ7kNvwHGgs7x&_nc_oc=AdrUWFPi-x_MPkg8pwdBAe2ZlpIzITKzuYUexpGa76uY8Br5d6Qg2Mfz0iiZgLDAt6Y&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-Q3jSxyBmdfJ8CHc-yAwn_PBN4qo1XEdFqXSgsXFwMAw&oe=6A2970A3"}, "display_name": "Sugar Madness", "keywords": ["shooter", "adventure", "arcade", "cooperative", "action"], "long_description": "Sugar Madness is a fast-paced, immersive first-person shooter, where quick thinking, strategy, skill and adaptability are the only way to survive. Grab your gear, brace yourself for the sugar rush, and get ready to take down the Candymorph hordes in the candy-themed world.\n\n{2069788637215640}\n\nIn Sugar Madness, you\u2019re battling through a world gone completely off the rails. One minute, you\u2019re admiring the candy-coated landscapes of the once-thriving Candy Kingdom. The next you\u2019re ducking for cover as a swarm of mutant jawbreakers come hurtling at your face.\n\nAt the heart of this chaos is Dr. Sour\u2014a genius, a madman, and the reason everything\u2019s gone to hell in a candy basket. His failed experiments have twisted once-sweet confections into ravenous candymorphs, and it\u2019s up to you and your friends in co-op mode to clean up his mess!\n\nTo beat mutated creatures and cool & funky bosses, you\u2019ll need to choose your weapons strategically. Your varied arsenal includes weapons like the Sugar Blaster, Bubble Trap, Sweet Smasher, allowing you to switch between close and long-range combat to handle each encounter more effectively.\n\nMain Features:\n- \ud83d\udd2b Vast arsenal of mind-blowing weapons\n- \ud83d\udc7e Varied enemies\n- \ud83e\udd16 Mighty bosses\n\n{2187615978649408}\n\n- \ud83d\ude4b Co-op mode - team up with your friend to defeat all enemies and bosses\n\n{1240491381571267}\n\n- \ud83d\ude01 Fun mini-games\n\n{1671459140675285}\n\nWith a mix of single-player and cooperative mayhem, unpredictable levels, and a Kingdom that refuses to go down without a fight, Sugar Madness is an all-out, over-the-top VR shooter.", "short_description": "Sugar Madness is a fast-paced, immersive first-person shooter, where quick thinking, strategy, skill and adaptability are the only way to survive!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.jollyco.us/privacypolicy-sugarmadness/", "developer_terms_of_service_url": null, "publisher_name": "JOLLYCO INC", "support_website_url": null, "website_url": "https://www.jollyco.us/sugar-madness/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "1592192974313489"}, {"id": "459781504968480"}, {"id": "2691890164460465"}, {"id": "1700921480735423"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "fr", "de", "pt_BR"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "CO_OP", "MULTI_USER"], "id": "27734277422842420"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491821568_786756394058160_283892662227391776_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1MKXVnHlqQwQ7kNvwFXo2MO&_nc_oc=Adq8yOn37XSSveZxqrFoEbeEi0mb6RdbuhuKLk6QBSf8ov793V2pKn1PNkE9ar3c6t4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9oKRvO8fxlDC3Q0jIKNJHVM7i4N6-SkYWCCUI6bZdZPw&oe=6A2969D8"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Sugar Madness", "platform": "ANDROID_6DOF", "context_category": {"conte
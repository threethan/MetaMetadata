_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIZOUKrb8O45syebDdtZY72Frj7CJQyQaAZenvq6iTr6g&oe=6AB2997F"}, {"file_name": "Screenshots_2 (1).png", "id": "2113651145766822", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473391911_2113651149100155_4129718244509439486_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s0lE4MmiF_QQ7kNvwHiKJC1&_nc_oc=AdppbkJf-hAaGMxh390zZbcjnhSd_ptYgIv4Nv-JsJ1H92yEsSYueL-BRVeDuQxWFFQ&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL1GbfCWTaCUmib2TfFJB8OFN-PjzdPInOIEm9fIwXCjw&oe=6AB2A0A6"}, {"file_name": "Screenshots_3.png", "id": "629472803165609", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391883_629472806498942_4884756001802653768_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D8w4UNDwk68Q7kNvwGiQZU5&_nc_oc=Adq5lKNftdwrNog8dfhbT2Q6VfqmY_Ki1W-c4TJzayiCeSvlBxRvTI71o6XavJECZqE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL2fn2WczOvol0VAJjWqMNiOAfty5GF6-eSR_Fln7-KtA&oe=6AB28F99"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Art landscape_2560x1440px.png", "id": "3805492576381541", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473392298_3805492579714874_6144670027525837356_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cO3lF_xektEQ7kNvwFYAKsU&_nc_oc=AdoVE-EXnyJ9Sgpsfs-aWmf1soubrdjoK1thjpzmysLsqEale1knPNe-nZ92A2Cp_ro&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJm1KXHxHT4HitROqdnzTn-xmenCthoVq_i0U8J6onikg&oe=6AB2A1A0"}, "display_name": "Sugar Madness", "keywords": ["shooter", "multiplayer", "adventure", "arcade"], "long_description": "Sugar Madness is a fast-paced, immersive first-person shooter, where quick thinking, strategy, skill and adaptability are the only way to survive. Grab your gear, brace yourself for the sugar rush, and get ready to take down the Candymorph hordes in the candy-themed world. \n\nIn Sugar Madness, you\u2019re battling through a world gone completely off the rails. One minute, you\u2019re admiring the candy-coated landscapes of the once-thriving Candy Kingdom. The next you\u2019re ducking for cover as a swarm of mutant jawbreakers come hurtling at your face. \n\nAt the heart of this chaos is Dr. Sour\u2014a genius, a madman, and the reason everything\u2019s gone to hell in a candy basket. His failed experiments have twisted once-sweet confections into ravenous candymorphs, and it\u2019s up to you and your friends in multiplayer to clean up his mess!\n\nArmed with a wild arsenal\u2014from gumball shotguns to licorice whips\u2014you\u2019ll blast your way through a sugar-fueled gauntlet of bizarre enemies, intense rail shooter sequences, and downright ridiculous boss fights. \n\nMain Features:\n- vibrant multiple biomes\n- formidable bosses\n- multiplayer mode\n- fun mini-games\n\nWith a mix of single-player and multiplayer mayhem, unpredictable levels, and a Kingdom that refuses to go down without a fight, Sugar Madness is an all-out, over-the-top VR shooter.", "short_description": "Sugar Madness is a fast-paced, immersive first-person shooter, where quick thinking, strategy, skill and adaptability are the only way to survive. Grab your gear, brace yourself for the sugar rush, and get ready to take down the Candymorph hordes in the candy-themed world."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.jollyco.us/privacypolicy-sugarmadness/", "developer_terms_of_service_url": null, "publisher_name": "JollyCo LLC", "support_website_url": null, "website_url": "https://www.jollyco.us/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "2691890164460465"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "NO_MOVEMENT", "recommend
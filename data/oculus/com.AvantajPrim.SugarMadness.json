/491823790_1646490026350964_6377506063963691263_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kEhi-RncWpkQ7kNvwHbcUxG&_nc_oc=Adr3DQwKICnbKQVe19T-Kk4DJ0VU7_-P8aCLHyu63TjLZ9qyE4TI58xZrKw9uuxRRrE&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHS5CRzc5-xhWOCVBn6iWp2ulSkt3zKsL-2JhNCH6HKrw&oe=6A82F205"}, {"file_name": "Screenshot_3.png", "id": "1663066558065127", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491825462_1663066564731793_4622807202809040861_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VDwkXZvZZpcQ7kNvwFg5wGO&_nc_oc=AdrFSqdfAlnmhNmAiOZCvOtgoCSp_u0yqG8dQSegwnjrQqJYPA58xzaLFtATb8ZyNKc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEglYuXVB6kNwwHS306WxkatD-39YE-_Yc8SlJBO6yPSA&oe=6A830D4E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440.png", "id": "1351496696443158", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/604375581_1351496699776491_5547383151229634887_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U7lHWf8Px3kQ7kNvwGf1rx8&_nc_oc=Adp4iVLSe79D3pyAsedxoTAO7FUF2QJU9Om1ZyHs2XiIyQeokO8HEqmP2Hds38egVBM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGKE0fGrhs2V0VlmQITY1SUJGy47Ug1zracaSwk0GmcTQ&oe=6A830878"}, "display_name": "Sugar Madness", "keywords": ["shooter", "adventure", "arcade", "cooperative", "action"], "long_description": "**Sugar Madness is a first-person shooter set in a ruined world where twisted candy-born creatures and broken machines hunt you. Fight your way through multiple biomes, either solo or in co-op, challenge mighty bosses and uncover the source of the corruption.**\n\n{2069788637215640}\n\nThis is a VR first-person shooter that offers fast movement, physical interaction, and constant pressure. You grab weapons, aim and shoot, swing melee tools, and dodge attacks. Combat keeps you moving at all times.\n\nFight through corrupted biomes, each with its own challenges. Clear static combat arenas filled with enemies attacking from every direction. Take on fast-paced rail shooting sections that push your aim and reaction. Then face powerful boss fights that test everything you\u2019ve learned. Each biome grows more intense as you progress. \n\n{2187615978649408}\n\nPlay solo or enter co-op mode, where teamwork becomes essential. Share pressure, cover angles, and push deeper together through hostile zones.\n\n{1240491381571267}\n\nBetween fights, short mini-games break the intensity. They test timing and reflexes while giving you a brief moment to reset before the next encounter.\n\n{1671459140675285}\n\n**Key Features**\n\n- Fast-paced VR shooter built for physical interaction and immersion\n- Grab, aim, shoot, swing, and dodge in intense combat\n- Wave-based arena battles with escalating difficulty\n- Co-op gameplay for shared survival and strategy\n- Massive multi-phase boss fights\n- Mini-games between encounters for pacing and rewards", "short_description": "Sugar Madness is a first-person shooter set in a ruined world where twisted candy-born creatures and broken machines hunt you. Fight your way through multiple biomes, either solo or in co-op, challenge mighty bosses and uncover the source of the corruption."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.jollyco.us/privacypolicy-sugarmadness/", "developer_terms_of_service_url": null, "publisher_name": "JOLLYCO INC", "support_website_url": null, "website_url": "https://www.jollyco.us/sugar-madness/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "459781504968480"}, {"id": "1700921480735423"}, {"id": "3744040075834813"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended
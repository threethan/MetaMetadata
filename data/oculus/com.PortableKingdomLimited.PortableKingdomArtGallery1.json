lated videos. \n\nIntended as an extension to an online only or physical retail art gallery to enable visitors to have an immersive experience of the art works even if they cannot visit the physical art gallery in person.\n\nAlso allows the gallery to show their art works in a very different, non traditional setting if they choose.\n\nThis example shows an outdoor island gallery with sample British Modern and Contemporary works courtesy of the Belgrave St Ives art gallery.", "short_description": "Interactive VR art gallery where the visitor can select art works from the walls or stacks, view art information and watch art related videos. This example shows an outdoor island gallery with sample British Modern and Contemporary works courtesy of the Belgrave St Ives art gallery."}]}, "developer_name": null, "developer_privacy_policy_url": "https://portablekingdom.com/privacy-policy-iag", "developer_terms_of_service_url": null, "publisher_name": "Portable Kingdom Limited", "support_website_url": null, "website_url": "https://portablekingdom.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}, {"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ART_CREATIVITY"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "468886897949508"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1576796229357443"}]}, "baseline_offer": {"id": "1576796229357443"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1643676240, "status"
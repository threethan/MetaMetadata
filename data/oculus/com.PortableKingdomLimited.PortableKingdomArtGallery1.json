4927746185590_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jLPtZF--7VkQ7kNvwFSKZHP&_nc_oc=AdndRUtRC6DLjz3AkBqbb2lF-zEmCTd3KLzBAU3jh98xhbZdCbPZv4tJMuvWjYb6b0o&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=8&oh=00_AfySf-iue-qbDa6N-vW7iUeOmtAX4ZBk6rWYKBX95kAg9w&oe=69AAC756"}, "display_name": "Portable Kingdom: Island Art Gallery", "keywords": [], "long_description": "Example interactive VR art gallery where the visitor can select art works from the walls or stacks, view art information and watch art related videos. \n\nIntended as an extension to an online only or physical retail art gallery to enable visitors to have an immersive experience of the art works even if they cannot visit the physical art gallery in person.\n\nAlso allows the gallery to show their art works in a very different, non traditional setting if they choose.\n\nThis example shows an outdoor island gallery with sample British Modern and Contemporary works courtesy of the Belgrave St Ives art gallery.", "short_description": "Interactive VR art gallery where the visitor can select art works from the walls or stacks, view art information and watch art related videos. This example shows an outdoor island gallery with sample British Modern and Contemporary works courtesy of the Belgrave St Ives art gallery."}]}, "developer_name": null, "developer_privacy_policy_url": "https://portablekingdom.com/privacy-policy-iag", "developer_terms_of_service_url": null, "publisher_name": "Portable Kingdom Limited", "support_website_url": null, "website_url": "https://portablekingdom.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}, {"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ART_CREATIVITY"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommend
&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSpNPnoOK2HzYIxf6pAeWmf38Sp0mqLh8TvXJvtD3mUbg&oe=6B08492D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverArt-Landscape-2560x1440px-8.png", "id": "637652913924599", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/75318184_637652917257932_6678974927746185590_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sTI6PQwEF1YQ7kNvwFaqHhc&_nc_oc=Adplc2yH6ss28rID8HFjn5ZpiG2DvQ_UD6o-JAsDAZWUEPuWSXyjyC5y0LgJCPH5ZB4&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSgT4ZSTDLhAOQLO6U3GnGlM_UZZK9pUL5_R5cv0NOwBg&oe=6B085D16"}, "display_name": "Portable Kingdom: Island Art Gallery", "keywords": [], "long_description": "Example interactive VR art gallery where the visitor can select art works from the walls or stacks, view art information and watch art related videos. \n\nIntended as an extension to an online only or physical retail art gallery to enable visitors to have an immersive experience of the art works even if they cannot visit the physical art gallery in person.\n\nAlso allows the gallery to show their art works in a very different, non traditional setting if they choose.\n\nThis example shows an outdoor island gallery with sample British Modern and Contemporary works courtesy of the Belgrave St Ives art gallery.", "short_description": "Interactive VR art gallery where the visitor can select art works from the walls or stacks, view art information and watch art related videos. This example shows an outdoor island gallery with sample British Modern and Contemporary works courtesy of the Belgrave St Ives art gallery."}]}, "developer_name": null, "developer_privacy_policy_url": "https://portablekingdom.com/privacy-policy-iag", "developer_terms_of_service_url": null, "publisher_name": "Portable Kingdom Limited", "support_website_url": null, "website_url": "https://portablekingdom.com/", "category": "APPS", "comfort_rating": "NOT_RATE
": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39036680_302677187890236_1969448781908096276_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ck_EBAyCi_cQ7kNvwFz8-SB&_nc_oc=AdqZo6f5kdZNdGXl1HVh9q6FBdi9FEGHuhVG6TzsOLI4SkwyvuOQ7Z57i4fvcAC-1p0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRSIik3A-Hi3hSlMl2ePI7-RwuEtJuh_VFCaGxLSF4t8w&oe=6B031F3A"}]}, "id": "471704080700448", "locale": "en_US", "screenshots": [{"file_name": "screenshot_2.png", "id": "5921419771231469", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39035438_5921419774564802_7341287331724410610_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DbTP_pf7HwUQ7kNvwE3Z-Qh&_nc_oc=Adp-NO0Ey2Rd5ttPloyre0qkp_B3FFKhykY8R79RDn9-iQ89WUY6ocohUmXc9qmmlJ8&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSEQIYzsnYZdqC7JuQFE-jlUgqx5WMYqdzwXRXctAPvTA&oe=6B033A25"}, {"file_name": "screenshot_1.png", "id": "553221008979530", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974703_553221012312863_1867867182728372798_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c90ZxKnCI5IQ7kNvwF27zei&_nc_oc=AdrOy3iBhh_6VDA_g989TS3knT9smo4iJlXT0P_Ngz1y5uAWZRQL5LhVjOXVo4_khJ0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRV7yV8cg3qVyw3_RLN_R12g_B3uJRoBVf4gwHPdGfr5g&oe=6B033579"}, {"file_name": "screenshot_3.png", "id": "2943382102558757", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/57575369_2943382105892090_8957030490266986422_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HEXgkXSKa-8Q7kNvwGRMmna&_nc_oc=AdqoojadTEl2lSQz3hjBHRcjYKxk3-PtxjVSjfmUeUTX_rr1IrdAhfQ4NBUzQ8S2OBw&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRTRmJ0UV0S86tSnJvQ16YIyQHGQj7rCk_RzEiX_z2Njg&oe=6B0330D7"}, {"file_name": "screenshot_4.png", "id": "370239084276463", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75622018_370239087609796_1758523008600931701_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sANj34Y2CzMQ7kNvwHLcCJd&_nc_oc=AdougSDYSPeIP8bSub1vLLuETjLD9tBj_pHFbQ19_BzoAFd8pcx_tSFHfRZd-ZLtX6o&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRH6qasxzU9taYJBOp7zwAk0V9AC7dV9KCRFDEvphrtPg&oe=6B031DEF"}, {"file_name": "screenshot_5.png", "id": "451294959494546", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/57572919_451294962827879_8457223053420767661_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XEeIj0HDncoQ7kNvwFjN3fv&_nc_oc=AdrW8KGiIm1DYD-TL7mPbaKgY_06RRmA62lHPgVcSehxul3cJYnNLFgqZ2TclVfF5v4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSxv5UW5jtaM0QL3rdMkqcAFO48KXSkTKsTVN5NNkgpRQ&oe=6B030CA1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "video_cover_2560x1440.png", "id": "929308274279146", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75282165_929308277612479_9040430983808014993_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EmMKkd9MDKAQ7kNvwGMl3qk&_nc_oc=Ado3g7nEPH4rzU9WktCNMTiEm0-eT2Lq7wcnydFKv_iRsMPjURIzABf89Bdfg-hW2PE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQnU-L2p1VmvfwJVrG9AhHgwBrcUfISknWIWUuh5e9geQ&oe=6B031629"}, "display_name": "EmbodiMap", "keywords": [], "long_description": "EmbodiMap is a creative experience that enables users to connect with and explore how emotions, sensations, and stress responses are experienced in the body. Each time a feeling/sensation is identified, it can be drawn into an avatar figure. Users can freely move around or enter inside their avatar bodies. In this way, participants create and dynamically engage with a field of 3D sensory maps, which tell a story of changing sensation and awareness.\nA range of 3D \u2018avatar\u2019 bodies, props and environments are available. Avatar bodies may be selectively (re)shaped, mirroring the pose of users.\nUsers may choose to be voice guided; have a shared experience or go on a self-directed journey. This engagement is designed to support insight into autonomic nervous system activation or stress and anxiety responses, and to facilitate emotion regulation or the processing of difficult feelings.\nThe tableaus created can be saved, exported, and revisited.\nShare your creations on social media #EmbodiMap.", "short_description": "Developed at the UNSW felt Experience & Empathy Lab, EmbodiMap enables users to engage with feelings, sensations andand stress responses, becoming aware of how these are experienced within the body. It facilitates awareness of tension, stress responses and anxiety and may be used as part of a supported engagement, exploring emotion regulation. It supports hand-tracking, a library of figures, props and environments, avatar embodiment, and a guided meditation, individual or shared multi-user mode."}]}, "developer_name": null, "developer_privacy_policy_url": "http://kuchelmeister.net/misc/PrivacyPolicyforEmbodiMap.html", "developer_terms_of_service_url": null, "publisher_name": "felt Experience and Empathy Lab, UNSW", "support_website_url": null, "website_url": "https://kuchelmeister.net/portfolio/embodimap/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ART_CREATIVITY", "RELAXATION_MEDITATION", "SOCIAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["SITTING", "ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER"], "id": "633998014590564"}}
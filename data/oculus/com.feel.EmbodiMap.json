": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39036680_302677187890236_1969448781908096276_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HQEelXxcufsQ7kNvwGrtZKV&_nc_oc=Ado7D0AfDuODjo8keNezvRsAb41urd4qFQDIAGnb7WyM59NiZTII-P7Fqsa9OO6wKns&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQo477q4PrZA9rY7WPD6qMWGWsi7KI2xTovwzS_7O0GEw&oe=6B0DAB3A"}]}, "id": "471704080700448", "locale": "en_US", "screenshots": [{"file_name": "screenshot_2.png", "id": "5921419771231469", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39035438_5921419774564802_7341287331724410610_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jVHRJh1rpCIQ7kNvwH-BBbk&_nc_oc=AdqyztQyKKKyFWLJZqq6081zXK2qJxYLZ_IyA22pCDXSoaklOVsFB6ph4T-9QywwI6w&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTnqHSjZ8V8ZgFDBR7uKeWcaSEgkAgp3RPoAd3vEdBU_A&oe=6B0DC625"}, {"file_name": "screenshot_1.png", "id": "553221008979530", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974703_553221012312863_1867867182728372798_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qA66P7nKJrAQ7kNvwFWw8nj&_nc_oc=Adqn1BAtgDwLHp1T9k0UwdgR2cKFv88BKjwtnv7kp4m0XSyKLlqkosZFw6oYIBYpGFk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTYeej6e_MVRg6uF659-BIcx8SVwVvyKYxjfLTQ3K5Pqw&oe=6B0DC179"}, {"file_name": "screenshot_3.png", "id": "2943382102558757", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/57575369_2943382105892090_8957030490266986422_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DKA-345NwKoQ7kNvwEyBwZI&_nc_oc=Adpp_5tjxNI1UtRL06NTHWyFCJEPxBqRtGwwOPjACLbyagOJIEWA75ZsPX8D-x7Im0k&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQsXfBATddr7qY8J07IhNEuksRvWFXcTw9IXQEnSW2-2g&oe=6B0DBCD7"}, {"file_name": "screenshot_4.png", "id": "370239084276463", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75622018_370239087609796_1758523008600931701_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T5r_ygzQPuIQ7kNvwH55LDN&_nc_oc=AdqJUXOMIeh5mzqhDd-zbsL_D65K_Dtp5ztETjM6eEVDplfc36XMaEsRvQ_HZZ6ObLk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSQocie0yvU56IwGuEPNHS1yBkIZBgs2xmoxrOliyuaYg&oe=6B0DA9EF"}, {"file_name": "screenshot_5.png", "id": "451294959494546", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/57572919_451294962827879_8457223053420767661_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7M38yK5ow7YQ7kNvwETKkEv&_nc_oc=AdrECTrQfrzb4NQcAxGlS9PVLLnEn0R1bQswHPmpCqAN6vMe_t5Ep02Q-CawsHbxKjs&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSLDMh--xf8rU3tOhRC4aeTrCysqfFPTBP702baiTf4bw&oe=6B0DD0E1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "video_cover_2560x1440.png", "id": "929308274279146", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75282165_929308277612479_9040430983808014993_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T4I3AYXN5FUQ7kNvwFxrZ8n&_nc_oc=AdoPXAr5jFlMRSmPHOk3TEBQ_9g72pNG5UCx1O8NmvzeH1V9mytcSI1NKb88qfibBFg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQquc5Y4UBnJwkK_4gUW3HlSoTCQESEixu_3EoPHGmtUg&oe=6B0DA229"}, "display_name": "EmbodiMap", "keywords": [], "long_description": "EmbodiMap is a creative experience that enables users to connect with and explore how emotions, sensations, and stress responses are experienced in the body. Each time a feeling/sensation is identified, it can be drawn into an avatar figure. Users can freely move around or enter inside their avatar bodies. In this way, participants create and dynamically engage with a field of 3D sensory maps, which tell a story of changing sensation and awareness.\nA range of 3D \u2018avatar\u2019 bodies, props and environments are available. Avatar bodies may be selectively (re)shaped, mirroring the pose of users.\nUsers may choose to be voice guided; have a shared experience or go on a self-directed journey. This engagement is designed to support insight into autonomic nervous system activation or stress and anxiety responses, and to facilitate emotion regulation or the processing of difficult feelings.\nThe tableaus created can be saved, exported, and revisited.\nShare your creations on social media #EmbodiMap.", "short_description": "Developed at the UNSW felt Experience & Empathy Lab, EmbodiMap enables users to engage with feelings, sensations andand stress responses, becoming aware of how these are experienced within the body. It facilitates awareness of tension, stress responses and anxiety and may be used as part of a supported engagement, exploring emotion regulation. It supports hand-tracking, a library of figures, props and environments, avatar embodiment, and a guided meditation, individual or shared multi-user mode."}]}, "developer_name": null, "developer_privacy_policy_url": "http://kuchelmeister.net/misc/PrivacyPolicyforEmbodiMap.html", "developer_terms_of_service_url": null, "publisher_name": "felt Experience and Empathy Lab, UNSW", "support_website_url": null, "website_url": "https://kuchelmeister.net/portfolio/embodimap/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ART_CREATIVITY", "RELAXATION_MEDITATION", "SOCIAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["SITTING", "ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER"], "id": "633998014590564"}}
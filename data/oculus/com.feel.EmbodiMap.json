": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39036680_302677187890236_1969448781908096276_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ygIOJiXoxWkQ7kNvwEpvjH4&_nc_oc=Adqjmo60em0oPbXvm25pOBQpXsT1mk31xHxQM2O_sWNyZfRcEubqb6M9gVlxF6jH8LU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTfVdR1ZdHNF87MJPfqN9thKjbpTn5LpA-ao2HcOq5_Ig&oe=6AFDD93A"}]}, "id": "471704080700448", "locale": "en_US", "screenshots": [{"file_name": "screenshot_2.png", "id": "5921419771231469", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39035438_5921419774564802_7341287331724410610_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yJ4lQ-m36fAQ7kNvwHqsCID&_nc_oc=Adp1-VY9nTXSpmubdLMlQffN9kq5qlihcFH2p9z6-YxFCapHYE6CmhI5oZwWibO062Q&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTuFC-Hb_Ps78LZqz2v5Q_a5IDQfCf1KTf2RpC-CkGj8w&oe=6AFDBBE5"}, {"file_name": "screenshot_1.png", "id": "553221008979530", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974703_553221012312863_1867867182728372798_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=p6dLCviOn0AQ7kNvwGakAEm&_nc_oc=AdpXne6eqSTiKvfmiMBqaEEnSaDPGg1M-ffsYM62BhfyphmN4480w2XvRoiS30qj3FE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRS1ZXyIlfFPgjncF1Ies-m14KKB02oCTdeDUHstO8CeA&oe=6AFDB739"}, {"file_name": "screenshot_3.png", "id": "2943382102558757", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/57575369_2943382105892090_8957030490266986422_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uULjtThYYNAQ7kNvwFWroWZ&_nc_oc=AdrhmswusE1p5hggusobGtDxLxl4atQE8oJGWDP0r4PhWW2PDkqKUEYAachSXak7_6c&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRUxNyaJOoBOlozd4EdnxpaItVhd5IHV1aAp2cH6lr69w&oe=6AFDB297"}, {"file_name": "screenshot_4.png", "id": "370239084276463", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75622018_370239087609796_1758523008600931701_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h1kJJZfjusIQ7kNvwG6UVEF&_nc_oc=AdrchepEJEs5-N87J0LHyV0wwLn6UZPZeCHVtqNhgsHIEvXm_3OvI2Isu8dfn-yt8FU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRTIpdw03zSIx60yckFo0elHdOv11xgHTfqiicMOkLIeg&oe=6AFDD7EF"}, {"file_name": "screenshot_5.png", "id": "451294959494546", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/57572919_451294962827879_8457223053420767661_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CgPob-U2AooQ7kNvwEwh97f&_nc_oc=AdrlUjcUP1i7eESsfjaybLrKIl73JUDatzUGuQaZqvEckoLF1ncG60E6fymSKRYBqes&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT5QqpF_C6xMMpTRn9PhdU_kX7BzVI1vzxJ8YRVlN9AwQ&oe=6AFDC6A1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "video_cover_2560x1440.png", "id": "929308274279146", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75282165_929308277612479_9040430983808014993_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7G8ZIxN3RAIQ7kNvwFLAf8r&_nc_oc=Adqe4YfSJ5ju5Kvn0fL_SJCPDO2ff5f76yPCT9fcPlKR75S13-hdkcZNscUqzwc6NDE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQxtnUluVdm3VXW1lNmGR0LcqM6lTIcYZ0x59cs6BLKjA&oe=6AFDD029"}, "display_name": "EmbodiMap", "keywords": [], "long_description": "EmbodiMap is a creative experience that enables users to connect with and explore how emotions, sensations, and stress responses are experienced in the body. Each time a feeling/sensation is identified, it can be drawn into an avatar figure. Users can freely move around or enter inside their avatar bodies. In this way, participants create and dynamically engage with a field of 3D sensory maps, which tell a story of changing sensation and awareness.\nA range of 3D \u2018avatar\u2019 bodies, props and environments are available. Avatar bodies may be selectively (re)shaped, mirroring the pose of users.\nUsers may choose to be voice guided; have a shared experience or go on a self-directed journey. This engagement is designed to support insight into autonomic nervous system activation or stress and anxiety responses, and to facilitate emotion regulation or the processing of difficult feelings.\nThe tableaus created can be saved, exported, and revisited.\nShare your creations on social media #EmbodiMap.", "short_description": "Developed at the UNSW felt Experience & Empathy Lab, EmbodiMap enables users to engage with feelings, sensations andand stress responses, becoming aware of how these are experienced within the body. It facilitates awareness of tension, stress responses and anxiety and may be used as part of a supported engagement, exploring emotion regulation. It supports hand-tracking, a library of figures, props and environments, avatar embodiment, and a guided meditation, individual or shared multi-user mode."}]}, "developer_name": null, "developer_privacy_policy_url": "http://kuchelmeister.net/misc/PrivacyPolicyforEmbodiMap.html", "developer_terms_of_service_url": null, "publisher_name": "felt Experience and Empathy Lab, UNSW", "support_website_url": null, "website_url": "https://kuchelmeister.net/portfolio/embodimap/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ART_CREATIVITY", "RELAXATION_MEDITATION", "SOCIAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["SITTING", "ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER"], "id": "633998014590564"}}
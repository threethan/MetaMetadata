": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39036680_302677187890236_1969448781908096276_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ygIOJiXoxWkQ7kNvwE2oNGu&_nc_oc=AdqeCcYbQr2aT0iwQLt8Sa3avESliDfIwRbmuO8YbTZhAKIY0dEft2BkB3vexxnYZ9I&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS4GRsRLVd4Ql6x6mhMO3w_nmRq-KZyk2LSJ-SWsnwGEQ&oe=6B007C3A"}]}, "id": "471704080700448", "locale": "en_US", "screenshots": [{"file_name": "screenshot_2.png", "id": "5921419771231469", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39035438_5921419774564802_7341287331724410610_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yJ4lQ-m36fAQ7kNvwGbR_Hf&_nc_oc=AdrXwJOydTgHIDdZ6KhJHGSS7GpdQunzqSXYb0AVs7ZOg0kva--GDt3qPKUX2n_tz_A&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSiJeERxIkYXyEk2_SCqJpWN0A8PNhrTz8eBFJ3CjB1EQ&oe=6B005EE5"}, {"file_name": "screenshot_1.png", "id": "553221008979530", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974703_553221012312863_1867867182728372798_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=p6dLCviOn0AQ7kNvwEjeGJ8&_nc_oc=AdrV8Qpx9g9Mj27J40WC-TV3BQrW-mXD9ksbG5NqaZbPeGXWSExrHB-i74aZIrAuZac&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSbzjW_voRz14_3aIK5W_P7MxStKm95oopdp0rklwCeWQ&oe=6B005A39"}, {"file_name": "screenshot_3.png", "id": "2943382102558757", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/57575369_2943382105892090_8957030490266986422_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HEXgkXSKa-8Q7kNvwHVuKBP&_nc_oc=Adr8amEMUOVj4DJSZzWQhuIIYXNfGgyTz35mG1g2v2aEMfjJPstAlIZvgmHXkfktSD4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQXcX_i1vIFi__Kd4xXmU6U1FWSmayCdsIbUV01mZv8QA&oe=6B005597"}, {"file_name": "screenshot_4.png", "id": "370239084276463", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75622018_370239087609796_1758523008600931701_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h1kJJZfjusIQ7kNvwGi4Ftl&_nc_oc=AdqozQ3cxjtF1c45PLrpwRhSGPlmQmdusYjc7W9Oe3X6I2jEIgECXS316R-2SF_bp1w&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTiEo50HfXXSg709DYgxR5cUbZnHoVn_LNi02UxSkoINA&oe=6B007AEF"}, {"file_name": "screenshot_5.png", "id": "451294959494546", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/57572919_451294962827879_8457223053420767661_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XEeIj0HDncoQ7kNvwFiyMcc&_nc_oc=AdqMVXPiSCCNkD-kD2A4kPOttF-k0pR40S9W2fwnIfH9R_0eNtX9RZd2I1yZJ2yXHGY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTkNiw4iEH7_qv6e3PfQA5-IMp2GjP32evuuM2-9UGOcg&oe=6B0069A1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "video_cover_2560x1440.png", "id": "929308274279146", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75282165_929308277612479_9040430983808014993_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8epJ-IyHfz0Q7kNvwH-mdns&_nc_oc=AdplJAk4FleVEj42gJ7DCnecO2sipITylmFGGOzNCor-VrRc4LajARGLpbhssSwOfLQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRPmNBf3QvZkT_BBwUi25OE8Gq56bxe2GhWfPGFRooOAQ&oe=6B007329"}, "display_name": "EmbodiMap", "keywords": [], "long_description": "EmbodiMap is a creative experience that enables users to connect with and explore how emotions, sensations, and stress responses are experienced in the body. Each time a feeling/sensation is identified, it can be drawn into an avatar figure. Users can freely move around or enter inside their avatar bodies. In this way, participants create and dynamically engage with a field of 3D sensory maps, which tell a story of changing sensation and awareness.\nA range of 3D \u2018avatar\u2019 bodies, props and environments are available. Avatar bodies may be selectively (re)shaped, mirroring the pose of users.\nUsers may choose to be voice guided; have a shared experience or go on a self-directed journey. This engagement is designed to support insight into autonomic nervous system activation or stress and anxiety responses, and to facilitate emotion regulation or the processing of difficult feelings.\nThe tableaus created can be saved, exported, and revisited.\nShare your creations on social media #EmbodiMap.", "short_description": "Developed at the UNSW felt Experience & Empathy Lab, EmbodiMap enables users to engage with feelings, sensations andand stress responses, becoming aware of how these are experienced within the body. It facilitates awareness of tension, stress responses and anxiety and may be used as part of a supported engagement, exploring emotion regulation. It supports hand-tracking, a library of figures, props and environments, avatar embodiment, and a guided meditation, individual or shared multi-user mode."}]}, "developer_name": null, "developer_privacy_policy_url": "http://kuchelmeister.net/misc/PrivacyPolicyforEmbodiMap.html", "developer_terms_of_service_url": null, "publisher_name": "felt Experience and Empathy Lab, UNSW", "support_website_url": null, "website_url": "https://kuchelmeister.net/portfolio/embodimap/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ART_CREATIVITY", "RELAXATION_MEDITATION", "SOCIAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["SITTING", "ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER"], "id": "633998014590564"}}
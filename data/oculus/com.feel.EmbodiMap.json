": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39036680_302677187890236_1969448781908096276_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M5ZI9aiJx7wQ7kNvwGriBAv&_nc_oc=Ado9LZlE0wQ6wDP_EsJ_5kedHn5zUaLAoPqDdFIheYZtDJ4wy79X4OsF52Rd2J_JMFA&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTS2EvGXgE2zBH0e5pYgaJF1zvWldSmEnryZXUm5_xLmw&oe=6B09B6BA"}]}, "id": "471704080700448", "locale": "en_US", "screenshots": [{"file_name": "screenshot_2.png", "id": "5921419771231469", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39035438_5921419774564802_7341287331724410610_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8cYGW_BM43cQ7kNvwEeabXT&_nc_oc=Adq0Ixjz0fJl08ML4Abz0oOH565ooYmbyyVLExzoDeSRy8r2CL_akdCPJLIOui2GaSI&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQBZs9oaOIOHNGZsLk0PvXpF29KCRM51Lu5ERAXZZF2GQ&oe=6B09D1A5"}, {"file_name": "screenshot_1.png", "id": "553221008979530", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/38974703_553221012312863_1867867182728372798_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GUuPbQ9tVUQQ7kNvwEM9Arq&_nc_oc=AdpTw5C5hCaz1WPiA8StS3Cs1n-iAhN3QMJGaEVamUnzpK6_Dd2YNA2E_qidTl6UI2s&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS01WLcke-yG_nh-vDjv0eQrTjHj-k9wzeUuVYIGa1C6Q&oe=6B09CCF9"}, {"file_name": "screenshot_3.png", "id": "2943382102558757", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/57575369_2943382105892090_8957030490266986422_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KA4cK-mzOs8Q7kNvwEoo9y-&_nc_oc=Adqy7zYAYJzMqxb-vQEf8PaD-8sLaSE9QEX5Z_NUL3_00hZ2pp0w8tR5Ub5q0jGYD70&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSfLVy1xEf6vzAaBImPht6SIQDj0cOgMVSXbK8k-kqVDQ&oe=6B09C857"}, {"file_name": "screenshot_4.png", "id": "370239084276463", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75622018_370239087609796_1758523008600931701_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TiAukp4KPXcQ7kNvwG4SwDl&_nc_oc=AdpC82CCsDJbVSABhJWBj5V_EwSadeea83fY-JJ2azzVMSyGIPmkjEpLCeFpdlk0wFs&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSam-Koxq57eZIuwIeKCP8IetTE6Es5vHsk5WmIER8vbg&oe=6B09B56F"}, {"file_name": "screenshot_5.png", "id": "451294959494546", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/57572919_451294962827879_8457223053420767661_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WR8-vMi5ICkQ7kNvwGFEPHf&_nc_oc=Adr7elOro65Pes4eLTLVn3Xx_gIDihfr3JH1knBd7FnwzDo7HdUlX2SwKJjAtFMkGeM&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR7DNudsZ-ZMkXMFBDRT2J2LVyh_Vgeczrbln4x3NEWXg&oe=6B09A421"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "video_cover_2560x1440.png", "id": "929308274279146", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75282165_929308277612479_9040430983808014993_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LA5Fk1j7Dj0Q7kNvwFoToRY&_nc_oc=Adrk1n1DEpFcL33pbumG0YK6J-qglS4zD7p2i4eP7pcXWQUd9EtmbrhcfTDoTkWVBO4&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTHKtDOWDYj4RDjUGeVfaZH9aLFhvTsqoSs6X69p720RQ&oe=6B09ADA9"}, "display_name": "EmbodiMap", "keywords": [], "long_description": "EmbodiMap is a creative experience that enables users to connect with and explore how emotions, sensations, and stress responses are experienced in the body. Each time a feeling/sensation is identified, it can be drawn into an avatar figure. Users can freely move around or enter inside their avatar bodies. In this way, participants create and dynamically engage with a field of 3D sensory maps, which tell a story of changing sensation and awareness.\nA range of 3D \u2018avatar\u2019 bodies, props and environments are available. Avatar bodies may be selectively (re)shaped, mirroring the pose of users.\nUsers may choose to be voice guided; have a shared experience or go on a self-directed journey. This engagement is designed to support insight into autonomic nervous system activation or stress and anxiety responses, and to facilitate emotion regulation or the processing of difficult feelings.\nThe tableaus created can be saved, exported, and revisited.\nShare your creations on social media #EmbodiMap.", "short_description": "Developed at the UNSW felt Experience & Empathy Lab, EmbodiMap enables users to engage with feelings, sensations andand stress responses, becoming aware of how these are experienced within the body. It facilitates awareness of tension, stress responses and anxiety and may be used as part of a supported engagement, exploring emotion regulation. It supports hand-tracking, a library of figures, props and environments, avatar embodiment, and a guided meditation, individual or shared multi-user mode."}]}, "developer_name": null, "developer_privacy_policy_url": "http://kuchelmeister.net/misc/PrivacyPolicyforEmbodiMap.html", "developer_terms_of_service_url": null, "publisher_name": "felt Experience and Empathy Lab, UNSW", "support_website_url": null, "website_url": "https://kuchelmeister.net/portfolio/embodimap/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ART_CREATIVITY", "RELAXATION_MEDITATION", "SOCIAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["SITTING", "ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER"], "id": "633998014590564"}}
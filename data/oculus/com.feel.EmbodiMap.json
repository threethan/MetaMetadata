": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39036680_302677187890236_1969448781908096276_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HQEelXxcufsQ7kNvwGLdu-O&_nc_oc=AdpYoJAaf6j_9h1n8MALrNESfLGB2FOj8lzq0USDfSHS0X-AcsZQOBxbH-RpaWRANEA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQUdVHtZ2p5aJQi0zQV2-opJBn22rABw2lViwGIoGCKimw&oe=6B104E3A"}]}, "id": "471704080700448", "locale": "en_US", "screenshots": [{"file_name": "screenshot_2.png", "id": "5921419771231469", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39035438_5921419774564802_7341287331724410610_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jVHRJh1rpCIQ7kNvwEc1hMw&_nc_oc=Adr_EOJ67XkklapbVymjlKD5gfjOtmQXkCIorutguJ-unlZO8k8m3lr70HDFOQc68Ws&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWZS4OuU_u96WNHAp3o__zWP41A3kcIHSBJcvFOokIklw&oe=6B106925"}, {"file_name": "screenshot_1.png", "id": "553221008979530", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974703_553221012312863_1867867182728372798_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qA66P7nKJrAQ7kNvwF8vJaI&_nc_oc=AdosBig-1e0YCeRq6RJyYXZSylTc6J5brqZogLih7gDCeDA8nDofhbkJVCOOT12DvYk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXLl2jIm3gahZzq8jS3PzT_WSSsj6ow4ytIyMgjQEb3DA&oe=6B106479"}, {"file_name": "screenshot_3.png", "id": "2943382102558757", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/57575369_2943382105892090_8957030490266986422_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cqHPMHLyxbAQ7kNvwHKYwri&_nc_oc=AdrLBO8-81Ipp_lsVr12GExjcTPany2v6f7ahObKlbjbOSVjGf82E2_VoQEtzEg68kc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQUkYQ4byarUIfNu5f8Y8m-Yjulb0DkPNvjvcmmxjBo13w&oe=6B105FD7"}, {"file_name": "screenshot_4.png", "id": "370239084276463", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75622018_370239087609796_1758523008600931701_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T5r_ygzQPuIQ7kNvwHUvMgz&_nc_oc=AdoFImoOrBjG4zGuwS91BfQ9yRjn-20Jau41mzmQK4mlaY8iFTFvNgoHMoMdsbIXr5M&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXj5Ta5JA0wUT34PKmhPEtD5q-zucUwR8T4tEEdUGzdZw&oe=6B104CEF"}, {"file_name": "screenshot_5.png", "id": "451294959494546", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/57572919_451294962827879_8457223053420767661_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ej-fhF7sRpUQ7kNvwGJDXRa&_nc_oc=AdqlbYC7paaomX3l5ZqRhv2wj77-zUEyU8xyQ-itkkWUdf6oV_uYFDNYokfqNz-Ne1c&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVW06Sh3peDm_W_-eti6S8H1P1oYTSWNxaBDvb_AoPYlw&oe=6B103BA1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "video_cover_2560x1440.png", "id": "929308274279146", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75282165_929308277612479_9040430983808014993_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SLGNHt6BcksQ7kNvwH356I_&_nc_oc=AdrzvR1awi542roPxap4usYuQ-spdkXm_VT6swxbjJ8012yQcvYs4Qn1gf4LaUS3kl8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQURxXHAl3i7MQ5A93uBzPng6l3e0pfX8k6pB9RfEpc7LQ&oe=6B104529"}, "display_name": "EmbodiMap", "keywords": [], "long_description": "EmbodiMap is a creative experience that enables users to connect with and explore how emotions, sensations, and stress responses are experienced in the body. Each time a feeling/sensation is identified, it can be drawn into an avatar figure. Users can freely move around or enter inside their avatar bodies. In this way, participants create and dynamically engage with a field of 3D sensory maps, which tell a story of changing sensation and awareness.\nA range of 3D \u2018avatar\u2019 bodies, props and environments are available. Avatar bodies may be selectively (re)shaped, mirroring the pose of users.\nUsers may choose to be voice guided; have a shared experience or go on a self-directed journey. This engagement is designed to support insight into autonomic nervous system activation or stress and anxiety responses, and to facilitate emotion regulation or the processing of difficult feelings.\nThe tableaus created can be saved, exported, and revisited.\nShare your creations on social media #EmbodiMap.", "short_description": "Developed at the UNSW felt Experience & Empathy Lab, EmbodiMap enables users to engage with feelings, sensations andand stress responses, becoming aware of how these are experienced within the body. It facilitates awareness of tension, stress responses and anxiety and may be used as part of a supported engagement, exploring emotion regulation. It supports hand-tracking, a library of figures, props and environments, avatar embodiment, and a guided meditation, individual or shared multi-user mode."}]}, "developer_name": null, "developer_privacy_policy_url": "http://kuchelmeister.net/misc/PrivacyPolicyforEmbodiMap.html", "developer_terms_of_service_url": null, "publisher_name": "felt Experience and Empathy Lab, UNSW", "support_website_url": null, "website_url": "https://kuchelmeister.net/portfolio/embodimap/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ART_CREATIVITY", "RELAXATION_MEDITATION", "SOCIAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["SITTING", "ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER"], "id": "633998014590564"}}
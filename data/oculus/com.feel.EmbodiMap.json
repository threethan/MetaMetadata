": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/39036680_302677187890236_1969448781908096276_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GsSb-xSeY08Q7kNvwFKiy37&_nc_oc=AdrIMssHR_in_FVb7aPze4eiuUuqP2X8qWUtEWBbX9dxd86TZScmjffFP0jlyFEWsLk&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTit3JYAuqS_rHqrdhSqTjuXdL3eb6Bwd-4F7Uiv5r7nA&oe=6AFB363A"}]}, "id": "471704080700448", "locale": "en_US", "screenshots": [{"file_name": "screenshot_2.png", "id": "5921419771231469", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/39035438_5921419774564802_7341287331724410610_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Md8wzuS1XxYQ7kNvwGDPOB7&_nc_oc=AdqnL59MpuYZh-W42bDvwQtinrkMH1_zy2jY_KaFTYhoh9zHWK5fYUFPkwjj74fa35A&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQeqjqhVMDd0z3NB9jXffmZPqyHC-JXVzsijaEnjG4iMA&oe=6AFB18E5"}, {"file_name": "screenshot_1.png", "id": "553221008979530", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38974703_553221012312863_1867867182728372798_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zsut9JhlmwYQ7kNvwE8h9wd&_nc_oc=AdqNCUo-M-pdJi1QELXaagF-NHlktSyx87GA4pMqa1Gs-VdiqnM9sdC_c0gVCQo9VmM&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTtyAgbkFzTt6PlsYyYx8XMqunQwzkGOhOZLVDrPkOMeQ&oe=6AFB4C79"}, {"file_name": "screenshot_3.png", "id": "2943382102558757", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/57575369_2943382105892090_8957030490266986422_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kJr694S_F2QQ7kNvwH9MZRP&_nc_oc=Adq12ZutjReHq1BV1IuR83g1zocKIP99XzsTi191nQx9evn_futbrcYmxfysCQiFEHI&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSinkZERvVzhYHBr7jTVrBjKqlwoln_N3mod9JUZpB3tQ&oe=6AFB47D7"}, {"file_name": "screenshot_4.png", "id": "370239084276463", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/75622018_370239087609796_1758523008600931701_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uYd82_cQzA4Q7kNvwEikjcp&_nc_oc=AdqifJTdPMs1boexJdjfquPcexDpOXIlfxhzl9-BIC70p7mlCo6U2FSd5Dn9XA4bRDQ&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQZWzxgzY1LSiAxw6t9zfLgX8QIE5NLSZCc0YcD2m_BEg&oe=6AFB34EF"}, {"file_name": "screenshot_5.png", "id": "451294959494546", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/57572919_451294962827879_8457223053420767661_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_K9DARoAKgoQ7kNvwHFopWs&_nc_oc=AdpwgAwHc10l_2Ewmudn204hLMU_95N_vNKzFqNYWA_OgJtFAb55Wj1JH7AeE73SrTA&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTrQoSzGMLVUfYlXmhcy8pX_jysHIdJsilXVzdKWdptnQ&oe=6AFB23A1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "video_cover_2560x1440.png", "id": "929308274279146", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/75282165_929308277612479_9040430983808014993_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7G8ZIxN3RAIQ7kNvwFx83Z_&_nc_oc=AdpjT2uW33C4mpOuOdjpcbD6v5JVDyffpYl-R9QK9Ftn3qeqWQcOYLvL-FnWnvtQKUM&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ-1JYrr4TNXAKyzlfrjtziqktfnAyj-76vE_Cfxsvs6w&oe=6AFB2D29"}, "display_name": "EmbodiMap", "keywords": [], "long_description": "EmbodiMap is a creative experience that enables users to connect with and explore how emotions, sensations, and stress responses are experienced in the body. Each time a feeling/sensation is identified, it can be drawn into an avatar figure. Users can freely move around or enter inside their avatar bodies. In this way, participants create and dynamically engage with a field of 3D sensory maps, which tell a story of changing sensation and awareness.\nA range of 3D \u2018avatar\u2019 bodies, props and environments are available. Avatar bodies may be selectively (re)shaped, mirroring the pose of users.\nUsers may choose to be voice guided; have a shared experience or go on a self-directed journey. This engagement is designed to support insight into autonomic nervous system activation or stress and anxiety responses, and to facilitate emotion regulation or the processing of difficult feelings.\nThe tableaus created can be saved, exported, and revisited.\nShare your creations on social media #EmbodiMap.", "short_description": "Developed at the UNSW felt Experience & Empathy Lab, EmbodiMap enables users to engage with feelings, sensations andand stress responses, becoming aware of how these are experienced within the body. It facilitates awareness of tension, stress responses and anxiety and may be used as part of a supported engagement, exploring emotion regulation. It supports hand-tracking, a library of figures, props and environments, avatar embodiment, and a guided meditation, individual or shared multi-user mode."}]}, "developer_name": null, "developer_privacy_policy_url": "http://kuchelmeister.net/misc/PrivacyPolicyforEmbodiMap.html", "developer_terms_of_service_url": null, "publisher_name": "felt Experience and Empathy Lab, UNSW", "support_website_url": null, "website_url": "https://kuchelmeister.net/portfolio/embodimap/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ART_CREATIVITY", "RELAXATION_MEDITATION", "SOCIAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["SITTING", "ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER"], "id": "633998014590564"}}
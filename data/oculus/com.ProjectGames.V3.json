9834957966_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hYMxxmxe_YQQ7kNvwHnc2vB&_nc_oc=AdrrGUHjRFxbHjlXv9fw8gExFs8zSWJdc-JDGGIJTEVM8TvcmPjhvK4hlZa_VYTTB9I&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8ynX7ctvnnUS6Xd6WzFdcrvPMf7tlva7a7hvvBA86_XQ&oe=6A39477A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Project Games V3", "keywords": ["projectgamesv3", "projectgames"], "long_description": "Project Games V3 is a fast-paced, movement-focused Gorilla Tag fan game that brings a brand-new twist to VR monkey locomotion. Swing, climb, bounce, and launch yourself through a collection of unique maps designed for speed, skill, and chaotic fun. Whether you're racing friends, exploring hidden secrets, or mastering advanced parkour routes, Project Games V3 delivers nonstop action and replayability.\n\nFeaturing smooth physics, expressive cosmetics, and an expanding lineup of game-modes, Project Games V3 is built for players who love high-energy VR movement and competitive tag-style gameplay. Jump in, sharpen your skills, and become one of the fastest monkeys in the Project universe!", "short_description": "a fun gtag fan game!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/gametaggersprivacypolicy/home", "developer_terms_of_service_url": null, "publisher_name": "Tonda", "support_website_url": null, "website_url": "https://pandyvr.github.io/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"]
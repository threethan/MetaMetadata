e7a0a&_nc_ohc=SK8tvikBuN8Q7kNvwEu1zBA&_nc_oc=AdkIxSPi7v5tFee5Jie6V_jvIBsOANZne4yKfVdU9FFEWCWV6d_VfYdN_Z_rU0PNHHo&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=8&oh=00_AfyAPNPwcw1ZLMVRVf7PCffvkKdTLml7f9g_EiQsfRaGkg&oe=69BD5A7A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Project Games V3", "keywords": ["projectgamesv3", "projectgames"], "long_description": "Project Games V3 is a fast-paced, movement-focused Gorilla Tag fan game that brings a brand-new twist to VR monkey locomotion. Swing, climb, bounce, and launch yourself through a collection of unique maps designed for speed, skill, and chaotic fun. Whether you're racing friends, exploring hidden secrets, or mastering advanced parkour routes, Project Games V3 delivers nonstop action and replayability.\n\nFeaturing smooth physics, expressive cosmetics, and an expanding lineup of game-modes, Project Games V3 is built for players who love high-energy VR movement and competitive tag-style gameplay. Jump in, sharpen your skills, and become one of the fastest monkeys in the Project universe!", "short_description": "a fun gtag fan game!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/gametaggersprivacypolicy/home", "developer_terms_of_service_url": null, "publisher_name": "Tonda", "support_website_url": null, "website_url": "https://pandyvr.github.io/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "suppo
20f&oh=00_AQTHEyeMrpDWsD6NGd6Hlotvx1_3L5uaNizEbcMISVFSCw&oe=6B00871E"}, {"file_name": "Screenshot-5.png", "id": "2060186961098211", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974848_2060186964431544_6961160952265951621_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u6SVH5ffFP8Q7kNvwFC-fmt&_nc_oc=Adq5VNzsD49XoXwWchof6NrEn1P8tZJP_vHTWrrW2IMyo8iAbw-s2lFzTeZbI5w0aLE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSHZoxEMorl8RpPKw0FGuO1NtLBtfoTENwTr46arKN7PA&oe=6B0069F0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape.png", "id": "803269542596319", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491820428_803269545929652_1846309282168609698_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o-fH2-CtcgoQ7kNvwHYskw0&_nc_oc=AdoAm1ID9841i0Rsyw9IilOK_coN2dutw4VR5p9qAzlbvJU9CcGAArQzqi64nABCSS8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRlZX5W-zv7_COCxxW2UzV1NoI8rBbfzzFtx5U1Qa2AUw&oe=6B007117"}, "display_name": "Sortik Systems", "keywords": ["Puzzle", "L\u00f3gica", "Reflejos", "Arcade", "Control"], "long_description": "..                                                                                                                                                                                                     \n                                                                                \n{1176044934598700}\n{971798304798905}\n{1262389932019219}\n{1725226888379160}  \n{1806637640194604}\n{4023230531156620}\n\n\nLocuci\u00f3n en Ingl\u00e9s y en Espa\u00f1ol.\n\n# Accesibilidad\n\n- Dise\u00f1o apto para dalt\u00f3nicos con sistema de codificaci\u00f3n por texturas.\n\n- Juego completamente con una mano (controles/seguimiento manual).\n\n- Ajustes de comodidad para juego en modo sentado.\n\n**\u00a1Tu opini\u00f3n importa!** Si tienes sugerencias o comentarios, no dudes en ponerte en contacto en Discord: https://discord.pamp.es/\n\nGracias por ser parte de la evoluci\u00f3n de **Sortik Systems**.\n\n\u2013 Alex Pamp\n\n", "short_description": "Hoy es tu primer d\u00eda de trabajo en Sortik Systems. La megacorporaci\u00f3n que promete el orden absoluto pero guarda un oscuro secreto. \n\n\u00bfHasta d\u00f3nde llegar\u00e1s para mantener el orden?\n\nTu trabajo consiste en clasificar objetos seg\u00fan su color y atributos. Pero entremedias empiezan a aparecer mensajes... advertencias... \u00bfQui\u00e9n los env\u00eda?\nCuidado. La corporaci\u00f3n te observa. \n\n\u00bfEst\u00e1s listo para demostrar tu val\u00eda en un sistema que no tolera errores?\n"}, {"images": {"nodes": [{"file_name": "prueba1.png", "id": "2303571953377977", "image_type": "APP_IMG_MARKDOWN_INLINE", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491830880_2303571960044643_6136191984236497731_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jtGuTO9M914Q7kNvwFb_3Ia&_nc_oc=AdpAwblzoINVTIDZ7elalwzrAhUufPiUGzp1cVBNoN1I5JQZ_ulkn2U1tWr65ocURgM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTCCdPqJlhMOAy8b7gvAv-iRp5hi-Vsuun8S5FGxkLbXQ&oe=6B005E0A"}, {"file_name": "doscartelesENGBandalizado.png", "id": "2084111539021823", "image_type": "APP_IMG_MARKDOWN_INLINE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823485_2084111542355156_3457219274459529449_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N5g749XdSPoQ7kNvwElwo_A&_nc_oc=Adrlp5yB5yJRoHfO6bn3WfPqsM-iTPl4GM5UKo9WXTwDKL6-QoUI3je-PzHAgve-L4s&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSf17LTDexsOM64jEeEv_-ikdlpe_8CSktXFgsi1k2OzQ&oe=6B00712B"}, {"file_name": "primerbloqueENG.png", "id": "2067151657099937", "image_type": "APP_IMG_MARKDOWN_INLINE", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491821197_2067151660433270_8578643603422224923_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zhatYwd6BKAQ7k
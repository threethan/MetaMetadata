30f&oh=00_AQQQUe3UWcGndbu7TQi21bGbM-_2bvOdy7Djg2ccW07Imw&oe=6B0B131E"}, {"file_name": "Screenshot-5.png", "id": "2060186961098211", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974848_2060186964431544_6961160952265951621_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B9gSC3F_yn4Q7kNvwEsFF-7&_nc_oc=AdpYoY20-LmxxPLjQ6nEhGGEgK-yw1rtdzHKTXoFbQlUMAs1SGwgOzwSJuBR_cBcKks&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQHbwTvl1WM6zUrldaOa0zwLIFlp6pBgN5qFHyxv1u4rA&oe=6B0B2E30"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape.png", "id": "803269542596319", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/491820428_803269545929652_1846309282168609698_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jqc_Cv1X1LUQ7kNvwFBt3sB&_nc_oc=AdoQyxS_ESER5xYiuAbOGjKT54y5G6-9GYQV1_PjaCphdkcs3xVv5L55KgGWXrQTG5g&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRp81yGHGvu60mZvm5XAd6xo5D2L1vGjMBmjH-MyF1oaw&oe=6B0B3557"}, "display_name": "Sortik Systems", "keywords": ["Puzzle", "L\u00f3gica", "Reflejos", "Arcade", "Control"], "long_description": "..                                                                                                                                                                                                     \n                                                                                \n{1176044934598700}\n{971798304798905}\n{1262389932019219}\n{1725226888379160}  \n{1806637640194604}\n{4023230531156620}\n\n\nLocuci\u00f3n en Ingl\u00e9s y en Espa\u00f1ol.\n\n# Accesibilidad\n\n- Dise\u00f1o apto para dalt\u00f3nicos con sistema de codificaci\u00f3n por texturas.\n\n- Juego completamente con una mano (controles/seguimiento manual).\n\n- Ajustes de comodidad para juego en modo sentado.\n\n**\u00a1Tu opini\u00f3n importa!** Si tienes sugerencias o comentarios, no dudes en ponerte en contacto en Discord: https://discord.pamp.es/\n\nGracias por ser parte de la evoluci\u00f3n de **Sortik Systems**.\n\n\u2013 Alex Pamp\n\n", "short_description": "Hoy es tu primer d\u00eda de trabajo en Sortik Systems. La megacorporaci\u00f3n que promete el orden absoluto pero guarda un oscuro secreto. \n\n\u00bfHasta d\u00f3nde llegar\u00e1s para mantener el orden?\n\nTu trabajo consiste en clasificar objetos seg\u00fan su color y atributos. Pero entremedias empiezan a aparecer mensajes... advertencias... \u00bfQui\u00e9n los env\u00eda?\nCuidado. La corporaci\u00f3n te observa. \n\n\u00bfEst\u00e1s listo para demostrar tu val\u00eda en un sistema que no tolera errores?\n"}, {"images": {"nodes": [{"file_name": "prueba1.png", "id": "2303571953377977", "image_type": "APP_IMG_MARKDOWN_INLINE", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/491830880_2303571960044643_6136191984236497731_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nMs7u_E-808Q7kNvwFnQW8K&_nc_oc=Adqo6GI2olHMJuX_NI7Mbj3JGOarkVnJyFeJls2sv_50Q-btFYgJw9OUnFOXjM-23Rs&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSO2BnKEhgcIjPijc7XJG5L64V0ktTXS85LRDYsoOk4CQ&oe=6B0B224A"}, {"file_name": "doscartelesENGBandalizado.png", "id": "2084111539021823", "image_type": "APP_IMG_MARKDOWN_INLINE", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/491823485_2084111542355156_3457219274459529449_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_7rXzIrAXDwQ7kNvwE9XmHI&_nc_oc=AdqoJ9urUAV-QwU09o7-PKXgbH7cEzkX0AjPP86tcp62MYr2LBYdoBLwVgSiPnTtYzg&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQ4Cj6yNdALYiuxTdF1U6VFYsSe1nzCCON7BK6euKoshQ&oe=6B0B356B"}, {"file_name": "primerbloqueENG.png", "id": "2067151657099937", "image_type": "APP_IMG_MARKDOWN_INLINE", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/491821197_2067151660433270_8578643603422224923_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XT7QBp6S840Q7k
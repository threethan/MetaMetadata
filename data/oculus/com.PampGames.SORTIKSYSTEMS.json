30f&oh=00_AQWpHuiKFNasAd7S9M3BKFvz3tQikb9IoPvmKnHhs12gJg&oe=6B0F079E"}, {"file_name": "Screenshot-5.png", "id": "2060186961098211", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974848_2060186964431544_6961160952265951621_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NLZ3yQA1fHMQ7kNvwHm35Rs&_nc_oc=AdrseryQB6xh33jm-shxnCoErCNuOu8Pc5EabYnQ3yduYKrdOf2zhaZsFFnNm-sNNN8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWTsJ9tr_7AKRzPBHaY44mdg4phXXMYuAuYWmBf7--I_A&oe=6B0F22B0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape.png", "id": "803269542596319", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491820428_803269545929652_1846309282168609698_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wi5JcT4Ju0wQ7kNvwEKnjvj&_nc_oc=AdrWSt9IeRMStPXqCGQKRqG0O9UryRf5z9l1muULI81lRu-R40m-98K85ZJUVOsluAw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQU2fnrVBO4rrZcRTbaS9QKoYRFKvDgfdnSL2KuQsi0bpg&oe=6B0EF197"}, "display_name": "Sortik Systems", "keywords": ["Puzzle", "L\u00f3gica", "Reflejos", "Arcade", "Control"], "long_description": "..                                                                                                                                                                                                     \n                                                                                \n{1176044934598700}\n{971798304798905}\n{1262389932019219}\n{1725226888379160}  \n{1806637640194604}\n{4023230531156620}\n\n\nLocuci\u00f3n en Ingl\u00e9s y en Espa\u00f1ol.\n\n# Accesibilidad\n\n- Dise\u00f1o apto para dalt\u00f3nicos con sistema de codificaci\u00f3n por texturas.\n\n- Juego completamente con una mano (controles/seguimiento manual).\n\n- Ajustes de comodidad para juego en modo sentado.\n\n**\u00a1Tu opini\u00f3n importa!** Si tienes sugerencias o comentarios, no dudes en ponerte en contacto en Discord: https://discord.pamp.es/\n\nGracias por ser parte de la evoluci\u00f3n de **Sortik Systems**.\n\n\u2013 Alex Pamp\n\n", "short_description": "Hoy es tu primer d\u00eda de trabajo en Sortik Systems. La megacorporaci\u00f3n que promete el orden absoluto pero guarda un oscuro secreto. \n\n\u00bfHasta d\u00f3nde llegar\u00e1s para mantener el orden?\n\nTu trabajo consiste en clasificar objetos seg\u00fan su color y atributos. Pero entremedias empiezan a aparecer mensajes... advertencias... \u00bfQui\u00e9n los env\u00eda?\nCuidado. La corporaci\u00f3n te observa. \n\n\u00bfEst\u00e1s listo para demostrar tu val\u00eda en un sistema que no tolera errores?\n"}, {"images": {"nodes": [{"file_name": "prueba1.png", "id": "2303571953377977", "image_type": "APP_IMG_MARKDOWN_INLINE", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491830880_2303571960044643_6136191984236497731_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=36puhZC8yYgQ7kNvwEJmhDB&_nc_oc=AdoQLZOcXqEExE0oY6jtysKtBAHg4uKUUNm6RevpJNDPbKjHYnXq5bKrZuo4mc-SSLI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVswVZDdGsobKZZiDj_GmbN1UwbzU6yDjgxcuJanzHj9w&oe=6B0F16CA"}, {"file_name": "doscartelesENGBandalizado.png", "id": "2084111539021823", "image_type": "APP_IMG_MARKDOWN_INLINE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823485_2084111542355156_3457219274459529449_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=riL7JKykFLwQ7kNvwEbmENO&_nc_oc=AdpnBfr16IWBxNypmd2EZPodq_g4AewYZa7gFBXzwTNj7Nr_6i6RVuNlNRcmAQU_1g0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXUgVKcJ89qTaNUYmSzfqdU0J6xypR1Q_A6oufkJ1UoTA&oe=6B0EF1AB"}, {"file_name": "primerbloqueENG.png", "id": "2067151657099937", "image_type": "APP_IMG_MARKDOWN_INLINE", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491821197_2067151660433270_8578643603422224923_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WNuU43pCXUkQ7k
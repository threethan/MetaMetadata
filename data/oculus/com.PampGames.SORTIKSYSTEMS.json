20f&oh=00_AQQlt74U25tq5Hpjmah_gKakie8HmkfEH9_hapJtglY6vg&oe=6B071E9E"}, {"file_name": "Screenshot-5.png", "id": "2060186961098211", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974848_2060186964431544_6961160952265951621_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ts7y1gaXgYEQ7kNvwEiyQhW&_nc_oc=Adogj7z__sdlW9nDmEAbOUud3L3ykm_5mvF1C1krficcRjUyDUPFhm2fETtmi61ZDbQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTay-0qDDmQuAa5YffqJrUY-XMEyRxJwNJeBoXFre7Gpw&oe=6B070170"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape.png", "id": "803269542596319", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491820428_803269545929652_1846309282168609698_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o9jsHgIR1hwQ7kNvwGRrUtg&_nc_oc=AdqU-L4dNhLq-hLg-wmDonucMrBAPfzmJnukfI1RT250drPuBGJ-cA7-f5MqhxjCpD4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTVHgVPiMI0-Ul7V8guaimW3AItwo26g5XMBAaGntyeRg&oe=6B070897"}, "display_name": "Sortik Systems", "keywords": ["Puzzle", "L\u00f3gica", "Reflejos", "Arcade", "Control"], "long_description": "..                                                                                                                                                                                                     \n                                                                                \n{1176044934598700}\n{971798304798905}\n{1262389932019219}\n{1725226888379160}  \n{1806637640194604}\n{4023230531156620}\n\n\nLocuci\u00f3n en Ingl\u00e9s y en Espa\u00f1ol.\n\n# Accesibilidad\n\n- Dise\u00f1o apto para dalt\u00f3nicos con sistema de codificaci\u00f3n por texturas.\n\n- Juego completamente con una mano (controles/seguimiento manual).\n\n- Ajustes de comodidad para juego en modo sentado.\n\n**\u00a1Tu opini\u00f3n importa!** Si tienes sugerencias o comentarios, no dudes en ponerte en contacto en Discord: https://discord.pamp.es/\n\nGracias por ser parte de la evoluci\u00f3n de **Sortik Systems**.\n\n\u2013 Alex Pamp\n\n", "short_description": "Hoy es tu primer d\u00eda de trabajo en Sortik Systems. La megacorporaci\u00f3n que promete el orden absoluto pero guarda un oscuro secreto. \n\n\u00bfHasta d\u00f3nde llegar\u00e1s para mantener el orden?\n\nTu trabajo consiste en clasificar objetos seg\u00fan su color y atributos. Pero entremedias empiezan a aparecer mensajes... advertencias... \u00bfQui\u00e9n los env\u00eda?\nCuidado. La corporaci\u00f3n te observa. \n\n\u00bfEst\u00e1s listo para demostrar tu val\u00eda en un sistema que no tolera errores?\n"}, {"images": {"nodes": [{"file_name": "prueba1.png", "id": "2303571953377977", "image_type": "APP_IMG_MARKDOWN_INLINE", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491830880_2303571960044643_6136191984236497731_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2WvK_tEJIL4Q7kNvwGZqo79&_nc_oc=Ado0C362pCvGoHk12C82RsYX3t50Zru3OfunDhUKaM2OFcuG0OgitXAylTbilYIp-mM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTYHSUbUjNhKuQY_gahAQkPUZyfmPl_0l59kc9WYH4HvA&oe=6B06F58A"}, {"file_name": "doscartelesENGBandalizado.png", "id": "2084111539021823", "image_type": "APP_IMG_MARKDOWN_INLINE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823485_2084111542355156_3457219274459529449_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sLYLsD0EtrUQ7kNvwFBF2as&_nc_oc=AdqAZFW2u8Grgjum_6lvZGeDhNT0FHKheKONV_cAOH8fnrZ-r_ELJDtzDZ1ttBZUzIs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTZZXaUEUUh1wwf5yeAJNpX34kd2Sq-F9Gt6fq7yJTHIg&oe=6B0708AB"}, {"file_name": "primerbloqueENG.png", "id": "2067151657099937", "image_type": "APP_IMG_MARKDOWN_INLINE", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491821197_2067151660433270_8578643603422224923_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0wHmircPWPkQ7k
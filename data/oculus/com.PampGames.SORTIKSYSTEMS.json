20f&oh=00_AQQJpCjBfEsAlZdxf1m-aGTphby7DVt40J6_rU0s8CEQKw&oe=6AFC929E"}, {"file_name": "Screenshot-5.png", "id": "2060186961098211", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/38974848_2060186964431544_6961160952265951621_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h_Y4_bxfFr4Q7kNvwFwAhV_&_nc_oc=AdokPNSfaGM5jDwbGz6I206ifh7Y-Serr4JqtqWw7GKMSGKoQidwv9_vnSlbFyQbKHE&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTk8692nts4kJsQ48kwRe9BwPnQNlZbxyUy62EBXWGhoQ&oe=6AFC7570"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape.png", "id": "803269542596319", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491820428_803269545929652_1846309282168609698_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-HmYJaG4SowQ7kNvwFDBarx&_nc_oc=AdrX0tq3b8G-I3_RrxCPGZtsqtKkTAf9vSSKw2TERcxjgurzz7KrV5QWdAA3AiEcSmo&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT5JmT7SwKfYH12pivnmrx8i9hXtMo1hduL3IaSEPOCEg&oe=6AFC7C97"}, "display_name": "Sortik Systems", "keywords": ["Puzzle", "L\u00f3gica", "Reflejos", "Arcade", "Control"], "long_description": "..                                                                                                                                                                                                     \n                                                                                \n{1176044934598700}\n{971798304798905}\n{1262389932019219}\n{1725226888379160}  \n{1806637640194604}\n{4023230531156620}\n\n\nLocuci\u00f3n en Ingl\u00e9s y en Espa\u00f1ol.\n\n# Accesibilidad\n\n- Dise\u00f1o apto para dalt\u00f3nicos con sistema de codificaci\u00f3n por texturas.\n\n- Juego completamente con una mano (controles/seguimiento manual).\n\n- Ajustes de comodidad para juego en modo sentado.\n\n**\u00a1Tu opini\u00f3n importa!** Si tienes sugerencias o comentarios, no dudes en ponerte en contacto en Discord: https://discord.pamp.es/\n\nGracias por ser parte de la evoluci\u00f3n de **Sortik Systems**.\n\n\u2013 Alex Pamp\n\n", "short_description": "Hoy es tu primer d\u00eda de trabajo en Sortik Systems. La megacorporaci\u00f3n que promete el orden absoluto pero guarda un oscuro secreto. \n\n\u00bfHasta d\u00f3nde llegar\u00e1s para mantener el orden?\n\nTu trabajo consiste en clasificar objetos seg\u00fan su color y atributos. Pero entremedias empiezan a aparecer mensajes... advertencias... \u00bfQui\u00e9n los env\u00eda?\nCuidado. La corporaci\u00f3n te observa. \n\n\u00bfEst\u00e1s listo para demostrar tu val\u00eda en un sistema que no tolera errores?\n"}, {"images": {"nodes": [{"file_name": "prueba1.png", "id": "2303571953377977", "image_type": "APP_IMG_MARKDOWN_INLINE", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/491830880_2303571960044643_6136191984236497731_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JR_GOfU6JgoQ7kNvwGKF7Kt&_nc_oc=AdrdEBZInyyAJbQ6w-NJuJKEJh3tSFRV7JYXMQxyyt0sZaeXEfvkl81-jMcQqjSZ7cA&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRF9DNmpoJ42F_HZ2UU_awQm9TR5noZhcY8jpjBFiep5A&oe=6AFC698A"}, {"file_name": "doscartelesENGBandalizado.png", "id": "2084111539021823", "image_type": "APP_IMG_MARKDOWN_INLINE", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/491823485_2084111542355156_3457219274459529449_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=33XredXmXqsQ7kNvwG9j1bq&_nc_oc=AdpgsYjz8FZBzj1dSf_Ym5bT8yqi0XiaqApV4EBKfvHJbk75Msv0STy-1djqs4bRFBg&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSSR2va16O-RrB4ctu3t9YBro0_xtNXZbNlRi6uFbo08g&oe=6AFC7CAB"}, {"file_name": "primerbloqueENG.png", "id": "2067151657099937", "image_type": "APP_IMG_MARKDOWN_INLINE", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491821197_2067151660433270_8578643603422224923_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NaliUaz7V3kQ7k
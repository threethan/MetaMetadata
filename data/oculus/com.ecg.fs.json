ea5-1.oculuscdn.com/v/t64.5771-25/499292426_2853832228317643_7972919011490712438_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JTlJsdll1rEQ7kNvwHx8VWA&_nc_oc=Adpod1GPPc7LQK_DutqpNrZCmZuiwTmkVKh7feS8K7fecGhaRerpElB96svRENek_9I&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQODlqljfrmSjAg45mzbLQWoo64k0ujyms0Godykvf8P0g&oe=6AE1F879"}, {"file_name": "GRE_shot_07.png", "id": "1061929176393803", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499296057_1061929179727136_1953455540284683643_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ts63gddtjJEQ7kNvwFyDM-d&_nc_oc=AdrE_iIWpRM6igfhun0-vWchVfEqwudw9FEOXjXXBMYohQlk7SDpcfqtn7PDpIs5W8I&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM_fBORwKea1n8biu6OGrP3x5CK7MnOCx2KfXfREaVATQ&oe=6AE1FAA1"}, {"file_name": "GRE_shot_05.png", "id": "1717243429505120", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499300807_1717243432838453_4702506123402618318_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0VH_mqdbE2MQ7kNvwGVTC8p&_nc_oc=AdrTGG1lgZ-mE0zpW9MS5mHJjQP32NmwbzZ_4Ksmjy4THleaBdHu0UpqtAWiZvLER7A&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOoWpDC40Aik9n6iUFmNaytUGmV1BUQVnrSIgR5J_1lLQ&oe=6AE2131F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_landscape_2560x1440.png", "id": "2340325890091583", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499292232_2340325896758249_1979132392406736277_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0GaVTW0F_pUQ7kNvwFekLrc&_nc_oc=AdqDBJLhDN4AhG69mo6mZqnGFyi2dQkD7sMJ3veVeOQv3svr8Sy4lnWPR6Cfy99ZOxU&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNMfSiAW5W5pv8ZuCTSAIRQ9_ow8rFkjg3usQZEosP3AA&oe=6AE204C2"}, "display_name": "Goal Rush Eleven", "keywords": ["soccer", "futball"], "long_description": "No miras el partido. Lo juegas.\n\nGOAL RUSH ELEVEN te mete DENTRO de la cancha en realidad virtual. No es otro simulador de patear balones desde un punto fijo: eres un jugador de verdad en el campo. Corres moviendo los brazos, giras a buscar el espacio, escuchas al estadio rugir a tu espalda y, cuando el bal\u00f3n llega a tus pies, el gol depende de ti y de nadie m\u00e1s.\n\nDetr\u00e1s hay un motor de partido completo \u2014inteligencia artificial, t\u00e1cticas y f\u00edsicas reales\u2014 llevado por primera vez a la primera persona en Meta Quest. Tus compa\u00f1eros se desmarcan, la defensa te cierra el pase, el portero te lee. Sientes el partido, no lo observas.\n\nY cuando el juego se calienta pasa lo que ning\u00fan videojuego de f\u00fatbol te hab\u00eda dejado vivir: si las faltas se acumulan, se arma la pelea campal. Sueltas el bal\u00f3n y peleas con tus propios pu\u00f1os, tu equipo contra el otro, hasta que el \u00e1rbitro reparte tarjetas y el partido contin\u00faa. Tan absurdo y tan divertido como suena. No lo vas a encontrar en ning\u00fan otro lado.\n\nCada partido se juega en un mundo vivo: estadios distintos, lluvia, nieve, niebla o sol, d\u00eda y noche, la afici\u00f3n cantando porras reales y una narraci\u00f3n que te pone la piel de gallina. Ning\u00fan partido se siente igual al anterior.\n\nY todo cuenta. Ganas Bal\u00f3n Coins jugando, apuestas antes de salir al campo y escalas de los campos de barrio a los grandes estadios. Sin cables y sin excusas: solo t\u00fa, el bal\u00f3n y noventa minutos.\n\nPonte los guantes o ponte los tacos. La cancha te espera.", "short_description": "No miras el partido. Lo juegas.\n\nGOAL RUSH ELEVEN te mete DENTRO de la cancha en VR: corres moviendo los brazos, giras a buscar el hueco y, cuando el bal\u00f3n llega a tus pies, el gol depende de ti. Motor de partido real \u2014IA, t\u00e1cticas y f\u00edsicas\u2014 en primera persona en Meta Quest.\n\n\u00bfSe calienta el juego? Se arma la campal: sueltas el bal\u00f3n y peleas a pu\u00f1etazos hasta que salen las tarjetas.\n\nEstadios, lluvia, nieve, afici\u00f3n cantando. Gana Bal\u00f3n Coins jugando.\n\nLa cancha te espera."}, {"images": {"nodes": [{"file_name": "GoalRushEleven_Vertical_1008x1440.png", "id": "2204027637043477", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499292426_2204027640376810_4007200614399933090_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RAowTZmouIEQ7kNvwHFWEGz&_nc_oc=AdoF85xwtzCSF4q6wo95zhwln5Plr-MEEPVbHUHbUEcHbEtUGHBxLDgAtueezpZw61s&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMlqE7txL9i-XmkljhRfU8fKNjFs-xEQEbA9lSaHWYfNg&oe=6AE1ED44"}, {"file_name": "pano360_cubestrip_6000x1000.png", "id": "1686847905753205", "image_type": "APP_IMG_CUBEMAP_SOURCE", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/604338899_1686847909086538_6810708429269580055_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wrdTclV2fjsQ7kNvwHdyfy3&_nc_oc=AdqF5cZ3B_fpii_CnTIw7-a5atWLEa4WcxlOjp50DCorWbPul28v3NthwSrtmLXHWYc&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOIbEKXEeQBtyqW8SRuSMXUpSFT8NmYjF_AqgsiJxeT4g&oe=6AE1F744"}, {"file_name": "icon_512x512.png", "id": "1669239421041816", "image_type": "APP_IMG_ICON", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499299093_1669239424375149_2925292748848214517_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zaWfZl3srjoQ7kNvwFj0KAh&_nc_oc=Ados-PU88oqnmgGvCnX1CScpsH6l2azKkM7sLIPXZtfxEmifkd67wlcRIzO34FLXZ6M&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNwwgKmXefRtwr7K3W6e8l5_AtXhFyaB0OY54PTVJO8SA&oe=6AE1F6B9"}, {"file_name": "GoalRushEleven_Horizontal_2560x1440.png", "id": "1612255143604098", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499293669_1612255146937431_8233719748975164117_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sndQtjAVbwQQ7kNvwH1EfXj&_nc_oc=Adq7IaZOwp8l-8iddubRHCvtA57bb8fPF4bdZSxY8AIDsS-ff8c60m7HNaaDwvZLV0U&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNLz-lZh_Yg5mJKSCMtu1aef1V627jWNdGBAiecYk1VvQ&oe=
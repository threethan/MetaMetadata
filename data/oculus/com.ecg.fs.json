0e9E07o9rUinRpbnwdAp2eX2rcXPBzmJ0r-1aFrzah0&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPjd9Systl3Eqvn7-0FfZZ6vyDrETVMrVxhnitA_ZQs2w&oe=6AE20D78"}, {"file_name": "GRE_shot_09.png", "id": "1055816933500576", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499292232_1055816936833909_3000101644956586739_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8Pioubd8CxgQ7kNvwHsWpIw&_nc_oc=AdoP530bfs94Eewi-6VBqY-mseUkHqfhBrtXWzyK14NAxhIYiRaZ0ir-RZzVil3Dm_c&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPTzWp3KFa4B4Zpqs93a-qNen0Jd2jvTAAfhvVXvbAaqA&oe=6AE1F230"}, {"file_name": "GRE_shot_07.png", "id": "823585367388767", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499296157_823585370722100_7495270603048586221_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KX_UqX1YFEQQ7kNvwET0La9&_nc_oc=Adp8uwscRC_YWg9ydpUFmrFu8BHhy83x60kMmlwpfS6XtsqFw0bYDmgMOPhMp-qYMqc&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNKTTZU5E-9dmSWahWY_ONe4oVBYtYJmzoMrUv9ForxFQ&oe=6AE1EF89"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_horizontal_2560x1440.png", "id": "1547754876893374", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499294644_1547754880226707_5085309761634472123_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LZPFjhp9Z48Q7kNvwEt8174&_nc_oc=AdqEc8cSD_UvUjncQR4Ledl6zAh2oVYE0QkMg6tG1T34g6FEaauROfrw3qYewrIrEaU&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOPpEOzQZ3or8CmPf8pkdbbd8w1O8IYmMYQHAnJtd-yiA&oe=6AE212EE"}, "display_name": "Goal Rush Eleven", "keywords": ["soccer", "futbol", "futball", "sports"], "long_description": "Recuerda por un momento por qu\u00e9 te enamoraste de los videojuegos de f\u00fatbol. La emoci\u00f3n de la jugada perfecta. El gol en el \u00faltimo minuto. El pique con tu rival hasta el pitido final. GOAL RUSH ELEVEN nace para devolverte esa pasi\u00f3n \u2014 pero como nunca antes la hab\u00edas sentido: dentro de la cancha, en realidad virtual, viendo el partido con tus propios ojos y el estadio rugiendo a tu alrededor.\n\nEsto no es otro simulador de patear balones desde un punto fijo. Aqu\u00ed eres un jugador de verdad en el campo. Corres moviendo los brazos, giras a buscar el espacio, y cuando la pelota llega a tus pies, el gol depende de ti. Detr\u00e1s hay un motor de partido completo \u2014 con inteligencia artificial, t\u00e1cticas y f\u00edsicas reales \u2014 llevado por primera vez a la primera persona en Meta Quest. Sientes el partido, no lo observas.\n\nY cuando el juego se calienta, pasa lo que nunca te hab\u00edan dejado vivir en un videojuego de f\u00fatbol: si las faltas se acumulan, se arma la pelea campal. Sueltas los controles del bal\u00f3n y peleas con tus propios pu\u00f1os, tu equipo contra el otro, hasta que el \u00e1rbitro reparte tarjetas y el partido contin\u00faa. Es tan absurdo y divertido como suena, y no lo vas a encontrar en ning\u00fan otro lado.\n\nGOAL RUSH ELEVEN es f\u00fatbol con alma: estadios distintos, clima que cambia (lluvia, nieve, niebla o sol), d\u00eda y noche, la afici\u00f3n cantando porras reales, narraci\u00f3n que te pone la piel de gallina, y una econom\u00eda de Bal\u00f3n Coins con la que ganas jugando, apuestas antes de tus partidos y escalas en el ", "short_description": "Vive el f\u00fatbol desde dentro. No lo mires jugar: s\u00e9 t\u00fa quien lo juega, en primera persona.\n\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://claude.ai/code/artifact/bf8c15ff-7977-45f6-a8c6-abe12122a601", "developer_terms_of_service_url": null, "publisher_name": "Francisco  Manuel Mier y Teran Almazan", "support_website_url": null, "website_url": "https://claude.ai/code/artifact/bf8c15ff-7977-45f6-a8c6-abe12122a601", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": 
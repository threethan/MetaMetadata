://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499307433_1106824034679021_2208238346986365142_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=brG8Cefp0l8Q7kNvwFdx8ir&_nc_oc=AdphNvrlPEgCPct8fvHyVANq4XDeQKGrk0JPDlSqP_NMJHikncODWzB6G5QnVGp_iSc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTWd7ajqO2kc_o8a0XYuzu0XZrcEwMznrCGIz9qdS_Cug&oe=6AF5CAB5"}, {"file_name": "Screenshot_2880x1600_f911d.png", "id": "1060401919608115", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499307433_1060401922941448_7780354140265136177_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ouX_MiTNBeoQ7kNvwE_REef&_nc_oc=Adol_bhLOSHVytAu_1IRpqHEaS8j8qBMY28po535lIRLTaB0vaUEM27JwOXwy3SbKzc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSvzjBulww135Bd78NTWNdz-xCbGQ_ecJAN3mazgeiMJA&oe=6AF5D8AF"}, {"file_name": "Screenshot_2880x1600_c1505.png", "id": "1411945193356179", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499296119_1411945196689512_7734998725794814567_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8aQN7yoAlvsQ7kNvwHgSub_&_nc_oc=Adr1n6GLKuFH8nGVyPpvZwGhT6tkHIVqxx3SiaMdS6YLE7Gq5oB0PDmxAXiEe3NHaVo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS70WcNYBMOBgTATPcTMhv9zLE0QXUZDJ2k-3e7W2TObA&oe=6AF5ED74"}, {"file_name": "Screenshot_2880x1600_4c5b1.png", "id": "1068101905502534", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491819396_1068101908835867_3312216196419352187_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7r7Lo1k87dQQ7kNvwG-nqEW&_nc_oc=AdpLrDeuNmXk8-6451ST7UQv8d-7dOQKIGvxrKzBEOBLgOEV-Goj_GZaGrs733eWKZU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSFlbCpeCPhbGaB7JaSv8JbKLXghOQNIT-ZgFliYAEDFA&oe=6AF5F294"}, {"file_name": "Screenshot_2880x1600_4d288.png", "id": "1698872327430738", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499307315_1698872330764071_1141194021950334483_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cVmH9SgcA3oQ7kNvwFUomJn&_nc_oc=AdpMcMgQcg-LEobrB3AS9cPQe9cIYTAYS5BUC58kd1MqGEfnAVAhhldVrQiovG1qSZg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTY5opNre5Gmlh9ojXM4ncf9c8pRY3YTn9J84VN7CnaYw&oe=6AF5BF89"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Muvia Walking", "keywords": ["games", "rehab", "walking", "rehabilitation"], "long_description": "Muvia Walking turns rehabilitation into an empowering journey -blending VR, AI, and natural walking motion to restore mobility and rebuild confidence.\n\nMore than just a fitness tool, Muvia Walking offers a unique blend of gamified therapy and immersive exploration. Set in beautifully rendered virtual environments, users walk through diverse paths, improve gait and posture, and engage in full-body movements that stimulate both body and mind.\n\nDesigned for both clinical and at-home use, each walking session provides real-time feedback and motion tracking - enabling personalized progress for individuals in recovery, those managing chronic conditions, or anyone looking to stay active and mobile.\n\nWhether you're rehabilitating, training, or simply exploring, Muvia Walking brings purposeful movement  and real therapeutic outcomes right to your doorstep.", "short_description": "Experience the joy of walking while improving your mobility and balance. Muvia Walking blends immersive VR environments with therapeutic benefits and real-time feedback, making everyday movement more engaging and accessible - anytime, anywhere."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.muvia.ai/privacy", "developer_terms_of_service_url": "https://www.muvia.ai/terms", "publisher_name": "Muvia Inc. ", "support_website_url": null, "website_url": "https://www.muvia.ai/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "478089301798119"}], "external_subscription_type": "NOT_REQU
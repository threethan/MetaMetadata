://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/499307433_1106824034679021_2208238346986365142_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BOI3heREaE4Q7kNvwHJTUri&_nc_oc=Adob0kB8eKIrsNZpkLVdiGWr3ZXLv7PA63VR40QcYGDC-3jJNTWtp7Gd-O7j5h2FYkU&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAQNXYdohKBlMe9hsI4IOjYxgakT-N1RuP5Vm1CHGXe_Q&oe=6A53A235"}, {"file_name": "Screenshot_2880x1600_f911d.png", "id": "1060401919608115", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499307433_1060401922941448_7780354140265136177_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ga1WH62gsnkQ7kNvwEWz0on&_nc_oc=AdqyLYOlwkzbEkOYuGy4WN7dNzzowZ4nakuM7gpPpzePq2CVNbqYxNfQqFI4E46eOAI&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA4dRVraaDqA9WmZKoGB2ZAHp9Acs7rXv2lb-VuZ8lsbA&oe=6A53B02F"}, {"file_name": "Screenshot_2880x1600_c1505.png", "id": "1411945193356179", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/499296119_1411945196689512_7734998725794814567_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P1JuyR4dwUgQ7kNvwGiuJV3&_nc_oc=AdrhGPC9pLpU2mHSDgeh6CEdHRvab_zpsZOM9VJNQuPwolXKn2vvqcm04uHGKe70pPg&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDdNPkoz05nPw03a3vWeztzOI5DhekOlE57se1eYTFO2Q&oe=6A538CB4"}, {"file_name": "Screenshot_2880x1600_4c5b1.png", "id": "1068101905502534", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/491819396_1068101908835867_3312216196419352187_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1Iq3QkEVUqEQ7kNvwETW8A5&_nc_oc=AdoMjlZHjjFlFZrfvWzOW71ixPsyMU1n18hprHjEFkK3cvZYM0QEwn5g5_4Yd7mlCHg&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAmJ5lDMyvQmwE-hu5gqX48Mt0RwrLgCX10nRMdWXARvw&oe=6A5391D4"}, {"file_name": "Screenshot_2880x1600_4d288.png", "id": "1698872327430738", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499307315_1698872330764071_1141194021950334483_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WOefIph6UdMQ7kNvwHdDxkw&_nc_oc=Adqg0eSUHPhXSJoNE_NMYpNgJe8cQT_DZR87SbobwYzXdumAXbAivkZxz88bI4tKMi8&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCvdgjWXvz9TgtuqdcChQ46cRlB94B7WJ2DKzgdzGSlog&oe=6A539709"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Muvia Walking", "keywords": ["games", "rehab", "walking", "rehabilitation"], "long_description": "Muvia Walking turns rehabilitation into an empowering journey -blending VR, AI, and natural walking motion to restore mobility and rebuild confidence.\n\nMore than just a fitness tool, Muvia Walking offers a unique blend of gamified therapy and immersive exploration. Set in beautifully rendered virtual environments, users walk through diverse paths, improve gait and posture, and engage in full-body movements that stimulate both body and mind.\n\nDesigned for both clinical and at-home use, each walking session provides real-time feedback and motion tracking - enabling personalized progress for individuals in recovery, those managing chronic conditions, or anyone looking to stay active and mobile.\n\nWhether you're rehabilitating, training, or simply exploring, Muvia Walking brings purposeful movement  and real therapeutic outcomes right to your doorstep.", "short_description": "Experience the joy of walking while improving your mobility and balance. Muvia Walking blends immersive VR environments with therapeutic benefits and real-time feedback, making everyday movement more engaging and accessible - anytime, anywhere."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.muvia.ai/privacy", "developer_terms_of_service_url": "https://www.muvia.ai/terms", "publisher_name": "Muvia Inc. ", "support_website_url": null, "website_url": "https://www.muvia.ai/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "478089301798119"}], "external_subscription_type": "NOT_REQU
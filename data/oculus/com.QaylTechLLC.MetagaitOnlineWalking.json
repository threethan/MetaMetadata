2_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lW1R1zJMbUYQ7kNvwG8MFEZ&_nc_oc=AdmCrfc6-O_pu58wZF0g_oOgbACy-fmwa4LasJXr_uiunOra6WGqyPkr_5Qu5EjzB0E&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfubtXNbZM9wlLcWzQq-ccXOa8FTTUmkeJb6aCXEwE91ew&oe=6999BEB5"}, {"file_name": "Screenshot_2880x1600_f911d.png", "id": "1060401919608115", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499307433_1060401922941448_7780354140265136177_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nHhU-rKLdOUQ7kNvwFNTQom&_nc_oc=AdkU4e4jSVIL0tzpZD9H-_L7hbfanLiLnnXOEAQ4ZS6WvgprxJVi_9N4mzqc9qjQxbg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AftrpPhfNDXhOIVApwb2xqW4DqHSM2Rlrcy-uc_NNkTa5w&oe=6999946F"}, {"file_name": "Screenshot_2880x1600_c1505.png", "id": "1411945193356179", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499296119_1411945196689512_7734998725794814567_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HFnxQKoWZLQQ7kNvwE3MYhb&_nc_oc=AdmM1vtXEsV1s83cxV8jNXHdtDvEVd8_smyPwvmbQrPAdEjN4sIXFnYQ_W03BsJqAA4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Afs3RNm8kpNCPuIrdGJe_6FyCBiZaTLakPPud2MqJbv8Lw&oe=6999A934"}, {"file_name": "Screenshot_2880x1600_4c5b1.png", "id": "1068101905502534", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491819396_1068101908835867_3312216196419352187_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KB1zNk5OLT8Q7kNvwFDP8Uu&_nc_oc=AdlrpGetR9j6FMfO_RzN7jdzUIWyT573CpwqxCzCuDpfDSUCGvYZTGp8i_0Z7aQ-yeE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfuZ7YHRosWVXODuK0S1Yql50FsnSC7GJ0FQfjRO08ijGw&oe=6999AE54"}, {"file_name": "Screenshot_2880x1600_4d288.png", "id": "1698872327430738", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499307315_1698872330764071_1141194021950334483_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z60nfYzOx4AQ7kNvwEH5eby&_nc_oc=AdlXO_s4wzAQZsMy2oOjgRcdsiNaQmJX9xwW7p6y8zZmoxloqwuvmRybUXpGQRE1Dew&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfsF68KbHdY9TeIrQE49xIfoDvg9PZh9o7RQEPli854iLQ&oe=6999B389"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Muvia Walking", "keywords": ["games", "rehab", "walking", "rehabilitation"], "long_description": "Muvia Walking turns rehabilitation into an empowering journey -blending VR, AI, and natural walking motion to restore mobility and rebuild confidence.\n\nMore than just a fitness tool, Muvia Walking offers a unique blend of gamified therapy and immersive exploration. Set in beautifully rendered virtual environments, users walk through diverse paths, improve gait and posture, and engage in full-body movements that stimulate both body and mind.\n\nDesigned for both clinical and at-home use, each walking session provides real-time feedback and motion tracking - enabling personalized progress for individuals in recovery, those managing chronic conditions, or anyone looking to stay active and mobile.\n\nWhether you're rehabilitating, training, or simply exploring, Muvia Walking brings purposeful movement  and real therapeutic outcomes right to your doorstep.", "short_description": "Experience the joy of walking while improving your mobility and balance. Muvia Walking blends immersive VR environments with therapeutic benefits and real-time feedback, making everyday movement more engaging and accessible - anytime, anywhere."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.muvia.ai/privacy", "developer_terms_of_service_url": "https://www.muvia.ai/terms", "publisher_name": "Muvia Inc. ", "support_website_url": null, "website_url": "https://www.muvia.ai/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "478089301798119"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory
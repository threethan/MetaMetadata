://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/499307433_1106824034679021_2208238346986365142_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JIZ_GqFodN4Q7kNvwHB5VSa&_nc_oc=AdqGQQtUiD51WjhmV-TbcGDHJmSVklfblHmRW3iOhqAOArc0yNz0Z0L2FK7UvYFfVxg&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7AwKGQWG4ZBlQpNSti8p-gPLWr9OYfM0ArDQc42si8BQ&oe=6A15ABB5"}, {"file_name": "Screenshot_2880x1600_f911d.png", "id": "1060401919608115", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499307433_1060401922941448_7780354140265136177_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3oOlfym-No0Q7kNvwHCSrXG&_nc_oc=Adqm_CXctba81vbVgu-Kk6vNzRPJmp7Y9zEgB1WvYFEHGRGpKpFgSPc0GDRiNYwaeYo&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7KxtCxPPg0iHcZ3jneeRA3ROVs_jmqfNdhS9PMNWko3w&oe=6A15B9AF"}, {"file_name": "Screenshot_2880x1600_c1505.png", "id": "1411945193356179", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/499296119_1411945196689512_7734998725794814567_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IsfuKJwwVSwQ7kNvwHyBCfE&_nc_oc=AdrbAig67_9_cKxyDJqVk57MbZpCKzf7d1aXT5-hPP0CbLMramR33gkrrWF10T2aRtg&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af53TDy0E7GGfAqaKX3hggZ05LnX47WNmYOwP9T0lObrjw&oe=6A159634"}, {"file_name": "Screenshot_2880x1600_4c5b1.png", "id": "1068101905502534", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/491819396_1068101908835867_3312216196419352187_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WDcYmJ7zGyEQ7kNvwELPXjO&_nc_oc=AdrArVhWJIEo1k3UcMzcvgrepQCN5bIr9L_zL-26Xh7roGMzO9mziJyTjoPpp87Oz14&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6tP9Gwe_uumR9dMeYTLo4a-w-ckVPOhiwCgJ8O_PIGLg&oe=6A159B54"}, {"file_name": "Screenshot_2880x1600_4d288.png", "id": "1698872327430738", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499307315_1698872330764071_1141194021950334483_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qFvkN6yFTaMQ7kNvwHCruWi&_nc_oc=AdqO09bV-7ZAeaCOEem3NBWgdBvkTBPk52Y9itC6RRUismetxUOYYV2Pli5-1SdyhJ0&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4cRWyYgHx4jjbMnMb-_6AOXu1saBYIRWTZmGx_fSM5YA&oe=6A15A089"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Muvia Walking", "keywords": ["games", "rehab", "walking", "rehabilitation"], "long_description": "Muvia Walking turns rehabilitation into an empowering journey -blending VR, AI, and natural walking motion to restore mobility and rebuild confidence.\n\nMore than just a fitness tool, Muvia Walking offers a unique blend of gamified therapy and immersive exploration. Set in beautifully rendered virtual environments, users walk through diverse paths, improve gait and posture, and engage in full-body movements that stimulate both body and mind.\n\nDesigned for both clinical and at-home use, each walking session provides real-time feedback and motion tracking - enabling personalized progress for individuals in recovery, those managing chronic conditions, or anyone looking to stay active and mobile.\n\nWhether you're rehabilitating, training, or simply exploring, Muvia Walking brings purposeful movement  and real therapeutic outcomes right to your doorstep.", "short_description": "Experience the joy of walking while improving your mobility and balance. Muvia Walking blends immersive VR environments with therapeutic benefits and real-time feedback, making everyday movement more engaging and accessible - anytime, anywhere."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.muvia.ai/privacy", "developer_terms_of_service_url": "https://www.muvia.ai/terms", "publisher_name": "Muvia Inc. ", "support_website_url": null, "website_url": "https://www.muvia.ai/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "478089301798119"}], "external_subscription_type": "NOT_REQU
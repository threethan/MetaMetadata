://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499307433_1106824034679021_2208238346986365142_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Pp31V6FnydQQ7kNvwGDUxaU&_nc_oc=AdplhR_UVpsKsNlr-c3c4ijnBPem3VCcGali0HnWcYy2n5Vrq5gQPTz5n_qZUKsraWw&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR6ye3spnvFdnbHAc9xP2wuzBwq5YhmPHXw6HKBV2fCrA&oe=6AF327B5"}, {"file_name": "Screenshot_2880x1600_f911d.png", "id": "1060401919608115", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499307433_1060401922941448_7780354140265136177_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HmtEmjSU7M0Q7kNvwFcVTnf&_nc_oc=AdqJoUfCR-y2jlvcf_pRIUKty8ILBLb-4t9o3IlvhjP4hOJvt1ywmkvBoQzUMXGMld4&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSwoK2hoQ3g7cAtnpXVSHUDqMwVygcMGhXH3YKiiBDxDg&oe=6AF335AF"}, {"file_name": "Screenshot_2880x1600_c1505.png", "id": "1411945193356179", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499296119_1411945196689512_7734998725794814567_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=01ZroVWvzKwQ7kNvwEYirpc&_nc_oc=Adpi8-L18Qmihcrf5wkdblq-RABbbWEV2CjAKt_ymAOYEf_WwtD1i-Kcycv8uP8JYnI&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTPSSxy-KySzEPMXFBv1Htf_C8GsaZx5SP5kI4Yg6leKQ&oe=6AF34A74"}, {"file_name": "Screenshot_2880x1600_4c5b1.png", "id": "1068101905502534", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491819396_1068101908835867_3312216196419352187_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bKMyxkLW2MkQ7kNvwHRpXRs&_nc_oc=Adr3Ye0YsyR7M9aE8MSjZdAwEMCnxW6HIdOAbZm8qOrhIUPE2qkARpIU_WXZ21pqOLQ&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS8xaDUpqrC6Xi2BOE_Xy6jgiWakyJcDc6uG1uX_V9yEA&oe=6AF34F94"}, {"file_name": "Screenshot_2880x1600_4d288.png", "id": "1698872327430738", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499307315_1698872330764071_1141194021950334483_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cVmH9SgcA3oQ7kNvwHPLE-Z&_nc_oc=Adr_Y037WeK-3VDg1MvtsLDOl7qj5oEh3ZGlF4euYFuHhJL8DRJmdelrp9Di7xn-I1g&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSzRjPQuy55yg7YhoFQt-BweU1UNSG0-WL8osuTIekBMg&oe=6AF354C9"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Muvia Walking", "keywords": ["games", "rehab", "walking", "rehabilitation"], "long_description": "Muvia Walking turns rehabilitation into an empowering journey -blending VR, AI, and natural walking motion to restore mobility and rebuild confidence.\n\nMore than just a fitness tool, Muvia Walking offers a unique blend of gamified therapy and immersive exploration. Set in beautifully rendered virtual environments, users walk through diverse paths, improve gait and posture, and engage in full-body movements that stimulate both body and mind.\n\nDesigned for both clinical and at-home use, each walking session provides real-time feedback and motion tracking - enabling personalized progress for individuals in recovery, those managing chronic conditions, or anyone looking to stay active and mobile.\n\nWhether you're rehabilitating, training, or simply exploring, Muvia Walking brings purposeful movement  and real therapeutic outcomes right to your doorstep.", "short_description": "Experience the joy of walking while improving your mobility and balance. Muvia Walking blends immersive VR environments with therapeutic benefits and real-time feedback, making everyday movement more engaging and accessible - anytime, anywhere."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.muvia.ai/privacy", "developer_terms_of_service_url": "https://www.muvia.ai/terms", "publisher_name": "Muvia Inc. ", "support_website_url": null, "website_url": "https://www.muvia.ai/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "478089301798119"}], "external_subscription_type": "NOT_REQU
://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499307433_1106824034679021_2208238346986365142_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vp7Ebhj6_SIQ7kNvwGk32eG&_nc_oc=Adp-ZZ9nMMhPA6QX-gcde9KQdJniD8OA5tFWW1Af6NXrEYobNRjme4IiQCGwHTiBWv4&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyC49s1NZWLsknXvbnAx48_jQHBVxwH6uJRASBJc326Rg&oe=69CBD7B5"}, {"file_name": "Screenshot_2880x1600_f911d.png", "id": "1060401919608115", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499307433_1060401922941448_7780354140265136177_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_XQqide2GuIQ7kNvwHtw9J7&_nc_oc=AdqvxURCCFXtk0PB56qdzC3aRytBOZnlb_zwwZZaiT4eX_JVkq_vE4bmF4I0Zxqxx7Y&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afw2RgmfBh3GMGlDWS94u3qSHwUEjptcg394iTphsURTmA&oe=69CBAD6F"}, {"file_name": "Screenshot_2880x1600_c1505.png", "id": "1411945193356179", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499296119_1411945196689512_7734998725794814567_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WtBVoNVNC7EQ7kNvwF2Hr1c&_nc_oc=AdpisrIcfkLJ4UQbCs4FyWIH50ob8NwUXL2hkZ5n4jOPqdMdNWy0aPm2I6CN-X8INDM&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afw4EjMdBmLwqFl0OnpVwhKM4FzXYQSpJThCfSWT92oL5g&oe=69CBC234"}, {"file_name": "Screenshot_2880x1600_4c5b1.png", "id": "1068101905502534", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/491819396_1068101908835867_3312216196419352187_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v1An_7iLjOoQ7kNvwEEGmTF&_nc_oc=AdpljFUvI9aZr0KmEn68Uqh4iQek6-5_GmaWh-v0Ym6NDnCXWSv-jRGYbBwGcCyXT4g&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxSGviPsftrYKGMbEkLYY38iZ8YpiGpr9vYI1cGVod2TQ&oe=69CBC754"}, {"file_name": "Screenshot_2880x1600_4d288.png", "id": "1698872327430738", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499307315_1698872330764071_1141194021950334483_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ozi5_SkdqMgQ7kNvwHFX-Ih&_nc_oc=Adrut7guNRy6m0hkjwcp1yfHNmT0bNPySOAUOXHzBgff8LQeo7oR6KzT3I_A9kf97N0&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxRXrmQq5lom9V-a4FLUouFsCqk_n5mtDKjm6dag8KBbQ&oe=69CBCC89"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Muvia Walking", "keywords": ["games", "rehab", "walking", "rehabilitation"], "long_description": "Muvia Walking turns rehabilitation into an empowering journey -blending VR, AI, and natural walking motion to restore mobility and rebuild confidence.\n\nMore than just a fitness tool, Muvia Walking offers a unique blend of gamified therapy and immersive exploration. Set in beautifully rendered virtual environments, users walk through diverse paths, improve gait and posture, and engage in full-body movements that stimulate both body and mind.\n\nDesigned for both clinical and at-home use, each walking session provides real-time feedback and motion tracking - enabling personalized progress for individuals in recovery, those managing chronic conditions, or anyone looking to stay active and mobile.\n\nWhether you're rehabilitating, training, or simply exploring, Muvia Walking brings purposeful movement  and real therapeutic outcomes right to your doorstep.", "short_description": "Experience the joy of walking while improving your mobility and balance. Muvia Walking blends immersive VR environments with therapeutic benefits and real-time feedback, making everyday movement more engaging and accessible - anytime, anywhere."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.muvia.ai/privacy", "developer_terms_of_service_url": "https://www.muvia.ai/terms", "publisher_name": "Muvia Inc. ", "support_website_url": null, "website_url": "https://www.muvia.ai/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "478089301798119"}], "external_subscription_type": "NOT_REQU
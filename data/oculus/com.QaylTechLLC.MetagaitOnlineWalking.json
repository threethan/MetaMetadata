://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499307433_1106824034679021_2208238346986365142_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Rpe8we1k3NIQ7kNvwHhafMd&_nc_oc=AdrdluG7wys71xnFJv3fb0j9atwqjynQLVC3jsoYSnds56b-97hBT4lm6Ckg1RULSJ4&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHgZqGpUf_VqimIZBerEXEqoz3i-wMi37IvSmIV3V67OA&oe=6A897775"}, {"file_name": "Screenshot_2880x1600_f911d.png", "id": "1060401919608115", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499307433_1060401922941448_7780354140265136177_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YyBwYC2pN0MQ7kNvwH-YAqI&_nc_oc=AdpgR21lyFoiG0ZTDZliNY2k2MwnbHfWbuGCoRshliaNKbcSnlsqDZzGTok6RbkmrnQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEtDG96iqlqEg2T0HYxqcO5JDbIuyKl11iUDWGESOnzhA&oe=6A89856F"}, {"file_name": "Screenshot_2880x1600_c1505.png", "id": "1411945193356179", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499296119_1411945196689512_7734998725794814567_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yIJloLcwawcQ7kNvwHH9-Mr&_nc_oc=AdoKyXNzCTQevykzLSrLEhIMyK4fmgC4uAAwgEWQcgSnqnwvw9YX9SSx77kIgmpNb9g&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF5X3gPsN0XDCVk8dHRKJxGvicfMhkTJc1RGizTVEvJ1w&oe=6A899A34"}, {"file_name": "Screenshot_2880x1600_4c5b1.png", "id": "1068101905502534", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491819396_1068101908835867_3312216196419352187_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=52rY43QRQtYQ7kNvwFh8oTr&_nc_oc=Adq22SnAzItrNM2S_B_y2C91d04eCg6M1lUbEGG7Iop2S-SQuPJEoiiIvg3eM4kCcpQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGxMchAZlOZ3LZXEGXPAA-_meDgIzzL6uTLIjV0YrxPSw&oe=6A899F54"}, {"file_name": "Screenshot_2880x1600_4d288.png", "id": "1698872327430738", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499307315_1698872330764071_1141194021950334483_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XwwAPUcaPDQQ7kNvwGs6Gb1&_nc_oc=AdpYB1WZcmV4bChqJiazTOrxjcsUAspMzzMpJdrpJVA1-3Nig1CILegUAFyojgfJ12A&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHHDesBCpZIpDH523OJaxpDp_msG2_Le17AbcTzJoA3pA&oe=6A89A489"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Muvia Walking", "keywords": ["games", "rehab", "walking", "rehabilitation"], "long_description": "Muvia Walking turns rehabilitation into an empowering journey -blending VR, AI, and natural walking motion to restore mobility and rebuild confidence.\n\nMore than just a fitness tool, Muvia Walking offers a unique blend of gamified therapy and immersive exploration. Set in beautifully rendered virtual environments, users walk through diverse paths, improve gait and posture, and engage in full-body movements that stimulate both body and mind.\n\nDesigned for both clinical and at-home use, each walking session provides real-time feedback and motion tracking - enabling personalized progress for individuals in recovery, those managing chronic conditions, or anyone looking to stay active and mobile.\n\nWhether you're rehabilitating, training, or simply exploring, Muvia Walking brings purposeful movement  and real therapeutic outcomes right to your doorstep.", "short_description": "Experience the joy of walking while improving your mobility and balance. Muvia Walking blends immersive VR environments with therapeutic benefits and real-time feedback, making everyday movement more engaging and accessible - anytime, anywhere."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.muvia.ai/privacy", "developer_terms_of_service_url": "https://www.muvia.ai/terms", "publisher_name": "Muvia Inc. ", "support_website_url": null, "website_url": "https://www.muvia.ai/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "478089301798119"}], "external_subscription_type": "NOT_REQU
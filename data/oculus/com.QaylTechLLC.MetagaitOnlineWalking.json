://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499307433_1106824034679021_2208238346986365142_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FjUgi25-JKIQ7kNvwGd3Z3f&_nc_oc=AdrlkOr8rzA6ABfCvi15GRnUNA3giWGigIQzZLpmlH_rwH3kwJuzq8CC0Mjt12RK7Ck&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2WEdHYhFu4yn1aIbGrTx8wsLsfKIvpKxlfu7sJfwWW2g&oe=69DF9E35"}, {"file_name": "Screenshot_2880x1600_f911d.png", "id": "1060401919608115", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499307433_1060401922941448_7780354140265136177_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MsEUKup5E4oQ7kNvwFIUVjC&_nc_oc=AdrlcYLaH-8NOZZdfOtL-Wo4sm7XJk7YSBCM_f6erf1upybon2uC_vVzhMhQzyrntbk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1gpqKsGEl0fpMoGy5yjpKJQokQEVsOC4tGEGgjZqRbxA&oe=69DF73EF"}, {"file_name": "Screenshot_2880x1600_c1505.png", "id": "1411945193356179", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499296119_1411945196689512_7734998725794814567_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GAe7VIuFeNQQ7kNvwEbprfb&_nc_oc=Adra8ob_yOeV_axvDKygJNnNZdlEexXVQhrESOFmN_exSDl_PdTzP8EktRNwB75Apbo&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1A9BHnoGcMjt0OLTTPehwD1IpwbzWk4GwfgXo1ta3sMQ&oe=69DF88B4"}, {"file_name": "Screenshot_2880x1600_4c5b1.png", "id": "1068101905502534", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491819396_1068101908835867_3312216196419352187_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Gg_OVjeOvrQQ7kNvwHr0hYd&_nc_oc=AdrK-8LJ0H1JNU7hnJAuoV8yd_d_l2LhPGiPp_blBIkoB3NWvluy7eSI1zgiAfA2Kp8&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0PHXIjfEcuqhA_mECCdPJrbWEBmtgMs7hePnZtOEyEGA&oe=69DF8DD4"}, {"file_name": "Screenshot_2880x1600_4d288.png", "id": "1698872327430738", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499307315_1698872330764071_1141194021950334483_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qko8ZwWPZ1AQ7kNvwEjQi9Z&_nc_oc=AdoTM8BOfL5_p15ocM-MLl9VXc6dD6cD1lnC3NX1lYGg1f73q-NePpp5SNVmJFY8FQA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2wU_qF_JJ3LZu9NPt-tyt8KfuDSlCAA1jfPgD6SfOZZg&oe=69DF9309"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Muvia Walking", "keywords": ["games", "rehab", "walking", "rehabilitation"], "long_description": "Muvia Walking turns rehabilitation into an empowering journey -blending VR, AI, and natural walking motion to restore mobility and rebuild confidence.\n\nMore than just a fitness tool, Muvia Walking offers a unique blend of gamified therapy and immersive exploration. Set in beautifully rendered virtual environments, users walk through diverse paths, improve gait and posture, and engage in full-body movements that stimulate both body and mind.\n\nDesigned for both clinical and at-home use, each walking session provides real-time feedback and motion tracking - enabling personalized progress for individuals in recovery, those managing chronic conditions, or anyone looking to stay active and mobile.\n\nWhether you're rehabilitating, training, or simply exploring, Muvia Walking brings purposeful movement  and real therapeutic outcomes right to your doorstep.", "short_description": "Experience the joy of walking while improving your mobility and balance. Muvia Walking blends immersive VR environments with therapeutic benefits and real-time feedback, making everyday movement more engaging and accessible - anytime, anywhere."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.muvia.ai/privacy", "developer_terms_of_service_url": "https://www.muvia.ai/terms", "publisher_name": "Muvia Inc. ", "support_website_url": null, "website_url": "https://www.muvia.ai/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "478089301798119"}], "external_subscription_type": "NOT_REQU
://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499307433_1106824034679021_2208238346986365142_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tD4Uq-FUrJkQ7kNvwGXIdE4&_nc_oc=AdpX9LbPB1Z55YD5grTNFOWlKpiN5jgzrYGU1Sxy9JiUMH_j7GH_zv7gH2d0VXNQnEI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIoFEQD_sAQaclUH7q1GA5wK2gXSanGCGI-86KpsnhSOg&oe=6AAAA535"}, {"file_name": "Screenshot_2880x1600_f911d.png", "id": "1060401919608115", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499307433_1060401922941448_7780354140265136177_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j1rKgo_YqwYQ7kNvwGLrOPI&_nc_oc=Adr_cBFETdfamorV5M5C-WRKDtWyC8LEfX7TwhQa63j6qj6oLz7iokuqDGGkKUgtyvc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJZq4ndJxKhryVOY8us58kfZJt5HdLWwEr0giJmf1oXeQ&oe=6AAAB32F"}, {"file_name": "Screenshot_2880x1600_c1505.png", "id": "1411945193356179", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499296119_1411945196689512_7734998725794814567_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sCIUGiGs2R0Q7kNvwFpJDl6&_nc_oc=AdqY9ix74XmPwfVIUv_0III3CFPz0RY2mu3dGtdgU5XPqSxp5rAjyqPBL99ehZl5owU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIPDU-BqpZZ5dcNpZGPXC_88fOCKouuoUPg64U5OaT7mg&oe=6AAA8FB4"}, {"file_name": "Screenshot_2880x1600_4c5b1.png", "id": "1068101905502534", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491819396_1068101908835867_3312216196419352187_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BbBg-Ihy77wQ7kNvwGCai1B&_nc_oc=Ado3eOKUPRr_2BQb_Osp8NDibKqQpm6bz23BU09HgHwzRq_fq8dU5zg0AIgEGHmttEI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK0jRVOkUg-7CuFMVidSMYhqAJJo42p5K5gD7Whj3eMOw&oe=6AAA94D4"}, {"file_name": "Screenshot_2880x1600_4d288.png", "id": "1698872327430738", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499307315_1698872330764071_1141194021950334483_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h3h5zYbnQb4Q7kNvwGYmEoq&_nc_oc=AdoQATYu0AH3PX4fRbnX5CdPf06wuGDBs9BoKRgBOBVzOOa1uYGMyEfGza2CuqIClHU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJCxo2SxBqEeZo6leT1VdHfqmvHXIIdZokJolNCFJLayg&oe=6AAA9A09"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Muvia Walking", "keywords": ["games", "rehab", "walking", "rehabilitation"], "long_description": "Muvia Walking turns rehabilitation into an empowering journey -blending VR, AI, and natural walking motion to restore mobility and rebuild confidence.\n\nMore than just a fitness tool, Muvia Walking offers a unique blend of gamified therapy and immersive exploration. Set in beautifully rendered virtual environments, users walk through diverse paths, improve gait and posture, and engage in full-body movements that stimulate both body and mind.\n\nDesigned for both clinical and at-home use, each walking session provides real-time feedback and motion tracking - enabling personalized progress for individuals in recovery, those managing chronic conditions, or anyone looking to stay active and mobile.\n\nWhether you're rehabilitating, training, or simply exploring, Muvia Walking brings purposeful movement  and real therapeutic outcomes right to your doorstep.", "short_description": "Experience the joy of walking while improving your mobility and balance. Muvia Walking blends immersive VR environments with therapeutic benefits and real-time feedback, making everyday movement more engaging and accessible - anytime, anywhere."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.muvia.ai/privacy", "developer_terms_of_service_url": "https://www.muvia.ai/terms", "publisher_name": "Muvia Inc. ", "support_website_url": null, "website_url": "https://www.muvia.ai/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "478089301798119"}], "external_subscription_type": "NOT_REQU
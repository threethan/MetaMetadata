://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499307433_1106824034679021_2208238346986365142_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kLllcn4Qb3sQ7kNvwH5tzZb&_nc_oc=AdpHY_gg01LwQYYAZ2XA-kgpDeIVpFmr_9ET4IDemMBjIQFR8Qyoh1nOxNAsumMOhBM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxyVWChJhVfEDxkwKssYAJHIs90G_wh2BdFT1Hth5EfUQ&oe=69CD2935"}, {"file_name": "Screenshot_2880x1600_f911d.png", "id": "1060401919608115", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499307433_1060401922941448_7780354140265136177_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jO28ouIJAOkQ7kNvwHVe6OQ&_nc_oc=AdoHRX9WSnfndvYY-A8uv0Sua1JLTPXEYseBueqrUMPtFG-c5QG74nZuh3_0nij21_Y&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afx8jTmSkhuLT7z8ypkpi6jWw43XjdkecJ8IlGZrkzg5FA&oe=69CCFEEF"}, {"file_name": "Screenshot_2880x1600_c1505.png", "id": "1411945193356179", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499296119_1411945196689512_7734998725794814567_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WtBVoNVNC7EQ7kNvwHXHCNy&_nc_oc=Adqj6WUXq2Cut_VYGsvPyN7E2wXr1bK87JcThhqYyp2hJ_8NanUCob6XieytuqfZIfE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afxwb-Ak99ls1lX7ThHyjE-dgVqVwTo41jy5R6wAZqZQBQ&oe=69CD13B4"}, {"file_name": "Screenshot_2880x1600_4c5b1.png", "id": "1068101905502534", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491819396_1068101908835867_3312216196419352187_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FfVeQbh_vNoQ7kNvwF0lG-T&_nc_oc=Adr1IgXaZodeYUFSm2NPeQWAZZbsMPnQs0HOU940PaWQbK3sOnCdTSqPPOPtyX7ZMI4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzU5Pequ5rbDVB5YWNRl7qxjaAQ40AWwyrEzrmxLGyoQQ&oe=69CD18D4"}, {"file_name": "Screenshot_2880x1600_4d288.png", "id": "1698872327430738", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499307315_1698872330764071_1141194021950334483_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ozi5_SkdqMgQ7kNvwGNVo6u&_nc_oc=Adp2kzO_bmcY4LmYfv7fdyWDk7nadsNUSZeuEgHykK-8Sx9Wy6KaCImb5HJ-HebRSZg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzlLk5RuMF4HG7C4HqGzS5IJuezl7HWCcOozTmg6R-Dgw&oe=69CD1E09"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Muvia Walking", "keywords": ["games", "rehab", "walking", "rehabilitation"], "long_description": "Muvia Walking turns rehabilitation into an empowering journey -blending VR, AI, and natural walking motion to restore mobility and rebuild confidence.\n\nMore than just a fitness tool, Muvia Walking offers a unique blend of gamified therapy and immersive exploration. Set in beautifully rendered virtual environments, users walk through diverse paths, improve gait and posture, and engage in full-body movements that stimulate both body and mind.\n\nDesigned for both clinical and at-home use, each walking session provides real-time feedback and motion tracking - enabling personalized progress for individuals in recovery, those managing chronic conditions, or anyone looking to stay active and mobile.\n\nWhether you're rehabilitating, training, or simply exploring, Muvia Walking brings purposeful movement  and real therapeutic outcomes right to your doorstep.", "short_description": "Experience the joy of walking while improving your mobility and balance. Muvia Walking blends immersive VR environments with therapeutic benefits and real-time feedback, making everyday movement more engaging and accessible - anytime, anywhere."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.muvia.ai/privacy", "developer_terms_of_service_url": "https://www.muvia.ai/terms", "publisher_name": "Muvia Inc. ", "support_website_url": null, "website_url": "https://www.muvia.ai/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "478089301798119"}], "external_subscription_type": "NOT_REQU
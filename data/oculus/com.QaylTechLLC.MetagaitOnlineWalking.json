://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/499307433_1106824034679021_2208238346986365142_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jd3kecqqpC0Q7kNvwFab-pS&_nc_oc=AdphytnnBXaYb08JzdPVIs9Xi12hLmCwL_VJ64e-m_gDbChoaI3UPts81pPF9kknOKI&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQELV6ifMCATQIXSkESKD06UkE9BechA7Ai-f27-0KRINg&oe=6A900EF5"}, {"file_name": "Screenshot_2880x1600_f911d.png", "id": "1060401919608115", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499307433_1060401922941448_7780354140265136177_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Rw8fgsake5kQ7kNvwGBcn28&_nc_oc=AdoUly_UBGSKLBrWdS5raqwQAcSbcdvi5xVp45YYaWiEzeyTwXDH3Q55FxQ9q2IFZ-s&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHSspdRPewYGRYb9BlZGZRigNkzIbSoCO_2TFkt3PnQbQ&oe=6A901CEF"}, {"file_name": "Screenshot_2880x1600_c1505.png", "id": "1411945193356179", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/499296119_1411945196689512_7734998725794814567_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TuUkNAOTjJ0Q7kNvwGCZLnH&_nc_oc=AdrnbDnGkJNtJfn3aYMuzAj_-2p_LzOdx6IK8SryNZV8KzsNj3adkrtoQVrmyKo-46I&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHqITPfdjG-Ie_p_XQxbvp2JZ96gllLfRNy5t0SwD6dVw&oe=6A9031B4"}, {"file_name": "Screenshot_2880x1600_4c5b1.png", "id": "1068101905502534", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/491819396_1068101908835867_3312216196419352187_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4M2OWlNiSwEQ7kNvwELe8uL&_nc_oc=AdoVL7fWNwDUOpnMp5UDhbmXbML4uij_wkJ7uxBmz8VWFPdmHSKgsC0L1gEi41sDurY&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHgBPAmUPIC_eMuSgOcgTTKrRzO-b_yvekCO5SjrjaTFw&oe=6A9036D4"}, {"file_name": "Screenshot_2880x1600_4d288.png", "id": "1698872327430738", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499307315_1698872330764071_1141194021950334483_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z91UJ_FvZaIQ7kNvwH4CVwJ&_nc_oc=AdqwqB8gAtYAhaOO-axAjQbnfNMLBPqUcH0Bn7qSXXxlI_lrKbCl-tjnbEcAPStXio0&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGbivh-3z7h6OC7QJ7JORKIi5oIXUX_kGVaAPsE6BgITg&oe=6A903C09"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Muvia Walking", "keywords": ["games", "rehab", "walking", "rehabilitation"], "long_description": "Muvia Walking turns rehabilitation into an empowering journey -blending VR, AI, and natural walking motion to restore mobility and rebuild confidence.\n\nMore than just a fitness tool, Muvia Walking offers a unique blend of gamified therapy and immersive exploration. Set in beautifully rendered virtual environments, users walk through diverse paths, improve gait and posture, and engage in full-body movements that stimulate both body and mind.\n\nDesigned for both clinical and at-home use, each walking session provides real-time feedback and motion tracking - enabling personalized progress for individuals in recovery, those managing chronic conditions, or anyone looking to stay active and mobile.\n\nWhether you're rehabilitating, training, or simply exploring, Muvia Walking brings purposeful movement  and real therapeutic outcomes right to your doorstep.", "short_description": "Experience the joy of walking while improving your mobility and balance. Muvia Walking blends immersive VR environments with therapeutic benefits and real-time feedback, making everyday movement more engaging and accessible - anytime, anywhere."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.muvia.ai/privacy", "developer_terms_of_service_url": "https://www.muvia.ai/terms", "publisher_name": "Muvia Inc. ", "support_website_url": null, "website_url": "https://www.muvia.ai/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "478089301798119"}], "external_subscription_type": "NOT_REQU
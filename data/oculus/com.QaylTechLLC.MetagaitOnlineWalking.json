://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499307433_1106824034679021_2208238346986365142_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2LhPaOvELIoQ7kNvwH6z_0u&_nc_oc=AdqAbtJR2mKKyWOkslfZcwXLOZM6Y1kI5K7quW63X5fbSC3pldej7Eoyp0sanTPago8&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2CCE35IhxrrSo3wrNB0GI_ExV0OFog-zdlWMRHEoD7mw&oe=69EA2A35"}, {"file_name": "Screenshot_2880x1600_f911d.png", "id": "1060401919608115", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499307433_1060401922941448_7780354140265136177_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3Oq-jRHPmFEQ7kNvwGrkHvg&_nc_oc=AdoKJzB0IuQwEAHrT4Dul9jnhONflfwLZcNXodRjwTCeAWMDMlaTc3jYuytLxJX2QL4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0gqJrb1GLSe3KX2g6w9-DFGVdwP8k6vcWYJquDP57g-g&oe=69EA382F"}, {"file_name": "Screenshot_2880x1600_c1505.png", "id": "1411945193356179", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499296119_1411945196689512_7734998725794814567_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fZ_ZQ3SQPfYQ7kNvwEz9wKE&_nc_oc=AdpNyDhzLT1lOEeYBrmSPnnoWSMDIAZL2sC_BBNK7dkt6VVdC5Wp8GE8QRW589QCgIQ&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3oP4LrZja5AqfMTNJGxM7aV7ZYLeRLfHAc3AWWVSkNLQ&oe=69EA14B4"}, {"file_name": "Screenshot_2880x1600_4c5b1.png", "id": "1068101905502534", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491819396_1068101908835867_3312216196419352187_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cYcfljGY1yEQ7kNvwFYJmNM&_nc_oc=AdotEb9hcr2CG9_R0OfEO9jV0SxTT592QGEmon6kKXIyeukHdxA3MEoa-iYazDF78AU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af03FJpV6TVx_1YSil80BKFpo6xYCiPReXlRM-OV3SkIgQ&oe=69EA19D4"}, {"file_name": "Screenshot_2880x1600_4d288.png", "id": "1698872327430738", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499307315_1698872330764071_1141194021950334483_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nhqJBSN180UQ7kNvwEJeet0&_nc_oc=AdopLwn7xvmdwDU1xSFx1Wxe2TOsaqvhLqnlK_7PrVcim-8RmEtI9bOFUdnzqm76hqw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2tHaTuL6wzSVyzHvBRAsVzdG8oePvfTjrAuQsAf6W75w&oe=69EA1F09"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Muvia Walking", "keywords": ["games", "rehab", "walking", "rehabilitation"], "long_description": "Muvia Walking turns rehabilitation into an empowering journey -blending VR, AI, and natural walking motion to restore mobility and rebuild confidence.\n\nMore than just a fitness tool, Muvia Walking offers a unique blend of gamified therapy and immersive exploration. Set in beautifully rendered virtual environments, users walk through diverse paths, improve gait and posture, and engage in full-body movements that stimulate both body and mind.\n\nDesigned for both clinical and at-home use, each walking session provides real-time feedback and motion tracking - enabling personalized progress for individuals in recovery, those managing chronic conditions, or anyone looking to stay active and mobile.\n\nWhether you're rehabilitating, training, or simply exploring, Muvia Walking brings purposeful movement  and real therapeutic outcomes right to your doorstep.", "short_description": "Experience the joy of walking while improving your mobility and balance. Muvia Walking blends immersive VR environments with therapeutic benefits and real-time feedback, making everyday movement more engaging and accessible - anytime, anywhere."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.muvia.ai/privacy", "developer_terms_of_service_url": "https://www.muvia.ai/terms", "publisher_name": "Muvia Inc. ", "support_website_url": null, "website_url": "https://www.muvia.ai/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "478089301798119"}], "external_subscription_type": "NOT_REQU
://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499307433_1106824034679021_2208238346986365142_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j5rPPn0HJ0EQ7kNvwE3Wrop&_nc_oc=AdohlPpdz_0hxmCkW4B522xfKnggSSx7-urjZEY9GBeuCxuapu2UtfKRrNcSHfK7F6M&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCxPuOaeVRDNT1DRw1YLkyV_Shxrz5OW_ftSrKI7gj78A&oe=6A5F7FB5"}, {"file_name": "Screenshot_2880x1600_f911d.png", "id": "1060401919608115", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499307433_1060401922941448_7780354140265136177_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mrAZD-6dfkAQ7kNvwGhjXhA&_nc_oc=Ado-NyTY8JzK5S9nz_fkbWIurxuacX0i8yeogqrc-HqASXoL8NYzV5q8qv4Z3AFB13s&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCEl03CmA3yLXpW7d2iooxObrAVgA539Camkr5kmuunXg&oe=6A5F8DAF"}, {"file_name": "Screenshot_2880x1600_c1505.png", "id": "1411945193356179", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499296119_1411945196689512_7734998725794814567_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TvxYVHG6InQQ7kNvwGieziG&_nc_oc=Adq4AaVULVAIcg7ybjFcOgFklaOcSowU2RiUeZs9qcksbI65s3WOwmK067Q9gX9LUEo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDYeaJTm9PgxykqdGjoBgMPZFlCC_TRD3A2UkYsw6L4VA&oe=6A5F6A34"}, {"file_name": "Screenshot_2880x1600_4c5b1.png", "id": "1068101905502534", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491819396_1068101908835867_3312216196419352187_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MiZNTgUh_aEQ7kNvwFpeEiS&_nc_oc=AdrbohmQpBN1y4dNKWBwvIFYIDaT7OpV0dFbN3i5TyJlBE9XSojCF8xxsP7ROv1lUbI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAKkhHEMqfWN-6tpKS0a2RkdOjWCTXpBONNJSjqm-1tmw&oe=6A5F6F54"}, {"file_name": "Screenshot_2880x1600_4d288.png", "id": "1698872327430738", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499307315_1698872330764071_1141194021950334483_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mOvV6EERCMYQ7kNvwHlj8ZY&_nc_oc=AdpOMVlW12vVSFZOf4qb1zfRAh1G0kydtPmX63aaWPUKDAl5Mi4NWCPFGAiptRQzQPA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAssbpI-FkhjWNBUKMfIdk6SFkgkR1awCOZWI6W_fPRfg&oe=6A5F7489"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Muvia Walking", "keywords": ["games", "rehab", "walking", "rehabilitation"], "long_description": "Muvia Walking turns rehabilitation into an empowering journey -blending VR, AI, and natural walking motion to restore mobility and rebuild confidence.\n\nMore than just a fitness tool, Muvia Walking offers a unique blend of gamified therapy and immersive exploration. Set in beautifully rendered virtual environments, users walk through diverse paths, improve gait and posture, and engage in full-body movements that stimulate both body and mind.\n\nDesigned for both clinical and at-home use, each walking session provides real-time feedback and motion tracking - enabling personalized progress for individuals in recovery, those managing chronic conditions, or anyone looking to stay active and mobile.\n\nWhether you're rehabilitating, training, or simply exploring, Muvia Walking brings purposeful movement  and real therapeutic outcomes right to your doorstep.", "short_description": "Experience the joy of walking while improving your mobility and balance. Muvia Walking blends immersive VR environments with therapeutic benefits and real-time feedback, making everyday movement more engaging and accessible - anytime, anywhere."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.muvia.ai/privacy", "developer_terms_of_service_url": "https://www.muvia.ai/terms", "publisher_name": "Muvia Inc. ", "support_website_url": null, "website_url": "https://www.muvia.ai/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "478089301798119"}], "external_subscription_type": "NOT_REQU
2_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T27jywBSJ5oQ7kNvwHQqFX-&_nc_oc=AdkYkBBfErZLcZwkB1BE9yMhcxWBenuOOoSX71l-41kdWl4NfHq2oWQShJbwKkZHTpA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AfsLpaucXIDFEEFlfTMUQhT8YfKe3s1Fn9ejfZduIxVpTg&oe=699F04B5"}, {"file_name": "Screenshot_2880x1600_f911d.png", "id": "1060401919608115", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499307433_1060401922941448_7780354140265136177_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2dWbu6S35_gQ7kNvwEa_HgS&_nc_oc=Adkvdkjtd0E9DnegzAfB3GFKjqMtn7sZ2XQRWBXyHOtLEMdyPPNS5OAyoz4Fh6QKTls&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AfuryHn7Ix2x7Gd_K8ahMgjGbO_pjuQX_lccXuhYwxjwcA&oe=699EDA6F"}, {"file_name": "Screenshot_2880x1600_c1505.png", "id": "1411945193356179", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499296119_1411945196689512_7734998725794814567_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xGObB54rJrwQ7kNvwHIK4iE&_nc_oc=Adkpst6f3s4Gjpwirp8ErDWmCrDwiXFK01NqX1mu_NaU32wdjCZzaLxuTzVMns4DKiY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AfvHRhT-RLMA6zt9mzMofeEXWyERd8YuhYl_W_zC2u7OkA&oe=699EEF34"}, {"file_name": "Screenshot_2880x1600_4c5b1.png", "id": "1068101905502534", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491819396_1068101908835867_3312216196419352187_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xQD20qcyUiIQ7kNvwGcTrmG&_nc_oc=Adld8dx_NA5oE7JhtwZPEDIeHE0F_Lqt9GHhXvYZZAX2fMz0J5NZS3CFZ7O4i0_jA4g&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AfsPjO1k9Jk1VJwC5Sio4SM6bU42mmC0zGj1Y360ogo7IQ&oe=699EF454"}, {"file_name": "Screenshot_2880x1600_4d288.png", "id": "1698872327430738", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499307315_1698872330764071_1141194021950334483_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bfIcY8H9U1MQ7kNvwHBkMAm&_nc_oc=AdmtfB18XXkleQD5wlcqlW9_mo0Aw9rFAgwmzstHN4BqlRdeTZYnp3UGeYDP_kMzMuY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AfvgOfqKcVqPk2_RN5TFQWAAwAT7RaKe8F_j5eQyCf-Hiw&oe=699EF989"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Muvia Walking", "keywords": ["games", "rehab", "walking", "rehabilitation"], "long_description": "Muvia Walking turns rehabilitation into an empowering journey -blending VR, AI, and natural walking motion to restore mobility and rebuild confidence.\n\nMore than just a fitness tool, Muvia Walking offers a unique blend of gamified therapy and immersive exploration. Set in beautifully rendered virtual environments, users walk through diverse paths, improve gait and posture, and engage in full-body movements that stimulate both body and mind.\n\nDesigned for both clinical and at-home use, each walking session provides real-time feedback and motion tracking - enabling personalized progress for individuals in recovery, those managing chronic conditions, or anyone looking to stay active and mobile.\n\nWhether you're rehabilitating, training, or simply exploring, Muvia Walking brings purposeful movement  and real therapeutic outcomes right to your doorstep.", "short_description": "Experience the joy of walking while improving your mobility and balance. Muvia Walking blends immersive VR environments with therapeutic benefits and real-time feedback, making everyday movement more engaging and accessible - anytime, anywhere."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.muvia.ai/privacy", "developer_terms_of_service_url": "https://www.muvia.ai/terms", "publisher_name": "Muvia Inc. ", "support_website_url": null, "website_url": "https://www.muvia.ai/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "478089301798119"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory
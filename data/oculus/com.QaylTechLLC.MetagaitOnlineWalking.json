://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499307433_1106824034679021_2208238346986365142_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QgzJrWX1anMQ7kNvwH1HBQH&_nc_oc=AdpBdfG_XYd6FTIhsYdJgI0r38_wzrauS6HIchmxZmlZcPjYqZt7IwCkcLEEJzP4Ov8&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1Sz4jVOZoPDaosf3ipQ4s4DCJuRRNo0Lc_vnHSCryGDA&oe=69D3C0B5"}, {"file_name": "Screenshot_2880x1600_f911d.png", "id": "1060401919608115", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499307433_1060401922941448_7780354140265136177_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LKDnOLCNaucQ7kNvwEGBEsD&_nc_oc=AdoNQbgGg0lTxTmEh8uVyDlJOhPLoGzW2Ze4_MGhPQmgHcOxyYJsfCfeGTeuvNTCX1w&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2Z5ymOgOZYVd6q8y-HIi9CgYmAyitnr5MMaFUOYFNXgA&oe=69D3966F"}, {"file_name": "Screenshot_2880x1600_c1505.png", "id": "1411945193356179", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499296119_1411945196689512_7734998725794814567_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2hsW-eK4NfsQ7kNvwFulWNF&_nc_oc=AdoPTrJ5zCZX39GD9sZZ6YnxuL6b9FdjAcilFdcnen7mnhr__YuNbmFotWzrIuo2k4o&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3i-ZpY08kb7-ldK9eluInzpueQieHWLxD8sJyPebpqyg&oe=69D3AB34"}, {"file_name": "Screenshot_2880x1600_4c5b1.png", "id": "1068101905502534", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491819396_1068101908835867_3312216196419352187_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yHwPZ53_TjAQ7kNvwGZJSLr&_nc_oc=AdoZhhDoJUDSDCzqNRNtLB7pEZdfDFKejRFuR0VEjofWcVZ22NLlts33FQxFSAt00Ag&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1R0V6mI4iMXPPkVdklMkSkoTGeJIyWqsH7zi1bGGr8Ug&oe=69D3B054"}, {"file_name": "Screenshot_2880x1600_4d288.png", "id": "1698872327430738", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499307315_1698872330764071_1141194021950334483_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HLmC9eOwGDgQ7kNvwE1_3BU&_nc_oc=AdqoDzYWIUIGRK8w6xkghHCg9q-dEtnHf1yx9mgXNS25CmGKwV1sdwv927MUELgxGpY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2HWm31r0ghQ9XK9Z--MDdV2NzufsIyYNKByDHzXlUaww&oe=69D3B589"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Muvia Walking", "keywords": ["games", "rehab", "walking", "rehabilitation"], "long_description": "Muvia Walking turns rehabilitation into an empowering journey -blending VR, AI, and natural walking motion to restore mobility and rebuild confidence.\n\nMore than just a fitness tool, Muvia Walking offers a unique blend of gamified therapy and immersive exploration. Set in beautifully rendered virtual environments, users walk through diverse paths, improve gait and posture, and engage in full-body movements that stimulate both body and mind.\n\nDesigned for both clinical and at-home use, each walking session provides real-time feedback and motion tracking - enabling personalized progress for individuals in recovery, those managing chronic conditions, or anyone looking to stay active and mobile.\n\nWhether you're rehabilitating, training, or simply exploring, Muvia Walking brings purposeful movement  and real therapeutic outcomes right to your doorstep.", "short_description": "Experience the joy of walking while improving your mobility and balance. Muvia Walking blends immersive VR environments with therapeutic benefits and real-time feedback, making everyday movement more engaging and accessible - anytime, anywhere."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.muvia.ai/privacy", "developer_terms_of_service_url": "https://www.muvia.ai/terms", "publisher_name": "Muvia Inc. ", "support_website_url": null, "website_url": "https://www.muvia.ai/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "478089301798119"}], "external_subscription_type": "NOT_REQU
://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/499307433_1106824034679021_2208238346986365142_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wVtMZHt4oNYQ7kNvwEyk-xN&_nc_oc=AdpFskTVDA6jIDkHIMstoCScEvC_R80sWpM_xeeY144yx7rU3c6QCwQseeh3MSKOQUQ&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLp2oF8tZqr9-cumauHOtMz7fyjIsK58nqGsjtzvWwHHg&oe=6AA16AB5"}, {"file_name": "Screenshot_2880x1600_f911d.png", "id": "1060401919608115", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/499307433_1060401922941448_7780354140265136177_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oQdDGL4p4-AQ7kNvwFNDiuO&_nc_oc=AdrDCzjODKdAbbEiW6MhGJzDbXpuOrERTuc8-zd8LrdX88uk2sdjQMwbuP_KR3le9e4&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ5u7Yy7LE2k-IHcyMgunj2bBp1nF3R270oJVz9fR5DFA&oe=6AA178AF"}, {"file_name": "Screenshot_2880x1600_c1505.png", "id": "1411945193356179", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/499296119_1411945196689512_7734998725794814567_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6ennqdxxhNsQ7kNvwGij9-k&_nc_oc=Adp01sG2NT-nifj02y9gZ95nF84NEfB9E8VUA_HG9DRftGCxU7pnCe50AKupOxFzVfc&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK6GX_pCPlGG_jUsVeYal8oZUsevLxltHOgvsrZCdiGKQ&oe=6AA15534"}, {"file_name": "Screenshot_2880x1600_4c5b1.png", "id": "1068101905502534", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/491819396_1068101908835867_3312216196419352187_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w1_8TRQXRmkQ7kNvwFhOp72&_nc_oc=AdpaRJfFZARinHoU1e-khH-W1mlUw1Hrh6afiwqYMDAAOqYoTGvXaQvwmmOs-wn9lj8&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKq8h80_dJdOGT3vctG6CEBU6KUhFtBd26VLEnkXm6yNg&oe=6AA15A54"}, {"file_name": "Screenshot_2880x1600_4d288.png", "id": "1698872327430738", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/499307315_1698872330764071_1141194021950334483_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-ywop7ui6n0Q7kNvwE8BDF0&_nc_oc=Adpy2j6-kkrFjHnDDtxn6Rtko-LSDb3ZhnctnPfqkmz5uBRDg13YuNztNBjSPTVrnfk&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ_xBWt5bgHrWk95eoGyU3tA_e8CO5YQCKeGTfRButkHQ&oe=6AA15F89"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Muvia Walking", "keywords": ["games", "rehab", "walking", "rehabilitation"], "long_description": "Muvia Walking turns rehabilitation into an empowering journey -blending VR, AI, and natural walking motion to restore mobility and rebuild confidence.\n\nMore than just a fitness tool, Muvia Walking offers a unique blend of gamified therapy and immersive exploration. Set in beautifully rendered virtual environments, users walk through diverse paths, improve gait and posture, and engage in full-body movements that stimulate both body and mind.\n\nDesigned for both clinical and at-home use, each walking session provides real-time feedback and motion tracking - enabling personalized progress for individuals in recovery, those managing chronic conditions, or anyone looking to stay active and mobile.\n\nWhether you're rehabilitating, training, or simply exploring, Muvia Walking brings purposeful movement  and real therapeutic outcomes right to your doorstep.", "short_description": "Experience the joy of walking while improving your mobility and balance. Muvia Walking blends immersive VR environments with therapeutic benefits and real-time feedback, making everyday movement more engaging and accessible - anytime, anywhere."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.muvia.ai/privacy", "developer_terms_of_service_url": "https://www.muvia.ai/terms", "publisher_name": "Muvia Inc. ", "support_website_url": null, "website_url": "https://www.muvia.ai/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "478089301798119"}], "external_subscription_type": "NOT_REQU
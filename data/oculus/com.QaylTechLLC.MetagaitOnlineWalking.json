://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499307433_1106824034679021_2208238346986365142_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Vb8uuTgjIn4Q7kNvwE-axLk&_nc_oc=AdqGZCjCLLzHkODLvs22pIKHyJz0NPdRbsNLZdATpGh8dd-vzLjwXYBBY5TtPYd0znc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL29_dv1V7Yct-J0Z0U0d2sWj319IMgGJrec-XE7naLPA&oe=6AB925B5"}, {"file_name": "Screenshot_2880x1600_f911d.png", "id": "1060401919608115", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499307433_1060401922941448_7780354140265136177_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Q-V2wkW57OwQ7kNvwEHtwIR&_nc_oc=Ado28HIyCB0Ufiil2P7HrXMQyFXY0q6SQW0VOdSm1Y51lZTSoy9JXHD6bxZGActdj7U&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQILUCcr1sLeboPJUoAGios0dvKOBIbk6y-5YP4Jznr1kw&oe=6AB933AF"}, {"file_name": "Screenshot_2880x1600_c1505.png", "id": "1411945193356179", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499296119_1411945196689512_7734998725794814567_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eckR2oVDz6QQ7kNvwH42x-T&_nc_oc=AdoCek6jVdInCy-UyJKoGMCpUgzsey1GXlx_Y2VEAzvflsIEdIU8b89BCaEBBmbnI8E&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKc4iS9MGJkF_KzLQcRw6F-O-VdFFekCI-KffhmX30rbQ&oe=6AB91034"}, {"file_name": "Screenshot_2880x1600_4c5b1.png", "id": "1068101905502534", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491819396_1068101908835867_3312216196419352187_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_flH860i1kgQ7kNvwFjAx6H&_nc_oc=AdreJ_nX5UNXoKHXop7GLwKVh3jImfnLTB8WHXO0M-Aa03ycy9Znq-CEAoBs8HsdhHA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLSCYnVjzcqJZn2IKXkX7AULMT46vIRkfwKJuoij7xhyg&oe=6AB91554"}, {"file_name": "Screenshot_2880x1600_4d288.png", "id": "1698872327430738", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499307315_1698872330764071_1141194021950334483_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RDqUivR6EOoQ7kNvwH5PAQY&_nc_oc=AdoDOxh_so8z2YGAIdrBjQiY_2DM1KpWIlQtDFiJYmfXwpB--7P1HsglQ5jyo6nw2S8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJM3OWLwRp56Lw5FGjPBfYZkFsAL0t94oYer5FT79-FYA&oe=6AB91A89"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Muvia Walking", "keywords": ["games", "rehab", "walking", "rehabilitation"], "long_description": "Muvia Walking turns rehabilitation into an empowering journey -blending VR, AI, and natural walking motion to restore mobility and rebuild confidence.\n\nMore than just a fitness tool, Muvia Walking offers a unique blend of gamified therapy and immersive exploration. Set in beautifully rendered virtual environments, users walk through diverse paths, improve gait and posture, and engage in full-body movements that stimulate both body and mind.\n\nDesigned for both clinical and at-home use, each walking session provides real-time feedback and motion tracking - enabling personalized progress for individuals in recovery, those managing chronic conditions, or anyone looking to stay active and mobile.\n\nWhether you're rehabilitating, training, or simply exploring, Muvia Walking brings purposeful movement  and real therapeutic outcomes right to your doorstep.", "short_description": "Experience the joy of walking while improving your mobility and balance. Muvia Walking blends immersive VR environments with therapeutic benefits and real-time feedback, making everyday movement more engaging and accessible - anytime, anywhere."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.muvia.ai/privacy", "developer_terms_of_service_url": "https://www.muvia.ai/terms", "publisher_name": "Muvia Inc. ", "support_website_url": null, "website_url": "https://www.muvia.ai/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "478089301798119"}], "external_subscription_type": "NOT_REQU
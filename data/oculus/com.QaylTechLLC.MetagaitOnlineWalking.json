.com/v/t64.5771-25/499307433_1106824034679021_2208238346986365142_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KF9dLrfX848Q7kNvwHaxn1V&_nc_oc=Adnjp9xQDzIB2e4RScn5v3gnMyrTbFbKWDlSkS-iHvwUmFcmbkx9PNk_uqCJv_um4yU&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_Afz59TXC3zTBI7Zg66yCOwrLYf5EQWtuU4YfdsocBX_YHw&oe=69BEA8B5"}, {"file_name": "Screenshot_2880x1600_f911d.png", "id": "1060401919608115", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499307433_1060401922941448_7780354140265136177_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YvjYdHunwQ4Q7kNvwEa4vTF&_nc_oc=AdnfwlD6fWB1ldYlHXATbdGSkJq_Kso16f1DP-nbNrR6S8vdYZuC42kkUt3jvUpSCbg&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_Afw7R0E-0QjIVhRp9TNhIWVdd7vnggROEugOfHGFYfNAHA&oe=69BE7E6F"}, {"file_name": "Screenshot_2880x1600_c1505.png", "id": "1411945193356179", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499296119_1411945196689512_7734998725794814567_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_3DWzmq0xc8Q7kNvwG0ZuY1&_nc_oc=AdkL8VGfCCksvhIBTjdsVkX7IFGwT2oSu51dnnH8MNPBuJR0kLe6DeMto7Tfx6dviS8&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfxVo041SVPwYY9vt7vPqocXHqqeRE5xt8yuV-4yPgq1rA&oe=69BE9334"}, {"file_name": "Screenshot_2880x1600_4c5b1.png", "id": "1068101905502534", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491819396_1068101908835867_3312216196419352187_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8GlHY8eFJWoQ7kNvwHYFGba&_nc_oc=AdkHvEn8-DKXfE9N_oBAnPPqauk7DyeX46of08ZKfyJ2RF8-ItjDbiFvabA6s7WgwZA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_Afy0LzLGPR3fHBoqiNXGdw507er8azkrkhYBGCyj4tRivw&oe=69BE9854"}, {"file_name": "Screenshot_2880x1600_4d288.png", "id": "1698872327430738", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499307315_1698872330764071_1141194021950334483_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IxDGVG8_l7oQ7kNvwHVVNNa&_nc_oc=AdlU2wWOIkPDjN4Ljy_btFeEJ9Wb2o6HFuSKWpT_Vq2E4sid7dBu1aNQxS45LD9sPCM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfxZZep9XBBC_5eaczvvUx7Gfm1aNaa0ynUU4ChCuz_aIw&oe=69BE9D89"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Muvia Walking", "keywords": ["games", "rehab", "walking", "rehabilitation"], "long_description": "Muvia Walking turns rehabilitation into an empowering journey -blending VR, AI, and natural walking motion to restore mobility and rebuild confidence.\n\nMore than just a fitness tool, Muvia Walking offers a unique blend of gamified therapy and immersive exploration. Set in beautifully rendered virtual environments, users walk through diverse paths, improve gait and posture, and engage in full-body movements that stimulate both body and mind.\n\nDesigned for both clinical and at-home use, each walking session provides real-time feedback and motion tracking - enabling personalized progress for individuals in recovery, those managing chronic conditions, or anyone looking to stay active and mobile.\n\nWhether you're rehabilitating, training, or simply exploring, Muvia Walking brings purposeful movement  and real therapeutic outcomes right to your doorstep.", "short_description": "Experience the joy of walking while improving your mobility and balance. Muvia Walking blends immersive VR environments with therapeutic benefits and real-time feedback, making everyday movement more engaging and accessible - anytime, anywhere."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.muvia.ai/privacy", "developer_terms_of_service_url": "https://www.muvia.ai/terms", "publisher_name": "Muvia Inc. ", "support_website_url": null, "website_url": "https://www.muvia.ai/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "478089301798119"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "in
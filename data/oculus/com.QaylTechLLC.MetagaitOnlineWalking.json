2_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S68xxkfNgtEQ7kNvwHfQ24x&_nc_oc=AdnGvXHww8wWEH4g92OMCsc3GyRrg-LDV8ZgUSz455Oncjmi2jop7ckdk8ooeZ8UQxA&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&oh=00_AftRtChM-P7H2XuGurdWqEQW_lwDMPnTqN722Qry3-MOGQ&oe=69A59C35"}, {"file_name": "Screenshot_2880x1600_f911d.png", "id": "1060401919608115", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499307433_1060401922941448_7780354140265136177_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OLdC-3aTvfgQ7kNvwEpprFB&_nc_oc=Adm4JEs8vaTpWWM8SAtbm0CQc9CksLvI5dNYveF65wflMkUOQ8sK9vyTJVRDw5oFuj4&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_AfvmTcfxIKrHVE-wRsBTAn6IFi49iTeyBFexWI9fRpWhhw&oe=69A571EF"}, {"file_name": "Screenshot_2880x1600_c1505.png", "id": "1411945193356179", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499296119_1411945196689512_7734998725794814567_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JeS0kVU17WIQ7kNvwFQ0ROc&_nc_oc=AdnuElihPQAYNg6Il_BLqMr5gfHdHnasl57l8I49l5wWG_OexR74Vu56bOxaDiHPD58&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&oh=00_AfsKQ-mqJsfffyiZySL_8-fTd3uxQeVF_WoS_kTpAznZ-A&oe=69A586B4"}, {"file_name": "Screenshot_2880x1600_4c5b1.png", "id": "1068101905502534", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/491819396_1068101908835867_3312216196419352187_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Dbbkw6RaMPcQ7kNvwGEj7Zx&_nc_oc=AdlajP_MdD7V50X4IQwT2ehdzpVlKC5AfKdG95BZ5ubEz6s9pKWEaFlAt5j-jEZcT4I&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_Afs_FIpbKFMh00sleMSNb8SI-FeCpQerExWjWFbDi4UAkQ&oe=69A58BD4"}, {"file_name": "Screenshot_2880x1600_4d288.png", "id": "1698872327430738", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499307315_1698872330764071_1141194021950334483_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mSiKUC_Oe4MQ7kNvwEM8pyL&_nc_oc=AdmwRIS94s8SalcAbUc59T_OPrutvYSmnpllASU6uqpEzgZ24g462hyAn-seAvcL9XY&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_AfthzpgX-nkJNTdt9X1A-csmAO5FJhZyLXSOdq231KSTcQ&oe=69A59109"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Muvia Walking", "keywords": ["games", "rehab", "walking", "rehabilitation"], "long_description": "Muvia Walking turns rehabilitation into an empowering journey -blending VR, AI, and natural walking motion to restore mobility and rebuild confidence.\n\nMore than just a fitness tool, Muvia Walking offers a unique blend of gamified therapy and immersive exploration. Set in beautifully rendered virtual environments, users walk through diverse paths, improve gait and posture, and engage in full-body movements that stimulate both body and mind.\n\nDesigned for both clinical and at-home use, each walking session provides real-time feedback and motion tracking - enabling personalized progress for individuals in recovery, those managing chronic conditions, or anyone looking to stay active and mobile.\n\nWhether you're rehabilitating, training, or simply exploring, Muvia Walking brings purposeful movement  and real therapeutic outcomes right to your doorstep.", "short_description": "Experience the joy of walking while improving your mobility and balance. Muvia Walking blends immersive VR environments with therapeutic benefits and real-time feedback, making everyday movement more engaging and accessible - anytime, anywhere."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.muvia.ai/privacy", "developer_terms_of_service_url": "https://www.muvia.ai/terms", "publisher_name": "Muvia Inc. ", "support_website_url": null, "website_url": "https://www.muvia.ai/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "478089301798119"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory
://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499307433_1106824034679021_2208238346986365142_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QgzJrWX1anMQ7kNvwGDe3g0&_nc_oc=AdoDtkxw8smMbZXzUhh5LEqMFyALiLvCSFte8U4ZHsAH-pOFP9OVca6DlkGokG-ZF9Q&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af07zgE6jrsnueN4TXJyPXkGV74imZMUUjpp1dHtNBApXQ&oe=69D26F35"}, {"file_name": "Screenshot_2880x1600_f911d.png", "id": "1060401919608115", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499307433_1060401922941448_7780354140265136177_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LKDnOLCNaucQ7kNvwHPgLmY&_nc_oc=Adr_s7ZtH5CDlR1UhgRLKmcf34TZ6WrceAC4Cxk49Bot56T_VhmhYPm2hF4EUb8gJcs&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af08GVZoCCJmmKwG7Xh-YCMBgnseTKTl2CNXYx90Arazgg&oe=69D27D2F"}, {"file_name": "Screenshot_2880x1600_c1505.png", "id": "1411945193356179", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499296119_1411945196689512_7734998725794814567_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M-8QvIBxudUQ7kNvwFlGcne&_nc_oc=Adqtv0treMCTKrmdzrLaCbZEWR8EFSM6Sq1UOsqc55OkPh-SZRkB8g5c5_S0t10Wqjc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1q_qeFMrMxr2oFLNNIWpbl-y1ipKgSrEquFkiNjbmjrw&oe=69D259B4"}, {"file_name": "Screenshot_2880x1600_4c5b1.png", "id": "1068101905502534", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491819396_1068101908835867_3312216196419352187_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yHwPZ53_TjAQ7kNvwE6qbWk&_nc_oc=AdoYkJuOW9tJYJ9ObjxpIfZHliWiYiUMmagbJrKsMxA62TXshGPsrZcId_-1VwuDCf8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1C-fVNkg5lD5xmQ0h9Ugalqgbthsuff_CjuRNYMVJ5bw&oe=69D25ED4"}, {"file_name": "Screenshot_2880x1600_4d288.png", "id": "1698872327430738", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499307315_1698872330764071_1141194021950334483_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HLmC9eOwGDgQ7kNvwENoigg&_nc_oc=AdqfRihccQ9_7-lKGwrSrxlHHKjC_Gzc_mRYuqpPeYLHJ2wjURQFIu34oobx-gaK3lY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0SGKg6pOmFl_DAIf_A1VIcOywUkE_vMEyySf6D0xn3vw&oe=69D26409"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Muvia Walking", "keywords": ["games", "rehab", "walking", "rehabilitation"], "long_description": "Muvia Walking turns rehabilitation into an empowering journey -blending VR, AI, and natural walking motion to restore mobility and rebuild confidence.\n\nMore than just a fitness tool, Muvia Walking offers a unique blend of gamified therapy and immersive exploration. Set in beautifully rendered virtual environments, users walk through diverse paths, improve gait and posture, and engage in full-body movements that stimulate both body and mind.\n\nDesigned for both clinical and at-home use, each walking session provides real-time feedback and motion tracking - enabling personalized progress for individuals in recovery, those managing chronic conditions, or anyone looking to stay active and mobile.\n\nWhether you're rehabilitating, training, or simply exploring, Muvia Walking brings purposeful movement  and real therapeutic outcomes right to your doorstep.", "short_description": "Experience the joy of walking while improving your mobility and balance. Muvia Walking blends immersive VR environments with therapeutic benefits and real-time feedback, making everyday movement more engaging and accessible - anytime, anywhere."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.muvia.ai/privacy", "developer_terms_of_service_url": "https://www.muvia.ai/terms", "publisher_name": "Muvia Inc. ", "support_website_url": null, "website_url": "https://www.muvia.ai/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "478089301798119"}], "external_subscription_type": "NOT_REQU
://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/499307433_1106824034679021_2208238346986365142_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6DaBT-t33KYQ7kNvwEh7oEL&_nc_oc=AdpkSbp0-oPQSX79tKZX0mws6qdkE-4vWQMnXz5C49mi0FmgA48AghUCEqDETcYYs7M&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQARbYQ9tBcJAwQarYyoosEJzQ30j2qFTay_b3AFhs-ZDA&oe=6A68BA35"}, {"file_name": "Screenshot_2880x1600_f911d.png", "id": "1060401919608115", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499307433_1060401922941448_7780354140265136177_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sSHcff-5fvcQ7kNvwGDXkN0&_nc_oc=Adrp6SqEullJX8ciOzuj5r_2yDEgkHHRszwZai9Wbk6kk9xNLfJhmFwDzL_Lg3G9Ink&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCWI7jIn1Ti-QnDGeVfDzchNHDq3RmwgLKT3b5t57BS1Q&oe=6A688FEF"}, {"file_name": "Screenshot_2880x1600_c1505.png", "id": "1411945193356179", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/499296119_1411945196689512_7734998725794814567_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KPSmb0MLeNoQ7kNvwEX7gNJ&_nc_oc=AdrSgfw01shHBHRmY2hh38lnxh0wiV2QNxfYZa4JtbmdXAYXhui924OokTi61rtorco&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDX3PKUWZ6I_EjLnEGqOYUKkZTH84Gkyr03MgZR8DoEKQ&oe=6A68A4B4"}, {"file_name": "Screenshot_2880x1600_4c5b1.png", "id": "1068101905502534", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/491819396_1068101908835867_3312216196419352187_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Q79umY8oo90Q7kNvwH1zhVM&_nc_oc=AdrJJdj9-y5UyIp2XB2d4kMJ9HsNY5fGl59qAzmAUbPb3ScROKYOgUbOYf7RxMgPSj8&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBe1OU7k_xQzO9OE89-Qvqqf9iL7_ECBucArEJenTnNrQ&oe=6A68A9D4"}, {"file_name": "Screenshot_2880x1600_4d288.png", "id": "1698872327430738", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499307315_1698872330764071_1141194021950334483_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tjKQdcnqGIgQ7kNvwEXhEKU&_nc_oc=AdoeKIJSHWvrlBo1nySE_jNuhdF-cH2w6nqx5oSLL9O64TsMUoWy10rQN1srpE--2kg&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDplFvYViBpcwm_qCsI8CWfD9scDT18apR1-BbfTHW_Qg&oe=6A68AF09"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Muvia Walking", "keywords": ["games", "rehab", "walking", "rehabilitation"], "long_description": "Muvia Walking turns rehabilitation into an empowering journey -blending VR, AI, and natural walking motion to restore mobility and rebuild confidence.\n\nMore than just a fitness tool, Muvia Walking offers a unique blend of gamified therapy and immersive exploration. Set in beautifully rendered virtual environments, users walk through diverse paths, improve gait and posture, and engage in full-body movements that stimulate both body and mind.\n\nDesigned for both clinical and at-home use, each walking session provides real-time feedback and motion tracking - enabling personalized progress for individuals in recovery, those managing chronic conditions, or anyone looking to stay active and mobile.\n\nWhether you're rehabilitating, training, or simply exploring, Muvia Walking brings purposeful movement  and real therapeutic outcomes right to your doorstep.", "short_description": "Experience the joy of walking while improving your mobility and balance. Muvia Walking blends immersive VR environments with therapeutic benefits and real-time feedback, making everyday movement more engaging and accessible - anytime, anywhere."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.muvia.ai/privacy", "developer_terms_of_service_url": "https://www.muvia.ai/terms", "publisher_name": "Muvia Inc. ", "support_website_url": null, "website_url": "https://www.muvia.ai/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "478089301798119"}], "external_subscription_type": "NOT_REQU
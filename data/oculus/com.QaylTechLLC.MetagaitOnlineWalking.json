://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499307433_1106824034679021_2208238346986365142_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UlLhJFa44CIQ7kNvwEABhYq&_nc_oc=AdqaIP4wfODoSah79YQHY7OAZrsK6ANhNSJCpWm5GUGobMewKnxD1767RRupfkrVkug&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFCjeXhwb1-T5rD01vQbh0edx-L2K3vuhRTSI_1BhlhAA&oe=6A7B2F35"}, {"file_name": "Screenshot_2880x1600_f911d.png", "id": "1060401919608115", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499307433_1060401922941448_7780354140265136177_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pwNuGY1yxoYQ7kNvwFdks9l&_nc_oc=Adq2z4ie-W811qquIafqoAHJ7CQPqJVlO500oNZvm1rrZT2ne_HhidkOKLiDtViRUNo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHTVmflM3YCjmwuwl3S5DPHbYqAhl1000FXFqKGvyZn0Q&oe=6A7B04EF"}, {"file_name": "Screenshot_2880x1600_c1505.png", "id": "1411945193356179", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499296119_1411945196689512_7734998725794814567_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eh3rmVKNWZwQ7kNvwHRz3R6&_nc_oc=AdpIyWGyfqZHDhfKhrOAP_H3RKKzy1QMRs-ZJZnWqjHnJ4H4OaYK4JbaUvVNy52sxXs&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGRDEhIF7Pj0LTppQD2C67ACXuKG9DpyVeVfchhAVVH6Q&oe=6A7B19B4"}, {"file_name": "Screenshot_2880x1600_4c5b1.png", "id": "1068101905502534", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491819396_1068101908835867_3312216196419352187_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fFxArya_hk0Q7kNvwEq7EgT&_nc_oc=AdrZUxFBOD_A02NhJWG5S6t9AYACSd1qD5KL7Jn9lfO4QksZgBoI5l9t7b1jkosiFbE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFrPmij6erkPirlsbnUNchYJ2AOU9OP_GdR8c9W4COW8A&oe=6A7B1ED4"}, {"file_name": "Screenshot_2880x1600_4d288.png", "id": "1698872327430738", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499307315_1698872330764071_1141194021950334483_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qAipefTsuScQ7kNvwHJjzrr&_nc_oc=AdqS5yQK6jxFin8RyH03DeKcsZyC2afpa8Bu5v05YeNn8nHl8UMkHe-Sl2a_PnOKZfQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFLJrJOgJ2PTSEHU2xXLxwalJr_Hb2p2LxgMUZ5PMTmCA&oe=6A7B2409"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Muvia Walking", "keywords": ["games", "rehab", "walking", "rehabilitation"], "long_description": "Muvia Walking turns rehabilitation into an empowering journey -blending VR, AI, and natural walking motion to restore mobility and rebuild confidence.\n\nMore than just a fitness tool, Muvia Walking offers a unique blend of gamified therapy and immersive exploration. Set in beautifully rendered virtual environments, users walk through diverse paths, improve gait and posture, and engage in full-body movements that stimulate both body and mind.\n\nDesigned for both clinical and at-home use, each walking session provides real-time feedback and motion tracking - enabling personalized progress for individuals in recovery, those managing chronic conditions, or anyone looking to stay active and mobile.\n\nWhether you're rehabilitating, training, or simply exploring, Muvia Walking brings purposeful movement  and real therapeutic outcomes right to your doorstep.", "short_description": "Experience the joy of walking while improving your mobility and balance. Muvia Walking blends immersive VR environments with therapeutic benefits and real-time feedback, making everyday movement more engaging and accessible - anytime, anywhere."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.muvia.ai/privacy", "developer_terms_of_service_url": "https://www.muvia.ai/terms", "publisher_name": "Muvia Inc. ", "support_website_url": null, "website_url": "https://www.muvia.ai/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "478089301798119"}], "external_subscription_type": "NOT_REQU
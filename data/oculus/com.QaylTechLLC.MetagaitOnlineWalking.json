://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499307433_1106824034679021_2208238346986365142_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Hg6r-q7gz1QQ7kNvwFof13h&_nc_oc=AdovZ1mYHCYaZlECY1YBQR7hczsKLhizkWQnI47YGmiiWdNVK7C9w8l3u2QFV_A171g&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6XJsrQ52PjJ8mSXXcQpCi-torD-sLcD7z36CZJ211eGw&oe=6A19A035"}, {"file_name": "Screenshot_2880x1600_f911d.png", "id": "1060401919608115", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499307433_1060401922941448_7780354140265136177_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RY02JhF45kkQ7kNvwFUBjXW&_nc_oc=AdoNT_abg-fM8qkmf3-Tag_n8lolNZ3_gQfcXpcV_1xxqAylLv-Iv50SlPQmJXa-f3U&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7pWNViYxeWLM5m6NYkR2kfg66A9URJX2nn1foNcfMTtQ&oe=6A19AE2F"}, {"file_name": "Screenshot_2880x1600_c1505.png", "id": "1411945193356179", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499296119_1411945196689512_7734998725794814567_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rnRVs-BBqdMQ7kNvwG5BFC8&_nc_oc=Adq36TNtVMVOI5_R6APfy2taN9JvpBneTRc25Nj1sPdttB9gZogVR5W9ueyoLKqLkeo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7Pu01ssrMa5F_QpsrpfV-xQxnCuVXA3RLDPqUyxkamJg&oe=6A198AB4"}, {"file_name": "Screenshot_2880x1600_4c5b1.png", "id": "1068101905502534", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491819396_1068101908835867_3312216196419352187_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7SXcdmLmmFoQ7kNvwF3rfrS&_nc_oc=Adq_pckjB3l5dm10gzJC-zEIKdGj1UbUF1huHum2IkFJi6NSfU_LoJ8Fq-tIGtaYqqA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5vrElYtxJQQMxrFzc-z52cZ49Nhev1x8p8U4df8Xno5w&oe=6A198FD4"}, {"file_name": "Screenshot_2880x1600_4d288.png", "id": "1698872327430738", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499307315_1698872330764071_1141194021950334483_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f5AuDKixqo0Q7kNvwGElbcR&_nc_oc=AdrA7FiJxeFJcxGTmLIcdaKovCwBWVMhZMAztRgCyc67DN4FrgxYAfekJURAo3d_bhU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5zxHGtWGivi3lH0c2UdLKof8Kucblm81cWGk1P57uCUg&oe=6A199509"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Muvia Walking", "keywords": ["games", "rehab", "walking", "rehabilitation"], "long_description": "Muvia Walking turns rehabilitation into an empowering journey -blending VR, AI, and natural walking motion to restore mobility and rebuild confidence.\n\nMore than just a fitness tool, Muvia Walking offers a unique blend of gamified therapy and immersive exploration. Set in beautifully rendered virtual environments, users walk through diverse paths, improve gait and posture, and engage in full-body movements that stimulate both body and mind.\n\nDesigned for both clinical and at-home use, each walking session provides real-time feedback and motion tracking - enabling personalized progress for individuals in recovery, those managing chronic conditions, or anyone looking to stay active and mobile.\n\nWhether you're rehabilitating, training, or simply exploring, Muvia Walking brings purposeful movement  and real therapeutic outcomes right to your doorstep.", "short_description": "Experience the joy of walking while improving your mobility and balance. Muvia Walking blends immersive VR environments with therapeutic benefits and real-time feedback, making everyday movement more engaging and accessible - anytime, anywhere."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.muvia.ai/privacy", "developer_terms_of_service_url": "https://www.muvia.ai/terms", "publisher_name": "Muvia Inc. ", "support_website_url": null, "website_url": "https://www.muvia.ai/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "478089301798119"}], "external_subscription_type": "NOT_REQU
://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499307433_1106824034679021_2208238346986365142_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=brG8Cefp0l8Q7kNvwEmLE_7&_nc_oc=Adqcxfe98ihq1HbTqj4pWEM0YUoyBnuYhXftlNs2oHCwPG9sln5OHU7QvbFfqvhyCE0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTXwdGyRYw40YrqxHfhWZdIf9vaHtSnljfoGkQsuKqHAQ&oe=6AF71C35"}, {"file_name": "Screenshot_2880x1600_f911d.png", "id": "1060401919608115", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499307433_1060401922941448_7780354140265136177_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ouX_MiTNBeoQ7kNvwEwzDvC&_nc_oc=AdqwBDU-EludUWEFT66zhgN7D29UUlfu2TCwxoQFmNKqYiQdkmyxkpH5CKH6KehEBvI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRUo7ud1yZyCWGPakFma_FaqG_Bs5-KtrSQ_6PmWseJ_Q&oe=6AF72A2F"}, {"file_name": "Screenshot_2880x1600_c1505.png", "id": "1411945193356179", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499296119_1411945196689512_7734998725794814567_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8aQN7yoAlvsQ7kNvwELC9w_&_nc_oc=AdqxLUBnIiXyxBoAPTMV_GQ062LayZ-x-Iyo5ZOMIjypRkfnSxwOV2Rp7_KYk-Dd0fo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSZhOLw1Wk7y_SjHxzmrgY4VlNhgp_-wy6-seF9qGSeAg&oe=6AF73EF4"}, {"file_name": "Screenshot_2880x1600_4c5b1.png", "id": "1068101905502534", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491819396_1068101908835867_3312216196419352187_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7r7Lo1k87dQQ7kNvwFayl8g&_nc_oc=AdqmEoX5PqtcP9_A-MJz5JG6cThoc5JGIrzznEQ0Oe34uhQEvFwe-x3hj8vj3flfhSI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRgHzV8NVsHooHk-SF0OVB-nhba13YZ1BHNHFaUutCPDw&oe=6AF74414"}, {"file_name": "Screenshot_2880x1600_4d288.png", "id": "1698872327430738", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499307315_1698872330764071_1141194021950334483_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iMOeGaboOTIQ7kNvwG24_uv&_nc_oc=Adowc85jwia6Gobz07UltcJBgmPLKfHkmv-g-TAHkrkMJw6H9_XLQ1MYA7W6lqUV56E&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSZRb-GOsTjyFdMLacfOEgZd0PJ5NHXrbMfmlEJQWttzQ&oe=6AF74949"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Muvia Walking", "keywords": ["games", "rehab", "walking", "rehabilitation"], "long_description": "Muvia Walking turns rehabilitation into an empowering journey -blending VR, AI, and natural walking motion to restore mobility and rebuild confidence.\n\nMore than just a fitness tool, Muvia Walking offers a unique blend of gamified therapy and immersive exploration. Set in beautifully rendered virtual environments, users walk through diverse paths, improve gait and posture, and engage in full-body movements that stimulate both body and mind.\n\nDesigned for both clinical and at-home use, each walking session provides real-time feedback and motion tracking - enabling personalized progress for individuals in recovery, those managing chronic conditions, or anyone looking to stay active and mobile.\n\nWhether you're rehabilitating, training, or simply exploring, Muvia Walking brings purposeful movement  and real therapeutic outcomes right to your doorstep.", "short_description": "Experience the joy of walking while improving your mobility and balance. Muvia Walking blends immersive VR environments with therapeutic benefits and real-time feedback, making everyday movement more engaging and accessible - anytime, anywhere."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.muvia.ai/privacy", "developer_terms_of_service_url": "https://www.muvia.ai/terms", "publisher_name": "Muvia Inc. ", "support_website_url": null, "website_url": "https://www.muvia.ai/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "478089301798119"}], "external_subscription_type": "NOT_REQU
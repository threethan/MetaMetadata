://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499307433_1106824034679021_2208238346986365142_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Pp31V6FnydQQ7kNvwFREYTE&_nc_oc=AdozBNGb-uFL62GZGtSSNTN1jhIFSf9vMv_LalmpVPhyZhES6kjWz5HTsEgh49ptxyo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRTxYOvMUA3P6A6O_dKz_pnCLyq4od44s9euW8UenNSxA&oe=6AF47935"}, {"file_name": "Screenshot_2880x1600_f911d.png", "id": "1060401919608115", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499307433_1060401922941448_7780354140265136177_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ouX_MiTNBeoQ7kNvwFwlB3p&_nc_oc=AdpWC-j6FLSCwXBlaF5mH2RT8UT0vlMjE7ZC-r--HoDR_P_xPfpF6rKE9IEu2qo1FRA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRPD1XaasYeNB3VMlMC3txEXEP9h7cKzOhswY9kDOmjRQ&oe=6AF4872F"}, {"file_name": "Screenshot_2880x1600_c1505.png", "id": "1411945193356179", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499296119_1411945196689512_7734998725794814567_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8aQN7yoAlvsQ7kNvwE3nLlL&_nc_oc=AdquP7UCs57xsrGAV12niCwXIz6_ZvJCltCDKOmUBqeqQwBrQwC7T80dLVLR4iIl__c&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTHaQhvZde1fFGOQ5322dWPaFr4J_X0c5zfjpPpuDmSlw&oe=6AF49BF4"}, {"file_name": "Screenshot_2880x1600_4c5b1.png", "id": "1068101905502534", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491819396_1068101908835867_3312216196419352187_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bKMyxkLW2MkQ7kNvwH9NZB4&_nc_oc=AdojTn9EZdIvi8IaxetuwoGQHeYDWc0w9TR077QHza5nCa4ak4FBM60rSHA6_v9b-Yc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRN4c3j6uvYA65fyTkVzq0VC8B3yIH9GrhWUlgf-wCgYQ&oe=6AF4A114"}, {"file_name": "Screenshot_2880x1600_4d288.png", "id": "1698872327430738", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499307315_1698872330764071_1141194021950334483_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cVmH9SgcA3oQ7kNvwEZAzLT&_nc_oc=AdrRilrmNV75QoLVrhj7gz_Cuw_MBluvW1YqHLaFAcEWcoUP4zClD5foCS6jyLYcf9U&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTBNNM40cvenGJIrzAWarQoCoRodqryHsGjL6EP_mFv3g&oe=6AF4A649"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Muvia Walking", "keywords": ["games", "rehab", "walking", "rehabilitation"], "long_description": "Muvia Walking turns rehabilitation into an empowering journey -blending VR, AI, and natural walking motion to restore mobility and rebuild confidence.\n\nMore than just a fitness tool, Muvia Walking offers a unique blend of gamified therapy and immersive exploration. Set in beautifully rendered virtual environments, users walk through diverse paths, improve gait and posture, and engage in full-body movements that stimulate both body and mind.\n\nDesigned for both clinical and at-home use, each walking session provides real-time feedback and motion tracking - enabling personalized progress for individuals in recovery, those managing chronic conditions, or anyone looking to stay active and mobile.\n\nWhether you're rehabilitating, training, or simply exploring, Muvia Walking brings purposeful movement  and real therapeutic outcomes right to your doorstep.", "short_description": "Experience the joy of walking while improving your mobility and balance. Muvia Walking blends immersive VR environments with therapeutic benefits and real-time feedback, making everyday movement more engaging and accessible - anytime, anywhere."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.muvia.ai/privacy", "developer_terms_of_service_url": "https://www.muvia.ai/terms", "publisher_name": "Muvia Inc. ", "support_website_url": null, "website_url": "https://www.muvia.ai/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "478089301798119"}], "external_subscription_type": "NOT_REQU
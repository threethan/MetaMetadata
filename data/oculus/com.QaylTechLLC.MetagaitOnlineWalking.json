2_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j7Ob0wEUXqkQ7kNvwHM_jMF&_nc_oc=AdkwcxkrmasOyyLDmxvmmKIx8jX1XoX8VnjlkCyf_X8CC92DBAtXbsmsZuEoxvAo_gE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfvDsfAvyWVNBxbs_B7q6qyFV4R2KCD_3qqSP8nMC17b7w&oe=69A2F935"}, {"file_name": "Screenshot_2880x1600_f911d.png", "id": "1060401919608115", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499307433_1060401922941448_7780354140265136177_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NtXsmAs68ksQ7kNvwGu9wfN&_nc_oc=AdnUY0S5xepjGHg7l6IAyFtT7ttcGG6R3o_hqZgWO60OHXaDUooOgQrOCSZBmbfpO0o&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AftWVeClLbaK_YaurfXOHeaDSefxGg2aEgTEqwLFVOx7aA&oe=69A2CEEF"}, {"file_name": "Screenshot_2880x1600_c1505.png", "id": "1411945193356179", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499296119_1411945196689512_7734998725794814567_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OvAIH0ur_ogQ7kNvwEFAyXw&_nc_oc=AdlSBSsq7wYFbUWzm61SlHDMd9dkgXaegUxRIcYNj24Xk0UILS0UrD-8uJ6xbniVN8g&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AftysHOvmr7y8fWTvC98YMZS6lCr9v-nvbTkyrN16k-O-w&oe=69A2E3B4"}, {"file_name": "Screenshot_2880x1600_4c5b1.png", "id": "1068101905502534", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491819396_1068101908835867_3312216196419352187_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H68pvohLZs8Q7kNvwFBilhw&_nc_oc=AdkoquI2vH5vpVGqBtnsE9ABTpyvaI2LZuCclTvHAMpCX1A8BPXPseKeG2VOypCKw_w&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfsYRp_GTi2PvdQ4Q-M23MDqNeM8ucEbAQWqJK1S-WFXmg&oe=69A2E8D4"}, {"file_name": "Screenshot_2880x1600_4d288.png", "id": "1698872327430738", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499307315_1698872330764071_1141194021950334483_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mSiKUC_Oe4MQ7kNvwHPqSnT&_nc_oc=AdnT2zFdo_IxRABVScALjd5p9TsyMSc5l7FoBCNWwHfawDlZkewu95WeWdGYLB7z434&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AftIRMFlxHZ2mfHOWirDkH6ZFZHlOKeHYxBRcswzguW4Yg&oe=69A2EE09"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Muvia Walking", "keywords": ["games", "rehab", "walking", "rehabilitation"], "long_description": "Muvia Walking turns rehabilitation into an empowering journey -blending VR, AI, and natural walking motion to restore mobility and rebuild confidence.\n\nMore than just a fitness tool, Muvia Walking offers a unique blend of gamified therapy and immersive exploration. Set in beautifully rendered virtual environments, users walk through diverse paths, improve gait and posture, and engage in full-body movements that stimulate both body and mind.\n\nDesigned for both clinical and at-home use, each walking session provides real-time feedback and motion tracking - enabling personalized progress for individuals in recovery, those managing chronic conditions, or anyone looking to stay active and mobile.\n\nWhether you're rehabilitating, training, or simply exploring, Muvia Walking brings purposeful movement  and real therapeutic outcomes right to your doorstep.", "short_description": "Experience the joy of walking while improving your mobility and balance. Muvia Walking blends immersive VR environments with therapeutic benefits and real-time feedback, making everyday movement more engaging and accessible - anytime, anywhere."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.muvia.ai/privacy", "developer_terms_of_service_url": "https://www.muvia.ai/terms", "publisher_name": "Muvia Inc. ", "support_website_url": null, "website_url": "https://www.muvia.ai/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "478089301798119"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory
com/v/t64.5771-25/499307433_1106824034679021_2208238346986365142_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bU0Y_vz6Hy0Q7kNvwGIP-Mq&_nc_oc=AdmFbi4dYYxdK28gBEpWoug27kWtdNI2bnkQ-GYcCMwxobffwonaKSMNSnDo76VIQYE&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afxlobhwxa4TkDfHsV6IKSOk-NMQTcZMFSn9dqtQ70fuMg&oe=69B962B5"}, {"file_name": "Screenshot_2880x1600_f911d.png", "id": "1060401919608115", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499307433_1060401922941448_7780354140265136177_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8ivBDg3MIN4Q7kNvwHC501d&_nc_oc=AdnOari9fTAeG03e_xBE1gv52ynS-73eU8UQJtrU4AF1IYG_jLoD716OvaR89F3m5K0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfysAPualromc5_5pWt-sGJuWhVChdQF_0ya10hP9R9Ysg&oe=69B9386F"}, {"file_name": "Screenshot_2880x1600_c1505.png", "id": "1411945193356179", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499296119_1411945196689512_7734998725794814567_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ou_e9AoHkZkQ7kNvwEafdST&_nc_oc=AdmQxbjveiN4dSSR7S1dEFC0yIMYWymXU2lxpj4FPpOGzu_D-y_DxCxb-mO6kjVcjsk&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfxnfH0TN9BC2VGpO9xgvyD3kxby4-H9SzCkXeUAHUKHxg&oe=69B94D34"}, {"file_name": "Screenshot_2880x1600_4c5b1.png", "id": "1068101905502534", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491819396_1068101908835867_3312216196419352187_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=58oVinBwzx8Q7kNvwFK5Bmh&_nc_oc=Adlklf_dh_myjDdaiB8h70tMnWfaKzw33YhH8xt6wCRqj9pp5ZOcnqHQ-hIm1Lt-cCg&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afw-UNwot_0Aw5_P2btmhWMiixMPoEH2ErfHuLfqzmS_Qg&oe=69B95254"}, {"file_name": "Screenshot_2880x1600_4d288.png", "id": "1698872327430738", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499307315_1698872330764071_1141194021950334483_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hKNvoB5pZPgQ7kNvwGUbiwz&_nc_oc=AdnTQI4FPKNX3m42Fnb5tfAcLJW6Ic1K1V3nombCXVQNkIWCDNU8PEs3o1s4Eh5QjHE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_Afxkm0TL3pTR3fusnAG7Vdo7OfZWONwOEoqgBOMIg6uvfA&oe=69B95789"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Muvia Walking", "keywords": ["games", "rehab", "walking", "rehabilitation"], "long_description": "Muvia Walking turns rehabilitation into an empowering journey -blending VR, AI, and natural walking motion to restore mobility and rebuild confidence.\n\nMore than just a fitness tool, Muvia Walking offers a unique blend of gamified therapy and immersive exploration. Set in beautifully rendered virtual environments, users walk through diverse paths, improve gait and posture, and engage in full-body movements that stimulate both body and mind.\n\nDesigned for both clinical and at-home use, each walking session provides real-time feedback and motion tracking - enabling personalized progress for individuals in recovery, those managing chronic conditions, or anyone looking to stay active and mobile.\n\nWhether you're rehabilitating, training, or simply exploring, Muvia Walking brings purposeful movement  and real therapeutic outcomes right to your doorstep.", "short_description": "Experience the joy of walking while improving your mobility and balance. Muvia Walking blends immersive VR environments with therapeutic benefits and real-time feedback, making everyday movement more engaging and accessible - anytime, anywhere."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.muvia.ai/privacy", "developer_terms_of_service_url": "https://www.muvia.ai/terms", "publisher_name": "Muvia Inc. ", "support_website_url": null, "website_url": "https://www.muvia.ai/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "478089301798119"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "int
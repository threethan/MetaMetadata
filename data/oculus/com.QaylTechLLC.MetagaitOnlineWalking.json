://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499307433_1106824034679021_2208238346986365142_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tD4Uq-FUrJkQ7kNvwGRS-Zb&_nc_oc=Ado1MJdNYawEDOmmmd_uK5zpX0078aY0Z0nJH6h-Dvu00Bg5sb4JawuidQ8bOp6JPo8&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLSxsF4Z0_zDwW-JDiwxjvV0twxjKKIjjC4Oe5is8SxIw&oe=6AAD4835"}, {"file_name": "Screenshot_2880x1600_f911d.png", "id": "1060401919608115", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499307433_1060401922941448_7780354140265136177_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j1rKgo_YqwYQ7kNvwGZZE5_&_nc_oc=Adrs-95mly3h_L8xfhyJSLsNWJAe0ScyQWYTHnQ3wKhS5zyGYuLiureurZBFraHo2SI&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKxlU6rp5OMljoFhr_v--Cfnzb_6z8Uu-hdFVD0JSv7rw&oe=6AAD562F"}, {"file_name": "Screenshot_2880x1600_c1505.png", "id": "1411945193356179", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499296119_1411945196689512_7734998725794814567_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9uIJnXSEFDcQ7kNvwHLYclF&_nc_oc=Adou9FAfojE38CWRAGRyyncR-9U20WMb5daQrBTQVGgqKtDXbCNBO7seL0hUBA7Ifa8&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJDbZkw3DWQhN629J1h-b2s7tdfrx2cf_KIqAc0wg5kuQ&oe=6AAD32B4"}, {"file_name": "Screenshot_2880x1600_4c5b1.png", "id": "1068101905502534", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/491819396_1068101908835867_3312216196419352187_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BbBg-Ihy77wQ7kNvwEI2yF4&_nc_oc=AdocPyGjSEWwXe0norJSeyXNbruRYa8ewHEcuxu_4NU81O42Xi_1kEWOLco9LdbDtyc&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ4flCScHedTu9BFZnrG89__-dPOLxOQqklgwsQWp811Q&oe=6AAD37D4"}, {"file_name": "Screenshot_2880x1600_4d288.png", "id": "1698872327430738", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499307315_1698872330764071_1141194021950334483_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qQP4dVCBWoIQ7kNvwGGG_BK&_nc_oc=Adq81eu37yhFSZCecXUhRIgF7YI2rhJGY9ZP9mztiB361Xvf5nfFfo8Vxcywhmabhlk&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIUclpJ53CcRECcMDGwOmpe00_KdwksC7RP6-0yXFFT_Q&oe=6AAD3D09"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Muvia Walking", "keywords": ["games", "rehab", "walking", "rehabilitation"], "long_description": "Muvia Walking turns rehabilitation into an empowering journey -blending VR, AI, and natural walking motion to restore mobility and rebuild confidence.\n\nMore than just a fitness tool, Muvia Walking offers a unique blend of gamified therapy and immersive exploration. Set in beautifully rendered virtual environments, users walk through diverse paths, improve gait and posture, and engage in full-body movements that stimulate both body and mind.\n\nDesigned for both clinical and at-home use, each walking session provides real-time feedback and motion tracking - enabling personalized progress for individuals in recovery, those managing chronic conditions, or anyone looking to stay active and mobile.\n\nWhether you're rehabilitating, training, or simply exploring, Muvia Walking brings purposeful movement  and real therapeutic outcomes right to your doorstep.", "short_description": "Experience the joy of walking while improving your mobility and balance. Muvia Walking blends immersive VR environments with therapeutic benefits and real-time feedback, making everyday movement more engaging and accessible - anytime, anywhere."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.muvia.ai/privacy", "developer_terms_of_service_url": "https://www.muvia.ai/terms", "publisher_name": "Muvia Inc. ", "support_website_url": null, "website_url": "https://www.muvia.ai/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "478089301798119"}], "external_subscription_type": "NOT_REQU
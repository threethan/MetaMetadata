2_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j7Ob0wEUXqkQ7kNvwFZNPXf&_nc_oc=AdkW0FCwnkz4v2Nw54_CFvV0zn1c65LK84MqyWn_0TM5e29lBgG2vBapMNu4GLPGae0&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfvPHJ01YkCptakw5xaYA-ppdQfTUExMu_FSbbbbNriheQ&oe=69A44AB5"}, {"file_name": "Screenshot_2880x1600_f911d.png", "id": "1060401919608115", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499307433_1060401922941448_7780354140265136177_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NtXsmAs68ksQ7kNvwGKn6CL&_nc_oc=Adme65IvbsOl4E015rNoqDWhGIAEjl93MLtxIwDa88QYYuTKIrecCIWQu4hmmgPRMXE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AfuciTwmg2QuqNGG5F98mlDxhQ0ZoiRDDzTFoVDbvTVchQ&oe=69A4206F"}, {"file_name": "Screenshot_2880x1600_c1505.png", "id": "1411945193356179", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499296119_1411945196689512_7734998725794814567_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JeS0kVU17WIQ7kNvwFFnidP&_nc_oc=AdmkScwSMBUiDqv_DQzcGdozTY4_TlvrO-Us6yLYAP6537TByXNDZtK3icfUDY-hzks&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfsqFuU9feFIObNwvJ5Ha2bZvK7735lJsroZGDcqUgNVeQ&oe=69A43534"}, {"file_name": "Screenshot_2880x1600_4c5b1.png", "id": "1068101905502534", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491819396_1068101908835867_3312216196419352187_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H68pvohLZs8Q7kNvwH-R6GM&_nc_oc=AdlLnI9q5CrosV5rBYhprTp0MYNA0zTsH-yhTrLJrns2F8Oqhe-h4lKv13K2M3iY5Uc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AftE7olFEZiZjOAMJp7UuX4_tOFVy-nWc2h8BRG-Py7EIA&oe=69A43A54"}, {"file_name": "Screenshot_2880x1600_4d288.png", "id": "1698872327430738", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499307315_1698872330764071_1141194021950334483_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mSiKUC_Oe4MQ7kNvwH53Uky&_nc_oc=Adn5Au-rH2_dwFCyZhxJ76lVsXgx_LHfbih1Ih44djG7FslzJz5QjM7z13xi2IMx5E8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_AfulXIVbduEojZaRZAK4Ab-n7QG76PyQvTESYMkktI6eig&oe=69A43F89"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Muvia Walking", "keywords": ["games", "rehab", "walking", "rehabilitation"], "long_description": "Muvia Walking turns rehabilitation into an empowering journey -blending VR, AI, and natural walking motion to restore mobility and rebuild confidence.\n\nMore than just a fitness tool, Muvia Walking offers a unique blend of gamified therapy and immersive exploration. Set in beautifully rendered virtual environments, users walk through diverse paths, improve gait and posture, and engage in full-body movements that stimulate both body and mind.\n\nDesigned for both clinical and at-home use, each walking session provides real-time feedback and motion tracking - enabling personalized progress for individuals in recovery, those managing chronic conditions, or anyone looking to stay active and mobile.\n\nWhether you're rehabilitating, training, or simply exploring, Muvia Walking brings purposeful movement  and real therapeutic outcomes right to your doorstep.", "short_description": "Experience the joy of walking while improving your mobility and balance. Muvia Walking blends immersive VR environments with therapeutic benefits and real-time feedback, making everyday movement more engaging and accessible - anytime, anywhere."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.muvia.ai/privacy", "developer_terms_of_service_url": "https://www.muvia.ai/terms", "publisher_name": "Muvia Inc. ", "support_website_url": null, "website_url": "https://www.muvia.ai/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "478089301798119"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory
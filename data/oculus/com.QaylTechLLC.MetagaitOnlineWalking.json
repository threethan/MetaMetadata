2_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lW1R1zJMbUYQ7kNvwGIq-u-&_nc_oc=AdmAcFxbFMQpXyvQmtPi-pfWehy6PvTssnuYOSGXp5xM-HHPWwlshwdAXQ5DjozkRMQ&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfuM317YFDWagGCwDVlvpv1K8mzhKhqwdvSh_R1dWdqzww&oe=699B1035"}, {"file_name": "Screenshot_2880x1600_f911d.png", "id": "1060401919608115", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499307433_1060401922941448_7780354140265136177_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nHhU-rKLdOUQ7kNvwES-X_M&_nc_oc=AdlKsiRSWXdxs9HmRM_H1KoGafZ7yYqyvpblqf-rignK9QQtuGVoWuZ-Z_s0gj6EMwE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AftsuzYWkiBO6fVwpFpgFO3Ie-IKmMkjvpoqqgtZhzw38Q&oe=699AE5EF"}, {"file_name": "Screenshot_2880x1600_c1505.png", "id": "1411945193356179", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499296119_1411945196689512_7734998725794814567_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HFnxQKoWZLQQ7kNvwGJ1wg6&_nc_oc=Adkzm361zg1yk-vUoPw7cor9DxTYMqcmUkAb4t1qCEWFSCjsiAatGMlKPtkDywihfz8&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfuuQpt9Ox5vYmHwXr_x9MBMnTcY5INua687ySEoL64aaA&oe=699AFAB4"}, {"file_name": "Screenshot_2880x1600_4c5b1.png", "id": "1068101905502534", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491819396_1068101908835867_3312216196419352187_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KB1zNk5OLT8Q7kNvwG5gTwP&_nc_oc=AdnDMzfAk6CTXwiOTPvWnIz8RrjDV2B8bqUHre6xTILyBYv6TNDS36GkJDGtmNBWPMY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AfvEPciTSyOVbo_BQj29lCtA1kVwP8cfArzw79DkgGNt7w&oe=699AFFD4"}, {"file_name": "Screenshot_2880x1600_4d288.png", "id": "1698872327430738", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499307315_1698872330764071_1141194021950334483_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=obvLNLDd3L8Q7kNvwEMGF4O&_nc_oc=Adlb1bCOY9Wk1nLewD1Bt9OAFfnjFlWx_VEgNn7PFHXPtiGlCBOrjlbwDfJQwX4_0CQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_AftUxy5YJy06cGpsKmAzwH6ybADeNM_DSfGLtpQ-V7l7-g&oe=699B0509"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Muvia Walking", "keywords": ["games", "rehab", "walking", "rehabilitation"], "long_description": "Muvia Walking turns rehabilitation into an empowering journey -blending VR, AI, and natural walking motion to restore mobility and rebuild confidence.\n\nMore than just a fitness tool, Muvia Walking offers a unique blend of gamified therapy and immersive exploration. Set in beautifully rendered virtual environments, users walk through diverse paths, improve gait and posture, and engage in full-body movements that stimulate both body and mind.\n\nDesigned for both clinical and at-home use, each walking session provides real-time feedback and motion tracking - enabling personalized progress for individuals in recovery, those managing chronic conditions, or anyone looking to stay active and mobile.\n\nWhether you're rehabilitating, training, or simply exploring, Muvia Walking brings purposeful movement  and real therapeutic outcomes right to your doorstep.", "short_description": "Experience the joy of walking while improving your mobility and balance. Muvia Walking blends immersive VR environments with therapeutic benefits and real-time feedback, making everyday movement more engaging and accessible - anytime, anywhere."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.muvia.ai/privacy", "developer_terms_of_service_url": "https://www.muvia.ai/terms", "publisher_name": "Muvia Inc. ", "support_website_url": null, "website_url": "https://www.muvia.ai/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "478089301798119"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory
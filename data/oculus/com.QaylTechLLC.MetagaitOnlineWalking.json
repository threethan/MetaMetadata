://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499307433_1106824034679021_2208238346986365142_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zmHgdPpRe20Q7kNvwHvhztv&_nc_oc=AdoQa3N5aVPflHSXAurxGscgakN0PYCZh9LqzLcNTbrfw9YHmI2QAQ-TfjUaFRUqDDg&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9ISOGOsTLJuKQWAYivu8EsCIRD2-MmiWslJGZzc5SU6g&oe=6A297235"}, {"file_name": "Screenshot_2880x1600_f911d.png", "id": "1060401919608115", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499307433_1060401922941448_7780354140265136177_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7KWYJTt1HfkQ7kNvwHg8gP7&_nc_oc=Adp66WR9D_KRAAswqwGpxemPM_0K6X2TpbS6IIaT5qZIE3U1_X74SZxkJE3iKFzGR_Q&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_GamxUGfA-Kk_QiJjqUl2ssn7hVFuQxnSZKJkXCBQimg&oe=6A29802F"}, {"file_name": "Screenshot_2880x1600_c1505.png", "id": "1411945193356179", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499296119_1411945196689512_7734998725794814567_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ylGPQ_tPFkIQ7kNvwE_qmEc&_nc_oc=AdpuTUoMQqXIeQAZSVsxFniINqM6LnABA_CmLKPTmeX5EKCM21BnnVTSOY0egbTRMF0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9fTB9Oc1PPBO1NdmUHPKxS5q30xtKwMPs51Y7PANTTaQ&oe=6A295CB4"}, {"file_name": "Screenshot_2880x1600_4c5b1.png", "id": "1068101905502534", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491819396_1068101908835867_3312216196419352187_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P3MPjwDbhVcQ7kNvwFkK8xc&_nc_oc=AdrBd1aZZwPt41DFbFgdwato088Hl1dYz8CQ8nxj3qb1ozhIqsZU7Nf9f5pK0h8njIk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9e9kOAK3mbuNEZTpohCnAlnP0w5YPdqcCVzfMIDZ2YSg&oe=6A2961D4"}, {"file_name": "Screenshot_2880x1600_4d288.png", "id": "1698872327430738", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499307315_1698872330764071_1141194021950334483_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s1XZLh1q-ZsQ7kNvwE_qORH&_nc_oc=AdooYPBq3lWYMY7EMyNSCELFmPu8Oxs_iLwZq-S8Qw8kTmGO8U_i5oCqxaP9dO1vT04&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_tQYCVvgqR4rGjGpuZe-ADKY6imM2-PMMIBiv254xKYQ&oe=6A296709"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Muvia Walking", "keywords": ["games", "rehab", "walking", "rehabilitation"], "long_description": "Muvia Walking turns rehabilitation into an empowering journey -blending VR, AI, and natural walking motion to restore mobility and rebuild confidence.\n\nMore than just a fitness tool, Muvia Walking offers a unique blend of gamified therapy and immersive exploration. Set in beautifully rendered virtual environments, users walk through diverse paths, improve gait and posture, and engage in full-body movements that stimulate both body and mind.\n\nDesigned for both clinical and at-home use, each walking session provides real-time feedback and motion tracking - enabling personalized progress for individuals in recovery, those managing chronic conditions, or anyone looking to stay active and mobile.\n\nWhether you're rehabilitating, training, or simply exploring, Muvia Walking brings purposeful movement  and real therapeutic outcomes right to your doorstep.", "short_description": "Experience the joy of walking while improving your mobility and balance. Muvia Walking blends immersive VR environments with therapeutic benefits and real-time feedback, making everyday movement more engaging and accessible - anytime, anywhere."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.muvia.ai/privacy", "developer_terms_of_service_url": "https://www.muvia.ai/terms", "publisher_name": "Muvia Inc. ", "support_website_url": null, "website_url": "https://www.muvia.ai/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "478089301798119"}], "external_subscription_type": "NOT_REQU
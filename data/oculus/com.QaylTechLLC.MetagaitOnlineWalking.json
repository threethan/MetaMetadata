://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499307433_1106824034679021_2208238346986365142_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kLllcn4Qb3sQ7kNvwFoc5qi&_nc_oc=AdqyO7eDIrVooKZ7kJ1glRBslUZqaSV4muDG0VQnVnvEm8REdb-DwL1-NDBrF-d3Q6w&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzsdlWzKXBTpmUjpzGKd1zopOHiMkN-RfkD0dfI23QCYw&oe=69CE7AB5"}, {"file_name": "Screenshot_2880x1600_f911d.png", "id": "1060401919608115", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499307433_1060401922941448_7780354140265136177_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jO28ouIJAOkQ7kNvwHWs6re&_nc_oc=AdoQiFWqEJwRG_WiE0BSY4mHKLUZGEsjmPZ9yrV1VR42VbaaPODtw0ynzbUlDbars8w&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afy0V3PSoDgDd-VHt2INwjZHgVXM-HZB2C0ObgqHBxZm4w&oe=69CE506F"}, {"file_name": "Screenshot_2880x1600_c1505.png", "id": "1411945193356179", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499296119_1411945196689512_7734998725794814567_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WtBVoNVNC7EQ7kNvwHuvNEf&_nc_oc=AdopVKXsGfBNtofoyv60BnILKiHcUNd2mwaMM7HodLaC_4Wmfkx3jBVWq0yZQpOYqgM&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzHSiqgYcuI2-Iot_fROb_8npoYtA5rMlORqx_KVgGgOQ&oe=69CE6534"}, {"file_name": "Screenshot_2880x1600_4c5b1.png", "id": "1068101905502534", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491819396_1068101908835867_3312216196419352187_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FfVeQbh_vNoQ7kNvwFvnYa_&_nc_oc=Adqu9dCX1jJxe-3ymBR5IvJ9f5qkBo7eyJs8zroSSXfj_bb0Cn1Upjdqb2qnjvp0SHA&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzdtXxSwTig3V7cLho5tXV6ntZaXOfUv39CVhhJLp73AA&oe=69CE6A54"}, {"file_name": "Screenshot_2880x1600_4d288.png", "id": "1698872327430738", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499307315_1698872330764071_1141194021950334483_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-6NgUP_BOZMQ7kNvwGbbS92&_nc_oc=AdrtSdX8zbc4LEMGuxg-yi6gG4u_l9gfUZR3qmk0CT0y3RrPckjTXegU-DI5KrZqBg8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzOZgdu0VEvBKEP22Q6QZSZ96SZoKMn-H_uSM8RCey5Vw&oe=69CE6F89"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Muvia Walking", "keywords": ["games", "rehab", "walking", "rehabilitation"], "long_description": "Muvia Walking turns rehabilitation into an empowering journey -blending VR, AI, and natural walking motion to restore mobility and rebuild confidence.\n\nMore than just a fitness tool, Muvia Walking offers a unique blend of gamified therapy and immersive exploration. Set in beautifully rendered virtual environments, users walk through diverse paths, improve gait and posture, and engage in full-body movements that stimulate both body and mind.\n\nDesigned for both clinical and at-home use, each walking session provides real-time feedback and motion tracking - enabling personalized progress for individuals in recovery, those managing chronic conditions, or anyone looking to stay active and mobile.\n\nWhether you're rehabilitating, training, or simply exploring, Muvia Walking brings purposeful movement  and real therapeutic outcomes right to your doorstep.", "short_description": "Experience the joy of walking while improving your mobility and balance. Muvia Walking blends immersive VR environments with therapeutic benefits and real-time feedback, making everyday movement more engaging and accessible - anytime, anywhere."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.muvia.ai/privacy", "developer_terms_of_service_url": "https://www.muvia.ai/terms", "publisher_name": "Muvia Inc. ", "support_website_url": null, "website_url": "https://www.muvia.ai/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "478089301798119"}], "external_subscription_type": "NOT_REQU
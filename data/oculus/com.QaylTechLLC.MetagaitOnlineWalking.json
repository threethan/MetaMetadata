://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/499307433_1106824034679021_2208238346986365142_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BOI3heREaE4Q7kNvwFaNkT0&_nc_oc=AdorhYxffZ_LpzNmb0_WMn97eXo_TPGFurDv-gY1UFbZS1AbLd3W8NIYz-EKLJChyiY&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD1FKMxZGKaHiDmhCrSrw8RPDF03wlE3NbRXqbc2LoErQ&oe=6A564535"}, {"file_name": "Screenshot_2880x1600_f911d.png", "id": "1060401919608115", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/499307433_1060401922941448_7780354140265136177_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ga1WH62gsnkQ7kNvwFJIBEQ&_nc_oc=AdqZNff6_MDj778cpyIkQOXeNJdfa5GiG_NZpcjbFCFFUXyYE9d-f9AOjgg4Q42tPvk&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDFTQaTIB6S_RLCvckWn9rG5kUTr8Qo1VjqCvbvea05AA&oe=6A56532F"}, {"file_name": "Screenshot_2880x1600_c1505.png", "id": "1411945193356179", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/499296119_1411945196689512_7734998725794814567_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o4bWHdjTi7oQ7kNvwFIcPxz&_nc_oc=AdrTIIhaCE3ORozVNwxrua87BCn79D55YCCNeZMEO67JiLMwlKNmF1c6Q1CjNJeAVTE&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAqylqrYc-6PVn6yl765W7P9pkylNAtz18c3Rm6OV5tEg&oe=6A562FB4"}, {"file_name": "Screenshot_2880x1600_4c5b1.png", "id": "1068101905502534", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/491819396_1068101908835867_3312216196419352187_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1Iq3QkEVUqEQ7kNvwHiAUj6&_nc_oc=Ado_Pmp6cfEEX9-i_Dwd4KFOUBV1QPb3k9be7UzOhMWZGx3SY557DR8yMf-ld02ATc4&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD1qEFMO7CaKEoYdiQAdGIH_MhEsWdT6e4qwKS64tvN8w&oe=6A5634D4"}, {"file_name": "Screenshot_2880x1600_4d288.png", "id": "1698872327430738", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/499307315_1698872330764071_1141194021950334483_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yvaywFWftywQ7kNvwEV8757&_nc_oc=AdpWWjN6J78pjZycQQ_OSiKLD0z5EoMmOIF8OCIjSwUgvIKE8Tvv9D-rg58MATRjxz8&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCzaSYM8zBpJ00UyVAfKa77PWi6z5ftI_yOdiarIFOa9A&oe=6A563A09"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Muvia Walking", "keywords": ["games", "rehab", "walking", "rehabilitation"], "long_description": "Muvia Walking turns rehabilitation into an empowering journey -blending VR, AI, and natural walking motion to restore mobility and rebuild confidence.\n\nMore than just a fitness tool, Muvia Walking offers a unique blend of gamified therapy and immersive exploration. Set in beautifully rendered virtual environments, users walk through diverse paths, improve gait and posture, and engage in full-body movements that stimulate both body and mind.\n\nDesigned for both clinical and at-home use, each walking session provides real-time feedback and motion tracking - enabling personalized progress for individuals in recovery, those managing chronic conditions, or anyone looking to stay active and mobile.\n\nWhether you're rehabilitating, training, or simply exploring, Muvia Walking brings purposeful movement  and real therapeutic outcomes right to your doorstep.", "short_description": "Experience the joy of walking while improving your mobility and balance. Muvia Walking blends immersive VR environments with therapeutic benefits and real-time feedback, making everyday movement more engaging and accessible - anytime, anywhere."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.muvia.ai/privacy", "developer_terms_of_service_url": "https://www.muvia.ai/terms", "publisher_name": "Muvia Inc. ", "support_website_url": null, "website_url": "https://www.muvia.ai/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "478089301798119"}], "external_subscription_type": "NOT_REQU
://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499307433_1106824034679021_2208238346986365142_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gSYMEayaoCoQ7kNvwE1CsJo&_nc_oc=AdrgECqyjXOHljAe3-GjfDABPo9PMrCnSgtOvsGnEny8qeoX8s5TcreXtQ9lqEllpNI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPW--rz0XmApy-s3ckYZm8DuDoVSckcaT2pRoS2RYaUsg&oe=6ADF6135"}, {"file_name": "Screenshot_2880x1600_f911d.png", "id": "1060401919608115", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499307433_1060401922941448_7780354140265136177_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CS8YmvQqkRAQ7kNvwFk4cbY&_nc_oc=Adq7uy2XDWoXudpKbYCwC_duAfqBnKWHmrpYSCtc4Efz60MEg0AF_N2oSELm4oTkiOo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNd9Ip4SOA9dspu3-vurTmo-l-Zs-R5c-7jyGG_a70IMg&oe=6ADF6F2F"}, {"file_name": "Screenshot_2880x1600_c1505.png", "id": "1411945193356179", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499296119_1411945196689512_7734998725794814567_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1pGr1edNproQ7kNvwGZaYKF&_nc_oc=AdrK2vuxbWJnwOLhpJZijURwoQH9DkHal35lXlNWlHKU7eAbcCWK4nAFxG_DGFhrnCc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMNYtZjZNn4qDI9hHF9Faz4HaybuygMAKKnMCl0ANUzlw&oe=6ADF4BB4"}, {"file_name": "Screenshot_2880x1600_4c5b1.png", "id": "1068101905502534", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491819396_1068101908835867_3312216196419352187_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-mPzceBdHwcQ7kNvwHRbfvJ&_nc_oc=AdoY2Kzf33sy69gb3sby7zlYkfjVEf_dwLi3hYqQAzr4BdrF-WVLwZwIVhblofqixg0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNSMee3adryjGGdzcKPuNHVbqMaPIoihObZs_clFly65w&oe=6ADF50D4"}, {"file_name": "Screenshot_2880x1600_4d288.png", "id": "1698872327430738", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499307315_1698872330764071_1141194021950334483_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Qxnmn4LrzmgQ7kNvwHtp4yy&_nc_oc=AdpnfJ5Yu0wjVL7TvcqD7asykennVDTSPK3nAlPM-4s66Xm_-qAfPXj3_bLgBNJ0w30&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNcY3ecHDpVJhvfUpm1Lk0P6Yax9hp7z04TBdTgN3VFWw&oe=6ADF5609"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Muvia Walking", "keywords": ["games", "rehab", "walking", "rehabilitation"], "long_description": "Muvia Walking turns rehabilitation into an empowering journey -blending VR, AI, and natural walking motion to restore mobility and rebuild confidence.\n\nMore than just a fitness tool, Muvia Walking offers a unique blend of gamified therapy and immersive exploration. Set in beautifully rendered virtual environments, users walk through diverse paths, improve gait and posture, and engage in full-body movements that stimulate both body and mind.\n\nDesigned for both clinical and at-home use, each walking session provides real-time feedback and motion tracking - enabling personalized progress for individuals in recovery, those managing chronic conditions, or anyone looking to stay active and mobile.\n\nWhether you're rehabilitating, training, or simply exploring, Muvia Walking brings purposeful movement  and real therapeutic outcomes right to your doorstep.", "short_description": "Experience the joy of walking while improving your mobility and balance. Muvia Walking blends immersive VR environments with therapeutic benefits and real-time feedback, making everyday movement more engaging and accessible - anytime, anywhere."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.muvia.ai/privacy", "developer_terms_of_service_url": "https://www.muvia.ai/terms", "publisher_name": "Muvia Inc. ", "support_website_url": null, "website_url": "https://www.muvia.ai/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "478089301798119"}], "external_subscription_type": "NOT_REQU
://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/499307433_1106824034679021_2208238346986365142_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Hg6r-q7gz1QQ7kNvwF-lOrO&_nc_oc=AdqGtB5DhObUm42vDNHb_0iTDik5BEfAE7KmzJi8C1pjJHwOy4YjyGhHOC6A88nqZEw&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7Ac_7UOVX2oTKK6q2qmVFECNB03xjXlwCyXYYQWnlPdw&oe=6A1AF1B5"}, {"file_name": "Screenshot_2880x1600_f911d.png", "id": "1060401919608115", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/499307433_1060401922941448_7780354140265136177_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RY02JhF45kkQ7kNvwEQbaBa&_nc_oc=AdrMadVYu_bQ-xgCBeY5HejLRN7oQFbF0igE0mJwW-bKEGw9tgojkSggEyp0LWmolUg&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5_e78F361Ko4jzC-8aGAzw-mhvijxnIWwIllgmqYj6pw&oe=6A1AFFAF"}, {"file_name": "Screenshot_2880x1600_c1505.png", "id": "1411945193356179", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/499296119_1411945196689512_7734998725794814567_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uxQAvGknB4EQ7kNvwHYditL&_nc_oc=AdoDwbbm1aAgt5zVXYRO7JpOOXhGCKda4nDdmmASo70Pu4Y4DSr65pknyjDjf2Iuu8k&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af42GiSDk1lVEF_fpTPtsDxi-EJ5HL0Tkj_VeuBwP7_psg&oe=6A1ADC34"}, {"file_name": "Screenshot_2880x1600_4c5b1.png", "id": "1068101905502534", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/491819396_1068101908835867_3312216196419352187_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7SXcdmLmmFoQ7kNvwG8cJHZ&_nc_oc=AdqSuZGrh_QOv6VXO-5BexGTAipnGQy_TRFLRCga80nnkEmGgW7Bii-Pc9libNMoeno&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5r0AxgVLoMB_cP6HuHE9UoRXPv9llDMvLmoz803T_azg&oe=6A1AE154"}, {"file_name": "Screenshot_2880x1600_4d288.png", "id": "1698872327430738", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/499307315_1698872330764071_1141194021950334483_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f5AuDKixqo0Q7kNvwFUBftb&_nc_oc=Ado1w7ykOUII3SyTqeQTYEnxJUb2qmagjHAn0-YCW8jmImhja68By0Usy2I4VIhbOn0&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6GnJTfUx4sKT-PMoATO456Hi3JRQwFUo2BKMEMBCtRYw&oe=6A1AE689"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Muvia Walking", "keywords": ["games", "rehab", "walking", "rehabilitation"], "long_description": "Muvia Walking turns rehabilitation into an empowering journey -blending VR, AI, and natural walking motion to restore mobility and rebuild confidence.\n\nMore than just a fitness tool, Muvia Walking offers a unique blend of gamified therapy and immersive exploration. Set in beautifully rendered virtual environments, users walk through diverse paths, improve gait and posture, and engage in full-body movements that stimulate both body and mind.\n\nDesigned for both clinical and at-home use, each walking session provides real-time feedback and motion tracking - enabling personalized progress for individuals in recovery, those managing chronic conditions, or anyone looking to stay active and mobile.\n\nWhether you're rehabilitating, training, or simply exploring, Muvia Walking brings purposeful movement  and real therapeutic outcomes right to your doorstep.", "short_description": "Experience the joy of walking while improving your mobility and balance. Muvia Walking blends immersive VR environments with therapeutic benefits and real-time feedback, making everyday movement more engaging and accessible - anytime, anywhere."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.muvia.ai/privacy", "developer_terms_of_service_url": "https://www.muvia.ai/terms", "publisher_name": "Muvia Inc. ", "support_website_url": null, "website_url": "https://www.muvia.ai/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "478089301798119"}], "external_subscription_type": "NOT_REQU
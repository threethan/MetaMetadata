://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499307433_1106824034679021_2208238346986365142_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UduPU5xGTD4Q7kNvwF5FJOR&_nc_oc=Adp7Xff5YnfBMR3KngkrMnH3pM0BA4vUautPZnvIjQDNRzwj7BefKSLGjunHDxkroP0&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af40Pv1VLnq0B-zvAaPEGrhP7oaDX81_1ZNA_EFAQyAy6g&oe=6A072B35"}, {"file_name": "Screenshot_2880x1600_f911d.png", "id": "1060401919608115", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499307433_1060401922941448_7780354140265136177_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a1tsdiD3hY8Q7kNvwG_FD6A&_nc_oc=AdpCtxdYRmhr_KSScgu7Y4xAnr4mweezNdaMinra1JifVUyUjen8WePlZBp702rXEno&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7lCs7kcWRJlzxqGxeuTsGCh_WghK9r6WqL_TIOPAZ7ew&oe=6A07392F"}, {"file_name": "Screenshot_2880x1600_c1505.png", "id": "1411945193356179", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499296119_1411945196689512_7734998725794814567_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QtqRZwl3fuEQ7kNvwEsSuF6&_nc_oc=AdpI3ZqtJLm_RRKHivNRumx575UYvI7671lpBMDKaZb29hBsO9IVfE_CHoGSo_XpzY0&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4wRlM1MArAcSQnKaQWeqSlnnTRM6QztHik3FaOhC9z_w&oe=6A0715B4"}, {"file_name": "Screenshot_2880x1600_4c5b1.png", "id": "1068101905502534", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491819396_1068101908835867_3312216196419352187_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a-9yIOxu6O8Q7kNvwH_KZUM&_nc_oc=AdowXD_-iRK73ax0tLEVKaHKrbTo8pLzA_E3B1C0FXUWsOF4ndu7-CTz-sxxOUvuIAM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5C6pnIEivKW-sJYwUTmwD9FHPQWYeJo8JMfVRkb0kQfQ&oe=6A071AD4"}, {"file_name": "Screenshot_2880x1600_4d288.png", "id": "1698872327430738", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499307315_1698872330764071_1141194021950334483_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xKZCzUNpFBQQ7kNvwFR6pNY&_nc_oc=Adru7XRYMeV-ZAz2CvExPOtRUGEKB_KO93zZ8wDFbtppUOCukT01WZAIPpehfgWxQ04&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6RSCRe2n-Rqw3lS61RbgvcM_J4Qb2JGhtkAXTk3HfnUg&oe=6A072009"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Muvia Walking", "keywords": ["games", "rehab", "walking", "rehabilitation"], "long_description": "Muvia Walking turns rehabilitation into an empowering journey -blending VR, AI, and natural walking motion to restore mobility and rebuild confidence.\n\nMore than just a fitness tool, Muvia Walking offers a unique blend of gamified therapy and immersive exploration. Set in beautifully rendered virtual environments, users walk through diverse paths, improve gait and posture, and engage in full-body movements that stimulate both body and mind.\n\nDesigned for both clinical and at-home use, each walking session provides real-time feedback and motion tracking - enabling personalized progress for individuals in recovery, those managing chronic conditions, or anyone looking to stay active and mobile.\n\nWhether you're rehabilitating, training, or simply exploring, Muvia Walking brings purposeful movement  and real therapeutic outcomes right to your doorstep.", "short_description": "Experience the joy of walking while improving your mobility and balance. Muvia Walking blends immersive VR environments with therapeutic benefits and real-time feedback, making everyday movement more engaging and accessible - anytime, anywhere."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.muvia.ai/privacy", "developer_terms_of_service_url": "https://www.muvia.ai/terms", "publisher_name": "Muvia Inc. ", "support_website_url": null, "website_url": "https://www.muvia.ai/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "478089301798119"}], "external_subscription_type": "NOT_REQU
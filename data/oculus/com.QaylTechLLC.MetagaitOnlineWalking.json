://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499307433_1106824034679021_2208238346986365142_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jBWbSf7rQvwQ7kNvwEmZgER&_nc_oc=AdoB2NzRT2AHbMw_enwKX0qO6425j3I2Zq4Yc1rDCly8RZ7FR39SCzowRoN9f7E1Jrw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJhXzCGHnYP1gnBI3NrnTtEO691STwCmQpUhulDtgmjUg&oe=6ABBC8B5"}, {"file_name": "Screenshot_2880x1600_f911d.png", "id": "1060401919608115", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499307433_1060401922941448_7780354140265136177_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vgNcFzIhTnAQ7kNvwEkLHBR&_nc_oc=AdrTng2Y7KHemPxNjXKzlThly1RYSpw2ffC4_AexqvwsntKy3HHOZyasWWa2MeVF7fM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKBwubjDVHEdHruunULnWTrdGE17Q0LSo2thRqnXI-HJw&oe=6ABBD6AF"}, {"file_name": "Screenshot_2880x1600_c1505.png", "id": "1411945193356179", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499296119_1411945196689512_7734998725794814567_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eckR2oVDz6QQ7kNvwEukn1O&_nc_oc=Ado1O4bLhFLOUhxfHw7yBDhShGO4uOIew3eud6U8_WN7vdYt4_zC-PXaMCI2300GU9Y&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLExRFzKE5o4Btbh_eQ0C8VWFzgCi6rPERbRhFVgrONWg&oe=6ABBB334"}, {"file_name": "Screenshot_2880x1600_4c5b1.png", "id": "1068101905502534", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491819396_1068101908835867_3312216196419352187_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uwNJnU8INb8Q7kNvwGi1eyx&_nc_oc=Adqt_PJ1Wwqsbm5qsarPghpM_7WMx9lQ9ER16-1OZm_LZz1PV2pWgSuRKJAzQMrSu7w&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIMYzRKDvujkDKt0p75UMppCc9pux9KWju_aNFo82Mrrw&oe=6ABBB854"}, {"file_name": "Screenshot_2880x1600_4d288.png", "id": "1698872327430738", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499307315_1698872330764071_1141194021950334483_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nN0tKZhqOscQ7kNvwGwrCkj&_nc_oc=AdpmZczKNEgIa9i9-QL31yo4x-K7ycRkGsmjdWMMgum50LSBXtaxvMO8_iVOoz3pljs&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIVUDZ7lmdCaJi1XrcPNM_7PhECITTMNoFOF-dAh-84rw&oe=6ABBBD89"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Muvia Walking", "keywords": ["games", "rehab", "walking", "rehabilitation"], "long_description": "Muvia Walking turns rehabilitation into an empowering journey -blending VR, AI, and natural walking motion to restore mobility and rebuild confidence.\n\nMore than just a fitness tool, Muvia Walking offers a unique blend of gamified therapy and immersive exploration. Set in beautifully rendered virtual environments, users walk through diverse paths, improve gait and posture, and engage in full-body movements that stimulate both body and mind.\n\nDesigned for both clinical and at-home use, each walking session provides real-time feedback and motion tracking - enabling personalized progress for individuals in recovery, those managing chronic conditions, or anyone looking to stay active and mobile.\n\nWhether you're rehabilitating, training, or simply exploring, Muvia Walking brings purposeful movement  and real therapeutic outcomes right to your doorstep.", "short_description": "Experience the joy of walking while improving your mobility and balance. Muvia Walking blends immersive VR environments with therapeutic benefits and real-time feedback, making everyday movement more engaging and accessible - anytime, anywhere."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.muvia.ai/privacy", "developer_terms_of_service_url": "https://www.muvia.ai/terms", "publisher_name": "Muvia Inc. ", "support_website_url": null, "website_url": "https://www.muvia.ai/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "478089301798119"}], "external_subscription_type": "NOT_REQU
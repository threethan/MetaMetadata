://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499307433_1106824034679021_2208238346986365142_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2LhPaOvELIoQ7kNvwFNY8d5&_nc_oc=Ado6GZNrrLlpQ2yPNJ6Ehaxve-qM3KMjAGfgSPbKeMHRblRwPTSsb7OOXoKhToXVPFg&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2Iu2bYHOHqND7O_XY1riVVkaILO6Qh3Tj9R0VuSzPhJQ&oe=69EB7BB5"}, {"file_name": "Screenshot_2880x1600_f911d.png", "id": "1060401919608115", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499307433_1060401922941448_7780354140265136177_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3Oq-jRHPmFEQ7kNvwHSgXD8&_nc_oc=AdrCiCt-G6pxjlR3wsHsMlV9dBguYLhow4oJDd8YNZ-ZrF3bDWQNUx9k2fHfChCc82M&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3QstSJeEQT5JdBZuJ-dYaiyK9abNEEVAPBCLxsAP7SOw&oe=69EB89AF"}, {"file_name": "Screenshot_2880x1600_c1505.png", "id": "1411945193356179", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499296119_1411945196689512_7734998725794814567_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lDPKRlEg1_wQ7kNvwHmktq9&_nc_oc=Adoy8xf9LiW2ttGRBvpfiKn9lbcL1Bdx2Xe1CFQlLy58_5zb3iDcGCLcLTKYyw1IT50&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0W6NG4F961pn7H8ULqhwSspeso6WMHIv6wGw1lSCvK_w&oe=69EB6634"}, {"file_name": "Screenshot_2880x1600_4c5b1.png", "id": "1068101905502534", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491819396_1068101908835867_3312216196419352187_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cYcfljGY1yEQ7kNvwEeybGT&_nc_oc=AdqLlQrkMwxflnl6tb806plPhNa_Cb3a3oapQcaWmg3wvxbM9TagX5DQiMY4XISRBFw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1HZ1KDLCAq2NxfN8sXnHWgVDyPFv_aIN6ESsBnCt_phw&oe=69EB6B54"}, {"file_name": "Screenshot_2880x1600_4d288.png", "id": "1698872327430738", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499307315_1698872330764071_1141194021950334483_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nhqJBSN180UQ7kNvwGS45kJ&_nc_oc=AdqoN94hKuLIh2JTya63qOerYM48iW4U3nv8-56nFgnnDwSwrwIkq9bUsqsAbYb9yEg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1eu5qvZD1t4ZK-XoY8ML84BL9kJrILi1xTmWOy4ZXnCQ&oe=69EB7089"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Muvia Walking", "keywords": ["games", "rehab", "walking", "rehabilitation"], "long_description": "Muvia Walking turns rehabilitation into an empowering journey -blending VR, AI, and natural walking motion to restore mobility and rebuild confidence.\n\nMore than just a fitness tool, Muvia Walking offers a unique blend of gamified therapy and immersive exploration. Set in beautifully rendered virtual environments, users walk through diverse paths, improve gait and posture, and engage in full-body movements that stimulate both body and mind.\n\nDesigned for both clinical and at-home use, each walking session provides real-time feedback and motion tracking - enabling personalized progress for individuals in recovery, those managing chronic conditions, or anyone looking to stay active and mobile.\n\nWhether you're rehabilitating, training, or simply exploring, Muvia Walking brings purposeful movement  and real therapeutic outcomes right to your doorstep.", "short_description": "Experience the joy of walking while improving your mobility and balance. Muvia Walking blends immersive VR environments with therapeutic benefits and real-time feedback, making everyday movement more engaging and accessible - anytime, anywhere."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.muvia.ai/privacy", "developer_terms_of_service_url": "https://www.muvia.ai/terms", "publisher_name": "Muvia Inc. ", "support_website_url": null, "website_url": "https://www.muvia.ai/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "478089301798119"}], "external_subscription_type": "NOT_REQU
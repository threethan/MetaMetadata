://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499307433_1106824034679021_2208238346986365142_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iyePqf_5pzgQ7kNvwEXpehM&_nc_oc=AdoLZsS1rDwvhEfxo4zgB46v3iWxkUuPizHGvtPA1CvcjFGp99CL242B7njvph50tNs&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-tBucQczC2HUacKe1ucbJjTXbuAx7VHayKQv6iQGRvhw&oe=6A3E8A35"}, {"file_name": "Screenshot_2880x1600_f911d.png", "id": "1060401919608115", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499307433_1060401922941448_7780354140265136177_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iJ24aqh5M_QQ7kNvwEp33e_&_nc_oc=AdohDAxX_xORm1uLf8NULZIPkvaOztEMFyTKvCX7eqtuCzcnHhSUAYiYNrJGdPCi2_Y&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8IdbGN8QCIiwlPfOX8xRaktoSKv7kb39N750wCi0T7Xg&oe=6A3E982F"}, {"file_name": "Screenshot_2880x1600_c1505.png", "id": "1411945193356179", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499296119_1411945196689512_7734998725794814567_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dvM7Yucmg2UQ7kNvwGfQlmr&_nc_oc=AdrfsZAyZuyGKTjUNuPF5fFM6cbyvAt90u-YdkR-EblvzO9MQ9IGblp9_rIUO5Qrp64&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-pfQDh19FLGpdCKlI_hnvlEI1kpJ_6gQTcov7rDIbsXg&oe=6A3EACF4"}, {"file_name": "Screenshot_2880x1600_4c5b1.png", "id": "1068101905502534", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491819396_1068101908835867_3312216196419352187_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lXMd6G3lWbQQ7kNvwEGY-AW&_nc_oc=Adob5CLm-QnwQ2QTUjdbfuxfDqZiEs95k7nUJFdxzeDhqMtlwNuGYsRpn3y_0mgw8bg&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-ZoCWaiLzR7k6rkV-T3q6dtFbR5WsFPyDL8CFizrAivw&oe=6A3EB214"}, {"file_name": "Screenshot_2880x1600_4d288.png", "id": "1698872327430738", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499307315_1698872330764071_1141194021950334483_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u6A_7IC_jLcQ7kNvwGoym6D&_nc_oc=Adqatsycwk0UGbXqQefqktHet_xSpw9lK6MntR-up-APUS456-0qa2REEFjV1YDxyMU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8unrbz9NEWA_kd6lY9C-V0_Ea_txzCvAT3JrIXb0YFDQ&oe=6A3E7F09"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Muvia Walking", "keywords": ["games", "rehab", "walking", "rehabilitation"], "long_description": "Muvia Walking turns rehabilitation into an empowering journey -blending VR, AI, and natural walking motion to restore mobility and rebuild confidence.\n\nMore than just a fitness tool, Muvia Walking offers a unique blend of gamified therapy and immersive exploration. Set in beautifully rendered virtual environments, users walk through diverse paths, improve gait and posture, and engage in full-body movements that stimulate both body and mind.\n\nDesigned for both clinical and at-home use, each walking session provides real-time feedback and motion tracking - enabling personalized progress for individuals in recovery, those managing chronic conditions, or anyone looking to stay active and mobile.\n\nWhether you're rehabilitating, training, or simply exploring, Muvia Walking brings purposeful movement  and real therapeutic outcomes right to your doorstep.", "short_description": "Experience the joy of walking while improving your mobility and balance. Muvia Walking blends immersive VR environments with therapeutic benefits and real-time feedback, making everyday movement more engaging and accessible - anytime, anywhere."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.muvia.ai/privacy", "developer_terms_of_service_url": "https://www.muvia.ai/terms", "publisher_name": "Muvia Inc. ", "support_website_url": null, "website_url": "https://www.muvia.ai/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "478089301798119"}], "external_subscription_type": "NOT_REQU
://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499307433_1106824034679021_2208238346986365142_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VTyjUGL2cWwQ7kNvwFZgUVp&_nc_oc=Adp8gWcK_-BIrOONjYYjZjeeBXyuo4CqB2JWbD9-tAorhOCrhpMSImsPfM6jyq1-Z-c&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCtM4FSPMIhbEF95O4BhjNyn9jtD-xY7alPq98xa6pHpA&oe=6A6F51B5"}, {"file_name": "Screenshot_2880x1600_f911d.png", "id": "1060401919608115", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499307433_1060401922941448_7780354140265136177_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ou5Y6Il4DZIQ7kNvwH6T6uh&_nc_oc=AdoqIJecls4MoreHWt0veyWOGJtd9O6B9scUFrB0Y4c25a-3tde9VHXYMTcuAi91Aw4&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAimigzs5dAEy9DiG9uq7TvqFwvgq93erzmiYjNAp-XHg&oe=6A6F5FAF"}, {"file_name": "Screenshot_2880x1600_c1505.png", "id": "1411945193356179", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499296119_1411945196689512_7734998725794814567_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v1JlAk7Oed4Q7kNvwFezSQY&_nc_oc=AdqW_MG34tpk_90u2x5ojVo3tcSIkiXtiyl_C2yLNzNSac2GCHhwRIWh0qmcUMR0gSw&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAdBimkhNBa9sxqOlRxjuTP1GhcGiXWrpqH1dMbRxdshQ&oe=6A6F3C34"}, {"file_name": "Screenshot_2880x1600_4c5b1.png", "id": "1068101905502534", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/491819396_1068101908835867_3312216196419352187_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3LmCBPsBPZwQ7kNvwFIQiuq&_nc_oc=AdqDI5gv5JI6jFHRxylnWzSd-iE9aCK23-RqVfbdQU8coga8vSc4nQlm9QTqQNf6NpY&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA80uXrPVKKbQ8bDChfpyMO0W-XYbvhjwjXwZdyYcxZgw&oe=6A6F4154"}, {"file_name": "Screenshot_2880x1600_4d288.png", "id": "1698872327430738", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499307315_1698872330764071_1141194021950334483_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YL4jFs4yC4UQ7kNvwHEc42k&_nc_oc=Adrki5OCkXY-vUeJjyXxfkdXMlbdwLPfbElcVowZHQZjnlH8bw8_ypJtCvgMNODZTv8&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDvLzQiVQ2axSaLR4pB1W2_VjQF-vyrnMloRMOszdrH0w&oe=6A6F4689"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Muvia Walking", "keywords": ["games", "rehab", "walking", "rehabilitation"], "long_description": "Muvia Walking turns rehabilitation into an empowering journey -blending VR, AI, and natural walking motion to restore mobility and rebuild confidence.\n\nMore than just a fitness tool, Muvia Walking offers a unique blend of gamified therapy and immersive exploration. Set in beautifully rendered virtual environments, users walk through diverse paths, improve gait and posture, and engage in full-body movements that stimulate both body and mind.\n\nDesigned for both clinical and at-home use, each walking session provides real-time feedback and motion tracking - enabling personalized progress for individuals in recovery, those managing chronic conditions, or anyone looking to stay active and mobile.\n\nWhether you're rehabilitating, training, or simply exploring, Muvia Walking brings purposeful movement  and real therapeutic outcomes right to your doorstep.", "short_description": "Experience the joy of walking while improving your mobility and balance. Muvia Walking blends immersive VR environments with therapeutic benefits and real-time feedback, making everyday movement more engaging and accessible - anytime, anywhere."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.muvia.ai/privacy", "developer_terms_of_service_url": "https://www.muvia.ai/terms", "publisher_name": "Muvia Inc. ", "support_website_url": null, "website_url": "https://www.muvia.ai/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "478089301798119"}], "external_subscription_type": "NOT_REQU
9CgRNxOOkxcEgxwJtRfDZZuA&oe=6A8C16C4"}, "display_name": "Slotopia", "keywords": ["slot", "casino", "slotmachine"], "long_description": "Enter a virtual luxury hotel casino where you can take a seat and play slot machines, table games, and more just like in a real casino.\nFeel as if you are actually sitting in front of a slot machine, with immersive VR interactions that let you naturally pull the lever or press buttons using your own hands.\nAround you, other players are enjoying their own games, creating a lively social casino atmosphere. When you hit a bonus or jackpot, you can celebrate together with cheers and congratulations from everyone nearby.\nYou can earn free coins through gameplay, and also purchase in-game coins that can only be used within the game. These coins cannot be exchanged for real money.\nComplies with adult age rating requirements.", "short_description": "Step into the immersive thrill of a real hotel casino and enjoy a VR social casino experience where you can play and connect with players from around the world."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.jungle-soft.com/policies/privacy_policy_meta_horizon.html", "developer_terms_of_service_url": null, "publisher_name": "Jungle Soft", "support_website_url": null, "website_url": "https://www.jungle-soft.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "1676485315806614"}, {"id": "275629210202852"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "sup
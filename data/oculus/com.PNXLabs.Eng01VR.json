-NrNQOFwOl7Fxjf8s-sZAYsY3i9tWyt6jXymym38bQYYH17Z9zZYjSI&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-erz6CzUBZB3Y_NXWPuL13sGASckSGPzrEr_wos6UNdg&oe=6A26E119"}, {"file_name": "Image5.png", "id": "242755731211245", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974844_242755737877911_7693927835995758823_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vKso1erXwhsQ7kNvwHiCgo4&_nc_oc=Adq-trmsHuEyb6UkxKYnnVzR0FAAV2UlDoSzTwq07NFhJwgbJwL6tqW_aSmqIJMFS9M&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8UFKaxv-kaaF1PIiM8pZixKIgHr6cG6KXBvmIQJDoWzg&oe=6A26C9AC"}, {"file_name": "Image1.png", "id": "168066678784099", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974497_168066682117432_8732134566691555142_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iavbK7OeYOsQ7kNvwFX61m0&_nc_oc=Adoys0p4oDhGEEtcPW5E1-hLvPjBn0UL1yF0TTfrNqhFVCzz-ABOszyZk3CtqOBUpoo&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-y2Uw_zdCaxCVL8IW1rRZjsGsexc3y1iRjUr2TfgJwTA&oe=6A26DE13"}, {"file_name": "Image4.png", "id": "1239874573177398", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974878_1239874576510731_3000447284438951416_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=thdzBCnkuSAQ7kNvwEoz_l3&_nc_oc=AdpB9mYa77TZlyMfGlY6r7Q0oCSzB8auNFZNO1z2ZjSN1puSWtX_3K1pFxK43Gz1nm4&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_FkayL3zTtMN7gbvNDI-csEpDjsiDhSaxEKqK69uBZcw&oe=6A26D241"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "PNX Labs Mechanics Demo", "keywords": [], "long_description": "Demo of Mechanics Virtual Labs developed by PNX Labs GmbH. Test different specimens in a tension universal test machine, visualize deformation of a simple supported beam and analyze the deformation of automotive springs. pnxlabs.com. Full version contains over 20 experiments with additional features such as real time CSV data recording and over 100 specimens and materials. Some of the Experiments in the full package are:\n\n1. Virtual Lab Mechanics - Tension Test \n2. Virtual Lab Mechanics - Bending Test Simple Supported Beam \n3. Virtual Lab Mechanics - Bending test cantilever beam \n4. Virtual Lab Mechanics - Torsion Test \n5. Virtual Lab Mechanics - Brinell Hardness Test \n6. Virtual Lab Mechanics - Rockwell Hardness Test \n7. Virtual Lab Mechanics - Spring Test \n8. Virtual Lab Mechanics - Compression Test \n9. Virtual Lab Mechanics - Izod Impact Test \n10. Virtual Lab Mechanics - Charpy Impact Test \n11. Virtual Lab Mechanics - Fatigue Test\n\nFor full version contact us at pnxlabs.com", "short_description": "PNX Labs Demo for Engineering Mechanics. "}]}, "developer_name": null, "developer_privacy_policy_url": "http://pnxlabs.com/privacypolicy_oculus.php", "developer_terms_of_service_url": null, "publisher_name": "PNX Labs", "support_website_url": "https://pnxlabs.com/contact-us.php", "website_url": "https://pnxlabs.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "396423682286914"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974794_405083781191579_5115975304421170614_n.png?stp=dst-png_s360x360&_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ixja-qtaoCYQ7kNvwEnV0a6&_nc_oc=AdrSd3kqUeGoSwaD_huj8uWvT5-s3iv42nHOgkyl3lX9MZ1xNk7Aokhgbced5ZlfRoI&_nc_zt
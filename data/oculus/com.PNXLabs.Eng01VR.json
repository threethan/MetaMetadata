68213"}, {"file_name": "Image4.png", "id": "1239874573177398", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/38974878_1239874576510731_3000447284438951416_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9Y31KfCGa2gQ7kNvwHepJGs&_nc_oc=AdqOwD1ycG53F1vdnP4CO5ltpB1Lk4WzjdzKGpL8RfaIzcs-VQKKBRCEgn266P-Pidk&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9y8MhSdi_Omze8IyTa7rYnPUB3gplbAmwecH4GzDabSg&oe=6A467641"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "PNX Labs Mechanics Demo", "keywords": [], "long_description": "Demo of Mechanics Virtual Labs developed by PNX Labs GmbH. Test different specimens in a tension universal test machine, visualize deformation of a simple supported beam and analyze the deformation of automotive springs. pnxlabs.com. Full version contains over 20 experiments with additional features such as real time CSV data recording and over 100 specimens and materials. Some of the Experiments in the full package are:\n\n1. Virtual Lab Mechanics - Tension Test \n2. Virtual Lab Mechanics - Bending Test Simple Supported Beam \n3. Virtual Lab Mechanics - Bending test cantilever beam \n4. Virtual Lab Mechanics - Torsion Test \n5. Virtual Lab Mechanics - Brinell Hardness Test \n6. Virtual Lab Mechanics - Rockwell Hardness Test \n7. Virtual Lab Mechanics - Spring Test \n8. Virtual Lab Mechanics - Compression Test \n9. Virtual Lab Mechanics - Izod Impact Test \n10. Virtual Lab Mechanics - Charpy Impact Test \n11. Virtual Lab Mechanics - Fatigue Test\n\nFor full version contact us at pnxlabs.com", "short_description": "PNX Labs Demo for Engineering Mechanics. "}]}, "developer_name": null, "developer_privacy_policy_url": "http://pnxlabs.com/privacypolicy_oculus.php", "developer_terms_of_service_url": null, "publisher_name": "PNX Labs", "support_website_url": "https://pnxlabs.com/contact-us.php", "website_url": "https://pnxlabs.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": []
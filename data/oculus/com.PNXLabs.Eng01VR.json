. Virtual Lab Mechanics - Bending test cantilever beam \n4. Virtual Lab Mechanics - Torsion Test \n5. Virtual Lab Mechanics - Brinell Hardness Test \n6. Virtual Lab Mechanics - Rockwell Hardness Test \n7. Virtual Lab Mechanics - Spring Test \n8. Virtual Lab Mechanics - Compression Test \n9. Virtual Lab Mechanics - Izod Impact Test \n10. Virtual Lab Mechanics - Charpy Impact Test \n11. Virtual Lab Mechanics - Fatigue Test\n\nFor full version contact us at pnxlabs.com", "short_description": "PNX Labs Demo for Engineering Mechanics. "}]}, "developer_name": null, "developer_privacy_policy_url": "http://pnxlabs.com/privacypolicy_oculus.php", "developer_terms_of_service_url": null, "publisher_name": "PNX Labs", "support_website_url": "https://pnxlabs.com/contact-us.php", "website_url": "https://pnxlabs.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "396423682286914"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974794_405083781191579_5115975304421170614_n.png?stp=dst-png_s360x360&_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-7-jSlPFKNkQ7kNvwEsfDct&_nc_oc=Adkk9BiwWLqUg072hWXzvm9G-9DiiLDtqWdiqc4uG8XetNwCFbrHRmNqPxh4I6ISXXc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AfvT82DMzeB10pj6eSwamOB50RDXLvR-NZv483hJm0di3A&oe=699EDE4A"}, "is_concept": false, "is_test": false, "is_trial
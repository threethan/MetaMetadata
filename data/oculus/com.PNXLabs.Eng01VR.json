luscdn.com&_nc_ss=7f20f&oh=00_Af3HIz8jiBtj48SfZW4bb3zcUIz8ijD5P-QKzeJzij3pHg&oe=69F1ECD9"}, {"file_name": "Image5.png", "id": "242755731211245", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974844_242755737877911_7693927835995758823_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OOjeM-bVZMUQ7kNvwGcbIZl&_nc_oc=AdqTFKCmGU-rS5u1gubPI0GUIxHqVXwvLUNbItos3qOP_y9il2JyoJW_NuqPmcg7fOI&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_Af1zyIWlYQYdVmLA_n_vNavxtrCjBsGm9jckDHWrVD7uLQ&oe=69F20DAC"}, {"file_name": "Image1.png", "id": "168066678784099", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974497_168066682117432_8732134566691555142_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bH-oU18WSb4Q7kNvwHTffRN&_nc_oc=AdoAHBxKOn2O47R8hAWT-G4LM_2BGdfz2-5Bp0cSECihIPuHdT-Qc3nr5uqTmTAFSzg&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0tbfERdYq6I8eTBLyJ_uGzjnFvAVR5W2H67IBYvZyjnA&oe=69F1E9D3"}, {"file_name": "Image4.png", "id": "1239874573177398", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974878_1239874576510731_3000447284438951416_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mu965AUIWtsQ7kNvwGU8avn&_nc_oc=AdpvUwyPsQD_7bjC40x9pRbtFZmFbr8-v635tNpmPkIMWtfL7HyomwYWEcjieNNJZoo&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_Af2KH1AAgguC2XVScHvFaICKwvblj1MwqChqvVb4NnfPXQ&oe=69F21641"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "PNX Labs Mechanics Demo", "keywords": [], "long_description": "Demo of Mechanics Virtual Labs developed by PNX Labs GmbH. Test different specimens in a tension universal test machine, visualize deformation of a simple supported beam and analyze the deformation of automotive springs. pnxlabs.com. Full version contains over 20 experiments with additional features such as real time CSV data recording and over 100 specimens and materials. Some of the Experiments in the full package are:\n\n1. Virtual Lab Mechanics - Tension Test \n2. Virtual Lab Mechanics - Bending Test Simple Supported Beam \n3. Virtual Lab Mechanics - Bending test cantilever beam \n4. Virtual Lab Mechanics - Torsion Test \n5. Virtual Lab Mechanics - Brinell Hardness Test \n6. Virtual Lab Mechanics - Rockwell Hardness Test \n7. Virtual Lab Mechanics - Spring Test \n8. Virtual Lab Mechanics - Compression Test \n9. Virtual Lab Mechanics - Izod Impact Test \n10. Virtual Lab Mechanics - Charpy Impact Test \n11. Virtual Lab Mechanics - Fatigue Test\n\nFor full version contact us at pnxlabs.com", "short_description": "PNX Labs Demo for Engineering Mechanics. "}]}, "developer_name": null, "developer_privacy_policy_url": "http://pnxlabs.com/privacypolicy_oculus.php", "developer_terms_of_service_url": null, "publisher_name": "PNX Labs", "support_website_url": "https://pnxlabs.com/contact-us.php", "website_url": "https://pnxlabs.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "396423682286914"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974794_405083781191579_5115975304421170614_n.png?stp=dst-png_s360x360&_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4xnzl-fxXc4Q7kNvwEWnu0M&_nc_oc=AdrYisQyIj5pNbLck1brJIalTv7cGhuQQOJ4OXk1vHPrupWJ-vvbT5G7EFAtkPV06iI&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_Af0_sJYW4BY9q0c31wYHUB69AT2MDcGgJtFctD2YgEowWQ&oe=69F1ECCA"}, "is_conce
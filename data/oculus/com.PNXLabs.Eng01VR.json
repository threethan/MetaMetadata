-s15HlCkWdclbNU43CktipmD2S2yYqiRxihuGgtDVW1FjsDKFKB45Nc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4FxgLxvITpEYQc-3yLD62SvYxvHAZkCUPx-zBLpoU3sw&oe=6A00A599"}, {"file_name": "Image5.png", "id": "242755731211245", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974844_242755737877911_7693927835995758823_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CGWh5NGbdosQ7kNvwFHXcj5&_nc_oc=AdpwsC6tYt79qvqsqJoXq3_m5wh_l6NByu9EVzMavSFHzRTQBFf4aBACkRk1FDG3Gwo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7FQZ5_Aa_IZ-IGbDjyq7CPECs7MS_UnMgR6R9hJ-15lQ&oe=6A008E2C"}, {"file_name": "Image1.png", "id": "168066678784099", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974497_168066682117432_8732134566691555142_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5jbhMHxrn9MQ7kNvwEt_va8&_nc_oc=AdpPITDpOd6vIxccziwEo97BDHsuJkp1F3wInktkBZOWgE-WJVBiyEmI47EAnOYV8vg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7SJo-srmUb36OB7OGQuqHdzIfudWZCiI_yZv8R3zlrDQ&oe=6A00A293"}, {"file_name": "Image4.png", "id": "1239874573177398", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974878_1239874576510731_3000447284438951416_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=olfaftzZGHgQ7kNvwG0Zl0T&_nc_oc=AdrpWLdp3atmSeM4eMM0chbCqR7VpiVYJZU5kCt_iBiRHFkshPMsOdzCn_en0fBPPm4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5iAspnmfj0nfTnpQs35wpuPozcJKKuShvA9VXUcHpreA&oe=6A0096C1"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "PNX Labs Mechanics Demo", "keywords": [], "long_description": "Demo of Mechanics Virtual Labs developed by PNX Labs GmbH. Test different specimens in a tension universal test machine, visualize deformation of a simple supported beam and analyze the deformation of automotive springs. pnxlabs.com. Full version contains over 20 experiments with additional features such as real time CSV data recording and over 100 specimens and materials. Some of the Experiments in the full package are:\n\n1. Virtual Lab Mechanics - Tension Test \n2. Virtual Lab Mechanics - Bending Test Simple Supported Beam \n3. Virtual Lab Mechanics - Bending test cantilever beam \n4. Virtual Lab Mechanics - Torsion Test \n5. Virtual Lab Mechanics - Brinell Hardness Test \n6. Virtual Lab Mechanics - Rockwell Hardness Test \n7. Virtual Lab Mechanics - Spring Test \n8. Virtual Lab Mechanics - Compression Test \n9. Virtual Lab Mechanics - Izod Impact Test \n10. Virtual Lab Mechanics - Charpy Impact Test \n11. Virtual Lab Mechanics - Fatigue Test\n\nFor full version contact us at pnxlabs.com", "short_description": "PNX Labs Demo for Engineering Mechanics. "}]}, "developer_name": null, "developer_privacy_policy_url": "http://pnxlabs.com/privacypolicy_oculus.php", "developer_terms_of_service_url": null, "publisher_name": "PNX Labs", "support_website_url": "https://pnxlabs.com/contact-us.php", "website_url": "https://pnxlabs.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "396423682286914"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974794_405083781191579_5115975304421170614_n.png?stp=dst-png_s360x360&_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FlEXHEmc0gwQ7kNvwHlM6tl&_nc_oc=Adql9qtMovvdzW5ooYUp-knCo8Vn49Qd9YUGaosboIdaT9yW4BQzFQ9u_FCmGRWke7I&_nc_zt
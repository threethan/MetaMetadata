}]}, "id": "702772195425281", "locale": "en_US", "screenshots": [{"file_name": "MUT_Gameplay_oil_v02.png", "id": "993492166253623", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473392000_993492169586956_1948454237516452146_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BG6TJMstuuAQ7kNvwGAE1rR&_nc_oc=AdphXQm1ybFpz0dbP-vdHnBJkzM0ixAMzlxmsGKVfgmBX9iL9u9MCQOGDX_2QYOmwoE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGErWwMpxWbT1E1_rt3mvVFt_GQSE3hprxA_ZWX5dk3Wg&oe=6A7C74F5"}, {"file_name": "MUT-screenshots_0004_Layer-4.png", "id": "1339708413982223", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473391911_1339708417315556_1576473059195060309_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Uxx08ob0j3cQ7kNvwEtStxl&_nc_oc=Adr3Y01ukb7yc6VXH0fJhOmnOMTlqf4LNe32-oBTEM-GTIryENSwprt0nKtXkKgg8t0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGsur7-O9fu6VxT1eNyEzTEH0BQ8utVTnw0fII_O0tKgg&oe=6A7C5E68"}, {"file_name": "MUT_Gameplay_MR_v02.png", "id": "1691352974808451", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391924_1691352978141784_8099257676331556317_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C8oCEu0eG0wQ7kNvwEIXdri&_nc_oc=Ado9vLrnFhuGFhDbLX7fARvfRLQ2skEQlLBy_pV4pwVpKeuTAxE1KrVG2dphr9O5roY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHv21b36pdG-AUy9iLylzmlPgmiJ9PS9GP8z68PR5RwMg&oe=6A7C69DF"}, {"file_name": "MUT-screenshots_0006_Layer-1.png", "id": "2615536645274227", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974482_2615536648607560_6052236317170598783_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=14jj1hSQ780Q7kNvwFl_XGa&_nc_oc=AdoM2wrSZclVtTpWocYlkt9DhjORdtp6rp16vGZbOAGNlY5lOLJe-vVdbsiR2ZiCOuM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEcvMjpxyOMEMQB9sqPSKuVseCEtzqoiVkC0Uucc6GrGA&oe=6A7C48F4"}, {"file_name": "MUT_Gameplay_ape_v02.png", "id": "672593495148138", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391924_672593501814804_1752950830627007562_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=athdOEbOqwAQ7kNvwHkW2k2&_nc_oc=AdoKEL5dM3viwdHK1sjnaKOIoEvOQFERGTKnZJCFtybCj7Pbzh20N3fdUuqcTthj6zg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGe6pjngaw42ozfaRM7K4Tc-hg5uKXR35qLTr4NDjYTVQ&oe=6A7C538B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Promotiontest-2.png", "id": "463471329898859", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982510_463471333232192_8427622215650267924_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IdH5UEbXgU8Q7kNvwGYXym0&_nc_oc=AdqDDzxdUPsXxJ59lovDPskLI5uKp3noxQv5b8ssO8Xr1o284u8ZMrmRKWGrBR6-PLg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHTYm2e_6TddeUt2sNzpjFrrWLeAuz0vA0Icg9GLBlS_g&oe=6A7C5C4D"}, "display_name": "Mutant Boxing League", "keywords": ["boxing", "fighting", "mixedreality", "workout", "exercise"], "long_description": "Inject some fun boxing into your daily workout and dominate as a boxing champion!\n\n\ud83c\udfc6 Experience our latest update with Mixed Reality boxing mode, allowing you to exercise in even the smallest spaces or even outside.\n* Fight different boxers, each with their own unique boxing style and abilities.\n* Progress through the matches to unlock and explore new opponents, environments and gloves.\n* Boxing tutorials - learn how to attack and defend.\n* Learn how to effectively utilize special gloves like the power glove and speed glove.\n* Several Minigames included to master and compete with Global Highscores.\n* Try the Challenges that unlocks unique boxing glove skins.\n* Weekly Challenges to keep you in shape! \n* Hardcore mode for the real experienced boxers.\n\nOur aim is to make training as enjoyable as possible. With open outdoor environments, different levels and opponents that all have the different abilities and skills, you will learn to be a better boxer. Boxing is not all about attack, but also learn how to block and dodge punches. And when or if you get knocked down, complete the different mini-games in time, to continue the fight.\n\nDon't wait any longer - step into the ring and unleash your inner warrior. \n\nJoin our Discord!\nhttps://discord.com/invite/k9bCaKbXks\n{1083050756747663}", "short_description": "A playful boxing game! Learn how to jab, block, dodge and slip punches. Fight different mutant opponents with unique boxing styles. Learn how to use features such as the powerglowe. Several minigames also included for training or compete with global highscores. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://filmicstudios.se/privacy", "developer_terms_of_service_url": null, "publisher_name": "Filmic Studios", "support_website_url": "https://filmicstudios.se/#Contact", "website_url": "https://filmicstudios.se/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "2710427532541308"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8879042718863388"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/57570307_7054802327945500_8551928990858318411_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bFO_HB3ffuYQ7kNvwHeMhCd&_nc_oc=AdoP4NLggCoH2D_CH9IFTA8RD7A-U2NQJCtfQJWjGh_hQew0BDFhmzI31YVajfnR8OU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG1hx6Lj5FDZoWtDhjWN3sNM
scdn.com/v/t64.5771-25/473392000_993492169586956_1948454237516452146_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WHQv7aeXEqgQ7kNvwH7tjWA&_nc_oc=AdrAOOr5pk4k-0pZPNo-ZiOQWC4FloryQuskyn2ajS8lG_aJzyrqWfFVGW-xzrlIV48&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Af16tzsHqlK1xsAHBee690fJ7owIDrmcW1nNKnHoT7JBFQ&oe=69F0B5F5"}, {"file_name": "MUT-screenshots_0004_Layer-4.png", "id": "1339708413982223", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391911_1339708417315556_1576473059195060309_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TSsXKsBseF0Q7kNvwFSLqUp&_nc_oc=AdpK6fRQ_CTGc40o3DIqcwEatuUEGStgOyS7zf3p_E3mTQQFdbYmfnXkfJK2_Dco4Ks&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Af1p2AIG8kZuoLA6Pyltrg4otfkWFdZ3ECdSer_JVq0Z_g&oe=69F09F68"}, {"file_name": "MUT_Gameplay_MR_v02.png", "id": "1691352974808451", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391924_1691352978141784_8099257676331556317_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CxEk8k4JMcoQ7kNvwGUP-Cm&_nc_oc=Ado4J_mJxJL8DMuRt7R2RZJJDtWaGiqpls_L12XDzzgKBar5faX_yX-HZ2DhRK0rQwM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af2AspMcQviRj0xS5TFCy_Viqm8lFhjfefaFxhmC2UpZdg&oe=69F0AADF"}, {"file_name": "MUT-screenshots_0006_Layer-1.png", "id": "2615536645274227", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974482_2615536648607560_6052236317170598783_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BxrxGTV5oDgQ7kNvwGbHpXG&_nc_oc=AdrWZHGY_B5pQpmBWov4oUxnLOIv3oj3HQ_iZZtPFb1irNg7SHqL2l-TnE5ZyFi7omI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af0qdfShU3EZR6_Y-LG1fJvIkcLXWEDnLZC-_LJUDaJjJg&oe=69F0C234"}, {"file_name": "MUT_Gameplay_ape_v02.png", "id": "672593495148138", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391924_672593501814804_1752950830627007562_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Uk4yBEjApmMQ7kNvwGc7V-4&_nc_oc=AdrXjl7iAq3ZXWOe17q-JgW9CwGJkqMk-wQvoCjJjvbff9MqwsP6xgvR57lqBW_w65E&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af1fRDFl-9aN_87getRu-bDu20yVk_f11jKLuJLXlSI1Rg&oe=69F0CCCB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Promotiontest-2.png", "id": "463471329898859", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982510_463471333232192_8427622215650267924_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O9jZHQu89W8Q7kNvwFfBKSz&_nc_oc=Adr9witko7AUd0JCzUuadeEqPsVdku-xp098az47iX3VaHHQpFWzsOtsgqzjzZaFlEM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Af27epO_75-SikqJ8O2gYRSWe-E-fJro7qGCf1cwoRtgvg&oe=69F09D4D"}, "display_name": "Mutant Boxing League", "keywords": ["boxing", "fighting", "mixedreality", "workout", "exercise"], "long_description": "Inject some fun boxing into your daily workout and dominate as a boxing champion!\n\n\ud83c\udfc6 Experience our latest update with Mixed Reality boxing mode, allowing you to exercise in even the smallest spaces or even outside.\n* Fight different boxers, each with their own unique boxing style and abilities.\n* Progress through the matches to unlock and explore new opponents, environments and gloves.\n* Boxing tutorials - learn how to attack and defend.\n* Learn how to effectively utilize special gloves like the power glove and speed glove.\n* Several Minigames included to master and compete with Global Highscores.\n* Try the Challenges that unlocks unique boxing glove skins.\n* Weekly Challenges to keep you in shape! \n* Hardcore mode for the real experienced boxers.\n\nOur aim is to make training as enjoyable as possible. With open outdoor environments, different levels and opponents that all have the different abilities and skills, you will learn to be a better boxer. Boxing is not all about attack, but also learn how to block and dodge punches. And when or if you get knocked down, complete the different mini-games in time, to continue the fight.\n\nDon't wait any longer - step into the ring and unleash your inner warrior. \n\nJoin our Discord!\nhttps://discord.com/invite/k9bCaKbXks\n{1083050756747663}", "short_description": "A playful boxing game! Learn how to jab, block, dodge and slip punches. Fight different mutant opponents with unique boxing styles. Learn how to use features such as the powerglowe. Several minigames also included for training or compete with global highscores. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://filmicstudios.se/privacy", "developer_terms_of_service_url": null, "publisher_name": "Filmic Studios", "support_website_url": "https://filmicstudios.se/#Contact", "website_url": "https://filmicstudios.se/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "2710427532541308"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8879042718863388"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/57570307_7054802327945500_8551928990858318411_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GD2C7q75Wx8Q7kNvwG3MVgv&_nc_oc=AdrCtMJzskP2VfZsOyuiCA7-WfTI43ivrvVMdJXBm2u4-LSkSYVy8lxJnUy3EVVFbWM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af0NNxBBNv02XvKuOOIarzd3Mc4pXMLgkxwdJ2QESVkZIA&oe=69F0B85F"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Mutant Boxing League", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context
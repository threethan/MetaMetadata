}]}, "id": "702772195425281", "locale": "en_US", "screenshots": [{"file_name": "MUT_Gameplay_oil_v02.png", "id": "993492166253623", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/473392000_993492169586956_1948454237516452146_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AlYzymlDNp4Q7kNvwETy_8K&_nc_oc=AdqejtGJ6dWS9PAPqm5N0q25kJfmQNYIq8N2tt4jjTrwqrSBILsiWfXgXvBWfMrjWI8&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQATE0lEXJ0R9yXoQQUwBbOKmpNDm-LvZI_3ipj1nXR-vQ&oe=6A539675"}, {"file_name": "MUT-screenshots_0004_Layer-4.png", "id": "1339708413982223", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/473391911_1339708417315556_1576473059195060309_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Q2fb0lSOQqsQ7kNvwHya_W5&_nc_oc=AdoxANo-mNOyCdQb6uDyyhGn35lpKbIGnGI4HS79MgCDlTefTy8f7JwuDZfdAdqO5XI&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC1dHvgWM_1_awPWN638kWdNCcjVMlrcV8f1cUrhGmM_A&oe=6A537FE8"}, {"file_name": "MUT_Gameplay_MR_v02.png", "id": "1691352974808451", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473391924_1691352978141784_8099257676331556317_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3vNMfft5cDYQ7kNvwH8nS6i&_nc_oc=AdpKI0QpJix9Umz3s9Y9XtMMICnpgeHlucJ8MuxXeZ5qNahUIhX6qHvTa-2UsFsYw4k&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCHq5voRYNbKeEC4TCaStzk7JwTISBwUFp67pC43S9y8w&oe=6A538B5F"}, {"file_name": "MUT-screenshots_0006_Layer-1.png", "id": "2615536645274227", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38974482_2615536648607560_6052236317170598783_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FFgQ12GhqrIQ7kNvwFzB_xE&_nc_oc=AdpTCuS26oocLT7RWhP5ojhI3pWx1ZnTFsz2Ie7IioySwHJEm1uzFmskQcMqkqtYIwo&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDDUom9iF8XBFRCBVQBt-97o-yc_4DygHUH0XTv73tmCw&oe=6A53A2B4"}, {"file_name": "MUT_Gameplay_ape_v02.png", "id": "672593495148138", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/473391924_672593501814804_1752950830627007562_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zFwYYiupsPAQ7kNvwEAXzKV&_nc_oc=AdqQC54b49ow382ox-9chCWl9vSGWfhCcwATROxB9zPNq3nq7QLsX5rW4Uo_M0H7E9A&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDOJIlq0EMogP0LIcZv3ZBbK71BYVMkr6TF6YwMa6c-vg&oe=6A53AD4B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Promotiontest-2.png", "id": "463471329898859", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982510_463471333232192_8427622215650267924_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rxjANkmf_c0Q7kNvwGX9wC-&_nc_oc=AdpYgRjIpRMAKuNII36JJeQrJmYnwO-L1c95JX2fxwBJ5s1Gi3xcvlgHqpoyPzcPTWs&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCmiL7Ua88AwaZNg9HwAemOK2dW6UZvsa8yR14Izv2JIA&oe=6A537DCD"}, "display_name": "Mutant Boxing League", "keywords": ["boxing", "fighting", "mixedreality", "workout", "exercise"], "long_description": "Inject some fun boxing into your daily workout and dominate as a boxing champion!\n\n\ud83c\udfc6 Experience our latest update with Mixed Reality boxing mode, allowing you to exercise in even the smallest spaces or even outside.\n* Fight different boxers, each with their own unique boxing style and abilities.\n* Progress through the matches to unlock and explore new opponents, environments and gloves.\n* Boxing tutorials - learn how to attack and defend.\n* Learn how to effectively utilize special gloves like the power glove and speed glove.\n* Several Minigames included to master and compete with Global Highscores.\n* Try the Challenges that unlocks unique boxing glove skins.\n* Weekly Challenges to keep you in shape! \n* Hardcore mode for the real experienced boxers.\n\nOur aim is to make training as enjoyable as possible. With open outdoor environments, different levels and opponents that all have the different abilities and skills, you will learn to be a better boxer. Boxing is not all about attack, but also learn how to block and dodge punches. And when or if you get knocked down, complete the different mini-games in time, to continue the fight.\n\nDon't wait any longer - step into the ring and unleash your inner warrior. \n\nJoin our Discord!\nhttps://discord.com/invite/k9bCaKbXks\n{1083050756747663}", "short_description": "A playful boxing game! Learn how to jab, block, dodge and slip punches. Fight different mutant opponents with unique boxing styles. Learn how to use features such as the powerglowe. Several minigames also included for training or compete with global highscores. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://filmicstudios.se/privacy", "developer_terms_of_service_url": null, "publisher_name": "Filmic Studios", "support_website_url": "https://filmicstudios.se/#Contact", "website_url": "https://filmicstudios.se/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "2710427532541308"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8879042718863388"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/57570307_7054802327945500_8551928990858318411_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oJncljV7UhsQ7kNvwEupNXI&_nc_oc=AdoRv9z2l3yYZX_0fJPfEI_IM2JWBZTBy9g58x2YBNyabAmsdwePIHqc5HEnKo0QATI&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCiZE3qpEKILXYSaYM21JQri
}]}, "id": "702772195425281", "locale": "en_US", "screenshots": [{"file_name": "MUT_Gameplay_oil_v02.png", "id": "993492166253623", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473392000_993492169586956_1948454237516452146_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ga5PWB4NjkEQ7kNvwEdG8KP&_nc_oc=AdrYj8zLEZDm3KwF5orvKqzYUl2f3vkJhHxywv4L_SOLIj7e7zrOR1bXdMpg9D4UYxU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLL_EGu9_eTC_rF-GPsxfmdSHiJyNBFAc0sjq-CDCcwug&oe=6ABE5FF5"}, {"file_name": "MUT-screenshots_0004_Layer-4.png", "id": "1339708413982223", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391911_1339708417315556_1576473059195060309_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f5i7xxOKiWIQ7kNvwHpqpFs&_nc_oc=Adow_uGLGHIQ3o-daw_E5zCIZwDAu67ObH3b9SwMcRX02H6FMym6Fv9-kyduAgfpJSQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJSz6Wn_WNPbH3x0SL0h4yJiNqo29x684ZtWK5YP7gLUQ&oe=6ABE81A8"}, {"file_name": "MUT_Gameplay_MR_v02.png", "id": "1691352974808451", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391924_1691352978141784_8099257676331556317_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y8n11cRFbtQQ7kNvwEl0vc8&_nc_oc=AdrZrrjrWQ3MnsdEkXdFgpe-UOx6rex5GHdXiXd1ImkzdXJwiy470cCRQ0mgCGhlcTY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLyc7hFPUrA9atH6bKJDx_1yhgYDi8Giyuq3F6eTgGULQ&oe=6ABE8D1F"}, {"file_name": "MUT-screenshots_0006_Layer-1.png", "id": "2615536645274227", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974482_2615536648607560_6052236317170598783_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vDOmfSdjo6wQ7kNvwG85ofC&_nc_oc=Adpk71GsUp-UmQhMm42IWIsU1KZGGmBa1RnNPvWHpTmASE9HeUF29L1vPJmGZwYv9FU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKhtD2f6oSocXgkPhxSlUueXO3NDEaC62zpgV_avAHWug&oe=6ABE6C34"}, {"file_name": "MUT_Gameplay_ape_v02.png", "id": "672593495148138", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391924_672593501814804_1752950830627007562_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Cjay0qs8VWwQ7kNvwHvsWtB&_nc_oc=AdoMMd6M3aYJV-9qCAEeKL7_HJIOO8o6HVK_7_pw_favxqfBX9ei0w3OZpY1FKYGOro&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ0Z2RQUpUjCYyPziZdGRX6bXlGhnyjwabMTuQA4eXeQw&oe=6ABE76CB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Promotiontest-2.png", "id": "463471329898859", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982510_463471333232192_8427622215650267924_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SOw659s16igQ7kNvwFzKe18&_nc_oc=AdogSlIUEj9yXKKYMnAbaBETOD0puHVEnzckEFyNyg2dChWg0qoScWxRdl_zL5Um57U&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQInimyJzDP4bsEGtKjHnkgIPvPBvyQcf5sV8HupBG0tEA&oe=6ABE7F8D"}, "display_name": "Mutant Boxing League", "keywords": ["boxing", "fighting", "mixedreality", "workout", "exercise"], "long_description": "Inject some fun boxing into your daily workout and dominate as a boxing champion!\n\n\ud83c\udfc6 Experience our latest update with Mixed Reality boxing mode, allowing you to exercise in even the smallest spaces or even outside.\n* Fight different boxers, each with their own unique boxing style and abilities.\n* Progress through the matches to unlock and explore new opponents, environments and gloves.\n* Boxing tutorials - learn how to attack and defend.\n* Learn how to effectively utilize special gloves like the power glove and speed glove.\n* Several Minigames included to master and compete with Global Highscores.\n* Try the Challenges that unlocks unique boxing glove skins.\n* Weekly Challenges to keep you in shape! \n* Hardcore mode for the real experienced boxers.\n\nOur aim is to make training as enjoyable as possible. With open outdoor environments, different levels and opponents that all have the different abilities and skills, you will learn to be a better boxer. Boxing is not all about attack, but also learn how to block and dodge punches. And when or if you get knocked down, complete the different mini-games in time, to continue the fight.\n\nDon't wait any longer - step into the ring and unleash your inner warrior. \n\nJoin our Discord!\nhttps://discord.com/invite/k9bCaKbXks\n{1083050756747663}", "short_description": "A playful boxing game! Learn how to jab, block, dodge and slip punches. Fight different mutant opponents with unique boxing styles. Learn how to use features such as the powerglowe. Several minigames also included for training or compete with global highscores. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://filmicstudios.se/privacy", "developer_terms_of_service_url": null, "publisher_name": "Filmic Studios", "support_website_url": "https://filmicstudios.se/#Contact", "website_url": "https://filmicstudios.se/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "2710427532541308"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8879042718863388"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/57570307_7054802327945500_8551928990858318411_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=olLzO7nQbuAQ7kNvwGwXypu&_nc_oc=Adru_KGdjyqG08by0_9LOjsOeiN1Rmc5f-t7kMnP7Nj8Trz4z3_-bnSYDT2jrSLAeUM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKAx5cXQwFD3JFCvU9N3Jq91
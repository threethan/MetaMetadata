}]}, "id": "702772195425281", "locale": "en_US", "screenshots": [{"file_name": "MUT_Gameplay_oil_v02.png", "id": "993492166253623", "uri": "https://scontent-lhr8-2.oculuscdn.com/v/t64.5771-25/473392000_993492169586956_1948454237516452146_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=630kWfqHyvwQ7kNvwE8vGhW&_nc_oc=Adr6yx6V-d_X5dlgCawLU5SxWkg_vRuhQpP-ICH2xqz5zaRiPJM4tEXVn0rOa4IZL_Q&_nc_zt=3&_nc_ht=scontent-lhr8-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4miDj-sayaqEVrKazE8pkTQFNVuRm8n452afEM2DMFWA&oe=6A1C3775"}, {"file_name": "MUT-screenshots_0004_Layer-4.png", "id": "1339708413982223", "uri": "https://scontent-lhr8-2.oculuscdn.com/v/t64.5771-25/473391911_1339708417315556_1576473059195060309_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bl61xBYWjxUQ7kNvwEvc4df&_nc_oc=Adry3Nkjku9AhY-pc1P-J0S5cxpU-Uzi86Yuu49N6CGU7qcce6VXKOe8_0J9TWlTn2I&_nc_zt=3&_nc_ht=scontent-lhr8-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af68OaVp-fsZznTfjIN40ORsEo-E32gOwhVRkGeta38vKQ&oe=6A1C5928"}, {"file_name": "MUT_Gameplay_MR_v02.png", "id": "1691352974808451", "uri": "https://scontent-lhr8-1.oculuscdn.com/v/t64.5771-25/473391924_1691352978141784_8099257676331556317_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O76KfQGzuBEQ7kNvwEyBrg5&_nc_oc=Adob53eStOZxmNK0fqHK1pZp8YXb-5S2AVFw_7-lJVzo6rn4zAgIfuBN8nxX1BcMG5k&_nc_zt=3&_nc_ht=scontent-lhr8-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6FsHDBMxYxsn6ry0iYx8dlK5Va0MtwsH6-AmAwfJknow&oe=6A1C2C5F"}, {"file_name": "MUT-screenshots_0006_Layer-1.png", "id": "2615536645274227", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/38974482_2615536648607560_6052236317170598783_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EvW1r1hHoiYQ7kNvwGV-xvB&_nc_oc=AdrBX0YRmVOh5_k4d5y2Xp3_JE_04tTaHn23DOSctI-tq8GF-Nzo_ni7GqvxzUAf4ag&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6taRIcrot9MQTDKRjgTPLZYd7NOiFCUQ9BklLx6qLjlA&oe=6A1C43B4"}, {"file_name": "MUT_Gameplay_ape_v02.png", "id": "672593495148138", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/473391924_672593501814804_1752950830627007562_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rNRMsu3wfD0Q7kNvwHWwYmo&_nc_oc=Adp3xyTL1NhjdYV01nch8iDkLUqPV49s5kdrPEUmagwcQU2XDhkZ9CKpLiAAt9ix0m8&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5i0eO9_TkI6esc3HTy0K_juXAsOYVI7WW7dn6Lz_k_PQ&oe=6A1C4E4B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Promotiontest-2.png", "id": "463471329898859", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/38982510_463471333232192_8427622215650267924_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SBFkaSsDN3UQ7kNvwGr3Zfq&_nc_oc=AdpbRX58w-xfqqRs8XIOjty5BAfLsL4fQccouysfWETRPWchecyc1RQGOwUqVeNdt10&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af52e8vWTyMY9qAGPmERqVF4XxZrph_y2c63IIK5E6jDzg&oe=6A1C570D"}, "display_name": "Mutant Boxing League", "keywords": ["boxing", "fighting", "mixedreality", "workout", "exercise"], "long_description": "Inject some fun boxing into your daily workout and dominate as a boxing champion!\n\n\ud83c\udfc6 Experience our latest update with Mixed Reality boxing mode, allowing you to exercise in even the smallest spaces or even outside.\n* Fight different boxers, each with their own unique boxing style and abilities.\n* Progress through the matches to unlock and explore new opponents, environments and gloves.\n* Boxing tutorials - learn how to attack and defend.\n* Learn how to effectively utilize special gloves like the power glove and speed glove.\n* Several Minigames included to master and compete with Global Highscores.\n* Try the Challenges that unlocks unique boxing glove skins.\n* Weekly Challenges to keep you in shape! \n* Hardcore mode for the real experienced boxers.\n\nOur aim is to make training as enjoyable as possible. With open outdoor environments, different levels and opponents that all have the different abilities and skills, you will learn to be a better boxer. Boxing is not all about attack, but also learn how to block and dodge punches. And when or if you get knocked down, complete the different mini-games in time, to continue the fight.\n\nDon't wait any longer - step into the ring and unleash your inner warrior. \n\nJoin our Discord!\nhttps://discord.com/invite/k9bCaKbXks\n{1083050756747663}", "short_description": "A playful boxing game! Learn how to jab, block, dodge and slip punches. Fight different mutant opponents with unique boxing styles. Learn how to use features such as the powerglowe. Several minigames also included for training or compete with global highscores. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://filmicstudios.se/privacy", "developer_terms_of_service_url": null, "publisher_name": "Filmic Studios", "support_website_url": "https://filmicstudios.se/#Contact", "website_url": "https://filmicstudios.se/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "2710427532541308"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8879042718863388"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/57570307_7054802327945500_8551928990858318411_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rKgrF4cLnl0Q7kNvwF5CTIX&_nc_oc=AdqjRWRheW2X1Rxf2BTOmE9ERAiuymhkCMe5iTHkB75-Tp4ElgrALsL2ff1lPaBb7uY&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4Izhu0Y90CA-8tLp5jcsCmR
scdn.com/v/t64.5771-25/473392000_993492169586956_1948454237516452146_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R4O7PhnYuzIQ7kNvwEnWjsH&_nc_oc=Adl0unZdPrp67-aDkBAR9S7pwc4SBTTsJW_t6PoStK4Usgpr_RlL1AbBzh4_Yr4fL90&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&oh=00_Aft9WcdVlmRXTOx5CZkC-8bCMj-zZyFTfSha7R-Wm7JoWg&oe=69986175"}, {"file_name": "MUT-screenshots_0004_Layer-4.png", "id": "1339708413982223", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391911_1339708417315556_1576473059195060309_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DBfPNrMzNgkQ7kNvwGeKZJu&_nc_oc=AdmBOuFoYHilomwzUp59ATzSCcdFZHqTDCkHaHBefgjzrg5QwFRmj5QkgWQKZPA24gk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&oh=00_AfvDvwG9TreIVXeL3n1PWGpEJD6Vaxbk31y49TUzkGQd8w&oe=69984AE8"}, {"file_name": "MUT_Gameplay_MR_v02.png", "id": "1691352974808451", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391924_1691352978141784_8099257676331556317_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5fDwtlUgnZ4Q7kNvwGEX99j&_nc_oc=AdkD1wzWpDcntkZnfCVCuD5m56VXUT1gmLOj1EMrY2oAu9a8p-ueAE6NsR5ZBAljoxA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&oh=00_AfsylE9tBGdp_D0zuSRcTWBLrrFXt2ecCeahWDc66tBwQw&oe=6998565F"}, {"file_name": "MUT-screenshots_0006_Layer-1.png", "id": "2615536645274227", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974482_2615536648607560_6052236317170598783_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ILkFYA0iy1AQ7kNvwG_a0ox&_nc_oc=Adl9LXJa7XdViFNpV5TR_lPxfoWQ3e4DpzIwkf7ehwpcLHnZYy-9McZjo9Sr5JQeFD4&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&oh=00_Afs0_k6DNB9u1nTd-7-Bn6hIpNpkKuWZzGwHjgduBJpL7A&oe=69986DB4"}, {"file_name": "MUT_Gameplay_ape_v02.png", "id": "672593495148138", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473391924_672593501814804_1752950830627007562_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-juJ_a0gwt0Q7kNvwG4qjnz&_nc_oc=AdngJqzY4mQnNyz7OR_pSs4cTadc_c7tE1iKC8_btpPA7Bohrghbi8K7W_3a5gRdFFQ&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&oh=00_Afu34JmqYLCxTkU5V0oRjxe3g28ShCxa4LFRxpeprAA0iw&oe=6998400B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Promotiontest-2.png", "id": "463471329898859", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982510_463471333232192_8427622215650267924_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZXAI5__Mk2IQ7kNvwEz-IW4&_nc_oc=AdnS9RKzxYmP12QQ8zVIdvbCVHKyBbMgY-S0ywgzn2fES7IV1--OnFrYvRtfGCZuUNU&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&oh=00_AfuGKsIVBUuVYkA_2VbikvtzszBhoqRGbbGzZH5xLwVS6g&oe=699848CD"}, "display_name": "Mutant Boxing League", "keywords": ["boxing", "fighting", "mixedreality", "workout", "exercise"], "long_description": "Inject some fun boxing into your daily workout and dominate as a boxing champion!\n\n\ud83c\udfc6 Experience our latest update with Mixed Reality boxing mode, allowing you to exercise in even the smallest spaces or even outside.\n* Fight different boxers, each with their own unique boxing style and abilities.\n* Progress through the matches to unlock and explore new opponents, environments and gloves.\n* Boxing tutorials - learn how to attack and defend.\n* Learn how to effectively utilize special gloves like the power glove and speed glove.\n* Several Minigames included to master and compete with Global Highscores.\n* Try the Challenges that unlocks unique boxing glove skins.\n* Weekly Challenges to keep you in shape! \n* Hardcore mode for the real experienced boxers.\n\nOur aim is to make training as enjoyable as possible. With open outdoor environments, different levels and opponents that all have the different abilities and skills, you will learn to be a better boxer. Boxing is not all about attack, but also learn how to block and dodge punches. And when or if you get knocked down, complete the different mini-games in time, to continue the fight.\n\nDon't wait any longer - step into the ring and unleash your inner warrior. \n\nJoin our Discord!\nhttps://discord.com/invite/k9bCaKbXks\n{1083050756747663}", "short_description": "A playful boxing game! Learn how to jab, block, dodge and slip punches. Fight different mutant opponents with unique boxing styles. Learn how to use features such as the powerglowe. Several minigames also included for training or compete with global highscores. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://filmicstudios.se/privacy", "developer_terms_of_service_url": null, "publisher_name": "Filmic Studios", "support_website_url": "https://filmicstudios.se/#Contact", "website_url": "https://filmicstudios.se/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "2710427532541308"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8879042718863388"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/57570307_7054802327945500_8551928990858318411_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sQ24KFWCTZEQ7kNvwHE9ylw&_nc_oc=AdnlrTi1b7EAOkCryaQQ382t17ZhBm8qPSx2TanwJSEAc-2r5TVNdujzYQQhd_2lPjU&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&oh=00_Aftoc9ZBYyH7dbCnw7k8Y_U90hM0N0YICe6Qi59XjmJ5UA&oe=699863DF"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Mutant Boxing League", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context
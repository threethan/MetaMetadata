.com/v/t64.5771-25/38974692_201031793055480_7909991526784956407_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6Azfhxqn4VIQ7kNvwH_G6cD&_nc_oc=AdpGHmb15-wkIHVV1wdTq5o8BaYOd9hFeZlU4h-WdcRO1vqEpQNIRYFCTcOTMzcjv7s&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-HPjzDvbLfKQtu5Zmmr3y_0xdTLWk35fvNPXM_voHlMA&oe=6A3A9F57"}]}, "id": "742081604594700", "locale": "en_US", "screenshots": [{"file_name": "MUT_CoverArt_2560x1440_v01.png", "id": "715115680534390", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75416834_715115683867723_421827735563796911_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tjZCASXmu4AQ7kNvwH9x67q&_nc_oc=AdqvkmwDUnibkykRLp51Rr15Ol4tKY2shl1vONLe-rfW2wOfkb_nrrECaQjS6wfrSXc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-UNR_Vu0aUiNPoNRu0JTSYgjKfbGjkhNtgnpZsD-bRrA&oe=6A3A9DFB"}, {"file_name": "MutantBoxingLeague-021.png", "id": "1300537890659057", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/57568677_1300537893992390_8529547455366557532_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6TGjENhNP9cQ7kNvwF89-OT&_nc_oc=Adqi0UPbfCJ3nesUULGMdhsxPyd5EO2FAiu0pRQm5C9_S_7JupP2cvawODGfGaU8YEI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9SS8xYvDDXn9WVbwPCF3mSV5IyX7ycabS6Bfy8DTb46Q&oe=6A3A87CC"}, {"file_name": "MutantBoxingLeague-031.png", "id": "253587871073402", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982609_253587874406735_7178836111610468479_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gLckDEX9vOEQ7kNvwHJuedO&_nc_oc=AdrtA1gjttg-sB2cGO8dFezvs5XPkjgF7NFHD7mti9uNn2MZoV9huuoRiy-PsGaShGc&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-88FaAhczLAktDw3kFo6yQ0xZToZL8mrUP9bwKribFLw&oe=6A3AA382"}, {"file_name": "MutantBoxingLeague-03.png", "id": "803737228109369", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39035321_803737231442702_8964584080987227603_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GsY0WEeK51MQ7kNvwEffX4T&_nc_oc=AdouqJGMGQ5XeKhuDpvRBtnsH6xhWwef0s_0hJgKeJRnJf4zCoZzdbq3VBH60033BWk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_kyZvuhhGRV9ihHRYgmxSepu0yNBU_h5QcxfrQ-dxaYQ&oe=6A3A8DF2"}, {"file_name": "MutantBoxingLeague-04.png", "id": "294515520233523", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75639798_294515523566856_4775055710151128191_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ESaxIHpY2yMQ7kNvwEKqPK-&_nc_oc=Ado0g2po-PYngZDjcx2Gft9Mf8YAQZM37wHgKNyKI1r4nfJgteT2UlniDhqJPMFkJ38&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8HKcsMQN1wZE-oGG1c89oVZ88NH3ZqR4kPlGL5dAdnog&oe=6A3AAA7D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer-cover.png", "id": "348786024450996", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39036670_348786027784329_8943992481801574654_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sB0evxv6oFAQ7kNvwF8bhBW&_nc_oc=Adp9KdBD4FprCJy8TLCPxhI1Y-JtWXqyT9BR6cV2hxz9LggAO7plMqbKBTMviHvPgu8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8f8JXk5bM5CRZIF6DzcwaqWFRyvmOXsTDQBCXzzcdEKw&oe=6A3A914E"}, "display_name": "Mutant Boxing League", "keywords": [], "long_description": "Make your daily workout into something fun!\n\n- Fight different boxers, each with their own unique boxing style and abilities.\n- Progress through the matches to unlock and explore new opponents, environments and gloves.\n- Learn how to effectively utilize special gloves like the power glove and speed glove.\n- Play with family or friends and beat personal highscores.\n\nTraining is something you could really enjoy while playing this game. With open outdoor environments, different levels and opponents that all have the different abilities and skills, you will also learn to be a better boxer. Boxing is not all about attack, but also learn how to block and dodge punches. And when or if you get knocked, you need to complete different mini-games in time to be able to continue the fight.\n\nNow, let's play and become an unstoppable boxing champion!", "short_description": "Box against fantasy creatures in nice outdoor environments. Exercise while having as fun! Mutant Boxing League is like playing an boxing arcade game while exercising!"}]}, "developer_name": "Filmic Studios", "developer_privacy_policy_url": "https://filmicstudios.se/privacy", "developer_terms_of_service_url": null, "publisher_name": "Filmic Studios", "support_website_url": null, "website_url": "https://filmicstudios.se/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}, {"id": "2710427532541308"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "636204241946284"}}]}, "scheduled_offers": {"count": 12, "nodes": [{"status": "PUBLISHED", "id": "1845286306321247"}, {"status": "PUBLISHED", "id": "1700369044261660"}, {"status": "PUBLISHED", "id": "1957883128109125"}, {"status": "PUBLISHED", "id": "1517260776227503"}, {"status": "CANCELLED", "id": "1402379484795248"}, {"status": "CANCELLED", "id": "1578052290298236"}, {"status": "PUBLISHED", "id": "698990999583201"}, {"status": "PUBLISHED", "id": "1301903231130222"}, {"status": "PUBLISHED", "id": "355020867681591"}, {"status": "PUBLISHED", "id": "869132048460971"}, {"status": "PUBLISHED", "id": "1082557849663749"}, {"status": "PUBLISHED", "id": "1017869112607772"}]}, "baseline_offer": {"id": "869132048460971"}, "is_approved": true, "firstOffer": {"nodes": [{
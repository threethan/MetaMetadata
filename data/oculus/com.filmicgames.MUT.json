scdn.com/v/t64.5771-25/473392000_993492169586956_1948454237516452146_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=06YUh07dy8gQ7kNvwEGY4U5&_nc_oc=AdlJHZ99BhuEENyjOotnqbk9WZdscX_WUq3nonTmC7yvZO84zIAgwhn18SbkLqPXCFQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_AftV7MxQ3xO-7bzpOzCFoofGPJIbUMrQATTotFKmMTrXDg&oe=69A43EF5"}, {"file_name": "MUT-screenshots_0004_Layer-4.png", "id": "1339708413982223", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473391911_1339708417315556_1576473059195060309_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1GKheqDCqV4Q7kNvwG9jM3Z&_nc_oc=Adklyczhgp2GchVu3lkYbtK13G5Y4KxQEQoQRW1EOxT2NXRfkAtIHB8ctw6JzZiZYg8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_AfsAMgg51ol9G8Osra2WOoe7eLRAevJ9v1HiC7AO7Gtlcg&oe=69A42868"}, {"file_name": "MUT_Gameplay_MR_v02.png", "id": "1691352974808451", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473391924_1691352978141784_8099257676331556317_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U38DRkshXrIQ7kNvwFCpQuc&_nc_oc=AdkuWzFcMhEH7jyl6qUKBraLTqDhZj1HdxMXNaJHzj6gdjLaYOs1D97pzyykhahe-yc&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_Afu4hlwXFgWhpfqIeq4pSzvvhSZn4s1XEEAZcCs5unAwaQ&oe=69A433DF"}, {"file_name": "MUT-screenshots_0006_Layer-1.png", "id": "2615536645274227", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974482_2615536648607560_6052236317170598783_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xBdJFxKN5bsQ7kNvwHTQ8XS&_nc_oc=AdmQsgAOigP1xcngHpAX1ValiYeqhzKIsPUtcF1X0nvObOiofRf3hc_483gSV5AShmE&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_Afu_Md72Z6YXSrMFrC9wKDaAcbR04VgQa2eX3OM8w8caIA&oe=69A44B34"}, {"file_name": "MUT_Gameplay_ape_v02.png", "id": "672593495148138", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473391924_672593501814804_1752950830627007562_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5OdZfzt7lycQ7kNvwEJA4HN&_nc_oc=Adm3ugS-XVDVwGUNffaSjJbCLXNjcer78003tnxRzvZaJOv1GSIF-bEC49Y6_ZUehoU&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfssO9ATi-rHemwVR-0HKfk5wsohUFoaBpuOrIodo27xiQ&oe=69A41D8B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Promotiontest-2.png", "id": "463471329898859", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982510_463471333232192_8427622215650267924_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YWeCWnM2TlwQ7kNvwFkVYzz&_nc_oc=AdkhKbpPY4POazJeLVN5urg0W1p09G23_IzUYR8PVH-QiS5_QW0lCvGUZa-CIQ2WHMU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AfuSzcTf_GNQT8QqZTWGeTScHI8ji6krdrNyOwiZIZ4LDA&oe=69A4264D"}, "display_name": "Mutant Boxing League", "keywords": ["boxing", "fighting", "mixedreality", "workout", "exercise"], "long_description": "Inject some fun boxing into your daily workout and dominate as a boxing champion!\n\n\ud83c\udfc6 Experience our latest update with Mixed Reality boxing mode, allowing you to exercise in even the smallest spaces or even outside.\n* Fight different boxers, each with their own unique boxing style and abilities.\n* Progress through the matches to unlock and explore new opponents, environments and gloves.\n* Boxing tutorials - learn how to attack and defend.\n* Learn how to effectively utilize special gloves like the power glove and speed glove.\n* Several Minigames included to master and compete with Global Highscores.\n* Try the Challenges that unlocks unique boxing glove skins.\n* Weekly Challenges to keep you in shape! \n* Hardcore mode for the real experienced boxers.\n\nOur aim is to make training as enjoyable as possible. With open outdoor environments, different levels and opponents that all have the different abilities and skills, you will learn to be a better boxer. Boxing is not all about attack, but also learn how to block and dodge punches. And when or if you get knocked down, complete the different mini-games in time, to continue the fight.\n\nDon't wait any longer - step into the ring and unleash your inner warrior. \n\nJoin our Discord!\nhttps://discord.com/invite/k9bCaKbXks\n{1083050756747663}", "short_description": "A playful boxing game! Learn how to jab, block, dodge and slip punches. Fight different mutant opponents with unique boxing styles. Learn how to use features such as the powerglowe. Several minigames also included for training or compete with global highscores. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://filmicstudios.se/privacy", "developer_terms_of_service_url": null, "publisher_name": "Filmic Studios", "support_website_url": "https://filmicstudios.se/#Contact", "website_url": "https://filmicstudios.se/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "2710427532541308"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8879042718863388"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/57570307_7054802327945500_8551928990858318411_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GHJJ_NEhSUQQ7kNvwE_jjcS&_nc_oc=AdlYJzZ-3Lp0t9Ed4nF0BloRh4IuYoABtCbZ1jBhYdDr0Xl3HyfcteEW0RP7qeXh8kI&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfvGyR-vobwDkSFM7BxDrfvst1ddU0hS6oL63yvtrvSujg&oe=69A4415F"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Mutant Boxing League", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context
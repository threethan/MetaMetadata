.com/v/t64.5771-25/38974692_201031793055480_7909991526784956407_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5dq_7jscyiUQ7kNvwHyDH8u&_nc_oc=AdrL_tEilfJXeuytI9Lj4Ut_UzMaYLg6JKrnVvfdsNqcMp7x_JAeONAs-O6MwxpKqnQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9w5xN3iLV4VxcxFdQVJaLEmhofz2GCMPPgL4cYD9HiZA&oe=6A2D7057"}]}, "id": "742081604594700", "locale": "en_US", "screenshots": [{"file_name": "MUT_CoverArt_2560x1440_v01.png", "id": "715115680534390", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75416834_715115683867723_421827735563796911_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8Oufyy4Mt14Q7kNvwEliYnM&_nc_oc=Adr7bBN5QBYcuQE2vyRnEl1hZlf6oeCGk8VcJH2oPKSd_fUbvw1vcp3pRFuN23tOYZA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-ObaZzqAnJ2TNNgxpjUNgUcaKBWkRRn3NBTrTZSO3HTA&oe=6A2D6EFB"}, {"file_name": "MutantBoxingLeague-021.png", "id": "1300537890659057", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/57568677_1300537893992390_8529547455366557532_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gXE70OgHMr0Q7kNvwGRS7Df&_nc_oc=AdqvGWGGsI52mOBCg7x7AMxK08atUPmxEGhg1ffIDrqX9jHepq_B_C72beHGmzk1Ur0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_MnugaWER41Nren_zEddk9u_mFMH0IZsulXYEcyDzLJw&oe=6A2D58CC"}, {"file_name": "MutantBoxingLeague-031.png", "id": "253587871073402", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982609_253587874406735_7178836111610468479_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=78JB0UaT2xcQ7kNvwEZbZ6N&_nc_oc=Adoa9xoeb6VYTLE6SKIpEawrvniS1F2TgTM7sCoJS53RFROffr_GDtzExt0BnMb81K8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_cWWFK3lE0TcLe0qusbDJXqBui30fhQogoEcivif6X7A&oe=6A2D7482"}, {"file_name": "MutantBoxingLeague-03.png", "id": "803737228109369", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39035321_803737231442702_8964584080987227603_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m9AJpptKX-sQ7kNvwEN_7-H&_nc_oc=AdryWAEDJpGnsJAQw72foggQN5ZQEooPrrYF331fY0c6pl99q3wOYDM7Ret80-F8sao&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-qhOya2afrVTEIytK0LqWr1fTAzNKfs7sMOs51rJ8sCA&oe=6A2D5EF2"}, {"file_name": "MutantBoxingLeague-04.png", "id": "294515520233523", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75639798_294515523566856_4775055710151128191_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9BupwY3HF5IQ7kNvwGHbXp-&_nc_oc=Adrt2xWWx7lNgMa58d-FNc44D8uUVw8aw9U4n8OQxry4HKhrwqWc_RmO2hD8xUJMIpY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8QDsoY0MkQHInNg5kwpkCLvNTt_a-HmP8gV75355vMfg&oe=6A2D7B7D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer-cover.png", "id": "348786024450996", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39036670_348786027784329_8943992481801574654_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3wvTZ3p1O08Q7kNvwEcn7ss&_nc_oc=AdolDL_ht52J93c1a49Eyh8aTBhZJQiQjCaE1f_uFnNy0pJtcxRMdxNSPNHfYsNAFcI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-zZvaLKEunQgWcTzL6g48dsFcwCuvbahbVBUdiyjyCog&oe=6A2D624E"}, "display_name": "Mutant Boxing League", "keywords": [], "long_description": "Make your daily workout into something fun!\n\n- Fight different boxers, each with their own unique boxing style and abilities.\n- Progress through the matches to unlock and explore new opponents, environments and gloves.\n- Learn how to effectively utilize special gloves like the power glove and speed glove.\n- Play with family or friends and beat personal highscores.\n\nTraining is something you could really enjoy while playing this game. With open outdoor environments, different levels and opponents that all have the different abilities and skills, you will also learn to be a better boxer. Boxing is not all about attack, but also learn how to block and dodge punches. And when or if you get knocked, you need to complete different mini-games in time to be able to continue the fight.\n\nNow, let's play and become an unstoppable boxing champion!", "short_description": "Box against fantasy creatures in nice outdoor environments. Exercise while having as fun! Mutant Boxing League is like playing an boxing arcade game while exercising!"}]}, "developer_name": "Filmic Studios", "developer_privacy_policy_url": "https://filmicstudios.se/privacy", "developer_terms_of_service_url": null, "publisher_name": "Filmic Studios", "support_website_url": null, "website_url": "https://filmicstudios.se/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}, {"id": "2710427532541308"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "636204241946284"}}]}, "scheduled_offers": {"count": 12, "nodes": [{"status": "PUBLISHED", "id": "1845286306321247"}, {"status": "PUBLISHED", "id": "1700369044261660"}, {"status": "PUBLISHED", "id": "1957883128109125"}, {"status": "PUBLISHED", "id": "1517260776227503"}, {"status": "CANCELLED", "id": "1402379484795248"}, {"status": "CANCELLED", "id": "1578052290298236"}, {"status": "PUBLISHED", "id": "698990999583201"}, {"status": "PUBLISHED", "id": "1301903231130222"}, {"status": "PUBLISHED", "id": "355020867681591"}, {"status": "PUBLISHED", "id": "869132048460971"}, {"status": "PUBLISHED", "id": "1082557849663749"}, {"status": "PUBLISHED", "id": "1017869112607772"}]}, "baseline_offer": {"id": "869132048460971"}, "is_approved": true, "firstOffer": {"nodes": [{
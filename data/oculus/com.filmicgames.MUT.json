ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4peX7PkHycgQ7kNvwG7-gxa&_nc_oc=Adn3h6lvVWlmp6yWYX3iYy2_1dGu_YGDN-CHt_-wf2gW5_lJTCJQR9glOi6RRz5eHe0&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfxR9ETCGO1megiMnjeU7ioXZV10gab_yIZLzCgAOvZnTw&oe=69BBD88B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Promotiontest-2.png", "id": "463471329898859", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982510_463471333232192_8427622215650267924_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ySNa83OQJcYQ7kNvwHxq1W1&_nc_oc=Adlbu588kky7TZhPQlsIYtRzn2w3S_8XfI7JTRe92WPL519ksSELhATNzHIVxx6S2bA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_Afxjn8xtBIzeyj3gnq4jHBqcx4_0YmhCsD00sjkFOl0nyA&oe=69BBE14D"}, "display_name": "Mutant Boxing League", "keywords": ["boxing", "fighting", "mixedreality", "workout", "exercise"], "long_description": "Inject some fun boxing into your daily workout and dominate as a boxing champion!\n\n\ud83c\udfc6 Experience our latest update with Mixed Reality boxing mode, allowing you to exercise in even the smallest spaces or even outside.\n* Fight different boxers, each with their own unique boxing style and abilities.\n* Progress through the matches to unlock and explore new opponents, environments and gloves.\n* Boxing tutorials - learn how to attack and defend.\n* Learn how to effectively utilize special gloves like the power glove and speed glove.\n* Several Minigames included to master and compete with Global Highscores.\n* Try the Challenges that unlocks unique boxing glove skins.\n* Weekly Challenges to keep you in shape! \n* Hardcore mode for the real experienced boxers.\n\nOur aim is to make training as enjoyable as possible. With open outdoor environments, different levels and opponents that all have the different abilities and skills, you will learn to be a better boxer. Boxing is not all about attack, but also learn how to block and dodge punches. And when or if you get knocked down, complete the different mini-games in time, to continue the fight.\n\nDon't wait any longer - step into the ring and unleash your inner warrior. \n\nJoin our Discord!\nhttps://discord.com/invite/k9bCaKbXks\n{1083050756747663}", "short_description": "A playful boxing game! Learn how to jab, block, dodge and slip punches. Fight different mutant opponents with unique boxing styles. Learn how to use features such as the powerglowe. Several minigames also included for training or compete with global highscores. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://filmicstudios.se/privacy", "developer_terms_of_service_url": null, "publisher_name": "Filmic Studios", "support_website_url": "https://filmicstudios.se/#Contact", "website_url": "https://filmicstudios.se/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "2710427532541308"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8879042718863388"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/57570307_7054802327945500_8551928990858318411_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZLvLzpGRzr8Q7kNvwGmCZ_L&_nc_oc=AdmNTt5Gsp-9ON7F7b0_6vh53dg9AH47HYbCha9aZoRF6QIPbHLjL9_UcmrUdsSYxdE&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfwwzUqIDLwhRcVZFg_l1t-SvXM-YRdBluBXPNcdai8xLw&oe=69BBFC5F"}, "is_concept": false, "is_test": false, "is_
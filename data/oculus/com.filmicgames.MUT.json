.com/v/t64.5771-25/38974692_201031793055480_7909991526784956407_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=az8p2cYelI0Q7kNvwG82C-5&_nc_oc=Adqa5bhGsrEyforRm0R0bqNwCrfZ8xy5aP2VvARPfFeHOKu3V1PG6n72fdUQ6hq1wck&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCk0MznDXIbPGZvLiB-teQmOrFtZMzfUmK9YCjVyN2Qgg&oe=6A5B5C97"}]}, "id": "742081604594700", "locale": "en_US", "screenshots": [{"file_name": "MUT_CoverArt_2560x1440_v01.png", "id": "715115680534390", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75416834_715115683867723_421827735563796911_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NUeJlZlKofwQ7kNvwGauPKc&_nc_oc=AdqwkxuFKa62e2G6mPf8mLRZUsC86GfomL-tL8WzPZqPQRcKOsp0XbjzzjsTv5F-pG8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCXVXHgXXRVqp5YyjGluzB-O7h1pbG7itiixKFHH5Jzsw&oe=6A5B937B"}, {"file_name": "MutantBoxingLeague-021.png", "id": "1300537890659057", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/57568677_1300537893992390_8529547455366557532_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fqbSTkaOXjEQ7kNvwGP1OIA&_nc_oc=AdoKADDiCsSKZmkiOzu_rP9UnMZ7eCo611nHjkNLKcLFxSz_J2Ty2ip5fK5og9rZEf8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA_vrSvaJyFDL3_M0CC5cEMNViJYK9QQztD68BiabQa1Q&oe=6A5B7D4C"}, {"file_name": "MutantBoxingLeague-031.png", "id": "253587871073402", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982609_253587874406735_7178836111610468479_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZbuBvztCHGoQ7kNvwEFwRYa&_nc_oc=AdpBrwgVJZgDVTdh6UyY46jABeJMR6tETaxOZGhDoKAoHE36ojgcKpfYbf1CDjsqkC8&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBGEKJiF5GYhsUgLKEr7wWaO54xLUfdQ4E8vbud95uSbg&oe=6A5B60C2"}, {"file_name": "MutantBoxingLeague-03.png", "id": "803737228109369", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39035321_803737231442702_8964584080987227603_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AGh57LHpWX0Q7kNvwFri341&_nc_oc=Adp9LQ9avR3RP1BNYEoNUzhn9gWxJPxmBH2zi7a170vQ_O56SXk3HqHj6SCWCQXPSdE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC6PRFkgfqVmrIkmFQH3uGiOJBVffPgWVwAi945ntXL9A&oe=6A5B8372"}, {"file_name": "MutantBoxingLeague-04.png", "id": "294515520233523", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75639798_294515523566856_4775055710151128191_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AwjzJuvC2zIQ7kNvwEGBBMG&_nc_oc=AdphlTioGwJyoUsTcjAamSbh2YN1jHjeida7uy9LRy3b0Fzus6hUELzI7yIPax3lG_k&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDesg3ktJNTS-cxNWc79qb4qucA0dDwaaT3G6Q8Ts4BsA&oe=6A5B67BD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer-cover.png", "id": "348786024450996", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39036670_348786027784329_8943992481801574654_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hYY2cFNwZA0Q7kNvwFLKbBc&_nc_oc=Adq3dHBa8iJk0KFpyV9GKcbqCTgCS8sKxOu6l0fELq96uaNMJ8RCgDN82HEZL0VC-J4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDvC6oO49tLGc0ALIyFlAxU5SMgBf4ANZNdFFp8O2jyfw&oe=6A5B86CE"}, "display_name": "Mutant Boxing League", "keywords": [], "long_description": "Make your daily workout into something fun!\n\n- Fight different boxers, each with their own unique boxing style and abilities.\n- Progress through the matches to unlock and explore new opponents, environments and gloves.\n- Learn how to effectively utilize special gloves like the power glove and speed glove.\n- Play with family or friends and beat personal highscores.\n\nTraining is something you could really enjoy while playing this game. With open outdoor environments, different levels and opponents that all have the different abilities and skills, you will also learn to be a better boxer. Boxing is not all about attack, but also learn how to block and dodge punches. And when or if you get knocked, you need to complete different mini-games in time to be able to continue the fight.\n\nNow, let's play and become an unstoppable boxing champion!", "short_description": "Box against fantasy creatures in nice outdoor environments. Exercise while having as fun! Mutant Boxing League is like playing an boxing arcade game while exercising!"}]}, "developer_name": "Filmic Studios", "developer_privacy_policy_url": "https://filmicstudios.se/privacy", "developer_terms_of_service_url": null, "publisher_name": "Filmic Studios", "support_website_url": null, "website_url": "https://filmicstudios.se/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}, {"id": "2710427532541308"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "636204241946284"}}]}, "scheduled_offers": {"count": 13, "nodes": [{"status": "PUBLISHED", "id": "3628097954014271"}, {"status": "PUBLISHED", "id": "1845286306321247"}, {"status": "PUBLISHED", "id": "1700369044261660"}, {"status": "PUBLISHED", "id": "1957883128109125"}, {"status": "PUBLISHED", "id": "1517260776227503"}, {"status": "CANCELLED", "id": "1402379484795248"}, {"status": "CANCELLED", "id": "1578052290298236"}, {"status": "PUBLISHED", "id": "698990999583201"}, {"status": "PUBLISHED", "id": "1301903231130222"}, {"status": "PUBLISHED", "id": "355020867681591"}, {"status": "PUBLISHED", "id": "869132048460971"}, {"status": "PUBLISHED", "id": "1082557849663749"}, {"status": "PUBLISHED", "id": "1017869112607772"}]}, "baseline_offer": {"id": "869132048460971
}]}, "id": "702772195425281", "locale": "en_US", "screenshots": [{"file_name": "MUT_Gameplay_oil_v02.png", "id": "993492166253623", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473392000_993492169586956_1948454237516452146_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lFNgBxJIQgEQ7kNvwFHjtES&_nc_oc=Adq_1moQ0U7c7i1Fmuy7AV17JwyjHEtCRhr_-ZJSjjs_mT_fWR7GTXrDwiEOA2yPD3I&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afyir7SKQ_m2ow2aGqSYeIPQoNyVPGaznB01YX2ZrnGCnA&oe=69C928F5"}, {"file_name": "MUT-screenshots_0004_Layer-4.png", "id": "1339708413982223", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391911_1339708417315556_1576473059195060309_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Lza4e9MwyIoQ7kNvwE36jAY&_nc_oc=AdrB9KuV2OsNvMjMdkrKfpmI8j-Rq-lvxynHievh1Jv04lwPna1O63RZVcaow0vBwvU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afzd0lYnMn09nUJortkfY6IZwuNVT7bgGJSMc1nDsCKNNw&oe=69C91268"}, {"file_name": "MUT_Gameplay_MR_v02.png", "id": "1691352974808451", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391924_1691352978141784_8099257676331556317_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YLfpaM0bkTEQ7kNvwEKHFTu&_nc_oc=AdrE0UVEIdKPXocJxPdPBMqfH6-9tLa3e6fvs6conyIfoUmVwGFZ6Q-TmMkDt-lBgyo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzM1lJWfViV9_B7r8PC8Pq2dLIzWGd_RiYn8nIptPV7ug&oe=69C91DDF"}, {"file_name": "MUT-screenshots_0006_Layer-1.png", "id": "2615536645274227", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974482_2615536648607560_6052236317170598783_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oFoZByJugfAQ7kNvwH3QQXP&_nc_oc=Adrp34g2ClCt2KIPPmaKvudj3MoNjAA5bj5yjaZzR2uo3APt8oKVyXi3AugDXaoJFZU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afxmcx6H9sBDmzghvuVqW7BPuQIpiCeam5zPx8k0W2pnDw&oe=69C93534"}, {"file_name": "MUT_Gameplay_ape_v02.png", "id": "672593495148138", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391924_672593501814804_1752950830627007562_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mUXeOaKZyQcQ7kNvwE1cIx5&_nc_oc=AdoiiIIx_LbQRCZbbZ5QuaKk9EEORxv4FxQ1lzWxD7EifNi7PthOPGyTP6PScrZjH0I&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzIWF2DpBVv76M1tuxXFutItOJ7jFU4JPX6QYSLtTy32Q&oe=69C9078B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Promotiontest-2.png", "id": "463471329898859", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982510_463471333232192_8427622215650267924_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8AIHJ69eirsQ7kNvwEUgqaJ&_nc_oc=AdrklMvn30DrbiQmFAnxPi1W6G90_hYuvl7w6JJjJan8iZ4OF0gEyZuje49BivsMsYU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxpcbEXingWTcLHDdEsDk4FkKRCAr4brqsOp77O4mMYqw&oe=69C9104D"}, "display_name": "Mutant Boxing League", "keywords": ["boxing", "fighting", "mixedreality", "workout", "exercise"], "long_description": "Inject some fun boxing into your daily workout and dominate as a boxing champion!\n\n\ud83c\udfc6 Experience our latest update with Mixed Reality boxing mode, allowing you to exercise in even the smallest spaces or even outside.\n* Fight different boxers, each with their own unique boxing style and abilities.\n* Progress through the matches to unlock and explore new opponents, environments and gloves.\n* Boxing tutorials - learn how to attack and defend.\n* Learn how to effectively utilize special gloves like the power glove and speed glove.\n* Several Minigames included to master and compete with Global Highscores.\n* Try the Challenges that unlocks unique boxing glove skins.\n* Weekly Challenges to keep you in shape! \n* Hardcore mode for the real experienced boxers.\n\nOur aim is to make training as enjoyable as possible. With open outdoor environments, different levels and opponents that all have the different abilities and skills, you will learn to be a better boxer. Boxing is not all about attack, but also learn how to block and dodge punches. And when or if you get knocked down, complete the different mini-games in time, to continue the fight.\n\nDon't wait any longer - step into the ring and unleash your inner warrior. \n\nJoin our Discord!\nhttps://discord.com/invite/k9bCaKbXks\n{1083050756747663}", "short_description": "A playful boxing game! Learn how to jab, block, dodge and slip punches. Fight different mutant opponents with unique boxing styles. Learn how to use features such as the powerglowe. Several minigames also included for training or compete with global highscores. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://filmicstudios.se/privacy", "developer_terms_of_service_url": null, "publisher_name": "Filmic Studios", "support_website_url": "https://filmicstudios.se/#Contact", "website_url": "https://filmicstudios.se/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "2710427532541308"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8879042718863388"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/57570307_7054802327945500_8551928990858318411_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=78gu38XW6DcQ7kNvwHmKcox&_nc_oc=AdoI10-5bS7Nvsc5MXlExHczApleP0dZpzIvBU_247t4Ou-yCFbQwYhEAadjZonT9ic&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwVuZt6GJ3h2g0dBOi9mXEGL
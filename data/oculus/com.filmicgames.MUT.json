.com/v/t64.5771-25/38974692_201031793055480_7909991526784956407_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jBOaRFiy4MwQ7kNvwG2-Kk8&_nc_oc=AdqG1Hxz2uqogBcQrhBw70Jg8AT3h7IQ5Jdf_2A3V4QiZWThoFF4t5uU6zAee_FJDg0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAyuhXmxRtsAVLP_kG5DNm-Q1kWIBlaEKl-0ezkvpOdKw&oe=6A4D1457"}]}, "id": "742081604594700", "locale": "en_US", "screenshots": [{"file_name": "MUT_CoverArt_2560x1440_v01.png", "id": "715115680534390", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75416834_715115683867723_421827735563796911_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I1DT7wPE3u8Q7kNvwHM7MHr&_nc_oc=AdpZqkevhD2PPUdn6Vs0SmH7eJYP8eIYLz4sD0Q--asoJosSMYehHFc43uGifdfaO0s&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCqLFZ0WC1IS5-psHYILw9Ot_eue4HJihlOZ0PXGWu_Wg&oe=6A4D12FB"}, {"file_name": "MutantBoxingLeague-021.png", "id": "1300537890659057", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/57568677_1300537893992390_8529547455366557532_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nC10B-hQ9c8Q7kNvwHxMZCl&_nc_oc=AdqyLgF_V0wJ9ZLWBFxRsChQzH8D8a4GhDhsRLoSQguaT-7dbfUjlB9he7Xs6Ce6XVQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB68Cm8rZlYHxxY-IQtvQwNGnUHEzQZDFpiyiu-CcPILA&oe=6A4CFCCC"}, {"file_name": "MutantBoxingLeague-031.png", "id": "253587871073402", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982609_253587874406735_7178836111610468479_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6mA7Fo15sc0Q7kNvwGOo9E9&_nc_oc=AdqjNR3ZmFb12GLXK86O9K2-ktwe5EvAGnaru_RqYl5E9gH2HMSKgoi5GQqIwTmyJ8I&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCsJqR8TSKaPFGcUbn4iKOvDt5BxBkRZsq6bPePsOMX9g&oe=6A4D1882"}, {"file_name": "MutantBoxingLeague-03.png", "id": "803737228109369", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39035321_803737231442702_8964584080987227603_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_e0LZHAJvq0Q7kNvwFmtCtx&_nc_oc=Adqp-wWWHmb8t-WWOon_PHkWgdVwLSG-oD0yCfg6VaNn1T-uR-iiTOxWn8pbQCKdDiQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCH5M1e0SMP5iwSNPt8gkNNsVaSgi4oFV7wSzB6AtLjJw&oe=6A4D02F2"}, {"file_name": "MutantBoxingLeague-04.png", "id": "294515520233523", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75639798_294515523566856_4775055710151128191_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UFdaw-raQTMQ7kNvwGK1-hz&_nc_oc=AdpWEGan8x6Z0fajX2qkZoD3SHS2QSf8DRBSR60vs7MpiKgBjPG43nJ4IU-DsrchHCg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB60xD1m2PQ9A_WKhqi4ule2CopKm5dmuoxPikrIWl4Jw&oe=6A4CE73D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer-cover.png", "id": "348786024450996", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39036670_348786027784329_8943992481801574654_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NgUsqEmec_QQ7kNvwEWIsKX&_nc_oc=AdqS0KnhASZ7vdObG6p3Vvjx45lK-BKymGYzJ9NS46OajFHQBSPiBjBplVNMINAzLsQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC1JYE4VwwloaQFcFdT0uLRIUCM6t7C4Y9oUhMakLYEeQ&oe=6A4D064E"}, "display_name": "Mutant Boxing League", "keywords": [], "long_description": "Make your daily workout into something fun!\n\n- Fight different boxers, each with their own unique boxing style and abilities.\n- Progress through the matches to unlock and explore new opponents, environments and gloves.\n- Learn how to effectively utilize special gloves like the power glove and speed glove.\n- Play with family or friends and beat personal highscores.\n\nTraining is something you could really enjoy while playing this game. With open outdoor environments, different levels and opponents that all have the different abilities and skills, you will also learn to be a better boxer. Boxing is not all about attack, but also learn how to block and dodge punches. And when or if you get knocked, you need to complete different mini-games in time to be able to continue the fight.\n\nNow, let's play and become an unstoppable boxing champion!", "short_description": "Box against fantasy creatures in nice outdoor environments. Exercise while having as fun! Mutant Boxing League is like playing an boxing arcade game while exercising!"}]}, "developer_name": "Filmic Studios", "developer_privacy_policy_url": "https://filmicstudios.se/privacy", "developer_terms_of_service_url": null, "publisher_name": "Filmic Studios", "support_website_url": null, "website_url": "https://filmicstudios.se/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}, {"id": "2710427532541308"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "636204241946284"}}]}, "scheduled_offers": {"count": 12, "nodes": [{"status": "PUBLISHED", "id": "1845286306321247"}, {"status": "PUBLISHED", "id": "1700369044261660"}, {"status": "PUBLISHED", "id": "1957883128109125"}, {"status": "PUBLISHED", "id": "1517260776227503"}, {"status": "CANCELLED", "id": "1402379484795248"}, {"status": "CANCELLED", "id": "1578052290298236"}, {"status": "PUBLISHED", "id": "698990999583201"}, {"status": "PUBLISHED", "id": "1301903231130222"}, {"status": "PUBLISHED", "id": "355020867681591"}, {"status": "PUBLISHED", "id": "869132048460971"}, {"status": "PUBLISHED", "id": "1082557849663749"}, {"status": "PUBLISHED", "id": "1017869112607772"}]}, "baseline_offer": {"id": "869132048460971"}, "is_approved": true, "firstOffer": {"nodes": [{
scdn.com/v/t64.5771-25/473392000_993492169586956_1948454237516452146_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BnrqdbBXSloQ7kNvwEeh7D5&_nc_oc=AdlNHSHNAMrYbs_BoPevMALxn9LMzNrG2H6QmE7x0oUVzMUJYlUOH3KuDe39EmhBhB4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfsbUZryH5oYi4V3cSNn1PVjqlJDZKqz09Ilpy_d-z0Xvg&oe=69A2ED75"}, {"file_name": "MUT-screenshots_0004_Layer-4.png", "id": "1339708413982223", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391911_1339708417315556_1576473059195060309_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1GKheqDCqV4Q7kNvwH5Yc_P&_nc_oc=AdmNWQoErq4iEaxYC7wB3AU7R1z4FAcZpmhnIY9p2wCDIq7oMgpLtNWnaNWenRCwu7I&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afv-MTtY7mSFZaqL-DLbTBpTA4-Dci59FMtAGxEaK_1WMQ&oe=69A2D6E8"}, {"file_name": "MUT_Gameplay_MR_v02.png", "id": "1691352974808451", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391924_1691352978141784_8099257676331556317_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U38DRkshXrIQ7kNvwG7TuXz&_nc_oc=AdnPxTGvATa9CV5tvqrGTPcmr0s943h3bwoxNy3vKrqLoNewQ8fYCIDTLBeXlxveUmM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AftHw7y9clnZKB4PZf4Gf06zkENq3cdWTOqnwYDBZ_z5VA&oe=69A2E25F"}, {"file_name": "MUT-screenshots_0006_Layer-1.png", "id": "2615536645274227", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974482_2615536648607560_6052236317170598783_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xBdJFxKN5bsQ7kNvwFwOCqw&_nc_oc=AdnoG-6V7IVewgard-oFEn_k7OaMsfqlzX89UQhSeoCi8pACqF4wC-LJSvfgJzUvhio&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AftlQCwroOS8Ri0ZGYtzRbO8AEpWo5M4YsZRduyQDm_zWQ&oe=69A2F9B4"}, {"file_name": "MUT_Gameplay_ape_v02.png", "id": "672593495148138", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473391924_672593501814804_1752950830627007562_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5OdZfzt7lycQ7kNvwERphuI&_nc_oc=AdmgOM4QzDMlIEDJ6_6Je-d1IIo8lzI9-_6hRtyZnoF-R92dJHoUlWJSgPfpPwsUOOA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfvbLodiyU6fRO7lnEWdrwSzl9Rf81WsafVRfUq_3-N8Qg&oe=69A2CC0B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Promotiontest-2.png", "id": "463471329898859", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982510_463471333232192_8427622215650267924_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YWeCWnM2TlwQ7kNvwFY7u9h&_nc_oc=Adl7fmhXpCILGuiXnnz1IkJcJ4Xjwn-ZHWY1Q2SgY_dh-8uASxb7oihHwaSX_-eJAmw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfsLGDrnM53St_YJFyDhMbQWwnXrTGMBoHZYGy9g-th0yQ&oe=69A2D4CD"}, "display_name": "Mutant Boxing League", "keywords": ["boxing", "fighting", "mixedreality", "workout", "exercise"], "long_description": "Inject some fun boxing into your daily workout and dominate as a boxing champion!\n\n\ud83c\udfc6 Experience our latest update with Mixed Reality boxing mode, allowing you to exercise in even the smallest spaces or even outside.\n* Fight different boxers, each with their own unique boxing style and abilities.\n* Progress through the matches to unlock and explore new opponents, environments and gloves.\n* Boxing tutorials - learn how to attack and defend.\n* Learn how to effectively utilize special gloves like the power glove and speed glove.\n* Several Minigames included to master and compete with Global Highscores.\n* Try the Challenges that unlocks unique boxing glove skins.\n* Weekly Challenges to keep you in shape! \n* Hardcore mode for the real experienced boxers.\n\nOur aim is to make training as enjoyable as possible. With open outdoor environments, different levels and opponents that all have the different abilities and skills, you will learn to be a better boxer. Boxing is not all about attack, but also learn how to block and dodge punches. And when or if you get knocked down, complete the different mini-games in time, to continue the fight.\n\nDon't wait any longer - step into the ring and unleash your inner warrior. \n\nJoin our Discord!\nhttps://discord.com/invite/k9bCaKbXks\n{1083050756747663}", "short_description": "A playful boxing game! Learn how to jab, block, dodge and slip punches. Fight different mutant opponents with unique boxing styles. Learn how to use features such as the powerglowe. Several minigames also included for training or compete with global highscores. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://filmicstudios.se/privacy", "developer_terms_of_service_url": null, "publisher_name": "Filmic Studios", "support_website_url": "https://filmicstudios.se/#Contact", "website_url": "https://filmicstudios.se/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "2710427532541308"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8879042718863388"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/57570307_7054802327945500_8551928990858318411_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GHJJ_NEhSUQQ7kNvwFLC0yQ&_nc_oc=Adn7WEliRreArrqsD6Z2GmsQ0rL1FH5sPYfP-L_ecZt4n0VP2ibaSphECq3akEwSaLY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfsJfvvSXH7bLU7y15mqup3hm4gKIuyUxhK2GcgX521wWg&oe=69A2EFDF"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Mutant Boxing League", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context
.com/v/t64.5771-25/38974692_201031793055480_7909991526784956407_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=az8p2cYelI0Q7kNvwGDCpNO&_nc_oc=AdrjBNqx4T5f0YCLkymKzt5QR90_624fs7jss1iv8VWLEOhOzmfCGPoe8VbyuIwIiZc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDzlBFxWCkMEDOujpKIKoDiBwHgBY9DOUE0HLEmluS5-w&oe=6A5E37D7"}]}, "id": "742081604594700", "locale": "en_US", "screenshots": [{"file_name": "MUT_CoverArt_2560x1440_v01.png", "id": "715115680534390", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75416834_715115683867723_421827735563796911_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BZUq4yQ0EXYQ7kNvwEIKxdb&_nc_oc=AdqJV_Ucf9cTZ9mJ_8SOPySDqsuuHhjsqUgVV1J_Ddpo2AW7OCsfHbNGIo6TB7-oMYU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAtEWb0t81SgrmE-K6EemtufpO4G8og3NREs8OO-QqVcw&oe=6A5E367B"}, {"file_name": "MutantBoxingLeague-021.png", "id": "1300537890659057", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/57568677_1300537893992390_8529547455366557532_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fqbSTkaOXjEQ7kNvwGSfntP&_nc_oc=Adr_-y5PU1LZbocDzafxhenzNOZ_wbhGXm1MDTsb5DkNBP2otkJLifldTBWLcTUGArI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDEFxaT03HjkiJu1fOZcWWL1w02tv0t8Vx8_0bKznx_8A&oe=6A5E204C"}, {"file_name": "MutantBoxingLeague-031.png", "id": "253587871073402", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982609_253587874406735_7178836111610468479_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZbuBvztCHGoQ7kNvwHrFVGT&_nc_oc=AdrtbOR9LQqeu82xyAaLHDvbKYCwd9zmGViZVPP4OSUI850aN8VpcNjYzxrAhSPnD3U&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBPP7nLO2mi6U-0SorcmSYXXGzvD1N94CA_7LSYOACobQ&oe=6A5E03C2"}, {"file_name": "MutantBoxingLeague-03.png", "id": "803737228109369", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39035321_803737231442702_8964584080987227603_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=krIc2H-I1o0Q7kNvwF5COp6&_nc_oc=AdoY99awQo_7Rovi3SMkodzSVW6VmoUmz0ZrBMhAmwHx1r37Ev0lhoDKouEmD2Wv3X4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBiUGuR1txsgXaegZ83VzcSgWyu8nJRW1TETGFkCBee7g&oe=6A5E2672"}, {"file_name": "MutantBoxingLeague-04.png", "id": "294515520233523", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75639798_294515523566856_4775055710151128191_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=irTXeNCUAJgQ7kNvwEzrtB-&_nc_oc=Adr7IuauHmIpslbE_P7ECa0R-9Mv7AbH5xlqbU6EeId5P-4wCE33BsBFDPs4yWqxxd8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDbf44hgCrufvCh1gMaqYiY0oo4n0X9GRZ9pLUMH-cMzQ&oe=6A5E0ABD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer-cover.png", "id": "348786024450996", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39036670_348786027784329_8943992481801574654_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hYY2cFNwZA0Q7kNvwGTOk52&_nc_oc=AdoEvYCumscfodN7bD7FeRQlaqhc9yuWXJ6WLfgRPzkrhqSwigp25n6OW5dfzDlslE0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC5eExomdcSER_XgguDCqXt8xWTACbZ9GrYzgYGKOtAfA&oe=6A5E29CE"}, "display_name": "Mutant Boxing League", "keywords": [], "long_description": "Make your daily workout into something fun!\n\n- Fight different boxers, each with their own unique boxing style and abilities.\n- Progress through the matches to unlock and explore new opponents, environments and gloves.\n- Learn how to effectively utilize special gloves like the power glove and speed glove.\n- Play with family or friends and beat personal highscores.\n\nTraining is something you could really enjoy while playing this game. With open outdoor environments, different levels and opponents that all have the different abilities and skills, you will also learn to be a better boxer. Boxing is not all about attack, but also learn how to block and dodge punches. And when or if you get knocked, you need to complete different mini-games in time to be able to continue the fight.\n\nNow, let's play and become an unstoppable boxing champion!", "short_description": "Box against fantasy creatures in nice outdoor environments. Exercise while having as fun! Mutant Boxing League is like playing an boxing arcade game while exercising!"}]}, "developer_name": "Filmic Studios", "developer_privacy_policy_url": "https://filmicstudios.se/privacy", "developer_terms_of_service_url": null, "publisher_name": "Filmic Studios", "support_website_url": null, "website_url": "https://filmicstudios.se/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}, {"id": "2710427532541308"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "636204241946284"}}]}, "scheduled_offers": {"count": 13, "nodes": [{"status": "PUBLISHED", "id": "3628097954014271"}, {"status": "PUBLISHED", "id": "1845286306321247"}, {"status": "PUBLISHED", "id": "1700369044261660"}, {"status": "PUBLISHED", "id": "1957883128109125"}, {"status": "PUBLISHED", "id": "1517260776227503"}, {"status": "CANCELLED", "id": "1402379484795248"}, {"status": "CANCELLED", "id": "1578052290298236"}, {"status": "PUBLISHED", "id": "698990999583201"}, {"status": "PUBLISHED", "id": "1301903231130222"}, {"status": "PUBLISHED", "id": "355020867681591"}, {"status": "PUBLISHED", "id": "869132048460971"}, {"status": "PUBLISHED", "id": "1082557849663749"}, {"status": "PUBLISHED", "id": "1017869112607772"}]}, "baseline_offer": {"id": "869132048460971
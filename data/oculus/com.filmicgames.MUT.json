=1-7&_nc_sid=6e7a0a&_nc_ohc=9AztcuSt6WIQ7kNvwHDXWHj&_nc_oc=Adq_jIHyA8kcf-XVYWictiFbHUZ3LGcknTRS8Nn1msqvN-tVkUzzwhJTyQWB7esaaYo&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFZkse5udrlCocz8oP7s_ZqVGrzRZDCVe5cm2FDKRZg_g&oe=6A857B32"}, {"file_name": "MutantBoxingLeague-04.png", "id": "294515520233523", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/75639798_294515523566856_4775055710151128191_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sFm52SttkiIQ7kNvwEld3sP&_nc_oc=Adpvj-fmPXwSCocFn-qUZrllp3TpXzDUbXYjAv9q9jB0SM1ZjYbV53IVU12-x_enyio&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF9nEjINCB1xzHrEynLI8KyPnoxLSO_hXn4foDBv3xUug&oe=6A8597BD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer-cover.png", "id": "348786024450996", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/39036670_348786027784329_8943992481801574654_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_VKI80grOuEQ7kNvwET6RF9&_nc_oc=AdpKBfOe3OVqtdzCu0NbvW_Hbs6xy9fvw4VHCicRJAg2j-hof2D5rP7LwUpTx3Jx0yU&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQERsxDlop8Frb07yU2FuyMn8V8HnH3lKZGFfBoAcrVQ4w&oe=6A857E8E"}, "display_name": "Mutant Boxing League", "keywords": [], "long_description": "Make your daily workout into something fun!\n\n- Fight different boxers, each with their own unique boxing style and abilities.\n- Progress through the matches to unlock and explore new opponents, environments and gloves.\n- Learn how to effectively utilize special gloves like the power glove and speed glove.\n- Play with family or friends and beat personal highscores.\n\nTraining is something you could really enjoy while playing this game. With open outdoor environments, different levels and opponents that all have the different abilities and skills, you will also learn to be a better boxer. Boxing is not all about attack, but also learn how to block and dodge punches. And when or if you get knocked, you need to complete different mini-games in time to be able to continue the fight.\n\nNow, let's play and become an unstoppable boxing champion!", "short_description": "Box against fantasy creatures in nice outdoor environments. Exercise while having as fun! Mutant Boxing League is like playing an boxing arcade game while exercising!"}]}, "developer_name": "Filmic Studios", "developer_privacy_policy_url": "https://filmicstudios.se/privacy", "developer_terms_of_service_url": null, "publisher_name": "Filmic Studios", "support_website_url": null, "website_url": "https://filmicstudios.se/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}, {"id": "2710427532541308"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "636204241946284"}}]}, "scheduled_offers": {"count": 13, "nodes": [{"status": "PUBLISHED", "id": "3628097954014271"}, {"status": "PUBLISHED", "id": "1845286306321247"}, {"status": "PUBLISHED", "id": "1700369044261660"}, {"status": "PUBLISHED", "id": "1957883128109125"}, {"status": "PUBLISHED", "id": "1517260776227503"}, {"status": "CANCELLED", "id": "1402379484795248"}, {"status": "CANCELLED", "id": "1578052290298236"}, {"status": "PUBLISHED", "id": "698990999583201"}, {"status": "PUBLISHED", "id": "1301903231130222"}, {"status": "PUBLISHED", "id": "355020867681591"}, {"status": "PUBLISHED", "id": "869132048460971"}, {"status": "PUBLISHED", "id": "1082557849663749"}, {"status": "PUBLISHED", "id": "10178
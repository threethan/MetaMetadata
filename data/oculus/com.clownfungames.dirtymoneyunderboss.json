&_nc_sid=6e7a0a&_nc_ohc=MB3fDMtcu9UQ7kNvwF-VoVf&_nc_oc=AdqBCSHE87ypH5y0SoH3nGtveil8ZgHVIu94AqXp3VZJ9RHswLRHWL63eyztoimyZ_4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQyQ2yp2o8C8AFptrujOZjDAKCUYTH1NCR1BHMLNx67ew&oe=6B0DA0FF"}, {"file_name": "05_street_brawl.png", "id": "1173807421979443", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499620559_1173807425312776_3958819317212695646_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZODeHAMeKMcQ7kNvwE0mTY_&_nc_oc=AdqWUkMpPQ0hio2Z3FpIaCjaq2Zoku_lvb94j9BsDgRbxs7vdhXEJCOpGh3f_73lSNc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQ1hu5IIE7ojZ9Wjw5quLQm6AzA_VcWMYzCMTJU2VD9KQ&oe=6B0DC770"}, {"file_name": "03_empire.png", "id": "2134339594138769", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499628067_2134339597472102_2700743627481822825_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Gh_hS8o8LKQQ7kNvwElg6zx&_nc_oc=AdrKsA0bKeQIZjjSDneVWu5isyKvjkAhyKKtnxqsfEokvj0ArqzMM-qjd-5jWIi18YM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQdw_kMAHye1UM7femVp8BVveTbku7PgI-9vGXrZ9sivQ&oe=6B0DC68E"}, {"file_name": "02_weapon_fight.png", "id": "1639474354506195", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/593858738_1639474357839528_7666285447674166460_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XyGW3NjNM0gQ7kNvwGOoC5-&_nc_oc=Ado9SqXSZ6xVJE-DEego_Rbgy9qnqn6cwRmsWolvyaMq6LtyYP9azhR3mx2WthojEE8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTAuleZuTNYTno9YgHX97UZyGaoxgP1aD45pXdSpijDhw&oe=6B0DBE69"}, {"file_name": "04_kidnap.png", "id": "41252259787706745", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499622188_41252259801040077_4665356505235769392_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l36LE-7SxxgQ7kNvwHc2pcD&_nc_oc=AdoEyjlDDiEavuOgWPq0yPl_gu5xJgWV27debjTDQB4YflZ4T6rpuzfyIjhRMS-ANxE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRekE62Ai1wVSvq6b4z8_SrVTKCLNAd6Ek8mbr5v1p4eg&oe=6B0DD114"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "mafia-boss-simulator-bold-2560x1440.png", "id": "1451374680394853", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/593808163_1451374687061519_4107162887425974077_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D3XR9Tly4SIQ7kNvwHva7N4&_nc_oc=AdqZgqVs8gkg0FQ7WW8yLqlM0rvlFx2FUE9Lqyv5AXFrAD97e9wAB2bdqY7fCfMBMLI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQhVk96JOCdao405CaXDTuKfcG9HPoGIbBrcCVRmTIsAw&oe=6B0DAB6D"}, "display_name": "Mafia Boss Simulator", "keywords": ["Combat", "Fighting", "Violent"], "long_description": "Mafia Boss Simulator is a physics-driven VR crime game where you fight your way from street crew to boss of the city.\n\nEvery fight is up close and personal. Throw real punches, grab men by the collar, slam them into walls and feel every hit land. Pick up bats, knives, axes and sledgehammers and swing them with real weight, or stab and twist when it gets ugly. Your enemies fight back: they block, dodge, brawl, grab weapons off the floor and come at you with their own style.\n\nBetween fights, you run the business. Cook and sell drugs from your hideout, buy supplies, stash your product and make deals across the city. Leave a batch cooking while you are out on a job and come home to the finished product. Take jobs from your board: raid rival stashes, defend your hideout, kidnap an accountant from a car wash and drag him back to your basement to make him talk. Every job pays, and every job brings heat.\n\nKeep the cops off your back, or they will come knocking and search your place. Win bare-knuckle cage fights for big purses. Crush the rival cartels one by one, hire crew, buy weapons and grow your hideout as your cash piles up.\n\nBuilt for VR from the ground up:\n- Full-body physics combat with fists, blunt weapons and blades\n- Enemies with real hit reactions, gore and lasting injuries\n- A crime empire to run: drugs, jobs, cash, heat and crew\n- Fully voiced characters\n- Three save files\n\nStart with nothing. Leave with everything. Your city. Your rules.\n", "short_description": "Mafia Boss Simulator is a physics-driven VR crime game. Throw real punches, grab men by the collar and fight with bats, knives and axes against enemies who fight back. Between fights, run your empire: cook and sell drugs, take jobs, kidnap rivals, win cage fights, hire crew and keep the cops off your back. Start with nothing and become the boss of the city.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/privacypolicyclownfungamesvr/home", "developer_terms_of_service_url": null, "publisher_name": "Clowny", "support_website_url": null, "website_url": "https://sites.google.com/view/clownfungamesvrgame/home?pli=1&authuser=0", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2710427532541308"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1484662168057749"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "2662559124190320"}]}, "baseline_offer": {"id": "2662559124190320"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1795090200, "status": "PUBLISHED", "id": "2662559124190320"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__type
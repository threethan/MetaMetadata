q6LtyYP9azhR3mx2WthojEE8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTAuleZuTNYTno9YgHX97UZyGaoxgP1aD45pXdSpijDhw&oe=6B0DBE69"}, {"file_name": "04_kidnap.png", "id": "41252259787706745", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499622188_41252259801040077_4665356505235769392_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l36LE-7SxxgQ7kNvwHc2pcD&_nc_oc=AdoEyjlDDiEavuOgWPq0yPl_gu5xJgWV27debjTDQB4YflZ4T6rpuzfyIjhRMS-ANxE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRekE62Ai1wVSvq6b4z8_SrVTKCLNAd6Ek8mbr5v1p4eg&oe=6B0DD114"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "mafia-boss-simulator-bold-2560x1440.png", "id": "1451374680394853", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/593808163_1451374687061519_4107162887425974077_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D3XR9Tly4SIQ7kNvwHva7N4&_nc_oc=AdqZgqVs8gkg0FQ7WW8yLqlM0rvlFx2FUE9Lqyv5AXFrAD97e9wAB2bdqY7fCfMBMLI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQhVk96JOCdao405CaXDTuKfcG9HPoGIbBrcCVRmTIsAw&oe=6B0DAB6D"}, "display_name": "Mafia Boss Simulator", "keywords": ["Combat", "Fighting", "Violent"], "long_description": "Mafia Boss Simulator is a physics-driven VR crime game where you fight your way from street crew to boss of the city.\n\nEvery fight is up close and personal. Throw real punches, grab men by the collar, slam them into walls and feel every hit land. Pick up bats, knives, axes and sledgehammers and swing them with real weight, or stab and twist when it gets ugly. Your enemies fight back: they block, dodge, brawl, grab weapons off the floor and come at you with their own style.\n\nBetween fights, you run the business. Cook and sell drugs from your hideout, buy supplies, stash your product and make deals across the city. Leave a batch cooking while you are out on a job and come home to the finished product. Take jobs from your board: raid rival stashes, defend your hideout, kidnap an accountant from a car wash and drag him back to your basement to make him talk. Every job pays, and every job brings heat.\n\nKeep the cops off your back, or they will come knocking and search your place. Win bare-knuckle cage fights for big purses. Crush the rival cartels one by one, hire crew, buy weapons and grow your hideout as your cash piles up.\n\nBuilt for VR from the ground up:\n- Full-body physics combat with fists, blunt weapons and blades\n- Enemies with real hit reactions, gore and lasting injuries\n- A crime empire to run: drugs, jobs, cash, heat and crew\n- Fully voiced characters\n- Three save files\n\nStart with nothing. Leave with everything. Your city. Your rules.\n", "short_description": "Mafia Boss Simulator is a physics-driven VR crime game. Throw real punches, grab men by the collar and fight with bats, knives and axes against enemies who fight back. Between fights, run your empire: cook and sell drugs, take jobs, kidnap rivals, win cage fights, hire crew and keep the cops off your back. Start with nothing and become the boss of the city.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/privacypolicyclownfungamesvr/home", "developer_terms_of_service_url": null, "publisher_name": "Clowny", "support_website_url": null, "website_url": "https://sites.google.com/view/clownfungamesvrgame/home?pli=1&authuser=0", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2710427532541308"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS
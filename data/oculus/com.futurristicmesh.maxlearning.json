64.5771-25/491823901_1315200154020101_8246063684243962701_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=98ngwip0u-wQ7kNvwEhClgg&_nc_oc=Adq0O0XbY3IFbuv10LFw8MSoBaNlFrVc4T0wWgYU9MfWdGYxeQRFW84TWM7fK1FWLcs&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLe_oiRz4N7s5MR0f0zj6EwvboX5UeW6-FsRXeRm8yHzA&oe=6AA16D7B"}, {"file_name": "com.futurristic.FuturristicDentalMR-20260724-153302 1.png", "id": "1741540067160034", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/491824292_1741540070493367_2125271303480643781_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g28W7qZJMJcQ7kNvwGcPlDy&_nc_oc=AdrXsIFdR8XHpEt6ceSI38VPR38U926joR9vHAfBQWBqgczTbQp1URu1tggYfO8Toiw&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL4p_w6bCHjPSUiIqUxCQwkF0Qq-bGeezIR3E4NAiKvOA&oe=6AA172BF"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Max Learning Experience", "keywords": [], "long_description": "MAX \u2014 Dental Learning Reimagined in VR\nStep into a fully immersive dental training environment designed for students, educators, and institutions. MAX transforms how dentistry is learned \u2014 replacing expensive simulation labs and limited patient access with unlimited, hands-on virtual practice.\nPractice Real Procedures Perform cavity preparations, restorations, and clinical procedures on lifelike 3D patients with realistic dental anatomy. Repeat any procedure as many times as you need \u2014 mistakes here make you better, not liable.\nLearn by Doing Guided step-by-step modules walk you through each procedure, from instrument handling to complete treatments. Interactive 3D anatomy lets you explore teeth, roots, and oral structures from every angle \u2014 in ways no textbook can match.\nTrack Your Progress Built-in assessment tracks your precision and technique across sessions, helping you identify weak areas and measure improvement over time.\nDesigned for Dental Education Created with dental educators, MAX aligns with clinical curricula and is trusted by dental universities for pre-clinical skills training. Perfect for individual students, classrooms, and institutional simulation programs.\nKey Features:\nRealistic virtual patients with accurate dental anatomy\nStep-by-step guided procedure training\nInteractive 3D tooth and oral anatomy explorer\nSkill assessment and progress tracking\nComfortable, intuitive controls built for extended learning sessions\nWhether you're a 1st year dental student.", "short_description": "Master dental procedures in immersive VR. Practice on virtual patients, sharpen your skills, and learn anytime \u2014 no clinic required."}]}, "developer_name": null, "developer_privacy_policy_url": "https://maxlearning.ai/privacy-policy", "developer_terms_of_service_url": "https://maxlearning.ai/user-agreement", "publisher_name": "FUTURRISTICMESH TECHNOLOGY SOLUTIONS", "support_website_url": null, "website_url": "https://maxlearning.ai/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "478089301798119"}, {"id": "1043107547362485"}, {"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "901168796380068"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/654867655_1557887221860367_8635348550938955816_n.png?stp=dst-png_s360x360&_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-ISmQJ4K0NMQ7kNvwHVS74B&_nc_oc=AdoeLKxdA8oJIlwH-iibPbqutEy3nMpWcuNQhd9af
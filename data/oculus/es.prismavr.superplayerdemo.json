2564_2084726195012925_8787888506217961424_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3PGCt830cJoQ7kNvwFDu_EH&_nc_oc=AdlnnOzaWt56eC7g6Ot1m-zf58Acm0zO3-b3hZ_6eFzmxpLDGzsqY5T4FZ-xDqhOYJQ&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfyIzsDV5_IhAHLjq8zva0WF59W69oawbvaR0wVWhwhMRA&oe=69B7EA2F"}, {"file_name": "Screenshot02.png", "id": "162835689277691", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982488_162835692611024_5312462952174339653_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=p-UzeaXVQTwQ7kNvwFVSnFB&_nc_oc=AdlXocv4CLQGUptWLKwm56_iOqEddkk_AibicSmSL_lADg-VWgjjeNuFkKlf7cC39jE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_Afx-Aul8uc4ZNtTOWcNaucx8t6yaolHiGBxnYGKIujQm0A&oe=69B7F9EB"}, {"file_name": "Screenshot00.png", "id": "186037890181676", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974444_186037893515009_7924042357741847006_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5mpxIQ4PTj0Q7kNvwGouGJv&_nc_oc=Adl9w0304B-v_Saz_22C0zIF263OSSjGWpk6fIpqlAuHxYFSU9HgWOjfqk_Vb4XGJ5U&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfzXoKUzUP34H_GioEy8kNk3i03QECmlKgTWmUg7Zee5Cg&oe=69B7F956"}, {"file_name": "Screenshot05.png", "id": "4134419250011897", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38984447_4134419253345230_1332729510369002148_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ja5J4MVQBpYQ7kNvwH8QFsl&_nc_oc=AdnIofnt8rEBYyIbBdT19JFoIpZStVTwBkA98IqAl6NQ9cbEBp8UNwu4C-zOLANdJ0c&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfyahF2fKBP2LPYsBRZfZX6dfYbRTPYy12va_OIH6epJGA&oe=69B81416"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BeFootball_SuperPlayer_DEMO_CoverImage.png", "id": "567915194391029", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/227814954_567915197724362_6983002246118726272_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ajg8gsX0lFEQ7kNvwEIIi0K&_nc_oc=AdmDkvo7EWRncbQmkY_sSTE1vcYHmqRCl_fHWmH9mKss750KWazcaPS1QALWKRxd2A8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfxmysSQd1ZrtiFZBgHJAnHpI_u6fLHboOyPi8nxb5Gumw&oe=69B7FC5C"}, "display_name": "BF Super Player Demo", "keywords": [], "long_description": "In BeFootball - SuperPlayer full version, football fans will be able to participate in a frenetic game of stopping penalties or heading balls, being the super stars of the beautiful game and achieving success thanks to their shooting or stopping skills, speed, power, precision ... to reach the maximum score and come out victorious.\n\nWelcome a frenetic soccer virtual reality experience to test your best moves and sports skills while being in a breath-taking stadium. \n\nFeatured in the DEMO version:\n - Goalkeeper Mode:  become a goalkeeper and stop as many balls as possible\n - Header Mode: become a striker and head the ball to hit the scoring panels and test your header accuracy.\n\nGet ready for the match!\n\n  Full game coming soon, with:\n     - New Keeper game modes\n     - New Kicker game modes\n     - New Rhythm Fitness mode\n     - More stadiums\n     - More challenges\n     - And more ...", "short_description": "BeFootball - SuperPlayer is a frenetic soccer virtual reality experience to test your best moves and sport skills while being in a breath-taking stadium.\n\nFeatured in the DEMO version:\n - Goalkeeper Mode:  become a goalkeeper and stop as many balls as possible\n - Header Mode: become a striker and head the ball to hit the scoring panels and test your accuracy.\n"}]}, "developer_name": "Prisma VR Studio", "developer_privacy_policy_url": "https://befootball.world/superplayer-vr-demo-privacy-policy", "developer_terms_of_service_url": "https://befootball.world/legal-notice", "publisher_name": "BeFootball", "support_website_url": "https://befootball.world/contact", "website_url": "https://befootball.world/superplayer", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "contex
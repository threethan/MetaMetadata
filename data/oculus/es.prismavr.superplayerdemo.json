2564_2084726195012925_8787888506217961424_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3W4QkeTmKjAQ7kNvwGF5C3b&_nc_oc=AdkJBBDhG2v4oKF4Q4NwUc0uO1CMGKGiGEzqaE39aW6s5zR6IY3vKdF0ndn2q-R_ocM&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afxw_i1Ub7bSd74iEuLY7zv50bF_Sii2qWa27Zix1EfD4g&oe=69B2A42F"}, {"file_name": "Screenshot02.png", "id": "162835689277691", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982488_162835692611024_5312462952174339653_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uU-UCUW2wIwQ7kNvwFWswE6&_nc_oc=AdnsqdzKscZ_ZjSnnwAFcPMtLkQaaM7HJMNnadDCuD0whVNPU4aL6A7BGe4YGas_KvU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfzZWM9xSeYTJGXW0Ic9vQqXnj39u4R4dq7rrRZ3GoOwmg&oe=69B2B3EB"}, {"file_name": "Screenshot00.png", "id": "186037890181676", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974444_186037893515009_7924042357741847006_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=An8qqC_oRKIQ7kNvwH7G7Vn&_nc_oc=AdnlSR-AhIrmE-f45eQisCpFtHAN1xp1XiOGi0t-2tBLGl6eJemPsqfB1Uz27G3PfKQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfzTezzb3U_MJZ54_d5Eqx_P5E-qR78lsn4IVCH4zJXr6A&oe=69B2B356"}, {"file_name": "Screenshot05.png", "id": "4134419250011897", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38984447_4134419253345230_1332729510369002148_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QLPAuLq1GRsQ7kNvwGccE76&_nc_oc=Adn7PTKnJXpBVfNwC2idjJocLQnaIW8-uHWen4G2JUhbrIzU2_HMm2SRT0ZWkPc8xRM&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfyuPSfU55nw7zr-lhIVOEJWlZWtTezd2MbATPj8uJW3sg&oe=69B2CE16"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BeFootball_SuperPlayer_DEMO_CoverImage.png", "id": "567915194391029", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/227814954_567915197724362_6983002246118726272_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9cIV8dECr6EQ7kNvwF8x1Kk&_nc_oc=AdkeLPEhSvWDMbeFZ4tPVAtRxpxz3gu4rK80V6wedZwGjCXdSBykQQdFr_TrQqoRtMc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_Afwk9UAAlzCvC4uk5xLb4IY76Y52RwVmL1nbNUhxZi1_pQ&oe=69B2B65C"}, "display_name": "BF Super Player Demo", "keywords": [], "long_description": "In BeFootball - SuperPlayer full version, football fans will be able to participate in a frenetic game of stopping penalties or heading balls, being the super stars of the beautiful game and achieving success thanks to their shooting or stopping skills, speed, power, precision ... to reach the maximum score and come out victorious.\n\nWelcome a frenetic soccer virtual reality experience to test your best moves and sports skills while being in a breath-taking stadium. \n\nFeatured in the DEMO version:\n - Goalkeeper Mode:  become a goalkeeper and stop as many balls as possible\n - Header Mode: become a striker and head the ball to hit the scoring panels and test your header accuracy.\n\nGet ready for the match!\n\n  Full game coming soon, with:\n     - New Keeper game modes\n     - New Kicker game modes\n     - New Rhythm Fitness mode\n     - More stadiums\n     - More challenges\n     - And more ...", "short_description": "BeFootball - SuperPlayer is a frenetic soccer virtual reality experience to test your best moves and sport skills while being in a breath-taking stadium.\n\nFeatured in the DEMO version:\n - Goalkeeper Mode:  become a goalkeeper and stop as many balls as possible\n - Header Mode: become a striker and head the ball to hit the scoring panels and test your accuracy.\n"}]}, "developer_name": "Prisma VR Studio", "developer_privacy_policy_url": "https://befootball.world/superplayer-vr-demo-privacy-policy", "developer_terms_of_service_url": "https://befootball.world/legal-notice", "publisher_name": "BeFootball", "support_website_url": "https://befootball.world/contact", "website_url": "https://befootball.world/superplayer", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "contex
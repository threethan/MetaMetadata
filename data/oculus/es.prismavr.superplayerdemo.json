2564_2084726195012925_8787888506217961424_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UgB_Bu-vi7EQ7kNvwEdzJXm&_nc_oc=AdnvQnsVUDBSOulTS2a6PpUdAu8J0NxhzWVBtZstdi1KVqDAmOaPAQB5JxZi4A1cvH0&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=8&oh=00_AfwGexJ1FUG-eMvzTz95VMN1T2yaxS91kzS510Ua1Gz2Kg&oe=69BD302F"}, {"file_name": "Screenshot02.png", "id": "162835689277691", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38982488_162835692611024_5312462952174339653_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BxqaHfhUG6cQ7kNvwGw6PH3&_nc_oc=AdkABXojiDlktWb97Nc4Z7amI2PnMS1G0GeU_MPJetFjn74KVYKx5sCww9bPPVFaE9s&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=8&oh=00_AfzVLbtmgGEXdMeDXxwAXxFJb5Gxkt3QmpQEW5tNhJj2Og&oe=69BD3FEB"}, {"file_name": "Screenshot00.png", "id": "186037890181676", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974444_186037893515009_7924042357741847006_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=71O-EZI_M9AQ7kNvwH_UFQH&_nc_oc=AdkwviwhZkw-B1z77YWZY6lzfQ1M-zMaTGWGxCpZMPRmxhbp7FshhVGp_5xcmwKK9Hs&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=8&oh=00_Afzq0YgRfhOoptGFd-7SacJ2TPnZlKlnOypUzDHY_H8lMA&oe=69BD3F56"}, {"file_name": "Screenshot05.png", "id": "4134419250011897", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38984447_4134419253345230_1332729510369002148_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8sxhmjcMHRwQ7kNvwG9Yyrz&_nc_oc=AdneRuiTGJ-ImiPTnbojrDSD-sY9MbGZGBmDJ556uFbnXgtfzC09RjvPHVhfr9U4u6g&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=8&oh=00_AfxDMd7WbUXvkm-NEuGR8HbnGdfPqeN3HUXI9krpPow-CQ&oe=69BD5A16"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BeFootball_SuperPlayer_DEMO_CoverImage.png", "id": "567915194391029", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/227814954_567915197724362_6983002246118726272_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NMRc9JuOUuUQ7kNvwGNU8H5&_nc_oc=AdkAGjdLTst8j_lcoA90G5Be8uHvO3HlliHsMD7D5bj_C_HJxTPqEUqkeaV533aWdlo&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=8&oh=00_AfyUN7JX9B_fINCRk2vXb5m4bkHXX4bkUFeEFVta7fcafA&oe=69BD425C"}, "display_name": "BF Super Player Demo", "keywords": [], "long_description": "In BeFootball - SuperPlayer full version, football fans will be able to participate in a frenetic game of stopping penalties or heading balls, being the super stars of the beautiful game and achieving success thanks to their shooting or stopping skills, speed, power, precision ... to reach the maximum score and come out victorious.\n\nWelcome a frenetic soccer virtual reality experience to test your best moves and sports skills while being in a breath-taking stadium. \n\nFeatured in the DEMO version:\n - Goalkeeper Mode:  become a goalkeeper and stop as many balls as possible\n - Header Mode: become a striker and head the ball to hit the scoring panels and test your header accuracy.\n\nGet ready for the match!\n\n  Full game coming soon, with:\n     - New Keeper game modes\n     - New Kicker game modes\n     - New Rhythm Fitness mode\n     - More stadiums\n     - More challenges\n     - And more ...", "short_description": "BeFootball - SuperPlayer is a frenetic soccer virtual reality experience to test your best moves and sport skills while being in a breath-taking stadium.\n\nFeatured in the DEMO version:\n - Goalkeeper Mode:  become a goalkeeper and stop as many balls as possible\n - Header Mode: become a striker and head the ball to hit the scoring panels and test your accuracy.\n"}]}, "developer_name": "Prisma VR Studio", "developer_privacy_policy_url": "https://befootball.world/superplayer-vr-demo-privacy-policy", "developer_terms_of_service_url": "https://befootball.world/legal-notice", "publisher_name": "BeFootball", "support_website_url": "https://befootball.world/contact", "website_url": "https://befootball.world/superplayer", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "contex
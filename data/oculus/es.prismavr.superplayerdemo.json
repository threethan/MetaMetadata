2564_2084726195012925_8787888506217961424_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=46ZoLk6PwvMQ7kNvwEO0VPz&_nc_oc=AdmM0i1KRC8jP1jyS8Efpuj1K8VoPjHx0OmcZ6cuR3Fc8zqIN6fbVKPyRxXTOC8-rd4&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfxHLIgJH2KJU7gwgL5qZcINNaKVVtI6cEUJD-LidICbjQ&oe=69B698AF"}, {"file_name": "Screenshot02.png", "id": "162835689277691", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982488_162835692611024_5312462952174339653_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YlNjIdjSSv4Q7kNvwHAjUC7&_nc_oc=Adm_B_XXqn1fyUioMFqslHA_h5fXyf89lSo0pjDBY4qNUkirtmZhGKW6sNwUtrkR6G8&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfxGidhhaypEJhT0XxGrlYa0b596YTwBSAq-Ejtl7wHBVw&oe=69B6A86B"}, {"file_name": "Screenshot00.png", "id": "186037890181676", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974444_186037893515009_7924042357741847006_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5mpxIQ4PTj0Q7kNvwFJ3_PF&_nc_oc=AdmPyXkPAi2JHRe5fzElUjFWu8ngVxWgYQCLBqZB6zwk95-BX8xMy0MOpSsB0lUvcRs&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfyEtVAr5-cbHrkcv-FVQn1NkEKgqh12sCoO9A-ob61OGg&oe=69B6A7D6"}, {"file_name": "Screenshot05.png", "id": "4134419250011897", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38984447_4134419253345230_1332729510369002148_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ja5J4MVQBpYQ7kNvwGsqVYk&_nc_oc=Adm08eJ4UPmY3i8KHTO_W4DPQBAoNelihNoeYGl1yngvg00zA73i722CGV_Cy1BhVlk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfzHRdYKpc_mAtaEi-EsfKyE9CUtUEpgOBf7g7fi9IUNnQ&oe=69B6C296"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BeFootball_SuperPlayer_DEMO_CoverImage.png", "id": "567915194391029", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/227814954_567915197724362_6983002246118726272_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uV3PvuHQPycQ7kNvwFrzf_Y&_nc_oc=AdnLtUrJRkGCcx1dQJwmf0p4Bx5E0rjJ2sTatt0tpR565sAMuBdbsOe41xgsfAuEpR0&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfytNdirAqUb9lPlSagCa592pyVW2sgggyPJGy5M3v1XbQ&oe=69B6AADC"}, "display_name": "BF Super Player Demo", "keywords": [], "long_description": "In BeFootball - SuperPlayer full version, football fans will be able to participate in a frenetic game of stopping penalties or heading balls, being the super stars of the beautiful game and achieving success thanks to their shooting or stopping skills, speed, power, precision ... to reach the maximum score and come out victorious.\n\nWelcome a frenetic soccer virtual reality experience to test your best moves and sports skills while being in a breath-taking stadium. \n\nFeatured in the DEMO version:\n - Goalkeeper Mode:  become a goalkeeper and stop as many balls as possible\n - Header Mode: become a striker and head the ball to hit the scoring panels and test your header accuracy.\n\nGet ready for the match!\n\n  Full game coming soon, with:\n     - New Keeper game modes\n     - New Kicker game modes\n     - New Rhythm Fitness mode\n     - More stadiums\n     - More challenges\n     - And more ...", "short_description": "BeFootball - SuperPlayer is a frenetic soccer virtual reality experience to test your best moves and sport skills while being in a breath-taking stadium.\n\nFeatured in the DEMO version:\n - Goalkeeper Mode:  become a goalkeeper and stop as many balls as possible\n - Header Mode: become a striker and head the ball to hit the scoring panels and test your accuracy.\n"}]}, "developer_name": "Prisma VR Studio", "developer_privacy_policy_url": "https://befootball.world/superplayer-vr-demo-privacy-policy", "developer_terms_of_service_url": "https://befootball.world/legal-notice", "publisher_name": "BeFootball", "support_website_url": "https://befootball.world/contact", "website_url": "https://befootball.world/superplayer", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "contex
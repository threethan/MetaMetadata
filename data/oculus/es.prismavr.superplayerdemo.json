kS6gkiSRID8vhw7bh3bpMVENLS52C6w7STyu4E5IsGCr31f0&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQmmWSfOvRInKQOO_xHUf07SCApt1QwUn1wI7aZDUDE4g&oe=6AFB4BD6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BeFootball_SuperPlayer_DEMO_CoverImage.png", "id": "567915194391029", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/227814954_567915197724362_6983002246118726272_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7yWBl244slwQ7kNvwFJyTAe&_nc_oc=AdooEfzU5Xsxdf4Tmy7aI6BZqiqqAD43EgDglnC72gMvJC-oJb3Dq_U6SNSBZjQIa8I&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQPdK1LiKN8uS93jBR9R9thQ93T8MlsanWydDMPx1NtXw&oe=6AFB341C"}, "display_name": "BF Super Player Demo", "keywords": [], "long_description": "In BeFootball - SuperPlayer full version, football fans will be able to participate in a frenetic game of stopping penalties or heading balls, being the super stars of the beautiful game and achieving success thanks to their shooting or stopping skills, speed, power, precision ... to reach the maximum score and come out victorious.\n\nWelcome a frenetic soccer virtual reality experience to test your best moves and sports skills while being in a breath-taking stadium. \n\nFeatured in the DEMO version:\n - Goalkeeper Mode:  become a goalkeeper and stop as many balls as possible\n - Header Mode: become a striker and head the ball to hit the scoring panels and test your header accuracy.\n\nGet ready for the match!\n\n  Full game coming soon, with:\n     - New Keeper game modes\n     - New Kicker game modes\n     - New Rhythm Fitness mode\n     - More stadiums\n     - More challenges\n     - And more ...", "short_description": "BeFootball - SuperPlayer is a frenetic soccer virtual reality experience to test your best moves and sport skills while being in a breath-taking stadium.\n\nFeatured in the DEMO version:\n - Goalkeeper Mode:  become a goalkeeper and stop as many balls as possible\n - Header Mode: become a striker and head the ball to hit the scoring panels and test your accuracy.\n"}]}, "developer_name": "Prisma VR Studio", "developer_privacy_policy_url": "https://befootball.world/superplayer-vr-demo-privacy-policy", "developer_terms_of_service_url": "https://befootball.world/legal-notice", "publisher_name": "BeFootball", "support_website_url": "https://befootball.world/contact", "website_url": "https://befootball.world/superplayer", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SPORTS"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "352800129762191"}}]}, "scheduled_offers": {"count": 0, "nodes": []}, "baseline_offer": null, "is_approved": true, "firstOffer": {"nodes": []}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "5525108654236927", "version": "1.0"}, "id": "288072439667071", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "4009925382421936", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "5525108654236927"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "288072439667071"}]}, "change_log": null, "created_date": 1667230444, 
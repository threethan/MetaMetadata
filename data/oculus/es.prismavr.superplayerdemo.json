2564_2084726195012925_8787888506217961424_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0sMyRa564PQQ7kNvwG6Xsye&_nc_oc=AdkNdFt7E_37ae0f8ovL8UzWWgsz0aSa-jloyYUvK9JE9UO3vdIKG9O0OczQxOmfnDo&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfwRawVNx8R6ua3yLi6lyabACW7mYD1VuhuimIPDEXvwUQ&oe=69AC0CAF"}, {"file_name": "Screenshot02.png", "id": "162835689277691", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982488_162835692611024_5312462952174339653_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rjfx1aoFBEcQ7kNvwEyBeR8&_nc_oc=Adl5xJtJNWylRjrSmfXPcD4NyiUfULlgI9XHwgn9manvRpfd4J-0cQ0myM92o1FYVmc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfyUnYsuQBlRX_oFtgIxts2vzf2ap2x4I9_vR88l0kJx9w&oe=69AC1C6B"}, {"file_name": "Screenshot00.png", "id": "186037890181676", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974444_186037893515009_7924042357741847006_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TYiPApZVxHQQ7kNvwFYma4H&_nc_oc=AdnDU2ADYcBLKOf8gjqlA_ndrzZUzWrXWPUcBxiUAoOHIcIw5-_eV6z-tFbuC0X7Mm0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_Afw12Usz5XenDd17WeiABGyfMLCdvELFC1sEJOXZ8xR1Tw&oe=69AC1BD6"}, {"file_name": "Screenshot05.png", "id": "4134419250011897", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38984447_4134419253345230_1332729510369002148_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n5rMNx1_XKoQ7kNvwEPSMmU&_nc_oc=AdmNuuuYGXeZEFRh5mtMRtXoluwPWreUihYdmblL44re2ZSDUx9OTuf7hWsGh8LDPPU&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afwx0SXHRhJ2B6c08K0EfjPePHac93FEiSyLG2H71JIJyg&oe=69AC3696"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BeFootball_SuperPlayer_DEMO_CoverImage.png", "id": "567915194391029", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/227814954_567915197724362_6983002246118726272_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R3XrRyl-F84Q7kNvwGZ-8p7&_nc_oc=AdmDf9cJAeJ7MiYsL7TEchuj-teMKLCYLLXalkYleQQi1jpQIUkAF_Au0HF2UYdq7jY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_Afz2B9eCvfJ0ensA40MVL04Qorhf8lhvKARskQsP7NvqPg&oe=69AC1EDC"}, "display_name": "BF Super Player Demo", "keywords": [], "long_description": "In BeFootball - SuperPlayer full version, football fans will be able to participate in a frenetic game of stopping penalties or heading balls, being the super stars of the beautiful game and achieving success thanks to their shooting or stopping skills, speed, power, precision ... to reach the maximum score and come out victorious.\n\nWelcome a frenetic soccer virtual reality experience to test your best moves and sports skills while being in a breath-taking stadium. \n\nFeatured in the DEMO version:\n - Goalkeeper Mode:  become a goalkeeper and stop as many balls as possible\n - Header Mode: become a striker and head the ball to hit the scoring panels and test your header accuracy.\n\nGet ready for the match!\n\n  Full game coming soon, with:\n     - New Keeper game modes\n     - New Kicker game modes\n     - New Rhythm Fitness mode\n     - More stadiums\n     - More challenges\n     - And more ...", "short_description": "BeFootball - SuperPlayer is a frenetic soccer virtual reality experience to test your best moves and sport skills while being in a breath-taking stadium.\n\nFeatured in the DEMO version:\n - Goalkeeper Mode:  become a goalkeeper and stop as many balls as possible\n - Header Mode: become a striker and head the ball to hit the scoring panels and test your accuracy.\n"}]}, "developer_name": "Prisma VR Studio", "developer_privacy_policy_url": "https://befootball.world/superplayer-vr-demo-privacy-policy", "developer_terms_of_service_url": "https://befootball.world/legal-notice", "publisher_name": "BeFootball", "support_website_url": "https://befootball.world/contact", "website_url": "https://befootball.world/superplayer", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "contex
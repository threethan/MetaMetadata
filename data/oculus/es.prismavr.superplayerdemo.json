2564_2084726195012925_8787888506217961424_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=46ZoLk6PwvMQ7kNvwGan1Ix&_nc_oc=Admbr2-8wncE9jaIMh9vjdfssAGVa1kg78BygFRsB6h_7GTXXHKqTFaeHhGbXAVjmoA&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afw6SLgT22j39MLx9i2ij279Lo7lx0XjUbEcpTSEGE1upA&oe=69B3F5AF"}, {"file_name": "Screenshot02.png", "id": "162835689277691", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982488_162835692611024_5312462952174339653_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YlNjIdjSSv4Q7kNvwG8mXtS&_nc_oc=AdkkaCyBt2kH9q91Lz7_wybTEss1l7H5XFIU3j3ZByqfi-3LquYep6xgquILMDAX3ZM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfwrJoH7lLRvsQkqm4zl1r-MjYj2BVWb3PZa3jto5NtxtA&oe=69B4056B"}, {"file_name": "Screenshot00.png", "id": "186037890181676", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974444_186037893515009_7924042357741847006_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=An8qqC_oRKIQ7kNvwHeBsVa&_nc_oc=AdmlmSXQHRu54avedH1SBnfL8r30_Nx9cIJykXe-qUZFSd_0JC_YKdlr3xYSJR1Rffg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_Afx55nnE7olz8bRbNsueiNH7MSErag4qz_nO_BWGlFmJwA&oe=69B404D6"}, {"file_name": "Screenshot05.png", "id": "4134419250011897", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38984447_4134419253345230_1332729510369002148_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QLPAuLq1GRsQ7kNvwEBV9rw&_nc_oc=AdlAs-k4z488M-0G7tPmlfq5tZZoZ7QAn80GuqafuV6hQ1AbgXx9YLI0O2XyEOAc7iM&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfwKYtSFvhd9BDBn3RwEDkYVSs6xl5sm9dg028nTNxDGMA&oe=69B41F96"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BeFootball_SuperPlayer_DEMO_CoverImage.png", "id": "567915194391029", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/227814954_567915197724362_6983002246118726272_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uV3PvuHQPycQ7kNvwH9KFXm&_nc_oc=Adl7Ngps9tUU0ASHZ_ryXtCiWgPCJMk3AgKkjG1MxSBIi9okNrJDW8s9cuuASgQdPs8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_Afwm_3DTfcQhyxx2r_-yFzfN3-9uMISvMd5csEZBPUNPBA&oe=69B407DC"}, "display_name": "BF Super Player Demo", "keywords": [], "long_description": "In BeFootball - SuperPlayer full version, football fans will be able to participate in a frenetic game of stopping penalties or heading balls, being the super stars of the beautiful game and achieving success thanks to their shooting or stopping skills, speed, power, precision ... to reach the maximum score and come out victorious.\n\nWelcome a frenetic soccer virtual reality experience to test your best moves and sports skills while being in a breath-taking stadium. \n\nFeatured in the DEMO version:\n - Goalkeeper Mode:  become a goalkeeper and stop as many balls as possible\n - Header Mode: become a striker and head the ball to hit the scoring panels and test your header accuracy.\n\nGet ready for the match!\n\n  Full game coming soon, with:\n     - New Keeper game modes\n     - New Kicker game modes\n     - New Rhythm Fitness mode\n     - More stadiums\n     - More challenges\n     - And more ...", "short_description": "BeFootball - SuperPlayer is a frenetic soccer virtual reality experience to test your best moves and sport skills while being in a breath-taking stadium.\n\nFeatured in the DEMO version:\n - Goalkeeper Mode:  become a goalkeeper and stop as many balls as possible\n - Header Mode: become a striker and head the ball to hit the scoring panels and test your accuracy.\n"}]}, "developer_name": "Prisma VR Studio", "developer_privacy_policy_url": "https://befootball.world/superplayer-vr-demo-privacy-policy", "developer_terms_of_service_url": "https://befootball.world/legal-notice", "publisher_name": "BeFootball", "support_website_url": "https://befootball.world/contact", "website_url": "https://befootball.world/superplayer", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "contex
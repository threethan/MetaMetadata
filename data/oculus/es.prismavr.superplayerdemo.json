2564_2084726195012925_8787888506217961424_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=izQoxpuSVkAQ7kNvwE1DT2k&_nc_oc=AdqWoadL6nkB0VE9XL6mxvDNGcnJpoAuE3dkxOMJ3suPpnu21DwhrAEW01f1Tp4pJvE&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=8&oh=00_AfyF35f1AlpMa-hvMu3gcCQbVBBn6D4LKMRG_VfeG2e1-A&oe=69C124AF"}, {"file_name": "Screenshot02.png", "id": "162835689277691", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38982488_162835692611024_5312462952174339653_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AVznT9TUTwQQ7kNvwEULWx8&_nc_oc=AdpGsGfWp8klFVuVDWrOHeAGtCrVOz-GpKFUqvpAnPduMWAofa7kiGfSOzm25wSXuvg&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=8&oh=00_Afz8XfrA-iUtbSdBWluQR5smr7NAzktl7D9dGthdYEuDuw&oe=69C1346B"}, {"file_name": "Screenshot00.png", "id": "186037890181676", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974444_186037893515009_7924042357741847006_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BRJif2qZYDUQ7kNvwGgW1fz&_nc_oc=AdrOUjNW9ZtiWmpfUtiXamVj1TvO0pzlfCwpu-S-hv6uCLahCsYOTf9wDJKDWYlDqcw&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=8&oh=00_AfybQhKGxZirXfKXhlHM5Q7OsBep61p4yMc1L4gSs2FIGA&oe=69C133D6"}, {"file_name": "Screenshot05.png", "id": "4134419250011897", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38984447_4134419253345230_1332729510369002148_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V_LoeeIw21AQ7kNvwFS9Pvo&_nc_oc=Adq9WmVI2OFuaipcqcb_jiyqyCq1Fk92suo0S4t_jRZ4U9DLv7n40dBoafDVAiw105g&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_Afzb5mvDDkk8gEiiIac70ElVviPMbKsfaNkbM99k5B4SVw&oe=69C14E96"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BeFootball_SuperPlayer_DEMO_CoverImage.png", "id": "567915194391029", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/227814954_567915197724362_6983002246118726272_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ni0absNyuJMQ7kNvwGnECKh&_nc_oc=AdrAYnE9NEsITijp4avVsJCYd0j_b4Ad_r7xrWk5MMRz7EhAiLWAtplpNDIC9DQKHLM&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=8&oh=00_AfwaInCT5wXs3K_7h8CEsMRBF7XkUVEmAqbziZhBo9OTBQ&oe=69C136DC"}, "display_name": "BF Super Player Demo", "keywords": [], "long_description": "In BeFootball - SuperPlayer full version, football fans will be able to participate in a frenetic game of stopping penalties or heading balls, being the super stars of the beautiful game and achieving success thanks to their shooting or stopping skills, speed, power, precision ... to reach the maximum score and come out victorious.\n\nWelcome a frenetic soccer virtual reality experience to test your best moves and sports skills while being in a breath-taking stadium. \n\nFeatured in the DEMO version:\n - Goalkeeper Mode:  become a goalkeeper and stop as many balls as possible\n - Header Mode: become a striker and head the ball to hit the scoring panels and test your header accuracy.\n\nGet ready for the match!\n\n  Full game coming soon, with:\n     - New Keeper game modes\n     - New Kicker game modes\n     - New Rhythm Fitness mode\n     - More stadiums\n     - More challenges\n     - And more ...", "short_description": "BeFootball - SuperPlayer is a frenetic soccer virtual reality experience to test your best moves and sport skills while being in a breath-taking stadium.\n\nFeatured in the DEMO version:\n - Goalkeeper Mode:  become a goalkeeper and stop as many balls as possible\n - Header Mode: become a striker and head the ball to hit the scoring panels and test your accuracy.\n"}]}, "developer_name": "Prisma VR Studio", "developer_privacy_policy_url": "https://befootball.world/superplayer-vr-demo-privacy-policy", "developer_terms_of_service_url": "https://befootball.world/legal-notice", "publisher_name": "BeFootball", "support_website_url": "https://befootball.world/contact", "website_url": "https://befootball.world/superplayer", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "contex
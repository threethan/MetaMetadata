": "en_US", "screenshots": [{"file_name": "grass-clippings-putting-2560x1440.png", "id": "2241457873195824", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499296123_2241457876529157_6616134438907046246_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uGNgUD4T2BIQ7kNvwF6XEf1&_nc_oc=AdrbLjbyIVKXK5XuFu_TrCMKAQi4dvJXxLff_bQPR7HVoOeyFRhNxGGZGpfbmAphJvc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRCSk7iApz408U0pCvN_2YGG8oP7b2i2udC4Pd03iR6Pg&oe=6B0DB648"}, {"file_name": "look down.png", "id": "1614251642955234", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499297170_1614251646288567_8420078179379113346_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c4JlaT4lr2cQ7kNvwH8kZXg&_nc_oc=Ado2mkjI6Z7_eVHLez-qQMbT3L3PfEgHtKp4gQAizyQsWSrMXdhncaB8D5vpGL5g5z4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSs9YwJAq4IN-PwRkTQGwcmAkltBjmPwDndGTYvrdYtWA&oe=6B0D9BF4"}, {"file_name": "Misses (1).png", "id": "1870297357272871", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499292712_1870297360606204_8389048339696781660_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WEjerY_u6zQQ7kNvwEUl7c4&_nc_oc=AdoHSKOXS_fpZ7bzHdEvcxWRkxPYsgo5dxqvLxbuO466WXBdHpguTpKNKXGqQ79I1BI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQaI5a8ri3dXFRhJDhvIw-B6_GHsBrKw1NEIFas1yXyCg&oe=6B0DC319"}, {"file_name": "look out.png", "id": "1158302263525774", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499295481_1158302266859107_5915138816029487243_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wXE5xneF2qkQ7kNvwHk5J4T&_nc_oc=AdoQ1Px4YmMDhU0NWiv4oNJcg0JaAp4Oshg4vFjot23-gj7KbGbNbW-wKRxsggUeZ5k&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSNxgxWoXY804wG-jf7N7re3XPmNpKY0VLZfWR8a7hCPw&oe=6B0DAE97"}, {"file_name": "scottsd.png", "id": "1391672906345220", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/829188179_1391672909678553_3843569477553394129_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TWC39PggecoQ7kNvwF9GhSH&_nc_oc=AdrFrtT4rzOKivr-2dHPgBfbypEll6KjSoOoCJutv6bYFXrYIjkUA4LCPy_N7mxXC0M&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQk4kzFYb7pq8mvNp8kA4QOM4c3fqL5yBLDKPVy8D2YdQ&oe=6B0DA33C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "GOLF+ Putting", "keywords": ["golf", "putting", "sports", "simulation", "mr"], "long_description": "**The Official VR Golf game of the PGA TOUR**                                                                                                                                                               {1115519851407552}\n\n**The green comes to you!**\n\nThe world\u2019s greatest greens, laid across your living room floor. Every contour. Every tier. Every break. Bring your putter and a real golf ball. No controllers, just your hands and your stroke. Every putt is captured and measured, so practice stops feeling like practice and starts making you better.\n\nREAL PUTTER. REAL BALL. THE GREEN, EXACTLY AS IT WAS DRAWN.\n\n**Requires a real putter, real golf ball, Quest 3/3S and GOLF+ PASS.**\n{1136124792429739}\n\n# GOLF+ Putting Includes:\n**\u26f3\ufe0f Bucket List Courses**: 50+ iconic greens, from Pebble Beach to St Andrews to TPC Sawgrass. Mapped to the centimeter, so every putt breaks exactly as it would there.\n\n**\ud83c\udfc6 Competitive Play**: Climb the ranks and compete globally on the GOLF+ TOUR.\n\n**\ud83d\udcc8 Performance Feedback**: Putt data as precise as the launch monitors the pros use. Strokes gained by distance, make and miss breakdowns, and advanced stats that show you exactly what to fix.\n", "short_description": "**The green comes to you!**\n\nThe world\u2019s greatest greens, laid across your living room floor. Every contour. Every tier. Every break. Bring your putter and a real golf ball. No controllers, just your hands and your stroke. Every putt is captured and measured, so practice stops feeling like practice and starts making you better.\n\nREAL PUTTER. REAL BALL. THE GREEN, EXACTLY AS IT WAS DRAWN.\n\n*Requires a real putter, real golf ball, Quest 3/3S and GOLF+ PASS."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.golfplusvr.com/privacy-policy", "developer_terms_of_service_url": "https://www.golfplusvr.com/terms-of-service", "publisher_name": "GolfScope Inc.", "support_website_url": "https://www.golfplusvr.com/frequently-asked-questions", "website_url": "https://www.golfplusvr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "2776542286000603"}, {"id": "810139357995560"}, {"id": "1228796255027646"}], "external_subscription_type": "REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "2333583447046392"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1731697037920736"}]}, "baseline_offer": {"id": "1731697037920736"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1793656800, "status": "PUBLISHED", "id": "1731697037920736"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "2401724426898960", "version": "821.01"}, "id": "1082863241390299", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "2333583440379726", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "2401724426898960"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1082863241390299"}]}, "change_log": "## Update v821.01 is Live!\n\n## New Course: Ozarks National\nOzarks National by Coore & Crenshaw blends breathtaking Ozark scenery with strategic design, delivering a championship-caliber test inspired by the region\u2019s natural beauty.\n\n## New Feature: Custom Putt\n- Create Your Perfect Putt: Customize your putting practice by adjusting distance, break, elevation, and target size, then replay the same putt as many times as you'd like.\n- Track Your Performance: Monitor your progress with live putting stats and a top-down view showing where your missed putts finish.\n\n### Quality:\n- Updated ball roll animation to more accurately reflect the ball\u2019s movement and spin. This is a visual-only change and doesn\u2019t affect ball physics.\n- Fixed inconsistent elevation readings between the hole indicator and UI.\n- Fixed an issue causing the in-game UI to crash on older game versions.\n- Videos and animations in the in-game UI now look noticeably smoother.\n\n### Course Updates:\n- Fazio Canyons: Hole 4 - Fixed a floating tree behind the green\n", "created_date": 1795640100, "id": "2401724426898960", "version": "821.01", "version_code": 151111, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 120}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "2333583440379726", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "2401724426898960"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": []}, "change_log": null, "created_date": 1795635230, "id": "2401631686908234", "version": "821.01", "version_code": 151107, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 120}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "2333583440379726", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "2401724426898960"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": []}, "change_log": null, "created_date": 1795620944, "id": "2401415743596495", "version": "821.01", "version_code": 151102, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 120}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "2333583440379726", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "2401724426898960"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": []}, "change_log": null, "created_date": 1795544296, "id": "2400342893703780", "version": "821.0", "version_code": 151100, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 120}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "2333583440379726", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "2401724426898960"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": []}, "ch
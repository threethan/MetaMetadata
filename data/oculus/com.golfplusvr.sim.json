c=qzbOyqSvgBMQ7kNvwGGa1dv&_nc_oc=AdpCLrUpUJkVkd_Ea6tZTKRrBw3SvbxNG_e7LVAkddd4vVoLAlsUYzzg-mWDoIRLUWo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTyXq7O4Jpd-G75YT5_hiOebBx-c0c0yaWSm730_oHaWg&oe=6AEF63C8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "604298355_2599366977204554_6275421468511810884_n.png", "id": "1852958552823286", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/654859273_1852958559489952_4290757004588966395_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mDeIQEROKzwQ7kNvwGUzXYz&_nc_oc=Adq0ESRxWgTE0vry7-_b9nCOaGrw_gMT_OhaAJxvBhum1iLfutQqLOBy1KobzQZT4Zo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT_ji5cbWTL-7O0Iiey6k2TpIwRoVq17LOJnGtGC6lZ7w&oe=6AEF3FB6"}, "display_name": "GOLF+ Putting", "keywords": ["golf", "putting", "sports", "simulation", "mr"], "long_description": "**The Official VR Golf game of the PGA TOUR!**        \n*Requires Quest 3/3S and GOLF+ PASS.\n                                                                                                                                                       {1115519851407552}\n\n**The green comes to you!**\n\nThe world\u2019s greatest greens, laid across your living room floor. Every contour. Every tier. Every break. Bring your putter and a real golf ball. No controllers, just your hands and your stroke. Every putt is captured and measured, so practice stops feeling like practice and starts making you better.\n\nREAL PUTTER. REAL BALL. THE GREEN, EXACTLY AS IT WAS DRAWN.\n{1136124792429739}\n\n# GOLF+ Putting Includes:\n**\u26f3\ufe0f Bucket List Courses**: 50+ iconic greens, from Pebble Beach to St Andrews to TPC Sawgrass. Mapped to the centimeter, so every putt breaks exactly as it would there.\n\n**\ud83c\udfc6 Competitive Play**: Climb the ranks and compete globally on the GOLF+ Putting Tour.\n\n**\ud83d\udcc8 Performance Feedback**: Putt data as precise as the launch monitors the pros use. Strokes gained by distance, make and miss breakdowns, and advanced stats that show you exactly what to fix.\n", "short_description": "**The green comes to you!**\n\nThe world\u2019s greatest greens, laid across your living room floor. Every contour. Every tier. Every break. Bring your putter and a real golf ball. No controllers, just your hands and your stroke. Every putt is captured and measured, so practice stops feeling like practice and starts making you better.\n\nREAL PUTTER. REAL BALL. THE GREEN, EXACTLY AS IT WAS DRAWN.\n\n*Requires a real putter, real golf ball, Quest 3/3S and GOLF+ PASS."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.golfplusvr.com/privacy-policy", "developer_terms_of_service_url": "https://www.golfplusvr.com/terms-of-service", "publisher_name": "GolfScope Inc.", "support_website_url": "https://www.golfplusvr.com/frequently-asked-questions", "website_url": "https://www.golfplusvr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "2776542286000603"}, {"id": "810139357995560"}, {"id": "1228796255027646"}], "external_subscription_type": "REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "2371523729919030"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491831393_1336132802924281_2721219313462671142_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jgj4rIZbDkYQ7kNvwEDklSk&_nc_oc=AdqoInN1z7FusM50oIFR4DbyVFY-X5s4_L5V-LbX2f783jzI0oGHW98CDtJk1XBYv-Y&_nc_zt=3&_nc_ht=sconten
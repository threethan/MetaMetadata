NxGGZGpfbmAphJvc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRCSk7iApz408U0pCvN_2YGG8oP7b2i2udC4Pd03iR6Pg&oe=6B0DB648"}, {"file_name": "look out.png", "id": "1158302263525774", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499295481_1158302266859107_5915138816029487243_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wXE5xneF2qkQ7kNvwHk5J4T&_nc_oc=AdoQ1Px4YmMDhU0NWiv4oNJcg0JaAp4Oshg4vFjot23-gj7KbGbNbW-wKRxsggUeZ5k&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSNxgxWoXY804wG-jf7N7re3XPmNpKY0VLZfWR8a7hCPw&oe=6B0DAE97"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "604298355_2599366977204554_6275421468511810884_n.png", "id": "1852958552823286", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/654859273_1852958559489952_4290757004588966395_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0XCXXtRaBGMQ7kNvwFBeZ7I&_nc_oc=AdpYqLnWT-hXqKoK6W8r8KOEUXGej3wt03M2mpYExbUoi7jMCpurl0Yd7zO1Zw4N9qo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQxMkBzj0daWPqttR-3mZjvO30lQzB6juKLA1wTeM8kWw&oe=6B0DCA76"}, "display_name": "GOLF+ Putting", "keywords": ["golf", "putting", "sports", "simulation", "mr"], "long_description": "**The Official VR Golf game of the PGA TOUR!**        \n*Requires Quest 3/3S and GOLF+ PASS.\n                                                                                                                                                       {1115519851407552}\n\n**The green comes to you!**\n\nThe world\u2019s greatest greens, laid across your living room floor. Every contour. Every tier. Every break. Bring your putter and a real golf ball. No controllers, just your hands and your stroke. Every putt is captured and measured, so practice stops feeling like practice and starts making you better.\n\nREAL PUTTER. REAL BALL. THE GREEN, EXACTLY AS IT WAS DRAWN.\n{1136124792429739}\n\n# GOLF+ Putting Includes:\n**\u26f3\ufe0f Bucket List Courses**: 50+ iconic greens, from Pebble Beach to St Andrews to TPC Sawgrass. Mapped to the centimeter, so every putt breaks exactly as it would there.\n\n**\ud83c\udfc6 Competitive Play**: Climb the ranks and compete globally on the GOLF+ Putting Tour.\n\n**\ud83d\udcc8 Performance Feedback**: Putt data as precise as the launch monitors the pros use. Strokes gained by distance, make and miss breakdowns, and advanced stats that show you exactly what to fix.\n", "short_description": "**The green comes to you!**\n\nThe world\u2019s greatest greens, laid across your living room floor. Every contour. Every tier. Every break. Bring your putter and a real golf ball. No controllers, just your hands and your stroke. Every putt is captured and measured, so practice stops feeling like practice and starts making you better.\n\nREAL PUTTER. REAL BALL. THE GREEN, EXACTLY AS IT WAS DRAWN.\n\n*Requires a real putter, real golf ball, Quest 3/3S and GOLF+ PASS."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.golfplusvr.com/privacy-policy", "developer_terms_of_service_url": "https://www.golfplusvr.com/terms-of-service", "publisher_name": "GolfScope Inc.", "support_website_url": "https://www.golfplusvr.com/frequently-asked-questions", "website_url": "https://www.golfplusvr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "2776542286000603"}, {"id": "810139357995560"}, {"id": "1228796255027646"}], "external_subscription_type": "REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_intera
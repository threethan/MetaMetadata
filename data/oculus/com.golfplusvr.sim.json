": "en_US", "screenshots": [{"file_name": "grass-clippings-putting-2560x1440.png", "id": "2241457873195824", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/499296123_2241457876529157_6616134438907046246_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iILiB9EC_RUQ7kNvwFasWlx&_nc_oc=AdrPzH4Z3jcq9Da-CY_jNSbqBETCIvUbWaxQebDRL3FU9cI7oJQaBjxe53vYbTlSZxo&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRhkRf124aLLBDn-vfj0v6DE15FGt9axZDiI8N7gh_8pw&oe=6AFB4148"}, {"file_name": "look down.png", "id": "1614251642955234", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499297170_1614251646288567_8420078179379113346_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7qKR9LSo4r8Q7kNvwGZsh1I&_nc_oc=AdqvakESjIvoI_3o6ZW32472lHeh-O3429eq9aVMFMXCksix8JveN_h0K2HluKqc2tk&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRPxWgC2OTVcAYhAtxsJg0BjkN88f9L1Q0DegnZZb-BzQ&oe=6AFB26F4"}, {"file_name": "Misses (1).png", "id": "1870297357272871", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/499292712_1870297360606204_8389048339696781660_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MruCoHGQhRAQ7kNvwHUTG6B&_nc_oc=AdokU6D9wIw64G29RT1uaocBOSnkL-c7hDZacSROK3ZbFOQb7i3s_1OJ77GfWev6uRU&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTqau3aNShs3UxyJ8BZ4se7vRws_TzcD8bt3z8va4XXeQ&oe=6AFB15D9"}, {"file_name": "look out.png", "id": "1158302263525774", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/499295481_1158302266859107_5915138816029487243_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CDsgo4dPpYYQ7kNvwHIcnYv&_nc_oc=AdpEEIlxVNZHXvXHkf_1WF4EVCYMMZz-WPks6tKtxINLUUArWJGVePWKJ7Y346Tq4Qw&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSPWQjM7YzQ-C2hLy8QdF-zrFQ6I0LeP8rUaFiAQxOqPA&oe=6AFB3997"}, {"file_name": "scottsd.png", "id": "1391672906345220", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/829188179_1391672909678553_3843569477553394129_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qgKRnkNUyyQQ7kNvwFRPT0h&_nc_oc=AdrxdN0Y6HExGxwDFmFT0K0aH-IX3aXgrIjWsJqcjTkR1ebfbdfvCdOlU7N2OjI_X2c&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTRY9p1vf-hB5bNxOIpEFHalDSnUlySePBIlkwmfnyhMA&oe=6AFB2E3C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "GOLF+ Putting", "keywords": ["golf", "putting", "sports", "simulation", "mr"], "long_description": "**The Official VR Golf game of the PGA TOUR**                                                                                                                                                               {1115519851407552}\n\n**The green comes to you!**\n\nThe world\u2019s greatest greens, laid across your living room floor. Every contour. Every tier. Every break. Bring your putter and a real golf ball. No controllers, just your hands and your stroke. Every putt is captured and measured, so practice stops feeling like practice and starts making you better.\n\nREAL PUTTER. REAL BALL. THE GREEN, EXACTLY AS IT WAS DRAWN.\n\n**Requires a real putter, real golf ball, Quest 3/3S and GOLF+ PASS.**\n{1136124792429739}\n\n# GOLF+ Putting Includes:\n**\u26f3\ufe0f Bucket List Courses**: 50+ iconic greens, from Pebble Beach to St Andrews to TPC Sawgrass. Mapped to the centimeter, so every putt breaks exactly as it would there.\n\n**\ud83c\udfc6 Competitive Play**: Climb the ranks and compete globally on the GOLF+ TOUR.\n\n**\ud83d\udcc8 Performance Feedback**: Putt data as precise as the launch monitors the pros use. Strokes gained by distance, make and miss breakdowns, and advanced stats that show you exactly what to fix.\n", "short_description": "**The green comes to you!**\n\nThe world\u2019s greatest greens, laid across your living room floor. Every contour. Every tier. Every break. Bring your putter and a real golf ball. No controllers, just your hands and your stroke. Every putt is captured and measured, so practice stops feeling like practice and starts making you better.\n\nREAL PUTTER. REAL BALL. THE GREEN, EXACTLY AS IT WAS DRAWN.\n\n*Requires a real putter, real golf ball, Quest 3/3S and GOLF+ PASS."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.golfplusvr.com/privacy-policy", "developer_terms_of_service_url": "https://www.golfplusvr.com/terms-of-service", "publisher_name": "GolfScope Inc.", "support_website_url": "https://www.golfplusvr.com/frequently-asked-questions", "website_url": "https://www.golfplusvr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "2776542286000603"}, {"id": "810139357995560"}, {"id": "1228796255027646"}], "external_subscription_type": "REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "2333583447046392"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1731697037920736"}]}, "baseline_offer": {"id": "1731697037920736"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1793656800, "status": "PUBLISHED", "id": "1731697037920736"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "2385656841839052", "version": "820.01"}, "id": "1082863241390299", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "2333583440379726", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "2385656841839052"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1082863241390299"}]}, "change_log": "## Update v820.01 is Live!\n\n## New Course: Buffalo Ridge\nRedesigned by Tom Fazio and Johnny Morris, Buffalo Ridge weaves championship golf through the Ozarks, where rolling fairways, native beauty, and roaming buffalo await.\n\n## New Performance Optimizations:\n\ud83e\udd7d Quest 3/3s: The ground near you is now drawn from a snapshot taken during the quick fade when you teleport or turn.\n\ud83e\udde0 Memory improvements: Several behind-the-scenes changes help the game use less memory overall.\n\ud83d\uddb1\ufe0f Snappier menus: Menus run smoother when you point at them.\n\n## Updated Putting Game Mode: Push Back\n- Added new customization options to the Push Back drill based on player feedback.\n- Players can now choose what happens after a missed putt, with the original 3 ft reset remaining the default setting.\n\n### Quality:\n- We recently ran validation on our green speed stimp values and uncovered some discrepancies. 12 stimp is perfect, but stimps below 12 are a bit slower than they should be, and above 12 are a bit faster than they should be. We've updated the Stimp settings range from 7 to 13 in game to accomadate the speed changes.", "created_date": 1794435180, "id": "2385656841839052", "version": "820.01", "version_code": 150984, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 118}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "2333583440379726", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "2385656841839052"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": []}, "change_log": null, "created_date": 1794009826, "id": "2380208119050591", "version": "820.0", "version_code": 150936, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 118}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "2333583440379726", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "2385656841839052"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1082863241390299"}]}, "change_log": "## Update v819.01 is Live!\n\n### \u26f3 New Course: Omni Barton Creek - Fazio Canyons\nFazio Canyons blends dramatic elevation, canyon vistas, and strategic golf in the Texas Hill Country.  Host of the inaugural 2026 Austin Championship, it's a bold test of skill.\n\n**Trailer:**https://youtu.be/g8zwn75edwQ", "created_date": 1793827910, "id": "2377849755953094", "version": "819.01", "version_code": 150917, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 117}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "2333583440379726", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "2385656841839052"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": []}, "change_log": null, "created_date": 1793815468, "id": "2377675705970499", "version": "819.01", "version_code": 150912, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 117}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "2333583440379726", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "2385656841839052"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1082863241390299"}]}, "change_log": "The Official VR Golf game of the PGA TOUR!\n*Requires Quest 3/3S and GOLF+ PASS.\n\nThe green comes to you!\n\nThe world\u2019s greatest greens, laid across your living room floor. Every contour. Every tier. Every break. Bring your putter and a real golf ball.\nNo controllers, just your hands and your stroke. Every putt is captured and measured, so practice stops feeling like practice and starts making you better.\n\nREAL PUTTER. REAL BALL. THE GREEN, EXACTLY AS IT WAS DRAWN.\n\nGOLF+ Putting Includes:\n\u26f3\ufe0f Bucket List Courses: 50+ iconic greens, from Pebble Beach to St Andrews to TPC Sawgrass. Mapped to the centimeter, so every putt breaks exactly as it would there.\n\n\ud83c\udfc6 Competitive Play: Climb the ranks and compete globally on the GOLF+ Putting Tour.\n\n\ud83d\udcc8 Performance Feedback: Putt data as precise as the launch monitors the pros use. Strokes gained by distance, make and miss breakdowns, and advanced stats that show you exactly what to fix.", "created_date": 1793635620, "id": "2375511849520218", "version": "818.1", "version_code": 150886, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 114}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}]}}, "viewer": {"user": null}}}
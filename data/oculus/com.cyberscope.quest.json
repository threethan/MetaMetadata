4IREH8CAAOMqWX-fkg&oe=6B106251"}, {"file_name": "3-browser-search.png", "id": "1607781793837374", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/593858738_1607781797170707_4563751457001805182_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zj4HIvmJ57kQ7kNvwFAwsrA&_nc_oc=AdobhQJT3MWdQT_ODhi5oG8LOFnR4vMgs-MdZ-LbLWoVH9Fi1w3d7XB4oZT_PXme_X8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVBakSxOAsvCmRnQnbYavjHDKpyUOwRd-lo-lICwskr4Q&oe=6B1066E9"}, {"file_name": "4-browser-your-videos-servers.png", "id": "4576386155925511", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/593749142_4576386159258844_1613420307783989241_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M6CMj_FhdPAQ7kNvwFJ8C2o&_nc_oc=AdqsRNY6MlLZBVbo-iR71DRKWNMpglYlrN2lnE8exeTGmnVyCzKAbmtHO-bY7f9pEYw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWI0GTiE7abS4Sq2xjAbR_D6iX-e5CsNkz7loF1aqOs9Q&oe=6B1048FE"}, {"file_name": "5-intro-mascot.png", "id": "1812237896748035", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499628092_1812237900081368_3380172402860259429_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uiKTAekakTsQ7kNvwFPzE_z&_nc_oc=AdoYYxApJfNHn22az_e8L-Ev5oR2BFiJ0c1xPB9tR8vEXrJIq8Vra8wEuU0uhj8DyF8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQV0Lzom_0zjdQCZ2qg2EQs3394nxAj-TD96S9AizvIsXQ&oe=6B106730"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer-cover-2560x1440.png", "id": "1925800688769595", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499627527_1925800692102928_8195552456652650655_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iiB0QWb1nS4Q7kNvwG8Z4eY&_nc_oc=Ado-GWqOf-fRLuKdI_WUfmG36cqT6Ntn4hRLGnibLmfaoUnYNGHteBF132fgmCvYRHM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWar5NT6ErzIL-Be42jCjxwysSjgXjHPyPjkUhK3aSu1w&oe=6B104318"}, "display_name": "Cyberscope Browser", "keywords": ["video", "browser", "360", "privacy"], "long_description": "Browse the web like normal. When a video starts, Cyberscope opens it in a real VR player: a big flat screen, 3D, or all around you in 180 and 360.\n\nMADE FOR WATCHING\n\u2022 Videos on most sites open in VR automatically, or with the Play in VR button\n\u2022 Flat, 3D side-by-side and over-under, 180, 360 and fisheye, detected for you\n\u2022 Passthrough for green-screen and alpha videos\n\u2022 AI passthrough (beta) and 2D to 3D (beta), run on the headset itself\n\u2022 Picture, speed, equalizer, volume boost, A-B loop, subtitles, Continue watching\n\u2022 Play from SMB, WebDAV, FTP and SFTP shares, or the headset's own storage\n\nPRIVATE BY DESIGN\n\u2022 No account, ads, analytics or tracking. Nothing about you is sent to the developer\n\u2022 A sealed private window, wiped when you close it\n\u2022 Ad and tracker blocker, third-party cookies blocked, Global Privacy Control, secure connections first\n\u2022 History and passwords stay on your headset. Clear it all in one tap, or every time the app closes\n\u2022 No camera, microphone or location access\n\nA REAL BROWSER\nTabs, bookmarks, history, find in page, zoom, desktop mode and your choice of search engine.\n\nCOPY-PROTECTED VIDEO\nDRM-protected video (most paid streaming services) stays in the website's own player. Cyberscope never decrypts or works around copy protection.\n\nMade by one indie developer, Deondre H. Questions: cyberscope.support@gmail.com\n\nScreenshots and trailer include Big Buck Bunny (c) Blender Foundation, CC BY 3.0.", "short_description": "A private web browser that plays any page's video in VR: flat, 3D, 180, 360 and fisheye."}]}, "developer_name": "Deondre H.", "developer_privacy_policy_url": "https://smoke78.github.io/cyberscope-browser/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Deondre H.", "support_website_url": null, "website_url": "https://smoke78.github.io/cyberscope-browser/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}, {"id": "393222478507326"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "2912224399146927"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1192865680359894"}]}, "baseline_offer": {"id": "1192865680359894"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1794896760, "status": "PUBLISHED", "id": "1192865680359894"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "2928711864164847", "version": "1.0.16"}, "id": "1601691731972741", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "2912224385813595", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "2928711864164847"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1601691731972741"}]}, "change_log": "What's new in 1.0.16\n\nBrowsing\n\u2022 The keyboard's Enter key now sends what you typed, on web pages and in the address bar\n\u2022 \"Videos on this page\": play a page's video files directly\n\u2022 Bookmarks no longer open by themselves at start\n\nWatching\n\u2022 Controllers and hands hide while you watch, and come back with the menu\n\u2022 Each video remembers its format, zoom, tilt and picture settings\n\u2022 New Cube format for YouTube-style 360 video\n\nPicture and sound\n\u2022 Sharpen, Saturation and Warmth in the picture panel\n\u2022 Focus (formerly 3D depth), now with twice the range\n\u2022 Audio delay to fix lip-sync\n\nYour videos\n\u2022 Sort your files and switch between list and tile views\n\nPlus bug fixes and polish.", "created_date": 1795543252, "id": "2928711864164847", "version": "1.0.16", "version_code": 117, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "2912224385813595", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "2928711864164847"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1601691731972741"}]}, "change_log": "\"What's new in 1.0.16:\\n- The keyboard's Enter now sends what you typed on web pages and in the address bar\\n- Audio delay to fix lip-sync\\n- Controllers and hands hide while you watch, and come back with the menu\\n- Sharpen, Saturation and Warmth in the picture panel\\n- Focus (was 3D depth) with twice the range\\n- Each video remembers its format, zoom, tilt and picture settings\\n- Videos on this page: play a page's video files directly\\n- Cube format for YouTube-style 360 video\\n- Sort and tile views in Your videos\\n- Bookmarks no longer open by themselves\\n- Fixes\"", "created_date": 1795540215, "id": "2928663290836371", "version": "1.0.16", "version_code": 116, "release_status": "PENDING", "status": "DRAFT", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "2912224385813595", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "2928711864164847"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1601691731972741"}]}, "change_log": "\"What's new in 1.0.15:\\n- Bigger, crisper text in the browser and player menus\\n- Hold grip + thumbstick left/right for previous/next video\\n- Set your own homepage\\n- Switch sound tracks on videos with more than one\\n- A short fade between videos\\n- Smoother 8K skipping and passthrough\\n- A-B loops are easier to grab and are remembered per video\\n- Upload files to websites\\n- Go button in the address bar\\n- Windows tilt to face you when moved up or down, and the pointer reaches windows pushed far back\\n- Quit button on the About page\\n- Many fixes\"", "created_date": 1794897485, "id": "2918519595184074", "version": "1.0.15", "version_code": 115, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "2912224385813595", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "2928711864164847"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1601691731972741"}]}, "change_log": "First release of Cyberscope Browser: watch any website's video in VR (flat, 3D, 180, 360 and fisheye), with a private window, ad and tracker blocking, and no account or tracking.", "created_date": 1794502239, "id": "2912342692468431", "version": "1.0", "version_code": 100, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}]}}, "viewer": {"user": null}}}
sJrNaK8h8Z-8_JzU5g&oe=6B05D651"}, {"file_name": "3-browser-search.png", "id": "1607781793837374", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/593858738_1607781797170707_4563751457001805182_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TVP-tl3W6PgQ7kNvwEUtdlw&_nc_oc=Adpdt-sTYlbsk4AdznPtUpVT5mlhRrhE2jMfz_ZQJBfpkPkIBxGtyQVfflaw-tVR94A&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS_6nSuFDk4-0ZajMYyEJm5cRJTOvDDImYnvAsX_44mkg&oe=6B05A2A9"}, {"file_name": "4-browser-your-videos-servers.png", "id": "4576386155925511", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/593749142_4576386159258844_1613420307783989241_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gHj-PRFc5jQQ7kNvwEasEh1&_nc_oc=AdoYUPHUbhv42zz0EBRC_fGWQOii3hRWayQKv5nI6gd4yFLyavewAt6YwTma6hTa_qY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSkxVYwDVxxWfwSg6z8QVLv6UfgYLFzmfP4htdyAZ7yeQ&oe=6B05BCFE"}, {"file_name": "5-intro-mascot.png", "id": "1812237896748035", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499628092_1812237900081368_3380172402860259429_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UPVjEQE2auoQ7kNvwHOY8TT&_nc_oc=Ado3j17gFeAOr8ZMzgMFSVoh-vciJLWLHaCNY2h7gIu3eLu1OvMYlPuBjcL3ikOvpaA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRMCbFuvFTJ2CMHvuuFckrK85vnNBPj4SuYw4j8VjYrJg&oe=6B05A2F0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer-cover-2560x1440.png", "id": "1925800688769595", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499627527_1925800692102928_8195552456652650655_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=05oBvNNiRtkQ7kNvwGi_5Wl&_nc_oc=AdoPalbwTtIPU2ZiS_k6f26LVIPRKV4acQQGTEC7LQg9RMfYSDoLlTBGXzN96zn9RCg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS1Cl3Ll9aCXpjEkkhKaUqbk__adkHWlMzISRN4M137oA&oe=6B05B718"}, "display_name": "Cyberscope Browser", "keywords": ["video", "browser", "360", "privacy"], "long_description": "Browse the web like normal. When a video starts, Cyberscope opens it in a real VR player: a big flat screen, 3D, or all around you in 180 and 360.\n\nMADE FOR WATCHING\n\u2022 Videos on most sites open in VR automatically, or with the Play in VR button\n\u2022 Flat, 3D side-by-side and over-under, 180, 360 and fisheye, detected for you\n\u2022 Passthrough for green-screen and alpha videos\n\u2022 AI passthrough (beta) and 2D to 3D (beta), run on the headset itself\n\u2022 Picture, speed, equalizer, volume boost, A-B loop, subtitles, Continue watching\n\u2022 Play from SMB, WebDAV, FTP and SFTP shares, or the headset's own storage\n\nPRIVATE BY DESIGN\n\u2022 No account, ads, analytics or tracking. Nothing about you is sent to the developer\n\u2022 A sealed private window, wiped when you close it\n\u2022 Ad and tracker blocker, third-party cookies blocked, Global Privacy Control, secure connections first\n\u2022 History and passwords stay on your headset. Clear it all in one tap, or every time the app closes\n\u2022 No camera, microphone or location access\n\nA REAL BROWSER\nTabs, bookmarks, history, find in page, zoom, desktop mode and your choice of search engine.\n\nCOPY-PROTECTED VIDEO\nDRM-protected video (most paid streaming services) stays in the website's own player. Cyberscope never decrypts or works around copy protection.\n\nMade by one indie developer, Deondre H. Questions: cyberscope.support@gmail.com\n\nScreenshots and trailer include Big Buck Bunny (c) Blender Foundation, CC BY 3.0.", "short_description": "A private web browser that plays any page's video in VR: flat, 3D, 180, 360 and fisheye."}]}, "developer_name": "Deondre H.", "developer_privacy_policy_url": "https://smoke78.github.io/cyberscope-browser/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Deondre H.", "support_website_url": null, "website_url": "https://smoke78.github.io/cyberscope-browser/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}, {"id": "393222478507326"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "2912224399146927"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1192865680359894"}]}, "baseline_offer": {"id": "1192865680359894"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1794896760, "status": "PUBLISHED", "id": "1192865680359894"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "2918519595184074", "version": "1.0.15"}, "id": "1601691731972741", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "2912224385813595", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "2918519595184074"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1601691731972741"}]}, "change_log": "\"What's new in 1.0.15:\\n- Bigger, crisper text in the browser and player menus\\n- Hold grip + thumbstick left/right for previous/next video\\n- Set your own homepage\\n- Switch sound tracks on videos with more than one\\n- A short fade between videos\\n- Smoother 8K skipping and passthrough\\n- A-B loops are easier to grab and are remembered per video\\n- Upload files to websites\\n- Go button in the address bar\\n- Windows tilt to face you when moved up or down, and the pointer reaches windows pushed far back\\n- Quit button on the About page\\n- Many fixes\"", "created_date": 1794897485, "id": "2918519595184074", "version": "1.0.15", "version_code": 115, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "2912224385813595", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "2918519595184074"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1601691731972741"}]}, "change_log": "First release of Cyberscope Browser: watch any website's video in VR (flat, 3D, 180, 360 and fisheye), with a private window, ad and tracker blocking, and no account or tracking.", "created_date": 1794502239, "id": "2912342692468431", "version": "1.0", "version_code": 100, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}]}}, "viewer": {"user": null}}}
&_nc_oc=AdmHoj2N5JpBvF0QMIib0wZ1-zUQK6WcEp2xcOwl2Y96dNFHVouiFulJyaF6-xKzdhA&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=8&oh=00_AfxopP3VOM6ZUki1cJQoF80IeMWV-RwrduENa3sJSueuAA&oe=69AAC932"}, {"file_name": "Screenshot (2).png", "id": "1963112014488808", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/491821696_1963112017822141_2984987640849053311_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bpjc29eUjI0Q7kNvwFuQODC&_nc_oc=AdlkI42TboxSt3Ka0Q-_SwYrxvIDROEcnKEiUwSPwPd7MiWUJHMx7B-pZCXbzkC_Y2c&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=8&oh=00_AfybDKFRakMPPpMvYBiTg_Z9k8TICUemetnAN-Ivuy5kDw&oe=69AAC4E1"}, {"file_name": "Screenshot (5).png", "id": "745629985022661", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/491821115_745629988355994_8892314022341861000_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Tjie6_SSG2EQ7kNvwHe8VyT&_nc_oc=AdliybKy7B2h3aY2UJUrOLx4WBVWfdxPGqJXSpagcYpI6neRv97TkT7ICq_IeqYXJzk&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=8&oh=00_AfxIhsJUEtCOJ-SeLkKQszG3PjehiafP5RKiQRzUHmexkw&oe=69AADF1F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TrailerCoverImage.png", "id": "760991899910077", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/491821725_760991906576743_1778568361130176388_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HGX57DcPKhoQ7kNvwFp3zcR&_nc_oc=Adm90Fsc9B63RxfEl95P6hFtLaPsYPLfGaBYxr6I0wwDwa5OloEChyZu31roziiJ9SU&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=8&oh=00_AfzjIljiRib_jNAB0NC17an7S9-3KDWJ7_CEaMtQSCsM6w&oe=69AAE70B"}, "display_name": "Discover Antwerp", "keywords": ["Visit", "Tourism", "Anterp", "information", "360"], "long_description": "Explore the vibrant city of Antwerp from the comfort of your Meta Quest headset. Visit famous hotspots through immersive 360\u00b0 photos and feel like you\u2019re really there. Each location comes to life with interactive info popups full of stories, fun facts, and cultural highlights.\n\nWhether you\u2019re planning a trip, reliving memories, or just curious to explore, this VR experience lets you see Antwerp in a whole new way.\n\nDownload now and start your virtual journey through Antwerp!", "short_description": "Step into the vibrant city of Antwerp like never before with our VR experience for Meta Quest. Explore iconic hotspots through immersive 360\u00b0 photography and feel as if you\u2019re truly there. At each location, interactive info popups reveal fascinating stories, facts, and hidden gems\u2014bringing the city\u2019s culture and history to life right before your eyes."}]}, "developer_name": "Soulmade", "developer_privacy_policy_url": "https://soulmade.eu/en/privacy-policy-meta/", "developer_terms_of_service_url": null, "publisher_name": "Soulmade", "support_website_url": null, "website_url": "https://soulmade.eu/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "nl_BE", "nl", "fr_BE", "fr_CA", "fr"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24809773405297429"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/491820855_727677696939698_7352958287597105318_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RZKBc7s0h9sQ7kNvwGrHIxe&_nc_oc=AdnTrOPYNoA9Gdy6V-tyzWAPRveatC82K8MHe7IwDc5nw9SyYxZ60SG4yEIP6yAoBhE&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=8&oh=00_Afy
": "Screenshot (3).png", "id": "1427390781848982", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491824697_1427390785182315_1239850771067853533_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lCcZSDGtkYkQ7kNvwEP-oer&_nc_oc=AdpYLIhv_7lOWQZVAaDBYqTpiyJNF9in3WSv2d5WtoXjP8trfuFbAM8E7_qfgGI9hs8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSb6sn3b0dq_auWZyhqeToOgmB0HK5da2uFAWh9m3yQUg&oe=6B070D72"}, {"file_name": "Screenshot (2).png", "id": "1963112014488808", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491821696_1963112017822141_2984987640849053311_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cBteaw18xssQ7kNvwEaXdtp&_nc_oc=AdqxH1xl6dILGoVb8A5cV-PFh5PivipjKhZXJw-ZMqAT93P80nfRNo0UDEAq4f2fGH8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSIr_QetnI-dTon3gjCg6VWPAYA5A5tSes-v6cQcChoag&oe=6B070921"}, {"file_name": "Screenshot (5).png", "id": "745629985022661", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491821115_745629988355994_8892314022341861000_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nufUMZzQ1YQQ7kNvwGdPIdw&_nc_oc=AdqVEbnMT92kzkpA0I5C1fkUrZHPp8Dim_smRW4l0GzPHWiZEbnaK8eAyb1c5DjYkUA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRYYCUrbQ8BDysRnThsd_hDVJZzA18rxwItg8-X1uBhRw&oe=6B07235F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TrailerCoverImage.png", "id": "760991899910077", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491821725_760991906576743_1778568361130176388_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gLjF4CeSf9YQ7kNvwGB9brH&_nc_oc=AdolSXtmGFb6hqV_6PZYUXhDTapb_wH7nAlahsqpZvRMsPHM3Gzdl7iPhBIzMagAoDw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQM2ZYPm15z-P9XbUTUc6Q3LYsw9o5tmLcqKGYG6IYxIw&oe=6B06F30B"}, "display_name": "Discover Antwerp", "keywords": ["Visit", "Tourism", "Anterp", "information", "360"], "long_description": "Explore the vibrant city of Antwerp from the comfort of your Meta Quest headset. Visit famous hotspots through immersive 360\u00b0 photos and feel like you\u2019re really there. Each location comes to life with interactive info popups full of stories, fun facts, and cultural highlights.\n\nWhether you\u2019re planning a trip, reliving memories, or just curious to explore, this VR experience lets you see Antwerp in a whole new way.\n\nDownload now and start your virtual journey through Antwerp!", "short_description": "Step into the vibrant city of Antwerp like never before with our VR experience for Meta Quest. Explore iconic hotspots through immersive 360\u00b0 photography and feel as if you\u2019re truly there. At each location, interactive info popups reveal fascinating stories, facts, and hidden gems\u2014bringing the city\u2019s culture and history to life right before your eyes."}]}, "developer_name": "Soulmade", "developer_privacy_policy_url": "https://soulmade.eu/en/privacy-policy-meta/", "developer_terms_of_service_url": null, "publisher_name": "Soulmade", "support_website_url": null, "website_url": "https://soulmade.eu/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "nl_BE", "nl", "fr_BE", "fr_CA", "fr"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24809773405297429"}, "review_messages": []}]}, "cover_square_
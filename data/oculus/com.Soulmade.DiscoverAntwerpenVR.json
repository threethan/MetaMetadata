7f20f&oh=00_Af_Gev4xnWTloDVvdbOYSWR9cFgASr2IHqxcGV9fK43zRQ&oe=6A24291F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TrailerCoverImage.png", "id": "760991899910077", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/491821725_760991906576743_1778568361130176388_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=32_umheoAmMQ7kNvwFE9Isx&_nc_oc=AdqnGvGOFA_Ke-SDz2JsfdszCXahT_XbytW_-Ov4NN4Z3LO2-77bKGROEEwewYPKo8k&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-ABheJitr4BpysRnUcEXQfltfOWgQlbiTT8OgNy2XbWA&oe=6A24310B"}, "display_name": "Discover Antwerp", "keywords": ["Visit", "Tourism", "Anterp", "information", "360"], "long_description": "Explore the vibrant city of Antwerp from the comfort of your Meta Quest headset. Visit famous hotspots through immersive 360\u00b0 photos and feel like you\u2019re really there. Each location comes to life with interactive info popups full of stories, fun facts, and cultural highlights.\n\nWhether you\u2019re planning a trip, reliving memories, or just curious to explore, this VR experience lets you see Antwerp in a whole new way.\n\nDownload now and start your virtual journey through Antwerp!", "short_description": "Step into the vibrant city of Antwerp like never before with our VR experience for Meta Quest. Explore iconic hotspots through immersive 360\u00b0 photography and feel as if you\u2019re truly there. At each location, interactive info popups reveal fascinating stories, facts, and hidden gems\u2014bringing the city\u2019s culture and history to life right before your eyes."}]}, "developer_name": "Soulmade", "developer_privacy_policy_url": "https://soulmade.eu/en/privacy-policy-meta/", "developer_terms_of_service_url": null, "publisher_name": "Soulmade", "support_website_url": null, "website_url": "https://soulmade.eu/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "co
-VdtgoTdams&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJJo3xqqn3ofyx_AuXQnCirXU3UrMGFV20q4Xq4Ndxz6Q&oe=6AAE8991"}, {"file_name": "sshot5.png", "id": "2943864232404966", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/38974726_2943864235738299_5599921081781756632_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Vs90rFZ5R-QQ7kNvwG5wp9d&_nc_oc=AdrCZob4glbFfH1VRJisrLoX8YwlhN2-2tvWOy1b7boc1q1CPNcxPwM-6i4tW2bC9Z8&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJETGKwCucXo-pz22Hy3frnVf3-VusQTbeUV_f4Hr452A&oe=6AAE893F"}, {"file_name": "ssshot2.png", "id": "481825059549076", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/38974729_481825062882409_4002421495152795441_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ezv0CYSX98gQ7kNvwG8-1Qg&_nc_oc=AdqkhpCRiA3YZKPLNA_25R6WZ6uvUD7VZFV7uNeFvC6y67SJ-AZCDrGjX3Wh1LlkFB4&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJLmt4Wz2TUWEzhGf5CQP-V57XILSLQBB3eGRHE-93O0Q&oe=6AAEB131"}, {"file_name": "sshot1.png", "id": "3001572386745655", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/38974601_3001572390078988_6193970039339129983_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R6oT1yivdOwQ7kNvwFFKwqv&_nc_oc=AdpZHF46H71i73uWSXJzz9py6ZpGO4ADXaRgLT1j53Fkb_h3jbR9giGJAJF74odHET8&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJuvZdLgvs06mUJj5RayZEOE0GhQ8vcbv_NkXJusOso7Q&oe=6AAE9D42"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u89c6\u9891\u5c01\u9762.png", "id": "144995564288837", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/38974446_144995567622170_1328094978115473705_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b2XIE32RUNkQ7kNvwGOFPxL&_nc_oc=AdrBoq6Q9Adf8T_3DgX1ZjawbL6NbhJqvKWdV4Z_sW87OrsKDmi0uUW25-TgqGd7Tzk&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIc1iewIdkwuPXv_Ac3HyDUWG7zjjNE5nXGGj1F5Q411Q&oe=6AAEA76C"}, "display_name": "Mortal and Monster", "keywords": [], "long_description": "Mortal & Monster is a challenging rogue-like action RPG developed for Quest. We are aiming to combine tower-defense battle system and rogue-like dungeon map together to make an epic single player VR dungeon adventure.\n\nDynamic Character Build: Discover hundreds of unique weapons, skills, food, potions, wands  and other items to make your own build. \n\nFull 6DOF Battle System: Each weapon has its own unique battle style, including sword&shield, claymore, bow, throwing axe. You can use 6DOF controller to input actions like block, slash, stab, two-hand cleave and so on. \n\nRandom Map and Events: the dungeon map is generated randomly. Each room contains different events like combat encounters, trap, merchant, bonfire, alter, mini card game and so on. Every time you begin your journey in the dark dungeon, the layout differs which is displayed in map. ", "short_description": "Mortal & Monster is a challenging rogue-like action RPG developed for Quest. We are aiming to combine tower-defense battle system and rogue-like dungeon map together to make an epic single player VR dungeon adventure."}]}, "developer_name": "Chemera Games", "developer_privacy_policy_url": "https://www.privacypolicies.com/live/ed3e0079-f83d-4472-bb14-96c5ebd5d6fd", "developer_terms_of_service_url": null, "publisher_name": "Bitsrealm Technology", "support_website_url": null, "website_url": "http://www.mortal-monster.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "821934236779161"}, {"id": "459781504968480"}, {"id": "275629210202852"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "RPG", "EXPLORATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "zh_CN
KcxLg3aCINY&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGiWSec3LJNRreLQRZ4xeIztY4EfLNkCMlIyQdyk--f5w&oe=6A7DC211"}, {"file_name": "sshot5.png", "id": "2943864232404966", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/38974726_2943864235738299_5599921081781756632_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lkCDf-SdWtsQ7kNvwF7B5O5&_nc_oc=Adq-goCTFvLyOwyw6SOp8Q5jVeVDiKQ5ro0HcRKohza-sifke8TFqhf9H0QFKX0xumw&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEq70ACCH1OdJsjLlO0lroz0JWV1Wdh3-HA3pCA9lfVyQ&oe=6A7DC1BF"}, {"file_name": "ssshot2.png", "id": "481825059549076", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/38974729_481825062882409_4002421495152795441_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w9Us5ZTeYzEQ7kNvwG1vbs1&_nc_oc=Adpaty9ZIOIlzdhKiDFsGvDW4As4h78XDIigF_QSwUryTRG-r9dUs3vrgDoCN7632rg&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEDFiMUxqqKI4GSwUxsjTicYnCpphK2lm7xcEYSX7hTWw&oe=6A7DB171"}, {"file_name": "sshot1.png", "id": "3001572386745655", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/38974601_3001572390078988_6193970039339129983_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q_czMkO6dZoQ7kNvwGUc-Yv&_nc_oc=AdrmdQ5MEJ1xx-zOQTtYqJoFx428xhCJyI15RuUlxfV_sUWjsL-5V1DfO5t4ynZNdrI&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH_V39uPAU65L0YHaenT42fwkvB8GS30QCg8EbX8f31mQ&oe=6A7D9D82"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u89c6\u9891\u5c01\u9762.png", "id": "144995564288837", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/38974446_144995567622170_1328094978115473705_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2N7s-SIT12YQ7kNvwHbgLEd&_nc_oc=Adpc0MC2-ojjfD84UZucQ1jKayIkOzc9WP0UIc4MmA4g9au4qS17kXLIXyQJN2NAidk&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHOn_liKGYRFPG35LJfu4QedwCRJmn8IJIM2aKoR8pgEA&oe=6A7DA7AC"}, "display_name": "Mortal and Monster", "keywords": [], "long_description": "Mortal & Monster is a challenging rogue-like action RPG developed for Quest. We are aiming to combine tower-defense battle system and rogue-like dungeon map together to make an epic single player VR dungeon adventure.\n\nDynamic Character Build: Discover hundreds of unique weapons, skills, food, potions, wands  and other items to make your own build. \n\nFull 6DOF Battle System: Each weapon has its own unique battle style, including sword&shield, claymore, bow, throwing axe. You can use 6DOF controller to input actions like block, slash, stab, two-hand cleave and so on. \n\nRandom Map and Events: the dungeon map is generated randomly. Each room contains different events like combat encounters, trap, merchant, bonfire, alter, mini card game and so on. Every time you begin your journey in the dark dungeon, the layout differs which is displayed in map. ", "short_description": "Mortal & Monster is a challenging rogue-like action RPG developed for Quest. We are aiming to combine tower-defense battle system and rogue-like dungeon map together to make an epic single player VR dungeon adventure."}]}, "developer_name": "Chemera Games", "developer_privacy_policy_url": "https://www.privacypolicies.com/live/ed3e0079-f83d-4472-bb14-96c5ebd5d6fd", "developer_terms_of_service_url": null, "publisher_name": "Bitsrealm Technology", "support_website_url": null, "website_url": "http://www.mortal-monster.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "821934236779161"}, {"id": "459781504968480"}, {"id": "275629210202852"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "RPG", "EXPLORATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "zh_CN
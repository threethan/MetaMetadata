ySXH4cAEKZqSs1_bQ&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGlWTltx9imWldh2lyBxS6CPYpzc1ucUnp676LqSFvSPQ&oe=6A8D9411"}, {"file_name": "sshot5.png", "id": "2943864232404966", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/38974726_2943864235738299_5599921081781756632_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yYtJIKoW_UYQ7kNvwHX9f1S&_nc_oc=Ado6T5YnfNh60PWcFfUWY_1mPiVLPYoHEwJAmMpU6i4rDHQNc10W3-_V6Kon0DzDV8g&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEmYUIOCHHu04DYlpH2jTygszKupMhq4M6vdC5jYMpRNQ&oe=6A8D93BF"}, {"file_name": "ssshot2.png", "id": "481825059549076", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/38974729_481825062882409_4002421495152795441_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OcZdu3Z0vDgQ7kNvwHB3U29&_nc_oc=AdoImxBIqxj7Q0i6sApW6N7aUeEfOFElfinEtTC3Ry80vUimLzlHDYCD03k3SFIh-f4&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQES0ZuqvunG1iCDIzw896lGifrIWDauLIQ0aEMFTLgADA&oe=6A8D8371"}, {"file_name": "sshot1.png", "id": "3001572386745655", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/38974601_3001572390078988_6193970039339129983_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nobSbHm05skQ7kNvwGGazfz&_nc_oc=AdrDaGd1w5aZTXSjW58DeVHxxVdaubKwPWEZUFe7x3emj0CiDBMXiHlV8t67_jm215A&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHnB-o7fV7y9fLNinVpUF5spb97KQiL-0fnXyZTvaS-0g&oe=6A8D6F82"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u89c6\u9891\u5c01\u9762.png", "id": "144995564288837", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/38974446_144995567622170_1328094978115473705_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R72N-gh21WYQ7kNvwFuag75&_nc_oc=Adp-840OKsGYifu5WaflUcZKugl6aOpREg2TQMGdQKY7Ps0zsdSdGr9RbVOqfCEO6Ps&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGEamcbXDzXE6Vq0kmxi8BoUfIT4vT3wN43B_nTU5pjJg&oe=6A8D79AC"}, "display_name": "Mortal and Monster", "keywords": [], "long_description": "Mortal & Monster is a challenging rogue-like action RPG developed for Quest. We are aiming to combine tower-defense battle system and rogue-like dungeon map together to make an epic single player VR dungeon adventure.\n\nDynamic Character Build: Discover hundreds of unique weapons, skills, food, potions, wands  and other items to make your own build. \n\nFull 6DOF Battle System: Each weapon has its own unique battle style, including sword&shield, claymore, bow, throwing axe. You can use 6DOF controller to input actions like block, slash, stab, two-hand cleave and so on. \n\nRandom Map and Events: the dungeon map is generated randomly. Each room contains different events like combat encounters, trap, merchant, bonfire, alter, mini card game and so on. Every time you begin your journey in the dark dungeon, the layout differs which is displayed in map. ", "short_description": "Mortal & Monster is a challenging rogue-like action RPG developed for Quest. We are aiming to combine tower-defense battle system and rogue-like dungeon map together to make an epic single player VR dungeon adventure."}]}, "developer_name": "Chemera Games", "developer_privacy_policy_url": "https://www.privacypolicies.com/live/ed3e0079-f83d-4472-bb14-96c5ebd5d6fd", "developer_terms_of_service_url": null, "publisher_name": "Bitsrealm Technology", "support_website_url": null, "website_url": "http://www.mortal-monster.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "821934236779161"}, {"id": "459781504968480"}, {"id": "275629210202852"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "RPG", "EXPLORATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "z
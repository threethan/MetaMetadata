d5-1.oculuscdn.com&_nc_ss=8&oh=00_AfxYpI2tQn_UxW9zrPFxn0kUXLDrTfktLU3c_ruRbVfaCg&oe=69B40C91"}, {"file_name": "sshot5.png", "id": "2943864232404966", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974726_2943864235738299_5599921081781756632_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4hequWtELbMQ7kNvwEwiWt2&_nc_oc=AdmHKedg7y7r3y2OoKdR42HrG6JptqJdnpm7ozxKwI5_GefdrWFKlPH7lfZ5Sb_7RuQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfwCb3IHJ_xqKQssfG82nihkK0Aj6CL0xl-q0necn-LMlg&oe=69B40C3F"}, {"file_name": "ssshot2.png", "id": "481825059549076", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974729_481825062882409_4002421495152795441_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kGx3s8l8WLcQ7kNvwEgBKRP&_nc_oc=Adm4ksA39HMO0hxQpjs_jVA8ZMgxpWtPelW1TfcF3UsK7Hq7PMOxOYD-N_b-nhIye78&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfwLK3-ixrhnNx6zhLNlPxY75DVA-lxcgVGH6kC7VdAVJw&oe=69B3FBF1"}, {"file_name": "sshot1.png", "id": "3001572386745655", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974601_3001572390078988_6193970039339129983_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WGCM1ZZ4LqQQ7kNvwENskZE&_nc_oc=AdlknWP1dbF_4SoKa2C-57Vu734kvqTJ5dXKJ6Dz0273EBogTRZ_CFhgPOVt7OBbS8s&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_Afz7NqLDBAbeLsPuoUtIpIxfcejKBu-UFwzLA1cW_YoyxA&oe=69B42042"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u89c6\u9891\u5c01\u9762.png", "id": "144995564288837", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974446_144995567622170_1328094978115473705_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KMyGqRv-irkQ7kNvwEeOFH7&_nc_oc=AdnSkMRyME2tr9v0Prd95cmTkuiRimX4zhdkXQwlj720KZjzZ2kDjogW6yb68aOMW50&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_Afz8c4D5yMSuE7yp-gh7OvVf03wLyhD-LFg_t04jVOzmkA&oe=69B3F22C"}, "display_name": "Mortal and Monster", "keywords": [], "long_description": "Mortal & Monster is a challenging rogue-like action RPG developed for Quest. We are aiming to combine tower-defense battle system and rogue-like dungeon map together to make an epic single player VR dungeon adventure.\n\nDynamic Character Build: Discover hundreds of unique weapons, skills, food, potions, wands  and other items to make your own build. \n\nFull 6DOF Battle System: Each weapon has its own unique battle style, including sword&shield, claymore, bow, throwing axe. You can use 6DOF controller to input actions like block, slash, stab, two-hand cleave and so on. \n\nRandom Map and Events: the dungeon map is generated randomly. Each room contains different events like combat encounters, trap, merchant, bonfire, alter, mini card game and so on. Every time you begin your journey in the dark dungeon, the layout differs which is displayed in map. ", "short_description": "Mortal & Monster is a challenging rogue-like action RPG developed for Quest. We are aiming to combine tower-defense battle system and rogue-like dungeon map together to make an epic single player VR dungeon adventure."}]}, "developer_name": "Chemera Games", "developer_privacy_policy_url": "https://www.privacypolicies.com/live/ed3e0079-f83d-4472-bb14-96c5ebd5d6fd", "developer_terms_of_service_url": null, "publisher_name": "Bitsrealm Technology", "support_website_url": null, "website_url": "http://www.mortal-monster.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "821934236779161"}, {"id": "459781504968480"}, {"id": "275629210202852"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "RPG", "EXPLORATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "zh_CN"], "supported_input_devices": ["GAMEPAD"], "supported_player_modes"
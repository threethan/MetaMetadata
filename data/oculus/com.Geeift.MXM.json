XVRg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSffT8YeGpYdjnDeRl1pcYLlYywS_20Z-Fu_pdO5YwfeA&oe=6AF1FE51"}, {"file_name": "sshot5.png", "id": "2943864232404966", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974726_2943864235738299_5599921081781756632_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CVDbFh5VmkkQ7kNvwHjr6oi&_nc_oc=AdpuXtiHHdJyPOCQZjoR-39G92kjRTO99phFixTQYSu9z_GlZ1Vr9UcSUirBkNWW8GQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTFyfUhbZDCpMZHWtJGe2jwirYw0owuaegTzONMbFa5Bg&oe=6AF1FDFF"}, {"file_name": "ssshot2.png", "id": "481825059549076", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974729_481825062882409_4002421495152795441_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f-v8I4NtvggQ7kNvwFWuSag&_nc_oc=AdqsKJ6ET9DA-sN83NqymqF_toE45ofCJj9HQQikywdb2qZK7PZ8GBzbnM58_amB8SI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQVLyGrB4COSVHH-ilEzmjX4G_9eCNy9wnTyvi6sNDWlA&oe=6AF1EDB1"}, {"file_name": "sshot1.png", "id": "3001572386745655", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974601_3001572390078988_6193970039339129983_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e1vor362sUUQ7kNvwE3fZZI&_nc_oc=AdqpUkg7cFfpDbqfoKMhYgZO-q_nPWf2dM6ogxqG8Cyd71Q8kuHJ08IQPYTpdqn4OBM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTnEBHZRnRXpM9XrJlQJRdX8_rRfJMnes3X8LhAgCma5w&oe=6AF1D9C2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u89c6\u9891\u5c01\u9762.png", "id": "144995564288837", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974446_144995567622170_1328094978115473705_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nuCHU3IFlFkQ7kNvwHWZ3od&_nc_oc=Adq3f8i9LV8KqZYiHn6DtbwpNY2u-vITf8eP9TNtir2IWO9rfch1ffrvIYQJSYa8hpY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTJLjBPD8vOhxJ60i3NoWAbhrGFpKeR3BvC5ZwRuN02qw&oe=6AF1E3EC"}, "display_name": "Mortal and Monster", "keywords": [], "long_description": "Mortal & Monster is a challenging rogue-like action RPG developed for Quest. We are aiming to combine tower-defense battle system and rogue-like dungeon map together to make an epic single player VR dungeon adventure.\n\nDynamic Character Build: Discover hundreds of unique weapons, skills, food, potions, wands  and other items to make your own build. \n\nFull 6DOF Battle System: Each weapon has its own unique battle style, including sword&shield, claymore, bow, throwing axe. You can use 6DOF controller to input actions like block, slash, stab, two-hand cleave and so on. \n\nRandom Map and Events: the dungeon map is generated randomly. Each room contains different events like combat encounters, trap, merchant, bonfire, alter, mini card game and so on. Every time you begin your journey in the dark dungeon, the layout differs which is displayed in map. ", "short_description": "Mortal & Monster is a challenging rogue-like action RPG developed for Quest. We are aiming to combine tower-defense battle system and rogue-like dungeon map together to make an epic single player VR dungeon adventure."}]}, "developer_name": "Chemera Games", "developer_privacy_policy_url": "https://www.privacypolicies.com/live/ed3e0079-f83d-4472-bb14-96c5ebd5d6fd", "developer_terms_of_service_url": null, "publisher_name": "Bitsrealm Technology", "support_website_url": null, "website_url": "http://www.mortal-monster.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "821934236779161"}, {"id": "459781504968480"}, {"id": "275629210202852"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "RPG", "EXPLORATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "zh_CN"], "supported_i
kXbU&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6lzPlGoIuZNGSHW09O3dvurF198-I-vXc7pwOfa_xBPw&oe=69FDE091"}, {"file_name": "sshot5.png", "id": "2943864232404966", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974726_2943864235738299_5599921081781756632_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UIByJuuWrScQ7kNvwEvPAnO&_nc_oc=AdqnHl4mcqDxvYqFJN7qZ-Zb4k_oL4EbxKasK9Fg53o2U_41dzXWKyZwKIfPK6NR32E&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5bkYeP9saT095o5n2VeHvy4Y1BggUHsllt3O0IGE2Lbw&oe=69FDE03F"}, {"file_name": "ssshot2.png", "id": "481825059549076", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974729_481825062882409_4002421495152795441_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ogMQRA_rCf4Q7kNvwEIUr_U&_nc_oc=AdpYF5G45bf23sfy9XSaFGn86QecQws4MHwPMBvCGuj4oI68Wr7Br5xMie-hmSHqae4&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7Plfz-EBzmD19Crv8vYkeCeTjGZv24FB7NTC9kEDu_SQ&oe=69FDCFF1"}, {"file_name": "sshot1.png", "id": "3001572386745655", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974601_3001572390078988_6193970039339129983_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lpKJC8SVpqQQ7kNvwFEeO1y&_nc_oc=AdqUv9xmV2kc4lp6njWtKps5QeZ9zlIFARcUjX1IMoj9z20ixF5CTT0B6ybVOEycGR0&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6a6EwGiXpdtyea1kRMLcxx3ePpLaO40109lhNy9-c0yQ&oe=69FDF442"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u89c6\u9891\u5c01\u9762.png", "id": "144995564288837", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974446_144995567622170_1328094978115473705_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D2z4v5ZZl3EQ7kNvwFuzw7a&_nc_oc=AdqHcswaOrqTyWzGn_JXSEEl39-PMgN3LAhyFjoZPSlqkPC4RTd2TRj6AvEzaOfWjPA&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6UJoYfFgAp-0rtAnBq5c5Q8WS6yCQM4ch3ytBQV09iVA&oe=69FDFE6C"}, "display_name": "Mortal and Monster", "keywords": [], "long_description": "Mortal & Monster is a challenging rogue-like action RPG developed for Quest. We are aiming to combine tower-defense battle system and rogue-like dungeon map together to make an epic single player VR dungeon adventure.\n\nDynamic Character Build: Discover hundreds of unique weapons, skills, food, potions, wands  and other items to make your own build. \n\nFull 6DOF Battle System: Each weapon has its own unique battle style, including sword&shield, claymore, bow, throwing axe. You can use 6DOF controller to input actions like block, slash, stab, two-hand cleave and so on. \n\nRandom Map and Events: the dungeon map is generated randomly. Each room contains different events like combat encounters, trap, merchant, bonfire, alter, mini card game and so on. Every time you begin your journey in the dark dungeon, the layout differs which is displayed in map. ", "short_description": "Mortal & Monster is a challenging rogue-like action RPG developed for Quest. We are aiming to combine tower-defense battle system and rogue-like dungeon map together to make an epic single player VR dungeon adventure."}]}, "developer_name": "Chemera Games", "developer_privacy_policy_url": "https://www.privacypolicies.com/live/ed3e0079-f83d-4472-bb14-96c5ebd5d6fd", "developer_terms_of_service_url": null, "publisher_name": "Bitsrealm Technology", "support_website_url": null, "website_url": "http://www.mortal-monster.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "821934236779161"}, {"id": "459781504968480"}, {"id": "275629210202852"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "RPG", "EXPLORATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "zh_CN"], "supported_i
d3-1.oculuscdn.com&_nc_ss=8&oh=00_AfyP0dcksNBy-2FLpgLJvp1kCTRESqS70_zmVX6AiETF8Q&oe=69BFEA11"}, {"file_name": "sshot5.png", "id": "2943864232404966", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974726_2943864235738299_5599921081781756632_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ozFg8SbkTwQQ7kNvwHPmTPl&_nc_oc=AdnMpfu37txrAigO0d89gw5lpMFSOchs00PbAiu31JFukS_LvoOKFtPWq6UjUb96iLo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfxuGsQ9C5pRYOlRDURQ5LH2n5Zr_iSGzk3E2DAzek3FmQ&oe=69BFE9BF"}, {"file_name": "ssshot2.png", "id": "481825059549076", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974729_481825062882409_4002421495152795441_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0m8KHp6FAsMQ7kNvwF5I2bx&_nc_oc=AdlE9jBuM0szhHCdD2Jz5iFHIt0y3FyhygP8q1woyQHxfNXR5oz3zZ5F6Jd8BGhXTUc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfzcDO8DFoHq1t3nck93_EQS0WrGh1K447VAiGItn-nX7g&oe=69BFD971"}, {"file_name": "sshot1.png", "id": "3001572386745655", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974601_3001572390078988_6193970039339129983_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mDLJ3EGafhoQ7kNvwH7Wybd&_nc_oc=AdnhVRon-NmxsVma5vCw2N2Uo3H9cXE5UbOdgxgGrVhIdU9pinc0K9HVz5cwMRxIeeA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfwXzv6mX_NmUuBVAnN_TPZyBOWIf6oL_3hFO9ya8HBTNA&oe=69BFFDC2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u89c6\u9891\u5c01\u9762.png", "id": "144995564288837", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974446_144995567622170_1328094978115473705_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YnJGG92CC_IQ7kNvwGV8Wh5&_nc_oc=AdlNQ82raOR9hnWpZ6xEnYpEz8RSmmlqCOdKxvuAYK5XATHGi1CtjJJtTu8tx9l7iW8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfzU3EJXfQmOfVqeVc19ZbGwzouPLf7aC0nNB9VVB4rEqw&oe=69BFCFAC"}, "display_name": "Mortal and Monster", "keywords": [], "long_description": "Mortal & Monster is a challenging rogue-like action RPG developed for Quest. We are aiming to combine tower-defense battle system and rogue-like dungeon map together to make an epic single player VR dungeon adventure.\n\nDynamic Character Build: Discover hundreds of unique weapons, skills, food, potions, wands  and other items to make your own build. \n\nFull 6DOF Battle System: Each weapon has its own unique battle style, including sword&shield, claymore, bow, throwing axe. You can use 6DOF controller to input actions like block, slash, stab, two-hand cleave and so on. \n\nRandom Map and Events: the dungeon map is generated randomly. Each room contains different events like combat encounters, trap, merchant, bonfire, alter, mini card game and so on. Every time you begin your journey in the dark dungeon, the layout differs which is displayed in map. ", "short_description": "Mortal & Monster is a challenging rogue-like action RPG developed for Quest. We are aiming to combine tower-defense battle system and rogue-like dungeon map together to make an epic single player VR dungeon adventure."}]}, "developer_name": "Chemera Games", "developer_privacy_policy_url": "https://www.privacypolicies.com/live/ed3e0079-f83d-4472-bb14-96c5ebd5d6fd", "developer_terms_of_service_url": null, "publisher_name": "Bitsrealm Technology", "support_website_url": null, "website_url": "http://www.mortal-monster.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "821934236779161"}, {"id": "459781504968480"}, {"id": "275629210202852"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "RPG", "EXPLORATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "zh_CN"], "supported_input_devices": ["GAMEPAD"], "supported_player_modes"
wRu8&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ7aDm1Jjq1lbrc8v9EdOeoU3nui_CG4ZVP9M_0OIrcIw&oe=6AB67291"}, {"file_name": "sshot5.png", "id": "2943864232404966", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38974726_2943864235738299_5599921081781756632_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5t3PQI4eCHcQ7kNvwE639at&_nc_oc=AdrGo9i4RnHMiuc0HxgosTQKj1yC9ejcn4ZkUQX2pBwWFJ-OEvkVxanuhbGHf75BSkQ&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIdQj-B9Sy5S-PolH1ifxG6bEAsvWZCi3GLS2r2e8IHhg&oe=6AB6723F"}, {"file_name": "ssshot2.png", "id": "481825059549076", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38974729_481825062882409_4002421495152795441_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KGQkCPooPzMQ7kNvwF8SjET&_nc_oc=AdolqyhRmPWXznGGT67Vm8QnJD1GYDgAWG1LJRUYmX173VNxjQXJk5kojbwXrr2u6Ew&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKWIXJhlN9cpI_0odCts5Mxap3hiBvrlmgucwpK_XTJeQ&oe=6AB69A31"}, {"file_name": "sshot1.png", "id": "3001572386745655", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38974601_3001572390078988_6193970039339129983_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EHkeHZH6VI4Q7kNvwHC7Y7h&_nc_oc=AdoD-ayZgMtZg62iouuPEMMdUxfwj9xZCeQsvNvyKrWZRE2VvQlgLUqo1PIeb39sBGU&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJPWiKURBIegVLBLiK35_-5huo7EQcGud0FHg9PjglQKQ&oe=6AB68642"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u89c6\u9891\u5c01\u9762.png", "id": "144995564288837", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974446_144995567622170_1328094978115473705_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a5-8PIfwZ1wQ7kNvwGOkxYA&_nc_oc=AdpsYBq4YjOCgMJvJh5VEP4mOOnjJW3Dxmcp8W51A1hXkI7UnOhg5qnpLPVzlpytrFU&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIg6Mcyax-aHAg43Tbw5jrdJyZaVONrbJGHZTPAM4gjZA&oe=6AB6906C"}, "display_name": "Mortal and Monster", "keywords": [], "long_description": "Mortal & Monster is a challenging rogue-like action RPG developed for Quest. We are aiming to combine tower-defense battle system and rogue-like dungeon map together to make an epic single player VR dungeon adventure.\n\nDynamic Character Build: Discover hundreds of unique weapons, skills, food, potions, wands  and other items to make your own build. \n\nFull 6DOF Battle System: Each weapon has its own unique battle style, including sword&shield, claymore, bow, throwing axe. You can use 6DOF controller to input actions like block, slash, stab, two-hand cleave and so on. \n\nRandom Map and Events: the dungeon map is generated randomly. Each room contains different events like combat encounters, trap, merchant, bonfire, alter, mini card game and so on. Every time you begin your journey in the dark dungeon, the layout differs which is displayed in map. ", "short_description": "Mortal & Monster is a challenging rogue-like action RPG developed for Quest. We are aiming to combine tower-defense battle system and rogue-like dungeon map together to make an epic single player VR dungeon adventure."}]}, "developer_name": "Chemera Games", "developer_privacy_policy_url": "https://www.privacypolicies.com/live/ed3e0079-f83d-4472-bb14-96c5ebd5d6fd", "developer_terms_of_service_url": null, "publisher_name": "Bitsrealm Technology", "support_website_url": null, "website_url": "http://www.mortal-monster.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "821934236779161"}, {"id": "459781504968480"}, {"id": "275629210202852"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "RPG", "EXPLORATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "zh_CN"], "supported_i
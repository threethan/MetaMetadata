less&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NvD7mW7CzCcQ7kNvwGHfoN0&_nc_oc=AdoOpDFWYxt3hx38jAibtSFcnzNb_6I7tNvorcCVHYkpSzj9849OowyWLnPMgimHE6g&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRtn_FGdxnwaCzFnuTyKsVbKF40YZgHMVOXRqzg7AxG8g&oe=6B0867D1"}, {"file_name": "sshot5.png", "id": "2943864232404966", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974726_2943864235738299_5599921081781756632_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l0ORyYHNQ4oQ7kNvwFNZeNS&_nc_oc=Ado1ce4wqHZLzU65bd3zc_GW_6f4AtYwI0Cw67-s-GsmNdU9kxv5b0vvmb8CpGKHnoc&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSzYj3M_yEf6rn1kvvqUS0wlnF5DZt-3IlWcum_szsnoA&oe=6B08677F"}, {"file_name": "ssshot2.png", "id": "481825059549076", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974729_481825062882409_4002421495152795441_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ru-fGvPVcIIQ7kNvwEVK--B&_nc_oc=AdpsQYWdacc1yhoPHzSVtWrg_I_oLxx3HqIpSXuTZFMccMxvN46nojxHB4hkTxjjXRM&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTdg43suQYKJLEPTGUqRutN-NU5wLLceFsOTyvA_VJ92Q&oe=6B085731"}, {"file_name": "sshot1.png", "id": "3001572386745655", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/38974601_3001572390078988_6193970039339129983_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FUJ6exYs9vMQ7kNvwHVa13X&_nc_oc=AdqB-WFKYRRruRFO9d-gdTDBK4vCBepEndMvMtVPdApdVdY-St2RQjW1juGfTMaxUlE&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRmVQ6VAzt5wfMtWh0FrxNc0Uzmz6bVo7Lfc2zJUf5J5A&oe=6B084342"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u89c6\u9891\u5c01\u9762.png", "id": "144995564288837", "uri": "https://scontent-dfw5-3.oculuscdn.com/v/t64.5771-25/38974446_144995567622170_1328094978115473705_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5zNrdGyQDEEQ7kNvwG4CYDG&_nc_oc=Adr0XvwLTLTWxvxzpY5VgtjHyOTYCpEHlhM-78AAPRc2NOhp4PIeswgRFsMUM00ZNgU&_nc_zt=3&_nc_ht=scontent-dfw5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRR0tA30PX9R8p8MUjTpw0Tal9gCPjDoItPtS5OuKXzQQ&oe=6B084D6C"}, "display_name": "Mortal and Monster", "keywords": [], "long_description": "Mortal & Monster is a challenging rogue-like action RPG developed for Quest. We are aiming to combine tower-defense battle system and rogue-like dungeon map together to make an epic single player VR dungeon adventure.\n\nDynamic Character Build: Discover hundreds of unique weapons, skills, food, potions, wands  and other items to make your own build. \n\nFull 6DOF Battle System: Each weapon has its own unique battle style, including sword&shield, claymore, bow, throwing axe. You can use 6DOF controller to input actions like block, slash, stab, two-hand cleave and so on. \n\nRandom Map and Events: the dungeon map is generated randomly. Each room contains different events like combat encounters, trap, merchant, bonfire, alter, mini card game and so on. Every time you begin your journey in the dark dungeon, the layout differs which is displayed in map. ", "short_description": "Mortal & Monster is a challenging rogue-like action RPG developed for Quest. We are aiming to combine tower-defense battle system and rogue-like dungeon map together to make an epic single player VR dungeon adventure."}]}, "developer_name": "Chemera Games", "developer_privacy_policy_url": "https://www.privacypolicies.com/live/ed3e0079-f83d-4472-bb14-96c5ebd5d6fd", "developer_terms_of_service_url": null, "publisher_name": "Bitsrealm Technology", "support_website_url": null, "website_url": "http://www.mortal-monster.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "821934236779161"}, {"id": "459781504968480"}, {"id": "275629210202852"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "RPG", "EXPLORATION"],
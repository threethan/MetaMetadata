w6-1.oculuscdn.com&_nc_ss=8&oh=00_Afxtj6blElWRUSlBs3IpPHk5cGNpjNlOlIabz8OS7CKDYA&oe=69BD4711"}, {"file_name": "sshot5.png", "id": "2943864232404966", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974726_2943864235738299_5599921081781756632_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ozFg8SbkTwQQ7kNvwFLobng&_nc_oc=AdkeoVkptRgEXqKm0AVOlrBLkcjV78BBhxDXRn7nN2Xagx0WFs-CVgWtD4mskjFA5Mo&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=8&oh=00_AfwkWlQYQUMxRlxGVBrXpVKryLkHTUPbMDzwu9uY-MEffQ&oe=69BD46BF"}, {"file_name": "ssshot2.png", "id": "481825059549076", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974729_481825062882409_4002421495152795441_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uGfdXNngu1wQ7kNvwH504u1&_nc_oc=AdksX-W_Mt4ba18BX09I8OL6zkm53LO4SjPGPEZ7KJXkO75US-oCFmLGJQss6_rq6p8&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=8&oh=00_Afyvlg1ekp6jxkFRek9NmC2Ru83AZprS6Yg_vuLoj2TjMw&oe=69BD3671"}, {"file_name": "sshot1.png", "id": "3001572386745655", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974601_3001572390078988_6193970039339129983_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mDLJ3EGafhoQ7kNvwFK-i7N&_nc_oc=Adku25SuDBlSJsYsexsJkUN3wvwevhqFMcp1RZqI9MFJuBhMax9phEiPlYVFISaVumE&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=8&oh=00_AfxW-nMCTGPd2zFqDPlpjvLHGdCP3RucWF_DeMbnz9JxSA&oe=69BD5AC2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u89c6\u9891\u5c01\u9762.png", "id": "144995564288837", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974446_144995567622170_1328094978115473705_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YnJGG92CC_IQ7kNvwHhOrHN&_nc_oc=AdnKBNkFHIfTIQr2J51K8FJx9vKNN5Xs_02iS_0whM0aOUtwLMLRIUvGm0V7otCB3r0&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=8&oh=00_AfwKZ6FTFnIt5TfAZ2TXyUE0CDNRDzePKyGSkX56yeW6ww&oe=69BD2CAC"}, "display_name": "Mortal and Monster", "keywords": [], "long_description": "Mortal & Monster is a challenging rogue-like action RPG developed for Quest. We are aiming to combine tower-defense battle system and rogue-like dungeon map together to make an epic single player VR dungeon adventure.\n\nDynamic Character Build: Discover hundreds of unique weapons, skills, food, potions, wands  and other items to make your own build. \n\nFull 6DOF Battle System: Each weapon has its own unique battle style, including sword&shield, claymore, bow, throwing axe. You can use 6DOF controller to input actions like block, slash, stab, two-hand cleave and so on. \n\nRandom Map and Events: the dungeon map is generated randomly. Each room contains different events like combat encounters, trap, merchant, bonfire, alter, mini card game and so on. Every time you begin your journey in the dark dungeon, the layout differs which is displayed in map. ", "short_description": "Mortal & Monster is a challenging rogue-like action RPG developed for Quest. We are aiming to combine tower-defense battle system and rogue-like dungeon map together to make an epic single player VR dungeon adventure."}]}, "developer_name": "Chemera Games", "developer_privacy_policy_url": "https://www.privacypolicies.com/live/ed3e0079-f83d-4472-bb14-96c5ebd5d6fd", "developer_terms_of_service_url": null, "publisher_name": "Bitsrealm Technology", "support_website_url": null, "website_url": "http://www.mortal-monster.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "821934236779161"}, {"id": "459781504968480"}, {"id": "275629210202852"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "RPG", "EXPLORATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "zh_CN"], "supported_input_devices": ["GAMEPAD"], "supported_player_modes"
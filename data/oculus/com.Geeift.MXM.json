.com/v/t64.5771-25/38974685_1684316901772135_8133156274043170107_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rN6wOERNN4kQ7kNvwGRwzCc&_nc_oc=AdrCcKTBl_HLzE_OaUutsHE8hEoCWjeMxAV1OGYqU-C4Ry3RztyhaCN6HPTHPubP9_0&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSxUYimlcgc8CjI6IjuywCEVo9nyFW3zaFGmtXLgBHieg&oe=6AFB38D1"}, {"file_name": "sshot5.png", "id": "2943864232404966", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38974726_2943864235738299_5599921081781756632_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U_QN8JuHkQUQ7kNvwGTvJY2&_nc_oc=Adpf_AXBohdXVi7JLGxuE4_d7oWT6VTV93JlNrkI-BS197jsn6BciaefJ9Wa-sVP6bA&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSrKQJbJU0DyzudgrHoZGhjmK8FvqLrAhtpQfcR5kZtwg&oe=6AFB387F"}, {"file_name": "ssshot2.png", "id": "481825059549076", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38974729_481825062882409_4002421495152795441_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7uaCZ4ifeHgQ7kNvwFi7Has&_nc_oc=AdpjsbAzJoMLQ-sRnozBbfEzvqtnwpva_P6LKAQdcXf3HLuG3GXoJuNWVn3UdJacot0&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQw9gVqP-octK6D1WSnjH0MsO-EEvmyfsg43pyXSFBFcA&oe=6AFB2831"}, {"file_name": "sshot1.png", "id": "3001572386745655", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38974601_3001572390078988_6193970039339129983_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yIM01sANwMMQ7kNvwFAvnPC&_nc_oc=AdoWdkqbN-ZRjmJUZbrn-pAOIpH-dWKLZbNftQXN6Act1-VetFP9Q3GRrE2-6mMA0OE&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRfXIm1vhcR2PYuNRq0sCRX_aTK5LjDE0QOTDFR2y99ew&oe=6AFB4C82"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u89c6\u9891\u5c01\u9762.png", "id": "144995564288837", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38974446_144995567622170_1328094978115473705_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VPNc0v1mi_QQ7kNvwGUp3kI&_nc_oc=AdpyF7B6WSmfjoUf3XQPlCnn83_FLdlNjOSFNGMR499iJoj35SRMgqh8eUiDLAKRP6U&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS7UL8b7qleiewsK_dKJkOUPrnkQbiC4DsWpGDREXIsCA&oe=6AFB1E6C"}, "display_name": "Mortal and Monster", "keywords": [], "long_description": "Mortal & Monster is a challenging rogue-like action RPG developed for Quest. We are aiming to combine tower-defense battle system and rogue-like dungeon map together to make an epic single player VR dungeon adventure.\n\nDynamic Character Build: Discover hundreds of unique weapons, skills, food, potions, wands  and other items to make your own build. \n\nFull 6DOF Battle System: Each weapon has its own unique battle style, including sword&shield, claymore, bow, throwing axe. You can use 6DOF controller to input actions like block, slash, stab, two-hand cleave and so on. \n\nRandom Map and Events: the dungeon map is generated randomly. Each room contains different events like combat encounters, trap, merchant, bonfire, alter, mini card game and so on. Every time you begin your journey in the dark dungeon, the layout differs which is displayed in map. ", "short_description": "Mortal & Monster is a challenging rogue-like action RPG developed for Quest. We are aiming to combine tower-defense battle system and rogue-like dungeon map together to make an epic single player VR dungeon adventure."}]}, "developer_name": "Chemera Games", "developer_privacy_policy_url": "https://www.privacypolicies.com/live/ed3e0079-f83d-4472-bb14-96c5ebd5d6fd", "developer_terms_of_service_url": null, "publisher_name": "Bitsrealm Technology", "support_website_url": null, "website_url": "http://www.mortal-monster.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "821934236779161"}, {"id": "459781504968480"}, {"id": "27562
less&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Vzj1DPSLXrAQ7kNvwEFMpV_&_nc_oc=Ado48SsLsuvYtI8YAIEst-nV4QKHF53qysfuS0IuitVUoQ4hr0Y1sxsGqbxIIv89bwc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQI9QCNkyLrbQClm4kTYTKGyUnIEvcM7aZyavYlYJ2Fcw&oe=6B007ED1"}, {"file_name": "sshot5.png", "id": "2943864232404966", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974726_2943864235738299_5599921081781756632_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Sq8krjH7CNwQ7kNvwHZh6_n&_nc_oc=AdpRFuRTnhttKrP8gWn1FFcAMpKdxrg2LO-Dz35-HXoYBad6i3Bo_Z4n_QoFlGNQ0PI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQWywQBXeouZ_ze8JfIC86XUVlmEdDais7yjPVoZv4Edg&oe=6B007E7F"}, {"file_name": "ssshot2.png", "id": "481825059549076", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974729_481825062882409_4002421495152795441_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zKBMqNURRUgQ7kNvwGNTxS5&_nc_oc=AdoWIVqXTs5YagaJFZObfYz8Zbs9R_0uKcyPU4EGivdKe_NC326tdxzXbVlf4F2yfsU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQxlK6GTzC4cORzahdgXepC1USt8WYQltru2llLpLdPtg&oe=6B006E31"}, {"file_name": "sshot1.png", "id": "3001572386745655", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974601_3001572390078988_6193970039339129983_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zenNozCnn2IQ7kNvwGTLy0p&_nc_oc=Ados-f5M0cyhnNtZKFyN7eKm64iyLSHnWunmBO3dEl5hjqrRsbcYxQg0adMrnZX86R4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQt27j3GQaey6GaKKK1eZWtYIso6kdhw4U4vQMJZl3ZCQ&oe=6B005A42"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u89c6\u9891\u5c01\u9762.png", "id": "144995564288837", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974446_144995567622170_1328094978115473705_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Q0uUe-2FsPsQ7kNvwG8y5Bh&_nc_oc=AdpZDonzWg41DUuG732YrISBwqu3t3jqNuxcsqNeM7MIRNoHw2QbFvu-P_SSfPLiAH8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSMnoxGihkC8HQscaHKh8iGrceBtHLCIYNO9vp14xC4Cw&oe=6B00646C"}, "display_name": "Mortal and Monster", "keywords": [], "long_description": "Mortal & Monster is a challenging rogue-like action RPG developed for Quest. We are aiming to combine tower-defense battle system and rogue-like dungeon map together to make an epic single player VR dungeon adventure.\n\nDynamic Character Build: Discover hundreds of unique weapons, skills, food, potions, wands  and other items to make your own build. \n\nFull 6DOF Battle System: Each weapon has its own unique battle style, including sword&shield, claymore, bow, throwing axe. You can use 6DOF controller to input actions like block, slash, stab, two-hand cleave and so on. \n\nRandom Map and Events: the dungeon map is generated randomly. Each room contains different events like combat encounters, trap, merchant, bonfire, alter, mini card game and so on. Every time you begin your journey in the dark dungeon, the layout differs which is displayed in map. ", "short_description": "Mortal & Monster is a challenging rogue-like action RPG developed for Quest. We are aiming to combine tower-defense battle system and rogue-like dungeon map together to make an epic single player VR dungeon adventure."}]}, "developer_name": "Chemera Games", "developer_privacy_policy_url": "https://www.privacypolicies.com/live/ed3e0079-f83d-4472-bb14-96c5ebd5d6fd", "developer_terms_of_service_url": null, "publisher_name": "Bitsrealm Technology", "support_website_url": null, "website_url": "http://www.mortal-monster.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "821934236779161"}, {"id": "459781504968480"}, {"id": "275629210202852"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "RPG", "EXPLORATION"],
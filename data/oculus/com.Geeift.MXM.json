8QnU&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_hjl-bj0hI9ZhhnxBrvf0dSq33vhG1dMcG9kF4oOJVpQ&oe=6A217911"}, {"file_name": "sshot5.png", "id": "2943864232404966", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974726_2943864235738299_5599921081781756632_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LVUS_-hmvTUQ7kNvwG1xxeY&_nc_oc=AdrJ1QdGEB3be1Do5L0F9rQHKh9wkWmwQHeSdCqjLHSR1xDfMe2IPvOGlYgWSw24DNg&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9x7NwOJoldedRltgYkEyTeiLEogXKnzDiCVW8GkV7DGw&oe=6A2178BF"}, {"file_name": "ssshot2.png", "id": "481825059549076", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974729_481825062882409_4002421495152795441_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N0Eup1kMCW0Q7kNvwFt5XQc&_nc_oc=Adqb9E5bYss5_82meK_fRCVKqVuLs9ip-AVBnsGJ75LCDLB_Ym1m5Zmbx0E64ihM3vM&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-jV-KvhhLkuTW8ZO2hQVvufjU7UpS00yPhpnRO4hg2tg&oe=6A21A0B1"}, {"file_name": "sshot1.png", "id": "3001572386745655", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974601_3001572390078988_6193970039339129983_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-mn4ox5r2acQ7kNvwGsDV-0&_nc_oc=AdoZRhCBNPPBHrhMdR27u2ZlsemPOououk9HQvXZuSHmD3vnJ3Oz-b81kqz4nJYZVrQ&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9VXL2Zi5J9Q5mS5D4M5ncCX1upHqv2AKjsbVKEb8oZWw&oe=6A218CC2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u89c6\u9891\u5c01\u9762.png", "id": "144995564288837", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974446_144995567622170_1328094978115473705_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ozgbc6HfmyYQ7kNvwHcU8Xo&_nc_oc=AdoPZxd8f6_EarInb0A-A2YRFUzxiHnhlmefziaHfJHZ-3o_TeKvbOv7PEpJNMU1RLE&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8NfdZSnrl9cgY2gcGkOYo5camNp4WJXiTwjto65V_w7Q&oe=6A2196EC"}, "display_name": "Mortal and Monster", "keywords": [], "long_description": "Mortal & Monster is a challenging rogue-like action RPG developed for Quest. We are aiming to combine tower-defense battle system and rogue-like dungeon map together to make an epic single player VR dungeon adventure.\n\nDynamic Character Build: Discover hundreds of unique weapons, skills, food, potions, wands  and other items to make your own build. \n\nFull 6DOF Battle System: Each weapon has its own unique battle style, including sword&shield, claymore, bow, throwing axe. You can use 6DOF controller to input actions like block, slash, stab, two-hand cleave and so on. \n\nRandom Map and Events: the dungeon map is generated randomly. Each room contains different events like combat encounters, trap, merchant, bonfire, alter, mini card game and so on. Every time you begin your journey in the dark dungeon, the layout differs which is displayed in map. ", "short_description": "Mortal & Monster is a challenging rogue-like action RPG developed for Quest. We are aiming to combine tower-defense battle system and rogue-like dungeon map together to make an epic single player VR dungeon adventure."}]}, "developer_name": "Chemera Games", "developer_privacy_policy_url": "https://www.privacypolicies.com/live/ed3e0079-f83d-4472-bb14-96c5ebd5d6fd", "developer_terms_of_service_url": null, "publisher_name": "Bitsrealm Technology", "support_website_url": null, "website_url": "http://www.mortal-monster.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "821934236779161"}, {"id": "459781504968480"}, {"id": "275629210202852"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "RPG", "EXPLORATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "zh_CN"], "supported_i
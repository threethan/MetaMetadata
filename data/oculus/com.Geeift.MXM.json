-kSs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af30Cjr-oprO9FnHv_W3ScxWjayACsX8s4m0BtqE6VStjA&oe=69D65391"}, {"file_name": "sshot5.png", "id": "2943864232404966", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974726_2943864235738299_5599921081781756632_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BixenMBOwlAQ7kNvwGkVX2l&_nc_oc=AdqXI1elx0b-49ui4ib5yUd3h4UCycAjGY-dtfiDGIyT5FihC1-Oi7Sw05CMeYn32uQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af16Xh38aqq9Bbh4kGv5RAIeTHl8hfApgyRbsD4Q1hMQoQ&oe=69D6533F"}, {"file_name": "ssshot2.png", "id": "481825059549076", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974729_481825062882409_4002421495152795441_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GYgnbe8NlhkQ7kNvwHuf296&_nc_oc=AdrsrgQSiJUSVbfgYX3dmiCguYDoVp25sHXCE1CkFvV4Thh_Jn-b9rkIa_g6-VUh_Fo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af17AlOBD_bN7amkPd3eRvbktIosjWUlNPnOEBdPqYbqFQ&oe=69D642F1"}, {"file_name": "sshot1.png", "id": "3001572386745655", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974601_3001572390078988_6193970039339129983_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e7xUNwdCPtcQ7kNvwGNve7q&_nc_oc=Adp-I2lF_eHvM_pQgzQWbvDGoyrVPzK7OVEu2FZVZ8EwpIBYPc6t445DKU8Pll09VOU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1iwfjc2xRxTC2pYVvesjTX0AQp4TT2E-PSOaw4_2yuJQ&oe=69D66742"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u89c6\u9891\u5c01\u9762.png", "id": "144995564288837", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974446_144995567622170_1328094978115473705_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F0-79zMA0V4Q7kNvwFR18xK&_nc_oc=AdrwnlJ9Z_l1wpXG2j6W3wSVxHpQfFc29PyL2TkDwZ2wsQ4FH3PZzbP-d7_4VY-3mSY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3mMwKdWmOWVlz8fFc7XVftUVgmmaIfdGJ8quBgVT5Z0A&oe=69D6392C"}, "display_name": "Mortal and Monster", "keywords": [], "long_description": "Mortal & Monster is a challenging rogue-like action RPG developed for Quest. We are aiming to combine tower-defense battle system and rogue-like dungeon map together to make an epic single player VR dungeon adventure.\n\nDynamic Character Build: Discover hundreds of unique weapons, skills, food, potions, wands  and other items to make your own build. \n\nFull 6DOF Battle System: Each weapon has its own unique battle style, including sword&shield, claymore, bow, throwing axe. You can use 6DOF controller to input actions like block, slash, stab, two-hand cleave and so on. \n\nRandom Map and Events: the dungeon map is generated randomly. Each room contains different events like combat encounters, trap, merchant, bonfire, alter, mini card game and so on. Every time you begin your journey in the dark dungeon, the layout differs which is displayed in map. ", "short_description": "Mortal & Monster is a challenging rogue-like action RPG developed for Quest. We are aiming to combine tower-defense battle system and rogue-like dungeon map together to make an epic single player VR dungeon adventure."}]}, "developer_name": "Chemera Games", "developer_privacy_policy_url": "https://www.privacypolicies.com/live/ed3e0079-f83d-4472-bb14-96c5ebd5d6fd", "developer_terms_of_service_url": null, "publisher_name": "Bitsrealm Technology", "support_website_url": null, "website_url": "http://www.mortal-monster.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "821934236779161"}, {"id": "459781504968480"}, {"id": "275629210202852"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "RPG", "EXPLORATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "zh_CN"], "supported_i
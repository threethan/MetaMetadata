24_649494152501393_4889968777875161088_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=km2-mjIkKiAQ7kNvwEat-fk&_nc_oc=Adm2HoNPjWuQedQc2mONjgzjw1v5yVzUbC6rU_dacontREtz7_Y09RaChEN4RBPJS8U&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfxP6_8XfhoE2bZnkSQgqbG8AU0nMUNWYNWU9RbWheDpFQ&oe=69BFDA58"}, {"file_name": "aDU9NY.png", "id": "513503572678353", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974624_513503576011686_5452742568917860352_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zpvcYqL0kF4Q7kNvwFBQXb-&_nc_oc=AdkTdMmqbUlORHZLn_6-lBZ673f2nOK1cIqB9HxSgkHEMe-jTRrWvQ7VW-6wEyWktsQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_Afwcgb112rBKF4ax_f2AUEFhPxovbX1uiaDmQ8PnkZfKXg&oe=69BFFC7E"}, {"file_name": "d5e4uO.png", "id": "233096617897309", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982699_233096621230642_1541719454822432768_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SEvdage2VMIQ7kNvwEidBkh&_nc_oc=AdkWqmfmUPbpcMJPZZniejiyalpYQrKWtGoEr7N78RvAW2H4bWfcZn99elnETrpv-VE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_Afx6ejwhHi49iQVYX6hql4PmWgZ4Brx_HhHGyAd8ASy8-g&oe=69BFFDFD"}, {"file_name": "PS1tWP.png", "id": "223941032361146", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974555_223941035694479_8181425666768502784_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MbnFaUgxdCMQ7kNvwHLMWeu&_nc_oc=AdlIF-XX7ctlNlX90UKLunTTiCfxBE7m7A1G9f0YAJGHBVxBT3YFMfrnc8UtMITBRPM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_Afwq7T_ewUAhZTZ7qJYwgnO76PwRTl6BIDBFRf-Kd5hjXg&oe=69BFF748"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/RTeFWd", "id": "276552923350738", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031433_276552926684071_5398554272214286336_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IJKgy3B00IwQ7kNvwEUgpT-&_nc_oc=AdlP8w8kkaodG-QtWa8Ts_b5rBtpg2sXD_qSWU6VItbyfcQitddFxLOgOeaw6a2OZ4M&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfzKsr3GUKk6yVFyT7LRJPOGHXQY-Gp4ejxLAtOFBBoxVg&oe=69BFD7C9"}, "display_name": "Winery Tour in Georgia", "keywords": ["Wine", "Travel", "WineryTour", "Food", "History"], "long_description": "Georgian winemaking method is a part of UNESCO Intangible Heritage. It is the longest uninterrupted tradition of creating wine in the world. Georgia is also one of the oldest winegrowing countries - the pips of the grapes that have been found at Shulaveri Gora historical site are witnessing the fact that the locals were cultivating vines here around 8000 years ago.\nHow does a winery visit look like, once you're in Georgia? Of course, it's a bit of history, a bit of technology, and of course, some excellent food, drinks, songs, and toasts. Take a tour in Giuaani Winery in Manavi (Kakheti), discover more about the Georgian wine, and attend the friendly Georgian supra with the international visitors afterward!\nOf course, this is a demo version that gives you an idea about a half a day winery tour - it takes only one hour to get there from Tbilisi. But a deeper immersion will take you a bit longer. More wineries, more tastings, more exciting landscapes... Georgia is very diverse!", "short_description": "Visit Giuaani Winery in Kakheti with Trails and Wines, and learn more about the Georgian wine and winemaking peculiarities"}]}, "developer_name": null, "developer_privacy_policy_url": null, "developer_terms_of_service_url": null, "publisher_name": "VRex Immersive Inc.", "support_website_url": "http://vr-ex.com/", "website_url": "http://vr-ex.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["EXPERIENCE_360_NON_GAME", "TRAVEL", "EXPLORATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_i
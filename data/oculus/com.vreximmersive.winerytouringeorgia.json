24_649494152501393_4889968777875161088_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EsQiOGFhKMMQ7kNvwFm0XDF&_nc_oc=AdkInlD1jcJiN6zB4sjvXt2J3b7NxNglrAhmdD20EfECsZymekWQuLIH9sgp9F7FHDc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfyiFBW8RtKmMN-Urs5cu4jn5zN5-EOE4dVpb3PGp7EupQ&oe=69AD6558"}, {"file_name": "aDU9NY.png", "id": "513503572678353", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974624_513503576011686_5452742568917860352_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C6RJCR4QGDYQ7kNvwFitFL0&_nc_oc=Adkc1JQtxzDg9uJ4R5WVkoSPi5CmnOvZnO4s7Dpy_WzDL9o0KT-Rxxgx9f7fbtH6mSo&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfzGIIetpMz43G88C4uWlI0qA1xyNWVaBnCThMMoByI7qQ&oe=69AD877E"}, {"file_name": "d5e4uO.png", "id": "233096617897309", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982699_233096621230642_1541719454822432768_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uQALVCqs4BMQ7kNvwGkHrbN&_nc_oc=AdlIjUCVNe9S2tBDDGLlbYcvoSoveK3TDYItdHmk2BdcAx3EHgQmbMV_kN5D21nj8AI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfyQiVLl9h5_HI4oIWbRgheas4QEY_auuIYIjbG3zW10IA&oe=69AD88FD"}, {"file_name": "PS1tWP.png", "id": "223941032361146", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974555_223941035694479_8181425666768502784_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3IhY5raeWYEQ7kNvwHufcgj&_nc_oc=Adl99xHRaRjBvBz8IBZxD6RXKS_7PEjVAK1ZOmVMziT4qlJtLSZIMEZ7GMBuTnmC5nE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afw8lm6DbZYxoVapgs-_bchR4X3UPMZNhoAWDAIpxStimg&oe=69AD8248"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/RTeFWd", "id": "276552923350738", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031433_276552926684071_5398554272214286336_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tftQ0-sDvhEQ7kNvwFhbwK1&_nc_oc=Adkl5_7QAiJdix2tI2kH8XgcvcBoQSTGk7N97F6y_quUlSG-9FVJbeiFAZuuCnNlpdw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfywSxb8grlevWSEBNj3WHkRDf2ljQ-0dxYrCj_fTnM8Pw&oe=69AD62C9"}, "display_name": "Winery Tour in Georgia", "keywords": ["Wine", "Travel", "WineryTour", "Food", "History"], "long_description": "Georgian winemaking method is a part of UNESCO Intangible Heritage. It is the longest uninterrupted tradition of creating wine in the world. Georgia is also one of the oldest winegrowing countries - the pips of the grapes that have been found at Shulaveri Gora historical site are witnessing the fact that the locals were cultivating vines here around 8000 years ago.\nHow does a winery visit look like, once you're in Georgia? Of course, it's a bit of history, a bit of technology, and of course, some excellent food, drinks, songs, and toasts. Take a tour in Giuaani Winery in Manavi (Kakheti), discover more about the Georgian wine, and attend the friendly Georgian supra with the international visitors afterward!\nOf course, this is a demo version that gives you an idea about a half a day winery tour - it takes only one hour to get there from Tbilisi. But a deeper immersion will take you a bit longer. More wineries, more tastings, more exciting landscapes... Georgia is very diverse!", "short_description": "Visit Giuaani Winery in Kakheti with Trails and Wines, and learn more about the Georgian wine and winemaking peculiarities"}]}, "developer_name": null, "developer_privacy_policy_url": null, "developer_terms_of_service_url": null, "publisher_name": "VRex Immersive Inc.", "support_website_url": "http://vr-ex.com/", "website_url": "http://vr-ex.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["EXPERIENCE_360_NON_GAME", "TRAVEL", "EXPLORATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_i
c_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_Afu7S3ErTYeGPc9w2tmwAS0Va-fNbb-FLvgzkG7E6owV6A&oe=699C41D8"}, {"file_name": "aDU9NY.png", "id": "513503572678353", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974624_513503576011686_5452742568917860352_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rv-cIAmK524Q7kNvwFkF6EA&_nc_oc=AdlCvjEfhBHN4kc1Zrc_lStGTyXZ9m8pO5rLrzxJr3_udsptxtY9VMKnew9e7SlKWvE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_AftRbgJq1TcjmGLMFE9v_O9gWi7300RUcvXfhinf4s416g&oe=699C63FE"}, {"file_name": "d5e4uO.png", "id": "233096617897309", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982699_233096621230642_1541719454822432768_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_NW2KguNYgIQ7kNvwHRlHaa&_nc_oc=AdmdBy6TauQJnaMDOnpQV4Pk8b8ffS14k-clJSppSAIVphAgBPSHUuI52uQeDrKR6Hs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AfvvRbC3TCzSgcB8j_jXXrp54nrQQc51sjYzJ1gh7MBY3A&oe=699C657D"}, {"file_name": "PS1tWP.png", "id": "223941032361146", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974555_223941035694479_8181425666768502784_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9-0ay8WuUgEQ7kNvwEydMRt&_nc_oc=Adm8nfAIdoCBNk1zvIYwEuvE7RCRlLNMvUA4sboxehudfPc4loed3uc7gobZq85dY_Q&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_Afs1J_sLWaS5lZA1gmvBQtDQRy4rg0VE1_5_N0CCz-l0fA&oe=699C5EC8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/RTeFWd", "id": "276552923350738", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031433_276552926684071_5398554272214286336_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Bq2ro3LNQRUQ7kNvwHaD_iA&_nc_oc=AdmuDR5Pe0WIui_BdRh6Xt8-qPk0GdumXy1xKC_Go34xqs1-2O8lHtPHMRC2OtTHfg0&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfuAh3xWE3By8qOR7tz5dPkWmGpgzqY2HqXYGO6PSr0YTA&oe=699C3F49"}, "display_name": "Winery Tour in Georgia", "keywords": ["Wine", "Travel", "WineryTour", "Food", "History"], "long_description": "Georgian winemaking method is a part of UNESCO Intangible Heritage. It is the longest uninterrupted tradition of creating wine in the world. Georgia is also one of the oldest winegrowing countries - the pips of the grapes that have been found at Shulaveri Gora historical site are witnessing the fact that the locals were cultivating vines here around 8000 years ago.\nHow does a winery visit look like, once you're in Georgia? Of course, it's a bit of history, a bit of technology, and of course, some excellent food, drinks, songs, and toasts. Take a tour in Giuaani Winery in Manavi (Kakheti), discover more about the Georgian wine, and attend the friendly Georgian supra with the international visitors afterward!\nOf course, this is a demo version that gives you an idea about a half a day winery tour - it takes only one hour to get there from Tbilisi. But a deeper immersion will take you a bit longer. More wineries, more tastings, more exciting landscapes... Georgia is very diverse!", "short_description": "Visit Giuaani Winery in Kakheti with Trails and Wines, and learn more about the Georgian wine and winemaking peculiarities"}]}, "developer_name": null, "developer_privacy_policy_url": null, "developer_terms_of_service_url": null, "publisher_name": "VRex Immersive Inc.", "support_website_url": "http://vr-ex.com/", "website_url": "http://vr-ex.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["EXPERIENCE_360_NON_GAME", "TRAVEL", "EXPLORATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "678899289960804"}}]}, "scheduled_offers": {"c
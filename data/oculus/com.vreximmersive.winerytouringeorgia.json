24_649494152501393_4889968777875161088_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FMFXDc1nBX8Q7kNvwGCf9OC&_nc_oc=Adkp5gms86HUkj6CchXlJxhETYY2CcMuHkJN5efMoXyakeeTy4iCXY5qKuVwuu_LwNA&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfwuyhBkMMy8BWCt27qNlvitTlM0-l5C1-w64nS1lt-rkA&oe=69B69FD8"}, {"file_name": "aDU9NY.png", "id": "513503572678353", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974624_513503576011686_5452742568917860352_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8bjuRiqP16EQ7kNvwGJBUyq&_nc_oc=AdlMHS8Xb5XMBPy8NcUSlONoqhC5Di0NJycy3N0UMFmPXb6pEeKOM6PPjDJg18SEpR4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_Afy1QfyoaEo5IdXKBESRk3q5wHgDQ7h60NLamhJ9LCXuEg&oe=69B6C1FE"}, {"file_name": "d5e4uO.png", "id": "233096617897309", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982699_233096621230642_1541719454822432768_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jN0gR5fKfKUQ7kNvwFrj_Ux&_nc_oc=Adl1RJQ42ndOOSQfULiFuiQYHG70mg1TKYtMM9Se5Jr5sL6JPr3E5NlbLJ6HVCGxIso&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_Afx1Ba6F3shKkqAnyL7x08J9gLBY7B00L9PEiQBVTnDRaw&oe=69B6C37D"}, {"file_name": "PS1tWP.png", "id": "223941032361146", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974555_223941035694479_8181425666768502784_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bbs1FUyb8ewQ7kNvwHjSFfi&_nc_oc=AdnbUxHhejv1wqg_NMrLIqHqrDWEN3a1GxKwDVPRbbuodrosTHhEXCfk9hGEK-XrDLE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_Afye_4JPeZ-ZzQAfxKevL2BYJyBdzruAB8_xlOpHSVrtoQ&oe=69B6BCC8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/RTeFWd", "id": "276552923350738", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39031433_276552926684071_5398554272214286336_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yUEBUXT3kNAQ7kNvwF0xa_0&_nc_oc=Adnj4bjZEqS0aNVHfW9W-O0UAveZHtbtizCe9cHLbLHR6UL5KKeQFc7EnQVIkYZO9Us&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_Afxt7Rz-G-usloxtLhh0tggzkzooTS4BBrLIrPZqG-klJA&oe=69B69D49"}, "display_name": "Winery Tour in Georgia", "keywords": ["Wine", "Travel", "WineryTour", "Food", "History"], "long_description": "Georgian winemaking method is a part of UNESCO Intangible Heritage. It is the longest uninterrupted tradition of creating wine in the world. Georgia is also one of the oldest winegrowing countries - the pips of the grapes that have been found at Shulaveri Gora historical site are witnessing the fact that the locals were cultivating vines here around 8000 years ago.\nHow does a winery visit look like, once you're in Georgia? Of course, it's a bit of history, a bit of technology, and of course, some excellent food, drinks, songs, and toasts. Take a tour in Giuaani Winery in Manavi (Kakheti), discover more about the Georgian wine, and attend the friendly Georgian supra with the international visitors afterward!\nOf course, this is a demo version that gives you an idea about a half a day winery tour - it takes only one hour to get there from Tbilisi. But a deeper immersion will take you a bit longer. More wineries, more tastings, more exciting landscapes... Georgia is very diverse!", "short_description": "Visit Giuaani Winery in Kakheti with Trails and Wines, and learn more about the Georgian wine and winemaking peculiarities"}]}, "developer_name": null, "developer_privacy_policy_url": null, "developer_terms_of_service_url": null, "publisher_name": "VRex Immersive Inc.", "support_website_url": "http://vr-ex.com/", "website_url": "http://vr-ex.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["EXPERIENCE_360_NON_GAME", "TRAVEL", "EXPLORATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_i
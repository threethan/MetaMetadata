Nyeq21FoUISgqEow&oe=6B01E43D"}, {"file_name": "aDU9NY.png", "id": "513503572678353", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974624_513503576011686_5452742568917860352_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GkK-9JnO3ssQ7kNvwFjLNu4&_nc_oc=AdplzcWKm2kLYRyEfoV2R6qrXE3ZfPTFoyXNDXChtOTurrOUI616N3iC8wEIQQIjgT4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTLbY4Q6J0vunDeRd7bgIPpAWEKBZZF1Ym3a3R8-7A2cw&oe=6B01E2BE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/RTeFWd", "id": "276552923350738", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031433_276552926684071_5398554272214286336_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ql6Vl6h6etMQ7kNvwHMULf7&_nc_oc=AdqtKrooio9jEVyNV76quCsNIPxckSQ7gz-ILWXtTwrQdNAEeP5ynfkNvJ1fahJH5t4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRAH8sSapifVC8--1KRxAPDGPYJoTzucyIcObd4X9PIlA&oe=6B01BE09"}, "display_name": "Winery Tour in Georgia", "keywords": ["Wine", "Travel", "WineryTour", "Food", "History"], "long_description": "Georgian winemaking method is a part of UNESCO Intangible Heritage. It is the longest uninterrupted tradition of creating wine in the world. Georgia is also one of the oldest winegrowing countries - the pips of the grapes that have been found at Shulaveri Gora historical site are witnessing the fact that the locals were cultivating vines here around 8000 years ago.\nHow does a winery visit look like, once you're in Georgia? Of course, it's a bit of history, a bit of technology, and of course, some excellent food, drinks, songs, and toasts. Take a tour in Giuaani Winery in Manavi (Kakheti), discover more about the Georgian wine, and attend the friendly Georgian supra with the international visitors afterward!\nOf course, this is a demo version that gives you an idea about a half a day winery tour - it takes only one hour to get there from Tbilisi. But a deeper immersion will take you a bit longer. More wineries, more tastings, more exciting landscapes... Georgia is very diverse!", "short_description": "Visit Giuaani Winery in Kakheti with Trails and Wines, and learn more about the Georgian wine and winemaking peculiarities"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.vreximmersive.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "VRex Immersive Inc.", "support_website_url": null, "website_url": "https://www.vreximmersive.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EXPERIENCE_360_NON_GAME", "TRAVEL", "EXPLORATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD", "OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24799265649727295"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75422395_223553148711091_6725424902951665664_n.png?stp=dst-png_s360x360&_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xL6eyEE_EUYQ7kNvwEV32mJ&_nc_oc=AdpodcvZUMpzVPv0UF8Jho899EjgU8BzPseLZUzcuZhIp0a8gncg-mxpXkiy1D05VSg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQYfFAKTeA2XetBvfxP9TYbo99M1z52HQO3jYWrx3rZ4w&oe=6B01DFDA"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Winery Tour in Georgia", "platform": "ANDROID", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_name
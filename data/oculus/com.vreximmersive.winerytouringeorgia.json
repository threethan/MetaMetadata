IQ7kNvwHse0xz&_nc_oc=AdoJ12x7gIJAEOLrSZClnq1a7eLVOQftQGzC-3Ad4UoMXykhjIc_ECoJBvjYZJ9oaOk&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2US2WhTzjr3YL9DUgGGM8tPpgk7RV4RgEjUxTGcvdtmw&oe=69F1F358"}, {"file_name": "aDU9NY.png", "id": "513503572678353", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974624_513503576011686_5452742568917860352_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gtaeNZIjdgcQ7kNvwGxAl_3&_nc_oc=Adqe95V-L2JWVeqYeg8sGSIBXtOI_ohJTdaJd0r_jzEIZ1IbQNZIH6gum8MJwIDSj9I&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_Af2UdmhkXArO0t3l-mEbs8OWoC5LVrLOoL8kFywOCBd5Qg&oe=69F2157E"}, {"file_name": "d5e4uO.png", "id": "233096617897309", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38982699_233096621230642_1541719454822432768_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5BKPnOID36oQ7kNvwE8u967&_nc_oc=Adpcf8jrnSaRd4KnrYrDyAo56C_HVmO-8JLP5nxvZCwN72L5s0QlubnLKrCrs3X28z4&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_Af28b_P5_boGAWrzHbuVzoc9Yc3NyU7x1rCD8IHwQiosdw&oe=69F216FD"}, {"file_name": "PS1tWP.png", "id": "223941032361146", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974555_223941035694479_8181425666768502784_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WC5j5_Xo5u8Q7kNvwEE6DRt&_nc_oc=Adp5etCmJ6Uhc94tJoHvB_HqaCPLSftzSn5E0XDRGwsXvYRo_l1LEryidYoiFm5YqAs&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_Af25w059hDNmZRUVv8BStVPacYYND_9O39fnPlQyPdPMiw&oe=69F21048"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/RTeFWd", "id": "276552923350738", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39031433_276552926684071_5398554272214286336_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0E1GJug3b_cQ7kNvwH4oxbN&_nc_oc=Adquz95cMGZl5RPhwkz23x6mJlFg0AWovi3Iz2b6Dz1zxZuZFuc6t43PYszEfJRH7bo&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&oh=00_Af3OYp3mJNSO4Pog4yogM0qcHVOAWP2JjsqwNNBz60k76g&oe=69F1F0C9"}, "display_name": "Winery Tour in Georgia", "keywords": ["Wine", "Travel", "WineryTour", "Food", "History"], "long_description": "Georgian winemaking method is a part of UNESCO Intangible Heritage. It is the longest uninterrupted tradition of creating wine in the world. Georgia is also one of the oldest winegrowing countries - the pips of the grapes that have been found at Shulaveri Gora historical site are witnessing the fact that the locals were cultivating vines here around 8000 years ago.\nHow does a winery visit look like, once you're in Georgia? Of course, it's a bit of history, a bit of technology, and of course, some excellent food, drinks, songs, and toasts. Take a tour in Giuaani Winery in Manavi (Kakheti), discover more about the Georgian wine, and attend the friendly Georgian supra with the international visitors afterward!\nOf course, this is a demo version that gives you an idea about a half a day winery tour - it takes only one hour to get there from Tbilisi. But a deeper immersion will take you a bit longer. More wineries, more tastings, more exciting landscapes... Georgia is very diverse!", "short_description": "Visit Giuaani Winery in Kakheti with Trails and Wines, and learn more about the Georgian wine and winemaking peculiarities"}]}, "developer_name": null, "developer_privacy_policy_url": null, "developer_terms_of_service_url": null, "publisher_name": "VRex Immersive Inc.", "support_website_url": "http://vr-ex.com/", "website_url": "http://vr-ex.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["EXPERIENCE_360_NON_GAME", "TRAVEL", "EXPLORATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_mod
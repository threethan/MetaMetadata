24_649494152501393_4889968777875161088_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=km2-mjIkKiAQ7kNvwG-PW8t&_nc_oc=Adov_HNrX45FNBjxu738yEV3vPIgHMxYi81xJ8hWysWrVYYPdBb4VfoZ38PpbGxbyhc&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_Afx6QSaNK5ub5G1XzwxP7caqRwJGPnRUHTo2OwYFZPAerA&oe=69C12BD8"}, {"file_name": "aDU9NY.png", "id": "513503572678353", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974624_513503576011686_5452742568917860352_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w636Z-jGYUkQ7kNvwEJETLt&_nc_oc=AdpHCb2GPwXPRxRScrJHJoy74NPxe5WPvFvwC0Pug324-gtpBVD5H6XeknDucyezfBg&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_AfwrDwA0dyvOf2o0uDvzmHR-gTZ4d10ARp5o0yv8mcGUpA&oe=69C14DFE"}, {"file_name": "d5e4uO.png", "id": "233096617897309", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38982699_233096621230642_1541719454822432768_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f51OB4sn2FUQ7kNvwEClH_K&_nc_oc=Adps_y0b6OFFOEm6azJq3PjqyC1R5jUAafVk3bPIow_jWe-H0sr7smOHxkyxDRbQD3A&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=8&oh=00_AfzHmmkH4QRZsvUqJOUX18VjssHBaRdKlcFxz7mo9emxFA&oe=69C14F7D"}, {"file_name": "PS1tWP.png", "id": "223941032361146", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974555_223941035694479_8181425666768502784_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MbnFaUgxdCMQ7kNvwErS9Yo&_nc_oc=AdrVPtX8SvAVXUnYwNH6fu3yuyRWT5O8l2rQB4cBKGP5ZaRvvB2tKZDlUUGfPpNHb2I&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_AfxOLvNVCUT2EzUvba90vXnHeG0mtB-g_tOcjGzhY2R2Dw&oe=69C148C8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/RTeFWd", "id": "276552923350738", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39031433_276552926684071_5398554272214286336_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IJKgy3B00IwQ7kNvwGqJbPI&_nc_oc=Adrp7AZVNTrJAtzWa636L3QwcRcgqaaswHxLs4pB1b4U2aWu_Bd8tQB9LkJTtRabTvc&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=8&oh=00_AfxJtFXVatihP01-aE_GkHUz37Zx0_-4cVHaQmewBhaeDg&oe=69C12949"}, "display_name": "Winery Tour in Georgia", "keywords": ["Wine", "Travel", "WineryTour", "Food", "History"], "long_description": "Georgian winemaking method is a part of UNESCO Intangible Heritage. It is the longest uninterrupted tradition of creating wine in the world. Georgia is also one of the oldest winegrowing countries - the pips of the grapes that have been found at Shulaveri Gora historical site are witnessing the fact that the locals were cultivating vines here around 8000 years ago.\nHow does a winery visit look like, once you're in Georgia? Of course, it's a bit of history, a bit of technology, and of course, some excellent food, drinks, songs, and toasts. Take a tour in Giuaani Winery in Manavi (Kakheti), discover more about the Georgian wine, and attend the friendly Georgian supra with the international visitors afterward!\nOf course, this is a demo version that gives you an idea about a half a day winery tour - it takes only one hour to get there from Tbilisi. But a deeper immersion will take you a bit longer. More wineries, more tastings, more exciting landscapes... Georgia is very diverse!", "short_description": "Visit Giuaani Winery in Kakheti with Trails and Wines, and learn more about the Georgian wine and winemaking peculiarities"}]}, "developer_name": null, "developer_privacy_policy_url": null, "developer_terms_of_service_url": null, "publisher_name": "VRex Immersive Inc.", "support_website_url": "http://vr-ex.com/", "website_url": "http://vr-ex.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["EXPERIENCE_360_NON_GAME", "TRAVEL", "EXPLORATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_i
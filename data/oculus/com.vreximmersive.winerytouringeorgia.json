24_649494152501393_4889968777875161088_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QvtNTIxpJ5YQ7kNvwELPp_s&_nc_oc=AdneDaoUW0zCPAW-HsscfpKch0wnBLs0NNgH72yeTQIR1IRdZfr5IUqR6yrmMmarIzM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_Afy6zVtnG81RBsPiHZGHYA_aOPuu2CnmaTJQMQl0paTIrA&oe=69B54E58"}, {"file_name": "aDU9NY.png", "id": "513503572678353", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974624_513503576011686_5452742568917860352_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8bjuRiqP16EQ7kNvwFXG0Yj&_nc_oc=AdkYoFQ3VZ3TivO_DemzISUfVWmFyAL6l-HNURmmk_6y5lTqpcJ8_xJhsw-cqFvmETI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_Afz0KRgL7MrWLWd1Cp2KKMVhRVo6Sg1AowBm6vLEHjvfeA&oe=69B5707E"}, {"file_name": "d5e4uO.png", "id": "233096617897309", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982699_233096621230642_1541719454822432768_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jN0gR5fKfKUQ7kNvwEbHXTh&_nc_oc=AdlmLMEBxvAgq0YBU8k8a0dJrTetcu4afAyQnpX18x4q5xpboT-autTjpZTkH5fd0lA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfzLstbrJCaeCoDDOVWjfN4urmgrFdw2oTPQ1FUW3dCf6Q&oe=69B571FD"}, {"file_name": "PS1tWP.png", "id": "223941032361146", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974555_223941035694479_8181425666768502784_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=446F3-q2sOQQ7kNvwFRb1Qo&_nc_oc=AdlZ6Lna4Yu7D_xahFxcd8W1S-XPBEYhWk-jONTaoUVdBy2Scrw7fnBmrMHm-gUCIS0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfwWFctG801xbAKWomi_iidqV8tIzMmmUFThTssm5QV9WQ&oe=69B56B48"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/RTeFWd", "id": "276552923350738", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031433_276552926684071_5398554272214286336_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yUEBUXT3kNAQ7kNvwG85ZxJ&_nc_oc=AdnSf-gqVK3zlbpgbAqedlihHaY9S4wHWeSyEsk4vmltB5iDc2E9XbDwrM4gl2700Vk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfzY7G5ocQFgB2V7NWs4k0gFnadfs-ers0Yh-eMXfCjyLg&oe=69B54BC9"}, "display_name": "Winery Tour in Georgia", "keywords": ["Wine", "Travel", "WineryTour", "Food", "History"], "long_description": "Georgian winemaking method is a part of UNESCO Intangible Heritage. It is the longest uninterrupted tradition of creating wine in the world. Georgia is also one of the oldest winegrowing countries - the pips of the grapes that have been found at Shulaveri Gora historical site are witnessing the fact that the locals were cultivating vines here around 8000 years ago.\nHow does a winery visit look like, once you're in Georgia? Of course, it's a bit of history, a bit of technology, and of course, some excellent food, drinks, songs, and toasts. Take a tour in Giuaani Winery in Manavi (Kakheti), discover more about the Georgian wine, and attend the friendly Georgian supra with the international visitors afterward!\nOf course, this is a demo version that gives you an idea about a half a day winery tour - it takes only one hour to get there from Tbilisi. But a deeper immersion will take you a bit longer. More wineries, more tastings, more exciting landscapes... Georgia is very diverse!", "short_description": "Visit Giuaani Winery in Kakheti with Trails and Wines, and learn more about the Georgian wine and winemaking peculiarities"}]}, "developer_name": null, "developer_privacy_policy_url": null, "developer_terms_of_service_url": null, "publisher_name": "VRex Immersive Inc.", "support_website_url": "http://vr-ex.com/", "website_url": "http://vr-ex.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["EXPERIENCE_360_NON_GAME", "TRAVEL", "EXPLORATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_i
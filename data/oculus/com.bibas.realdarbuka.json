EENSHOT_02_handpan.png", "id": "1109260941950487", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/908771238_1109260948617153_702798216196754475_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yl6KgDNRYuoQ7kNvwHwRO8l&_nc_oc=AdqRU_ILN04m4fiOURyMcsFQuJjkwMVgyVaSRARXRBSEB-on3qsGQalF1vx7K6rwU8I&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSqCp-uxxzD5RqENyRgpwkachJ5Uon4j5jP15AvIkRX6w&oe=6B0DA362"}, {"file_name": "6_SCREENSHOT_01_hands_on_darbuka.png", "id": "1077377912022478", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/908771274_1077377918689144_1627115298779607286_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tHp8Zgl7-zsQ7kNvwELo_v1&_nc_oc=AdoVCgyCiuWc_ebq84dtQjRGwak7Ddd1sJesccE3UCT-W0FDXiCCiGXXKL9nA0Di9iY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSJmJTwxjDYEYVIbDc8WYK_ccguQqYJfMC-wNtoC4PCMQ&oe=6B0DC6D3"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Real Darbuka", "keywords": ["darbuka", "percussion", "drums", "handpan"], "long_description": "Real Darbuka brings real percussion into your room.\n\nPLAY WITH YOUR HANDS\n\u2022 A darbuka that answers how hard and where you hit: dum, tak, tek, slaps, and the other hand muting the skin.\n\u2022 Many darbukas, frame drums, djembe, bongos, tabla and handpans, each built from the real instrument.\n\u2022 A full drum kit played with the controllers: sticks, hi-hat pedal, kick on the trigger or a USB MIDI pedal.\n\nYOUR ROOM, YOUR STAGE\n\u2022 Instruments stand in your own room (passthrough). Hug a drum to lift it, put it on your lap, leave it in the air.\n\u2022 Bring in several instruments at once, each with its own sound.\n\u2022 Every drum kit in its own finish, cymbals that answer the tip and the shaft of the stick.\n\u2022 A dimmer for your room.\n\u2022 A mixer for every drum, room reverb and echo, and a hit-sensitivity control.\n\nFree. No ads. No account. English and Arabic.\n\nAlso on Android phones and tablets: Real Darbuka on Google Play.", "short_description": "Play the darbuka and hand drums in your own room, with your hands."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/realdarbukaprivacy/home", "developer_terms_of_service_url": null, "publisher_name": "mBibas", "support_website_url": null, "website_url": "https://sites.google.com/view/realdarbukaprivacy/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["ROOM_SCALE", "STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1535743632944924"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/908771288_1989654175036233_3234209730482729751_n.png?stp=dst-png_s360x360&_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pRMf3Si2wLMQ7kNvwHYNFB6&_nc_oc=AdoJ3VNg6mc-GK0R5z1feChmOu2e0HE23W73w6XKCKzSsi0LhLY3jG_OkRS4DcbRJKs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQST9DnSFRYbdBe_4VGh3C3VgrAmNJbSjVPuwUmpfb2CJA&oe=6B0D9BCD"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Real Darbuka", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_name": "Creativity", "id": "1819021644882647"}], "release_date": 1795206600, "lastRevision": {"nodes": [{"id": "1535
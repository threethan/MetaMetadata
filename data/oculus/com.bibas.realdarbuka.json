d": "2233271800734616", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/908771268_2233271804067949_1186528819489661253_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wpy84jKB5rYQ7kNvwF6MRvT&_nc_oc=Adr1TCDvpufwOGA7n94ftBUQf0N80vbJwbyE4DD9HXYoRU4MKxuA67eRasmCaK2ZG04&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS0ucD5Rtwf1IPQ7RHA0_niuNX4_uebXXBfmfMK-VGV7Q&oe=6B070E00"}, {"file_name": "7_SCREENSHOT_02_handpan.png", "id": "1109260941950487", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/908771238_1109260948617153_702798216196754475_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uhU_3_9OmysQ7kNvwF_bv1p&_nc_oc=AdqHUn2zb1GY3OPEU1wuVpd7D5KoaqQTCUkbjrxgtLNB4XFlamugPJ1UwIP9JIbIuM0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT-B6_MkaFwAdkxrYTY2mVXJnl94jSfltPhYb6n2aNipg&oe=6B070BE2"}, {"file_name": "6_SCREENSHOT_01_hands_on_darbuka.png", "id": "1077377912022478", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/908771274_1077377918689144_1627115298779607286_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vbhGi_9XthEQ7kNvwGtx1dz&_nc_oc=AdpRhML5BIkShE77pZUITjf1qaTlkMccg9vrYLHAUDuLWJ3qfCySwERvp0t6FpuAD2o&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQmIKfaXrJyDUizIQDHyDzkB5pDpCEmZZmWSTcHEr0U8A&oe=6B06F713"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Real Darbuka", "keywords": ["darbuka", "percussion", "drums", "handpan"], "long_description": "Real Darbuka brings real percussion into your room.\n\nPLAY WITH YOUR HANDS\n\u2022 A darbuka that answers how hard and where you hit: dum, tak, tek, slaps, and the other hand muting the skin.\n\u2022 Many darbukas, frame drums, djembe, bongos, tabla and handpans, each built from the real instrument.\n\u2022 A full drum kit played with the controllers: sticks, hi-hat pedal, kick on the trigger or a USB MIDI pedal.\n\nYOUR ROOM, YOUR STAGE\n\u2022 Instruments stand in your own room (passthrough). Hug a drum to lift it, put it on your lap, leave it in the air.\n\u2022 Bring in several instruments at once, each with its own sound.\n\u2022 Every drum kit in its own finish, cymbals that answer the tip and the shaft of the stick.\n\u2022 A dimmer for your room.\n\u2022 A mixer for every drum, room reverb and echo, and a hit-sensitivity control.\n\nFree. No ads. No account. English and Arabic.\n\nAlso on Android phones and tablets: Real Darbuka on Google Play.", "short_description": "Play the darbuka and hand drums in your own room, with your hands."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/realdarbukaprivacy/home", "developer_terms_of_service_url": null, "publisher_name": "mBibas", "support_website_url": null, "website_url": "https://sites.google.com/view/realdarbukaprivacy/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["ROOM_SCALE", "STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1535743632944924"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1597315305761151"}]}, "baseline_offer": {"id": "1597315305761151"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1795206600, "status": "PUBLISHED", "id": "1597315305761151"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_resul
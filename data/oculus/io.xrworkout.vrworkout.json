9854699", "locale": "en_US", "screenshots": [{"file_name": "screen5_auto_x2_colored_toned_light_ai.jpg.png", "id": "621228983346323", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/57568679_621228986679656_4932223041429816047_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S5phP1AxUcYQ7kNvwHSaA7n&_nc_oc=AdlffYmALuoJfka89tD5rvgpfHN6MAUmtJJ-vZDThslfm_FSuB7VdlFzscOKv73ndSY&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfxfqmsB5U-nw7OOZsWqnNH3WPCVKKENKxms848Gp7GyQQ&oe=69BE75B6"}, {"file_name": "screen4_auto_x2_colored_toned_light_ai.jpg.png", "id": "5790718447685218", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39035323_5790718451018551_2369561673230507401_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E2WNOYpWXIIQ7kNvwGypOac&_nc_oc=AdmfRAFPAc3Oy359QMSO0s87Bo-ez9WVyEdkvzet-a6qll9c6yeX0j32eubf4g2_WTk&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfxRlzOynob0BAF_Yypf0EXa2npwSRkUk9f0hvHa7Z_q2A&oe=69BEA5CA"}, {"file_name": "screen1_auto_x2_colored_toned_light_ai.jpg.png", "id": "745705283765624", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75195902_745705290432290_8647235382232933857_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L90eUS65GPwQ7kNvwEjlMzZ&_nc_oc=AdmgjzOnamw9Nto5DA9DPJIKJrdBsQlmUQo27RHFmAkYNZt1JxsyjgySj6NPWlAAHo0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfzJqMXbjst9Uh03sdXkCci2pIToWqaU_xX6gfcxEnZS9w&oe=69BE8B35"}, {"file_name": "screen3_auto_x2_colored_toned_light_ai.jpg.png", "id": "3422410544695300", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39003227_3422410548028633_2782161710992601325_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Qk-bOkrzdE8Q7kNvwFVza_C&_nc_oc=AdmJkEi5Z96NHbStoQk_HMLP8ZneX9p3QVdrQrKN--iXI_p1stsyM1yhOagQRvOFh8Y&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfwMlM6gUIcZqcP6XIeJYGB4yczsp-2JhTSZsR_l9t4Fjw&oe=69BE761C"}, {"file_name": "screen2_auto_x2_colored_toned_light_ai.jpg.png", "id": "887004912504237", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38984455_887004915837570_4522940590059961806_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LYdBjH0OZCwQ7kNvwF5mOfe&_nc_oc=AdkdJw_yqZlgsVcuOOQ6w2j8j9H8ohssL5P9ySPZozOFcWhw_d5TxIqHsKKUo1brByA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfzZpUkqThqE3ki54O9B4UuXn2X7iyq5a7xaoiFjWdkQtw&oe=69BEA465"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "reallyfit_thumb.png", "id": "3407462022845421", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974653_3407462026178754_8981674626759072485_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M1hrJrmJoTQQ7kNvwE2Hl5p&_nc_oc=Adk3E4mBtyo3h8H2piBovbBvpaHjUmGfilFDtUjanFD5KfFmZpHRjM0GlOU97OTh4CY&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfznqAjFad4TjNxPRUO_KDqO4lsarg8g2EcUIuuJOKnelg&oe=69BE7759"}, "display_name": "VR Workout", "keywords": ["fitness", "workout", "gym", "health", "exercise"], "long_description": "Sprint. Squat. Jump. Crunch.\n\nVR Workout is the FULL-BODY FITNESS app of the future.\n\n\ud83d\udd90\ufe0fCONTROLLERLESS\n\ud83d\udcaaHIGH INTENSITY\n\ud83d\udc53MIXED REALITY\n\ud83e\uddd1\u200d\ud83e\udd1d\u200d\ud83e\uddd1MULTIPLAYER\n\ud83d\udce3LIVE CLASSES\n\n\u25b6\ufe0fExperience complete freedom of movement with a totally controllerless, hands-free experience, bringing you the most comprehensive and effective workout in virtual reality.\n\n\u25b6\ufe0fMove at your own pace, with intelligent exercise design that meets you where you\u2019re at, and safely pushes you to the limit.\n\n\u25b6\ufe0fChoose from eight immersive environments, from the heights of a glowing city skyline to the depths of a luminous cave.\n\n\u25b6\ufe0fOr use our state of the art mixed reality mode, with the full clarity of your immediate surroundings to support you.\n\n\u25b6\ufe0fMeet up with friends across the globe with our multiplayer experience, where you can challenge each other in competitive motion through a custom workout of your own design.\n\n\u25b6\ufe0fLevel up with our live classes, where you can push yourself in a group setting with one of our experienced instructors.\n\nHappy. Healthy. Social. Global. We do this together. \ud83d\udc4a\n\nWe Are Movement.", "short_description": "The ultimate full body fitness game that follows YOUR rules. Pushing the boundaries of movement in VR with hand tracking and rhythm based bodyweight exercises.\nJoin or build circles that workout together around the globe with multiplayer group workouts. \nWith a unique mixed reality passthrough workout for smaller spaces and a true gym in a bag if you take it on your next trip."}]}, "developer_name": null, "developer_privacy_policy_url": "https://xrworkout.io/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "XRWorkout Inc", "support_website_url": "https://chat.vrworkout.at/", "website_url": "https://xrworkout.io/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": ["ACTION", "MUSIC", "SPORTS"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER"], "id": "1933383580183962"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PUBLISHED", "id": "1063163832635359"}, {"status": "PUBLISHED", "id": "739987914441095"}]}, "baseline_offer": {"id": "1063163832635359"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1753871760, "status": "PUBLISHED", "id": "1063163832635359"
01_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mB2igt5ruYUQ7kNvwE_5eSk&_nc_oc=Adr5liReoWPbKiWKHptGcUZuUBZCrHUIbPY04rh0_opZiq1dWypNK16emfmItWMgVj4&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQUuM3uoDfGJrCNYE7Y68zM351uUviyBYgnxSDV33iaBw&oe=6AFB460A"}, {"file_name": "screen1_auto_x2_colored_toned_light_ai.jpg.png", "id": "745705283765624", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/75195902_745705290432290_8647235382232933857_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FyeTA1vg3IwQ7kNvwHkmf3L&_nc_oc=Ado6h9xbZuKCtvqcHRrNI4S0aS2bhT1uTkoWIRdsoXWLtBWqqe_XrTHtsDrU9vCL92o&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTMqIGnFF9Rc2nI4cO6BZyRXNaBmcRqmJL8We61_E9lCg&oe=6AFB2B75"}, {"file_name": "screen3_auto_x2_colored_toned_light_ai.jpg.png", "id": "3422410544695300", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/39003227_3422410548028633_2782161710992601325_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o2n9d2RyYt0Q7kNvwGzucFi&_nc_oc=Adq7-5pydP4O3mabs-uD7VlB1HoaCMX3Rm80m1qlEOD1b3Xtgw_6AK3L2S3XQQadrCI&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT7LPH1V2zXyXIViMQrp3bwAaMj2zAnM1zhqrCSKhrefA&oe=6AFB165C"}, {"file_name": "screen2_auto_x2_colored_toned_light_ai.jpg.png", "id": "887004912504237", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38984455_887004915837570_4522940590059961806_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=93zIyqb9EUcQ7kNvwFV4Qsh&_nc_oc=AdpgjuSnayBAGwvCcDrj__4DBz_DWOBL5Hk2jebwDlS1SQ7FU3UjLLsD4CDvspxZi80&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQZOIuYoZ1UR2LiG4JV1Vd5H_GPOyrXW6imYLuts_B5Cg&oe=6AFB44A5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "reallyfit_thumb.png", "id": "3407462022845421", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38974653_3407462026178754_8981674626759072485_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lGAijmLSKvkQ7kNvwEXPqAg&_nc_oc=AdrO9almJAyHFmYQJuP8pgX5oC88_5I5KJ0-9ajGnYeT6tbNsLXB8wmbTl0WnVd6z44&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRRQncNqnqpG5Qyg-yfLHowiZQlSzXGmGaHRqXJwsaxnw&oe=6AFB1799"}, "display_name": "VR Workout", "keywords": ["fitness", "workout", "gym", "health", "exercise"], "long_description": "Sprint. Squat. Jump. Crunch.\n\nVR Workout is the FULL-BODY FITNESS app of the future.\n\n\ud83d\udd90\ufe0fCONTROLLERLESS\n\ud83d\udcaaHIGH INTENSITY\n\ud83d\udc53MIXED REALITY\n\ud83e\uddd1\u200d\ud83e\udd1d\u200d\ud83e\uddd1MULTIPLAYER\n\ud83d\udce3LIVE CLASSES\n\n\u25b6\ufe0fExperience complete freedom of movement with a totally controllerless, hands-free experience, bringing you the most comprehensive and effective workout in virtual reality.\n\n\u25b6\ufe0fMove at your own pace, with intelligent exercise design that meets you where you\u2019re at, and safely pushes you to the limit.\n\n\u25b6\ufe0fChoose from eight immersive environments, from the heights of a glowing city skyline to the depths of a luminous cave.\n\n\u25b6\ufe0fOr use our state of the art mixed reality mode, with the full clarity of your immediate surroundings to support you.\n\n\u25b6\ufe0fMeet up with friends across the globe with our multiplayer experience, where you can challenge each other in competitive motion through a custom workout of your own design.\n\n\u25b6\ufe0fLevel up with our live classes, where you can push yourself in a group setting with one of our experienced instructors.\n\nHappy. Healthy. Social. Global. We do this together. \ud83d\udc4a\n\nWe Are Movement.", "short_description": "The ultimate full body fitness game that follows YOUR rules. Pushing the boundaries of movement in VR with hand tracking and rhythm based bodyweight exercises.\nJoin or build circles that workout together around the globe with multiplayer group workouts. \nWith a unique mixed reality passthrough workout for smaller spaces and a true gym in a bag if you take it on your next trip."}]}, "developer_name": null, "developer_privacy_policy_url": "https://xrworkout.io/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "XRWorkout Inc", "support_website_url": "https://chat.vrworkout.at/", "website_url": "https://xrworkout.io/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": ["ACTION", "MUSIC", "SPORTS"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER"], "id": "1933383580183962"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PUBLISHED", "id": "1063163832635359"}, {"status": "PUBLISHED", "id": "739987914441095"}]}, "baseline_offer": {"id": "1063163832635359"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1753871760, "status": "PUBLISHED", "id": "1063163832635359"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "39804346065877672", "version": "3.0.20024"}, "id": "1246551985927569", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "8266372770101746", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "39804346065877672"}, "re
DR3tJ_XLBEQ7kNvwFpOvz0&_nc_oc=Adp22O8MqMMqpVSv3OXSYeZC6NPpXrfQOeeqPBrZ0hGfouORc5aE3SMnhtbeaOG7FBk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSS-xqmOGpXEjywGpmu2ckmfTM8wxVKsQwm7NbQX1FEzQ&oe=6B048876"}, {"file_name": "screenshot_4_2560x1440.png", "id": "880727461172786", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491818852_880727467839452_6287163563324203134_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jZpsLipD-s0Q7kNvwHFLQ-v&_nc_oc=AdrbxvYNvbxiFjzRIbWHPld2TDSybq4rULykF8WSCGLdASZYdamdVEVCrb7mu4cy26E&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRjW8i2PK_u7T1WQC90evFX_zfDykdt8j4jRGWlvowsvA&oe=6B046465"}, {"file_name": "38974821_2062710024142012_842799292904406152_n.png", "id": "1841963999761135", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491822561_1841964006427801_7898167711456008874_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SDXsd3ET5sAQ7kNvwHrZO7d&_nc_oc=AdrrDnB1PpVGVX6Fg9DNYfdBsz7H_zWWNZ3KjHWWe7RuwxE1ot0gfXxzT9R5vbXjFU8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSpG8B_9tXno4iVQO-nP8KNL25IRDDMFdhMbJBAJy0XVg&oe=6B04533A"}, {"file_name": "screenshot_2_2560x1440.png", "id": "1615551819604965", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491821706_1615551822938298_4545988527550348770_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rYg3mIwhR7oQ7kNvwGZBVKn&_nc_oc=Adpx0sMhGBqlJAwn1PXWFfFhRjINLfrr7H0cufyWBnET8fo_jHQRLZWVAShchifh__A&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ2ZN0auVQ_VgWQbLEcwa_mg6oddsrCit7s9B7iq7r2-A&oe=6B045340"}, {"file_name": "57574716_592617179798544_3999622944282718017_n.png", "id": "1408388324086848", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491819281_1408388330753514_2765652726808112638_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VDQ8-uHMLfwQ7kNvwGOeMrF&_nc_oc=Adruo56mwW8sUFs_4Y3Yx2HBnEL1vUPhCpRlve3hCkcbgLjZdhzrvdaBot0MjEHJdS8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQIEg9YHRsa5MjGNRnIdy9o311f9zP4QfZ4i62_jA_sDA&oe=6B046970"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "vlcsnap-2023-12-20-19h14m21s142.png", "id": "699332888964076", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974745_699332892297409_419806300857244010_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CfvQWWgR8YcQ7kNvwHnmLiW&_nc_oc=AdoKdymzexfGr3dS_e5ojTzQUdLIq1OEv1ABHd7tXA5YE6cEZmhqJb6bwLDz7oqMYTI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQrbSKswdyEUJxXFp3ZABQEDQSWgQcR_Lp2q3y9FR8Tfg&oe=6B047220"}, "display_name": "XRWorkout Free to Play VR Fitness Sport", "keywords": ["fitness", "sport", "health", "training", "workout"], "long_description": "**Sprint. Squat. Jump. Box. Balance. Lift. Transform. The new sport for everyone**\n\nUnleash your fitness potential through functional full-body movement in mixed reality or full immersion\n\n\ud83d\udd25 **Controller-Free Freedom**\n\nFunctional movements require full freedom. Enjoy our hands-free, controller-less magic, delivering the most immersive and dynamic full-body workout in virtual reality\n\n{1348523363496068}\n\n\ud83d\udcaa **High-Intensity Workouts even with Weights**\n\nSet the game to adapt to your fitness level, and incorporating dynamic weight exercises to build strength and endurance. Easily progress from beginner to beast mode with no ceiling or plateau\n\n\u2764\ufe0f **Heart Rate-Controlled Biofeedback**\n\nOptimize your workout with real-time heart rate monitoring. Our biofeedback system can dynamically adjust exercise difficulty based on your heart rate, ensuring you stay in the ideal intensity zone for maximum results and safety\n\n\ud83e\uddb6 **Precision Foot Tracking for Balance**\n\nMaster balance and stability with advanced foot tracking for exercises that never get boring\n\n\ud83c\udf0d **Immersive & Social Multiplayer**\n\nConnect globally! Compete or collaborate with friends in real-time\n\n{1100068795535087}\n\n\ud83c\udfa8 **Shareable Environments**\n\nChoose from existing stunning immersive worlds or craft your own unique environments.\n\n{2313961729065699}\n\n\ud83c\udfc6 **Create & Share Challenges**\n\nDesign personalized workout challenges  and share them with the world to compete on global leaderboards\n\n{2147524639069776}\n\n**Happy. Healthy. Connected. Global.**\n\nJoin the movement. Power up your fitness journey with XRWorkout. Start today! \n", "short_description": "The flexible fitness platform designed to fit any lifestyle and room. \nEffective functional full-body workouts for goals like weight loss, building strength, and improving mobility, catering to everyone from casual users to high-performance athletes. \nA completely controller-free sport for natural movement. \nJoin global multiplayer groups and use Mixed Reality to enable workouts anywhere. \nMerge the real world with virtual spaces personalized to your liking."}]}, "developer_name": null, "developer_privacy_policy_url": "https://xrworkout.io/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "XRWorkout Inc", "support_website_url": "https://chat.vrworkout.at/", "website_url": "https://xrworkout.io/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}, {"id": "2776542286000603"}, {"id": "1228796255027646"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": ["ACTION", "MUSIC", "SPORTS"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_playe
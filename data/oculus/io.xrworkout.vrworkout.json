at=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=40n2iOCivKoQ7kNvwGJ-in1&_nc_oc=Adoa7jIPvjrhbFSeLXUcvTx1_bQgbm4B5ALegnMhs3kOLGhdX51IbShZ7myoYHGpnbg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_6usvzOGasO4NqfriExdNginLe4gCwNqjQAnWQyXb0xQ&oe=6A3C0065"}, {"file_name": "38974821_2062710024142012_842799292904406152_n.png", "id": "1841963999761135", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491822561_1841964006427801_7898167711456008874_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8l5Cv7faEUoQ7kNvwGEvoBo&_nc_oc=AdoYEW1Xm6lJpqgARkNaUS1IOLTpOirfyOI2PWAUKuoR2SAaNwQwgPd7vRw6GV9mjlM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af--upV3peo5LTUd3LOmx9mZ3shzCCeSDowpqZObrtkafA&oe=6A3BEF3A"}, {"file_name": "screenshot_2_2560x1440.png", "id": "1615551819604965", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491821706_1615551822938298_4545988527550348770_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g06bFaJwB78Q7kNvwFxM07p&_nc_oc=AdrXtHpMSVfCMhd2d1C9FwugDZ6CnnVBdhf4D5cUy_RfOpxrmYtNBWapp5OJTx39Fe8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_SWfh6JTpt9jG0nOccQNv8i9NJb1JJxW9YoPuG4aytWQ&oe=6A3BEF40"}, {"file_name": "57574716_592617179798544_3999622944282718017_n.png", "id": "1408388324086848", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491819281_1408388330753514_2765652726808112638_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WQaBpjdbPJEQ7kNvwHVZtan&_nc_oc=AdpO3DLzs2TYnnrSfOeTWKmGcZaikzSAAh3F5olyKE8c80YO5yHNgxhciD2s1PfWw18&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9YnCkQ63ryPgg0Aoel3Ggal90wmY_o8EHgqFVgoh7Brw&oe=6A3BCD30"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "vlcsnap-2023-12-20-19h14m21s142.png", "id": "699332888964076", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974745_699332892297409_419806300857244010_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2MnapuNqNCsQ7kNvwGDJkdK&_nc_oc=AdogWmCSAvcIRTikmSs4QqBZHTk--J09ZLqphv4DSQLH99yl1G708OWxGBGK5HxPLR8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_b2rlGQ9ZtQP1QUwueg0KKNvB6wxnKoSHh-rmNOndxzA&oe=6A3BD5E0"}, "display_name": "XRWorkout Free to Play VR Fitness Sport", "keywords": ["fitness", "sport", "health", "training", "workout"], "long_description": "**Sprint. Squat. Jump. Box. Balance. Lift. Transform. The new sport for everyone**\n\nUnleash your fitness potential through functional full-body movement in mixed reality or full immersion\n\n\ud83d\udd25 **Controller-Free Freedom**\n\nFunctional movements require full freedom. Enjoy our hands-free, controller-less magic, delivering the most immersive and dynamic full-body workout in virtual reality\n\n{1348523363496068}\n\n\ud83d\udcaa **High-Intensity Workouts even with Weights**\n\nSet the game to adapt to your fitness level, and incorporating dynamic weight exercises to build strength and endurance. Easily progress from beginner to beast mode with no ceiling or plateau\n\n\u2764\ufe0f **Heart Rate-Controlled Biofeedback**\n\nOptimize your workout with real-time heart rate monitoring. Our biofeedback system can dynamically adjust exercise difficulty based on your heart rate, ensuring you stay in the ideal intensity zone for maximum results and safety\n\n\ud83e\uddb6 **Precision Foot Tracking for Balance**\n\nMaster balance and stability with advanced foot tracking for exercises that never get boring\n\n\ud83c\udf0d **Immersive & Social Multiplayer**\n\nConnect globally! Compete or collaborate with friends in real-time\n\n{1100068795535087}\n\n\ud83c\udfa8 **Shareable Environments**\n\nChoose from existing stunning immersive worlds or craft your own unique environments.\n\n{2313961729065699}\n\n\ud83c\udfc6 **Create & Share Challenges**\n\nDesign personalized workout challenges  and share them with the world to compete on global leaderboards\n\n{2147524639069776}\n\n**Happy. Healthy. Connected. Global.**\n\nJoin the movement. Power up your fitness journey with XRWorkout. Start today! \n", "short_description": "The flexible fitness platform designed to fit any lifestyle and room. \nEffective functional full-body workouts for goals like weight loss, building strength, and improving mobility, catering to everyone from casual users to high-performance athletes. \nA completely controller-free sport for natural movement. \nJoin global multiplayer groups and use Mixed Reality to enable workouts anywhere. \nMerge the real world with virtual spaces personalized to your liking."}]}, "developer_name": null, "developer_privacy_policy_url": "https://xrworkout.io/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "XRWorkout Inc", "support_website_url": "https://chat.vrworkout.at/", "website_url": "https://xrworkout.io/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}, {"id": "2776542286000603"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": ["ACTION", "MUSIC", "SPORTS"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER"], "id": "35188076397504685"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499300678_932764872418061_5774174550186364645_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LuikVuLm3bkQ7kNvwGgGwd0&_nc_oc=AdoIB0aaleqsH0oVsZfXFDSrCgVhejxjKtHYlEPsGGg8STC4NyrR6Nnom_uHsqohhls&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9B89r375vxAKjcNDDwbHWaa
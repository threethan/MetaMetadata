c_oc=AdntQT_Ra6P9tf6MHEShHjoRuXwIVkplmZzXqPonW4kT-5QC3Tytp1EL3u_Emw5iJhQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_Afx1V3ZB3IBHpINkf3MiJZPQzrwW4zmTOUxBBAC1p_axBA&oe=69BE89A5"}, {"file_name": "38974821_2062710024142012_842799292904406152_n.png", "id": "1841963999761135", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491822561_1841964006427801_7898167711456008874_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Rhh0JkeCPZsQ7kNvwFotngm&_nc_oc=AdmPToIbgOzKVhrlrG1CoORd0qTBGlh-KLTcN1SOs61rv5JnDqHKGSWrCt_NjyByw6s&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfxnrYgUbE7oBkwZyg2jza_qHV6tZJ36xPscj40Vimu5Vw&oe=69BE787A"}, {"file_name": "screenshot_2_2560x1440.png", "id": "1615551819604965", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491821706_1615551822938298_4545988527550348770_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yfLvptc4Vl8Q7kNvwFO51fP&_nc_oc=Adm7mvK6QRcfsiousoTbk7IfyHMu4bY2hVp9bCC2g_phYCMl8XObkeUV9s7HojTZQs0&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_Afzqp5HkQsCOTwRSkVBgWJBO4WHQh8-g0X6aPiQOOMqOeQ&oe=69BE7880"}, {"file_name": "57574716_592617179798544_3999622944282718017_n.png", "id": "1408388324086848", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491819281_1408388330753514_2765652726808112638_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E_4WYDU4KZEQ7kNvwGYkULJ&_nc_oc=AdkHO1rM3aitJJ0cH3R5VtUI6G80oXfGkg-9JQ6jf71LzNb5hMUPuZxSZ7loqb8V-7E&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfxShqxY2ibvXwKDVa4ma4sf4T5lmJa6UtYkCMfat2yldA&oe=69BE8EB0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "vlcsnap-2023-12-20-19h14m21s142.png", "id": "699332888964076", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974745_699332892297409_419806300857244010_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6nKEHusahh8Q7kNvwF1pn_3&_nc_oc=Adkv2V6GW_8nS0puwpqxK9ZmuKDzNLT-FjRcPlbyVrymM962G-dbV_9f2c5bdJf-POA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_Afx0GhkdLQ27dXsjmjbwRKcx6d-L05u-LB11JPEMzKpwXQ&oe=69BE9760"}, "display_name": "XRWorkout Free to Play VR Fitness", "keywords": ["fitness", "workout", "health", "exercise", "sports"], "long_description": "**Sprint. Squat. Jump. Box. Balance. Lift. Transform.**\n\nUnleash your fitness potential through functional full-body movement in mixed reality or full immersion\n\n\ud83d\udd25 **Controller-Free Freedom**\n\nFunctional movements require full freedom. Enjoy our hands-free, controller-less magic, delivering the most immersive and dynamic full-body workout in virtual reality\n\n{1348523363496068}\n\n\ud83d\udcaa **High-Intensity Workouts even with Weights**\n\nSet the game to adapt to your fitness level, and incorporating dynamic weight exercises to build strength and endurance. Easily progress from beginner to beast mode with no ceiling or plateau\n\n\u2764\ufe0f **Heart Rate-Controlled Biofeedback**\n\nOptimize your workout with real-time heart rate monitoring. Our biofeedback system can dynamically adjust exercise difficulty based on your heart rate, ensuring you stay in the ideal intensity zone for maximum results and safety\n\n\ud83e\uddb6 **Precision Foot Tracking for Balance**\n\nMaster balance and stability with advanced foot tracking for exercises that never get boring\n\n\ud83c\udf0d **Immersive & Social Multiplayer**\n\nConnect globally! Compete or collaborate with friends in real-time\n\n{1100068795535087}\n\n\ud83c\udfa8 **Shareable Environments**\n\nChoose from existing stunning immersive worlds or craft your own unique environments.\n\n{2313961729065699}\n\n\ud83c\udfc6 **Create & Share Challenges**\n\nDesign personalized workout challenges  and share them with the world to compete on global leaderboards\n\n{2147524639069776}\n\n**Happy. Healthy. Connected. Global.**\n\nJoin the movement. Power up your fitness journey with XRWorkout. Start today! \n", "short_description": "The ultimate functional full body fitness game that follows YOUR rules. \nIf you can imagine it you can do it with XRWorkout.\nJoin or build circles that workout together around the globe with  multiplayer group workouts. \nWorkout in small spaces or on the go with Mixed Reality merging the real world with the XRWorkout universe, or immerse yourself fully in infinite virtual spaces."}]}, "developer_name": null, "developer_privacy_policy_url": "https://xrworkout.io/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "XRWorkout Inc", "support_website_url": "https://chat.vrworkout.at/", "website_url": "https://xrworkout.io/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": ["ACTION", "MUSIC", "SPORTS"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER"], "id": "33593155440330130"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499300678_932764872418061_5774174550186364645_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xFXKQFXKUKgQ7kNvwFFyORm&_nc_oc=AdlA_i85pRMryT4ssQMJDDYWpoIYuU4_oEgJcFMKAwRMuWGUshJYfVAcS1enCIIPU4g&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfyJsMV6xiSN9-rVpT2oT44aBk4if72X-7ioI969ss3Z4Q&oe=69BE75C7"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "XRWorkout Free to Play VR Fitness", "platform": "ANDROID_6DOF", "context_category": {"context_category": 
SDZNtJr09kQ7kNvwG4zPY1&_nc_oc=AdraF9GuJDYxgefnyQNKYBYLLFqv7sfpIRrLNqol_lo_k80d4dXOGFJCYgJRpY0ge6o&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRtWDOZ5IQQ7HqWWis9-Wtwfr2oKJGYHTpPu2uvcuKiCQ&oe=6B0DC2F6"}, {"file_name": "screenshot_4_2560x1440.png", "id": "880727461172786", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491818852_880727467839452_6287163563324203134_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xXURwzR_wtQQ7kNvwFMXaau&_nc_oc=AdrQB0ZOs2pJeAFZuBhTsuh3e1vPWEmqDVVqdkA8V3-uv_i3YDuR8Iu_IfRzaatWnyQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTaenmuO_3Aq9KhAeIIu_rPfbefcZoIJ80EoxRngknAXA&oe=6B0D9EE5"}, {"file_name": "38974821_2062710024142012_842799292904406152_n.png", "id": "1841963999761135", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491822561_1841964006427801_7898167711456008874_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A_Lxll4y464Q7kNvwGKTBcg&_nc_oc=Adqiixh91AKoag78djpFWP_bqPgpvdWZ0ZqKFcBa42WogAQ69HGOraMw8zzZRnVPpq0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQ3612zYhYQfMlPWc9X63QeS2bMB_qlpS2zcqe39PP4uw&oe=6B0DC5FA"}, {"file_name": "screenshot_2_2560x1440.png", "id": "1615551819604965", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491821706_1615551822938298_4545988527550348770_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QY3H3mdoyw4Q7kNvwFeJaIG&_nc_oc=AdpzB4nYwmwvwp-pK_MS08g_-wwZhXirmrLtzV2UrC8HjqFu2g3X2kuRy6na5fgqWVk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTT6zZgcXywlW4RTtcSE_w-GeCkZ_6oz0bWmnOWzMEhVA&oe=6B0DC600"}, {"file_name": "57574716_592617179798544_3999622944282718017_n.png", "id": "1408388324086848", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491819281_1408388330753514_2765652726808112638_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GPes8i_7f4sQ7kNvwELP3mf&_nc_oc=AdoBIxEAv89JH0DD72HEAS5WJ8kNWMXN4xMdcyqPQNQLL_38C5L_klQ-mw4xzQLKmQc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRtCO2NchXE049qt5vzK1SZZipUnsJxhKGs2BMfmy5CXw&oe=6B0DA3F0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "vlcsnap-2023-12-20-19h14m21s142.png", "id": "699332888964076", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974745_699332892297409_419806300857244010_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_ghQ5D479NoQ7kNvwHZZ9St&_nc_oc=AdqEmhnZmJKie2X7V7fvLRdsjVtcNiK05jppuvfHSc_i2BkkZ64-01VJspjR6JFptfI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQRz4x4SZS4Mkhh0k5QQo5BWN-LBA8rej5dX2FjY6zAcg&oe=6B0DACA0"}, "display_name": "XRWorkout Free to Play VR Fitness Sport", "keywords": ["fitness", "sport", "health", "training", "workout"], "long_description": "**Sprint. Squat. Jump. Box. Balance. Lift. Transform. The new sport for everyone**\n\nUnleash your fitness potential through functional full-body movement in mixed reality or full immersion\n\n\ud83d\udd25 **Controller-Free Freedom**\n\nFunctional movements require full freedom. Enjoy our hands-free, controller-less magic, delivering the most immersive and dynamic full-body workout in virtual reality\n\n{1348523363496068}\n\n\ud83d\udcaa **High-Intensity Workouts even with Weights**\n\nSet the game to adapt to your fitness level, and incorporating dynamic weight exercises to build strength and endurance. Easily progress from beginner to beast mode with no ceiling or plateau\n\n\u2764\ufe0f **Heart Rate-Controlled Biofeedback**\n\nOptimize your workout with real-time heart rate monitoring. Our biofeedback system can dynamically adjust exercise difficulty based on your heart rate, ensuring you stay in the ideal intensity zone for maximum results and safety\n\n\ud83e\uddb6 **Precision Foot Tracking for Balance**\n\nMaster balance and stability with advanced foot tracking for exercises that never get boring\n\n\ud83c\udf0d **Immersive & Social Multiplayer**\n\nConnect globally! Compete or collaborate with friends in real-time\n\n{1100068795535087}\n\n\ud83c\udfa8 **Shareable Environments**\n\nChoose from existing stunning immersive worlds or craft your own unique environments.\n\n{2313961729065699}\n\n\ud83c\udfc6 **Create & Share Challenges**\n\nDesign personalized workout challenges  and share them with the world to compete on global leaderboards\n\n{2147524639069776}\n\n**Happy. Healthy. Connected. Global.**\n\nJoin the movement. Power up your fitness journey with XRWorkout. Start today! \n", "short_description": "The flexible fitness platform designed to fit any lifestyle and room. \nEffective functional full-body workouts for goals like weight loss, building strength, and improving mobility, catering to everyone from casual users to high-performance athletes. \nA completely controller-free sport for natural movement. \nJoin global multiplayer groups and use Mixed Reality to enable workouts anywhere. \nMerge the real world with virtual spaces personalized to your liking."}]}, "developer_name": null, "developer_privacy_policy_url": "https://xrworkout.io/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "XRWorkout Inc", "support_website_url": "https://chat.vrworkout.at/", "website_url": "https://xrworkout.io/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}, {"id": "2776542286000603"}, {"id": "1228796255027646"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": ["ACTION", "MUSIC", "SPORTS"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER"], "id": "35905950239050627"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499300678_932764872418061_5774174550186364645_n.png?stp=dst-png_s360x360&_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Gbgewuk41OcQ7kNvwF4uTAK&_nc_oc=Adpn-0_sXpycWP7ToiSPC0koYcM1P3ASY8K1Z5jnX7MacfVyJZ_noh5wTICVgldcNJg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSCaIrBvRGRnJx4AbITLfZ1E-7c4uwgGjtiZsVBmPmNtw&oe=6B0DC347"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "XRWorkout Free to Play VR Fitness Sport", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_name": "Fitness & Wellness", "id": "810139357995560"}, {"topic_name": "Sports", "id": "2776542286000603"}, {"topic_name": "Community", "id": "1228796255027646"}], "release_date": 1678986049, "lastRevision": {"nodes": [{"id": "8266372850101738", "release_type": "MANAGED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "8266372770101746", "is_first_party": false, "enables_in_app_ads": false, "is_concept": false, "platform": "ANDROID_6DOF"}, "iarc_cert": {"id": "4168644630026759"}, "iarc_email": null, "msrp": null, "translations": {"nodes": [{"images": {"nodes": [{"file_name": "MiniLandscape_1080x360px.jpg.png", "id": "5807573752660155", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/57575352_5807573755993488_343189359429749602_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZKqrdCoKMmUQ7kNvwG4xN7I&_nc_oc=AdrrtnDNsvxfRfOvw-YW2TCXDCAIeafXNqHSQje0YWi2UHV1ZFE7euYyNvTopGdIgDY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQKzBc66Br4kkiJ792Ea_gGB
DTkcn2xOG0Q7kNvwEwdmvM&_nc_oc=AdqwsjhDvVBccxYzsoMyaA-Qh18HEqjKutBfKcK4IKiTM4g7HcpXb7UPifqfB56Mls4&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT4NuKF3B_uHC-PZLuvrTPQYMsexKrj5zoTtyMmpzilUw&oe=6AFC6736"}, {"file_name": "screenshot_4_2560x1440.png", "id": "880727461172786", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491818852_880727467839452_6287163563324203134_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oRqo2C1ZNcoQ7kNvwHXiRVA&_nc_oc=AdrgzvC2rQDlcHEnWZSTwwdKA1U-fSZ6qJqnjRiMI7PxWamxr4FKcgMa-cLRgYyd3uk&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ6YT_Q45gOg8dnc-67wffA7whnJbaxteNKzCgLq6OdLQ&oe=6AFC7B65"}, {"file_name": "38974821_2062710024142012_842799292904406152_n.png", "id": "1841963999761135", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491822561_1841964006427801_7898167711456008874_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2pZD7N-KtJ0Q7kNvwG1h9SJ&_nc_oc=Adodz3qMrYxb7cSMd5ZNGeDH_CuOVeX3778C2WKNibt7VUQgXVH7IJKTTuu0JkAb7ko&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQz4tciKoAbFbHr9DJ6G-jquWepocRfR-ZU5CKmmRRg2Q&oe=6AFC6A3A"}, {"file_name": "screenshot_2_2560x1440.png", "id": "1615551819604965", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491821706_1615551822938298_4545988527550348770_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2PW6gloOQAcQ7kNvwGuSceL&_nc_oc=Ado5IJJO81POOAEH_LyMLZIVcU2NZLXsqIMTR8sMJLjMxk-SNyAF0chzem_OOE16Deo&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS2vJRtdLUq-fUl3JFUt4f23hZNsnrWq48sQdCTaYXKIA&oe=6AFC6A40"}, {"file_name": "57574716_592617179798544_3999622944282718017_n.png", "id": "1408388324086848", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491819281_1408388330753514_2765652726808112638_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PyeUuaZXCiQQ7kNvwEphFm8&_nc_oc=AdqwLaT46coRuyPrKDs5YFeaRD_-q3vNyEHpOgA0F15SEVWAJxueGdXqcwndyCLXUTU&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRSPR19Zw-7z6i3zspLeXHi-UF_Wae3ladR2i8vr5UX8w&oe=6AFC8070"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "vlcsnap-2023-12-20-19h14m21s142.png", "id": "699332888964076", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/38974745_699332892297409_419806300857244010_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DjHJG-zqs38Q7kNvwE3n7wn&_nc_oc=AdoANantr_7GqLcxC-aKJUQoSEFA-49Qvc1H-n52nwi94waiAIG8_vxjfCZvLkmaG-Q&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSIr_4D4M1h65vKGGue9X1yPEwVAblG0wWMp26JqvyIkg&oe=6AFC8920"}, "display_name": "XRWorkout Free to Play VR Fitness Sport", "keywords": ["fitness", "sport", "health", "training", "workout"], "long_description": "**Sprint. Squat. Jump. Box. Balance. Lift. Transform. The new sport for everyone**\n\nUnleash your fitness potential through functional full-body movement in mixed reality or full immersion\n\n\ud83d\udd25 **Controller-Free Freedom**\n\nFunctional movements require full freedom. Enjoy our hands-free, controller-less magic, delivering the most immersive and dynamic full-body workout in virtual reality\n\n{1348523363496068}\n\n\ud83d\udcaa **High-Intensity Workouts even with Weights**\n\nSet the game to adapt to your fitness level, and incorporating dynamic weight exercises to build strength and endurance. Easily progress from beginner to beast mode with no ceiling or plateau\n\n\u2764\ufe0f **Heart Rate-Controlled Biofeedback**\n\nOptimize your workout with real-time heart rate monitoring. Our biofeedback system can dynamically adjust exercise difficulty based on your heart rate, ensuring you stay in the ideal intensity zone for maximum results and safety\n\n\ud83e\uddb6 **Precision Foot Tracking for Balance**\n\nMaster balance and stability with advanced foot tracking for exercises that never get boring\n\n\ud83c\udf0d **Immersive & Social Multiplayer**\n\nConnect globally! Compete or collaborate with friends in real-time\n\n{1100068795535087}\n\n\ud83c\udfa8 **Shareable Environments**\n\nChoose from existing stunning immersive worlds or craft your own unique environments.\n\n{2313961729065699}\n\n\ud83c\udfc6 **Create & Share Challenges**\n\nDesign personalized workout challenges  and share them with the world to compete on global leaderboards\n\n{2147524639069776}\n\n**Happy. Healthy. Connected. Global.**\n\nJoin the movement. Power up your fitness journey with XRWorkout. Start today! \n", "short_description": "The flexible fitness platform designed to fit any lifestyle and room. \nEffective functional full-body workouts for goals like weight loss, building strength, and improving mobility, catering to everyone from casual users to high-performance athletes. \nA completely controller-free sport for natural movement. \nJoin global multiplayer groups and use Mixed Reality to enable workouts anywhere. \nMerge the real world with virtual spaces personalized to your liking."}]}, "developer_name": null, "developer_privacy_policy_url": "https://xrworkout.io/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "XRWorkout Inc", "support_website_url": "https://chat.vrworkout.at/", "website_url": "https://xrworkout.io/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}, {"id": "2776542286000603"}, {"id": "1228796255027646"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": ["ACTION", "MUSIC", "SPORTS"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER"], "id": "35905950239050627"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499300678_932764872418061_5774174550186364645_n.png?stp=dst-png_s360x360&_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vyinf2TmgU0Q7kNvwHss40M&_nc_oc=AdpwnvwCGfMY0JWJsWQZf7r7dzxTBGZxVXVrH4iu92_bVT3OgszaXq5ItfdLELzYWTI&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQxkkSdTHKUNjImic-OCUXNtJ2dchV3cgg2aFDHZQJBdg&oe=6AFC6787"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "XRWorkout Free to Play VR Fitness Sport", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_name": "Fitness & Wellness", "id": "810139357995560"}, {"topic_name": "Sports", "id": "2776542286000603"}, {"topic_name": "Community", "id": "1228796255027646"}], "release_date": 1678986049, "lastRevision": {"nodes": [{"id": "8266372850101738", "release_type": "MANAGED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "8266372770101746", "is_first_party": false, "enables_in_app_ads": false, "is_concept": false, "platform": "ANDROID_6DOF"}, "iarc_cert": {"id": "4168644630026759"}, "iarc_email": null, "msrp": null, "translations": {"nodes": [{"images": {"nodes": [{"file_name": "MiniLandscape_1080x360px.jpg.png", "id": "5807573752660155", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/57575352_5807573755993488_343189359429749602_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y59252KYfg8Q7kNvwEvyGpf&_nc_oc=AdoZWcJi9b1T7ns1ZPQ6w_g-BFuhDSJXYBjNET4ztsjGRLdXLHj5ur-VxlbXJ_NKJ9I&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ8Otk1jNiLUaSZFX0Ec6c28
ctgLs37TbaaDjqkWjfRjpIZPiHYwWrozGeWyltAwk7ocyHygWE9LRKc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSc_2LiWuY5Z8f60ya76M5Mf_97lD4utErOLuf3FVdn2g&oe=6B05BAF0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "vlcsnap-2023-12-20-19h14m21s142.png", "id": "699332888964076", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974745_699332892297409_419806300857244010_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CfvQWWgR8YcQ7kNvwEoZIzI&_nc_oc=AdpjY5yey2ASDfSQ-cepwGKBwojdZEOtVzTVhO1t09YPx6IJdxp-b0UGSxM2oVgJpTw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTZq6ceWawYMD1_mhC5kWXiMum306jy3pyy-AvvUwE5RA&oe=6B05C3A0"}, "display_name": "XRWorkout Free to Play VR Fitness Sport", "keywords": ["fitness", "sport", "health", "training", "workout"], "long_description": "**Sprint. Squat. Jump. Box. Balance. Lift. Transform. The new sport for everyone**\n\nUnleash your fitness potential through functional full-body movement in mixed reality or full immersion\n\n\ud83d\udd25 **Controller-Free Freedom**\n\nFunctional movements require full freedom. Enjoy our hands-free, controller-less magic, delivering the most immersive and dynamic full-body workout in virtual reality\n\n{1348523363496068}\n\n\ud83d\udcaa **High-Intensity Workouts even with Weights**\n\nSet the game to adapt to your fitness level, and incorporating dynamic weight exercises to build strength and endurance. Easily progress from beginner to beast mode with no ceiling or plateau\n\n\u2764\ufe0f **Heart Rate-Controlled Biofeedback**\n\nOptimize your workout with real-time heart rate monitoring. Our biofeedback system can dynamically adjust exercise difficulty based on your heart rate, ensuring you stay in the ideal intensity zone for maximum results and safety\n\n\ud83e\uddb6 **Precision Foot Tracking for Balance**\n\nMaster balance and stability with advanced foot tracking for exercises that never get boring\n\n\ud83c\udf0d **Immersive & Social Multiplayer**\n\nConnect globally! Compete or collaborate with friends in real-time\n\n{1100068795535087}\n\n\ud83c\udfa8 **Shareable Environments**\n\nChoose from existing stunning immersive worlds or craft your own unique environments.\n\n{2313961729065699}\n\n\ud83c\udfc6 **Create & Share Challenges**\n\nDesign personalized workout challenges  and share them with the world to compete on global leaderboards\n\n{2147524639069776}\n\n**Happy. Healthy. Connected. Global.**\n\nJoin the movement. Power up your fitness journey with XRWorkout. Start today! \n", "short_description": "The flexible fitness platform designed to fit any lifestyle and room. \nEffective functional full-body workouts for goals like weight loss, building strength, and improving mobility, catering to everyone from casual users to high-performance athletes. \nA completely controller-free sport for natural movement. \nJoin global multiplayer groups and use Mixed Reality to enable workouts anywhere. \nMerge the real world with virtual spaces personalized to your liking."}]}, "developer_name": null, "developer_privacy_policy_url": "https://xrworkout.io/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "XRWorkout Inc", "support_website_url": "https://chat.vrworkout.at/", "website_url": "https://xrworkout.io/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}, {"id": "2776542286000603"}, {"id": "1228796255027646"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": ["ACTION", "MUSIC", "SPORTS"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER"], "id": "35905950239050627"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499300678_932764872418061_5774174550186364645_n.png?stp=dst-png_s360x360&_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C5-okapeOkkQ7kNvwFA7gXn&_nc_oc=AdqSANYcI1RfG7UorhfHh5MlQBxgQY_ga47d0DHsBDhRIVNeJGgtmn1SuFG9m4xc0iM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQOrdLvatIbCTIHQyEK9QOiwE0tyaUJ7SgEZx1jGP_R9A&oe=6B05A207"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "XRWorkout Free to Play VR Fitness Sport", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_name": "Fitness & Wellness", "id": "810139357995560"}, {"topic_name": "Sports", "id": "2776542286000603"}, {"topic_name": "Community", "id": "1228796255027646"}], "release_date": 1678986049, "lastRevision": {"nodes": [{"id": "8266372850101738", "release_type": "MANAGED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "8266372770101746", "is_first_party": false, "enables_in_app_ads": false, "is_concept": false, "platform": "ANDROID_6DOF"}, "iarc_cert": {"id": "4168644630026759"}, "iarc_email": null, "msrp": null, "translations": {"nodes": [{"images": {"nodes": [{"file_name": "MiniLandscape_1080x360px.jpg.png", "id": "5807573752660155", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/57575352_5807573755993488_343189359429749602_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iIKYc1U4kKoQ7kNvwEXl4fD&_nc_oc=AdpKvyA_GyzjzNPuhI9wHcM-pHTzYoaFlimQG3BGbW63rSWqBukzvjUMWjYfRy2u8dM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTJhqIqonepkMFD9NhFCs1sU
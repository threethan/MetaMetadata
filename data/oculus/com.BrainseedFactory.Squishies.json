culuscdn.com/v/t64.5771-25/75322598_1145165853836223_6864148320373849862_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HaEyCLan_TgQ7kNvwEm5NyJ&_nc_oc=AdpWLEqgbZlnlQDfeoJFdJVDuOKH9kqkiHwF03Cqj9ijL6UOL2HG6vjy5SsCZaEvU9A&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGbiOxXWWqkOA-JUfbw6DXMO8TYSEcvzLtYGKy8NdyPaQ&oe=6A819CC3"}, {"file_name": "Screenshot03.png", "id": "598340872572801", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/39001670_598340875906134_7078948835759736288_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E0lyHa6DJKUQ7kNvwGOMI0w&_nc_oc=Adr1pReOKFXS28nQU-BzkN7HllSfvX-MZc1Ht2Yo7RFv6vJzBKkYihc7aEQEG-XETNI&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF2OqtCR2XOJRj3LaSxNe15FWOSxL1Ww8Z8VZEIvl1U1g&oe=6A819ACB"}, {"file_name": "Screenshot06.png", "id": "970563445094246", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/39031450_970563448427579_1896364834470325490_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0pwBIpGVS6IQ7kNvwFETh5l&_nc_oc=AdpFAvJiCLQ8Axq3QahWn-E0SahTrygQ7WgPktLiyJkzIGMaWtqRF_z1bl5jSuP5PT8&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHzCxvU2WzSG27YkWYrpa17YWlx-MXABHBWEzpMINcl8Q&oe=6A81BA52"}, {"file_name": "Screenshot04.png", "id": "575729695062740", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/39031400_575729698396073_2621336866475747103_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PhR3XSwV3zAQ7kNvwFVqDHS&_nc_oc=Adr7-MyJtCq9zAOKv-ramNSI2mP2F7BnYpxkERY4PsaJFbT9piNxEJS2WE0UPANQJD4&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGM26-RRfOsLbSYpbcnHaaxzieCVM43oUrPV1iyFF8fBg&oe=6A81C15C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Gameplay Trailer Thumb.png", "id": "605202028847932", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/38974836_605202032181265_2417977283558520499_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T9gYHRIPezUQ7kNvwFucUPN&_nc_oc=AdrH5Vxhdu_DttWYVaqWI-PULBpwWhQhFgj0fa2-GNVoD0FJhZJxR1NG_hmapWAzEa8&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEBcNi71S6uYX9qgSacUozGcSYsRbDXo6z8ClXFSrFJmA&oe=6A8190D9"}, "display_name": "Squishies - Roll them Home!", "keywords": ["puzzle", "platformer", "sandbox", "exploration", "adventure"], "long_description": "**Get lost in the Squishies-verse!**\n\nSquishies is a head-scratching puzzle platformer where you guide courageous and cute creatures through a series of increasingly hazardous, challenging mazes. Use unique motion controls to push and pull the Squishies through their adventures in a colorful universe full of strange flora and fauna. Keep those little rascals safe while they climb, jump, fly and teleport-by-fish through dozens of levels in five alien worlds!\n\n{507625458961423}\n\nYou push and pull the Squishies from one side of the maze to the other, all while earning medals, gathering crystals, climbing slopes, and avoiding pitfalls.\n\n- **Explore a huge universe** - Across dozens of levels in five different worlds.\n- **Collectibles and Achievements** - Gather all the crystals, beat the clock or find the hidden egg in each level.\n- **Level Editor** - Squishies really comes into its own with its innovative, fully featured creation tools.\n- **Community Section** - Share your creation with others and play their ingenious levels.\n- **Limited play space?** Need to keep an eye on your own little monsters?  You\u2019re in luck. Squishies\u00ae can be played in the newly added Mixed Reality mode!\n\n\n{482757334822594}", "short_description": "Help the stranded Squishies find their way back home! Push and pull them through challenging puzzles, or create your own levels with the powerful in-game editor and share them with the community."}]}, "developer_name": null, "developer_privacy_policy_url": "https://brainseed-factory.com/law/privacy_products/index.php", "developer_terms_of_service_url": "https://brainseed-factory.com/law/terms_products/index.php", "publishe
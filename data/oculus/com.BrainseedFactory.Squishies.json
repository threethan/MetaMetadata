oe=69CCFD4B"}, {"file_name": "Screenshot06.png", "id": "970563445094246", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031450_970563448427579_1896364834470325490_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J3OFi8zLH-sQ7kNvwHWReFg&_nc_oc=Adq-rsKTdWyplQQzWsiq8l3_R7SrC9bypMqf1ky99O4GEXsg5FxJakPgws5uepp3nGg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzyRCSG_nXvwOM-kdgzrRO9-i9ce9S6KvLYtibe76PjjA&oe=69CD1CD2"}, {"file_name": "Screenshot04.png", "id": "575729695062740", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031400_575729698396073_2621336866475747103_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oXCIqhZyJQUQ7kNvwEwyPmq&_nc_oc=AdqUQZOrpJDVLpInArX9asfT1D7W6EYxXudvBXdl1KWbTvPJoc46qIfW5l_33eT-ScU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afxz75MiLxJ0NkRKOOYLYYYfJw7l7m02ZD91_kOHBlOKVw&oe=69CD23DC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Gameplay Trailer Thumb.png", "id": "605202028847932", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974836_605202032181265_2417977283558520499_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4OaX-7ZOiREQ7kNvwEGlR7N&_nc_oc=AdpwgSTbWk_u6d5BK_zatvbBFLr0ADpHk125TNTRW4Jy1X5wqaiMZ_Oct5T_SUEZqW4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxlCf8MOnGgmAGYdNtO2OQS3dbgbKhGvqt5JryszjYsHg&oe=69CD2B99"}, "display_name": "Squishies\u00ae - Roll them Home!", "keywords": ["puzzle", "platformer", "sandbox", "exploration", "adventure"], "long_description": "**Get lost in the Squishies-verse!**\n\nSquishies is a head-scratching puzzle platformer where you guide courageous and cute creatures through a series of increasingly hazardous, challenging mazes. Use unique motion controls to push and pull the Squishies through their adventures in a colorful universe full of strange flora and fauna. Keep those little rascals safe while they climb, jump, fly and teleport-by-fish through dozens of levels in five alien worlds!\n\n{507625458961423}\n\nYou push and pull the Squishies from one side of the maze to the other, all while earning medals, gathering crystals, climbing slopes, and avoiding pitfalls.\n\n- **Explore a huge universe** - Across dozens of levels in five different worlds.\n- **Collectibles and Achievements** - Gather all the crystals, beat the clock or find the hidden egg in each level.\n- **Level Editor** - Squishies really comes into its own with its innovative, fully featured creation tools.\n- **Community Section** - Share your creation with others and play their ingenious levels.\n\n\n{482757334822594}", "short_description": "Help the stranded Squishies find their way back home! Push and pull them through challenging puzzles, or create your own levels with the powerful in-game editor and share them with the community."}]}, "developer_name": null, "developer_privacy_policy_url": "https://brainseed-factory.com/law/privacy_products/index.php", "developer_terms_of_service_url": "https://brainseed-factory.com/law/terms_products/index.php", "publisher_name": "Brainseed Factory", "support_website_url": null, "website_url": "https://www.brainseed-factory.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "528142316460358"}, {"id": "377978390272490"}, {"id": "1990104051447093"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "de", "fr", "es", "it", "zh_CN", "zh_HK", "ja", "ru", "pt", "pt_BR"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "85339153433
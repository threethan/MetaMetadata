uluscdn.com/v/t64.5771-25/75322598_1145165853836223_6864148320373849862_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MBPMUy0LwFgQ7kNvwFR2WvF&_nc_oc=AdqfWJ5TqHeV6g2Yg0_IGHH2sIpizIXg9intuaJAPex3PXDdCxsOVNrOe18XX1caWA0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1yrRgz_Ccag-ex_b4XeQiQAwi-wJcLI_3B8XXbeUx_XQ&oe=69D396C3"}, {"file_name": "Screenshot03.png", "id": "598340872572801", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39001670_598340875906134_7078948835759736288_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0GBO7J3ZoDIQ7kNvwH1TDZf&_nc_oc=Adp2X4fuwPYpYNRdoW6_SrCifKoReyPUQrxSJ_jKhQAylpNIGD1SNpQpX48KLxd9KbI&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0Kqxv2FOSUYP3k_xu55Iz-Qqxbow6y7j4JrOAmaJJbuw&oe=69D394CB"}, {"file_name": "Screenshot06.png", "id": "970563445094246", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031450_970563448427579_1896364834470325490_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TFke4iTaWSsQ7kNvwEIvBJG&_nc_oc=AdpCf0TOKjlDFHkk8DMikwJey1dQ5G-nomzs3cFLsObekge1FsM05aQU-0H0ldjEL6Y&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2-xddpv7tCZl72BsZWYtZLgQyD87MaErGgNGQVfgJLdg&oe=69D3B452"}, {"file_name": "Screenshot04.png", "id": "575729695062740", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031400_575729698396073_2621336866475747103_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FfnlOzM5-ewQ7kNvwH4QYRL&_nc_oc=Adq-YLpMN1MFeLuAQGeAvH5J768hTPbzJ_RwIJRBPrTJMJe5oA9LVfEOr9DJH7Z79fc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3j7YEkmSySED4E7bUyIJp9gRJiv-nBByGrxtOV-JFgrg&oe=69D3BB5C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Gameplay Trailer Thumb.png", "id": "605202028847932", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974836_605202032181265_2417977283558520499_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ji3PZ4IEe1cQ7kNvwH6RWrs&_nc_oc=AdoErNxemmjeU_b1yw0vuG9-qdWn1vKmQRwC49GpRvNLI2cJnXCf9xjEQK-G_pSOt8o&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3er1U5frOmO08vZ76PeQg7LaqlblC2Nb_nxmIe56kyBw&oe=69D3C319"}, "display_name": "Squishies - Roll them Home!", "keywords": ["puzzle", "platformer", "sandbox", "exploration", "adventure"], "long_description": "**Get lost in the Squishies-verse!**\n\nSquishies is a head-scratching puzzle platformer where you guide courageous and cute creatures through a series of increasingly hazardous, challenging mazes. Use unique motion controls to push and pull the Squishies through their adventures in a colorful universe full of strange flora and fauna. Keep those little rascals safe while they climb, jump, fly and teleport-by-fish through dozens of levels in five alien worlds!\n\n{507625458961423}\n\nYou push and pull the Squishies from one side of the maze to the other, all while earning medals, gathering crystals, climbing slopes, and avoiding pitfalls.\n\n- **Explore a huge universe** - Across dozens of levels in five different worlds.\n- **Collectibles and Achievements** - Gather all the crystals, beat the clock or find the hidden egg in each level.\n- **Level Editor** - Squishies really comes into its own with its innovative, fully featured creation tools.\n- **Community Section** - Share your creation with others and play their ingenious levels.\n- **Limited play space?** Need to keep an eye on your own little monsters?  You\u2019re in luck. Squishies\u00ae can be played in the newly added Mixed Reality mode!\n\n\n{482757334822594}", "short_description": "Help the stranded Squishies find their way back home! Push and pull them through challenging puzzles, or create your own levels with the powerful in-game editor and share them with the community."}]}, "developer_name": null, "developer_privacy_policy_url": "https://brainseed-factory.com/law/privacy_products/index.php", "developer_terms_of_service_url": "https://brainseed-factory.com/law/terms_products/index.php", "publisher
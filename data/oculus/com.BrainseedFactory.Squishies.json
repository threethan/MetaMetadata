culuscdn.com/v/t64.5771-25/75322598_1145165853836223_6864148320373849862_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ViMO9eM6HJMQ7kNvwHGPKls&_nc_oc=Ado0Y6DxRAbxHA5LxP3wA5aDqqaXP56P_P300CffvS5mEZ54KM6KsUelpQM-zu5Pk00&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJiN4w1eLrO95svmtZMTF46IKnfEvvuR_T9vrO3e8BVBw&oe=6AB3EE03"}, {"file_name": "Screenshot03.png", "id": "598340872572801", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39001670_598340875906134_7078948835759736288_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V0OaQ8XZDHAQ7kNvwHdk8sg&_nc_oc=AdpEOzmG0nD5F2bb9wpM2XdZ6ABOxKfczI1cyXo1l7KJ9xC--IVnKQn-UUHBUcTrB5s&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLxyvwQRtLEDRKnC7pi1bnzAD7eub677CERPzIkZHc-4Q&oe=6AB3EC0B"}, {"file_name": "Screenshot06.png", "id": "970563445094246", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031450_970563448427579_1896364834470325490_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KpJOiwH81lkQ7kNvwG8_9E6&_nc_oc=AdokTej-tOiyuvaJRMd1VXfakBb13HlY4dUrKcbhYCLlj6FCAWYiBwEFRuB_nShpXlw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI03Ofxn_v3ispTHFdAAon2_4soAFf78WbXGsVTKik7Tw&oe=6AB3D352"}, {"file_name": "Screenshot04.png", "id": "575729695062740", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031400_575729698396073_2621336866475747103_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0kkGkuhbwIsQ7kNvwERw8Dr&_nc_oc=AdolgV5X-mrzUX5l_ZEjuBvpc7Mskar6dRJ9gvMTSereNj3qGRaFaKtXRL0XvV-J5oo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKk6CRU9zew6VW9CjmF9rZR_Ftajr-HuA7y4sjs4KRoaw&oe=6AB3DA5C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Gameplay Trailer Thumb.png", "id": "605202028847932", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974836_605202032181265_2417977283558520499_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AJElEW_nGnYQ7kNvwEJAX3I&_nc_oc=AdqRCVF4XK99MdxTV7sqUsK8GX6o7HiMV3BnZQfp4eG6hqGuNRWx8cZs1sRGXTT7BGY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ60SvZcgjMhz5xggAqi6V2fsmlcvqh6Way2NuSW28bPg&oe=6AB3E219"}, "display_name": "Squishies - Roll them Home!", "keywords": ["puzzle", "platformer", "sandbox", "exploration", "adventure"], "long_description": "**Get lost in the Squishies-verse!**\n\nSquishies is a head-scratching puzzle platformer where you guide courageous and cute creatures through a series of increasingly hazardous, challenging mazes. Use unique motion controls to push and pull the Squishies through their adventures in a colorful universe full of strange flora and fauna. Keep those little rascals safe while they climb, jump, fly and teleport-by-fish through dozens of levels in five alien worlds!\n\n{507625458961423}\n\nYou push and pull the Squishies from one side of the maze to the other, all while earning medals, gathering crystals, climbing slopes, and avoiding pitfalls.\n\n- **Explore a huge universe** - Across dozens of levels in five different worlds.\n- **Collectibles and Achievements** - Gather all the crystals, beat the clock or find the hidden egg in each level.\n- **Level Editor** - Squishies really comes into its own with its innovative, fully featured creation tools.\n- **Community Section** - Share your creation with others and play their ingenious levels.\n- **Limited play space?** Need to keep an eye on your own little monsters?  You\u2019re in luck. Squishies\u00ae can be played in the newly added Mixed Reality mode!\n\n\n{482757334822594}", "short_description": "Help the stranded Squishies find their way back home! Push and pull them through challenging puzzles, or create your own levels with the powerful in-game editor and share them with the community."}]}, "developer_name": null, "developer_privacy_policy_url": "https://brainseed-factory.com/law/privacy_products/index.php", "developer_terms_of_service_url": "https://brainseed-factory.com/law/terms_products/index.php", "publishe
culuscdn.com/v/t64.5771-25/75322598_1145165853836223_6864148320373849862_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XsYjTVc3OdUQ7kNvwHAm7Jw&_nc_oc=AdqzSGQZkly_tWXhF5w26ojAzSVUR9k2x4sMRbSGOaC51qtqpt7AbRX2Lw3k2WHlPBo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8Rc4ZzQGk6DANHNgHgJ9f-EDidKgtjiTMxQWWD2PHMPw&oe=6A43DE83"}, {"file_name": "Screenshot03.png", "id": "598340872572801", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39001670_598340875906134_7078948835759736288_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mUaIUB7nqGoQ7kNvwH9rQQz&_nc_oc=Adpn-l270F7gK2mrMm32Ja_9BjUS6E20L_cOkwMeO5QXcyd6K3-KJzKkpNUoCJzylbI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9Ro8e3nt8WWMn4FoNBbiY0KKUaLDJoEM6S2q2O5INNZQ&oe=6A43DC8B"}, {"file_name": "Screenshot06.png", "id": "970563445094246", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031450_970563448427579_1896364834470325490_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GPfNMP0xvGEQ7kNvwF-WDKp&_nc_oc=Adqy5FJrYzEYZYgyedalx1oDmhCN-E1fXXxNNH-K4KqgzxqCZ61yYjyn8SGUYMGZjlc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-3Z4WwWM82093Rgod6jIhBnDC7HGD8EL1_Fh0ozQRpfA&oe=6A43C3D2"}, {"file_name": "Screenshot04.png", "id": "575729695062740", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031400_575729698396073_2621336866475747103_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3DFUN0GGikAQ7kNvwHbdaWH&_nc_oc=Adqym20bXn5Pyw3HyJboRaB1o5SdTdIxPgirHWC1dsv9Cq-qVw7Y6L-Uz41XrSdxPWw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9WFcyf_W2y5fACaH_fcAyED1u7_CVY1TJxBwH0oc4Akg&oe=6A43CADC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Gameplay Trailer Thumb.png", "id": "605202028847932", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974836_605202032181265_2417977283558520499_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iOJ8Rhdam3sQ7kNvwEJsopa&_nc_oc=Adpu_pTLp_NLwbFJrVC5T8lA69xf5DZijMv4F9FlDLVKyC6wOuzQkfWpIaaXNtFzqkM&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9pSPDoGb6MMbe7xcTdi_F7OGNVVRH7pworVbhtlGhCWQ&oe=6A43D299"}, "display_name": "Squishies - Roll them Home!", "keywords": ["puzzle", "platformer", "sandbox", "exploration", "adventure"], "long_description": "**Get lost in the Squishies-verse!**\n\nSquishies is a head-scratching puzzle platformer where you guide courageous and cute creatures through a series of increasingly hazardous, challenging mazes. Use unique motion controls to push and pull the Squishies through their adventures in a colorful universe full of strange flora and fauna. Keep those little rascals safe while they climb, jump, fly and teleport-by-fish through dozens of levels in five alien worlds!\n\n{507625458961423}\n\nYou push and pull the Squishies from one side of the maze to the other, all while earning medals, gathering crystals, climbing slopes, and avoiding pitfalls.\n\n- **Explore a huge universe** - Across dozens of levels in five different worlds.\n- **Collectibles and Achievements** - Gather all the crystals, beat the clock or find the hidden egg in each level.\n- **Level Editor** - Squishies really comes into its own with its innovative, fully featured creation tools.\n- **Community Section** - Share your creation with others and play their ingenious levels.\n- **Limited play space?** Need to keep an eye on your own little monsters?  You\u2019re in luck. Squishies\u00ae can be played in the newly added Mixed Reality mode!\n\n\n{482757334822594}", "short_description": "Help the stranded Squishies find their way back home! Push and pull them through challenging puzzles, or create your own levels with the powerful in-game editor and share them with the community."}]}, "developer_name": null, "developer_privacy_policy_url": "https://brainseed-factory.com/law/privacy_products/index.php", "developer_terms_of_service_url": "https://brainseed-factory.com/law/terms_products/index.php", "publishe
uluscdn.com/v/t64.5771-25/75322598_1145165853836223_6864148320373849862_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SUC0X-qKrMMQ7kNvwFY4vu7&_nc_oc=AdrnvXfo_e7eBwHiH9SN1GfyigXHY8BBbBghPo30BXLdB7WA_6qCVaz2a1WGG0R31os&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwYGPwURhvo4IffK0HShJz93HN3PkZT0B_phbbSC98FRA&oe=69C667C3"}, {"file_name": "Screenshot03.png", "id": "598340872572801", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39001670_598340875906134_7078948835759736288_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i9dQgtfHg3EQ7kNvwEGajkO&_nc_oc=AdrUg1-H3U914yzQihSsOqjHVCMjsdjXxshQDvQD4qj-WwvrJlrPsasZn1wdjvn70iI&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxbsAz4zkeDU4S_95ZDL7U4lgaJ4R7tUvSyxDDAFFQIBQ&oe=69C665CB"}, {"file_name": "Screenshot06.png", "id": "970563445094246", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39031450_970563448427579_1896364834470325490_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PzWgm7oXRywQ7kNvwFRC-lM&_nc_oc=Adpm2Q17fwT5IP5R3bQFCexD2VQzBgfaEyVTP_22it6vaE6z4EJJzFm_w3mOD_rHTiE&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzYoLesur_TUqN9NygaU6JsxkVgw3T1sHJCqQDSVSNZBA&oe=69C68552"}, {"file_name": "Screenshot04.png", "id": "575729695062740", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39031400_575729698396073_2621336866475747103_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ybwdQ5hFsYAQ7kNvwHOp75Q&_nc_oc=AdoDsUnvVA_cKnSBWUoXmdH_IZfyLlopGVZqRplrJBQIZnGXa0vLUnHN-6rGZJuLFro&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afyb1wLd4i-Xzx2KrQo8p-WOvJdh383Yansg74Z7Dvmorw&oe=69C68C5C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Gameplay Trailer Thumb.png", "id": "605202028847932", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974836_605202032181265_2417977283558520499_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k0tLp6yk9U0Q7kNvwEDWCO-&_nc_oc=AdozDV7bac-XpXkAZa_bA0ZDA1iVRKby3qWE3Ui8vfY5aF3j26nayh1T5qmaAEVoURY&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Afy5vZzGNF6fP08u6326rvP36VDgBFverUDDQk2yiPRlgA&oe=69C69419"}, "display_name": "Squishies - Roll them Home!", "keywords": ["puzzle", "platformer", "sandbox", "exploration", "adventure"], "long_description": "**Get lost in the Squishies-verse!**\n\nSquishies is a head-scratching puzzle platformer where you guide courageous and cute creatures through a series of increasingly hazardous, challenging mazes. Use unique motion controls to push and pull the Squishies through their adventures in a colorful universe full of strange flora and fauna. Keep those little rascals safe while they climb, jump, fly and teleport-by-fish through dozens of levels in five alien worlds!\n\n{507625458961423}\n\nYou push and pull the Squishies from one side of the maze to the other, all while earning medals, gathering crystals, climbing slopes, and avoiding pitfalls.\n\n- **Explore a huge universe** - Across dozens of levels in five different worlds.\n- **Collectibles and Achievements** - Gather all the crystals, beat the clock or find the hidden egg in each level.\n- **Level Editor** - Squishies really comes into its own with its innovative, fully featured creation tools.\n- **Community Section** - Share your creation with others and play their ingenious levels.\n- **Limited play space?** Need to keep an eye on your own little monsters?  You\u2019re in luck. Squishies\u00ae can be played in the newly added Mixed Reality mode!\n\n\n{482757334822594}", "short_description": "Help the stranded Squishies find their way back home! Push and pull them through challenging puzzles, or create your own levels with the powerful in-game editor and share them with the community."}]}, "developer_name": null, "developer_privacy_policy_url": "https://brainseed-factory.com/law/privacy_products/index.php", "developer_terms_of_service_url": "https://brainseed-factory.com/law/terms_products/index.php", "publisher
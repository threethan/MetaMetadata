in2-2.oculuscdn.com/v/t64.5771-25/75322598_1145165853836223_6864148320373849862_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vY70XQaQxekQ7kNvwFzwIvb&_nc_oc=Adq5336x-2T8NSMenQXkMnEvYRT52gwJV53G-vh6OshC-_e1ilkcqqOWcpIHBb5F430&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-nUfV-bygY0fRbm7E0m4rSLaC-afoWu8H7NzihQL60pQ&oe=6A22E903"}, {"file_name": "Screenshot03.png", "id": "598340872572801", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/39001670_598340875906134_7078948835759736288_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h_1ns20e_ucQ7kNvwG14pC2&_nc_oc=AdqfJ6Tczcu44oEHq8zpnVrgBsSk6LBcjkw4zd2za1-rOtiaVu2H4rP4cIPnhPGs4y4&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8nH4LJsiF0tsDgiF7GUnPo65r47kAFMW5q2kzpioreBQ&oe=6A22E70B"}, {"file_name": "Screenshot06.png", "id": "970563445094246", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/39031450_970563448427579_1896364834470325490_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WBnmgILD7ogQ7kNvwELAXMu&_nc_oc=Ado_ahiXnoWmjQfhKJ_tghfRpYToOsVQLOSYESjv1wXosR7GxHUDmxx4noSWjBrbHQI&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-gRq8OWvdVPt5WxvIifulXAIQ1Ju0cTL3mFJIPVUKBZg&oe=6A22CE52"}, {"file_name": "Screenshot04.png", "id": "575729695062740", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/39031400_575729698396073_2621336866475747103_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qURt2Rgac6QQ7kNvwEzJnjY&_nc_oc=AdqfTvL2w6MWsIIGexnPbX7uPlDRqRBDjojg-M_aWRkHYWRAcvH99ssMI1lfd70Md3Q&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8gvlM1pYbCTaskMbN3UBtWIZRHczwSXIsC1tVeQgJZJg&oe=6A22D55C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Gameplay Trailer Thumb.png", "id": "605202028847932", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/38974836_605202032181265_2417977283558520499_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nfoKidnNvGIQ7kNvwGVzJCn&_nc_oc=AdrdiD-tJwwUqnIYz4YN1OJj4PGTJd-hlhPmOI5SCccIPXZEpHeyh-vhj4DVWeiqHNU&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_1oLhP21o0l1nZcX7O8i1tbQ8iK1hQ7oNUpKEQ_3bC4w&oe=6A22DD19"}, "display_name": "Squishies - Roll them Home!", "keywords": ["puzzle", "platformer", "sandbox", "exploration", "adventure"], "long_description": "**Get lost in the Squishies-verse!**\n\nSquishies is a head-scratching puzzle platformer where you guide courageous and cute creatures through a series of increasingly hazardous, challenging mazes. Use unique motion controls to push and pull the Squishies through their adventures in a colorful universe full of strange flora and fauna. Keep those little rascals safe while they climb, jump, fly and teleport-by-fish through dozens of levels in five alien worlds!\n\n{507625458961423}\n\nYou push and pull the Squishies from one side of the maze to the other, all while earning medals, gathering crystals, climbing slopes, and avoiding pitfalls.\n\n- **Explore a huge universe** - Across dozens of levels in five different worlds.\n- **Collectibles and Achievements** - Gather all the crystals, beat the clock or find the hidden egg in each level.\n- **Level Editor** - Squishies really comes into its own with its innovative, fully featured creation tools.\n- **Community Section** - Share your creation with others and play their ingenious levels.\n- **Limited play space?** Need to keep an eye on your own little monsters?  You\u2019re in luck. Squishies\u00ae can be played in the newly added Mixed Reality mode!\n\n\n{482757334822594}", "short_description": "Help the stranded Squishies find their way back home! Push and pull them through challenging puzzles, or create your own levels with the powerful in-game editor and share them with the community."}]}, "developer_name": null, "developer_privacy_policy_url": "https://brainseed-factory.com/law/privacy_products/index.php", "developer_terms_of_service_url": "https://brainseed-factory.com/law/terms_products/index.php"
culuscdn.com/v/t64.5771-25/75322598_1145165853836223_6864148320373849862_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rQhAtcDkpFYQ7kNvwFigW-A&_nc_oc=AdrjlRsi0u7OY9x8TcJOPPFXOXsDAFXgkpE_xqU6MSaQMYLOrLx0lYWdwZXTygr5IDI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE_CBVJI0BjREkm3mdI4zPa8NpwavbccuV9Re-bOcz4eQ&oe=6A75F783"}, {"file_name": "Screenshot03.png", "id": "598340872572801", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39001670_598340875906134_7078948835759736288_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aLV-Pz9GKdAQ7kNvwG6wVOf&_nc_oc=AdoLfkJzHMMSorEXBf7TKRmDejPyvIzn3TFt9UHdXLMXX5vNvjxuNlybULod9kbmMxo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQExJ_P1DpBWlV3llZTsRMagBh9BmfAdirIXVwTrj9Pqyg&oe=6A75F58B"}, {"file_name": "Screenshot06.png", "id": "970563445094246", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031450_970563448427579_1896364834470325490_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Mfmg4j1rCfIQ7kNvwGb88YO&_nc_oc=AdoHOj9QOjwQxZrKxx2qCiKgjnRjdPoBBBHLqSM2WDEMe50RlRNiIjrN2yOrhF3OTr4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGSYEVdWb8W1CQIeDaWe9cfEk6YKiVX0TJTzEQgnhJIOA&oe=6A75DCD2"}, {"file_name": "Screenshot04.png", "id": "575729695062740", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031400_575729698396073_2621336866475747103_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BFm9wC4qGGwQ7kNvwFDRxxd&_nc_oc=Adp8mRSVUpUzgMjA8xrzvmTsd057bmSPTyPta3lRwtm_hhPVrHX_JFVx7nO9-Tah8_s&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEGNg_hHl7ebsNaHpDYUqxDZeIwbP5gHQZsvvKRX9zhyQ&oe=6A75E3DC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Gameplay Trailer Thumb.png", "id": "605202028847932", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974836_605202032181265_2417977283558520499_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BQ4DhlhA8xkQ7kNvwHU2bK2&_nc_oc=Adqe-PTLUtbTS962m71ofFMv0McsPOXB7Fe8igkyDvekVSE46kxBfaXcyZGOg7bca0g&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHdI54o-GvMKGWsHH-ssajgkJxmxLdif_I-S3s7WnFAxg&oe=6A75EB99"}, "display_name": "Squishies - Roll them Home!", "keywords": ["puzzle", "platformer", "sandbox", "exploration", "adventure"], "long_description": "**Get lost in the Squishies-verse!**\n\nSquishies is a head-scratching puzzle platformer where you guide courageous and cute creatures through a series of increasingly hazardous, challenging mazes. Use unique motion controls to push and pull the Squishies through their adventures in a colorful universe full of strange flora and fauna. Keep those little rascals safe while they climb, jump, fly and teleport-by-fish through dozens of levels in five alien worlds!\n\n{507625458961423}\n\nYou push and pull the Squishies from one side of the maze to the other, all while earning medals, gathering crystals, climbing slopes, and avoiding pitfalls.\n\n- **Explore a huge universe** - Across dozens of levels in five different worlds.\n- **Collectibles and Achievements** - Gather all the crystals, beat the clock or find the hidden egg in each level.\n- **Level Editor** - Squishies really comes into its own with its innovative, fully featured creation tools.\n- **Community Section** - Share your creation with others and play their ingenious levels.\n- **Limited play space?** Need to keep an eye on your own little monsters?  You\u2019re in luck. Squishies\u00ae can be played in the newly added Mixed Reality mode!\n\n\n{482757334822594}", "short_description": "Help the stranded Squishies find their way back home! Push and pull them through challenging puzzles, or create your own levels with the powerful in-game editor and share them with the community."}]}, "developer_name": null, "developer_privacy_policy_url": "https://brainseed-factory.com/law/privacy_products/index.php", "developer_terms_of_service_url": "https://brainseed-factory.com/law/terms_products/index.php", "publishe
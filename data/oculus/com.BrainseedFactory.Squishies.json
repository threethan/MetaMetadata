culuscdn.com/v/t64.5771-25/75322598_1145165853836223_6864148320373849862_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6JLofxLaDDEQ7kNvwFQWDcw&_nc_oc=AdqXsQVrRmNHbIwVYzDrWO1mNSQLROvTeEAYUBCCJ62dxnjKv4KDaXOnKkz-uhT-tPs&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDYLbmdT6y9cuATHD6KFmblTlr_D0naS6b1TDJ2G7mBNg&oe=6A4BC783"}, {"file_name": "Screenshot03.png", "id": "598340872572801", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39001670_598340875906134_7078948835759736288_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E7BduReb1LAQ7kNvwEc5Y2y&_nc_oc=AdrnnZHPr5BdkA57j9yqwFmG4FousROgfzNYHov7W05tgb2Uv-q6RKZIFJ4tJ6BLYtU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDKxyQE1wT0RgLtCJWoHZqOBDV9ztojS3RuUXLXILRAsw&oe=6A4BC58B"}, {"file_name": "Screenshot06.png", "id": "970563445094246", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031450_970563448427579_1896364834470325490_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wNlQxfmNGB0Q7kNvwFItts2&_nc_oc=Adr6lTHT11cPswpzHa6jHdOUZR-BQlgoTGTJ5zvsy0-53cowEIIO7pv75_KXIIu2qXY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBXPF1f8ylsJ1p7vQGwMJwfs_shFgXHYMgDI6s-uZqL3Q&oe=6A4BACD2"}, {"file_name": "Screenshot04.png", "id": "575729695062740", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031400_575729698396073_2621336866475747103_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e0uhuaetfY0Q7kNvwHpLpnb&_nc_oc=AdpKPW1xUtFknfmkrADM5l_TVsPNem7JU0PDS9at9nWDRPYbNs3gV2eXdIEH59vdP6E&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDWUXMJn0ZghRSpNF-hXJ90HVmsXY3USSJjapZB1KqNQg&oe=6A4BB3DC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Gameplay Trailer Thumb.png", "id": "605202028847932", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974836_605202032181265_2417977283558520499_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4D1J1aEaI_AQ7kNvwF5PMcm&_nc_oc=Adoh0Me9Loe81bz3_VpxMdiJ8k9s2Ih4H27Ku1wfcUvnRBX8wtyKVMu9TBiF8eb80Bg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDKvSVa81pd-5xvdEp04LqvbbTpW6MyUXMyGJ9Vz8FCDA&oe=6A4BBB99"}, "display_name": "Squishies - Roll them Home!", "keywords": ["puzzle", "platformer", "sandbox", "exploration", "adventure"], "long_description": "**Get lost in the Squishies-verse!**\n\nSquishies is a head-scratching puzzle platformer where you guide courageous and cute creatures through a series of increasingly hazardous, challenging mazes. Use unique motion controls to push and pull the Squishies through their adventures in a colorful universe full of strange flora and fauna. Keep those little rascals safe while they climb, jump, fly and teleport-by-fish through dozens of levels in five alien worlds!\n\n{507625458961423}\n\nYou push and pull the Squishies from one side of the maze to the other, all while earning medals, gathering crystals, climbing slopes, and avoiding pitfalls.\n\n- **Explore a huge universe** - Across dozens of levels in five different worlds.\n- **Collectibles and Achievements** - Gather all the crystals, beat the clock or find the hidden egg in each level.\n- **Level Editor** - Squishies really comes into its own with its innovative, fully featured creation tools.\n- **Community Section** - Share your creation with others and play their ingenious levels.\n- **Limited play space?** Need to keep an eye on your own little monsters?  You\u2019re in luck. Squishies\u00ae can be played in the newly added Mixed Reality mode!\n\n\n{482757334822594}", "short_description": "Help the stranded Squishies find their way back home! Push and pull them through challenging puzzles, or create your own levels with the powerful in-game editor and share them with the community."}]}, "developer_name": null, "developer_privacy_policy_url": "https://brainseed-factory.com/law/privacy_products/index.php", "developer_terms_of_service_url": "https://brainseed-factory.com/law/terms_products/index.php", "publishe
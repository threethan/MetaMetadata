145165853836223_6864148320373849862_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WifI6mC194UQ7kNvwEkAYr6&_nc_oc=AdnEpMfMXdEtt7pNpsdeP9W_WA-h-3A7_gwoMtE7MvW3FrXUQ9_CGv71cic19zzi48s&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_Afxt-PUrvaNdJtaaM8OWb88tUJAWtE6Xscu-V0Rqcv5CLw&oe=69BE7EC3"}, {"file_name": "Screenshot03.png", "id": "598340872572801", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39001670_598340875906134_7078948835759736288_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SMLVk2hYuAoQ7kNvwEzrNaL&_nc_oc=AdkbNC7_1JeYZHtlP7IeJ0EvEJuGZm0eQS4yMLFCfpUPEv6cT5nPxPTa-ovZWdCD3XI&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfyoFGbBExIX3g3htlFAjikeUz2pCJPD-xY6V9luPIphZA&oe=69BE7CCB"}, {"file_name": "Screenshot06.png", "id": "970563445094246", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031450_970563448427579_1896364834470325490_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S0ew4uUG4uoQ7kNvwEuGLyY&_nc_oc=Adm9bwXViRolIdGNclnLnJTOkVkBv-NiaWQif5lVLxI7kldO6NUR9QzkLE1ge_bruw8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfyATxrYHoNIu7HkJqDT8rFDriqWQpWdSpo9EnPld-nEog&oe=69BE9C52"}, {"file_name": "Screenshot04.png", "id": "575729695062740", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39031400_575729698396073_2621336866475747103_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4xkD1J3zVfwQ7kNvwH8h5Qv&_nc_oc=AdmUh5y_UNj_or2uLzd2KMiTbEKZcCvZw7y5_OqhD974Iphoz7_W6-vr3s8-4Cvk6ck&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfzI-XvJJdvECqsapbvWpZ3O5NGdX2_C56CCGaM3YSqbow&oe=69BEA35C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Gameplay Trailer Thumb.png", "id": "605202028847932", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974836_605202032181265_2417977283558520499_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Vqqv9OpJJ4IQ7kNvwFZuz9j&_nc_oc=AdmSojOkhVjoToD9urVk9pwVxzLqNAAIQomdWv-kbGKwqYbFPLPj_CJQ3tIyWMZOo7Q&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfyXxNP79S3tfy1Kcm3ymalkBXkFm4kNvrg-nQoA6-3oew&oe=69BEAB19"}, "display_name": "Squishies - Roll them Home!", "keywords": ["puzzle", "platformer", "sandbox", "exploration", "adventure"], "long_description": "**Get lost in the Squishies-verse!**\n\nSquishies is a head-scratching puzzle platformer where you guide courageous and cute creatures through a series of increasingly hazardous, challenging mazes. Use unique motion controls to push and pull the Squishies through their adventures in a colorful universe full of strange flora and fauna. Keep those little rascals safe while they climb, jump, fly and teleport-by-fish through dozens of levels in five alien worlds!\n\n{507625458961423}\n\nYou push and pull the Squishies from one side of the maze to the other, all while earning medals, gathering crystals, climbing slopes, and avoiding pitfalls.\n\n- **Explore a huge universe** - Across dozens of levels in five different worlds.\n- **Collectibles and Achievements** - Gather all the crystals, beat the clock or find the hidden egg in each level.\n- **Level Editor** - Squishies really comes into its own with its innovative, fully featured creation tools.\n- **Community Section** - Share your creation with others and play their ingenious levels.\n- **Limited play space?** Need to keep an eye on your own little monsters?  You\u2019re in luck. Squishies\u00ae can be played in the newly added Mixed Reality mode!\n\n\n{482757334822594}", "short_description": "Help the stranded Squishies find their way back home! Push and pull them through challenging puzzles, or create your own levels with the powerful in-game editor and share them with the community."}]}, "developer_name": null, "developer_privacy_policy_url": "https://brainseed-factory.com/law/privacy_products/index.php", "developer_terms_of_service_url": "https://brainseed-factory.com/law/terms_products/index.php", "publisher_name": "Perp Games", "support_website_url": null, "webs
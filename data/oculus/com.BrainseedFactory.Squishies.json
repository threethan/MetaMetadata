sin2-2.oculuscdn.com/v/t64.5771-25/75322598_1145165853836223_6864148320373849862_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dD7BJAVxSXEQ7kNvwE7Ejym&_nc_oc=AdoGkwG9eTyOonFUas19-SV70mcp0YaaZ58zKTpRTwpNfC0qIJawuGjxQbemdTuqFgc&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJXQzBxzet2vHYS939WZKNBM6VgBY6EQOppcV5Wh73Ouw&oe=6AA96203"}, {"file_name": "Screenshot03.png", "id": "598340872572801", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/39001670_598340875906134_7078948835759736288_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1z-zYA6KHg0Q7kNvwEkn7FZ&_nc_oc=AdphH0jBOc852JIUvwh6O_UepjMSorJiebxtxf4RIREo8n3P-Gpwmcv6bBMJUQVDZ5s&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIVpweaN36HvVW02Ap0GWwNBakbNSav5xKPQPNrvf1L8w&oe=6AA9600B"}, {"file_name": "Screenshot06.png", "id": "970563445094246", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/39031450_970563448427579_1896364834470325490_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J8SocmB_6PgQ7kNvwFGyEf1&_nc_oc=AdrgQgUtgPFnylrTuwLst6WEZrRSVCreJma-ho_xnUZp0qvXaCkczR9ZNZBHcYm0jNQ&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLviVzReVmer6qAp-sWh1uR9fNdVayggsnsilN5Moq0Ag&oe=6AA94752"}, {"file_name": "Screenshot04.png", "id": "575729695062740", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/39031400_575729698396073_2621336866475747103_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lf2cCEsJ8EIQ7kNvwE_T7sG&_nc_oc=Ado2DKOBpKUw9IyJ1dL50Vh5QK9v6D3SQlDqCFx4Vqz3OL5YzCThC3f2cddhTYl-uYo&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIEob_AbwWdR3ZeAY0cvHO07iqDv77xQ8yPw9M3xdYiKA&oe=6AA94E5C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Gameplay Trailer Thumb.png", "id": "605202028847932", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/38974836_605202032181265_2417977283558520499_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V03h8oFdJCcQ7kNvwGwOqMb&_nc_oc=AdrI9E3QyhBp7KPZFKX5tWUQrEvB219Uu87_AgW_N0kqfN0SD5x3gw4UBQMKcYzxJwU&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL0C_N-uHCHZ9smV2YfqOgnSAttmKKoGFwa27tRT409xQ&oe=6AA95619"}, "display_name": "Squishies - Roll them Home!", "keywords": ["puzzle", "platformer", "sandbox", "exploration", "adventure"], "long_description": "**Get lost in the Squishies-verse!**\n\nSquishies is a head-scratching puzzle platformer where you guide courageous and cute creatures through a series of increasingly hazardous, challenging mazes. Use unique motion controls to push and pull the Squishies through their adventures in a colorful universe full of strange flora and fauna. Keep those little rascals safe while they climb, jump, fly and teleport-by-fish through dozens of levels in five alien worlds!\n\n{507625458961423}\n\nYou push and pull the Squishies from one side of the maze to the other, all while earning medals, gathering crystals, climbing slopes, and avoiding pitfalls.\n\n- **Explore a huge universe** - Across dozens of levels in five different worlds.\n- **Collectibles and Achievements** - Gather all the crystals, beat the clock or find the hidden egg in each level.\n- **Level Editor** - Squishies really comes into its own with its innovative, fully featured creation tools.\n- **Community Section** - Share your creation with others and play their ingenious levels.\n- **Limited play space?** Need to keep an eye on your own little monsters?  You\u2019re in luck. Squishies\u00ae can be played in the newly added Mixed Reality mode!\n\n\n{482757334822594}", "short_description": "Help the stranded Squishies find their way back home! Push and pull them through challenging puzzles, or create your own levels with the powerful in-game editor and share them with the community."}]}, "developer_name": null, "developer_privacy_policy_url": "https://brainseed-factory.com/law/privacy_products/index.php", "developer_terms_of_service_url": "https://brainseed-factory.com/law/terms_products/index.php
uluscdn.com/v/t64.5771-25/75322598_1145165853836223_6864148320373849862_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6tkjwhLmhGAQ7kNvwFjf5Ib&_nc_oc=AdrHCVdsF8wtyFFG84y3Ms5QI6ZN-xS5a6j1n2J62cngRrim-bQc74laPxbrF_3w0hk&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0auT65TfzX6aM06XEhwFKijpp7Myfqtc-vPTdaN56zPA&oe=69E64403"}, {"file_name": "Screenshot03.png", "id": "598340872572801", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39001670_598340875906134_7078948835759736288_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0QYXJlEwEToQ7kNvwHiGqto&_nc_oc=AdpVr3fGTRlFuZReNx7-oLam1ZRTt4pzNt97TrFbka8bJ3-Z9SLHXk6V8WAP_pO1WQ0&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3caSLdFLevpkDm0p3tZ9qC8SX7XqXfNYLyW0C7hKdhfg&oe=69E6420B"}, {"file_name": "Screenshot06.png", "id": "970563445094246", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/39031450_970563448427579_1896364834470325490_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gD1t-LDbUEsQ7kNvwGelmut&_nc_oc=AdqSEPSA6UcrBMEhfcN2HT5RrHsoVUIdkXSKuP0APK0NyeVWTD6FY1bUdXvw-Judj8Y&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3JMo9nstZMAtq84qYCYiJA0vp7yEK3BBd5CYO4KVHusA&oe=69E62952"}, {"file_name": "Screenshot04.png", "id": "575729695062740", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39031400_575729698396073_2621336866475747103_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZvTb7J_d4tUQ7kNvwG34mFS&_nc_oc=Adpo3u-UXrW92ACAKn6cGiQzcwB_pdRMna08YgIFH8Yl7SEuit7y8PdQ3I242hc6Gps&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2xCD3VAHjUeWIZupeXqsrQpF5iVEGhBNO3SecDARli_g&oe=69E6305C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Gameplay Trailer Thumb.png", "id": "605202028847932", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974836_605202032181265_2417977283558520499_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2_FmoQzT3pMQ7kNvwF_Xa0z&_nc_oc=AdqCgOzs-Q3JPSwxDO3-YGuhbKUmzUuqapHhaS41OKi2d0yxYUDymYfNseFdEtOe0R4&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1J8BoURqrkGGcDQylYfDtTsTORZBIVQGnIIDCoAoL2Pg&oe=69E63819"}, "display_name": "Squishies - Roll them Home!", "keywords": ["puzzle", "platformer", "sandbox", "exploration", "adventure"], "long_description": "**Get lost in the Squishies-verse!**\n\nSquishies is a head-scratching puzzle platformer where you guide courageous and cute creatures through a series of increasingly hazardous, challenging mazes. Use unique motion controls to push and pull the Squishies through their adventures in a colorful universe full of strange flora and fauna. Keep those little rascals safe while they climb, jump, fly and teleport-by-fish through dozens of levels in five alien worlds!\n\n{507625458961423}\n\nYou push and pull the Squishies from one side of the maze to the other, all while earning medals, gathering crystals, climbing slopes, and avoiding pitfalls.\n\n- **Explore a huge universe** - Across dozens of levels in five different worlds.\n- **Collectibles and Achievements** - Gather all the crystals, beat the clock or find the hidden egg in each level.\n- **Level Editor** - Squishies really comes into its own with its innovative, fully featured creation tools.\n- **Community Section** - Share your creation with others and play their ingenious levels.\n- **Limited play space?** Need to keep an eye on your own little monsters?  You\u2019re in luck. Squishies\u00ae can be played in the newly added Mixed Reality mode!\n\n\n{482757334822594}", "short_description": "Help the stranded Squishies find their way back home! Push and pull them through challenging puzzles, or create your own levels with the powerful in-game editor and share them with the community."}]}, "developer_name": null, "developer_privacy_policy_url": "https://brainseed-factory.com/law/privacy_products/index.php", "developer_terms_of_service_url": "https://brainseed-factory.com/law/terms_products/index.php", "publisher
culuscdn.com/v/t64.5771-25/75322598_1145165853836223_6864148320373849862_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7mctNxdniAUQ7kNvwG1naGt&_nc_oc=AdrrEtRyruyLgJ5TlDgl0Nlsd2_BI0bKWPhwsx87ySiIYDqsuI9McUyAltWyMT79GnA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJY7AOqVFG5V6tL66_5HWMDJPQvfC626jY7d7_qrO5Fmw&oe=6AAC0503"}, {"file_name": "Screenshot03.png", "id": "598340872572801", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39001670_598340875906134_7078948835759736288_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LF0l75xtAPUQ7kNvwGus27a&_nc_oc=Adoy2XAvixa2K1txOEqriDYxROdMA8-8kcjZA2oCDaR-Pi0Qpbwdl7rSfiLKwwZpXmo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLDJuQzXnpHBGscGDNdC2SpkPvLRHmXcdXrQL_paPwDGg&oe=6AAC030B"}, {"file_name": "Screenshot06.png", "id": "970563445094246", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031450_970563448427579_1896364834470325490_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NkT-0ldAuPAQ7kNvwEtpjA_&_nc_oc=Adr4-IDPm9Z8AweEQVk1Z2KkCnlvPZTQCSOQ5gJKX7qJ0jkKJD0A4uqKVupvTmXFGbg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIuR4QGvLjc2PhKXGXOQBiMb5cmIahQ3m-aD5nV1QF61g&oe=6AABEA52"}, {"file_name": "Screenshot04.png", "id": "575729695062740", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031400_575729698396073_2621336866475747103_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KBlwuqOVtWMQ7kNvwFVHBBl&_nc_oc=AdqEIBwXW_vDlAq23ILnTHwTJEiMo_QRQKGYShsXm3E1-HspUk0vHTpVBUTvv3kGNVk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK-1oOTx-uAqWFAWx8uOg9FUwL9p4Cgb3QHtGmv8sDGIw&oe=6AABF15C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Gameplay Trailer Thumb.png", "id": "605202028847932", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974836_605202032181265_2417977283558520499_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yKSzwAkYkxIQ7kNvwG_Aepq&_nc_oc=AdoMhqJocPWxn5Pg1YlaI6DDVbAnQWIPWfSpYzbaqP0hvSsPLlsDsoy71fYgNlOhu6o&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJLcXStk4mMXGgg3Vui6ooKnQ7cOA5sALM9hJIdyOIV8g&oe=6AABF919"}, "display_name": "Squishies - Roll them Home!", "keywords": ["puzzle", "platformer", "sandbox", "exploration", "adventure"], "long_description": "**Get lost in the Squishies-verse!**\n\nSquishies is a head-scratching puzzle platformer where you guide courageous and cute creatures through a series of increasingly hazardous, challenging mazes. Use unique motion controls to push and pull the Squishies through their adventures in a colorful universe full of strange flora and fauna. Keep those little rascals safe while they climb, jump, fly and teleport-by-fish through dozens of levels in five alien worlds!\n\n{507625458961423}\n\nYou push and pull the Squishies from one side of the maze to the other, all while earning medals, gathering crystals, climbing slopes, and avoiding pitfalls.\n\n- **Explore a huge universe** - Across dozens of levels in five different worlds.\n- **Collectibles and Achievements** - Gather all the crystals, beat the clock or find the hidden egg in each level.\n- **Level Editor** - Squishies really comes into its own with its innovative, fully featured creation tools.\n- **Community Section** - Share your creation with others and play their ingenious levels.\n- **Limited play space?** Need to keep an eye on your own little monsters?  You\u2019re in luck. Squishies\u00ae can be played in the newly added Mixed Reality mode!\n\n\n{482757334822594}", "short_description": "Help the stranded Squishies find their way back home! Push and pull them through challenging puzzles, or create your own levels with the powerful in-game editor and share them with the community."}]}, "developer_name": null, "developer_privacy_policy_url": "https://brainseed-factory.com/law/privacy_products/index.php", "developer_terms_of_service_url": "https://brainseed-factory.com/law/terms_products/index.php", "publishe
uluscdn.com/v/t64.5771-25/75322598_1145165853836223_6864148320373849862_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=X_Z0-ybMHa0Q7kNvwHo1Adk&_nc_oc=AdoircGMNRRtDdKlMjmuqkzJe7X0wTVlfNgBkmI1A34Qv2N1aFH9JeZuz9_CM7gS6Zk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7E0J23FdPiakcJVY_s3cuYDyBczJbMeuyeJv4JBSfxrA&oe=6A034503"}, {"file_name": "Screenshot03.png", "id": "598340872572801", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39001670_598340875906134_7078948835759736288_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bn6jR7si-1AQ7kNvwEVyqes&_nc_oc=AdqLcqlGQhqTw_NyFSn2RRq0-KGMpi_p6hwGYIlBpcEe-LrHxLjteRfcQcYs4AG_9qU&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5Wh1qpChsYKQHe-wY1vwHPEiDTQm96qKl_oIcpn0SAdw&oe=6A03430B"}, {"file_name": "Screenshot06.png", "id": "970563445094246", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031450_970563448427579_1896364834470325490_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gA-Bw4ihh78Q7kNvwFQF_ND&_nc_oc=AdqflnJJyBrMa5VCjqnhwlEWpahcT9ln94Pvjw0Aau3EEhr5GzWEV24lAnX7q3yZUes&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5f9zcxAOfXgRWzVlAdFN-7SufNxSIozqiq6_Lxio9rGw&oe=6A032A52"}, {"file_name": "Screenshot04.png", "id": "575729695062740", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031400_575729698396073_2621336866475747103_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kJD17OkGUWgQ7kNvwF__Zfh&_nc_oc=AdqPvh-nxxKCkIZ0pH2y67HFS9LfBcCclMAPbbrOs9Cld_qqSxsimaRowv-C1tttOZA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7RxaRi9FXfx16IzO7cUZIyRv8Pj8koFeC-tzyaCxKk1g&oe=6A03315C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Gameplay Trailer Thumb.png", "id": "605202028847932", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974836_605202032181265_2417977283558520499_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6aFspVEfQtAQ7kNvwFS-R-Z&_nc_oc=AdrPQQ_rTjRKqLAtDM-EVhZ12X90Dn7pR3TNcVgEchSYygoc-E63HRd-Ev6rG3ndYz8&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5uw6SJ5XWfkuPpgabIrp6Ayu3Y592IUY_wV7rg53wLhw&oe=6A033919"}, "display_name": "Squishies - Roll them Home!", "keywords": ["puzzle", "platformer", "sandbox", "exploration", "adventure"], "long_description": "**Get lost in the Squishies-verse!**\n\nSquishies is a head-scratching puzzle platformer where you guide courageous and cute creatures through a series of increasingly hazardous, challenging mazes. Use unique motion controls to push and pull the Squishies through their adventures in a colorful universe full of strange flora and fauna. Keep those little rascals safe while they climb, jump, fly and teleport-by-fish through dozens of levels in five alien worlds!\n\n{507625458961423}\n\nYou push and pull the Squishies from one side of the maze to the other, all while earning medals, gathering crystals, climbing slopes, and avoiding pitfalls.\n\n- **Explore a huge universe** - Across dozens of levels in five different worlds.\n- **Collectibles and Achievements** - Gather all the crystals, beat the clock or find the hidden egg in each level.\n- **Level Editor** - Squishies really comes into its own with its innovative, fully featured creation tools.\n- **Community Section** - Share your creation with others and play their ingenious levels.\n- **Limited play space?** Need to keep an eye on your own little monsters?  You\u2019re in luck. Squishies\u00ae can be played in the newly added Mixed Reality mode!\n\n\n{482757334822594}", "short_description": "Help the stranded Squishies find their way back home! Push and pull them through challenging puzzles, or create your own levels with the powerful in-game editor and share them with the community."}]}, "developer_name": null, "developer_privacy_policy_url": "https://brainseed-factory.com/law/privacy_products/index.php", "developer_terms_of_service_url": "https://brainseed-factory.com/law/terms_products/index.php", "publisher
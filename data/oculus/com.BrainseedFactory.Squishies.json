culuscdn.com/v/t64.5771-25/75322598_1145165853836223_6864148320373849862_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0I542oXWqPwQ7kNvwHfGcko&_nc_oc=AdqAw66Q6JtvtRJ4PmD-YjdWxJY29yqDPnRWJx4C8arF95h2Vp5xfBfngFhpDhtlzFM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ5KJlC6aQ5Qx0ZyrmeEwE-s7r--f6xX7kJmy7g7lT0CA&oe=6A9C3303"}, {"file_name": "Screenshot03.png", "id": "598340872572801", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39001670_598340875906134_7078948835759736288_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kAGe4_KWY9YQ7kNvwG63Rtl&_nc_oc=Ado_THkXb_J89gm3lM_ArVOcV3rRjFGFxKXTqYgViEfptCVHI4Io7rBFrac-Jfv5hlw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIp9pIO_ruH3QrHjIrHVN0OMa2IB3ivP5zZXlmMJcK01w&oe=6A9C310B"}, {"file_name": "Screenshot06.png", "id": "970563445094246", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031450_970563448427579_1896364834470325490_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=79f0oSvwuXMQ7kNvwG5APj8&_nc_oc=Adpl7d5rxCJxyR1YzOaf3G9kHmOlC4VDguHiZioLsI3N0nnGus8QgBAdL70FQ0wuynM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLonvnQOpFwbueMm6N1IotyD43ImbKCwW4T-QKPVaSYXQ&oe=6A9C1852"}, {"file_name": "Screenshot04.png", "id": "575729695062740", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031400_575729698396073_2621336866475747103_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aCaz9xa6RXAQ7kNvwFxiQtz&_nc_oc=Ado9SZORcWPbowrLNyR71w7TD6VAHcK_VInPULQsbcT4p8c8TudWvrfm4Uoi348sqr0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLuaCZjUsdj6DkKKpG5j_O6NuonImME5Sl-rPjEl9A7ZA&oe=6A9C1F5C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Gameplay Trailer Thumb.png", "id": "605202028847932", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974836_605202032181265_2417977283558520499_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9P1jXruX1WUQ7kNvwH9JsCy&_nc_oc=Adrc-dvL2L0Ue8shoxQlTkGg4BDP1cQ-2ZJpxoZMwWWbruMqltqKAja-D4kdEiTP6Tc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ8OLgMrxtMn_eCD2ptRz2BARlI7G2HwRmKUkk4dae68g&oe=6A9C2719"}, "display_name": "Squishies - Roll them Home!", "keywords": ["puzzle", "platformer", "sandbox", "exploration", "adventure"], "long_description": "**Get lost in the Squishies-verse!**\n\nSquishies is a head-scratching puzzle platformer where you guide courageous and cute creatures through a series of increasingly hazardous, challenging mazes. Use unique motion controls to push and pull the Squishies through their adventures in a colorful universe full of strange flora and fauna. Keep those little rascals safe while they climb, jump, fly and teleport-by-fish through dozens of levels in five alien worlds!\n\n{507625458961423}\n\nYou push and pull the Squishies from one side of the maze to the other, all while earning medals, gathering crystals, climbing slopes, and avoiding pitfalls.\n\n- **Explore a huge universe** - Across dozens of levels in five different worlds.\n- **Collectibles and Achievements** - Gather all the crystals, beat the clock or find the hidden egg in each level.\n- **Level Editor** - Squishies really comes into its own with its innovative, fully featured creation tools.\n- **Community Section** - Share your creation with others and play their ingenious levels.\n- **Limited play space?** Need to keep an eye on your own little monsters?  You\u2019re in luck. Squishies\u00ae can be played in the newly added Mixed Reality mode!\n\n\n{482757334822594}", "short_description": "Help the stranded Squishies find their way back home! Push and pull them through challenging puzzles, or create your own levels with the powerful in-game editor and share them with the community."}]}, "developer_name": null, "developer_privacy_policy_url": "https://brainseed-factory.com/law/privacy_products/index.php", "developer_terms_of_service_url": "https://brainseed-factory.com/law/terms_products/index.php", "publishe
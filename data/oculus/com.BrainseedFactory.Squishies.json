culuscdn.com/v/t64.5771-25/75322598_1145165853836223_6864148320373849862_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bikVnaO7HIYQ7kNvwEbW7t2&_nc_oc=AdoifI1V0qqnm0U-3Q99m40vcohBA3H4R8u-uZ9Es2K7p735shu_c6uQ8YMT8f1tYeY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFs5AW6xvZakrjaGEfSy_ZF_rlYF3wmzmCYtYWnXmpP5A&oe=6A7C56C3"}, {"file_name": "Screenshot03.png", "id": "598340872572801", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39001670_598340875906134_7078948835759736288_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8pUiPsO3aC0Q7kNvwEp_4l_&_nc_oc=Ado6_r13KIiDVftBv11U7dtiwdfhs5BQLOrl6WLEKn5cBlpWCHhk9063E2mQBPl6AcY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGvCqq6EmqBhbKwcqygIlcarbm7PUhuiSvGvegkqUogwA&oe=6A7C54CB"}, {"file_name": "Screenshot06.png", "id": "970563445094246", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031450_970563448427579_1896364834470325490_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Yuik2GonodwQ7kNvwERs_9f&_nc_oc=Adra7lh9mnJyK11tlZBb_0lFHJ8jw1OcmP5xGLihD8o5Wehvu3G7tcgvJ1fiV3kQRcI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEYLUOrJ6PYJzfx42898VrUabVxBIlAt7VJY7tgerkjQg&oe=6A7C7452"}, {"file_name": "Screenshot04.png", "id": "575729695062740", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031400_575729698396073_2621336866475747103_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Efr1llHfE8wQ7kNvwFiXvhX&_nc_oc=AdqIQAWfe3Pahz4OJl-ZLMlpazdT3H1pOP-aDEew4IUy1rjUfAJuPJpJb6esIjdfr-0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHmRPibcuhIXoUnOqckyg6D7kbW03LCLk2rcarMTa0rDg&oe=6A7C7B5C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Gameplay Trailer Thumb.png", "id": "605202028847932", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974836_605202032181265_2417977283558520499_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I_wFZ3tZBNcQ7kNvwF6ao8Z&_nc_oc=AdrQ9dG9WCBLrv7j4i_yduWw4ZNoBvkeGzXs6Ed8o0dUqScA8wxBEfgKJRShXFLuaeU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHv_bzYDAEHx8VXvgkpkp7w6__0nuVhe0CmGIOwOBp6JA&oe=6A7C4AD9"}, "display_name": "Squishies - Roll them Home!", "keywords": ["puzzle", "platformer", "sandbox", "exploration", "adventure"], "long_description": "**Get lost in the Squishies-verse!**\n\nSquishies is a head-scratching puzzle platformer where you guide courageous and cute creatures through a series of increasingly hazardous, challenging mazes. Use unique motion controls to push and pull the Squishies through their adventures in a colorful universe full of strange flora and fauna. Keep those little rascals safe while they climb, jump, fly and teleport-by-fish through dozens of levels in five alien worlds!\n\n{507625458961423}\n\nYou push and pull the Squishies from one side of the maze to the other, all while earning medals, gathering crystals, climbing slopes, and avoiding pitfalls.\n\n- **Explore a huge universe** - Across dozens of levels in five different worlds.\n- **Collectibles and Achievements** - Gather all the crystals, beat the clock or find the hidden egg in each level.\n- **Level Editor** - Squishies really comes into its own with its innovative, fully featured creation tools.\n- **Community Section** - Share your creation with others and play their ingenious levels.\n- **Limited play space?** Need to keep an eye on your own little monsters?  You\u2019re in luck. Squishies\u00ae can be played in the newly added Mixed Reality mode!\n\n\n{482757334822594}", "short_description": "Help the stranded Squishies find their way back home! Push and pull them through challenging puzzles, or create your own levels with the powerful in-game editor and share them with the community."}]}, "developer_name": null, "developer_privacy_policy_url": "https://brainseed-factory.com/law/privacy_products/index.php", "developer_terms_of_service_url": "https://brainseed-factory.com/law/terms_products/index.php", "publishe
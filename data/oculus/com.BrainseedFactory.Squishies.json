uluscdn.com/v/t64.5771-25/75322598_1145165853836223_6864148320373849862_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3iP0J-agoNsQ7kNvwGLv8IO&_nc_oc=Adp1NFOKtH7sOCKsotstEFzb92ijgCT_V-SAgWp57uOE7MTg6hm-rf8z9_suQg3gZi4&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9j_8qkS4PLIBz0baLb9wfmG4e3U6C_LtBNLl4C-6wYtA&oe=6A2AD203"}, {"file_name": "Screenshot03.png", "id": "598340872572801", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39001670_598340875906134_7078948835759736288_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MbBC6PGQam8Q7kNvwGNjj3S&_nc_oc=Adp8irWYbq9-eb6qW9G3rQ-KqKtoVA9WOAf1GE3fxyN7bpvmlrGMl75YkfP4DPjMLL0&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9Bo_aTLemetF2TtE7DxGLzJyBeg1EN0ujv_8PizrRn9w&oe=6A2AD00B"}, {"file_name": "Screenshot06.png", "id": "970563445094246", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031450_970563448427579_1896364834470325490_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F7uSYb96vFsQ7kNvwHmlYkF&_nc_oc=AdqIqtjzu3fURLaUxRw_-lLNuPcYLHG0MgN6Q_pzWVbSta8r6Pil0XbSmRjJmL4W4HM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-MAyXVpnF6WRj4S96cZJR7pHiqUf6-d1wvKSBMYKo-Bg&oe=6A2AB752"}, {"file_name": "Screenshot04.png", "id": "575729695062740", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39031400_575729698396073_2621336866475747103_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wiuBIqf5UxIQ7kNvwH0lvp6&_nc_oc=Ado0ci_kuyPxVq8F4nZkRHAO6zTQllONqBsTZJpgUP9SVvG6MHVp2AwLoC17ilyaSKo&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8KRS_0CFAwjTKxPiniCmz-vVKsvxUhU6kLwccFTyip2A&oe=6A2ABE5C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Gameplay Trailer Thumb.png", "id": "605202028847932", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974836_605202032181265_2417977283558520499_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ES5IOSdmXvQQ7kNvwHf88J6&_nc_oc=Ado8tYdEguVMBQBXUuXh7CCgwQpdfSMm6NVVp39qPZDt5sXnFAt0gF15gQ2EE3pakFs&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9_BrOyL52UaFtj8vpbHHRVPfeqgNXRlCpXIqUF5SafzA&oe=6A2AC619"}, "display_name": "Squishies - Roll them Home!", "keywords": ["puzzle", "platformer", "sandbox", "exploration", "adventure"], "long_description": "**Get lost in the Squishies-verse!**\n\nSquishies is a head-scratching puzzle platformer where you guide courageous and cute creatures through a series of increasingly hazardous, challenging mazes. Use unique motion controls to push and pull the Squishies through their adventures in a colorful universe full of strange flora and fauna. Keep those little rascals safe while they climb, jump, fly and teleport-by-fish through dozens of levels in five alien worlds!\n\n{507625458961423}\n\nYou push and pull the Squishies from one side of the maze to the other, all while earning medals, gathering crystals, climbing slopes, and avoiding pitfalls.\n\n- **Explore a huge universe** - Across dozens of levels in five different worlds.\n- **Collectibles and Achievements** - Gather all the crystals, beat the clock or find the hidden egg in each level.\n- **Level Editor** - Squishies really comes into its own with its innovative, fully featured creation tools.\n- **Community Section** - Share your creation with others and play their ingenious levels.\n- **Limited play space?** Need to keep an eye on your own little monsters?  You\u2019re in luck. Squishies\u00ae can be played in the newly added Mixed Reality mode!\n\n\n{482757334822594}", "short_description": "Help the stranded Squishies find their way back home! Push and pull them through challenging puzzles, or create your own levels with the powerful in-game editor and share them with the community."}]}, "developer_name": null, "developer_privacy_policy_url": "https://brainseed-factory.com/law/privacy_products/index.php", "developer_terms_of_service_url": "https://brainseed-factory.com/law/terms_products/index.php", "publisher
uluscdn.com/v/t64.5771-25/75322598_1145165853836223_6864148320373849862_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a5oPEzDWeL8Q7kNvwG_efl1&_nc_oc=AdrCfmJ29MctxjkOBa93HISHC3Mj2Da6PzNuiKrpSmJH1o8jQ1SwyAHnpLeEkY16BcA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4kW1hxzsw-p5No7875hkBFZlnUoxVV5VwWZkWrXmw4ug&oe=6A00A203"}, {"file_name": "Screenshot03.png", "id": "598340872572801", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39001670_598340875906134_7078948835759736288_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Xbb90TTmqmYQ7kNvwE6m-Hw&_nc_oc=AdoRmG9LEwM-KRJ7R-t-vo4QaFzc_H4eEXXUNoN0uaX0AYpsU0mZSHavjYa77hUySF0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af565spXCeE-NvAJyzk3kaxtlGPNkehFb6A1aNW2mdyuJQ&oe=6A00A00B"}, {"file_name": "Screenshot06.png", "id": "970563445094246", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031450_970563448427579_1896364834470325490_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2QbdD1YjzLwQ7kNvwHX50II&_nc_oc=AdoiiazrN_gooyY_Niud2d3Mou9KxJJh8k1c4xSXs7ZUyxgblGfkCqfj9Mz7PwewQkU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7FqH5cxAH1XNqEtEmRz5a4vTArjDK_AR0i3YYbWFNyXg&oe=6A008752"}, {"file_name": "Screenshot04.png", "id": "575729695062740", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031400_575729698396073_2621336866475747103_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BpqyI8cQ108Q7kNvwHScPEs&_nc_oc=Adq_aijM0nhrTQGVUOctEz7a871WTzbSNVjIVIa_pvK-xrnG-fOJ5Z8wrbdmZ5W7_WY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7XM5NWE2QYrgOX6TF1Ef9GQu9XU2YVKh4Y0rPQVYaMXg&oe=6A008E5C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Gameplay Trailer Thumb.png", "id": "605202028847932", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974836_605202032181265_2417977283558520499_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6aFspVEfQtAQ7kNvwGhHoYj&_nc_oc=AdrAjGAiqaYDkq4Okh1wmRxVBSpBJXsCfRWMO6BAFvhI3oaUvZ2AYCFmSt-J2f4_3zU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af77a2Q5siY5N_UsBdSh3Xg7m_iLbZece2yHbypOLnLiNw&oe=6A009619"}, "display_name": "Squishies - Roll them Home!", "keywords": ["puzzle", "platformer", "sandbox", "exploration", "adventure"], "long_description": "**Get lost in the Squishies-verse!**\n\nSquishies is a head-scratching puzzle platformer where you guide courageous and cute creatures through a series of increasingly hazardous, challenging mazes. Use unique motion controls to push and pull the Squishies through their adventures in a colorful universe full of strange flora and fauna. Keep those little rascals safe while they climb, jump, fly and teleport-by-fish through dozens of levels in five alien worlds!\n\n{507625458961423}\n\nYou push and pull the Squishies from one side of the maze to the other, all while earning medals, gathering crystals, climbing slopes, and avoiding pitfalls.\n\n- **Explore a huge universe** - Across dozens of levels in five different worlds.\n- **Collectibles and Achievements** - Gather all the crystals, beat the clock or find the hidden egg in each level.\n- **Level Editor** - Squishies really comes into its own with its innovative, fully featured creation tools.\n- **Community Section** - Share your creation with others and play their ingenious levels.\n- **Limited play space?** Need to keep an eye on your own little monsters?  You\u2019re in luck. Squishies\u00ae can be played in the newly added Mixed Reality mode!\n\n\n{482757334822594}", "short_description": "Help the stranded Squishies find their way back home! Push and pull them through challenging puzzles, or create your own levels with the powerful in-game editor and share them with the community."}]}, "developer_name": null, "developer_privacy_policy_url": "https://brainseed-factory.com/law/privacy_products/index.php", "developer_terms_of_service_url": "https://brainseed-factory.com/law/terms_products/index.php", "publisher
culuscdn.com/v/t64.5771-25/75322598_1145165853836223_6864148320373849862_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vdWsBKBtrGsQ7kNvwE6osZK&_nc_oc=AdrtmDldoU9nqiFK_1VPgqQonVLYQjJH2jC5kOHN33SBkKblbhjUFItLrxwRbaslFKk&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBIqGRMf_kB8xBw9lCkbPRgk-EDVENXeS8rLI0RT9o1Iw&oe=6A623103"}, {"file_name": "Screenshot03.png", "id": "598340872572801", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39001670_598340875906134_7078948835759736288_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7jW925hcEqsQ7kNvwGdQnMr&_nc_oc=AdoWV2pU0C6epHWDckKpA3CtI_RaClEQdTaNHBNochBVM8kYw_a_T64n0V11Pvp1Ums&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCZDRKSi3oNdBh50osLb8m5_P8J86WVQmxyq7FXbtbZVA&oe=6A622F0B"}, {"file_name": "Screenshot06.png", "id": "970563445094246", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031450_970563448427579_1896364834470325490_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e1jKndgo4cgQ7kNvwG1k-kD&_nc_oc=AdqOtjCB9Xhd2OUzRgsuhhclpfMIcIO2mjHC-Mn8-ls-KK_ZyxUl-VD5pnmMareCpIQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAsyc_8-D2RMmzgamTvNOb8oB-81o91oAv927oDwWRTUg&oe=6A621652"}, {"file_name": "Screenshot04.png", "id": "575729695062740", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39031400_575729698396073_2621336866475747103_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dlJxBgKCmIoQ7kNvwFPZxM_&_nc_oc=Adp-ioYBhfylpwRYFwDtpTb3482GHWsc9PW0j73oSYmKF49MzRK-6LGa9BCKNHh0SYY&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCHxtefU0_B1q2yUSq5Vy9kHrw3-IFk5r5LdJXLpoAZDg&oe=6A621D5C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Gameplay Trailer Thumb.png", "id": "605202028847932", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974836_605202032181265_2417977283558520499_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=keR9OnDQH2cQ7kNvwHXETJP&_nc_oc=AdpgSRt_hVlAsLXNor0Sv-gzv5w4yLNk9PK3hGJp7ogwsL2l-Zn9u1kAat5JLaEzyAw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA_HDRFP3bBjtVQWPdX30Q4sRz1G-ahgwqzLNY0bGPPkQ&oe=6A622519"}, "display_name": "Squishies - Roll them Home!", "keywords": ["puzzle", "platformer", "sandbox", "exploration", "adventure"], "long_description": "**Get lost in the Squishies-verse!**\n\nSquishies is a head-scratching puzzle platformer where you guide courageous and cute creatures through a series of increasingly hazardous, challenging mazes. Use unique motion controls to push and pull the Squishies through their adventures in a colorful universe full of strange flora and fauna. Keep those little rascals safe while they climb, jump, fly and teleport-by-fish through dozens of levels in five alien worlds!\n\n{507625458961423}\n\nYou push and pull the Squishies from one side of the maze to the other, all while earning medals, gathering crystals, climbing slopes, and avoiding pitfalls.\n\n- **Explore a huge universe** - Across dozens of levels in five different worlds.\n- **Collectibles and Achievements** - Gather all the crystals, beat the clock or find the hidden egg in each level.\n- **Level Editor** - Squishies really comes into its own with its innovative, fully featured creation tools.\n- **Community Section** - Share your creation with others and play their ingenious levels.\n- **Limited play space?** Need to keep an eye on your own little monsters?  You\u2019re in luck. Squishies\u00ae can be played in the newly added Mixed Reality mode!\n\n\n{482757334822594}", "short_description": "Help the stranded Squishies find their way back home! Push and pull them through challenging puzzles, or create your own levels with the powerful in-game editor and share them with the community."}]}, "developer_name": null, "developer_privacy_policy_url": "https://brainseed-factory.com/law/privacy_products/index.php", "developer_terms_of_service_url": "https://brainseed-factory.com/law/terms_products/index.php", "publishe
culuscdn.com/v/t64.5771-25/75322598_1145165853836223_6864148320373849862_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xS4LkZUD6c0Q7kNvwFvns4f&_nc_oc=Adp44pKtyn227JYHm4RtZFd_KbFKOlY22djhr5u-dRMX9DIDSTFj8SgZqW-83cDrfKw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHXW6_rUjssr4PPVbqodGf5Ijgy_EqarC8J7-pmqb0XPw&oe=6A8C28C3"}, {"file_name": "Screenshot03.png", "id": "598340872572801", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39001670_598340875906134_7078948835759736288_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qLj1qCKcPfkQ7kNvwEU0Yoo&_nc_oc=Adqb9z59e3sNd6xgWb7ks9KXA4p2VqqJEv0SU37gxL3HwBvJQSV3xxoiihRmmy5_Qmw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEwQDcxiJ3Hy6GII4vxGcsVUZZ4YpNYsgCHoz-FIORKBQ&oe=6A8C26CB"}, {"file_name": "Screenshot06.png", "id": "970563445094246", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031450_970563448427579_1896364834470325490_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f3NWNwmDJTgQ7kNvwFnMxWB&_nc_oc=AdoImU8cuWP8-dX8mrMMHzSJfdA81d5UEiVNExtaIICDjmwS-hMfcjQvhK7IW-c48WM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEdnu_0y8O40mBWDGlPZQnvitQ-fvQsJR5f45x6HlFTPg&oe=6A8C4652"}, {"file_name": "Screenshot04.png", "id": "575729695062740", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031400_575729698396073_2621336866475747103_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5K3wm761ljcQ7kNvwFOpEAM&_nc_oc=AdpJs4f_es3fzFK7-O0OedYzXugCZXj07ad3lj3q018mrYilN4VmwEpYFT06lyWuHMU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFj3H9Yw9v4RFMRsRfUOwk2cAMR4DSryQSra8LoHvgq9Q&oe=6A8C151C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Gameplay Trailer Thumb.png", "id": "605202028847932", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974836_605202032181265_2417977283558520499_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TGKccyzxmdQQ7kNvwFlzd0I&_nc_oc=Ado8GS4GXyljSgcu6UTY0Ap-NunXp9bBmR5BxPJheozTOk__dd55rcDehxBYujW9Yl4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFgXGrVos2waXoVoUMzaLpCu2SaLOf9sdCw8UeWbd7dtA&oe=6A8C1CD9"}, "display_name": "Squishies - Roll them Home!", "keywords": ["puzzle", "platformer", "sandbox", "exploration", "adventure"], "long_description": "**Get lost in the Squishies-verse!**\n\nSquishies is a head-scratching puzzle platformer where you guide courageous and cute creatures through a series of increasingly hazardous, challenging mazes. Use unique motion controls to push and pull the Squishies through their adventures in a colorful universe full of strange flora and fauna. Keep those little rascals safe while they climb, jump, fly and teleport-by-fish through dozens of levels in five alien worlds!\n\n{507625458961423}\n\nYou push and pull the Squishies from one side of the maze to the other, all while earning medals, gathering crystals, climbing slopes, and avoiding pitfalls.\n\n- **Explore a huge universe** - Across dozens of levels in five different worlds.\n- **Collectibles and Achievements** - Gather all the crystals, beat the clock or find the hidden egg in each level.\n- **Level Editor** - Squishies really comes into its own with its innovative, fully featured creation tools.\n- **Community Section** - Share your creation with others and play their ingenious levels.\n- **Limited play space?** Need to keep an eye on your own little monsters?  You\u2019re in luck. Squishies\u00ae can be played in the newly added Mixed Reality mode!\n\n\n{482757334822594}", "short_description": "Help the stranded Squishies find their way back home! Push and pull them through challenging puzzles, or create your own levels with the powerful in-game editor and share them with the community."}]}, "developer_name": null, "developer_privacy_policy_url": "https://brainseed-factory.com/law/privacy_products/index.php", "developer_terms_of_service_url": "https://brainseed-factory.com/law/terms_products/index.php", "publishe
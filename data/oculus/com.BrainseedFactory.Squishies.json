uluscdn.com/v/t64.5771-25/75322598_1145165853836223_6864148320373849862_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4vwAtX2kYsQQ7kNvwHVJUCi&_nc_oc=AdoRgpvgdsnRcyDSZT3tzX0eXn4jBQLl_zLjD7bCyATvQv4Q1Km1BOcvCDkW97X6HP0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2bLeDsoKqoj7SG5Fo0cOVUgo_yxCv6ANo5-5-BH4Cb7A&oe=69D8DCC3"}, {"file_name": "Screenshot03.png", "id": "598340872572801", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39001670_598340875906134_7078948835759736288_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OhaqS-WKFHYQ7kNvwE6-D5w&_nc_oc=AdrItl6b9gIBQA4_yTY_jx7KffxBDdhGEeu8kYuUOj_6VJvT60VJarKwaMRc-wUVXm4&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0PGVZDSvr-_F_ggrNK4UhqN9Mn1YrDC4FYcQ2nou4Otg&oe=69D8DACB"}, {"file_name": "Screenshot06.png", "id": "970563445094246", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031450_970563448427579_1896364834470325490_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rmuhkYMRqBUQ7kNvwHy0-S_&_nc_oc=AdpIA2n0iLY07SO3D-9vjXWnH8NZbNsmSu5QSpkYDUWgxW81IbXOaQWm3c38zO2PflY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0O9Xj46YCl0EqJaIEk6_FMbezaiU2KrvNjaFVjsI2CHw&oe=69D8FA52"}, {"file_name": "Screenshot04.png", "id": "575729695062740", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031400_575729698396073_2621336866475747103_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_nP-97NGhn8Q7kNvwFYm9eP&_nc_oc=AdqfzYAjpXApNNwDeUmWUOJ6QlAfOM6WScsC_becPIo1UbrlqlCjYd16ov9xBKV9idM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3-6NgqVDi4Ki40aEYAf5ApFqjxOvtIeFIljFrMVDoWFA&oe=69D9015C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Gameplay Trailer Thumb.png", "id": "605202028847932", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974836_605202032181265_2417977283558520499_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a-RdZnEtOJYQ7kNvwEYuuHC&_nc_oc=Adp8cDDnqE1raZzzTfglAq_NexWOO5gcSSZJd0uqlpcOXSCndiJWeBHL6hW2J7O2l5I&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2116jz4xKQjn2C5QClOP_Gl4YzBRuow_P4L3PstVijNA&oe=69D90919"}, "display_name": "Squishies - Roll them Home!", "keywords": ["puzzle", "platformer", "sandbox", "exploration", "adventure"], "long_description": "**Get lost in the Squishies-verse!**\n\nSquishies is a head-scratching puzzle platformer where you guide courageous and cute creatures through a series of increasingly hazardous, challenging mazes. Use unique motion controls to push and pull the Squishies through their adventures in a colorful universe full of strange flora and fauna. Keep those little rascals safe while they climb, jump, fly and teleport-by-fish through dozens of levels in five alien worlds!\n\n{507625458961423}\n\nYou push and pull the Squishies from one side of the maze to the other, all while earning medals, gathering crystals, climbing slopes, and avoiding pitfalls.\n\n- **Explore a huge universe** - Across dozens of levels in five different worlds.\n- **Collectibles and Achievements** - Gather all the crystals, beat the clock or find the hidden egg in each level.\n- **Level Editor** - Squishies really comes into its own with its innovative, fully featured creation tools.\n- **Community Section** - Share your creation with others and play their ingenious levels.\n- **Limited play space?** Need to keep an eye on your own little monsters?  You\u2019re in luck. Squishies\u00ae can be played in the newly added Mixed Reality mode!\n\n\n{482757334822594}", "short_description": "Help the stranded Squishies find their way back home! Push and pull them through challenging puzzles, or create your own levels with the powerful in-game editor and share them with the community."}]}, "developer_name": null, "developer_privacy_policy_url": "https://brainseed-factory.com/law/privacy_products/index.php", "developer_terms_of_service_url": "https://brainseed-factory.com/law/terms_products/index.php", "publisher
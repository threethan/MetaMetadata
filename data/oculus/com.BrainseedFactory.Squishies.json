322598_1145165853836223_6864148320373849862_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pfaEVdro-X0Q7kNvwFZfJy_&_nc_oc=AdmiVHyN4Yx8eK5SxPz9_KER2unop8HHwJZqlH7qdp5ZZ8ybX-AUADRAm4eVipGdVLQ&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=8&oh=00_AfxRc-7zeO2xoLvyRZoepbFwF8FJCO_G2K0H4Xci45euAw&oe=69AAB843"}, {"file_name": "Screenshot03.png", "id": "598340872572801", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/39001670_598340875906134_7078948835759736288_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0J7x4hkshRcQ7kNvwFgjcrh&_nc_oc=AdkJudUMiEn2uv-NM8nNZPThTZqubp1Yumw7hLjXUtEI03L_MWqi0jLjJ6gbiKFurb8&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=8&oh=00_AfzYBmCJ12uMByQEPYOgB21WgCZ9YLzQ2gqpTfDJgP2LIA&oe=69AAB64B"}, {"file_name": "Screenshot06.png", "id": "970563445094246", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/39031450_970563448427579_1896364834470325490_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZC1O70VgIR4Q7kNvwFe5dB8&_nc_oc=AdleviwJvYmYxnYhd6jQU8yKaeglIuIl6kwwCgY-ocCSGwwhyesBTZSdHXnq1lGi02c&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=8&oh=00_AfyFF7w2admVq00l-Ut__y-h0ghWnyBxQ86PqPut9qxw-w&oe=69AAD5D2"}, {"file_name": "Screenshot04.png", "id": "575729695062740", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/39031400_575729698396073_2621336866475747103_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AdINWNzAG7YQ7kNvwGIe0lZ&_nc_oc=AdlUoy2L1GhqxyTxqlGmmu_b_KF00WrZY-Dwh9bSBkUoAJj8JY3NEOaeSTdfrASRUJ4&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=8&oh=00_AfzMH9sowCVbzY1ImHqZLnpGaDIwnQEZGZTJqVehMAK2_w&oe=69AADCDC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Gameplay Trailer Thumb.png", "id": "605202028847932", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/38974836_605202032181265_2417977283558520499_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VH6J-z2d5L0Q7kNvwE3jOmZ&_nc_oc=AdnuLReDzSmmiDpC9EnZBIr20reMeZMjy5hI-RH2C9gT31agxlNuCoMysCOGzkiQiFk&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=8&oh=00_Afw0q5pj-V_JNEqnG04d8VWnm9xlSyBhS9fgj3dihcJkqg&oe=69AAE499"}, "display_name": "Squishies - Roll them Home!", "keywords": ["puzzle", "platformer", "sandbox", "exploration", "adventure"], "long_description": "**Get lost in the Squishies-verse!**\n\nSquishies is a head-scratching puzzle platformer where you guide courageous and cute creatures through a series of increasingly hazardous, challenging mazes. Use unique motion controls to push and pull the Squishies through their adventures in a colorful universe full of strange flora and fauna. Keep those little rascals safe while they climb, jump, fly and teleport-by-fish through dozens of levels in five alien worlds!\n\n{507625458961423}\n\nYou push and pull the Squishies from one side of the maze to the other, all while earning medals, gathering crystals, climbing slopes, and avoiding pitfalls.\n\n- **Explore a huge universe** - Across dozens of levels in five different worlds.\n- **Collectibles and Achievements** - Gather all the crystals, beat the clock or find the hidden egg in each level.\n- **Level Editor** - Squishies really comes into its own with its innovative, fully featured creation tools.\n- **Community Section** - Share your creation with others and play their ingenious levels.\n- **Limited play space?** Need to keep an eye on your own little monsters?  You\u2019re in luck. Squishies\u00ae can be played in the newly added Mixed Reality mode!\n\n\n{482757334822594}", "short_description": "Help the stranded Squishies find their way back home! Push and pull them through challenging puzzles, or create your own levels with the powerful in-game editor and share them with the community."}]}, "developer_name": null, "developer_privacy_policy_url": "https://brainseed-factory.com/law/privacy_products/index.php", "developer_terms_of_service_url": "https://brainseed-factory.com/law/terms_products/index.php", "publisher_name": "Perp Games", "support_website_url":
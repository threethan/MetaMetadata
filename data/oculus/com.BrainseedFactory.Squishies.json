uluscdn.com/v/t64.5771-25/75322598_1145165853836223_6864148320373849862_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a5oPEzDWeL8Q7kNvwEPJxKK&_nc_oc=AdrWheE0qGigJ4XhWo_Y-50R83u1bZjw4C3oj8ixiXqjjVG3VhPKk86T09NYxiAn_gk&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7rLxJh4UENlZyi-mebxZ4jZSvUXXu9YmNV1ZO1Obv3XQ&oe=69FDFF03"}, {"file_name": "Screenshot03.png", "id": "598340872572801", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39001670_598340875906134_7078948835759736288_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Xbb90TTmqmYQ7kNvwG-QPO5&_nc_oc=AdqtqWdn6onmHuZjD7lSFQhSl-C3nWuVZSDyJR8axZ3OXq27s4At4HnrDJe51Yn-Dfo&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7Y1HcCDuKLgoWETP3632MmnithWV39miPljCvk4liNlw&oe=69FDFD0B"}, {"file_name": "Screenshot06.png", "id": "970563445094246", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/39031450_970563448427579_1896364834470325490_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2QbdD1YjzLwQ7kNvwFo3igl&_nc_oc=AdqxWlHWT4NukiuKJjMco4e_J_Ri0nLy90p11he5FNUOZTvs6_MMFLfhER0ebgqCOLM&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5BcEMQPc3r3CL1tKbQP5RBvTeGMfc0TvXxoWO3B60Csg&oe=69FDE452"}, {"file_name": "Screenshot04.png", "id": "575729695062740", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39031400_575729698396073_2621336866475747103_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BpqyI8cQ108Q7kNvwGue31_&_nc_oc=AdqEL7br8CWyrTX_cUqFbAHRWUvYkGNucdZunU_HeXnnZBUGg8LPfHO_ipd52AqTrzo&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5kCnT7V4F9Q11EDlFaarVtx3vJYIlmm2sgmUPXT8D5FA&oe=69FDEB5C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Gameplay Trailer Thumb.png", "id": "605202028847932", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974836_605202032181265_2417977283558520499_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tx5x7IJgb6AQ7kNvwFLf7FH&_nc_oc=AdppBUFpAUyrwyfC2LIvwFp5TfVJ3n9oxdXcabRmcnoxA_P2nUKWVYqg34nHPXla5Vg&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5kexxt6HoRYCofZwt2OzGZvw9ts-bUfI02z2uGsJgGng&oe=69FDF319"}, "display_name": "Squishies - Roll them Home!", "keywords": ["puzzle", "platformer", "sandbox", "exploration", "adventure"], "long_description": "**Get lost in the Squishies-verse!**\n\nSquishies is a head-scratching puzzle platformer where you guide courageous and cute creatures through a series of increasingly hazardous, challenging mazes. Use unique motion controls to push and pull the Squishies through their adventures in a colorful universe full of strange flora and fauna. Keep those little rascals safe while they climb, jump, fly and teleport-by-fish through dozens of levels in five alien worlds!\n\n{507625458961423}\n\nYou push and pull the Squishies from one side of the maze to the other, all while earning medals, gathering crystals, climbing slopes, and avoiding pitfalls.\n\n- **Explore a huge universe** - Across dozens of levels in five different worlds.\n- **Collectibles and Achievements** - Gather all the crystals, beat the clock or find the hidden egg in each level.\n- **Level Editor** - Squishies really comes into its own with its innovative, fully featured creation tools.\n- **Community Section** - Share your creation with others and play their ingenious levels.\n- **Limited play space?** Need to keep an eye on your own little monsters?  You\u2019re in luck. Squishies\u00ae can be played in the newly added Mixed Reality mode!\n\n\n{482757334822594}", "short_description": "Help the stranded Squishies find their way back home! Push and pull them through challenging puzzles, or create your own levels with the powerful in-game editor and share them with the community."}]}, "developer_name": null, "developer_privacy_policy_url": "https://brainseed-factory.com/law/privacy_products/index.php", "developer_terms_of_service_url": "https://brainseed-factory.com/law/terms_products/index.php", "publisher
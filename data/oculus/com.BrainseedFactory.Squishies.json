uluscdn.com/v/t64.5771-25/75322598_1145165853836223_6864148320373849862_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uhbN5SYs_R4Q7kNvwFn5dAD&_nc_oc=AdrMuBRE4h61RtF1EAxdzSVoHwCLzV11Bg9ImHqLS17dNz8oVF7Yl1gOmx_gWcw08Rc&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4FLfq6Nm2EGeEcqE0eJ6ykWtW_HSkSSzRgLkGor4kZkA&oe=6A170B83"}, {"file_name": "Screenshot03.png", "id": "598340872572801", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39001670_598340875906134_7078948835759736288_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IA7MxBsLqi8Q7kNvwHb5RQb&_nc_oc=AdrpNKbhnGenv3ukWkuRDn0kAxtqQR7X9xWf8VxAniEC4-UsBNbokvaysvHzV0UChWA&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7wQKHltVa5u2mG1bs0xG-1yZ0W3cdxzQ8Lzw37Wk1L6g&oe=6A17098B"}, {"file_name": "Screenshot06.png", "id": "970563445094246", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39031450_970563448427579_1896364834470325490_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l4j8BbqG3LQQ7kNvwE9hZYr&_nc_oc=Adq72HOHay0zc39Yi9Itahf028CuSJM_aeC9Hv3lPJi8aIkgcbdLWNxDxmR9tYVY6ps&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4WvcDaWcy1I3juFKaYnDuf_rBG2fVcfr7_rTmCD_GXmg&oe=6A16F0D2"}, {"file_name": "Screenshot04.png", "id": "575729695062740", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39031400_575729698396073_2621336866475747103_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VxMvvHMl79IQ7kNvwE3XgKN&_nc_oc=AdrGzu3FtLyVsO4z6H7PUjMDR46CmMk1gxV_uMRJAeUdAEXoM58RjyESjJrtNSZOOpw&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af77dlDHPHdtH_0k_kBxpfn0NiEqLtv93TOJ9Nzdsnh97Q&oe=6A16F7DC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Gameplay Trailer Thumb.png", "id": "605202028847932", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974836_605202032181265_2417977283558520499_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GU8uRmORS6QQ7kNvwFpiv6o&_nc_oc=Adpnrk-FCEIPqAsDnBHg2yUbvbvUfh00Jc-66INSv-ZbvESVft6pIVgBGR0d8rv2Bz0&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4u3anTqijPjbE6pPrq3Eal5frAO13Z8x6jSKQ7Xghamw&oe=6A16FF99"}, "display_name": "Squishies - Roll them Home!", "keywords": ["puzzle", "platformer", "sandbox", "exploration", "adventure"], "long_description": "**Get lost in the Squishies-verse!**\n\nSquishies is a head-scratching puzzle platformer where you guide courageous and cute creatures through a series of increasingly hazardous, challenging mazes. Use unique motion controls to push and pull the Squishies through their adventures in a colorful universe full of strange flora and fauna. Keep those little rascals safe while they climb, jump, fly and teleport-by-fish through dozens of levels in five alien worlds!\n\n{507625458961423}\n\nYou push and pull the Squishies from one side of the maze to the other, all while earning medals, gathering crystals, climbing slopes, and avoiding pitfalls.\n\n- **Explore a huge universe** - Across dozens of levels in five different worlds.\n- **Collectibles and Achievements** - Gather all the crystals, beat the clock or find the hidden egg in each level.\n- **Level Editor** - Squishies really comes into its own with its innovative, fully featured creation tools.\n- **Community Section** - Share your creation with others and play their ingenious levels.\n- **Limited play space?** Need to keep an eye on your own little monsters?  You\u2019re in luck. Squishies\u00ae can be played in the newly added Mixed Reality mode!\n\n\n{482757334822594}", "short_description": "Help the stranded Squishies find their way back home! Push and pull them through challenging puzzles, or create your own levels with the powerful in-game editor and share them with the community."}]}, "developer_name": null, "developer_privacy_policy_url": "https://brainseed-factory.com/law/privacy_products/index.php", "developer_terms_of_service_url": "https://brainseed-factory.com/law/terms_products/index.php", "publisher
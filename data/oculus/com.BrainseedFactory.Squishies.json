uluscdn.com/v/t64.5771-25/75322598_1145165853836223_6864148320373849862_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cm0Vyk3De-kQ7kNvwH24ZCB&_nc_oc=AdqsnLbIfOSUhVwWfLao8EXQUnxXkA5ew0igz2krQfKB9fDdeLc1kQuPMaIizL0dhEA&_nc_zt=3&_nc_ht=scontent-lhr8-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5kuAV5I7BCNrPQMwg5Y_lHhgv_yb8f5CY0yxbzMzoPTA&oe=6A107403"}, {"file_name": "Screenshot03.png", "id": "598340872572801", "uri": "https://scontent-lhr8-2.oculuscdn.com/v/t64.5771-25/39001670_598340875906134_7078948835759736288_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xA0iNNeg_YMQ7kNvwFTOUWL&_nc_oc=AdrjEIsPyGmyXgmpmwuA4WhyMVAZ_M5l9SZxiNqg6I7GtpCzRbSUbDmaVps98z9klrk&_nc_zt=3&_nc_ht=scontent-lhr8-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6jiDGdVXCyVBJBVIvNKm80c5J7WY72_SNNgxaflxhZ1A&oe=6A10720B"}, {"file_name": "Screenshot06.png", "id": "970563445094246", "uri": "https://scontent-lhr8-1.oculuscdn.com/v/t64.5771-25/39031450_970563448427579_1896364834470325490_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-5eKnnlfdmQQ7kNvwE6hNoz&_nc_oc=AdrhCOw-DGvxpTwaR7Nld3v-fpZGb9VkfPCJQusMESLJiKwvfCTcHfVd-jcuvGP7NNY&_nc_zt=3&_nc_ht=scontent-lhr8-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5RUMVXclAJtTYZh8wXp7_9yk2Cgw4bMm8tQwIpFqhsBA&oe=6A105952"}, {"file_name": "Screenshot04.png", "id": "575729695062740", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/39031400_575729698396073_2621336866475747103_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9-JIJSe21uUQ7kNvwE4lbhg&_nc_oc=AdpPGxpcHJGV3mlYnhIpDNHivjiZAQKfSnntpz4dyk7B4b68ZCIcb2h3FQxKFWUJgdc&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6YINuBQGEQev0-z0T_CWwNCBWm7TqMhBg4U-SGDdB03Q&oe=6A10605C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Gameplay Trailer Thumb.png", "id": "605202028847932", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/38974836_605202032181265_2417977283558520499_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AK_9Pb0_DcAQ7kNvwHLLJD8&_nc_oc=Adon196-OSaa6fxAieMvLnwV-RRVIbIj31yXvVLBuFCXdMW9LeqeACFbBqoPJbPocnQ&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4__F8Wacm08jePdMPMWk2lqYoINB9q6apmRUMqlN83aQ&oe=6A106819"}, "display_name": "Squishies - Roll them Home!", "keywords": ["puzzle", "platformer", "sandbox", "exploration", "adventure"], "long_description": "**Get lost in the Squishies-verse!**\n\nSquishies is a head-scratching puzzle platformer where you guide courageous and cute creatures through a series of increasingly hazardous, challenging mazes. Use unique motion controls to push and pull the Squishies through their adventures in a colorful universe full of strange flora and fauna. Keep those little rascals safe while they climb, jump, fly and teleport-by-fish through dozens of levels in five alien worlds!\n\n{507625458961423}\n\nYou push and pull the Squishies from one side of the maze to the other, all while earning medals, gathering crystals, climbing slopes, and avoiding pitfalls.\n\n- **Explore a huge universe** - Across dozens of levels in five different worlds.\n- **Collectibles and Achievements** - Gather all the crystals, beat the clock or find the hidden egg in each level.\n- **Level Editor** - Squishies really comes into its own with its innovative, fully featured creation tools.\n- **Community Section** - Share your creation with others and play their ingenious levels.\n- **Limited play space?** Need to keep an eye on your own little monsters?  You\u2019re in luck. Squishies\u00ae can be played in the newly added Mixed Reality mode!\n\n\n{482757334822594}", "short_description": "Help the stranded Squishies find their way back home! Push and pull them through challenging puzzles, or create your own levels with the powerful in-game editor and share them with the community."}]}, "developer_name": null, "developer_privacy_policy_url": "https://brainseed-factory.com/law/privacy_products/index.php", "developer_terms_of_service_url": "https://brainseed-factory.com/law/terms_products/index.php", "publisher
uluscdn.com/v/t64.5771-25/75322598_1145165853836223_6864148320373849862_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tLtUgsUHcNwQ7kNvwEYaGR1&_nc_oc=AdrVPlPU1MRe0QV9yTeGkwm9NPrxkptlRBYkg35NFplvsqlj3IAqkbL6DKgpY_JiB5I&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfytAaYIgBKT_iPlsmw-9uszGyYBGjn4CXJjE14oWp7Isw&oe=69D0F3C3"}, {"file_name": "Screenshot03.png", "id": "598340872572801", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39001670_598340875906134_7078948835759736288_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bVocKCG3FzcQ7kNvwH_uYmO&_nc_oc=Adqj8up7xpWE6EOnuGTj9bQwtxoUMNoSvCxBKVJu75JNI2eBBed8lkghA56gByrddMk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afw5MTjGkz5Q6bIWOx_aRrW0VMp001k7oV3lBSE2ndgwsQ&oe=69D0F1CB"}, {"file_name": "Screenshot06.png", "id": "970563445094246", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031450_970563448427579_1896364834470325490_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5B0NtDz82f0Q7kNvwFAbIFD&_nc_oc=Adr5baRtOOr3bRuJu07al0DO_Y5Xcqp9Hgey4qbB34All3mhOs9kdaX4y8T8Q639vDA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afye9S435f6YiEL2usRr1qlnHX2mCJorVVCP_1ski-mn2A&oe=69D11152"}, {"file_name": "Screenshot04.png", "id": "575729695062740", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031400_575729698396073_2621336866475747103_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zvUCgvEAD4AQ7kNvwHkbRPR&_nc_oc=AdoE4yLrV_VHjIcYbKLNcs_4lbEjPZNHOyAKtRxi9Krm1kpCeNV05FTlDrJViSIhFdg&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzUyAL0do5TBv8tAgz1zZVb5ztpGUgvJsrGOvI8Askc7w&oe=69D1185C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Gameplay Trailer Thumb.png", "id": "605202028847932", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974836_605202032181265_2417977283558520499_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ji3PZ4IEe1cQ7kNvwGgdGFD&_nc_oc=AdonY9K5qfa-7CEfpkwbxuqCB7HpUOxPw3MHCbt3hN4EzJZA60F9I-a9p4LGzhALDO0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwNalBCFeIkKUWlyHF2QPTcGAxp5L-oWFGYpyLiaqajhQ&oe=69D12019"}, "display_name": "Squishies - Roll them Home!", "keywords": ["puzzle", "platformer", "sandbox", "exploration", "adventure"], "long_description": "**Get lost in the Squishies-verse!**\n\nSquishies is a head-scratching puzzle platformer where you guide courageous and cute creatures through a series of increasingly hazardous, challenging mazes. Use unique motion controls to push and pull the Squishies through their adventures in a colorful universe full of strange flora and fauna. Keep those little rascals safe while they climb, jump, fly and teleport-by-fish through dozens of levels in five alien worlds!\n\n{507625458961423}\n\nYou push and pull the Squishies from one side of the maze to the other, all while earning medals, gathering crystals, climbing slopes, and avoiding pitfalls.\n\n- **Explore a huge universe** - Across dozens of levels in five different worlds.\n- **Collectibles and Achievements** - Gather all the crystals, beat the clock or find the hidden egg in each level.\n- **Level Editor** - Squishies really comes into its own with its innovative, fully featured creation tools.\n- **Community Section** - Share your creation with others and play their ingenious levels.\n- **Limited play space?** Need to keep an eye on your own little monsters?  You\u2019re in luck. Squishies\u00ae can be played in the newly added Mixed Reality mode!\n\n\n{482757334822594}", "short_description": "Help the stranded Squishies find their way back home! Push and pull them through challenging puzzles, or create your own levels with the powerful in-game editor and share them with the community."}]}, "developer_name": null, "developer_privacy_policy_url": "https://brainseed-factory.com/law/privacy_products/index.php", "developer_terms_of_service_url": "https://brainseed-factory.com/law/terms_products/index.php", "publisher
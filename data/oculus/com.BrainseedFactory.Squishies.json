culuscdn.com/v/t64.5771-25/75322598_1145165853836223_6864148320373849862_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vy3PMFwOXxAQ7kNvwFvHSJp&_nc_oc=AdqpPMJw8-1b4xhbWrjImy0VfE80DoJQkfsiGaV3l7CNbuofovoA10y9-VtM_z2IImM&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK_uPGD045Isjzj7GQNPfsjc2oVZXJvtMIqJDOmloFHRg&oe=6AA56D83"}, {"file_name": "Screenshot03.png", "id": "598340872572801", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39001670_598340875906134_7078948835759736288_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Nd78cNXGNHAQ7kNvwFJKfJe&_nc_oc=Adqw2wVYdFVwBFekBRUyZQBW6zOQdEHq8c-2RMKsbc_IQ_ViT-oHpzpUHTo-_XmLWBs&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKEJIYlsIbnlVUtaYqrqR3ArfUoM0BfkNEYBLM4JJoUwg&oe=6AA56B8B"}, {"file_name": "Screenshot06.png", "id": "970563445094246", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031450_970563448427579_1896364834470325490_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P7gWDs82Bg4Q7kNvwFOJMD4&_nc_oc=Ado2Tf-Gm0hUSUID3-o0l_FlHy0BWICTAC6lqqucIgEWp-M2C9dItQUFXVWo_htX-lo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL0X6UEvkkFNe-gZ_JqARfbo6QaMJGQud-fCkmTiIP4lA&oe=6AA552D2"}, {"file_name": "Screenshot04.png", "id": "575729695062740", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39031400_575729698396073_2621336866475747103_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=t3knfBtI0ckQ7kNvwF9NIEo&_nc_oc=Adq8HEeUUv4ggw5qUcEsun4FILPvamOkfWel8GCQdahVV1dgpmkjIbiaoIHP9-Zsy34&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ8yIqkzXzYeHVDMI1UuP-sUGmazXLdadYK_-w1P0F4OA&oe=6AA559DC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Gameplay Trailer Thumb.png", "id": "605202028847932", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974836_605202032181265_2417977283558520499_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P9u0HDOtY28Q7kNvwFysmo6&_nc_oc=AdoFeTWw85q26LV7me2LoRuxbcADH1-zFg9dN7VqmtWlhVkt-DQJawoer-OU2BXyTtE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKMIXzSIdlgOBrk7dfTkhdgPCbaxrh841T_94qDJHoakw&oe=6AA56199"}, "display_name": "Squishies - Roll them Home!", "keywords": ["puzzle", "platformer", "sandbox", "exploration", "adventure"], "long_description": "**Get lost in the Squishies-verse!**\n\nSquishies is a head-scratching puzzle platformer where you guide courageous and cute creatures through a series of increasingly hazardous, challenging mazes. Use unique motion controls to push and pull the Squishies through their adventures in a colorful universe full of strange flora and fauna. Keep those little rascals safe while they climb, jump, fly and teleport-by-fish through dozens of levels in five alien worlds!\n\n{507625458961423}\n\nYou push and pull the Squishies from one side of the maze to the other, all while earning medals, gathering crystals, climbing slopes, and avoiding pitfalls.\n\n- **Explore a huge universe** - Across dozens of levels in five different worlds.\n- **Collectibles and Achievements** - Gather all the crystals, beat the clock or find the hidden egg in each level.\n- **Level Editor** - Squishies really comes into its own with its innovative, fully featured creation tools.\n- **Community Section** - Share your creation with others and play their ingenious levels.\n- **Limited play space?** Need to keep an eye on your own little monsters?  You\u2019re in luck. Squishies\u00ae can be played in the newly added Mixed Reality mode!\n\n\n{482757334822594}", "short_description": "Help the stranded Squishies find their way back home! Push and pull them through challenging puzzles, or create your own levels with the powerful in-game editor and share them with the community."}]}, "developer_name": null, "developer_privacy_policy_url": "https://brainseed-factory.com/law/privacy_products/index.php", "developer_terms_of_service_url": "https://brainseed-factory.com/law/terms_products/index.php", "publishe
culuscdn.com/v/t64.5771-25/75322598_1145165853836223_6864148320373849862_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7mctNxdniAUQ7kNvwGqCjKc&_nc_oc=AdqPXPVc0NYlaFlpt9G3OWJbSMm-D-PK-hR35VJNFcgn7OOTsNTCHm65eQByq1zSneQ&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLl8--GFCQjRaPzYPvHnzxflXArk40GL-gY8iSRPdFnjw&oe=6AAD5683"}, {"file_name": "Screenshot03.png", "id": "598340872572801", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39001670_598340875906134_7078948835759736288_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LF0l75xtAPUQ7kNvwHDjhdc&_nc_oc=AdrRRKuSd9tqnNDvTn7vGFMjXYEBbZQ1URS-YXi2NJRHGsFqCFMnxvunQVHwrCRUFjQ&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKsJnzXDlqKRY-Bvi8gq6adeSKqfdsRK1pJiTR1Ep16Rw&oe=6AAD548B"}, {"file_name": "Screenshot06.png", "id": "970563445094246", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39031450_970563448427579_1896364834470325490_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NkT-0ldAuPAQ7kNvwE1fjl3&_nc_oc=Adp3WM4savzh9tBlXrd68btCm0JXto5em9OkZbZ9VpZ2ertVQLP9WfTONjwJEh3J0F4&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIL5q4g9EgKM_bIW4xDrAJLkntF_M9iLHHZ3DpaOl0ewQ&oe=6AAD3BD2"}, {"file_name": "Screenshot04.png", "id": "575729695062740", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39031400_575729698396073_2621336866475747103_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KBlwuqOVtWMQ7kNvwEu6m0-&_nc_oc=Adpy4ox3GSncfgq4yIrQjdLoZUcScf5X7UMEuBhIrXFUkdLpyOlIHlY0uxvUeie0UoI&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKAuQ05I6JIiAQSSOP8mRn5flKXsu22pDp4FQTNDDyJXQ&oe=6AAD42DC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Gameplay Trailer Thumb.png", "id": "605202028847932", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974836_605202032181265_2417977283558520499_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yKSzwAkYkxIQ7kNvwGF_n81&_nc_oc=AdpCFDDeDaQsWSlsaFpV5pAM7qpL_Aerguci4GTLywpf_L31zuukTjWdFu23w-uxK2c&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKNgpvTS173SuD9PDKndZbVJpIa3Ma1_6jeB6iNTUgfoQ&oe=6AAD4A99"}, "display_name": "Squishies - Roll them Home!", "keywords": ["puzzle", "platformer", "sandbox", "exploration", "adventure"], "long_description": "**Get lost in the Squishies-verse!**\n\nSquishies is a head-scratching puzzle platformer where you guide courageous and cute creatures through a series of increasingly hazardous, challenging mazes. Use unique motion controls to push and pull the Squishies through their adventures in a colorful universe full of strange flora and fauna. Keep those little rascals safe while they climb, jump, fly and teleport-by-fish through dozens of levels in five alien worlds!\n\n{507625458961423}\n\nYou push and pull the Squishies from one side of the maze to the other, all while earning medals, gathering crystals, climbing slopes, and avoiding pitfalls.\n\n- **Explore a huge universe** - Across dozens of levels in five different worlds.\n- **Collectibles and Achievements** - Gather all the crystals, beat the clock or find the hidden egg in each level.\n- **Level Editor** - Squishies really comes into its own with its innovative, fully featured creation tools.\n- **Community Section** - Share your creation with others and play their ingenious levels.\n- **Limited play space?** Need to keep an eye on your own little monsters?  You\u2019re in luck. Squishies\u00ae can be played in the newly added Mixed Reality mode!\n\n\n{482757334822594}", "short_description": "Help the stranded Squishies find their way back home! Push and pull them through challenging puzzles, or create your own levels with the powerful in-game editor and share them with the community."}]}, "developer_name": null, "developer_privacy_policy_url": "https://brainseed-factory.com/law/privacy_products/index.php", "developer_terms_of_service_url": "https://brainseed-factory.com/law/terms_products/index.php", "publishe
culuscdn.com/v/t64.5771-25/75322598_1145165853836223_6864148320373849862_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZoEZFXMHo0QQ7kNvwGs23cN&_nc_oc=Adq9mMSp1TJMQaVPFpYx5C6Kj_JdZ82wfrRji8FHuPYhbMRCVUYdncYlafz9dtiHDbs&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFMboO9kbh4ch86egC-FFR-xYQGP7hCUIEJRerBWhprNQ&oe=6A9411C3"}, {"file_name": "Screenshot03.png", "id": "598340872572801", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/39001670_598340875906134_7078948835759736288_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e6QZH-2_yOkQ7kNvwFHMkwx&_nc_oc=Adph4n1Y5euZ6mWR8msz8ugoZLOrKR29wL0NSSk2c3psuyCJWvoxrhivipWhB1DQ2yA&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFJ89gkZko0pBXXh96Yep9ViXJj9-CpDWO_JHJejJcIcQ&oe=6A940FCB"}, {"file_name": "Screenshot06.png", "id": "970563445094246", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/39031450_970563448427579_1896364834470325490_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4Uu_VodTJZ0Q7kNvwHr1pMD&_nc_oc=AdrFRHvRZwX8B8NUNk7MksTiaYD0c1DhVZjhX3mz1J6g-AuJDBQd48JZilLkIDACD-Y&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGsnBZX17yD-xwpOMWcVzZ-Z_libhwmvW6h_wlZH_F6cw&oe=6A942F52"}, {"file_name": "Screenshot04.png", "id": "575729695062740", "uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/39031400_575729698396073_2621336866475747103_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FvyZsvfM_IQQ7kNvwE7tyJu&_nc_oc=Adqet-sPZJ052-bQPFGLu9efvzV3FAj3_7eaJ7D_b-PRWz5BKSoN0ip_9X9nec-CR2o&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEw9HMf2Y_-9909sGnapAEeqf3JLTUM1aYhW24iKu5bmA&oe=6A93FE1C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Gameplay Trailer Thumb.png", "id": "605202028847932", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/38974836_605202032181265_2417977283558520499_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XHbHK_t2IiAQ7kNvwGFukoA&_nc_oc=AdqRPanR_xDnZHrd6qMVv29IHh10DLJjmlerwvDsxQ0nL4OUGz60P5WZAEzasysgZb4&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHmIKIQh0lsa8-4urh68dEy89JcrrQ-odofknj_ShhHSw&oe=6A9405D9"}, "display_name": "Squishies - Roll them Home!", "keywords": ["puzzle", "platformer", "sandbox", "exploration", "adventure"], "long_description": "**Get lost in the Squishies-verse!**\n\nSquishies is a head-scratching puzzle platformer where you guide courageous and cute creatures through a series of increasingly hazardous, challenging mazes. Use unique motion controls to push and pull the Squishies through their adventures in a colorful universe full of strange flora and fauna. Keep those little rascals safe while they climb, jump, fly and teleport-by-fish through dozens of levels in five alien worlds!\n\n{507625458961423}\n\nYou push and pull the Squishies from one side of the maze to the other, all while earning medals, gathering crystals, climbing slopes, and avoiding pitfalls.\n\n- **Explore a huge universe** - Across dozens of levels in five different worlds.\n- **Collectibles and Achievements** - Gather all the crystals, beat the clock or find the hidden egg in each level.\n- **Level Editor** - Squishies really comes into its own with its innovative, fully featured creation tools.\n- **Community Section** - Share your creation with others and play their ingenious levels.\n- **Limited play space?** Need to keep an eye on your own little monsters?  You\u2019re in luck. Squishies\u00ae can be played in the newly added Mixed Reality mode!\n\n\n{482757334822594}", "short_description": "Help the stranded Squishies find their way back home! Push and pull them through challenging puzzles, or create your own levels with the powerful in-game editor and share them with the community."}]}, "developer_name": null, "developer_privacy_policy_url": "https://brainseed-factory.com/law/privacy_products/index.php", "developer_terms_of_service_url": "https://brainseed-factory.com/law/terms_products/index.php", "publishe
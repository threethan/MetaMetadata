uluscdn.com/v/t64.5771-25/75322598_1145165853836223_6864148320373849862_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_lVDMbNxTPkQ7kNvwH-f7xx&_nc_oc=AdpESSVy4daLHLum_0A0zxGiRGeTxICtaH87U8v88msL_MfrCtD7fsaNRGeUpt0guU0&_nc_zt=3&_nc_ht=scontent-lhr8-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2n-o4AztwUfMYbsnxcYdlpqTHFvQ_ckVnjUu-cw8Srhw&oe=69E24F83"}, {"file_name": "Screenshot03.png", "id": "598340872572801", "uri": "https://scontent-lhr8-2.oculuscdn.com/v/t64.5771-25/39001670_598340875906134_7078948835759736288_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i5KWCuPo9ykQ7kNvwFUonbC&_nc_oc=AdrQqodO5byKvS4pHmXuKbmQO3Lu8ew3JcvuP5YwLor5HtDnbNDhfKO-if0hdcPTIO8&_nc_zt=3&_nc_ht=scontent-lhr8-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af18EDpDUI4Kv_h6LPmBo9oy1qhLVb2WqZKtFhN9Dwbk2Q&oe=69E24D8B"}, {"file_name": "Screenshot06.png", "id": "970563445094246", "uri": "https://scontent-lhr8-1.oculuscdn.com/v/t64.5771-25/39031450_970563448427579_1896364834470325490_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F24b-82J7u0Q7kNvwHzWIqp&_nc_oc=AdoquZYn2l6ia1a3BEkKMQRPaeu9bSjKGFSd6hGlyMrMWyLJ_pw9nt5vnpuV6lFkbcs&_nc_zt=3&_nc_ht=scontent-lhr8-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af00hArUFEu9nVgx1VksEQIrSExEvb41HLkgYprYEcyv1w&oe=69E234D2"}, {"file_name": "Screenshot04.png", "id": "575729695062740", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/39031400_575729698396073_2621336866475747103_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z9o28le1mikQ7kNvwGXg0Y4&_nc_oc=AdromJaYF4MOQ-wSB_PaSaB8sZ8vWNZm4MlNPn8Ni1MM03B5GZfPs34Bk8AjHRJjcg4&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2tmIhCnSsAyVWdoPLSa9yZfbzsQM6MyL5Ag2RkLeQ_GQ&oe=69E23BDC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Gameplay Trailer Thumb.png", "id": "605202028847932", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/38974836_605202032181265_2417977283558520499_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k6fPaofpNl4Q7kNvwHsnkom&_nc_oc=AdrpHoMBWhsvFfJyra9naGwIstW_F0CtEq8d2xZe2E4RGiKHEhd0mTWIRXlC2MogLeA&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2XwuvXOnAHsWnInSCl7zohj54RujSkbotUx3rZF32Q_w&oe=69E24399"}, "display_name": "Squishies - Roll them Home!", "keywords": ["puzzle", "platformer", "sandbox", "exploration", "adventure"], "long_description": "**Get lost in the Squishies-verse!**\n\nSquishies is a head-scratching puzzle platformer where you guide courageous and cute creatures through a series of increasingly hazardous, challenging mazes. Use unique motion controls to push and pull the Squishies through their adventures in a colorful universe full of strange flora and fauna. Keep those little rascals safe while they climb, jump, fly and teleport-by-fish through dozens of levels in five alien worlds!\n\n{507625458961423}\n\nYou push and pull the Squishies from one side of the maze to the other, all while earning medals, gathering crystals, climbing slopes, and avoiding pitfalls.\n\n- **Explore a huge universe** - Across dozens of levels in five different worlds.\n- **Collectibles and Achievements** - Gather all the crystals, beat the clock or find the hidden egg in each level.\n- **Level Editor** - Squishies really comes into its own with its innovative, fully featured creation tools.\n- **Community Section** - Share your creation with others and play their ingenious levels.\n- **Limited play space?** Need to keep an eye on your own little monsters?  You\u2019re in luck. Squishies\u00ae can be played in the newly added Mixed Reality mode!\n\n\n{482757334822594}", "short_description": "Help the stranded Squishies find their way back home! Push and pull them through challenging puzzles, or create your own levels with the powerful in-game editor and share them with the community."}]}, "developer_name": null, "developer_privacy_policy_url": "https://brainseed-factory.com/law/privacy_products/index.php", "developer_terms_of_service_url": "https://brainseed-factory.com/law/terms_products/index.php", "publisher
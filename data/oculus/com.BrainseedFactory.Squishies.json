uluscdn.com/v/t64.5771-25/75322598_1145165853836223_6864148320373849862_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=olOILlTwBGYQ7kNvwGpk3gc&_nc_oc=AdpAtD202r1rOv2VRc5qjKY4837gU3eKpGEgAcXfn1AMXa0kldp--vYro8_ZYMJ0dos&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3juws180Zu7n7RR5Qvm9LRMGfLRnjh3knjV0RKYdcsnw&oe=69F4C483"}, {"file_name": "Screenshot03.png", "id": "598340872572801", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39001670_598340875906134_7078948835759736288_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Bxwwd7bFIp0Q7kNvwFP_Ajb&_nc_oc=AdrpevczgGHoqU-uh-KliZnZikQfYPKBUkhwTqLsmFKSP2ec8ckP0tsinVpkzfc0ElE&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1Thl021dKp_4HYmVs16JbZMndyiIDU2-y43DUl_dO-2w&oe=69F4C28B"}, {"file_name": "Screenshot06.png", "id": "970563445094246", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/39031450_970563448427579_1896364834470325490_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_LYEJUxpWA8Q7kNvwGphO81&_nc_oc=Adrj0UDEwlc-kyMsQtfblCAknOLtJVfSpz6EuICqy-3QYz9-UiuvL0cH2Bz5oiXDl_U&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2zfIZ6_1yKzWxc8QDepnKoGXwd9PNG3ZWVrbeZ0irEFw&oe=69F4A9D2"}, {"file_name": "Screenshot04.png", "id": "575729695062740", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39031400_575729698396073_2621336866475747103_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5xWTBcGAacEQ7kNvwFP2V3A&_nc_oc=AdpLATkrHE0lGElaD0kFxzQ4xQemPF7exFATBLjMb_sicNV4Q4NnuTEmeGv8CU1IRy4&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0v3H5XqLZD2NANJXOc3cbYV7hguCPDRXxPbCAXwLwYBw&oe=69F4B0DC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Gameplay Trailer Thumb.png", "id": "605202028847932", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974836_605202032181265_2417977283558520499_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WmTaqdfCHUwQ7kNvwGcslDs&_nc_oc=AdqVNWLz68QP77OKpnlefMD_IzAg36dFZVApO6b1KFW0lq692L_IKzwvN1G-iFAUe_Y&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1D5gs0D5DZJXU7t4_Z3uMgjruVmMHD-_rpY6nerDtfng&oe=69F4B899"}, "display_name": "Squishies - Roll them Home!", "keywords": ["puzzle", "platformer", "sandbox", "exploration", "adventure"], "long_description": "**Get lost in the Squishies-verse!**\n\nSquishies is a head-scratching puzzle platformer where you guide courageous and cute creatures through a series of increasingly hazardous, challenging mazes. Use unique motion controls to push and pull the Squishies through their adventures in a colorful universe full of strange flora and fauna. Keep those little rascals safe while they climb, jump, fly and teleport-by-fish through dozens of levels in five alien worlds!\n\n{507625458961423}\n\nYou push and pull the Squishies from one side of the maze to the other, all while earning medals, gathering crystals, climbing slopes, and avoiding pitfalls.\n\n- **Explore a huge universe** - Across dozens of levels in five different worlds.\n- **Collectibles and Achievements** - Gather all the crystals, beat the clock or find the hidden egg in each level.\n- **Level Editor** - Squishies really comes into its own with its innovative, fully featured creation tools.\n- **Community Section** - Share your creation with others and play their ingenious levels.\n- **Limited play space?** Need to keep an eye on your own little monsters?  You\u2019re in luck. Squishies\u00ae can be played in the newly added Mixed Reality mode!\n\n\n{482757334822594}", "short_description": "Help the stranded Squishies find their way back home! Push and pull them through challenging puzzles, or create your own levels with the powerful in-game editor and share them with the community."}]}, "developer_name": null, "developer_privacy_policy_url": "https://brainseed-factory.com/law/privacy_products/index.php", "developer_terms_of_service_url": "https://brainseed-factory.com/law/terms_products/index.php", "publisher
culuscdn.com/v/t64.5771-25/75322598_1145165853836223_6864148320373849862_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dD7BJAVxSXEQ7kNvwFrtvbD&_nc_oc=AdpjKkYaX-TBqSuyiGWd6hwDVk5gv_P3clkIIO7G4_eRD3d5t2gdXQ9Hd3Dq23fhOrA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKTUj3zc1hD0ng7ive7zR7Mewym4Xf7jDU8OotJEvbCsw&oe=6AAAB383"}, {"file_name": "Screenshot03.png", "id": "598340872572801", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39001670_598340875906134_7078948835759736288_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1z-zYA6KHg0Q7kNvwHeFWTJ&_nc_oc=Adq_nW5x3OAKGvZfZmRfP_tFkdrJI9Uf_3AH0dXzSheQm8pURzmDZoARKlxztr11thw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL0gR2UjGkXQxUZ-8YaDEbdRqlN9SORbj12ruu3WpxUXA&oe=6AAAB18B"}, {"file_name": "Screenshot06.png", "id": "970563445094246", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031450_970563448427579_1896364834470325490_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J8SocmB_6PgQ7kNvwEklyp7&_nc_oc=AdqOZwqgGMx_WCsb5C5IrTQzZeIGoSiZhAy0cOTU5GiYa_SW-XTEZR5ieNUvuVt32BQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI0vIZ8fH7uCLlisTH4S_5Mky0FMz7Wl0ViPlqSn-giTg&oe=6AAA98D2"}, {"file_name": "Screenshot04.png", "id": "575729695062740", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031400_575729698396073_2621336866475747103_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lf2cCEsJ8EIQ7kNvwG1qoLR&_nc_oc=Ado1r667xpM2xUId87yBWaa1RpjBtLgRcf1LWjlaMJ43XMB7vtcSpk3TO29mah0pk2U&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIRUT0vkxMr_wTmw3fhXvzd-2dUVSGSymvXceXcTihvIA&oe=6AAA9FDC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Gameplay Trailer Thumb.png", "id": "605202028847932", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974836_605202032181265_2417977283558520499_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yKSzwAkYkxIQ7kNvwEPdqWf&_nc_oc=Ado3xp8VzSgrhRuTB9G9zQsfIUHn7GL1uen1-XNongUYIiO5061Cqn3_E3hCUAHv4oI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI4NSN9gce8sMyL69UBqJRmy8H1yZcMItk-avEISGF_ow&oe=6AAAA799"}, "display_name": "Squishies - Roll them Home!", "keywords": ["puzzle", "platformer", "sandbox", "exploration", "adventure"], "long_description": "**Get lost in the Squishies-verse!**\n\nSquishies is a head-scratching puzzle platformer where you guide courageous and cute creatures through a series of increasingly hazardous, challenging mazes. Use unique motion controls to push and pull the Squishies through their adventures in a colorful universe full of strange flora and fauna. Keep those little rascals safe while they climb, jump, fly and teleport-by-fish through dozens of levels in five alien worlds!\n\n{507625458961423}\n\nYou push and pull the Squishies from one side of the maze to the other, all while earning medals, gathering crystals, climbing slopes, and avoiding pitfalls.\n\n- **Explore a huge universe** - Across dozens of levels in five different worlds.\n- **Collectibles and Achievements** - Gather all the crystals, beat the clock or find the hidden egg in each level.\n- **Level Editor** - Squishies really comes into its own with its innovative, fully featured creation tools.\n- **Community Section** - Share your creation with others and play their ingenious levels.\n- **Limited play space?** Need to keep an eye on your own little monsters?  You\u2019re in luck. Squishies\u00ae can be played in the newly added Mixed Reality mode!\n\n\n{482757334822594}", "short_description": "Help the stranded Squishies find their way back home! Push and pull them through challenging puzzles, or create your own levels with the powerful in-game editor and share them with the community."}]}, "developer_name": null, "developer_privacy_policy_url": "https://brainseed-factory.com/law/privacy_products/index.php", "developer_terms_of_service_url": "https://brainseed-factory.com/law/terms_products/index.php", "publishe
in2-2.oculuscdn.com/v/t64.5771-25/75322598_1145165853836223_6864148320373849862_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dO1nA2cyn-4Q7kNvwF8-DvT&_nc_oc=AdrpUPmFamSBJekSX_X_FiCasib9uaolmOvC3Lw-cUtlHPnTqXQpyyxYoZWuWZRAdas&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af66gNebqADB42K-GbrD8yb55srGRWx33rRZ9U__ZH87Uw&oe=6A11C583"}, {"file_name": "Screenshot03.png", "id": "598340872572801", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/39001670_598340875906134_7078948835759736288_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CZZdsNmngKIQ7kNvwFjOZM2&_nc_oc=AdrePg49pweTuiul9EaA_1vmCNhdb_-tVeOyFLOZt5WlP69HO1n6gh_y_Ou8PP4X3ho&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5eZctenvn4vDmuNHq9oypKsdQILarWUtAy8Ozx5jIWUA&oe=6A11C38B"}, {"file_name": "Screenshot06.png", "id": "970563445094246", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/39031450_970563448427579_1896364834470325490_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rWG7KIEB7-0Q7kNvwH9Q2RC&_nc_oc=AdpNsH1P07yYymm-G60AET3kfrUZui9Y0VqjmEwaKQYujR2xjDNVuM84VDaegVi1N0w&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4xVXG0T7feZIJzK1gOM1--cU1KR8IjGd2Is4bQk2bBtg&oe=6A11AAD2"}, {"file_name": "Screenshot04.png", "id": "575729695062740", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/39031400_575729698396073_2621336866475747103_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hKlFIgBWQQ0Q7kNvwHXFczQ&_nc_oc=AdoXDv0htE4Zocgpn1izsbBRWCGRKbQ2iWAn3OKUX9URxPPUUhQ9d5OCk2fkK8u-EUc&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6WsFcB9LoQnahFAS8WWBVhGI1CTu20yH4lQDxqYD8o6Q&oe=6A11B1DC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Gameplay Trailer Thumb.png", "id": "605202028847932", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/38974836_605202032181265_2417977283558520499_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AK_9Pb0_DcAQ7kNvwG-i-oF&_nc_oc=Adq1GWFXaUvg8y-xzD09wUwCP6D6gdkfojsmYAS5bFz0hbsp9rhErH0TPkq_im0DBn0&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4TXURoPdM8ZOH9SDWlrCym8T86FuvmTBdPkia2y8tcQA&oe=6A11B999"}, "display_name": "Squishies - Roll them Home!", "keywords": ["puzzle", "platformer", "sandbox", "exploration", "adventure"], "long_description": "**Get lost in the Squishies-verse!**\n\nSquishies is a head-scratching puzzle platformer where you guide courageous and cute creatures through a series of increasingly hazardous, challenging mazes. Use unique motion controls to push and pull the Squishies through their adventures in a colorful universe full of strange flora and fauna. Keep those little rascals safe while they climb, jump, fly and teleport-by-fish through dozens of levels in five alien worlds!\n\n{507625458961423}\n\nYou push and pull the Squishies from one side of the maze to the other, all while earning medals, gathering crystals, climbing slopes, and avoiding pitfalls.\n\n- **Explore a huge universe** - Across dozens of levels in five different worlds.\n- **Collectibles and Achievements** - Gather all the crystals, beat the clock or find the hidden egg in each level.\n- **Level Editor** - Squishies really comes into its own with its innovative, fully featured creation tools.\n- **Community Section** - Share your creation with others and play their ingenious levels.\n- **Limited play space?** Need to keep an eye on your own little monsters?  You\u2019re in luck. Squishies\u00ae can be played in the newly added Mixed Reality mode!\n\n\n{482757334822594}", "short_description": "Help the stranded Squishies find their way back home! Push and pull them through challenging puzzles, or create your own levels with the powerful in-game editor and share them with the community."}]}, "developer_name": null, "developer_privacy_policy_url": "https://brainseed-factory.com/law/privacy_products/index.php", "developer_terms_of_service_url": "https://brainseed-factory.com/law/terms_products/index.php"
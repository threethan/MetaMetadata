culuscdn.com/v/t64.5771-25/75322598_1145165853836223_6864148320373849862_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vK4msK3EcQcQ7kNvwH7I0dK&_nc_oc=AdpKr-C1yzgWXz_2BOD6EmAQtWIBfW-h9S6CD10yBVinxdLMX5KuGU_DGvpKx6fF6Mg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGPYlr3VV2bvYHdWslDl6k5Wh2X7EWHRNK-mpmcVeg9JA&oe=6A707943"}, {"file_name": "Screenshot03.png", "id": "598340872572801", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39001670_598340875906134_7078948835759736288_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6R1opDbihO4Q7kNvwFfqgSk&_nc_oc=AdrUQbtRKvibHo1-xRVNoaXsFDi0-9kaG0R0w0eod4J7Wv5oGUE7RSw_PnPhzkz8kio&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFn96EVkTHSU_gbXsrvp10UXybbsPkM-w7wyc3ZGm-kmw&oe=6A70774B"}, {"file_name": "Screenshot06.png", "id": "970563445094246", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031450_970563448427579_1896364834470325490_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tXhNsSbkKb8Q7kNvwHtxS2q&_nc_oc=AdqG7udDr12b00RG3nnreyMnM8Oo7txbj2zHiGYuuTAMY64UWDD1ffP8OAcdOWmPvqE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGG0h02W_839MRbKBiUTrCmS2VdcA4cEfJVrVwsmp4cSg&oe=6A7096D2"}, {"file_name": "Screenshot04.png", "id": "575729695062740", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031400_575729698396073_2621336866475747103_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aPXWyhw-HX0Q7kNvwFaecw4&_nc_oc=Adp8jeXCWbfvMH-rQhdcrGac0iO1_dt-gCyFy4ctTcCkQ6F3EBkuDDQvQra2X4YobhQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHkT1TnZdCd3rrAGkawC69GK2QztZLOyJAXUyadBZjMEA&oe=6A709DDC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Gameplay Trailer Thumb.png", "id": "605202028847932", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974836_605202032181265_2417977283558520499_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hBxytTA4vSIQ7kNvwFBHcv7&_nc_oc=Adp7aN7aQ_qSExy7HDMDoFQEwhum2cMfIolRzkhWck0QBokonp02F4ibvElmVQ413L8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGL9v-DHeesLdiI3V3c1KhyR-BvZsc1uCpzM8HFPrk3Pg&oe=6A70A599"}, "display_name": "Squishies - Roll them Home!", "keywords": ["puzzle", "platformer", "sandbox", "exploration", "adventure"], "long_description": "**Get lost in the Squishies-verse!**\n\nSquishies is a head-scratching puzzle platformer where you guide courageous and cute creatures through a series of increasingly hazardous, challenging mazes. Use unique motion controls to push and pull the Squishies through their adventures in a colorful universe full of strange flora and fauna. Keep those little rascals safe while they climb, jump, fly and teleport-by-fish through dozens of levels in five alien worlds!\n\n{507625458961423}\n\nYou push and pull the Squishies from one side of the maze to the other, all while earning medals, gathering crystals, climbing slopes, and avoiding pitfalls.\n\n- **Explore a huge universe** - Across dozens of levels in five different worlds.\n- **Collectibles and Achievements** - Gather all the crystals, beat the clock or find the hidden egg in each level.\n- **Level Editor** - Squishies really comes into its own with its innovative, fully featured creation tools.\n- **Community Section** - Share your creation with others and play their ingenious levels.\n- **Limited play space?** Need to keep an eye on your own little monsters?  You\u2019re in luck. Squishies\u00ae can be played in the newly added Mixed Reality mode!\n\n\n{482757334822594}", "short_description": "Help the stranded Squishies find their way back home! Push and pull them through challenging puzzles, or create your own levels with the powerful in-game editor and share them with the community."}]}, "developer_name": null, "developer_privacy_policy_url": "https://brainseed-factory.com/law/privacy_products/index.php", "developer_terms_of_service_url": "https://brainseed-factory.com/law/terms_products/index.php", "publishe
145165853836223_6864148320373849862_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UaQSKp8d4UMQ7kNvwFrh2jg&_nc_oc=Adnbrb4qWPSaozhT9OyJBuocx5PFvFuulmHmJMUvRz4jcKoWdeQDLiYFQsj-VDnqbkE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afwf22OsDmBYB3ZjzjPDl3jMtoMq-fDevpHE6vT8KyU8WQ&oe=69AEACC3"}, {"file_name": "Screenshot03.png", "id": "598340872572801", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39001670_598340875906134_7078948835759736288_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GAS3JcV4pQIQ7kNvwHe6kgF&_nc_oc=AdnY010tE6c0YQztSzm5_Y6BBXRlC49gj62LofYQSvOx8riJ4C9psx-AFutUHnKqeBg&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afz9Pcr3eC13AQ0gq92-qRAyU3ZoZdYKoxEu9XSGS_-pNw&oe=69AEAACB"}, {"file_name": "Screenshot06.png", "id": "970563445094246", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031450_970563448427579_1896364834470325490_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YiYtey508bYQ7kNvwG0ZeQL&_nc_oc=AdkZDhe7paJai4UcILCBxpAwbygYc_DmZDw2byEv6dR7_Ai4kuu0lXGOlwphc6J1wmo&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfxUGOaqQ66flB1iex0btIOf-NYhY0IgHcPkL8G_1rLHMA&oe=69AECA52"}, {"file_name": "Screenshot04.png", "id": "575729695062740", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031400_575729698396073_2621336866475747103_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I-Ep25iL2YcQ7kNvwEV1Eq5&_nc_oc=AdmHaLYas2bHAkSlvOIbA4CAOSqJPCZRzAWukmRj0jIkMyRVG60wofutMyixH5CNw8g&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfwwVgdjuB2mAudwvydRatsG7EfzHVfc1_0eCoxR7DvfEQ&oe=69AED15C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Gameplay Trailer Thumb.png", "id": "605202028847932", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974836_605202032181265_2417977283558520499_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iKonWaugwXcQ7kNvwHg6Nbc&_nc_oc=AdktHE0VtGCC6st8FAxryu7MegBb2Wnf2gPcCELVV38-4Sdrl_1YGPFBvGpjrt7eUQU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afz_lQzPYJ8O6pMm4_aOFA5egwoSVocioYU9V97QmDd-6w&oe=69AED919"}, "display_name": "Squishies - Roll them Home!", "keywords": ["puzzle", "platformer", "sandbox", "exploration", "adventure"], "long_description": "**Get lost in the Squishies-verse!**\n\nSquishies is a head-scratching puzzle platformer where you guide courageous and cute creatures through a series of increasingly hazardous, challenging mazes. Use unique motion controls to push and pull the Squishies through their adventures in a colorful universe full of strange flora and fauna. Keep those little rascals safe while they climb, jump, fly and teleport-by-fish through dozens of levels in five alien worlds!\n\n{507625458961423}\n\nYou push and pull the Squishies from one side of the maze to the other, all while earning medals, gathering crystals, climbing slopes, and avoiding pitfalls.\n\n- **Explore a huge universe** - Across dozens of levels in five different worlds.\n- **Collectibles and Achievements** - Gather all the crystals, beat the clock or find the hidden egg in each level.\n- **Level Editor** - Squishies really comes into its own with its innovative, fully featured creation tools.\n- **Community Section** - Share your creation with others and play their ingenious levels.\n- **Limited play space?** Need to keep an eye on your own little monsters?  You\u2019re in luck. Squishies\u00ae can be played in the newly added Mixed Reality mode!\n\n\n{482757334822594}", "short_description": "Help the stranded Squishies find their way back home! Push and pull them through challenging puzzles, or create your own levels with the powerful in-game editor and share them with the community."}]}, "developer_name": null, "developer_privacy_policy_url": "https://brainseed-factory.com/law/privacy_products/index.php", "developer_terms_of_service_url": "https://brainseed-factory.com/law/terms_products/index.php", "publisher_name": "Perp Games", "support_website_url": null, "webs
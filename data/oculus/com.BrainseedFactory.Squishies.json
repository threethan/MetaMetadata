culuscdn.com/v/t64.5771-25/75322598_1145165853836223_6864148320373849862_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2HkjXdHtuZ0Q7kNvwGfSy3U&_nc_oc=AdreWoTx1Jeg7aKag0cWMIwPlIBshf0dV-Xw9eH-Ne8KbAL9SwD4kKcKSKf5ZywAdl4&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAac0-vJnakMWrH7OK6BNg_K8DbX3PMQvb7coUtO4YhMA&oe=6A6DD643"}, {"file_name": "Screenshot03.png", "id": "598340872572801", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39001670_598340875906134_7078948835759736288_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f_BfQtm6fy0Q7kNvwHj2fya&_nc_oc=AdqwHtAw4RI6QNIvZAuJu6O5ZxsORWDc6PLhjxNuNHHG97nzyjtV_ky_nmEGJ2WiPrU&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCRcEDIMwNcVXhc3-CFJ6PV6dDtF9NEE_JCyLV7omOYAQ&oe=6A6DD44B"}, {"file_name": "Screenshot06.png", "id": "970563445094246", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031450_970563448427579_1896364834470325490_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EaOScv7RXasQ7kNvwFLrOcY&_nc_oc=AdpEGKiSIMumtCgDgd5EHpKosl6_8BT0HTM-Qjm5gvrFUI7nMFyWZMp2Dg_wC6HzhUg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD1mCiRCvA9-uVukv6lMgwcrLaHwtv0MppwTLMF4kfFRQ&oe=6A6DF3D2"}, {"file_name": "Screenshot04.png", "id": "575729695062740", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39031400_575729698396073_2621336866475747103_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aPXWyhw-HX0Q7kNvwHMMWrN&_nc_oc=Ado-xPflaNphzRviQM-GtlRQcZCYlhGr9CZCJTcOSwUJfH7X1pTnrBl6kRq_yPRxMRE&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDfo0iXUVfsG-sX5DHFT59nm-aAGwQn2ErSjKT3Pc4noQ&oe=6A6DFADC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Gameplay Trailer Thumb.png", "id": "605202028847932", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974836_605202032181265_2417977283558520499_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=83MKq3BaSYoQ7kNvwHwDN6m&_nc_oc=AdqBjnag_5aARXekGFP5m5pta3XPQxQw69UCPw5iVCrkqwSfGmSrrJlS1MnAaW48ivQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAdKQtufe4wd1crKIEwmzowegJJt5IT3677euEIhHwCSA&oe=6A6E0299"}, "display_name": "Squishies - Roll them Home!", "keywords": ["puzzle", "platformer", "sandbox", "exploration", "adventure"], "long_description": "**Get lost in the Squishies-verse!**\n\nSquishies is a head-scratching puzzle platformer where you guide courageous and cute creatures through a series of increasingly hazardous, challenging mazes. Use unique motion controls to push and pull the Squishies through their adventures in a colorful universe full of strange flora and fauna. Keep those little rascals safe while they climb, jump, fly and teleport-by-fish through dozens of levels in five alien worlds!\n\n{507625458961423}\n\nYou push and pull the Squishies from one side of the maze to the other, all while earning medals, gathering crystals, climbing slopes, and avoiding pitfalls.\n\n- **Explore a huge universe** - Across dozens of levels in five different worlds.\n- **Collectibles and Achievements** - Gather all the crystals, beat the clock or find the hidden egg in each level.\n- **Level Editor** - Squishies really comes into its own with its innovative, fully featured creation tools.\n- **Community Section** - Share your creation with others and play their ingenious levels.\n- **Limited play space?** Need to keep an eye on your own little monsters?  You\u2019re in luck. Squishies\u00ae can be played in the newly added Mixed Reality mode!\n\n\n{482757334822594}", "short_description": "Help the stranded Squishies find their way back home! Push and pull them through challenging puzzles, or create your own levels with the powerful in-game editor and share them with the community."}]}, "developer_name": null, "developer_privacy_policy_url": "https://brainseed-factory.com/law/privacy_products/index.php", "developer_terms_of_service_url": "https://brainseed-factory.com/law/terms_products/index.php", "publishe
culuscdn.com/v/t64.5771-25/75322598_1145165853836223_6864148320373849862_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4LIzUb7hXfYQ7kNvwH5Eb8j&_nc_oc=AdobkId0YQGQ6Ig-egHGZFyRRD82YlBPgHvMb6DC0_5q_mP7IGtqse_IsrjyTIFPUpA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJaX6WwiPtGm6nw772ZgM7dRUHz_IyZKbpc1DsPZFwuFg&oe=6AB7E283"}, {"file_name": "Screenshot03.png", "id": "598340872572801", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39001670_598340875906134_7078948835759736288_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h293hKyL7zAQ7kNvwHDniUV&_nc_oc=AdqQuLV_4fGzp1kFxAyyhCHv5KMhTSLhIpnIVWJFWN7kOgq4ILC8bZ9Y6O1oi3W5Zo4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKZZHiyT79zOzzvvyzx1AbmsFu1kLXvNihnSitrBxu9Kw&oe=6AB7E08B"}, {"file_name": "Screenshot06.png", "id": "970563445094246", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031450_970563448427579_1896364834470325490_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F6tdJ848B2AQ7kNvwH14Acl&_nc_oc=AdoSDBC9lWE3JnxtTtigYrYo7ilFtlF_kl6Uhpfxw8-XuBCRwUwI9lLmSejDm8Adz4c&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLyxO-czloOMLgGikoZhN1Xp7y-lPvUjIOI1Azjb6GYng&oe=6AB7C7D2"}, {"file_name": "Screenshot04.png", "id": "575729695062740", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031400_575729698396073_2621336866475747103_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Dpu2jmwcvTwQ7kNvwGtFJcK&_nc_oc=AdpfR3sFq5mhiZxlNOV0cLgk7tcbnkCYwuahX3cziX8L1AKBGma1MgzJTMb53hFsVHM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKau7IybrQ9jw4uFC3xcRF9s9K2GEwZbcGLXixLYerUwA&oe=6AB7CEDC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Gameplay Trailer Thumb.png", "id": "605202028847932", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974836_605202032181265_2417977283558520499_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=p5R1Ka3e8FcQ7kNvwE-jC_q&_nc_oc=Ado27-Y1TsKvb6RHXUi88wN5W5rRwJVw8TOzuJcj7XEwvbOJftcvAUCfJ4T7HD7jB3o&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI2gcbCbYxW4e4qwMCjVffX_Y7NajfpWbHhHwk9bZW-Mg&oe=6AB7D699"}, "display_name": "Squishies - Roll them Home!", "keywords": ["puzzle", "platformer", "sandbox", "exploration", "adventure"], "long_description": "**Get lost in the Squishies-verse!**\n\nSquishies is a head-scratching puzzle platformer where you guide courageous and cute creatures through a series of increasingly hazardous, challenging mazes. Use unique motion controls to push and pull the Squishies through their adventures in a colorful universe full of strange flora and fauna. Keep those little rascals safe while they climb, jump, fly and teleport-by-fish through dozens of levels in five alien worlds!\n\n{507625458961423}\n\nYou push and pull the Squishies from one side of the maze to the other, all while earning medals, gathering crystals, climbing slopes, and avoiding pitfalls.\n\n- **Explore a huge universe** - Across dozens of levels in five different worlds.\n- **Collectibles and Achievements** - Gather all the crystals, beat the clock or find the hidden egg in each level.\n- **Level Editor** - Squishies really comes into its own with its innovative, fully featured creation tools.\n- **Community Section** - Share your creation with others and play their ingenious levels.\n- **Limited play space?** Need to keep an eye on your own little monsters?  You\u2019re in luck. Squishies\u00ae can be played in the newly added Mixed Reality mode!\n\n\n{482757334822594}", "short_description": "Help the stranded Squishies find their way back home! Push and pull them through challenging puzzles, or create your own levels with the powerful in-game editor and share them with the community."}]}, "developer_name": null, "developer_privacy_policy_url": "https://brainseed-factory.com/law/privacy_products/index.php", "developer_terms_of_service_url": "https://brainseed-factory.com/law/terms_products/index.php", "publishe
culuscdn.com/v/t64.5771-25/75322598_1145165853836223_6864148320373849862_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n31ZuzynBsQQ7kNvwFVwT1G&_nc_oc=Adqz8GRB_xIXdC2A08Vg1iEDsA8JGrxJNe4cjL3zDm0aNwcNOLqX2LNqkNrBbvBKCxA&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDXRB6u72ezt71o69zibb_CmZFWEdFKd-Uuhho7hLnm8A&oe=6A5A4803"}, {"file_name": "Screenshot03.png", "id": "598340872572801", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39001670_598340875906134_7078948835759736288_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x9K6J4H8CaoQ7kNvwEPTDdw&_nc_oc=Adq9ymp1ZGJlKDevqqF97HlNXoa5BUSIHr2vCKvDjw2Meo30fiycvsTg_zw1BXThjgQ&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCCS_MRMYHusO44qr2s8s8impOxl2S5sTYQa_wAAV1cxg&oe=6A5A460B"}, {"file_name": "Screenshot06.png", "id": "970563445094246", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/39031450_970563448427579_1896364834470325490_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aRxRQ5fP9UkQ7kNvwGO409E&_nc_oc=AdqmKyHnZUinai6mxlx8ACWSQsOBSpEbx4aVXI0VCBQQ79Leb9xTtoG89NuJOevwGoQ&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBPqvY7KALeoqXvQNxyWRZ7eWgxXnDAFozGdpSbQ73DOg&oe=6A5A2D52"}, {"file_name": "Screenshot04.png", "id": "575729695062740", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39031400_575729698396073_2621336866475747103_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j6phE_V8kloQ7kNvwGmS5qN&_nc_oc=AdpRTIh25dRAqFOXKBdlC___aT3ot2UhyZHvg1cgCpa8s_o0s5ZVR_ZzJJKxDz96d9M&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBn8tk_BGMTmTDDMwwANVuatu2Ib7N1XCWnTC4Kjj8-2A&oe=6A5A345C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Gameplay Trailer Thumb.png", "id": "605202028847932", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/38974836_605202032181265_2417977283558520499_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=p2LFv9jCftIQ7kNvwGkSlAc&_nc_oc=AdoQa52F3sckpGIUnW77LpkhI35bZCGEq3qbPFXb4wmt2uS9bm1Gl8hMJeKc2HxT7sI&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDgpZLTAZls90KP3l9BsuanN0kVLlMQGmYKnGgqe0tiJQ&oe=6A5A3C19"}, "display_name": "Squishies - Roll them Home!", "keywords": ["puzzle", "platformer", "sandbox", "exploration", "adventure"], "long_description": "**Get lost in the Squishies-verse!**\n\nSquishies is a head-scratching puzzle platformer where you guide courageous and cute creatures through a series of increasingly hazardous, challenging mazes. Use unique motion controls to push and pull the Squishies through their adventures in a colorful universe full of strange flora and fauna. Keep those little rascals safe while they climb, jump, fly and teleport-by-fish through dozens of levels in five alien worlds!\n\n{507625458961423}\n\nYou push and pull the Squishies from one side of the maze to the other, all while earning medals, gathering crystals, climbing slopes, and avoiding pitfalls.\n\n- **Explore a huge universe** - Across dozens of levels in five different worlds.\n- **Collectibles and Achievements** - Gather all the crystals, beat the clock or find the hidden egg in each level.\n- **Level Editor** - Squishies really comes into its own with its innovative, fully featured creation tools.\n- **Community Section** - Share your creation with others and play their ingenious levels.\n- **Limited play space?** Need to keep an eye on your own little monsters?  You\u2019re in luck. Squishies\u00ae can be played in the newly added Mixed Reality mode!\n\n\n{482757334822594}", "short_description": "Help the stranded Squishies find their way back home! Push and pull them through challenging puzzles, or create your own levels with the powerful in-game editor and share them with the community."}]}, "developer_name": null, "developer_privacy_policy_url": "https://brainseed-factory.com/law/privacy_products/index.php", "developer_terms_of_service_url": "https://brainseed-factory.com/law/terms_products/index.php", "publishe
culuscdn.com/v/t64.5771-25/75322598_1145165853836223_6864148320373849862_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rQhAtcDkpFYQ7kNvwHDZ74a&_nc_oc=AdpJWivgek5HgbL-jkoHzzPoqavs90d8bOOrvaSHbxtcgEXA2wpdNhEbdhS_beRQ2dE&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH1_fb1uH1eKeeVYmU8HYjd7x_8yNrXz-2jKac6lmM3sw&oe=6A7710C3"}, {"file_name": "Screenshot03.png", "id": "598340872572801", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39001670_598340875906134_7078948835759736288_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aLV-Pz9GKdAQ7kNvwE4FNxs&_nc_oc=AdomqfiddZ0R0WtKcx5Wi6kfkAPq7MUDKB4YeFOJ_k9axs1bzmkg4U56vJYz_tb_Jew&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGWiG0sE51VXWd6RUjhwQPu-ltSk60x9P3ISRQakIkBzg&oe=6A770ECB"}, {"file_name": "Screenshot06.png", "id": "970563445094246", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031450_970563448427579_1896364834470325490_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Mfmg4j1rCfIQ7kNvwHcHUQi&_nc_oc=Adp6w4IsJUGDBu4Xu6Je4XoahWKFondLm0FcmD98YYQSNoQHv9fO7pvTn4VGnKRDeTE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF63I0vxxZwx0tQUgbztTIOBlmBbBNMT4FZnKB0ive2_Q&oe=6A772E52"}, {"file_name": "Screenshot04.png", "id": "575729695062740", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39031400_575729698396073_2621336866475747103_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BFm9wC4qGGwQ7kNvwH03HYN&_nc_oc=AdrfdYqSKZSKTLhg4Xj6JSP8OUhqBuZRbISjYN6lH3te9JzXM66goHipI7Cl-fMaAA8&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGRP9ZD8qdXbsKdQFMP4No6T97PVTzfhOWunadvnFBlhA&oe=6A77355C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Gameplay Trailer Thumb.png", "id": "605202028847932", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974836_605202032181265_2417977283558520499_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0DA9qUP3jjcQ7kNvwEGAWhA&_nc_oc=AdokG7IQomPFi-trjgSTizN12PIWs5LDqecESTKJ1zmtasgEhKXeUkNr3YiVlj-o7z8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHJ6PhyygKhgPRf_p0WutnAQOH4NokECqkpehN53paJQA&oe=6A773D19"}, "display_name": "Squishies - Roll them Home!", "keywords": ["puzzle", "platformer", "sandbox", "exploration", "adventure"], "long_description": "**Get lost in the Squishies-verse!**\n\nSquishies is a head-scratching puzzle platformer where you guide courageous and cute creatures through a series of increasingly hazardous, challenging mazes. Use unique motion controls to push and pull the Squishies through their adventures in a colorful universe full of strange flora and fauna. Keep those little rascals safe while they climb, jump, fly and teleport-by-fish through dozens of levels in five alien worlds!\n\n{507625458961423}\n\nYou push and pull the Squishies from one side of the maze to the other, all while earning medals, gathering crystals, climbing slopes, and avoiding pitfalls.\n\n- **Explore a huge universe** - Across dozens of levels in five different worlds.\n- **Collectibles and Achievements** - Gather all the crystals, beat the clock or find the hidden egg in each level.\n- **Level Editor** - Squishies really comes into its own with its innovative, fully featured creation tools.\n- **Community Section** - Share your creation with others and play their ingenious levels.\n- **Limited play space?** Need to keep an eye on your own little monsters?  You\u2019re in luck. Squishies\u00ae can be played in the newly added Mixed Reality mode!\n\n\n{482757334822594}", "short_description": "Help the stranded Squishies find their way back home! Push and pull them through challenging puzzles, or create your own levels with the powerful in-game editor and share them with the community."}]}, "developer_name": null, "developer_privacy_policy_url": "https://brainseed-factory.com/law/privacy_products/index.php", "developer_terms_of_service_url": "https://brainseed-factory.com/law/terms_products/index.php", "publishe
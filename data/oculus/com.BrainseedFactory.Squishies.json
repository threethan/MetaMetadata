uluscdn.com/v/t64.5771-25/75322598_1145165853836223_6864148320373849862_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uhbN5SYs_R4Q7kNvwGQAuTn&_nc_oc=AdpKWpttrNKJdxpHUw1xFanL3LSLFrWfaiY9v84Q25FLNtnEshE_cN_Cra_uhQGVe6k&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6mib0RvSJzwkcJ_BJiWLcPA0AS5tB27xrxej4mbN8J7g&oe=6A15BA03"}, {"file_name": "Screenshot03.png", "id": "598340872572801", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/39001670_598340875906134_7078948835759736288_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IA7MxBsLqi8Q7kNvwFY9XRE&_nc_oc=AdqADcvp3IrU6w4VCcdpUQnasQqqNXUAKQHcMS6qT5EIVOwnD7e4sQE976-5iCC19Mk&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4VswYOBtCGTOVyN8cnRmsK1nobTjNAONro3wW0vs49-w&oe=6A15B80B"}, {"file_name": "Screenshot06.png", "id": "970563445094246", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39031450_970563448427579_1896364834470325490_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l4j8BbqG3LQQ7kNvwEydgPt&_nc_oc=Adq9z8-Rx3fzO8JCDl7CTHkaYSBCAZMri29nrqliZaLpQbS1kXTkFDIEfCqU3eD3GbI&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6VGdLKjtSuVDWnR27SLNUF6H1ikulBii5XUz3GnlsZNw&oe=6A159F52"}, {"file_name": "Screenshot04.png", "id": "575729695062740", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39031400_575729698396073_2621336866475747103_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VxMvvHMl79IQ7kNvwFwh-BJ&_nc_oc=AdplChjkLco21maDxY9OGgzeWACzN9ReOxoX6hEUBCRSBMGKbxkxZtrPYlteIIXbb4Q&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6KXLYrwDykfOJkhYqpzzyR4Yv9QlfCXUiihDBSfl7xWg&oe=6A15A65C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Gameplay Trailer Thumb.png", "id": "605202028847932", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974836_605202032181265_2417977283558520499_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GU8uRmORS6QQ7kNvwHFXBCi&_nc_oc=AdoSB_BZACcrffN39B86YeczZI-NH0_VeBB-jjc8mxC2n35SasCqXhS8lE4PgNXGmZE&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5XW3N87gv9ZupSfvEj1gTz7L0Dif_2znIFK0DI2nU63A&oe=6A15AE19"}, "display_name": "Squishies - Roll them Home!", "keywords": ["puzzle", "platformer", "sandbox", "exploration", "adventure"], "long_description": "**Get lost in the Squishies-verse!**\n\nSquishies is a head-scratching puzzle platformer where you guide courageous and cute creatures through a series of increasingly hazardous, challenging mazes. Use unique motion controls to push and pull the Squishies through their adventures in a colorful universe full of strange flora and fauna. Keep those little rascals safe while they climb, jump, fly and teleport-by-fish through dozens of levels in five alien worlds!\n\n{507625458961423}\n\nYou push and pull the Squishies from one side of the maze to the other, all while earning medals, gathering crystals, climbing slopes, and avoiding pitfalls.\n\n- **Explore a huge universe** - Across dozens of levels in five different worlds.\n- **Collectibles and Achievements** - Gather all the crystals, beat the clock or find the hidden egg in each level.\n- **Level Editor** - Squishies really comes into its own with its innovative, fully featured creation tools.\n- **Community Section** - Share your creation with others and play their ingenious levels.\n- **Limited play space?** Need to keep an eye on your own little monsters?  You\u2019re in luck. Squishies\u00ae can be played in the newly added Mixed Reality mode!\n\n\n{482757334822594}", "short_description": "Help the stranded Squishies find their way back home! Push and pull them through challenging puzzles, or create your own levels with the powerful in-game editor and share them with the community."}]}, "developer_name": null, "developer_privacy_policy_url": "https://brainseed-factory.com/law/privacy_products/index.php", "developer_terms_of_service_url": "https://brainseed-factory.com/law/terms_products/index.php", "publisher
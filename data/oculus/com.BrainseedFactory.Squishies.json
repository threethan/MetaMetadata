culuscdn.com/v/t64.5771-25/75322598_1145165853836223_6864148320373849862_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zXrmewv-TM8Q7kNvwHKdu_E&_nc_oc=AdpwOajWXD8PPru8Iy4fJZi5582iLyk635UH1c-FzVMFK87OBGtWWxISgdXjH7PczGg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFk_G66nwVPDcyOahoqo6sclBGJzwUU024n05DJmHYDxg&oe=6A786243"}, {"file_name": "Screenshot03.png", "id": "598340872572801", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39001670_598340875906134_7078948835759736288_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LpEI4iRCjeoQ7kNvwEDlOPq&_nc_oc=AdpmysiR2O_wfhZ3woVejSvwro4RQ4xBATTh4A0gPaMzW5ZTIvAeeqwdU3ptItoAso0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFmls9FA7FUe04nmL__1emuE8HePHr0oeDRhUiIufdizQ&oe=6A78988B"}, {"file_name": "Screenshot06.png", "id": "970563445094246", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031450_970563448427579_1896364834470325490_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CFYmsUJce9wQ7kNvwG4uTmj&_nc_oc=AdrXdv3nqkzRb5te93DEMb9PnQx5NjsvBSnnlGdFMpKip2ttZIRGOXjSpDXpnX7_ttQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGng5nEr0QhiixmR2jIpS3QI9QycuwlCytvWCy83cUuQA&oe=6A787FD2"}, {"file_name": "Screenshot04.png", "id": "575729695062740", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031400_575729698396073_2621336866475747103_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BFm9wC4qGGwQ7kNvwHb0Pwu&_nc_oc=AdrgW2yM6fCKZsbTDWLvc-rJYCD3bT0EH6MtURSRw3dnE4k7ROsNZBufOOUWuNWMt8c&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHv6gA4QB20H3DLZcfQir788935zuqZOUte2I797fWEJA&oe=6A7886DC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Gameplay Trailer Thumb.png", "id": "605202028847932", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974836_605202032181265_2417977283558520499_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0DA9qUP3jjcQ7kNvwEHY8Kz&_nc_oc=AdoCHe1AaOKQ_8VYdOiO0ERrHX8JxlJdHTs4aQC5MGxL0yBocNb50Q9wXqP730qlCm0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHdx0TolFpaAaWFWH0SBJVXgeAsRpxBV5y6O4tOHB353w&oe=6A788E99"}, "display_name": "Squishies - Roll them Home!", "keywords": ["puzzle", "platformer", "sandbox", "exploration", "adventure"], "long_description": "**Get lost in the Squishies-verse!**\n\nSquishies is a head-scratching puzzle platformer where you guide courageous and cute creatures through a series of increasingly hazardous, challenging mazes. Use unique motion controls to push and pull the Squishies through their adventures in a colorful universe full of strange flora and fauna. Keep those little rascals safe while they climb, jump, fly and teleport-by-fish through dozens of levels in five alien worlds!\n\n{507625458961423}\n\nYou push and pull the Squishies from one side of the maze to the other, all while earning medals, gathering crystals, climbing slopes, and avoiding pitfalls.\n\n- **Explore a huge universe** - Across dozens of levels in five different worlds.\n- **Collectibles and Achievements** - Gather all the crystals, beat the clock or find the hidden egg in each level.\n- **Level Editor** - Squishies really comes into its own with its innovative, fully featured creation tools.\n- **Community Section** - Share your creation with others and play their ingenious levels.\n- **Limited play space?** Need to keep an eye on your own little monsters?  You\u2019re in luck. Squishies\u00ae can be played in the newly added Mixed Reality mode!\n\n\n{482757334822594}", "short_description": "Help the stranded Squishies find their way back home! Push and pull them through challenging puzzles, or create your own levels with the powerful in-game editor and share them with the community."}]}, "developer_name": null, "developer_privacy_policy_url": "https://brainseed-factory.com/law/privacy_products/index.php", "developer_terms_of_service_url": "https://brainseed-factory.com/law/terms_products/index.php", "publishe
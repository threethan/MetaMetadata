culuscdn.com/v/t64.5771-25/75322598_1145165853836223_6864148320373849862_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2LGNHa1Q_xMQ7kNvwFPbNl_&_nc_oc=AdrWtnOhaQTTCUu3gLYq3xfCwQJqFWOfcLBrKczwP0_PsoG6OLJWUaEIpRnFOKCoWdE&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIoRIhae_A49RXVIckLcKz_QpP9N8dLHHTfAYfjRh1PYA&oe=6AA02783"}, {"file_name": "Screenshot03.png", "id": "598340872572801", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/39001670_598340875906134_7078948835759736288_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lR378ZtydoMQ7kNvwEMYZr4&_nc_oc=AdomKbqruPGHeLJJwOI_7--cJwVp_60FOflWEa9LJlK8hhdw9uM-fGKKCI5wv3QWPKc&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJkJ7gpFbBPtOEdVhXBcUOF6QKl8BMvQlFLJ9pTWVb9_Q&oe=6AA0258B"}, {"file_name": "Screenshot06.png", "id": "970563445094246", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/39031450_970563448427579_1896364834470325490_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F8H6Cd8OBKwQ7kNvwG1_2V8&_nc_oc=AdoB5Tj_VdFNGNWTPMz6zlXZqhM6JeRjdsxliI0467blctQWw7g0Ygw7FQ5zwPKDM0o&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIMof7-Ll6otaopZZuT46c_Cb_Y8xQxz7VYgj08uF2-iA&oe=6AA00CD2"}, {"file_name": "Screenshot04.png", "id": "575729695062740", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/39031400_575729698396073_2621336866475747103_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D3C70NpmJaYQ7kNvwElzJAd&_nc_oc=Adp1OC2oLzchcVKtwGDo0CgU42CUC2DZGFSUPvBHjtCxBgXX8hG6xKcemki_o0bgr8U&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ1AhKo8dm_1yT2rkhFJ2YqChoWojePqNwu4bvfIglf5A&oe=6AA013DC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Gameplay Trailer Thumb.png", "id": "605202028847932", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38974836_605202032181265_2417977283558520499_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fhlMopUVto4Q7kNvwEVtNoY&_nc_oc=Adpoxe_uEl-GKXe56bibJgMa1qcemTwvJ60zitLPssS_7ZVt_A-dw1rLWloanqaptrI&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKcthSAHNPg8UKgydcVUQs8qemvOZWnqcZDGbZjO38iyw&oe=6AA01B99"}, "display_name": "Squishies - Roll them Home!", "keywords": ["puzzle", "platformer", "sandbox", "exploration", "adventure"], "long_description": "**Get lost in the Squishies-verse!**\n\nSquishies is a head-scratching puzzle platformer where you guide courageous and cute creatures through a series of increasingly hazardous, challenging mazes. Use unique motion controls to push and pull the Squishies through their adventures in a colorful universe full of strange flora and fauna. Keep those little rascals safe while they climb, jump, fly and teleport-by-fish through dozens of levels in five alien worlds!\n\n{507625458961423}\n\nYou push and pull the Squishies from one side of the maze to the other, all while earning medals, gathering crystals, climbing slopes, and avoiding pitfalls.\n\n- **Explore a huge universe** - Across dozens of levels in five different worlds.\n- **Collectibles and Achievements** - Gather all the crystals, beat the clock or find the hidden egg in each level.\n- **Level Editor** - Squishies really comes into its own with its innovative, fully featured creation tools.\n- **Community Section** - Share your creation with others and play their ingenious levels.\n- **Limited play space?** Need to keep an eye on your own little monsters?  You\u2019re in luck. Squishies\u00ae can be played in the newly added Mixed Reality mode!\n\n\n{482757334822594}", "short_description": "Help the stranded Squishies find their way back home! Push and pull them through challenging puzzles, or create your own levels with the powerful in-game editor and share them with the community."}]}, "developer_name": null, "developer_privacy_policy_url": "https://brainseed-factory.com/law/privacy_products/index.php", "developer_terms_of_service_url": "https://brainseed-factory.com/law/terms_products/index.php", "publishe
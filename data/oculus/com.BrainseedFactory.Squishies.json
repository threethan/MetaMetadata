uluscdn.com/v/t64.5771-25/75322598_1145165853836223_6864148320373849862_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ixP780GZFNYQ7kNvwHvgHiP&_nc_oc=Adp8YhGh2kXWtFKQEc1_XN1mJuHSGMYIfxYdYSoEonFf74k8o8zzAOHL4jl5k_JURfM&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_cr7nQ__PxJEJK649XWx5V2baMjVzG2ZR1tFk2DdDdLQ&oe=6A355E03"}, {"file_name": "Screenshot03.png", "id": "598340872572801", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39001670_598340875906134_7078948835759736288_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KmasklOg0BYQ7kNvwEtH08G&_nc_oc=AdoByjipd-MPnjvJC3T6iSxU4P4YC0H5yluE1GksUw5aAOOFX05N10Dt6Lm3xvGbCak&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8pCuCgDGq_z4zdikfVzpEIrMR98gqqEI8-MuEQi2-XmQ&oe=6A355C0B"}, {"file_name": "Screenshot06.png", "id": "970563445094246", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031450_970563448427579_1896364834470325490_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=97lE5LJ06wcQ7kNvwG2xfRh&_nc_oc=AdqPcusDomvIsJEG8f1I3fm-Xe1CGLS2VU3nnJPYwb0mYk0Nyyn6GgG3xpq4ZdG6R64&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8gZwcVnnxCCaq86q1WK0PEw-wqyIlFjisAk0iofFWxaA&oe=6A354352"}, {"file_name": "Screenshot04.png", "id": "575729695062740", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39031400_575729698396073_2621336866475747103_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ANblixcDM8cQ7kNvwEJPi_p&_nc_oc=AdowqmucP3sBxSIDiaIsCq7CFynWP1BqPrNzvpNuywY5FpQrdnYVtR5FCdJ-y9Ot4As&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af93mVwmn0Y3uuOlcd-mjVurBjMCpuBhNHRvK96KE9n1sg&oe=6A354A5C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Gameplay Trailer Thumb.png", "id": "605202028847932", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974836_605202032181265_2417977283558520499_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qmBXKLvm3uYQ7kNvwFiUl9m&_nc_oc=AdqzCHgnFsIzG6QjuFdd5Y7U53XmRKpgewV28Fk8Bow0W1ruQw-9LNQYO1Y8RvA8p4Q&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_6Mvvw6ch_ItOFc3EDm2BBceEXc1dTHqgmBunQ13XlLA&oe=6A355219"}, "display_name": "Squishies - Roll them Home!", "keywords": ["puzzle", "platformer", "sandbox", "exploration", "adventure"], "long_description": "**Get lost in the Squishies-verse!**\n\nSquishies is a head-scratching puzzle platformer where you guide courageous and cute creatures through a series of increasingly hazardous, challenging mazes. Use unique motion controls to push and pull the Squishies through their adventures in a colorful universe full of strange flora and fauna. Keep those little rascals safe while they climb, jump, fly and teleport-by-fish through dozens of levels in five alien worlds!\n\n{507625458961423}\n\nYou push and pull the Squishies from one side of the maze to the other, all while earning medals, gathering crystals, climbing slopes, and avoiding pitfalls.\n\n- **Explore a huge universe** - Across dozens of levels in five different worlds.\n- **Collectibles and Achievements** - Gather all the crystals, beat the clock or find the hidden egg in each level.\n- **Level Editor** - Squishies really comes into its own with its innovative, fully featured creation tools.\n- **Community Section** - Share your creation with others and play their ingenious levels.\n- **Limited play space?** Need to keep an eye on your own little monsters?  You\u2019re in luck. Squishies\u00ae can be played in the newly added Mixed Reality mode!\n\n\n{482757334822594}", "short_description": "Help the stranded Squishies find their way back home! Push and pull them through challenging puzzles, or create your own levels with the powerful in-game editor and share them with the community."}]}, "developer_name": null, "developer_privacy_policy_url": "https://brainseed-factory.com/law/privacy_products/index.php", "developer_terms_of_service_url": "https://brainseed-factory.com/law/terms_products/index.php", "publisher
culuscdn.com/v/t64.5771-25/75322598_1145165853836223_6864148320373849862_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6mFSjsEPnnkQ7kNvwE2dROa&_nc_oc=AdqH_pkXhIzbRmR7qZx_8xSP-Idkt7TpfmzzZ2hMwM5Rgfp6GCw98tGLx504yDDNz4U&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8rBgvIDR_ldMo-uIXra2N5MK7HNBxcPP_5p6D_bWrq9A&oe=6A3BF583"}, {"file_name": "Screenshot03.png", "id": "598340872572801", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39001670_598340875906134_7078948835759736288_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P16UX-GRNDgQ7kNvwGxo-0i&_nc_oc=AdrHH-VKfFCvYlfBlz5LKRmoPO1mpuuTQVy7BDlK0VGMjH7_Xv0kms9Ij9wXeUKRCNA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_LSkBwsRmEJ7IHYUMOlXoyLRubAvglf2dAdhefQ0ZcyA&oe=6A3BF38B"}, {"file_name": "Screenshot06.png", "id": "970563445094246", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031450_970563448427579_1896364834470325490_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GJzC_NezhOgQ7kNvwFXz4t1&_nc_oc=AdqLZy0NLRk7WW23Qv79tv7NIsJP6GFMHIrgMGdmQswXluH8nbjqWnxt6K2PB1VOQfw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9UW3dDyvgQdH2BXBQqOyb6eCH6UhAnHou2Zvpjz8FghQ&oe=6A3BDAD2"}, {"file_name": "Screenshot04.png", "id": "575729695062740", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031400_575729698396073_2621336866475747103_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pqcWRmmbYRsQ7kNvwGlBNmY&_nc_oc=AdozEl00IdsigKgQr407_0E4otoTLsWBfe_7aHzL7kY8gxm_1rw18no5UvyHLUqNeNg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9LhTCwi2PGK-Kl8ibgmPWY7nAcTFv1srCDSeN9B_eV_A&oe=6A3BE1DC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Gameplay Trailer Thumb.png", "id": "605202028847932", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974836_605202032181265_2417977283558520499_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8BQaksJwlWwQ7kNvwHcaj5R&_nc_oc=AdqeOs94gPra9LqYLrE9tl7e8rhpjigNvJko0CPBmqmoL6cderSyaVaLsE4ZiC2Qy0o&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_jRYQy_2MSpv3_Lx-Eq6rkQdWRBPX0siFqgjMkx5mn5A&oe=6A3BE999"}, "display_name": "Squishies - Roll them Home!", "keywords": ["puzzle", "platformer", "sandbox", "exploration", "adventure"], "long_description": "**Get lost in the Squishies-verse!**\n\nSquishies is a head-scratching puzzle platformer where you guide courageous and cute creatures through a series of increasingly hazardous, challenging mazes. Use unique motion controls to push and pull the Squishies through their adventures in a colorful universe full of strange flora and fauna. Keep those little rascals safe while they climb, jump, fly and teleport-by-fish through dozens of levels in five alien worlds!\n\n{507625458961423}\n\nYou push and pull the Squishies from one side of the maze to the other, all while earning medals, gathering crystals, climbing slopes, and avoiding pitfalls.\n\n- **Explore a huge universe** - Across dozens of levels in five different worlds.\n- **Collectibles and Achievements** - Gather all the crystals, beat the clock or find the hidden egg in each level.\n- **Level Editor** - Squishies really comes into its own with its innovative, fully featured creation tools.\n- **Community Section** - Share your creation with others and play their ingenious levels.\n- **Limited play space?** Need to keep an eye on your own little monsters?  You\u2019re in luck. Squishies\u00ae can be played in the newly added Mixed Reality mode!\n\n\n{482757334822594}", "short_description": "Help the stranded Squishies find their way back home! Push and pull them through challenging puzzles, or create your own levels with the powerful in-game editor and share them with the community."}]}, "developer_name": null, "developer_privacy_policy_url": "https://brainseed-factory.com/law/privacy_products/index.php", "developer_terms_of_service_url": "https://brainseed-factory.com/law/terms_products/index.php", "publishe
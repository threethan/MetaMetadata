145165853836223_6864148320373849862_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UaQSKp8d4UMQ7kNvwE0KUOY&_nc_oc=AdnyyAAHdw0f6pB3pNaQ_-N9tsK8m9DduFeMNLF5HRjDiHP6lW_Y71-sDf4K7aXsJCQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfxDEYwf1QYNsfs1QmcI7-5lCHw2djgqbebvpIhGMUd5_A&oe=69AFFE43"}, {"file_name": "Screenshot03.png", "id": "598340872572801", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39001670_598340875906134_7078948835759736288_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GAS3JcV4pQIQ7kNvwGar0IA&_nc_oc=Adn6qQbu30yWZ0vriWrW1b6mxT8awKIqp_tWjLOWhBtBniGjPx2YMLMBpBkOEmTaCEA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afx4w-NQsUzOuelQ6yuV6_YTfGm07imY8op0_Pib-2K3ng&oe=69AFFC4B"}, {"file_name": "Screenshot06.png", "id": "970563445094246", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031450_970563448427579_1896364834470325490_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YiYtey508bYQ7kNvwFU0PtR&_nc_oc=AdlPcFJWdskgZzASr1tobzNrVYv_9GdLndYr3-PFmXsJ3MNA-Bf7tIs5c3StJvGYSXM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afz9R0sGftrrX3rBM47IhOpzqX1t75BvrooRW5XIqZnc4g&oe=69B01BD2"}, {"file_name": "Screenshot04.png", "id": "575729695062740", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031400_575729698396073_2621336866475747103_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1Xvj0yRTFcUQ7kNvwHnx9Tn&_nc_oc=Adkfv0xDqwX0N_fSIvFdNCEsXVbPiqAhn5yNIoxM4RgAb9o2vhXyrWAm_CBt4AjyCVE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfzYwD20VNEMGv0jCuZjHh7hqQAX8iOhgfc1w_63qlJJlg&oe=69B022DC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Gameplay Trailer Thumb.png", "id": "605202028847932", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974836_605202032181265_2417977283558520499_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iKonWaugwXcQ7kNvwEsIkqk&_nc_oc=AdnYw8Le7j8xJUjZNgvqGomgVcTVdgiNqCvER1c2uXabGvztud9BKaIYrnJndJ_fYiI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfyqviZmDlgrGhaJNLNOYXi0ArcDStBJNO0P1ML2BJl33Q&oe=69B02A99"}, "display_name": "Squishies - Roll them Home!", "keywords": ["puzzle", "platformer", "sandbox", "exploration", "adventure"], "long_description": "**Get lost in the Squishies-verse!**\n\nSquishies is a head-scratching puzzle platformer where you guide courageous and cute creatures through a series of increasingly hazardous, challenging mazes. Use unique motion controls to push and pull the Squishies through their adventures in a colorful universe full of strange flora and fauna. Keep those little rascals safe while they climb, jump, fly and teleport-by-fish through dozens of levels in five alien worlds!\n\n{507625458961423}\n\nYou push and pull the Squishies from one side of the maze to the other, all while earning medals, gathering crystals, climbing slopes, and avoiding pitfalls.\n\n- **Explore a huge universe** - Across dozens of levels in five different worlds.\n- **Collectibles and Achievements** - Gather all the crystals, beat the clock or find the hidden egg in each level.\n- **Level Editor** - Squishies really comes into its own with its innovative, fully featured creation tools.\n- **Community Section** - Share your creation with others and play their ingenious levels.\n- **Limited play space?** Need to keep an eye on your own little monsters?  You\u2019re in luck. Squishies\u00ae can be played in the newly added Mixed Reality mode!\n\n\n{482757334822594}", "short_description": "Help the stranded Squishies find their way back home! Push and pull them through challenging puzzles, or create your own levels with the powerful in-game editor and share them with the community."}]}, "developer_name": null, "developer_privacy_policy_url": "https://brainseed-factory.com/law/privacy_products/index.php", "developer_terms_of_service_url": "https://brainseed-factory.com/law/terms_products/index.php", "publisher_name": "Perp Games", "support_website_url": null, "webs
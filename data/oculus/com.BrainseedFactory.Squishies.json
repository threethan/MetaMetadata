oe=6A185B0B"}, {"file_name": "Screenshot06.png", "id": "970563445094246", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031450_970563448427579_1896364834470325490_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l4j8BbqG3LQQ7kNvwFaNtwz&_nc_oc=Adq66wrgtAjkqm8gbZzSM3G4JQ_Y90UvuKzDbziiUkOhZAT6JoXaSAYcJeurSofcX34&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6idM9M3u2_Hmls49QgGBFkLILqGtMtfqArYfy3x7zO7Q&oe=6A184252"}, {"file_name": "Screenshot04.png", "id": "575729695062740", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39031400_575729698396073_2621336866475747103_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VxMvvHMl79IQ7kNvwGM4SP-&_nc_oc=AdqKbPM-qewYE7J7n4fW4Pwbv987z9mn8e1WLYca7wehUkmG_gQcP5gkx5W5SHELfLU&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7fr-aI0kS3Ta_FwIN3QhP-VNHZWKoCmSjftpYAZlD5ZQ&oe=6A18495C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Gameplay Trailer Thumb.png", "id": "605202028847932", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974836_605202032181265_2417977283558520499_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ayFFD9aZ6WoQ7kNvwEnTGU7&_nc_oc=Adq5ASbBBfuVApVOZb0i4Jbdimf8Q01aXj5FFXBgq-Zr-F6DcURwJO9tW3TR9Gm16Ck&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4tjKaVGR0vWM3J_MPfcP1kPvF7iAyMXL0IGAZnCN2kvw&oe=6A185119"}, "display_name": "Squishies\u00ae - Roll them Home!", "keywords": ["puzzle", "platformer", "sandbox", "exploration", "adventure"], "long_description": "**Get lost in the Squishies-verse!**\n\nSquishies is a head-scratching puzzle platformer where you guide courageous and cute creatures through a series of increasingly hazardous, challenging mazes. Use unique motion controls to push and pull the Squishies through their adventures in a colorful universe full of strange flora and fauna. Keep those little rascals safe while they climb, jump, fly and teleport-by-fish through dozens of levels in five alien worlds!\n\n{507625458961423}\n\nYou push and pull the Squishies from one side of the maze to the other, all while earning medals, gathering crystals, climbing slopes, and avoiding pitfalls.\n\n- **Explore a huge universe** - Across dozens of levels in five different worlds.\n- **Collectibles and Achievements** - Gather all the crystals, beat the clock or find the hidden egg in each level.\n- **Level Editor** - Squishies really comes into its own with its innovative, fully featured creation tools.\n- **Community Section** - Share your creation with others and play their ingenious levels.\n\n\n{482757334822594}", "short_description": "Help the stranded Squishies find their way back home! Push and pull them through challenging puzzles, or create your own levels with the powerful in-game editor and share them with the community."}]}, "developer_name": null, "developer_privacy_policy_url": "https://brainseed-factory.com/law/privacy_products/index.php", "developer_terms_of_service_url": "https://brainseed-factory.com/law/terms_products/index.php", "publisher_name": "Brainseed Factory", "support_website_url": null, "website_url": "https://www.brainseed-factory.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "528142316460358"}, {"id": "377978390272490"}, {"id": "1990104051447093"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "de", "fr", "es", "it", "zh_CN", "zh_HK", "ja", "ru", "pt", "pt_BR"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "85339153433
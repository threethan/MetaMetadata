145165853836223_6864148320373849862_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N6WzLvEC08gQ7kNvwE7j65m&_nc_oc=Adk3P-glDOfWCa1xvC_Bips07ed4kpSMvbQ1GsvY_QjlmU3fN9x-u-DLIirFsozxGGE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfxLMhF_VLM3UoXIIVy7SYvKMkG07SkBdsf4z8K6hZ4L9w&oe=69B2A143"}, {"file_name": "Screenshot03.png", "id": "598340872572801", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39001670_598340875906134_7078948835759736288_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BN3ANZmc7KYQ7kNvwEqvZdY&_nc_oc=AdkplXZoKN-xCzvlJnZc9_38Vd0KnTw_tRvNqeaMMEBLpgr95-nfODD_jPAw0p0v0jI&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfxfFXZTgJpigCKrCzsu40Y_7aqJ_8Nb8x0zjxZUO4ejyQ&oe=69B29F4B"}, {"file_name": "Screenshot06.png", "id": "970563445094246", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031450_970563448427579_1896364834470325490_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s7XPvR8Rv_wQ7kNvwErHn3i&_nc_oc=Adk8OWR1TGltuf_ZdzWF68Y_76KhEFVYqAnnV2ryDganpudFDQblBYALyC-a429ulgs&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_Afx9NVTNQyhxlnnhH51FEbqa3dMZ-EuH6XbN-MuqIPhGmg&oe=69B2BED2"}, {"file_name": "Screenshot04.png", "id": "575729695062740", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031400_575729698396073_2621336866475747103_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1Xvj0yRTFcUQ7kNvwEwV2gT&_nc_oc=AdmTXjd9-IGUKOB6AsGVZFtcuuRGjCN4zZPoG_h1xJzADzI5MUbWHGhY9fRJO-EFARY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfwMQN6Hmb48Dq3JO4639J_FZIsF0FK9xnnF3bE-uAg5jA&oe=69B2C5DC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Gameplay Trailer Thumb.png", "id": "605202028847932", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974836_605202032181265_2417977283558520499_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LSSx3lh8RyMQ7kNvwEVL4PA&_nc_oc=AdmLOYxlhegb-KFmSenmVh2-BHKK8uv9wYwaip3PxJaXfhZAyebS7nq2a7RWFZvrYSg&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfxL17b0kljySPSdZ0SEtY_MWKLIyS1r95BT2WERudAimg&oe=69B2CD99"}, "display_name": "Squishies - Roll them Home!", "keywords": ["puzzle", "platformer", "sandbox", "exploration", "adventure"], "long_description": "**Get lost in the Squishies-verse!**\n\nSquishies is a head-scratching puzzle platformer where you guide courageous and cute creatures through a series of increasingly hazardous, challenging mazes. Use unique motion controls to push and pull the Squishies through their adventures in a colorful universe full of strange flora and fauna. Keep those little rascals safe while they climb, jump, fly and teleport-by-fish through dozens of levels in five alien worlds!\n\n{507625458961423}\n\nYou push and pull the Squishies from one side of the maze to the other, all while earning medals, gathering crystals, climbing slopes, and avoiding pitfalls.\n\n- **Explore a huge universe** - Across dozens of levels in five different worlds.\n- **Collectibles and Achievements** - Gather all the crystals, beat the clock or find the hidden egg in each level.\n- **Level Editor** - Squishies really comes into its own with its innovative, fully featured creation tools.\n- **Community Section** - Share your creation with others and play their ingenious levels.\n- **Limited play space?** Need to keep an eye on your own little monsters?  You\u2019re in luck. Squishies\u00ae can be played in the newly added Mixed Reality mode!\n\n\n{482757334822594}", "short_description": "Help the stranded Squishies find their way back home! Push and pull them through challenging puzzles, or create your own levels with the powerful in-game editor and share them with the community."}]}, "developer_name": null, "developer_privacy_policy_url": "https://brainseed-factory.com/law/privacy_products/index.php", "developer_terms_of_service_url": "https://brainseed-factory.com/law/terms_products/index.php", "publisher_name": "Perp Games", "support_website_url": null, "webs
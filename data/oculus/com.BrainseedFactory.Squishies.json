145165853836223_6864148320373849862_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0Bv0kZZuLx0Q7kNvwGnz0oS&_nc_oc=AdlYCmkqVOlcwFZm3eCa8dPhfKlTyrKcpzvsqy5vwp_MsJxzLTPw0IFHAXBILFui2Aw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_Afvfysw0BzxmM0nF1AfsUwkVSabXTSTcjf4e2zciHQibVg&oe=69A966C3"}, {"file_name": "Screenshot03.png", "id": "598340872572801", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39001670_598340875906134_7078948835759736288_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IMMbzY_CREkQ7kNvwFZwXVT&_nc_oc=Adl3qxhn09HAHC8sbJ7KI30QoYZGP8riqmC0Zn3FRil7vgK6g6FmZw1wTalw4YACK2Q&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfskgSnfauypRVVrBE-jyQHqbZG1_B3q0VJyLOmy8zDUDw&oe=69A964CB"}, {"file_name": "Screenshot06.png", "id": "970563445094246", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031450_970563448427579_1896364834470325490_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iLzeNXXYUmUQ7kNvwF2z_Bm&_nc_oc=Adn_2o5I_1BOQSVf51PDPT2xAuVmDDz60WDrOHajQpALKHNqc65Bgwfk1h0-_wn7dNQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_Afs-boFFIDeY1nvlKpJB3CssHBfUN6PFXjxiUPJdEhrxXw&oe=69A98452"}, {"file_name": "Screenshot04.png", "id": "575729695062740", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031400_575729698396073_2621336866475747103_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AdINWNzAG7YQ7kNvwFsxGL5&_nc_oc=AdkQdNfcRQGfdFvuugoiEWcv2AW0s-bRe-cqfm3Q11yAtMFyUtqwcg8BQVpzgvz3j-4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_Afs1BdaOG3UnBt9qfFTizUbyJjlTv_wRuxvob_0UNmsidg&oe=69A98B5C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Gameplay Trailer Thumb.png", "id": "605202028847932", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974836_605202032181265_2417977283558520499_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VH6J-z2d5L0Q7kNvwHXZULo&_nc_oc=AdmHzLXHYonYN3b7B9uYQxNIYRAT_83WSvM5VXArdHh9DURHL-E21lLB3RdtUYfpwJM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfuVYthW8NDdI3na_w39tC5BsRYVGpWLkGqksAEYkIHEOQ&oe=69A99319"}, "display_name": "Squishies - Roll them Home!", "keywords": ["puzzle", "platformer", "sandbox", "exploration", "adventure"], "long_description": "**Get lost in the Squishies-verse!**\n\nSquishies is a head-scratching puzzle platformer where you guide courageous and cute creatures through a series of increasingly hazardous, challenging mazes. Use unique motion controls to push and pull the Squishies through their adventures in a colorful universe full of strange flora and fauna. Keep those little rascals safe while they climb, jump, fly and teleport-by-fish through dozens of levels in five alien worlds!\n\n{507625458961423}\n\nYou push and pull the Squishies from one side of the maze to the other, all while earning medals, gathering crystals, climbing slopes, and avoiding pitfalls.\n\n- **Explore a huge universe** - Across dozens of levels in five different worlds.\n- **Collectibles and Achievements** - Gather all the crystals, beat the clock or find the hidden egg in each level.\n- **Level Editor** - Squishies really comes into its own with its innovative, fully featured creation tools.\n- **Community Section** - Share your creation with others and play their ingenious levels.\n- **Limited play space?** Need to keep an eye on your own little monsters?  You\u2019re in luck. Squishies\u00ae can be played in the newly added Mixed Reality mode!\n\n\n{482757334822594}", "short_description": "Help the stranded Squishies find their way back home! Push and pull them through challenging puzzles, or create your own levels with the powerful in-game editor and share them with the community."}]}, "developer_name": null, "developer_privacy_policy_url": "https://brainseed-factory.com/law/privacy_products/index.php", "developer_terms_of_service_url": "https://brainseed-factory.com/law/terms_products/index.php", "publisher_name": "Perp Games", "support_website_url": null, "webs
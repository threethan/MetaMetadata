culuscdn.com/v/t64.5771-25/75322598_1145165853836223_6864148320373849862_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vK4msK3EcQcQ7kNvwEyYWKn&_nc_oc=Adoy-Tl_QrNMenqpErg6q0LQmMcjAM7Gg_tg2R6pWB7BXWWmRp5QoFLtwddvKzhQLN0&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHxfkYsGqIVAI0R4u1MvRYjEg06P4BeLsbOB5IVmORgCg&oe=6A720303"}, {"file_name": "Screenshot03.png", "id": "598340872572801", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39001670_598340875906134_7078948835759736288_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6R1opDbihO4Q7kNvwGsB2_2&_nc_oc=AdqcNbwC9DOtVmUpSvk-abtjR4TOXhiuUyujQrVaFEzioqunMuYQ0bwK4RTptz1fuHM&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEJ44MKQCk5TRtXuEKOtHbzB26lo0NT4zczS2dgpCbvzg&oe=6A72010B"}, {"file_name": "Screenshot06.png", "id": "970563445094246", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39031450_970563448427579_1896364834470325490_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tXhNsSbkKb8Q7kNvwFSyGu7&_nc_oc=Adp-fLuCRSgvhK-Qli9mUXWpg70bHs_W7AaXDd4ZkM7ecJipQmGG7KMj0f97v_GhchA&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGbqVod8cXW9uHqJCVB9b94yzk7p2n5iyQC4Dun3w-LWQ&oe=6A71E852"}, {"file_name": "Screenshot04.png", "id": "575729695062740", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39031400_575729698396073_2621336866475747103_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Q-OsQfAvgYIQ7kNvwEwB53B&_nc_oc=AdoAC4WVAYIU6aPv2kxtB1pMWos1gjEyYiJy5hViScW6uZiBmadQW04BpG5BZV8FcgU&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEN-gC4iPrSpzGakLDrPBmPCy4_z4feoI4cPm6iaSseRQ&oe=6A71EF5C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Gameplay Trailer Thumb.png", "id": "605202028847932", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974836_605202032181265_2417977283558520499_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hBxytTA4vSIQ7kNvwGiAyyn&_nc_oc=AdqodoDl4KuQS9kNrmB8A4kjldusdm1ZjjK8oTXdU-s4WVasm05NZvluSzxoavCMo2U&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHgDsQmGVbWc7H_smgX4D5USU4mgmQm1eTBO7t0V_OrEA&oe=6A71F719"}, "display_name": "Squishies - Roll them Home!", "keywords": ["puzzle", "platformer", "sandbox", "exploration", "adventure"], "long_description": "**Get lost in the Squishies-verse!**\n\nSquishies is a head-scratching puzzle platformer where you guide courageous and cute creatures through a series of increasingly hazardous, challenging mazes. Use unique motion controls to push and pull the Squishies through their adventures in a colorful universe full of strange flora and fauna. Keep those little rascals safe while they climb, jump, fly and teleport-by-fish through dozens of levels in five alien worlds!\n\n{507625458961423}\n\nYou push and pull the Squishies from one side of the maze to the other, all while earning medals, gathering crystals, climbing slopes, and avoiding pitfalls.\n\n- **Explore a huge universe** - Across dozens of levels in five different worlds.\n- **Collectibles and Achievements** - Gather all the crystals, beat the clock or find the hidden egg in each level.\n- **Level Editor** - Squishies really comes into its own with its innovative, fully featured creation tools.\n- **Community Section** - Share your creation with others and play their ingenious levels.\n- **Limited play space?** Need to keep an eye on your own little monsters?  You\u2019re in luck. Squishies\u00ae can be played in the newly added Mixed Reality mode!\n\n\n{482757334822594}", "short_description": "Help the stranded Squishies find their way back home! Push and pull them through challenging puzzles, or create your own levels with the powerful in-game editor and share them with the community."}]}, "developer_name": null, "developer_privacy_policy_url": "https://brainseed-factory.com/law/privacy_products/index.php", "developer_terms_of_service_url": "https://brainseed-factory.com/law/terms_products/index.php", "publishe
uluscdn.com/v/t64.5771-25/75322598_1145165853836223_6864148320373849862_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6tkjwhLmhGAQ7kNvwEx1A9-&_nc_oc=AdqXcnA8jYRRkvaPhILCUpLLR1IUwoDU9mA3rwwNmIvDckF1ujXNtd1V8NXzMhJRo6s&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2NDEr-0oRj9PKgbFo-_kGnjQanTPh0bj2ObZZ9GDp4iQ&oe=69E75D43"}, {"file_name": "Screenshot03.png", "id": "598340872572801", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/39001670_598340875906134_7078948835759736288_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0QYXJlEwEToQ7kNvwERPQ7Q&_nc_oc=AdodHiGF6C3w70uiO6dyDXBdM0ZrhzPg57N_1a2Qro4KJW1HKCleoSvie0nhmIT15qc&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af24N2nsCZMTmton5_-oahgKXakbZVdeLpId20jXJh1xJw&oe=69E75B4B"}, {"file_name": "Screenshot06.png", "id": "970563445094246", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/39031450_970563448427579_1896364834470325490_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gD1t-LDbUEsQ7kNvwEMQwlC&_nc_oc=AdqHoGllq8SL_8z-fv8dgxVqxa4m4KVOLw-V6ZpZ8uGYQJD-YuTV9v_7xialIbOhulc&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2kdQGI4nVZMb_Rl2ikf_tOK4SHA7Mdq_eJ_OKfmJagLw&oe=69E77AD2"}, {"file_name": "Screenshot04.png", "id": "575729695062740", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/39031400_575729698396073_2621336866475747103_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZvTb7J_d4tUQ7kNvwFlvljO&_nc_oc=AdqP4SIJA2G0OlmRupmKxJ4jGWIrVYQXDzPeWePN43yhtRRPbQ344T9TqRjeCWCwluk&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2yrUKu23lAzL73DwbnPDxR5_pNBRQfwYXKDYSTrA-Flw&oe=69E781DC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Gameplay Trailer Thumb.png", "id": "605202028847932", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38974836_605202032181265_2417977283558520499_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2_FmoQzT3pMQ7kNvwFMBWzf&_nc_oc=Adq3UvF-Y7D--CzO-kq9FLREl7de-T4E9CHqvyY_r35mTsEIx7V9nGBpkq938R7qGK4&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2b7PFqX0jzHV11dDC82Ar09MDGeMsUxeEsYJ7dUXR4Fw&oe=69E78999"}, "display_name": "Squishies - Roll them Home!", "keywords": ["puzzle", "platformer", "sandbox", "exploration", "adventure"], "long_description": "**Get lost in the Squishies-verse!**\n\nSquishies is a head-scratching puzzle platformer where you guide courageous and cute creatures through a series of increasingly hazardous, challenging mazes. Use unique motion controls to push and pull the Squishies through their adventures in a colorful universe full of strange flora and fauna. Keep those little rascals safe while they climb, jump, fly and teleport-by-fish through dozens of levels in five alien worlds!\n\n{507625458961423}\n\nYou push and pull the Squishies from one side of the maze to the other, all while earning medals, gathering crystals, climbing slopes, and avoiding pitfalls.\n\n- **Explore a huge universe** - Across dozens of levels in five different worlds.\n- **Collectibles and Achievements** - Gather all the crystals, beat the clock or find the hidden egg in each level.\n- **Level Editor** - Squishies really comes into its own with its innovative, fully featured creation tools.\n- **Community Section** - Share your creation with others and play their ingenious levels.\n- **Limited play space?** Need to keep an eye on your own little monsters?  You\u2019re in luck. Squishies\u00ae can be played in the newly added Mixed Reality mode!\n\n\n{482757334822594}", "short_description": "Help the stranded Squishies find their way back home! Push and pull them through challenging puzzles, or create your own levels with the powerful in-game editor and share them with the community."}]}, "developer_name": null, "developer_privacy_policy_url": "https://brainseed-factory.com/law/privacy_products/index.php", "developer_terms_of_service_url": "https://brainseed-factory.com/law/terms_products/index.php", "publisher
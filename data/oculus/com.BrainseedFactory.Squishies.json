uluscdn.com/v/t64.5771-25/75322598_1145165853836223_6864148320373849862_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J7gBf8T5YgEQ7kNvwEeG0oG&_nc_oc=AdqsNZzMphWqtXJwnHeQp9GKh_7VyuyixTuOWoK_3cPdzOZU1S5dg8a924HexLAUHZE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4e-s69LxB5L3QNwgHZX1TSgz3BUf1fqKJgAItDA02NjQ&oe=6A1EF483"}, {"file_name": "Screenshot03.png", "id": "598340872572801", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39001670_598340875906134_7078948835759736288_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ySTG0WbijuAQ7kNvwENk5V9&_nc_oc=AdrBjBwefD5Cju6QGW-7xBd8-e0N7eM-VOiB3Owx0872zjnTNt40jOxbhwkMUU4U_T4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af53ilggxfD9ELTrmOPB7lDBbhRSNjoLRgch--lAFMs6mA&oe=6A1EF28B"}, {"file_name": "Screenshot06.png", "id": "970563445094246", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031450_970563448427579_1896364834470325490_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BjGcm9ILluIQ7kNvwEpXCyH&_nc_oc=Adp1fSjCSWjyg8KnVM2RtpGQ_1MUniHqObBFGj5uj4xS7ukp7H2qa3GfnMzR4GsvC8Y&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7M_XVS-ewtsqa42PfiSRGOP8JgMNrfhX6BNf--UNG4hQ&oe=6A1ED9D2"}, {"file_name": "Screenshot04.png", "id": "575729695062740", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031400_575729698396073_2621336866475747103_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P6-xaKhvJMEQ7kNvwEOILW2&_nc_oc=AdognigaxWXwx5dFw5Ka5kCzx5K2HdoQoeuLGy23oOp833NDObCUh_oOyM1rHWQEKo8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5iEtEqOLfKkvcqYitFxDFu6MK-uG8ebRBTXPXrYBOS9w&oe=6A1EE0DC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Gameplay Trailer Thumb.png", "id": "605202028847932", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974836_605202032181265_2417977283558520499_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D9x0utyn5fAQ7kNvwFEl-I0&_nc_oc=Adrfv8OCdufhICoJ9FAvmGOivKVvMBDk42a8kVjrPCcRjy6TT_SlOhTjt3DBOdlq_Ss&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5ZG_erm0NmlOVQIO-udqtUktldeS9LHl7CKJNtCKrYiA&oe=6A1EE899"}, "display_name": "Squishies - Roll them Home!", "keywords": ["puzzle", "platformer", "sandbox", "exploration", "adventure"], "long_description": "**Get lost in the Squishies-verse!**\n\nSquishies is a head-scratching puzzle platformer where you guide courageous and cute creatures through a series of increasingly hazardous, challenging mazes. Use unique motion controls to push and pull the Squishies through their adventures in a colorful universe full of strange flora and fauna. Keep those little rascals safe while they climb, jump, fly and teleport-by-fish through dozens of levels in five alien worlds!\n\n{507625458961423}\n\nYou push and pull the Squishies from one side of the maze to the other, all while earning medals, gathering crystals, climbing slopes, and avoiding pitfalls.\n\n- **Explore a huge universe** - Across dozens of levels in five different worlds.\n- **Collectibles and Achievements** - Gather all the crystals, beat the clock or find the hidden egg in each level.\n- **Level Editor** - Squishies really comes into its own with its innovative, fully featured creation tools.\n- **Community Section** - Share your creation with others and play their ingenious levels.\n- **Limited play space?** Need to keep an eye on your own little monsters?  You\u2019re in luck. Squishies\u00ae can be played in the newly added Mixed Reality mode!\n\n\n{482757334822594}", "short_description": "Help the stranded Squishies find their way back home! Push and pull them through challenging puzzles, or create your own levels with the powerful in-game editor and share them with the community."}]}, "developer_name": null, "developer_privacy_policy_url": "https://brainseed-factory.com/law/privacy_products/index.php", "developer_terms_of_service_url": "https://brainseed-factory.com/law/terms_products/index.php", "publisher
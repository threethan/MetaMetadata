culuscdn.com/v/t64.5771-25/75322598_1145165853836223_6864148320373849862_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fcBa2wnH_0oQ7kNvwHWjYpN&_nc_oc=AdrFAhESY23DNB7leZtdkwWlx6rpr3DQtCyz7UXfBe3OF8Pdhm1hR4Ra5D7-gDIbzNw&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOwcZ04V3AvP2ElTWlekegRo2Ys1eimsUV_meLOBjmrFg&oe=6AC90603"}, {"file_name": "Screenshot03.png", "id": "598340872572801", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/39001670_598340875906134_7078948835759736288_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XKVwXYzEbWUQ7kNvwHSJsIN&_nc_oc=AdqCeyP7UX-8gmbyJx4e4cx17Elr2qJCTm4B9JfRdCqmVaDMqssbIAoMQIetLGS4BHI&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPbju3gXLNqS4IQDT5hfmBYzSuO7KYJ-Cyp2m5fLljZrw&oe=6AC9040B"}, {"file_name": "Screenshot06.png", "id": "970563445094246", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/39031450_970563448427579_1896364834470325490_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dNSNRpAfmhgQ7kNvwEfnrCQ&_nc_oc=Adq-H0j6CN9_dQ25VyYZBhcoEfHuyUZK0Q3Zv6GnyDF6g-QunrYblL9MKwbOKS6e6I8&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQODu7eMMlA9OLYQ1dZIIMzuyATiFRCfm79UeA2vKuC0uA&oe=6AC8EB52"}, {"file_name": "Screenshot04.png", "id": "575729695062740", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/39031400_575729698396073_2621336866475747103_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jKNnYpFYFO4Q7kNvwHyHm56&_nc_oc=Adpv7DsKGRZ4misIfg_l9cUjSZ-Kmuwwiy6fsEhfWU6bGSjclrKdUeZDNBT-jm0xObk&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN0hv33TJsh_TwuJbz3SK9cTJ7-P1Xa2_qpiDJA3Jg0qA&oe=6AC8F25C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Gameplay Trailer Thumb.png", "id": "605202028847932", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38974836_605202032181265_2417977283558520499_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yT9MIMU8h6oQ7kNvwEvObbz&_nc_oc=AdqiaDv7qCA3gny84T0bAWa26MEWCIJS2gnVjOpuG5oqnbx2SKIgRO4RsMnbOz94MX0&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP8zzaiuAbGtiX_RPK0yuHNfxGbnS514ptZ1JdGNHoEgg&oe=6AC8FA19"}, "display_name": "Squishies - Roll them Home!", "keywords": ["puzzle", "platformer", "sandbox", "exploration", "adventure"], "long_description": "**Get lost in the Squishies-verse!**\n\nSquishies is a head-scratching puzzle platformer where you guide courageous and cute creatures through a series of increasingly hazardous, challenging mazes. Use unique motion controls to push and pull the Squishies through their adventures in a colorful universe full of strange flora and fauna. Keep those little rascals safe while they climb, jump, fly and teleport-by-fish through dozens of levels in five alien worlds!\n\n{507625458961423}\n\nYou push and pull the Squishies from one side of the maze to the other, all while earning medals, gathering crystals, climbing slopes, and avoiding pitfalls.\n\n- **Explore a huge universe** - Across dozens of levels in five different worlds.\n- **Collectibles and Achievements** - Gather all the crystals, beat the clock or find the hidden egg in each level.\n- **Level Editor** - Squishies really comes into its own with its innovative, fully featured creation tools.\n- **Community Section** - Share your creation with others and play their ingenious levels.\n- **Limited play space?** Need to keep an eye on your own little monsters?  You\u2019re in luck. Squishies\u00ae can be played in the newly added Mixed Reality mode!\n\n\n{482757334822594}", "short_description": "Help the stranded Squishies find their way back home! Push and pull them through challenging puzzles, or create your own levels with the powerful in-game editor and share them with the community."}]}, "developer_name": null, "developer_privacy_policy_url": "https://brainseed-factory.com/law/privacy_products/index.php", "developer_terms_of_service_url": "https://brainseed-factory.com/law/terms_products/index.php", "publishe
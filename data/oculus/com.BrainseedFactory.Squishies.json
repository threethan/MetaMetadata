culuscdn.com/v/t64.5771-25/75322598_1145165853836223_6864148320373849862_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZJuw16arD14Q7kNvwEFrp_O&_nc_oc=AdrzvlKAD2Bpc96aRjhWSHIeJlP4qvjolP6rx-6mCbzsPnra3saLDoas9fVCuWIp6CE&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR8JhGSXJnDyKQbo8sfz4g2o4QEzmE4m-NHTPYr91kvvA&oe=6AF9CD83"}, {"file_name": "Screenshot03.png", "id": "598340872572801", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39001670_598340875906134_7078948835759736288_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=14dqk3G-CzcQ7kNvwF6zFTw&_nc_oc=Adps_my5dQ_6G-V7gJjNnPZ1vcoXX0pT0WYy7nMvIqwDdnsm64y69e_2ehU84r0lpRA&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR0xStIoxUAMlDmOH5DV3YCzKDls7xBYPpVSt-6HWpTvQ&oe=6AF9CB8B"}, {"file_name": "Screenshot06.png", "id": "970563445094246", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/39031450_970563448427579_1896364834470325490_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AOo7GUTZPCoQ7kNvwGXRB7D&_nc_oc=AdrFzt_YgxTrXcd6i8gv8aLB4SBm7v831Mn9RvYycRSXnx0BEy4V03gPEC6XVNM87zs&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQShBA3-UAW-d15SDWTMJ0KjIbeKiJk6cEXvgpHzzUMRRQ&oe=6AF9EB12"}, {"file_name": "Screenshot04.png", "id": "575729695062740", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39031400_575729698396073_2621336866475747103_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HmzPwsmHGGYQ7kNvwHwTN68&_nc_oc=AdrTjsYa-Z-3MikMvRNDzoRI9ww4nZIEhRLN0MPJBf_FI3GR-9IUxy4FlRMFVOkVdI4&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQjf8bIgMmm-q1tb9dLl-VIz3sE6oDgRrG9BXGHe8jyDQ&oe=6AF9B9DC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Gameplay Trailer Thumb.png", "id": "605202028847932", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/38974836_605202032181265_2417977283558520499_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yBMrPlAdo_UQ7kNvwGwjMle&_nc_oc=AdogzBElEc0Pbq8orCdyNC7H0YldXqDNmbRetEqruOya-7eXZ5TjPK5I234vYE23OOA&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQpfxzGcZ0pCSaaqYPu_GvkfzxJMjMtu2QwdToveTyMAQ&oe=6AF9C199"}, "display_name": "Squishies - Roll them Home!", "keywords": ["puzzle", "platformer", "sandbox", "exploration", "adventure"], "long_description": "**Get lost in the Squishies-verse!**\n\nSquishies is a head-scratching puzzle platformer where you guide courageous and cute creatures through a series of increasingly hazardous, challenging mazes. Use unique motion controls to push and pull the Squishies through their adventures in a colorful universe full of strange flora and fauna. Keep those little rascals safe while they climb, jump, fly and teleport-by-fish through dozens of levels in five alien worlds!\n\n{507625458961423}\n\nYou push and pull the Squishies from one side of the maze to the other, all while earning medals, gathering crystals, climbing slopes, and avoiding pitfalls.\n\n- **Explore a huge universe** - Across dozens of levels in five different worlds.\n- **Collectibles and Achievements** - Gather all the crystals, beat the clock or find the hidden egg in each level.\n- **Level Editor** - Squishies really comes into its own with its innovative, fully featured creation tools.\n- **Community Section** - Share your creation with others and play their ingenious levels.\n- **Limited play space?** Need to keep an eye on your own little monsters?  You\u2019re in luck. Squishies\u00ae can be played in the newly added Mixed Reality mode!\n\n\n{482757334822594}", "short_description": "Help the stranded Squishies find their way back home! Push and pull them through challenging puzzles, or create your own levels with the powerful in-game editor and share them with the community."}]}, "developer_name": null, "developer_privacy_policy_url": "https://brainseed-factory.com/law/privacy_products/index.php", "developer_terms_of_service_url": "https://brainseed-factory.com/law/terms_products/index.php", "publishe
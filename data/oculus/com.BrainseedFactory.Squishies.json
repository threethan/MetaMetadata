culuscdn.com/v/t64.5771-25/75322598_1145165853836223_6864148320373849862_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=maZp_3PO5mAQ7kNvwH1wWGJ&_nc_oc=AdoMA7aUbOOmLLzd92G2AIcFvbpa2kH10BpbyfuFRawbkCNZ4bCwhIPrLBH3QWfpsOI&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQs2yD3nTlLW7iguEPT5A8dWc9a_Z_g_B16KwGr4g8vDw&oe=6AF33603"}, {"file_name": "Screenshot03.png", "id": "598340872572801", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39001670_598340875906134_7078948835759736288_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=45lVJ1UsYZAQ7kNvwHByi2_&_nc_oc=Adrafdgk1VboQ1e86D3D4R-74JedgFmppAeZ1qpjMPJ5NraLcj0k2eKLHTo50vMWoTE&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTyuY3nXMfwlh5kEcpbj0Tdsye7tHWl0IFaEjxKXyYZvw&oe=6AF3340B"}, {"file_name": "Screenshot06.png", "id": "970563445094246", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39031450_970563448427579_1896364834470325490_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=beNcAH0PTDQQ7kNvwFFcVoX&_nc_oc=Adp426jxevG3tvLyyU-B_CM62JgkvLUnuw7GHx5KtuAk88kHFai6eQLgKeZdt_0wUdo&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR-KLBoW0ayt3-1zonjZLyKFc1ehIkMWl7ORHyvzX-vTQ&oe=6AF35392"}, {"file_name": "Screenshot04.png", "id": "575729695062740", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39031400_575729698396073_2621336866475747103_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l17LrTMUP_QQ7kNvwE36FWh&_nc_oc=Adooc42DLc71XNScl7_EAWnLeJ5-DSb5pfpL93khayxyv6glYfhy64SYEAeVKXlaUl8&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS0jnzdT2JOn_EcQ5L5zrfGWwHZyaiVlnVuUXEkFYiI4Q&oe=6AF35A9C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Gameplay Trailer Thumb.png", "id": "605202028847932", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974836_605202032181265_2417977283558520499_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IkstTQbOaWIQ7kNvwFeFWnT&_nc_oc=AdqMFZRCeGB6iJWSiuWdMSTlOP5lLI1GeeCDaqwTEyARM_tiPROnGp6ZtmtFEfhdGas&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQROqb5p6x0FrwAJaKfKrLRK3tAxnq0KKi4f5yq0t1A9HA&oe=6AF32A19"}, "display_name": "Squishies - Roll them Home!", "keywords": ["puzzle", "platformer", "sandbox", "exploration", "adventure"], "long_description": "**Get lost in the Squishies-verse!**\n\nSquishies is a head-scratching puzzle platformer where you guide courageous and cute creatures through a series of increasingly hazardous, challenging mazes. Use unique motion controls to push and pull the Squishies through their adventures in a colorful universe full of strange flora and fauna. Keep those little rascals safe while they climb, jump, fly and teleport-by-fish through dozens of levels in five alien worlds!\n\n{507625458961423}\n\nYou push and pull the Squishies from one side of the maze to the other, all while earning medals, gathering crystals, climbing slopes, and avoiding pitfalls.\n\n- **Explore a huge universe** - Across dozens of levels in five different worlds.\n- **Collectibles and Achievements** - Gather all the crystals, beat the clock or find the hidden egg in each level.\n- **Level Editor** - Squishies really comes into its own with its innovative, fully featured creation tools.\n- **Community Section** - Share your creation with others and play their ingenious levels.\n- **Limited play space?** Need to keep an eye on your own little monsters?  You\u2019re in luck. Squishies\u00ae can be played in the newly added Mixed Reality mode!\n\n\n{482757334822594}", "short_description": "Help the stranded Squishies find their way back home! Push and pull them through challenging puzzles, or create your own levels with the powerful in-game editor and share them with the community."}]}, "developer_name": null, "developer_privacy_policy_url": "https://brainseed-factory.com/law/privacy_products/index.php", "developer_terms_of_service_url": "https://brainseed-factory.com/law/terms_products/index.php", "publishe
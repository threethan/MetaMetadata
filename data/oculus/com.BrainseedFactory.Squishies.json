culuscdn.com/v/t64.5771-25/75322598_1145165853836223_6864148320373849862_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6JLofxLaDDEQ7kNvwE3jGR-&_nc_oc=AdoRj_eK0v6J9NRP7daGZeXyqC0clxA0S8_p1QrPak4V6MM77ugHVroS6f6EDR7foVw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAqUeqeXVXj35bfcpWKbiVy9Qv2rp9cjZ1Sk3J9MGbUYA&oe=6A492483"}, {"file_name": "Screenshot03.png", "id": "598340872572801", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39001670_598340875906134_7078948835759736288_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E7BduReb1LAQ7kNvwEwPp_A&_nc_oc=AdryRbMqQz6CIJymkCIUwfRe_x4vnDn0f_RLIIBSr5dytAsrzI7-DeEt8Hkv3I5T0qk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAp_Q1oZ_CeZMBMsT8bTr6XEi6v9RVkyDb6vBmd3XsN4w&oe=6A49228B"}, {"file_name": "Screenshot06.png", "id": "970563445094246", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031450_970563448427579_1896364834470325490_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wNlQxfmNGB0Q7kNvwEEFCmT&_nc_oc=AdoAkRMzQeTUB1MmL8jezgkR1fOk-7R7b6egU7s4o0NPRJaU0dM-c9jZ_Dj7w9g4PfE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDw4W2bTqY4vppUCwnrLvXT-UpqemrmWS4cHvymMb-xQg&oe=6A4909D2"}, {"file_name": "Screenshot04.png", "id": "575729695062740", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031400_575729698396073_2621336866475747103_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e0uhuaetfY0Q7kNvwH5wDzl&_nc_oc=AdqoROAz7FeFHt-JGsXZ3028xdYaLs_ZMNtRtsT66Dyl9mXyL46x1lo8pBA5GsxIo2s&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAArL_ZBabEVrcmOvwh8P2zgCs2u59gjQ6rfxsKLOg_3A&oe=6A4910DC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Gameplay Trailer Thumb.png", "id": "605202028847932", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974836_605202032181265_2417977283558520499_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A-0NJzbO6fcQ7kNvwGG_a4L&_nc_oc=Adop6FS12euoJ2w6L4z7u3vT3JNw1jNB2JNso0gclXHr8LAXuWzTK6PlDi5S36OZCfc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBtkQOfjDIpmx9xHpkICqzaFv4QdgxaxQwjo6nR9h-TKA&oe=6A491899"}, "display_name": "Squishies - Roll them Home!", "keywords": ["puzzle", "platformer", "sandbox", "exploration", "adventure"], "long_description": "**Get lost in the Squishies-verse!**\n\nSquishies is a head-scratching puzzle platformer where you guide courageous and cute creatures through a series of increasingly hazardous, challenging mazes. Use unique motion controls to push and pull the Squishies through their adventures in a colorful universe full of strange flora and fauna. Keep those little rascals safe while they climb, jump, fly and teleport-by-fish through dozens of levels in five alien worlds!\n\n{507625458961423}\n\nYou push and pull the Squishies from one side of the maze to the other, all while earning medals, gathering crystals, climbing slopes, and avoiding pitfalls.\n\n- **Explore a huge universe** - Across dozens of levels in five different worlds.\n- **Collectibles and Achievements** - Gather all the crystals, beat the clock or find the hidden egg in each level.\n- **Level Editor** - Squishies really comes into its own with its innovative, fully featured creation tools.\n- **Community Section** - Share your creation with others and play their ingenious levels.\n- **Limited play space?** Need to keep an eye on your own little monsters?  You\u2019re in luck. Squishies\u00ae can be played in the newly added Mixed Reality mode!\n\n\n{482757334822594}", "short_description": "Help the stranded Squishies find their way back home! Push and pull them through challenging puzzles, or create your own levels with the powerful in-game editor and share them with the community."}]}, "developer_name": null, "developer_privacy_policy_url": "https://brainseed-factory.com/law/privacy_products/index.php", "developer_terms_of_service_url": "https://brainseed-factory.com/law/terms_products/index.php", "publishe
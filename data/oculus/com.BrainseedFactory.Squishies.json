uluscdn.com/v/t64.5771-25/75322598_1145165853836223_6864148320373849862_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oHTLPQajHfcQ7kNvwH4URWf&_nc_oc=AdrzBFBBVNM1Ub7mijt7hH8htsDqwZza1boFqKA6Wd1AbjPZG-KzfqtMFDCdTfDx7Mo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2wd7lDsSapvpgtjEl8zqsW3kHes1fMT3Q4-D3wcbhdgQ&oe=69DCD143"}, {"file_name": "Screenshot03.png", "id": "598340872572801", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39001670_598340875906134_7078948835759736288_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EOYs_j2bbmIQ7kNvwFJcvE_&_nc_oc=AdoFtWLy0o2z-nwJH6KbmbMVpyNzbOZpdu0wotPdJQL46AfynJ-klMkLp-tahyJ4mfk&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2ctwBH-676YaLua3YLsvwW73bBBkPDEaY6BBeOZkud2Q&oe=69DCCF4B"}, {"file_name": "Screenshot06.png", "id": "970563445094246", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031450_970563448427579_1896364834470325490_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dHWgDWVe8XoQ7kNvwEanClm&_nc_oc=Adozs3vOZn3ThUdyJmxdBWFRb5Nmrpl6IU1JY2flv4549hgiZOWrUP5vt9E6XvSRAhk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1djNG9_N1yfW6bIcByTDu6b0XdBwQb8OEY8oZv3TYPBQ&oe=69DCEED2"}, {"file_name": "Screenshot04.png", "id": "575729695062740", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031400_575729698396073_2621336866475747103_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SbHqTAK3s9gQ7kNvwGlfme7&_nc_oc=AdoJfyhFhtZ1-jzy92-Q6BnTloYC5M0yC6DA4M9w9HirL7OJq7o1oT91HmYbudcYiSM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af14GKKaDWcML8KLQx_hSG7Fkreaa_vsJQTk6ZKPzmuJmw&oe=69DCF5DC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Gameplay Trailer Thumb.png", "id": "605202028847932", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974836_605202032181265_2417977283558520499_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2aemozqxsMYQ7kNvwEb5wqi&_nc_oc=AdqyeBt6VP4NBgyZYq25rAuRKkv0gWgHWQlKf7CA4XunWAzN1iFhnaH_1ZG39ww3vvY&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2DJzqQMJwqLkIHe8lYQEs2OJ8o3CCXkWsoNW8W5Nx14A&oe=69DCFD99"}, "display_name": "Squishies - Roll them Home!", "keywords": ["puzzle", "platformer", "sandbox", "exploration", "adventure"], "long_description": "**Get lost in the Squishies-verse!**\n\nSquishies is a head-scratching puzzle platformer where you guide courageous and cute creatures through a series of increasingly hazardous, challenging mazes. Use unique motion controls to push and pull the Squishies through their adventures in a colorful universe full of strange flora and fauna. Keep those little rascals safe while they climb, jump, fly and teleport-by-fish through dozens of levels in five alien worlds!\n\n{507625458961423}\n\nYou push and pull the Squishies from one side of the maze to the other, all while earning medals, gathering crystals, climbing slopes, and avoiding pitfalls.\n\n- **Explore a huge universe** - Across dozens of levels in five different worlds.\n- **Collectibles and Achievements** - Gather all the crystals, beat the clock or find the hidden egg in each level.\n- **Level Editor** - Squishies really comes into its own with its innovative, fully featured creation tools.\n- **Community Section** - Share your creation with others and play their ingenious levels.\n- **Limited play space?** Need to keep an eye on your own little monsters?  You\u2019re in luck. Squishies\u00ae can be played in the newly added Mixed Reality mode!\n\n\n{482757334822594}", "short_description": "Help the stranded Squishies find their way back home! Push and pull them through challenging puzzles, or create your own levels with the powerful in-game editor and share them with the community."}]}, "developer_name": null, "developer_privacy_policy_url": "https://brainseed-factory.com/law/privacy_products/index.php", "developer_terms_of_service_url": "https://brainseed-factory.com/law/terms_products/index.php", "publisher
culuscdn.com/v/t64.5771-25/75322598_1145165853836223_6864148320373849862_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nqHckvv-A7UQ7kNvwFCcdeW&_nc_oc=AdrA2xZ0dZu8JbcssUxqaOgDA-b-gRwvKoQ1WQ3rDCfcBwoF-vNNpZl8XjQeHsvWozc&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9D0gpreLo5IQoQfmcsQ4nxsWkUVwdavuPrymki0HvbXA&oe=6A453003"}, {"file_name": "Screenshot03.png", "id": "598340872572801", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/39001670_598340875906134_7078948835759736288_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k-QHkWOxiXcQ7kNvwHN99r9&_nc_oc=AdpXCuOiAmgCEMVLS1Op9aKkjgFAkK24K8S_sE2UZMdJXXjKVwYVFwX80IS5T-FZxMo&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9-cNn99JfO6joa6vpclaINb7PFxlS79ms5w2zBmnTWCw&oe=6A452E0B"}, {"file_name": "Screenshot06.png", "id": "970563445094246", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39031450_970563448427579_1896364834470325490_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6pZpC1BLF_IQ7kNvwHEwfun&_nc_oc=Adr3AIjY-X8FZIL1MxLlB869Limjfw8Wlg2rM5nLJu1jNgV9k1AcReRSgEk6FF2POak&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-W8Z0hHhZO5TaYIvBobG3-fqoMuZnjMto9AXqUkr7sKw&oe=6A451552"}, {"file_name": "Screenshot04.png", "id": "575729695062740", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39031400_575729698396073_2621336866475747103_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s28mqfZySrIQ7kNvwFv-v2g&_nc_oc=AdrAPxgkLJj8oZqPvZwFpiVb7pTTMuzdKuKLGwBEoMx77APFH1-xg1Iy8DzsT2w1yG4&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9f_NIviO50g119r4g-7Uxh7egA68sw5WOoE1JP-25bbw&oe=6A451C5C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Gameplay Trailer Thumb.png", "id": "605202028847932", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974836_605202032181265_2417977283558520499_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iOJ8Rhdam3sQ7kNvwH2mDDH&_nc_oc=Adqcjv0DFXsbdZ0jgpLAxcQwqcYx5nJap1NFgdBM0vrZUUsB_EaQx_wZzDFJPprGffk&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_9U4LW6SB5oAOCLbeLG8PGILov8IvbI0oQlE80Fsykcg&oe=6A452419"}, "display_name": "Squishies - Roll them Home!", "keywords": ["puzzle", "platformer", "sandbox", "exploration", "adventure"], "long_description": "**Get lost in the Squishies-verse!**\n\nSquishies is a head-scratching puzzle platformer where you guide courageous and cute creatures through a series of increasingly hazardous, challenging mazes. Use unique motion controls to push and pull the Squishies through their adventures in a colorful universe full of strange flora and fauna. Keep those little rascals safe while they climb, jump, fly and teleport-by-fish through dozens of levels in five alien worlds!\n\n{507625458961423}\n\nYou push and pull the Squishies from one side of the maze to the other, all while earning medals, gathering crystals, climbing slopes, and avoiding pitfalls.\n\n- **Explore a huge universe** - Across dozens of levels in five different worlds.\n- **Collectibles and Achievements** - Gather all the crystals, beat the clock or find the hidden egg in each level.\n- **Level Editor** - Squishies really comes into its own with its innovative, fully featured creation tools.\n- **Community Section** - Share your creation with others and play their ingenious levels.\n- **Limited play space?** Need to keep an eye on your own little monsters?  You\u2019re in luck. Squishies\u00ae can be played in the newly added Mixed Reality mode!\n\n\n{482757334822594}", "short_description": "Help the stranded Squishies find their way back home! Push and pull them through challenging puzzles, or create your own levels with the powerful in-game editor and share them with the community."}]}, "developer_name": null, "developer_privacy_policy_url": "https://brainseed-factory.com/law/privacy_products/index.php", "developer_terms_of_service_url": "https://brainseed-factory.com/law/terms_products/index.php", "publishe
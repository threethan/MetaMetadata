culuscdn.com/v/t64.5771-25/75322598_1145165853836223_6864148320373849862_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZoEZFXMHo0QQ7kNvwGK6sNi&_nc_oc=AdrJFoEEvRgf9sQO_g2X1hp5ADDkxsmAfpcp5o74jHnAfQrn8_-RkwCf7EY7Z_NLKxs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHRpU1FMgH0RlliPEPNpmI7dA9pc6agDRDc5UaHHe4-mQ&oe=6A95D3C3"}, {"file_name": "Screenshot03.png", "id": "598340872572801", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39001670_598340875906134_7078948835759736288_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e6QZH-2_yOkQ7kNvwEl1_X-&_nc_oc=AdrIyMOIt-ENSfio-ztn3qkmqMmua8hVN3i2pEnMCLSZINFn7D8lv4XyYU_0L1AaE6A&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFfDhkurQdVEG7rlsaa4b75KBLzVbHBhXmeX8mrRjVp6A&oe=6A95D1CB"}, {"file_name": "Screenshot06.png", "id": "970563445094246", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031450_970563448427579_1896364834470325490_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4Uu_VodTJZ0Q7kNvwHLQq4a&_nc_oc=Adq4lkpOXL7YiWGFU5gUr-nLr4qFlwfx5eRV4Mrv3NcLTzGJzdXSvPsPGSyYzgTaxYg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHi5-pE827-pYVnUsJ21R2DFrn0FtXiDKEI13xsuq7Cuw&oe=6A95B912"}, {"file_name": "Screenshot04.png", "id": "575729695062740", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031400_575729698396073_2621336866475747103_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HyiCBj2wR2AQ7kNvwGWO_YR&_nc_oc=AdqU6BBRVg1pH8oFBtu_BuJUcmdx9x72UtSYn4HJ9wPNvKjL1tXVyoOJHTjKLzBABtQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHoOFMIndphJUWO-SeOs0Ee5vpI478BZlXT-FmNvj1CRg&oe=6A95C01C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Gameplay Trailer Thumb.png", "id": "605202028847932", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974836_605202032181265_2417977283558520499_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XHbHK_t2IiAQ7kNvwGne8Zu&_nc_oc=AdqDNcMCVGo8hr6Wb8GvldzQ-K5w-N2dow2PKDjbX_zApXUjXfQdKXLogEl686cgSdM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH4NDIXIijRNEticU_ESTsAXtM4iCQFC5cUW9FfNAIyhA&oe=6A95C7D9"}, "display_name": "Squishies - Roll them Home!", "keywords": ["puzzle", "platformer", "sandbox", "exploration", "adventure"], "long_description": "**Get lost in the Squishies-verse!**\n\nSquishies is a head-scratching puzzle platformer where you guide courageous and cute creatures through a series of increasingly hazardous, challenging mazes. Use unique motion controls to push and pull the Squishies through their adventures in a colorful universe full of strange flora and fauna. Keep those little rascals safe while they climb, jump, fly and teleport-by-fish through dozens of levels in five alien worlds!\n\n{507625458961423}\n\nYou push and pull the Squishies from one side of the maze to the other, all while earning medals, gathering crystals, climbing slopes, and avoiding pitfalls.\n\n- **Explore a huge universe** - Across dozens of levels in five different worlds.\n- **Collectibles and Achievements** - Gather all the crystals, beat the clock or find the hidden egg in each level.\n- **Level Editor** - Squishies really comes into its own with its innovative, fully featured creation tools.\n- **Community Section** - Share your creation with others and play their ingenious levels.\n- **Limited play space?** Need to keep an eye on your own little monsters?  You\u2019re in luck. Squishies\u00ae can be played in the newly added Mixed Reality mode!\n\n\n{482757334822594}", "short_description": "Help the stranded Squishies find their way back home! Push and pull them through challenging puzzles, or create your own levels with the powerful in-game editor and share them with the community."}]}, "developer_name": null, "developer_privacy_policy_url": "https://brainseed-factory.com/law/privacy_products/index.php", "developer_terms_of_service_url": "https://brainseed-factory.com/law/terms_products/index.php", "publishe
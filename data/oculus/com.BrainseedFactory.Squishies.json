uluscdn.com/v/t64.5771-25/75322598_1145165853836223_6864148320373849862_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i3ISmKWmo7UQ7kNvwGImi96&_nc_oc=Adqx2MONLiwMUj85h_A1lVinue69xBC5b_2BC_K4WYu31yzOqDx7kYu9f1R3_1nEJTw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8nGDy76ug6OttjME9Q_Z7Uq_CccMnLdXuuNmn-YBbzxQ&oe=6A2D7503"}, {"file_name": "Screenshot03.png", "id": "598340872572801", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39001670_598340875906134_7078948835759736288_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LSrNZIrbSZYQ7kNvwFQ2YMl&_nc_oc=AdpLmXHJLQEY1X2xivx_uQsxvGEJG-jycWB7UCzMGv8nbkYglVEkL-oW8N5Tnxy4dvw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9TsJ4QncqpIhd__eF7KXDvmKwMFZX0pmaM6eOKvH21Ow&oe=6A2D730B"}, {"file_name": "Screenshot06.png", "id": "970563445094246", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031450_970563448427579_1896364834470325490_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yvjip12CsakQ7kNvwEjjzDX&_nc_oc=AdraJDk9jaVURd_dIZp1FEthSRjBmau7U6zyQT8doAkYxwVciZI-3kGWjN2AvatPa7g&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9qnOR2AFParY-7kgBUNmLw_BeLBfSwH7sRqZjlkyaHWQ&oe=6A2D5A52"}, {"file_name": "Screenshot04.png", "id": "575729695062740", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031400_575729698396073_2621336866475747103_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uzg9HDSCSXMQ7kNvwFmM1Wt&_nc_oc=AdrSj8mzDxMdgw-vj22N8zy0f2FcQjyKlP983mJXpygbSrA5Vit7XWEFSM3EDq5rfrs&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9bLqiWb9w_VAsQOU0vNuzHzrD8SsX_nNtKyUnK1_w3IA&oe=6A2D615C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Gameplay Trailer Thumb.png", "id": "605202028847932", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974836_605202032181265_2417977283558520499_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ahpJleBcgyUQ7kNvwGR2r8s&_nc_oc=AdrS3kZebCgyd4WT6e3Wxov7Iu64Lx_-cuJcgLKpj8U1KvBu6yHgdaKOugQHu6l6bkg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8J7ppBisTnHaYQYT9xYvibem_WhFo505XxluRyTiWE0Q&oe=6A2D6919"}, "display_name": "Squishies - Roll them Home!", "keywords": ["puzzle", "platformer", "sandbox", "exploration", "adventure"], "long_description": "**Get lost in the Squishies-verse!**\n\nSquishies is a head-scratching puzzle platformer where you guide courageous and cute creatures through a series of increasingly hazardous, challenging mazes. Use unique motion controls to push and pull the Squishies through their adventures in a colorful universe full of strange flora and fauna. Keep those little rascals safe while they climb, jump, fly and teleport-by-fish through dozens of levels in five alien worlds!\n\n{507625458961423}\n\nYou push and pull the Squishies from one side of the maze to the other, all while earning medals, gathering crystals, climbing slopes, and avoiding pitfalls.\n\n- **Explore a huge universe** - Across dozens of levels in five different worlds.\n- **Collectibles and Achievements** - Gather all the crystals, beat the clock or find the hidden egg in each level.\n- **Level Editor** - Squishies really comes into its own with its innovative, fully featured creation tools.\n- **Community Section** - Share your creation with others and play their ingenious levels.\n- **Limited play space?** Need to keep an eye on your own little monsters?  You\u2019re in luck. Squishies\u00ae can be played in the newly added Mixed Reality mode!\n\n\n{482757334822594}", "short_description": "Help the stranded Squishies find their way back home! Push and pull them through challenging puzzles, or create your own levels with the powerful in-game editor and share them with the community."}]}, "developer_name": null, "developer_privacy_policy_url": "https://brainseed-factory.com/law/privacy_products/index.php", "developer_terms_of_service_url": "https://brainseed-factory.com/law/terms_products/index.php", "publisher
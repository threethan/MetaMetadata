uluscdn.com/v/t64.5771-25/75322598_1145165853836223_6864148320373849862_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wjHDr2PR5DMQ7kNvwE9y6rI&_nc_oc=Adq4V0DCtfIsgYwe2nihQvaFnY11UtmfQlnGjFw8z4kc0zuXFc3Z_M8IvMeTN-sN4XQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4g8_ZtAlNevzrxIXQPBOe25RzGTMwODv7oMKu2fkOLqQ&oe=69FCAD83"}, {"file_name": "Screenshot03.png", "id": "598340872572801", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39001670_598340875906134_7078948835759736288_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=exAEBArUX7MQ7kNvwGqkiXc&_nc_oc=Adoe32JPouEUdVWGWULAnnqVvEo6Iyhmn8k7ZWwPpRu-Un0BylQ9AxWgYaavsQVCOZ0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7s8JATJhuZOCr3bQtBxbnwKMW1A-DEpqyIJhFWlHhJzw&oe=69FCAB8B"}, {"file_name": "Screenshot06.png", "id": "970563445094246", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031450_970563448427579_1896364834470325490_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6824bh8Q43IQ7kNvwGyP1Ve&_nc_oc=Adq4uxDdU5M1hsY6Uo4vJ9PmvUD33U4s-5IpgB0wYQ8opWd7hsn4ApOAVcS88WscOtI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4Hubrg3eA3DrTZ0HRZOEBJWW9LGEfa0ve_R-01u8tiBw&oe=69FC92D2"}, {"file_name": "Screenshot04.png", "id": "575729695062740", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031400_575729698396073_2621336866475747103_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nlmtKQt2BusQ7kNvwGNJm9B&_nc_oc=AdpAOBAUldJIk4IYPoTzxpxfSx1h4VtD8shh4VPqG7Q9JlqoKXi10KPcWo1XKQgR6_0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5Rpkb6wjYHqCat9_tYKcHAJ5W0ZGVrbmh_h_W-lI9eXA&oe=69FC99DC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Gameplay Trailer Thumb.png", "id": "605202028847932", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974836_605202032181265_2417977283558520499_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tx5x7IJgb6AQ7kNvwF447Te&_nc_oc=Adptea8oIQDTmk2lSaARrnPL-Sn8YysSg8kurClcVNe0-0XdswQjpovRJZ-yYtFLoRk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7sxjKNdnlwPUurVNqvVw_qj-9JGS5MkBD0IReTtP5BRQ&oe=69FCA199"}, "display_name": "Squishies - Roll them Home!", "keywords": ["puzzle", "platformer", "sandbox", "exploration", "adventure"], "long_description": "**Get lost in the Squishies-verse!**\n\nSquishies is a head-scratching puzzle platformer where you guide courageous and cute creatures through a series of increasingly hazardous, challenging mazes. Use unique motion controls to push and pull the Squishies through their adventures in a colorful universe full of strange flora and fauna. Keep those little rascals safe while they climb, jump, fly and teleport-by-fish through dozens of levels in five alien worlds!\n\n{507625458961423}\n\nYou push and pull the Squishies from one side of the maze to the other, all while earning medals, gathering crystals, climbing slopes, and avoiding pitfalls.\n\n- **Explore a huge universe** - Across dozens of levels in five different worlds.\n- **Collectibles and Achievements** - Gather all the crystals, beat the clock or find the hidden egg in each level.\n- **Level Editor** - Squishies really comes into its own with its innovative, fully featured creation tools.\n- **Community Section** - Share your creation with others and play their ingenious levels.\n- **Limited play space?** Need to keep an eye on your own little monsters?  You\u2019re in luck. Squishies\u00ae can be played in the newly added Mixed Reality mode!\n\n\n{482757334822594}", "short_description": "Help the stranded Squishies find their way back home! Push and pull them through challenging puzzles, or create your own levels with the powerful in-game editor and share them with the community."}]}, "developer_name": null, "developer_privacy_policy_url": "https://brainseed-factory.com/law/privacy_products/index.php", "developer_terms_of_service_url": "https://brainseed-factory.com/law/terms_products/index.php", "publisher
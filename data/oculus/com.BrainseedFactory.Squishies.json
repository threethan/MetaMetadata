culuscdn.com/v/t64.5771-25/75322598_1145165853836223_6864148320373849862_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ELoIpD45rUMQ7kNvwFTecKm&_nc_oc=AdpYErgsZMKWQbhy_ctNl-DM0UxWSqqeaOOjQAtj7uUd6Q76LNE_J6xJEvysmq7zY4o&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM24-Yve6eGCLBU2ohFVXfpe5txsvRF019ghzdC3xXqbw&oe=6ADF6F83"}, {"file_name": "Screenshot03.png", "id": "598340872572801", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39001670_598340875906134_7078948835759736288_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Pqs2_oK_C1UQ7kNvwEI9iis&_nc_oc=Adoenn1CxZ-6gev7SnTu1wtX7Me8-b2C-fr5gl2bbeXcmyZwPJYCIZQDINoz8go87lo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPiwBZZg8SEi-rQ3OuaEvDYalvM5v1aY1N2pZEZCprGcQ&oe=6ADF6D8B"}, {"file_name": "Screenshot06.png", "id": "970563445094246", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031450_970563448427579_1896364834470325490_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m9NXiJFiahoQ7kNvwFfek16&_nc_oc=Adrh9dsLR6Qti6ehLOouh1j6ygF73v2SqJ-Q-S1vcqMtLb3CDMauf15B7npmYAXJIwM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN4ZnSXBAgvqClxVuRn6CTlZnGf0xflwNdsDXh2RyAhog&oe=6ADF54D2"}, {"file_name": "Screenshot04.png", "id": "575729695062740", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031400_575729698396073_2621336866475747103_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y9oWd47qCQQQ7kNvwFHb7nQ&_nc_oc=AdoWAn4bsUJsTlyBNPmfmcvwGK6BnnjY69c3e9rCKcbN8mN9IbhQ2jVjrgI4U83UMZ4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNObqfx7FQabq1zM2WG_CRYgueDYHaNpFBf6_LYGq5sEQ&oe=6ADF5BDC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Gameplay Trailer Thumb.png", "id": "605202028847932", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974836_605202032181265_2417977283558520499_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VPujtytH11MQ7kNvwEHw-hW&_nc_oc=Adp7Zwf3S4we7SS0GrOPVvuOqlmIGlXl3N3aQh1wL18mHrz8ceyGr8gCtm_qujt-9WA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNfvCwHXGyXjoQyUw9Nyoz7Dkw9ACMIWgFHcAarViClSw&oe=6ADF6399"}, "display_name": "Squishies - Roll them Home!", "keywords": ["puzzle", "platformer", "sandbox", "exploration", "adventure"], "long_description": "**Get lost in the Squishies-verse!**\n\nSquishies is a head-scratching puzzle platformer where you guide courageous and cute creatures through a series of increasingly hazardous, challenging mazes. Use unique motion controls to push and pull the Squishies through their adventures in a colorful universe full of strange flora and fauna. Keep those little rascals safe while they climb, jump, fly and teleport-by-fish through dozens of levels in five alien worlds!\n\n{507625458961423}\n\nYou push and pull the Squishies from one side of the maze to the other, all while earning medals, gathering crystals, climbing slopes, and avoiding pitfalls.\n\n- **Explore a huge universe** - Across dozens of levels in five different worlds.\n- **Collectibles and Achievements** - Gather all the crystals, beat the clock or find the hidden egg in each level.\n- **Level Editor** - Squishies really comes into its own with its innovative, fully featured creation tools.\n- **Community Section** - Share your creation with others and play their ingenious levels.\n- **Limited play space?** Need to keep an eye on your own little monsters?  You\u2019re in luck. Squishies\u00ae can be played in the newly added Mixed Reality mode!\n\n\n{482757334822594}", "short_description": "Help the stranded Squishies find their way back home! Push and pull them through challenging puzzles, or create your own levels with the powerful in-game editor and share them with the community."}]}, "developer_name": null, "developer_privacy_policy_url": "https://brainseed-factory.com/law/privacy_products/index.php", "developer_terms_of_service_url": "https://brainseed-factory.com/law/terms_products/index.php", "publishe
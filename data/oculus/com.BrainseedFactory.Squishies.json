culuscdn.com/v/t64.5771-25/75322598_1145165853836223_6864148320373849862_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2HkjXdHtuZ0Q7kNvwEOyulS&_nc_oc=Ado6o7SuIJVNMfGufidBTX4kVp83l4Scb_B5wSL_W_l6rQ6ewbD-M27cA2bFvP1f8SQ&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAFNEIpEDFhcvQLMmBNXydWkzH5NVKevbQshLnB5QZx6g&oe=6A6CBD03"}, {"file_name": "Screenshot03.png", "id": "598340872572801", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39001670_598340875906134_7078948835759736288_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f_BfQtm6fy0Q7kNvwGcrG70&_nc_oc=Adr2MWxcirB78Wn7GPCt4U147hrZDhSHWZJxgTdt4nyEILuBYJO3Ow0WLTJFfXML4Uw&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBsFxnfbuOcMD47hX7WrIb7_LchsyWkV0f5xP4PBvAsPg&oe=6A6CBB0B"}, {"file_name": "Screenshot06.png", "id": "970563445094246", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031450_970563448427579_1896364834470325490_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EaOScv7RXasQ7kNvwGSo25Y&_nc_oc=AdoPFo31ASjkm_a4HFnL2k8aTjAGjcYLZliexbseFcipOZEAUUGY1ian2yhoCLA3N6M&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDAQCQaM70j2OrrcgypfuS54G18j0CsOMaSlsKsq9Rx7A&oe=6A6CA252"}, {"file_name": "Screenshot04.png", "id": "575729695062740", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39031400_575729698396073_2621336866475747103_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aPXWyhw-HX0Q7kNvwF5LTN3&_nc_oc=AdpG6KRcSgpBkKlRMgtMtHaz20XjHY4VfZbsU4QxoVC0dbyjC1v57hddL8IpRdrCimo&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDGyUPs2Jggpv1Q2BYGd30GTlULqDzejAkHdUSOUYZX_Q&oe=6A6CA95C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Gameplay Trailer Thumb.png", "id": "605202028847932", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974836_605202032181265_2417977283558520499_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=83MKq3BaSYoQ7kNvwGfMZHl&_nc_oc=Adoum0XdQkVnq-tka4isQVJcOGlhuQQOmClVW7PKkobShX1avbaW6lLdUkQMMqr_qwE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCpvKIVwhn-D0w5hXt1Af6TwppDyKl4LFyCMosC1ej1tg&oe=6A6CB119"}, "display_name": "Squishies - Roll them Home!", "keywords": ["puzzle", "platformer", "sandbox", "exploration", "adventure"], "long_description": "**Get lost in the Squishies-verse!**\n\nSquishies is a head-scratching puzzle platformer where you guide courageous and cute creatures through a series of increasingly hazardous, challenging mazes. Use unique motion controls to push and pull the Squishies through their adventures in a colorful universe full of strange flora and fauna. Keep those little rascals safe while they climb, jump, fly and teleport-by-fish through dozens of levels in five alien worlds!\n\n{507625458961423}\n\nYou push and pull the Squishies from one side of the maze to the other, all while earning medals, gathering crystals, climbing slopes, and avoiding pitfalls.\n\n- **Explore a huge universe** - Across dozens of levels in five different worlds.\n- **Collectibles and Achievements** - Gather all the crystals, beat the clock or find the hidden egg in each level.\n- **Level Editor** - Squishies really comes into its own with its innovative, fully featured creation tools.\n- **Community Section** - Share your creation with others and play their ingenious levels.\n- **Limited play space?** Need to keep an eye on your own little monsters?  You\u2019re in luck. Squishies\u00ae can be played in the newly added Mixed Reality mode!\n\n\n{482757334822594}", "short_description": "Help the stranded Squishies find their way back home! Push and pull them through challenging puzzles, or create your own levels with the powerful in-game editor and share them with the community."}]}, "developer_name": null, "developer_privacy_policy_url": "https://brainseed-factory.com/law/privacy_products/index.php", "developer_terms_of_service_url": "https://brainseed-factory.com/law/terms_products/index.php", "publishe
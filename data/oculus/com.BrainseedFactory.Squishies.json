culuscdn.com/v/t64.5771-25/75322598_1145165853836223_6864148320373849862_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dWrKuc1dpi0Q7kNvwGkLJ0o&_nc_oc=AdrwXJiDgVUdbf9fYqUZFhRJUcNxh6E8yVfm8q96gFkB9k64xmhcBtRHmiC6WVsGLm8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAU6C54xwClFUEf1dJDvOlqSf_ND3yUV_K_YYHjLBqd4Q&oe=6A576CC3"}, {"file_name": "Screenshot03.png", "id": "598340872572801", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39001670_598340875906134_7078948835759736288_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=32P0k-0Y1-IQ7kNvwGOJmbt&_nc_oc=AdpxoJX89MZ4qaaof17nbLgnpQ1IoZ96-UJcA8Nd0iPO8tEpkfpdwEkBPFku8s7NhVM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA_tkGX5UZ0ZpFbHCGJQEDdphJgA3Pmm-JxwENotNuF0A&oe=6A576ACB"}, {"file_name": "Screenshot06.png", "id": "970563445094246", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031450_970563448427579_1896364834470325490_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=15W4lGQYnIIQ7kNvwHwxikh&_nc_oc=Adp1FEPoTzcBWbsl1LfgJEScYUWPgy9hoEVC_1yOACWe4addA4_t-UyRz6bfU8_P10A&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDprLuLiEXDz2gDXlH4PTbEFv-vGnxx6XMFCX8UvQ1c0w&oe=6A578A52"}, {"file_name": "Screenshot04.png", "id": "575729695062740", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031400_575729698396073_2621336866475747103_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eM-DUpn-R3cQ7kNvwFL6CVS&_nc_oc=AdpzvlihkJvhiswG8kA8vLFyYLpSMv7mt3pE5Bnxw6E-jkov0FuwRYHKGfUbCSFM4zs&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQACqWUaN6Eza_mEsSGDwBN8AH4g3ayFfjx06ItCVB18gw&oe=6A57915C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Gameplay Trailer Thumb.png", "id": "605202028847932", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974836_605202032181265_2417977283558520499_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=p2LFv9jCftIQ7kNvwGcZLEE&_nc_oc=AdqM09xAUSUfo813p5zaOKYBpQH3iDtiN_pL2XkaBRCmltix04BePYO4UR3dKOTtSpQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB2UtilN8qUo3bXcclfj8vwQ_leinibLfcLFCV1TTzzJg&oe=6A579919"}, "display_name": "Squishies - Roll them Home!", "keywords": ["puzzle", "platformer", "sandbox", "exploration", "adventure"], "long_description": "**Get lost in the Squishies-verse!**\n\nSquishies is a head-scratching puzzle platformer where you guide courageous and cute creatures through a series of increasingly hazardous, challenging mazes. Use unique motion controls to push and pull the Squishies through their adventures in a colorful universe full of strange flora and fauna. Keep those little rascals safe while they climb, jump, fly and teleport-by-fish through dozens of levels in five alien worlds!\n\n{507625458961423}\n\nYou push and pull the Squishies from one side of the maze to the other, all while earning medals, gathering crystals, climbing slopes, and avoiding pitfalls.\n\n- **Explore a huge universe** - Across dozens of levels in five different worlds.\n- **Collectibles and Achievements** - Gather all the crystals, beat the clock or find the hidden egg in each level.\n- **Level Editor** - Squishies really comes into its own with its innovative, fully featured creation tools.\n- **Community Section** - Share your creation with others and play their ingenious levels.\n- **Limited play space?** Need to keep an eye on your own little monsters?  You\u2019re in luck. Squishies\u00ae can be played in the newly added Mixed Reality mode!\n\n\n{482757334822594}", "short_description": "Help the stranded Squishies find their way back home! Push and pull them through challenging puzzles, or create your own levels with the powerful in-game editor and share them with the community."}]}, "developer_name": null, "developer_privacy_policy_url": "https://brainseed-factory.com/law/privacy_products/index.php", "developer_terms_of_service_url": "https://brainseed-factory.com/law/terms_products/index.php", "publishe
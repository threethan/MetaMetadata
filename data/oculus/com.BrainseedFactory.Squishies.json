culuscdn.com/v/t64.5771-25/75322598_1145165853836223_6864148320373849862_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zXrmewv-TM8Q7kNvwH4TU-u&_nc_oc=AdrgqaKGI124Nojh1g-KgamqlOMMh-WBspqvLhNcVPbQYcafk1F180U_I90cnitOWho&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEdBiJRuTSs9mLPsXGk2SHHvQofLw4e_smBXwjlCihWHw&oe=6A79B3C3"}, {"file_name": "Screenshot03.png", "id": "598340872572801", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39001670_598340875906134_7078948835759736288_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LpEI4iRCjeoQ7kNvwHFlJAB&_nc_oc=AdqngOkX3zCJPRZm1rkP9BzUKWB9EDGc67iMRMnEGExTB6mRKIXo4-7LNxxguc6ueAo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGqOuHQlWqegnnVMnGeYdEnMjbZ58S3igIGzz4NzheO0A&oe=6A79B1CB"}, {"file_name": "Screenshot06.png", "id": "970563445094246", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031450_970563448427579_1896364834470325490_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CFYmsUJce9wQ7kNvwGdT3h1&_nc_oc=Adp4qC6dLNUbhp5uhO6BtJYVhKhy7EstvrFxcDpOHgqLnpW92GcPrFwfqPoqAlRf94A&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFlk0bs1SEBWUesCXsQYQTr2nmGEfiuIY70qxljmwvgtg&oe=6A79D152"}, {"file_name": "Screenshot04.png", "id": "575729695062740", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031400_575729698396073_2621336866475747103_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Efr1llHfE8wQ7kNvwGqzQux&_nc_oc=AdpJv7p7WLv_hs1lnb1rzdPfcVUXE5p8Lz89oeBZdCXrIi5W0bTMwIdhzsfbHAatq90&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGSsTol9WPkdKBcAuDSNjWAh3XdZOcTS4Rda6dvlkuP9g&oe=6A79D85C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Gameplay Trailer Thumb.png", "id": "605202028847932", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974836_605202032181265_2417977283558520499_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0DA9qUP3jjcQ7kNvwE4M6pi&_nc_oc=Ado3os6hYRyYUnqlzEpy31iJR9F7Rs0OGM55UsZEln7JlQXlbU-I_8N9NqHTMoL7J4g&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEuR1egyiRRpuRLqH8gaH4SXJvmiWuUhgG13AqWKBidUg&oe=6A79E019"}, "display_name": "Squishies - Roll them Home!", "keywords": ["puzzle", "platformer", "sandbox", "exploration", "adventure"], "long_description": "**Get lost in the Squishies-verse!**\n\nSquishies is a head-scratching puzzle platformer where you guide courageous and cute creatures through a series of increasingly hazardous, challenging mazes. Use unique motion controls to push and pull the Squishies through their adventures in a colorful universe full of strange flora and fauna. Keep those little rascals safe while they climb, jump, fly and teleport-by-fish through dozens of levels in five alien worlds!\n\n{507625458961423}\n\nYou push and pull the Squishies from one side of the maze to the other, all while earning medals, gathering crystals, climbing slopes, and avoiding pitfalls.\n\n- **Explore a huge universe** - Across dozens of levels in five different worlds.\n- **Collectibles and Achievements** - Gather all the crystals, beat the clock or find the hidden egg in each level.\n- **Level Editor** - Squishies really comes into its own with its innovative, fully featured creation tools.\n- **Community Section** - Share your creation with others and play their ingenious levels.\n- **Limited play space?** Need to keep an eye on your own little monsters?  You\u2019re in luck. Squishies\u00ae can be played in the newly added Mixed Reality mode!\n\n\n{482757334822594}", "short_description": "Help the stranded Squishies find their way back home! Push and pull them through challenging puzzles, or create your own levels with the powerful in-game editor and share them with the community."}]}, "developer_name": null, "developer_privacy_policy_url": "https://brainseed-factory.com/law/privacy_products/index.php", "developer_terms_of_service_url": "https://brainseed-factory.com/law/terms_products/index.php", "publishe
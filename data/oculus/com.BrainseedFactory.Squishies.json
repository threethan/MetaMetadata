culuscdn.com/v/t64.5771-25/75322598_1145165853836223_6864148320373849862_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CQA2iQxxUP0Q7kNvwF-DJbb&_nc_oc=AdpEFvMMRTe3hJh43E3R5w6E2JE_zBjgpy4sKGuNLtKiZVjJ8RySf7fvt6WJ2PxNJoY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTZpHVT4eGIZ7iPhK30tgC_sfqn8fV_rcaSxzsaTbQWfw&oe=6AE9FB83"}, {"file_name": "Screenshot03.png", "id": "598340872572801", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39001670_598340875906134_7078948835759736288_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6jI8CszMzJwQ7kNvwEQqi2F&_nc_oc=AdqiOoZuF-FKhGY5GIwAETS6ufgzRfRyWht2ORaTZUhW9Px_41scE1-trOXNsqHtiaI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRK_S550Xquq2MSWq31T5vYvJfdz6D7AFXYq30NEgKeBg&oe=6AE9F98B"}, {"file_name": "Screenshot06.png", "id": "970563445094246", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031450_970563448427579_1896364834470325490_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D5ZYx5dHgBUQ7kNvwGgA2DL&_nc_oc=Ado8Ym8S_elFWqy6J16QBb5vEkXzbcAdBEAk5DNTfVpxxUp7f-o6d5cTztRzak63kHQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQsZElc6Fw2NbrNdClgq2xrnre8dIpEWREIr5ZMmSre-A&oe=6AE9E0D2"}, {"file_name": "Screenshot04.png", "id": "575729695062740", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031400_575729698396073_2621336866475747103_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=08PGuyND-rMQ7kNvwECQZlz&_nc_oc=Adp_HDPeEa9WnfokXDrBbUrkq1Az14_Z_O4ECidgTT6_AHzR_Pyd55ho3v4FwuYrAYw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQxlHc9qC6EPT_vIjTGGGlg8Ig6deBJwczoOJKCiuN_wQ&oe=6AE9E7DC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Gameplay Trailer Thumb.png", "id": "605202028847932", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974836_605202032181265_2417977283558520499_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IbpUlFY4EqMQ7kNvwFEyUbK&_nc_oc=Adrnat1GYrITE5pu01T5gHOdBraxjWNLpr1rZESGne0k2HCjDIBM2yPQGKKKBMRsl6I&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQShMvW_zuDpKd7VD4fXf8suJKea5XJuFDLPZ9E-ZtkdtA&oe=6AE9EF99"}, "display_name": "Squishies - Roll them Home!", "keywords": ["puzzle", "platformer", "sandbox", "exploration", "adventure"], "long_description": "**Get lost in the Squishies-verse!**\n\nSquishies is a head-scratching puzzle platformer where you guide courageous and cute creatures through a series of increasingly hazardous, challenging mazes. Use unique motion controls to push and pull the Squishies through their adventures in a colorful universe full of strange flora and fauna. Keep those little rascals safe while they climb, jump, fly and teleport-by-fish through dozens of levels in five alien worlds!\n\n{507625458961423}\n\nYou push and pull the Squishies from one side of the maze to the other, all while earning medals, gathering crystals, climbing slopes, and avoiding pitfalls.\n\n- **Explore a huge universe** - Across dozens of levels in five different worlds.\n- **Collectibles and Achievements** - Gather all the crystals, beat the clock or find the hidden egg in each level.\n- **Level Editor** - Squishies really comes into its own with its innovative, fully featured creation tools.\n- **Community Section** - Share your creation with others and play their ingenious levels.\n- **Limited play space?** Need to keep an eye on your own little monsters?  You\u2019re in luck. Squishies\u00ae can be played in the newly added Mixed Reality mode!\n\n\n{482757334822594}", "short_description": "Help the stranded Squishies find their way back home! Push and pull them through challenging puzzles, or create your own levels with the powerful in-game editor and share them with the community."}]}, "developer_name": null, "developer_privacy_policy_url": "https://brainseed-factory.com/law/privacy_products/index.php", "developer_terms_of_service_url": "https://brainseed-factory.com/law/terms_products/index.php", "publishe
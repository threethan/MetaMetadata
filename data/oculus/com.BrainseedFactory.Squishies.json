uluscdn.com/v/t64.5771-25/75322598_1145165853836223_6864148320373849862_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3iP0J-agoNsQ7kNvwG1zYFr&_nc_oc=AdrtmQvrwKvZdYlWdWdpoDTEz5-A9kGOrIC44zITrliZEEE65Tin4UJQckqT_vX7XOY&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_KMUJ-0-ORkYYmFAic-vy1lv9QVnDM6dqkWQqk3QjSmA&oe=6A2C2383"}, {"file_name": "Screenshot03.png", "id": "598340872572801", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/39001670_598340875906134_7078948835759736288_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MbBC6PGQam8Q7kNvwFbN3TZ&_nc_oc=Adq9WflyBrQ7UMUBMQuwk-vnYneIO8iF0PbeO6hDKzNNeezqPY8zo7oshDCTi9_G_Z0&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-44Io5ES0rwj7oJqmbCd5Pv1ES6EzwJeUB3k-JS2R-Zg&oe=6A2C218B"}, {"file_name": "Screenshot06.png", "id": "970563445094246", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/39031450_970563448427579_1896364834470325490_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F7uSYb96vFsQ7kNvwFKZGtL&_nc_oc=Adp0OtzBhYjJFdaWx7GvgxxHzeM1okVU4N5GMXpO1uOHFK0TCwVLygQN3m7Vor8lmD4&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9bJzJoAZpDAtUe5SQfCbxvuFof2ho9n2dG8LvZJuFKhQ&oe=6A2C08D2"}, {"file_name": "Screenshot04.png", "id": "575729695062740", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/39031400_575729698396073_2621336866475747103_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wiuBIqf5UxIQ7kNvwFrmbFp&_nc_oc=AdpHSEe0CX9S2jbFY2SorAsxntdwCKhBicuXjtWszfSboYVWb_iIN08mwB8SMVSRu0k&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9qnAUCkT4xLOTrHF_ojgIlwFg317ts8ymu32YWf7MhXA&oe=6A2C0FDC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Gameplay Trailer Thumb.png", "id": "605202028847932", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/38974836_605202032181265_2417977283558520499_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ahpJleBcgyUQ7kNvwE_X8p4&_nc_oc=AdovcRhWzImsJBh_Vb2mAYiWb8xXr7zHLTH7dnpcJIAEIjyKCc5631vtN-YyYzkIs0A&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af80Znfyv0elW0X2Q17pErUb5yiLV_KRwDQSx6XauXVYNg&oe=6A2C1799"}, "display_name": "Squishies - Roll them Home!", "keywords": ["puzzle", "platformer", "sandbox", "exploration", "adventure"], "long_description": "**Get lost in the Squishies-verse!**\n\nSquishies is a head-scratching puzzle platformer where you guide courageous and cute creatures through a series of increasingly hazardous, challenging mazes. Use unique motion controls to push and pull the Squishies through their adventures in a colorful universe full of strange flora and fauna. Keep those little rascals safe while they climb, jump, fly and teleport-by-fish through dozens of levels in five alien worlds!\n\n{507625458961423}\n\nYou push and pull the Squishies from one side of the maze to the other, all while earning medals, gathering crystals, climbing slopes, and avoiding pitfalls.\n\n- **Explore a huge universe** - Across dozens of levels in five different worlds.\n- **Collectibles and Achievements** - Gather all the crystals, beat the clock or find the hidden egg in each level.\n- **Level Editor** - Squishies really comes into its own with its innovative, fully featured creation tools.\n- **Community Section** - Share your creation with others and play their ingenious levels.\n- **Limited play space?** Need to keep an eye on your own little monsters?  You\u2019re in luck. Squishies\u00ae can be played in the newly added Mixed Reality mode!\n\n\n{482757334822594}", "short_description": "Help the stranded Squishies find their way back home! Push and pull them through challenging puzzles, or create your own levels with the powerful in-game editor and share them with the community."}]}, "developer_name": null, "developer_privacy_policy_url": "https://brainseed-factory.com/law/privacy_products/index.php", "developer_terms_of_service_url": "https://brainseed-factory.com/law/terms_products/index.php", "publisher
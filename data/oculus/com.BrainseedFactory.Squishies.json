culuscdn.com/v/t64.5771-25/75322598_1145165853836223_6864148320373849862_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZJuw16arD14Q7kNvwG-olOS&_nc_oc=AdqD919yVKOyejTEkEMGZwO7s1MKR4leCQIQqzv0TIs9TmlbtzbpzGJTfala0tr13ro&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT0yiumP8LthO_8sEw4e53OI_OCJVKfv-vbLG8lcYo5Sg&oe=6AF87C03"}, {"file_name": "Screenshot03.png", "id": "598340872572801", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39001670_598340875906134_7078948835759736288_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=14dqk3G-CzcQ7kNvwF1z-3u&_nc_oc=Adq712qja8QwNfEdRc51IS5aZ8mzgTiQ-DnilozGzCQHtMzvHLg8HZf8hTYXc1VS_Wc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTTQPR3XoHaJxiIdv_2W1z0SXeE1iyfX9n6xV9i-3HT2A&oe=6AF87A0B"}, {"file_name": "Screenshot06.png", "id": "970563445094246", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031450_970563448427579_1896364834470325490_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AOo7GUTZPCoQ7kNvwEfUBSP&_nc_oc=AdokDkV1XqfPcTpey1jHhi9I-8PSsDiNS1TYFxVoNy70W5S0UReZLNB_eZd00-9SxWA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSv2PE_foVHQIvUMSSvl-7uQDYgGwebhA5BSPhrsIix_A&oe=6AF89992"}, {"file_name": "Screenshot04.png", "id": "575729695062740", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031400_575729698396073_2621336866475747103_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HmzPwsmHGGYQ7kNvwFX-0pl&_nc_oc=Adpjsa2WYnktwufpLkR5e6JhnOzaVoX2G5OZPtXqWxPyrqgl3sy8fsmvZEmrBFFz5NU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSly6SPE4p_4_spMGAaFrjeztIdJ_Y3_vbPXJ6kAd_Ngw&oe=6AF8A09C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Gameplay Trailer Thumb.png", "id": "605202028847932", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974836_605202032181265_2417977283558520499_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rfFmzts7bjYQ7kNvwF9jhr9&_nc_oc=AdpbVb7Rn0jNPUu06nyxSbzkYhOpoBeHmiXReeXIHB54JDMB8FMzA6J67NYZLtmIBq0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSr5XmXfVXuuqAg9o884LC2wW-bilAAhwuoijhTvqlt_A&oe=6AF8A859"}, "display_name": "Squishies - Roll them Home!", "keywords": ["puzzle", "platformer", "sandbox", "exploration", "adventure"], "long_description": "**Get lost in the Squishies-verse!**\n\nSquishies is a head-scratching puzzle platformer where you guide courageous and cute creatures through a series of increasingly hazardous, challenging mazes. Use unique motion controls to push and pull the Squishies through their adventures in a colorful universe full of strange flora and fauna. Keep those little rascals safe while they climb, jump, fly and teleport-by-fish through dozens of levels in five alien worlds!\n\n{507625458961423}\n\nYou push and pull the Squishies from one side of the maze to the other, all while earning medals, gathering crystals, climbing slopes, and avoiding pitfalls.\n\n- **Explore a huge universe** - Across dozens of levels in five different worlds.\n- **Collectibles and Achievements** - Gather all the crystals, beat the clock or find the hidden egg in each level.\n- **Level Editor** - Squishies really comes into its own with its innovative, fully featured creation tools.\n- **Community Section** - Share your creation with others and play their ingenious levels.\n- **Limited play space?** Need to keep an eye on your own little monsters?  You\u2019re in luck. Squishies\u00ae can be played in the newly added Mixed Reality mode!\n\n\n{482757334822594}", "short_description": "Help the stranded Squishies find their way back home! Push and pull them through challenging puzzles, or create your own levels with the powerful in-game editor and share them with the community."}]}, "developer_name": null, "developer_privacy_policy_url": "https://brainseed-factory.com/law/privacy_products/index.php", "developer_terms_of_service_url": "https://brainseed-factory.com/law/terms_products/index.php", "publishe
culuscdn.com/v/t64.5771-25/75322598_1145165853836223_6864148320373849862_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2LGNHa1Q_xMQ7kNvwEb8qPH&_nc_oc=AdpuRWn39kJe-idHmir1JNtM3Wiaenyc7jgty9GwRiTqrXKVXrvuokIywzVzeHMkQPE&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJhCe_YsSWloWJCKI8BIKZ6MafwfXWNDZb7cF8pD4PVjw&oe=6AA17903"}, {"file_name": "Screenshot03.png", "id": "598340872572801", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/39001670_598340875906134_7078948835759736288_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lR378ZtydoMQ7kNvwG6Hz_0&_nc_oc=AdqMup5GrOvzaxn4lmHwVGT6DKGje7LIy9-hJv9Brf64EBEFR3PF3-VgDRTGoY4hWoU&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJj8ErlxtMhzWFXtIhuDQQLalu8-uYPO1qI2xc3gP-gOw&oe=6AA1770B"}, {"file_name": "Screenshot06.png", "id": "970563445094246", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/39031450_970563448427579_1896364834470325490_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F8H6Cd8OBKwQ7kNvwG6pzp3&_nc_oc=AdrumP9NL5XJ_Zzc2VLv49slyyw9R58NcT_h-Swd61_nGYC5pPxC29-LHee9F11DOFs&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLDqNkbYbt3U1DPQf_iNKrygtBoWYB0C-FzkYuTZ2292g&oe=6AA15E52"}, {"file_name": "Screenshot04.png", "id": "575729695062740", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/39031400_575729698396073_2621336866475747103_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D3C70NpmJaYQ7kNvwHD_tpy&_nc_oc=Adrz0XsAcYoellbT1uk9YGrRlR9Hl6mE_Fv6dyTt1p3ByWQsV9J9tJUv_Gm8lYG9DQA&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKgwyzw0UJ-YgSbXU6GYGOZS6teBDJX6hoHPISqehjaZw&oe=6AA1655C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Gameplay Trailer Thumb.png", "id": "605202028847932", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38974836_605202032181265_2417977283558520499_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fhlMopUVto4Q7kNvwEqzaw4&_nc_oc=AdqswXeskaiF8Rs4u0PNMCFQnFHTOXwAZQlGwmNQOCwbXh2go24gvQFnV5SjWqYOX0A&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL-7NPlnmW-gXpEzgxL7TdiPSg-yZOKVz1a4wm_SzpAqA&oe=6AA16D19"}, "display_name": "Squishies - Roll them Home!", "keywords": ["puzzle", "platformer", "sandbox", "exploration", "adventure"], "long_description": "**Get lost in the Squishies-verse!**\n\nSquishies is a head-scratching puzzle platformer where you guide courageous and cute creatures through a series of increasingly hazardous, challenging mazes. Use unique motion controls to push and pull the Squishies through their adventures in a colorful universe full of strange flora and fauna. Keep those little rascals safe while they climb, jump, fly and teleport-by-fish through dozens of levels in five alien worlds!\n\n{507625458961423}\n\nYou push and pull the Squishies from one side of the maze to the other, all while earning medals, gathering crystals, climbing slopes, and avoiding pitfalls.\n\n- **Explore a huge universe** - Across dozens of levels in five different worlds.\n- **Collectibles and Achievements** - Gather all the crystals, beat the clock or find the hidden egg in each level.\n- **Level Editor** - Squishies really comes into its own with its innovative, fully featured creation tools.\n- **Community Section** - Share your creation with others and play their ingenious levels.\n- **Limited play space?** Need to keep an eye on your own little monsters?  You\u2019re in luck. Squishies\u00ae can be played in the newly added Mixed Reality mode!\n\n\n{482757334822594}", "short_description": "Help the stranded Squishies find their way back home! Push and pull them through challenging puzzles, or create your own levels with the powerful in-game editor and share them with the community."}]}, "developer_name": null, "developer_privacy_policy_url": "https://brainseed-factory.com/law/privacy_products/index.php", "developer_terms_of_service_url": "https://brainseed-factory.com/law/terms_products/index.php", "publishe
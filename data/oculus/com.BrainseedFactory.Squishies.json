culuscdn.com/v/t64.5771-25/75322598_1145165853836223_6864148320373849862_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VY4InZEFQPYQ7kNvwFCgoVT&_nc_oc=AdoBqRw8pqNid_M-Vl1G70svMS6wAjPbtfB2kfsevdzOPkQY_UBAODZhLf_SzE822W4&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI2cp7lMSTghVhaLJdWkiUjg4B_iIAl5way0ZEPsUWBGw&oe=6AB14B03"}, {"file_name": "Screenshot03.png", "id": "598340872572801", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39001670_598340875906134_7078948835759736288_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UTR4V1vqffsQ7kNvwEfZuN3&_nc_oc=AdpKgZdsDoEvL8-KkYKaj7jUFWsP2YsgpNo2YZurSZO3aU6ZsStU3qMG9Dkil-TeTdc&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLaU3UQYzFYvb-mnxPYyHsOMujYhP1n4XYB3k5YY0AfMA&oe=6AB1490B"}, {"file_name": "Screenshot06.png", "id": "970563445094246", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031450_970563448427579_1896364834470325490_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=81FZ3O0ieg4Q7kNvwFraXji&_nc_oc=AdrjIQT_6Tlf47p8UN5TGqIGawkWsLltJfefSKqv_FVSozZt2n2x6cw7U1QYDGY2xnw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJRlVjRmTE7q7wMVCD5uUuRfHzcQiLtwtwI2kt6bn8r2g&oe=6AB13052"}, {"file_name": "Screenshot04.png", "id": "575729695062740", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39031400_575729698396073_2621336866475747103_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WzRVxRvQRSAQ7kNvwF-BvZ9&_nc_oc=AdrR21o1tJE4mJDchCS6Xz_l8iMOl0QBJZwlOS6g0reXvGMX5-ajSr2eEqJfkNClJvE&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKpYUQLjmviQdcPvXeP_EJ49zsd7lqdGnJA6eluhT_L4g&oe=6AB1375C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Gameplay Trailer Thumb.png", "id": "605202028847932", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974836_605202032181265_2417977283558520499_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hD_trbhLLYsQ7kNvwHzVV4W&_nc_oc=AdqW-at56WosHdS45zB8pFP2qMHpxdw65H99EWfjg4ErlC40QVvt3mbrlSgQ29YuOy8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI04ZCXpeT75sSTC4vAOp-DQQ0EMeff18eg6j9tJVSTWw&oe=6AB13F19"}, "display_name": "Squishies - Roll them Home!", "keywords": ["puzzle", "platformer", "sandbox", "exploration", "adventure"], "long_description": "**Get lost in the Squishies-verse!**\n\nSquishies is a head-scratching puzzle platformer where you guide courageous and cute creatures through a series of increasingly hazardous, challenging mazes. Use unique motion controls to push and pull the Squishies through their adventures in a colorful universe full of strange flora and fauna. Keep those little rascals safe while they climb, jump, fly and teleport-by-fish through dozens of levels in five alien worlds!\n\n{507625458961423}\n\nYou push and pull the Squishies from one side of the maze to the other, all while earning medals, gathering crystals, climbing slopes, and avoiding pitfalls.\n\n- **Explore a huge universe** - Across dozens of levels in five different worlds.\n- **Collectibles and Achievements** - Gather all the crystals, beat the clock or find the hidden egg in each level.\n- **Level Editor** - Squishies really comes into its own with its innovative, fully featured creation tools.\n- **Community Section** - Share your creation with others and play their ingenious levels.\n- **Limited play space?** Need to keep an eye on your own little monsters?  You\u2019re in luck. Squishies\u00ae can be played in the newly added Mixed Reality mode!\n\n\n{482757334822594}", "short_description": "Help the stranded Squishies find their way back home! Push and pull them through challenging puzzles, or create your own levels with the powerful in-game editor and share them with the community."}]}, "developer_name": null, "developer_privacy_policy_url": "https://brainseed-factory.com/law/privacy_products/index.php", "developer_terms_of_service_url": "https://brainseed-factory.com/law/terms_products/index.php", "publishe
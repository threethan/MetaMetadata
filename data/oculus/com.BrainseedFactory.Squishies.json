culuscdn.com/v/t64.5771-25/75322598_1145165853836223_6864148320373849862_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vy3PMFwOXxAQ7kNvwFnaxNp&_nc_oc=AdodvMAt3QyxkYgKpw4kGBsLT8hHjIEL0YmnWzqYkoWYyNHy-xJJnk8b2h3__mn_1vY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKRTTpZLNKNVIBpk_iwb-gW0UA_7SEvhFcEx6J8BlRQOQ&oe=6AA6BF03"}, {"file_name": "Screenshot03.png", "id": "598340872572801", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39001670_598340875906134_7078948835759736288_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Nd78cNXGNHAQ7kNvwHgBxcN&_nc_oc=Adq8UgtcaqWCXrbSG5_1a3xpj7tCsxxR3sRc_zKjPHtnyKNx4B1EXYKheNpZjIXh7rs&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLtLXf62sqluTO8YTAtWA0XvuNMcKLLnH8AooWn0XaeLw&oe=6AA6BD0B"}, {"file_name": "Screenshot06.png", "id": "970563445094246", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031450_970563448427579_1896364834470325490_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P7gWDs82Bg4Q7kNvwFmGgJC&_nc_oc=AdqIWXKCB_sTjRbrpbsStwHjh5EpjTaDmbqfLqdvSeSrTsyx8CoB2mLgFTCb6X_WevY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJfwHxP8_apore-aKhm5R4ZJaWy4Jl3aAg3wnA0C6Epwg&oe=6AA6A452"}, {"file_name": "Screenshot04.png", "id": "575729695062740", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031400_575729698396073_2621336866475747103_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=t3knfBtI0ckQ7kNvwF8n7jB&_nc_oc=Adq8PEeKKQj7QRyWK9uckEjaEKDbSnerLYWG-IWpNiLp4CuUxbjwY1QTWm_0Ze8zLN0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ9eaIilAyTXL9M10L-GP_CeC78ajbviFfoM8rdGK6Rhg&oe=6AA6AB5C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Gameplay Trailer Thumb.png", "id": "605202028847932", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974836_605202032181265_2417977283558520499_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V03h8oFdJCcQ7kNvwFevLJA&_nc_oc=Ado8XOSyZbWbuZB_ogD0JsZDUqqzrrRbBjU2Dpr5PrijeiltkmW_8FbSKgdzh5JKS7w&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJeLv5gnMURwo3GDnav6jcvjVmxDODx6FaY9MI-SHxKRA&oe=6AA6B319"}, "display_name": "Squishies - Roll them Home!", "keywords": ["puzzle", "platformer", "sandbox", "exploration", "adventure"], "long_description": "**Get lost in the Squishies-verse!**\n\nSquishies is a head-scratching puzzle platformer where you guide courageous and cute creatures through a series of increasingly hazardous, challenging mazes. Use unique motion controls to push and pull the Squishies through their adventures in a colorful universe full of strange flora and fauna. Keep those little rascals safe while they climb, jump, fly and teleport-by-fish through dozens of levels in five alien worlds!\n\n{507625458961423}\n\nYou push and pull the Squishies from one side of the maze to the other, all while earning medals, gathering crystals, climbing slopes, and avoiding pitfalls.\n\n- **Explore a huge universe** - Across dozens of levels in five different worlds.\n- **Collectibles and Achievements** - Gather all the crystals, beat the clock or find the hidden egg in each level.\n- **Level Editor** - Squishies really comes into its own with its innovative, fully featured creation tools.\n- **Community Section** - Share your creation with others and play their ingenious levels.\n- **Limited play space?** Need to keep an eye on your own little monsters?  You\u2019re in luck. Squishies\u00ae can be played in the newly added Mixed Reality mode!\n\n\n{482757334822594}", "short_description": "Help the stranded Squishies find their way back home! Push and pull them through challenging puzzles, or create your own levels with the powerful in-game editor and share them with the community."}]}, "developer_name": null, "developer_privacy_policy_url": "https://brainseed-factory.com/law/privacy_products/index.php", "developer_terms_of_service_url": "https://brainseed-factory.com/law/terms_products/index.php", "publishe
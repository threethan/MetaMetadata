uluscdn.com/v/t64.5771-25/75322598_1145165853836223_6864148320373849862_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vY70XQaQxekQ7kNvwE789Tn&_nc_oc=AdrQWkcPB_rCaxZ72y6fjmq358eaSexQW1Kkyeubx0u7p3ifgJE9aGIYA8ct_8EHmcc&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_ziK7Bm3YreWHT3nhNbmp3IFWYK8-ZOblDyP0mfvzVkQ&oe=6A219783"}, {"file_name": "Screenshot03.png", "id": "598340872572801", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39001670_598340875906134_7078948835759736288_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h_1ns20e_ucQ7kNvwEs-lu1&_nc_oc=AdrNiNf6P3w5pHQSbr8puWTsx7MlmDKovQe6OtHoOX7gpZMjhpZMrQAxAoxpgmjFovI&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-9n6To8G9Xx5hdvG5FnF9v68w5VJyLz28vTiNYFaUCPg&oe=6A21958B"}, {"file_name": "Screenshot06.png", "id": "970563445094246", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39031450_970563448427579_1896364834470325490_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WBnmgILD7ogQ7kNvwFLv2N8&_nc_oc=AdqdK_xA02o3NY4be1kfGiZFqtcA1BTLSZbFeot8zA4s39vORzJmx39w3mZyoQwwcgw&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8XP7kNNf-G7jZ3crzCCJ1SMCmVXo7oeERPLZQHSCLWvg&oe=6A217CD2"}, {"file_name": "Screenshot04.png", "id": "575729695062740", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39031400_575729698396073_2621336866475747103_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qURt2Rgac6QQ7kNvwHhgO4t&_nc_oc=AdqDYAUFWUDhExj1mMhTOPW5GU3NcV4wu90kL3CN1tbiDbubRkh2igeiE6nkWE8qoqw&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af80Eblxs8U59VYtaG1ovVdBp2x5sR_NdswIgWaevm4c6g&oe=6A2183DC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Gameplay Trailer Thumb.png", "id": "605202028847932", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974836_605202032181265_2417977283558520499_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nfoKidnNvGIQ7kNvwGVYrqs&_nc_oc=AdpF6DRMsECKfWyLfRrUmyY1mQRsJGO1SxBc1WyTSMGmTmIq0ps8e6QGs1BEc9kzB2U&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9h7rkS_A3U0jn03BvZ9uCb7fMSed6iN5R-PKn8ZPPUjQ&oe=6A218B99"}, "display_name": "Squishies - Roll them Home!", "keywords": ["puzzle", "platformer", "sandbox", "exploration", "adventure"], "long_description": "**Get lost in the Squishies-verse!**\n\nSquishies is a head-scratching puzzle platformer where you guide courageous and cute creatures through a series of increasingly hazardous, challenging mazes. Use unique motion controls to push and pull the Squishies through their adventures in a colorful universe full of strange flora and fauna. Keep those little rascals safe while they climb, jump, fly and teleport-by-fish through dozens of levels in five alien worlds!\n\n{507625458961423}\n\nYou push and pull the Squishies from one side of the maze to the other, all while earning medals, gathering crystals, climbing slopes, and avoiding pitfalls.\n\n- **Explore a huge universe** - Across dozens of levels in five different worlds.\n- **Collectibles and Achievements** - Gather all the crystals, beat the clock or find the hidden egg in each level.\n- **Level Editor** - Squishies really comes into its own with its innovative, fully featured creation tools.\n- **Community Section** - Share your creation with others and play their ingenious levels.\n- **Limited play space?** Need to keep an eye on your own little monsters?  You\u2019re in luck. Squishies\u00ae can be played in the newly added Mixed Reality mode!\n\n\n{482757334822594}", "short_description": "Help the stranded Squishies find their way back home! Push and pull them through challenging puzzles, or create your own levels with the powerful in-game editor and share them with the community."}]}, "developer_name": null, "developer_privacy_policy_url": "https://brainseed-factory.com/law/privacy_products/index.php", "developer_terms_of_service_url": "https://brainseed-factory.com/law/terms_products/index.php", "publisher
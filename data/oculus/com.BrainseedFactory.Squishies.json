145165853836223_6864148320373849862_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pfaEVdro-X0Q7kNvwHK0IM5&_nc_oc=Adnm3FtYMyem-laUjQWen1jkCOnWmOXaIwklSxFbMhtn3JCs8VHyv46hmOGorIwPXHo&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfwMTreXmae87vDDti1_A0G-AFh3loZA19r8WOg0_k0QuQ&oe=69AD5B43"}, {"file_name": "Screenshot03.png", "id": "598340872572801", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39001670_598340875906134_7078948835759736288_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0J7x4hkshRcQ7kNvwF2ZtiH&_nc_oc=AdnnR3X-VFvtoT8ULF-wAoKIWLt82cINQGFum-3reLIj82jIPVUWTOgn62Fd5CQqCQA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afzx5KL7lJ2B9OaNBiIw6y9GGwpYc016kFHdKkPfKUGIdQ&oe=69AD594B"}, {"file_name": "Screenshot06.png", "id": "970563445094246", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031450_970563448427579_1896364834470325490_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZC1O70VgIR4Q7kNvwGswWwm&_nc_oc=Adl8pfPs0HUYO7pmU3VntN4LUkntVFNTNmEqhfICFB-bHByWV-_CPiQrINm4hf73ohY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfxSA7Cz7gTpo7_4-QULXh7DUi1c2pquxyqF7tHm3iylQA&oe=69AD78D2"}, {"file_name": "Screenshot04.png", "id": "575729695062740", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031400_575729698396073_2621336866475747103_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I-Ep25iL2YcQ7kNvwH3_6J6&_nc_oc=AdmwBI_TJi50_KJSYOQZd9JEwXX2BIZr9zGmiwO7CbU0jyl30ztW3ZbP7t-IVooEPmU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfxC_C_etcz1EFjt1qwVjvZqSTNTqr6BdZe9_AdrFHKnLw&oe=69AD7FDC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Gameplay Trailer Thumb.png", "id": "605202028847932", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974836_605202032181265_2417977283558520499_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iKonWaugwXcQ7kNvwGvfXQU&_nc_oc=AdmLlUp7fX9cwxb2sRcelN0UcQRBBsPzVt5l3iSvvmAk2Pz7Mz4R2Ez4CRWe3ljU5WI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfyoJ-groiF32P27saLsmRKxB1ccMzcbkWlpv180l7nNFg&oe=69AD8799"}, "display_name": "Squishies - Roll them Home!", "keywords": ["puzzle", "platformer", "sandbox", "exploration", "adventure"], "long_description": "**Get lost in the Squishies-verse!**\n\nSquishies is a head-scratching puzzle platformer where you guide courageous and cute creatures through a series of increasingly hazardous, challenging mazes. Use unique motion controls to push and pull the Squishies through their adventures in a colorful universe full of strange flora and fauna. Keep those little rascals safe while they climb, jump, fly and teleport-by-fish through dozens of levels in five alien worlds!\n\n{507625458961423}\n\nYou push and pull the Squishies from one side of the maze to the other, all while earning medals, gathering crystals, climbing slopes, and avoiding pitfalls.\n\n- **Explore a huge universe** - Across dozens of levels in five different worlds.\n- **Collectibles and Achievements** - Gather all the crystals, beat the clock or find the hidden egg in each level.\n- **Level Editor** - Squishies really comes into its own with its innovative, fully featured creation tools.\n- **Community Section** - Share your creation with others and play their ingenious levels.\n- **Limited play space?** Need to keep an eye on your own little monsters?  You\u2019re in luck. Squishies\u00ae can be played in the newly added Mixed Reality mode!\n\n\n{482757334822594}", "short_description": "Help the stranded Squishies find their way back home! Push and pull them through challenging puzzles, or create your own levels with the powerful in-game editor and share them with the community."}]}, "developer_name": null, "developer_privacy_policy_url": "https://brainseed-factory.com/law/privacy_products/index.php", "developer_terms_of_service_url": "https://brainseed-factory.com/law/terms_products/index.php", "publisher_name": "Perp Games", "support_website_url": null, "webs
uluscdn.com/v/t64.5771-25/75322598_1145165853836223_6864148320373849862_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yc0ZPmdGkz0Q7kNvwGHcC2b&_nc_oc=AdrP4K-FjYTH5GrTLBht1muRLNOuNFsOimcixKltrw1UL28OdaYh_CvmHAkmqj5HsEk&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6kpqVaiwTtmTk2QLivsgFao8CaB-ExLypN3zrl3GcE8Q&oe=6A0C7F83"}, {"file_name": "Screenshot03.png", "id": "598340872572801", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/39001670_598340875906134_7078948835759736288_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9PO6l9PC4l8Q7kNvwHdAiIg&_nc_oc=Ado5GNuWs-3L_JZFBIIFasobA0ir86BBH56gtjAHDcAkN2XpUL_zK4zzREnHgho5km8&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5joJNG8_xp8p7CmKB1iRKmo2Hmd5eteKKEtliP9tQx2A&oe=6A0C7D8B"}, {"file_name": "Screenshot06.png", "id": "970563445094246", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/39031450_970563448427579_1896364834470325490_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hD_kiCNPHnUQ7kNvwFE_Pf5&_nc_oc=Adr9E8FGUQ3ZLmtWSTPHUMXeZKAOawydupwp_ashAy5gHr4KyrTn6fXAfaQBwQ7PZus&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5Z7kKvMYOdqV3_y4e_NshP3rKM4wfwgWx9d9-MhGvrqQ&oe=6A0C64D2"}, {"file_name": "Screenshot04.png", "id": "575729695062740", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/39031400_575729698396073_2621336866475747103_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J7-bhhitTHIQ7kNvwE_0sXU&_nc_oc=AdrXE3GRTUJG__MBH4B031Opsdvgb3R42t--ZPiFd-uTkmWfoOhh4dv4vxEw45GXvY0&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6DCPzutiicrJOYrkOqpacuc2RAp99nK8KM1z_TjfVrjQ&oe=6A0C6BDC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Gameplay Trailer Thumb.png", "id": "605202028847932", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38974836_605202032181265_2417977283558520499_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XG5XwIDD3dMQ7kNvwHLiJGJ&_nc_oc=Adom_6AIantcXkHvy8bkb9qR92yK4B-locranTH7GDlHvwqbdZ6YGmoQ-1-lBWJR99E&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5-rHzlRMrHnwoi8lBIgU9fXXnRFAhEGFuseHMkxEzrAQ&oe=6A0C7399"}, "display_name": "Squishies - Roll them Home!", "keywords": ["puzzle", "platformer", "sandbox", "exploration", "adventure"], "long_description": "**Get lost in the Squishies-verse!**\n\nSquishies is a head-scratching puzzle platformer where you guide courageous and cute creatures through a series of increasingly hazardous, challenging mazes. Use unique motion controls to push and pull the Squishies through their adventures in a colorful universe full of strange flora and fauna. Keep those little rascals safe while they climb, jump, fly and teleport-by-fish through dozens of levels in five alien worlds!\n\n{507625458961423}\n\nYou push and pull the Squishies from one side of the maze to the other, all while earning medals, gathering crystals, climbing slopes, and avoiding pitfalls.\n\n- **Explore a huge universe** - Across dozens of levels in five different worlds.\n- **Collectibles and Achievements** - Gather all the crystals, beat the clock or find the hidden egg in each level.\n- **Level Editor** - Squishies really comes into its own with its innovative, fully featured creation tools.\n- **Community Section** - Share your creation with others and play their ingenious levels.\n- **Limited play space?** Need to keep an eye on your own little monsters?  You\u2019re in luck. Squishies\u00ae can be played in the newly added Mixed Reality mode!\n\n\n{482757334822594}", "short_description": "Help the stranded Squishies find their way back home! Push and pull them through challenging puzzles, or create your own levels with the powerful in-game editor and share them with the community."}]}, "developer_name": null, "developer_privacy_policy_url": "https://brainseed-factory.com/law/privacy_products/index.php", "developer_terms_of_service_url": "https://brainseed-factory.com/law/terms_products/index.php", "publisher
culuscdn.com/v/t64.5771-25/75322598_1145165853836223_6864148320373849862_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XpCH4DHG4q0Q7kNvwEDfC1u&_nc_oc=AdoBu9Ddltggf0uWddA8ksDG2I__RAIXhRiBsLsfLVtpx6hJ6hArsFuj6VzU2a5QeMc&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGJ0h7gU-GN4BGRAgspz_Cj0EkuEFdS6TA9ic22lVVw-w&oe=6A843FC3"}, {"file_name": "Screenshot03.png", "id": "598340872572801", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39001670_598340875906134_7078948835759736288_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V9dnSR-oHXAQ7kNvwHfh1Sz&_nc_oc=Adq3AKnzkjtvT52-SQLHpK2JGJ88-G_1-eO2eFd7xWmeTESir4P9GL5A7gHuqHwSOAs&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHTjscdq88icSucl2jvPGSyOTLR7L-5Gq4ng0fP2f6oJg&oe=6A843DCB"}, {"file_name": "Screenshot06.png", "id": "970563445094246", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031450_970563448427579_1896364834470325490_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zk8bbjD2DpwQ7kNvwEKd9iO&_nc_oc=AdrKY-TFacnD51qfcyQ79CWmnencfokYqPaIb9pebfwFRh_31D_06O3SqaBD6aYyJSI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFypVSwGfZGBkUVLWp_x_nqIROuwi4DpasTwcvzmzCCRA&oe=6A845D52"}, {"file_name": "Screenshot04.png", "id": "575729695062740", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39031400_575729698396073_2621336866475747103_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PhR3XSwV3zAQ7kNvwG_ZbfB&_nc_oc=Adoo-cEti-G1YzaiQvnRxM9B9mWwdmNBIiJfkXgGUGWRUhNWuZ27wzkJnHsn0nmfUzM&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEBby9dLx0qCbZX3_TMy9nu7ZOP7Mqi1XbXBpeTX2PMkw&oe=6A84645C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Gameplay Trailer Thumb.png", "id": "605202028847932", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974836_605202032181265_2417977283558520499_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B5vBmEsHCuoQ7kNvwHrPG1k&_nc_oc=AdrGrwt5ixpAob4Z3T_8ccqekv53lsq9uRMAERz6e32yJholPwQ2yR9o6e4LZXVdXak&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFvj51OfTHYgDvtw8jJqZQfBkcKzcEUKLIyC9a0KrEDLg&oe=6A8433D9"}, "display_name": "Squishies - Roll them Home!", "keywords": ["puzzle", "platformer", "sandbox", "exploration", "adventure"], "long_description": "**Get lost in the Squishies-verse!**\n\nSquishies is a head-scratching puzzle platformer where you guide courageous and cute creatures through a series of increasingly hazardous, challenging mazes. Use unique motion controls to push and pull the Squishies through their adventures in a colorful universe full of strange flora and fauna. Keep those little rascals safe while they climb, jump, fly and teleport-by-fish through dozens of levels in five alien worlds!\n\n{507625458961423}\n\nYou push and pull the Squishies from one side of the maze to the other, all while earning medals, gathering crystals, climbing slopes, and avoiding pitfalls.\n\n- **Explore a huge universe** - Across dozens of levels in five different worlds.\n- **Collectibles and Achievements** - Gather all the crystals, beat the clock or find the hidden egg in each level.\n- **Level Editor** - Squishies really comes into its own with its innovative, fully featured creation tools.\n- **Community Section** - Share your creation with others and play their ingenious levels.\n- **Limited play space?** Need to keep an eye on your own little monsters?  You\u2019re in luck. Squishies\u00ae can be played in the newly added Mixed Reality mode!\n\n\n{482757334822594}", "short_description": "Help the stranded Squishies find their way back home! Push and pull them through challenging puzzles, or create your own levels with the powerful in-game editor and share them with the community."}]}, "developer_name": null, "developer_privacy_policy_url": "https://brainseed-factory.com/law/privacy_products/index.php", "developer_terms_of_service_url": "https://brainseed-factory.com/law/terms_products/index.php", "publishe
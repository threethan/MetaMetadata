ent-lhr6-1.oculuscdn.com/v/t64.5771-25/75322598_1145165853836223_6864148320373849862_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XpCH4DHG4q0Q7kNvwFOqnaE&_nc_oc=AdpQWiYaWybHLW2JQn1rXfA_V9LMqpEGsK0x_ZX6WM3nz2qZEzPCfUjVp0UrCCwSIyQ&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHKMMRqQFMo8aHQWkK5pClUOdqeyGVihgXE4tciio3h_A&oe=6A859143"}, {"file_name": "Screenshot03.png", "id": "598340872572801", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/39001670_598340875906134_7078948835759736288_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V9dnSR-oHXAQ7kNvwG3sEN5&_nc_oc=AdrbY7IHer2ZiVckhzVxDiplCZVpl43wpyZ9Oy4Jdpvqeu28Jn-2lMx50pzFILqk9wM&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHn3CfA6-2lV6Mgbwr4g39U7AfxYt-yKzCLE_60F3zOqw&oe=6A858F4B"}, {"file_name": "Screenshot06.png", "id": "970563445094246", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/39031450_970563448427579_1896364834470325490_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zk8bbjD2DpwQ7kNvwF7o6Ur&_nc_oc=AdqxO5BwWaEFaB28_zCgk1gk1odXSF5tkamnahrp0ZSCP9Q8n33noqcp0BMS5K3oJtg&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEvBxZRt505NtP4-feOjt4vaLV5L7Uu5IfRdCX6NP0M7Q&oe=6A85AED2"}, {"file_name": "Screenshot04.png", "id": "575729695062740", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/39031400_575729698396073_2621336866475747103_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XTpimjhnkkcQ7kNvwGJdnMR&_nc_oc=AdrjbF3sMUaWX4FktPRPILFhrPBhgx5mcx53oVyekPz6baw4Qw4xrErQd5L8FC1ktZU&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH2TXSxO1inapXkutdwEHCSNnTSUfkcX85IKKpTQJwbBg&oe=6A857D9C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Gameplay Trailer Thumb.png", "id": "605202028847932", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/38974836_605202032181265_2417977283558520499_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B5vBmEsHCuoQ7kNvwFcBalt&_nc_oc=Adoo8f_y9tAsoiV0u1YKW-doID1p6DEsV4uKiJYiBAZVQbf0A_rFMn6Si2vYgJaFh7M&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEUniQxJT6L0odvQYb1ZYQwO4HTKgCGBeRsnc7RapvkNg&oe=6A858559"}, "display_name": "Squishies - Roll them Home!", "keywords": ["puzzle", "platformer", "sandbox", "exploration", "adventure"], "long_description": "**Get lost in the Squishies-verse!**\n\nSquishies is a head-scratching puzzle platformer where you guide courageous and cute creatures through a series of increasingly hazardous, challenging mazes. Use unique motion controls to push and pull the Squishies through their adventures in a colorful universe full of strange flora and fauna. Keep those little rascals safe while they climb, jump, fly and teleport-by-fish through dozens of levels in five alien worlds!\n\n{507625458961423}\n\nYou push and pull the Squishies from one side of the maze to the other, all while earning medals, gathering crystals, climbing slopes, and avoiding pitfalls.\n\n- **Explore a huge universe** - Across dozens of levels in five different worlds.\n- **Collectibles and Achievements** - Gather all the crystals, beat the clock or find the hidden egg in each level.\n- **Level Editor** - Squishies really comes into its own with its innovative, fully featured creation tools.\n- **Community Section** - Share your creation with others and play their ingenious levels.\n- **Limited play space?** Need to keep an eye on your own little monsters?  You\u2019re in luck. Squishies\u00ae can be played in the newly added Mixed Reality mode!\n\n\n{482757334822594}", "short_description": "Help the stranded Squishies find their way back home! Push and pull them through challenging puzzles, or create your own levels with the powerful in-game editor and share them with the community."}]}, "developer_name": null, "developer_privacy_policy_url": "https://brainseed-factory.com/law/privacy_products/index.php", "developer_terms_of_service_url": "https://brainseed-factory.com/law/terms_products/index.p
culuscdn.com/v/t64.5771-25/75322598_1145165853836223_6864148320373849862_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n31ZuzynBsQQ7kNvwGsPuo4&_nc_oc=Adp-qGYT_xHnsyt9Ksn5KX7GDvJkJw6DJzWQBv3MigcDYfBYE_u8dkP5vpUZigXaa_g&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDKoBka6oAY2oyRabPmVf_QQCOdRZd9zu3_Ygmf1u8wdg&oe=6A5B6143"}, {"file_name": "Screenshot03.png", "id": "598340872572801", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39001670_598340875906134_7078948835759736288_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x9K6J4H8CaoQ7kNvwFlbL9I&_nc_oc=AdqFDvSIsbY36IgJFhzcr537YcfNyPHXft1nW4e7Ezec3Jb6kWfjlj3A0np1LrBjyfc&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA5eFraKJ8sds1uPJ7d_Eiya1-ZGtsdW-w2Fo8ZrXCu1g&oe=6A5B5F4B"}, {"file_name": "Screenshot06.png", "id": "970563445094246", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031450_970563448427579_1896364834470325490_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aRxRQ5fP9UkQ7kNvwE9E71e&_nc_oc=AdprmqvRW0gts2Bk-2gcCLRQQsoyLq6YQk3SUOljaIK07tMcIbgeMU2RBirKrrWKWMY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCdP_U7hZiUgmPXkf__t6QORfRlbdk_Xa_ZNwTaivmsEQ&oe=6A5B7ED2"}, {"file_name": "Screenshot04.png", "id": "575729695062740", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39031400_575729698396073_2621336866475747103_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j6phE_V8kloQ7kNvwHB9-Ta&_nc_oc=AdqgtH8oFO8Gmwu94yDstkHMSPM8bV2Ir9ursRmmYyITAC_7MpVAO2rxENQuOuTm0Z8&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAFNGrVvn5clHjHE787izQDVI4U5wynsnN1eT1uM2_AqA&oe=6A5B85DC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Gameplay Trailer Thumb.png", "id": "605202028847932", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974836_605202032181265_2417977283558520499_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NTX0seSoe6kQ7kNvwEcU6hq&_nc_oc=AdrNHl6ll6EIJZbxH51Oe-Rm56nCaHFDIWz-uR6FdLebbraKNI4iNBH_lfJl0pRPXOI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBps7SFry7bAktWR9NdKYLeNWxh3mjQDCyLcF3yr74wEA&oe=6A5B8D99"}, "display_name": "Squishies - Roll them Home!", "keywords": ["puzzle", "platformer", "sandbox", "exploration", "adventure"], "long_description": "**Get lost in the Squishies-verse!**\n\nSquishies is a head-scratching puzzle platformer where you guide courageous and cute creatures through a series of increasingly hazardous, challenging mazes. Use unique motion controls to push and pull the Squishies through their adventures in a colorful universe full of strange flora and fauna. Keep those little rascals safe while they climb, jump, fly and teleport-by-fish through dozens of levels in five alien worlds!\n\n{507625458961423}\n\nYou push and pull the Squishies from one side of the maze to the other, all while earning medals, gathering crystals, climbing slopes, and avoiding pitfalls.\n\n- **Explore a huge universe** - Across dozens of levels in five different worlds.\n- **Collectibles and Achievements** - Gather all the crystals, beat the clock or find the hidden egg in each level.\n- **Level Editor** - Squishies really comes into its own with its innovative, fully featured creation tools.\n- **Community Section** - Share your creation with others and play their ingenious levels.\n- **Limited play space?** Need to keep an eye on your own little monsters?  You\u2019re in luck. Squishies\u00ae can be played in the newly added Mixed Reality mode!\n\n\n{482757334822594}", "short_description": "Help the stranded Squishies find their way back home! Push and pull them through challenging puzzles, or create your own levels with the powerful in-game editor and share them with the community."}]}, "developer_name": null, "developer_privacy_policy_url": "https://brainseed-factory.com/law/privacy_products/index.php", "developer_terms_of_service_url": "https://brainseed-factory.com/law/terms_products/index.php", "publishe
uluscdn.com/v/t64.5771-25/75322598_1145165853836223_6864148320373849862_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wjHDr2PR5DMQ7kNvwGfzZSV&_nc_oc=AdoCYkYOMLJ7VD3PiF0xK_KereyC-byGNnviqq04rKxgVqYa8EmnoAj0QNaz1G2zAiM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4nNKo56tqFGL6lfDVYJPoISETeQ_fwGu6CDIEHSuEM1Q&oe=69FB5C03"}, {"file_name": "Screenshot03.png", "id": "598340872572801", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39001670_598340875906134_7078948835759736288_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=exAEBArUX7MQ7kNvwGuVdw_&_nc_oc=AdqEeDyUMw0XTfDHAn5Uv8JtxPuOy43wMgNWBRC9y7qM1wkw7LamS6dtbeq5ED7qgpM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4gCNfUHbHj2KC3rdrRFTQuOs9hqLilXGnh1C0XX-dACw&oe=69FB5A0B"}, {"file_name": "Screenshot06.png", "id": "970563445094246", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031450_970563448427579_1896364834470325490_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6824bh8Q43IQ7kNvwGDu5l0&_nc_oc=AdpzILHUvfnr0SmLd2gRf5a3ptOGrcVYzXzgXFqdiGrUxGDYbwuPcGAdl9o_EpB6GkE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4Ittt2hLy_1S34iLau6W-YUofpAfhpSQePeEBlckhMaw&oe=69FB4152"}, {"file_name": "Screenshot04.png", "id": "575729695062740", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031400_575729698396073_2621336866475747103_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nlmtKQt2BusQ7kNvwG0mx0A&_nc_oc=AdpK3x5YwfUpveDk0KnoQiE02SdvccCbyUftVmL0vJZ9-8DQumHuuO5cX4b-78u-vmY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af45nUiBcmfrqwoN2B20mNGzrUcqrCecuQ7LI2SH-KLp2w&oe=69FB485C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Gameplay Trailer Thumb.png", "id": "605202028847932", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974836_605202032181265_2417977283558520499_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JLMwMSMMm9MQ7kNvwFn-EFo&_nc_oc=AdqdnCwn6veh3J1aYuKD7h0aFC4_ZVgqn91tnDg04sNoE7XnwTMbwhi4oRv2jpqhTIs&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7WoISz8lpeUZPwaNOTbm8T6Ygb4jekPUsSdF4CJHidvg&oe=69FB5019"}, "display_name": "Squishies - Roll them Home!", "keywords": ["puzzle", "platformer", "sandbox", "exploration", "adventure"], "long_description": "**Get lost in the Squishies-verse!**\n\nSquishies is a head-scratching puzzle platformer where you guide courageous and cute creatures through a series of increasingly hazardous, challenging mazes. Use unique motion controls to push and pull the Squishies through their adventures in a colorful universe full of strange flora and fauna. Keep those little rascals safe while they climb, jump, fly and teleport-by-fish through dozens of levels in five alien worlds!\n\n{507625458961423}\n\nYou push and pull the Squishies from one side of the maze to the other, all while earning medals, gathering crystals, climbing slopes, and avoiding pitfalls.\n\n- **Explore a huge universe** - Across dozens of levels in five different worlds.\n- **Collectibles and Achievements** - Gather all the crystals, beat the clock or find the hidden egg in each level.\n- **Level Editor** - Squishies really comes into its own with its innovative, fully featured creation tools.\n- **Community Section** - Share your creation with others and play their ingenious levels.\n- **Limited play space?** Need to keep an eye on your own little monsters?  You\u2019re in luck. Squishies\u00ae can be played in the newly added Mixed Reality mode!\n\n\n{482757334822594}", "short_description": "Help the stranded Squishies find their way back home! Push and pull them through challenging puzzles, or create your own levels with the powerful in-game editor and share them with the community."}]}, "developer_name": null, "developer_privacy_policy_url": "https://brainseed-factory.com/law/privacy_products/index.php", "developer_terms_of_service_url": "https://brainseed-factory.com/law/terms_products/index.php", "publisher
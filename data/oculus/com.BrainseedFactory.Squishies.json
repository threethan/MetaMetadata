sin2-2.oculuscdn.com/v/t64.5771-25/75322598_1145165853836223_6864148320373849862_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ixP780GZFNYQ7kNvwE8kaH9&_nc_oc=Adp7fKALW9PF_EPdFw4aQ_3ztwdIgyS-6R435KqSU9CS-4jmIJ-Gi14U4upVDnLlFY0&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_ntcaXd-lrxk-NpdeWV7CmjU7driY-vXfFBkkJTVmN8A&oe=6A36AF83"}, {"file_name": "Screenshot03.png", "id": "598340872572801", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/39001670_598340875906134_7078948835759736288_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KmasklOg0BYQ7kNvwFKTabt&_nc_oc=AdpN7y6GZJ0G8ZJygwCSk5F-Zq07MGWeRqV3GPc7hwa1wy7M1VS6tdlzoSV_45LusEQ&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af94XipMIAjwEyhpt0w5jEI31oi3yCH_AMAFEClmcrEPaA&oe=6A36AD8B"}, {"file_name": "Screenshot06.png", "id": "970563445094246", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/39031450_970563448427579_1896364834470325490_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=97lE5LJ06wcQ7kNvwHsxkmU&_nc_oc=Adra6oLIHR8b6W43fDlpPpNDIzxY5HEY-etC_y0Aq-P39MJkLjyCEH927UTQ1IXF6fY&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_idcFbgSyS1b4lmZCToL6FcGdYBjCuRV7VKGH2WI2vrw&oe=6A3694D2"}, {"file_name": "Screenshot04.png", "id": "575729695062740", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/39031400_575729698396073_2621336866475747103_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ANblixcDM8cQ7kNvwF6ZvFS&_nc_oc=Adp-OsrIXGI4Fi3kIuDj5JDc3AR8iBPBJ0UFEfViMBh0OGsNovK2ImFjqZV3IWOOCpA&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8cpySggFvQdkTeo8PO7QgM9e40I9gwMYOfOP26A19Ghw&oe=6A369BDC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Gameplay Trailer Thumb.png", "id": "605202028847932", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/38974836_605202032181265_2417977283558520499_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qmBXKLvm3uYQ7kNvwFkuaiI&_nc_oc=AdoMzbISSeQqzmxCghgLylBK2Xz4xkeV89VDyJlnGKOGzkGig5cI7QRe0pjjb770BsM&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8Gp5NcMvOr_wp-Yv2stxMCMvky1gBnrucFbOOuqGrRHg&oe=6A36A399"}, "display_name": "Squishies - Roll them Home!", "keywords": ["puzzle", "platformer", "sandbox", "exploration", "adventure"], "long_description": "**Get lost in the Squishies-verse!**\n\nSquishies is a head-scratching puzzle platformer where you guide courageous and cute creatures through a series of increasingly hazardous, challenging mazes. Use unique motion controls to push and pull the Squishies through their adventures in a colorful universe full of strange flora and fauna. Keep those little rascals safe while they climb, jump, fly and teleport-by-fish through dozens of levels in five alien worlds!\n\n{507625458961423}\n\nYou push and pull the Squishies from one side of the maze to the other, all while earning medals, gathering crystals, climbing slopes, and avoiding pitfalls.\n\n- **Explore a huge universe** - Across dozens of levels in five different worlds.\n- **Collectibles and Achievements** - Gather all the crystals, beat the clock or find the hidden egg in each level.\n- **Level Editor** - Squishies really comes into its own with its innovative, fully featured creation tools.\n- **Community Section** - Share your creation with others and play their ingenious levels.\n- **Limited play space?** Need to keep an eye on your own little monsters?  You\u2019re in luck. Squishies\u00ae can be played in the newly added Mixed Reality mode!\n\n\n{482757334822594}", "short_description": "Help the stranded Squishies find their way back home! Push and pull them through challenging puzzles, or create your own levels with the powerful in-game editor and share them with the community."}]}, "developer_name": null, "developer_privacy_policy_url": "https://brainseed-factory.com/law/privacy_products/index.php", "developer_terms_of_service_url": "https://brainseed-factory.com/law/terms_products/index.php
uluscdn.com/v/t64.5771-25/75322598_1145165853836223_6864148320373849862_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4vwAtX2kYsQQ7kNvwE5clpr&_nc_oc=Adq7WcmXHV1vVsGjtMgbulavXE9pRlFbGO27z6l_x1KTCzExh3UUX_BXeFoinMExSoI&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3eC0gOuC4Z3HpEnIIssRRQaG2z6t8I9T-g3O0IYimXDA&oe=69D78B43"}, {"file_name": "Screenshot03.png", "id": "598340872572801", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/39001670_598340875906134_7078948835759736288_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OhaqS-WKFHYQ7kNvwE4YB8_&_nc_oc=AdqlPKHgIjw8MGKybxG698gBC62o2-pV4kySakhS0Yd_l9FPuxEAL9LDt4K0j3guAzw&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1LlVDyM3bJMYqnhwbzIO51fJw84AM1rg2qQoAZlQb8gA&oe=69D7894B"}, {"file_name": "Screenshot06.png", "id": "970563445094246", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/39031450_970563448427579_1896364834470325490_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rmuhkYMRqBUQ7kNvwFmONw4&_nc_oc=AdpwYtlE-_ljRtRJHYKs3te5OZhYBrG1JHJgQGwHmpxrGLFGfTXQG99KEvly6KTl3ZU&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1ucBmd9XNnAVqLJ5zzxMlXZT5ikQfjD516nSKs_QfUBA&oe=69D7A8D2"}, {"file_name": "Screenshot04.png", "id": "575729695062740", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/39031400_575729698396073_2621336866475747103_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_nP-97NGhn8Q7kNvwGLpJCO&_nc_oc=Adppky4ocMt9FwTN0Nubdf5SYIDH8deLzo08FSec88_H3qWeZDhozu_pgzn_hI_SrQk&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0FxO3pFf0naa4SZKYPtl8j0Ob1Yk9_3XVsp43epsDkZg&oe=69D7AFDC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Gameplay Trailer Thumb.png", "id": "605202028847932", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/38974836_605202032181265_2417977283558520499_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HPWm3gMSnCsQ7kNvwFdo6rM&_nc_oc=AdoQ3qR61FNfUOORH23qBWmCdIurLM3Jhgz_SXl8fbLXu_1YJg0ltsFiaxyFUR9SZ3o&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0Yecxe0-Y_Sn4tUfeofNK6SNPexUtZgE5o-u3f4gncxw&oe=69D7B799"}, "display_name": "Squishies - Roll them Home!", "keywords": ["puzzle", "platformer", "sandbox", "exploration", "adventure"], "long_description": "**Get lost in the Squishies-verse!**\n\nSquishies is a head-scratching puzzle platformer where you guide courageous and cute creatures through a series of increasingly hazardous, challenging mazes. Use unique motion controls to push and pull the Squishies through their adventures in a colorful universe full of strange flora and fauna. Keep those little rascals safe while they climb, jump, fly and teleport-by-fish through dozens of levels in five alien worlds!\n\n{507625458961423}\n\nYou push and pull the Squishies from one side of the maze to the other, all while earning medals, gathering crystals, climbing slopes, and avoiding pitfalls.\n\n- **Explore a huge universe** - Across dozens of levels in five different worlds.\n- **Collectibles and Achievements** - Gather all the crystals, beat the clock or find the hidden egg in each level.\n- **Level Editor** - Squishies really comes into its own with its innovative, fully featured creation tools.\n- **Community Section** - Share your creation with others and play their ingenious levels.\n- **Limited play space?** Need to keep an eye on your own little monsters?  You\u2019re in luck. Squishies\u00ae can be played in the newly added Mixed Reality mode!\n\n\n{482757334822594}", "short_description": "Help the stranded Squishies find their way back home! Push and pull them through challenging puzzles, or create your own levels with the powerful in-game editor and share them with the community."}]}, "developer_name": null, "developer_privacy_policy_url": "https://brainseed-factory.com/law/privacy_products/index.php", "developer_terms_of_service_url": "https://brainseed-factory.com/law/terms_products/index.php", "publisher
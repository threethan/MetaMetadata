culuscdn.com/v/t64.5771-25/75322598_1145165853836223_6864148320373849862_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CQA2iQxxUP0Q7kNvwHmaI4h&_nc_oc=Adrxvm2DsGjz8uApDTLQvd14_cnroPS1aBPPsA9BY98DDpa9zqAXUlivp_HMuGdZC3U&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQkPKmdbk2DZ_UQs6NYE7FJC7edD1rXsj05ASoXHU5MNQ&oe=6AE8AA03"}, {"file_name": "Screenshot03.png", "id": "598340872572801", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/39001670_598340875906134_7078948835759736288_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6jI8CszMzJwQ7kNvwGJ-25Z&_nc_oc=AdqUd7ha4AU56IdYudOCQ06ot32y5gW-H7b5mRJ9bPAyMtai9Yr1tZyYIQ_dRr8yNQg&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSfBcdYw8N3wL6pbWh_gi1mWZ14ZgsE3eGSTbEIvJCP-A&oe=6AE8A80B"}, {"file_name": "Screenshot06.png", "id": "970563445094246", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/39031450_970563448427579_1896364834470325490_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D5ZYx5dHgBUQ7kNvwEvfMv5&_nc_oc=AdpluVgIT2WDlj81zdwqPMPyy0T3vWKKzuAtgc8AddvIXSW8-lNi1wJu0CLAu209L9c&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTQ4o9900ecZFA_Pf4lt0tTQL0aJ5GxMiZa4POMhADNZQ&oe=6AE88F52"}, {"file_name": "Screenshot04.png", "id": "575729695062740", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/39031400_575729698396073_2621336866475747103_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=08PGuyND-rMQ7kNvwG3E3Z1&_nc_oc=AdrR7uGg_-vB4SRGRd-lSgbSTxg4qR3uvs5DBgUjRUXirfZ4LYvRELYKxdX-VwFfh-w&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRcxvwCCEFSkreqy3jDMN0kgwALI8uMoeewCe0_KBQAAQ&oe=6AE8965C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Gameplay Trailer Thumb.png", "id": "605202028847932", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38974836_605202032181265_2417977283558520499_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MczF-80mtUwQ7kNvwEUNj4c&_nc_oc=AdoPHpg2PkUx5jQKxZXJ-A9ROctd4g-7dB65WVwHBPZ-b1K8mP7sFatB1M9_qoiMz0A&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRhRUMmuKhPsv43ebTFxnZ4IV4T5gXZMzZoGqWzsoARfQ&oe=6AE89E19"}, "display_name": "Squishies - Roll them Home!", "keywords": ["puzzle", "platformer", "sandbox", "exploration", "adventure"], "long_description": "**Get lost in the Squishies-verse!**\n\nSquishies is a head-scratching puzzle platformer where you guide courageous and cute creatures through a series of increasingly hazardous, challenging mazes. Use unique motion controls to push and pull the Squishies through their adventures in a colorful universe full of strange flora and fauna. Keep those little rascals safe while they climb, jump, fly and teleport-by-fish through dozens of levels in five alien worlds!\n\n{507625458961423}\n\nYou push and pull the Squishies from one side of the maze to the other, all while earning medals, gathering crystals, climbing slopes, and avoiding pitfalls.\n\n- **Explore a huge universe** - Across dozens of levels in five different worlds.\n- **Collectibles and Achievements** - Gather all the crystals, beat the clock or find the hidden egg in each level.\n- **Level Editor** - Squishies really comes into its own with its innovative, fully featured creation tools.\n- **Community Section** - Share your creation with others and play their ingenious levels.\n- **Limited play space?** Need to keep an eye on your own little monsters?  You\u2019re in luck. Squishies\u00ae can be played in the newly added Mixed Reality mode!\n\n\n{482757334822594}", "short_description": "Help the stranded Squishies find their way back home! Push and pull them through challenging puzzles, or create your own levels with the powerful in-game editor and share them with the community."}]}, "developer_name": null, "developer_privacy_policy_url": "https://brainseed-factory.com/law/privacy_products/index.php", "developer_terms_of_service_url": "https://brainseed-factory.com/law/terms_products/index.php", "publishe
culuscdn.com/v/t64.5771-25/75322598_1145165853836223_6864148320373849862_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bwT1u5ykxoUQ7kNvwF6YAu7&_nc_oc=AdpG00cfxFw3jpzjtwxreGMy90tn_qxrZu26fOL1sgzlTNXbcwwVNKSuOrp9TWS1Xdw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPdXGuiA-dfOk0qMEp-QYzR4fLzPoTKcxz__nNB54oiwQ&oe=6ACE4C03"}, {"file_name": "Screenshot03.png", "id": "598340872572801", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39001670_598340875906134_7078948835759736288_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_ZQcZjEwfBQQ7kNvwGYQgHo&_nc_oc=AdpqlBCnS1IibPJPkgY3CTeIqHbEDDW8V_janhKiAelvse7FIBdI-UB6SOvy7AGQaIA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOtuyUVDZZyR7pKloL17UNfHZzDsYpcQi2YFyVi-D8VtA&oe=6ACE4A0B"}, {"file_name": "Screenshot06.png", "id": "970563445094246", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031450_970563448427579_1896364834470325490_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Cp6plRgb_ngQ7kNvwHuPXGb&_nc_oc=AdqZagapH73q_Nd_IfNfUHG94vPeQO_i7rTN6kWb5JUJhCx2gQu-CtqNAlBaDZ876to&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOiw4VSrR8yASqo3kJmqdNr3R0OkO1mO1sibKkTAXukOA&oe=6ACE6992"}, {"file_name": "Screenshot04.png", "id": "575729695062740", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031400_575729698396073_2621336866475747103_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vuz9ZEIpfD4Q7kNvwHlTrCs&_nc_oc=AdqvSo1WNUwMt-s0FdEqvzsFzMaQ-dEBNtVQwPEssWiVVbOnBHARpLXklM4xjujJtKs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOW0lHW5FgPzv5sA8sfHq8LHDR7yHepHAes5YAlTcSgag&oe=6ACE385C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Gameplay Trailer Thumb.png", "id": "605202028847932", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974836_605202032181265_2417977283558520499_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WesBX9s8KngQ7kNvwH_35aF&_nc_oc=Ado9KTXKn9yooX_dMhJQl43xLAwZ6anLAbT_lCHo_Q5m0Sqbh76xj42XTG-FZkSdva4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPUKyDKhOfzWlhTq8nUyRJq9DTr3jFx-7NPBH4KqzwYMA&oe=6ACE4019"}, "display_name": "Squishies - Roll them Home!", "keywords": ["puzzle", "platformer", "sandbox", "exploration", "adventure"], "long_description": "**Get lost in the Squishies-verse!**\n\nSquishies is a head-scratching puzzle platformer where you guide courageous and cute creatures through a series of increasingly hazardous, challenging mazes. Use unique motion controls to push and pull the Squishies through their adventures in a colorful universe full of strange flora and fauna. Keep those little rascals safe while they climb, jump, fly and teleport-by-fish through dozens of levels in five alien worlds!\n\n{507625458961423}\n\nYou push and pull the Squishies from one side of the maze to the other, all while earning medals, gathering crystals, climbing slopes, and avoiding pitfalls.\n\n- **Explore a huge universe** - Across dozens of levels in five different worlds.\n- **Collectibles and Achievements** - Gather all the crystals, beat the clock or find the hidden egg in each level.\n- **Level Editor** - Squishies really comes into its own with its innovative, fully featured creation tools.\n- **Community Section** - Share your creation with others and play their ingenious levels.\n- **Limited play space?** Need to keep an eye on your own little monsters?  You\u2019re in luck. Squishies\u00ae can be played in the newly added Mixed Reality mode!\n\n\n{482757334822594}", "short_description": "Help the stranded Squishies find their way back home! Push and pull them through challenging puzzles, or create your own levels with the powerful in-game editor and share them with the community."}]}, "developer_name": null, "developer_privacy_policy_url": "https://brainseed-factory.com/law/privacy_products/index.php", "developer_terms_of_service_url": "https://brainseed-factory.com/law/terms_products/index.php", "publishe
culuscdn.com/v/t64.5771-25/75322598_1145165853836223_6864148320373849862_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H6OYEJ1RphwQ7kNvwFhNpH2&_nc_oc=AdqgqowvrMH5IW4P9ANPUKushPFQqdItUE4hynmnAliAoZp4ckAJv31xZM-G5mOvtlY&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOMPNSqyTVImQKWpToKKNbEwje394v-pJia8zh3GjV8MQ&oe=6ADE1E03"}, {"file_name": "Screenshot03.png", "id": "598340872572801", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39001670_598340875906134_7078948835759736288_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gyG4NE_EykoQ7kNvwGY3EC5&_nc_oc=AdpcOTod-0ruXcMbMhc2vkZ8EjCd7iitU9R9gsOHpUgVO042ypzbsVHTbLgf0C6Pzh0&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPOkUh0kMSF92VCYxUTfXOTJH3vhiQPpBVhj1Zd6XDLjw&oe=6ADE1C0B"}, {"file_name": "Screenshot06.png", "id": "970563445094246", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031450_970563448427579_1896364834470325490_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G7OwzDL8ldcQ7kNvwF9hVU6&_nc_oc=AdoOL00zOYCkm-KSnlG0TMMNxQ9F0GCKPSsHpfbEytrlVb_fVYpIP_hLeJ8x_ZGAkXo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMSmaB5eWQi3VB132vWt5SJvK-hAPwQWSzm49BIuHvOrw&oe=6ADE0352"}, {"file_name": "Screenshot04.png", "id": "575729695062740", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39031400_575729698396073_2621336866475747103_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i4oCFHQRzKcQ7kNvwFgXePx&_nc_oc=AdqkADXGy4mIE9UKtvgjxEGx-1So6lNJcRlygMSYojusC5pANKonUh4-FYRptanrTXI&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPTS-J9xve36ROPjXWEASZykc-t-NRJm1M-LcF186A-FA&oe=6ADE0A5C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Gameplay Trailer Thumb.png", "id": "605202028847932", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974836_605202032181265_2417977283558520499_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VPujtytH11MQ7kNvwHrkDiT&_nc_oc=AdrpfD37cJ9ypqJlcc3gvZ0mk4UF7vU9Fx3Hi5__QTQIozHUthc9kgi1axL-Y_F07-s&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM9QZRxZpMR0Jxb9yufdZnLzHBdjx4WA0PGaTO209GKLA&oe=6ADE1219"}, "display_name": "Squishies - Roll them Home!", "keywords": ["puzzle", "platformer", "sandbox", "exploration", "adventure"], "long_description": "**Get lost in the Squishies-verse!**\n\nSquishies is a head-scratching puzzle platformer where you guide courageous and cute creatures through a series of increasingly hazardous, challenging mazes. Use unique motion controls to push and pull the Squishies through their adventures in a colorful universe full of strange flora and fauna. Keep those little rascals safe while they climb, jump, fly and teleport-by-fish through dozens of levels in five alien worlds!\n\n{507625458961423}\n\nYou push and pull the Squishies from one side of the maze to the other, all while earning medals, gathering crystals, climbing slopes, and avoiding pitfalls.\n\n- **Explore a huge universe** - Across dozens of levels in five different worlds.\n- **Collectibles and Achievements** - Gather all the crystals, beat the clock or find the hidden egg in each level.\n- **Level Editor** - Squishies really comes into its own with its innovative, fully featured creation tools.\n- **Community Section** - Share your creation with others and play their ingenious levels.\n- **Limited play space?** Need to keep an eye on your own little monsters?  You\u2019re in luck. Squishies\u00ae can be played in the newly added Mixed Reality mode!\n\n\n{482757334822594}", "short_description": "Help the stranded Squishies find their way back home! Push and pull them through challenging puzzles, or create your own levels with the powerful in-game editor and share them with the community."}]}, "developer_name": null, "developer_privacy_policy_url": "https://brainseed-factory.com/law/privacy_products/index.php", "developer_terms_of_service_url": "https://brainseed-factory.com/law/terms_products/index.php", "publishe
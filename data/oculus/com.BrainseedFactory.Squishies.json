culuscdn.com/v/t64.5771-25/75322598_1145165853836223_6864148320373849862_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bwT1u5ykxoUQ7kNvwHl_2-A&_nc_oc=AdoaRgoUB_6s-CpshMrbeJiNMPxCceGAg90XQsOwIfssNY1ZvaPH7ive8R4cvV1_hB4&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOy0kJVX6D2esVKnlf3e0zGsvLXrts1McLSwZEyP_fycQ&oe=6ACCFA83"}, {"file_name": "Screenshot03.png", "id": "598340872572801", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39001670_598340875906134_7078948835759736288_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_ZQcZjEwfBQQ7kNvwFQ83QF&_nc_oc=Adpc26VGoiz3WgbikmmXC5sGVDJGvwGsgEtwMzEf7VsvbUOtZy8u9HFAcIsuxoZsKFQ&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN5VfCbCye5mKazVss6g0ow2IGZ1o72TjuHFajVxqle_w&oe=6ACCF88B"}, {"file_name": "Screenshot06.png", "id": "970563445094246", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031450_970563448427579_1896364834470325490_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Cp6plRgb_ngQ7kNvwE9Ph9q&_nc_oc=AdrszYQvexcNdKY0mvzg0wapFA_tJwEOOv0d6wB26pxl6-vnx8UZbofbhCqUqd-XMac&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNzZ-WdKlzRvX9d0iNRCTMWl-BkwE1xfo8N6AzIN_BVtg&oe=6ACD1812"}, {"file_name": "Screenshot04.png", "id": "575729695062740", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39031400_575729698396073_2621336866475747103_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vuz9ZEIpfD4Q7kNvwFfb3cw&_nc_oc=AdqQKzeVFXcABJZo8g_AVfivZ_wvNIlJayNbgdpbCvG_VnBiJUbq8bRupi9pO-6lGUo&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNSunOlOaON3aiYA8_8UbT8sXXaQYTfS-PXWTLUaOfvRw&oe=6ACCE6DC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Gameplay Trailer Thumb.png", "id": "605202028847932", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974836_605202032181265_2417977283558520499_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GuIBXuXDm4EQ7kNvwFj7FEX&_nc_oc=AdoddZydlSLWhVP0CNYqV4DvqDIhs1zUrHMzMFe4VMBd8X4ETei8PhNoXdQFjSDL9kE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM8HyIZwsmiFhRrtJM79zaLdr6gduTpd5o_W2fu5nqu1Q&oe=6ACCEE99"}, "display_name": "Squishies - Roll them Home!", "keywords": ["puzzle", "platformer", "sandbox", "exploration", "adventure"], "long_description": "**Get lost in the Squishies-verse!**\n\nSquishies is a head-scratching puzzle platformer where you guide courageous and cute creatures through a series of increasingly hazardous, challenging mazes. Use unique motion controls to push and pull the Squishies through their adventures in a colorful universe full of strange flora and fauna. Keep those little rascals safe while they climb, jump, fly and teleport-by-fish through dozens of levels in five alien worlds!\n\n{507625458961423}\n\nYou push and pull the Squishies from one side of the maze to the other, all while earning medals, gathering crystals, climbing slopes, and avoiding pitfalls.\n\n- **Explore a huge universe** - Across dozens of levels in five different worlds.\n- **Collectibles and Achievements** - Gather all the crystals, beat the clock or find the hidden egg in each level.\n- **Level Editor** - Squishies really comes into its own with its innovative, fully featured creation tools.\n- **Community Section** - Share your creation with others and play their ingenious levels.\n- **Limited play space?** Need to keep an eye on your own little monsters?  You\u2019re in luck. Squishies\u00ae can be played in the newly added Mixed Reality mode!\n\n\n{482757334822594}", "short_description": "Help the stranded Squishies find their way back home! Push and pull them through challenging puzzles, or create your own levels with the powerful in-game editor and share them with the community."}]}, "developer_name": null, "developer_privacy_policy_url": "https://brainseed-factory.com/law/privacy_products/index.php", "developer_terms_of_service_url": "https://brainseed-factory.com/law/terms_products/index.php", "publishe
uluscdn.com/v/t64.5771-25/75322598_1145165853836223_6864148320373849862_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lCKMKax4ihoQ7kNvwFW-8E5&_nc_oc=AdofpGQ4TMiKGuy0BE03RKsCAOkqrGGpEWSjgzHCi1WyFWp5-DurMw5vNK8QngtCviM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7x_x8mW0upL9BoEWjJDKOuS4foc9gqRF6CKtqsKQlQtg&oe=6A088B03"}, {"file_name": "Screenshot03.png", "id": "598340872572801", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39001670_598340875906134_7078948835759736288_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kHVYWYigTrcQ7kNvwFrfqyi&_nc_oc=AdrTfRHeB4pDWtFr3PTr_NCJ2vBCDIVY-3mKV4SmJwfdqoyd9lvW0UQ-Go1nI6ASTWs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6o_ZxyQ-uVRR0zcMmIeh0_-r1oE33639FOjgq4FdT6lA&oe=6A08890B"}, {"file_name": "Screenshot06.png", "id": "970563445094246", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031450_970563448427579_1896364834470325490_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=skkcsoxpGKYQ7kNvwH1wnds&_nc_oc=Adqyr1TfitDV-3Zjw35bn3CxQBXRtAAkChN4_XNPzvZkS9j_sjILsPhXkoeJlMjxUO4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7dKooRQ61v9ERJ3vACawaE6VxV_0h5UU9qtcqlfgUg8Q&oe=6A087052"}, {"file_name": "Screenshot04.png", "id": "575729695062740", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031400_575729698396073_2621336866475747103_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=An7XVRFzcYAQ7kNvwGVDxhG&_nc_oc=AdqPvEwyPAi8E1mUTYZ6nPUiei6xMCE0sdvbXMVcCLPJR-HjYgCvde8vBOfjsfa7C0E&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4_Y_RiYM74-YdM4R1RNKzpR-cRtXpfI4tniKl0FK5trA&oe=6A08775C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Gameplay Trailer Thumb.png", "id": "605202028847932", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974836_605202032181265_2417977283558520499_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=42ztYomN1x0Q7kNvwH9gN4R&_nc_oc=AdoiLbB1orunDkjk_mDHMx9pjsSJebEg0FcytxSOZ4mrsMAhN8rkyJ-LjwyTWk3YHK8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af64KEDt1cMkcd7yumnNZpXmkZjYI9RCaVhThdq5rOsnLQ&oe=6A087F19"}, "display_name": "Squishies - Roll them Home!", "keywords": ["puzzle", "platformer", "sandbox", "exploration", "adventure"], "long_description": "**Get lost in the Squishies-verse!**\n\nSquishies is a head-scratching puzzle platformer where you guide courageous and cute creatures through a series of increasingly hazardous, challenging mazes. Use unique motion controls to push and pull the Squishies through their adventures in a colorful universe full of strange flora and fauna. Keep those little rascals safe while they climb, jump, fly and teleport-by-fish through dozens of levels in five alien worlds!\n\n{507625458961423}\n\nYou push and pull the Squishies from one side of the maze to the other, all while earning medals, gathering crystals, climbing slopes, and avoiding pitfalls.\n\n- **Explore a huge universe** - Across dozens of levels in five different worlds.\n- **Collectibles and Achievements** - Gather all the crystals, beat the clock or find the hidden egg in each level.\n- **Level Editor** - Squishies really comes into its own with its innovative, fully featured creation tools.\n- **Community Section** - Share your creation with others and play their ingenious levels.\n- **Limited play space?** Need to keep an eye on your own little monsters?  You\u2019re in luck. Squishies\u00ae can be played in the newly added Mixed Reality mode!\n\n\n{482757334822594}", "short_description": "Help the stranded Squishies find their way back home! Push and pull them through challenging puzzles, or create your own levels with the powerful in-game editor and share them with the community."}]}, "developer_name": null, "developer_privacy_policy_url": "https://brainseed-factory.com/law/privacy_products/index.php", "developer_terms_of_service_url": "https://brainseed-factory.com/law/terms_products/index.php", "publisher
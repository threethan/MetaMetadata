culuscdn.com/v/t64.5771-25/75322598_1145165853836223_6864148320373849862_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bwT1u5ykxoUQ7kNvwHexmWa&_nc_oc=AdrM8BQCWvxvPVBXE9CHuxviOlF7qA4vfjnCD0mgahxocV2yVfdMEGvfOTUpSATwbY0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOCja_X6PhRGjtqjbI4n1wLcgXIVw1aKhHwiml07Ir1tA&oe=6ACBA903"}, {"file_name": "Screenshot03.png", "id": "598340872572801", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39001670_598340875906134_7078948835759736288_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_ZQcZjEwfBQQ7kNvwFaFeg8&_nc_oc=AdpJQF_DrMvxnW1c9Q8KjmsvkFUXOszsZMA4DhbNlLVZWIKLAscgO0rd6xeNDvVG6LE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOaElv_KAxifFJ19V-u7_BtnCLPNeQlm0YSk2nvUcy1Hg&oe=6ACBA70B"}, {"file_name": "Screenshot06.png", "id": "970563445094246", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031450_970563448427579_1896364834470325490_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Cp6plRgb_ngQ7kNvwGsZI9m&_nc_oc=AdrdMhQkMFT75gz5yiv7kkEpeF28Ra5ZIwXbQ9NtMn3nn7PsW02-pLIM6QzJf8HTRDs&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN4bsLoDf_HW853oj2hFhgxOZZZyssKQQC45N8tR8xkZg&oe=6ACB8E52"}, {"file_name": "Screenshot04.png", "id": "575729695062740", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031400_575729698396073_2621336866475747103_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vuz9ZEIpfD4Q7kNvwHWKhZp&_nc_oc=AdqStlACgxf5rMps3dJeNoUHB9FmMfBmHIuQk-n1qF-ox3AQkDMQeSYtL8q7GYKcBQ8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPpUdzetpj8xmMz0aTRInxZZoxNAq4WBtcXCHfkKLytrQ&oe=6ACB955C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Gameplay Trailer Thumb.png", "id": "605202028847932", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974836_605202032181265_2417977283558520499_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GuIBXuXDm4EQ7kNvwGJ05aR&_nc_oc=Adq6RSIyJd62xaAHbqr-2XUZsTf58euFP1Im2TWgf2Hk-l1V37iOMm_-Zs399ItCraQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM9JojFwchINJblzaWYCHZugv-7ezqCJsslGliQD6WOmw&oe=6ACB9D19"}, "display_name": "Squishies - Roll them Home!", "keywords": ["puzzle", "platformer", "sandbox", "exploration", "adventure"], "long_description": "**Get lost in the Squishies-verse!**\n\nSquishies is a head-scratching puzzle platformer where you guide courageous and cute creatures through a series of increasingly hazardous, challenging mazes. Use unique motion controls to push and pull the Squishies through their adventures in a colorful universe full of strange flora and fauna. Keep those little rascals safe while they climb, jump, fly and teleport-by-fish through dozens of levels in five alien worlds!\n\n{507625458961423}\n\nYou push and pull the Squishies from one side of the maze to the other, all while earning medals, gathering crystals, climbing slopes, and avoiding pitfalls.\n\n- **Explore a huge universe** - Across dozens of levels in five different worlds.\n- **Collectibles and Achievements** - Gather all the crystals, beat the clock or find the hidden egg in each level.\n- **Level Editor** - Squishies really comes into its own with its innovative, fully featured creation tools.\n- **Community Section** - Share your creation with others and play their ingenious levels.\n- **Limited play space?** Need to keep an eye on your own little monsters?  You\u2019re in luck. Squishies\u00ae can be played in the newly added Mixed Reality mode!\n\n\n{482757334822594}", "short_description": "Help the stranded Squishies find their way back home! Push and pull them through challenging puzzles, or create your own levels with the powerful in-game editor and share them with the community."}]}, "developer_name": null, "developer_privacy_policy_url": "https://brainseed-factory.com/law/privacy_products/index.php", "developer_terms_of_service_url": "https://brainseed-factory.com/law/terms_products/index.php", "publishe
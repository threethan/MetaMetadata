culuscdn.com/v/t64.5771-25/75322598_1145165853836223_6864148320373849862_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4LIzUb7hXfYQ7kNvwFeFeQ1&_nc_oc=AdrjQDoSbiFlND0hXFI3EL3-h81sh0ebn3bPVtO2lpk97CzAcF_OQ65t2ls07HEGMA0&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQImVn0sw0t2xVD3q6lqHpdeSAmNStJkXJ3AMGpOjbLT3Q&oe=6ABA8583"}, {"file_name": "Screenshot03.png", "id": "598340872572801", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39001670_598340875906134_7078948835759736288_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h293hKyL7zAQ7kNvwFwSyJY&_nc_oc=AdrRmv14KVnRej-yosyn3ew6UF2RFXES_1lEbf9QNwwI7DKhj7QtkrQwjNB8btDgjxU&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIr7gyuAU-S420tUEaAlJlyrj6ecuEDYICR_hv7MLZzKw&oe=6ABA838B"}, {"file_name": "Screenshot06.png", "id": "970563445094246", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031450_970563448427579_1896364834470325490_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F6tdJ848B2AQ7kNvwFl1dJw&_nc_oc=AdpbGpf8P44jFxJaQGxiMvDky8QzephpfzgJne5EzM_5lBUZCdxPhfJ8RkjcSptGN2Q&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIRsU6yPhJdcU2hL7CoO4DNPPfA-mbOwsqpx7J0WwzfPA&oe=6ABA6AD2"}, {"file_name": "Screenshot04.png", "id": "575729695062740", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39031400_575729698396073_2621336866475747103_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Dpu2jmwcvTwQ7kNvwER8y51&_nc_oc=AdpM8zopM-ej1T3Ndy7SK0z-1MxEGKzV9g95cbB0xWVbxGyNkhY4pO8-6Xhiw4iqbc0&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIqvW2FQkPnaDk7w3uGrWjrFKAkrIjU2V6-4bnBYhSKtw&oe=6ABA71DC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Gameplay Trailer Thumb.png", "id": "605202028847932", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974836_605202032181265_2417977283558520499_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K3psQkILMSIQ7kNvwEx-Br4&_nc_oc=Adrnau8N7N_e45EmfykfUBOeUuGIuLjR8K4skJFrL570oYeMlNE3usoKtFu9nmvHwpU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJs79f0JMG3L81foD5q-s-po3Bjp2or-Ju0CvLY1-hJeA&oe=6ABA7999"}, "display_name": "Squishies - Roll them Home!", "keywords": ["puzzle", "platformer", "sandbox", "exploration", "adventure"], "long_description": "**Get lost in the Squishies-verse!**\n\nSquishies is a head-scratching puzzle platformer where you guide courageous and cute creatures through a series of increasingly hazardous, challenging mazes. Use unique motion controls to push and pull the Squishies through their adventures in a colorful universe full of strange flora and fauna. Keep those little rascals safe while they climb, jump, fly and teleport-by-fish through dozens of levels in five alien worlds!\n\n{507625458961423}\n\nYou push and pull the Squishies from one side of the maze to the other, all while earning medals, gathering crystals, climbing slopes, and avoiding pitfalls.\n\n- **Explore a huge universe** - Across dozens of levels in five different worlds.\n- **Collectibles and Achievements** - Gather all the crystals, beat the clock or find the hidden egg in each level.\n- **Level Editor** - Squishies really comes into its own with its innovative, fully featured creation tools.\n- **Community Section** - Share your creation with others and play their ingenious levels.\n- **Limited play space?** Need to keep an eye on your own little monsters?  You\u2019re in luck. Squishies\u00ae can be played in the newly added Mixed Reality mode!\n\n\n{482757334822594}", "short_description": "Help the stranded Squishies find their way back home! Push and pull them through challenging puzzles, or create your own levels with the powerful in-game editor and share them with the community."}]}, "developer_name": null, "developer_privacy_policy_url": "https://brainseed-factory.com/law/privacy_products/index.php", "developer_terms_of_service_url": "https://brainseed-factory.com/law/terms_products/index.php", "publishe
1-7&_nc_sid=6e7a0a&_nc_ohc=Rq0ILM0JubIQ7kNvwHTBtIj&_nc_oc=AdqNvtAVrGEbJLcJID6Q7-mrxhawy4iZ6sfXcBTybvlg8_w3WYS1Rm8JIijthyLQOXI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTjYoHc9_seNZKThsO5oRld7v-gRPODnRBA5XuZQMe6Sg&oe=6B030803"}, {"file_name": "Screenshot03.png", "id": "598340872572801", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39001670_598340875906134_7078948835759736288_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZzP8nrqmSngQ7kNvwFk3POB&_nc_oc=Adp04rEL0-s7DrH10c8ptRL5ejrzub8XfOEyihi4m7it9530Xj3SXe6w1zHwKW0c8I4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQD1ve-tWMYLTmu9Gh_lI5tza1ifjn6HZPiA0d2xcwvGA&oe=6B03060B"}, {"file_name": "Screenshot06.png", "id": "970563445094246", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39031450_970563448427579_1896364834470325490_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qspDrMnNllAQ7kNvwEqVejW&_nc_oc=AdqQ58aKwsJ7KZ9iMKQi1ixjHrrqcpTALbdKX6RoGRqvr8op7p04u8969pJuGmCxI58&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSI6v7thr05MEvC9LIW8RlQeaCkhW0yaT6FfSgmWHz-VQ&oe=6B032592"}, {"file_name": "Screenshot04.png", "id": "575729695062740", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39031400_575729698396073_2621336866475747103_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nT9QC1TgWuUQ7kNvwFBPRly&_nc_oc=AdrwPPPw0Fwobmm60VsFeUQoIKbm-Ire5WCI5epYApUjvPkcBan2NhBMcj8h4MnM8b8&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQKqLYRLIokLkKGRHLdACEpT_Nw7FumNYIRvvqgjcmoQQ&oe=6B032C9C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Gameplay Trailer Thumb.png", "id": "605202028847932", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974836_605202032181265_2417977283558520499_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Cj-JWL2B_HkQ7kNvwGe4AWS&_nc_oc=AdqVyK5dSW9EfQBgtLOtbfZ6npY5DnhcDkfCG2vGOBPYODm0RUbgOi81VBxQ7gQ_eLc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSnemD_c_xjXGlphYwd_A_fGH_qgAwOkqgVZ8yeDmy9aw&oe=6B033459"}, "display_name": "Squishies\u00ae - Roll them Home!", "keywords": ["puzzle", "platformer", "sandbox", "exploration", "adventure"], "long_description": "**Get lost in the Squishies-verse!**\n\nSquishies is a head-scratching puzzle platformer where you guide courageous and cute creatures through a series of increasingly hazardous, challenging mazes. Use unique motion controls to push and pull the Squishies through their adventures in a colorful universe full of strange flora and fauna. Keep those little rascals safe while they climb, jump, fly and teleport-by-fish through dozens of levels in five alien worlds!\n\n{507625458961423}\n\nYou push and pull the Squishies from one side of the maze to the other, all while earning medals, gathering crystals, climbing slopes, and avoiding pitfalls.\n\n- **Explore a huge universe** - Across dozens of levels in five different worlds.\n- **Collectibles and Achievements** - Gather all the crystals, beat the clock or find the hidden egg in each level.\n- **Level Editor** - Squishies really comes into its own with its innovative, fully featured creation tools.\n- **Community Section** - Share your creation with others and play their ingenious levels.\n\n\n{482757334822594}", "short_description": "Help the stranded Squishies find their way back home! Push and pull them through challenging puzzles, or create your own levels with the powerful in-game editor and share them with the community."}]}, "developer_name": null, "developer_privacy_policy_url": "https://brainseed-factory.com/law/privacy_products/index.php", "developer_terms_of_service_url": "https://brainseed-factory.com/law/terms_products/index.php", "publisher_name": "Brainseed Factory", "support_website_url": null, "website_url": "https://www.brainseed-factory.com/", "category": null, "comfort_rating": "COM
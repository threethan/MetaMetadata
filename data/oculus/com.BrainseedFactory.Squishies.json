culuscdn.com/v/t64.5771-25/75322598_1145165853836223_6864148320373849862_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6P_6s5UiZYUQ7kNvwGCAJ03&_nc_oc=AdphWRcrFVU1jY63u8TevaTaWXT-0UC6fYdJUxNxQolZhwPPN9vgJ8RDz5ucRNCZEg8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDoaxBNdK8Fw7XWJVZyN25HOCh_bNyFOGHJVgATRXbR_Q&oe=6A5F55C3"}, {"file_name": "Screenshot03.png", "id": "598340872572801", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39001670_598340875906134_7078948835759736288_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n1gkuVmtAAQQ7kNvwEt5O4q&_nc_oc=AdrrDEJ5ciOsUnGJAagGX4K5LIXigV_cFn5Jscm1Tmy5JqMtKTIEe4PrEtjlPzJoehE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAxdTRauFKSFHj7DctVJS5QOUGdIlUcvLGCbO6pI7uAsQ&oe=6A5F53CB"}, {"file_name": "Screenshot06.png", "id": "970563445094246", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031450_970563448427579_1896364834470325490_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IuYHBJs6CPkQ7kNvwHnJWL0&_nc_oc=AdrUF73TOZPwAdx-sYIOe3wjJ_8zwPr-xxEGpi-E-GG4zEf025AWLRSFN1EorTLqcIU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDSRtaZB37o0zdZ65GIcr_Eyx6wZhMhIrFZTWmZcVJkUA&oe=6A5F7352"}, {"file_name": "Screenshot04.png", "id": "575729695062740", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031400_575729698396073_2621336866475747103_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2cIRCQvznaQQ7kNvwGY3-qP&_nc_oc=AdopzoKURT87mxDtrJTFMurP4_uDd8ZfX1J0pYbMfdADdF1xOuupSh1b3eAitWSQcXE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA10dbSKNyuaNNGvnIOmp6krpdjocBtAEKlzlFuIqFoGw&oe=6A5F7A5C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Gameplay Trailer Thumb.png", "id": "605202028847932", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974836_605202032181265_2417977283558520499_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=keR9OnDQH2cQ7kNvwHLJKIG&_nc_oc=Adpp_EaUJNIBHr6FGqhz-j7enlBb5hMcQNKHODwCrvWrhGI6bwqqh-IhIw4oefu4RTI&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA8EKjtV4PUyi05OIU5HHutqL343lCGMF0nVyrOd6YZTQ&oe=6A5F8219"}, "display_name": "Squishies - Roll them Home!", "keywords": ["puzzle", "platformer", "sandbox", "exploration", "adventure"], "long_description": "**Get lost in the Squishies-verse!**\n\nSquishies is a head-scratching puzzle platformer where you guide courageous and cute creatures through a series of increasingly hazardous, challenging mazes. Use unique motion controls to push and pull the Squishies through their adventures in a colorful universe full of strange flora and fauna. Keep those little rascals safe while they climb, jump, fly and teleport-by-fish through dozens of levels in five alien worlds!\n\n{507625458961423}\n\nYou push and pull the Squishies from one side of the maze to the other, all while earning medals, gathering crystals, climbing slopes, and avoiding pitfalls.\n\n- **Explore a huge universe** - Across dozens of levels in five different worlds.\n- **Collectibles and Achievements** - Gather all the crystals, beat the clock or find the hidden egg in each level.\n- **Level Editor** - Squishies really comes into its own with its innovative, fully featured creation tools.\n- **Community Section** - Share your creation with others and play their ingenious levels.\n- **Limited play space?** Need to keep an eye on your own little monsters?  You\u2019re in luck. Squishies\u00ae can be played in the newly added Mixed Reality mode!\n\n\n{482757334822594}", "short_description": "Help the stranded Squishies find their way back home! Push and pull them through challenging puzzles, or create your own levels with the powerful in-game editor and share them with the community."}]}, "developer_name": null, "developer_privacy_policy_url": "https://brainseed-factory.com/law/privacy_products/index.php", "developer_terms_of_service_url": "https://brainseed-factory.com/law/terms_products/index.php", "publishe
culuscdn.com/v/t64.5771-25/75322598_1145165853836223_6864148320373849862_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-avmiAryG_AQ7kNvwHlcA3H&_nc_oc=Adpoj65witL-sBQHVuVVq4CZXKYDdbIjRQdmeEQq80PKWc34jYwUQ5zghM8xGpnN7ME&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPhuADE5UIZIUmgEpXdCWuSzorT8w7GlAGJN3ffDystuw&oe=6AD0EF03"}, {"file_name": "Screenshot03.png", "id": "598340872572801", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/39001670_598340875906134_7078948835759736288_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5gSi5mFo04UQ7kNvwHIw98C&_nc_oc=AdqekJ6eWD2MJzWnVmVTa2q6Cc4mJb1C7ZIfhNPFs0KzfZe_jhBUiMIki46PDoe1HY0&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOQMT-cVda4D7BaJIy2UwRsHnZGTOWK2rD16KbAEwDKtw&oe=6AD0ED0B"}, {"file_name": "Screenshot06.png", "id": "970563445094246", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/39031450_970563448427579_1896364834470325490_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EwSNvdB_h3wQ7kNvwGZUkhy&_nc_oc=AdqBIdKZZLkHUSEABgKA8mIxK8irjQEZrfpS5lgyoIVBc9ugbDJQ5U-PdPUhD70UJSg&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMydvLmK5zB_eYt4qHqZEqT0c32sX6EgK-yyPjaI4q7XQ&oe=6AD0D452"}, {"file_name": "Screenshot04.png", "id": "575729695062740", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/39031400_575729698396073_2621336866475747103_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rFOC6nRkTawQ7kNvwHsPecF&_nc_oc=AdpmihQD72swis4XfACTu1V9VQqzYgu5gf37j4d6jY3UOrIEXH0g360fmRITxeqVegI&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMYIYLIfFov0NlTZuX_8T_6UwiTZ293xuEto4MOHO-V8A&oe=6AD0DB5C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Gameplay Trailer Thumb.png", "id": "605202028847932", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38974836_605202032181265_2417977283558520499_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WesBX9s8KngQ7kNvwGSZqT6&_nc_oc=Adoa3PAMNHzk_3FlF3xKADVzFI7nqPQkxQrVwm7bzeydu4dmJyQGUAAWwkvV-Fj6Sfs&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOQ5AE-D9tv4gkUdoa9GSCv95gWD_hTvQFT5TvuUOsvrw&oe=6AD0E319"}, "display_name": "Squishies - Roll them Home!", "keywords": ["puzzle", "platformer", "sandbox", "exploration", "adventure"], "long_description": "**Get lost in the Squishies-verse!**\n\nSquishies is a head-scratching puzzle platformer where you guide courageous and cute creatures through a series of increasingly hazardous, challenging mazes. Use unique motion controls to push and pull the Squishies through their adventures in a colorful universe full of strange flora and fauna. Keep those little rascals safe while they climb, jump, fly and teleport-by-fish through dozens of levels in five alien worlds!\n\n{507625458961423}\n\nYou push and pull the Squishies from one side of the maze to the other, all while earning medals, gathering crystals, climbing slopes, and avoiding pitfalls.\n\n- **Explore a huge universe** - Across dozens of levels in five different worlds.\n- **Collectibles and Achievements** - Gather all the crystals, beat the clock or find the hidden egg in each level.\n- **Level Editor** - Squishies really comes into its own with its innovative, fully featured creation tools.\n- **Community Section** - Share your creation with others and play their ingenious levels.\n- **Limited play space?** Need to keep an eye on your own little monsters?  You\u2019re in luck. Squishies\u00ae can be played in the newly added Mixed Reality mode!\n\n\n{482757334822594}", "short_description": "Help the stranded Squishies find their way back home! Push and pull them through challenging puzzles, or create your own levels with the powerful in-game editor and share them with the community."}]}, "developer_name": null, "developer_privacy_policy_url": "https://brainseed-factory.com/law/privacy_products/index.php", "developer_terms_of_service_url": "https://brainseed-factory.com/law/terms_products/index.php", "publishe
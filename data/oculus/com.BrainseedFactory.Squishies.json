culuscdn.com/v/t64.5771-25/75322598_1145165853836223_6864148320373849862_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6mFSjsEPnnkQ7kNvwFPMmDB&_nc_oc=AdqNsxcFG4aCdGZ5_Wx6iOemnKf7dJ1GpFsaBAWOAZax-maJAyDJkjlEcmIc2dS3hIU&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_HOEXcPhzHO-EnUC4SXeat_komV5cG7BnsQa_P07mI8A&oe=6A3AA403"}, {"file_name": "Screenshot03.png", "id": "598340872572801", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39001670_598340875906134_7078948835759736288_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P16UX-GRNDgQ7kNvwEb4TZj&_nc_oc=AdptCPTDEmqhf0Q44MjyMsx3HX_9d-pN2sYErmXU4B9zkIScs0cN-gEQBAw6lcXYa_o&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9LG44iZcoR_cZymYdaWQTNId4qxi-0HMgmzedB2e6LsQ&oe=6A3AA20B"}, {"file_name": "Screenshot06.png", "id": "970563445094246", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031450_970563448427579_1896364834470325490_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GJzC_NezhOgQ7kNvwGkw8mF&_nc_oc=Adro8ik5nR0DOiqnUuBu8QFTRO20bcKU9aiWC1xCLVffet8UZ1QtlUUjpjfPtwaPMhc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8GSqi05ndsgpYRt6LDZqPlnD_nSi7T09Nks2iQcHd3mw&oe=6A3A8952"}, {"file_name": "Screenshot04.png", "id": "575729695062740", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39031400_575729698396073_2621336866475747103_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pqcWRmmbYRsQ7kNvwF4ixbp&_nc_oc=Adr_nx9hBdIrQAGpS949QXIrwSzzSaOxhvrGlrTpynQpm5yC-CerCcaAHQ5s2EQC_WQ&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_pP8cstFuVM_Hfnn0Ola7hJz3y-cmvzB47MXMu-wK88Q&oe=6A3A905C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Gameplay Trailer Thumb.png", "id": "605202028847932", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974836_605202032181265_2417977283558520499_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hyx6-ahTjaEQ7kNvwFN9Cgk&_nc_oc=AdrKudCPt_EBQGq37YdtZfPypdPLW_AJg7HbzjO8mpNrffhtaO6WQCMVg8zNSCPiqGk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_dfslon-7cHOz0qjCIALXyB2kqrFf6ch4v94uFZ5O9Zw&oe=6A3A9819"}, "display_name": "Squishies - Roll them Home!", "keywords": ["puzzle", "platformer", "sandbox", "exploration", "adventure"], "long_description": "**Get lost in the Squishies-verse!**\n\nSquishies is a head-scratching puzzle platformer where you guide courageous and cute creatures through a series of increasingly hazardous, challenging mazes. Use unique motion controls to push and pull the Squishies through their adventures in a colorful universe full of strange flora and fauna. Keep those little rascals safe while they climb, jump, fly and teleport-by-fish through dozens of levels in five alien worlds!\n\n{507625458961423}\n\nYou push and pull the Squishies from one side of the maze to the other, all while earning medals, gathering crystals, climbing slopes, and avoiding pitfalls.\n\n- **Explore a huge universe** - Across dozens of levels in five different worlds.\n- **Collectibles and Achievements** - Gather all the crystals, beat the clock or find the hidden egg in each level.\n- **Level Editor** - Squishies really comes into its own with its innovative, fully featured creation tools.\n- **Community Section** - Share your creation with others and play their ingenious levels.\n- **Limited play space?** Need to keep an eye on your own little monsters?  You\u2019re in luck. Squishies\u00ae can be played in the newly added Mixed Reality mode!\n\n\n{482757334822594}", "short_description": "Help the stranded Squishies find their way back home! Push and pull them through challenging puzzles, or create your own levels with the powerful in-game editor and share them with the community."}]}, "developer_name": null, "developer_privacy_policy_url": "https://brainseed-factory.com/law/privacy_products/index.php", "developer_terms_of_service_url": "https://brainseed-factory.com/law/terms_products/index.php", "publishe
culuscdn.com/v/t64.5771-25/75322598_1145165853836223_6864148320373849862_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vdWsBKBtrGsQ7kNvwFkRYXY&_nc_oc=Adr1iD-ylDrCfpnq-Q9WChxsI-9CdZl1FLP9duZjL_M-7Gu4hbO2rMtabKIrRzQZDlo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBL5AnoZ1cT5AjyrBp6Wv6Jbiha79Fsu3_rBOaCqvh-bg&oe=6A638283"}, {"file_name": "Screenshot03.png", "id": "598340872572801", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39001670_598340875906134_7078948835759736288_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7jW925hcEqsQ7kNvwFK_syq&_nc_oc=AdqyzpZECxLskuZfRZ0XIjxnxAJXPbK_M_gT7sc_aBAkMapCGgcLo11L1jM4ZhxmKOQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCMllN6wzE1akawRQa7NP8B25b7X9drIaP0gRNK5doeyw&oe=6A63808B"}, {"file_name": "Screenshot06.png", "id": "970563445094246", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031450_970563448427579_1896364834470325490_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e1jKndgo4cgQ7kNvwEssUdK&_nc_oc=AdpXZjm4M9n3Z7mZ1lDGbIexZZc_udr4UnNEtrzlQE1kDenIAHEIg2-x1bW7fKfg73M&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDODw0PTQJzZJ7gyX7cPceZE0avlyk0DIJ0SDDENa8PNQ&oe=6A6367D2"}, {"file_name": "Screenshot04.png", "id": "575729695062740", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031400_575729698396073_2621336866475747103_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dlJxBgKCmIoQ7kNvwHUzCMi&_nc_oc=AdqIr8O4tfmwV0rBymw2yxnC0p1SJPn5y7ytitp1EvXQifedf-U3p4rfqnP7dIm_Dow&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBqib24Qoi0GlR1h68ugHoIheH6-bSmsUZqNEbkzi9wJQ&oe=6A636EDC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Gameplay Trailer Thumb.png", "id": "605202028847932", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974836_605202032181265_2417977283558520499_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ez74g_MvWv0Q7kNvwH79Voh&_nc_oc=AdpPPZVKIgM12HBWGdT4CLN-TvoRHQqwN8wh1t63SotuSqqmAvOeTc-O_mO3zon02Vw&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC61RGQZRGebmIsw8_iAbWC4sPNv7WF6OWATd0Wu_Odtg&oe=6A637699"}, "display_name": "Squishies - Roll them Home!", "keywords": ["puzzle", "platformer", "sandbox", "exploration", "adventure"], "long_description": "**Get lost in the Squishies-verse!**\n\nSquishies is a head-scratching puzzle platformer where you guide courageous and cute creatures through a series of increasingly hazardous, challenging mazes. Use unique motion controls to push and pull the Squishies through their adventures in a colorful universe full of strange flora and fauna. Keep those little rascals safe while they climb, jump, fly and teleport-by-fish through dozens of levels in five alien worlds!\n\n{507625458961423}\n\nYou push and pull the Squishies from one side of the maze to the other, all while earning medals, gathering crystals, climbing slopes, and avoiding pitfalls.\n\n- **Explore a huge universe** - Across dozens of levels in five different worlds.\n- **Collectibles and Achievements** - Gather all the crystals, beat the clock or find the hidden egg in each level.\n- **Level Editor** - Squishies really comes into its own with its innovative, fully featured creation tools.\n- **Community Section** - Share your creation with others and play their ingenious levels.\n- **Limited play space?** Need to keep an eye on your own little monsters?  You\u2019re in luck. Squishies\u00ae can be played in the newly added Mixed Reality mode!\n\n\n{482757334822594}", "short_description": "Help the stranded Squishies find their way back home! Push and pull them through challenging puzzles, or create your own levels with the powerful in-game editor and share them with the community."}]}, "developer_name": null, "developer_privacy_policy_url": "https://brainseed-factory.com/law/privacy_products/index.php", "developer_terms_of_service_url": "https://brainseed-factory.com/law/terms_products/index.php", "publishe
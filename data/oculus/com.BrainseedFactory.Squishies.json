culuscdn.com/v/t64.5771-25/75322598_1145165853836223_6864148320373849862_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zXrmewv-TM8Q7kNvwGWbMJR&_nc_oc=AdqZ9rVvWCyILalHUrQTiX-h5lhdMiR8mXpbwNVAwb87TwCQTxyHtsV5eNojM8K4QRc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEfbNDC0Rx5XkVXSkNe_lXZeJtfvcQ45OqPuIgnqqWgEw&oe=6A7B3D83"}, {"file_name": "Screenshot03.png", "id": "598340872572801", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39001670_598340875906134_7078948835759736288_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LpEI4iRCjeoQ7kNvwHA1qby&_nc_oc=AdpdeH2TDySPNylaOjgRHKkUCBTCWTLiyn1Y7KBicNkDrC05jP2rxqhC-XDXBiqGzQU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHxxI7c3zpCsrPUtjS1GWikydktuKSmMxpCLYd7f4-SuA&oe=6A7B3B8B"}, {"file_name": "Screenshot06.png", "id": "970563445094246", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031450_970563448427579_1896364834470325490_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CFYmsUJce9wQ7kNvwESD60l&_nc_oc=Adoozk64SrVhe4jZzNtKkNGmAatihcvOaa1-giDzEdxAO06MUzwDXXIOsb6gurOsRdk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFcTPvPnOrqGPzk4uOkc84EDlgxTgG7_17jVYDXrv72DQ&oe=6A7B22D2"}, {"file_name": "Screenshot04.png", "id": "575729695062740", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031400_575729698396073_2621336866475747103_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Efr1llHfE8wQ7kNvwFs3j4j&_nc_oc=AdpomMZD6_npLaC8gMl_FVrvL-fpwFsFKfD1o2LBI1d0-ywE8JrbByIhEgaBoBQtHV8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEgwui0hbBgmziAL3M7XktcFpYOXXfTrmgcjYBFEDRIYA&oe=6A7B29DC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Gameplay Trailer Thumb.png", "id": "605202028847932", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974836_605202032181265_2417977283558520499_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I_wFZ3tZBNcQ7kNvwHM-7Sv&_nc_oc=Adruy49ZJMMR9l2ZY-v5EHvyV0zUTtl7uWuxYunjYlQo6Na-K7qiW6IVbpTOBjWegqs&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHG-r_typQQ55yexFBHt77eMj_siovdg-ziFBKPUztkYw&oe=6A7B3199"}, "display_name": "Squishies - Roll them Home!", "keywords": ["puzzle", "platformer", "sandbox", "exploration", "adventure"], "long_description": "**Get lost in the Squishies-verse!**\n\nSquishies is a head-scratching puzzle platformer where you guide courageous and cute creatures through a series of increasingly hazardous, challenging mazes. Use unique motion controls to push and pull the Squishies through their adventures in a colorful universe full of strange flora and fauna. Keep those little rascals safe while they climb, jump, fly and teleport-by-fish through dozens of levels in five alien worlds!\n\n{507625458961423}\n\nYou push and pull the Squishies from one side of the maze to the other, all while earning medals, gathering crystals, climbing slopes, and avoiding pitfalls.\n\n- **Explore a huge universe** - Across dozens of levels in five different worlds.\n- **Collectibles and Achievements** - Gather all the crystals, beat the clock or find the hidden egg in each level.\n- **Level Editor** - Squishies really comes into its own with its innovative, fully featured creation tools.\n- **Community Section** - Share your creation with others and play their ingenious levels.\n- **Limited play space?** Need to keep an eye on your own little monsters?  You\u2019re in luck. Squishies\u00ae can be played in the newly added Mixed Reality mode!\n\n\n{482757334822594}", "short_description": "Help the stranded Squishies find their way back home! Push and pull them through challenging puzzles, or create your own levels with the powerful in-game editor and share them with the community."}]}, "developer_name": null, "developer_privacy_policy_url": "https://brainseed-factory.com/law/privacy_products/index.php", "developer_terms_of_service_url": "https://brainseed-factory.com/law/terms_products/index.php", "publishe
culuscdn.com/v/t64.5771-25/75322598_1145165853836223_6864148320373849862_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nqHckvv-A7UQ7kNvwGxYmi9&_nc_oc=AdqAnIHKkDd_EdeCMmei95nNahvmsqgRQu_s0BRY5HZSMNtDNfblnWXI0YIJ15HVNO4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_oGy-AeOgH3enI_mhaJjQiKTgnVoq2xh_EoxytTDefoQ&oe=6A47D303"}, {"file_name": "Screenshot03.png", "id": "598340872572801", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39001670_598340875906134_7078948835759736288_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k-QHkWOxiXcQ7kNvwH8E6-i&_nc_oc=Adp7X1bu5lAGDiCjSAB7oOgmFm-M6ax-kz2rMzqhusoiu8YcQLHC8RMjGX5eHmU3tsw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_P0zTYSriP9gJhV_97yEm9YKu-ZDSITCje_233SbifJg&oe=6A47D10B"}, {"file_name": "Screenshot06.png", "id": "970563445094246", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031450_970563448427579_1896364834470325490_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6pZpC1BLF_IQ7kNvwEoq3tE&_nc_oc=AdqeCfd-zKFT7hn3UT-zyskTJHy6KBJHFlRYVn88EIbFskGfcD2jVS0lvLLM1wGExQo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9lkyOoqKXNQjT8EeElWtk_3MErpPS5obB8aVUxjGn4eQ&oe=6A47B852"}, {"file_name": "Screenshot04.png", "id": "575729695062740", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031400_575729698396073_2621336866475747103_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s28mqfZySrIQ7kNvwEMfO-6&_nc_oc=AdqPW88h6pfhjbQBJfD8vXcFG6ZQLVocKxbmxhibFPV-C_1q7dvIII7Dz7d4CtEndYU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9vzV1IMohse7I1S06lEAqLImnadF8b5T3R4eLd84T9mQ&oe=6A47BF5C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Gameplay Trailer Thumb.png", "id": "605202028847932", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974836_605202032181265_2417977283558520499_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A-0NJzbO6fcQ7kNvwEG7wJ7&_nc_oc=AdocR2OMCOSY7MzCRoUFTbHm0iTPfj3OvCWT24jvPT4DzRNF3HZug6qbny8MtDpHxqU&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_2Ad0enigIZBbJLqKSYGYKkWrYkWNF2aoL6vS5ygqG-Q&oe=6A47C719"}, "display_name": "Squishies - Roll them Home!", "keywords": ["puzzle", "platformer", "sandbox", "exploration", "adventure"], "long_description": "**Get lost in the Squishies-verse!**\n\nSquishies is a head-scratching puzzle platformer where you guide courageous and cute creatures through a series of increasingly hazardous, challenging mazes. Use unique motion controls to push and pull the Squishies through their adventures in a colorful universe full of strange flora and fauna. Keep those little rascals safe while they climb, jump, fly and teleport-by-fish through dozens of levels in five alien worlds!\n\n{507625458961423}\n\nYou push and pull the Squishies from one side of the maze to the other, all while earning medals, gathering crystals, climbing slopes, and avoiding pitfalls.\n\n- **Explore a huge universe** - Across dozens of levels in five different worlds.\n- **Collectibles and Achievements** - Gather all the crystals, beat the clock or find the hidden egg in each level.\n- **Level Editor** - Squishies really comes into its own with its innovative, fully featured creation tools.\n- **Community Section** - Share your creation with others and play their ingenious levels.\n- **Limited play space?** Need to keep an eye on your own little monsters?  You\u2019re in luck. Squishies\u00ae can be played in the newly added Mixed Reality mode!\n\n\n{482757334822594}", "short_description": "Help the stranded Squishies find their way back home! Push and pull them through challenging puzzles, or create your own levels with the powerful in-game editor and share them with the community."}]}, "developer_name": null, "developer_privacy_policy_url": "https://brainseed-factory.com/law/privacy_products/index.php", "developer_terms_of_service_url": "https://brainseed-factory.com/law/terms_products/index.php", "publishe
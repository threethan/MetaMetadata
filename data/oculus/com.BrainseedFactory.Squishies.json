uluscdn.com/v/t64.5771-25/75322598_1145165853836223_6864148320373849862_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i3ISmKWmo7UQ7kNvwEr3nJN&_nc_oc=AdoMrks9gHhpfP370n-jcQipy3NJRwrwM7Ro8XEpNVV9k2bRkp1zqU7mEWCLusthSxY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-pk71Y1XHgkYaEmO4KS1F-g7SPAiw8b-3U8_jrrbWlgQ&oe=6A2EC683"}, {"file_name": "Screenshot03.png", "id": "598340872572801", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39001670_598340875906134_7078948835759736288_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LSrNZIrbSZYQ7kNvwFhyZgg&_nc_oc=Adq4_H6-y8naQTzO4N2rmQiv6LEKq8T8qwgcEeyu3usd7jr6LTplu3JQ752STK4GWhI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8WGiSismpkLJfRD4fAjQ097xEiTZ2c41X0v7zFK1xUSA&oe=6A2EC48B"}, {"file_name": "Screenshot06.png", "id": "970563445094246", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031450_970563448427579_1896364834470325490_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yvjip12CsakQ7kNvwHKJ5bB&_nc_oc=AdorDQ1U9YdPkYx-3CmuwyNRR6b02OGYu51YMIGtAlBFzXsdWDkY1g59LEY6Y-qxiU4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af887Gg2n0EZYdQ9S0Fdaj8wOrQdbs9ILFwlCNtwlpQb9Q&oe=6A2EABD2"}, {"file_name": "Screenshot04.png", "id": "575729695062740", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031400_575729698396073_2621336866475747103_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uzg9HDSCSXMQ7kNvwEY9f8J&_nc_oc=AdpGH6W6-e3HYrqHYHHvVdMk7JJ8AhkF5uNLelPpY90cvRaMZJBzierBX82HbNLFo-U&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9KyBqB2w8gqQR_NYYomD8lk0horWi8LZnCg3BWXg5SMQ&oe=6A2EB2DC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Gameplay Trailer Thumb.png", "id": "605202028847932", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974836_605202032181265_2417977283558520499_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ahpJleBcgyUQ7kNvwHg3F8g&_nc_oc=AdobUYm1PptFoshF0EmZMboW2zu9_cMT1zJJrS34mLeeX97PpM8QIhJzhZHW11CoH9c&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af86FPCFaz9GlRbT9rsrAAEL_Lno-HyFGRDWOfdVojzX5w&oe=6A2EBA99"}, "display_name": "Squishies - Roll them Home!", "keywords": ["puzzle", "platformer", "sandbox", "exploration", "adventure"], "long_description": "**Get lost in the Squishies-verse!**\n\nSquishies is a head-scratching puzzle platformer where you guide courageous and cute creatures through a series of increasingly hazardous, challenging mazes. Use unique motion controls to push and pull the Squishies through their adventures in a colorful universe full of strange flora and fauna. Keep those little rascals safe while they climb, jump, fly and teleport-by-fish through dozens of levels in five alien worlds!\n\n{507625458961423}\n\nYou push and pull the Squishies from one side of the maze to the other, all while earning medals, gathering crystals, climbing slopes, and avoiding pitfalls.\n\n- **Explore a huge universe** - Across dozens of levels in five different worlds.\n- **Collectibles and Achievements** - Gather all the crystals, beat the clock or find the hidden egg in each level.\n- **Level Editor** - Squishies really comes into its own with its innovative, fully featured creation tools.\n- **Community Section** - Share your creation with others and play their ingenious levels.\n- **Limited play space?** Need to keep an eye on your own little monsters?  You\u2019re in luck. Squishies\u00ae can be played in the newly added Mixed Reality mode!\n\n\n{482757334822594}", "short_description": "Help the stranded Squishies find their way back home! Push and pull them through challenging puzzles, or create your own levels with the powerful in-game editor and share them with the community."}]}, "developer_name": null, "developer_privacy_policy_url": "https://brainseed-factory.com/law/privacy_products/index.php", "developer_terms_of_service_url": "https://brainseed-factory.com/law/terms_products/index.php", "publisher
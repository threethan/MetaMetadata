culuscdn.com/v/t64.5771-25/75322598_1145165853836223_6864148320373849862_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qsyhv_cMfo4Q7kNvwFbGY9y&_nc_oc=AdoQflahUlpdmwy18EPg4XlGW8yK397msj0G0xR0U1mF4TvTAZcvXNTe-9QxBDX8VTI&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGniOE1yvl1J2zP3gRHK3WfYw7hVE-YSZQoY6ilUMjk0w&oe=6A8AD743"}, {"file_name": "Screenshot03.png", "id": "598340872572801", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39001670_598340875906134_7078948835759736288_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SrS0aH425XQQ7kNvwELCDpg&_nc_oc=AdqiU7cwKJN59264s5WvZOzC2usO3p0HkQsfIgv5UFQlu1Fq4Jv2IFBOK8-FMyUB_5A&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHU3SgVVDx8X6MZN7pQFIQXDYX4T7eAtwh6aKiIW40jLw&oe=6A8AD54B"}, {"file_name": "Screenshot06.png", "id": "970563445094246", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/39031450_970563448427579_1896364834470325490_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z47bM7gbL3oQ7kNvwFkHyQM&_nc_oc=AdoGs6ZBPJlNthJse9ezMxgGpNnPzqQXcbNu5VZYBGq5Si1w5YyeOK5KuQ91diqK8do&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQER88s-sc43Npb4s44Q2SkvTJPsv3KtPmeueqkMQ_t3jg&oe=6A8AF4D2"}, {"file_name": "Screenshot04.png", "id": "575729695062740", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39031400_575729698396073_2621336866475747103_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5K3wm761ljcQ7kNvwGTSFp-&_nc_oc=Adon0LfqK2IneH0gbIAzFg2lzbRlmdCBkpv8OumlLo-g-a28vvwMBlCLU4Q5xamgg3g&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH0l4am3iwTyqxRA0KjFxZO4DnjaytAP529GVtT9OzrLA&oe=6A8AC39C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Gameplay Trailer Thumb.png", "id": "605202028847932", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/38974836_605202032181265_2417977283558520499_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TGKccyzxmdQQ7kNvwE3zoSP&_nc_oc=Adon2y9oFm7fz_P71qQqMVYHOGkTGQohFdcFY_TgoS-zDXIJ1ZLVZ7d_4iwrXUNrduM&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFWeE0M9A1-mvfqR7RXjNbVORCguKPDbzHlwBvDNpUx4Q&oe=6A8ACB59"}, "display_name": "Squishies - Roll them Home!", "keywords": ["puzzle", "platformer", "sandbox", "exploration", "adventure"], "long_description": "**Get lost in the Squishies-verse!**\n\nSquishies is a head-scratching puzzle platformer where you guide courageous and cute creatures through a series of increasingly hazardous, challenging mazes. Use unique motion controls to push and pull the Squishies through their adventures in a colorful universe full of strange flora and fauna. Keep those little rascals safe while they climb, jump, fly and teleport-by-fish through dozens of levels in five alien worlds!\n\n{507625458961423}\n\nYou push and pull the Squishies from one side of the maze to the other, all while earning medals, gathering crystals, climbing slopes, and avoiding pitfalls.\n\n- **Explore a huge universe** - Across dozens of levels in five different worlds.\n- **Collectibles and Achievements** - Gather all the crystals, beat the clock or find the hidden egg in each level.\n- **Level Editor** - Squishies really comes into its own with its innovative, fully featured creation tools.\n- **Community Section** - Share your creation with others and play their ingenious levels.\n- **Limited play space?** Need to keep an eye on your own little monsters?  You\u2019re in luck. Squishies\u00ae can be played in the newly added Mixed Reality mode!\n\n\n{482757334822594}", "short_description": "Help the stranded Squishies find their way back home! Push and pull them through challenging puzzles, or create your own levels with the powerful in-game editor and share them with the community."}]}, "developer_name": null, "developer_privacy_policy_url": "https://brainseed-factory.com/law/privacy_products/index.php", "developer_terms_of_service_url": "https://brainseed-factory.com/law/terms_products/index.php", "publishe
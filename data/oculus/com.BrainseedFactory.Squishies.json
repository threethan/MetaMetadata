6864148320373849862_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=olOILlTwBGYQ7kNvwE2IT8y&_nc_oc=AdqlVkYM7znJ1QzdkqovAqApsMXXVOfjKxJ0NkgYU3wlrXuo0slzRZazCX_y3r2G3_0&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0hVFFkCIh-khsTpzNf7AEKTVzzXUlJkauKd_3NZAH6KQ&oe=69F1E943"}, {"file_name": "Screenshot03.png", "id": "598340872572801", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39001670_598340875906134_7078948835759736288_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Bxwwd7bFIp0Q7kNvwE6OV9G&_nc_oc=AdpYXUwqpDuT1UBfQewXgNzMH_fFGZKmf-16Vo52TRLQEQhIOx8lXgJKX_JcKGah5Xc&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&oh=00_Af3yN40B9k02CESlttiGcpYO5HtBHYb6namm9Iuv00ju6w&oe=69F1E74B"}, {"file_name": "Screenshot06.png", "id": "970563445094246", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39031450_970563448427579_1896364834470325490_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_LYEJUxpWA8Q7kNvwGQ-fD8&_nc_oc=AdpCpaY8UJRVYxDRZg6AuLs2ZtR0MJAQHPnNrJSRz7QQ3E_0PA4A4U1ctGiAngnaCq4&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_Af3OvQZsOBSNJ2FsJCv1VnkoS5wdivmmWXASPrp4ZD1-IA&oe=69F206D2"}, {"file_name": "Screenshot04.png", "id": "575729695062740", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39031400_575729698396073_2621336866475747103_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3F5OPfBPMCQQ7kNvwFUDXbs&_nc_oc=AdrDGsMW0h1d49OzTKf3ngVNFa_UFmqEDdDV2rBnM3PZ1Y4Wl6P-aH6t58ZYTlY7kI8&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0pbCq5HP5v5nXpjdn3Zh_cKogWQjoiVhnkir5-MCjzSA&oe=69F20DDC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Gameplay Trailer Thumb.png", "id": "605202028847932", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974836_605202032181265_2417977283558520499_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QaZsw6jFjq8Q7kNvwHflAoj&_nc_oc=Adph7xnc73N-i4tXvBBGgL1pNwfWg2mQ4WE2JW4cE43D_y2WYGdiS0qGBit6u76CUbY&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1OTYSZCjKDH5Mn3gXRv-cKDLJnP7DNS5lQui5pKLEn7A&oe=69F21599"}, "display_name": "Squishies - Roll them Home!", "keywords": ["puzzle", "platformer", "sandbox", "exploration", "adventure"], "long_description": "**Get lost in the Squishies-verse!**\n\nSquishies is a head-scratching puzzle platformer where you guide courageous and cute creatures through a series of increasingly hazardous, challenging mazes. Use unique motion controls to push and pull the Squishies through their adventures in a colorful universe full of strange flora and fauna. Keep those little rascals safe while they climb, jump, fly and teleport-by-fish through dozens of levels in five alien worlds!\n\n{507625458961423}\n\nYou push and pull the Squishies from one side of the maze to the other, all while earning medals, gathering crystals, climbing slopes, and avoiding pitfalls.\n\n- **Explore a huge universe** - Across dozens of levels in five different worlds.\n- **Collectibles and Achievements** - Gather all the crystals, beat the clock or find the hidden egg in each level.\n- **Level Editor** - Squishies really comes into its own with its innovative, fully featured creation tools.\n- **Community Section** - Share your creation with others and play their ingenious levels.\n- **Limited play space?** Need to keep an eye on your own little monsters?  You\u2019re in luck. Squishies\u00ae can be played in the newly added Mixed Reality mode!\n\n\n{482757334822594}", "short_description": "Help the stranded Squishies find their way back home! Push and pull them through challenging puzzles, or create your own levels with the powerful in-game editor and share them with the community."}]}, "developer_name": null, "developer_privacy_policy_url": "https://brainseed-factory.com/law/privacy_products/index.php", "developer_terms_of_service_url": "https://brainseed-factory.com/law/terms_products/index.php", "publisher_name": "Perp Games", "support_website_url": null, "website_url": "https://perpgames.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "528142316460358"}, {"id": "377978390272490"}, {"id": "1990104051447093"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["PUZZLE", "CASUAL", "ART_CREATIVITY"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "de", "fr", "es", "it", "zh_CN", "zh_HK", "ja", "ru", "pt", "pt_BR"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9928604680595706"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/75203616_415291514908488_9021247408540981650_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=44VXs4BS9hUQ7kNvwFqH-IW&_nc_oc=AdrwtSYScMduYGn5pTD5eVEEEojW83lsudxU7rRDizLIHHLDSE9hoSQUBRv6PphYPsw&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_Af2K4a6CdzCCftOelT7natt92muNnI4e7vXHoDCC9kAwJQ&oe=69F21B06"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Squishies - Roll them Home!", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Platformer", "id": "528142316460358"}, {"topic_name": "Puzzle", "id": "377978390272490"}, {"topic_name": "Sandbox", "id": "1990104051447093"}], "release_date": 1734840540, "lastRevision": {"nodes": [{"id": "7946349162154611", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "7946349125487948", "is_first_party": false, "enables_in_app_ads"
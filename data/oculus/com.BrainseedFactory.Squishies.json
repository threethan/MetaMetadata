145165853836223_6864148320373849862_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EzFK5hHRzbAQ7kNvwGexRp-&_nc_oc=AdkKWDbj3QYgxI9cLRG16yCkzRRcHOmRK4iTLfzUujzKRDkjV1f2mgGyDzIDVMIvQmg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfwzN2nDWqmHyWDSMbSl7CCAFt1u1wZdJamCswhZATsNoQ&oe=69BBDBC3"}, {"file_name": "Screenshot03.png", "id": "598340872572801", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39001670_598340875906134_7078948835759736288_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RUaneXD-c5UQ7kNvwHoGJ3p&_nc_oc=Adn4ivUbM40Z3GEg6lI8XnqCnXdUbPYo6KNoGC_KXQPpQERwtf4WvuapcE2R_yztgKE&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afxw_YqvqJBAh64Q2fplmpuq8UxzV6uAqdu6hkjBoQtv-A&oe=69BC120B"}, {"file_name": "Screenshot06.png", "id": "970563445094246", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031450_970563448427579_1896364834470325490_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RGJZGRF-Pj8Q7kNvwGUxKGP&_nc_oc=AdkMipzKGwJmz4vVo5Ikea7ilF3EMuRaH5r2MgTW2BWbYHJJgcuFPsahWqT-1PYT-7E&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfzEF89M3Yui72jOHQjRaKPHpIqlGCG7p9cOIDE6J0KT5Q&oe=69BBF952"}, {"file_name": "Screenshot04.png", "id": "575729695062740", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031400_575729698396073_2621336866475747103_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4xkD1J3zVfwQ7kNvwHs140l&_nc_oc=Adnn5whfgrN9UgWdc1c5AkndzzrDcI0S_477A0iYM-xA7XH7KLK9-A_dFlo-FSzPYCw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfwTjNBj-U8_Baja6Z6UdQANDLdNQ_KSsrMP5PrYlgA54g&oe=69BC005C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Gameplay Trailer Thumb.png", "id": "605202028847932", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974836_605202032181265_2417977283558520499_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WYUhgUOVdGUQ7kNvwF8N2qy&_nc_oc=AdmzWkzpxDAqI_mOEx1JukJasnYwA3EqBovy5ccFUQSamNhexR0ckYD0bEUN5FgTo9g&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfzZw0jXx4OYWl-EJ1y29msHxF0_ofC4N9KOV2vFO3fYMA&oe=69BC0819"}, "display_name": "Squishies - Roll them Home!", "keywords": ["puzzle", "platformer", "sandbox", "exploration", "adventure"], "long_description": "**Get lost in the Squishies-verse!**\n\nSquishies is a head-scratching puzzle platformer where you guide courageous and cute creatures through a series of increasingly hazardous, challenging mazes. Use unique motion controls to push and pull the Squishies through their adventures in a colorful universe full of strange flora and fauna. Keep those little rascals safe while they climb, jump, fly and teleport-by-fish through dozens of levels in five alien worlds!\n\n{507625458961423}\n\nYou push and pull the Squishies from one side of the maze to the other, all while earning medals, gathering crystals, climbing slopes, and avoiding pitfalls.\n\n- **Explore a huge universe** - Across dozens of levels in five different worlds.\n- **Collectibles and Achievements** - Gather all the crystals, beat the clock or find the hidden egg in each level.\n- **Level Editor** - Squishies really comes into its own with its innovative, fully featured creation tools.\n- **Community Section** - Share your creation with others and play their ingenious levels.\n- **Limited play space?** Need to keep an eye on your own little monsters?  You\u2019re in luck. Squishies\u00ae can be played in the newly added Mixed Reality mode!\n\n\n{482757334822594}", "short_description": "Help the stranded Squishies find their way back home! Push and pull them through challenging puzzles, or create your own levels with the powerful in-game editor and share them with the community."}]}, "developer_name": null, "developer_privacy_policy_url": "https://brainseed-factory.com/law/privacy_products/index.php", "developer_terms_of_service_url": "https://brainseed-factory.com/law/terms_products/index.php", "publisher_name": "Perp Games", "support_website_url": null, "webs
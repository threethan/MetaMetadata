culuscdn.com/v/t64.5771-25/75322598_1145165853836223_6864148320373849862_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r4jdcIXyxJEQ7kNvwGPheI0&_nc_oc=AdpjqDaCYKftMiO3JSD8-fFKYpfdXcxISh4N0ZjYDn8NGIh_i-T4M48uuu2ZwoRNnFc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQConcLHHCNTMaYnskFsH_dKaNO814tTQVkrHDO4KJa2Fg&oe=6A510D83"}, {"file_name": "Screenshot03.png", "id": "598340872572801", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39001670_598340875906134_7078948835759736288_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Em1aOzU_QlkQ7kNvwFKGOLS&_nc_oc=Adq5gh6dKzKccNSKWPuOleYJHUpRX6CzOcYPJiDfdF3LsRHQdF9lHKvLbxM_-5LNWTs&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD6exfCiGl7uUMsL9p7SB0ioRG7gI-1k-J_WIpcUEMAqw&oe=6A510B8B"}, {"file_name": "Screenshot06.png", "id": "970563445094246", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031450_970563448427579_1896364834470325490_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nI5-C9xq1T0Q7kNvwHzjUtq&_nc_oc=AdqQrPLv6Uvj6bUKxeOPPJXnKx_yaDPEnfLL1vZ2FBC_huW767Cfem8ECFePkEc-nX8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA1cCnb_EUUe91DVTsmWKXAL62A6eYMhmtrwNR1MtfrnQ&oe=6A50F2D2"}, {"file_name": "Screenshot04.png", "id": "575729695062740", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031400_575729698396073_2621336866475747103_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Eabllj5nbbwQ7kNvwFDVBAc&_nc_oc=AdpGp5xEELybiRJRwjNE0ax2-TGQtmi6pOPGWREFBKJxOcLk2q_hMDdtQmYrGa-mpYg&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBdhseDgJbQtf7cy-jbBbgfeInC2qYBXXDkz95HiBokFQ&oe=6A50F9DC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Gameplay Trailer Thumb.png", "id": "605202028847932", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974836_605202032181265_2417977283558520499_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZpxMPMS9VTMQ7kNvwGCsAew&_nc_oc=AdoYjZnbwxK2mU77Dh7Eoz50J-NwIrB7HAnXE7b0UIzQJSSLKBlrXQ2BYsALpTmCdww&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA672pY7crZBHGca_JsM5KQlTXUq-ezV90g7grXwuwZAg&oe=6A510199"}, "display_name": "Squishies - Roll them Home!", "keywords": ["puzzle", "platformer", "sandbox", "exploration", "adventure"], "long_description": "**Get lost in the Squishies-verse!**\n\nSquishies is a head-scratching puzzle platformer where you guide courageous and cute creatures through a series of increasingly hazardous, challenging mazes. Use unique motion controls to push and pull the Squishies through their adventures in a colorful universe full of strange flora and fauna. Keep those little rascals safe while they climb, jump, fly and teleport-by-fish through dozens of levels in five alien worlds!\n\n{507625458961423}\n\nYou push and pull the Squishies from one side of the maze to the other, all while earning medals, gathering crystals, climbing slopes, and avoiding pitfalls.\n\n- **Explore a huge universe** - Across dozens of levels in five different worlds.\n- **Collectibles and Achievements** - Gather all the crystals, beat the clock or find the hidden egg in each level.\n- **Level Editor** - Squishies really comes into its own with its innovative, fully featured creation tools.\n- **Community Section** - Share your creation with others and play their ingenious levels.\n- **Limited play space?** Need to keep an eye on your own little monsters?  You\u2019re in luck. Squishies\u00ae can be played in the newly added Mixed Reality mode!\n\n\n{482757334822594}", "short_description": "Help the stranded Squishies find their way back home! Push and pull them through challenging puzzles, or create your own levels with the powerful in-game editor and share them with the community."}]}, "developer_name": null, "developer_privacy_policy_url": "https://brainseed-factory.com/law/privacy_products/index.php", "developer_terms_of_service_url": "https://brainseed-factory.com/law/terms_products/index.php", "publishe
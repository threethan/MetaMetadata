sin2-2.oculuscdn.com/v/t64.5771-25/75322598_1145165853836223_6864148320373849862_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vy3PMFwOXxAQ7kNvwHE__P3&_nc_oc=Adqurs7X9NErRUtKN17gd0mvbQ7p8XT8vqeQyRngQS4UmJsfecjcNAe31bSBv0YXnhs&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLGK85p92GFZIYjWTvhREcPv0zzuqh9dhxfHuHUT7ZIlw&oe=6AA41C03"}, {"file_name": "Screenshot03.png", "id": "598340872572801", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/39001670_598340875906134_7078948835759736288_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Nd78cNXGNHAQ7kNvwHqMhzQ&_nc_oc=AdqakxzDHDryRX3oOIqPhbyIlz-lWql0fgJyeGLOuMwX0DEj_GBlN4i4ahMoI6N0Ylo&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKD1k3yzHtwAU2H9d93e5VmZ9ODnSfAbgkLhKsFLjOpBw&oe=6AA41A0B"}, {"file_name": "Screenshot06.png", "id": "970563445094246", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/39031450_970563448427579_1896364834470325490_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P7gWDs82Bg4Q7kNvwGRtDDV&_nc_oc=Adrt5iQv14db38fKGXORLBHFU7WWn54IW4vPGyHy-REmLJI5jZYjpZy3ES_wkchY99U&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJLlFqtKyEi51OGAWjRmAV_rRWvQmMxctRk5AFgeiojOg&oe=6AA40152"}, {"file_name": "Screenshot04.png", "id": "575729695062740", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/39031400_575729698396073_2621336866475747103_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=t3knfBtI0ckQ7kNvwGvbFnf&_nc_oc=Adql2mVwgFkfNltig3UuubmIogLCiGwRUCLkWb0r0na8tl_XMydqAUEzv3HeDQFPD4Q&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ0oHJXe_N2x-JfPpD8hY1rSWrRhTt96kQgLZoasoiMVw&oe=6AA4085C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Gameplay Trailer Thumb.png", "id": "605202028847932", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/38974836_605202032181265_2417977283558520499_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P9u0HDOtY28Q7kNvwGUv5SA&_nc_oc=AdrHsDtBiWwQyaSmHdF5HQYlx3knGf7lgldLM5C9U5ri1l-4C00-w4lUOTxHiDGL2c8&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL40xfSrtjQst3DsQYx_hYdVi7I_dFw8wW0xyrlj5TXZQ&oe=6AA41019"}, "display_name": "Squishies - Roll them Home!", "keywords": ["puzzle", "platformer", "sandbox", "exploration", "adventure"], "long_description": "**Get lost in the Squishies-verse!**\n\nSquishies is a head-scratching puzzle platformer where you guide courageous and cute creatures through a series of increasingly hazardous, challenging mazes. Use unique motion controls to push and pull the Squishies through their adventures in a colorful universe full of strange flora and fauna. Keep those little rascals safe while they climb, jump, fly and teleport-by-fish through dozens of levels in five alien worlds!\n\n{507625458961423}\n\nYou push and pull the Squishies from one side of the maze to the other, all while earning medals, gathering crystals, climbing slopes, and avoiding pitfalls.\n\n- **Explore a huge universe** - Across dozens of levels in five different worlds.\n- **Collectibles and Achievements** - Gather all the crystals, beat the clock or find the hidden egg in each level.\n- **Level Editor** - Squishies really comes into its own with its innovative, fully featured creation tools.\n- **Community Section** - Share your creation with others and play their ingenious levels.\n- **Limited play space?** Need to keep an eye on your own little monsters?  You\u2019re in luck. Squishies\u00ae can be played in the newly added Mixed Reality mode!\n\n\n{482757334822594}", "short_description": "Help the stranded Squishies find their way back home! Push and pull them through challenging puzzles, or create your own levels with the powerful in-game editor and share them with the community."}]}, "developer_name": null, "developer_privacy_policy_url": "https://brainseed-factory.com/law/privacy_products/index.php", "developer_terms_of_service_url": "https://brainseed-factory.com/law/terms_products/index.php
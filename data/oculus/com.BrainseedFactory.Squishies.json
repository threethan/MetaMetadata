culuscdn.com/v/t64.5771-25/75322598_1145165853836223_6864148320373849862_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6P_6s5UiZYUQ7kNvwHMWjVq&_nc_oc=Adr91Bg7FcKw4YQpMJL6CAF9e4AemVRPDR_fpuNopCgiDx_1ElyjskpfCXfZ-qaCWzg&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBj3JOfLA9_wIhjT3g2IHMKylFD_MpCxMtDes-aipclYw&oe=6A5CB2C3"}, {"file_name": "Screenshot03.png", "id": "598340872572801", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39001670_598340875906134_7078948835759736288_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n1gkuVmtAAQQ7kNvwECsQsY&_nc_oc=AdqPrnjH9feC_RB3lSyw9boaA-hPRrlRF-RfCH9ojivJGoRzm46Jr3mxj9S9-ZfYkpI&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCRkQQQ8IH_Ph-3z4B98w7EMBfEJCLNOIb-TGvbUFvayQ&oe=6A5CB0CB"}, {"file_name": "Screenshot06.png", "id": "970563445094246", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031450_970563448427579_1896364834470325490_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IuYHBJs6CPkQ7kNvwFTHRwC&_nc_oc=Adq-92yplHiKQjZIE7AwUMy6cINRXG2DXyaRBc21zE8x5jaSJoTN7nwH_3YV1VucwNw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC2hU3uaM843pocOoNDQfSApSHMzP5zAX8cMdfVPWGDhQ&oe=6A5CD052"}, {"file_name": "Screenshot04.png", "id": "575729695062740", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39031400_575729698396073_2621336866475747103_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j6phE_V8kloQ7kNvwEMwH7A&_nc_oc=AdqxeCXC6Pjsm4s9hLU4HmRhofFb0UtR4sA_HplUagOB1QhnR3jb16ZYA6uA0B-YMjA&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC99ZBXv5WFaYPB60rfTtiGGHyfwFf5filEkA2Iu8sTkw&oe=6A5CD75C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Gameplay Trailer Thumb.png", "id": "605202028847932", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974836_605202032181265_2417977283558520499_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NTX0seSoe6kQ7kNvwF4Nkok&_nc_oc=Adr94QNjb-4HRUKF8c7eALEmVag8sDdSFBupviZ4X0RsVELm2dd3tMeN2WHl4oMd1iY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD7npzB11ZtmSbCWVoQbhKdnNlBunb53kAY4aPctBzaSQ&oe=6A5CDF19"}, "display_name": "Squishies - Roll them Home!", "keywords": ["puzzle", "platformer", "sandbox", "exploration", "adventure"], "long_description": "**Get lost in the Squishies-verse!**\n\nSquishies is a head-scratching puzzle platformer where you guide courageous and cute creatures through a series of increasingly hazardous, challenging mazes. Use unique motion controls to push and pull the Squishies through their adventures in a colorful universe full of strange flora and fauna. Keep those little rascals safe while they climb, jump, fly and teleport-by-fish through dozens of levels in five alien worlds!\n\n{507625458961423}\n\nYou push and pull the Squishies from one side of the maze to the other, all while earning medals, gathering crystals, climbing slopes, and avoiding pitfalls.\n\n- **Explore a huge universe** - Across dozens of levels in five different worlds.\n- **Collectibles and Achievements** - Gather all the crystals, beat the clock or find the hidden egg in each level.\n- **Level Editor** - Squishies really comes into its own with its innovative, fully featured creation tools.\n- **Community Section** - Share your creation with others and play their ingenious levels.\n- **Limited play space?** Need to keep an eye on your own little monsters?  You\u2019re in luck. Squishies\u00ae can be played in the newly added Mixed Reality mode!\n\n\n{482757334822594}", "short_description": "Help the stranded Squishies find their way back home! Push and pull them through challenging puzzles, or create your own levels with the powerful in-game editor and share them with the community."}]}, "developer_name": null, "developer_privacy_policy_url": "https://brainseed-factory.com/law/privacy_products/index.php", "developer_terms_of_service_url": "https://brainseed-factory.com/law/terms_products/index.php", "publishe
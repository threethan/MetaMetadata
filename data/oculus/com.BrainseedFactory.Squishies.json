uluscdn.com/v/t64.5771-25/75322598_1145165853836223_6864148320373849862_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vY70XQaQxekQ7kNvwFx1yg9&_nc_oc=AdoZSshXqzORKdweQD0MuhfCDlpYvg8RmJNFzCv32Y76j-q2PJWyUYQyfKtPH_V1W1I&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9ES1EdsAc0XbT0-nO4BUcYVrlbaSfggXKdrNWPYROVlg&oe=6A243A83"}, {"file_name": "Screenshot03.png", "id": "598340872572801", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39001670_598340875906134_7078948835759736288_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h_1ns20e_ucQ7kNvwHbUKdk&_nc_oc=AdpsXqXFK7hHtiOpSkCMcNyhjZCBL4rVw8RBoSgiaUsqphV1iUzx0F3mMPtQBo14EjU&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-0kqF4PbxcDYegV7j0lVLPIEL0qTg9Z4nPiOxSGuS9Lw&oe=6A24388B"}, {"file_name": "Screenshot06.png", "id": "970563445094246", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/39031450_970563448427579_1896364834470325490_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WBnmgILD7ogQ7kNvwF_MEEX&_nc_oc=AdoMHp7p5teprgWK_JuAnqI8SiVI-KcEcj8y0i4mHv719_g6WQULKqqwzjtRFoChqK8&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-AHIOLHozzddE26BW3PzaG7vMi6zQee90poT-tXJusVA&oe=6A241FD2"}, {"file_name": "Screenshot04.png", "id": "575729695062740", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39031400_575729698396073_2621336866475747103_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qURt2Rgac6QQ7kNvwFEpAF_&_nc_oc=Adq8pYTVNIttehuAC_lSsZaYUGRGBkn-if7XYsa6No7x3tutF-XtvhdYkZ1elpq_u3g&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-wqb4zgrf_X8Ej2SoqiDaXSDUjt03YhySP_ntK9WZO2A&oe=6A2426DC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Gameplay Trailer Thumb.png", "id": "605202028847932", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974836_605202032181265_2417977283558520499_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7BehHVgYp0AQ7kNvwERFPBt&_nc_oc=AdpWBOkfyFtwLD3ghAjtnU5fqZB1GeSpdxSQdJ9w1m9dr_ugSZDs2gruXpJpiOu4EBo&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_YoXoL7ynLkwMgyAoc93AFvtg17YgVZ_6vdKw0uUcFlA&oe=6A242E99"}, "display_name": "Squishies - Roll them Home!", "keywords": ["puzzle", "platformer", "sandbox", "exploration", "adventure"], "long_description": "**Get lost in the Squishies-verse!**\n\nSquishies is a head-scratching puzzle platformer where you guide courageous and cute creatures through a series of increasingly hazardous, challenging mazes. Use unique motion controls to push and pull the Squishies through their adventures in a colorful universe full of strange flora and fauna. Keep those little rascals safe while they climb, jump, fly and teleport-by-fish through dozens of levels in five alien worlds!\n\n{507625458961423}\n\nYou push and pull the Squishies from one side of the maze to the other, all while earning medals, gathering crystals, climbing slopes, and avoiding pitfalls.\n\n- **Explore a huge universe** - Across dozens of levels in five different worlds.\n- **Collectibles and Achievements** - Gather all the crystals, beat the clock or find the hidden egg in each level.\n- **Level Editor** - Squishies really comes into its own with its innovative, fully featured creation tools.\n- **Community Section** - Share your creation with others and play their ingenious levels.\n- **Limited play space?** Need to keep an eye on your own little monsters?  You\u2019re in luck. Squishies\u00ae can be played in the newly added Mixed Reality mode!\n\n\n{482757334822594}", "short_description": "Help the stranded Squishies find their way back home! Push and pull them through challenging puzzles, or create your own levels with the powerful in-game editor and share them with the community."}]}, "developer_name": null, "developer_privacy_policy_url": "https://brainseed-factory.com/law/privacy_products/index.php", "developer_terms_of_service_url": "https://brainseed-factory.com/law/terms_products/index.php", "publisher
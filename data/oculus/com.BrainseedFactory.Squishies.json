culuscdn.com/v/t64.5771-25/75322598_1145165853836223_6864148320373849862_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QIJtAMRHgjsQ7kNvwFyiWN7&_nc_oc=AdpyCviC1qfCiaT-B13jsXJxVp8E3hq7FNeg1lwYul-8NDFDMB4J5pk_5wVVsr8jqkc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOX2hMcGmDN-GlaUdHErwJTzEmaI8tsAV_zMtQQ3pDAlQ&oe=6AC3C003"}, {"file_name": "Screenshot03.png", "id": "598340872572801", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39001670_598340875906134_7078948835759736288_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8p0-CXezRHsQ7kNvwE4b1PV&_nc_oc=AdoNTuDN8pDIBaZumvcripGT0kIwgJmMvnNBHHks7_T_pCoYsyNSyNENmjs13wPnOSQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNEWX0IIk4d1LvEdf2_pZ4_oznrshEE8jOj-fZQoDzbWg&oe=6AC3BE0B"}, {"file_name": "Screenshot06.png", "id": "970563445094246", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031450_970563448427579_1896364834470325490_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pUz1kyx7DOIQ7kNvwFttm_i&_nc_oc=Adpd-6N6tiHRmUO7EvOaxs4QGr4IdpewZGPcvi0W3_eDvwmpIyKIZ0GSaPTo0v8sGNE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOn9KOR8p07vFlBbiQxrxzO-_1ENIC8bpg24uKM_3C7Mg&oe=6AC3A552"}, {"file_name": "Screenshot04.png", "id": "575729695062740", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031400_575729698396073_2621336866475747103_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jp2Y-ruSCIgQ7kNvwGt3uH2&_nc_oc=AdrL2fvshE5WnErXeDtHgtkx94LT1UdZuYG3_YX5mgjteBCr7jnSf1Ga6S6qwz8mQu0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNWBhwo0YFThRj5WiliY42zKOAX4HA3gbiYswiatC2B0w&oe=6AC3AC5C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Gameplay Trailer Thumb.png", "id": "605202028847932", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974836_605202032181265_2417977283558520499_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_d9lfPVf9GQQ7kNvwHlBJxg&_nc_oc=Adr4I_BeMK-YhwG03sJMOhaqFd1WjRR4LWJBUX54HdeJajDMf7HumHP4OmUV74BT118&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM2qwyGrIO8Vz31VCK3qGhiPNvJT7uXizY2t-tJ5BKpDA&oe=6AC3B419"}, "display_name": "Squishies - Roll them Home!", "keywords": ["puzzle", "platformer", "sandbox", "exploration", "adventure"], "long_description": "**Get lost in the Squishies-verse!**\n\nSquishies is a head-scratching puzzle platformer where you guide courageous and cute creatures through a series of increasingly hazardous, challenging mazes. Use unique motion controls to push and pull the Squishies through their adventures in a colorful universe full of strange flora and fauna. Keep those little rascals safe while they climb, jump, fly and teleport-by-fish through dozens of levels in five alien worlds!\n\n{507625458961423}\n\nYou push and pull the Squishies from one side of the maze to the other, all while earning medals, gathering crystals, climbing slopes, and avoiding pitfalls.\n\n- **Explore a huge universe** - Across dozens of levels in five different worlds.\n- **Collectibles and Achievements** - Gather all the crystals, beat the clock or find the hidden egg in each level.\n- **Level Editor** - Squishies really comes into its own with its innovative, fully featured creation tools.\n- **Community Section** - Share your creation with others and play their ingenious levels.\n- **Limited play space?** Need to keep an eye on your own little monsters?  You\u2019re in luck. Squishies\u00ae can be played in the newly added Mixed Reality mode!\n\n\n{482757334822594}", "short_description": "Help the stranded Squishies find their way back home! Push and pull them through challenging puzzles, or create your own levels with the powerful in-game editor and share them with the community."}]}, "developer_name": null, "developer_privacy_policy_url": "https://brainseed-factory.com/law/privacy_products/index.php", "developer_terms_of_service_url": "https://brainseed-factory.com/law/terms_products/index.php", "publishe
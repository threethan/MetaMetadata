ent-lhr6-1.oculuscdn.com/v/t64.5771-25/75322598_1145165853836223_6864148320373849862_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xS4LkZUD6c0Q7kNvwF50Cg7&_nc_oc=Adr-AgNidGOW16tp5Vhu0HInvWLDWsO27n0iq3riNrMl4q75Vl1AWqXNRGbfe7b7t5c&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEtsMSeq8GEIgNq87QQPFOcaXyWnf0Bg-M2Zk1a7MkkzQ&oe=6A8ECBC3"}, {"file_name": "Screenshot03.png", "id": "598340872572801", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/39001670_598340875906134_7078948835759736288_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qLj1qCKcPfkQ7kNvwEubs7a&_nc_oc=AdqV1cZYl6mz5v0gb0NEhBgOG8fmTmG3NFMUJhDMg5g35vPSCHBrAuJHUlb4HM2xeZw&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF-QnCj1aze5pkQAyhUCkegYxe7hlMjofowtMQ9cLrxuw&oe=6A8EC9CB"}, {"file_name": "Screenshot06.png", "id": "970563445094246", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/39031450_970563448427579_1896364834470325490_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f3NWNwmDJTgQ7kNvwE3cH3T&_nc_oc=Ado4q2Um9_aJHh5v_-M8UufZ0w6OqLysFIVwwSz60bUZKQVFRxur1VC7W1vnZOi7WaU&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEgPzs6ruz3kz4Jc7Jzz5nTXruNzReqOECnXc53LKaNXg&oe=6A8EE952"}, {"file_name": "Screenshot04.png", "id": "575729695062740", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/39031400_575729698396073_2621336866475747103_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IbZh_vfE5pUQ7kNvwHLmIw0&_nc_oc=AdqL-X-l4aIzBLPzz0gW8dOFhqzCtYTt8lZp71Pay5l_RahdurDQQ6n8vPKEx9pw-70&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGzJmPKHFeAFRvwGtjzgmfFy8Ka7GUoAaTX4rajVIMp6Q&oe=6A8EF05C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Gameplay Trailer Thumb.png", "id": "605202028847932", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/38974836_605202032181265_2417977283558520499_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sS1S_OgCdOkQ7kNvwH6u5qK&_nc_oc=AdpGuWo1OlG3g9P9KvIixzGdaiCrANy8Lkqy75NDa2XtyLf8oy0zi1wiyCedGgkd_CA&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH7bjEyCnbQBalZDya01R_JvSguSie4CQyV6Mdll-aCyw&oe=6A8EBFD9"}, "display_name": "Squishies - Roll them Home!", "keywords": ["puzzle", "platformer", "sandbox", "exploration", "adventure"], "long_description": "**Get lost in the Squishies-verse!**\n\nSquishies is a head-scratching puzzle platformer where you guide courageous and cute creatures through a series of increasingly hazardous, challenging mazes. Use unique motion controls to push and pull the Squishies through their adventures in a colorful universe full of strange flora and fauna. Keep those little rascals safe while they climb, jump, fly and teleport-by-fish through dozens of levels in five alien worlds!\n\n{507625458961423}\n\nYou push and pull the Squishies from one side of the maze to the other, all while earning medals, gathering crystals, climbing slopes, and avoiding pitfalls.\n\n- **Explore a huge universe** - Across dozens of levels in five different worlds.\n- **Collectibles and Achievements** - Gather all the crystals, beat the clock or find the hidden egg in each level.\n- **Level Editor** - Squishies really comes into its own with its innovative, fully featured creation tools.\n- **Community Section** - Share your creation with others and play their ingenious levels.\n- **Limited play space?** Need to keep an eye on your own little monsters?  You\u2019re in luck. Squishies\u00ae can be played in the newly added Mixed Reality mode!\n\n\n{482757334822594}", "short_description": "Help the stranded Squishies find their way back home! Push and pull them through challenging puzzles, or create your own levels with the powerful in-game editor and share them with the community."}]}, "developer_name": null, "developer_privacy_policy_url": "https://brainseed-factory.com/law/privacy_products/index.php", "developer_terms_of_service_url": "https://brainseed-factory.com/law/terms_products/index.p
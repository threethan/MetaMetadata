145165853836223_6864148320373849862_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WifI6mC194UQ7kNvwGbBFkT&_nc_oc=Adr7JaaNLp_88T14-mT0yd-gIRZldsHQXCFqiL4Q09UVggNfLb4b9Y4R-iFKgCwAz4U&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=8&oh=00_Afyajf0Vv9gEavLFc6irAATaRUa0LTXxcSAnyi6Lij6yNQ&oe=69C121C3"}, {"file_name": "Screenshot03.png", "id": "598340872572801", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39001670_598340875906134_7078948835759736288_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SMLVk2hYuAoQ7kNvwHjRXUV&_nc_oc=AdqmSgmQFnOdA_VocfklmcW_i7ooWgLt1MfffIyNwEYs0hm1Pv2UaydsUjRaZNF5zHM&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=8&oh=00_Afwma0UvLEkcZS262cXMxr4cJGd03sygcXP0efiE161hWg&oe=69C11FCB"}, {"file_name": "Screenshot06.png", "id": "970563445094246", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39031450_970563448427579_1896364834470325490_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S0ew4uUG4uoQ7kNvwEj6XRE&_nc_oc=Adr79qZ2I3iJFU42WEGcZSbZdRiN-X_b57E57vvQTf6gLSqmwNJXrl0b5yGCaDSr6vQ&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_AfwgLN5FOVq1gAXNBBIeMOE8HJfRApI3pZh37GmPv_3BcA&oe=69C13F52"}, {"file_name": "Screenshot04.png", "id": "575729695062740", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39031400_575729698396073_2621336866475747103_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9tZIj1cnsEIQ7kNvwFoObt4&_nc_oc=AdqBZNZBN17dKxmdcaSDFad847POxUpNW0Sl9AiGqse1PN44oXJOtjUDsKMAg8qlsHw&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=8&oh=00_AfzHm9FxKjgVGwxwDoY3iTfImG19oqu_xIFpvRaT-jVO0A&oe=69C1465C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Gameplay Trailer Thumb.png", "id": "605202028847932", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974836_605202032181265_2417977283558520499_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8rxfhlr49eEQ7kNvwGdRI8Z&_nc_oc=AdrcZFxSuOGM4T8NNWfWPjtTldoHh01artK7XsV6hR1Eq-6E9D9VsX2tt9Vda-E-NCA&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_AfwRte85SU4DQeqIMaPEjSRvBXS3UEJLb45JdzrdVvG7ZQ&oe=69C14E19"}, "display_name": "Squishies - Roll them Home!", "keywords": ["puzzle", "platformer", "sandbox", "exploration", "adventure"], "long_description": "**Get lost in the Squishies-verse!**\n\nSquishies is a head-scratching puzzle platformer where you guide courageous and cute creatures through a series of increasingly hazardous, challenging mazes. Use unique motion controls to push and pull the Squishies through their adventures in a colorful universe full of strange flora and fauna. Keep those little rascals safe while they climb, jump, fly and teleport-by-fish through dozens of levels in five alien worlds!\n\n{507625458961423}\n\nYou push and pull the Squishies from one side of the maze to the other, all while earning medals, gathering crystals, climbing slopes, and avoiding pitfalls.\n\n- **Explore a huge universe** - Across dozens of levels in five different worlds.\n- **Collectibles and Achievements** - Gather all the crystals, beat the clock or find the hidden egg in each level.\n- **Level Editor** - Squishies really comes into its own with its innovative, fully featured creation tools.\n- **Community Section** - Share your creation with others and play their ingenious levels.\n- **Limited play space?** Need to keep an eye on your own little monsters?  You\u2019re in luck. Squishies\u00ae can be played in the newly added Mixed Reality mode!\n\n\n{482757334822594}", "short_description": "Help the stranded Squishies find their way back home! Push and pull them through challenging puzzles, or create your own levels with the powerful in-game editor and share them with the community."}]}, "developer_name": null, "developer_privacy_policy_url": "https://brainseed-factory.com/law/privacy_products/index.php", "developer_terms_of_service_url": "https://brainseed-factory.com/law/terms_products/index.php", "publisher_name": "Perp Games", "support_website_url": null, "webs
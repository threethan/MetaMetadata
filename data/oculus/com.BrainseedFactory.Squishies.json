uluscdn.com/v/t64.5771-25/75322598_1145165853836223_6864148320373849862_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3iP0J-agoNsQ7kNvwGVpRM4&_nc_oc=Adqc4fyEhBgFUWhZ90Icw1kFk4rT4gpXKQlm-1NZXPwabG-Gq0b8wTNWzM-eNdOjS_k&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_adBH4yLkli9uck0gQdsKXZ3Un7gRIEs1z9kUb3S6xxw&oe=6A298083"}, {"file_name": "Screenshot03.png", "id": "598340872572801", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39001670_598340875906134_7078948835759736288_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MbBC6PGQam8Q7kNvwHYXIkV&_nc_oc=Adpj-3q6TlwElQauZj66mESC-AultV-vnEjgkwNgUOI2sVwyXvGsOS14ZrLu5lpQUcc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-4G1CN9Kyx4IP7WaUC5OgRqfBYzfgQAcJAMqLsHcVnhA&oe=6A297E8B"}, {"file_name": "Screenshot06.png", "id": "970563445094246", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031450_970563448427579_1896364834470325490_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F7uSYb96vFsQ7kNvwEaV1SJ&_nc_oc=AdqQXuaZHZtyYRLhDHl6DHJ_qJQJ3YfG0O9yaE9hIfeh1gnqu3uo0m9RSgrooWGeGak&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-9Bfz30S8-07W006SgCPY8riSx2fxxqKOF9c-DNSccYg&oe=6A2965D2"}, {"file_name": "Screenshot04.png", "id": "575729695062740", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031400_575729698396073_2621336866475747103_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wiuBIqf5UxIQ7kNvwGIiE_5&_nc_oc=AdrTq6bOe7c14bbLAePU_3_yY6l3ZhNPF2sIYeXlpdWhr80X5HlqcB_i3ikCp4KMssY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_QaYMySlgUewTAz9GrktSKJfl4_e7rJ42Mndv_pN5b4g&oe=6A296CDC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Gameplay Trailer Thumb.png", "id": "605202028847932", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974836_605202032181265_2417977283558520499_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ES5IOSdmXvQQ7kNvwHgb8ge&_nc_oc=AdpZZAZS1zgN5ZfTrO5MLm4IsDQ_IevSZKh1kAx2DXBnbKJsGM6WnkFCIomLJKUZ4UM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-4n_ekfqCG1PU_ywq4bOBd5guHy6sX-opgJvHAzAXjOg&oe=6A297499"}, "display_name": "Squishies - Roll them Home!", "keywords": ["puzzle", "platformer", "sandbox", "exploration", "adventure"], "long_description": "**Get lost in the Squishies-verse!**\n\nSquishies is a head-scratching puzzle platformer where you guide courageous and cute creatures through a series of increasingly hazardous, challenging mazes. Use unique motion controls to push and pull the Squishies through their adventures in a colorful universe full of strange flora and fauna. Keep those little rascals safe while they climb, jump, fly and teleport-by-fish through dozens of levels in five alien worlds!\n\n{507625458961423}\n\nYou push and pull the Squishies from one side of the maze to the other, all while earning medals, gathering crystals, climbing slopes, and avoiding pitfalls.\n\n- **Explore a huge universe** - Across dozens of levels in five different worlds.\n- **Collectibles and Achievements** - Gather all the crystals, beat the clock or find the hidden egg in each level.\n- **Level Editor** - Squishies really comes into its own with its innovative, fully featured creation tools.\n- **Community Section** - Share your creation with others and play their ingenious levels.\n- **Limited play space?** Need to keep an eye on your own little monsters?  You\u2019re in luck. Squishies\u00ae can be played in the newly added Mixed Reality mode!\n\n\n{482757334822594}", "short_description": "Help the stranded Squishies find their way back home! Push and pull them through challenging puzzles, or create your own levels with the powerful in-game editor and share them with the community."}]}, "developer_name": null, "developer_privacy_policy_url": "https://brainseed-factory.com/law/privacy_products/index.php", "developer_terms_of_service_url": "https://brainseed-factory.com/law/terms_products/index.php", "publisher
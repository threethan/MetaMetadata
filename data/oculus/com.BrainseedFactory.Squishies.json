culuscdn.com/v/t64.5771-25/75322598_1145165853836223_6864148320373849862_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=t-0-7SviuTMQ7kNvwESwTI9&_nc_oc=Adr0VJ0PWirFzr83EhRnv6qU-eJ1BRlgOJTcC94WVmyIn7-AUtaFMQCVfke42I8_5BA&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFoZVRYajB0Nc9lUuMvm8XffgodI-eFIu7BEwp0i9SUIg&oe=6A901D43"}, {"file_name": "Screenshot03.png", "id": "598340872572801", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/39001670_598340875906134_7078948835759736288_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NJn-66goJfMQ7kNvwGmHCLH&_nc_oc=AdrXbcvxr9A9B4YorEKQ4ftqChdKwsqVjplZ_9Ss3ibvNqxQDx-YNpRIlNpr2tkyC2w&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHBXC-DpfHk6UkEEWxTPk0S2qlTz62eJ6ee8YgknfYdbw&oe=6A901B4B"}, {"file_name": "Screenshot06.png", "id": "970563445094246", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39031450_970563448427579_1896364834470325490_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KSjQkv_04dEQ7kNvwGjGx_h&_nc_oc=AdqD9Ik4zZ5HD8Y0NreHFRJZQebHxPZ69f6zcQPzuL8tkB2FrWwbueuVPDQdkYd66LE&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHQtytqIihCoXUwKg999qTARTZPaModzrn1vY0XCdhHZQ&oe=6A903AD2"}, {"file_name": "Screenshot04.png", "id": "575729695062740", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39031400_575729698396073_2621336866475747103_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IbZh_vfE5pUQ7kNvwHFamKu&_nc_oc=AdpKXVc1Q-bi5nt9CC3aREmOaQLV2aYmI2-fSVJ9opFzT_dePpBmVZ9Nqz9eQXSSapE&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFnGRuT0swKKijOxee8J48yNn8Fwlcb1dtSgnke5FtIjg&oe=6A90099C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Gameplay Trailer Thumb.png", "id": "605202028847932", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974836_605202032181265_2417977283558520499_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sS1S_OgCdOkQ7kNvwHG_d8h&_nc_oc=Adpy2mOS0HvbvYhUrXFT-Vn87slmvMw7J76PWc4MANzKKD9gKvh7knFAYMkERjLOwyw&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFZs7qlrIm5Wc7ujApyvvJ80GNKSj18A-ZCnFuhd629nw&oe=6A901159"}, "display_name": "Squishies - Roll them Home!", "keywords": ["puzzle", "platformer", "sandbox", "exploration", "adventure"], "long_description": "**Get lost in the Squishies-verse!**\n\nSquishies is a head-scratching puzzle platformer where you guide courageous and cute creatures through a series of increasingly hazardous, challenging mazes. Use unique motion controls to push and pull the Squishies through their adventures in a colorful universe full of strange flora and fauna. Keep those little rascals safe while they climb, jump, fly and teleport-by-fish through dozens of levels in five alien worlds!\n\n{507625458961423}\n\nYou push and pull the Squishies from one side of the maze to the other, all while earning medals, gathering crystals, climbing slopes, and avoiding pitfalls.\n\n- **Explore a huge universe** - Across dozens of levels in five different worlds.\n- **Collectibles and Achievements** - Gather all the crystals, beat the clock or find the hidden egg in each level.\n- **Level Editor** - Squishies really comes into its own with its innovative, fully featured creation tools.\n- **Community Section** - Share your creation with others and play their ingenious levels.\n- **Limited play space?** Need to keep an eye on your own little monsters?  You\u2019re in luck. Squishies\u00ae can be played in the newly added Mixed Reality mode!\n\n\n{482757334822594}", "short_description": "Help the stranded Squishies find their way back home! Push and pull them through challenging puzzles, or create your own levels with the powerful in-game editor and share them with the community."}]}, "developer_name": null, "developer_privacy_policy_url": "https://brainseed-factory.com/law/privacy_products/index.php", "developer_terms_of_service_url": "https://brainseed-factory.com/law/terms_products/index.php", "publishe
culuscdn.com/v/t64.5771-25/75322598_1145165853836223_6864148320373849862_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d8dl9EUOKgoQ7kNvwHT1RDw&_nc_oc=AdqYbT9XR3bVAwkpm8tutF8hbmmn36tRwO8_tmpXeBq6PEKIx-jOtEhuxPhwIXVTo3A&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNwqzEECHJoKdsPE8gmULRTOzgFwWGvWYE8GfSJ_H1sJg&oe=6AC26E83"}, {"file_name": "Screenshot03.png", "id": "598340872572801", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39001670_598340875906134_7078948835759736288_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YeWks81WT8UQ7kNvwF0Dyam&_nc_oc=AdqqsMxOzGRT4kLokn-zjDb9T5lG_WyfIuc-ARv4sGidvSjXAyzjmJ4M9KOF8xfNlSc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNPQOef7wrEAo7PIpNKjldCEJ8SOX-ifSibsxW5bIhi4g&oe=6AC26C8B"}, {"file_name": "Screenshot06.png", "id": "970563445094246", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031450_970563448427579_1896364834470325490_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jIEeiwfv6cUQ7kNvwFpa6dQ&_nc_oc=Adq03uxCfcUJPmQdrSSTC-3SkDq1MVVdPpfEbsExv_a1WvNvXdZDRLE8g90jLbYjkNY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOnVkdCjUYi-m1JgyAzDJ8FqF1TB302Lkhs3GMAnBDCrA&oe=6AC253D2"}, {"file_name": "Screenshot04.png", "id": "575729695062740", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031400_575729698396073_2621336866475747103_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Hf0oBXXTXxYQ7kNvwG3oaMI&_nc_oc=AdoIxUSNAj7BBlmjjy3M84YRL4qJBAWBuABzNzUUQSTmJ4supAvR6c30KT9PgoP8ME8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNJPkhmEScNnCcICX7qsE0C7JDsCltFsZ68mAJkqNHPCQ&oe=6AC25ADC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Gameplay Trailer Thumb.png", "id": "605202028847932", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974836_605202032181265_2417977283558520499_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_d9lfPVf9GQQ7kNvwFeoPTg&_nc_oc=AdpUIztGo7godZjEFkfH3sPQqUsH3l8rCDi7ORjx0e_ZKcb1GSjHsrBRX0zsYjiumK8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMdgbfos03l4GZ_vbdcBWrkDLWKCLuyJYPOzR9wYLwybQ&oe=6AC26299"}, "display_name": "Squishies - Roll them Home!", "keywords": ["puzzle", "platformer", "sandbox", "exploration", "adventure"], "long_description": "**Get lost in the Squishies-verse!**\n\nSquishies is a head-scratching puzzle platformer where you guide courageous and cute creatures through a series of increasingly hazardous, challenging mazes. Use unique motion controls to push and pull the Squishies through their adventures in a colorful universe full of strange flora and fauna. Keep those little rascals safe while they climb, jump, fly and teleport-by-fish through dozens of levels in five alien worlds!\n\n{507625458961423}\n\nYou push and pull the Squishies from one side of the maze to the other, all while earning medals, gathering crystals, climbing slopes, and avoiding pitfalls.\n\n- **Explore a huge universe** - Across dozens of levels in five different worlds.\n- **Collectibles and Achievements** - Gather all the crystals, beat the clock or find the hidden egg in each level.\n- **Level Editor** - Squishies really comes into its own with its innovative, fully featured creation tools.\n- **Community Section** - Share your creation with others and play their ingenious levels.\n- **Limited play space?** Need to keep an eye on your own little monsters?  You\u2019re in luck. Squishies\u00ae can be played in the newly added Mixed Reality mode!\n\n\n{482757334822594}", "short_description": "Help the stranded Squishies find their way back home! Push and pull them through challenging puzzles, or create your own levels with the powerful in-game editor and share them with the community."}]}, "developer_name": null, "developer_privacy_policy_url": "https://brainseed-factory.com/law/privacy_products/index.php", "developer_terms_of_service_url": "https://brainseed-factory.com/law/terms_products/index.php", "publishe
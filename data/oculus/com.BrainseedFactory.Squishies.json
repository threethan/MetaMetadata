sin2-2.oculuscdn.com/v/t64.5771-25/75322598_1145165853836223_6864148320373849862_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nqHckvv-A7UQ7kNvwGjsRg0&_nc_oc=AdoFQ4ejpFq5lRRAMnSUeiHcgRAu-_XA8np_gfNgk253KE642pkbPK5CVBXmG3XbKxA&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8PELK9BVZ9VQGZkMOXUrOqPn2dqd1xbfTVXGx_taJMnQ&oe=6A468183"}, {"file_name": "Screenshot03.png", "id": "598340872572801", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/39001670_598340875906134_7078948835759736288_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k-QHkWOxiXcQ7kNvwFlwP8x&_nc_oc=AdrJbycGxZRW4GCeX1V4HFTbPdwuVtrz1DYWHuf-SaRqC-BZOWQA9dyi7iDRLiMIg78&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8tijTsCFYiyWhxpopSrfVkK3YrCpvoUk0q4LLaibCA1Q&oe=6A467F8B"}, {"file_name": "Screenshot06.png", "id": "970563445094246", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/39031450_970563448427579_1896364834470325490_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6pZpC1BLF_IQ7kNvwH6n2pQ&_nc_oc=Adqb_pkpPW1ThRRhQS5cj0m7GKHxo_9D1pCwgW8mpigMbJWMMsmykuZqVeqHjJ7Fd3c&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8uq3ftZA4DRVkYdgHmpqt_XicgTpyMo8y3dAApCmKtrA&oe=6A4666D2"}, {"file_name": "Screenshot04.png", "id": "575729695062740", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/39031400_575729698396073_2621336866475747103_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s28mqfZySrIQ7kNvwFCm5MV&_nc_oc=Adr4Dsp5o1sB_zvb2UeTwNA1ucbj2pna0XmRcsMjN3t7GkW-C9GqaGAPdtPm37OSi4c&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8KyYptcH2a9v7cVdvx4zpuq0x7w5WjY7a2vJuyD8FQrg&oe=6A466DDC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Gameplay Trailer Thumb.png", "id": "605202028847932", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/38974836_605202032181265_2417977283558520499_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iOJ8Rhdam3sQ7kNvwHsURQt&_nc_oc=Ado7uoG6uSIpWxWzNh2h8woadPi4sTLqmYbX0wRzF9jHfAoQ1IqluaPfg-OnwkcfuZw&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-9dpg4-QZGycsc7LYUCqGoEhRwnEl_raOBGcb8etkg3Q&oe=6A467599"}, "display_name": "Squishies - Roll them Home!", "keywords": ["puzzle", "platformer", "sandbox", "exploration", "adventure"], "long_description": "**Get lost in the Squishies-verse!**\n\nSquishies is a head-scratching puzzle platformer where you guide courageous and cute creatures through a series of increasingly hazardous, challenging mazes. Use unique motion controls to push and pull the Squishies through their adventures in a colorful universe full of strange flora and fauna. Keep those little rascals safe while they climb, jump, fly and teleport-by-fish through dozens of levels in five alien worlds!\n\n{507625458961423}\n\nYou push and pull the Squishies from one side of the maze to the other, all while earning medals, gathering crystals, climbing slopes, and avoiding pitfalls.\n\n- **Explore a huge universe** - Across dozens of levels in five different worlds.\n- **Collectibles and Achievements** - Gather all the crystals, beat the clock or find the hidden egg in each level.\n- **Level Editor** - Squishies really comes into its own with its innovative, fully featured creation tools.\n- **Community Section** - Share your creation with others and play their ingenious levels.\n- **Limited play space?** Need to keep an eye on your own little monsters?  You\u2019re in luck. Squishies\u00ae can be played in the newly added Mixed Reality mode!\n\n\n{482757334822594}", "short_description": "Help the stranded Squishies find their way back home! Push and pull them through challenging puzzles, or create your own levels with the powerful in-game editor and share them with the community."}]}, "developer_name": null, "developer_privacy_policy_url": "https://brainseed-factory.com/law/privacy_products/index.php", "developer_terms_of_service_url": "https://brainseed-factory.com/law/terms_products/index.php
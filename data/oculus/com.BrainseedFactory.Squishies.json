uluscdn.com/v/t64.5771-25/75322598_1145165853836223_6864148320373849862_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U8x70y38mfAQ7kNvwGhEKih&_nc_oc=AdrHFSZdngO5eoiYFTCLvkog7tcfOwGxRunUfQEPSxSaT_jqeDs6YhhMwFLCwYuynI0&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afy6bQtR-C3EMQmwcYV56uA6F-8RZQ8Qr64cVnQn_IZICA&oe=69C51643"}, {"file_name": "Screenshot03.png", "id": "598340872572801", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39001670_598340875906134_7078948835759736288_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A012LcPUxTQQ7kNvwEc0bRW&_nc_oc=AdpnCj1PtwfDvKckcW6rdKffJxGXlDXCK9hVUANQzTlODgfD7bvABadDBcfgQNLLzgE&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyEnL9vAIEo1UyB9i2b7sAINutk-4opGk_2eiUBhWTfhQ&oe=69C5144B"}, {"file_name": "Screenshot06.png", "id": "970563445094246", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/39031450_970563448427579_1896364834470325490_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YG43jWePtQIQ7kNvwH7fd9d&_nc_oc=AdoXk4hJtR2uioD64wCejrB53UwsAodcgvlZznZq4GFNwR9KOvSU8cT81GwODZ6lqC0&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfydiaDhYyXTQeLqy-XVsyZHSLewM7OvIuL1a0AzaprcBw&oe=69C533D2"}, {"file_name": "Screenshot04.png", "id": "575729695062740", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39031400_575729698396073_2621336866475747103_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ybwdQ5hFsYAQ7kNvwEu5Aa-&_nc_oc=Adp_faIW1TdYJHwDWn-_8neEPLe5me5LuNikxvceGkSOiVfyKYVR1FfFOsqj7nphRQc&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzlJz1pjtnAud3RsuUYa5EDafnSxUEO7OboEGranwfSdQ&oe=69C53ADC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Gameplay Trailer Thumb.png", "id": "605202028847932", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974836_605202032181265_2417977283558520499_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k0tLp6yk9U0Q7kNvwEp7hAn&_nc_oc=AdquYeB3Dh4lIrHz4yxSCRe9OhVIPFeus7o2j-XIfh2rCMBjayIpfz_3vIuiJjhcDqg&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzNo1-6zVFOi3apNTPFgKBHMxcuFkxeHm3uw6mljgOB4A&oe=69C54299"}, "display_name": "Squishies - Roll them Home!", "keywords": ["puzzle", "platformer", "sandbox", "exploration", "adventure"], "long_description": "**Get lost in the Squishies-verse!**\n\nSquishies is a head-scratching puzzle platformer where you guide courageous and cute creatures through a series of increasingly hazardous, challenging mazes. Use unique motion controls to push and pull the Squishies through their adventures in a colorful universe full of strange flora and fauna. Keep those little rascals safe while they climb, jump, fly and teleport-by-fish through dozens of levels in five alien worlds!\n\n{507625458961423}\n\nYou push and pull the Squishies from one side of the maze to the other, all while earning medals, gathering crystals, climbing slopes, and avoiding pitfalls.\n\n- **Explore a huge universe** - Across dozens of levels in five different worlds.\n- **Collectibles and Achievements** - Gather all the crystals, beat the clock or find the hidden egg in each level.\n- **Level Editor** - Squishies really comes into its own with its innovative, fully featured creation tools.\n- **Community Section** - Share your creation with others and play their ingenious levels.\n- **Limited play space?** Need to keep an eye on your own little monsters?  You\u2019re in luck. Squishies\u00ae can be played in the newly added Mixed Reality mode!\n\n\n{482757334822594}", "short_description": "Help the stranded Squishies find their way back home! Push and pull them through challenging puzzles, or create your own levels with the powerful in-game editor and share them with the community."}]}, "developer_name": null, "developer_privacy_policy_url": "https://brainseed-factory.com/law/privacy_products/index.php", "developer_terms_of_service_url": "https://brainseed-factory.com/law/terms_products/index.php", "publisher
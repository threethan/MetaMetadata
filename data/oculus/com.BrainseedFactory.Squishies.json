culuscdn.com/v/t64.5771-25/75322598_1145165853836223_6864148320373849862_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CDlsJKPuiy8Q7kNvwHz-jn_&_nc_oc=AdrY1SZz_e4vbxYuIxF9ecW8Et-e_CpScp63sO3-78nCpzGepEfTPrVJHJ7Js363cCs&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCj3el_t5aO9RDjNoJunVAvyzysnUxV-WAZ5USpufcl8w&oe=6A4E6A83"}, {"file_name": "Screenshot03.png", "id": "598340872572801", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/39001670_598340875906134_7078948835759736288_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Kmn6cThiMPUQ7kNvwHdxCjO&_nc_oc=AdoRrJiT-VHycVjztIXiDrAfMZ1YvQ5KIiUqRuTctCpBAO5O_FQEVi0ob6FTzaS8vPw&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA4fB97UWQIa5s2Etjp_T-XG4_nyZM4LMLINCD2dAzWwg&oe=6A4E688B"}, {"file_name": "Screenshot06.png", "id": "970563445094246", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/39031450_970563448427579_1896364834470325490_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mdUZkqquziMQ7kNvwECNNsJ&_nc_oc=AdqGUtSocEFoc3sarQNZHeUlye8FSpOFqKEi4kI421Zj9LFS-8uoZC1ut7TTpWoDkfU&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBaucgTJfua7dX9gqsX3T-vh806iG2XV0KgwefVwrhmQw&oe=6A4E4FD2"}, {"file_name": "Screenshot04.png", "id": "575729695062740", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/39031400_575729698396073_2621336866475747103_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vj9pSvAML1UQ7kNvwEJogcJ&_nc_oc=AdrAkxCYhlLAlRQ-m1Ol9zuyUn6EkmuxPmNyJ9TV4PCXuEo1MVia6FrdFPdqtCCOPD0&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCILHydvdRDlaLv6UeW7A2Qg753fqZKPH9nWAQ_LoXXtg&oe=6A4E56DC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Gameplay Trailer Thumb.png", "id": "605202028847932", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38974836_605202032181265_2417977283558520499_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4D1J1aEaI_AQ7kNvwGbRvFf&_nc_oc=AdqS783TiiiyIdeBCJ_EUqKGYuvY03HZFTHzrcurHr0cAFoXApKcpEzdUAxP_N2YeU8&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDVLfAR7vilPTcx8E-ET03CwIPN4y89QE5T700sReJiUw&oe=6A4E5E99"}, "display_name": "Squishies - Roll them Home!", "keywords": ["puzzle", "platformer", "sandbox", "exploration", "adventure"], "long_description": "**Get lost in the Squishies-verse!**\n\nSquishies is a head-scratching puzzle platformer where you guide courageous and cute creatures through a series of increasingly hazardous, challenging mazes. Use unique motion controls to push and pull the Squishies through their adventures in a colorful universe full of strange flora and fauna. Keep those little rascals safe while they climb, jump, fly and teleport-by-fish through dozens of levels in five alien worlds!\n\n{507625458961423}\n\nYou push and pull the Squishies from one side of the maze to the other, all while earning medals, gathering crystals, climbing slopes, and avoiding pitfalls.\n\n- **Explore a huge universe** - Across dozens of levels in five different worlds.\n- **Collectibles and Achievements** - Gather all the crystals, beat the clock or find the hidden egg in each level.\n- **Level Editor** - Squishies really comes into its own with its innovative, fully featured creation tools.\n- **Community Section** - Share your creation with others and play their ingenious levels.\n- **Limited play space?** Need to keep an eye on your own little monsters?  You\u2019re in luck. Squishies\u00ae can be played in the newly added Mixed Reality mode!\n\n\n{482757334822594}", "short_description": "Help the stranded Squishies find their way back home! Push and pull them through challenging puzzles, or create your own levels with the powerful in-game editor and share them with the community."}]}, "developer_name": null, "developer_privacy_policy_url": "https://brainseed-factory.com/law/privacy_products/index.php", "developer_terms_of_service_url": "https://brainseed-factory.com/law/terms_products/index.php", "publishe
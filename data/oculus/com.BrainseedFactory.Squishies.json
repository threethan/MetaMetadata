culuscdn.com/v/t64.5771-25/75322598_1145165853836223_6864148320373849862_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z7Y8rVMQEBYQ7kNvwFjdrhT&_nc_oc=Adp64NAWsuFRIeI9xQ8RH1D1bXM1EqRX6y8EFyTCaDeqnvIMWpneuLexSHPrc6IFh88&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB3KZe1Na5gRdLstgWbz0qEmPVEIuax9KrY1NWNgHOPpQ&oe=6A689043"}, {"file_name": "Screenshot03.png", "id": "598340872572801", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/39001670_598340875906134_7078948835759736288_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4ypR9EgrLc4Q7kNvwGXh51g&_nc_oc=AdraJl2xoTjkVRpqASconYXQAePlx1eWGuyPM_j3y35HdfprulsK2Yw6YctLhgGCgE8&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDgOqH1FXHtw99PEDnq2eJCCLzaSNaSz3-YC1YyC1oshA&oe=6A688E4B"}, {"file_name": "Screenshot06.png", "id": "970563445094246", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39031450_970563448427579_1896364834470325490_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Pv2b0kSnjQQQ7kNvwEYy-NJ&_nc_oc=AdrHeVIBtcx6f2L2ByqcubhDOXrmi3EDGONsZKYcV3FJFdp2xZN1pZxAjhE3AYiNf0E&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAbaDgjtb6Km-pl9VSIvtNw4rjLE7evQC_xZG-4xQxT-Q&oe=6A68ADD2"}, {"file_name": "Screenshot04.png", "id": "575729695062740", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39031400_575729698396073_2621336866475747103_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eAwaUIU-QzcQ7kNvwGk82MN&_nc_oc=AdowUcimVTgoRfmC7_7J1S-YSDyQwHoEqPRq-N-ASqVQ5rhYQSxryhvOxrSm9ihqfFo&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCgZVaub7nsme2Bs6lTH9DVarxe3D8ueDMHty5g-6iZEw&oe=6A68B4DC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Gameplay Trailer Thumb.png", "id": "605202028847932", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974836_605202032181265_2417977283558520499_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3UQEzI4rMLoQ7kNvwEEbI2R&_nc_oc=Adq60wLDo4kLJpeCnbQDkY-wYVpAbP2W0kqEjpQ4OfIQZrXxOYGlSBlvQ593RGFt2GM&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBMFi3EoXVSUwlKD0kiAe-KEU9FMayiKgfAzrFvtrZIOw&oe=6A68BC99"}, "display_name": "Squishies - Roll them Home!", "keywords": ["puzzle", "platformer", "sandbox", "exploration", "adventure"], "long_description": "**Get lost in the Squishies-verse!**\n\nSquishies is a head-scratching puzzle platformer where you guide courageous and cute creatures through a series of increasingly hazardous, challenging mazes. Use unique motion controls to push and pull the Squishies through their adventures in a colorful universe full of strange flora and fauna. Keep those little rascals safe while they climb, jump, fly and teleport-by-fish through dozens of levels in five alien worlds!\n\n{507625458961423}\n\nYou push and pull the Squishies from one side of the maze to the other, all while earning medals, gathering crystals, climbing slopes, and avoiding pitfalls.\n\n- **Explore a huge universe** - Across dozens of levels in five different worlds.\n- **Collectibles and Achievements** - Gather all the crystals, beat the clock or find the hidden egg in each level.\n- **Level Editor** - Squishies really comes into its own with its innovative, fully featured creation tools.\n- **Community Section** - Share your creation with others and play their ingenious levels.\n- **Limited play space?** Need to keep an eye on your own little monsters?  You\u2019re in luck. Squishies\u00ae can be played in the newly added Mixed Reality mode!\n\n\n{482757334822594}", "short_description": "Help the stranded Squishies find their way back home! Push and pull them through challenging puzzles, or create your own levels with the powerful in-game editor and share them with the community."}]}, "developer_name": null, "developer_privacy_policy_url": "https://brainseed-factory.com/law/privacy_products/index.php", "developer_terms_of_service_url": "https://brainseed-factory.com/law/terms_products/index.php", "publishe
culuscdn.com/v/t64.5771-25/75322598_1145165853836223_6864148320373849862_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QIJtAMRHgjsQ7kNvwGcIjRc&_nc_oc=Adqwlm6sE-vnDLU33pw6d1BBzfDvyBsl7_-so5QOQm0I9pkXCJfIzRl-RzegRBLBfY8&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNk1HnNpSlwm0U0P4KpXQ4olGV-urI9lZz4zqRuoz4kEw&oe=6AC51183"}, {"file_name": "Screenshot03.png", "id": "598340872572801", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/39001670_598340875906134_7078948835759736288_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8p0-CXezRHsQ7kNvwE7Y7hc&_nc_oc=Ados8LrWg-vNhhkvYPebIF-05mNxg6_GN3897QOFpL2epupF2BiGp3JDNqfW7SUW8w4&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNsBHeod93ywFMPJnMJzCxz7fprimwBRG-YTW2xJwJawg&oe=6AC50F8B"}, {"file_name": "Screenshot06.png", "id": "970563445094246", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/39031450_970563448427579_1896364834470325490_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pUz1kyx7DOIQ7kNvwFUWw_d&_nc_oc=Adp_pPZwUokD8RMdRgqTv_7eCJkYVJ0GLBjMMq-IsSuUF4M3uoCujHRpqP-aF3EKt5M&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNRtK_SRJbGqAV0T7RGsPh0GG8IMK5i40N8JWgQhwtd2A&oe=6AC4F6D2"}, {"file_name": "Screenshot04.png", "id": "575729695062740", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/39031400_575729698396073_2621336866475747103_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jp2Y-ruSCIgQ7kNvwG-7GGd&_nc_oc=AdqcDbq8jYriO_w-RcmtYN3ISIGwXJKa3jrV66137VxdWH8-MoTYYm1kH_SL-B7kTOI&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPY85dfEIq6KNySHVzECb2IKpLLEI8Bked3_7c9cijvPg&oe=6AC4FDDC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Gameplay Trailer Thumb.png", "id": "605202028847932", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38974836_605202032181265_2417977283558520499_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_d9lfPVf9GQQ7kNvwFiJ_-h&_nc_oc=Adp_RwZqTYvdm2RgsgPtP92ZPPJ9JZQeWw7zcjwb3b0-iY_A4U8-d_hv-oBsGG7QpzI&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM1Hd8xGuoj8LPnBnus-tlmagVHey8W9dYdn9CqVgW7Ng&oe=6AC50599"}, "display_name": "Squishies - Roll them Home!", "keywords": ["puzzle", "platformer", "sandbox", "exploration", "adventure"], "long_description": "**Get lost in the Squishies-verse!**\n\nSquishies is a head-scratching puzzle platformer where you guide courageous and cute creatures through a series of increasingly hazardous, challenging mazes. Use unique motion controls to push and pull the Squishies through their adventures in a colorful universe full of strange flora and fauna. Keep those little rascals safe while they climb, jump, fly and teleport-by-fish through dozens of levels in five alien worlds!\n\n{507625458961423}\n\nYou push and pull the Squishies from one side of the maze to the other, all while earning medals, gathering crystals, climbing slopes, and avoiding pitfalls.\n\n- **Explore a huge universe** - Across dozens of levels in five different worlds.\n- **Collectibles and Achievements** - Gather all the crystals, beat the clock or find the hidden egg in each level.\n- **Level Editor** - Squishies really comes into its own with its innovative, fully featured creation tools.\n- **Community Section** - Share your creation with others and play their ingenious levels.\n- **Limited play space?** Need to keep an eye on your own little monsters?  You\u2019re in luck. Squishies\u00ae can be played in the newly added Mixed Reality mode!\n\n\n{482757334822594}", "short_description": "Help the stranded Squishies find their way back home! Push and pull them through challenging puzzles, or create your own levels with the powerful in-game editor and share them with the community."}]}, "developer_name": null, "developer_privacy_policy_url": "https://brainseed-factory.com/law/privacy_products/index.php", "developer_terms_of_service_url": "https://brainseed-factory.com/law/terms_products/index.php", "publishe
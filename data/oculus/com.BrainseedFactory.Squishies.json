culuscdn.com/v/t64.5771-25/75322598_1145165853836223_6864148320373849862_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0I542oXWqPwQ7kNvwGI2PLe&_nc_oc=AdpOPr5rUuc_xZT4pSxzvCqqNwKIOj-912hYiaGlthoD20L8sGfFb1xufhLW6UusVYQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI479ByG9gEjo836qxIzBGkAovqf8YG9SuOd_2nsMdbMg&oe=6A9ED603"}, {"file_name": "Screenshot03.png", "id": "598340872572801", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39001670_598340875906134_7078948835759736288_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kAGe4_KWY9YQ7kNvwGJ27pm&_nc_oc=Adp_YbxSH4skE0QaSaQclJkT2sm1tXXmElgvLfwEjIP3yzj5eHoFjrk-oC9n8WnXGkI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKsCplvg4t1YSHGMI-StRfB_XuWqSmUIWJRlxBeSTnssQ&oe=6A9ED40B"}, {"file_name": "Screenshot06.png", "id": "970563445094246", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031450_970563448427579_1896364834470325490_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=79f0oSvwuXMQ7kNvwE-k9S4&_nc_oc=AdqYykkojZ6GwfY1DlFdP8bZMjsMxtzUTGUcTd3DMzQOeTz_IxodO-l-SAmYNFVBI9I&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJwq_LbMY_ZYChbA6t6wzTAtDrTUF60uo1fngTs_qZy_Q&oe=6A9EBB52"}, {"file_name": "Screenshot04.png", "id": "575729695062740", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031400_575729698396073_2621336866475747103_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aCaz9xa6RXAQ7kNvwH1ZDfT&_nc_oc=AdrzWpbj6yGzfZ2ErXE2J9jSvqNIfXjvEM0mWRBti0Tua1vL1MvZfZgE3ZvfIt5kHQk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKy7uue9YXOuDTfvLZPtwdWbwCZl1Y3-1ah9OCsYRbfdg&oe=6A9EC25C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Gameplay Trailer Thumb.png", "id": "605202028847932", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974836_605202032181265_2417977283558520499_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fhlMopUVto4Q7kNvwFuQFeY&_nc_oc=Adp9iCnWHwdsQ6daqm50zl9BrzgT_j1reAEoOHGVOCbsZ8K0EiHpGcOFOXw65i7blBw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJwVlyOJor9lpL2Q_GTELO3MBZv9eB_1FgLjZCv7EK2lg&oe=6A9ECA19"}, "display_name": "Squishies - Roll them Home!", "keywords": ["puzzle", "platformer", "sandbox", "exploration", "adventure"], "long_description": "**Get lost in the Squishies-verse!**\n\nSquishies is a head-scratching puzzle platformer where you guide courageous and cute creatures through a series of increasingly hazardous, challenging mazes. Use unique motion controls to push and pull the Squishies through their adventures in a colorful universe full of strange flora and fauna. Keep those little rascals safe while they climb, jump, fly and teleport-by-fish through dozens of levels in five alien worlds!\n\n{507625458961423}\n\nYou push and pull the Squishies from one side of the maze to the other, all while earning medals, gathering crystals, climbing slopes, and avoiding pitfalls.\n\n- **Explore a huge universe** - Across dozens of levels in five different worlds.\n- **Collectibles and Achievements** - Gather all the crystals, beat the clock or find the hidden egg in each level.\n- **Level Editor** - Squishies really comes into its own with its innovative, fully featured creation tools.\n- **Community Section** - Share your creation with others and play their ingenious levels.\n- **Limited play space?** Need to keep an eye on your own little monsters?  You\u2019re in luck. Squishies\u00ae can be played in the newly added Mixed Reality mode!\n\n\n{482757334822594}", "short_description": "Help the stranded Squishies find their way back home! Push and pull them through challenging puzzles, or create your own levels with the powerful in-game editor and share them with the community."}]}, "developer_name": null, "developer_privacy_policy_url": "https://brainseed-factory.com/law/privacy_products/index.php", "developer_terms_of_service_url": "https://brainseed-factory.com/law/terms_products/index.php", "publishe
uluscdn.com/v/t64.5771-25/75322598_1145165853836223_6864148320373849862_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tLtUgsUHcNwQ7kNvwGEDYrY&_nc_oc=AdodAQNnDm-st4tqNydtu_wh-Jh-r1LMraqW9piGx2Jxh5abyFf3Djky4J9-LsnP1r4&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfysdA91jqBa99fv1ON6zxq4hPkUYpNHRF5EFUa--EjEEA&oe=69CFA243"}, {"file_name": "Screenshot03.png", "id": "598340872572801", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39001670_598340875906134_7078948835759736288_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bVocKCG3FzcQ7kNvwHUTW-x&_nc_oc=Adpi4Y37_QXtjVgtTxyrmVx0UzlKqhwoQ_MkKfDeNBqJ6WqXzuPNsqbVDlLHCt4ogCk&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxPYFu9iEzAu6s9rpREQuhE37kxhKRCyquckdVgU0l86A&oe=69CFA04B"}, {"file_name": "Screenshot06.png", "id": "970563445094246", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39031450_970563448427579_1896364834470325490_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5B0NtDz82f0Q7kNvwFz8B_k&_nc_oc=Adp9Mt-mgeoUYLpdE7MDDYxHTg2edDG9jYLak9x7fOOpR6bnCuxhFoyxXpQ1VArh6TY&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Afwl0n1k0kAa5vdX6rvTNrOLQ-vxES1K3SjLx3co4QcwhA&oe=69CFBFD2"}, {"file_name": "Screenshot04.png", "id": "575729695062740", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39031400_575729698396073_2621336866475747103_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zvUCgvEAD4AQ7kNvwF44sIe&_nc_oc=Adp6RIFFMMrDHTAKK_edAwtA0xwTbMvaSa-mR3F6vUfbkTu1EUPQ2O56vqqCjJe4znc&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwafiFkgVkSQf66b7FmRR6kKezo6GoXfJ8vzmN-k_ZLqA&oe=69CFC6DC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Gameplay Trailer Thumb.png", "id": "605202028847932", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974836_605202032181265_2417977283558520499_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4OaX-7ZOiREQ7kNvwH2VaCI&_nc_oc=AdpwHZBh4MUB7kuJbTiij1UNWmztUaggmwmbq2MZmHN9iYjq4h6_xV_fcQfT40bG0EU&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyRLhuO8N1yf8OKj-LBcNeMZQoI1LT2lfc3llLtvsyzjA&oe=69CFCE99"}, "display_name": "Squishies - Roll them Home!", "keywords": ["puzzle", "platformer", "sandbox", "exploration", "adventure"], "long_description": "**Get lost in the Squishies-verse!**\n\nSquishies is a head-scratching puzzle platformer where you guide courageous and cute creatures through a series of increasingly hazardous, challenging mazes. Use unique motion controls to push and pull the Squishies through their adventures in a colorful universe full of strange flora and fauna. Keep those little rascals safe while they climb, jump, fly and teleport-by-fish through dozens of levels in five alien worlds!\n\n{507625458961423}\n\nYou push and pull the Squishies from one side of the maze to the other, all while earning medals, gathering crystals, climbing slopes, and avoiding pitfalls.\n\n- **Explore a huge universe** - Across dozens of levels in five different worlds.\n- **Collectibles and Achievements** - Gather all the crystals, beat the clock or find the hidden egg in each level.\n- **Level Editor** - Squishies really comes into its own with its innovative, fully featured creation tools.\n- **Community Section** - Share your creation with others and play their ingenious levels.\n- **Limited play space?** Need to keep an eye on your own little monsters?  You\u2019re in luck. Squishies\u00ae can be played in the newly added Mixed Reality mode!\n\n\n{482757334822594}", "short_description": "Help the stranded Squishies find their way back home! Push and pull them through challenging puzzles, or create your own levels with the powerful in-game editor and share them with the community."}]}, "developer_name": null, "developer_privacy_policy_url": "https://brainseed-factory.com/law/privacy_products/index.php", "developer_terms_of_service_url": "https://brainseed-factory.com/law/terms_products/index.php", "publisher
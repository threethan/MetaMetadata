uluscdn.com/v/t64.5771-25/75322598_1145165853836223_6864148320373849862_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cm0Vyk3De-kQ7kNvwEf5LR9&_nc_oc=Ado51UBKdHD6tvu5anQfKtzf3ZFVv08jKMNhimtkP1kaJs3m60fOVIftcR8iOSxFyTw&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5kd12uOJb6lPTdOClcyx6DbFLJtYijr6u1OiOUf4Be4Q&oe=6A0F2283"}, {"file_name": "Screenshot03.png", "id": "598340872572801", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39001670_598340875906134_7078948835759736288_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xA0iNNeg_YMQ7kNvwFs-NGq&_nc_oc=AdowzGHrrQ98Mo9rv772Sefz4DRJDb7C2ai7BEVJi5mrw7ZztpTLT1dHAWG5karywSs&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7uHHR2S_l_PEDdrVrv5mQe9VTsolg_LwCqQmEnZTEILw&oe=6A0F208B"}, {"file_name": "Screenshot06.png", "id": "970563445094246", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/39031450_970563448427579_1896364834470325490_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-5eKnnlfdmQQ7kNvwFziu3e&_nc_oc=AdrDmDMFbmCMvt02jWz11Pxdf44tf6ehqaHGTXmC5P6fgpd9PxR46tdELCL54BSDjBQ&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4yJUCsHcIluftV4jFqIXiulaFe-hkEsobEVZPPecLjSg&oe=6A0F07D2"}, {"file_name": "Screenshot04.png", "id": "575729695062740", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39031400_575729698396073_2621336866475747103_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9-JIJSe21uUQ7kNvwF25ENY&_nc_oc=AdrpsUk9OrV18zqlHOh9_C_vO-TfKHeu4ITI3Sf6cz0vx5IiI8hpXd8V0Xxt1F1gnHs&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6iTQVmBISPFCOw7fQuMMwPdg7t38VZX0C8-C2oIhFm2Q&oe=6A0F0EDC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Gameplay Trailer Thumb.png", "id": "605202028847932", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974836_605202032181265_2417977283558520499_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XG5XwIDD3dMQ7kNvwFR-f-Y&_nc_oc=AdovcnwT2vTTT1zu2bSEavmnAVEGV4Gcp52OloAx7hsmfoPBLfXnoepglv9i3SUk2Os&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af41F-rwPGbzXzH0ieCiQv1Znk7dcTpWLbO4Yk5hsOueEw&oe=6A0F1699"}, "display_name": "Squishies - Roll them Home!", "keywords": ["puzzle", "platformer", "sandbox", "exploration", "adventure"], "long_description": "**Get lost in the Squishies-verse!**\n\nSquishies is a head-scratching puzzle platformer where you guide courageous and cute creatures through a series of increasingly hazardous, challenging mazes. Use unique motion controls to push and pull the Squishies through their adventures in a colorful universe full of strange flora and fauna. Keep those little rascals safe while they climb, jump, fly and teleport-by-fish through dozens of levels in five alien worlds!\n\n{507625458961423}\n\nYou push and pull the Squishies from one side of the maze to the other, all while earning medals, gathering crystals, climbing slopes, and avoiding pitfalls.\n\n- **Explore a huge universe** - Across dozens of levels in five different worlds.\n- **Collectibles and Achievements** - Gather all the crystals, beat the clock or find the hidden egg in each level.\n- **Level Editor** - Squishies really comes into its own with its innovative, fully featured creation tools.\n- **Community Section** - Share your creation with others and play their ingenious levels.\n- **Limited play space?** Need to keep an eye on your own little monsters?  You\u2019re in luck. Squishies\u00ae can be played in the newly added Mixed Reality mode!\n\n\n{482757334822594}", "short_description": "Help the stranded Squishies find their way back home! Push and pull them through challenging puzzles, or create your own levels with the powerful in-game editor and share them with the community."}]}, "developer_name": null, "developer_privacy_policy_url": "https://brainseed-factory.com/law/privacy_products/index.php", "developer_terms_of_service_url": "https://brainseed-factory.com/law/terms_products/index.php", "publisher
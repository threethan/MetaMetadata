culuscdn.com/v/t64.5771-25/75322598_1145165853836223_6864148320373849862_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r4jdcIXyxJEQ7kNvwE6Ns1k&_nc_oc=AdrkATws4GchkP55BCAGiD6O9tIC2QtnHMA898_YsNAAwu9fRWWu4bqDA1eNiB0fTfE&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBi4FxnpDau072GjJwfXMTNgXaz1trJd1akLL7NnWLpjw&oe=6A53B083"}, {"file_name": "Screenshot03.png", "id": "598340872572801", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/39001670_598340875906134_7078948835759736288_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Em1aOzU_QlkQ7kNvwHVWyTg&_nc_oc=AdqpSL1ry0RJIwDWZtjVLZK8h4BHTCsCvy3bua9mVEND-khtxdn9pNwi8wC4vXBbtpk&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAD8m9EC9JkwtVfppO7998kd7hm9MHvInILwdL-werbvQ&oe=6A53AE8B"}, {"file_name": "Screenshot06.png", "id": "970563445094246", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39031450_970563448427579_1896364834470325490_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nI5-C9xq1T0Q7kNvwEXWR7D&_nc_oc=AdoNDUXb1WedReYgmT7vgowpzjQ83nSUDtz_AOlnPbiRDDQFVoXrI_HCZ3CpVL13hBg&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBcWth8E-TC91Orm4JOaU5vpCAWbuGXd8_lg0XaIpQajw&oe=6A5395D2"}, {"file_name": "Screenshot04.png", "id": "575729695062740", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39031400_575729698396073_2621336866475747103_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Eabllj5nbbwQ7kNvwHLZz7X&_nc_oc=AdqKOkhvzMGT7TFMrYWu2CCQvCO3YnvIDruCt1QM7dnH6meKC3RJMn8JGNp5qLTrY1A&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBv2zARewKfUlK8nfaBfzM91qOdVwQGV-eVBVNNJBcJFg&oe=6A539CDC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Gameplay Trailer Thumb.png", "id": "605202028847932", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974836_605202032181265_2417977283558520499_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XF5yTFGOZ2cQ7kNvwG3CLs7&_nc_oc=AdpSV0iwNZXsqEvhrxNMIMjtt1Ho7nW1HBUcCHgSXnn8uoLy71mLu4RgDq8cDW6aGxs&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDBfMSzroi_Z0hBo0omo1vzH4N1x3NLSoscIFn-ZJieEQ&oe=6A53A499"}, "display_name": "Squishies - Roll them Home!", "keywords": ["puzzle", "platformer", "sandbox", "exploration", "adventure"], "long_description": "**Get lost in the Squishies-verse!**\n\nSquishies is a head-scratching puzzle platformer where you guide courageous and cute creatures through a series of increasingly hazardous, challenging mazes. Use unique motion controls to push and pull the Squishies through their adventures in a colorful universe full of strange flora and fauna. Keep those little rascals safe while they climb, jump, fly and teleport-by-fish through dozens of levels in five alien worlds!\n\n{507625458961423}\n\nYou push and pull the Squishies from one side of the maze to the other, all while earning medals, gathering crystals, climbing slopes, and avoiding pitfalls.\n\n- **Explore a huge universe** - Across dozens of levels in five different worlds.\n- **Collectibles and Achievements** - Gather all the crystals, beat the clock or find the hidden egg in each level.\n- **Level Editor** - Squishies really comes into its own with its innovative, fully featured creation tools.\n- **Community Section** - Share your creation with others and play their ingenious levels.\n- **Limited play space?** Need to keep an eye on your own little monsters?  You\u2019re in luck. Squishies\u00ae can be played in the newly added Mixed Reality mode!\n\n\n{482757334822594}", "short_description": "Help the stranded Squishies find their way back home! Push and pull them through challenging puzzles, or create your own levels with the powerful in-game editor and share them with the community."}]}, "developer_name": null, "developer_privacy_policy_url": "https://brainseed-factory.com/law/privacy_products/index.php", "developer_terms_of_service_url": "https://brainseed-factory.com/law/terms_products/index.php", "publishe
uluscdn.com/v/t64.5771-25/75322598_1145165853836223_6864148320373849862_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SUC0X-qKrMMQ7kNvwFuQ6yN&_nc_oc=Adqb0Vz2cqkf6oRCzlCDzJR2lysA3Q5aadK5vXy27dWP_ERv3j3nOhDrn6t7QzOALJA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyrlymxeHh2kRciOpKeQUpnhLKGeZFJU6px9dTKdqUHrQ&oe=69C90AC3"}, {"file_name": "Screenshot03.png", "id": "598340872572801", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39001670_598340875906134_7078948835759736288_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i9dQgtfHg3EQ7kNvwHwzbc9&_nc_oc=Adqtm_bm8tPtHTv-DOLn-iuQkIOzGry3WGFA6hS9cNY7MPD5y9_vjFfnTmqMcVACzdE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzURsEuQFCktV_aAnF9LXU5BN_6g9DSxRv3EjBRQ2q53A&oe=69C908CB"}, {"file_name": "Screenshot06.png", "id": "970563445094246", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031450_970563448427579_1896364834470325490_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PzWgm7oXRywQ7kNvwFQpmgw&_nc_oc=AdpAJYc1BhApmUFK5NqnUvE4ADfhp9mRbTmYKr3newJ-ljAXxyS9GmnRccNGRWd1m3o&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afz8TIazViYf1uQQctZcveEElm49XirqpCntXjdatJQhbQ&oe=69C92852"}, {"file_name": "Screenshot04.png", "id": "575729695062740", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031400_575729698396073_2621336866475747103_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OeQ6gvN4zLoQ7kNvwGuKf1V&_nc_oc=Adr7VGGnm-B362eiFyiTStfU3zOFBiUVaGmn-2eXVgFBEr7QOjwlXhdHxXentoDYEXs&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwpidtjYRpKK95I94cu40brPVJp35A4zW9-TXqbwcUK5w&oe=69C92F5C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Gameplay Trailer Thumb.png", "id": "605202028847932", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974836_605202032181265_2417977283558520499_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9h5j0uPaU1MQ7kNvwGAm03h&_nc_oc=AdpzhmbNx9C6HUpuJEKPrI3YTxblacMFZPeCKxpVjGVN_1j7CQ4kvHL8ymmUhdtT7DM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afw_eIKRb5R4p4DHnV7IyLfK9XYTldaMX26vm2gBIkJkhw&oe=69C93719"}, "display_name": "Squishies - Roll them Home!", "keywords": ["puzzle", "platformer", "sandbox", "exploration", "adventure"], "long_description": "**Get lost in the Squishies-verse!**\n\nSquishies is a head-scratching puzzle platformer where you guide courageous and cute creatures through a series of increasingly hazardous, challenging mazes. Use unique motion controls to push and pull the Squishies through their adventures in a colorful universe full of strange flora and fauna. Keep those little rascals safe while they climb, jump, fly and teleport-by-fish through dozens of levels in five alien worlds!\n\n{507625458961423}\n\nYou push and pull the Squishies from one side of the maze to the other, all while earning medals, gathering crystals, climbing slopes, and avoiding pitfalls.\n\n- **Explore a huge universe** - Across dozens of levels in five different worlds.\n- **Collectibles and Achievements** - Gather all the crystals, beat the clock or find the hidden egg in each level.\n- **Level Editor** - Squishies really comes into its own with its innovative, fully featured creation tools.\n- **Community Section** - Share your creation with others and play their ingenious levels.\n- **Limited play space?** Need to keep an eye on your own little monsters?  You\u2019re in luck. Squishies\u00ae can be played in the newly added Mixed Reality mode!\n\n\n{482757334822594}", "short_description": "Help the stranded Squishies find their way back home! Push and pull them through challenging puzzles, or create your own levels with the powerful in-game editor and share them with the community."}]}, "developer_name": null, "developer_privacy_policy_url": "https://brainseed-factory.com/law/privacy_products/index.php", "developer_terms_of_service_url": "https://brainseed-factory.com/law/terms_products/index.php", "publisher
sin2-2.oculuscdn.com/v/t64.5771-25/75322598_1145165853836223_6864148320373849862_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bikVnaO7HIYQ7kNvwGQnsnd&_nc_oc=AdoVxfHL-RSn8R10SlENQTM0qg1htZu5_mTaaOceNymDDgbpzHwmxAhzi2SBcLkn_JQ&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFLH12uzMJn1F4UqpGBhs5rWMsm3WjdJ5lNTJNcb-8MdQ&oe=6A7DA843"}, {"file_name": "Screenshot03.png", "id": "598340872572801", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/39001670_598340875906134_7078948835759736288_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8pUiPsO3aC0Q7kNvwEbaXe0&_nc_oc=AdrMspAwf7D0Bwabk-7Nzyq6wlKG7C5UpAk3gjR8J_RqllwG9Xs_yJyxlpbD3qozkT4&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEKLjK_GOqXj7kNoV-WJHUQ5Fzvi01DbWc9pYRn6z1ERw&oe=6A7DA64B"}, {"file_name": "Screenshot06.png", "id": "970563445094246", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/39031450_970563448427579_1896364834470325490_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Yuik2GonodwQ7kNvwHoQdrx&_nc_oc=AdoGi8Sq0d37QWSx6oKXSQiiFP9lk09w91JrfYUKRHRrE2J3QWBlAapi0cLwc9rW_2Q&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGLdttYAwCITiTI3OgLuCayvwOECukQC65FGqh0L8b8cQ&oe=6A7DC5D2"}, {"file_name": "Screenshot04.png", "id": "575729695062740", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/39031400_575729698396073_2621336866475747103_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PnE6JA-LVYEQ7kNvwEMu0uC&_nc_oc=Adq8ftGwvvvUBZ4ylnp9IEaPIbrg0DlLw7CITfrV3t_d3AqH1ehELEuSeUAnw-ZJ-gg&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFnEQrsar41RRh5O1Sjh9p8RuydFwya2iG5kyWvfg-e0g&oe=6A7DCCDC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Gameplay Trailer Thumb.png", "id": "605202028847932", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/38974836_605202032181265_2417977283558520499_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I_wFZ3tZBNcQ7kNvwGA4iI9&_nc_oc=AdrytAbYsKM2OKzTBB3cHsolSSga0c-J9MQ3-OIe4sBe_IoMnfBW0nFuM02FuKSUX4I&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGkzKBYe4BoJysRPKo0wkyh9sT5KRqlM4PPqmZ8j2MaxQ&oe=6A7D9C59"}, "display_name": "Squishies - Roll them Home!", "keywords": ["puzzle", "platformer", "sandbox", "exploration", "adventure"], "long_description": "**Get lost in the Squishies-verse!**\n\nSquishies is a head-scratching puzzle platformer where you guide courageous and cute creatures through a series of increasingly hazardous, challenging mazes. Use unique motion controls to push and pull the Squishies through their adventures in a colorful universe full of strange flora and fauna. Keep those little rascals safe while they climb, jump, fly and teleport-by-fish through dozens of levels in five alien worlds!\n\n{507625458961423}\n\nYou push and pull the Squishies from one side of the maze to the other, all while earning medals, gathering crystals, climbing slopes, and avoiding pitfalls.\n\n- **Explore a huge universe** - Across dozens of levels in five different worlds.\n- **Collectibles and Achievements** - Gather all the crystals, beat the clock or find the hidden egg in each level.\n- **Level Editor** - Squishies really comes into its own with its innovative, fully featured creation tools.\n- **Community Section** - Share your creation with others and play their ingenious levels.\n- **Limited play space?** Need to keep an eye on your own little monsters?  You\u2019re in luck. Squishies\u00ae can be played in the newly added Mixed Reality mode!\n\n\n{482757334822594}", "short_description": "Help the stranded Squishies find their way back home! Push and pull them through challenging puzzles, or create your own levels with the powerful in-game editor and share them with the community."}]}, "developer_name": null, "developer_privacy_policy_url": "https://brainseed-factory.com/law/privacy_products/index.php", "developer_terms_of_service_url": "https://brainseed-factory.com/law/terms_products/index.php
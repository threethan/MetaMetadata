uluscdn.com/v/t64.5771-25/75322598_1145165853836223_6864148320373849862_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ruWkw3hhShoQ7kNvwGQEoXK&_nc_oc=AdrOJhvKiVrAO3jGnT8qmrWT0Oq2kV1_jg6-VJDc5Xe2W8Ef4ED1AD3LnZL6yP11Ur8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afxk3YOEbRMioCfMu6tP8yNR-3yJzfslkkuqHlwr-HSMaQ&oe=69CA5C43"}, {"file_name": "Screenshot03.png", "id": "598340872572801", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39001670_598340875906134_7078948835759736288_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tgxJWhe4GZwQ7kNvwFj1FYc&_nc_oc=AdqGdAe32F5-UvKsoPojhiC13NWUK59zdg4cbZO221Kf52LVNboZKrk7hCDyPdOR0Lw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxqFkagFfDqR5Q0WFm3S1ib0HLkKumcUpK1dinhtTLU3g&oe=69CA5A4B"}, {"file_name": "Screenshot06.png", "id": "970563445094246", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031450_970563448427579_1896364834470325490_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J3OFi8zLH-sQ7kNvwFAnXFk&_nc_oc=AdrhFftDGBYbypdBNl2rzFcKjMuAYj-ywbb4wDwDqXgbhrnPImT1Ok8hAV88Npr6rjc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzPVOkWlV5yIK_qKUFQC_PB_g2YKjk3yFmq-AqtYKXKyg&oe=69CA79D2"}, {"file_name": "Screenshot04.png", "id": "575729695062740", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031400_575729698396073_2621336866475747103_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OeQ6gvN4zLoQ7kNvwGIsxUB&_nc_oc=Adp5t44UjEBLaSc9UQ2GPxp4ThLbG7eOoZ8nr0obsWqwW4rEM-eKbT0xaAvTxg-a9uA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afx5OL_pOCYfpUGYW-uu3hTVpjvwlT6kAYaocTMxASf9fg&oe=69CA80DC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Gameplay Trailer Thumb.png", "id": "605202028847932", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974836_605202032181265_2417977283558520499_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9h5j0uPaU1MQ7kNvwEUtfZ5&_nc_oc=AdrNTSdwsRRHBpxCqUGVHQKB0H5n-XYjnjhtqFRX3WxVR-4HezbFQRgy6llRs_d9dmU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfySCTWhDWhpkxX4btLgarBug4DIVa0ku1MormKUz-51Lw&oe=69CA8899"}, "display_name": "Squishies - Roll them Home!", "keywords": ["puzzle", "platformer", "sandbox", "exploration", "adventure"], "long_description": "**Get lost in the Squishies-verse!**\n\nSquishies is a head-scratching puzzle platformer where you guide courageous and cute creatures through a series of increasingly hazardous, challenging mazes. Use unique motion controls to push and pull the Squishies through their adventures in a colorful universe full of strange flora and fauna. Keep those little rascals safe while they climb, jump, fly and teleport-by-fish through dozens of levels in five alien worlds!\n\n{507625458961423}\n\nYou push and pull the Squishies from one side of the maze to the other, all while earning medals, gathering crystals, climbing slopes, and avoiding pitfalls.\n\n- **Explore a huge universe** - Across dozens of levels in five different worlds.\n- **Collectibles and Achievements** - Gather all the crystals, beat the clock or find the hidden egg in each level.\n- **Level Editor** - Squishies really comes into its own with its innovative, fully featured creation tools.\n- **Community Section** - Share your creation with others and play their ingenious levels.\n- **Limited play space?** Need to keep an eye on your own little monsters?  You\u2019re in luck. Squishies\u00ae can be played in the newly added Mixed Reality mode!\n\n\n{482757334822594}", "short_description": "Help the stranded Squishies find their way back home! Push and pull them through challenging puzzles, or create your own levels with the powerful in-game editor and share them with the community."}]}, "developer_name": null, "developer_privacy_policy_url": "https://brainseed-factory.com/law/privacy_products/index.php", "developer_terms_of_service_url": "https://brainseed-factory.com/law/terms_products/index.php", "publisher
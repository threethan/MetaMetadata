culuscdn.com/v/t64.5771-25/75322598_1145165853836223_6864148320373849862_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bikVnaO7HIYQ7kNvwFWwztC&_nc_oc=AdoeCLzgWAn5UBYzxbrcNnPb8hG7KMPvP4e97PwOY8weAy9MGWGSAedmj0TIW3Tvv2A&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEoEDmYW5Yhr5XA6oiCljurifOzlOZ7Io861KiIIWS3YA&oe=6A7EF9C3"}, {"file_name": "Screenshot03.png", "id": "598340872572801", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39001670_598340875906134_7078948835759736288_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8pUiPsO3aC0Q7kNvwEX4nUh&_nc_oc=AdqTIACqTpkHD1457FtNHA3tJjGyKsngQmW4KaWEpUM7V2EU6IXxsFPQnMpr6OkLbKM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHLxR8tbZjKPz9jGtZUzWKhYXbJ-0T3zkUBwIUBx1gLcw&oe=6A7EF7CB"}, {"file_name": "Screenshot06.png", "id": "970563445094246", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031450_970563448427579_1896364834470325490_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Yuik2GonodwQ7kNvwGOs0WX&_nc_oc=AdobVb9DYtIOUpwPMGMiecEyfzvIE-tmGhSQIsEaAmvsbeVPNV_gSQPxIMSvteP77q4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFHJhG-gpR1u5k2PefbjiAKrFOED7V6ejNUub3heSybpg&oe=6A7F1752"}, {"file_name": "Screenshot04.png", "id": "575729695062740", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031400_575729698396073_2621336866475747103_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PnE6JA-LVYEQ7kNvwF7HKpB&_nc_oc=AdrwdjHv5EZMegsXwQsi1PRaOPslZdNkYx4BWmhyrwrgOw7OCGkVG8vLrXetF0EilkM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFAgUzvsBrAZKtxWI7EIkMaXtKhC1fn77i-WeZAu9Ocmw&oe=6A7F1E5C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Gameplay Trailer Thumb.png", "id": "605202028847932", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974836_605202032181265_2417977283558520499_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T9gYHRIPezUQ7kNvwHoXNel&_nc_oc=Ado76i8UjgUtgpwGPsXY-hvGY_Duav2pFAS84679LoovXDU1XPfnrAjJwm-3cQFeHFM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHVLAM-Mw5a8z2OJe1jiQBSlg1G_Nh47FlyB_sedVAyUg&oe=6A7F2619"}, "display_name": "Squishies - Roll them Home!", "keywords": ["puzzle", "platformer", "sandbox", "exploration", "adventure"], "long_description": "**Get lost in the Squishies-verse!**\n\nSquishies is a head-scratching puzzle platformer where you guide courageous and cute creatures through a series of increasingly hazardous, challenging mazes. Use unique motion controls to push and pull the Squishies through their adventures in a colorful universe full of strange flora and fauna. Keep those little rascals safe while they climb, jump, fly and teleport-by-fish through dozens of levels in five alien worlds!\n\n{507625458961423}\n\nYou push and pull the Squishies from one side of the maze to the other, all while earning medals, gathering crystals, climbing slopes, and avoiding pitfalls.\n\n- **Explore a huge universe** - Across dozens of levels in five different worlds.\n- **Collectibles and Achievements** - Gather all the crystals, beat the clock or find the hidden egg in each level.\n- **Level Editor** - Squishies really comes into its own with its innovative, fully featured creation tools.\n- **Community Section** - Share your creation with others and play their ingenious levels.\n- **Limited play space?** Need to keep an eye on your own little monsters?  You\u2019re in luck. Squishies\u00ae can be played in the newly added Mixed Reality mode!\n\n\n{482757334822594}", "short_description": "Help the stranded Squishies find their way back home! Push and pull them through challenging puzzles, or create your own levels with the powerful in-game editor and share them with the community."}]}, "developer_name": null, "developer_privacy_policy_url": "https://brainseed-factory.com/law/privacy_products/index.php", "developer_terms_of_service_url": "https://brainseed-factory.com/law/terms_products/index.php", "publishe
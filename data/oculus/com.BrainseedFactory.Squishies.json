culuscdn.com/v/t64.5771-25/75322598_1145165853836223_6864148320373849862_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4LIzUb7hXfYQ7kNvwGsYPAn&_nc_oc=AdoeKNRvGpotLX3z-Ro7E2QnUytpbK31BLVweXFf01flu70H7by688f_mYDv9Pis2fg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLj4-7bNJKeIGlKlHD1mW3-7iT5RVWexTDBwhzExQdLeA&oe=6AB93403"}, {"file_name": "Screenshot03.png", "id": "598340872572801", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39001670_598340875906134_7078948835759736288_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h293hKyL7zAQ7kNvwHHSB8p&_nc_oc=AdqiNLPURe25-3Dp5Jwkgy-1S1wMysjUSMChRq7biUSQcP9Tnie9X4VbHsZviPzjadQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLbmKaMh28guMbQKuxIZ0PgmdPrOVO1JaXTo37ra9anFA&oe=6AB9320B"}, {"file_name": "Screenshot06.png", "id": "970563445094246", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031450_970563448427579_1896364834470325490_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F6tdJ848B2AQ7kNvwFDs6dy&_nc_oc=AdpRr5leMDVbU61RtIcmhD-35CXZAyzCxkFUswTn_wNlMXtAWFnIXiIol98NwI7gLug&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ38wQaTvEQ7j8u0DVxiDnb6sat-MbLRvX0SzoRblZJbQ&oe=6AB91952"}, {"file_name": "Screenshot04.png", "id": "575729695062740", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031400_575729698396073_2621336866475747103_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Dpu2jmwcvTwQ7kNvwFaAXBa&_nc_oc=AdrnnkdduHNrc9ozYikpyavOxKvaNTdgueQPXbPN8BXOV_iyOINJEKMbNh4c-R1cvK8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQITzfrnRzWc6JIPJhfp6aP8Sc5syfDXwFE9uRoShR7OXw&oe=6AB9205C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Gameplay Trailer Thumb.png", "id": "605202028847932", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974836_605202032181265_2417977283558520499_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=p5R1Ka3e8FcQ7kNvwE8WG5b&_nc_oc=AdoHRKMtIfFvsDkPud_ceq-0Bp7JjsYWDMKCOag9vQqlrkoox7JiE7tcPzLrYc0_x1k&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLSdd6VM7WliVgFQphORLzd9-uq_5ZfmZXvgPCZ_XE2xQ&oe=6AB92819"}, "display_name": "Squishies - Roll them Home!", "keywords": ["puzzle", "platformer", "sandbox", "exploration", "adventure"], "long_description": "**Get lost in the Squishies-verse!**\n\nSquishies is a head-scratching puzzle platformer where you guide courageous and cute creatures through a series of increasingly hazardous, challenging mazes. Use unique motion controls to push and pull the Squishies through their adventures in a colorful universe full of strange flora and fauna. Keep those little rascals safe while they climb, jump, fly and teleport-by-fish through dozens of levels in five alien worlds!\n\n{507625458961423}\n\nYou push and pull the Squishies from one side of the maze to the other, all while earning medals, gathering crystals, climbing slopes, and avoiding pitfalls.\n\n- **Explore a huge universe** - Across dozens of levels in five different worlds.\n- **Collectibles and Achievements** - Gather all the crystals, beat the clock or find the hidden egg in each level.\n- **Level Editor** - Squishies really comes into its own with its innovative, fully featured creation tools.\n- **Community Section** - Share your creation with others and play their ingenious levels.\n- **Limited play space?** Need to keep an eye on your own little monsters?  You\u2019re in luck. Squishies\u00ae can be played in the newly added Mixed Reality mode!\n\n\n{482757334822594}", "short_description": "Help the stranded Squishies find their way back home! Push and pull them through challenging puzzles, or create your own levels with the powerful in-game editor and share them with the community."}]}, "developer_name": null, "developer_privacy_policy_url": "https://brainseed-factory.com/law/privacy_products/index.php", "developer_terms_of_service_url": "https://brainseed-factory.com/law/terms_products/index.php", "publishe
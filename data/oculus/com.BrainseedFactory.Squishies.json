culuscdn.com/v/t64.5771-25/75322598_1145165853836223_6864148320373849862_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z7Y8rVMQEBYQ7kNvwHGQCj2&_nc_oc=AdpYYuCVMql5Xo4hr7SxBg0Q0wF4jYerJ5rvr6_tnxe4_uHO9EOVsD0ZlbCwWbb5DC0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQClb0j3_9XlgqxJPagtwPKn1TUIgD_ibe5mI_7MomEZrw&oe=6A69E1C3"}, {"file_name": "Screenshot03.png", "id": "598340872572801", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39001670_598340875906134_7078948835759736288_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4ypR9EgrLc4Q7kNvwE3j6Sz&_nc_oc=Ado9gQ21IquYd9EkSPlNbBD_qVsmfX7IKYsiInyg6ziM1RYzIBxk3RcMoS7_YWFyrKs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBCTzEQOYJMluZy2WNGu3RRArQmakih2tydDKAqbrGpfA&oe=6A6A180B"}, {"file_name": "Screenshot06.png", "id": "970563445094246", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031450_970563448427579_1896364834470325490_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Pv2b0kSnjQQQ7kNvwEQbKjH&_nc_oc=AdrudFRpAJgo7876LM4zS_WAoiyCtKMEnJaRVIpiZiIrN014te17pvzw8IHXiXahIdY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQABQvMv3E8shxAP6hIgbOt7XpJOfNHT1ab_1hBA2s4Gqw&oe=6A69FF52"}, {"file_name": "Screenshot04.png", "id": "575729695062740", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031400_575729698396073_2621336866475747103_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sGt9prImytYQ7kNvwFtzGpv&_nc_oc=Adr20Zd-mx2tIqXFpWkjpVUENC9SMQg0OrgOTdsqo-cEjZENpcGv-bs3E9DE0n-uemk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAp_Hk1kXuTH06iCntPntG0EuGdTdfganokFPIaEqBzyQ&oe=6A6A065C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Gameplay Trailer Thumb.png", "id": "605202028847932", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974836_605202032181265_2417977283558520499_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3UQEzI4rMLoQ7kNvwF5v0Nn&_nc_oc=AdrYqWI23O7zsKU_zOWTYmwZthM11Kz9yazDWxezydB4Jfw0h2lY3JrRptZfC6R-iOs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBvPv8dtKrKwR_nrXhiovL1sitW0l-9CePBuoyyPWmFQw&oe=6A6A0E19"}, "display_name": "Squishies - Roll them Home!", "keywords": ["puzzle", "platformer", "sandbox", "exploration", "adventure"], "long_description": "**Get lost in the Squishies-verse!**\n\nSquishies is a head-scratching puzzle platformer where you guide courageous and cute creatures through a series of increasingly hazardous, challenging mazes. Use unique motion controls to push and pull the Squishies through their adventures in a colorful universe full of strange flora and fauna. Keep those little rascals safe while they climb, jump, fly and teleport-by-fish through dozens of levels in five alien worlds!\n\n{507625458961423}\n\nYou push and pull the Squishies from one side of the maze to the other, all while earning medals, gathering crystals, climbing slopes, and avoiding pitfalls.\n\n- **Explore a huge universe** - Across dozens of levels in five different worlds.\n- **Collectibles and Achievements** - Gather all the crystals, beat the clock or find the hidden egg in each level.\n- **Level Editor** - Squishies really comes into its own with its innovative, fully featured creation tools.\n- **Community Section** - Share your creation with others and play their ingenious levels.\n- **Limited play space?** Need to keep an eye on your own little monsters?  You\u2019re in luck. Squishies\u00ae can be played in the newly added Mixed Reality mode!\n\n\n{482757334822594}", "short_description": "Help the stranded Squishies find their way back home! Push and pull them through challenging puzzles, or create your own levels with the powerful in-game editor and share them with the community."}]}, "developer_name": null, "developer_privacy_policy_url": "https://brainseed-factory.com/law/privacy_products/index.php", "developer_terms_of_service_url": "https://brainseed-factory.com/law/terms_products/index.php", "publishe
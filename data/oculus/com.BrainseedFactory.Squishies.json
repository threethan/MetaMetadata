culuscdn.com/v/t64.5771-25/75322598_1145165853836223_6864148320373849862_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VY4InZEFQPYQ7kNvwHkdhMj&_nc_oc=Ado8Gzq-P0PvmF8PyUIwInh8WEsNitXe8LtuC9e5m3KsRwy6_AKUQB0Tl4m3YnxLMF4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIj5FRuV2H49ySExkVf-ONyOCiyiT3kGNyfFBXBb7c8tg&oe=6AAFF983"}, {"file_name": "Screenshot03.png", "id": "598340872572801", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39001670_598340875906134_7078948835759736288_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UTR4V1vqffsQ7kNvwGlv-zr&_nc_oc=AdoA--Sq7jUOhJbpbepeL6CdCmiAEFZgsAI-ev2TqT0tbXTEQXuUMAZNLGGjBSzFxlQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLA-uMuRXmyvcAe8mdKZ0MoDtLQ8Wzh_ndad1QkC92Pdg&oe=6AAFF78B"}, {"file_name": "Screenshot06.png", "id": "970563445094246", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031450_970563448427579_1896364834470325490_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=81FZ3O0ieg4Q7kNvwERvo50&_nc_oc=AdpjBal6OHAVZvw5AJmWHloVAWX_nyCAJzoh3ASfvZo8MYTDxmsOIyxxd-pl_5JxNbg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLvxcEA7Wd_dKFUUEShmdWEJ29CMgWKxpKBz2QvEKl6TQ&oe=6AAFDED2"}, {"file_name": "Screenshot04.png", "id": "575729695062740", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031400_575729698396073_2621336866475747103_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WzRVxRvQRSAQ7kNvwH8w4Ri&_nc_oc=AdrmPLoC6z-amPPggs2MD4xpSQmgx3IJ0_yZtmnjb2Jljt_Or-JVLuhhqizL0OeV9N8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL_kDz-ZJM_xCoSP9I17X3A-_HDVOHoL0pO6B-3QP-ErA&oe=6AAFE5DC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Gameplay Trailer Thumb.png", "id": "605202028847932", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974836_605202032181265_2417977283558520499_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hD_trbhLLYsQ7kNvwEPn054&_nc_oc=Adqtcywf0ROfhyUAevoM5xUeSL2zEY2FzwQXCDSft5_gDF321irkgTbMpOFh23531TQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKB0APisG5o_kV7B9dBHOzA85Ol7IHS55AwGysTmEwpcQ&oe=6AAFED99"}, "display_name": "Squishies - Roll them Home!", "keywords": ["puzzle", "platformer", "sandbox", "exploration", "adventure"], "long_description": "**Get lost in the Squishies-verse!**\n\nSquishies is a head-scratching puzzle platformer where you guide courageous and cute creatures through a series of increasingly hazardous, challenging mazes. Use unique motion controls to push and pull the Squishies through their adventures in a colorful universe full of strange flora and fauna. Keep those little rascals safe while they climb, jump, fly and teleport-by-fish through dozens of levels in five alien worlds!\n\n{507625458961423}\n\nYou push and pull the Squishies from one side of the maze to the other, all while earning medals, gathering crystals, climbing slopes, and avoiding pitfalls.\n\n- **Explore a huge universe** - Across dozens of levels in five different worlds.\n- **Collectibles and Achievements** - Gather all the crystals, beat the clock or find the hidden egg in each level.\n- **Level Editor** - Squishies really comes into its own with its innovative, fully featured creation tools.\n- **Community Section** - Share your creation with others and play their ingenious levels.\n- **Limited play space?** Need to keep an eye on your own little monsters?  You\u2019re in luck. Squishies\u00ae can be played in the newly added Mixed Reality mode!\n\n\n{482757334822594}", "short_description": "Help the stranded Squishies find their way back home! Push and pull them through challenging puzzles, or create your own levels with the powerful in-game editor and share them with the community."}]}, "developer_name": null, "developer_privacy_policy_url": "https://brainseed-factory.com/law/privacy_products/index.php", "developer_terms_of_service_url": "https://brainseed-factory.com/law/terms_products/index.php", "publishe
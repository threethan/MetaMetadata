1-7&_nc_sid=6e7a0a&_nc_ohc=v-dFFJrccHAQ7kNvwFcpLTU&_nc_oc=AdrzSERy0GLX7jNRzqjFtnKrav-ZdGxqNCFJT_qApCbje96Oqww9-OuVQnV5Cek3iWM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRooblmHqn-2unbhPaKfj50g7gbb1_N5iihCtAavVs46Q&oe=6B06FC83"}, {"file_name": "Screenshot03.png", "id": "598340872572801", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39001670_598340875906134_7078948835759736288_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6Xos-ztkIcMQ7kNvwGZp_em&_nc_oc=AdpvhdKKTjWWF0XLp7-d3rHkK9Xeej-MwLGtnm7M095K96P-QvlAb_V6HtJF2Yfa5ME&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQjMpSSixSlcckMIS-CIk27DNlxxRK42AngpgoAbFWsxA&oe=6B06FA8B"}, {"file_name": "Screenshot06.png", "id": "970563445094246", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031450_970563448427579_1896364834470325490_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WakkcmLSAYMQ7kNvwG2q3eu&_nc_oc=Adq8cNAfQTHdrwbAyJ3M7T7Sc2lO6mA88nKp8EWe8f5joFBMkuFHTJbcUZNiOPDpeSo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS6ONBERnB0DYCDZAQk9HhDAfKVYSuBK6uEjM88orNHhw&oe=6B071A12"}, {"file_name": "Screenshot04.png", "id": "575729695062740", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031400_575729698396073_2621336866475747103_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Vivkd7VPei8Q7kNvwH0Pou2&_nc_oc=AdrDSIxa_yVk1McBOu1hn6P7gOKMfGIAfPqiLmiDGT3FCwNgwH8K6EZxWK8EIiywKfc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRQDlCp4XTF6qEHAF2P2z1Tn5tMlWFHrOte-MzJkCzo0w&oe=6B07211C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Gameplay Trailer Thumb.png", "id": "605202028847932", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974836_605202032181265_2417977283558520499_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ILqMnwOhR_QQ7kNvwGUfEhK&_nc_oc=AdrS5ZwP8VKpyjOzTe018UBSYFkGHyjxd2iVinRMD7aGddykyJkqdlhO4zw0IYUrMGg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTEN45D5kIEvcLpT_IWxU1sGm9EsiOVzy2Rzv9SkqUmBA&oe=6B0728D9"}, "display_name": "Squishies\u00ae - Roll them Home!", "keywords": ["puzzle", "platformer", "sandbox", "exploration", "adventure"], "long_description": "**Get lost in the Squishies-verse!**\n\nSquishies is a head-scratching puzzle platformer where you guide courageous and cute creatures through a series of increasingly hazardous, challenging mazes. Use unique motion controls to push and pull the Squishies through their adventures in a colorful universe full of strange flora and fauna. Keep those little rascals safe while they climb, jump, fly and teleport-by-fish through dozens of levels in five alien worlds!\n\n{507625458961423}\n\nYou push and pull the Squishies from one side of the maze to the other, all while earning medals, gathering crystals, climbing slopes, and avoiding pitfalls.\n\n- **Explore a huge universe** - Across dozens of levels in five different worlds.\n- **Collectibles and Achievements** - Gather all the crystals, beat the clock or find the hidden egg in each level.\n- **Level Editor** - Squishies really comes into its own with its innovative, fully featured creation tools.\n- **Community Section** - Share your creation with others and play their ingenious levels.\n\n\n{482757334822594}", "short_description": "Help the stranded Squishies find their way back home! Push and pull them through challenging puzzles, or create your own levels with the powerful in-game editor and share them with the community."}]}, "developer_name": null, "developer_privacy_policy_url": "https://brainseed-factory.com/law/privacy_products/index.php", "developer_terms_of_service_url": "https://brainseed-factory.com/law/terms_products/index.php", "publisher_name": "Brainseed Factory", "support_website_url": null, "website_url": "https://www.brainseed-factory.com/", "category": null, "comfort_rating": "COM
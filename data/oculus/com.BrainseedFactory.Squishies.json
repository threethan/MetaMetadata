uluscdn.com/v/t64.5771-25/75322598_1145165853836223_6864148320373849862_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yc0ZPmdGkz0Q7kNvwHSsr_X&_nc_oc=AdpW_AihsRDnAsDeCU02NCxm7klIA4Yyax1SXCCFo5RfdPI7E84i4Dp0L-jvd-J5nQA&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4yWpt51jnClPJEwEedeCelr40PODyUk2AJnxfs2gmdsg&oe=6A09DC83"}, {"file_name": "Screenshot03.png", "id": "598340872572801", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/39001670_598340875906134_7078948835759736288_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9PO6l9PC4l8Q7kNvwF58g4F&_nc_oc=AdqWBIOs3kciZ8wHRMArZVu0ewefWt1SC4KqVGeJ5YV9nUv40lBNomjjEf4O7xyvApg&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7Pwq2hPVZSFXcgM6RGa2AhvDJittQrbDxm1B7XGXOd2g&oe=6A09DA8B"}, {"file_name": "Screenshot06.png", "id": "970563445094246", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/39031450_970563448427579_1896364834470325490_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hD_kiCNPHnUQ7kNvwFyaMf4&_nc_oc=Adq54PkfuqBl8t2mQJaaCktoTeAoOrBU2wv6FeLW0xTyvnWp9fjjmHT-wtwjJqnFPsQ&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6oM1Dt08USsYKw4MS1v8C3F8Loq0F3lnXq41L5-Dp7mg&oe=6A09C1D2"}, {"file_name": "Screenshot04.png", "id": "575729695062740", "uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/39031400_575729698396073_2621336866475747103_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J7-bhhitTHIQ7kNvwFHL9bP&_nc_oc=AdrrELouCLFED4Jm-rjqJlCvdMrjeI_3PdBemqogmVmSTyCBI9FA_jWb7Y0o1ScKgQE&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4d1xsa6Q_4-Xym8KcZq_5qSUZcmfnZ8ZzcNxM0sF53MA&oe=6A09C8DC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Gameplay Trailer Thumb.png", "id": "605202028847932", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/38974836_605202032181265_2417977283558520499_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=42ztYomN1x0Q7kNvwE5CHaE&_nc_oc=AdrB6r4kARtkxUQ3d0uz_wRzNWJuuxJZZE7gm53XQiDTq9STVw-HjlK6tjqLavpUkcE&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4N-9iLeyBJ3e7x4B_8KoNgirqktF83jcafZj2AeYgEMw&oe=6A09D099"}, "display_name": "Squishies - Roll them Home!", "keywords": ["puzzle", "platformer", "sandbox", "exploration", "adventure"], "long_description": "**Get lost in the Squishies-verse!**\n\nSquishies is a head-scratching puzzle platformer where you guide courageous and cute creatures through a series of increasingly hazardous, challenging mazes. Use unique motion controls to push and pull the Squishies through their adventures in a colorful universe full of strange flora and fauna. Keep those little rascals safe while they climb, jump, fly and teleport-by-fish through dozens of levels in five alien worlds!\n\n{507625458961423}\n\nYou push and pull the Squishies from one side of the maze to the other, all while earning medals, gathering crystals, climbing slopes, and avoiding pitfalls.\n\n- **Explore a huge universe** - Across dozens of levels in five different worlds.\n- **Collectibles and Achievements** - Gather all the crystals, beat the clock or find the hidden egg in each level.\n- **Level Editor** - Squishies really comes into its own with its innovative, fully featured creation tools.\n- **Community Section** - Share your creation with others and play their ingenious levels.\n- **Limited play space?** Need to keep an eye on your own little monsters?  You\u2019re in luck. Squishies\u00ae can be played in the newly added Mixed Reality mode!\n\n\n{482757334822594}", "short_description": "Help the stranded Squishies find their way back home! Push and pull them through challenging puzzles, or create your own levels with the powerful in-game editor and share them with the community."}]}, "developer_name": null, "developer_privacy_policy_url": "https://brainseed-factory.com/law/privacy_products/index.php", "developer_terms_of_service_url": "https://brainseed-factory.com/law/terms_products/index.php", "publisher
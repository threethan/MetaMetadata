culuscdn.com/v/t64.5771-25/75322598_1145165853836223_6864148320373849862_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qsyhv_cMfo4Q7kNvwG8SSMf&_nc_oc=AdqIlnmcS0wLipIjDIcOMOpRS2y7I141gzVOi0hEIOkZidTfC5pKX6-md2Z5YcWQuHw&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGtIuoQY-kCLXAgk3ODlKDq8t0IXOImaSGL67GnsVIHMg&oe=6A8985C3"}, {"file_name": "Screenshot03.png", "id": "598340872572801", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39001670_598340875906134_7078948835759736288_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SrS0aH425XQQ7kNvwGB_eTC&_nc_oc=AdqD9_9AiVpf_BxExBMLQNXzG9IHdeXraw3UVylhoVGqnRVJBGTeNRvbp2a6XTgWVCw&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFa_O8jaQn9ayTjp5YfdCbNbEKP1ZhfPtid-8GXRK1MdQ&oe=6A8983CB"}, {"file_name": "Screenshot06.png", "id": "970563445094246", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031450_970563448427579_1896364834470325490_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z47bM7gbL3oQ7kNvwH1Uwod&_nc_oc=AdpL-GY3G6DZLh88HQE_OJgBHNDtD-WfZKwxENy0VpYzGxriUjSMUzM-I7KDDW0CA_w&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHSZ4Sk_qoFpPRXZownwbsvR2MEec7sIg8q6TSxlVJT0A&oe=6A89A352"}, {"file_name": "Screenshot04.png", "id": "575729695062740", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39031400_575729698396073_2621336866475747103_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5K3wm761ljcQ7kNvwFai-rB&_nc_oc=Adp5CGOtotMUV0SEaq9Jwm5LgOw0ksMxhy6fPOkUXhWQBSGWAL26pLObMLZzA2bvvro&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHmSnYj05IHNt_9xZtH39um-Sejn4N102zc7J3cwC09Gg&oe=6A89721C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Gameplay Trailer Thumb.png", "id": "605202028847932", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974836_605202032181265_2417977283558520499_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MuQtpqQ1IxQQ7kNvwH1T-6X&_nc_oc=AdqZX5W-GPLB7uuI-qihx__fBT3YET6S7v4Y16qZIyTcGIMMTcmVQ0Isgegjkr8878w&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEU7A3f3H9W5PFcg6oGT9eKtAIuYQCRaFFrkyO2VvOyJA&oe=6A8979D9"}, "display_name": "Squishies - Roll them Home!", "keywords": ["puzzle", "platformer", "sandbox", "exploration", "adventure"], "long_description": "**Get lost in the Squishies-verse!**\n\nSquishies is a head-scratching puzzle platformer where you guide courageous and cute creatures through a series of increasingly hazardous, challenging mazes. Use unique motion controls to push and pull the Squishies through their adventures in a colorful universe full of strange flora and fauna. Keep those little rascals safe while they climb, jump, fly and teleport-by-fish through dozens of levels in five alien worlds!\n\n{507625458961423}\n\nYou push and pull the Squishies from one side of the maze to the other, all while earning medals, gathering crystals, climbing slopes, and avoiding pitfalls.\n\n- **Explore a huge universe** - Across dozens of levels in five different worlds.\n- **Collectibles and Achievements** - Gather all the crystals, beat the clock or find the hidden egg in each level.\n- **Level Editor** - Squishies really comes into its own with its innovative, fully featured creation tools.\n- **Community Section** - Share your creation with others and play their ingenious levels.\n- **Limited play space?** Need to keep an eye on your own little monsters?  You\u2019re in luck. Squishies\u00ae can be played in the newly added Mixed Reality mode!\n\n\n{482757334822594}", "short_description": "Help the stranded Squishies find their way back home! Push and pull them through challenging puzzles, or create your own levels with the powerful in-game editor and share them with the community."}]}, "developer_name": null, "developer_privacy_policy_url": "https://brainseed-factory.com/law/privacy_products/index.php", "developer_terms_of_service_url": "https://brainseed-factory.com/law/terms_products/index.php", "publishe
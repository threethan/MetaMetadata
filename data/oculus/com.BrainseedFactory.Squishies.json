culuscdn.com/v/t64.5771-25/75322598_1145165853836223_6864148320373849862_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZJuw16arD14Q7kNvwHYyTQt&_nc_oc=AdrWJiBHHopF0IgAlkaq6sE96o1KK_We5vi3SE5bGVpSvd7lEU-rj3c4Dp4_pkcpYpo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQFK5xeg95P9vm7id1xk78TlHdRfsypHtoUx8jriQI2kA&oe=6AF72A83"}, {"file_name": "Screenshot03.png", "id": "598340872572801", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39001670_598340875906134_7078948835759736288_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=14dqk3G-CzcQ7kNvwEm6COj&_nc_oc=AdrKpj2WsmfcOgc9WxCO1RfYME3ZWvJhj106i1I0CNczhJt8WJ_uTQuYx1ufOiDWX-A&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTTrPfhBIjVMeLUiSC1sn5z0-sij0gcJsdwX2qZReHGbg&oe=6AF7288B"}, {"file_name": "Screenshot06.png", "id": "970563445094246", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031450_970563448427579_1896364834470325490_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AOo7GUTZPCoQ7kNvwGhP0Bu&_nc_oc=AdrEepTHU4p900pVEmrlMNMJ8gTygZLndbnNrZ3i902rFePuWWGTB5DGqAc912_oGB8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQtr-F7rLCeMJgiLE27_8Hih5fyLIOKvCx_twiiqoQqRw&oe=6AF74812"}, {"file_name": "Screenshot04.png", "id": "575729695062740", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031400_575729698396073_2621336866475747103_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HmzPwsmHGGYQ7kNvwHxTtZc&_nc_oc=AdqRQfzdWyGkSlSKUKd1et-GNW9aIRFxNDp8fhvACJELKpBFnEQ4-yMd4Kj8NddD16s&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSXlqRV4dCunWjZ4rkQ96IzLmOUeO1VohlLldkTmjra0g&oe=6AF716DC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Gameplay Trailer Thumb.png", "id": "605202028847932", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974836_605202032181265_2417977283558520499_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rfFmzts7bjYQ7kNvwE1Ejfb&_nc_oc=AdpQRN_HNEO_-LrzMpthQ4UUPxVF_AsdQkvllISQyImZLHD0w5Zv_Uz5xnelLhN5jWA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTI4qx8302RXb4P8W-CmUYKtVujsijHVmuS6LcDXL6New&oe=6AF71E99"}, "display_name": "Squishies - Roll them Home!", "keywords": ["puzzle", "platformer", "sandbox", "exploration", "adventure"], "long_description": "**Get lost in the Squishies-verse!**\n\nSquishies is a head-scratching puzzle platformer where you guide courageous and cute creatures through a series of increasingly hazardous, challenging mazes. Use unique motion controls to push and pull the Squishies through their adventures in a colorful universe full of strange flora and fauna. Keep those little rascals safe while they climb, jump, fly and teleport-by-fish through dozens of levels in five alien worlds!\n\n{507625458961423}\n\nYou push and pull the Squishies from one side of the maze to the other, all while earning medals, gathering crystals, climbing slopes, and avoiding pitfalls.\n\n- **Explore a huge universe** - Across dozens of levels in five different worlds.\n- **Collectibles and Achievements** - Gather all the crystals, beat the clock or find the hidden egg in each level.\n- **Level Editor** - Squishies really comes into its own with its innovative, fully featured creation tools.\n- **Community Section** - Share your creation with others and play their ingenious levels.\n- **Limited play space?** Need to keep an eye on your own little monsters?  You\u2019re in luck. Squishies\u00ae can be played in the newly added Mixed Reality mode!\n\n\n{482757334822594}", "short_description": "Help the stranded Squishies find their way back home! Push and pull them through challenging puzzles, or create your own levels with the powerful in-game editor and share them with the community."}]}, "developer_name": null, "developer_privacy_policy_url": "https://brainseed-factory.com/law/privacy_products/index.php", "developer_terms_of_service_url": "https://brainseed-factory.com/law/terms_products/index.php", "publishe
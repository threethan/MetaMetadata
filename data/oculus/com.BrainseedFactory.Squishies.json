culuscdn.com/v/t64.5771-25/75322598_1145165853836223_6864148320373849862_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XsYjTVc3OdUQ7kNvwEXyFeH&_nc_oc=Adqyoxu25wtJN8k4lelxuWFeSpZHyn-W-v5abcLPpFUno88hFmn-sQwvQCaaUGD35CI&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9Pubt_4D37JnhZV_AiVLsmHMEZRQ8RNhmQcv8Gnhd2iw&oe=6A413B83"}, {"file_name": "Screenshot03.png", "id": "598340872572801", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39001670_598340875906134_7078948835759736288_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mUaIUB7nqGoQ7kNvwFMLPLa&_nc_oc=Adrdr47c8d-S0aDALA8aJEOghdzScZqu0rQk0WaDF_3Mv_8wj8_CCf-xAPX_ZtGBDrQ&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_wL5VHjaDG21VKz17RG_iZGpEmrdjaYW2F30CdaPvvjg&oe=6A41398B"}, {"file_name": "Screenshot06.png", "id": "970563445094246", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39031450_970563448427579_1896364834470325490_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GPfNMP0xvGEQ7kNvwEC4LV3&_nc_oc=AdoTgoDGWJsYri0v3_m0Gt2NIauA9U6MvUUMIr3eAXAwkBDvwEdfkL8R9SWhV31GCH8&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-nSnTNLPNVV9XUOI3-DhM4UIB-aUFSuDWAfdWEmFaW8A&oe=6A4120D2"}, {"file_name": "Screenshot04.png", "id": "575729695062740", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39031400_575729698396073_2621336866475747103_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3DFUN0GGikAQ7kNvwGL4bhP&_nc_oc=AdoGUlSW6PaBdDZmHFinR0lQuTtRjbEqy28po_GxePGJC3VCn_q0l8e5ChX7BCGmr0U&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-wrqPKKap_5KERU7n2BxCnd3l-d6GxDdEhNloqVe4EGg&oe=6A4127DC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Gameplay Trailer Thumb.png", "id": "605202028847932", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974836_605202032181265_2417977283558520499_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lZlZjDlpRt0Q7kNvwGJnO8V&_nc_oc=AdqCOuxaGHuNWQSEToXsVJoQ8ImDPAfAkWNZWxFLzuKQnIqY_Zvtj7bS20vOb3VgOQQ&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_TaYMn5PQfXHke-txNHEx1wGKvsebZcFJ2d4TpDSK02w&oe=6A412F99"}, "display_name": "Squishies - Roll them Home!", "keywords": ["puzzle", "platformer", "sandbox", "exploration", "adventure"], "long_description": "**Get lost in the Squishies-verse!**\n\nSquishies is a head-scratching puzzle platformer where you guide courageous and cute creatures through a series of increasingly hazardous, challenging mazes. Use unique motion controls to push and pull the Squishies through their adventures in a colorful universe full of strange flora and fauna. Keep those little rascals safe while they climb, jump, fly and teleport-by-fish through dozens of levels in five alien worlds!\n\n{507625458961423}\n\nYou push and pull the Squishies from one side of the maze to the other, all while earning medals, gathering crystals, climbing slopes, and avoiding pitfalls.\n\n- **Explore a huge universe** - Across dozens of levels in five different worlds.\n- **Collectibles and Achievements** - Gather all the crystals, beat the clock or find the hidden egg in each level.\n- **Level Editor** - Squishies really comes into its own with its innovative, fully featured creation tools.\n- **Community Section** - Share your creation with others and play their ingenious levels.\n- **Limited play space?** Need to keep an eye on your own little monsters?  You\u2019re in luck. Squishies\u00ae can be played in the newly added Mixed Reality mode!\n\n\n{482757334822594}", "short_description": "Help the stranded Squishies find their way back home! Push and pull them through challenging puzzles, or create your own levels with the powerful in-game editor and share them with the community."}]}, "developer_name": null, "developer_privacy_policy_url": "https://brainseed-factory.com/law/privacy_products/index.php", "developer_terms_of_service_url": "https://brainseed-factory.com/law/terms_products/index.php", "publishe
culuscdn.com/v/t64.5771-25/75322598_1145165853836223_6864148320373849862_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0xoh6-wuB5oQ7kNvwFFTlco&_nc_oc=Adrwz8qDlVfNN2nMRS08S0X6G205pYOCMd8HLAMSyYP1qEXyxt0oTxh4go0DC7Z8ieI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9uzvetFBwcCfbcEDC36tTMM5OSEHJCAQ2VjT841tu0Tg&oe=6A3E9883"}, {"file_name": "Screenshot03.png", "id": "598340872572801", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39001670_598340875906134_7078948835759736288_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BtSzbVQUB7wQ7kNvwE37nRQ&_nc_oc=AdpMXVvcXo6TCG1Dtp0kdkC5YNsppomzwgO5aX1VA0yilb9AyXdPW-qtupp4hY21Rik&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9KvqRv1KQ4riWdgou6t--Ie4e1-rg3Wp1HQo9ziqujLA&oe=6A3E968B"}, {"file_name": "Screenshot06.png", "id": "970563445094246", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031450_970563448427579_1896364834470325490_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GRiP5JbrAAAQ7kNvwEip3Yg&_nc_oc=AdqU4o44dtR-oGhNtAbTE4AyWmNSs9rn6geXzm1jfUvZbR2xYpYoen_m5V-1oG6DjmU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_xgxezIgsLI9-RSbZMww5PMwV11uV1A58UgwdjZrS_Qg&oe=6A3E7DD2"}, {"file_name": "Screenshot04.png", "id": "575729695062740", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031400_575729698396073_2621336866475747103_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cAbM3XtSVB8Q7kNvwFm8tz4&_nc_oc=AdrsvmEC_75cFr2ieBSZQQv6g6ttElJCG2WGpeXsUdZ-KNHSuySHevZP5n-5vTyAftA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9GODV0l7S-LmVXQ9ben593BGRIOCy5WZDQAFM_wiUFoQ&oe=6A3E84DC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Gameplay Trailer Thumb.png", "id": "605202028847932", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974836_605202032181265_2417977283558520499_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8BQaksJwlWwQ7kNvwF6NM62&_nc_oc=AdoRElcZXpA9YMVqh_QaH6lPAzh2ljCjm1xLHO1Au_NqgP3_YH0kOvMr2Y0cwhC-01c&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-SqOZYJzvYdboF5jnjZQRarhoglQnXxhlJObdFYwAREQ&oe=6A3E8C99"}, "display_name": "Squishies - Roll them Home!", "keywords": ["puzzle", "platformer", "sandbox", "exploration", "adventure"], "long_description": "**Get lost in the Squishies-verse!**\n\nSquishies is a head-scratching puzzle platformer where you guide courageous and cute creatures through a series of increasingly hazardous, challenging mazes. Use unique motion controls to push and pull the Squishies through their adventures in a colorful universe full of strange flora and fauna. Keep those little rascals safe while they climb, jump, fly and teleport-by-fish through dozens of levels in five alien worlds!\n\n{507625458961423}\n\nYou push and pull the Squishies from one side of the maze to the other, all while earning medals, gathering crystals, climbing slopes, and avoiding pitfalls.\n\n- **Explore a huge universe** - Across dozens of levels in five different worlds.\n- **Collectibles and Achievements** - Gather all the crystals, beat the clock or find the hidden egg in each level.\n- **Level Editor** - Squishies really comes into its own with its innovative, fully featured creation tools.\n- **Community Section** - Share your creation with others and play their ingenious levels.\n- **Limited play space?** Need to keep an eye on your own little monsters?  You\u2019re in luck. Squishies\u00ae can be played in the newly added Mixed Reality mode!\n\n\n{482757334822594}", "short_description": "Help the stranded Squishies find their way back home! Push and pull them through challenging puzzles, or create your own levels with the powerful in-game editor and share them with the community."}]}, "developer_name": null, "developer_privacy_policy_url": "https://brainseed-factory.com/law/privacy_products/index.php", "developer_terms_of_service_url": "https://brainseed-factory.com/law/terms_products/index.php", "publishe
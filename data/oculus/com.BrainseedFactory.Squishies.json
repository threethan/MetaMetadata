culuscdn.com/v/t64.5771-25/75322598_1145165853836223_6864148320373849862_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ELoIpD45rUMQ7kNvwEngsed&_nc_oc=AdrGoufnrkO7P4A9vDwi1vkyLRfOYcjvB3YmKfB1FQR6vkATXu8HkJVQX87Io15sy0s&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM1_k8V67ysIp_RPWUjSXqi8X8avdeRERz74V8xoYuUBQ&oe=6AE21283"}, {"file_name": "Screenshot03.png", "id": "598340872572801", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39001670_598340875906134_7078948835759736288_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Pqs2_oK_C1UQ7kNvwFHrL2l&_nc_oc=Adr4HBX4XBC2keJh1FT29Rdoy3OVFU1BM0hVIaTU1lYRX_RPjcuVCsr9c__-9bRjMLU&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPC6KP06N1NAu1UBQDxSLYcAHFgy9BgLOFJiQ6CQXofKw&oe=6AE2108B"}, {"file_name": "Screenshot06.png", "id": "970563445094246", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39031450_970563448427579_1896364834470325490_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m9NXiJFiahoQ7kNvwHNlAnP&_nc_oc=AdqXec8iXUWZHqVIoWrZ4UaGYt1-rCgove8gzv1q-VmLKzFBywH6RjCwEMYG75_1KOY&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMh_uZyC1DhbxSPQWrlLiTQPCQ8f1KNXpkxwhUtOJLjPg&oe=6AE1F7D2"}, {"file_name": "Screenshot04.png", "id": "575729695062740", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39031400_575729698396073_2621336866475747103_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y9oWd47qCQQQ7kNvwGGfCnD&_nc_oc=AdopqZgMnZiwKiMu2OP0Tmk6fQJ1mwRdH8ILfXkf4MZjc32lc1p5ZcJpSmHXhN1ho5o&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNmPIFyc2c0aWNFzIzmCAtJ_7jL975-vtiAPH5_8AiCzw&oe=6AE1FEDC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Gameplay Trailer Thumb.png", "id": "605202028847932", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974836_605202032181265_2417977283558520499_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oMl7Zk1aPmAQ7kNvwFoJB08&_nc_oc=AdrtZhjD1-wZTp8RtnhU5LE6Zkwg_Evy0wSvWIms72YIiEoDsbxFZoiw5phRvSLrCNk&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNdykSBvdmKUzTBBCIxNH-FtCAjRm64_xVILkcQojkPFw&oe=6AE20699"}, "display_name": "Squishies - Roll them Home!", "keywords": ["puzzle", "platformer", "sandbox", "exploration", "adventure"], "long_description": "**Get lost in the Squishies-verse!**\n\nSquishies is a head-scratching puzzle platformer where you guide courageous and cute creatures through a series of increasingly hazardous, challenging mazes. Use unique motion controls to push and pull the Squishies through their adventures in a colorful universe full of strange flora and fauna. Keep those little rascals safe while they climb, jump, fly and teleport-by-fish through dozens of levels in five alien worlds!\n\n{507625458961423}\n\nYou push and pull the Squishies from one side of the maze to the other, all while earning medals, gathering crystals, climbing slopes, and avoiding pitfalls.\n\n- **Explore a huge universe** - Across dozens of levels in five different worlds.\n- **Collectibles and Achievements** - Gather all the crystals, beat the clock or find the hidden egg in each level.\n- **Level Editor** - Squishies really comes into its own with its innovative, fully featured creation tools.\n- **Community Section** - Share your creation with others and play their ingenious levels.\n- **Limited play space?** Need to keep an eye on your own little monsters?  You\u2019re in luck. Squishies\u00ae can be played in the newly added Mixed Reality mode!\n\n\n{482757334822594}", "short_description": "Help the stranded Squishies find their way back home! Push and pull them through challenging puzzles, or create your own levels with the powerful in-game editor and share them with the community."}]}, "developer_name": null, "developer_privacy_policy_url": "https://brainseed-factory.com/law/privacy_products/index.php", "developer_terms_of_service_url": "https://brainseed-factory.com/law/terms_products/index.php", "publishe
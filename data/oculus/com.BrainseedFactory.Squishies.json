uluscdn.com/v/t64.5771-25/75322598_1145165853836223_6864148320373849862_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dO1nA2cyn-4Q7kNvwHJrYy_&_nc_oc=AdrN9fkIn1L1ZVRUq6EH2drBYRKEMFn0yXs_i6TuwifRC0U3yMLki-ZFAOwLBbVnzw8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4r7rLC7Uyeu4eOw58hllj6zW6sIT2uxMxvOt6hs9piTw&oe=6A146883"}, {"file_name": "Screenshot03.png", "id": "598340872572801", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39001670_598340875906134_7078948835759736288_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CZZdsNmngKIQ7kNvwE6GOPS&_nc_oc=AdrEczoPRMuticptiF7UqaolteL5sN26oMk9jwYSARqO0iyK8kWPrLJKFK8ZxG-OCts&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4MkLVrhQ2L8MfRJqhC_ORbLEnsg99n-HMzR9cSHdbjIw&oe=6A14668B"}, {"file_name": "Screenshot06.png", "id": "970563445094246", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031450_970563448427579_1896364834470325490_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rWG7KIEB7-0Q7kNvwFlV3YL&_nc_oc=Adqjbxj_lciojaC8dAq_g-6k7CqYLQ2ImwsDvecegLtm2UUNr0vR2M2MtkbJSOqSrQc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5dbIkZXhr8AJh6eAWHi2F19uCRXzAMILrq0iJ0F6AaLw&oe=6A144DD2"}, {"file_name": "Screenshot04.png", "id": "575729695062740", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031400_575729698396073_2621336866475747103_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hKlFIgBWQQ0Q7kNvwHrvdF2&_nc_oc=Adpy-bkqpfR7FzbOi5eN6ykCZAh1qc7VibSUvYO7RyRDEXgEd5Ro9K75xUmeiv3aKGI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7EIW3Cgtf52yKNiYS-ivb5H3PuKAY_nuEGSNXBsXvqSQ&oe=6A1454DC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Gameplay Trailer Thumb.png", "id": "605202028847932", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974836_605202032181265_2417977283558520499_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GU8uRmORS6QQ7kNvwHi2s5h&_nc_oc=AdpCLAFb6hPGSx19akr59Z8ABQJD580EA5sSY3k8kyyOSQn2hdkt1dsda_TArcZR60E&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4ZR_vz9y6zeED_5jkaDbW9rftUapa2B_aKcy-bLP8VWQ&oe=6A145C99"}, "display_name": "Squishies - Roll them Home!", "keywords": ["puzzle", "platformer", "sandbox", "exploration", "adventure"], "long_description": "**Get lost in the Squishies-verse!**\n\nSquishies is a head-scratching puzzle platformer where you guide courageous and cute creatures through a series of increasingly hazardous, challenging mazes. Use unique motion controls to push and pull the Squishies through their adventures in a colorful universe full of strange flora and fauna. Keep those little rascals safe while they climb, jump, fly and teleport-by-fish through dozens of levels in five alien worlds!\n\n{507625458961423}\n\nYou push and pull the Squishies from one side of the maze to the other, all while earning medals, gathering crystals, climbing slopes, and avoiding pitfalls.\n\n- **Explore a huge universe** - Across dozens of levels in five different worlds.\n- **Collectibles and Achievements** - Gather all the crystals, beat the clock or find the hidden egg in each level.\n- **Level Editor** - Squishies really comes into its own with its innovative, fully featured creation tools.\n- **Community Section** - Share your creation with others and play their ingenious levels.\n- **Limited play space?** Need to keep an eye on your own little monsters?  You\u2019re in luck. Squishies\u00ae can be played in the newly added Mixed Reality mode!\n\n\n{482757334822594}", "short_description": "Help the stranded Squishies find their way back home! Push and pull them through challenging puzzles, or create your own levels with the powerful in-game editor and share them with the community."}]}, "developer_name": null, "developer_privacy_policy_url": "https://brainseed-factory.com/law/privacy_products/index.php", "developer_terms_of_service_url": "https://brainseed-factory.com/law/terms_products/index.php", "publisher
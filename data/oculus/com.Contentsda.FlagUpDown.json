railer_thumbnail": {"file_name": "10.coverImage.png", "id": "1656075865212572", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39036645_1656075868545905_3959229156036123060_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sPdtZGAxlHgQ7kNvwHxI3Q0&_nc_oc=Adr4N8o6sRIxG38TDXpN4Q_KbWZtCnW1mkeYsdvpuI-_Jo5Z5HpRqyhh5TXvIYndkFs&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0RQfLCSmrjrnzh9ux162rcZPHBDO2fT_QdBoHx7vMjQQ&oe=69F1EBE4"}, "display_name": "Flag up&down", "keywords": [], "long_description": "\"Dive into the realm of realistic experiments through Virtual Reality (VR). Experience the excitement of conducting actual reactions in a risk-free digital laboratory. Mix substances, observe genuine changes, and engage with lifelike molecular structures\u2014all in an immersive 3D environment. Enhance your learning by interacting with accurate representations of laboratory equipment and substances, all while honing your scientific skills. Explore the world of chemistry in an unprecedented way, where hands-on experimentation meets cutting-edge technology for an educational adventure like no other.", "short_description": "It is a cognitive game for cognitive rehabilitation training to help rehabilitate people with cognitive decline and mild cognitive impairment, and is designed to provide two or more cognitive experiences and training in the game. Cognitive Blue Flag White Flag is a cognitive game designed to allow people with severe disabilities who have difficulty using controllers to play through hand tracking."}]}, "developer_name": null, "developer_privacy_policy_url": "https://training.contentsda.kr/privacy-policy-en/", "developer_terms_of_service_url": "https://training.contentsda.kr/terms-and-conditions-en/", "publisher_name": "ContentsDa Inc", "support_website_url": null, "website_url": "https://training.contentsda.kr/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "362692211442873", "context_c
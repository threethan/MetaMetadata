=69B55349"}, {"file_name": "08.screenshot5.png", "id": "936837211261327", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/57569423_936837214594660_5225129676049866070_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZEVbVZDj_04Q7kNvwGroJXH&_nc_oc=AdkmK3v5BTN6xwS4XIHWA9-kyBSVIgZtPMGSyWrk_Iq17r1hl-SWY6pKc7DEGYkI8xI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfzdRS8Ary7SNpDTfWfROIZtrfc4ruF6gYMzRM0dyIxSBg&oe=69B56834"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "10.coverImage.png", "id": "1656075865212572", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39036645_1656075868545905_3959229156036123060_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Q35q_AL5ZYYQ7kNvwE0k2VS&_nc_oc=AdkWAHcyIzmEy8vPQY9NTONIUqQGp5EARuoXol6AscNLanHoImEgnlHbbFaPbqz9688&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_Afzc6uf4BWzGqGuOXANovmQvQgakFqmyn2LlptGkjX-UGQ&oe=69B546E4"}, "display_name": "Flag up&down", "keywords": [], "long_description": "\"Dive into the realm of realistic experiments through Virtual Reality (VR). Experience the excitement of conducting actual reactions in a risk-free digital laboratory. Mix substances, observe genuine changes, and engage with lifelike molecular structures\u2014all in an immersive 3D environment. Enhance your learning by interacting with accurate representations of laboratory equipment and substances, all while honing your scientific skills. Explore the world of chemistry in an unprecedented way, where hands-on experimentation meets cutting-edge technology for an educational adventure like no other.", "short_description": "It is a cognitive game for cognitive rehabilitation training to help rehabilitate people with cognitive decline and mild cognitive impairment, and is designed to provide two or more cognitive experiences and training in the game. Cognitive Blue Flag White Flag is a cognitive game designed to allow people with severe disabilities who have difficulty using controllers to play through hand tracking."}]}, "developer_name": null, "developer_privacy_policy_url": "https://training.contentsda.kr/privacy-policy-en/", "developer_terms_of_service_url": "https://training.contentsda.kr/terms-and-conditions-en/", "publisher_name": "ContentsDa Inc", "support_website_url": null, "website_url": "https://training.contentsda.kr/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "7352559388159524"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PUBLISHED", "id": "1571478260425184"}, {"status": "PUBLISHED", "id": "975131564049267"}]}, "baseline_offer": {"id": "1571478260425184"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1727847180, "status": "PUBLISHED", "id": "1571478260425184"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "7352600954822034", "version": "0.1"}, "id": "448564000947847", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "7352559371492859", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "7352600954822034"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "448564000947847"}]}, "change_
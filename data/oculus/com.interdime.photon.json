97211250", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499623601_2203085100544583_1219287069904965781_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bBu0mczwfqEQ7kNvwFVcbCI&_nc_oc=AdoKlqwnnLGE-q_2vLB-QJl2fbJGV_aYx1gMCytzSYiG3glFKF69ZOzHRwVU9fnZNQ4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCpQ3GJA3uAdPDaMcrm-vUV2QeZd5ELZa31_6pVa5FkjA&oe=6A64B9DA"}, {"file_name": "0707\u7b2c\u4e94\u5f20\u56fe_2560x1440_\u65e0\u767d\u8fb9.png", "id": "1013493601610506", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499623400_1013493604943839_7121329615047137016_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cP1GnO5YUY0Q7kNvwHT2W6U&_nc_oc=Adr2i_86xN1EKGK_LIA6BGPOWxc_YrDTGe1MH3YGrQlbPX2-BTvB8vrb6Ll4lWjt2dc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD8CtwPrwOhArxaQbOUzdlmlewtDfzYVwnHa6P99tDKCA&oe=6A649E38"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u771f\u7684\u6700\u7ec8\u7248Group 10_2560x1440_24bit.png", "id": "2598175357281410", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499624619_2598175360614743_4172795233857619219_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CNMNfpljm0IQ7kNvwFe7HHc&_nc_oc=AdoNc2TD7XcYAgRnfEzPPKkCXaq-DvJJ2dtsD0J8ky1m0b97usUES-iZYg0C39FnlRs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDBNXXgkOTfUrGfvaa6a37-Ty4UP9OT9W4pjqvS7DIm8g&oe=6A64A729"}, "display_name": "Photon: Immersive Media", "keywords": ["immersive", "spatial", "media", "vr180", "video"], "long_description": "# **Photon: Immersive Media**\n\nDiscover immersive 3D video experiences with **Photon**.\n\nWith **100,000+ immersive videos**, Photon is a leading platform for immersive media discovery and sharing.\n\nFrom traveling the world to dancing on stage, from breathtaking nature to city skylines \u2014 everything you can and can\u2019t imagine is here.\n\n{778912265286614}\n\n# **Feature Highlights**\n\n- **Highest-Quality 8K Immersive Video**\n\nPhoton offers a vast collection of highest-quality 8K immersive videos, optimized for VR immersive viewing.\n\n- **Amazing Immersion Watching Mode**\n\nTry out the immersion watching mode, which truly augments the immersiveness and make you feel like you're right in the scene.\n\n- **Personalized Feed Tailored to Your Interest**\n\nPhoton learns what you love as you explore. Also, try the search feature to discover your favorite video theme in immersive 3D", "short_description": "Photon: Immersive Media.\n\nDiscover immersive 3D video experiences with Photon.\n\nWith 100,000+ immersive videos, Photon is a leading platform for immersive media discovery and sharing.\n\nFrom traveling the world to dancing on stage, from breathtaking nature to city skylines \u2014 everything you can and can\u2019t imagine is here."}]}, "developer_name": null, "developer_privacy_policy_url": "https://interdime.io/privacy_policy", "developer_terms_of_service_url": null, "publisher_name": "Photon XR", "support_website_url": null, "website_url": "https://photon-xr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1228796255027646"}, {"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "27315422228067520"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499619685_1333012318422483_3238672816387472184_n.png?stp=dst-png_s360x360&_nc_cat=104&ccb=1-7&_nc_si
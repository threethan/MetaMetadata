ttps://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/499623601_2203085100544583_1219287069904965781_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9LSO7QnV9DIQ7kNvwE2zCjJ&_nc_oc=AdqA0oMuj2PC_j1PkjBT-IFG8iDBAx5U9QwBVaqvZnaY1gAsVO9xKr_ZSleuIntqOqI&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBWYXFCr6XnQvl5rKRAZEmT_dJgCrMI7I1twqsmtxlouA&oe=6A56395A"}, {"file_name": "\u6700\u6700\u7ec85_2560x1440.png", "id": "2525227281281400", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/499619672_2525227284614733_6489835984119565910_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bq9VBN6hhZMQ7kNvwGmtkXV&_nc_oc=Adp6tVZhReiB7CkmhiY0h5cF4FJA_E8jewqiJTzrIEt66nL_1fjo3eA1sp0huXxU1vI&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCmO7JGznoPcIjCMFS3UEZiFRiplrQloLf_iN49stX2dw&oe=6A56418F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "coverupload.png", "id": "2574718376282007", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/499622315_2574718379615340_4148727339906355942_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uy-KoNc4-LoQ7kNvwEzdSWS&_nc_oc=AdoDxCd3dja4hLe7Nexr4p2GrF_tMplFEkcBvZ457sCeDoKj383S07xiar742TQQvxw&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCXWIx3Q8Ug9qDL8o73XUucXku--g0dC32553ATj_g_8A&oe=6A562E34"}, "display_name": "Photon: Immersive Media", "keywords": ["immersive", "spatial", "media", "vr180", "video"], "long_description": "# **Photon: Immersive Media**\n\nDiscover immersive 3D video experiences with **Photon**.\n\nWith **100,000+ immersive videos**, Photon is a leading platform for immersive media discovery and sharing.\n\nFrom traveling the world to dancing on stage, from breathtaking nature to city skylines \u2014 everything you can and can\u2019t imagine is here.\n\n{778912265286614}\n\n# **Feature Highlights**\n\n- **Highest-Quality 8K Immersive Video**\n\nPhoton offers a vast collection of highest-quality 8K immersive videos, optimized for VR immersive viewing.\n\n- **Amazing Immersion Watching Mode**\n\nTry out the immersion watching mode, which truly augments the immersiveness and make you feel like you're right in the scene.\n\n- **Personalized Feed Tailored to Your Interest**\n\nPhoton learns what you love as you explore. Also, try the search feature to discover your favorite video theme in immersive 3D", "short_description": "Photon: Immersive Media.\n\nDiscover immersive 3D video experiences with Photon.\n\nWith 100,000+ immersive videos, Photon is a leading platform for immersive media discovery and sharing.\n\nFrom traveling the world to dancing on stage, from breathtaking nature to city skylines \u2014 everything you can and can\u2019t imagine is here."}]}, "developer_name": null, "developer_privacy_policy_url": "https://interdime.io/privacy_policy", "developer_terms_of_service_url": null, "publisher_name": "Photon XR", "support_website_url": null, "website_url": "https://photon-xr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1228796255027646"}, {"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "27187116344231443"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/499619685_1333012318422483_3238672816387472184_n.png?stp=dst-png_s360x360&_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=32D8pkBAU-UQ7kNvwH3SSHx&_nc_oc=Adr_L56iIHNIdstOnw2EH56dcqUroFqfUYs9wKj7BI3
ttps://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499623601_2203085100544583_1219287069904965781_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9LSO7QnV9DIQ7kNvwEFdVRc&_nc_oc=AdpyiEYDdEc_QC2HztcO6zREj2CyZiMxJtzksLdbPeP_8yvjIxgC_stBc45vfBb3KbI&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAMjNkGvmyPJ8925WrIkUsK72th_bTngxWW9yAd6l8eaA&oe=6A54E7DA"}, {"file_name": "\u6700\u6700\u7ec85_2560x1440.png", "id": "2525227281281400", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499619672_2525227284614733_6489835984119565910_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bq9VBN6hhZMQ7kNvwFfVREW&_nc_oc=AdrIcndLyQtgkzPoBT8u7I-7LWhvIscP38UauFK5L32L7K8eN5pENo-bNNw4-_y0ixY&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAoppeTi_snduXAIQyANwgiVVcChUvV4m-SPPZrsYUqEg&oe=6A54F00F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "coverupload.png", "id": "2574718376282007", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499622315_2574718379615340_4148727339906355942_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uy-KoNc4-LoQ7kNvwGL_pom&_nc_oc=Adq-kJRHQjmGxl_F0AdxxsFcG4anxTH4YgXJp_ENkRSFB-JoGy38pCTPaZhLHpxatEA&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB17hm3lWQ8k4wy6l4IPkZ9WBWYNg-TJqIhXpoARVYSMw&oe=6A54DCB4"}, "display_name": "Photon: Immersive Media", "keywords": ["immersive", "spatial", "media", "vr180", "video"], "long_description": "# **Photon: Immersive Media**\n\nDiscover immersive 3D video experiences with **Photon**.\n\nWith **100,000+ immersive videos**, Photon is a leading platform for immersive media discovery and sharing.\n\nFrom traveling the world to dancing on stage, from breathtaking nature to city skylines \u2014 everything you can and can\u2019t imagine is here.\n\n{778912265286614}\n\n# **Feature Highlights**\n\n- **Highest-Quality 8K Immersive Video**\n\nPhoton offers a vast collection of highest-quality 8K immersive videos, optimized for VR immersive viewing.\n\n- **Amazing Immersion Watching Mode**\n\nTry out the immersion watching mode, which truly augments the immersiveness and make you feel like you're right in the scene.\n\n- **Personalized Feed Tailored to Your Interest**\n\nPhoton learns what you love as you explore. Also, try the search feature to discover your favorite video theme in immersive 3D", "short_description": "Photon: Immersive Media.\n\nDiscover immersive 3D video experiences with Photon.\n\nWith 100,000+ immersive videos, Photon is a leading platform for immersive media discovery and sharing.\n\nFrom traveling the world to dancing on stage, from breathtaking nature to city skylines \u2014 everything you can and can\u2019t imagine is here."}]}, "developer_name": null, "developer_privacy_policy_url": "https://interdime.io/privacy_policy", "developer_terms_of_service_url": null, "publisher_name": "Photon XR", "support_website_url": null, "website_url": "https://photon-xr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1228796255027646"}, {"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "27187116344231443"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/499619685_1333012318422483_3238672816387472184_n.png?stp=dst-png_s360x360&_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=32D8pkBAU-UQ7kNvwFcfIfX&_nc_oc=AdrfLwxbdhUB1Xcc2O0MeUEsTJSZo7XM153zSQ3ZUM_
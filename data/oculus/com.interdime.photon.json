ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CzhYFjcQWrUQ7kNvwH9bNH1&_nc_oc=AdqYZg72fwWDvpzdjz7IKtsdeARjGgg0BdoKkOlbrCP8ZutG-5Mjl-AGhJJc4jG8ASE&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afw8LWgPGkptWSQ-9NcXcP9PCCetPFKlVAfxaX-fmf_2sw&oe=69C7BA8E"}, {"file_name": "5th VR180Immersive.png", "id": "2090833815105853", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/499300661_2090833818439186_1967968156153782292_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gxfErnfszCIQ7kNvwHGBfzW&_nc_oc=AdqnE0sER22LdZ5DBeDkbECRnFnNQcNdp1KWxQWnu0NKri2x0OQrStMNSS96En5QZ10&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxaagdKRH3sxhfjgUE2qT11z5eI4MU6pL5Wtmf4U1qBqw&oe=69C7B3CC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Page.png", "id": "1400875321721445", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/499622214_1400875325054778_9222754897255830609_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wCtD1cq1DlcQ7kNvwGCuaVj&_nc_oc=AdrhBxT_AUDqqC5wsyo5KD8LewZ81Hr1LpL1z2ERJatnTgUskFEi-NQ0t7dHaj0AhRg&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyxvAxTwN9paePjGBn2rjRjkfc-YXmFx0SwUXAKPaevFA&oe=69C7BD74"}, "display_name": "Photon: Immersive Media", "keywords": ["immersive", "spatial", "media", "vr180", "video"], "long_description": "# **Photon: Explore Immersive Media**\n\nDiscover immersive 3D video experiences with **Photon**.\n\nWith **100,000+ immersive videos**, Photon is a leading platform for immersive media discovery and sharing.\n\n{778912265286614}\n\nFrom traveling the world to dancing on stage, from breathtaking nature to city skylines \u2014 everything you can and can\u2019t imagine is here.\n\n# **Feature Highlights**\n\n- **Highest-Quality 8K Immersive Video**\n\nPhoton offers a vast collection of highest-quality 8K immersive videos, optimized for VR immersive viewing.\n\n- **Amazing Immersion Watching Mode**\n\nTry out the immsersion watching mode, which truly augments the immersiveness and make you feel like you're right in the scene.\n\n- **Personalized Feed Tailored to Your Interest**\n\nPhoton learns what you love as you explore. Also, try the search feature to discover your favorite video theme in immersive 3D", "short_description": "Photon: Explore Immersive Media.\n\nDiscover immersive 3D video experiences with Photon.\n\nWith 100,000+ immersive videos, Photon is a leading platform for immersive media discovery and sharing.\n\nFrom traveling the world to dancing on stage, from breathtaking nature to city skylines \u2014 everything you can and can\u2019t imagine is here."}]}, "developer_name": null, "developer_privacy_policy_url": "https://interdime.io/privacy_policy", "developer_terms_of_service_url": null, "publisher_name": "Photon XR", "support_website_url": null, "website_url": "https://photon-xr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1228796255027646"}, {"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25962118026731287"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/499619518_4123270897986627_878870589061031530_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A3iWWPnAUsUQ7kNvwFtW-dY&_nc_oc=AdoCJhNQfKjgyYng5Ges-pWzmowthDsrDSr8TxirD_L4zJ6o0jQrm45g4B_fdwbvYcM&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afzcqq_bltDpHIiCL0uuFP
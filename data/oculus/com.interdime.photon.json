G5ZJWAQ7kNvwFNweQq&_nc_oc=Adn5WkPvEb7RKTaWhQUbFa9VHZhoSt9DFN9AcJtj7WDpidxDMZT8JBX6-RgeJaz8xBs&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_Afyq41Kv6-unD5qc9_SN2zduz_HU61jEuMaSreIK5WV77w&oe=69BE800E"}, {"file_name": "5th VR180Immersive.png", "id": "2090833815105853", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499300661_2090833818439186_1967968156153782292_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IRE8b3o5ANIQ7kNvwH9ocG3&_nc_oc=AdmLVTXGvD3iS6R6ZcYX6pplDszsuKCfB0xfHMVxdK8lNIG85TQJCtnU2AhwQMuPHXQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfySOC8x-leTpwiiT2SlGYy_N24bp4EseqbMA1wUWUPNLg&oe=69BE794C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Page.png", "id": "1400875321721445", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499622214_1400875325054778_9222754897255830609_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DnEzao9bjW4Q7kNvwElCakv&_nc_oc=AdnfivaYv7cQskC7noQM1kxe9MYHQ77O_ubm1CCcDqx-b80FouLnDVALHPgGGE0M78Q&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfzxVJipRRi390Sp6NG-Uhxp7vnJ6UwGsjYbdX5Sle_z-w&oe=69BE82F4"}, "display_name": "Photon: Immersive Media", "keywords": ["immersive", "spatial", "media", "vr180", "video"], "long_description": "# **Photon: Explore Immersive Media**\n\nDiscover immersive 3D video experiences with **Photon**.\n\nWith **100,000+ immersive videos**, Photon is a leading platform for immersive media discovery and sharing.\n\n{778912265286614}\n\nFrom traveling the world to dancing on stage, from breathtaking nature to city skylines \u2014 everything you can and can\u2019t imagine is here.\n\n# **Feature Highlights**\n\n- **Highest-Quality 8K Immersive Video**\n\nPhoton offers a vast collection of highest-quality 8K immersive videos, optimized for VR immersive viewing.\n\n- **Amazing Immersion Watching Mode**\n\nTry out the immsersion watching mode, which truly augments the immersiveness and make you feel like you're right in the scene.\n\n- **Personalized Feed Tailored to Your Interest**\n\nPhoton learns what you love as you explore. Also, try the search feature to discover your favorite video theme in immersive 3D", "short_description": "Photon: Explore Immersive Media.\n\nDiscover immersive 3D video experiences with Photon.\n\nWith 100,000+ immersive videos, Photon is a leading platform for immersive media discovery and sharing.\n\nFrom traveling the world to dancing on stage, from breathtaking nature to city skylines \u2014 everything you can and can\u2019t imagine is here."}]}, "developer_name": null, "developer_privacy_policy_url": "https://interdime.io/privacy_policy", "developer_terms_of_service_url": null, "publisher_name": "Photon XR", "support_website_url": null, "website_url": "https://photon-xr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1228796255027646"}, {"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25962118026731287"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499619518_4123270897986627_878870589061031530_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VbF_eKXVOhEQ7kNvwH60hcd&_nc_oc=AdnJIAWTI_oyqmxkA_g0KJA-8-nHuoBmkt71In3iZ43Adja8Jdao-EfwZ2Fffj5PFbg&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfzC5J8kwi4o8bk7blUpArWOsqLjx2pkvp1MTBIGo9dRvA&oe=69BEACB6"}, "is_concept"
ttps://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499623601_2203085100544583_1219287069904965781_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9LSO7QnV9DIQ7kNvwH8hE-C&_nc_oc=AdpXTm9tmoqe3wX5E2evrfUSUPVuJ99VhtKBBMuVhAbIYa1YgcP6Rcw4-EeJ8XAD0Sw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCiGg8vlSwMzfHUYYK5Nffic811g8CIob_c8-fXpyLYQA&oe=6A578ADA"}, {"file_name": "\u6700\u6700\u7ec85_2560x1440.png", "id": "2525227281281400", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499619672_2525227284614733_6489835984119565910_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bq9VBN6hhZMQ7kNvwHaasnL&_nc_oc=AdqG3fFatjbGV6hZPPnxOgGBXv8aJpSTKnkuW3_BRhAnrxvtEu7Bc7HqrnVadZx6JfM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDWRj-TWExJN1NNZRUTPCbXcgkEbWpofHGn3PZf0jfmnQ&oe=6A57930F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "coverupload.png", "id": "2574718376282007", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499622315_2574718379615340_4148727339906355942_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uy-KoNc4-LoQ7kNvwGsuMA4&_nc_oc=AdrhpKhmTj4AHfjYuYVC_1HJmELKSt-0b4evd50pxS8Sie7rQcDjBzjkkizgJHAmYgc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCWdvPfKCa5NR8ms7UP-AnHALyw_ZaaCC1Pd_bJlOpdlw&oe=6A577FB4"}, "display_name": "Photon: Immersive Media", "keywords": ["immersive", "spatial", "media", "vr180", "video"], "long_description": "# **Photon: Immersive Media**\n\nDiscover immersive 3D video experiences with **Photon**.\n\nWith **100,000+ immersive videos**, Photon is a leading platform for immersive media discovery and sharing.\n\nFrom traveling the world to dancing on stage, from breathtaking nature to city skylines \u2014 everything you can and can\u2019t imagine is here.\n\n{778912265286614}\n\n# **Feature Highlights**\n\n- **Highest-Quality 8K Immersive Video**\n\nPhoton offers a vast collection of highest-quality 8K immersive videos, optimized for VR immersive viewing.\n\n- **Amazing Immersion Watching Mode**\n\nTry out the immersion watching mode, which truly augments the immersiveness and make you feel like you're right in the scene.\n\n- **Personalized Feed Tailored to Your Interest**\n\nPhoton learns what you love as you explore. Also, try the search feature to discover your favorite video theme in immersive 3D", "short_description": "Photon: Immersive Media.\n\nDiscover immersive 3D video experiences with Photon.\n\nWith 100,000+ immersive videos, Photon is a leading platform for immersive media discovery and sharing.\n\nFrom traveling the world to dancing on stage, from breathtaking nature to city skylines \u2014 everything you can and can\u2019t imagine is here."}]}, "developer_name": null, "developer_privacy_policy_url": "https://interdime.io/privacy_policy", "developer_terms_of_service_url": null, "publisher_name": "Photon XR", "support_website_url": null, "website_url": "https://photon-xr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1228796255027646"}, {"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "27187116344231443"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499619685_1333012318422483_3238672816387472184_n.png?stp=dst-png_s360x360&_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hWclKKLrSEkQ7kNvwG5dWQN&_nc_oc=AdqRJsomr61DWVwWkj4Te4-Buv5ws_rVsLoREpoptiT
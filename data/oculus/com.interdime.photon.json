-lga3-3.oculuscdn.com/v/t64.5771-25/499623601_2203085100544583_1219287069904965781_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qaUdatL8JPEQ7kNvwHCvA-J&_nc_oc=AdoqTFWZpAgC8eolhaAEfJZsmHFWS9yGgMJRRGUlfHVTdaEDjVsrVrxRVCZOvccDtLY&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ8mAsINjbiVQXXd8IcF51_zOQnOH8UOn8Xvu_GFCmUew&oe=6AEC845A"}, {"file_name": "0707\u7b2c\u4e94\u5f20\u56fe_2560x1440_\u65e0\u767d\u8fb9.png", "id": "1013493601610506", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/499623400_1013493604943839_7121329615047137016_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=07nSiktU68kQ7kNvwHs-6M2&_nc_oc=AdqkyuiDl5n5z4wbJvQYnEuDh_PqM6yi9wsqhszdK16g6bvO9iMpfFBmIuL5D9WfjbU&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQZupOx0fH4EuTONiPZb4CaPDa6vsBkkJvWzHa59E4Sbw&oe=6AECA0F8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u771f\u7684\u6700\u7ec8\u7248Group 10_2560x1440_24bit.png", "id": "2598175357281410", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/499624619_2598175360614743_4172795233857619219_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GyNoVaD5KwMQ7kNvwETFtzn&_nc_oc=AdqC6ebmOndoKAVvNBvG_DeNa4U5c75XUH2LvcfMdX3qTaWQb62Cg6tZJj5xajWfFJc&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQZFauHGZiKxXXGg8m4iVrPTjvwSViPVTAHUf3YTZTIPQ&oe=6AECA9E9"}, "display_name": "Photon: Immersive Media", "keywords": ["immersive", "spatial", "media", "vr180", "video"], "long_description": "# **Photon: Immersive Media**\n\nDiscover immersive 3D video experiences with **Photon**.\n\nWith **100,000+ immersive videos**, Photon is a leading platform for immersive media discovery and sharing.\n\nFrom traveling the world to dancing on stage, from breathtaking nature to city skylines \u2014 everything you can and can\u2019t imagine is here.\n\n{778912265286614}\n\n# **Feature Highlights**\n\n- **Highest-Quality 8K Immersive Video**\n\nPhoton offers a vast collection of highest-quality 8K immersive videos, optimized for VR immersive viewing.\n\n- **Amazing Immersion Watching Mode**\n\nTry out the immersion watching mode, which truly augments the immersiveness and make you feel like you're right in the scene.\n\n- **Personalized Feed Tailored to Your Interest**\n\nPhoton learns what you love as you explore. Also, try the search feature to discover your favorite video theme in immersive 3D", "short_description": "Photon: Immersive Media.\n\nDiscover immersive 3D video experiences with Photon.\n\nWith 100,000+ immersive videos, Photon is a leading platform for immersive media discovery and sharing.\n\nFrom traveling the world to dancing on stage, from breathtaking nature to city skylines \u2014 everything you can and can\u2019t imagine is here."}]}, "developer_name": null, "developer_privacy_policy_url": "https://interdime.io/privacy_policy", "developer_terms_of_service_url": null, "publisher_name": "Photon XR", "support_website_url": null, "website_url": "https://photon-xr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1228796255027646"}, {"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "28708178168791912"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/499619681_1603828374661350_8170400223895498972_n.png?stp=dst-png_s360x360&_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7Y9p7y7Ck0YQ7kNvwE
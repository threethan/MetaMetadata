dn.com/v/t64.5771-25/499620432_969352732575039_7099493514550251333_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=45dVgI9kTrIQ7kNvwHPat97&_nc_oc=AdqkYqLEBm683zPyeRFf5RxjcG46UmghdknYdCQ7mzGBTvBj_Jczjg_puXuhIyCZpds&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA5WzBYYxGqOL0wt86rA53b6NDkiZH3LImMaePxXdUljw&oe=6A4CFF98"}, {"file_name": "499620497_810600868037541_2857388806955733274_n.png", "id": "807522078962860", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/604302364_807522082296193_2570416599061312259_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xCxLcD0I8P4Q7kNvwGt0zgh&_nc_oc=AdoTlU_q2JyBhOr_8LFc9Dv8x203xSoErJ_zJ91K_Jb90xAzesacyzbTfvN8WD-6m6M&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCUpHl2dwiZtV11Voxi1yBQ2lJ9jfFC20ZGCuaF4kgniA&oe=6A4D1025"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "coverupload.png", "id": "2574718376282007", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499622315_2574718379615340_4148727339906355942_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=akePYhN7OKAQ7kNvwFaLwmC&_nc_oc=AdpNr3aRm3fxrj1_E-ZknQxTRwxBVkhZ8bXsROHox4P2oRZWMxfDJfuyH0lXuSo4Re8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDD9S9nYftSx1Iy-JR4rMmCJLfKjHJ8wLX5W7YRb8dxLg&oe=6A4CF3B4"}, "display_name": "Photon: Immersive Media", "keywords": ["immersive", "spatial", "media", "vr180", "video"], "long_description": "# **Photon: Immersive Media**\n\nDiscover immersive 3D video experiences with **Photon**.\n\nWith **100,000+ immersive videos**, Photon is a leading platform for immersive media discovery and sharing.\n\nFrom traveling the world to dancing on stage, from breathtaking nature to city skylines \u2014 everything you can and can\u2019t imagine is here.\n\n{778912265286614}\n\n# **Feature Highlights**\n\n- **Highest-Quality 8K Immersive Video**\n\nPhoton offers a vast collection of highest-quality 8K immersive videos, optimized for VR immersive viewing.\n\n- **Amazing Immersion Watching Mode**\n\nTry out the immersion watching mode, which truly augments the immersiveness and make you feel like you're right in the scene.\n\n- **Personalized Feed Tailored to Your Interest**\n\nPhoton learns what you love as you explore. Also, try the search feature to discover your favorite video theme in immersive 3D", "short_description": "Photon: Immersive Media.\n\nDiscover immersive 3D video experiences with Photon.\n\nWith 100,000+ immersive videos, Photon is a leading platform for immersive media discovery and sharing.\n\nFrom traveling the world to dancing on stage, from breathtaking nature to city skylines \u2014 everything you can and can\u2019t imagine is here."}]}, "developer_name": null, "developer_privacy_policy_url": "https://interdime.io/privacy_policy", "developer_terms_of_service_url": null, "publisher_name": "Photon XR", "support_website_url": null, "website_url": "https://photon-xr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1228796255027646"}, {"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "27081204804822598"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499622214_3288217398047752_1763610748144334467_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gxyDaaDEmsUQ7kNvwFXR1lm&_nc_oc=AdpvJmmJ1FQ2FOhph6rCr346aC-MV3aSQfzvk0QaiMm_ysoqg2dsCpu6eQ
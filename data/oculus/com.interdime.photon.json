625_4416020394207199377_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Q39ZWH_wZa0Q7kNvwHKUWFt&_nc_oc=AdrsfwnnSSLgJ6WlEH7tCge5nyx_YFloGVtOJM1dLWgrWV7NFtss-jgxPPDbqnUCjQU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8rfV9S3lSAX82LVSKyu1It-zQmDTj3bvyXGEaNQXIBDA&oe=6A2EC7CE"}, {"file_name": "5th VR180Immersive.png", "id": "2090833815105853", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499300661_2090833818439186_1967968156153782292_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vQZ7T1l1spgQ7kNvwFDSxXX&_nc_oc=Adr-tCm7Hxj6EePqYo42pCMYivroTPz49VulJj6x7slmKANytEjimx3ROrk6u79notg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9GQdPjZCADzVDkNBrM5ljK-miscDtx4ESODg_V2ZpsHQ&oe=6A2EC10C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Photon Pomo video cover.png", "id": "4126624247554826", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499619145_4126624250888159_2519066590761119556_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OpHYhsE7ousQ7kNvwFSg806&_nc_oc=Adq_4NWAMD6ZV505eCHypI4AW4PzU_Z-265oPq4ulAulP--oXZzcmSRieYBEue_X698&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_FG-UIMwRIfBFtKvYa9h7g2NzdzIoceca1x0CnHDT5LA&oe=6A2EBC66"}, "display_name": "Photon: Immersive Media", "keywords": ["immersive", "spatial", "media", "vr180", "video"], "long_description": "# **Photon: Explore Immersive Media**\n\nDiscover immersive 3D video experiences with **Photon**.\n\nWith **100,000+ immersive videos**, Photon is a leading platform for immersive media discovery and sharing.\n\n{778912265286614}\n\nFrom traveling the world to dancing on stage, from breathtaking nature to city skylines \u2014 everything you can and can\u2019t imagine is here.\n\n# **Feature Highlights**\n\n- **Highest-Quality 8K Immersive Video**\n\nPhoton offers a vast collection of highest-quality 8K immersive videos, optimized for VR immersive viewing.\n\n- **Amazing Immersion Watching Mode**\n\nTry out the immsersion watching mode, which truly augments the immersiveness and make you feel like you're right in the scene.\n\n- **Personalized Feed Tailored to Your Interest**\n\nPhoton learns what you love as you explore. Also, try the search feature to discover your favorite video theme in immersive 3D", "short_description": "Photon: Explore Immersive Media.\n\nDiscover immersive 3D video experiences with Photon.\n\nWith 100,000+ immersive videos, Photon is a leading platform for immersive media discovery and sharing.\n\nFrom traveling the world to dancing on stage, from breathtaking nature to city skylines \u2014 everything you can and can\u2019t imagine is here."}]}, "developer_name": null, "developer_privacy_policy_url": "https://interdime.io/privacy_policy", "developer_terms_of_service_url": null, "publisher_name": "Photon XR", "support_website_url": null, "website_url": "https://photon-xr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1228796255027646"}, {"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26840657372210677"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499622214_3288217398047752_1763610748144334467_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G68TfpnSmakQ7kNvwErHaeu&_nc_oc=Adr9f318Pg_rq8ZF5ymegm25lKoUVgtbgcP9SZXjLvMbDgMWX8oK1ykxRdsIKvbv9sM&_nc_zt=3&_nc_ht=scontent-iad6-1
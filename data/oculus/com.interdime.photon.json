625_4416020394207199377_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-f-a3LtwN20Q7kNvwED1V5c&_nc_oc=AdpuvpbqEURNefbqk4Y7K_7s8cOykOttj6R14up_iDX3havR40M_ScC1IZRSbuCRNXA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9avlYA69n76grCHbvewLZ9YUOj_FxYfhz9aXmExwlWbQ&oe=6A316ACE"}, {"file_name": "5th VR180Immersive.png", "id": "2090833815105853", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499300661_2090833818439186_1967968156153782292_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RghL8sqXz3gQ7kNvwHYbrZg&_nc_oc=AdqoqF-95ZwcQH8QdsvRzZime1WgCq5HKQQNU4iMviBaNjrJ7doQ81pqrJs3NcNZU-w&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8UocDo-XFjaH2CXLlVRM5HhuVx-oWIfgXAhYP7E7uCew&oe=6A31640C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Photon Pomo video cover.png", "id": "4126624247554826", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499619145_4126624250888159_2519066590761119556_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tZ7BJue27DkQ7kNvwGVWiGU&_nc_oc=AdpQNPWS9dEuhYUI4B15JRPyywDLCUQuL8-B7v7tVz1sEDy3R0URQJBVAJsY0paiVhQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8-V8Toq_Um53EuWZQzPd-hSiBJ1XOMpL369EFn_i8z6g&oe=6A315F66"}, "display_name": "Photon: Immersive Media", "keywords": ["immersive", "spatial", "media", "vr180", "video"], "long_description": "# **Photon: Explore Immersive Media**\n\nDiscover immersive 3D video experiences with **Photon**.\n\nWith **100,000+ immersive videos**, Photon is a leading platform for immersive media discovery and sharing.\n\n{778912265286614}\n\nFrom traveling the world to dancing on stage, from breathtaking nature to city skylines \u2014 everything you can and can\u2019t imagine is here.\n\n# **Feature Highlights**\n\n- **Highest-Quality 8K Immersive Video**\n\nPhoton offers a vast collection of highest-quality 8K immersive videos, optimized for VR immersive viewing.\n\n- **Amazing Immersion Watching Mode**\n\nTry out the immsersion watching mode, which truly augments the immersiveness and make you feel like you're right in the scene.\n\n- **Personalized Feed Tailored to Your Interest**\n\nPhoton learns what you love as you explore. Also, try the search feature to discover your favorite video theme in immersive 3D", "short_description": "Photon: Explore Immersive Media.\n\nDiscover immersive 3D video experiences with Photon.\n\nWith 100,000+ immersive videos, Photon is a leading platform for immersive media discovery and sharing.\n\nFrom traveling the world to dancing on stage, from breathtaking nature to city skylines \u2014 everything you can and can\u2019t imagine is here."}]}, "developer_name": null, "developer_privacy_policy_url": "https://interdime.io/privacy_policy", "developer_terms_of_service_url": null, "publisher_name": "Photon XR", "support_website_url": null, "website_url": "https://photon-xr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1228796255027646"}, {"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26840657372210677"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499622214_3288217398047752_1763610748144334467_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ek-y7ikJ2pUQ7kNvwFsWBiF&_nc_oc=AdpSF9IfmW67eR0Wq9tN0R5eHyCBcxUrR5r1I-TBW2M4gCa3QYhoUKZBdUCzpdsRjtg&_nc_zt=3&_nc_ht=scontent-ams2-1
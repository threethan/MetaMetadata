ohc=h_Oh3bswiEkQ7kNvwEh2IHX&_nc_oc=AdkLxnIdELTPB35sFQ2i44dYgwic2e8-HUJOOyRXTLR1JlAGgBIM5KBe96_96kV0l9g&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfzTtWQMiVtwNloGuSGohXMnccn352kodshDiM6Xh0tEPg&oe=69B02644"}, {"file_name": "5th VR180Immersive.png", "id": "2090833815105853", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499300661_2090833818439186_1967968156153782292_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jVs7hsuVpVcQ7kNvwGA9wnr&_nc_oc=AdnWyOuE_E9rUCl8YDWmeJ5cxQeIbUz3Sa8mPmxD7v-8e5k4DpxYKDDPEgIe53R6PXw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfxYEs82Toc1i2WAhWw3ElxQq9rn6xSQGdqdsZpFSMbpnA&oe=69AFF8CC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Page.png", "id": "1400875321721445", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499622214_1400875325054778_9222754897255830609_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nsHdzkqHLyUQ7kNvwEG1Zpo&_nc_oc=AdlsO6QeRo2o_lKepoBfLAM2LGk_UcLbmJHb2TiR-u7FIdDGqm6hCG_AcBumZfk1A10&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afxfyu7OkQUSMyH_-zrye0BIs-pWk-_uzGluvDxEQpe_sg&oe=69B00274"}, "display_name": "Photon", "keywords": ["immersive", "spatial", "media", "vr180", "video"], "long_description": "# **Photon\uff1aExplore Immersive Media**\n\nDiscover immersive 3D video experiences with **Photon**.\n\nWith **100,000+ immersive videos**, Photon is a leading platform for immersive media discovery and sharing.\n\n{608003995309363}\n\nFrom traveling the world to dancing on stage, from breathtaking nature to city skylines \u2014 everything you can and can\u2019t imagine is here.\n\n# **Feature Highlights**\n\n- **Highest-Quality 8K Immersive Video**\n\nPhoton offers a vast collection of highest-quality 8K immersive videos, optimized for VR immersive viewing.\n\n- **Amazing Immersion Watching Mode**\n\nTry out the immsersion watching mode, which truly augments the immersiveness and make you feel like you're right in the scene.\n\n- **Personalized Feed Tailored to Your Interest**\n\nPhoton learns what you love as you explore. Also, try the search feature to discover your favorite video theme in immersive 3D", "short_description": "Photon\uff1aExplore Immersive Media\n\nDiscover immersive 3D video experiences with Photon.\n\nWith 100,000+ immersive videos, Photon is a leading platform for immersive media discovery and sharing.\n\nFrom traveling the world to dancing on stage, from breathtaking nature to city skylines \u2014 everything you can and can\u2019t imagine is here."}]}, "developer_name": null, "developer_privacy_policy_url": "https://interdime.io/privacy_policy", "developer_terms_of_service_url": null, "publisher_name": "Photon XR", "support_website_url": null, "website_url": "https://photon-xr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}, {"id": "1228796255027646"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24320610474215392"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499619518_4123270897986627_878870589061031530_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gYIY_2aICYcQ7kNvwGibfb9&_nc_oc=AdlyPCEn7jBPsc-9XCDDwhiO7NVVAh71cQWfpoMAxjyiiJKC2GVIT79OOvGZlEjOxgI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfywNSgfvx1DLyrLHqWIX_g2LLx8U8NasbbUPj7Y13PJ6w&oe=69B02C36"}, "is_concept":
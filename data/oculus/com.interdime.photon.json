ohc=N-091fGE4rEQ7kNvwFPcDhH&_nc_oc=AdklCybzwU8fvamEJF80rHEOU0i-TOoysuRgjys84Pk700in8rDfqLZI8O8zzhP2rWU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_Afxs1mvxbSj8XA8ZwHnWlYBDAbYKATwRqLpQzGBJp2ftQw&oe=69B80F44"}, {"file_name": "5th VR180Immersive.png", "id": "2090833815105853", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499300661_2090833818439186_1967968156153782292_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H7ZHaS0HnM0Q7kNvwFlOXJw&_nc_oc=Adk8tCz11UVIaK4DxT-s0ldwxhHjztxo5jxGD19H1YzKT_f9MCyRreAvd5z9Zw9heCs&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfwaJQ2sinIlhY9Q3AwYuR5yqtkurZGZsCpse9cg9_jb6A&oe=69B7E1CC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Page.png", "id": "1400875321721445", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499622214_1400875325054778_9222754897255830609_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H-yEOtH4JI8Q7kNvwE_dmia&_nc_oc=AdmoPm2-vOGaYF3_y-QjCvjE97r1glGQrPuWACRpuXFp5V2I0K9JiXrIb6XkX_2tHvs&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_Afw9DLj1CBjxM6lse2rEOUZR9gfQALGVlgxllhUp8Pv0rw&oe=69B7EB74"}, "display_name": "Photon: Immersive Media", "keywords": ["immersive", "spatial", "media", "vr180", "video"], "long_description": "# **Photon\uff1aExplore Immersive Media**\n\nDiscover immersive 3D video experiences with **Photon**.\n\nWith **100,000+ immersive videos**, Photon is a leading platform for immersive media discovery and sharing.\n\n{778912265286614}\n\nFrom traveling the world to dancing on stage, from breathtaking nature to city skylines \u2014 everything you can and can\u2019t imagine is here.\n\n# **Feature Highlights**\n\n- **Highest-Quality 8K Immersive Video**\n\nPhoton offers a vast collection of highest-quality 8K immersive videos, optimized for VR immersive viewing.\n\n- **Amazing Immersion Watching Mode**\n\nTry out the immsersion watching mode, which truly augments the immersiveness and make you feel like you're right in the scene.\n\n- **Personalized Feed Tailored to Your Interest**\n\nPhoton learns what you love as you explore. Also, try the search feature to discover your favorite video theme in immersive 3D", "short_description": "Photon\uff1aExplore Immersive Media\n\nDiscover immersive 3D video experiences with Photon.\n\nWith 100,000+ immersive videos, Photon is a leading platform for immersive media discovery and sharing.\n\nFrom traveling the world to dancing on stage, from breathtaking nature to city skylines \u2014 everything you can and can\u2019t imagine is here."}]}, "developer_name": null, "developer_privacy_policy_url": "https://interdime.io/privacy_policy", "developer_terms_of_service_url": null, "publisher_name": "Photon XR", "support_website_url": null, "website_url": "https://photon-xr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1228796255027646"}, {"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25910600821883008"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499619518_4123270897986627_878870589061031530_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OwnyJVus0xsQ7kNvwFs-rrx&_nc_oc=Adnk4TeJ58wqA7sf02hWfAGHVueLsIQwtbvdssnjI0D521W21XYfoqoNTA1tE_uWpZI&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afxj6dR6zOF4BB0wHDiwBQTWocrNvVDB_Ld7cisUDm5PmA&oe=69B81536
TkK1RuQxaHCURYVIFJUg&oe=69E38D5B"}, {"file_name": "4.png", "id": "1138037547199198", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982528_1138037550532531_2129675455260440387_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Tm6L57W9OaoQ7kNvwE7Kjq0&_nc_oc=Adr_No-ynbxC94ZSMjCjr2wd5jvJPbmioW9XBAW7f51XL4LY6-MnR7Evc17Q1nvVIg0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0B8bd2KGfTwxLXvzA_0Ve5IBpZI2LrEoZV3XfYCq1H5w&oe=69E394C6"}, {"file_name": "5.png", "id": "784346953613312", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031656_784346956946645_3672269840944028680_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YNzwM18_VEQQ7kNvwFCzjKz&_nc_oc=AdpkKUoETCiw3xkw3IGP6FiuQUP1dnpfEUCzGALjr2fOPmCb8uGKGHY1JGSrq6t9cMw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1PdaE6jWkQIVYty3Ym2VO-bxpDGs_nCo_q5wnVtaFoZw&oe=69E3966C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Image.png", "id": "1814482289037366", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031591_1814482292370699_3993773763026546135_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KtZfBCKpYEgQ7kNvwF_0v6_&_nc_oc=AdoP5r9XDvQWdyF_Io_Cx9regqHfNd7ItCmOcrE55aEvY8Qp8ejj-eFJ91i3TZ_a3JU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1SCmfRYBSzKiisgKXKjEbKftbHaMLp00QDFJyF3KAFUA&oe=69E39581"}, "display_name": "DreaMR: S. Rachmaninoff Preludes Op. 32 N1- 5 and N10 Mixed Reality (MR) scenes", "keywords": [], "long_description": "\nS. Rachmaninoff is a Russian/American composer, who emigrated to the USA after the Soviet revolution in 1918. Born 1873 in Semyonovo, near Novgorod, 400 miles north-west Moscow, at his family\u2019s estate, Rachmaninoff  was from a noble family of Tatar descent.  His mother started to teach him piano at the age of 4. Arkady Rahcmaninoff, the composer\u2019s grandfather, learned piano with the Irish composer John Field. \n\nRachmaninoff frequently drew inspiration from nature and folklore in his compositions. His second book of Preludes Op. 32 (the first was Op. 23)  was written in the summer of 1910 at his family \u2018s idyllic country house in Ivanovka, a sleepy, rural area, surrounded by nature.  \n\n\u201cExploring Dreaming with Mixed Reality\u201d (DreaMR) engages with the human experience of dreaming through art, music and consciousness science. Using cutting-edge Mixed Reality (MR), we approach dreaming like surrealist paintings: experiences that reside halfway between the visible and the invisible. MR technology is uniquely suited for this purpose, because it positions the audience not within a virtual world (like VR technology does) but in a liminal space that blends the real with the un-real, the conscious with the unconscious, the physical world with the world of dreams.\n", "short_description": "\u201cExploring Dreaming with Mixed Reality\u201d (DreaMR) engages with the human experience of dreaming through art, music and consciousness science. Using cutting-edge Mixed Reality (MR), we approach dreaming like surrealist paintings: experiences that reside halfway between the visible and the invisible. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.hauntedplanet.com/privacy/rachmaninoff-preludes", "developer_terms_of_service_url": null, "publisher_name": "Haunted Planet", "support_website_url": null, "website_url": "https://hauntedplanet.com/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["ROOM_SCALE"]
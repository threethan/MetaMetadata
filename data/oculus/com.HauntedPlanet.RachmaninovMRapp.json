g6W4BemwWvhsohN8veVVpX0qjpwCMMCklo&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEBIKi_N7DLudSxLylh2MOPWw-480tqoKzxeJmKxCWOgw&oe=6A93FE1B"}, {"file_name": "4.png", "id": "1138037547199198", "uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/38982528_1138037550532531_2129675455260440387_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zSzyrSjNBQ8Q7kNvwFDz1KZ&_nc_oc=AdoJOZiey_eCFUjcdGyWjs-8Z9EdXRasbBa7-DzYbPmW3-VQ1gQzmpt-Bm_0OwNumOE&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGBKRLKlqGd7SIc1sXpjg_OQI85dudmloyHMR7dSjkJVg&oe=6A940586"}, {"file_name": "5.png", "id": "784346953613312", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/39031656_784346956946645_3672269840944028680_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6Kpkf9z27VUQ7kNvwEJPvau&_nc_oc=AdrjNxRvcvDWqO9IfbZqZwL6w8sc5Dzp76675s2TX2I7cZmGbe5_3jjZ3cFJLTK7blQ&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGwVQkra_sc6DSt5NOpQAC-jZkz-XkYhu7tZg38Z1Xzhw&oe=6A94072C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Image.png", "id": "1814482289037366", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/39031591_1814482292370699_3993773763026546135_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lglqeUGG9SMQ7kNvwGRk-Tv&_nc_oc=Adq_xYvCaWo82jK3eJJdVXfIA-s0yhtThBCN17hUsStLnDC3ShBolOTKNkufCeIxtyw&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGvFXKBTVeeMfQs_CD4PDAH8a2CdbRBLaCO3ABJYu3AhQ&oe=6A940641"}, "display_name": "DreaMR: S. Rachmaninoff Preludes Op. 32 N1- 5 and N10 Mixed Reality (MR) scenes", "keywords": [], "long_description": "\nS. Rachmaninoff is a Russian/American composer, who emigrated to the USA after the Soviet revolution in 1918. Born 1873 in Semyonovo, near Novgorod, 400 miles north-west Moscow, at his family\u2019s estate, Rachmaninoff  was from a noble family of Tatar descent.  His mother started to teach him piano at the age of 4. Arkady Rahcmaninoff, the composer\u2019s grandfather, learned piano with the Irish composer John Field. \n\nRachmaninoff frequently drew inspiration from nature and folklore in his compositions. His second book of Preludes Op. 32 (the first was Op. 23)  was written in the summer of 1910 at his family \u2018s idyllic country house in Ivanovka, a sleepy, rural area, surrounded by nature.  \n\n\u201cExploring Dreaming with Mixed Reality\u201d (DreaMR) engages with the human experience of dreaming through art, music and consciousness science. Using cutting-edge Mixed Reality (MR), we approach dreaming like surrealist paintings: experiences that reside halfway between the visible and the invisible. MR technology is uniquely suited for this purpose, because it positions the audience not within a virtual world (like VR technology does) but in a liminal space that blends the real with the un-real, the conscious with the unconscious, the physical world with the world of dreams.\n", "short_description": "\u201cExploring Dreaming with Mixed Reality\u201d (DreaMR) engages with the human experience of dreaming through art, music and consciousness science. Using cutting-edge Mixed Reality (MR), we approach dreaming like surrealist paintings: experiences that reside halfway between the visible and the invisible. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.hauntedplanet.com/privacy/rachmaninoff-preludes", "developer_terms_of_service_url": null, "publisher_name": "Haunted Planet", "support_website_url": null, "website_url": "https://hauntedplanet.com/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_
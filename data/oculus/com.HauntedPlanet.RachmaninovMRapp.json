81OXOOILt146reLknBqzAMqkEZWkAyw7QY&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEr9W9KHrDJRpgL2eaRxMwMOSNS7xSTFl4cG2CkVJLzBA&oe=6A86CF1B"}, {"file_name": "4.png", "id": "1138037547199198", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38982528_1138037550532531_2129675455260440387_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mK3LGyzQhc4Q7kNvwEew4m0&_nc_oc=Adpa7Ay0w6bCAL67xmhOXttS_-MFkg7HIl16LdMuob3iADmr9nt_FZSrR42CSwIL08M&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFM1DZfT5wWELOO0Yub4pg93mW6FkqS4ail0vlyeug5Ew&oe=6A86D686"}, {"file_name": "5.png", "id": "784346953613312", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39031656_784346956946645_3672269840944028680_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jIb-j5yhmREQ7kNvwGPPHDw&_nc_oc=Adrsjvyesa6Yvu4jYQk1_HSAMyFMt2CwGoZiTxvdmbBiLylT_8qNRRLeCrWSjjDxFjY&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHbOWoU-pgkIC96sGFLs4GMIM_-m2PQ9GDF7CdUpWUW7w&oe=6A86D82C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Image.png", "id": "1814482289037366", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39031591_1814482292370699_3993773763026546135_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zf2Bj-4aGGQQ7kNvwFH7tT1&_nc_oc=AdpKZudizI9X388nekGvHpa8lNhoNBCZ91_8JZFhYqhcuN_Oi9kNqKo85bWfV7GpwsQ&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHq2KkJDtahaG9IHOABFVDEedQB7tkrAhpRsKU0gXywWg&oe=6A86D741"}, "display_name": "DreaMR: S. Rachmaninoff Preludes Op. 32 N1- 5 and N10 Mixed Reality (MR) scenes", "keywords": [], "long_description": "\nS. Rachmaninoff is a Russian/American composer, who emigrated to the USA after the Soviet revolution in 1918. Born 1873 in Semyonovo, near Novgorod, 400 miles north-west Moscow, at his family\u2019s estate, Rachmaninoff  was from a noble family of Tatar descent.  His mother started to teach him piano at the age of 4. Arkady Rahcmaninoff, the composer\u2019s grandfather, learned piano with the Irish composer John Field. \n\nRachmaninoff frequently drew inspiration from nature and folklore in his compositions. His second book of Preludes Op. 32 (the first was Op. 23)  was written in the summer of 1910 at his family \u2018s idyllic country house in Ivanovka, a sleepy, rural area, surrounded by nature.  \n\n\u201cExploring Dreaming with Mixed Reality\u201d (DreaMR) engages with the human experience of dreaming through art, music and consciousness science. Using cutting-edge Mixed Reality (MR), we approach dreaming like surrealist paintings: experiences that reside halfway between the visible and the invisible. MR technology is uniquely suited for this purpose, because it positions the audience not within a virtual world (like VR technology does) but in a liminal space that blends the real with the un-real, the conscious with the unconscious, the physical world with the world of dreams.\n", "short_description": "\u201cExploring Dreaming with Mixed Reality\u201d (DreaMR) engages with the human experience of dreaming through art, music and consciousness science. Using cutting-edge Mixed Reality (MR), we approach dreaming like surrealist paintings: experiences that reside halfway between the visible and the invisible. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.hauntedplanet.com/privacy/rachmaninoff-preludes", "developer_terms_of_service_url": null, "publisher_name": "Haunted Planet", "support_website_url": null, "website_url": "https://hauntedplanet.com/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_
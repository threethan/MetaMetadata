enshots": [{"file_name": "vlcsnap-2026-06-30-15h12m55s759.png", "id": "1006664482120365", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499620444_1006664485453698_5183649842075361359_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1O0IvqKvD3IQ7kNvwHgD9gC&_nc_oc=Adq9Cv09jsSVXT8QKHPuW6kLyuzbnEWEFSGBmmdRMJaa5SUN1HVLRCwMmJdRukl2jz8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGoDIrbkq2LXy5UGMGn7P9Q_vps4uynk-idQjMrSk47PQ&oe=6A771996"}, {"file_name": "vlcsnap-2026-06-30-15h15m47s788.png", "id": "1685238999365280", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/618758916_1685239002698613_4069614153374924817_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tegGsts_9AkQ7kNvwGBfeBs&_nc_oc=AdrphVpCPOaKWoZoDMX3nFeIs1E4mfVHZQTTasEMoJXF1VZMmQG68hn1Qj11OXCNoFM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHKdNg63sS19Ljp2Xb-TgtQkYjUneIZfBDfU6nkB1xyMA&oe=6A7736D8"}, {"file_name": "vlcsnap-2026-06-30-15h13m56s886.png", "id": "1761994961455788", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/507830485_1761994968122454_3232782798798924465_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0lljf2RCmygQ7kNvwHHipTW&_nc_oc=AdrIB95GxQmhqOdlggK1Wr8O_3ElMiqF1eskRRktw3AA2JqMECVNkpYHR2qCZfEAvqY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHjcxvTr140-gQ_GAVg_jCC9d9fwQ3Dt97mUVLrJ1P3YA&oe=6A770EFF"}, {"file_name": "vlcsnap-2026-06-30-15h12m13s016.png", "id": "2068632200407583", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/604366035_2068632203740916_821920492553775547_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fR7nKQZMFp0Q7kNvwFbSdGM&_nc_oc=AdqyMJImWMKMRDqFnXnwcbYLauNzPy0bkhH_RcfcsSkDLjloUrDENeYJonOkSp5G1n0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFcKkB4pxZfUjNwSCyiziJwCaNnHJ9blFMEftJnJJxqEg&oe=6A7741C5"}, {"file_name": "vlcsnap-2026-06-30-15h17m43s001.png", "id": "1568012034662681", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/507828592_1568012047996013_1316555124927519862_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-KTizMSYR88Q7kNvwE38bez&_nc_oc=Adplt3_9QhWHc7SVFU6rxtsF7jt4v8geFZTlfWqq1oEZBBUhrQCv39LHtp0sHbIjq4k&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGJAzOLpDge435qECgBzdKjfh7yP5XkpTiCO7WipNEJkQ&oe=6A772BBC"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Trancespace", "keywords": ["Trancespace", "MixedReality", "MR", "Music", "MixedRealityMusic"], "long_description": "# Trancespace\n\n**Transform your room into musical experience**\n\nTrancespace is an immersive, mixed reality ambient entertainment experience that transforms your ordinary physical room into an intelligent, fantasy musical sanctuary. Featuring an original, custom-produced musical score and deeply integrated spatial interactions, Trancespace moves far beyond passive listening, it turns the space around you into the performance itself.\n\n## What Makes Trancespace Different\n\nMost music and ambient experiences ask you to watch a screen. Trancespace asks your room to become part of the show. Step inside, and the boundaries between \"your home\" and \"the experience\" start to dissolve  light, color, and motion ripple across real surfaces, choreographed to an original soundtrack composed specifically for this world.\n## Features\n\n- **Original, Custom-Produced Score** : A fully original musical score, composed and produced exclusively for Trancespace, drives every visual moment.\n- **Living, Breathing Environments** : Every surface becomes part of a fantasy musical sanctuary that pulses, flows, and responds in real time not a static visual, but a space that feels alive.\n- **Deep Spatial Interaction** : Designed from the ground up for mixed reality, with interactions tied directly to your physical environment rather than a virtual stage.", "short_description": "Escape into wonder. Trancespace dissolves your walls and fills your space with a reactive, cosmic mixed reality  musical world."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.vrbirdstudios.com/privacy", "developer_terms_of_service_url": "https://www.vrbirdstudios.com/terms", "publisher_name": "VR Bird Studios", "support_website_url": null, "website_url": "https://www.vrbirdstudios.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}, {"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1237174889470613"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499622334_1506465764827969_9141370442806489566_n.png?stp=dst-png_s360x360&_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qnJYuOqBukMQ7kNvwFwwWLt&_nc_oc=AdqvDU7YYvD9oocEz3Lt_q_tJTEx_Wzkwsn8jJ4KBVJhNJh6l4VdEFX38rPG_ZlK0z4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH_RW78kFhp2b-KWmHP6r7bRvH_WPJbewabKBtJKuP5jQ&oe=6A770FE1"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Trancespace", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_name": "Fitness & Wellness", "id": "810139357995560"}, {"topic_name": "Media", "id": "434961926215971"}], "release_date": 1781704920, "lastRevision": {"nodes": [{"id": "1199664449888324", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"de
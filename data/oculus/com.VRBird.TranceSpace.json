c_sid=6e7a0a&_nc_ohc=lCKwNtjWg78Q7kNvwHrVmeP&_nc_oc=AdoTRReGqDY39Pl-9q1Me6ZZG7uODD-7CSS2UFKvzyW2nMZYj5od0496XBz2OVez5b0&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9zdQJxt13SvWsdLULOFCk8y4rzwHKcci8x6eXjy-fP_Q&oe=6A43DAA6"}, {"file_name": "vlcsnap-2026-06-12-07h19m19s803.png", "id": "1553899609459512", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491825503_1553899612792845_6152420775510034607_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QExT2zZst2AQ7kNvwGJnof1&_nc_oc=Adr5hfZfkpjWa9LLig2tdL9HIW1cYmcTNA9Ab4zqAvx9Wn69ANaqwULLFTkfJSXO__w&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9ppQTVzt4pRTRtOOqN0niUdfiAGzcsLUwKiU1Zoc_xfw&oe=6A43DC06"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Trancespace", "keywords": ["Trancespace", "MixedReality", "MR", "Music", "MixedRealityMusic"], "long_description": "# Trancespace \u2013 Aurora Edition\n\n*Your room. The cosmos. One breath away.*\n\nTrancespace Aurora Edition transforms your everyday surroundings into a living, breathing universe  a mixed reality experience where the walls of your room dissolve into deep space, and every beat, pulse, and wave of music shapes the cosmos around you.\n\nDesigned for those who seek stillness in sound and wonder in the everyday, Trancespace is not just something you listen to it's something you inhabit.\n\n---\n\n## What Is Trancespace?\n\nUsing your device's mixed reality capabilities, Trancespace maps your physical space and replaces it with a reactive cosmic environment. \n\nLay back. Look up. Let go.\n\n---\n\n## Features\n\n\ud83c\udf0c **Reactive Virtual Space:**\nYour room becomes a dynamic cosmic canvas with celestial elements like aurora.\n\n\ud83c\udfb5 **Original Space Music:**\nAn immersive, original soundtrack composed to evoke awe, calm, and weightlessness. Each track is crafted to guide you deeper into the experience.\n\n\ud83d\udc41 **Passthrough Awareness:**\nStay grounded while leaving the world behind. Passthrough mode lets you remain aware of your physical surroundings while the cosmos unfolds around you  the perfect balance of presence and escape.\n\n---\n\n## Perfect For\n\n- Meditation & mindfulness sessions\n- Stress relief and deep relaxation\n- Creative focus and flow states\n- Sensory experiences before sleep\n\n---\n\n*Trancespace Aurora Edition. The universe, in your room.*\n", "short_description": "Step inside the music. Trancespace dissolves your walls and fills your space with a reactive, cosmic mixed reality world."}]}, "developer_name": null, "developer_privacy_policy_url": "https://trancespace-flax.vercel.app/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "VR Bird", "support_website_url": null, "website_url": "https://trancespace-flax.vercel.app/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}, {"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1210820962106006"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499311582_1573543091057727_7598750505670462239_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7V8EakUBWPQQ7kNvwFxu3_d&_nc_oc=AdoSl0bQmFHOLj2AuXIjsPrFtls0knqRcIBAVXK3ikB9u8lGnXlWMQQR4CvYQNvcMcc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8jXCx7agXNu-OfMeVfhR5Z9XWBGXoTFg1z8fS0RH-4_g&oe=6A43D091"}, "is_co
nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEKPltLS8TwkCRBI8asvg8qX3pcav8otQk0BwT5JyD0-Q&oe=6A770D61"}, {"file_name": "vlcsnap-2026-06-12-07h19m23s145.png", "id": "1657294712215156", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491821796_1657294718881822_6952051403662590358_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3l1sALR2M8YQ7kNvwH0lL1x&_nc_oc=AdpMUUZfK_HXf9G7lipW4KYQRp-y4fzJI1QE8XLkAuViVnw4RicPZmc5I4nmVrda4Ms&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGUEKQ7ziyqf6FgI9oaCagduTc74L1iEC_KdAM2FOKDpg&oe=6A774526"}, {"file_name": "vlcsnap-2026-06-12-07h19m19s803.png", "id": "1553899609459512", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491825503_1553899612792845_6152420775510034607_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VJJh12YQIdEQ7kNvwFDZlAO&_nc_oc=AdqEIn3bl-rzYb_efTT15Wfp4g6oRkPnjrALKeYgzpMljFVm5uNzahwk7WyT2jPQylA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEYjCIKU-cgSLvtSBp_Xb-VVRq-_wgv8gBJzNen-QPS0Q&oe=6A770E46"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Trancespace", "keywords": ["Trancespace", "MixedReality", "MR", "Music", "MixedRealityMusic"], "long_description": "# Trancespace \u2013 Aurora Edition\n\n*Your room. The cosmos. One breath away.*\n\nTrancespace Aurora Edition transforms your everyday surroundings into a living, breathing universe  a mixed reality experience where the walls of your room dissolve into deep space, and every beat, pulse, and wave of music shapes the cosmos around you.\n\nDesigned for those who seek stillness in sound and wonder in the everyday, Trancespace is not just something you listen to it's something you inhabit.\n\n---\n\n## What Is Trancespace?\n\nUsing your device's mixed reality capabilities, Trancespace maps your physical space and replaces it with a reactive cosmic environment. \n\nLay back. Look up. Let go.\n\n---\n\n## Features\n\n\ud83c\udf0c **Reactive Virtual Space:**\nYour room becomes a dynamic cosmic canvas with celestial elements like aurora.\n\n\ud83c\udfb5 **Original Space Music:**\nAn immersive, original soundtrack composed to evoke awe, calm, and weightlessness. Each track is crafted to guide you deeper into the experience.\n\n\ud83d\udc41 **Passthrough Awareness:**\nStay grounded while leaving the world behind. Passthrough mode lets you remain aware of your physical surroundings while the cosmos unfolds around you  the perfect balance of presence and escape.\n\n---\n\n## Perfect For\n\n- Meditation & mindfulness sessions\n- Stress relief and deep relaxation\n- Creative focus and flow states\n- Sensory experiences before sleep\n\n---\n\n*Trancespace Aurora Edition. The universe, in your room.*\n", "short_description": "Step inside the music. Trancespace dissolves your walls and fills your space with a reactive, cosmic mixed reality world."}]}, "developer_name": null, "developer_privacy_policy_url": "https://trancespace-flax.vercel.app/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "VR Bird", "support_website_url": null, "website_url": "https://trancespace-flax.vercel.app/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}, {"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1210820962106006"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1476409600833901"}]}, "baseline_offer": {
vwHbWWvW&_nc_oc=Adr3naC7LRVRK6acP3XU9TVUq1HvklJGRdpLerTrADep6eJxIBC-Tt4w0-N1RhvLGjI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRWmoCYnBBr8WG66VnZBJuHL5qiILyOWms9Es6f53dSWw&oe=6B05A354"}, {"file_name": "ShineVR_AppSubmissionAssets_V1.0_screenshot_3.png", "id": "1045262316534965", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75223483_1045262319868298_6212579266467961012_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UGJ5MX8r3jAQ7kNvwHXDWD_&_nc_oc=AdoJreNfjrnBIkyZHKwXgWE4s5GVzTgon8LPQmiHcfPmlAWgtEP--ENzU9_sKSR3jtc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSRE2S1IpfFxRV8yE_IZopaCyf6eLLlKRENL2a6fM5KJQ&oe=6B05BCB8"}, {"file_name": "ShineVR_AppSubmissionAssets_V1.0_screenshot_5.png", "id": "1343908926296093", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982688_1343908929629426_40513083260712773_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WtfkNA6HUa4Q7kNvwGsfzSW&_nc_oc=Adorw8leVbwnEFZRShnkyEU7fegARlGTRtInpFmi2v1gUsm0ekPJKWcVd0ciFSToFlA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSd-PTEZ1b9_fS0D6irT26rgdp1TLRpdhAeKDn0KR7-Hg&oe=6B05B204"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ShineVR_AppSubmissionAssets_V1.0_screenshot_1.png", "id": "700116819004188", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75278190_700116822337521_2144700685776213389_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QxwekyvqfjQQ7kNvwEOiULF&_nc_oc=Adqzq2_KTDIt7B3w5p90xm-B1t8Imp1k2MY53afTuTDmkLURPURBvoPGFnYghyZZH2w&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSFXkXN8uyLsSrm4pubZk3l2apZRwjKREw52elQu45L-A&oe=6B05D8EB"}, "display_name": "ShineVR", "keywords": [], "long_description": "ShineVR is an immersive Cognitive Behavioural Therapy (CBT) platform delivering data driven, personalised programmes for Enterprise and Healthcare customers.\n\nThe platform consists of a series of immersive spaces, each containing activities based on evidence informed techniques.  Personalised programmes deliver guided paths through activities designed to achieve an outcome.\n\nFor the Enterprise customer, our ShineVR Wellbeing programme has been proven to reduce stress (70% trended downward for stress), increase wellness (60% trended upwards for wellness), improve job satisfaction, working memory and cognition. Our customer feedback survey reported a 98% satisfaction with ShineVR.\n\nFor the Healthcare customer, ShineVR Chronic Pain is in development for the treatment of Chronic Lower Back Pain. Our televised pilot study showed a reduction of 33% in pain perception with our target patient. ShineVR Chronic Pain is in development, and actively recruiting pilot study participants.", "short_description": "ShineVR is an immersive Cognitive Behavioural Therapy (CBT) platform delivering data driven, personalised experiences for Enterprise and Healthcare customers. The platform consists of a series of immersive spaces, each containing activities based on evidence informed techniques.  Personalised programs deliver guided paths through activities designed to achieve an outcome."}]}, "developer_name": "ShineVR", "developer_privacy_policy_url": "https://vstream.ie/privacy-policy/", "developer_terms_of_service_url": "https://vstream.ie/terms-of-use/", "publisher_name": "ShineVR", "support_website_url": null, "website_url": "https://shine-vr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "478089301798119"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "suppor
045262316534965", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75223483_1045262319868298_6212579266467961012_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9onaDMrL-KMQ7kNvwHYEU6R&_nc_oc=Ado8nPzus-GrR8kgiO477qMPo8lbMIuTfMTrNgtJjpEaiHYSTrcE744w0IMUXmVYYJs&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQED4u9nRozeAKlqdKHF9v7vghDZoxsMlqtM_9JmxR6cTQ&oe=6A86F478"}, {"file_name": "ShineVR_AppSubmissionAssets_V1.0_screenshot_5.png", "id": "1343908926296093", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38982688_1343908929629426_40513083260712773_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IGxrHXgvvlQQ7kNvwEN9SPQ&_nc_oc=AdovAJIWbqjd1YD8XFg3G74hj_xUfFB4YgqTkExf4OngIWPXVwV1TkN1ogVHBfO9gGA&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHYLvlVOY6Moz9mQw3XZjZGWKM_E7LTUdrIbUz2BU9zgA&oe=6A86E9C4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ShineVR_AppSubmissionAssets_V1.0_screenshot_1.png", "id": "700116819004188", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/75278190_700116822337521_2144700685776213389_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y1d4oS_QkoEQ7kNvwHRY-KN&_nc_oc=Adqg9G9Tw65MvD3rcx_GeYNyU7cc8CX1qLyn3uYmcEC-Nti2VA_B02FENvbq14jSDXE&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHjqTyFWI_9QPVGghTXMbv-KNoSlWkXCMy4FSZfWjuigw&oe=6A86D86B"}, "display_name": "ShineVR", "keywords": [], "long_description": "ShineVR is an immersive Cognitive Behavioural Therapy (CBT) platform delivering data driven, personalised programmes for Enterprise and Healthcare customers.\n\nThe platform consists of a series of immersive spaces, each containing activities based on evidence informed techniques.  Personalised programmes deliver guided paths through activities designed to achieve an outcome.\n\nFor the Enterprise customer, our ShineVR Wellbeing programme has been proven to reduce stress (70% trended downward for stress), increase wellness (60% trended upwards for wellness), improve job satisfaction, working memory and cognition. Our customer feedback survey reported a 98% satisfaction with ShineVR.\n\nFor the Healthcare customer, ShineVR Chronic Pain is in development for the treatment of Chronic Lower Back Pain. Our televised pilot study showed a reduction of 33% in pain perception with our target patient. ShineVR Chronic Pain is in development, and actively recruiting pilot study participants.", "short_description": "ShineVR is an immersive Cognitive Behavioural Therapy (CBT) platform delivering data driven, personalised experiences for Enterprise and Healthcare customers. The platform consists of a series of immersive spaces, each containing activities based on evidence informed techniques.  Personalised programs deliver guided paths through activities designed to achieve an outcome."}]}, "developer_name": "ShineVR", "developer_privacy_policy_url": "https://vstream.ie/privacy-policy/", "developer_terms_of_service_url": "https://vstream.ie/terms-of-use/", "publisher_name": "ShineVR", "support_website_url": null, "website_url": "https://shine-vr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "478089301798119"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9989676084395977"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "3766908416873932"}]}, "baseline_offer": {"id": "3766908416873932"}, "is_approved": true, "firstO
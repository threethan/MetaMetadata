f20f&oh=00_AQBtmnR6UG3_CnjI0In_no1ksqNDAwFAdnevO0EO4Tixfw&oe=6A58D8BE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Ekran g\u00f6r\u00fcnt\u00fcs\u00fc 2024-12-25 185538.png", "id": "3989187274703151", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/39031598_3989187281369817_4372558138359517664_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AKGIicp226kQ7kNvwFc3b1w&_nc_oc=AdoS_X_St_bql2t-jsYriIYKjBZY6qw3G_3lOmExemiv1FPFm_5FjaZMcxQt6H1LDlg&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCQ55i0z1ZLXOdNiQw2Ak2VTZvw_SZY9HwL6OBJQwj85g&oe=6A58DB3C"}, "display_name": "Monster Trap", "keywords": ["Advanture", "SinglePlayer", "NoInternet", "Fun"], "long_description": "Step into the darkly enchanting world of \"Monster Trap: Halloween Special,\" a thrilling VR game crafted exclusively for Meta Quest. Set against a backdrop of glowing jack-o'-lanterns, eerie purple skies, and swirling fog, this Halloween-themed adventure delivers the perfect balance of fright and fun. You\u2019ll face clever, mischievous monsters trapped in high-tech Halloween devices, while navigating through spooky landscapes adorned with ghosts, bats, and pumpkins.\n\nThis immersive experience isn\u2019t just about scares; it\u2019s about strategy and quick thinking. Each level is packed with puzzles, traps, and hidden secrets, challenging you to outsmart the monsters and unravel the mystery of the Halloween curse. The vibrant, cartoonish visuals combined with the chilling ambiance create a unique blend of festive excitement and suspense.\n\nWhether you're a fan of horror games or simply love Halloween, \"Monster Trap: Halloween Special\" offers hours of heart-pounding entertainment. Get ready to be captivated, scared, and delighted as you tackle the ultimate Halloween VR adventure!", "short_description": "Dive into the chilling world of \"Monster Trap: Halloween Special,\" a spine-tingling VR experience designed for Meta Quest. Navigate eerie environments filled with glowing jack-o'-lantern traps, mischievous monsters, and haunting Halloween elements. With a mix of playful scares and strategic challenges, this game will keep you on edge while embracing the festive Halloween spirit. Perfect for fans of horror and fun, immerse yourself in the ultimate spooky adventure this season!\n\n"}]}, "developer_name": "Esti Soft", "developer_privacy_policy_url": "https://drive.google.com/file/d/1nRyME7ipZKdK4JPdh6Aza7RPKWnEWmNI/view", "developer_terms_of_service_url": null, "publisher_name": "Esti Soft", "support_website_url": null, "website_url": "https://www.bilgiplatformu.net/post/monster-trap", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1676485315806614"}, {"id": "528142316460358"}, {"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "GAMEPAD"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "28595607526696944"}}]}, "scheduled_offers": {"count": 7, "nodes": [{"status": "PUBLISHED", "id": "2363685484140335"}, {"status": "PUBLISHED", "id": "1209372877229684"}, {"status": "PUBLISHED", "id": "1331926821669857"}, {"status": "PUBLISHED", "id": "1048234390607276"}, {"status": "PUBLISHED", "id": "2647915788732339"}, {"status": "PUBLISHED", "id": "1136091375205049"}, {"status": "PUBLISHED", "id": "3550942451715801"}]}, "baseline_offer": {"id": "1136091375205049"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1779303600, "status": "PUBLISHED", "id": "2363685484140335"}]}, "liveChannel"
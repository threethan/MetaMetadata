s7Yren3F_piCazepEhq8zMCEfR9jzfU5AT--nOG9VGzrACg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFdlPQ3l9ENIdijYvlDHSmotKqnH8M16Be6SARUumqDtg&oe=6A70A797"}]}, "id": "2034939590375472", "locale": "en_US", "screenshots": [{"file_name": "9603eddb0188a7a537f84f86f6c4599d.png", "id": "25704157852506413", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491820387_25704157869173078_3708262785954432587_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=drWPfEzxtxQQ7kNvwFdGo4m&_nc_oc=Adrq64GjfJOZ1tSQn4wdnJQNx3MdLb0PRAnvi9EpJDUfTJCJWTp19tjFQLBEFfTk73Q&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGtxrMB15SvF8CyyDmfktvaBqO4DzTN2XXK9b0j_qxsrA&oe=6A70A510"}, {"file_name": "2670642f1fc55466a33f91097d69cbe6.png", "id": "758824766976275", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491819239_758824770309608_7039361326849792567_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3ZOFmQUYwRIQ7kNvwHPz2v4&_nc_oc=Ado6zMr6b3df9V2zRXcMe9VaL9f9ogulZjzfkYxqPHBKZPmhiJrmkOnXdIoC9-znPz0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE0dczrNKaL5pSD3n3M3cZlutZDbqZOwHQtEkvb5R2M3w&oe=6A708A77"}, {"file_name": "e248bb65ca1e21ac1382ef150e414feb.png", "id": "1435323334196413", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491818852_1435323337529746_4778664912721487512_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QFFCl9Ur3BMQ7kNvwGVMzfW&_nc_oc=AdobrICFh-gHMoyX-6F6bPtAipP5KP4rUsWJ3L57MJHADsSEiEX96OqJ4w3hm1m8QrI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEBExQL2J8yqhQJV44psWRTt4v6SK3WHBBgjaIr3Ykttg&oe=6A709502"}, {"file_name": "c36ea2d732f42910567e37a71b90b6fa.png", "id": "1348255306953872", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491819239_1348255310287205_4580421486835341359_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2bZ-omTJz5QQ7kNvwG-ZuGM&_nc_oc=AdpOO6AG1T3KNka_g2ryI-HxbznC5OLIeO9TumuWuTEuUA2i4evn7TqBozPWSLkLiP4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG6vcwuFgJAUYbzfYq-SFUd5Y8vJEI8QsRLYO_Aj034Tw&oe=6A70A59A"}, {"file_name": "1414953ee184d1b4664783e8733de8d2.png", "id": "1085351793679813", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823746_1085351797013146_2116530631119330818_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zKC9nZZgNusQ7kNvwEQaWyM&_nc_oc=Ado4o7OBqaeZ6zP6bA7UBWE9Hqd9A7eA_OewdXY9uz_JdWxkc0907dFEKa2-FsjIE0Y&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHP1OpJQDmy_FkOVtGiAcnMA38i_RykMwCFpzpBbfT9pA&oe=6A70A868"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Doll Play Helper", "keywords": ["MR", "Doll", "Sandbox", "Play"], "long_description": "Doll Play Helper is an experimental mixed reality sandbox for doll collectors and creative enthusiasts.\nDesign and customize beautiful virtual rooms and interiors for your real dolls using a wide library of furniture and decor objects \u2014 all in your real space, thanks to MR on Meta Quest!\n\nNo more cardboard houses or expensive accessories: simply place your dolls in the real world, and build their perfect digital environment around them.\n\n**Key Features:**\n- Intuitive MR interface for Meta Quest (controllers + hand tracking)\n-Drag-and-drop furniture and decor objects into your real space\n- Save, load, and manage your custom rooms\n- Search and filter your object library\n- Delete, move, and arrange items to your liking\n -Optimized for play with real dolls: combine physical and virtual worlds!\n\n**Who is it for?**\n\n- Doll collectors (Barbie, Monster High, BJD, MLP, etc.)\n\n- Kids, parents, and creative adults who love to build and decorate\n\n- Anyone wanting to experiment with MR and personal creative spaces\n\n**Early Access / Experimental:**\n\nThis is an early prototype made for creative fun and feedback from the community.\nIf you have ideas, requests, or find bugs, please let me know \u2014 your feedback is very welcome!", "short_description": "Create unique virtual rooms for your real dolls in mixed reality!"}, {"images": {"nodes": []}, "id": "1497125864548266", "locale": "ru_RU", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "\u041f\u043e\u043c\u043e\u0449\u043d\u0438\u043a \u0438\u0433\u0440\u044b \u0441 \u043a\u0443\u043a\u043b\u0430\u043c\u0438", "keywords": ["\u0421\u043c\u0435\u0448\u0430\u043d\u043d\u0430\u044f", "\u0440\u0435\u0430\u043b\u044c\u043d\u043e\u0441\u0442\u044c", "\u041f\u043e\u043c\u043e\u0449\u043d\u0438\u043a", "\u0438\u0433\u0440\u044b", "\u043a\u0443\u043a\u043b\u044b"], "long_description": "\"\u041f\u043e\u043c\u043e\u0449\u043d\u0438\u043a \u0432 \u0438\u0433\u0440\u0435 \u0441 \u043a\u0443\u043a\u043b\u0430\u043c\u0438 \u2014 \u044d\u0442\u043e \u044d\u043a\u0441\u043f\u0435\u0440\u0438\u043c\u0435\u043d\u0442\u0430\u043b\u044c\u043d\u0430\u044f \u043f\u0435\u0441\u043e\u0447\u043d\u0438\u0446\u0430 \u0441\u043c\u0435\u0448\u0430\u043d\u043d\u043e\u0439 \u0440\u0435\u0430\u043b\u044c\u043d\u043e\u0441\u0442\u0438 \u0434\u043b\u044f \u043a\u043e\u043b\u043b\u0435\u043a\u0446\u0438\u043e\u043d\u0435\u0440\u043e\u0432 \u043a\u0443\u043a\u043e\u043b \u0438 \u043b\u044e\u0431\u0438\u0442\u0435\u043b\u0435\u0439 \u0442\u0432\u043e\u0440\u0447\u0435\u0441\u0442\u0432\u0430.\n\u0421\u043e\u0437\u0434\u0430\u0432\u0430\u0439\u0442\u0435 \u0438 \u043d\u0430\u0441\u0442\u0440\u0430\u0438\u0432\u0430\u0439\u0442\u0435 \u043a\u0440\u0430\u0441\u0438\u0432\u044b\u0435 \u0432\u0438\u0440\u0442\u0443\u0430\u043b\u044c\u043d\u044b\u0435 \u043a\u043e\u043c\u043d\u0430\u0442\u044b \u0438 \u0438\u043d\u0442\u0435\u0440\u044c\u0435\u0440\u044b \u0434\u043b\u044f \u0441\u0432\u043e\u0438\u0445 \u043d\u0430\u0441\u0442\u043e\u044f\u0449\u0438\u0445 \u043a\u0443\u043a\u043e\u043b, \u0438\u0441\u043f\u043e\u043b\u044c\u0437\u0443\u044f \u043e\u0431\u0448\u0438\u0440\u043d\u0443\u044e \u0431\u0438\u0431\u043b\u0438\u043e\u0442\u0435\u043a\u0443 \u043c\u0435\u0431\u0435\u043b\u0438 \u0438 \u043f\u0440\u0435\u0434\u043c\u0435\u0442\u043e\u0432 \u0434\u0435\u043a\u043e\u0440\u0430 \u2014 \u0438 \u0432\u0441\u0451 \u044d\u0442\u043e \u0432 \u0432\u0430\u0448\u0435\u043c \u0440\u0435\u0430\u043b\u044c\u043d\u043e\u043c \u043f\u0440\u043e\u0441\u0442\u0440\u0430\u043d\u0441\u0442\u0432\u0435 \u0431\u043b\u0430\u0433\u043e\u0434\u0430\u0440\u044f MR \u0432 Meta Quest!\n\n\u0411\u043e\u043b\u044c\u0448\u0435 \u043d\u0438\u043a\u0430\u043a\u0438\u0445 \u043a\u0430\u0440\u0442\u043e\u043d\u043d\u044b\u0445 \u0434\u043e\u043c\u0438\u043a\u043e\u0432 \u0438 \u0434\u043e\u0440\u043e\u0433\u0438\u0445 \u0430\u043a\u0441\u0435\u0441\u0441\u0443\u0430\u0440\u043e\u0432: \u043f\u0440\u043e\u0441\u0442\u043e \u0440\u0430\u0437\u043c\u0435\u0441\u0442\u0438\u0442\u0435 \u0441\u0432\u043e\u0438\u0445 \u043a\u0443\u043a\u043e\u043b \u0432 \u0440\u0435\u0430\u043b\u044c\u043d\u043e\u043c \u043c\u0438\u0440\u0435 \u0438 \u0441\u043e\u0437\u0434\u0430\u0439\u0442\u0435 \u0432\u043e\u043a\u0440\u0443\u0433 \u043d\u0438\u0445 \u0438\u0434\u0435\u0430\u043b\u044c\u043d\u0443\u044e \u0446\u0438\u0444\u0440\u043e\u0432\u0443\u044e \u0441\u0440\u0435\u0434\u0443.\n\n**\u041a\u043b\u044e\u0447\u0435\u0432\u044b\u0435 \u043e\u0441\u043e\u0431\u0435\u043d\u043d\u043e\u0441\u0442\u0438:**\n- \u0418\u043d\u0442\u0443\u0438\u0442\u0438\u0432\u043d\u043e \u043f\u043e\u043d\u044f\u0442\u043d\u044b\u0439 \u0438\u043d\u0442\u0435\u0440\u0444\u0435\u0439\u0441 MR \u0434\u043b\u044f Meta Quest (\u043a\u043e\u043d\u0442\u0440\u043e\u043b\u043b\u0435\u0440\u044b + \u043e\u0442\u0441\u043b\u0435\u0436\u0438\u0432\u0430\u043d\u0438\u0435 \u0440\u0443\u043a)\n- \u041f\u0435\u0440\u0435\u0442\u0430\u0441\u043a\u0438\u0432\u0430\u043d\u0438\u0435 \u043f\u0440\u0435\u0434\u043c\u0435\u0442\u043e\u0432 \u043c\u0435\u0431\u0435\u043b\u0438 \u0438 \u0434\u0435\u043a\u043e\u0440\u0430 \u0432 \u0432\u0430\u0448\u0435 \u0440\u0435\u0430\u043b\u044c\u043d\u043e\u0435 \u043f\u0440\u043e\u0441\u0442\u0440\u0430\u043d\u0441\u0442\u0432\u043e\n- \u0421\u043e\u0445\u0440\u0430\u043d\u0435\u043d\u0438\u0435, \u0437\u0430\u0433\u0440\u0443\u0437\u043a\u0430 \u0438 \u0443\u043f\u0440\u0430\u0432\u043b\u0435\u043d\u0438\u0435 \u0432\u0430\u0448\u0438\u043c\u0438 \u043a\u043e\u043c\u043d\u0430\u0442\u0430\u043c\u0438\n- \u041f\u043e\u0438\u0441\u043a \u0438 \u0444\u0438\u043b\u044c\u0442\u0440\u0430\u0446\u0438\u044f \u043e\u0431\u044a\u0435\u043a\u0442\u043e\u0432 \u0432 \u0431\u0438\u0431\u043b\u0438\u043e\u0442\u0435\u043a\u0435\n- \u0423\u0434\u0430\u043b\u0435\u043d\u0438\u0435, \u043f\u0435\u0440\u0435\u043c\u0435\u0449\u0435\u043d\u0438\u0435 \u0438 \u0440\u0430\u0441\u0441\u0442\u0430\u043d\u043e\u0432\u043a\u0430 \u043f\u0440\u0435\u0434\u043c\u0435\u0442\u043e\u0432 \u043f\u043e \u0432\u0430\u0448\u0435\u043c\u0443 \u0432\u043a\u0443\u0441\u0443\n- \u041e\u043f\u0442\u0438\u043c\u0438\u0437\u0438\u0440\u043e\u0432\u0430\u043d\u043e \u0434\u043b\u044f \u0438\u0433\u0440\u044b \u0441 \u043d\u0430\u0441\u0442\u043e\u044f\u0449\u0438\u043c\u0438 \u043a\u0443\u043a\u043b\u0430\u043c\u0438: \u043e\u0431\u044a\u0435\u0434\u0438\u043d\u044f\u0439\u0442\u0435 \u0444\u0438\u0437\u0438\u0447\u0435\u0441\u043a\u0438\u0439 \u0438 \u0432\u0438\u0440\u0442\u0443\u0430\u043b\u044c\u043d\u044b\u0439 \u043c\u0438\u0440\u044b!\n\n**\u0414\u043b\u044f \u043a\u043e\u0433\u043e \u044d\u0442\u043e?**\n\n- \u041a\u043e\u043b\u043b\u0435\u043a\u0446\u0438\u043e\u043d\u0435\u0440\u044b \u043a\u0443\u043a\u043e\u043b (\u0411\u0430\u0440\u0431\u0438, \u041c\u043e\u043d\u0441\u0442\u0440 \u0425\u0430\u0439, \u0411\u0416\u0414, \u041c\u041b\u041f \u0438 \u0442. \u0434.)\n\n- \u0414\u0435\u0442\u0438, \u0440\u043e\u0434\u0438\u0442\u0435\u043b\u0438 \u0438 \u0442\u0432\u043e\u0440\u0447\u0435\u0441\u043a\u0438\u0435 \u0432\u0437\u0440\u043e\u0441\u043b\u044b\u0435, \u043a\u043e\u0442\u043e\u0440\u044b\u0435 \u043b\u044e\u0431\u044f\u0442 \u0441\u043e\u0431\u0438\u0440\u0430\u0442\u044c \u0438 \u0443\u043a\u0440\u0430\u0448\u0430\u0442\u044c\n\n- \u0412\u0441\u0435, \u043a\u0442\u043e \u0445\u043e\u0447\u0435\u0442 \u043f\u043e\u044d\u043a\u0441\u043f\u0435\u0440\u0438\u043c\u0435\u043d\u0442\u0438\u0440\u043e\u0432\u0430\u0442\u044c \u0441 MR \u0438 \u0441\u043e\u0437\u0434\u0430\u0442\u044c \u0441\u043e\u0431\u0441\u0442\u0432\u0435\u043d\u043d\u043e\u0435 \u0442\u0432\u043e\u0440\u0447\u0435\u0441\u043a\u043e\u0435 \u043f\u0440\u043e\u0441\u0442\u0440\u0430\u043d\u0441\u0442\u0432\u043e\n\n**\u0420\u0430\u043d\u043d\u0438\u0439 \u0434\u043e\u0441\u0442\u0443\u043f / \u042d\u043a\u0441\u043f\u0435\u0440\u0438\u043c\u0435\u043d\u0442\u0430\u043b\u044c\u043d\u044b\u0439:**\n\n\u042d\u0442\u043e \u0440\u0430\u043d\u043d\u0438\u0439 \u043f\u0440\u043e\u0442\u043e\u0442\u0438\u043f, \u0441\u043e\u0437\u0434\u0430\u043d\u043d\u044b\u0439 \u0434\u043b\u044f \u0442\u0432\u043e\u0440\u0447\u0435\u0441\u043a\u043e\u0433\u043e \u0440\u0430\u0437\u0432\u043b\u0435\u0447\u0435\u043d\u0438\u044f \u0438 \u043f\u043e\u043b\u0443\u0447\u0435\u043d\u0438\u044f \u043e\u0442\u0437\u044b\u0432\u043e\u0432 \u043e\u0442 \u0441\u043e\u043e\u0431\u0449\u0435\u0441\u0442\u0432\u0430.\n\u0415\u0441\u043b\u0438 \u0443 \u0432\u0430\u0441 \u0435\u0441\u0442\u044c \u0438\u0434\u0435\u0438, \u043f\u043e\u0436\u0435\u043b\u0430\u043d\u0438\u044f \u0438\u043b\u0438 \u0432\u044b \u043d\u0430\u0448\u043b\u0438 \u043e\u0448\u0438\u0431\u043a\u0438, \u043f\u043e\u0436\u0430\u043b\u0443\u0439\u0441\u0442\u0430, \u0434\u0430\u0439\u0442\u0435 \u043c\u043d\u0435 \u0437\u043d\u0430\u0442\u044c \u2014 \u0432\u0430\u0448\u0438 \u043e\u0442\u0437\u044b\u0432\u044b \u0431\u0443\u0434\u0443\u0442 \u043e\u0447\u0435\u043d\u044c \u043a\u0441\u0442\u0430\u0442\u0438!\"", "short_description": "\u0421\u043e\u0437\u0434\u0430\u0432\u0430\u0439\u0442\u0435 \u0443\u043d\u0438\u043a\u0430\u043b\u044c\u043d\u044b\u0435 \u0432\u0438\u0440\u0442\u0443\u0430\u043b\u044c\u043d\u044b\u0435 \u043a\u043e\u043c\u043d\u0430\u0442\u044b \u0434\u043b\u044f \u0432\u0430\u0448\u0438\u0445 \u043d\u0430\u0441\u0442\u043e\u044f\u0449\u0438\u0445 \u043a\u0443\u043a\u043e\u043b \u0432 \u0441\u043c\u0435\u0448\u0430\u043d\u043d\u043e\u0439 \u0440\u0435\u0430\u043b\u044c\u043d\u043e\u0441\u0442\u0438!"}]}, "developer_name": "Lucia Lokidottir", "developer_privacy_policy_url": "https://docs.google.com/document/d/1o7x4IDjSxlCCUaOKs0es7YEBy0_zZ6liLd0aFruz2eE/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Psyche Games", "support_website_url": null, "website_url": "https://psyche-games.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24532704739720004"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1141621570793455"}]}, "baseline_offer": {"id": "1141621570793455"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1759764360, "status": "PUBLISHED", "id": "1141621570793455"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "24544733181850493", "version": "0.3.4"}, "id": "1313471080173079", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename":
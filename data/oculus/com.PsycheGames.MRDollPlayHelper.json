tent-dfw5-2.oculuscdn.com&_nc_ss=8&oh=00_AfzdCCD-PdxMo5j1fK2KxNon45Wgn6_lNUFnp7fwcC6Iow&oe=69BD5B97"}]}, "id": "2034939590375472", "locale": "en_US", "screenshots": [{"file_name": "9603eddb0188a7a537f84f86f6c4599d.png", "id": "25704157852506413", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/491820387_25704157869173078_3708262785954432587_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yPV8BHydHnIQ7kNvwGfHqwM&_nc_oc=AdnCVjKvFdg2AWkQd2lz6A-w4ZXkHIvx9rZa_Ty7oE47ccxPv_LS5Umqbp2zWjNu7qU&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=8&oh=00_Afzel_GHfGsPuWAGV23Ru5q_Zuw3xJ47WS1RgxVe-Cu2ew&oe=69BD5910"}, {"file_name": "2670642f1fc55466a33f91097d69cbe6.png", "id": "758824766976275", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/491819239_758824770309608_7039361326849792567_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e8SMN60D3DUQ7kNvwHUBPnS&_nc_oc=AdlNzQ4wddPUZh2G1PQ1i9bKenVVF9kZVqTTaAGdM2NGE5Y4-XC8OFuDalgntlwpXXw&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=8&oh=00_AfwMrC2_8ng_mQfCQRSwKgUjPZJcwdBOzqmhlywIWsDSEg&oe=69BD3E77"}, {"file_name": "e248bb65ca1e21ac1382ef150e414feb.png", "id": "1435323334196413", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/491818852_1435323337529746_4778664912721487512_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_C6kqYX5VdoQ7kNvwHHTRuZ&_nc_oc=AdmIrGNv0ZdCYggaPe5LcukFVWNtP4JHzSVkwgEjE4qRctorg_02OdDu07uuEjKkaBc&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=8&oh=00_AfwGIc4bd59-UdpcEFGwHiQOo8FkOpJUlN21OQXS3GWliw&oe=69BD4902"}, {"file_name": "c36ea2d732f42910567e37a71b90b6fa.png", "id": "1348255306953872", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/491819239_1348255310287205_4580421486835341359_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jwjQ3XldoX4Q7kNvwEypB6u&_nc_oc=Adn2_eEE3PqQd1NANFzGZMtJzIIE7P9NEJer-i8ND6ODX_fY8BrEQDHBYM9MKkYwj4o&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=8&oh=00_Afw2ZDFXAMSZwPyxV-qHayJqFeHjO1CsMJkGIPrerEXt4w&oe=69BD599A"}, {"file_name": "1414953ee184d1b4664783e8733de8d2.png", "id": "1085351793679813", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/491823746_1085351797013146_2116530631119330818_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PG_qx5vZYn4Q7kNvwGTvOt0&_nc_oc=AdlFTRmP7dxB-ACh5mRqtJO72EKe2c5mz3e2TXkHLuugvEM6qoiiXzxocMZ3AOvDrM4&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=8&oh=00_AfzLyROy9Hl6guM_CQduRzPnz-ORUJUnIKyiijkNVmacng&oe=69BD5C68"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Doll Play Helper", "keywords": ["MR", "Doll", "Sandbox", "Play"], "long_description": "Doll Play Helper is an experimental mixed reality sandbox for doll collectors and creative enthusiasts.\nDesign and customize beautiful virtual rooms and interiors for your real dolls using a wide library of furniture and decor objects \u2014 all in your real space, thanks to MR on Meta Quest!\n\nNo more cardboard houses or expensive accessories: simply place your dolls in the real world, and build their perfect digital environment around them.\n\n**Key Features:**\n- Intuitive MR interface for Meta Quest (controllers + hand tracking)\n-Drag-and-drop furniture and decor objects into your real space\n- Save, load, and manage your custom rooms\n- Search and filter your object library\n- Delete, move, and arrange items to your liking\n -Optimized for play with real dolls: combine physical and virtual worlds!\n\n**Who is it for?**\n\n- Doll collectors (Barbie, Monster High, BJD, MLP, etc.)\n\n- Kids, parents, and creative adults who love to build and decorate\n\n- Anyone wanting to experiment with MR and personal creative spaces\n\n**Early Access / Experimental:**\n\nThis is an early prototype made for creative fun and feedback from the community.\nIf you have ideas, requests, or find bugs, please let me know \u2014 your feedback is very welcome!", "short_description": "Create unique virtual rooms for your real dolls in mixed reality!"}, {"images": {"nodes": []}, "id": "1497125864548266", "locale": "ru_RU", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "\u041f\u043e\u043c\u043e\u0449\u043d\u0438\u043a \u0438\u0433\u0440\u044b \u0441 \u043a\u0443\u043a\u043b\u0430\u043c\u0438", "keywords": ["\u0421\u043c\u0435\u0448\u0430\u043d\u043d\u0430\u044f", "\u0440\u0435\u0430\u043b\u044c\u043d\u043e\u0441\u0442\u044c", "\u041f\u043e\u043c\u043e\u0449\u043d\u0438\u043a", "\u0438\u0433\u0440\u044b", "\u043a\u0443\u043a\u043b\u044b"], "long_description": "\"\u041f\u043e\u043c\u043e\u0449\u043d\u0438\u043a \u0432 \u0438\u0433\u0440\u0435 \u0441 \u043a\u0443\u043a\u043b\u0430\u043c\u0438 \u2014 \u044d\u0442\u043e \u044d\u043a\u0441\u043f\u0435\u0440\u0438\u043c\u0435\u043d\u0442\u0430\u043b\u044c\u043d\u0430\u044f \u043f\u0435\u0441\u043e\u0447\u043d\u0438\u0446\u0430 \u0441\u043c\u0435\u0448\u0430\u043d\u043d\u043e\u0439 \u0440\u0435\u0430\u043b\u044c\u043d\u043e\u0441\u0442\u0438 \u0434\u043b\u044f \u043a\u043e\u043b\u043b\u0435\u043a\u0446\u0438\u043e\u043d\u0435\u0440\u043e\u0432 \u043a\u0443\u043a\u043e\u043b \u0438 \u043b\u044e\u0431\u0438\u0442\u0435\u043b\u0435\u0439 \u0442\u0432\u043e\u0440\u0447\u0435\u0441\u0442\u0432\u0430.\n\u0421\u043e\u0437\u0434\u0430\u0432\u0430\u0439\u0442\u0435 \u0438 \u043d\u0430\u0441\u0442\u0440\u0430\u0438\u0432\u0430\u0439\u0442\u0435 \u043a\u0440\u0430\u0441\u0438\u0432\u044b\u0435 \u0432\u0438\u0440\u0442\u0443\u0430\u043b\u044c\u043d\u044b\u0435 \u043a\u043e\u043c\u043d\u0430\u0442\u044b \u0438 \u0438\u043d\u0442\u0435\u0440\u044c\u0435\u0440\u044b \u0434\u043b\u044f \u0441\u0432\u043e\u0438\u0445 \u043d\u0430\u0441\u0442\u043e\u044f\u0449\u0438\u0445 \u043a\u0443\u043a\u043e\u043b, \u0438\u0441\u043f\u043e\u043b\u044c\u0437\u0443\u044f \u043e\u0431\u0448\u0438\u0440\u043d\u0443\u044e \u0431\u0438\u0431\u043b\u0438\u043e\u0442\u0435\u043a\u0443 \u043c\u0435\u0431\u0435\u043b\u0438 \u0438 \u043f\u0440\u0435\u0434\u043c\u0435\u0442\u043e\u0432 \u0434\u0435\u043a\u043e\u0440\u0430 \u2014 \u0438 \u0432\u0441\u0451 \u044d\u0442\u043e \u0432 \u0432\u0430\u0448\u0435\u043c \u0440\u0435\u0430\u043b\u044c\u043d\u043e\u043c \u043f\u0440\u043e\u0441\u0442\u0440\u0430\u043d\u0441\u0442\u0432\u0435 \u0431\u043b\u0430\u0433\u043e\u0434\u0430\u0440\u044f MR \u0432 Meta Quest!\n\n\u0411\u043e\u043b\u044c\u0448\u0435 \u043d\u0438\u043a\u0430\u043a\u0438\u0445 \u043a\u0430\u0440\u0442\u043e\u043d\u043d\u044b\u0445 \u0434\u043e\u043c\u0438\u043a\u043e\u0432 \u0438 \u0434\u043e\u0440\u043e\u0433\u0438\u0445 \u0430\u043a\u0441\u0435\u0441\u0441\u0443\u0430\u0440\u043e\u0432: \u043f\u0440\u043e\u0441\u0442\u043e \u0440\u0430\u0437\u043c\u0435\u0441\u0442\u0438\u0442\u0435 \u0441\u0432\u043e\u0438\u0445 \u043a\u0443\u043a\u043e\u043b \u0432 \u0440\u0435\u0430\u043b\u044c\u043d\u043e\u043c \u043c\u0438\u0440\u0435 \u0438 \u0441\u043e\u0437\u0434\u0430\u0439\u0442\u0435 \u0432\u043e\u043a\u0440\u0443\u0433 \u043d\u0438\u0445 \u0438\u0434\u0435\u0430\u043b\u044c\u043d\u0443\u044e \u0446\u0438\u0444\u0440\u043e\u0432\u0443\u044e \u0441\u0440\u0435\u0434\u0443.\n\n**\u041a\u043b\u044e\u0447\u0435\u0432\u044b\u0435 \u043e\u0441\u043e\u0431\u0435\u043d\u043d\u043e\u0441\u0442\u0438:**\n- \u0418\u043d\u0442\u0443\u0438\u0442\u0438\u0432\u043d\u043e \u043f\u043e\u043d\u044f\u0442\u043d\u044b\u0439 \u0438\u043d\u0442\u0435\u0440\u0444\u0435\u0439\u0441 MR \u0434\u043b\u044f Meta Quest (\u043a\u043e\u043d\u0442\u0440\u043e\u043b\u043b\u0435\u0440\u044b + \u043e\u0442\u0441\u043b\u0435\u0436\u0438\u0432\u0430\u043d\u0438\u0435 \u0440\u0443\u043a)\n- \u041f\u0435\u0440\u0435\u0442\u0430\u0441\u043a\u0438\u0432\u0430\u043d\u0438\u0435 \u043f\u0440\u0435\u0434\u043c\u0435\u0442\u043e\u0432 \u043c\u0435\u0431\u0435\u043b\u0438 \u0438 \u0434\u0435\u043a\u043e\u0440\u0430 \u0432 \u0432\u0430\u0448\u0435 \u0440\u0435\u0430\u043b\u044c\u043d\u043e\u0435 \u043f\u0440\u043e\u0441\u0442\u0440\u0430\u043d\u0441\u0442\u0432\u043e\n- \u0421\u043e\u0445\u0440\u0430\u043d\u0435\u043d\u0438\u0435, \u0437\u0430\u0433\u0440\u0443\u0437\u043a\u0430 \u0438 \u0443\u043f\u0440\u0430\u0432\u043b\u0435\u043d\u0438\u0435 \u0432\u0430\u0448\u0438\u043c\u0438 \u043a\u043e\u043c\u043d\u0430\u0442\u0430\u043c\u0438\n- \u041f\u043e\u0438\u0441\u043a \u0438 \u0444\u0438\u043b\u044c\u0442\u0440\u0430\u0446\u0438\u044f \u043e\u0431\u044a\u0435\u043a\u0442\u043e\u0432 \u0432 \u0431\u0438\u0431\u043b\u0438\u043e\u0442\u0435\u043a\u0435\n- \u0423\u0434\u0430\u043b\u0435\u043d\u0438\u0435, \u043f\u0435\u0440\u0435\u043c\u0435\u0449\u0435\u043d\u0438\u0435 \u0438 \u0440\u0430\u0441\u0441\u0442\u0430\u043d\u043e\u0432\u043a\u0430 \u043f\u0440\u0435\u0434\u043c\u0435\u0442\u043e\u0432 \u043f\u043e \u0432\u0430\u0448\u0435\u043c\u0443 \u0432\u043a\u0443\u0441\u0443\n- \u041e\u043f\u0442\u0438\u043c\u0438\u0437\u0438\u0440\u043e\u0432\u0430\u043d\u043e \u0434\u043b\u044f \u0438\u0433\u0440\u044b \u0441 \u043d\u0430\u0441\u0442\u043e\u044f\u0449\u0438\u043c\u0438 \u043a\u0443\u043a\u043b\u0430\u043c\u0438: \u043e\u0431\u044a\u0435\u0434\u0438\u043d\u044f\u0439\u0442\u0435 \u0444\u0438\u0437\u0438\u0447\u0435\u0441\u043a\u0438\u0439 \u0438 \u0432\u0438\u0440\u0442\u0443\u0430\u043b\u044c\u043d\u044b\u0439 \u043c\u0438\u0440\u044b!\n\n**\u0414\u043b\u044f \u043a\u043e\u0433\u043e \u044d\u0442\u043e?**\n\n- \u041a\u043e\u043b\u043b\u0435\u043a\u0446\u0438\u043e\u043d\u0435\u0440\u044b \u043a\u0443\u043a\u043e\u043b (\u0411\u0430\u0440\u0431\u0438, \u041c\u043e\u043d\u0441\u0442\u0440 \u0425\u0430\u0439, \u0411\u0416\u0414, \u041c\u041b\u041f \u0438 \u0442. \u0434.)\n\n- \u0414\u0435\u0442\u0438, \u0440\u043e\u0434\u0438\u0442\u0435\u043b\u0438 \u0438 \u0442\u0432\u043e\u0440\u0447\u0435\u0441\u043a\u0438\u0435 \u0432\u0437\u0440\u043e\u0441\u043b\u044b\u0435, \u043a\u043e\u0442\u043e\u0440\u044b\u0435 \u043b\u044e\u0431\u044f\u0442 \u0441\u043e\u0431\u0438\u0440\u0430\u0442\u044c \u0438 \u0443\u043a\u0440\u0430\u0448\u0430\u0442\u044c\n\n- \u0412\u0441\u0435, \u043a\u0442\u043e \u0445\u043e\u0447\u0435\u0442 \u043f\u043e\u044d\u043a\u0441\u043f\u0435\u0440\u0438\u043c\u0435\u043d\u0442\u0438\u0440\u043e\u0432\u0430\u0442\u044c \u0441 MR \u0438 \u0441\u043e\u0437\u0434\u0430\u0442\u044c \u0441\u043e\u0431\u0441\u0442\u0432\u0435\u043d\u043d\u043e\u0435 \u0442\u0432\u043e\u0440\u0447\u0435\u0441\u043a\u043e\u0435 \u043f\u0440\u043e\u0441\u0442\u0440\u0430\u043d\u0441\u0442\u0432\u043e\n\n**\u0420\u0430\u043d\u043d\u0438\u0439 \u0434\u043e\u0441\u0442\u0443\u043f / \u042d\u043a\u0441\u043f\u0435\u0440\u0438\u043c\u0435\u043d\u0442\u0430\u043b\u044c\u043d\u044b\u0439:**\n\n\u042d\u0442\u043e \u0440\u0430\u043d\u043d\u0438\u0439 \u043f\u0440\u043e\u0442\u043e\u0442\u0438\u043f, \u0441\u043e\u0437\u0434\u0430\u043d\u043d\u044b\u0439 \u0434\u043b\u044f \u0442\u0432\u043e\u0440\u0447\u0435\u0441\u043a\u043e\u0433\u043e \u0440\u0430\u0437\u0432\u043b\u0435\u0447\u0435\u043d\u0438\u044f \u0438 \u043f\u043e\u043b\u0443\u0447\u0435\u043d\u0438\u044f \u043e\u0442\u0437\u044b\u0432\u043e\u0432 \u043e\u0442 \u0441\u043e\u043e\u0431\u0449\u0435\u0441\u0442\u0432\u0430.\n\u0415\u0441\u043b\u0438 \u0443 \u0432\u0430\u0441 \u0435\u0441\u0442\u044c \u0438\u0434\u0435\u0438, \u043f\u043e\u0436\u0435\u043b\u0430\u043d\u0438\u044f \u0438\u043b\u0438 \u0432\u044b \u043d\u0430\u0448\u043b\u0438 \u043e\u0448\u0438\u0431\u043a\u0438, \u043f\u043e\u0436\u0430\u043b\u0443\u0439\u0441\u0442\u0430, \u0434\u0430\u0439\u0442\u0435 \u043c\u043d\u0435 \u0437\u043d\u0430\u0442\u044c \u2014 \u0432\u0430\u0448\u0438 \u043e\u0442\u0437\u044b\u0432\u044b \u0431\u0443\u0434\u0443\u0442 \u043e\u0447\u0435\u043d\u044c \u043a\u0441\u0442\u0430\u0442\u0438!\"", "short_description": "\u0421\u043e\u0437\u0434\u0430\u0432\u0430\u0439\u0442\u0435 \u0443\u043d\u0438\u043a\u0430\u043b\u044c\u043d\u044b\u0435 \u0432\u0438\u0440\u0442\u0443\u0430\u043b\u044c\u043d\u044b\u0435 \u043a\u043e\u043c\u043d\u0430\u0442\u044b \u0434\u043b\u044f \u0432\u0430\u0448\u0438\u0445 
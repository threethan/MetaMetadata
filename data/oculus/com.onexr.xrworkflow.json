294241_8566233990059444_3601241169210985988_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tkvZ1962EyIQ7kNvwGcUUaC&_nc_oc=AdntQAv15pcz5MEcawd7gA5WuTfBC6s3kfjaBkCRIKcfWoXu7DJGDn_XaLCBLM3ChKQ&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfxjfLL50waN78sUpJK0NeEk2IaZtufs1F7Oo2TkQPYRAQ&oe=69BE9463"}, {"file_name": "Screenshot3.png", "id": "1473438296626212", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982651_1473438299959545_7532312566202638856_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gGwQc7NTrFEQ7kNvwFWFzMf&_nc_oc=AdlPuwd4GM7vmkn1JeY6ZtR-MqJf9xQQ-xhLvqsIFjlysV4hioS_fHEInCuNS6Zdu14&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfwR7Z3ftnjYGjSJkTZq99gmxYSmAtXnQCKCUegYxukyIA&oe=69BE7CF2"}, {"file_name": "Screenshot4.png", "id": "475352788365462", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974668_475352791698795_6513029807440269328_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PVKcXfQH1SMQ7kNvwFFS84I&_nc_oc=AdmlVADfVAXGdDW9alUAV0sJ31TEn56Wl347UCDvotiV_5_UrFUYSsJGviy4NG5dLQ4&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfzxilLcCRsXMx80mpdK_x9xDzwtSglXOWjDQLh1uC8OgQ&oe=69BE99EE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TrailerCover.png", "id": "1679571196183084", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982534_1679571199516417_7292601014387023875_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ucBUZ6shK0EQ7kNvwE7QUss&_nc_oc=AdlTgspdAnrKlnkjNKH5-vfNYXNijLLY3Jy_GZosEUB8WcjAWLOtZ4VbuxvZJ5KR_6o&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfwJwyWSi0WIPuT3VNJxbTWq5VLHDATzBHe8k31KGXyJ-g&oe=69BEA6EB"}, "display_name": "XR-Workflow", "keywords": [], "long_description": "Organizations across the world, especially the manufacturing companies, experience difficulty in obtaining expertise for selling & marketing machines digitally, and have to depend on traditional methods of marketing, which result in millions of dollars.\n\nXR-Workflow : VR application enables virtual delivery of contents related to your products for the prospects to help them during the pre-purchase stage, which can work on Meta VR headset devices. It elevates the level of service a user receives without worrying about the impact of geographical boundaries.\n\nXR-Workflow app has various aspects, in several segments of the business such as Remote Auditing, Sales Enablement, Operational Efficacy, Research & Development, On-boarding & Training and  many more.\n\nHighlights of the XR-Workflow App are Product visualization, VR enablement and X-Ray mode simulation.", "short_description": "Redefining immersive product visualization experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://onexr.us/metaapp/privacy-policy/index.html", "developer_terms_of_service_url": null, "publisher_name": "Augray LLC", "support_website_url": null, "website_url": "https://onexr.in/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "877379582865093"}, {"id": "1063584910766706"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8727175087373292"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39003277_819125343159216_7599392833159282618_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3U_Lff-JiCcQ7kNvwGRoG28&_nc_oc=AdmmbwlDwBWsqUv7c1v6KzvGxrl_-j1QoFw8bwlrRLzWyQ1VaanXyxn14GvP_KlK
a0a&_nc_ohc=iv-SFdyczzIQ7kNvwFl0I2T&_nc_oc=Adn2lvuers4Yt0Hk7IDK7WYaL8V7lMgWYHChFPw2QEG3bgW-jeHZs-M4-0evcpRHYOo&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&oh=00_AftmaXP1w6UFRBsVbw6O7fiivCLgXMZ-qwQQ_IALxR0mBQ&oe=69A19363"}, {"file_name": "Screenshot3.png", "id": "1473438296626212", "uri": "https://scontent-hkg1-1.oculuscdn.com/v/t64.5771-25/38982651_1473438299959545_7532312566202638856_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZB8PgBo_EfUQ7kNvwGnSTPp&_nc_oc=AdnKaDLdWqBEUJxvRxKidmc-MS0MtPOpkN3ETKJATigHPT456CTiXwI-WM6Bf7jag-I&_nc_zt=3&_nc_ht=scontent-hkg1-1.oculuscdn.com&oh=00_Aft3X2TdsQd4U_lXQ17762JLMGuShnOo7AL6TeCOgDi-Mg&oe=69A17BF2"}, {"file_name": "Screenshot4.png", "id": "475352788365462", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/38974668_475352791698795_6513029807440269328_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EJMMQIRos30Q7kNvwFVt5BM&_nc_oc=Adk4oc2iyOucjU_wv9IZf4otwzmkxjZXY-7B_CFFDr1w2b3-h2VE2XKerL-fkT2gQaI&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&oh=00_AftHLApbJEdHYeD8xlSRoWJ5JoLytlOZ4mcW8TivrYXMDQ&oe=69A198EE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TrailerCover.png", "id": "1679571196183084", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/38982534_1679571199516417_7292601014387023875_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3hyIf7Y6vc8Q7kNvwFbcsD_&_nc_oc=AdlMfol9XPBnZIEI89RvD3PBzb3yHqXSPdSTNP50-DeJ1beSyWXyJePQOsoRqEjwqH0&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&oh=00_Afuy8VFy9Hk538LuvpdWW9_-sm1P9fztXODNbWV-Qj9w4g&oe=69A1A5EB"}, "display_name": "XR-Workflow", "keywords": [], "long_description": "Organizations across the world, especially the manufacturing companies, experience difficulty in obtaining expertise for selling & marketing machines digitally, and have to depend on traditional methods of marketing, which result in millions of dollars.\n\nXR-Workflow : VR application enables virtual delivery of contents related to your products for the prospects to help them during the pre-purchase stage, which can work on Meta VR headset devices. It elevates the level of service a user receives without worrying about the impact of geographical boundaries.\n\nXR-Workflow app has various aspects, in several segments of the business such as Remote Auditing, Sales Enablement, Operational Efficacy, Research & Development, On-boarding & Training and  many more.\n\nHighlights of the XR-Workflow App are Product visualization, VR enablement and X-Ray mode simulation.", "short_description": "Redefining immersive product visualization experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://onexr.us/metaapp/privacy-policy/index.html", "developer_terms_of_service_url": null, "publisher_name": "Augray LLC", "support_website_url": null, "website_url": "https://onexr.in/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "877379582865093"}, {"id": "1063584910766706"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8727175087373292"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/39003277_819125343159216_7599392833159282618_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5DrAMBuTXTMQ7kNvwF_rabx&_nc_oc=Adlmav1C1CT7egCsq_WudbBsx_uA8HewWXPuqafbI68wSHfkkj01aJ0w4qbtCncrMVA&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&oh=00_Aftnwv1b-aYJvgsck7H8FGDgqvDup2zzHqtKyk34Qw8jTg&oe=69A190AD"},
a0a&_nc_ohc=7LCnoYbJynsQ7kNvwFUv5s7&_nc_oc=AdkuxzazNER9sVnS7omhjzwkLM0AF-ImGLdtdGxu6ZaM0aNipRbTJFPxknrU7wSogSY&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AftVrJJe9Dc7YXGUc0fgkysH2AYukSGI7gH6DrwiSsfb7Q&oe=699AFBE3"}, {"file_name": "Screenshot3.png", "id": "1473438296626212", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982651_1473438299959545_7532312566202638856_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zFhrkRklZJcQ7kNvwGNh_k8&_nc_oc=AdmIh7FTdKWnE67uvPgH2_7C9DGfS-L0FRx4nD3FYPg3e-16U9hGjyv3puvnWW2GX4A&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_AfsRtAW9lzWOChl_Q7l7MmZFcuJrPtn6JVxpg-E26mjrzQ&oe=699AE472"}, {"file_name": "Screenshot4.png", "id": "475352788365462", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974668_475352791698795_6513029807440269328_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pHjW2rEhTjEQ7kNvwH8Dwas&_nc_oc=AdnxouV4Dsav8VCWrCLagLztNIQBjhvW9gN8n9lYufews26tiCTjAD8IfCb3RZg7vtw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AfvU6aLnDCONDMaiEfWHna3BobeHsL68r6-cO7fYAQuuaA&oe=699B016E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TrailerCover.png", "id": "1679571196183084", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982534_1679571199516417_7292601014387023875_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_5bnZT0epNsQ7kNvwE-CqOQ&_nc_oc=AdmjiKn0wSSE_Vn-8IExJtlnO-vFxMvjioTIxHJZwEcOxKGGz-abHzu15AgVy4gFRKM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_Afu-d7naF_Q1JfwXKsJcmXmd35r1KrkYxUHnR3yyY4uT-w&oe=699B0E6B"}, "display_name": "XR-Workflow", "keywords": [], "long_description": "Organizations across the world, especially the manufacturing companies, experience difficulty in obtaining expertise for selling & marketing machines digitally, and have to depend on traditional methods of marketing, which result in millions of dollars.\n\nXR-Workflow : VR application enables virtual delivery of contents related to your products for the prospects to help them during the pre-purchase stage, which can work on Meta VR headset devices. It elevates the level of service a user receives without worrying about the impact of geographical boundaries.\n\nXR-Workflow app has various aspects, in several segments of the business such as Remote Auditing, Sales Enablement, Operational Efficacy, Research & Development, On-boarding & Training and  many more.\n\nHighlights of the XR-Workflow App are Product visualization, VR enablement and X-Ray mode simulation.", "short_description": "Redefining immersive product visualization experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://onexr.us/metaapp/privacy-policy/index.html", "developer_terms_of_service_url": null, "publisher_name": "Augray LLC", "support_website_url": null, "website_url": "https://onexr.in/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "877379582865093"}, {"id": "1063584910766706"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8727175087373292"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39003277_819125343159216_7599392833159282618_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qxGk9-UjuU4Q7kNvwFeJ6Tz&_nc_oc=AdnuC6Clmx19F6iqYD3k36Yh5DR34nWgpgFeA_9EKatlbTzdCmKo5ccQo-PpkSpRL6s&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfsmGVFD7OGAzp8XVulUwGyj1iAK9LR1sz3_ZcoyEXLhMw&oe=699AF92D"},
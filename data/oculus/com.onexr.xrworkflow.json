a0a&_nc_ohc=iv-SFdyczzIQ7kNvwEIHYB8&_nc_oc=Adkg2toyt4Xdic5fugYfkGv69fGmnojv6ZxgTet0YOIGAvkwhlEOAMkYVw9EYR1A9k8&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfsQQFy8zvnxZmcRh_wUTXznKP5H93zbZCY13j0PiHJw3g&oe=69A43663"}, {"file_name": "Screenshot3.png", "id": "1473438296626212", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982651_1473438299959545_7532312566202638856_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZB8PgBo_EfUQ7kNvwEAmn-R&_nc_oc=AdmHqGSbyk2x4dqvi0mL2pLV5LwWW20ruAku1L3ub3S30KOpnvcGIfGq8B-KjeV8l9g&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_Afuit3vEjiXJtzU7Gnk2QOKFdNC8ZeDkjEpTdCN62cM_0Q&oe=69A41EF2"}, {"file_name": "Screenshot4.png", "id": "475352788365462", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974668_475352791698795_6513029807440269328_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pm_4tBqEu_UQ7kNvwES926M&_nc_oc=AdkuERUfnBYXVNPLqN0hPleOqBrLFZTsZq8OYmga1Yvpa7Tw77ESi5DRD9k6HyWOTAc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AfvN4QebkrO_Qb1hEIB-FcZ5sfEGd4MjpmfGVJm1IR18ww&oe=69A43BEE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TrailerCover.png", "id": "1679571196183084", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982534_1679571199516417_7292601014387023875_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M3HDRALubj0Q7kNvwEowRty&_nc_oc=AdmGZLZok-jOA11d6tY_e2Ce-sANZWmuWG-LysBZrpRMzh9CS5mrrhXwRYKiYHaJ-zg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AfsbvGCFTHV33UJVgqm1zrHLvodCHvMV1luCFChdHhn_Tw&oe=69A448EB"}, "display_name": "XR-Workflow", "keywords": [], "long_description": "Organizations across the world, especially the manufacturing companies, experience difficulty in obtaining expertise for selling & marketing machines digitally, and have to depend on traditional methods of marketing, which result in millions of dollars.\n\nXR-Workflow : VR application enables virtual delivery of contents related to your products for the prospects to help them during the pre-purchase stage, which can work on Meta VR headset devices. It elevates the level of service a user receives without worrying about the impact of geographical boundaries.\n\nXR-Workflow app has various aspects, in several segments of the business such as Remote Auditing, Sales Enablement, Operational Efficacy, Research & Development, On-boarding & Training and  many more.\n\nHighlights of the XR-Workflow App are Product visualization, VR enablement and X-Ray mode simulation.", "short_description": "Redefining immersive product visualization experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://onexr.us/metaapp/privacy-policy/index.html", "developer_terms_of_service_url": null, "publisher_name": "Augray LLC", "support_website_url": null, "website_url": "https://onexr.in/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "877379582865093"}, {"id": "1063584910766706"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8727175087373292"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39003277_819125343159216_7599392833159282618_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TQIvnv4Vyh0Q7kNvwGce2DM&_nc_oc=AdkhCiS-8vJv_tY70iJ54-2w6joZDSGyPtwb1mShXpZd8xpkhep-iQGmSZOKS6_IkMQ&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfuWOjg_tLrE4-5D3qVkyYevacp28-iS5r84w3ptunHhkg&oe=69A433AD"},
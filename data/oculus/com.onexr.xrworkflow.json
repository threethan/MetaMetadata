a0a&_nc_ohc=7LCnoYbJynsQ7kNvwHNkhQ3&_nc_oc=AdmS8_NknqjdtfJTgspt7aXte2MdzdmU5q96_OtELTValT1_5Fj-zZB27MJLWFECcfo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Aft8pbNhLMytNUv1SciJJ3YnDv6qRnMnlevZt59oGjrZVw&oe=6999AA63"}, {"file_name": "Screenshot3.png", "id": "1473438296626212", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982651_1473438299959545_7532312566202638856_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zFhrkRklZJcQ7kNvwG50KNW&_nc_oc=Admthv-pm5EO-WFLoyDWC6NWxOIi8izkYLLPxfaqr6FvGeoMw-i8qhuj5R1732tR630&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afv4Rz2mbc_s6hofmcpIGj7liD3VdLwFWGab7B_GLI359A&oe=699992F2"}, {"file_name": "Screenshot4.png", "id": "475352788365462", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974668_475352791698795_6513029807440269328_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pHjW2rEhTjEQ7kNvwFF0eJU&_nc_oc=AdlQBqCI2ZFlQA-6apCkWd9a-enoxZtYmSXipn_1742znHndeAmGKnD642PL0GOcCT0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Afs0Q3Z3GuLD_3QYHZkc6NgaRq0U9muXJbuR8fmtujJzhA&oe=6999AFEE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TrailerCover.png", "id": "1679571196183084", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982534_1679571199516417_7292601014387023875_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_5bnZT0epNsQ7kNvwHKc40j&_nc_oc=Adk29grqugtNBth4s28oy55nl7_Kh_-6Uuo5HXQfuxNtLx1WfVDwsckakVHuO6PNoZ0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfuO31L1geKljvW3WisjEw9JiTVU6ijf3ItpxTHxkwEeDg&oe=6999BCEB"}, "display_name": "XR-Workflow", "keywords": [], "long_description": "Organizations across the world, especially the manufacturing companies, experience difficulty in obtaining expertise for selling & marketing machines digitally, and have to depend on traditional methods of marketing, which result in millions of dollars.\n\nXR-Workflow : VR application enables virtual delivery of contents related to your products for the prospects to help them during the pre-purchase stage, which can work on Meta VR headset devices. It elevates the level of service a user receives without worrying about the impact of geographical boundaries.\n\nXR-Workflow app has various aspects, in several segments of the business such as Remote Auditing, Sales Enablement, Operational Efficacy, Research & Development, On-boarding & Training and  many more.\n\nHighlights of the XR-Workflow App are Product visualization, VR enablement and X-Ray mode simulation.", "short_description": "Redefining immersive product visualization experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://onexr.us/metaapp/privacy-policy/index.html", "developer_terms_of_service_url": null, "publisher_name": "Augray LLC", "support_website_url": null, "website_url": "https://onexr.in/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "877379582865093"}, {"id": "1063584910766706"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8727175087373292"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39003277_819125343159216_7599392833159282618_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3Wm_DwDkUvIQ7kNvwHu3x4d&_nc_oc=AdmxTjuSYbumIoa5EY64lca34p1JbCURifwJzfp6uqzmBFpqIzIU7XRYhUTgEo3q_uQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfuLUryd8Rf68vx8cR4IEIcRYFDSzwTu-ANKFeX1g4bZrg&oe=6999A7AD"},
294241_8566233990059444_3601241169210985988_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oo0e9usVHpoQ7kNvwHYkmkT&_nc_oc=AdlbWkzvmeyFqU4AG87DV_uNY97_Khz611djHLdolfCLfyuyJ8KWilSUWW4la7vMFso&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfvLe8TuS7OPXh8vpZTcB8IUMD-L20nW7c2w4EVWCywpbA&oe=69A82AE3"}, {"file_name": "Screenshot3.png", "id": "1473438296626212", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982651_1473438299959545_7532312566202638856_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hYdgbh-yquEQ7kNvwHGArJ6&_nc_oc=Adl4rxqPbiPhm2ErxyFP8jZpx8BKSI_9mW8C4vTNh7NqyTr148gETOx8-d_248wp3n8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfuXnIJrb97btjyCAYFcAULDEX0LttdQD5ULDBeXrA9k3g&oe=69A81372"}, {"file_name": "Screenshot4.png", "id": "475352788365462", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974668_475352791698795_6513029807440269328_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eY7Aeuf3eWoQ7kNvwFtXF63&_nc_oc=AdmzkC-oXFm36TnyibMowO4sNAtsdH1h2EqleJgGFzF1nmSbDl6P6paDx3Vr3c6x0p0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfvJ04OJYTo0psDyuF4M_3GO4aNanlieEFdwrMLpEAidsA&oe=69A8306E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TrailerCover.png", "id": "1679571196183084", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982534_1679571199516417_7292601014387023875_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uAplQ1N8YDIQ7kNvwHt0vN-&_nc_oc=AdnGqDXPFRbXjxeTxnaqn79FYnSycCjWKGVa1tNDhsiepzlNeX7LnY1sTQyIK2rtj7A&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Aftgp-_vvrBUvCxRm986rc2SG_HWL7add9G8rftxaVWpaA&oe=69A83D6B"}, "display_name": "XR-Workflow", "keywords": [], "long_description": "Organizations across the world, especially the manufacturing companies, experience difficulty in obtaining expertise for selling & marketing machines digitally, and have to depend on traditional methods of marketing, which result in millions of dollars.\n\nXR-Workflow : VR application enables virtual delivery of contents related to your products for the prospects to help them during the pre-purchase stage, which can work on Meta VR headset devices. It elevates the level of service a user receives without worrying about the impact of geographical boundaries.\n\nXR-Workflow app has various aspects, in several segments of the business such as Remote Auditing, Sales Enablement, Operational Efficacy, Research & Development, On-boarding & Training and  many more.\n\nHighlights of the XR-Workflow App are Product visualization, VR enablement and X-Ray mode simulation.", "short_description": "Redefining immersive product visualization experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://onexr.us/metaapp/privacy-policy/index.html", "developer_terms_of_service_url": null, "publisher_name": "Augray LLC", "support_website_url": null, "website_url": "https://onexr.in/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "877379582865093"}, {"id": "1063584910766706"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8727175087373292"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39003277_819125343159216_7599392833159282618_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DxZ7u28YOVYQ7kNvwH6AWsx&_nc_oc=Adkg9QitwMbRkuV1RUdQVNbwgoJw0Zo4cBHzNabXF2aPC7Mua-NqhiVtmlvm5G9J
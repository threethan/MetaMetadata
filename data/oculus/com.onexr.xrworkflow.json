2"}, {"file_name": "Screenshot4.png", "id": "475352788365462", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974668_475352791698795_6513029807440269328_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PVKcXfQH1SMQ7kNvwHVxzMb&_nc_oc=AdkILbQtH6mgZcZFR5edPRCb9FF4TFQX6KX1K6aVmSIkG7aHroIOzNWwPlVqfFGz-r4&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=8&oh=00_Afy7WxeMnj0AMX7dtcUD7gJZa_oECxtiO51H0PAIrLkkrw&oe=69BD486E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TrailerCover.png", "id": "1679571196183084", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38982534_1679571199516417_7292601014387023875_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ucBUZ6shK0EQ7kNvwHFuSe2&_nc_oc=AdkqcWdYmtHf1-oTbKSPWVf6KSfK-rw9zSv8suFTyxTwnI22TDTN4oZ4jzWvWTR9O80&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=8&oh=00_AfyR5I2PW4wDRIJuB1sBDqEnPUeBmfZ6CMj5uuSHzShKdQ&oe=69BD556B"}, "display_name": "XR-Workflow", "keywords": [], "long_description": "Organizations across the world, especially the manufacturing companies, experience difficulty in obtaining expertise for selling & marketing machines digitally, and have to depend on traditional methods of marketing, which result in millions of dollars.\n\nXR-Workflow : VR application enables virtual delivery of contents related to your products for the prospects to help them during the pre-purchase stage, which can work on Meta VR headset devices. It elevates the level of service a user receives without worrying about the impact of geographical boundaries.\n\nXR-Workflow app has various aspects, in several segments of the business such as Remote Auditing, Sales Enablement, Operational Efficacy, Research & Development, On-boarding & Training and  many more.\n\nHighlights of the XR-Workflow App are Product visualization, VR enablement and X-Ray mode simulation.", "short_description": "Redefining immersive product visualization experience."}]}, "developer_name": null, "developer_privacy_polic
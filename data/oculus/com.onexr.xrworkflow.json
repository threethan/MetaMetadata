ra5-2.oculuscdn.com/v/t64.5771-25/75294241_8566233990059444_3601241169210985988_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6QCLathZkwkQ7kNvwHe7_ee&_nc_oc=AdpiakwVlgp8-MvEk3uD5dlLAJZPfiaTK0n6g8anJSb7oqw9P6aajxs9TYznRDdj14o&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFuvqe5tFkYFj2cj5iMgLYMpunNYzc3yXA3mUuhGnNwoA&oe=6A8849E3"}, {"file_name": "Screenshot3.png", "id": "1473438296626212", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38982651_1473438299959545_7532312566202638856_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Zv3POyk_ujgQ7kNvwGj0ETs&_nc_oc=Adp6lVjfsj3ok8IPBss2HsxkX05rb-g2O3CYKobV69EZMeS8hy2zbGyMPYbZlNp67Lg&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHkb3cNHU9k_VEukkIaur6DwjkWe-l1MuI9jOYYgK2eUA&oe=6A883272"}, {"file_name": "Screenshot4.png", "id": "475352788365462", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38974668_475352791698795_6513029807440269328_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W9AtrQhSHjYQ7kNvwGIUdya&_nc_oc=AdrkwaFfdpPHiDbbubDgysl6w4p_ryY9hlVnxIdEd3Bj_nzfTAsCpFy8PR79nmNc4TA&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG8KkKK3K5Y5RpbHw8N-32f-QVSXiFj-J1sBfS-LKVhSQ&oe=6A884F6E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TrailerCover.png", "id": "1679571196183084", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38982534_1679571199516417_7292601014387023875_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sGRRFfOzOnUQ7kNvwH-pEmu&_nc_oc=AdphfMtb5fqA8ePeWIoku_balYu3Fk5y1qRSr8mOXrTeB55lsApdZdN5MDbq_q4TG48&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHLzf4fy0Loky5twN8U4v6oClYnFNv9j_DBDAbfKu1_oQ&oe=6A88242B"}, "display_name": "XR-Workflow", "keywords": [], "long_description": "Organizations across the world, especially the manufacturing companies, experience difficulty in obtaining expertise for selling & marketing machines digitally, and have to depend on traditional methods of marketing, which result in millions of dollars.\n\nXR-Workflow : VR application enables virtual delivery of contents related to your products for the prospects to help them during the pre-purchase stage, which can work on Meta VR headset devices. It elevates the level of service a user receives without worrying about the impact of geographical boundaries.\n\nXR-Workflow app has various aspects, in several segments of the business such as Remote Auditing, Sales Enablement, Operational Efficacy, Research & Development, On-boarding & Training and  many more.\n\nHighlights of the XR-Workflow App are Product visualization, VR enablement and X-Ray mode simulation.", "short_description": "Redefining immersive product visualization experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://onexr.us/metaapp/privacy-policy/index.html", "developer_terms_of_service_url": null, "publisher_name": "Augray LLC", "support_website_url": null, "website_url": "https://onexr.in/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "877379582865093"}, {"id": "1063584910766706"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8727175087373292"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/39003277_819125343159216_7599392833159282618_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v0kvD03xD-IQ7kNvwEdMOgl&_nc_oc=AdpZaNPPsNMO
tl3-1.oculuscdn.com/v/t64.5771-25/75294241_8566233990059444_3601241169210985988_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=buqb92nWg_oQ7kNvwH_4Yzi&_nc_oc=AdqVt8eeAkIHeFXe8pBDIa8Jr1QaZjqNCuIQRreYEOirEh7BX_INp0K7gYgfE_LDvoY&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afy0NqDHEAxfZH1KmCt3nSb7-9AV3QChZeYe__B4_kZYig&oe=69CFB7E3"}, {"file_name": "Screenshot3.png", "id": "1473438296626212", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38982651_1473438299959545_7532312566202638856_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EqpQZLHmdkAQ7kNvwFm_Fiu&_nc_oc=Adp8oLXIXNu1HfhqSoH7lkDkloDA9RDzSCG-nuBUTUa9xZxAAs5T_lpJ6_IBJU0sz-o&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzeFKKxiJXu4gtS4mo4s5B2yNqHOOA50yZqgQHJMw18Cw&oe=69CFA072"}, {"file_name": "Screenshot4.png", "id": "475352788365462", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974668_475352791698795_6513029807440269328_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LzR9n7zr5YoQ7kNvwElfO_4&_nc_oc=AdrrfRE5EVAbGIG87W_rbjbbC0XQeb3QqAMyI32UX-Ij79Cy9nQWZGZJn2JdZj52NxQ&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxD1hiAZ6p_hqGqjk5wINBbs-hFYJeRx_fk1kgqY52ssw&oe=69CFBD6E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TrailerCover.png", "id": "1679571196183084", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38982534_1679571199516417_7292601014387023875_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3hn3PBhpty8Q7kNvwHYKsR3&_nc_oc=Adr_8sf2LlcvEar-bqYMPz6E1ZqvVb3qtHlRAA-5LaBRJjehZC7bfRFRrBHwshXRGak&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzKmtdT9SsrTrLXz0hNjfdYJg2CeVRWJZvWGgLkEKfggw&oe=69CFCA6B"}, "display_name": "XR-Workflow", "keywords": [], "long_description": "Organizations across the world, especially the manufacturing companies, experience difficulty in obtaining expertise for selling & marketing machines digitally, and have to depend on traditional methods of marketing, which result in millions of dollars.\n\nXR-Workflow : VR application enables virtual delivery of contents related to your products for the prospects to help them during the pre-purchase stage, which can work on Meta VR headset devices. It elevates the level of service a user receives without worrying about the impact of geographical boundaries.\n\nXR-Workflow app has various aspects, in several segments of the business such as Remote Auditing, Sales Enablement, Operational Efficacy, Research & Development, On-boarding & Training and  many more.\n\nHighlights of the XR-Workflow App are Product visualization, VR enablement and X-Ray mode simulation.", "short_description": "Redefining immersive product visualization experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://onexr.us/metaapp/privacy-policy/index.html", "developer_terms_of_service_url": null, "publisher_name": "Augray LLC", "support_website_url": null, "website_url": "https://onexr.in/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "877379582865093"}, {"id": "1063584910766706"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8727175087373292"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39003277_819125343159216_7599392833159282618_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bwwgTz1oquIQ7kNvwEE7HQv&_nc_oc=AdreST9YJi6p
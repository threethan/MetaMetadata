a0a&_nc_ohc=bLqImXvRZiwQ7kNvwHvTG3T&_nc_oc=Adl-ALKhCVGCrSvFRqIZ8ljy3Qp94FNL5__FqVuGs65mIcC2j_IHfPIHZP-FyxWBxDA&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&oh=00_AfsriQtI7eBDJIzNL9p-4BZuCiIE4S83Y56xmxFXqIcyBw&oe=699858E3"}, {"file_name": "Screenshot3.png", "id": "1473438296626212", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982651_1473438299959545_7532312566202638856_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T-A_d8Sl_1kQ7kNvwHo4qHY&_nc_oc=AdkiOy_RnXV53cW_w4g8yNhPODE1zvWm0yLaI0ih1myv8ER1H6gfLGr9CXjK90EX7I4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&oh=00_AfuUd6GRvFiGRIDpvJVM-ZihYvbuQgiuOa0tsWhz7-E-Hw&oe=69984172"}, {"file_name": "Screenshot4.png", "id": "475352788365462", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974668_475352791698795_6513029807440269328_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pHjW2rEhTjEQ7kNvwH-Lsr7&_nc_oc=Adl5gZflYeExaEREPnq9EPxoEvjiPYAFua2qW1XqzHL3DhR4oOB5eZ4_JhS6-wEOq9Y&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&oh=00_AfsgBQuFHOf3SlQ45RUDu9x_tUYE8rwSMsdOctC-DOrkPA&oe=69985E6E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TrailerCover.png", "id": "1679571196183084", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982534_1679571199516417_7292601014387023875_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_5bnZT0epNsQ7kNvwFnr_47&_nc_oc=AdmHY-EAx6zVtI44XoKQJOQPb622ImWiSAWQliWmA8vbvnsGOBB4IbVDAx8PjP4Pzgc&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&oh=00_AfvDN5uWVYmBbq-9q2fWsZj9U6Z4b4hCFI_6MWMZxOnAyg&oe=69986B6B"}, "display_name": "XR-Workflow", "keywords": [], "long_description": "Organizations across the world, especially the manufacturing companies, experience difficulty in obtaining expertise for selling & marketing machines digitally, and have to depend on traditional methods of marketing, which result in millions of dollars.\n\nXR-Workflow : VR application enables virtual delivery of contents related to your products for the prospects to help them during the pre-purchase stage, which can work on Meta VR headset devices. It elevates the level of service a user receives without worrying about the impact of geographical boundaries.\n\nXR-Workflow app has various aspects, in several segments of the business such as Remote Auditing, Sales Enablement, Operational Efficacy, Research & Development, On-boarding & Training and  many more.\n\nHighlights of the XR-Workflow App are Product visualization, VR enablement and X-Ray mode simulation.", "short_description": "Redefining immersive product visualization experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://onexr.us/metaapp/privacy-policy/index.html", "developer_terms_of_service_url": null, "publisher_name": "Augray LLC", "support_website_url": null, "website_url": "https://onexr.in/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "877379582865093"}, {"id": "1063584910766706"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8727175087373292"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39003277_819125343159216_7599392833159282618_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3Wm_DwDkUvIQ7kNvwEZ-3dj&_nc_oc=Adm3LRtx68kLOiplAR_6VlrQBly2V5ic1T4DJjtFoR6SKnEJn4mTc8UXlR6jpfonS3g&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&oh=00_Afsl4QGQDnj0-YwO3v9XnyXf90wxOffM3OLgCpfhz0trSw&oe=6998562D"},
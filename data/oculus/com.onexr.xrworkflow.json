hr8-2.oculuscdn.com/v/t64.5771-25/75294241_8566233990059444_3601241169210985988_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zAY1tHs5Zc0Q7kNvwH8qUHh&_nc_oc=Adr7P7Ok0n8oqfci-dqul3WKp8P95ppejjAEtWqmEFwRQVJYqcZ1U1W8RmrrcIXBKeY&_nc_zt=3&_nc_ht=scontent-lhr8-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3ZvyUVAEAIQmhJ1eK0kYPWzhEWaAplwn3BeWx7Uyyd5g&oe=69E22CE3"}, {"file_name": "Screenshot3.png", "id": "1473438296626212", "uri": "https://scontent-lhr8-2.oculuscdn.com/v/t64.5771-25/38982651_1473438299959545_7532312566202638856_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nlmQXYXQwK4Q7kNvwGwgbeP&_nc_oc=AdqwmpLEeIRdFbGtQgP-cR_DdJWJv3idBFUxpcZ58smwD_U03ahU5VAIdZZPwadmYGU&_nc_zt=3&_nc_ht=scontent-lhr8-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1rwrMVwopskfkYiUW8NMH04UoGPU8CGZH6Iwn7w90WAg&oe=69E24DB2"}, {"file_name": "Screenshot4.png", "id": "475352788365462", "uri": "https://scontent-lhr8-2.oculuscdn.com/v/t64.5771-25/38974668_475352791698795_6513029807440269328_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ns07D1mz_ZcQ7kNvwGlQigA&_nc_oc=Adpg4e4Fd5HwBtysjWWVMT14FlWs7jVO5t6f_ZQ9TwMOwkfyA4ALBa94rCj_YxBjZwo&_nc_zt=3&_nc_ht=scontent-lhr8-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1pPkeHz_Mk2z6mW3CB-X92YtkQzL2JhQZtFMUWP6OUtQ&oe=69E2326E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TrailerCover.png", "id": "1679571196183084", "uri": "https://scontent-lhr8-2.oculuscdn.com/v/t64.5771-25/38982534_1679571199516417_7292601014387023875_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aV3txQZeQ9oQ7kNvwF3SbPa&_nc_oc=AdoTqjPGX-C10lmQ1inrM-sUiCsNnHedwOyn5dwkUL_w2eO72oIgOFL9nIYPpvnPKCo&_nc_zt=3&_nc_ht=scontent-lhr8-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0vGiIIj3SBQyX5G8hNhsHR8xuiIA7ff58c_jFXqn3Zqw&oe=69E23F6B"}, "display_name": "XR-Workflow", "keywords": [], "long_description": "Organizations across the world, especially the manufacturing companies, experience difficulty in obtaining expertise for selling & marketing machines digitally, and have to depend on traditional methods of marketing, which result in millions of dollars.\n\nXR-Workflow : VR application enables virtual delivery of contents related to your products for the prospects to help them during the pre-purchase stage, which can work on Meta VR headset devices. It elevates the level of service a user receives without worrying about the impact of geographical boundaries.\n\nXR-Workflow app has various aspects, in several segments of the business such as Remote Auditing, Sales Enablement, Operational Efficacy, Research & Development, On-boarding & Training and  many more.\n\nHighlights of the XR-Workflow App are Product visualization, VR enablement and X-Ray mode simulation.", "short_description": "Redefining immersive product visualization experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://onexr.us/metaapp/privacy-policy/index.html", "developer_terms_of_service_url": null, "publisher_name": "Augray LLC", "support_website_url": null, "website_url": "https://onexr.in/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "877379582865093"}, {"id": "1063584910766706"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8727175087373292"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lhr8-2.oculuscdn.com/v/t64.5771-25/39003277_819125343159216_7599392833159282618_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ueAIgZXRtHYQ7kNvwFztGY1&_nc_oc=AdpYYUfYs0vL
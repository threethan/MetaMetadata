a0a&_nc_ohc=7LCnoYbJynsQ7kNvwHHevMD&_nc_oc=Admn0mcWCY02vp_czTDzuPt8zt3TOVtZ2dD-Gxn1wB78KI09sD0Z1bopyyAQbOTXXBY&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfsQbb978mNX--_4fF_joNb_C4rJutdH8ruecF870ed_PQ&oe=699C4D63"}, {"file_name": "Screenshot3.png", "id": "1473438296626212", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982651_1473438299959545_7532312566202638856_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zFhrkRklZJcQ7kNvwE6VWuE&_nc_oc=AdkxnFLF-Bf9Jh9uX1eKzb_dNDS7HSzeMwlAlMwssuByE2h1BI6AWkSvo0SjmfFPiiw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_AfvsME7g4NKd68SQvhLS4c-pC6BQKSdclga2XutgN1J5-g&oe=699C35F2"}, {"file_name": "Screenshot4.png", "id": "475352788365462", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974668_475352791698795_6513029807440269328_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2lyiWF7HUG8Q7kNvwH1Vd2r&_nc_oc=Adnq8IFJhdRxWGeSUdt2a9o6ozXW4KT1KqikOW8_5rwd-HiAa7kN95feAG_dJvrwtg8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AftLA39Ev8logjeAg4e_MvuI9671TO3OUkOf9Mzoay1qeQ&oe=699C52EE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TrailerCover.png", "id": "1679571196183084", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982534_1679571199516417_7292601014387023875_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IvQRyVF-t_IQ7kNvwGifpcH&_nc_oc=AdltXe3dFOE-_Q3KcyzC0ifoWrRH5H4x9zVvwy6ETb5SYcmN1afSUpDRtSknGmKrjHg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AfsNBZImvfDxWK0aMBvLovXUmWAmgiO0pBfPmntC9HIovA&oe=699C5FEB"}, "display_name": "XR-Workflow", "keywords": [], "long_description": "Organizations across the world, especially the manufacturing companies, experience difficulty in obtaining expertise for selling & marketing machines digitally, and have to depend on traditional methods of marketing, which result in millions of dollars.\n\nXR-Workflow : VR application enables virtual delivery of contents related to your products for the prospects to help them during the pre-purchase stage, which can work on Meta VR headset devices. It elevates the level of service a user receives without worrying about the impact of geographical boundaries.\n\nXR-Workflow app has various aspects, in several segments of the business such as Remote Auditing, Sales Enablement, Operational Efficacy, Research & Development, On-boarding & Training and  many more.\n\nHighlights of the XR-Workflow App are Product visualization, VR enablement and X-Ray mode simulation.", "short_description": "Redefining immersive product visualization experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://onexr.us/metaapp/privacy-policy/index.html", "developer_terms_of_service_url": null, "publisher_name": "Augray LLC", "support_website_url": null, "website_url": "https://onexr.in/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "877379582865093"}, {"id": "1063584910766706"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8727175087373292"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39003277_819125343159216_7599392833159282618_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qxGk9-UjuU4Q7kNvwHZDx4D&_nc_oc=Adn1lv7MX4bK08cDvaDzWgQb51adsh6T3AkxVCOGLux_ZHSOR7xeQl2foTXxSr8L0SE&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfuqlRpHSj4trQcJvU_wrilqbeKqSAVv9EkhDPcE4awjxg&oe=699C4AAD"},
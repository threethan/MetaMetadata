fw6-1.oculuscdn.com/v/t64.5771-25/75294241_8566233990059444_3601241169210985988_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aPCKacKcBFoQ7kNvwG_ahaj&_nc_oc=AdpF0laUduv6-UIo-ixVC7exy_7FBGkAF_s9uS3Xm486y4_DLfMoitYIvNFfcbQzL2Q&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5JRZh7LWFwTJE-1tYYuPINfYDOsqgmB6XYKfrKewB0dg&oe=6A0EFFE3"}, {"file_name": "Screenshot3.png", "id": "1473438296626212", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38982651_1473438299959545_7532312566202638856_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0zbwiKja-nUQ7kNvwFt6w5x&_nc_oc=Adps_jz0w8BpTfkQ7o3kKIkV5t56iiI5iBFa5nP92S_JCSQPu9PbuWO6ueeCtx5K8oo&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4U9UjhQX6vLQ63G5ZgXp_ETgBWOZO_3hWv_jczOGodUg&oe=6A0F20B2"}, {"file_name": "Screenshot4.png", "id": "475352788365462", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974668_475352791698795_6513029807440269328_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rsI2EXQ__fkQ7kNvwHb4I5i&_nc_oc=AdpmyABZWD3o6y_gSspihk39Z4gXTxisUX8CdCmMFCqqhP8IAKZtpeQPMuC5Ga-e7to&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7mj0MCSa78W5ZiH4kVGt4xmJA52cA0dhDtqmvh-8obzA&oe=6A0F056E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TrailerCover.png", "id": "1679571196183084", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38982534_1679571199516417_7292601014387023875_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wOjoCZn226QQ7kNvwFwca7j&_nc_oc=AdqZlR6HUpg3PSaYn1JaV81cGlzR5C-dlV9WqlkSKq0Kl9tR8I_gNPOL7Jwb5W94LqU&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af55MSv0o-NeZWP1nEotPA_LhVmHpVM_vCRGWHyQcRDEtA&oe=6A0F126B"}, "display_name": "XR-Workflow", "keywords": [], "long_description": "Organizations across the world, especially the manufacturing companies, experience difficulty in obtaining expertise for selling & marketing machines digitally, and have to depend on traditional methods of marketing, which result in millions of dollars.\n\nXR-Workflow : VR application enables virtual delivery of contents related to your products for the prospects to help them during the pre-purchase stage, which can work on Meta VR headset devices. It elevates the level of service a user receives without worrying about the impact of geographical boundaries.\n\nXR-Workflow app has various aspects, in several segments of the business such as Remote Auditing, Sales Enablement, Operational Efficacy, Research & Development, On-boarding & Training and  many more.\n\nHighlights of the XR-Workflow App are Product visualization, VR enablement and X-Ray mode simulation.", "short_description": "Redefining immersive product visualization experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://onexr.us/metaapp/privacy-policy/index.html", "developer_terms_of_service_url": null, "publisher_name": "Augray LLC", "support_website_url": null, "website_url": "https://onexr.in/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "877379582865093"}, {"id": "1063584910766706"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8727175087373292"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39003277_819125343159216_7599392833159282618_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sIXcMqmiEpMQ7kNvwG2i53n&_nc_oc=AdqqxMZx4K2S
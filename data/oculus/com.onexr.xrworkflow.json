2"}, {"file_name": "Screenshot4.png", "id": "475352788365462", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974668_475352791698795_6513029807440269328_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eY7Aeuf3eWoQ7kNvwFtXF63&_nc_oc=AdmzkC-oXFm36TnyibMowO4sNAtsdH1h2EqleJgGFzF1nmSbDl6P6paDx3Vr3c6x0p0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfvJ04OJYTo0psDyuF4M_3GO4aNanlieEFdwrMLpEAidsA&oe=69A8306E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TrailerCover.png", "id": "1679571196183084", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982534_1679571199516417_7292601014387023875_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uAplQ1N8YDIQ7kNvwHt0vN-&_nc_oc=AdnGqDXPFRbXjxeTxnaqn79FYnSycCjWKGVa1tNDhsiepzlNeX7LnY1sTQyIK2rtj7A&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Aftgp-_vvrBUvCxRm986rc2SG_HWL7add9G8rftxaVWpaA&oe=69A83D6B"}, "display_name": "XR-Workflow", "keywords": [], "long_description": "Organizations across the world, especially the manufacturing companies, experience difficulty in obtaining expertise for selling & marketing machines digitally, and have to depend on traditional methods of marketing, which result in millions of dollars.\n\nXR-Workflow : VR application enables virtual delivery of contents related to your products for the prospects to help them during the pre-purchase stage, which can work on Meta VR headset devices. It elevates the level of service a user receives without worrying about the impact of geographical boundaries.\n\nXR-Workflow app has various aspects, in several segments of the business such as Remote Auditing, Sales Enablement, Operational Efficacy, Research & Development, On-boarding & Training and  many more.\n\nHighlights of the XR-Workflow App are Product visualization, VR enablement and X-Ray mode simulation.", "short_description": "Redefining immersive product visualization experience."}]}, "developer_name": null, "developer_privacy_polic
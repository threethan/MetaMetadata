6355944/", "short_description": "Learn some skills to use whilst playing GRAB, whether you're building or just messing around. GRAB Tutorials is a place to pick up movement tips, tricks, and building basics to help you get better at the game."}]}, "developer_name": "Standi", "developer_privacy_policy_url": "https://grab-tutorials.live/privacy", "developer_terms_of_service_url": null, "publisher_name": "Standi", "support_website_url": null, "website_url": "https://grab-tutorials.live/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25846354488390014"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499303788_725689660430081_8494001442773096455_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1Vgfte6Bj6UQ7kNvwGUbNGr&_nc_oc=AdroSC56zh-oNG26jciRYj85FguyVOPf5I_RrC3xVWgYxnKEQVBXULT4KxyyEP1s8bg&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL1qwv77NJS5lwb-EwuOkwlaCe6PVsTI4QqCNLGakMaKQ&oe=6AAD36C8"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "GRAB Tutorials", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_name": "Learning", "id": "1043107547362485"}], "release_date": 1754077200, "lastRevision": {"nodes": [{"id": "2397
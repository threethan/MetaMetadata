vwGef3zS&_nc_oc=AdrxAXwnLUUZHuH5fXPXjJxNJI1-NcFXL40ZniE-Rn7V-_yszTCn1DUIG5MgQMdEy2I&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9xaOUASIv9dYcK0pRaC8A_1tztXLjpffivAMrEhDvXDA&oe=6A36A20F"}, {"file_name": "004.png", "id": "650062034378259", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/499619697_650062037711592_5954647755167720491_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LqpVvPfS9GIQ7kNvwHUp9hY&_nc_oc=AdoqglqHPGCznFTrAmbBv6iN7VxA1UTpOCdpGmMv48XKWNbpufctHZoqocUaS8qUXBA&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8gRmjIz2DMjo5RUSaAPTgC3DpFzCUsn0-QU54j3wmcmg&oe=6A36C32D"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "CapuLegacy", "keywords": ["Monkey", "Apes", "Gorilla", "capu", "Horror"], "long_description": "CapuLegacy is a project being actively worked on by the Legacy Team, aimed to bring back what people know as \"OG Capuchin\"! CapuLegacy is a full remake of Capuchin V1, made from the ground up without using any stolen or copied content. You can run around as a monkey with your friends and explore multiple different areas! Like Zero Gravity, Shop, Sandland, Snowland, and most importantly Horror! There's so many different gamemodes to play, you'll never stop having fun! \n{1102521518636829}", "short_description": "CapuLegacy\n\nBringing back an old game for the new generation, remade completely from the ground up."}]}, "developer_name": "LegacyGames", "developer_privacy_policy_url": "https://sites.google.com/view/capulegacy/privacy-policy?authuser=1", "developer_terms_of_service_url": "https://sites.google.com/view/capulegacy/terms-of-service?authuser=1", "publisher_name": "LegacyGames", "support_website_url": null, "website_url": "https://legacygamesllc.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "269
", "capu", "Horror"], "long_description": "CapuLegacy is a project being actively worked on by the Legacy Team, aimed to bring back what people know as \"OG Capuchin\"! CapuLegacy is a full remake of Capuchin V1, made from the ground up without using any stolen or copied content. You can run around as a monkey with your friends and explore multiple different areas! Like Zero Gravity, Shop, Sandland, Snowland, and most importantly Horror! There's so many different gamemodes to play, you'll never stop having fun! \n{1102521518636829}", "short_description": "CapuLegacy\n\nBringing back an old game for the new generation, remade completely from the ground up."}]}, "developer_name": "LegacyGames", "developer_privacy_policy_url": "https://sites.google.com/view/capulegacy/privacy-policy?authuser=1", "developer_terms_of_service_url": "https://sites.google.com/view/capulegacy/terms-of-service?authuser=1", "publisher_name": "LegacyGames", "support_website_url": null, "website_url": "https://legacygamesllc.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER"], "id": "26079779914947462"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491819396_1797978994255650_3981697064751169953_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TiVEmEn
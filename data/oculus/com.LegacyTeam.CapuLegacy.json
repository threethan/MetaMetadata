land, Snowland, and most importantly Horror! There's so many different gamemodes to play, you'll never stop having fun! \n{1102521518636829}", "short_description": "CapuLegacy\n\nBringing back an old game for the new generation, remade completely from the ground up."}]}, "developer_name": "LegacyGames LLC", "developer_privacy_policy_url": "https://sites.google.com/view/capulegacy/privacy-policy", "developer_terms_of_service_url": "https://sites.google.com/view/capulegacy/terms-of-service", "publisher_name": "LegacyGames LLC", "support_website_url": "https://discord.gg/capuchin", "website_url": "https://sites.google.com/view/capulegacy", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER"], "id": "28412416061683824"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491819396_1797978994255650_3981697064751169953_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WTf3ADqE1kIQ7kNvwHx8kk8&_nc_oc=AdrKsQabvkTA-OCfKJfhBbDkyum0ABYhFY-4GH6JT6ZKiNmHQC6Wp74URcj13L4fTnY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLOubULUuChMCODP4kUHikYmMGDDLGf87x9rNTeLWCAlA&oe=6A9D756F"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "CapuLegacy", "platform": "ANDROID_6DOF", "context_category": {"cont
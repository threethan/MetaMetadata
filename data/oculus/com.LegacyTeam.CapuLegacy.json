2037711592_5954647755167720491_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FYfWsNyWUCIQ7kNvwGo5CW0&_nc_oc=AdoC9nb-gFvimndBsUOPY5aJ2F4ELGQ9jwdmTPq5_PA_TLc62wXwzHA_PO5whzIlCuk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af1EzYHwKLhPaKc7lfmZD02SFrCjqArIgXoz_i4adDD25w&oe=69F0AB6D"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "CapuLegacy", "keywords": ["Monkey", "Apes", "Gorilla", "capu", "Horror"], "long_description": "CapuLegacy is a project being actively worked on by the Legacy Team, aimed to bring back what people know as \"OG Capuchin\"! CapuLegacy is a full remake of Capuchin V1, made from the ground up without using any stolen or copied content. You can run around as a monkey with your friends and explore multiple different areas! Like Zero Gravity, Shop, Sandland, Snowland, and most importantly Horror! There's so many different gamemodes to play, you'll never stop having fun! \n{1102521518636829}", "short_description": "CapuLegacy\n\nBringing back an old game for the new generation, remade completely from the ground up."}]}, "developer_name": "LegacyGames", "developer_privacy_policy_url": "https://sites.google.com/view/capulegacy/privacy-policy?authuser=1", "developer_terms_of_service_url": "https://sites.google.com/view/capulegacy/terms-of-service?authuser=1", "publisher_name": "LegacyGames", "support_website_url": null, "website_url": "https://legacygamesllc.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["O
kNvwGIZP-G&_nc_oc=AdpfYvL6IAMG8c_olOfrR5_A7d2eb9f-fwkAq7na9xxeAXbt5enekpST6Js5qZiqhJQ&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAMFi_vogruvZ2Uy8fiMMh5INnlJJxpZeTKzOihdBVQDA&oe=6A689141"}, {"file_name": "Untitled design (8).png", "id": "1000525166147376", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499628067_1000525169480709_6597114169711648330_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E20qINGF6tgQ7kNvwHa1NU-&_nc_oc=AdqBZrK7G_Z-Q5mcGCkNduKVO0lF2pay8_p0lP-iaahddlV011dHZxbYBlwREVtUFt0&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAZt6_i1ICI5fbmybunkfGuEa0YbLpBfnRw3d5EBPJY-w&oe=6A68919B"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "SimianPVP", "keywords": ["Simian", "GunPVP", "East", "GorillaTagFangame"], "long_description": "# What is Simian?\nSimian is a professionally made **Gun PVP** Fangame owned by East and developed with Stephenweb!\n# Background\nSimian was originally released in early 2025 and has gone through two whole revamps and rebrands. Every update improves the game and the player experience to satisfy every player who downloads the game! Some popular Gorilla Tag content creators such as StyledSnail have played Simian and enjoyed it, and more!\n# Community\nThe community of Simian is the core of the game. The community often decides what is added and have a huge part in saying what could make the game better!\n# Why Download?\n1. Smooth Game Experience\n2. Amazing Community\n3. Simian is up and coming!\n", "short_description": "Simian is a professionally made Gun PVP Fangame owned by East and developed with Stephenweb!"}]}, "developer_name": "EastDev", "developer_privacy_policy_url": "https://sites.google.com/view/simianpvp/privacy-policy?authuser=0", "developer_terms_of_service_url": null, "publisher_name": "EastDev", "support_website_url": null, "website_url": "https://sites.google.com/view/simianpvp/home", "category": null, "comfort_rating": "COMFORTABLE
kNvwHVd05k&_nc_oc=AdpbQsgK9PtGUfOv-gT0jBu5Cq9xkU441dKcg3j-4YaVrASI14imLGjeryR7S7ATdVI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIIO3TtpdBDSYQ7fsSaK-ocWuezPcVNyfkJrVqGow6obQ&oe=6A999101"}, {"file_name": "Untitled design (8).png", "id": "1000525166147376", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499628067_1000525169480709_6597114169711648330_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NOKTghFdlaQQ7kNvwFIfZ_V&_nc_oc=Adrl0ShuBzJ2gnvNQdxJqt3PP010Hs6uxLRwMNGbX4N21BRSFhGWvc93GhL3lE-CbI4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKPQb81CQDRlYqPz_BsfTYMjslbKpBFMyAxhbdRelAwWQ&oe=6A99915B"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "SimianPVP", "keywords": ["Simian", "GunPVP", "East", "GorillaTagFangame"], "long_description": "# What is Simian?\nSimian is a professionally made **Gun PVP** Fangame owned by East and developed with Stephenweb!\n# Background\nSimian was originally released in early 2025 and has gone through two whole revamps and rebrands. Every update improves the game and the player experience to satisfy every player who downloads the game! Some popular Gorilla Tag content creators such as StyledSnail have played Simian and enjoyed it, and more!\n# Community\nThe community of Simian is the core of the game. The community often decides what is added and have a huge part in saying what could make the game better!\n# Why Download?\n1. Smooth Game Experience\n2. Amazing Community\n3. Simian is up and coming!\n", "short_description": "Simian is a professionally made Gun PVP Fangame owned by East and developed with Stephenweb!"}]}, "developer_name": "EastDev", "developer_privacy_policy_url": "https://sites.google.com/view/simianpvp/privacy-policy?authuser=0", "developer_terms_of_service_url": null, "publisher_name": "EastDev", "support_website_url": null, "website_url": "https://sites.google.com/view/simianpvp/home", "category": null, "comfort_rating": "COMFORTABLE
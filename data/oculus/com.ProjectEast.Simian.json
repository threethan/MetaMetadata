quCjQ&oe=69F0ABCC"}, {"file_name": "Untitled design (8).png", "id": "1780617056149340", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/507849536_1780617059482673_5502235327505092693_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1jocuDipQ1EQ7kNvwE3Ezzz&_nc_oc=Adp94SLCm3qw37kToaGjJNIx9Im3VpvTdsBbUuoEG1ap8BZz3aImORQ1NQxFWIhIRDI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Af1yGlkBecRGFTFz1LyxqbkumLpVYJYPEOobAEpxRqQDig&oe=69F0B116"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Untitled design (9).png", "id": "1134474674682203", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491825050_1134474678015536_578404934795286762_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dFO6lfwSzlkQ7kNvwHjFyLj&_nc_oc=AdptJD_Osziw9Fa9VmJRWpAm-lCIOTSa-uVVrfPZWbAUb90GUauybBnZWufPDFFVHF4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Af2TMmY0LmdiNYiG8vqrpR_ldOPU2kW6TvH4INAH2dT04A&oe=69F0CC8D"}, "display_name": "Simian", "keywords": ["Simian", "GorillaTagFangame", "PVP", "Indie"], "long_description": "Simian is a fun, well made VR experience designed for the enjoyment of anybody! It features Gorilla Tag locomotion mixed with a player vs player experience using well known weapons like a Pistol, AR, and Sniper. Simian is a community ran game, making the game a cozy and entertaining experience for all! It has different maps to play in and different modes like horror and a never seen before \"Foam Fall\".  The game is well made and well optimized for all VR headsets including the Oculus Quest 2! Simian provides a smooth and fun experience for all headsets and players. Download and join in on the fun!", "short_description": "Simian is a fun, well made VR experience designed for the enjoyment of anybody! It features Gorilla Tag locomotion mixed with a player vs player experience.  Hop in and enjoy the fun!"}]}, "developer_name": "EastVR (East Interactive Studios)", "developer_privacy_policy_url": "https://sites.google.com/view/simianpriva
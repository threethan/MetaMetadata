kNvwEaEEYZ&_nc_oc=AdqbFL_6AJ7uoSlsBagsfsjx24tWO1W5DLE3hWLlJgd5nI5RKt5z6x9BpmyH_B7MrxE&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGYkt8XecSEOnYjdR1IZG1lkkGsTQNEnkENgSULD9hsPA&oe=6A9412C1"}, {"file_name": "Untitled design (8).png", "id": "1000525166147376", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/499628067_1000525169480709_6597114169711648330_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qFxudXc41JwQ7kNvwHzNraT&_nc_oc=AdqSBQdK4wB6X9Tq2L6Eog53ExTCVRRMzz4KH27zgrH7u9wfmd6M97F0M7wNGazKzRA&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH1zXft5AZwX-IGF_IY_55VoUH5kGl9LbUR4mxgPkvghA&oe=6A94131B"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "SimianPVP", "keywords": ["Simian", "GunPVP", "East", "GorillaTagFangame"], "long_description": "# What is Simian?\nSimian is a professionally made **Gun PVP** Fangame owned by East and developed with Stephenweb!\n# Background\nSimian was originally released in early 2025 and has gone through two whole revamps and rebrands. Every update improves the game and the player experience to satisfy every player who downloads the game! Some popular Gorilla Tag content creators such as StyledSnail have played Simian and enjoyed it, and more!\n# Community\nThe community of Simian is the core of the game. The community often decides what is added and have a huge part in saying what could make the game better!\n# Why Download?\n1. Smooth Game Experience\n2. Amazing Community\n3. Simian is up and coming!\n", "short_description": "Simian is a professionally made Gun PVP Fangame owned by East and developed with Stephenweb!"}]}, "developer_name": "EastDev", "developer_privacy_policy_url": "https://sites.google.com/view/simianpvp/privacy-policy?authuser=0", "developer_terms_of_service_url": null, "publisher_name": "EastDev", "support_website_url": null, "website_url": "https://sites.google.com/view/simianpvp/home", "category": null, "comfort_rating": "COMFORTABLE
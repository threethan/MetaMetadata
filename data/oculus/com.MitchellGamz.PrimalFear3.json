SgN7qRVjJJz6DEGE1ZLoDRNkc5FyAPRWkj0mJtf3OWjuW6c&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af62jcWDQQiqwiHOKk91zfyA0HABMYyT2UVOBphpEHkBZg&oe=6A09D4DE"}, {"file_name": "1000009081.png", "id": "618440881085479", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/473393325_618440884418812_7690941016357569490_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y0yNbbEi9IAQ7kNvwHjxjK2&_nc_oc=AdoGwOgYskJivzT_BxkK0vLipwRbaS_XL4Xsz5zYqO3EOMIk6Gs8w99tWnwynix0r1o&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4c3pS23YpdzwoP0LDpk3AqVVnzN-8M5bogAGjAvZqwJA&oe=6A09AE2F"}, {"file_name": "1000009083.png", "id": "997465245218546", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/473391959_997465248551879_4607359467547683019_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=whwDROejlOcQ7kNvwEjk9eS&_nc_oc=AdrA3kjTUcF5vS7IDpYKALvuntt5dIdzwAdR0Wrsz6bD7z9vt9tJAA1TD3PYGhYTpcU&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af42w605lUll9QAW-DwXL0w_PC2mrRorBG7sGg4Xi2r7vw&oe=6A09ADFE"}, {"file_name": "1000009082.png", "id": "509685725292924", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/473392000_509685728626257_4367705163911195347_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8D_u8J4apDUQ7kNvwEmziJk&_nc_oc=Adp2EnkeQ86LrTKjjnK4MyPJulDSrdJBFXX5ar8uk63rHQosX0WD1CkDoSLKzRr4RZ4&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6XTf9el_SNQK4FYAbDX5gvegZm_1j9Kwu-rLrtYePnlw&oe=6A09CFEF"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Primal Fear 3", "keywords": ["Primal", "Fear", "Horror", "Scary"], "long_description": "Primal Fear 3 is an intense VR horror game that combines the fast-paced, hand-based movement of Gorilla Tag with heart-pounding survival gameplay. As you navigate through terrifying, ever-changing environments, you'll need to climb, leap, and swing to evade grotesque creatures that relentlessly hunt you. The immersive VR experience, dynamic lighting, and eerie sound design amplify the tension, while the hand locomotion system keeps you physically engaged in the fear. With every move critical to your survival, you\u2019ll need quick reflexes and agility to escape the nightmarish horrors lurking around every corner.", "short_description": "As you find yourself and the rest of your escape group left behind in an evacuation. It's up to you and the people around you to find a way out of the facility\n\n(game is not related to another axioms gorilla tag) "}]}, "developer_name": "MitchellGamz", "developer_privacy_policy_url": "https://sites.google.com/view/primalfear3/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "MitchellGamz", "support_website_url": null, "website_url": "https://sites.google.com/view/primalfear3/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "644354873106712"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "9134549533332204"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PENDING", "id": "978219841104589"}, {"status": "PUBLISHED", "id": "993322826109536"}]}, "baseline_offer": null, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 0, "status": "PENDING", "id": "978219841104589"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "9660199184100567", "version": "0.95.5"}, "id": "469141936015891", "channel_name": "LIVE"}]}, "is_for_oculus_
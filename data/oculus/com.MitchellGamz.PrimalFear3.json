"1000009084.png", "id": "1278838469865539", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473393325_1278838473198872_6024218930522145338_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yv1r_KBmWhgQ7kNvwG6MvO6&_nc_oc=AdoarpcZwZk5AUrHwaLnaG7Q00VQxhX9UbyNUju2S0w_jlpd8aufVSWGVhIcosvMuYg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKlhiKECiG06tiintjMwzKYjRB0rb4byOQxt2EvFSh8NQ&oe=6AA565DE"}, {"file_name": "1000009081.png", "id": "618440881085479", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473393325_618440884418812_7690941016357569490_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_LlYpwWDt14Q7kNvwGVM1sr&_nc_oc=AdqeAp0YIyJdp3-odsKV7i540FnW8S3HdlBvvCIkcaIf-PqynRrLB1Ct-V8rx08gO-0&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKuHG_BsN62bndMPfoopGYqUt3uakzuQO1neRyoXN3kMg&oe=6AA53F2F"}, {"file_name": "1000009083.png", "id": "997465245218546", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391959_997465248551879_4607359467547683019_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Aw9nCysQ5P8Q7kNvwH0qS8P&_nc_oc=Adr1f8Rl5Ne4Rc04WXgnuKpBUXUaOSGKW1L17N5YG609G6lGL3X09J-9D38EMA-ZZm0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLFgAV-B31v-qBoM4Oo1iAxoN1aZbJDCgnj1hGmK9k8eA&oe=6AA53EFE"}, {"file_name": "1000009082.png", "id": "509685725292924", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473392000_509685728626257_4367705163911195347_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vURXX4QgnjUQ7kNvwHamJQV&_nc_oc=AdonIZNYX_l04zcjtqw9jc-BZYqN6FNGiU2aIRVLKhDlO58ex-zo85xdYeggagDkDUg&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK0wfwP-XG1x-2hCav5Dq6i-2ajC2sATJ7vHD-wK3x8cQ&oe=6AA560EF"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Primal Fear 3", "keywords": ["Primal", "Fear", "Horror", "Scary"], "long_description": "Primal Fear 3 is an intense VR horror game that combines the fast-paced, hand-based movement of Gorilla Tag with heart-pounding survival gameplay. As you navigate through terrifying, ever-changing environments, you'll need to climb, leap, and swing to evade grotesque creatures that relentlessly hunt you. The immersive VR experience, dynamic lighting, and eerie sound design amplify the tension, while the hand locomotion system keeps you physically engaged in the fear. With every move critical to your survival, you\u2019ll need quick reflexes and agility to escape the nightmarish horrors lurking around every corner.", "short_description": "As you find yourself and the rest of your escape group left behind in an evacuation. It's up to you and the people around you to find a way out of the facility\n\n(game is not related to another axioms gorilla tag) "}]}, "developer_name": "MitchellGamz", "developer_privacy_policy_url": "https://sites.google.com/view/primalfear3/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "MitchellGamz", "support_website_url": null, "website_url": "https://sites.google.com/view/primalfear3/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "644354873106712"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "9134549533332204"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PENDING", "id": "978219841104589"}, {"status": "PUBLISHED", "id": "993322826109536"}]}, "baseline_offer": null, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 0, "status": "PENDING", "id": "978219841
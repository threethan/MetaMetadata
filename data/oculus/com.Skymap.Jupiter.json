uscdn.com/v/t64.5771-25/499304162_1421947345515402_4406876899546537077_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tNXBEo5F1JkQ7kNvwEWbkgV&_nc_oc=Adr0mPMHKdj4TTHNehNuTDluBmyD7ig2FtRqGhgJI9q-EbjzjURZUmhFNwhN23YJ9yY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4jg1dnCdxLxcqmM9cpnkZk5yV-8cKLkik9bdfhoqz10g&oe=6A1EDFF0"}, {"file_name": "LA Arena Bot Gameplay.png", "id": "645682508495393", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499624837_645682511828726_4246770989748218676_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xGaK4nknl_QQ7kNvwHBGF_F&_nc_oc=AdrxRQ7EzQFLeVySbruydwT48BldXG49Th1El7ylVOZDmLSz8qxIUi9mlCRbLQ1PSQk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4RVCCbyx41KTIi09oWWaB_jFWrIQxmKO86BRbBFNk25w&oe=6A1EE8C5"}, {"file_name": "Tokyo Arena Corkscrew Shot.png", "id": "1881771302676969", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499620519_1881771306010302_4005154004746166368_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UztjRk3NybMQ7kNvwGk5cmY&_nc_oc=AdreJ8DKHtlSe2yfGyl8TkERdXX-W4fiDY3d2byc3l7aI_kNwswG-t6wt28FZYjnSAQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af55A-ac028UJNRsU-0xZMqasKUbDxCKLyfO-khS2dZo9g&oe=6A1EDC07"}, {"file_name": "Paris Arena \u2013 Eiffel Tower.png", "id": "1032414955718955", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499302735_1032414962385621_2473093901058346991_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fSIcuhZppkwQ7kNvwGMKPA9&_nc_oc=AdqP4BAqhJYUJjT8xh8YH4oWD1GnAF_H7w2wN2iK0QIsP3Gk9NQMpwD0gtKk3-78-hM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6srnRbcHE3r4SusjiVJ_rl0bWzb-xAkKBezzNK_6xyuA&oe=6A1EE5F5"}, {"file_name": "Tokyo Arena Goal Celebration.png", "id": "740367268456917", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/507862311_740367271790250_5731865641411867408_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g9wmxuYOgDEQ7kNvwE1-DgD&_nc_oc=Adp2YygZTZmfJLYzKHgRkyxLTEy6OoJIA9ATAgNyGMrpD8fB4NQPA1mt7UEbS6AzTVc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4sWj0Y5uzKc23rsSHxEvmOM8OHPFPLAWCWncFJ0kyaSQ&oe=6A1ECDA5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440_Disc_PB.png", "id": "627784376999941", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499619090_627784380333274_2126154587082193564_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=srSiYD5SgHIQ7kNvwFNnPrG&_nc_oc=AdqIRLTthHz3o0AoC_7ZCipXZIRvGhyGfexYMgctlQEw3ehwIilNM2Jh_FYvCqrVkUc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6HhznEmMb3Ir126E8l9e5Xi_edQfBZqCj8bMRjTzAdug&oe=6A1ED0C8"}, "display_name": "DISC", "keywords": ["frisbee", "airhockey", "sports", "echo", "sparc"], "long_description": "**3D Air Hockey \u2013 Made for VR!** \n\nWelcome to DISC \u2013 a new sport created by ASICS.  \nStep into the arena with a fast-paced VR sport that tests your reflexes and rewards creativity. \n\n**Play FREE today \u2013 more updates coming soon!**\n{1017907263658795}\n\ud83d\udc7e **Singleplayer Campaign** \u2013 Take on 10 AI bot levels, each with their own playstyle and challenge.\n{1692200288068986}\n\ud83e\udd1d **1v1 Multiplayer** \u2013 Jump into instant matchmaking or host private games with friends.\n{1419364789091316}\n\ud83e\udd4f **Attack With Skill** \u2013 Curve forehands, smash power shots, and unleash corkscrew spins.\n{1175152467694364}\n\ud83d\udee1\ufe0f **Defend Your Goal** \u2013 Block shots like a soccer goalie and sharpen your reflexes every time you play.\n\n\ud83c\udfcb\ufe0f **Fun VR Workout** \u2013 Full-body action that keeps you moving. It\u2019s a fitness experience that doesn\u2019t feel like one.\n\n\ud83d\ude80 **Free to Play, More to Come** \u2013 Cosmetics, leaderboards, and new modes are on the way.\n\n\ud83d\udce3 **Join the Community** \u2013 Connect with players, find matches, and shape the future of DISC: disc.asics.com", "short_description": "3D Air Hockey \u2013 Made for VR!\n\nWelcome to DISC \u2013 a new sport created by ASICS."}]}, "developer_name": null, "developer_privacy_policy_url": "http://disc.asics.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "ASICS Ventures Corporation", "support_website_url": null, "website_url": "https://disc.asics.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "459781504968480"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER"], "id": "24611179708507972"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499301397_1299976474811446_7946021883643230404_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JKW6QwYeNYAQ7kNvwFOK1CY&_nc_oc=AdogcpcysnKt-mUkHnD99jWUOLA0IKX52PZxeUxspJQYZuiGAoJhmgPOM14GyOhgw3I&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6PeHMu0XZsgaac7eidhDsPI4MVfMICll1Cl6szdTNi0w&oe=6A1EDDD7"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "DISC", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Sports", "id": "2776542286000603"}, {"topic_name": "Action", "id": "459781504968480"}, {"topic_name": "Arcade", "id": "1592192974313489"}], "release_date": 1750964400, "lastRevision": {"nodes": [{"id": "9796932163692637", "release_type": "SCHEDULE
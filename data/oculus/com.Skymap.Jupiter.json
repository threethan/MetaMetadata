XlZk2el7PNLm1XXyF-n7JfD1c2j9KhtIZD1yka-w&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF88ngd1s8zRo_7xUEFpcd6ZV1eNq_SY_0a7sPdcQ0dUg&oe=6A8AE8A5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440_Disc_PB.png", "id": "627784376999941", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/499619090_627784380333274_2126154587082193564_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c0eGUsS1D2kQ7kNvwEd09jk&_nc_oc=Adrxg9YonoH9K6E4441xCEFrQDyhJJNw4EMSt-pqsvCRJU9b3FPKvHSZq1NlVZp3SZk&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGcRmR6F191fcverqypFBq_SAqJEr1LsHJxSAI-BVOJlA&oe=6A8AEBC8"}, "display_name": "DISC", "keywords": ["frisbee", "airhockey", "sports", "echo", "sparc"], "long_description": "**3D Air Hockey \u2013 Made for VR!** \n\nWelcome to DISC \u2013 a new sport created by ASICS.  \nStep into the arena with a fast-paced VR sport that tests your reflexes and rewards creativity. \n\n**Play FREE today \u2013 more updates coming soon!**\n{1017907263658795}\n\ud83d\udc7e **Singleplayer Campaign** \u2013 Take on 10 AI bot levels, each with their own playstyle and challenge.\n{1692200288068986}\n\ud83e\udd1d **1v1 Multiplayer** \u2013 Jump into instant matchmaking or host private games with friends.\n{1419364789091316}\n\ud83e\udd4f **Attack With Skill** \u2013 Curve forehands, smash power shots, and unleash corkscrew spins.\n{1175152467694364}\n\ud83d\udee1\ufe0f **Defend Your Goal** \u2013 Block shots like a soccer goalie and sharpen your reflexes every time you play.\n\n\ud83c\udfcb\ufe0f **Fun VR Workout** \u2013 Full-body action that keeps you moving. It\u2019s a fitness experience that doesn\u2019t feel like one.\n\n\ud83d\ude80 **Free to Play, More to Come** \u2013 Cosmetics, leaderboards, and new modes are on the way.\n\n\ud83d\udce3 **Join the Community** \u2013 Connect with players, find matches, and shape the future of DISC: disc.asics.com", "short_description": "3D Air Hockey \u2013 Made for VR!\n\nWelcome to DISC \u2013 a new sport created by ASICS."}]}, "developer_name": null, "developer_privacy_policy_url": "http://disc.asics.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "ASICS Ventures Corporation", "support_website_url": null, "website_url": "https://disc.asics.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "459781504968480"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER"], "id": "24611179708507972"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/499301397_1299976474811446_7946021883643230404_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6BlimdSuKMwQ7kNvwEJjYjX&_nc_oc=AdoqiPzx6dgdMlpqhE1s37-pGbLKQfIO9vM68zxso9qB_XGNraN0ny8IXOjg92qWMY8&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEpTP0f3KEJ3TepCLlVv-MehRsyrIF0ROHZv9X6-Lkpiw&oe=6A8AC097"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "DISC", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Sports", "id": "2776542286000603"}, {"topic_name": "Action", "id": "459781504968480"}, {"topic_name": "Arcade", "id": "1592192974313489"}], "release_date": 1750964400, "lastRevision": {"nodes": [{"id": "9796932163692637", "release_type": "SCHEDULE
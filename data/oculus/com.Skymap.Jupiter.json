OJG-B5NusjZTjwRnvAUq-v7PIfvqDRgDRg&oe=699DA907"}, {"file_name": "Paris Arena \u2013 Eiffel Tower.png", "id": "1032414955718955", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499302735_1032414962385621_2473093901058346991_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nQJg2OQxpiYQ7kNvwE72_Yq&_nc_oc=AdkQ7lFbIc8jN5t1p3otMHtsBtm8WG9cUxTarHMosFbplH0yxzIiORgNhbf5tsEdlcM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Aft9I0WmMtvK1DOftpf_VSySO4Q8eqW6ZMR_bODDAgv5fQ&oe=699DB2F5"}, {"file_name": "Tokyo Arena Goal Celebration.png", "id": "740367268456917", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/507862311_740367271790250_5731865641411867408_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uQ6luz_Fa6YQ7kNvwFJELwr&_nc_oc=Adlx3mi7ZTAmor9NZzBJT9wrAxaWChIkvFVP3-Z2X0SkIZeO9IOi4-DbdWGhJvBmbgA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afv5kbJoT8rKV5DXQkSvKU4DFi5-p7idGuYErG-4MwA93w&oe=699D9AA5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440_Disc_PB.png", "id": "627784376999941", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499619090_627784380333274_2126154587082193564_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8i_y4XliqgAQ7kNvwEkBPkZ&_nc_oc=AdlGYHStz1Gq2WWoz6jT97AGw-E4I9upaNse1kGoWuCA5-s8UnFi0qlHE9C-CuyWP-U&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Aftq4rvHumy4e5ztoXvSdjBVBDkEbNWoE-XF5KqPAY1yuA&oe=699D9DC8"}, "display_name": "DISC", "keywords": ["frisbee", "airhockey", "sports", "echo", "sparc"], "long_description": "**3D Air Hockey \u2013 Made for VR!** \n\nWelcome to DISC \u2013 a new sport created by ASICS.  \nStep into the arena with a fast-paced VR sport that tests your reflexes and rewards creativity. \n\n**Play FREE today \u2013 more updates coming soon!**\n{1017907263658795}\n\ud83d\udc7e **Singleplayer Campaign** \u2013 Take on 10 AI bot levels, each with their own playstyle and challenge.\n{1692200288068986}\n\ud83e\udd1d **1v1 Multiplayer** \u2013 Jump into instant matchmaking or host private games with friends.\n{1419364789091316}\n\ud83e\udd4f **Attack With Skill** \u2013 Curve forehands, smash power shots, and unleash corkscrew spins.\n{1175152467694364}\n\ud83d\udee1\ufe0f **Defend Your Goal** \u2013 Block shots like a soccer goalie and sharpen your reflexes every time you play.\n\n\ud83c\udfcb\ufe0f **Fun VR Workout** \u2013 Full-body action that keeps you moving. It\u2019s a fitness experience that doesn\u2019t feel like one.\n\n\ud83d\ude80 **Free to Play, More to Come** \u2013 Cosmetics, leaderboards, and new modes are on the way.\n\n\ud83d\udce3 **Join the Community** \u2013 Connect with players, find matches, and shape the future of DISC: disc.asics.com", "short_description": "3D Air Hockey \u2013 Made for VR!\n\nWelcome to DISC \u2013 a new sport created by ASICS."}]}, "developer_name": null, "developer_privacy_policy_url": "http://disc.asics.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "ASICS Ventures Corporation", "support_website_url": null, "website_url": "https://disc.asics.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "459781504968480"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER"], "id": "9796932147025972"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1407862257128657"}]}, "baseline_offer": {"id": "1407862257128657"}, "is_approved": true, "firstOf
uscdn.com/v/t64.5771-25/499304162_1421947345515402_4406876899546537077_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=74bYOQPgecQQ7kNvwFE6h0n&_nc_oc=AdpzyE9UZQTRk_sIZSyxaSi9tVRJNArW3JBLhQxX4SU1QMi-Y6LDimHQeKDgk7TngSQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9aeYx46GThOm_OBhlqmhilXKrSu88GIzCKC4_bnUFyMQ&oe=6A296BF0"}, {"file_name": "LA Arena Bot Gameplay.png", "id": "645682508495393", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499624837_645682511828726_4246770989748218676_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YK_dcx80FzgQ7kNvwEv1kGm&_nc_oc=Adq88leJ_8tRlM1bSGEN1VZJV3flpc6kfXTUyChCLkVbNYrISIR1IVsTVl5DODplWGE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9sXLRmOilWzNLDFcyWBIzbQH0FlWw8RSRWGk6EiNwUfw&oe=6A2974C5"}, {"file_name": "Tokyo Arena Corkscrew Shot.png", "id": "1881771302676969", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499620519_1881771306010302_4005154004746166368_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vPw2CRJXvfQQ7kNvwFXR11I&_nc_oc=Adrgbyq6FyC1Y5wbxn1Y-38LFWQnztTLS0t2v8pjzl0DOM8J_LK0MLLjVIb-aa9SYm8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_mO4f6zN1HsNqYpoebDEBisYwr7-xRx-8ZBf52k0HfFw&oe=6A296807"}, {"file_name": "Paris Arena \u2013 Eiffel Tower.png", "id": "1032414955718955", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499302735_1032414962385621_2473093901058346991_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1V5ZyIxFIHoQ7kNvwGPBGOe&_nc_oc=AdrI82CQetKCXRblfLn7q15zH85BWR27m0Hws5gnXiIkCK1z498ugl3KUeBXLX4ySpc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9vBfdQS3TD3PXZ9auf7U60CQ9GIoPYtgsdxdacNgCPBw&oe=6A2971F5"}, {"file_name": "Tokyo Arena Goal Celebration.png", "id": "740367268456917", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/507862311_740367271790250_5731865641411867408_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h-kWhCix6sIQ7kNvwGqobQn&_nc_oc=Adq10q2W3MKvmA9FIDTSwI9GvUCptgkTq1DIgFbXdhd7BJhz2cUSB_4ACbgNsPvrAe4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-XekxAQrWac-B-XzGrshkuPqCJKYvcb1I4dN5v7Z6_Rw&oe=6A2959A5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440_Disc_PB.png", "id": "627784376999941", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499619090_627784380333274_2126154587082193564_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MKUZM0EdWnYQ7kNvwHd874v&_nc_oc=AdqXy6F8dX_ndLYAfc-tnR4PnyEJSrgM8-rggiWNePUAwJ8p4HuZb6ZXZ3LktzrXLgQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af869VftEuyNwDd8dswkqXDjgFj9B9ZEIWyjuEJPDw5zHw&oe=6A295CC8"}, "display_name": "DISC", "keywords": ["frisbee", "airhockey", "sports", "echo", "sparc"], "long_description": "**3D Air Hockey \u2013 Made for VR!** \n\nWelcome to DISC \u2013 a new sport created by ASICS.  \nStep into the arena with a fast-paced VR sport that tests your reflexes and rewards creativity. \n\n**Play FREE today \u2013 more updates coming soon!**\n{1017907263658795}\n\ud83d\udc7e **Singleplayer Campaign** \u2013 Take on 10 AI bot levels, each with their own playstyle and challenge.\n{1692200288068986}\n\ud83e\udd1d **1v1 Multiplayer** \u2013 Jump into instant matchmaking or host private games with friends.\n{1419364789091316}\n\ud83e\udd4f **Attack With Skill** \u2013 Curve forehands, smash power shots, and unleash corkscrew spins.\n{1175152467694364}\n\ud83d\udee1\ufe0f **Defend Your Goal** \u2013 Block shots like a soccer goalie and sharpen your reflexes every time you play.\n\n\ud83c\udfcb\ufe0f **Fun VR Workout** \u2013 Full-body action that keeps you moving. It\u2019s a fitness experience that doesn\u2019t feel like one.\n\n\ud83d\ude80 **Free to Play, More to Come** \u2013 Cosmetics, leaderboards, and new modes are on the way.\n\n\ud83d\udce3 **Join the Community** \u2013 Connect with players, find matches, and shape the future of DISC: disc.asics.com", "short_description": "3D Air Hockey \u2013 Made for VR!\n\nWelcome to DISC \u2013 a new sport created by ASICS."}]}, "developer_name": null, "developer_privacy_policy_url": "http://disc.asics.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "ASICS Ventures Corporation", "support_website_url": null, "website_url": "https://disc.asics.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "459781504968480"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER"], "id": "24611179708507972"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499301397_1299976474811446_7946021883643230404_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xwX_fiRnxtYQ7kNvwGqPyWx&_nc_oc=AdppOJxXwy2y0L1-xISmaBBepB5UCeOo0g2GrvndkkhmT4Rmc3vie4RzUXnoJiCoFm4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8WzCUQyyHSKv7c5kVR7Mz7Zr4hr0edRW7hA_UCzJRI-A&oe=6A2969D7"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "DISC", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Sports", "id": "2776542286000603"}, {"topic_name": "Action", "id": "459781504968480"}, {"topic_name": "Arcade", "id": "1592192974313489"}], "release_date": 1750964400, "lastRevision": {"nodes": [{"id": "9796932163692637", "release_type": "SCHEDULE
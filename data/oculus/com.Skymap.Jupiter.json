uscdn.com/v/t64.5771-25/499304162_1421947345515402_4406876899546537077_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HK0Cf5utIjAQ7kNvwFX0Hta&_nc_oc=AdrgpjpKrJJhbEGTZFcdeOReL-0149pL41deWPuQJUGdseetOOthp0s2aTUkgbTaVsA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR3si4IU2Gr9SgFEZS711jraHrFgUGu3Cr7N4ckB09AfQ&oe=6AEB3870"}, {"file_name": "LA Arena Bot Gameplay.png", "id": "645682508495393", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499624837_645682511828726_4246770989748218676_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=62cC9OOlWp8Q7kNvwEYY2F4&_nc_oc=AdpkgQOVEzjx9nnNialefp0Kds3jfXAR2ySfzbPK_DIAXz-Z8Y8twZLyvLq2VZCID1M&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQGuDv5aZ-OHH7jMVxHI1W7xdSyjDRC_dzv4JK0tu09-g&oe=6AEB4145"}, {"file_name": "Tokyo Arena Corkscrew Shot.png", "id": "1881771302676969", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499620519_1881771306010302_4005154004746166368_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=keKxXI-yWfEQ7kNvwGgwy8A&_nc_oc=AdqX6CO7jMy3tYeWQAHEDdAjKAJ86a8NTfZpH7lS6fY3eKRs2u2J5JH1cbhRM1k9Zo8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTmXlDLa_jNJTOcvamtETnkdKYI6rfmbN8EH1ke16y2CA&oe=6AEB3487"}, {"file_name": "Paris Arena \u2013 Eiffel Tower.png", "id": "1032414955718955", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499302735_1032414962385621_2473093901058346991_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ONP5c0kQU1oQ7kNvwE3zoPt&_nc_oc=AdqzlnYtXEeNIpzzYxtoEo1X8Cielv6Cns26HUDBthDtcafgi6MShozJuaiv06QgfoU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR9nXY2qQAGuwDKC4sb1-c2BFvJE9k_EgLWPOlda9l37A&oe=6AEB3E75"}, {"file_name": "Tokyo Arena Goal Celebration.png", "id": "740367268456917", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/507862311_740367271790250_5731865641411867408_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3Xn-BYEWU8MQ7kNvwG1TjQo&_nc_oc=AdphS8ZWwwgnrmTbW_mR1cFpxT9_Y63GW-eAWqM0-xrzerEBi37BuA-1iUTiFt52Ji4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSHVqlOVQKDnTH-mWei-wbBtByr8ZtsUDcw7aRnNx8HUg&oe=6AEB5E65"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440_Disc_PB.png", "id": "627784376999941", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499619090_627784380333274_2126154587082193564_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4IFkZy-K6MkQ7kNvwHbyNQc&_nc_oc=AdqUkUTGIzJGQrrXrySjwws1sNXtafTO1wMbFzw03fL6jbnFY-k3-wj5M1WQB6-pcU0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSt6FWEkhDV3Ff_kUDFJVzx_SNEgz0lqN9DQODKGAHuWA&oe=6AEB6188"}, "display_name": "DISC", "keywords": ["frisbee", "airhockey", "sports", "echo", "sparc"], "long_description": "**3D Air Hockey \u2013 Made for VR!** \n\nWelcome to DISC \u2013 a new sport created by ASICS.  \nStep into the arena with a fast-paced VR sport that tests your reflexes and rewards creativity. \n\n**Play FREE today \u2013 more updates coming soon!**\n{1017907263658795}\n\ud83d\udc7e **Singleplayer Campaign** \u2013 Take on 10 AI bot levels, each with their own playstyle and challenge.\n{1692200288068986}\n\ud83e\udd1d **1v1 Multiplayer** \u2013 Jump into instant matchmaking or host private games with friends.\n{1419364789091316}\n\ud83e\udd4f **Attack With Skill** \u2013 Curve forehands, smash power shots, and unleash corkscrew spins.\n{1175152467694364}\n\ud83d\udee1\ufe0f **Defend Your Goal** \u2013 Block shots like a soccer goalie and sharpen your reflexes every time you play.\n\n\ud83c\udfcb\ufe0f **Fun VR Workout** \u2013 Full-body action that keeps you moving. It\u2019s a fitness experience that doesn\u2019t feel like one.\n\n\ud83d\ude80 **Free to Play, More to Come** \u2013 Cosmetics, leaderboards, and new modes are on the way.\n\n\ud83d\udce3 **Join the Community** \u2013 Connect with players, find matches, and shape the future of DISC: disc.asics.com", "short_description": "3D Air Hockey \u2013 Made for VR!\n\nWelcome to DISC \u2013 a new sport created by ASICS."}]}, "developer_name": null, "developer_privacy_policy_url": "http://disc.asics.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "ASICS Ventures Corporation", "support_website_url": null, "website_url": "https://disc.asics.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "459781504968480"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER"], "id": "24611179708507972"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499301397_1299976474811446_7946021883643230404_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oWM8qFt_w5UQ7kNvwG7PGir&_nc_oc=Adq5hf__PpJCp5VfFwLiF9Ts0Zm7WNHGXi7EkEQQ_QVPBawGfF5pDHUDLLs6-pZxOjA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRSxff3gtjmUOSBCc_b64tYjBifDQ8J1B_-XCwgv8eAxA&oe=6AEB3657"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "DISC", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Sports", "id": "2776542286000603"}, {"topic_name": "Action", "id": "459781504968480"}, {"topic_name": "Arcade", "id": "1592192974313489"}], "release_date": 1750964400, "lastRevision": {"nodes": [{"id": "9796932163692637", "release_type": "SCHEDULE
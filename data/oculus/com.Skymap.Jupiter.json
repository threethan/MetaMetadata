uscdn.com/v/t64.5771-25/499304162_1421947345515402_4406876899546537077_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RsnVG0gaX1cQ7kNvwHC7JR9&_nc_oc=AdqUYLH6aHaJTX1dYNB1EZXRMujMypzRKTN1dSc2jaZs8ML6fzhJNiU1KhhbvR9jYxA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-4giOriUy2lFWeLUW3QaWQhgDApgGEbd-_O11veS1vXw&oe=6A43C9F0"}, {"file_name": "LA Arena Bot Gameplay.png", "id": "645682508495393", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499624837_645682511828726_4246770989748218676_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j1ujNyEvQQYQ7kNvwEkg9C8&_nc_oc=AdqaLnI_3MqSPoum08b0VVrcm5Iku-_Kox0rzha3Rd-fr_WTui--GVqqP7QbaO8qwbk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_JV0xQd4KsTMW5mPr9EML9vgnctMSnRCBtGTNHxwc7Cg&oe=6A43D2C5"}, {"file_name": "Tokyo Arena Corkscrew Shot.png", "id": "1881771302676969", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499620519_1881771306010302_4005154004746166368_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d33a93ZKWc0Q7kNvwEvHS7L&_nc_oc=Adpad2kqfndHnksX3aBNHMjWvy-C1M0FvLhiXdnZI-_NbMt7yAn4eRpjI8Gy7bcTJT4&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_GaUqEXfd9NzKxt2vYXcpljA1ZOooVwKCN8yiB3YpGaw&oe=6A43C607"}, {"file_name": "Paris Arena \u2013 Eiffel Tower.png", "id": "1032414955718955", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499302735_1032414962385621_2473093901058346991_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xkaymK0EhwsQ7kNvwETUIz6&_nc_oc=Adqf6kqDsQt-r04ATDosG9WHLh5UaohX8SGA4ohoyDq4ifuELLYHjiSfrJzaidJB17Y&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-h4eTF1wKg9NpQFOdzMvHe8UBy8T6GKVIVsqtBnjhuig&oe=6A43CFF5"}, {"file_name": "Tokyo Arena Goal Celebration.png", "id": "740367268456917", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/507862311_740367271790250_5731865641411867408_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hN0hTpL-IkYQ7kNvwFMCA7S&_nc_oc=AdrRyjbZQKSoQkc-Yu9s7mUAAjNZg9VehQsJIt3BGixPJgPwGUMEesGhmjBwIub5kg0&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-vLexXsnh-aEvZwjIZ9XVyOkGwbFBejISyod0L1WQ3GA&oe=6A43B7A5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440_Disc_PB.png", "id": "627784376999941", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499619090_627784380333274_2126154587082193564_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tXcgaGVSzIoQ7kNvwHwuneV&_nc_oc=AdoyX1wOF594HXoroA1fKAS_qprN9oe_xQ3BXuUCJi-94ClqPBUQ7ncVyktgup6_-Ug&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af84bqllQ5M67Cre97vl6yAeNocIv93S8y3MtZt1oFmbjA&oe=6A43BAC8"}, "display_name": "DISC", "keywords": ["frisbee", "airhockey", "sports", "echo", "sparc"], "long_description": "**3D Air Hockey \u2013 Made for VR!** \n\nWelcome to DISC \u2013 a new sport created by ASICS.  \nStep into the arena with a fast-paced VR sport that tests your reflexes and rewards creativity. \n\n**Play FREE today \u2013 more updates coming soon!**\n{1017907263658795}\n\ud83d\udc7e **Singleplayer Campaign** \u2013 Take on 10 AI bot levels, each with their own playstyle and challenge.\n{1692200288068986}\n\ud83e\udd1d **1v1 Multiplayer** \u2013 Jump into instant matchmaking or host private games with friends.\n{1419364789091316}\n\ud83e\udd4f **Attack With Skill** \u2013 Curve forehands, smash power shots, and unleash corkscrew spins.\n{1175152467694364}\n\ud83d\udee1\ufe0f **Defend Your Goal** \u2013 Block shots like a soccer goalie and sharpen your reflexes every time you play.\n\n\ud83c\udfcb\ufe0f **Fun VR Workout** \u2013 Full-body action that keeps you moving. It\u2019s a fitness experience that doesn\u2019t feel like one.\n\n\ud83d\ude80 **Free to Play, More to Come** \u2013 Cosmetics, leaderboards, and new modes are on the way.\n\n\ud83d\udce3 **Join the Community** \u2013 Connect with players, find matches, and shape the future of DISC: disc.asics.com", "short_description": "3D Air Hockey \u2013 Made for VR!\n\nWelcome to DISC \u2013 a new sport created by ASICS."}]}, "developer_name": null, "developer_privacy_policy_url": "http://disc.asics.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "ASICS Ventures Corporation", "support_website_url": null, "website_url": "https://disc.asics.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "459781504968480"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER"], "id": "24611179708507972"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499301397_1299976474811446_7946021883643230404_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tZy7AMtZmiUQ7kNvwEjuYAa&_nc_oc=AdpkSgmhhDzeNEUakZJfKJnYWu7oL3MEK0l4UZPyWypJMKDSPvjFLhlp4Hhzt5-b17s&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8Zq-uLNUuRyCdxVmbjt-xG4QbkdIgTLoBSgk_qT-IJkg&oe=6A43C7D7"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "DISC", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Sports", "id": "2776542286000603"}, {"topic_name": "Action", "id": "459781504968480"}, {"topic_name": "Arcade", "id": "1592192974313489"}], "release_date": 1750964400, "lastRevision": {"nodes": [{"id": "9796932163692637", "release_type": "SCHEDULE
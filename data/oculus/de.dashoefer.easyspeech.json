"26805046879116995"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1085418402318091"}]}, "change_log": "- Fixed AI connection getting closed before last audio evaluation was received\n- Fixed wrong notification message when using a different disturber list from what is selected in webspace\n- Fixed custom module time limit getting overwritten\n- Improved module time slider visuals", "created_date": 1773131549, "id": "26027436250211399", "version": "1.6.6.4", "version_code": 1060604, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "5007872822594381", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "26805046879116995"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1085418402318091"}]}, "change_log": "- fixed AI connection getting closed before last audio evaluation was received\n- reduced avatar playback volume to avoid distortion", "created_date": 1772618705, "id": "25968679316087093", "version": "1.6.6.3", "version_code": 1060603, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "5007872822594381", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "26805046879116995"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1085418402318091"}]}, "change_log": "- Fixed back button being stuck in the wall inside office during Easy Answer evaluations\n- Change: Save custom disturber toggle values per user instead of per device", "created_date": 1772529139, "id": "25958345347120490", "version": "1.6.6.2", "version_code": 1060602, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "5007872822594381", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "26805046879116995"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1085418402318091"}]}, "change_log": "New Features\n* Warning message when the selected language does not match the language of the active disturber list\n* Added a skip button during the EasyAnswer introduction and during the waiting time in some EasyPresentation modules\n* Added an exit button to the footer, allowing users to quit the app without using the system dialog (button can be hidden)\nBug Fixes\n* Removed unintended menu appearing after pausing during the EasyAnswer introduction\n* Fixed errors in EasyAnswer evaluation texts\n* Fixed an issue where sessions were not displayed in the session history\n* Fixed an issue where the language selector showed an incorrect language when the system language was not German\nChanges / Improvements\n* EasyAnswer avatar no longer occludes introduction and result texts\n* Added an additional page to session results pointing users to further evaluation details on the website\n* Ensured that all texts and images are updated immediately when changing the current language\n* Updated controller graphics for the help and pause screens", "created_date": 1769602217, "id": "25640523955569299", "version": "1.6.6.0", "version_code": 1060600, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}]}}, "viewer": {"user": null}}}
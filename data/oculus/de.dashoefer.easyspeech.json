uscdn.com/v/t64.5771-25/75251816_690822902181765_711652049598331133_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DfYSw90-ZjoQ7kNvwEZZdrI&_nc_oc=Adqmb_ld1idm6-vzQO8DetMinCeFgpbgWNbXNK0WscItNdumxmTuP65kdoN8UYHkdqA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEmKSjDF-KjgdS6KSgVZ_45-XSJ00uG0Kclya1bFqePrQ&oe=6A787C92"}, {"file_name": "de.dashoefer.easyspeech-20191209-154803.png", "id": "1128409734394900", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/57572936_1128409737728233_8411517148530010494_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6SDLT_8Z368Q7kNvwGkyGOU&_nc_oc=Ado0ooA1jBopPSY0uURgujo9mApGScWIzeMTm4HErfkm-CJ5HzR8xdhMHwmHsNR2gnU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE0P9c8Gag_f_L8Dn5xgg3mHt7Rcvp59_1gu173QfSlpg&oe=6A7874E9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "video_cover.png", "id": "1458934581227631", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75302219_1458934584560964_7551091187130004474_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m1rdmKGw8vwQ7kNvwEIhO2L&_nc_oc=AdpLNUSOcwQL70ABQLvxl4UCXVMP6lMeQ0lLqZiXAM-y4amMOEpQ8cQhE-zFCHPmF9M&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEfvRfohI557q7Y3pL_T84tuJcFPxDwLiCmgEj3z99W4Q&oe=6A788D6C"}, "display_name": "EasySpeech 2", "keywords": [], "long_description": "Our VR App EasySpeech enables people to work and train on their rhetorical, communication, and presentation skills. Based on different didactical modules, people can train step by step their skills. In each module there will be a VR training sessions with different evaluation focus.\nWith EasySpeech nervousness and fear before an important meeting will be the past.\nEasySpeech will help to train in front of a realistical audience.  Before starting each training session, the user has to select a difficulty level that will lead to higher interactions with the audience. \nEach module has different exercises in offline, online and VR format.\nThe EasySpeech App will offer all exercises in VR format in all modules.\nAfter each training session, the user will get an automatic feedback based on Artificial Intelligence. This feedback will include realtime metrics that will help users to work on their skills.", "short_description": "Our VR App EasySpeech enables people to work and train on their rhetorical, communication, and presentation skills. EasySpeech consists of different modules and all of them have VR training sessions with different evaluation focus.\nWith EasySpeech nervousness and fear before an important meeting will be the past.\nEasyspeech will help to train in front of a realistical audience. After each training session, the user will get an automatic feedback based on Artificial Intelligence."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.easy-speech.de/datenschutzhinweise/", "developer_terms_of_service_url": null, "publisher_name": "Verlag Dash\u00f6fer GmbH", "support_website_url": null, "website_url": "https://www.easy-speech.de/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "1043107547362485"}], "external_subscription_type": "REQUIRED", "genres": ["EDUCATIONAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["de"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1201264243920749"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "746712413612178"}]}, "baseline_offer": {"id": "746712413612178"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1687286458, "status": "PUBLISHED",
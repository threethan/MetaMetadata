uscdn.com/v/t64.5771-25/75251816_690822902181765_711652049598331133_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=56XmytjszmgQ7kNvwE8zSMX&_nc_oc=Adrz4j-9GIknRwXB0XMGIPMNAoorvLwU2ibEvZiCm5hryAwbQr2klwsRiRyv5hcDZ9U&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMeZV_Zv4Rdu2qDqjWLJ3NmkgEeVyGSrkwG_c5Ci5TR8g&oe=6ACE6652"}, {"file_name": "de.dashoefer.easyspeech-20191209-154803.png", "id": "1128409734394900", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/57572936_1128409737728233_8411517148530010494_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P9I8sP1jy_QQ7kNvwF2VJiH&_nc_oc=AdpF_57VdqrifntKJjJPxVjrJ9QgADPoYi7VKyd2tMNSyJ63x9XSiMD0HvZsfidG_Fc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPhTU--iEy45zhoUPMFYBpZgpSbsnL5bpP6Xm1rkKPWMw&oe=6ACE5EA9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "video_cover.png", "id": "1458934581227631", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75302219_1458934584560964_7551091187130004474_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H819ffr2_u8Q7kNvwFwxqAV&_nc_oc=AdqQB_ZS1pp7O2HcCGBC4NL11uhQ6jQ-hVs3UYT-El7Oxnjw0pNXh5nxBvqgLOt93g0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOUB7cKQO7hOKY-YgudhbwL-R_d4FARCZVv3Sz1RJ0lcQ&oe=6ACE3EEC"}, "display_name": "EasySpeech 2", "keywords": [], "long_description": "Our VR App EasySpeech enables people to work and train on their rhetorical, communication, and presentation skills. Based on different didactical modules, people can train step by step their skills. In each module there will be a VR training sessions with different evaluation focus.\nWith EasySpeech nervousness and fear before an important meeting will be the past.\nEasySpeech will help to train in front of a realistical audience.  Before starting each training session, the user has to select a difficulty level that will lead to higher interactions with the audience. \nEach module has different exercises in offline, online and VR format.\nThe EasySpeech App will offer all exercises in VR format in all modules.\nAfter each training session, the user will get an automatic feedback based on Artificial Intelligence. This feedback will include realtime metrics that will help users to work on their skills.", "short_description": "Our VR App EasySpeech enables people to work and train on their rhetorical, communication, and presentation skills. EasySpeech consists of different modules and all of them have VR training sessions with different evaluation focus.\nWith EasySpeech nervousness and fear before an important meeting will be the past.\nEasyspeech will help to train in front of a realistical audience. After each training session, the user will get an automatic feedback based on Artificial Intelligence."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.easy-speech.de/datenschutzhinweise/", "developer_terms_of_service_url": null, "publisher_name": "Verlag Dash\u00f6fer GmbH", "support_website_url": null, "website_url": "https://www.easy-speech.de/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "1043107547362485"}], "external_subscription_type": "REQUIRED", "genres": ["EDUCATIONAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["de"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1201264243920749"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "746712413612178"}]}, "baseline_offer": {"id": "746712413612178"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1687286458, "status": "PUBLISHED",
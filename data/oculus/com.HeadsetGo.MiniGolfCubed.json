 putter, put on some checkered trousers and let's go tee off in this arcade-styled mini golf game.\n\nWith multiple unique cubes designed to both assist and block your progress, you are encouraged to take risks and be creative to get to the hole in as few shots as possible. \n\nUsing comfortable physics, retro sound effects and unique putters and golf balls, can you think outside the cube?", "short_description": "An arcade-styled mini-golf game featuring unique, interactive cubes.  Each cube responds to the ball differently, challenging the player to be creative in how they use the cubes to finish the holes."}]}, "developer_name": null, "developer_privacy_policy_url": "https://headsetgo.co.uk/mini-golf%C2%B3-privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Headset Go", "support_website_url": null, "website_url": "https://headsetgo.co.uk/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "459781504968480"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "35338857365712793"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PENDING", "id": "1873413316688300"}, {"status": "PUBLISHED", "id": "1002521582451531"}]}, "baseline_offer": {"id": "1002521582451531"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 0, "status": "PENDING", "id": "1873413316688300"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "Andro
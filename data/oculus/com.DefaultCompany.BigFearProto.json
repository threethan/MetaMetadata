1.oculuscdn.com/v/t64.5771-25/499617729_1279760864126241_9114908967017017922_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_5ViBbh5n1UQ7kNvwFI-khr&_nc_oc=Adq1NNhQWhLKF4Cy2LBwjfMdq2OnICp7DgmC0wxvN7IZGnjWCIszwnA3ad1Ee_efXXQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKke9OLW0zF_tnhXBmkO_0wCUF7rv4ej6D1tZtyXoF7EA&oe=6AB12A1C"}, {"file_name": "fa817338c12e461c805c418904899580.png", "id": "1232902368584725", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499619450_1232902371918058_5102438595451622608_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pRS-EK33MEoQ7kNvwHwQYGY&_nc_oc=AdrgDquXP1YAo1c9gCWN-xIiGjX1icdn3EdwGc5C_XuFdvD542VORV4Es41h1rkghIc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI4fHsXuvkLeG8Boa_1frnAg9t6sBeKE8qL-iS9uZ1PUQ&oe=6AB13F51"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Big Fear", "keywords": [], "long_description": "Step into Big Fear, an immersive VR experience where creativity, fear, and freedom collide. This is more than just a game\u2014it\u2019s a constantly evolving sandbox where you choose how you play, what you create, and how brave you\u2019re willing to be.\n\nExplore a wide variety of gameplay styles all in one place. Test your skills in intense obstacle challenges inspired by \u201cOnly Up\u201d-style progression, where every step forward matters and one mistake can send you falling back down. Or break the rules entirely by entering zero gravity mode, where movement feels completely different and the environment becomes your playground.\n\nFor players who love thrills, Big Fear delivers heart-pounding horror experiences. Run, hide, and survive as terrifying monsters hunt you through dark environments. Each level is designed to keep you on edge, forcing quick thinking and fast reactions if you want to escape. Whether you\u2019re navigating eerie hallways or escaping relentless creatures, the fear feels real in VR.\n\nBut the experience doesn\u2019t stop there\u2014you can also become a content creator inside the game. Build your own worlds, design unique challenges, or create custom horror scenarios for others to play. Share your creations, explore what others have built, and be part of a growing community that keeps the game fresh and unpredictable.\n\nKey Features:\n\nSandbox gameplay with multiple modes and experiences\n\u201cOnly Up\u201d-style climbing and parkour challenges\nZero gravity mode for unique movement and exploration\nInt", "short_description": "Big fear is a sandbox/horror game where u can play onlyup or zero gravity. or play  in a horror mode beating levels"}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1kr6FUK6EGc3kLv-K4cUHnFA_uFFRj_-Fy8BOB64Y_cg/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Big Fear", "support_website_url": null, "website_url": "https://docs.google.com/document/d/1kr6FUK6EGc3kLv-K4cUHnFA_uFFRj_-Fy8BOB64Y_cg/edit?usp=sharing", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "27126345503618365"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499308575_2014341502814177_5626488399186748066_n.png?stp=dst-png_s360x360&_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S3oC-9SQc34Q7kNvwHkrAHu&_nc_oc=Adq9FepLY_bM1mP8NtwJVb7
.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hmEIQ-N7tsoQ7kNvwGViVdx&_nc_oc=AdnRYaiypoUC2gCYKgLG-JKfVZ9X0y8Jqk4GlzM1xh1KUNWH4EJmC7US47g_gLGHhOo&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afy-Hgb4ECTr7P5PdP3jb2e3GU5Qt3nhujmauk0qkDRzfw&oe=69B7EFE4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Immagine di cover del video trailer.png", "id": "1165143165637687", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491830003_1165143168971020_1889847537394257945_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Nxz4NOUJ-f4Q7kNvwH015gG&_nc_oc=AdmEJ5sJ6_vlmnq19DfgnO-Vd9aOJH-XDj8SWiaMGZNoDdFkAA7tKN7-_8jWHhP67aw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfyIdLtxBoTVWkRD-vtgWdgszgtTxD0dF7Q9I-jRezdzEQ&oe=69B7E772"}, "display_name": "Pathway Legend  Keep Alert", "keywords": ["educational", "street", "adventure", "police", "danger"], "long_description": "Pathway Legend is an educational game for kids, where learning the rules of the road becomes an adventure. Between quizzes, dangers and adrenaline, explore the city and test your knowledge of safety and civic behaviour.\n\n", "short_description": "Become a legend of the road!\n\nWith Pathway Legend, every road is an adventure. Choose how you want to get around: on foot, running, by bike, scooter, electric scooter or car, and take on quizzes, challenges and unexpected events as you explore the city.  Test your skills and find out how ready you are to move with agility and intelligence, step by step towards the title of true road champion."}, {"images": {"nodes": [{"file_name": "IconaApp512x512_.png", "id": "2273018243137277", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491823485_2273018246470610_6399629335656198698_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d5fXsWfpjCIQ7kNvwF0VBq4&_nc_oc=Admj0dymO07h6AjohlC05l6cZro7ZkD6X-HAE0bFvBqw3uby_dUHdTEkCSHZnel3xJU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=0
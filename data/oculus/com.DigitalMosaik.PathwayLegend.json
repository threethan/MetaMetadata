scdn.com&_nc_ss=8&oh=00_AfzrTYgVRrMU7HKMb0dFodkiGTS6g7UHZSWtJ6rQbptMAw&oe=69BFD8E4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Immagine di cover del video trailer.png", "id": "1165143165637687", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491830003_1165143168971020_1889847537394257945_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C6bKKwD7ypcQ7kNvwHB23TS&_nc_oc=AdkttfXURUBC8VL5SKTn1RVj3kWp3NoWddtrY8x15xZq41fP_yfe4qtfn8Tg5vVQR84&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_Afx2uQ1VOzfvyA1yOWb_L8yKVbgReQVpwMBaButpDP5gWQ&oe=69BFD072"}, "display_name": "Pathway Legend  Keep Alert", "keywords": ["educational", "street", "adventure", "police", "danger"], "long_description": "Pathway Legend is an educational game for kids, where learning the rules of the road becomes an adventure. Between quizzes, dangers and adrenaline, explore the city and test your knowledge of safety and civic behaviour.\n\n", "short_description": "Become a legend of the road!\n\nWith Pathway Legend, every road is an adventure. Choose how you want to get around: on foot, running, by bike, scooter, electric scooter or car, and take on quizzes, challenges and unexpected events as you explore the city.  Test your skills and find out how ready you are to move with agility and intelligence, step by step towards the title of true road champion."}, {"images": {"nodes": [{"file_name": "IconaApp512x512_.png", "id": "2273018243137277", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491823485_2273018246470610_6399629335656198698_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JeCdMb01Y_YQ7kNvwFQryfH&_nc_oc=Admw6SCIeo7lJIudDb88cLrI1cTiAndrubDb9cKBtaFmETs9ZXC-w-P6WOF6Evo04Vo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_Afx4E3xKfRF3G782LXOvsq-w3HEslSLbzw0zlwKPATaQrg&oe=69BFE19C"}, {"file_name": "hero.png", "id": "1816971675901336", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad3-2.oculus
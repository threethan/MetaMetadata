18_796039869655879_7604261491771420115_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RX95I-wBVtcQ7kNvwHkjFA8&_nc_oc=AdrudW6Whp5Hky5f72QchJqL6g7TIUBYb9_Woi_EdgMjBOo2wxVb53CB0kPAoME2G7k&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_F_zFyZE6BVyUlDGkcrf7M7-YnIL-gwoT4ag3Ec_0kow&oe=6A2ADAA4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Immagine di cover del video trailer.png", "id": "1165143165637687", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491830003_1165143168971020_1889847537394257945_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a7pHjgI_s3QQ7kNvwG7gk7a&_nc_oc=AdpEhokNxVfw1_2rUQb_ZsLuA325U0SVfCSJBOCnmjznxFjVZiNGmGgbRLIoHHHJUqw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9mi-w1jKjbiU2tpmpJ6NKzTn-wHZHY7NUrqMWKj1344w&oe=6A2AD232"}, "display_name": "Pathway Legend  Keep Alert", "keywords": ["educational", "street", "adventure", "police", "danger"], "long_description": "Pathway Legend is an educational game for kids, where learning the rules of the road becomes an adventure. Between quizzes, dangers and adrenaline, explore the city and test your knowledge of safety and civic behaviour.\n\n", "short_description": "Become a legend of the road!\n\nWith Pathway Legend, every road is an adventure. Choose how you want to get around: on foot, running, by bike, scooter, electric scooter or car, and take on quizzes, challenges and unexpected events as you explore the city.  Test your skills and find out how ready you are to move with agility and intelligence, step by step towards the title of true road champion."}, {"images": {"nodes": [{"file_name": "IconaApp512x512_.png", "id": "2273018243137277", "image_type": "APP_IMG_ICON", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491823485_2273018246470610_6399629335656198698_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bYYh7-LgNbAQ7kNvwHxmaR5&_nc_oc=AdrlFKbN3ysLOJx-DW19olLO5cCzKok9rLmRICXEplH7xVcr3EzrC_V45-fzWrF_GlA&_nc_zt=3&_n
18_796039869655879_7604261491771420115_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lIbqlweJX1sQ7kNvwFkYDH_&_nc_oc=AdrpLuNloRM9ttECfp52KWeXxUkr3xiEUJKA0qeAmgMLc8JSwIhPCbGt2IMt0aX08qQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIFDoBV40XjiImFr_K2z1IKfymOYzjnD0IePwlE1UgvTA&oe=6A9C3BA4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Immagine di cover del video trailer.png", "id": "1165143165637687", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491830003_1165143168971020_1889847537394257945_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6n7TFIZHtRIQ7kNvwFEDboC&_nc_oc=AdodZ1mRIK4JXkZAFPCefcjffoCqk-tu1OVYGiG4WfcYm9hNR9Jr0iDA6mYFpDt9N3I&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKjns2PwxYJQKwANLdiAGheEkRkfSxAud-tZCKtTgWaiw&oe=6A9C3332"}, "display_name": "Pathway Legend  Keep Alert", "keywords": ["educational", "street", "adventure", "police", "danger"], "long_description": "Pathway Legend is an educational game for kids, where learning the rules of the road becomes an adventure. Between quizzes, dangers and adrenaline, explore the city and test your knowledge of safety and civic behaviour.\n\n", "short_description": "Become a legend of the road!\n\nWith Pathway Legend, every road is an adventure. Choose how you want to get around: on foot, running, by bike, scooter, electric scooter or car, and take on quizzes, challenges and unexpected events as you explore the city.  Test your skills and find out how ready you are to move with agility and intelligence, step by step towards the title of true road champion."}, {"images": {"nodes": [{"file_name": "IconaApp512x512_.png", "id": "2273018243137277", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491823485_2273018246470610_6399629335656198698_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HecAsHDCFckQ7kNvwElIlN-&_nc_oc=AdoQon--RoHIXWu3Z-YDfTvZ15dihSEprEUcCc22lBWx6hhtIZj7B0ZY_oN2x32qtDQ&_nc_zt=3&_n
.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=be1518x3sCoQ7kNvwEpJVOu&_nc_oc=Adn-bbFh02qGhWEBhDeh2_WOf0NbVnuxPygqR3ZxYnZKZxr3E299UDd14XkiCw_eA9o&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afwbngu8UX3iLB-4NjFl79mlxRP3hg5EmdZKQxaKgM_r6Q&oe=69AD63E4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Immagine di cover del video trailer.png", "id": "1165143165637687", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491830003_1165143168971020_1889847537394257945_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2j1-d7O-Lm0Q7kNvwHEXq61&_nc_oc=AdkIYaYuVHBC5M7e3AiTZS7byujB2Lgb-3qp7rUnBxOThfC8ChTGm21J6dfbd42wB78&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfzcaR3378S1IfA49P2VZxYBfeTCyweZi6mLq1RvR8Ei_w&oe=69AD5B72"}, "display_name": "Pathway Legend  Keep Alert", "keywords": ["educational", "street", "adventure", "police", "danger"], "long_description": "Pathway Legend is an educational game for kids, where learning the rules of the road becomes an adventure. Between quizzes, dangers and adrenaline, explore the city and test your knowledge of safety and civic behaviour.\n\n", "short_description": "Become a legend of the road!\n\nWith Pathway Legend, every road is an adventure. Choose how you want to get around: on foot, running, by bike, scooter, electric scooter or car, and take on quizzes, challenges and unexpected events as you explore the city.  Test your skills and find out how ready you are to move with agility and intelligence, step by step towards the title of true road champion."}, {"images": {"nodes": [{"file_name": "IconaApp512x512_.png", "id": "2273018243137277", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491823485_2273018246470610_6399629335656198698_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EQLh3vgbSj0Q7kNvwGr3DF5&_nc_oc=AdkYn1_V-WMXf2d4TFDqXEh2SCM7U_mz1fOhKbf0eGiY_ELkw1mR3fCJqLR4y-Qzkjk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=0
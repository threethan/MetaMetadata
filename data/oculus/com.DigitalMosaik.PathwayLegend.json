YUSEaQYxYi6U89Do2j3QpeOtOFhPSA8-9xdI&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&oh=00_AftiW0YMCIDw-L1N2b3dSHyzCKzm1rh0HE2rRqRCJ7RbSg&oe=69A18DAB"}, {"file_name": "Immagine del progetto_La soluzione.png", "id": "1481138719978142", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/491830599_1481138723311475_776726453229351775_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Hw8RYVwk3WEQ7kNvwFsGPap&_nc_oc=AdkhJfwzP6dfpqNQB7sEsoW4ahx19UdtM05cLeWRsypDTag9ZazR1IXJVG12nXxZze8&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&oh=00_Afvpe4smGASbrEngNIg2iaSeoBiG4SpWxKH99gaB35CW1g&oe=69A17BDC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Immagine di cover del video trailer.png", "id": "1930429187716702", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/491830027_1930429191050035_9120183789704916007_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qa8wFnBJ6zMQ7kNvwERmARn&_nc_oc=Adn02hmkqZAE02jcPGkRv7-Jq--SWcejTLK8y6_Xhj2nJob9rgNGeF6RRvHTENPa80Q&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&oh=00_AfuItFstX-4zfHCW-bIBEfPEhH7jeyhlN_KU_A4ugad2LA&oe=69A1802C"}, "display_name": "Pathway Legend - Keep Alert", "keywords": ["Avventura", "Sicurezza", "educational", "Strada", "Pericolo"], "long_description": "Con Pathway Legend ogni strada \u00e8 un\u2019avventura. Scegli come muoverti : a piedi, di corsa, in bicicletta, scooter, monopattino elettrico o macchina e affronta quiz, sfide e imprevisti mentre esplori la citt\u00e0.  Metti alla prova le tue abilit\u00e0 e scopri quanto sei pronto a muoverti con agilit\u00e0 e intelligenza, passo dopo passo verso il titolo di vero campione della strada.\n\nPathway Legend \u00e8 un gioco educativo per ragazz\u0259, dove imparare le regole della strada diventa un'avventura. Tra quiz, pericoli e adrenalina, esplora la citt\u00e0 e metti alla prova ci\u00f2 che sai su sicurezza e comportamento civico.\n", "short_description": "Diventa una leggenda della strada!\n\nCon Pathway Legend ogni strada \u00e8 un\u2019avventura. Scegli come muoverti : a piedi, di corsa, in bicicletta, scooter, monopattino elettrico o macchina e affronta quiz, sfide e imprevisti mentre esplori la citt\u00e0.  Metti alla prova le tue abilit\u00e0 e scopri quanto sei pronto a muoverti con agilit\u00e0 e intelligenza, passo dopo passo verso il titolo di vero campione della strada."}]}, "developer_name": null, "developer_privacy_policy_url": "https://lab.digitalmosaik.com/pathway-legend-privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "DigitalMosaik", "support_website_url": null, "website_url": "http://www.digitalmosaik.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1043107547362485"}, {"id": "459781504968480"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["it"], "supported_input_devices": ["GAMEPAD"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24346193038379373"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-hkg1-1.oculuscdn.com/v/t64.5771-25/491827718_1541153840206015_8006106469244368284_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Mi-osBjmX7gQ7kNvwH7GKDb&_nc_oc=AdnQUry8RFcr8RMAurBJDMbU2Dp-WtSqC9UGL8ewp3wTUhKd3-aLh4enCeVukbheWII&_nc_zt=3&_nc_ht=scontent-hkg1-1.oculuscdn.com&oh=00_AfsDGceNgJ9oCZGst0d50y0yJ5Tm6kn-CKy62J17Bpad2A&oe=69A1A1A1"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Pathway Legend  Keep Alert", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "27433260
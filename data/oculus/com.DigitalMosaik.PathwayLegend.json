scdn.com&_nc_ss=8&oh=00_AfxdOVTYTTTxfuyv7Zx1lOPPiUS-eEFO_px-igfdHY7nVg&oe=69BA92E4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Immagine di cover del video trailer.png", "id": "1165143165637687", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/491830003_1165143168971020_1889847537394257945_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0SQMMfqCdlEQ7kNvwGbFnBy&_nc_oc=Adm_1ujzF32Fb6XBE2mn5kSsUSdgroKbegfTu1S9LC-ibBxd5qEnVGuPsUp7wbep2pQ&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=8&oh=00_Afw15hF4LrEVAfyW4Z1P-O0avYhqdR6-M_tmADY0edUMyw&oe=69BA8A72"}, "display_name": "Pathway Legend  Keep Alert", "keywords": ["educational", "street", "adventure", "police", "danger"], "long_description": "Pathway Legend is an educational game for kids, where learning the rules of the road becomes an adventure. Between quizzes, dangers and adrenaline, explore the city and test your knowledge of safety and civic behaviour.\n\n", "short_description": "Become a legend of the road!\n\nWith Pathway Legend, every road is an adventure. Choose how you want to get around: on foot, running, by bike, scooter, electric scooter or car, and take on quizzes, challenges and unexpected events as you explore the city.  Test your skills and find out how ready you are to move with agility and intelligence, step by step towards the title of true road champion."}, {"images": {"nodes": [{"file_name": "IconaApp512x512_.png", "id": "2273018243137277", "image_type": "APP_IMG_ICON", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/491823485_2273018246470610_6399629335656198698_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vMwMWZaEThUQ7kNvwGjU8t3&_nc_oc=Adn7WkJWyb5KF2mMIbgtXvGXToHhjcO2UWI50dXW4t91wdjJGDcx54oBdpWQTeUvtCw&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_Afy6Mk4nQ0svd9ZQfgRtxeESLhY0uKzTgl0DkaD-6DxL4Q&oe=69BA9B9C"}, {"file_name": "hero.png", "id": "1816971675901336", "image_type": "APP_IMG_HERO", "uri": "https://scontent-atl3-1.oculus
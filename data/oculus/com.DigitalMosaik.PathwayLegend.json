18_796039869655879_7604261491771420115_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4GNFW8VFFnMQ7kNvwH6lytM&_nc_oc=Adpt6gTvHCGP-x9aksLoebUErKGD5kwdZzKU1GjXALNqkfq4AIaAmNtnqdKosbXFGfw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-__f2qRX-_IQoHM51sqt_FyI6C2iXdnN55kbhajhG8Lw&oe=6A47DBA4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Immagine di cover del video trailer.png", "id": "1165143165637687", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491830003_1165143168971020_1889847537394257945_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1gK2VdAJqy4Q7kNvwE4Qp-V&_nc_oc=AdoW1n5VxryKIvgR-xgeIctdLaDVIJI6lZLpliSGtzskX2Y06rAJ1vqvgPE0vvSyGDw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8PrKu6hHGkC2GAL6uYrMV6intZtMXtVsvmGJvV-abIKg&oe=6A47D332"}, "display_name": "Pathway Legend  Keep Alert", "keywords": ["educational", "street", "adventure", "police", "danger"], "long_description": "Pathway Legend is an educational game for kids, where learning the rules of the road becomes an adventure. Between quizzes, dangers and adrenaline, explore the city and test your knowledge of safety and civic behaviour.\n\n", "short_description": "Become a legend of the road!\n\nWith Pathway Legend, every road is an adventure. Choose how you want to get around: on foot, running, by bike, scooter, electric scooter or car, and take on quizzes, challenges and unexpected events as you explore the city.  Test your skills and find out how ready you are to move with agility and intelligence, step by step towards the title of true road champion."}, {"images": {"nodes": [{"file_name": "IconaApp512x512_.png", "id": "2273018243137277", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491823485_2273018246470610_6399629335656198698_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7Zn3rhKSb8oQ7kNvwFQx4o9&_nc_oc=Adqq7qErKfB2SzJ-Olx3jIMJHGl-Q3yV7PqMFkgJPWlWD8KUnVth5NBzfkcF4V0nGi0&_nc_zt=3&_n
18_796039869655879_7604261491771420115_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9cVno0ZBQicQ7kNvwHtdAw9&_nc_oc=Adp3BDS7TmisqUgdXIOR6emqyt8opEDxlA0PrhSzRKIzM06IOxUrM782JYF3rFVo46c&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7WV8hD_nm-NGmkIUeTp--TDIH5h-r4bmUyCpEVyYRt6A&oe=6A1EFD24"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Immagine di cover del video trailer.png", "id": "1165143165637687", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491830003_1165143168971020_1889847537394257945_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Q2z8CADrNCoQ7kNvwGaBx_Q&_nc_oc=Ado6qcxTNQjIC0nHPEhzjjq_ej3VL3BJ7OdxTytup0ZoxlK8YwQOilRmShPXKIsU_FA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7MJYStcdzscR-WkrpvgdWA-aThJGhlbL3zQYyT86V03Q&oe=6A1EF4B2"}, "display_name": "Pathway Legend  Keep Alert", "keywords": ["educational", "street", "adventure", "police", "danger"], "long_description": "Pathway Legend is an educational game for kids, where learning the rules of the road becomes an adventure. Between quizzes, dangers and adrenaline, explore the city and test your knowledge of safety and civic behaviour.\n\n", "short_description": "Become a legend of the road!\n\nWith Pathway Legend, every road is an adventure. Choose how you want to get around: on foot, running, by bike, scooter, electric scooter or car, and take on quizzes, challenges and unexpected events as you explore the city.  Test your skills and find out how ready you are to move with agility and intelligence, step by step towards the title of true road champion."}, {"images": {"nodes": [{"file_name": "IconaApp512x512_.png", "id": "2273018243137277", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491823485_2273018246470610_6399629335656198698_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K10bh5nrzJYQ7kNvwGArv0D&_nc_oc=AdoUo_nDCLXhRvwrfdGq3miDnigtjREuSvHmenw91RSBcz-3wlxx-FfQDkcnO6ZgcVw&_nc_zt=3&_n
18_796039869655879_7604261491771420115_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eoYV42o72M4Q7kNvwGnaIs4&_nc_oc=AdqqlodIdYHQrr4QZ6UC56rEkNTzFW5ZPBIlPaOzpHMaJYu4lMxHHIa3B2d5Aagsm_Q&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwVVaTpSkc29o1p-SF3FOJyNvICbVcJYExBtfenpv4jHg&oe=69C91364"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Immagine di cover del video trailer.png", "id": "1165143165637687", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491830003_1165143168971020_1889847537394257945_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iEVGrtRATgkQ7kNvwHonMHn&_nc_oc=AdqjzfhHSBLV7DKt58M9vEe26n7m6PRG4RwCAoljSxZ2kUMr38qUHOVonn6CB6Cdv80&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwK3Wn1x3tPXwnD0ykj5IHiWSScfTcmsRA8mhbcsssxBA&oe=69C90AF2"}, "display_name": "Pathway Legend  Keep Alert", "keywords": ["educational", "street", "adventure", "police", "danger"], "long_description": "Pathway Legend is an educational game for kids, where learning the rules of the road becomes an adventure. Between quizzes, dangers and adrenaline, explore the city and test your knowledge of safety and civic behaviour.\n\n", "short_description": "Become a legend of the road!\n\nWith Pathway Legend, every road is an adventure. Choose how you want to get around: on foot, running, by bike, scooter, electric scooter or car, and take on quizzes, challenges and unexpected events as you explore the city.  Test your skills and find out how ready you are to move with agility and intelligence, step by step towards the title of true road champion."}, {"images": {"nodes": [{"file_name": "IconaApp512x512_.png", "id": "2273018243137277", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491823485_2273018246470610_6399629335656198698_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6IMT8EDZvxgQ7kNvwH3dRm8&_nc_oc=AdpJozPP8jTnCmh4ldFF35-QOmdwBeHjSj9kVtbRV99esJV2W3fykG1P5D0WB65Wyfc&_nc_zt=3&_n
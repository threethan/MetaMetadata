18_796039869655879_7604261491771420115_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C9YGzyXyIycQ7kNvwG82lNg&_nc_oc=AdpjAzK47FmhBOFoerlCrSyJ6YKe1mR1jW2fA7f3MRx5slo93KYid0mxdF7np5DJUYA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSawDRH1iXsTkp6GPFbyQtP1jsvj8DT-EiDiEXejPWJ3g&oe=6AE76124"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Immagine di cover del video trailer.png", "id": "1165143165637687", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491830003_1165143168971020_1889847537394257945_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QSyTvDMeIeUQ7kNvwFIJ7E2&_nc_oc=AdpHUH33WkckglyL4FuE_yAz67U7HDYVSWtXeZ00prUxv7T8yUX2BEtU-mapA1egkck&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQREaxPnUL71iY2TCT1f63Fh4zgxMmvS8RvJqRE5oz_TRA&oe=6AE758B2"}, "display_name": "Pathway Legend  Keep Alert", "keywords": ["educational", "street", "adventure", "police", "danger"], "long_description": "Pathway Legend is an educational game for kids, where learning the rules of the road becomes an adventure. Between quizzes, dangers and adrenaline, explore the city and test your knowledge of safety and civic behaviour.\n\n", "short_description": "Become a legend of the road!\n\nWith Pathway Legend, every road is an adventure. Choose how you want to get around: on foot, running, by bike, scooter, electric scooter or car, and take on quizzes, challenges and unexpected events as you explore the city.  Test your skills and find out how ready you are to move with agility and intelligence, step by step towards the title of true road champion."}, {"images": {"nodes": [{"file_name": "IconaApp512x512_.png", "id": "2273018243137277", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823485_2273018246470610_6399629335656198698_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DVbdixYMLAkQ7kNvwFMXrE3&_nc_oc=AdoMDlACouzj29Izi1U4rmFCONL1_6r64sD96LZG-qzLVN6tGwbdwwnFJf1rp_ON_O8&_nc_zt=3&_n
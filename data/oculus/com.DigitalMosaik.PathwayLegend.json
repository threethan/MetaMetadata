.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=be1518x3sCoQ7kNvwHdrkB8&_nc_oc=AdnoVr0QypUyqXRjBmbNiKJNVIoXE_EYwLENFk1LDRc4Bk6Wsp2OxGDwMyGim5V0FrQ&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfxlzWcVaw-s0M1qu3YtBJdVqF_Em5oX3UgHNPTLhaDhLQ&oe=69AC1264"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Immagine di cover del video trailer.png", "id": "1165143165637687", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491830003_1165143168971020_1889847537394257945_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NcR4GzsUa5EQ7kNvwGHFfZh&_nc_oc=Adln2yPq991-5PlLeKjclRpUZMPN1YqiQrgZ-CNVxxu3ElMGcDyoSe75DwMShqhITRI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfyHWxIEsftuX4krROwv_jMvLshY6TqVRCejcqZqxbJLhg&oe=69AC09F2"}, "display_name": "Pathway Legend  Keep Alert", "keywords": ["educational", "street", "adventure", "police", "danger"], "long_description": "Pathway Legend is an educational game for kids, where learning the rules of the road becomes an adventure. Between quizzes, dangers and adrenaline, explore the city and test your knowledge of safety and civic behaviour.\n\n", "short_description": "Become a legend of the road!\n\nWith Pathway Legend, every road is an adventure. Choose how you want to get around: on foot, running, by bike, scooter, electric scooter or car, and take on quizzes, challenges and unexpected events as you explore the city.  Test your skills and find out how ready you are to move with agility and intelligence, step by step towards the title of true road champion."}, {"images": {"nodes": [{"file_name": "IconaApp512x512_.png", "id": "2273018243137277", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491823485_2273018246470610_6399629335656198698_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i6qFZAuxJ1sQ7kNvwECNoiA&_nc_oc=AdkSN6Xr0mv750EFhpqXXb0smS86DWEZTPix2uSLbUlVRT8qSX-7nZeBR4H_RcMqPhw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=0
18_796039869655879_7604261491771420115_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JZ4bh1XWvN8Q7kNvwESBA3T&_nc_oc=AdoPRwFaHzcbeRreo-olFVnlWht53pMFoAt93kwAwJnDAuD3VrZKgNAIRI_oo8iyuII&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6C9SMHvMGO4zIcZ8r5du1eAyGG9_BuBKk1apGNJjwjJg&oe=6A09E524"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Immagine di cover del video trailer.png", "id": "1165143165637687", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/491830003_1165143168971020_1889847537394257945_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=t7SSp-Q__9UQ7kNvwFYxCX5&_nc_oc=Adqsk0_OXjASOw1l9dakaOrNqIG6NfoCeCTdqdocLJ3IKdVeWo54avXtR6rPhsM4X5c&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af56N8QoBI3UwNC1RTp830TWMfX21PB9ypI-1KoDsLoEPg&oe=6A09DCB2"}, "display_name": "Pathway Legend  Keep Alert", "keywords": ["educational", "street", "adventure", "police", "danger"], "long_description": "Pathway Legend is an educational game for kids, where learning the rules of the road becomes an adventure. Between quizzes, dangers and adrenaline, explore the city and test your knowledge of safety and civic behaviour.\n\n", "short_description": "Become a legend of the road!\n\nWith Pathway Legend, every road is an adventure. Choose how you want to get around: on foot, running, by bike, scooter, electric scooter or car, and take on quizzes, challenges and unexpected events as you explore the city.  Test your skills and find out how ready you are to move with agility and intelligence, step by step towards the title of true road champion."}, {"images": {"nodes": [{"file_name": "IconaApp512x512_.png", "id": "2273018243137277", "image_type": "APP_IMG_ICON", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/491823485_2273018246470610_6399629335656198698_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZIQ1KN_pG94Q7kNvwFzMC5m&_nc_oc=AdqPRNBTLg9RsAl85lxk_v9RP0YAUx4uk5E1pUjf9N5NdCzwQMU5plnkhI3u7DAAahE&_nc_zt=3&_n
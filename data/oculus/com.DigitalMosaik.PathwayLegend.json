18_796039869655879_7604261491771420115_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AaAWAp_SHCgQ7kNvwH6Vtre&_nc_oc=AdrATqbuVHoWc17RE6QHVNPhvxwSXOSLPl4_fJfbMSvdUdadaXVukJSfeoXmaiG7_0E&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGVT1zrtiSXskUuQsx4zW8eAA4900SD7kV7J7TCWR2R8w&oe=6A747664"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Immagine di cover del video trailer.png", "id": "1165143165637687", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491830003_1165143168971020_1889847537394257945_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y-X-_j9GOtQQ7kNvwFpIrEB&_nc_oc=AdqNabSKToMzfmjFqK-wbY1f6vg98MYCjDPP76aKSoQsE0cr96Ov2UmXarpi1LNLY7E&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGVtlgY6WEF81jzCkaZH58G0IH7gB77kc8osmJH5-HmsA&oe=6A74A632"}, "display_name": "Pathway Legend  Keep Alert", "keywords": ["educational", "street", "adventure", "police", "danger"], "long_description": "Pathway Legend is an educational game for kids, where learning the rules of the road becomes an adventure. Between quizzes, dangers and adrenaline, explore the city and test your knowledge of safety and civic behaviour.\n\n", "short_description": "Become a legend of the road!\n\nWith Pathway Legend, every road is an adventure. Choose how you want to get around: on foot, running, by bike, scooter, electric scooter or car, and take on quizzes, challenges and unexpected events as you explore the city.  Test your skills and find out how ready you are to move with agility and intelligence, step by step towards the title of true road champion."}, {"images": {"nodes": [{"file_name": "IconaApp512x512_.png", "id": "2273018243137277", "image_type": "APP_IMG_ICON", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491823485_2273018246470610_6399629335656198698_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BVgGobolqWsQ7kNvwF-Qrh2&_nc_oc=AdrDJuTjVHXdUavOlP0gCNLaR7a3zYJAzvwW-JfV-TCMQPDvjZeLDishZNU93dCq2zA&_nc_zt=3&_n
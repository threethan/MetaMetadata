yQcReQfUzGOjxHZRE3CG7YEiM58a7ngArU_OG09LUVnHjsIwA1NOPRyw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af1l-QKPYaZEB_ujRXhdicHt0BTUCfrDkjgvNO3HTX3Y0Q&oe=69F0A064"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Immagine di cover del video trailer.png", "id": "1165143165637687", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491830003_1165143168971020_1889847537394257945_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m5GDWaDgXEQQ7kNvwGQtslb&_nc_oc=Adq9q34I0Ke7nNJHEVB3-jZB7gQ2dkQbE4cwFlNoTwdNYIFc_lmzc1BezebFaM9CbMU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Af1-5rXTHRQ4GmRg4CIooMtTTmDoqkZ_KB3CbWQedWM-OA&oe=69F0D032"}, "display_name": "Pathway Legend  Keep Alert", "keywords": ["educational", "street", "adventure", "police", "danger"], "long_description": "Pathway Legend is an educational game for kids, where learning the rules of the road becomes an adventure. Between quizzes, dangers and adrenaline, explore the city and test your knowledge of safety and civic behaviour.\n\n", "short_description": "Become a legend of the road!\n\nWith Pathway Legend, every road is an adventure. Choose how you want to get around: on foot, running, by bike, scooter, electric scooter or car, and take on quizzes, challenges and unexpected events as you explore the city.  Test your skills and find out how ready you are to move with agility and intelligence, step by step towards the title of true road champion."}, {"images": {"nodes": [{"file_name": "IconaApp512x512_.png", "id": "2273018243137277", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491823485_2273018246470610_6399629335656198698_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_1wit_55opkQ7kNvwHqp4xN&_nc_oc=AdorMOiybt9_M32L6oKnc4TEu_FPfpUnss4yITMeggaNyzzMtZ783UHuGyZ1ODXgcc4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Af34NCQ0kWPt_wrk_Hl6sF0YayYeo6ouHMdP6ifZP3uJZA&oe=69F0A91C"}, {"file_name": "hero.png", "id": "1816971675901336", "
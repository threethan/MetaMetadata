-25/507828918_796039869655879_7604261491771420115_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XWg_tE62uSYQ7kNvwFsu7zh&_nc_oc=AdomtfNVYnm8cUSSxKp8JIb8GHwPjsWE_6f-ThUSl_wK2h-OS8yT-3B8BJbIgK0u9DU&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFlb60Ro-Tf1pzI5LQ5ZK1Z_aXFkkvD5q71gX7BUaUIvg&oe=6A8599E4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Immagine di cover del video trailer.png", "id": "1165143165637687", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/491830003_1165143168971020_1889847537394257945_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_AgGNDuhRS4Q7kNvwH6rMLE&_nc_oc=Adrn9znR7bWOvmWMDRjlmTvPG_9-7-DxesvqNCwvliPeRiknANMqdU54xm-PKtpGrzM&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEZ4MCtzA2d4kCN-fMlyBWCoWOpXmWYm7nGU9_-OE9PHg&oe=6A859172"}, "display_name": "Pathway Legend  Keep Alert", "keywords": ["educational", "street", "adventure", "police", "danger"], "long_description": "Pathway Legend is an educational game for kids, where learning the rules of the road becomes an adventure. Between quizzes, dangers and adrenaline, explore the city and test your knowledge of safety and civic behaviour.\n\n", "short_description": "Become a legend of the road!\n\nWith Pathway Legend, every road is an adventure. Choose how you want to get around: on foot, running, by bike, scooter, electric scooter or car, and take on quizzes, challenges and unexpected events as you explore the city.  Test your skills and find out how ready you are to move with agility and intelligence, step by step towards the title of true road champion."}, {"images": {"nodes": [{"file_name": "IconaApp512x512_.png", "id": "2273018243137277", "image_type": "APP_IMG_ICON", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/491823485_2273018246470610_6399629335656198698_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q8TC6pPssV8Q7kNvwHt0_UC&_nc_oc=Adqa6ijygmke-O1AI-hNRq80zz73Cmd64NsOl8uQWaurSs0FHVqtICVlY1dqEmdg
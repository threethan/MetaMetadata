45_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EtrdB0Kn0BYQ7kNvwFi1R7G&_nc_oc=Adnr7l01bWvCKJoBRLigNbGS7HjE--BxO0ts9YMEBXSNR9N7lAtXF8UvspccSzxH4OY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AfsaV8lN1pm_TVkymq6Coz3Wc4nbsTUYDtZhxRZCbnzUdg&oe=699EDAF2"}, "display_name": "Pathway Legend  Keep Alert", "keywords": ["educational", "street", "adventure", "police", "danger"], "long_description": "Pathway Legend is an educational game for kids, where learning the rules of the road becomes an adventure. Between quizzes, dangers and adrenaline, explore the city and test your knowledge of safety and civic behaviour.\n\n", "short_description": "Become a legend of the road!\n\nWith Pathway Legend, every road is an adventure. Choose how you want to get around: on foot, running, by bike, scooter, electric scooter or car, and take on quizzes, challenges and unexpected events as you explore the city.  Test your skills and find out how ready you are to move with agility and intelligence, step by step towards the title of true road champion."}, {"images": {"nodes": [{"file_name": "IconaApp512x512_.png", "id": "2273018243137277", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491823485_2273018246470610_6399629335656198698_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wphFR1J9eYYQ7kNvwF7MleE&_nc_oc=AdmCDya3_1JslrVEAP-FWYnxUklrFPWFO0Q_dP9STG3L9zjVMxr0lNjEn2r0p9zVUpo&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_Aft4yVFgva4Aeg1CZ55MiXw6WJlQkKdcga9gsr7sHVDBZQ&oe=699EEC1C"}, {"file_name": "hero.png", "id": "1816971675901336", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491830888_1816971682568002_2899478421051683120_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zN3RIszl8c4Q7kNvwEsTny3&_nc_oc=AdnHRbLgsOUyqESvyXxUjOm68BpuyZTU3ZqcP-qRmbJwqWe4jO9ypLIHQA_KAo0CCAU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AftuAKsGbURfELrD62WIpNSHKWQkMBKrrscOomLUQ_AIhQ&oe=699EE08E"}, {"file_name
18_796039869655879_7604261491771420115_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KCzaebyIgTQQ7kNvwF5dr34&_nc_oc=AdpNKs-pc-tC_iYg5BCmQ1wtZuvrh5Xg02nxTN_nIL4EL1giOz9QZVQOOyjND_3Wzcw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0jxiCH79Z9g90KPJMuSa57y4qB1JONj6_-J8qXvizhSA&oe=69E0CE64"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Immagine di cover del video trailer.png", "id": "1165143165637687", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491830003_1165143168971020_1889847537394257945_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wAJ4lvd0mesQ7kNvwGo3Id7&_nc_oc=AdoGD_oyXqhmga7cTPWGPx2gNR9DpZKeoQp0PgNPQ9lQjzMlPloOPil26v4aZzFGS6c&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3XXKglnKDh6wZFmflKtGRgLcd1h5oyo9ySNqRXHNj4uw&oe=69E0FE32"}, "display_name": "Pathway Legend  Keep Alert", "keywords": ["educational", "street", "adventure", "police", "danger"], "long_description": "Pathway Legend is an educational game for kids, where learning the rules of the road becomes an adventure. Between quizzes, dangers and adrenaline, explore the city and test your knowledge of safety and civic behaviour.\n\n", "short_description": "Become a legend of the road!\n\nWith Pathway Legend, every road is an adventure. Choose how you want to get around: on foot, running, by bike, scooter, electric scooter or car, and take on quizzes, challenges and unexpected events as you explore the city.  Test your skills and find out how ready you are to move with agility and intelligence, step by step towards the title of true road champion."}, {"images": {"nodes": [{"file_name": "IconaApp512x512_.png", "id": "2273018243137277", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491823485_2273018246470610_6399629335656198698_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cC2ue2ryeWMQ7kNvwEl_eJA&_nc_oc=Ado8iDDBmuOlgLOmZF1JKikH4lwQtyB8T2i5LVqXU_P-b8yKTZzYgbm4_jUgH7OzNtc&_nc_zt=3&_n
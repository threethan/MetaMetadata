-1.oculuscdn.com/v/t64.5771-25/491830888_1090398386400299_2490526608471174903_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yhToaD70Np4Q7kNvwGyN57P&_nc_oc=AdrEQisyuCQz2NGB9GUb_u5X5wN6xdqLAhwMR0Yhhp97x69AHUVh9TSIATdY3GkiaAk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIlNUQ9NoyIgSaavhKPdiMl6ROP1vfNMI8wtGOyX_5p0A&oe=6AA5452B"}, {"file_name": "Immagine del progetto_La soluzione.png", "id": "1481138719978142", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491830599_1481138723311475_776726453229351775_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=87gqYQxHQrIQ7kNvwHnhlHD&_nc_oc=AdqE2zw5u4XGTE54FtvTTCsieUQS971i5Yt4YAYUlDaVnFDpz0iIfb_FesrGJAgKVVg&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKgaa0d8pn6RAG-7yTe6N9muLX7u0Fkd7138SXnyDPbmA&oe=6AA56B9C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Immagine di cover del video trailer.png", "id": "1930429187716702", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491830027_1930429191050035_9120183789704916007_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WpCsr3M25CEQ7kNvwE8WPvM&_nc_oc=AdqKEhnVTwaJ1ivClngejTqTNaxGYVNiQbKAeE0gxmv_ZsvZJyG4J0Z4DM9RklU0VAg&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIsJSIv_aWG5ZI3RjF2Z80acVgUy1t5R1FowDhB_afXjg&oe=6AA56FEC"}, "display_name": "Pathway Legend - Keep Alert", "keywords": ["Avventura", "Sicurezza", "educational", "Strada", "Pericolo"], "long_description": "Con Pathway Legend ogni strada \u00e8 un\u2019avventura. Scegli come muoverti : a piedi, di corsa, in bicicletta, scooter, monopattino elettrico o macchina e affronta quiz, sfide e imprevisti mentre esplori la citt\u00e0.  Metti alla prova le tue abilit\u00e0 e scopri quanto sei pronto a muoverti con agilit\u00e0 e intelligenza, passo dopo passo verso il titolo di vero campione della strada.\n\nPathway Legend \u00e8 un gioco educativo per ragazz\u0259, dove imparare le regole della strada diventa un'avventura. Tra quiz, pericoli e adrenalina, esplora la citt\u00e0 e metti alla prova ci\u00f2 che sai su sicurezza e comportamento civico.\n", "short_description": "Diventa una leggenda della strada!\n\nCon Pathway Legend ogni strada \u00e8 un\u2019avventura. Scegli come muoverti : a piedi, di corsa, in bicicletta, scooter, monopattino elettrico o macchina e affronta quiz, sfide e imprevisti mentre esplori la citt\u00e0.  Metti alla prova le tue abilit\u00e0 e scopri quanto sei pronto a muoverti con agilit\u00e0 e intelligenza, passo dopo passo verso il titolo di vero campione della strada."}]}, "developer_name": null, "developer_privacy_policy_url": "https://lab.digitalmosaik.com/pathway-legend-privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "DigitalMosaik", "support_website_url": null, "website_url": "http://www.digitalmosaik.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1043107547362485"}, {"id": "459781504968480"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["it"], "supported_input_devices": ["GAMEPAD"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24346193038379373"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "949432797360251"}]}, "baseline_offer": {"id": "949432797360251"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1756498140, "status": "PUBLISHED", "id": "949432797360251"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "24382678728064137", "v
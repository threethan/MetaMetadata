18_796039869655879_7604261491771420115_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eoYV42o72M4Q7kNvwEfocxY&_nc_oc=Adr6imvpCDABTOzgmhAIVMlDGvhrcSGaAWuUvin_YSsbZ8BmpTZORArl_ocfmrsnugw&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxyqXQhu1GtsyzGWBZA8d_9awTBHipz7Oy9DmfnKeTcDg&oe=69C7C1E4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Immagine di cover del video trailer.png", "id": "1165143165637687", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/491830003_1165143168971020_1889847537394257945_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Qjihw_KJgI8Q7kNvwFeQ8Ua&_nc_oc=AdqAS2Eimq1p852SAgNewyS0dVPHkndeWeqtzr4lkLVcNicZgUz-oz5rwBPuWZFzVAY&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afz9ybQDMp5zj56p-JuVZJ7NQdga2IHQPjWuWAjjoUIn6w&oe=69C7B972"}, "display_name": "Pathway Legend  Keep Alert", "keywords": ["educational", "street", "adventure", "police", "danger"], "long_description": "Pathway Legend is an educational game for kids, where learning the rules of the road becomes an adventure. Between quizzes, dangers and adrenaline, explore the city and test your knowledge of safety and civic behaviour.\n\n", "short_description": "Become a legend of the road!\n\nWith Pathway Legend, every road is an adventure. Choose how you want to get around: on foot, running, by bike, scooter, electric scooter or car, and take on quizzes, challenges and unexpected events as you explore the city.  Test your skills and find out how ready you are to move with agility and intelligence, step by step towards the title of true road champion."}, {"images": {"nodes": [{"file_name": "IconaApp512x512_.png", "id": "2273018243137277", "image_type": "APP_IMG_ICON", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/491823485_2273018246470610_6399629335656198698_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=efv9X1gFGF4Q7kNvwGxBjTT&_nc_oc=AdqexTxThXdM78FCXQIdMscRshFDpPQUXL0Z8QqNxEnvLKaeM7THROaJDdcCDxdtJ9E&_nc_zt=3&_n
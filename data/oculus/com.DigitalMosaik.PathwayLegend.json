scdn.com&_nc_ss=8&oh=00_AfxQDNqA6pTsRVQLDEAYqMDpweVla4wne4E9MxaMjXHzmw&oe=69BE8764"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Immagine di cover del video trailer.png", "id": "1165143165637687", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491830003_1165143168971020_1889847537394257945_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C6bKKwD7ypcQ7kNvwH20kfW&_nc_oc=Adl3R5zF0cu3KcFKk-inCTsRssDmOwTyxqTjgRpQyk5aCeQMlb_O2T4qXm2DaQBKIls&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfwNAImhYEnQUD3UDCmlvCRpMGjqsf3xzpyoZ9_VMdIerQ&oe=69BE7EF2"}, "display_name": "Pathway Legend  Keep Alert", "keywords": ["educational", "street", "adventure", "police", "danger"], "long_description": "Pathway Legend is an educational game for kids, where learning the rules of the road becomes an adventure. Between quizzes, dangers and adrenaline, explore the city and test your knowledge of safety and civic behaviour.\n\n", "short_description": "Become a legend of the road!\n\nWith Pathway Legend, every road is an adventure. Choose how you want to get around: on foot, running, by bike, scooter, electric scooter or car, and take on quizzes, challenges and unexpected events as you explore the city.  Test your skills and find out how ready you are to move with agility and intelligence, step by step towards the title of true road champion."}, {"images": {"nodes": [{"file_name": "IconaApp512x512_.png", "id": "2273018243137277", "image_type": "APP_IMG_ICON", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491823485_2273018246470610_6399629335656198698_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JeCdMb01Y_YQ7kNvwEBiEV0&_nc_oc=AdmUV8X8Zgl95VLr8o2zns_4TYBIQrJ5K5wLytgypv3pTXoNGXyjUv8A2Poxp9bUW9c&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfztRYmNITMHwJK6xeoj0QseLaklN6THKelpRrMANoasJw&oe=69BE901C"}, {"file_name": "hero.png", "id": "1816971675901336", "image_type": "APP_IMG_HERO", "uri": "https://scontent-sjc3-1.oculus
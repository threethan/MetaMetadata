18_796039869655879_7604261491771420115_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=60-NeVbulaMQ7kNvwFjisnV&_nc_oc=AdrtIHqaQvA7CQqNjfKblkKoHgE9OO0iK9RXv5P48zSMcx-isNDS-SZRTQu7EBRNjKM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB97_VdgCZnlV8fVc43HbscbVtgOHTMixd5tsMsharhHw&oe=6A6B3BE4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Immagine di cover del video trailer.png", "id": "1165143165637687", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491830003_1165143168971020_1889847537394257945_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oICzrSfRYAIQ7kNvwGvrSQV&_nc_oc=AdpQybVbWXIewbH5ycsxz56762yCLKsKKXywhvlYhOYDfK3WYsrSQIFrwyhl5_w3Whk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDiGINd1Zs4J_M9bTYH3xnIaToGCqptUh301b-X-SLYLw&oe=6A6B6BB2"}, "display_name": "Pathway Legend  Keep Alert", "keywords": ["educational", "street", "adventure", "police", "danger"], "long_description": "Pathway Legend is an educational game for kids, where learning the rules of the road becomes an adventure. Between quizzes, dangers and adrenaline, explore the city and test your knowledge of safety and civic behaviour.\n\n", "short_description": "Become a legend of the road!\n\nWith Pathway Legend, every road is an adventure. Choose how you want to get around: on foot, running, by bike, scooter, electric scooter or car, and take on quizzes, challenges and unexpected events as you explore the city.  Test your skills and find out how ready you are to move with agility and intelligence, step by step towards the title of true road champion."}, {"images": {"nodes": [{"file_name": "IconaApp512x512_.png", "id": "2273018243137277", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491823485_2273018246470610_6399629335656198698_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=70v3KKYfqpwQ7kNvwH94ttt&_nc_oc=Ado3wpqcwEPeHY46dYG7x3_K61yGDj14-WbP_y6-mZLxHcFo-CLVM2Nc8v2k-vSf6Hs&_nc_zt=3&_n
.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Gt9Qp9CuZjUQ7kNvwHhqByd&_nc_oc=AdnmYflj24Bv0vQCVBk_uLu10_QtNeXg1-kh1aX151Iw0cNUfFz2FmNojBz4RGj3mMs&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfwPsTqXsLRreAmh5kMLpeO0nn6Csu9sRaKLAHSA_Ns34w&oe=69AEB564"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Immagine di cover del video trailer.png", "id": "1165143165637687", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491830003_1165143168971020_1889847537394257945_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2j1-d7O-Lm0Q7kNvwFbckyP&_nc_oc=Admd8WjoSwsNTqaoGPh7txRD3pum4VFu85jJfhYNm9W0USWSA4DcsEE4pAo8j4f_Rmw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfyLBHiu53fQSlU2Pkn9w3qF4FVA5tjWXbKluInO78yrhQ&oe=69AEACF2"}, "display_name": "Pathway Legend  Keep Alert", "keywords": ["educational", "street", "adventure", "police", "danger"], "long_description": "Pathway Legend is an educational game for kids, where learning the rules of the road becomes an adventure. Between quizzes, dangers and adrenaline, explore the city and test your knowledge of safety and civic behaviour.\n\n", "short_description": "Become a legend of the road!\n\nWith Pathway Legend, every road is an adventure. Choose how you want to get around: on foot, running, by bike, scooter, electric scooter or car, and take on quizzes, challenges and unexpected events as you explore the city.  Test your skills and find out how ready you are to move with agility and intelligence, step by step towards the title of true road champion."}, {"images": {"nodes": [{"file_name": "IconaApp512x512_.png", "id": "2273018243137277", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491823485_2273018246470610_6399629335656198698_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EQLh3vgbSj0Q7kNvwFwbW3Q&_nc_oc=AdnaRE6hPY6Fzmj6Wit9SOHyRMPRuYuM6Jk77ab3BDy-pcT-RwwgWq664ZJJBow4VcQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=0
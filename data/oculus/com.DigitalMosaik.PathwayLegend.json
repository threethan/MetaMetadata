18_796039869655879_7604261491771420115_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aDGFzlkA5CAQ7kNvwGWNJCp&_nc_oc=AdqJeVFdYvAOaJu8vmEDECchDd8iMGvufoy5WgGttCYcTstovw5YZIP4yNWYXnaJIEQ&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af191UEMOMCaroEHxrZS3iAfovCujWeHDSMOWHR8BA7hVA&oe=69F34364"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Immagine di cover del video trailer.png", "id": "1165143165637687", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/491830003_1165143168971020_1889847537394257945_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m5GDWaDgXEQQ7kNvwEHjjRx&_nc_oc=AdoNbbSWF4hCW39NRA-4ACrNDMHAo7hByQFCwd23eyor2l7EIQcJD6D9K_tuwz8modw&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1IxmuSAHKYd5PZVXWcsfyve2UfmSmYcptRB4R1Gbh2rw&oe=69F37332"}, "display_name": "Pathway Legend  Keep Alert", "keywords": ["educational", "street", "adventure", "police", "danger"], "long_description": "Pathway Legend is an educational game for kids, where learning the rules of the road becomes an adventure. Between quizzes, dangers and adrenaline, explore the city and test your knowledge of safety and civic behaviour.\n\n", "short_description": "Become a legend of the road!\n\nWith Pathway Legend, every road is an adventure. Choose how you want to get around: on foot, running, by bike, scooter, electric scooter or car, and take on quizzes, challenges and unexpected events as you explore the city.  Test your skills and find out how ready you are to move with agility and intelligence, step by step towards the title of true road champion."}, {"images": {"nodes": [{"file_name": "IconaApp512x512_.png", "id": "2273018243137277", "image_type": "APP_IMG_ICON", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/491823485_2273018246470610_6399629335656198698_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_1wit_55opkQ7kNvwENtZH5&_nc_oc=AdrcdkOsjmxCN--UJ7es8dCfJzRZVcQa1I47ZtcAzldsqan2EjmXK70TV2STmqrtS5s&_nc_zt=3&_n
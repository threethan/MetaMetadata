-25/507828918_796039869655879_7604261491771420115_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CgGKMQIOYHwQ7kNvwGeynQe&_nc_oc=Adqb_HKZMCXSN1J7QmRTPggji1KCLOvw7ZV82QidgGhRW08yte9kPJ65FQHiA8gNX68&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGPd3moAXZsXk7HQDrD6GEtt5S7_fTdy1aH6T9VYxo66g&oe=6A8D82E4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Immagine di cover del video trailer.png", "id": "1165143165637687", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/491830003_1165143168971020_1889847537394257945_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q5cFglxpfuQQ7kNvwEUwnOs&_nc_oc=Adqopxn5RPvBUmXFZJvA-jw7LfZ-g50t2LTJBSuwEKbSyKHme6hggy01SD2aV3V_JUE&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE5ldYRh0gfcFeRKxT0QwDXtzEOprJl3fMJLqWmx7Uv9Q&oe=6A8D7A72"}, "display_name": "Pathway Legend  Keep Alert", "keywords": ["educational", "street", "adventure", "police", "danger"], "long_description": "Pathway Legend is an educational game for kids, where learning the rules of the road becomes an adventure. Between quizzes, dangers and adrenaline, explore the city and test your knowledge of safety and civic behaviour.\n\n", "short_description": "Become a legend of the road!\n\nWith Pathway Legend, every road is an adventure. Choose how you want to get around: on foot, running, by bike, scooter, electric scooter or car, and take on quizzes, challenges and unexpected events as you explore the city.  Test your skills and find out how ready you are to move with agility and intelligence, step by step towards the title of true road champion."}, {"images": {"nodes": [{"file_name": "IconaApp512x512_.png", "id": "2273018243137277", "image_type": "APP_IMG_ICON", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/491823485_2273018246470610_6399629335656198698_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aMq8HVmPQ6cQ7kNvwHZQLbF&_nc_oc=AdqkD4A3Yoddi9VOmRBnI_vm9mr3tghbSTETW3CNOAbjgOQYFwmehyUbG_A0nOO4
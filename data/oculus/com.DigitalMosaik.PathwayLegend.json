scdn.com&_nc_ss=8&oh=00_AfyjDfcuGLRDNWbwXb_dUkend2XL8qXPhCWzM6MEUeImTw&oe=69B3FB64"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Immagine di cover del video trailer.png", "id": "1165143165637687", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491830003_1165143168971020_1889847537394257945_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kQLjoJPacrkQ7kNvwHZm6on&_nc_oc=AdmfwotiZwBa5_mXRo0zdfwMn4dHxsVAfcyl812Q-OniJ-42NTGc0hcYRxedZz6OWrk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfxEUqeuG6zT4H_bPXsIz1nqYGm3DznQG7axMUHmymdDDA&oe=69B3F2F2"}, "display_name": "Pathway Legend  Keep Alert", "keywords": ["educational", "street", "adventure", "police", "danger"], "long_description": "Pathway Legend is an educational game for kids, where learning the rules of the road becomes an adventure. Between quizzes, dangers and adrenaline, explore the city and test your knowledge of safety and civic behaviour.\n\n", "short_description": "Become a legend of the road!\n\nWith Pathway Legend, every road is an adventure. Choose how you want to get around: on foot, running, by bike, scooter, electric scooter or car, and take on quizzes, challenges and unexpected events as you explore the city.  Test your skills and find out how ready you are to move with agility and intelligence, step by step towards the title of true road champion."}, {"images": {"nodes": [{"file_name": "IconaApp512x512_.png", "id": "2273018243137277", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491823485_2273018246470610_6399629335656198698_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J9xe5xj-2FEQ7kNvwFK_AC9&_nc_oc=AdlzFDCkHnOpcIFXMX18S_Xq39GNN35oA6_ot1eDNfZwZLGjwHUiVN-vOFfVZquJm2k&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfwWlbO8CTwnk3EQ79giRk_PUAxL7AIk6tieKFafTh4NSA&oe=69B4041C"}, {"file_name": "hero.png", "id": "1816971675901336", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ord5-2.oculus
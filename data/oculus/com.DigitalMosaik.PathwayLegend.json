45_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IMZoSBIN_xkQ7kNvwE9ldTl&_nc_oc=AdmIQMRMmImMIGcNXfhdEzGhqgOx4TijvVWHMcob4BDtZDVB-kO0u0G72duxEyC8gxo&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_AftEQpn4FrXgh6dDom_hgb7xCP5cfYVu-puogCyB5UPp2w&oe=69A57272"}, "display_name": "Pathway Legend  Keep Alert", "keywords": ["educational", "street", "adventure", "police", "danger"], "long_description": "Pathway Legend is an educational game for kids, where learning the rules of the road becomes an adventure. Between quizzes, dangers and adrenaline, explore the city and test your knowledge of safety and civic behaviour.\n\n", "short_description": "Become a legend of the road!\n\nWith Pathway Legend, every road is an adventure. Choose how you want to get around: on foot, running, by bike, scooter, electric scooter or car, and take on quizzes, challenges and unexpected events as you explore the city.  Test your skills and find out how ready you are to move with agility and intelligence, step by step towards the title of true road champion."}, {"images": {"nodes": [{"file_name": "IconaApp512x512_.png", "id": "2273018243137277", "image_type": "APP_IMG_ICON", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/491823485_2273018246470610_6399629335656198698_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fd7we-Yb-GgQ7kNvwFrOekX&_nc_oc=AdmkRui-kj2wvPXTqn34N7QQYrN30QIFCiRXAqLOKj1_OvIUWqVbl8HWYPMYUMaJMJI&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_Aftg-57jBEYvImLnyXrWbiFRKB3M3HHcDIgLObPdUZgtBw&oe=69A5839C"}, {"file_name": "hero.png", "id": "1816971675901336", "image_type": "APP_IMG_HERO", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/491830888_1816971682568002_2899478421051683120_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Redaw-8isfIQ7kNvwHVdkhP&_nc_oc=AdmjP-JgTcxuXCKKsOu0EIem381zpDbc4iRb585QybWXbnNpAi298NIp7MsXhHGWg8o&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&oh=00_Afs5R7SYR7ZQpvo0KP8usrgmJpHhciTf1JLiWqGipP6d8A&oe=69A5780E"}, {"file_name
.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LmoUO6rzT88Q7kNvwEFRoDM&_nc_oc=AdnszG0cV4wkbIFMEbXt_Czu_3epA4ysuHI5TOULow3uagOhdYh7S3QfryYkU8MbVYk&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfxP-5w_Kr7oqj4dv7dotzieQNjdflGWuPfk61gcvu6ScA&oe=69B2A9E4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Immagine di cover del video trailer.png", "id": "1165143165637687", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491830003_1165143168971020_1889847537394257945_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kQLjoJPacrkQ7kNvwGfcZ_L&_nc_oc=AdmCNh_04muiXxiGEpWxLsDx8wbL8-zRoX3ugl-UDoS-q_v1ADLnOjFvGtGC_PYPX2A&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfznB7xvGXmDPjGohlo3RFqOoGf2ru4F-QBGnXEUmy3eOQ&oe=69B2A172"}, "display_name": "Pathway Legend  Keep Alert", "keywords": ["educational", "street", "adventure", "police", "danger"], "long_description": "Pathway Legend is an educational game for kids, where learning the rules of the road becomes an adventure. Between quizzes, dangers and adrenaline, explore the city and test your knowledge of safety and civic behaviour.\n\n", "short_description": "Become a legend of the road!\n\nWith Pathway Legend, every road is an adventure. Choose how you want to get around: on foot, running, by bike, scooter, electric scooter or car, and take on quizzes, challenges and unexpected events as you explore the city.  Test your skills and find out how ready you are to move with agility and intelligence, step by step towards the title of true road champion."}, {"images": {"nodes": [{"file_name": "IconaApp512x512_.png", "id": "2273018243137277", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491823485_2273018246470610_6399629335656198698_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J9xe5xj-2FEQ7kNvwGv_6Ki&_nc_oc=Adl8YwX7rq2o3pLZS9SCP9LdxRqsmRIppX02WDt8g7b_Mz2r8RI0YdGJY35-mvS14M0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=0
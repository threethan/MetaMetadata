mbQN7dcjIdM9ruvUgEb0Au8qn8KH89JqhnXYTCKhtn0R22TzM0C3OVfM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AftO7pjfvdpGbXFDQhr2wrPgDB33vAN8WPOQRZhuOIy7uQ&oe=699D91E4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Immagine di cover del video trailer.png", "id": "1165143165637687", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491830003_1165143168971020_1889847537394257945_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EtrdB0Kn0BYQ7kNvwEHJE3b&_nc_oc=AdmvDB1zPkfbLsTwLPjzaQdAuGsxMPn2ZGXZLSZI41nKPmlY1Ue_3CU-gokFe5Khwos&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfvYsF7ZDkqcHi1v4BRAYVMw8Uhg6DkN34P2cWrneN3utA&oe=699D8972"}, "display_name": "Pathway Legend  Keep Alert", "keywords": ["educational", "street", "adventure", "police", "danger"], "long_description": "Pathway Legend is an educational game for kids, where learning the rules of the road becomes an adventure. Between quizzes, dangers and adrenaline, explore the city and test your knowledge of safety and civic behaviour.\n\n", "short_description": "Become a legend of the road!\n\nWith Pathway Legend, every road is an adventure. Choose how you want to get around: on foot, running, by bike, scooter, electric scooter or car, and take on quizzes, challenges and unexpected events as you explore the city.  Test your skills and find out how ready you are to move with agility and intelligence, step by step towards the title of true road champion."}, {"images": {"nodes": [{"file_name": "IconaApp512x512_.png", "id": "2273018243137277", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491823485_2273018246470610_6399629335656198698_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wphFR1J9eYYQ7kNvwEkOJm6&_nc_oc=AdnU7aab6ZwA8x2tQG-H807y05WGREEuzrUh92Yfkkma5Rf9SpN1-DO_r_ypul16k8Y&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Afv8dd0q65Bo8p7nmM3miWyH4qay8zH72mIqWjww9ssXYQ&oe=699D9A9C"}, {"file_name": "hero.png", "id": "1816971675901336", "
45_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pmDPi2fw5DMQ7kNvwEY0wzX&_nc_oc=AdnP5i-l9ihAfBQ8-Gbmc4WrpH_NRt07VpY1M0XusgYHvCpfk8FLXEldgcLk04rlV5M&_nc_zt=3&_nc_ht=scontent-hkg1-1.oculuscdn.com&oh=00_Aftkg-6UYs-BvF7gEXVPpOPGhTBMykgZN9pYh-rJ9vG6uw&oe=69A17DF2"}, "display_name": "Pathway Legend  Keep Alert", "keywords": ["educational", "street", "adventure", "police", "danger"], "long_description": "Pathway Legend is an educational game for kids, where learning the rules of the road becomes an adventure. Between quizzes, dangers and adrenaline, explore the city and test your knowledge of safety and civic behaviour.\n\n", "short_description": "Become a legend of the road!\n\nWith Pathway Legend, every road is an adventure. Choose how you want to get around: on foot, running, by bike, scooter, electric scooter or car, and take on quizzes, challenges and unexpected events as you explore the city.  Test your skills and find out how ready you are to move with agility and intelligence, step by step towards the title of true road champion."}, {"images": {"nodes": [{"file_name": "IconaApp512x512_.png", "id": "2273018243137277", "image_type": "APP_IMG_ICON", "uri": "https://scontent-hkg4-2.oculuscdn.com/v/t64.5771-25/491823485_2273018246470610_6399629335656198698_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=svMw84W2LdkQ7kNvwHWM29O&_nc_oc=Adn-NM4DAScF63FWS0n6bHbUIwvqX3oC43v7boNaeDs0H908ipYeoT-MVZDFRXPnQl8&_nc_zt=3&_nc_ht=scontent-hkg4-2.oculuscdn.com&oh=00_AfsVzRpyeq44eEDaOTtCcHOTOFWAMU6y-11rp-pnEDhzmg&oe=69A18F1C"}, {"file_name": "hero.png", "id": "1816971675901336", "image_type": "APP_IMG_HERO", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/491830888_1816971682568002_2899478421051683120_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R5mBthq4XSwQ7kNvwEtka2a&_nc_oc=AdkVnAjaeaJdQgKP4Pj6UUtIXTK__DkPW-5-1vXRrsyEYysgde9SASR3MPRkwAgC_qQ&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&oh=00_AfsduGSlMquV77dC2cichIteD5UAOZfAhigSdWRXW--PyQ&oe=69A1838E"}, {"file_name
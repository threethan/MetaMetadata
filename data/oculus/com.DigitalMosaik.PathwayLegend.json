.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YeO65sDDVT4Q7kNvwF8TYx6&_nc_oc=Adkax4E0LOLKM6BYYD9jHDSdi4G_Vn3asPekjuO5S_7zpGieb2gkBei0g4oWDI34xFk&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfwXVHB0mfvisMuW6-T78HErnNZJbWhHZD9fmDTW_R5rzw&oe=69BBE464"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Immagine di cover del video trailer.png", "id": "1165143165637687", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491830003_1165143168971020_1889847537394257945_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0SQMMfqCdlEQ7kNvwEqmefJ&_nc_oc=AdlwYVKW7zeeLQSxgNww6Ybjd1aLZY9d3DmMmIlE22qXmZ9XqnxcyAaDm4qDQK80P_U&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfymGf6nPi2U8FEsNR04OJeklDnyuEDOmsjSTOexlXkaKw&oe=69BBDBF2"}, "display_name": "Pathway Legend  Keep Alert", "keywords": ["educational", "street", "adventure", "police", "danger"], "long_description": "Pathway Legend is an educational game for kids, where learning the rules of the road becomes an adventure. Between quizzes, dangers and adrenaline, explore the city and test your knowledge of safety and civic behaviour.\n\n", "short_description": "Become a legend of the road!\n\nWith Pathway Legend, every road is an adventure. Choose how you want to get around: on foot, running, by bike, scooter, electric scooter or car, and take on quizzes, challenges and unexpected events as you explore the city.  Test your skills and find out how ready you are to move with agility and intelligence, step by step towards the title of true road champion."}, {"images": {"nodes": [{"file_name": "IconaApp512x512_.png", "id": "2273018243137277", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491823485_2273018246470610_6399629335656198698_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vMwMWZaEThUQ7kNvwH5yzcw&_nc_oc=AdnqguS8LyCXRxCCblhwiDuMm1JfRunPkIW4MxPg7747h2XmjAcxVZvlmDEImzIll8c&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=0
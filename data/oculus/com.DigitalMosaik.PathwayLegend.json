scdn.com&_nc_ss=8&oh=00_Afw79VPTsPLGLHfGjBe_j7_54ZOwbE_tbMjcMIuq0slcbg&oe=69B54CE4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Immagine di cover del video trailer.png", "id": "1165143165637687", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491830003_1165143168971020_1889847537394257945_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Nxz4NOUJ-f4Q7kNvwHexTdn&_nc_oc=AdkHdLqhqPvqsIcyojSOtQFCGsxkE4tx1ixSvMU9zwu2VH4yTn0pU0o-roAh2cw3VI0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_Afz5RrMM_mqd6cQVLfzkx9_HiMX8YU62nF9p77uaiJIFNQ&oe=69B54472"}, "display_name": "Pathway Legend  Keep Alert", "keywords": ["educational", "street", "adventure", "police", "danger"], "long_description": "Pathway Legend is an educational game for kids, where learning the rules of the road becomes an adventure. Between quizzes, dangers and adrenaline, explore the city and test your knowledge of safety and civic behaviour.\n\n", "short_description": "Become a legend of the road!\n\nWith Pathway Legend, every road is an adventure. Choose how you want to get around: on foot, running, by bike, scooter, electric scooter or car, and take on quizzes, challenges and unexpected events as you explore the city.  Test your skills and find out how ready you are to move with agility and intelligence, step by step towards the title of true road champion."}, {"images": {"nodes": [{"file_name": "IconaApp512x512_.png", "id": "2273018243137277", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491823485_2273018246470610_6399629335656198698_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d5fXsWfpjCIQ7kNvwE58NEe&_nc_oc=AdlCnEHI38IckhC8TnFIpHdxl8yh-yUUGqNY4Noy4nohaw2mR7a223HIjq9y2lPSM8M&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfxGOVIUrInMYlUPbggDJpTofs0zYBUoa_LkdPGMSGVCMA&oe=69B5559C"}, {"file_name": "hero.png", "id": "1816971675901336", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad3-2.oculus
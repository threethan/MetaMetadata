.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Gt9Qp9CuZjUQ7kNvwEyduyY&_nc_oc=AdmWgk85FH5_QMaOzV4yHtO0AWCpHVpZyPKnXUSYdcu2ZAF_SdKDLwFGe5jAJQ25GVQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfyqaTHUjBBzqFkApNSWXvzJcTxlTfbSiIAP-Ogp2gXSGQ&oe=69B006E4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Immagine di cover del video trailer.png", "id": "1165143165637687", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491830003_1165143168971020_1889847537394257945_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2j1-d7O-Lm0Q7kNvwHFpx3Q&_nc_oc=Adnx2Irz9oLsJIDkL358TLQif8bNoNZ5JkIY69gtUea07SMkYRBnUfl6uuNBUNtXBZ8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfwOSQp0ou5gZNfj04r2L_9MGnUM9gTSi3yhvuaQsPDr1w&oe=69AFFE72"}, "display_name": "Pathway Legend  Keep Alert", "keywords": ["educational", "street", "adventure", "police", "danger"], "long_description": "Pathway Legend is an educational game for kids, where learning the rules of the road becomes an adventure. Between quizzes, dangers and adrenaline, explore the city and test your knowledge of safety and civic behaviour.\n\n", "short_description": "Become a legend of the road!\n\nWith Pathway Legend, every road is an adventure. Choose how you want to get around: on foot, running, by bike, scooter, electric scooter or car, and take on quizzes, challenges and unexpected events as you explore the city.  Test your skills and find out how ready you are to move with agility and intelligence, step by step towards the title of true road champion."}, {"images": {"nodes": [{"file_name": "IconaApp512x512_.png", "id": "2273018243137277", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491823485_2273018246470610_6399629335656198698_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EQLh3vgbSj0Q7kNvwHUjQcQ&_nc_oc=Adnpwdxx0q6PBBNMF87y3Rc0Z6Zl_4NJQaeV1ztdHfhJz9BMRDhkTLW4L7nz6eR-kRM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=0
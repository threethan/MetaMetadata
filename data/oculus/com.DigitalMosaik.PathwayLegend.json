18_796039869655879_7604261491771420115_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=77cEfNpu8nMQ7kNvwHN0QBP&_nc_oc=AdqCxsLcufcdgEF8OPntlTOgXQdecdLIX8YpFaOc6LUhtmyoy57GRvzKboJD9ql9VWQ&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0wevUau4DC4j3BQILFx1RG1WbvByQ_YqjiGfbjPjpFwQ&oe=69D8E564"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Immagine di cover del video trailer.png", "id": "1165143165637687", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491830003_1165143168971020_1889847537394257945_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DFY5maEOqXMQ7kNvwHaC1Lg&_nc_oc=Adqg6niYHgpUEg239-JrY3_WhAVJHAk9nXN3TR3A6djMzipSpX-dOg1PGvKQpKpzd8w&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af00wU2ozIxajN3YlA-Zsfi4Wrdk3lMSBcYWXHMfveoIfg&oe=69D8DCF2"}, "display_name": "Pathway Legend  Keep Alert", "keywords": ["educational", "street", "adventure", "police", "danger"], "long_description": "Pathway Legend is an educational game for kids, where learning the rules of the road becomes an adventure. Between quizzes, dangers and adrenaline, explore the city and test your knowledge of safety and civic behaviour.\n\n", "short_description": "Become a legend of the road!\n\nWith Pathway Legend, every road is an adventure. Choose how you want to get around: on foot, running, by bike, scooter, electric scooter or car, and take on quizzes, challenges and unexpected events as you explore the city.  Test your skills and find out how ready you are to move with agility and intelligence, step by step towards the title of true road champion."}, {"images": {"nodes": [{"file_name": "IconaApp512x512_.png", "id": "2273018243137277", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491823485_2273018246470610_6399629335656198698_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6v1GHq9o5XgQ7kNvwHx5ozr&_nc_oc=AdpB80Rs2DyARS9auis3ovsklMvqCfj0lRP4xZxcRFAfvkXjL7wMr6ObkwKE7Ipc1ZE&_nc_zt=3&_n
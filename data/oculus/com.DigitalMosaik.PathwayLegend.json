18_796039869655879_7604261491771420115_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rhRLUOZ9KScQ7kNvwFGDEfW&_nc_oc=AdqDigUMFtPU8R_h5igUp-mz7EYrKZQkWZOyvrB2R81i3-VwzVivjRNXmHj0MquqxE8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6mD5hnUiTmVE_552GnKv1gJ4Z16ldn_uchuYfLHMrIVw&oe=6A147124"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Immagine di cover del video trailer.png", "id": "1165143165637687", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491830003_1165143168971020_1889847537394257945_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YX8eW0rt6PEQ7kNvwHgUa79&_nc_oc=AdptnLbLBS19hDIWDkd8hcDqKLebDe91aBXhfUVv3a86MQONlx2bRsM9fGmgAIPue0o&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7aZMvEJZRTGeDeVdgDMVPQHghTLO_TtkkkqnP9YLyywA&oe=6A1468B2"}, "display_name": "Pathway Legend  Keep Alert", "keywords": ["educational", "street", "adventure", "police", "danger"], "long_description": "Pathway Legend is an educational game for kids, where learning the rules of the road becomes an adventure. Between quizzes, dangers and adrenaline, explore the city and test your knowledge of safety and civic behaviour.\n\n", "short_description": "Become a legend of the road!\n\nWith Pathway Legend, every road is an adventure. Choose how you want to get around: on foot, running, by bike, scooter, electric scooter or car, and take on quizzes, challenges and unexpected events as you explore the city.  Test your skills and find out how ready you are to move with agility and intelligence, step by step towards the title of true road champion."}, {"images": {"nodes": [{"file_name": "IconaApp512x512_.png", "id": "2273018243137277", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491823485_2273018246470610_6399629335656198698_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SgvNp-Y9LKMQ7kNvwFdU6-f&_nc_oc=Adqu7rJs9OHr9KSVmsQC8KZPOJ3vtK0xIm2U-kc-1I2d0db8t2GK6y9fZCUY1JOqG-o&_nc_zt=3&_n
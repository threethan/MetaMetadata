18_796039869655879_7604261491771420115_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Udx-khuJ-fgQ7kNvwHbVj-u&_nc_oc=AdrxyTqru9V-fWUN83rpciutQcHANa_BUM5it4O5seMJigsYE6_qBKz__1leUIQlp8s&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7kGvQPnZ7I0Gz1VLmnFcA_hf1Rn8zOavXsT1jD6QUbvw&oe=69FA1324"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Immagine di cover del video trailer.png", "id": "1165143165637687", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491830003_1165143168971020_1889847537394257945_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=62MghCcOPeQQ7kNvwF7Ja57&_nc_oc=Adr19ekBr1jAuOOcj3Yv5iAPy0zSMFwYeZXCbWwg0xXBl3LpMD2cVYVeD1xkbFIRslM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6pcYhtQy9d4Efxx_qZtvExvweqOkKUDZ1rcoBS1YfkLg&oe=69FA0AB2"}, "display_name": "Pathway Legend  Keep Alert", "keywords": ["educational", "street", "adventure", "police", "danger"], "long_description": "Pathway Legend is an educational game for kids, where learning the rules of the road becomes an adventure. Between quizzes, dangers and adrenaline, explore the city and test your knowledge of safety and civic behaviour.\n\n", "short_description": "Become a legend of the road!\n\nWith Pathway Legend, every road is an adventure. Choose how you want to get around: on foot, running, by bike, scooter, electric scooter or car, and take on quizzes, challenges and unexpected events as you explore the city.  Test your skills and find out how ready you are to move with agility and intelligence, step by step towards the title of true road champion."}, {"images": {"nodes": [{"file_name": "IconaApp512x512_.png", "id": "2273018243137277", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491823485_2273018246470610_6399629335656198698_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6T9XPoyWWH8Q7kNvwF7oUwk&_nc_oc=Adq9-HV3LbXpXi1aZ0kylJUe8IhCYR2zxMMJaOeySkjOWTRiSKK5P9jfhPKR9LQSiKQ&_nc_zt=3&_n
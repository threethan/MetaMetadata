-2.oculuscdn.com/v/t64.5771-25/491830888_1090398386400299_2490526608471174903_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZRGIt1uDlkYQ7kNvwHo3ZRo&_nc_oc=Adr0KCpMXuex3vCMGkbfA8v9Pl0dQwXnAzVqJtoqt_4yLpYaRNdnOyxww5-ozyHyPIA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6vcID7KTLBCbpd5xMSNPi4V6tBre-JNs5lsXuiKG4_ZA&oe=69F9E22B"}, {"file_name": "Immagine del progetto_La soluzione.png", "id": "1481138719978142", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491830599_1481138723311475_776726453229351775_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RtNQ1DZbcjcQ7kNvwHEilio&_nc_oc=AdrI_EQUQNRvBpIWq3ls_OxZ143wcRFdMa2njW44oXleLHdqfkXxVoVj2J2bbrEL9dY&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7NWIdN2WKz7CoatkulpDzNexMJK0QxaCDW59RZ_bx4mw&oe=69FA089C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Immagine di cover del video trailer.png", "id": "1930429187716702", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491830027_1930429191050035_9120183789704916007_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Bh4i8Q99wwQQ7kNvwFc0V4N&_nc_oc=AdpFqZ8qGa2Gnvgeq03vmjRdEM6rLRRuR1-OdZtOR-rpaaw6FxwgpBqD4ZvjwB64bMU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7WdOoU-9Jz4OjYjMUh5u2hAks8YVTDkVcQqJIeWMbdMA&oe=69FA0CEC"}, "display_name": "Pathway Legend - Keep Alert", "keywords": ["Avventura", "Sicurezza", "educational", "Strada", "Pericolo"], "long_description": "Con Pathway Legend ogni strada \u00e8 un\u2019avventura. Scegli come muoverti : a piedi, di corsa, in bicicletta, scooter, monopattino elettrico o macchina e affronta quiz, sfide e imprevisti mentre esplori la citt\u00e0.  Metti alla prova le tue abilit\u00e0 e scopri quanto sei pronto a muoverti con agilit\u00e0 e intelligenza, passo dopo passo verso il titolo di vero campione della strada.\n\nPathway Legend \u00e8 un gioco educativo per ragazz\u0259, dove imparare le regole della strada diventa un'avventura. Tra quiz, pericoli e adrenalina, esplora la citt\u00e0 e metti alla prova ci\u00f2 che sai su sicurezza e comportamento civico.\n", "short_description": "Diventa una leggenda della strada!\n\nCon Pathway Legend ogni strada \u00e8 un\u2019avventura. Scegli come muoverti : a piedi, di corsa, in bicicletta, scooter, monopattino elettrico o macchina e affronta quiz, sfide e imprevisti mentre esplori la citt\u00e0.  Metti alla prova le tue abilit\u00e0 e scopri quanto sei pronto a muoverti con agilit\u00e0 e intelligenza, passo dopo passo verso il titolo di vero campione della strada."}]}, "developer_name": null, "developer_privacy_policy_url": "https://lab.digitalmosaik.com/pathway-legend-privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "DigitalMosaik", "support_website_url": null, "website_url": "http://www.digitalmosaik.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1043107547362485"}, {"id": "459781504968480"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["it"], "supported_input_devices": ["GAMEPAD"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24346193038379373"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "949432797360251"}]}, "baseline_offer": {"id": "949432797360251"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1756498140, "status": "PUBLISHED", "id": "949432797360251"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "24382678728064137", "v
.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hmEIQ-N7tsoQ7kNvwHCC6L6&_nc_oc=AdnYstqU7C01PfDU5ftkIkPppJxZP_-b7O2P8qXT0U_Un4u66BRKiMcqjeSYwAl5OOo&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afx6QRtsHp3FbMMLo4-okNLfvpybaYAb_s8n-al5YDAqdg&oe=69B94164"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Immagine di cover del video trailer.png", "id": "1165143165637687", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491830003_1165143168971020_1889847537394257945_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0SQMMfqCdlEQ7kNvwGAlX94&_nc_oc=Adkmo6brXG17qZRAOoCJByjviNiAOi0MPtiLTievmoaxVyZ7btRN4lzg4Fu5EJaVWYo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfztZdxL-vAqEQoWw6-gU4p7wcy8dNUrn_uaE5wjke9GSQ&oe=69B938F2"}, "display_name": "Pathway Legend  Keep Alert", "keywords": ["educational", "street", "adventure", "police", "danger"], "long_description": "Pathway Legend is an educational game for kids, where learning the rules of the road becomes an adventure. Between quizzes, dangers and adrenaline, explore the city and test your knowledge of safety and civic behaviour.\n\n", "short_description": "Become a legend of the road!\n\nWith Pathway Legend, every road is an adventure. Choose how you want to get around: on foot, running, by bike, scooter, electric scooter or car, and take on quizzes, challenges and unexpected events as you explore the city.  Test your skills and find out how ready you are to move with agility and intelligence, step by step towards the title of true road champion."}, {"images": {"nodes": [{"file_name": "IconaApp512x512_.png", "id": "2273018243137277", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491823485_2273018246470610_6399629335656198698_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vMwMWZaEThUQ7kNvwGdIL2q&_nc_oc=Adlq5V7qes_yiZ4A7KyIGz_ruNJYLsgIO8MKbSQkJgyfkMttHvhfzcCYzf4ZM49-NSQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=0
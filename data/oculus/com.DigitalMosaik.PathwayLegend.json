C1UmMfL7o8ddplhqm4PsdDv6d1QAK7dPczCo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af3a7dA2Z48wZf9KyXmYi2mXf-PxwYocWb4taHkUq0LcKA&oe=69F0A7AB"}, {"file_name": "Immagine del progetto_La soluzione.png", "id": "1481138719978142", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491830599_1481138723311475_776726453229351775_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M5Mi0vxxilAQ7kNvwG7oDNf&_nc_oc=AdoYM46OJT5OLfOzta64InHryvEOXFYyX5oMcQzy4zBAC-aCYWPO62oCjtTxorgITbQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af1NJrB4IlDUJG_WgN0daYDexvlotfoESG-GtUKuafVVCQ&oe=69F0CE1C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Immagine di cover del video trailer.png", "id": "1930429187716702", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491830027_1930429191050035_9120183789704916007_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ICH5TJ0lIXgQ7kNvwFEUjhy&_nc_oc=Adp2pNJlhcHj2leXRHPkc07IQSkXWs6H8xh5c8_m--YsEIT9jghvuSEUBaaEAWE2hJE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Af0n9Egiy68OiQCZ1DVr4YBmSXbx-WbDG2drWFJJZtepbA&oe=69F0D26C"}, "display_name": "Pathway Legend - Keep Alert", "keywords": ["Avventura", "Sicurezza", "educational", "Strada", "Pericolo"], "long_description": "Con Pathway Legend ogni strada \u00e8 un\u2019avventura. Scegli come muoverti : a piedi, di corsa, in bicicletta, scooter, monopattino elettrico o macchina e affronta quiz, sfide e imprevisti mentre esplori la citt\u00e0.  Metti alla prova le tue abilit\u00e0 e scopri quanto sei pronto a muoverti con agilit\u00e0 e intelligenza, passo dopo passo verso il titolo di vero campione della strada.\n\nPathway Legend \u00e8 un gioco educativo per ragazz\u0259, dove imparare le regole della strada diventa un'avventura. Tra quiz, pericoli e adrenalina, esplora la citt\u00e0 e metti alla prova ci\u00f2 che sai su sicurezza e comportamento civico.\n", "short_description": "Diventa una leggenda della strada!\n\nCon Pathway Legend ogni strada \u00e8 un\u2019avventura. Scegli come muoverti : a piedi, di corsa, in bicicletta, scooter, monopattino elettrico o macchina e affronta quiz, sfide e imprevisti mentre esplori la citt\u00e0.  Metti alla prova le tue abilit\u00e0 e scopri quanto sei pronto a muoverti con agilit\u00e0 e intelligenza, passo dopo passo verso il titolo di vero campione della strada."}]}, "developer_name": null, "developer_privacy_policy_url": "https://lab.digitalmosaik.com/pathway-legend-privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "DigitalMosaik", "support_website_url": null, "website_url": "http://www.digitalmosaik.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1043107547362485"}, {"id": "459781504968480"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["it"], "supported_input_devices": ["GAMEPAD"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24346193038379373"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491827718_1541153840206015_8006106469244368284_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dOsZZiMnuHEQ7kNvwGoGHpK&_nc_oc=AdpEbvEDKOD2swYUNzC1tt8LWqO6JxNsfRCQPWT7k_5mN18Vrm9pvoUYJ2dKBj4OTig&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af2veOiu4QEHSszKn1THhkP3WcorEZub49ZYbTjISbYXXw&oe=69F0BBA1"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Pathway Legend  Keep Alert", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "27433260
jYArfDHb929tz_iStLLmxj2BjpQMc-gDCB6vT5MI2HsNzOWv30_SprKA&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_Afvu8ilah9sIEmBmVLfYmyBXSVxskS4LOR6W3dCVtyZQ6w&oe=699C4064"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Immagine di cover del video trailer.png", "id": "1165143165637687", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491830003_1165143168971020_1889847537394257945_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o1WLLP8PyYUQ7kNvwEv-hdb&_nc_oc=AdnA8h35LGqabidD4UXfwKsKNZyVvMkqhiyn8EqUL0ZRJwOlhH5kqAzXQUREwGiD5p8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_AfvbZdrpsp2jv8n_7FevyiQZk1m2_VFbHLLeQN3pAH1kCg&oe=699C37F2"}, "display_name": "Pathway Legend  Keep Alert", "keywords": ["educational", "street", "adventure", "police", "danger"], "long_description": "Pathway Legend is an educational game for kids, where learning the rules of the road becomes an adventure. Between quizzes, dangers and adrenaline, explore the city and test your knowledge of safety and civic behaviour.\n\n", "short_description": "Become a legend of the road!\n\nWith Pathway Legend, every road is an adventure. Choose how you want to get around: on foot, running, by bike, scooter, electric scooter or car, and take on quizzes, challenges and unexpected events as you explore the city.  Test your skills and find out how ready you are to move with agility and intelligence, step by step towards the title of true road champion."}, {"images": {"nodes": [{"file_name": "IconaApp512x512_.png", "id": "2273018243137277", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491823485_2273018246470610_6399629335656198698_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nIhOTzmIVSUQ7kNvwEmqLfc&_nc_oc=AdnOW6WLp_WndBLY8O8Yl6B7n05CXYsT9wHS-AA5sgIUMRfL4eBczNI0KUwK1cQIKwk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_AfufynnRhSjsdVfKRms0zgxJ34TUpC432uKoWPirc-e6Qg&oe=699C491C"}, {"file_name": "hero.png", "id": "1816971675901336", "
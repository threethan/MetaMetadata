=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQTiGBw9yVpEKtcclzGQ2jSzkYG74U17pTieNzcmOMYZA&oe=6AFDB76F"}, {"file_name": "Zombieland_Bowling_Realm_Quest_2.png", "id": "252534296669179", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982617_252534300002512_88477822051553422_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KEmGJhTARXkQ7kNvwF-PBep&_nc_oc=AdoXfamL7Go19jjf_PHCH9HjNCa2rbGgIv7x276tt77iQ-VKCuDDREmTJDd3p4CI92U&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQTRL89epXOPxJEvfCWwLHG0wOTLAeqk7fdTj5dRq4vgQ&oe=6AFDD7BD"}, {"file_name": "Zombieland_Office_Quest_2.png", "id": "637533130512612", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982535_637533133845945_4913826446620039560_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aBPGBKGqaPYQ7kNvwH7KNFb&_nc_oc=AdqwO-gdgamwSv6x3gJ-G8Kq5yBbhV1Drp-v1Z-vJcQDCocMJJJqFsqPH10ZmOQoT8g&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR0aruNp6w7oEMD5MAisR07MbpOGtHpBIWrEt1CUS_ZYQ&oe=6AFDCCA2"}, {"file_name": "Zombieland_Family_Home_Quest_2.png", "id": "2864214510561781", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39001725_2864214513895114_2819262369100977508_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r5KaQ3VZCc0Q7kNvwFR66AU&_nc_oc=Ado-n1Ce_VF_BY858olLU4VMMHpLewVBhkGaLZVU6xQAwNO8EcZa0QWnS2nJLd3cxXQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS414EOlAkkCMX1B1P0Ugx2PAG0VNhmhPCykwKlCUHYfA&oe=6AFDE018"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ZL_HSF_Meta_Landscape_2560x1440.png", "id": "1141846950667714", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473393523_1141846954001047_2789278163877689417_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AaYRiMvLapUQ7kNvwFqx8AX&_nc_oc=Adp05Pr8BUcT46BlCMLonaK-CObgKA1GKz6teZAVWJE-8OB2NIn18ekJ_HyxlgzLQJU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRIMlGHpf-y5jgN2khewrdoJY3fvsGQwlIrZ6mcYy7U7g&oe=6AFDB214"}, "display_name": "Zombieland: Headshot Fever", "keywords": ["Shooter", "FPS", "zombies", "Zombieland", "Arcade"], "long_description": "** VR Game of the Year finalist at TIGA Awards **\n** VR Game of the Year finalist at VR Awards **\n** Winner of 'Best Small Studio' at the TIGA Awards **\n\nThe award-winning Zombieland: Headshot Fever is an arcade light-gun game built for VR.\n\nThis zombie-killing race sport brings light-gun games into the 21st century! Headshot combos slow the clock, meaning the most precise shooter is the fastest - challenge the leaderboards with skill, speed, and accuracy.\n\nFEATURES:\n{958104066384162}\nBullet Time - Two headshots turn the world slow!\n{1132267338685310}\nLeaderboards - Challenge the world!\n{1038303291795263}\nWeapons - Unlock and upgrade a range of weapons!\n{609884205110187}\nThe Zombieland Invitational - The zombie-killing race course of your nightmares!\n{1794959568031203}\nArcade Mode - a new roguelite experience!\n\nAccolades:\n- \"Insanely addictive\" - VRFocus\n- \u201cThe gameplay is incredibly fun and really addictive\u201d - BMF VR\n- \"Arcade head blasting fun\" - Beardo Benjo\n- \u201cThe headshot slowmo is seriously addictive\u201d - Cerberusarms\n- \"A joy to play\u201d - Platinum Award, Thumb Culture", "short_description": "** VR Game of the Year finalist - VR Awards **\n** VR Game of the Year finalist - TIGA Awards **\n\n\"Insanely addictive\" - VRFocus\n\u201cThe gameplay is incredibly fun and really addictive\u201d - BMF VR\n\"Arcade head blasting fun\" - Beardo Benjo\n\nThe award-winning Zombieland: Headshot Fever is an arcade light gun game built for VR.\n\nHeadshot combos slow the clock, meaning the most precise shooter is the fastest - challenge the leaderboards with skill, speed, and accuracy."}]}, "developer_name": "XR Games", "developer_privacy_policy_url": "https://www.xrgames.io/privacy-policy", "develop
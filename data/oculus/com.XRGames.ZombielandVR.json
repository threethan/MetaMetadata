=scontent-dfw5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRCeAIH2x-7m6A4Fmszrq5B8Dnv_Ix8pyjo2ymR1xaV_A&oe=6B08436F"}, {"file_name": "Zombieland_Bowling_Realm_Quest_2.png", "id": "252534296669179", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38982617_252534300002512_88477822051553422_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3eH5_oSDfpcQ7kNvwHTqCeK&_nc_oc=Adr4jxw_efCYfc25DtKj5eW32qOkNN530My3sAvV4mgBfIcAoGcor7yzGysY5HM-TuY&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQtvn7tbQJ3xT6uREM9vBy5mghq0IuMkk2bneP9h4jFGg&oe=6B0863BD"}, {"file_name": "Zombieland_Office_Quest_2.png", "id": "637533130512612", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38982535_637533133845945_4913826446620039560_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RhbngSO8GoUQ7kNvwF8jqh3&_nc_oc=AdoMV-LN68mxP68Lr80fU9AM2X-M5EWVSL10jAMQFtoHBHJCQaWN9ZX24nWodcxI4rw&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSWXXgCdEEpi91kWGO-bW17RoOZgVDW0-_R90MmCejt7g&oe=6B0858A2"}, {"file_name": "Zombieland_Family_Home_Quest_2.png", "id": "2864214510561781", "uri": "https://scontent-dfw5-3.oculuscdn.com/v/t64.5771-25/39001725_2864214513895114_2819262369100977508_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SJEMoeetaUsQ7kNvwFIoXi-&_nc_oc=AdqaU89pXIuxGdXrzfEvGK1BECh-xsZbic5w-BhGFgGNtdqgfbH7MrB3eCWqhVQ2-Rs&_nc_zt=3&_nc_ht=scontent-dfw5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRIhAAuPT10cQhjTFoaMeW1Fz3NcihhPJvVP6-OAMTTLg&oe=6B086C18"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ZL_HSF_Meta_Landscape_2560x1440.png", "id": "1141846950667714", "uri": "https://scontent-dfw5-3.oculuscdn.com/v/t64.5771-25/473393523_1141846954001047_2789278163877689417_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m1pB98Ham4wQ7kNvwHIG9ot&_nc_oc=AdoqTAJV7PIJ7Xo2SwhXBGSwluBVr9mcn2EAtdOK9Xq8Ao7vZuv2-qK4nS0UQShE-Gg&_nc_zt=3&_nc_ht=scontent-dfw5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRfhqIYcYhjBwiafyo6jSjpFgUGFwTZbSfT0s53Xg5t4Q&oe=6B083E14"}, "display_name": "Zombieland: Headshot Fever", "keywords": ["Shooter", "FPS", "zombies", "Zombieland", "Arcade"], "long_description": "** VR Game of the Year finalist at TIGA Awards **\n** VR Game of the Year finalist at VR Awards **\n** Winner of 'Best Small Studio' at the TIGA Awards **\n\nThe award-winning Zombieland: Headshot Fever is an arcade light-gun game built for VR.\n\nThis zombie-killing race sport brings light-gun games into the 21st century! Headshot combos slow the clock, meaning the most precise shooter is the fastest - challenge the leaderboards with skill, speed, and accuracy.\n\nFEATURES:\n{958104066384162}\nBullet Time - Two headshots turn the world slow!\n{1132267338685310}\nLeaderboards - Challenge the world!\n{1038303291795263}\nWeapons - Unlock and upgrade a range of weapons!\n{609884205110187}\nThe Zombieland Invitational - The zombie-killing race course of your nightmares!\n{1794959568031203}\nArcade Mode - a new roguelite experience!\n\nAccolades:\n- \"Insanely addictive\" - VRFocus\n- \u201cThe gameplay is incredibly fun and really addictive\u201d - BMF VR\n- \"Arcade head blasting fun\" - Beardo Benjo\n- \u201cThe headshot slowmo is seriously addictive\u201d - Cerberusarms\n- \"A joy to play\u201d - Platinum Award, Thumb Culture", "short_description": "** VR Game of the Year finalist - VR Awards **\n** VR Game of the Year finalist - TIGA Awards **\n\n\"Insanely addictive\" - VRFocus\n\u201cThe gameplay is incredibly fun and really addictive\u201d - BMF VR\n\"Arcade head blasting fun\" - Beardo Benjo\n\nThe award-winning Zombieland: Headshot Fever is an arcade light gun game built for VR.\n\nHeadshot combos slow the clock, meaning the most precise shooter is the fastest - challenge the leaderboards with skill, speed, and accuracy."}]}, "developer_name": "XR Games", "developer_privacy_policy_url": "https://www.xrgames.io/privacy-policy", "develop
=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTfqNRDGDePAIyVDlJX0d2OgYWcvIn9gtLhugnJWdLMcg&oe=6B04872F"}, {"file_name": "Zombieland_Bowling_Realm_Quest_2.png", "id": "252534296669179", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982617_252534300002512_88477822051553422_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IobB0AhHDBQQ7kNvwFYGE-r&_nc_oc=Ado0b59gZvBJeQdVzYoY2he0swib07jKaP7qbot6L3DanErMopw03_7rIv_RfJgZDl4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTrKikhY_fAnzITvUJh-JEtiHlT7i6OjVfrnesWUsLvmA&oe=6B046F3D"}, {"file_name": "Zombieland_Office_Quest_2.png", "id": "637533130512612", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982535_637533133845945_4913826446620039560_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c_c-uz_fpsYQ7kNvwHWkZF1&_nc_oc=AdoCEIRGMKCoeuMcfn0FMqzZqB5c86IhhNWhpS_3gRY9Ubx1bSS5UJFKUmp_Eq1hH7Y&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR4PjCJFqGgjcvlk1xAs-iPUdPD-I6s34XzWRgMRg-rbg&oe=6B046422"}, {"file_name": "Zombieland_Family_Home_Quest_2.png", "id": "2864214510561781", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39001725_2864214513895114_2819262369100977508_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W1MXspg4RCYQ7kNvwGlUMTF&_nc_oc=AdpQQXQQCYJCrVMFvzeMn7Wg3V4Inn_RGvbj8Ob6GZ594y717Ca6YejLEMQJ7x9mrRY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQStSGg9wnIHj2PaHPx8iriFlLyxGcddhSjIaGftilx4iA&oe=6B047798"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ZL_HSF_Meta_Landscape_2560x1440.png", "id": "1141846950667714", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473393523_1141846954001047_2789278163877689417_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KLpItjNlF8sQ7kNvwGEwaod&_nc_oc=AdrFhK_w0wpnlyDyJQqNhSgzYeWwJykIOAbOjG0vQZwIDF4WPrC12xUTpfeNNq1vMiE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSbOS7ciGVsR68JYPV0lcfDmoWDFDHmm-zNaxdKbtmXEw&oe=6B0481D4"}, "display_name": "Zombieland: Headshot Fever", "keywords": ["Shooter", "FPS", "zombies", "Zombieland", "Arcade"], "long_description": "** VR Game of the Year finalist at TIGA Awards **\n** VR Game of the Year finalist at VR Awards **\n** Winner of 'Best Small Studio' at the TIGA Awards **\n\nThe award-winning Zombieland: Headshot Fever is an arcade light-gun game built for VR.\n\nThis zombie-killing race sport brings light-gun games into the 21st century! Headshot combos slow the clock, meaning the most precise shooter is the fastest - challenge the leaderboards with skill, speed, and accuracy.\n\nFEATURES:\n{958104066384162}\nBullet Time - Two headshots turn the world slow!\n{1132267338685310}\nLeaderboards - Challenge the world!\n{1038303291795263}\nWeapons - Unlock and upgrade a range of weapons!\n{609884205110187}\nThe Zombieland Invitational - The zombie-killing race course of your nightmares!\n{1794959568031203}\nArcade Mode - a new roguelite experience!\n\nAccolades:\n- \"Insanely addictive\" - VRFocus\n- \u201cThe gameplay is incredibly fun and really addictive\u201d - BMF VR\n- \"Arcade head blasting fun\" - Beardo Benjo\n- \u201cThe headshot slowmo is seriously addictive\u201d - Cerberusarms\n- \"A joy to play\u201d - Platinum Award, Thumb Culture", "short_description": "** VR Game of the Year finalist - VR Awards **\n** VR Game of the Year finalist - TIGA Awards **\n\n\"Insanely addictive\" - VRFocus\n\u201cThe gameplay is incredibly fun and really addictive\u201d - BMF VR\n\"Arcade head blasting fun\" - Beardo Benjo\n\nThe award-winning Zombieland: Headshot Fever is an arcade light gun game built for VR.\n\nHeadshot combos slow the clock, meaning the most precise shooter is the fastest - challenge the leaderboards with skill, speed, and accuracy."}]}, "developer_name": "XR Games", "developer_privacy_policy_url": "https://www.xrgames.io/privacy-policy", "develop
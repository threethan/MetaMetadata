=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQT-809R4O5XpAyXFLLZcXB_IQxbVbqmkYRiitDrrglRTA&oe=6B0DC1AF"}, {"file_name": "Zombieland_Bowling_Realm_Quest_2.png", "id": "252534296669179", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982617_252534300002512_88477822051553422_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Q0JTyioblRMQ7kNvwGDDEXp&_nc_oc=Adry6fXl2UB-re3ALssoLLMeZ2OPw1hVME74fNaJZWdFcEuDSQZWExdllmL7AZ53_wU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSfdrHCPb-uezHVigMN5q12t1kK2YG7s3zVg4H1Hdxf-g&oe=6B0DA9BD"}, {"file_name": "Zombieland_Office_Quest_2.png", "id": "637533130512612", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982535_637533133845945_4913826446620039560_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wsDtQ4KCSTAQ7kNvwG8qcC0&_nc_oc=AdrZvOVMVcq__dzt_AIzCT7dQKBiVffq3ftZxo1qbqzIpQpRbQIgSBWhnO6oErBrfnM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQR_Tf8HkWiHrWsFzdlMF_EWZD8BeBAlQAj5r5towm5zVQ&oe=6B0D9EA2"}, {"file_name": "Zombieland_Family_Home_Quest_2.png", "id": "2864214510561781", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39001725_2864214513895114_2819262369100977508_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hhGgf0RVp08Q7kNvwHE5YEg&_nc_oc=Adrqn6t6Uxh08iuaBs_1wHWDOOlPmfg9FaP64LUKlbmkQi_YjTsYAqBXbVny2ThZdeo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQsfe4nw79Zgb5_K153n8Tm-UnL6THCIrIfMElvwe_lsg&oe=6B0DB218"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ZL_HSF_Meta_Landscape_2560x1440.png", "id": "1141846950667714", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473393523_1141846954001047_2789278163877689417_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ltL75oydDo4Q7kNvwE8E06n&_nc_oc=AdrpBlf6Wn62pTis68o6E2_hgp8a87F2jSaaOaCONU5Ji87aIcX0ErnRcAa3gJqosBo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTxmlcgI_rIgu3pdEub1-oB2JtRFclwXrYK3VT2L-wPDA&oe=6B0DBC54"}, "display_name": "Zombieland: Headshot Fever", "keywords": ["Shooter", "FPS", "zombies", "Zombieland", "Arcade"], "long_description": "** VR Game of the Year finalist at TIGA Awards **\n** VR Game of the Year finalist at VR Awards **\n** Winner of 'Best Small Studio' at the TIGA Awards **\n\nThe award-winning Zombieland: Headshot Fever is an arcade light-gun game built for VR.\n\nThis zombie-killing race sport brings light-gun games into the 21st century! Headshot combos slow the clock, meaning the most precise shooter is the fastest - challenge the leaderboards with skill, speed, and accuracy.\n\nFEATURES:\n{958104066384162}\nBullet Time - Two headshots turn the world slow!\n{1132267338685310}\nLeaderboards - Challenge the world!\n{1038303291795263}\nWeapons - Unlock and upgrade a range of weapons!\n{609884205110187}\nThe Zombieland Invitational - The zombie-killing race course of your nightmares!\n{1794959568031203}\nArcade Mode - a new roguelite experience!\n\nAccolades:\n- \"Insanely addictive\" - VRFocus\n- \u201cThe gameplay is incredibly fun and really addictive\u201d - BMF VR\n- \"Arcade head blasting fun\" - Beardo Benjo\n- \u201cThe headshot slowmo is seriously addictive\u201d - Cerberusarms\n- \"A joy to play\u201d - Platinum Award, Thumb Culture", "short_description": "** VR Game of the Year finalist - VR Awards **\n** VR Game of the Year finalist - TIGA Awards **\n\n\"Insanely addictive\" - VRFocus\n\u201cThe gameplay is incredibly fun and really addictive\u201d - BMF VR\n\"Arcade head blasting fun\" - Beardo Benjo\n\nThe award-winning Zombieland: Headshot Fever is an arcade light gun game built for VR.\n\nHeadshot combos slow the clock, meaning the most precise shooter is the fastest - challenge the leaderboards with skill, speed, and accuracy."}]}, "developer_name": "XR Games", "developer_privacy_policy_url": "https://www.xrgames.io/privacy-policy", "develop
=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXjnJF1h4NxC2smX58ibE6FVjmlkCNkYBHl3eYQ8vpRmQ&oe=6B0F132F"}, {"file_name": "Zombieland_Bowling_Realm_Quest_2.png", "id": "252534296669179", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982617_252534300002512_88477822051553422_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2geMDNfEtc4Q7kNvwGo9W8-&_nc_oc=Ado8hglGnYlLEjJYSNPtV1ylbcoHsnWPOBy4Lnth3SSO2KOeQHHyzpqgI9_3OnL2pnQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQW5gRBDAI55T1zPrhvly690-z0ic5IqvqUyz5drApV-6w&oe=6B0EFB3D"}, {"file_name": "Zombieland_Office_Quest_2.png", "id": "637533130512612", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982535_637533133845945_4913826446620039560_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fc2LmxSLOrMQ7kNvwH4nZyk&_nc_oc=Adp0JePe49IAWhBKBLmAhop-JQ6EDCRawrNcmXCo3BLtxMZ62z7NYA-b-cGjsyEn-rw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVsTCIliUAE9-Vuuqk_vP2iCxT1LtlN4J583IOLr0b67A&oe=6B0EF022"}, {"file_name": "Zombieland_Family_Home_Quest_2.png", "id": "2864214510561781", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39001725_2864214513895114_2819262369100977508_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hhGgf0RVp08Q7kNvwEq9tv1&_nc_oc=AdrgYzMwT7zpgf1KZ8Hin4xRTfaYFt0kRt7Jz11w_oWhOSx5x0AqEpU6AhsgRpRR1sk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXxaJwglGoYcwxUZpEeE68cCEY7wlXSo378yJYmTokWdQ&oe=6B0F0398"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ZL_HSF_Meta_Landscape_2560x1440.png", "id": "1141846950667714", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473393523_1141846954001047_2789278163877689417_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D9oJjdYGCc0Q7kNvwFCROfm&_nc_oc=Adq2tUI2ii8cgjs2KL5VHXfnGNOwue5NfdbTajBlBq1arKrd6xdU3uuEEwhl5HbNrfI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQUgsJwHaCBfWmpl-tAbYW219VKI9Ik3Bm1Xq4ogZS68sQ&oe=6B0F0DD4"}, "display_name": "Zombieland: Headshot Fever", "keywords": ["Shooter", "FPS", "zombies", "Zombieland", "Arcade"], "long_description": "** VR Game of the Year finalist at TIGA Awards **\n** VR Game of the Year finalist at VR Awards **\n** Winner of 'Best Small Studio' at the TIGA Awards **\n\nThe award-winning Zombieland: Headshot Fever is an arcade light-gun game built for VR.\n\nThis zombie-killing race sport brings light-gun games into the 21st century! Headshot combos slow the clock, meaning the most precise shooter is the fastest - challenge the leaderboards with skill, speed, and accuracy.\n\nFEATURES:\n{958104066384162}\nBullet Time - Two headshots turn the world slow!\n{1132267338685310}\nLeaderboards - Challenge the world!\n{1038303291795263}\nWeapons - Unlock and upgrade a range of weapons!\n{609884205110187}\nThe Zombieland Invitational - The zombie-killing race course of your nightmares!\n{1794959568031203}\nArcade Mode - a new roguelite experience!\n\nAccolades:\n- \"Insanely addictive\" - VRFocus\n- \u201cThe gameplay is incredibly fun and really addictive\u201d - BMF VR\n- \"Arcade head blasting fun\" - Beardo Benjo\n- \u201cThe headshot slowmo is seriously addictive\u201d - Cerberusarms\n- \"A joy to play\u201d - Platinum Award, Thumb Culture", "short_description": "** VR Game of the Year finalist - VR Awards **\n** VR Game of the Year finalist - TIGA Awards **\n\n\"Insanely addictive\" - VRFocus\n\u201cThe gameplay is incredibly fun and really addictive\u201d - BMF VR\n\"Arcade head blasting fun\" - Beardo Benjo\n\nThe award-winning Zombieland: Headshot Fever is an arcade light gun game built for VR.\n\nHeadshot combos slow the clock, meaning the most precise shooter is the fastest - challenge the leaderboards with skill, speed, and accuracy."}]}, "developer_name": "XR Games", "developer_privacy_policy_url": "https://www.xrgames.io/privacy-policy", "develop
, "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974764_282086527362351_3477327459334696577_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JoEQrGnf51AQ7kNvwHqIVNs&_nc_oc=Ado6KTvy9Uiq-bAGoQLu6MZfUmg56Wnhwjrmsz6GOE2BGyt9zvsWArVMy0CdW6jRtG4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM5J-jc3xVnT4Elwoc7QZ9Ibz-s51dUFGP2EF1z1hQbLg&oe=6AC3CA34"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_Cover_Liteboxer_2560x1440.png", "id": "498903611662553", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982727_498903614995886_1314832137664449563_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Vg9L9ez1NYMQ7kNvwHvXZjG&_nc_oc=AdqQ5d1mGQnNwHOCHxQ2d7mL432WcEbU9gFQQfnKWvaUH1Is32JNa0XwXhdXKe0GyYY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOkUIPicJ7n1WvzZkQCqQTUL7NNfkol2WfVs3oRDr0g1Q&oe=6AC3C085"}, "display_name": "Liteboxer", "keywords": ["Fitness", "Boxing", "Exercise", "Music", "Workout"], "long_description": "Are you ready to step in the ring? Liteboxer, the leader in gamified boxing fitness, gives you unlimited access to an ever-growing library of workout options - ranging from trainer workouts to chart-topping music that provides an entertaining and immersive boxing experience. For every punch, Liteboxer tracks your power, timing, and accuracy. Compete against yourself and others as you improve your scores across hundreds of workouts. Liteboxer is built to be fitness-first and champion a sports-at-home experience. You'll be immersed in real trainer workouts that cross the boundary of motivation into actual coaching and interaction. Instead of a video game, you'll experience a full workout that is built to fit into a gaming format. Think you're ready?\n\nFull body beat-based boxing workouts \nBest in class coaching from real fitness trainers\nReal-Time metrics\nHundreds of top-charting music from artists like YG to Lady Gaga\n\nMembership begins at $18.99/month. Start with a 7-day free trial.", "short_description": "Are you ready to step in the ring? Liteboxer, the leader in gamified boxing fitness, gives you unlimited access to an ever-growing library of workout options - ranging from trainer workouts to chart-topping music that provides an immersive boxing experience. \n\nFull body beat-based boxing workouts \nBest in class coaching from real fitness trainers\nReal-Time metrics\nHundreds of top-charting music from artists like YG to Lady Gaga\n\nMembership begins at $18.99/month. Start with a 7-day free trial."}]}, "developer_name": null, "developer_privacy_policy_url": "https://liteboxer.com/pages/privacy-policy", "developer_terms_of_service_url": "https://liteboxer.com/pages/terms-of-service", "publisher_name": "Liteboxer", "support_website_url": "https://support.liteboxer.com/", "website_url": "https://liteboxer.com/pages/vr", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}, {"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SPORTS"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "303321985108518"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PUBLISHED", "id": "319547876820438"}, {"status": "PUBLISHED", "id": "674192897682834"}]}, "baseline_offer": {"id": "319547876820438"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1646330460, "status": "PUBLISHED", "id": "319547876820438"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinar
uluscdn.com/v/t64.5771-25/491819845_33433009509631060_8233866292253421935_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RoZjKeMxQusQ7kNvwEgHIhj&_nc_oc=AdnGsTuSwABo-Y1lUi2THuVupqjb8miynSE57QVKcr5zwtYcvM0s7zYFjLAPYOjyqvM&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&oh=00_AfvQoU8IX42Kcb4suNMO1p2RSxgl-WXGMXERlgs2q5cSqA&oe=69984F6F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "logo video.png", "id": "1157342109927605", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491821725_1157342113260938_5053254329938512617_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CGWJ9QGW2HEQ7kNvwFkkZXI&_nc_oc=AdksI3R-gzf0Pu1EMENWc4Pb9sHmywWSdWBJUvocG_uQ56hvxP4LPIzHeiTByTsnzBI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&oh=00_Afs7gIWO0Q3QftH8LOqDr3cjQFKUNPZu0zZbC8TuqaKTew&oe=6998468D"}, "display_name": "VR Holy Bible", "keywords": ["bible"], "long_description": "A mixed reality Bible that offers a complete experience with multiple versions in English and Spanish.\n\nNote: The hand gesture to click to close the fist.\n\n#### **English Versions (9 available):**\n- **KJV** - King James Version\n- **KJV with Strong's** - King James Version with Strong's Numbers\n- **ASV** - American Standard Version\n- **ASV with Strong's** - American Standard Version (Strong's Numbers)\n- **WEB** - World English Bible\n- **Bishops** - Bishops of the Bible\n- **Coverdale** - Coverdale Bible\n- **Geneva** - Geneva Bible\n- **Tyndale** - Tyndale Bible\n\n#### **Spanish Versions (5 available):**\n- **RVG** - Reina Valera G\u00f3mez\n- **RVG 2004** - Reina Valera G\u00f3mez 2004\n- **RV 1909** - Reina Valera 1909\n- **RV 1909 with Strong's** - Reina Valera 1909 (with Strong's Numbers)\n- **Holy** - Holy Scriptures", "short_description": "Holy Bible in mixed reality and hand-tracking with several book versions in English and Spanish."}, {"images": {"nodes": []}, "id": "733264635747534", "locale": "es_LA", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Santa Biblia en realidad mixta", "keywords": ["Biblia"], "long_description": "Una Biblia de realidad mixta que ofrece una experiencia completa con m\u00faltiples versiones en ingl\u00e9s y espa\u00f1ol.\n\nOjo: El gesto de la mano para hacer clic en cerrar el pu\u00f1o.\n\n#### **Versiones en ingl\u00e9s (9 disponibles):**\n\n- **KJV** - Versi\u00f3n King James\n\n- **KJV con Strong's** - Versi\u00f3n King James con n\u00fameros de Strong\n\n- **ASV** - Versi\u00f3n Est\u00e1ndar Americana\n\n- **ASV con Strong's** - Versi\u00f3n Est\u00e1ndar Americana (con n\u00fameros de Strong)\n\n- **WEB** - Biblia Mundial en Ingl\u00e9s\n\n- **Biblia de los Obispos** - Obispos de la Biblia\n\n- **Coverdale** - Biblia Coverdale\n\n- **Ginebra** - Biblia de Ginebra\n\n- **Tyndale** - Biblia Tyndale\n\n#### **Versiones en espa\u00f1ol (5 disponibles):**\n\n- **RVG** - Reina Valera G\u00f3mez\n\n- **RVG 2004** - Reina Valera G\u00f3mez 2004\n\n- **RV 1909** - Reina Valera 1909\n\n- **RV 1909 con Strong's** - Reina Valera 1909 (con n\u00fameros de Strong) n\u00fameros)\n\n- **Santo** - Sagradas Escrituras", "short_description": "Santa Biblia en realidad mixta y seguimiento de manos con varias versiones del libro en ingl\u00e9s y espa\u00f1ol."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1b5CjUwwchaGJvD8IBFzjlbru6hrU0RTU1mQU1My7fZI", "developer_terms_of_service_url": null, "publisher_name": "Pop Software Developer", "support_website_url": null, "website_url": "https://sites.google.com/view/vr-holy-bible/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": 
pVy2erl2g&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFTcqcH0HsPh3lj73ITBvkQ-7i0Lnye1g8Ts7_yoFjOAQ&oe=6A7B2354"}, {"file_name": "Screenshots5.png", "id": "33433009486297729", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491819845_33433009509631060_8233866292253421935_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=txFKWtQbJZwQ7kNvwElPpX-&_nc_oc=AdqIx7MlEuG96ftRxtu8kLF-803rfwBUGogKvIGsysflrNCnelbWRymd9gyJmb83kG4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQExUv27H162EDPyVpJlC2JMsZVxB-aExWGGBM5q3OcT2Q&oe=6A7B116F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "logo video.png", "id": "1157342109927605", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491821725_1157342113260938_5053254329938512617_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hZ9b56gzmaUQ7kNvwHSMdMl&_nc_oc=Adr235T2bNebDnKyfvRxH3VIXXfa8fGSx28Ymn9qPGTRSkFCRUmmGuCpOK1vRmte07I&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH0xspErh-waCHj7irSVW43XAvV63y0NE2at6hCXfKYoQ&oe=6A7B088D"}, "display_name": "VR Holy Bible", "keywords": ["bible"], "long_description": "A mixed reality Bible that offers a complete experience with multiple versions in English and Spanish.\n\nNote: The hand gesture to click to close the fist.\n\n#### **English Versions (9 available):**\n- **KJV** - King James Version\n- **KJV with Strong's** - King James Version with Strong's Numbers\n- **ASV** - American Standard Version\n- **ASV with Strong's** - American Standard Version (Strong's Numbers)\n- **WEB** - World English Bible\n- **Bishops** - Bishops of the Bible\n- **Coverdale** - Coverdale Bible\n- **Geneva** - Geneva Bible\n- **Tyndale** - Tyndale Bible\n\n#### **Spanish Versions (5 available):**\n- **RVG** - Reina Valera G\u00f3mez\n- **RVG 2004** - Reina Valera G\u00f3mez 2004\n- **RV 1909** - Reina Valera 1909\n- **RV 1909 with Strong's** - Reina Valera 1909 (with Strong's Numbers)\n- **Holy** - Holy Scriptures", "shor
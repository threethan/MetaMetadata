-7&_nc_sid=6e7a0a&_nc_ohc=KE5KJoAJKvwQ7kNvwFkDKAZ&_nc_oc=Adp7Lb3Fcp7PgOE6ixPT-mvWpW4K-W_bD4ggD2arzAshtr1zx1EL5sIPmb7_LZWGPec&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRoiOQgwtjMY0J1k8JZg69mscB5hhu4s0OitpGxGlBW9g&oe=6AF4A594"}, {"file_name": "Screenshots5.png", "id": "33433009486297729", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491819845_33433009509631060_8233866292253421935_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wIl3abWfQygQ7kNvwGdxeWm&_nc_oc=AdpdQlWG_WqU3dzIiobdffcquk1WDN8zwihAZTiiAt984v9ObdDeVo8hkOwVHxfl6Ds&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTo6qsolFAOKfEw62PHbsPLDUuF9a02WWupkYOVDtinGA&oe=6AF493AF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "logo video.png", "id": "1157342109927605", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491821725_1157342113260938_5053254329938512617_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QJ3Wzw_uIRsQ7kNvwGXbHsu&_nc_oc=AdrzviUWlzS2LYuqARGS9y7o0-7y-U2AA00aLcstwoxABXy7ofOxFPADPSyvhZrxeY0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRha8uBSxjaQupDKVNw8bOnnLybhVT3ICHsQ7iYGjYALQ&oe=6AF48ACD"}, "display_name": "VR Holy Bible", "keywords": ["bible"], "long_description": "A mixed reality Bible that offers a complete experience with multiple versions in English and Spanish.\n\nYou can use either your hands or the meta quest controls to use the application.\n\nNote: To perform a click with handtracking, bring the index finger and thumb together. Watch the video to fully understand the gesture in action.\n\n#### **English Versions (9 available):**\n- **KJV** - King James Version\n- **KJV with Strong's** - King James Version with Strong's Numbers\n- **ASV** - American Standard Version\n- **ASV with Strong's** - American Standard Version (Strong's Numbers)\n- **WEB** - World English Bible\n- **Bishops** - Bishops of the Bible\n- **Coverdale** - Coverdale Bible\n- **Geneva** - Geneva Bible\n- **Tyndale** - Tyndale Bible\n\n#### **Spanish Versions (5 available):**\n- **RVG** - Reina Valera G\u00f3mez\n- **RVG 2004** - Reina Valera G\u00f3mez 2004\n- **RV 1909** - Reina Valera 1909\n- **RV 1909 with Strong's** - Reina Valera 1909 (with Strong's Numbers)\n- **Holy** - Holy Scriptures\n\n### **Audio Bible in English (KJV)**\n### Available audio:\n-The four Gospels in audio format", "short_description": "Holy Bible in mixed reality and hand-tracking with several book versions in English and Spanish."}, {"images": {"nodes": []}, "id": "1023817693486147", "locale": "es_LA", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Santa Biblia en realidad mixta", "keywords": ["Biblia"], "long_description": "Una Biblia de realidad mixta que ofrece una experiencia completa con m\u00faltiples versiones en ingl\u00e9s y espa\u00f1ol.\n\nSe puede usar tanto las manos o controles de la meta quest para usar la aplicaci\u00f3n.\n\nNota: Para realizar un clic con handtracking, une el dedo \u00edndice con el pulgar. Mira el video para comprender mejor c\u00f3mo funciona el gesto en acci\u00f3n.\n\n#### **Versiones en ingl\u00e9s (9 disponibles):**\n\n- **KJV** - Versi\u00f3n King James\n\n- **KJV con Strong's** - Versi\u00f3n King James con n\u00fameros de Strong\n\n- **ASV** - Versi\u00f3n Est\u00e1ndar Americana\n\n- **ASV con Strong's** - Versi\u00f3n Est\u00e1ndar Americana (con n\u00fameros de Strong)\n\n- **WEB** - Biblia Mundial en Ingl\u00e9s\n\n- **Biblia de los Obispos** - Obispos de la Biblia\n\n- **Coverdale** - Biblia Coverdale\n\n- **Ginebra** - Biblia de Ginebra\n\n- **Tyndale** - Biblia Tyndale\n\n#### **Versiones en espa\u00f1ol (5 disponibles):**\n\n- **RVG** - Reina Valera G\u00f3mez\n\n- **RVG 2004** - Reina Valera G\u00f3mez 2004\n\n- **RV 1909** - Reina Valera 1909\n\n- **RV 1909 con Strong's** - Reina Valera 1909 (con n\u00fameros de Strong) n\u00fameros)\n\n- **Santo** - Sagradas Escrituras\n\n#### **Biblia en audio en ingles (KJV)**\nAudio disponibles: \n-  Los cuatro Evangelios en formato de audio\n", "short_description": "Santa Biblia en realidad mixta y seguimiento de manos con varias versiones del libro en ingl\u00e9s y espa\u00f1ol."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1b5CjUwwchaGJvD8IBFzjlbru6hrU0RTU1mQU1My7fZI", "developer_terms_of_service_url": null, "publisher_name": "Pop Software Developer", "support_website_url": null, "website_url": "https://sites.google.com/view/vr-holy-bible/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "es"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "27822338704058199"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491818916_726898063116558_4332397615783858654_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iAYvqMIaVBYQ7kNvwEl7N0X&_nc_oc=AdpXuBCmSe37618SHuLZYLkU1wwxi9-tu7Qt7yvl7qTFrRknRNC0UUtkWwE70-OCzB4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQQuc4UL3Cn0CSeO1qTSihfPSefNBKUThWQmFBxQMsK2g&oe=6AF48E8F"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "VR Holy Bible", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_name": "Media", "id": "434961926215971"}], "release_date": 17631
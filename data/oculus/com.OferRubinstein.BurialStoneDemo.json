ontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR7K5f80jIxCKJi0JJ9ZkWv7kegzotmwz-fHfe9I3N9kg&oe=6AFC5F41"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Burial Stone Demo", "keywords": [], "long_description": "(This is the Demo of Burial Stone)\n\nDelve into a damp dark dungeon, with your torch as your only light source, in the DEMO of Burial Stone.\n\nBurial Stone is a VR tile based, tactical dungeon crawl. Fight terrifying monsters from a first person perspective, acquire equipment, weapons and gold.\nLearn spells and skills, gain XP, level up and improve your abilities.\n\nThe combat is \"you move, the others move with you\" tactical style combat, reminiscent of a rogue like game.\n\nThere is a sense of horror to these dungeons with some surprises along the way. Tread carefully.", "short_description": "(This is the Demo of Burial Stone)\n\nDelve into a damp dark dungeon, with your torch as your only light source, in the DEMO of Burial Stone.\n\nBurial Stone is a VR tile based, tactical dungeon crawl. Fight terrifying monsters from a first person perspective, acquire equipment, weapons and gold.\n\nLearn spells and skills, gain XP, level up and improve your abilities.\n\nThe combat is \"you move, the others move with you\" tactical style combat, reminiscent of a rogue like game."}]}, "developer_name": null, "developer_privacy_policy_url": "https://burialstone.computerrpg.com/BurialStone/privacy-policy-burial-stone-demo/", "developer_terms_of_service_url": null, "publisher_name": "Ofer Rubinstein", "support_website_url": null, "website_url": "https://burialstone.computerrpg.com/BurialStone/burial-stone/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQ
content-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVA9ChGPhNM4YMX6_OxQ5HlbGLktadTfuwKFrupOBbKnQ&oe=6B10491B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape.png", "id": "27892430520449916", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499620599_27892430530449915_9090965988276528860_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mVN_AVePT58Q7kNvwElkC8q&_nc_oc=Adp6Cf9Ggk931Gl7kIn0SyKNfIn4pKFiig3z1P8vaqmlrZ9iwH8mL_Z28JeWVLFj2K8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVsUBwTtSeVQ8xLjMPoreReqqSs7uNCt0aWGlfdJiq-_w&oe=6B1043B9"}, "display_name": "Putt Dojo | Real Ball Golf Putting", "keywords": ["golf", "putting", "simulator", "putt", "sim"], "long_description": "**One price. No subscription. No pass.** Buy it once and everything is yours: every mode, every drill, your stats and every update.\n\nPutt Dojo is the original, genre-defining real-ball putting app in VR. Use your own putter and a real golf ball. The headset's cameras track the ball off the face, and the putt rolls on across a virtual green that breaks and slows like the real thing. All you need is 2 ft of putting surface and a cushion.\n\n{2373069480099121}\n\n## Five ways to practise\n- **Practice:** build a putt (distance, slope, break) and repeat it\n- **Endless:** a new green for every putt\n- **One Putt Challenge:** 100 greens to read, one putt for a perfect score\n- **Ladder Drill:** short to long, to train your speed\n- **Clock Drill:** around the hole on a tilted green\n\n{1865702694462669}\n\n## Know your putting\n- Holed percentage, finish distance and start line, tracked over time\n- Split by distance, slope or break\n- A map of where your putts finish, and CSV export\n\n## Read it, then roll it\n- Break line, start line and Auto Aim\n- Slope heat map, contour lines or a distance grid\n- Green speed from 6 to 15 on the stimp\n- Metronome, Eye Over Ball check and Backswing Ruler\n\n## What you need\n{1612168533503335}\n\nA putter, a ball that contrasts with your mat or carpet, a cushion as a backstop, and good lighting.\n\nJoin us on Discord: https://discord.gg/wkDcwCEBzJ", "short_description": "One price, no subscription. Putt your real ball on 2 ft of putting surface. Use your own putter and a real golf ball: the headset's cameras track the ball off the face, and the putt rolls on across a virtual green that breaks and slows like the real thing. Five practice modes, stats that track your progress, and every update included. The original real-ball putting simulator in VR, and the app that started the genre."}]}, "developer_name": "xr.golf", "developer_privacy_policy_url": "https://xr.golf/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "xr.golf", "support_website_url": "https://discord.gg/wkDcwCEBzJ", "website_url": "https://puttdojo.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "28479534978373783"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499619078_4270344076589976_7126456152573505873_n.png?stp=dst-png_s360x360&_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rDcQnoCki-IQ7kNvwHERsr3&_nc_oc=AdpBDMlu_na5dw2VQmWLQrVtB7Lrz7VS8Nc8E-pUTGZ0Q6jrswVupjYCUb1sRFSo32I&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQ
Qs_PIHlhuh94v6aNJdT6eW-IZ40b3XSzKbtu78OgiEzDWI&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIN2GahDythRRmeiBoB_72l88OGNt-G4v9gMIONpNVvIQ&oe=6A9ACAB5"}, {"file_name": "Screenshot1.png", "id": "1547547003037645", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499622184_1547547006370978_6233029992004278823_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nm10dBW83PkQ7kNvwEX3JBm&_nc_oc=AdoX51JvBVy3e6P0etfZ-2yFPIpJdgFi0TczdTVpmNdRbBHiducBhUqzM_Uu441DdV0&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLKhjkIlHnL2MUi7dlodp_ENL_I_f0jqkXolWbE9enT_g&oe=6A9ABE19"}, {"file_name": "Screenshot3.png", "id": "942413044786146", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499627527_942413048119479_2419595915127367757_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KyU4PsX3_iIQ7kNvwEDQ-NM&_nc_oc=Adr7X9PeoeGHuq06C_kHiLnjJ67LeopH0FT3FvDW0x-zyiw4XqR3eN_0e5fo52dD-90&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI_aF4bFJJYv4kwgHs1fwy4P94TPrXVR41MNwqmvnRwqQ&oe=6A9AF271"}, {"file_name": "Screenshot4.png", "id": "2021808285134904", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499628108_2021808288468237_2768370534854051926_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DbDEWeG1RiQQ7kNvwH3Q7Fp&_nc_oc=AdoXdWRs-WOeP1MGtuWMnfQcBV672HCxEY4xHjCyxoPNYQUQb-tpBAA6ZvSKjT_nhN4&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIxHnEpFUm6W6SMmTgFBTC8OG7MQARglhwRAnEwN672zA&oe=6A9AF39B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape.png", "id": "27892430520449916", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499620599_27892430530449915_9090965988276528860_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XIAyXJCizQsQ7kNvwFqg9Mm&_nc_oc=AdpmY4a4IQfYRDy_ROmuaDggurtiRxzxK0q34WiRr3R3EVMaEeClXY6jjMHsj0db7kc&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLZXiUycOxX-3d4B9TMSwYyEq1Wi4QnG4cDdPSXfhxmCQ&oe=6A9AEE39"}, "display_name": "Putt Dojo | Real Ball Golf Putting", "keywords": ["golf", "putting", "simulator", "putt", "sim"], "long_description": "Turn your living room carpet into a Tour-quality practice green with Putt Dojo, a putting simulator that tracks your real golf ball as you putt. Like magic, your real ball appears to roll seamlessly through a portal onto a virtual green, reacting to the speed and contours of the simulated surface.\n\n{1065423359516168}\n\nWhether you're working on your start line, speed control, or grooving a consistent stroke, Putt Dojo is built for golfers who want meaningful practice without leaving home.\n\n# What you'll need\n\n- A **real putter and golf ball**\n- A small area of **putting surface**, such as a putting mat or flat carpet that contrasts with the ball\n- A **backstop or cushion** to stop the ball from rolling away\n\n# Game Modes (More Coming Soon)\n- **Endless:** An endless stream of uniquely generated greens with tunable settings.\n- **Practice:** Set up a custom putt to practice on and visualize your dispersion.\n- **Ladder Drill:** A progressive distance drill to dial in your speed and control.\n- **One Putt Challenge** 100 scenarios of increasing difficulty.\n\n# Developer's Note\nHi, I'm the creator of Putt Dojo - the original real ball putting sim in VR. I\u2019ve spent several years crafting Putt Dojo to meet a high quality bar. I want this product to offer great value, so I decided to make it a one-off purchase, which feels like a fairer model than an ongoing subscription. Lastly, I'm always happy to hear feedback and suggestions to help improve the app.\n\n\ud83d\udc49 Get in touch on Discord to suggest new features and shape what's next: https://discord.gg/wkDcwCEBzJ", "short_description": "Turn your living room carpet into a Tour-quality practice green with Putt Dojo, a putting simulator that tracks your real golf ball as you putt. Like magic, your real ball appears to roll seamlessly through a portal onto a virtual green, reacting to the speed and contours of the simulated surface. Sharpen your distance control and read breaks you'd never see on a flat living-room floor. If you've ever wished for more realistic, varied putting practice at home, Putt Dojo is for you."}]}, "developer_name": "xr.golf", "developer_privacy_policy_url": "https://xr.golf/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "xr.golf", "support_website_url": "https://discord.gg/wkDcwCEBzJ", "website_url": "https://puttdojo.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "27867155002945120"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499619078_4270344076589976_7126456152573505873_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gQYS4ReUS7YQ7kNvwGroMGz&_nc_oc=AdpGtnA2RpKVF0axU93LNKE1djIAFcsOCA9xrt0LK-sawoyQxKhAxntoH_-Uidm_Y54&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJK2IAiBQvHLosf5vwFThPxWi8yukouUrlOKJqx0qNErw&oe=6A9ADB62"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Putt Dojo | Real Ball Golf Putting", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_name": "Sports", "id": "2776542286000603"}], "release_date": 1727738820, "lastRevision"
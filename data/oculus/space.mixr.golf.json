25/39035364_551118307358562_7999145123594540941_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3L7IvCb_4TwQ7kNvwGqh1jf&_nc_oc=Adom3vSwCHcdv9utbr2qEkqRNv4WlvdQ3-TONJnpbye1sB5Rz8VxNBwOIOUIkzRbC7U&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRGjOPiSnIzWdK2zSS_TP7zciDE5HqdravS41WCx-PQgg&oe=6AF33BAE"}, "display_name": "Putt Window", "keywords": ["golf", "putting", "simulator", "training", "practice"], "long_description": "A mixed reality putting simulator for golfers to practice putting at home. Putt Window is designed to be used with a real golf ball/putter, but can also be used with Meta Quest Touch Controllers. \n\nCurrently, using a real ball requires an external camera based putting system. Real ball putting without additional hardware is planned for 2025 when Meta opens headset camera access to developers. For more information about using an external camera based putting system, visit puttwindow dot com", "short_description": "A mixed reality putting simulator for golfers to practice putting at home. Putt Window is designed to be used with a real golf ball/putter, but can also be used with Meta Quest Touch Controllers. \n\nCurrently, using a real ball requires an external camera based putting system. Real ball putting without additional hardware is planned for 2025 when Meta opens headset camera access to developers. For more information about using an external camera based putting system, visit puttwindow dot com"}]}, "developer_name": null, "developer_privacy_policy_url": "https://mixr.space/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "mixr design", "support_website_url": null, "website_url": "https://puttwindow.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_
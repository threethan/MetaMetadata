Es7G8eSCqdTXCaAGC12-H82q1Cs2bIzQh7KkIhPNP3uBb4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK0T8wEVlUW0JA-j9O3Klr2Y0U6TfsPY5d2uKQQjV0Leg&oe=6A997935"}, {"file_name": "Screenshot1.png", "id": "1547547003037645", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499622184_1547547006370978_6233029992004278823_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nm10dBW83PkQ7kNvwGPw0d9&_nc_oc=AdoGUYOJmROIrFdhwYkJqkLHxr7Jtt4w-HXACnRLgr_SvSiZ_wEL5rHcdZXUlYWHcEs&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJz2Kz1McnOUbK88R7COKnEa0jsFrE-KHxzpKykzrydww&oe=6A99A4D9"}, {"file_name": "Screenshot3.png", "id": "942413044786146", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499627527_942413048119479_2419595915127367757_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KyU4PsX3_iIQ7kNvwHj-K-z&_nc_oc=AdrP18TaMvQ9gZYjJj8hS78XMuxYVDB4-LqS9u6PAhXpt8w7F23FLVH7GlWpojM3hMU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL4zXUDtGHD3GWm4zkZWAlX51FZuvKiBU4qtZtB34ABwg&oe=6A99A0F1"}, {"file_name": "Screenshot4.png", "id": "2021808285134904", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499628108_2021808288468237_2768370534854051926_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UJoSwcmZOBQQ7kNvwEG6Id9&_nc_oc=AdqmfXDA5Gk3OrzUQQzLLTf16ySoInNGOv3pJgUULvyhVovKOyT5YoPRIkq4NmMlcvU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJgvwxDDAL33NBPrq7w-YKo5fF-5T5dNgSOwGSgfhNi6A&oe=6A99A21B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape.png", "id": "27892430520449916", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499620599_27892430530449915_9090965988276528860_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XIAyXJCizQsQ7kNvwFi2OPZ&_nc_oc=AdpjN5iPEk6BbDwpK812tDVh_L2blYvga8tPKq-RujhYJo_tsysp8DTKjp8l6reWMgw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKN6rHlof-Cpi1TDjWOoKF_0jA8_8TvSmDaRDkZ2ulW1w&oe=6A999CB9"}, "display_name": "Putt Dojo | Real Ball Golf Putting", "keywords": ["golf", "putting", "simulator", "putt", "sim"], "long_description": "Turn your living room carpet into a Tour-quality practice green with Putt Dojo, a putting simulator that tracks your real golf ball as you putt. Like magic, your real ball appears to roll seamlessly through a portal onto a virtual green, reacting to the speed and contours of the simulated surface.\n\n{1065423359516168}\n\nWhether you're working on your start line, speed control, or grooving a consistent stroke, Putt Dojo is built for golfers who want meaningful practice without leaving home.\n\n# What you'll need\n\n- A **real putter and golf ball**\n- A small area of **putting surface**, such as a putting mat or flat carpet that contrasts with the ball\n- A **backstop or cushion** to stop the ball from rolling away\n\n# Game Modes (More Coming Soon)\n- **Endless:** An endless stream of uniquely generated greens with tunable settings.\n- **Practice:** Set up a custom putt to practice on and visualize your dispersion.\n- **Ladder Drill:** A progressive distance drill to dial in your speed and control.\n- **One Putt Challenge** 100 scenarios of increasing difficulty.\n\n# Developer's Note\nHi, I'm the creator of Putt Dojo - the original real ball putting sim in VR. I\u2019ve spent several years crafting Putt Dojo to meet a high quality bar. I want this product to offer great value, so I decided to make it a one-off purchase, which feels like a fairer model than an ongoing subscription. Lastly, I'm always happy to hear feedback and suggestions to help improve the app.\n\n\ud83d\udc49 Get in touch on Discord to suggest new features and shape what's next: https://discord.gg/wkDcwCEBzJ", "short_description": "Turn your living room carpet into a Tour-quality practice green with Putt Dojo, a putting simulator that tracks your real golf ball as you putt. Like magic, your real ball appears to roll seamlessly through a portal onto a virtual green, reacting to the speed and contours of the simulated surface. Sharpen your distance control and read breaks you'd never see on a flat living-room floor. If you've ever wished for more realistic, varied putting practice at home, Putt Dojo is for you."}]}, "developer_name": "xr.golf", "developer_privacy_policy_url": "https://xr.golf/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "xr.golf", "support_website_url": "https://discord.gg/wkDcwCEBzJ", "website_url": "https://puttdojo.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "27867155002945120"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499619078_4270344076589976_7126456152573505873_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gQYS4ReUS7YQ7kNvwG5bBuB&_nc_oc=Adp3QJMsu2tnJLKJoPTQ0TD5GkQFHUYbFQwTHBlG0gATXuNqeIrtXFhlNZDdCBRqYTQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLzqyAzdCQHEtfFLurl1_yGlKUO80uuJ-o_ewmhpJA9qg&oe=6A9989E2"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Putt Dojo | Real Ball Golf Putting", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_name": "Sports", "id": "2776542286000603"}], "release_date": 1727738820, "lastRevision"
luscdn.com&_nc_ss=7f20f&oh=00_Af4a6pqDA_oSO7WssQUpG3PsJbNVlV4KLCSI40TC7yEL2Q&oe=6A170BD8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape.png", "id": "1603662844009275", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/491827033_1603662847342608_3448614749433415704_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hI9qyf3gZ2UQ7kNvwEADpzy&_nc_oc=AdruthaDwL_jCnshbrT3hvI_ZMdSy9cZNmVGS9ptX2ISeeIO4YDY7XMwnr5fkxIyPBg&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7E2UFZoa6jSKCNnW5scdTrivx4Nyh9iAX3qPfjD_fm2w&oe=6A16FED4"}, "display_name": "Putt Dojo | Real Ball Golf Putting", "keywords": ["golf", "putting", "simulator", "putt", "sim"], "long_description": "Putt Dojo is a putting simulator that works with a **real golf ball and putter**, designed to be a fun way to practice and improve your putting at home.\n\nPutt Dojo tracks your real ball so it rolls seamlessly from your space into the simulation, and reacts accurately to the speeds, slopes and contours of a virtual golf green. \n\n{3783134021823501}\n\n\u201cThe most impressive use of the passthrough camera so far.\u201d - UploadVR\n\nWhether you\u2019re working on start line, speed control, or building a consistent stroke, Putt Dojo is designed for golfers who want meaningful practice without leaving home.\n\n### To use Putt Dojo, you\u2019ll need:\n- A **real putter and golf ball**\n- At least **2 ft of putting surface**\\*, such as a putting mat or carpet  \n- A **backstop/cushion**, or a **ball returner** to prevent the ball rolling away  \n\n\\*The tracking area (2x1 ft) should be free of circular markings, complex patterns, or any lines/markings of similar color to the ball\n\nPutt Dojo is also playable in virtual ball mode using the Meta Quest Touch Controllers.\n\nIf you\u2019ve ever wished for more realistic, varied putting practice at home, Putt Dojo is for you. Experience a new kind of golf simulation today.\n\n\ud83d\udc49 Join the Discord to suggest new features: https://discord.gg/wkDcwCEBzJ", "short_description": "Putt Dojo is a putting simulator that works with a real golf ball and putter, designed to be a fun way to practice and improve your putting.\n\nPutt Dojo tracks your real ball so it rolls seamlessly from your space into the simulation, and reacts accurately to the speeds, slopes and contours of a virtual golf green.\n\nIf you\u2019ve ever wished for more realistic, varied putting practice at home, Putt Dojo is for you\n\nJoin the official Discord to suggest features: https://discord.gg/wkDcwCEBzJ\n\n"}]}, "developer_name": "xr.golf", "developer_privacy_policy_url": "https://xr.golf/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "xr.golf", "support_website_url": "https://discord.gg/wkDcwCEBzJ", "website_url": "https://puttdojo.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25935574706103169"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499619672_1469675248132181_8386223370972093356_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uQ_vVmcxvLIQ7kNvwFd-iX_&_nc_oc=Ado0AMkylfk4XTsC-ll9IqmuAF0y346aILYSwsDaas2TkTU1NIuAnXBXueJF_hOAOMU&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7yxviGbum3stosu8jrIpqwrkQbTwVkPFHLDtIa7Wb-vg&oe=6A170F3B"}, "is_co
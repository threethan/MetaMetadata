, "firstOffer": {"nodes": [{"start_time": 1792774800, "status": "PUBLISHED", "id": "1655623092754005"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "28819092281084716", "version": "0.8.4"}, "id": "503492485486376", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "7908645409222708", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "28819092281084716"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "503492485486376"}]}, "change_log": "- Stats now show your start line: average, spread and trend over time\n- Hard putts are detected more reliably, with more consistent speed readings\n- New Tracking Area Size option during space setup for more accurate fast putts\n- More robust detection of ball ready state\n- Smoother replay capture\n- Improved UI speed and animation\n- Fixed issue with visual depth during Space Setup\n- Better handling of headset tracking loss\n- Small visual and usability improvements", "created_date": 1793500774, "id": "28819092281084716", "version": "0.8.4", "version_code": 79, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "7908645409222708", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "28819092281084716"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": []}, "change_log": null, "created_date": 1793421866, "id": "28806567325670545", "version": "0.8.4", "version_code": 78, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "7908645409222708", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "28819092281084716"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": []}, "change_log": null, "created_date": 1793419086, "id": "28806137112380233", "version": "0.8.4", "version_code": 77, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "7908645409222708", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "28819092281084716"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "503492485486376"}]}, "change_log": "- New Stats screen: see your holed percentage, finish error, a map of where putts finish, and how you're trending at each distance over the last 30 days\n- Stats are saved on the headset and can be exported as a CSV from the Stats screen\n- Real putts now model the ball skidding before it rolls, so firm putts no longer run too far\n- Green speed can now be set in half-stimp steps\n- Improved cup edge so a ball can no longer skip over the lip of the hole\n- More robust real ball shot detection\n- Improved aim control so it's clearer how to adjust your line, and Reset is now Re-aim\n- Space Setup now explains putters whose top markings interfere with tracking, and the tape fix\n- Small visual and usability improvements", "created_date": 1791356266, "id": "28475483185445629", "version": "0.8.3", "version_code": 76, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "7908645409222708", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "28819092281084716"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "503492485486376"}]}, "change_log": "- New drill: Clock Drill, putt around the hole from stations on a sloped green\n- Reworked Ladder Drill setup with a fixed green and clearer distance readout\n- Improved fidelity of cup\n- Performance improvements for smoother frame pacing\n- Tuned portal floor fade", "created_date": 1790352441, "id": "28331978209796128", "version": "0.8.2", "version_code": 75, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}]}}, "viewer": {"user": null}}}
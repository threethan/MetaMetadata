Vp_IrVgcMETXhcbNwM4wGUw3X_Ev7RvNHqVSBtJPXtJgQ4&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR7gnpLxvpogJLKcR8ELc22gaPdAPFJShH7kPMZku0k_w&oe=6AF35775"}, {"file_name": "Screenshot1.png", "id": "1547547003037645", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499622184_1547547006370978_6233029992004278823_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rQZb_zH_pOYQ7kNvwG83bPM&_nc_oc=AdpHTCIXN6cbA0f3IJenfH2msltpeQMMQhEY2pH4W3NtHY-2boJzhU7gju7t2K2x6lk&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRI5hdeh5zUJiB5VWIocIn4DpsVwSHr1j9hITOHsszQqA&oe=6AF34AD9"}, {"file_name": "Screenshot3.png", "id": "942413044786146", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499627527_942413048119479_2419595915127367757_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hUByE6djTCEQ7kNvwGEsE_V&_nc_oc=Adpi__eQM6Cl4weiu5DyL7CORhx_c4kp-ZI-YWUvUULHrNMhklq6akY9-XH5SHXUw90&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQGFpMAbMie_IuQPTKU3UTbvVkIPvlZtfZ6bS4ssPqTRQ&oe=6AF346F1"}, {"file_name": "Screenshot4.png", "id": "2021808285134904", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499628108_2021808288468237_2768370534854051926_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8eGfnjjjFPcQ7kNvwEjfmUE&_nc_oc=AdoAI9o_BwHKgtWu7XgdawJej91PFefOAQ4OrP9uartZVCC75YOi_6WloZHYtKxVqMI&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT2UTh9TQVhNkn3hH6_C7YlX_4YaqinVznG0B3aCfx0zA&oe=6AF3481B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape.png", "id": "27892430520449916", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499620599_27892430530449915_9090965988276528860_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TxpVhT33PCcQ7kNvwGjcXuc&_nc_oc=AdqggMLTCX4oPTA1_MxzrT6Kc4bu_FdKzSV5Uc3TV3NN1wHmX0lcBcswTeHBAnnpiJ8&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRh_MEHDKo2Bm3Q7a3n3aa3ydfXbA9gZr7JFW5srnDTlA&oe=6AF342B9"}, "display_name": "Putt Dojo | Real Ball Golf Putting", "keywords": ["golf", "putting", "simulator", "putt", "sim"], "long_description": "Requires Meta Quest 3 or Quest 3S.\n\nTurn your living room carpet into a Tour-quality practice green with Putt Dojo, a putting simulator that tracks your real golf ball as you putt. Like magic, your real ball rolls through a portal onto a virtual green, reacting to the speed and contours of the simulated surface.\n\n{1065423359516168}\n\nWhether you're working on start line, speed control, or a consistent stroke, Putt Dojo is built for golfers who want meaningful practice at home.\n\n# What you'll need\n\n- A **Meta Quest 3 or Quest 3S**\n- A **real putter and golf ball**\n- A **putting mat or flat carpet** that contrasts with the ball\n- A **backstop or cushion** to stop the ball rolling away\n\n# Game Modes (More Coming Soon)\n- **Endless:** An endless stream of uniquely generated greens with tunable settings.\n- **Practice:** Set up a custom putt and visualize your dispersion.\n- **Ladder Drill:** A progressive distance drill to dial in your speed.\n- **One Putt Challenge:** 100 scenarios of increasing difficulty.\n\n# Developer's Note\nHi, I'm the creator of Putt Dojo - the original real ball putting sim in VR. I've spent several years crafting it to a high quality bar, and chose a one-off purchase because it feels fairer than a subscription. Feedback and suggestions are always welcome.\n\n\ud83d\udc49 Join the Discord to suggest features and shape what's next: https://discord.gg/wkDcwCEBzJ", "short_description": "Requires Meta Quest 3 or Quest 3S. Turn your living room carpet into a Tour-quality practice green with Putt Dojo, a putting simulator that tracks your real golf ball as you putt. Like magic, your real ball rolls through a portal onto a virtual green, reacting to the speed and contours of the simulated surface. Sharpen your distance control and read breaks you'd never see on a flat living-room floor. If you've ever wished for more realistic putting practice at home, Putt Dojo is for you."}]}, "developer_name": "xr.golf", "developer_privacy_policy_url": "https://xr.golf/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "xr.golf", "support_website_url": "https://discord.gg/wkDcwCEBzJ", "website_url": "https://puttdojo.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "28199143083079642"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499619078_4270344076589976_7126456152573505873_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z15_I8IJt8sQ7kNvwHzD6qB&_nc_oc=AdpIaTM_V048tURun21RYLt9703C3t0dzmFGiA1fzIJXw53uJ790px9yhJqwRBO10Rw&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSl6iogigbVutyx0Du0tKVQpt0Qnfixdc7gFFHKjJ_p1Q&oe=6AF32FE2"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Putt Dojo | Real Ball Golf Putting", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_name": "Sports", "id": "2776542286000603"}], "release_date": 1727738820, "lastRevision": {"nodes": [{"id": "7908645439222705", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "790864540
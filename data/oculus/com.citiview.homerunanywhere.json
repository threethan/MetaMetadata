i": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491823296_1004031809317002_8273682161499918074_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i9tQJBz1njYQ7kNvwGqTt45&_nc_oc=AdoR6APBlvj0qu_6ZtUXsEdyskdbUkrQ-RTeAefRBV4p9GkHvq9O8bfOGuCPtwA-ZOo&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR3lNOwizfEPfniEBx3ORDwBeeno9Xt8sGR2lP39SyxKA&oe=6AFC6C69"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_cover_2560x1440.png", "id": "935484679108906", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/491824741_935484682442239_8930411401143339508_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PmTgXin8jOwQ7kNvwHtLNrG&_nc_oc=AdqQd6lGrq9mbtN0bAemeKFU0me2cuxpoY-e4jUPCQ4QUEimzW3VneQqXxbmcFMhwgo&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRkKeWGlnmOmBCMivhtcL9loYQs0NGYC-TDgDps7zPnBw&oe=6AFC7388"}, "display_name": "Baseball", "keywords": ["baseball", "batting", "sports", "moon", "stadium"], "long_description": "The bat is already in your hand. A pitcher winds up on the mound and throws you real pitches. Swing for real - the harder and cleaner the swing, the further the ball flies.\n\nFOUR PLACES TO PLAY\n- The Moon: one-sixth gravity sends a good swing more than a thousand feet while Earth hangs in the sky. Distance signs mark your drive, and hitting the lunar lander scores bonus points.\n- Skyscraper Roof: a turf diamond 300 metres above a glowing sunset city. Knock it clean off the roof, or smash the water tower and the HIT ME billboard.\n- Stickball Street: a sunny Brooklyn block where distance is counted in sewers. Three sewers is a home run - and the brownstone windows really break.\n- Night Stadium: a ballpark under the lights. Clear the fence and fireworks light up the sky.\n\nHOW IT PLAYS\n- Pick a place from the start menu and switch any time.\n- Every hit is measured in feet on the board beside you, and your best distance is saved for each place.\n- Home runs pop a big banner; targets score bonus points.\n- Choose the pitch speed from 25 to 60 mph.\n- Six music tracks with volume control.\n- Snap turning and a menu that pauses the pitcher.\n\nSingle player, standing or roomscale, no internet connection required.", "short_description": "Step up to the plate with a real bat in your hand and hit home runs in four amazing places: on the Moon in low gravity, on a skyscraper roof above a sunset city, on a Brooklyn stickball street, and in a stadium under the lights with fireworks."}]}, "developer_name": null, "developer_privacy_policy_url": "https://citiview-baseball.pages.dev/privacy/", "developer_terms_of_service_url": null, "publisher_name": "Citiview Group", "support_website_url": null, "website_url": "https://citiview-baseball.pages.dev/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1235924376280202"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PUBLISHED", "id": "1656690565892508"}, {"status": "PUBLISHED", "id": "1266182575593245"}]}, "baseline_offer": {"id": "1656690565892508"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1792186800, "status": "PUBLISHED", "id": "1656690565892508"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1235944206278219"
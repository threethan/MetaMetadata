&oe=6B0EFE59"}, {"file_name": "03_title.png", "id": "1832029188132232", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491831964_1832029191465565_3108179435097422497_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l_Oqhh4rR5wQ7kNvwE0FMmI&_nc_oc=AdrS-kgbyZEjP8x9Hph9o53iBMrFwTXEmejq8YszvvxOmPpoawKXolYGWCy_qGfrtWk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWTq6tJKUaFIN_Rfdyna7_IpYDPvPNBJzg2-c6zms24KQ&oe=6B0F2108"}, {"file_name": "04_round_card.png", "id": "1409010117968038", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/673733337_1409010121301371_7859355413607364036_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gn1n8VFmfeIQ7kNvwEtmNut&_nc_oc=Adp9-ZSsqUp0ersabjgrFSftSI8YgWML3_O4bQWkcnlaULJrEexxeug5GqPDPXSs928&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQUJqs66nbVC6nqPLTrDRdgjce9xyl7Cuc9XvG17zF7SnQ&oe=6B0F1389"}, {"file_name": "01_flyover_ritual.png", "id": "3402249879958609", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/604331240_3402249883291942_670659271435594615_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jmfveIATsSYQ7kNvwFQLd7W&_nc_oc=Adpoq-OncjAwaXldQ2frv8IOHVCI0Ia76XEPC7-rEb-LwP6n2FMK21H58sFXkIZIAwE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVSfQHWD_CMZM6cUQGX73druV4kqGQkcCrVp1kV-Qr7fA&oe=6B0EF5C0"}, {"file_name": "02_five_opponents.png", "id": "2675210559578345", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/673542498_2675210562911678_1045988896388668833_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l0ROPn8cFAgQ7kNvwF2QUv2&_nc_oc=Adp8_MyUAtoJ3wmpDhujlNPs73xXJAh-czy3c07Mq58r-ReDM4x9p06oDy9TQycBhVo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVYnuVK2R7hqBF-99nar6xOyprxwj0FBbgicMxEVQ4i4g&oe=6B0EFC55"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_landscape_2560x1440.png", "id": "1659218372450095", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/673666542_1659218375783428_497830178643999148_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KOHSHkEjurQQ7kNvwG0wkFr&_nc_oc=AdqVylGgo7_NcQV92T4ypLFRVB7J1LCsM-S8LxfSywluNcUQ2IGKWaP0ZZXF14GfQhM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQUhzs8bbWQ8FxtymUzFfMbc_cISj7hunawemDec9feVKw&oe=6B0EF1CE"}, "display_name": "Bow Duel VR", "keywords": ["archery", "medieval", "bow", "duel", "arrows"], "long_description": "Stand on the rampart. Across the field, an archer is already drawing on you.\n\nBOW DUEL VR is a one-on-one archery duel built for Quest. Hold the bow in your left hand, pull the string back with your right, and lob an arrow in a high arc over the wall. Your rival is doing the same to you. One headshot wins. So do two body hits.\n\nEIGHT RIVALS, EIGHT ARENAS\nRookie Rufus, Dusty Dan, Captain Mae, Sister Wren, The Baron, Sir Gallant, Silent Fox and Wall Breaker. Each has their own look, their own battlefield and a longer shot than the last, from 80 to 120 metres, across sunny valleys, snowfields, a dust bowl, a storm and a night duel in a moonlit keep.\n\nREAD THE FIELD\nAim high and trust your eye. The wind pushes your arrows sideways and changes every duel, so watch the pennant by the wall and lead into it. The gold pillar shows where your last arrow fell.\n\nSCORE AND PRACTICE\nEvery duel you win scores points, with bonuses for headshots, quick wins and health left. Your five best runs go on the high score board. Practice mode gives you a target that never shoots back: pick the rival, arena, range and wind and work on your lob.\n\nFOUR KINDS OF ARROW\nStandard, Heavy, Swift and Double, swapped with one button.\n\nBUILT FOR THE HEADSET\n- Real draw-and-release archery with haptics\n- Optional aim line, arc and landing pillar\n- Arrow Cam follows your shot in\n- Comfortable: you stay on the rampart and nothing moves your view\n\nEight rivals. One rampart. How high can you score?", "short_description": "Medieval archery duels in VR. Lob arrows over the wall from the rampart, read the wind and outshoot eight rival archers, from a rookie with a straw hat to the legendary Wall Breaker. Practice any time, then chase the high score board."}]}, "developer_name": "Carrollton Interactive", "developer_privacy_policy_url": "https://carrolltoninteractive.com/game-privacy", "developer_terms_of_service_url": null, "publisher_name": "Carrollton Interactive", "support_website_url": null, "website_url": "https://www.carrolltoninteractive.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "3744040075834813"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1479821361873335"}}]}, "scheduled_offers": {"count": 3, "nodes": [{"status": "PUBLISHED", "id": "1100292392901769"}, {"status": "CANCELLED", "id": "1005978981815985"}, {"status": "PUBLISHED", "id": "1829535091832939"}]}, "baseline_offer": {"id": "1100292392901769"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1794021300, "status": "PUBLISHED", "id": "1100292392901769"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1532830266572444", "version": "1.1.0"}, "id": "4592135354388418", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename
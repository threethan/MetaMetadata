nVJyfQJvF4pW1ooX8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXjmMX1EK__iSBo4EI322VsrkNj-zPXATEkUDGXR--aWQ&oe=6B0F001F"}, {"file_name": "01_flyover_ritual.png", "id": "2196081024313006", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/908835905_2196081027646339_6901837106739368514_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hA_GNztTTacQ7kNvwEF1Ncc&_nc_oc=AdpZe1FGKBORKjDNyrczSiSfDQAbFnNMwh9n4WEb5A8ODRF3sfawirA8YpnO7S1THyw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQUppV45mVkIsHzyQKmEsqGLK1OxuvL-9XGAqmDuQI8qGA&oe=6B0F21E8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_landscape_2560x1440.png", "id": "1659218372450095", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/673666542_1659218375783428_497830178643999148_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KOHSHkEjurQQ7kNvwG0wkFr&_nc_oc=AdqVylGgo7_NcQV92T4ypLFRVB7J1LCsM-S8LxfSywluNcUQ2IGKWaP0ZZXF14GfQhM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQUhzs8bbWQ8FxtymUzFfMbc_cISj7hunawemDec9feVKw&oe=6B0EF1CE"}, "display_name": "Bow Duel VR", "keywords": ["archery", "medieval", "bow", "duel", "arrows"], "long_description": "Stand on the rampart. Across the field, an archer is already drawing on you.\n\nBOW DUEL VR is a one-on-one archery duel built for Quest. Hold the bow in your left hand, pull the string back with your right, and lob an arrow in a high arc over the wall. Your rival is doing the same to you. One headshot wins. So do two body hits.\n\nEIGHT RIVALS, EIGHT ARENAS\nRookie Rufus, Dusty Dan, Captain Mae, Sister Wren, The Baron, Sir Gallant, Silent Fox and Wall Breaker. Each has their own look and battlefield, with a longer shot than the last, across sunny valleys, snowfields, a dust bowl, a storm and a moonlit keep, all under real mountain ranges.\n\nREAD THE FIELD\nThe wind pushes your arrows sideways and changes every duel. Watch the pennant, check the wind readout over your bow hand and lead into it.\n\nSCORE AND PRACTICE\nWin duels for points, with bonuses for headshots, quick wins and health left. Hold a full draw steady for a PERFECT shot: extra damage and bonus points. Your five best runs go on the high score board, and higher scores unlock new arrow trails. Practice mode lets you pick rival, arena, range and wind.\n\nBUILT FOR THE HEADSET\n- Real draw-and-release archery with haptics\n- Four arrows: Standard, Heavy, Swift, Double\n- Optional aim line, arc and landing pillar\n- Arrow Cam follows your shot in\n- Comfortable: you stay put and nothing moves your view\n- No internet connection required\n\nEight rivals. One rampart. How high can you score?", "short_description": "Medieval archery duels in VR. Lob arrows over the wall from the rampart, read the wind and outshoot eight rival archers, from a rookie with a straw hat to the legendary Wall Breaker. Practice any time, then chase the high score board."}]}, "developer_name": "Carrollton Interactive", "developer_privacy_policy_url": "https://carrolltoninteractive.com/game-privacy", "developer_terms_of_service_url": null, "publisher_name": "Carrollton Interactive", "support_website_url": null, "website_url": "https://www.carrolltoninteractive.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "459781504968480"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id":
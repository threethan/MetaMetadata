ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQeF-x1BkzLNXkExIh8__fm9uHwpr4zArKlmmwDXuspsA&oe=6AFB2248"}, {"file_name": "04_round_card.png", "id": "1409010117968038", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/673733337_1409010121301371_7859355413607364036_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MHJFD0BMfToQ7kNvwEo5fgV&_nc_oc=Adqd8_khmI-XFrNBXuDfIKZkNR7NEe9qlEHXpp7eiHeciX-kcdEDPJBacaaL2FG-1Cg&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRb1ty4rTleDmbfJ9AuqX_1IqkBHH2IcC6JLLM5fVmHuw&oe=6AFB4D09"}, {"file_name": "01_flyover_ritual.png", "id": "3402249879958609", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/604331240_3402249883291942_670659271435594615_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8GK3ZFIqJM0Q7kNvwGv_lzj&_nc_oc=AdovOYI0IiHLzD-QG89UhgeLuRyJ6UILTJq9lmsj_vKE-7kHGk_S4ovT6PDjzkIrPcY&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRa0BoM9thKf3JMUUXqwZIlyIeyfTmE1Vc3s4k_j4YvHg&oe=6AFB2F40"}, {"file_name": "02_five_opponents.png", "id": "2675210559578345", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/673542498_2675210562911678_1045988896388668833_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fvRvzMW113IQ7kNvwECT0C4&_nc_oc=AdptTXlZ_Kc8HKun2ktb7oimqxEHRmrcLyCekOYIDshQZR8tJ8sLPOpghbIUdwgzra0&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRNDxE50Ml3v22Qb09eAOZ9BxQ6WfpiYWwPbu2dlX2hkg&oe=6AFB35D5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_landscape_2560x1440.png", "id": "1659218372450095", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/673666542_1659218375783428_497830178643999148_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8Xlv8WdAH-4Q7kNvwHEF68z&_nc_oc=AdpWUPsJQs_qkjn5Vo-X2Uwwjm81EdEwbZAJgB8UUmB-EB6bXcZJdS9EMyHriTfB8OY&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTrVP4_wHheUBmatMgb5mPpzvCzAQIieAr1YVe9tVHmfg&oe=6AFB2B4E"}, "display_name": "Bow Duel VR", "keywords": ["archery", "medieval", "bow", "duel", "arrows"], "long_description": "Stand on the rampart. Across the field, an archer is already drawing on you.\n\nBOW DUEL VR is a one-on-one archery duel built for Quest. Hold the bow in your left hand, pull the string back with your right, and lob an arrow in a high arc over the wall. Your rival is doing the same to you. One headshot wins. So do two body hits.\n\nEIGHT RIVALS, EIGHT ARENAS\nRookie Rufus, Dusty Dan, Captain Mae, Sister Wren, The Baron, Sir Gallant, Silent Fox and Wall Breaker. Each has their own look, their own battlefield and a longer shot than the last, from 80 to 120 metres, across sunny valleys, snowfields, a dust bowl, a storm and a night duel in a moonlit keep.\n\nREAD THE FIELD\nAim high and trust your eye. The wind pushes your arrows sideways and changes every duel, so watch the pennant by the wall and lead into it. The gold pillar shows where your last arrow fell.\n\nSCORE AND PRACTICE\nEvery duel you win scores points, with bonuses for headshots, quick wins and health left. Your five best runs go on the high score board. Practice mode gives you a target that never shoots back: pick the rival, arena, range and wind and work on your lob.\n\nFOUR KINDS OF ARROW\nStandard, Heavy, Swift and Double, swapped with one button.\n\nBUILT FOR THE HEADSET\n- Real draw-and-release archery with haptics\n- Optional aim line, arc and landing pillar\n- Arrow Cam follows your shot in\n- Comfortable: you stay on the rampart and nothing moves your view\n\nEight rivals. One rampart. How high can you score?", "short_description": "Medieval archery duels in VR. Lob arrows over the wall from the rampart, read the wind and outshoot eight rival archers, from a rookie with a straw hat to the legendary Wall Breaker. Practice any time, then chase the high score board."}]}, "developer_name": "Carrollton Interactive", "developer_priv
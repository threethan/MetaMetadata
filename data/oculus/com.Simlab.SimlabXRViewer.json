845", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982566_2110944835958844_2993478294347135239_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2VI5FFRNV6IQ7kNvwGaAHPh&_nc_oc=AdmVHl1MJoeHroZrOpFNgRgPy5IUtNrqzd_Pzod6AB8pT0-KAiGir6DUY7ilzLhmRxY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfyiDWIWT5QgsFWzD68pltdBvT_9XAZ3zeplbFOk_-_u1g&oe=69B80E05"}, "display_name": "SimLab XR Viewer", "keywords": [], "long_description": "Free SimLab XR Viewer, your go-to tool for experiencing and sharing VR content. Easily create immersive VR experiences with SimLab VR Studio and SimLab Composer. Utilize hand tracking for advanced training and leverage Quest MR capabilities to review models in your own environment. With support for various 3D formats and applications like SketchUp, SolidWorks, Revit, and Rhino, plus the ability to collaborate with clients and colleagues in real-time.", "short_description": "XR  Viewer designed for Quest users, featuring MR and hand tracking capabilities for immersive training. View and share 3D scenes on the go effortlessly."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.simlab-soft.com/SimlabArt/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "SimLab-Soft", "support_website_url": "https://www.simlab-soft.com/3d-products/help.aspx", "website_url": "https://www.simlab-soft.com/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ar", "zh_CN", "nl", "fr", "it", "ja", "fa", "cs", "ca", "de", "hi", "kk", "ko", "pl", "pt", "ru", "es", "sv", "tr", "uk", "uz
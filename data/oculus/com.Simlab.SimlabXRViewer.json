cking for advanced training and leverage Quest MR capabilities to review models in your own environment. With support for various 3D formats and applications like SketchUp, SolidWorks, Revit, and Rhino, plus the ability to collaborate with clients and colleagues in real-time.", "short_description": "XR  Viewer designed for Quest users, featuring MR and hand tracking capabilities for immersive training. View and share 3D scenes on the go effortlessly."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.simlab-soft.com/SimlabArt/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "SimLab-Soft", "support_website_url": "https://www.simlab-soft.com/3d-products/help.aspx", "website_url": "https://www.simlab-soft.com/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ar", "zh_CN", "nl", "fr", "it", "ja", "fa", "cs", "ca", "de", "hi", "kk", "ko", "pl", "pt", "ru", "es", "sv", "tr", "uk", "uz", "vi"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["ROOM_SCALE", "STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "7306827149386722"}}]}, "scheduled_offers": {"count": 0, "nodes": []}, "baseline_offer": null, "is_approved": true, "firstOffer": {"nodes": []}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "24597302559912579", "version": "15.0.7"}, "id": "1126707748665878", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_bi
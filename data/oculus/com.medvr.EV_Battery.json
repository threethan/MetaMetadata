ng?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LbSM854UVSAQ7kNvwE4FOzl&_nc_oc=Adq_IwUXob_3SCOOXI7MwATsg3RSpYL48eJmf3k_2Vp7r5olK3OCI7f3GsqphLF2pMM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAmkPKIsZ4LczQau0d9ATL6G3SltdslSUAfN-Lo4jdmNA&oe=6A4912B6"}, {"file_name": "11231.png", "id": "1172316770985546", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473391937_1172316774318879_3474312110145877516_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JK4Q_CDS7bwQ7kNvwHwnqj7&_nc_oc=Adrv-1pkV6Cp2pi7DcmfsDsueEbeSb1W20ZmHXhrAV01hqXUrYnj08lbPf7thNiQvgg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBEa2yaYaV7-c7GdLxeKSB2_Pp5_8pQfwZLGRoCB0gyrA&oe=6A4919D7"}, {"file_name": "112342.png", "id": "594322373406546", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473392046_594322376739879_7251634540480950597_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kDb5_k6Bn9cQ7kNvwEPA740&_nc_oc=AdqC60no8PUDphiNpqqaSgO5ixJge1j92Ot1RFsMWPx8U0ofibVpy7G76Mw2EgJzDbY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBsWM7YyILSWaifhYr4i2P7f24vTBSx75CsZ87JvcuYRw&oe=6A492C7B"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "EV Battery Packaging Technician", "keywords": ["EvBattery", "ImmerseLearn", "Training", "VR"], "long_description": "EV Battery Packaging Technician is an interactive VR training app designed to provide hands-on experience in the essential skills of EV battery packaging. This immersive simulation covers:\n\n- Exploring Common Battery Types: Understand different battery chemistries and applications.\n- Battery Pack Assembly: Learn proper techniques for assembling battery packs safely and efficiently.\n- Inspection Techniques \u2013 Master quality control procedures to ensure reliability and safety.\n\nTrain in a risk-free, realistic virtual environment that enhances skill retention and operational efficiency. Whether you're an aspiring technician or an industry professional, t
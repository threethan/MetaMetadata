_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V1rJuffOQ3IQ7kNvwE_f--z&_nc_oc=AdoFYwxCDL9w3HKxz33FU03O76yrGtPwmlHyPfxEnvvMxddCB6j747diyx6A9hq9qoc&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af93fRdNMFUAnJHHVwn0zYpgGe97TuP3c8jiCz_FZ-dyKA&oe=6A466FB6"}, {"file_name": "11231.png", "id": "1172316770985546", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/473391937_1172316774318879_3474312110145877516_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P4wu-v6pAKoQ7kNvwGa9NpW&_nc_oc=AdqijRY9dYvgpekoiZod2jJV0y79wMJ0yo5OBrJpQStQBkbMILmXAZ4UkW1tewqxYTg&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_A-C8GmOqMZNtngL8yYCMrFpMtwV8EdBozRu3KztQBDQ&oe=6A4676D7"}, {"file_name": "112342.png", "id": "594322373406546", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/473392046_594322376739879_7251634540480950597_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mbdNmdi-qXcQ7kNvwHrrByl&_nc_oc=Adol6XRvBVePrKH7A6meHjmYGUHnI--eV9fQNCaCdMk7u0dQIglIkCW0Wp_lpBzgo28&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-pirIRVUDo4pZ4HvYeYIS3lDYk9KBz96es62SeWZVlDQ&oe=6A46897B"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "EV Battery Packaging Technician", "keywords": ["EvBattery", "ImmerseLearn", "Training", "VR"], "long_description": "EV Battery Packaging Technician is an interactive VR training app designed to provide hands-on experience in the essential skills of EV battery packaging. This immersive simulation covers:\n\n- Exploring Common Battery Types: Understand different battery chemistries and applications.\n- Battery Pack Assembly: Learn proper techniques for assembling battery packs safely and efficiently.\n- Inspection Techniques \u2013 Master quality control procedures to ensure reliability and safety.\n\nTrain in a risk-free, realistic virtual environment that enhances skill retention and operational efficiency. Whether you're an aspiring technician or an industry professiona
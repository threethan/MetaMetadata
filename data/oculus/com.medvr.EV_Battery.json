ng?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LbSM854UVSAQ7kNvwFXIf0w&_nc_oc=AdqD4QvuDbqINFDuh9RmMUazh-BMWS_0seN5VyS4zpJaXNqVUWVd7Py7aabt1CWJ8gs&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8sAEomd9MzUP8ye__QcoCK-AQCwuHrAFb5PqVTKUK_Nw&oe=6A47C136"}, {"file_name": "11231.png", "id": "1172316770985546", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473391937_1172316774318879_3474312110145877516_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JK4Q_CDS7bwQ7kNvwHJ2kSR&_nc_oc=AdoZ6Kd2enJYMGmGNsU7Vuylsd4Pvl5zV-hNuJd98F8FDOpIArDITc1UMZ6zgHWYw6c&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9ToVeUwEAhXJY3h0tt2EPev42h00YPGBjxFK3BCraHwA&oe=6A47C857"}, {"file_name": "112342.png", "id": "594322373406546", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473392046_594322376739879_7251634540480950597_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kDb5_k6Bn9cQ7kNvwHL6INx&_nc_oc=Adr1Jm6FeWZREmKfolfq6YLJWaGDtmBs2U_6nP_6XcTtQipJHU4YBIJ309jtjjhvAgk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-yzQTQiTDDxRAYJSeMtfGz3F6IbRgMUrQIL0DbpHC4iQ&oe=6A47DAFB"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "EV Battery Packaging Technician", "keywords": ["EvBattery", "ImmerseLearn", "Training", "VR"], "long_description": "EV Battery Packaging Technician is an interactive VR training app designed to provide hands-on experience in the essential skills of EV battery packaging. This immersive simulation covers:\n\n- Exploring Common Battery Types: Understand different battery chemistries and applications.\n- Battery Pack Assembly: Learn proper techniques for assembling battery packs safely and efficiently.\n- Inspection Techniques \u2013 Master quality control procedures to ensure reliability and safety.\n\nTrain in a risk-free, realistic virtual environment that enhances skill retention and operational efficiency. Whether you're an aspiring technician or an industry professional, t
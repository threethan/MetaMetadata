xroMiXqYXSyPFUeTaQs&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-aRj9FBu34ttL2TUoy3XKfF3xRkfR8Hv5VMOS2veXsmQ&oe=6A3D3536"}, {"file_name": "11231.png", "id": "1172316770985546", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/473391937_1172316774318879_3474312110145877516_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=esW6iX8quy0Q7kNvwE9jSTa&_nc_oc=AdrpfWvN1Zt8HQTJQtGelZ54pibzuWyLJ01yDnAMEHvNycLhB-ZU3Zu6PL00-QgwKcQ&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_DBWojwp_e-tRh2or6s6Hm8g-UzSdQ5s09-qpBHarhjg&oe=6A3D3C57"}, {"file_name": "112342.png", "id": "594322373406546", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/473392046_594322376739879_7251634540480950597_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=39zL91K1-ZAQ7kNvwGMyZM5&_nc_oc=AdqG_STmvPhGY-8nKk9SeLSru5V_uK3ZkJvPfm8oxmHr0IN566T5IvWtJEHrq-ekosU&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9YZ4damdoTXHePn1G_KoLXkWpxgJ4uTVMv4_ZU6PdbVA&oe=6A3D4EFB"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "EV Battery Packaging Technician", "keywords": ["EvBattery", "ImmerseLearn", "Training", "VR"], "long_description": "EV Battery Packaging Technician is an interactive VR training app designed to provide hands-on experience in the essential skills of EV battery packaging. This immersive simulation covers:\n\n- Exploring Common Battery Types: Understand different battery chemistries and applications.\n- Battery Pack Assembly: Learn proper techniques for assembling battery packs safely and efficiently.\n- Inspection Techniques \u2013 Master quality control procedures to ensure reliability and safety.\n\nTrain in a risk-free, realistic virtual environment that enhances skill retention and operational efficiency. Whether you're an aspiring technician or an industry professional, this app helps you develop the expertise needed for EV battery handling and packaging. Start your journey today!", "short_desc
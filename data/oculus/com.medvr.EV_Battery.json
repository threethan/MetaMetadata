om/v/t64.5771-25/473391954_925879666366349_852381419423188183_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H8ChKR9L0ZIQ7kNvwHnI4MP&_nc_oc=AdppxEtv_5HGI8AJJo7jnIzeG23HZnQGbqARB39cQ82brflDRsa4SqgICam2ll0mM4I&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDxsWEsChJzQseSYWFevJ9iJ0fkmuBAlyrf27DFpAXQsw&oe=6A68A85A"}, {"file_name": "3131234.png", "id": "599093152929099", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473393887_599093156262432_7103614005559114762_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0BppmXBqsgEQ7kNvwFtAZn_&_nc_oc=AdruPlqfRkykDNcf1WSevyQfi5J_AM7MJ7N8vC9b3z3xCHnOBzOeUSlbx0s6k6-JwL4&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCXmheXXUBvqQKSK3YNj54omFrH1c8NCYEhgAQhdPtewQ&oe=6A68B6B6"}, {"file_name": "11231.png", "id": "1172316770985546", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473391937_1172316774318879_3474312110145877516_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a_LvybIj5OcQ7kNvwE6ocZ-&_nc_oc=AdpvaKELfpWVA2J6Q0UIshFJqhQ7ZCy0UqnTTceVG-xKNkki9xgXv3AoU-2HvGuloww&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDaTpgw6ljlq1goaUH7CXEkjtwB8IclP9jWWFz_YTlruA&oe=6A68BDD7"}, {"file_name": "112342.png", "id": "594322373406546", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473392046_594322376739879_7251634540480950597_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OR4ur9bCkSAQ7kNvwH4HFiN&_nc_oc=AdpnToboNtrHswcPkCTOGLZjnb9fcZT7ReIhBgp-l8SkXrB3eHm66FfCZYiDwW3uHmg&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBHv0siFZSTZKW9w3sUflxczOEMySmEX2lyigMK_4cOTw&oe=6A68983B"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "EV Battery Packaging Technician", "keywords": ["EvBattery", "ImmerseLearn", "Training", "VR"], "long_description": "EV Battery Packaging Technician is an interactive VR training app designed to provide hands-on experience in the essential skills of EV battery packaging. This immersive simulation covers:\n\n- Exploring Common Battery Types: Understand different battery chemistries and applications.\n- Battery Pack Assembly: Learn proper techniques for assembling battery packs safely and efficiently.\n- Inspection Techniques \u2013 Master quality control procedures to ensure reliability and safety.\n\nTrain in a risk-free, realistic virtual environment that enhances skill retention and operational efficiency. Whether you're an aspiring technician or an industry professional, this app helps you develop the expertise needed for EV battery handling and packaging. Start your journey today!", "short_description": "Gain hands-on experience in EV battery packaging with this immersive VR training app! EV Battery Packaging Technician covers essential skills, including exploring common battery types, battery pack assembly, and inspection techniques. Train in a realistic virtual environment to enhance safety, efficiency, and technical expertise in battery handling and packaging."}]}, "developer_name": null, "developer_privacy_policy_url": "https://immerselearn.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Immerselearn", "support_website_url": null, "website_url": "https://immerselearn.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}, {"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8758978387544547"}}]}, "scheduled_offers": {"count": 2, "n
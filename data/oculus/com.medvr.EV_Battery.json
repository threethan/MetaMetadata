om/v/t64.5771-25/473391954_925879666366349_852381419423188183_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-Yr1CRTmglQQ7kNvwHsOvgx&_nc_oc=AdqohCvwc7qbRURylle2-DZrfMEgVVeVI_9aE2OrQEcPlkzLGbYu7cRaxoteMpC18IY&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHER90ikGS6LLodL40JcNe4HuajdOAJ2aVBVTu8vDWNHQ&oe=6A73345A"}, {"file_name": "3131234.png", "id": "599093152929099", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473393887_599093156262432_7103614005559114762_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VO8Kgm5nybgQ7kNvwHtJ0qR&_nc_oc=AdpnOKFhmdwiA1dEqbyKSGhgon5SlmqoeNY_Ktifs3HaW_C7Sz6lxScpZ9oL0L5MRJ4&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFX1l7xGe2VFmMvYSmXXXN_HY_rBF_qvd2hCttxS69Cgg&oe=6A7342B6"}, {"file_name": "11231.png", "id": "1172316770985546", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473391937_1172316774318879_3474312110145877516_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MsuD2c4QfzUQ7kNvwEJOXjX&_nc_oc=AdrpDrgMiMd2Rg3Bt-nfnxLGgY5AUIEmmBS2sVgVztf3qd-Njr2eged52T1cslPCtc0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQErNd42s5YiadfUWbEeuVKiMBTweKT8ctZ2sRpbwtf3TQ&oe=6A7349D7"}, {"file_name": "112342.png", "id": "594322373406546", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473392046_594322376739879_7251634540480950597_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pQJIh0q7wscQ7kNvwEmzr1N&_nc_oc=AdpmbJEuCxez3ZgI9gemTzIhq3dmaASzkJ9ske1gcI61YEgWch-XCwFeLN9s5SooDvI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHq5-Agc60l8rIIlQX_cQlCDYBJirbPpIP9FPtgmZ6UTg&oe=6A73243B"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "EV Battery Packaging Technician", "keywords": ["EvBattery", "ImmerseLearn", "Training", "VR"], "long_description": "EV Battery Packaging Technician is an interactive VR training app designed to provide hands-on experience in the essential skills of EV battery packaging. This immersive simulation covers:\n\n- Exploring Common Battery Types: Understand different battery chemistries and applications.\n- Battery Pack Assembly: Learn proper techniques for assembling battery packs safely and efficiently.\n- Inspection Techniques \u2013 Master quality control procedures to ensure reliability and safety.\n\nTrain in a risk-free, realistic virtual environment that enhances skill retention and operational efficiency. Whether you're an aspiring technician or an industry professional, this app helps you develop the expertise needed for EV battery handling and packaging. Start your journey today!", "short_description": "Gain hands-on experience in EV battery packaging with this immersive VR training app! EV Battery Packaging Technician covers essential skills, including exploring common battery types, battery pack assembly, and inspection techniques. Train in a realistic virtual environment to enhance safety, efficiency, and technical expertise in battery handling and packaging."}]}, "developer_name": null, "developer_privacy_policy_url": "https://immerselearn.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Immerselearn", "support_website_url": null, "website_url": "https://immerselearn.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}, {"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8758978387544547"}}]}, "scheduled_offers": {"count": 2, "n
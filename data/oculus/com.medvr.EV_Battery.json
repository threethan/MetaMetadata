BDyQaDf1C6loU-aG2Aw&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-NfXlFupRLMHBPtmrk6torYtd6mTIPWdAiFEZ9hdB57A&oe=6A427B36"}, {"file_name": "11231.png", "id": "1172316770985546", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391937_1172316774318879_3474312110145877516_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VxYfIY-flfwQ7kNvwH3Yxn9&_nc_oc=AdrQf_BBMBGpqwIvIvBDoN6TsKQntCY4NiKTc8ZhuZLAt6i8xu0Kbpa9k44hRvu5RbQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_l_02CEXwaAx__3TpMHz0UfhrC3X6WZ9xV2Dv2DZ4a5w&oe=6A428257"}, {"file_name": "112342.png", "id": "594322373406546", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473392046_594322376739879_7251634540480950597_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Rs0HGhSgbJMQ7kNvwFiL5-A&_nc_oc=AdoafeDlR7wsBwl4Du-KNTsoNffReOg3X_Xlcq-9aoew__EJqIqpa1dNw-BRKogKrM8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af96vGoqyXfBzo09CIM86Jv0mELUks_aH8HnEDy7E7QBzg&oe=6A4294FB"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "EV Battery Packaging Technician", "keywords": ["EvBattery", "ImmerseLearn", "Training", "VR"], "long_description": "EV Battery Packaging Technician is an interactive VR training app designed to provide hands-on experience in the essential skills of EV battery packaging. This immersive simulation covers:\n\n- Exploring Common Battery Types: Understand different battery chemistries and applications.\n- Battery Pack Assembly: Learn proper techniques for assembling battery packs safely and efficiently.\n- Inspection Techniques \u2013 Master quality control procedures to ensure reliability and safety.\n\nTrain in a risk-free, realistic virtual environment that enhances skill retention and operational efficiency. Whether you're an aspiring technician or an industry professional, this app helps you develop the expertise needed for EV battery handling and packaging. Start your journey today!", "short_desc
6T0RWg&oe=6A3A9236"}, {"file_name": "11231.png", "id": "1172316770985546", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391937_1172316774318879_3474312110145877516_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RgRmuN6Rpv0Q7kNvwHd_Gyj&_nc_oc=AdqAlibMMtEp872pL13wcm-e31PFJ88iIwB7lXAeED8Qp4cut6v9CirzDJJudb22IA8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_5TDhkHyyQiAwUCRr6yI2hxTNfEfelzbZ76hSc8035ug&oe=6A3A9957"}, {"file_name": "112342.png", "id": "594322373406546", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473392046_594322376739879_7251634540480950597_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J47knAToyPAQ7kNvwGn0TV8&_nc_oc=AdrOunm3dDFa6o617fvroXpsk9Qbkim6VdMit3OOWjN0qsP3-zDzcwbi9evKiS9vjh4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af90shNwdVvIPl870GxArChE_YHhL-C00tOH57M-K59mfw&oe=6A3AABFB"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "EV Battery Packaging Technician", "keywords": ["EvBattery", "ImmerseLearn", "Training", "VR"], "long_description": "EV Battery Packaging Technician is an interactive VR training app designed to provide hands-on experience in the essential skills of EV battery packaging. This immersive simulation covers:\n\n- Exploring Common Battery Types: Understand different battery chemistries and applications.\n- Battery Pack Assembly: Learn proper techniques for assembling battery packs safely and efficiently.\n- Inspection Techniques \u2013 Master quality control procedures to ensure reliability and safety.\n\nTrain in a risk-free, realistic virtual environment that enhances skill retention and operational efficiency. Whether you're an aspiring technician or an industry professional, this app helps you develop the expertise needed for EV battery handling and packaging. Start your journey today!", "short_description": "Gain hands-on experience in EV battery packaging with this immersive VR training app! EV Battery Packaging Technic
_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TNnbKG4XZXEQ7kNvwE1JUpU&_nc_oc=Adq3K54JIFFVfKDfFH0r0i_eehx9v7KGAhHZfC94-XBwsgb_h3t5onWqxT1nYGAXUok&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af74KSO7FmRBfCoLVEinQc3Z8ullD10Yl7YEYAyxckyh1A&oe=69FF3EB6"}, {"file_name": "11231.png", "id": "1172316770985546", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391937_1172316774318879_3474312110145877516_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wD1OfCtJJKsQ7kNvwFzcmN0&_nc_oc=AdrNRFIniDQz6mNWhYSu-loSUmTVN5YHZ_92Hgm5bozWY_3YwFzkHx6xy-XzR8gzr7Q&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6Zi2vLW-fVpcq-RCPl2r8PBY7ts2JYvH3U4OmGj5lEAA&oe=69FF45D7"}, {"file_name": "112342.png", "id": "594322373406546", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473392046_594322376739879_7251634540480950597_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5Vd19v9fQCEQ7kNvwFCPdKO&_nc_oc=AdrC13BNg10TCwoAymOx11F2G_8MyZI8ZfalnCnvr11MjFpT3A2lVe4oKcaXluwrc84&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4fgVhUll3Xh56LApv6kay1tEc5mW_mgwAPgo_E_d-exg&oe=69FF203B"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "EV Battery Packaging Technician", "keywords": ["EvBattery", "ImmerseLearn", "Training", "VR"], "long_description": "EV Battery Packaging Technician is an interactive VR training app designed to provide hands-on experience in the essential skills of EV battery packaging. This immersive simulation covers:\n\n- Exploring Common Battery Types: Understand different battery chemistries and applications.\n- Battery Pack Assembly: Learn proper techniques for assembling battery packs safely and efficiently.\n- Inspection Techniques \u2013 Master quality control procedures to ensure reliability and safety.\n\nTrain in a risk-free, realistic virtual environment that enhances skill retention and operational efficiency. Whether you're an aspiring technician or an industry professional, this app helps you develop the expertise needed for EV battery handling and packaging. Start your journey today!", "short_description": "Gain hands-on experience in EV battery packaging with this immersive VR training app! EV Battery Packaging Technician covers essential skills, including exploring common battery types, battery pack assembly, and inspection techniques. Train in a realistic virtual environment to enhance safety, efficiency, and technical expertise in battery handling and packaging."}]}, "developer_name": null, "developer_privacy_policy_url": "https://immerselearn.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Immerselearn", "support_website_url": null, "website_url": "https://immerselearn.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}, {"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8758978387544547"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PUBLISHED", "id": "3528974000743943"}, {"status": "PUBLISHED", "id": "534448032985471"}]}, "baseline_offer": {"id": "3528974000743943"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1747141320, "status": "PUBLISHED", "id": "3528974000743943"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "24622727354076396", "version": "2.3"}, "id": "487997454071281", "channel_name": "LIVE"}]}, "i
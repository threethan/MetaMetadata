ng?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V1rJuffOQ3IQ7kNvwEiX_sj&_nc_oc=Adom7nTejGVHrPKI7sI7sWMg4BaDPKlHVXKlStdPa_dXgrqsjEUN8p6xZikAsEridrQ&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9FBIegFDyWPv8ricWS7o_0qLM_IQqxDGG0ObeK2tyEng&oe=6A451E36"}, {"file_name": "11231.png", "id": "1172316770985546", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473391937_1172316774318879_3474312110145877516_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P4wu-v6pAKoQ7kNvwEbJz-F&_nc_oc=Adq8GuuMPBNL4zZhXzoMQlEMPQarKaOwQNHdAHT5IRjs0lX0T3ConNTdg3LatbOgOvg&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-TtMofhW8RBJ281T9uH0PwNImCzcQEacdRb3tPPFOofA&oe=6A452557"}, {"file_name": "112342.png", "id": "594322373406546", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473392046_594322376739879_7251634540480950597_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mbdNmdi-qXcQ7kNvwHnKDwk&_nc_oc=AdqJ9uiYFHE-wG4TQD7cRqxXg2bOLqoQzCN4g-iqWP96SEXFojHbAy7dSRCM8dxo-Bw&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9XhxMryHKDUUXXvnC4Qq6Sk3jq28t_rQhBI8Mm0SJyyA&oe=6A4537FB"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "EV Battery Packaging Technician", "keywords": ["EvBattery", "ImmerseLearn", "Training", "VR"], "long_description": "EV Battery Packaging Technician is an interactive VR training app designed to provide hands-on experience in the essential skills of EV battery packaging. This immersive simulation covers:\n\n- Exploring Common Battery Types: Understand different battery chemistries and applications.\n- Battery Pack Assembly: Learn proper techniques for assembling battery packs safely and efficiently.\n- Inspection Techniques \u2013 Master quality control procedures to ensure reliability and safety.\n\nTrain in a risk-free, realistic virtual environment that enhances skill retention and operational efficiency. Whether you're an aspiring technician or an industry professional, t
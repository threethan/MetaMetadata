id=6e7a0a&_nc_ohc=DtC2PcUyt8YQ7kNvwE0pZv4&_nc_oc=AdqCIiABlMT3Y8I8Ui5bzV7uKlEeF-6qJqYHETawlSgWkq22YDnsnk2HcHQSAkXf07U&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQUOwlc0kES4fjw66lwSHGeQzdoy9ZDYGiB4j4IK_o1jBg&oe=6B105ABF"}, {"file_name": "Screenshots_5.png", "id": "1133447175215920", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473392031_1133447178549253_7351213317827101363_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gygYX9r79egQ7kNvwFXeifi&_nc_oc=AdqLAON4_oT4ww6GwRlMq2rUAizBqSVQRME0x9OnDH6ZhOv_rgHIcfpjReW3ycCxSC4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQX9vSFYtlzFQO3RQ38HSNOzXQ7Y9_ZudeB0D9UDsyxxlA&oe=6B10522A"}, {"file_name": "Screenshots_3.png", "id": "2517672101909518", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391964_2517672105242851_8466703009408710163_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Fu7en_qDdg4Q7kNvwEMAV3w&_nc_oc=AdryDcwap63Xt7AbXtIsW_BJ0PEemfKwA9ATNA0YL-BeesWJ9b63w3hTEJFlMn6TXC0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWKRJgPOEKPU9-i-iJX5bqDkFt-AW7cqmQp9P7R2L_X9Q&oe=6B10653B"}, {"file_name": "Screenshots_1.png", "id": "1485037125794654", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473391860_1485037129127987_4164880090513945374_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9ZNVGnQxZd8Q7kNvwEOwh1i&_nc_oc=Adoct1Q21SYHXwQ5D54bMp3p4riL39JRy0yVrrAqGaqLRhL_UqJ8m3UGjX5JCUtr7BY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQUZ37hJ9G8SS4LnNaDL3VDa5EYu4c3F3z5IKiau9S2vYQ&oe=6B103DF2"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Fire Fighting: Bedroom", "keywords": ["fire", "training", "learning", "extinguishers", "Prevention"], "long_description": "Fire Fighting: Bedroom is an immersive VR training game designed to teach players how to respond to office fire emergencies. Set in a realistic office environment, players take on the role of a firefighter tasked with identifying fire hazards, selecting the right firefighting tools, and extinguishing fires safely and efficiently. The game combines interactive gameplay with practical training, focusing on the use of water extinguishers, CO2 extinguishers, dry powder extinguishers, and fire nozzles.\nGameplay Overview: Players start in a virtual office where a fire breaks out\u2014caused by electrical faults, paper clutter, or chemical spills. The objective is to assess the fire type (e.g., Class A for paper/wood, Class B for flammable liquids, or Class E for electrical fires) and choose the appropriate extinguishing tool. Using VR controllers, players grab tools from a nearby safety station and operate them to put out the fire while racing against time. Visual cues, like smoke color and fire intensity, guide decision-making. Mistakes, such as using water on an electrical fire, trigger feedback and a chance to retry, reinforcing learning.", "short_description": "Fire Fighting: Bedroom is an immersive VR training game designed to teach players how to respond to office fire emergencies. Set in a realistic office environment, players take on the role of a firefighter task with identifying fire hazards, selecting the right firefighting tools, and extinguishing fires safely and efficiently. The game  focusing on the use of water extinguishers, CO2 extinguishers, dry powder extinguishers, and fire nozzles\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://vrtech.com.vn/PrimacyGameVR/PRIVACY_POLICY.htm", "developer_terms_of_service_url": null, "publisher_name": "VRtech Studio", "support_website_url": null, "website_url": "https://vrtech.com.vn/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [],
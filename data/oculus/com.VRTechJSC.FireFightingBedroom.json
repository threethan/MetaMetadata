id=6e7a0a&_nc_ohc=5oHYM3XXR8wQ7kNvwEHScL8&_nc_oc=AdocXPVKYySUS1rNopz0Gs2CIGtLwGn2HmhoIe0SY3DYHS1uTNwdp-DZ4TOP0b1KnPs&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTqVxPL_1YM9iD3FO_FXfGlxiWUWO8Rw4TEjGPAbWfROg&oe=6B0B14BF"}, {"file_name": "Screenshots_5.png", "id": "1133447175215920", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/473392031_1133447178549253_7351213317827101363_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z-7T433cItoQ7kNvwEwKLFr&_nc_oc=AdoTQlrk8CD2wSgH5WO3EfWVEqXqz5d7NFJOQRBWBJbqYcP4cO6TEJepBUwI0swO66M&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTAj4e7x9rydV5Icht-1QcVnvAPP1_aKxKlUPMWeK6YrQ&oe=6B0B446A"}, {"file_name": "Screenshots_3.png", "id": "2517672101909518", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/473391964_2517672105242851_8466703009408710163_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ggu3Ned4L5AQ7kNvwEnp03o&_nc_oc=Adqth8t4R3zuPowL0ITLiJgAVT1lyTjzd4NWUN-ksf8F1zqbOdnUb9HKJ0GAJjwfhPg&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQgixitlRhFtXdj--SH5Z7_q0g7qO7jJ9Glqmd-4OSYKA&oe=6B0B1F3B"}, {"file_name": "Screenshots_1.png", "id": "1485037125794654", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/473391860_1485037129127987_4164880090513945374_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BaOPwmzf0eUQ7kNvwG8MtBM&_nc_oc=Adr_pEOz-dM4eAGgkVvUaF9CDUHGtYO7BIdtRtBln6evicWrP2xYXaOSr_eOqBJqVJs&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQJboEFp7YKDk3OhC9nbua0P9FMxvLhJIXHwzSqDD9azA&oe=6B0B3032"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Fire Fighting: Bedroom", "keywords": ["fire", "training", "learning", "extinguishers", "Prevention"], "long_description": "Fire Fighting: Bedroom is an immersive VR training game designed to teach players how to respond to office fire emergencies. Set in a realistic office environment, players take on the role of a firefighter tasked with identifying fire hazards, selecting the right firefighting tools, and extinguishing fires safely and efficiently. The game combines interactive gameplay with practical training, focusing on the use of water extinguishers, CO2 extinguishers, dry powder extinguishers, and fire nozzles.\nGameplay Overview: Players start in a virtual office where a fire breaks out\u2014caused by electrical faults, paper clutter, or chemical spills. The objective is to assess the fire type (e.g., Class A for paper/wood, Class B for flammable liquids, or Class E for electrical fires) and choose the appropriate extinguishing tool. Using VR controllers, players grab tools from a nearby safety station and operate them to put out the fire while racing against time. Visual cues, like smoke color and fire intensity, guide decision-making. Mistakes, such as using water on an electrical fire, trigger feedback and a chance to retry, reinforcing learning.", "short_description": "Fire Fighting: Bedroom is an immersive VR training game designed to teach players how to respond to office fire emergencies. Set in a realistic office environment, players take on the role of a firefighter task with identifying fire hazards, selecting the right firefighting tools, and extinguishing fires safely and efficiently. The game  focusing on the use of water extinguishers, CO2 extinguishers, dry powder extinguishers, and fire nozzles\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://vrtech.com.vn/PrimacyGameVR/PRIVACY_POLICY.htm", "developer_terms_of_service_url": null, "publisher_name": "VRtech Studio", "support_website_url": null, "website_url": "https://vrtech.com.vn/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [],
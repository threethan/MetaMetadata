_zcOd00d-_ceP9WSshBQiQPOjDvKRyfIEMqc8g&oe=6A314C6A"}, {"file_name": "Screenshots_3.png", "id": "2517672101909518", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473391964_2517672105242851_8466703009408710163_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vJNO_WvIvdAQ7kNvwHSb-rp&_nc_oc=AdqgxxN7dlJDZ_-Et-_mmwDSUjbFElVDCQ0Qe0QlIJXnK0QU-vb2GSCb5tYnNee7uSw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9WjCtfrCVailh9_XYBkTLM_yBzVIWaONCQn5nB2QiHCA&oe=6A315F7B"}, {"file_name": "Screenshots_1.png", "id": "1485037125794654", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473391860_1485037129127987_4164880090513945374_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5XJwR_chRdYQ7kNvwEwoVIE&_nc_oc=AdoS2PCXtNSTBv8_VdF5421w3Zuxmb6A83eiOls0lsL6o0kUmO95rao24QdWHwC_UNo&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9KwwmAbrR9_CzPCIv1rI6dF9oUgc-szSc0Qlz4lYXpUg&oe=6A317072"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Fire Fighting: Bedroom", "keywords": ["fire", "training", "learning", "extinguishers", "Prevention"], "long_description": "Fire Fighting: Bedroom is an immersive VR training game designed to teach players how to respond to office fire emergencies. Set in a realistic office environment, players take on the role of a firefighter tasked with identifying fire hazards, selecting the right firefighting tools, and extinguishing fires safely and efficiently. The game combines interactive gameplay with practical training, focusing on the use of water extinguishers, CO2 extinguishers, dry powder extinguishers, and fire nozzles.\nGameplay Overview: Players start in a virtual office where a fire breaks out\u2014caused by electrical faults, paper clutter, or chemical spills. The objective is to assess the fire type (e.g., Class A for paper/wood, Class B for flammable liquids, or Class E for electrical fires) and choose the appropriate extinguishing tool. Using VR controllers, players grab tools from a nearby safety station and operate them to put out the fire while racing against time. Visual cues, like smoke color and fire intensity, guide decision-making. Mistakes, such as using water on an electrical fire, trigger feedback and a chance to retry, reinforcing learning.", "short_description": "Fire Fighting: Bedroom is an immersive VR training game designed to teach players how to respond to office fire emergencies. Set in a realistic office environment, players take on the role of a firefighter task with identifying fire hazards, selecting the right firefighting tools, and extinguishing fires safely and efficiently. The game  focusing on the use of water extinguishers, CO2 extinguishers, dry powder extinguishers, and fire nozzles\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://vrtech.com.vn/PrimacyGameVR/PRIVACY_POLICY.htm", "developer_terms_of_service_url": null, "publisher_name": "VRtech Studio", "support_website_url": null, "website_url": "https://vrtech.com.vn/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9301291533313999"}}]}, "scheduled_offers": {"count": 8, "nodes": [{"status": "PUBLISHED", "id": "1709234803443489"}, {"status": "PUBLISHED", "id": "3889641021341600"}, {"status": "PUBLISHED", "id": "817822824660780"}, {"status": "PUBLISHED", "id": "2097561181002949"}, {"status": "PUBLISHED", "id": "13300373758117
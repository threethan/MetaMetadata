hxnAefy8t4BKHCuGg26yxEZqK3Bl5q4DiK841ajgS9w9qR5yQ2UVjjjnPcTo&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIN_RkUB3x4Cp15fSyUaWi62DZeGP9KtIDmaC5rYDkzpw&oe=6AAE8AEA"}, {"file_name": "Screenshots_3.png", "id": "2517672101909518", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/473391964_2517672105242851_8466703009408710163_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U9_witp3aWYQ7kNvwFpLbqS&_nc_oc=AdrgpK6xwIUuVPx-2U-W8ZvKzTXVMM_D8WmuEzl5XbBU86VVbxkvmYiUX34ny4DvX1w&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLPMekLvs2EihiO9_jmwV0HuSjc0jSju_lLMsfPzqvwTQ&oe=6AAE9DFB"}, {"file_name": "Screenshots_1.png", "id": "1485037125794654", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/473391860_1485037129127987_4164880090513945374_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JW41buG4-WsQ7kNvwGMEjPD&_nc_oc=AdornRg4IFjUpOJvmTGtwIF6qTXW3hl9CnGR8CsebKDx5zlgLLrsM08GPR02-E_WxKY&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI1W1iappujJk-LUIqLRFxoyrE2y2cl59_-E2HN2le_AA&oe=6AAEAEF2"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Fire Fighting: Bedroom", "keywords": ["fire", "training", "learning", "extinguishers", "Prevention"], "long_description": "Fire Fighting: Bedroom is an immersive VR training game designed to teach players how to respond to office fire emergencies. Set in a realistic office environment, players take on the role of a firefighter tasked with identifying fire hazards, selecting the right firefighting tools, and extinguishing fires safely and efficiently. The game combines interactive gameplay with practical training, focusing on the use of water extinguishers, CO2 extinguishers, dry powder extinguishers, and fire nozzles.\nGameplay Overview: Players start in a virtual office where a fire breaks out\u2014caused by electrical faults, paper clutter, or chemical spills. The objective is to assess the fire type (e.g., Class A for paper/wood, Class B for flammable liquids, or Class E for electrical fires) and choose the appropriate extinguishing tool. Using VR controllers, players grab tools from a nearby safety station and operate them to put out the fire while racing against time. Visual cues, like smoke color and fire intensity, guide decision-making. Mistakes, such as using water on an electrical fire, trigger feedback and a chance to retry, reinforcing learning.", "short_description": "Fire Fighting: Bedroom is an immersive VR training game designed to teach players how to respond to office fire emergencies. Set in a realistic office environment, players take on the role of a firefighter task with identifying fire hazards, selecting the right firefighting tools, and extinguishing fires safely and efficiently. The game  focusing on the use of water extinguishers, CO2 extinguishers, dry powder extinguishers, and fire nozzles\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://vrtech.com.vn/PrimacyGameVR/PRIVACY_POLICY.htm", "developer_terms_of_service_url": null, "publisher_name": "VRtech Studio", "support_website_url": null, "website_url": "https://vrtech.com.vn/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9301291533313999"}}]}, "scheduled_offers": {"count": 11, "nodes": [{"status": "PUBLISHED", "id": "2914947535527599"}, {"status": "PUBLISHED", "id": "1570434351240550"}, {"status":
ntent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afw4f6PBa4AqMBXHuVzjx6X_plTiJF_KmjVxZ4gwjoezsw&oe=69D10CC3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "38982539_988181632242157_8491152765788296878_n.png", "id": "1408342770117293", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75282163_1408342776783959_4017049507651342333_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hyZ6p5FkjG8Q7kNvwEuhftk&_nc_oc=AdprPOQ_Jt7E1cpmxpU4rrV0pPhttjL6BOaVwE_IUF3I7KFJh4v6wUhw-JatyOU8ESg&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afx5kqIRZpjjnxseCGBvmcSFTaD6kXZGIiJI020go9IDHg&oe=69D10B11"}, "display_name": "MarineVerse Kayaking", "keywords": ["kayak", "fitness", "nature", "water", "outdoor"], "long_description": "Explore, Connect, and Unwind with MarineVerse Kayaking.\n\nTHIS IS AN EARLY-ACCESS VERSION. Please join the MarineVerse Discord to share your feedback and ideas.\n\nStep into a virtual kayak and glide effortlessly through captivating landscapes. Whether you're here for the serene views, the physical thrill, or some friendly competition, MarineVerse Kayaking offers something for every type of adventurer.\n\nKey Features\n- Stunning Environments: Discover picturesque locales that offer a perfect backdrop for your paddling journey. ( Currently just 2 locations, but more are cominig )\n- Time trial racing ( For now 3, more coming )\n- Multiplayer ( Initial version )\n\nAbout Us\nMarineVerse is an indie team based in Australia. We're the folks behind MarineVerse Cup, and we\u2019re driven by one mission: to bring the joy and challenge of water sports to everyone through virtual reality.", "short_description": "Step into your virtual kayak and glide through stunning waterscapes. \n\nMarineVerse Kayaking offers an approachable yet authentic kayaking adventure. \n\nChoose between exploration mode or competitive racing with friends. \n\nFeel the freedom!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.marineverse.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "MarineVerse", "support_website_url": null, "website_url": "https://www.marineverse.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "673385183287495"}, {"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "MULTI_USER"], "id": "9277648922330527"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974608_2353284981526010_5848968616476688413_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wgj0a9-ybE0Q7kNvwHUnIVK&_nc_oc=Adoshvdcr43BgEyjbPwYFBqmk-6wMlpB5mVCG6yg1NLyjGWk_JQc8ErzOdht6NwL8J0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afw863IaKFVXx6kPlSE2syNTeymqx49ObrkhJtqc851KyA&oe=69D11625"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "MarineVerse Kayaking", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Simulation", "id": "331529188132278"}, {"topic_name": "Racing", "id": "673385183287495"}, {"topic_name": "Sports", "id": "2776542286000603"}], "release_date": 1700658000, "lastRevision": {"nodes": [{"id": "6511868655575248", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", 
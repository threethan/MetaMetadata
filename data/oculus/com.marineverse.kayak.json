!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.marineverse.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "MarineVerse", "support_website_url": null, "website_url": "https://www.marineverse.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "673385183287495"}, {"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "6511868645575249"}}]}, "scheduled_offers": {"count": 13, "nodes": [{"status": "PUBLISHED", "id": "1896398081544208"}, {"status": "PUBLISHED", "id": "1287965116237415"}, {"status": "PUBLISHED", "id": "1820644985316701"}, {"status": "PUBLISHED", "id": "3050870248435227"}, {"status": "PUBLISHED", "id": "1391882279311642"}, {"status": "PUBLISHED", "id": "4184976685108591"}, {"status": "PUBLISHED", "id": "1713510765963937"}, {"status": "PUBLISHED", "id": "2054371851715206"}, {"status": "PUBLISHED", "id": "1186574729147126"}, {"status": "PUBLISHED", "id": "3505043833133114"}, {"status": "PUBLISHED", "id": "2068843493560927"}, {"status": "PUBLISHED", "id": "1029378821957059"}, {"status": "PUBLISHED", "id": "654932429948011"}]}, "baseline_offer": {"id": "1186574729147126"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1797271200, "status": "PUBLISHED", "id": "1896398081544208"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "28
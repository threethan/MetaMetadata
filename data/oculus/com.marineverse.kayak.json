uluscdn.com&_nc_ss=7f20f&oh=00_AQTz9Z9ffQ-YNGorxK2aBVCPazA_iPnCsfSgsg8_Acdtfw&oe=6B01C011"}, {"file_name": "5.png", "id": "337064885414098", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974614_337064888747431_5578403731446097512_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h7UfuyLgx_sQ7kNvwG77F2B&_nc_oc=Adqe2L98grDiEAbKyxRC00Aw1zPrvN9g2atIXt0Fxmu2gmu3hpm73AQ-sfLKZP8Pods&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQtUHR6p76dyGCAVj7wn8O9rptveiMA8A9aCmUN0IjCkg&oe=6B01CF83"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "38982539_988181632242157_8491152765788296878_n.png", "id": "1408342770117293", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75282163_1408342776783959_4017049507651342333_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_Bwc7hB5QGEQ7kNvwHZUsjr&_nc_oc=Adr3cSv-N0pDcg-rlxFz-N1Z9vQ35xPiOVAg9eaTYF670J2UdsBq5x6JIiBwLrYe7jI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRgt9Vy5bL6_TztLocLrB9LSN1gWgN8OKTD_m5WyGQTWw&oe=6B01CDD1"}, "display_name": "MarineVerse Kayaking", "keywords": ["kayak", "fitness", "nature", "water", "outdoor"], "long_description": "Explore, Connect, and Unwind with MarineVerse Kayaking.\n\nTHIS IS AN EARLY-ACCESS VERSION. Please join the MarineVerse Discord to share your feedback and ideas.\n\nStep into a virtual kayak and glide effortlessly through captivating landscapes. Whether you're here for the serene views, the physical thrill, or some friendly competition, MarineVerse Kayaking offers something for every type of adventurer.\n\nKey Features\n- Stunning Environments: Discover picturesque locales that offer a perfect backdrop for your paddling journey. ( Currently just 2 locations, but more are cominig )\n- Time trial racing ( For now 3, more coming )\n- Multiplayer ( Initial version )\n\nAbout Us\nMarineVerse is an indie team based in Australia. We're the folks behind MarineVerse Cup, and we\u2019re driven by one mission: to bring the joy and challenge of water sports to everyone through virtual reality.", "short_description": "Step into your virtual kayak and glide through stunning waterscapes. \n\nMarineVerse Kayaking offers an approachable yet authentic kayaking adventure. \n\nChoose between exploration mode or competitive racing with friends. \n\nFeel the freedom!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.marineverse.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "MarineVerse", "support_website_url": null, "website_url": "https://www.marineverse.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "673385183287495"}, {"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "MULTI_USER"], "id": "9277648922330527"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974608_2353284981526010_5848968616476688413_n.png?stp=dst-png_s360x360&_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oyMdsEZaHCEQ7kNvwGkaFMM&_nc_oc=AdoEjw_DKTiN9PL85tAlUmOTy5F0H5UfKoCKkR1_el2FexAazJnCptk2bjq5WbsZptY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQY4fv2n6WjO00HqiOmqcvBBPuUvw08JW3jJ7OZEQHRAQ&oe=6B01D8E5"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "MarineVerse Kayaking", 
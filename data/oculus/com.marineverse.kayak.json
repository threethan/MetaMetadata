cketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uja2F3eZZisQ7kNvwEnnSIp&_nc_oc=AdpszFSfedRo1ZBYrOKoCEDB0wXzl5VEw-ew4uQzGQ2J3XZjOCW0chFJ1McLbVy1hd8&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTqnbBW5N4Gb6ogVOMlnkP4fxM8NJsDrRciNVwm2DDs4g&oe=6AFC7A11"}, {"file_name": "5.png", "id": "337064885414098", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974614_337064888747431_5578403731446097512_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_D_GnhScK3gQ7kNvwG-Kgx3&_nc_oc=AdpDUZPMhN9D4aQz8ZUbdrJC3i7z7SU1z8E7GIzmPMOWtPA2ZPW4lT6pyN_q6s1LCQY&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRmkYYVfJf1KhC5D1P93C5ARSP3ETHhKyqW5zLbdv-O3Q&oe=6AFC8983"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "MarineVerse Kayaking", "keywords": [], "long_description": "Explore, Connect, and Unwind with MarineVerse Kayaking.\n\nTHIS IS AN EARLY-ACCESS VERSION. Please join the MarineVerse Discord to share your feedback and ideas.\n\nStep into a virtual kayak and glide effortlessly through captivating landscapes. Whether you're here for the serene views, the physical thrill, or some friendly competition, MarineVerse Kayaking offers something for every type of adventurer.\n\nKey Features\n- Stunning Environments: Discover picturesque locales that offer a perfect backdrop for your paddling journey. ( Currently just 1 location, but more are cominig )\n- Time trial racing ( coming soon )\n- Multiplayer ( coming soon )\n\nAbout Us\nMarineVerse is an indie team based in Australia. We're the folks behind MarineVerse Cup, and we\u2019re driven by one mission: to bring the joy and challenge of water sports to everyone through virtual reality.", "short_description": "Step into your virtual kayak and glide through stunning waterscapes. \n\nMarineVerse Kayaking offers an approachable yet authentic kayaking adventure. \n\nChoose between exploration mode or competitive racing with friends. \n\nFeel the freedom!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.marineverse.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "MarineVerse", "support_website_url": null, "website_url": "https://www.marineverse.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "673385183287495"}, {"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "6511868645575249"}}]}, "scheduled_offers": {"count": 13, "nodes": [{"status": "PUBLISHED", "id": "1896398081544208"}, {"status": "PUBLISHED", "id": "1287965116237415"}, {"status": "PUBLISHED", "id": "1820644985316701"}, {"status": "PUBLISHED", "id": "3050870248435227"}, {"status": "PUBLISHED", "id": "1391882279311642"}, {"status": "PUBLISHED", "id": "4184976685108591"}, {"status": "PUBLISHED", "id": "1713510765963937"}, {"status": "PUBLISHED", "id": "2054371851715206"}, {"status": "PUBLISHED", "id": "1186574729147126"}, {"status": "PUBLISHED", "id": "3505043833133114"}, {"status": "PUBLISHED", "id": "2068843493560927"}, {"status": "PUBLISHED", "id": "1029378821957059"}, {"status": "PUBLISHED", "id": "654932429948011"}]}, "baseline_offer": {"id": "1186574729147126"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1797271200, "status": "PUBLISHED", "id": "1896398081544208"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "28
71-25/499302344_1755828185594082_300749131154210490_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Nu1PKoxGFmsQ7kNvwF3E1Gi&_nc_oc=AdqGVGrjx7Dh4EJNFYNmwOkED7Fr2ASXj1tud1FPa2Vd3AnRFXVxWajktSdZ8fXaTgA&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIla6sPJ3se9NLT-ODRDzkk3YNuTnMmClDxpr5c93JQeg&oe=6AB66880"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "nullhypothesis-dystopia-trailer.png", "id": "1730659108133107", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/654936547_1730659111466440_654749016770112207_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QsYvpkecIZkQ7kNvwHwLCRC&_nc_oc=AdpWOv71LUTu5BhXIFr1KFMLocKcq2WtDh_--8FjYuzHQyn5mRAgQ2GLTvCXzkTWVIs&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKVX3R9joxjuSXtUp4CNxi-P0BAHrQBBn5nRudst-KSbQ&oe=6AB66E3E"}, "display_name": "Dystopia", "keywords": ["saber", "rhythm", "beat", "workout", "music"], "long_description": "Dystopia is a free-to-play VR rhythm game where you slice glowing crystals to the beat of the music as they fly towards you. With a blade in each hand, cut each crystal the way its arrow points.\n\nYou are always slicing to new music, fresh every session. Hear a song you love? Save it to your Archive to replay exactly as it played, because once it finishes it is gone for good. Go from Easy to Insane and unlock new artifact worlds as you slice.\n\nFive stations, each with its own sound: metal on Mental, EDM on Pulse, lo-fi on Drift, industrial synth on Volt, and pop on Wave.\n\nEasy to Insane: five difficulty levels. Crank it up and the crystals fly faster while you sweat harder. Post your best run to the leaderboards.\n\nArtifact worlds: slice to unlock 3D cinematic worlds unlike anything you have ever seen before in VR.\n\nWelcome to Dystopia. Slice responsibly.", "short_description": "Dystopia is a free-to-play VR rhythm game where you slice glowing crystals to the beat of the music as they fly towards you. With a blade in each hand, cut each crystal the way its arrow points.\n\nYou are always slicing to new music, fresh every session. Hear a song you love? Save it to your Archive to replay exactly as it played, because once it finishes it is gone for good. Go from Easy to Insane and unlock new artifact worlds as you slice.\n\nWelcome to Dystopia. Slice responsibly."}]}, "developer_name": null, "developer_privacy_policy_url": "https://nullhypothesis.inc/privacy", "developer_terms_of_service_url": "https://nullhypothesis.inc/terms", "publisher_name": "Null Hypothesis Inc", "support_website_url": null, "website_url": "https://nullhypothesis.inc/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1672577396871977"}, {"id": "459781504968480"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1201340969734465"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1417557380289714"}]}, "baseline_offer": {"id": "1417557380289714"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1784991240, "status": "PUBLISHED", "id": "1417557380289714"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1296879470180614", "version": "0.000.098"}, "id": "1466201878611433", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_a
nRV8qvVAv6LXhLqU&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRI_KSi57SAhEO23_05V8F395CfXHYGT30mvDIcC4T-ZA&oe=6AFB2346"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Ellic's Exercise Class", "keywords": [], "long_description": "This is a VR exergame called \u201cEllic\u2019s Exercise Class\u201d. Ellic will guide you through the play. The game includes seven mini exercise games: blocking, goalkeeper, volleyball, archery, skeet, baseball, and shooter. You will interact with virtual objects by moving your body and arms and triggering sporting events with the handheld controllers. Join Ellic's Exercise Class today! Each mini-game has three difficulty levels, and there must be a level right for you!", "short_description": "This is a VR exergame called \u201cEllic\u2019s Exercise Class\u201d. Ellic will guide you through the play. The game includes seven mini exercise games: blocking, goalkeeper, volleyball, archery, skeet, baseball, and shooter. You will interact with virtual objects by moving your body and arms and triggering sporting events with the handheld controllers. Join Ellic's Exercise Class today! Each mini-game has three difficulty levels, and there must be a level right for you!"}]}, "developer_name": "Newverse Studio", "developer_privacy_policy_url": "https://people.rit.edu/cxpigm/newverse/PrivacyPolicy.html", "developer_terms_of_service_url": null, "publisher_name": "Newverse Studio", "support_website_url": null, "website_url": "https://people.rit.edu/cxpigm/newverse/EllicsExerciseClass.html", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SPORTS"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommen
01291936789025", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/12331303_245598725994458_479181173273133056_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kpGvLSS_F-MQ7kNvwHyoA_2&_nc_oc=Adp0y6vwpNhEu22q2M3CeMDTdF_Y1H3n8bzxiD63zuFBXU_551mdrLv34mA0xxUjE5I&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzqBRr3L-wqZtQJqJ0kS_GLGbgPS1UICMt6mCWO_TL7Lg&oe=69CFA7BD"}, {"file_name": "migrated_image.png", "id": "642658059801509", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/12139433_425044671239926_4609888145117282304_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HY_lUtoWXjsQ7kNvwEP6171&_nc_oc=Adr3Ttn8TTs0_lKyHdNhn5JGI66TtEeftZdyW-Ep_FUUKuzGrDyaQxqbf4WyVnGNj7g&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Afz-t0JYcWXvzHkGfj7SkFvS83-v98rdnJyX1CV0rF8Iew&oe=69CFC63B"}, {"file_name": "migrated_image.png", "id": "619740281913536", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/12139467_430682997415049_6349888944162734080_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zaRtmrdthhgQ7kNvwFA6CDm&_nc_oc=Adp7Af-MO1o5qCvqe8xwQTJatHRPXV_3B-H1Y6et7LZvcmSDckPgN1oq1NEJFlcvgdg&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwGEQyVF-AXX-aDLrbUWVKTmfpzrTVdHBHXCcMvfYQpQA&oe=69CFA325"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "RotatorX", "keywords": ["Arcade", "Endlessrunner", "SciFi", "Speed", "Fast"], "long_description": "RotatorX is an endless runner type arcade game with a dark unique sci-fi atmosphere. Fast paced and addictive - but also meditative. The intuitive controls makes it easy to play - but it's hard to gain. Speed, procedural level design, dynamic lighting FX and an adaptive soundtrack will guarantee a challenging and immersive VR experience.\n\nKEY FEATURES\n* Dynamic lighting FX\n* Adaptive soundtrack\n* Intuitve controls\n* Procedural level design\n\n! Oculus Go only !", "short_description": "RotatorX is an endless runner type arcade game with a
01291936789025", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/12331303_245598725994458_479181173273133056_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6GNF6ovc4DYQ7kNvwEUJrWV&_nc_oc=AdrChsItQw7FE5GZH5MKsa8VAYbrvlFK3CBA7mUkba57Rearevwk7acPWnxGUx6iW6o&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMnCD1wfnAWbmE4uCvE4-p2NzpOexT7RpZm8dS6WWnYGQ&oe=6ACA5CFD"}, {"file_name": "migrated_image.png", "id": "642658059801509", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/12139433_425044671239926_4609888145117282304_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZffCGIs639YQ7kNvwGQOoTh&_nc_oc=AdoK4W-fiEFtEh4Abi-g2LYPl4lRRqao3F_u-DtfE7aKp-wzgW61Pr5538V0kxM_IKk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMjLlXfACm6PQXfiFea9ax-eC3q0WmEzRELrvUlJNC9Ug&oe=6ACA433B"}, {"file_name": "migrated_image.png", "id": "619740281913536", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/12139467_430682997415049_6349888944162734080_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qqgWRZndm_gQ7kNvwGWTdOG&_nc_oc=AdqbwWOdzHuP2RmTqu8J-kgPXkUu_zfT1ZRPu7rYkyEiraI_c0uJS1PFfvKgS3NJ-ps&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOO4ogIXpdwzX1fXeyH6fCAA3X6D_u2cAo4mAuLiQePsA&oe=6ACA5865"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "RotatorX", "keywords": ["Arcade", "Endlessrunner", "SciFi", "Speed", "Fast"], "long_description": "RotatorX is an endless runner type arcade game with a dark unique sci-fi atmosphere. Fast paced and addictive - but also meditative. The intuitive controls makes it easy to play - but it's hard to gain. Speed, procedural level design, dynamic lighting FX and an adaptive soundtrack will guarantee a challenging and immersive VR experience.\n\nKEY FEATURES\n* Dynamic lighting FX\n* Adaptive soundtrack\n* Intuitve controls\n* Procedural level design\n\n! Oculus Go only !", "short_description": "RotatorX is an endless runner type arcade game with a dark unique sci-fi atmosphere. Fast paced and addictive - but also meditative. The intuitive controls makes it easy to play - but it's hard to gain. Speed, procedural level design, dynamic lighting FX and an adaptive soundtrack will guarantee a challenging and immersive VR experience. ! Oculus Go only !"}]}, "developer_name": null, "developer_privacy_policy_url": "http://rotatorx.deficit-games.de/eula", "developer_terms_of_service_url": "http://rotatorx.deficit-games.de/eula.html", "publisher_name": "DEFICIT Games", "support_website_url": null, "website_url": "http://rotatorx.deficit-games.de/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ARCADE", "FLYING"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "378349304052843"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/12139007_193856487937379_7824102611287539712_n.png?stp=dst-png_s360x360&_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0WeBD9lHzRwQ7kNvwGmglke&_nc_oc=AdpM7JMXpo8HiH1UV0rA_3vXrEoDqIiVATyVO6u85vbD92RuLP11_GokOewyaM5Xp2Y&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO2l46YCN-aZiGjEdy1Khc53sKhxWD7xQlCKcII1GCTXg&oe=6ACA5923"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "RotatorX", "platform": "ANDROID", "context_category": null, "context_topics": [], "release_date": 1534267884, "lastRevision": {"nodes": [{"id": "364537817398666", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {
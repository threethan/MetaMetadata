01291936789025", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12331303_245598725994458_479181173273133056_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lAErCT1fIEgQ7kNvwFrx0Ev&_nc_oc=AdpDypGGAgMqTD-8gZSyLJkUjpOY5DH2I-cAIg2ni4YyEAicxRN-CQTT7KWZhOAGYr0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5Q8KftLYRwqbBClS4qqbx4qKlLhCoH9m_K17QOCyYulQ&oe=6A0B337D"}, {"file_name": "migrated_image.png", "id": "642658059801509", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12139433_425044671239926_4609888145117282304_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=haKfEc5pEnYQ7kNvwHdkHtl&_nc_oc=AdrDxRlfx1GYwZBZzVl1fj5U0-sf0SqxDumG8Uf0oe2v_ZuiwT39tyuLhrfibKz0lxs&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4JEbph03w4CAkak1Qee3qpIbABm19L9DpU6Kh5D9CiMw&oe=6A0B19BB"}, {"file_name": "migrated_image.png", "id": "619740281913536", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12139467_430682997415049_6349888944162734080_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XzStZyTmcIMQ7kNvwGnepc2&_nc_oc=AdpYPpCTdzEP3r4nhdIp4cRyIz3K6Wq3QpQqeeRbhyqpWNjifaLuq3L-UDe2NkG3hn4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af49ixEBZKYdLJQB6gPt2WD4a9_O0nwYy-6LD-Ln7YQ_xA&oe=6A0B2EE5"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "RotatorX", "keywords": ["Arcade", "Endlessrunner", "SciFi", "Speed", "Fast"], "long_description": "RotatorX is an endless runner type arcade game with a dark unique sci-fi atmosphere. Fast paced and addictive - but also meditative. The intuitive controls makes it easy to play - but it's hard to gain. Speed, procedural level design, dynamic lighting FX and an adaptive soundtrack will guarantee a challenging and immersive VR experience.\n\nKEY FEATURES\n* Dynamic lighting FX\n* Adaptive soundtrack\n* Intuitve controls\n* Procedural level design\n\n! Oculus Go only !", "short_description": "RotatorX is an endless runner type arcade game with a dark unique sci-fi atmosphere. Fast paced and addictive - but also meditative. The intuitive controls makes it easy to play - but it's hard to gain. Speed, procedural level design, dynamic lighting FX and an adaptive soundtrack will guarantee a challenging and immersive VR experience. ! Oculus Go only !"}]}, "developer_name": null, "developer_privacy_policy_url": "http://rotatorx.deficit-games.de/eula", "developer_terms_of_service_url": "http://rotatorx.deficit-games.de/eula.html", "publisher_name": "DEFICIT Games", "support_website_url": null, "website_url": "http://rotatorx.deficit-games.de/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ARCADE", "FLYING"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "378349304052843"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12139007_193856487937379_7824102611287539712_n.png?stp=dst-png_s360x360&_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jxlZj6Di0f8Q7kNvwEsFOzJ&_nc_oc=AdrFsEM6JDZRpw6d_Rdtae2kykSMTMT0wvEnu1PVjNZAuNwmWC3Jip0IMGCKs2MSItY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7utiKO87VjjZrnuBMPkYKwfTTGfV9EGJFbER_tdHaDUQ&oe=6A0B2FA3"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "RotatorX", "platform": "ANDROID", "context_category": null, "context_topics": [], "release_date": 1534267884, "lastRevision": {"nodes": [{"id": "364537817398666", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {
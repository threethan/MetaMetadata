056_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-BQYz-mvsSMQ7kNvwGKJ0nu&_nc_oc=AdnCooxVDc36EfIX1zj63l-F6iAAt0s6mBH4Ho7loKP7TQ0TWOh0c-7evIZ3HMKDIug&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&oh=00_AfuT1ZvJV_xWGRpaAaFIsiBmSbxYAOifgt4L3Cl3A6DyBw&oe=69A1833D"}, {"file_name": "migrated_image.png", "id": "642658059801509", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/12139433_425044671239926_4609888145117282304_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RLD4Ywp4mqEQ7kNvwHjPulI&_nc_oc=AdnXrbAloeZ-kp19YxBBV9PcBzZLh_ITKeHKi0q7z_nkat3u0PL2J4x3-TFLUV6NDuA&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&oh=00_Afs7iRFw055c9aVTTlFDGqd4-Ogk5TjMOjX5OzRdIK41NA&oe=69A1A1BB"}, {"file_name": "migrated_image.png", "id": "619740281913536", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/12139467_430682997415049_6349888944162734080_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6YjEWbmF_BAQ7kNvwEtIdxk&_nc_oc=AdmIJuJ884-CPcAqQmguxec1lQuzT0kAXlmlxFoxA_fdavxSskmtIAeOUJ8fPjhMOeo&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&oh=00_AftUUlIlS5ERBry_FfSJZtGM4ZepAIqPBxjWrKWYhiSz9g&oe=69A17EA5"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "RotatorX", "keywords": ["Arcade", "Endlessrunner", "SciFi", "Speed", "Fast"], "long_description": "RotatorX is an endless runner type arcade game with a dark unique sci-fi atmosphere. Fast paced and addictive - but also meditative. The intuitive controls makes it easy to play - but it's hard to gain. Speed, procedural level design, dynamic lighting FX and an adaptive soundtrack will guarantee a challenging and immersive VR experience.\n\nKEY FEATURES\n* Dynamic lighting FX\n* Adaptive soundtrack\n* Intuitve controls\n* Procedural level design\n\n! Oculus Go only !", "short_description": "RotatorX is an endless runner type arcade game with a dark unique sci-fi atmosphere. Fast paced and addictive - but also meditative. The intuitive controls makes it easy to play - but it's hard to gain. Speed, procedural level design, dynamic lighting FX and an adaptive soundtrack will guarantee a challenging and immersive VR experience. ! Oculus Go only !"}]}, "developer_name": null, "developer_privacy_policy_url": "http://rotatorx.deficit-games.de/eula", "developer_terms_of_service_url": "http://rotatorx.deficit-games.de/eula.html", "publisher_name": "DEFICIT Games", "support_website_url": null, "website_url": "http://rotatorx.deficit-games.de/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ARCADE", "FLYING"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "378349304052843"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/12139007_193856487937379_7824102611287539712_n.png?stp=dst-png_s360x360&_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BHaEU_n3w9IQ7kNvwFbDU4U&_nc_oc=AdntxdrFZ2oGn2ih33ySDAeVEsw-vSutvXkZZxQcJZniJLnPuqnQ9Auu7fi7sq9B7xk&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&oh=00_Aft9sjTOT-giWf51oyZeJKlIgT97g_OOrYwM6vzd_B9TPw&oe=69A17F63"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "RotatorX", "platform": "ANDROID", "context_category": null, "context_topics": [], "release_date": 1534267884, "lastRevision": {"nodes": [{"id": "364537817398666", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "1718957224836022", "is_first_party": false, "enables_in_app_ads": false, "is_concept": false, "platform": "ANDROID"}, "
01291936789025", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/12331303_245598725994458_479181173273133056_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ykkH9iRCdnoQ7kNvwGpVZoi&_nc_oc=Adq7XKE0sR7WfjKPCVT2r5p_cw3ECje0jUCXubf223qT1sEQf89oqytZG3UVbwlDds8&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPZU8SFvm18sstPO1240joPeKDlAVQqWj6A8nWX-19Bfw&oe=6AC7B9FD"}, {"file_name": "migrated_image.png", "id": "642658059801509", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/12139433_425044671239926_4609888145117282304_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TWBVC5XQ-egQ7kNvwGX_VBl&_nc_oc=AdrEKPsHq_bUPWi5wtBRCXPwFf574Xeczw0uUFuPL430Y5ZUtWfVlW3Zs7koNZng5UM&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP6Xvzyc3LR6JFYjMZquKKmJ3sUY29MwXhK0wsSS1h3-A&oe=6AC7A03B"}, {"file_name": "migrated_image.png", "id": "619740281913536", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/12139467_430682997415049_6349888944162734080_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tVcSSEU1PJkQ7kNvwEUnvxp&_nc_oc=AdpCfbRXl4UkK7YpCSu9mlj0P9cp3FJWbdMYpyT4cpxj9SNjI4NvqOaMv46R-SXZpOY&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNJTscN1s7sR9WeZm1hYjskEnM_hAkhmTTcEn7Ne95YEw&oe=6AC7B565"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "RotatorX", "keywords": ["Arcade", "Endlessrunner", "SciFi", "Speed", "Fast"], "long_description": "RotatorX is an endless runner type arcade game with a dark unique sci-fi atmosphere. Fast paced and addictive - but also meditative. The intuitive controls makes it easy to play - but it's hard to gain. Speed, procedural level design, dynamic lighting FX and an adaptive soundtrack will guarantee a challenging and immersive VR experience.\n\nKEY FEATURES\n* Dynamic lighting FX\n* Adaptive soundtrack\n* Intuitve controls\n* Procedural level design\n\n! Oculus Go only !", "short_description": "RotatorX is an endless runner type arcade game with a dark unique sci-fi atmosphere. Fast paced and addictive - but also meditative. The intuitive controls makes it easy to play - but it's hard to gain. Speed, procedural level design, dynamic lighting FX and an adaptive soundtrack will guarantee a challenging and immersive VR experience. ! Oculus Go only !"}]}, "developer_name": null, "developer_privacy_policy_url": "http://rotatorx.deficit-games.de/eula", "developer_terms_of_service_url": "http://rotatorx.deficit-games.de/eula.html", "publisher_name": "DEFICIT Games", "support_website_url": null, "website_url": "http://rotatorx.deficit-games.de/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ARCADE", "FLYING"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "378349304052843"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/12139007_193856487937379_7824102611287539712_n.png?stp=dst-png_s360x360&_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6HfAu6sELbsQ7kNvwFunHC-&_nc_oc=Adom3COz4TE1Owvb3Gt6nW0cRi9WsP7F2-ieqwl4Qyre6sHUWFm3KrTYe8ZnTPTOIZc&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPlnkqI1UltGMxXaE2ee3kYKZ3oMF4-lS-i0iCr7hIj0g&oe=6AC7B623"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "RotatorX", "platform": "ANDROID", "context_category": null, "context_topics": [], "release_date": 1534267884, "lastRevision": {"nodes": [{"id": "364537817398666", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {
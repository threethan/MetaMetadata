01291936789025", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/12331303_245598725994458_479181173273133056_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dkuRucic-FAQ7kNvwFKAgxz&_nc_oc=AdoN0MZ5XdkG9exe6mjXdHNmqdqarSE4mw1lnYGoRLgdf7g2Dd_97asGAOQbHwrvBOA&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_LctlJPFSuyRFOz6VuF_tlcK81r8IOvsocyM10zBt3oQ&oe=6A219CFD"}, {"file_name": "migrated_image.png", "id": "642658059801509", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/12139433_425044671239926_4609888145117282304_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j6B6kDKkxV4Q7kNvwG5bInV&_nc_oc=AdpomRCIdQMKhRKxnjhN7cdmiIOO_jvqdp2vKC59aopvgBaiN6zqTj3hhOoz0sGY4z8&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-p51NwhRQLGNpreEruZ8dvXUKXeFIfS3P8sT8KU0NSpw&oe=6A21833B"}, {"file_name": "migrated_image.png", "id": "619740281913536", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/12139467_430682997415049_6349888944162734080_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ynf9pT52JjMQ7kNvwEInLli&_nc_oc=Adp6L3XAuVW4Ui0Kht8geu106qogLlRd61_2SZJJ4pNmq16ZJCYYJ79ggW_C8mVOc_Q&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-Faz8-0trA7EVbKO86KXqIsm2vYTnY2kAVFR5KwJ1-XQ&oe=6A219865"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "RotatorX", "keywords": ["Arcade", "Endlessrunner", "SciFi", "Speed", "Fast"], "long_description": "RotatorX is an endless runner type arcade game with a dark unique sci-fi atmosphere. Fast paced and addictive - but also meditative. The intuitive controls makes it easy to play - but it's hard to gain. Speed, procedural level design, dynamic lighting FX and an adaptive soundtrack will guarantee a challenging and immersive VR experience.\n\nKEY FEATURES\n* Dynamic lighting FX\n* Adaptive soundtrack\n* Intuitve controls\n* Procedural level design\n\n! Oculus Go only !", "short_description": "RotatorX is an endless runner type arcade game with a dark unique sci-fi atmosphere. Fast paced and addictive - but also meditative. The intuitive controls makes it easy to play - but it's hard to gain. Speed, procedural level design, dynamic lighting FX and an adaptive soundtrack will guarantee a challenging and immersive VR experience. ! Oculus Go only !"}]}, "developer_name": null, "developer_privacy_policy_url": "http://rotatorx.deficit-games.de/eula", "developer_terms_of_service_url": "http://rotatorx.deficit-games.de/eula.html", "publisher_name": "DEFICIT Games", "support_website_url": null, "website_url": "http://rotatorx.deficit-games.de/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ARCADE", "FLYING"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "378349304052843"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/12139007_193856487937379_7824102611287539712_n.png?stp=dst-png_s360x360&_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fvpCZ7GjdA0Q7kNvwF6gP6P&_nc_oc=Adqw_asX2p-crQXMCvjeVGYVi4plV4VM6_S2gmpyvVaxtyAF9d2gOKWGdW3kyG5RCaM&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-5w16uSWY2YKq_AejTDDdB7pPnRkoyHVM34CWWD_3yXg&oe=6A219923"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "RotatorX", "platform": "ANDROID", "context_category": null, "context_topics": [], "release_date": 1534267884, "lastRevision": {"nodes": [{"id": "364537817398666", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {
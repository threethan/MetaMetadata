01291936789025", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/12331303_245598725994458_479181173273133056_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=za8paBk6B5QQ7kNvwFwh-W8&_nc_oc=AdqcCCW-AD-QwcmhCwyMp684cGoJIuDBhVAtbtYcI-kKCbfsoCfNiGTv25Y_M7g3_1s&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5bjp-o3C6RuHTv99Zi4y6pSqLIuSNMyKPxClUUEMnglA&oe=69FE047D"}, {"file_name": "migrated_image.png", "id": "642658059801509", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/12139433_425044671239926_4609888145117282304_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4P6qDoy1lBUQ7kNvwFAAJJ0&_nc_oc=AdovkLB5-sisyxJfxagf7xv7X6yglIxabRP8D4M2HX4plxz7LDdivxJXE02M2Buoo9o&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4_-CWs0dDK3j9p4VvsIkMUb-o8anBgBtPcYlaKoWLvyA&oe=69FDEABB"}, {"file_name": "migrated_image.png", "id": "619740281913536", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/12139467_430682997415049_6349888944162734080_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BHqHsghqz3QQ7kNvwHCvB-W&_nc_oc=Adot9l1sqEsyjhJWElG1sZQhRWFuWPtrUZ_gsnqRz0rG13xmho8_RzuOSikvhvUsWo8&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4-6LTWVq80kkR_qKqB26ZirM3v4Ngk7jIH_hGgInbEug&oe=69FDFFE5"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "RotatorX", "keywords": ["Arcade", "Endlessrunner", "SciFi", "Speed", "Fast"], "long_description": "RotatorX is an endless runner type arcade game with a dark unique sci-fi atmosphere. Fast paced and addictive - but also meditative. The intuitive controls makes it easy to play - but it's hard to gain. Speed, procedural level design, dynamic lighting FX and an adaptive soundtrack will guarantee a challenging and immersive VR experience.\n\nKEY FEATURES\n* Dynamic lighting FX\n* Adaptive soundtrack\n* Intuitve controls\n* Procedural level design\n\n! Oculus Go only !", "short_description": "RotatorX is an endless runner type arcade game with a dark unique sci-fi atmosphere. Fast paced and addictive - but also meditative. The intuitive controls makes it easy to play - but it's hard to gain. Speed, procedural level design, dynamic lighting FX and an adaptive soundtrack will guarantee a challenging and immersive VR experience. ! Oculus Go only !"}]}, "developer_name": null, "developer_privacy_policy_url": "http://rotatorx.deficit-games.de/eula", "developer_terms_of_service_url": "http://rotatorx.deficit-games.de/eula.html", "publisher_name": "DEFICIT Games", "support_website_url": null, "website_url": "http://rotatorx.deficit-games.de/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ARCADE", "FLYING"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "378349304052843"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/12139007_193856487937379_7824102611287539712_n.png?stp=dst-png_s360x360&_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_s5YJvEHNFoQ7kNvwFcSivO&_nc_oc=AdqJ3d8QxfZddHZh8_HK3-jrNqxXwUO1PAPivpPat7b5xOC6lYBayVf61QUe00gE3Dk&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af40ataf_PxEwIMGi2zOaHlNm6KogO0L5BwzskMenp8cYw&oe=69FE00A3"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "RotatorX", "platform": "ANDROID", "context_category": null, "context_topics": [], "release_date": 1534267884, "lastRevision": {"nodes": [{"id": "364537817398666", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {
01291936789025", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/12331303_245598725994458_479181173273133056_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r-hP-6c4GC8Q7kNvwE2GWsz&_nc_oc=AdrsP9mZOi2H-hvR8gTAFGKA9sCBd8BBjtgZLfwlNOIHIekGT4lTBkhSF-DsNOsngKs&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2RPf6FVhcpkwlFpXOvs3Ttq6v-ax7N-cenFyIwABgDtg&oe=69E8B43D"}, {"file_name": "migrated_image.png", "id": "642658059801509", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/12139433_425044671239926_4609888145117282304_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pui0oZegILEQ7kNvwG5UrT6&_nc_oc=AdrAu103TkhPhiv8cTJ5KXP3VZ-WpJN5o2XsUpbyWwfyStP432cSSlzSLCl3F-biww0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0CszRk_ZeZkNrc0wTgWZtLvxNRCglsGj-xB9UDq4Pd7g&oe=69E8D2BB"}, {"file_name": "migrated_image.png", "id": "619740281913536", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/12139467_430682997415049_6349888944162734080_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cHFqUaqgTXMQ7kNvwEcFKLq&_nc_oc=Adph1grL0mc_eHzEAolx5oeX90UkuwrZag-uPZX4v-F82yF4tPK1X7gbLEr6lY-GLmY&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af344Sm6sTgAGU6uodEq0wMHa1aCWHJXVafhIGr6-NSpiw&oe=69E8AFA5"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "RotatorX", "keywords": ["Arcade", "Endlessrunner", "SciFi", "Speed", "Fast"], "long_description": "RotatorX is an endless runner type arcade game with a dark unique sci-fi atmosphere. Fast paced and addictive - but also meditative. The intuitive controls makes it easy to play - but it's hard to gain. Speed, procedural level design, dynamic lighting FX and an adaptive soundtrack will guarantee a challenging and immersive VR experience.\n\nKEY FEATURES\n* Dynamic lighting FX\n* Adaptive soundtrack\n* Intuitve controls\n* Procedural level design\n\n! Oculus Go only !", "short_description": "RotatorX is an endless runner type arcade game with a dark unique sci-fi atmosphere. Fast paced and addictive - but also meditative. The intuitive controls makes it easy to play - but it's hard to gain. Speed, procedural level design, dynamic lighting FX and an adaptive soundtrack will guarantee a challenging and immersive VR experience. ! Oculus Go only !"}]}, "developer_name": null, "developer_privacy_policy_url": "http://rotatorx.deficit-games.de/eula", "developer_terms_of_service_url": "http://rotatorx.deficit-games.de/eula.html", "publisher_name": "DEFICIT Games", "support_website_url": null, "website_url": "http://rotatorx.deficit-games.de/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ARCADE", "FLYING"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "378349304052843"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/12139007_193856487937379_7824102611287539712_n.png?stp=dst-png_s360x360&_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mcIoJm4zBmwQ7kNvwEJvhRQ&_nc_oc=AdppJq0-WjF5CbTuzPU6hOUoS68YqJ1Nt2F-LnvWs22tpjiCj8MkAawKFaNsvWFpOdM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3UDy6K6DtUCHDG9zGCyaDyRbz00tHS0j8jlilXH9BPBg&oe=69E8B063"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "RotatorX", "platform": "ANDROID", "context_category": null, "context_topics": [], "release_date": 1534267884, "lastRevision": {"nodes": [{"id": "364537817398666", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {
01291936789025", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/12331303_245598725994458_479181173273133056_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ykkH9iRCdnoQ7kNvwHEUGLC&_nc_oc=AdqT0OVghsXXyZdeWrSaF6cIqILLktejUC_4EK4izGHYCo802kon3istHy39er4TTPY&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNceBgLxxrHPhJQmHBXENNr7B5NCCjxit2WyxCnqXAFag&oe=6AC516FD"}, {"file_name": "migrated_image.png", "id": "642658059801509", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/12139433_425044671239926_4609888145117282304_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TWBVC5XQ-egQ7kNvwG7BygS&_nc_oc=AdqA54ZKQO6p2XwpR0JaoS4m6mnofmelTdm1fOTxpvHwW1hfHJMeHdG5hBOIfHSVPfw&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM34WNX6WuwZZMaaHrtxjOYsFO28Jt2eYVj7mNJWrGPQQ&oe=6AC4FD3B"}, {"file_name": "migrated_image.png", "id": "619740281913536", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/12139467_430682997415049_6349888944162734080_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U8BqXGAi0j4Q7kNvwFi6LQl&_nc_oc=AdqQg6yEBmIImHdf0Jbjoa_sjAGbm7QssCXnUXFWPelndbPs0rDwdTjd38E57SmpfcM&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOC_wfg6BzPDgx2vDQ7C46DytIf4OxKVfMFAmgcPB_x-g&oe=6AC51265"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "RotatorX", "keywords": ["Arcade", "Endlessrunner", "SciFi", "Speed", "Fast"], "long_description": "RotatorX is an endless runner type arcade game with a dark unique sci-fi atmosphere. Fast paced and addictive - but also meditative. The intuitive controls makes it easy to play - but it's hard to gain. Speed, procedural level design, dynamic lighting FX and an adaptive soundtrack will guarantee a challenging and immersive VR experience.\n\nKEY FEATURES\n* Dynamic lighting FX\n* Adaptive soundtrack\n* Intuitve controls\n* Procedural level design\n\n! Oculus Go only !", "short_description": "RotatorX is an endless runner type arcade game with a
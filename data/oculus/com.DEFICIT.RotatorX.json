01291936789025", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/12331303_245598725994458_479181173273133056_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q1mXoQUivvIQ7kNvwG2GD5b&_nc_oc=AdqZ5bE5OZxeGKuc4J-nwgBrl1Te18RkHXchWUlUfDvvHF0jDOVoPlw2yWnB-ZVMxsM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0WmiE2xhXm60OkcCmxVkD0axhQRwEJYORt8PeKPo_5Lw&oe=69ECA8BD"}, {"file_name": "migrated_image.png", "id": "642658059801509", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/12139433_425044671239926_4609888145117282304_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n7HNRG6F6CMQ7kNvwEMjYI0&_nc_oc=Adqb1WDb8S-t1PAnq8U4EOGlkPSNXpBnD7w2r9yu9Ld16RN30AiB_Y0TAb-1Ekf4Prk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2x_pgXr8QK_stzHrR_IZqxfBJLHBtx4ZaG84Qzq_4QnQ&oe=69ECC73B"}, {"file_name": "migrated_image.png", "id": "619740281913536", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12139467_430682997415049_6349888944162734080_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PS6AkQMRnWwQ7kNvwEgsTPH&_nc_oc=AdrzAwozmruxE0y2iZza-6Bfnztf5YwzoN2beUPvzgSf31GBl_cgZgMt8GPZOy9S2dY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3EjnKtCV2HExGBE2mnBgmms5QbZ5cG12m50IOH_uAYWg&oe=69ECA425"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "RotatorX", "keywords": ["Arcade", "Endlessrunner", "SciFi", "Speed", "Fast"], "long_description": "RotatorX is an endless runner type arcade game with a dark unique sci-fi atmosphere. Fast paced and addictive - but also meditative. The intuitive controls makes it easy to play - but it's hard to gain. Speed, procedural level design, dynamic lighting FX and an adaptive soundtrack will guarantee a challenging and immersive VR experience.\n\nKEY FEATURES\n* Dynamic lighting FX\n* Adaptive soundtrack\n* Intuitve controls\n* Procedural level design\n\n! Oculus Go only !", "short_description": "RotatorX is an endless runner type arcade game with a
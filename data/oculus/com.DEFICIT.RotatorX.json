056_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cpcuK3hIbJMQ7kNvwF5CL55&_nc_oc=AdkCXFr7bWxESPrTAusEL6oRyXD9ZG4e_rPNgSf7RN8zB2ns3cz4NBljpgUdEDgz-KU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfuF_RKTz1dkGUf1CSR4ARFeSkcBY_h2QOLmL2nHxg8Y2Q&oe=69A6C93D"}, {"file_name": "migrated_image.png", "id": "642658059801509", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/12139433_425044671239926_4609888145117282304_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3X2jSwkg0_0Q7kNvwFtlD-U&_nc_oc=AdlUA3cQu41PepAQ_FJsDiyJa0MexOsvuNGePinal-08zasAQh0qpB4XfSCIFkzqDRw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfsiJx_crh56UZyhEtcpShwu9e9eGAm7W-UlqiFt1Rq9uQ&oe=69A6E7BB"}, {"file_name": "migrated_image.png", "id": "619740281913536", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/12139467_430682997415049_6349888944162734080_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eXTZndfWXnoQ7kNvwF0__SJ&_nc_oc=AdmmtppWXQpQbjbfLZRcpsL8seZ_sDKMjN-Eovp0qQJfcfeEivi_p3s7r158OND-hAg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Aftn_EFfg-LB7e0t6uZ8FeiromgfTk0idOzkwFnsTTUqjA&oe=69A6C4A5"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "RotatorX", "keywords": ["Arcade", "Endlessrunner", "SciFi", "Speed", "Fast"], "long_description": "RotatorX is an endless runner type arcade game with a dark unique sci-fi atmosphere. Fast paced and addictive - but also meditative. The intuitive controls makes it easy to play - but it's hard to gain. Speed, procedural level design, dynamic lighting FX and an adaptive soundtrack will guarantee a challenging and immersive VR experience.\n\nKEY FEATURES\n* Dynamic lighting FX\n* Adaptive soundtrack\n* Intuitve controls\n* Procedural level design\n\n! Oculus Go only !", "short_description": "RotatorX is an endless runner type arcade game with a dark unique sci-fi atmosphere. Fast paced and addictive - but also meditative. The intuitive controls makes it easy to play - but it's hard to gain. Speed, procedural level design, dynamic lighting FX and an adaptive soundtrack will guarantee a challenging and immersive VR experience. ! Oculus Go only !"}]}, "developer_name": null, "developer_privacy_policy_url": "http://rotatorx.deficit-games.de/eula", "developer_terms_of_service_url": "http://rotatorx.deficit-games.de/eula.html", "publisher_name": "DEFICIT Games", "support_website_url": null, "website_url": "http://rotatorx.deficit-games.de/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ARCADE", "FLYING"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "378349304052843"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/12139007_193856487937379_7824102611287539712_n.png?stp=dst-png_s360x360&_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JXqrqcMd41cQ7kNvwHeYa0k&_nc_oc=Adn5NVlQ2pHrC5-wCusNFlQsSOhsaV8kxEUcwfaqaWsoIPiwp8vAMmE11Yik18P4aDw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AftVva8_ZCpw38105VafWQLAIoQd7FzUa_Gbd0ZbsI-14w&oe=69A6C563"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "RotatorX", "platform": "ANDROID", "context_category": null, "context_topics": [], "release_date": 1534267884, "lastRevision": {"nodes": [{"id": "364537817398666", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "1718957224836022", "is_first_party": false, "enables_in_app_ads": false, "is_concept": false, "platform": "ANDROID"}, "
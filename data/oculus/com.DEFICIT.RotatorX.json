01291936789025", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/12331303_245598725994458_479181173273133056_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q1mXoQUivvIQ7kNvwHyn1ok&_nc_oc=Adqm7daeiX0S9o13OSP2QO9N-mShNh7F3njSMfGtSL1xIL1npZWdeSQakzVaxyTd2Os&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3wMKBi53D0zPMrOooH_BOz717SYtQJpWV4nCNpM5nItA&oe=69EDFA3D"}, {"file_name": "migrated_image.png", "id": "642658059801509", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/12139433_425044671239926_4609888145117282304_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n7HNRG6F6CMQ7kNvwE8rRet&_nc_oc=AdrcANzg7t1Nz86_JOV-1yVFVY3t2UIhXbuaVZFK5zpcx3bk4ljqRcfXIxMpOpo64e8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0zDClKSVP31JQzyxYyPc6TgBaasrwQtyMhpRGVZkg3dA&oe=69EE18BB"}, {"file_name": "migrated_image.png", "id": "619740281913536", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12139467_430682997415049_6349888944162734080_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_-uthIIjzJYQ7kNvwEN5SYo&_nc_oc=Ado7HtdOIjejqsEZI5ATVnAF9X4sp8nFMMrebpZaJ4gCavdz4Y7jqg8K1vJIM9qU9Wg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0sHQssXR6U7dUfGe0n6Xqg1vyOIXNmYpRYqyYiZCU4cw&oe=69EDF5A5"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "RotatorX", "keywords": ["Arcade", "Endlessrunner", "SciFi", "Speed", "Fast"], "long_description": "RotatorX is an endless runner type arcade game with a dark unique sci-fi atmosphere. Fast paced and addictive - but also meditative. The intuitive controls makes it easy to play - but it's hard to gain. Speed, procedural level design, dynamic lighting FX and an adaptive soundtrack will guarantee a challenging and immersive VR experience.\n\nKEY FEATURES\n* Dynamic lighting FX\n* Adaptive soundtrack\n* Intuitve controls\n* Procedural level design\n\n! Oculus Go only !", "short_description": "RotatorX is an endless runner type arcade game with a
01291936789025", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/12331303_245598725994458_479181173273133056_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tINCuOCYmEsQ7kNvwE7oWSv&_nc_oc=AdrY-8tgnYjxqbTlAxiuX4AcmERWJ2oRL77FPyJO6yZkc3oYAS9DnUGqXsJxtqCJCIQ&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHgLZ076XOsPtJ4qbKMiOCJfQrr7RbSmOv8QfPoCK0Jtg&oe=6A94173D"}, {"file_name": "migrated_image.png", "id": "642658059801509", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/12139433_425044671239926_4609888145117282304_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C1Lpp-5TX0EQ7kNvwEItANM&_nc_oc=AdrHgWIMnx26gM88oB02VwPm-J19oZ9_u6SIy9z1i7M8M-Rju9fuwaQJGNe8xR0qbcY&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGdnjrzKtIEzrhkQ6v0dqYcVFCiJEO7fdpqmlSXo5JQtA&oe=6A93FD7B"}, {"file_name": "migrated_image.png", "id": "619740281913536", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/12139467_430682997415049_6349888944162734080_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u2mQwXX8d0UQ7kNvwFfsA_P&_nc_oc=AdrRcYFu6U3N7N3tAAAOnfka4WCnsN3WdQkdmPf__eri5-jVyKhYSuDosFEhDCAd1aI&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQELTqFjsKFlC9bG6iQ8ia9tWnLrfyT2SjN5JL_ZQ9Ka-w&oe=6A9412A5"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "RotatorX", "keywords": ["Arcade", "Endlessrunner", "SciFi", "Speed", "Fast"], "long_description": "RotatorX is an endless runner type arcade game with a dark unique sci-fi atmosphere. Fast paced and addictive - but also meditative. The intuitive controls makes it easy to play - but it's hard to gain. Speed, procedural level design, dynamic lighting FX and an adaptive soundtrack will guarantee a challenging and immersive VR experience.\n\nKEY FEATURES\n* Dynamic lighting FX\n* Adaptive soundtrack\n* Intuitve controls\n* Procedural level design\n\n! Oculus Go only !", "short_description": "RotatorX is an endless runner type arcade game with a dark unique sci-fi atmosphere. Fast paced and addictive - but also meditative. The intuitive controls makes it easy to play - but it's hard to gain. Speed, procedural level design, dynamic lighting FX and an adaptive soundtrack will guarantee a challenging and immersive VR experience. ! Oculus Go only !"}]}, "developer_name": null, "developer_privacy_policy_url": "http://rotatorx.deficit-games.de/eula", "developer_terms_of_service_url": "http://rotatorx.deficit-games.de/eula.html", "publisher_name": "DEFICIT Games", "support_website_url": null, "website_url": "http://rotatorx.deficit-games.de/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ARCADE", "FLYING"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "378349304052843"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/12139007_193856487937379_7824102611287539712_n.png?stp=dst-png_s360x360&_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zpAg4Ho3St4Q7kNvwF5oA_B&_nc_oc=AdpflvMc4_Aq5dLzZkl67E7PlpOkI4zmcjmAi3oBSO8TKvoiBKO-8nJdubAizGJJJcg&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQErmX7hK5fkzkBEju3hWq_IWrOSLHyPDmZuz_EKNb5xoA&oe=6A941363"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "RotatorX", "platform": "ANDROID", "context_category": null, "context_topics": [], "release_date": 1534267884, "lastRevision": {"nodes": [{"id": "364537817398666", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {
01291936789025", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12331303_245598725994458_479181173273133056_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=za8paBk6B5QQ7kNvwG34bjA&_nc_oc=AdpKluKTK4lMzZuO1UxkvmgmnvyI3Ef1lKvLDVUdUBD1M2zp7Bx86tq2yp02dhZQmG0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4iiCwafJo1vHEGvy-SQnpbSjSTQZbvariOJzG_8LKKqQ&oe=69FB293D"}, {"file_name": "migrated_image.png", "id": "642658059801509", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12139433_425044671239926_4609888145117282304_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4P6qDoy1lBUQ7kNvwEIaRTw&_nc_oc=AdqzaksaeV-at5Gh5lzH7_ZPaQwj7HDa88tPPLhStG-X4J-cSb6cwA0xEUUfEwFLMME&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6r2H4jaDYvqaSwtdP_DpaKvLIsf9H-Ut_hfcoCGHFHfw&oe=69FB47BB"}, {"file_name": "migrated_image.png", "id": "619740281913536", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12139467_430682997415049_6349888944162734080_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oFlsPaQzQNQQ7kNvwEYUv45&_nc_oc=AdoXE7HuWMxc6-HC1psh5CN29DT0r2rKjErBMpFWkUG4uA9apgtU1S_kcrwSlvHGHD8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5F4eQZGHDghWFvL0kFbsw6ojpD35njvyLXZuzgWBTEZg&oe=69FB5CE5"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "RotatorX", "keywords": ["Arcade", "Endlessrunner", "SciFi", "Speed", "Fast"], "long_description": "RotatorX is an endless runner type arcade game with a dark unique sci-fi atmosphere. Fast paced and addictive - but also meditative. The intuitive controls makes it easy to play - but it's hard to gain. Speed, procedural level design, dynamic lighting FX and an adaptive soundtrack will guarantee a challenging and immersive VR experience.\n\nKEY FEATURES\n* Dynamic lighting FX\n* Adaptive soundtrack\n* Intuitve controls\n* Procedural level design\n\n! Oculus Go only !", "short_description": "RotatorX is an endless runner type arcade game with a dark unique sci-fi atmosphere. Fast paced and addictive - but also meditative. The intuitive controls makes it easy to play - but it's hard to gain. Speed, procedural level design, dynamic lighting FX and an adaptive soundtrack will guarantee a challenging and immersive VR experience. ! Oculus Go only !"}]}, "developer_name": null, "developer_privacy_policy_url": "http://rotatorx.deficit-games.de/eula", "developer_terms_of_service_url": "http://rotatorx.deficit-games.de/eula.html", "publisher_name": "DEFICIT Games", "support_website_url": null, "website_url": "http://rotatorx.deficit-games.de/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ARCADE", "FLYING"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "378349304052843"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12139007_193856487937379_7824102611287539712_n.png?stp=dst-png_s360x360&_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_s5YJvEHNFoQ7kNvwHWQQAZ&_nc_oc=Adon84R-fFubKAkGiBeSG2trDISbCzxzpQ3kxV0dIBtobfpU9w8_JfjIjihgZUxGJgA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4R_85o0zd8I5iQmjipeFE4teuw7TUij9xCIGVTo21B-w&oe=69FB5DA3"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "RotatorX", "platform": "ANDROID", "context_category": null, "context_topics": [], "release_date": 1534267884, "lastRevision": {"nodes": [{"id": "364537817398666", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {
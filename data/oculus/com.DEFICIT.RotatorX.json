01291936789025", "uri": "https://scontent-lhr8-1.oculuscdn.com/v/t64.5771-25/12331303_245598725994458_479181173273133056_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YdqxQUVpjSQQ7kNvwFZVPG4&_nc_oc=AdqOMByFRY9skPxCTnWt6lSoFRFkNXkx9CK5FaWP6PFswPVvwZ5PHixukoUQie8v3EI&_nc_zt=3&_nc_ht=scontent-lhr8-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0lBJAPVSlnB4yWizWrEc1KGd0nWdQHSqj0_WxrT6Sm5w&oe=69E21CBD"}, {"file_name": "migrated_image.png", "id": "642658059801509", "uri": "https://scontent-lhr8-1.oculuscdn.com/v/t64.5771-25/12139433_425044671239926_4609888145117282304_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SUhMyD0vIFQQ7kNvwGf0GjD&_nc_oc=AdriAMcHOzl56O6-k9_eefzxrs4E1eNhBsTxKyJ94JfA9pWxDaHt9_TBKN1lhdbxuVk&_nc_zt=3&_nc_ht=scontent-lhr8-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0NF6obKB8h4bYhJkuvbz9Dza48ln8ZPexFpEE8h6qEyw&oe=69E23B3B"}, {"file_name": "migrated_image.png", "id": "619740281913536", "uri": "https://scontent-lhr8-2.oculuscdn.com/v/t64.5771-25/12139467_430682997415049_6349888944162734080_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m4jvmq-0dJUQ7kNvwEgD7WG&_nc_oc=AdrP4reP4Lzajr6jfY4nKXrDyGhXGHU45E3SvQNqj0kQNeol1uN5mISbqvG8P2nSZyc&_nc_zt=3&_nc_ht=scontent-lhr8-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af03hTWzWwKg2ShhWiC5lPCSyuYUtPLyiQSdFAJBTl2QtQ&oe=69E25065"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "RotatorX", "keywords": ["Arcade", "Endlessrunner", "SciFi", "Speed", "Fast"], "long_description": "RotatorX is an endless runner type arcade game with a dark unique sci-fi atmosphere. Fast paced and addictive - but also meditative. The intuitive controls makes it easy to play - but it's hard to gain. Speed, procedural level design, dynamic lighting FX and an adaptive soundtrack will guarantee a challenging and immersive VR experience.\n\nKEY FEATURES\n* Dynamic lighting FX\n* Adaptive soundtrack\n* Intuitve controls\n* Procedural level design\n\n! Oculus Go only !", "short_description": "RotatorX is an endless runner type arcade game with a dark unique sci-fi atmosphere. Fast paced and addictive - but also meditative. The intuitive controls makes it easy to play - but it's hard to gain. Speed, procedural level design, dynamic lighting FX and an adaptive soundtrack will guarantee a challenging and immersive VR experience. ! Oculus Go only !"}]}, "developer_name": null, "developer_privacy_policy_url": "http://rotatorx.deficit-games.de/eula", "developer_terms_of_service_url": "http://rotatorx.deficit-games.de/eula.html", "publisher_name": "DEFICIT Games", "support_website_url": null, "website_url": "http://rotatorx.deficit-games.de/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ARCADE", "FLYING"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "378349304052843"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lhr8-1.oculuscdn.com/v/t64.5771-25/12139007_193856487937379_7824102611287539712_n.png?stp=dst-png_s360x360&_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r4M9wcelE2gQ7kNvwGEvhFp&_nc_oc=AdoFwL-V8PbekKW5nqrNo7J6N54AMfPlWgeE3jFqh32NLyOJHg3DyoMNT61FhbPUHKM&_nc_zt=3&_nc_ht=scontent-lhr8-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2IlSoK1baEb_bPY8dZLKQuadsFEa8fSnc49ahVOSoC_A&oe=69E25123"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "RotatorX", "platform": "ANDROID", "context_category": null, "context_topics": [], "release_date": 1534267884, "lastRevision": {"nodes": [{"id": "364537817398666", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {
/491819980_699557069616466_6864866145573789222_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fTTg-i8gc6kQ7kNvwH_Ai_M&_nc_oc=AdqQFmLk9dVzalrYDRjhMYta7zX3uwlCBuy_uIWuZ_oRHhCGnUqRtX9XyRXlcjFGyW0&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-phMgUcw600c9rz0mk56plisUSlbkJPBmekVB5cX3lOQ&oe=6A3291A4"}, {"file_name": "KrakensRampage_ScreenShot_8.png", "id": "1089508386495766", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/499308010_1089508389829099_792133052928866503_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_Uhi8w2AvoEQ7kNvwHzIDaL&_nc_oc=AdquCh5nz9J7TzSePXnP-uZ0elM9fyAsU2lXyQramC6F5XUZp8n_cHOfkg8Zf1EtuXQ&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_8B1XFVmnMCW7TCxF0ufHLK2F5TaD79R2ATAtK4h9NGA&oe=6A32B017"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "META_COVER_2560x1440.png", "id": "1229204242607619", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/499618251_1229204249274285_4673474842381468651_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w9TrdSMKADYQ7kNvwFS9HMQ&_nc_oc=AdqmG2YMzT79JXdP6rcK_SgtODeD-KiEJxr1hZkGWvTgJi08kJPNMsNaYJoECpboaUc&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8C2e-1CVkhXepYJ04bmgfM0r-SshMVLXi6AZfOWscweQ&oe=6A32BE22"}, "display_name": "Kraken's Rampage", "keywords": [], "long_description": "What if your living room became an ocean\u2026 and you became the Kraken?\n\nKraken\u2019s Rampage is a mixed reality destruction game where toy battleships float through your space, daring you to smash, grab, and devour everything in sight. It\u2019s about scale, chaos, and the joy of pure, over-the-top destruction.\n\nThe idea traces back to a scene from Pee-wee Herman\u2019s Big Adventure (1985), where a kid stages an epic sea monster battle using model ships in a mansion pool. That moment stuck with me for years as the ultimate toy fantasy. With Meta\u2019s Mixed Reality, I can finally live that interaction firsthand. Now fused with the spirit of one of my favorite destruction games, Rampage.", "short_description": "What if your living room became an ocean\u2026 and you became the Kraken?\n\nKraken\u2019s Rampage is a mixed reality destruction game where toy battleships float through your space, daring you to smash, grab, and devour everything in sight. It\u2019s about scale, chaos, and the joy of pure, over-the-top destruction."}]}, "developer_name": null, "developer_privacy_policy_url": "https://pixelsofeight.wixsite.com/lander/krakens-rampage-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Pixels of Eight LLC", "support_website_url": null, "website_url": "http://www.PixelsofEight.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}, {"id": "459781504968480"}, {"id": "644354873106712"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25024877580507096"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PUBLISHED", "id": "1522067686262898"}, {"status": "PUBLISHED", "id": "1474640660303929"}]}, "baseline_offer": {"id": "1474640660303929"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1784566800, "status": "PUBLISHED", "id": "1522067686262898"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "26891961990465303", "version": "1.46"}, "id": "1563559581467134", "channel_name": "LIV
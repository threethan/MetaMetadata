_nc_ss=7f20f&oh=00_AQQS2UhxQ8pyIkvI7x8L2STy38qLpVklffvLUNmzRlH9vg&oe=6AEB5F3A"}, {"file_name": "KrakensRampage_ScreenShot_4.png", "id": "3548758211938153", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499299876_3548758215271486_2228528686757318602_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nVl-S5m8_RcQ7kNvwHOa9vo&_nc_oc=Adq4bOHvQwSl_yx9DKCv1ub1a56bPoBVG9Obh6z41o-GI6P2dtMRGIMOqpkExG-lEWc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTtQ35VgWPikpbShI0oCzeKovcpJkqE7w3m13Rh5aJ1zQ&oe=6AEB3810"}, {"file_name": "KrakensRampage_ScreenShot_5.png", "id": "27343915571892136", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499310720_27343915581892135_803139945449231003_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=koUvR5QLMzMQ7kNvwF36b7B&_nc_oc=Adrzj2IuWXpkj5LtLURhl3jRKd9xXUXSQYNTVGAjHd6sMXYX3gAwdUnN7blq2Y4ZDFs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSb26yJbIQi2uVCOsvdyF-z0ZDRxqcaabqMGncjz2mV0Q&oe=6AEB2EA0"}, {"file_name": "KrakensRampage_ScreenShot_7.png", "id": "1891875891526191", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499623601_1891875894859524_3722263332169822380_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FWZTbImxGoYQ7kNvwEEU4dN&_nc_oc=AdqbIvbsaqealCfC2l7zm7DMbxB15myIOyYrq3Id7L4GOYqnJZ8SHYpNbqw3A6TYuKI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSeExb_d1fgS8Z_ZCIapvy5GKPA7VpLPD02ikn1szqT2g&oe=6AEB4D2C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "META_COVER_2560x1440.png", "id": "1229204242607619", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499618251_1229204249274285_4673474842381468651_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FBXgN4Be7m4Q7kNvwGRsLq1&_nc_oc=AdpHgzhP_0JnqyRSrwAuHkjwYvvvUQrA93v98a0WQh_fJ0Fa-9rjJLhVuosmvijPG6k&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSl1QqabE66TWjKKXRaumSA6XcVBlDPKTtOi4bS_qmtVw&oe=6AEB5022"}, "display_name": "Kraken's Rampage", "keywords": ["kraken", "kaiju", "pirate", "destruction", "monster"], "long_description": "# Kraken's Rampage\n\n**Your living room. Their problem.**\n\nBecome the legendary Kraken and turn your home into a battlefield as Skelly fleets sail across your real-world surroundings. Crush ships with massive tentacles, collect treasure, unlock powerful abilities, and battle fearsome Skelly captains in an epic mixed reality adventure.\n##\n**Become the Kraken**\n\n- Control powerful tentacles using hand tracking or controllers.\n**Grab, crush, eat, and sink** enemy ships.\n{2043614509913077}\n{3721657087986871}\n##\n**Battle Pirate Fleets**\n\n- Face unique enemy factions, dangerous captains, and massive boss ships.\n**Survive** increasingly challenging naval encounters.\n{1020139077169128}\n##\n**Turn Your Home Into The Battlefield**\n\n- Transform your room into a living ocean with mixed reality.\nWatch **fleets navigate around your furniture** and through your environment.\n{27002110492750486}\n##\n**Unlock New Powers**\n\n- Grow stronger as you progress.\nGain powerful abilities to **devastate** entire fleets.\n{990046916946188}\n##\nThe Skellies came looking for your young.\n\n**They found YOU.** \n\nSlay.\n\n\n\n\n", "short_description": "What if your living room became an ocean\u2026 and you became the Kraken?\n\nKraken\u2019s Rampage is a mixed reality destruction game where toy battleships float through your space, daring you to smash, grab, and devour everything in sight. It\u2019s about scale, chaos, and the joy of pure, over-the-top destruction."}]}, "developer_name": null, "developer_privacy_policy_url": "https://pixelsofeight.wixsite.com/lander/krakens-rampage-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Pixels of Eight LLC", "support_website_url": null, "website_url": "http://www.PixelsofEight.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_categ
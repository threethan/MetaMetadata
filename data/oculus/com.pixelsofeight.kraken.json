t64.5771-25/491819980_699557069616466_6864866145573789222_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WR6L4XOrFZsQ7kNvwGLpXBB&_nc_oc=AdprKQvNiEB_SIiWyRR6ZOJVuEAUm3ez5qqa7yPgfPfr5stafDpxdwSAG6p31bChOOE&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_-Gb4lA_n6Fa36ISouBnLgHODsOjtGC1pt40cAitIXDg&oe=6A36BE64"}, {"file_name": "KrakensRampage_ScreenShot_8.png", "id": "1089508386495766", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/499308010_1089508389829099_792133052928866503_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XAroTknR-OUQ7kNvwFZCvG4&_nc_oc=AdpjMwPmkJiveyWeksV_nhrVePVm4c_8WbIN-pXF3RY7-k12LLIBES04hy9yxBhC3Xk&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8ReWDBHikOS1_pic_O-06y64OtW1DNykoCXUgXfYybAA&oe=6A36A497"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "META_COVER_2560x1440.png", "id": "1229204242607619", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/499618251_1229204249274285_4673474842381468651_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GvDLCzJ9DaoQ7kNvwEWz9kF&_nc_oc=Adof6l2GtXZV3O-ODCz6ZmsZCYIibBgTi5JpgjVMpS53nED2nXEBPds7uC5B7Pa7i64&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9WgdugDst75AsYdM_DenL227RHvVDXXJsk19YcanDcKQ&oe=6A36B2A2"}, "display_name": "Kraken's Rampage", "keywords": [], "long_description": "What if your living room became an ocean\u2026 and you became the Kraken?\n\nKraken\u2019s Rampage is a mixed reality destruction game where toy battleships float through your space, daring you to smash, grab, and devour everything in sight. It\u2019s about scale, chaos, and the joy of pure, over-the-top destruction.\n\nThe idea traces back to a scene from Pee-wee Herman\u2019s Big Adventure (1985), where a kid stages an epic sea monster battle using model ships in a mansion pool. That moment stuck with me for years as the ultimate toy fantasy. With Meta\u2019s Mixed Reality, I can finally live that interaction firsthand. Now fused with the spirit of one of my favorite destruction games, Rampage.", "short_description": "What if your living room became an ocean\u2026 and you became the Kraken?\n\nKraken\u2019s Rampage is a mixed reality destruction game where toy battleships float through your space, daring you to smash, grab, and devour everything in sight. It\u2019s about scale, chaos, and the joy of pure, over-the-top destruction."}]}, "developer_name": null, "developer_privacy_policy_url": "https://pixelsofeight.wixsite.com/lander/krakens-rampage-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Pixels of Eight LLC", "support_website_url": null, "website_url": "http://www.PixelsofEight.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}, {"id": "459781504968480"}, {"id": "644354873106712"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25024877580507096"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PUBLISHED", "id": "1522067686262898"}, {"status": "PUBLISHED", "id": "1474640660303929"}]}, "baseline_offer": {"id": "1474640660303929"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1784566800, "status": "PUBLISHED", "id": "1522067686262898"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "26891961990465303", "version": "1.46"}, "id": "1563559581467134", "channel
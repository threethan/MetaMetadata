yYuy-hjr6L04&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8Sfs2PlyvQcbEL62a6FPK59ytu6wNSvdGT6giq97qpNQ&oe=6A2C0E90"}, {"file_name": "KrakensRampage_ScreenShot_5.png", "id": "27343915571892136", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/499310720_27343915581892135_803139945449231003_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0uqiM4iVpe0Q7kNvwExtxzz&_nc_oc=Adoudm-h2mC5KEF0ifnEAhyUxwhNGoAnoTrZJQctwmfuSFiWEHdfYfzRKhOcCdIXgd0&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-k4Udb6t2YymdjhHJFBaja_m0temnj7iHkCZOjqKAE9g&oe=6A2C0520"}, {"file_name": "KrakensRampage_ScreenShot_7.png", "id": "1891875891526191", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/499623601_1891875894859524_3722263332169822380_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T8R5Q4HBC7EQ7kNvwH6_Img&_nc_oc=Adrq6ClRb6Yz1LPJzEplu_0EWFd1fFN_hwXARGcIAp-Wl9zKlsnXyZX2ZKGk3vu0Csw&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af98p-4E82s9bZqcjWghKTuhgY3cCQCdVCEXioo1za3Zag&oe=6A2C23AC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "META_COVER_2560x1440.png", "id": "1229204242607619", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/499618251_1229204249274285_4673474842381468651_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bzwVbhKMcFwQ7kNvwGmXAGr&_nc_oc=AdqlKcRQRW_zYdM4fz5T5DAtzfYMcT5yVYR5nwBwKW0zmNUdOgnatEkjNgqfNizIEF8&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_mXSRlnyFOvvgUcjoirXDIGl5CdnXahUkhfI3avP4QVw&oe=6A2C26A2"}, "display_name": "Kraken's Rampage", "keywords": ["kraken", "kaiju", "pirate", "destruction", "monster"], "long_description": "# Kraken's Rampage\n\n**Your living room. Their problem.**\n\nBecome the legendary Kraken and turn your home into a battlefield as Skelly fleets sail across your real-world surroundings. Crush ships with massive tentacles, collect treasure, unlock powerful abilities, and battle fearsome Skelly captains in an epic mixed reality adventure.\n##\n**Become the Kraken**\n\n- Control powerful tentacles using hand tracking or controllers.\n**Grab, crush, eat, and sink** enemy ships.\n{2043614509913077}\n{3721657087986871}\n##\n**Battle Pirate Fleets**\n\n- Face unique enemy factions, dangerous captains, and massive boss ships.\n**Survive** increasingly challenging naval encounters.\n{1020139077169128}\n##\n**Turn Your Home Into The Battlefield**\n\n- Transform your room into a living ocean with mixed reality.\nWatch **fleets navigate around your furniture** and through your environment.\n{27002110492750486}\n##\n**Unlock New Powers**\n\n- Grow stronger as you progress.\nGain powerful abilities to **devastate** entire fleets.\n{990046916946188}\n##\nThe Skellies came looking for your young.\n\n**They found the YOU.** \n\nSlay.\n\n\n\n\n", "short_description": "What if your living room became an ocean\u2026 and you became the Kraken?\n\nKraken\u2019s Rampage is a mixed reality destruction game where toy battleships float through your space, daring you to smash, grab, and devour everything in sight. It\u2019s about scale, chaos, and the joy of pure, over-the-top destruction."}]}, "developer_name": null, "developer_privacy_policy_url": "https://pixelsofeight.wixsite.com/lander/krakens-rampage-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Pixels of Eight LLC", "support_website_url": null, "website_url": "http://www.PixelsofEight.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "644354873106712"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"]
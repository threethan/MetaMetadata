_nc_ss=7f20f&oh=00_AQQdie_g9wU-swMLYyUxndMsDRU5YzCo6xm-YYZ8pxPpnQ&oe=6AF9DFBA"}, {"file_name": "KrakensRampage_ScreenShot_4.png", "id": "3548758211938153", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/499299876_3548758215271486_2228528686757318602_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wEOUCXfALigQ7kNvwGfz3Gd&_nc_oc=AdrzmAJqUjZRBPX2-k_KDxnoY2HSztTOIj20SPD5A60Ei6IlRWOYWTlIXgY0hwIM1Vk&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSFhdhvWBx4HuF8xA1_Tbzntj9eeDIOadZnpvKVOpZ1rw&oe=6AF9B890"}, {"file_name": "KrakensRampage_ScreenShot_5.png", "id": "27343915571892136", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/499310720_27343915581892135_803139945449231003_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=teZ8OL9cCV4Q7kNvwF4TR5z&_nc_oc=Adqns1O-x3Tl0d8NkZA1tlVd_L2KxaOXDKbMCAibXkx61yA6JzOLbFLTfC5Uef6CmqE&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQROrjXZ3yYmvwhEYP-UU-zGxCsmyaTv5xhEhsxSdcOEeA&oe=6AF9E760"}, {"file_name": "KrakensRampage_ScreenShot_7.png", "id": "1891875891526191", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/499623601_1891875894859524_3722263332169822380_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ugC5Xbo-V-YQ7kNvwGC5Tj4&_nc_oc=Adr-y8aX6r7D_0YTdzWCOr5Wf4dHZPdS_ky7R8_FttrXJYBLYePDhUUYIUJvZtyquZw&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTfOxgzO1t67cVONGNnvezpyflUom-Tr8o0F1PGbqvF-g&oe=6AF9CDAC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "META_COVER_2560x1440.png", "id": "1229204242607619", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/499618251_1229204249274285_4673474842381468651_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YX2CNgkuuG0Q7kNvwE3U96e&_nc_oc=Adp3LDei2-k81MC-4B07rP_mHqdd6JJQAmc9oZSqDThdQZ3TE__YiV7I7TxIuka6CKI&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTBSHCcDppXIhUZ66uLWnmoP_Inx20qs7jyMaE1l4ZrIA&oe=6AF9D0A2"}, "display_name": "Kraken's Rampage", "keywords": ["kraken", "kaiju", "pirate", "destruction", "monster"], "long_description": "# Kraken's Rampage\n\n**Your living room. Their problem.**\n\nBecome the legendary Kraken and turn your home into a battlefield as Skelly fleets sail across your real-world surroundings. Crush ships with massive tentacles, collect treasure, unlock powerful abilities, and battle fearsome Skelly captains in an epic mixed reality adventure.\n##\n**Become the Kraken**\n\n- Control powerful tentacles using hand tracking or controllers.\n**Grab, crush, eat, and sink** enemy ships.\n{2043614509913077}\n{3721657087986871}\n##\n**Battle Pirate Fleets**\n\n- Face unique enemy factions, dangerous captains, and massive boss ships.\n**Survive** increasingly challenging naval encounters.\n{1020139077169128}\n##\n**Turn Your Home Into The Battlefield**\n\n- Transform your room into a living ocean with mixed reality.\nWatch **fleets navigate around your furniture** and through your environment.\n{27002110492750486}\n##\n**Unlock New Powers**\n\n- Grow stronger as you progress.\nGain powerful abilities to **devastate** entire fleets.\n{990046916946188}\n##\nThe Skellies came looking for your young.\n\n**They found YOU.** \n\nSlay.\n\n\n\n\n", "short_description": "What if your living room became an ocean\u2026 and you became the Kraken?\n\nKraken\u2019s Rampage is a mixed reality destruction game where toy battleships float through your space, daring you to smash, grab, and devour everything in sight. It\u2019s about scale, chaos, and the joy of pure, over-the-top destruction."}]}, "developer_name": null, "developer_privacy_policy_url": "https://pixelsofeight.wixsite.com/lander/krakens-rampage-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Pixels of Eight LLC", "support_website_url": null, "website_url": "http://www.PixelsofEight.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_categ
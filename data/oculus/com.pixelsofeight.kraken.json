_nc_ss=7f20f&oh=00_AQCd3899iKE_tbQI7RwJgz4JtHqGcvk2JGhRUCu5ioeyew&oe=6A4A4FFA"}, {"file_name": "KrakensRampage_ScreenShot_4.png", "id": "3548758211938153", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499299876_3548758215271486_2228528686757318602_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DnrS-t4lDkoQ7kNvwEMIjly&_nc_oc=AdoOv26dVB9cqVWf4nfmqSVPvRqX_0kyKgv7ZDq_FybS6f2CERWIE2XFH-0hI4leUJI&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDOJR96_sYHlEBKWE9Xg5FFi6t9P5UKlwmGUwvrkbjDKQ&oe=6A4A6110"}, {"file_name": "KrakensRampage_ScreenShot_5.png", "id": "27343915571892136", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499310720_27343915581892135_803139945449231003_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=muvD08yofEQQ7kNvwH6SjrA&_nc_oc=AdrOCG6Wa5RNvfS9sML60xnKhdjPKERIwffC6xW5k1FkjASpevopyQvD0ooqfNEGkGM&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA6PZ70hGehfwcCAFD3GfYh8q0J2kDHgi34CzYkdbpEDQ&oe=6A4A57A0"}, {"file_name": "KrakensRampage_ScreenShot_7.png", "id": "1891875891526191", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499623601_1891875894859524_3722263332169822380_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ye5ap3VU6r0Q7kNvwE-Q8xN&_nc_oc=Adq7V-Z4NHvCHIOSMH1ns7-xy5CDvb5XBbnks0DZKVHysohdXf0YVr3-Wbpw8xPCQvs&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBkOdKEmbV0ayAZfBqMuCDBtT2C31R45uG8a8wFy0l2eg&oe=6A4A762C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "META_COVER_2560x1440.png", "id": "1229204242607619", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499618251_1229204249274285_4673474842381468651_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nyTKBNDu8v4Q7kNvwENN-TD&_nc_oc=AdokE4jgyUNt9mYdVNVWQeVZKxt_3J9Je6cTaFaxS22pTuxFcJnPoPZfwctrFNcT4Yg&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCi6u9zvK7EYTaEIpueMMTHZspBeGiKChU_HvTvJTVyGQ&oe=6A4A7922"}, "display_name": "Kraken's Rampage", "keywords": ["kraken", "kaiju", "pirate", "destruction", "monster"], "long_description": "# Kraken's Rampage\n\n**Your living room. Their problem.**\n\nBecome the legendary Kraken and turn your home into a battlefield as Skelly fleets sail across your real-world surroundings. Crush ships with massive tentacles, collect treasure, unlock powerful abilities, and battle fearsome Skelly captains in an epic mixed reality adventure.\n##\n**Become the Kraken**\n\n- Control powerful tentacles using hand tracking or controllers.\n**Grab, crush, eat, and sink** enemy ships.\n{2043614509913077}\n{3721657087986871}\n##\n**Battle Pirate Fleets**\n\n- Face unique enemy factions, dangerous captains, and massive boss ships.\n**Survive** increasingly challenging naval encounters.\n{1020139077169128}\n##\n**Turn Your Home Into The Battlefield**\n\n- Transform your room into a living ocean with mixed reality.\nWatch **fleets navigate around your furniture** and through your environment.\n{27002110492750486}\n##\n**Unlock New Powers**\n\n- Grow stronger as you progress.\nGain powerful abilities to **devastate** entire fleets.\n{990046916946188}\n##\nThe Skellies came looking for your young.\n\n**They found YOU.** \n\nSlay.\n\n\n\n\n", "short_description": "What if your living room became an ocean\u2026 and you became the Kraken?\n\nKraken\u2019s Rampage is a mixed reality destruction game where toy battleships float through your space, daring you to smash, grab, and devour everything in sight. It\u2019s about scale, chaos, and the joy of pure, over-the-top destruction."}]}, "developer_name": null, "developer_privacy_policy_url": "https://pixelsofeight.wixsite.com/lander/krakens-rampage-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Pixels of Eight LLC", "support_website_url": null, "website_url": "http://www.PixelsofEight.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_categ
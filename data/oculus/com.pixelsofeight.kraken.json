_nc_ss=7f20f&oh=00_AQImBhQthvGLujp9u1hRCGkiBzkvEq7SClbI-8jIXHKOpw&oe=6A9850BA"}, {"file_name": "KrakensRampage_ScreenShot_4.png", "id": "3548758211938153", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499299876_3548758215271486_2228528686757318602_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C8pxQn_YpwYQ7kNvwGmlEMq&_nc_oc=AdqYa-vSzIO3RkY2phzcgKBCGXm-xwhDQca6jTuw4upjvj_4ZWJ3L7ssPqQxmk3EusU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK2MIeQf5Pt8pNC4y8hVEyxh5G_VF6X_IbJOI-vSqab7Q&oe=6A9861D0"}, {"file_name": "KrakensRampage_ScreenShot_5.png", "id": "27343915571892136", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499310720_27343915581892135_803139945449231003_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Et2qm4Ws4_AQ7kNvwH6wSAY&_nc_oc=Adpgtx5uuibXgq6jOLIA0_q88AOiUqF2uhRAs7Zu_eMvgzzigTiEjbEgRFewO7N4Uu4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL33_inbJqz0uVBqbHnjSq_JakIQKEQrBp0oyWZKUbA5A&oe=6A985860"}, {"file_name": "KrakensRampage_ScreenShot_7.png", "id": "1891875891526191", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499623601_1891875894859524_3722263332169822380_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YMi-H8LRWJ0Q7kNvwEnEPwh&_nc_oc=AdoU9qtTZ0_tkyNk6eIaJMlm2Z1SNbPOn9ohJy97eMGMCTrIoNvQ4-qmJPqhgAIqcGY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKbr_9U6r6Ori2tn0CU3oYwkbJ6xWa5Rr2ul1IM_ZkB4w&oe=6A983EAC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "META_COVER_2560x1440.png", "id": "1229204242607619", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499618251_1229204249274285_4673474842381468651_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yGhTNlLHBwUQ7kNvwHOu8W3&_nc_oc=AdquagLgrX7_V3t_-c3f8ZtR2pOPCWWPcQ7kpJJjIT-bKDTEDKCIqlA-hhvQq9in1ZM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJvaoiUw5gU1njnYYyVfBRvUCtiSrqoSuQ1fOnf_OyDww&oe=6A9841A2"}, "display_name": "Kraken's Rampage", "keywords": ["kraken", "kaiju", "pirate", "destruction", "monster"], "long_description": "# Kraken's Rampage\n\n**Your living room. Their problem.**\n\nBecome the legendary Kraken and turn your home into a battlefield as Skelly fleets sail across your real-world surroundings. Crush ships with massive tentacles, collect treasure, unlock powerful abilities, and battle fearsome Skelly captains in an epic mixed reality adventure.\n##\n**Become the Kraken**\n\n- Control powerful tentacles using hand tracking or controllers.\n**Grab, crush, eat, and sink** enemy ships.\n{2043614509913077}\n{3721657087986871}\n##\n**Battle Pirate Fleets**\n\n- Face unique enemy factions, dangerous captains, and massive boss ships.\n**Survive** increasingly challenging naval encounters.\n{1020139077169128}\n##\n**Turn Your Home Into The Battlefield**\n\n- Transform your room into a living ocean with mixed reality.\nWatch **fleets navigate around your furniture** and through your environment.\n{27002110492750486}\n##\n**Unlock New Powers**\n\n- Grow stronger as you progress.\nGain powerful abilities to **devastate** entire fleets.\n{990046916946188}\n##\nThe Skellies came looking for your young.\n\n**They found YOU.** \n\nSlay.\n\n\n\n\n", "short_description": "What if your living room became an ocean\u2026 and you became the Kraken?\n\nKraken\u2019s Rampage is a mixed reality destruction game where toy battleships float through your space, daring you to smash, grab, and devour everything in sight. It\u2019s about scale, chaos, and the joy of pure, over-the-top destruction."}]}, "developer_name": null, "developer_privacy_policy_url": "https://pixelsofeight.wixsite.com/lander/krakens-rampage-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Pixels of Eight LLC", "support_website_url": null, "website_url": "http://www.PixelsofEight.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_categ
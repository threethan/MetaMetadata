ong_description": "Ready for an unsettling Virtual Reality adventure? Spooky Pavians combines fast-paced, arm-movement locomotion with a creepy, mysterious atmosphere!Jump into a world where dynamic movement meets exploration. Search for hidden keypads, uncover correct pin codes across the map, unlock restricted areas, and figure out what secrets lie just beyond your reach.   Key Features:Arm-Based Locomotion: Master the intuitive, physics-driven movement system without relying on thumbsticks.Chilling Atmosphere: Unique maps filled with eerie areas, mysterious riddles, and built-in suspense.   Keypad & Door Puzzles: Hunt for hidden codes scattered around the environment to open sealed doors and passages.   Social Multiplayer: Hang out with friends, join room codes, and explore together.   Regular Updates: Enjoy new cosmetics, map tweaks, and fresh content added over time!", "short_description": "Spooky Pavians is an atmospheric VR horror fangame with physics-based, arm-driven locomotion! Explore dark locations, search for keypad codes, unlock secrets, and experience pure suspense with your friends."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1ywp6aPeDjZl0VxxPfylyjPmAhXCc8RPKZt2GGTht57I/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Spooky Games Poland", "support_website_url": null, "website_url": "https://sites.google.com/view/tospookygames/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOU
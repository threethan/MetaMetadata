ions into your AR workspace on Meta Quest. Connect through RDP, VNC, and SSH to work with your computers and servers using one professional tool. Open a graphical desktop when you need the full interface, or use SSH when the command line is the right tool for the job. Farside is built for developers, system administrators, and IT professionals who want their remote systems within reach. Requires access to a host configured for the selected protocol and a working network connection.", "short_description": "Connect to remote desktops and terminals through RDP, VNC, and SSH in an AR workspace built for IT professionals and developers."}]}, "developer_name": "OceanSideVR", "developer_privacy_policy_url": "https://oceanside-vr.com/farside/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "OceanSideVR", "support_website_url": "https://github.com/jmez11/farside-workspace/issues", "website_url": "https://oceanside-vr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "393222478507326"}, {"id": "1063584910766706"}, {"id": "1055187466124150"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "cs", "da", "de", "el", "es", "fi", "fr", "it", "ja", "ko", "nb", "nl", "pl", "pt_BR", "pt", "ro", "ru", "sv", "tr", "zh_CN", "zh_HK", "zh_TW"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH", "TRACKED_KEYBOARD"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1512745424247479"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/499628067_17024100516113
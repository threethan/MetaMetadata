5/65396729_1225052078868354_6945820870147360559_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sf_iiILsUxMQ7kNvwGwLyVA&_nc_oc=AdqpDf8v-86RryWtdtkGXbVdDJBsNU6Of-M59wDmmn6s3ac2KftacvezWBrewbEHxpE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7sUZPzDmQzCXMfBiet9yj-F918hpjbIcEaTniUhtqXEQ&oe=6A1D8D1E"}, {"file_name": "4.png", "id": "975198817093493", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/57566693_975198820426826_7097624739394196541_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rvQ_PPjdik8Q7kNvwF_K3fJ&_nc_oc=AdrKeKnxxifOtZdpp8NVEwobF_f5AY3zgKcOm19z0g6q_D-qa9YkqsGA2K7JMhzsW1w&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5ZvNTnih77aSirSo6x3q7tImrpwTgNfvk0HQw2GTfMHw&oe=6A1D8ECC"}, {"file_name": "1.png", "id": "415893571368646", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39001715_415893574701979_3461447245540982035_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5l-Bln4YZsAQ7kNvwGmQA9Y&_nc_oc=AdoWZxkN9_Ca_Y0m0o7NHMx9tz2ZLXRHz27O6VJfdANXdm8cUKMfk0bCARlC6IuL54k&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5gJqVIRwZj_dPSPeGjtxntvUBE_rrO3vl5X4EHrm1kEA&oe=6A1DAA16"}, {"file_name": "3.png", "id": "662596896051796", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974523_662596899385129_8527079563659693432_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BC3hHnZQmW4Q7kNvwGhRGK4&_nc_oc=Ado12_wgPsPNenqWJk77GVnpzLpVsNJgqbbB72OUw76dNm-ZOHa-tVsRuaIbYyQwDYg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6ZvHQq3msohlF6OFvP1s-QfRl6AsnDBQDULUsxb5C9uQ&oe=6A1DA894"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "gameplayVR3.png", "id": "492345567046352", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974804_492345570379685_6511341930176300148_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WfwM7BxAzaAQ7kNvwFcA-sc&_nc_oc=AdqVIof7X2o_-bEA6J1VWAJSTZvoOmARyO4HoB50JQ1cG0NS5Yh7WgRrmKkJnN_8VbI&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6BiddTqaonjEoB2_AMHwiZU-ShDayTW7YK_g3GgmNiDw&oe=6A1D7BAD"}, "display_name": "Escape Simulator", "keywords": ["escape", "room", "coop", "multiplayer", "simulator"], "long_description": "Escape Simulator is a first-person puzzler you can **play solo or in an online co-op** (best with 2-3 players, but playable with up to 8!). Explore a growing set of **highly interactive escape rooms**. Pick up and examine everything, break objects, solve locks, and decipher puzzles to escape! After finishing the main game, watch for free content updates and explore rooms **built by our awesome community**.\n\n# \u2b50**REVIEWS** \n\"What I've seen has left me considerably impressed.\" - UploadVR\n\n# \u2692\ufe0f**COMMUNITY-MADE ROOMS**\nAfter finishing the main game **explore numerous rooms** built by our amazing community.\n\n# \ud83e\udd1d**ONLINE CO-OP**\nAll rooms are playable in an online co-op. Play with up to 8 players (best played with 2-3). Customize your character and join friends to solve puzzles together. More heads are better than one!\n\n# \ud83e\udde9**INTERACTIVE PUZZLES**\nExplore 28+ official rooms filled with puzzles designed by real-life escape room operators. If it\u2019s not nailed down, you can pick it up.\n\n# \ud83d\udd0d**EXEMINE EVERYTHING**\nRead books, examine ancient artifacts, and find clues to riddles. Need to cross-reference a clue? No problem - just pin it!\n\n# \ud83c\udfc6**WANT MORE?**\nThe game features additional content in the form of Addons with 4 large rooms each: \n- **Steampunk**: Solve four new rooms on the beautiful steampunk airship \"Valor.\"\n- **Wild West**: Become an outlaw in the Wild West.\n- **Magic**: Embrace your magic potential, and follow in the footsteps of great witches and wizards. \n\n", "short_description": "First-person puzzler you can play solo or in an online co-op. Explore a set of highly interactive escape rooms. Move furniture, pick up and examine everything, smash pots and break 
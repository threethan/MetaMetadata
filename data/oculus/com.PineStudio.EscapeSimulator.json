25/65396729_1225052078868354_6945820870147360559_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tYDl9WcJx1sQ7kNvwHqOV4I&_nc_oc=Adp6nEKAHL4521fFIwmEWzDnHg1P5Z4WTq5bFKXXllWMeTaXYlDjisz2G5LLne1LDDo&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGhwSQp7zDD8DaC38KosRKfH87PT1otE01q6nCKLmOzGg&oe=6A87051E"}, {"file_name": "4.png", "id": "975198817093493", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/57566693_975198820426826_7097624739394196541_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ab07Bzz8o2gQ7kNvwFEAFbD&_nc_oc=AdoBXQUa6M76uWXQroYJxGbtcFRmwFzmcOnED-GAG0iSX640_tIKNhhzKNBi-r81kw8&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGvMZRaYNa_REfbZ-5i61kXbGtASdm_lzAmhEoMZvpECg&oe=6A86CE8C"}, {"file_name": "1.png", "id": "415893571368646", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39001715_415893574701979_3461447245540982035_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cu30QttMwS0Q7kNvwF0YbHX&_nc_oc=AdrDR0uaTT0vYUAzpKyeI_OsO98sgA78_9eu8xHKuS3RDMNKCXiIROQk-xrmw1V3WgA&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFEeq8AgirhA3r6rHibqoP7drP_XkexlDf1pKVLQUvihA&oe=6A86E9D6"}, {"file_name": "3.png", "id": "662596896051796", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974523_662596899385129_8527079563659693432_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ew4a5-Tvz44Q7kNvwHvgom0&_nc_oc=AdpREgWFtwfzlxDU0BYGucq5x1ISW5Lew8NSPWwWYPozFuSnXHXkOX0SP5ty_irrjeQ&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH4-V99_fai4qrie20C12a4FlbKa0BtwcnosiW5MGLJGQ&oe=6A86E854"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "gameplayVR3.png", "id": "492345567046352", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974804_492345570379685_6511341930176300148_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WzXOMOA5W3IQ7kNvwFG1DcZ&_nc_oc=AdpW8IumNBlMBpm0AAGYPnA_hdWuY4AE6vsI2z6CCBZ5PofhDPoGYLeZUjRWpsuRHI0&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGuG8Kk04xKl4BSvxCnldoLPz0H45Ly39BjPdweYdgBug&oe=6A86F3AD"}, "display_name": "Escape Simulator", "keywords": ["escape", "room", "coop", "multiplayer", "simulator"], "long_description": "Escape Simulator is a first-person puzzler you can **play solo or in an online co-op** (best with 2-3 players, but playable with up to 8!). Explore a growing set of **highly interactive escape rooms**. Pick up and examine everything, break objects, solve locks, and decipher puzzles to escape! After finishing the main game, watch for free content updates and explore rooms **built by our awesome community**.\n\n# \u2b50**REVIEWS** \n\"What I've seen has left me considerably impressed.\" - UploadVR\n\n# \u2692\ufe0f**COMMUNITY-MADE ROOMS**\nAfter finishing the main game **explore numerous rooms** built by our amazing community.\n\n# \ud83e\udd1d**ONLINE CO-OP**\nAll rooms are playable in an online co-op. Play with up to 8 players (best played with 2-3). Customize your character and join friends to solve puzzles together. More heads are better than one!\n\n# \ud83e\udde9**INTERACTIVE PUZZLES**\nExplore 28+ official rooms filled with puzzles designed by real-life escape room operators. If it\u2019s not nailed down, you can pick it up.\n\n# \ud83d\udd0d**EXEMINE EVERYTHING**\nRead books, examine ancient artifacts, and find clues to riddles. Need to cross-reference a clue? No problem - just pin it!\n\n# \ud83c\udfc6**WANT MORE?**\nThe game features additional content in the form of Addons with 4 large rooms each: \n- **Steampunk**: Solve four new rooms on the beautiful steampunk airship \"Valor.\"\n- **Wild West**: Become an outlaw in the Wild West.\n- **Magic**: Embrace your magic potential, and follow in the footsteps of great witches and wizards. \n\n", "short_description": "First-person puzzler you can play solo or in an online co-op. Explore a set of highly interactive escape rooms. Move furniture, pick up and examine everything, smash pots and break
5/65396729_1225052078868354_6945820870147360559_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=veJj1_lsJpoQ7kNvwGFiFcB&_nc_oc=Adrdvu81YI_f0g9MocmLlS_C0Z_I-3qofi1E4D0__3Vw9IPF5g5hgg0q6U3as9DbT44&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af43Fl7OpBtXbF6abna0CopJJ8ypk2DarETPmZqsJSR4cQ&oe=6A0B181E"}, {"file_name": "4.png", "id": "975198817093493", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/57566693_975198820426826_7097624739394196541_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3NfGRTuuTXAQ7kNvwHE51pf&_nc_oc=AdpSsw_ReGV1akMbnc5nx2BcQWgQbTXoGdY8_ncUoGit8lxY7Cxhs0OrP3Gl7B2QHWo&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5gOclrJIgiCRHQ0D76W_xoQ4GCzX6Gjf83VaiMkotm-Q&oe=6A0B19CC"}, {"file_name": "1.png", "id": "415893571368646", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39001715_415893574701979_3461447245540982035_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=102SaweB_KgQ7kNvwEHyb6z&_nc_oc=AdqKp-Koj3SoCIbV4pzQZZm_PgllMESvLZmqrtsvtJzu03ATPgpX0ZB0d_CnBI7b69M&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7HK5gfjiRj3ew7xs96FKLIlfU1WIGzQ6XA1aMls0HKvw&oe=6A0B3516"}, {"file_name": "3.png", "id": "662596896051796", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974523_662596899385129_8527079563659693432_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WlrXG1I7-t8Q7kNvwFBIl4W&_nc_oc=Adr1g5ti3mh48fp2aE5oJcrTjBlk7epESExF19hc9qq1t4WQYfckrDgyc7oj2r_TQZE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4duwKGiC7mkt4vhzujPgBQvUD-WuZtofjNDazRtJymTw&oe=6A0B3394"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "gameplayVR3.png", "id": "492345567046352", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974804_492345570379685_6511341930176300148_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sNy_yXZTn9MQ7kNvwH_LB3C&_nc_oc=Adpbz1JNiLw4COAyWmR442_gUrWF0A70NvsAHgkjpxbolbnFkPGsY0s32rGJEIU70-4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4N7K4qU5vmetJUZwJl3N9eZzzHt0Xek2yL6UcCJdO54w&oe=6A0B06AD"}, "display_name": "Escape Simulator", "keywords": ["escape", "room", "coop", "multiplayer", "simulator"], "long_description": "Escape Simulator is a first-person puzzler you can **play solo or in an online co-op** (best with 2-3 players, but playable with up to 8!). Explore a growing set of **highly interactive escape rooms**. Pick up and examine everything, break objects, solve locks, and decipher puzzles to escape! After finishing the main game, watch for free content updates and explore rooms **built by our awesome community**.\n\n# \u2b50**REVIEWS** \n\"What I've seen has left me considerably impressed.\" - UploadVR\n\n# \u2692\ufe0f**COMMUNITY-MADE ROOMS**\nAfter finishing the main game **explore numerous rooms** built by our amazing community.\n\n# \ud83e\udd1d**ONLINE CO-OP**\nAll rooms are playable in an online co-op. Play with up to 8 players (best played with 2-3). Customize your character and join friends to solve puzzles together. More heads are better than one!\n\n# \ud83e\udde9**INTERACTIVE PUZZLES**\nExplore 28+ official rooms filled with puzzles designed by real-life escape room operators. If it\u2019s not nailed down, you can pick it up.\n\n# \ud83d\udd0d**EXEMINE EVERYTHING**\nRead books, examine ancient artifacts, and find clues to riddles. Need to cross-reference a clue? No problem - just pin it!\n\n# \ud83c\udfc6**WANT MORE?**\nThe game features additional content in the form of Addons with 4 large rooms each: \n- **Steampunk**: Solve four new rooms on the beautiful steampunk airship \"Valor.\"\n- **Wild West**: Become an outlaw in the Wild West.\n- **Magic**: Embrace your magic potential, and follow in the footsteps of great witches and wizards. \n\n", "short_description": "First-person puzzler you can play solo or in an online co-op. Explore a set of highly interactive escape rooms. Move furniture, pick up and examine everything, smash pots and break 
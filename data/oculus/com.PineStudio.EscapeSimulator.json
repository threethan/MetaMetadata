n.com/v/t64.5771-25/65396729_1225052078868354_6945820870147360559_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5CQGECF_jSoQ7kNvwH9P9Zg&_nc_oc=AdptKqZTuW1sBcxz2ZWnXXUgJPSq19Dwkv3mtuqaZLm53SytrxhzrHi1quBgHUlYbYE&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8gXtt3HYz5vZBjDRmJkPbSFl_LCL79GjlKijiTG0RKLA&oe=6A36999E"}, {"file_name": "4.png", "id": "975198817093493", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/57566693_975198820426826_7097624739394196541_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=19g0jEgmARsQ7kNvwE0E4GC&_nc_oc=AdqaJqGl81Gjy2q1ww4GOEnG_kYrPvTj4jyKRbjE_grVVEWokjIclxGjpkrCB9MM_UA&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8VceuJX6Lmsmkdqv_rtX9xsDST8spqR3VyIPZsSmExFA&oe=6A369B4C"}, {"file_name": "1.png", "id": "415893571368646", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/39001715_415893574701979_3461447245540982035_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YeCYgAD-dBIQ7kNvwHp5oK6&_nc_oc=AdqgD4FkTLROHnnxUrg5I4z27RnYjVGl63ACpDL7vgMBpidmWuIZ-fmKTyId164G3c8&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8Ntw-8nm7LRNMi-ksefVxog5WLejz8miJNzIyG_4x7Jg&oe=6A36B696"}, {"file_name": "3.png", "id": "662596896051796", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/38974523_662596899385129_8527079563659693432_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V7Xwt8_4mcYQ7kNvwEF8_Ar&_nc_oc=Adr9ZuCZT652BsjC2yWJTsFE2iCjTcYqjKtc6S452gWhsLg6j-7vk91IBfRvMkLbYUE&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8KsUF7M2xG7sEEP_kUmZsZc--f2cHYsRM1WS8Gymoplw&oe=6A36B514"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "gameplayVR3.png", "id": "492345567046352", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/38974804_492345570379685_6511341930176300148_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SlbGMrfUsfoQ7kNvwH1597v&_nc_oc=AdqxmWbjqhi7TStYQFNAw7TjNBQQR4lU88-gRnVMjm3DxBzPoFfQfCCDzMttWTZsrao&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_HerBPldisWBhYkupg583a0ytBNJyGcYG60QeSwVfYwA&oe=6A36C06D"}, "display_name": "Escape Simulator", "keywords": ["escape", "room", "coop", "multiplayer", "simulator"], "long_description": "Escape Simulator is a first-person puzzler you can **play solo or in an online co-op** (best with 2-3 players, but playable with up to 8!). Explore a growing set of **highly interactive escape rooms**. Pick up and examine everything, break objects, solve locks, and decipher puzzles to escape! After finishing the main game, watch for free content updates and explore rooms **built by our awesome community**.\n\n# \u2b50**REVIEWS** \n\"What I've seen has left me considerably impressed.\" - UploadVR\n\n# \u2692\ufe0f**COMMUNITY-MADE ROOMS**\nAfter finishing the main game **explore numerous rooms** built by our amazing community.\n\n# \ud83e\udd1d**ONLINE CO-OP**\nAll rooms are playable in an online co-op. Play with up to 8 players (best played with 2-3). Customize your character and join friends to solve puzzles together. More heads are better than one!\n\n# \ud83e\udde9**INTERACTIVE PUZZLES**\nExplore 28+ official rooms filled with puzzles designed by real-life escape room operators. If it\u2019s not nailed down, you can pick it up.\n\n# \ud83d\udd0d**EXEMINE EVERYTHING**\nRead books, examine ancient artifacts, and find clues to riddles. Need to cross-reference a clue? No problem - just pin it!\n\n# \ud83c\udfc6**WANT MORE?**\nThe game features additional content in the form of Addons with 4 large rooms each: \n- **Steampunk**: Solve four new rooms on the beautiful steampunk airship \"Valor.\"\n- **Wild West**: Become an outlaw in the Wild West.\n- **Magic**: Embrace your magic potential, and follow in the footsteps of great witches and wizards. \n\n", "short_description": "First-person puzzler you can play solo or in an online co-op. Explore a set of highly interactive escape rooms. Move furniture, pick up and examine everything, s
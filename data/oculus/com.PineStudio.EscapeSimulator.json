5/65396729_1225052078868354_6945820870147360559_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZfTNQgcDSqoQ7kNvwHz8tXX&_nc_oc=AdpCzbE0IAUw3V80EwekEJu0xj2jzq4OQ_OalUr8rR-uFhDQNaf5ej7z2YGgGARLNdQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDfKd8wwE_fBIhT77Bo4yJWoeTO8WU33Vh3K7kg3z68jA&oe=6A52491E"}, {"file_name": "4.png", "id": "975198817093493", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/57566693_975198820426826_7097624739394196541_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g8_zWs5xlwMQ7kNvwGH04K8&_nc_oc=AdoK1BT5rlQ39sV1aouCmYqVx9FXYV7Ty6VYvEtr-ceW2AYF328zyyBVcrV115xkwEc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAe6fsTweSfFtaDdVIVutct9L9BljYQup9M0FSUxdFYCg&oe=6A524ACC"}, {"file_name": "1.png", "id": "415893571368646", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39001715_415893574701979_3461447245540982035_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Py-Xw4I0o38Q7kNvwFhqW4N&_nc_oc=Ado02JKEWZc7hSy2syZYdM7pCTZZ_-Xqb-W1Ko3QjWjZTvk2esURqgKZ2bXVkGHJg8g&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCD_Z9Olvi5ZVX9zXDaVvQmyy0kx0_K7G3LPEX8h-Gs1g&oe=6A526616"}, {"file_name": "3.png", "id": "662596896051796", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974523_662596899385129_8527079563659693432_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lGIT_lj8m0AQ7kNvwGxJNGt&_nc_oc=AdoktDY_8F51jaTLsHu5jcfKYal75kIj2FCII4W7UKTXX557CVYd-MeJ4AQyiITfcn4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCg-2Ot9ctWpZ-R2ejQPbOln9PRn43RaWPk-_dEsnKl5Q&oe=6A526494"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "gameplayVR3.png", "id": "492345567046352", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974804_492345570379685_6511341930176300148_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0uXOPL6J9bkQ7kNvwGN2c45&_nc_oc=AdqR0-giiz5N6fEmgYEKeRuw2mMeVLrwK0WTQ1HFB0mFkpZUfr0ngshi98m3f8XVs4c&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBM5yq9NCNhGbYBKhCVG-q2NC9S5ZJ0rlePva3tIZnQdw&oe=6A5237AD"}, "display_name": "Escape Simulator", "keywords": ["escape", "room", "coop", "multiplayer", "simulator"], "long_description": "Escape Simulator is a first-person puzzler you can **play solo or in an online co-op** (best with 2-3 players, but playable with up to 8!). Explore a growing set of **highly interactive escape rooms**. Pick up and examine everything, break objects, solve locks, and decipher puzzles to escape! After finishing the main game, watch for free content updates and explore rooms **built by our awesome community**.\n\n# \u2b50**REVIEWS** \n\"What I've seen has left me considerably impressed.\" - UploadVR\n\n# \u2692\ufe0f**COMMUNITY-MADE ROOMS**\nAfter finishing the main game **explore numerous rooms** built by our amazing community.\n\n# \ud83e\udd1d**ONLINE CO-OP**\nAll rooms are playable in an online co-op. Play with up to 8 players (best played with 2-3). Customize your character and join friends to solve puzzles together. More heads are better than one!\n\n# \ud83e\udde9**INTERACTIVE PUZZLES**\nExplore 28+ official rooms filled with puzzles designed by real-life escape room operators. If it\u2019s not nailed down, you can pick it up.\n\n# \ud83d\udd0d**EXEMINE EVERYTHING**\nRead books, examine ancient artifacts, and find clues to riddles. Need to cross-reference a clue? No problem - just pin it!\n\n# \ud83c\udfc6**WANT MORE?**\nThe game features additional content in the form of Addons with 4 large rooms each: \n- **Steampunk**: Solve four new rooms on the beautiful steampunk airship \"Valor.\"\n- **Wild West**: Become an outlaw in the Wild West.\n- **Magic**: Embrace your magic potential, and follow in the footsteps of great witches and wizards. \n\n", "short_description": "First-person puzzler you can play solo or in an online co-op. Explore a set of highly interactive escape rooms. Move furniture, pick up and examine everything, smash pots and break 
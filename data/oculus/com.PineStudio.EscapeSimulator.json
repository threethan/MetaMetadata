5/65396729_1225052078868354_6945820870147360559_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZfTNQgcDSqoQ7kNvwFg06FP&_nc_oc=Adqiu5r3Zd5g84Y0hI3l_s99DS0YrbT_eEo32AIKjvAEOy7sr8kykAhNl3hY7MYgzk0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC9AVGNJtCiqv07tt8Yb3ViFi40PIQQWgLD-0sLEExtjA&oe=6A50F79E"}, {"file_name": "4.png", "id": "975198817093493", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/57566693_975198820426826_7097624739394196541_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g8_zWs5xlwMQ7kNvwGtCuj9&_nc_oc=Adq_fUQzgQIMOu209kdvPw7U8ThWxmJc1trHigtX2stYJJz0JWXzI-CNCPpiWgt5QgY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBmSYMefwS3PIlqyGTUVwWxxj2sXPw8o3urC0QHyZIYbA&oe=6A50F94C"}, {"file_name": "1.png", "id": "415893571368646", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39001715_415893574701979_3461447245540982035_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x2q29zGowP8Q7kNvwHliXFW&_nc_oc=AdoYcF0t12XlByH2B0CHWMAsLUoBNdbaBBqd20qifiUutWNKwzqfCCyWIVafSJaOU_s&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCUcjRYurMoLL09A1zrVUoFxOo2ZNZwBxr-0SfNEQmOzg&oe=6A511496"}, {"file_name": "3.png", "id": "662596896051796", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974523_662596899385129_8527079563659693432_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_99cJJQs12AQ7kNvwHWOIbd&_nc_oc=Adq6c9DLR2nM7AyIWw7bxyd4GHuTNlP5FjELyT79zWrrQdj8jdheVllfMAK6FX4x4NA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCC-iJgoxGOBlO-dEMWgLS-tDOKSEB3Ka5_QA4oGVtmPA&oe=6A511314"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "gameplayVR3.png", "id": "492345567046352", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974804_492345570379685_6511341930176300148_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0uXOPL6J9bkQ7kNvwFt8t6e&_nc_oc=AdqBhbV2A2w63zuew3vrNZBVOyysQ4LMvRe4bn_vQrOgiIajLbhL0oohPb9tdslyACs&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAPJaboygN2w359cZhWqmzKEthj1haGghkWZV034g-V0g&oe=6A50E62D"}, "display_name": "Escape Simulator", "keywords": ["escape", "room", "coop", "multiplayer", "simulator"], "long_description": "Escape Simulator is a first-person puzzler you can **play solo or in an online co-op** (best with 2-3 players, but playable with up to 8!). Explore a growing set of **highly interactive escape rooms**. Pick up and examine everything, break objects, solve locks, and decipher puzzles to escape! After finishing the main game, watch for free content updates and explore rooms **built by our awesome community**.\n\n# \u2b50**REVIEWS** \n\"What I've seen has left me considerably impressed.\" - UploadVR\n\n# \u2692\ufe0f**COMMUNITY-MADE ROOMS**\nAfter finishing the main game **explore numerous rooms** built by our amazing community.\n\n# \ud83e\udd1d**ONLINE CO-OP**\nAll rooms are playable in an online co-op. Play with up to 8 players (best played with 2-3). Customize your character and join friends to solve puzzles together. More heads are better than one!\n\n# \ud83e\udde9**INTERACTIVE PUZZLES**\nExplore 28+ official rooms filled with puzzles designed by real-life escape room operators. If it\u2019s not nailed down, you can pick it up.\n\n# \ud83d\udd0d**EXEMINE EVERYTHING**\nRead books, examine ancient artifacts, and find clues to riddles. Need to cross-reference a clue? No problem - just pin it!\n\n# \ud83c\udfc6**WANT MORE?**\nThe game features additional content in the form of Addons with 4 large rooms each: \n- **Steampunk**: Solve four new rooms on the beautiful steampunk airship \"Valor.\"\n- **Wild West**: Become an outlaw in the Wild West.\n- **Magic**: Embrace your magic potential, and follow in the footsteps of great witches and wizards. \n\n", "short_description": "First-person puzzler you can play solo or in an online co-op. Explore a set of highly interactive escape rooms. Move furniture, pick up and examine everything, smash pots and break 
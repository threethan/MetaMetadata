-7&_nc_sid=6e7a0a&_nc_ohc=9rLcK8KZgcIQ7kNvwFNtv4p&_nc_oc=AdrTWVyWafDtP_Qc0doy6-bPcm109N-q1L2ir1WZD6azQFyc0hqIpHjFFB2A2C1Jb5Y&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8Uv7sacQ-mgW0HIkvaVCowjoc5KEXr9-Q2c9NH5TFUYg&oe=6A42771E"}, {"file_name": "2.png", "id": "457815206622098", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75210399_457815209955431_6948775186918221287_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sNGOh_bKcoMQ7kNvwHozZkb&_nc_oc=AdrDWDQx7k2X-cGC2AMntq6BcFNGAuvpAs1qaMbS1EW7-8fQVS7so2xi8vcC7OYJu3Y&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af--gX8hSOoeOy68MuJkN_htuXNUm1OPippgvezpgPZt8g&oe=6A426C6A"}, {"file_name": "3.png", "id": "662596896051796", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974523_662596899385129_8527079563659693432_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zEZKWL_LMYIQ7kNvwE6GW7t&_nc_oc=AdoWJQ4QaPAPqhSk7JJXWF7hFkmR202diI9I56l_ir24iL6z9Uwkp1qA5OQi4ZkaD7A&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9X4GLNt35w278B2j1SRGFY7pRshiofRuxuNyYAkYQAQw&oe=6A429294"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "gameplayVR3.png", "id": "492345567046352", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974804_492345570379685_6511341930176300148_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AtojVxpHHg4Q7kNvwES3Flp&_nc_oc=AdpspG9vqajOqtEGqAYzqMa20KtaPtdI0jrmvMUshcsOfhB3LkkRRo5zyfjEeMpaKgA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-3FxpJ6jU4HeslGKmlb73IDh5Tu-0Uq3b24wrFlGp1-Q&oe=6A4265AD"}, "display_name": "Escape Simulator", "keywords": ["escape", "room", "coop", "simulator", "puzzle"], "long_description": "Escape Simulator is a first-person puzzler you can **play solo or in an cross platform online co-op** (best with 2-3 players, but playable with up to 8!). Explore a growing set of **highly interactive escape rooms**. Pick up and examine everything, break objects, solve locks, and decipher puzzles to escape! After finishing the main game, watch for free content updates and explore rooms **built by our awesome community**.\n\n# \u2b50**REVIEWS** \n\"What I've seen has left me considerably impressed.\" - UploadVR\n\n# \u2692\ufe0f**COMMUNITY-MADE ROOMS**\nAfter finishing the main game **explore numerous rooms** built by our amazing Steam community. New rooms every Friday!\n\n# \ud83e\udd1d**CROSS-PLATFORM CO-OP**\nAll rooms are playable in a cross platform online co-op. Play with up to 8 players (best played with 2-3) on PC, Quest 2 and 3. Customize your character and join friends to solve puzzles together. More heads are better than one! \n\n# \ud83e\udde9**INTERACTIVE PUZZLES**\nExplore 21+ official rooms filled with puzzles designed by real-life escape room operators. If it\u2019s not nailed down, you can pick it up.\n\n# \ud83d\udd0d**EXEMINE EVERYTHING**\nRead books, examine ancient artifacts, and find clues to riddles. Need to cross-reference a clue? No problem - just pin it!\n\n# \ud83c\udfc6**MORE COMING VERY SOON!** \nThe game is getting even more content in a form of free rooms & addons: \n- **Steampunk**: Solve four new rooms on the beautiful steampunk airship \"Valor.\"\n- **Wild West**: Become an outlaw in the Wild West.\n- **Magic**: Embrace your magic potential, and follow in the footsteps of great witches and wizards. \n\n", "short_description": "First-person puzzler you can play solo or in an online co-op. Explore a set of highly interactive escape rooms. Move furniture, pick up and examine everything, smash pots and break locks! Supports community rooms through the level editor."}]}, "developer_name": null, "developer_privacy_policy_url": "https://pinestudio.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Pine Studio", "support_website_url": "https://pinestudio.com/contact/", "website_url": "https://pinestudio.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [
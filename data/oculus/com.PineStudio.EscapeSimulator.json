n.com/v/t64.5771-25/65396729_1225052078868354_6945820870147360559_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Pwyw-FOW1MkQ7kNvwHyHS7Y&_nc_oc=AdpO3vCVWh_W-OggZQQ4x86g6C46E9Wku0wYa-MpHurXa_z-MCb0mOK5yh1NLdQY92w&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9ZgwWz20Vd4Enw2NKa39U2zAV73k-Z6hJjbdFNrU8-uw&oe=6A22D31E"}, {"file_name": "4.png", "id": "975198817093493", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/57566693_975198820426826_7097624739394196541_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n1tV9CtEfrsQ7kNvwFxT4od&_nc_oc=AdoqjwyyAtVC9ktIoaxUtRaN7Smk1kg0Y1D_qYj1vY0HjWqJdWOOHDBzf3Rrj2h3u9g&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9raoP16SlkSmcGhptnWfaqNpz-hiZWPGhGg6BtUrVUsQ&oe=6A22D4CC"}, {"file_name": "1.png", "id": "415893571368646", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/39001715_415893574701979_3461447245540982035_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nm0v8qp4c0kQ7kNvwEl2CSC&_nc_oc=AdpuxanjX3pVoEK8W8K5x8-NVHTZrBy478IWfD7bKOcOFL9r0u2EsEmCPv8dOJh56GM&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-4Bt01l4OJvlx4Xk3sR3gxP4tcuwzwQqOQ7ypOdJ-WNw&oe=6A22F016"}, {"file_name": "3.png", "id": "662596896051796", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/38974523_662596899385129_8527079563659693432_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MfRbfBdc1o4Q7kNvwFpUyyN&_nc_oc=AdqoFzSLjDvANufmC4sxK8ftmgrLoOggL7Wi1RN_A7u-kpoUmfeunpAjNYk0OZbJszk&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9-bkNE9dKha96_CHNRZWM4QUoDZ4xQgXkBXv4I2UNTTQ&oe=6A22EE94"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "gameplayVR3.png", "id": "492345567046352", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/38974804_492345570379685_6511341930176300148_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7yH_EEWshOwQ7kNvwGYapGR&_nc_oc=AdqHnKlCjhKC9FD7vpfp88yv9qkffBo8q4Ca9YtJ1Cfhy9qIMYutCEBGaSaOYUUSRqg&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9ipY5ULG0htKkPpqe2Gck7rCqDqmQ6cq8nzlpnaBt-iQ&oe=6A22F9ED"}, "display_name": "Escape Simulator", "keywords": ["escape", "room", "coop", "multiplayer", "simulator"], "long_description": "Escape Simulator is a first-person puzzler you can **play solo or in an online co-op** (best with 2-3 players, but playable with up to 8!). Explore a growing set of **highly interactive escape rooms**. Pick up and examine everything, break objects, solve locks, and decipher puzzles to escape! After finishing the main game, watch for free content updates and explore rooms **built by our awesome community**.\n\n# \u2b50**REVIEWS** \n\"What I've seen has left me considerably impressed.\" - UploadVR\n\n# \u2692\ufe0f**COMMUNITY-MADE ROOMS**\nAfter finishing the main game **explore numerous rooms** built by our amazing community.\n\n# \ud83e\udd1d**ONLINE CO-OP**\nAll rooms are playable in an online co-op. Play with up to 8 players (best played with 2-3). Customize your character and join friends to solve puzzles together. More heads are better than one!\n\n# \ud83e\udde9**INTERACTIVE PUZZLES**\nExplore 28+ official rooms filled with puzzles designed by real-life escape room operators. If it\u2019s not nailed down, you can pick it up.\n\n# \ud83d\udd0d**EXEMINE EVERYTHING**\nRead books, examine ancient artifacts, and find clues to riddles. Need to cross-reference a clue? No problem - just pin it!\n\n# \ud83c\udfc6**WANT MORE?**\nThe game features additional content in the form of Addons with 4 large rooms each: \n- **Steampunk**: Solve four new rooms on the beautiful steampunk airship \"Valor.\"\n- **Wild West**: Become an outlaw in the Wild West.\n- **Magic**: Embrace your magic potential, and follow in the footsteps of great witches and wizards. \n\n", "short_description": "First-person puzzler you can play solo or in an online co-op. Explore a set of highly interactive escape rooms. Move furniture, pick up and examine everything, s
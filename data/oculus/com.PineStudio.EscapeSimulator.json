25/65396729_1225052078868354_6945820870147360559_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=chrFiKu3tLcQ7kNvwFt5P1R&_nc_oc=Adr8reg7ofb-q744oSkNRVNrQW7BAvAJ9o4s_qMBDxAN08VBIdvuvsIxDDpa7VV3Hbw&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMs0DYy3Qm_ZSjXBRKc9IuN1ZCHzlKnnqzSodlYWLnpmA&oe=6ADCB69E"}, {"file_name": "4.png", "id": "975198817093493", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/57566693_975198820426826_7097624739394196541_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b-3vxJF8x3kQ7kNvwEZoKQU&_nc_oc=AdrI5tVGZeN-BspM1XeS3pkWi-_J-GNHpC9-wlVXw8BEa5Mvlz_Nw-FZ2DUrFap9dgs&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM8R1aspqWTpq6T_2ZMXIbjcRSIhmLR19Kw9NpjxF_now&oe=6ADCB84C"}, {"file_name": "1.png", "id": "415893571368646", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39001715_415893574701979_3461447245540982035_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Mybe071roBEQ7kNvwF_pG2F&_nc_oc=AdoGZuTHeGcVLcweL3JBvIIjccZT_fOLc6Ebfccu7IZlWtjH-KCgLxB97-zrJfHoDfY&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNc-IFL1ec5kOqdvO63yW6FsOd4cj45Uzsy-jLlgvUoaw&oe=6ADCD396"}, {"file_name": "3.png", "id": "662596896051796", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974523_662596899385129_8527079563659693432_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yXrE3sYPpDsQ7kNvwH0J80o&_nc_oc=Adrx2SrouSBeARPllWplOud8Vrw9YvHWQa67bomYegtIA5BvSwnk0gNOtvem_snYK68&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOgpUN6wX1Zgc4fsKAtYBuamMkyk05lYQ1GqCcArLiHOg&oe=6ADCD214"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "gameplayVR3.png", "id": "492345567046352", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974804_492345570379685_6511341930176300148_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-_k8V0ipdsUQ7kNvwFpiW2H&_nc_oc=AdqqHNrkF3J75DVqaya-Q8-kP2ODkSTyXB4MVukqVSB7lHvyKVKmeLAQM3k7O7BU-E4&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNCyduCd4fgvUcvdPVydf7vsW2Ivypokx9U9GNR8rL2AQ&oe=6ADCA52D"}, "display_name": "Escape Simulator", "keywords": ["escape", "room", "coop", "multiplayer", "simulator"], "long_description": "Escape Simulator is a first-person puzzler you can **play solo or in an online co-op** (best with 2-3 players, but playable with up to 8!). Explore a growing set of **highly interactive escape rooms**. Pick up and examine everything, break objects, solve locks, and decipher puzzles to escape! After finishing the main game, watch for free content updates and explore rooms **built by our awesome community**.\n\n# \u2b50**REVIEWS** \n\"What I've seen has left me considerably impressed.\" - UploadVR\n\n# \u2692\ufe0f**COMMUNITY-MADE ROOMS**\nAfter finishing the main game **explore numerous rooms** built by our amazing community.\n\n# \ud83e\udd1d**ONLINE CO-OP**\nAll rooms are playable in an online co-op. Play with up to 8 players (best played with 2-3). Customize your character and join friends to solve puzzles together. More heads are better than one!\n\n# \ud83e\udde9**INTERACTIVE PUZZLES**\nExplore 28+ official rooms filled with puzzles designed by real-life escape room operators. If it\u2019s not nailed down, you can pick it up.\n\n# \ud83d\udd0d**EXEMINE EVERYTHING**\nRead books, examine ancient artifacts, and find clues to riddles. Need to cross-reference a clue? No problem - just pin it!\n\n# \ud83c\udfc6**WANT MORE?**\nThe game features additional content in the form of Addons with 4 large rooms each: \n- **Steampunk**: Solve four new rooms on the beautiful steampunk airship \"Valor.\"\n- **Wild West**: Become an outlaw in the Wild West.\n- **Magic**: Embrace your magic potential, and follow in the footsteps of great witches and wizards. \n\n", "short_description": "First-person puzzler you can play solo or in an online co-op. Explore a set of highly interactive escape rooms. Move furniture, pick up and examine everything, smash pots and break
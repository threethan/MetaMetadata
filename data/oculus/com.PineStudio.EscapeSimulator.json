n.com/v/t64.5771-25/65396729_1225052078868354_6945820870147360559_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ew-WircmkkwQ7kNvwH5IcCu&_nc_oc=Adpy4-Jt70aFDJift7ALF5A0754YyPoXUvEvm0kU2lPySOZptKy6nm7uR22xXevMVB4&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7HUN30kwgQLhtM1BwZ7Y3hdlPcX93yu1DuqMfCI9wNgg&oe=6A11AF9E"}, {"file_name": "4.png", "id": "975198817093493", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/57566693_975198820426826_7097624739394196541_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rcS1ZOcEThgQ7kNvwEBq4Xb&_nc_oc=AdqGsr74WJSAPFymHOL3_HcNr1R_RVDCCl10-4I00bz0GP9Jah-ds1E8H630NHs-sPU&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5Ma5WB1ZCI33OgTIb1XJjCgnV2UqNY67S51dDXjoV8AA&oe=6A11B14C"}, {"file_name": "1.png", "id": "415893571368646", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/39001715_415893574701979_3461447245540982035_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c3yx8jYYh7YQ7kNvwGDArOU&_nc_oc=AdpwyLMIWslmvfdXlCqW3NilpXlJf612WQohSDoMGfyz2bVvD5zRELL0YyFotgyt9Cg&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af45uVR-hwEMUsWwGGOlaSwd7DOwhqRD-1eKmBVV-JXLIg&oe=6A11CC96"}, {"file_name": "3.png", "id": "662596896051796", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/38974523_662596899385129_8527079563659693432_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nLUvfxj73W4Q7kNvwEbwuMb&_nc_oc=AdphRkn-CX_aNlrBXIKDr1Tbj6rPdHjCO4i9CaWHuuxHVCjc_5C3yTwua44vf5nzAx8&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7nCnKwZqea7UW7vKe1L7oEIGpqKm-XS00tEBapagTigQ&oe=6A11CB14"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "gameplayVR3.png", "id": "492345567046352", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/38974804_492345570379685_6511341930176300148_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e1A4AT1p3W0Q7kNvwFJrhKn&_nc_oc=Adq-vBRdMcAPdqVQNAM9vG0xc75l90ELSFAuiKTSdup2koh24elzDzwswK1gNZH9GWE&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6xXvAu339FdTZfTkE0WodWrp0Fccl1MaQMXNC_14HygQ&oe=6A119E2D"}, "display_name": "Escape Simulator", "keywords": ["escape", "room", "coop", "multiplayer", "simulator"], "long_description": "Escape Simulator is a first-person puzzler you can **play solo or in an online co-op** (best with 2-3 players, but playable with up to 8!). Explore a growing set of **highly interactive escape rooms**. Pick up and examine everything, break objects, solve locks, and decipher puzzles to escape! After finishing the main game, watch for free content updates and explore rooms **built by our awesome community**.\n\n# \u2b50**REVIEWS** \n\"What I've seen has left me considerably impressed.\" - UploadVR\n\n# \u2692\ufe0f**COMMUNITY-MADE ROOMS**\nAfter finishing the main game **explore numerous rooms** built by our amazing community.\n\n# \ud83e\udd1d**ONLINE CO-OP**\nAll rooms are playable in an online co-op. Play with up to 8 players (best played with 2-3). Customize your character and join friends to solve puzzles together. More heads are better than one!\n\n# \ud83e\udde9**INTERACTIVE PUZZLES**\nExplore 28+ official rooms filled with puzzles designed by real-life escape room operators. If it\u2019s not nailed down, you can pick it up.\n\n# \ud83d\udd0d**EXEMINE EVERYTHING**\nRead books, examine ancient artifacts, and find clues to riddles. Need to cross-reference a clue? No problem - just pin it!\n\n# \ud83c\udfc6**WANT MORE?**\nThe game features additional content in the form of Addons with 4 large rooms each: \n- **Steampunk**: Solve four new rooms on the beautiful steampunk airship \"Valor.\"\n- **Wild West**: Become an outlaw in the Wild West.\n- **Magic**: Embrace your magic potential, and follow in the footsteps of great witches and wizards. \n\n", "short_description": "First-person puzzler you can play solo or in an online co-op. Explore a set of highly interactive escape rooms. Move furniture, pick up and examine everything, s
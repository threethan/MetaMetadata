25/65396729_1225052078868354_6945820870147360559_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bBgqOh_cmbMQ7kNvwFRWmg2&_nc_oc=AdrFzot_XiJDo5GUUMwNcIeAX4zMJhAhKZiAxWFGxwIR-X46IzstNtFGXcfQuoGdK8w&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTDmWJaqlAqk4kRAv4_jdegf-oIIGmbvv-qDI2w4V80og&oe=6AE9E59E"}, {"file_name": "4.png", "id": "975198817093493", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/57566693_975198820426826_7097624739394196541_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yAVk28BiN-IQ7kNvwHFVPQe&_nc_oc=AdoUsDRy8twz-w9yebIaQpkmEicSsQPIuxu3AiFf1oRD1jchvNZRtNEpr_hJ1RajJ_M&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ-QZBFDmhl73NneYAJGmZNNsLCC_ZOlANYIvhVa_kh1g&oe=6AE9E74C"}, {"file_name": "1.png", "id": "415893571368646", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39001715_415893574701979_3461447245540982035_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8jmaB4BF3XQQ7kNvwFEjOBe&_nc_oc=AdrV68gYr3mx6ypSekmwogSsvk_IZuoHhUKeFYmSWvtTI1fEUu-HUdKhlIkxI4empBQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTQkJxmu4os-D7fnyOWpC6AoLpEcBvegLeSFZ-4tc8xVA&oe=6AEA0296"}, {"file_name": "3.png", "id": "662596896051796", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974523_662596899385129_8527079563659693432_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T3ouUKhZkagQ7kNvwHumwXR&_nc_oc=AdqhoNGHY6YtPWBbkTTr8yoPosrF5JfxPMkXvy6GgCUKP9f30rESSkoiCYVGld3Lhnk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQkvUiS4IUt-CSRevBQiASNZiV1jwpJ6Fc1TA8z02Mtpw&oe=6AEA0114"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "gameplayVR3.png", "id": "492345567046352", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974804_492345570379685_6511341930176300148_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Yy7W5J_4TV0Q7kNvwFidIrh&_nc_oc=AdqQSw26QpovYxSUyIqVYiOothPlY0Tr6cPjguNgZ0BT6U-M-rl_Nv2MEl_O_6MAE4E&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQpyAz6mt0uQ4l4nHVmuncr-RC2c0t-yNtUBhzLiyKz2Q&oe=6AEA0C6D"}, "display_name": "Escape Simulator", "keywords": ["escape", "room", "coop", "multiplayer", "simulator"], "long_description": "Escape Simulator is a first-person puzzler you can **play solo or in an online co-op** (best with 2-3 players, but playable with up to 8!). Explore a growing set of **highly interactive escape rooms**. Pick up and examine everything, break objects, solve locks, and decipher puzzles to escape! After finishing the main game, watch for free content updates and explore rooms **built by our awesome community**.\n\n# \u2b50**REVIEWS** \n\"What I've seen has left me considerably impressed.\" - UploadVR\n\n# \u2692\ufe0f**COMMUNITY-MADE ROOMS**\nAfter finishing the main game **explore numerous rooms** built by our amazing community.\n\n# \ud83e\udd1d**ONLINE CO-OP**\nAll rooms are playable in an online co-op. Play with up to 8 players (best played with 2-3). Customize your character and join friends to solve puzzles together. More heads are better than one!\n\n# \ud83e\udde9**INTERACTIVE PUZZLES**\nExplore 28+ official rooms filled with puzzles designed by real-life escape room operators. If it\u2019s not nailed down, you can pick it up.\n\n# \ud83d\udd0d**EXEMINE EVERYTHING**\nRead books, examine ancient artifacts, and find clues to riddles. Need to cross-reference a clue? No problem - just pin it!\n\n# \ud83c\udfc6**WANT MORE?**\nThe game features additional content in the form of Addons with 4 large rooms each: \n- **Steampunk**: Solve four new rooms on the beautiful steampunk airship \"Valor.\"\n- **Wild West**: Become an outlaw in the Wild West.\n- **Magic**: Embrace your magic potential, and follow in the footsteps of great witches and wizards. \n\n", "short_description": "First-person puzzler you can play solo or in an online co-op. Explore a set of highly interactive escape rooms. Move furniture, pick up and examine everything, smash pots and break
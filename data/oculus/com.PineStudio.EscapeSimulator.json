5/65396729_1225052078868354_6945820870147360559_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0ow-hTPCI3UQ7kNvwHZ-Fir&_nc_oc=Adoi8qasyBv1KXMTNOkKwWMpxbszKjEd37HhmXWg4Mw7Ig2Yx4YtvTdmE3aBBYMwN2E&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxcAFMi4FZACp5moI0zRadIywcXD-d4wetJJFHh-qO4Cw&oe=69C2959E"}, {"file_name": "4.png", "id": "975198817093493", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/57566693_975198820426826_7097624739394196541_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GnpjCIYQo8gQ7kNvwH9mcHT&_nc_oc=AdotKTFpUySuaeTDsstgv6nAKomw5UdLV1NyUcFRXpeJUshY7xUSXkZZACnHDdZ_Q4s&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzXyTDHD_sYjZgMunUpDkmdqcDdUf57QXU_V5OIJEJTXg&oe=69C2974C"}, {"file_name": "1.png", "id": "415893571368646", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39001715_415893574701979_3461447245540982035_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D8OtXcfCRh4Q7kNvwGdtT0G&_nc_oc=AdolURV5OyT164kZCjstP_l083kU44jG1bBbc8c6TAVXxtqFSQNNWl7DrP5IrWtxhP8&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyzJR7yp2eYD-STiMPN-n1KUqyBeNrWnHcWHNR162crxg&oe=69C27A56"}, {"file_name": "3.png", "id": "662596896051796", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38974523_662596899385129_8527079563659693432_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fa-nQsOdUHwQ7kNvwGcGcnM&_nc_oc=AdrCSxxPq_4PnllvJTEU2a4DDm_StYQbXa2JfyQv79ERQUjt08v3iGbxMR1OmsAKRRw&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afw3-yVRQrZH9jlDtVOQ7UATgAZf9Anicjyo2yPoU6TE_w&oe=69C278D4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "gameplayVR3.png", "id": "492345567046352", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38974804_492345570379685_6511341930176300148_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4gT5um_eVr8Q7kNvwG31cB6&_nc_oc=Ado6m_R-Z6_ke1w-Sqzw5MENhVnkOb8nHsx-kKkf29ArhsrvLKlcLkYpSDjxCEk5i3A&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afxkac5WErUs_TO0DHw9FEjtS1wrAZUSVlmLFvXbL8lz2Q&oe=69C2842D"}, "display_name": "Escape Simulator", "keywords": ["escape", "room", "coop", "multiplayer", "simulator"], "long_description": "Escape Simulator is a first-person puzzler you can **play solo or in an online co-op** (best with 2-3 players, but playable with up to 8!). Explore a growing set of **highly interactive escape rooms**. Pick up and examine everything, break objects, solve locks, and decipher puzzles to escape! After finishing the main game, watch for free content updates and explore rooms **built by our awesome community**.\n\n# \u2b50**REVIEWS** \n\"What I've seen has left me considerably impressed.\" - UploadVR\n\n# \u2692\ufe0f**COMMUNITY-MADE ROOMS**\nAfter finishing the main game **explore numerous rooms** built by our amazing community.\n\n# \ud83e\udd1d**ONLINE CO-OP**\nAll rooms are playable in an online co-op. Play with up to 8 players (best played with 2-3). Customize your character and join friends to solve puzzles together. More heads are better than one!\n\n# \ud83e\udde9**INTERACTIVE PUZZLES**\nExplore 28+ official rooms filled with puzzles designed by real-life escape room operators. If it\u2019s not nailed down, you can pick it up.\n\n# \ud83d\udd0d**EXEMINE EVERYTHING**\nRead books, examine ancient artifacts, and find clues to riddles. Need to cross-reference a clue? No problem - just pin it!\n\n# \ud83c\udfc6**WANT MORE?**\nThe game features additional content in the form of Addons with 4 large rooms each: \n- **Steampunk**: Solve four new rooms on the beautiful steampunk airship \"Valor.\"\n- **Wild West**: Become an outlaw in the Wild West.\n- **Magic**: Embrace your magic potential, and follow in the footsteps of great witches and wizards. \n\n", "short_description": "First-person puzzler you can play solo or in an online co-op. Explore a set of highly interactive escape rooms. Move furniture, pick up and examine everything, smash pots and break 
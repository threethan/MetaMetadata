25/65396729_1225052078868354_6945820870147360559_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lDkQv6pbH7sQ7kNvwGI4bws&_nc_oc=Adqv1omtIdT7Ky-7mYHrYl5vtkgFf9iXSXSddL0-aD6Bo9Guv7jVIomisYvcuTWfQ-E&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP9CQnNgT52UlbAM-qygDG_bQwne6RkHyzcXtNLq1ZH9A&oe=6AE34E1E"}, {"file_name": "4.png", "id": "975198817093493", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/57566693_975198820426826_7097624739394196541_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ey6oeOCRX9kQ7kNvwELgnid&_nc_oc=AdolKjPrXEVtfBZIZKxWQCtSKzIRdGJ0leYa_zHp_NNqa2YeM63yc6lMAHR70Of89rY&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOpoxn2oPMGa9DQsgRw4iXVb7xlSqiaroXfpT9UCI8M0Q&oe=6AE34FCC"}, {"file_name": "1.png", "id": "415893571368646", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/39001715_415893574701979_3461447245540982035_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iea1PWBq4BMQ7kNvwFNiCDY&_nc_oc=Adq90XBf0A_YstS4Pmrx10KvrABcLt38fAGZHwI1oDeeIseI7ZBIVEQB7LAnshh1NTM&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMup8SNcR3HZNI3imWtU_9_xgqQgje6T7X3Om9UGp53Ig&oe=6AE36B16"}, {"file_name": "3.png", "id": "662596896051796", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974523_662596899385129_8527079563659693432_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ltwb_ljtly4Q7kNvwGUHyhq&_nc_oc=Adqsj1uVvmmXSgb-2cU_IHYzA7cIkprpa3xOG8rRQxi8Zt0mSq0W8doT2VYDMRxFVos&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOXM2Y7LjsJD47NMHPqNTDvDPQhCIYa7r9ikFJbF8wzRA&oe=6AE36994"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "gameplayVR3.png", "id": "492345567046352", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974804_492345570379685_6511341930176300148_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rOXilYlTd60Q7kNvwE882dW&_nc_oc=AdrdsbSBRW6wp0dXyaECDr9El0bzZc0tfDyZNLtt6CM5qbiIEceD638Y29T5ODy5wZQ&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN8fY7j5pzSmwp7pA_jtLUmtT-A1O9yGjbFVowp1Chpkg&oe=6AE33CAD"}, "display_name": "Escape Simulator", "keywords": ["escape", "room", "coop", "multiplayer", "simulator"], "long_description": "Escape Simulator is a first-person puzzler you can **play solo or in an online co-op** (best with 2-3 players, but playable with up to 8!). Explore a growing set of **highly interactive escape rooms**. Pick up and examine everything, break objects, solve locks, and decipher puzzles to escape! After finishing the main game, watch for free content updates and explore rooms **built by our awesome community**.\n\n# \u2b50**REVIEWS** \n\"What I've seen has left me considerably impressed.\" - UploadVR\n\n# \u2692\ufe0f**COMMUNITY-MADE ROOMS**\nAfter finishing the main game **explore numerous rooms** built by our amazing community.\n\n# \ud83e\udd1d**ONLINE CO-OP**\nAll rooms are playable in an online co-op. Play with up to 8 players (best played with 2-3). Customize your character and join friends to solve puzzles together. More heads are better than one!\n\n# \ud83e\udde9**INTERACTIVE PUZZLES**\nExplore 28+ official rooms filled with puzzles designed by real-life escape room operators. If it\u2019s not nailed down, you can pick it up.\n\n# \ud83d\udd0d**EXEMINE EVERYTHING**\nRead books, examine ancient artifacts, and find clues to riddles. Need to cross-reference a clue? No problem - just pin it!\n\n# \ud83c\udfc6**WANT MORE?**\nThe game features additional content in the form of Addons with 4 large rooms each: \n- **Steampunk**: Solve four new rooms on the beautiful steampunk airship \"Valor.\"\n- **Wild West**: Become an outlaw in the Wild West.\n- **Magic**: Embrace your magic potential, and follow in the footsteps of great witches and wizards. \n\n", "short_description": "First-person puzzler you can play solo or in an online co-op. Explore a set of highly interactive escape rooms. Move furniture, pick up and examine everything, smash pots and break
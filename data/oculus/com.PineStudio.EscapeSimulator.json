5/65396729_1225052078868354_6945820870147360559_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GkNJTvF4jfUQ7kNvwERdeNX&_nc_oc=AdriltdXCoJckg5dnakZ1GQCwh1kQSLwjfjOxYEZQxzwTty0msAukDFU65g1TQ2GwKk&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1MP4EWmXTK_gdXQ6i-ZNoOjoILjbFhUYeSgGFg1LaU1g&oe=69E77F9E"}, {"file_name": "4.png", "id": "975198817093493", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/57566693_975198820426826_7097624739394196541_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ORyGbqB7eNoQ7kNvwGESg6B&_nc_oc=AdrcCz95tAHzsn18kFKSByj78xEOcjssPXBXKILO8_SohYCM4Q5Hlc9BOFH8ZGyd-EM&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3T3CEGM-ca0LPeu2Um7EAMOph3aAI-dKfZ7hKbCy_8_A&oe=69E7814C"}, {"file_name": "1.png", "id": "415893571368646", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/39001715_415893574701979_3461447245540982035_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8l8WM3fMxuQQ7kNvwGLcjyX&_nc_oc=AdqwTasJhmGKDwrrnbD1T2KAjPv3xscfG2Nd2u4HoLL821gzMKtDKHhwPTuM9uwFzog&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2rXfxEanyxcytvxqxUEdMjL5N-ENQJMNKY8KkjaKoPQQ&oe=69E76456"}, {"file_name": "3.png", "id": "662596896051796", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38974523_662596899385129_8527079563659693432_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wZgeolKcYEsQ7kNvwGBZgZu&_nc_oc=AdrKzNcAa0ICUXC3WxEZ_iZ0SH5chta5KTsjuOWh8ng7RHSon3NZSUk33mmEka4OvRg&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1qlb4tLU7lBRQqa673tFrdn7a2semxMjpS86dgWfl4tg&oe=69E762D4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "gameplayVR3.png", "id": "492345567046352", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38974804_492345570379685_6511341930176300148_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A68WZa8LbPgQ7kNvwErmPzp&_nc_oc=Adrth7AexF8zRyisL5ytaamb4e3t0xVUFcjsY3YIj8TaCQYbjGQJ1mB87LZEWlfNb-w&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0ctZA3klOIVDdsQ-wmEUQnN1uxd3n-pFZfylLKQVOtzw&oe=69E76E2D"}, "display_name": "Escape Simulator", "keywords": ["escape", "room", "coop", "multiplayer", "simulator"], "long_description": "Escape Simulator is a first-person puzzler you can **play solo or in an online co-op** (best with 2-3 players, but playable with up to 8!). Explore a growing set of **highly interactive escape rooms**. Pick up and examine everything, break objects, solve locks, and decipher puzzles to escape! After finishing the main game, watch for free content updates and explore rooms **built by our awesome community**.\n\n# \u2b50**REVIEWS** \n\"What I've seen has left me considerably impressed.\" - UploadVR\n\n# \u2692\ufe0f**COMMUNITY-MADE ROOMS**\nAfter finishing the main game **explore numerous rooms** built by our amazing community.\n\n# \ud83e\udd1d**ONLINE CO-OP**\nAll rooms are playable in an online co-op. Play with up to 8 players (best played with 2-3). Customize your character and join friends to solve puzzles together. More heads are better than one!\n\n# \ud83e\udde9**INTERACTIVE PUZZLES**\nExplore 28+ official rooms filled with puzzles designed by real-life escape room operators. If it\u2019s not nailed down, you can pick it up.\n\n# \ud83d\udd0d**EXEMINE EVERYTHING**\nRead books, examine ancient artifacts, and find clues to riddles. Need to cross-reference a clue? No problem - just pin it!\n\n# \ud83c\udfc6**WANT MORE?**\nThe game features additional content in the form of Addons with 4 large rooms each: \n- **Steampunk**: Solve four new rooms on the beautiful steampunk airship \"Valor.\"\n- **Wild West**: Become an outlaw in the Wild West.\n- **Magic**: Embrace your magic potential, and follow in the footsteps of great witches and wizards. \n\n", "short_description": "First-person puzzler you can play solo or in an online co-op. Explore a set of highly interactive escape rooms. Move furniture, pick up and examine everything, smash pots and break 
25/65396729_1225052078868354_6945820870147360559_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kX5ypnCcu9UQ7kNvwGvZr7h&_nc_oc=AdqMntL2HMWZ07GGMygnprcwKkQnB0GQltUfGnpIkXIEmCYtpP6Z5tvOk79AYMaZLuQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOZT8b3l4WAAcAoCHRJuEcwwdF__jb5FRoPVUFBNI9EoA&oe=6ABFB59E"}, {"file_name": "4.png", "id": "975198817093493", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/57566693_975198820426826_7097624739394196541_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G416jlPBwA0Q7kNvwGeg9C6&_nc_oc=AdpEEtkBthNEw9pbMDQjmrrPV3mZ4w-tG1p4B5uu9G2TvjA5yk9asjfLqbYMPX0NhUo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPHZPm9aPQeBOibA4IiRmAKIct1SZzcVKhnVBN8l5uyRQ&oe=6ABFB74C"}, {"file_name": "1.png", "id": "415893571368646", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39001715_415893574701979_3461447245540982035_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n547zLZrWikQ7kNvwGxWQk3&_nc_oc=Adq_QEG9q2VeUGjtR7TwNzKmpRUbYdyx697rBcVQ8PGBzhH2ZwuhbhtV-qoi1Tt8yR0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPx0k5WgwQwOwf7sA_YfmdeJLEqa81EJ_ejwjBRz7PqvQ&oe=6ABFD296"}, {"file_name": "3.png", "id": "662596896051796", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974523_662596899385129_8527079563659693432_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3MYIMFaxOCAQ7kNvwFf5Qe_&_nc_oc=AdrKDiw-0dNcdo1GX5mhZ10ibOVImg1U6fjWt3qZprzD7G2t4hLanzyULBPrJZw711k&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOBSdeyTe5910iAePfRrJYJecz0UQmDKvGpnP_lkFazVg&oe=6ABFD114"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "gameplayVR3.png", "id": "492345567046352", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974804_492345570379685_6511341930176300148_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9LOn7cGIFN0Q7kNvwFc6k9M&_nc_oc=AdqXG7SkbCzA6YWO7QZu9uTlIP3PcOpm74CJU331Bf63k5dVnTmgH40txU7iSyyV70Y&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN_tZLnNvnLMYnsFgPi1lkxgsSHLj8Lz2OGPipquSTiJg&oe=6ABFDC6D"}, "display_name": "Escape Simulator", "keywords": ["escape", "room", "coop", "multiplayer", "simulator"], "long_description": "Escape Simulator is a first-person puzzler you can **play solo or in an online co-op** (best with 2-3 players, but playable with up to 8!). Explore a growing set of **highly interactive escape rooms**. Pick up and examine everything, break objects, solve locks, and decipher puzzles to escape! After finishing the main game, watch for free content updates and explore rooms **built by our awesome community**.\n\n# \u2b50**REVIEWS** \n\"What I've seen has left me considerably impressed.\" - UploadVR\n\n# \u2692\ufe0f**COMMUNITY-MADE ROOMS**\nAfter finishing the main game **explore numerous rooms** built by our amazing community.\n\n# \ud83e\udd1d**ONLINE CO-OP**\nAll rooms are playable in an online co-op. Play with up to 8 players (best played with 2-3). Customize your character and join friends to solve puzzles together. More heads are better than one!\n\n# \ud83e\udde9**INTERACTIVE PUZZLES**\nExplore 28+ official rooms filled with puzzles designed by real-life escape room operators. If it\u2019s not nailed down, you can pick it up.\n\n# \ud83d\udd0d**EXEMINE EVERYTHING**\nRead books, examine ancient artifacts, and find clues to riddles. Need to cross-reference a clue? No problem - just pin it!\n\n# \ud83c\udfc6**WANT MORE?**\nThe game features additional content in the form of Addons with 4 large rooms each: \n- **Steampunk**: Solve four new rooms on the beautiful steampunk airship \"Valor.\"\n- **Wild West**: Become an outlaw in the Wild West.\n- **Magic**: Embrace your magic potential, and follow in the footsteps of great witches and wizards. \n\n", "short_description": "First-person puzzler you can play solo or in an online co-op. Explore a set of highly interactive escape rooms. Move furniture, pick up and examine everything, smash pots and break
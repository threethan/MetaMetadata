5/65396729_1225052078868354_6945820870147360559_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MJvic51Lf9UQ7kNvwHgwM3n&_nc_oc=AdpqTyWGioi3T5e87ZJyqZ39lsd4V0QtqVw0WzNm473tXgwopm-Ei2hqcQKYrAJcTo4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxY6sE0PSY2bZOXe71FAM3BrqtKxq3wqzS5tC7DwrdAXw&oe=69C92D1E"}, {"file_name": "4.png", "id": "975198817093493", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/57566693_975198820426826_7097624739394196541_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=99dq4ZyaQGQQ7kNvwGTC-JW&_nc_oc=AdqeKKi58k-mm9-jaXrzI1Eu2u5pcflAvmhnmFRJgEl1ngU3KyjrT6azv9w-103KINs&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyY-2VZ5y1Z4IPP5sTzEoIKqeDsbY5xDu-BvtDu8Q9LvQ&oe=69C92ECC"}, {"file_name": "1.png", "id": "415893571368646", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39001715_415893574701979_3461447245540982035_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uuIEcRv7j2wQ7kNvwEcnXs4&_nc_oc=AdqSMD6GsSXSHtAXgxi6i3E_PnY_P_45jR0QWXRqucXKKUsDCMV1hhL91O_XF2GVdIU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfysnHYjksbzZSy00ctdU9pzRGoYFWNQCHS71C7is2WwjA&oe=69C911D6"}, {"file_name": "3.png", "id": "662596896051796", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974523_662596899385129_8527079563659693432_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=190VfX9MWZ8Q7kNvwHHlyCX&_nc_oc=Adp9yxHUtg5g_RrVvUp8Y-x_2jY8EcIta9nygd6koI12mr2NCNANon1bBAgTeY5vYDA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxCJWudYvOKqcvrxbsp_JHb4th9DQpQRcJfLOoCF9CpbQ&oe=69C91054"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "gameplayVR3.png", "id": "492345567046352", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974804_492345570379685_6511341930176300148_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YS13gUkMtD0Q7kNvwHK3Zo4&_nc_oc=AdpgZslRcbdicgc8hiiB7fwniQPYB8IZyrhdv1k3oFN0qU8KfKzBbkbKOcPo0Gkbd3E&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwzBkHRP5zgYrp6HmbpqlSMAgyG7FU5Hq9GshN36tqwiw&oe=69C91BAD"}, "display_name": "Escape Simulator", "keywords": ["escape", "room", "coop", "multiplayer", "simulator"], "long_description": "Escape Simulator is a first-person puzzler you can **play solo or in an online co-op** (best with 2-3 players, but playable with up to 8!). Explore a growing set of **highly interactive escape rooms**. Pick up and examine everything, break objects, solve locks, and decipher puzzles to escape! After finishing the main game, watch for free content updates and explore rooms **built by our awesome community**.\n\n# \u2b50**REVIEWS** \n\"What I've seen has left me considerably impressed.\" - UploadVR\n\n# \u2692\ufe0f**COMMUNITY-MADE ROOMS**\nAfter finishing the main game **explore numerous rooms** built by our amazing community.\n\n# \ud83e\udd1d**ONLINE CO-OP**\nAll rooms are playable in an online co-op. Play with up to 8 players (best played with 2-3). Customize your character and join friends to solve puzzles together. More heads are better than one!\n\n# \ud83e\udde9**INTERACTIVE PUZZLES**\nExplore 28+ official rooms filled with puzzles designed by real-life escape room operators. If it\u2019s not nailed down, you can pick it up.\n\n# \ud83d\udd0d**EXEMINE EVERYTHING**\nRead books, examine ancient artifacts, and find clues to riddles. Need to cross-reference a clue? No problem - just pin it!\n\n# \ud83c\udfc6**WANT MORE?**\nThe game features additional content in the form of Addons with 4 large rooms each: \n- **Steampunk**: Solve four new rooms on the beautiful steampunk airship \"Valor.\"\n- **Wild West**: Become an outlaw in the Wild West.\n- **Magic**: Embrace your magic potential, and follow in the footsteps of great witches and wizards. \n\n", "short_description": "First-person puzzler you can play solo or in an online co-op. Explore a set of highly interactive escape rooms. Move furniture, pick up and examine everything, smash pots and break 
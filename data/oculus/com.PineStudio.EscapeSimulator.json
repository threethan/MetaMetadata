25/65396729_1225052078868354_6945820870147360559_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GUhs0xRqujUQ7kNvwHSJkxC&_nc_oc=AdphYzXNl1pyfdIokztfYrCaffeO3zyP1MviIIIjCrpk5nNOuRREl9C2hKhBCNA_yYg&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIvsejHObdYZxvhuZSiCFhIGvSJhEkxNP4SmeFStPIFiA&oe=6AAD409E"}, {"file_name": "4.png", "id": "975198817093493", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/57566693_975198820426826_7097624739394196541_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E9eIwBFltEwQ7kNvwEWagD-&_nc_oc=AdrpVNopz_SKmEVLQVvZIX6fVL2bl7k34UW46Uqas4uoEgUx-7qvrFxILp5Ljb6es4g&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLL3aINjI6domR0zuguaDTrLBxVdotWX3AqZFvpziAcDA&oe=6AAD424C"}, {"file_name": "1.png", "id": "415893571368646", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39001715_415893574701979_3461447245540982035_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MfBACRiOUmAQ7kNvwGVSaNa&_nc_oc=Adq181oH2kMPi4W2M0Ie1xGGefW_WUaXEoOTjHtE5H7OQb4rGS9GjZbLZ6OYB2IpuJ4&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIU31j7_dM0fdgkvPzO8B17zNGipABxMOpidW8A9tvUuQ&oe=6AAD5D96"}, {"file_name": "3.png", "id": "662596896051796", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974523_662596899385129_8527079563659693432_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hzYY6q_lswsQ7kNvwFUaJQ8&_nc_oc=AdruWTPnZcIIwXtZW1ByMwugM68VnnGKKxXPZMfcCJPa-KUOihHuRunmOVhGf1ros3c&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIggJzLLsJcp2p8knXIHbtCE-DRtpwFmuWz-MMCrJrtZg&oe=6AAD5C14"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "gameplayVR3.png", "id": "492345567046352", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974804_492345570379685_6511341930176300148_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RebU9LjIxLoQ7kNvwGF5z01&_nc_oc=AdpFUAbS2GZnPcU2v75JosI3Bs8WGpXGvGrSyTwhVL0KMHwrEAWOnbUctU8lWxy0sG4&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKo--6zITjuqq2kBZsY9p-kqj6kTwC59ZKIZPmmQn5LIw&oe=6AAD2F2D"}, "display_name": "Escape Simulator", "keywords": ["escape", "room", "coop", "multiplayer", "simulator"], "long_description": "Escape Simulator is a first-person puzzler you can **play solo or in an online co-op** (best with 2-3 players, but playable with up to 8!). Explore a growing set of **highly interactive escape rooms**. Pick up and examine everything, break objects, solve locks, and decipher puzzles to escape! After finishing the main game, watch for free content updates and explore rooms **built by our awesome community**.\n\n# \u2b50**REVIEWS** \n\"What I've seen has left me considerably impressed.\" - UploadVR\n\n# \u2692\ufe0f**COMMUNITY-MADE ROOMS**\nAfter finishing the main game **explore numerous rooms** built by our amazing community.\n\n# \ud83e\udd1d**ONLINE CO-OP**\nAll rooms are playable in an online co-op. Play with up to 8 players (best played with 2-3). Customize your character and join friends to solve puzzles together. More heads are better than one!\n\n# \ud83e\udde9**INTERACTIVE PUZZLES**\nExplore 28+ official rooms filled with puzzles designed by real-life escape room operators. If it\u2019s not nailed down, you can pick it up.\n\n# \ud83d\udd0d**EXEMINE EVERYTHING**\nRead books, examine ancient artifacts, and find clues to riddles. Need to cross-reference a clue? No problem - just pin it!\n\n# \ud83c\udfc6**WANT MORE?**\nThe game features additional content in the form of Addons with 4 large rooms each: \n- **Steampunk**: Solve four new rooms on the beautiful steampunk airship \"Valor.\"\n- **Wild West**: Become an outlaw in the Wild West.\n- **Magic**: Embrace your magic potential, and follow in the footsteps of great witches and wizards. \n\n", "short_description": "First-person puzzler you can play solo or in an online co-op. Explore a set of highly interactive escape rooms. Move furniture, pick up and examine everything, smash pots and break
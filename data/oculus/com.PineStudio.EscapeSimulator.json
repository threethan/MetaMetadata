5/65396729_1225052078868354_6945820870147360559_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jW_iZxV0qDoQ7kNvwF9bxyW&_nc_oc=AdoDXd7NffeYvcRRfJM3Q55TSY1CHAQmjHfZxETClpRI_Z6q6Sdh6yuGSveNmU8bGH4&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2_vhn0A6nL8iDktolhw9Aoj-OjsQiD2rgmvbgkoVqXPA&oe=69DCF39E"}, {"file_name": "4.png", "id": "975198817093493", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/57566693_975198820426826_7097624739394196541_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Px6RVFzKciEQ7kNvwFr9Imu&_nc_oc=AdqnvgKwb7S1NTlwCwMOyUDZdyxmoezkRHX_hsH2GXwyMGYCU-lPgAl5xIId6Yf3VZo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2cRoQ070OlLHt0TyGpDNHaI_w2O9Up6hwl63NSo3d4wQ&oe=69DCF54C"}, {"file_name": "1.png", "id": "415893571368646", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39001715_415893574701979_3461447245540982035_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FEGzST_FvuIQ7kNvwEJGWnI&_nc_oc=Adq255IvYNlfmkpgbsKqrcpr_CJwugtG4NHP2Td5MD4DRgSvONuEWak4ssp4-wLWdFc&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2tTKXxD0zh5SxBlzWlhrEUG17kS7koYnkAVDKoTA3I5Q&oe=69DCD856"}, {"file_name": "3.png", "id": "662596896051796", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974523_662596899385129_8527079563659693432_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kSGNP3B_hGIQ7kNvwGEk6rM&_nc_oc=Adpl1jL3cHoZvq3Z86-YDnTCqkwlM_kcdSzKEV-qexYMnhoMc0xEQl8qaGMF45MvH2w&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0dUGJl710b9ZwiwgAsMzIF0wQTdHze7KOz0oigWcf_yw&oe=69DCD6D4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "gameplayVR3.png", "id": "492345567046352", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974804_492345570379685_6511341930176300148_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4Jii1lJ9OkwQ7kNvwFhTWMh&_nc_oc=AdpB7xdihE8zDpy-MhEKpYspJm5_nnBV4h5zIvlOUwNrlEskxuijgmBxEN1GTaObKPE&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2d5qxIT2jWs1TRIdKh9I-lqtbCMjt4DRSoX8VJjXOscg&oe=69DCE22D"}, "display_name": "Escape Simulator", "keywords": ["escape", "room", "coop", "multiplayer", "simulator"], "long_description": "Escape Simulator is a first-person puzzler you can **play solo or in an online co-op** (best with 2-3 players, but playable with up to 8!). Explore a growing set of **highly interactive escape rooms**. Pick up and examine everything, break objects, solve locks, and decipher puzzles to escape! After finishing the main game, watch for free content updates and explore rooms **built by our awesome community**.\n\n# \u2b50**REVIEWS** \n\"What I've seen has left me considerably impressed.\" - UploadVR\n\n# \u2692\ufe0f**COMMUNITY-MADE ROOMS**\nAfter finishing the main game **explore numerous rooms** built by our amazing community.\n\n# \ud83e\udd1d**ONLINE CO-OP**\nAll rooms are playable in an online co-op. Play with up to 8 players (best played with 2-3). Customize your character and join friends to solve puzzles together. More heads are better than one!\n\n# \ud83e\udde9**INTERACTIVE PUZZLES**\nExplore 28+ official rooms filled with puzzles designed by real-life escape room operators. If it\u2019s not nailed down, you can pick it up.\n\n# \ud83d\udd0d**EXEMINE EVERYTHING**\nRead books, examine ancient artifacts, and find clues to riddles. Need to cross-reference a clue? No problem - just pin it!\n\n# \ud83c\udfc6**WANT MORE?**\nThe game features additional content in the form of Addons with 4 large rooms each: \n- **Steampunk**: Solve four new rooms on the beautiful steampunk airship \"Valor.\"\n- **Wild West**: Become an outlaw in the Wild West.\n- **Magic**: Embrace your magic potential, and follow in the footsteps of great witches and wizards. \n\n", "short_description": "First-person puzzler you can play solo or in an online co-op. Explore a set of highly interactive escape rooms. Move furniture, pick up and examine everything, smash pots and break 
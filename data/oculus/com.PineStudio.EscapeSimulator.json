5/65396729_1225052078868354_6945820870147360559_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A4O3HCtmpUAQ7kNvwF3J63L&_nc_oc=AdoHsbJlKmtJyfLFWfP5olFJ2GK2hm5BYb-pLKGdRnwLoRn2B5fHim14XIQto7to8Lk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-VJTD-8CFdQf5radHA2jvLPQygsRxASsE-f9MS5qPoGw&oe=6A296A9E"}, {"file_name": "4.png", "id": "975198817093493", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/57566693_975198820426826_7097624739394196541_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uRhlpAnXyuAQ7kNvwHhGC3Y&_nc_oc=AdqxChav1FUOHyzgQZhvEr8KNEO7EQ7ycj77a5eU9xl-EKifvPBNGJI46wMc6_K3Loo&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_O_yKFbFHGq-le3aglJaSCehMoq6CHRyjNh9a_32bufw&oe=6A296C4C"}, {"file_name": "1.png", "id": "415893571368646", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39001715_415893574701979_3461447245540982035_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LMZLG2DKyK8Q7kNvwHgu-5Z&_nc_oc=AdpS_JBGxelHaMwlQAG9ae1hHva7nere0r6yRwOeJMFF-AA6IwbBjLHph6YI2cVk7zA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-8tLeA68E2-k3D8sYEIDCgfEARsLJ1WpXv5Q56zIX5KQ&oe=6A298796"}, {"file_name": "3.png", "id": "662596896051796", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974523_662596899385129_8527079563659693432_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ObUmhG9GMBQQ7kNvwEPW41N&_nc_oc=AdptU2V0EMMSIues0wBVXtCmOn87Tm5PJCQRkQQiKKvogm_v4BM5e4IOZYFSbva-Kio&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_1k8cfzbaw8UWRwITBcgXTrZy04Pg4cNUA_VCranoDVA&oe=6A298614"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "gameplayVR3.png", "id": "492345567046352", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974804_492345570379685_6511341930176300148_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FiM1ioF2hjkQ7kNvwGcI-EV&_nc_oc=AdqEJ2DjKIicqpLqGD3ZL6eMFbZMKdd39eKR5JqYq-vSvDaBgGAHGbVuQgXIuu2eEpA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9kjSkUTiK2c0HwpN8qlKJU_ICgjGM0Uotj60NNGv4A9w&oe=6A29592D"}, "display_name": "Escape Simulator", "keywords": ["escape", "room", "coop", "multiplayer", "simulator"], "long_description": "Escape Simulator is a first-person puzzler you can **play solo or in an online co-op** (best with 2-3 players, but playable with up to 8!). Explore a growing set of **highly interactive escape rooms**. Pick up and examine everything, break objects, solve locks, and decipher puzzles to escape! After finishing the main game, watch for free content updates and explore rooms **built by our awesome community**.\n\n# \u2b50**REVIEWS** \n\"What I've seen has left me considerably impressed.\" - UploadVR\n\n# \u2692\ufe0f**COMMUNITY-MADE ROOMS**\nAfter finishing the main game **explore numerous rooms** built by our amazing community.\n\n# \ud83e\udd1d**ONLINE CO-OP**\nAll rooms are playable in an online co-op. Play with up to 8 players (best played with 2-3). Customize your character and join friends to solve puzzles together. More heads are better than one!\n\n# \ud83e\udde9**INTERACTIVE PUZZLES**\nExplore 28+ official rooms filled with puzzles designed by real-life escape room operators. If it\u2019s not nailed down, you can pick it up.\n\n# \ud83d\udd0d**EXEMINE EVERYTHING**\nRead books, examine ancient artifacts, and find clues to riddles. Need to cross-reference a clue? No problem - just pin it!\n\n# \ud83c\udfc6**WANT MORE?**\nThe game features additional content in the form of Addons with 4 large rooms each: \n- **Steampunk**: Solve four new rooms on the beautiful steampunk airship \"Valor.\"\n- **Wild West**: Become an outlaw in the Wild West.\n- **Magic**: Embrace your magic potential, and follow in the footsteps of great witches and wizards. \n\n", "short_description": "First-person puzzler you can play solo or in an online co-op. Explore a set of highly interactive escape rooms. Move furniture, pick up and examine everything, smash pots and break 
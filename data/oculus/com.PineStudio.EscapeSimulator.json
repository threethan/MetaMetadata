5/65396729_1225052078868354_6945820870147360559_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qrxVG3xvi0gQ7kNvwFRu0LK&_nc_oc=AdpRvUrSLez3mkrt-Scf731LfnuesCP_jcN4qSbkb1Vkwo01zN0KyFGm8YQ-d_s6b1w&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4OQScgANiquYq-7oJtptaY7JvuC4yJqzVSlPWA3i3Hdw&oe=6A18471E"}, {"file_name": "4.png", "id": "975198817093493", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/57566693_975198820426826_7097624739394196541_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Q9Qy6p8ibkUQ7kNvwFIO-Ml&_nc_oc=Adp-sC89qkqIeQBxh_rccZXBMKvX0TrYnJOAoiI4DWqfT6Ruia0f9DSDQiN4chQBkAA&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4yMSt4uvaWnuT6kQWfYxFpwaC4_Kxr0WB4_f0Fl_lmpA&oe=6A1848CC"}, {"file_name": "1.png", "id": "415893571368646", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39001715_415893574701979_3461447245540982035_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uVug9y6q38MQ7kNvwHCn9K_&_nc_oc=AdomNoNY-QWN21WgL7Hsgsph33O_mJzSze14z8AvwbYvnhtsNpkpPWXb1z3-u2wfCcQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af48STfvAvEYcwisr7j5vLt1_AKi9yPxKtMNXMMhHyIlRg&oe=6A186416"}, {"file_name": "3.png", "id": "662596896051796", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974523_662596899385129_8527079563659693432_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xzykqwEfVncQ7kNvwFcNLNP&_nc_oc=AdqlpZRViWySK7gaeC5vM4YJGhKq83v9nNJEOjAF1NtbKIv-iBZJNCzXc_DvRLgC3S8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6VVZtV2EMJs2DpZ8aIc-f5UCTsvYOhGWZkOQkua9EKfw&oe=6A186294"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "gameplayVR3.png", "id": "492345567046352", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974804_492345570379685_6511341930176300148_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XOvuQuFox_cQ7kNvwEhCU1k&_nc_oc=Adowm7_ySTuR161b-nLzC4k2LGsEAPMO9N92nJ9CaRTyS4WqjeXT2Vbf4LpRFpA5mXE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6kKh_yjJlhsz1mwH7Ose_Fpe-wbRKijV_ubEXufRYZMg&oe=6A1835AD"}, "display_name": "Escape Simulator", "keywords": ["escape", "room", "coop", "multiplayer", "simulator"], "long_description": "Escape Simulator is a first-person puzzler you can **play solo or in an online co-op** (best with 2-3 players, but playable with up to 8!). Explore a growing set of **highly interactive escape rooms**. Pick up and examine everything, break objects, solve locks, and decipher puzzles to escape! After finishing the main game, watch for free content updates and explore rooms **built by our awesome community**.\n\n# \u2b50**REVIEWS** \n\"What I've seen has left me considerably impressed.\" - UploadVR\n\n# \u2692\ufe0f**COMMUNITY-MADE ROOMS**\nAfter finishing the main game **explore numerous rooms** built by our amazing community.\n\n# \ud83e\udd1d**ONLINE CO-OP**\nAll rooms are playable in an online co-op. Play with up to 8 players (best played with 2-3). Customize your character and join friends to solve puzzles together. More heads are better than one!\n\n# \ud83e\udde9**INTERACTIVE PUZZLES**\nExplore 28+ official rooms filled with puzzles designed by real-life escape room operators. If it\u2019s not nailed down, you can pick it up.\n\n# \ud83d\udd0d**EXEMINE EVERYTHING**\nRead books, examine ancient artifacts, and find clues to riddles. Need to cross-reference a clue? No problem - just pin it!\n\n# \ud83c\udfc6**WANT MORE?**\nThe game features additional content in the form of Addons with 4 large rooms each: \n- **Steampunk**: Solve four new rooms on the beautiful steampunk airship \"Valor.\"\n- **Wild West**: Become an outlaw in the Wild West.\n- **Magic**: Embrace your magic potential, and follow in the footsteps of great witches and wizards. \n\n", "short_description": "First-person puzzler you can play solo or in an online co-op. Explore a set of highly interactive escape rooms. Move furniture, pick up and examine everything, smash pots and break 
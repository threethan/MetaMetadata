25/65396729_1225052078868354_6945820870147360559_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wthenGFztWkQ7kNvwEod31X&_nc_oc=Ado_sAcMu5LjdypHkD1m6gmZDS7o0oEnmArv__HULbo6WTzTJGBRTsG1bjjT2WR-Z_k&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLN8H13JMp0kjFIFFFssHPTrzyxq826P5UGqG3RdYyCzA&oe=6A9D6E9E"}, {"file_name": "4.png", "id": "975198817093493", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/57566693_975198820426826_7097624739394196541_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gTKwo_TPN8gQ7kNvwFo0Fic&_nc_oc=Adqd0hD0Qzbtxy8UEdGDOaPq7i8ssIwTB3X7dQPg1Wj0SAwH6FlUaSGmHeXRMAgtJNw&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLloyjvULufWQtazdYJkC7vcoYhAOSSL6DpG6_QR9oicg&oe=6A9D704C"}, {"file_name": "1.png", "id": "415893571368646", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39001715_415893574701979_3461447245540982035_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j1Ip7L3ca6QQ7kNvwEGnGrz&_nc_oc=Adqkrj4nCa2BOjPuqYjubE2ImsS3K7KdCF7Jk0wKHNHIhN0dIWTkiKnm_qvQO8y-YX0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI3v7NuJHPwvZdlvoCbyCHElu3BOiUD1Nhne4zmyOlneA&oe=6A9D5356"}, {"file_name": "3.png", "id": "662596896051796", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974523_662596899385129_8527079563659693432_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yoRC1UJ9AMIQ7kNvwGXfL8P&_nc_oc=Adpn5yU3YuvC-r0oWmZI9AqehDoigXwpmSf0oysoVVqiyKKZRAh304V-x0NX196iVcA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIkUe8NClgk41wOFYb8FhxBAQTNtJ6Ui3QNQ0YAj_0euA&oe=6A9D8A14"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "gameplayVR3.png", "id": "492345567046352", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974804_492345570379685_6511341930176300148_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v0TiDlK39f4Q7kNvwHACynn&_nc_oc=AdqY4Fp0VkbX6XRyv0Ts5wQc8bWcyu3EcA2xGtKEoXCXNsUXcj2iwlXmGln5Quj3O1I&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL9n12W_ICAyhbcUcRx5sImCeB13MhIJImYb-chdYV_9A&oe=6A9D5D2D"}, "display_name": "Escape Simulator", "keywords": ["escape", "room", "coop", "multiplayer", "simulator"], "long_description": "Escape Simulator is a first-person puzzler you can **play solo or in an online co-op** (best with 2-3 players, but playable with up to 8!). Explore a growing set of **highly interactive escape rooms**. Pick up and examine everything, break objects, solve locks, and decipher puzzles to escape! After finishing the main game, watch for free content updates and explore rooms **built by our awesome community**.\n\n# \u2b50**REVIEWS** \n\"What I've seen has left me considerably impressed.\" - UploadVR\n\n# \u2692\ufe0f**COMMUNITY-MADE ROOMS**\nAfter finishing the main game **explore numerous rooms** built by our amazing community.\n\n# \ud83e\udd1d**ONLINE CO-OP**\nAll rooms are playable in an online co-op. Play with up to 8 players (best played with 2-3). Customize your character and join friends to solve puzzles together. More heads are better than one!\n\n# \ud83e\udde9**INTERACTIVE PUZZLES**\nExplore 28+ official rooms filled with puzzles designed by real-life escape room operators. If it\u2019s not nailed down, you can pick it up.\n\n# \ud83d\udd0d**EXEMINE EVERYTHING**\nRead books, examine ancient artifacts, and find clues to riddles. Need to cross-reference a clue? No problem - just pin it!\n\n# \ud83c\udfc6**WANT MORE?**\nThe game features additional content in the form of Addons with 4 large rooms each: \n- **Steampunk**: Solve four new rooms on the beautiful steampunk airship \"Valor.\"\n- **Wild West**: Become an outlaw in the Wild West.\n- **Magic**: Embrace your magic potential, and follow in the footsteps of great witches and wizards. \n\n", "short_description": "First-person puzzler you can play solo or in an online co-op. Explore a set of highly interactive escape rooms. Move furniture, pick up and examine everything, smash pots and break
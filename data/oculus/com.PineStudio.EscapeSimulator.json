5/65396729_1225052078868354_6945820870147360559_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sf_iiILsUxMQ7kNvwFJ_jIF&_nc_oc=Adr7nSmnLtu-RJqMRTGElKD-It60ag1c4WzrO9yn7SModfrqSmIOOwTF4Fs_tOXViks&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4wrI52SoCnD836-pXWJJmBS-nMVZga0UM58Cype9HTiA&oe=6A1C3B9E"}, {"file_name": "4.png", "id": "975198817093493", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/57566693_975198820426826_7097624739394196541_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rvQ_PPjdik8Q7kNvwFdNAGe&_nc_oc=AdoPcavwILVfPdKMhqDPaFwR-h88MEYRycH9oAbRG9qbeA9gppa7yci0bAb3RwtPYCU&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4b3HrqydJPQ7tUn3XLoNbBP-RHhIgjc8EYL0LmSnXRZQ&oe=6A1C3D4C"}, {"file_name": "1.png", "id": "415893571368646", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/39001715_415893574701979_3461447245540982035_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5l-Bln4YZsAQ7kNvwHtOfAl&_nc_oc=Adr1PHUX65qVpGeGf7MBZeiQuX4kQWCPYpO2VHg-rikJXHVZ-c2Yd-bbmxlHD3u-ndE&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5FlAizd4PDy23AZnVGJuJsDvKBEhoehL3DNJd0JmNX1g&oe=6A1C5896"}, {"file_name": "3.png", "id": "662596896051796", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38974523_662596899385129_8527079563659693432_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BC3hHnZQmW4Q7kNvwGwmBBE&_nc_oc=AdpFgIH7FsS5frvie02lXoAcDsCAGwSC2sT9gWPX9DVuHGss_ITuQmlD7Qbc8QOLYRs&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af45L0miU-VV02EuZdAwRehlrswMeARiXc3cwwV-FDfNKw&oe=6A1C5714"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "gameplayVR3.png", "id": "492345567046352", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38974804_492345570379685_6511341930176300148_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WfwM7BxAzaAQ7kNvwFV2PBo&_nc_oc=AdqtkdAmULVX5ZFi17eH-tcTV8FOQTeh_97xf8i1y479ziN8As9FsHCBvQgu1lsIsf4&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5WwOFjlGhcxeJqfczHSyuRij4kS92VP1l4OVvy_kzLvA&oe=6A1C2A2D"}, "display_name": "Escape Simulator", "keywords": ["escape", "room", "coop", "multiplayer", "simulator"], "long_description": "Escape Simulator is a first-person puzzler you can **play solo or in an online co-op** (best with 2-3 players, but playable with up to 8!). Explore a growing set of **highly interactive escape rooms**. Pick up and examine everything, break objects, solve locks, and decipher puzzles to escape! After finishing the main game, watch for free content updates and explore rooms **built by our awesome community**.\n\n# \u2b50**REVIEWS** \n\"What I've seen has left me considerably impressed.\" - UploadVR\n\n# \u2692\ufe0f**COMMUNITY-MADE ROOMS**\nAfter finishing the main game **explore numerous rooms** built by our amazing community.\n\n# \ud83e\udd1d**ONLINE CO-OP**\nAll rooms are playable in an online co-op. Play with up to 8 players (best played with 2-3). Customize your character and join friends to solve puzzles together. More heads are better than one!\n\n# \ud83e\udde9**INTERACTIVE PUZZLES**\nExplore 28+ official rooms filled with puzzles designed by real-life escape room operators. If it\u2019s not nailed down, you can pick it up.\n\n# \ud83d\udd0d**EXEMINE EVERYTHING**\nRead books, examine ancient artifacts, and find clues to riddles. Need to cross-reference a clue? No problem - just pin it!\n\n# \ud83c\udfc6**WANT MORE?**\nThe game features additional content in the form of Addons with 4 large rooms each: \n- **Steampunk**: Solve four new rooms on the beautiful steampunk airship \"Valor.\"\n- **Wild West**: Become an outlaw in the Wild West.\n- **Magic**: Embrace your magic potential, and follow in the footsteps of great witches and wizards. \n\n", "short_description": "First-person puzzler you can play solo or in an online co-op. Explore a set of highly interactive escape rooms. Move furniture, pick up and examine everything, smash pots and break 
oculuscdn.com/v/t64.5771-25/57566693_975198820426826_7097624739394196541_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ByJ-UAutpKIQ7kNvwHkwJzx&_nc_oc=AdrJiUnKdOuORnN-BgOrbNL-GLPiF8l0DLNbD90M-dKl6x8ykgNOeJzfx9UwlMu4N1U&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Af20357TFN4BgKMBEFE5JIHQdIDaKCqmvI5OqCmRKiX42Q&oe=69F0BBCC"}, {"file_name": "1.png", "id": "415893571368646", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39001715_415893574701979_3461447245540982035_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b3wQy_FsPTEQ7kNvwEMmrJy&_nc_oc=AdprZm5Z120sMWjl35086SPMKqrWlgcFb4IsxoZNodm9CtNYNYKL4ySkFrTdzv3uZ44&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af3K0XROGym0Bk0fKpfeOuiX6IYuXBUelrX7ioXpjugExQ&oe=69F09ED6"}, {"file_name": "3.png", "id": "662596896051796", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974523_662596899385129_8527079563659693432_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4fNLDEaSKzUQ7kNvwFhEsfW&_nc_oc=Adr8D-9ncwXKYZQCBroShvnUNhAYvl5_FM5c8-2JcmM1izz-Oi9HkO-6T9lhoBvs-sg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Af3rk4C3pFsBTcxgi1AsznMomvPfOmALlyrHoIESrGQFGQ&oe=69F09D54"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "gameplayVR3.png", "id": "492345567046352", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974804_492345570379685_6511341930176300148_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uhYOPKcxluAQ7kNvwGp8f6z&_nc_oc=AdrXC9g_2DFj7opAYDJLHM11rHbMEaSay_8hfIAKYeMPf2En8uSyca5v9Wm9rADirZY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af1sv5JXNBp6Y9m1IHcCGeGvnHTibDxedHDpRQy42-dZgw&oe=69F0A8AD"}, "display_name": "Escape Simulator", "keywords": ["escape", "room", "coop", "multiplayer", "simulator"], "long_description": "Escape Simulator is a first-person puzzler you can **play solo or in an online co-op** (best with 2-3 players, but playable with up to 8!). Explore a growing set of **highly interactive escape rooms**. Pick up and examine everything, break objects, solve locks, and decipher puzzles to escape! After finishing the main game, watch for free content updates and explore rooms **built by our awesome community**.\n\n# \u2b50**REVIEWS** \n\"What I've seen has left me considerably impressed.\" - UploadVR\n\n# \u2692\ufe0f**COMMUNITY-MADE ROOMS**\nAfter finishing the main game **explore numerous rooms** built by our amazing community.\n\n# \ud83e\udd1d**ONLINE CO-OP**\nAll rooms are playable in an online co-op. Play with up to 8 players (best played with 2-3). Customize your character and join friends to solve puzzles together. More heads are better than one!\n\n# \ud83e\udde9**INTERACTIVE PUZZLES**\nExplore 28+ official rooms filled with puzzles designed by real-life escape room operators. If it\u2019s not nailed down, you can pick it up.\n\n# \ud83d\udd0d**EXEMINE EVERYTHING**\nRead books, examine ancient artifacts, and find clues to riddles. Need to cross-reference a clue? No problem - just pin it!\n\n# \ud83c\udfc6**WANT MORE?**\nThe game features additional content in the form of Addons with 4 large rooms each: \n- **Steampunk**: Solve four new rooms on the beautiful steampunk airship \"Valor.\"\n- **Wild West**: Become an outlaw in the Wild West.\n- **Magic**: Embrace your magic potential, and follow in the footsteps of great witches and wizards. \n\n", "short_description": "First-person puzzler you can play solo or in an online co-op. Explore a set of highly interactive escape rooms. Move furniture, pick up and examine everything, smash pots and break locks! Supports community rooms through the level editor."}]}, "developer_name": null, "developer_privacy_policy_url": "https://pinestudio.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Pine Studio", "support_website_url": "https://pinestudio.com/contact/", "website_url": "https://pinestudio.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035
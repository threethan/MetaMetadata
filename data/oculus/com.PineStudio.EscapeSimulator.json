25/65396729_1225052078868354_6945820870147360559_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wADogf5r6fcQ7kNvwEoyMMy&_nc_oc=Adp5ARHMSV2DG5ZZWnGOAlS3grramGz5ekO3_MrV2HUpHyUNbV29sHt7Kz7PVsG17YM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQABKvJxebyKj4TnxU4mpV-3Qb65cpDukGtixzMi6FkeaA&oe=6A64BE1E"}, {"file_name": "4.png", "id": "975198817093493", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/57566693_975198820426826_7097624739394196541_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JxywwRuHBmsQ7kNvwGFbdpx&_nc_oc=AdretPSdNAbI9ytj99AGo37fTwfT6sbG4SZcGQ1yz837cMffq8_AK8N1vkwv_4_khk0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA4NIucA5P1MSTVYmZslDbAHetBnlq2igclZw6ThaoZLg&oe=6A64BFCC"}, {"file_name": "1.png", "id": "415893571368646", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39001715_415893574701979_3461447245540982035_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eDiXW2A1cwIQ7kNvwF1o_sT&_nc_oc=Adqv14FQ0-mwT54VG6suiMNTdONZiBJS6PoNPGTg58gQIARi_61RYKmQYJyGE1fdADI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDIbwFRb-KImKagNE2L_2d43VQihdMcVNV5i5relO1j9A&oe=6A64A2D6"}, {"file_name": "3.png", "id": "662596896051796", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974523_662596899385129_8527079563659693432_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_jvjmEMOu3MQ7kNvwEEJrja&_nc_oc=AdrMe9ZdeWgdIZjlANP6cejP5XWTvfkD3rAQ5ZoQGjG2-6ThRw1R2kSBCNu7gaC66yE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB1v9Uqy8ql6tEMCrq59vQiv6Ykbo54E13OaJXy2OR4nQ&oe=6A64A154"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "gameplayVR3.png", "id": "492345567046352", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974804_492345570379685_6511341930176300148_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u2Aed3Y8rMwQ7kNvwEkZPcg&_nc_oc=Adoz5cvcfymO95unWr3MNriN5JthngbfCmeXD5_lRuhVVFj46_TRF4_MQEpL3dVH6Zg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB-zzAkqBkR6Dma5ENPv9mc2odU_nvJXunoXIO_9WZAZQ&oe=6A64ACAD"}, "display_name": "Escape Simulator", "keywords": ["escape", "room", "coop", "multiplayer", "simulator"], "long_description": "Escape Simulator is a first-person puzzler you can **play solo or in an online co-op** (best with 2-3 players, but playable with up to 8!). Explore a growing set of **highly interactive escape rooms**. Pick up and examine everything, break objects, solve locks, and decipher puzzles to escape! After finishing the main game, watch for free content updates and explore rooms **built by our awesome community**.\n\n# \u2b50**REVIEWS** \n\"What I've seen has left me considerably impressed.\" - UploadVR\n\n# \u2692\ufe0f**COMMUNITY-MADE ROOMS**\nAfter finishing the main game **explore numerous rooms** built by our amazing community.\n\n# \ud83e\udd1d**ONLINE CO-OP**\nAll rooms are playable in an online co-op. Play with up to 8 players (best played with 2-3). Customize your character and join friends to solve puzzles together. More heads are better than one!\n\n# \ud83e\udde9**INTERACTIVE PUZZLES**\nExplore 28+ official rooms filled with puzzles designed by real-life escape room operators. If it\u2019s not nailed down, you can pick it up.\n\n# \ud83d\udd0d**EXEMINE EVERYTHING**\nRead books, examine ancient artifacts, and find clues to riddles. Need to cross-reference a clue? No problem - just pin it!\n\n# \ud83c\udfc6**WANT MORE?**\nThe game features additional content in the form of Addons with 4 large rooms each: \n- **Steampunk**: Solve four new rooms on the beautiful steampunk airship \"Valor.\"\n- **Wild West**: Become an outlaw in the Wild West.\n- **Magic**: Embrace your magic potential, and follow in the footsteps of great witches and wizards. \n\n", "short_description": "First-person puzzler you can play solo or in an online co-op. Explore a set of highly interactive escape rooms. Move furniture, pick up and examine everything, smash pots and break
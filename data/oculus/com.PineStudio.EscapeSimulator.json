5/65396729_1225052078868354_6945820870147360559_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FpwEBVjrfxEQ7kNvwE3qqK4&_nc_oc=Adr7B-2yvs7rudOFq-5Kb_sdQIWMps3K1dG1X_D6aVyBOMf9E4-ChvlYAMFKMl1cW78&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0URyytxeEpJ5F5L7x_D8j1c-TVFXKo6L4SNPN5-19yJg&oe=69E38B1E"}, {"file_name": "4.png", "id": "975198817093493", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/57566693_975198820426826_7097624739394196541_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_NCGZNBwQ0QQ7kNvwFqOTmj&_nc_oc=AdoLaQB_XtoTWD2SwQXfuISzwyCL5ZcSJOkXHFRRrV0lxgHeBnJmqU8wd6pjJtE1HhU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1j6TFfQwGlQcIGIagvsN-ejvzLePjd7g_-B076NyDPlg&oe=69E38CCC"}, {"file_name": "1.png", "id": "415893571368646", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39001715_415893574701979_3461447245540982035_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KSkYyTJq5VkQ7kNvwGWNdDp&_nc_oc=AdrnZ31YdIobaGfsnGP-89paBIyLWMj50YfQ0GNB9HuFz6D8D-ocrSpdZxhJiWCJ9Ac&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0RsyTHTmYPwR7pKfISycVudYbC7Ppwl1q_ND2ja_WrUg&oe=69E36FD6"}, {"file_name": "3.png", "id": "662596896051796", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974523_662596899385129_8527079563659693432_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lHGNI1yujUEQ7kNvwFBDVZK&_nc_oc=AdrZvve1sBhFUNsnwt8dd1UWReOPDr5z6p_274TO8NcB9t9VLwvd8P4A5CRQ7okEgXo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af321eD0E1y6tEzF9l-m1D2-Xu6jFipXW9dOv9qwKF0qhQ&oe=69E36E54"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "gameplayVR3.png", "id": "492345567046352", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974804_492345570379685_6511341930176300148_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tOszL-e4yeoQ7kNvwEmVlnx&_nc_oc=AdqtHnzWKJcdstY4wEl3C584bTMh7Ey5GlOmFc35X2PKypRxbWkz5juoSV5UhPyRTIY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1gNPZvfTvCwSWPiqtsDI9aLq0BVChy0fU6FGKO2FCC0Q&oe=69E379AD"}, "display_name": "Escape Simulator", "keywords": ["escape", "room", "coop", "multiplayer", "simulator"], "long_description": "Escape Simulator is a first-person puzzler you can **play solo or in an online co-op** (best with 2-3 players, but playable with up to 8!). Explore a growing set of **highly interactive escape rooms**. Pick up and examine everything, break objects, solve locks, and decipher puzzles to escape! After finishing the main game, watch for free content updates and explore rooms **built by our awesome community**.\n\n# \u2b50**REVIEWS** \n\"What I've seen has left me considerably impressed.\" - UploadVR\n\n# \u2692\ufe0f**COMMUNITY-MADE ROOMS**\nAfter finishing the main game **explore numerous rooms** built by our amazing community.\n\n# \ud83e\udd1d**ONLINE CO-OP**\nAll rooms are playable in an online co-op. Play with up to 8 players (best played with 2-3). Customize your character and join friends to solve puzzles together. More heads are better than one!\n\n# \ud83e\udde9**INTERACTIVE PUZZLES**\nExplore 28+ official rooms filled with puzzles designed by real-life escape room operators. If it\u2019s not nailed down, you can pick it up.\n\n# \ud83d\udd0d**EXEMINE EVERYTHING**\nRead books, examine ancient artifacts, and find clues to riddles. Need to cross-reference a clue? No problem - just pin it!\n\n# \ud83c\udfc6**WANT MORE?**\nThe game features additional content in the form of Addons with 4 large rooms each: \n- **Steampunk**: Solve four new rooms on the beautiful steampunk airship \"Valor.\"\n- **Wild West**: Become an outlaw in the Wild West.\n- **Magic**: Embrace your magic potential, and follow in the footsteps of great witches and wizards. \n\n", "short_description": "First-person puzzler you can play solo or in an online co-op. Explore a set of highly interactive escape rooms. Move furniture, pick up and examine everything, smash pots and break 
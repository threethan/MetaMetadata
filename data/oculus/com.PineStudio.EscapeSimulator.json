5/65396729_1225052078868354_6945820870147360559_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TvfrRAsLrtYQ7kNvwFSj7Iu&_nc_oc=Ado39MGkJaFnUDeiss1IglEt3kljCSh5520Fx2xGxXhg0cZ10zZPsKOWjwtduNe225s&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCNMCY_IEWm7dy0KX9yPNZnM_1ocNIUOU9cuLPDy1hCRQ&oe=6A563D9E"}, {"file_name": "4.png", "id": "975198817093493", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/57566693_975198820426826_7097624739394196541_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wwg7CXUuByoQ7kNvwExIqRZ&_nc_oc=AdoEfJiJZBjKNPl3Pqz4dZAyfLwuIF2SuQGQHswdTKUGNwCu4-n5LZlbcZf4twpGc3c&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBXJnDhsNUqstlH3K-HuXXEQFckB0kP9MgvgCpnPYpbdA&oe=6A563F4C"}, {"file_name": "1.png", "id": "415893571368646", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/39001715_415893574701979_3461447245540982035_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sQYZmCPTJCwQ7kNvwFetUF2&_nc_oc=AdrgGeF8hCKRGgQ9Ssh3qSgoxqkXBxWIw43U8y37MHyBw1l-1Rbj0vxDtYcTgi3j9J8&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCyU6cvo7WqKWGxe5WwJNy3Q10vUsUWztweJL_g855NUQ&oe=6A565A96"}, {"file_name": "3.png", "id": "662596896051796", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38974523_662596899385129_8527079563659693432_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xhBqTxumjo8Q7kNvwFbadMs&_nc_oc=AdooBzMvC85Mq6sn5z4U7MfdjAByejPujBfBEql_p3fatMelsKE89qdkLw8az2j48t8&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAa_qi1hTNTyLQMPadrd_OobgMrmWvvCM_MuxS5bSWHgA&oe=6A565914"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "gameplayVR3.png", "id": "492345567046352", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/38974804_492345570379685_6511341930176300148_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZxA2NC25kEAQ7kNvwFG_YK8&_nc_oc=AdpPxitvpury7A-ZGKuxqsWu5Nf5SNeoYgWoIRG2pMsAYJVqBSNrSUGvOaX-KUYlG-M&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBimIzFIb-08L9A9tBdN-3_KCzgS-ImYMW0JmmyxtorZg&oe=6A562C2D"}, "display_name": "Escape Simulator", "keywords": ["escape", "room", "coop", "multiplayer", "simulator"], "long_description": "Escape Simulator is a first-person puzzler you can **play solo or in an online co-op** (best with 2-3 players, but playable with up to 8!). Explore a growing set of **highly interactive escape rooms**. Pick up and examine everything, break objects, solve locks, and decipher puzzles to escape! After finishing the main game, watch for free content updates and explore rooms **built by our awesome community**.\n\n# \u2b50**REVIEWS** \n\"What I've seen has left me considerably impressed.\" - UploadVR\n\n# \u2692\ufe0f**COMMUNITY-MADE ROOMS**\nAfter finishing the main game **explore numerous rooms** built by our amazing community.\n\n# \ud83e\udd1d**ONLINE CO-OP**\nAll rooms are playable in an online co-op. Play with up to 8 players (best played with 2-3). Customize your character and join friends to solve puzzles together. More heads are better than one!\n\n# \ud83e\udde9**INTERACTIVE PUZZLES**\nExplore 28+ official rooms filled with puzzles designed by real-life escape room operators. If it\u2019s not nailed down, you can pick it up.\n\n# \ud83d\udd0d**EXEMINE EVERYTHING**\nRead books, examine ancient artifacts, and find clues to riddles. Need to cross-reference a clue? No problem - just pin it!\n\n# \ud83c\udfc6**WANT MORE?**\nThe game features additional content in the form of Addons with 4 large rooms each: \n- **Steampunk**: Solve four new rooms on the beautiful steampunk airship \"Valor.\"\n- **Wild West**: Become an outlaw in the Wild West.\n- **Magic**: Embrace your magic potential, and follow in the footsteps of great witches and wizards. \n\n", "short_description": "First-person puzzler you can play solo or in an online co-op. Explore a set of highly interactive escape rooms. Move furniture, pick up and examine everything, smash pots and break 
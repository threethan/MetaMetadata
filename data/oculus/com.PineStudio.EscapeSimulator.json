5/65396729_1225052078868354_6945820870147360559_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=06Q47XR0pcMQ7kNvwEKJG6H&_nc_oc=AdrVro8CJampwfswxULkA6vV6jv3-cPSuoHyITIqWgc6rbUIgw-fc6pdhhCGS5ELzkM&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwXExHGZesUrWVXwiF7aGu9M5-XGv_EPxhW2mdszftWDw&oe=69C7DB9E"}, {"file_name": "4.png", "id": "975198817093493", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/57566693_975198820426826_7097624739394196541_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qXSVcQCZoYkQ7kNvwEOQfvv&_nc_oc=Adpz-surTtzJ6L_g6I5yIP-nuDOvh5NlXpLpTGPF3pQN8Da7hy488y2gKOUJJEA4kC0&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxJ7nWHlpclIs9hmmEMcnUoZdmvvR6TvUh02N7_K-oAcA&oe=69C7DD4C"}, {"file_name": "1.png", "id": "415893571368646", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/39001715_415893574701979_3461447245540982035_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uuIEcRv7j2wQ7kNvwHjDv7R&_nc_oc=Adr90EL4Rkvh742_uIUhSQJtq_4zPC926NKzWqBqtNJfITgO2e_lipdFjlYhGzmUi-4&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxXklyuMBddYozxkuktosBhDy_kfJQWHtANm5YuMsvj7A&oe=69C7C056"}, {"file_name": "3.png", "id": "662596896051796", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38974523_662596899385129_8527079563659693432_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=190VfX9MWZ8Q7kNvwEDdHvU&_nc_oc=AdoSvcjw-kxehoGatUrp520ocXwz68UOFmoMnJ7x3vNnpTLGZj429p5ObsZ6TQXuP7s&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afx0dy9jRenkFfCrz0a3jjElVJlwwNgDTJYgSA0a_-K2lg&oe=69C7BED4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "gameplayVR3.png", "id": "492345567046352", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/38974804_492345570379685_6511341930176300148_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lkRBm8pexMcQ7kNvwE03HUz&_nc_oc=AdrswPU4hz08risSSGMPIviZH7anJq1-lqPZ1R8Pa058QC8FlEsIc2dBd09o_lkEgbM&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwOOXCMR0YaPAnmUxDiwrb_1hp3IXbXOyyg36Evy385mw&oe=69C7CA2D"}, "display_name": "Escape Simulator", "keywords": ["escape", "room", "coop", "multiplayer", "simulator"], "long_description": "Escape Simulator is a first-person puzzler you can **play solo or in an online co-op** (best with 2-3 players, but playable with up to 8!). Explore a growing set of **highly interactive escape rooms**. Pick up and examine everything, break objects, solve locks, and decipher puzzles to escape! After finishing the main game, watch for free content updates and explore rooms **built by our awesome community**.\n\n# \u2b50**REVIEWS** \n\"What I've seen has left me considerably impressed.\" - UploadVR\n\n# \u2692\ufe0f**COMMUNITY-MADE ROOMS**\nAfter finishing the main game **explore numerous rooms** built by our amazing community.\n\n# \ud83e\udd1d**ONLINE CO-OP**\nAll rooms are playable in an online co-op. Play with up to 8 players (best played with 2-3). Customize your character and join friends to solve puzzles together. More heads are better than one!\n\n# \ud83e\udde9**INTERACTIVE PUZZLES**\nExplore 28+ official rooms filled with puzzles designed by real-life escape room operators. If it\u2019s not nailed down, you can pick it up.\n\n# \ud83d\udd0d**EXEMINE EVERYTHING**\nRead books, examine ancient artifacts, and find clues to riddles. Need to cross-reference a clue? No problem - just pin it!\n\n# \ud83c\udfc6**WANT MORE?**\nThe game features additional content in the form of Addons with 4 large rooms each: \n- **Steampunk**: Solve four new rooms on the beautiful steampunk airship \"Valor.\"\n- **Wild West**: Become an outlaw in the Wild West.\n- **Magic**: Embrace your magic potential, and follow in the footsteps of great witches and wizards. \n\n", "short_description": "First-person puzzler you can play solo or in an online co-op. Explore a set of highly interactive escape rooms. Move furniture, pick up and examine everything, smash pots and break locks! Supports community rooms through the level editor."}]}, "developer_name": null, "developer_privacy_policy_url": "https://pinestudio.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Pine Studio", "support_website_url": "https://pinestudio.com/contact/", "website_url": "https://pinestudio.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE", "PUZZLE", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "zh_HK", "zh_TW", "fr", "de", "it", "ja", "ko", "pt_BR", "pt", "es_MX", "es", "tr"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "MULTI_USER", "CO_OP"], "id": "8102822136440088"}}]}, "scheduled_offers": {"count": 8, "nodes": [{"status": "PUBLISHED", "id": "2676271276091412"}, {"status": "PUBLISHED", "id": "1454744778957663"}, {"status": "PUBLISHED", "id": "689222320738973"}, {"status": "PUBLISHED", "id": "1371021340897800"}, {"status": "PUBLISHED", "id": "2042423339502078"}, {"status": "PUBLISHED", "id": "3953763774896621"}, {"status": "PUBLISHED", "id": "964401912299743"}, {"status": "PUBLISHED", "id": "1582511855638097"}]}, "baseline_offer": {"id": "1582511855638097"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1776445200, "status": "PUBLISHED", "id": "2676271276091412"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "24614243444871363", "version": "36
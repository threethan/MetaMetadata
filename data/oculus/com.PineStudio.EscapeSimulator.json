25/65396729_1225052078868354_6945820870147360559_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wADogf5r6fcQ7kNvwHOlaN5&_nc_oc=AdrwKY_L3Sxjczm-5dx2wO18iRFW7xB72RrRc1N4cNEgdzvuPHdWTHxm4PojjA-d0Vk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAjH8AtvA2Gv7yytzt-Bmjw6HZ-wXu2lhPDFfb51RBlZg&oe=6A636C9E"}, {"file_name": "4.png", "id": "975198817093493", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/57566693_975198820426826_7097624739394196541_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JxywwRuHBmsQ7kNvwGKWnQ1&_nc_oc=Adr2s2OYerhT_lqfMfCm_MmoHtenzB9NjHd_pypu14dl-_a4jR4UsukSqqeclVX31MA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA9DLYO05dya5K8YmrACS8PPlpGmenKo28k0TSVOWKGvQ&oe=6A636E4C"}, {"file_name": "1.png", "id": "415893571368646", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39001715_415893574701979_3461447245540982035_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eDiXW2A1cwIQ7kNvwHxiWuf&_nc_oc=Ado0P7ERuDfmT540aceOQTMRViOvPI5vmIpb3ZFR4o-8-CKYHrM4eV83s2Wup3GeIkE&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC7Yraj9exahmsTKcXVvqx0wyJv_KSHcJOfLh7d1V5CIQ&oe=6A635156"}, {"file_name": "3.png", "id": "662596896051796", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974523_662596899385129_8527079563659693432_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_jvjmEMOu3MQ7kNvwEyrtH6&_nc_oc=AdoU0liO_p28RzsdwlBvesK7yXHcc27MFaeq48oER60WHXrjn1Oh0pjdppz09HDaelU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAfzAmQUZS-qSwyO52kXLli2ySEbllQYTq990k79eE7Kg&oe=6A638814"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "gameplayVR3.png", "id": "492345567046352", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974804_492345570379685_6511341930176300148_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u2Aed3Y8rMwQ7kNvwHMFsIp&_nc_oc=AdqFylShejYSc8seI5h58sYuc7R2FlaIwQq5OKjuIh51WA-VONytFEra0uoabuBX7jQ&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAH_E4vvmz-DZLkuTh79g8zC9a-kSWOaiVPPdPa5WjSaw&oe=6A635B2D"}, "display_name": "Escape Simulator", "keywords": ["escape", "room", "coop", "multiplayer", "simulator"], "long_description": "Escape Simulator is a first-person puzzler you can **play solo or in an online co-op** (best with 2-3 players, but playable with up to 8!). Explore a growing set of **highly interactive escape rooms**. Pick up and examine everything, break objects, solve locks, and decipher puzzles to escape! After finishing the main game, watch for free content updates and explore rooms **built by our awesome community**.\n\n# \u2b50**REVIEWS** \n\"What I've seen has left me considerably impressed.\" - UploadVR\n\n# \u2692\ufe0f**COMMUNITY-MADE ROOMS**\nAfter finishing the main game **explore numerous rooms** built by our amazing community.\n\n# \ud83e\udd1d**ONLINE CO-OP**\nAll rooms are playable in an online co-op. Play with up to 8 players (best played with 2-3). Customize your character and join friends to solve puzzles together. More heads are better than one!\n\n# \ud83e\udde9**INTERACTIVE PUZZLES**\nExplore 28+ official rooms filled with puzzles designed by real-life escape room operators. If it\u2019s not nailed down, you can pick it up.\n\n# \ud83d\udd0d**EXEMINE EVERYTHING**\nRead books, examine ancient artifacts, and find clues to riddles. Need to cross-reference a clue? No problem - just pin it!\n\n# \ud83c\udfc6**WANT MORE?**\nThe game features additional content in the form of Addons with 4 large rooms each: \n- **Steampunk**: Solve four new rooms on the beautiful steampunk airship \"Valor.\"\n- **Wild West**: Become an outlaw in the Wild West.\n- **Magic**: Embrace your magic potential, and follow in the footsteps of great witches and wizards. \n\n", "short_description": "First-person puzzler you can play solo or in an online co-op. Explore a set of highly interactive escape rooms. Move furniture, pick up and examine everything, smash pots and break
5/65396729_1225052078868354_6945820870147360559_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-1JdyRrzvFEQ7kNvwG5Sw_w&_nc_oc=AdoZ3TQ9g9izTYFNPPZZaaG3k8ZYu016Bb80aSIkrBa6QPsG5_ZxwVD2qEVd8JLPjQE&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6RdiKCEIM_uz2J_RmvrrWVHF9oLvUycf7CrKoHgQtlCw&oe=6A15A41E"}, {"file_name": "4.png", "id": "975198817093493", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/57566693_975198820426826_7097624739394196541_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yhYMKAqhItwQ7kNvwEM_R9p&_nc_oc=AdrquQr35uAqBPCaKddE8tZqI86DW3Dijrmcdo4EKKnA5uy2gz_kYe9GakX5G0YFXUA&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4_4q0D6c_89qffQQld0pWHAt17BYbSUXcYt2pftCSmmQ&oe=6A15A5CC"}, {"file_name": "1.png", "id": "415893571368646", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39001715_415893574701979_3461447245540982035_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2If3RRRu8X8Q7kNvwE8n3Db&_nc_oc=AdpCmkhhwh3DxGLXn4klYiEXXf3F1wxcHKN1c5U1KKnWK_cK9b0I5UU5yp7U5QFxmLQ&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5HggG69qOQqnneHqHYCvC40rF8MmzDTujlXqMKfxEfkA&oe=6A15C116"}, {"file_name": "3.png", "id": "662596896051796", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38974523_662596899385129_8527079563659693432_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4my6Z0loxIMQ7kNvwEPNC9k&_nc_oc=Adp_THA0TO_oZl0kFgf8q9WhqTsCOLI6Bw3BSsHofvbrJMgxwjLGbe0s9cXuENBxUeg&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5axlwYS7_-6FUacFp_dRfduh2ZYjHZrASE7ffSEzgusQ&oe=6A15BF94"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "gameplayVR3.png", "id": "492345567046352", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38974804_492345570379685_6511341930176300148_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2yX_oF45gJsQ7kNvwHD8fDm&_nc_oc=AdqZRXBXIjtNp3tREwTWWAjmgCXXMga8298nY_HeMlfp6XNEMk7NrqnzNVtdflmQv1A&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af49cjcwsvoeNEsDt8qlNi_sJEmsJfJamzwxbw4N1CD9tg&oe=6A1592AD"}, "display_name": "Escape Simulator", "keywords": ["escape", "room", "coop", "multiplayer", "simulator"], "long_description": "Escape Simulator is a first-person puzzler you can **play solo or in an online co-op** (best with 2-3 players, but playable with up to 8!). Explore a growing set of **highly interactive escape rooms**. Pick up and examine everything, break objects, solve locks, and decipher puzzles to escape! After finishing the main game, watch for free content updates and explore rooms **built by our awesome community**.\n\n# \u2b50**REVIEWS** \n\"What I've seen has left me considerably impressed.\" - UploadVR\n\n# \u2692\ufe0f**COMMUNITY-MADE ROOMS**\nAfter finishing the main game **explore numerous rooms** built by our amazing community.\n\n# \ud83e\udd1d**ONLINE CO-OP**\nAll rooms are playable in an online co-op. Play with up to 8 players (best played with 2-3). Customize your character and join friends to solve puzzles together. More heads are better than one!\n\n# \ud83e\udde9**INTERACTIVE PUZZLES**\nExplore 28+ official rooms filled with puzzles designed by real-life escape room operators. If it\u2019s not nailed down, you can pick it up.\n\n# \ud83d\udd0d**EXEMINE EVERYTHING**\nRead books, examine ancient artifacts, and find clues to riddles. Need to cross-reference a clue? No problem - just pin it!\n\n# \ud83c\udfc6**WANT MORE?**\nThe game features additional content in the form of Addons with 4 large rooms each: \n- **Steampunk**: Solve four new rooms on the beautiful steampunk airship \"Valor.\"\n- **Wild West**: Become an outlaw in the Wild West.\n- **Magic**: Embrace your magic potential, and follow in the footsteps of great witches and wizards. \n\n", "short_description": "First-person puzzler you can play solo or in an online co-op. Explore a set of highly interactive escape rooms. Move furniture, pick up and examine everything, smash pots and break 
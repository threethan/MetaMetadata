25/65396729_1225052078868354_6945820870147360559_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I30-S7gOstQQ7kNvwEcJ94O&_nc_oc=Adr1nDbzf0md2kz0nMVOV_pQBUgtlfJ5YGTpI3VuhdzQTh32HubsMVsIreaCBSQ-eRs&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCw2HBNJ2UYXTWJbfysLKH9BznG0COpgzZmw2mkjlPVwA&oe=6A621B1E"}, {"file_name": "4.png", "id": "975198817093493", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/57566693_975198820426826_7097624739394196541_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cj70ZZz7RYsQ7kNvwFTtBKP&_nc_oc=Adov6P6RSDJNoOqBrF-_rmDM0EP7dmoFhfJttfrlyUHQ4Srt-iMqz3aMD9ggzTTe-x4&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC7RfuXlrxLq9rgihLKb6GYVmGBzMNXXOwdDvnt_YxEmA&oe=6A621CCC"}, {"file_name": "1.png", "id": "415893571368646", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39001715_415893574701979_3461447245540982035_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eDiXW2A1cwIQ7kNvwFqlBQ3&_nc_oc=Ado_tITSVXSNuZH3Qzm4pxVRkKAA6Go4HwcIxryAy8CzZAPK5mVmBGC_PYQycOq3qhw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCV5-ISIMCHKz8uYRvqVIbQjqy0iuL7tI9s9ziIrFFUyw&oe=6A61FFD6"}, {"file_name": "3.png", "id": "662596896051796", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974523_662596899385129_8527079563659693432_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_jvjmEMOu3MQ7kNvwFCieVA&_nc_oc=AdrnvcG13bgaYzs0NkU0QjhcOnQQtQpYoFwzEUnBd9MFxLzCkp9-EUYlnlLqytlvmCo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDFnDEt--rQSlkvvhaIx4T3VnGW1ofswn7GsPuabFrAEg&oe=6A61FE54"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "gameplayVR3.png", "id": "492345567046352", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974804_492345570379685_6511341930176300148_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BzarmP297-IQ7kNvwGSL8d7&_nc_oc=Adpj8chT4aKuSrePlCH8BFGfFv_P3MRXqRfVS5X_9gZJfOjphLYUiDQLUVlMmoA3R2s&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAIHMDnDdK9UaZgrbSgDHqxzYeSW4cbwc074KOMNLIZ-g&oe=6A6209AD"}, "display_name": "Escape Simulator", "keywords": ["escape", "room", "coop", "multiplayer", "simulator"], "long_description": "Escape Simulator is a first-person puzzler you can **play solo or in an online co-op** (best with 2-3 players, but playable with up to 8!). Explore a growing set of **highly interactive escape rooms**. Pick up and examine everything, break objects, solve locks, and decipher puzzles to escape! After finishing the main game, watch for free content updates and explore rooms **built by our awesome community**.\n\n# \u2b50**REVIEWS** \n\"What I've seen has left me considerably impressed.\" - UploadVR\n\n# \u2692\ufe0f**COMMUNITY-MADE ROOMS**\nAfter finishing the main game **explore numerous rooms** built by our amazing community.\n\n# \ud83e\udd1d**ONLINE CO-OP**\nAll rooms are playable in an online co-op. Play with up to 8 players (best played with 2-3). Customize your character and join friends to solve puzzles together. More heads are better than one!\n\n# \ud83e\udde9**INTERACTIVE PUZZLES**\nExplore 28+ official rooms filled with puzzles designed by real-life escape room operators. If it\u2019s not nailed down, you can pick it up.\n\n# \ud83d\udd0d**EXEMINE EVERYTHING**\nRead books, examine ancient artifacts, and find clues to riddles. Need to cross-reference a clue? No problem - just pin it!\n\n# \ud83c\udfc6**WANT MORE?**\nThe game features additional content in the form of Addons with 4 large rooms each: \n- **Steampunk**: Solve four new rooms on the beautiful steampunk airship \"Valor.\"\n- **Wild West**: Become an outlaw in the Wild West.\n- **Magic**: Embrace your magic potential, and follow in the footsteps of great witches and wizards. \n\n", "short_description": "First-person puzzler you can play solo or in an online co-op. Explore a set of highly interactive escape rooms. Move furniture, pick up and examine everything, smash pots and break
25/65396729_1225052078868354_6945820870147360559_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BL_-zj1YtbkQ7kNvwEgoZKG&_nc_oc=Adox73f8QGihChVFcPIm4jq_Kgt4-ZbpO8pF71SMv2OjZloVpiaFHcugD4_1NDGmRgc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQCZRBCz_Fm-j-1TFb8h8jLU3dMaCK8fGkaba4NzRbG9g&oe=6AEF63DE"}, {"file_name": "4.png", "id": "975198817093493", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/57566693_975198820426826_7097624739394196541_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fB_11mwbYh4Q7kNvwG_ZzvS&_nc_oc=AdoqY-2wosxr7uGSkLTLpE7RpnneioZYC8HItIhS2kD-KGo4iqlp87ttTKIbojfCYeA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRnxgHp2RPM_0RZTp2hwo8r0hIa6ddiyp94EcLLls5hlw&oe=6AEF658C"}, {"file_name": "1.png", "id": "415893571368646", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39001715_415893574701979_3461447245540982035_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mVHFUjHqdzUQ7kNvwHO8Qj9&_nc_oc=AdrwW2i8khjUXrmOaLD2NfvDSOjaCCTEqTn6iuy_0D6tJlGRrdBabTNLSBNoq2gBM5U&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQK_Ntqfn2hmMNr-2wGt5T0FPKBRVTZ5fSLiOx7I6KUAQ&oe=6AEF4896"}, {"file_name": "3.png", "id": "662596896051796", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974523_662596899385129_8527079563659693432_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Uknbhc78v4EQ7kNvwH1SExg&_nc_oc=Adr7mq-v6TgNkkDHUvdAdz1YsdoHK5D6RwYm34CRuNQ-533eGR0CdHSR3wguiyH5aqk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQaW9zf2Ev-oIwQ5fRgV8fPVe-KejLAtaAAmCXqPbS8ow&oe=6AEF4714"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "gameplayVR3.png", "id": "492345567046352", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974804_492345570379685_6511341930176300148_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9Dm0Zc3nlz0Q7kNvwGNeqVK&_nc_oc=Adqk3dvW_5gHcXiuoiOj9tDCTcg1Hnk6xmPamZmRQoOdB2IHLoafTYEoXHo8opGMtY4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ9aYFNrItvvDVxHDvEH6DIlPvO7MX82g-BkZ_Qbgm7zw&oe=6AEF526D"}, "display_name": "Escape Simulator", "keywords": ["escape", "room", "coop", "multiplayer", "simulator"], "long_description": "Escape Simulator is a first-person puzzler you can **play solo or in an online co-op** (best with 2-3 players, but playable with up to 8!). Explore a growing set of **highly interactive escape rooms**. Pick up and examine everything, break objects, solve locks, and decipher puzzles to escape! After finishing the main game, watch for free content updates and explore rooms **built by our awesome community**.\n\n# \u2b50**REVIEWS** \n\"What I've seen has left me considerably impressed.\" - UploadVR\n\n# \u2692\ufe0f**COMMUNITY-MADE ROOMS**\nAfter finishing the main game **explore numerous rooms** built by our amazing community.\n\n# \ud83e\udd1d**ONLINE CO-OP**\nAll rooms are playable in an online co-op. Play with up to 8 players (best played with 2-3). Customize your character and join friends to solve puzzles together. More heads are better than one!\n\n# \ud83e\udde9**INTERACTIVE PUZZLES**\nExplore 28+ official rooms filled with puzzles designed by real-life escape room operators. If it\u2019s not nailed down, you can pick it up.\n\n# \ud83d\udd0d**EXEMINE EVERYTHING**\nRead books, examine ancient artifacts, and find clues to riddles. Need to cross-reference a clue? No problem - just pin it!\n\n# \ud83c\udfc6**WANT MORE?**\nThe game features additional content in the form of Addons with 4 large rooms each: \n- **Steampunk**: Solve four new rooms on the beautiful steampunk airship \"Valor.\"\n- **Wild West**: Become an outlaw in the Wild West.\n- **Magic**: Embrace your magic potential, and follow in the footsteps of great witches and wizards. \n\n", "short_description": "First-person puzzler you can play solo or in an online co-op. Explore a set of highly interactive escape rooms. Move furniture, pick up and examine everything, smash pots and break
5/65396729_1225052078868354_6945820870147360559_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NgXEmyeW46gQ7kNvwGjFy74&_nc_oc=Adqw9xjly40lHjrtF2yK_5Kf5gDZG76jYyCCuJrtrk06flLnz7YWoQaahra0SKLQAMU&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_zzuikBnpF-aDJ8q5orCJsReOOLre9sGhFHNDnQ6FSJQ&oe=6A24249E"}, {"file_name": "4.png", "id": "975198817093493", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/57566693_975198820426826_7097624739394196541_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DfGq9pv33nkQ7kNvwG1xJwl&_nc_oc=AdpQB-yBZNVVR9siCLXgknBSIa8J8OTWiaDfAC1ZH3YjtdY_SbSwzHGok-3_zBMJPTg&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_4WqnWii8pGLA6DIObnHFUdJ1tjP1jBGdZr32l3F9IdQ&oe=6A24264C"}, {"file_name": "1.png", "id": "415893571368646", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39001715_415893574701979_3461447245540982035_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nm0v8qp4c0kQ7kNvwFaM8xq&_nc_oc=AdrJt4lC21Odlu4JxAA0jXP9LWmOBl2LSOGnsAdJEd4cKo-jIP9eFu8cNYoeogZm4_U&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af98MRq283ND2qVloKpEbqwH5Vu8Gh48UPqQ5Jfas951ZA&oe=6A244196"}, {"file_name": "3.png", "id": "662596896051796", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974523_662596899385129_8527079563659693432_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MfRbfBdc1o4Q7kNvwEPsElF&_nc_oc=AdoOm3mUbcX58Sbacogaa6r_YhJBXM0ZvU0Qj-wLfVVSREdAW0jvYm6WPcm5VZhs14o&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9bwe4WpynymPogFbTqMuWDKaIzYbhUX3s7vi6s4rq7mQ&oe=6A244014"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "gameplayVR3.png", "id": "492345567046352", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974804_492345570379685_6511341930176300148_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PFgvkXBMFFEQ7kNvwEBLvwg&_nc_oc=Adr45_-WfXmGqtZcLN5N_Yi4smDPagSWqEWQFnsO-axhB3bgVheuDimrGr3hBgIpHYY&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9kx_FxENqeG4iW5uN8rPcRYpOmkQDeEN1uGSk9v_Txrw&oe=6A24132D"}, "display_name": "Escape Simulator", "keywords": ["escape", "room", "coop", "multiplayer", "simulator"], "long_description": "Escape Simulator is a first-person puzzler you can **play solo or in an online co-op** (best with 2-3 players, but playable with up to 8!). Explore a growing set of **highly interactive escape rooms**. Pick up and examine everything, break objects, solve locks, and decipher puzzles to escape! After finishing the main game, watch for free content updates and explore rooms **built by our awesome community**.\n\n# \u2b50**REVIEWS** \n\"What I've seen has left me considerably impressed.\" - UploadVR\n\n# \u2692\ufe0f**COMMUNITY-MADE ROOMS**\nAfter finishing the main game **explore numerous rooms** built by our amazing community.\n\n# \ud83e\udd1d**ONLINE CO-OP**\nAll rooms are playable in an online co-op. Play with up to 8 players (best played with 2-3). Customize your character and join friends to solve puzzles together. More heads are better than one!\n\n# \ud83e\udde9**INTERACTIVE PUZZLES**\nExplore 28+ official rooms filled with puzzles designed by real-life escape room operators. If it\u2019s not nailed down, you can pick it up.\n\n# \ud83d\udd0d**EXEMINE EVERYTHING**\nRead books, examine ancient artifacts, and find clues to riddles. Need to cross-reference a clue? No problem - just pin it!\n\n# \ud83c\udfc6**WANT MORE?**\nThe game features additional content in the form of Addons with 4 large rooms each: \n- **Steampunk**: Solve four new rooms on the beautiful steampunk airship \"Valor.\"\n- **Wild West**: Become an outlaw in the Wild West.\n- **Magic**: Embrace your magic potential, and follow in the footsteps of great witches and wizards. \n\n", "short_description": "First-person puzzler you can play solo or in an online co-op. Explore a set of highly interactive escape rooms. Move furniture, pick up and examine everything, smash pots and break 
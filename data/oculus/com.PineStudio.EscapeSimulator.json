5/65396729_1225052078868354_6945820870147360559_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ew-WircmkkwQ7kNvwEIzp8I&_nc_oc=AdqkwWNyXTyWx-AtZEIJhr_rLkU6z36-WeFqWRAgYM_NUuSsHUN82XEcVHFAnqg62Ek&_nc_zt=3&_nc_ht=scontent-lhr8-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6h5ELjUWKSLxsW9fab8-9mJBbx_4d8by_klvlwespaPQ&oe=6A105E1E"}, {"file_name": "4.png", "id": "975198817093493", "uri": "https://scontent-lhr8-2.oculuscdn.com/v/t64.5771-25/57566693_975198820426826_7097624739394196541_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rcS1ZOcEThgQ7kNvwGnNNbF&_nc_oc=AdqsKQkK3WzjhPvVZbeAzcVFS9v0VgfvH6C3LA7GfxlcA9ukwgjtnuQj12qnQ6ww4WM&_nc_zt=3&_nc_ht=scontent-lhr8-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7awUkKlkQNe0XtjlSEgCwTRW-ZNMEUd1tPymVxZ5xD-w&oe=6A105FCC"}, {"file_name": "1.png", "id": "415893571368646", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/39001715_415893574701979_3461447245540982035_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c3yx8jYYh7YQ7kNvwGPiJvv&_nc_oc=AdqtOLgYhcwWoGJZHWIpOa38muyTksLbHbIRvWyeigjQdOonPGGMwbykNc_cpvdKepg&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af58w2EW30h9P0iHA1ZBst3cTuArrNZIszomOHFo3VMdsw&oe=6A107B16"}, {"file_name": "3.png", "id": "662596896051796", "uri": "https://scontent-lhr8-2.oculuscdn.com/v/t64.5771-25/38974523_662596899385129_8527079563659693432_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nLUvfxj73W4Q7kNvwHFgs2K&_nc_oc=AdrTsAvZCuqqfKx9ZpBZbvYpFk2HX5DKEMQO_g3fVyz-y5wS1eJMi1ww7ljoqLXbWpE&_nc_zt=3&_nc_ht=scontent-lhr8-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6Q7cwdjWx9rZv-llzNEOrLvZBgnDZFfNQzPF-7lAYtTQ&oe=6A107994"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "gameplayVR3.png", "id": "492345567046352", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/38974804_492345570379685_6511341930176300148_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e1A4AT1p3W0Q7kNvwFI7UEx&_nc_oc=AdoUYs5715rihzC2uHmeTBNqWQcNp3n4IyqqTcc3SFCAQzra59pOIwXLIsjW1d_8wsY&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af50tj0frVsHJbAY3bAcyYvweA0qzbn6CcMOLDzeSRTWeA&oe=6A104CAD"}, "display_name": "Escape Simulator", "keywords": ["escape", "room", "coop", "multiplayer", "simulator"], "long_description": "Escape Simulator is a first-person puzzler you can **play solo or in an online co-op** (best with 2-3 players, but playable with up to 8!). Explore a growing set of **highly interactive escape rooms**. Pick up and examine everything, break objects, solve locks, and decipher puzzles to escape! After finishing the main game, watch for free content updates and explore rooms **built by our awesome community**.\n\n# \u2b50**REVIEWS** \n\"What I've seen has left me considerably impressed.\" - UploadVR\n\n# \u2692\ufe0f**COMMUNITY-MADE ROOMS**\nAfter finishing the main game **explore numerous rooms** built by our amazing community.\n\n# \ud83e\udd1d**ONLINE CO-OP**\nAll rooms are playable in an online co-op. Play with up to 8 players (best played with 2-3). Customize your character and join friends to solve puzzles together. More heads are better than one!\n\n# \ud83e\udde9**INTERACTIVE PUZZLES**\nExplore 28+ official rooms filled with puzzles designed by real-life escape room operators. If it\u2019s not nailed down, you can pick it up.\n\n# \ud83d\udd0d**EXEMINE EVERYTHING**\nRead books, examine ancient artifacts, and find clues to riddles. Need to cross-reference a clue? No problem - just pin it!\n\n# \ud83c\udfc6**WANT MORE?**\nThe game features additional content in the form of Addons with 4 large rooms each: \n- **Steampunk**: Solve four new rooms on the beautiful steampunk airship \"Valor.\"\n- **Wild West**: Become an outlaw in the Wild West.\n- **Magic**: Embrace your magic potential, and follow in the footsteps of great witches and wizards. \n\n", "short_description": "First-person puzzler you can play solo or in an online co-op. Explore a set of highly interactive escape rooms. Move furniture, pick up and examine everything, smash pots and break 
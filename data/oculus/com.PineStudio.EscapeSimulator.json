1-7&_nc_sid=6e7a0a&_nc_ohc=93dBHJTEFJcQ7kNvwHJVfZk&_nc_oc=AdqX9ofIeltwuIl5hLXbAtiTltvTpCYGwvUu3QjVZ4ADxXdpFJU-jnR1pltzwBZ26Ws&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGFr7JyJucchQlFzlTtDIWO1DKYjQv6J32L5lbJDSIwDQ&oe=6A903F9E"}, {"file_name": "2.png", "id": "457815206622098", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75210399_457815209955431_6948775186918221287_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8qoo1oidn6kQ7kNvwFaTY-f&_nc_oc=Adrhw2SXmfFcCQihS-xI_O8bZAxKB9bZPtcxwC5J9tT5SNOcUgFI0MsVUQ_m2k0MhYo&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGOoog9sLPD0UqLcflpbjO3I4WiIpjzwqmyh4y1bpIebg&oe=6A9034EA"}, {"file_name": "3.png", "id": "662596896051796", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38974523_662596899385129_8527079563659693432_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZONUBhnxB4AQ7kNvwEksNQk&_nc_oc=AdryLsgaUfrzGLUssg5BP8jFfndZmvRmLvLUJks0s0Kw_btLUhAgZe9SnDygII3s8tc&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFYGLzZzHYL3lxP9DQzxEti4XYUJFY8FWJGJ7L2CMTC5w&oe=6A9022D4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "gameplayVR3.png", "id": "492345567046352", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38974804_492345570379685_6511341930176300148_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6gGQNY0XSwAQ7kNvwHtODNh&_nc_oc=AdqvPil8wm5WThAMYKIPa8h706A77JDezM_QFkD0WBYSwJnFEbtFL7l88rnXMu3U378&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHmI-PlBMRc9lNZGpJ0Aj9E2xk4XvJnnWxa-9YfMuNh2g&oe=6A902E2D"}, "display_name": "Escape Simulator", "keywords": ["escape", "room", "coop", "simulator", "puzzle"], "long_description": "Escape Simulator is a first-person puzzler you can **play solo or in an cross platform online co-op** (best with 2-3 players, but playable with up to 8!). Explore a growing set of **highly interactive escape rooms**. Pick up and examine everything, break objects, solve locks, and decipher puzzles to escape! After finishing the main game, watch for free content updates and explore rooms **built by our awesome community**.\n\n# \u2b50**REVIEWS** \n\"What I've seen has left me considerably impressed.\" - UploadVR\n\n# \u2692\ufe0f**COMMUNITY-MADE ROOMS**\nAfter finishing the main game **explore numerous rooms** built by our amazing Steam community. New rooms every Friday!\n\n# \ud83e\udd1d**CROSS-PLATFORM CO-OP**\nAll rooms are playable in a cross platform online co-op. Play with up to 8 players (best played with 2-3) on PC, Quest 2 and 3. Customize your character and join friends to solve puzzles together. More heads are better than one! \n\n# \ud83e\udde9**INTERACTIVE PUZZLES**\nExplore 21+ official rooms filled with puzzles designed by real-life escape room operators. If it\u2019s not nailed down, you can pick it up.\n\n# \ud83d\udd0d**EXEMINE EVERYTHING**\nRead books, examine ancient artifacts, and find clues to riddles. Need to cross-reference a clue? No problem - just pin it!\n\n# \ud83c\udfc6**MORE COMING VERY SOON!** \nThe game is getting even more content in a form of free rooms & addons: \n- **Steampunk**: Solve four new rooms on the beautiful steampunk airship \"Valor.\"\n- **Wild West**: Become an outlaw in the Wild West.\n- **Magic**: Embrace your magic potential, and follow in the footsteps of great witches and wizards. \n\n", "short_description": "First-person puzzler you can play solo or in an online co-op. Explore a set of highly interactive escape rooms. Move furniture, pick up and examine everything, smash pots and break locks! Supports community rooms through the level editor."}]}, "developer_name": null, "developer_privacy_policy_url": "https://pinestudio.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Pine Studio", "support_website_url": "https://pinestudio.com/contact/", "website_url": "https://pinestudio.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": 
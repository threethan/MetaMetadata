25/65396729_1225052078868354_6945820870147360559_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ewRx2PsJzBUQ7kNvwF-084r&_nc_oc=AdqjD8iAc-r_TmHts5ks_fYZlEnTU09DnKgFs33UPodDNAMz6HCemhtq-wvncSNA1oc&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEJRjuAYLyRWRoQzWJhTohucNflUbDmwzB_aaBreDIqoA&oe=6A93FBDE"}, {"file_name": "4.png", "id": "975198817093493", "uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/57566693_975198820426826_7097624739394196541_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sCr9krboahEQ7kNvwHoSo89&_nc_oc=Adobeh8cmXb-qVV4EAS4zuBTli85mwlx7NuFgNOFiMg7RCfFDHd8PTsVqAirhRSy_ec&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF5yAuxqvFDKKAIf4gsto_UuBBn1nfX9VgChoQ37RWa-g&oe=6A93FD8C"}, {"file_name": "1.png", "id": "415893571368646", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/39001715_415893574701979_3461447245540982035_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FGK4l-eZvHoQ7kNvwEzFEG-&_nc_oc=Adr8TfJJYmyledLkCBZPCKx9_SYB2oCgBoy0q6GjkapUlbC4pgAgmK5AdRoh2g3B0TE&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGWx-N0CfoSCweJibx9cfDMEmLRDZCuW62H4daU5z71gw&oe=6A9418D6"}, {"file_name": "3.png", "id": "662596896051796", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/38974523_662596899385129_8527079563659693432_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VgVBB21zeeoQ7kNvwGpGC6N&_nc_oc=Adq0bmhnnAtQYPgMY3SRbJVxQOd9RxUCeE07fokXBgXzKRkn8542JZJEDOoPQQdqrUM&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFqKySR6wmb8WZSuo2dzwA1x6dm4CI-p9jmhrXK9F_yOw&oe=6A941754"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "gameplayVR3.png", "id": "492345567046352", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/38974804_492345570379685_6511341930176300148_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=99_a26GrMYMQ7kNvwG6qY54&_nc_oc=AdpnN8NgTsObXUX9VUh8J6jnx9opBCYLBcIyMSmKSy6etjzpH1StFl-Ov7sKLI4NOFQ&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG6lvw4Rayd1ZfHzd7Deho0YEgbijvnHZkf7H7F5C4wqw&oe=6A9422AD"}, "display_name": "Escape Simulator", "keywords": ["escape", "room", "coop", "multiplayer", "simulator"], "long_description": "Escape Simulator is a first-person puzzler you can **play solo or in an online co-op** (best with 2-3 players, but playable with up to 8!). Explore a growing set of **highly interactive escape rooms**. Pick up and examine everything, break objects, solve locks, and decipher puzzles to escape! After finishing the main game, watch for free content updates and explore rooms **built by our awesome community**.\n\n# \u2b50**REVIEWS** \n\"What I've seen has left me considerably impressed.\" - UploadVR\n\n# \u2692\ufe0f**COMMUNITY-MADE ROOMS**\nAfter finishing the main game **explore numerous rooms** built by our amazing community.\n\n# \ud83e\udd1d**ONLINE CO-OP**\nAll rooms are playable in an online co-op. Play with up to 8 players (best played with 2-3). Customize your character and join friends to solve puzzles together. More heads are better than one!\n\n# \ud83e\udde9**INTERACTIVE PUZZLES**\nExplore 28+ official rooms filled with puzzles designed by real-life escape room operators. If it\u2019s not nailed down, you can pick it up.\n\n# \ud83d\udd0d**EXEMINE EVERYTHING**\nRead books, examine ancient artifacts, and find clues to riddles. Need to cross-reference a clue? No problem - just pin it!\n\n# \ud83c\udfc6**WANT MORE?**\nThe game features additional content in the form of Addons with 4 large rooms each: \n- **Steampunk**: Solve four new rooms on the beautiful steampunk airship \"Valor.\"\n- **Wild West**: Become an outlaw in the Wild West.\n- **Magic**: Embrace your magic potential, and follow in the footsteps of great witches and wizards. \n\n", "short_description": "First-person puzzler you can play solo or in an online co-op. Explore a set of highly interactive escape rooms. Move furniture, pick up and examine everything, smash pots and break
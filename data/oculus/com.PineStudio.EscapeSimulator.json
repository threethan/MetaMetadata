25/65396729_1225052078868354_6945820870147360559_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dAl-yfTX8U8Q7kNvwGY_eej&_nc_oc=Adrg2OBNYSbJ3XqiLisAcVPJlBhS2u7l7zVAN90Uilv22yUhjZB6DWL6ZFnailSDAGg&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN4aXi9RQcMxdD_ki-YwxZ2i--oEuy8y1IkSO265BIUvQ&oe=6ACCE49E"}, {"file_name": "4.png", "id": "975198817093493", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/57566693_975198820426826_7097624739394196541_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-ciU0suavBUQ7kNvwEXMhgI&_nc_oc=AdrTlJBT_mcY9cG_3ulTn8KETNerQpv2rBy1_PrrY3jSfqrEI1az49pILdsLYrwTyYE&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNwZkKeJigBpKn7GZIk8l7579_ctI8gnw0PTo1_RfinTA&oe=6ACCE64C"}, {"file_name": "1.png", "id": "415893571368646", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39001715_415893574701979_3461447245540982035_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1KLHE0ZYzHwQ7kNvwFEjIWE&_nc_oc=AdqFrh6uJcauPi_ygGxEjFRDOBl76DZh16t4ffaIEs3h4F0g8GzGoVq68eTHpcQDCEM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOHhLfSUIFD_tn4dcy4oKPV7QqzOACQpkiT50be1X-4Ow&oe=6ACD0196"}, {"file_name": "3.png", "id": "662596896051796", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974523_662596899385129_8527079563659693432_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VCabrQuX3BwQ7kNvwFgjryc&_nc_oc=AdpTsxyb6GCmXfCBMLC-f2uN2rjoPHU280PWZtj-y-Sfm0G2D-yXE1KE48nRVSyGZLI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOxf1em3CVseiMrw8xSVouRU9iDWC_u355tYbdwv67hsw&oe=6ACD0014"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "gameplayVR3.png", "id": "492345567046352", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974804_492345570379685_6511341930176300148_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QlZqTqqXp6UQ7kNvwHosa7r&_nc_oc=AdpVrD7qCXKuqH1hyxSR4XlfztaZMNsq0i11UL-Fn4lE0lUSlADcnkMIDhQCPPOV7Y0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP0T4x4jk_K9Bd51AFmHNB9_sQTANO48ckxxo-8z2HiOQ&oe=6ACD0B6D"}, "display_name": "Escape Simulator", "keywords": ["escape", "room", "coop", "multiplayer", "simulator"], "long_description": "Escape Simulator is a first-person puzzler you can **play solo or in an online co-op** (best with 2-3 players, but playable with up to 8!). Explore a growing set of **highly interactive escape rooms**. Pick up and examine everything, break objects, solve locks, and decipher puzzles to escape! After finishing the main game, watch for free content updates and explore rooms **built by our awesome community**.\n\n# \u2b50**REVIEWS** \n\"What I've seen has left me considerably impressed.\" - UploadVR\n\n# \u2692\ufe0f**COMMUNITY-MADE ROOMS**\nAfter finishing the main game **explore numerous rooms** built by our amazing community.\n\n# \ud83e\udd1d**ONLINE CO-OP**\nAll rooms are playable in an online co-op. Play with up to 8 players (best played with 2-3). Customize your character and join friends to solve puzzles together. More heads are better than one!\n\n# \ud83e\udde9**INTERACTIVE PUZZLES**\nExplore 28+ official rooms filled with puzzles designed by real-life escape room operators. If it\u2019s not nailed down, you can pick it up.\n\n# \ud83d\udd0d**EXEMINE EVERYTHING**\nRead books, examine ancient artifacts, and find clues to riddles. Need to cross-reference a clue? No problem - just pin it!\n\n# \ud83c\udfc6**WANT MORE?**\nThe game features additional content in the form of Addons with 4 large rooms each: \n- **Steampunk**: Solve four new rooms on the beautiful steampunk airship \"Valor.\"\n- **Wild West**: Become an outlaw in the Wild West.\n- **Magic**: Embrace your magic potential, and follow in the footsteps of great witches and wizards. \n\n", "short_description": "First-person puzzler you can play solo or in an online co-op. Explore a set of highly interactive escape rooms. Move furniture, pick up and examine everything, smash pots and break
n.com/v/t64.5771-25/65396729_1225052078868354_6945820870147360559_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yulwHBbuKT8Q7kNvwEXu_rO&_nc_oc=AdrBaV0b8vaNC_hYXMXT5idem7wgfshso34az4oDkfjcG_o9-1DhVX7Z0i8rqkfkv6A&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-eKiZLlx8y7AOXwUL3My-69M14_IfXp6YMQidOGWsQtw&oe=6A393C9E"}, {"file_name": "4.png", "id": "975198817093493", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/57566693_975198820426826_7097624739394196541_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K7ucvfeBW-EQ7kNvwFuyg-q&_nc_oc=AdpK_s8r7zpoKVeUc_T7pk26IQTl5HHtRxB1iHI7pnXpd9dT6Msa4APqLc-T2-rMiYs&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af93reY-y0kuR9YydzqcSEfnfVgu4kXOAGsFXmP4mCqsYg&oe=6A393E4C"}, {"file_name": "1.png", "id": "415893571368646", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/39001715_415893574701979_3461447245540982035_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iWBmTZ4Pt-QQ7kNvwEX0CNd&_nc_oc=AdqCaSVCfZsOFn0WPmH839ol0ti4P_MlFGoEHBFlySA30ZjDhmG0v0ZRIZpzgmDsI-w&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-bfm9O-FR0Y26OpTdmPpziDe-IwW0RY9xUuThf00Kz1g&oe=6A395996"}, {"file_name": "3.png", "id": "662596896051796", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/38974523_662596899385129_8527079563659693432_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V7Xwt8_4mcYQ7kNvwHfqn2k&_nc_oc=AdqcReEfRuDg-j3Uj5wM3X_Q9FAIyaArgXh5owhPpKPV8OkGsfssUQdPnjpAgNjm5qo&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9KpIyW6HafxAM9NXPf5RJGNHNMTfMvTAIzK_xcVADe4A&oe=6A395814"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "gameplayVR3.png", "id": "492345567046352", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/38974804_492345570379685_6511341930176300148_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZPXP1c1qemwQ7kNvwGbiSQV&_nc_oc=AdpKXTttv7gsSUdJeWC0gtoZoz7S_65_UD4BBrnnHX_jjKu2r5Be7Mxah3-Cc8T18M0&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8XId6nGOsJelI9DuHTP08_nVZ3Mfj2AcbXbPoEHv-UWA&oe=6A39636D"}, "display_name": "Escape Simulator", "keywords": ["escape", "room", "coop", "multiplayer", "simulator"], "long_description": "Escape Simulator is a first-person puzzler you can **play solo or in an online co-op** (best with 2-3 players, but playable with up to 8!). Explore a growing set of **highly interactive escape rooms**. Pick up and examine everything, break objects, solve locks, and decipher puzzles to escape! After finishing the main game, watch for free content updates and explore rooms **built by our awesome community**.\n\n# \u2b50**REVIEWS** \n\"What I've seen has left me considerably impressed.\" - UploadVR\n\n# \u2692\ufe0f**COMMUNITY-MADE ROOMS**\nAfter finishing the main game **explore numerous rooms** built by our amazing community.\n\n# \ud83e\udd1d**ONLINE CO-OP**\nAll rooms are playable in an online co-op. Play with up to 8 players (best played with 2-3). Customize your character and join friends to solve puzzles together. More heads are better than one!\n\n# \ud83e\udde9**INTERACTIVE PUZZLES**\nExplore 28+ official rooms filled with puzzles designed by real-life escape room operators. If it\u2019s not nailed down, you can pick it up.\n\n# \ud83d\udd0d**EXEMINE EVERYTHING**\nRead books, examine ancient artifacts, and find clues to riddles. Need to cross-reference a clue? No problem - just pin it!\n\n# \ud83c\udfc6**WANT MORE?**\nThe game features additional content in the form of Addons with 4 large rooms each: \n- **Steampunk**: Solve four new rooms on the beautiful steampunk airship \"Valor.\"\n- **Wild West**: Become an outlaw in the Wild West.\n- **Magic**: Embrace your magic potential, and follow in the footsteps of great witches and wizards. \n\n", "short_description": "First-person puzzler you can play solo or in an online co-op. Explore a set of highly interactive escape rooms. Move furniture, pick up and examine everything, s
5/65396729_1225052078868354_6945820870147360559_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Au6woQdW3nwQ7kNvwGC_RT_&_nc_oc=Ado_AQ7DIfIcIX3WPz8KM2vx7tqKOKVEdpEJlQb6LZctIAWjglhVYIgKV5BMsdfXegc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1Ff7x2u9BvuIOdeo8S58Y1fnB7XIRC_5v4JvZ_Wulp3w&oe=69D65C1E"}, {"file_name": "4.png", "id": "975198817093493", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/57566693_975198820426826_7097624739394196541_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IMfqeO3o9TUQ7kNvwFlVqhd&_nc_oc=Adqfe78mKkHMZK1WCHqcoqu1sXihaUkl2PcAls4K3Bt28X-yd9DSKN24rKAL-JXbjD8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3I3kWK_KBZNz1VFCImFmMlZjLIswFnFYSLBvnUVkuRAQ&oe=69D65DCC"}, {"file_name": "1.png", "id": "415893571368646", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39001715_415893574701979_3461447245540982035_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fNV4Zjyn7iYQ7kNvwHDEb2R&_nc_oc=Adoxv4wv_9ilUqncyHQdUeaeZYujfBMDNHWmWRNBE1eMwm5j3jQhwre_Ha1vG9snmNU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3ajvNDqXqL0ZUQq1ByKVI4nzMEa5mx5rSRjGVJpFScmQ&oe=69D640D6"}, {"file_name": "3.png", "id": "662596896051796", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974523_662596899385129_8527079563659693432_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5zgPYLPa6fMQ7kNvwGOioW5&_nc_oc=AdriVGRAOMznZUgVW1otMj-dWgIlNgPLYS5sPm--6xGG6AdlUoOrc7yJdXlDWugcoXs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af35E0NKbkO4IuedCw2o2OLGQi55BNnrNxpafE8ziXJq5g&oe=69D63F54"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "gameplayVR3.png", "id": "492345567046352", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974804_492345570379685_6511341930176300148_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9maE9Tu2-AsQ7kNvwGbuhCW&_nc_oc=Adqwaxn-kFigJIak_aobN4t8Alf13N2WUghutF_9IYjRuDHBCYh27dQRc4dM6Q4PEpQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af18KKsXB7RGXnMCfBzCvNhF_6vllIekRy34wYQ2sSsF4Q&oe=69D64AAD"}, "display_name": "Escape Simulator", "keywords": ["escape", "room", "coop", "multiplayer", "simulator"], "long_description": "Escape Simulator is a first-person puzzler you can **play solo or in an online co-op** (best with 2-3 players, but playable with up to 8!). Explore a growing set of **highly interactive escape rooms**. Pick up and examine everything, break objects, solve locks, and decipher puzzles to escape! After finishing the main game, watch for free content updates and explore rooms **built by our awesome community**.\n\n# \u2b50**REVIEWS** \n\"What I've seen has left me considerably impressed.\" - UploadVR\n\n# \u2692\ufe0f**COMMUNITY-MADE ROOMS**\nAfter finishing the main game **explore numerous rooms** built by our amazing community.\n\n# \ud83e\udd1d**ONLINE CO-OP**\nAll rooms are playable in an online co-op. Play with up to 8 players (best played with 2-3). Customize your character and join friends to solve puzzles together. More heads are better than one!\n\n# \ud83e\udde9**INTERACTIVE PUZZLES**\nExplore 28+ official rooms filled with puzzles designed by real-life escape room operators. If it\u2019s not nailed down, you can pick it up.\n\n# \ud83d\udd0d**EXEMINE EVERYTHING**\nRead books, examine ancient artifacts, and find clues to riddles. Need to cross-reference a clue? No problem - just pin it!\n\n# \ud83c\udfc6**WANT MORE?**\nThe game features additional content in the form of Addons with 4 large rooms each: \n- **Steampunk**: Solve four new rooms on the beautiful steampunk airship \"Valor.\"\n- **Wild West**: Become an outlaw in the Wild West.\n- **Magic**: Embrace your magic potential, and follow in the footsteps of great witches and wizards. \n\n", "short_description": "First-person puzzler you can play solo or in an online co-op. Explore a set of highly interactive escape rooms. Move furniture, pick up and examine everything, smash pots and break 
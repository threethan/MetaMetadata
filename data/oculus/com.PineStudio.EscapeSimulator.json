25/65396729_1225052078868354_6945820870147360559_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ptBl5Du-WCYQ7kNvwGQp2am&_nc_oc=AdoqVZU7P8XOKxfTY6YBqTZiWn5jTzhvbkSQPRPk_mqHo-7MimMXJksz_1zBGH2XsBo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPHO1hZJJx1AAknaP_c9yV_tKdkYchpHOxsOfhecybbEA&oe=6AE5F11E"}, {"file_name": "4.png", "id": "975198817093493", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/57566693_975198820426826_7097624739394196541_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hi2buzqZ8rIQ7kNvwG5CSUS&_nc_oc=Ado3PlOTyXsl9vraWxSqSspdJQo6eNDu6PgrsXQCKOuAJXyj58NpNMKtSkPLub_gMTM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMo7tyJnbuHLVhR_f2i9oeJd04njFRGsk9dskRu2My1vQ&oe=6AE5F2CC"}, {"file_name": "1.png", "id": "415893571368646", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39001715_415893574701979_3461447245540982035_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6y39yHEvonEQ7kNvwFH2C06&_nc_oc=Adpqko_vDclwZ-XHPUoI14rbnFxuKL6JE2Lut5hFfTsJkeJwDtJ9aMF5SmTAQkGYBbs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOiRKtVtU20DP4dKjr1stHnvNUOxV2kRSR_PbdHgDQXWg&oe=6AE60E16"}, {"file_name": "3.png", "id": "662596896051796", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974523_662596899385129_8527079563659693432_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c-KJZT2BW8kQ7kNvwEh1oRK&_nc_oc=AdptHQmEaA79qqVW5tNHIKXqgTVBw3wFd2dt2bcpGu2whTmCNJ2ugWAWQdGDidfmbBw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPXwf-sUum484nI9MBdGHxZiIkWAyzSoSVwPFGTt7VDqA&oe=6AE60C94"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "gameplayVR3.png", "id": "492345567046352", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974804_492345570379685_6511341930176300148_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DL5t8mBQNAUQ7kNvwEsaKRx&_nc_oc=AdpNyZiQ_ThGtksi16V9reZJRLx9uFTPL8XGtxXUZflnQEGnLqJ-dvuvpiS_LQuHPug&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMjPX7AN_JCKidZCRqauounpiOWosyk1wpIJCjgzo1pVg&oe=6AE5DFAD"}, "display_name": "Escape Simulator", "keywords": ["escape", "room", "coop", "multiplayer", "simulator"], "long_description": "Escape Simulator is a first-person puzzler you can **play solo or in an online co-op** (best with 2-3 players, but playable with up to 8!). Explore a growing set of **highly interactive escape rooms**. Pick up and examine everything, break objects, solve locks, and decipher puzzles to escape! After finishing the main game, watch for free content updates and explore rooms **built by our awesome community**.\n\n# \u2b50**REVIEWS** \n\"What I've seen has left me considerably impressed.\" - UploadVR\n\n# \u2692\ufe0f**COMMUNITY-MADE ROOMS**\nAfter finishing the main game **explore numerous rooms** built by our amazing community.\n\n# \ud83e\udd1d**ONLINE CO-OP**\nAll rooms are playable in an online co-op. Play with up to 8 players (best played with 2-3). Customize your character and join friends to solve puzzles together. More heads are better than one!\n\n# \ud83e\udde9**INTERACTIVE PUZZLES**\nExplore 28+ official rooms filled with puzzles designed by real-life escape room operators. If it\u2019s not nailed down, you can pick it up.\n\n# \ud83d\udd0d**EXEMINE EVERYTHING**\nRead books, examine ancient artifacts, and find clues to riddles. Need to cross-reference a clue? No problem - just pin it!\n\n# \ud83c\udfc6**WANT MORE?**\nThe game features additional content in the form of Addons with 4 large rooms each: \n- **Steampunk**: Solve four new rooms on the beautiful steampunk airship \"Valor.\"\n- **Wild West**: Become an outlaw in the Wild West.\n- **Magic**: Embrace your magic potential, and follow in the footsteps of great witches and wizards. \n\n", "short_description": "First-person puzzler you can play solo or in an online co-op. Explore a set of highly interactive escape rooms. Move furniture, pick up and examine everything, smash pots and break
dn.com/v/t64.5771-25/65396729_1225052078868354_6945820870147360559_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QSnA-ONF0IMQ7kNvwE-6bSi&_nc_oc=Adqe79Qga7XQ39Q9Cf9QVR6GGVAyNxcJ9sx3sVOKX-gv1fYxDgLN0DHu7FWNzWwQ9hc&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK9iAXtCo0m-cbLfWGu5uwPY0Ehu3V-y18TRy5Tw6lFJg&oe=6AAE921E"}, {"file_name": "4.png", "id": "975198817093493", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/57566693_975198820426826_7097624739394196541_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SRCRkP1vIbAQ7kNvwEG2tXl&_nc_oc=AdpGgvM6KoMWagBjneII8K1cSc2p7jrSjrXQKhcmnmAUaToVuStutUrqqPIUslUzu-w&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKQE17772azzcWB1oOYYO3Sq4a9ZdT3WC9aG9xyKxY-Ew&oe=6AAE93CC"}, {"file_name": "1.png", "id": "415893571368646", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/39001715_415893574701979_3461447245540982035_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MfBACRiOUmAQ7kNvwF6Vl4n&_nc_oc=AdqwZvRFVU5hF9gJFxV1PT_jvzlzGSgMz8FnKZyz3-eQdyVwKyYem4Q6ZwnIgseRKJ0&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKyIUwZfXMI7mRPmf0w3X9yIbo5MroklGRGBHD9I1KHsA&oe=6AAEAF16"}, {"file_name": "3.png", "id": "662596896051796", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/38974523_662596899385129_8527079563659693432_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hzYY6q_lswsQ7kNvwHdmnEC&_nc_oc=AdoNj_eRTuMIeg02xmnUR_CwJmwkTkhyle-oUv0wOCzvhg_BcQNTd_T8hVx3Q2dnGqc&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKB_w3S_5eAMw9hm_o7WXCf6Mogr3DEgGw_TXd5gt0lBA&oe=6AAEAD94"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "gameplayVR3.png", "id": "492345567046352", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/38974804_492345570379685_6511341930176300148_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4OAEXgxz9twQ7kNvwFKo6eJ&_nc_oc=AdoR9VcqRmhKg303gTwknN6GqvBlsHHZybHfnSyHRRHVj4tkNm4ZETYBia6xlkgU6_4&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJM9Q4Uxk78P3j1qeh2fiylhPdVKAoGmRDN9jUUWq6kBA&oe=6AAE80AD"}, "display_name": "Escape Simulator", "keywords": ["escape", "room", "coop", "multiplayer", "simulator"], "long_description": "Escape Simulator is a first-person puzzler you can **play solo or in an online co-op** (best with 2-3 players, but playable with up to 8!). Explore a growing set of **highly interactive escape rooms**. Pick up and examine everything, break objects, solve locks, and decipher puzzles to escape! After finishing the main game, watch for free content updates and explore rooms **built by our awesome community**.\n\n# \u2b50**REVIEWS** \n\"What I've seen has left me considerably impressed.\" - UploadVR\n\n# \u2692\ufe0f**COMMUNITY-MADE ROOMS**\nAfter finishing the main game **explore numerous rooms** built by our amazing community.\n\n# \ud83e\udd1d**ONLINE CO-OP**\nAll rooms are playable in an online co-op. Play with up to 8 players (best played with 2-3). Customize your character and join friends to solve puzzles together. More heads are better than one!\n\n# \ud83e\udde9**INTERACTIVE PUZZLES**\nExplore 28+ official rooms filled with puzzles designed by real-life escape room operators. If it\u2019s not nailed down, you can pick it up.\n\n# \ud83d\udd0d**EXEMINE EVERYTHING**\nRead books, examine ancient artifacts, and find clues to riddles. Need to cross-reference a clue? No problem - just pin it!\n\n# \ud83c\udfc6**WANT MORE?**\nThe game features additional content in the form of Addons with 4 large rooms each: \n- **Steampunk**: Solve four new rooms on the beautiful steampunk airship \"Valor.\"\n- **Wild West**: Become an outlaw in the Wild West.\n- **Magic**: Embrace your magic potential, and follow in the footsteps of great witches and wizards. \n\n", "short_description": "First-person puzzler you can play solo or in an online co-op. Explore a set of highly interactive escape rooms. Move furniture, pick up and examine everything, 
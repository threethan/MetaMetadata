25/65396729_1225052078868354_6945820870147360559_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T0Nz54nXeKQQ7kNvwFS5axT&_nc_oc=Adp2K2nTRrXN5cqLeM4KgbeCJry5zzhcXHhG9XGK3uHDKbbo1vmc-lLqJRCSuui31zY&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHYdvmy6_L1YeyLyqeOkeso2sktPtsgbTvS6MOVAOZTtA&oe=6A84621E"}, {"file_name": "4.png", "id": "975198817093493", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/57566693_975198820426826_7097624739394196541_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=616WH1Ofv-AQ7kNvwEnxY63&_nc_oc=AdqnnpK3rCcAgRf2B9yCTHCnlE39Prce_D-xB19RXH2_HL5J2a7rf2wFaXCe2bi5Nyc&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFpv0rBOiMt-lf1nIW6fPBrEg2AVGGScHYVvjuS84D9RA&oe=6A8463CC"}, {"file_name": "1.png", "id": "415893571368646", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39001715_415893574701979_3461447245540982035_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KbkBOMIVzgoQ7kNvwH5DJqo&_nc_oc=Adpn6gfxwQSKvtA4VdQq-WVt8sGbetjoHblQ2BZ4jkI9ZSQH-0GHgVzFZHTR2C9N8QA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFyp0SEjZOSWkcxxegZvKLjkvgABiRU8wrF7TM1KOEJoA&oe=6A8446D6"}, {"file_name": "3.png", "id": "662596896051796", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974523_662596899385129_8527079563659693432_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-lOGfIW4EmYQ7kNvwGWFez9&_nc_oc=AdqPzj5LEETqUyezx54w2-o4ner2qwBtKgdSO-ci30ZlH8gNdQrpZWlAuSwmn0J3zKo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFBzzE7Cp307R4l9ubJOrgd087dT-u_rNAdcQhrRHGnPw&oe=6A844554"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "gameplayVR3.png", "id": "492345567046352", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974804_492345570379685_6511341930176300148_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZYtC7MEhLG8Q7kNvwGiIPTs&_nc_oc=Adpui8WdRGZtnnu2lMYjrnCZbwJFQhTQzxpBFyyB-GDIJg6sioL7bZisB-udtygTA_8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFrZomGxBTX7x5nXiZcFzsewv_A-Op2PU5B7hNcCOKXMQ&oe=6A8450AD"}, "display_name": "Escape Simulator", "keywords": ["escape", "room", "coop", "multiplayer", "simulator"], "long_description": "Escape Simulator is a first-person puzzler you can **play solo or in an online co-op** (best with 2-3 players, but playable with up to 8!). Explore a growing set of **highly interactive escape rooms**. Pick up and examine everything, break objects, solve locks, and decipher puzzles to escape! After finishing the main game, watch for free content updates and explore rooms **built by our awesome community**.\n\n# \u2b50**REVIEWS** \n\"What I've seen has left me considerably impressed.\" - UploadVR\n\n# \u2692\ufe0f**COMMUNITY-MADE ROOMS**\nAfter finishing the main game **explore numerous rooms** built by our amazing community.\n\n# \ud83e\udd1d**ONLINE CO-OP**\nAll rooms are playable in an online co-op. Play with up to 8 players (best played with 2-3). Customize your character and join friends to solve puzzles together. More heads are better than one!\n\n# \ud83e\udde9**INTERACTIVE PUZZLES**\nExplore 28+ official rooms filled with puzzles designed by real-life escape room operators. If it\u2019s not nailed down, you can pick it up.\n\n# \ud83d\udd0d**EXEMINE EVERYTHING**\nRead books, examine ancient artifacts, and find clues to riddles. Need to cross-reference a clue? No problem - just pin it!\n\n# \ud83c\udfc6**WANT MORE?**\nThe game features additional content in the form of Addons with 4 large rooms each: \n- **Steampunk**: Solve four new rooms on the beautiful steampunk airship \"Valor.\"\n- **Wild West**: Become an outlaw in the Wild West.\n- **Magic**: Embrace your magic potential, and follow in the footsteps of great witches and wizards. \n\n", "short_description": "First-person puzzler you can play solo or in an online co-op. Explore a set of highly interactive escape rooms. Move furniture, pick up and examine everything, smash pots and break
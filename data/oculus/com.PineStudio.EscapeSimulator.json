5/65396729_1225052078868354_6945820870147360559_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UouFL28ITrUQ7kNvwFF2Ib0&_nc_oc=Adq-9n708e3psiA_tuyZPHvWkAhOc69iaPw2Ey3KYk0g8y-fHGKHZVc-j0Jxvek3kHk&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8C2lgzoOSxJ6dvS98FVgOkzNKY2ZceQCdTSVw7IGzX_g&oe=6A32A51E"}, {"file_name": "4.png", "id": "975198817093493", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/57566693_975198820426826_7097624739394196541_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-4dfcp6I2J8Q7kNvwHTmhjM&_nc_oc=Adr4uOQ_np-xhKwvfA-nS1pI6GF5gDrLMyoYRJ22p_Nzn697KRo8oRkIijeu42ez8DI&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-H2HCDwq76fHG4ft6WfeUe5AnSTTXYu8znO_YetAh9eA&oe=6A32A6CC"}, {"file_name": "1.png", "id": "415893571368646", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/39001715_415893574701979_3461447245540982035_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AhRwqXUG9_YQ7kNvwHyieTD&_nc_oc=AdreQsE04GBQ-G6TRVbuK1B44wk2KdoowFYoExPVDrNNBs59fNOXcWINO0XS5vlRIhM&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af80XyRU_UKR42W8uI1miUT4nPDL2OyjX8_lN0zfnMSHqA&oe=6A32C216"}, {"file_name": "3.png", "id": "662596896051796", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38974523_662596899385129_8527079563659693432_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mMDScQWXAikQ7kNvwG9y6Wc&_nc_oc=AdoFI9yPual6l7KFMfuAk62VdNKfNrP-6fEW91Q2vBm2i8O_PBOgGD5DxaNHTrK83qs&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_nIRSOiPJuUQpqgqfMbxDnTxk0SbEYGzDUAMZLqUK_sg&oe=6A32C094"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "gameplayVR3.png", "id": "492345567046352", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/38974804_492345570379685_6511341930176300148_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dyIiqhix0PkQ7kNvwFH-wNZ&_nc_oc=Ado7hMsZ1MdzDxiEE4rfR1Jblm0lLP6dEPjUS1tAeNehmJpCtFMMEHXAR2IcoEZwx9g&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af81McdMKYXOrSvg7-htCttvE0FJD_-_WMhrS2lY6b5OWg&oe=6A3293AD"}, "display_name": "Escape Simulator", "keywords": ["escape", "room", "coop", "multiplayer", "simulator"], "long_description": "Escape Simulator is a first-person puzzler you can **play solo or in an online co-op** (best with 2-3 players, but playable with up to 8!). Explore a growing set of **highly interactive escape rooms**. Pick up and examine everything, break objects, solve locks, and decipher puzzles to escape! After finishing the main game, watch for free content updates and explore rooms **built by our awesome community**.\n\n# \u2b50**REVIEWS** \n\"What I've seen has left me considerably impressed.\" - UploadVR\n\n# \u2692\ufe0f**COMMUNITY-MADE ROOMS**\nAfter finishing the main game **explore numerous rooms** built by our amazing community.\n\n# \ud83e\udd1d**ONLINE CO-OP**\nAll rooms are playable in an online co-op. Play with up to 8 players (best played with 2-3). Customize your character and join friends to solve puzzles together. More heads are better than one!\n\n# \ud83e\udde9**INTERACTIVE PUZZLES**\nExplore 28+ official rooms filled with puzzles designed by real-life escape room operators. If it\u2019s not nailed down, you can pick it up.\n\n# \ud83d\udd0d**EXEMINE EVERYTHING**\nRead books, examine ancient artifacts, and find clues to riddles. Need to cross-reference a clue? No problem - just pin it!\n\n# \ud83c\udfc6**WANT MORE?**\nThe game features additional content in the form of Addons with 4 large rooms each: \n- **Steampunk**: Solve four new rooms on the beautiful steampunk airship \"Valor.\"\n- **Wild West**: Become an outlaw in the Wild West.\n- **Magic**: Embrace your magic potential, and follow in the footsteps of great witches and wizards. \n\n", "short_description": "First-person puzzler you can play solo or in an online co-op. Explore a set of highly interactive escape rooms. Move furniture, pick up and examine everything, smash pots and break 
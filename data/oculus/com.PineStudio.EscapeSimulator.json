-7&_nc_sid=6e7a0a&_nc_ohc=ew-WircmkkwQ7kNvwEIzp8I&_nc_oc=AdqkwWNyXTyWx-AtZEIJhr_rLkU6z36-WeFqWRAgYM_NUuSsHUN82XEcVHFAnqg62Ek&_nc_zt=3&_nc_ht=scontent-lhr8-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6h5ELjUWKSLxsW9fab8-9mJBbx_4d8by_klvlwespaPQ&oe=6A105E1E"}, {"file_name": "2.png", "id": "457815206622098", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/75210399_457815209955431_6948775186918221287_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e9mfzNInl5IQ7kNvwF6-Ua2&_nc_oc=AdrqYCsk5gsYoNKOzHd5HBjNucnuMaCLWRLJSV415W9tp-2XP_5SbhmMZ8MBoB5T5rM&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5TzND8nVP26U4tvCR195Sww8Wk4WMFUtngxEedOiOZIQ&oe=6A10536A"}, {"file_name": "3.png", "id": "662596896051796", "uri": "https://scontent-lhr8-2.oculuscdn.com/v/t64.5771-25/38974523_662596899385129_8527079563659693432_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nLUvfxj73W4Q7kNvwHFgs2K&_nc_oc=AdrTsAvZCuqqfKx9ZpBZbvYpFk2HX5DKEMQO_g3fVyz-y5wS1eJMi1ww7ljoqLXbWpE&_nc_zt=3&_nc_ht=scontent-lhr8-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6Q7cwdjWx9rZv-llzNEOrLvZBgnDZFfNQzPF-7lAYtTQ&oe=6A107994"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "gameplayVR3.png", "id": "492345567046352", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/38974804_492345570379685_6511341930176300148_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e1A4AT1p3W0Q7kNvwFI7UEx&_nc_oc=AdoUYs5715rihzC2uHmeTBNqWQcNp3n4IyqqTcc3SFCAQzra59pOIwXLIsjW1d_8wsY&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af50tj0frVsHJbAY3bAcyYvweA0qzbn6CcMOLDzeSRTWeA&oe=6A104CAD"}, "display_name": "Escape Simulator", "keywords": ["escape", "room", "coop", "simulator", "puzzle"], "long_description": "Escape Simulator is a first-person puzzler you can **play solo or in an cross platform online co-op** (best with 2-3 players, but playable with up to 8!). Explore a growing set of **highly interactive escape rooms**. Pick up and examine everything, break objects, solve locks, and decipher puzzles to escape! After finishing the main game, watch for free content updates and explore rooms **built by our awesome community**.\n\n# \u2b50**REVIEWS** \n\"What I've seen has left me considerably impressed.\" - UploadVR\n\n# \u2692\ufe0f**COMMUNITY-MADE ROOMS**\nAfter finishing the main game **explore numerous rooms** built by our amazing Steam community. New rooms every Friday!\n\n# \ud83e\udd1d**CROSS-PLATFORM CO-OP**\nAll rooms are playable in a cross platform online co-op. Play with up to 8 players (best played with 2-3) on PC, Quest 2 and 3. Customize your character and join friends to solve puzzles together. More heads are better than one! \n\n# \ud83e\udde9**INTERACTIVE PUZZLES**\nExplore 21+ official rooms filled with puzzles designed by real-life escape room operators. If it\u2019s not nailed down, you can pick it up.\n\n# \ud83d\udd0d**EXEMINE EVERYTHING**\nRead books, examine ancient artifacts, and find clues to riddles. Need to cross-reference a clue? No problem - just pin it!\n\n# \ud83c\udfc6**MORE COMING VERY SOON!** \nThe game is getting even more content in a form of free rooms & addons: \n- **Steampunk**: Solve four new rooms on the beautiful steampunk airship \"Valor.\"\n- **Wild West**: Become an outlaw in the Wild West.\n- **Magic**: Embrace your magic potential, and follow in the footsteps of great witches and wizards. \n\n", "short_description": "First-person puzzler you can play solo or in an online co-op. Explore a set of highly interactive escape rooms. Move furniture, pick up and examine everything, smash pots and break locks! Supports community rooms through the level editor."}]}, "developer_name": null, "developer_privacy_policy_url": "https://pinestudio.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Pine Studio", "support_website_url": "https://pinestudio.com/contact/", "website_url": "https://pinestudio.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [
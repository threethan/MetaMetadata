5/65396729_1225052078868354_6945820870147360559_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lHqJ4Y6hu7AQ7kNvwE4Bzyj&_nc_oc=AdqJbpJRNyvm79yg1GNHYxhf98zrYPevLgI1LxQzUs9Tx_3aZcfwwGKkZtK12N74gJc&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af87txGhsGqwBiN-MpBBFXGPU7XhKtzcX3Gfa2i1C2sSSw&oe=6A451A1E"}, {"file_name": "4.png", "id": "975198817093493", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/57566693_975198820426826_7097624739394196541_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vBBWbA-R9h0Q7kNvwGnbWm7&_nc_oc=AdoYKBDDIoF3l537etGVSde4v6d95SeMrX0s58qxqLUncPK7VF1faBMYg6D8ByHpAPw&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-FHJ0rDnLuicPlnoGOqSDQIGRo3mY2Gj3OtgGXwhlrFA&oe=6A451BCC"}, {"file_name": "1.png", "id": "415893571368646", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39001715_415893574701979_3461447245540982035_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lUSMl0iwOigQ7kNvwE1tFhY&_nc_oc=AdpCuoPoRYon_v5beRNaqPNgVZ8mkJv3XeRKcq652ESOeh10TijCz_iQhwc47mUdSSs&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8EI-szWDjFU80w8R58JrJV9Of40wREFdIyWdUr1A62Ag&oe=6A453716"}, {"file_name": "3.png", "id": "662596896051796", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38974523_662596899385129_8527079563659693432_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zEZKWL_LMYIQ7kNvwGGHJBR&_nc_oc=Ado0be7k4FgLcTggljgr-lmNZ0vv6Qr7ST-7oqEzzFAOPwWy9juAMICpBZDO3LYlxbI&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_ziMFVF6nE9ix99TD6EaP9OK1nwVMuuYnV_02ae9CBiA&oe=6A453594"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "gameplayVR3.png", "id": "492345567046352", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38974804_492345570379685_6511341930176300148_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OqFg_CImPLcQ7kNvwHLC2-U&_nc_oc=AdoeYqYXYbjhYPourkdxXm5XfiTI6Wxw_8W_LqJseLo-tCZT9HiBe75mZEYHSlBJnkA&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_yJ1E_9tCUxITmKx1PjtYVcn1s67hJxv0fi-mBL_uM6Q&oe=6A4508AD"}, "display_name": "Escape Simulator", "keywords": ["escape", "room", "coop", "multiplayer", "simulator"], "long_description": "Escape Simulator is a first-person puzzler you can **play solo or in an online co-op** (best with 2-3 players, but playable with up to 8!). Explore a growing set of **highly interactive escape rooms**. Pick up and examine everything, break objects, solve locks, and decipher puzzles to escape! After finishing the main game, watch for free content updates and explore rooms **built by our awesome community**.\n\n# \u2b50**REVIEWS** \n\"What I've seen has left me considerably impressed.\" - UploadVR\n\n# \u2692\ufe0f**COMMUNITY-MADE ROOMS**\nAfter finishing the main game **explore numerous rooms** built by our amazing community.\n\n# \ud83e\udd1d**ONLINE CO-OP**\nAll rooms are playable in an online co-op. Play with up to 8 players (best played with 2-3). Customize your character and join friends to solve puzzles together. More heads are better than one!\n\n# \ud83e\udde9**INTERACTIVE PUZZLES**\nExplore 28+ official rooms filled with puzzles designed by real-life escape room operators. If it\u2019s not nailed down, you can pick it up.\n\n# \ud83d\udd0d**EXEMINE EVERYTHING**\nRead books, examine ancient artifacts, and find clues to riddles. Need to cross-reference a clue? No problem - just pin it!\n\n# \ud83c\udfc6**WANT MORE?**\nThe game features additional content in the form of Addons with 4 large rooms each: \n- **Steampunk**: Solve four new rooms on the beautiful steampunk airship \"Valor.\"\n- **Wild West**: Become an outlaw in the Wild West.\n- **Magic**: Embrace your magic potential, and follow in the footsteps of great witches and wizards. \n\n", "short_description": "First-person puzzler you can play solo or in an online co-op. Explore a set of highly interactive escape rooms. Move furniture, pick up and examine everything, smash pots and break 
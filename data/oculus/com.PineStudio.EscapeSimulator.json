5/65396729_1225052078868354_6945820870147360559_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yulwHBbuKT8Q7kNvwHNFQGi&_nc_oc=AdrJ2FxYeFKDVMM8hhJyXG8U2Kp-Z2dUYI5QPvVliF1U-jstim7bBpolgf8B55lNovI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_s9v7egoh31Cr_PQ3RobyBWLmFsZSkuPKQXLNqdYmw4Q&oe=6A37EB1E"}, {"file_name": "4.png", "id": "975198817093493", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/57566693_975198820426826_7097624739394196541_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K7ucvfeBW-EQ7kNvwEgZWNy&_nc_oc=AdoUEKfaYNNdIhoMJiYUm5LXXkGYlNt_8TIlITYnfhfzD2jtq1mbYLNkI-PqxFkujjI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af80SVcmiXaSiG09Xk0KDyJudFSmxmXPd5z5qMKM6wONEw&oe=6A37ECCC"}, {"file_name": "1.png", "id": "415893571368646", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39001715_415893574701979_3461447245540982035_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YeCYgAD-dBIQ7kNvwGEbLNV&_nc_oc=AdpdHhisXTYGRnMamwwv1lEiLB2D6zCJfKyZqlPnb2DjgpTqozaNlqwnl0UFTyU9sGo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9-ocNuMjS-BaV0HY4nM4kAiEBEDpZkECfFnYS3qe6Upg&oe=6A380816"}, {"file_name": "3.png", "id": "662596896051796", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974523_662596899385129_8527079563659693432_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V7Xwt8_4mcYQ7kNvwHdP00N&_nc_oc=AdrNhpdnxICCmwjnwn_ts8w-MdDQPWz_0UiJddNp3t6lWPz07ZcOhF2SvIiG2ZBWS4c&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8rIWB-2a-k64rh-RuD3_NIi91eeXcyWHDtYaT7Zewnxw&oe=6A380694"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "gameplayVR3.png", "id": "492345567046352", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974804_492345570379685_6511341930176300148_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZPXP1c1qemwQ7kNvwF0UrUF&_nc_oc=Adp_SKfSjmLLhYa37ycOp-Z218gAnln_Y2VeLJOW8lfs7Ey8801avzi30G-F-tc-SQ4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-Fj8-W7hryCDx-4-MjUYHVd6KrXFlCyzMHMhuw50pxBw&oe=6A3811ED"}, "display_name": "Escape Simulator", "keywords": ["escape", "room", "coop", "multiplayer", "simulator"], "long_description": "Escape Simulator is a first-person puzzler you can **play solo or in an online co-op** (best with 2-3 players, but playable with up to 8!). Explore a growing set of **highly interactive escape rooms**. Pick up and examine everything, break objects, solve locks, and decipher puzzles to escape! After finishing the main game, watch for free content updates and explore rooms **built by our awesome community**.\n\n# \u2b50**REVIEWS** \n\"What I've seen has left me considerably impressed.\" - UploadVR\n\n# \u2692\ufe0f**COMMUNITY-MADE ROOMS**\nAfter finishing the main game **explore numerous rooms** built by our amazing community.\n\n# \ud83e\udd1d**ONLINE CO-OP**\nAll rooms are playable in an online co-op. Play with up to 8 players (best played with 2-3). Customize your character and join friends to solve puzzles together. More heads are better than one!\n\n# \ud83e\udde9**INTERACTIVE PUZZLES**\nExplore 28+ official rooms filled with puzzles designed by real-life escape room operators. If it\u2019s not nailed down, you can pick it up.\n\n# \ud83d\udd0d**EXEMINE EVERYTHING**\nRead books, examine ancient artifacts, and find clues to riddles. Need to cross-reference a clue? No problem - just pin it!\n\n# \ud83c\udfc6**WANT MORE?**\nThe game features additional content in the form of Addons with 4 large rooms each: \n- **Steampunk**: Solve four new rooms on the beautiful steampunk airship \"Valor.\"\n- **Wild West**: Become an outlaw in the Wild West.\n- **Magic**: Embrace your magic potential, and follow in the footsteps of great witches and wizards. \n\n", "short_description": "First-person puzzler you can play solo or in an online co-op. Explore a set of highly interactive escape rooms. Move furniture, pick up and examine everything, smash pots and break 
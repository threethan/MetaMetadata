25/65396729_1225052078868354_6945820870147360559_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_Igr86B4kNcQ7kNvwHCwjZl&_nc_oc=Ado9REY6RN2EXnGPIgdYbv5nVlspdwbgPZpEMEyKwUr3sGHYhHOzfufFvIdLF_zgHxI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNrwv4EWvXFBcKL92ZDu0BQTtGMERWFmSB0x8pzAsEqNw&oe=6AC3AA1E"}, {"file_name": "4.png", "id": "975198817093493", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/57566693_975198820426826_7097624739394196541_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=os8tY1WhV4wQ7kNvwG-rpXc&_nc_oc=AdqIt-XwZXOB-dpstNmaeZswWDwyJzVnQbn2cajuPugeTXQkFzJlUb6k1EiJlpvIGI8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMljDqgg3nb999HoZCUQI0C1XS7K_G-rGHOMvDnUTCI7A&oe=6AC3ABCC"}, {"file_name": "1.png", "id": "415893571368646", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39001715_415893574701979_3461447245540982035_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=--emYekIg3wQ7kNvwG_bOOA&_nc_oc=AdocnT5lGjR8NTGbnGB4gfckbxsB0tykEd-Xs1d_itwhZFDv4lXecY-WMPa9fzu9_SE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNu2L9TQLSOVKv75hRc1D836Dw6VC_i_mSawSJjNizu3Q&oe=6AC3C716"}, {"file_name": "3.png", "id": "662596896051796", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974523_662596899385129_8527079563659693432_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9WXWPy7Gm8IQ7kNvwG_Eq4u&_nc_oc=AdoCu9EZEZ3uteDOLIghlThO2v0iAYnA8G3SQMoGe2Ds0hlldZP7CVRdI3ori0IsPe4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOydFbN8oQBOnfmp_yqLqAZOhxvRbUWY69_oXxOR8snOQ&oe=6AC3C594"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "gameplayVR3.png", "id": "492345567046352", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974804_492345570379685_6511341930176300148_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BZrPNO1HrgcQ7kNvwEI6tVf&_nc_oc=AdoJoYQJj02JydHQtHA7LtSVGz8Rz6sAAgjVxf8jhhgCw7WWO0_baYurDCBkKn7irFU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMETJGWtI92Dip3DuQdY9rmepuSjLUmyViuYTUwlAoQNA&oe=6AC3D0ED"}, "display_name": "Escape Simulator", "keywords": ["escape", "room", "coop", "multiplayer", "simulator"], "long_description": "Escape Simulator is a first-person puzzler you can **play solo or in an online co-op** (best with 2-3 players, but playable with up to 8!). Explore a growing set of **highly interactive escape rooms**. Pick up and examine everything, break objects, solve locks, and decipher puzzles to escape! After finishing the main game, watch for free content updates and explore rooms **built by our awesome community**.\n\n# \u2b50**REVIEWS** \n\"What I've seen has left me considerably impressed.\" - UploadVR\n\n# \u2692\ufe0f**COMMUNITY-MADE ROOMS**\nAfter finishing the main game **explore numerous rooms** built by our amazing community.\n\n# \ud83e\udd1d**ONLINE CO-OP**\nAll rooms are playable in an online co-op. Play with up to 8 players (best played with 2-3). Customize your character and join friends to solve puzzles together. More heads are better than one!\n\n# \ud83e\udde9**INTERACTIVE PUZZLES**\nExplore 28+ official rooms filled with puzzles designed by real-life escape room operators. If it\u2019s not nailed down, you can pick it up.\n\n# \ud83d\udd0d**EXEMINE EVERYTHING**\nRead books, examine ancient artifacts, and find clues to riddles. Need to cross-reference a clue? No problem - just pin it!\n\n# \ud83c\udfc6**WANT MORE?**\nThe game features additional content in the form of Addons with 4 large rooms each: \n- **Steampunk**: Solve four new rooms on the beautiful steampunk airship \"Valor.\"\n- **Wild West**: Become an outlaw in the Wild West.\n- **Magic**: Embrace your magic potential, and follow in the footsteps of great witches and wizards. \n\n", "short_description": "First-person puzzler you can play solo or in an online co-op. Explore a set of highly interactive escape rooms. Move furniture, pick up and examine everything, smash pots and break
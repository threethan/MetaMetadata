5/65396729_1225052078868354_6945820870147360559_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wIuEfoYgHgcQ7kNvwGMBxUD&_nc_oc=Adr6sSUJ8QziqWHc0x_FoppjgtDD0PWCqAGzfH3NqKZxSCqYuVskdGMUFVK485FngfY&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC_kF35q3g0F1O1cvIhmf45tuKzPs9rRxCqCj8nDQnjGw&oe=6A58E09E"}, {"file_name": "4.png", "id": "975198817093493", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/57566693_975198820426826_7097624739394196541_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JFJtusRhpq4Q7kNvwFIf4u5&_nc_oc=AdqoH3P0Z69Y0MNnNLVEbP_CUCXLdBRYmI-GIaOnAoeF_gnmtur0RKJyaaB72aRQuAY&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCTiv7onSv2OGR3J4d9ygmWh0vHTaMQsYfGFx1bJMMoTg&oe=6A58E24C"}, {"file_name": "1.png", "id": "415893571368646", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/39001715_415893574701979_3461447245540982035_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sQYZmCPTJCwQ7kNvwFXjEcI&_nc_oc=AdoGJMFyB56ETSUpRvu0s9nLhoBjtIdJ-JnGG4CQdqoYM9IyNkHV2nnarIrpl-B91c0&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC4p90X7vyR7nkYGBrB5RL_MCMCEz4HNd7L_Fd5nzZCgA&oe=6A58C556"}, {"file_name": "3.png", "id": "662596896051796", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38974523_662596899385129_8527079563659693432_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xhBqTxumjo8Q7kNvwH1HlN7&_nc_oc=AdosXJ92Ce-LetWEAS-ZsNTMi3pCceOG62rlbjVqeSXbRbzu5WcNTfWYaULz2g_0Y6A&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCowNkwmLSTdos5jB0yJpnbByI1NX77hH9dVO54RHVNvw&oe=6A58C3D4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "gameplayVR3.png", "id": "492345567046352", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/38974804_492345570379685_6511341930176300148_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2RU-cdW6kqAQ7kNvwGTG9tD&_nc_oc=Adowp_7RIPaP34_gX0LZ8FNlpN4ENsJT3aLpeeau25hHW5wpK9Zs6odT74_rCPL0aNg&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBKGI4YI7qPAW_LFeFoP9i6jaHyAVhTQdunIi0itc7XJg&oe=6A58CF2D"}, "display_name": "Escape Simulator", "keywords": ["escape", "room", "coop", "multiplayer", "simulator"], "long_description": "Escape Simulator is a first-person puzzler you can **play solo or in an online co-op** (best with 2-3 players, but playable with up to 8!). Explore a growing set of **highly interactive escape rooms**. Pick up and examine everything, break objects, solve locks, and decipher puzzles to escape! After finishing the main game, watch for free content updates and explore rooms **built by our awesome community**.\n\n# \u2b50**REVIEWS** \n\"What I've seen has left me considerably impressed.\" - UploadVR\n\n# \u2692\ufe0f**COMMUNITY-MADE ROOMS**\nAfter finishing the main game **explore numerous rooms** built by our amazing community.\n\n# \ud83e\udd1d**ONLINE CO-OP**\nAll rooms are playable in an online co-op. Play with up to 8 players (best played with 2-3). Customize your character and join friends to solve puzzles together. More heads are better than one!\n\n# \ud83e\udde9**INTERACTIVE PUZZLES**\nExplore 28+ official rooms filled with puzzles designed by real-life escape room operators. If it\u2019s not nailed down, you can pick it up.\n\n# \ud83d\udd0d**EXEMINE EVERYTHING**\nRead books, examine ancient artifacts, and find clues to riddles. Need to cross-reference a clue? No problem - just pin it!\n\n# \ud83c\udfc6**WANT MORE?**\nThe game features additional content in the form of Addons with 4 large rooms each: \n- **Steampunk**: Solve four new rooms on the beautiful steampunk airship \"Valor.\"\n- **Wild West**: Become an outlaw in the Wild West.\n- **Magic**: Embrace your magic potential, and follow in the footsteps of great witches and wizards. \n\n", "short_description": "First-person puzzler you can play solo or in an online co-op. Explore a set of highly interactive escape rooms. Move furniture, pick up and examine everything, smash pots and break 
5/65396729_1225052078868354_6945820870147360559_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-1JdyRrzvFEQ7kNvwGdrQyP&_nc_oc=AdpbD2jYxobVbwLrxxF8Tn1b0r6ky1ti8X6yej-h7Yaq4oXn7A5_01L-RasnYyeRYQQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6FsDNQftXvv2b_IFrpSfx2aCkTJZ3rW6GhmTf690dnzw&oe=6A14529E"}, {"file_name": "4.png", "id": "975198817093493", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/57566693_975198820426826_7097624739394196541_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yhYMKAqhItwQ7kNvwHLkXtZ&_nc_oc=Adr5GWmBneUjRM7pCjBozRys8respm6-Y0U9iqCvZSWb9gaMIKcEamK4_Ecu8gs4wAk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7J0ttyXa3zmuAQjU6IIFwsBZ3cSeX8pvc6BaNHOyDG2g&oe=6A14544C"}, {"file_name": "1.png", "id": "415893571368646", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39001715_415893574701979_3461447245540982035_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2If3RRRu8X8Q7kNvwHLzCiO&_nc_oc=Adqzt-wePCjig0qR9G01KKVLa0kzNJHYzFMJWRPbAAsBFthEiEefj3VCaAxFwHfpTWo&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4eB69B01fKCfZvK41GI8PKmq77FVNUefjcdteIS2Q3Zw&oe=6A146F96"}, {"file_name": "3.png", "id": "662596896051796", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974523_662596899385129_8527079563659693432_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4my6Z0loxIMQ7kNvwEJ0ipu&_nc_oc=Adpaq7bqc1Mwg7OmreJo5cirnw4VPq_ycJGs0bCANCexqM0eV0dFzR_noXqS1hbQr10&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4KNpKj1Xp5kdvTNs9w3qCqjVvRWEC0vweX--48YoxWkw&oe=6A146E14"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "gameplayVR3.png", "id": "492345567046352", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974804_492345570379685_6511341930176300148_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2yX_oF45gJsQ7kNvwHfjaFE&_nc_oc=AdrgDyYZUg2Z0bSSGUgtqLxrDojh6k44ExNeZH4_8EXgKKjcVI37rW1R5h2wvMnwx54&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7pcpMgeEuM3BVXlgvZEkj2haVc9OUj2xzjLdpsrOgeZw&oe=6A14796D"}, "display_name": "Escape Simulator", "keywords": ["escape", "room", "coop", "multiplayer", "simulator"], "long_description": "Escape Simulator is a first-person puzzler you can **play solo or in an online co-op** (best with 2-3 players, but playable with up to 8!). Explore a growing set of **highly interactive escape rooms**. Pick up and examine everything, break objects, solve locks, and decipher puzzles to escape! After finishing the main game, watch for free content updates and explore rooms **built by our awesome community**.\n\n# \u2b50**REVIEWS** \n\"What I've seen has left me considerably impressed.\" - UploadVR\n\n# \u2692\ufe0f**COMMUNITY-MADE ROOMS**\nAfter finishing the main game **explore numerous rooms** built by our amazing community.\n\n# \ud83e\udd1d**ONLINE CO-OP**\nAll rooms are playable in an online co-op. Play with up to 8 players (best played with 2-3). Customize your character and join friends to solve puzzles together. More heads are better than one!\n\n# \ud83e\udde9**INTERACTIVE PUZZLES**\nExplore 28+ official rooms filled with puzzles designed by real-life escape room operators. If it\u2019s not nailed down, you can pick it up.\n\n# \ud83d\udd0d**EXEMINE EVERYTHING**\nRead books, examine ancient artifacts, and find clues to riddles. Need to cross-reference a clue? No problem - just pin it!\n\n# \ud83c\udfc6**WANT MORE?**\nThe game features additional content in the form of Addons with 4 large rooms each: \n- **Steampunk**: Solve four new rooms on the beautiful steampunk airship \"Valor.\"\n- **Wild West**: Become an outlaw in the Wild West.\n- **Magic**: Embrace your magic potential, and follow in the footsteps of great witches and wizards. \n\n", "short_description": "First-person puzzler you can play solo or in an online co-op. Explore a set of highly interactive escape rooms. Move furniture, pick up and examine everything, smash pots and break 
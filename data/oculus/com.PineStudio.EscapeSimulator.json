25/65396729_1225052078868354_6945820870147360559_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I30-S7gOstQQ7kNvwGGa3Hl&_nc_oc=AdpmuED3Z1Wx3P-FSP7ylNblSAmz499B1t2d_zXahegUi2TDVq8HdDvko6vU1xvDQTc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAXuVUP09t8k0QeTC4IRZdbEtEgND0G-cj34ki1wSvoFw&oe=6A5F781E"}, {"file_name": "4.png", "id": "975198817093493", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/57566693_975198820426826_7097624739394196541_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cj70ZZz7RYsQ7kNvwE3-XzK&_nc_oc=Adq_v2DMO_szDOqWfRZv2lj7AeqZPPMjWF6V75hZ0o7EcUbT4VXeWO0R3vMi85CID3U&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC9kc23HHcUVuPzqSl-C_VwnqiQKWs5SXHdf2SAnU8rpg&oe=6A5F79CC"}, {"file_name": "1.png", "id": "415893571368646", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39001715_415893574701979_3461447245540982035_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Wl4mHKTN4WUQ7kNvwGZFpAM&_nc_oc=AdqfBjvTj7Yzx-UCHydcdU4HIu1HND3qLj7Os_-TJVheiXb5StPT1sTW6rHgnHdFkyg&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAG9NFIIhtqx_C7YUiV4LqetrJQX72ToPiI_ci8OzL-tA&oe=6A5F5CD6"}, {"file_name": "3.png", "id": "662596896051796", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974523_662596899385129_8527079563659693432_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H1i9TdleM6QQ7kNvwGTLs4-&_nc_oc=Adq-unh4XqvdVJLJu8sE3ujpjz7QB3G3Pihof_x9hDP07wKUgSDiWehP8tNO6i9lcrY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDv6UDMuBONOHKkOgIpABUkBaX7Wz4EUPqFNCJD7eG-GQ&oe=6A5F5B54"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "gameplayVR3.png", "id": "492345567046352", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974804_492345570379685_6511341930176300148_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BzarmP297-IQ7kNvwEBzB3N&_nc_oc=AdqCDGDmJYhkeDtz8zC9vDlto4yv0NFtm6BNczLn5TDZC8t8sIe9LcENyZ9OM83Eb58&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAk-0V5NQu0CGiyF9-347LR5-3LeEK9y6hXPy8YN6EVxw&oe=6A5F66AD"}, "display_name": "Escape Simulator", "keywords": ["escape", "room", "coop", "multiplayer", "simulator"], "long_description": "Escape Simulator is a first-person puzzler you can **play solo or in an online co-op** (best with 2-3 players, but playable with up to 8!). Explore a growing set of **highly interactive escape rooms**. Pick up and examine everything, break objects, solve locks, and decipher puzzles to escape! After finishing the main game, watch for free content updates and explore rooms **built by our awesome community**.\n\n# \u2b50**REVIEWS** \n\"What I've seen has left me considerably impressed.\" - UploadVR\n\n# \u2692\ufe0f**COMMUNITY-MADE ROOMS**\nAfter finishing the main game **explore numerous rooms** built by our amazing community.\n\n# \ud83e\udd1d**ONLINE CO-OP**\nAll rooms are playable in an online co-op. Play with up to 8 players (best played with 2-3). Customize your character and join friends to solve puzzles together. More heads are better than one!\n\n# \ud83e\udde9**INTERACTIVE PUZZLES**\nExplore 28+ official rooms filled with puzzles designed by real-life escape room operators. If it\u2019s not nailed down, you can pick it up.\n\n# \ud83d\udd0d**EXEMINE EVERYTHING**\nRead books, examine ancient artifacts, and find clues to riddles. Need to cross-reference a clue? No problem - just pin it!\n\n# \ud83c\udfc6**WANT MORE?**\nThe game features additional content in the form of Addons with 4 large rooms each: \n- **Steampunk**: Solve four new rooms on the beautiful steampunk airship \"Valor.\"\n- **Wild West**: Become an outlaw in the Wild West.\n- **Magic**: Embrace your magic potential, and follow in the footsteps of great witches and wizards. \n\n", "short_description": "First-person puzzler you can play solo or in an online co-op. Explore a set of highly interactive escape rooms. Move furniture, pick up and examine everything, smash pots and break
5/65396729_1225052078868354_6945820870147360559_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yKg9YspdQTkQ7kNvwEgNvGc&_nc_oc=AdpLTcDMEeh4z9d-akysfdtv-fMyP1KKaDTThGRFjLOU74PlDziOgpBhUzsuLvCy8z4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9Fww-hUxMWMdJQZdJDeo1ubGVAJKBXN-o-06iHDn8eEg&oe=6A3E829E"}, {"file_name": "4.png", "id": "975198817093493", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/57566693_975198820426826_7097624739394196541_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dTE1DoDof4QQ7kNvwEsNW_2&_nc_oc=AdrcmVmHk7mKJVZSCjeQsakDT8NG95gA1DsCF7ih-xlWq_MQ3GIv8bLn-BOzb9pMG_0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8swfc_9LZzoCc6LZ2LXrZ62DSSGO9nwkCnl9YuauHnpA&oe=6A3E844C"}, {"file_name": "1.png", "id": "415893571368646", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39001715_415893574701979_3461447245540982035_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FRqW7HrcuhsQ7kNvwHe0JEc&_nc_oc=AdoD16eskMwKfdxu6xSMvfqfhELQj32kQxxJ_Wyb-zwWEoe83DRh5QQZkECeiN4biJo&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_XSCnGqwRmwvrI8A9alm44rCcnLz2arWH4aJKYnT1yMA&oe=6A3E9F96"}, {"file_name": "3.png", "id": "662596896051796", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974523_662596899385129_8527079563659693432_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Xzz_-e-QddsQ7kNvwEcySbR&_nc_oc=Adq3WMjmke7hW_g-iw_Px5wCBbuBXt_iMch3UokdyqvuCA113656-53eKf54MqKi-ds&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af86YectYojF8A1D6OcHV_XAo-vT63ud1FNI50lATQwpDA&oe=6A3E9E14"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "gameplayVR3.png", "id": "492345567046352", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974804_492345570379685_6511341930176300148_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d7-LqWKay_sQ7kNvwEDoISw&_nc_oc=AdriYJo0QkJfU9cfBS1cmxljElNArTrwJ0iHtXJliB4KwqTmu3fwatGNrZWLMpdQCeQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_4DpV0OlKKMe12__rZX9LFsG8IslJR90DnCdrAtVkhuQ&oe=6A3EA96D"}, "display_name": "Escape Simulator", "keywords": ["escape", "room", "coop", "multiplayer", "simulator"], "long_description": "Escape Simulator is a first-person puzzler you can **play solo or in an online co-op** (best with 2-3 players, but playable with up to 8!). Explore a growing set of **highly interactive escape rooms**. Pick up and examine everything, break objects, solve locks, and decipher puzzles to escape! After finishing the main game, watch for free content updates and explore rooms **built by our awesome community**.\n\n# \u2b50**REVIEWS** \n\"What I've seen has left me considerably impressed.\" - UploadVR\n\n# \u2692\ufe0f**COMMUNITY-MADE ROOMS**\nAfter finishing the main game **explore numerous rooms** built by our amazing community.\n\n# \ud83e\udd1d**ONLINE CO-OP**\nAll rooms are playable in an online co-op. Play with up to 8 players (best played with 2-3). Customize your character and join friends to solve puzzles together. More heads are better than one!\n\n# \ud83e\udde9**INTERACTIVE PUZZLES**\nExplore 28+ official rooms filled with puzzles designed by real-life escape room operators. If it\u2019s not nailed down, you can pick it up.\n\n# \ud83d\udd0d**EXEMINE EVERYTHING**\nRead books, examine ancient artifacts, and find clues to riddles. Need to cross-reference a clue? No problem - just pin it!\n\n# \ud83c\udfc6**WANT MORE?**\nThe game features additional content in the form of Addons with 4 large rooms each: \n- **Steampunk**: Solve four new rooms on the beautiful steampunk airship \"Valor.\"\n- **Wild West**: Become an outlaw in the Wild West.\n- **Magic**: Embrace your magic potential, and follow in the footsteps of great witches and wizards. \n\n", "short_description": "First-person puzzler you can play solo or in an online co-op. Explore a set of highly interactive escape rooms. Move furniture, pick up and examine everything, smash pots and break 
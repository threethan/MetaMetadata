5/65396729_1225052078868354_6945820870147360559_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ew-WircmkkwQ7kNvwFVshih&_nc_oc=AdorwEdrQ69zOmH64797a66SrTQMxFWmMcLKvsdnH2Sr8F3x9FBTI5EbXjOhny613Fc&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5jWWToUF0ZjfLLyPcySTG_0nQe7DG0QxOP2m37XkTNrg&oe=6A13011E"}, {"file_name": "4.png", "id": "975198817093493", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/57566693_975198820426826_7097624739394196541_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rcS1ZOcEThgQ7kNvwHwtL8S&_nc_oc=Adri-csGLJaQst7EZuXUn72SE1r3jcavjxHJ-urXepYeF3DX5ms9R0ao98Rpx7SBTg0&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5hOnHdTBvBQXP4P1drt2JCuJLiVy0vVG5JuLLoT4gW9w&oe=6A1302CC"}, {"file_name": "1.png", "id": "415893571368646", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/39001715_415893574701979_3461447245540982035_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2If3RRRu8X8Q7kNvwEO5ZPT&_nc_oc=AdoktckZFL5EcNkUw__P_N-SxUDRbN6o4Dz-bTIz39J7B_yET5Xrr9xfbDbHBzDsimI&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7IWUifppMFnsnMt7S3-gfrppy9nwH1WyOA99ggw-616Q&oe=6A131E16"}, {"file_name": "3.png", "id": "662596896051796", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38974523_662596899385129_8527079563659693432_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4my6Z0loxIMQ7kNvwEOc-oY&_nc_oc=AdryYSp0fPurdo9jqL43n-KtktA-n4RUgAr8_GvmktBptYRcD3Wk8FblSTMHhKV26ow&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4XVky5I1e6KEAUuGebA9tyfIFWfdIgLt8iAsjPhPyr3g&oe=6A131C94"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "gameplayVR3.png", "id": "492345567046352", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38974804_492345570379685_6511341930176300148_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e1A4AT1p3W0Q7kNvwF1aL9r&_nc_oc=AdqPw_0fEfSKxae8hAqC-i-vlQp7Qe8Mu-jQ4rnOAJJEAsor6EZwZC7GKbkfI5jFjew&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7pI07lQSgRJoIK98QdDjQI9iK3-ECFmOM-OM6KiRbd5Q&oe=6A12EFAD"}, "display_name": "Escape Simulator", "keywords": ["escape", "room", "coop", "multiplayer", "simulator"], "long_description": "Escape Simulator is a first-person puzzler you can **play solo or in an online co-op** (best with 2-3 players, but playable with up to 8!). Explore a growing set of **highly interactive escape rooms**. Pick up and examine everything, break objects, solve locks, and decipher puzzles to escape! After finishing the main game, watch for free content updates and explore rooms **built by our awesome community**.\n\n# \u2b50**REVIEWS** \n\"What I've seen has left me considerably impressed.\" - UploadVR\n\n# \u2692\ufe0f**COMMUNITY-MADE ROOMS**\nAfter finishing the main game **explore numerous rooms** built by our amazing community.\n\n# \ud83e\udd1d**ONLINE CO-OP**\nAll rooms are playable in an online co-op. Play with up to 8 players (best played with 2-3). Customize your character and join friends to solve puzzles together. More heads are better than one!\n\n# \ud83e\udde9**INTERACTIVE PUZZLES**\nExplore 28+ official rooms filled with puzzles designed by real-life escape room operators. If it\u2019s not nailed down, you can pick it up.\n\n# \ud83d\udd0d**EXEMINE EVERYTHING**\nRead books, examine ancient artifacts, and find clues to riddles. Need to cross-reference a clue? No problem - just pin it!\n\n# \ud83c\udfc6**WANT MORE?**\nThe game features additional content in the form of Addons with 4 large rooms each: \n- **Steampunk**: Solve four new rooms on the beautiful steampunk airship \"Valor.\"\n- **Wild West**: Become an outlaw in the Wild West.\n- **Magic**: Embrace your magic potential, and follow in the footsteps of great witches and wizards. \n\n", "short_description": "First-person puzzler you can play solo or in an online co-op. Explore a set of highly interactive escape rooms. Move furniture, pick up and examine everything, smash pots and break 
5/65396729_1225052078868354_6945820870147360559_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qrxVG3xvi0gQ7kNvwGaHusr&_nc_oc=Adrh5g2jBSQooP59p9Ky34orF8EBgrdAqn7mwkGYTKrtx3uJgK73VfnMcHzDCO9-BOA&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6xr0hGW5kxWwBcYlhPu-sEgSpsmofvpATIfW9IPukwig&oe=6A1AEA1E"}, {"file_name": "4.png", "id": "975198817093493", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/57566693_975198820426826_7097624739394196541_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Q9Qy6p8ibkUQ7kNvwGXruPm&_nc_oc=Adoqz2MxcmLgwhERENDaAYHUq3EgCoJ8iFE6BjxlhKvNLvvIy0gCWq1m5Mwi2vdb_MA&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7T8m40xFoi2_ZG77xuVx7t5dfIZ_w0y6-ERUwDxXE6VQ&oe=6A1AEBCC"}, {"file_name": "1.png", "id": "415893571368646", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/39001715_415893574701979_3461447245540982035_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5l-Bln4YZsAQ7kNvwETz2M5&_nc_oc=AdrvkXRuxrwxU03T0rdxdTZKH_PHNz8phXtPar9NIlKW5N13spFbqpEmHZGtxK_4Wu4&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4c09Epfj--5OVKViWZPnwuw9vKYtBGp3BpVARSGbE0sA&oe=6A1B0716"}, {"file_name": "3.png", "id": "662596896051796", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38974523_662596899385129_8527079563659693432_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BC3hHnZQmW4Q7kNvwGNARmv&_nc_oc=Ado1IXky6d0ZZOEN7SbyThY1ypYEtwxN_lUI_XWaZMhOepoG-PkXxc83q_2beuyisZc&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af518pM03IHsbJlFw_VN4AUkMtK69G0h671wkAHoC9GV7w&oe=6A1B0594"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "gameplayVR3.png", "id": "492345567046352", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/38974804_492345570379685_6511341930176300148_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XOvuQuFox_cQ7kNvwHZfpRQ&_nc_oc=Ado8rTDP_8bnc4ZxUw2U2ATugn_xIYR8EoNhp6hy9QwCZYBtmlUZXGRQpwiuvTbJkyU&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6UBQd70TNpK4HdbxUls9RgQCAj9nJHbqkJ7ECEx0WP0g&oe=6A1AD8AD"}, "display_name": "Escape Simulator", "keywords": ["escape", "room", "coop", "multiplayer", "simulator"], "long_description": "Escape Simulator is a first-person puzzler you can **play solo or in an online co-op** (best with 2-3 players, but playable with up to 8!). Explore a growing set of **highly interactive escape rooms**. Pick up and examine everything, break objects, solve locks, and decipher puzzles to escape! After finishing the main game, watch for free content updates and explore rooms **built by our awesome community**.\n\n# \u2b50**REVIEWS** \n\"What I've seen has left me considerably impressed.\" - UploadVR\n\n# \u2692\ufe0f**COMMUNITY-MADE ROOMS**\nAfter finishing the main game **explore numerous rooms** built by our amazing community.\n\n# \ud83e\udd1d**ONLINE CO-OP**\nAll rooms are playable in an online co-op. Play with up to 8 players (best played with 2-3). Customize your character and join friends to solve puzzles together. More heads are better than one!\n\n# \ud83e\udde9**INTERACTIVE PUZZLES**\nExplore 28+ official rooms filled with puzzles designed by real-life escape room operators. If it\u2019s not nailed down, you can pick it up.\n\n# \ud83d\udd0d**EXEMINE EVERYTHING**\nRead books, examine ancient artifacts, and find clues to riddles. Need to cross-reference a clue? No problem - just pin it!\n\n# \ud83c\udfc6**WANT MORE?**\nThe game features additional content in the form of Addons with 4 large rooms each: \n- **Steampunk**: Solve four new rooms on the beautiful steampunk airship \"Valor.\"\n- **Wild West**: Become an outlaw in the Wild West.\n- **Magic**: Embrace your magic potential, and follow in the footsteps of great witches and wizards. \n\n", "short_description": "First-person puzzler you can play solo or in an online co-op. Explore a set of highly interactive escape rooms. Move furniture, pick up and examine everything, smash pots and break 
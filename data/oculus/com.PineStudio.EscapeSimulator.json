r11-1.oculuscdn.com/v/t64.5771-25/65396729_1225052078868354_6945820870147360559_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=93dBHJTEFJcQ7kNvwEAAFqh&_nc_oc=Adq-IZAd-Dg1QImcYEYD3iD34Gs6T4vXgiUakHsdlfmftAx1fAb46198C3wEv2ewHN4&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHsMDHdAuVS5mKQknGrWoZAjpf4JH1e_Aq9MiltUJdFpw&oe=6A8EEE1E"}, {"file_name": "4.png", "id": "975198817093493", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/57566693_975198820426826_7097624739394196541_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a1ER9b6qwYMQ7kNvwEqt4v-&_nc_oc=AdrRE3Dn7JDSA7xdzoie0Ajmc6rrGdCgZXm-8BkqY3LEtAOjWrJRUgSLACZoQc1BB4s&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEdebTz9ZJn_mSwx8P6xJmQKuJYm8vWYPRJC7vU9SaNLg&oe=6A8EEFCC"}, {"file_name": "1.png", "id": "415893571368646", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/39001715_415893574701979_3461447245540982035_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NYxK6f2r-L4Q7kNvwE2ON0V&_nc_oc=AdqrlfRS5do3NXOBTMsif2YN0P3q8RZ5Fcn1MvnGG7hd9pRus_6TKHJ0Yjk4l_pS4XM&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGNx7nsKJ6kRRxzYjh55fV_eOORO9oJZVArVAL6kbl_QQ&oe=6A8ED2D6"}, {"file_name": "3.png", "id": "662596896051796", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/38974523_662596899385129_8527079563659693432_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZONUBhnxB4AQ7kNvwHSH9OH&_nc_oc=Adrp9jhPvcUJNTCG4-SkduD5JYVUNvw1AuIpGR104xukywoWRutzmQUu8W9SzoPmtiY&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFnDd6mndNAfPtld44NhS2c7IgHCXN3Zkc0Elj6OJtkCw&oe=6A8ED154"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "gameplayVR3.png", "id": "492345567046352", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/38974804_492345570379685_6511341930176300148_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6gGQNY0XSwAQ7kNvwFAv1Aq&_nc_oc=AdrcLOkyrmqRKgfCLLtxgOJaTkEF0KS1qz6ae8fZ-4_2q9AxaaYfpuIljYPBYBmVvUs&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGIgFEzZwZXYBQLkcfw8Ea5_MN97zSKxqNHo3f1Tj1z8g&oe=6A8EDCAD"}, "display_name": "Escape Simulator", "keywords": ["escape", "room", "coop", "multiplayer", "simulator"], "long_description": "Escape Simulator is a first-person puzzler you can **play solo or in an online co-op** (best with 2-3 players, but playable with up to 8!). Explore a growing set of **highly interactive escape rooms**. Pick up and examine everything, break objects, solve locks, and decipher puzzles to escape! After finishing the main game, watch for free content updates and explore rooms **built by our awesome community**.\n\n# \u2b50**REVIEWS** \n\"What I've seen has left me considerably impressed.\" - UploadVR\n\n# \u2692\ufe0f**COMMUNITY-MADE ROOMS**\nAfter finishing the main game **explore numerous rooms** built by our amazing community.\n\n# \ud83e\udd1d**ONLINE CO-OP**\nAll rooms are playable in an online co-op. Play with up to 8 players (best played with 2-3). Customize your character and join friends to solve puzzles together. More heads are better than one!\n\n# \ud83e\udde9**INTERACTIVE PUZZLES**\nExplore 28+ official rooms filled with puzzles designed by real-life escape room operators. If it\u2019s not nailed down, you can pick it up.\n\n# \ud83d\udd0d**EXEMINE EVERYTHING**\nRead books, examine ancient artifacts, and find clues to riddles. Need to cross-reference a clue? No problem - just pin it!\n\n# \ud83c\udfc6**WANT MORE?**\nThe game features additional content in the form of Addons with 4 large rooms each: \n- **Steampunk**: Solve four new rooms on the beautiful steampunk airship \"Valor.\"\n- **Wild West**: Become an outlaw in the Wild West.\n- **Magic**: Embrace your magic potential, and follow in the footsteps of great witches and wizards. \n\n", "short_description": "First-person puzzler you can play solo or in an online co-op. Explore a set of highly interactive escape rooms. Move furniture, pick up and exam
25/65396729_1225052078868354_6945820870147360559_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=93dBHJTEFJcQ7kNvwHJVfZk&_nc_oc=AdqX9ofIeltwuIl5hLXbAtiTltvTpCYGwvUu3QjVZ4ADxXdpFJU-jnR1pltzwBZ26Ws&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGFr7JyJucchQlFzlTtDIWO1DKYjQv6J32L5lbJDSIwDQ&oe=6A903F9E"}, {"file_name": "4.png", "id": "975198817093493", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/57566693_975198820426826_7097624739394196541_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a1ER9b6qwYMQ7kNvwFT415R&_nc_oc=Adr010NmCKMCz76Avm05GKrNWZSR_s7r3h1jVoVtxi3R8bMcT8H8l2FIGAvVa_TjgwA&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFi81hW-sVL7bCp9xAwk8yPGJiI9Ex7hElQSoO7yDXilw&oe=6A90090C"}, {"file_name": "1.png", "id": "415893571368646", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39001715_415893574701979_3461447245540982035_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NYxK6f2r-L4Q7kNvwGK0Dfl&_nc_oc=AdpgHRPd_c3GoNoTjV-IM4G1VDHrEAocXc3EWDCAmjm67Gpe71M1r1oC6eL9ciZlJ_0&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHGLuRvHSY0bnPqbS1ZWZSGVDz6egUjqiunl4PI_3K2hA&oe=6A902456"}, {"file_name": "3.png", "id": "662596896051796", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38974523_662596899385129_8527079563659693432_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZONUBhnxB4AQ7kNvwEksNQk&_nc_oc=AdryLsgaUfrzGLUssg5BP8jFfndZmvRmLvLUJks0s0Kw_btLUhAgZe9SnDygII3s8tc&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFYGLzZzHYL3lxP9DQzxEti4XYUJFY8FWJGJ7L2CMTC5w&oe=6A9022D4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "gameplayVR3.png", "id": "492345567046352", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38974804_492345570379685_6511341930176300148_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6gGQNY0XSwAQ7kNvwHtODNh&_nc_oc=AdqvPil8wm5WThAMYKIPa8h706A77JDezM_QFkD0WBYSwJnFEbtFL7l88rnXMu3U378&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHmI-PlBMRc9lNZGpJ0Aj9E2xk4XvJnnWxa-9YfMuNh2g&oe=6A902E2D"}, "display_name": "Escape Simulator", "keywords": ["escape", "room", "coop", "multiplayer", "simulator"], "long_description": "Escape Simulator is a first-person puzzler you can **play solo or in an online co-op** (best with 2-3 players, but playable with up to 8!). Explore a growing set of **highly interactive escape rooms**. Pick up and examine everything, break objects, solve locks, and decipher puzzles to escape! After finishing the main game, watch for free content updates and explore rooms **built by our awesome community**.\n\n# \u2b50**REVIEWS** \n\"What I've seen has left me considerably impressed.\" - UploadVR\n\n# \u2692\ufe0f**COMMUNITY-MADE ROOMS**\nAfter finishing the main game **explore numerous rooms** built by our amazing community.\n\n# \ud83e\udd1d**ONLINE CO-OP**\nAll rooms are playable in an online co-op. Play with up to 8 players (best played with 2-3). Customize your character and join friends to solve puzzles together. More heads are better than one!\n\n# \ud83e\udde9**INTERACTIVE PUZZLES**\nExplore 28+ official rooms filled with puzzles designed by real-life escape room operators. If it\u2019s not nailed down, you can pick it up.\n\n# \ud83d\udd0d**EXEMINE EVERYTHING**\nRead books, examine ancient artifacts, and find clues to riddles. Need to cross-reference a clue? No problem - just pin it!\n\n# \ud83c\udfc6**WANT MORE?**\nThe game features additional content in the form of Addons with 4 large rooms each: \n- **Steampunk**: Solve four new rooms on the beautiful steampunk airship \"Valor.\"\n- **Wild West**: Become an outlaw in the Wild West.\n- **Magic**: Embrace your magic potential, and follow in the footsteps of great witches and wizards. \n\n", "short_description": "First-person puzzler you can play solo or in an online co-op. Explore a set of highly interactive escape rooms. Move furniture, pick up and examine everything, smash pots and break
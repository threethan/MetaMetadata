25/65396729_1225052078868354_6945820870147360559_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SGlP3Z5jiQMQ7kNvwHH9PaY&_nc_oc=AdpylJuoHPvmlcZGtgy5VPLknTcg29Qo7bDdKp3EemOKgi7QbHli68tv2DrVi_rX1Hc&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGpS8ByUrXicLr_hqgI16brYSKQ4kOkFRl88BltAPZU0w&oe=6A97479E"}, {"file_name": "4.png", "id": "975198817093493", "uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/57566693_975198820426826_7097624739394196541_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RkPBYhp5rFIQ7kNvwHk1mp9&_nc_oc=Adqs_naMtPnBVAYhlswf24CnaIuyViO-pDrl16YEf58TPmGLmdE0SKUPZE2JL7QpCEU&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGmSfgyxs41Nk8wKYoWsuWw8iyaCOsMwRsGjGl0HGkXGg&oe=6A97494C"}, {"file_name": "1.png", "id": "415893571368646", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/39001715_415893574701979_3461447245540982035_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YwoPph-iya0Q7kNvwGE_a6L&_nc_oc=AdrMHfwKe_0LcekcLBP9FP7NS55bLGu2ZEdfJh8yOr87J-5lALJ6h37RaS9Q2AMUfig&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGhoBu0nvA5kMo9P2v66AYRmdqHwKWi90vMPNjM-4ayAg&oe=6A972C56"}, {"file_name": "3.png", "id": "662596896051796", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/38974523_662596899385129_8527079563659693432_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6P7hkPpC3rkQ7kNvwHHuQLw&_nc_oc=Adp_8v_XAQVe1IanVMbXTnoY1-In1pBXAuHIcg6m8ZTKl9TShrkJqsOGWfy3NV4v_bE&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGLEPcCTIFwDe62FnjGMNP_q_YhMOOrg6vXdoX1lRaWvA&oe=6A972AD4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "gameplayVR3.png", "id": "492345567046352", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/38974804_492345570379685_6511341930176300148_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ecXdthgVUZQQ7kNvwEBamMD&_nc_oc=Adpi1XixdtL71QNW_g4LpWs8rqJ5sfuTti5u7RRk5hnc6nEqvzCwrBBEuoxY6SMz-Do&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE4E_oiS5XFxZTmzT2WoiK5YfgIUT4EGG0cAz9sbAFnCw&oe=6A97362D"}, "display_name": "Escape Simulator", "keywords": ["escape", "room", "coop", "multiplayer", "simulator"], "long_description": "Escape Simulator is a first-person puzzler you can **play solo or in an online co-op** (best with 2-3 players, but playable with up to 8!). Explore a growing set of **highly interactive escape rooms**. Pick up and examine everything, break objects, solve locks, and decipher puzzles to escape! After finishing the main game, watch for free content updates and explore rooms **built by our awesome community**.\n\n# \u2b50**REVIEWS** \n\"What I've seen has left me considerably impressed.\" - UploadVR\n\n# \u2692\ufe0f**COMMUNITY-MADE ROOMS**\nAfter finishing the main game **explore numerous rooms** built by our amazing community.\n\n# \ud83e\udd1d**ONLINE CO-OP**\nAll rooms are playable in an online co-op. Play with up to 8 players (best played with 2-3). Customize your character and join friends to solve puzzles together. More heads are better than one!\n\n# \ud83e\udde9**INTERACTIVE PUZZLES**\nExplore 28+ official rooms filled with puzzles designed by real-life escape room operators. If it\u2019s not nailed down, you can pick it up.\n\n# \ud83d\udd0d**EXEMINE EVERYTHING**\nRead books, examine ancient artifacts, and find clues to riddles. Need to cross-reference a clue? No problem - just pin it!\n\n# \ud83c\udfc6**WANT MORE?**\nThe game features additional content in the form of Addons with 4 large rooms each: \n- **Steampunk**: Solve four new rooms on the beautiful steampunk airship \"Valor.\"\n- **Wild West**: Become an outlaw in the Wild West.\n- **Magic**: Embrace your magic potential, and follow in the footsteps of great witches and wizards. \n\n", "short_description": "First-person puzzler you can play solo or in an online co-op. Explore a set of highly interactive escape rooms. Move furniture, pick up and examine everything, smash pots and break
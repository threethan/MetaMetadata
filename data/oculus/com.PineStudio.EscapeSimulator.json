t1hTo5JQelye0durfqB7WAQPv_BnLzNqH2Zlxy4&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1FOy-4_myMKRlq19HvZeLph66SCbJ4RIydEOMC_V3zpg&oe=69F20B9E"}, {"file_name": "4.png", "id": "975198817093493", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/57566693_975198820426826_7097624739394196541_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ByJ-UAutpKIQ7kNvwH-JzaL&_nc_oc=AdpcWBlcMFTCjPDPjr9uoM-2oSXDHAdwDVQk_I_JG6IYXyrQiI9G_ZDnOd6CM4Di5e8&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&oh=00_Af1h7gGKNWCEM4IR1fOvf4AJqkGe2Wup--f5hnck__m5LQ&oe=69F20D4C"}, {"file_name": "1.png", "id": "415893571368646", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39001715_415893574701979_3461447245540982035_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b3wQy_FsPTEQ7kNvwEzKTFI&_nc_oc=AdrS45uSTInplsVl07vTIGD-40b7-J2K_ojxFI_PUyl5cW8aBsw5RizCyleI16zmwjQ&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_Af1uHZJZH6C_Cgr1MQqIT2ASCouF-usRdz7O5AIbJpEXkQ&oe=69F1F056"}, {"file_name": "3.png", "id": "662596896051796", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974523_662596899385129_8527079563659693432_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4fNLDEaSKzUQ7kNvwE1me0b&_nc_oc=Adru_o8J9uiPHmTlgHc3mOrsxX5uvtLUaRkFFxSNTLecJGvNRoEhuT7GsmzQMEb69Ao&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_Af2Zu5bJh2_4JY8r6lrNvQE9Op6HOZsM--MDeReDJ3K0Lw&oe=69F1EED4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "gameplayVR3.png", "id": "492345567046352", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974804_492345570379685_6511341930176300148_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uhYOPKcxluAQ7kNvwGKX_p7&_nc_oc=AdrgltS7FzfDk9edkDRvtfD9faFczNm84fQKn93MtpP7BURQaIFI67j5B1FKQC0j6KI&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0VM7kff83Huj7wEPVPX3TfP0R9Irvd0VaBB84APL98NQ&oe=69F1FA2D"}, "display_name": "Escape Simulator", "keywords": ["escape", "room", "coop", "multiplayer", "simulator"], "long_description": "Escape Simulator is a first-person puzzler you can **play solo or in an online co-op** (best with 2-3 players, but playable with up to 8!). Explore a growing set of **highly interactive escape rooms**. Pick up and examine everything, break objects, solve locks, and decipher puzzles to escape! After finishing the main game, watch for free content updates and explore rooms **built by our awesome community**.\n\n# \u2b50**REVIEWS** \n\"What I've seen has left me considerably impressed.\" - UploadVR\n\n# \u2692\ufe0f**COMMUNITY-MADE ROOMS**\nAfter finishing the main game **explore numerous rooms** built by our amazing community.\n\n# \ud83e\udd1d**ONLINE CO-OP**\nAll rooms are playable in an online co-op. Play with up to 8 players (best played with 2-3). Customize your character and join friends to solve puzzles together. More heads are better than one!\n\n# \ud83e\udde9**INTERACTIVE PUZZLES**\nExplore 28+ official rooms filled with puzzles designed by real-life escape room operators. If it\u2019s not nailed down, you can pick it up.\n\n# \ud83d\udd0d**EXEMINE EVERYTHING**\nRead books, examine ancient artifacts, and find clues to riddles. Need to cross-reference a clue? No problem - just pin it!\n\n# \ud83c\udfc6**WANT MORE?**\nThe game features additional content in the form of Addons with 4 large rooms each: \n- **Steampunk**: Solve four new rooms on the beautiful steampunk airship \"Valor.\"\n- **Wild West**: Become an outlaw in the Wild West.\n- **Magic**: Embrace your magic potential, and follow in the footsteps of great witches and wizards. \n\n", "short_description": "First-person puzzler you can play solo or in an online co-op. Explore a set of highly interactive escape rooms. Move furniture, pick up and examine everything, smash pots and break locks! Supports community rooms through the level editor."}]}, "developer_name": null, "developer_privacy_policy_url": "https://pinestudio.com/privacy-policy/", "developer_terms_of_service_url": 
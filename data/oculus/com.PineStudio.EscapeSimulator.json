5/65396729_1225052078868354_6945820870147360559_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o1L7AOWUEwwQ7kNvwHuWXmJ&_nc_oc=Adq91VIhC4P7lOL-d2uxLH-W4rtfpnKq-jFVGYcrXUYahdFcFg_Omsx80pmKu54DmcA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af049lfGB0nRyqNP-yMhPAqb0tgkfbiNtb5Pw_8fE1KfQQ&oe=69EE171E"}, {"file_name": "4.png", "id": "975198817093493", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/57566693_975198820426826_7097624739394196541_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qIQTXWtblH8Q7kNvwHb90DD&_nc_oc=AdoY-1PlK7Vy1ShfTTsP5Wac4F2VkAITIbsyvRAL1u6cdWk4DM_mSerQR8Ymj0vOSWA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af20VvGXWDFt8cT8uRXCHSKUESzh0KzaVmykVt47CR8qQQ&oe=69EE18CC"}, {"file_name": "1.png", "id": "415893571368646", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39001715_415893574701979_3461447245540982035_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J8ky8JlSyxsQ7kNvwGwe811&_nc_oc=AdqfSx2YONfZD3ndmKJzqxha5IJwzWwteYpDVhqKEOuVu8MDD6RfMa-qEMp29KurOjE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af15dNmFT_Pa-_frwmYCWd1pAYvRPgCtWL8ej1u2JNGrYw&oe=69EDFBD6"}, {"file_name": "3.png", "id": "662596896051796", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974523_662596899385129_8527079563659693432_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W-8JGXZETeUQ7kNvwEutsst&_nc_oc=Adoa4gq2B1LrTkgoPNmMHBN65119nwzNTz_0z5BQHeZyrs279e9_eXX8u2RyH7U9RL8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3s6tYfirSQZ4ymuJyogQ_HETaJkgF1takQnEgEb-pAXQ&oe=69EDFA54"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "gameplayVR3.png", "id": "492345567046352", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974804_492345570379685_6511341930176300148_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Hk9W0WDfWe0Q7kNvwGKHwSh&_nc_oc=AdoDaF3OMoHOTiz07hvzRad0p_5JSNvToxFUE-TFXqqJaGpZ8FADc7hApfeGQrhalC0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af21IAL-3k52yuxQDZ6giaJw3dW1Y-JM7HditkXxtjaYqQ&oe=69EE05AD"}, "display_name": "Escape Simulator", "keywords": ["escape", "room", "coop", "multiplayer", "simulator"], "long_description": "Escape Simulator is a first-person puzzler you can **play solo or in an online co-op** (best with 2-3 players, but playable with up to 8!). Explore a growing set of **highly interactive escape rooms**. Pick up and examine everything, break objects, solve locks, and decipher puzzles to escape! After finishing the main game, watch for free content updates and explore rooms **built by our awesome community**.\n\n# \u2b50**REVIEWS** \n\"What I've seen has left me considerably impressed.\" - UploadVR\n\n# \u2692\ufe0f**COMMUNITY-MADE ROOMS**\nAfter finishing the main game **explore numerous rooms** built by our amazing community.\n\n# \ud83e\udd1d**ONLINE CO-OP**\nAll rooms are playable in an online co-op. Play with up to 8 players (best played with 2-3). Customize your character and join friends to solve puzzles together. More heads are better than one!\n\n# \ud83e\udde9**INTERACTIVE PUZZLES**\nExplore 28+ official rooms filled with puzzles designed by real-life escape room operators. If it\u2019s not nailed down, you can pick it up.\n\n# \ud83d\udd0d**EXEMINE EVERYTHING**\nRead books, examine ancient artifacts, and find clues to riddles. Need to cross-reference a clue? No problem - just pin it!\n\n# \ud83c\udfc6**WANT MORE?**\nThe game features additional content in the form of Addons with 4 large rooms each: \n- **Steampunk**: Solve four new rooms on the beautiful steampunk airship \"Valor.\"\n- **Wild West**: Become an outlaw in the Wild West.\n- **Magic**: Embrace your magic potential, and follow in the footsteps of great witches and wizards. \n\n", "short_description": "First-person puzzler you can play solo or in an online co-op. Explore a set of highly interactive escape rooms. Move furniture, pick up and examine everything, smash pots and break 
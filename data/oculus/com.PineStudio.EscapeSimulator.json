25/65396729_1225052078868354_6945820870147360559_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ptBl5Du-WCYQ7kNvwE_G4hS&_nc_oc=AdoDUVQXcd1KOSYY890fi32UEloSaw6_ElnJqkWG0duLFxB5GKItF8H-U2gaJd2hE40&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ0pSnULZEsTAkoQ6CjYGo-wLTZmp6AL3Jf1qTlbytTig&oe=6AE7429E"}, {"file_name": "4.png", "id": "975198817093493", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/57566693_975198820426826_7097624739394196541_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hi2buzqZ8rIQ7kNvwGUUBTr&_nc_oc=AdplhbHyDYHbR5boI9rGF7RTsVjaq_OVz8B0kRaVsVYsCAlXqva8MlQvZw4vjSI8VDk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRT_TB8Lwl35AMMxXqsEihF2ntUrUjL_JcvyIKsPIzd6w&oe=6AE7444C"}, {"file_name": "1.png", "id": "415893571368646", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39001715_415893574701979_3461447245540982035_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8jmaB4BF3XQQ7kNvwGPaoPz&_nc_oc=AdpViYjJ8fzQWkp_VK9JhykEwIeFij7F0mNy7WvWgy8tNo7egIVlI2gGserycGB9mVY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT7PxfvQlp-2uVTzc1WSD59JCUigf5cPNMnoBFu1F3I-A&oe=6AE75F96"}, {"file_name": "3.png", "id": "662596896051796", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974523_662596899385129_8527079563659693432_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c-KJZT2BW8kQ7kNvwFo8HEQ&_nc_oc=Adp7OvlfjI7YbbbpIA0UQSL63-1bB3WZeGJP7Aiux2SVZ7gQybIAFe55PKdkYdx65gE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRPmv1k4igdEM9Ef451uNatQ2iDNCC3wE8kq1_oKHlbEA&oe=6AE75E14"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "gameplayVR3.png", "id": "492345567046352", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974804_492345570379685_6511341930176300148_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DL5t8mBQNAUQ7kNvwEiSk36&_nc_oc=AdpW48Rj9Rjro1WjZn-7E0zkq-Yxhyho-pfc-ohZ1zD0D_30hSotdi69dk_mR1jKEE8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRWCTc6qKf7dMT4hYFr31x9RFhIm1XblqJXyapthnF8BA&oe=6AE7696D"}, "display_name": "Escape Simulator", "keywords": ["escape", "room", "coop", "multiplayer", "simulator"], "long_description": "Escape Simulator is a first-person puzzler you can **play solo or in an online co-op** (best with 2-3 players, but playable with up to 8!). Explore a growing set of **highly interactive escape rooms**. Pick up and examine everything, break objects, solve locks, and decipher puzzles to escape! After finishing the main game, watch for free content updates and explore rooms **built by our awesome community**.\n\n# \u2b50**REVIEWS** \n\"What I've seen has left me considerably impressed.\" - UploadVR\n\n# \u2692\ufe0f**COMMUNITY-MADE ROOMS**\nAfter finishing the main game **explore numerous rooms** built by our amazing community.\n\n# \ud83e\udd1d**ONLINE CO-OP**\nAll rooms are playable in an online co-op. Play with up to 8 players (best played with 2-3). Customize your character and join friends to solve puzzles together. More heads are better than one!\n\n# \ud83e\udde9**INTERACTIVE PUZZLES**\nExplore 28+ official rooms filled with puzzles designed by real-life escape room operators. If it\u2019s not nailed down, you can pick it up.\n\n# \ud83d\udd0d**EXEMINE EVERYTHING**\nRead books, examine ancient artifacts, and find clues to riddles. Need to cross-reference a clue? No problem - just pin it!\n\n# \ud83c\udfc6**WANT MORE?**\nThe game features additional content in the form of Addons with 4 large rooms each: \n- **Steampunk**: Solve four new rooms on the beautiful steampunk airship \"Valor.\"\n- **Wild West**: Become an outlaw in the Wild West.\n- **Magic**: Embrace your magic potential, and follow in the footsteps of great witches and wizards. \n\n", "short_description": "First-person puzzler you can play solo or in an online co-op. Explore a set of highly interactive escape rooms. Move furniture, pick up and examine everything, smash pots and break
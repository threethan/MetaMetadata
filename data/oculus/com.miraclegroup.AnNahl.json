57184", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/491818890_1893254567990517_7796330273104519123_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=miT5qQKZ5kYQ7kNvwGZe9NI&_nc_oc=AdpUt4Gyxlaa9dFBUZsdXmKKMoK4y-h9UppEK7XnO8PKW_mgQlADSgvU1V_bhj6-Gi8&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQa1l2TisM1mvc1nuJE_ZjfEKAcP8d1Le07Xoo87RSGiw&oe=6B099C18"}, {"file_name": "image.png", "id": "2329432307548109", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491821682_2329432314214775_2610917979671650276_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=suX18F0JNhUQ7kNvwEpirzt&_nc_oc=Ado3kwoitwY3t8t_09mljyjDavOW_lFsI0IQvsE6ZyskFXfqih6S-5LZnkI6rWg4oYg&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ-iiMAk_F9j1yZBxJe1CgIo5d1uoegws_SQLp3t2b0tg&oe=6B09BE6B"}, {"file_name": "2.png", "id": "960897496614930", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491819239_960897499948263_7292686905669475172_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D2gX_OTImmcQ7kNvwFQxX4o&_nc_oc=AdopPJAg0hhedZpTk49JWqW5N5vnYgR19yzXTSUWyJa2qz77awXxti3CHuhK72FtogM&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ2kjdJyLfvexPHwZ0brCjucTl0x_-ewegN2zrt562Pew&oe=6B09BA61"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Surah An-Nahl", "keywords": [], "long_description": "Experience the recitation of Surah An-Nahl, the sixteenth chapter of the Holy Quran, in a fully immersive virtual reality environment designed for Meta Quest.\n\nThis VR experience offers a calm and distraction-free setting where you can listen to and reflect on the beautiful verses of Surah An-Nahl. The carefully designed virtual environment combined with high-quality audio helps create a focused atmosphere for spiritual reflection and connection with the Quran.\n\nSurah An-Nahl highlights the countless blessings of Allah in creation, encouraging believers to reflect on nature, gratitude, and faith. It reminds us of the importance of recognizing Allah\u2019s favors and following the path of guidance with sincerity and patience.", "short_description": "Surah An-Nahl highlights the countless blessings of Allah in creation, encouraging believers to reflect on nature, gratitude, and faith. It reminds us of the importance of recognizing Allah\u2019s favors and following the path of guidance with sincerity and patience."}]}, "developer_name": "Miracle Group", "developer_privacy_policy_url": "http://miraclegroup.work/privacy", "developer_terms_of_service_url": null, "publisher_name": "Miracle Group", "support_website_url": null, "website_url": "https://www.miraclegroup.work/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}, {"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "27103324952601209"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491819356_939470071778872_8885897269534985263_n.png?stp=dst-png_s360x360&_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2Hs0tgtpxmIQ7kNvwEl5hqA&_nc_oc=AdrFtSIco8ge5UrLHbkrcE0_wpdL58cWufyl63H7vnyIvqCv__8zXMsKOLrkcCzOywg&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTWrOlGzOUoqIKGJO2MwjwnTXKDuEY8mzNLkkUSlX0j_A&oe=6B09A2ED"}, "is_concept": false, "is_test": false, "is_trial
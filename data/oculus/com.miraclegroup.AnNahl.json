57184", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491818890_1893254567990517_7796330273104519123_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QdwpN1Ce9r8Q7kNvwGVjFhi&_nc_oc=AdpF_UfgwTpIZvvF92luztKMhHpLOsUlbgy2oCVtvqRJn7EvThYkK6Pji7Q_1v5jM4o&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSmXU9DqdqkmFjbhHUsRrJkVWbzH86BJeUz25RoDeUYUg&oe=6B06F918"}, {"file_name": "image.png", "id": "2329432307548109", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491821682_2329432314214775_2610917979671650276_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=suX18F0JNhUQ7kNvwF-YdO_&_nc_oc=AdrXmZJUQOuyCHPMt1BczE852m_KMyiiXjX5XCl6b2LX7w-vqw9WNf440aLrUj5bQfQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR9p1ogX4voLMoK9ZsR-RzfN5jLdj7QUaewhLbGeRy10w&oe=6B071B6B"}, {"file_name": "2.png", "id": "960897496614930", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491819239_960897499948263_7292686905669475172_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LdR1Gts3nwkQ7kNvwEWEi7y&_nc_oc=Adq4doovm7nuhpHAHswuNMDQZx60FRqgunVDYP4bK__wIlppJuIMwHExGYzNUgHxBaI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRLyVrDizwW6Zxa6OQHGls_i04kT1GS2SjJWlzVICDc5g&oe=6B071761"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Surah An-Nahl", "keywords": [], "long_description": "Experience the recitation of Surah An-Nahl, the sixteenth chapter of the Holy Quran, in a fully immersive virtual reality environment designed for Meta Quest.\n\nThis VR experience offers a calm and distraction-free setting where you can listen to and reflect on the beautiful verses of Surah An-Nahl. The carefully designed virtual environment combined with high-quality audio helps create a focused atmosphere for spiritual reflection and connection with the Quran.\n\nSurah An-Nahl highlights the countless blessings of Allah in creation, encouraging believers to reflect on nature, gratitude, and faith. It reminds us of the importance of recognizing Allah\u2019s favors and following the path of guidance with sincerity and patience.", "short_description": "Surah An-Nahl highlights the countless blessings of Allah in creation, encouraging believers to reflect on nature, gratitude, and faith. It reminds us of the importance of recognizing Allah\u2019s favors and following the path of guidance with sincerity and patience."}]}, "developer_name": "Miracle Group", "developer_privacy_policy_url": "http://miraclegroup.work/privacy", "developer_terms_of_service_url": null, "publisher_name": "Miracle Group", "support_website_url": null, "website_url": "https://www.miraclegroup.work/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}, {"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "27103324952601209"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491819356_939470071778872_8885897269534985263_n.png?stp=dst-png_s360x360&_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bZ8bcNwQucIQ7kNvwENyWnf&_nc_oc=AdrHNZy2ZIjYq3ZFshmeksKIDEBv-tPwx9UzbL4VLF5BXz8QKdRZgN_fO2umdLB6ZSQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSqJTfnV_ecuNL6a4bZ2B1hno202WIpku9K9BRl1Qxwkw&oe=6B06FFED"}, "is_concept": false, "is_test": false, "is_trial
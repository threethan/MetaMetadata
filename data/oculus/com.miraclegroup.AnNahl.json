57184", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491818890_1893254567990517_7796330273104519123_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9QB2l4SROCMQ7kNvwF1Cg8n&_nc_oc=Adpd0w2bTapfCHND5MOvR9RkWYFHVkLEEq6T4Dn3YeU71FZ9Ns9qhxC5_DOM2OtsY9Y&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS3aqKb8nlu4aYxO9Yt9A4p_VdreJAJEfs_zvxFNuMCQA&oe=6AFDBE98"}, {"file_name": "image.png", "id": "2329432307548109", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491821682_2329432314214775_2610917979671650276_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BKONrUm_lGYQ7kNvwGDLsaq&_nc_oc=Adpg-IZXS1uWClr6MBmZ3gAZXnTaRkL3Dt60CM7BNBF6iSSQ98jVxFEh4copiS6j9fA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTJb5sQFxIsmeYLQ-Wqqn9v8TvEkm_qbvNYACfWqdZorg&oe=6AFDE0EB"}, {"file_name": "2.png", "id": "960897496614930", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491819239_960897499948263_7292686905669475172_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nrI9LPDf2xQQ7kNvwHb-ZIO&_nc_oc=AdonFPf5MvpGaonzkr0zI7z5LiDvJviVHdGRdh75b7J2XL_G2xgaW2ZCENBGRdWyLDs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTgyntMrHJhEnzpXrGkghG5nWA9N_uE9fVPfXg71dZEyg&oe=6AFDDCE1"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Surah An-Nahl", "keywords": [], "long_description": "Experience the recitation of Surah An-Nahl, the sixteenth chapter of the Holy Quran, in a fully immersive virtual reality environment designed for Meta Quest.\n\nThis VR experience offers a calm and distraction-free setting where you can listen to and reflect on the beautiful verses of Surah An-Nahl. The carefully designed virtual environment combined with high-quality audio helps create a focused atmosphere for spiritual reflection and connection with the Quran.\n\nSurah An-Nahl highlights the countless blessings of Allah in creation, encouraging believers to reflect on nature, gratitude, and faith. It reminds us of the importance of recognizing Allah\u2019s favors and following the path of guidance with sincerity and patience.", "short_description": "Surah An-Nahl highlights the countless blessings of Allah in creation, encouraging believers to reflect on nature, gratitude, and faith. It reminds us of the importance of recognizing Allah\u2019s favors and following the path of guidance with sincerity and patience."}]}, "developer_name": "Miracle Group", "developer_privacy_policy_url": "http://miraclegroup.work/privacy", "developer_terms_of_service_url": null, "publisher_name": "Miracle Group", "support_website_url": null, "website_url": "https://www.miraclegroup.work/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}, {"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "27103324952601209"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491819356_939470071778872_8885897269534985263_n.png?stp=dst-png_s360x360&_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H5EDfSrCcqAQ7kNvwElllkO&_nc_oc=AdpuVopsHNyXLG2ld-G0S9FPzhsEqZPGjci8olUD2H4EPSQ-fKmfcSlr3NVr13WLJ-U&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQlA2sP6744dCaxsEGU3IevIZFTuUHJGXBtlxJlgDYLxQ&oe=6AFDC56D"}, "is_concept": false, "is_test": false, "is_trial
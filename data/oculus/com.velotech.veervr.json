8fHA&oe=6A8D822B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover.png", "id": "858182618298912", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/38974844_858182621632245_4461917798521767358_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3doYvjHMbUIQ7kNvwFJsWV9&_nc_oc=Adp_cX0qJogr2qDeD93g3Cq6AKl_nBQGwBXZdki_v70sAwdCPSDdXHcMrY83lqiX9G0&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHETICPs6HpOYLd8aQwHXuvAaAI4M649RvG4t-cM-f9CA&oe=6A8D78EA"}, "display_name": "VeeR: Premium Immersive Entertainment", "keywords": [], "long_description": "Looking for the best latest VR movies\uff1fVeeR have them all.\n\nWhat is special about VeeR:\n\n\u2022 PREMIUM TITLES: VR movies from award-winning studios and latest film festival line-ups\n\n\u2022 FRESH EXPERIENCES CURATED WEEKLY: We've got interactive movies, animations, Sci-Fi, travel & documentaries and so much more\n\n\u2022 HEAD-TRACKED SUBTITLES: Enjoy titles all around the world with English captions\n\n\u2022 ONLINE STREAMING & OFFLINE WATCHING up to 4K \n\n\u2022 VEER VR MOBILE APP:  With the mobile companion app, available on iOS & Android, you can preview and  bookmark titles during your commute or break time and watch later in a VR headset.\n\nDownload VeeR now and start watching!\n\nIf you like VeeR, please rate us and leave a review.\n\n*Any feedback or problems? \nReply within 48 hours: support@veer.tv \n\n*Follow us and stay tuned for new titles:\nFacebook: @letsveer \nTwitter: @letsveer", "short_description": "VeeR is a premium VR entertainment platform, with a library of over 10,000 of 4K 360/180 3D videos, photos and interactive experiences."}]}, "developer_name": null, "developer_privacy_policy_url": "http://o8dy6wafc.bkt.clouddn.com/VeeR-PrivacyPolicy.pdf", "developer_terms_of_service_url": null, "publisher_name": "Velocious Technologies", "support_website_url": null, "website_url": "https://veer.tv/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_
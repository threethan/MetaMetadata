r in a VR headset.\n\nDownload VeeR now and start watching!\n\nIf you like VeeR, please rate us and leave a review.\n\n*Any feedback or problems? \nReply within 48 hours: support@veer.tv \n\n*Follow us and stay tuned for new titles:\nFacebook: @letsveer \nTwitter: @letsveer", "short_description": "VeeR is a premium VR entertainment platform, with a library of over 10,000 of 4K 360/180 3D videos, photos and interactive experiences."}]}, "developer_name": null, "developer_privacy_policy_url": "http://o8dy6wafc.bkt.clouddn.com/VeeR-PrivacyPolicy.pdf", "developer_terms_of_service_url": null, "publisher_name": "Velocious Technologies", "support_website_url": null, "website_url": "https://veer.tv/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EXPERIENCE_360_NON_GAME", "MOVIE", "NARRATIVE"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "zh_CN", "ja"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1015107386313757"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974547_537760730474996_2791095287770239228_n.png?stp=dst-png_s360x360&_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oF7HXX5KeWkQ7kNvwHisMg8&_nc_oc=Adqv6WB-yNSE85awdsZvXq8iurb0uvX1IItLkGt09YGkDaJn0042R3lETMymkJwQZc8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQStkx2JuUDfPYhto4ZhIoc5CEp-_DER97R0Wcu9VjhQIA&oe=6B0DCB59"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false
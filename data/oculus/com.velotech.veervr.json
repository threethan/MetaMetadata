21tLJL7041g&oe=6A8D84BC"}, {"file_name": "5.png", "id": "324216532323850", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/75222940_324216535657183_2732993496674239197_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z2RQu8yFoZsQ7kNvwHyNSod&_nc_oc=AdpmHJKOCJvTBBQBTZsaVv3fb-iNQ1XMmlV3kMeh50AxjG45SWz3s7tXbPf-CqKcEi0&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG6PYgXuMClV3nuXeQA87YAtc0t0Bl5R3JP6PjLk9qFcQ&oe=6A8D95DA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover.png", "id": "858182618298912", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/38974844_858182621632245_4461917798521767358_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3doYvjHMbUIQ7kNvwFJsWV9&_nc_oc=Adp_cX0qJogr2qDeD93g3Cq6AKl_nBQGwBXZdki_v70sAwdCPSDdXHcMrY83lqiX9G0&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHETICPs6HpOYLd8aQwHXuvAaAI4M649RvG4t-cM-f9CA&oe=6A8D78EA"}, "display_name": "VeeR: Premium Immersive Entertainment", "keywords": [], "long_description": "Looking for the best latest VR movies\uff1fVeeR have them all.\n\nWhat is special about VeeR:\n\n\u2022 PREMIUM TITLES: VR movies from award-winning studios and latest film festival line-ups\n\n\u2022 FRESH EXPERIENCES CURATED WEEKLY: We've got interactive movies, animations, Sci-Fi, travel & documentaries and so much more\n\n\u2022 HEAD-TRACKED SUBTITLES: Enjoy titles all around the world with English captions\n\n\u2022 ONLINE STREAMING & OFFLINE WATCHING up to 4K \n\n\u2022 VEER VR MOBILE APP:  With the mobile companion app, available on iOS & Android, you can preview and  bookmark titles during your commute or break time and watch later in a VR headset.\n\nDownload VeeR now and start watching!\n\nIf you like VeeR, please rate us and leave a review.\n\n*Any feedback or problems? \nReply within 48 hours: support@veer.tv \n\n*Follow us and stay tuned for new titles:\nFacebook: @letsveer \nTwitter: @letsveer", "short_description": "VeeR is a premium V
AQXPsoYyz1ns4TWLM4E1ZuJPG7HUBcA8i_79gSeyublSGw&oe=6B106A15"}, {"file_name": "screenshot_3_2560x1440.png", "id": "1055520684160587", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/673751957_1055520687493920_8078023080497727354_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DLaQppRh9YAQ7kNvwFTHQ7X&_nc_oc=AdpjYD-jdzIfvOFPSqm0yOWsajIxNXgASM8r_MKW9wbY5inhyWPPvr1Hy1lyxcC-cTc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQUnPtUdUf1iyZSZnJAtSEPUEbUQoSwkc8UGxCKy4A4qeg&oe=6B104D32"}, {"file_name": "screenshot_2_2560x1440.png", "id": "2083974348905676", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/673751957_2083974352239009_7819306696989505581_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P5eXoy0ljA8Q7kNvwH9n9KU&_nc_oc=AdoOJjViCxfGAa-BYpInK2hdJcqp1fLHB1T3JkHHVWCVKhHy0wNGVYTLCOSU41zcbvA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQX96HBLOVrhKvlqgLcgpSlI3P-wm7ck8AHv7JdcUPfOJQ&oe=6B106139"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Widgets: Clock, Weather & Notes", "keywords": ["widgets", "clock", "calendar", "countdown", "weather"], "long_description": "Widgets brings the familiar phone-widget category to Horizon OS as live 2D windows. Open the gallery, pick a widget, and spawn it as a floating window anywhere in your workspace \u2014 then arrange as many as you like around your rooms.\n\nTime & date \u2014 Clock, Date, Countdown, World Clock, Timer, Time Converter and Stopwatch keep you on schedule.\nProductivity \u2014 a full Calculator, Pomodoro, Time Tracker, Water intake, Tasks and Unit Converter help you get things done.\nInfo & media \u2014 live Weather, News (any RSS feed), Battery, Notes and rotating Quotes.\n\nEach widget updates live in its own panel, and your layout and settings are saved on the device. Widgets is a 2D app built with the Meta Horizon UI Set \u2014 no immersive mode and no controllers required.", "short_description": "A gallery of live 2D widgets \u2014 clocks, calendar, countdowns, calculator, weather, notes and more \u2014 that you spawn as floating windows around your Horizon workspace."}]}, "developer_name": null, "developer_privacy_policy_url": "https://savvazaicev.github.io/widgets-legal/privacy.html", "developer_terms_of_service_url": "https://savvazaicev.github.io/widgets-legal/terms.html", "publisher_name": "Savva", "support_website_url": null, "website_url": "https://savvazaicev.github.io/widgets-legal/landing.html", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1063584910766706"}, {"id": "393222478507326"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ru"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1465206370001080"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1146438221110236"}]}, "baseline_offer": {"id": "1146438221110236"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1793901600, "status": "PUBLISHED", "id": "1146438221110236"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1477655672089483", "version": "1.0"}, "id": "1127975709978887", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1465206356667748", "is_concept": false, "latest_released_bi
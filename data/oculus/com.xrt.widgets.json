at=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9uIGZJ3lBkUQ7kNvwGiP4gT&_nc_oc=AdpADG6c7qp9_gk8gzfIQvfoZ4s-NpWY2cA3ffqoCUXlh2f-M-ZCcoX-f_5SzhBCPiI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQR21BeX0zceVvVM0OdmX1l3qL22UB-HzpsbvnQtmCldA&oe=6B007B32"}, {"file_name": "screenshot_2_2560x1440.png", "id": "2083974348905676", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/673751957_2083974352239009_7819306696989505581_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CxUgFpgd3SkQ7kNvwETZXAe&_nc_oc=AdpYLif663RxVW8cjPnd90iWKO9zplXDTrA_gog1abrSFjzogFNoK50JpPB6seW9wgg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTCanEcsh1Yv8Ynesw6tu5YWU_SRqs6zT0UkjUpbOO0Hg&oe=6B0056F9"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Widgets: Clock, Weather & Notes", "keywords": ["widgets", "clock", "calendar", "countdown", "weather"], "long_description": "Widgets brings the familiar phone-widget category to Horizon OS as live 2D windows. Open the gallery, pick a widget, and spawn it as a floating window anywhere in your workspace \u2014 then arrange as many as you like around your rooms.\n\nTime & date \u2014 Clock, Date, Countdown, World Clock, Timer, Time Converter and Stopwatch keep you on schedule.\nProductivity \u2014 a full Calculator, Pomodoro, Time Tracker, Water intake, Tasks and Unit Converter help you get things done.\nInfo & media \u2014 live Weather, News (any RSS feed), Battery, Notes and rotating Quotes.\n\nEach widget updates live in its own panel, and your layout and settings are saved on the device. Widgets is a 2D app built with the Meta Horizon UI Set \u2014 no immersive mode and no controllers required.", "short_description": "A gallery of live 2D widgets \u2014 clocks, calendar, countdowns, calculator, weather, notes and more \u2014 that you spawn as floating windows around your Horizon workspace."}]}, "developer_name": null, "developer_privacy_po
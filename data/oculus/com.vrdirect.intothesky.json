Q&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af389bCgzqg7h8UPsfxncQw-uwXG_DxOxlrR2kxRJA5ziA&oe=69DA42FA"}, {"file_name": "migrated_image.png", "id": "504824483532921", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39035316_2084066765017365_7938336161401929728_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=95yCd_LDa7oQ7kNvwFK1j5c&_nc_oc=AdqzyHHMBOYmyuESy3O8E1lRK_lkZG4Qz579j7hLXBUKBI2B02baW_rHeZ6_0-JugKQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3HBeXaP9Ed2kvUipQOjuOjdBP-XXFWKlsnB9711uLFlQ&oe=69DA3076"}, {"file_name": "migrated_image.png", "id": "232049701277719", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031573_300612900616775_6372420896648331264_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HECcftkeHT8Q7kNvwHAYDc5&_nc_oc=AdrsoO8AAaiRp1Nn5nKoszLoNt0rBiIHA5otZiDFt6IKBi3JavelebRBurSURnudia4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2526Ku2M5_uepkfGpHeiDjHBI-DVeSGpAN1a26Uq6zLg&oe=69DA5176"}, {"file_name": "migrated_image.png", "id": "247467546430711", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974904_450907375650521_1262763278862385152_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O9heILImqWEQ7kNvwHKqhZV&_nc_oc=AdpYn043_JPLl5bIKD396Gk_l2A3DY97wNplhIW05ZzG0sC0594GzFmTTSxXGO1P7Bc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2dSnxRXQlR0_BTntMmT8PmH-_Q3OWcKi5lQdcpu4-Wvg&oe=69DA2ECF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/MgJMBU", "id": "2379779072250886", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982702_2379779075584219_634601862028328960_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IPc29NZUFBEQ7kNvwEKOczV&_nc_oc=AdpsMRoqsePlkzrdTwthxSxEHLWIBjZZidWarTqBKFjEGhAe4vHcux_K3UykKyX-RQQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1idrqiYL6WKBWgmZQs1FdsbnJZYHzG94dcPIJuL38ceQ&oe=69DA3B15"}, "display_name": "Into the Sky", "keywords": ["360", "interactive", "film", "documentary", "skydiving"], "long_description": "Skydiving, aerobatics, sunrise flights! Experience the adrenalin loaded daily live of three extreme athletes in the immersive 360\u00b0 film format. Ready for take off?\nInto the Sky documents the passion of a paraglider, an aerobatic pilot and a parachutist in 360\u00b0: Risking their lives during breathtaking maneuvers. Experience the film in the innovative 360\u00b0 format from the first person view with spatial audio and maximum immersion. \n\nIn addition to the linear film an interactive version which can be experienced with an app has been published . In this version the user can influence the course of the story or simply change the cameras perspective. \nA highlight in the interactive version is triggering the parachute jump. An interaction must be carried out at the right time which contributes to an increased tension. If the user interacts wrong he is thrown back in the plot.\n\nDownload the app now and epxerience the next level of interactive storytelling.", "short_description": "Skydiving, aerobatics, sunrise flights!\nJoin three extreme athletes in an adrenaline loaded interactive 360\u00b0 film."}]}, "developer_name": "Diego Montoya", "developer_privacy_policy_url": "https://www.vrdirect.com/imprint-privacy", "developer_terms_of_service_url": "https://auth.viond.io/legal/terms-and-conditions", "publisher_name": "VRdirect", "support_website_url": "https://www.vrdirect.com/support", "website_url": "https://www.vrdirect.com/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "EXPERIENCE_360_NON_GAME", "FLYING"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported
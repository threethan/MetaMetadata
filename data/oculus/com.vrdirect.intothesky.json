M&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEKesZtkmW0M6F8ObYB0HTeiZl71aPV5FNa1DrfVxUsug&oe=6A94267A"}, {"file_name": "migrated_image.png", "id": "504824483532921", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/39035316_2084066765017365_7938336161401929728_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QUJnz_b8u4AQ7kNvwEBOk33&_nc_oc=AdohlJVLi-3Bo1YN9jm620Q9NXsuvf7nNXMscXDmB5HFE5sv52OE7iikn29_qvWalDw&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFwLInc6WTp-gTjLrTR4zOmhk1Qq2e5C6Ncn6F3K0Aq7A&oe=6A9413F6"}, {"file_name": "migrated_image.png", "id": "232049701277719", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/39031573_300612900616775_6372420896648331264_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PjxmYTlobr4Q7kNvwFMT_Bd&_nc_oc=AdoHdXOXHGM-lvtd6kYpoiq5v9BP6AxTwG9S4mJH8N3Hc-AoWhUcEvJ8N_zOB_Rn4rQ&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFmFab4fuYgohmdzxIf8XPFKvONCaT6fQIbPtroWsdSTA&oe=6A93FCB6"}, {"file_name": "migrated_image.png", "id": "247467546430711", "uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/38974904_450907375650521_1262763278862385152_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xyIkwNHmGsYQ7kNvwEZBadU&_nc_oc=AdryfYamg7RqhcBh7OANkx66kFLqw1P0zr5_QBrdV2EfD2HIyeLB5xhxg0UhA8utZRc&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF6yNcTk1IQltkqUsGP33uSDb6S64ll6E6V_E1Q9PSIXA&oe=6A94124F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/MgJMBU", "id": "2379779072250886", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/38982702_2379779075584219_634601862028328960_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2jHW6FboQjcQ7kNvwHb8Ptp&_nc_oc=AdoQ_wcgoePOCfjMX6EXP-anGcB8UqS_p3kNDcYN91NfhNU5RqbtT3dLH7CuBxUl1Es&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGWECyFaQxKxmIEtwA9TUQN-g36tPzfQ4he0gB8Kz91cg&oe=6A941E95"}, "display_name": "Into the Sky", "keywords": ["360", "interactive", "film", "documentary", "skydiving"], "long_description": "Skydiving, aerobatics, sunrise flights! Experience the adrenalin loaded daily live of three extreme athletes in the immersive 360\u00b0 film format. Ready for take off?\nInto the Sky documents the passion of a paraglider, an aerobatic pilot and a parachutist in 360\u00b0: Risking their lives during breathtaking maneuvers. Experience the film in the innovative 360\u00b0 format from the first person view with spatial audio and maximum immersion. \n\nIn addition to the linear film an interactive version which can be experienced with an app has been published . In this version the user can influence the course of the story or simply change the cameras perspective. \nA highlight in the interactive version is triggering the parachute jump. An interaction must be carried out at the right time which contributes to an increased tension. If the user interacts wrong he is thrown back in the plot.\n\nDownload the app now and epxerience the next level of interactive storytelling.", "short_description": "Skydiving, aerobatics, sunrise flights!\nJoin three extreme athletes in an adrenaline loaded interactive 360\u00b0 film."}]}, "developer_name": "Diego Montoya", "developer_privacy_policy_url": "https://www.vrdirect.com/imprint-privacy", "developer_terms_of_service_url": "https://auth.viond.io/legal/terms-and-conditions", "publisher_name": "VRdirect", "support_website_url": "https://www.vrdirect.com/support", "website_url": "https://www.vrdirect.com/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "EXPERIENCE_360_NON_GAME", "FLYING"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported
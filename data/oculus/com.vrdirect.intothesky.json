Q&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0L-jYAX-FCLksIWwjJRjXfWLqwW5VKhOoe3z2Hym0zTA&oe=69EE097A"}, {"file_name": "migrated_image.png", "id": "504824483532921", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39035316_2084066765017365_7938336161401929728_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1FM7MSdAXiUQ7kNvwETY6HF&_nc_oc=AdojWcGyLxeVG5o87P2C6bQyDIVnsLPATmG0sNFCn7HXh7bj1WUs3QrOpY_cPXz_Kt4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af18eSd4qrGm-C3JPaNgNKUO0t6dIpC4fXg6lbYgjdJqTA&oe=69EDF6F6"}, {"file_name": "migrated_image.png", "id": "232049701277719", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031573_300612900616775_6372420896648331264_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yMOpw0PcGF8Q7kNvwFkeEai&_nc_oc=AdpXT-Mx0mcFBm9PPeLnurnkRUSV7g_OPnzX8nOhluk8cSl0kqwPCZH3eLGllYe4DJo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1I4YDlW16ElbkI3MWXpo_pRm_JO0r3ACB961ztrJf5Fg&oe=69EE17F6"}, {"file_name": "migrated_image.png", "id": "247467546430711", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974904_450907375650521_1262763278862385152_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Pl6651tai5wQ7kNvwHl0gQ-&_nc_oc=AdqMDX0fTsuKTjXiCNqcQm6l_bOBz93Ql4rt2lTTfjgg-UF88e72sSJ2O_9tGll215E&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2fDAwOwDTcccRmjorjLyxu-8yJNatjoXFy-g16KsklOg&oe=69EDF54F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/MgJMBU", "id": "2379779072250886", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982702_2379779075584219_634601862028328960_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0s9drRgiENYQ7kNvwHny_tx&_nc_oc=AdriDqQsD-5R7s7Bki2wVOD9gZq3OlKXWSfCs2L8HU8ypxtX-ryZNZQ_1b5X0IAYV-Q&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2J8GO0tBpYqHOIrnwnv5pe2qm6QgGSl24ZQpl1-dXsBA&oe=69EE0195"}, "display_name": "Into the Sky", "keywords": ["360", "interactive", "film", "documentary", "skydiving"], "long_description": "Skydiving, aerobatics, sunrise flights! Experience the adrenalin loaded daily live of three extreme athletes in the immersive 360\u00b0 film format. Ready for take off?\nInto the Sky documents the passion of a paraglider, an aerobatic pilot and a parachutist in 360\u00b0: Risking their lives during breathtaking maneuvers. Experience the film in the innovative 360\u00b0 format from the first person view with spatial audio and maximum immersion. \n\nIn addition to the linear film an interactive version which can be experienced with an app has been published . In this version the user can influence the course of the story or simply change the cameras perspective. \nA highlight in the interactive version is triggering the parachute jump. An interaction must be carried out at the right time which contributes to an increased tension. If the user interacts wrong he is thrown back in the plot.\n\nDownload the app now and epxerience the next level of interactive storytelling.", "short_description": "Skydiving, aerobatics, sunrise flights!\nJoin three extreme athletes in an adrenaline loaded interactive 360\u00b0 film."}]}, "developer_name": "Diego Montoya", "developer_privacy_policy_url": "https://www.vrdirect.com/imprint-privacy", "developer_terms_of_service_url": "https://auth.viond.io/legal/terms-and-conditions", "publisher_name": "VRdirect", "support_website_url": "https://www.vrdirect.com/support", "website_url": "https://www.vrdirect.com/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "EXPERIENCE_360_NON_GAME", "FLYING"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported
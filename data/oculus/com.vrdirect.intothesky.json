o&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzmhVzMWguJ-Y9BhzSMDsvaf2plYGSS5lVWDvqkDUEgzA&oe=69CD13FA"}, {"file_name": "migrated_image.png", "id": "504824483532921", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39035316_2084066765017365_7938336161401929728_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KE63GPrb7MwQ7kNvwFzQF-7&_nc_oc=AdrwPREtsF-KMCjLGGc1m43_pP148x9Ea9LRM4WcQ6xHwOEYSxV1dcxRiN0tuxJb7S4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzSLIRsMMNYkgC0slVCHczocj2u5W8h7Ox13MphwIeXoA&oe=69CD0176"}, {"file_name": "migrated_image.png", "id": "232049701277719", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031573_300612900616775_6372420896648331264_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PC-u9tGazzYQ7kNvwFaJHKR&_nc_oc=Adr8nYfSnxZdpWfos1cRg9CJEItLTRqo-_hsK7J8WsrKGAIhPwRGKAY5GyYlYf3QUCI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxpaPPs8pE1ZfVp6CXFbOel85uJECPoc_VwGAmgwLzmIg&oe=69CD2276"}, {"file_name": "migrated_image.png", "id": "247467546430711", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974904_450907375650521_1262763278862385152_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=819v8kLS90YQ7kNvwGuO_9r&_nc_oc=Adp5JdTcNqCzIvQhnKRFMdfFmDXqslqKx2AcLiGImlgS_d25Yisw7YNPA39C07D1Ysw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfweE67x5J5OKIJI2p7sDDpSRbNbtEQlpbulfbZc-dFy9Q&oe=69CCFFCF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/MgJMBU", "id": "2379779072250886", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982702_2379779075584219_634601862028328960_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9pl2Kz9hENIQ7kNvwF23hIr&_nc_oc=AdoCZ7THTZV8699akpdwKUnpSRXcKDCdfKVPHtBv9FmQ9SGONxMV50mFzbLakLs2A2U&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzCEMAZAZ7f2kkL1DEDYaQn12FD6I4pQLNUIOUNuotuEA&oe=69CD0C15"}, "display_name": "Into the Sky", "keywords": ["360", "interactive", "film", "documentary", "skydiving"], "long_description": "Skydiving, aerobatics, sunrise flights! Experience the adrenalin loaded daily live of three extreme athletes in the immersive 360\u00b0 film format. Ready for take off?\nInto the Sky documents the passion of a paraglider, an aerobatic pilot and a parachutist in 360\u00b0: Risking their lives during breathtaking maneuvers. Experience the film in the innovative 360\u00b0 format from the first person view with spatial audio and maximum immersion. \n\nIn addition to the linear film an interactive version which can be experienced with an app has been published . In this version the user can influence the course of the story or simply change the cameras perspective. \nA highlight in the interactive version is triggering the parachute jump. An interaction must be carried out at the right time which contributes to an increased tension. If the user interacts wrong he is thrown back in the plot.\n\nDownload the app now and epxerience the next level of interactive storytelling.", "short_description": "Skydiving, aerobatics, sunrise flights!\nJoin three extreme athletes in an adrenaline loaded interactive 360\u00b0 film."}]}, "developer_name": "Diego Montoya", "developer_privacy_policy_url": "https://www.vrdirect.com/imprint-privacy", "developer_terms_of_service_url": "https://auth.viond.io/legal/terms-and-conditions", "publisher_name": "VRdirect", "support_website_url": "https://www.vrdirect.com/support", "website_url": "https://www.vrdirect.com/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "EXPERIENCE_360_NON_GAME", "FLYING"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported
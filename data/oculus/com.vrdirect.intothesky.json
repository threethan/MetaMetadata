8&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-OBONKtG-GrfzW4J2bWD90kURQvyEwVokMVHgmN1Tamw&oe=6A32977A"}, {"file_name": "migrated_image.png", "id": "504824483532921", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/39035316_2084066765017365_7938336161401929728_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KnpJgOAb1PIQ7kNvwEooKho&_nc_oc=AdrMqXIjPXi01feUwf-ARtPOZd690loNh7tNWoHqlbSSX-gtHzA84lYBCG0bC6h8Gek&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_HrEg4ouf-f9FSVysGJbGYUcWsMv5IstjCqy1GLokHqA&oe=6A32BD36"}, {"file_name": "migrated_image.png", "id": "232049701277719", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/39031573_300612900616775_6372420896648331264_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5XPbjAmAaokQ7kNvwENGA3a&_nc_oc=Adr4rd4LtGWwGP7wR_Df0ZqF9p7EO5gtwxeXANKek557a3ywU3myFvZlgaARgcM85Ms&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-JWr6j2x83aCcx3J-iC-bSVUZCdbHcwpxIUdz0mH4LAQ&oe=6A32A5F6"}, {"file_name": "migrated_image.png", "id": "247467546430711", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38974904_450907375650521_1262763278862385152_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AbAOuNhMfwoQ7kNvwEs-109&_nc_oc=Adq4MYwNyCPHy5nncfI-3sgERCm7RWkw6qMBv5e3cUXBFuI9smKXcxTyE5_jNmVHdEg&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-UoB9Ir01p8mEmotSMO9Qkmj-J53Py2HRqMZ5FGKhs1g&oe=6A32BB8F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/MgJMBU", "id": "2379779072250886", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/38982702_2379779075584219_634601862028328960_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZL1Lcg0NGfsQ7kNvwHcldX6&_nc_oc=Adp2s7oH_JVgCHV99iJmEzkHpYVEONqb6MAQPOeZDHiw2ZlH-h1bZ8XmTsMbRd4NR1s&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8VY9Ey8k693te8H9jVYeDWsVYRp2as5YYEUC2Mx8K07A&oe=6A32C7D5"}, "display_name": "Into the Sky", "keywords": ["360", "interactive", "film", "documentary", "skydiving"], "long_description": "Skydiving, aerobatics, sunrise flights! Experience the adrenalin loaded daily live of three extreme athletes in the immersive 360\u00b0 film format. Ready for take off?\nInto the Sky documents the passion of a paraglider, an aerobatic pilot and a parachutist in 360\u00b0: Risking their lives during breathtaking maneuvers. Experience the film in the innovative 360\u00b0 format from the first person view with spatial audio and maximum immersion. \n\nIn addition to the linear film an interactive version which can be experienced with an app has been published . In this version the user can influence the course of the story or simply change the cameras perspective. \nA highlight in the interactive version is triggering the parachute jump. An interaction must be carried out at the right time which contributes to an increased tension. If the user interacts wrong he is thrown back in the plot.\n\nDownload the app now and epxerience the next level of interactive storytelling.", "short_description": "Skydiving, aerobatics, sunrise flights!\nJoin three extreme athletes in an adrenaline loaded interactive 360\u00b0 film."}]}, "developer_name": "Diego Montoya", "developer_privacy_policy_url": "https://www.vrdirect.com/imprint-privacy", "developer_terms_of_service_url": "https://auth.viond.io/legal/terms-and-conditions", "publisher_name": "VRdirect", "support_website_url": "https://www.vrdirect.com/support", "website_url": "https://www.vrdirect.com/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "EXPERIENCE_360_NON_GAME", "FLYING"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported
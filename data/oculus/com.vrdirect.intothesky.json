g&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_ET7EXqXoOJ_LUetg1xhSMSMhrjbj-iR5fVKt6UG1fxA&oe=6A2416FA"}, {"file_name": "migrated_image.png", "id": "504824483532921", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39035316_2084066765017365_7938336161401929728_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MdWXdgFcLY4Q7kNvwGLWzED&_nc_oc=AdpAPuN4PnWsvUH_G8C3MHsJTBchFBI7HD3MKb6-dU9F3evP_wsfTCn4DYfCb42c5w4&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_2n6C4c2AA5inhF8nZbrARZGEFiuXqdmGdWOGYBD1tXQ&oe=6A243CB6"}, {"file_name": "migrated_image.png", "id": "232049701277719", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39031573_300612900616775_6372420896648331264_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fyOP2KOp9r0Q7kNvwEGiK5q&_nc_oc=Adr8ML9n8Je2U7siUl_vpmrfjLrM1gN1wCUOEG2Z88H7FFntCYTMWIIjRg36CLmkDtM&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8RizXud6M5Gnj50mrpKy3A2LiOubosZJs8rk69S41cWA&oe=6A242576"}, {"file_name": "migrated_image.png", "id": "247467546430711", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974904_450907375650521_1262763278862385152_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J552hSR3aFYQ7kNvwGTH38p&_nc_oc=AdpawWIJuKWy7mXE66f-hlx-iTjfihK_Q5HhdNHJDFTIpsQ4nAaJ-PTMcUp1LfTaHdo&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-NCGWGoFBHtA6s7k2oPYmU96UUW8qIgcTRigCBXy5tmw&oe=6A243B0F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/MgJMBU", "id": "2379779072250886", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38982702_2379779075584219_634601862028328960_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nzEUDEYDgJIQ7kNvwHAVnvu&_nc_oc=Adqt4_9t_kCplbgUYAfniJo5CQmQgUSZLyjBevh8upS_V7G1T8htMvrOJsUyeWbrvkA&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_7trIueCG0Wfsl93ZOq-4tVIIU95384O4uwQ2IbikO9Q&oe=6A244755"}, "display_name": "Into the Sky", "keywords": ["360", "interactive", "film", "documentary", "skydiving"], "long_description": "Skydiving, aerobatics, sunrise flights! Experience the adrenalin loaded daily live of three extreme athletes in the immersive 360\u00b0 film format. Ready for take off?\nInto the Sky documents the passion of a paraglider, an aerobatic pilot and a parachutist in 360\u00b0: Risking their lives during breathtaking maneuvers. Experience the film in the innovative 360\u00b0 format from the first person view with spatial audio and maximum immersion. \n\nIn addition to the linear film an interactive version which can be experienced with an app has been published . In this version the user can influence the course of the story or simply change the cameras perspective. \nA highlight in the interactive version is triggering the parachute jump. An interaction must be carried out at the right time which contributes to an increased tension. If the user interacts wrong he is thrown back in the plot.\n\nDownload the app now and epxerience the next level of interactive storytelling.", "short_description": "Skydiving, aerobatics, sunrise flights!\nJoin three extreme athletes in an adrenaline loaded interactive 360\u00b0 film."}]}, "developer_name": "Diego Montoya", "developer_privacy_policy_url": "https://www.vrdirect.com/imprint-privacy", "developer_terms_of_service_url": "https://auth.viond.io/legal/terms-and-conditions", "publisher_name": "VRdirect", "support_website_url": "https://www.vrdirect.com/support", "website_url": "https://www.vrdirect.com/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "EXPERIENCE_360_NON_GAME", "FLYING"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported
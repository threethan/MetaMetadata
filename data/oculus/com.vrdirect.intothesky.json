8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_nhiFjhkA1SzxWt4WNrdgW-Wb36rVvY976yzVAWxMn_g&oe=6A42697A"}, {"file_name": "migrated_image.png", "id": "504824483532921", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39035316_2084066765017365_7938336161401929728_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aHtUg3vyaPoQ7kNvwHl1BAO&_nc_oc=Adq4X9mcIqNAMkCjwwydvLM6jyL6eUtQ-42k3OBRhIA2REFSf7MLzukxlytX2wsDMFk&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_l0eMpKiim5SUPfggISqaSV4izVdq3g2t_6QyhSt1usA&oe=6A428F36"}, {"file_name": "migrated_image.png", "id": "232049701277719", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39031573_300612900616775_6372420896648331264_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nH-Bt5kfgLsQ7kNvwHvt5dF&_nc_oc=AdpoqK660Aedpe-VEqE36deOKmSqPjA7rGpjMaCJ6qGiBaUsyBHEb0BVAI-jhBoI-Ng&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8l6lWjAbgbFjhUFREa2kMCPVLEwcmHHmVxuQMW77M2Mw&oe=6A4277F6"}, {"file_name": "migrated_image.png", "id": "247467546430711", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974904_450907375650521_1262763278862385152_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IcqHenzrYZ4Q7kNvwHK5DTA&_nc_oc=AdqDApmC7w9ogNqoY6iejDo447RUc-2i_JW7WkWW94rTYh1q53o1gGKkXdxe-TVN9bk&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8NlR21ZjVF9UWzEP1cLgH6UxG2ty4antFHATvrMOcZmQ&oe=6A428D8F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/MgJMBU", "id": "2379779072250886", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982702_2379779075584219_634601862028328960_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4NuQJ4EovFYQ7kNvwG-Yvyo&_nc_oc=Adq67q5dRV2R74pPTFoFzztgbXF3Ims9jgcnbmo77lF12ACh_ibPSp0-MMZaq6RKDdA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-qCLtteY6lJhJIf-pAJG33R5-xchCeOYcHWL09CdbAHw&oe=6A4299D5"}, "display_name": "Into the Sky", "keywords": ["360", "interactive", "film", "documentary", "skydiving"], "long_description": "Skydiving, aerobatics, sunrise flights! Experience the adrenalin loaded daily live of three extreme athletes in the immersive 360\u00b0 film format. Ready for take off?\nInto the Sky documents the passion of a paraglider, an aerobatic pilot and a parachutist in 360\u00b0: Risking their lives during breathtaking maneuvers. Experience the film in the innovative 360\u00b0 format from the first person view with spatial audio and maximum immersion. \n\nIn addition to the linear film an interactive version which can be experienced with an app has been published . In this version the user can influence the course of the story or simply change the cameras perspective. \nA highlight in the interactive version is triggering the parachute jump. An interaction must be carried out at the right time which contributes to an increased tension. If the user interacts wrong he is thrown back in the plot.\n\nDownload the app now and epxerience the next level of interactive storytelling.", "short_description": "Skydiving, aerobatics, sunrise flights!\nJoin three extreme athletes in an adrenaline loaded interactive 360\u00b0 film."}]}, "developer_name": "Diego Montoya", "developer_privacy_policy_url": "https://www.vrdirect.com/imprint-privacy", "developer_terms_of_service_url": "https://auth.viond.io/legal/terms-and-conditions", "publisher_name": "VRdirect", "support_website_url": "https://www.vrdirect.com/support", "website_url": "https://www.vrdirect.com/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "EXPERIENCE_360_NON_GAME", "FLYING"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported
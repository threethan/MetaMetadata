I&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6xaZsjxTYmbZgDKjAaZD9eo0gEoJ8rsSugfSl5woyqpQ&oe=6A0C5BFA"}, {"file_name": "migrated_image.png", "id": "504824483532921", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/39035316_2084066765017365_7938336161401929728_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sElwBs1QFVEQ7kNvwE22wwP&_nc_oc=Ado4AvSbYWcMmGoQd7J5oBGl0PHw1wUwDjwBv2eW3VYwiC-G9EA6TzfnwgmMLNhLSgk&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4dWYoYUaRTMygchsXXqCpFM1ZSkn6DAoWgRDu3qS0txw&oe=6A0C81B6"}, {"file_name": "migrated_image.png", "id": "232049701277719", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/39031573_300612900616775_6372420896648331264_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6HF-dyd8VG0Q7kNvwEL2CjU&_nc_oc=Ado1_5UheN4aUNlYDj2CHJCvzGY986yuLbURFbrwK2YI5Ik8OThclS925gjZ--uENxU&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5OraUwDXXuIkFjFv0X7cDEOl_3G-_Vz_1DD68AoksSYw&oe=6A0C6A76"}, {"file_name": "migrated_image.png", "id": "247467546430711", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38974904_450907375650521_1262763278862385152_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mH682KHdggQQ7kNvwFY2V5S&_nc_oc=AdqGrJQyhPkbp6g2jBNsSNCmYMW4ZW74cdZ64M7ZqVSSVo4VNnaVK6fpxA3aEul2P-c&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7mbZcMA-pwQS9cpw7r7rkhON4Mfa3rO4gfBnlHV4uUCA&oe=6A0C800F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/MgJMBU", "id": "2379779072250886", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38982702_2379779075584219_634601862028328960_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PGkw9JoMX1cQ7kNvwFZ1BCY&_nc_oc=AdqGGm6gcXtAGrf0XBhY-fkEQGrR-jbrn0KPF4-4PkeXVAs9GRsWGi_HB0HQs-zFIeA&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5tWn_vGoPTWoYb73EZMc55HjYdwrAE90MtMrAIc0cKMQ&oe=6A0C5415"}, "display_name": "Into the Sky", "keywords": ["360", "interactive", "film", "documentary", "skydiving"], "long_description": "Skydiving, aerobatics, sunrise flights! Experience the adrenalin loaded daily live of three extreme athletes in the immersive 360\u00b0 film format. Ready for take off?\nInto the Sky documents the passion of a paraglider, an aerobatic pilot and a parachutist in 360\u00b0: Risking their lives during breathtaking maneuvers. Experience the film in the innovative 360\u00b0 format from the first person view with spatial audio and maximum immersion. \n\nIn addition to the linear film an interactive version which can be experienced with an app has been published . In this version the user can influence the course of the story or simply change the cameras perspective. \nA highlight in the interactive version is triggering the parachute jump. An interaction must be carried out at the right time which contributes to an increased tension. If the user interacts wrong he is thrown back in the plot.\n\nDownload the app now and epxerience the next level of interactive storytelling.", "short_description": "Skydiving, aerobatics, sunrise flights!\nJoin three extreme athletes in an adrenaline loaded interactive 360\u00b0 film."}]}, "developer_name": "Diego Montoya", "developer_privacy_policy_url": "https://www.vrdirect.com/imprint-privacy", "developer_terms_of_service_url": "https://auth.viond.io/legal/terms-and-conditions", "publisher_name": "VRdirect", "support_website_url": "https://www.vrdirect.com/support", "website_url": "https://www.vrdirect.com/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "EXPERIENCE_360_NON_GAME", "FLYING"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported
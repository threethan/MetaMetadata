M&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBddPF9TUOiPh3Yf0WmM7J6hI-tF-tMauexBpBVX3UYPw&oe=6A5F6A7A"}, {"file_name": "migrated_image.png", "id": "504824483532921", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39035316_2084066765017365_7938336161401929728_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q4PVxqp4svkQ7kNvwG5mkXd&_nc_oc=AdqzI_F8BMgqrDZxtzsWtnzNYGPUhtrTzN-2wQaryF5ozlacWOSSSt_SVoeSQ5ATwUU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC-cYiFSVtEBcfkH7wcGt09HucZ5-Cpd-UcDVaWGodQng&oe=6A5F57F6"}, {"file_name": "migrated_image.png", "id": "232049701277719", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031573_300612900616775_6372420896648331264_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eJWdc9x0LX0Q7kNvwEVHxMz&_nc_oc=Adpwqfv8NJcXGJuhZOghYuVAjHKGRb6l64MMppezb3NDD98xKT6S9uf3lDY8OphFR0c&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDj2lS2sZJzgcPDI4SwkGg79E3-pr87c1klSe-k1ZKAOQ&oe=6A5F78F6"}, {"file_name": "migrated_image.png", "id": "247467546430711", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974904_450907375650521_1262763278862385152_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W3c1n8ugVU8Q7kNvwGg3Pz7&_nc_oc=Adr5EBW7kO0qc5XuJrMCUIADeNKBo3xDiei_BpPrc17JFiatcVvF8KTF8JOZYxBoHV4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDE4mzYBFVaqYhv0rfDsZkVuM4VD64PIJrzLykCi4ve0w&oe=6A5F564F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/MgJMBU", "id": "2379779072250886", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982702_2379779075584219_634601862028328960_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xQ65o6qV0pIQ7kNvwE0Iojf&_nc_oc=Ado_gDre1OF1nc6BMllOeGHyWaXhrZDim4gR472fqaZ15s4oCGAohD2AaRWZXIKRPyw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCyCbYSgrclfeyku-ZI4znTeAaKsJcu7qSP9ssfJj-tTA&oe=6A5F6295"}, "display_name": "Into the Sky", "keywords": ["360", "interactive", "film", "documentary", "skydiving"], "long_description": "Skydiving, aerobatics, sunrise flights! Experience the adrenalin loaded daily live of three extreme athletes in the immersive 360\u00b0 film format. Ready for take off?\nInto the Sky documents the passion of a paraglider, an aerobatic pilot and a parachutist in 360\u00b0: Risking their lives during breathtaking maneuvers. Experience the film in the innovative 360\u00b0 format from the first person view with spatial audio and maximum immersion. \n\nIn addition to the linear film an interactive version which can be experienced with an app has been published . In this version the user can influence the course of the story or simply change the cameras perspective. \nA highlight in the interactive version is triggering the parachute jump. An interaction must be carried out at the right time which contributes to an increased tension. If the user interacts wrong he is thrown back in the plot.\n\nDownload the app now and epxerience the next level of interactive storytelling.", "short_description": "Skydiving, aerobatics, sunrise flights!\nJoin three extreme athletes in an adrenaline loaded interactive 360\u00b0 film."}]}, "developer_name": "Diego Montoya", "developer_privacy_policy_url": "https://www.vrdirect.com/imprint-privacy", "developer_terms_of_service_url": "https://auth.viond.io/legal/terms-and-conditions", "publisher_name": "VRdirect", "support_website_url": "https://www.vrdirect.com/support", "website_url": "https://www.vrdirect.com/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "EXPERIENCE_360_NON_GAME", "FLYING"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported
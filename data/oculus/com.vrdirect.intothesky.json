4&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2qfjRD3mBicKz7GL9M7oaBupaOF7a0HRf1CAgrz-602Q&oe=69E6207A"}, {"file_name": "migrated_image.png", "id": "504824483532921", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39035316_2084066765017365_7938336161401929728_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b6arTW6CfuYQ7kNvwF7FR9e&_nc_oc=AdodIgldphqslbT5pGllB8G-dVYa8J71zrXOY4gkWo5w2KBzE-TKI5DtDnQgHyhMTkU&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0OfgGC_tMQrysR_0oPUjK2ZBuxRQ6JV--HZgYgDvNhpw&oe=69E64636"}, {"file_name": "migrated_image.png", "id": "232049701277719", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39031573_300612900616775_6372420896648331264_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aeMJB570UvIQ7kNvwEdwruh&_nc_oc=Adr5oL2EZl-zlTg9RPIyHDSqggzWlAi3m7kSHRyJHcUy_O0gvLK6_ovfR8J7TjguN6c&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af08INMgl_lXkoiLk9GngRCxjLV0bfRubfceB8ajM7PaTw&oe=69E62EF6"}, {"file_name": "migrated_image.png", "id": "247467546430711", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974904_450907375650521_1262763278862385152_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H9aHR7kX8C8Q7kNvwEygObO&_nc_oc=Adra5g7S3snx2Qp1E31I62l8p_fl8uY808i_nXQi8spexvT-GJ57NTkFtmB3OoapSSk&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0QVLPOeTbgDHdVgHyolqAn3GqOtaI2J_lFor0TZ5enbg&oe=69E6448F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/MgJMBU", "id": "2379779072250886", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38982702_2379779075584219_634601862028328960_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hy6-4lKSwogQ7kNvwG8H4Lr&_nc_oc=AdrkkCOqEL2EQIxuEOqWjyYXfv_EwP0HWXy26t8YritHek_pw8Y9vy0kbMxMpTO4Z74&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3O5YvCwrA0IrUu70Ivt9y-ne4ExKyws4ctWGVR7mFxnQ&oe=69E61895"}, "display_name": "Into the Sky", "keywords": ["360", "interactive", "film", "documentary", "skydiving"], "long_description": "Skydiving, aerobatics, sunrise flights! Experience the adrenalin loaded daily live of three extreme athletes in the immersive 360\u00b0 film format. Ready for take off?\nInto the Sky documents the passion of a paraglider, an aerobatic pilot and a parachutist in 360\u00b0: Risking their lives during breathtaking maneuvers. Experience the film in the innovative 360\u00b0 format from the first person view with spatial audio and maximum immersion. \n\nIn addition to the linear film an interactive version which can be experienced with an app has been published . In this version the user can influence the course of the story or simply change the cameras perspective. \nA highlight in the interactive version is triggering the parachute jump. An interaction must be carried out at the right time which contributes to an increased tension. If the user interacts wrong he is thrown back in the plot.\n\nDownload the app now and epxerience the next level of interactive storytelling.", "short_description": "Skydiving, aerobatics, sunrise flights!\nJoin three extreme athletes in an adrenaline loaded interactive 360\u00b0 film."}]}, "developer_name": "Diego Montoya", "developer_privacy_policy_url": "https://www.vrdirect.com/imprint-privacy", "developer_terms_of_service_url": "https://auth.viond.io/legal/terms-and-conditions", "publisher_name": "VRdirect", "support_website_url": "https://www.vrdirect.com/support", "website_url": "https://www.vrdirect.com/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "EXPERIENCE_360_NON_GAME", "FLYING"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported
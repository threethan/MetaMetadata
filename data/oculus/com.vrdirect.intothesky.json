w&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5M88DZBcJ1uHuJWGzLz_Xx2I5MQS5cYwi9UcTrYF8hTA&oe=69FDDB7A"}, {"file_name": "migrated_image.png", "id": "504824483532921", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39035316_2084066765017365_7938336161401929728_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Lln0xZkms6oQ7kNvwHw6Gwm&_nc_oc=AdqS4fbt-wSYvF1fsG6C0suvh9SjvgRuPscDYSCFbZPH18w9y0dyq7MmMUfOpwkK_oQ&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4QV4qaNDR5yuxPBnxYa4AG1u_6ZbGdDonP_OOtPuj2EQ&oe=69FE0136"}, {"file_name": "migrated_image.png", "id": "232049701277719", "uri": "https://scontent-dfw5-3.oculuscdn.com/v/t64.5771-25/39031573_300612900616775_6372420896648331264_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b-Hs27Z5D4QQ7kNvwH8aFYt&_nc_oc=AdpjgeId8G6jPZPlMlpJVK7MGRlOxXA9XnDWl2bkgSXii0Dx-YJi8uqkbR2cwv4rtKE&_nc_zt=3&_nc_ht=scontent-dfw5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6YLbOl7ZQPa508HQhwLPsTeSGJ-AMulObsNL7NUa6jjQ&oe=69FDE9F6"}, {"file_name": "migrated_image.png", "id": "247467546430711", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974904_450907375650521_1262763278862385152_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7ft99BzodEAQ7kNvwFQ-gVy&_nc_oc=AdrOLqNFtGU4vn9XF1CF8G0mi4jqDlOt-P7DIW2yM3u8lKtm15FucGxix5Km32TK2tg&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5o1P6gnBbxi7jPLw9ztGZzaMiKVy-ywDVMq8APvtbLKw&oe=69FDFF8F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/MgJMBU", "id": "2379779072250886", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38982702_2379779075584219_634601862028328960_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9Vef8Yc4Dm8Q7kNvwGFSJ6q&_nc_oc=AdpR7TdY7wxTrI8Rgupy-8TSjxYLhPU1k2p_c1Gxkez4MJjfJoBi6nK56kSeiF7jbHs&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af55aHTLjgCPn_K8RiVZ99U1LAq8JEJJi2nZV0ABbID9dw&oe=69FDD395"}, "display_name": "Into the Sky", "keywords": ["360", "interactive", "film", "documentary", "skydiving"], "long_description": "Skydiving, aerobatics, sunrise flights! Experience the adrenalin loaded daily live of three extreme athletes in the immersive 360\u00b0 film format. Ready for take off?\nInto the Sky documents the passion of a paraglider, an aerobatic pilot and a parachutist in 360\u00b0: Risking their lives during breathtaking maneuvers. Experience the film in the innovative 360\u00b0 format from the first person view with spatial audio and maximum immersion. \n\nIn addition to the linear film an interactive version which can be experienced with an app has been published . In this version the user can influence the course of the story or simply change the cameras perspective. \nA highlight in the interactive version is triggering the parachute jump. An interaction must be carried out at the right time which contributes to an increased tension. If the user interacts wrong he is thrown back in the plot.\n\nDownload the app now and epxerience the next level of interactive storytelling.", "short_description": "Skydiving, aerobatics, sunrise flights!\nJoin three extreme athletes in an adrenaline loaded interactive 360\u00b0 film."}]}, "developer_name": "Diego Montoya", "developer_privacy_policy_url": "https://www.vrdirect.com/imprint-privacy", "developer_terms_of_service_url": "https://auth.viond.io/legal/terms-and-conditions", "publisher_name": "VRdirect", "support_website_url": "https://www.vrdirect.com/support", "website_url": "https://www.vrdirect.com/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "EXPERIENCE_360_NON_GAME", "FLYING"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported
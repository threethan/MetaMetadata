g&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJSQtAIaOVemTva6keVGdoNeJb3N3L3vSA1RpUSy0MzDA&oe=6A9AF63A"}, {"file_name": "migrated_image.png", "id": "504824483532921", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39035316_2084066765017365_7938336161401929728_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lveJrSFIsNEQ7kNvwG7Azv8&_nc_oc=AdoLXK80r0f2SFVAVUGrsSdQu7YO4acJojkd2a52RD59_31s4lfleA41Cbjr9A8arIc&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJWGaAvbu9UAuLt9OH84q0pp_8e4a_VcZnsxRzhXAmOcw&oe=6A9AE3B6"}, {"file_name": "migrated_image.png", "id": "232049701277719", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39031573_300612900616775_6372420896648331264_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uTxtv56fKxAQ7kNvwHtRTlM&_nc_oc=AdqYFFlh_bcf5XyMPJnfD2qpCNSm8YATzdDgOC6LQcX0rtaR9RvwUgkPJSgHLZhqHAI&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL73SoK_VlhiEx4Kdsm5IYTg4gd6U8xeVA8EXM8MTK1Jw&oe=6A9ACC76"}, {"file_name": "migrated_image.png", "id": "247467546430711", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974904_450907375650521_1262763278862385152_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qGD1m8N7PLEQ7kNvwGMPYtL&_nc_oc=AdrlV0bRtTdseRTYW6EZAq8h4dq-dRDDAMJXZ_oBAurhH88lFGEsUAQhLQ1J9heIIfA&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIeGugpMSHFEO7w_lYOBKAh-d2hUberCPffAJ_Bch8Okg&oe=6A9AE20F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/MgJMBU", "id": "2379779072250886", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38982702_2379779075584219_634601862028328960_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AGis8KhBpdoQ7kNvwH2FV8t&_nc_oc=AdrGJCm6GOlShC1SfBbMwOvpbB9AQQkAY5ZOQzXCCNeSGUSJUD_anWP6ByqMVhtsfHc&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIXSSx9YMUafb0oz_ckn6SEmdok2hJi7Po3WGs4MkZ-Dg&oe=6A9AEE55"}, "display_name": "Into the Sky", "keywords": ["360", "interactive", "film", "documentary", "skydiving"], "long_description": "Skydiving, aerobatics, sunrise flights! Experience the adrenalin loaded daily live of three extreme athletes in the immersive 360\u00b0 film format. Ready for take off?\nInto the Sky documents the passion of a paraglider, an aerobatic pilot and a parachutist in 360\u00b0: Risking their lives during breathtaking maneuvers. Experience the film in the innovative 360\u00b0 format from the first person view with spatial audio and maximum immersion. \n\nIn addition to the linear film an interactive version which can be experienced with an app has been published . In this version the user can influence the course of the story or simply change the cameras perspective. \nA highlight in the interactive version is triggering the parachute jump. An interaction must be carried out at the right time which contributes to an increased tension. If the user interacts wrong he is thrown back in the plot.\n\nDownload the app now and epxerience the next level of interactive storytelling.", "short_description": "Skydiving, aerobatics, sunrise flights!\nJoin three extreme athletes in an adrenaline loaded interactive 360\u00b0 film."}]}, "developer_name": "Diego Montoya", "developer_privacy_policy_url": "https://www.vrdirect.com/imprint-privacy", "developer_terms_of_service_url": "https://auth.viond.io/legal/terms-and-conditions", "publisher_name": "VRdirect", "support_website_url": "https://www.vrdirect.com/support", "website_url": "https://www.vrdirect.com/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "EXPERIENCE_360_NON_GAME", "FLYING"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported
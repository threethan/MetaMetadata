M&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af60BGKj55r8eAjCacl-eQ6fIDdMZc-LcB1tCl68MdKjDw&oe=69F9E6FA"}, {"file_name": "migrated_image.png", "id": "504824483532921", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39035316_2084066765017365_7938336161401929728_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xxeK_wJELP0Q7kNvwEDMhOo&_nc_oc=Adr_DtAS3QB4ItRtN7v428Oe0GJiySFJ2Cjo8CqjmpTpGOa_GtUhGiky0jjmzlwnCp0&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4f4n-wBWA_ZNsNElP2uxWB0y-nv871dklj4M8EKsFVTA&oe=69FA0CB6"}, {"file_name": "migrated_image.png", "id": "232049701277719", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031573_300612900616775_6372420896648331264_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9h-AerRyfg4Q7kNvwGvpROy&_nc_oc=AdoBu_D7P1s7EblBMtQ-aXgCzId6syWZjNJo5n8bcHz7nSHcSijez4JA2hS4o4TDt2o&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7h2Nt_f3z34ypqyeW3JftH0SevFrmdavdh-X_2wnNfCw&oe=69F9F576"}, {"file_name": "migrated_image.png", "id": "247467546430711", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974904_450907375650521_1262763278862385152_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yhgPH_mO1psQ7kNvwGZYwYK&_nc_oc=Adq3_Zn8RZfI-dTF7LEyIa5EwjyYd_OVxYH8V_5U2hhW4PPBkZPRCnjhZ1ddLPC68XU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4cOHw73Dz45ZuCzvrIw5bK10yKaZ5wPOnGmFYUMy5vmA&oe=69FA0B0F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/MgJMBU", "id": "2379779072250886", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982702_2379779075584219_634601862028328960_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A2hWhkZdxZUQ7kNvwFc3pQC&_nc_oc=AdpjKlJLG1-KkFu2brRgaZ8jv7SOmkUnglCx6eIkspv2mc_44w4n3Kf9eP4Fest8e3o&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4p5-ZfkGxVrI4ySYDIQ4HI-0dxvf4JEHcrERgICvnteQ&oe=69F9DF15"}, "display_name": "Into the Sky", "keywords": ["360", "interactive", "film", "documentary", "skydiving"], "long_description": "Skydiving, aerobatics, sunrise flights! Experience the adrenalin loaded daily live of three extreme athletes in the immersive 360\u00b0 film format. Ready for take off?\nInto the Sky documents the passion of a paraglider, an aerobatic pilot and a parachutist in 360\u00b0: Risking their lives during breathtaking maneuvers. Experience the film in the innovative 360\u00b0 format from the first person view with spatial audio and maximum immersion. \n\nIn addition to the linear film an interactive version which can be experienced with an app has been published . In this version the user can influence the course of the story or simply change the cameras perspective. \nA highlight in the interactive version is triggering the parachute jump. An interaction must be carried out at the right time which contributes to an increased tension. If the user interacts wrong he is thrown back in the plot.\n\nDownload the app now and epxerience the next level of interactive storytelling.", "short_description": "Skydiving, aerobatics, sunrise flights!\nJoin three extreme athletes in an adrenaline loaded interactive 360\u00b0 film."}]}, "developer_name": "Diego Montoya", "developer_privacy_policy_url": "https://www.vrdirect.com/imprint-privacy", "developer_terms_of_service_url": "https://auth.viond.io/legal/terms-and-conditions", "publisher_name": "VRdirect", "support_website_url": "https://www.vrdirect.com/support", "website_url": "https://www.vrdirect.com/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "EXPERIENCE_360_NON_GAME", "FLYING"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported
k&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-BRA4YpP7pabyF7lGkdNp4riBvK1GbVPUmDBMeHHfS2A&oe=6A3EAD3A"}, {"file_name": "migrated_image.png", "id": "504824483532921", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39035316_2084066765017365_7938336161401929728_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Fg1cKesgET4Q7kNvwEgGRaK&_nc_oc=AdoD1ae6x8yWoknJJjkN-H8c-qHeP6G1IoamdInb_zegbmypucFr0aeKm_qgjgcYgHg&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-buro_q69H7xC0fo8Ps7ie1izqx46AaVioqMBNmqYCxw&oe=6A3E9AB6"}, {"file_name": "migrated_image.png", "id": "232049701277719", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031573_300612900616775_6372420896648331264_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_RBT7w1b35QQ7kNvwHhCeuk&_nc_oc=AdrD8kC46egSViBXvj5Ol9xhLr2NmNTKNc_FoicT5DHn55_1KV4-jj7fCXjEb2nsX-U&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-VSFa0BHE2NCTJZ6BNzEO-DsUZ_Cewdyh8nkAUUXJRlw&oe=6A3E8376"}, {"file_name": "migrated_image.png", "id": "247467546430711", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974904_450907375650521_1262763278862385152_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OM307ptaDoYQ7kNvwEvC8m4&_nc_oc=Adq_66GV6v4rIgkLlxG66Q4x7PyypI_I0zbKpUIhoRTqzBzXu2MpRgo82RRwlXrDbSM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_7wgLZNCGs2s8zMLATlLE6ZGfAOSG1GaWKcFU9tzzWLA&oe=6A3E990F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/MgJMBU", "id": "2379779072250886", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982702_2379779075584219_634601862028328960_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dh5bxwkpdWgQ7kNvwH0pXMY&_nc_oc=Adr05rZlzPw3begftB3FplCrlTZIE1hHfOazVe2ewWq_SSTTXIEOGiPuY7STrTIGHlI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9FYgFFSb2JjmkSJ1TlgqrBYX6IH5m6sxlrVAIyXtC_sA&oe=6A3EA555"}, "display_name": "Into the Sky", "keywords": ["360", "interactive", "film", "documentary", "skydiving"], "long_description": "Skydiving, aerobatics, sunrise flights! Experience the adrenalin loaded daily live of three extreme athletes in the immersive 360\u00b0 film format. Ready for take off?\nInto the Sky documents the passion of a paraglider, an aerobatic pilot and a parachutist in 360\u00b0: Risking their lives during breathtaking maneuvers. Experience the film in the innovative 360\u00b0 format from the first person view with spatial audio and maximum immersion. \n\nIn addition to the linear film an interactive version which can be experienced with an app has been published . In this version the user can influence the course of the story or simply change the cameras perspective. \nA highlight in the interactive version is triggering the parachute jump. An interaction must be carried out at the right time which contributes to an increased tension. If the user interacts wrong he is thrown back in the plot.\n\nDownload the app now and epxerience the next level of interactive storytelling.", "short_description": "Skydiving, aerobatics, sunrise flights!\nJoin three extreme athletes in an adrenaline loaded interactive 360\u00b0 film."}]}, "developer_name": "Diego Montoya", "developer_privacy_policy_url": "https://www.vrdirect.com/imprint-privacy", "developer_terms_of_service_url": "https://auth.viond.io/legal/terms-and-conditions", "publisher_name": "VRdirect", "support_website_url": "https://www.vrdirect.com/support", "website_url": "https://www.vrdirect.com/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "EXPERIENCE_360_NON_GAME", "FLYING"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported
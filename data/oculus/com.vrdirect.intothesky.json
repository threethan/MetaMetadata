o&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5WghlNEHQF1H1n-aOwHMiqig6MbLbfs27BzGDNP4DtCQ&oe=6A1ED0FA"}, {"file_name": "migrated_image.png", "id": "504824483532921", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39035316_2084066765017365_7938336161401929728_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LqtWiLmzfnsQ7kNvwEUibml&_nc_oc=Adrusl0KgD2NNnQWq9Gux9FRzb9V77bKAT9KJyLxkksMABzTe068RJdNLPD6Qz0-HFo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7SiLghL88779FzXvs_IejjhcH76Kv-qtcLqkt1cnzRJg&oe=6A1EF6B6"}, {"file_name": "migrated_image.png", "id": "232049701277719", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031573_300612900616775_6372420896648331264_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6D_r1AuAk0QQ7kNvwGfQHJY&_nc_oc=AdopWfln7CKKRTBgrFnJHsHVg3_9lNngkkxoHbeSXX43Ue2Sip3PzHoZNNFreoqQx0Y&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7mHO1RZZOawDgPbHkG9n6KDcK6zy9dqG3DWwjerLNHzw&oe=6A1EDF76"}, {"file_name": "migrated_image.png", "id": "247467546430711", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974904_450907375650521_1262763278862385152_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vvKNhlctOJUQ7kNvwFtJFiG&_nc_oc=AdrBOPJuA_FMewaCVSUttJykxICNiwj1lFdzQEGBL3Uuob4k0nSWPj2h_sbx34EosR0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5QgE7L_4vs9_PVdRulDrQcadfBCedrf3-xW95Si1GPOQ&oe=6A1EF50F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/MgJMBU", "id": "2379779072250886", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982702_2379779075584219_634601862028328960_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=86IHCjpR30EQ7kNvwHr5xCR&_nc_oc=Adqz3610LED-yMU1cmYratbzlFp9P1_2sefODc2r95N2l452X7L5XxrpRKER_byTx3I&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5n-XXf4kSWeHiW0GaGBbDIdsHj2jQ_0aGpBbOVaDCTeA&oe=6A1EC915"}, "display_name": "Into the Sky", "keywords": ["360", "interactive", "film", "documentary", "skydiving"], "long_description": "Skydiving, aerobatics, sunrise flights! Experience the adrenalin loaded daily live of three extreme athletes in the immersive 360\u00b0 film format. Ready for take off?\nInto the Sky documents the passion of a paraglider, an aerobatic pilot and a parachutist in 360\u00b0: Risking their lives during breathtaking maneuvers. Experience the film in the innovative 360\u00b0 format from the first person view with spatial audio and maximum immersion. \n\nIn addition to the linear film an interactive version which can be experienced with an app has been published . In this version the user can influence the course of the story or simply change the cameras perspective. \nA highlight in the interactive version is triggering the parachute jump. An interaction must be carried out at the right time which contributes to an increased tension. If the user interacts wrong he is thrown back in the plot.\n\nDownload the app now and epxerience the next level of interactive storytelling.", "short_description": "Skydiving, aerobatics, sunrise flights!\nJoin three extreme athletes in an adrenaline loaded interactive 360\u00b0 film."}]}, "developer_name": "Diego Montoya", "developer_privacy_policy_url": "https://www.vrdirect.com/imprint-privacy", "developer_terms_of_service_url": "https://auth.viond.io/legal/terms-and-conditions", "publisher_name": "VRdirect", "support_website_url": "https://www.vrdirect.com/support", "website_url": "https://www.vrdirect.com/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "EXPERIENCE_360_NON_GAME", "FLYING"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported
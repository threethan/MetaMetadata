w&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5A8HBMf4ZeaXQ9PJ97bYvWuujfKdUmktxOBCr0c52-SA&oe=6A18397A"}, {"file_name": "migrated_image.png", "id": "504824483532921", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39035316_2084066765017365_7938336161401929728_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aeRoKSicGUEQ7kNvwE-vcGg&_nc_oc=AdpK7H2g1Ohk_4Q9oQBDSVbpSQ0_SUJ4hEQmYcuOHHIjelb0xvAZz0foEuXsJKytOOY&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af52kmp9xWWoYtcfgdJMahnj2KkT15xfvlegnQ8LSwI4jA&oe=6A185F36"}, {"file_name": "migrated_image.png", "id": "232049701277719", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39031573_300612900616775_6372420896648331264_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hGEvKVaBAoMQ7kNvwHL41Z8&_nc_oc=Adru63lmSawaDpqJYmfmGEYPlf6-UyNiRKi33GzyZmpRkkPg5VfFL9L--kqx5K7OR7A&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5abTCr12NFtkrFiylvzFp3XuYW4YpM0BK8IoPGkZ4fAA&oe=6A1847F6"}, {"file_name": "migrated_image.png", "id": "247467546430711", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974904_450907375650521_1262763278862385152_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GI-zhQNgO7wQ7kNvwG5z6AU&_nc_oc=AdooRehBAfAU7n_7DTxRxx3aDeK2T-6uu_Q39XT_tb7tENF2nUd02evCQ3qOC8cKp4o&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7qphg9VmzvvSUH25qQ4Tz6SBzbVCMrjhWvFVXbEIGsnQ&oe=6A185D8F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/MgJMBU", "id": "2379779072250886", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982702_2379779075584219_634601862028328960_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hynhj-jU_d4Q7kNvwEYw0QS&_nc_oc=AdqGKifdP-0kXayY1L431VlginNAPdbMxv9DA2Ggn70065hL5SMvKvMIrSlUayaCumM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6Lc9FvVbsI8d8RpbXS3XYuDd3fVyj0fkOUWDcywxyp-g&oe=6A1869D5"}, "display_name": "Into the Sky", "keywords": ["360", "interactive", "film", "documentary", "skydiving"], "long_description": "Skydiving, aerobatics, sunrise flights! Experience the adrenalin loaded daily live of three extreme athletes in the immersive 360\u00b0 film format. Ready for take off?\nInto the Sky documents the passion of a paraglider, an aerobatic pilot and a parachutist in 360\u00b0: Risking their lives during breathtaking maneuvers. Experience the film in the innovative 360\u00b0 format from the first person view with spatial audio and maximum immersion. \n\nIn addition to the linear film an interactive version which can be experienced with an app has been published . In this version the user can influence the course of the story or simply change the cameras perspective. \nA highlight in the interactive version is triggering the parachute jump. An interaction must be carried out at the right time which contributes to an increased tension. If the user interacts wrong he is thrown back in the plot.\n\nDownload the app now and epxerience the next level of interactive storytelling.", "short_description": "Skydiving, aerobatics, sunrise flights!\nJoin three extreme athletes in an adrenaline loaded interactive 360\u00b0 film."}]}, "developer_name": "Diego Montoya", "developer_privacy_policy_url": "https://www.vrdirect.com/imprint-privacy", "developer_terms_of_service_url": "https://auth.viond.io/legal/terms-and-conditions", "publisher_name": "VRdirect", "support_website_url": "https://www.vrdirect.com/support", "website_url": "https://www.vrdirect.com/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "EXPERIENCE_360_NON_GAME", "FLYING"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported
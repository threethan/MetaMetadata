I&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4Y1l6UOjck5OJmfKEdLhGyX7Mu2XfG8Uo7N02V_tLWIg&oe=6A1C2DFA"}, {"file_name": "migrated_image.png", "id": "504824483532921", "uri": "https://scontent-lhr8-2.oculuscdn.com/v/t64.5771-25/39035316_2084066765017365_7938336161401929728_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DzgPp0uJkxEQ7kNvwHF2YKS&_nc_oc=Adp1nvLiC_xksRMVbnOZ9d0ksnhBcInj4XXcy3YUQNRUVwcGsYavu2cySIXrXs43G5g&_nc_zt=3&_nc_ht=scontent-lhr8-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6bXsJGjUOObgvn_CvAlh91wMcKRcHK1vJRRhnzy_e7Hw&oe=6A1C53B6"}, {"file_name": "migrated_image.png", "id": "232049701277719", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/39031573_300612900616775_6372420896648331264_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Dq4v76GWF8gQ7kNvwG-ltR9&_nc_oc=Adolqdk8GGwoY9Q3OR-3w8huOH1hCmhM2J6K9IB-VPUt3mGeTkCjYuFQRrnE-FLeTzY&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5Zge-L0z_GZ7iXDLNhO0gfLz7NlH7fRibGBe4athnnIA&oe=6A1C3C76"}, {"file_name": "migrated_image.png", "id": "247467546430711", "uri": "https://scontent-lhr8-2.oculuscdn.com/v/t64.5771-25/38974904_450907375650521_1262763278862385152_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_Tcp0vtQf0QQ7kNvwG7BjsI&_nc_oc=AdoThjPml8lzLjDUP-aXTcoLqtRMkaIFASKLwrfpU-tdClsguPeuK8I0yaednuNUFRY&_nc_zt=3&_nc_ht=scontent-lhr8-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4m_GrxXlt97-W_-2hYVUS9BewoI4-hKJVEbBsrRIjdnA&oe=6A1C520F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/MgJMBU", "id": "2379779072250886", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/38982702_2379779075584219_634601862028328960_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YyzEgwQK_7sQ7kNvwGRefjx&_nc_oc=AdpaqeHGN4AK1KNAiCyOxmFNZmGoFGgBaStD6UpcKQhIirlNNXNyk-bxylNtzlA61ls&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af47fO_EftqMleZ47Hg4z4vjN-FstpZTlmMTAipa5pYrfg&oe=6A1C5E55"}, "display_name": "Into the Sky", "keywords": ["360", "interactive", "film", "documentary", "skydiving"], "long_description": "Skydiving, aerobatics, sunrise flights! Experience the adrenalin loaded daily live of three extreme athletes in the immersive 360\u00b0 film format. Ready for take off?\nInto the Sky documents the passion of a paraglider, an aerobatic pilot and a parachutist in 360\u00b0: Risking their lives during breathtaking maneuvers. Experience the film in the innovative 360\u00b0 format from the first person view with spatial audio and maximum immersion. \n\nIn addition to the linear film an interactive version which can be experienced with an app has been published . In this version the user can influence the course of the story or simply change the cameras perspective. \nA highlight in the interactive version is triggering the parachute jump. An interaction must be carried out at the right time which contributes to an increased tension. If the user interacts wrong he is thrown back in the plot.\n\nDownload the app now and epxerience the next level of interactive storytelling.", "short_description": "Skydiving, aerobatics, sunrise flights!\nJoin three extreme athletes in an adrenaline loaded interactive 360\u00b0 film."}]}, "developer_name": "Diego Montoya", "developer_privacy_policy_url": "https://www.vrdirect.com/imprint-privacy", "developer_terms_of_service_url": "https://auth.viond.io/legal/terms-and-conditions", "publisher_name": "VRdirect", "support_website_url": "https://www.vrdirect.com/support", "website_url": "https://www.vrdirect.com/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "EXPERIENCE_360_NON_GAME", "FLYING"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported
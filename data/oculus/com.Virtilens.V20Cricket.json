cdn.com&_nc_ss=7f20f&oh=00_Af8vgtAk-mnsSxxtSVvlVj33zEPZ41a-Kk8XjEVEPuf66Q&oe=6A36C0F0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "4.png", "id": "935316157376392", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/38982466_935316160709725_8298787324303187933_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RQ-pnRcM3iAQ7kNvwHu5m4E&_nc_oc=Adqba6JVsa2BjVfAlErOTc_bquuHa3_nrRaizH4lxpwQbNJqax2o4Cciz6yPNqLpyK8&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_fEikzG51zVzy3tvQKSgzHoLWNRV-HNAcG9EFbkKBJmA&oe=6A36B310"}, "display_name": "V20 Cricket", "keywords": [], "long_description": "V20 Cricket is the best Virtual reality cricket game for all ages! \n\nWelcome to the future of cricket. In this immersive Virtual cricket simulator, you can bat in different match scenarios, chase down targets and be the master of your own stadium! \n\nYou\u2019re front and centre, in a true to life stadium with panoramic 360 degree views. World-class bowling, phenomenal fielding and a 100,000 roaring fans with just two overs to go \u2043 Are you up for it? Of course you are, the virtual world is your oyster!\n\nFeatures: \n\n\t\u2043\t3600 immersive virtual environments\n\t\u2043\tVarious difficulty levels - Beginner, Intermediate, Semi-Pro, Professional along with a Practise Mode to get you on your way\n\t\u2043\t5 leagues - Face Pacers, Leg Spinners, Off Spinners, Swing bowlers & even Mystery spinners \n\t\u2043\tState of the art graphics & animation\n\u2043 \tProfessional Commentary\n", "short_description": "V20 Cricket is the best Virtual reality cricket game for all ages!"}]}, "developer_name": "VirtiLens", "developer_privacy_policy_url": "https://gamepolicy.s3.ap-south-1.amazonaws.com/privacypolicy.html", "developer_terms_of_service_url": null, "publisher_name": "VirtiLens", "support_website_url": null, "website_url": "http://www.virtilens.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category
Q7kNvwH8iZnq&_nc_oc=AdoeVX1GJhBcnW-EDu-g3EeDIafDxepkEeC6u-4JHBo98E5RoHU9iw46z7IGkFRWOY0&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM4c_5V6g5R37tBiSihUV3EU0DYxh31Y8qYDnrG1EFsYA&oe=6AC7AD67"}, {"file_name": "23_imresizer.png", "id": "1817327372299647", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/499299808_1817327375632980_4778280729702047183_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_XlmRkmgF7AQ7kNvwELdhO7&_nc_oc=AdpbKi5TDlO8mCap35KoPJ3VwYf672pzSbaJZIKx5YZpws0NyaU7Sns5kKO86TLKIEE&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMVOO-09sZdZCjjo_rcuK7uyekKkcR0-zr9t_GpMjVoNw&oe=6AC79BF8"}, {"file_name": "67_imresizer.png", "id": "1446572530362905", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/491820001_1446572533696238_691526597876573068_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rYyN1lxoS3kQ7kNvwHgDS3u&_nc_oc=AdoI11A5ucnTMQX_qPCe0xqgbI-WbLU3kL6PyDBlEdm0CAUXQYrX7IHeFuulOqrCYdE&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP4X1ySQM4ZOZJU7S6za1wXgidWSqMfyP6ibvrP1FWG5Q&oe=6AC7AEEC"}, {"file_name": "buc_imresizer.png", "id": "894583633267185", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499303746_894583643267184_1782360378623414673_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ljMjglFxQcAQ7kNvwHJ6bnn&_nc_oc=AdoiNcfgBhm5fiYF8Saqf_sm_ecS-sfK3ec4DEZ8bXGt97lG3FXSRvt1_Yf5zS8LEj4&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNl_XYUR2yOCrtoPzgSlk3sc6YAwhwznPPUt2e29nQLSQ&oe=6AC7BB26"}, {"file_name": "IS61_imresizer.png", "id": "838265509273239", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/499307311_838265512606572_5321261658852618980_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SkYnsaWSKIUQ7kNvwHfLAY9&_nc_oc=AdoFLCFm2krdcxAoRBqFjqxe6sCPGHOQNEj7EXAA2uTB-0mKzfDaUOgHDVgo40bIjCg&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOERzCveVAc-vkLAc_rsKLhglaI_FVBPy0lWcj8E0gjEQ&oe=6AC7BB01"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Primal Fear VR Reimaged", "keywords": [], "long_description": "Primal Fear VR Reimaged is a survival horror experience built around tension, sound, and instinct. Set deep beneath the surface in a decaying underground facility, the game challenges you to explore hostile environments while managing fear, resources, and risk.\n\nA map helps you navigate the facility\u2019s interconnected areas, but knowing where you are doesn\u2019t guarantee safety. Exploration is dangerous, and every step forward carries uncertainty.\n\nTwo monsters dominate the underground:\n\nCupcake roams a pitch-black cave system. Legless and constantly trembling, it drags itself across the stone with unsettling speed. It reacts to sound and will relentlessly chase anything it detects, turning darkness into a constant threat.\n\nMeatman hunts within a claustrophobic meat maze of tight corridors and confusing paths. Armless but tireless, it pursues endlessly once it finds you, forcing you to keep moving and think fast to survive.\n\nScattered throughout the facility are safe zones\u2014rare areas where the monsters cannot enter. These spaces offer brief relief, a chance to plan your next move, and prepare before stepping back into danger.\n\nWith limited resources, hostile environments, and ever-present threats, Primal Fear VR Reimaged is about surviving fear itself\u2014and deciding when to move, hide, or run.", "short_description": "Primal Fear VR Reimaged is a survival horror game set in a ruined underground facility where instinct is everything. Scavenge, hide, or run\u2014every mistake could be fatal.\n\nTwo monsters hunt you:\n\nCupcake \u2014 a legless creature that trembles and drags itself through a pitch-black cave, chasing any sound it detects.\n\nMeatman \u2014 an armless pursuer that stalks endlessly through a twisting meat maze, forcing constant movement.\n\nNo map. No safety.\nOnly fear."}]}, "developer_name": null, "developer_p
scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHff0uMuuyn4olXXQJVsUU5t_biwGK8LOUWD7ai-ORFjA&oe=6A75D389"}, {"file_name": "6.png", "id": "777385735058353", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491819980_777385738391686_5307196286003395720_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Bg8gTTEyfbQQ7kNvwF9ggzW&_nc_oc=AdrmzB57d71YNvmE4TVR7hoo1975V6i0EeD2AZGrDrJU745qubWWaDhEw_H9NumwQrk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFIawEZliw4CpfmD9E4ZfRd0e9mq7KBiH_I3M24sBUPnA&oe=6A75C77A"}, {"file_name": "5.png", "id": "1366093065034882", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499304162_1366093068368215_4537848791137492154_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KtIXpzjmkyEQ7kNvwElFD8G&_nc_oc=Adrj8tbIur9oFXepDZS1xqoDCu9FdyIdRzlbZYJF8uN_3IgbkvlC14X-lUcKLsRKW0E&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH1-7k6jgcDGADhPjoxTb1UAGYzhDlJYOGQBVlLB5PTVw&oe=6A75F34D"}, {"file_name": "3.png", "id": "1548329579913827", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499303679_1548329583247160_990004163888646919_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rUWAduoTJvUQ7kNvwG1Jqzd&_nc_oc=AdpZew1iOWaIS8h7uk3mJuFToKDCvklN2MLnKqz4n56r6Hfuz3VEijGN6-viD_ZgyPQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFpMQ3q7InSTRuNthD-_U2wci3o-RsZhH7S0Fycgo4s_A&oe=6A75E84C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Zombie Horde VR Survival Apocalypse", "keywords": ["apocalypse", "zombie", "survival", "shooting", "fighting"], "long_description": "Zombie Horde VR: Survival Apocalypse is an intense VR zombie apocalypse shooter that defines virtual reality survival horror. Step into a collapsing world filled with chaos, fear, and endless zombie hordes. Fight to survive the ultimate apocalyptic outbreak in this action-packed VR zombie survival game built for Meta Quest. Experience brutal zombie combat, realistic gun mechanics, and nonstop apocalypse survival in full virtual reality.\n\nBattle through waves of undead enemies with powerful weapons and precision VR shooting gameplay. Every moment is a fight for your life in a terrifying zombie apocalypse world where danger surrounds you. Choose your challenge: Level Mode, a mission based story through infected cities and ruined landscapes, or Endless Mode, a nonstop VR wave shooter that tests your endurance against infinite hordes.\n\nWith immersive VR horror action, dynamic zombie defense, and intense apocalyptic combat, every battle feels real. Reload, aim, and survive as the undead close in. Master weapons, manage resources, and conquer the zombie apocalypse survival challenge.\n\nDesigned for fans of VR horror games, VR action shooters, and zombie apocalypse survival, this game delivers adrenaline-charged VR gunplay and full-scale virtual reality combat. The apocalypse has begun. The zombies are rising. Fight, survive, and reclaim the world in Zombie Horde VR: Survival Apocalypse.", "short_description": "Zombie Horde VR: Survival Apocalypse delivers the ultimate VR zombie shooter survival experience. Enter a terrifying virtual reality apocalypse, face endless undead hordes, and fight for your life with powerful weapons and intense VR gunplay. Experience realistic horror, wave-based combat, and immersive 360\u00b0 survival action in this heart-pounding VR zombie apocalypse shooter built for true VR horror survival fans."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/rebelsgamestudio/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Rebels Studio", "support_website_url": null, "website_url": "https://sites.google.com/view/rebelsgamestudio", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}, {"id": "26
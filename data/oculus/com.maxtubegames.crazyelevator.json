doqXz0aYGJAr4_2PBxwUV_gIDE1FoHA9FfcWYBvJyQxLZpdi7uEtLoRP2UN_6c5aJI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRMxfE1VhCPREf_S-SOwwYv2WhYS571MUJKSqb8W4yK-g&oe=6AF72960"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560 4.png", "id": "3701427946672940", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499313110_3701427950006273_8789395844166246322_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Teunz8D2aBoQ7kNvwHD2wBN&_nc_oc=AdoHjl01z8_gz-x9hqQh-gSOdOLo8RrWsdEg3ksVHUbU5JSBd2D_rckfkRLzJHP-CA4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQltA8-vZ9kbnE5w5J75lGPPu-i9D6VDpF4zWTjoMj0fg&oe=6AF71554"}, "display_name": "Crazy Elevator", "keywords": ["elevator", "vr", "prank", "heights", "suspense"], "long_description": "Crazy Elevator is a short immersive VR experience built around suspense, surprise and a dangerous elevator prank.\n\nEnter the elevator, interact with its controls and discover what happens when you press the wrong button. Alarms activate, the environment changes and the elevator leads you into an unexpected high-altitude situation.\n\nWalk carefully, react to the warning signs and face a narrow path suspended above the city.\n\nFeatures:\n\u2022 Interactive elevator controls\n\u2022 Suspense and prank-style surprises\n\u2022 High-altitude VR moments\n\u2022 Atmospheric alarms and sound effects\n\u2022 Immersive first-person experience\n\u2022 Designed for Meta Quest\n{2130489561212854}", "short_description": "A suspenseful VR elevator prank where one wrong button can send you straight into a terrifying high-altitude surprise."}]}, "developer_name": null, "developer_privacy_policy_url": "https://davisamuelmaxkids.com.br/politicadeprivacidade.html", "developer_terms_of_service_url": null, "publisher_name": "MaxtubeGamesVR", "support_website_url": null, "website_url": "https://davisamuelmaxkids.com.br/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], 
dpmdtDPQ5gbKKtP0bM22GlbU3lfe5bP6A5zUt5Acvz0cGs_vzQNaKX0LMfszpCOCSc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSpjsN1Q_wnh9Z9fLnYhwKCYclEcf4OhV9Lv9IsNscAHw&oe=6AF5D7E0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560 4.png", "id": "3701427946672940", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499313110_3701427950006273_8789395844166246322_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Teunz8D2aBoQ7kNvwFl82Ok&_nc_oc=Adqjwe9xDMiOUBqImT90-u7jkKfgz-pifmsFMV1Ioa97ePhQYSQJd0DJ9wkerCQrnDU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTOjk5vzXpViXJKxziS4d3kqZGiMCmqt4SGE7-Duvoo3Q&oe=6AF5C3D4"}, "display_name": "Crazy Elevator", "keywords": ["elevator", "vr", "prank", "heights", "suspense"], "long_description": "Crazy Elevator is a short immersive VR experience built around suspense, surprise and a dangerous elevator prank.\n\nEnter the elevator, interact with its controls and discover what happens when you press the wrong button. Alarms activate, the environment changes and the elevator leads you into an unexpected high-altitude situation.\n\nWalk carefully, react to the warning signs and face a narrow path suspended above the city.\n\nFeatures:\n\u2022 Interactive elevator controls\n\u2022 Suspense and prank-style surprises\n\u2022 High-altitude VR moments\n\u2022 Atmospheric alarms and sound effects\n\u2022 Immersive first-person experience\n\u2022 Designed for Meta Quest\n{2130489561212854}", "short_description": "A suspenseful VR elevator prank where one wrong button can send you straight into a terrifying high-altitude surprise."}]}, "developer_name": null, "developer_privacy_policy_url": "https://davisamuelmaxkids.com.br/politicadeprivacidade.html", "developer_terms_of_service_url": null, "publisher_name": "MaxtubeGamesVR", "support_website_url": null, "website_url": "https://davisamuelmaxkids.com.br/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], 
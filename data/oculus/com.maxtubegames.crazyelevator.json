.5771-25/499308046_2058031015079837_6652173448990017663_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WeFv866DXTcQ7kNvwEFFLZx&_nc_oc=AdqtMrOoVJhFJ4KDy1X4zJgKT-nKJ00j0c8lcpsvRozjAe_yXRVEQT2jA05VzJuS_EA&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTqNHl4QF2UBieKN7V42gHXG7-MaHKW88IZPBYyndpt0Q&oe=6B099E60"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560 4.png", "id": "3701427946672940", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499313110_3701427950006273_8789395844166246322_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fJkglkPwy24Q7kNvwGYQPYH&_nc_oc=Adph0jRn-7OtD7ymYRPzASTg7_LCcrRZ6t8ZUJX0TwnL0RHh3evxBqTEFm_HrVFDdcI&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTWN7YdpF_eGlcfrbNvV3MjpVSVEMHgzowdZLhGQFLuQQ&oe=6B09C294"}, "display_name": "Crazy Elevator", "keywords": ["elevator", "vr", "prank", "heights", "suspense"], "long_description": "Crazy Elevator is a short immersive VR experience built around suspense, surprise and a dangerous elevator prank.\n\nEnter the elevator, interact with its controls and discover what happens when you press the wrong button. Alarms activate, the environment changes and the elevator leads you into an unexpected high-altitude situation.\n\nWalk carefully, react to the warning signs and face a narrow path suspended above the city.\n\nFeatures:\n\u2022 Interactive elevator controls\n\u2022 Suspense and prank-style surprises\n\u2022 High-altitude VR moments\n\u2022 Atmospheric alarms and sound effects\n\u2022 Immersive first-person experience\n\u2022 Designed for Meta Quest\n{2130489561212854}", "short_description": "A suspenseful VR elevator prank where one wrong button can send you straight into a terrifying high-altitude surprise."}]}, "developer_name": null, "developer_privacy_policy_url": "https://davisamuelmaxkids.com.br/politicadeprivacidade.html", "developer_terms_of_service_url": null, "publish
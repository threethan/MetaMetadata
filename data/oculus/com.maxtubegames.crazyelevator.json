.5771-25/499308046_2058031015079837_6652173448990017663_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CY6p2aiGyJEQ7kNvwGGAed6&_nc_oc=AdooVr81BKmnx6-Z7eZRBuFYEmkDQhBAYpXUyj5uK_ZxRlGfP1GXusSln9fy-boK-5k&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWosgCtwqy0qAsGpoTPPApBVfAOC9-b1lkKWmm4AIRInQ&oe=6B1035E0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560 4.png", "id": "3701427946672940", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499313110_3701427950006273_8789395844166246322_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e5zD_CLk9LMQ7kNvwHQ9Bnq&_nc_oc=Adp6JUJteRFd2dhH3743suv4Xvb09SkY-z9cyXgxEjrn7XBePWht1Rax_Yk6KhJj1L4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVQZkWWTCSOxvG-wnqHZU0S3eVbT5a7_JHvHYynBHjQjw&oe=6B105A14"}, "display_name": "Crazy Elevator", "keywords": ["elevator", "vr", "prank", "heights", "suspense"], "long_description": "Crazy Elevator is a short immersive VR experience built around suspense, surprise and a dangerous elevator prank.\n\nEnter the elevator, interact with its controls and discover what happens when you press the wrong button. Alarms activate, the environment changes and the elevator leads you into an unexpected high-altitude situation.\n\nWalk carefully, react to the warning signs and face a narrow path suspended above the city.\n\nFeatures:\n\u2022 Interactive elevator controls\n\u2022 Suspense and prank-style surprises\n\u2022 High-altitude VR moments\n\u2022 Atmospheric alarms and sound effects\n\u2022 Immersive first-person experience\n\u2022 Designed for Meta Quest\n{2130489561212854}", "short_description": "A suspenseful VR elevator prank where one wrong button can send you straight into a terrifying high-altitude surprise."}]}, "developer_name": null, "developer_privacy_policy_url": "https://davisamuelmaxkids.com.br/politicadeprivacidade.html", "developer_terms_of_service_url": null, "publish
&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2SVv0pWtGVIQ7kNvwFUvd64&_nc_oc=AdpXCibAI1T6PWs36tIO0f8X52M3zzdEIFz2203l70tHwTZuMiG4qKiTxRF-21Tg_wM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSEL7y_Zj8z3qc08vDdVCdC9SmmT6oAwnpc9aM4gYesMQ&oe=6B04784E"}, {"file_name": "3.png", "id": "1223032906067046", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491821008_1223032909400379_459275864106183571_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wLm6v57OMJsQ7kNvwEO6bNI&_nc_oc=Adq8WVJDlYrwyPpRmRQExMYgwK6ujwSlM3v6hn4Xjns1xny8LwWhWW2yWYw17nHwY7c&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRPGV8fEBwIFsStJjird5E1FRAkV_ym_ALudqsu7VvQig&oe=6B04576E"}, {"file_name": "5.png", "id": "1839733243487980", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391920_1839733246821313_6977900891814834568_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RU1D2KR_SLgQ7kNvwEh3ORr&_nc_oc=Adr0JxerlMJKO4nDfqZ8fFMD7iWwlCff1I-HZqNqRQy2bPbxsqPpPWi3fQ7Bjwoi2IU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTfKDulfnFL5wI2W-CgRmF6934zHZwTpthrykY6mbDslA&oe=6B045421"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Ocean Sim", "keywords": ["Ocean", "Simulation"], "long_description": "Ocean Sim is a virtual reality underwater adventure game that immerses you in a mission to clean the ocean and protect marine life. As a dedicated ocean conservationist, you\u2019ll dive into a vibrant, stylized underwater world filled with floating trash, trapped animals, and hidden dangers.\n\nArmed with a multifunctional gun, you\u2019ll clear debris and scan marine creatures as you navigate through immersive underwater environments. Manage your oxygen levels, avoid hazardous creatures like jellyfish and aggressive fish, and focus on removing all trash in each area to progress through the game.\n\nWith a focus on action and awareness, Ocean Sim offers a streamlined, impactful experience that highlights the importance of keeping our oceans clean\u2014one dive at a time.\n\nDive in. Clean up. Make a difference.", "short_description": "Ocean Sim is a VR underwater adventure where you clean the ocean and protect marine life. Using a single gun to clear trash and scan fish, you'll dive through vibrant environments, avoid hazards, and complete each level by removing all debris.\n\nSimple tools. Big impact. Dive in and make a difference."}]}, "developer_name": null, "developer_privacy_policy_url": "https://appstore.agmostudio.com/OceanSim/PrivacyPolicy/index.html", "developer_terms_of_service_url": null, "publisher_name": "Agmo Studios Sdn Bhd", "support_website_url": null, "website_url": "https://www.agmo.group/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24036052952669402"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1379546749958184"}]}, "baseline_offer": {"id": "1379546749958184"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1750218840, "status": "PUBLISHED", "id": "1379546749958184"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "23967533046188060", "version": "1.1.3"}, "id": "24018207961105468", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_b
EBD"}, {"file_name": "4.png", "id": "1052582600336064", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491820001_1052582603669397_3723417370355464792_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZaulfrJrY54Q7kNvwFBJaKz&_nc_oc=AdpUpT1Jzl_9iTXxegS9LMmm0bY-mZTLG2nPtQaaHt2S3PrOGSVyLFXpeVwviemF-nQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRE9A-_Avp3rxdHxotaADpa-8SYZPztR2warxXF3ikQww&oe=6B0C6888"}, {"file_name": "2.png", "id": "649689067885594", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391932_649689071218927_1177750704699383680_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YFzVRHG1bPUQ7kNvwHc5ZvW&_nc_oc=Adp7o7wtbxNZw6ETHlbnE1fh0MRgnXfGy1dKBc_GWlAUCZcR-RZbHuMqhd4keZnRKvE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQT8JPQQ14AAzZ9IOlszvX5awLbY1gKa5cQO9FbrljTQxg&oe=6B0C614E"}, {"file_name": "3.png", "id": "1223032906067046", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491821008_1223032909400379_459275864106183571_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_SwqkJxy6k4Q7kNvwE4sQst&_nc_oc=AdobW_8NXFO3A2r5y628N2wWOSOT0sdhnX9S00MX4kVtkI4YuroldbuWVBHaQUZa4UA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSxF3LWhTm3R63rROtGrtbn1eGDsVAGM2rHTlKkjTgP7w&oe=6B0C78AE"}, {"file_name": "5.png", "id": "1839733243487980", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391920_1839733246821313_6977900891814834568_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IsYgvHsPF4MQ7kNvwFKi865&_nc_oc=AdrMXi_YVVbbIGXzixlEiaTidtP8no_HRFD5r_rhCRt4O7VknF8xA333SO-fw07lWQI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTufiClDD_t0CjnYWzxMmVe-0PBMcYcYlxlMkOP9dXJKQ&oe=6B0C7561"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Ocean Sim", "keywords": ["Ocean", "Simulation"], "long_description": "Ocean Sim is a virtual reality underwater adventure game that immerses you in a mission to clean the ocean and protect marine life. As a dedicated ocean conservationist, you\u2019ll dive into a vibrant, stylized underwater world filled with floating trash, trapped animals, and hidden dangers.\n\nArmed with a multifunctional gun, you\u2019ll clear debris and scan marine creatures as you navigate through immersive underwater environments. Manage your oxygen levels, avoid hazardous creatures like jellyfish and aggressive fish, and focus on removing all trash in each area to progress through the game.\n\nWith a focus on action and awareness, Ocean Sim offers a streamlined, impactful experience that highlights the importance of keeping our oceans clean\u2014one dive at a time.\n\nDive in. Clean up. Make a difference.", "short_description": "Ocean Sim is a VR underwater adventure where you clean the ocean and protect marine life. Using a single gun to clear trash and scan fish, you'll dive through vibrant environments, avoid hazards, and complete each level by removing all debris.\n\nSimple tools. Big impact. Dive in and make a difference."}]}, "developer_name": null, "developer_privacy_policy_url": "https://appstore.agmostudio.com/OceanSim/PrivacyPolicy/index.html", "developer_terms_of_service_url": null, "publisher_name": "Agmo Studios Sdn Bhd", "support_website_url": null, "website_url": "https://www.agmo.group/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING"], "support
ohc=ZRXZpMVp154Q7kNvwHVyKGW&_nc_oc=Adq1ZHaF6eMY-Ukb9WPliYb7tLuI_3zVu59keTPWTzkskTiudkBXNSaYmIiTCKR1cKA&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLqzxjKlafocoT6T2s_9PNstnN2y2lBbTJS-2A8LPHrPw&oe=6AA166C8"}, {"file_name": "2.png", "id": "649689067885594", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/473391932_649689071218927_1177750704699383680_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QaNxg4vszUIQ7kNvwGSUuQy&_nc_oc=AdrokQWRzgflR1GS50h4ATwmGe2KDNeD6whxw8Oj9aT-8uqxar8iIRAxjXrx8LAueEs&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJz45X3SDJswugWd8C1SQxGIMcWiKvVEOocnaZAfJAJZw&oe=6AA15F8E"}, {"file_name": "3.png", "id": "1223032906067046", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/491821008_1223032909400379_459275864106183571_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RIS4izYvan8Q7kNvwEbGT-P&_nc_oc=Adojc_wBE5ZqnsSUP5OxxXW4lq9HW0sWg1y0Hzmq-7UBV0QiiQRYAituFN6Rze7b3tg&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLrcq5QRA1VTrAJyLj1AVjJNZSitsAh6tHL9VuCp5itVQ&oe=6AA176EE"}, {"file_name": "5.png", "id": "1839733243487980", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/473391920_1839733246821313_6977900891814834568_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ConjHfj_8QkQ7kNvwEDqD4E&_nc_oc=AdppeQvdV7sO0qyB9clU9_6isi6GZ_ylwmMDUhofGYKZmzuSJAGMvxdXtVnjo9phSlo&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIw2tdCjdkfZ8tcyPthh8b0twGr5QO-Z39Zih0wuYSmMA&oe=6AA173A1"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Ocean Sim", "keywords": ["Ocean", "Simulation"], "long_description": "Ocean Sim is a virtual reality underwater adventure game that immerses you in a mission to clean the ocean and protect marine life. As a dedicated ocean conservationist, you\u2019ll dive into a vibrant, stylized underwater world filled with floating trash, trapped animals, and hidden dangers.\n\nArmed with a multifunctional gun, you\u2019ll clear debris and scan marine creatures as you navigate through immersive underwater environments. Manage your oxygen levels, avoid hazardous creatures like jellyfish and aggressive fish, and focus on removing all trash in each area to progress through the game.\n\nWith a focus on action and awareness, Ocean Sim offers a streamlined, impactful experience that highlights the importance of keeping our oceans clean\u2014one dive at a time.\n\nDive in. Clean up. Make a difference.", "short_description": "Ocean Sim is a VR underwater adventure where you clean the ocean and protect marine life. Using a single gun to clear trash and scan fish, you'll dive through vibrant environments, avoid hazards, and complete each level by removing all debris.\n\nSimple tools. Big impact. Dive in and make a difference."}]}, "developer_name": null, "developer_privacy_policy_url": "https://appstore.agmostudio.com/OceanSim/PrivacyPolicy/index.html", "developer_terms_of_service_url": null, "publisher_name": "Agmo Studios Sdn Bhd", "support_website_url": null, "website_url": "https://www.agmo.group/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24036052952669402"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/491822559_1041116407971782_7691447340170980722_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a
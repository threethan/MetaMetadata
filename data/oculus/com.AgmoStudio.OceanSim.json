oc=AdlNc2PR0XvCQPbhkiLC1j3u_tji8KFEJR9IBbvJrEOAvZUdfgOB3wckoPWE7h26o0E&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfzUBLccZYi9CXm-_2O5382xdO0VL6HL7GHWQ-5_oZJ0FQ&oe=69AD8148"}, {"file_name": "2.png", "id": "649689067885594", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473391932_649689071218927_1177750704699383680_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q1J1JrRLM2sQ7kNvwGASDbi&_nc_oc=AdkxopDKFquYa7i557xKiWGLiljollIjrXeJf3tCA9oLiKY2zrqroDTGvNNOGRnWpe4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfxwJRnV6tH7QQsrhHwgaNinaFZQwz7GxhxL58pI3x0taQ&oe=69AD7A0E"}, {"file_name": "3.png", "id": "1223032906067046", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491821008_1223032909400379_459275864106183571_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jXLHTNUUWVUQ7kNvwFLVlYw&_nc_oc=Adm6PhTsJKC3Fgr9ioRrd2iux4uzbxerh5OQLvCO5mQuDWfASpv7ZXIfbxSw4Gdw3Zw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfyXU2qo-T_DnzR87Vm4wful3Xz8pfwAZqS7F9PYzhYERQ&oe=69AD592E"}, {"file_name": "5.png", "id": "1839733243487980", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473391920_1839733246821313_6977900891814834568_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2MiqyePI0aQQ7kNvwET_MHa&_nc_oc=Adn6u6UuhUzjzC3zSROx5FI_wmR5gStMOz49DviY6rvD8ktUhlSfcXmMhsHPFhjiuQA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afxrgn6N_apHbwiWb14EyuzroRZt18IOgi59l_bTPG2AOw&oe=69AD55E1"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Ocean Sim", "keywords": ["Ocean", "Simulation"], "long_description": "Ocean Sim is a virtual reality underwater adventure game that immerses you in a mission to clean the ocean and protect marine life. As a dedicated ocean conservationist, you\u2019ll dive into a vibrant, stylized underwater world filled with floating trash, trapped animals, and hidden dangers.\n\nArmed with a multifunctional gun, you\u2019ll clear debris and scan marine creatures as you navigate through immersive underwater environments. Manage your oxygen levels, avoid hazardous creatures like jellyfish and aggressive fish, and focus on removing all trash in each area to progress through the game.\n\nWith a focus on action and awareness, Ocean Sim offers a streamlined, impactful experience that highlights the importance of keeping our oceans clean\u2014one dive at a time.\n\nDive in. Clean up. Make a difference.", "short_description": "Ocean Sim is a VR underwater adventure where you clean the ocean and protect marine life. Using a single gun to clear trash and scan fish, you'll dive through vibrant environments, avoid hazards, and complete each level by removing all debris.\n\nSimple tools. Big impact. Dive in and make a difference."}]}, "developer_name": null, "developer_privacy_policy_url": "https://appstore.agmostudio.com/OceanSim/PrivacyPolicy/index.html", "developer_terms_of_service_url": null, "publisher_name": "Agmo Studios Sdn Bhd", "support_website_url": null, "website_url": "https://www.agmo.group/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24036052952669402"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491822559_1041116407971782_7691447340170980722_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pX6cp_HRROoQ7kNvwEbGhvn&_nc_oc=AdnrkW81
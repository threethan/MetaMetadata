3642437_n.png", "id": "1640603833369727", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982521_1640603836703060_3363331495202694148_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MPUwdnz3oAoQ7kNvwFP7AU2&_nc_oc=AdozB0GhRBf7rawEpU7LGN5ZMw6ow-4rQ_bNwbMBcHiPAR8ZG8R5Q3UJEw_3MtBhSpw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afy0CgzfnaSsv36rHSlvr3p8X-5XBy0-W7Cb9yjjkSlZZg&oe=69D0EF98"}, "display_name": "Chimpanzee Chase", "keywords": [], "long_description": "A gorilla locomotion-based game where you can interact with other people.\nYou can explore a forest, buy cosmetics in the shop, float around in zero gravity or space, fight against others in PVP, watch memes in the theater, play a recreation game mode of only up, look at the crystals in caves, or even swim at the beach with friends! Or will you try to figure out the mysteries of the chimps in horror?\nWell, it's all up to you to do whatever you want in this game! Just remember to have fun and to be monke", "short_description": "A gorilla locomotion-based game "}]}, "developer_name": "NickVR", "developer_privacy_policy_url": "https://www.termsfeed.com/live/33081be0-d8ee-4362-abb8-5a34b25748a4", "developer_terms_of_service_url": null, "publisher_name": "Nick", "support_website_url": null, "website_url": "https://chimpanzee-chase.glitch.me/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "
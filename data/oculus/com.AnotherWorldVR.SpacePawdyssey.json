content-ord5-1.oculuscdn.com/v/t64.5771-25/39031529_1627087931572640_4083118609254979821_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4OPOYkEgPdYQ7kNvwEY6GhY&_nc_oc=Adnu5glyRT6_Ec2_pB9_rs1UPEmIQIMWxH6qp5aR2E28VGh2ivYNMPzX4eieeJT05xI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_Afwh4DqQYLICP8LI4t3_A5i1o4rC825Hqk7-LjjpOr52jA&oe=69BBE4C0"}, {"file_name": "bowling_escavation.png", "id": "1076453430688828", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974746_1076453434022161_3902000793864200888_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7V8qQzzHmcsQ7kNvwH_B-EB&_nc_oc=AdkVaj7Klm5lUHuEL-WtfPHU3-iZjfncJY4K5FxxIQ-vkyaH0ChZWotJUDOqqlZscAU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_Afznp0l99JH3SEV9Zbe9ZoepO62XM9Cnf7lnaWYTxqtitQ&oe=69BBEE8F"}, {"file_name": "asteroid_scanning.png", "id": "1708518839722580", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75303839_1708518843055913_8867692545714880265_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sqVxR_Upl3MQ7kNvwE0C6wj&_nc_oc=AdlNhra_pg46C0mbw7nwK0TqM8dli3NUIb7eUe6mm6zY3rZt4oUszUTfS2jGZTDTgiA&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfyP8r39zVR2NIwlJMCuGihqVRRSGj5k66Kg8xP4ijYcnw&oe=69BBF28D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_ASP_CoverImage.png", "id": "865693635411839", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031309_865693638745172_2747540183598569721_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yzaf2QG6rlwQ7kNvwEFJT-Z&_nc_oc=AdmsJ0GvP86pQnWxzxantuVSFwPNzWzJIcv1SIGsbSCmPsw0CcEU5T9vwBAjtAr98t0&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfyS3UNH8zMjCQKGEcfaoPX9_aBaPhWdj6Nq34l-LYVsqQ&oe=69BBDD0D"}, "display_name": "A Space Pawdyssey", "keywords": [], "long_description": "# Embark on A Space Pawdyssey!\n\nYou play **Astra**, a smart, sweet and ambitious husky, sent on a space exploration mission by the human-led organization called PAWSA.\n\nAstra is joined by a quirky team of companions **SBURD**, a deranged goose that only communicates through honks and unsettling stares; **Albert the XV**, a cynical and well-educated monkey, that is also the team\u2019s weapon expert; and **Luna**, an adorable, but slightly neurotic mouse suffering from space allergies and a massive crush on the goose.\n{949438840336802}\n\n\n The team is tasked with traveling to two mysterious planets to collect three vital ingredients for analysis, providing insights into newly discovered celestial bodies. \n{606909931764369}\n\n\nAlong the way, they face a series of **wild adventures** and **chaotic disasters**: \n{413392028505368}\n\nLuna gets launched across the first planet by an uncontrollable sneezing fit, a **meteor shower** pummels the second planet, and a **space battle** erupts with French cat astronauts. \n\nFrom **reactor reboots** to electrical malfunctions and the unclogging of the ship\u2019s engines after a vicious **chicken \"bowel movement\" attack**, this crew has to master it all.\n\n{549656377922356}\nThese adrenaline-packed challenges are paired with fun **puzzle** and **rhythm-based** mini-games, which serve as the key to experimenting with the collected ingredients.\n\n\n\n", "short_description": "Join the space pack and embark on a high-stakes cosmic adventure: Battle meteor storms, rival feline-astronauts, and chaotic mishaps like sneezing fits and questionable chicken sabotage. Solve puzzles, play rhythm mini-games, and explore newly discovered planets!!"}]}, "developer_name": null, "developer_privacy_policy_url": "http://anotherworldvr.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "anotherworld GmbH", "support_website_url": null, "website_url": "http://anotherworldvr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "
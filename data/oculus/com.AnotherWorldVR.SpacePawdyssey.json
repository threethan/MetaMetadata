content-ord5-1.oculuscdn.com/v/t64.5771-25/39031529_1627087931572640_4083118609254979821_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y-uWjr06hwIQ7kNvwEtywTU&_nc_oc=AdkYAFRlPZc4rEmbqFia90GQVohu4lwy61j8RIJibrv8MRs3PagG5LFD_qgC_F7nams&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_Afx0xNaU8a9hcoFlfMVJzArA4StlsMa5H4GW1TsaXsavQA&oe=69B3FBC0"}, {"file_name": "bowling_escavation.png", "id": "1076453430688828", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974746_1076453434022161_3902000793864200888_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7M8DzpvC334Q7kNvwGXU3pt&_nc_oc=AdmtszdC5yBdfr5WDo_knMTC2ww1PRkHx_DP_iMkDhwQW5N6MCK5UuVOQ83Onaih7YA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_Afxfau2nzSBJ-d_Z9O-0uD_SiAN8GN7hfLJn8vi0bIKexw&oe=69B4058F"}, {"file_name": "asteroid_scanning.png", "id": "1708518839722580", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75303839_1708518843055913_8867692545714880265_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EsWFWpSBARMQ7kNvwGYarLP&_nc_oc=AdmVtp80HYqM1FwZ4xBOceCcSs-1rnkAKdGljq5vi606fIYHK6g4-CSaaO1pESgiv44&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfzE5E0nxVqOP84cFLkaHf3d_ROtAGVabwyZpWuuCVpKjA&oe=69B4098D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_ASP_CoverImage.png", "id": "865693635411839", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031309_865693638745172_2747540183598569721_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y0Ee_HZrM7EQ7kNvwHyBfaf&_nc_oc=AdkXF9KzT0ApI1-qNT5G6rs9J1fjFLJTw9mek6wzysEd_5xST55uol-58Rb3ENOtj_s&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afz7s45TEDifMu4Fyuofv2L8qT3rYkSQcg98hoK7Wj1hJg&oe=69B3F40D"}, "display_name": "A Space Pawdyssey", "keywords": [], "long_description": "# Embark on A Space Pawdyssey!\n\nYou play **Astra**, a smart, sweet and ambitious husky, sent on a space exploration mission by the human-led organization called PAWSA.\n\nAstra is joined by a quirky team of companions **SBURD**, a deranged goose that only communicates through honks and unsettling stares; **Albert the XV**, a cynical and well-educated monkey, that is also the team\u2019s weapon expert; and **Luna**, an adorable, but slightly neurotic mouse suffering from space allergies and a massive crush on the goose.\n{949438840336802}\n\n\n The team is tasked with traveling to two mysterious planets to collect three vital ingredients for analysis, providing insights into newly discovered celestial bodies. \n{606909931764369}\n\n\nAlong the way, they face a series of **wild adventures** and **chaotic disasters**: \n{413392028505368}\n\nLuna gets launched across the first planet by an uncontrollable sneezing fit, a **meteor shower** pummels the second planet, and a **space battle** erupts with French cat astronauts. \n\nFrom **reactor reboots** to electrical malfunctions and the unclogging of the ship\u2019s engines after a vicious **chicken \"bowel movement\" attack**, this crew has to master it all.\n\n{549656377922356}\nThese adrenaline-packed challenges are paired with fun **puzzle** and **rhythm-based** mini-games, which serve as the key to experimenting with the collected ingredients.\n\n\n\n", "short_description": "Join the space pack and embark on a high-stakes cosmic adventure: Battle meteor storms, rival feline-astronauts, and chaotic mishaps like sneezing fits and questionable chicken sabotage. Solve puzzles, play rhythm mini-games, and explore newly discovered planets!!"}]}, "developer_name": null, "developer_privacy_policy_url": "http://anotherworldvr.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "anotherworld GmbH", "support_website_url": null, "website_url": "http://anotherworldvr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "
cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ii7BiiIzMtYQ7kNvwGzVKYv&_nc_oc=AdkOjLSIGzdsUffCeD12bWTSX8zKjKpv4HvoDaotVbTwfuoCbk-lTZQz8gMQodOZKM4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_AfvDl3ESESfmkKWjraXruAfRFkERdia4l-2LFbQz3GxX4Q&oe=699C40C0"}, {"file_name": "bowling_escavation.png", "id": "1076453430688828", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974746_1076453434022161_3902000793864200888_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yOY-_GJ8VhwQ7kNvwFvoH2W&_nc_oc=AdnYjBjX2b1TXYWZVcdcLRtLKhnzmkyXnEyNGjij82q1uNrsK-a-_FNiGIV_w6HN-tc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_AfuhMqKWEjrKfSRIeSySywUx0RU6jvA7uR8Lp6uNUt4j_w&oe=699C4A8F"}, {"file_name": "asteroid_scanning.png", "id": "1708518839722580", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75303839_1708518843055913_8867692545714880265_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TeUDbfojFGsQ7kNvwHrFAy9&_nc_oc=AdnNYl7IPRhth1YxTeGZnocyWky_O4gR3axmT1QLEhgPKfynHhIaMIzg7zbWZsf40JU&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfsGA0Y03YCtrVRe0xuLMCjXb_BgEVJGFE3hv5i3s4mnCg&oe=699C4E8D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_ASP_CoverImage.png", "id": "865693635411839", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031309_865693638745172_2747540183598569721_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gA2eNdzOW5kQ7kNvwHl_sLb&_nc_oc=Adn_MxG-AicK4i4z7m2z6sDRl9aAHmzovgy1nwyTI7TWpXWb9k4aFA0UzIAUmiQrefQ&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_Afu16I-OO_qgi-twdOXiGp3txaWtFfFumDVHXRNsjach-Q&oe=699C390D"}, "display_name": "A Space Pawdyssey", "keywords": [], "long_description": "# Embark on A Space Pawdyssey!\n\nYou play **Astra**, a smart, sweet and ambitious husky, sent on a space exploration mission by the human-led organization called PAWSA.\n\nAstra is joined by a quirky team of companions **SBURD**, a deranged goose that only communicates through honks and unsettling stares; **Albert the XV**, a cynical and well-educated monkey, that is also the team\u2019s weapon expert; and **Luna**, an adorable, but slightly neurotic mouse suffering from space allergies and a massive crush on the goose.\n{949438840336802}\n\n\n The team is tasked with traveling to two mysterious planets to collect three vital ingredients for analysis, providing insights into newly discovered celestial bodies. \n{606909931764369}\n\n\nAlong the way, they face a series of **wild adventures** and **chaotic disasters**: \n{413392028505368}\n\nLuna gets launched across the first planet by an uncontrollable sneezing fit, a **meteor shower** pummels the second planet, and a **space battle** erupts with French cat astronauts. \n\nFrom **reactor reboots** to electrical malfunctions and the unclogging of the ship\u2019s engines after a vicious **chicken \"bowel movement\" attack**, this crew has to master it all.\n\n{549656377922356}\nThese adrenaline-packed challenges are paired with fun **puzzle** and **rhythm-based** mini-games, which serve as the key to experimenting with the collected ingredients.\n\n\n\n", "short_description": "Join the space pack and embark on a high-stakes cosmic adventure: Battle meteor storms, rival feline-astronauts, and chaotic mishaps like sneezing fits and questionable chicken sabotage. Solve puzzles, play rhythm mini-games, and explore newly discovered planets!!"}]}, "developer_name": null, "developer_privacy_policy_url": "http://anotherworldvr.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "anotherworld GmbH", "support_website_url": null, "website_url": "http://anotherworldvr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "377978390272490"}, {"id": "1672577396871977"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "in
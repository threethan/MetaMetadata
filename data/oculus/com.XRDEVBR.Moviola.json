ttps://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/473391978_844501071197642_3742530310486463674_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7iefrahTKdUQ7kNvwFr31lO&_nc_oc=AdpXVHDvGGmZGpGz4v9yWnZ1ddPm8NvMegUzi_YndPYtaLZyoR2J4IQ3h5UaakmI42E&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af89ycIPN6OzwTh-bBuU0AsChTpamMJMyCs2WKJRa1DfNQ&oe=6A3962B5"}, {"file_name": "screen2.png", "id": "2213768045665821", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/38982446_2213768048999154_7700943960686362069_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MRJ-wwcCRoEQ7kNvwG29lAD&_nc_oc=AdpwK9uSJ9q825zwHmcpSlODuf6Y_XEVMqZ9ycwc632KU6eRfuYR70fPpA6Au9Q-w-E&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9_1zTCwXyZzP9lWVG05sdMbWAVNgtLYHtEPgNFcQCwqw&oe=6A395AB3"}, {"file_name": "screen1.png", "id": "1434832627212046", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/38974676_1434832630545379_1058264450705992772_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_ztAn_YXVyUQ7kNvwGt2q6j&_nc_oc=Adq7r7F8urfIcc_9gg3fmdJK218hV23Tk9D0q_wdIe9XNs_WV4lLSGmxYf1piudpWzk&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9Mj5yeuTYMK5HpgqT492RBmNbcA90jWJOeW0YArcq1Hg&oe=6A394AB5"}, {"file_name": "moviola-042025-2.png", "id": "1181600010102296", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/473392132_1181600013435629_1405386606487826467_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DHsWg-QL_0cQ7kNvwHv22wX&_nc_oc=Ado3xi5c64g2p5lF3uGzIxvt69sAR_o_GiTrG3lanxrUUOicoa3bENK7BwgE2Kytx6s&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9OXx1dqol_Zmm5I_N5w4KM81Ubl9V0YVR43xCQq0AgHQ&oe=6A3948D4"}, {"file_name": "moviola-042025-3.png", "id": "1664375897771182", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/473391852_1664375901104515_5654525913464939787_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G-z-hkw_5UYQ7kNvwG_AGtq&_nc_oc=Adp7uYbHPYzgl4yoJtKaYuW82FUuswoCmsdquW54TmhplietePmiHGP862PE3FxVyFc&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-KWm2mJ7VyRN2t-flmqu6-BJFVR5-Aq_F-Icteqn82pQ&oe=6A39510B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "16-10.png", "id": "8512037645577760", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/75395599_8512037655577759_1169937139310052534_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BLGoBid6pgIQ7kNvwFLklOw&_nc_oc=AdrcComPWMjBdTfQ2rrx1TzorlCd7Dg3gPCKUv2RzHCcq9_oIuLohRTtEeIRNydC4VY&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9CE6Qh7pONVGYbjj0URfgvnlXKGrAT1-vjsafKya-j0Q&oe=6A395E3A"}, "display_name": "Moviola Video Editor", "keywords": ["video", "editor", "editing", "moviola", "film"], "long_description": "# Moviola: Your Video Editing solution on your Meta Quest\n\nMoviola is a mixed reality, immersive multi-track video editor built exclusively for Meta Quest devices. Use your hands or controllers to grab, trim, and arrange clips in 3D space, no desktop required.\n\n# Languages:\n- English\n- Spanish\n- German\n- French\n- Portuguese\n\n{8632676920173149}\n- Multi-track editing with ripple delete, overwrite, and slip modes  \n{522080987190953}\n- Import, preview, edit, and export. All in one seamless VR workflow\n\n# Main Features:\n- Edit 360\u00b0, 180\u00b0, 3D (SBS, TB), and standard 2D videos\n- Drag and drop clips into a multi-track timeline\n- View edits in passthrough, theater, or living room modes\n- Record voice-overs directly into your project\n- Organize media visually using interactive 3D reels\n- Auto-save and fast export to local storage\n\n**Supported Formats:**\n- Input: MP4 (H.264 & H.265 up to 8K, MPEG-4 Layer-2 up to 1080p), WAV, MP3, OGG\n- Export: MP4 (1080p, MPEG-4 Layer-2 + AAC), up to 60 fps\n- Layouts: 2D, 3D SBS/TB, 360\u00b0/180\u00b0 mono & stereo\n\n**Important:** Moviola is under active development. Try it, send feedback, and help shape the future of VR video editing!\n\nThis app uses FFmpeg under GPLv3 for high quality video export. Source code available at: github.com/kevinagnes/moviola-exporter-gpl-source", "short_description": "Edit videos like on your Meta Quest! Use natural hand gestures to manipulate your footage. Effortlessly refine your edits, save your progress, and share your final cut."}]}, "developer_name": null, "developer_privacy_policy_url": "https://xr.dev.br/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "XRDEVBR", "support_website_url": "https://discord.gg/5bDkRAsFPX", "website_url": "https://xr.dev.br/moviola/docs", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}, {"id": "1063584910766706"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "en_US", "en_GB", "fr", "de", "pt_BR", "pt", "es", "es_AR", "es_CL", "es_MX"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26081205471511257"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/38974794_1097932608423787_7197273108833725305_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xzW31mzSrOMQ7kNvwHWElM1&_nc_oc=AdpniaGZGd20gEqNk-Yfdjgs-kZI3ayD5JnqWkAQiHqfBPU4vtu6DY4pWqVAy7UbRFA&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-SzeLnQwwX3XmbXYr9l6fkq80S3aLuEBgUXhSSwlaDJw&oe=6A395028"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Moviola Video Editor", "platform": "ANDROID_6DOF", "context_category": {"con
"https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/473391978_844501071197642_3742530310486463674_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=elgy3nZDGOQQ7kNvwFwYFLq&_nc_oc=AdrTeKWLATAruXayyqYAYYADLjctJ3YuDc3maUlS1yJdW9z-V9TqkbiKiTsrPGbuNak&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG1eWdM6UVlLubZm1FbZTX3ZrS7COlbkyEPfSImgyayrA&oe=6A8EDBF5"}, {"file_name": "screen2.png", "id": "2213768045665821", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/38982446_2213768048999154_7700943960686362069_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mHNhg9os8OkQ7kNvwG1nGVj&_nc_oc=Adpj65Nc97DL0_a7qwf67TtxyQvuI1-FBv9D6RNXi2Rn2Az8-GWjCa6LGEW2kb4fAVY&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFeViPJKqY72Z1837dAgcw47eAhoZJikNn5iY9PeYFchw&oe=6A8ED3F3"}, {"file_name": "screen1.png", "id": "1434832627212046", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/38974676_1434832630545379_1058264450705992772_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nsKcL9UjmQ4Q7kNvwEF-fN7&_nc_oc=AdpCb7PAUr79FwjKu5E6nmlVK1eFGfh-Moa4Qti_t4Az7hdFwBAkfQJVW_V-c6Em_5E&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHRfqUapWCE_Yml-GOx66xt2-__35QsrKigoBsN7Qk5qg&oe=6A8EC3F5"}, {"file_name": "moviola-042025-2.png", "id": "1181600010102296", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/473392132_1181600013435629_1405386606487826467_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hE8DLfGVlk0Q7kNvwHsqGOq&_nc_oc=AdochoJ8xUOfUFbVWDCt5fvw_OKnF1BgEH4ewMn26SnE4B2aK0Vt6RnUV7eDUOrARJE&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE9XHbHJPhMfGpGmifHgA03lUzOt65oRS_h9au7sy-s9Q&oe=6A8EC214"}, {"file_name": "moviola-042025-3.png", "id": "1664375897771182", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/473391852_1664375901104515_5654525913464939787_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7YBej2OgP3MQ7kNvwFarkFG&_nc_oc=AdpNz2ciAm_4qmEIlCoyTrjl2qeDXx0_g46AJWiLPLMiM8Eagts799iAupQ20NXdTFw&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFgyJYkDQ1hdK3PPdnOucduHLyISeun6dzD3ETp-ByXdQ&oe=6A8ECA4B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "16-10.png", "id": "8512037645577760", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/75395599_8512037655577759_1169937139310052534_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RNpj2z9obWAQ7kNvwFNip3L&_nc_oc=Adr_oQWZkGkyZY4E4wrcMFbQ-KiBE-eOgRiqJgK92yaFIE-Gbcfq54zUgdn7z9KfO7o&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF-oUDHWTE8n6ieA2BW2J4TnsAjMY8W9Npq1d5G8qPdWQ&oe=6A8ED77A"}, "display_name": "Moviola Video Editor", "keywords": ["video", "editor", "editing", "moviola", "film"], "long_description": "# Moviola: Your Video Editing solution on your Meta Quest\n\nMoviola is a mixed reality, immersive multi-track video editor built exclusively for Meta Quest devices. Use your hands or controllers to grab, trim, and arrange clips in 3D space, no desktop required.\n\n# Languages:\n- English\n- Spanish\n- German\n- French\n- Portuguese\n\n{8632676920173149}\n- Multi-track editing with ripple delete, overwrite, and slip modes  \n{522080987190953}\n- Import, preview, edit, and export. All in one seamless VR workflow\n\n# Main Features:\n- Edit 360\u00b0, 180\u00b0, 3D (SBS, TB), and standard 2D videos\n- Drag and drop clips into a multi-track timeline\n- View edits in passthrough, theater, or living room modes\n- Record voice-overs directly into your project\n- Organize media visually using interactive 3D reels\n- Auto-save and fast export to local storage\n\n**Supported Formats:**\n- Input: MP4 (H.264 & H.265 up to 8K, MPEG-4 Layer-2 up to 1080p), WAV, MP3, OGG\n- Export: MP4 (1080p, MPEG-4 Layer-2 + AAC), up to 60 fps\n- Layouts: 2D, 3D SBS/TB, 360\u00b0/180\u00b0 mono & stereo\n\n**Important:** Moviola is under active development. Try it, send feedback, and help shape the future of VR video editing!\n\nThis app uses FFmpeg under GPLv3 for high quality video export. Source code available at: github.com/kevinagnes/moviola-exporter-gpl-source", "short_description": "Edit videos like on your Meta Quest! Use natural hand gestures to manipulate your footage. Effortlessly refine your edits, save your progress, and share your final cut."}]}, "developer_name": null, "developer_privacy_policy_url": "https://xr.dev.br/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "XRDEVBR", "support_website_url": "https://discord.gg/5bDkRAsFPX", "website_url": "https://xr.dev.br/moviola/docs", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}, {"id": "1063584910766706"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "en_US", "en_GB", "fr", "de", "pt_BR", "pt", "es", "es_AR", "es_CL", "es_MX"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26081205471511257"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/38974794_1097932608423787_7197273108833725305_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E7GMaY8THNIQ7kNvwEos699&_nc_oc=AdoNNFrlP3KxNodTgalhhH-0diDQQ2qwalZd55rLiq1-Tomrbfo90FBSyu9jABFKJBY&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF2iFNA_HjBaLtfJQGopfJceNkKbhYwu4ijG33kMP---Q&oe=6A8EC968"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Moviola Video Editor", "platform": "ANDROID_6DOF", "context_catego
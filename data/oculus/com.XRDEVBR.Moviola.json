ps://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39035466_1546717669615383_6511054877644954414_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eaxobbkM_QwQ7kNvwGWRPlT&_nc_oc=Adk-6HiCsMYu3QUTgJtpftWU6Q7i1AyLUi0os-WVJz6VI1VjTLCKJCWtVnsVz-HGB0Q&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_Afv4bocfwdsnrd2RaNGGEPOn3Umd3NTMspyMOO6i4nPRbQ&oe=69A4200C"}, {"file_name": "4.png", "id": "904907894773861", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75294240_904907898107194_8613408615661390259_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eyjDlkPuudYQ7kNvwF0Amz_&_nc_oc=AdmgIiFs3_l7nbq7XRiIMe7_0j6Bt2_0WfoMEXPho4dRUshmJGQoxM5OQHVnzKd7eZc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AfuppRJJylM35Ihk6p6o4vPXwqq1NR2e9J4c_o5DWpl1PQ&oe=69A42763"}, {"file_name": "5.png", "id": "2248683322146302", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982468_2248683325479635_3305973444349433735_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Nx6V67MvKCUQ7kNvwGksQFn&_nc_oc=AdkpTL9JU4ShqH8J5vHaFFH74I6D74eoj9nYzgi1SjMQuzDgaqtcJQzKZbQ3kpvTfJ4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AftsMY4mA54NIgP9Guwh-bYiqUUlpQqamPsIxewH3p6IVw&oe=69A422AE"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Moviola - Video Editor", "keywords": [], "long_description": "**[Early Access]**\n\n# Moviola: Your XR Video Studio on Meta Quest\n\nMoviola is a mixed reality video editor designed exclusively for Meta Quest.  \nDitch the keyboard and mouse for an immersive, hands-on editing experience.\n\n# Features:\n- Intuitive Editing: Use natural hand gestures to manipulate your footage.\n- Immersive Previews: Watch your edits in passthrough, movie theater or a living room.\n- Seamless Workflow: Save, reload, and export your projects to XML effortlessly.\n\n# How to import your footage using Moviola Digest:\n- Go to xr.dev.br/moviola-digest for instructions.\n# How to import your footage without using Moviola Digest:\n- Upload your video and audio files to Quest/Movies (the folder already exists). The video extension must be **.mp4**, the audio extension must be **.ogg** and they should be the exact same length.\n\n**Important:** This app is not ready for professional work as the development is still in progress. You might have fun though as it is quite a unique way of editing your footage. I will appreaciate your purchase to support the project and also will be waiting for your feedback! Enjoy!\n\n# Extra screenshots:\n{328299153584761}\n{477451588330324}\n\n", "short_description": "Edit videos like never before with Moviola's immersive Mixed Reality experience (now in Early Access). Use natural hand gestures to manipulate your footage. Effortlessly refine your edits, save your progress, and share your final cut."}]}, "developer_name": null, "developer_privacy_policy_url": "https://xr.dev.br/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "XRDEVBR", "support_website_url": null, "website_url": "https://xr.dev.br/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}, {"id": "1063584910766706"}, {"id": "393222478507326"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "7806925069365909"}}]}, "scheduled_offers": {"count": 8, "nodes": [{"status": "PUBLISHED", "id": "1549634662856022"}, {"status": "PUBLISHED", "id": "1944043373058518"}, {"status": "PUBLISHED", "id": "1024664826536489"}, {"status": "PUBLISHED", "id": 
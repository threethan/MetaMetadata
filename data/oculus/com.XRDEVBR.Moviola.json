01428032_5374184890214614207_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AokwDjiBpQIQ7kNvwEv33fq&_nc_oc=AdqMmTCSLYwHXB_hC143tLbLEnsAIBVmgVFOzTOyL2gMxcVWeLs83c5XA-IC3qH7HUw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO6YzNx8pPyuCQj0wqEHUShVZqCVfTv3-m8FYTUC-n8_Q&oe=6AC65069"}, {"file_name": "3.png", "id": "1546717659615384", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39035466_1546717669615383_6511054877644954414_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eWT1vBotl_QQ7kNvwFBj1W4&_nc_oc=AdrB0ChfgQE6p2zWhKs3UZ2LxyPSSuCDk95VX4Gc2nm3wr1nPwUYk9iVF4F5jyo6w-A&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPLRZ-o0eIREQ6_cHdw4OndzhBiTTq9xwCXEmM5Synfuw&oe=6AC6624C"}, {"file_name": "4.png", "id": "904907894773861", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75294240_904907898107194_8613408615661390259_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jcuMfVPLNQ4Q7kNvwENq62B&_nc_oc=AdqjxoG3AFcA80WJlDW-1qjJ34TYvEHogSOGvgJvtJE_8wjyy1uD3KVEsARQJFlTlsQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP5C40OMkhRoI26_2zt3zfi1j-pwvzaNR2WLlu4912mJA&oe=6AC669A3"}, {"file_name": "5.png", "id": "2248683322146302", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982468_2248683325479635_3305973444349433735_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OQ7dW9kbI8MQ7kNvwE59tor&_nc_oc=Adr_Dkz_3fDSkyWW-xpWrkzRSMSNou5he0d_uxDYluvrrF8tJvhjLsDcUQMEma-gn0U&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPXXaYKWqxYkXax3yOSA58wARbdPLGb3uD4EonL_o_jpQ&oe=6AC664EE"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Moviola - Video Editor", "keywords": [], "long_description": "**[Early Access]**\n\n# Moviola: Your XR Video Studio on Meta Quest\n\nMoviola is a mixed reality video editor designed exclusively for Meta Quest.  \nDitch the keyboard and mouse for an immersive, hands-on editing experience.\n\n# Features:\n- Intuitive Editing: Use natural hand gestures to manipulate your footage.\n- Immersive Previews: Watch your edits in passthrough, movie theater or a living room.\n- Seamless Workflow: Save, reload, and export your projects to XML effortlessly.\n\n# How to import your footage using Moviola Digest:\n- Go to xr.dev.br/moviola-digest for instructions.\n# How to import your footage without using Moviola Digest:\n- Upload your video and audio files to Quest/Movies (the folder already exists). The video extension must be **.mp4**, the audio extension must be **.ogg** and they should be the exact same length.\n\n**Important:** This app is not ready for professional work as the development is still in progress. You might have fun though as it is quite a unique way of editing your footage. I will appreaciate your purchase to support the project and also will be waiting for your feedback! Enjoy!\n\n# Extra screenshots:\n{328299153584761}\n{477451588330324}\n\n", "short_description": "Edit videos like never before with Moviola's immersive Mixed Reality experience (now in Early Access). Use natural hand gestures to manipulate your footage. Effortlessly refine your edits, save your progress, and share your final cut."}]}, "developer_name": null, "developer_privacy_policy_url": "https://xr.dev.br/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "XRDEVBR", "support_website_url": null, "website_url": "https://xr.dev.br/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}, {"id": "1063584910766706"}, {"id": "393222478507326"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TO
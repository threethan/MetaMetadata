=Adm9TTpNWngvp3uET-er17jIp4BgFqjGmRmTxvlOljR5q10dJGUQ9l8nx8mApsdg0OM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfzTLtfXATtxIXUVY0RDplWmpOWXkkWCKltHWAkshxloSA&oe=69B569E9"}, {"file_name": "3.png", "id": "1546717659615384", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39035466_1546717669615383_6511054877644954414_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U6x4TIF3qmIQ7kNvwEhsoyj&_nc_oc=AdkLEb4JBWr2n0sZNQUCUk7Q8PixgdzGKlga6znIAouuQ7HIIpze2NEeqsyG3SDY4zA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfwzOtd6mCYKePU0lSC1SohLJgcpeqxhBnIRI-cPJwabHg&oe=69B5438C"}, {"file_name": "4.png", "id": "904907894773861", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75294240_904907898107194_8613408615661390259_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N5mZIBwXP-gQ7kNvwH1bcG9&_nc_oc=AdnyCppRmQU9cWm8EJUjWQSLELxpf1webLxvAcfaRfZLSdzf9X91bRbI7K_HaeMsi9E&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfycXyWTOLV-oVSBC5ND2mcRbkVDm_YBmy07vDxkRJNRuw&oe=69B54AE3"}, {"file_name": "5.png", "id": "2248683322146302", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982468_2248683325479635_3305973444349433735_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Q_T5sSK9GuUQ7kNvwE7YEVi&_nc_oc=AdmK6mnkSQuQiEawAsu6Htr-AeMVvIvpdAWNJdK1shKiszFKPVIrF_zh7jixDenvEOA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfxwkrT0abqra6dtZdbr3Y-7UuaMQCHojCjmeikNXMmYAA&oe=69B5462E"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Moviola - Video Editor", "keywords": [], "long_description": "**[Early Access]**\n\n# Moviola: Your XR Video Studio on Meta Quest\n\nMoviola is a mixed reality video editor designed exclusively for Meta Quest.  \nDitch the keyboard and mouse for an immersive, hands-on editing experience.\n\n# Features:\n- Intuitive Editing: Use natural hand gestures to manipulate your footage.\n- Immersive Previews: Watch your edits in passthrough, movie theater or a living room.\n- Seamless Workflow: Save, reload, and export your projects to XML effortlessly.\n\n# How to import your footage using Moviola Digest:\n- Go to xr.dev.br/moviola-digest for instructions.\n# How to import your footage without using Moviola Digest:\n- Upload your video and audio files to Quest/Movies (the folder already exists). The video extension must be **.mp4**, the audio extension must be **.ogg** and they should be the exact same length.\n\n**Important:** This app is not ready for professional work as the development is still in progress. You might have fun though as it is quite a unique way of editing your footage. I will appreaciate your purchase to support the project and also will be waiting for your feedback! Enjoy!\n\n# Extra screenshots:\n{328299153584761}\n{477451588330324}\n\n", "short_description": "Edit videos like never before with Moviola's immersive Mixed Reality experience (now in Early Access). Use natural hand gestures to manipulate your footage. Effortlessly refine your edits, save your progress, and share your final cut."}]}, "developer_name": null, "developer_privacy_policy_url": "https://xr.dev.br/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "XRDEVBR", "support_website_url": null, "website_url": "https://xr.dev.br/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}, {"id": "1063584910766706"}, {"id": "393222478507326"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_mo
&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2uztME8cvATE_G17vmz9-gZUUJb74VsAziaSxM0L8WzA&oe=69F4C30B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "16-10.png", "id": "8512037645577760", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/75395599_8512037655577759_1169937139310052534_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Gkm9bJOx8dMQ7kNvwH1IiDY&_nc_oc=AdoYW6Jqw0wr3TSgGUdrNoWdO0nbcTXbmNFrDt-kqkJCOIsC_-cRgv0vhLzTugUgyOk&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2hd8aQEXrElqyT2Sj1EagYoKaANN07I1fM7NQVCflGTA&oe=69F497FA"}, "display_name": "Moviola Video Editor", "keywords": ["video", "editor", "editing", "moviola", "film"], "long_description": "# Moviola: Your Video Editing solution on your Meta Quest\n\nMoviola is a mixed reality, immersive multi-track video editor built exclusively for Meta Quest devices. Use your hands or controllers to grab, trim, and arrange clips in 3D space, no desktop required.\n\n# Languages:\n- English\n- Spanish\n- German\n- French\n- Portuguese\n\n{8632676920173149}\n- Multi-track editing with ripple delete, overwrite, and slip modes  \n{522080987190953}\n- Import, preview, edit, and export. All in one seamless VR workflow\n\n# Main Features:\n- Edit 360\u00b0, 180\u00b0, 3D (SBS, TB), and standard 2D videos\n- Drag and drop clips into a multi-track timeline\n- View edits in passthrough, theater, or living room modes\n- Record voice-overs directly into your project\n- Organize media visually using interactive 3D reels\n- Auto-save and fast export to local storage\n\n**Supported Formats:**\n- Input: MP4 (H.264 & H.265 up to 8K, MPEG-4 Layer-2 up to 1080p), WAV, MP3, OGG\n- Export: MP4 (1080p, MPEG-4 Layer-2 + AAC), up to 60 fps\n- Layouts: 2D, 3D SBS/TB, 360\u00b0/180\u00b0 mono & stereo\n\n**Important:** Moviola is under active development. Try it, send feedback, and help shape the future of VR video editing!\n\nThis app uses FFmpeg under GPLv3 for high quality video export. Source code available at: github.com/kevinagnes/moviola-exporter-gpl-source", "short_description": "Edit videos like on your Meta Quest! Use natural hand gestures to manipulate your footage. Effortlessly refine your edits, save your progress, and share your final cut."}]}, "developer_name": null, "developer_privacy_policy_url": "https://xr.dev.br/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "XRDEVBR", "support_website_url": "https://discord.gg/5bDkRAsFPX", "website_url": "https://xr.dev.br/moviola/docs", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}, {"id": "1063584910766706"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "en_US", "en_GB", "fr", "de", "pt_BR", "pt", "es", "es_AR", "es_CL", "es_MX"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26081205471511257"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974794_1097932608423787_7197273108833725305_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8AmpgTpqBBkQ7kNvwGv1min&_nc_oc=AdodKLYo22gZU1tddKoc8_Axn-cLKBwYOvoY8u1Jm8T3eac4z1WRS2LCthOls2IRveM&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0QYc29MHsnmxzXls4GW7guHzzknGkLk4ADH2IW-BRkkQ&oe=69F4C228"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Moviola Video Editor", "platform": "ANDROID_6DOF", "context_category": {"context_cat
content-ams2-1.oculuscdn.com/v/t64.5771-25/473391978_844501071197642_3742530310486463674_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h1C1dEdpi68Q7kNvwEFJSKS&_nc_oc=AdrIe1rrbGBOYUoi3O-DKx-VJf_rYouDbBkjCN8GGv3n3VEZs9ad5j7nu3za7zhVU_E&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1vvkYg-WMDhHWlu-tAcT9GSDftUymRZaV5XC34byDjUw&oe=69D25575"}, {"file_name": "screen2.png", "id": "2213768045665821", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982446_2213768048999154_7700943960686362069_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AVAWCTKKztsQ7kNvwG6gf7t&_nc_oc=AdoVLmGLGOJ0XxqlyNSY9IUZpemsfZq-IkIYeaaecW0itdgW2tLCZ-OIYX5P_NTS9ns&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0divOkSs899_1mFUc6SOx-9pK9A3JTqmmQ-1cN5tdLGQ&oe=69D24D73"}, {"file_name": "screen1.png", "id": "1434832627212046", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974676_1434832630545379_1058264450705992772_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i8uKTXk2fJgQ7kNvwEv4o-s&_nc_oc=AdqZ74MN4ost_skpZeVw_4n5aeFK6mSsHIsxcHCetkx5mQszmYF_a_t8krQSEIByXHg&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3eV9nF-nzjNyh7hO9sotZx9UzOf85mFlFHF3FQsFQh1A&oe=69D275B5"}, {"file_name": "moviola-042025-2.png", "id": "1181600010102296", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473392132_1181600013435629_1405386606487826467_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6MMreP4Na4EQ7kNvwGFY9JD&_nc_oc=AdrvPjv1UNVHbFGcDu0cvJJmGSojFrt31G5Xv2AgylGsYgRaVL_olgT6P8K5FVoyne0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0GFUkthYR2b5dvpTnMfNUKVPQUUcWIIlAYPfKtflPDkw&oe=69D273D4"}, {"file_name": "moviola-042025-3.png", "id": "1664375897771182", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473391852_1664375901104515_5654525913464939787_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6hsmya3rEBEQ7kNvwF5OtiR&_nc_oc=AdoisoqZGeklSVOjafw4F6y2NUkK_cHs3WzJtZh-NjJujP4DzxgZWzbozpz1ABDVZFw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0Kxlhk_6NctwQbzslxgiVmMRsc5Cq_rP7jiL0weh09yA&oe=69D27C0B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "16-10.png", "id": "8512037645577760", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75395599_8512037655577759_1169937139310052534_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-v561IdztKQQ7kNvwFfzs6T&_nc_oc=AdqVUTFz9UjnVhGl5ZXCZnaZ36U8juwcpHuzRiv24incmwT6VFVyikVv72coaLki8ag&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af24SQCnBokAfwmA8R-VI3PqTAlJmzeDBOuezZFSXGs5Tg&oe=69D250FA"}, "display_name": "Moviola Video Editor", "keywords": ["video", "editor", "editing", "moviola", "film"], "long_description": "# Moviola: Your Video Editing solution on your Meta Quest\n\nMoviola is a mixed reality, immersive multi-track video editor built exclusively for Meta Quest devices. Use your hands or controllers to grab, trim, and arrange clips in 3D space, no desktop required.\n\n# Languages:\n- English\n- Spanish\n- German\n- French\n- Portuguese\n\n{8632676920173149}\n- Multi-track editing with ripple delete, overwrite, and slip modes  \n{522080987190953}\n- Import, preview, edit, and export. All in one seamless VR workflow\n\n# Main Features:\n- Edit 360\u00b0, 180\u00b0, 3D (SBS, TB), and standard 2D videos\n- Drag and drop clips into a multi-track timeline\n- View edits in passthrough, theater, or living room modes\n- Record voice-overs directly into your project\n- Organize media visually using interactive 3D reels\n- Auto-save and fast export to local storage\n\n**Supported Formats:**\n- Input: MP4 (H.264 & H.265 up to 8K, MPEG-4 Layer-2 up to 1080p), WAV, MP3, OGG\n- Export: MP4 (1080p, MPEG-4 Layer-2 + AAC), up to 60 fps\n- Layouts: 2D, 3D SBS/TB, 360\u00b0/180\u00b0 mono & stereo\n\n**Important:** Moviola is under active development. Try it, send feedback, and help shape the future of VR video editing!\n\nThis app uses FFmpeg under GPLv3 for high quality video export. Source code available at: github.com/kevinagnes/moviola-exporter-gpl-source", "short_description": "Edit videos like on your Meta Quest! Use natural hand gestures to manipulate your footage. Effortlessly refine your edits, save your progress, and share your final cut."}]}, "developer_name": null, "developer_privacy_policy_url": "https://xr.dev.br/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "XRDEVBR", "support_website_url": "https://discord.gg/5bDkRAsFPX", "website_url": "https://xr.dev.br/moviola/docs", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}, {"id": "1063584910766706"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "en_US", "en_GB", "fr", "de", "pt_BR", "pt", "es", "es_AR", "es_CL", "es_MX"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26081205471511257"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974794_1097932608423787_7197273108833725305_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ON7T1OCemeMQ7kNvwH6-K3X&_nc_oc=Adp-Xcgdp9C3Ua0ND8C_7Z0qFF1x6mxRdy9TjIPtrJHaShbNXg-yAcC2v6aMr6xsZDw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3XHpO4zFK6no76egd05nMBeVEqnP7ZFAkuGMdorWUFqg&oe=69D27B28"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Moviola Video Editor", "platform": "ANDROID_6DOF", "context_category": {"context_cat
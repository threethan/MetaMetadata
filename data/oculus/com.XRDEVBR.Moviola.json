R9U7SY8Uox9z68ee9vKjr2LIKgMA&oe=69F20EE9"}, {"file_name": "3.png", "id": "1546717659615384", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39035466_1546717669615383_6511054877644954414_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SkvwF3QUmegQ7kNvwE5mTaI&_nc_oc=Adqo10Dq-dpwOUEVP-O9IgFOOlAq6VwERLgLVtriO8-AHDw800mGcECNDXkbTTLI2YQ&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_Af37lumebbd3EokVVg2CHfeMfMn8XyoMFcTifXy9PfeOkg&oe=69F1E88C"}, {"file_name": "4.png", "id": "904907894773861", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75294240_904907898107194_8613408615661390259_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Tosk6dA10v8Q7kNvwE0Ga_i&_nc_oc=AdpevrQVV89jAUKCNiBbEGfWzb9yeKdSyLHFxBBsqPX_8lDpZp9BleIc1S5QUsQBzQ8&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_Af1eO2mfVKyCpzX6m0u9YOk4tzx9g4M9bB5W1VamsYzm_Q&oe=69F1EFE3"}, {"file_name": "5.png", "id": "2248683322146302", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38982468_2248683325479635_3305973444349433735_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oLw7S57CuH0Q7kNvwGWJVix&_nc_oc=AdrY6Tp0wjZJpSXXImMK2xevTeD9zr-dXYbxG_QoURdE7NGDfJP8wq59wTVgfYEVFH0&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_Af2QODl8xKoSFNumsMU2cL5JD01oPHDq5onEjC99Zrj7gw&oe=69F1EB2E"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Moviola - Video Editor", "keywords": [], "long_description": "**[Early Access]**\n\n# Moviola: Your XR Video Studio on Meta Quest\n\nMoviola is a mixed reality video editor designed exclusively for Meta Quest.  \nDitch the keyboard and mouse for an immersive, hands-on editing experience.\n\n# Features:\n- Intuitive Editing: Use natural hand gestures to manipulate your footage.\n- Immersive Previews: Watch your edits in passthrough, movie theater or a living room.\n- Seamless Workflow: Save, reload, and export your projects to XML effortlessly.\n\n# How to import your footage using Moviola Digest:\n- Go to xr.dev.br/moviola-digest for instructions.\n# How to import your footage without using Moviola Digest:\n- Upload your video and audio files to Quest/Movies (the folder already exists). The video extension must be **.mp4**, the audio extension must be **.ogg** and they should be the exact same length.\n\n**Important:** This app is not ready for professional work as the development is still in progress. You might have fun though as it is quite a unique way of editing your footage. I will appreaciate your purchase to support the project and also will be waiting for your feedback! Enjoy!\n\n# Extra screenshots:\n{328299153584761}\n{477451588330324}\n\n", "short_description": "Edit videos like never before with Moviola's immersive Mixed Reality experience (now in Early Access). Use natural hand gestures to manipulate your footage. Effortlessly refine your edits, save your progress, and share your final cut."}]}, "developer_name": null, "developer_privacy_policy_url": "https://xr.dev.br/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "XRDEVBR", "support_website_url": null, "website_url": "https://xr.dev.br/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}, {"id": "1063584910766706"}, {"id": "393222478507326"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "7806925069365909"}}]}, "scheduled_offers": {"count": 8, "nodes": [{"status": "PUBLISHED", "id": "1549634662856022"}, {"status": "PUBLISHED", "id"
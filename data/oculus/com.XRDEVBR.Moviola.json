ttps://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/473391978_844501071197642_3742530310486463674_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=see6MmwQwbYQ7kNvwEuYxXB&_nc_oc=AdoF5TyDool4XG8wrTe-I3nR2fqdDca-HwNOWRduPqO24x8mQkvcCuh3VdITybx0fCQ&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af92ox4_68UiwtKMn6YgUf_QdV3YcU9R9LxKaqHgxtBV9Q&oe=6A465975"}, {"file_name": "screen2.png", "id": "2213768045665821", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/38982446_2213768048999154_7700943960686362069_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=05oF_j-SdLgQ7kNvwH42esh&_nc_oc=Adq68_7kuZgphcCdgCVu_OoGQ9h-iugFnTmbrowHId0JdYPrf8bYNrO7D7uDpF_a4EE&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9MRrTZejpDjbW0Co_0ogy0cI9nHGPxZcVz119f7HfS-g&oe=6A4689B3"}, {"file_name": "screen1.png", "id": "1434832627212046", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/38974676_1434832630545379_1058264450705992772_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3I_9Krm_-psQ7kNvwGK2ayC&_nc_oc=AdqFqSjmvuGGOTSOQiL5ZA52Tje1sr0opuGDiWMQX1POu1TY8GW2LyT2bJQy5RYpwqo&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_1OwbMixci_fPi2ZdC3pz2XqpPdo7bODxsO2xDJ_MtNA&oe=6A4679B5"}, {"file_name": "moviola-042025-2.png", "id": "1181600010102296", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/473392132_1181600013435629_1405386606487826467_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v4VKQJ2xpQoQ7kNvwErFj8O&_nc_oc=AdoB1ezGuzkeYxdkTsjyZQlrCizMhpQkcDiRjeKSTmuwNwyNQUFLKjI1GOEZXrkOJIg&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-VqfVKNzPdMvMAFDtcKfJayA5F8_QfhNp6BH9o6YzmpQ&oe=6A4677D4"}, {"file_name": "moviola-042025-3.png", "id": "1664375897771182", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/473391852_1664375901104515_5654525913464939787_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=X3ZrZdlPkCsQ7kNvwElOZ83&_nc_oc=Adoe10dwKpOuNdf1oFHJlsmmIXYpADONMgxNt2sOUfzTqRH8FffJnZrhg_DhXEjmahQ&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_JehXx67e852POqi4WpCJ6uGxyTw9ruhboVU5-yNEPLg&oe=6A46800B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "16-10.png", "id": "8512037645577760", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/75395599_8512037655577759_1169937139310052534_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rDxI9A9OPyoQ7kNvwG0OHdK&_nc_oc=Ado5ruljxPZbhqad-hKsdWtdDgLQSy6ktoAJxtQFl2AxtbV6ryFU1-jDlXIuBodY68U&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-tHGFtU7i_OVRIVpiG_DBUlybaRADQwQVO7e53btCdWA&oe=6A468D3A"}, "display_name": "Moviola Video Editor", "keywords": ["video", "editor", "editing", "moviola", "film"], "long_description": "# Moviola: Your Video Editing solution on your Meta Quest\n\nMoviola is a mixed reality, immersive multi-track video editor built exclusively for Meta Quest devices. Use your hands or controllers to grab, trim, and arrange clips in 3D space, no desktop required.\n\n# Languages:\n- English\n- Spanish\n- German\n- French\n- Portuguese\n\n{8632676920173149}\n- Multi-track editing with ripple delete, overwrite, and slip modes  \n{522080987190953}\n- Import, preview, edit, and export. All in one seamless VR workflow\n\n# Main Features:\n- Edit 360\u00b0, 180\u00b0, 3D (SBS, TB), and standard 2D videos\n- Drag and drop clips into a multi-track timeline\n- View edits in passthrough, theater, or living room modes\n- Record voice-overs directly into your project\n- Organize media visually using interactive 3D reels\n- Auto-save and fast export to local storage\n\n**Supported Formats:**\n- Input: MP4 (H.264 & H.265 up to 8K, MPEG-4 Layer-2 up to 1080p), WAV, MP3, OGG\n- Export: MP4 (1080p, MPEG-4 Layer-2 + AAC), up to 60 fps\n- Layouts: 2D, 3D SBS/TB, 360\u00b0/180\u00b0 mono & stereo\n\n**Important:** Moviola is under active development. Try it, send feedback, and help shape the future of VR video editing!\n\nThis app uses FFmpeg under GPLv3 for high quality video export. Source code available at: github.com/kevinagnes/moviola-exporter-gpl-source", "short_description": "Edit videos like on your Meta Quest! Use natural hand gestures to manipulate your footage. Effortlessly refine your edits, save your progress, and share your final cut."}]}, "developer_name": null, "developer_privacy_policy_url": "https://xr.dev.br/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "XRDEVBR", "support_website_url": "https://discord.gg/5bDkRAsFPX", "website_url": "https://xr.dev.br/moviola/docs", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}, {"id": "1063584910766706"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "en_US", "en_GB", "fr", "de", "pt_BR", "pt", "es", "es_AR", "es_CL", "es_MX"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26081205471511257"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/38974794_1097932608423787_7197273108833725305_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GGb3qiRgLWcQ7kNvwHQQwkK&_nc_oc=AdrmfSkRoctWaJ91omBelJJlxlL0aL5fDI2VPsO9IfI5eyBFjfia7gEYrdo9kXFlap0&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9flbi5_zkQw6VXLvuhNBPoHmuZuiZEe_5wqmT1lszfDA&oe=6A467F28"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Moviola Video Editor", "platform": "ANDROID_6DOF", "context_category": {"con
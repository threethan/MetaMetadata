luscdn.com&_nc_ss=7f20f&oh=00_AQFDLnRpKNf1-S2Li3d1FXBs-pZpo-UuNjJPWEwf-1fDBg&oe=6A857C36"}, {"file_name": "asset 05 (meta).png", "id": "1297663184758466", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/38974649_1297663188091799_5190988622455255319_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MDfnbKKCmQcQ7kNvwGmb62f&_nc_oc=AdoLsgXvzA4cpWI7DQ7lnEB9GvPwDQul1AjzKjmqBzgvsbFW4kh2M0T8ZTF_O9RSMlE&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGGUIYJXh23CWaC8_xEGPxY-hcVsrBsz5nvqRE22j6eFw&oe=6A85A2FD"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Rising Tides: Miami's Future", "keywords": ["flooding", "climate", "change", "resilience", "miami"], "long_description": "Rising Tides: Miami\u2019s Future is an immersive Meta Quest experience that puts you at the center of Miami\u2019s battle against hurricanes, flooding, and sea-level rise\u2014and the innovative solutions that can help protect it.\n\nExplore Little Havana, Brickell, and Virginia Key using interactive 3D models, aerial views, and real-world photorealistic flooding simulations. Witness firsthand how extreme weather threatens homes, businesses, and infrastructure while discovering flood barriers, home elevation, seawalls, and nature-based defenses that can help safeguard the city.\n\nFeel the force of hurricane winds and storm surges as you navigate through Miami\u2019s most vulnerable neighborhoods. Through cutting-edge VR technology, experience different flooding scenarios and see how engineering and community-driven strategies can build a more resilient future.", "short_description": "Rising Tides: Miami\u2019s Future is an immersive Meta Quest experience exploring Miami\u2019s fight against hurricanes, flooding, and sea-level rise. Visit Little Havana, Brickell, and Virginia Key to witness the impact and discover real-world solutions."}]}, "developer_name": null, "developer_privacy_policy_url": "https://virtualplanet.tech/privacy-policy-app", "de
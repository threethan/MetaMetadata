7kNvwGP_vPw&_nc_oc=AdoRH6Eb25Gic3zVfuTLPQugdb4XCZMKZEbC0rlFK7C1N8HCOhmPIum7gXOP4BW_dUQ&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5O5F3qmz0iKrJbD42CVkkhALtdOxjro4p7umyzaOHJVw&oe=6A11C86F"}, {"file_name": "asset 04 (meta).png", "id": "1640483686904556", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/43931338_1640483690237889_5430232095601716091_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eNPZOVNhI4UQ7kNvwELTnEc&_nc_oc=AdpOXEYPUezveMqpNAQRwjac22Hce-UL9MqpAdWMq9f4x0rgRTpS7ENj7aoS4l6KU_A&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7QlB7JYXbD1cBPC41AQE6Jt65Mnx-94p2uzLjyJXIz8w&oe=6A11B076"}, {"file_name": "asset 05 (meta).png", "id": "1297663184758466", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/38974649_1297663188091799_5190988622455255319_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v3IhlIX9YKoQ7kNvwGz43Kh&_nc_oc=AdpJTdVpgfAaiGbMNgYROGr-u8TrER_773XK7t3u9G99nqxM6UZo--0NphmmSfSV2ZY&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af74i0MPReqQ44oJ7-k9mEfDLq6bizR0HDTInVWjykIPjA&oe=6A119EFD"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Rising Tides: Miami's Future", "keywords": ["flooding", "climate", "change", "resilience", "miami"], "long_description": "Rising Tides: Miami\u2019s Future is an immersive Meta Quest experience that puts you at the center of Miami\u2019s battle against hurricanes, flooding, and sea-level rise\u2014and the innovative solutions that can help protect it.\n\nExplore Little Havana, Brickell, and Virginia Key using interactive 3D models, aerial views, and real-world photorealistic flooding simulations. Witness firsthand how extreme weather threatens homes, businesses, and infrastructure while discovering flood barriers, home elevation, seawalls, and nature-based defenses that can help safeguard the city.\n\nFeel the force of hurricane winds and storm surges as you navigate through Miami\u2019s most vulnerable neighborhoods. Through cutting-edge VR technology, experience different flooding scenarios and see how engineering and community-driven strategies can build a more resilient future.", "short_description": "Rising Tides: Miami\u2019s Future is an immersive Meta Quest experience exploring Miami\u2019s fight against hurricanes, flooding, and sea-level rise. Visit Little Havana, Brickell, and Virginia Key to witness the impact and discover real-world solutions."}]}, "developer_name": null, "developer_privacy_policy_url": "https://virtualplanet.tech/privacy-policy-app", "developer_terms_of_service_url": null, "publisher_name": "Virtual Planet Technologies", "support_website_url": null, "website_url": "https://virtualplanet.tech/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "es_MX"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26765650896411567"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "890633939720563"}]}, "baseline_offer": {"id": "890633939720563"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1751980800, "status": "PUBLISHED", "id": "890633939720563"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "30102329376077019", "version": "0.3"}, "id": "1273079030350306", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename
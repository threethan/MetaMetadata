ontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0vCF-AbVBwkLhgQ3GPmR1CJSNda8wXDh-2FKBdbevp7A&oe=69D642B5"}, {"file_name": "asset 02.png", "id": "2003506596799104", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974721_2003506600132437_4679965552704233933_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qkz5W6M92L0Q7kNvwEpm6gX&_nc_oc=Adr_ZMEIblfPp-dkk4B5_3CAj8bykr2TuDJMmiW4wsqXCZ5KxTSsIFycJMncfGPCt0I&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af25BuG6zhasQrMfFS567MwO6NBwZrnwn5pL1vleefcQYg&oe=69D66009"}, {"file_name": "asset 03.png", "id": "1104451854797873", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974850_1104451858131206_1217627113683943205_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8IRsgHP_STUQ7kNvwEr3w_m&_nc_oc=AdrLHmfGIAYVo3SPpuViyR1Tpxnkl_MfZOMpQWpejJmHDJEHgJXJcChULO2vUbAMJUI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af30G2zq2qKQGrUtMF-7rAhaUnCrVoQY9OetzWb5lWHwPQ&oe=69D63CAF"}, {"file_name": "asset 04 (meta).png", "id": "1640483686904556", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/43931338_1640483690237889_5430232095601716091_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nTuhXWKAf8MQ7kNvwGM57Yo&_nc_oc=AdqJQLsCEIRWVXCU8Yx8fvRCdXks4nHnZEo0iMLUM4eWYOYzRTcoOlzwdbGECbyH7jU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af000vD5GJA7pdo_n9xDmwSmHrZxL8-r5VYpNq_CCA4QpA&oe=69D65CF6"}, {"file_name": "asset 05 (meta).png", "id": "1297663184758466", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974649_1297663188091799_5190988622455255319_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=llq8xCO7d-AQ7kNvwEfWzZM&_nc_oc=Adq06o-kYOPGqxrRuv94BwgV35icrpUp_SMfs7E4yTB0c17mQ4gfwed6jkgQhGkE61g&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1Zy_3ubN4zbbe3diektTEK2A7MNooUSVIU1r8spWsL1w&oe=69D64B7D"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Rising Tides: Miami's Future", "keywords": ["flooding", "climate", "change", "resilience", "miami"], "long_description": "Rising Tides: Miami\u2019s Future is an immersive Meta Quest experience that puts you at the center of Miami\u2019s battle against hurricanes, flooding, and sea-level rise\u2014and the innovative solutions that can help protect it.\n\nExplore Little Havana, Brickell, and Virginia Key using interactive 3D models, aerial views, and real-world photorealistic flooding simulations. Witness firsthand how extreme weather threatens homes, businesses, and infrastructure while discovering flood barriers, home elevation, seawalls, and nature-based defenses that can help safeguard the city.\n\nFeel the force of hurricane winds and storm surges as you navigate through Miami\u2019s most vulnerable neighborhoods. Through cutting-edge VR technology, experience different flooding scenarios and see how engineering and community-driven strategies can build a more resilient future.", "short_description": "Rising Tides: Miami\u2019s Future is an immersive Meta Quest experience exploring Miami\u2019s fight against hurricanes, flooding, and sea-level rise. Visit Little Havana, Brickell, and Virginia Key to witness the impact and discover real-world solutions."}]}, "developer_name": null, "developer_privacy_policy_url": "https://virtualplanet.tech/privacy-policy-app", "developer_terms_of_service_url": null, "publisher_name": "Virtual Planet Technologies", "support_website_url": null, "website_url": "https://virtualplanet.tech/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "es_MX"], "supported_
iyUBYkWMvCDL8glHOdg&oe=6ABE82A5"}, {"file_name": "4.png", "id": "2276261199847152", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491821568_2276261203180485_5141345889848487279_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vjoDYb7kuXkQ7kNvwHnK1VJ&_nc_oc=Adq6lEF_mF7ehA9ifR1aN4d_PCI8Ei4rDiL4o1WNbrR5wA1xD0N_pM7woZ3syyXZnDk&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKddnaR9KV9bbOrCnAK5qWipTYaBclSs49xtuP2MMn28w&oe=6ABE6A4B"}, {"file_name": "5.png", "id": "1658192142062581", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491827611_1658192145395914_4367355705640821648_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bPKArc7O89YQ7kNvwG1oei0&_nc_oc=AdpiMQylvoz3A3U1TIoKfURx-8uz77n26TZOXo7Vz7Sr1dik5ecOQLq2EzzUaNVXOE8&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJLuuSAAuPamFlyIVoWTdN1pU2gdpXR5qm5aK-9fGYWGA&oe=6ABE897F"}, {"file_name": "6.png", "id": "1316031040474485", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491823837_1316031043807818_9117374153270453387_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5mpcWcbXzbMQ7kNvwFj4BzV&_nc_oc=AdpFXbYIflw530VAzKwDEsJcXDPeN7srMZDkBfVQSxpawV0aKJmDd5BtFCCGfkfBIKw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIZ0LUGXApy9S9sFOgfF1IQo7QS4SEpXMjQ4__sYt4GHQ&oe=6ABE5B4A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover landscape.png", "id": "1009223731560659", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491824700_1009223734893992_3771315135896219880_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5OlYHGOif2gQ7kNvwEVFfWk&_nc_oc=AdqxcDoi4p3NdumnASF2DJFJMm5L8kgIfTCxRrlCdubAdQHC_-wH0E_K3OCVItDTCmk&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJNMjUCrLT3pPtc6vlICrUbv5GoeR6ertvGSHmDEarG1g&oe=6ABE8B65"}, "display_name": "NanoVer iMD-XR", "keywords": ["molecules", "science", "chemistry", "research", "learning"], "long_description": "**Visualize and interact with molecular simulations in virtual and augmented reality.** \n\nNanoVer iMD-XR is an immersive XR client for molecular dynamics, built for scientists, students, and curious minds. Explore atomic-scale structures and physically interact with simulations, all from inside your headset.\n  \nNanoVer is an open-source framework developed at the Intangible Realities Laboratory (IRL). It supports simulations powered by OpenMM and ASE, and has been used in published research across chemistry and structural biology.\n  \nTwo ways of using NanoVer iMD-XR:\n\n- Watch online demos: Replay from a selection of recorded interactive molecular dynamics (iMD) sessions.\n- Interact live: Connect to a NanoVer server running on your computer or local network and interact with a live simulation in real time. Grab molecules, apply forces, and observe how molecular systems respond to your input.\n\nPerfect for: research groups, university teaching labs, science communicators, and anyone who wants to experience molecular science from the inside.\n\nVisit **nanover.org** to learn more about the project, publications, and how to setup your own simulation server.\n\n ---- \n\n_This project is developed by the Intangible Realities Laboratory (IRL) with support from the European Research Council under the EU's Horizon 2020 Research & Innovation Program (grant No. 866559), the Xunta de Galicia, and the CiTiUS | Center for Intelligent Technology Research at the University of Santiago de Compostela._", "short_description": "Visualize and interact with molecular simulations in XR.\n\nNanoVer iMD-XR is an immersive XR client for molecular dynamics, built for scientists, students, and curious minds. Explore atomic-scale structures and physically interact with simulations, all from inside your headset."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.intangiblerealitieslab.org/nanover-app-privacy", "developer_terms_of_service_url": "https://www.intangiblerealitieslab.org/nanover-app-terms", "pub
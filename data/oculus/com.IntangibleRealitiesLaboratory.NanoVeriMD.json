culuscdn.com&_nc_ss=7f20f&oh=00_AQIZ0LUGXApy9S9sFOgfF1IQo7QS4SEpXMjQ4__sYt4GHQ&oe=6ABE5B4A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover landscape.png", "id": "1009223731560659", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491824700_1009223734893992_3771315135896219880_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5OlYHGOif2gQ7kNvwEVFfWk&_nc_oc=AdqxcDoi4p3NdumnASF2DJFJMm5L8kgIfTCxRrlCdubAdQHC_-wH0E_K3OCVItDTCmk&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJNMjUCrLT3pPtc6vlICrUbv5GoeR6ertvGSHmDEarG1g&oe=6ABE8B65"}, "display_name": "NanoVer iMD-XR", "keywords": ["molecules", "science", "chemistry", "research", "learning"], "long_description": "**Visualize and interact with molecular simulations in virtual and augmented reality.** \n\nNanoVer iMD-XR is an immersive XR client for molecular dynamics, built for scientists, students, and curious minds. Explore atomic-scale structures and physically interact with simulations, all from inside your headset.\n  \nNanoVer is an open-source framework developed at the Intangible Realities Laboratory (IRL). It supports simulations powered by OpenMM and ASE, and has been used in published research across chemistry and structural biology.\n  \nTwo ways of using NanoVer iMD-XR:\n\n- Watch online demos: Replay from a selection of recorded interactive molecular dynamics (iMD) sessions.\n- Interact live: Connect to a NanoVer server running on your computer or local network and interact with a live simulation in real time. Grab molecules, apply forces, and observe how molecular systems respond to your input.\n\nPerfect for: research groups, university teaching labs, science communicators, and anyone who wants to experience molecular science from the inside.\n\nVisit **nanover.org** to learn more about the project, publications, and how to setup your own simulation server.\n\n ---- \n\n_This project is developed by the Intangible Realities Laboratory (IRL) with support from the European Research Council under the EU's Horizon 2020 Research & Innovation Program (grant No. 866559), the Xunta de Galicia, and the CiTiUS | Center for Intelligent Technology Research at the University of Santiago de Compostela._", "short_description": "Visualize and interact with molecular simulations in XR.\n\nNanoVer iMD-XR is an immersive XR client for molecular dynamics, built for scientists, students, and curious minds. Explore atomic-scale structures and physically interact with simulations, all from inside your headset."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.intangiblerealitieslab.org/nanover-app-privacy", "developer_terms_of_service_url": "https://www.intangiblerealitieslab.org/nanover-app-terms", "publisher_name": "Intangible Realities Laboratory", "support_website_url": null, "website_url": "https://www.intangiblerealitieslab.org/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "36868081026138837"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491823790_2244132529687940_8692471098989307256_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2Ixp_Qfz-UEQ7kNvwGsXqY3&_nc_oc=AdoBpMPBVBPUhlw3B9b0xSvFRIAT8qh9Q_Zf_0bBZazDkBclTJJMV-W1h3PSiP5sVr4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKgey5aBsMqBCfrzJ
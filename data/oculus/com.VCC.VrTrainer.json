O4MQ7kNvwEpH_Mz&_nc_oc=AdoK0JoKlmRnHfQgD0_0-JbCAnQGa6lp44xq_eRCKX6PJuisowAwBIOZnyFoP-8zBMc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRAEIXMkd6i_rPtSumUd9oSW8RmZXP7u19kbPOd5r_KPA&oe=6AFDDF15"}, {"file_name": "micree_ss_lobby_ (2).png", "id": "4431717037099766", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491823279_4431717040433099_2377152020727135635_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sO8if7-rdwcQ7kNvwF07D1q&_nc_oc=AdoRU74t-v-Jy_jn7TMcqtORr0-bxrjf46MkrFzWsrGy5VD_zttUiDeGYfse3m0QvKU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSIcsS7o8DqhMjMcr8_5LGV5mNRYITkHYUZeT_ynCyTUQ&oe=6AFDC417"}, {"file_name": "micree_ss_lobby_ (6).png", "id": "1280162084008131", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491830147_1280162087341464_171379362385302714_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j8Ix-aDLFD4Q7kNvwHXxQYs&_nc_oc=AdqWfTQpTmCcHX1Eex4x4WjBoXUwQPn5kKt54EJzHyqei0vbgtRxptl5gWmh-n-WiKw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT1R-hU8UlQCTzSHKK8XJ0iF0cMb6A-c_USEMmqQ0EZmQ&oe=6AFDCC30"}, {"file_name": "micree_ss_lobby_ (1).png", "id": "2004917297573280", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491821099_2004917300906613_361793101057285141_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uggNojqxo40Q7kNvwEQ61Q6&_nc_oc=AdoDhrzfXCi6ui_Vr4bOHz6tKxx_oLWuuAb8wUnGhCMpp4v8JqxJ3lzJ5N4XIrmhkKo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQwse_uRxwFiK0AKQYQfxkHX-f2R6wnlY_ZbWmNWI6SYw&oe=6AFDB0FD"}, {"file_name": "micree_ss_lobby_ (3).png", "id": "934716052401945", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491830147_934716055735278_4957941621233629084_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8G-pFX3h2zcQ7kNvwFp2-UO&_nc_oc=AdqdOuOAz3aSZy1vXu5wF1nYAHik9FN-IUmG0SELRjVs2pxFqujFo8uAjUE95G4t50g&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQdfR4SCodj0baaMn2VNMKrzMa6ekOFOT8QXxWC1nF3RQ&oe=6AFDC5F4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2026-03-03 14-28-55.00_01_28_10.Still001 1.png", "id": "910671428435572", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491825415_910671435102238_4860379482396085105_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xQ4bLueYigEQ7kNvwEVrIxE&_nc_oc=Adru3H7Ctf3slHkL47VLtLCWkzyrMOnSpHgz66q9qjEMM_AN8b31DXEUTYRHIfWonY0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQv4OKT3buNhWGYVWzmugMrXC9UH3uBPk0ACMbTjbHFwA&oe=6AFDD5E3"}, "display_name": "Micree", "keywords": ["Training", "Education", "Development", "Qualifications", "vocational"], "long_description": "Micree is an innovative VR app that allows users to acquire practical professional skills through immersive training scenarios. Each user can follow an individual development path tailored to their interests and needs. After putting on VR goggles, you enter a virtual lobby - a center from which you can move to various educational spaces and learn through action.  \n\nA variety of scenarios await you in Micree. In the Civil Defense module, you will prepare for emergency situations: you will learn how to respond to alarm signals, pack an evacuation backpack, and safely reach a shelter. In the VR Cinema, you will watch 2D and 360\u00b0 materials presenting various work environments and career paths.  \n\nYou will test your skills on the Obstacle Course, developing your reflexes and reaction speed. In the Assertiveness Training module, you will learn to recognize bullying and respond appropriately in a safe, controlled environment.  \n\nThe app develops technical skills. In the Construction Carpentry module, you will take on the role of a fitter, learn about tools, and take measurements. In 3D printing, you will see different types of printers. \n\nMicree also has a Scenario Creator that allows you to create your own educational worlds in VR and design training spaces tailored to your needs.  \n\nLearn through experience, develop practical and social skills, and collaborate with other users from anywhere in the world. Micree is a modern, engaging dimension of VR education.  ", "short_description": "Micree is a VR application for practical vocational training through interactive training scenarios. In the virtual lobby, you choose areas of study: from civil defense and carpentry to 3D printing and social skills. Develop your skills in realistic situations, create your own scenarios, and join in the fun with users from around the world. Discover what really excites you and learn through VR experience.  "}]}, "developer_name": "Fundacja VCC", "developer_privacy_policy_url": "https://micree.pl/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Fundacja VCC", "support_website_url": "https://micree.pl/kontakt", "website_url": "https://micree.pl/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}, {"id": "1819021644882647"}, {"id": "1228796255027646"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "pl"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["CO_OP", "MULTI_USER", "SINGLE_USER"], "id": "7128791740465348"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491822307_1584971396093553_8823800479390489603_n.png?stp=dst-png_s360x360&_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HAdEmeReTSEQ7kNvwF3JME2&_nc_oc=AdrybRH4z-WhdhnZQNAEycYa3OaGtMkaHPlS_gEClKp9GS9K5n2yS3SlR7ZcN3EGsa0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRhECDdIbQvyejupprei3jLc-UT37K-gYs9SA2zHmW0dg&oe=6AFDE082"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Micree", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_name": "Learning", "id": "1043107547362485"}, {"topic_name": "Creativity", "id": "1819021644882647"}, {"topic_name": "Community", "id": "1228796255027646"}], "release_date": 1791193200, "lastRevision": {"nodes": [{"id": "7128791750465347", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "7128791730465349", "is_first_party": false, "enables_in_app_ads": false, "is_concept": false, "platform": "ANDROID_6DOF"}, "iarc_cert": {"id": "1353909403451807"}, "iarc_email": null, "msrp": null, "translations": {"nodes": [{"images": {"nodes": []}, "id": "26402339426028499", "locale": "pl_PL", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Micree", "keywords": [], "long_description": "Micree to innowacyjna aplikacja VR, kt\u00f3ra pozwala zdobywa\u0107 praktyczne umiej\u0119tno\u015bci zawodowe poprzez immersyjne scenariusze szkoleniowe. Ka\u017cdy u\u017cytkownik mo\u017ce pod\u0105\u017ca\u0107 indywidualn\u0105 \u015bcie\u017ck\u0105 rozwoju dopasowan\u0105 do zainteresowa\u0144 i potrzeb. Po za\u0142o\u017ceniu gogli VR trafiasz do wirtualnego lobby - centrum, z kt\u00f3rego przechodzisz do r\u00f3\u017cnych przestrzeni edukacyjnych i uczysz si\u0119 poprzez dzia\u0142anie. \n\nW Micree czekaj\u0105 r\u00f3\u017cnorodne scenariusze. W module Obrony Cywilnej przygotujesz si\u0119 do sytuacji kryzysowych: nauczysz si\u0119 reagowa\u0107 na sygna\u0142y alarmowe, spakowa\u0107 plecak ewakuacyjny i bezpiecznie dotrze\u0107 do schronienia. W Kinie VR obejrzysz materia\u0142y 2D i 360\u00b0, prezentuj\u0105ce r\u00f3\u017cne \u015brodowiska pracy oraz \u015bcie\u017cki zawodowe. \n\nSprawdzisz swoj\u0105 sprawno\u015b\u0107 na Torze Przeszk\u00f3d, rozwijaj\u0105c refleks, koordynacj\u0119 i szybko\u015b\u0107 reakcji. W module Treningu asertywno\u015bci nauczysz si\u0119 rozpoznawa\u0107 mobbing i odpowiednio reagowa\u0107 w bezpiecznym, kontrolowanym \u015brodowisku. \n\nAplikacja rozwija umiej\u0119tno\u015bci techniczne. W module Stolarki Budowlanej wcielisz si\u0119 w montera, poznasz narz\u0119dzia i wykonasz pomiary. W Druku 3D zaprojektujesz model i obs\u0142u\u017cysz wirtualn\u0105 drukark\u0119. \n\nMicree ma te\u017c Kreator Scenariuszy, kt\u00f3ry pozwala tworzy\u0107 w\u0142asne \u015bwiaty edukacyjne w VR i projektowa\u0107 przestrzenie szkoleniowe dopasowane do potrzeb. \n\nUcz si\u0119 przez do\u015bwiadczenie, rozwijaj kompetencje praktyczne i spo\u0142eczne oraz wsp\u00f3\u0142pracuj z innymi u\u017cytkownikami z dowolnego miejsca na \u015bwiecie. Micree to nowoczesny, anga\u017cuj\u0105cy wymiar edukacji VR. ", "short_description": "Micree to aplikacja VR do praktycznej nauki zawodu poprzez interaktywne scenariusze szkoleniowe. W wirtualnym lobby wybierasz obszary nauki: od obrony cywilnej i stolarki budowlanej po druk 3D czy kompetencje spo\u0142eczne. Rozwijaj umiej\u0119tno\u015bci w realistycznych sytuacjach, tw\u00f3rz w\u0142asne scenariusze i do\u0142\u0105czaj do wsp\u00f3lnej rozgrywki z u\u017cytkownikami z ca\u0142ego \u015bwiata. Odkryj, co naprawd\u0119 Ci\u0119 kr\u0119ci i ucz si\u0119 przez do\u015bwiadczenie w VR. "}, {"images": {"nodes": [{"file_name": "micree_banner_napis_2560x1440_.png", "id": "3975318282762797", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491824700_3975318286096130_3405558855666775359_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&
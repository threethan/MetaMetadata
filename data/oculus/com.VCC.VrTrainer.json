_171379362385302714_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j8Ix-aDLFD4Q7kNvwHXxQYs&_nc_oc=AdqWfTQpTmCcHX1Eex4x4WjBoXUwQPn5kKt54EJzHyqei0vbgtRxptl5gWmh-n-WiKw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT1R-hU8UlQCTzSHKK8XJ0iF0cMb6A-c_USEMmqQ0EZmQ&oe=6AFDCC30"}, {"file_name": "micree_ss_lobby_ (1).png", "id": "2004917297573280", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491821099_2004917300906613_361793101057285141_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uggNojqxo40Q7kNvwEQ61Q6&_nc_oc=AdoDhrzfXCi6ui_Vr4bOHz6tKxx_oLWuuAb8wUnGhCMpp4v8JqxJ3lzJ5N4XIrmhkKo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQwse_uRxwFiK0AKQYQfxkHX-f2R6wnlY_ZbWmNWI6SYw&oe=6AFDB0FD"}, {"file_name": "micree_ss_lobby_ (3).png", "id": "934716052401945", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491830147_934716055735278_4957941621233629084_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8G-pFX3h2zcQ7kNvwFp2-UO&_nc_oc=AdqdOuOAz3aSZy1vXu5wF1nYAHik9FN-IUmG0SELRjVs2pxFqujFo8uAjUE95G4t50g&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQdfR4SCodj0baaMn2VNMKrzMa6ekOFOT8QXxWC1nF3RQ&oe=6AFDC5F4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2026-03-03 14-28-55.00_01_28_10.Still001 1.png", "id": "910671428435572", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491825415_910671435102238_4860379482396085105_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xQ4bLueYigEQ7kNvwEVrIxE&_nc_oc=Adru3H7Ctf3slHkL47VLtLCWkzyrMOnSpHgz66q9qjEMM_AN8b31DXEUTYRHIfWonY0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQv4OKT3buNhWGYVWzmugMrXC9UH3uBPk0ACMbTjbHFwA&oe=6AFDD5E3"}, "display_name": "Micree", "keywords": ["Training", "Education", "Development", "Qualifications", "vocational"], "long_description": "Micree is an innovative VR app that allows users to acquire practical professional skills through immersive training scenarios. Each user can follow an individual development path tailored to their interests and needs. After putting on VR goggles, you enter a virtual lobby - a center from which you can move to various educational spaces and learn through action.  \n\nA variety of scenarios await you in Micree. In the Civil Defense module, you will prepare for emergency situations: you will learn how to respond to alarm signals, pack an evacuation backpack, and safely reach a shelter. In the VR Cinema, you will watch 2D and 360\u00b0 materials presenting various work environments and career paths.  \n\nYou will test your skills on the Obstacle Course, developing your reflexes and reaction speed. In the Assertiveness Training module, you will learn to recognize bullying and respond appropriately in a safe, controlled environment.  \n\nThe app develops technical skills. In the Construction Carpentry module, you will take on the role of a fitter, learn about tools, and take measurements. In 3D printing, you will see different types of printers. \n\nMicree also has a Scenario Creator that allows you to create your own educational worlds in VR and design training spaces tailored to your needs.  \n\nLearn through experience, develop practical and social skills, and collaborate with other users from anywhere in the world. Micree is a modern, engaging dimension of VR education.  ", "short_description": "Micree is a VR application for practical vocational training through interactive training scenarios. In the virtual lobby, you choose areas of study: from civil defense and carpentry to 3D printing and social skills. Develop your skills in realistic situations, create your own scenarios, and join in the fun with users from around the world. Discover what really excites you and learn through VR experience.  "}]}, "developer_name": "Fundacja VCC", "developer_privacy_policy_url": "https://micree.pl/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Fundacja VCC", "support_website_url": "https://micree.pl/kontakt", "website_url": "https://micree.pl/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}, {"id": "1819021644882647"}, {"id": "1228796255027646"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "pl"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["CO_OP", "MULTI_USER", "SINGLE_USER"], "id": "7128791740465348"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "3215617005284596"}]}, "baseline_offer": {"id": "3215617005284596"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1791193200, "status": "PUBLISHED", "id": "3215617005284596"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "29784359021148631", "version": "2.12.17"}, "id": "1765337667232579", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "7128791730465349", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "29784359021148631"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": []}, "change_log": null, "created_date": 1794498943, "id": "29832522926332240", "version": "2.12.22", "version_code": 21222, "release_status": "RELEASED", "status": "APPROVED", "binary_test_resu
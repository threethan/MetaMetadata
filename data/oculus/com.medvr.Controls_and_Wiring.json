ent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQQeRC4tgOZEeOpYBusO1ZJlswlZAOn7b5IiDcG5G3-Bw&oe=6B083EB9"}, {"file_name": "Screenshot 2026-04-22 183002.png", "id": "1332393342127564", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/499618938_1332393345460897_8992074743206624923_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q4Q66cX31Q4Q7kNvwFPH4CI&_nc_oc=Adq5NjRrAxk8bvOShNaZqHtYXvuh_ZA9Rw4Kzt0A-_A5y6Kj4Nc3Q6gxUxqGS5oUicw&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT0Mo1FIkFFoHEO8QEf-7d5hbU1F7q5nDGkAWOPef_yGg&oe=6B0855A3"}, {"file_name": "Screenshot 2026-04-22 182937.png", "id": "26822660627371867", "uri": "https://scontent-dfw5-3.oculuscdn.com/v/t64.5771-25/499619145_26822660650705198_178178829357942133_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rSukhTzCmG0Q7kNvwG3feRk&_nc_oc=AdpqLGqr8TVRnW2BlfLA1bvtAwUh5wOb1JGxo0kHm9bdmrZ-_PpQxj3dsPKcUlw0wcc&_nc_zt=3&_nc_ht=scontent-dfw5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTkJqvWc83_PgLlh5bJYNOZrgHoS1UYfNsIwnV9eNXMjg&oe=6B086244"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Controls and Wiring", "keywords": ["control", "wiring", "vr", "immerselearn"], "long_description": "Controls and Wiring is an immersive VR training application that enables learners to develop real-world skills in electrical control systems, circuit wiring, and component integration. Through interactive simulations, users practice identifying components, interpreting wiring diagrams, assembling control circuits, and troubleshooting faults in a safe, virtual environment.\n\nThis application is a core component of the Immerse Learn Controls and Wiring micro-credential program, designed to enhance technical proficiency through experiential learning. Learners gain confidence by performing tasks that mirror real industry scenarios, improving both accuracy and decision-making skills.\n\nPlease note: This app is not a standalone product. Access is strictly limited to individuals enrolled in the Immerse Learn Controls and Wiring micro-credential program, where it is used for guided, hands-on training.", "short_description": "Controls and Wiring is a VR training application designed to build practical skills in electrical control systems and wiring. Part of the Immerse Learn Controls and Wiring micro-credential program, this app provides hands-on, immersive learning experiences. Access is exclusively available to learners enrolled in the program."}]}, "developer_name": null, "developer_privacy_policy_url": "https://immerselearn.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "ImmerseLearn", "support_website_url": null, "website_url": "https://immerselearn.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26584973084492331"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw5-3.oculuscdn.com/v/t64.5771-25/499618093_2928074970857357_3137118280681974914_n.png?stp=dst-png_s360x360&_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OtsoTBpMQvoQ7kNvwFztUZ8&_nc_oc=AdrlOysm74Djw4VkAqq_2NGDQYOwqeYXNCdh5EEHn0xaY4Q08n07Vq2ixpSP0ZlBMwY&_nc_zt=3&_nc_ht=scontent-dfw5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTP0t4FB8QpRjmnKTIKCrtX5UZ5Gx66fhFdeqJI1ogK2A&oe=6B086E09"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_n
", "id": "1497513168406732", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/499618064_1497513171740065_7327587827834032018_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ihC33NHEBXAQ7kNvwFXJzNG&_nc_oc=Adru7_0nKi7F-M827SyVLDw0uiUnmL15ksgrKbchDT_U7MNwYdoU3u6k2q8FUAiNIwI&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4i8wKFZdAe9WK-daAzzAISyhkjS13RqWHHga76V2qCHA&oe=6A11B639"}, {"file_name": "Screenshot 2026-04-22 183002.png", "id": "1332393342127564", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/499618938_1332393345460897_8992074743206624923_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=csnfTSI9DywQ7kNvwFENeOT&_nc_oc=AdrJMvJBRgiAXICNRSMoQiXr9iqhcxwtuQcpdkbAYBlx0VOole12Q52UVeMAg7O67T0&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af499vqDqs4J8htrrv_ReYUEyFFdD9MIVL7os3P5kvV-UA&oe=6A11CD23"}, {"file_name": "Screenshot 2026-04-22 182937.png", "id": "26822660627371867", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/499619145_26822660650705198_178178829357942133_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y-MGyBeFb2cQ7kNvwFaVv9J&_nc_oc=AdqltP7ZxzrVi2G3tC1Y45prFQzNTQqguxf0N46Q_pQYOVv0MHdws3XY_xyQ7_qOno8&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7G4rGDf3965Aq90N5kbR7vOCu4WJExDysmpU_kJC_0sA&oe=6A11A184"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Controls and Wiring", "keywords": ["control", "wiring", "vr", "immerselearn"], "long_description": "Controls and Wiring is an immersive VR training application that enables learners to develop real-world skills in electrical control systems, circuit wiring, and component integration. Through interactive simulations, users practice identifying components, interpreting wiring diagrams, assembling control circuits, and troubleshooting faults in a safe, virtual environment.\n\nThis application is a core component of the Immerse Learn Controls and Wiring micro-credential program, designed to enhance technical proficiency through experiential learning. Learners gain confidence by performing tasks that mirror real industry scenarios, improving both accuracy and decision-making skills.\n\nPlease note: This app is not a standalone product. Access is strictly limited to individuals enrolled in the Immerse Learn Controls and Wiring micro-credential program, where it is used for guided, hands-on training.", "short_description": "Controls and Wiring is a VR training application designed to build practical skills in electrical control systems and wiring. Part of the Immerse Learn Controls and Wiring micro-credential program, this app provides hands-on, immersive learning experiences. Access is exclusively available to learners enrolled in the program."}]}, "developer_name": null, "developer_privacy_policy_url": "https://immerselearn.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "ImmerseLearn", "support_website_url": null, "website_url": "https://immerselearn.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26584973084492331"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1007507011610796"}]}, "baseline_offer": {"id": "1007507011610796"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1777962660, "status": "PUBLISHED", "id": "1007507011610796"}]}, "liveChannel": {"nodes": [{"latest_
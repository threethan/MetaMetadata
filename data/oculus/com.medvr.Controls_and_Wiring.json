tps://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499618064_1497513171740065_7327587827834032018_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eOPK7fpQupEQ7kNvwHCKI4v&_nc_oc=AdpZ0-ygHQBRKw0kWv4Ky1LckSyGJnRicyTm4Aba1HRKictlQEvbg9z3vfzNM4VzjyA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_cgSh9HvhED874LSY1wCiHAtZKSaeY2b63ySUeKcb4-g&oe=6A2EB739"}, {"file_name": "Screenshot 2026-04-22 183002.png", "id": "1332393342127564", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499618938_1332393345460897_8992074743206624923_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mLjSHAdyWeAQ7kNvwHSK1yN&_nc_oc=Adpt_-Q8M7EvqOFyHBQlMw6kevGitnWdsk3HEsFFGycDmHE04X3i80St1cG-sz7qH2s&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8zREKA-w2DfrUiin6zNv4EwIvEITT49JLD_47w_NUWyw&oe=6A2ECE23"}, {"file_name": "Screenshot 2026-04-22 182937.png", "id": "26822660627371867", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499619145_26822660650705198_178178829357942133_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v_Mbxpb0AxMQ7kNvwEOplST&_nc_oc=Adr_dewoy1IklyCdhHUCjrL0x2zO0jnj-JxpnMOxqVwHPsHEQ8NGFe-VHAS2A3AxrmA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_M2PxLQ3m1nYdlqWbmz3pZnsP0gElgdKZw8sEfLlczrw&oe=6A2EA284"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Controls and Wiring", "keywords": ["control", "wiring", "vr", "immerselearn"], "long_description": "Controls and Wiring is an immersive VR training application that enables learners to develop real-world skills in electrical control systems, circuit wiring, and component integration. Through interactive simulations, users practice identifying components, interpreting wiring diagrams, assembling control circuits, and troubleshooting faults in a safe, virtual environment.\n\nThis application is a core component of the Immerse Learn Controls and Wiring micro-credential program, designed to enhance technical proficiency through experiential learning. Learners gain confidence by performing tasks that mirror real industry scenarios, improving both accuracy and decision-making skills.\n\nPlease note: This app is not a standalone product. Access is strictly limited to individuals enrolled in the Immerse Learn Controls and Wiring micro-credential program, where it is used for guided, hands-on training.", "short_description": "Controls and Wiring is a VR training application designed to build practical skills in electrical control systems and wiring. Part of the Immerse Learn Controls and Wiring micro-credential program, this app provides hands-on, immersive learning experiences. Access is exclusively available to learners enrolled in the program."}]}, "developer_name": null, "developer_privacy_policy_url": "https://immerselearn.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "ImmerseLearn", "support_website_url": null, "website_url": "https://immerselearn.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26584973084492331"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499618093_2928074970857357_3137118280681974914_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cVdyB_1PoOcQ7kNvwFDSUQY&_nc_oc=AdpWQiWpEQumKmvdQqlEvKqllR9f5jY6aQVmtxCxv2ak3tepY6n55X3VHohQR0m2sfg&_nc_zt=3&_nc_ht=sco
c_sid=6e7a0a&_nc_ohc=ff08YVD6_H0Q7kNvwFJPj9b&_nc_oc=AdolhFK3V6vUekzG4XQyvMjatDz_PpwLZO7mW76Fs9Rf_v_XptWVu66IUMMIDFEFdjE&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_dBscauLEFSSsyDK2OYYYm17AY_ZNCvt0YtKygzsnDig&oe=6A26CE39"}, {"file_name": "Screenshot 2026-04-22 183002.png", "id": "1332393342127564", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/499618938_1332393345460897_8992074743206624923_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vZPgNl8A71QQ7kNvwFYACNJ&_nc_oc=Adq8Le6QErZCWVZyZSesrnLQ7SB5X3N-Xk74wn7UZCKrVjnlv2Zdkw8JIMvyRr-vreI&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9xncIjrRekltT1M13dCcWOkDqso_gYy91JLFFckAMETA&oe=6A26E523"}, {"file_name": "Screenshot 2026-04-22 182937.png", "id": "26822660627371867", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/499619145_26822660650705198_178178829357942133_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qnYmw8QtMGwQ7kNvwGGVIxr&_nc_oc=AdrnT15GF6WuyzbVPInbrlyh0x7m8QpDxaBBSObXNMsSA6Y9FJu7vgIOULz1AZrQW4s&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_qo_WRCnJ2JQaBlgB4n5VmMVaAYU-LEawz9oRJqXJpJg&oe=6A26B984"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Controls and Wiring", "keywords": ["control", "wiring", "vr", "immerselearn"], "long_description": "Controls and Wiring is an immersive VR training application that enables learners to develop real-world skills in electrical control systems, circuit wiring, and component integration. Through interactive simulations, users practice identifying components, interpreting wiring diagrams, assembling control circuits, and troubleshooting faults in a safe, virtual environment.\n\nThis application is a core component of the Immerse Learn Controls and Wiring micro-credential program, designed to enhance technical proficiency through experiential learning. Learners gain confidence by performing tasks that mirror real industry scenarios, improving both accuracy and decision-making skills.\n\nPlease note: This app is not a standalone product. Access is strictly limited to individuals enrolled in the Immerse Learn Controls and Wiring micro-credential program, where it is used for guided, hands-on training.", "short_description": "Controls and Wiring is a VR training application designed to build practical skills in electrical control systems and wiring. Part of the Immerse Learn Controls and Wiring micro-credential program, this app provides hands-on, immersive learning experiences. Access is exclusively available to learners enrolled in the program."}]}, "developer_name": null, "developer_privacy_policy_url": "https://immerselearn.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "ImmerseLearn", "support_website_url": null, "website_url": "https://immerselearn.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26584973084492331"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/499618093_2928074970857357_3137118280681974914_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Mou-vKsXhTgQ7kNvwG3jVX5&_nc_oc=Adp0PV7JnhFN2fdPq3B2hImVZk6LWQ4rl7aO7t9KBp-zDPVMSRaTG19AXI9Qvll9KFo&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_g0VsdGV0f4f8ImBNctX0gUPWtyg1ZmW1IU5yMROGLXw&oe=6A26C549"}, "is_concept": fal
0.png", "id": "1867008377351259", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/499619594_1867008380684592_6880396884020025782_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MvNkZB1LHF0Q7kNvwHxyAL6&_nc_oc=Adob2h_BzTVcKWdLzI8lulyBaAMkusLYCWc9Jh88iV4aXlodk1NNQ8gBKzyWkwqXBMk&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-QUQtXToEPF2DrogM-0X-NdmVIjQAm_bzWdPsnGQQj5g&oe=6A465990"}, {"file_name": "Screenshot 2026-04-22 182950.png", "id": "1497513168406732", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/499618064_1497513171740065_7327587827834032018_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9IC7v5DmMVUQ7kNvwFelBy5&_nc_oc=AdocwSUxif8VHu4cs-x5ugdGdMws958cpccuHG9reBC984ZPG00IFFKERt0QQEb97cQ&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_dV9AmP4QGHvcTDhwqXLJM4LzViiTEx7ORQr7XDB7uFw&oe=6A467239"}, {"file_name": "Screenshot 2026-04-22 183002.png", "id": "1332393342127564", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/499618938_1332393345460897_8992074743206624923_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jgAFyxDtQKwQ7kNvwHxdax_&_nc_oc=AdocREqCmUY4LqqyGJFGN8Rk04b67e8ssADbb_Fc-Bz-j1UyQiub3n_00y1_UeW4H40&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8FtFHxLVw3Yt5ufWn5wivSKF4Ck03EPMnCtbHXBdnz0A&oe=6A468923"}, {"file_name": "Screenshot 2026-04-22 182937.png", "id": "26822660627371867", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/499619145_26822660650705198_178178829357942133_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OA_3u1k4CNgQ7kNvwGPjCI9&_nc_oc=Ado4tkoaCtJVmHXMRCEeCmImRCwtocsl7aqAtYYlBBgJj2ZeFmkA1tvcfA1IFW_i0DQ&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_6zATtCNUGnH0_dQKR27M_ENAstmsuydVt-gDpP4E9OQ&oe=6A465D84"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Controls and Wiring", "keywords": ["control", "wiring", "vr", "immerselearn"], "long_description": "Controls and Wiring is an immersive VR training application that enables learners to develop real-world skills in electrical control systems, circuit wiring, and component integration. Through interactive simulations, users practice identifying components, interpreting wiring diagrams, assembling control circuits, and troubleshooting faults in a safe, virtual environment.\n\nThis application is a core component of the Immerse Learn Controls and Wiring micro-credential program, designed to enhance technical proficiency through experiential learning. Learners gain confidence by performing tasks that mirror real industry scenarios, improving both accuracy and decision-making skills.\n\nPlease note: This app is not a standalone product. Access is strictly limited to individuals enrolled in the Immerse Learn Controls and Wiring micro-credential program, where it is used for guided, hands-on training.", "short_description": "Controls and Wiring is a VR training application designed to build practical skills in electrical control systems and wiring. Part of the Immerse Learn Controls and Wiring micro-credential program, this app provides hands-on, immersive learning experiences. Access is exclusively available to learners enrolled in the program."}]}, "developer_name": null, "developer_privacy_policy_url": "https://immerselearn.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "ImmerseLearn", "support_website_url": null, "website_url": "https://immerselearn.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"
e.png", "id": "270825414080309", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/38974781_2309872382597944_288226386127093760_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gZ9WnOCATQAQ7kNvwH-GADO&_nc_oc=AdolB6mz_4GRasLvN2sRXQb7cqnQCHB_RF2kTgIzKeQkUaFBNYZ1tJ7KoUJdDMH0LMA&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_KXx6W-aryfwWXphD7A9f1m4yYQ0kGFOXNlcspEmeTiQ&oe=6A22FECF"}, {"file_name": "migrated_image.png", "id": "525906878068770", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/38982485_2242603255789043_690594229679816704_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=efTFIR1e8lQQ7kNvwE5lAKY&_nc_oc=AdpRNER_x9QUGNj9xPyfhGjm10A5YoYKjv76e35ritnTe81i49GdSQIpZTw7DYFU9uU&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_S8cE8CkpBrOEpjddFR4ClsUbm8L6khPTn669uAzYHEw&oe=6A22FC33"}, {"file_name": "migrated_image.png", "id": "1470556203105463", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/38974775_2092071854232078_4781594112908328960_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QnoXawwne_sQ7kNvwG-uQTR&_nc_oc=Adpc7MAA_L4BXvGzA_KPq0UetWqqJIiiqyt2JRRZOCoBx9056ySneM8YEYpE4hZ_WZ0&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_pJ5EbNCUBnTEv_7JjbJuhYNaS3OTVikJkBFDi5zdAhw&oe=6A22F84F"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Adam Savage's Tested VR", "keywords": ["maker", "tested", "build", "video", "DIY"], "long_description": " Inspired by Adam Savage\u2019s Tested One Day Builds, Adam Savage\u2019s Tested VR takes audiences on a journey inside the creative workspaces of incredible makers, bringing their processes to life, from ideation to creation. Featuring an eclectic roster of creators, Adam and the Tested team put viewers inside their workshops for an intimate look at their builds.\n \nAdam Savage\u2019s Tested VR features 38 episodes across five seasons, filmed with 180-degree stereoscopic cameras that allow for an immersive look at the creative process like never before. Bonus footage includes Adam's \"Cave\" workshop tours.\n \nNew episodes include: \nAdam Savage\u2019s Epic Spacesuit Build\nAdam Savage Demonstrates Spaceship Modelmaking\nThe Original USS Enterprise Filming Model\nSpace Shuttle Discovery at Smithsonian National Air and Space Museum\nNASA\u2019s Prototype Apollo A5-L Spacesuit\nProject Mercury\u2019s Friendship 7 Space Capsule\nExtreme Cosplay of Cowbutt Crunchies\n3D-Printed Garments of Designer Sophy Wong\nThe Robot Sidekicks of Maker Jorvon Moss", "short_description": "Adam Savage's Tested takes you inside the workshops and maker spaces of incredible creators to learn their processes and watch their awesome builds."}]}, "developer_name": "WHALEROCK", "developer_privacy_policy_url": "https://www.tested.com/privacy-policy/", "developer_terms_of_service_url": "https://www.tested.com/terms-of-service/", "publisher_name": "Tested.com", "support_website_url": "https://www.tested.com/", "website_url": "https://www.tested.com/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ART_CREATIVITY", "EDUCATIONAL", "EXPERIENCE_360_NON_GAME"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1583037308833076"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/39003265_430803727770656_3759613087276072960_n.png?stp=dst-png_s360x360&_nc_cat=105&ccb=1-7&_
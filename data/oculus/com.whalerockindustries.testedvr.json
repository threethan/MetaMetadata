bkBYirJlweE8JUU22RC0MG4ctzEV9YNWaU&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOQudQC8gTc-3RtZFerh5TFHK3kaxHYv-gAP-RjZcP4Xg&oe=6AE1ED73"}, {"file_name": "migrated_image.png", "id": "841468583035355", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974775_2092071854232078_4781594112908328960_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v26goexjVIAQ7kNvwHQEK5a&_nc_oc=AdqGPA1mbqPKcl09_QNu_UdpPtr5u5JoW_KKl4DtNTnN_ISFaQYSssECKhP2yZoNgCU&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMZqVP-WwjNQfhlrPSNK0ucSvNfgYw0Fpk5L2KN4X5Daw&oe=6AE1E98F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/oJ4Zen", "id": "1340602756091225", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39031492_1340602759424558_9084281221780865024_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tHT_YZcLhEoQ7kNvwFzo0f9&_nc_oc=AdpkRcgXUVR2Ua-AEErsaSXHrIFviO0bop3nPi_49dHF6pYe7Ozr7m2b8c0-xzXtU6o&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMZ7ntOEDgiUbJLqqDfkFCfzR7gSWTSo9ghhUGCiH0MzA&oe=6AE1FEC4"}, "display_name": "Adam Savage's Tested VR", "keywords": ["maker", "tested", "build", "video", "DIY"], "long_description": "Inspired by Adam Savage\u2019s Tested One Day Builds, Adam Savage\u2019s Tested VR takes audiences on a journey inside the creative workspaces of incredible makers, bringing their processes to life, from ideation to creation. Featuring an eclectic roster of creators including a Broadway and TV puppeteer and a cosplay animatronic wings designer, Adam and the Tested team put viewers inside their workshops for an intimate look at their builds.\n \nAdam Savage\u2019s Tested VR features 8 episodes filmed with 180-degree stereoscopic cameras that allow for an immersive look at the creative process like never before. Bonus footage includes Adam's \"Cave\" workshop tours.\n \nMakers include:\n- Adam Savage, Maker/TV Personality\n- Brett Foxwell, Machinist/Stop-Motion Animator\n- Rick Lyon, Puppeteer & Puppet Designer\n- Melissa Ng, Gothic Armor Designer\n- Andrew Freeman, Creature Mask Sculptor\n- Griffon Ramsey, Chainsaw Wood Sculptor\n- Alexis Noriega, Costume Wing Designer\n- Ryan Nagata, Spacesuit Replica Fabricator", "short_description": "Adam Savage's Tested takes you inside the workshops and maker spaces of incredible creators to learn their processes and watch their awesome builds."}]}, "developer_name": "Whalerock / Lucky Hammers", "developer_privacy_policy_url": null, "developer_terms_of_service_url": "https://www.tested.com/terms-of-service/", "publisher_name": "TESTED", "support_website_url": "https://www.tested.com/", "website_url": "https://www.tested.com/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EXPERIENCE_360_NON_GAME", "ART_CREATIVITY", "EDUCATIONAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "627768864970248"}}]}, "scheduled_offers": {"count": 0, "nodes": []}, "baseline_offer": null, "is_approved": true, "firstOffer": {"nodes": []}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "8455884464454093", "version": "1.5.2"}, "id": "1033129880215117", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application"
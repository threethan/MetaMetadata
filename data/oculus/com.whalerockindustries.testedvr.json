uluscdn.com/v/t64.5771-25/38974510_1321481574684434_1642772841227091968_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EK3JscU1P28Q7kNvwGkH1Bm&_nc_oc=AdoGkVwRK7tk9sfMKQRnRlxcFFucZLKKeITWNGUqt18zgcdznlc8Yi-TrhK2gRJoMx8&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQODxzJ6UjIQIUQfAcVQuGCkvEiTYy_LiGQUqIh4e9a1FA&oe=6AC79E16"}, {"file_name": "migrated_image.png", "id": "1096363547394262", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38984460_2636725306370282_7687773949811228672_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=X95-Ag8ivO8Q7kNvwG2JRfo&_nc_oc=AdqwTsa4G-93R-EgflpwRuOxbc-mnvmfapQjQe1tYkmplp5FVjLx7ZXAT7SacGiRRhI&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMekp9WDMsdosKqX1xoUmnJTQ6DlT2SlF5F93tnICI3Ew&oe=6AC7AC96"}, {"file_name": "migrated_image.png", "id": "2245642979071585", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38982554_332139981021732_8693572225866924032_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VPIwS-BXbpMQ7kNvwFuocFG&_nc_oc=Adp4dQSuuSrY0yO4HP8HHuRJqKdUCtxNOx93taUqB_KqD70J3tupz8v7uj2IvjkJ0v0&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPNkDxTEoXHrMMLUrpkTtcR9sW4n7yiesZ9QzkAifU-Zg&oe=6AC7BCE6"}, {"file_name": "migrated_image.png", "id": "233088241071805", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38974447_412082816097245_4342191698370101248_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e4B6KEEu-xQQ7kNvwHDoGzn&_nc_oc=Ado0mb2e-ZU8_fvqJ3fgQM7c6YjkUUr2KwCKriH2Q7Y8_ZMTXTjSoqNZRX8iT6Jf0-w&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMjRUlvx7qo7J4wdTskj2TkvXQvopwEvc6wxpygK9w2Rg&oe=6AC7ABDE"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Adam Savage's Tested VR", "keywords": ["maker", "tested", "build", "video", "DIY"], "long_description": "Inspired by Adam Savage\u2019s Tested One Day Builds, Adam Savage\u2019s Tested VR takes audiences on a journey inside the creative workspaces of incredible makers, bringing their processes to life, from ideation to creation. Featuring an eclectic roster of creators, Adam and the Tested team put viewers inside their workshops for an intimate look at their builds.\n \nAdam Savage\u2019s Tested VR features 12 episodes across two seasons, filmed with 180-degree stereoscopic cameras that allow for an immersive look at the creative process like never before. Bonus footage includes Adam's \"Cave\" workshop tours.\n \nMakers include:\n- Adam Savage, Maker/TV Personality\n- Rick Lyon, Puppeteer & Puppet Designer\n- Marc DeVidts, Robot Maker and Battlebots Competitor\n- Melissa Ng, Gothic Armor Designer\n- Andrew Freeman, Creature Mask Sculptor\n- Griffon Ramsey, Chainsaw Wood Sculptor\n- Alexis Noriega, Costume Wing Designer\n- Ryan Nagata, Spacesuit Replica Fabricator", "short_description": "Adam Savage's Tested takes you inside the workshops and maker spaces of incredible creators to learn their processes and watch their awesome builds."}]}, "developer_name": "WHALEROCK", "developer_privacy_policy_url": "https://www.tested.com/privacy-policy/", "developer_terms_of_service_url": "https://www.tested.com/terms-of-service/", "publisher_name": "Tested.com", "support_website_url": "https://www.tested.com/", "website_url": "https://www.tested.com/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ART_CREATIVITY", "EDUCATIONAL", "EXPERIENCE_360_NON_GAME"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "302030535239208"}, "review_messages": []}]}, "
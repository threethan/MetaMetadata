6e7a0a&_nc_ohc=36yLy3qhIKEQ7kNvwEkx14J&_nc_oc=Adrn3rNN85I3bXfo82OikiU2W1_bGENg0t0VJSuK0Ypej_4abX-b2Sybht8DExQl578&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ5Kv8mcJxdbDdo-7VBwg_k5sr3CabvFWqKF4X0E5-Tpw&oe=6AA2D2E6"}, {"file_name": "migrated_image.png", "id": "519878812273346", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974447_412082816097245_4342191698370101248_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T2Ih-qhrwiAQ7kNvwGRa-Kr&_nc_oc=AdpcT9Ei2Y96gnclxyZOvdfV7SPnKvdn4S1wowyDrvRSAvEdQ0N40ok8lvI35xMzCLg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLF_tU2TSwlKFGvD9Nkm_h9sNS5sxCSL4kVZXtpJ-qSjA&oe=6AA2C1DE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/ixrrNz", "id": "331911027684660", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974550_331911031017993_2786074697127690240_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Gtm-MuMbzpUQ7kNvwFV6_2V&_nc_oc=AdqhQnHgv66O-maEkVDmADJuK7PTeDeY6mtpXnWSnGZ8r16buxW_lRVGQR58Dr6S3yY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKUrftlVfUueWjNZrAZNdYBsTqJlYLQPkE_dSS2hrvpQA&oe=6AA2BADB"}, "display_name": "Adam Savage's Tested VR", "keywords": ["maker", "tested", "build", "video", "DIY"], "long_description": "Inspired by Adam Savage\u2019s Tested One Day Builds, Adam Savage\u2019s Tested VR takes audiences on a journey inside the creative workspaces of incredible makers, bringing their processes to life, from ideation to creation. Featuring an eclectic roster of creators including a Broadway and TV puppeteer and a cosplay animatronic wings designer, Adam and the Tested team put viewers inside their workshops for an intimate look at their builds.\n \nAdam Savage\u2019s Tested VR features 8 episodes filmed with 180-degree stereoscopic cameras that allow for an immersive look at the creative process like never before. Bonus footage includes Adam's \"Cave\" workshop tours.\n \nMakers include:\n- Adam Savage, Maker/TV Personality\n- Brett Foxwell, Machinist/Stop-Motion Animator\n- Rick Lyon, Puppeteer & Puppet Designer\n- Melissa Ng, Gothic Armor Designer\n- Andrew Freeman, Creature Mask Sculptor\n- Griffon Ramsey, Chainsaw Wood Sculptor\n- Alexis Noriega, Costume Wing Designer\n- Ryan Nagata, Spacesuit Replica Fabricator", "short_description": "Adam Savage's Tested takes you inside the workshops and maker spaces of incredible creators to learn their processes and watch their awesome builds."}]}, "developer_name": "Whalerock / Lucky Hammers", "developer_privacy_policy_url": null, "developer_terms_of_service_url": "https://www.tested.com/terms-of-service/", "publisher_name": "TESTED", "support_website_url": "https://www.tested.com/", "website_url": "https://www.tested.com/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["EXPERIENCE_360_NON_GAME", "ART_CREATIVITY", "EDUCATIONAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1116946285809583"}}]}, "scheduled_offers": {"count": 0, "nodes": []}, "baseline_offer": null, "is_approved": true, "firstOffer": {"nodes": []}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "4899160023492379", "version": "1.2.9"}, "id": "304955570379624", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "2424698784271861", "is_c
6e7a0a&_nc_ohc=VPIwS-BXbpMQ7kNvwFuocFG&_nc_oc=Adp4dQSuuSrY0yO4HP8HHuRJqKdUCtxNOx93taUqB_KqD70J3tupz8v7uj2IvjkJ0v0&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPNkDxTEoXHrMMLUrpkTtcR9sW4n7yiesZ9QzkAifU-Zg&oe=6AC7BCE6"}, {"file_name": "migrated_image.png", "id": "519878812273346", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38974447_412082816097245_4342191698370101248_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e4B6KEEu-xQQ7kNvwHDoGzn&_nc_oc=Ado0mb2e-ZU8_fvqJ3fgQM7c6YjkUUr2KwCKriH2Q7Y8_ZMTXTjSoqNZRX8iT6Jf0-w&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMjRUlvx7qo7J4wdTskj2TkvXQvopwEvc6wxpygK9w2Rg&oe=6AC7ABDE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/ixrrNz", "id": "331911027684660", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38974550_331911031017993_2786074697127690240_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KTaN7dPIqIwQ7kNvwG5xizd&_nc_oc=Adrv13VKHvMUp2Hy0qLoztbQpiG0Id03sygxu-u37102axPiKvym_nxLrfTvWe4iX8E&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMgilfbSFRunXFEaItKmydFl7pu830iDCI_XPoooJ1u3g&oe=6AC7A4DB"}, "display_name": "Adam Savage's Tested VR", "keywords": ["maker", "tested", "build", "video", "DIY"], "long_description": "Inspired by Adam Savage\u2019s Tested One Day Builds, Adam Savage\u2019s Tested VR takes audiences on a journey inside the creative workspaces of incredible makers, bringing their processes to life, from ideation to creation. Featuring an eclectic roster of creators including a Broadway and TV puppeteer and a cosplay animatronic wings designer, Adam and the Tested team put viewers inside their workshops for an intimate look at their builds.\n \nAdam Savage\u2019s Tested VR features 8 episodes filmed with 180-degree stereoscopic cameras that allow for an immersive look at the creative process like never before. Bonus footage includes Adam's \"Cave\" workshop tours.\n \nMakers include:\n- Adam Savage, Maker/TV Personality\n- Brett Foxwell, Machinist/Stop-Motion Animator\n- Rick Lyon, Puppeteer & Puppet Designer\n- Melissa Ng, Gothic Armor Designer\n- Andrew Freeman, Creature Mask Sculptor\n- Griffon Ramsey, Chainsaw Wood Sculptor\n- Alexis Noriega, Costume Wing Designer\n- Ryan Nagata, Spacesuit Replica Fabricator", "short_description": "Adam Savage's Tested takes you inside the workshops and maker spaces of incredible creators to learn their processes and watch their awesome builds."}]}, "developer_name": "Whalerock / Lucky Hammers", "developer_privacy_policy_url": null, "developer_terms_of_service_url": "https://www.tested.com/terms-of-service/", "publisher_name": "TESTED", "support_website_url": "https://www.tested.com/", "website_url": "https://www.tested.com/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["EXPERIENCE_360_NON_GAME", "ART_CREATIVITY", "EDUCATIONAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1116946285809583"}}]}, "scheduled_offers": {"count": 0, "nodes": []}, "baseline_offer": null, "is_approved": true, "firstOffer": {"nodes": []}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "4899160023492379", "version": "1.2.9"}, "id": "304955570379624", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "2424698784271861", "is_c
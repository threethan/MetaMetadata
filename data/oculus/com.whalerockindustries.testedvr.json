=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTqEsuYVsO9ih8QqI3lf41UK-ZPGc1RFmzAFRHhzWgtkg&oe=6B00729F"}, {"file_name": "migrated_image.png", "id": "1505189239655888", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974510_1321481574684434_1642772841227091968_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_lC0B0P_8NUQ7kNvwFHkw6H&_nc_oc=AdrFpH4MAGnMOG9VNTMkiJMTMg6IFX4wO2jiKLjo3rbmgCFLQg9j8L2SEC0UOE5bzTA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQCtkF2VtWEdm8eoshgIHjJSDLbas2wNjDzShXBiRixTw&oe=6B0086D6"}, {"file_name": "migrated_image.png", "id": "1096363547394262", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38984460_2636725306370282_7687773949811228672_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ceWjERYeLgQQ7kNvwHDhkM1&_nc_oc=AdprSY0mscWpAd2O9pudqVx_hc853-XSBMWRsAAFlGvYXPQiw1tkZTkul5xKJjm2ZuY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTM_t00qDcFJvq75ZQBq8KmQhL3T0nX6kVwRWWnZ92Qqg&oe=6B005D16"}, {"file_name": "migrated_image.png", "id": "2245642979071585", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982554_332139981021732_8693572225866924032_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OaAvcUOZlhMQ7kNvwHsqe2k&_nc_oc=AdoJ-pIa-4wt51-m5r64rNAUHpTLd56Z6Ai648FyHJFtLpRuJVkMGDlP3G4h_j1WbRk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS57_JyieHVo-tGempzeCkwe_vFgH9WtVk69dNq3b9mOg&oe=6B006D66"}, {"file_name": "migrated_image.png", "id": "233088241071805", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974447_412082816097245_4342191698370101248_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iRWc8Mft4qMQ7kNvwGcGiSP&_nc_oc=Adpj0VEzHGcSMVOeaeKrqDbkQ5sIVL7UtyKBOKsMCc6qj8NAuURpkmTKPWHU2kraybo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQjBl_zgxk_krjYZ2PW2qIJX530SBSrbOjaSGWPqiHYnw&oe=6B005C5E"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Adam Savage's Tested VR", "keywords": ["maker", "tested", "build", "video", "DIY"], "long_description": "Inspired by Adam Savage\u2019s Tested One Day Builds, Adam Savage\u2019s Tested VR takes audiences on a journey inside the creative workspaces of incredible makers, bringing their processes to life, from ideation to creation. Featuring an eclectic roster of creators, Adam and the Tested team put viewers inside their workshops for an intimate look at their builds.\n \nAdam Savage\u2019s Tested VR features 12 episodes across two seasons, filmed with 180-degree stereoscopic cameras that allow for an immersive look at the creative process like never before. Bonus footage includes Adam's \"Cave\" workshop tours.\n \nMakers include:\n- Adam Savage, Maker/TV Personality\n- Rick Lyon, Puppeteer & Puppet Designer\n- Marc DeVidts, Robot Maker and Battlebots Competitor\n- Melissa Ng, Gothic Armor Designer\n- Andrew Freeman, Creature Mask Sculptor\n- Griffon Ramsey, Chainsaw Wood Sculptor\n- Alexis Noriega, Costume Wing Designer\n- Ryan Nagata, Spacesuit Replica Fabricator", "short_description": "Adam Savage's Tested takes you inside the workshops and maker spaces of incredible creators to learn their processes and watch their awesome builds."}]}, "developer_name": "WHALEROCK", "developer_privacy_policy_url": "https://www.tested.com/privacy-policy/", "developer_terms_of_service_url": "https://www.tested.com/terms-of-service/", "publisher_name": "Tested.com", "support_website_url": "https://www.tested.com/", "website_url": "https://www.tested.com/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ART_CREATIVITY", "EDUCATIONAL", "EXPERIENCE_360_NON_GAME"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphics": nul
uluscdn.com/v/t64.5771-25/38974510_1321481574684434_1642772841227091968_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oYkTH9hmpd8Q7kNvwF5IMRW&_nc_oc=AdqIolymVO4mVYvVCeZHONI5UobcGz5UNTJWuWAQstoKTlgbj7n_7bDQO9MBTgXH0xo&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Afyvqqx8249Hm01trnvTvq_7nFOQhHj548r9d11zR_5mCg&oe=69CBCF96"}, {"file_name": "migrated_image.png", "id": "1096363547394262", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38984460_2636725306370282_7687773949811228672_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wWXqN75RsXUQ7kNvwFpJt0K&_nc_oc=AdrhEZUncqbzNXn95NlfQpmltf9oZIWMMshuv02cqqp_frEGCVz4Fn73wWYm3Gitoz4&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzVYuG22tw1iZ7JocFvq74OxxDrIk8WvbVNECTiS1iXFw&oe=69CBDE16"}, {"file_name": "migrated_image.png", "id": "2245642979071585", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38982554_332139981021732_8693572225866924032_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1nymDtTjJqgQ7kNvwFpWnBl&_nc_oc=Adr7T4si3Rloa6M8UzInTQr4e5QvgbJh0kMexpUfmN-clqrKF75pJYEvbFkkm-Lp7to&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwUGAim7tzV2dah8GBp0nHmIUrj5l8T9aTUWVGbTtujww&oe=69CBB626"}, {"file_name": "migrated_image.png", "id": "233088241071805", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974447_412082816097245_4342191698370101248_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QWq06wAJTdcQ7kNvwFeYBky&_nc_oc=AdpdJbZUYFW5og_m9_yv5H8AZ9OcP6kRq-YlLusdXpIz1JpoiKsCeBvLSCmyub1y9vE&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxgUGPAadj5XNsY5h_cZ9Oa349bpj3HqCtW0BSbYPtrZQ&oe=69CBDD5E"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Adam Savage's Tested VR", "keywords": ["maker", "tested", "build", "video", "DIY"], "long_description": "Inspired by Adam Savage\u2019s Tested One Day Builds, Adam Savage\u2019s Tested VR takes audiences on a journey inside the creative workspaces of incredible makers, bringing their processes to life, from ideation to creation. Featuring an eclectic roster of creators, Adam and the Tested team put viewers inside their workshops for an intimate look at their builds.\n \nAdam Savage\u2019s Tested VR features 12 episodes across two seasons, filmed with 180-degree stereoscopic cameras that allow for an immersive look at the creative process like never before. Bonus footage includes Adam's \"Cave\" workshop tours.\n \nMakers include:\n- Adam Savage, Maker/TV Personality\n- Rick Lyon, Puppeteer & Puppet Designer\n- Marc DeVidts, Robot Maker and Battlebots Competitor\n- Melissa Ng, Gothic Armor Designer\n- Andrew Freeman, Creature Mask Sculptor\n- Griffon Ramsey, Chainsaw Wood Sculptor\n- Alexis Noriega, Costume Wing Designer\n- Ryan Nagata, Spacesuit Replica Fabricator", "short_description": "Adam Savage's Tested takes you inside the workshops and maker spaces of incredible creators to learn their processes and watch their awesome builds."}]}, "developer_name": "WHALEROCK", "developer_privacy_policy_url": "https://www.tested.com/privacy-policy/", "developer_terms_of_service_url": "https://www.tested.com/terms-of-service/", "publisher_name": "Tested.com", "support_website_url": "https://www.tested.com/", "website_url": "https://www.tested.com/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ART_CREATIVITY", "EDUCATIONAL", "EXPERIENCE_360_NON_GAME"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "302030535239208"}, "review_messages": []}]}, "
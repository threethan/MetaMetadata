=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTZi_VzdPqG9r722EpBHedOnICNPPJPxTI4dTueYKMacQ&oe=6B09AD1F"}, {"file_name": "migrated_image.png", "id": "1505189239655888", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974510_1321481574684434_1642772841227091968_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cYJAN4ntS4sQ7kNvwGIFi20&_nc_oc=AdofYF2-4L7TYOzNF_dBNHtUERYOcLD242ir48z3eIg7IRbqUqh22VjuoNIiIJq8Bt4&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTl90vlgOOlMjd2srw6C19iRvngOvCeAWWODU6kboAnVg&oe=6B09C156"}, {"file_name": "migrated_image.png", "id": "1096363547394262", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38984460_2636725306370282_7687773949811228672_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jEKvIxoqcyUQ7kNvwFXlb_u&_nc_oc=Adryn1HLSvCpD3GOCBvJy1TnrA8WqU3Sn83sm_hw-wamNwnHOFiLvqiqrnoPTghDwhk&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRsWaq-DM7jEqqjYirCYrJD81X-BvlhXfkvxmRU3HHnHA&oe=6B09CFD6"}, {"file_name": "migrated_image.png", "id": "2245642979071585", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982554_332139981021732_8693572225866924032_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OW8h8pbsd7gQ7kNvwH44TOO&_nc_oc=AdpdlxJuYluoMOS3F1QcakrT6avyHk1mscXj7ZLWMBw13QmwtK-2iz4E9_Zmf3h315I&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSEZQGvxuiloZbyungvoC7FBqXVcks84x-K6YL3RC8Mqw&oe=6B09A7E6"}, {"file_name": "migrated_image.png", "id": "233088241071805", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974447_412082816097245_4342191698370101248_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9yuNjX7BbikQ7kNvwF_UXAz&_nc_oc=AdrUxfzpLSD6uudTBKMcIvmryQ4a-k9nZlpWk2JN2UwwWRWWqaXbWKbeDZlozFtbX1c&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR5yGxxZLY9pqaO1d_M7Vjy08nOdgfU6b-66Ha-FiW8vQ&oe=6B09CF1E"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Adam Savage's Tested VR", "keywords": ["maker", "tested", "build", "video", "DIY"], "long_description": "Inspired by Adam Savage\u2019s Tested One Day Builds, Adam Savage\u2019s Tested VR takes audiences on a journey inside the creative workspaces of incredible makers, bringing their processes to life, from ideation to creation. Featuring an eclectic roster of creators, Adam and the Tested team put viewers inside their workshops for an intimate look at their builds.\n \nAdam Savage\u2019s Tested VR features 12 episodes across two seasons, filmed with 180-degree stereoscopic cameras that allow for an immersive look at the creative process like never before. Bonus footage includes Adam's \"Cave\" workshop tours.\n \nMakers include:\n- Adam Savage, Maker/TV Personality\n- Rick Lyon, Puppeteer & Puppet Designer\n- Marc DeVidts, Robot Maker and Battlebots Competitor\n- Melissa Ng, Gothic Armor Designer\n- Andrew Freeman, Creature Mask Sculptor\n- Griffon Ramsey, Chainsaw Wood Sculptor\n- Alexis Noriega, Costume Wing Designer\n- Ryan Nagata, Spacesuit Replica Fabricator", "short_description": "Adam Savage's Tested takes you inside the workshops and maker spaces of incredible creators to learn their processes and watch their awesome builds."}]}, "developer_name": "WHALEROCK", "developer_privacy_policy_url": "https://www.tested.com/privacy-policy/", "developer_terms_of_service_url": "https://www.tested.com/terms-of-service/", "publisher_name": "Tested.com", "support_website_url": "https://www.tested.com/", "website_url": "https://www.tested.com/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ART_CREATIVITY", "EDUCATIONAL", "EXPERIENCE_360_NON_GAME"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphics": nul
ve process like never before. Bonus footage includes Adam's \"Cave\" workshop tours.\n \nNew episodes include: \nAdam Savage\u2019s Epic Spacesuit Build\nAdam Savage Demonstrates Spaceship Modelmaking\nThe Original USS Enterprise Filming Model\nSpace Shuttle Discovery at Smithsonian National Air and Space Museum\nNASA\u2019s Prototype Apollo A5-L Spacesuit\nProject Mercury\u2019s Friendship 7 Space Capsule\nExtreme Cosplay of Cowbutt Crunchies\n3D-Printed Garments of Designer Sophy Wong\nThe Robot Sidekicks of Maker Jorvon Moss", "short_description": "Adam Savage's Tested takes you inside the workshops and maker spaces of incredible creators to learn their processes and watch their awesome builds."}]}, "developer_name": "WHALEROCK", "developer_privacy_policy_url": "https://www.tested.com/privacy-policy/", "developer_terms_of_service_url": "https://www.tested.com/terms-of-service/", "publisher_name": "Tested.com", "support_website_url": "https://www.tested.com/", "website_url": "https://www.tested.com/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ART_CREATIVITY", "EDUCATIONAL", "EXPERIENCE_360_NON_GAME"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1583037308833076"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39003265_430803727770656_3759613087276072960_n.png?stp=dst-png_s360x360&_nc_cat=105&ccb=1-7&_nc_sid=6e
=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQbv_vmZO9jHrUWij9eTwUWrcuRIe-2WTz-XqlviLA0gQ&oe=6B085B9F"}, {"file_name": "migrated_image.png", "id": "1505189239655888", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974510_1321481574684434_1642772841227091968_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cYJAN4ntS4sQ7kNvwElqtd8&_nc_oc=Ado9o6oSt0CZOqXpsKSII836-mMqIkITEIzNH9CQXjZZq77GuLHz9luMeNd1u03ETf8&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQRzGZelcwjLnYi-mloUJ8QP5XYT8dB01aTPUnnJJfwMA&oe=6B086FD6"}, {"file_name": "migrated_image.png", "id": "1096363547394262", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38984460_2636725306370282_7687773949811228672_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jEKvIxoqcyUQ7kNvwERDyno&_nc_oc=AdpGvR3PT7k59DnZXtWmREu2TFmH_N8vpeSo-1kTuMXrBLqtBmnWQngcXeL-0oserqg&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQbp02h3H8H2h3HGuh5KHRW9jWeyixDcQRim7kRZAT5SQ&oe=6B084616"}, {"file_name": "migrated_image.png", "id": "2245642979071585", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/38982554_332139981021732_8693572225866924032_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xXeXci4SNU0Q7kNvwFxbwhu&_nc_oc=AdqIx8eUgofKytl-Tv1lBha4LqEX9sLAejVuNHwM-tep4sRqc0mmSIhP4bE9fqpAkwk&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSd4LVl-B6cLfPunS0lkcl_-rLQRIcmC4-1IELh2BnSRA&oe=6B085666"}, {"file_name": "migrated_image.png", "id": "233088241071805", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974447_412082816097245_4342191698370101248_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9yuNjX7BbikQ7kNvwGZfZAB&_nc_oc=Ado_M2tUN7pl3c1QXbomYHd-UBHue4rb2RmL7dm4fqNoHZx2FifOAys5fW8sj1PBA2E&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRkWM07aXmZTlLVTHfPnq8tMusxD6mgcRx5ca7PJjhifQ&oe=6B08455E"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Adam Savage's Tested VR", "keywords": ["maker", "tested", "build", "video", "DIY"], "long_description": "Inspired by Adam Savage\u2019s Tested One Day Builds, Adam Savage\u2019s Tested VR takes audiences on a journey inside the creative workspaces of incredible makers, bringing their processes to life, from ideation to creation. Featuring an eclectic roster of creators, Adam and the Tested team put viewers inside their workshops for an intimate look at their builds.\n \nAdam Savage\u2019s Tested VR features 12 episodes across two seasons, filmed with 180-degree stereoscopic cameras that allow for an immersive look at the creative process like never before. Bonus footage includes Adam's \"Cave\" workshop tours.\n \nMakers include:\n- Adam Savage, Maker/TV Personality\n- Rick Lyon, Puppeteer & Puppet Designer\n- Marc DeVidts, Robot Maker and Battlebots Competitor\n- Melissa Ng, Gothic Armor Designer\n- Andrew Freeman, Creature Mask Sculptor\n- Griffon Ramsey, Chainsaw Wood Sculptor\n- Alexis Noriega, Costume Wing Designer\n- Ryan Nagata, Spacesuit Replica Fabricator", "short_description": "Adam Savage's Tested takes you inside the workshops and maker spaces of incredible creators to learn their processes and watch their awesome builds."}]}, "developer_name": "WHALEROCK", "developer_privacy_policy_url": "https://www.tested.com/privacy-policy/", "developer_terms_of_service_url": "https://www.tested.com/terms-of-service/", "publisher_name": "Tested.com", "support_website_url": "https://www.tested.com/", "website_url": "https://www.tested.com/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ART_CREATIVITY", "EDUCATIONAL", "EXPERIENCE_360_NON_GAME"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphics": nul
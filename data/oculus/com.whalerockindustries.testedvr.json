uluscdn.com/v/t64.5771-25/38974510_1321481574684434_1642772841227091968_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GfQizCL0amwQ7kNvwFe3RNX&_nc_oc=AdpF2g81AFjUnJ23VTiHUI81bvq1b_Pe3EeKYKlyKIP7snkZDIlCn_otKwny4fjHKxY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIapitsHPz5He5IqMi26zm5eyWBKxF_1R78cod_oyn79w&oe=6A9C1C96"}, {"file_name": "migrated_image.png", "id": "1096363547394262", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38984460_2636725306370282_7687773949811228672_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XbKJI53XaC8Q7kNvwFrKBfl&_nc_oc=AdoKCrV52WRCO93W1mw9YyY0CjkGiDE4nxN-mnqY7ve56yJtA5YA0oTNNtNOMpZ0wM8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKyafORstlDlWPW3oElCcs4rJGTO0vzd5dlpKzZC2ahNg&oe=6A9C2B16"}, {"file_name": "migrated_image.png", "id": "2245642979071585", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982554_332139981021732_8693572225866924032_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LZI5RWA910gQ7kNvwFj5C2S&_nc_oc=AdqpLxDT7ugnmHsob1gh9alaK4CHkYSGYvm3WGlAU3g4hI--tEVMV3ekjM_qHgJM4NU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLeq1MAATR_jWDLX-jPjC-D6G_snLvC0DmCsHakRaRuMg&oe=6A9C3B66"}, {"file_name": "migrated_image.png", "id": "233088241071805", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974447_412082816097245_4342191698370101248_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3LoAWLr9oUUQ7kNvwHlcyVU&_nc_oc=AdrzDgRByUVX5eT4Z3a4CTWwsSmJxrMlLK76dqv87zg3hz3SkbGIW1AB7iS7hRw7NIs&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKQ2QoetetUUtsovrUTVsF0Gfdc6OWndY5OlduVklssCg&oe=6A9C2A5E"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Adam Savage's Tested VR", "keywords": ["maker", "tested", "build", "video", "DIY"], "long_description": "Inspired by Adam Savage\u2019s Tested One Day Builds, Adam Savage\u2019s Tested VR takes audiences on a journey inside the creative workspaces of incredible makers, bringing their processes to life, from ideation to creation. Featuring an eclectic roster of creators, Adam and the Tested team put viewers inside their workshops for an intimate look at their builds.\n \nAdam Savage\u2019s Tested VR features 12 episodes across two seasons, filmed with 180-degree stereoscopic cameras that allow for an immersive look at the creative process like never before. Bonus footage includes Adam's \"Cave\" workshop tours.\n \nMakers include:\n- Adam Savage, Maker/TV Personality\n- Rick Lyon, Puppeteer & Puppet Designer\n- Marc DeVidts, Robot Maker and Battlebots Competitor\n- Melissa Ng, Gothic Armor Designer\n- Andrew Freeman, Creature Mask Sculptor\n- Griffon Ramsey, Chainsaw Wood Sculptor\n- Alexis Noriega, Costume Wing Designer\n- Ryan Nagata, Spacesuit Replica Fabricator", "short_description": "Adam Savage's Tested takes you inside the workshops and maker spaces of incredible creators to learn their processes and watch their awesome builds."}]}, "developer_name": "WHALEROCK", "developer_privacy_policy_url": "https://www.tested.com/privacy-policy/", "developer_terms_of_service_url": "https://www.tested.com/terms-of-service/", "publisher_name": "Tested.com", "support_website_url": "https://www.tested.com/", "website_url": "https://www.tested.com/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ART_CREATIVITY", "EDUCATIONAL", "EXPERIENCE_360_NON_GAME"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "302030535239208"}, "review_messages": []}]}, "
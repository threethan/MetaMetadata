b=1-7&_nc_sid=6e7a0a&_nc_ohc=KqBfx1NBp6cQ7kNvwEqPVKx&_nc_oc=Adp_r0b3xnzNKuT1bYk6-rl3fR9qOn0IFIjMdkayFHNgwrejDWBEg1-BC0y3CLtGhVw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzR-aZqNmK4EspuaT4w_OUL7kBRDVF2ffQpRsg6Sr_rnw&oe=69CD091B"}, {"file_name": "calc.png", "id": "4337294459926194", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491820923_4337294466592860_327271182012064756_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FtBy2ZM12cMQ7kNvwFf4FEM&_nc_oc=Adp9uSLC2axFTjpa7uvKimDOtz9xbI4V8_-Ep1nmfhb16Fg68QfAZezKZJB0CxsaBHU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afzq7wf87B1JTP3MmLZLI1Yqh8rvNGmRvVYOJb2bKRJT4Q&oe=69CD0585"}, {"file_name": "impress.png", "id": "2218281078679057", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491823940_2218281082012390_5677592822942865259_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=57IGpvlmwBwQ7kNvwESGzFD&_nc_oc=AdpEE4242O-XkT-CpCTG-9L6Ah-YYNOmj-Sb87Qp_n5SoL6V4oxaHvVmq6pqn4j7JN0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxH3kP0Vx_1jZkxvVtwbtl5DOo-K1-WTNLV6SHkp4QNfg&oe=69CD0B5F"}, {"file_name": "impress2.png", "id": "1437506904610073", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491821796_1437506907943406_9080353388739888128_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hHZhXoZLh1gQ7kNvwEd-fml&_nc_oc=AdolOuBoRRKjTrAA78r2rmtL51C-PC3EXUGhQEmKeximFGzjRA6XrlFW0ZGLzwbqB8g&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afyr_9uWrN_AYdQWI0QmqU3lQN-2gSq4WMqyr--lmZKj9g&oe=69CD1CFC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_image_libreoffice_viewer_trailer_horizon_os.png", "id": "1986570352201618", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491825497_1986570355534951_6870447438066339222_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S8fM_lNEi7wQ7kNvwHSv-FV&_nc_oc=Adp58CeKaQtUaYkgSjzhFOa62XK00qQ23nrjOD-6cH3uMTBecQL6yH-ndSJ-QB67xU8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyGgyhNbH-gWKXe6TFvoB4DA43jwtfcPTaREa9MHShHrQ&oe=69CCFEAD"}, "display_name": "LibreOffice Viewer", "keywords": [], "long_description": "You may know LibreOffice from the desktop - the free and open source office suite (successor to OpenOffice) with over 200 million users worldwide. It's secure and respects your privacy, not sharing your documents with anyone else. It's also available Meta Horizon OS in a simplified form, to view documents in these formats:\n\n\u2022 Open Document Format (odt, ods, odp, odg)\n\u2022 Microsoft Office 2007\u2013365 (docx, xlsx and pptx)\n\u2022 Microsoft Office 97\u20132003 (doc, xls and ppt)\n\nThe software is open source and made by a worldwide community, so if you'd like to improve the experimental editing support, please join us!\n\nFeedback and bug reports are very welcome, to help developers improve the quality of the application. You can report bugs and attach files here: https://bugs.documentfoundation.org\n\nLibreOffice Viewer is built on the same technology as LibreOffice desktop for Windows, macOS and Linux. LibreOffice Viewer is released under the Mozilla Public License v2. The software is backed by a dynamic community, represented by The Document Foundation, a not for profit entity based in Germany.\n\nLibreOffice was based on OpenOffice.org (commonly known as OpenOffice). Full credits: https://www.libreoffice.org/about-us/credits", "short_description": "Quickly and securely view OpenDocument and Microsoft Office files."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.libreoffice.org/about-us/privacy/libreoffice-viewer", "developer_terms_of_service_url": null, "publisher_name": "The Document Foundation", "support_website_url": null, "website_url": "https://www.libreoffice.org/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "106358491
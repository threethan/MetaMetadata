GvONVWP_7BI6CyOS49E70W8sVgHVQhxZFZc0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afsiq6qEw4-T47_bKoeWpk7yUHJk8qhP6oWyZe6O8S-vQA&oe=69A2D91B"}, {"file_name": "calc.png", "id": "4337294459926194", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491820923_4337294466592860_327271182012064756_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rrdNDLdU9SIQ7kNvwG47d0N&_nc_oc=AdkkFNuKCfCgcBADPDnMgjh2Vm8VmM2GNVQFgp5sD24WIeNyabNOvfjSfSeLCAQsWkQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfuOE-nA02F0LZMMdUpJxXETxn8rPZAlscPG5ZKYDa3ZtA&oe=69A2D585"}, {"file_name": "impress.png", "id": "2218281078679057", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491823940_2218281082012390_5677592822942865259_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ak6JQZPXuYwQ7kNvwHgmwc4&_nc_oc=AdktdM-W74mkIdf51qD0vgjGhBfVqpMlKKukbi9dIQW2Vm087g881D0WR-YkJZJtul4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Afuo93YIi0R9n8tufh-uUfRBBCyWMz4F4-vZD2eriLBQQQ&oe=69A2DB5F"}, {"file_name": "impress2.png", "id": "1437506904610073", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491821796_1437506907943406_9080353388739888128_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o9iMfCQ_dOsQ7kNvwE6vo-_&_nc_oc=AdlBdWTXbDOOvBq6Tfgi8QLTaNDznjL7ehhCXFsR6LpfH7ti_oT5glfcSKYeGA5_tBM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Afsk2QGDVR3y_6NifeChpAVaisfTvejlyWy2on7YifceXQ&oe=69A2ECFC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_image_libreoffice_viewer_trailer_horizon_os.png", "id": "1986570352201618", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491825497_1986570355534951_6870447438066339222_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NHS-nOPN8nEQ7kNvwH9Z6wR&_nc_oc=AdksJnkscerXlcT9CIOjBM_HDZUVTmEE4HQ_uaG71hP8CSzyuLJCnhgDmiDjF3lfcxg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afuorn87WDon2VHKNincIByhCJssP_4pgCvYGxuiFp3D7Q&oe=69A2CEAD"}, "display_name": "LibreOffice Viewer", "keywords": [], "long_description": "You may know LibreOffice from the desktop - the free and open source office suite (successor to OpenOffice) with over 200 million users worldwide. It's secure and respects your privacy, not sharing your documents with anyone else. It's also available Meta Horizon OS in a simplified form, to view documents in these formats:\n\n\u2022 Open Document Format (odt, ods, odp, odg)\n\u2022 Microsoft Office 2007\u2013365 (docx, xlsx and pptx)\n\u2022 Microsoft Office 97\u20132003 (doc, xls and ppt)\n\nThe software is open source and made by a worldwide community, so if you'd like to improve the experimental editing support, please join us!\n\nFeedback and bug reports are very welcome, to help developers improve the quality of the application. You can report bugs and attach files here: https://bugs.documentfoundation.org\n\nLibreOffice Viewer is built on the same technology as LibreOffice desktop for Windows, macOS and Linux. LibreOffice Viewer is released under the Mozilla Public License v2. The software is backed by a dynamic community, represented by The Document Foundation, a not for profit entity based in Germany.\n\nLibreOffice was based on OpenOffice.org (commonly known as OpenOffice). Full credits: https://www.libreoffice.org/about-us/credits", "short_description": "Quickly and securely view OpenDocument and Microsoft Office files."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.libreoffice.org/about-us/privacy/libreoffice-viewer", "developer_terms_of_service_url": null, "publisher_name": "The Document Foundation", "support_website_url": null, "website_url": "https://www.libreoffice.org/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1063584910766706"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVE
2sdzh7e6X0JoNuxLQw3m7RZSDM8jw&oe=6B0B355F"}, {"file_name": "impress2.png", "id": "1437506904610073", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/491821796_1437506907943406_9080353388739888128_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Dwhu8D8cOfoQ7kNvwEWo2Sl&_nc_oc=Adp4CzbIHFGni4dVf8pc-jL0BuqCtvsMisx2Pp6Ugwc0an1o_moQfOKweYoYS2tD6SI&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQumKehdnZ9JzBdEPuYonS6EPCLJQwnFEDjyy_mczj2cA&oe=6B0B0EBC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_image_libreoffice_viewer_trailer_horizon_os.png", "id": "1986570352201618", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/491825497_1986570355534951_6870447438066339222_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JjfGNNoP9lcQ7kNvwHTBc7U&_nc_oc=AdrquI9mnpUyqcF5VqP3PMzH6dxAYwM7pD5-fvjYLiLN4B19mx2tb79eu292eknYHmI&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTiphhEnj9y72oeryEmv4LFh_pnkhmM6rlmh9XKD3Y9UA&oe=6B0B28AD"}, "display_name": "LibreOffice Viewer", "keywords": [], "long_description": "You may know LibreOffice from the desktop - the free and open source office suite (successor to OpenOffice) with over 200 million users worldwide. It's secure and respects your privacy, not sharing your documents with anyone else. It's also available Meta Horizon OS in a simplified form, to view documents in these formats:\n\n\u2022 Open Document Format (odt, ods, odp, odg)\n\u2022 Microsoft Office 2007\u2013365 (docx, xlsx and pptx)\n\u2022 Microsoft Office 97\u20132003 (doc, xls and ppt)\n\nThe software is open source and made by a worldwide community, so if you'd like to improve the experimental editing support, please join us!\n\nFeedback and bug reports are very welcome, to help developers improve the quality of the application. You can report bugs and attach files here: https://bugs.documentfoundation.org\n\nLibreOffice Viewer is built on the same technology as LibreOffice desktop for Windows, macOS and Linux. LibreOffice Viewer is released under the Mozilla Public License v2. The software is backed by a dynamic community, represented by The Document Foundation, a not for profit entity based in Germany.\n\nLibreOffice was based on OpenOffice.org (commonly known as OpenOffice). Full credits: https://www.libreoffice.org/about-us/credits", "short_description": "Quickly and securely view OpenDocument and Microsoft Office files."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.libreoffice.org/privacy-policy-libreoffice-viewer/", "developer_terms_of_service_url": null, "publisher_name": "The Document Foundation", "support_website_url": null, "website_url": "https://www.libreoffice.org/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1063584910766706"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "af", "hy", "eu", "bel", "ca", "zh_CN", "cs", "nl", "fi", "fr", "gl", "ka", "de", "el", "he", "hu", "is", "id", "it", "ja", "ne", "pl", "pt_BR", "pt", "ro", "sk", "sl", "es", "tl", "tr", "uk", "cy"], "supported_input_devices": ["GAMEPAD", "HAND_TRACKING", "OCULUS_TOUCH", "TRACKED_KEYBOARD"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26112000375138857"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/491823351_1137702555197605_7239597247643715161_n.png?stp=dst-png_s360x360&_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s--hstPXhB4Q7kNvwGQm4QZ&
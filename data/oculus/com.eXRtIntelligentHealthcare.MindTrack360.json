_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M-aWxVF7KKwQ7kNvwHWyPU4&_nc_oc=Adr2ZIR9_G3TtqyAtSETeZegCmK4_frxPvQc1wsXqxJT7lWOX6Ze7tTLN27bUC3DAig&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afxzyov-4R43Gl_I8ayKoBf2FdPl55zClgDzGQC6R7kU4Q&oe=69C541EB"}, {"file_name": "com.eXRtIntelligentHealthcare.MindTrack360-20260213-165320.png", "id": "881456037985549", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/491820428_881456041318882_7367179672608521584_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U5KqyRt3NC8Q7kNvwG_CIcQ&_nc_oc=Adob5A2U-SCwPMegQr9v4ufr-OAAsWElmJCcZ6ei8eXTW8W9idWkJ5Q7SaWWZJuv4rA&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afx2dXeF3ITAb_opGw3FUoW-jn2p7FcbDpoLGtrZzn_j9g&oe=69C538D7"}, {"file_name": "com.eXRtIntelligentHealthcare.MindTrack360-20260213-165547.png", "id": "909162811702441", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/491821081_909162815035774_7183203342651465106_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wSRhwYSI8GwQ7kNvwGbapW4&_nc_oc=Ado7DHwNU63qJieROWJeX2m3bgGPQjfRmM94gGiv9qQfEnsO089EGM_S6jKjgheKRoY&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxgvkblDO3NTzCpgvbGgZvjzBabH0L6xkmPie0oK3U0jA&oe=69C5198F"}, {"file_name": "com.eXRtIntelligentHealthcare.MindTrack360-20260213-163628.png", "id": "946673171025521", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/491825546_946673174358854_6551490292596811269_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9lJV2qxi2f0Q7kNvwECTMPs&_nc_oc=AdpwNx8J4Dce3J4TmCi9xvbdbbZmGBMAQeOiy-MEVsfizKN1EWzDSZiqCE_16fSX5_4&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afyc_5elzYSJ08aeDnbtH8ecvQp5F8qyTEMwW1kNMuJytA&oe=69C54432"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "MindTrack 360", "keywords": [], "long_description": "MindTrack 360 is a structured, therapy-informed virtual reality programme for people who want to reflect on their relationship with alcohol or drugs, especially those who have struggled to engage with traditional approaches.\n\nThe programme can be used independently or within supported settings such as community addiction services, outpatient programmes, or residential rehabilitation. Users are placed in calm, nature-rich virtual environments that reduce distraction and create a focused space for reflection.\n\nThrough short, structured sessions guided by a calm and supportive virtual coach, users explore daily patterns, motivation, values, strengths, and future direction \u2014 without judgement or pressure. Sessions are designed to feel accessible and non-confrontational, supporting engagement at the user\u2019s own pace.\n\nMindTrack 360 is informed by Cognitive Behavioural Therapy (CBT), Motivational Interviewing (MI), trauma-informed practice, and values-based care. These evidence-based approaches are embedded to support insight, clarity, and meaningful conversations about change.\n\nVirtual Reality helps users step away from the outside world, making it easier to focus and engage deeply compared to text-heavy programmes. The experience is organised into a multi-module structure with clear progression, supporting sustained engagement over time. Progress can be revisited and, where appropriate, used to support conversations with a keyworker or clinician.\n", "short_description": "MindTrack 360 is a therapy-informed VR programme for people exploring their relationship with alcohol or drugs. Users enter calm, nature-based environments and take part in short, guided self-reflection sessions led by a supportive virtual coach. Informed by CBT, Motivational Interviewing and trauma-informed practice, it supports insight, focus and meaningful change at the user\u2019s own pace."}]}, "developer_name": null, "developer_privacy_policy_url": "https://mindtrack360.com/PrivacyPolicy.pdf", "developer_terms_of_service_url": "https://mindtrack360.com/TermsOfService.pdf", "publisher_name": "MindTrack 360", "support_website_u
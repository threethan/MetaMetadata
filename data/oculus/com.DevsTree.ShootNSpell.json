less&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5cU8Nf6gJQMQ7kNvwH2YjF9&_nc_oc=AdrfAG3FG_6GVHKPWO92a_rCeIgjd2xQWBLKa02KnDOMucQ9r1h7wAKdxLI8P7UGBRg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVXdZxbQgImtpBPR44UZAPKjmbhKoB9a_dtk9Qd6aM0kg&oe=6B0F1EE0"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "SHOOT N SPELL", "keywords": ["Shooting", "Education", "Action"], "long_description": "Welcome to SHOOT N SPELL, a high-energy, brain-boosting virtual reality game developed for wireless standalone VR devices. In this unique word-action experience, players must react quickly to shoot or strike the correct letters of a given word as they appear in full 360\u00b0 motion. Each of the seven levels introduces new environments and weapons\u2014from fast-paced gunplay in Tunnel, to slicing words mid-air in Word Slice, to physically boxing your way through Word Boxing. The gameplay evolves constantly, challenging both your vocabulary and your reflexes. Ideal for kids, families, and adults who want fun and focus training. With intuitive VR controls, dynamic difficulty, and visually stunning environments, SHOOT N SPELL offers an unforgettable spell-shooting adventure that will keep you moving, learning, and coming back for more.\n", "short_description": "A high-speed 360\u00b0 VR word-action game! Read fast, react faster\u2014gun, punch, and slash letters \nas they fly toward you. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.devstree.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Devstree IT Services Private Limited", "support_website_url": null, "website_url": "https://www.devstree.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}, {"id": "1043107547362485"}, {"id": "1672577396871977"}], "external_su
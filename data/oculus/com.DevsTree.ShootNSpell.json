c_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TWMvQ8K8EBkQ7kNvwHKFVxf&_nc_oc=AdrQh-TAEEXm0o_xJb-PZTMatBkROHjIllYy5T0dPSPsrJUp5U6tD9_subAbiTsWIDQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3aQXxweHtS9Nqh533wz-RM31U5zwDbEhIKJGOSlPB0EQ&oe=69DB7D7A"}, {"file_name": "New Project (4).png", "id": "1589285318916540", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823783_1589285322249873_2268918995740607104_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w750X6hRsXAQ7kNvwGVUGXR&_nc_oc=AdoRlyJ-Wzo2XSID3xSQBhYdp96c1f8QG76PG-rgijxfSL-5DJmD5ihq3tpE22njLIU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af26Pqzt0AlTakwtyf57R6-OwTMTglPZRv0djC93iDvKxA&oe=69DB7DE4"}, {"file_name": "New Project (8).png", "id": "1184475039806257", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491820428_1184475043139590_2870824456773559916_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rE-6PrDEG7oQ7kNvwGWInD1&_nc_oc=Adq760NXfrU53f1cgpyj5HU1orpiI2fJA-tWrA23SDIE4X1C8eycJAl1RKWxnVlphas&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3ZjPm9P_pHPSssO36a9Nh6zdvKSBCpl92aygYoHmrL7w&oe=69DB80E0"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "SHOOT N SPELL", "keywords": ["Shooting", "Education", "Action"], "long_description": "Welcome to SHOOT N SPELL, a high-energy, brain-boosting virtual reality game developed for wireless standalone VR devices. In this unique word-action experience, players must react quickly to shoot or strike the correct letters of a given word as they appear in full 360\u00b0 motion. Each of the seven levels introduces new environments and weapons\u2014from fast-paced gunplay in Tunnel, to slicing words mid-air in Word Slice, to physically boxing your way through Word Boxing. The gameplay evolves constantly, challenging both your vocabulary and your reflexes. Ideal for kids, families, and adults who want fun and focus training. With intuitive VR controls, dynamic difficulty, and visually stunning environments, SHOOT N SPELL offers an unforgettable spell-shooting adventure that will keep you moving, learning, and coming back for more.\n", "short_description": "A high-speed 360\u00b0 VR word-action game! Read fast, react faster\u2014gun, punch, and slash letters \nas they fly toward you. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.devstree.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Devstree IT Services Private Limited", "support_website_url": null, "website_url": "https://www.devstree.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}, {"id": "1043107547362485"}, {"id": "1672577396871977"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24322645840678551"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491824741_1508267427142181_267486355000831386_n.png?stp=dst-png_s360x360&_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=urvECYq_-DYQ7kNvwFszOcr&_nc_oc=AdqJB_7qamHBzxqThDjupybMZEoaloh3ih6XrqYt75J9RM36t4mcZ-u5ybVtWsqXGKQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0cBElXDzeHhTZgNuE-L8b9BGs1eO53RlqBVqInvSpVMA&oe=69DB9417"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "SHOOT N SPELL", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "274332603592
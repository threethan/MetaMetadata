name": "New Project (7).png", "id": "2619317875119375", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/491821696_2619317881786041_1492948970619240871_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ODKdfYzeGuAQ7kNvwGwYpTY&_nc_oc=Adq4zF3ePbHDH8AwJPfjLtVDM3zVOJdklUV4rl6kI4Vp3s1RPIGAIDx3pC17z-vaPxI&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_Af3-Sh58ZeicQA01erFfRo6aXY5uHOuPDzhC7YJ26z9zUA&oe=69F1F624"}, {"file_name": "New Project (5).png", "id": "1348118500127002", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/491823341_1348118503460335_8219811534830681390_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WEVHpHdkqVMQ7kNvwG0_Dic&_nc_oc=Adp0Y3ThNYHx82SLqIcZrMub9pJFK6DgjHR3_TZHJH4ucX2mYD3xpyHUsqW0ckkNUQI&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_Af2WPM2OqjRdcd22UMpcSYysWd_laNQAioAMx19yRPTSzQ&oe=69F1E6FA"}, {"file_name": "New Project (4).png", "id": "1589285318916540", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/491823783_1589285322249873_2268918995740607104_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MlB38BJea2wQ7kNvwFmHeuP&_nc_oc=AdrRmD6IoCbZlUzf_ZdM0z7b3mYcGx0KLaINtO09VX97B_GJBc1OlKu0u6rEqcTfqZc&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_Af2vr5mvD4SUgPhwVpyX_Zpprykt4BfFcPaFBd2iNONByQ&oe=69F1E764"}, {"file_name": "New Project (8).png", "id": "1184475039806257", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/491820428_1184475043139590_2870824456773559916_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9zB2FtdoavQQ7kNvwHwI65a&_nc_oc=AdrgF6APjxKA7poknUMDKix1QkFH3g8Mkht6lwrxivPiTs8bqzz3wD_XpEveQTvGA3U&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_Af1q8fIVxfkmiyPj9CGeArkLHsqIoTxJ7JWZOkzdpww1eQ&oe=69F1EA60"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "SHOOT N SPELL", "keywords": ["Shooting", "Education", "Action"], "long_description": "Welcome to SHOOT N SPELL, a high-energy, brain-boosting virtual reality game developed for wireless standalone VR devices. In this unique word-action experience, players must react quickly to shoot or strike the correct letters of a given word as they appear in full 360\u00b0 motion. Each of the seven levels introduces new environments and weapons\u2014from fast-paced gunplay in Tunnel, to slicing words mid-air in Word Slice, to physically boxing your way through Word Boxing. The gameplay evolves constantly, challenging both your vocabulary and your reflexes. Ideal for kids, families, and adults who want fun and focus training. With intuitive VR controls, dynamic difficulty, and visually stunning environments, SHOOT N SPELL offers an unforgettable spell-shooting adventure that will keep you moving, learning, and coming back for more.\n", "short_description": "A high-speed 360\u00b0 VR word-action game! Read fast, react faster\u2014gun, punch, and slash letters \nas they fly toward you. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.devstree.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Devstree IT Services Private Limited", "support_website_url": null, "website_url": "https://www.devstree.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}, {"id": "1043107547362485"}, {"id": "1672577396871977"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24322645840678551"}}]}, "scheduled_offers": {"count": 3, "nodes": [{"status": "PUBLISHED", "id": "1247446234
oKfm6y2WmQwtNQyW5KXD8VR-slBbiMVX0_jDqA8F26_TWoVnAi96kOnOUZi4A6Z7Y&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRzS-a-z-ZWmuFsIRXbf2re7Zw3BD7MnzCnzlxQ5VKVRQ&oe=6B0327AA"}, {"file_name": "migrated_image.png", "id": "638667530199811", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/11162687_1576552909061927_8565495137164066816_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RnCOU2v9EcsQ7kNvwHDJD81&_nc_oc=Adq9Lr42OmhYFex3ct4OO03HYKDOdPc2gW5JtspnwssqS7ROdPkXQh33Q9B4xd7wUiI&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSXdWCITErLuvpqySrql0W9wc6aMx0xN0Q22IvGS9_orw&oe=6B031A74"}, {"file_name": "migrated_image.png", "id": "613240785922184", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/11162688_1751178744895757_7937926369982283776_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wdjtflZ7yTQQ7kNvwGGuh4x&_nc_oc=AdpOIsQU-tD2ko-scQaoEQdT0r1kNu0hQd9Igo5K1wAU4w5wo5OFyW8QxvTSgY0xrx4&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQFOIVbEMmZj-HebMBVKK3o55KL6VZLNU4JTH8Ui8UxxA&oe=6B03238B"}, {"file_name": "migrated_image.png", "id": "216891552717005", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/11162678_243960662790390_4422797552932356096_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rKZTzvivhWoQ7kNvwEWBHbD&_nc_oc=Adp0YVMzEtV5NX86Mlun4sEz2E1tg3P_XPP4oUCz1dk24tTVtg1iYFq9Vw5Skhi94js&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT6jSIYmbIZLf_SQEDCWTAByGXAhjdJ4gTfcrshXB4vCg&oe=6B032C57"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Thumb_01.png", "id": "120924438518435", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/11162731_120924441851768_1476883766688350208_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mOFIyoGnFGEQ7kNvwEoGr1p&_nc_oc=Adrga15InMYdDtS1VOLPHUovIWO57ay0t_2mCr44vFP1CNEJfoI2WxnWT75OAArSi1Y&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQFALZdMltOHEvzJMJ0nhPc2ba6YtbSSVYzeLPxmvBCoQ&oe=6B031B88"}, "display_name": "Fantasy Pets", "keywords": ["Pet", "Friend", "Cute", "Simulation", "Fantasy"], "long_description": "Learn to take care of your pet, make sure it does not go hungry, and play with toys to keep it entertained! Visit it often and make sure it doesn\u2019t get sick. Don\u2019t worry if it gets dirty playing \u2026 It loves to bathe!\nYou can also shoot some hoops or watch TV while it sleeps or if you need a break.\n\nComplete missions for incredible rewards! With them you\u2019ll unlock new colors, patterns and accessories with which to decorate your pet; funny hats, glasses, and much more!\nDo not miss any opportunity to unlock all the packs and equip your favorite!\n\nWe recommend using headphones.\n\nGame features:\n- Lovely pet with realistic behaviour.\n- Stunning 3D graphics.\n- Different ways to take care of your pet.\n- Growth and evolution of your pet.\n- Beautiful and big environment in which to play with your pet.\n- Lots of variation in pet customization.", "short_description": "Fantasy Pets is a Pet Simulator in which you have to take care of  a cute pet, play with it, customize it and more in a beautiful environment. You\u2019ll start off with an egg, and after hatching it you\u2019ll learn how to take care of your newborn pet.\nThere are differents ways to customize it, from the color and patterns of its skin to accessories that it can wear."}]}, "developer_name": null, "developer_privacy_policy_url": "http://demiumgames.com/privacy.html", "developer_terms_of_service_url": "http://demiumgames.com/privacy.html", "publisher_name": "Pyrolite Games", "support_website_url": null, "website_url": "http://pyrolitegames.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["CASUAL", "SIMULATION"], "has_in_app_ads": null, "i
0048_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l-aFRDyvPaUQ7kNvwHuAsbk&_nc_oc=AdrJJQQM1883qA4UdBqWR-yrfu1Dl6JfxwP4veqaThtKAodbkTCla_D1snzYc-gA3Rk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-uTVd2r4FaUX7X4BAvK9_dLDlDbTThLrNCEtuBQd_x9A&oe=6A428465"}, {"file_name": "migrated_image.png", "id": "154317689089912", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/11162711_262530014224786_2316404711751680000_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zcyOXSEPDmIQ7kNvwHSV_0L&_nc_oc=Adp0ERSTMeD21rD9pe1YVxamxMTHrhcpjjvV369YOdn6ORcEDl2jt9TmZDrVNU8QiC0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8yLCubu-i7MqEE7U0100S68a5yw88hbgB0tihb11eyfg&oe=6A427BC7"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Fantasy Pets", "keywords": ["Pet", "Friend", "Cute", "Simulation", "Fantasy"], "long_description": "Try out Fantasy Pets!\nEnjoy playing with your cute pet, but be careful, don\u2019t throw anything at its body or it will get angry!\nTry to score some points playing basketball with your pet. \nRefill the food bowl with its favourite food. If you see or hear it cry, it might be because there\u2019s no food left in the bowl, so just refill to cheer it up! \nTurn on the TV for your little friend to enjoy its favourite programs.\n\nWe recommend using headphones.\nEasy control, just tap on the touchpad to interact with any element.\n\nGame features:\nPet with realistic behaviour.\nAmazing 3D graphics.\nGorgeous environment where you play with your pet.\nGrowth and evolution of your pet.", "short_description": "Fantasy Pets is a pet simulator where you take care of your creature and play with it in a beautiful environment made for it."}]}, "developer_name": null, "developer_privacy_policy_url": "http://demiumgames.com/privacy.html", "developer_terms_of_service_url": "http://demiumgames.com/privacy.html", "publisher_name": "Pyrolite Games", "support_website_url": null, "website_url": "http://p
scontent-ams2-1.oculuscdn.com/v/t64.5771-25/11162687_1576552909061927_8565495137164066816_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Clzp1N_4FLIQ7kNvwGiXuSD&_nc_oc=Adme5yw-yeQWpCTuo6TLbQcZXgAHxcNCrI8gMqqkZkmL2hp_XhD7vvyv6nsjz8QzLj0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfyPd1-vk6jQYWZgwt_6NMdUqP5C3XaHhjmAeL4AtkRhsA&oe=69AEBF34"}, {"file_name": "migrated_image.png", "id": "613240785922184", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/11162688_1751178744895757_7937926369982283776_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BWGqLbcFts8Q7kNvwFWE96N&_nc_oc=Adly52AYd1yjofn92EFPPWDwqKaXqGaddSMw5Tt8FP__wbKSOOmJ17VwwzwvU67ZjVg&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfzWFvkCB4vkPr_OfRLf1mx1t2AyLP1KZNjRiy_8jroEFQ&oe=69AEC84B"}, {"file_name": "migrated_image.png", "id": "216891552717005", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/11162678_243960662790390_4422797552932356096_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rgXzp_SR0HMQ7kNvwEUhV4f&_nc_oc=AdmwpmeTWiAB13HDs3LBfJIPptgq9aU9ezgxqnO3xtI7OjQuo96gwBgLoXSKqylJ1VY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afz9651g7tGFYZzOVN0BHKxctbVbRJsUP5DRnCdt5eCPYg&oe=69AED117"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Thumb_01.png", "id": "120924438518435", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/11162731_120924441851768_1476883766688350208_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a4hI6QVQawIQ7kNvwHFxAaA&_nc_oc=AdnSu5v7uic9MOfzQK4vq2xY-Gn3s2ersl1KXs5DloK47iRy2oGIuA6QmbjXUX4L3GE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfzKYsKRA5n1LKwplvBwCyudiX2pPAt7_YOXBTQa04LLbQ&oe=69AEC048"}, "display_name": "Fantasy Pets", "keywords": ["Pet", "Friend", "Cute", "Simulation", "Fantasy"], "long_description": "Learn to take care of your pet, make sure it does not go hungry, and play with toys to keep it entertained! Visit it often and make sure it doesn\u2019t get sick. Don\u2019t worry if it gets dirty playing \u2026 It loves to bathe!\nYou can also shoot some hoops or watch TV while it sleeps or if you need a break.\n\nComplete missions for incredible rewards! With them you\u2019ll unlock new colors, patterns and accessories with which to decorate your pet; funny hats, glasses, and much more!\nDo not miss any opportunity to unlock all the packs and equip your favorite!\n\nWe recommend using headphones.\n\nGame features:\n- Lovely pet with realistic behaviour.\n- Stunning 3D graphics.\n- Different ways to take care of your pet.\n- Growth and evolution of your pet.\n- Beautiful and big environment in which to play with your pet.\n- Lots of variation in pet customization.", "short_description": "Fantasy Pets is a Pet Simulator in which you have to take care of  a cute pet, play with it, customize it and more in a beautiful environment. You\u2019ll start off with an egg, and after hatching it you\u2019ll learn how to take care of your newborn pet.\nThere are differents ways to customize it, from the color and patterns of its skin to accessories that it can wear."}]}, "developer_name": null, "developer_privacy_policy_url": "http://demiumgames.com/privacy.html", "developer_terms_of_service_url": "http://demiumgames.com/privacy.html", "publisher_name": "Pyrolite Games", "support_website_url": null, "website_url": "http://pyrolitegames.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["CASUAL", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1081958082365326"}, "review_messages": []}]}, "cove
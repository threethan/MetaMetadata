scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/11162687_1576552909061927_8565495137164066816_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bOmlm3goAEgQ7kNvwGmlRET&_nc_oc=Adn8TJPuq4tmF-x5Qkv1d0xGDsppe1_kW31kUye-OnBlbYBRF3XPlqfQJhPMjvUu5kk&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=8&oh=00_AfyXI1AIVwH2qNwZlZvOYkaCu0OfIIG83Gi8qcOY9zrMmw&oe=69BD3FB4"}, {"file_name": "migrated_image.png", "id": "613240785922184", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/11162688_1751178744895757_7937926369982283776_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jgi76kwpKpwQ7kNvwFDW-Iq&_nc_oc=Adng40kMFaSEfre2L975PnitXF0nCw-kWMp7OJW0nkSgD9eMeyUSVZh6C-aIRJdXFQ8&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=8&oh=00_AfyW_KG90heS6CUml6LXOK_4XwZEHEEl510r0TjUuv8wbg&oe=69BD48CB"}, {"file_name": "migrated_image.png", "id": "216891552717005", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/11162678_243960662790390_4422797552932356096_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TNZB7VOyH5sQ7kNvwHT_A0j&_nc_oc=AdluCeX0JiRu53biXBG_g6JivcP6ZZCGzlpUgy3ycSKE0dDtKKEU9yjK_iezh8JdczE&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=8&oh=00_Afwl2bdLpDaGhGKevVaZsM69TkY5f0AFM3tUhTVEpPrw7A&oe=69BD5197"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Thumb_01.png", "id": "120924438518435", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/11162731_120924441851768_1476883766688350208_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P8lxtVoVceEQ7kNvwHIO5DN&_nc_oc=AdmiC-iWxwbDS6Bpao-wMXlE2dfPri8TmpheIIIkae7UAD1VmAhTDtF4dnNALiGGX1U&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=8&oh=00_Afy7_OwbI3etSJN88-ge2kMPpoTTxhN9as2WAtXZeaAOjg&oe=69BD40C8"}, "display_name": "Fantasy Pets", "keywords": ["Pet", "Friend", "Cute", "Simulation", "Fantasy"], "long_description": "Learn to take care of your pet, make sure it does not go hungry, and play with toys to keep it entertained! Visit it often and make sure it doesn\u2019t get sick. Don\u2019t worry if it gets dirty playing \u2026 It loves to bathe!\nYou can also shoot some hoops or watch TV while it sleeps or if you need a break.\n\nComplete missions for incredible rewards! With them you\u2019ll unlock new colors, patterns and accessories with which to decorate your pet; funny hats, glasses, and much more!\nDo not miss any opportunity to unlock all the packs and equip your favorite!\n\nWe recommend using headphones.\n\nGame features:\n- Lovely pet with realistic behaviour.\n- Stunning 3D graphics.\n- Different ways to take care of your pet.\n- Growth and evolution of your pet.\n- Beautiful and big environment in which to play with your pet.\n- Lots of variation in pet customization.", "short_description": "Fantasy Pets is a Pet Simulator in which you have to take care of  a cute pet, play with it, customize it and more in a beautiful environment. You\u2019ll start off with an egg, and after hatching it you\u2019ll learn how to take care of your newborn pet.\nThere are differents ways to customize it, from the color and patterns of its skin to accessories that it can wear."}]}, "developer_name": null, "developer_privacy_policy_url": "http://demiumgames.com/privacy.html", "developer_terms_of_service_url": "http://demiumgames.com/privacy.html", "publisher_name": "Pyrolite Games", "support_website_url": null, "website_url": "http://pyrolitegames.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["CASUAL", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1081958082365326"}, "review_messages": []}]}, "cove
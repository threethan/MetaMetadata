scontent-ord5-1.oculuscdn.com/v/t64.5771-25/11162687_1576552909061927_8565495137164066816_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Clzp1N_4FLIQ7kNvwHlmg2a&_nc_oc=Adm7UzQkXtiRGd6t1EAU2or1p5CGc9H7x-pick0Y2bm-j8SQqeluokjRBkO6aHoxo6E&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfxSQXvMrxjXcEHRPKKqeKbyAHeHjMUZIbxoRL-9IEXraA&oe=69AC1C34"}, {"file_name": "migrated_image.png", "id": "613240785922184", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/11162688_1751178744895757_7937926369982283776_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BWGqLbcFts8Q7kNvwHO1YGZ&_nc_oc=AdkGKw-FD8I9xUx6NRKjpzLY35gSVjt2YcCYNpiUS4oxP2gJE12vmXUbcvqI6DhY-Pc&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afyzw0R22SBMY2tI4BCaActFlaTSLWPO_i1bUqerdg5xFQ&oe=69AC254B"}, {"file_name": "migrated_image.png", "id": "216891552717005", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/11162678_243960662790390_4422797552932356096_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rgXzp_SR0HMQ7kNvwH9wy_W&_nc_oc=AdkJYoITzoGZTvvWbgFB41snPLwY9aABQUGSvIAq2v-NDs7yi9XIFKEDh-f16DKeHrI&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfwgerAtHZ_DkOcdsMqLDqtGwPtRJoGogVLYu0Z8mXC_3Q&oe=69AC2E17"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Thumb_01.png", "id": "120924438518435", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/11162731_120924441851768_1476883766688350208_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CjL162O-PakQ7kNvwH6VXDm&_nc_oc=AdnIZKssD2teUpHk_kIydFrKbvIA_NrkkIlp2YCvA8XDa2qFV-zED1rj6ZxlYRxGkNI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_Afw3X2Zo8_8O0H1Q_j4982LPxorxS88daT4HYpmwZDEUvw&oe=69AC1D48"}, "display_name": "Fantasy Pets", "keywords": ["Pet", "Friend", "Cute", "Simulation", "Fantasy"], "long_description": "Learn to take care of your pet, make sure it does not go hungry, and play with toys to keep it entertained! Visit it often and make sure it doesn\u2019t get sick. Don\u2019t worry if it gets dirty playing \u2026 It loves to bathe!\nYou can also shoot some hoops or watch TV while it sleeps or if you need a break.\n\nComplete missions for incredible rewards! With them you\u2019ll unlock new colors, patterns and accessories with which to decorate your pet; funny hats, glasses, and much more!\nDo not miss any opportunity to unlock all the packs and equip your favorite!\n\nWe recommend using headphones.\n\nGame features:\n- Lovely pet with realistic behaviour.\n- Stunning 3D graphics.\n- Different ways to take care of your pet.\n- Growth and evolution of your pet.\n- Beautiful and big environment in which to play with your pet.\n- Lots of variation in pet customization.", "short_description": "Fantasy Pets is a Pet Simulator in which you have to take care of  a cute pet, play with it, customize it and more in a beautiful environment. You\u2019ll start off with an egg, and after hatching it you\u2019ll learn how to take care of your newborn pet.\nThere are differents ways to customize it, from the color and patterns of its skin to accessories that it can wear."}]}, "developer_name": null, "developer_privacy_policy_url": "http://demiumgames.com/privacy.html", "developer_terms_of_service_url": "http://demiumgames.com/privacy.html", "publisher_name": "Pyrolite Games", "support_website_url": null, "website_url": "http://pyrolitegames.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["CASUAL", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1081958082365326"}, "review_messages": []}]}, "cove
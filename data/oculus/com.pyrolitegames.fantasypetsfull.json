oqXjeBUx9W-YxPtMqXQ4U5DwvpYpuWVMbjpR7qhJ3WI6tzbhqa5dh4A8OveJWCQJY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTHqROmSKOX4WzLanUi_t063A9X9bCHc1McNuHa9OQbEw&oe=6B0084AA"}, {"file_name": "migrated_image.png", "id": "638667530199811", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/11162687_1576552909061927_8565495137164066816_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RnCOU2v9EcsQ7kNvwGqsZQL&_nc_oc=AdpSFFdm63J84otTbgwMwgZn5O-f8qs8DpPTN_gRofW4_RVkZmUBY0zwn--nuIll-wk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT42YwWKRrx4XingFzx95whrWesHKootLptli_QSA6rkQ&oe=6B007774"}, {"file_name": "migrated_image.png", "id": "613240785922184", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/11162688_1751178744895757_7937926369982283776_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wdjtflZ7yTQQ7kNvwFyLqLp&_nc_oc=AdqmN-cxu4Rf9DaQfvIR2n2cp-2tAMxXdqif6pxs84-_-L4QxtFXd7Z-81WvoDgl2p8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQHYBmxNb8ijE12mQA1LSOUj3JvUY5bBcgxPkonvgsDYg&oe=6B00808B"}, {"file_name": "migrated_image.png", "id": "216891552717005", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/11162678_243960662790390_4422797552932356096_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rKZTzvivhWoQ7kNvwHgzD1j&_nc_oc=AdrIgCzEqdRQeoOZm9WEg4dy42WlnVxtfWjmgyXaC_3mfRAuO2nKQA-33nKG8JdtbBY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ2oj180NLDjf2hwvJ-7WwrWuiYRf-WlU3jr-32yJCLEw&oe=6B008957"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Thumb_01.png", "id": "120924438518435", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/11162731_120924441851768_1476883766688350208_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zy3XMLIPWzoQ7kNvwFtWZoZ&_nc_oc=Adrr0kGgb1i2gC5vdPwKIM8GQEnOWDMVszxmyXI-m_FZ3jcsQYcRlo1wy4WP0KPuy9U&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSW6IyVwunODRg0wDptT3toTqX3lelFSoKSE9RHwiAVwg&oe=6B007888"}, "display_name": "Fantasy Pets", "keywords": ["Pet", "Friend", "Cute", "Simulation", "Fantasy"], "long_description": "Learn to take care of your pet, make sure it does not go hungry, and play with toys to keep it entertained! Visit it often and make sure it doesn\u2019t get sick. Don\u2019t worry if it gets dirty playing \u2026 It loves to bathe!\nYou can also shoot some hoops or watch TV while it sleeps or if you need a break.\n\nComplete missions for incredible rewards! With them you\u2019ll unlock new colors, patterns and accessories with which to decorate your pet; funny hats, glasses, and much more!\nDo not miss any opportunity to unlock all the packs and equip your favorite!\n\nWe recommend using headphones.\n\nGame features:\n- Lovely pet with realistic behaviour.\n- Stunning 3D graphics.\n- Different ways to take care of your pet.\n- Growth and evolution of your pet.\n- Beautiful and big environment in which to play with your pet.\n- Lots of variation in pet customization.", "short_description": "Fantasy Pets is a Pet Simulator in which you have to take care of  a cute pet, play with it, customize it and more in a beautiful environment. You\u2019ll start off with an egg, and after hatching it you\u2019ll learn how to take care of your newborn pet.\nThere are differents ways to customize it, from the color and patterns of its skin to accessories that it can wear."}]}, "developer_name": null, "developer_privacy_policy_url": "http://demiumgames.com/privacy.html", "developer_terms_of_service_url": "http://demiumgames.com/privacy.html", "publisher_name": "Pyrolite Games", "support_website_url": null, "website_url": "http://pyrolitegames.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["CASUAL", "SIMULATION"], "has_in_app_ads": null, "i
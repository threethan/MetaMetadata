scontent-ord5-1.oculuscdn.com/v/t64.5771-25/11162687_1576552909061927_8565495137164066816_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7dgiFgFJfQ0Q7kNvwHxRzUc&_nc_oc=AdmoRPY_ihn0_tbbSQMuh8EJ9mcnYW3oB7PiLaFPhAm0JmtkBO1LALaRgl4keRxAzEU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_Afx-Btcg3KOOke0w4FUj9fUyb0CkEntGpRD31PBwYd7FMQ&oe=69B2B3B4"}, {"file_name": "migrated_image.png", "id": "613240785922184", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/11162688_1751178744895757_7937926369982283776_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=00ZZASK7JusQ7kNvwHvsCVv&_nc_oc=AdkdBuo4xwPPS7h3aEjyOgqEXidrPB-7Zcn8l9EIUxBWsF-WSaPaSQFrOCEcU6L2t2c&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfwbPeezkZGIFEk3-WScPZML9DH9G_GVP-lk1IhclDPRuA&oe=69B2BCCB"}, {"file_name": "migrated_image.png", "id": "216891552717005", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/11162678_243960662790390_4422797552932356096_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gZh8HBT5iHIQ7kNvwGXBGei&_nc_oc=AdnfqhhCzkATvPkWhWTSqLGp7ir3QX3Jok9D0JamAE9AEofB4JXa857v8p9Kvv_nclw&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfwDb6M8bMKjKdo-qozIbNGu2_Jh8qZI11kiOzLaEkZlag&oe=69B2C597"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Thumb_01.png", "id": "120924438518435", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/11162731_120924441851768_1476883766688350208_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vnD9sHJHq34Q7kNvwFG5wvK&_nc_oc=AdmbP2hn3hgLSbr1ZClaM3C2C1bsxd2s1fHEjmkRQp5UGX225DqGPxWtBEIZ-lU5Nv0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfznvpssAgbcLLRa23mTBVG_vN-fF0IHcoMK-p2NUqvsjQ&oe=69B2B4C8"}, "display_name": "Fantasy Pets", "keywords": ["Pet", "Friend", "Cute", "Simulation", "Fantasy"], "long_description": "Learn to take care of your pet, make sure it does not go hungry, and play with toys to keep it entertained! Visit it often and make sure it doesn\u2019t get sick. Don\u2019t worry if it gets dirty playing \u2026 It loves to bathe!\nYou can also shoot some hoops or watch TV while it sleeps or if you need a break.\n\nComplete missions for incredible rewards! With them you\u2019ll unlock new colors, patterns and accessories with which to decorate your pet; funny hats, glasses, and much more!\nDo not miss any opportunity to unlock all the packs and equip your favorite!\n\nWe recommend using headphones.\n\nGame features:\n- Lovely pet with realistic behaviour.\n- Stunning 3D graphics.\n- Different ways to take care of your pet.\n- Growth and evolution of your pet.\n- Beautiful and big environment in which to play with your pet.\n- Lots of variation in pet customization.", "short_description": "Fantasy Pets is a Pet Simulator in which you have to take care of  a cute pet, play with it, customize it and more in a beautiful environment. You\u2019ll start off with an egg, and after hatching it you\u2019ll learn how to take care of your newborn pet.\nThere are differents ways to customize it, from the color and patterns of its skin to accessories that it can wear."}]}, "developer_name": null, "developer_privacy_policy_url": "http://demiumgames.com/privacy.html", "developer_terms_of_service_url": "http://demiumgames.com/privacy.html", "publisher_name": "Pyrolite Games", "support_website_url": null, "website_url": "http://pyrolitegames.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["CASUAL", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1081958082365326"}, "review_messages": []}]}, "cove
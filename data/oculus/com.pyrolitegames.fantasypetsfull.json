.\n\nWe recommend using headphones.\nEasy control, just tap on the touchpad to interact with any element.\n\nGame features:\nPet with realistic behaviour.\nAmazing 3D graphics.\nGorgeous environment where you play with your pet.\nGrowth and evolution of your pet.", "short_description": "Fantasy Pets is a pet simulator where you take care of your creature and play with it in a beautiful environment made for it."}]}, "developer_name": null, "developer_privacy_policy_url": "http://demiumgames.com/privacy.html", "developer_terms_of_service_url": "http://demiumgames.com/privacy.html", "publisher_name": "Pyrolite Games", "support_website_url": null, "website_url": "http://pyrolitegames.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["CASUAL", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "226347836379441"}}]}, "scheduled_offers": {"count": 0, "nodes": []}, "baseline_offer": null, "is_approved": true, "firstOffer": {"nodes": []}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1551195308287672", "version": "2.0.3"}, "id": "1915043972093643", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1546529198754283", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1551195308287672"}, "release_status": "RELEASED"}, "binary_release_channel
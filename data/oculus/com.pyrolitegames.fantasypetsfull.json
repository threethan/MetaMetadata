64066816_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Jmca59NnZMkQ7kNvwHTVFRl&_nc_oc=Adk_1st__zAfFG959R5itLuTT5yqwsUirZKP2HwHnNAr3b9JFsQkXZ8a2tzkh2cbtTs&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_AfudXbuuNo_By_xvjkMg4bnVukJKFTOYFs5Zo61vXJzxig&oe=69A43334"}, {"file_name": "migrated_image.png", "id": "613240785922184", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/11162688_1751178744895757_7937926369982283776_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RQtYH8JkFiAQ7kNvwGerDLz&_nc_oc=AdkLxrHQZc24fbOfE3BeZ1I92opIX8lRsFUShfU-FrDCTW8n9VHKXo5906xRH13hzn0&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfsuGs0iLA6tqk5f2ZA5oQ_XgiDJW46_n4jcgrOSFMFoiw&oe=69A43C4B"}, {"file_name": "migrated_image.png", "id": "216891552717005", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/11162678_243960662790390_4422797552932356096_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=65uD7QM7AWEQ7kNvwGffff0&_nc_oc=Adn5CS946gSz3IYH2vy1MgzBYFX2cMkbmMFpf_PNBOXSbvAqpTK9IVe510mIpVxqLlg&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_Afuf8bJ0ckajL0uLAcUemADUFQW1BLyl1w5shdgNuap5uA&oe=69A44517"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Thumb_01.png", "id": "120924438518435", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/11162731_120924441851768_1476883766688350208_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ntG3ZUbGoFMQ7kNvwG10bMe&_nc_oc=AdnLfCbjdWfo_76W54KlCkASYjXAi32B5v1s5cwXfdJfWZ67JtAmxZvh-T809iDObJs&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_AfvDCqxYlV2zJDlBhmvbW55hJ7hprJAvowH2kUPjj4D84A&oe=69A43448"}, "display_name": "Fantasy Pets", "keywords": ["Pet", "Friend", "Cute", "Simulation", "Fantasy"], "long_description": "Learn to take care of your pet, make sure it does not go hungry, and play with toys to keep it entertained! Visit it often and make sure it doesn\u2019t get sick. Don\u2019t worry if it gets dirty playing \u2026 It loves to bathe!\nYou can also shoot some hoops or watch TV while it sleeps or if you need a break.\n\nComplete missions for incredible rewards! With them you\u2019ll unlock new colors, patterns and accessories with which to decorate your pet; funny hats, glasses, and much more!\nDo not miss any opportunity to unlock all the packs and equip your favorite!\n\nWe recommend using headphones.\n\nGame features:\n- Lovely pet with realistic behaviour.\n- Stunning 3D graphics.\n- Different ways to take care of your pet.\n- Growth and evolution of your pet.\n- Beautiful and big environment in which to play with your pet.\n- Lots of variation in pet customization.", "short_description": "Fantasy Pets is a Pet Simulator in which you have to take care of  a cute pet, play with it, customize it and more in a beautiful environment. You\u2019ll start off with an egg, and after hatching it you\u2019ll learn how to take care of your newborn pet.\nThere are differents ways to customize it, from the color and patterns of its skin to accessories that it can wear."}]}, "developer_name": null, "developer_privacy_policy_url": "http://demiumgames.com/privacy.html", "developer_terms_of_service_url": "http://demiumgames.com/privacy.html", "publisher_name": "Pyrolite Games", "support_website_url": null, "website_url": "http://pyrolitegames.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["CASUAL", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1081958082365326"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/11162676_102770777021317_42328147082954
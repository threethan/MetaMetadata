scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/11162687_1576552909061927_8565495137164066816_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bOmlm3goAEgQ7kNvwFC0HpN&_nc_oc=AdkKWiIRuvZ6SlyX-zTx7aR1CTi_wLCqIJvk4VlYFdpXbFTFoPdvGm2MQ0VpPaFuj7I&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_Afxr2h5Go9wLUMTAgbLUbC8aGU6FT8Bm7ZyLS5G1e10VeA&oe=69BE9134"}, {"file_name": "migrated_image.png", "id": "613240785922184", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/11162688_1751178744895757_7937926369982283776_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jgi76kwpKpwQ7kNvwFye83W&_nc_oc=Adm_Fv6sj0b274l8HCB_ZhLiQdIIVaBG1wkHNRJs6mF5JdA5VQylAOut4LBq4-djjqU&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfyEzvLxv7CzE3cmGviF06hQgg4Tu7WdHKOSXN3NlqLLtQ&oe=69BE9A4B"}, {"file_name": "migrated_image.png", "id": "216891552717005", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/11162678_243960662790390_4422797552932356096_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TNZB7VOyH5sQ7kNvwEBcJmp&_nc_oc=AdkQ7iTJaAmeUaDcz-p0hgh67E3NR4wNb3M2mZQe3S0pWWf77wwfbASndVKPKOLoMoY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfwWFBgAl3EuQqtxiKH2oUjj3AYM9r5Gu8cUBIuk5e2COg&oe=69BEA317"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Thumb_01.png", "id": "120924438518435", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/11162731_120924441851768_1476883766688350208_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P8lxtVoVceEQ7kNvwFuVFRE&_nc_oc=AdkKAmY7hpTOc-zmgY5uUH7LpGr3dd7u4Ds7aTbbZAdyqXcnCRvIr1CcG_quP5Qae4A&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfwYoGIl3yiu6swTsfc7myOPZdbvR02M6QHEclBDthEmlQ&oe=69BE9248"}, "display_name": "Fantasy Pets", "keywords": ["Pet", "Friend", "Cute", "Simulation", "Fantasy"], "long_description": "Learn to take care of your pet, make sure it does not go hungry, and play with toys to keep it entertained! Visit it often and make sure it doesn\u2019t get sick. Don\u2019t worry if it gets dirty playing \u2026 It loves to bathe!\nYou can also shoot some hoops or watch TV while it sleeps or if you need a break.\n\nComplete missions for incredible rewards! With them you\u2019ll unlock new colors, patterns and accessories with which to decorate your pet; funny hats, glasses, and much more!\nDo not miss any opportunity to unlock all the packs and equip your favorite!\n\nWe recommend using headphones.\n\nGame features:\n- Lovely pet with realistic behaviour.\n- Stunning 3D graphics.\n- Different ways to take care of your pet.\n- Growth and evolution of your pet.\n- Beautiful and big environment in which to play with your pet.\n- Lots of variation in pet customization.", "short_description": "Fantasy Pets is a Pet Simulator in which you have to take care of  a cute pet, play with it, customize it and more in a beautiful environment. You\u2019ll start off with an egg, and after hatching it you\u2019ll learn how to take care of your newborn pet.\nThere are differents ways to customize it, from the color and patterns of its skin to accessories that it can wear."}]}, "developer_name": null, "developer_privacy_policy_url": "http://demiumgames.com/privacy.html", "developer_terms_of_service_url": "http://demiumgames.com/privacy.html", "publisher_name": "Pyrolite Games", "support_website_url": null, "website_url": "http://pyrolitegames.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["CASUAL", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1081958082365326"}, "review_messages": []}]}, "cove
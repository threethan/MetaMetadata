64066816_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZIZACjLMLDcQ7kNvwEb9b3D&_nc_oc=Adq2YZCwKx-CdqLiHaWb0NDTiN1DJpyQfAybFabagnf9kWfkre1-DziTntbAk376ZgQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Af3SJuW1naBjD_yN8ifo6oIEJhmx7kXFXbWpIWQqVWxmCg&oe=69F0AA34"}, {"file_name": "migrated_image.png", "id": "613240785922184", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/11162688_1751178744895757_7937926369982283776_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9ckgzjvC8zkQ7kNvwGLbjy3&_nc_oc=AdqXcoezK3YRn7cc-wpsXnjBtKB3ziW4zelQok81oISZSv940BTvFI6gkOGYz9qNrk4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af3LkULY7FobW_x8rMA0E9_ch3ma-OtlAnqPyHoUUJv6HQ&oe=69F0B34B"}, {"file_name": "migrated_image.png", "id": "216891552717005", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/11162678_243960662790390_4422797552932356096_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J_7YV4ibmWEQ7kNvwHo-elY&_nc_oc=AdoXJ82koGzn173kfKgH0HVeRhotiPYWMUtto5ThUqWXOUK3z_mHPP-bHlTzbM-lGFA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af14th-C_aEcloSJDub06tudRMDLJD-c9CW3rgxP26n3fg&oe=69F0BC17"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Thumb_01.png", "id": "120924438518435", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/11162731_120924441851768_1476883766688350208_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z8-7eQcCADwQ7kNvwE1nDTM&_nc_oc=AdqahV3lrrsVSpYv4S7nVEfGeajQ4J1PKgnl69YcTVwebn7yOYPBcjyuHJYYP9_6LgE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Af0cqGL_yxBRc4pKqwKzHAmRoTMoxblQN52s7IXpj_m7ng&oe=69F0AB48"}, "display_name": "Fantasy Pets", "keywords": ["Pet", "Friend", "Cute", "Simulation", "Fantasy"], "long_description": "Learn to take care of your pet, make sure it does not go hungry, and play with toys to keep it entertained! Visit it often and make sure it doesn\u2019t get sick. Don\u2019t worry if it gets dirty playing \u2026 It loves to bathe!\nYou can also shoot some hoops or watch TV while it sleeps or if you need a break.\n\nComplete missions for incredible rewards! With them you\u2019ll unlock new colors, patterns and accessories with which to decorate your pet; funny hats, glasses, and much more!\nDo not miss any opportunity to unlock all the packs and equip your favorite!\n\nWe recommend using headphones.\n\nGame features:\n- Lovely pet with realistic behaviour.\n- Stunning 3D graphics.\n- Different ways to take care of your pet.\n- Growth and evolution of your pet.\n- Beautiful and big environment in which to play with your pet.\n- Lots of variation in pet customization.", "short_description": "Fantasy Pets is a Pet Simulator in which you have to take care of  a cute pet, play with it, customize it and more in a beautiful environment. You\u2019ll start off with an egg, and after hatching it you\u2019ll learn how to take care of your newborn pet.\nThere are differents ways to customize it, from the color and patterns of its skin to accessories that it can wear."}]}, "developer_name": null, "developer_privacy_policy_url": "http://demiumgames.com/privacy.html", "developer_terms_of_service_url": "http://demiumgames.com/privacy.html", "publisher_name": "Pyrolite Games", "support_website_url": null, "website_url": "http://pyrolitegames.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["CASUAL", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1081958082365326"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/11162676_102770777021317_42328147082954
ntent-atl3-3.oculuscdn.com/v/t64.5771-25/11162687_1576552909061927_8565495137164066816_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZIZACjLMLDcQ7kNvwEEaf62&_nc_oc=AdoPnFHFN72FNJYuNgOx9eAk9pWrw5Niy9XhhIeVg0PrNqlUmKpo9oRVJECOU_sHstU&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_Af0suZeBr8t4tEyXWmjt4rtb6eZ1eWme87rjrKGJJ_vQ6g&oe=69F1FBB4"}, {"file_name": "migrated_image.png", "id": "613240785922184", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/11162688_1751178744895757_7937926369982283776_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9ckgzjvC8zkQ7kNvwF_LihK&_nc_oc=Adq-WV8_XKuiFBCU-KawmVfAFnLz19YcoT1-oHP6nbX89ZwZi4jO6rE0bMZxVALCte0&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3lnMKdb5_UTei4oSqKiHLUgRzqjF_szvDpy-T18F9t5Q&oe=69F204CB"}, {"file_name": "migrated_image.png", "id": "216891552717005", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/11162678_243960662790390_4422797552932356096_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J_7YV4ibmWEQ7kNvwFj1esz&_nc_oc=AdqFceJ-XIZymyIi9sh7AAoywd0DI9o_MEmTye3oSkFULwOVy5RhdzJNxJJSXSkvux4&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3QD4rpvuw3fGtLOBriWzf0ToOAVSjsiCy6KqJKuabRyg&oe=69F20D97"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Thumb_01.png", "id": "120924438518435", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/11162731_120924441851768_1476883766688350208_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z8-7eQcCADwQ7kNvwGD60Ui&_nc_oc=AdqzBzhuypcvTjiwUDK0hvG6GyaSp8Nwk_3k9A8DqtoxuNbThFvi3ld1isdzGEisWs8&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_Af3n4hudgxaA3T5tELwswTc86kUhAhtxz9YPLIrHZn81yw&oe=69F1FCC8"}, "display_name": "Fantasy Pets", "keywords": ["Pet", "Friend", "Cute", "Simulation", "Fantasy"], "long_description": "Learn to take care of your pet, make sure it does not go hungry, and play with toys to keep it entertained! Visit it often and make sure it doesn\u2019t get sick. Don\u2019t worry if it gets dirty playing \u2026 It loves to bathe!\nYou can also shoot some hoops or watch TV while it sleeps or if you need a break.\n\nComplete missions for incredible rewards! With them you\u2019ll unlock new colors, patterns and accessories with which to decorate your pet; funny hats, glasses, and much more!\nDo not miss any opportunity to unlock all the packs and equip your favorite!\n\nWe recommend using headphones.\n\nGame features:\n- Lovely pet with realistic behaviour.\n- Stunning 3D graphics.\n- Different ways to take care of your pet.\n- Growth and evolution of your pet.\n- Beautiful and big environment in which to play with your pet.\n- Lots of variation in pet customization.", "short_description": "Fantasy Pets is a Pet Simulator in which you have to take care of  a cute pet, play with it, customize it and more in a beautiful environment. You\u2019ll start off with an egg, and after hatching it you\u2019ll learn how to take care of your newborn pet.\nThere are differents ways to customize it, from the color and patterns of its skin to accessories that it can wear."}]}, "developer_name": null, "developer_privacy_policy_url": "http://demiumgames.com/privacy.html", "developer_terms_of_service_url": "http://demiumgames.com/privacy.html", "publisher_name": "Pyrolite Games", "support_website_url": null, "website_url": "http://pyrolitegames.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["CASUAL", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1081958082365326"}, "review_messages": []}]}, "cover_square_imag
scontent-ord5-1.oculuscdn.com/v/t64.5771-25/11162687_1576552909061927_8565495137164066816_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EGal0ovH5ucQ7kNvwHAdgM9&_nc_oc=AdlV0jwx2T6SToYZU0YyRFKa2uWunO5sslNbf2T4AYBKxf3trTmBfIwmYAuRS727HEQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfxsvGKfyvsRZ5jPdrjDkdjYuY-NeTK3SEhL3oDB1PV2vw&oe=69B94B34"}, {"file_name": "migrated_image.png", "id": "613240785922184", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/11162688_1751178744895757_7937926369982283776_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QKrNw4ovrDQQ7kNvwHDnIGv&_nc_oc=Adm6U-jrFg7J4SKORbH6uGfuNWb-9vq7b1LMpTMl1tjr74AdQRoe-3VujVf10JqvnI4&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfzyaSFbNGuSMvfAIw_yATgMbFo8gvWtWTwioRZyl4E0jA&oe=69B9544B"}, {"file_name": "migrated_image.png", "id": "216891552717005", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/11162678_243960662790390_4422797552932356096_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7Bg9feDYtyYQ7kNvwHCKg3M&_nc_oc=AdmZ_cjSkjluI9Gz_8eeFxKub8k0s2S0wT9P4GNiSUZdxHKIxtfNuVGJP_ptxMnPeug&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfzhtbK2Wj9TwFaFjZg3adnspBmFBWH1fHy6ew_L7s2SKQ&oe=69B95D17"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Thumb_01.png", "id": "120924438518435", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/11162731_120924441851768_1476883766688350208_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lqcVaNPANQkQ7kNvwESP0Yx&_nc_oc=Adkcu8LQv_04G_tt0umSUbfA8Y1bxflQUZzrWkjQckf_lHaZ9E0-QEwATbbm5qF9p38&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfwqNwfzuTi-eScvzFLwSMK8iluJWc3oaI7VpGw2iXACKQ&oe=69B94C48"}, "display_name": "Fantasy Pets", "keywords": ["Pet", "Friend", "Cute", "Simulation", "Fantasy"], "long_description": "Learn to take care of your pet, make sure it does not go hungry, and play with toys to keep it entertained! Visit it often and make sure it doesn\u2019t get sick. Don\u2019t worry if it gets dirty playing \u2026 It loves to bathe!\nYou can also shoot some hoops or watch TV while it sleeps or if you need a break.\n\nComplete missions for incredible rewards! With them you\u2019ll unlock new colors, patterns and accessories with which to decorate your pet; funny hats, glasses, and much more!\nDo not miss any opportunity to unlock all the packs and equip your favorite!\n\nWe recommend using headphones.\n\nGame features:\n- Lovely pet with realistic behaviour.\n- Stunning 3D graphics.\n- Different ways to take care of your pet.\n- Growth and evolution of your pet.\n- Beautiful and big environment in which to play with your pet.\n- Lots of variation in pet customization.", "short_description": "Fantasy Pets is a Pet Simulator in which you have to take care of  a cute pet, play with it, customize it and more in a beautiful environment. You\u2019ll start off with an egg, and after hatching it you\u2019ll learn how to take care of your newborn pet.\nThere are differents ways to customize it, from the color and patterns of its skin to accessories that it can wear."}]}, "developer_name": null, "developer_privacy_policy_url": "http://demiumgames.com/privacy.html", "developer_terms_of_service_url": "http://demiumgames.com/privacy.html", "publisher_name": "Pyrolite Games", "support_website_url": null, "website_url": "http://pyrolitegames.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["CASUAL", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1081958082365326"}, "review_messages": []}]}, "cove
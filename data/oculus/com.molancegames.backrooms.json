01_1042996653844242_7392525691165321008_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=95mB5ggZGHcQ7kNvwG_UR8h&_nc_oc=AdqEfvfstITueS8nNcZJfJNi6plphr3TEV7tG3yizlf0gzFixA2fBKcCErdEzbf4Zkk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6xuQ6sBjAfPX7d4uCMUBUvVZGSk_kEbZy3ToMVY9t7fQ&oe=6A033890"}, {"file_name": "Screenshot11.png", "id": "1590735815120970", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974724_1590735818454303_1237625315298749935_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lm6A6QEGElcQ7kNvwGCqmuL&_nc_oc=AdrrLtzdI-3zJtUIWKaCibR9GHoI___x7PiYNO8elmgJjHLeH4AQ3TmqHXHwn3PXstE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4tm8r-08lkNnrvwJ4tn-a2bPgCxCFvgATqin4I9QRChw&oe=6A033CA0"}, {"file_name": "Screenshot13.png", "id": "4012487288962632", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031382_4012487292295965_8061648437973272149_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UeuemwKKCvMQ7kNvwGatTwx&_nc_oc=AdpNHtdiUHPkLY0WdadhmQsEWcW0WKn3IehmYr8ERF1uufUHE_sWkjZEpX7vPufS-9E&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4i3RBcZDjMIt8Tb0QG33AYqPJEWNtJ5Vu3Y3hn3wHV9g&oe=6A033747"}, {"file_name": "Screenshot01.png", "id": "820837333183123", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974562_820837336516456_225170929614957289_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rCW3ZSbe0ocQ7kNvwG7KTa3&_nc_oc=AdoAbnInbuuWvbp8l_QGPj7zPKQlZMjRlWZvukzcYcAfzs3LeO2R-KSnFUJMzVfZshQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5LozOjAk6m8YgDdJqQQ7W8wL1XwbACTpR8NUG0ASCq-w&oe=6A031B49"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Screenshot03.png", "id": "3817162075231828", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75295751_3817162078565161_5798546731200879339_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OMjcZ_bgVOoQ7kNvwHNF3ba&_nc_oc=AdrZ-CASL-QmL_33nkl-t1i3cOLA92rR8KKGGjoewdQfJBc4IB1vZFkyAZZLT0Q4Xfk&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5xM1em8oVGrSONrxvusTffP_Nl6dgDvev3XflSRaFoLg&oe=6A0318D6"}, "display_name": "Backrooms", "keywords": ["thebackrooms", "noclip", "escape", "horror", "puzzle"], "long_description": "Lose yourself in a world where the ordinary becomes extraordinary. The eerie, sound design and haunting visuals combine to create a sense of dread and isolation. The backrooms are not just a physical maze but a psychological one.\n\nSolve five short puzzles in five levels of the backrooms all while evading the relentless pursuit of lurking entities!\n\nPrepare yourself for an unforgettable journey into the unknown. Can you find your way out, or will you be consumed by the darkness? The only way to know is to step inside and face the horrors that await.", "short_description": "Step into the unsettling world of \"Backrooms\", a short horror-puzzle game that plunges you into the heart of a labyrinthine nightmare!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://molancegames.com/privacy-policy-2/", "developer_terms_of_service_url": null, "publisher_name": "Molance Games", "support_website_url": "https://molancegames.com/contact-us/", "website_url": "https://molancegames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8677833488969981"}, "review_messages": []}]}, "cover_square_image"
812972029630782_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BPrzOfZrarAQ7kNvwEUg4WD&_nc_oc=AdrFVX1eNU1eN8tZMUUSZ5oRXcfM_jwbiWDrvTO0JGlapaQ-ir4Kb1MsixnEpgxMliA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0zRxj2IHrapftx0bQGc6BBQeb3zexTkItgmDVJYwDD8A&oe=69D6343D"}, {"file_name": "Screenshot05.png", "id": "1042996650510909", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75458101_1042996653844242_7392525691165321008_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gFNPLzS76Q8Q7kNvwHI0mhl&_nc_oc=Adoj9qmPv_Lq0ClNNOdnkgKbQHsJrIXl41-gCcrlinDyGyX9saRwz0MmcPBEQdTnF6I&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3gq0TH0bD5fqMS5NSM-4aDlLSomxx_BIbEniMTzpCLoA&oe=69D66590"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Screenshot03.png", "id": "3817162075231828", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75295751_3817162078565161_5798546731200879339_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nas2Eb4-L5gQ7kNvwHb6NY1&_nc_oc=AdqnsPqcGUoItDD8QnhcPfPfprZKHfZOw2tfYfL1-p7Aej_3ES-XTvXOACnQng41p0w&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1lUPhhwbkKvtfQH43Xly5nyskyFUQ7NLzqr_k6k3WQbg&oe=69D645D6"}, "display_name": "Backrooms", "keywords": ["thebackrooms", "noclip", "escape", "horror", "puzzle"], "long_description": "Lose yourself in a world where the ordinary becomes extraordinary. The eerie, sound design and haunting visuals combine to create a sense of dread and isolation. The backrooms are not just a physical maze but a psychological one.\n\nSolve five different puzzles in five levels of the backrooms all while evading the relentless pursuit of lurking entities!\n\nPrepare yourself for an unforgettable journey into the unknown. Can you find your way out, or will you be consumed by the darkness? The only way to know is to step inside and face the horrors that await.", "short_description": "Step into the unsettling world of \"Backrooms\", a short horror-puzzl
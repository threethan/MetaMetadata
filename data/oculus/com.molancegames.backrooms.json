01_1042996653844242_7392525691165321008_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gFNPLzS76Q8Q7kNvwEhVTgJ&_nc_oc=Ado1Uptj0er0ZKg7b9OGIXwFmUkHLg85uH5HLbwADTKE_ua36RuN16BSizEvxe23fSg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1nETY4VZq5N_p6y3rGDLIPvWgCX0KgnxOtxSRC0yNppg&oe=69D90890"}, {"file_name": "Screenshot11.png", "id": "1590735815120970", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974724_1590735818454303_1237625315298749935_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BBYvDPsyBA4Q7kNvwHILHK7&_nc_oc=AdqnFh1by8cC2mYJexrRWqFrzkHfdEU_YF-3VguWhJ-ukZFZq1zffoxoK7htV7shCyM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1fOMEdDLillKguuVvF1xp_MGlF93U3zeRjj12o1e6g8g&oe=69D90CA0"}, {"file_name": "Screenshot13.png", "id": "4012487288962632", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031382_4012487292295965_8061648437973272149_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dtqQKWwdEqwQ7kNvwGwjLHP&_nc_oc=Adqx-3QOJdfhCv41myIchjgU1jl7NAI0qTcAY_Fxb_IEr-GuUBBNHr58BVla3aSF-g8&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af23qZmcRvkGoTjf_aUN-kSrApK1YatvGyR2Tk5f3snYLA&oe=69D90747"}, {"file_name": "Screenshot01.png", "id": "820837333183123", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974562_820837336516456_225170929614957289_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O5th3TyW5lYQ7kNvwGqQSlM&_nc_oc=AdrcC5tsU5dGQ3UUlJ8VoTcza1_vWmlcDywWDgn2a6LH5rMBWVgtJvYlt9cDDhfeDY4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3hl0ymrgsYWTBs_3JLhKtkQB1AuWrqkoU0xvX-z20DUw&oe=69D8EB49"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Screenshot03.png", "id": "3817162075231828", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75295751_3817162078565161_5798546731200879339_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bTVxVEsI9uYQ7kNvwHDMGhQ&_nc_oc=AdpcD0eMW7tQIO-MFXX_dkeRDXRanb3MyGtX1OUIsPejJggTJP_-rqKTvqPNyZpzVq4&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3-EOxYqBYJ7443ZzHpxYmRo2zmnz9bEPoeI9bN5tpOhQ&oe=69D8E8D6"}, "display_name": "Backrooms", "keywords": ["thebackrooms", "noclip", "escape", "horror", "puzzle"], "long_description": "Lose yourself in a world where the ordinary becomes extraordinary. The eerie, sound design and haunting visuals combine to create a sense of dread and isolation. The backrooms are not just a physical maze but a psychological one.\n\nSolve five short puzzles in five levels of the backrooms all while evading the relentless pursuit of lurking entities!\n\nPrepare yourself for an unforgettable journey into the unknown. Can you find your way out, or will you be consumed by the darkness? The only way to know is to step inside and face the horrors that await.", "short_description": "Step into the unsettling world of \"Backrooms\", a short horror-puzzle game that plunges you into the heart of a labyrinthine nightmare!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://molancegames.com/privacy-policy-2/", "developer_terms_of_service_url": null, "publisher_name": "Molance Games", "support_website_url": "https://molancegames.com/contact-us/", "website_url": "https://molancegames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8677833488969981"}, "review_messages": []}]}, "cover_square_image"
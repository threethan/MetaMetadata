01_1042996653844242_7392525691165321008_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TWfJtyC6LIcQ7kNvwFPCxrY&_nc_oc=AdrhSnQbElSHXZL_sm3DL1xyKJlAn57qF5Y9KPVHBl_htLKVpDOwp2vSOdg3Txy2QwM&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7Uua3Crp4xbpONhL5PaHWo1y0ZgLOVYE15x4mwm_Qdxg&oe=6A1AF390"}, {"file_name": "Screenshot11.png", "id": "1590735815120970", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38974724_1590735818454303_1237625315298749935_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jbkbwjQULW8Q7kNvwFO16YW&_nc_oc=AdqjNsTkdBG-KHLb_WViUMm_avwd4D57LtbbI-y0qT99UNll9jIa9L_GzBZJ-uqKJKw&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4R-JyeWqENvMhJLMk-BOG3L5D5Zvg_q8ENornfNiPwCQ&oe=6A1AF7A0"}, {"file_name": "Screenshot13.png", "id": "4012487288962632", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/39031382_4012487292295965_8061648437973272149_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=quEaCkB20a4Q7kNvwEUmFNN&_nc_oc=AdoOAfNqAJG4rrPYwbXsMmzL3gyAk0kgMoh9Ai14yowiRTxebAEbijRHS8XyNt_dZ68&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6fDZttm3fuIYcBWLcTtx1vorFeY62TN5xFc85VwVmO4g&oe=6A1AF247"}, {"file_name": "Screenshot01.png", "id": "820837333183123", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/38974562_820837336516456_225170929614957289_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Pv151poukIsQ7kNvwFjDCY3&_nc_oc=AdpOG6agjk14GqCHyIp-HFO6sxrAGlXQT-8gpmy4Yp4PrpHIcQxJtHuFzOXh8l1wWEg&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4JwjPynsCPATrMwVhnl5ao_O9GgCDHFBLOzfAY1XPJ4A&oe=6A1AD649"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Screenshot03.png", "id": "3817162075231828", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/75295751_3817162078565161_5798546731200879339_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4M3DxmoQvgUQ7kNvwGlX1Qa&_nc_oc=Adrk0DQvvHV_z69MyQfgHCgJblgfnx_0vk_UhIFXg_zYdQb3oedrpDKEpYca1MAw7GI&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5ewp4zSWmy_TZ23bfkAmvhGxjNOw_nVMypzzsc4FQwEw&oe=6A1AD3D6"}, "display_name": "Backrooms", "keywords": ["thebackrooms", "noclip", "escape", "horror", "puzzle"], "long_description": "Lose yourself in a world where the ordinary becomes extraordinary. The eerie, sound design and haunting visuals combine to create a sense of dread and isolation. The backrooms are not just a physical maze but a psychological one.\n\nSolve five short puzzles in five levels of the backrooms all while evading the relentless pursuit of lurking entities!\n\nPrepare yourself for an unforgettable journey into the unknown. Can you find your way out, or will you be consumed by the darkness? The only way to know is to step inside and face the horrors that await.", "short_description": "Step into the unsettling world of \"Backrooms\", a short horror-puzzle game that plunges you into the heart of a labyrinthine nightmare!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://molancegames.com/privacy-policy-2/", "developer_terms_of_service_url": null, "publisher_name": "Molance Games", "support_website_url": "https://molancegames.com/contact-us/", "website_url": "https://molancegames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8677833488969981"}, "review_messages": []}]}, "cover_square_image"
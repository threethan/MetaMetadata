812972029630782_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TgvpIRzt_XkQ7kNvwFkuAsh&_nc_oc=AdqWa8wkztyEuip2Pb6HK_ay4Q0kONpwKjZ9d6G0IEjKuZBvE1KO22gUcomW-SzmK6s&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0yj87NPm1wh3hF3l2vEax4uEMW3DHBEfn531PcPB4AeQ&oe=69F761FD"}, {"file_name": "Screenshot05.png", "id": "1042996650510909", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75458101_1042996653844242_7392525691165321008_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0BVrzTxXgIUQ7kNvwFBKdsQ&_nc_oc=Adp035KXZZyRcKCnGX_-fPN7Q4EDpyIclT76VNwl8qr-H3_2Il-885AxI99O-0I-Taw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3BrmCCsSKs1ZaA5hGfmYLeCO04IZrZRJzTdh7na7Y-6w&oe=69F75B10"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Screenshot03.png", "id": "3817162075231828", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75295751_3817162078565161_5798546731200879339_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Yag7rSNC5IkQ7kNvwGXUgak&_nc_oc=Adpy2S_fTNynQTwnsqJkmKLqQ2JdoHF0fhsgStL9eIHqYxOABDzD63m7SNSsJ5dWCAw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1iI3gWSXFbvYbnw78i9GVBH4fherpZ3-k_1FLBPKNvFA&oe=69F73B56"}, "display_name": "Backrooms", "keywords": ["thebackrooms", "noclip", "escape", "horror", "puzzle"], "long_description": "Lose yourself in a world where the ordinary becomes extraordinary. The eerie, sound design and haunting visuals combine to create a sense of dread and isolation. The backrooms are not just a physical maze but a psychological one.\n\nSolve five different puzzles in five levels of the backrooms all while evading the relentless pursuit of lurking entities!\n\nPrepare yourself for an unforgettable journey into the unknown. Can you find your way out, or will you be consumed by the darkness? The only way to know is to step inside and face the horrors that await.", "short_description": "Step into the unsettling world of \"Backrooms\", a short horror-puzzl
fUbTXsFYbT9ssAWmD_ND6gNTpmULjzjsvlk-HGJoVqL8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfyQ73AoDsZIFn1zyqRHzTsLp6MjdCkgdtq-1G0NuFyzNg&oe=69AC043D"}, {"file_name": "Screenshot05.png", "id": "1042996650510909", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75458101_1042996653844242_7392525691165321008_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eE-5ojdsGAsQ7kNvwF6WVOp&_nc_oc=AdkeflLdNrlN1JT52-tjr5OeMdB6ZgceuKUQSwa9rGlggTD7PmV55TLRpH6YjIcZx2w&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfwvYARfjU3RC8AlWP3wpc_BSZiNLLZJsSnsNBvIaBdp5w&oe=69AC3590"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Screenshot03.png", "id": "3817162075231828", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75295751_3817162078565161_5798546731200879339_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IU79kD5fT88Q7kNvwHEBD_4&_nc_oc=AdkPqdKuqDtI0YITUEMoBTPD9S3Lp2rGddzLV7iyFpehOSq6BvCjmyLGib0iEY0Uo1I&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afyx9EcLHR_a_01jSqmDBmHdjl6wzEtmWzJ-OFr1wtaw8A&oe=69AC15D6"}, "display_name": "Backrooms", "keywords": ["thebackrooms", "noclip", "escape", "horror", "puzzle"], "long_description": "Lose yourself in a world where the ordinary becomes extraordinary. The eerie, sound design and haunting visuals combine to create a sense of dread and isolation. The backrooms are not just a physical maze but a psychological one.\n\nSolve five different puzzles in five levels of the backrooms all while evading the relentless pursuit of lurking entities!\n\nPrepare yourself for an unforgettable journey into the unknown. Can you find your way out, or will you be consumed by the darkness? The only way to know is to step inside and face the horrors that await.", "short_description": "Step into the unsettling world of \"Backrooms\", a short horror-puzzle game that plunges you into the heart of a labyrinthine nightmare!"}]}, "developer_name": null, "developer_privacy_policy_url": "h
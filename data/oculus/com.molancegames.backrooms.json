01_1042996653844242_7392525691165321008_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TWfJtyC6LIcQ7kNvwE8ZiyU&_nc_oc=Ado8ZW5uWBVfuU84a863UVv55hcGXQv6tarVFGlJl7iivb9HqCwECx25um1JcLdmhZE&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7jRfZL4C0m8fteo8Ue9zjynQeB9m7em20SGUycZLvJow&oe=6A1C4510"}, {"file_name": "Screenshot11.png", "id": "1590735815120970", "uri": "https://scontent-lhr8-2.oculuscdn.com/v/t64.5771-25/38974724_1590735818454303_1237625315298749935_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jbkbwjQULW8Q7kNvwFSocwv&_nc_oc=AdqbkKA1FF0pChUcRe3rX5aZhFt_9BeYpNEPH_5VWP-Vs92Gs802bGFEHom0D5p6WDA&_nc_zt=3&_nc_ht=scontent-lhr8-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7Blu61Aqdw9JQ4q8v8Vuns6P5BopirVYedtTAzEa-V_w&oe=6A1C4920"}, {"file_name": "Screenshot13.png", "id": "4012487288962632", "uri": "https://scontent-lhr8-2.oculuscdn.com/v/t64.5771-25/39031382_4012487292295965_8061648437973272149_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=quEaCkB20a4Q7kNvwHQx18R&_nc_oc=AdoE4Ntn8F6Y3le1mu8hdzqRnLfvF4oeoycP5HN3rtMXhgxqOZokZ8E5o6XerkmI1cw&_nc_zt=3&_nc_ht=scontent-lhr8-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4YhlazBZmPnnFH91OWbuYLCw9aNv78ZqNPncfdqOgydw&oe=6A1C43C7"}, {"file_name": "Screenshot01.png", "id": "820837333183123", "uri": "https://scontent-lhr8-1.oculuscdn.com/v/t64.5771-25/38974562_820837336516456_225170929614957289_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nwbtOAxwF9YQ7kNvwFEa-zn&_nc_oc=AdpifJVlF5rjut-nthWRiduyBH6wKlEOQeUx5vCChocE5WK5vs6FwCeLrEM3vlxGZxQ&_nc_zt=3&_nc_ht=scontent-lhr8-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6LFWTLkVqChxNU3oL4O5smRl_hlh3QoVgdwB7MQmZRiw&oe=6A1C27C9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Screenshot03.png", "id": "3817162075231828", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/75295751_3817162078565161_5798546731200879339_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BJl0rl9SnVMQ7kNvwGInnGN&_nc_oc=AdqTD0kd07y4Ycq3mETkUM0p018cWjja6VzXa3K86iMqCMMVrHd20KhhWotqBrOjrpw&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4amp_IYQTAnH_Y3CQ71TAB11OoeJYBcxCdk5sjacmrkw&oe=6A1C5D96"}, "display_name": "Backrooms", "keywords": ["thebackrooms", "noclip", "escape", "horror", "puzzle"], "long_description": "Lose yourself in a world where the ordinary becomes extraordinary. The eerie, sound design and haunting visuals combine to create a sense of dread and isolation. The backrooms are not just a physical maze but a psychological one.\n\nSolve five short puzzles in five levels of the backrooms all while evading the relentless pursuit of lurking entities!\n\nPrepare yourself for an unforgettable journey into the unknown. Can you find your way out, or will you be consumed by the darkness? The only way to know is to step inside and face the horrors that await.", "short_description": "Step into the unsettling world of \"Backrooms\", a short horror-puzzle game that plunges you into the heart of a labyrinthine nightmare!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://molancegames.com/privacy-policy-2/", "developer_terms_of_service_url": null, "publisher_name": "Molance Games", "support_website_url": "https://molancegames.com/contact-us/", "website_url": "https://molancegames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8677833488969981"}, "review_messages": []}]}, "cover_square_image"
01_1042996653844242_7392525691165321008_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5_AwEDc_iLQQ7kNvwFH6YW1&_nc_oc=AdqiuqiGedOXvFtY6LS9fcEbx4279BQ5tkzjpGnJfx8XdmMfrhvntEqJhd2JtiM15fc&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0Ma9J3VNR1e5VQc1OoablE06_LZZ4rsYJR-oYIEGsdCw&oe=69EF7210"}, {"file_name": "Screenshot11.png", "id": "1590735815120970", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974724_1590735818454303_1237625315298749935_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TCCwq5N1vpsQ7kNvwFA9Kjz&_nc_oc=AdqM9tl4wbjK3fQ90Sqg0u2Pd9HCFMwJ7sF8MhH9U4K1o5APE_-LnG-6cZLY75hqjAQ&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2dPmuq_yryRJzwbgX1soxSPBb9072xRMWDM75uN-iV_w&oe=69EF7620"}, {"file_name": "Screenshot13.png", "id": "4012487288962632", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39031382_4012487292295965_8061648437973272149_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qJnI8-coBScQ7kNvwGclsLj&_nc_oc=AdpnwBoP7aHP9LiraR7aPJjHDnErxuVvCY76SI4Y8mq6DG8Xyk4GNak1fhzg9yhj8vA&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af14lFEB6FcvZh8_5iPK6FgqEawKB4HxytPzEkBlkZYooA&oe=69EF70C7"}, {"file_name": "Screenshot01.png", "id": "820837333183123", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974562_820837336516456_225170929614957289_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7Se6Zu3z-xoQ7kNvwGlsEJq&_nc_oc=AdoyOTplXrV8WFRt0EInRLLHQb3R_Bp3xAA7XhV9Xb5KflPsfMmNmuZ3QqNORJBF8-c&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af35VR2YydM5VgFNEF20rHAbQLEdJFqJ-A8DmqGsabf0xg&oe=69EF54C9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Screenshot03.png", "id": "3817162075231828", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/75295751_3817162078565161_5798546731200879339_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w_Y7WT3mIvYQ7kNvwFNkQvT&_nc_oc=AdrfAcCHEDMJZuTX0fHyin7CYv2EEiz8HLuF6a5ujvfDwEZxvS4g2OVJfTcp6Nz-dMY&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2GUEefvI4StwSP8khMmi0bVo7ELDr3T2D1TSS0gmcATA&oe=69EF5256"}, "display_name": "Backrooms", "keywords": ["thebackrooms", "noclip", "escape", "horror", "puzzle"], "long_description": "Lose yourself in a world where the ordinary becomes extraordinary. The eerie, sound design and haunting visuals combine to create a sense of dread and isolation. The backrooms are not just a physical maze but a psychological one.\n\nSolve five short puzzles in five levels of the backrooms all while evading the relentless pursuit of lurking entities!\n\nPrepare yourself for an unforgettable journey into the unknown. Can you find your way out, or will you be consumed by the darkness? The only way to know is to step inside and face the horrors that await.", "short_description": "Step into the unsettling world of \"Backrooms\", a short horror-puzzle game that plunges you into the heart of a labyrinthine nightmare!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://molancegames.com/privacy-policy-2/", "developer_terms_of_service_url": null, "publisher_name": "Molance Games", "support_website_url": "https://molancegames.com/contact-us/", "website_url": "https://molancegames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8677833488969981"}, "review_messages": []}]}, "cover_square_image"
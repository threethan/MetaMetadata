812972029630782_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZUwrYvqd-OUQ7kNvwEgJKje&_nc_oc=Adq83i34VgQBT9svwzISciMgvoAes8SQc0mMxXIdAPx2g-9dw_sLj0Mg4g8en2Q_P-I&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2alhRUmC6slzvmY_s2yIVCHjk_hSPeP6ZNNw1zA57xMw&oe=69E78FFD"}, {"file_name": "Screenshot05.png", "id": "1042996650510909", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/75458101_1042996653844242_7392525691165321008_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RdH1gqW5VlkQ7kNvwGeVwZO&_nc_oc=AdoXs5l6PMD8NmhUMgs6jzss8mKmYmlJP2yrCZ_3O3W9e6oenTUeBAJZt7ScCsEy2DY&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2cX7X8FLEg9EMFQjv7d-P5NnzUMzPTV3h9SUWoLC2r5g&oe=69E78910"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Screenshot03.png", "id": "3817162075231828", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/75295751_3817162078565161_5798546731200879339_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7mUpC_Xtmw4Q7kNvwG17Zre&_nc_oc=Adptc5gXORznp6Soip94wq5xfgJe4njgkrA4rucEwnW2Lu8lqbexEWv7Ll6Stg4QN1s&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1X_6XCwG6K7IIFb6hhaTfqTq_dUSpgvUuIg6kULOg7Bw&oe=69E76956"}, "display_name": "Backrooms", "keywords": ["thebackrooms", "noclip", "escape", "horror", "puzzle"], "long_description": "Lose yourself in a world where the ordinary becomes extraordinary. The eerie, sound design and haunting visuals combine to create a sense of dread and isolation. The backrooms are not just a physical maze but a psychological one.\n\nSolve five different puzzles in five levels of the backrooms all while evading the relentless pursuit of lurking entities!\n\nPrepare yourself for an unforgettable journey into the unknown. Can you find your way out, or will you be consumed by the darkness? The only way to know is to step inside and face the horrors that await.", "short_description": "Step into the unsettling world of \"Backrooms\", a short horror-puzzl
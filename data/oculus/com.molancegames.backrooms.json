01_1042996653844242_7392525691165321008_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9Up18mpGvuoQ7kNvwGUw67S&_nc_oc=AdrNOwQKcx4c114PHzuuYx8_7XA-sOlgoQd-4inTrGghNfrvatXfUFTygQoWfYX-SAQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0eZ2WrnEJBPb-eP7VfboLi1Tu_7zASeLMkqGdE3-HHtA&oe=69E0F190"}, {"file_name": "Screenshot11.png", "id": "1590735815120970", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974724_1590735818454303_1237625315298749935_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BLEz57nC3GAQ7kNvwFzkuoz&_nc_oc=AdoCrJLk1Oav82cqXMIt0qhkdY5fVH4tqaEqdFSXP_IJmrAvJOaS_9O3hcfVpp8oPsA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0WU_S_X_Ghxho-aZ4YZD3sir5rfIuq94-uebzpktrArw&oe=69E0F5A0"}, {"file_name": "Screenshot13.png", "id": "4012487288962632", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031382_4012487292295965_8061648437973272149_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BGNoUWIL8ZQQ7kNvwHoHkEv&_nc_oc=AdqUwVExv3ocWd84LNNdu3Ljt_PL4lq0CSt3FJVJgqfTtCOfvm1W6N6bxTLfR3p5r9E&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0qyQmUrjb0GoTSy7oxuXBnBxXwHYfGj7QUja0Hs76VHQ&oe=69E0F047"}, {"file_name": "Screenshot01.png", "id": "820837333183123", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974562_820837336516456_225170929614957289_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3UKF09o7WLIQ7kNvwEdRkv-&_nc_oc=AdrIxyZV1E3g4alcjMR_SNMpbF86AaiztiWarP0iOi1lOG3rlvM_FKUOUqDbYVhWyqk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3wvstoP64QGzoPnfKwf-bKIlo2rr32l1yGnRw0vcbBKg&oe=69E0D449"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Screenshot03.png", "id": "3817162075231828", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75295751_3817162078565161_5798546731200879339_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=db8FcFAla8QQ7kNvwGtrRAm&_nc_oc=AdqtlXdqJjKdM9wlqEI3Sq6O6zz--48rcZy9ElCfmS6gevGiAUqgzckg0SYm4gTYzNg&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3-ErVkJ0sL-cDdcvt9HkIMroAQ3ctLjO8SR2GlLy2obA&oe=69E0D1D6"}, "display_name": "Backrooms", "keywords": ["thebackrooms", "noclip", "escape", "horror", "puzzle"], "long_description": "Lose yourself in a world where the ordinary becomes extraordinary. The eerie, sound design and haunting visuals combine to create a sense of dread and isolation. The backrooms are not just a physical maze but a psychological one.\n\nSolve five short puzzles in five levels of the backrooms all while evading the relentless pursuit of lurking entities!\n\nPrepare yourself for an unforgettable journey into the unknown. Can you find your way out, or will you be consumed by the darkness? The only way to know is to step inside and face the horrors that await.", "short_description": "Step into the unsettling world of \"Backrooms\", a short horror-puzzle game that plunges you into the heart of a labyrinthine nightmare!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://molancegames.com/privacy-policy-2/", "developer_terms_of_service_url": null, "publisher_name": "Molance Games", "support_website_url": "https://molancegames.com/contact-us/", "website_url": "https://molancegames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8677833488969981"}, "review_messages": []}]}, "cover_square_image"
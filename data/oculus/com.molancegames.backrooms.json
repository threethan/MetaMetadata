01_1042996653844242_7392525691165321008_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=95mB5ggZGHcQ7kNvwGA_EUG&_nc_oc=AdrW-kCQaZgkbE3g3h0Dk9o2z8EIeDbOwNn7tytvKBtOm4I9sFSujTyz1TAwYvU8OOY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5g9u1W-iP94sB8dumVsYABAFH30Sh-BwQYO-T3z6x9Hg&oe=6A01E710"}, {"file_name": "Screenshot11.png", "id": "1590735815120970", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974724_1590735818454303_1237625315298749935_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J6agqfNRGCIQ7kNvwHRWT8D&_nc_oc=AdqV3mITq8tZBqFXZLVL9fKD2HL1s7vmJDGUR1h25p8fy3ichhtE17_RutdbJSshYDk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4P7_j4TgMc9KkG5bn0BOPAOo7w_GMVT7DvzqpBIJqAiQ&oe=6A01EB20"}, {"file_name": "Screenshot13.png", "id": "4012487288962632", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031382_4012487292295965_8061648437973272149_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WxH829IeXHAQ7kNvwFwpYmB&_nc_oc=Adru5X6S29R1YScqP2ImjEIbzX_eBpJBYU1yatzJIjE72QSAiAqNjRePU_4fNRm6UWE&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5J6-FsWApSNsfonbB0CjcCmpZP9BKNZAzMoWtCncNWrA&oe=6A01E5C7"}, {"file_name": "Screenshot01.png", "id": "820837333183123", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974562_820837336516456_225170929614957289_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rCW3ZSbe0ocQ7kNvwFdsIXc&_nc_oc=AdrkFXLBJNaiV8IpCBeO87YmlTC4MBaZinkS-Dx6wQd_vfPsf02QaGbGOvwFzVWTAVg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4Q3fQ8_Z2hhR__p7o6GRRN3jasSIRqS_uzR9ZATFmzsw&oe=6A01C9C9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Screenshot03.png", "id": "3817162075231828", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75295751_3817162078565161_5798546731200879339_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OMjcZ_bgVOoQ7kNvwH7gIds&_nc_oc=AdrTvNN1m-f6cxQ0Vq4VnB-Fck0gwCrqfcFu1MJZxDLiARGsatAc8X6cZ25vhtsezlk&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af55qrnEEZW-mFyyw5ZNB_YXh33ueYGRv0uhKZsA-XKH_A&oe=6A01C756"}, "display_name": "Backrooms", "keywords": ["thebackrooms", "noclip", "escape", "horror", "puzzle"], "long_description": "Lose yourself in a world where the ordinary becomes extraordinary. The eerie, sound design and haunting visuals combine to create a sense of dread and isolation. The backrooms are not just a physical maze but a psychological one.\n\nSolve five short puzzles in five levels of the backrooms all while evading the relentless pursuit of lurking entities!\n\nPrepare yourself for an unforgettable journey into the unknown. Can you find your way out, or will you be consumed by the darkness? The only way to know is to step inside and face the horrors that await.", "short_description": "Step into the unsettling world of \"Backrooms\", a short horror-puzzle game that plunges you into the heart of a labyrinthine nightmare!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://molancegames.com/privacy-policy-2/", "developer_terms_of_service_url": null, "publisher_name": "Molance Games", "support_website_url": "https://molancegames.com/contact-us/", "website_url": "https://molancegames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8677833488969981"}, "review_messages": []}]}, "cover_square_image"
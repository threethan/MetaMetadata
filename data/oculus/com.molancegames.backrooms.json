01_1042996653844242_7392525691165321008_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZItSxyS-E1wQ7kNvwEW69DF&_nc_oc=Ador5X7D1OYSExEmsZzdHbh2NlnqI-ofTm6kJVS7vc0_wT1v6_uLbqXtHU_-HB0tiRo&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7jMbaodA_AQ6bJaY8NqUVZar1JMv07-qelDKgNOCkXqg&oe=6A0C7310"}, {"file_name": "Screenshot11.png", "id": "1590735815120970", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38974724_1590735818454303_1237625315298749935_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lHniJEmJ7mYQ7kNvwGEolYH&_nc_oc=AdrHbb3XMTHXhee9nmACa_-GC-uMPwNeIsi4rUKtZ5Jt_QswT0VwKnbMgtoFIk5QIfU&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4O69y5-NZYDEN7Lup4yzvApQvZcjlhFEYZQliM6xw66w&oe=6A0C7720"}, {"file_name": "Screenshot13.png", "id": "4012487288962632", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/39031382_4012487292295965_8061648437973272149_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LKoAFEPcv1QQ7kNvwGY_oL_&_nc_oc=AdrvlN1tbsYrs8szjVeD1DNxPIxw4-CrkHIbOyUzjYMMHhu4HPWAM_7nhwU50FnnIyw&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7rh-jrKU2ntzKHnvu6dC3YwmjWAaUq1iyepLiqN_BRsA&oe=6A0C71C7"}, {"file_name": "Screenshot01.png", "id": "820837333183123", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38974562_820837336516456_225170929614957289_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=grxmOebjBd4Q7kNvwHuU6CJ&_nc_oc=Adq_iFMtDhf4FL6AXNin4EnZkoZg1fDrWODS_m2ke1wjey17lgVOXtKr8ydsHE5yL38&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6Ok-i8KytP8b39baE4w97Wa4mhFRX9_rsQn5jd3Vd2jw&oe=6A0C55C9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Screenshot03.png", "id": "3817162075231828", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/75295751_3817162078565161_5798546731200879339_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RQqTbVapjFcQ7kNvwEVFBYB&_nc_oc=AdpSr9QbmMjmHoAPl8c7--tRH_oSYHQcV138MkdK0f2o8-OHFuMvCTZk1Q5JoHDkzxk&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5jrGv6oaJpKwWY7f3psOv94F9x1R-B2_UOWn8WUe1RuQ&oe=6A0C8B96"}, "display_name": "Backrooms", "keywords": ["thebackrooms", "noclip", "escape", "horror", "puzzle"], "long_description": "Lose yourself in a world where the ordinary becomes extraordinary. The eerie, sound design and haunting visuals combine to create a sense of dread and isolation. The backrooms are not just a physical maze but a psychological one.\n\nSolve five short puzzles in five levels of the backrooms all while evading the relentless pursuit of lurking entities!\n\nPrepare yourself for an unforgettable journey into the unknown. Can you find your way out, or will you be consumed by the darkness? The only way to know is to step inside and face the horrors that await.", "short_description": "Step into the unsettling world of \"Backrooms\", a short horror-puzzle game that plunges you into the heart of a labyrinthine nightmare!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://molancegames.com/privacy-policy-2/", "developer_terms_of_service_url": null, "publisher_name": "Molance Games", "support_website_url": "https://molancegames.com/contact-us/", "website_url": "https://molancegames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8677833488969981"}, "review_messages": []}]}, "cover_square_image"
01_1042996653844242_7392525691165321008_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PUUJ0nRiTnkQ7kNvwE2mDRX&_nc_oc=AdrZavDITIJ3nEJiOp75MOfDxQ-PLap6o46VX34PWxI6KsjplMPeEPArR4HssgSlujE&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1Z5UF76QZHHEx1pwYzY3KFhiJSHD82Yd9Y2K7eP8uFRA&oe=69F36690"}, {"file_name": "Screenshot11.png", "id": "1590735815120970", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974724_1590735818454303_1237625315298749935_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BLGpaC3XN0sQ7kNvwG7luo5&_nc_oc=AdpDpnx9jZkR1aKqVHeqoA9ggcLGsII7MTLIblfMcEgIY7_tlgBz0P7D5B4cqXa5VQY&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0R968IsS4KWncTBFdlwYH6iqmZlEBEZWXA1Y9qvLujBQ&oe=69F36AA0"}, {"file_name": "Screenshot13.png", "id": "4012487288962632", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39031382_4012487292295965_8061648437973272149_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lLOTyX_iGicQ7kNvwGOiR2W&_nc_oc=AdrAogPclsm6y2erli6g9hwyHbMR0GkgFHlQHoyjMP7d0yM_bgKtiUlgHWD1Wg68U_c&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3urK_yFiexX6Q0UFxJogwrG3sgT3jpH3ds0JNp3cDv5w&oe=69F36547"}, {"file_name": "Screenshot01.png", "id": "820837333183123", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974562_820837336516456_225170929614957289_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I34JbTXT6q8Q7kNvwH5rRdo&_nc_oc=AdoDnwjKBOCZ_mZI8GvoTlz1XXQgiUH5NpP3AG5ZKi17uWbLn73QCIpOU8dPtjfjIPU&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3f3FpdrSRQFEKSdV39iYrurbaTmWlNXDT0z3n-dBFKsA&oe=69F34949"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Screenshot03.png", "id": "3817162075231828", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/75295751_3817162078565161_5798546731200879339_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a-0bELR0490Q7kNvwFByJkj&_nc_oc=AdpC3RMACBm4C9CFGo1EokTsdei7GeOm6_yZSA7XrmBKOL4wgJ1v4EGUqjReMHbSu3U&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0wq_nHSL8aplOwx2EC6c0lVmF-yxWUhVK-i-XZKmLL0w&oe=69F346D6"}, "display_name": "Backrooms", "keywords": ["thebackrooms", "noclip", "escape", "horror", "puzzle"], "long_description": "Lose yourself in a world where the ordinary becomes extraordinary. The eerie, sound design and haunting visuals combine to create a sense of dread and isolation. The backrooms are not just a physical maze but a psychological one.\n\nSolve five short puzzles in five levels of the backrooms all while evading the relentless pursuit of lurking entities!\n\nPrepare yourself for an unforgettable journey into the unknown. Can you find your way out, or will you be consumed by the darkness? The only way to know is to step inside and face the horrors that await.", "short_description": "Step into the unsettling world of \"Backrooms\", a short horror-puzzle game that plunges you into the heart of a labyrinthine nightmare!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://molancegames.com/privacy-policy-2/", "developer_terms_of_service_url": null, "publisher_name": "Molance Games", "support_website_url": "https://molancegames.com/contact-us/", "website_url": "https://molancegames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8677833488969981"}, "review_messages": []}]}, "cover_square_image"
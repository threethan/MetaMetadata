812972029630782_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c8YeHqHROr8Q7kNvwGgg4JX&_nc_oc=Ado8eeg8Y60b4Nx0GkLF7F2nHUNyQMEzyKPsKpg01fmZWL6MLfyqPtjSFDXcoNZupkc&_nc_zt=3&_nc_ht=scontent-lhr8-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2KNTMj1WDhFEsiOgZEe1Oflv9Hnnhky5q6W2ObUTgh4w&oe=69E249FD"}, {"file_name": "Screenshot05.png", "id": "1042996650510909", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/75458101_1042996653844242_7392525691165321008_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jdzLAlCP2h4Q7kNvwFXP04-&_nc_oc=AdoPgTBfflJn_Vmf0HspkfLISHKYNmj0L5wrcOOLHovprOlZLz0VFGznLjYDsnqvQ7M&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0wFN_62mPQ0I-oZj5hlDV7G6PM2k1BE9qD5fhJIW-BuQ&oe=69E24310"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Screenshot03.png", "id": "3817162075231828", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/75295751_3817162078565161_5798546731200879339_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=db8FcFAla8QQ7kNvwHWZr3T&_nc_oc=AdoqREc5mvxEiH5XWzA4z730N0UHHj5Q-UHO-Y9gNPtBmOYFPIOlMOhKIxPFbZZP-qI&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0YEyZpBLSgQfC86L7vyBh506kzIYgyoT5snMDLgDkP5w&oe=69E22356"}, "display_name": "Backrooms", "keywords": ["thebackrooms", "noclip", "escape", "horror", "puzzle"], "long_description": "Lose yourself in a world where the ordinary becomes extraordinary. The eerie, sound design and haunting visuals combine to create a sense of dread and isolation. The backrooms are not just a physical maze but a psychological one.\n\nSolve five different puzzles in five levels of the backrooms all while evading the relentless pursuit of lurking entities!\n\nPrepare yourself for an unforgettable journey into the unknown. Can you find your way out, or will you be consumed by the darkness? The only way to know is to step inside and face the horrors that await.", "short_description": "Step into the unsettling world of \"Backrooms\", a short horror-puzzl
01_1042996653844242_7392525691165321008_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0BVrzTxXgIUQ7kNvwECrE1I&_nc_oc=AdrbhNjgX9QXbiCZukT3Ytj-MI5l9ydFCpz3dEBs7971rOMs9R3w3Y77Xp5nGQKjqRA&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af21BeVnmXVgDpc4f7op5gcUF6qNeHzAImM892mNDffHIA&oe=69F8AC90"}, {"file_name": "Screenshot11.png", "id": "1590735815120970", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974724_1590735818454303_1237625315298749935_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ryno8uJA7rkQ7kNvwGMozp9&_nc_oc=AdpCUs_XHVQvmZygEqsXroIWonIc6kPH2PERBtpjsp-6rGQyKKxmCHJZMc0J1Hc7SXw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af30WzdDtOOLfiElJQLBc3261qt_NN5PBBTLBMF5B_KGYA&oe=69F8B0A0"}, {"file_name": "Screenshot13.png", "id": "4012487288962632", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39031382_4012487292295965_8061648437973272149_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=thg5n9D_AeMQ7kNvwEMQcGg&_nc_oc=AdqpJY7Hp6ued3iagJdm9eyQTKl0ON3b7DYV_C_vBVYTVbrGVc4ZdCezzmjG94XXUvQ&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af17iuvEgk1Hw3mSk85pynxWQiZBUN6xwWIDW8LSKbTPrg&oe=69F8AB47"}, {"file_name": "Screenshot01.png", "id": "820837333183123", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974562_820837336516456_225170929614957289_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J9pBfl1kBj4Q7kNvwFFebe6&_nc_oc=AdqJJG3-hIVWN6vwwH59E0StKu1gjmOMKP6YBH8Z0noYprQ7WtJoqCIBvQskeRTiWGM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3g1_0-jD_4zApKX8YhkU8ZeuCP4UBng5nEJw67EBdNUA&oe=69F88F49"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Screenshot03.png", "id": "3817162075231828", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75295751_3817162078565161_5798546731200879339_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DfIPKo3F8KYQ7kNvwFrDbm4&_nc_oc=Ado_zQzcAME86Apmd4rHKDa4NdNp80pMJ7a2uIIiO8h_35urO4pHXCJ_butA1FW4Lrc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0OMV79TJesIGcGT7VLjz_XfQfizj4O96zZG4lCXUfbGw&oe=69F88CD6"}, "display_name": "Backrooms", "keywords": ["thebackrooms", "noclip", "escape", "horror", "puzzle"], "long_description": "Lose yourself in a world where the ordinary becomes extraordinary. The eerie, sound design and haunting visuals combine to create a sense of dread and isolation. The backrooms are not just a physical maze but a psychological one.\n\nSolve five short puzzles in five levels of the backrooms all while evading the relentless pursuit of lurking entities!\n\nPrepare yourself for an unforgettable journey into the unknown. Can you find your way out, or will you be consumed by the darkness? The only way to know is to step inside and face the horrors that await.", "short_description": "Step into the unsettling world of \"Backrooms\", a short horror-puzzle game that plunges you into the heart of a labyrinthine nightmare!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://molancegames.com/privacy-policy-2/", "developer_terms_of_service_url": null, "publisher_name": "Molance Games", "support_website_url": "https://molancegames.com/contact-us/", "website_url": "https://molancegames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8677833488969981"}, "review_messages": []}]}, "cover_square_image"
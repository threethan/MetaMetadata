01_1042996653844242_7392525691165321008_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oG8PI8UgFUMQ7kNvwEY7FRw&_nc_oc=Adrxjoyf5c3WEqfpr_KHMfDRzsSOSL3MPgX1EEgDS5MzZyo0Sb0Ka6ifwnCGQcuWoGk&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5saF-CVymAF-owMjemlCqjgky7-8UlDTUPVS3Ty0Eu6g&oe=6A0F1610"}, {"file_name": "Screenshot11.png", "id": "1590735815120970", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974724_1590735818454303_1237625315298749935_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=px7LEFmn3gsQ7kNvwF8IEfP&_nc_oc=Adq7zNOSXJPKADv8TQol2uV3wSos2LXNbWWfA1yOC2yG3XkqH4BgYPs5yKlW5iFAfLI&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6daG8JfM9GAoWHWLMnZ82X61prAMr0aygiDoyAgzy_WA&oe=6A0F1A20"}, {"file_name": "Screenshot13.png", "id": "4012487288962632", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39031382_4012487292295965_8061648437973272149_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9pfgEV5Z1rwQ7kNvwFjra9I&_nc_oc=AdrGE7Os-AkdiqEjxZGwxTOGoow4MEIb4DoJVrMawtcvVj3CrbqwhDfJMQiRdhckAcg&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4TMKgEquT3nSbzs8WBNfmb0D6IPNjMYHt9QlEa3ldj9w&oe=6A0F14C7"}, {"file_name": "Screenshot01.png", "id": "820837333183123", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974562_820837336516456_225170929614957289_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=grxmOebjBd4Q7kNvwE2kYB3&_nc_oc=AdrewCrmtqWT5ocLpWdF1wcua49NgJtXlYf6DryBHFuWG53mdbFmz1OYp0yWkoNHx5A&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6_BFM8yRnJ4dUYXTq6g4miaihaLDEHHUYHeFoJVU4swQ&oe=6A0EF8C9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Screenshot03.png", "id": "3817162075231828", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/75295751_3817162078565161_5798546731200879339_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RQqTbVapjFcQ7kNvwHPVVxE&_nc_oc=AdpdQ3Y7F3VkQ__IBMrphLKWw7prUL3f7lY_x8WxnknWCg11sBWIqO2dbf9WinvOb3w&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6HytMGS4VVIISO-m21VQxHt2oDZ1WCamBYSVIZUMWftQ&oe=6A0EF656"}, "display_name": "Backrooms", "keywords": ["thebackrooms", "noclip", "escape", "horror", "puzzle"], "long_description": "Lose yourself in a world where the ordinary becomes extraordinary. The eerie, sound design and haunting visuals combine to create a sense of dread and isolation. The backrooms are not just a physical maze but a psychological one.\n\nSolve five short puzzles in five levels of the backrooms all while evading the relentless pursuit of lurking entities!\n\nPrepare yourself for an unforgettable journey into the unknown. Can you find your way out, or will you be consumed by the darkness? The only way to know is to step inside and face the horrors that await.", "short_description": "Step into the unsettling world of \"Backrooms\", a short horror-puzzle game that plunges you into the heart of a labyrinthine nightmare!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://molancegames.com/privacy-policy-2/", "developer_terms_of_service_url": null, "publisher_name": "Molance Games", "support_website_url": "https://molancegames.com/contact-us/", "website_url": "https://molancegames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8677833488969981"}, "review_messages": []}]}, "cover_square_image"
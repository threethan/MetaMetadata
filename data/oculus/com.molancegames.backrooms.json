812972029630782_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SK-ulTXdQvEQ7kNvwFXA7r9&_nc_oc=AdofUaw_GYqpr5Wh8hsw20Sa5Bk84b6loI086OeklpANBsbGQmk-n4LrJ6ydDfOoccQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2XbyNvpwtTLtcTvLmz7cBv5u6thMmGqkYVNxHd-ns_Ew&oe=69ECD5FD"}, {"file_name": "Screenshot05.png", "id": "1042996650510909", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75458101_1042996653844242_7392525691165321008_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AdNEj3010WAQ7kNvwEDqjSb&_nc_oc=AdqiDbinn0qMbR_cVmbbqBPDggvNqVEbNLiWos4_GBewX36gIlymuzfT2y0caCMMJLg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1OL8qgI4PmVMEXZK7xDos3LredRjYpHzjLXkKsWfMXqA&oe=69ECCF10"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Screenshot03.png", "id": "3817162075231828", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75295751_3817162078565161_5798546731200879339_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w_Y7WT3mIvYQ7kNvwFu75sP&_nc_oc=AdojNAFP72hrTp00BhUgCPdUyPClPgxMtGI9Iu6ZcT1IenYLW5syFsG9rixqs4pNfPY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3cCv8TNQAj1mnceVw24zuiqDcMVwbcpKg6BpCXu_b65Q&oe=69ECAF56"}, "display_name": "Backrooms", "keywords": ["thebackrooms", "noclip", "escape", "horror", "puzzle"], "long_description": "Lose yourself in a world where the ordinary becomes extraordinary. The eerie, sound design and haunting visuals combine to create a sense of dread and isolation. The backrooms are not just a physical maze but a psychological one.\n\nSolve five different puzzles in five levels of the backrooms all while evading the relentless pursuit of lurking entities!\n\nPrepare yourself for an unforgettable journey into the unknown. Can you find your way out, or will you be consumed by the darkness? The only way to know is to step inside and face the horrors that await.", "short_description": "Step into the unsettling world of \"Backrooms\", a short horror-puzzl
812972029630782_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rDAut7qgbHEQ7kNvwFSkuaq&_nc_oc=AdoN3Sx82dNe0FQZ_i9kvIeYENItl1EQDS9YeuqL4hfvsRo1iUAeyfgE9h18Ly9zLwg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6el61J3t65v7Z51Pe1939OJ2QodM9U-FsgLQVPkWFMOg&oe=6A08857D"}, {"file_name": "Screenshot05.png", "id": "1042996650510909", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75458101_1042996653844242_7392525691165321008_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9agiYm7lFLEQ7kNvwEi3zpx&_nc_oc=Adq0pDfOL4TZP6W2zHbSU1UfMW-Cuz_Ky3cvzbyJxs4iLK1yVaS1mNNtETkigDqUbQI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4knT79xUe1Yw5Oxyg6Qhsccmlb_aU1Ds2DYno3n4e7OA&oe=6A087E90"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Screenshot03.png", "id": "3817162075231828", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75295751_3817162078565161_5798546731200879339_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ah-Nzek8lzkQ7kNvwGmhWkj&_nc_oc=Adpb9vB0HvsuSgGa6z2sVQ20HYHS38MdA237rW3x2QnfRUh6SR_iggLBDoAjmRZAfI0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4Sp1YmTk-lzWqguEz5yQ9lWtVEkPy6K1R_g-xaYMTYlA&oe=6A089716"}, "display_name": "Backrooms", "keywords": ["thebackrooms", "noclip", "escape", "horror", "puzzle"], "long_description": "Lose yourself in a world where the ordinary becomes extraordinary. The eerie, sound design and haunting visuals combine to create a sense of dread and isolation. The backrooms are not just a physical maze but a psychological one.\n\nSolve five different puzzles in five levels of the backrooms all while evading the relentless pursuit of lurking entities!\n\nPrepare yourself for an unforgettable journey into the unknown. Can you find your way out, or will you be consumed by the darkness? The only way to know is to step inside and face the horrors that await.", "short_description": "Step into the unsettling world of \"Backrooms\", a short horror-puzzl
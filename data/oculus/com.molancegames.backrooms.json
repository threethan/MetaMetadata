01_1042996653844242_7392525691165321008_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gawxgVVPRJ8Q7kNvwGbOiGj&_nc_oc=Adr32EYD4KSofsa8BqQrSUoA-XNvZaDRipZYxT4APN__W-RhpPtiqAWH2RqlzyIeeGg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxHW3GdXdgioCTVBcw-7XdPfe5riIcwZSIyKJ1-azP95A&oe=69CE7C90"}, {"file_name": "Screenshot11.png", "id": "1590735815120970", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974724_1590735818454303_1237625315298749935_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GaQS5tCDFgEQ7kNvwGUrbTE&_nc_oc=AdogroZ0PchTyQCTeMHyg9abS55NlW7Fc90JlpUwWRT3TpoHL6xj0PIbj_EfEBAa6-I&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwlPxa8TC65O6q62PzOY2QnWFI0MqmGTdkYiNg_b3GgyA&oe=69CE80A0"}, {"file_name": "Screenshot13.png", "id": "4012487288962632", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031382_4012487292295965_8061648437973272149_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_jVRMZ1wubEQ7kNvwEmm1qt&_nc_oc=AdqxVsWsk-qeeQAq7tLhLO36CIwM0oz2rQnZdKL-hCXK6g3nTz_qQbgse2ebEgNTV3A&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxXSaNiJcUItB-XKw7do7cJQe4DJ2ms-Hs7xqfgwgWD2w&oe=69CE7B47"}, {"file_name": "Screenshot01.png", "id": "820837333183123", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974562_820837336516456_225170929614957289_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OIn5N5gQ_KYQ7kNvwF__4fJ&_nc_oc=Adqz1UZfFrI_s-pxyDYkhU4daKmONcbBsGJpiK4EoL-kFuMLGbTjVqwCpeMMueCySVQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwjiGmw-MwA2FEpN4rfjJFepWVpNbcpMFM2GS8_Of-u2g&oe=69CE5F49"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Screenshot03.png", "id": "3817162075231828", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75295751_3817162078565161_5798546731200879339_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Sm4ux-IyfPAQ7kNvwHV-JeT&_nc_oc=AdoYT9Z8fe69vK6LLqFgQ9E0l3Cq-Puw_ak1ZDO5wLfON9rZD-GjxFCGJ8TXyGI6yiY&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Afwvay-iSaX9HuRMcFU8QBjSPFa7TeZ1eBkl9cDkRX9THA&oe=69CE5CD6"}, "display_name": "Backrooms", "keywords": ["thebackrooms", "noclip", "escape", "horror", "puzzle"], "long_description": "Lose yourself in a world where the ordinary becomes extraordinary. The eerie, sound design and haunting visuals combine to create a sense of dread and isolation. The backrooms are not just a physical maze but a psychological one.\n\nSolve five short puzzles in five levels of the backrooms all while evading the relentless pursuit of lurking entities!\n\nPrepare yourself for an unforgettable journey into the unknown. Can you find your way out, or will you be consumed by the darkness? The only way to know is to step inside and face the horrors that await.", "short_description": "Step into the unsettling world of \"Backrooms\", a short horror-puzzle game that plunges you into the heart of a labyrinthine nightmare!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://molancegames.com/privacy-policy-2/", "developer_terms_of_service_url": null, "publisher_name": "Molance Games", "support_website_url": "https://molancegames.com/contact-us/", "website_url": "https://molancegames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8677833488969981"}, "review_messages": []}]}, "cover_square_image"
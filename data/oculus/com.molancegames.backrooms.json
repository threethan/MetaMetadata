01_1042996653844242_7392525691165321008_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bO5I7QvXtgcQ7kNvwG6w4b5&_nc_oc=Adp7hCKWKbrydV1aAFg2yRY8Mcv45UGaL3caSmllN9CKhy_sQrFsDBf-OxtQkMLONm8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1aYLimX4TI0DeU-2sSKoOpcciPcHAporvT8zwHUdYvOg&oe=69DBAB90"}, {"file_name": "Screenshot11.png", "id": "1590735815120970", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974724_1590735818454303_1237625315298749935_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PPa1hScIunsQ7kNvwFhO_zp&_nc_oc=Adq2Bhu5w0x93NmEtlzJfYjrr2JBs7IhgmJXT2K6jF_Xi_Rz8q7xGeRoNY1VAcsDBdc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3i7irLjq7MbiaQQOIw3CbT87TrnZBb44Qs2DeyQZ-N9A&oe=69DBAFA0"}, {"file_name": "Screenshot13.png", "id": "4012487288962632", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031382_4012487292295965_8061648437973272149_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pq6nfs1Eg-YQ7kNvwE-qePD&_nc_oc=AdqoDQ4iw61-OoaTbxQZxaDytsvzwqNxs7XGQgl_MhpC2zKFBt5mTEfff1DXgCrcuGg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af29EkOnLqu-z-IfUcrfPVSV1G0QPLiSQ7iS2lg5dxDfLA&oe=69DBAA47"}, {"file_name": "Screenshot01.png", "id": "820837333183123", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974562_820837336516456_225170929614957289_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O5th3TyW5lYQ7kNvwH2idzL&_nc_oc=Adqmj118RiZ4Yw7-VDAf2OcAZIkW4GooNnB50dkCj9Yf7ApzNQ6bmhqmxFRa2Dr8moA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3WgOfBE9QAqJ1R5n6O4jUDBYB8eAyN4CuTYrVTrGMzTA&oe=69DB8E49"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Screenshot03.png", "id": "3817162075231828", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75295751_3817162078565161_5798546731200879339_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bTVxVEsI9uYQ7kNvwHJd9lJ&_nc_oc=AdqWyX502H29e6hqLNyoKQldQNLzIrZMwEOGOtGJMUJgUdSL33G_9zIvrlANlGYtq8I&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af31it2tedIBI47cTfKG2C-w4-MJap2y_P9R6xU-o97BGQ&oe=69DB8BD6"}, "display_name": "Backrooms", "keywords": ["thebackrooms", "noclip", "escape", "horror", "puzzle"], "long_description": "Lose yourself in a world where the ordinary becomes extraordinary. The eerie, sound design and haunting visuals combine to create a sense of dread and isolation. The backrooms are not just a physical maze but a psychological one.\n\nSolve five short puzzles in five levels of the backrooms all while evading the relentless pursuit of lurking entities!\n\nPrepare yourself for an unforgettable journey into the unknown. Can you find your way out, or will you be consumed by the darkness? The only way to know is to step inside and face the horrors that await.", "short_description": "Step into the unsettling world of \"Backrooms\", a short horror-puzzle game that plunges you into the heart of a labyrinthine nightmare!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://molancegames.com/privacy-policy-2/", "developer_terms_of_service_url": null, "publisher_name": "Molance Games", "support_website_url": "https://molancegames.com/contact-us/", "website_url": "https://molancegames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8677833488969981"}, "review_messages": []}]}, "cover_square_image"
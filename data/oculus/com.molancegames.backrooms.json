01_1042996653844242_7392525691165321008_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZItSxyS-E1wQ7kNvwGfcPXY&_nc_oc=AdpSlqXD2djm2qLrZGM_DJY28YSEnoF9PUG55-tXMQMzNZ7eY6nLTseTx_9Dy2KBxCs&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af611CZnhzebTB3ofeua4asAvldMyVxc61IH2doR2j7ueQ&oe=6A0B2190"}, {"file_name": "Screenshot11.png", "id": "1590735815120970", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974724_1590735818454303_1237625315298749935_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lHniJEmJ7mYQ7kNvwGNtW_o&_nc_oc=AdrGxPxqAuDGTrkIONzuDbURZPv_2ZgnWHli2qPljci-8Eopyl_VJ5DR0N9_MKPNb_M&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6jC6_IrNSOd1pFGrfl498bOpTl0EvubgCaKJfTUyCOUA&oe=6A0B25A0"}, {"file_name": "Screenshot13.png", "id": "4012487288962632", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031382_4012487292295965_8061648437973272149_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LKoAFEPcv1QQ7kNvwG9uvPr&_nc_oc=Adq2xq9oYMwiZBeJqnTWRKjnh9Wyl-Uf3ASrJnaJdUkQmpRbrtR-Prt6OL8938vOZO0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4fThtEVA0uRpE5K_FKY5yqUGSJr16G6xoTS0k3Un--Dw&oe=6A0B2047"}, {"file_name": "Screenshot01.png", "id": "820837333183123", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974562_820837336516456_225170929614957289_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OCOb-6B5F8EQ7kNvwEZYaXJ&_nc_oc=AdoGegZ4fQKHPOC3TXl30Q3MLQ1vj2SfxU3rNcQUHQwB-xYu5itf6yjR1jZPAmLoPnE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5XNXUv4cL5X-Ml2K89ELe3OwIXVR_UJCoJ7HEKTU6UEw&oe=6A0B0449"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Screenshot03.png", "id": "3817162075231828", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75295751_3817162078565161_5798546731200879339_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ah-Nzek8lzkQ7kNvwEyTASN&_nc_oc=Adp20wR1cTWbeU8s48rDlIdSV0B5aIPWJYXKr_DjiYGVoCCZBkrn3-xmMAwFRNUuhJk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6kd8I3_uaDF1UBwTubudcpWDBBdEW36AzwZITJJwvC7g&oe=6A0B01D6"}, "display_name": "Backrooms", "keywords": ["thebackrooms", "noclip", "escape", "horror", "puzzle"], "long_description": "Lose yourself in a world where the ordinary becomes extraordinary. The eerie, sound design and haunting visuals combine to create a sense of dread and isolation. The backrooms are not just a physical maze but a psychological one.\n\nSolve five short puzzles in five levels of the backrooms all while evading the relentless pursuit of lurking entities!\n\nPrepare yourself for an unforgettable journey into the unknown. Can you find your way out, or will you be consumed by the darkness? The only way to know is to step inside and face the horrors that await.", "short_description": "Step into the unsettling world of \"Backrooms\", a short horror-puzzle game that plunges you into the heart of a labyrinthine nightmare!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://molancegames.com/privacy-policy-2/", "developer_terms_of_service_url": null, "publisher_name": "Molance Games", "support_website_url": "https://molancegames.com/contact-us/", "website_url": "https://molancegames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8677833488969981"}, "review_messages": []}]}, "cover_square_image"
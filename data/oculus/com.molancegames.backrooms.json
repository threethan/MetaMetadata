01_1042996653844242_7392525691165321008_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gKcJwTvhHqEQ7kNvwESfk1W&_nc_oc=AdoPePssFUuExflDCjrTD0O5-IgZ5lA9UhV6il5YyM7B16GzWO-zcrSxzVv04R1z_sk&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5RvGFYXTxm1emSwUzt3P3iByO1lFPxj4dIMOvL7P_fDw&oe=6A130A90"}, {"file_name": "Screenshot11.png", "id": "1590735815120970", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38974724_1590735818454303_1237625315298749935_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GkBf1CWmQwEQ7kNvwH-CHaU&_nc_oc=Adq67D7_75PHk9_n4QPTLMD7P6ygB6JnVv4dSCemKe35OihtUgm2lDLB07UDyuZes14&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af59IlFjkNbMIA52aj56GvypzcZJNxtNcpOi_ak7gqCiOA&oe=6A130EA0"}, {"file_name": "Screenshot13.png", "id": "4012487288962632", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/39031382_4012487292295965_8061648437973272149_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bvTkJKGdyGsQ7kNvwHV0Ijv&_nc_oc=AdqVxIIaN373fP7CGoilKg6GFTlb_IHsaRBC4Z942tHXpQJVEZgjTbxR4bR122iJ4VU&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6PPkZIHW_jKSppqIsEuWj5fqx3b6Sri8dKDc9YEMgZbA&oe=6A130947"}, {"file_name": "Screenshot01.png", "id": "820837333183123", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38974562_820837336516456_225170929614957289_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kq-MQqwSXfgQ7kNvwEVnBrs&_nc_oc=Ado3ZtIK8TF5FEzWaKMVdZxyWxRlQb_f07NrxVttKU6rsvPv8GP5bHEt8KetSNSRqJk&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6d0YA6gcUkLazRoh2tXHLhjXmv96HngHtp2gQGRUzing&oe=6A12ED49"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Screenshot03.png", "id": "3817162075231828", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/75295751_3817162078565161_5798546731200879339_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1drJiPCEYDgQ7kNvwE0Xa8H&_nc_oc=AdrIR9pJeSXCRAnHGc7uGVA5R5lSqsfPlDl86OzCUHne39ieuvoZbG7hxV8iFPXbxR8&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7U7dsPK7A2kNXa2AHK_-uv_LUqGQlrPopglpPPyZkJXA&oe=6A132316"}, "display_name": "Backrooms", "keywords": ["thebackrooms", "noclip", "escape", "horror", "puzzle"], "long_description": "Lose yourself in a world where the ordinary becomes extraordinary. The eerie, sound design and haunting visuals combine to create a sense of dread and isolation. The backrooms are not just a physical maze but a psychological one.\n\nSolve five short puzzles in five levels of the backrooms all while evading the relentless pursuit of lurking entities!\n\nPrepare yourself for an unforgettable journey into the unknown. Can you find your way out, or will you be consumed by the darkness? The only way to know is to step inside and face the horrors that await.", "short_description": "Step into the unsettling world of \"Backrooms\", a short horror-puzzle game that plunges you into the heart of a labyrinthine nightmare!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://molancegames.com/privacy-policy-2/", "developer_terms_of_service_url": null, "publisher_name": "Molance Games", "support_website_url": "https://molancegames.com/contact-us/", "website_url": "https://molancegames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8677833488969981"}, "review_messages": []}]}, "cover_square_image"
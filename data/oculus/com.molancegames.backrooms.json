01_1042996653844242_7392525691165321008_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0BVrzTxXgIUQ7kNvwFBKdsQ&_nc_oc=Adp035KXZZyRcKCnGX_-fPN7Q4EDpyIclT76VNwl8qr-H3_2Il-885AxI99O-0I-Taw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3BrmCCsSKs1ZaA5hGfmYLeCO04IZrZRJzTdh7na7Y-6w&oe=69F75B10"}, {"file_name": "Screenshot11.png", "id": "1590735815120970", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974724_1590735818454303_1237625315298749935_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ryno8uJA7rkQ7kNvwFcp8zs&_nc_oc=AdoUkKNrs3UQb5-fR1oirwe2K2tj9GbGsbzAk2Ku8iBkXrTtV2IWbvnIHHIb2ZvcQRw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1MutK10ZzUOh2xqG2i5fczWNSJXA1gxuvmh3sjN8PH-w&oe=69F75F20"}, {"file_name": "Screenshot13.png", "id": "4012487288962632", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031382_4012487292295965_8061648437973272149_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=thg5n9D_AeMQ7kNvwGdIXO5&_nc_oc=Adp-iS4hVR6aNNti2zGlntoG6sN3Obhn68-xX2BBGPK-0GG-hxC5G1kT2m5U_x_UBKE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3CXAWJWn-YNry7aOPXHiMzbXfUGC5Y43yGdG96lKuy0g&oe=69F759C7"}, {"file_name": "Screenshot01.png", "id": "820837333183123", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974562_820837336516456_225170929614957289_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u8mV41a6R74Q7kNvwHuYLe_&_nc_oc=AdqxFm_QrGV8uZtZG8QXXGFZ7IWZR7NpDn4OCydp6_NsCS45zeA1ztBktV0ZnYs8A9U&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af39xJX7S01gVhRG0-bAsQzWiCzeyr8f_EDJ9u1yvzbuNQ&oe=69F73DC9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Screenshot03.png", "id": "3817162075231828", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75295751_3817162078565161_5798546731200879339_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Yag7rSNC5IkQ7kNvwGXUgak&_nc_oc=Adpy2S_fTNynQTwnsqJkmKLqQ2JdoHF0fhsgStL9eIHqYxOABDzD63m7SNSsJ5dWCAw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1iI3gWSXFbvYbnw78i9GVBH4fherpZ3-k_1FLBPKNvFA&oe=69F73B56"}, "display_name": "Backrooms", "keywords": ["thebackrooms", "noclip", "escape", "horror", "puzzle"], "long_description": "Lose yourself in a world where the ordinary becomes extraordinary. The eerie, sound design and haunting visuals combine to create a sense of dread and isolation. The backrooms are not just a physical maze but a psychological one.\n\nSolve five short puzzles in five levels of the backrooms all while evading the relentless pursuit of lurking entities!\n\nPrepare yourself for an unforgettable journey into the unknown. Can you find your way out, or will you be consumed by the darkness? The only way to know is to step inside and face the horrors that await.", "short_description": "Step into the unsettling world of \"Backrooms\", a short horror-puzzle game that plunges you into the heart of a labyrinthine nightmare!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://molancegames.com/privacy-policy-2/", "developer_terms_of_service_url": null, "publisher_name": "Molance Games", "support_website_url": "https://molancegames.com/contact-us/", "website_url": "https://molancegames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8677833488969981"}, "review_messages": []}]}, "cover_square_image"
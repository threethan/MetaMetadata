01_1042996653844242_7392525691165321008_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oG8PI8UgFUMQ7kNvwE-B1u6&_nc_oc=AdqNgt1N21Prh6b-MwD6-K5pMexDJQl0CUcVyNCUWIIcLzVwtJIGj1-H3lkOhCk-_jw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7cILvFYS2o69cDKjl1Y8OVBbvoy66IXFZ5jwP5vf3MQg&oe=6A0DC490"}, {"file_name": "Screenshot11.png", "id": "1590735815120970", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974724_1590735818454303_1237625315298749935_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lHniJEmJ7mYQ7kNvwFSVzZ6&_nc_oc=AdpA2ZvdaFGhSLRVq7kSclSkHjUmZU0wGrp6qcq5TBEBsFFI8DSg0IRTB6Vykh16H0A&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af71o0ckrS78QwPZJp5yVPUNVX9DyrTq8x26BB5P8aZnjw&oe=6A0DC8A0"}, {"file_name": "Screenshot13.png", "id": "4012487288962632", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031382_4012487292295965_8061648437973272149_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LKoAFEPcv1QQ7kNvwFtfR1E&_nc_oc=AdoLko1ZgSlRUVXcJiGq6gXZI_cKj2nD0K-GONmSPVrRghEVklDIhzBw7whg1fpduvM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5FUwJs5m1hVEhFI8xr4ss8cSrkhEsf0EQl5knpvZPlXg&oe=6A0DC347"}, {"file_name": "Screenshot01.png", "id": "820837333183123", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974562_820837336516456_225170929614957289_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=grxmOebjBd4Q7kNvwGuxA6F&_nc_oc=Ado3h6X1KmESJJMkpuSvpL1-AfovYJey5nSZ12BnTwbxfRe3gXgpj2r8cr121-k8diI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5ri0kMbFu-etjKQc4HO0pPnvvCoM2tOmpk4XcsWs7gQg&oe=6A0DA749"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Screenshot03.png", "id": "3817162075231828", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75295751_3817162078565161_5798546731200879339_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RQqTbVapjFcQ7kNvwHxeydt&_nc_oc=AdoTaS0SXmhI1p1nwo8RMSWvEx53jp6-FXqikVjsqjMZG8MZaEG7ezq0PE7l-u_Sqfs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7auZghpZYa85C8dohRrP3VHpzJ0ctXseOn21vX9JqGuQ&oe=6A0DA4D6"}, "display_name": "Backrooms", "keywords": ["thebackrooms", "noclip", "escape", "horror", "puzzle"], "long_description": "Lose yourself in a world where the ordinary becomes extraordinary. The eerie, sound design and haunting visuals combine to create a sense of dread and isolation. The backrooms are not just a physical maze but a psychological one.\n\nSolve five short puzzles in five levels of the backrooms all while evading the relentless pursuit of lurking entities!\n\nPrepare yourself for an unforgettable journey into the unknown. Can you find your way out, or will you be consumed by the darkness? The only way to know is to step inside and face the horrors that await.", "short_description": "Step into the unsettling world of \"Backrooms\", a short horror-puzzle game that plunges you into the heart of a labyrinthine nightmare!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://molancegames.com/privacy-policy-2/", "developer_terms_of_service_url": null, "publisher_name": "Molance Games", "support_website_url": "https://molancegames.com/contact-us/", "website_url": "https://molancegames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8677833488969981"}, "review_messages": []}]}, "cover_square_image"
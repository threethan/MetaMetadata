01_1042996653844242_7392525691165321008_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pgq_QfgEGJoQ7kNvwFbJ6EN&_nc_oc=AdqJ6afxZInbZ9ixCE7w2nq0ne9xn1nwc6FZ590jC5z83JNjOsU9pd6tqtQXsKaycEs&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5VkfNhBxSCEKltRNklSsj7k53uzDMJbZwVmVHUbaQpKg&oe=69FF4410"}, {"file_name": "Screenshot11.png", "id": "1590735815120970", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974724_1590735818454303_1237625315298749935_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J6agqfNRGCIQ7kNvwGqlLdh&_nc_oc=AdrBMvPwAmxhty_RtWo27IsBZePYa8doonGlE0JRwlF9C_fcGPkHddHoQQYtnvegspI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5h6vGhtoWhP-aRg723uoqXGXblVyUekyniqLDeDMFI0Q&oe=69FF4820"}, {"file_name": "Screenshot13.png", "id": "4012487288962632", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39031382_4012487292295965_8061648437973272149_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WxH829IeXHAQ7kNvwED8B5m&_nc_oc=Adrn9FqrTfWHm6t_asGa68sy76E8fQ1wQTVICXEactFIdqxwZpRjnbOneBTW1kOpmfQ&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5oL0ZtIkwd9PCUAXrVlPbw9MdodOffdweLNTLXCz0PYA&oe=69FF42C7"}, {"file_name": "Screenshot01.png", "id": "820837333183123", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974562_820837336516456_225170929614957289_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KRbC0AZEQUgQ7kNvwFX3i-H&_nc_oc=Adooz-1mR4EEL6fxAUEYSR9HNdo6WUdxP0Omu5YEbvlXRq5__Mj3F2hxGmBt4sAeNOw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4JUHmRY38d7fkOGyZOEyuAStyxLpE5iJi6SDn95zJ6FQ&oe=69FF26C9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Screenshot03.png", "id": "3817162075231828", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75295751_3817162078565161_5798546731200879339_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CLcMOUUGi1oQ7kNvwHQ4tui&_nc_oc=AdqIEZzsPUFppBdtX2Tz6lv0cYiyM79jJzG_6hzFUHKzFot9C03ejre1llnao1OjkX8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4Viodl2-16nbHEZS6vbJe9xvLkQy40VsvkFgbxz1YM4g&oe=69FF2456"}, "display_name": "Backrooms", "keywords": ["thebackrooms", "noclip", "escape", "horror", "puzzle"], "long_description": "Lose yourself in a world where the ordinary becomes extraordinary. The eerie, sound design and haunting visuals combine to create a sense of dread and isolation. The backrooms are not just a physical maze but a psychological one.\n\nSolve five short puzzles in five levels of the backrooms all while evading the relentless pursuit of lurking entities!\n\nPrepare yourself for an unforgettable journey into the unknown. Can you find your way out, or will you be consumed by the darkness? The only way to know is to step inside and face the horrors that await.", "short_description": "Step into the unsettling world of \"Backrooms\", a short horror-puzzle game that plunges you into the heart of a labyrinthine nightmare!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://molancegames.com/privacy-policy-2/", "developer_terms_of_service_url": null, "publisher_name": "Molance Games", "support_website_url": "https://molancegames.com/contact-us/", "website_url": "https://molancegames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8677833488969981"}, "review_messages": []}]}, "cover_square_image"
v2_feBzI7zLr0uXzbvpYOE6nEGQComfQszQlbv-VzBUg&oe=69A56CBD"}, {"file_name": "Screenshot05.png", "id": "1042996650510909", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75458101_1042996653844242_7392525691165321008_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M6U0bh9VkYEQ7kNvwEOmRhM&_nc_oc=AdnM7abfMXGXi0Z8W-6SBU4OorVA7FkGUp3wHdbpdmLFpuSgkjfhUzg2PkXPHscEOcY&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_AfttyD5-1XNcvcYcE0SW8tEfZNUTbw7mgT87X8XdNC5a0g&oe=69A59E10"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Screenshot03.png", "id": "3817162075231828", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/75295751_3817162078565161_5798546731200879339_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L1mqsARzFbYQ7kNvwEaEm9J&_nc_oc=AdmmsEE-kVQqMQ5Fa44KgzVi9q1K0xCM8NSUszfRGQKwDE55AmpA6xJGIn8kM-FfSE8&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&oh=00_AftBIPqpNd8Ibg4Ais1QqShZfVTp3O7RH9V-yCyUnL-Qpg&oe=69A57E56"}, "display_name": "Backrooms", "keywords": ["thebackrooms", "noclip", "escape", "horror", "puzzle"], "long_description": "Lose yourself in a world where the ordinary becomes extraordinary. The eerie, sound design and haunting visuals combine to create a sense of dread and isolation. The backrooms are not just a physical maze but a psychological one.\n\nSolve five different puzzles in five levels of the backrooms all while evading the relentless pursuit of lurking entities!\n\nPrepare yourself for an unforgettable journey into the unknown. Can you find your way out, or will you be consumed by the darkness? The only way to know is to step inside and face the horrors that await.", "short_description": "Step into the unsettling world of \"Backrooms\", a short horror-puzzle game that plunges you into the heart of a labyrinthine nightmare!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://molancegames.com/privacy-policy-2/", "developer_terms_of_service_url": null, "publisher_name": "Molance Games", "suppor
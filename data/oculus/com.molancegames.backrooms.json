nd face the horrors that await.", "short_description": "Step into the unsettling world of \"Backrooms\", a short horror-puzzle game that plunges you into the heart of a labyrinthine nightmare!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://molancegames.com/privacy-policy-2/", "developer_terms_of_service_url": null, "publisher_name": "Molance Games", "support_website_url": "https://molancegames.com/contact-us/", "website_url": "https://molancegames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8101366073283395"}}]}, "scheduled_offers": {"count": 16, "nodes": [{"status": "PUBLISHED", "id": "1184535762823766"}, {"status": "PUBLISHED", "id": "1220331889106782"}, {"status": "PUBLISHED", "id": "939589584850469"}, {"status": "PUBLISHED", "id": "1538946214258545"}, {"status": "PUBLISHED", "id": "965631166054385"}, {"status": "PUBLISHED", "id": "891023260586064"}, {"status": "PUBLISHED", "id": "2570801936649806"}, {"status": "PUBLISHED", "id": "3946119218851546"}, {"status": "PUBLISHED", "id": "822934363984838"}, {"status": "PUBLISHED", "id": "752485697818993"}, {"status": "PUBLISHED", "id": "699131099821221"}, {"status": "PUBLISHED", "id": "579869458225833"}, {"status": "PUBLISHED", "id": "1032304478806363"}, {"status": "PUBLISHED", "id": "1349555679394558"}, {"status": "PUBLISHED", "id": "942077121356897"}, {"status": "PUBLISHED", "id": 
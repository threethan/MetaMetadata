01_1042996653844242_7392525691165321008_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9Up18mpGvuoQ7kNvwHT-PIT&_nc_oc=Adqw0kgm-X9OYSRZGGnD_1TPBzAmrPnj-76sslYkIbmxk3w5dyZLN3WUHzMBkqX0ljI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0wTkFkFRe0MNfZ1a1KHzqdAicNEePQcESFGW93tMNBrQ&oe=69DFA010"}, {"file_name": "Screenshot11.png", "id": "1590735815120970", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974724_1590735818454303_1237625315298749935_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BLEz57nC3GAQ7kNvwGSdbya&_nc_oc=AdpmHUiittBvtov-cVc6H55w8rIZnKgcJYqAVMOyqdjX6KHN77d8d-Ajk9bc5Xg_Cww&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af11iYnuggpm6ozrsZVQJordD7eDG5EqoRp_5rFpclAPjg&oe=69DFA420"}, {"file_name": "Screenshot13.png", "id": "4012487288962632", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031382_4012487292295965_8061648437973272149_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BGNoUWIL8ZQQ7kNvwEQyccp&_nc_oc=Ado6VzBGBW8t0-9VikMLQoo-ssf4xKfCw2sj7FhWnTvUKpFmAJV1QTNI7XoaE6KFPT4&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0N26p2zFGHuwW31jY4zAbKHbZMRGXYiIxAQmsGIyiDMQ&oe=69DF9EC7"}, {"file_name": "Screenshot01.png", "id": "820837333183123", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974562_820837336516456_225170929614957289_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KAEYdJ8ZmF0Q7kNvwF3EDZY&_nc_oc=AdoBFqjfbmD6AevmC_vCF4_4MrQWpfrzhsFaU6dqOjZnVj4roTrL_wrsfTM97XencYc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3un6jNcRYv4YDYzQ8llfiUjhDDsU6gtx0WarfY3iu0Aw&oe=69DF82C9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Screenshot03.png", "id": "3817162075231828", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75295751_3817162078565161_5798546731200879339_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KD_w8J12mgkQ7kNvwEJtPe7&_nc_oc=Adr4dwhZwj1m_ca8gw5J7XE2oDmyCHV8NfhtQX8OfkX6p2EqQO4OJbbDOTd9EiSKCos&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3YOl5OakoVIW_M6-9xO3eAAs3rXE7pDWjYoAsgDv2JJg&oe=69DF8056"}, "display_name": "Backrooms", "keywords": ["thebackrooms", "noclip", "escape", "horror", "puzzle"], "long_description": "Lose yourself in a world where the ordinary becomes extraordinary. The eerie, sound design and haunting visuals combine to create a sense of dread and isolation. The backrooms are not just a physical maze but a psychological one.\n\nSolve five short puzzles in five levels of the backrooms all while evading the relentless pursuit of lurking entities!\n\nPrepare yourself for an unforgettable journey into the unknown. Can you find your way out, or will you be consumed by the darkness? The only way to know is to step inside and face the horrors that await.", "short_description": "Step into the unsettling world of \"Backrooms\", a short horror-puzzle game that plunges you into the heart of a labyrinthine nightmare!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://molancegames.com/privacy-policy-2/", "developer_terms_of_service_url": null, "publisher_name": "Molance Games", "support_website_url": "https://molancegames.com/contact-us/", "website_url": "https://molancegames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8677833488969981"}, "review_messages": []}]}, "cover_square_image"
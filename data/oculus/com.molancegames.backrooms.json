01_1042996653844242_7392525691165321008_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HaRwUPPHhWkQ7kNvwF4LTT3&_nc_oc=AdpAcIMI7SmytE087v0nZOYEfn9o-zU157VoVqG4wD2aqMfN9OotZDF0EfAcWUjApZc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af47ZhAvczKR07XJ1vrbO-jTptpPohXl48HZDe_QrtvSjg&oe=69F9FE10"}, {"file_name": "Screenshot11.png", "id": "1590735815120970", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974724_1590735818454303_1237625315298749935_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ryno8uJA7rkQ7kNvwHv_653&_nc_oc=AdqJtpaUuY-NNkLBSa4Yd6bPyW3W8f2B0dc4eYTcBifHQ3lfB7oLULCLkkSNuY5bU1Q&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6LqA434vk_0OynJW-VGvupGp2euz73HtRn2JoTmPONzA&oe=69FA0220"}, {"file_name": "Screenshot13.png", "id": "4012487288962632", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031382_4012487292295965_8061648437973272149_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=thg5n9D_AeMQ7kNvwGM_BiT&_nc_oc=AdpmzMhV3j78fuARCSjaF--OTBnnqfBv1Y61CgfcE438-7JOhQ35biKwq5I14UhwC1Q&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7opZozONFI05gnGo6SYsrRp5E4uekrqRv-rTX9j7LvxQ&oe=69F9FCC7"}, {"file_name": "Screenshot01.png", "id": "820837333183123", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974562_820837336516456_225170929614957289_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J9pBfl1kBj4Q7kNvwGjqA2N&_nc_oc=AdpirxJaLXWS-KqyEsCTh_oaO7ERyHfDc2s_tVZILOatV-s1Au-gHZ-XC6N5M__UkQg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5vFd3idK2hKpT9MQ1HCCItSUI6PfOqE50Oz2jKVbYDzg&oe=69F9E0C9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Screenshot03.png", "id": "3817162075231828", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75295751_3817162078565161_5798546731200879339_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DfIPKo3F8KYQ7kNvwHzni5A&_nc_oc=AdpvCn6i_9aS01LRVyAeRsVoEyPCsMU7oTZjUXrBDFHaVBty-ucUx6lr943GTFnggVQ&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4gB0bmxVP_Ps3W-hidBjpnd8iWPTNn2ko5wziED9QQiw&oe=69F9DE56"}, "display_name": "Backrooms", "keywords": ["thebackrooms", "noclip", "escape", "horror", "puzzle"], "long_description": "Lose yourself in a world where the ordinary becomes extraordinary. The eerie, sound design and haunting visuals combine to create a sense of dread and isolation. The backrooms are not just a physical maze but a psychological one.\n\nSolve five short puzzles in five levels of the backrooms all while evading the relentless pursuit of lurking entities!\n\nPrepare yourself for an unforgettable journey into the unknown. Can you find your way out, or will you be consumed by the darkness? The only way to know is to step inside and face the horrors that await.", "short_description": "Step into the unsettling world of \"Backrooms\", a short horror-puzzle game that plunges you into the heart of a labyrinthine nightmare!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://molancegames.com/privacy-policy-2/", "developer_terms_of_service_url": null, "publisher_name": "Molance Games", "support_website_url": "https://molancegames.com/contact-us/", "website_url": "https://molancegames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8677833488969981"}, "review_messages": []}]}, "cover_square_image"
01_1042996653844242_7392525691165321008_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gawxgVVPRJ8Q7kNvwFXsDSk&_nc_oc=Adq84sOkExmUsy8oEoa7FnETGSklDqh1Rxx-hmX7kcnTFNp144lUfJt3HSmO1_19Zrk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyXY_J_AMwFARSePQlKWDtBSk_7MZ_eTHgdPNmZD_ttKA&oe=69D11F90"}, {"file_name": "Screenshot11.png", "id": "1590735815120970", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974724_1590735818454303_1237625315298749935_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5Nad3vIkYHMQ7kNvwEggsdi&_nc_oc=AdowyitvaugHzplFbpy67JOo-JuaeGRjAHuxWwrML-xH40FqHEpLdcZgx5eVAI_xHzI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwyV_AIXNbr-EL18-q5pg_JGImfn7b-31Wzj3MbTNgtKg&oe=69D123A0"}, {"file_name": "Screenshot13.png", "id": "4012487288962632", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031382_4012487292295965_8061648437973272149_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ShELnWnyRuoQ7kNvwHlVwzi&_nc_oc=AdqxVV7USRs70MdZMVVERgUWKvzImGQXQXzVu7nQl-HR1EsDJWNn0iyvnpJg2t2aPE4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afz3aEtj1oTgAdeaZBT3NMtoGu3dn8QTrJVK-F9V26DBMg&oe=69D11E47"}, {"file_name": "Screenshot01.png", "id": "820837333183123", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974562_820837336516456_225170929614957289_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=twYraqEgnjwQ7kNvwHOeaFS&_nc_oc=AdrIPowGBeGo_MlU4eAq67Iurtp5tbEQ8rU54diRtDHKpTwcZBPBIDzLXsmuwmKE3eU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwK4FwoVbVxoibod_sY83rqeiv2f23ZjrezJa0m5ARygQ&oe=69D10249"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Screenshot03.png", "id": "3817162075231828", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75295751_3817162078565161_5798546731200879339_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pgv2o4Cy2TkQ7kNvwHHsnKm&_nc_oc=Adqj7Resyg4WobYQk_Nys3KuiHJJR5I6ByrdRbFMvwIVVHOwi6t4TJb3yXBdenMWeH8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyZIBalPPCBxgN3QcNnvLTlJnyJq0aRKTdKwcpd1rjxKw&oe=69D0FFD6"}, "display_name": "Backrooms", "keywords": ["thebackrooms", "noclip", "escape", "horror", "puzzle"], "long_description": "Lose yourself in a world where the ordinary becomes extraordinary. The eerie, sound design and haunting visuals combine to create a sense of dread and isolation. The backrooms are not just a physical maze but a psychological one.\n\nSolve five short puzzles in five levels of the backrooms all while evading the relentless pursuit of lurking entities!\n\nPrepare yourself for an unforgettable journey into the unknown. Can you find your way out, or will you be consumed by the darkness? The only way to know is to step inside and face the horrors that await.", "short_description": "Step into the unsettling world of \"Backrooms\", a short horror-puzzle game that plunges you into the heart of a labyrinthine nightmare!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://molancegames.com/privacy-policy-2/", "developer_terms_of_service_url": null, "publisher_name": "Molance Games", "support_website_url": "https://molancegames.com/contact-us/", "website_url": "https://molancegames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8677833488969981"}, "review_messages": []}]}, "cover_square_image"
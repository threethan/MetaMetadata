01_1042996653844242_7392525691165321008_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZItSxyS-E1wQ7kNvwGQpOQ4&_nc_oc=Ado1MsY0YDEe4KNhtpFy9aOvbZ2ObnxAoUfjG9K1kUIrHe5NR91GRUaI4AkhErW2Bg8&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5yVQ_AuY4Ja1tiC9Z5hp7aftOjN4ghQxB0wHN8OKkhDw&oe=6A09D010"}, {"file_name": "Screenshot11.png", "id": "1590735815120970", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/38974724_1590735818454303_1237625315298749935_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JFYj_N395k4Q7kNvwFgAYQG&_nc_oc=AdrU5S_5P0SSVoa7cJj_ZZIeLX5L2f1DFPKUDeD62sHhRzRPplP0GCq0S9toT5Dj10M&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4-0dV-4YdP9qPe0earGFVwtP5wwu2q80hBPTLn6nZPCA&oe=6A09D420"}, {"file_name": "Screenshot13.png", "id": "4012487288962632", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/39031382_4012487292295965_8061648437973272149_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A3IhCB9SjSsQ7kNvwHVA_ir&_nc_oc=AdpmVDGbuXGjIsde8PMf-rpCipWSe3TDCmhDqfQxPIqc0QDL3cNHwLcEdHYszUXVtXY&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6FygoYb5dtkLBSOG_3yLtIyK0RQKifHw2fqbkLVYIiLA&oe=6A09CEC7"}, {"file_name": "Screenshot01.png", "id": "820837333183123", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/38974562_820837336516456_225170929614957289_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OCOb-6B5F8EQ7kNvwE9oIEi&_nc_oc=Adp0Xp4gOp9WdgAI0Ve22FWxWI2mMh_rzmgJqEgT0D72lZrgNz2Q8_oyPaT1Bwu77X8&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7jgH0aYPu_j_6dxrnGVVOcxnuZPs7LG2wXWAyRJ5JJ1g&oe=6A09B2C9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Screenshot03.png", "id": "3817162075231828", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/75295751_3817162078565161_5798546731200879339_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ah-Nzek8lzkQ7kNvwEdZ27M&_nc_oc=AdqfUw5xCsjWVDt-SJqumoLMVuJ8jzDIkZgQeEXNIerscCUfVTbMSYT60uP_-eCRoKo&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5oTtfmFMbfU4B-GFTSbztsAyFvwN7kSmJYrVkVFK_fDQ&oe=6A09B056"}, "display_name": "Backrooms", "keywords": ["thebackrooms", "noclip", "escape", "horror", "puzzle"], "long_description": "Lose yourself in a world where the ordinary becomes extraordinary. The eerie, sound design and haunting visuals combine to create a sense of dread and isolation. The backrooms are not just a physical maze but a psychological one.\n\nSolve five short puzzles in five levels of the backrooms all while evading the relentless pursuit of lurking entities!\n\nPrepare yourself for an unforgettable journey into the unknown. Can you find your way out, or will you be consumed by the darkness? The only way to know is to step inside and face the horrors that await.", "short_description": "Step into the unsettling world of \"Backrooms\", a short horror-puzzle game that plunges you into the heart of a labyrinthine nightmare!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://molancegames.com/privacy-policy-2/", "developer_terms_of_service_url": null, "publisher_name": "Molance Games", "support_website_url": "https://molancegames.com/contact-us/", "website_url": "https://molancegames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8677833488969981"}, "review_messages": []}]}, "cover_square_image"
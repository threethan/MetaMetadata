uxgq4bN1hb1dgpLDkhi_521OHJ_yukj0XSGmJPbWAVTg&oe=69A2C9BD"}, {"file_name": "Screenshot05.png", "id": "1042996650510909", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75458101_1042996653844242_7392525691165321008_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M6U0bh9VkYEQ7kNvwGzYN7K&_nc_oc=Adnim676sdaVAkVKA-MJS_Q9HSW_v_ihWJziqQ1v2eSqMUfanb8U3QF2Y_4Fb99sm_Y&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AftUTIqtUGHJwTqB1jzbSSG5RiuhWS54BWW5LvDODVIYJQ&oe=69A2FB10"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Screenshot03.png", "id": "3817162075231828", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75295751_3817162078565161_5798546731200879339_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=grNHs0mqJYIQ7kNvwEDMDPB&_nc_oc=Adnby1beh7WRd3SSLAdx_vFa9_c1SPomCgjjGZJ3V6CvPTJallzNK7nk5910xx5DY08&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfuR1IAqVV_RqneGiW0FRC2jp_5WvA5tRmlB4A8849-Vsw&oe=69A2DB56"}, "display_name": "Backrooms", "keywords": ["thebackrooms", "noclip", "escape", "horror", "puzzle"], "long_description": "Lose yourself in a world where the ordinary becomes extraordinary. The eerie, sound design and haunting visuals combine to create a sense of dread and isolation. The backrooms are not just a physical maze but a psychological one.\n\nSolve five different puzzles in five levels of the backrooms all while evading the relentless pursuit of lurking entities!\n\nPrepare yourself for an unforgettable journey into the unknown. Can you find your way out, or will you be consumed by the darkness? The only way to know is to step inside and face the horrors that await.", "short_description": "Step into the unsettling world of \"Backrooms\", a short horror-puzzle game that plunges you into the heart of a labyrinthine nightmare!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://molancegames.com/privacy-policy-2/", "developer_terms_of_service_url": null, "publisher_name": "Molance Games", "suppor
812972029630782_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dTOBqns4OToQ7kNvwEbMBR6&_nc_oc=AdqkadRXzwVKrrQrOuKuNldNjyosoPCr0vKHab42ckWskQzMJByKAvFS9J_gk0w7NpY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1R_yt0-paVB5_-NFa6y2WTo1BGB_vO95vn0FjywLEjFw&oe=69DCCBBD"}, {"file_name": "Screenshot05.png", "id": "1042996650510909", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75458101_1042996653844242_7392525691165321008_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bO5I7QvXtgcQ7kNvwHB-OSp&_nc_oc=AdppR-oarp4ra2t_Hgb1H0nIzCak3lKRAdUCD4luIt0t5FqoorFDmjDgthtFKk-51RY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3xY6TphZPdIu_O0904NNc5EbTholw59KZ3LUfzcRscBw&oe=69DCFD10"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Screenshot03.png", "id": "3817162075231828", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75295751_3817162078565161_5798546731200879339_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KD_w8J12mgkQ7kNvwGc2MIe&_nc_oc=AdqlW_RXtS1ebj_ozKCpBM_UbSSpUL3HfJmh7YJ6qloaO7yeKpfLe0TtjbiLNQu0xW8&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3xq-f5pn9WUHCu46MvE2EkWEp5W1iEEsdIIJ0KuqQKww&oe=69DCDD56"}, "display_name": "Backrooms", "keywords": ["thebackrooms", "noclip", "escape", "horror", "puzzle"], "long_description": "Lose yourself in a world where the ordinary becomes extraordinary. The eerie, sound design and haunting visuals combine to create a sense of dread and isolation. The backrooms are not just a physical maze but a psychological one.\n\nSolve five different puzzles in five levels of the backrooms all while evading the relentless pursuit of lurking entities!\n\nPrepare yourself for an unforgettable journey into the unknown. Can you find your way out, or will you be consumed by the darkness? The only way to know is to step inside and face the horrors that await.", "short_description": "Step into the unsettling world of \"Backrooms\", a short horror-puzzl
01_1042996653844242_7392525691165321008_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9agiYm7lFLEQ7kNvwEi3zpx&_nc_oc=Adq0pDfOL4TZP6W2zHbSU1UfMW-Cuz_Ky3cvzbyJxs4iLK1yVaS1mNNtETkigDqUbQI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4knT79xUe1Yw5Oxyg6Qhsccmlb_aU1Ds2DYno3n4e7OA&oe=6A087E90"}, {"file_name": "Screenshot11.png", "id": "1590735815120970", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974724_1590735818454303_1237625315298749935_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JFYj_N395k4Q7kNvwFkpi7A&_nc_oc=AdoFcBey2pwUHjPSLbqfi4bIAhiHPEEY243LTRA1e38fUDJDUjc1NkVW7TikkjiAWgQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6luci_5yB-QVXbA4iS2x7ueWjJIiiQaPdTHG6VhRERNg&oe=6A0882A0"}, {"file_name": "Screenshot13.png", "id": "4012487288962632", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031382_4012487292295965_8061648437973272149_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A3IhCB9SjSsQ7kNvwHomF7N&_nc_oc=AdosmCJRWiv1nDlWg-UMZxCrCjTxDUP9KkHaRJ7NnJgM83w5IH_tJIBdqnMRsdKyHCA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af69PUZJb03tujz1zhvTv8bZMyEUDEmNZ6DFArZorlWLLw&oe=6A087D47"}, {"file_name": "Screenshot01.png", "id": "820837333183123", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974562_820837336516456_225170929614957289_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OCOb-6B5F8EQ7kNvwEeGCRC&_nc_oc=AdrRK7e8p5952Jui8JOVc7r2H4KHjcjUIC2IO8GG8Ku9PeCZFT8gDnx-dpDmpchLAH0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7ZKNAg32jKIjtd3F7IyXm9C4WsNC6BPGKScebiT5UV_w&oe=6A089989"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Screenshot03.png", "id": "3817162075231828", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75295751_3817162078565161_5798546731200879339_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ah-Nzek8lzkQ7kNvwGmhWkj&_nc_oc=Adpb9vB0HvsuSgGa6z2sVQ20HYHS38MdA237rW3x2QnfRUh6SR_iggLBDoAjmRZAfI0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4Sp1YmTk-lzWqguEz5yQ9lWtVEkPy6K1R_g-xaYMTYlA&oe=6A089716"}, "display_name": "Backrooms", "keywords": ["thebackrooms", "noclip", "escape", "horror", "puzzle"], "long_description": "Lose yourself in a world where the ordinary becomes extraordinary. The eerie, sound design and haunting visuals combine to create a sense of dread and isolation. The backrooms are not just a physical maze but a psychological one.\n\nSolve five short puzzles in five levels of the backrooms all while evading the relentless pursuit of lurking entities!\n\nPrepare yourself for an unforgettable journey into the unknown. Can you find your way out, or will you be consumed by the darkness? The only way to know is to step inside and face the horrors that await.", "short_description": "Step into the unsettling world of \"Backrooms\", a short horror-puzzle game that plunges you into the heart of a labyrinthine nightmare!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://molancegames.com/privacy-policy-2/", "developer_terms_of_service_url": null, "publisher_name": "Molance Games", "support_website_url": "https://molancegames.com/contact-us/", "website_url": "https://molancegames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8677833488969981"}, "review_messages": []}]}, "cover_square_image"
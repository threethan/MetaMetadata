01_1042996653844242_7392525691165321008_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RdH1gqW5VlkQ7kNvwGm_0Nk&_nc_oc=Adp3Xopjh13hwqaUvPFPaEbbIAL-iJZoyv1ZiZxFLjiLn9wgqWMp_fkWDibe-wTf0MM&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0asIk8ycUO0YYAkPV9AdNi1MCaCzUGvMSNTPtV1Map_Q&oe=69E63790"}, {"file_name": "Screenshot11.png", "id": "1590735815120970", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974724_1590735818454303_1237625315298749935_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2h6R8-rP0R0Q7kNvwFzIpbI&_nc_oc=Ado1YIOI7tHM1MPd0XulebSfU11FId7Ng3gW3jeyMFSL6QAI03N5NTXNS-Kp49YoYrI&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af24NtLFRzRubOvljSFFDRcXCbubtcFjwYwLbFGrvm5jtg&oe=69E63BA0"}, {"file_name": "Screenshot13.png", "id": "4012487288962632", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39031382_4012487292295965_8061648437973272149_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mDVbLlCpTFoQ7kNvwHKi1bN&_nc_oc=AdqeNPvMUCLKWwpFlK2xdUEJSiCxf0Sjqbgw_k7ndC3yWxeDqCTfHgUcPruOjs6BOCw&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2jD3zFYQNZXNgTFxYrWhWQ-qxC4TNkol3IUsZR-cjGZA&oe=69E63647"}, {"file_name": "Screenshot01.png", "id": "820837333183123", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974562_820837336516456_225170929614957289_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a6vfxO293ssQ7kNvwHxm4ue&_nc_oc=Adp8QfRgS4ikwGYd7524m-fCCDpBZbolspy-vol_MS-6FeUZ6YGypXt1A-zeBE48ieg&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1xf3DLlRhyYPqcgx3QECPc_Vw33fMx7VnB9dmimaYWJg&oe=69E61A49"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Screenshot03.png", "id": "3817162075231828", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/75295751_3817162078565161_5798546731200879339_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7mUpC_Xtmw4Q7kNvwE_a8Y_&_nc_oc=Adolrgma64uyazojOrIUKNFd-aIQmeK9NKOdQdl1IKUaHtAr5BJ3Cl88QVGi0Syp6iQ&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af05FpgllTpn1jh20qpeMG0G02O_bSa7bXOKw-QuuYXoew&oe=69E617D6"}, "display_name": "Backrooms", "keywords": ["thebackrooms", "noclip", "escape", "horror", "puzzle"], "long_description": "Lose yourself in a world where the ordinary becomes extraordinary. The eerie, sound design and haunting visuals combine to create a sense of dread and isolation. The backrooms are not just a physical maze but a psychological one.\n\nSolve five short puzzles in five levels of the backrooms all while evading the relentless pursuit of lurking entities!\n\nPrepare yourself for an unforgettable journey into the unknown. Can you find your way out, or will you be consumed by the darkness? The only way to know is to step inside and face the horrors that await.", "short_description": "Step into the unsettling world of \"Backrooms\", a short horror-puzzle game that plunges you into the heart of a labyrinthine nightmare!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://molancegames.com/privacy-policy-2/", "developer_terms_of_service_url": null, "publisher_name": "Molance Games", "support_website_url": "https://molancegames.com/contact-us/", "website_url": "https://molancegames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8677833488969981"}, "review_messages": []}]}, "cover_square_image"
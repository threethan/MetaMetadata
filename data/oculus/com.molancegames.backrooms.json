01_1042996653844242_7392525691165321008_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9agiYm7lFLEQ7kNvwHHMmQg&_nc_oc=AdoNuAZMIthiULSYQgLFJwSL5GZRv3JfUDdzl1PhRPff3QC-GMKntWGxBQHKvok833k&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7PSLCfm2dT0Xh_vWqGFE--K8-R7UjObCvcy38rcfioLw&oe=6A072D10"}, {"file_name": "Screenshot11.png", "id": "1590735815120970", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974724_1590735818454303_1237625315298749935_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JFYj_N395k4Q7kNvwGSHrG3&_nc_oc=AdqhQA4wwBQyb1Tl_3JzCwE9uvLdqoovpaudhFb6qv9h7i0t4uYFy3YWefjQKSGHSsk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4NrtDKZnWpX0LT8BPGGT0xv9ShXL9FUdu3OfUHheGloA&oe=6A073120"}, {"file_name": "Screenshot13.png", "id": "4012487288962632", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031382_4012487292295965_8061648437973272149_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A3IhCB9SjSsQ7kNvwH1YIYQ&_nc_oc=Adqqn4k5fLDVxL5RBecYF4tGipVrdPvNrX95xgHH2kBRVakkddjNCdckX4bExoZmlw8&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7sJoqa3Xcwt9mzpLw2D4UZWcKsTvDj0-p6J8MqiPN5mw&oe=6A072BC7"}, {"file_name": "Screenshot01.png", "id": "820837333183123", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974562_820837336516456_225170929614957289_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bvRUiCC-a1AQ7kNvwGQIofg&_nc_oc=AdrGKyFXfQLZrEO8ERy5WGefVHhD2_kjoo6IR-CktjiIJKh9Z1p6pMBS1W4B9renPnk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4I_ToEGoALUDheR2KEb1_d1BKKhI3Y4Zzmz9M7mGNhcw&oe=6A070FC9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Screenshot03.png", "id": "3817162075231828", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75295751_3817162078565161_5798546731200879339_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-70Y0cr0H2kQ7kNvwGD4iJu&_nc_oc=AdpQxxiZXEhEUMMFe31VPY4HNL9eTugYC5MW0dx-ir-wWzClTA-544nxUunn4nmtM-8&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6b7T5RF_l1rxsFhbYlSeccs0EWh5OSWTIvbC-NQ8GNgA&oe=6A070D56"}, "display_name": "Backrooms", "keywords": ["thebackrooms", "noclip", "escape", "horror", "puzzle"], "long_description": "Lose yourself in a world where the ordinary becomes extraordinary. The eerie, sound design and haunting visuals combine to create a sense of dread and isolation. The backrooms are not just a physical maze but a psychological one.\n\nSolve five short puzzles in five levels of the backrooms all while evading the relentless pursuit of lurking entities!\n\nPrepare yourself for an unforgettable journey into the unknown. Can you find your way out, or will you be consumed by the darkness? The only way to know is to step inside and face the horrors that await.", "short_description": "Step into the unsettling world of \"Backrooms\", a short horror-puzzle game that plunges you into the heart of a labyrinthine nightmare!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://molancegames.com/privacy-policy-2/", "developer_terms_of_service_url": null, "publisher_name": "Molance Games", "support_website_url": "https://molancegames.com/contact-us/", "website_url": "https://molancegames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8677833488969981"}, "review_messages": []}]}, "cover_square_image"
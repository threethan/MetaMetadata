01_1042996653844242_7392525691165321008_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q5qFWWUGi-kQ7kNvwH-v1xN&_nc_oc=AdpWnTdWgUmCh2fSEEp21RtQIGA3wTJZ4wYHDhhEUK3Gxjy5P0mRnRvGizI4faIfOig&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af45qb6PJdCIbOb_dc6wyHlwI6F_j0-XFGOy98acm7KQjA&oe=6A16FF10"}, {"file_name": "Screenshot11.png", "id": "1590735815120970", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974724_1590735818454303_1237625315298749935_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Yw0H0sYrvtYQ7kNvwG0TAXE&_nc_oc=AdrT0onBNCLhZKmzuLrehHety30rMd1p6ShBIcAVclCEN3goWfQSyV6rdv8oJabDzBE&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5TsUoDAG8m1mLyJEJ6kadKiI2iNBu66zQaNvBDAKUTKA&oe=6A170320"}, {"file_name": "Screenshot13.png", "id": "4012487288962632", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39031382_4012487292295965_8061648437973272149_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r4A2Dr2_9MsQ7kNvwFybIjg&_nc_oc=Adp63HgvjKMFB8P_Ck2myphrOQAXRJ-zutlGLeMj57DKnkIzgULo7xcMoGWk8MHhppQ&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4l-TzTPIpiSaS-_RfIYehrGoqhchfObDftZ6mfWvZW0A&oe=6A16FDC7"}, {"file_name": "Screenshot01.png", "id": "820837333183123", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974562_820837336516456_225170929614957289_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2LRHwolzYXsQ7kNvwHOejFw&_nc_oc=Adr2MyMjuEPGlIRSOytTViCqtUqsewHJTSBADbdijL21cW_W0BUN2xQMCd16bxhm5VQ&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6HnRZVELOmDZlBkBdPUmywRsaoOw8rqkN-ozFehOPjEg&oe=6A16E1C9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Screenshot03.png", "id": "3817162075231828", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75295751_3817162078565161_5798546731200879339_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RWR2DOz3bzcQ7kNvwFDn8n1&_nc_oc=AdqmtDi0irAZiSv2GHql5B8m4r-TGem4lMdTLHFXC5_3WmZ-a7s_utxeWPssUEaYM1E&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6H8_L-oHsoSjJtUUp5N2Ax6MCUckk7NLjxBQOA46i9wA&oe=6A16DF56"}, "display_name": "Backrooms", "keywords": ["thebackrooms", "noclip", "escape", "horror", "puzzle"], "long_description": "Lose yourself in a world where the ordinary becomes extraordinary. The eerie, sound design and haunting visuals combine to create a sense of dread and isolation. The backrooms are not just a physical maze but a psychological one.\n\nSolve five short puzzles in five levels of the backrooms all while evading the relentless pursuit of lurking entities!\n\nPrepare yourself for an unforgettable journey into the unknown. Can you find your way out, or will you be consumed by the darkness? The only way to know is to step inside and face the horrors that await.", "short_description": "Step into the unsettling world of \"Backrooms\", a short horror-puzzle game that plunges you into the heart of a labyrinthine nightmare!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://molancegames.com/privacy-policy-2/", "developer_terms_of_service_url": null, "publisher_name": "Molance Games", "support_website_url": "https://molancegames.com/contact-us/", "website_url": "https://molancegames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8677833488969981"}, "review_messages": []}]}, "cover_square_image"
01_1042996653844242_7392525691165321008_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AdNEj3010WAQ7kNvwEDqjSb&_nc_oc=AdqiDbinn0qMbR_cVmbbqBPDggvNqVEbNLiWos4_GBewX36gIlymuzfT2y0caCMMJLg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1OL8qgI4PmVMEXZK7xDos3LredRjYpHzjLXkKsWfMXqA&oe=69ECCF10"}, {"file_name": "Screenshot11.png", "id": "1590735815120970", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974724_1590735818454303_1237625315298749935_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k-3wOQIt9aEQ7kNvwHpulDa&_nc_oc=Adq3h3AGwwQopnum3bXh70NA1DlfTrY2NvsxDd8sEyDLug8Ey-M1YXXN8w88f47Xn6o&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0YWlN4ZZOqYgd6UmRsLZ6jS3RrtzXfMlCEOjtFd4TO3w&oe=69ECD320"}, {"file_name": "Screenshot13.png", "id": "4012487288962632", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031382_4012487292295965_8061648437973272149_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SPFQt-wyLDUQ7kNvwGE-bkh&_nc_oc=AdrMCwv7BMOrQmtknFjxixopsDZK8TtBcPwOqR9olI0Q-4HGM6YjBXSK-0DLDPo25do&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3-G_Vf0w8NlDALVBPb-4m9riAqmiIIwVRuNQexFSyxng&oe=69ECCDC7"}, {"file_name": "Screenshot01.png", "id": "820837333183123", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974562_820837336516456_225170929614957289_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7Se6Zu3z-xoQ7kNvwEDkIeg&_nc_oc=AdpmzTTUgUCCipMVUHxaX_-yPWZqgHUIbJD6CvXiORl1kDw5arKusPVeyeVt26lqM0I&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3JJRRrka3ZA1beK_IeN4pLPJfpRGrxKm8A1klKctaGCQ&oe=69ECB1C9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Screenshot03.png", "id": "3817162075231828", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75295751_3817162078565161_5798546731200879339_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w_Y7WT3mIvYQ7kNvwFu75sP&_nc_oc=AdojNAFP72hrTp00BhUgCPdUyPClPgxMtGI9Iu6ZcT1IenYLW5syFsG9rixqs4pNfPY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3cCv8TNQAj1mnceVw24zuiqDcMVwbcpKg6BpCXu_b65Q&oe=69ECAF56"}, "display_name": "Backrooms", "keywords": ["thebackrooms", "noclip", "escape", "horror", "puzzle"], "long_description": "Lose yourself in a world where the ordinary becomes extraordinary. The eerie, sound design and haunting visuals combine to create a sense of dread and isolation. The backrooms are not just a physical maze but a psychological one.\n\nSolve five short puzzles in five levels of the backrooms all while evading the relentless pursuit of lurking entities!\n\nPrepare yourself for an unforgettable journey into the unknown. Can you find your way out, or will you be consumed by the darkness? The only way to know is to step inside and face the horrors that await.", "short_description": "Step into the unsettling world of \"Backrooms\", a short horror-puzzle game that plunges you into the heart of a labyrinthine nightmare!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://molancegames.com/privacy-policy-2/", "developer_terms_of_service_url": null, "publisher_name": "Molance Games", "support_website_url": "https://molancegames.com/contact-us/", "website_url": "https://molancegames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8677833488969981"}, "review_messages": []}]}, "cover_square_image"
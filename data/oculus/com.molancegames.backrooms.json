812972029630782_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rDAut7qgbHEQ7kNvwGPzdY6&_nc_oc=AdoT4fLARe9i3CEvTDGkJjv4OL-Igv3MEH68UmWhpCV3mMTkbMfVKMCDQeDSD03ywAc&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af67sXiwTsmSbpUGjVkOkN6ZD4CI0tQaK73noKLZSs9unQ&oe=6A09D6FD"}, {"file_name": "Screenshot05.png", "id": "1042996650510909", "uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/75458101_1042996653844242_7392525691165321008_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZItSxyS-E1wQ7kNvwGQpOQ4&_nc_oc=Ado1MsY0YDEe4KNhtpFy9aOvbZ2ObnxAoUfjG9K1kUIrHe5NR91GRUaI4AkhErW2Bg8&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5yVQ_AuY4Ja1tiC9Z5hp7aftOjN4ghQxB0wHN8OKkhDw&oe=6A09D010"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Screenshot03.png", "id": "3817162075231828", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/75295751_3817162078565161_5798546731200879339_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ah-Nzek8lzkQ7kNvwEdZ27M&_nc_oc=AdqfUw5xCsjWVDt-SJqumoLMVuJ8jzDIkZgQeEXNIerscCUfVTbMSYT60uP_-eCRoKo&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5oTtfmFMbfU4B-GFTSbztsAyFvwN7kSmJYrVkVFK_fDQ&oe=6A09B056"}, "display_name": "Backrooms", "keywords": ["thebackrooms", "noclip", "escape", "horror", "puzzle"], "long_description": "Lose yourself in a world where the ordinary becomes extraordinary. The eerie, sound design and haunting visuals combine to create a sense of dread and isolation. The backrooms are not just a physical maze but a psychological one.\n\nSolve five different puzzles in five levels of the backrooms all while evading the relentless pursuit of lurking entities!\n\nPrepare yourself for an unforgettable journey into the unknown. Can you find your way out, or will you be consumed by the darkness? The only way to know is to step inside and face the horrors that await.", "short_description": "Step into the unsettling world of \"Backrooms\", a short horror-puzzl
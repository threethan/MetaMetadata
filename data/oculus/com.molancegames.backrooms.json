01_1042996653844242_7392525691165321008_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bO5I7QvXtgcQ7kNvwG0KIsy&_nc_oc=AdrvSrlbqVSSfz3rER5QM--tv4PhhCPxU3f2fiqy8CJ2uIOrkUpWifppOnLeR79HfO0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2KI7zGY3q-hcxVo7esYwoc3FUdZF6GakPket_C_FDHow&oe=69DA5A10"}, {"file_name": "Screenshot11.png", "id": "1590735815120970", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974724_1590735818454303_1237625315298749935_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BBYvDPsyBA4Q7kNvwH2P29V&_nc_oc=AdrsEeSzmJtq6Z95M3LjRTP8--eouaIqZvS0LVpmrQRTNoz2-qEBFvmRsvli2CLml7w&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2fPiBS6Wukas5O07vBEh_RjbqhfAFa0_TGW7WCev6Jtw&oe=69DA5E20"}, {"file_name": "Screenshot13.png", "id": "4012487288962632", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031382_4012487292295965_8061648437973272149_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dtqQKWwdEqwQ7kNvwF-jarK&_nc_oc=AdphtqQE2LQEEWv1RJqzgo4dcgqcNFdqnlzkM9NiBV4-_-Omu5O2lE91jW2f7HlpJwM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1pidq1o8J8-omD0UJgiTF0aoOH4WJ0myq3SJgIfRTSKQ&oe=69DA58C7"}, {"file_name": "Screenshot01.png", "id": "820837333183123", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974562_820837336516456_225170929614957289_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O5th3TyW5lYQ7kNvwEXy9gW&_nc_oc=AdrAc92xTAq2qiEMJGZKawqte9AIHQb9ndDhz7DsjbhgCOk-lRW6RIAKyD6wofLrOR8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0DuSVUoE7Y6jlRTNdXrcfluOeKd5NX-yWM4dXzjDuEiA&oe=69DA3CC9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Screenshot03.png", "id": "3817162075231828", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75295751_3817162078565161_5798546731200879339_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bTVxVEsI9uYQ7kNvwHequAV&_nc_oc=Adp4weHULklbZgz-zON6rqo1OjG7Dz5h1w5WPUIOd_SX8hjck_JSAwyqziUQ9H5LbKo&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2HaDuWcTLohh31yRs4203rVYt63HNxCOOdt0U8RRFUNg&oe=69DA3A56"}, "display_name": "Backrooms", "keywords": ["thebackrooms", "noclip", "escape", "horror", "puzzle"], "long_description": "Lose yourself in a world where the ordinary becomes extraordinary. The eerie, sound design and haunting visuals combine to create a sense of dread and isolation. The backrooms are not just a physical maze but a psychological one.\n\nSolve five short puzzles in five levels of the backrooms all while evading the relentless pursuit of lurking entities!\n\nPrepare yourself for an unforgettable journey into the unknown. Can you find your way out, or will you be consumed by the darkness? The only way to know is to step inside and face the horrors that await.", "short_description": "Step into the unsettling world of \"Backrooms\", a short horror-puzzle game that plunges you into the heart of a labyrinthine nightmare!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://molancegames.com/privacy-policy-2/", "developer_terms_of_service_url": null, "publisher_name": "Molance Games", "support_website_url": "https://molancegames.com/contact-us/", "website_url": "https://molancegames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8677833488969981"}, "review_messages": []}]}, "cover_square_image"
812972029630782_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SK-ulTXdQvEQ7kNvwFVzXfx&_nc_oc=AdrKXBbfrpj2qeDQrCspOQlPiBG3HGnEBsby3ztMJmUzs9xpV_SQVjRglMDXTez3YFM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0FhfROzicNlqZVjNeT7v8pU-gVhc-j2Ak2KqQddFFouQ&oe=69EE277D"}, {"file_name": "Screenshot05.png", "id": "1042996650510909", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75458101_1042996653844242_7392525691165321008_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5_AwEDc_iLQQ7kNvwG9xHNA&_nc_oc=Adr_S4s875mThek1qif---V4mq-U9RgRbnU4zxBTKu2M66nL7DFIhEQYCuedXcSE6N8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2OOjLu1dzhI94aR1-jHkA0KCbG5TnXbnpF3vmfw1bwFQ&oe=69EE2090"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Screenshot03.png", "id": "3817162075231828", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75295751_3817162078565161_5798546731200879339_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w_Y7WT3mIvYQ7kNvwHkL-bz&_nc_oc=AdrE6X95UnFwRpJHG_FPsyclJSufi3R2-LjrksLFmCJ-q4NulUgM_mONrt1R1BSwA-0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0wJvLCsc89beFhAlh5HeALHIbnDjhgetjcFo0tQKqrGw&oe=69EE00D6"}, "display_name": "Backrooms", "keywords": ["thebackrooms", "noclip", "escape", "horror", "puzzle"], "long_description": "Lose yourself in a world where the ordinary becomes extraordinary. The eerie, sound design and haunting visuals combine to create a sense of dread and isolation. The backrooms are not just a physical maze but a psychological one.\n\nSolve five different puzzles in five levels of the backrooms all while evading the relentless pursuit of lurking entities!\n\nPrepare yourself for an unforgettable journey into the unknown. Can you find your way out, or will you be consumed by the darkness? The only way to know is to step inside and face the horrors that await.", "short_description": "Step into the unsettling world of \"Backrooms\", a short horror-puzzl
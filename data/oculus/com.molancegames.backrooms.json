01_1042996653844242_7392525691165321008_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RdH1gqW5VlkQ7kNvwE6lLD7&_nc_oc=AdrtSXDU_j5n0_9FcNnrJTpKh_r_kXw6DYZhwilmbRDh3RE8ZwOGY_4jV0yHXXAwwjY&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3WZeZ4Y4_h_U-xYH9UiKJhM_i0YcXol-E0fjTte_yV-w&oe=69E8DA90"}, {"file_name": "Screenshot11.png", "id": "1590735815120970", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974724_1590735818454303_1237625315298749935_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y14F1zNjSI0Q7kNvwEcs_AO&_nc_oc=AdqT3DJj4SCrtJEe4w47V_1SD3E9WSlEHIgJ_7G63iX8CwRXPz3wss-PlLEjSPp35zI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af12VwkyBeTrQLSoH_v54hHStrc_9JG5mSiMuzpObvS88A&oe=69E8DEA0"}, {"file_name": "Screenshot13.png", "id": "4012487288962632", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39031382_4012487292295965_8061648437973272149_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9QbTojvMg1kQ7kNvwE6dmoc&_nc_oc=Adp8ce4GV1m-L2bwaJ8FKRuuuWQf7W8w0VusLQZM9n4FnucDLP7Y6gwLTrpgslqTOnk&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3v7D4P6LVpnSfYf1NrZ1WgZRuBNJXktUWHwG2oL5KNNQ&oe=69E8D947"}, {"file_name": "Screenshot01.png", "id": "820837333183123", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974562_820837336516456_225170929614957289_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-csho2HnhwIQ7kNvwHf9bau&_nc_oc=AdrXhi0z2ZrNdYUX-jR1Ga0dNesBHUcW6mKdeq2QYHYy6-yjeZDiTzEAxVPG8_WZrCo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3z5B-u1K2i1btPDWWsC2fDJWrMo4xCQGAVNaRea1lI9Q&oe=69E8BD49"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Screenshot03.png", "id": "3817162075231828", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75295751_3817162078565161_5798546731200879339_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TGh21UMftwUQ7kNvwEF8Wes&_nc_oc=Adpl5D2207IFmKHDN6HoTWNNHgIXtyP6-yRuBcz3doFSdCilfpLHuZcv7OZ2einPi7w&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1PeEiJnyuoEfhcWU_HPCq-UHznQpLfe5uHtpjTlPMxCw&oe=69E8BAD6"}, "display_name": "Backrooms", "keywords": ["thebackrooms", "noclip", "escape", "horror", "puzzle"], "long_description": "Lose yourself in a world where the ordinary becomes extraordinary. The eerie, sound design and haunting visuals combine to create a sense of dread and isolation. The backrooms are not just a physical maze but a psychological one.\n\nSolve five short puzzles in five levels of the backrooms all while evading the relentless pursuit of lurking entities!\n\nPrepare yourself for an unforgettable journey into the unknown. Can you find your way out, or will you be consumed by the darkness? The only way to know is to step inside and face the horrors that await.", "short_description": "Step into the unsettling world of \"Backrooms\", a short horror-puzzle game that plunges you into the heart of a labyrinthine nightmare!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://molancegames.com/privacy-policy-2/", "developer_terms_of_service_url": null, "publisher_name": "Molance Games", "support_website_url": "https://molancegames.com/contact-us/", "website_url": "https://molancegames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8677833488969981"}, "review_messages": []}]}, "cover_square_image"
812972029630782_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3q4g6kCtFXsQ7kNvwFf2vy6&_nc_oc=AdrbGMEUmcboB_781pumyaKgZULqQaXaWJ934Xrk8-tc-Xf-2h2Gmllvl79ij8yaugE&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7noFZXae1S2mKogOlnCbY5Ij6qDVZnwg7RQ3OveWWKvQ&oe=69FF4AFD"}, {"file_name": "Screenshot05.png", "id": "1042996650510909", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75458101_1042996653844242_7392525691165321008_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pgq_QfgEGJoQ7kNvwFbJ6EN&_nc_oc=AdqJ6afxZInbZ9ixCE7w2nq0ne9xn1nwc6FZ590jC5z83JNjOsU9pd6tqtQXsKaycEs&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5VkfNhBxSCEKltRNklSsj7k53uzDMJbZwVmVHUbaQpKg&oe=69FF4410"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Screenshot03.png", "id": "3817162075231828", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75295751_3817162078565161_5798546731200879339_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CLcMOUUGi1oQ7kNvwHQ4tui&_nc_oc=AdqIEZzsPUFppBdtX2Tz6lv0cYiyM79jJzG_6hzFUHKzFot9C03ejre1llnao1OjkX8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4Viodl2-16nbHEZS6vbJe9xvLkQy40VsvkFgbxz1YM4g&oe=69FF2456"}, "display_name": "Backrooms", "keywords": ["thebackrooms", "noclip", "escape", "horror", "puzzle"], "long_description": "Lose yourself in a world where the ordinary becomes extraordinary. The eerie, sound design and haunting visuals combine to create a sense of dread and isolation. The backrooms are not just a physical maze but a psychological one.\n\nSolve five different puzzles in five levels of the backrooms all while evading the relentless pursuit of lurking entities!\n\nPrepare yourself for an unforgettable journey into the unknown. Can you find your way out, or will you be consumed by the darkness? The only way to know is to step inside and face the horrors that await.", "short_description": "Step into the unsettling world of \"Backrooms\", a short horror-puzzl
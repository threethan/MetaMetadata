01_1042996653844242_7392525691165321008_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RdH1gqW5VlkQ7kNvwGeVwZO&_nc_oc=AdoXs5l6PMD8NmhUMgs6jzss8mKmYmlJP2yrCZ_3O3W9e6oenTUeBAJZt7ScCsEy2DY&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2cX7X8FLEg9EMFQjv7d-P5NnzUMzPTV3h9SUWoLC2r5g&oe=69E78910"}, {"file_name": "Screenshot11.png", "id": "1590735815120970", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38974724_1590735818454303_1237625315298749935_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y14F1zNjSI0Q7kNvwH5bUtG&_nc_oc=AdpEAKOIKSwGzDig3B7Y2touidwd5Rbq3wiMmXLKWgcwFWoGuUF55Q_P1f65PmMSedM&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2n1yzJXS_sfU4wrkJFvwYMs2cwl77oAdLfKAXoYNY02g&oe=69E78D20"}, {"file_name": "Screenshot13.png", "id": "4012487288962632", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/39031382_4012487292295965_8061648437973272149_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9QbTojvMg1kQ7kNvwE2C8oV&_nc_oc=Adp7ggNPALqgyl7e8qALYYKuJ2ovWFQXSBqItHyu814lswRrUkMSqYDMAOLf-e0gO1A&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2wR6erNb3-KljcXeaupven3brdmOm1stMfQ1ZkyXElXw&oe=69E787C7"}, {"file_name": "Screenshot01.png", "id": "820837333183123", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38974562_820837336516456_225170929614957289_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a6vfxO293ssQ7kNvwHYNz4k&_nc_oc=AdpNphRnp7_-AnC__6zXnqWfURyWMWrS_yZ63yo7qAn-nDVAmSCxTyh1mQnLiSIz1Wk&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0K89mD7_qOePFUk6SEQaysRkvRdAKUWNCqoogpmD-geQ&oe=69E76BC9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Screenshot03.png", "id": "3817162075231828", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/75295751_3817162078565161_5798546731200879339_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7mUpC_Xtmw4Q7kNvwG17Zre&_nc_oc=Adptc5gXORznp6Soip94wq5xfgJe4njgkrA4rucEwnW2Lu8lqbexEWv7Ll6Stg4QN1s&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1X_6XCwG6K7IIFb6hhaTfqTq_dUSpgvUuIg6kULOg7Bw&oe=69E76956"}, "display_name": "Backrooms", "keywords": ["thebackrooms", "noclip", "escape", "horror", "puzzle"], "long_description": "Lose yourself in a world where the ordinary becomes extraordinary. The eerie, sound design and haunting visuals combine to create a sense of dread and isolation. The backrooms are not just a physical maze but a psychological one.\n\nSolve five short puzzles in five levels of the backrooms all while evading the relentless pursuit of lurking entities!\n\nPrepare yourself for an unforgettable journey into the unknown. Can you find your way out, or will you be consumed by the darkness? The only way to know is to step inside and face the horrors that await.", "short_description": "Step into the unsettling world of \"Backrooms\", a short horror-puzzle game that plunges you into the heart of a labyrinthine nightmare!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://molancegames.com/privacy-policy-2/", "developer_terms_of_service_url": null, "publisher_name": "Molance Games", "support_website_url": "https://molancegames.com/contact-us/", "website_url": "https://molancegames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8677833488969981"}, "review_messages": []}]}, "cover_square_image"
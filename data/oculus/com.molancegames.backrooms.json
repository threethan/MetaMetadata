01_1042996653844242_7392525691165321008_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pgq_QfgEGJoQ7kNvwFZxooT&_nc_oc=Adob3odC7n1q0UMeHqg2HNFMfHv2voFRTN9n11lRQi4r3AU4yRyskGM9ZMCDssSD82c&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4qoz3tN7p5Mb8AONiwn-JY3A1bReXujpw6s7TcC7xRmA&oe=69FDF290"}, {"file_name": "Screenshot11.png", "id": "1590735815120970", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974724_1590735818454303_1237625315298749935_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r3Tk20JIZx0Q7kNvwHt5jwN&_nc_oc=AdqrQAFzl_XbCRf6fKV5am2u-bawl796fUNgazUmrqnsOdZxofGtb1tP_QIf6dKmNYI&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5ieMQ2Uh6JO-DZbAVoUimbS_fnHHoTVrFqqNPGx4fl3g&oe=69FDF6A0"}, {"file_name": "Screenshot13.png", "id": "4012487288962632", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39031382_4012487292295965_8061648437973272149_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jnioUc-lbDMQ7kNvwHWFz0P&_nc_oc=Ado9hTMoNbxb5A2xcSQuq2k5TQpOoorcdS0eh9vDMXSJ-zkzwRT-AOQkIpSmyfFTnhM&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7YUD3w8uywveI4gTSVmelJnURj6BbOei7IiM67qoxJ_Q&oe=69FDF147"}, {"file_name": "Screenshot01.png", "id": "820837333183123", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974562_820837336516456_225170929614957289_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KRbC0AZEQUgQ7kNvwG-N7dY&_nc_oc=AdqinjZy7iKduocwGNJ9Y-9mx0_lx2pEb0-7vJz6EYsWG4WeCKXulY4978zRpfA8ogI&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7cLL7xfaSAMJ1tPSiNgx2xEVGJf2x-00yG32ZuaD111A&oe=69FDD549"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Screenshot03.png", "id": "3817162075231828", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/75295751_3817162078565161_5798546731200879339_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CLcMOUUGi1oQ7kNvwHnQIgk&_nc_oc=Adpeff1YbVyeTbEoGAjitjNfGjAW78mMoGdqCZhDlVecaS_hKU2dbfERbV9tMfzY1Fs&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5IQ_-R0BYhlxNzDEDpnyQrrJp6I81id2U4BJ_EqxEO7g&oe=69FDD2D6"}, "display_name": "Backrooms", "keywords": ["thebackrooms", "noclip", "escape", "horror", "puzzle"], "long_description": "Lose yourself in a world where the ordinary becomes extraordinary. The eerie, sound design and haunting visuals combine to create a sense of dread and isolation. The backrooms are not just a physical maze but a psychological one.\n\nSolve five short puzzles in five levels of the backrooms all while evading the relentless pursuit of lurking entities!\n\nPrepare yourself for an unforgettable journey into the unknown. Can you find your way out, or will you be consumed by the darkness? The only way to know is to step inside and face the horrors that await.", "short_description": "Step into the unsettling world of \"Backrooms\", a short horror-puzzle game that plunges you into the heart of a labyrinthine nightmare!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://molancegames.com/privacy-policy-2/", "developer_terms_of_service_url": null, "publisher_name": "Molance Games", "support_website_url": "https://molancegames.com/contact-us/", "website_url": "https://molancegames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8677833488969981"}, "review_messages": []}]}, "cover_square_image"
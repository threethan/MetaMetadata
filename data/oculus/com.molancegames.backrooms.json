01_1042996653844242_7392525691165321008_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AdNEj3010WAQ7kNvwF4IBrM&_nc_oc=AdqIevWDPwJC1tNfB0HJ9R0TNd_9_5_tkVM503fg9TA47I8IjXiVyyu4HbFgxPfpSWs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2sWvuKeWjuX0zifSA171Bi-Uzt6IqbvcQ-Ekdy8dDwkQ&oe=69EB7D90"}, {"file_name": "Screenshot11.png", "id": "1590735815120970", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974724_1590735818454303_1237625315298749935_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k-3wOQIt9aEQ7kNvwHR_2gX&_nc_oc=AdqBpECXGLkELiY8lLDu0Z3OIYmeFAEQ4Mfre3mCWUmPy7IVuaS6pxyay3Sc3qX95wc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0fsvOfkELZkeHupJjfb16aJcX6K--K_nRntCicIWGtSw&oe=69EB81A0"}, {"file_name": "Screenshot13.png", "id": "4012487288962632", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031382_4012487292295965_8061648437973272149_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SPFQt-wyLDUQ7kNvwFw6Per&_nc_oc=AdpimPQjVMf5MmFMgOutKNvqhP3yCJ_ugtb_r86bxgyDFn5NL-wN4mgMQmmwtBnZkok&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0dmxQ-fP8OrQmkBgTJyiQj89xWNeA2ZOAj5dp4_sgfaQ&oe=69EB7C47"}, {"file_name": "Screenshot01.png", "id": "820837333183123", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974562_820837336516456_225170929614957289_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-csho2HnhwIQ7kNvwESgErO&_nc_oc=AdrzXTx4RoxZmfahprTQopJyN-DbmVKac971eXez62BJ-KtkyrabF_Mdmm6YWeqGnp8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2jBpgWxqxLFDU-aGEXT2jJtcIs1xRf-y5YhI-29aGNjQ&oe=69EB6049"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Screenshot03.png", "id": "3817162075231828", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75295751_3817162078565161_5798546731200879339_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TGh21UMftwUQ7kNvwHQGqgf&_nc_oc=Adq2f5Cl5f_7EdXzGgHUHYkjNCQ19Em--mYgNnF_rwqsv-f-vfGz1rnzYoQJkjdCaiQ&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af38GLBDz6ROKvhWzpH5cPEnh5UCUC4Hx0dOpwcthrs-AQ&oe=69EB5DD6"}, "display_name": "Backrooms", "keywords": ["thebackrooms", "noclip", "escape", "horror", "puzzle"], "long_description": "Lose yourself in a world where the ordinary becomes extraordinary. The eerie, sound design and haunting visuals combine to create a sense of dread and isolation. The backrooms are not just a physical maze but a psychological one.\n\nSolve five short puzzles in five levels of the backrooms all while evading the relentless pursuit of lurking entities!\n\nPrepare yourself for an unforgettable journey into the unknown. Can you find your way out, or will you be consumed by the darkness? The only way to know is to step inside and face the horrors that await.", "short_description": "Step into the unsettling world of \"Backrooms\", a short horror-puzzle game that plunges you into the heart of a labyrinthine nightmare!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://molancegames.com/privacy-policy-2/", "developer_terms_of_service_url": null, "publisher_name": "Molance Games", "support_website_url": "https://molancegames.com/contact-us/", "website_url": "https://molancegames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8677833488969981"}, "review_messages": []}]}, "cover_square_image"
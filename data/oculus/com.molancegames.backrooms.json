812972029630782_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2TnhAOdDl8wQ7kNvwFf-Qcs&_nc_oc=Adr4igFxHLbtoFiKFlhXDQkh1an_S3vHnK9OHRgK-X-Q5_4cqqVYwVICSiHhiTFFd3U&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3oG_4v3T1mGL_OGayyexpfPo8uNth9epx-2FBtUGkMVg&oe=69D3913D"}, {"file_name": "Screenshot05.png", "id": "1042996650510909", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75458101_1042996653844242_7392525691165321008_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eoQ2qcRTTEwQ7kNvwHiYJhB&_nc_oc=AdpgwvrOOaxOoga6utManZ5m_LVAdsop0A_W8culXhQr3ro_JtYWJIrL7Q5HvyldRUA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0152pnsEl9yXnlcXFDpojvPKErTPmRau7qq2UGwkDh7A&oe=69D3C290"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Screenshot03.png", "id": "3817162075231828", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75295751_3817162078565161_5798546731200879339_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pgv2o4Cy2TkQ7kNvwGQ99L3&_nc_oc=AdrKkxn1OrnyCxN0TBQ4awTXMYHjQWBXBm9ERHiMVHxtlonpB_RWRGXIHGquYsIWH7k&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3FQKVhz0GQvIDUHlgtbyPLiy7Bve4e9EnMsxS1tunNBw&oe=69D3A2D6"}, "display_name": "Backrooms", "keywords": ["thebackrooms", "noclip", "escape", "horror", "puzzle"], "long_description": "Lose yourself in a world where the ordinary becomes extraordinary. The eerie, sound design and haunting visuals combine to create a sense of dread and isolation. The backrooms are not just a physical maze but a psychological one.\n\nSolve five different puzzles in five levels of the backrooms all while evading the relentless pursuit of lurking entities!\n\nPrepare yourself for an unforgettable journey into the unknown. Can you find your way out, or will you be consumed by the darkness? The only way to know is to step inside and face the horrors that await.", "short_description": "Step into the unsettling world of \"Backrooms\", a short horror-puzzl
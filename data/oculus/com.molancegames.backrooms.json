01_1042996653844242_7392525691165321008_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eoQ2qcRTTEwQ7kNvwHkMU0g&_nc_oc=AdrqGH3V09RsWH7hwyOGZKKJAXTD0qEYFG8eOZVJvBrMejCxDm5jYUkL_LK6AD7fzl4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af00lQmOv7XPMwyCqUhj2xpTPQK2uS4xz-lGJtzbQGf2ow&oe=69D27110"}, {"file_name": "Screenshot11.png", "id": "1590735815120970", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974724_1590735818454303_1237625315298749935_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5Nad3vIkYHMQ7kNvwGjp24s&_nc_oc=AdpTFrhb2xWc-3BpN4tqT3mguvSYgbpQFOJiVmAEGkKZDny8OWsoRb6gaxyP0T9F9ks&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2mmtUgXVlMdkP7Zh1VPKcjcJDUWkoDYbe3RhpIwQBQxg&oe=69D27520"}, {"file_name": "Screenshot13.png", "id": "4012487288962632", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031382_4012487292295965_8061648437973272149_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ShELnWnyRuoQ7kNvwHaJPNl&_nc_oc=AdpGdLOE3mbEpSpfVS88DdGgMtphDk_AYnl9adr6y9CYDZFm3j5ijBDx_TOaTpDn7N8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2Rulx-lm8GC4eSAkLWI8S0YyXOMYhGefMDXxhxle300g&oe=69D26FC7"}, {"file_name": "Screenshot01.png", "id": "820837333183123", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974562_820837336516456_225170929614957289_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=twYraqEgnjwQ7kNvwGBItaT&_nc_oc=Adq3K8l48MV01umITzkvsB78dC4OtgK3WGMTDsczdYJXzK19vw8u8o05mbcEbgQ3VYQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3kRRxhu5U6UBnJfVC5wkWZV7p8kQpJS-BkoIs1eB5zBw&oe=69D253C9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Screenshot03.png", "id": "3817162075231828", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75295751_3817162078565161_5798546731200879339_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pgv2o4Cy2TkQ7kNvwFFj1As&_nc_oc=AdqlGylQRuB_BOjQBBGkerqfAQDMdegbjoMA3eBwwiokVzI-JoXwguC5SWq01LzXJjI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1oqALHBmGr9JO0HKvu2-PbcHaj6O3T8Ru7bAhbICMhXA&oe=69D25156"}, "display_name": "Backrooms", "keywords": ["thebackrooms", "noclip", "escape", "horror", "puzzle"], "long_description": "Lose yourself in a world where the ordinary becomes extraordinary. The eerie, sound design and haunting visuals combine to create a sense of dread and isolation. The backrooms are not just a physical maze but a psychological one.\n\nSolve five short puzzles in five levels of the backrooms all while evading the relentless pursuit of lurking entities!\n\nPrepare yourself for an unforgettable journey into the unknown. Can you find your way out, or will you be consumed by the darkness? The only way to know is to step inside and face the horrors that await.", "short_description": "Step into the unsettling world of \"Backrooms\", a short horror-puzzle game that plunges you into the heart of a labyrinthine nightmare!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://molancegames.com/privacy-policy-2/", "developer_terms_of_service_url": null, "publisher_name": "Molance Games", "support_website_url": "https://molancegames.com/contact-us/", "website_url": "https://molancegames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8677833488969981"}, "review_messages": []}]}, "cover_square_image"
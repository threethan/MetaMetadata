01_1042996653844242_7392525691165321008_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0BVrzTxXgIUQ7kNvwHlvUTO&_nc_oc=AdpZWMiXzuVbVdl_cgO8Jrohcl_BEQQmDQrKy0T3za3eYb2R9oZWFscZJqxM1Fv1WvU&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2RL4ggKrYQdXBT38tSq05mrwI0Zx1Ydwz6LURxd1o1XA&oe=69F60990"}, {"file_name": "Screenshot11.png", "id": "1590735815120970", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38974724_1590735818454303_1237625315298749935_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BLGpaC3XN0sQ7kNvwG0cjca&_nc_oc=AdrjB6HV6xb3A1sgCYoaQr05KTKs-0rD3xBSEMO8vrP6HOwusvbNWkyczYQTHC5Iv4I&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1d1ibADRqNGI618aAPuC2eg9h9Y1LvSqSAge5FqcbbAQ&oe=69F60DA0"}, {"file_name": "Screenshot13.png", "id": "4012487288962632", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/39031382_4012487292295965_8061648437973272149_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lLOTyX_iGicQ7kNvwFMKlbr&_nc_oc=Adpu-B7w6euTjIF-Zd7VkSOjwO2OY4Vq6GKeyWiXuVhDmVbhsaRwrqouUZc1SvKWAD4&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af07JTcaH02lhVpXmN3EIZFSKYl44mNPziAIf44YKQqdDQ&oe=69F60847"}, {"file_name": "Screenshot01.png", "id": "820837333183123", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/38974562_820837336516456_225170929614957289_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u8mV41a6R74Q7kNvwERPUKo&_nc_oc=AdpZunKLzI8Dv4utOtfURxS9e-mE1QFhOMEL_USp-22i5FFgUhXN9Js6D3v_a3MnXIE&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2Gviq82qBWiRPSXIMVXERwyzv4WcWeQwqaJG5uiteW6g&oe=69F5EC49"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Screenshot03.png", "id": "3817162075231828", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/75295751_3817162078565161_5798546731200879339_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Yag7rSNC5IkQ7kNvwHVGHhD&_nc_oc=AdqMCmiolmcrnyX9Pd9vkzH0Sp7rkspMzwZfZhEonlnvbZB-SiYFnpPQvwKWmYjJlko&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1AWrwgaGB4EaSj62EyzoAPLEEpzkNSxs_Hp3W3HuQ-3A&oe=69F5E9D6"}, "display_name": "Backrooms", "keywords": ["thebackrooms", "noclip", "escape", "horror", "puzzle"], "long_description": "Lose yourself in a world where the ordinary becomes extraordinary. The eerie, sound design and haunting visuals combine to create a sense of dread and isolation. The backrooms are not just a physical maze but a psychological one.\n\nSolve five short puzzles in five levels of the backrooms all while evading the relentless pursuit of lurking entities!\n\nPrepare yourself for an unforgettable journey into the unknown. Can you find your way out, or will you be consumed by the darkness? The only way to know is to step inside and face the horrors that await.", "short_description": "Step into the unsettling world of \"Backrooms\", a short horror-puzzle game that plunges you into the heart of a labyrinthine nightmare!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://molancegames.com/privacy-policy-2/", "developer_terms_of_service_url": null, "publisher_name": "Molance Games", "support_website_url": "https://molancegames.com/contact-us/", "website_url": "https://molancegames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8677833488969981"}, "review_messages": []}]}, "cover_square_image"
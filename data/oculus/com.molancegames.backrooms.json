01_1042996653844242_7392525691165321008_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pc2vfWzWA40Q7kNvwHq_cLQ&_nc_oc=AdqPpGzNh32aOzBRh5W4ruBiGWZ1a07lS6uqvAe31xd4Inn6JQzAqQ1cE1Anb0ie7m0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afwaco6x6HTFMTP8Dviux5hysDj4dARqoZj2ZgAsl7yirw&oe=69CD2B10"}, {"file_name": "Screenshot11.png", "id": "1590735815120970", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974724_1590735818454303_1237625315298749935_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GaQS5tCDFgEQ7kNvwEPYntF&_nc_oc=AdqSVfNMvkf49L1wXgw-2-fNQ6nFssVvY1VzC8D82kJOEDX9-X4D-94rJABO5JGURT8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afy07qNwc_DOyZ9W7ZOOGnGr6SyrI57qPYtEiPoEEYJ_Cw&oe=69CD2F20"}, {"file_name": "Screenshot13.png", "id": "4012487288962632", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031382_4012487292295965_8061648437973272149_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_jVRMZ1wubEQ7kNvwH48JYC&_nc_oc=AdrRAyW3QVdD_jnec7MPkvu_3UH3S4o2lOc-TXEovV4Nej8T4-WvytHBfYeHilKfKww&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afx6QoqA61YMyJtn3TwerdYqN8i0Jw_-0AapoErdObz74A&oe=69CD29C7"}, {"file_name": "Screenshot01.png", "id": "820837333183123", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974562_820837336516456_225170929614957289_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OIn5N5gQ_KYQ7kNvwEBU93_&_nc_oc=AdpDk1v9mPGxzYeYXgNtYhN6qLHfe8El8CQLfcMWVNe_YWwF-1ucWyNdMdhI3GKqKwE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwWZGm7Dqy1dmoJ4rKUILhIDBXK7EKC5fT2iG_A9k5DOA&oe=69CD0DC9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Screenshot03.png", "id": "3817162075231828", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75295751_3817162078565161_5798546731200879339_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Sm4ux-IyfPAQ7kNvwGGodGI&_nc_oc=AdrKtXzBLI8BplbLCU60xBi3Iq4TX9tqPg23KLobHKuk0B6QsvXttrF0AZtIMbYfCd8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfynZUCD5zg5DIJDoxzA8dOVmGU6BIQ5qnN89UXnAy5kcA&oe=69CD0B56"}, "display_name": "Backrooms", "keywords": ["thebackrooms", "noclip", "escape", "horror", "puzzle"], "long_description": "Lose yourself in a world where the ordinary becomes extraordinary. The eerie, sound design and haunting visuals combine to create a sense of dread and isolation. The backrooms are not just a physical maze but a psychological one.\n\nSolve five short puzzles in five levels of the backrooms all while evading the relentless pursuit of lurking entities!\n\nPrepare yourself for an unforgettable journey into the unknown. Can you find your way out, or will you be consumed by the darkness? The only way to know is to step inside and face the horrors that await.", "short_description": "Step into the unsettling world of \"Backrooms\", a short horror-puzzle game that plunges you into the heart of a labyrinthine nightmare!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://molancegames.com/privacy-policy-2/", "developer_terms_of_service_url": null, "publisher_name": "Molance Games", "support_website_url": "https://molancegames.com/contact-us/", "website_url": "https://molancegames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8677833488969981"}, "review_messages": []}]}, "cover_square_image"
uXbr4om-bAcnTgIIzpN5g6aGaxxAheGdljQIdv9w122g&oe=69A026BD"}, {"file_name": "Screenshot05.png", "id": "1042996650510909", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75458101_1042996653844242_7392525691165321008_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x5AsMvUhMEIQ7kNvwGDpB0P&_nc_oc=Adklh3t7nK_Rw1aBwGogdjx2x6TKm7GQH5Lh_1yVykwz3WeaHlSUVFFJR_fyZ6sTAwM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfsxMOzUUZI5RCxfF9gLd3Cy8zLz4xgfuwAyMVWl-vs1xQ&oe=69A05810"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Screenshot03.png", "id": "3817162075231828", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75295751_3817162078565161_5798546731200879339_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hEnV8uOyctYQ7kNvwG3g8h8&_nc_oc=Adkf__frsGzq0QhhT_VfOMyJvmWLS3ououAdvLeflnYpC37uTcyjMmMoqxp0oA1c5Ww&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Afu63gTEknr1zjphvpQ28aVZdFLUZZh3tgcWAf-BYqf3sQ&oe=69A03856"}, "display_name": "Backrooms", "keywords": ["thebackrooms", "noclip", "escape", "horror", "puzzle"], "long_description": "Lose yourself in a world where the ordinary becomes extraordinary. The eerie, sound design and haunting visuals combine to create a sense of dread and isolation. The backrooms are not just a physical maze but a psychological one.\n\nSolve five different puzzles in five levels of the backrooms all while evading the relentless pursuit of lurking entities!\n\nPrepare yourself for an unforgettable journey into the unknown. Can you find your way out, or will you be consumed by the darkness? The only way to know is to step inside and face the horrors that await.", "short_description": "Step into the unsettling world of \"Backrooms\", a short horror-puzzle game that plunges you into the heart of a labyrinthine nightmare!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://molancegames.com/privacy-policy-2/", "developer_terms_of_service_url": null, "publisher_name": "Molance Games", "suppor
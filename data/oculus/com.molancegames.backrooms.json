01_1042996653844242_7392525691165321008_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9agiYm7lFLEQ7kNvwG0NGnr&_nc_oc=AdoHBBxe0TIfJV5Yvs8X8NjnyJzvAqMPwBfztZ3ZIo8mM11kI0Yen8iYeKPhmIEqOpk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6-TDAE9BRN5DLovmUR6zCcJv_HTTFKexULR3_JpT6lxw&oe=6A05DB90"}, {"file_name": "Screenshot11.png", "id": "1590735815120970", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974724_1590735818454303_1237625315298749935_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lm6A6QEGElcQ7kNvwGHfLEY&_nc_oc=Adre299iIvW2i21toeyOi_J8GEE22aiOWG7T_vlNWK0Y1blj_oYAH0G5B4lmhgGCVGs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7WlkLMzywo-VaqNU8-RUR99vSVhKrSISQOBVFnFjLFUg&oe=6A05DFA0"}, {"file_name": "Screenshot13.png", "id": "4012487288962632", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031382_4012487292295965_8061648437973272149_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UeuemwKKCvMQ7kNvwE8uqVz&_nc_oc=AdoggjmGAV4ajtObkhOy7Lor6rhQYr2bgNynV-6srEmJFmAS1lwg8QDxH6aNiUhqPmY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5YYHSDgSuXzjqT270mSS4KFOIRzR15BjfxmZeYrJ_4gQ&oe=6A05DA47"}, {"file_name": "Screenshot01.png", "id": "820837333183123", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974562_820837336516456_225170929614957289_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bvRUiCC-a1AQ7kNvwGxGzD7&_nc_oc=AdqMOxFZLjZpo7ACZpaHZuMXcXj7a0RMNkeg8bJTRbvWbgiAj9UM-sk5cw1sZPLgI_M&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7JIgTDVW1TSM1Mn1UPZqWppotP5vg7AYzWL_COzggV_g&oe=6A05BE49"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Screenshot03.png", "id": "3817162075231828", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75295751_3817162078565161_5798546731200879339_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-70Y0cr0H2kQ7kNvwGqdcWm&_nc_oc=AdrVV5hvCdi97kLKRc5BJfLRK8afxwFleOJbJd5VPI-4TDsUcyy3aqTDK1_tIVnOy50&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7e2oT6lYO5mmYoEbPiqtP1suThFVDGhHNn_Vm3UF7UoQ&oe=6A05BBD6"}, "display_name": "Backrooms", "keywords": ["thebackrooms", "noclip", "escape", "horror", "puzzle"], "long_description": "Lose yourself in a world where the ordinary becomes extraordinary. The eerie, sound design and haunting visuals combine to create a sense of dread and isolation. The backrooms are not just a physical maze but a psychological one.\n\nSolve five short puzzles in five levels of the backrooms all while evading the relentless pursuit of lurking entities!\n\nPrepare yourself for an unforgettable journey into the unknown. Can you find your way out, or will you be consumed by the darkness? The only way to know is to step inside and face the horrors that await.", "short_description": "Step into the unsettling world of \"Backrooms\", a short horror-puzzle game that plunges you into the heart of a labyrinthine nightmare!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://molancegames.com/privacy-policy-2/", "developer_terms_of_service_url": null, "publisher_name": "Molance Games", "support_website_url": "https://molancegames.com/contact-us/", "website_url": "https://molancegames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8677833488969981"}, "review_messages": []}]}, "cover_square_image"
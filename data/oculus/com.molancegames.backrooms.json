13.png", "id": "1831420644048794", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/75282164_1831420647382127_2465812972029630782_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UQ4CJBD2WTwQ7kNvwFHJ5R2&_nc_oc=Adrusj1FJFlhQS9wfp5d0qXVxhEydVBFdwZnE335vA2QrGCOzCNQ_yaNEH8mcUA1pTA&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afw9GOJ-V4ELTGBCPDvySvq19vZfegN_BMH9pTOfdbDp1Q&oe=69C510BD"}, {"file_name": "Screenshot05.png", "id": "1042996650510909", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/75458101_1042996653844242_7392525691165321008_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6P0bgyxz7lwQ7kNvwHpNHX6&_nc_oc=Adov9QcSPBa3DWk76M0f-wfvX_iyBv0Q8Zk_UAL1t-TzeYNqXhlzUW6Tkg7lhBVRImo&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwFx6c-Qxd1FqGfXC4062YFOVlZI97CmEN8qYLgBc2Q9g&oe=69C54210"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Screenshot03.png", "id": "3817162075231828", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/75295751_3817162078565161_5798546731200879339_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bsxIzJ55jAMQ7kNvwGuk6G8&_nc_oc=AdqNx7FPiiNPABYRxh1d4i6HiUok-tlWzCmoP3FsL0gmfQDb9vQ48vDIeA0v5kXrPH8&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxlO1_dx-FZvIZxzk1dVZb6uFFlTcxFNA0s-R1L3_mwcQ&oe=69C52256"}, "display_name": "Backrooms", "keywords": ["thebackrooms", "noclip", "escape", "horror", "puzzle"], "long_description": "Lose yourself in a world where the ordinary becomes extraordinary. The eerie, sound design and haunting visuals combine to create a sense of dread and isolation. The backrooms are not just a physical maze but a psychological one.\n\nSolve five different puzzles in five levels of the backrooms all while evading the relentless pursuit of lurking entities!\n\nPrepare yourself for an unforgettable journey into the unknown. Can you find your way out, or will you be consumed by the darkness? The only way to know is to step inside and face the horrors that await.", "short_description": "Step into the unsettling world of \"Backrooms\", a short horror-puzzle game that plunges you into the heart of a labyrinthine nightmare!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://molancegames.com/privacy-policy-2/", "developer_terms_of_service_url": null, "publisher_name": "Molance Games", "support_website_url": "https://molancegames.com/contact-us/", "website_url": "https://molancegames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8101366073283395"}}]}, "scheduled_offers": {"count": 14, "nodes": [{"status": "PUBLISHED", "id": "1184535762823766"}, {"status": "PUBLISHED", "id": "1220331889106782"}, {"status": "PUBLISHED", "id": "939589584850469"}, {"status": "PUBLISHED", "id": "891023260586064"}, {"status": "PUBLISHED", "id": "2570801936649806"}, {"status": "PUBLISHED", "id": "3946119218851546"}, {"status": "PUBLISHED", "id": "822934363984838"}, {"status": "PUBLISHED", "id": "752485697818993"}, {"status": "PUBLISHED", "id": "699131099821221"}, {"status": "PUBLISHED", "id": "579869458225833"}, {"status": "PUBLISHED", "id": "1032304478806363"}, {"status": "PUBLISHED", "id": "1349555679394558"}, {"status": "PUBLISHED", "id": "942077121356897"}, {"status": "PUBLISHED", "id": "1222191202326339"}]}, "baseline_offer": {"id": "1222191202326339"}, "is_approved": true, "firstOffer
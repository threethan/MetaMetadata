01_1042996653844242_7392525691165321008_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jdzLAlCP2h4Q7kNvwGuxBlM&_nc_oc=AdoQ2k1UVl4ccAFdq77Y28gw_TZsRAXDyuJiSxWpvsXyBuaHxatg2ZncnTlZNRxzf4Y&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2ZZ8eOJ_etymB_Cf6HBvOOPsibowZ4lkQwwBTzq-1Gfw&oe=69E39490"}, {"file_name": "Screenshot11.png", "id": "1590735815120970", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974724_1590735818454303_1237625315298749935_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2h6R8-rP0R0Q7kNvwE2E2MR&_nc_oc=AdrfAuVfx_Z9K1HhidWctiyYXrdO8JjpEMEI7tpWl_bUaCOUmhDyTEbGYDbC6ZN0po0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2t1XjeF8sLm_ReZPIjE4Kkqr7J_H2R4wlN5jvUtvmKjQ&oe=69E398A0"}, {"file_name": "Screenshot13.png", "id": "4012487288962632", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031382_4012487292295965_8061648437973272149_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mDVbLlCpTFoQ7kNvwGXWcMr&_nc_oc=Adr7C16PwR60esg-5s6_hoSlF0LFNkfwrN-lOiXN0M7tXb-4Tmo_UndFr43-0ZcHkeU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af24wOXfqCBy2eLs_wkjDM7ASRTA7dSczqin6Lu86adYtw&oe=69E39347"}, {"file_name": "Screenshot01.png", "id": "820837333183123", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974562_820837336516456_225170929614957289_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3UKF09o7WLIQ7kNvwF_yH_k&_nc_oc=Adps-n6sW57-8nQXDRlpbj6dfnFY7va8dpzD-bowhoZGo-lfzsWlXVixCrUo_hdQvkI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2fNT-dfBAgqfsPqXv_2ZFz5KBpOMM0R_MozOWuwjrKYw&oe=69E37749"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Screenshot03.png", "id": "3817162075231828", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75295751_3817162078565161_5798546731200879339_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=db8FcFAla8QQ7kNvwEnsine&_nc_oc=Adqpu0fcp3aw6c8Q6CufLmSQyaNcXdLUTiAtKmV0NLqLkpCnRdFDnCSkU1GgkDr7erM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af01C1nFOeizIEXoaiz-NoMZ6fz8l_uyEuKdHkDpLf_iNg&oe=69E374D6"}, "display_name": "Backrooms", "keywords": ["thebackrooms", "noclip", "escape", "horror", "puzzle"], "long_description": "Lose yourself in a world where the ordinary becomes extraordinary. The eerie, sound design and haunting visuals combine to create a sense of dread and isolation. The backrooms are not just a physical maze but a psychological one.\n\nSolve five short puzzles in five levels of the backrooms all while evading the relentless pursuit of lurking entities!\n\nPrepare yourself for an unforgettable journey into the unknown. Can you find your way out, or will you be consumed by the darkness? The only way to know is to step inside and face the horrors that await.", "short_description": "Step into the unsettling world of \"Backrooms\", a short horror-puzzle game that plunges you into the heart of a labyrinthine nightmare!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://molancegames.com/privacy-policy-2/", "developer_terms_of_service_url": null, "publisher_name": "Molance Games", "support_website_url": "https://molancegames.com/contact-us/", "website_url": "https://molancegames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8677833488969981"}, "review_messages": []}]}, "cover_square_image"
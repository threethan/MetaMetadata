01_1042996653844242_7392525691165321008_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HaRwUPPHhWkQ7kNvwER7nJh&_nc_oc=AdpUzM2-8ObyFvCIMyHf_muubjgrTNQzgSlwXnwfM0muhS63VWDu6wJmIerN5M1NjyA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6qBmPiJFsAYXutz7ScSUfyh5x6t9dhEfsuaUSORCycNw&oe=69FCA110"}, {"file_name": "Screenshot11.png", "id": "1590735815120970", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974724_1590735818454303_1237625315298749935_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r3Tk20JIZx0Q7kNvwEXNcqJ&_nc_oc=Adoiyx-LtWPatsuPwt5WQB0jJTknuwG-C7YDLc1s-XsvZd9PGLlWc-9La-TiSNDZ1Es&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af71nBQWvhuJzhz-bd0J7jJi3mAo6_vQ2wdL4o6t1cjgog&oe=69FCA520"}, {"file_name": "Screenshot13.png", "id": "4012487288962632", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031382_4012487292295965_8061648437973272149_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jnioUc-lbDMQ7kNvwGhY1lT&_nc_oc=Ado48YECs6qsn1uvjX01ZKfjTYf2Boos44uJ1KpI9tWE_zeMvmDTSk7USK5XBY2pm1s&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6zJQ5M3rvI0d_3kBXfgua0R8UCz40n165twOO4fWSxAw&oe=69FC9FC7"}, {"file_name": "Screenshot01.png", "id": "820837333183123", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974562_820837336516456_225170929614957289_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KRbC0AZEQUgQ7kNvwF0ajsr&_nc_oc=AdoyNdDEHSpxyh9JsMLc_XK-aYXsvQqdEDERAq9LxlYAwI1tSJdorTWkqNBadNVyhlQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af42QOeRCy4slgWj7tY9GouIxXhIrEwpIAn2R6Q4Igp8Dg&oe=69FC83C9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Screenshot03.png", "id": "3817162075231828", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75295751_3817162078565161_5798546731200879339_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CLcMOUUGi1oQ7kNvwHz7jFe&_nc_oc=AdoZpTUmsWZJcTfWBUn15wyF16YBSkNStfQ-IRUBbu-KaxnqP0oezwLt5bjLBeGuLVc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6MmrOqvLGlQFPZRY03X--4mLmxFAGMbq3zS9e03TmO0w&oe=69FC8156"}, "display_name": "Backrooms", "keywords": ["thebackrooms", "noclip", "escape", "horror", "puzzle"], "long_description": "Lose yourself in a world where the ordinary becomes extraordinary. The eerie, sound design and haunting visuals combine to create a sense of dread and isolation. The backrooms are not just a physical maze but a psychological one.\n\nSolve five short puzzles in five levels of the backrooms all while evading the relentless pursuit of lurking entities!\n\nPrepare yourself for an unforgettable journey into the unknown. Can you find your way out, or will you be consumed by the darkness? The only way to know is to step inside and face the horrors that await.", "short_description": "Step into the unsettling world of \"Backrooms\", a short horror-puzzle game that plunges you into the heart of a labyrinthine nightmare!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://molancegames.com/privacy-policy-2/", "developer_terms_of_service_url": null, "publisher_name": "Molance Games", "support_website_url": "https://molancegames.com/contact-us/", "website_url": "https://molancegames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8677833488969981"}, "review_messages": []}]}, "cover_square_image"
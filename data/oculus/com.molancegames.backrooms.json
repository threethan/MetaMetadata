01_1042996653844242_7392525691165321008_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eoQ2qcRTTEwQ7kNvwEqMB-N&_nc_oc=AdqbIxolAvAOENgiHlDyOua1MW6ltZrHdnIQmqbXUycSwyZeSVpc4XaJA7uGr4tj8w0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0uEMgE_BdoQP1cG8OYEjEEC-jDMH7qZuhe5N8m4vKjkw&oe=69D51410"}, {"file_name": "Screenshot11.png", "id": "1590735815120970", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974724_1590735818454303_1237625315298749935_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ycs1qiJ48awQ7kNvwE-6wwB&_nc_oc=AdpE2e-9fkZ3LgzU-RKeVpIVSdFRy9pSx9D1XfDuRPM_klCVb306Ny9yLdyG2gffo_Y&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2SeN1AobvP5lJhgf50j9geq2Wr1d0yqZCYUq2qzzXBUA&oe=69D51820"}, {"file_name": "Screenshot13.png", "id": "4012487288962632", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031382_4012487292295965_8061648437973272149_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dcvdPa0gqw4Q7kNvwGsbeVY&_nc_oc=AdocjsyNWixjM8H-KKWfZ9mATL0tvFy2G-Ssbhz1h6BrE1MbTX6PIwVwC4UaWy7c86A&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3i_rS5Zvo7wR0DhNHQdVNZTgyZTQqtagJojfWZJDXzMQ&oe=69D512C7"}, {"file_name": "Screenshot01.png", "id": "820837333183123", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974562_820837336516456_225170929614957289_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=06SmDFV50moQ7kNvwHNxlaL&_nc_oc=Adqaxu_lh_EARCHgztlruoM6u4EidB4hDbNOtPhzS2PEl_GU1HJS8De22OJhzWxyqmQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af177aI_OFEFidsNfcMHVTHatrO4z4kWr6eXKK6dHpLPOg&oe=69D4F6C9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Screenshot03.png", "id": "3817162075231828", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75295751_3817162078565161_5798546731200879339_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nas2Eb4-L5gQ7kNvwEsjo5L&_nc_oc=AdrVx-fuIAl4cGQ7pn-HCcINpktBC8LBb2r-WWMxKtqvisrt8ZXe8qUbn0XMjZFL9VA&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3FcLRcZiD3jyB4mpF2_zZVRj4H4cAf_9zzVc6mAlCU9A&oe=69D4F456"}, "display_name": "Backrooms", "keywords": ["thebackrooms", "noclip", "escape", "horror", "puzzle"], "long_description": "Lose yourself in a world where the ordinary becomes extraordinary. The eerie, sound design and haunting visuals combine to create a sense of dread and isolation. The backrooms are not just a physical maze but a psychological one.\n\nSolve five short puzzles in five levels of the backrooms all while evading the relentless pursuit of lurking entities!\n\nPrepare yourself for an unforgettable journey into the unknown. Can you find your way out, or will you be consumed by the darkness? The only way to know is to step inside and face the horrors that await.", "short_description": "Step into the unsettling world of \"Backrooms\", a short horror-puzzle game that plunges you into the heart of a labyrinthine nightmare!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://molancegames.com/privacy-policy-2/", "developer_terms_of_service_url": null, "publisher_name": "Molance Games", "support_website_url": "https://molancegames.com/contact-us/", "website_url": "https://molancegames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8677833488969981"}, "review_messages": []}]}, "cover_square_image"
812972029630782_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G93fv3fKutAQ7kNvwE45QZV&_nc_oc=Adp3TA6xP0FjU5sHDO3vCkD_Cz1LM7-OgF9u5u4nhZaVejOiV2sqPQJ_nwXM1rgiKVI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afw3itplfrKQEZD73gHr_BpMUA3269b6t6mtqfcF-mSX7Q&oe=69CE4B3D"}, {"file_name": "Screenshot05.png", "id": "1042996650510909", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75458101_1042996653844242_7392525691165321008_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gawxgVVPRJ8Q7kNvwGbOiGj&_nc_oc=Adr32EYD4KSofsa8BqQrSUoA-XNvZaDRipZYxT4APN__W-RhpPtiqAWH2RqlzyIeeGg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxHW3GdXdgioCTVBcw-7XdPfe5riIcwZSIyKJ1-azP95A&oe=69CE7C90"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Screenshot03.png", "id": "3817162075231828", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75295751_3817162078565161_5798546731200879339_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Sm4ux-IyfPAQ7kNvwHV-JeT&_nc_oc=AdoYT9Z8fe69vK6LLqFgQ9E0l3Cq-Puw_ak1ZDO5wLfON9rZD-GjxFCGJ8TXyGI6yiY&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Afwvay-iSaX9HuRMcFU8QBjSPFa7TeZ1eBkl9cDkRX9THA&oe=69CE5CD6"}, "display_name": "Backrooms", "keywords": ["thebackrooms", "noclip", "escape", "horror", "puzzle"], "long_description": "Lose yourself in a world where the ordinary becomes extraordinary. The eerie, sound design and haunting visuals combine to create a sense of dread and isolation. The backrooms are not just a physical maze but a psychological one.\n\nSolve five different puzzles in five levels of the backrooms all while evading the relentless pursuit of lurking entities!\n\nPrepare yourself for an unforgettable journey into the unknown. Can you find your way out, or will you be consumed by the darkness? The only way to know is to step inside and face the horrors that await.", "short_description": "Step into the unsettling world of \"Backrooms\", a short horror-puzzl
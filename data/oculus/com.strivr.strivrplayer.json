dn.com/v/t64.5771-25/38974608_23988158490829511_8465806668733963347_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Pkex8ojDL04Q7kNvwGsMV1J&_nc_oc=Adm5uNL2X9a5WfPSqZggVETv3LrG21MPIlFTjXhKn3AL84m1WcEd7JXKN80b7AixrPQ&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_AfzE2LAuJjOsA3rmpUcDev2gobxFy7mZUrpm0vNrUSxTSg&oe=69BAB405"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "07 2560x1440.png", "id": "425446353036229", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/57568674_425446359702895_91003828421151123_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BS-5hRjDFgwQ7kNvwEcnwwE&_nc_oc=AdnUoPqU19cSYfIDOOUHgDgdmdeXJHxdZ4rNzm6281BhSt1Fhv7PBc7_u1q7L0FgTSc&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=8&oh=00_Afz-Nw9qojfM1K3Y7_GHrWlMawgcgnZpK72UeRKHalvBQA&oe=69BA823B"}, "display_name": "Strivr: VR for the enterprise", "keywords": ["training", "enterprise", "performance", "employee", "train"], "long_description": "Strivr\u2019s Enterprise VR Platform is the platform of choice for Fortune 1000 enterprises to scale VR and build skills across their entire workforce. Strivr\u2019s platform empowers enterprises to build, manage, experience, and measure VR-based learning to optimize workforce performance. With a premium content offering based on nearly 60,000 hours of content creation experience, Strivr customers gain unique learning and assessment data to measure training effectiveness and predict learning outcomes at scale. With nearly 2M sessions conducted in VR from hiring to training and upskilling, Strivr is proud to partner with Fortune 1000 companies to elevate performance through immersive experience.\n\nExperience Strivr today", "short_description": "Strivr is the platform of choice for enterprise VR to elevate workforce performance at scale. Discover Strivr in action today."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.strivr.com/privacy/", "developer_terms_of_service_url": null, "publisher_na
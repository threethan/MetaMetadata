dn.com/v/t64.5771-25/38974608_23988158490829511_8465806668733963347_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dus4N_Ak4lIQ7kNvwGqhlwd&_nc_oc=AdmZktPzk19ZGyuYHQC0fnn00EUTuI7-uo3ougWDjnIxIptfKjHYP2bC_H5majZ6sZ8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfzLXQAX21wwG9Lg8D-_eOkU97PN-GRNdSUMryx4sLYv1A&oe=69AED685"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "07 2560x1440.png", "id": "425446353036229", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/57568674_425446359702895_91003828421151123_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Vk3F_5UTfdQQ7kNvwFwC5Lk&_nc_oc=Adk9Un_Bu85scS9RpjazTL-9yBPo5oPAdHfslacoKMtrBPNr9nXqkNGRewpGmBj5i9w&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afy7wztB4o9Y7TJMFfnPahW_csffTozpJ0f9BBDIKTtRhQ&oe=69AEA4BB"}, "display_name": "Strivr: VR for the enterprise", "keywords": ["training", "enterprise", "performance", "employee", "train"], "long_description": "Strivr\u2019s Enterprise VR Platform is the platform of choice for Fortune 1000 enterprises to scale VR and build skills across their entire workforce. Strivr\u2019s platform empowers enterprises to build, manage, experience, and measure VR-based learning to optimize workforce performance. With a premium content offering based on nearly 60,000 hours of content creation experience, Strivr customers gain unique learning and assessment data to measure training effectiveness and predict learning outcomes at scale. With nearly 2M sessions conducted in VR from hiring to training and upskilling, Strivr is proud to partner with Fortune 1000 companies to elevate performance through immersive experience.\n\nExperience Strivr today", "short_description": "Strivr is the platform of choice for enterprise VR to elevate workforce performance at scale. Discover Strivr in action today."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.strivr.com/privacy/", "developer_terms_of_service_url": null, "publisher_na
dn.com/v/t64.5771-25/38974608_23988158490829511_8465806668733963347_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JCZZzRGX1ccQ7kNvwH2_Egu&_nc_oc=AdnPiZd9BHGJqaf6nre_KP4hrjcdIC3sSt9Wludjx-vRnhNhKO5n_UoUEduvilLN5Vs&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfyVhawxPLlyMC6EDbbmvmKA8OcZCdH2qKimj4tUbKKd3w&oe=69B2CB05"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "07 2560x1440.png", "id": "425446353036229", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/57568674_425446359702895_91003828421151123_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rYRLuG-aaV0Q7kNvwHCZRvF&_nc_oc=Adl6wbYlaZuYGFlfW4p3Vq59D_fVb_aAPNKi6dvE9aydAv-x4h7AQdgfmFA0miESmbI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_Afy-S5STZaLYZRwg1a7JJfZeccyTo9usAjl2hm4sIepACQ&oe=69B2993B"}, "display_name": "Strivr: VR for the enterprise", "keywords": ["training", "enterprise", "performance", "employee", "train"], "long_description": "Strivr\u2019s Enterprise VR Platform is the platform of choice for Fortune 1000 enterprises to scale VR and build skills across their entire workforce. Strivr\u2019s platform empowers enterprises to build, manage, experience, and measure VR-based learning to optimize workforce performance. With a premium content offering based on nearly 60,000 hours of content creation experience, Strivr customers gain unique learning and assessment data to measure training effectiveness and predict learning outcomes at scale. With nearly 2M sessions conducted in VR from hiring to training and upskilling, Strivr is proud to partner with Fortune 1000 companies to elevate performance through immersive experience.\n\nExperience Strivr today", "short_description": "Strivr is the platform of choice for enterprise VR to elevate workforce performance at scale. Discover Strivr in action today."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.strivr.com/privacy/", "developer_terms_of_service_url": null, "publisher_na
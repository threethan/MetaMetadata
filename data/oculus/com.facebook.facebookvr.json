 is easy. Discover, enjoy and do more together.\n\n-Stay up to date with your loved ones\n-Connect with people who share your interests with Groups\n-Become more involved with your community with events, local recommendations, and fundraisers\n-Enjoy entertainment together with Watch\n-Buy and sell with Marketplace", "short_description": "The Facebook app helps you connect with friends, family and communities of people who share your interests. Connecting with your friends and family, as well as discovering new ones, is easy with features such as Groups, Watch and Marketplace."}]}, "developer_name": "Facebook, Inc.", "developer_privacy_policy_url": "https://www.facebook.com/about/privacy", "developer_terms_of_service_url": "https://www.facebook.com/legal/terms", "publisher_name": "Facebook, Inc.", "support_website_url": null, "website_url": "https://www.facebook.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1228796255027646"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SOCIAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["kk", "nn", "tt", "es_VE", "de", "hi", "mn", "km", "su", "fi", "kn", "lo", "ps", "ru", "sv", "ko", "pt", "sw", "nl_BE", "mri", "af", "bg", "gl", "mr", "srd", "uz", "ms", "el", "gn", "lt", "bel", "en", "fo", "ak", "eo", "hr", "is", "lv", "tuk", "pt_BR", "it", "roh", "am", "bn", "co", "fr", "jv", "hu", "ta", "es", "gu", "et", "br", "cs", "eu", "kin", "ar", "en_GB", "bs", "fr_CA", "hy", "pa", "te", "lin", "as", "fy", "tg", "vi", "zh_TW", "fuc", "nb", "en_US", "th", "zh_HK", "mya", "cy", "sa_IN", "ka", "si", "uk", "ory", "ja", "ne", "sk", "tl", "az", "sl", "ga", "ckb", "mg", "es_CL", "fa", "id", "pl", "so", "es_MX", "zh_CN", "da", 
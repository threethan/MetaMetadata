ated_image.png", "id": "534263077228752", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/11162687_836456139869418_4437412463352217600_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BonodjgW7vYQ7kNvwHm-6yz&_nc_oc=Adpk1cFDdGPKFTfITQa9XL7HtOMQ7fCoZ6Nx5OdKNdHnN9Xyg8sJsklycuoSTnWgZ70&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEPrUT-qQ26isLuYBrr2yWaaXaIRzeodm1y8_NzP7LhXg&oe=6A92B6F8"}, {"file_name": "migrated_image.png", "id": "137456474369213", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/11162685_1040540019410849_6355035770977255424_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HAheSrbj9O8Q7kNvwEQYYdD&_nc_oc=AdpAAVF6mqpJHyGrQpi6KJ9ey9DNpfOh_mt368w6kOWPJud_0Wx1iKb8jA7LOFhwU98&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHfdIL9WMDc7dQR9lY0lCt1gkMh2TSRtfTTzwnPrW_wzQ&oe=6A92DF29"}, {"file_name": "migrated_image.png", "id": "218765856034101", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/11162679_256561344831711_3743039293812113408_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yxDkkou3ofQQ7kNvwEEndWD&_nc_oc=Ados0SedSQL36W9yZETNHMooj14hBn8E0_PCvsFwq6r7L8hiX_UzJ9lirohFUDMK7sM&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHXR2IpQdBMnA2Udp6NuOGvQ_5qBqL3ygs_3hfL5x2jJg&oe=6A92AF92"}, {"file_name": "migrated_image.png", "id": "234924897699435", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/11162706_1728905930751814_7028473375836078080_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OyrgznUIoogQ7kNvwFE5Bgb&_nc_oc=AdqlX34XLeF7VAr9QoFEl8xcYkSzNrbOKzAx1GZ0M5X-h4JwJabNteXUNl36Br_AeZk&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE_YzRSSeDo1GJTyhvhPVM4EwfrUKTDQ3SjWzFXDUKFvg&oe=6A92D85D"}, {"file_name": "migrated_image.png", "id": "515145839183615", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/11162678_230384594120460_660784412161474560_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KQqGlUT8BAoQ7kNvwGenzBD&_nc_oc=AdrKBBJGV7vBbtS_L248UzoxaL3PaH9tJM4WDCzFUU-sAe4_CWLByxo8YwxMNsEO1Kk&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGjzMPzRsC1UlhsnK7-BFHQvshes11GhDvMOw2-F2NB3g&oe=6A92B688"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Apollo 11 VR Mobile", "keywords": ["Space", "Apollo11", "Moon", "Education", "Science"], "long_description": "Apollo 11 VR is the story of the greatest journey ever taken by humankind. \n\nNow for the first time ever, you get to experience this historic event through the eyes of those who lived through it. Using a mix of original archive audio and video together with accurate recreations of the spacecraft and locations, all set to inspirational music. Get set for an experience that will not only educate you but will also leave a lasting impression and deep respect for the men and women who worked on the Apollo program during NASA\u2019s golden era.\n\nApollo 11 VR is a new type of documentary, not only do you get to relive the events of 1969, you can also take control and fly the command module, land the lunar lander, explore the Moon's surface and deploy the lunar experiments all before returning to earth in a fiery re-entry.\n\nTake one small step today and climb aboard Apollo 11 for the journey of a lifetime.", "short_description": "Apollo 11 VR is the story of the greatest journey ever taken by humankind. This VR experience is a recreation of the events which took place between July 16th and July 24th 1969. Now for the first time ever you get to experience this historic event through the eyes of those who lived through it."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.immersivevreducation.com/", "developer_terms_of_service_url": "http://www.immersivevreducation.com/", "publisher_name": "Immersive VR Education Ltd.", "support_website_url": null, "website_url": "http://www.immersivevreducation.com/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_ta
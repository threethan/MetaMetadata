ated_image.png", "id": "534263077228752", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/11162687_836456139869418_4437412463352217600_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mmlDtIUxMtQQ7kNvwHpOc7g&_nc_oc=AdrLZwj24Jqh2CybAFT2xQVbc3QoNFYwh0ihcI_9LdPN0AUzh6QiUVRGO36IddIIjzs&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJjxLDFO98qpoe8b4-NCpBxhckqFG8NYvqtAVaG9oPPZQ&oe=6AB3E4B8"}, {"file_name": "migrated_image.png", "id": "137456474369213", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/11162685_1040540019410849_6355035770977255424_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dCjAD4FIsbUQ7kNvwHjDLA4&_nc_oc=Adp2xdPGdlW13pPfu91N88bCYSoxA6_sb-2q3qKOCcVEysMJlYYhY7c8QMylZC9ekmE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIDIv0ssy3dNhGV1xVO2QoANqlwnZbPp2egpq5-iFe6ZA&oe=6AB3D4A9"}, {"file_name": "migrated_image.png", "id": "218765856034101", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/11162679_256561344831711_3743039293812113408_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-1aw32kVHuEQ7kNvwGYRZX4&_nc_oc=AdoH5Ax8_Ghvw2XQW1oxpFeUkPYUeqTB1ckFHl_MCVkvWwyVI4CMEtWYKNji1dC9iXY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIhB8Oss1iE1Xnx8IZRskLbXoW2Usp5j3_UKO-AHySOiA&oe=6AB3DD52"}, {"file_name": "migrated_image.png", "id": "234924897699435", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/11162706_1728905930751814_7028473375836078080_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a1kvFF1IBnsQ7kNvwF3xNQw&_nc_oc=AdqrIhZL39eTeVZIWDhqDS-uThGDSgF_D5YvZMbHWpyLlhlZdUBHzkWRqN6JpugBBXk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJI1LhCXs1DW5LyTV_0_H5oEBstENQZZ29DzDCZZr8QWw&oe=6AB3CDDD"}, {"file_name": "migrated_image.png", "id": "515145839183615", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/11162678_230384594120460_660784412161474560_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mWtFTaR4NyAQ7kNvwHwTbKb&_nc_oc=Adogn5rbxGUMY2cCaj9rqo6789z-W0OdVAwbDpxYkp7S4qVhDthAFM1LYHsA-HIvOuo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIttmc968CQpwenK-5PjCOYj790g_gSHAexuHU1czWuzA&oe=6AB3E448"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Apollo 11 VR Mobile", "keywords": ["Space", "Apollo11", "Moon", "Education", "Science"], "long_description": "Apollo 11 VR is the story of the greatest journey ever taken by humankind. \n\nNow for the first time ever, you get to experience this historic event through the eyes of those who lived through it. Using a mix of original archive audio and video together with accurate recreations of the spacecraft and locations, all set to inspirational music. Get set for an experience that will not only educate you but will also leave a lasting impression and deep respect for the men and women who worked on the Apollo program during NASA\u2019s golden era.\n\nApollo 11 VR is a new type of documentary, not only do you get to relive the events of 1969, you can also take control and fly the command module, land the lunar lander, explore the Moon's surface and deploy the lunar experiments all before returning to earth in a fiery re-entry.\n\nTake one small step today and climb aboard Apollo 11 for the journey of a lifetime.", "short_description": "Apollo 11 VR is the story of the greatest journey ever taken by humankind. This VR experience is a recreation of the events which took place between July 16th and July 24th 1969. Now for the first time ever you get to experience this historic event through the eyes of those who lived through it."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.immersivevreducation.com/", "developer_terms_of_service_url": "http://www.immersivevreducation.com/", "publisher_name": "Immersive VR Education Ltd.", "support_website_url": null, "website_url": "http://www.immersivevreducation.com/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_ta
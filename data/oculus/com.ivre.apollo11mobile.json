ated_image.png", "id": "534263077228752", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/11162687_836456139869418_4437412463352217600_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ixqSlyjWQ5EQ7kNvwFbM1zx&_nc_oc=AdoCS6VYL7_mAJtisWaCoz1Z-gtVBesXZ-i0N0F9knvVZgPkm0DBDoeo9g40t8LpxSg&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9FYdR3svCbwztB4UacFSPj0mjvWmMfd-fDS1YX5r_Stg&oe=6A218E38"}, {"file_name": "migrated_image.png", "id": "137456474369213", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/11162685_1040540019410849_6355035770977255424_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=50vgstWzb1cQ7kNvwEuGpiM&_nc_oc=Adomjm0SMAC9ugN0SfVyw-pxi7rcODMh6rzS7aTt8CvLJmYpoPTd2C3LQe8NEpI1nQQ&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_lEBMrbZk0rXZEDUXCkQxVRjaj8z5d2TogDyl1cX0GZQ&oe=6A217E29"}, {"file_name": "migrated_image.png", "id": "218765856034101", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/11162679_256561344831711_3743039293812113408_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZSH-V3A7zscQ7kNvwF_WWSF&_nc_oc=AdoCFJ-LxDlcZ9kdGyFFl8q-NQ6pb8ef2AnHHU4uSIDd17wETBM5ZnynP9iDVJaXz1U&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9dSnuL4_9r7dUaXHLr_j9Z2sSZ-eFtefjz0bw2VXcdhw&oe=6A2186D2"}, {"file_name": "migrated_image.png", "id": "234924897699435", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/11162706_1728905930751814_7028473375836078080_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hlkcVuR6zvAQ7kNvwHZ9FMt&_nc_oc=AdpFZoimjKj2_Yy3KONj-VjR-Xcdl_rQAC_u1zzD1i1TCqZf6JVcPebhBVMxIl-Gv58&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_zS5MbnBn-X9UnfTkyEGm2KB9EURhYJajSYj3eWuepZg&oe=6A21775D"}, {"file_name": "migrated_image.png", "id": "515145839183615", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/11162678_230384594120460_660784412161474560_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZF_p0zX8pS0Q7kNvwHexUGm&_nc_oc=Adqrb5M8RWkeO0P1BTGF6o0DE3qVwHtx77UMJObf5d0hktLo5eNDXPRPyVWTdiYUUdo&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af86OUr1xRq7lzqS-UbdYqlYTKfNwrQW_JlD993oapgoVQ&oe=6A218DC8"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Apollo 11 VR Mobile", "keywords": ["Space", "Apollo11", "Moon", "Education", "Science"], "long_description": "Apollo 11 VR is the story of the greatest journey ever taken by humankind. \n\nNow for the first time ever, you get to experience this historic event through the eyes of those who lived through it. Using a mix of original archive audio and video together with accurate recreations of the spacecraft and locations, all set to inspirational music. Get set for an experience that will not only educate you but will also leave a lasting impression and deep respect for the men and women who worked on the Apollo program during NASA\u2019s golden era.\n\nApollo 11 VR is a new type of documentary, not only do you get to relive the events of 1969, you can also take control and fly the command module, land the lunar lander, explore the Moon's surface and deploy the lunar experiments all before returning to earth in a fiery re-entry.\n\nTake one small step today and climb aboard Apollo 11 for the journey of a lifetime.", "short_description": "Apollo 11 VR is the story of the greatest journey ever taken by humankind. This VR experience is a recreation of the events which took place between July 16th and July 24th 1969. Now for the first time ever you get to experience this historic event through the eyes of those who lived through it."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.immersivevreducation.com/", "developer_terms_of_service_url": "http://www.immersivevreducation.com/", "publisher_name": "Immersive VR Education Ltd.", "support_website_url": null, "website_url": "http://www.immersivevreducation.com/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_ta
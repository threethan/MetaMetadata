ated_image.png", "id": "534263077228752", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/11162687_836456139869418_4437412463352217600_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bChV_Xl5vY0Q7kNvwEP6Rns&_nc_oc=AdoO9gL_swdkw4yq4P6y_kfyk_edJyu5eLTAxnF8TV3FvmKuyEo8kOQQcMOIyxph-bM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNWuCKkj36S1-c_HN7P9HmJkhM1TwKne3stSUmm5G-cYw&oe=6AD23738"}, {"file_name": "migrated_image.png", "id": "137456474369213", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/11162685_1040540019410849_6355035770977255424_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_fcaR-6D8iYQ7kNvwH9bqw6&_nc_oc=AdqCpgpCzl1XFafRMjMm-Xi5NJWeE7X3UiERZdO0I_Ualw-ZH6957Hu-K0wKr7lMD_A&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO0Zmt_g9DRQ5JCT5ZFif2S62VekTaWvLAZ2Ht-sHQV6A&oe=6AD22729"}, {"file_name": "migrated_image.png", "id": "218765856034101", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/11162679_256561344831711_3743039293812113408_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Mf2wQT5YaKMQ7kNvwEr7fHf&_nc_oc=AdqZhZNPugnv7b_e7r8FrPsBwhDwGXOXo76u0SfHyuqLn2-qvcPJfceYxH3hv1ZXgj4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM9DO8brtL37ZovpU1ET4WBIMfguGzCL7IYCxosWcmk6w&oe=6AD22FD2"}, {"file_name": "migrated_image.png", "id": "234924897699435", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/11162706_1728905930751814_7028473375836078080_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bBYpZ5ZEWnUQ7kNvwFQh0lw&_nc_oc=AdpH2Ot98FqiUm0kNj3F4ZsL8r4OeqLB8E_Q11Q7fWUMafFMUK9o8SLqpfYr4x_VQ5E&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPPvXw-GIxcNnCeKGoaexA-0PgGgOnmHbE5xalbcpwJkQ&oe=6AD2589D"}, {"file_name": "migrated_image.png", "id": "515145839183615", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/11162678_230384594120460_660784412161474560_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=39-YTIeBVo0Q7kNvwG2ZFtn&_nc_oc=AdoCx2sw1Cz-HSckLYIHrYTXHS7Rq4Q_6_7tN7Q050MQWpSf-UEYpjaElWhoQbOqrzM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO8nCjeJ1OkNPjZFG9y-LIv-OKkktdzmi3vm4NGU9YbWw&oe=6AD236C8"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Apollo 11 VR Mobile", "keywords": ["Space", "Apollo11", "Moon", "Education", "Science"], "long_description": "Apollo 11 VR is the story of the greatest journey ever taken by humankind. \n\nNow for the first time ever, you get to experience this historic event through the eyes of those who lived through it. Using a mix of original archive audio and video together with accurate recreations of the spacecraft and locations, all set to inspirational music. Get set for an experience that will not only educate you but will also leave a lasting impression and deep respect for the men and women who worked on the Apollo program during NASA\u2019s golden era.\n\nApollo 11 VR is a new type of documentary, not only do you get to relive the events of 1969, you can also take control and fly the command module, land the lunar lander, explore the Moon's surface and deploy the lunar experiments all before returning to earth in a fiery re-entry.\n\nTake one small step today and climb aboard Apollo 11 for the journey of a lifetime.", "short_description": "Apollo 11 VR is the story of the greatest journey ever taken by humankind. This VR experience is a recreation of the events which took place between July 16th and July 24th 1969. Now for the first time ever you get to experience this historic event through the eyes of those who lived through it."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.immersivevreducation.com/", "developer_terms_of_service_url": "http://www.immersivevreducation.com/", "publisher_name": "Immersive VR Education Ltd.", "support_website_url": null, "website_url": "http://www.immersivevreducation.com/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_ta
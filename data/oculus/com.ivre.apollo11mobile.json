tps://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/11162706_1728905930751814_7028473375836078080_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5U-Qlqcf5K4Q7kNvwEbrnkM&_nc_oc=AdoDk1NQchE0hpsFJI_nWXmPHeQ7o5w5Bxlbjjnn-vRs2cHm6kd7GfFSdJjrdDGGCbE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS8efAzi2_iZY6odbs9Pp_yv9ZAZiDmO1DXIN_xI9tn2A&oe=6B007D1D"}, {"file_name": "migrated_image.png", "id": "515145839183615", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/11162678_230384594120460_660784412161474560_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EkbfTMmWECYQ7kNvwHt-9Qh&_nc_oc=Adp_mVx33ee-BALt8w5qehcd1Dv3AoMfRMi0hT129ShPaSRIAm-_c8gPS6ALv9gu1tc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSCy-EGqElLBBV5I19KO6MPRbLDVewkstkzjXCeIwJRJw&oe=6B005B48"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Apollo 11 VR Mobile", "keywords": ["Space", "Apollo11", "Moon", "Education", "Science"], "long_description": "Apollo 11 VR is the story of the greatest journey ever taken by humankind. \n\nNow for the first time ever, you get to experience this historic event through the eyes of those who lived through it. Using a mix of original archive audio and video together with accurate recreations of the spacecraft and locations, all set to inspirational music. Get set for an experience that will not only educate you but will also leave a lasting impression and deep respect for the men and women who worked on the Apollo program during NASA\u2019s golden era.\n\nApollo 11 VR is a new type of documentary, not only do you get to relive the events of 1969, you can also take control and fly the command module, land the lunar lander, explore the Moon's surface and deploy the lunar experiments all before returning to earth in a fiery re-entry.\n\nTake one small step today and climb aboard Apollo 11 for the journey of a lifetime.", "short_description": "Apollo 11 VR is the story of the greatest journey ever taken by humankind. This VR experience is a recreation of the events which took place between July 16th and July 24th 1969. Now for the first time ever you get to experience this historic event through the eyes of those who lived through it."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.immersivevreducation.com/", "developer_terms_of_service_url": "http://www.immersivevreducation.com/", "publisher_name": "Immersive VR Education Ltd.", "support_website_url": null, "website_url": "http://www.immersivevreducation.com/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["EDUCATIONAL", "EXPLORATION", "SIMULATION", "ADVENTURE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "en_US"], "supported_input_devices": ["TOUCHPAD", "GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1276054486224781"}}]}, "scheduled_offers": {"count": 21, "nodes": [{"status": "PUBLISHED", "id": "970093343143241"}, {"status": "PUBLISHED", "id": "1030478387285832"}, {"status": "PUBLISHED", "id": "1506900609413015"}, {"status": "PUBLISHED", "id": "2211864442369919"}, {"status": "PUBLISHED", "id": "368882237410690"}, {"status": "PUBLISHED", "id": "226383584782143"}, {"status": "PUBLISHED", "id": "888335571372910"}, {"status": "PUBLISHED", "id": "1336772279792788"}, {"status": "PUBLISHED", "id": "522806564855357"}, {"status": "PUBLISHED", "id": "1489483571204554"}, {"status": "PENDING", "id": "2393105294093904"}, {"status": "PUBLISHED", "id": "327165764612995"}, {"status": "PUBLISHED", "id": "1615737545138072"}, {"status": "PUBLISHED", "id": "2241003718153
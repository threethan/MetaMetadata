ated_image.png", "id": "534263077228752", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/11162687_836456139869418_4437412463352217600_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_K0QlrQtDwMQ7kNvwFdbcuF&_nc_oc=AdpOk3aV8_WqQI49uiwauEdU3iA4-n70NkC02pcPDy2nCDEMLcQl5q4I2JtX6prwhgU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMf66uVbOxuGe5acn0ktR2jLjZwaA6i-xQkLzkZ7XaF6w&oe=6AC3B6B8"}, {"file_name": "migrated_image.png", "id": "137456474369213", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/11162685_1040540019410849_6355035770977255424_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nG4-KXOV8fsQ7kNvwHjd7gg&_nc_oc=AdrhOFoxS8HQEqzKQGvkdSRv6qQcdlud9gW-2f3gZ2ZXZvwEhT27OsfvOx5AH7t3Oj0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNJqIKJgJzV-R-yN8z2z1UbGKhX9kaoIWYax00VOy3l1Q&oe=6AC3A6A9"}, {"file_name": "migrated_image.png", "id": "218765856034101", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/11162679_256561344831711_3743039293812113408_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HB9ERav74oYQ7kNvwFs4fZs&_nc_oc=AdrtVJlxE2GGKEjB-ch4GmFrMJ3WgjrrMPb9Z1USB9_lAgJpXmAgBvMpJfZmw0KQcdA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPXZ2gN9KWXHrkdV76rKvJWAOA9YmLiXF4uOz09YYVwwQ&oe=6AC3AF52"}, {"file_name": "migrated_image.png", "id": "234924897699435", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/11162706_1728905930751814_7028473375836078080_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h-UxMiaO0dsQ7kNvwGAZ2ne&_nc_oc=AdpmsDbP6DO15wcmGxcj2Ls6gAYjw64Jegn-J-p6nzdJpkbpv0rHaNbAcy8fZeyyPlw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOh4m0LS5u8AP4zi2K3nquxmH9jKCse1b0-SIrxaU7vwg&oe=6AC3D81D"}, {"file_name": "migrated_image.png", "id": "515145839183615", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/11162678_230384594120460_660784412161474560_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vCOT28RtOpwQ7kNvwGczDu-&_nc_oc=Adph5wNBZmzSH_nslMCqALMTfT8gc52SeyrHppJH_NZ_hw-ncl2UvWWL_ELLOElnPHM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOi4RE6sWBQQMpkpulJnW1KFIUJRXINOotMGjxne3zHHg&oe=6AC3B648"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Apollo 11 VR Mobile", "keywords": ["Space", "Apollo11", "Moon", "Education", "Science"], "long_description": "Apollo 11 VR is the story of the greatest journey ever taken by humankind. \n\nNow for the first time ever, you get to experience this historic event through the eyes of those who lived through it. Using a mix of original archive audio and video together with accurate recreations of the spacecraft and locations, all set to inspirational music. Get set for an experience that will not only educate you but will also leave a lasting impression and deep respect for the men and women who worked on the Apollo program during NASA\u2019s golden era.\n\nApollo 11 VR is a new type of documentary, not only do you get to relive the events of 1969, you can also take control and fly the command module, land the lunar lander, explore the Moon's surface and deploy the lunar experiments all before returning to earth in a fiery re-entry.\n\nTake one small step today and climb aboard Apollo 11 for the journey of a lifetime.", "short_description": "Apollo 11 VR is the story of the greatest journey ever taken by humankind. This VR experience is a recreation of the events which took place between July 16th and July 24th 1969. Now for the first time ever you get to experience this historic event through the eyes of those who lived through it."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.immersivevreducation.com/", "developer_terms_of_service_url": "http://www.immersivevreducation.com/", "publisher_name": "Immersive VR Education Ltd.", "support_website_url": null, "website_url": "http://www.immersivevreducation.com/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_ta
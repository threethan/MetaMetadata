OdEaP&_nc_oc=AdrEnEaNORSgztPyQa2HZwws0gVgNI40PM7i5kLaHH_Gq6TIgS980lxLsRh1zrw2bRE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1nfFrRUegb3_Qo-oQG3PTXgZU9pEC2tIdgEjjkiqjetA&oe=69E0F448"}, {"file_name": "migrated_image.png", "id": "155340308977776", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/11162706_1728905930751814_7028473375836078080_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Kw3XjiHOeRgQ7kNvwFwTj8q&_nc_oc=Adq7bAAAOUiGuE8gBwVNSVkLHlZEVCbjcHg7rDAaaYwNlPzTnasb3oOgu9h2sdt9elw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af36QauRKOaiyQiGHuLYYuV5hY1gAU5VCi0pdVGOh7VsPA&oe=69E0DDDD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape.png", "id": "1203869659747783", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12504788_1203869663081116_7405985754020577280_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XMDkZ1aCmQwQ7kNvwHrY5Nw&_nc_oc=AdqBgTPqPT2TgSmur-BZ6DnOpGVOO8m6-FAiscliFJUqsc3b8KPU4Gk0WWcBEDxn0hQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1th2mKIEaxHc_B1hkyUPqg6Cub9EwqX6Py2_9FW1M15Q&oe=69E0D8D7"}, "display_name": "Apollo 11 VR Mobile", "keywords": ["Space", "Apollo11", "Moon", "Education", "Science"], "long_description": "Apollo 11 VR is the story of the greatest journey ever taken by humankind. \n\nNow for the first time ever, you get to experience this historic event through the eyes of those who lived through it. Using a mix of original archive audio and video together with accurate recreations of the spacecraft and locations, all set to inspirational music. Get set for an experience that will not only educate you but will also leave a lasting impression and deep respect for the men and women who worked on the Apollo program during NASA\u2019s golden era.\n\nApollo 11 VR is a new type of documentary, not only do you get to relive the events of 1969, you can also take control and fly the command module, land the lunar lander, explore the Moon's surface and deploy the lunar experiments all before returning to earth in a fiery re-entry.\n\nTake one small step today and climb aboard Apollo 11 for the journey of a lifetime.", "short_description": "Apollo 11 VR is the story of the greatest journey ever taken by humankind. This VR experience is a recreation of the events which took place between July 16th and July 24th 1969. Now for the first time ever you get to experience this historic event through the eyes of those who lived through it."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.immersivevreducation.com/", "developer_terms_of_service_url": "http://www.immersivevreducation.com/", "publisher_name": "Immersive VR Education Ltd.", "support_website_url": null, "website_url": "http://www.immersivevreducation.com/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["EDUCATIONAL", "EXPLORATION", "SIMULATION", "SPACE_UNIVERSE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "en_US"], "supported_input_devices": ["TOUCHPAD", "GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "2741686095976519"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12138999_217477508837246_2422406682165379072_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aLrBKHy8fKEQ7kNvwG7zFVS&_nc_oc=Adp8AUja2S5zDrIzsoAD3Qut7Qw-CO6GM_9j6lkzywFtXwAUKa-AQDwHku1TiUabwSk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af04URu1xU2nfH7yMgDGP9LXq8cz4rLwzJGskttYXFTaUg&oe=69E0F459"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "d
ated_image.png", "id": "534263077228752", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/11162687_836456139869418_4437412463352217600_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PbWN0RacHroQ7kNvwHlGbKJ&_nc_oc=Adrs7Y_JOdwJRS3cWIyE0BA7RJJdqqL6EUtrUr-A1e39PAVtecZvrPT-1vEN_r6yRvY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1qXWx8BoDsVCjSclUUX2JvBje1ZjJCQvlvNurxc9aAcw&oe=69E397B8"}, {"file_name": "migrated_image.png", "id": "137456474369213", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/11162685_1040540019410849_6355035770977255424_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pdALb7iNEyUQ7kNvwEGfCnm&_nc_oc=AdoGIjMYfIHbrSyFKfxhZ-RA4QoEX9HLhjNoUxMwHwXoGNdzx9TKEEsdCHZiZnFA8Zo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0_vGK-hta7WXR2NWQ-LG0qVXspoA8gL7gcLdOMRsJWDg&oe=69E387A9"}, {"file_name": "migrated_image.png", "id": "218765856034101", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/11162679_256561344831711_3743039293812113408_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jgQBmg8ErysQ7kNvwE_Cz_J&_nc_oc=AdoobuJy3urcjvNAQzt2g1p6IIlTnTP0IFDNw5UzTwOu4LQmBLCcJTqSGISBkPBawUw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3lp_mTJvhJ31iFHOMLhXOoqYlpQJLDeDBfqRFxr_tHvQ&oe=69E39052"}, {"file_name": "migrated_image.png", "id": "234924897699435", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/11162706_1728905930751814_7028473375836078080_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Kw3XjiHOeRgQ7kNvwFB2aA4&_nc_oc=Ado1XaRbPMfzDDBPK5vub2GbAtO3P3Q4XBtzJNsxqba6QiucyIQl3X9u1aXs7uXtS9g&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3haFUxGAMwOwZKXZs8M0kPkt2TdTHvbKjXw3ZETX4j-A&oe=69E380DD"}, {"file_name": "migrated_image.png", "id": "515145839183615", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/11162678_230384594120460_660784412161474560_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AMAX9BX8Jw4Q7kNvwF9IhAp&_nc_oc=AdqzaiYVORh5PD9hCJjEgMigxD-2VMUY5wM7qhBma5qjPrfQXTpF5TUXOK-GOSeu-U4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af26OGi7NpG2SQZqQ0ml_UGw2YxdMIcpIpKBsyMj-cba4w&oe=69E39748"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Apollo 11 VR Mobile", "keywords": ["Space", "Apollo11", "Moon", "Education", "Science"], "long_description": "Apollo 11 VR is the story of the greatest journey ever taken by humankind. \n\nNow for the first time ever, you get to experience this historic event through the eyes of those who lived through it. Using a mix of original archive audio and video together with accurate recreations of the spacecraft and locations, all set to inspirational music. Get set for an experience that will not only educate you but will also leave a lasting impression and deep respect for the men and women who worked on the Apollo program during NASA\u2019s golden era.\n\nApollo 11 VR is a new type of documentary, not only do you get to relive the events of 1969, you can also take control and fly the command module, land the lunar lander, explore the Moon's surface and deploy the lunar experiments all before returning to earth in a fiery re-entry.\n\nTake one small step today and climb aboard Apollo 11 for the journey of a lifetime.", "short_description": "Apollo 11 VR is the story of the greatest journey ever taken by humankind. This VR experience is a recreation of the events which took place between July 16th and July 24th 1969. Now for the first time ever you get to experience this historic event through the eyes of those who lived through it."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.immersivevreducation.com/", "developer_terms_of_service_url": "http://www.immersivevreducation.com/", "publisher_name": "Immersive VR Education Ltd.", "support_website_url": null, "website_url": "http://www.immersivevreducation.com/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_ta
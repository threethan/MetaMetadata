ated_image.png", "id": "534263077228752", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/11162687_836456139869418_4437412463352217600_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ho5UndNfJRIQ7kNvwF25ho7&_nc_oc=AdrVd0O4Wa38ynXRqzJCHyq18NgX8Kmg9YqGhunnWDlqeuslNIIZq_ml8iWbDP0ZBxs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB-vHwD2F4FdHXLBXqdJN3bULCGGKYpBwOb2nAlCmvxkg&oe=6A6A10B8"}, {"file_name": "migrated_image.png", "id": "137456474369213", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/11162685_1040540019410849_6355035770977255424_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NT9LamYIH9IQ7kNvwGpWtfd&_nc_oc=AdrkLyxJGGk8wq5GJbXuxgrDq0hotAhYqDfqtkyMkU6zCPg28qedtdi0qlkbpikXj74&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDGxOLxHgOSc0919lrayskpo3kqasZg59MoWZTFSAxFJA&oe=6A6A00A9"}, {"file_name": "migrated_image.png", "id": "218765856034101", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/11162679_256561344831711_3743039293812113408_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2Dx1Li5t4WEQ7kNvwEQIZsx&_nc_oc=AdpXfLkhIyhePQCUycnYIM5SL92t48jmMn08mVMSZs6RR-eH8CeycpfOriMTJOKs_70&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCeyUVC921JpHqs3oJ_pqmYYiNMkSkcQ-Sz_XxVcttCwA&oe=6A6A0952"}, {"file_name": "migrated_image.png", "id": "234924897699435", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/11162706_1728905930751814_7028473375836078080_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6qtSzLPnSw0Q7kNvwEJQd84&_nc_oc=AdpVXo-4CsxeyUsog7Hdr2r9_jquaNOtnfz-9A_mwfPXMeUNcYwuoBBa9nRnVOmdB6c&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBzeses5GoS3GbzdLIOFlX-iuaNXMnH3s_WecX1zWf2mw&oe=6A69F9DD"}, {"file_name": "migrated_image.png", "id": "515145839183615", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/11162678_230384594120460_660784412161474560_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NojBqYPN7fAQ7kNvwH0sgnE&_nc_oc=AdrpbHQ6PURsYKZMtrDMXrxy2POoKA06UzRO6bl_Jtt0wMqQrto4j63BayBv6iONcco&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAsh0m82rMZUqXypTRdU47oh4uFKn-oetC6kvME-2EkjQ&oe=6A6A1048"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Apollo 11 VR Mobile", "keywords": ["Space", "Apollo11", "Moon", "Education", "Science"], "long_description": "Apollo 11 VR is the story of the greatest journey ever taken by humankind. \n\nNow for the first time ever, you get to experience this historic event through the eyes of those who lived through it. Using a mix of original archive audio and video together with accurate recreations of the spacecraft and locations, all set to inspirational music. Get set for an experience that will not only educate you but will also leave a lasting impression and deep respect for the men and women who worked on the Apollo program during NASA\u2019s golden era.\n\nApollo 11 VR is a new type of documentary, not only do you get to relive the events of 1969, you can also take control and fly the command module, land the lunar lander, explore the Moon's surface and deploy the lunar experiments all before returning to earth in a fiery re-entry.\n\nTake one small step today and climb aboard Apollo 11 for the journey of a lifetime.", "short_description": "Apollo 11 VR is the story of the greatest journey ever taken by humankind. This VR experience is a recreation of the events which took place between July 16th and July 24th 1969. Now for the first time ever you get to experience this historic event through the eyes of those who lived through it."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.immersivevreducation.com/", "developer_terms_of_service_url": "http://www.immersivevreducation.com/", "publisher_name": "Immersive VR Education Ltd.", "support_website_url": null, "website_url": "http://www.immersivevreducation.com/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_ta
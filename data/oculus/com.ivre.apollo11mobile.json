_uLYP&_nc_oc=AdqHzAHUBcwsciLlaX2aE60TMVmwZLuXYQBxvp_t7RUD0rHzm4L-ujMic15S_MzxGlI&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF9ttgdaGUwscWkru6nmnoteemKotSjnSpAsxIZVgRrVQ&oe=6A940808"}, {"file_name": "migrated_image.png", "id": "155340308977776", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/11162706_1728905930751814_7028473375836078080_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OyrgznUIoogQ7kNvwGh8V-q&_nc_oc=AdrKjaSK4A5j_W9Vtcq2FW2vfg2X6XMTDgw-7_EAO2jRLgnSROvPY5hV0vi8TPjbxlY&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFu36hJKpYYTHKLxCTN0umhixpKCLzKMMJMaA_QGqaQSg&oe=6A9429DD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape.png", "id": "1203869659747783", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/12504788_1203869663081116_7405985754020577280_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kUQ2FtFteiAQ7kNvwEnYxBX&_nc_oc=AdqEGGNfVMoHLSPqSf5qWWZWwHiBKyPRSfKTON3A3a7-PCLJDDpeMLMZhl3gaKnhAX4&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGQi0GIizf5pLTv1a-e3DQjs0VkGmcx8HLFx_liKzeqkA&oe=6A9424D7"}, "display_name": "Apollo 11 VR Mobile", "keywords": ["Space", "Apollo11", "Moon", "Education", "Science"], "long_description": "Apollo 11 VR is the story of the greatest journey ever taken by humankind. \n\nNow for the first time ever, you get to experience this historic event through the eyes of those who lived through it. Using a mix of original archive audio and video together with accurate recreations of the spacecraft and locations, all set to inspirational music. Get set for an experience that will not only educate you but will also leave a lasting impression and deep respect for the men and women who worked on the Apollo program during NASA\u2019s golden era.\n\nApollo 11 VR is a new type of documentary, not only do you get to relive the events of 1969, you can also take control and fly the command module, land the lunar lander, explore the Moon's surface and deploy the lunar experiments all before returning to earth in a fiery re-entry.\n\nTake one small step today and climb aboard Apollo 11 for the journey of a lifetime.", "short_description": "Apollo 11 VR is the story of the greatest journey ever taken by humankind. This VR experience is a recreation of the events which took place between July 16th and July 24th 1969. Now for the first time ever you get to experience this historic event through the eyes of those who lived through it."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.immersivevreducation.com/", "developer_terms_of_service_url": "http://www.immersivevreducation.com/", "publisher_name": "Immersive VR Education Ltd.", "support_website_url": null, "website_url": "http://www.immersivevreducation.com/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["EDUCATIONAL", "EXPLORATION", "SIMULATION", "SPACE_UNIVERSE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "en_US"], "supported_input_devices": ["TOUCHPAD", "GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "2741686095976519"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/12138999_217477508837246_2422406682165379072_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=46089N0hDvkQ7kNvwH6GxL-&_nc_oc=AdoMwwzVJKLVSTzPl8QpPzNj-E68pHSwp0VuuuNwM08r5sv7jH7paWA0c9-WyKtNW5M&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEO7D4rRc4zy9vpV_mxd8eKaeJIQOkf1-0oSUrlEp5KqQ&oe=6A940819"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "d
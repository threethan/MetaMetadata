ated_image.png", "id": "534263077228752", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/11162687_836456139869418_4437412463352217600_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QMOGGe7MBtAQ7kNvwFILB8J&_nc_oc=AdqSNZvEUjAz0DtVTXGJqkaFAWnoNss24FJRtIuYIJetMHlY7YjbVUaoo47GyjZcOeo&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOlDlr_-6Jviit4cmFPzO7QiVihbAu3f2rOVwe62lHR_A&oe=6AE20938"}, {"file_name": "migrated_image.png", "id": "137456474369213", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/11162685_1040540019410849_6355035770977255424_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=18VZlYD6xlQQ7kNvwEgaoJa&_nc_oc=AdohBPaODOJZ_XaIVitpEEw7vzehzK024lAAyX-IWavK0eL2ohSXCCuZ2F7bmpl5HGE&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPjT1YpES6A2hU7acUWGJ7jLNGKQr-2QmagvndsJ9qUFA&oe=6AE1F929"}, {"file_name": "migrated_image.png", "id": "218765856034101", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/11162679_256561344831711_3743039293812113408_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tYwqlYJpPDIQ7kNvwGxp3Wt&_nc_oc=AdrVuXXA-bmild5xxEjXrSxzxFOFAWsPqJMTGLbaXvjVSWLSmSvCD1iNB7PslKzJjzg&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN1hE9bh5zGqQ3q1ucunQ3CxPMYb5xegy84GaGzYLW8CA&oe=6AE201D2"}, {"file_name": "migrated_image.png", "id": "234924897699435", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/11162706_1728905930751814_7028473375836078080_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b_nZx9w8LCIQ7kNvwETPnVl&_nc_oc=Adp4JcaPXu5uR8No7oPnJ2GZ86jtsvW3DzNSSUcxBp5jhaXM4nOIUzVfxmXspohWn9A&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNuma6v4ddOn4g12pNfHKLRDQlUR0fHddjYZ915xbGHQg&oe=6AE1F25D"}, {"file_name": "migrated_image.png", "id": "515145839183615", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/11162678_230384594120460_660784412161474560_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Sobedqia1MwQ7kNvwHpWN6Q&_nc_oc=AdptL4ipXgl6umuHG1xAwWXZ_Rup1gTPxaJMajdE9TvLuWJF_cIGzUIstZujrRHAUFs&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOo74b5bZEU52TcZqdqNBbvz2L95TwHKhYRLimkLd8jtg&oe=6AE208C8"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Apollo 11 VR Mobile", "keywords": ["Space", "Apollo11", "Moon", "Education", "Science"], "long_description": "Apollo 11 VR is the story of the greatest journey ever taken by humankind. \n\nNow for the first time ever, you get to experience this historic event through the eyes of those who lived through it. Using a mix of original archive audio and video together with accurate recreations of the spacecraft and locations, all set to inspirational music. Get set for an experience that will not only educate you but will also leave a lasting impression and deep respect for the men and women who worked on the Apollo program during NASA\u2019s golden era.\n\nApollo 11 VR is a new type of documentary, not only do you get to relive the events of 1969, you can also take control and fly the command module, land the lunar lander, explore the Moon's surface and deploy the lunar experiments all before returning to earth in a fiery re-entry.\n\nTake one small step today and climb aboard Apollo 11 for the journey of a lifetime.", "short_description": "Apollo 11 VR is the story of the greatest journey ever taken by humankind. This VR experience is a recreation of the events which took place between July 16th and July 24th 1969. Now for the first time ever you get to experience this historic event through the eyes of those who lived through it."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.immersivevreducation.com/", "developer_terms_of_service_url": "http://www.immersivevreducation.com/", "publisher_name": "Immersive VR Education Ltd.", "support_website_url": null, "website_url": "http://www.immersivevreducation.com/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_ta
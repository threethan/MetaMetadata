ated_image.png", "id": "534263077228752", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/11162687_836456139869418_4437412463352217600_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0Df3fD_NSFoQ7kNvwENwRTH&_nc_oc=AdoBXkDj8wMNma7L15XgTGmWwR6UZ7qpmEjGfKUp8qka6VzbeZyKImyeHbx3dyKCukw&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGO-XZSzL0upUrXlLpjkBy2uuZ9SBkRMOiboRvH0tvCdA&oe=6A8041F8"}, {"file_name": "migrated_image.png", "id": "137456474369213", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/11162685_1040540019410849_6355035770977255424_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=juPdFM6BK5cQ7kNvwHHErsn&_nc_oc=Adpxfjsh1ppIpjhhishcUHnlyjnnWbZXF0OpykKHov8lCXnVrpl1dCYt66_h2LSHTW0&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHKw3zCjY-7cgGMCrbLVd095xT3Acihgnr-mS5lc0O-wQ&oe=6A806A29"}, {"file_name": "migrated_image.png", "id": "218765856034101", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/11162679_256561344831711_3743039293812113408_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Uu_IgJPycIgQ7kNvwHxIZwv&_nc_oc=AdoKOU2TcLufzYij3et4TfTIbh7AUDsxj_0DUgfLCVoilhhTGugQZtm8OPbsAtWI6HE&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH1hPNPZUmCWRbygVHKMDwzYu6JdX6HsRYvoKf78kMudg&oe=6A8072D2"}, {"file_name": "migrated_image.png", "id": "234924897699435", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/11162706_1728905930751814_7028473375836078080_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EGYsruhwlxUQ7kNvwHvoZov&_nc_oc=AdoXQbbm579RKNQWCR-I0IZhKaRvmdiZcW_aUANSiIEsM4r_FtkwsIv1XhMEAiM5I8s&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQESr_MKri6YrOCoPG6FUAhiCOYoutIpyr6IK2p0BlYU0A&oe=6A80635D"}, {"file_name": "migrated_image.png", "id": "515145839183615", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/11162678_230384594120460_660784412161474560_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0CjL4cbBY_4Q7kNvwEZHtT3&_nc_oc=AdptwXYqX1vyl8OIQqdJ3A0OxTrjCq0fk3re_WuBfvvaRXquA-q3ipKqZm1ajbRhQmo&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE6geBH33uCwyKFhNWV65-TJmxqUCloCUPlKX-0k-2TbA&oe=6A804188"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Apollo 11 VR Mobile", "keywords": ["Space", "Apollo11", "Moon", "Education", "Science"], "long_description": "Apollo 11 VR is the story of the greatest journey ever taken by humankind. \n\nNow for the first time ever, you get to experience this historic event through the eyes of those who lived through it. Using a mix of original archive audio and video together with accurate recreations of the spacecraft and locations, all set to inspirational music. Get set for an experience that will not only educate you but will also leave a lasting impression and deep respect for the men and women who worked on the Apollo program during NASA\u2019s golden era.\n\nApollo 11 VR is a new type of documentary, not only do you get to relive the events of 1969, you can also take control and fly the command module, land the lunar lander, explore the Moon's surface and deploy the lunar experiments all before returning to earth in a fiery re-entry.\n\nTake one small step today and climb aboard Apollo 11 for the journey of a lifetime.", "short_description": "Apollo 11 VR is the story of the greatest journey ever taken by humankind. This VR experience is a recreation of the events which took place between July 16th and July 24th 1969. Now for the first time ever you get to experience this historic event through the eyes of those who lived through it."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.immersivevreducation.com/", "developer_terms_of_service_url": "http://www.immersivevreducation.com/", "publisher_name": "Immersive VR Education Ltd.", "support_website_url": null, "website_url": "http://www.immersivevreducation.com/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_ta
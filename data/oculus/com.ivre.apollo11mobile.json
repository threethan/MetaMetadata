ated_image.png", "id": "534263077228752", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/11162687_836456139869418_4437412463352217600_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rKYA4HslysUQ7kNvwFEtiKJ&_nc_oc=AdrxZtxolYicNIdc8Seg8eXVGcoVWYr5NMVTlb9tOiRBt2Ck6awmavP8b32GN7NSLLQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_oEemSJOoKOcvSN958BoSeFwFkX2PljaZsDBtHKqxJBA&oe=6A2582B8"}, {"file_name": "migrated_image.png", "id": "137456474369213", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/11162685_1040540019410849_6355035770977255424_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Q1dDlQij2YIQ7kNvwFwQmN8&_nc_oc=AdoGSmErLgk5ujrkocT9cf1WEpvljtWdj3iqqESpae-THuup2dbFfyZkDfs1LZo1rD0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_ifB9qWkFGHsfMQh9SXyZ6eSFn1upAoZBkqOLxPjxdog&oe=6A2572A9"}, {"file_name": "migrated_image.png", "id": "218765856034101", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/11162679_256561344831711_3743039293812113408_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oYZykSwn1sUQ7kNvwGJvNvK&_nc_oc=Ado9Wsd3iGDt8VRoLGWw2QKSGdlIR_V0wrqAOHCD_zXaSOLXRe-71tWhzYq5EfMXWmw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-XOsi5PRqg0prIFV6pDuMd6UEctINL_10mr_74MrbFXQ&oe=6A257B52"}, {"file_name": "migrated_image.png", "id": "234924897699435", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/11162706_1728905930751814_7028473375836078080_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jltX3wY3nlUQ7kNvwEeOvHJ&_nc_oc=AdprtH9FWRXkWGii5FjORwrfrts0dGamlYX4jwdxkOiNfiPV3pCql0lBz7_orNMF9l4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9tC7RsDzhkXhXID0TV0p6uke0AU4EXg5qIuCR9p3_fZA&oe=6A25A41D"}, {"file_name": "migrated_image.png", "id": "515145839183615", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/11162678_230384594120460_660784412161474560_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YOUK1ZkWwn0Q7kNvwHsXvyp&_nc_oc=Adr0FmNCw_0fqeNqHX1nkolGwfWMrG9FCtdEqI5jYB3vDBcQvb5HXmeXP58P1XiabDc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af83rkrv4JZi8ewIr9WFd7WdLFVdsVHEj42pWW1GAuxK5g&oe=6A258248"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Apollo 11 VR Mobile", "keywords": ["Space", "Apollo11", "Moon", "Education", "Science"], "long_description": "Apollo 11 VR is the story of the greatest journey ever taken by humankind. \n\nNow for the first time ever, you get to experience this historic event through the eyes of those who lived through it. Using a mix of original archive audio and video together with accurate recreations of the spacecraft and locations, all set to inspirational music. Get set for an experience that will not only educate you but will also leave a lasting impression and deep respect for the men and women who worked on the Apollo program during NASA\u2019s golden era.\n\nApollo 11 VR is a new type of documentary, not only do you get to relive the events of 1969, you can also take control and fly the command module, land the lunar lander, explore the Moon's surface and deploy the lunar experiments all before returning to earth in a fiery re-entry.\n\nTake one small step today and climb aboard Apollo 11 for the journey of a lifetime.", "short_description": "Apollo 11 VR is the story of the greatest journey ever taken by humankind. This VR experience is a recreation of the events which took place between July 16th and July 24th 1969. Now for the first time ever you get to experience this historic event through the eyes of those who lived through it."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.immersivevreducation.com/", "developer_terms_of_service_url": "http://www.immersivevreducation.com/", "publisher_name": "Immersive VR Education Ltd.", "support_website_url": null, "website_url": "http://www.immersivevreducation.com/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_ta
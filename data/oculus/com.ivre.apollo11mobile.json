-sin11-2.oculuscdn.com/v/t64.5771-25/11162687_836456139869418_4437412463352217600_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Gukz3HluNu4Q7kNvwGi2UpZ&_nc_oc=AdlQWkp4CXGSkmK5q37yyepXEVWcK4DPVQLG1-3WZD7ViyWOUklxFS9RdD4vsMlvAik&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=8&oh=00_AfzCmeH8brWLHotclsCvcjDSQ765-15Z8ThTVMDB0QnPDg&oe=69AAE738"}, {"file_name": "migrated_image.png", "id": "137456474369213", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/11162685_1040540019410849_6355035770977255424_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-L4gYgeERgYQ7kNvwGDOcR5&_nc_oc=AdnQzCU61O8TguggU63mW-Z5cj8nuwggD-3t-JtGPG3qGa3yBaFX9pSSFbl_8KE_DCI&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=8&oh=00_AfwjpX2R2Jr9X5x5ycESM5mXeNH0G8kKkaWs020LtOyZSQ&oe=69AAD729"}, {"file_name": "migrated_image.png", "id": "218765856034101", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/11162679_256561344831711_3743039293812113408_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=__e5a2TQ0EwQ7kNvwEqCJY9&_nc_oc=AdlDmLeEHRcLMukGOUABMMQuCyYHPzdeLssnnVrJ3We7WMZZ_Avilbb3527ZA9dMFuc&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=8&oh=00_AfwAmxyiIg9vvYKvurmxXAKGD-F6xB-Q-XgRCCWDHp0DQw&oe=69AADFD2"}, {"file_name": "migrated_image.png", "id": "234924897699435", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/11162706_1728905930751814_7028473375836078080_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EP8qYLasB6UQ7kNvwFDYkdH&_nc_oc=AdmUCAwCK9gJT0smvUgzawu_Hg5XXwSTpajlSuGvfBkn6E2JYavgA-eX3xCoxAdhLAg&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=8&oh=00_AfwFBmxioec0yOBmWNNrKSh_72WeC00eSdYZ8KCeDzdAhA&oe=69AAD05D"}, {"file_name": "migrated_image.png", "id": "515145839183615", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/11162678_230384594120460_660784412161474560_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XkKtq9ytiRwQ7kNvwE4zxlZ&_nc_oc=Adl4U1K_ayg6ZjJSvr2U2SnC0H6nmt1Y4NjGP7IbgwEZVCPraVzp_l1A9s8Lrog64yo&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=8&oh=00_AfxX4KUj2CjceBePdg9OZ1xteKGOHRAIAcZDnbsWTVMvYQ&oe=69AAE6C8"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Apollo 11 VR Mobile", "keywords": ["Space", "Apollo11", "Moon", "Education", "Science"], "long_description": "Apollo 11 VR is the story of the greatest journey ever taken by humankind. \n\nNow for the first time ever, you get to experience this historic event through the eyes of those who lived through it. Using a mix of original archive audio and video together with accurate recreations of the spacecraft and locations, all set to inspirational music. Get set for an experience that will not only educate you but will also leave a lasting impression and deep respect for the men and women who worked on the Apollo program during NASA\u2019s golden era.\n\nApollo 11 VR is a new type of documentary, not only do you get to relive the events of 1969, you can also take control and fly the command module, land the lunar lander, explore the Moon's surface and deploy the lunar experiments all before returning to earth in a fiery re-entry.\n\nTake one small step today and climb aboard Apollo 11 for the journey of a lifetime.", "short_description": "Apollo 11 VR is the story of the greatest journey ever taken by humankind. This VR experience is a recreation of the events which took place between July 16th and July 24th 1969. Now for the first time ever you get to experience this historic event through the eyes of those who lived through it."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.immersivevreducation.com/", "developer_terms_of_service_url": "http://www.immersivevreducation.com/", "publisher_name": "Immersive VR Education Ltd.", "support_website_url": null, "website_url": "http://www.immersivevreducation.com/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscriptio
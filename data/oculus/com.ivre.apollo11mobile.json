ated_image.png", "id": "534263077228752", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/11162687_836456139869418_4437412463352217600_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ACz9m1frd-UQ7kNvwFDoz5K&_nc_oc=Adog5GfUgyK7mtJ7u2wAXIuT9hqSIaMXh7C8OobOWEH8O8aEhAgpDevMTjvH30Vs2Zc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIs8fxCbPApQqD9V1b0vSKPk1V1I2zW6T-ZRJtzrS6qZQ&oe=6A9C29B8"}, {"file_name": "migrated_image.png", "id": "137456474369213", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/11162685_1040540019410849_6355035770977255424_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jJFj6kGQY0wQ7kNvwF4be-m&_nc_oc=AdqgYmDYk8mFiuzDoIN6YyW9sLKkSCKAb4dUrK_Sz_2SmwwSfBpHVESC5ZqckDUMyg0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKDbn1DuP7Peu5LJOmd3icPtNDutyhBeVXaO4MmaN3J-A&oe=6A9C19A9"}, {"file_name": "migrated_image.png", "id": "218765856034101", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/11162679_256561344831711_3743039293812113408_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sPScY1qHLiQQ7kNvwGcm_9t&_nc_oc=AdqAA2YL_7vy1YQXi20mtXI5wI3doHFeO5GdeZw-gEcM9hrdb-erqpKRo6e9g8lhOOU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJWUd0AW_nBi5zPUscBtoHPlHcwZwubdIlb5W1se3pqaQ&oe=6A9C2252"}, {"file_name": "migrated_image.png", "id": "234924897699435", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/11162706_1728905930751814_7028473375836078080_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K3sFrr-MheUQ7kNvwED7TSB&_nc_oc=AdqnmXeZBU724o5HxNGux6FEBWMdqny6bp6rXAQa5t1c1Ta5bGsuNoe9WHWkO497UdA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLOjz2HwSbA_nQIMUYigt6JnUTEw8DuaWQHV4E59zjErQ&oe=6A9C12DD"}, {"file_name": "migrated_image.png", "id": "515145839183615", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/11162678_230384594120460_660784412161474560_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L4h3HFRps6QQ7kNvwGxsBOr&_nc_oc=AdqU9Kbl2YcmBEuY5fslvKWucdV3JCudJwgVagbrP_yjZtFleYmNjHKgcOQxNeLdpOY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK05frKa5JmeqmywJI2RaSaAJaR6SaNGDK4uNyGcMqNfA&oe=6A9C2948"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Apollo 11 VR Mobile", "keywords": ["Space", "Apollo11", "Moon", "Education", "Science"], "long_description": "Apollo 11 VR is the story of the greatest journey ever taken by humankind. \n\nNow for the first time ever, you get to experience this historic event through the eyes of those who lived through it. Using a mix of original archive audio and video together with accurate recreations of the spacecraft and locations, all set to inspirational music. Get set for an experience that will not only educate you but will also leave a lasting impression and deep respect for the men and women who worked on the Apollo program during NASA\u2019s golden era.\n\nApollo 11 VR is a new type of documentary, not only do you get to relive the events of 1969, you can also take control and fly the command module, land the lunar lander, explore the Moon's surface and deploy the lunar experiments all before returning to earth in a fiery re-entry.\n\nTake one small step today and climb aboard Apollo 11 for the journey of a lifetime.", "short_description": "Apollo 11 VR is the story of the greatest journey ever taken by humankind. This VR experience is a recreation of the events which took place between July 16th and July 24th 1969. Now for the first time ever you get to experience this historic event through the eyes of those who lived through it."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.immersivevreducation.com/", "developer_terms_of_service_url": "http://www.immersivevreducation.com/", "publisher_name": "Immersive VR Education Ltd.", "support_website_url": null, "website_url": "http://www.immersivevreducation.com/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_ta
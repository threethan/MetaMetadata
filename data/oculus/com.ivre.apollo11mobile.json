ated_image.png", "id": "534263077228752", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/11162687_836456139869418_4437412463352217600_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VQvdXGqQiXUQ7kNvwEfnMA4&_nc_oc=Adp10e-5uAEpWAs7yWQ4Mv216pbUzhoInR7Rvof6fYy8yACCNUIYWpFWB_8BiRaMU30&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzyEuh96tVQwh1Ig244UzGGygGig8uhZvRjvRri7LDAUw&oe=69C54538"}, {"file_name": "migrated_image.png", "id": "137456474369213", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/11162685_1040540019410849_6355035770977255424_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NC3U7A6D1rcQ7kNvwEcOpl2&_nc_oc=AdomwXspspzL4-wQypRk_CED42zGUtjpJMUod-CcYcqujIHtIe1jVPLuZZkCwfhdC2M&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afz_tb6qXL9rjDdtnpDS7LtRFt2PQTcfB2YxSSg4gN8N5A&oe=69C53529"}, {"file_name": "migrated_image.png", "id": "218765856034101", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/11162679_256561344831711_3743039293812113408_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=12JxaZH2hyAQ7kNvwEIyw71&_nc_oc=AdqlIAN7booYYaXaS13zO_00EQ2X1FQZV1L_YHbwqMGnQLF_k3oxOAmTga7g5sKefjA&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afyzoth4hKlTSyB0DZYIWy4x_F0GCTlHaGYg-Hq4Pufqgw&oe=69C53DD2"}, {"file_name": "migrated_image.png", "id": "234924897699435", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/11162706_1728905930751814_7028473375836078080_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8e5dcekFSsgQ7kNvwElHOp2&_nc_oc=AdqY1fpJ_d5LW8HOSUDWGhP6TUOWbQtDRvp8Ea5F-kwZ-lrwvCFMaGz_IfODJUFoo3c&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyXqnPozQBTzKWEUgZ7xxx9KSdQt-P0RP9FeGUZ64t4cw&oe=69C52E5D"}, {"file_name": "migrated_image.png", "id": "515145839183615", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/11162678_230384594120460_660784412161474560_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-zs4A7D64UUQ7kNvwFj2hFk&_nc_oc=Adq5Gmr7hca64qiGZvgZsDqdqb9bS2pMyKzS56sQw37qS2tunYum9IIVMTzvLQn-9nQ&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxnI72ZKIWaHpHzkXOY7m2gCGp90mGBGwy7YgawCOY69A&oe=69C544C8"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Apollo 11 VR Mobile", "keywords": ["Space", "Apollo11", "Moon", "Education", "Science"], "long_description": "Apollo 11 VR is the story of the greatest journey ever taken by humankind. \n\nNow for the first time ever, you get to experience this historic event through the eyes of those who lived through it. Using a mix of original archive audio and video together with accurate recreations of the spacecraft and locations, all set to inspirational music. Get set for an experience that will not only educate you but will also leave a lasting impression and deep respect for the men and women who worked on the Apollo program during NASA\u2019s golden era.\n\nApollo 11 VR is a new type of documentary, not only do you get to relive the events of 1969, you can also take control and fly the command module, land the lunar lander, explore the Moon's surface and deploy the lunar experiments all before returning to earth in a fiery re-entry.\n\nTake one small step today and climb aboard Apollo 11 for the journey of a lifetime.", "short_description": "Apollo 11 VR is the story of the greatest journey ever taken by humankind. This VR experience is a recreation of the events which took place between July 16th and July 24th 1969. Now for the first time ever you get to experience this historic event through the eyes of those who lived through it."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.immersivevreducation.com/", "developer_terms_of_service_url": "http://www.immersivevreducation.com/", "publisher_name": "Immersive VR Education Ltd.", "support_website_url": null, "website_url": "http://www.immersivevreducation.com/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_ta
Zvm0Q7kNvwH6stA7&_nc_oc=AdpQsZF06AYneIYWqju2X-q3dKZFdQmx6pY1zHXIZ4gBFoKSKLGzVXOFcvz3gd6f2ts&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFgF-JYOidTCsh3tp3bGFba9CE19K2CcmtSlphProT4Ew&oe=6A8D7088"}, {"file_name": "migrated_image.png", "id": "155340308977776", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/11162706_1728905930751814_7028473375836078080_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cpndLC4QcukQ7kNvwHfmi2e&_nc_oc=AdpnoKiKpQ76feqqhvXDOYIw71aFmXydR2VJP3EV0U8BMEsGsx1RZ43_aBPFnvDPlPU&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGoRK_gSlB2-KjCDFwbyzWyQmTaRTVsls3KjuRcasT7Hw&oe=6A8D925D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape.png", "id": "1203869659747783", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/12504788_1203869663081116_7405985754020577280_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SPzSWXRCrOMQ7kNvwGYdqBJ&_nc_oc=AdppmfQ_6qNlvcN2XWMlFVx1VBthsQoCHSHizOABbytO2MP6CxlV5ch8qPPIcRS0aLQ&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEjmC80ckUImhrKewiRnxkzB9DDPMcs8_odfgmYCqsmRQ&oe=6A8D8D57"}, "display_name": "Apollo 11 VR Mobile", "keywords": ["Space", "Apollo11", "Moon", "Education", "Science"], "long_description": "Apollo 11 VR is the story of the greatest journey ever taken by humankind. \n\nNow for the first time ever, you get to experience this historic event through the eyes of those who lived through it. Using a mix of original archive audio and video together with accurate recreations of the spacecraft and locations, all set to inspirational music. Get set for an experience that will not only educate you but will also leave a lasting impression and deep respect for the men and women who worked on the Apollo program during NASA\u2019s golden era.\n\nApollo 11 VR is a new type of documentary, not only do you get to relive the events of 1969, you can also take control and fly the command module, land the lunar lander, explore the Moon's surface and deploy the lunar experiments all before returning to earth in a fiery re-entry.\n\nTake one small step today and climb aboard Apollo 11 for the journey of a lifetime.", "short_description": "Apollo 11 VR is the story of the greatest journey ever taken by humankind. This VR experience is a recreation of the events which took place between July 16th and July 24th 1969. Now for the first time ever you get to experience this historic event through the eyes of those who lived through it."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.immersivevreducation.com/", "developer_terms_of_service_url": "http://www.immersivevreducation.com/", "publisher_name": "Immersive VR Education Ltd.", "support_website_url": null, "website_url": "http://www.immersivevreducation.com/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["EDUCATIONAL", "EXPLORATION", "SIMULATION", "SPACE_UNIVERSE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "en_US"], "supported_input_devices": ["TOUCHPAD", "GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "2741686095976519"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/12138999_217477508837246_2422406682165379072_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1OQz2WnbSuIQ7kNvwHWFkjA&_nc_oc=Adozpmx_eA75ZPP7BxRY5bRapY9CCmvWtmEVlAIVIoAPuru9W8XilkNblVVplYYoDcE&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE7MpWkvMCPYYnNLt1yfNcWSo-AmsEMVmDE9IaxmGWSSg&oe=6A8D7099"}, "is_concept": false, "is_test": false, "is_trial_offer_v
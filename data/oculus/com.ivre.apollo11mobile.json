ated_image.png", "id": "534263077228752", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/11162687_836456139869418_4437412463352217600_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gRWYjZDg2DcQ7kNvwHp8fyE&_nc_oc=AdqAjaG7fsftA83l840Am3JegsATYPRCGIC1g1YV7OSAFAt1_1qJE2gFhyQ5vdzeyZk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM0EE7IcrGQjy0sRygZWaCjp_1bp_YUNv46DoNB8MTi9Q&oe=6ADE14B8"}, {"file_name": "migrated_image.png", "id": "137456474369213", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/11162685_1040540019410849_6355035770977255424_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vIlhtkjETEQQ7kNvwHn3HvU&_nc_oc=AdqxGUC4-Ml8Q2heUYUUIJ8YyP8fjfAcpn3cqJruvAe28YoG_APhfO4yQ5miccy_z4k&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNsp7qfyzrouJt0ztDA04PcHKmJSQrT4C42z12MI7r90A&oe=6ADE04A9"}, {"file_name": "migrated_image.png", "id": "218765856034101", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/11162679_256561344831711_3743039293812113408_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XlyY0TlF24QQ7kNvwFCFeyM&_nc_oc=Ado3piSdw0fWlX0t3eqFT_G3kK_XwANoUvIkXbvXJLAw_RiWL1ZcrQrftR7xye7qz8M&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOFru1R3sjC9igdhFzmvJ2J_W6MBN8buP3K96_REUMwmg&oe=6ADE0D52"}, {"file_name": "migrated_image.png", "id": "234924897699435", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/11162706_1728905930751814_7028473375836078080_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gksYXrdDUXsQ7kNvwFZA21e&_nc_oc=AdpUWhunBk0fR4ipqhl2lQpizG8PahvKEvRg0piKnjyvZz9rj9ETM7GXFbpjng23v7E&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMrCjF-MQe1Ir9e0tLeW_rUBcOir3CSSv42Wu4FqhiI1A&oe=6ADDFDDD"}, {"file_name": "migrated_image.png", "id": "515145839183615", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/11162678_230384594120460_660784412161474560_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AdUnE0y-7bAQ7kNvwEXG_eW&_nc_oc=AdoDbPIOHh7mX0omFC0RQ1SAPmeKQ90zYeEJ3TcdBXGRuwVcacfRN2WOFmuEbsTYFbM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNXFq23xoTC9Bl50BgXjvG_rhf_pQZSfjzTnG7Qd5U6lw&oe=6ADE1448"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Apollo 11 VR Mobile", "keywords": ["Space", "Apollo11", "Moon", "Education", "Science"], "long_description": "Apollo 11 VR is the story of the greatest journey ever taken by humankind. \n\nNow for the first time ever, you get to experience this historic event through the eyes of those who lived through it. Using a mix of original archive audio and video together with accurate recreations of the spacecraft and locations, all set to inspirational music. Get set for an experience that will not only educate you but will also leave a lasting impression and deep respect for the men and women who worked on the Apollo program during NASA\u2019s golden era.\n\nApollo 11 VR is a new type of documentary, not only do you get to relive the events of 1969, you can also take control and fly the command module, land the lunar lander, explore the Moon's surface and deploy the lunar experiments all before returning to earth in a fiery re-entry.\n\nTake one small step today and climb aboard Apollo 11 for the journey of a lifetime.", "short_description": "Apollo 11 VR is the story of the greatest journey ever taken by humankind. This VR experience is a recreation of the events which took place between July 16th and July 24th 1969. Now for the first time ever you get to experience this historic event through the eyes of those who lived through it."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.immersivevreducation.com/", "developer_terms_of_service_url": "http://www.immersivevreducation.com/", "publisher_name": "Immersive VR Education Ltd.", "support_website_url": null, "website_url": "http://www.immersivevreducation.com/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_ta
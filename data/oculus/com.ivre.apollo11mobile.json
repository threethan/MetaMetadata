ated_image.png", "id": "534263077228752", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/11162687_836456139869418_4437412463352217600_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x6TgzxTCHRcQ7kNvwHRPXbh&_nc_oc=AdpnOpOrSc72IV2U_O_cZaIkMOLymY5aZjcr1dmVkaW7Y6S6Onej-8vxUuB7SOJcKAA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJREyBlpaYoJT92uWA5f8hAZhQl8b3ukLAJIlCuw_Lyjg&oe=6ABA7C38"}, {"file_name": "migrated_image.png", "id": "137456474369213", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/11162685_1040540019410849_6355035770977255424_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zMFhFG-rUoYQ7kNvwHZQbxt&_nc_oc=Ado_RUGgC0qGntJLFqzj2teizm6L5l_8l2uhI4VLGsGSMijvlws6eKyUlhacy_Q2GC4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLQvtac66962QH0H5H_c5uVP6iLTg_LAPsSIvCQwOMVRA&oe=6ABA6C29"}, {"file_name": "migrated_image.png", "id": "218765856034101", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/11162679_256561344831711_3743039293812113408_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4k1NBPE0sjoQ7kNvwFQsk85&_nc_oc=Adr4iNSkS7YFnhFZBCZfrpCw_o2yHSziyLMkHthMB3mtH8IdfX5UbOpgV5L7zjyxL84&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKVdFQb40uMq7PnLMYhcJK2BSZF8_8aITthytF91K0WqA&oe=6ABA74D2"}, {"file_name": "migrated_image.png", "id": "234924897699435", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/11162706_1728905930751814_7028473375836078080_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uUaVCBfPNzYQ7kNvwHHLMzE&_nc_oc=Adr_tGsejGqWrq8uxzPGYp28Ny6RT-O2O5ApHCqsUyAAEeoyQC5HF-ryawZe2E5uVlY&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKieBwlLghLNYg3PphM3RO39YDWTTEhYJMZfndlsUwe-Q&oe=6ABA655D"}, {"file_name": "migrated_image.png", "id": "515145839183615", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/11162678_230384594120460_660784412161474560_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AymL6xC_j8AQ7kNvwFElS79&_nc_oc=AdqoHTBTrYhaySAIUFtMdeZP7bpy4l9SS5DJPx8SOSOVmY8IlagMXIjay3QDnO9Fx9Q&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLxT7dH98qTrFEDXhIIhJI4dVhR2IPxSiUV_EhNK24aOA&oe=6ABA7BC8"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Apollo 11 VR Mobile", "keywords": ["Space", "Apollo11", "Moon", "Education", "Science"], "long_description": "Apollo 11 VR is the story of the greatest journey ever taken by humankind. \n\nNow for the first time ever, you get to experience this historic event through the eyes of those who lived through it. Using a mix of original archive audio and video together with accurate recreations of the spacecraft and locations, all set to inspirational music. Get set for an experience that will not only educate you but will also leave a lasting impression and deep respect for the men and women who worked on the Apollo program during NASA\u2019s golden era.\n\nApollo 11 VR is a new type of documentary, not only do you get to relive the events of 1969, you can also take control and fly the command module, land the lunar lander, explore the Moon's surface and deploy the lunar experiments all before returning to earth in a fiery re-entry.\n\nTake one small step today and climb aboard Apollo 11 for the journey of a lifetime.", "short_description": "Apollo 11 VR is the story of the greatest journey ever taken by humankind. This VR experience is a recreation of the events which took place between July 16th and July 24th 1969. Now for the first time ever you get to experience this historic event through the eyes of those who lived through it."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.immersivevreducation.com/", "developer_terms_of_service_url": "http://www.immersivevreducation.com/", "publisher_name": "Immersive VR Education Ltd.", "support_website_url": null, "website_url": "http://www.immersivevreducation.com/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_ta
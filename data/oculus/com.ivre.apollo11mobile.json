ated_image.png", "id": "534263077228752", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/11162687_836456139869418_4437412463352217600_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iWAbNcjbs4kQ7kNvwGTCPpZ&_nc_oc=AdqS392Ovq-FGARhyIxKALwHeKg6TFYFxg-jpcsfbowUgDcRmHitZJ8WLnXCR3gycoo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMbN3EgjEe3BvW0Curgq3JXnTNR0nKAWLlw_WU0BJYhQw&oe=6ACB9FB8"}, {"file_name": "migrated_image.png", "id": "137456474369213", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/11162685_1040540019410849_6355035770977255424_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TH3VFt7KAWEQ7kNvwHo7m2X&_nc_oc=AdqdvR8FceXXzOOFr1f8Jw3lQsC6NjCYq3tGAr9xwSUyuqaQ3gsZoviSajAVePyKdVU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNv_BtA0PY27tS6GBQSRp63-gZbQFbcJiHugFpRi-4jKw&oe=6ACB8FA9"}, {"file_name": "migrated_image.png", "id": "218765856034101", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/11162679_256561344831711_3743039293812113408_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gx6TuW6VVB4Q7kNvwG9pcNn&_nc_oc=AdqK77lyaNCojBryJOBmiHxH_IVjIzbuKxPOTSlvKjejJ0C7jHA9fGT7tC5oVidzxYc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPObCP32VviP9lciFg3dmNwhJdxQGnqjFMZzw19FUtw3A&oe=6ACB9852"}, {"file_name": "migrated_image.png", "id": "234924897699435", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/11162706_1728905930751814_7028473375836078080_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Enm3R125YxAQ7kNvwF0RTaZ&_nc_oc=AdpzsYqLbsaFFqC_r_gSOVXcDCNHo37mIKbZH-o2x7GOa20qvBW2Etc_wVpcnyNaBC8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPvnJHa6soeOezAozx2_CpVFzjgG_s9za4k4jdrHgkGdQ&oe=6ACBC11D"}, {"file_name": "migrated_image.png", "id": "515145839183615", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/11162678_230384594120460_660784412161474560_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mXCcaMSc1GoQ7kNvwGNeG2F&_nc_oc=Adrnpwcw3j-iY15TF3sIrr8gKFtjt1PEtwKdXDUtYca2WjURyP-kcg2hr0hx-uv28uY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOIpEubfVqUgQ-GcxSjEz79BWTSHk0h2XN63hXChqvUyA&oe=6ACB9F48"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Apollo 11 VR Mobile", "keywords": ["Space", "Apollo11", "Moon", "Education", "Science"], "long_description": "Apollo 11 VR is the story of the greatest journey ever taken by humankind. \n\nNow for the first time ever, you get to experience this historic event through the eyes of those who lived through it. Using a mix of original archive audio and video together with accurate recreations of the spacecraft and locations, all set to inspirational music. Get set for an experience that will not only educate you but will also leave a lasting impression and deep respect for the men and women who worked on the Apollo program during NASA\u2019s golden era.\n\nApollo 11 VR is a new type of documentary, not only do you get to relive the events of 1969, you can also take control and fly the command module, land the lunar lander, explore the Moon's surface and deploy the lunar experiments all before returning to earth in a fiery re-entry.\n\nTake one small step today and climb aboard Apollo 11 for the journey of a lifetime.", "short_description": "Apollo 11 VR is the story of the greatest journey ever taken by humankind. This VR experience is a recreation of the events which took place between July 16th and July 24th 1969. Now for the first time ever you get to experience this historic event through the eyes of those who lived through it."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.immersivevreducation.com/", "developer_terms_of_service_url": "http://www.immersivevreducation.com/", "publisher_name": "Immersive VR Education Ltd.", "support_website_url": null, "website_url": "http://www.immersivevreducation.com/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_ta
ated_image.png", "id": "534263077228752", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/11162687_836456139869418_4437412463352217600_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TXAB1MC0j6cQ7kNvwHIorqb&_nc_oc=AdppNkw6qDo1TEKQjoMR7Dm6VBPi9tWnGI5tumKpyGgGIFcpiFU6zVK_yD90c6TGCT0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0fLpH7Kpvb3WfK94Yxl5_Tj6WmeI28Uj8Xi9W08wCwww&oe=69EE23B8"}, {"file_name": "migrated_image.png", "id": "137456474369213", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/11162685_1040540019410849_6355035770977255424_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2qcdgNR8itcQ7kNvwFMvvws&_nc_oc=Adp27CZNDoyenNgAY7V-61aDVuDYF0onoZLMU-k1FC-_ffeEYBc5scg9c9p37gYKmQg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2p-quuL8HWHCfTP_ZglRCaN-o2R6rS4OpjJugUFvfZRw&oe=69EE13A9"}, {"file_name": "migrated_image.png", "id": "218765856034101", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/11162679_256561344831711_3743039293812113408_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=48qqVrH5DTkQ7kNvwG333-9&_nc_oc=Adoydw31sK4Ny9U3c3W21j8GiV2wDPhVN-Q8k__WETQIhmzYXynEPkHP2SGStC_owjE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1xiq9jkwGoETfP34WLw1c2hDNq0TeNn5A8B4r8XJlTtA&oe=69EE1C52"}, {"file_name": "migrated_image.png", "id": "234924897699435", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/11162706_1728905930751814_7028473375836078080_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ypbqmwEoCtYQ7kNvwFxxCV3&_nc_oc=Ado-FQHUgji9QvPMihuDImM4b7Q5YxW18NMUxOHXpQfxyPT3jiyZ-5JEsQhnzV_T1PU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3qLgPnwpKv8uZbMWPvVseuTsTirNIqGmXflqAzZcSoYw&oe=69EE0CDD"}, {"file_name": "migrated_image.png", "id": "515145839183615", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/11162678_230384594120460_660784412161474560_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gwr2tp2WgaUQ7kNvwGoFEed&_nc_oc=Adp_quD7fIvr-K_RdTI37qhFpxmCZsKMtk_8YVh6M1_vGPvAFGqoGm2ndq8c6Ml7iJs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0C83M8z3xbTo0cOW4iCA5UPNsMVcnLaEl6lH2zyIA9wQ&oe=69EE2348"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Apollo 11 VR Mobile", "keywords": ["Space", "Apollo11", "Moon", "Education", "Science"], "long_description": "Apollo 11 VR is the story of the greatest journey ever taken by humankind. \n\nNow for the first time ever, you get to experience this historic event through the eyes of those who lived through it. Using a mix of original archive audio and video together with accurate recreations of the spacecraft and locations, all set to inspirational music. Get set for an experience that will not only educate you but will also leave a lasting impression and deep respect for the men and women who worked on the Apollo program during NASA\u2019s golden era.\n\nApollo 11 VR is a new type of documentary, not only do you get to relive the events of 1969, you can also take control and fly the command module, land the lunar lander, explore the Moon's surface and deploy the lunar experiments all before returning to earth in a fiery re-entry.\n\nTake one small step today and climb aboard Apollo 11 for the journey of a lifetime.", "short_description": "Apollo 11 VR is the story of the greatest journey ever taken by humankind. This VR experience is a recreation of the events which took place between July 16th and July 24th 1969. Now for the first time ever you get to experience this historic event through the eyes of those who lived through it."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.immersivevreducation.com/", "developer_terms_of_service_url": "http://www.immersivevreducation.com/", "publisher_name": "Immersive VR Education Ltd.", "support_website_url": null, "website_url": "http://www.immersivevreducation.com/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_ta
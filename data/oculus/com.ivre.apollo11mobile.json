ated_image.png", "id": "534263077228752", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/11162687_836456139869418_4437412463352217600_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W56PvwJO43IQ7kNvwGLwcQD&_nc_oc=Ado-8fvD8m7EGmn1kPRgfjg6yP5iY-dhMP4Cu1-BRraFGsPhWm1PlIiSGOAkFQhxHGs&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLKYuS_9f-PQ2d9z0i8SFUAaewtGnK5u5UkYpJL8uHbuw&oe=6AA6B5B8"}, {"file_name": "migrated_image.png", "id": "137456474369213", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/11162685_1040540019410849_6355035770977255424_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_8SrEnl4wgcQ7kNvwHb4tIb&_nc_oc=AdpgKPFfaA02fNEnkqM4TMEjQH9xDo7cE_STJQ6V12NG5Ue5Sft08xiHjHmzzMOm1hI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLYm166Sd805l2A1pw19m5gZ-ijBizMHQZaRbQN0Nr78g&oe=6AA6A5A9"}, {"file_name": "migrated_image.png", "id": "218765856034101", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/11162679_256561344831711_3743039293812113408_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DIYeX58CcvgQ7kNvwG46DyB&_nc_oc=AdoXwqNROhg8MkZedN5cdpE5HZZlSrxRHB-iLwJQlvVVBWTaJilJlDVzG8WgmE3UIl4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLXnvJ2yaEOXnH87WOgISHxPgMf-ecDhIhBbRYUjS2J3Q&oe=6AA6AE52"}, {"file_name": "migrated_image.png", "id": "234924897699435", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/11162706_1728905930751814_7028473375836078080_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P85PTEr_bswQ7kNvwFivohW&_nc_oc=AdqnYlYh8qpi8nWbx8cKrh0enjSI0oEwbvyCcDt67byFGGHx9u_zqjOmzza4UNDl-Ks&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ6LrTF-CXgiCyKre4LEqJapsLvqeyO42bFrYuLkAO3dA&oe=6AA69EDD"}, {"file_name": "migrated_image.png", "id": "515145839183615", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/11162678_230384594120460_660784412161474560_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6ndVkxYz5RsQ7kNvwEZKX9j&_nc_oc=AdqsYX-6X7Y1SEKXqCOTrrQRxEnOI9ziQV50EryjhWKAJy11QvWVBS2YZdeo22ZORgs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKrpzcH7qFqLuoj6PXJKxOrgSKqykK50hjma4QvBYC5hA&oe=6AA6B548"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Apollo 11 VR Mobile", "keywords": ["Space", "Apollo11", "Moon", "Education", "Science"], "long_description": "Apollo 11 VR is the story of the greatest journey ever taken by humankind. \n\nNow for the first time ever, you get to experience this historic event through the eyes of those who lived through it. Using a mix of original archive audio and video together with accurate recreations of the spacecraft and locations, all set to inspirational music. Get set for an experience that will not only educate you but will also leave a lasting impression and deep respect for the men and women who worked on the Apollo program during NASA\u2019s golden era.\n\nApollo 11 VR is a new type of documentary, not only do you get to relive the events of 1969, you can also take control and fly the command module, land the lunar lander, explore the Moon's surface and deploy the lunar experiments all before returning to earth in a fiery re-entry.\n\nTake one small step today and climb aboard Apollo 11 for the journey of a lifetime.", "short_description": "Apollo 11 VR is the story of the greatest journey ever taken by humankind. This VR experience is a recreation of the events which took place between July 16th and July 24th 1969. Now for the first time ever you get to experience this historic event through the eyes of those who lived through it."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.immersivevreducation.com/", "developer_terms_of_service_url": "http://www.immersivevreducation.com/", "publisher_name": "Immersive VR Education Ltd.", "support_website_url": null, "website_url": "http://www.immersivevreducation.com/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_ta
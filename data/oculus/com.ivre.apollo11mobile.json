ated_image.png", "id": "534263077228752", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/11162687_836456139869418_4437412463352217600_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EG16lOSYx4MQ7kNvwFBFYeV&_nc_oc=AdodW5LDG5PNAqIEvRCZnJ5xjxTvYFZCbbgWAiYr6ZbITudd2HEIDB16eUyFLnX0MMc&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTZ_hnv6MqdeNH12_h3VCb9rRrC1kAhYpuvnLkZadgVpA&oe=6AF9C438"}, {"file_name": "migrated_image.png", "id": "137456474369213", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/11162685_1040540019410849_6355035770977255424_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qKcJI4E7pZAQ7kNvwHWo2bK&_nc_oc=AdrstFZZlDr5QJw0jy7rh46ephQqwk4TMiIDNhH7w-unaQqwoxqWKBnemCxh-SoJbHU&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRGDCtAQKZcRS1tHYzU7yxZfGKXEK39KLDoInox0Ex4OQ&oe=6AF9EC69"}, {"file_name": "migrated_image.png", "id": "218765856034101", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/11162679_256561344831711_3743039293812113408_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Tyj9W2B78CsQ7kNvwHu2c3p&_nc_oc=AdqPE5-hj2VX1NMdbCP0CS3LTdAqSDzU_AWMEYQukXLV9S_zPoQDR8he4ITXyfKnzf4&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSCzAE5hDGEnbYsQ8r1S1u3KlgpGZUxX_DeU3lu45l0wg&oe=6AF9BCD2"}, {"file_name": "migrated_image.png", "id": "234924897699435", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/11162706_1728905930751814_7028473375836078080_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K9gw1MnV7C4Q7kNvwEHpmim&_nc_oc=AdpkmyklBfW17a5nq-e4N0-UrY3_Rpmm3sq5EEs7ce92tjdjoGfaoitJqsT3mqE5TUs&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQf5iEtTMaPqgMURnpZLa0TY2v5cbdjM4WKYgNmYAd_eQ&oe=6AF9E59D"}, {"file_name": "migrated_image.png", "id": "515145839183615", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/11162678_230384594120460_660784412161474560_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fIzaRexKtxwQ7kNvwG4AuMK&_nc_oc=AdpCpy1ZYoceZbeknPq9QMb7N47VHPG-rKrxyJLH6ZNj9cfwf7wOpGLWCD9nz8HN8EA&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRgmeusCoK4iSO-r3gOntMM6LVL2C7jbwknQj2Oq4JqXA&oe=6AF9C3C8"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Apollo 11 VR Mobile", "keywords": ["Space", "Apollo11", "Moon", "Education", "Science"], "long_description": "Apollo 11 VR is the story of the greatest journey ever taken by humankind. \n\nNow for the first time ever, you get to experience this historic event through the eyes of those who lived through it. Using a mix of original archive audio and video together with accurate recreations of the spacecraft and locations, all set to inspirational music. Get set for an experience that will not only educate you but will also leave a lasting impression and deep respect for the men and women who worked on the Apollo program during NASA\u2019s golden era.\n\nApollo 11 VR is a new type of documentary, not only do you get to relive the events of 1969, you can also take control and fly the command module, land the lunar lander, explore the Moon's surface and deploy the lunar experiments all before returning to earth in a fiery re-entry.\n\nTake one small step today and climb aboard Apollo 11 for the journey of a lifetime.", "short_description": "Apollo 11 VR is the story of the greatest journey ever taken by humankind. This VR experience is a recreation of the events which took place between July 16th and July 24th 1969. Now for the first time ever you get to experience this historic event through the eyes of those who lived through it."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.immersivevreducation.com/", "developer_terms_of_service_url": "http://www.immersivevreducation.com/", "publisher_name": "Immersive VR Education Ltd.", "support_website_url": null, "website_url": "http://www.immersivevreducation.com/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_ta
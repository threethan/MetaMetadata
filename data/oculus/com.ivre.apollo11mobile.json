ated_image.png", "id": "534263077228752", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/11162687_836456139869418_4437412463352217600_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VQvdXGqQiXUQ7kNvwGKJKZP&_nc_oc=AdpkkOSzjWKVDTOwr-7B99waYZxBJl3MBFESkPqQEPK8APK2X9Kms7rSjiTxn6gjzQs&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfweTc1vNl6o-P1wNTsAVHPm9oZWPmRgfLCRJ5z08w3GOg&oe=69C3BB78"}, {"file_name": "migrated_image.png", "id": "137456474369213", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/11162685_1040540019410849_6355035770977255424_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NC3U7A6D1rcQ7kNvwEitMwi&_nc_oc=AdoEFDxTXIi9WpCk9prGo8sXHbeMg8Abf2yzl-WDEn_l4-Ph5f2S7EWmXhvM5ZbhgsA&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwClSKAbCjquFPlrm5-fpvGde0V4brCK71U9B_r4hJd4A&oe=69C3E3A9"}, {"file_name": "migrated_image.png", "id": "218765856034101", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/11162679_256561344831711_3743039293812113408_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y49rnFP1aBoQ7kNvwGUXYno&_nc_oc=Adq0g7ozytceHsVFpXKLqXHhPAmr16WNroEm0xa7BPwYo-DXxlboh2mhdQTdDe3lBn8&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyO7ky_MZDCFL04eWL9ofjEcX3gT4Qr3A2L4PyP7zmQMA&oe=69C3EC52"}, {"file_name": "migrated_image.png", "id": "234924897699435", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/11162706_1728905930751814_7028473375836078080_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n2Z-KJxaKIQQ7kNvwHHsC2b&_nc_oc=AdpJyolRCD3grihBr9USmn1cUV2nvINnm1igeQha95rRsojWRWvAw5-ghUUf9czPu8s&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afy73RAkI1CwbqVXVu6sQTnL5O4UeaI0UKWVYplPCRw6WA&oe=69C3DCDD"}, {"file_name": "migrated_image.png", "id": "515145839183615", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/11162678_230384594120460_660784412161474560_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-zs4A7D64UUQ7kNvwHEaK0n&_nc_oc=AdpLtFQoFzK4pruR91yUn_tj4wFmp-PC_feqxU6XO4s_8ntqW1hG-o2ldRSUc_9n7-8&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afw2OvzGkvnVOtrlZy1vnu_dDw5Mrw6rF5Kx40i1RmaIRQ&oe=69C3BB08"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Apollo 11 VR Mobile", "keywords": ["Space", "Apollo11", "Moon", "Education", "Science"], "long_description": "Apollo 11 VR is the story of the greatest journey ever taken by humankind. \n\nNow for the first time ever, you get to experience this historic event through the eyes of those who lived through it. Using a mix of original archive audio and video together with accurate recreations of the spacecraft and locations, all set to inspirational music. Get set for an experience that will not only educate you but will also leave a lasting impression and deep respect for the men and women who worked on the Apollo program during NASA\u2019s golden era.\n\nApollo 11 VR is a new type of documentary, not only do you get to relive the events of 1969, you can also take control and fly the command module, land the lunar lander, explore the Moon's surface and deploy the lunar experiments all before returning to earth in a fiery re-entry.\n\nTake one small step today and climb aboard Apollo 11 for the journey of a lifetime.", "short_description": "Apollo 11 VR is the story of the greatest journey ever taken by humankind. This VR experience is a recreation of the events which took place between July 16th and July 24th 1969. Now for the first time ever you get to experience this historic event through the eyes of those who lived through it."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.immersivevreducation.com/", "developer_terms_of_service_url": "http://www.immersivevreducation.com/", "publisher_name": "Immersive VR Education Ltd.", "support_website_url": null, "website_url": "http://www.immersivevreducation.com/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_ta
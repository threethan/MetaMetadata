vr2U2SnC0H6nmt1Y4NjGP7IbgwEZVCPraVzp_l1A9s8Lrog64yo&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=8&oh=00_AfxX4KUj2CjceBePdg9OZ1xteKGOHRAIAcZDnbsWTVMvYQ&oe=69AAE6C8"}, {"file_name": "migrated_image.png", "id": "155340308977776", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/11162706_1728905930751814_7028473375836078080_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EP8qYLasB6UQ7kNvwFDYkdH&_nc_oc=AdmUCAwCK9gJT0smvUgzawu_Hg5XXwSTpajlSuGvfBkn6E2JYavgA-eX3xCoxAdhLAg&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=8&oh=00_AfwFBmxioec0yOBmWNNrKSh_72WeC00eSdYZ8KCeDzdAhA&oe=69AAD05D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape.png", "id": "1203869659747783", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/12504788_1203869663081116_7405985754020577280_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OJUwDI_bIwQQ7kNvwHyxkfW&_nc_oc=AdnSmoYSUrf2hYrdcn-U9Wrr_uDfwCzqvKxjEyopwLSwaBwChehhGqCvBAsKbgHHnBc&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=8&oh=00_Afy7zrMeZH9LrHCGcTBG0ZKY9qHDURjSXWBEzHgQak22Ig&oe=69AACB57"}, "display_name": "Apollo 11 VR Mobile", "keywords": ["Space", "Apollo11", "Moon", "Education", "Science"], "long_description": "Apollo 11 VR is the story of the greatest journey ever taken by humankind. \n\nNow for the first time ever, you get to experience this historic event through the eyes of those who lived through it. Using a mix of original archive audio and video together with accurate recreations of the spacecraft and locations, all set to inspirational music. Get set for an experience that will not only educate you but will also leave a lasting impression and deep respect for the men and women who worked on the Apollo program during NASA\u2019s golden era.\n\nApollo 11 VR is a new type of documentary, not only do you get to relive the events of 1969, you can also take control and fly the command module, land the lunar lander, explore the Moon's surface and deploy the lunar experiments all before returning to earth in a fiery re-entry.\n\nTake one small step today and climb aboard Apollo 11 for the journey of a lifetime.", "short_description": "Apollo 11 VR is the story of the greatest journey ever taken by humankind. This VR experience is a recreation of the events which took place between July 16th and July 24th 1969. Now for the first time ever you get to experience this historic event through the eyes of those who lived through it."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.immersivevreducation.com/", "developer_terms_of_service_url": "http://www.immersivevreducation.com/", "publisher_name": "Immersive VR Education Ltd.", "support_website_url": null, "website_url": "http://www.immersivevreducation.com/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["EDUCATIONAL", "EXPLORATION", "SIMULATION", "SPACE_UNIVERSE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "en_US"], "supported_input_devices": ["TOUCHPAD", "GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "2741686095976519"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/12138999_217477508837246_2422406682165379072_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o9RsckF8DDwQ7kNvwE3sTW9&_nc_oc=AdkQQiOzlfOsFa7wntJ-x3kUek6x8Y0-k83tGLghVhHBSFSxmzDi9o23bA3m25sQeqU&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=8&oh=00_AfxlOdS28pbZvymU9rsqZislXVd2XTA1qrHQcaEaAp8lmQ&oe=69AAE6D9"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Apollo 11 VR Mobile", "plat
ated_image.png", "id": "534263077228752", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/11162687_836456139869418_4437412463352217600_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lSWhUgogFx8Q7kNvwHEnxnC&_nc_oc=AdpPdpAlCqKqko--ETIANb3aneM0bBeqi3twNdb4r1dTWfTX3apMi-hKxumzuR1wNa8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3_rQIpUqN9A3rE1DIi6IvgOOw4b-Ss3UCL7E2XVWrsbQ&oe=69D51738"}, {"file_name": "migrated_image.png", "id": "137456474369213", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/11162685_1040540019410849_6355035770977255424_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=62o2P7KoRKkQ7kNvwG7oYLp&_nc_oc=AdrwaH8UH6PSu7ucQ6E_BdFL0PVkRHmpZgBM-FUhG6dOIfvgFiNfdH42bAS2HON5iho&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2lfgZF-A-l1K9IFiJ0U3PsYtPk67pwRPP5RBpoM3ILUQ&oe=69D50729"}, {"file_name": "migrated_image.png", "id": "218765856034101", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/11162679_256561344831711_3743039293812113408_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IjIYOiaQ7bsQ7kNvwFnWh18&_nc_oc=AdrfL6skdRZji8VWGlNN15eI3PNS1ljNiFLPwKwKxB0tzoYzB2jQfG7U66-ddiiVNWw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2a6EXupcDkNa-8obZjJgYPU-2oT8qwUQ6MwFl4OySYoQ&oe=69D50FD2"}, {"file_name": "migrated_image.png", "id": "234924897699435", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/11162706_1728905930751814_7028473375836078080_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MLZ0Uw9oyY4Q7kNvwF0NwGi&_nc_oc=AdrQykb05w8MPW33eSl4ia2UlR1eeIs80wb4XU3oLIzuzR2sUgR2_9KUG4Bb4SnvaVs&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3ZQdB_WJuI7rjIwPS6n1iDCy15BQpu3Uo_4PoK3oNuDg&oe=69D5005D"}, {"file_name": "migrated_image.png", "id": "515145839183615", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/11162678_230384594120460_660784412161474560_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6xY65DpGEDQQ7kNvwGsOb_i&_nc_oc=Adp-W6u7EjXahet4TbImrj5vhjvoXhcpFpOqiQrems5pD5aUWwNsw3dO0SwWrNOshIc&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af36UlUAZb1t-8sHVWdeWAnf-UzyOy2UVS-jD6RlYQItiQ&oe=69D516C8"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Apollo 11 VR Mobile", "keywords": ["Space", "Apollo11", "Moon", "Education", "Science"], "long_description": "Apollo 11 VR is the story of the greatest journey ever taken by humankind. \n\nNow for the first time ever, you get to experience this historic event through the eyes of those who lived through it. Using a mix of original archive audio and video together with accurate recreations of the spacecraft and locations, all set to inspirational music. Get set for an experience that will not only educate you but will also leave a lasting impression and deep respect for the men and women who worked on the Apollo program during NASA\u2019s golden era.\n\nApollo 11 VR is a new type of documentary, not only do you get to relive the events of 1969, you can also take control and fly the command module, land the lunar lander, explore the Moon's surface and deploy the lunar experiments all before returning to earth in a fiery re-entry.\n\nTake one small step today and climb aboard Apollo 11 for the journey of a lifetime.", "short_description": "Apollo 11 VR is the story of the greatest journey ever taken by humankind. This VR experience is a recreation of the events which took place between July 16th and July 24th 1969. Now for the first time ever you get to experience this historic event through the eyes of those who lived through it."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.immersivevreducation.com/", "developer_terms_of_service_url": "http://www.immersivevreducation.com/", "publisher_name": "Immersive VR Education Ltd.", "support_website_url": null, "website_url": "http://www.immersivevreducation.com/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_ta
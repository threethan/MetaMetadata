ated_image.png", "id": "534263077228752", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/11162687_836456139869418_4437412463352217600_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LqeT8xO12xEQ7kNvwE1HBho&_nc_oc=AdohZCaLy2_5xcAkXkHkuFwgQ3t-hgZwuDefW2pqHI_rc0ikTcH63S3lEEUuAlB9HhM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGLWkxO8KXAuzM1xTSbc7klX-0Y_Bn4LN43CXcXAZeB3w&oe=6A843678"}, {"file_name": "migrated_image.png", "id": "137456474369213", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/11162685_1040540019410849_6355035770977255424_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7BoaoNIcmJ8Q7kNvwHinxpi&_nc_oc=AdrjyufInUkXwgi7uXhbTlAGYHFPGU_gpVQo32z6b6zIQRTW1Wkn3YjBkD3PcNfkINE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHFfKeZAkc_xJkzrvmyxAQx2CiJUEbtsnj5o71uJ6BoLw&oe=6A845EA9"}, {"file_name": "migrated_image.png", "id": "218765856034101", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/11162679_256561344831711_3743039293812113408_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=csaAO3JDMsIQ7kNvwGMflnz&_nc_oc=Adpu8GvWep1MxnaUzSo98skPLT9qNlCLPLKmOLPninDrEzE3VQYU6z5kuQEjhbda6Uo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEqrvNUedQtA7Gqccb_kXa3lXPlPv1sRm2rKrHV96sxQQ&oe=6A846752"}, {"file_name": "migrated_image.png", "id": "234924897699435", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/11162706_1728905930751814_7028473375836078080_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6xywlrErU8AQ7kNvwEIzW_1&_nc_oc=Adrz2p7qNuaMhiKzGQGp6Abav-whRIgSk3WO1s3Pq4URL8ep0_p5ldhD7jWlXZBF-jE&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFCDCOhb1Xm6xMv7gLWO5Z32KPvKjD_jpDVG_Le6pSN3A&oe=6A8457DD"}, {"file_name": "migrated_image.png", "id": "515145839183615", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/11162678_230384594120460_660784412161474560_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f-V9FmroCcUQ7kNvwGJwZWZ&_nc_oc=AdqlR5GmT5ZFlt4jh-9-sER2nQn0gqq3BExEwoldUSGVlQjvQ4djV1PqEPTmXEZzsLA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHh2lcXQvez2gs5EtPX4AF98r00migxdu_7fLHr63FAWg&oe=6A843608"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Apollo 11 VR Mobile", "keywords": ["Space", "Apollo11", "Moon", "Education", "Science"], "long_description": "Apollo 11 VR is the story of the greatest journey ever taken by humankind. \n\nNow for the first time ever, you get to experience this historic event through the eyes of those who lived through it. Using a mix of original archive audio and video together with accurate recreations of the spacecraft and locations, all set to inspirational music. Get set for an experience that will not only educate you but will also leave a lasting impression and deep respect for the men and women who worked on the Apollo program during NASA\u2019s golden era.\n\nApollo 11 VR is a new type of documentary, not only do you get to relive the events of 1969, you can also take control and fly the command module, land the lunar lander, explore the Moon's surface and deploy the lunar experiments all before returning to earth in a fiery re-entry.\n\nTake one small step today and climb aboard Apollo 11 for the journey of a lifetime.", "short_description": "Apollo 11 VR is the story of the greatest journey ever taken by humankind. This VR experience is a recreation of the events which took place between July 16th and July 24th 1969. Now for the first time ever you get to experience this historic event through the eyes of those who lived through it."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.immersivevreducation.com/", "developer_terms_of_service_url": "http://www.immersivevreducation.com/", "publisher_name": "Immersive VR Education Ltd.", "support_website_url": null, "website_url": "http://www.immersivevreducation.com/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_ta
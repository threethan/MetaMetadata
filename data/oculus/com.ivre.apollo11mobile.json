QOcHO&_nc_oc=Adr15jAUe5UB7LZNtgtPNbJilbRu9a14ZCVpmrRnLZgkMb9yQlnlil0H2-hjhgsd8CI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9fa1O9Fzp6lWEgF87EquNL89K34sxg8KHn2g1g_QjP0A&oe=6A3E8EC8"}, {"file_name": "migrated_image.png", "id": "155340308977776", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/11162706_1728905930751814_7028473375836078080_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Cx84GZYQZR8Q7kNvwHCdtXS&_nc_oc=AdrwRR36Da_Z9bjJcfcE8QLnMNYVldi-jeefKlPRngO6CAugPMFRGj4k2OOcbcVRxmw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af82PW-8HaAnuiLhwYvfkBl9zJGzRJh7U_I6qNCFvwiYuA&oe=6A3EB09D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape.png", "id": "1203869659747783", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12504788_1203869663081116_7405985754020577280_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rBMJyUb1-nIQ7kNvwFkrv06&_nc_oc=AdolKfxDLTcQV1AUmKwwEJwivH7HPLtlhq_bRPtU_2tCN7Z5wPJtR2sovaCGMIDg1As&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af92CSwr6e2h3N0EBZQwZ-e4_nmRwcZyme4U40kVcD6Bbw&oe=6A3EAB97"}, "display_name": "Apollo 11 VR Mobile", "keywords": ["Space", "Apollo11", "Moon", "Education", "Science"], "long_description": "Apollo 11 VR is the story of the greatest journey ever taken by humankind. \n\nNow for the first time ever, you get to experience this historic event through the eyes of those who lived through it. Using a mix of original archive audio and video together with accurate recreations of the spacecraft and locations, all set to inspirational music. Get set for an experience that will not only educate you but will also leave a lasting impression and deep respect for the men and women who worked on the Apollo program during NASA\u2019s golden era.\n\nApollo 11 VR is a new type of documentary, not only do you get to relive the events of 1969, you can also take control and fly the command module, land the lunar lander, explore the Moon's surface and deploy the lunar experiments all before returning to earth in a fiery re-entry.\n\nTake one small step today and climb aboard Apollo 11 for the journey of a lifetime.", "short_description": "Apollo 11 VR is the story of the greatest journey ever taken by humankind. This VR experience is a recreation of the events which took place between July 16th and July 24th 1969. Now for the first time ever you get to experience this historic event through the eyes of those who lived through it."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.immersivevreducation.com/", "developer_terms_of_service_url": "http://www.immersivevreducation.com/", "publisher_name": "Immersive VR Education Ltd.", "support_website_url": null, "website_url": "http://www.immersivevreducation.com/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["EDUCATIONAL", "EXPLORATION", "SIMULATION", "SPACE_UNIVERSE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "en_US"], "supported_input_devices": ["TOUCHPAD", "GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "2741686095976519"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12138999_217477508837246_2422406682165379072_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N_QKroI20m4Q7kNvwFrzwXM&_nc_oc=AdpUO9j1lMRCxI1dUB_8tI4zvYBbHb3p7VsBDND7pXKdwZDD5tOW_Dg8b4uITEfoL9Y&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-prQd4k0rhQnpb1Xhi21R3JST09CrTFjzZDz9uTw5Gnw&oe=6A3E8ED9"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "d
ated_image.png", "id": "534263077228752", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/11162687_836456139869418_4437412463352217600_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ymbdADb_HSkQ7kNvwEeBH9N&_nc_oc=Adr22Ytf36JrE27unc-3j9yPP1rOolS35fyC-n63glw9CeISUjnGDxd6HAcJS_2iz9Y&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1P1tG_nS0YLJFjKNfNSGyibtVMS55APnEZSbLG_x9kAA&oe=69DD0038"}, {"file_name": "migrated_image.png", "id": "137456474369213", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/11162685_1040540019410849_6355035770977255424_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Sb1pgJXNCr4Q7kNvwEnYpgq&_nc_oc=AdqC_y8eiyZUgDOPaeTfz7RLRWbZ7wJSfNUA6tR7P4wv3JQCXcSfqdf9oIk1Q9xd_Z4&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af24DkpmvoWf8jJ1xoNXPoUKvhrtm3M3TVEL1n6iqaO6kw&oe=69DCF029"}, {"file_name": "migrated_image.png", "id": "218765856034101", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/11162679_256561344831711_3743039293812113408_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R-2-TpETGRkQ7kNvwEtYnJB&_nc_oc=AdoIi7tSMyHIkS7rJAqUBgMjZQa1TBqeMLw9igRxTxIaizKcq7qlaSVEB7CejX8kLbk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2bq4ODPRN-CNNUFZzy8h9vJyi9PpkNtO1xVeWGch_KpQ&oe=69DCF8D2"}, {"file_name": "migrated_image.png", "id": "234924897699435", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/11162706_1728905930751814_7028473375836078080_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tsK3We2RdtYQ7kNvwEwd1P7&_nc_oc=AdqF5RAYKQ9CNyJluFx8lMQBGhSWg_6Eb5pnHFnlrF7wlMk1TIlYZytXIsOJGghcyu0&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1mmCg9oSdh0TkpXJNs8vns3sfisi6hpzU-vhnHKffn7w&oe=69DCE95D"}, {"file_name": "migrated_image.png", "id": "515145839183615", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/11162678_230384594120460_660784412161474560_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ghiY21AhmmIQ7kNvwGE8y2p&_nc_oc=AdrjmRPrjb3pQHVxDm_zSKF7tRIIj9pTxwOMzKQVpbjGaFD7R2ivCYlXUrNmNZS0b_I&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1w_eHx0gLzWUBSp_eWPOiX-5yaxIlM2fKJx1t9Diq6VA&oe=69DCFFC8"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Apollo 11 VR Mobile", "keywords": ["Space", "Apollo11", "Moon", "Education", "Science"], "long_description": "Apollo 11 VR is the story of the greatest journey ever taken by humankind. \n\nNow for the first time ever, you get to experience this historic event through the eyes of those who lived through it. Using a mix of original archive audio and video together with accurate recreations of the spacecraft and locations, all set to inspirational music. Get set for an experience that will not only educate you but will also leave a lasting impression and deep respect for the men and women who worked on the Apollo program during NASA\u2019s golden era.\n\nApollo 11 VR is a new type of documentary, not only do you get to relive the events of 1969, you can also take control and fly the command module, land the lunar lander, explore the Moon's surface and deploy the lunar experiments all before returning to earth in a fiery re-entry.\n\nTake one small step today and climb aboard Apollo 11 for the journey of a lifetime.", "short_description": "Apollo 11 VR is the story of the greatest journey ever taken by humankind. This VR experience is a recreation of the events which took place between July 16th and July 24th 1969. Now for the first time ever you get to experience this historic event through the eyes of those who lived through it."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.immersivevreducation.com/", "developer_terms_of_service_url": "http://www.immersivevreducation.com/", "publisher_name": "Immersive VR Education Ltd.", "support_website_url": null, "website_url": "http://www.immersivevreducation.com/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_ta
ated_image.png", "id": "534263077228752", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/11162687_836456139869418_4437412463352217600_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QH-p_a1Ogh0Q7kNvwGa2sAq&_nc_oc=Adqm1fue_l_ox1f4bq-dBFYQArbffcLtfaIIByyNWwJZupvy2ZyqA9lwYegPNmk60Oc&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPL--1253Huez4aKLkZ3aT7oecKkNqDmHGgPxtFCfOIyg&oe=6AD388B8"}, {"file_name": "migrated_image.png", "id": "137456474369213", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/11162685_1040540019410849_6355035770977255424_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_fcaR-6D8iYQ7kNvwHT_VEF&_nc_oc=AdpvqcOd9sCxJd7xy9OXyWW9WJ6szhjUW4jovxwO1VCTmwf95LYVkIPNPlKnECp37wU&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPImrAMAHCSGXmjcxk_fVfGLionyrKlO8JAbxcry3mvNw&oe=6AD3B0E9"}, {"file_name": "migrated_image.png", "id": "218765856034101", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/11162679_256561344831711_3743039293812113408_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Mf2wQT5YaKMQ7kNvwHEIcv1&_nc_oc=AdoajCtqU84S4SMPWZ_dlWLm6030im6up1sttMjgoaO4pWRJSD-4Q-WtNfd8kxgkHOQ&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNcXeoSmQ2K4j53siS1PX7FCLTGMUbwziJrSgH7G7U0Gg&oe=6AD3B992"}, {"file_name": "migrated_image.png", "id": "234924897699435", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/11162706_1728905930751814_7028473375836078080_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bBYpZ5ZEWnUQ7kNvwE42UgJ&_nc_oc=AdpJp_1SM-jdbINlkgPM8w335clcYZOIvqKzFn_ThOm-Kqs3Qx-wL0rgjzELsk-tE0A&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMAi6pavExspLSzo_JKCv83l4NITEBOJWaRvmiiETdaZA&oe=6AD3AA1D"}, {"file_name": "migrated_image.png", "id": "515145839183615", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/11162678_230384594120460_660784412161474560_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=39-YTIeBVo0Q7kNvwHO_Z6H&_nc_oc=AdoBwpX9CiDKx1ztBrtJ5ze5eCfZuIp4ZCgBUGHo043gKH8DeiqDnCm7sJCOtnlbvZQ&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNAmx6CytF2l4tiu-gP42Rw7DeHVJH-13tvrgzMcWSv5w&oe=6AD38848"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Apollo 11 VR Mobile", "keywords": ["Space", "Apollo11", "Moon", "Education", "Science"], "long_description": "Apollo 11 VR is the story of the greatest journey ever taken by humankind. \n\nNow for the first time ever, you get to experience this historic event through the eyes of those who lived through it. Using a mix of original archive audio and video together with accurate recreations of the spacecraft and locations, all set to inspirational music. Get set for an experience that will not only educate you but will also leave a lasting impression and deep respect for the men and women who worked on the Apollo program during NASA\u2019s golden era.\n\nApollo 11 VR is a new type of documentary, not only do you get to relive the events of 1969, you can also take control and fly the command module, land the lunar lander, explore the Moon's surface and deploy the lunar experiments all before returning to earth in a fiery re-entry.\n\nTake one small step today and climb aboard Apollo 11 for the journey of a lifetime.", "short_description": "Apollo 11 VR is the story of the greatest journey ever taken by humankind. This VR experience is a recreation of the events which took place between July 16th and July 24th 1969. Now for the first time ever you get to experience this historic event through the eyes of those who lived through it."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.immersivevreducation.com/", "developer_terms_of_service_url": "http://www.immersivevreducation.com/", "publisher_name": "Immersive VR Education Ltd.", "support_website_url": null, "website_url": "http://www.immersivevreducation.com/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_ta
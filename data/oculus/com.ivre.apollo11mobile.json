ated_image.png", "id": "534263077228752", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/11162687_836456139869418_4437412463352217600_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VQvdXGqQiXUQ7kNvwEbsrQS&_nc_oc=AdpRN20f9mJXHTMpCtfiQb2RPlAMcHYxzs2SwsZJwYNvPxqUnX8SfD110Osp7sDaJAU&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyQWbKcUwVC6omaPN3hwKIy8ySP9PKlOk_tUbHgAgM-iQ&oe=69C269F8"}, {"file_name": "migrated_image.png", "id": "137456474369213", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/11162685_1040540019410849_6355035770977255424_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7nJAU-3G3koQ7kNvwEGlJ4t&_nc_oc=Ado-zxfFEXtj0QIebDYtpSN1Am7pTC_54ObDUng8PHRwpT4cg0QO6daWE5gzG1iRQ1s&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxYhWxKqze15Lg9WLlj_QjkAHlktZbOu8i4BNlWf2_nfg&oe=69C29229"}, {"file_name": "migrated_image.png", "id": "218765856034101", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/11162679_256561344831711_3743039293812113408_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y49rnFP1aBoQ7kNvwGmY03t&_nc_oc=AdqkZgkMJlViU9vzK1Q_EZqA-_ehOTwlFD9mwiF7eEdAWdXtZEHybVXSmGCTlYJSlIQ&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afz5viJs8Gy7V0EzQCEpTc2qBCtCMkL6T8_ISGbmSx1z8A&oe=69C29AD2"}, {"file_name": "migrated_image.png", "id": "234924897699435", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/11162706_1728905930751814_7028473375836078080_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n2Z-KJxaKIQQ7kNvwFkPmd9&_nc_oc=AdpJbkzHLenm-SFUs3si02XbP25TLfZb_NUZKy8V7016YSse0YNQueNH6ub0f7Xq5OE&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxwywFzAw0cx7CzoiLbFqAxmVzfcemcSDvoa9kG8ztP_A&oe=69C28B5D"}, {"file_name": "migrated_image.png", "id": "515145839183615", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/11162678_230384594120460_660784412161474560_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=veWFy3hU6KAQ7kNvwEJTie6&_nc_oc=Adq3y_ZGXVg4BmRMJkp0o7MQqIYdcr53dnRW8BMBup0-hBmLcouoRN7NeMvP0NsaHhc&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzY-8yx_5Dc-W9DU7YsW5vCKlgQsdRZAI91ehhPCk8ELw&oe=69C26988"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Apollo 11 VR Mobile", "keywords": ["Space", "Apollo11", "Moon", "Education", "Science"], "long_description": "Apollo 11 VR is the story of the greatest journey ever taken by humankind. \n\nNow for the first time ever, you get to experience this historic event through the eyes of those who lived through it. Using a mix of original archive audio and video together with accurate recreations of the spacecraft and locations, all set to inspirational music. Get set for an experience that will not only educate you but will also leave a lasting impression and deep respect for the men and women who worked on the Apollo program during NASA\u2019s golden era.\n\nApollo 11 VR is a new type of documentary, not only do you get to relive the events of 1969, you can also take control and fly the command module, land the lunar lander, explore the Moon's surface and deploy the lunar experiments all before returning to earth in a fiery re-entry.\n\nTake one small step today and climb aboard Apollo 11 for the journey of a lifetime.", "short_description": "Apollo 11 VR is the story of the greatest journey ever taken by humankind. This VR experience is a recreation of the events which took place between July 16th and July 24th 1969. Now for the first time ever you get to experience this historic event through the eyes of those who lived through it."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.immersivevreducation.com/", "developer_terms_of_service_url": "http://www.immersivevreducation.com/", "publisher_name": "Immersive VR Education Ltd.", "support_website_url": null, "website_url": "http://www.immersivevreducation.com/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_ta
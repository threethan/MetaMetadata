pWtYv6Q6hpZPZRklPVfDreUgZtyvN8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfvufpL4ElEBiG_5qMsQ3DeAPMhCvye2IAnoa1xUq4_-Gw&oe=69A6BA78"}, {"file_name": "migrated_image.png", "id": "137456474369213", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/11162685_1040540019410849_6355035770977255424_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dgr__eDibi4Q7kNvwFJmS0i&_nc_oc=AdnPvii1Xj10f4zxzEBwrb_d4P1zMXtxH2rBu6-goZVkqyITfsu-qYMLyxzsWeNvEwY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afu0u-zIFJZhMP0daHdZL4apJq6yA8HcPMGiHbdZ-88ogQ&oe=69A6E2A9"}, {"file_name": "migrated_image.png", "id": "218765856034101", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/11162679_256561344831711_3743039293812113408_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RsMgT6YOesgQ7kNvwEJ1SmD&_nc_oc=AdlvJQ01o6QQw1MdXqX-k5KGfAOQJ8wPgqQIHj-ZypP26DnDKaoczH42OA8VUDazUTI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afu3gozwy65DMnHNLkZRCHFelrKjg5JgsQRiV7WZcHPNPw&oe=69A6EB52"}, {"file_name": "migrated_image.png", "id": "234924897699435", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/11162706_1728905930751814_7028473375836078080_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HVqi8SHLFLYQ7kNvwE9xk-O&_nc_oc=AdnHUPxnR_M6H7rfQ2qkjkLTy-OuxePKPEwTiiATo90lzR7QW8BvIzNZLjGCF7r02ZU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Afsdy-vejPPX5xNsv8OG0ixmg61sOykOIIoRX-4Rbh-HAA&oe=69A6DBDD"}, {"file_name": "migrated_image.png", "id": "515145839183615", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/11162678_230384594120460_660784412161474560_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gjvTZEaka5QQ7kNvwEaLVXh&_nc_oc=AdmGj_mXwRi9iK7HTIJ_1lTS4f73CcKqtldwkYBDKIFpQDJXh0sxoM0lUduWkHngqgA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfvIAsfihYTFb60k4DsUP5FoZJk5sgZXO0dUa8cJpefEwg&oe=69A6BA08"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Apollo 11 VR Mobile", "keywords": ["Space", "Apollo11", "Moon", "Education", "Science"], "long_description": "Apollo 11 VR is the story of the greatest journey ever taken by humankind. \n\nNow for the first time ever, you get to experience this historic event through the eyes of those who lived through it. Using a mix of original archive audio and video together with accurate recreations of the spacecraft and locations, all set to inspirational music. Get set for an experience that will not only educate you but will also leave a lasting impression and deep respect for the men and women who worked on the Apollo program during NASA\u2019s golden era.\n\nApollo 11 VR is a new type of documentary, not only do you get to relive the events of 1969, you can also take control and fly the command module, land the lunar lander, explore the Moon's surface and deploy the lunar experiments all before returning to earth in a fiery re-entry.\n\nTake one small step today and climb aboard Apollo 11 for the journey of a lifetime.", "short_description": "Apollo 11 VR is the story of the greatest journey ever taken by humankind. This VR experience is a recreation of the events which took place between July 16th and July 24th 1969. Now for the first time ever you get to experience this historic event through the eyes of those who lived through it."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.immersivevreducation.com/", "developer_terms_of_service_url": "http://www.immersivevreducation.com/", "publisher_name": "Immersive VR Education Ltd.", "support_website_url": null, "website_url": "http://www.immersivevreducation.com/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["EDUCATIONAL", "EXPLORATION", "SIMULATION", "ADVENTURE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor":
ated_image.png", "id": "534263077228752", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/11162687_836456139869418_4437412463352217600_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y_V0PSyhXqgQ7kNvwEt4wz0&_nc_oc=AdqmCQ3rk6UQ_XdpNwfG6x-5QiPdafiHfcTcE4haJIR62Gb4gffk0IzfHNUWwSdT_yw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGpkGggIEiADYpgKEMc5j3FhiI8HizArR1wEDinbOHaVg&oe=6A8C1F78"}, {"file_name": "migrated_image.png", "id": "137456474369213", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/11162685_1040540019410849_6355035770977255424_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y5dEHDfQanIQ7kNvwGy3UiT&_nc_oc=Ado9knJNyGUci2b3pekRbejcqFsSODxhhaLh5d2YpftMGJBtdWL1IMGgNLIUXNWivto&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHugQuIqv_AIL1HOvG4W7SHxXAjQhSB9-UiMqImACz31w&oe=6A8C47A9"}, {"file_name": "migrated_image.png", "id": "218765856034101", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/11162679_256561344831711_3743039293812113408_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xY-EXzwhjfgQ7kNvwHPgV4i&_nc_oc=Ado2nxUho3bhxQxTFgT3KZXXcmIGsZDPu6ntDQLLMOpguJprJI6PX02FEs7GgEbuIm4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFSOXdeGqd5UngsxJu0NhHCQ87J0jqUZyN-XmFzztFTvQ&oe=6A8C1812"}, {"file_name": "migrated_image.png", "id": "234924897699435", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/11162706_1728905930751814_7028473375836078080_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cpndLC4QcukQ7kNvwGOurze&_nc_oc=Adq15oaDqkzDObKXbkETGMZ7Lg7OcWpN7yQrsXN3_O3TRViW4E5I1VCwPxL1Q_4By7I&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHeiKimIsXT2PkJjCFPwMtjSwluyOccHyibijEP7aMoCw&oe=6A8C40DD"}, {"file_name": "migrated_image.png", "id": "515145839183615", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/11162678_230384594120460_660784412161474560_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U3AHAGJF7yoQ7kNvwEZqQoL&_nc_oc=Adr_m1PfWoZ6HwYBBTkML0coGP7VTRKepysIhlkyabBdrarzqdnEyxeHEFMBhqLvkf4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFgxJxM57iwGIryVEngrNR-mlgh88cPly0Kdl0rzoWlBw&oe=6A8C1F08"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Apollo 11 VR Mobile", "keywords": ["Space", "Apollo11", "Moon", "Education", "Science"], "long_description": "Apollo 11 VR is the story of the greatest journey ever taken by humankind. \n\nNow for the first time ever, you get to experience this historic event through the eyes of those who lived through it. Using a mix of original archive audio and video together with accurate recreations of the spacecraft and locations, all set to inspirational music. Get set for an experience that will not only educate you but will also leave a lasting impression and deep respect for the men and women who worked on the Apollo program during NASA\u2019s golden era.\n\nApollo 11 VR is a new type of documentary, not only do you get to relive the events of 1969, you can also take control and fly the command module, land the lunar lander, explore the Moon's surface and deploy the lunar experiments all before returning to earth in a fiery re-entry.\n\nTake one small step today and climb aboard Apollo 11 for the journey of a lifetime.", "short_description": "Apollo 11 VR is the story of the greatest journey ever taken by humankind. This VR experience is a recreation of the events which took place between July 16th and July 24th 1969. Now for the first time ever you get to experience this historic event through the eyes of those who lived through it."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.immersivevreducation.com/", "developer_terms_of_service_url": "http://www.immersivevreducation.com/", "publisher_name": "Immersive VR Education Ltd.", "support_website_url": null, "website_url": "http://www.immersivevreducation.com/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_ta
ated_image.png", "id": "534263077228752", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/11162687_836456139869418_4437412463352217600_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AWTECOPyHd4Q7kNvwG6qxtx&_nc_oc=Adq86gUXIh5Wb1MbiMpO57P9pkTIrXFLUteGjSsoCvsq173fo_DWjPKvG4yBzhjuVmU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6EW385hXTvyBHBlwGJNlLsLg5AmgqB2aWbIox09lC2Ng&oe=6A19A538"}, {"file_name": "migrated_image.png", "id": "137456474369213", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/11162685_1040540019410849_6355035770977255424_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XZxSk8YFWcwQ7kNvwGufF0g&_nc_oc=AdrDhiG3cH2Yo5cRJaQVkDKj2I3tVoUkE0S8nCtnxmQYBXE9bK3BAO0mbhTcLwcrjYY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7b-0tiURXyDJWeCGlkz1wNHFigZA8bIJO0IxRd7oB5EA&oe=6A199529"}, {"file_name": "migrated_image.png", "id": "218765856034101", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/11162679_256561344831711_3743039293812113408_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PXllAktxvq0Q7kNvwFHd_Kw&_nc_oc=Adquopar3uIUqJIPeoy6nLMiPXzhmWsMgTVjQpzfSCUi6i-POrQMfdfRIl1jTCnL-2w&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6ip6d68wWB5jqOmGWefoJWLIxa5Vz6glNd5zBkWX1Xew&oe=6A199DD2"}, {"file_name": "migrated_image.png", "id": "234924897699435", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/11162706_1728905930751814_7028473375836078080_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZJLAeH2lZ5kQ7kNvwFGCGuf&_nc_oc=Ado8KQjj3CoSEtnJ3W50i0MU0GU_jFpIAZHs66q4oW0iDeOXurqwX1sF5MxV9DBWiOA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5g9m5CZHwykB1lHGE9sU2zGe_Wuv6G61yD2y8Xki3-OA&oe=6A198E5D"}, {"file_name": "migrated_image.png", "id": "515145839183615", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/11162678_230384594120460_660784412161474560_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sFu5c59L-pgQ7kNvwE1E_WP&_nc_oc=Adrt98rnObL-VLVc5X5RvVJJ6om4j9x72hW4BSD1sRF_DiRyVEHSRob41nMKBASQwTs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af475r8bYas4txEg7dQu31Cf8W1d1lR8nVWa_Ldh0-m9eA&oe=6A19A4C8"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Apollo 11 VR Mobile", "keywords": ["Space", "Apollo11", "Moon", "Education", "Science"], "long_description": "Apollo 11 VR is the story of the greatest journey ever taken by humankind. \n\nNow for the first time ever, you get to experience this historic event through the eyes of those who lived through it. Using a mix of original archive audio and video together with accurate recreations of the spacecraft and locations, all set to inspirational music. Get set for an experience that will not only educate you but will also leave a lasting impression and deep respect for the men and women who worked on the Apollo program during NASA\u2019s golden era.\n\nApollo 11 VR is a new type of documentary, not only do you get to relive the events of 1969, you can also take control and fly the command module, land the lunar lander, explore the Moon's surface and deploy the lunar experiments all before returning to earth in a fiery re-entry.\n\nTake one small step today and climb aboard Apollo 11 for the journey of a lifetime.", "short_description": "Apollo 11 VR is the story of the greatest journey ever taken by humankind. This VR experience is a recreation of the events which took place between July 16th and July 24th 1969. Now for the first time ever you get to experience this historic event through the eyes of those who lived through it."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.immersivevreducation.com/", "developer_terms_of_service_url": "http://www.immersivevreducation.com/", "publisher_name": "Immersive VR Education Ltd.", "support_website_url": null, "website_url": "http://www.immersivevreducation.com/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_ta
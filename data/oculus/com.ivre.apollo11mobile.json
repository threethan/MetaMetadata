ated_image.png", "id": "534263077228752", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/11162687_836456139869418_4437412463352217600_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mmlDtIUxMtQQ7kNvwEw9DkX&_nc_oc=AdpiuMKE11NErd8zA-emOMk-tsyri8SD3EsI_Fy-2_edRwnX7fhtU8t_aE6cjmAM8TY&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLPFGEZr56U5GpusIaGIGxtyyUNiEQwZJdHiAkB4dZCqQ&oe=6AB687B8"}, {"file_name": "migrated_image.png", "id": "137456474369213", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/11162685_1040540019410849_6355035770977255424_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RYidCbKZKNkQ7kNvwG2wKAa&_nc_oc=AdoNt_49t-qCh-Xd4nmP-XJ49Uq_rJfrA4w8cyukLXyb8kgKWYpp_S0ol3E7uMPk9rQ&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ4KIAB7AUt9s-FIpzMkZGoFIxAxIHQdNGCJVlNNPUiFQ&oe=6AB677A9"}, {"file_name": "migrated_image.png", "id": "218765856034101", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/11162679_256561344831711_3743039293812113408_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WsjZDh3aIMkQ7kNvwHY4ywp&_nc_oc=Adqi8flj6ZFEAWj6B8yJg3yJCFyYNmq8f9JpeUR0GLwyXV4H02NFJXGwswtDgkd78_4&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJtjKtMyPZQuWsKAA4HqaHZE3EW_KzZX9-ptLGLQUbE0g&oe=6AB68052"}, {"file_name": "migrated_image.png", "id": "234924897699435", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/11162706_1728905930751814_7028473375836078080_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jPcMdHydBHoQ7kNvwH0RjnX&_nc_oc=AdqOtBX60lCy9trJRyk2xpxbB9Vh6QEZ8z_kRJgvu9KfqlLrsASlu_KxcUSMtZNMldU&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJLQKLv6RacMARyAnXmmhOtRo3aGUH03VOTI45ly_DA0w&oe=6AB670DD"}, {"file_name": "migrated_image.png", "id": "515145839183615", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/11162678_230384594120460_660784412161474560_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TB6ECwNkPJ8Q7kNvwEDrbEi&_nc_oc=Adq0jSrqOMyOV2ufkeBEgx_drUCBUTZz7CHSA015F4Ltpr5HQAEacuM8X8CxsA_1H3g&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLb3AUKIjnTGzPOSjWczilX0Xp9yCg5K0zYGbVogB8KTA&oe=6AB68748"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Apollo 11 VR Mobile", "keywords": ["Space", "Apollo11", "Moon", "Education", "Science"], "long_description": "Apollo 11 VR is the story of the greatest journey ever taken by humankind. \n\nNow for the first time ever, you get to experience this historic event through the eyes of those who lived through it. Using a mix of original archive audio and video together with accurate recreations of the spacecraft and locations, all set to inspirational music. Get set for an experience that will not only educate you but will also leave a lasting impression and deep respect for the men and women who worked on the Apollo program during NASA\u2019s golden era.\n\nApollo 11 VR is a new type of documentary, not only do you get to relive the events of 1969, you can also take control and fly the command module, land the lunar lander, explore the Moon's surface and deploy the lunar experiments all before returning to earth in a fiery re-entry.\n\nTake one small step today and climb aboard Apollo 11 for the journey of a lifetime.", "short_description": "Apollo 11 VR is the story of the greatest journey ever taken by humankind. This VR experience is a recreation of the events which took place between July 16th and July 24th 1969. Now for the first time ever you get to experience this historic event through the eyes of those who lived through it."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.immersivevreducation.com/", "developer_terms_of_service_url": "http://www.immersivevreducation.com/", "publisher_name": "Immersive VR Education Ltd.", "support_website_url": null, "website_url": "http://www.immersivevreducation.com/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_ta
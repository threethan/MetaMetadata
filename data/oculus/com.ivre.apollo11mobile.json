oFEed&_nc_oc=Adp_quD7fIvr-K_RdTI37qhFpxmCZsKMtk_8YVh6M1_vGPvAFGqoGm2ndq8c6Ml7iJs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0C83M8z3xbTo0cOW4iCA5UPNsMVcnLaEl6lH2zyIA9wQ&oe=69EE2348"}, {"file_name": "migrated_image.png", "id": "155340308977776", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/11162706_1728905930751814_7028473375836078080_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ypbqmwEoCtYQ7kNvwFxxCV3&_nc_oc=Ado-FQHUgji9QvPMihuDImM4b7Q5YxW18NMUxOHXpQfxyPT3jiyZ-5JEsQhnzV_T1PU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3qLgPnwpKv8uZbMWPvVseuTsTirNIqGmXflqAzZcSoYw&oe=69EE0CDD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape.png", "id": "1203869659747783", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/12504788_1203869663081116_7405985754020577280_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b5QIgBswnaAQ7kNvwGbJVOY&_nc_oc=Adr_CJm3O6TKOTRQltObSLwiDO0RLmG2ihiPPgCZ71DjB_Z-FrwWwKmlRUVVzZDkJ4E&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3W2WY4licndpZTkJTNKEF4ROONgvCmPOdpp_QJAHustQ&oe=69EE07D7"}, "display_name": "Apollo 11 VR Mobile", "keywords": ["Space", "Apollo11", "Moon", "Education", "Science"], "long_description": "Apollo 11 VR is the story of the greatest journey ever taken by humankind. \n\nNow for the first time ever, you get to experience this historic event through the eyes of those who lived through it. Using a mix of original archive audio and video together with accurate recreations of the spacecraft and locations, all set to inspirational music. Get set for an experience that will not only educate you but will also leave a lasting impression and deep respect for the men and women who worked on the Apollo program during NASA\u2019s golden era.\n\nApollo 11 VR is a new type of documentary, not only do you get to relive the events of 1969, you can also take control and fly the command module, land the lunar lander, explore the Moon's surface and deploy the lunar experiments all before returning to earth in a fiery re-entry.\n\nTake one small step today and climb aboard Apollo 11 for the journey of a lifetime.", "short_description": "Apollo 11 VR is the story of the greatest journey ever taken by humankind. This VR experience is a recreation of the events which took place between July 16th and July 24th 1969. Now for the first time ever you get to experience this historic event through the eyes of those who lived through it."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.immersivevreducation.com/", "developer_terms_of_service_url": "http://www.immersivevreducation.com/", "publisher_name": "Immersive VR Education Ltd.", "support_website_url": null, "website_url": "http://www.immersivevreducation.com/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["EDUCATIONAL", "EXPLORATION", "SIMULATION", "SPACE_UNIVERSE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "en_US"], "supported_input_devices": ["TOUCHPAD", "GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "2741686095976519"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12138999_217477508837246_2422406682165379072_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VRpu50MnZ-oQ7kNvwGmBxAe&_nc_oc=AdrWmITsst4lDtVBZ47HXJnmIlVbaU7suaABZyW4BCD24puEY7IjvTAw-DvdMv5VAAk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0Y34IRs-tnXkdlZkG6N-Z41a4shQVT5Ua0K9EhgSWcIg&oe=69EE2359"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "d
ated_image.png", "id": "534263077228752", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/11162687_836456139869418_4437412463352217600_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0C3spwBwWKwQ7kNvwED7P_B&_nc_oc=Adrth8qg5E912ranxxF3D-7X1S2H9dlbFofpueU4VLPGkFO7zh4TNjBK04UMgZ0z580&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEKdnobOLtF8sEr8PqyJlXL2VW-puaSLcz6NL7NtWOjjw&oe=6A7B3438"}, {"file_name": "migrated_image.png", "id": "137456474369213", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/11162685_1040540019410849_6355035770977255424_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rzC48IzR5xQQ7kNvwFiTP8J&_nc_oc=AdoFBlnkslrV-6nDyqB1ll-_rE7S2LH2yf9P2rGxKgwArDohrMR_aeL2-DT1G2zmq1w&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFPVkS-3Fro1rK7U2x30X6Hy65I8n355jbNogsV6vZi2Q&oe=6A7B2429"}, {"file_name": "migrated_image.png", "id": "218765856034101", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/11162679_256561344831711_3743039293812113408_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KF07dhI3nXkQ7kNvwE-2a9M&_nc_oc=AdqaX8FMYxBumXvDfx4_jtjPFX1-RrrkD19__DrPayU3lY0T1Br9Nwq8M4yNcSWzLFk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHsUEt_j7cCMZ07gVbmYNNVsg3JiMYqT-Uww4nZMkyw4A&oe=6A7B2CD2"}, {"file_name": "migrated_image.png", "id": "234924897699435", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/11162706_1728905930751814_7028473375836078080_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wJl9RwkHQrEQ7kNvwFAaTm1&_nc_oc=Adq-o8pxJxL8A6PdQa-x8rVaUZiZltdAQ6A0iNVS3tdUQGTqzCIKiG21ndRolNc-gfY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGqLs15DfJrBotfO2ml0EzXd4P3jA8P91g3FkSakL7_Jg&oe=6A7B1D5D"}, {"file_name": "migrated_image.png", "id": "515145839183615", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/11162678_230384594120460_660784412161474560_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rNtZA6-KcEQQ7kNvwHZWw4e&_nc_oc=AdqMxM4UJ1eiKjWDpQccSVfKzqJPCVWQrwvY6_Q6ZV_sxwnoSIaaGLtL4igBpkDXX_k&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQExX8kSkz-bd3z0SnoNLAQMgBSfrKtOrJr__CBngyu2CQ&oe=6A7B33C8"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Apollo 11 VR Mobile", "keywords": ["Space", "Apollo11", "Moon", "Education", "Science"], "long_description": "Apollo 11 VR is the story of the greatest journey ever taken by humankind. \n\nNow for the first time ever, you get to experience this historic event through the eyes of those who lived through it. Using a mix of original archive audio and video together with accurate recreations of the spacecraft and locations, all set to inspirational music. Get set for an experience that will not only educate you but will also leave a lasting impression and deep respect for the men and women who worked on the Apollo program during NASA\u2019s golden era.\n\nApollo 11 VR is a new type of documentary, not only do you get to relive the events of 1969, you can also take control and fly the command module, land the lunar lander, explore the Moon's surface and deploy the lunar experiments all before returning to earth in a fiery re-entry.\n\nTake one small step today and climb aboard Apollo 11 for the journey of a lifetime.", "short_description": "Apollo 11 VR is the story of the greatest journey ever taken by humankind. This VR experience is a recreation of the events which took place between July 16th and July 24th 1969. Now for the first time ever you get to experience this historic event through the eyes of those who lived through it."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.immersivevreducation.com/", "developer_terms_of_service_url": "http://www.immersivevreducation.com/", "publisher_name": "Immersive VR Education Ltd.", "support_website_url": null, "website_url": "http://www.immersivevreducation.com/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_ta
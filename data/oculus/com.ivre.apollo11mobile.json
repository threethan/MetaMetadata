ated_image.png", "id": "534263077228752", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/11162687_836456139869418_4437412463352217600_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GfN-laT7slcQ7kNvwGt8Iqc&_nc_oc=AdppfKESxHW7ZAp_sS5qPAtSfb-6UjMLt_6JA0Jwy4445rXG3-nzQVRxDib70XIDg0E&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af278z5Z_jnWyyTbpCetTvWaxo3W8J6T6k6iOsH20GfAsw&oe=69EA2F38"}, {"file_name": "migrated_image.png", "id": "137456474369213", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/11162685_1040540019410849_6355035770977255424_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6RKKtkmt-xYQ7kNvwEBoftA&_nc_oc=Adpy8qrDIwZVLZ226wVCVaKX4afP2UxxJmIr0pEjcG0RCwBuUF_zCeM83nOzSOorD24&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3H43hvR7i5eyvyzaWB7ZQVj9zJLH4h4cTxnmzabeq1qw&oe=69EA1F29"}, {"file_name": "migrated_image.png", "id": "218765856034101", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/11162679_256561344831711_3743039293812113408_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BB7Lti_YQVAQ7kNvwHRiiO7&_nc_oc=AdrSN8TjfJfTeusK7f17Ec0Krbo8xs1H8yR0gM5UmXWKIP0FpvwAeHkJHJszRXvCJbw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af18pxR8MyEMxwXksT9piZkUNIfB3zy_iegHM9sfnPjp_w&oe=69EA27D2"}, {"file_name": "migrated_image.png", "id": "234924897699435", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/11162706_1728905930751814_7028473375836078080_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MTNVEL9jEoYQ7kNvwGpcFhF&_nc_oc=AdovTORCOl5V-WLxb-HE-DFqR6XSDL2UPJrKY1rodTjBTdO6TeNcIva0oqXDlpD7zZw&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1d1I9fnAf-viJx_VHPj-PndIyAdVEGfAmFS5VIvPE9CQ&oe=69EA185D"}, {"file_name": "migrated_image.png", "id": "515145839183615", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/11162678_230384594120460_660784412161474560_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yubFFzX7P7AQ7kNvwFziWD6&_nc_oc=Ado-cvTKA46lJB_82z8SFrklFu1jez_QkSqPR4NsRZQFGMJNnDDxQN2Qrytca6tc6mY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af25OwTQTtpOf8nk9OP6VXJzRQe_4XSwaQsTwTrurgc5CQ&oe=69EA2EC8"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Apollo 11 VR Mobile", "keywords": ["Space", "Apollo11", "Moon", "Education", "Science"], "long_description": "Apollo 11 VR is the story of the greatest journey ever taken by humankind. \n\nNow for the first time ever, you get to experience this historic event through the eyes of those who lived through it. Using a mix of original archive audio and video together with accurate recreations of the spacecraft and locations, all set to inspirational music. Get set for an experience that will not only educate you but will also leave a lasting impression and deep respect for the men and women who worked on the Apollo program during NASA\u2019s golden era.\n\nApollo 11 VR is a new type of documentary, not only do you get to relive the events of 1969, you can also take control and fly the command module, land the lunar lander, explore the Moon's surface and deploy the lunar experiments all before returning to earth in a fiery re-entry.\n\nTake one small step today and climb aboard Apollo 11 for the journey of a lifetime.", "short_description": "Apollo 11 VR is the story of the greatest journey ever taken by humankind. This VR experience is a recreation of the events which took place between July 16th and July 24th 1969. Now for the first time ever you get to experience this historic event through the eyes of those who lived through it."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.immersivevreducation.com/", "developer_terms_of_service_url": "http://www.immersivevreducation.com/", "publisher_name": "Immersive VR Education Ltd.", "support_website_url": null, "website_url": "http://www.immersivevreducation.com/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_ta
-4M1D&_nc_oc=Ado9u5mcH05gq9gTZ5-swza7xttwnWbkZgG5CdbNqj0hdDg7NITtCKRUI19fTw-fASs&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-mDHg2oMzTfS1l5s_3q6CLRHLJr2p36U2Xy7A9MRj2lA&oe=6A2C19C8"}, {"file_name": "migrated_image.png", "id": "155340308977776", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/11162706_1728905930751814_7028473375836078080_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nsVAmaEeVGsQ7kNvwF0XWBH&_nc_oc=AdrTGmYqWPbxgdPk9TYXMPYlozgwZSTNyk9dNYXaYI3IOoZpODG5tkXHg1Cx1_6Pb24&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8nid1jbgkW47IKCGu_QHWVGQtVT1hh0ksQpI0Di2b7EA&oe=6A2C035D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape.png", "id": "1203869659747783", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/12504788_1203869663081116_7405985754020577280_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EcB75tD04RAQ7kNvwHqtS8m&_nc_oc=AdqW1gqQA_jhGSokDkJBRVS3ppywrp8P_7Y4t6F5AVUnpJpaFNx3gDGqC7OPfvydIqA&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_PsyJnor_Y_-M8WOWGsVkTGCGfAYvrZOkTzvvGXBsOag&oe=6A2BFE57"}, "display_name": "Apollo 11 VR Mobile", "keywords": ["Space", "Apollo11", "Moon", "Education", "Science"], "long_description": "Apollo 11 VR is the story of the greatest journey ever taken by humankind. \n\nNow for the first time ever, you get to experience this historic event through the eyes of those who lived through it. Using a mix of original archive audio and video together with accurate recreations of the spacecraft and locations, all set to inspirational music. Get set for an experience that will not only educate you but will also leave a lasting impression and deep respect for the men and women who worked on the Apollo program during NASA\u2019s golden era.\n\nApollo 11 VR is a new type of documentary, not only do you get to relive the events of 1969, you can also take control and fly the command module, land the lunar lander, explore the Moon's surface and deploy the lunar experiments all before returning to earth in a fiery re-entry.\n\nTake one small step today and climb aboard Apollo 11 for the journey of a lifetime.", "short_description": "Apollo 11 VR is the story of the greatest journey ever taken by humankind. This VR experience is a recreation of the events which took place between July 16th and July 24th 1969. Now for the first time ever you get to experience this historic event through the eyes of those who lived through it."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.immersivevreducation.com/", "developer_terms_of_service_url": "http://www.immersivevreducation.com/", "publisher_name": "Immersive VR Education Ltd.", "support_website_url": null, "website_url": "http://www.immersivevreducation.com/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["EDUCATIONAL", "EXPLORATION", "SIMULATION", "SPACE_UNIVERSE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "en_US"], "supported_input_devices": ["TOUCHPAD", "GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "2741686095976519"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/12138999_217477508837246_2422406682165379072_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nCD_bfCzDPgQ7kNvwHh4iYE&_nc_oc=AdrXFPnmFN7Oa9CDIAm7cb7X2zc-eTKi4E7bLEGp6IaX0dHiHFjl5wWy2dsJuJHWe8Q&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8a72o9Q3m4gUFW1xTCJLXoVkwL-OWL6nsfNj1i2z1Vrw&oe=6A2C19D9"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "d
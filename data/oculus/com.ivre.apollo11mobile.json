ated_image.png", "id": "534263077228752", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/11162687_836456139869418_4437412463352217600_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-tVhoIDdmvQQ7kNvwGxujKG&_nc_oc=Adq4a8e9pTEV4uASRC-ZFF83_sPm9-uOLIHp2_-k-otlkO38wj7rnZtdY-6KZ2qhFh8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3Po7_RQnj2FHy2-4M0gUz20g9mOM8359no9S7xWIKcvg&oe=69F75E38"}, {"file_name": "migrated_image.png", "id": "137456474369213", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/11162685_1040540019410849_6355035770977255424_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0CvR0t8cApgQ7kNvwEl8KXj&_nc_oc=Adoz6IlQRsVEvjEYRxIApOLXsvmAl_P6vMjcR8Zum8Ynvx4rmMTrgm8dBSeaHV3x_Qs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0Wy2EThD8oPfJInp4gRkvx_p4JgswLPdfIi9XKfmci7g&oe=69F74E29"}, {"file_name": "migrated_image.png", "id": "218765856034101", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/11162679_256561344831711_3743039293812113408_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O1Htb_H4Gq4Q7kNvwExDzIH&_nc_oc=AdrUEKAa-bZChZo0evxC9TbLEL_zELWAvwj0xQqZZHna611m3dpYxFCC4cdI0Td9uKM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2EmMTgc33VHnGQKHtLjmRhwatCJn4QodEWT8DA4-LazA&oe=69F756D2"}, {"file_name": "migrated_image.png", "id": "234924897699435", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/11162706_1728905930751814_7028473375836078080_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2kkg_K3hbM0Q7kNvwH9ZouQ&_nc_oc=Adr8eZ_DIc-FSF_pJ4FniS4xrtvi2SpjEQBZtFn68RCCabT16yWCNHhN18OUFlciz4Q&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af052Z46VaPLTZPDspOqmNWY-VbFiv4pKh-_wGy7SLKmQA&oe=69F7475D"}, {"file_name": "migrated_image.png", "id": "515145839183615", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/11162678_230384594120460_660784412161474560_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LFmxnVN6A9gQ7kNvwHzT66K&_nc_oc=AdqcRGUpjkNxbiNx3qjllbrsTFmYM6AGqmZPSV7z4g6iC_IV2rIY4RO0oqD9SiK0McU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0TRurGGxNldKELfqURyEunPfF5N39YudbjHhchD5CEZg&oe=69F75DC8"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Apollo 11 VR Mobile", "keywords": ["Space", "Apollo11", "Moon", "Education", "Science"], "long_description": "Apollo 11 VR is the story of the greatest journey ever taken by humankind. \n\nNow for the first time ever, you get to experience this historic event through the eyes of those who lived through it. Using a mix of original archive audio and video together with accurate recreations of the spacecraft and locations, all set to inspirational music. Get set for an experience that will not only educate you but will also leave a lasting impression and deep respect for the men and women who worked on the Apollo program during NASA\u2019s golden era.\n\nApollo 11 VR is a new type of documentary, not only do you get to relive the events of 1969, you can also take control and fly the command module, land the lunar lander, explore the Moon's surface and deploy the lunar experiments all before returning to earth in a fiery re-entry.\n\nTake one small step today and climb aboard Apollo 11 for the journey of a lifetime.", "short_description": "Apollo 11 VR is the story of the greatest journey ever taken by humankind. This VR experience is a recreation of the events which took place between July 16th and July 24th 1969. Now for the first time ever you get to experience this historic event through the eyes of those who lived through it."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.immersivevreducation.com/", "developer_terms_of_service_url": "http://www.immersivevreducation.com/", "publisher_name": "Immersive VR Education Ltd.", "support_website_url": null, "website_url": "http://www.immersivevreducation.com/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_ta
ated_image.png", "id": "534263077228752", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/11162687_836456139869418_4437412463352217600_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Q3Sy3S8thwAQ7kNvwEXbLmp&_nc_oc=AdpyHOcw7TaQ7UedQaXPMOHBoiLI8GSld1YJ6PyQczWItSTakSyhiCrgQTqxZ1fyzmQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-YE6BG7pLeUI6NA3p_IBFrR5y773MchGPbYONNZ8ok6Q&oe=6A297738"}, {"file_name": "migrated_image.png", "id": "137456474369213", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/11162685_1040540019410849_6355035770977255424_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mYL94pUtY1wQ7kNvwHfNi0Q&_nc_oc=AdpEst63D3jZXLRjS-sDwAkWHRHBeWImWMZ0sArzZ8KdOPAqlMtBiZER7Cv2eNkDAnY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9uLCmTGKXPgNVfBxIbbCMGK3j3Xl0CR3M9XRsdGSha2g&oe=6A296729"}, {"file_name": "migrated_image.png", "id": "218765856034101", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/11162679_256561344831711_3743039293812113408_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jK3_ppGBam4Q7kNvwEiNjIE&_nc_oc=Adpz5MscF8iAVSS85vQE1bxvq0w7REMQsxHvIhr0IqAmj1lTqVUEh0VrxjrrxiyXl5Q&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9G5naZ16yO2-L0MLVskWUqXzJyqq3gdlYZEi8RydxQsg&oe=6A296FD2"}, {"file_name": "migrated_image.png", "id": "234924897699435", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/11162706_1728905930751814_7028473375836078080_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JGTuTKCjBb8Q7kNvwHbkFGo&_nc_oc=AdreluaLo3jethQ6KO-Q16xl_FEY_G_DlNOIpb-it2lDWKxLW47hO1CQl-XEIWa-Q-Q&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9olO6he8EgHitZUj7zOd8S8UuCCHkHhJHRwkCACQ8QyA&oe=6A29605D"}, {"file_name": "migrated_image.png", "id": "515145839183615", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/11162678_230384594120460_660784412161474560_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=trChyFRSlY8Q7kNvwEswc9r&_nc_oc=AdoqtBjuuiw1EzDtW12m6NmrpCkkOkDhrh1CTfYvA9r3lNyMwP76I7XnIjLO55A5tQw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_glexCX98Qo2WenSa5UEcHFm39SCw2t7qKhiwLJZperg&oe=6A2976C8"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Apollo 11 VR Mobile", "keywords": ["Space", "Apollo11", "Moon", "Education", "Science"], "long_description": "Apollo 11 VR is the story of the greatest journey ever taken by humankind. \n\nNow for the first time ever, you get to experience this historic event through the eyes of those who lived through it. Using a mix of original archive audio and video together with accurate recreations of the spacecraft and locations, all set to inspirational music. Get set for an experience that will not only educate you but will also leave a lasting impression and deep respect for the men and women who worked on the Apollo program during NASA\u2019s golden era.\n\nApollo 11 VR is a new type of documentary, not only do you get to relive the events of 1969, you can also take control and fly the command module, land the lunar lander, explore the Moon's surface and deploy the lunar experiments all before returning to earth in a fiery re-entry.\n\nTake one small step today and climb aboard Apollo 11 for the journey of a lifetime.", "short_description": "Apollo 11 VR is the story of the greatest journey ever taken by humankind. This VR experience is a recreation of the events which took place between July 16th and July 24th 1969. Now for the first time ever you get to experience this historic event through the eyes of those who lived through it."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.immersivevreducation.com/", "developer_terms_of_service_url": "http://www.immersivevreducation.com/", "publisher_name": "Immersive VR Education Ltd.", "support_website_url": null, "website_url": "http://www.immersivevreducation.com/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_ta
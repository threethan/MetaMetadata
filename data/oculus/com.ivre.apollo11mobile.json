ated_image.png", "id": "534263077228752", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/11162687_836456139869418_4437412463352217600_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RBum5TlR10sQ7kNvwG4RFIb&_nc_oc=AdqN8vlQtTUoCpHeq1KExB-4oHdsGsvDu8Pm58IzsETrycNnEvQ8lVpdw977veS2_T0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF4Nse31Bsu0_pzT8-ZRNlZOCN2Bkn9tscsg-JeXJZCAQ&oe=6A75EE38"}, {"file_name": "migrated_image.png", "id": "137456474369213", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/11162685_1040540019410849_6355035770977255424_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hZbkimPZbuEQ7kNvwHidyT3&_nc_oc=Adqwmkc7HcALhlp3ffL18QKEqRwmU6SH37ToqMP1Es3IMQuGeAmhCCYaUTyDsvaUsX8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHZ3pKbkN1BBFvHbirOL6IEftvowZqoeQRY7Aw9DSDXzA&oe=6A75DE29"}, {"file_name": "migrated_image.png", "id": "218765856034101", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/11162679_256561344831711_3743039293812113408_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ymYssb_fwvUQ7kNvwHXdbWA&_nc_oc=Adqi-h9qm99rZB-tmK9O7GmdS4Z41ah9eXkl7HG4qaz_bJaa9jWc_WRe-yELAIhKVIk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFUemVx0DLVMIBQAPHQIsq9hfvNyWGjbU8PaDZx_5j_BQ&oe=6A75E6D2"}, {"file_name": "migrated_image.png", "id": "234924897699435", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/11162706_1728905930751814_7028473375836078080_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oubFpxjSHfMQ7kNvwEKFP9p&_nc_oc=AdrTD-3TcSRBLIeCdfveCFZ3sZ6g32GCTv5oZtbzQqbadLpnawxNQlNN0v5CwwyPqoQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGblBXQ-mK0Xshb90OGxOVmUM3m4pcVhohVH2nmxZJfNA&oe=6A75D75D"}, {"file_name": "migrated_image.png", "id": "515145839183615", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/11162678_230384594120460_660784412161474560_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jjPCXfjdD2gQ7kNvwEGkwDA&_nc_oc=AdrGj3QEeMQnzyzZdnREEUlPWxkH2BFEIW0NzSl0BCbEJUGPfbcZ--M8FedxgmezAdI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHfNoPaIJVfN1dgNvjb8OfO8SigZQLKTocRjZG9Dn8IYg&oe=6A75EDC8"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Apollo 11 VR Mobile", "keywords": ["Space", "Apollo11", "Moon", "Education", "Science"], "long_description": "Apollo 11 VR is the story of the greatest journey ever taken by humankind. \n\nNow for the first time ever, you get to experience this historic event through the eyes of those who lived through it. Using a mix of original archive audio and video together with accurate recreations of the spacecraft and locations, all set to inspirational music. Get set for an experience that will not only educate you but will also leave a lasting impression and deep respect for the men and women who worked on the Apollo program during NASA\u2019s golden era.\n\nApollo 11 VR is a new type of documentary, not only do you get to relive the events of 1969, you can also take control and fly the command module, land the lunar lander, explore the Moon's surface and deploy the lunar experiments all before returning to earth in a fiery re-entry.\n\nTake one small step today and climb aboard Apollo 11 for the journey of a lifetime.", "short_description": "Apollo 11 VR is the story of the greatest journey ever taken by humankind. This VR experience is a recreation of the events which took place between July 16th and July 24th 1969. Now for the first time ever you get to experience this historic event through the eyes of those who lived through it."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.immersivevreducation.com/", "developer_terms_of_service_url": "http://www.immersivevreducation.com/", "publisher_name": "Immersive VR Education Ltd.", "support_website_url": null, "website_url": "http://www.immersivevreducation.com/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_ta
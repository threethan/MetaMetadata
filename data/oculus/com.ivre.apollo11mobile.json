ated_image.png", "id": "534263077228752", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/11162687_836456139869418_4437412463352217600_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TXbAos0Y3F4Q7kNvwGbDAzZ&_nc_oc=Adr4x9-hn0xPsG1UuNXUwd9hfbaiV9KOTHrVNYmfZfEsPBf1MDyNE5GjqfEMAKATKG4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6ZyFDBCTcoq_9OkY99GXy51K3m7Bgp9paHmZDcaAyyYg&oe=6A0881B8"}, {"file_name": "migrated_image.png", "id": "137456474369213", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/11162685_1040540019410849_6355035770977255424_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1CPBt1AJ77MQ7kNvwE1oJq7&_nc_oc=Adq87VGtHNr-MYJptnfJRw_g03UrggslVywshakkEf4_dWwxy_LV8F5r89nboSTQPQI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4Hob89vOSJF9-aaNRA-0Zpp768RWaiinYVg6ZKcTpqXA&oe=6A0871A9"}, {"file_name": "migrated_image.png", "id": "218765856034101", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/11162679_256561344831711_3743039293812113408_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DcxAErUazpQQ7kNvwGjnER9&_nc_oc=AdqEv_mri6qR3HA2_XCMEGoP0rsGaHIuDbhWzN_EA4OxZDwaA4Doblau5Ig8iO4wow0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6hbZvA3Dba48wkKOQts0TyTrpaStk_bb8h1E9xDTScOQ&oe=6A087A52"}, {"file_name": "migrated_image.png", "id": "234924897699435", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/11162706_1728905930751814_7028473375836078080_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hlnANqW2T7cQ7kNvwHOWujQ&_nc_oc=AdpR27AeqMWZiA6Epla0YsqEX3zt7kEcckOeBiwSAluIootpOXn4lQ1iKuxb0ngOhio&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5KiYxrY2uZyN-H5q1zR6goYrfqnDQ_8U7S1t9UIQZWZQ&oe=6A086ADD"}, {"file_name": "migrated_image.png", "id": "515145839183615", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/11162678_230384594120460_660784412161474560_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_mKrJimEcVUQ7kNvwEfHjnv&_nc_oc=Adp1SfdsczVSC3zlgW0vPEChz3w602d7uWEUn7JX6gM2MZ0MweBeuEQRTRjqJ7XiD4k&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af71xwzhp2-9o4jkXMOwETv53w7H948X_RJ_vSb0fbRTqQ&oe=6A088148"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Apollo 11 VR Mobile", "keywords": ["Space", "Apollo11", "Moon", "Education", "Science"], "long_description": "Apollo 11 VR is the story of the greatest journey ever taken by humankind. \n\nNow for the first time ever, you get to experience this historic event through the eyes of those who lived through it. Using a mix of original archive audio and video together with accurate recreations of the spacecraft and locations, all set to inspirational music. Get set for an experience that will not only educate you but will also leave a lasting impression and deep respect for the men and women who worked on the Apollo program during NASA\u2019s golden era.\n\nApollo 11 VR is a new type of documentary, not only do you get to relive the events of 1969, you can also take control and fly the command module, land the lunar lander, explore the Moon's surface and deploy the lunar experiments all before returning to earth in a fiery re-entry.\n\nTake one small step today and climb aboard Apollo 11 for the journey of a lifetime.", "short_description": "Apollo 11 VR is the story of the greatest journey ever taken by humankind. This VR experience is a recreation of the events which took place between July 16th and July 24th 1969. Now for the first time ever you get to experience this historic event through the eyes of those who lived through it."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.immersivevreducation.com/", "developer_terms_of_service_url": "http://www.immersivevreducation.com/", "publisher_name": "Immersive VR Education Ltd.", "support_website_url": null, "website_url": "http://www.immersivevreducation.com/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_ta
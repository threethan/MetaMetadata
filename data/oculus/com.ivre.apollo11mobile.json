ated_image.png", "id": "534263077228752", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/11162687_836456139869418_4437412463352217600_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mmlDtIUxMtQQ7kNvwGTVbSG&_nc_oc=Adr6ABciYBZoGtr3oRZc_6W9MJ2fYWFl4MYC05RS3QyOeq-xxPT6zFdi1ko9whbgFZE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLDnZQ3ihlremP2o1q4zoiVv8AQoc2QMDmQBykWT6BjdA&oe=6AB53638"}, {"file_name": "migrated_image.png", "id": "137456474369213", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/11162685_1040540019410849_6355035770977255424_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RYidCbKZKNkQ7kNvwEMM-IC&_nc_oc=AdrWtbSixnDV4TPVNvryeoQ1UuaBvy153XCwgMYKubTeYqTSFiqTeesciUsTsvUKQKg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ_FkXVgAdL55IEHmy05BHneNtTh8YpmdDc5XX3CtyIzQ&oe=6AB52629"}, {"file_name": "migrated_image.png", "id": "218765856034101", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/11162679_256561344831711_3743039293812113408_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-1aw32kVHuEQ7kNvwFbgxG9&_nc_oc=Adoi_nCCNpEgQEqYsaGxlFSUjIWYb6MTCj6eDv70oRaI9WTc9esOj4l3JSEznhlzQBU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJzMR0DNDvjfbzB_ZjJ74wSN6BiFpOFPog0URvKREniXg&oe=6AB52ED2"}, {"file_name": "migrated_image.png", "id": "234924897699435", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/11162706_1728905930751814_7028473375836078080_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a1kvFF1IBnsQ7kNvwEMRJ45&_nc_oc=AdpDiuEwOf0pppm1R-s4xZnOnpoJGWET3rVqcglFkZb447Q-ChGONkaUe5L8-dgObs4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL7GHSrY85iAkxmRhM63aaK4XcW6UcIBya5y27pIAEIgg&oe=6AB51F5D"}, {"file_name": "migrated_image.png", "id": "515145839183615", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/11162678_230384594120460_660784412161474560_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TB6ECwNkPJ8Q7kNvwFPr_-1&_nc_oc=Ado-L2sSXyv6vgoTyuCwC1_HcOefDaDfPQGZONIukIMfIOUlsKV7UI0gDTDjWmJrKEw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKBnt1pIS1UOkwrp_M4lKx4YfB7Paio74lkhukQEFbclg&oe=6AB535C8"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Apollo 11 VR Mobile", "keywords": ["Space", "Apollo11", "Moon", "Education", "Science"], "long_description": "Apollo 11 VR is the story of the greatest journey ever taken by humankind. \n\nNow for the first time ever, you get to experience this historic event through the eyes of those who lived through it. Using a mix of original archive audio and video together with accurate recreations of the spacecraft and locations, all set to inspirational music. Get set for an experience that will not only educate you but will also leave a lasting impression and deep respect for the men and women who worked on the Apollo program during NASA\u2019s golden era.\n\nApollo 11 VR is a new type of documentary, not only do you get to relive the events of 1969, you can also take control and fly the command module, land the lunar lander, explore the Moon's surface and deploy the lunar experiments all before returning to earth in a fiery re-entry.\n\nTake one small step today and climb aboard Apollo 11 for the journey of a lifetime.", "short_description": "Apollo 11 VR is the story of the greatest journey ever taken by humankind. This VR experience is a recreation of the events which took place between July 16th and July 24th 1969. Now for the first time ever you get to experience this historic event through the eyes of those who lived through it."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.immersivevreducation.com/", "developer_terms_of_service_url": "http://www.immersivevreducation.com/", "publisher_name": "Immersive VR Education Ltd.", "support_website_url": null, "website_url": "http://www.immersivevreducation.com/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_ta
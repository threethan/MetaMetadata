BFE3FC"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Immersive Australia", "keywords": [], "long_description": "Immerse yourself in stunning remote landscapes from all around the vast and varied continent of Australia. These dynamic-still photographic experiences are all shot on location, bringing the technical and aesthetic qualities of landscape photography to the emerging VR medium. Immersive Australia is a digital gallery of immersive 360\u00ba landscape photography, and is the first production from Immersive Vision. We look to create aesthetic wellness experiences within the VR space, and expand the creative horizons of this emerging digital space.", "short_description": "Immerse yourself in stunning remote landscapes from all around the vast and varied continent of Australia. These dynamic-still photographic experiences are all shot on location, bringing the technical and aesthetic qualities of landscape photography to the emerging VR medium. Immersive Australia is a digital gallery of immersive 360\u00ba landscape photography."}]}, "developer_name": null, "developer_privacy_policy_url": "https://immersivevision.com.au/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Immersive Vision", "support_website_url": null, "website_url": "https://www.immersivevision.com.au/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["TRAVEL", "RELAXATION_MEDITATION", "EXPERIENCE_360_NON_GAME"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "80079173
1-7&_nc_sid=6e7a0a&_nc_ohc=Pju-q9lkEAAQ7kNvwHr_MjQ&_nc_oc=AdrjbFktTA1BWRt0goKV9PazoiGc44iivny9PCdd82A2TE1QtnXF3caI4OIpDVduY44&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKabVhsD7wa2DlBoo0S2L0756U_BWeIGFVuQks5rwrqIg&oe=6AAA99EF"}, {"file_name": "VICMtBuffaloSnow.png", "id": "247751605086935", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39003279_247751608420268_7335383843728499632_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qG47pcWAcIoQ7kNvwHyPG2D&_nc_oc=Adoo7a1iMYnW-b6u1lrYDC6iZWSuRkBSKiZ8VALvj8Qm9YMEuVt4CJ6cd0Y_Ov8nZYU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKlHWys_a0STNPwLC6Eipe5Hy465KBZzY_ftfGUBLBwWQ&oe=6AAA9F07"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Immersive  Australia", "keywords": ["Panorama", "Photography", "Wellness", "Nature", "Landscape"], "long_description": "Immerse yourself in stunning remote landscapes from all around the vast and varied continent of Australia.\n\nThese dynamic-still photographic experiences are all shot on location, bringing the technical and aesthetic qualities of landscape photography to the emerging VR medium. Immersive Australia is a digital gallery of immersive 360\u00ba landscape photography, and is the first production from Immersive Vision. We look to create aesthetic wellness experiences within the VR space, and expand the creative horizons of this emerging digital space.\n\nWe respectfully acknowledge the Traditional Custodians of the lands and waters represented in this VR experience. \n\nImmersive Vision is deeply grateful to the Indigenous people and communities who have generously shared their knowledge and perspectives with us, and supported our engagement with Country with great warmth and respect. We will always value those connections and seek to honour them through my creative work.\n\nWe are rapt to be able to give back by supporting the Indigenous Literacy Foundation in Australia, a group who work tirelessly to provide books in language to young Indigenous children all around Australia, as well as invaluable access to digital resources and knowledge, truly bridging a gap in Australian equity and inclusion.", "short_description": "Immerse yourself in stunning remote landscapes from all around the vast and varied continent of Australia.\n\nThese dynamic-still photographic experiences are all shot on location, bringing the technical and aesthetic qualities of landscape photography to the emerging VR medium.\n\nImmersive Australia is a digital gallery of immersive 360\u00ba panoramic landscape photography."}]}, "developer_name": null, "developer_privacy_policy_url": "https://immersivevision.com.au/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Immersive Vision", "support_website_url": null, "website_url": "https://www.immersivevision.com.au/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["TRAVEL", "RELAXATION_MEDITATION", "EXPERIENCE_360_NON_GAME"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "28805486802391429"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499628893_2024712861496101_5515505485327917485_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_WPrPa4S7F4Q7kNvwGKX5QP&_nc_oc=AdoZP7Jj-xfkgzYEnggvHSHiboTeAY1Dv-wi3-9U1LuMcJhKUxr2gUR6gDsCi9B4R24&_nc_zt=3&_nc_ht=scontent-ord5-1.oc
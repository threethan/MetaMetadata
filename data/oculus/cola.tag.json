129367013931491_5946747140075850677_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Oeo0NVCE1eMQ7kNvwEuokum&_nc_oc=AdpWFpODqCkL9XaDOWZgDoo9EfBhKbwdcF0xBemYApFSXEUQeR7yh8Rq7B0Q_wfzEcs&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEZJ4oSHeYAmXjRtDnmzqlfcjCUZNDJD527yZvJbwsnRw&oe=6A901A75"}, {"file_name": "resized_2560x1440.png", "id": "1475169827628557", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499307962_1475169830961890_1428402669126449693_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JtfVWkuRvM8Q7kNvwEXDlYi&_nc_oc=AdolmR1LGKNQbSKDbxRwe2oe1ig2jAbYwTRsRCFMTP0mLlfs2yi8zAGlcmY2VX2eWgc&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFGoM9FPhBnt8pZ9mTjK6WgaIkzWySIzIR_CGHO0W82Nw&oe=6A9010CE"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Cola tag", "keywords": [], "long_description": "Welcome to a VR adventure where movement is everything. Using Gorilla Locomotion, you can swing, climb, jump, and explore a world full of unique locations, secrets, and challenges. Every area is designed to reward exploration and help you master your movement as you become faster and more skilled.\n\nCollect and unlock a variety of cosmetics to customize your gorilla and create your own style. As you continue exploring, you'll find new places to visit and more content to enjoy with each update.\n\nHorror Mode is coming soon and will introduce a darker experience with new environments, mysterious locations, eerie sounds, and exciting gameplay designed to test your skills. Whether you're exploring during the day or entering the horror experience, there will always be something new to discover.\n\nThe game is actively being updated with new maps, cosmetics, features, quality improvements, and future content. More surprises are planned, so keep playing and check back for every new update as the adventure continues to grow.", "short_description": "Swing, climb, and jump through immersive VR worlds using realistic gorilla locomotion. Move with your own arms, and master your movement skills in a fun and exciting adventure. Enjoy smooth controls, challenging environments, and regular updates with new horror mod coming soon!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/privacy-cola/accueil", "developer_terms_of_service_url": null, "publisher_name": "tmr_Fangame", "support_website_url": null, "website_url": "https://sites.google.com/view/cola-tagg/accueil", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "CO_OP"], "id": "1189913680880847"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499304952_2106022700349599_9218633139292784668_n.png?stp=dst-png_s360x360&_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=btuPGs1eG14Q7kNvwEAaxvU&_nc_oc=Adq1g8zuLgU5KuEQzEVpdwzyxE1W7lQommlldO3XBqQ_uxphO5JrjHF3MJid79L0A4k&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFCL-JvgT-PyGFSbVVJjEhfQLjr9ViqyEvrMFrkiJaGfw&oe=6A902497"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Cola tag", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Action", "id": "459781504968480"}, {"topic_name": "Platformer", "id": "5281423164
 "id": "515096889445555", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/11162732_149939562452281_1446937803001692160_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rYD_LeoPPDIQ7kNvwEuF7Oe&_nc_oc=AdkmflyHJ5bljdBbbXaHmJsI3069wBnPSSSPNmJKYuPHMP35BqXU1qIz8ErnVtfN7m4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AftC9BVdgi1vDLBvCci5Sdr9JoCkgEYZxFvj1S-EHwb75A&oe=69999929"}, {"file_name": "migrated_image.png", "id": "250946772739126", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/12427594_408189026287243_5425781852315058176_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rzN7NxxWdJUQ7kNvwHLaI0T&_nc_oc=AdlubP0MrshV3TLEoO9U4Obve90OvbrWv05O3luiRUPoRtAros_L_7E67bxcDaqVXZ0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Aftrfcv4hX6oDnEb-OoAWCw0Fm2n2wmBiaXzr-dgQ2q7bA&oe=6999934C"}, {"file_name": "migrated_image.png", "id": "489840865227550", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/12410493_172626436801262_6061190936266801152_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XyRrNEpjRd8Q7kNvwGSc7vb&_nc_oc=Adk9oxRxTE__bl5ov7lwWKnrkbJ4xvDaPAMVJNdiFoPn7tUdp1-Rnh_pk0Q4BlG3xy4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfuuqXidzefp5Zx1cFZ2kwskBEqRzqz5AeKrErx2s44wpg&oe=6999B173"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "The Hopping Dead (English Version)", "keywords": ["Zombie", "Chinese", "Ghost", "Spell", "Sword"], "long_description": "Eastern ghost and zombies aren't afraid of guns and fire, the great Wizards shall use their own magical spells and exorcism swords to exorcise demons. For all of you who were used to only guns as weapons, we offer you a brand-new adventure in killing zombies with Eastern magic!\n\n- We offer the liveliness and smoothness of arcade games, it will be a forthright adventure.\n\n- Our game is not only about killing, there are also different challenges that need to be solved in special and quick-witted ways.\n\n- Different from attacking with guns and fire, we attack Zombies with unique Eastern spells.\n\n- The haunted atmosphere and set will definitely give you thrills!", "short_description": "ICE Production introduces you <<The Hopping Dead >>, an action and horror Gear VR game with Eastern style, bringing you into the Eastern haunted world!\nYou will become a Wizard Exorcist from the East in the game, and fight against demons and zombies with your partner \"Dumby\"!"}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.ideproduction.com/vr-ar", "developer_terms_of_service_url": "http://www.ideproduction.com/vr-ar", "publisher_name": "ICE Production co., Ltd", "support_website_url": null, "website_url": "http://www.ideproduction.com/vr-ar", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "HORROR", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "231409855754267"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/11162769_512995992418545_3753370253527089152_n.png?stp=dst-png_s360x360&_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=X4u9vmbId7UQ7kNvwHCUPpq&_nc_oc=AdkuK5zXzywIZ7NSZekGyY0SpetwTdeahj3nWvoA2QjHnu8U37QCSWfxJ12B2Nd1zuY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfuvStVai4ARqtzJabc1PinqhaboR2pvWJuvJw1tPXXAFQ&oe=6999B4FB"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "The Hopping Dead (English Version)", "platform": "ANDROID", "context_category": null, "context_topics": [], "release_date": 151681324
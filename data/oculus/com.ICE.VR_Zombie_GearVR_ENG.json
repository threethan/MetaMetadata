 "id": "515096889445555", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/11162732_149939562452281_1446937803001692160_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Cuu_cFpWM3UQ7kNvwG62YlK&_nc_oc=AdmuWyvTGjXIn2t5gWKbIZdFpMVhWNzUL7lP4W6e-7Ea9RP505XNIUhbcrPdXep5B0Y&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfslXtxIKSdt8bkue1msLAXzEn77nu2MoCiHERyGx9a_bg&oe=69A030A9"}, {"file_name": "migrated_image.png", "id": "250946772739126", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/12427594_408189026287243_5425781852315058176_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JRInkjCh1y8Q7kNvwFWKSx3&_nc_oc=AdmW5Y5iUdQ1N-BdgkIEpGMbedqKoo8Tirvxuj0Fg7mdF1HjIKl_-TIqXvcrdrmgOJk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfvjR0ZaJuaVCfHpe27Jao-ap2CrrYgIzG84QpyNC-qFxw&oe=69A02ACC"}, {"file_name": "migrated_image.png", "id": "489840865227550", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/12410493_172626436801262_6061190936266801152_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rAhKP5H94ZEQ7kNvwGmcF4P&_nc_oc=AdnQKAmo5UjhRvAEIcNMZ1ors17tUun9SR5agV3fSMSuvumiTG8rgFXO-2MiqxKWkco&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfuTF1-sgr5UIfYn-PJrXQ5Qz6r6znbwdsFo4awKUSrE7g&oe=69A048F3"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "The Hopping Dead (English Version)", "keywords": ["Zombie", "Chinese", "Ghost", "Spell", "Sword"], "long_description": "Eastern ghost and zombies aren't afraid of guns and fire, the great Wizards shall use their own magical spells and exorcism swords to exorcise demons. For all of you who were used to only guns as weapons, we offer you a brand-new adventure in killing zombies with Eastern magic!\n\n- We offer the liveliness and smoothness of arcade games, it will be a forthright adventure.\n\n- Our game is not only about killing, there are also different challenges that need to be solved in special and quick-witted ways.\n\n- Different from attacking with guns and fire, we attack Zombies with unique Eastern spells.\n\n- The haunted atmosphere and set will definitely give you thrills!", "short_description": "ICE Production introduces you <<The Hopping Dead >>, an action and horror Gear VR game with Eastern style, bringing you into the Eastern haunted world!\nYou will become a Wizard Exorcist from the East in the game, and fight against demons and zombies with your partner \"Dumby\"!"}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.ideproduction.com/vr-ar", "developer_terms_of_service_url": "http://www.ideproduction.com/vr-ar", "publisher_name": "ICE Production co., Ltd", "support_website_url": null, "website_url": "http://www.ideproduction.com/vr-ar", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "HORROR", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "231409855754267"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/11162769_512995992418545_3753370253527089152_n.png?stp=dst-png_s360x360&_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Senu4gxgfV8Q7kNvwFus9GN&_nc_oc=Adn2DMXhuLz9bR3X77LKujMSoNHRXhVqLMMkw3P6llgVfdoPwTmIoAdcfArv5X7wPvM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfvXyZoEuAgXw_WND2OlalPbqFcF0vPfuCSSdt1M2Qr_KA&oe=69A04C7B"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "The Hopping Dead (English Version)", "platform": "ANDROID", "context_category": null, "context_topics": [], "release_date": 151681324
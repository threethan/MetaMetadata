 "id": "515096889445555", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/11162732_149939562452281_1446937803001692160_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Cuu_cFpWM3UQ7kNvwHZspWT&_nc_oc=AdkdX_b-_f4QEAkpvSDnCLf7VGJtwoBTnLeH96XAPtBbYPDacKeuPOE6XTr0bfnXfSs&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&oh=00_Aftpjx84fsGESFFk4KwllTHtSYgeCEjGHjTaXlxzW08BKA&oe=69A18229"}, {"file_name": "migrated_image.png", "id": "250946772739126", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/12427594_408189026287243_5425781852315058176_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wbh5ooX4VuMQ7kNvwGc_ObC&_nc_oc=Adl4_HmkatqAQzvnd2Oxcu9pZ3_mix4ab3mwYoE1L2LsW2tL6kbUa_78sJjd5xBEWrA&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&oh=00_AftSNWToXZoBq2ahw7So1NksjONneOSXTyExZpvjWG7EmA&oe=69A17C4C"}, {"file_name": "migrated_image.png", "id": "489840865227550", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/12410493_172626436801262_6061190936266801152_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Wx3KET0yzeAQ7kNvwFa2rEp&_nc_oc=AdnpskKHOYvKCIqyu-5exnPcVNDBVuYy7VbdgzOJj8DFc8XOB7xCbKA28joqYkbUqjs&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&oh=00_AfsCKlw2qqPM_Gk0wzD2nioqzSOf0Q1n5tS3DTfW8Wi7Kw&oe=69A19A73"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "The Hopping Dead (English Version)", "keywords": ["Zombie", "Chinese", "Ghost", "Spell", "Sword"], "long_description": "Eastern ghost and zombies aren't afraid of guns and fire, the great Wizards shall use their own magical spells and exorcism swords to exorcise demons. For all of you who were used to only guns as weapons, we offer you a brand-new adventure in killing zombies with Eastern magic!\n\n- We offer the liveliness and smoothness of arcade games, it will be a forthright adventure.\n\n- Our game is not only about killing, there are also different challenges that need to be solved in special and quick-witted ways.\n\n- Different from attacking with guns and fire, we attack Zombies with unique Eastern spells.\n\n- The haunted atmosphere and set will definitely give you thrills!", "short_description": "ICE Production introduces you <<The Hopping Dead >>, an action and horror Gear VR game with Eastern style, bringing you into the Eastern haunted world!\nYou will become a Wizard Exorcist from the East in the game, and fight against demons and zombies with your partner \"Dumby\"!"}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.ideproduction.com/vr-ar", "developer_terms_of_service_url": "http://www.ideproduction.com/vr-ar", "publisher_name": "ICE Production co., Ltd", "support_website_url": null, "website_url": "http://www.ideproduction.com/vr-ar", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "HORROR", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "231409855754267"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/11162769_512995992418545_3753370253527089152_n.png?stp=dst-png_s360x360&_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0IoI8LF61UwQ7kNvwG8LhIS&_nc_oc=AdnDp_ypvmE3Y_1NzneA0WiajtQaWZFtd9lHJnC6jJi_btLtb0eYC3wjelSbzz-NgWE&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&oh=00_AfsQ8ebn5_lvaFslDotfS40yYH8TA3qruObDeBA0UKQDKQ&oe=69A19DFB"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "The Hopping Dead (English Version)", "platform": "ANDROID", "context_category": null, "context_topics": [], "release_date": 151681324
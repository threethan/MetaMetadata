_c91lID8QQ7kNvwGXXbS7&_nc_oc=AdrP3B7wW2jXPx0t0kp8Pq7XTw2YE9EnwRuUFfdd6I-k-pFnJaHLcIfBHf-m4kB6ITw&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-uvbTssYisEVMsK8hTFMjSEbDAQdCzTxjt8FOMRXUihg&oe=6A32B98C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "11162707_121977648426018_56455927766712320_n.png", "id": "426025734481929", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/12138787_426025737815262_8408755498312007680_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GC-LMVoVNGcQ7kNvwEyQ14m&_nc_oc=AdqROkW1o2o9Mq4RKvPaT81JKRo5WrfPs_PGvKPBjeObCQlVyt5g7q955pJQg_rTPj0&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8d4DuF6WY1pgk5hbjfnFHzFKqs4-3jAjRyqtzYVg2bFw&oe=6A32C2EA"}, "display_name": "The Hopping Dead (English Version)", "keywords": ["Zombie", "Chinese", "Ghost", "Spell", "Sword"], "long_description": "Eastern ghost and zombies aren't afraid of guns and fire, the great Wizards shall use their own magical spells and exorcism swords to exorcise demons. For all of you who were used to only guns as weapons, we offer you a brand-new adventure in killing zombies with Eastern magic!\n\n- We offer the liveliness and smoothness of arcade games, it will be a forthright adventure.\n\n- Our game is not only about killing, there are also different challenges that need to be solved in special and quick-witted ways.\n\n- Different from attacking with guns and fire, we attack Zombies with unique Eastern spells.\n\n- The haunted atmosphere and set will definitely give you thrills!", "short_description": "ICE Production introduces you <<The Hopping Dead >>, an action and horror Gear VR game with Eastern style, bringing you into the Eastern haunted world!\nYou will become a Wizard Exorcist from the East in the game, and fight against demons and zombies with your partner \"Dumby\"!"}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.ideproduction.com/vr-ar", "developer_terms_of_service_url": "http
.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEU6SxgE9XWe7HSkga-RuIVTxUz51KCod4ICuASqXGcKw&oe=6A85AD08"}, {"file_name": "migrated_image.png", "id": "515096889445555", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/11162732_149939562452281_1446937803001692160_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8I-MrySZAnQQ7kNvwFLjU7H&_nc_oc=AdrXPyvvsEs1JoRtHe3KoFj4UAhTYDLTMdA3Khjv9o2qHBgcV5AMBfhe0DM7EbX8GJc&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHzJc-E2OC-2er8i1gVdPVOn5XxZMkBxtro7EcZ6CADBQ&oe=6A8595A9"}, {"file_name": "migrated_image.png", "id": "250946772739126", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/12427594_408189026287243_5425781852315058176_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LmktmwYXEUwQ7kNvwGtJ0xZ&_nc_oc=Adq0xDu8yn3ZWdY9PBgJO3tcW3mpBs4jPB83p-0Tpx6NCSYDCIEKPwwpwofpLt7KzOM&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEJZILUv-ZS7VfPsyTTub0BHC38VR1Qy8YO_aoFgbTA2A&oe=6A858FCC"}, {"file_name": "migrated_image.png", "id": "489840865227550", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/12410493_172626436801262_6061190936266801152_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UHIPa6yblrMQ7kNvwHjLXYP&_nc_oc=AdrMf104knudfqL8N5yyBGlivuA1eNQJTaNUtkHVEME-HO68kPS49k0m9rpdhhwPylo&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH9_FBq0GufBtfbN4xToTjZlSCf6AB2pXAhE69TGZJKlw&oe=6A85ADF3"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "The Hopping Dead (English Version)", "keywords": ["Zombie", "Chinese", "Ghost", "Spell", "Sword"], "long_description": "Eastern ghost and zombies aren't afraid of guns and fire, the great Wizards shall use their own magical spells and exorcism swords to exorcise demons. For all of you who were used to only guns as weapons, we offer you a brand-new adventure in killing zombies with Eastern magic!\n\n- We offer the liveliness and smoothness of arcade games, it will be a forthright adventure.\n\n- Our game is not only about killing, there are also different challenges that need to be solved in special and quick-witted ways.\n\n- Different from attacking with guns and fire, we attack Zombies with unique Eastern spells.\n\n- The haunted atmosphere and set will definitely give you thrills!", "short_description": "ICE Production introduces you <<The Hopping Dead >>, an action and horror Gear VR game with Eastern style, bringing you into the Eastern haunted world!\nYou will become a Wizard Exorcist from the East in the game, and fight against demons and zombies with your partner \"Dumby\"!"}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.ideproduction.com/vr-ar", "developer_terms_of_service_url": "http://www.ideproduction.com/vr-ar", "publisher_name": "ICE Production co., Ltd", "support_website_url": null, "website_url": "http://www.ideproduction.com/vr-ar", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "HORROR", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "231409855754267"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/11162769_512995992418545_3753370253527089152_n.png?stp=dst-png_s360x360&_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KkT0T5IHhJYQ7kNvwFkFzDN&_nc_oc=Adodw3xC9aA5fkXoTQsa_B0gIAkLptKeSDX37kH8GI3W59aRfuGV46zViLFo9C4LR_E&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGO2PN6S1eSA9Po6YN3XGw31UIkWwh8bT9xWhzcBnB4IQ&oe=6A85793B"}, "is_concept": false, "is_test": f
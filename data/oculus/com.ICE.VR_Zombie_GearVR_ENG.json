1-7&_nc_sid=6e7a0a&_nc_ohc=5cD2lhH_bLcQ7kNvwGYkcWq&_nc_oc=AdowXgtMoCPUFENPE53dm4XRWNn-3Ae0KUCBrVFZTjUR1TDUqAPncgod45pRtCQW4gg&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_8bZxxI0wKi6uNqzCpHPjtIVBC8kUN6nYcG8t3HMFEiw&oe=6A36AE0C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "11162707_121977648426018_56455927766712320_n.png", "id": "426025734481929", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/12138787_426025737815262_8408755498312007680_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wCpMO0JJ6N4Q7kNvwF-iDHi&_nc_oc=AdqUg7O0TEsWJb7PZXw3gGDD7DuV_xLpLdNCQKHU3JnV20ziTJ_tWn0e3KcuphwG6kI&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9oZhwiS9mOeXEWcOHzPycmi9hVCCzNZ5WoHnEyW8kCbg&oe=6A36B76A"}, "display_name": "The Hopping Dead (English Version)", "keywords": ["Zombie", "Chinese", "Ghost", "Spell", "Sword"], "long_description": "Eastern ghost and zombies aren't afraid of guns and fire, the great Wizards shall use their own magical spells and exorcism swords to exorcise demons. For all of you who were used to only guns as weapons, we offer you a brand-new adventure in killing zombies with Eastern magic!\n\n- We offer the liveliness and smoothness of arcade games, it will be a forthright adventure.\n\n- Our game is not only about killing, there are also different challenges that need to be solved in special and quick-witted ways.\n\n- Different from attacking with guns and fire, we attack Zombies with unique Eastern spells.\n\n- The haunted atmosphere and set will definitely give you thrills!", "short_description": "ICE Production introduces you <<The Hopping Dead >>, an action and horror Gear VR game with Eastern style, bringing you into the Eastern haunted world!\nYou will become a Wizard Exorcist from the East in the game, and fight against demons and zombies with your partner \"Dumby\"!"}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.ideproduction.com/vr-ar", "develope
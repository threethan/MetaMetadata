y2o9XYuqgYlFj0v2V5n7QYNWsgLotQ&oe=69B56008"}, {"file_name": "migrated_image.png", "id": "515096889445555", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/11162732_149939562452281_1446937803001692160_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PBJHPC2HeZUQ7kNvwFvmNkr&_nc_oc=AdmqMgVsonmBa4CakUWkhhzExBRL413y1CItynK3P9KqZLxHdgSk6odcG4z3cHmbiio&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfzAx3vv61kVeu0p-bMQmaOkZoYSvsSJm-f3WQLe1ueWuw&oe=69B548A9"}, {"file_name": "migrated_image.png", "id": "250946772739126", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/12427594_408189026287243_5425781852315058176_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5tk50rRYiEkQ7kNvwGst7Xr&_nc_oc=Adk37McKinsQFQIDZDMequV_4oE_wRI0O7XjO9yUYKHG9II6BwmgeR_j0mppQFeD8Kg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_Afwu2DZteoU_fqLZ1rjzDyCFAdjIuwUaO8kYLQJkmCF1xw&oe=69B542CC"}, {"file_name": "migrated_image.png", "id": "489840865227550", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/12410493_172626436801262_6061190936266801152_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Vlw9V2TJ31IQ7kNvwEnaJSs&_nc_oc=Admdl36QFooxg4Jd4QFdwar8VJNsOXuhWptw9-nFXSEdMer-gEdZAD2uLe4pQ16hado&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfxGTkHP7ZTIJHpChV2aPcnH945S9Hy50zhb0O0ir6tu4g&oe=69B560F3"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "The Hopping Dead (English Version)", "keywords": ["Zombie", "Chinese", "Ghost", "Spell", "Sword"], "long_description": "Eastern ghost and zombies aren't afraid of guns and fire, the great Wizards shall use their own magical spells and exorcism swords to exorcise demons. For all of you who were used to only guns as weapons, we offer you a brand-new adventure in killing zombies with Eastern magic!\n\n- We offer the liveliness and smoothness of arcade games, it will be a forthright adventure.\n\n- Our game is not only about killing, there are also different challenges that need to be solved in special and quick-witted ways.\n\n- Different from attacking with guns and fire, we attack Zombies with unique Eastern spells.\n\n- The haunted atmosphere and set will definitely give you thrills!", "short_description": "ICE Production introduces you <<The Hopping Dead >>, an action and horror Gear VR game with Eastern style, bringing you into the Eastern haunted world!\nYou will become a Wizard Exorcist from the East in the game, and fight against demons and zombies with your partner \"Dumby\"!"}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.ideproduction.com/vr-ar", "developer_terms_of_service_url": "http://www.ideproduction.com/vr-ar", "publisher_name": "ICE Production co., Ltd", "support_website_url": null, "website_url": "http://www.ideproduction.com/vr-ar", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "HORROR", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "231409855754267"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/11162769_512995992418545_3753370253527089152_n.png?stp=dst-png_s360x360&_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1i6r17FR3ZUQ7kNvwG6lWVS&_nc_oc=AdnqPPG22PNag95G53e2IyVFN4z5pbvtab88B1XlUDgV9J30W0DUOR28aOcQO0m5Ocw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfzrJtByYnWYauvZFeUV4MInkUKJLgXI7qluc5_alsa5Jg&oe=69B5647B"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "The Hopping Dead
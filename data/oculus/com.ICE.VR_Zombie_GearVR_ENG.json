 "id": "515096889445555", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/11162732_149939562452281_1446937803001692160_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FOJqj5aAWMQQ7kNvwEdrKDI&_nc_oc=AdnmTcRTxATaI-dlVhqomMoeZAnlxHl2TOGLeIGLk09jqcNfGN661Ee13SSpoNxGHwI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Afud7Vjkql_ygde3GGciKyA_5jBJCc3EGeM42WBGkiM3Zg&oe=69A6C829"}, {"file_name": "migrated_image.png", "id": "250946772739126", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/12427594_408189026287243_5425781852315058176_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ob5QWVmK6DcQ7kNvwGchMKE&_nc_oc=AdmcDcra7VM3udYn_ANWmZhqeee3zj7M034LrjkmnGP3O4t4da1NobK5pa6JicubjvE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afu-n2xGia0g1VuIwtu3NrdWsVhkokpALz992N59VeRnjA&oe=69A6C24C"}, {"file_name": "migrated_image.png", "id": "489840865227550", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/12410493_172626436801262_6061190936266801152_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tyFfPCV2i0kQ7kNvwG5BZVx&_nc_oc=AdmKoU_wSKDFQG29c1SvB0GEl6iM4XNm7-LGQIIJZOt-p-8Vjf96lz8eX5aLF0xoYAQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afs5yhAJlhe6lXHwYKaeU6BI3mel7j5WMf_xEljn_QCK2g&oe=69A6E073"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "The Hopping Dead (English Version)", "keywords": ["Zombie", "Chinese", "Ghost", "Spell", "Sword"], "long_description": "Eastern ghost and zombies aren't afraid of guns and fire, the great Wizards shall use their own magical spells and exorcism swords to exorcise demons. For all of you who were used to only guns as weapons, we offer you a brand-new adventure in killing zombies with Eastern magic!\n\n- We offer the liveliness and smoothness of arcade games, it will be a forthright adventure.\n\n- Our game is not only about killing, there are also different challenges that need to be solved in special and quick-witted ways.\n\n- Different from attacking with guns and fire, we attack Zombies with unique Eastern spells.\n\n- The haunted atmosphere and set will definitely give you thrills!", "short_description": "ICE Production introduces you <<The Hopping Dead >>, an action and horror Gear VR game with Eastern style, bringing you into the Eastern haunted world!\nYou will become a Wizard Exorcist from the East in the game, and fight against demons and zombies with your partner \"Dumby\"!"}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.ideproduction.com/vr-ar", "developer_terms_of_service_url": "http://www.ideproduction.com/vr-ar", "publisher_name": "ICE Production co., Ltd", "support_website_url": null, "website_url": "http://www.ideproduction.com/vr-ar", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "HORROR", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "231409855754267"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/11162769_512995992418545_3753370253527089152_n.png?stp=dst-png_s360x360&_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6vaRu8QWS2cQ7kNvwFhRalx&_nc_oc=AdlBVFrOr6FgSar7yA-tVRMGu0uyF4-F2BdTXtp5JQEuS2zuuRKgFZyFO1hD1p0dsUw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfvfQa902MK2YFRpzK7_pGca8Z6nY9dfyetXc0K_-8q0nw&oe=69A6E3FB"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "The Hopping Dead (English Version)", "platform": "ANDROID", "context_category": null, "context_topics": [], "release_date": 151681324
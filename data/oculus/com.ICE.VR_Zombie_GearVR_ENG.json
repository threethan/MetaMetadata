70291526533120_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4BWh7lBuNYoQ7kNvwFFY04M&_nc_oc=Ado--dJh0Z312ZGfsbbfIDT4CcR_N2dew7p7cjuCnlOs1mK-m9jjE6oLbgcu8Bcpubg&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQg8vKGMKsD7e00klRf1td4zmR6RqVStiM6ofHGIM9LXA&oe=6AFC8C48"}, {"file_name": "migrated_image.png", "id": "515096889445555", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/11162732_149939562452281_1446937803001692160_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qoaziMaGfTkQ7kNvwGDz60s&_nc_oc=Adr5rS-QsKXTxjrlQpXfVzcL0PCL8X-QenEZt_pvD_ToP_DpyJoW9_CHasMW6TIRxmk&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTVGjv8LFsBOfV_Rc4uEQxez4_fGxsXEAjiMFz5xADLJg&oe=6AFC74E9"}, {"file_name": "migrated_image.png", "id": "250946772739126", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/12427594_408189026287243_5425781852315058176_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3VnrmBTDaRIQ7kNvwF2YEd6&_nc_oc=AdrznUjauO5gKAAO4Fm2jqk6PDLc-aeMaJQ4eLbQN3qBT4kPzyZ8mzF2Xjnu7IZzVE8&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRVtcN3j8t3INh1TkmO-OkAfM3krX95olRBqEGp8yROeA&oe=6AFC6F0C"}, {"file_name": "migrated_image.png", "id": "489840865227550", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/12410493_172626436801262_6061190936266801152_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0z_z3sW_OiIQ7kNvwFV-BWG&_nc_oc=Adr7t__ZRfgF9VS-1zg21de3relCi0JtJ_E3uPgmL_mjhMnRCUbSu7gsZHE57GFTMms&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ5DikcfRUEH1PrwuYlPLSKgE7K-wt6KdfvfVXpL9w9Mg&oe=6AFC8D33"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "The Hopping Dead (English Version)", "keywords": ["Zombie", "Chinese", "Ghost", "Spell", "Sword"], "long_description": "Eastern ghost and zombies aren't afraid of guns and fire, the great Wizards shall use their own magical spells and exorcism swords to exorcise demons. For all of you who were used to only guns as weapons, we offer you a brand-new adventure in killing zombies with Eastern magic!\n\n- We offer the liveliness and smoothness of arcade games, it will be a forthright adventure.\n\n- Our game is not only about killing, there are also different challenges that need to be solved in special and quick-witted ways.\n\n- Different from attacking with guns and fire, we attack Zombies with unique Eastern spells.\n\n- The haunted atmosphere and set will definitely give you thrills!", "short_description": "ICE Production introduces you <<The Hopping Dead >>, an action and horror Gear VR game with Eastern style, bringing you into the Eastern haunted world!\nYou will become a Wizard Exorcist from the East in the game, and fight against demons and zombies with your partner \"Dumby\"!"}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.ideproduction.com/vr-ar", "developer_terms_of_service_url": "http://www.ideproduction.com/vr-ar", "publisher_name": "ICE Production co., Ltd", "support_website_url": null, "website_url": "http://www.ideproduction.com/vr-ar", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "HORROR", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "231409855754267"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/11162769_512995992418545_3753370253527089152_n.png?stp=dst-png_s360x360&_nc_cat=
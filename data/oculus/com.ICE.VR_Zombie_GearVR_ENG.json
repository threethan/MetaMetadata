9DmD3_ox6peT1VaoRsLTH4OGooNizQ&oe=69BE9A88"}, {"file_name": "migrated_image.png", "id": "515096889445555", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/11162732_149939562452281_1446937803001692160_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6YZLo0FX-pUQ7kNvwE-XZyN&_nc_oc=AdmyRXiCoptUeTxZDxbStExN2Qv0y-GR-zvqUqPpk0pQsUNz64BkJl8dX5S1H5qwSMY&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_Afz1Pbwk2apMcWY6USR16z947i7GAXo8G8rO0JKiY62s4w&oe=69BE8329"}, {"file_name": "migrated_image.png", "id": "250946772739126", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/12427594_408189026287243_5425781852315058176_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6XLexryg5h0Q7kNvwHBnsmE&_nc_oc=AdmWjv3Dc58Dz9wTb_7Xp3Vqy3TeFEKA9t9YSP1b_BsDpBvyt9AvDAoNbxD2llSJXjI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_Afz-0sMnfQCpidqt2qtsmFztTzv18zgdhrteEy8ZJ8-fpQ&oe=69BE7D4C"}, {"file_name": "migrated_image.png", "id": "489840865227550", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/12410493_172626436801262_6061190936266801152_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NBiI61MR_O0Q7kNvwGOJ9LT&_nc_oc=AdmqybxcunzGlfD-cZjy1ab1c73MI7edVFT5AD4wGsD8F6gmTrCi-YoZD9ZLurvKPWg&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_Afxi-5ilL3AcrXP1Hh2xfutQAxkiEN6Vmtp7MsYxaQTXHA&oe=69BE9B73"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "The Hopping Dead (English Version)", "keywords": ["Zombie", "Chinese", "Ghost", "Spell", "Sword"], "long_description": "Eastern ghost and zombies aren't afraid of guns and fire, the great Wizards shall use their own magical spells and exorcism swords to exorcise demons. For all of you who were used to only guns as weapons, we offer you a brand-new adventure in killing zombies with Eastern magic!\n\n- We offer the liveliness and smoothness of arcade games, it will be a forthright adventure.\n\n- Our game is not only about killing, there are also different challenges that need to be solved in special and quick-witted ways.\n\n- Different from attacking with guns and fire, we attack Zombies with unique Eastern spells.\n\n- The haunted atmosphere and set will definitely give you thrills!", "short_description": "ICE Production introduces you <<The Hopping Dead >>, an action and horror Gear VR game with Eastern style, bringing you into the Eastern haunted world!\nYou will become a Wizard Exorcist from the East in the game, and fight against demons and zombies with your partner \"Dumby\"!"}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.ideproduction.com/vr-ar", "developer_terms_of_service_url": "http://www.ideproduction.com/vr-ar", "publisher_name": "ICE Production co., Ltd", "support_website_url": null, "website_url": "http://www.ideproduction.com/vr-ar", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "HORROR", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "231409855754267"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/11162769_512995992418545_3753370253527089152_n.png?stp=dst-png_s360x360&_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cgjowSw_imQQ7kNvwHwKgiJ&_nc_oc=AdlgPCxHUl29IwOui7AL0MjV84JyiYd_8Qsiw8fM6aHjPPry1zTw95LKZEJzYeOdtPA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfzxiK67fng8P4CJXnYK2U0ailZgXuuXxwWGnJS1bFWf-g&oe=69BE9EFB"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "The Hopping Dead
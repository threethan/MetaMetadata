Hd1r7uTpcw_ku3L-7imWQwh2u6N2pw&oe=69BAA608"}, {"file_name": "migrated_image.png", "id": "515096889445555", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/11162732_149939562452281_1446937803001692160_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a-NF5Kh61uQQ7kNvwEubgA_&_nc_oc=AdkW7A9TC775p99jarzBIQZF9J3y_dkTrItGzzfnnVxRTRtK9dOuHFoQldblH47m5GA&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=8&oh=00_AfyYTlFtR8i4N7kTkteheKLUoPvW_f_Ic1wrrjQAqaR1TQ&oe=69BA8EA9"}, {"file_name": "migrated_image.png", "id": "250946772739126", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/12427594_408189026287243_5425781852315058176_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RljzpjYNCKUQ7kNvwHoDi8l&_nc_oc=AdlNaKCARVlRuyhS6bVsu_sVjfqY7m19LD7kuxQDXnDPGe-NBMKyZ7keY7gcWHXZ8Lw&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=8&oh=00_Afx6aJgQ4dWxSW-tRzpZLBEqqn-KYI_AC_zrPLscLOUj7Q&oe=69BA88CC"}, {"file_name": "migrated_image.png", "id": "489840865227550", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/12410493_172626436801262_6061190936266801152_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4nDTpcIkdG4Q7kNvwG4T_-h&_nc_oc=AdkOb-FTBj5p6NHVDh8FgU2vnsRuYiUN2CFyrT3X_RyxtBj9QyumOQfghOYJSvcH0mQ&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_AfxUTayaBOkIGeBDITaUr7cbZfwsqdez3NluYuQKr3Rqqg&oe=69BAA6F3"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "The Hopping Dead (English Version)", "keywords": ["Zombie", "Chinese", "Ghost", "Spell", "Sword"], "long_description": "Eastern ghost and zombies aren't afraid of guns and fire, the great Wizards shall use their own magical spells and exorcism swords to exorcise demons. For all of you who were used to only guns as weapons, we offer you a brand-new adventure in killing zombies with Eastern magic!\n\n- We offer the liveliness and smoothness of arcade games, it will be a forthright adventure.\n\n- Our game is not only about killing, there are also different challenges that need to be solved in special and quick-witted ways.\n\n- Different from attacking with guns and fire, we attack Zombies with unique Eastern spells.\n\n- The haunted atmosphere and set will definitely give you thrills!", "short_description": "ICE Production introduces you <<The Hopping Dead >>, an action and horror Gear VR game with Eastern style, bringing you into the Eastern haunted world!\nYou will become a Wizard Exorcist from the East in the game, and fight against demons and zombies with your partner \"Dumby\"!"}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.ideproduction.com/vr-ar", "developer_terms_of_service_url": "http://www.ideproduction.com/vr-ar", "publisher_name": "ICE Production co., Ltd", "support_website_url": null, "website_url": "http://www.ideproduction.com/vr-ar", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "HORROR", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "231409855754267"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/11162769_512995992418545_3753370253527089152_n.png?stp=dst-png_s360x360&_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d4Yl5kvlZZQQ7kNvwENHnc8&_nc_oc=AdmOGhXQYRJG6H_GtiTaIht0Zhpnp0nXrp4-yYlcWFDMSUHbZBo8H9uQMOIaA9Dx0Os&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_AfwM74QKVlYUc3HovBrazTx3UlWOwlABnpwYzRFbq4sHzg&oe=69BAAA7B"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "The Hopping Dead
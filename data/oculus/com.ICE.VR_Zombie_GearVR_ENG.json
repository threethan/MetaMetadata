70291526533120_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W6fyvZEPamMQ7kNvwFLzr5I&_nc_oc=AdruK_ql2o62byW8rUOuRw5m98lK7wDO9Xu0FEzIGrEFcSPzJVqkDYKjQHXiH9XRXA8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQQcV-dxrhPTQtankQZ44Fg2pq3sV5_bVwKgt8Ao-HkOw&oe=6B0DAFC8"}, {"file_name": "migrated_image.png", "id": "515096889445555", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/11162732_149939562452281_1446937803001692160_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0sUCr2FDNWkQ7kNvwF-0ACg&_nc_oc=AdrsxPR798Wd7wbQnyepHFqYsYxZNQ4BnGpqoN0iWA0i_AAfWsjkwAQnSCDHYPO7obk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSk17RhnbmfCnFo0-IFYt9a_6mkHSnzvkz_n83YDhT7cw&oe=6B0DD0A9"}, {"file_name": "migrated_image.png", "id": "250946772739126", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12427594_408189026287243_5425781852315058176_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kjSUpnM9x2gQ7kNvwElskzS&_nc_oc=Adq8cH_s1D02G7FEXrOMXOdGsQ4dEoGqV7PvvV8tQehSZTeCIfK_6LCOidcnYbClc-8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRUH12m3NW0IJwohQV0gouUAlgR1Pz-rTbjOO6nmuATHw&oe=6B0DCACC"}, {"file_name": "migrated_image.png", "id": "489840865227550", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12410493_172626436801262_6061190936266801152_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2p16ZKIcE3cQ7kNvwGcfASz&_nc_oc=AdoWEnyAcPQBwWEADvUOfjKB8gOqO9dZtfhkfGnkZWwOEaeBf_UjwtMZa8LGeV2e3PA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQW7sXtxYd559j-okjztU9MNlNjOQdrmpimXxIMDaGr1w&oe=6B0DB0B3"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "The Hopping Dead (English Version)", "keywords": ["Zombie", "Chinese", "Ghost", "Spell", "Sword"], "long_description": "Eastern ghost and zombies aren't afraid of guns and fire, the great Wizards shall use their own magical spells and exorcism swords to exorcise demons. For all of you who were used to only guns as weapons, we offer you a brand-new adventure in killing zombies with Eastern magic!\n\n- We offer the liveliness and smoothness of arcade games, it will be a forthright adventure.\n\n- Our game is not only about killing, there are also different challenges that need to be solved in special and quick-witted ways.\n\n- Different from attacking with guns and fire, we attack Zombies with unique Eastern spells.\n\n- The haunted atmosphere and set will definitely give you thrills!", "short_description": "ICE Production introduces you <<The Hopping Dead >>, an action and horror Gear VR game with Eastern style, bringing you into the Eastern haunted world!\nYou will become a Wizard Exorcist from the East in the game, and fight against demons and zombies with your partner \"Dumby\"!"}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.ideproduction.com/vr-ar", "developer_terms_of_service_url": "http://www.ideproduction.com/vr-ar", "publisher_name": "ICE Production co., Ltd", "support_website_url": null, "website_url": "http://www.ideproduction.com/vr-ar", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "HORROR", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "231409855754267"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/11162769_512995992418545_3753370253527089152_n.png?stp=dst-png_s360x360&_nc_cat=
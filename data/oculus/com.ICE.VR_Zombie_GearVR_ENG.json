culuscdn.com&_nc_ss=7f20f&oh=00_AQIYMxprc9uMQCGKDZkl8auIfglEgousVyg3OqiGKnATJA&oe=6AA3FF88"}, {"file_name": "migrated_image.png", "id": "515096889445555", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/11162732_149939562452281_1446937803001692160_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vuRASflYM9gQ7kNvwFZIilb&_nc_oc=AdrE-GasSPzHbj6dlTtdPzn6fWcw0wRKqoqdCTr141lHM74YDZrkgRbgrNeWOb3op9g&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKA429TxQrhUuydCpYqP9l6xsXpwEFw1QZLYV3mEPpxFg&oe=6AA42069"}, {"file_name": "migrated_image.png", "id": "250946772739126", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/12427594_408189026287243_5425781852315058176_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TydQxRf5wjsQ7kNvwF5B720&_nc_oc=AdrmUMShVGij6NNRNCe5rEBYimHkXpdMltAgehuA41GXdvrophmslTfjpgZXKHDrCXQ&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIjCii-wDEwcOqbOuKHi1y4i3Ry8YY02uuJ5kevFrciRQ&oe=6AA41A8C"}, {"file_name": "migrated_image.png", "id": "489840865227550", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/12410493_172626436801262_6061190936266801152_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z9iwzQ_K4BcQ7kNvwH1gQGd&_nc_oc=AdpXSjoa-54b0jcoZr0oJ2WdGIF4yPvl84BbF2dNru5dCXoFiYiHYWMEZOxDirXEYxg&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLmQFzE6fJEcU7R8FfTNM6_TYDs6My3ZoguBAdfblvwZg&oe=6AA40073"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "The Hopping Dead (English Version)", "keywords": ["Zombie", "Chinese", "Ghost", "Spell", "Sword"], "long_description": "Eastern ghost and zombies aren't afraid of guns and fire, the great Wizards shall use their own magical spells and exorcism swords to exorcise demons. For all of you who were used to only guns as weapons, we offer you a brand-new adventure in killing zombies with Eastern magic!\n\n- We offer the liveliness and smoothness of arcade games, it will be a forthright adventure.\n\n- Our game is not only about killing, there are also different challenges that need to be solved in special and quick-witted ways.\n\n- Different from attacking with guns and fire, we attack Zombies with unique Eastern spells.\n\n- The haunted atmosphere and set will definitely give you thrills!", "short_description": "ICE Production introduces you <<The Hopping Dead >>, an action and horror Gear VR game with Eastern style, bringing you into the Eastern haunted world!\nYou will become a Wizard Exorcist from the East in the game, and fight against demons and zombies with your partner \"Dumby\"!"}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.ideproduction.com/vr-ar", "developer_terms_of_service_url": "http://www.ideproduction.com/vr-ar", "publisher_name": "ICE Production co., Ltd", "support_website_url": null, "website_url": "http://www.ideproduction.com/vr-ar", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "HORROR", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "231409855754267"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/11162769_512995992418545_3753370253527089152_n.png?stp=dst-png_s360x360&_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V2GVDFCPaA4Q7kNvwFGC6aa&_nc_oc=Ado7C-U-kDePWTvuxNM-y02ePyOHEMqaUVODxjLlWS4YLh091iLfhMI0Y7AlqClYYc8&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLvS9WameC5MausRlMjUuUmj-bzUu8IYuWYcu68Z8e3Ew&oe=6AA403FB"}, "is_concept": false, "is_test": fal
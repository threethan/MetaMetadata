70291526533120_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W6fyvZEPamMQ7kNvwE2FRuR&_nc_oc=Adq5v-wqAprMRZXi-7YczFlpswiRCj4Z1ReMR9i4JxX_gRC_oryKfb9pH_S09JdDl1Y&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRPXZ03pPmWRHkahQFFYlXTcShTLZzdmY_cyiBQ4fns4A&oe=6B0B4508"}, {"file_name": "migrated_image.png", "id": "515096889445555", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/11162732_149939562452281_1446937803001692160_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yW_3FZjOhRcQ7kNvwFsWONU&_nc_oc=AdqPdlS0GFdFE8G2Uf7GR4XREy13Avjejl7c8-FoBihndiEoOy38wN-BxokcW2X1HKQ&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSd4mWKzsIyFq_dt2-LANBXfIOKjZfeanj8cH0aT0YjZw&oe=6B0B2DA9"}, {"file_name": "migrated_image.png", "id": "250946772739126", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/12427594_408189026287243_5425781852315058176_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=snU-4Fn0FlcQ7kNvwGQR0iu&_nc_oc=AdrDP_hDdN8ljH1v62RrhOXBau_R__syr6tNWzTBbtR3uDGyW_c0YxP_ksN7Qw7fcHI&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQS42av5Pe6zDjZjyRcPTnEq2eiDvgolg4-cYtas44FyUA&oe=6B0B27CC"}, {"file_name": "migrated_image.png", "id": "489840865227550", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/12410493_172626436801262_6061190936266801152_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tMGxS13dqGkQ7kNvwGh9sTp&_nc_oc=AdrwRWs70NjyDDK7y1ykV__kkyjH90qNwJmgW6X_3NxandVmLmwJCvr3RJ2fMPAFsCI&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRWeKqWyjPamiTGvL3LjzsfkkPfMkrlg_0JC3CYisRCrQ&oe=6B0B45F3"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "The Hopping Dead (English Version)", "keywords": ["Zombie", "Chinese", "Ghost", "Spell", "Sword"], "long_description": "Eastern ghost and zombies aren't afraid of guns and fire, the great Wizards shall use their own magical spells and exorcism swords to exorcise demons. For all of you who were used to only guns as weapons, we offer you a brand-new adventure in killing zombies with Eastern magic!\n\n- We offer the liveliness and smoothness of arcade games, it will be a forthright adventure.\n\n- Our game is not only about killing, there are also different challenges that need to be solved in special and quick-witted ways.\n\n- Different from attacking with guns and fire, we attack Zombies with unique Eastern spells.\n\n- The haunted atmosphere and set will definitely give you thrills!", "short_description": "ICE Production introduces you <<The Hopping Dead >>, an action and horror Gear VR game with Eastern style, bringing you into the Eastern haunted world!\nYou will become a Wizard Exorcist from the East in the game, and fight against demons and zombies with your partner \"Dumby\"!"}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.ideproduction.com/vr-ar", "developer_terms_of_service_url": "http://www.ideproduction.com/vr-ar", "publisher_name": "ICE Production co., Ltd", "support_website_url": null, "website_url": "http://www.ideproduction.com/vr-ar", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "HORROR", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "231409855754267"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/11162769_512995992418545_3753370253527089152_n.png?stp=dst-png_s360x360&_nc_cat=
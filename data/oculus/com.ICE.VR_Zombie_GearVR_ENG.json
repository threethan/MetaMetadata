70291526533120_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=33eOMkmI5DYQ7kNvwGZhszf&_nc_oc=AdpTpIFG7aS8IRHN_GJnbzFWdbhru0-g8rEbAe0C9fBA1KwrKA_4LqPsZP82v2023LA&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRybtAib85nuIHyDLw0zU-P2zVmemXCja_dzwFhk2JueQ&oe=6B09BB48"}, {"file_name": "migrated_image.png", "id": "515096889445555", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/11162732_149939562452281_1446937803001692160_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yW_3FZjOhRcQ7kNvwELlOzN&_nc_oc=AdoRXr58HDhHFruT_aR-nFDOVUSsvOfdWHNNjWwjGL5kCnzx90LLpj27mQn_vp2b2kw&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTLuFjk4dyjJ6CK6zJ2Kf7TN321Jm5_lEvw7e9muYkbCg&oe=6B09A3E9"}, {"file_name": "migrated_image.png", "id": "250946772739126", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/12427594_408189026287243_5425781852315058176_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=snU-4Fn0FlcQ7kNvwFv58k-&_nc_oc=AdqtOHDG5HQwJuuhSdfgjDe_eg6vhgDFUtHMbcJByfJ9l5k-cfbklxCJiQmiiuAG9rU&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRxUyFc4xRRLWufADZVr9yN4TJ1IVIyvkIMRWfq45NfEw&oe=6B099E0C"}, {"file_name": "migrated_image.png", "id": "489840865227550", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/12410493_172626436801262_6061190936266801152_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tMGxS13dqGkQ7kNvwE5PJ3E&_nc_oc=AdrD_GVL4fp-b0Vvw-eJ2H7tyCnKx_02Pnhut0tOCycrOEZwZGB0R6SlQG4K6YMaDI8&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTGJbwdkB_JE6MqeXi95t9l5RzrkcYfvKYR2XRAPRYbPg&oe=6B09BC33"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "The Hopping Dead (English Version)", "keywords": ["Zombie", "Chinese", "Ghost", "Spell", "Sword"], "long_description": "Eastern ghost and zombies aren't afraid of guns and fire, the great Wizards shall use their own magical spells and exorcism swords to exorcise demons. For all of you who were used to only guns as weapons, we offer you a brand-new adventure in killing zombies with Eastern magic!\n\n- We offer the liveliness and smoothness of arcade games, it will be a forthright adventure.\n\n- Our game is not only about killing, there are also different challenges that need to be solved in special and quick-witted ways.\n\n- Different from attacking with guns and fire, we attack Zombies with unique Eastern spells.\n\n- The haunted atmosphere and set will definitely give you thrills!", "short_description": "ICE Production introduces you <<The Hopping Dead >>, an action and horror Gear VR game with Eastern style, bringing you into the Eastern haunted world!\nYou will become a Wizard Exorcist from the East in the game, and fight against demons and zombies with your partner \"Dumby\"!"}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.ideproduction.com/vr-ar", "developer_terms_of_service_url": "http://www.ideproduction.com/vr-ar", "publisher_name": "ICE Production co., Ltd", "support_website_url": null, "website_url": "http://www.ideproduction.com/vr-ar", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "HORROR", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "231409855754267"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/11162769_512995992418545_3753370253527089152_n.png?stp=dst-png_s360x360&_nc_cat=
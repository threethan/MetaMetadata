.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEWXyf1tTqY_qYlJZxsWPuHdhCfj3L0Wn55PFDs-7IHrQ&oe=6A8D9608"}, {"file_name": "migrated_image.png", "id": "515096889445555", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/11162732_149939562452281_1446937803001692160_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=edhu_CPbNxEQ7kNvwE10E4B&_nc_oc=AdrsWz0qqh4C2i0cVE1ZjghKp1hgsbetao7hFrHc_muJEdhQwRgnQ8bM5NjWqhTbXAI&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQENgd21hecOmWgsaQq_7cc_oMt3P4egG7wKGDpRZ2ZaJw&oe=6A8D7EA9"}, {"file_name": "migrated_image.png", "id": "250946772739126", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/12427594_408189026287243_5425781852315058176_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1R1Y6aGvXs4Q7kNvwGwBV2l&_nc_oc=AdodLpQ8aKxoDyd0foLfuLQ2lPpBo0DceFDE4q2H7oT42I0UFMZYF89yW93B4hi-tMo&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF3E0hPB6iKQCVw0QDsBzAhAUYoGLrGWxRF0mp-vhstMA&oe=6A8D78CC"}, {"file_name": "migrated_image.png", "id": "489840865227550", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/12410493_172626436801262_6061190936266801152_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FaYIZUkWFF8Q7kNvwFNWjHe&_nc_oc=AdrRm7RdjcWMdkSxR3pZK9PL3Wy2zU-CdbOkJC1zRYk37j5KovoX_9v4QbWRleGwZFU&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHt1edyhcjbsajbvrFAxPn6PivOexFvcHkamGg0y5y0fg&oe=6A8D96F3"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "The Hopping Dead (English Version)", "keywords": ["Zombie", "Chinese", "Ghost", "Spell", "Sword"], "long_description": "Eastern ghost and zombies aren't afraid of guns and fire, the great Wizards shall use their own magical spells and exorcism swords to exorcise demons. For all of you who were used to only guns as weapons, we offer you a brand-new adventure in killing zombies with Eastern magic!\n\n- We offer the liveliness and smoothness of arcade games, it will be a forthright adventure.\n\n- Our game is not only about killing, there are also different challenges that need to be solved in special and quick-witted ways.\n\n- Different from attacking with guns and fire, we attack Zombies with unique Eastern spells.\n\n- The haunted atmosphere and set will definitely give you thrills!", "short_description": "ICE Production introduces you <<The Hopping Dead >>, an action and horror Gear VR game with Eastern style, bringing you into the Eastern haunted world!\nYou will become a Wizard Exorcist from the East in the game, and fight against demons and zombies with your partner \"Dumby\"!"}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.ideproduction.com/vr-ar", "developer_terms_of_service_url": "http://www.ideproduction.com/vr-ar", "publisher_name": "ICE Production co., Ltd", "support_website_url": null, "website_url": "http://www.ideproduction.com/vr-ar", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "HORROR", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "231409855754267"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/11162769_512995992418545_3753370253527089152_n.png?stp=dst-png_s360x360&_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CXIIY1ukvt8Q7kNvwE1eQm5&_nc_oc=Adq5-nR0TzGYXEk-dnPIIBvmiDZa-aeMQM2gscZbOsgpy9CEkc6lpKrnkqZOcIQiEiw&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHy5WfbkgNewHxjwcCZ_wwbjSMKXGth9d72w6Xnv3JD3g&oe=6A8D9A7B"}, "is_concept": false, "is_test": f
71-25/473392298_969006928775886_7058059946160548103_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m3tYlaKYsS0Q7kNvwGk_Ixj&_nc_oc=AdoGCZa8G8-XbZSmaLW5qdgaJ3CNLhKAE-P9E8Y4G_IqJRuEndz7x-lbRX7QaEhvvZ4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6ffkgz0UliqakoBHVTpiIrNnr_nBdNFoFjNyahLtpKjw&oe=6A1D9BEF"}, {"file_name": "MQVR_metaStore_ss2.png", "id": "655824863632556", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473391955_655824866965889_9083744742728821581_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ycscf0eTgC0Q7kNvwEEk596&_nc_oc=Ado7hLPBCKvVzYmOSxwHsVyGQpCWVuNbQq9rwoaaTGRR-yAuEIG0na7-7W4kZ0vWa3Y&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4O8m4GINuBdOKl0vPj2fSucXUKoMkCDOd_1agtOFHbjA&oe=6A1D9649"}, {"file_name": "MQVR_metaStore_ss5.png", "id": "640264872280351", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473391924_640264875613684_2893261742097832448_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7KgP4P8JdhkQ7kNvwELUrLd&_nc_oc=AdpTTB8IyOls-Ihiuk4r8dlOBGbIon2oWHFsiOK5IumqvX7K3XJFT6kXoFSEJkuy1dU&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af78Z3ZjeqARkVyNCeuZynuwawPGMHGY9qVIZbxzLdvAuQ&oe=6A1D92EA"}, {"file_name": "MQVR_metaStore_ss1.png", "id": "686879277133721", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473394268_686879280467054_8709353857892239785_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ew_5hu8zx68Q7kNvwGcl6Xs&_nc_oc=AdoYzKLGE0nT-i9CRcCZRl9v42vwCldqi55gLodes-S194ocVoc84G4uaC9XvNQNhNU&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4q_0CXYin9sDlfwwNcxuk7o7sgbbeqLvovliVR3-w-VQ&oe=6A1D7E90"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Art - 2560x1440 (1).png", "id": "681083991246799", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473391986_681083994580132_5877693932550353369_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MMs9YlycDe4Q7kNvwEEJ9sC&_nc_oc=AdrRi-FnCPkcGl8wbzRbcKbThIDoEx2_H7nS-Jo81Au01MG_ksD66t4lFXfi6AnzlAU&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7_ldpJ1yZlVg_eQ5O88rbN8ivhoubtmIkkr07WRUVsvw&oe=6A1D7CB5"}, "display_name": "Math Quest VR", "keywords": ["education", "VR", "action", "singeplayer", "firstperson"], "long_description": "Math has never been this action-packed! Step into Math Quest VR, where solving problems means blasting bandits with your paintball gun. Travel through exciting worlds of Addition, Subtraction, Multiplication, and Division, unlocking new challenges along the way. Whether you're playing Story Mode to level up your skills or testing your speed in Arcade Mode, every shot brings you closer to math mastery.\n\nKey Features:\n- Solve math problems in a whole new way \u2013 aim, shoot, and answer to progress through thrilling levels.\n- Explore interactive worlds themed around Addition, Subtraction, Multiplication, and Division.\n- Choose your challenge \u2013 level up in Story Mode or race against time in Arcade Mode.\n- Sharpen your reflexes and your mind with fast-paced, brain-boosting gameplay.\n- Engage in immersive VR action that makes math fun, exciting, and rewarding.\n\nThink fast, shoot smart, and become a math legend in Math Quest VR!", "short_description": "Turn math into an adventure! Blast through interactive worlds of Addition, Subtraction, Multiplication, and Division. Play Story Mode to grow your skills or Arcade Mode for a fast-paced challenge!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://thedevhouseagency.com/Privacy_Policy_MathQuestVR.pdf", "developer_terms_of_service_url": null, "publisher_name": "Devhouse", "support_website_url": null, "website_url": "https://www.thedevhouseagency.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1043107547362485"}, {"id": "459781504968480"}, {"id": "374404007583481
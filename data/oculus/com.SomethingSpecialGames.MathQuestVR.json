71-25/473392298_969006928775886_7058059946160548103_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LvmIf1WiZ_8Q7kNvwHlPofS&_nc_oc=AdoGyHce_9ryZssLxacYFys86qRT93g_tiRmbeEF4B78tFDRRsL3WDIX_Lonb8ZDSlA&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEEjPlMxvEcHrCi7X2ybmISab_jNTiP2ofaEnuNGOmU9w&oe=6A8438AF"}, {"file_name": "MQVR_metaStore_ss2.png", "id": "655824863632556", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391955_655824866965889_9083744742728821581_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c3nqflmCuRgQ7kNvwG7-mm1&_nc_oc=Adr52t7SHWLpZNnBcVjL38wlJ_Ox0A7ovE4LTLJOKakMVnDxKivsCveRN7AEFLV555Q&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFTqacBHTHvxPZoPd07weRxFG6wA3Jd6mu0k6GCbMvJdg&oe=6A846B49"}, {"file_name": "MQVR_metaStore_ss5.png", "id": "640264872280351", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391924_640264875613684_2893261742097832448_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-qvV1-WwbKMQ7kNvwH3ENcO&_nc_oc=AdpgOjluz1z1S2_rlvKpKjo3dgWK7D9fHZMBXIEDX0EnLHu1pq_vACYgjMzp9YGOXyw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF0RM9-M2yvwbN1LMVvAw3K6YROtnNT8wM3VFsmYe3M-g&oe=6A8467EA"}, {"file_name": "MQVR_metaStore_ss1.png", "id": "686879277133721", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473394268_686879280467054_8709353857892239785_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GrAiNz1EQpAQ7kNvwF7kSm-&_nc_oc=Ado7-p5KcDJ6IfbSlDUNoZk4Cm6BCyczAshBVV40eICJ33eFv4PY8BtJ4wvvCf8jyGs&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG1aO1OvrCcidYJUfjfADxprDBDYPJGlVEaa33NgwvT6Q&oe=6A845390"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Art - 2560x1440 (1).png", "id": "681083991246799", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391986_681083994580132_5877693932550353369_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O4GGVVzXofAQ7kNvwGy2PeX&_nc_oc=Adp1eITH0pIxLHyNS0wt4_hoM9jjISLrvt5qWKrqTQYWw9eCPEM8wpuZ37qzSehG8eQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEuhoE3oOdH9BnBp0yGy-yBnzOj5F36no3nZkxWP3lUdQ&oe=6A8451B5"}, "display_name": "Math Quest VR", "keywords": ["education", "VR", "action", "singeplayer", "firstperson"], "long_description": "Math has never been this action-packed! Step into Math Quest VR, where solving problems means blasting bandits with your paintball gun. Travel through exciting worlds of Addition, Subtraction, Multiplication, and Division, unlocking new challenges along the way. Whether you're playing Story Mode to level up your skills or testing your speed in Arcade Mode, every shot brings you closer to math mastery.\n\nKey Features:\n- Solve math problems in a whole new way \u2013 aim, shoot, and answer to progress through thrilling levels.\n- Explore interactive worlds themed around Addition, Subtraction, Multiplication, and Division.\n- Choose your challenge \u2013 level up in Story Mode or race against time in Arcade Mode.\n- Sharpen your reflexes and your mind with fast-paced, brain-boosting gameplay.\n- Engage in immersive VR action that makes math fun, exciting, and rewarding.\n\nThink fast, shoot smart, and become a math legend in Math Quest VR!", "short_description": "Turn math into an adventure! Blast through interactive worlds of Addition, Subtraction, Multiplication, and Division. Play Story Mode to grow your skills or Arcade Mode for a fast-paced challenge!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://thedevhouseagency.com/Privacy_Policy_MathQuestVR.pdf", "developer_terms_of_service_url": null, "publisher_name": "Devhouse", "support_website_url": null, "website_url": "https://www.thedevhouseagency.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1043107547362485"}, {"id": "459781504968480"}, {"id": "374404007583481
71-25/473392298_969006928775886_7058059946160548103_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZvuT8I94eREQ7kNvwEnWyh1&_nc_oc=AdoiQOTAZYiorltLvOETPLUdfJ6P1e_EX0PRkALOyI84GHNs_J3ZydnFACp8aMnbfIE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDB6ctQotFKKpmvFJCnPHS-UasZRUtctEzKUXdKg9brCQ&oe=6A5F86EF"}, {"file_name": "MQVR_metaStore_ss2.png", "id": "655824863632556", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473391955_655824866965889_9083744742728821581_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gucL9YAWHLAQ7kNvwFubZrE&_nc_oc=AdqYjeJmoA5iQ9Fudn5I_eE0Et1ve9hKqB-sRM2i4D3jtGsvYfKoM8Z2wdJ2KgQw7a4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCnA_ffkDXkGEflLmKTjuHBlygo31-6uEoSmTJm8suLRA&oe=6A5F8149"}, {"file_name": "MQVR_metaStore_ss5.png", "id": "640264872280351", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473391924_640264875613684_2893261742097832448_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W6jjyzNft4MQ7kNvwFjRNJY&_nc_oc=AdrCFCRMOBPqBwnd6FELJHP1ThxHycVsNNytQ58U7WelhpcAVGn9_w9JoeHdbLBcDeI&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAQk41n2v_bj-i81_WI7XFtxYRDflA4JsbAek-uVoGCvA&oe=6A5F7DEA"}, {"file_name": "MQVR_metaStore_ss1.png", "id": "686879277133721", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473394268_686879280467054_8709353857892239785_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y_RvfmMt6a4Q7kNvwEps4Lw&_nc_oc=Adr4zcZasm3fZkZMtPJHdnH86yacCrERcB-fzM5J5cqa1VkoXlDlZU8il7URIUGZli0&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDRl1P9Z2VKrZV4nMSK-BMfJh18fyz4pRv9olPtsikheQ&oe=6A5F6990"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Art - 2560x1440 (1).png", "id": "681083991246799", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473391986_681083994580132_5877693932550353369_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rExbtjnrDgcQ7kNvwGRhHhN&_nc_oc=Adp_c1VskuAD2Qsk6tDqwSQQsMVpKUS5o9VeweydH6DlhyyMG54mOhdCxLfXUEHMvrs&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBvnyyGgGfq2-tTWPHTx_r-pKp09Jwz7NTArcayAKo1xQ&oe=6A5F67B5"}, "display_name": "Math Quest VR", "keywords": ["education", "VR", "action", "singeplayer", "firstperson"], "long_description": "Math has never been this action-packed! Step into Math Quest VR, where solving problems means blasting bandits with your paintball gun. Travel through exciting worlds of Addition, Subtraction, Multiplication, and Division, unlocking new challenges along the way. Whether you're playing Story Mode to level up your skills or testing your speed in Arcade Mode, every shot brings you closer to math mastery.\n\nKey Features:\n- Solve math problems in a whole new way \u2013 aim, shoot, and answer to progress through thrilling levels.\n- Explore interactive worlds themed around Addition, Subtraction, Multiplication, and Division.\n- Choose your challenge \u2013 level up in Story Mode or race against time in Arcade Mode.\n- Sharpen your reflexes and your mind with fast-paced, brain-boosting gameplay.\n- Engage in immersive VR action that makes math fun, exciting, and rewarding.\n\nThink fast, shoot smart, and become a math legend in Math Quest VR!", "short_description": "Turn math into an adventure! Blast through interactive worlds of Addition, Subtraction, Multiplication, and Division. Play Story Mode to grow your skills or Arcade Mode for a fast-paced challenge!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://thedevhouseagency.com/Privacy_Policy_MathQuestVR.pdf", "developer_terms_of_service_url": null, "publisher_name": "Devhouse", "support_website_url": null, "website_url": "https://www.thedevhouseagency.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1043107547362485"}, {"id": "459781504968480"}, {"id": "374404007583481
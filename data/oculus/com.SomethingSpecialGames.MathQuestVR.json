71-25/473392298_969006928775886_7058059946160548103_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ptoq-cFt5N0Q7kNvwGbtrk9&_nc_oc=Adqcc59N8XS4gKX_XWLZhk7LFac5QdyhoZZuMnxxQNbOBBB0EV60oztrVlm40dCH0do&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6IWQrvOYsFZ_n8yE0cCmSU7DTYurCp6g72eEDX9oqvTA&oe=6A05E0EF"}, {"file_name": "MQVR_metaStore_ss2.png", "id": "655824863632556", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391955_655824866965889_9083744742728821581_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AlWcrd_QsMQQ7kNvwHxFuNQ&_nc_oc=AdogCEzdyfBuutJzrzyG-vu8ghPtlBt_unEWeFRaIbfMibudfKT4zZsKBgB488KOWUY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7UocXvJ9SNrlRASOQJ7rzf6AA2L520eSFOY1oZobBdVQ&oe=6A05DB49"}, {"file_name": "MQVR_metaStore_ss5.png", "id": "640264872280351", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391924_640264875613684_2893261742097832448_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2AI7UbRd1Q8Q7kNvwGIQtEc&_nc_oc=AdrMDddPSap0vvk16x3CQE9o8gcXUwMyzD8z6Rzktv6H1Adxb8T92JFe8Wtpi8VArHc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6VeFfJeFPRJSssYYwGPjQxVv2fVhT3qm4botwIeGLE7w&oe=6A05D7EA"}, {"file_name": "MQVR_metaStore_ss1.png", "id": "686879277133721", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473394268_686879280467054_8709353857892239785_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1sY6Fg8085QQ7kNvwGsofcg&_nc_oc=Ado8qgfJ4iFLc5AQ3QU-vWi4rdrlg56ML-aYsoKc9mrdA7cXcZNlCcASJWDFv3MDuSI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5ryuxYYb9E_OQjXc3_MOzzzM0UdNV2nUB1VhMlCwK7rw&oe=6A05C390"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Art - 2560x1440 (1).png", "id": "681083991246799", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391986_681083994580132_5877693932550353369_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1bdquX7MIbwQ7kNvwGw_j2a&_nc_oc=AdpnBvsmDzJQyQCnYydUcQOj62XX3GKOSLYuWg_mTKgP0OcJjkNL_AcMYMhzoJrha44&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4ojjGzjIJj0q_OjoznT4twA1dxR1XvCThiOPXLtCE4JQ&oe=6A05C1B5"}, "display_name": "Math Quest VR", "keywords": ["education", "VR", "action", "singeplayer", "firstperson"], "long_description": "Math has never been this action-packed! Step into Math Quest VR, where solving problems means blasting bandits with your paintball gun. Travel through exciting worlds of Addition, Subtraction, Multiplication, and Division, unlocking new challenges along the way. Whether you're playing Story Mode to level up your skills or testing your speed in Arcade Mode, every shot brings you closer to math mastery.\n\nKey Features:\n- Solve math problems in a whole new way \u2013 aim, shoot, and answer to progress through thrilling levels.\n- Explore interactive worlds themed around Addition, Subtraction, Multiplication, and Division.\n- Choose your challenge \u2013 level up in Story Mode or race against time in Arcade Mode.\n- Sharpen your reflexes and your mind with fast-paced, brain-boosting gameplay.\n- Engage in immersive VR action that makes math fun, exciting, and rewarding.\n\nThink fast, shoot smart, and become a math legend in Math Quest VR!", "short_description": "Turn math into an adventure! Blast through interactive worlds of Addition, Subtraction, Multiplication, and Division. Play Story Mode to grow your skills or Arcade Mode for a fast-paced challenge!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://thedevhouseagency.com/Privacy_Policy_MathQuestVR.pdf", "developer_terms_of_service_url": null, "publisher_name": "Devhouse", "support_website_url": null, "website_url": "https://www.thedevhouseagency.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1043107547362485"}, {"id": "459781504968480"}, {"id": "374404007583481
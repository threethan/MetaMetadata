71-25/473392298_969006928775886_7058059946160548103_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4x0YAtb2nQEQ7kNvwHDzyco&_nc_oc=AdrZ5eCULr-dt7HmXMY90-G5Z-_uCPZoLVmBMg_uLO4jE6xA4CAVY7YQ4iNk_h_qqcM&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af40O2cD_eZnPJdVJwGVQWnuOHAYNJNxoEvrtank_g3w-A&oe=6A1AF8EF"}, {"file_name": "MQVR_metaStore_ss2.png", "id": "655824863632556", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/473391955_655824866965889_9083744742728821581_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mGFCJ1SsRbwQ7kNvwHHqAmG&_nc_oc=AdpcyFFChLql5F96hLLCK5NGsA36VYlfBFhkcdGEcOVY7Co9sKj3H4an-rGkXxRU6OA&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5EkUTr2VfE9lH2V2sJrebiV6yoZy-IWkshZL_A36zDdg&oe=6A1AF349"}, {"file_name": "MQVR_metaStore_ss5.png", "id": "640264872280351", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/473391924_640264875613684_2893261742097832448_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7KgP4P8JdhkQ7kNvwGWO4YA&_nc_oc=AdrJmKNXGcqvQMQ-7-QjFrVt5azUwrfy-7hZUB-C9beWZ3DQvbL67_LWJzn3DjZmLgA&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7s8EwY8rf66hNHTT4NKGwwtOGyVWPP1VIeGgOpdMRjtg&oe=6A1AEFEA"}, {"file_name": "MQVR_metaStore_ss1.png", "id": "686879277133721", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/473394268_686879280467054_8709353857892239785_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wV8My87cn3IQ7kNvwHBzJJj&_nc_oc=Adps-XYAPb4eaRVhChKhgV0nk_8VzurHKG3SDusrU9UJPh6abgmkwFj1_k-q4GoEYaw&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4XJaBEUVrEZVmSGednitLPWD8SIv2bBoiOxaTAb92SeQ&oe=6A1ADB90"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Art - 2560x1440 (1).png", "id": "681083991246799", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/473391986_681083994580132_5877693932550353369_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Gvrzr-2jnrIQ7kNvwGtAuPy&_nc_oc=AdpyBfDIRKvvLdH2rK42DZdnnxACy9OiyTNXaeH6qTAOQDCu3R575zqYtBTwkVJXdKo&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6hEhJlOVZpbVbMTuu40IqnrMjVd66w7OMTYB5bUCnFfA&oe=6A1AD9B5"}, "display_name": "Math Quest VR", "keywords": ["education", "VR", "action", "singeplayer", "firstperson"], "long_description": "Math has never been this action-packed! Step into Math Quest VR, where solving problems means blasting bandits with your paintball gun. Travel through exciting worlds of Addition, Subtraction, Multiplication, and Division, unlocking new challenges along the way. Whether you're playing Story Mode to level up your skills or testing your speed in Arcade Mode, every shot brings you closer to math mastery.\n\nKey Features:\n- Solve math problems in a whole new way \u2013 aim, shoot, and answer to progress through thrilling levels.\n- Explore interactive worlds themed around Addition, Subtraction, Multiplication, and Division.\n- Choose your challenge \u2013 level up in Story Mode or race against time in Arcade Mode.\n- Sharpen your reflexes and your mind with fast-paced, brain-boosting gameplay.\n- Engage in immersive VR action that makes math fun, exciting, and rewarding.\n\nThink fast, shoot smart, and become a math legend in Math Quest VR!", "short_description": "Turn math into an adventure! Blast through interactive worlds of Addition, Subtraction, Multiplication, and Division. Play Story Mode to grow your skills or Arcade Mode for a fast-paced challenge!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://thedevhouseagency.com/Privacy_Policy_MathQuestVR.pdf", "developer_terms_of_service_url": null, "publisher_name": "Devhouse", "support_website_url": null, "website_url": "https://www.thedevhouseagency.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1043107547362485"}, {"id": "459781504968480"}, {"id": "374404007583481
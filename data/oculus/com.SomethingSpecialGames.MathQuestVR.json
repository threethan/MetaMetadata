71-25/473392298_969006928775886_7058059946160548103_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ehFlyuPL5KUQ7kNvwHY_l-7&_nc_oc=Adp7tFfspyoOywKIpwlckxN_ceU2kUIfw-Ln-PXUxIk4A3t9rmvjw9M8Yhxw6s5N2Qc&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8jSKpfAIBM_Lapw1ysKDEC7LkvivlA84I66WFG4V5y7Q&oe=6A2C1C6F"}, {"file_name": "MQVR_metaStore_ss2.png", "id": "655824863632556", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/473391955_655824866965889_9083744742728821581_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-IjYCWDBL6UQ7kNvwEJH3sj&_nc_oc=AdpPhScSenOZCWRn44GAOOhtH_ucR1qic9QsC4J6lx7-s5OlIBLLWW44onmGQceYDvc&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af83n6B7uHQ70PG4H0_fw0CFYYDE0duNpG4-YOXQM47lsw&oe=6A2C16C9"}, {"file_name": "MQVR_metaStore_ss5.png", "id": "640264872280351", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/473391924_640264875613684_2893261742097832448_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EXai3-2yISMQ7kNvwGFHrPO&_nc_oc=AdoJfiOKNVro-VPI9ruejDMonMf5FzhpcdRJHYbRFrO2nh73F7HS4mzybJ3pq7ehs4M&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9CTve9Df9FBh6mEJVlDjSeFAXBv9tatP5PLTkWBgWE3A&oe=6A2C136A"}, {"file_name": "MQVR_metaStore_ss1.png", "id": "686879277133721", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/473394268_686879280467054_8709353857892239785_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VgccMgfHzKEQ7kNvwEFIpyx&_nc_oc=AdqEQwwX7esN0S4TasW0S38vgyGiB3HR3zGp9Q5J59c9KxVgtbmkP0tFbsjimaNoBvY&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-i_WgHe0EdqX1gtMaKI-VN5qd4jx6ROld38DA2st_Syw&oe=6A2BFF10"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Art - 2560x1440 (1).png", "id": "681083991246799", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/473391986_681083994580132_5877693932550353369_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=At1H-1wY1iwQ7kNvwEIZO0Y&_nc_oc=Adr1DX5zILKJTTmvhh_NJ3f-KK7UxwUOLbsumLtHrzPTxQsiqPyWNeaxWcOvejhY_ck&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9_sdpyy3G0-2ymDO52F7yAJWqRlWqH9IgIjyX0I8AgZA&oe=6A2BFD35"}, "display_name": "Math Quest VR", "keywords": ["education", "VR", "action", "singeplayer", "firstperson"], "long_description": "Math has never been this action-packed! Step into Math Quest VR, where solving problems means blasting bandits with your paintball gun. Travel through exciting worlds of Addition, Subtraction, Multiplication, and Division, unlocking new challenges along the way. Whether you're playing Story Mode to level up your skills or testing your speed in Arcade Mode, every shot brings you closer to math mastery.\n\nKey Features:\n- Solve math problems in a whole new way \u2013 aim, shoot, and answer to progress through thrilling levels.\n- Explore interactive worlds themed around Addition, Subtraction, Multiplication, and Division.\n- Choose your challenge \u2013 level up in Story Mode or race against time in Arcade Mode.\n- Sharpen your reflexes and your mind with fast-paced, brain-boosting gameplay.\n- Engage in immersive VR action that makes math fun, exciting, and rewarding.\n\nThink fast, shoot smart, and become a math legend in Math Quest VR!", "short_description": "Turn math into an adventure! Blast through interactive worlds of Addition, Subtraction, Multiplication, and Division. Play Story Mode to grow your skills or Arcade Mode for a fast-paced challenge!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://thedevhouseagency.com/Privacy_Policy_MathQuestVR.pdf", "developer_terms_of_service_url": null, "publisher_name": "Devhouse", "support_website_url": null, "website_url": "https://www.thedevhouseagency.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1043107547362485"}, {"id": "459781504968480"}, {"id": "374404007583481
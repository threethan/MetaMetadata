71-25/473392298_969006928775886_7058059946160548103_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Vr7xEdBrTUcQ7kNvwFeX6U7&_nc_oc=Adr11p3zE479-YnzKr7H1wXUDRh2jFj4Bp5YaR9D1CYR8DOSviz5c_MjyDV5YG2OOR4&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_fVjcvAzOBOIO20NC81VP1dj-f-j224h7KSvclLCr-bQ&oe=6A21906F"}, {"file_name": "MQVR_metaStore_ss2.png", "id": "655824863632556", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/473391955_655824866965889_9083744742728821581_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qfKDZgl6sMsQ7kNvwFo6hIJ&_nc_oc=Adrq_9bij0NOGv4nU-OGhPcMtbYA6ssarFrVgAGht6GbTN1LSwJSGICi5J9MoCKkm84&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-JuTJuwPsW-iPpZLOE9hGaup1_p7yvG9gTE_dbZC--TQ&oe=6A218AC9"}, {"file_name": "MQVR_metaStore_ss5.png", "id": "640264872280351", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/473391924_640264875613684_2893261742097832448_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-XfmratXKakQ7kNvwEWdg1B&_nc_oc=AdokhQKM5Y2rFWnyUUrBRUgoia7pNMq7XQfSyi_sHLAehFBOG6AvUbGZUuXrVEJ73kw&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-EMbfJDRjQ6_ZBToValXoEVHzSJBdeby5wRqy7wLJU5w&oe=6A21876A"}, {"file_name": "MQVR_metaStore_ss1.png", "id": "686879277133721", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/473394268_686879280467054_8709353857892239785_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LcEEV_2WjMAQ7kNvwEeR8Am&_nc_oc=Adr5-3USDd4RUVu2gPmXzVPnyL7du7e7Y6GZLAF06BwfxzGiL_9BgqS-NB7-YTTyNfo&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_J3vJSKCUwL2oNLkSZSDl1vcKRFoffEaXDJe9b4TcwKA&oe=6A217310"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Art - 2560x1440 (1).png", "id": "681083991246799", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/473391986_681083994580132_5877693932550353369_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OEKYQ0IybMYQ7kNvwGXFL1z&_nc_oc=Adp1ek7a4h1yeHIq3AJ7hkSGxUmuu-hLqGVDDkvo-Aky94GLHBnmmrgjyVzPr3JcJP0&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-HqlWZ5nuZds1nyswBt65v9VAN_KnZpbwqoKmYUIKqOg&oe=6A217135"}, "display_name": "Math Quest VR", "keywords": ["education", "VR", "action", "singeplayer", "firstperson"], "long_description": "Math has never been this action-packed! Step into Math Quest VR, where solving problems means blasting bandits with your paintball gun. Travel through exciting worlds of Addition, Subtraction, Multiplication, and Division, unlocking new challenges along the way. Whether you're playing Story Mode to level up your skills or testing your speed in Arcade Mode, every shot brings you closer to math mastery.\n\nKey Features:\n- Solve math problems in a whole new way \u2013 aim, shoot, and answer to progress through thrilling levels.\n- Explore interactive worlds themed around Addition, Subtraction, Multiplication, and Division.\n- Choose your challenge \u2013 level up in Story Mode or race against time in Arcade Mode.\n- Sharpen your reflexes and your mind with fast-paced, brain-boosting gameplay.\n- Engage in immersive VR action that makes math fun, exciting, and rewarding.\n\nThink fast, shoot smart, and become a math legend in Math Quest VR!", "short_description": "Turn math into an adventure! Blast through interactive worlds of Addition, Subtraction, Multiplication, and Division. Play Story Mode to grow your skills or Arcade Mode for a fast-paced challenge!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://thedevhouseagency.com/Privacy_Policy_MathQuestVR.pdf", "developer_terms_of_service_url": null, "publisher_name": "Devhouse", "support_website_url": null, "website_url": "https://www.thedevhouseagency.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1043107547362485"}, {"id": "459781504968480"}, {"id": "374404007583481
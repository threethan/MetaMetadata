71-25/473392298_969006928775886_7058059946160548103_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JAcI3Yq9fecQ7kNvwEgPZxU&_nc_oc=AdrtnhRWEkYlfTpq_EydqdSPYZATLWNYzBiEKDZrLmTsWgeQOcn-Herp0Urj0eT55Q8&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_LBFE8OP2jcgKaVQ2joDj851Nwee7CsaycQ3lyLs1bLQ&oe=6A3010EF"}, {"file_name": "MQVR_metaStore_ss2.png", "id": "655824863632556", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/473391955_655824866965889_9083744742728821581_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eXF8vfxcJkoQ7kNvwF4AbvQ&_nc_oc=AdqmVyDtqaQVJOHpXH0J19TyPBi5iuj44IWAj7k6xJMNzO_dPEK-MlRKwcTCGUp5IxQ&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af88D6-TSS82sOPXnS7U9S8_anTHRY1T6Rb-8H-6OyYieQ&oe=6A300B49"}, {"file_name": "MQVR_metaStore_ss5.png", "id": "640264872280351", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/473391924_640264875613684_2893261742097832448_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_loDNkYR5bgQ7kNvwH0Zgy0&_nc_oc=Adoo93JJ7jffh0zSG5P7qqFX3fwVpIFudMhlOmTj19OEjRkhtDd47w0EMP2PzBAR5LM&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9_QXtT-jU9LDXQ0OkZP9n2Km_UQSfrYEySgITtNRdxiA&oe=6A3007EA"}, {"file_name": "MQVR_metaStore_ss1.png", "id": "686879277133721", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/473394268_686879280467054_8709353857892239785_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DwDO1H_aX3oQ7kNvwH5yySZ&_nc_oc=Adr8fhnKrmuPSvUMPnFQI5jwaeexbMxTyZD9-K6lcvIkd03RBevov5vFkPzZCWeiW_U&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_dUIFruBA9C2YUvKnagzh-qZFF9Y8v9c8Jg0Mt3XSmXg&oe=6A2FF390"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Art - 2560x1440 (1).png", "id": "681083991246799", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/473391986_681083994580132_5877693932550353369_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JnB5_QT1AOEQ7kNvwGLSer0&_nc_oc=AdqebUknPTvJEJVDGGebBWAQtXUvL3fmZ5hwfpm8gcTyfeVd1zreVLhDvBHu2lg5cmg&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_aDpcKjYEZYi8kA_WyXZtUFvQezndmpDs_pTWVNV22gw&oe=6A2FF1B5"}, "display_name": "Math Quest VR", "keywords": ["education", "VR", "action", "singeplayer", "firstperson"], "long_description": "Math has never been this action-packed! Step into Math Quest VR, where solving problems means blasting bandits with your paintball gun. Travel through exciting worlds of Addition, Subtraction, Multiplication, and Division, unlocking new challenges along the way. Whether you're playing Story Mode to level up your skills or testing your speed in Arcade Mode, every shot brings you closer to math mastery.\n\nKey Features:\n- Solve math problems in a whole new way \u2013 aim, shoot, and answer to progress through thrilling levels.\n- Explore interactive worlds themed around Addition, Subtraction, Multiplication, and Division.\n- Choose your challenge \u2013 level up in Story Mode or race against time in Arcade Mode.\n- Sharpen your reflexes and your mind with fast-paced, brain-boosting gameplay.\n- Engage in immersive VR action that makes math fun, exciting, and rewarding.\n\nThink fast, shoot smart, and become a math legend in Math Quest VR!", "short_description": "Turn math into an adventure! Blast through interactive worlds of Addition, Subtraction, Multiplication, and Division. Play Story Mode to grow your skills or Arcade Mode for a fast-paced challenge!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://thedevhouseagency.com/Privacy_Policy_MathQuestVR.pdf", "developer_terms_of_service_url": null, "publisher_name": "Devhouse", "support_website_url": null, "website_url": "https://www.thedevhouseagency.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1043107547362485"}, {"id": "459781504968480"}, {"id": "374404007583481
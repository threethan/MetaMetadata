71-25/473392298_969006928775886_7058059946160548103_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rOajW99m4c8Q7kNvwEGroz4&_nc_oc=AdolzuXoHFYcSA5JsU_eB8duiyN8V_HFtm7a9cXF7Nf75j5okt1p3CzyQ09DWwqc3QQ&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0d_KS1sdR5gMCw1E-WEqkqyPqRdfME-Ewk070WcHANMA&oe=69EF776F"}, {"file_name": "MQVR_metaStore_ss2.png", "id": "655824863632556", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/473391955_655824866965889_9083744742728821581_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d0HJ2DjV_dEQ7kNvwHx41wJ&_nc_oc=Adqo69kWHNb4nfAhaTkyAb5TJE73anDCdkrjOsyT4TGobjrxvjecZlV7LmXjKN-33H4&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3Pn5QP3XY7HrmgMc8Q-KvOMkvhN2ySH6m0T0qOx4AABg&oe=69EF71C9"}, {"file_name": "MQVR_metaStore_ss5.png", "id": "640264872280351", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/473391924_640264875613684_2893261742097832448_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7fRtLL7XxC0Q7kNvwH_-YVl&_nc_oc=AdoX1cMuUjeDErUlC4ENY9oI6pCtVH4VVzznI1WMgDZb-COgYUH_TytbwFLuY0GVj4c&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1B2XpeAk4DX6u_OtH8bHOKrXB0ybMOOfBE4jHnHc2yJQ&oe=69EF6E6A"}, {"file_name": "MQVR_metaStore_ss1.png", "id": "686879277133721", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/473394268_686879280467054_8709353857892239785_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L9A-u06HlR0Q7kNvwGXOhr-&_nc_oc=Adq370vltiYn7UVnWQ7vW-UKRW0-eBRlmrEDKKq0fxhstDPNRsNcjeOmxu6Wy4BL2lM&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1JpOnZ4qwBGmC8jlhZ6dmc7DapunFTvAUngk4PaaRVZg&oe=69EF5A10"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Art - 2560x1440 (1).png", "id": "681083991246799", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/473391986_681083994580132_5877693932550353369_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AXnIW1GSvV0Q7kNvwGJN3TR&_nc_oc=AdrXepCk9eH_lX3RTMgCmMwZ1mXh3ELPP0xacXas3TGJD6eCytb6j3iy6CLF4cusKSc&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0wCm92gYTURkw18Ecdrk3knyqTl3YKQ4IixRd1uz_QhQ&oe=69EF5835"}, "display_name": "Math Quest VR", "keywords": ["education", "VR", "action", "singeplayer", "firstperson"], "long_description": "Math has never been this action-packed! Step into Math Quest VR, where solving problems means blasting bandits with your paintball gun. Travel through exciting worlds of Addition, Subtraction, Multiplication, and Division, unlocking new challenges along the way. Whether you're playing Story Mode to level up your skills or testing your speed in Arcade Mode, every shot brings you closer to math mastery.\n\nKey Features:\n- Solve math problems in a whole new way \u2013 aim, shoot, and answer to progress through thrilling levels.\n- Explore interactive worlds themed around Addition, Subtraction, Multiplication, and Division.\n- Choose your challenge \u2013 level up in Story Mode or race against time in Arcade Mode.\n- Sharpen your reflexes and your mind with fast-paced, brain-boosting gameplay.\n- Engage in immersive VR action that makes math fun, exciting, and rewarding.\n\nThink fast, shoot smart, and become a math legend in Math Quest VR!", "short_description": "Turn math into an adventure! Blast through interactive worlds of Addition, Subtraction, Multiplication, and Division. Play Story Mode to grow your skills or Arcade Mode for a fast-paced challenge!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://thedevhouseagency.com/Privacy_Policy_MathQuestVR.pdf", "developer_terms_of_service_url": null, "publisher_name": "Devhouse", "support_website_url": null, "website_url": "https://www.thedevhouseagency.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1043107547362485"}, {"id": "459781504968480"}, {"id": "374404007583481
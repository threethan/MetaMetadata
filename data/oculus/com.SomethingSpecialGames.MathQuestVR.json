71-25/473392298_969006928775886_7058059946160548103_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mUS5_H1VzqkQ7kNvwE5vjSR&_nc_oc=AdoSuyF-WNiFFlLVGNJN8RjYNkUVcAvOKrRDssXGDHtQQlPmeHyUL_veRF7xN7HBXaQ&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQItlNjeUdEgSIj9yLQzTrdInVZcNC8SZe_1AdWSfVgVnA&oe=6A9D7D6F"}, {"file_name": "MQVR_metaStore_ss2.png", "id": "655824863632556", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391955_655824866965889_9083744742728821581_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_J_t-7wUZbwQ7kNvwERyENL&_nc_oc=AdqynjqMMeYkrXgNpo7ZCNun6UaTuAMZIxDPtByfvOWTvuU5Bdg7BVmzzE78z17izvw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI11Gxnn64s-QKoLSncLXGTNiFVzt-8GHiNDyyZAwZOGA&oe=6A9D77C9"}, {"file_name": "MQVR_metaStore_ss5.png", "id": "640264872280351", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391924_640264875613684_2893261742097832448_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Wwfd5FlMYSgQ7kNvwEjgn8N&_nc_oc=AdrRh7b98P4hgnGXs1WFcD7d846U1uBpqsz0pyhl9K44zgXBjvYkXX6uFWyu0HsEZ0M&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIYtX9meGgQXTUNuqr0MTmnjysEggX3Xup0Eo18W3TA4Q&oe=6A9D746A"}, {"file_name": "MQVR_metaStore_ss1.png", "id": "686879277133721", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473394268_686879280467054_8709353857892239785_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YeUcAt_xscEQ7kNvwFEHgGe&_nc_oc=AdpkOP32YA-hGuUfbJcFIQg93hFBWuy0aOSdvxa6NUaP-Xb-b5TDQyqez30O1a47L80&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKORonincPkmlLLS21ej0iMZnJ-cu3ls7Ft97JxunAmiA&oe=6A9D6010"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Art - 2560x1440 (1).png", "id": "681083991246799", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391986_681083994580132_5877693932550353369_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EM8KWBT71-YQ7kNvwH5sjKf&_nc_oc=AdpaVv9j1pPAMxwt4t0XiP3BIQdoSKTTy3AGITCi781SPZ2ND6KwZCWQu4Ry2CjAFQs&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI76AoC3zwbty2Apid-KjS5v_qpjvP8AIGhKqDkx4_GGw&oe=6A9D5E35"}, "display_name": "Math Quest VR", "keywords": ["education", "VR", "action", "singeplayer", "firstperson"], "long_description": "Math has never been this action-packed! Step into Math Quest VR, where solving problems means blasting bandits with your paintball gun. Travel through exciting worlds of Addition, Subtraction, Multiplication, and Division, unlocking new challenges along the way. Whether you're playing Story Mode to level up your skills or testing your speed in Arcade Mode, every shot brings you closer to math mastery.\n\nKey Features:\n- Solve math problems in a whole new way \u2013 aim, shoot, and answer to progress through thrilling levels.\n- Explore interactive worlds themed around Addition, Subtraction, Multiplication, and Division.\n- Choose your challenge \u2013 level up in Story Mode or race against time in Arcade Mode.\n- Sharpen your reflexes and your mind with fast-paced, brain-boosting gameplay.\n- Engage in immersive VR action that makes math fun, exciting, and rewarding.\n\nThink fast, shoot smart, and become a math legend in Math Quest VR!", "short_description": "Turn math into an adventure! Blast through interactive worlds of Addition, Subtraction, Multiplication, and Division. Play Story Mode to grow your skills or Arcade Mode for a fast-paced challenge!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://thedevhouseagency.com/Privacy_Policy_MathQuestVR.pdf", "developer_terms_of_service_url": null, "publisher_name": "Devhouse", "support_website_url": null, "website_url": "https://www.thedevhouseagency.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1043107547362485"}, {"id": "459781504968480"}, {"id": "374404007583481
71-25/473392298_969006928775886_7058059946160548103_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6LZ3aXFqYXMQ7kNvwFEFQu5&_nc_oc=Adq-uHLkbeujiPZRuwDFUsCpJpRpsqVeeGPEECKX58ieissLH4gtXFkzPG-p5MXOBOE&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-nDD5Cg9nGxVr3CPUgBm3gCspijrUergmufbUt_LT1gQ&oe=6A26D66F"}, {"file_name": "MQVR_metaStore_ss2.png", "id": "655824863632556", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/473391955_655824866965889_9083744742728821581_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2NLstEUjyScQ7kNvwFdwByZ&_nc_oc=Adrzi-2JFlTRgsWWqLbylyZ1aLUwzGTlT-1Q0CzsWGpuwEcFouLT8xVLznjKNVj_FlM&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9EfUwxB1NIp951f2ZsrnAjUV5156xQBAOmbwt_4XSwRA&oe=6A26D0C9"}, {"file_name": "MQVR_metaStore_ss5.png", "id": "640264872280351", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/473391924_640264875613684_2893261742097832448_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b_ZZ-su5rv8Q7kNvwEt2hXA&_nc_oc=AdpdWNTy1jSTPeEn0p0TiTDgaD8gWSzu1wM6fT7sTKdZmKQBRY3lsMoYv40r6iKupXk&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_gIGcw96KcHwOZsn-Nd52XOc4Jco52D-5knqpLQKbYGg&oe=6A26CD6A"}, {"file_name": "MQVR_metaStore_ss1.png", "id": "686879277133721", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/473394268_686879280467054_8709353857892239785_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y27hSbvX-V8Q7kNvwG85GFt&_nc_oc=AdoXPqCqsoOulaTg03fV2lJ5oqhRnsdjD9URL9NwVNaOom-Mv7xQajteKNA1XRSwcWY&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8nfP_XwysvlF9XoUDaAT0vud7FRk9cb2fVRvkfqM18xw&oe=6A26B910"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Art - 2560x1440 (1).png", "id": "681083991246799", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/473391986_681083994580132_5877693932550353369_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ww8kTZenaOEQ7kNvwEjvv4s&_nc_oc=AdqgqCDY1ZGSGwx6Ea15WEzgedX1eweFdnkppxOG5XlOz-QiM0rBnyreiBCJjU5NO1s&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_pE71mdE-OVqFoz38HQ6ej-LPNO7Y_mVrc-6PdEO8W9w&oe=6A26EF75"}, "display_name": "Math Quest VR", "keywords": ["education", "VR", "action", "singeplayer", "firstperson"], "long_description": "Math has never been this action-packed! Step into Math Quest VR, where solving problems means blasting bandits with your paintball gun. Travel through exciting worlds of Addition, Subtraction, Multiplication, and Division, unlocking new challenges along the way. Whether you're playing Story Mode to level up your skills or testing your speed in Arcade Mode, every shot brings you closer to math mastery.\n\nKey Features:\n- Solve math problems in a whole new way \u2013 aim, shoot, and answer to progress through thrilling levels.\n- Explore interactive worlds themed around Addition, Subtraction, Multiplication, and Division.\n- Choose your challenge \u2013 level up in Story Mode or race against time in Arcade Mode.\n- Sharpen your reflexes and your mind with fast-paced, brain-boosting gameplay.\n- Engage in immersive VR action that makes math fun, exciting, and rewarding.\n\nThink fast, shoot smart, and become a math legend in Math Quest VR!", "short_description": "Turn math into an adventure! Blast through interactive worlds of Addition, Subtraction, Multiplication, and Division. Play Story Mode to grow your skills or Arcade Mode for a fast-paced challenge!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://thedevhouseagency.com/Privacy_Policy_MathQuestVR.pdf", "developer_terms_of_service_url": null, "publisher_name": "Devhouse", "support_website_url": null, "website_url": "https://www.thedevhouseagency.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1043107547362485"}, {"id": "459781504968480"}, {"id": "374404007583481
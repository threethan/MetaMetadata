71-25/473392298_969006928775886_7058059946160548103_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i9t4Qg_A2osQ7kNvwFjcH-J&_nc_oc=AdrSo0Neeuff89DiThXgEqIZs96cnGBMQXF7HlJkOOD7T0RxLa1gIUfdlMm9Edsm2l8&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM8_ZlyaJBPZUtBORK4V5Pty7vdSICI24QjGniYeNPnRg&oe=6AE35CEF"}, {"file_name": "MQVR_metaStore_ss2.png", "id": "655824863632556", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/473391955_655824866965889_9083744742728821581_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9wlAjjh61f0Q7kNvwHAaUEe&_nc_oc=Adq53dWimHs3DYNoNW_0wfdIzUiIcc8M2EFZn7DjEGzX3_DMTlNR1xn9qUE-qnnoz9A&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMVDqFijB9Pn4ECiT9ptlJYukXcpUBd7LdmMcleW3baiA&oe=6AE35749"}, {"file_name": "MQVR_metaStore_ss5.png", "id": "640264872280351", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/473391924_640264875613684_2893261742097832448_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n699PRa2Pp0Q7kNvwFDRQ5T&_nc_oc=AdoWs6CC2YlrIHSsa7zJV2C_0uj44qRYjGi9jPyWN-BZDtYEDlfsiD48CpvGrYHxz4I&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP-kI4e1Uk03dt9aX0UWTkBI9wZg9DspF17kXE71jBzjQ&oe=6AE353EA"}, {"file_name": "MQVR_metaStore_ss1.png", "id": "686879277133721", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/473394268_686879280467054_8709353857892239785_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8bcVxzztepUQ7kNvwHIiPXi&_nc_oc=AdqnjhzCKYENNDVpFnWRXM8N0VR-ECjaACmNrAcOt823tqPwjJKp5cXXj9wCn9jHy4c&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM9BUEKw5wrnBeYOD-kU5jrCU2vyc7SUGIZTgU-mPSZJw&oe=6AE33F90"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Art - 2560x1440 (1).png", "id": "681083991246799", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/473391986_681083994580132_5877693932550353369_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IwrqvBfZi68Q7kNvwF4ZvNW&_nc_oc=AdoG3c01Y8EQTx9-fIS0pKLEg14EtTD6YyqXmsSbHT6hVxszRoiWLY9gNuw70hjDr28&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMB5KRVPuko5aCFMGQOh8wBqkjN65Z_FpTR12o9RJiAEg&oe=6AE33DB5"}, "display_name": "Math Quest VR", "keywords": ["education", "VR", "action", "singeplayer", "firstperson"], "long_description": "Math has never been this action-packed! Step into Math Quest VR, where solving problems means blasting bandits with your paintball gun. Travel through exciting worlds of Addition, Subtraction, Multiplication, and Division, unlocking new challenges along the way. Whether you're playing Story Mode to level up your skills or testing your speed in Arcade Mode, every shot brings you closer to math mastery.\n\nKey Features:\n- Solve math problems in a whole new way \u2013 aim, shoot, and answer to progress through thrilling levels.\n- Explore interactive worlds themed around Addition, Subtraction, Multiplication, and Division.\n- Choose your challenge \u2013 level up in Story Mode or race against time in Arcade Mode.\n- Sharpen your reflexes and your mind with fast-paced, brain-boosting gameplay.\n- Engage in immersive VR action that makes math fun, exciting, and rewarding.\n\nThink fast, shoot smart, and become a math legend in Math Quest VR!", "short_description": "Turn math into an adventure! Blast through interactive worlds of Addition, Subtraction, Multiplication, and Division. Play Story Mode to grow your skills or Arcade Mode for a fast-paced challenge!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://thedevhouseagency.com/Privacy_Policy_MathQuestVR.pdf", "developer_terms_of_service_url": null, "publisher_name": "Devhouse", "support_website_url": null, "website_url": "https://www.thedevhouseagency.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1043107547362485"}, {"id": "459781504968480"}, {"id": "374404007583481
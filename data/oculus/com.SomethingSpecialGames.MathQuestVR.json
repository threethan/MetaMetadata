71-25/473392298_969006928775886_7058059946160548103_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C3T_EkLS2hkQ7kNvwE4LFJd&_nc_oc=AdomnhqVRARXWKCA8XwmgpRFdte3Rx4kpTRVtEFqt_6AsjHHcDKPboRMloXXecnBiPI&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRD9tVVscha-LSpQW6yLNZaAfOf9f1AXi4jnvhhYybTNg&oe=6AE8A2EF"}, {"file_name": "MQVR_metaStore_ss2.png", "id": "655824863632556", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/473391955_655824866965889_9083744742728821581_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IM_M_c_zjTQQ7kNvwEdN2Gf&_nc_oc=AdolQK-58A6eq4_WuTHaPM0m8J561JlO95Yyu6IjtJVLCmVMVqzsEhKnBbOCwtRPP4Y&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQvl80HuCOuRlgjMSKNCBBpcMg9wmBnF4nbE5dfWOC9Mw&oe=6AE89D49"}, {"file_name": "MQVR_metaStore_ss5.png", "id": "640264872280351", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/473391924_640264875613684_2893261742097832448_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iiPiWDgmOvoQ7kNvwGAu-0Z&_nc_oc=Adrm0FS1_hy2FUcb2qp3av9C-KSSyMWeZpbjTQ_P8win2KTKn-7zcxIa80lSCHUkEok&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT5JZj5kVaggvjmZlLJyT-g7tHm8-bAbpzHz1d6LOJKMg&oe=6AE899EA"}, {"file_name": "MQVR_metaStore_ss1.png", "id": "686879277133721", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/473394268_686879280467054_8709353857892239785_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bmpp08bFICkQ7kNvwFbIZB6&_nc_oc=Adqzm__ZSGuH-B_cZXB5pY46Le0U3gTFS-PnCR1Dd0Dletn4ziMuiVkwo0civG4qHkI&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTaLtxT9JCF8CjTj3zTljKajJXu4_p1WbvqQS_KHl9j7Q&oe=6AE8BDD0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Art - 2560x1440 (1).png", "id": "681083991246799", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/473391986_681083994580132_5877693932550353369_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A_QwRqlaDakQ7kNvwH-HLRH&_nc_oc=Adq6QLVR7ZUipU4BybQ8sVu09feF4_N8bxMw9m8kMUydj-HTLEf-Gw9QIsrNFlPUP5Y&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTDeCviXZH8vLkQkXNWV1f_ODbpldIWH26hjXDtnC82ig&oe=6AE8BBF5"}, "display_name": "Math Quest VR", "keywords": ["education", "VR", "action", "singeplayer", "firstperson"], "long_description": "Math has never been this action-packed! Step into Math Quest VR, where solving problems means blasting bandits with your paintball gun. Travel through exciting worlds of Addition, Subtraction, Multiplication, and Division, unlocking new challenges along the way. Whether you're playing Story Mode to level up your skills or testing your speed in Arcade Mode, every shot brings you closer to math mastery.\n\nKey Features:\n- Solve math problems in a whole new way \u2013 aim, shoot, and answer to progress through thrilling levels.\n- Explore interactive worlds themed around Addition, Subtraction, Multiplication, and Division.\n- Choose your challenge \u2013 level up in Story Mode or race against time in Arcade Mode.\n- Sharpen your reflexes and your mind with fast-paced, brain-boosting gameplay.\n- Engage in immersive VR action that makes math fun, exciting, and rewarding.\n\nThink fast, shoot smart, and become a math legend in Math Quest VR!", "short_description": "Turn math into an adventure! Blast through interactive worlds of Addition, Subtraction, Multiplication, and Division. Play Story Mode to grow your skills or Arcade Mode for a fast-paced challenge!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://thedevhouseagency.com/Privacy_Policy_MathQuestVR.pdf", "developer_terms_of_service_url": null, "publisher_name": "Devhouse", "support_website_url": null, "website_url": "https://www.thedevhouseagency.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1043107547362485"}, {"id": "459781504968480"}, {"id": "374404007583481
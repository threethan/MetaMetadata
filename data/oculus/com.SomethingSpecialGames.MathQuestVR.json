71-25/473392298_969006928775886_7058059946160548103_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A5vaLoi1Hl4Q7kNvwETD5zR&_nc_oc=Adr71sGBo8hmfTyYSoZMps0bEtNs8WW6PpFrjjoGvW61tfDoBncLuDyiOcHLYoABtkg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMwAXkogsGD8hT9me_6rAkWT23RiH_BIFSfEAp9j_JFdw&oe=6ACBA1EF"}, {"file_name": "MQVR_metaStore_ss2.png", "id": "655824863632556", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473391955_655824866965889_9083744742728821581_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Oz3OzXFhonsQ7kNvwGFzwPD&_nc_oc=Adr7u26V4UF2agM5kJqXolNPAmL_oAqtX6hKv2k-3kfQfZF6FPUq6XRnuFgr-K5KzFk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPcJRQg5ls5YWGML5ST13EjQILSbpDL7FbEnSiySIKH5Q&oe=6ACB9C49"}, {"file_name": "MQVR_metaStore_ss5.png", "id": "640264872280351", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473391924_640264875613684_2893261742097832448_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WFemcvHb7BMQ7kNvwFaRGdo&_nc_oc=AdqNCGvFeST0MVevrm7m1TuzvRWEXPQmAAKb-QANJOy8SIS6mFg7L3OqP1jY061ov3w&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPsZ4BuTQjoTK3Lc95WEmO0GwNe9KjutTL1u-BcZ1MLMw&oe=6ACB98EA"}, {"file_name": "MQVR_metaStore_ss1.png", "id": "686879277133721", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473394268_686879280467054_8709353857892239785_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VccAUR23Gp0Q7kNvwH6j5Uf&_nc_oc=Adpw8PK5QqybdRdKZA_eNK0bg_KDPCGsYeTen6nMeCvRNVBmPiU6DLDgECcGTFWqJqE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMDGkzaVn_1LexYMfEHwy-3n1jkxj1NRs1L0_1NSfojIg&oe=6ACBBCD0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Art - 2560x1440 (1).png", "id": "681083991246799", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473391986_681083994580132_5877693932550353369_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MIZoB2Po4pMQ7kNvwFsxKba&_nc_oc=Adr0hAO9fY9U0wFtdQc_l_-oiC9loTzVgrGcjGejapu-_rUlfH6Z7Nvk4ibk0Ec_AmI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOkSITvXXmVGI8nuG0f60KNXZAvF3JWbbswa9rput-lIw&oe=6ACBBAF5"}, "display_name": "Math Quest VR", "keywords": ["education", "VR", "action", "singeplayer", "firstperson"], "long_description": "Math has never been this action-packed! Step into Math Quest VR, where solving problems means blasting bandits with your paintball gun. Travel through exciting worlds of Addition, Subtraction, Multiplication, and Division, unlocking new challenges along the way. Whether you're playing Story Mode to level up your skills or testing your speed in Arcade Mode, every shot brings you closer to math mastery.\n\nKey Features:\n- Solve math problems in a whole new way \u2013 aim, shoot, and answer to progress through thrilling levels.\n- Explore interactive worlds themed around Addition, Subtraction, Multiplication, and Division.\n- Choose your challenge \u2013 level up in Story Mode or race against time in Arcade Mode.\n- Sharpen your reflexes and your mind with fast-paced, brain-boosting gameplay.\n- Engage in immersive VR action that makes math fun, exciting, and rewarding.\n\nThink fast, shoot smart, and become a math legend in Math Quest VR!", "short_description": "Turn math into an adventure! Blast through interactive worlds of Addition, Subtraction, Multiplication, and Division. Play Story Mode to grow your skills or Arcade Mode for a fast-paced challenge!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://thedevhouseagency.com/Privacy_Policy_MathQuestVR.pdf", "developer_terms_of_service_url": null, "publisher_name": "Devhouse", "support_website_url": null, "website_url": "https://www.thedevhouseagency.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1043107547362485"}, {"id": "459781504968480"}, {"id": "374404007583481
71-25/473392298_969006928775886_7058059946160548103_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mUS5_H1VzqkQ7kNvwEdX62-&_nc_oc=Adp7gggtY8MWQ72mfFHQUJTkS8sxOgCpH2sbPurf8tkyFrUmkQh3ZB7aTDKgKgO5bjU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJhc_HUhjnba0JT6LV4fDHvxAYL7J3xal49bgH8572U0Q&oe=6A9ECEEF"}, {"file_name": "MQVR_metaStore_ss2.png", "id": "655824863632556", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391955_655824866965889_9083744742728821581_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_J_t-7wUZbwQ7kNvwEkFJ7l&_nc_oc=Adqws3XmcEdcWUYO_pDzMKeBbw__aa9mJmSna4jtM8lGyqpQzsylBYwAYNKS2CEdLjM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIBd5vURYKUOqDS7QrAberzqNml-_rjTgPI0_YqLI0hRg&oe=6A9EC949"}, {"file_name": "MQVR_metaStore_ss5.png", "id": "640264872280351", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391924_640264875613684_2893261742097832448_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Wwfd5FlMYSgQ7kNvwGSa6RN&_nc_oc=AdosSlN9V41TSgLO5EiOdck_w5-xvYN1844VRCeseSDAFWxQkEIlvXqnCYmlktLBPNM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIsxYT4uY4MaMOhR1QDLLHzZ35ShXGzp6REUgoF1QlXIg&oe=6A9EC5EA"}, {"file_name": "MQVR_metaStore_ss1.png", "id": "686879277133721", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473394268_686879280467054_8709353857892239785_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YeUcAt_xscEQ7kNvwHG_fZ1&_nc_oc=AdrY-iIj0gtU5CVRoNB_60ftRT3V_0VoISu6TofksQE8YRlISPUQkrFGjgIM9VY7zzI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLEKa69pspFwQBLlVwNhhRnCMri7ZkcwpCFsxDMOkf8BA&oe=6A9EB190"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Art - 2560x1440 (1).png", "id": "681083991246799", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391986_681083994580132_5877693932550353369_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EM8KWBT71-YQ7kNvwHG5B8p&_nc_oc=Adru1MjgSWPaWDZS8wjUyyZNl6Pg2MzKxlFrt6wj9xAVXX2_C8-5MCQ3KKn49TOcAc4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLYJmSN9UGIavZeZGqjUMtsc-lpLC1VlV3zlND2Afh1BA&oe=6A9EAFB5"}, "display_name": "Math Quest VR", "keywords": ["education", "VR", "action", "singeplayer", "firstperson"], "long_description": "Math has never been this action-packed! Step into Math Quest VR, where solving problems means blasting bandits with your paintball gun. Travel through exciting worlds of Addition, Subtraction, Multiplication, and Division, unlocking new challenges along the way. Whether you're playing Story Mode to level up your skills or testing your speed in Arcade Mode, every shot brings you closer to math mastery.\n\nKey Features:\n- Solve math problems in a whole new way \u2013 aim, shoot, and answer to progress through thrilling levels.\n- Explore interactive worlds themed around Addition, Subtraction, Multiplication, and Division.\n- Choose your challenge \u2013 level up in Story Mode or race against time in Arcade Mode.\n- Sharpen your reflexes and your mind with fast-paced, brain-boosting gameplay.\n- Engage in immersive VR action that makes math fun, exciting, and rewarding.\n\nThink fast, shoot smart, and become a math legend in Math Quest VR!", "short_description": "Turn math into an adventure! Blast through interactive worlds of Addition, Subtraction, Multiplication, and Division. Play Story Mode to grow your skills or Arcade Mode for a fast-paced challenge!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://thedevhouseagency.com/Privacy_Policy_MathQuestVR.pdf", "developer_terms_of_service_url": null, "publisher_name": "Devhouse", "support_website_url": null, "website_url": "https://www.thedevhouseagency.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1043107547362485"}, {"id": "459781504968480"}, {"id": "374404007583481
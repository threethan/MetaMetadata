71-25/473392298_969006928775886_7058059946160548103_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0TPy3vhudagQ7kNvwHkfnWd&_nc_oc=AdrGAv5HECpRnSGGW4tHhqBIY6i6crEn7wdB9KberbKiVIz51JnegRJqNHcvBAVQOJc&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOQbh_EcgF4uyuruwT4eL298-Yb4sYShxmK3FdTl6ojuA&oe=6AD38AEF"}, {"file_name": "MQVR_metaStore_ss2.png", "id": "655824863632556", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/473391955_655824866965889_9083744742728821581_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_6St6CMSmLIQ7kNvwFqKR5S&_nc_oc=Adrk5jORfHzaxfIiWaJWqw1QBDqe8phg6HFPuQKUI2TyrXm3wSDYqgUhA2l-1vMg33o&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMgepz0IVFF6-EPr63AIjw5AHEoCQqbIyZ7s3KU6Gn6dQ&oe=6AD38549"}, {"file_name": "MQVR_metaStore_ss5.png", "id": "640264872280351", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/473391924_640264875613684_2893261742097832448_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VHz-arp5OMQQ7kNvwFYP3TU&_nc_oc=Adr2g9ywC6VE7jUKcdONFjEMmi_b-Fh13hDAWWMjKoDufZ2yTJhhr4_uvoJmkIKIP5k&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPOQiPWrsdyuyATWmuyG-eVkRlVHEyiR_1RpqzkOJEX_Q&oe=6AD3BA2A"}, {"file_name": "MQVR_metaStore_ss1.png", "id": "686879277133721", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/473394268_686879280467054_8709353857892239785_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TZJCrAyynIsQ7kNvwFUs7rk&_nc_oc=Adp4lx6DNWjWFI1CISxkEY90vkfHypOfn6mWPOYzyUZOW6TUjXEtm3J9tfAK9xsuujo&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM2asQkrhEz1W537QSOddtS5iFRMkfj26xlu4U7Y8ciLg&oe=6AD3A5D0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Art - 2560x1440 (1).png", "id": "681083991246799", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/473391986_681083994580132_5877693932550353369_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oqpXMl951wIQ7kNvwEBrDxO&_nc_oc=AdreIW7rOCxNCGd0aRkIKfSzqzOs_GtHSGkAWIehIHIxzCM7b2Td7WiS-A_TwsMlUaY&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMyU3cld8p9LRGIaDZs_PnBNlaxKzfKMyFSgk-18c1BKA&oe=6AD3A3F5"}, "display_name": "Math Quest VR", "keywords": ["education", "VR", "action", "singeplayer", "firstperson"], "long_description": "Math has never been this action-packed! Step into Math Quest VR, where solving problems means blasting bandits with your paintball gun. Travel through exciting worlds of Addition, Subtraction, Multiplication, and Division, unlocking new challenges along the way. Whether you're playing Story Mode to level up your skills or testing your speed in Arcade Mode, every shot brings you closer to math mastery.\n\nKey Features:\n- Solve math problems in a whole new way \u2013 aim, shoot, and answer to progress through thrilling levels.\n- Explore interactive worlds themed around Addition, Subtraction, Multiplication, and Division.\n- Choose your challenge \u2013 level up in Story Mode or race against time in Arcade Mode.\n- Sharpen your reflexes and your mind with fast-paced, brain-boosting gameplay.\n- Engage in immersive VR action that makes math fun, exciting, and rewarding.\n\nThink fast, shoot smart, and become a math legend in Math Quest VR!", "short_description": "Turn math into an adventure! Blast through interactive worlds of Addition, Subtraction, Multiplication, and Division. Play Story Mode to grow your skills or Arcade Mode for a fast-paced challenge!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://thedevhouseagency.com/Privacy_Policy_MathQuestVR.pdf", "developer_terms_of_service_url": null, "publisher_name": "Devhouse", "support_website_url": null, "website_url": "https://www.thedevhouseagency.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1043107547362485"}, {"id": "459781504968480"}, {"id": "374404007583481
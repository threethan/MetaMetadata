71-25/473392298_969006928775886_7058059946160548103_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EZWefnAdhtQQ7kNvwGtr9gI&_nc_oc=Adq-ywUCYWQB14aT4JTJLIHHxw1jFGpZad8sCZLLJ9N-CRiFt-yHP8ibyY-ZlfGuQRk&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3Zc6UtFtrSmiz5HErpwccBlcnWrJWsmpf-f5E3qh1c0Q&oe=69E78E6F"}, {"file_name": "MQVR_metaStore_ss2.png", "id": "655824863632556", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/473391955_655824866965889_9083744742728821581_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F5PhYfqOcJoQ7kNvwGKtJUg&_nc_oc=AdqHDa3OfIvJCSSVQYDshl-bxGcK-23lih0mC4bMGrSyRPmQGdYI4UCplxc__3XsHSQ&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1QgKRgT6H0f_aOtgEHkWJql9AaixAWy3hLQB8ZzSkl6Q&oe=69E788C9"}, {"file_name": "MQVR_metaStore_ss5.png", "id": "640264872280351", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/473391924_640264875613684_2893261742097832448_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oJXxZkaNL6IQ7kNvwG0rRto&_nc_oc=AdoY1h-kuOW_32sbfHKWAxvvZeIiE_a7Lj7uEckLsOWmG_5Hw5ua58omLG74VaxEwgg&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3k0xqVFh21eqazVeXo9uNjnsg8RqF5m9eiHJnPrjen1A&oe=69E7856A"}, {"file_name": "MQVR_metaStore_ss1.png", "id": "686879277133721", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/473394268_686879280467054_8709353857892239785_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F9icDwkW7n8Q7kNvwEjYT9X&_nc_oc=Adr58R3uBbP26_RtJV4Xp76qxhmNKGG_eSvIgwCyo0edenAnQzBnYBxYfe1EHwrn7q8&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2X4QGw0QgZv_wd7urQILiu8YtRMjpdKJ1DC0_H73vJKA&oe=69E77110"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Art - 2560x1440 (1).png", "id": "681083991246799", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/473391986_681083994580132_5877693932550353369_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a-7OrtnL3QEQ7kNvwEALaAi&_nc_oc=Adof0CNwa-q8TSe-fNf5NgPQpq0RAVtrdr7-LRKoeuZJnmGCCJqQ1xp-lebboi_hQTM&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af27g6sY21_sdle2unCxZIojaWsTnh0RkCcBHxCXZ4RtcA&oe=69E76F35"}, "display_name": "Math Quest VR", "keywords": ["education", "VR", "action", "singeplayer", "firstperson"], "long_description": "Math has never been this action-packed! Step into Math Quest VR, where solving problems means blasting bandits with your paintball gun. Travel through exciting worlds of Addition, Subtraction, Multiplication, and Division, unlocking new challenges along the way. Whether you're playing Story Mode to level up your skills or testing your speed in Arcade Mode, every shot brings you closer to math mastery.\n\nKey Features:\n- Solve math problems in a whole new way \u2013 aim, shoot, and answer to progress through thrilling levels.\n- Explore interactive worlds themed around Addition, Subtraction, Multiplication, and Division.\n- Choose your challenge \u2013 level up in Story Mode or race against time in Arcade Mode.\n- Sharpen your reflexes and your mind with fast-paced, brain-boosting gameplay.\n- Engage in immersive VR action that makes math fun, exciting, and rewarding.\n\nThink fast, shoot smart, and become a math legend in Math Quest VR!", "short_description": "Turn math into an adventure! Blast through interactive worlds of Addition, Subtraction, Multiplication, and Division. Play Story Mode to grow your skills or Arcade Mode for a fast-paced challenge!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://thedevhouseagency.com/Privacy_Policy_MathQuestVR.pdf", "developer_terms_of_service_url": null, "publisher_name": "Devhouse", "support_website_url": null, "website_url": "https://www.thedevhouseagency.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1043107547362485"}, {"id": "459781504968480"}, {"id": "374404007583481
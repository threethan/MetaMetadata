71-25/473392298_969006928775886_7058059946160548103_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_PUbJLKuhTcQ7kNvwH6EidC&_nc_oc=Adp4a1YK9nRFshzm268gJkPC_CDmy--lM_byJuwi6_Rs1uVjBKzMuj7XkW5xZ_lIO00&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2n1JQWLIcfKlpEWIjAdzqY4fQWBG-ERz71x7DowAbhtg&oe=69F36BEF"}, {"file_name": "MQVR_metaStore_ss2.png", "id": "655824863632556", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/473391955_655824866965889_9083744742728821581_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iGZHcb8ZHlcQ7kNvwEE8zug&_nc_oc=AdrZmt8UpXxsbSQUvwwKz6qQKk16FKf00cqYKk1OOfvhAfft1k5lbOMzoqxSdOJSjjk&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0ZtwzLwEVliLfHVJ-SS05svFI7q-MxnF92UwwEK1W9_A&oe=69F36649"}, {"file_name": "MQVR_metaStore_ss5.png", "id": "640264872280351", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/473391924_640264875613684_2893261742097832448_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MZaH5XRHTfgQ7kNvwE4asyE&_nc_oc=AdoayUoPcGYfz2bn67ilM14sdTX9r5jfr725E4WNsNmhIDMugEXPITPm2pha7sB9-Pw&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af34Or8by4XjFlsocHNubCPX_LWSTmpqYp6Ha9sh-DP7Ww&oe=69F362EA"}, {"file_name": "MQVR_metaStore_ss1.png", "id": "686879277133721", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/473394268_686879280467054_8709353857892239785_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BaRifBDajPMQ7kNvwEGYipn&_nc_oc=AdqRyHGiALWXZ3bEEN40p9kgzIaFrWV27XoJU8m924LioWLyIgG82LQlogblAOr3Pk8&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1ETZ_wb1uA0oaCt5fx6x04EV6uITEvAEMpfEnRTWZjAg&oe=69F34E90"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Art - 2560x1440 (1).png", "id": "681083991246799", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/473391986_681083994580132_5877693932550353369_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Mecy7Wbddc4Q7kNvwH_Yloy&_nc_oc=AdqsENn_m1F_0G4elRshwxcWzpLXKTJ0jletvutJJzw0cQK1FU2sSP0O2Sn0_fQ2HxE&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3F1iK8cB-c8W8ei_9aivDOTH7H2yByx4EZKKX74Y94gA&oe=69F34CB5"}, "display_name": "Math Quest VR", "keywords": ["education", "VR", "action", "singeplayer", "firstperson"], "long_description": "Math has never been this action-packed! Step into Math Quest VR, where solving problems means blasting bandits with your paintball gun. Travel through exciting worlds of Addition, Subtraction, Multiplication, and Division, unlocking new challenges along the way. Whether you're playing Story Mode to level up your skills or testing your speed in Arcade Mode, every shot brings you closer to math mastery.\n\nKey Features:\n- Solve math problems in a whole new way \u2013 aim, shoot, and answer to progress through thrilling levels.\n- Explore interactive worlds themed around Addition, Subtraction, Multiplication, and Division.\n- Choose your challenge \u2013 level up in Story Mode or race against time in Arcade Mode.\n- Sharpen your reflexes and your mind with fast-paced, brain-boosting gameplay.\n- Engage in immersive VR action that makes math fun, exciting, and rewarding.\n\nThink fast, shoot smart, and become a math legend in Math Quest VR!", "short_description": "Turn math into an adventure! Blast through interactive worlds of Addition, Subtraction, Multiplication, and Division. Play Story Mode to grow your skills or Arcade Mode for a fast-paced challenge!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://thedevhouseagency.com/Privacy_Policy_MathQuestVR.pdf", "developer_terms_of_service_url": null, "publisher_name": "Devhouse", "support_website_url": null, "website_url": "https://www.thedevhouseagency.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1043107547362485"}, {"id": "459781504968480"}, {"id": "374404007583481
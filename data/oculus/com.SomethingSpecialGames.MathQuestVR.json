71-25/473392298_969006928775886_7058059946160548103_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VpTfRtVPFvEQ7kNvwGjmywd&_nc_oc=AdomiPs2St_9heTcytol6kULm-NGAHDsrcYgsxWjRMkdndhCAPYETobRzA_BjcsJ5ds&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1QdJqc3E6ZoLbuv5FsrPEs3xszW0fGNdxD_KUwBe_k3g&oe=69D7BC6F"}, {"file_name": "MQVR_metaStore_ss2.png", "id": "655824863632556", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/473391955_655824866965889_9083744742728821581_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oI779qo2m88Q7kNvwG1PZDT&_nc_oc=AdrvvxxWERSytlI62odHpRhMshU_2T7jMejmyHQ6J7CgW_oENPd00syvFFP9CUad7NQ&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2pb3bkR1vKrSfdVvPmfRCxbX60FfXEy3SlO7lTfLoGGQ&oe=69D7B6C9"}, {"file_name": "MQVR_metaStore_ss5.png", "id": "640264872280351", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/473391924_640264875613684_2893261742097832448_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1lMUxuYR88IQ7kNvwFKXWFV&_nc_oc=AdrF3NldMnazrY5y5rwhWCDKKPWsd3yUcawyC3cmA1rrOrUzVGg7m44QxEvudwxT2IE&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0QC-sY4dkmOePimmwx6eLPJGhx85FXx5aBznUj8DBLnw&oe=69D7B36A"}, {"file_name": "MQVR_metaStore_ss1.png", "id": "686879277133721", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/473394268_686879280467054_8709353857892239785_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_23J5Yb-Z0oQ7kNvwHQpOd2&_nc_oc=Adql39bPtwZ2NJ6UsoD5_DbwA0MZ46A2XstW8wFFg3s__tMVtr3rSPaL2eTeNbapl3w&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2I7mbIgdbiA2d_sGr3VTx7Hhs17_3-ESAxs488jAR39g&oe=69D79F10"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Art - 2560x1440 (1).png", "id": "681083991246799", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/473391986_681083994580132_5877693932550353369_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K-6CnBLF3GoQ7kNvwEU8wKX&_nc_oc=Ado5gdccMAllheZjbvefH2EIJErDcCXbSUnmjRESqa5luoyHMldgUVtd8mAOZ7v7JEs&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3G5MlBT9HmfArHezHAt4z729XRCQ9q85XVUva3q9bmlQ&oe=69D79D35"}, "display_name": "Math Quest VR", "keywords": ["education", "VR", "action", "singeplayer", "firstperson"], "long_description": "Math has never been this action-packed! Step into Math Quest VR, where solving problems means blasting bandits with your paintball gun. Travel through exciting worlds of Addition, Subtraction, Multiplication, and Division, unlocking new challenges along the way. Whether you're playing Story Mode to level up your skills or testing your speed in Arcade Mode, every shot brings you closer to math mastery.\n\nKey Features:\n- Solve math problems in a whole new way \u2013 aim, shoot, and answer to progress through thrilling levels.\n- Explore interactive worlds themed around Addition, Subtraction, Multiplication, and Division.\n- Choose your challenge \u2013 level up in Story Mode or race against time in Arcade Mode.\n- Sharpen your reflexes and your mind with fast-paced, brain-boosting gameplay.\n- Engage in immersive VR action that makes math fun, exciting, and rewarding.\n\nThink fast, shoot smart, and become a math legend in Math Quest VR!", "short_description": "Turn math into an adventure! Blast through interactive worlds of Addition, Subtraction, Multiplication, and Division. Play Story Mode to grow your skills or Arcade Mode for a fast-paced challenge!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://thedevhouseagency.com/Privacy_Policy_MathQuestVR.pdf", "developer_terms_of_service_url": null, "publisher_name": "Devhouse", "support_website_url": null, "website_url": "https://www.thedevhouseagency.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1043107547362485"}, {"id": "459781504968480"}, {"id": "374404007583481
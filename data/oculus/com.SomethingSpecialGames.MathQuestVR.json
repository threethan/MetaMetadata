71-25/473392298_969006928775886_7058059946160548103_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i9t4Qg_A2osQ7kNvwGpinHc&_nc_oc=Adou3GDcF4ceievjfycWKFYgyNTHeWUTiWOl9s1oLQxyRNfN9RI8JY93V1U3tISBAB4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNSB-uSS2E7BgtXqhORHH-XBxKerkUC7y0nk9Qbpj5erQ&oe=6AE5FFEF"}, {"file_name": "MQVR_metaStore_ss2.png", "id": "655824863632556", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391955_655824866965889_9083744742728821581_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9wlAjjh61f0Q7kNvwHb_daF&_nc_oc=AdoR73lu336ANPk4iP28DUKA-GASOxrG2iwAfCbl1gw2pgdGKZIxJHzL5R8tz6Nxe1w&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP3_3pzbwZU46QWNTE6fU3VsUonsQUyz5fqplfpK-fDhA&oe=6AE5FA49"}, {"file_name": "MQVR_metaStore_ss5.png", "id": "640264872280351", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391924_640264875613684_2893261742097832448_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Sk2XSmO-3dkQ7kNvwGZIS9A&_nc_oc=AdojtZFKsC59LS5z_ThoCBVKlko8-DOBgR96jkgVJIWGbQYMXbAzKxQIMTT0ERyLMo0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNMobOMIMabLHDQP-cq5qkhGGdA9PLZg0eZz7BWAewEwQ&oe=6AE5F6EA"}, {"file_name": "MQVR_metaStore_ss1.png", "id": "686879277133721", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473394268_686879280467054_8709353857892239785_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8bcVxzztepUQ7kNvwEogY34&_nc_oc=AdqL3V3V7I-qKM9J6SEFDD5PahiLvgMMhurYcIajwzSXmesVtWYwe_f01ycid0aH9Ik&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMSBEqyA3NGf3ZeIArWDE7gXBQmuKfZUAxwJrwytE-n2w&oe=6AE5E290"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Art - 2560x1440 (1).png", "id": "681083991246799", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391986_681083994580132_5877693932550353369_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IwrqvBfZi68Q7kNvwG-MhFp&_nc_oc=Ado31aUyQzuzxWoO_PgsBC1CpC2ir20VK5EizG7_Wn1iRN8hAy47TgGCT3SNEpj5idY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNesGKcWLf5F7BoElqnoCAl0qH0fiNYQrgtTG_T4_46Ig&oe=6AE5E0B5"}, "display_name": "Math Quest VR", "keywords": ["education", "VR", "action", "singeplayer", "firstperson"], "long_description": "Math has never been this action-packed! Step into Math Quest VR, where solving problems means blasting bandits with your paintball gun. Travel through exciting worlds of Addition, Subtraction, Multiplication, and Division, unlocking new challenges along the way. Whether you're playing Story Mode to level up your skills or testing your speed in Arcade Mode, every shot brings you closer to math mastery.\n\nKey Features:\n- Solve math problems in a whole new way \u2013 aim, shoot, and answer to progress through thrilling levels.\n- Explore interactive worlds themed around Addition, Subtraction, Multiplication, and Division.\n- Choose your challenge \u2013 level up in Story Mode or race against time in Arcade Mode.\n- Sharpen your reflexes and your mind with fast-paced, brain-boosting gameplay.\n- Engage in immersive VR action that makes math fun, exciting, and rewarding.\n\nThink fast, shoot smart, and become a math legend in Math Quest VR!", "short_description": "Turn math into an adventure! Blast through interactive worlds of Addition, Subtraction, Multiplication, and Division. Play Story Mode to grow your skills or Arcade Mode for a fast-paced challenge!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://thedevhouseagency.com/Privacy_Policy_MathQuestVR.pdf", "developer_terms_of_service_url": null, "publisher_name": "Devhouse", "support_website_url": null, "website_url": "https://www.thedevhouseagency.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1043107547362485"}, {"id": "459781504968480"}, {"id": "374404007583481
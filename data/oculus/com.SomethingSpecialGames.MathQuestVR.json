71-25/473392298_969006928775886_7058059946160548103_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MutcaAecAt0Q7kNvwFqv3d6&_nc_oc=AdpqaF4tHodlL7zCOO_e_ZUNO7OQuE_xuyo0KaOUWvmDDbYhFA4lN4GzIdvDiSdVSs4&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIpV1zu9qm-NmHcViGw2i2GlgQBWjo8x9gp3loxLZqk8g&oe=6AA0206F"}, {"file_name": "MQVR_metaStore_ss2.png", "id": "655824863632556", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/473391955_655824866965889_9083744742728821581_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LbbZZvdjL7UQ7kNvwG2L7Re&_nc_oc=AdpVqD4x6KXuTz0edf-zABiwtuklSCcL-VhluN8EDBc6neFBTAFl0VHZeROXgnoEqqw&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLCZtMGN8NtLNPkcmeyHSdnDy0OHMU9DVAuJYDMUfkXzw&oe=6AA01AC9"}, {"file_name": "MQVR_metaStore_ss5.png", "id": "640264872280351", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/473391924_640264875613684_2893261742097832448_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Wwfd5FlMYSgQ7kNvwHYLtOT&_nc_oc=AdroznBuZCl_iOzsnu57BjD9kInXI_A0MRpjrMhbEJCyoRkEAZuheqMefhrEQ7eedYU&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIp0oeHnmJoEovWfEJ9HjmCivpqiA_Um3JDKSCBiAFlJQ&oe=6AA0176A"}, {"file_name": "MQVR_metaStore_ss1.png", "id": "686879277133721", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/473394268_686879280467054_8709353857892239785_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2_H7hkmcoWYQ7kNvwEKYifg&_nc_oc=AdpRFWdb4ZZVXhmlvtnX6h3lhLAM0q1p7eTn69Cvu4qw1msS8tzUVepfTSBD9U-YNPQ&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJaDPsi_DNMMQXFgXCqDpR9kb1uYqA8FxRQxbyKlJNHfA&oe=6AA00310"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Art - 2560x1440 (1).png", "id": "681083991246799", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/473391986_681083994580132_5877693932550353369_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RVaTMgGXlm8Q7kNvwHmvLhn&_nc_oc=Adq7VhTL6DYhvM0HDCqu1IzUx9XnpeyRIFnDnfF1wgV8u7DC90hbOCYTGqqCqAQDKSc&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJYI2hVk_RtshsHt3TE-W10eTCy3ST2zJpGQxbFBNpEyQ&oe=6AA00135"}, "display_name": "Math Quest VR", "keywords": ["education", "VR", "action", "singeplayer", "firstperson"], "long_description": "Math has never been this action-packed! Step into Math Quest VR, where solving problems means blasting bandits with your paintball gun. Travel through exciting worlds of Addition, Subtraction, Multiplication, and Division, unlocking new challenges along the way. Whether you're playing Story Mode to level up your skills or testing your speed in Arcade Mode, every shot brings you closer to math mastery.\n\nKey Features:\n- Solve math problems in a whole new way \u2013 aim, shoot, and answer to progress through thrilling levels.\n- Explore interactive worlds themed around Addition, Subtraction, Multiplication, and Division.\n- Choose your challenge \u2013 level up in Story Mode or race against time in Arcade Mode.\n- Sharpen your reflexes and your mind with fast-paced, brain-boosting gameplay.\n- Engage in immersive VR action that makes math fun, exciting, and rewarding.\n\nThink fast, shoot smart, and become a math legend in Math Quest VR!", "short_description": "Turn math into an adventure! Blast through interactive worlds of Addition, Subtraction, Multiplication, and Division. Play Story Mode to grow your skills or Arcade Mode for a fast-paced challenge!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://thedevhouseagency.com/Privacy_Policy_MathQuestVR.pdf", "developer_terms_of_service_url": null, "publisher_name": "Devhouse", "support_website_url": null, "website_url": "https://www.thedevhouseagency.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1043107547362485"}, {"id": "459781504968480"}, {"id": "374404007583481
71-25/473392298_969006928775886_7058059946160548103_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U_tHMPH-Jy4Q7kNvwHeVsZ5&_nc_oc=AdoQB-9Dn2Rvahm6LZAHjb8c7ru3cLJWLIlpzvcy6hpRSNP6fgUDgDibR3Ryys190Zk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4FwXJoiuiEquSf59xJU3Y5V1orhpCj8i3L9Ml9xHcHzg&oe=6A14616F"}, {"file_name": "MQVR_metaStore_ss2.png", "id": "655824863632556", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473391955_655824866965889_9083744742728821581_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2HcqMn-3MeAQ7kNvwG8WmnZ&_nc_oc=AdqphQcHdIRIfodXdfhdhYV6VS5yydPn7HwpL-oOUaJs5O_ndOqdMDBn7tVtfs3fAK0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5cWzev39r9Z9u9tcBdCdaTzYWRtv0a6o9u5znLJ9DvJQ&oe=6A145BC9"}, {"file_name": "MQVR_metaStore_ss5.png", "id": "640264872280351", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473391924_640264875613684_2893261742097832448_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MhocrDOhB4gQ7kNvwEtM3aa&_nc_oc=Adp-j8DCK8zfCHd2POSXJFsRzq54FtTDYe1U7xrspNJTkIvgHYJleLeiBvlbniF33wg&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6ONZAL3bXwbSy5VmYuIHrh1kfjGkG1n2OCQ5La5w0Y-w&oe=6A14586A"}, {"file_name": "MQVR_metaStore_ss1.png", "id": "686879277133721", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473394268_686879280467054_8709353857892239785_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e8Mln8j7Bu4Q7kNvwGNquRt&_nc_oc=AdrngAy1gDhxUwx_DeIxIAEv7u-dhXa3iexyml9eoxd56FyZJYoHRH1hiRPNlzTDfeE&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7xHxv65enqRRZfUQZYs78gVwGozzElkCsp-R4hemGMQA&oe=6A144410"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Art - 2560x1440 (1).png", "id": "681083991246799", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473391986_681083994580132_5877693932550353369_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LeCE9JBpzHAQ7kNvwEEIuVp&_nc_oc=AdqL9fire6Qjc0qQwFnE1emFRX42lq5YmMNvgRNvMffpZDaoOZnpYKu8zq1BTZGmpZo&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7dEffMORAiq6uoUdsczC2KqUPUY89F391N5ySyLHzeNw&oe=6A144235"}, "display_name": "Math Quest VR", "keywords": ["education", "VR", "action", "singeplayer", "firstperson"], "long_description": "Math has never been this action-packed! Step into Math Quest VR, where solving problems means blasting bandits with your paintball gun. Travel through exciting worlds of Addition, Subtraction, Multiplication, and Division, unlocking new challenges along the way. Whether you're playing Story Mode to level up your skills or testing your speed in Arcade Mode, every shot brings you closer to math mastery.\n\nKey Features:\n- Solve math problems in a whole new way \u2013 aim, shoot, and answer to progress through thrilling levels.\n- Explore interactive worlds themed around Addition, Subtraction, Multiplication, and Division.\n- Choose your challenge \u2013 level up in Story Mode or race against time in Arcade Mode.\n- Sharpen your reflexes and your mind with fast-paced, brain-boosting gameplay.\n- Engage in immersive VR action that makes math fun, exciting, and rewarding.\n\nThink fast, shoot smart, and become a math legend in Math Quest VR!", "short_description": "Turn math into an adventure! Blast through interactive worlds of Addition, Subtraction, Multiplication, and Division. Play Story Mode to grow your skills or Arcade Mode for a fast-paced challenge!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://thedevhouseagency.com/Privacy_Policy_MathQuestVR.pdf", "developer_terms_of_service_url": null, "publisher_name": "Devhouse", "support_website_url": null, "website_url": "https://www.thedevhouseagency.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1043107547362485"}, {"id": "459781504968480"}, {"id": "374404007583481
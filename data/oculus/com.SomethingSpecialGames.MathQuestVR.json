71-25/473392298_969006928775886_7058059946160548103_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b8sAr9BJrPUQ7kNvwHvetdB&_nc_oc=Adqf9h94kKFcjTXp4H0tDVnozbj5yJBgWcFQ7rFIS43NA4Mlk0RkD7BRye85-hZeEOk&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDngqvc0hMTGIOvhQUgxWtQWER6XVKJOqG0dgRCzyJNcw&oe=6A6CB5EF"}, {"file_name": "MQVR_metaStore_ss2.png", "id": "655824863632556", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391955_655824866965889_9083744742728821581_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w7FVlqOF5M0Q7kNvwHZCZpA&_nc_oc=Adqs7deYORdXpuDC700uWS8gzUqm76VUgUPHqhr-x68nGNZLCBKZ_pgB_NAuEwPHA04&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA9Q2DW4dEnwEhnO7y6xLA2CVD7MG2z01d0D_yiYN99hQ&oe=6A6CB049"}, {"file_name": "MQVR_metaStore_ss5.png", "id": "640264872280351", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391924_640264875613684_2893261742097832448_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-xvCkaD1gwIQ7kNvwGUfrKk&_nc_oc=AdrmZ8D9RIaEh36gpXyArrhBhN05rfwXuhXoD7qyN-g7W8eDN4dhE3st3Wl_iSOnxcc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDC8t1rnYVtEpxMKG2DFZF-PUTBKWR0eXU9YbYXHB_mPQ&oe=6A6CACEA"}, {"file_name": "MQVR_metaStore_ss1.png", "id": "686879277133721", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473394268_686879280467054_8709353857892239785_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Q_24494T0OcQ7kNvwHSXNrE&_nc_oc=AdqN1jENqW6Y3Sh-0fHadXmArGPziOiyTIX-leKazPCRGYnvZu41f0T6bHgSZKXUAMY&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBDydBOHFod4JU4lE7Wdpe7k6OwNVcBV5BknmFYUSiX1Q&oe=6A6C9890"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Art - 2560x1440 (1).png", "id": "681083991246799", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391986_681083994580132_5877693932550353369_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U5TLGhs3BncQ7kNvwHATOhg&_nc_oc=AdoZLMq9m1ggdVXMn8z-nJx-AlnIrzgrhPRWbuPNS5qcKeQNcLftYK3jXYOgbXzule8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBYsrAWU1oPDFp-aagYBicm_nSxfKsz5Y0oEzZGSgcM7g&oe=6A6C96B5"}, "display_name": "Math Quest VR", "keywords": ["education", "VR", "action", "singeplayer", "firstperson"], "long_description": "Math has never been this action-packed! Step into Math Quest VR, where solving problems means blasting bandits with your paintball gun. Travel through exciting worlds of Addition, Subtraction, Multiplication, and Division, unlocking new challenges along the way. Whether you're playing Story Mode to level up your skills or testing your speed in Arcade Mode, every shot brings you closer to math mastery.\n\nKey Features:\n- Solve math problems in a whole new way \u2013 aim, shoot, and answer to progress through thrilling levels.\n- Explore interactive worlds themed around Addition, Subtraction, Multiplication, and Division.\n- Choose your challenge \u2013 level up in Story Mode or race against time in Arcade Mode.\n- Sharpen your reflexes and your mind with fast-paced, brain-boosting gameplay.\n- Engage in immersive VR action that makes math fun, exciting, and rewarding.\n\nThink fast, shoot smart, and become a math legend in Math Quest VR!", "short_description": "Turn math into an adventure! Blast through interactive worlds of Addition, Subtraction, Multiplication, and Division. Play Story Mode to grow your skills or Arcade Mode for a fast-paced challenge!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://thedevhouseagency.com/Privacy_Policy_MathQuestVR.pdf", "developer_terms_of_service_url": null, "publisher_name": "Devhouse", "support_website_url": null, "website_url": "https://www.thedevhouseagency.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1043107547362485"}, {"id": "459781504968480"}, {"id": "374404007583481
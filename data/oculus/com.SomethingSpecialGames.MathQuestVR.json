71-25/473392298_969006928775886_7058059946160548103_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VpTfRtVPFvEQ7kNvwFMKQie&_nc_oc=AdpVtlQvJJdnJYilqvYyVwyTsZuOq94rbWPnoGdcxutAvySQYN9kVDlaSxSkqjljfho&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1uP8U7HrVGCSqxkYeyxdEFE_EmVONUhYxP1I7cDkFx5A&oe=69D632AF"}, {"file_name": "MQVR_metaStore_ss2.png", "id": "655824863632556", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391955_655824866965889_9083744742728821581_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oI779qo2m88Q7kNvwGHwFX2&_nc_oc=AdpsDCvFR-P5MwfyqATbc5BWzykjg98w5bIgEQ1nLmh2DtJUwvOq_Yun2JYwAeTersY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2j8mv3ot921MPujIpNYvVWPVPuzZJKBW1TNotOBMeIiw&oe=69D66549"}, {"file_name": "MQVR_metaStore_ss5.png", "id": "640264872280351", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391924_640264875613684_2893261742097832448_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GohFr2Af4-EQ7kNvwHNI-xe&_nc_oc=AdrJRcpC_abxKwljlgM4YLS7ol-UEOxmj2F-MqqLX3ZL8EuOpDOLX1NFYfeqM0-pbgQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0UJ5mLSystwp4JkG9wEKMDQduFiI-39jItSp_u-feXZg&oe=69D661EA"}, {"file_name": "MQVR_metaStore_ss1.png", "id": "686879277133721", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473394268_686879280467054_8709353857892239785_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_23J5Yb-Z0oQ7kNvwFbm8yH&_nc_oc=AdpO4VaCxVAm3z379ycYILkbiVokwSFRhks6uAZVzW_W87jbsTmIWtAm4io26Vbtozc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3Ct9mkZ5zEh0v-T1u-yHZQX-n5JaJDHFkwXJJmSiMxJg&oe=69D64D90"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Art - 2560x1440 (1).png", "id": "681083991246799", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391986_681083994580132_5877693932550353369_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K-6CnBLF3GoQ7kNvwGvE9zr&_nc_oc=AdpAAfUAHwIWh82qW0C2t5e9vUslBcOPxGFJ1gBQpeFRZG6KnR0yH_qtvhM26UfUoy0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1HNA5sbFaqYRGNZILrrURHJu5JYizo8Exn1xzUDiJcZg&oe=69D64BB5"}, "display_name": "Math Quest VR", "keywords": ["education", "VR", "action", "singeplayer", "firstperson"], "long_description": "Math has never been this action-packed! Step into Math Quest VR, where solving problems means blasting bandits with your paintball gun. Travel through exciting worlds of Addition, Subtraction, Multiplication, and Division, unlocking new challenges along the way. Whether you're playing Story Mode to level up your skills or testing your speed in Arcade Mode, every shot brings you closer to math mastery.\n\nKey Features:\n- Solve math problems in a whole new way \u2013 aim, shoot, and answer to progress through thrilling levels.\n- Explore interactive worlds themed around Addition, Subtraction, Multiplication, and Division.\n- Choose your challenge \u2013 level up in Story Mode or race against time in Arcade Mode.\n- Sharpen your reflexes and your mind with fast-paced, brain-boosting gameplay.\n- Engage in immersive VR action that makes math fun, exciting, and rewarding.\n\nThink fast, shoot smart, and become a math legend in Math Quest VR!", "short_description": "Turn math into an adventure! Blast through interactive worlds of Addition, Subtraction, Multiplication, and Division. Play Story Mode to grow your skills or Arcade Mode for a fast-paced challenge!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://thedevhouseagency.com/Privacy_Policy_MathQuestVR.pdf", "developer_terms_of_service_url": null, "publisher_name": "Devhouse", "support_website_url": null, "website_url": "https://www.thedevhouseagency.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1043107547362485"}, {"id": "459781504968480"}, {"id": "374404007583481
71-25/473392298_969006928775886_7058059946160548103_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LvKpM5i6iCgQ7kNvwE16Gsr&_nc_oc=AdpgV0umd_h7NghUNVdl6lqI0xty10JAEUWf_ev4BdVQFr5b-IkFpc6w3ZN6ew7x7jk&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4O64MB2k4rHAeLr30-cZbu2BZYxdXlf53cCHFykkOWLQ&oe=6A15B2EF"}, {"file_name": "MQVR_metaStore_ss2.png", "id": "655824863632556", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473391955_655824866965889_9083744742728821581_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_gXz4QOLczsQ7kNvwF7oICj&_nc_oc=AdqoSY2h1smmzbp7UVPESjJ05WFh5QDjPjLxLD6yYjK9BQA4AR_PC3FzIbneFSQ7asU&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7WB_hSzbEOfFvacOtOxXhR3j_VPpjzHvayHTgtQqYJPw&oe=6A15AD49"}, {"file_name": "MQVR_metaStore_ss5.png", "id": "640264872280351", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/473391924_640264875613684_2893261742097832448_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MhocrDOhB4gQ7kNvwGRQBLl&_nc_oc=Adrv0auqhtsS_yrbJuuz8HnZ5ouFX3m__-jkZON5NshWie4TG4Lv6h3mhPyGycetQAE&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4rTlXuCVp0JBmtZLJZnKfTqqSHD97QIM9eMnYxb41a7Q&oe=6A15A9EA"}, {"file_name": "MQVR_metaStore_ss1.png", "id": "686879277133721", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473394268_686879280467054_8709353857892239785_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oaaOiJc0XdcQ7kNvwEkYxoS&_nc_oc=AdpX49Rgvm90e8oPxYereQ4m7IAV61AH_B258Wav1dW88mwPrVazVPc3uTn16aCkBs0&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7_AUZu_uyhxWUD-yT6Wjp84T4XtkGDO9y7aFcN7pkP9g&oe=6A159590"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Art - 2560x1440 (1).png", "id": "681083991246799", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473391986_681083994580132_5877693932550353369_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cBkPd2TiDuUQ7kNvwGnt99c&_nc_oc=AdrgfYX2u7BV_bDd58Jop2AD90KVlL74qMitsNGAPlHePZCYn9yt84pTfXPQOWSkey0&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4hrjVIyqIBfSeQjvFLwCywHGAPe1vOltORWdnoWMbygA&oe=6A1593B5"}, "display_name": "Math Quest VR", "keywords": ["education", "VR", "action", "singeplayer", "firstperson"], "long_description": "Math has never been this action-packed! Step into Math Quest VR, where solving problems means blasting bandits with your paintball gun. Travel through exciting worlds of Addition, Subtraction, Multiplication, and Division, unlocking new challenges along the way. Whether you're playing Story Mode to level up your skills or testing your speed in Arcade Mode, every shot brings you closer to math mastery.\n\nKey Features:\n- Solve math problems in a whole new way \u2013 aim, shoot, and answer to progress through thrilling levels.\n- Explore interactive worlds themed around Addition, Subtraction, Multiplication, and Division.\n- Choose your challenge \u2013 level up in Story Mode or race against time in Arcade Mode.\n- Sharpen your reflexes and your mind with fast-paced, brain-boosting gameplay.\n- Engage in immersive VR action that makes math fun, exciting, and rewarding.\n\nThink fast, shoot smart, and become a math legend in Math Quest VR!", "short_description": "Turn math into an adventure! Blast through interactive worlds of Addition, Subtraction, Multiplication, and Division. Play Story Mode to grow your skills or Arcade Mode for a fast-paced challenge!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://thedevhouseagency.com/Privacy_Policy_MathQuestVR.pdf", "developer_terms_of_service_url": null, "publisher_name": "Devhouse", "support_website_url": null, "website_url": "https://www.thedevhouseagency.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1043107547362485"}, {"id": "459781504968480"}, {"id": "374404007583481
71-25/473392298_969006928775886_7058059946160548103_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o_g4pMHHi7QQ7kNvwHX1h_x&_nc_oc=Adq5eQU1gkOn-Mf8q_293K3MqlSak3IfKZ_dZFn0ykaF2J5JPjClTpR3k0O-jhACPPs&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBGO7fIKCmS4l6DsCw3BoxbNxpKuGiJMT8sWbjGXeCA9A&oe=6A54FAEF"}, {"file_name": "MQVR_metaStore_ss2.png", "id": "655824863632556", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473391955_655824866965889_9083744742728821581_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C61PpGoy98UQ7kNvwEx7iPr&_nc_oc=AdqevdI5VjkFzMJWam6i-qcSa6s6dHgz325X5Y7eDSYI9EqBiOj2tLDrBgu4J1fRTuI&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDUXJuKSnZrr3AJ--DXbufEz_12UO1MA6KkXLGwOyLyCQ&oe=6A54F549"}, {"file_name": "MQVR_metaStore_ss5.png", "id": "640264872280351", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/473391924_640264875613684_2893261742097832448_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dFu55yx0mHsQ7kNvwETQMyT&_nc_oc=Adqq9atYkR6JN5aIWKp0BWn6YDPwqpuORaKczFAHeDws7brQkPoV4ZBRw8TOEEaiuzc&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAibfJ61SxmU5wXZgL6YCEgAsUIaQaNa0imMSzZHw67nA&oe=6A54F1EA"}, {"file_name": "MQVR_metaStore_ss1.png", "id": "686879277133721", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473394268_686879280467054_8709353857892239785_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=58ey-XA2Q2MQ7kNvwGmLvBx&_nc_oc=AdrU7kI9yDRiv0UOM4JOEaRh12Bhu0XgOopydJnS1YAhMoxaPAwRrK3weFySqW-C-hM&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD-JgDFAtsBsjRkJ8as0b9XaoUwztp4kVK6ds_9gJZF6Q&oe=6A54DD90"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Art - 2560x1440 (1).png", "id": "681083991246799", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473391986_681083994580132_5877693932550353369_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MeICbx3G4BgQ7kNvwHbsaJv&_nc_oc=AdqB-OujMHseWvn65ooPvVU-8vt7WAhp0I3g4QJXH2D2IdVrO6NBi_40sIF38tb6E14&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAL0KFy_0mRuJFCeI-bYEXO2gkbjCYvfl_sEl2AMzaGAg&oe=6A54DBB5"}, "display_name": "Math Quest VR", "keywords": ["education", "VR", "action", "singeplayer", "firstperson"], "long_description": "Math has never been this action-packed! Step into Math Quest VR, where solving problems means blasting bandits with your paintball gun. Travel through exciting worlds of Addition, Subtraction, Multiplication, and Division, unlocking new challenges along the way. Whether you're playing Story Mode to level up your skills or testing your speed in Arcade Mode, every shot brings you closer to math mastery.\n\nKey Features:\n- Solve math problems in a whole new way \u2013 aim, shoot, and answer to progress through thrilling levels.\n- Explore interactive worlds themed around Addition, Subtraction, Multiplication, and Division.\n- Choose your challenge \u2013 level up in Story Mode or race against time in Arcade Mode.\n- Sharpen your reflexes and your mind with fast-paced, brain-boosting gameplay.\n- Engage in immersive VR action that makes math fun, exciting, and rewarding.\n\nThink fast, shoot smart, and become a math legend in Math Quest VR!", "short_description": "Turn math into an adventure! Blast through interactive worlds of Addition, Subtraction, Multiplication, and Division. Play Story Mode to grow your skills or Arcade Mode for a fast-paced challenge!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://thedevhouseagency.com/Privacy_Policy_MathQuestVR.pdf", "developer_terms_of_service_url": null, "publisher_name": "Devhouse", "support_website_url": null, "website_url": "https://www.thedevhouseagency.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1043107547362485"}, {"id": "459781504968480"}, {"id": "374404007583481
71-25/473392298_969006928775886_7058059946160548103_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xHvd_2UE6aAQ7kNvwE36Gkm&_nc_oc=Adrk5wmZhQFa4W5PZKEdVZs63T98iSufdymDF_R7VDymkMsO-CkL-B2bzoU_e2uVbj8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHnPPo-b3DbcvIsaOetpD5JyspLL-E70p0n0ocaxqHxZQ&oe=6A79E4EF"}, {"file_name": "MQVR_metaStore_ss2.png", "id": "655824863632556", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391955_655824866965889_9083744742728821581_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pObQ4VcVJ-IQ7kNvwFLL0S-&_nc_oc=AdpL6gibD8qwptaFsFqQzrOeVSyPdpyEKdKJ4AMK-5G7mpZ4BW82aJibMpTk5vKWtx0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEox6_l3kI938F36OCtRdee4gihYXemI6_0h9s_6VafaQ&oe=6A79DF49"}, {"file_name": "MQVR_metaStore_ss5.png", "id": "640264872280351", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391924_640264875613684_2893261742097832448_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=izvc-PhWc5UQ7kNvwHh8U58&_nc_oc=Adq8Qhdi48ofYTbp6WrzA8OQ4n4Tr2BdjU6lXx_BUEZBuy3vGKlTkVMaqqJif1Cg4EA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFB0wefPJyWr2-yQIVpa9sAzZ6FDpWIg600UGg0lAuUxw&oe=6A79DBEA"}, {"file_name": "MQVR_metaStore_ss1.png", "id": "686879277133721", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473394268_686879280467054_8709353857892239785_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ONOqRUJL2BoQ7kNvwEF7g77&_nc_oc=AdoUEsGXQvL9cS6O2WjZVSV8fkYW7bKD917DrBKIHYsrvA85HsZu6yZt7KGT0Pcma7U&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFjNsU6gFSREl-nRVfW2IAf8OzfKGr9hHKhv_p-jkVZMQ&oe=6A79C790"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Art - 2560x1440 (1).png", "id": "681083991246799", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391986_681083994580132_5877693932550353369_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RmEOCXncIqcQ7kNvwHUnvdo&_nc_oc=AdpgBQ5IzBlhRUDJZWVDFQ_OXOPwbVNgK2Tae7Y-90b0AuADq_5_RyYN-piv26GjOac&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFWdKZX22UdtXwyEVJbL7WXlOxLkU6-tMVISWsVtHfI3Q&oe=6A79C5B5"}, "display_name": "Math Quest VR", "keywords": ["education", "VR", "action", "singeplayer", "firstperson"], "long_description": "Math has never been this action-packed! Step into Math Quest VR, where solving problems means blasting bandits with your paintball gun. Travel through exciting worlds of Addition, Subtraction, Multiplication, and Division, unlocking new challenges along the way. Whether you're playing Story Mode to level up your skills or testing your speed in Arcade Mode, every shot brings you closer to math mastery.\n\nKey Features:\n- Solve math problems in a whole new way \u2013 aim, shoot, and answer to progress through thrilling levels.\n- Explore interactive worlds themed around Addition, Subtraction, Multiplication, and Division.\n- Choose your challenge \u2013 level up in Story Mode or race against time in Arcade Mode.\n- Sharpen your reflexes and your mind with fast-paced, brain-boosting gameplay.\n- Engage in immersive VR action that makes math fun, exciting, and rewarding.\n\nThink fast, shoot smart, and become a math legend in Math Quest VR!", "short_description": "Turn math into an adventure! Blast through interactive worlds of Addition, Subtraction, Multiplication, and Division. Play Story Mode to grow your skills or Arcade Mode for a fast-paced challenge!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://thedevhouseagency.com/Privacy_Policy_MathQuestVR.pdf", "developer_terms_of_service_url": null, "publisher_name": "Devhouse", "support_website_url": null, "website_url": "https://www.thedevhouseagency.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1043107547362485"}, {"id": "459781504968480"}, {"id": "374404007583481
71-25/473392298_969006928775886_7058059946160548103_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KlrAFnBLX1kQ7kNvwGv35Q7&_nc_oc=Adp8_AkvekgGkLFDiYVrLIWOXJNhPXjjamNEibIp1phGhFOYmUTpRMDDnunNikOhNkE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCMzC0Oo7kygVf26JEK8QvXFmMldUNPy8A_irIcnohF7g&oe=6A4BC06F"}, {"file_name": "MQVR_metaStore_ss2.png", "id": "655824863632556", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391955_655824866965889_9083744742728821581_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jZqkcvhyeoAQ7kNvwHDA5f-&_nc_oc=AdodBncwSVmN3wcnVTGzSMdjYteTqm1CBJk6t7OREXg71xM4Ptg0odJftrERwZrOw5A&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBZ3BQk5nsSwVO8fRuXgbeg8DvuOwPqiUbI_BnviVBY2g&oe=6A4BBAC9"}, {"file_name": "MQVR_metaStore_ss5.png", "id": "640264872280351", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391924_640264875613684_2893261742097832448_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H8AdGpMxJDcQ7kNvwHw72Au&_nc_oc=AdrcNbOwUlnzkduFYinMn3OA1HGL4iNZyBQARSrn-gA0Z5Aw6WwKXY0nDDI2OEcEh0E&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDcDj21-36tYVwm0X3m7xR_J0gcs8vWZWatbAT-KJfrMQ&oe=6A4BB76A"}, {"file_name": "MQVR_metaStore_ss1.png", "id": "686879277133721", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473394268_686879280467054_8709353857892239785_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VHxweP-R9mQQ7kNvwGPXdhv&_nc_oc=AdpSAk2FDIaOMR4lutoj5iKd54FwWUqC8f1ZK-_0WGpLVjAPgzbVBJ84uTLCZw7QUVY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDXEwMVeN8HfcRqpnSd5r3PYJI21obaOXr5greFmLgXJQ&oe=6A4BA310"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Art - 2560x1440 (1).png", "id": "681083991246799", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391986_681083994580132_5877693932550353369_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zdYWrNltKYUQ7kNvwFK2kmK&_nc_oc=AdqTnOVAZE7j2iTQeFfSkZ6qqzyVpM47jDHCD928sq81nwoSUhWD6HdX48y0iEBUxCI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBQkipoR0N_Zf2OFIWecG5DoPBQEW4JFxb0PhJw1YC4AQ&oe=6A4BA135"}, "display_name": "Math Quest VR", "keywords": ["education", "VR", "action", "singeplayer", "firstperson"], "long_description": "Math has never been this action-packed! Step into Math Quest VR, where solving problems means blasting bandits with your paintball gun. Travel through exciting worlds of Addition, Subtraction, Multiplication, and Division, unlocking new challenges along the way. Whether you're playing Story Mode to level up your skills or testing your speed in Arcade Mode, every shot brings you closer to math mastery.\n\nKey Features:\n- Solve math problems in a whole new way \u2013 aim, shoot, and answer to progress through thrilling levels.\n- Explore interactive worlds themed around Addition, Subtraction, Multiplication, and Division.\n- Choose your challenge \u2013 level up in Story Mode or race against time in Arcade Mode.\n- Sharpen your reflexes and your mind with fast-paced, brain-boosting gameplay.\n- Engage in immersive VR action that makes math fun, exciting, and rewarding.\n\nThink fast, shoot smart, and become a math legend in Math Quest VR!", "short_description": "Turn math into an adventure! Blast through interactive worlds of Addition, Subtraction, Multiplication, and Division. Play Story Mode to grow your skills or Arcade Mode for a fast-paced challenge!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://thedevhouseagency.com/Privacy_Policy_MathQuestVR.pdf", "developer_terms_of_service_url": null, "publisher_name": "Devhouse", "support_website_url": null, "website_url": "https://www.thedevhouseagency.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1043107547362485"}, {"id": "459781504968480"}, {"id": "374404007583481
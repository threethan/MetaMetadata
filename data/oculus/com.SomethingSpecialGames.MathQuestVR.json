71-25/473392298_969006928775886_7058059946160548103_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N2E3GvA2chkQ7kNvwEk59-o&_nc_oc=Adq5NhVj5ulSaTqiXI__7FsosAHb69s6Dt40f37_J19QOCsOT_JmItOK3l5uZnwMa1I&_nc_zt=3&_nc_ht=scontent-hkg1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHNGGghWqSyXnrlozGA0b95lF0bSjqw6RilnZ5lYW6Npw&oe=6A9167AF"}, {"file_name": "MQVR_metaStore_ss2.png", "id": "655824863632556", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/473391955_655824866965889_9083744742728821581_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KQS7lyLxf2oQ7kNvwF0wVTy&_nc_oc=AdpkTaD0Y9A2eU-A9ZF7nX7lYRb0D5EUMr6x4u3svEPqcGGsnkPYul4f7ob21zDE-L4&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHeA1D6HAbwQdMajSI-ka6loSsg8b9qG9LbeuXfhiWY_Q&oe=6A916209"}, {"file_name": "MQVR_metaStore_ss5.png", "id": "640264872280351", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/473391924_640264875613684_2893261742097832448_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V1VMoJgzDFYQ7kNvwF2udVq&_nc_oc=AdrCKQwdsKTECejNEGIGNCH3aJbHuzht0twEbp210VS7z8a1QpjI1s-HIrzmlCF0Vag&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF4JJB-Y4F_rCMZQay0ktssyiLhNUI89caBRhLHn2OB-g&oe=6A915EAA"}, {"file_name": "MQVR_metaStore_ss1.png", "id": "686879277133721", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/473394268_686879280467054_8709353857892239785_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fwM2cRlX0xIQ7kNvwEUjTiK&_nc_oc=Adpl_XAIvYmhEWn6P77abqGbZLDprqTkSJAMv9CMqF-UDJX3wUrHmXkRBJSZPIAIUeI&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFptjlZS_LB7ZoCdg8990NP4cG3ety4NlQD0DYoWlGf8w&oe=6A918290"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Art - 2560x1440 (1).png", "id": "681083991246799", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/473391986_681083994580132_5877693932550353369_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FUtngW_d524Q7kNvwH6za3x&_nc_oc=Adov6DlkVOf02QYiaPA8k549Vr7phdDIM-1UkR8PO6Fhemn73gPkUGV2dSie5vd2CTE&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEgv_HzxPFrwvUzIWSltPtWKO-Ml7sYFkOAbYrmoS111g&oe=6A9180B5"}, "display_name": "Math Quest VR", "keywords": ["education", "VR", "action", "singeplayer", "firstperson"], "long_description": "Math has never been this action-packed! Step into Math Quest VR, where solving problems means blasting bandits with your paintball gun. Travel through exciting worlds of Addition, Subtraction, Multiplication, and Division, unlocking new challenges along the way. Whether you're playing Story Mode to level up your skills or testing your speed in Arcade Mode, every shot brings you closer to math mastery.\n\nKey Features:\n- Solve math problems in a whole new way \u2013 aim, shoot, and answer to progress through thrilling levels.\n- Explore interactive worlds themed around Addition, Subtraction, Multiplication, and Division.\n- Choose your challenge \u2013 level up in Story Mode or race against time in Arcade Mode.\n- Sharpen your reflexes and your mind with fast-paced, brain-boosting gameplay.\n- Engage in immersive VR action that makes math fun, exciting, and rewarding.\n\nThink fast, shoot smart, and become a math legend in Math Quest VR!", "short_description": "Turn math into an adventure! Blast through interactive worlds of Addition, Subtraction, Multiplication, and Division. Play Story Mode to grow your skills or Arcade Mode for a fast-paced challenge!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://thedevhouseagency.com/Privacy_Policy_MathQuestVR.pdf", "developer_terms_of_service_url": null, "publisher_name": "Devhouse", "support_website_url": null, "website_url": "https://www.thedevhouseagency.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1043107547362485"}, {"id": "459781504968480"}, {"id": "374404007583481
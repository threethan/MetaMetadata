71-25/473392298_969006928775886_7058059946160548103_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LxnflgFNqWEQ7kNvwEmOElM&_nc_oc=AdrhIJZBbRTCp86VuXEPi1k8RT9kdLHX4mLCCMFvtHHgVUe3fkRvo9ll9PmUu_bWlBg&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_f7AtjnpPoWn5sEythKOcMOiVaNrX0mtsomHqvZHk1dg&oe=6A41346F"}, {"file_name": "MQVR_metaStore_ss2.png", "id": "655824863632556", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/473391955_655824866965889_9083744742728821581_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JzI1k2a3XJUQ7kNvwF5ocWS&_nc_oc=AdrAqLionP0DAlTJ4Yl3F4Z8POwbjp86Tv9zMgBf_afOL3d50MQllD09jnTLJIaD-cs&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_aLeyfjmlfk6a5XRHdKY4DGVvLIK-eNuE7GZfCzsF5qQ&oe=6A412EC9"}, {"file_name": "MQVR_metaStore_ss5.png", "id": "640264872280351", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/473391924_640264875613684_2893261742097832448_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sRMvOoSGXtAQ7kNvwGqG_on&_nc_oc=AdrsMyINZc-jqeWxR0WI3YHyIG2yDV0LmQtsj2nUvzgeyKF_sATZ7bQ2DBKmj_TBHFo&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8PIzxJv_l-4Ee2hKFxNPTsABuPb-jgbEXz-5TXLua4cQ&oe=6A412B6A"}, {"file_name": "MQVR_metaStore_ss1.png", "id": "686879277133721", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/473394268_686879280467054_8709353857892239785_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xDHkkbuH39oQ7kNvwFn0Rb3&_nc_oc=AdqEsH01FMciRY6k6_d44oOD-I8S2poohWeLPSRxe8OREaGg6oPCR80d4PPggsPKQMk&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af86yDs0OULHDrWnkzvkOVjtzvcr7CO3jAn8RguG190IwA&oe=6A411710"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Art - 2560x1440 (1).png", "id": "681083991246799", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/473391986_681083994580132_5877693932550353369_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w-gO3Q31t0EQ7kNvwFfUluQ&_nc_oc=AdpB7eae2hBJFuWd7bhODUi7FeUBexDFVU3flOZyP6VOEPA1geTh5Z8GC0jMeeA4pFE&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-0Kn8B2doOoU6zryudDC4uKGJNzEuo2R-wrSaiO4fInw&oe=6A411535"}, "display_name": "Math Quest VR", "keywords": ["education", "VR", "action", "singeplayer", "firstperson"], "long_description": "Math has never been this action-packed! Step into Math Quest VR, where solving problems means blasting bandits with your paintball gun. Travel through exciting worlds of Addition, Subtraction, Multiplication, and Division, unlocking new challenges along the way. Whether you're playing Story Mode to level up your skills or testing your speed in Arcade Mode, every shot brings you closer to math mastery.\n\nKey Features:\n- Solve math problems in a whole new way \u2013 aim, shoot, and answer to progress through thrilling levels.\n- Explore interactive worlds themed around Addition, Subtraction, Multiplication, and Division.\n- Choose your challenge \u2013 level up in Story Mode or race against time in Arcade Mode.\n- Sharpen your reflexes and your mind with fast-paced, brain-boosting gameplay.\n- Engage in immersive VR action that makes math fun, exciting, and rewarding.\n\nThink fast, shoot smart, and become a math legend in Math Quest VR!", "short_description": "Turn math into an adventure! Blast through interactive worlds of Addition, Subtraction, Multiplication, and Division. Play Story Mode to grow your skills or Arcade Mode for a fast-paced challenge!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://thedevhouseagency.com/Privacy_Policy_MathQuestVR.pdf", "developer_terms_of_service_url": null, "publisher_name": "Devhouse", "support_website_url": null, "website_url": "https://www.thedevhouseagency.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1043107547362485"}, {"id": "459781504968480"}, {"id": "374404007583481
71-25/473392298_969006928775886_7058059946160548103_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FgDE9y58RRUQ7kNvwE6pKX8&_nc_oc=AdpuSkrhNEkx1DZ3xW41yORS6EiNKvT4DPCrwbLjSYEBHO6crYajhgKaPLThTFP5oNM&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLobCf6FOvs5be7jsN0ijU8aGTf9iHRMnPn-g3tE0OMgA&oe=6AA5666F"}, {"file_name": "MQVR_metaStore_ss2.png", "id": "655824863632556", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391955_655824866965889_9083744742728821581_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C5CyAlMvAmoQ7kNvwGuVEgX&_nc_oc=AdrowuiZJbqZamF0jiCHFdPQQYuQMdLqlipCHx0yAR4hvGIBXRwflA81D2nar2uz81o&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL62Rhvk_ezhgVOJvruPIC4Qof-gCFvDKpSKsvY8XeEzQ&oe=6AA560C9"}, {"file_name": "MQVR_metaStore_ss5.png", "id": "640264872280351", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391924_640264875613684_2893261742097832448_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oIp_mA_5id0Q7kNvwGksBXw&_nc_oc=AdqsrCldYq7yB01VBYyR1M_rqLOIPjjfoNfod_2iwD2jBl5fE8CX1Yf1n2-uphUJqoE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ7iGdLjAad1UHnkLKp9e04fn9ZXC4LvwDYMYU-Rkqx6w&oe=6AA55D6A"}, {"file_name": "MQVR_metaStore_ss1.png", "id": "686879277133721", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473394268_686879280467054_8709353857892239785_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gnGvqMXj9rAQ7kNvwHGiQmx&_nc_oc=AdpK0fHXOR58q0ktzHCoIPbv1bOOwqR95f3XIdsVkJ7Fe9qNnwOpM6IN7o1ViHUqQC0&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJUP0Zjj2InrOz9IY4dQ1AF0-cFezc06LDXAFD50kuVnQ&oe=6AA54910"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Art - 2560x1440 (1).png", "id": "681083991246799", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391986_681083994580132_5877693932550353369_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s3-4n1BwwMMQ7kNvwHKtCu8&_nc_oc=AdrDnnyULSQ-9l4sML8vwMEabGx1hhAXJM1kqOZ3wd0snv6M5s6by1j0wx82xQN9Su8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ8CbFzNGVTriZfry6n8961RkEmXyo0vTzBY4X0OhrFSA&oe=6AA54735"}, "display_name": "Math Quest VR", "keywords": ["education", "VR", "action", "singeplayer", "firstperson"], "long_description": "Math has never been this action-packed! Step into Math Quest VR, where solving problems means blasting bandits with your paintball gun. Travel through exciting worlds of Addition, Subtraction, Multiplication, and Division, unlocking new challenges along the way. Whether you're playing Story Mode to level up your skills or testing your speed in Arcade Mode, every shot brings you closer to math mastery.\n\nKey Features:\n- Solve math problems in a whole new way \u2013 aim, shoot, and answer to progress through thrilling levels.\n- Explore interactive worlds themed around Addition, Subtraction, Multiplication, and Division.\n- Choose your challenge \u2013 level up in Story Mode or race against time in Arcade Mode.\n- Sharpen your reflexes and your mind with fast-paced, brain-boosting gameplay.\n- Engage in immersive VR action that makes math fun, exciting, and rewarding.\n\nThink fast, shoot smart, and become a math legend in Math Quest VR!", "short_description": "Turn math into an adventure! Blast through interactive worlds of Addition, Subtraction, Multiplication, and Division. Play Story Mode to grow your skills or Arcade Mode for a fast-paced challenge!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://thedevhouseagency.com/Privacy_Policy_MathQuestVR.pdf", "developer_terms_of_service_url": null, "publisher_name": "Devhouse", "support_website_url": null, "website_url": "https://www.thedevhouseagency.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1043107547362485"}, {"id": "459781504968480"}, {"id": "374404007583481
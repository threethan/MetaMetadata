71-25/473392298_969006928775886_7058059946160548103_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h2hJI1P1vxMQ7kNvwH_vLzY&_nc_oc=Adr0GUIw0nBJfbUuGtYPS-orrFre8xp5poLrE2QurDFEwsi4tHvA4BCOjRrVAzr80bk&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLTwocoj0aBBzl3XpSeYCTHPxcn-nO3VKacq7WaAzMfCg&oe=6ABA7E6F"}, {"file_name": "MQVR_metaStore_ss2.png", "id": "655824863632556", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391955_655824866965889_9083744742728821581_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=takvxiVDseoQ7kNvwEIoEP9&_nc_oc=AdouwpdBwrjLKU2Ro5eUn3sXr7qtO3A1aaprNaqEqZZ04Eo4hbG6EeLRUDX4byMOpjg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIYjuPFS3B7FNQtkZP4J6kHrq9Oy8K8-ENTnJUnz18WcQ&oe=6ABA78C9"}, {"file_name": "MQVR_metaStore_ss5.png", "id": "640264872280351", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391924_640264875613684_2893261742097832448_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YHvXGZ-nQKwQ7kNvwFsrZ2y&_nc_oc=AdqzDOnXCCAQV78v_aAegxWg0uM9vh1Lp17TshEE_llG3NQm0Snfjc6siNutqinRibo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKt3e_miphsWHgxoHmgBBQ8oHqtwbJgwSHYoGZFBUCKHA&oe=6ABA756A"}, {"file_name": "MQVR_metaStore_ss1.png", "id": "686879277133721", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473394268_686879280467054_8709353857892239785_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_0lIZJ4S4ZMQ7kNvwEPD3Er&_nc_oc=Adq4mJOKYk_vXFnr-C6iK7_KJb9uzPO3cashxSNnMFzdRjqB8pNF_ZZA0nz04V-2tO8&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJE3jooOTrcERtk3dxgmQm7YhsFmMnYS78shWWMNiEZnA&oe=6ABA6110"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Art - 2560x1440 (1).png", "id": "681083991246799", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391986_681083994580132_5877693932550353369_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sQwgNsPeYzYQ7kNvwEIfZBb&_nc_oc=AdpDnAvOustrK3xU2VaYWqLlOlr0CXp8Qf93Wqg2Luj-tV5tzIVygY3iap1GrArEoRM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKsqJtjKATMiO4PHSzyAhHFDFEqjeVoZEbNWglYak8UJw&oe=6ABA5F35"}, "display_name": "Math Quest VR", "keywords": ["education", "VR", "action", "singeplayer", "firstperson"], "long_description": "Math has never been this action-packed! Step into Math Quest VR, where solving problems means blasting bandits with your paintball gun. Travel through exciting worlds of Addition, Subtraction, Multiplication, and Division, unlocking new challenges along the way. Whether you're playing Story Mode to level up your skills or testing your speed in Arcade Mode, every shot brings you closer to math mastery.\n\nKey Features:\n- Solve math problems in a whole new way \u2013 aim, shoot, and answer to progress through thrilling levels.\n- Explore interactive worlds themed around Addition, Subtraction, Multiplication, and Division.\n- Choose your challenge \u2013 level up in Story Mode or race against time in Arcade Mode.\n- Sharpen your reflexes and your mind with fast-paced, brain-boosting gameplay.\n- Engage in immersive VR action that makes math fun, exciting, and rewarding.\n\nThink fast, shoot smart, and become a math legend in Math Quest VR!", "short_description": "Turn math into an adventure! Blast through interactive worlds of Addition, Subtraction, Multiplication, and Division. Play Story Mode to grow your skills or Arcade Mode for a fast-paced challenge!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://thedevhouseagency.com/Privacy_Policy_MathQuestVR.pdf", "developer_terms_of_service_url": null, "publisher_name": "Devhouse", "support_website_url": null, "website_url": "https://www.thedevhouseagency.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1043107547362485"}, {"id": "459781504968480"}, {"id": "374404007583481
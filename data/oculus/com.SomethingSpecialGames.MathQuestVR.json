71-25/473392298_969006928775886_7058059946160548103_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C3T_EkLS2hkQ7kNvwFvND0K&_nc_oc=AdpI8_p1lK0-ZWM6oEmT19WX5sl2X_yBVfyheaNWAMNzBS3sArJS-l7K8znw8WdJysk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRLm0w5QBMZzGx6gatmuKCoaCoje5POAhaSaWnOASrdKQ&oe=6AE9F46F"}, {"file_name": "MQVR_metaStore_ss2.png", "id": "655824863632556", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473391955_655824866965889_9083744742728821581_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IM_M_c_zjTQQ7kNvwGO5lv2&_nc_oc=Adr71gK8KKuWiy0LQgM1cAcYkOFlWq5CcQHS_iSU2GOo9FvXjQ618s4AsjsG749qVd0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ_XQcEJ1Y9zmuE-P800fUXfoPpn0TNWCPCct8VLnFG-w&oe=6AE9EEC9"}, {"file_name": "MQVR_metaStore_ss5.png", "id": "640264872280351", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473391924_640264875613684_2893261742097832448_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iiPiWDgmOvoQ7kNvwHAPLrJ&_nc_oc=AdrKUu15CczZNOG2JOHq5vP78FELlwgRTuj3bpwlX_Sbd5zkH46IW3unM0Uo90cCuOI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQWdMFTXF_ME5PMz0XqH2b6hm2QQmh5j76njXtPOOrgzQ&oe=6AE9EB6A"}, {"file_name": "MQVR_metaStore_ss1.png", "id": "686879277133721", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473394268_686879280467054_8709353857892239785_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bmpp08bFICkQ7kNvwF_XT31&_nc_oc=AdpYqKi7UjmSRBkxB-H21c6VVAQ9ixmNaqVuyoHfSDehyG2xLfZlisqA3Vz6f5b35NE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSwoe7Sqj0QvFY-EJWTMGtbKJ0p7GxY5GSgUHBf1elU_g&oe=6AEA0F50"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Art - 2560x1440 (1).png", "id": "681083991246799", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473391986_681083994580132_5877693932550353369_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A_QwRqlaDakQ7kNvwFJ2dhg&_nc_oc=Adp8kM4416x4uiBfaisyI363fesgppv4GBxbek1Gw76LLPb_Fc08EhemcfOjZJwRh2w&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRU4xJArb1yMGEGFByDvH2ADB95zcg8ofFAwds_Hrc1qw&oe=6AEA0D75"}, "display_name": "Math Quest VR", "keywords": ["education", "VR", "action", "singeplayer", "firstperson"], "long_description": "Math has never been this action-packed! Step into Math Quest VR, where solving problems means blasting bandits with your paintball gun. Travel through exciting worlds of Addition, Subtraction, Multiplication, and Division, unlocking new challenges along the way. Whether you're playing Story Mode to level up your skills or testing your speed in Arcade Mode, every shot brings you closer to math mastery.\n\nKey Features:\n- Solve math problems in a whole new way \u2013 aim, shoot, and answer to progress through thrilling levels.\n- Explore interactive worlds themed around Addition, Subtraction, Multiplication, and Division.\n- Choose your challenge \u2013 level up in Story Mode or race against time in Arcade Mode.\n- Sharpen your reflexes and your mind with fast-paced, brain-boosting gameplay.\n- Engage in immersive VR action that makes math fun, exciting, and rewarding.\n\nThink fast, shoot smart, and become a math legend in Math Quest VR!", "short_description": "Turn math into an adventure! Blast through interactive worlds of Addition, Subtraction, Multiplication, and Division. Play Story Mode to grow your skills or Arcade Mode for a fast-paced challenge!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://thedevhouseagency.com/Privacy_Policy_MathQuestVR.pdf", "developer_terms_of_service_url": null, "publisher_name": "Devhouse", "support_website_url": null, "website_url": "https://www.thedevhouseagency.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1043107547362485"}, {"id": "459781504968480"}, {"id": "374404007583481
71-25/473392298_969006928775886_7058059946160548103_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3KzWxAGy8pgQ7kNvwGilSbQ&_nc_oc=Ado8U9nntR5fwjIQs125wnTlzcyeTfzaFZxqSF9hvaVoBoy-KR6ocnCQp8mRvZup88M&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCxwHIkdvec7NyGXUl9qeXFfwpZLZq4j-4B9i2DkKwz2Q&oe=6A6B646F"}, {"file_name": "MQVR_metaStore_ss2.png", "id": "655824863632556", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391955_655824866965889_9083744742728821581_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y4ulhu2GJ9EQ7kNvwHD8pSU&_nc_oc=AdoY_Tpd4lWE-nmFqJS04239AbdyWTCNyMCNGG9v9FwTY8QRuqMKohdqyHNb14QR1Hg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCGfYVdVrdRNg-mZvZ_K1GHGhYwWwpRjihm3RPDS4VncA&oe=6A6B5EC9"}, {"file_name": "MQVR_metaStore_ss5.png", "id": "640264872280351", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391924_640264875613684_2893261742097832448_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-xvCkaD1gwIQ7kNvwFzZ5ij&_nc_oc=Adp-TYANewlTJNXPuHETy-Jvb9b1vXi_GeGDBN-8sY5Oeo53Qxbfz4ylhBpM8Ifz-50&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBv_qYseZQf-v1SHFsCSLd1ulFT6kvHwssNiJurDcfO8Q&oe=6A6B5B6A"}, {"file_name": "MQVR_metaStore_ss1.png", "id": "686879277133721", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473394268_686879280467054_8709353857892239785_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WEd1UIJi7FYQ7kNvwHAwowF&_nc_oc=AdqBXGyHO0__LIRRbHKsHU0SJWZV-mywuwev41RaWmOZu_kGPW7QpuShoZn7soN2KK0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAWWOZHg-sfKzyOBDT0_if2p0sa4LJgNIxl_IazkmQKyg&oe=6A6B4710"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Art - 2560x1440 (1).png", "id": "681083991246799", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391986_681083994580132_5877693932550353369_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MV55aRjm8H8Q7kNvwEvnPab&_nc_oc=Ado5TTs-THj47bA4cicwLoHqk9KBSevnKB-EIol38GPL1_pDJ58ETBqVRBfAgSg-qEI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCC8Rs6Wtqj_0EpZ4qu1TV9saZOOcXTZAm2nLGhriZXGA&oe=6A6B4535"}, "display_name": "Math Quest VR", "keywords": ["education", "VR", "action", "singeplayer", "firstperson"], "long_description": "Math has never been this action-packed! Step into Math Quest VR, where solving problems means blasting bandits with your paintball gun. Travel through exciting worlds of Addition, Subtraction, Multiplication, and Division, unlocking new challenges along the way. Whether you're playing Story Mode to level up your skills or testing your speed in Arcade Mode, every shot brings you closer to math mastery.\n\nKey Features:\n- Solve math problems in a whole new way \u2013 aim, shoot, and answer to progress through thrilling levels.\n- Explore interactive worlds themed around Addition, Subtraction, Multiplication, and Division.\n- Choose your challenge \u2013 level up in Story Mode or race against time in Arcade Mode.\n- Sharpen your reflexes and your mind with fast-paced, brain-boosting gameplay.\n- Engage in immersive VR action that makes math fun, exciting, and rewarding.\n\nThink fast, shoot smart, and become a math legend in Math Quest VR!", "short_description": "Turn math into an adventure! Blast through interactive worlds of Addition, Subtraction, Multiplication, and Division. Play Story Mode to grow your skills or Arcade Mode for a fast-paced challenge!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://thedevhouseagency.com/Privacy_Policy_MathQuestVR.pdf", "developer_terms_of_service_url": null, "publisher_name": "Devhouse", "support_website_url": null, "website_url": "https://www.thedevhouseagency.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1043107547362485"}, {"id": "459781504968480"}, {"id": "374404007583481
71-25/473392298_969006928775886_7058059946160548103_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jKvnOybc0KwQ7kNvwHL7C-2&_nc_oc=AdpGV24WeAUJMqSnPHSU4NbqUVItDG37fN8YAxeVm6UN09TXrc0xw5tOxEMJadEHYmk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOTGO_pUVlTja5Ug1vLFG47w_v5XG2KobvEqzfMeFXbjg&oe=6ABFC46F"}, {"file_name": "MQVR_metaStore_ss2.png", "id": "655824863632556", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473391955_655824866965889_9083744742728821581_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yNK_o02h_dsQ7kNvwGwX_Rr&_nc_oc=Adr4sAZ-pocVG9MUSvAykij8Km5BmxRbarcx9N2CkulDBDG7mXIZjg-JHDnTYmDvGKc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOAZo3M7jrplbt1orqPJGpp89sz7FY7RwdSrBDKOWGKlg&oe=6ABFBEC9"}, {"file_name": "MQVR_metaStore_ss5.png", "id": "640264872280351", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473391924_640264875613684_2893261742097832448_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1S1nBJMO2fkQ7kNvwGT69yF&_nc_oc=AdrSXfGwIR1N0iwOkfDvxPTxXD1FeelzGPfBb1j5rlfHz8VzgNNe7h9feAJ6pLXrazE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNTrlOHKjlBC0Y7UrCrtavQFe5dYdYhhQ9IWY7eWO0tKg&oe=6ABFBB6A"}, {"file_name": "MQVR_metaStore_ss1.png", "id": "686879277133721", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473394268_686879280467054_8709353857892239785_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6reTvVc-W2gQ7kNvwGxuHiV&_nc_oc=AdodkD-X_1tTHIyVVBe191Hym3eFxJdz55ZMv4CB4xvPGFYMdtGla6_2HBxcBNsU7os&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPSipVTN7HWMJ93OoM7fKFkN9FLKocz0wDSifxBfskIow&oe=6ABFDF50"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Art - 2560x1440 (1).png", "id": "681083991246799", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473391986_681083994580132_5877693932550353369_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RLPZJc7OT8oQ7kNvwHtQuFA&_nc_oc=AdpQY51UX1jehh81rWoj_emK2A4gE5HUqmQTGTmkkbycJuLXFaofc57Tt0kcmI6Dnqk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNMFt8iKN_s7RGtfTtVOfLgL_6varUrmQF3kOO4bQv1vw&oe=6ABFDD75"}, "display_name": "Math Quest VR", "keywords": ["education", "VR", "action", "singeplayer", "firstperson"], "long_description": "Math has never been this action-packed! Step into Math Quest VR, where solving problems means blasting bandits with your paintball gun. Travel through exciting worlds of Addition, Subtraction, Multiplication, and Division, unlocking new challenges along the way. Whether you're playing Story Mode to level up your skills or testing your speed in Arcade Mode, every shot brings you closer to math mastery.\n\nKey Features:\n- Solve math problems in a whole new way \u2013 aim, shoot, and answer to progress through thrilling levels.\n- Explore interactive worlds themed around Addition, Subtraction, Multiplication, and Division.\n- Choose your challenge \u2013 level up in Story Mode or race against time in Arcade Mode.\n- Sharpen your reflexes and your mind with fast-paced, brain-boosting gameplay.\n- Engage in immersive VR action that makes math fun, exciting, and rewarding.\n\nThink fast, shoot smart, and become a math legend in Math Quest VR!", "short_description": "Turn math into an adventure! Blast through interactive worlds of Addition, Subtraction, Multiplication, and Division. Play Story Mode to grow your skills or Arcade Mode for a fast-paced challenge!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://thedevhouseagency.com/Privacy_Policy_MathQuestVR.pdf", "developer_terms_of_service_url": null, "publisher_name": "Devhouse", "support_website_url": null, "website_url": "https://www.thedevhouseagency.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1043107547362485"}, {"id": "459781504968480"}, {"id": "374404007583481
71-25/473392298_969006928775886_7058059946160548103_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wrOpYPrk1ZUQ7kNvwHEGE0M&_nc_oc=AdqQUhS2pJd-1AP3-_w49WCAL-g3QarYFuQYA4muvcNvfF-28dwg-8lBeGqb_yHDNGA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBe3Fmh6kyE5kiUFmOVFvomJBBP42FX1dozbTGOmKUmpQ&oe=6A64CCEF"}, {"file_name": "MQVR_metaStore_ss2.png", "id": "655824863632556", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391955_655824866965889_9083744742728821581_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1yb4h5RqWVoQ7kNvwEnzE3T&_nc_oc=AdqP3I4DL8myKx_16EPo6Be4Q2JLltIUehXeftWIqSsMazRHbG5qYLh1xPkSqBh_pEY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDU-vUsOjavgZRvkiBsReyEYV1iD91hMsnB9mKjgO0Cmg&oe=6A64C749"}, {"file_name": "MQVR_metaStore_ss5.png", "id": "640264872280351", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391924_640264875613684_2893261742097832448_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kGgqXFS0lHUQ7kNvwHeCqqm&_nc_oc=AdqgzWHqvioasaaK8DTFQBV-8KNrJVde8g9X7F33pRc2qPLVMngOWn_DgiNyDoxG6_o&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD86369lf8DJmt3gdDc2XYx39fbMll9Skpw1buG1bcJyw&oe=6A64C3EA"}, {"file_name": "MQVR_metaStore_ss1.png", "id": "686879277133721", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473394268_686879280467054_8709353857892239785_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z4j-GwjznuUQ7kNvwHYQ0ql&_nc_oc=AdpJiOrXP2vG4vpkAxpxCHF5oSeRO4bGdTmBfyOZB78ln81QgTUdlRrQwjxHSJ_wMeE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD3dC_uNLl5XvgoExwceTdfMffx9DIJN8RaRdU18W1GXA&oe=6A64AF90"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Art - 2560x1440 (1).png", "id": "681083991246799", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391986_681083994580132_5877693932550353369_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CNEUwHK16cIQ7kNvwGr5lL8&_nc_oc=Ado1XOJDa7s33vACevfDTT2amwDH9A4naR2zJWslDooPGvp_e_TZ3wuC8huvRS9WBEU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDlotzM3P-UDjVqT518dMcKPLLg-Sh8o1dUIEUaUkH4TQ&oe=6A64ADB5"}, "display_name": "Math Quest VR", "keywords": ["education", "VR", "action", "singeplayer", "firstperson"], "long_description": "Math has never been this action-packed! Step into Math Quest VR, where solving problems means blasting bandits with your paintball gun. Travel through exciting worlds of Addition, Subtraction, Multiplication, and Division, unlocking new challenges along the way. Whether you're playing Story Mode to level up your skills or testing your speed in Arcade Mode, every shot brings you closer to math mastery.\n\nKey Features:\n- Solve math problems in a whole new way \u2013 aim, shoot, and answer to progress through thrilling levels.\n- Explore interactive worlds themed around Addition, Subtraction, Multiplication, and Division.\n- Choose your challenge \u2013 level up in Story Mode or race against time in Arcade Mode.\n- Sharpen your reflexes and your mind with fast-paced, brain-boosting gameplay.\n- Engage in immersive VR action that makes math fun, exciting, and rewarding.\n\nThink fast, shoot smart, and become a math legend in Math Quest VR!", "short_description": "Turn math into an adventure! Blast through interactive worlds of Addition, Subtraction, Multiplication, and Division. Play Story Mode to grow your skills or Arcade Mode for a fast-paced challenge!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://thedevhouseagency.com/Privacy_Policy_MathQuestVR.pdf", "developer_terms_of_service_url": null, "publisher_name": "Devhouse", "support_website_url": null, "website_url": "https://www.thedevhouseagency.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1043107547362485"}, {"id": "459781504968480"}, {"id": "374404007583481
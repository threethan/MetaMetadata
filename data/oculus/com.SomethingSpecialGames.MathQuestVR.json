71-25/473392298_969006928775886_7058059946160548103_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xuxIHlMV3vkQ7kNvwFZ020G&_nc_oc=AdqKvixerQkb3kfF5JJQHQqx3AfG0mTf9L255eq_7FMENLwDOcsUr3xQ9VqB6DgP7Uw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSHtZPjiv03ypVmP-lvX2hhZu3RAbsSrnaRuL9QYVVN_g&oe=6AF1DD6F"}, {"file_name": "MQVR_metaStore_ss2.png", "id": "655824863632556", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391955_655824866965889_9083744742728821581_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UkO0EHPA3eoQ7kNvwF6NY2n&_nc_oc=AdpKqnLzTeaVaiUERfb5qwPKwubzg0nGTH9RT0BVkM60gmwP5w9WuhNsEhC16fnc484&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTEG17Zw7GC97W09PwkBLd8-_YyO9IW0C4nEsB_gq5yvQ&oe=6AF1D7C9"}, {"file_name": "MQVR_metaStore_ss5.png", "id": "640264872280351", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391924_640264875613684_2893261742097832448_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OZEUtKrTOKkQ7kNvwHvs-k2&_nc_oc=Adrjzn5BuYLr8EXqn1eV1xTal-LkP8c4FIibyXcqt18MqVl-p-qbQixOVUTbPIHHdrE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSeXLDIcyu4s0j9Zm8miaEXlQz6CUx6wbQpzMiZzDVjfg&oe=6AF1D46A"}, {"file_name": "MQVR_metaStore_ss1.png", "id": "686879277133721", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473394268_686879280467054_8709353857892239785_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dfHtwPM_aZoQ7kNvwGVQ3va&_nc_oc=Adp8B1mN3oZuvc6vRaAD92q3AIEt6ys6Kr47SfVDXcUcQrP8Z2296xn6pL2ONwd_Jw0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRR_kkqmmsepSGqQu9P1FTBIvm11MDboTqZvXczWWNDNQ&oe=6AF1F850"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Art - 2560x1440 (1).png", "id": "681083991246799", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391986_681083994580132_5877693932550353369_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gwHYfmrh-dUQ7kNvwHpnCuF&_nc_oc=Adpi6Oxey8sXRyL00akmlaUJLU1ghCg5-OwCN8Twy8uidzM2oDI5Socmu-lwIV_70v0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTSmtsprIj9B36Bx0VgPLdU0SxuEAdBiJzJZ0lpfIc7jA&oe=6AF1F675"}, "display_name": "Math Quest VR", "keywords": ["education", "VR", "action", "singeplayer", "firstperson"], "long_description": "Math has never been this action-packed! Step into Math Quest VR, where solving problems means blasting bandits with your paintball gun. Travel through exciting worlds of Addition, Subtraction, Multiplication, and Division, unlocking new challenges along the way. Whether you're playing Story Mode to level up your skills or testing your speed in Arcade Mode, every shot brings you closer to math mastery.\n\nKey Features:\n- Solve math problems in a whole new way \u2013 aim, shoot, and answer to progress through thrilling levels.\n- Explore interactive worlds themed around Addition, Subtraction, Multiplication, and Division.\n- Choose your challenge \u2013 level up in Story Mode or race against time in Arcade Mode.\n- Sharpen your reflexes and your mind with fast-paced, brain-boosting gameplay.\n- Engage in immersive VR action that makes math fun, exciting, and rewarding.\n\nThink fast, shoot smart, and become a math legend in Math Quest VR!", "short_description": "Turn math into an adventure! Blast through interactive worlds of Addition, Subtraction, Multiplication, and Division. Play Story Mode to grow your skills or Arcade Mode for a fast-paced challenge!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://thedevhouseagency.com/Privacy_Policy_MathQuestVR.pdf", "developer_terms_of_service_url": null, "publisher_name": "Devhouse", "support_website_url": null, "website_url": "https://www.thedevhouseagency.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1043107547362485"}, {"id": "459781504968480"}, {"id": "374404007583481
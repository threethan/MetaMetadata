ebug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1403590829512759", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1421525591052616"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "29426001607010916"}]}, "change_log": "\"Human Anatomy XR \u2013 Competition Build v1.0\r\n\r\nInitial release for the Meta VR Start Developer Competition 2026.\r\n\r\nFeatures:\r\n- Interactive 3D human anatomy exploration in VR and Mixed Reality.\r\n- Detailed anatomical models of the skeletal, muscular, organ, and nervous systems.\r\n- Grab, rotate, and two-hand scale anatomical structures.\r\n- Interactive snapping and object identification.\r\n- Educational information panels with voice narration.\r\n- Hand tracking and Touch controller support.\r\n- Interactive quiz mode.\r\n- Optimized for Meta Quest standalone devices.\"", "created_date": 1794675841, "id": "1404472776091231", "version": "1.0", "version_code": 1, "release_status": "PENDING", "status": "CHANGES_REQUESTED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}]}}, "viewer": {"user": null}}}
.com&_nc_ss=7f30f&oh=00_AQVpNocUFm4TfGxzi8c2iliWiwqdO2QYLsPF-DvCNAHNyQ&oe=6B103EE0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Human Anatomy - Unity Character Cover.png", "id": "1493285309284234", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499626806_1493285312617567_5746396558528030539_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UrVTsuBKFyYQ7kNvwG6kxhj&_nc_oc=AdoZtNW19UKBQB2fwvEJNZmNvHXkSuPGdOUP4HpKyG7FXotj0uDwFTQvfMLElvIlS2w&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQU_9VIy9L8FWwyYW06JljTHQQMzHxpKy46C4A0Ap_3aYw&oe=6B10664A"}, "display_name": "Human Anatomy XR", "keywords": ["HumanAnatomy", "MedicalEducation", "AnatomyVR", "MixedReality", "3DAnatomy"], "long_description": "**Human Anatomy XR \u2013 Explore. Interact. Learn.**\n\nStep inside an immersive world of human anatomy with Human Anatomy XR, an interactive educational experience designed for Meta Quest.\n\nExplore detailed 3D anatomical structures in Virtual Reality (VR) or bring them into your real-world surroundings through Mixed Reality (MR). Learn by interacting with the human body rather than simply viewing static illustrations.\n\n**Key Features**\n\n- **Immersive VR & Mixed Reality:** Explore anatomy in a virtual environment or alongside your physical surroundings using passthrough.\n- **Detailed 3D Anatomy:** Examine bones, muscles, organs, the nervous system, and other anatomical structures.\n- **Natural Hand Tracking:** Grab and interact with anatomical models using intuitive hand gestures.\n- **Touch Controller Support:** Navigate and explore using Meta Quest controllers.\n- **Interactive Manipulation:** Grab, rotate, resize, and reposition anatomical structures with smooth snapping interactions.\n- **Educational Voice Narration:** Discover anatomical information through text explanations and spoken guidance.\n- **Interactive Quiz Mode:** Test your knowledge and reinforce your understanding of human anatomy.\n- **Immersive Navigation:** Move around the learning environment with teleportation and locomotion controls.\n\n**Learn Anatomy Through Interaction**\n\nDesigned for students, educators, medical enthusiasts, and curious learners, Human Anatomy XR makes exploring complex anatomical structures mor", "short_description": "Explore human anatomy like never before in Virtual Reality and Mixed Reality. Discover detailed 3D anatomical structures, interact naturally using hand tracking or controllers, and learn through interactive exploration, educational voice narration, and engaging quizzes. Grab, scale, and examine bones, muscles, organs, and more in an immersive learning environment."}]}, "developer_name": null, "developer_privacy_policy_url": "https://xrviewlabs.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "XRViewLabs", "support_website_url": "https://xrviewlabs.com/", "website_url": "https://xrviewlabs.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}, {"id": "478089301798119"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1403590856179423"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1796488318250278"}]}, "baseline_offer": {"id": "1796488318250278"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1795795920, "status": "PUBLISHED", "id": "1796488318250278"}]}, "liveChannel": {"nodes": [{"late
": "1832864070971391", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499305050_1832864074304724_4601033764888528627_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g4N9z8qNhI4Q7kNvwFTNgnA&_nc_oc=AdqZ0Do9usQVuT1AC6id3eBbIvMFulrSqyzE9BLVPTYOKlLFVQ-J1oH6M0np83lS6SQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQUyE54vlMZl-4vfA3pI4RKMkxeG_mw2uHvz_Qj7-F1EGQ&oe=6B104757"}, {"file_name": "4.png", "id": "750666551308588", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491828806_750666554641921_6704941853840880582_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zdSEhKqzy54Q7kNvwHbPUQj&_nc_oc=AdpyM4YAXjgn-vI-xpgkMv88QlIv-fpFSGQIbCX_zIu0rD7i_C1ukLusR74gmtLuCpk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWO6Btqj7BzrBiLJtM10RTNp3rIVq89TakLiOUzuyoPTw&oe=6B103DB6"}, {"file_name": "5.png", "id": "1249407823870747", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491825034_1249407827204080_2503758069180921033_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AfDzhSlUhtEQ7kNvwF4hlRK&_nc_oc=AdrNefR6s2oJPavB4nHeawdU0VBMsaBQ-Z4X4YcPrx2qZVuYvf400F-v7k20N1fqbGs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVMvgBs9JoCtHzuE67pvufx5owyj0xNChlujfj1Y8taYQ&oe=6B106A82"}, {"file_name": "1.png", "id": "1316449626595666", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499298291_1316449629928999_4818451044318334154_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7XAhRl-BTokQ7kNvwERiNci&_nc_oc=AdrQcmC7T__-pEe8av57a8oUuqWc7Oxw68vZVx-ghkTjNOIIVUOmLQWPsGzlDeEY704&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQUA7X6Vk-bh4Wu_-oXoX8reZqglvv6ealqlLuB8Z13dGQ&oe=6B1038E1"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Iraq Virtual Museum", "keywords": [], "long_description": "This application serves as a digital gateway to Iraq\u2019s cultural heritage by documenting and presenting more than 15 significant heritage sites across the country. Through immersive virtual tours, users are able to explore these historic locations remotely, gaining insights into their architectural, cultural, and historical value without the need for physical presence. The platform is designed not only for local audiences, but also for people around the world, providing access to Iraq\u2019s heritage beyond geographical boundaries. In doing so, the application contributes to cultural preservation, education, and global awareness, while also promoting Iraq as a destination of historical and cultural importance.", "short_description": "This application showcases and documents more than 15 heritage sites across Iraq, offering users immersive virtual tours that highlight their cultural and historical significance. By enabling remote access, the app allows people everywhere \u2014 both within Iraq and abroad \u2014 to experience and learn about these important landmarks without the need to visit in person."}]}, "developer_name": null, "developer_privacy_policy_url": "https://qaflab.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "QAF Lab", "support_website_url": null, "website_url": "http://www.qaflab.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}, {"id": "1043107547362485"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ar"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "2469816885317
": "1832864070971391", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499305050_1832864074304724_4601033764888528627_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Rnsc-8Yl5AMQ7kNvwEZFJS_&_nc_oc=AdrBzm7ZBObzfsLdLpCACpSo69-H2l9uz0DVmBfonXi_o8g-8JzHjyIq7LsuRecmGDo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS_1k5F9pjgYB_941llhWbc4PfOPHcFwIbvfaQDbYQADA&oe=6B01C6D7"}, {"file_name": "4.png", "id": "750666551308588", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491828806_750666554641921_6704941853840880582_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r5QjJms4JIYQ7kNvwH5e8hB&_nc_oc=AdqbaOGRPqTNUK19bUoWbqwaI7soy_-yAlxyR3F_N4XS5GhATcVCrvIT6G3IUiCyBFE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQeFNq83rusgTDkQNhpx1CL0LkZ6ouTdwsIySP0SarWmQ&oe=6B01BD36"}, {"file_name": "5.png", "id": "1249407823870747", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491825034_1249407827204080_2503758069180921033_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DTA8OIr-Zl8Q7kNvwExC7y4&_nc_oc=AdqsbcC5b9HtCm4tdl7IuynPhYjax4T0DXi-66f0VlUxxTLsMx-23CvQVqEw8O5pVvk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR0N2Wea7Odt7e7RVjz7ZuuQcHL7t9y1HJzzdl4wj1gRA&oe=6B01EA02"}, {"file_name": "1.png", "id": "1316449626595666", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499298291_1316449629928999_4818451044318334154_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eW2E1YbvTo4Q7kNvwFRd-lf&_nc_oc=AdpXIdVMufTZtLhRT6O6_9vDFbEgMR7B64xoMbz1aEcxMtr9hIwfbe7tjgBYWtLvRwc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTNN2L920m-vhIFqJ2ca_Js2J7c_Hph2pJFz3B-c9v86w&oe=6B01B861"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Iraq Virtual Museum", "keywords": [], "long_description": "This application serves as a digital gateway to Iraq\u2019s cultural heritage by documenting and presenting more than 15 significant heritage sites across the country. Through immersive virtual tours, users are able to explore these historic locations remotely, gaining insights into their architectural, cultural, and historical value without the need for physical presence. The platform is designed not only for local audiences, but also for people around the world, providing access to Iraq\u2019s heritage beyond geographical boundaries. In doing so, the application contributes to cultural preservation, education, and global awareness, while also promoting Iraq as a destination of historical and cultural importance.", "short_description": "This application showcases and documents more than 15 heritage sites across Iraq, offering users immersive virtual tours that highlight their cultural and historical significance. By enabling remote access, the app allows people everywhere \u2014 both within Iraq and abroad \u2014 to experience and learn about these important landmarks without the need to visit in person."}]}, "developer_name": null, "developer_privacy_policy_url": "https://qaflab.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "QAF Lab", "support_website_url": null, "website_url": "http://www.qaflab.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}, {"id": "1043107547362485"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ar"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "2469816885317
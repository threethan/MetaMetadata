": "1832864070971391", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499305050_1832864074304724_4601033764888528627_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4aPxcZsm-Z8Q7kNvwEwCmGT&_nc_oc=AdoNeIy8VmdlNiX66BAbf5e9yvDD20MyV2Dao3sio0dTLg3kfaCJOrrLUe0sfEhhojM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSPtr17npZetTIO7f9bGkfYvmMEjMzhvImldXl9Zl3YxQ&oe=6B007557"}, {"file_name": "4.png", "id": "750666551308588", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491828806_750666554641921_6704941853840880582_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u3Tqlr51pLcQ7kNvwHAIJy3&_nc_oc=AdoaU9fdeb0BZk5bjvazoFGurfGMQ_5w1pcWGPEGTIN0JWnUGXjkyyQNRE8rn9bvDLs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQM5fpwlrQK3_lUUHHvZQvwOuYC2_GYrUI91KA0ZxQngg&oe=6B006BB6"}, {"file_name": "5.png", "id": "1249407823870747", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491825034_1249407827204080_2503758069180921033_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ImhgyuPvmAQQ7kNvwEvMSAL&_nc_oc=AdqcHs_-fpm7zuPQKUJzm7tfX2cxy5J2XbJGUFpnGk0BYy3yx9vCJ4668EsX9xHmUN4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQkNdPKwqSw_DauhGruMRO205ET6oOExxNRVKqMtXYcyw&oe=6B006042"}, {"file_name": "1.png", "id": "1316449626595666", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499298291_1316449629928999_4818451044318334154_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eW2E1YbvTo4Q7kNvwESYrqx&_nc_oc=AdrJGUR5ZAjop_2DIiElPi0dHaOuON2KT12eE7yJgHhQ6bpHXalyQuLe6y0Q7nBu-Eo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSWM8bYvMiNYUMwVCwdyiQz7kLB-kDq8k7ZP7bXXDIvIQ&oe=6B0066E1"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Iraq Virtual Museum", "keywords": [], "long_description": "This application serves as a digital gateway to Iraq\u2019s cultural heritage by documenting and presenting more than 15 significant heritage sites across the country. Through immersive virtual tours, users are able to explore these historic locations remotely, gaining insights into their architectural, cultural, and historical value without the need for physical presence. The platform is designed not only for local audiences, but also for people around the world, providing access to Iraq\u2019s heritage beyond geographical boundaries. In doing so, the application contributes to cultural preservation, education, and global awareness, while also promoting Iraq as a destination of historical and cultural importance.", "short_description": "This application showcases and documents more than 15 heritage sites across Iraq, offering users immersive virtual tours that highlight their cultural and historical significance. By enabling remote access, the app allows people everywhere \u2014 both within Iraq and abroad \u2014 to experience and learn about these important landmarks without the need to visit in person."}]}, "developer_name": null, "developer_privacy_policy_url": "https://qaflab.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "QAF Lab", "support_website_url": null, "website_url": "http://www.qaflab.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}, {"id": "1043107547362485"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ar"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "2469816885317
": "1832864070971391", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499305050_1832864074304724_4601033764888528627_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wHdl4fnywXsQ7kNvwFESIs1&_nc_oc=AdqARrulaxSj0p85DuoKJEpWFDfo18X1r0uXxOk9QWbEkgdfJeKtKrhtraHXBS1YoGw&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT6x-7_UZr8vXiLqXJcy8zKATke7AltBVWAMX5YgMm9hg&oe=6AFC80D7"}, {"file_name": "4.png", "id": "750666551308588", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491828806_750666554641921_6704941853840880582_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GrObBw8kkSAQ7kNvwFZ-ObM&_nc_oc=AdoqKa71V-bREaiZR0fMz5hV8XAVbC3scGVAiSrXZSX2GOg8prz3w2tFf3-eBvBrCNM&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTJocDy5OgoAIpE18XyC5CLIGevEKDR-4UwfL_IPAokmA&oe=6AFC7736"}, {"file_name": "5.png", "id": "1249407823870747", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491825034_1249407827204080_2503758069180921033_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MqwkoLHgmGwQ7kNvwHJe0y3&_nc_oc=Adp_FptaKUKmmFHTvcwUpbe32Od5AzNV_kGX0XsB9ihw5qzXQAgb5fiK77ntDuBkUK0&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTzY7xuQcqKY0leUKnqUWJke6HCmZvQdUntoMC6jDJnoQ&oe=6AFC6BC2"}, {"file_name": "1.png", "id": "1316449626595666", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499298291_1316449629928999_4818451044318334154_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=stR-dgW_9SoQ7kNvwEQC8dA&_nc_oc=Adr4fVdN80NpgR8mql1CZPZut5w8D_jfl9wSV8_8-vV5lpFe04YsIubUEL4Tm3Ypotk&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTh26WaHB55TWq5NxKHNr6gjONlu1Y5N5I6Pk5oubAr-A&oe=6AFC7261"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Iraq Virtual Museum", "keywords": [], "long_description": "This application serves as a digital gateway to Iraq\u2019s cultural heritage by documenting and presenting more than 15 significant heritage sites across the country. Through immersive virtual tours, users are able to explore these historic locations remotely, gaining insights into their architectural, cultural, and historical value without the need for physical presence. The platform is designed not only for local audiences, but also for people around the world, providing access to Iraq\u2019s heritage beyond geographical boundaries. In doing so, the application contributes to cultural preservation, education, and global awareness, while also promoting Iraq as a destination of historical and cultural importance.", "short_description": "This application showcases and documents more than 15 heritage sites across Iraq, offering users immersive virtual tours that highlight their cultural and historical significance. By enabling remote access, the app allows people everywhere \u2014 both within Iraq and abroad \u2014 to experience and learn about these important landmarks without the need to visit in person."}]}, "developer_name": null, "developer_privacy_policy_url": "https://qaflab.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "QAF Lab", "support_website_url": null, "website_url": "http://www.qaflab.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}, {"id": "1043107547362485"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ar"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "2469816885317
nt-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_ruP-8sOokW8IRif343pJl6w0xAq7-ikH4_VwDsolaVA&oe=6A3407C2"}, {"file_name": "1.png", "id": "1316449626595666", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499298291_1316449629928999_4818451044318334154_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0tm3EvYkzPQQ7kNvwFdJiBY&_nc_oc=AdoxI2DLybpI8GpFzCu_tBJYL_LPQVW3bl9MOByh_ono4WtAhEwvAJWpJ1MgcHScEFs&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-BFg3-JlNhD6LcFxp4iU6u2tAl9FPghT968d5CZj7Rkg&oe=6A340E61"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Iraq Virtual Museum", "keywords": [], "long_description": "This application serves as a digital gateway to Iraq\u2019s cultural heritage by documenting and presenting more than 15 significant heritage sites across the country. Through immersive virtual tours, users are able to explore these historic locations remotely, gaining insights into their architectural, cultural, and historical value without the need for physical presence. The platform is designed not only for local audiences, but also for people around the world, providing access to Iraq\u2019s heritage beyond geographical boundaries. In doing so, the application contributes to cultural preservation, education, and global awareness, while also promoting Iraq as a destination of historical and cultural importance.", "short_description": "This application showcases and documents more than 15 heritage sites across Iraq, offering users immersive virtual tours that highlight their cultural and historical significance. By enabling remote access, the app allows people everywhere \u2014 both within Iraq and abroad \u2014 to experience and learn about these important landmarks without the need to visit in person."}]}, "developer_name": null, "developer_privacy_policy_url": "https://qaflab.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "QAF Lab", "support_website_url": null, "website_ur
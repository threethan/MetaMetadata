uZMYcp6zluyp-vB9Pgm5_eN2pA3F_54AFDKzShqPZ4-tTx9HearDM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQtcCTO83CDkri7sIlnbWu6v0fwraPmyFg2_gjawEu5lA&oe=6B01CD81"}, {"file_name": "chess.png", "id": "2309669823117624", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499620860_2309669826450957_575177209625239837_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fp3_73VT-7oQ7kNvwFO2Lv6&_nc_oc=Adri1j576JbuW59EjCBDNGN-eIDUHoZZs0pYWfGDSn94b83sUNaNaAtNUuT0dHxRf8o&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTLCsyZSgGpIC9lFZL7_JghQm7rvO3JNjZiQElc-SR0Lg&oe=6B01EB37"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "KakaoTalk_20250328_185146491.png", "id": "656794397202241", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473392051_656794400535574_1418840741366665491_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HlEzI_s7VPYQ7kNvwFT1XJV&_nc_oc=AdoPQomMSjDYKYbY0TaNs2T-H1w6cj9FWEBI2g7sSSDhxgr1Fe0uU002xb8dbfXJqKQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT3eUAoAybVWlgkWQcLmTgFP60w3kr87CSmgO1bTkHNuA&oe=6B01C104"}, "display_name": "MUA - XR Meditation Solution", "keywords": ["Meditation", "Health", "Travel", "Entertainment", "Relax"], "long_description": "# MUA is an XR meditation platform developed for HMD, designed to help you conveniently recover your emotional balance. \n\nBased on your biosignals, MUA identifies your current emotional state and recommends the best meditation you need most in this moment. MIND-C AI interprets human emotion along a continuous spectrum, calculating the degree of fitness between your emotional states and the most suitable meditation content.\n\nThrough the AI analysis, MUA provides meditation contents that align closely with your emotional flow, which serves as a core feature of MUA. Within an immersive XR environment, the recommended content guides you to connect more deeply with your inner self, cultivating stability and tranquility.\n\n# EXPANDING BOUNDARIES \n\nMUA uses Extended Reality to dissolve the boundary between real and virtual world, transforming everyday spaces into immersive meditation environments.\n\n{1332495678123944}\n\n# HYPER PERSONALIZATION\n\nMUA syncs with healthcare devices(iOS & Apple Watch 6(WatchOS 11.6), Android & Galaxy watch 7 or later) to analyze physical and mental states in real time, recommending meditation contents tailored to condition at each moment. \n\n{1493529051760428}\n\n# DEEP SOUNDBATH\n\nIn collaboration with meditation experts, MUA incorporates soundscapes based on 432Hz frequency from solfeggio techniques to promote calmness and deep immersion. By Harmoniously blending with Korean traditional instruments, MUA delivers a universal healing experience that bridges modern meditation with the richness of Korean traditional music.\n\n{1477994243455147}\n\n", "short_description": "Did Your Mind Find a Moment of True Peace Today?\n\nMUA is an XR meditation platform for HMDs that helps you restore emotional balance anytime and anywhere.\nPowered by MIND-C AI, our Emotion Inference Artificial Intelligence, MUA analyzes biosignals (heart rate, HRV, oxygen saturation, etc.) from healthcare devices like smart watches and mirrors.\nMUA identifies your current emotional state and recommends personalized meditation content best suited for your condition. "}]}, "developer_name": "Com2us N", "developer_privacy_policy_url": "https://muameditation.com/en/board/legal/view.do?seq=L0000004", "developer_terms_of_service_url": null, "publisher_name": "Com2us N", "support_website_url": null, "website_url": "https://muameditation.com/en/main.do", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ko", "ja", "es"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "28608604038740730"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499619704_1421351609846281_693410736465074308_n.png?stp=dst-png_s360x360&_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PkE_CKl0AYoQ7kNvwFiNL7W&_nc_oc=AdpIkEaWNFqFGdHdqrWtYPWDlYmMQYWvz3zYJzNCUrj2s54m6jnJCP580UZ2eYgfGc4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTyINvZ-uvaE1Ru19eOtx11c4QmQF4Lu8bvwPk_yGG7Lw&oe=6B01D174"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "MUA - XR Meditation Solution", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_name": "Fitness & Wellness", "id": "810139357995560"}], "release_date": 1741742580, "lastRevision": {"nodes": [{"id": "9962138720480544", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "9962138687147214", "is_first_party": false, "enables_in_app_ads": false, "is_concept": false, "platform": "ANDROID_6DOF"}, "iarc_cert": {"id": "3691794984445816"}, "iarc_email": null, "msrp": null, "translations": {"nodes": [{"images": {"nodes": [{"file_name": "2.4 \ucee4\ubc84\uc544\ud2b8(mini-landscape).png", "id": "9564403546936971", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473392314_9564403556936970_975815007196793534_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4pw80aH1EuAQ7kNvwG7qX3K&_nc_oc=Adq-f1NDA1dWBGfD9t_Kb0
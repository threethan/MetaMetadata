nQgT9u2NNKveeJgiD3qaYqoSjF4vvlAjuJDwYBTFQ17C9t8DLgLbg&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTknpRwAlOba63bx3m8urQ74vid88YqhU9iikKkc5dlZw&oe=6AFC8781"}, {"file_name": "chess.png", "id": "2309669823117624", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499620860_2309669826450957_575177209625239837_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n73fRwuXAw4Q7kNvwFXLQob&_nc_oc=Adp8Kn6qsb8fhrQz7V_XefewWWLuJCBR8QDZXG14og1p2totXvIIeZIl8TfRAo2a6RQ&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRWyw-iZ1QBT24WzhBC1vD_5sLxM0NapvNGtn2dlKSNvA&oe=6AFC6CF7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "KakaoTalk_20250328_185146491.png", "id": "656794397202241", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473392051_656794400535574_1418840741366665491_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Whf1m_mCpWYQ7kNvwGXvuVH&_nc_oc=AdqR5wNYJAxiYGZgC8cgeezhqESF7Ki_NSl9DBlUhsavIsAoHznNmr6oTUEn9tMi0wM&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ_M0l9L4XeenRtq_t4h6yyJF1zTl5B3Wg2AEKM7HZwkA&oe=6AFC7B04"}, "display_name": "MUA - XR Meditation Solution", "keywords": ["Meditation", "Health", "Travel", "Entertainment", "Relax"], "long_description": "# MUA is an XR meditation platform developed for HMD, designed to help you conveniently recover your emotional balance. \n\nBased on your biosignals, MUA identifies your current emotional state and recommends the best meditation you need most in this moment. MIND-C AI interprets human emotion along a continuous spectrum, calculating the degree of fitness between your emotional states and the most suitable meditation content.\n\nThrough the AI analysis, MUA provides meditation contents that align closely with your emotional flow, which serves as a core feature of MUA. Within an immersive XR environment, the recommended content guides you to connect more deeply with your inner self, cultivating stability and tranquility.\n\n# EXPANDING BOUNDARIES \n\nMUA uses Extended Reality to dissolve the boundary between real and virtual world, transforming everyday spaces into immersive meditation environments.\n\n{1332495678123944}\n\n# HYPER PERSONALIZATION\n\nMUA syncs with healthcare devices(iOS & Apple Watch 6(WatchOS 11.6), Android & Galaxy watch 7 or later) to analyze physical and mental states in real time, recommending meditation contents tailored to condition at each moment. \n\n{1493529051760428}\n\n# DEEP SOUNDBATH\n\nIn collaboration with meditation experts, MUA incorporates soundscapes based on 432Hz frequency from solfeggio techniques to promote calmness and deep immersion. By Harmoniously blending with Korean traditional instruments, MUA delivers a universal healing experience that bridges modern meditation with the richness of Korean traditional music.\n\n{1477994243455147}\n\n", "short_description": "Did Your Mind Find a Moment of True Peace Today?\n\nMUA is an XR meditation platform for HMDs that helps you restore emotional balance anytime and anywhere.\nPowered by MIND-C AI, our Emotion Inference Artificial Intelligence, MUA analyzes biosignals (heart rate, HRV, oxygen saturation, etc.) from healthcare devices like smart watches and mirrors.\nMUA identifies your current emotional state and recommends personalized meditation content best suited for your condition. "}]}, "developer_name": "Com2us N", "developer_privacy_policy_url": "https://muameditation.com/en/board/legal/view.do?seq=L0000004", "developer_terms_of_service_url": null, "publisher_name": "Com2us N", "support_website_url": null, "website_url": "https://muameditation.com/en/main.do", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "REQUIRED", "genres": [], "has_in_app_ads": null, "interne
cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=En2RmCmLThAQ7kNvwEAR9sZ&_nc_oc=AdogkBXoEJrgUBSSDj9hR58yI3oqD3lmNRycNydmXWtuOgXrVehMSmXe1TxFXtcG8BQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRs-2dOofXmrzgJ92LavKz_Hii-dckwHiRjg3biN0dqGg&oe=6AF1DF8E"}, {"file_name": "#10_02_Dashboard_02_1&2(Eng).png", "id": "1017024270774596", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499622315_1017024274107929_304677281436918365_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2o7NSswe21oQ7kNvwFqmWNM&_nc_oc=AdrF8wURoTRdRskaeyuSU61zzcb_YUypyrzOfcSPZ-A_oqd1TKqglb23zInnPSPYoEw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQij6j46pXtm4kbh-1Byq-LQFVt0MgHxD2V9zGluV6XbA&oe=6AF206FB"}, {"file_name": "#14_06_01 _MIND PALACE_Setting_Custom_2(Eng).png", "id": "1530637181863317", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499622276_1530637185196650_1275460267889062610_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JE1a-E7L6jcQ7kNvwGne2WB&_nc_oc=AdrFL_aEZ5wJX8SP2Pj-_XBDWSH1xADnJf2iAWWVw852Sa0ZJQ4wRQ1We12_QmfH7vk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTB19JWMX6eaLnMojBur1HlBHHnwyhHqgcmxPFXBcS1xA&oe=6AF1EC8E"}, {"file_name": "KakaoTalk_Photo_2026-06-11-11-16-16.png", "id": "1005462785737358", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499622285_1005462789070691_8009636575197333066_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gMBF4csYAUsQ7kNvwGbnOdZ&_nc_oc=AdplN5ZzjtwrntNUvk02T55idZDCGRhgqwciDk6fwNBHa4ouIx6-f_823kNcHkHJ5ZM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQScvGaaCD4btCQCIoMbT0K7vbCpyvhqwDF4q_cxD-BrwA&oe=6AF1FB81"}, {"file_name": "chess.png", "id": "2309669823117624", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499620860_2309669826450957_575177209625239837_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uDvoPBNE8C8Q7kNvwGelBQz&_nc_oc=AdrWH6Y_rdC-uga_YUUqUs_zK7TDlt2g2YxizzP9kh7tu9hfHROqhBU1lkFkrBs7Uq8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTkTcw8bnMWZLNQwPTfrTZc6ITDz6AQnFayl26ALjgaYg&oe=6AF1E0F7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "KakaoTalk_20250328_185146491.png", "id": "656794397202241", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473392051_656794400535574_1418840741366665491_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XR9aZRftmTYQ7kNvwECEsPi&_nc_oc=AdqGKTDCVN6rnwO5C0UWRru0XfPOUD7UyeUUSRc0DCfza4AqQG6eUsVazzSlB_YZRkc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT9AAjSjYm-y9DrPv8R_9ZhDiZbnhEu6nstTaxv9uvogQ&oe=6AF1EF04"}, "display_name": "MUA - XR Meditation Solution", "keywords": ["Meditation", "Health", "Travel", "Entertainment", "Relax"], "long_description": "# MUA is an XR meditation platform developed for HMD, designed to help you conveniently recover your emotional balance. \n\nBased on your biosignals, MUA identifies your current emotional state and recommends the best meditation you need most in this moment. MIND-C AI interprets human emotion along a continuous spectrum, calculating the degree of fitness between your emotional states and the most suitable meditation content.\n\nThrough the AI analysis, MUA provides meditation contents that align closely with your emotional flow, which serves as a core feature of MUA. Within an immersive XR environment, the recommended content guides you to connect more deeply with your inner self, cultivating stability and tranquility.\n\n# EXPANDING BOUNDARIES \n\nMUA uses Extended Reality to dissolve the boundary between real and virtual world, transforming everyday spaces into immersive meditation environments.\n\n{1332495678123944}\n\n# HYPER PERSONALIZATION\n\nMUA syncs with healthcare devices(iOS & Apple Watch 6(WatchOS 11.6), Android & Galaxy watch 7 or later) to analyze physical and mental states in real time, recommending meditation contents tailored to condition at each moment. \n\n{1493529051760428}\n\n# DEEP SOUNDBATH\n\nIn collaboration with meditation experts, MUA incorporates soundscapes based on 432Hz frequency from solfeggio techniques to promote calmness and deep immersion. By Harmoniously blending with Korean traditional instruments, MUA delivers a universal healing experience that bridges modern meditation with the richness of Korean traditional music.\n\n{1477994243455147}\n\n", "short_description": "Did Your Mind Find a Moment of True Peace Today?\n\nMUA is an XR meditation platform for HMDs that helps you restore emotional balance anytime and anywhere.\nPowered by MIND-C AI, our Emotion Inference Artificial Intelligence, MUA analyzes biosignals (heart rate, HRV, oxygen saturation, etc.) from healthcare devices like smart watches and mirrors.\nMUA identifies your current emotional state and recommends personalized meditation content best suited for your condition. "}]}, "developer_name": "Com2us N", "developer_privacy_policy_url": "https://muameditation.com/en/board/legal/view.do?seq=L0000004", "developer_terms_of_service_url": null, "publisher_name": "Com2us N", "support_website_url": null, "website_url": "https://muameditation.com/en/main.do", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ko", "ja", "es"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "28608604038740730"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499619704_1421351609846281_693410736465074308_n.png?stp=dst-png_s360x360&
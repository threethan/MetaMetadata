35_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vQ0bUwCZPvsQ7kNvwHlGWHM&_nc_oc=AdpATYIFzRT3fWQEa5RJ4wVHCpGZ2n4TY83QA5zhpK2jMUD-PlbsfpEpEfayH1gyDRo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXPxn8yolaNb7fr-FwCfVdQp0Iv0q4F1rLzkjh6Wt-BHQ&oe=6B0F1629"}, {"file_name": "07_shot2.png", "id": "1476600850951619", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/779277465_1476600854284952_5245261277608578729_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xMyxY-gWsnUQ7kNvwGYQTmv&_nc_oc=AdoXNqzheQhIl9ASgtJxJbM_f8SIiTB_xA1YqeOqfM4cmerw78IPc234R_qVEILMUoo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWvLca5G0wZcxj4DcB7VNQAVdmMsCwUF9Ziar5NqQ4WbA&oe=6B0F180A"}, {"file_name": "08_shot3.png", "id": "1782669613030095", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/765553549_1782669616363428_5646325588759516857_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y2Cl3ksg5qwQ7kNvwHX7zS5&_nc_oc=AdrparBz9mTX8iJmhOUl22mfSeLraxEdE-AVy_a56Wiu2HrpZo6_2VpTmZPMMKTTMz4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXLx0qrgm82c7uC2pmAMDOfSIVu7onjnczKv3qYmVnBbQ&oe=6B0EFE2F"}, {"file_name": "10_shot5.png", "id": "1600052728469108", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/774969737_1600052731802441_4782466400581529991_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sqXh-meSeJ8Q7kNvwGCpHT0&_nc_oc=AdpKdjBDmqaVMF1MBPG1kITiave6iUc6YoUmhdLAEFvy3Ewu_VeSxEHtLviGL3u-S18&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQU22OE2YLshi1xkQXj3XEqQv2r7Ni3TpF_3szh4mS8-8g&oe=6B0EF753"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "brassline-trailer-cover.png", "id": "4130301727263703", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/604347072_4130301730597036_8423579847372016233_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aS6hxoRtdeEQ7kNvwHD9meK&_nc_oc=AdqpEt6tjiFnDp9-YuWZIyAgBrIDFF28sK4BXGAPVIRYgbpC0SYp9T6QFvfTOm9TnVg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWdnUzVkQeD5WTWpilplr-uvxwRaNAH9JU0UXC26pICbA&oe=6B0EF786"}, "display_name": "Brassline: Gunfight Noir", "keywords": ["shooter", "noir", "arcade", "action", "coop"], "long_description": "Brassline is an on-rails gunfight in the spirit of the arcade light-gun classics, across Port Calder by night and by day. By night: the docks, a bank job, the last train, a night market, a glass tower, a causeway chase and a helicopter. By day: a beach that ends in a boat chase, a film lot where the cover is plywood, and a runway where you stop a plane.\n\n- **Fair by design.** An enemy about to fire shows a ring that closes and turns red, and nobody fires from point-blank range or from behind you. If you get hit, you missed the ring.\n- **Use your body.** Bullets fly slowly enough to see. Lean, duck, or shoot them out of the air. Cover stops rounds where you see it, and nowhere else.\n- **Real sound, no music.** Your footsteps and the city keep the rhythm. Every gun has its own voice, and every place has its own echo.\n- **Skill shots.** Hit the gun to disarm a gunman and he surrenders. Free hostages, pistol-whip knife rushers, set off fuel barrels and clear a room in slow motion.\n- **Build your armoury.** Six guns to collect, from the issued pistol to a lever-action .44. Four difficulties, seven modifiers, a Daily Case, S-to-D ranks and gun finishes to earn.\n- **Squad.** Up to four headsets on one Wi-Fi ride side by side. No accounts, nothing to type. Computer partners fill any empty seats.\n- **Play your way.** Standing or seated, with controllers or bare hands (curl your finger to fire). Comfort options: a vignette, quick-cut turns, calmer flashes, slow motion off.", "short_description": "Ten cases across Port Calder, from its worst night to the morning after. Every threat is announced by a closing ring, every bullet is slow enough to see and lean out of the way of, and every shot, casing and ricochet sounds real. By night, the docks, a bank job and a helicopter chase; by day, a beach that ends in a boat chase, a film studio's backlot and a runway after a cargo plane. Play solo with computer partners, or as a squad of up to four on the same Wi-Fi."}]}, "developer_name": "SaneBits", "developer_privacy_policy_url": "https://sanebits.com/products/brassline/privacy/", "developer_terms_of_service_url": null, "publisher_name": "SaneBits", "support_website_url": null, "website_url": "https://sanebits.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1424151146560587"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/833881363_1110511391850700_1240635849092839303_n.png?stp=dst-png_s360x360&_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uN2pWATutHEQ7kNvwGSZoVW&_nc_oc=AdotmL7K7Tvuf4D_yu8HMGBjbvhcK_S1R5EL6_dTODB8XGeBVyq7m9qptMtIScJSno0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQUQoyxSwujNDQnSOWHLqrSpeCHiniRV5XCWJKEOq0J-PA&oe=6B0F022B"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Brassline: Gunfight Noir", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id"
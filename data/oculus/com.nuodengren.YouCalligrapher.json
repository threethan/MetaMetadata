-sin2-1.oculuscdn.com/v/t64.5771-25/75269300_936701030492026_6938544625024235185_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UD9GbhHoCXIQ7kNvwF-LA91&_nc_oc=AdrhyiyeVJ2xuCx34f2JNaBAQAWwTKO-4UE9FUc94d2wtgGr8Du1umzO6E_NEXw-ivU&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEbrUv9G3h2KmS5Oirqcoon4kvUlqFtqDxGSU1uB-S5NQ&oe=6A7D9DF6"}, {"file_name": "5.png", "id": "479925626543671", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/38982715_479925629877004_8417823075430151259_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C8s0faOONkUQ7kNvwGGTEj6&_nc_oc=AdqKiG0FRiF5cMuxgHLQ3ivXYuORvjydIyqpH6s7d2_kf0Ro8c61cq1HAHW8grzLUyA&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFUra9V4DeGQgm6EQgoLafvvZGSlczqQgZxerug1gXrwA&oe=6A7DB907"}, {"file_name": "2.png", "id": "796015831331371", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/38974493_796015834664704_4285473500083593487_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GPYqNuCq2xYQ7kNvwEQffDO&_nc_oc=AdrIsAKyySnZ6Z8eKao_VjgvJV8xLKamat_mtV_-OCsSWwyIq5_GIEN4_7iiKENkIBU&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFYrXXsYp-RsqXjUd0txyZldzJsYrAQnk02OBAUbw4kgA&oe=6A7DA493"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "1.png", "id": "757954941582113", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/38982721_757954944915446_2989448714371699407_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PXK4nAQEeboQ7kNvwHYzqVW&_nc_oc=Adr0lkeghX87-01jp_WCEZuv2vv4oZ1oukAAM16L19cdKZ1U_rASj9YEkGQfsftS34E&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGW-Tx5dkKVsZK6-ujMmwnS15rDQCMYHvZQicuw_dj4vw&oe=6A7DC5DE"}, "display_name": "You Calligrapher", "keywords": [], "long_description": "\u300aYou Calligrapher\u300bis an authentic VR Calligraphy simulator.\n\nIn \u300aYou, Calligrapher\u300b, you will be empowered to imitate the masterpieces of poets and scholars, draw and paint with traditional ink pen. Witness and experience the culture of Calligraphy!\n\n- Featuring - \n- Realistic ink brush physics\n- Mutiple color for painting and writing\n- Caligraphy and Chinese learning\n- Templates of masterpieces\n- Save & Share your words, paints, illustrations...etc", "short_description": "A simulator of traditional  Calligraphy! Soak your writing brush in inks of all colors, become a poet, scholar and a true master of Calligraphy!"}, {"images": {"nodes": []}, "id": "1580919869398838", "locale": "zh_TW", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "\u58a8\u4e4b\u97f5", "keywords": [], "long_description": "\u53e4\u4e4b\u4eba\u7686\u80fd\u66f8\uff01\u7528\u6d41\u50b3\u5343\u5e74\u7684\u50b3\u7d71\u66f8\u6cd5\uff0c\u5c07\u5fc3\u4e2d\u6240\u60f3\u5bc4\u8a17\u65bc\u7d19\u4e0a\u5427\uff01\n\n\u96a8\u5fc3\u6240\u6b32\u3001\u63ee\u6beb\u6f51\u58a8\uff01\u5728\u58a8\u4e4b\u97fb\u4e2d\u4f5c\u8a69\u3001\u5beb\u8a5e\uff0c\u81e8\u6479\u5927\u5bb6\u6240\u5beb\u96b8\u3001\u8349\u3001\u6977\u3001\u884c\u5404\u9ad4\uff0c\u5275\u9020\u5c6c\u65bc\u81ea\u5df1\u7368\u4e00\u7121\u4e8c\u7684\u4f5c\u54c1\uff01\n\n- \u904a\u6232\u5167\u5bb9 -\n\n\uff0d\u5beb\u5be6\u6bdb\u7b46\u7269\u7406\u8207\u7b46\u5237\u7b46\u89f8\uff0c\u5b8c\u7f8e\u6a21\u64ec\u771f\u5be6\u904b\u7b46\u6548\u679c\n\uff0d\u591a\u7a2e\u53ef\u9078\u984f\u8272\uff0c\u5beb\u5b57\u7e6a\u756b\u591a\u5f69\u591a\u59ff\n\uff0d\u66f8\u6cd5\u7b46\u52e2\u8207\u4e2d\u6587\u5b57\u97f3\u5b57\u7fa9\u5b78\u7fd2\n\uff0d\u66f8\u6cd5\u5927\u5bb6\u5b57\u5e16\u81e8\u6479\n\uff0d \u4fdd\u5b58\u8207\u5206\u4eab\u4f60\u7684\u5b57\u5e16\u3001\u63d2\u756b\u548c\u5857\u9d09", "short_description": "\u300a\u58a8\u4e4b\u97f5\u300b\u662f\u4e00\u6b3e\u9ad8\u5ea6\u9084\u539f\u50b3\u7d71\u66f8\u6cd5\u7684VR\u66f8\u6cd5\u6a21\u64ec\u904a\u6232\u3002\n\n\u5728\u300a\u58a8\u4e4b\u97f5\u300b\u4e2d\uff0c\u4f60\u5c07\u53ef\u76e1\u60c5\u63ee\u7051\u4f60\u7684\u6587\u91c7\uff0c\u81e8\u6479\u5927\u5e2b\u7b46\u8de1\u4ea6\u6216\u5275\u4f5c
mediate and physical."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.freeprivacypolicy.com/live/c5e95887-b31c-402f-b505-8f8f698e27a9", "developer_terms_of_service_url": null, "publisher_name": "SBM", "support_website_url": null, "website_url": "https://www.freeprivacypolicy.com/live/c5e95887-b31c-402f-b505-8f8f698e27a9", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1228796255027646"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "35271251689189657"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499296119_1427369739192494_7567363334346086290_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bkELzVtlw0IQ7kNvwEnmiUG&_nc_oc=AdrVwykmSEqHYHaQXUh6dBKfIkxWr4XhEYUlKw6l708OTcAVEqsUsY9yi-IGak37_AE&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7Oc3hNU-_v1nP3wIRj_OMQiUTTJq0448-NEYo8kELJGg&oe=6A01E0A6"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Scary Baboon Modded", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_name": "Community", "id": "1228796255027646"}], "release_date": 1778088420, "lastRevision": {"nodes": [{"id": "35271251739189652", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "35271251609189665", "is_first_p
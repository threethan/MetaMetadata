d angles in real time, use an integrated level, or transfer shapes directly from your surroundings. Create and calculate areas, including reference values per square meter, and take notes directly in your space \u2013 your digital toolkit, ideal for planning and cost estimation.\n\nAll captured data can be easily shared as a CSV file and exported via cable or conveniently through WhatsApp.\n\nWhether on the construction site, in the workshop, or at home: STRAUSS Toolbox XR brings efficiency and digital support exactly where you work.\n", "short_description": "The STRAUSS Toolbox XR app transforms your Meta Quest 3 / 3S into a powerful, professional measurement and planning tool. Designed for craftsmen and ambitious DIY users, the app combines essential functions for efficient work \u2013 intuitive, fast, and without the need for additional equipment."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.strauss.com/de/de/Rechtliches/Datenschutz_Sicherheitsbestimmungen_ToolBoxXR", "developer_terms_of_service_url": null, "publisher_name": "Strauss Deutschland  GmbH & Co. KG", "support_website_url": null, "website_url": "https://www.strauss.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1063584910766706"}, {"id": "393222478507326"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "de", "fr"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25643961121911012"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1866002697450
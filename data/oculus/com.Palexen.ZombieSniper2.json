111690421_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AKlA74S2uBEQ7kNvwFUbfvM&_nc_oc=AdqIDBbwgVhWcAQJDGb4D8HANN6u5dQUFaHjSZG3whGbeJ8EBLjc5lkwiz_AQRktASE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJNRz5v2hyVgn-ml5BVr9BlxGG-bUL67w7lCnUh7z7XWA&oe=6AB9239E"}, {"file_name": "ss_2.png", "id": "1404481898286994", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/507818746_1404481901620327_6035599619384496812_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=52k4JnxD52oQ7kNvwF6tLWr&_nc_oc=Adq2dBv_qAlRdePABcHyucmjEkhJgM70GYxJPc9kIjf1tYIz2JBeRw5-6fjqQX60c18&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIZzFeF4N36anGy3QBD0ti9mBr2pHEPOQG1ZvKP0bggHg&oe=6AB92E39"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Store_hero_2560.png", "id": "28531409386459912", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499620921_28531409393126578_4773895868748841143_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MeJdvdSoU_AQ7kNvwHxdSbX&_nc_oc=AdqaD2FHQvZk9lNN1sTF1FaVeds99zUYgvhRAJPUaYpJQIyJ0p6LvuNlf1Cz5QFfkbo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJpNHMaXPgr5OvnpFTVOCkYjf770l585Sq_nFHCFg4XvA&oe=6AB92882"}, "display_name": "Zombie Sniper 2", "keywords": ["Zombie", "Sniper", "Shooter", "Arcade", "Apocalipse"], "long_description": "Play as Raven 6, an elite sniper protecting the city from a secure vantage point. Take your time, line up the perfect shot, eliminate the infected, and earn rewards to unlock powerful rifles and equipment.\n\nComplete missions, improve your arsenal, and enjoy a satisfying arcade sniping experience in a post-apocalyptic world where precision is everything.\n\nAim. Fire. Upgrade. Enjoy.\n\nYou will always be safe... but your precision and tactics are real.", "short_description": "The city belongs to the infected... but the rooftops are yours."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.palexen.com/privacy-policy", "develop
111690421_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3YvFydh2NGoQ7kNvwFpoZBu&_nc_oc=AdrCMbAkM1N-HAf-DhuAbSpBdxAa3RGVOwQkh_wcKEjxM9bG6dAVcD9s6hsbVCNgtbQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOhvojmW8Hi7cJ6YkTqqWCGSkkHkua-IRT5SLBMP__7fQ&oe=6AE5F69E"}, {"file_name": "ss_2.png", "id": "1404481898286994", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/507818746_1404481901620327_6035599619384496812_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Rw7ZTW0ak-gQ7kNvwEuDBd2&_nc_oc=Adrq0m1ymcP-6uIY9mn6fF3HzWmuxNi9XDIx7Msh3wV0RtjaoP1IxLrSctvHyFskpMw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMatlfVc_M5dQ8ASS0urV_RZlp0IBq76H_evR6W9K7rFQ&oe=6AE60139"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Store_hero_2560.png", "id": "28531409386459912", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499620921_28531409393126578_4773895868748841143_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XFMBVXaQzfoQ7kNvwEHrF-e&_nc_oc=AdrulmLUHEA5-3D6qgO3Ep2teHna_HrRUk0GXYGL79cYSBMg_oQvB-0VlQhbJVj7N8c&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPXr0F5SiyjdHEMtbrCKDZct8pKXoHJouWAxJdHcrPLGA&oe=6AE5FB82"}, "display_name": "Zombie Sniper 2", "keywords": ["Zombie", "Sniper", "Shooter", "Arcade", "Apocalipse"], "long_description": "Play as Raven 6, an elite sniper protecting the city from a secure vantage point. Take your time, line up the perfect shot, eliminate the infected, and earn rewards to unlock powerful rifles and equipment.\n\nComplete missions, improve your arsenal, and enjoy a satisfying arcade sniping experience in a post-apocalyptic world where precision is everything.\n\nAim. Fire. Upgrade. Enjoy.\n\nYou will always be safe... but your precision and tactics are real.", "short_description": "The city belongs to the infected... but the rooftops are yours."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.palexen.com/privacy-policy", "develop
111690421_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h7VsWodKiEcQ7kNvwGyXPkN&_nc_oc=AdoWiJc-exzGJlN28wWtMgXje56rWnBjhaQ0mxJFPniEkTPlJD0H8_waflIcFXkjd78&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ46z8bXtxQjeM2q8pOf-FCSiKjOBLk1Vsac_Sl3YURJQ&oe=6AB13A9E"}, {"file_name": "ss_2.png", "id": "1404481898286994", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/507818746_1404481901620327_6035599619384496812_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wAzRnzYSonUQ7kNvwFrfJVO&_nc_oc=Adp_GKh7EAWihamtIvklpHtIeHs_6dPEuRHvi7eJICOaqQSlzRtp4ePO9YLSjjD3ECE&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIUz-BxF_8ba6V5Arl7HAQENs_qfJ1dBHNBWm483WkUug&oe=6AB14539"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Store_hero_2560.png", "id": "28531409386459912", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499620921_28531409393126578_4773895868748841143_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DzkGYw1HfjIQ7kNvwE7SOHW&_nc_oc=AdpiztuAvBlB78gEc7l_Dm-FQYtOFWpsLy2ZSxz6izkhZCaeEvhRH8x-oZTJ1ii9T2s&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKycTFQSbuueawyxWYStV4fKb100k4BMpg9ianjnl65jg&oe=6AB13F82"}, "display_name": "Zombie Sniper 2", "keywords": ["Zombie", "Sniper", "Shooter", "Arcade", "Apocalipse"], "long_description": "Play as Raven 6, an elite sniper protecting the city from a secure vantage point. Take your time, line up the perfect shot, eliminate the infected, and earn rewards to unlock powerful rifles and equipment.\n\nComplete missions, improve your arsenal, and enjoy a satisfying arcade sniping experience in a post-apocalyptic world where precision is everything.\n\nAim. Fire. Upgrade. Enjoy.\n\nYou will always be safe... but your precision and tactics are real.", "short_description": "The city belongs to the infected... but the rooftops are yours."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.palexen.com/privacy-policy", "develop
111690421_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kqLifg2PT9AQ7kNvwE2IMVy&_nc_oc=AdqTtOZnOT7Ss4dsyldriEqVtGPAUmQV5mgNGvx8V4bw1WfFH4oShLHzgON3nw9WbOk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ1NjVUF6ORzYLvTPFXVEZeu8-3hevM0hQ3H2RhpgA_2Q&oe=6AF71A1E"}, {"file_name": "ss_2.png", "id": "1404481898286994", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/507818746_1404481901620327_6035599619384496812_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bufnUXClMdMQ7kNvwF3R4b5&_nc_oc=AdpHlG70D4XBFIHpV_FPuVbK4TYZFo1ut3MKyj9ZmrjdL_4YpmtXXSVzO1aJ2xIX91w&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRu5WqsiTRXBwenVKafEyhSdQMR7J_B7O4xQCQKpcL0Hw&oe=6AF724B9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Store_hero_2560.png", "id": "28531409386459912", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499620921_28531409393126578_4773895868748841143_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iR1fUXX8juUQ7kNvwGOXLrg&_nc_oc=Adov9M-2zmehNIrHRxaM1j19_UFRHD94QYLK_cvTCJcjZ4R6kQ6qo1D-5rQbdiKLYRw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRP61gnNLTpl5-REFbYbKC8NzJcd4S60bfkV6mqBqIuHQ&oe=6AF71F02"}, "display_name": "Zombie Sniper 2", "keywords": ["Zombie", "Sniper", "Shooter", "Arcade", "Apocalipse"], "long_description": "Play as Raven 6, an elite sniper protecting the city from a secure vantage point. Take your time, line up the perfect shot, eliminate the infected, and earn rewards to unlock powerful rifles and equipment.\n\nComplete missions, improve your arsenal, and enjoy a satisfying arcade sniping experience in a post-apocalyptic world where precision is everything.\n\nAim. Fire. Upgrade. Enjoy.\n\nYou will always be safe... but your precision and tactics are real.", "short_description": "The city belongs to the infected... but the rooftops are yours."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.palexen.com/privacy-policy", "develop
111690421_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jvpNvnJ6Cp4Q7kNvwG-LCCG&_nc_oc=Adq6IUCgKiIkpg2KrhBknjmUeYrMz_iszgLMr77s6P7UY3ttOThOKAV88gvZT39O858&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSE-FJbaD8QGVDMPm1di_TgGI2_8jY6pHmiPtuusYtnrA&oe=6AF0829E"}, {"file_name": "ss_2.png", "id": "1404481898286994", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/507818746_1404481901620327_6035599619384496812_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lHtknON6S1kQ7kNvwGDCqWR&_nc_oc=AdqP_nsuIuGhzBuOcjjY2KBYxeb8mqpRtWLF9rABy9MMLmJnLzcwnH8Ij4rS1yvmG8k&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRoBSYqFJUX4EOJTJNHKUr30ybKYIKuGz1Z3ITCsd438A&oe=6AF08D39"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Store_hero_2560.png", "id": "28531409386459912", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499620921_28531409393126578_4773895868748841143_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E1bLk3oJSv4Q7kNvwH0etKt&_nc_oc=AdouDV4OviLNGpJmWCGUL69UtnytYqHvzBfceeRxC_OuV7w1iCk8GGo7Vt9mcQtwrpg&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQR1NAnxhtoyiioXG-3ElvOjjE5uRAi8cCI7jcqD9MFuQ&oe=6AF08782"}, "display_name": "Zombie Sniper 2", "keywords": ["Zombie", "Sniper", "Shooter", "Arcade", "Apocalipse"], "long_description": "Play as Raven 6, an elite sniper protecting the city from a secure vantage point. Take your time, line up the perfect shot, eliminate the infected, and earn rewards to unlock powerful rifles and equipment.\n\nComplete missions, improve your arsenal, and enjoy a satisfying arcade sniping experience in a post-apocalyptic world where precision is everything.\n\nAim. Fire. Upgrade. Enjoy.\n\nYou will always be safe... but your precision and tactics are real.", "short_description": "The city belongs to the infected... but the rooftops are yours."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.palexen.com/privacy-policy", "develop
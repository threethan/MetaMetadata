111690421_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=X_ryEFKcLTwQ7kNvwFOuAnX&_nc_oc=AdqSR74c9mo5zxEvq84D5_LZH4kRJFa9Ky3VRXPRuzgQ1BSjt2S8_dTmdOnwmeGUtT4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPCZCyJ5pJjpftwnGCyaG-TdcTwolz8JyXLCONAS6lrgA&oe=6AC10C9E"}, {"file_name": "ss_2.png", "id": "1404481898286994", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/507818746_1404481901620327_6035599619384496812_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2utcr1rt7_YQ7kNvwFNjPzm&_nc_oc=AdqdaLhrcHZ74CyldiIILbqtGs0vTxY2VFCYJTcz85t_QUU31SAA8DenSsSgr6QMZzI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNz2W_EJbQh8H4ZH2hc92TGBqJYJ0kZj7x4ikDJRcDTtw&oe=6AC11739"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Store_hero_2560.png", "id": "28531409386459912", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499620921_28531409393126578_4773895868748841143_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BSxtO0BuiuoQ7kNvwEWAbkZ&_nc_oc=AdpBd6kQtBCOsJvJjTYMPaieeB7SoLweul4dzmFUq1sPQxfz0UJjrwlz8PRj6rQvlZ4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM60Srm4bKOJ0Y92ghK-6KZlhr_wCWiTem_rNdXHYVPJw&oe=6AC11182"}, "display_name": "Zombie Sniper 2", "keywords": ["Zombie", "Sniper", "Shooter", "Arcade", "Apocalipse"], "long_description": "Play as Raven 6, an elite sniper protecting the city from a secure vantage point. Take your time, line up the perfect shot, eliminate the infected, and earn rewards to unlock powerful rifles and equipment.\n\nComplete missions, improve your arsenal, and enjoy a satisfying arcade sniping experience in a post-apocalyptic world where precision is everything.\n\nAim. Fire. Upgrade. Enjoy.\n\nYou will always be safe... but your precision and tactics are real.", "short_description": "The city belongs to the infected... but the rooftops are yours."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.palexen.com/privacy-policy", "develop
684_5323835194111690421_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jDTSaW7BxrAQ7kNvwFjB2j8&_nc_oc=Adq5fp5DF6Z1NV222mjsClpdVXWRRJBHA_Jq2fE-FiE4oY65h51LKG2CElyeJB9KCW0&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFjeSSqUbUYY5irdTc5-CFNnJ3ZAU_mAQUGWIpZmR70ww&oe=6A8EF39E"}, {"file_name": "ss_2.png", "id": "1404481898286994", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/507818746_1404481901620327_6035599619384496812_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vlHE9fkQWzQQ7kNvwHnzJZg&_nc_oc=AdqYIy-G1P2TltoIdCHFC-p54lAhOFX4gjhuQSRoxKinxuT2EhJ1WEoB8iKVyVS-nLs&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG6sX2Vs0Gh7tEv3-Loq0D7DUKdGJz42RuJ5LNVYd4jig&oe=6A8EC5F9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Store_hero_2560.png", "id": "28531409386459912", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/499620921_28531409393126578_4773895868748841143_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XTyFahTogJEQ7kNvwGhb054&_nc_oc=Adr9n1FA1g-MRSdzG3rxXpf36FQV9XSPT_5u5UwRZqsh897iiWgScnRbN-vTu64TFzw&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHaDwhQPNHdsfZ_9tmJt9t6N-U5vX76Bm3l-qbvyq5K7A&oe=6A8EC042"}, "display_name": "Zombie Sniper 2", "keywords": ["Zombie", "Sniper", "Shooter", "Arcade", "Apocalipse"], "long_description": "Play as Raven 6, an elite sniper protecting the city from a secure vantage point. Take your time, line up the perfect shot, eliminate the infected, and earn rewards to unlock powerful rifles and equipment.\n\nComplete missions, improve your arsenal, and enjoy a satisfying arcade sniping experience in a post-apocalyptic world where precision is everything.\n\nAim. Fire. Upgrade. Enjoy.\n\nYou will always be safe... but your precision and tactics are real.", "short_description": "The city belongs to the infected... but the rooftops are yours."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.palexen.com/privacy-p
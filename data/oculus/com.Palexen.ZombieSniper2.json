111690421_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0XQoQyQOh4EQ7kNvwF6Y7Dt&_nc_oc=AdqF-y9qqgp91vpJQwRbOEreE0HIznf4odWLY4RNwWJXm8sWmSZPkm_uJttmCEvIdmM&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL9xm4nPGL7c09UHhVwsazajFmtLtt-r8Il9y8lBiQ63g&oe=6A9AD11E"}, {"file_name": "ss_2.png", "id": "1404481898286994", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/507818746_1404481901620327_6035599619384496812_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GzjC34ymavYQ7kNvwF8IUpo&_nc_oc=Adqu6Z2laZHWvQy6BPJ1OSbEjmRh2i_RohW9LltFSn3_EmMwiU3LBfQGFZCzOuhqoF4&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL_CWtRHg_siurSUJPWhXy9QAqekhGxOKAChzQ6IBs3Tg&oe=6A9ADBB9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Store_hero_2560.png", "id": "28531409386459912", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499620921_28531409393126578_4773895868748841143_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=slvspS5SU4MQ7kNvwHB4aMs&_nc_oc=AdqPqwp4pWZFHM5qRvjzMN7jXn6SLOl3_W0SB38FLDR56gtertYrSt_nfXzQY3WX08M&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJqRtbJLdNkCkZegIunfx0SA4IERtqLU5MyXd2ksYWAew&oe=6A9AD602"}, "display_name": "Zombie Sniper 2", "keywords": ["Zombie", "Sniper", "Shooter", "Arcade", "Apocalipse"], "long_description": "Play as Raven 6, an elite sniper protecting the city from a secure vantage point. Take your time, line up the perfect shot, eliminate the infected, and earn rewards to unlock powerful rifles and equipment.\n\nComplete missions, improve your arsenal, and enjoy a satisfying arcade sniping experience in a post-apocalyptic world where precision is everything.\n\nAim. Fire. Upgrade. Enjoy.\n\nYou will always be safe... but your precision and tactics are real.", "short_description": "The city belongs to the infected... but the rooftops are yours."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.palexen.com/privacy-policy", "develop
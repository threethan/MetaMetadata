111690421_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JkxGFlH03nMQ7kNvwGx4AHi&_nc_oc=AdqPnGpN8QqpqgZM1Z0WTYp9EeEf7W0ODwvCdz4dVZyGVRHerWQ4oFIiwW3PHGhgOAo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQVsO5OzAszAkamdof_GWBtMGcjoaPegPl08QY-ulI5FA&oe=6AE9EB1E"}, {"file_name": "ss_2.png", "id": "1404481898286994", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/507818746_1404481901620327_6035599619384496812_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=op63kOhhwJ8Q7kNvwHm6Lyx&_nc_oc=Ado-ImXw2lAcocZ3AxHKfgi0aVPFW8F6WqwRFogISFgdSiDZuixp00xY9AxGs9U-2Iw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRc2RB_tB-RVNafQkSRZR-mbwsWxmIHUuaasX4TlaSXHA&oe=6AE9F5B9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Store_hero_2560.png", "id": "28531409386459912", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499620921_28531409393126578_4773895868748841143_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DZndTUQ8s-IQ7kNvwHv7uuG&_nc_oc=Adpxw1_74VR4BooyVRJWMBE4QjG4KNgiS95KuQgEpeB5ODV_PfeI9eDOgEjWp06l8gY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSEEBviaCKcIk8HOooOIceIESCW6DO1fVEXgjpj4i1j5g&oe=6AE9F002"}, "display_name": "Zombie Sniper 2", "keywords": ["Zombie", "Sniper", "Shooter", "Arcade", "Apocalipse"], "long_description": "Play as Raven 6, an elite sniper protecting the city from a secure vantage point. Take your time, line up the perfect shot, eliminate the infected, and earn rewards to unlock powerful rifles and equipment.\n\nComplete missions, improve your arsenal, and enjoy a satisfying arcade sniping experience in a post-apocalyptic world where precision is everything.\n\nAim. Fire. Upgrade. Enjoy.\n\nYou will always be safe... but your precision and tactics are real.", "short_description": "The city belongs to the infected... but the rooftops are yours."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.palexen.com/privacy-policy", "develop
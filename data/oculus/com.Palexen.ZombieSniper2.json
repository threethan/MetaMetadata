111690421_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2ZNwfVt6HXsQ7kNvwE3koY4&_nc_oc=AdrlP4Qd3rwXQjQpmI8e5MPUelVKFiimPozlonF_vBluWiA1AN1srEruujeF86g4B6Q&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGEw2Ysx8nk0V8Skwg6-q7OfugVQTujY02nI8QuZvlQjg&oe=6A974D1E"}, {"file_name": "ss_2.png", "id": "1404481898286994", "uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/507818746_1404481901620327_6035599619384496812_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2pd6khK8tsYQ7kNvwGQIKsO&_nc_oc=AdpuMU9EZbz9INPxJahF36s-pY6gx9_lFLmvI9mmY5ufl2qwNXpxiKCHpvGoqclJ670&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFQYmm19NaoVERQMXxPpeoPonu84GsPczA5Cw5AQsoaFA&oe=6A971F79"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Store_hero_2560.png", "id": "28531409386459912", "uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/499620921_28531409393126578_4773895868748841143_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=slvspS5SU4MQ7kNvwEGrk8h&_nc_oc=AdrNtY_gy_ejwD4cSo0c2stXN320LP3BcwW18OaNaz2EwRWnieat7x8ST_M0bajQq9U&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG_qb_9f1arPPGK8ygHLhbtiXYf9cgpQGi68pWpm9UokQ&oe=6A9719C2"}, "display_name": "Zombie Sniper 2", "keywords": ["Zombie", "Sniper", "Shooter", "Arcade", "Apocalipse"], "long_description": "Play as Raven 6, an elite sniper protecting the city from a secure vantage point. Take your time, line up the perfect shot, eliminate the infected, and earn rewards to unlock powerful rifles and equipment.\n\nComplete missions, improve your arsenal, and enjoy a satisfying arcade sniping experience in a post-apocalyptic world where precision is everything.\n\nAim. Fire. Upgrade. Enjoy.\n\nYou will always be safe... but your precision and tactics are real.", "short_description": "The city belongs to the infected... but the rooftops are yours."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.palexen.com/privacy-policy", "develop
111690421_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kqLifg2PT9AQ7kNvwHZgFNc&_nc_oc=Adp_j1-9zBLc2npqp9QBLYIumgzzC1L0cDwfXc_Tkt4ZjevGzdtIhSHxFX7tWWkotZI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT-XCi5tQj-P_OGv22QLAOFkSWJ5sDiYH0gX5n_sUQNxg&oe=6AF5C89E"}, {"file_name": "ss_2.png", "id": "1404481898286994", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/507818746_1404481901620327_6035599619384496812_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I-FmrG43CswQ7kNvwECFKqQ&_nc_oc=AdqZDFom4oZAsoH2vaAll2ZQDy0H6-Ndm3d4tGuouELuLL7QZ6Zx46YIYvFvIChwQXY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRwnqa5bzXre8T8RIU80n9C9N75AcVh2SQBsLi9qWolaQ&oe=6AF5D339"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Store_hero_2560.png", "id": "28531409386459912", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499620921_28531409393126578_4773895868748841143_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0hX1WU5_exYQ7kNvwFGQCd8&_nc_oc=Adqz2cBJl7Yye2lrUKmNFgi71y4wjDo634tNHT79SbhTQXoiGIDmQPWc-XRUVvbxbgU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTr_8QDss0VEr-GFvkrkzBm0K2yg24UyYJdL9Zw5uRVsw&oe=6AF5CD82"}, "display_name": "Zombie Sniper 2", "keywords": ["Zombie", "Sniper", "Shooter", "Arcade", "Apocalipse"], "long_description": "Play as Raven 6, an elite sniper protecting the city from a secure vantage point. Take your time, line up the perfect shot, eliminate the infected, and earn rewards to unlock powerful rifles and equipment.\n\nComplete missions, improve your arsenal, and enjoy a satisfying arcade sniping experience in a post-apocalyptic world where precision is everything.\n\nAim. Fire. Upgrade. Enjoy.\n\nYou will always be safe... but your precision and tactics are real.", "short_description": "The city belongs to the infected... but the rooftops are yours."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.palexen.com/privacy-policy", "develop
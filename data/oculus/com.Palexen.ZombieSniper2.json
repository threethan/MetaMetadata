111690421_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jsju3kz6WP4Q7kNvwElqaU5&_nc_oc=AdoeWFlx7AqxPC01xYHJ5Ff45NUfZ-FEul_JMp1ir06_7xF2ElJ5sYeVgKuacGLVwYE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOwVNbCqdtI1-4LvjNGXLK-SDOp6PXCupPveA9etNiR3Q&oe=6ACA471E"}, {"file_name": "ss_2.png", "id": "1404481898286994", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/507818746_1404481901620327_6035599619384496812_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WKJVGHSjujsQ7kNvwFO_PPY&_nc_oc=AdoMnVBkPt4iM_CfQH9KBTvBmAoYJ-TYec2edKqbIs87WGqqaxIDXOckAepMQF-iehA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMDSjuJbxHtMvPl4K8iJP8nH7af7fy3ZpzzpftKU18S6w&oe=6ACA51B9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Store_hero_2560.png", "id": "28531409386459912", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499620921_28531409393126578_4773895868748841143_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=abmH9-JcbA0Q7kNvwFxEbI7&_nc_oc=AdrJf-n9XivFukQOP1IcIHCz1DBjdMQOpEhEalIbVz1dbwKP3LjTB2FRBdTaYa5fr1Y&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOZlVVVd9mMmisAwcPbWK0zd1xPO0na_XGQ-Tf8-TF-LQ&oe=6ACA4C02"}, "display_name": "Zombie Sniper 2", "keywords": ["Zombie", "Sniper", "Shooter", "Arcade", "Apocalipse"], "long_description": "Play as Raven 6, an elite sniper protecting the city from a secure vantage point. Take your time, line up the perfect shot, eliminate the infected, and earn rewards to unlock powerful rifles and equipment.\n\nComplete missions, improve your arsenal, and enjoy a satisfying arcade sniping experience in a post-apocalyptic world where precision is everything.\n\nAim. Fire. Upgrade. Enjoy.\n\nYou will always be safe... but your precision and tactics are real.", "short_description": "The city belongs to the infected... but the rooftops are yours."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.palexen.com/privacy-policy", "develop
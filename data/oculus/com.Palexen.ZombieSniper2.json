111690421_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AKlA74S2uBEQ7kNvwFW9lJh&_nc_oc=AdqJAu2Fgz5qJThRwjFNpE5LMfkdlVIpkt1oDQmsiMB8FW6QtQRdzEh__uN6cJAmUDU&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIw2bUmzxewTf272oy0NOabXRlIbIeOkUVXzzXz4Gb01w&oe=6AB6809E"}, {"file_name": "ss_2.png", "id": "1404481898286994", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/507818746_1404481901620327_6035599619384496812_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NQ3mMteU3WEQ7kNvwF002TT&_nc_oc=AdqZu_VWZj58_0eD-OYzJSnJAjQzynCrxopZhhI2__WTAZiLxvhP3EHnQeT8PpDXUds&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQInvgcSH3cLjWWXkcsx35xq3IY48qw9ovZdSoUbj7BtrQ&oe=6AB68B39"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Store_hero_2560.png", "id": "28531409386459912", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/499620921_28531409393126578_4773895868748841143_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=37uqgt5-QxkQ7kNvwHX06Op&_nc_oc=Adr__H6Wu6HUOZJhrSR8yKq90gacO3hyoTA9R_sgKfyiaejxeBMCvhhLBgB65KnHvOM&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLrbUxTn0mawNCwMDyI9XAHaSstEv0Uuwb1yNQfDC_y8A&oe=6AB68582"}, "display_name": "Zombie Sniper 2", "keywords": ["Zombie", "Sniper", "Shooter", "Arcade", "Apocalipse"], "long_description": "Play as Raven 6, an elite sniper protecting the city from a secure vantage point. Take your time, line up the perfect shot, eliminate the infected, and earn rewards to unlock powerful rifles and equipment.\n\nComplete missions, improve your arsenal, and enjoy a satisfying arcade sniping experience in a post-apocalyptic world where precision is everything.\n\nAim. Fire. Upgrade. Enjoy.\n\nYou will always be safe... but your precision and tactics are real.", "short_description": "The city belongs to the infected... but the rooftops are yours."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.palexen.com/privacy-policy", "develop
323835194111690421_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2XG019_oIU8Q7kNvwHFmxWk&_nc_oc=AdpEPTNwS71Z6jnpTDCmwn_EVsH891jpjx9kct2EsnjWGWVvlf_zVGXdxXXyKxSvi5Q&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL628Qp9e2hv4BN7fuJwypD3zp8X39WxlHrFfYVo1XxrA&oe=6AA40B9E"}, {"file_name": "ss_2.png", "id": "1404481898286994", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/507818746_1404481901620327_6035599619384496812_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6Vfr2ZUWTXAQ7kNvwHBU7XK&_nc_oc=AdpbXPoAMhoSnGViv5xL2ohNPd7FfdQ70_DE98gtNUxLTHVxwYw5nPNvdVgV0T_V3ko&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI4C9niP0levO-91MNty8MLWg_3qOVHFcM8Ic_7g_91IA&oe=6AA41639"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Store_hero_2560.png", "id": "28531409386459912", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/499620921_28531409393126578_4773895868748841143_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dCIl87KqGboQ7kNvwF_zqCC&_nc_oc=AdpI48dK0K3VJJhXlT8J6QfkXd_ALb58Yzo5S88tPXm39xSN55TxvDziXH83OiMyGBo&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL6bEQDNSHnpFuN9hd5Gc6msNRau5J9ZbIzu8eesH2xfA&oe=6AA41082"}, "display_name": "Zombie Sniper 2", "keywords": ["Zombie", "Sniper", "Shooter", "Arcade", "Apocalipse"], "long_description": "Play as Raven 6, an elite sniper protecting the city from a secure vantage point. Take your time, line up the perfect shot, eliminate the infected, and earn rewards to unlock powerful rifles and equipment.\n\nComplete missions, improve your arsenal, and enjoy a satisfying arcade sniping experience in a post-apocalyptic world where precision is everything.\n\nAim. Fire. Upgrade. Enjoy.\n\nYou will always be safe... but your precision and tactics are real.", "short_description": "The city belongs to the infected... but the rooftops are yours."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.palexen.com/privacy-pol
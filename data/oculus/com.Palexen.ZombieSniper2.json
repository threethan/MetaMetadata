111690421_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=su9mG8kGpmMQ7kNvwHOSm5V&_nc_oc=AdpL1a9UC9kKC1hAZCWlKMfBi606E7J6T0LJM86i4rxFNXtt17ssJojPMU3i2b5a9ek&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN39QJC_62AC0rTsPOIYvugFSv7OwkA_DCSr5o4K4dm8Q&oe=6AE4A51E"}, {"file_name": "ss_2.png", "id": "1404481898286994", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/507818746_1404481901620327_6035599619384496812_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Rw7ZTW0ak-gQ7kNvwHJfTSA&_nc_oc=AdqadtDWosdOTRXBCuXGm_gV13c21OXpdb4MVuGvYMbUIFqb4UVHERgpKS6RIhct4ns&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM2o51ANhW0g6lXNGKA26Obv3ADYyJmXT7g8acMS9n25w&oe=6AE4AFB9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Store_hero_2560.png", "id": "28531409386459912", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499620921_28531409393126578_4773895868748841143_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XFMBVXaQzfoQ7kNvwHe_ObZ&_nc_oc=Ado7hJmhxV60pM38ImQg7r0HYEuW1jnWCknW8rpphFc6Aa2PP7KhryFJAfYd3Dxt_V8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNGSWweHSbnr8XRJUQy8_uWQbUJcUK2z5E4m0t_EdSalQ&oe=6AE4AA02"}, "display_name": "Zombie Sniper 2", "keywords": ["Zombie", "Sniper", "Shooter", "Arcade", "Apocalipse"], "long_description": "Play as Raven 6, an elite sniper protecting the city from a secure vantage point. Take your time, line up the perfect shot, eliminate the infected, and earn rewards to unlock powerful rifles and equipment.\n\nComplete missions, improve your arsenal, and enjoy a satisfying arcade sniping experience in a post-apocalyptic world where precision is everything.\n\nAim. Fire. Upgrade. Enjoy.\n\nYou will always be safe... but your precision and tactics are real.", "short_description": "The city belongs to the infected... but the rooftops are yours."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.palexen.com/privacy-policy", "develop
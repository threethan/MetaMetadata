111690421_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0XQoQyQOh4EQ7kNvwGZ-nOs&_nc_oc=Adqn47bJjiqL71mRVt7TFDB2Bpe1I14WJAPzcBn8NC4JSINVPpOK4wKX-r8pOjAOQPo&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKE0zObdCV230DvUsn73mjZ85qbeGlbn7kQiob4Na9rhQ&oe=6A9C229E"}, {"file_name": "ss_2.png", "id": "1404481898286994", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/507818746_1404481901620327_6035599619384496812_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4eCmxD0uqt4Q7kNvwHHZBHs&_nc_oc=AdoAeJwtHvmw1HMCP3ZDAWwCGnIg0OvANdRw91RJwYVGW8DvxEVWyWvYjRUSmZ2ctrA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI5-P8xoLkVklkYH5GeQlzWo5OzJfWzXzNZ15BqBZrtYQ&oe=6A9C2D39"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Store_hero_2560.png", "id": "28531409386459912", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499620921_28531409393126578_4773895868748841143_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zMTm-gLb4N8Q7kNvwE09jqI&_nc_oc=Adpyn5g0fljh5dU11gMfaANIk8uRzCBldXImCQlFQQSFHz9E8ANXOEMNyJcAFaqEvz8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLOOEE8cvoSYTonjYQmhizs8I69k_vebLUzCYFE62kuBw&oe=6A9C2782"}, "display_name": "Zombie Sniper 2", "keywords": ["Zombie", "Sniper", "Shooter", "Arcade", "Apocalipse"], "long_description": "Play as Raven 6, an elite sniper protecting the city from a secure vantage point. Take your time, line up the perfect shot, eliminate the infected, and earn rewards to unlock powerful rifles and equipment.\n\nComplete missions, improve your arsenal, and enjoy a satisfying arcade sniping experience in a post-apocalyptic world where precision is everything.\n\nAim. Fire. Upgrade. Enjoy.\n\nYou will always be safe... but your precision and tactics are real.", "short_description": "The city belongs to the infected... but the rooftops are yours."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.palexen.com/privacy-policy", "develop
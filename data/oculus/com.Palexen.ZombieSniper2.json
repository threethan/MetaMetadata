111690421_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2XG019_oIU8Q7kNvwEBGVko&_nc_oc=Adr1I4JAlYSgZXqZnGupzmi0fZY36gFVNljtMoLy_RIcXzARJjkexoITDWXA8DG1bH4&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJCQ3CdrStp5ZZ2TkwSGFKu6XbgTeaHiij4jynfFDgZoQ&oe=6AA55D1E"}, {"file_name": "ss_2.png", "id": "1404481898286994", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/507818746_1404481901620327_6035599619384496812_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6Vfr2ZUWTXAQ7kNvwFaYu8X&_nc_oc=AdrW0X7LOyQZZJh3Qej3BWEN75qcaxam63AGTFaMlaO1S1-g7prWcMN1AbtZsiZleN4&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKOUAM-_rplSZWZTHQFlVEaazISyVEApx2ZUS1MloTaLQ&oe=6AA567B9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Store_hero_2560.png", "id": "28531409386459912", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499620921_28531409393126578_4773895868748841143_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dCIl87KqGboQ7kNvwEWbk2h&_nc_oc=Adp5JiTJ6BpqeXakiRIvbp28LMwrGGS1oIKOPVpXdvj8mlG92IC-hbEmQvLktqoYJ8o&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ6s32UVv2AgfZNKqUGyr_2XANRuLE4CYf9i9Z7-fiyPQ&oe=6AA56202"}, "display_name": "Zombie Sniper 2", "keywords": ["Zombie", "Sniper", "Shooter", "Arcade", "Apocalipse"], "long_description": "Play as Raven 6, an elite sniper protecting the city from a secure vantage point. Take your time, line up the perfect shot, eliminate the infected, and earn rewards to unlock powerful rifles and equipment.\n\nComplete missions, improve your arsenal, and enjoy a satisfying arcade sniping experience in a post-apocalyptic world where precision is everything.\n\nAim. Fire. Upgrade. Enjoy.\n\nYou will always be safe... but your precision and tactics are real.", "short_description": "The city belongs to the infected... but the rooftops are yours."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.palexen.com/privacy-policy", "develop
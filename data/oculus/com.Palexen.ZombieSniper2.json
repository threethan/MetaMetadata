111690421_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JkxGFlH03nMQ7kNvwEp8jA-&_nc_oc=AdpUdI93nMh4KRXoNi6k95VVRp3piQB4xF4EaxWSXXy0_NqsfrP3aGRZtKblCcHOlpY&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR8yIJuE3xvnB4n_zYgtc4VVN2DN7oxLq0eXJAAOEhGaQ&oe=6AEC8E1E"}, {"file_name": "ss_2.png", "id": "1404481898286994", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/507818746_1404481901620327_6035599619384496812_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-YKm9U08BLAQ7kNvwG18AXW&_nc_oc=AdqNb_xttjPwgAi2uNtKU3vYyyM97akkOjOm2nedk4F0evy3W9sxo-haswW7qKmmgPU&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTr0KBD4w_OLO3MbZQ2JVT9h8KUseRIaAAVzZgYuRqUcA&oe=6AEC98B9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Store_hero_2560.png", "id": "28531409386459912", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/499620921_28531409393126578_4773895868748841143_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BGG74p6LEYQQ7kNvwEJgtJe&_nc_oc=AdpfHt15ApOqL-ZrZdydIxcJq07HYcTlabOtQJTYIV5vfbase6pViWsJtOLI1CVG9mY&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQcFwFIrXGtycABDA1EdDUKuVZ3oiTDjlE8Eqij14wscg&oe=6AEC9302"}, "display_name": "Zombie Sniper 2", "keywords": ["Zombie", "Sniper", "Shooter", "Arcade", "Apocalipse"], "long_description": "Play as Raven 6, an elite sniper protecting the city from a secure vantage point. Take your time, line up the perfect shot, eliminate the infected, and earn rewards to unlock powerful rifles and equipment.\n\nComplete missions, improve your arsenal, and enjoy a satisfying arcade sniping experience in a post-apocalyptic world where precision is everything.\n\nAim. Fire. Upgrade. Enjoy.\n\nYou will always be safe... but your precision and tactics are real.", "short_description": "The city belongs to the infected... but the rooftops are yours."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.palexen.com/privacy-policy", "develop
111690421_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OmTCYje1UycQ7kNvwF5pKf-&_nc_oc=AdrkLTh4_DjjLSSgoaFhbwjg1_erBtBFTOTfISsssM9zntbTF99i88i9cBogk1sor8A&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP0PeLPRtc5Qnzv3T8D4hRnlHwSRYr9xv8JvhrWJoPWyA&oe=6AC3AF9E"}, {"file_name": "ss_2.png", "id": "1404481898286994", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/507818746_1404481901620327_6035599619384496812_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QXnIfQU_E_8Q7kNvwFS4bEc&_nc_oc=Adqxux7-r_Re62suXITmJ5HU_G2_hJ2CK04LjIBX7yHhHQp3Zrq_L6_qWDv264gHKlA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN4klkvrnzFEofRQQ8sBQIr0gDDaOuvLPG-gjUzfiRU-g&oe=6AC3BA39"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Store_hero_2560.png", "id": "28531409386459912", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499620921_28531409393126578_4773895868748841143_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KkbvokwbtgEQ7kNvwFCqn5q&_nc_oc=AdqEznazd_schBQbPoXxCKyObjvakphZdjyjnUIsi5BnMOLnb_a3crbVT1QXEob08X4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNL1CPHsrDlpHQ4sFMMQiO_Jih_BUkNpmwvNn0RHwUXNA&oe=6AC3B482"}, "display_name": "Zombie Sniper 2", "keywords": ["Zombie", "Sniper", "Shooter", "Arcade", "Apocalipse"], "long_description": "Play as Raven 6, an elite sniper protecting the city from a secure vantage point. Take your time, line up the perfect shot, eliminate the infected, and earn rewards to unlock powerful rifles and equipment.\n\nComplete missions, improve your arsenal, and enjoy a satisfying arcade sniping experience in a post-apocalyptic world where precision is everything.\n\nAim. Fire. Upgrade. Enjoy.\n\nYou will always be safe... but your precision and tactics are real.", "short_description": "The city belongs to the infected... but the rooftops are yours."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.palexen.com/privacy-policy", "develop
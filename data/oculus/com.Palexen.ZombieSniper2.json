111690421_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2XG019_oIU8Q7kNvwE8bhDk&_nc_oc=Adp_b7NErJefd6BaPfBr2XiCwx6dPmzbi0eVDH9tsL4SiRK2gB1-JP7330oWdnEWwlI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIuVW27lNpelgJ6cHFXeL0cJkTU35sWmBX8aPSmLkrJyw&oe=6AA2BA1E"}, {"file_name": "ss_2.png", "id": "1404481898286994", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/507818746_1404481901620327_6035599619384496812_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZKk4qzybftQQ7kNvwGgE7x9&_nc_oc=Adp8vae5UIerwBtUnf6a-SsdDvkY6DnLIsxKzrJlqXtYaWnolcxFQO0DcKOyswqi-ic&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL_tSxGttWMGX0U0nH0qqUoUvkLLD-1TKhsP2y1XmJW1A&oe=6AA2C4B9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Store_hero_2560.png", "id": "28531409386459912", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499620921_28531409393126578_4773895868748841143_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KMBsv8YBtH4Q7kNvwGPORoO&_nc_oc=AdoNjDdXietdezC2WWSThhS3bA3_2h-_DMPIAx84S0dTDyNWiSgUAl4Z_VVS-COJq0U&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLupHC4Z0m49OSUtX8FNWJvo8VJdi9RBrGU5ev9fTnWrA&oe=6AA2BF02"}, "display_name": "Zombie Sniper 2", "keywords": ["Zombie", "Sniper", "Shooter", "Arcade", "Apocalipse"], "long_description": "Play as Raven 6, an elite sniper protecting the city from a secure vantage point. Take your time, line up the perfect shot, eliminate the infected, and earn rewards to unlock powerful rifles and equipment.\n\nComplete missions, improve your arsenal, and enjoy a satisfying arcade sniping experience in a post-apocalyptic world where precision is everything.\n\nAim. Fire. Upgrade. Enjoy.\n\nYou will always be safe... but your precision and tactics are real.", "short_description": "The city belongs to the infected... but the rooftops are yours."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.palexen.com/privacy-policy", "develop
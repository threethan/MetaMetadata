111690421_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2ZNwfVt6HXsQ7kNvwFIUhC5&_nc_oc=Adph_4xq8EDPC7ANaIEmvYKqDmsOlEbnllw5dkrOS2GynM8jqzAEGEiZRNTZ6iYBsu4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIwYO0nxRgr7cEw-nGSxYluYlhRVSIg4fbcZ6gJ0BFCSg&oe=6A997F9E"}, {"file_name": "ss_2.png", "id": "1404481898286994", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/507818746_1404481901620327_6035599619384496812_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GzjC34ymavYQ7kNvwGdx0ni&_nc_oc=AdqQBsToGnsmwGhHGGIBjQx4Fd44OXYcdWJyyuZFK7IRGoomFuOMnGMsjccVcajCCz0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIc3SXb4VkwdegqQOKXKPHY8m35cOHqGng066oxPoZlRQ&oe=6A998A39"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Store_hero_2560.png", "id": "28531409386459912", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499620921_28531409393126578_4773895868748841143_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=slvspS5SU4MQ7kNvwEf5ovA&_nc_oc=Adqr_m6SQAv9VgIWbhAqDCcT9p1HWuM3sdPMSCXrxa0noRvb6TSFHwdJ2hDl1CoGCHs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIW5T9V7Z1F7GksgkQ9BAEtukIQtq1cMZDnd-jBwZo32A&oe=6A998482"}, "display_name": "Zombie Sniper 2", "keywords": ["Zombie", "Sniper", "Shooter", "Arcade", "Apocalipse"], "long_description": "Play as Raven 6, an elite sniper protecting the city from a secure vantage point. Take your time, line up the perfect shot, eliminate the infected, and earn rewards to unlock powerful rifles and equipment.\n\nComplete missions, improve your arsenal, and enjoy a satisfying arcade sniping experience in a post-apocalyptic world where precision is everything.\n\nAim. Fire. Upgrade. Enjoy.\n\nYou will always be safe... but your precision and tactics are real.", "short_description": "The city belongs to the infected... but the rooftops are yours."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.palexen.com/privacy-policy", "develop
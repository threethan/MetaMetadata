111690421_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jvpNvnJ6Cp4Q7kNvwGwDQKQ&_nc_oc=Adrj33cEt9EO4Bqb1jWcy18vkr1zdnnd0XESEtpgrdUWjeLxWIsVTUVa1BkBrMCTdM8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSDs9S_vQUHQtDudUM9a3ltdtp3Fp1ozpcdTquhkUAFDQ&oe=6AEDDF9E"}, {"file_name": "ss_2.png", "id": "1404481898286994", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/507818746_1404481901620327_6035599619384496812_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-YKm9U08BLAQ7kNvwGvFKFD&_nc_oc=AdrfXEk3fC1Xls0Ow9WY2o597t6hI9RQTiAQGKzYipJ7EoS0QvQifkX750y2iIBi_p0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTgrwPGR90b6TjH3NxavnW74GMtkwMcfPezAG4EBeOWKA&oe=6AEDEA39"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Store_hero_2560.png", "id": "28531409386459912", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499620921_28531409393126578_4773895868748841143_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BGG74p6LEYQQ7kNvwFhiTIn&_nc_oc=Adqjx1liWknYZSp19bAeWHsginfp3Ovb1aFniQDhdMMdbwmZqydpxBQ5vIhpoqz5rLg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQmw3n7NUut_lNghk3F-jqhuUpIxBOzOdh5ulS7DLV8RQ&oe=6AEDE482"}, "display_name": "Zombie Sniper 2", "keywords": ["Zombie", "Sniper", "Shooter", "Arcade", "Apocalipse"], "long_description": "Play as Raven 6, an elite sniper protecting the city from a secure vantage point. Take your time, line up the perfect shot, eliminate the infected, and earn rewards to unlock powerful rifles and equipment.\n\nComplete missions, improve your arsenal, and enjoy a satisfying arcade sniping experience in a post-apocalyptic world where precision is everything.\n\nAim. Fire. Upgrade. Enjoy.\n\nYou will always be safe... but your precision and tactics are real.", "short_description": "The city belongs to the infected... but the rooftops are yours."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.palexen.com/privacy-policy", "develop
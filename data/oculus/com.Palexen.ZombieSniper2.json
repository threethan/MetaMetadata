111690421_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JkxGFlH03nMQ7kNvwETyRgV&_nc_oc=AdpZM4bztrVcJEYWElP5jdkAvh_ioN93Zxaqo56YfwWAcY7_3Ipx3f7mdz3f1xSmCC8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQY_Ps0PU4bljQ1BWbAWhARo3DMppjxW6tnVY7DuVjSSg&oe=6AEB3C9E"}, {"file_name": "ss_2.png", "id": "1404481898286994", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/507818746_1404481901620327_6035599619384496812_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-YKm9U08BLAQ7kNvwHVUjKy&_nc_oc=AdpLX3R0mg6WxkngggFFikJVRyk3HkdsSiGAu1FEsHLN3ct-5H_SlS6mRP44_5SyKOc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTfBGDBe4NpP1eO0SZbr7DUgXyHQzy4v8SZE7wCAPkBIA&oe=6AEB4739"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Store_hero_2560.png", "id": "28531409386459912", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499620921_28531409393126578_4773895868748841143_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BGG74p6LEYQQ7kNvwHFRGWp&_nc_oc=AdpznA9HzLAghekppUXlvd-Oz0_W9BiwsHNPhOGwU7iVwIeWHjEecFqxAu4zBM1l2Ps&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQCZS8rqo-6m1tlIJR3jRBjdKp6Mj06ko2s4xHyNRs-Wg&oe=6AEB4182"}, "display_name": "Zombie Sniper 2", "keywords": ["Zombie", "Sniper", "Shooter", "Arcade", "Apocalipse"], "long_description": "Play as Raven 6, an elite sniper protecting the city from a secure vantage point. Take your time, line up the perfect shot, eliminate the infected, and earn rewards to unlock powerful rifles and equipment.\n\nComplete missions, improve your arsenal, and enjoy a satisfying arcade sniping experience in a post-apocalyptic world where precision is everything.\n\nAim. Fire. Upgrade. Enjoy.\n\nYou will always be safe... but your precision and tactics are real.", "short_description": "The city belongs to the infected... but the rooftops are yours."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.palexen.com/privacy-policy", "develop
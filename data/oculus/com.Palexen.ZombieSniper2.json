111690421_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v76s51gk1d4Q7kNvwHN5vMP&_nc_oc=AdoKXqMQLsdTW_gT9GFm_7CVTT30XkyNwP9q-GUFzfmM7YumL9bGIFTXH9sze3PTsWA&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPdDzcrnGwjR7pIBPd-iwGXPTYI3S1eD_jDl3Vu2x_skQ&oe=6AD0DE9E"}, {"file_name": "ss_2.png", "id": "1404481898286994", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/507818746_1404481901620327_6035599619384496812_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rcBbSc8Xyf4Q7kNvwFaYoOM&_nc_oc=AdqAJAJwpB1ISWjvcB1AE4ZlXXFehPduyahkjPBu2q1yKNeV-3Z-6mJFFRnH5w8xQ_w&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOoILEBvPwLz6COyz_ZVx-dSVW-aJ6E7wwlgc4Ux-UILg&oe=6AD0E939"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Store_hero_2560.png", "id": "28531409386459912", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/499620921_28531409393126578_4773895868748841143_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QfU3MxZHetUQ7kNvwFr37tP&_nc_oc=AdqlEAyGvGpid9w4h9pRuuSCMuFfth-2YCrHAQX5W6U6asmquH70qXOmak8CXzXxlpg&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOdeauVVpz3Y9a_eigG0fvuhn5Xazz5MpO4JVXhU7hjYQ&oe=6AD0E382"}, "display_name": "Zombie Sniper 2", "keywords": ["Zombie", "Sniper", "Shooter", "Arcade", "Apocalipse"], "long_description": "Play as Raven 6, an elite sniper protecting the city from a secure vantage point. Take your time, line up the perfect shot, eliminate the infected, and earn rewards to unlock powerful rifles and equipment.\n\nComplete missions, improve your arsenal, and enjoy a satisfying arcade sniping experience in a post-apocalyptic world where precision is everything.\n\nAim. Fire. Upgrade. Enjoy.\n\nYou will always be safe... but your precision and tactics are real.", "short_description": "The city belongs to the infected... but the rooftops are yours."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.palexen.com/privacy-policy", "develop
111690421_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FDSTXD9SkgoQ7kNvwGigInP&_nc_oc=Adp1OSsTYZudC3xkHfVcVWJvhv_mGJQPwDQ7goeZx-1clgyD8GfZyopsEZ-T1xxZnP8&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFH5d0bDfpn5HHY9qHj57UmKQ0yFJ2Ej_eNMK7zA4esfQ&oe=6A92AFDE"}, {"file_name": "ss_2.png", "id": "1404481898286994", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/507818746_1404481901620327_6035599619384496812_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_KO3368Tae0Q7kNvwEWD30_&_nc_oc=AdpZBGfET0EzW1jVxkhGgcjsecrg5sDyCSRD5j4706Juo9qG7llIVP1qVVMmtYjFuOk&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF28dhMzlk3hjIWAJikZsoyuugNQlBqWdu0hYUy3pBOxg&oe=6A92BA79"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Store_hero_2560.png", "id": "28531409386459912", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/499620921_28531409393126578_4773895868748841143_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aJID7Oj1ZrYQ7kNvwERczh5&_nc_oc=AdppYzgVpmzONVc1n-rDX3yXfY_FJMGpxmsxYQj2xnITz3NboVI7l8rsb5xCVFGXAlY&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHE9OrL5mLXshfQKjouv12G4Ym3cfmeI1yFR5vNCVuRNg&oe=6A92B4C2"}, "display_name": "Zombie Sniper 2", "keywords": ["Zombie", "Sniper", "Shooter", "Arcade", "Apocalipse"], "long_description": "Play as Raven 6, an elite sniper protecting the city from a secure vantage point. Take your time, line up the perfect shot, eliminate the infected, and earn rewards to unlock powerful rifles and equipment.\n\nComplete missions, improve your arsenal, and enjoy a satisfying arcade sniping experience in a post-apocalyptic world where precision is everything.\n\nAim. Fire. Upgrade. Enjoy.\n\nYou will always be safe... but your precision and tactics are real.", "short_description": "The city belongs to the infected... but the rooftops are yours."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.palexen.com/privacy-policy", "develop
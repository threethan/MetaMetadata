111690421_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kialbl0a7uQQ7kNvwFg7eMK&_nc_oc=Adqp69O6LYwud9c5M-29HjNcFWsukPO1GkJiN-8qtn-1Q26bX5Aw5PFhv1WV7ORH5P8&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPYiXZNS-ALcVR-tYHSyNknbfaJal3y0K0M07RCRAl6qw&oe=6AE0B09E"}, {"file_name": "ss_2.png", "id": "1404481898286994", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/507818746_1404481901620327_6035599619384496812_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WrpBQLTQXz4Q7kNvwGOR-a5&_nc_oc=Adr28Sp8GVcyhgxV1rnzk8Kww0PjmfvvsymimzoKZI81ZpC1tf9fNyTZTNTs3qkkxhA&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMXLZL5CggzUlfhEVtcAy1ksvH4YO3DHYeU0CG-ZWcLLg&oe=6AE0BB39"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Store_hero_2560.png", "id": "28531409386459912", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499620921_28531409393126578_4773895868748841143_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bu-YJr6OWF8Q7kNvwHE-mAe&_nc_oc=AdowxO-yXQaHjo9WHih3ooJEV_RS9jpYmVk6pSGJo62k7u4w3PaOWTXhK8CA57t5eII&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOHvvVhUVgEfrKCOzfaivrhHemqBrKCnrtLRgxWyxEf5Q&oe=6AE0B582"}, "display_name": "Zombie Sniper 2", "keywords": ["Zombie", "Sniper", "Shooter", "Arcade", "Apocalipse"], "long_description": "Play as Raven 6, an elite sniper protecting the city from a secure vantage point. Take your time, line up the perfect shot, eliminate the infected, and earn rewards to unlock powerful rifles and equipment.\n\nComplete missions, improve your arsenal, and enjoy a satisfying arcade sniping experience in a post-apocalyptic world where precision is everything.\n\nAim. Fire. Upgrade. Enjoy.\n\nYou will always be safe... but your precision and tactics are real.", "short_description": "The city belongs to the infected... but the rooftops are yours."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.palexen.com/privacy-policy", "develop
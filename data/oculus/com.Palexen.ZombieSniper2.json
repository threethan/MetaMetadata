111690421_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2ZNwfVt6HXsQ7kNvwH8PZOg&_nc_oc=AdpnBqF-9wHlA0N6BRrm6U6WkbDS0pvL9aQQ5Z8rgCRxaeto7ea6ZfhUM-i1ihhwnRA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIba-wDEiYC7LX9g7y9PCIEz_I6ziXT_MZVWb8uWpekAQ&oe=6A98665E"}, {"file_name": "ss_2.png", "id": "1404481898286994", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/507818746_1404481901620327_6035599619384496812_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GzjC34ymavYQ7kNvwGsxS44&_nc_oc=AdrKaLY1_yRYtII1hfpRweM37F58UZTzSLK5Z71jhpipRb5NJbeoQzdM2bDiWBribuo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJD2-gm0yck9OGKLICKdvQmB5UajJa5RJWW2662GeLClQ&oe=6A9838B9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Store_hero_2560.png", "id": "28531409386459912", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499620921_28531409393126578_4773895868748841143_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=slvspS5SU4MQ7kNvwEfPtFw&_nc_oc=AdrgyqaadOIozZBwcJFCGAi-RpO3zxs6LFBbPmF1WgQpMohx6mXl7YBnONtZqI_XGRw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJaDgv5dbJfWuh2eWVz-iH3MwkI8SXkQ_EqMA8uZxZFrA&oe=6A986B42"}, "display_name": "Zombie Sniper 2", "keywords": ["Zombie", "Sniper", "Shooter", "Arcade", "Apocalipse"], "long_description": "Play as Raven 6, an elite sniper protecting the city from a secure vantage point. Take your time, line up the perfect shot, eliminate the infected, and earn rewards to unlock powerful rifles and equipment.\n\nComplete missions, improve your arsenal, and enjoy a satisfying arcade sniping experience in a post-apocalyptic world where precision is everything.\n\nAim. Fire. Upgrade. Enjoy.\n\nYou will always be safe... but your precision and tactics are real.", "short_description": "The city belongs to the infected... but the rooftops are yours."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.palexen.com/privacy-policy", "develop
111690421_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U8fLGnD02gIQ7kNvwFQUhXR&_nc_oc=Adp3A3TMsVpWn3tNOIlNmzNdZ4oawx-cktado5y1sVUCvckVl_sbaQ0VqhKifqQ06-Q&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRA3iFQpEdm0FZIKRxVvQRk5bskKhqEWReMobui9EHTlg&oe=6AF9BD1E"}, {"file_name": "ss_2.png", "id": "1404481898286994", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/507818746_1404481901620327_6035599619384496812_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bufnUXClMdMQ7kNvwFrWWg0&_nc_oc=Adpf-pEbazOs5A3MZ1fAWpmzJ2isfySVaeD65VX78W6Ic52uZDwZjq6Aj90bcaiW-lg&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQxtShGYITcstA44nXrpW3P0fF4H9EsTm5Rf3BOnIkHbg&oe=6AF9C7B9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Store_hero_2560.png", "id": "28531409386459912", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/499620921_28531409393126578_4773895868748841143_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iR1fUXX8juUQ7kNvwHiiT2D&_nc_oc=Adq84yzGVOmKv9BZMvKavugzTUh3ZsPxTrNRZIUlGDsCpo-PM5OvNxcPEwC0NET462Q&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT7GlC8E2U66FI2f0_gOU_hkFxfsYEcozQ90cZWjY1UAg&oe=6AF9C202"}, "display_name": "Zombie Sniper 2", "keywords": ["Zombie", "Sniper", "Shooter", "Arcade", "Apocalipse"], "long_description": "Play as Raven 6, an elite sniper protecting the city from a secure vantage point. Take your time, line up the perfect shot, eliminate the infected, and earn rewards to unlock powerful rifles and equipment.\n\nComplete missions, improve your arsenal, and enjoy a satisfying arcade sniping experience in a post-apocalyptic world where precision is everything.\n\nAim. Fire. Upgrade. Enjoy.\n\nYou will always be safe... but your precision and tactics are real.", "short_description": "The city belongs to the infected... but the rooftops are yours."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.palexen.com/privacy-policy", "develop
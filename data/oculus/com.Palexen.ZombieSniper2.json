111690421_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G3HxiA5JBTcQ7kNvwEe3hng&_nc_oc=AdotFJ7jjDWuSsR8_e8NZyG91EnFM7nYQ488QjqBWgKDV36tZOpRi3u6gFND9wCAu1o&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIZ3AdxEFVmtTConHbni5vTADgGbiBVNTtB7dtrvzq48g&oe=6AAAA31E"}, {"file_name": "ss_2.png", "id": "1404481898286994", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/507818746_1404481901620327_6035599619384496812_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qD5-argv6AsQ7kNvwEYtsIf&_nc_oc=AdqiLmMGZ1kdQQmB5A_xTEH-fao6L7mlljCaFOKF82LwimZKYIhAMrxKaVHW2_F5yFw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIgASTTfWWTBNLgSY0S3AfY_ry6H_FnM5RGNsS9ckf0XA&oe=6AAAADB9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Store_hero_2560.png", "id": "28531409386459912", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499620921_28531409393126578_4773895868748841143_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IoYAuQnGaVgQ7kNvwFqZ3Aq&_nc_oc=Ado5egs8y5-rfQwAdbxiSOBM24mkIpsJp1kIjrWbD6tbMXLlMQUqLapnEHXdtpNDRmc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK_h-3nXNeSyiU6Z6AEA-M6DaG11KqScY22nTfXViLgCA&oe=6AAAA802"}, "display_name": "Zombie Sniper 2", "keywords": ["Zombie", "Sniper", "Shooter", "Arcade", "Apocalipse"], "long_description": "Play as Raven 6, an elite sniper protecting the city from a secure vantage point. Take your time, line up the perfect shot, eliminate the infected, and earn rewards to unlock powerful rifles and equipment.\n\nComplete missions, improve your arsenal, and enjoy a satisfying arcade sniping experience in a post-apocalyptic world where precision is everything.\n\nAim. Fire. Upgrade. Enjoy.\n\nYou will always be safe... but your precision and tactics are real.", "short_description": "The city belongs to the infected... but the rooftops are yours."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.palexen.com/privacy-policy", "develop
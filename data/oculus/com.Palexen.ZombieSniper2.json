111690421_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mfzr3-6zVBgQ7kNvwHSxMIF&_nc_oc=Ado7VL9MNClCGqHKtSuQpBHFtmBY6JmGmtBtF7PUwkZxYjPwwpjYZQGfKhHnG01EPBY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL2BL3TCwRVySnwWRVIyQjV9_5CXWK74MNN17GrlBzsgA&oe=6ABBC69E"}, {"file_name": "ss_2.png", "id": "1404481898286994", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/507818746_1404481901620327_6035599619384496812_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8WxQlmSAbA4Q7kNvwG8_0h2&_nc_oc=AdqjTkx7SWkU1wNDLbWGzaV8f8meJLTMlVuPE_nryPC35k2qzOzo4Ad2e8hSwAxUubs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLaXFge2W9Oh8TausDu1HpuwQnt3KHD8BDs_mHitb_aWg&oe=6ABBD139"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Store_hero_2560.png", "id": "28531409386459912", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499620921_28531409393126578_4773895868748841143_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RJCK3qn17PAQ7kNvwGZgcEy&_nc_oc=AdprH5KQcHV5Ti2-90VqPLbMQ7s2n3fCynoVONuxN8ZjEfbeGCfH5i4gxbShtDB2EZY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKlfXKtsIfaIx_G0Akj_y5SU2FJ-6MrCugoIjBzq4MFZw&oe=6ABBCB82"}, "display_name": "Zombie Sniper 2", "keywords": ["Zombie", "Sniper", "Shooter", "Arcade", "Apocalipse"], "long_description": "Play as Raven 6, an elite sniper protecting the city from a secure vantage point. Take your time, line up the perfect shot, eliminate the infected, and earn rewards to unlock powerful rifles and equipment.\n\nComplete missions, improve your arsenal, and enjoy a satisfying arcade sniping experience in a post-apocalyptic world where precision is everything.\n\nAim. Fire. Upgrade. Enjoy.\n\nYou will always be safe... but your precision and tactics are real.", "short_description": "The city belongs to the infected... but the rooftops are yours."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.palexen.com/privacy-policy", "develop
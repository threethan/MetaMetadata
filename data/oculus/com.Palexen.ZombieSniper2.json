111690421_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3-1vvp_oPAkQ7kNvwFx1N9J&_nc_oc=AdrwBl4S9VxqhGFMtEZjcLvKJOnK14nzLW7UDsbUaAtBRkT_OxMPrZHYBpiIsHhKo4Y&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMAVa0bj8uTOO7MRcodJbLWokNfrAl5g2kK8-PFPFd2qw&oe=6AC8F59E"}, {"file_name": "ss_2.png", "id": "1404481898286994", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/507818746_1404481901620327_6035599619384496812_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WKJVGHSjujsQ7kNvwERvw6s&_nc_oc=AdrHKQSf4tUl5ktlkE57kUyHcczWYRyn-6Gw7RVxDxubsc5H5Krct6HWyqbVl5jGNJ0&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNfSkvNAL-ipVDn6H7U2N73ZJci_gxN5SvwH1ZQH9aHnQ&oe=6AC90039"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Store_hero_2560.png", "id": "28531409386459912", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/499620921_28531409393126578_4773895868748841143_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=abmH9-JcbA0Q7kNvwEHZ9ds&_nc_oc=AdpM-rqut2Vdj9GUePyGAEA75ZdSlQ6ZV3vaFwrfAkvgEdx9sorJ3vAQK6s7VdezKaA&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNXUOD2XTtDgTSuypLCrIVncArz4FjRkgTh260lPLNAqA&oe=6AC8FA82"}, "display_name": "Zombie Sniper 2", "keywords": ["Zombie", "Sniper", "Shooter", "Arcade", "Apocalipse"], "long_description": "Play as Raven 6, an elite sniper protecting the city from a secure vantage point. Take your time, line up the perfect shot, eliminate the infected, and earn rewards to unlock powerful rifles and equipment.\n\nComplete missions, improve your arsenal, and enjoy a satisfying arcade sniping experience in a post-apocalyptic world where precision is everything.\n\nAim. Fire. Upgrade. Enjoy.\n\nYou will always be safe... but your precision and tactics are real.", "short_description": "The city belongs to the infected... but the rooftops are yours."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.palexen.com/privacy-policy", "develop
111690421_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FDSTXD9SkgoQ7kNvwGgFc-J&_nc_oc=AdrdqClz0y_H4WSIBF12gQgNucbvQ9dwEN8uD2Z8Ts4hY8K2lYhb7aSMtRA81xRo-Lk&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGQN2cMayNs-7CdbXVXoYjYuqVeSnx_hOVBQPaxUayf0g&oe=6A94015E"}, {"file_name": "ss_2.png", "id": "1404481898286994", "uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/507818746_1404481901620327_6035599619384496812_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2pd6khK8tsYQ7kNvwHG9gCR&_nc_oc=Adq3DKnOpUvnID0Uqh8rM_J3KCEonUtqmkbXHedkbpBxwqudc2QrA1bX0-YfF1RLLyQ&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGxyhM8VNMgo-FHtfy9A_dXDFqothTjRwiTZll2masZew&oe=6A940BF9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Store_hero_2560.png", "id": "28531409386459912", "uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/499620921_28531409393126578_4773895868748841143_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cmazB7odF10Q7kNvwGpYp0-&_nc_oc=AdpPbja8xOIsY7zHjNZzlS1_4quiTBoffujIIe4HxHHYALSP8YH2pFHZUlSBgt6Pe7Q&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEuAhuHCh2tYb5uIsdot5Yy9myWlCoRSlVsRRMzy0s_EA&oe=6A940642"}, "display_name": "Zombie Sniper 2", "keywords": ["Zombie", "Sniper", "Shooter", "Arcade", "Apocalipse"], "long_description": "Play as Raven 6, an elite sniper protecting the city from a secure vantage point. Take your time, line up the perfect shot, eliminate the infected, and earn rewards to unlock powerful rifles and equipment.\n\nComplete missions, improve your arsenal, and enjoy a satisfying arcade sniping experience in a post-apocalyptic world where precision is everything.\n\nAim. Fire. Upgrade. Enjoy.\n\nYou will always be safe... but your precision and tactics are real.", "short_description": "The city belongs to the infected... but the rooftops are yours."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.palexen.com/privacy-policy", "develop
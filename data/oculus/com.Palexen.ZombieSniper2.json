111690421_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3-1vvp_oPAkQ7kNvwFwYeGd&_nc_oc=AdqUARjYbZ0I6OZEz_hJmYJYhjmg7ACc-nzwt71DUQobbjYWJXJyv2hmAweA48O2Gbg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOWl8aYJue9CjXU3iOOAPGGHfJYFG68cb-McFOG2PhDzQ&oe=6AC6529E"}, {"file_name": "ss_2.png", "id": "1404481898286994", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/507818746_1404481901620327_6035599619384496812_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QXnIfQU_E_8Q7kNvwGLRLKd&_nc_oc=AdqG-wCFhkWUzoTlcG_4wbOx-OUazNETcVq_Vm9ZxdAhGZkr0MtWZLy9Lk7idBNdVfM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOu8R1VCN_mCKsWtuSCcXRzSsK4dZ94mPMi1XSKdO7hEQ&oe=6AC65D39"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Store_hero_2560.png", "id": "28531409386459912", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499620921_28531409393126578_4773895868748841143_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KkbvokwbtgEQ7kNvwGlRFYX&_nc_oc=Adr2z64RkXK_s3DVVB0K3a5zKKs6fDSaq8Dse0_BhV6V0MPMF6YatKcJBRXyaUjM07o&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOpCGrrUH_qdhESUX8lYMBtxNY9krSwd4IZ7gt0T0Nekw&oe=6AC65782"}, "display_name": "Zombie Sniper 2", "keywords": ["Zombie", "Sniper", "Shooter", "Arcade", "Apocalipse"], "long_description": "Play as Raven 6, an elite sniper protecting the city from a secure vantage point. Take your time, line up the perfect shot, eliminate the infected, and earn rewards to unlock powerful rifles and equipment.\n\nComplete missions, improve your arsenal, and enjoy a satisfying arcade sniping experience in a post-apocalyptic world where precision is everything.\n\nAim. Fire. Upgrade. Enjoy.\n\nYou will always be safe... but your precision and tactics are real.", "short_description": "The city belongs to the infected... but the rooftops are yours."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.palexen.com/privacy-policy", "develop
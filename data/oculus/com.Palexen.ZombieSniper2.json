111690421_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kialbl0a7uQQ7kNvwHKXtFm&_nc_oc=Ado5OW6Ll78qpYXNreeKsnOXcwzd0js7CuH7oQs6pqeiqnc-vOfPfbaBbPFCll7NtOQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOudx1dCk_e6fSKB18xT-lPJn4nusMchhsZblKZjuziXg&oe=6ADF5F1E"}, {"file_name": "ss_2.png", "id": "1404481898286994", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/507818746_1404481901620327_6035599619384496812_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WrpBQLTQXz4Q7kNvwFND8GU&_nc_oc=AdqC-mc67tGBrqCoD6OFbd18QvIhTucc5QzTgH--QGeh-VtcKwmMVrZuz80GzNSrQ68&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM6rQ5rJm-s1FMK41H38eBnL6ZSDrt2kqpQrHo1E1cN3Q&oe=6ADF69B9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Store_hero_2560.png", "id": "28531409386459912", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499620921_28531409393126578_4773895868748841143_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bu-YJr6OWF8Q7kNvwF40JU5&_nc_oc=AdoVFh7xlgbeESvQUFcHaIr-K9K1EbMc-I6-mncnYk88cyQ1GBAxDUL6u-DGJPW1Q1s&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOpVLlkz-qteP4VlJ5yMUXlmGNoTdDJ9jBo4_aAph4x4w&oe=6ADF6402"}, "display_name": "Zombie Sniper 2", "keywords": ["Zombie", "Sniper", "Shooter", "Arcade", "Apocalipse"], "long_description": "Play as Raven 6, an elite sniper protecting the city from a secure vantage point. Take your time, line up the perfect shot, eliminate the infected, and earn rewards to unlock powerful rifles and equipment.\n\nComplete missions, improve your arsenal, and enjoy a satisfying arcade sniping experience in a post-apocalyptic world where precision is everything.\n\nAim. Fire. Upgrade. Enjoy.\n\nYou will always be safe... but your precision and tactics are real.", "short_description": "The city belongs to the infected... but the rooftops are yours."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.palexen.com/privacy-policy", "develop
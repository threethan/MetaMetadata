111690421_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DvqildsHmRMQ7kNvwGWvD6A&_nc_oc=AdrRPoY3GMEghI6dGV9px2LxGtGCNAgWt31RipPm7vt0QyTbvijDQwR_b9F6N5_qOqg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKA8jtbLtWqRZhuyQuS2DopmZcxJM2g0OcQNL997MuxQw&oe=6AA8001E"}, {"file_name": "ss_2.png", "id": "1404481898286994", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/507818746_1404481901620327_6035599619384496812_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qD5-argv6AsQ7kNvwEReAQ_&_nc_oc=AdrMWXEzIGIzRRxkjFnPbhNT0DKftkAY_nVFYwBySMD2U_m8HTTRmk-a2GJ8Zo7a0h8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIV003WlBigtb-lX4ljNpjpM3ZQiWhD4IWKkqihdvjzVg&oe=6AA80AB9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Store_hero_2560.png", "id": "28531409386459912", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499620921_28531409393126578_4773895868748841143_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IoYAuQnGaVgQ7kNvwEyfoMo&_nc_oc=AdrCJRErJX94FLPwfW7uG3ToTavG5inj6Y2xBHbXYku5FRL7PvG8oXq72uhEjgkJZyk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKz2orbP02uTh7djhyW7csMA9EiHNNx-jgOwnkPzOh8gQ&oe=6AA80502"}, "display_name": "Zombie Sniper 2", "keywords": ["Zombie", "Sniper", "Shooter", "Arcade", "Apocalipse"], "long_description": "Play as Raven 6, an elite sniper protecting the city from a secure vantage point. Take your time, line up the perfect shot, eliminate the infected, and earn rewards to unlock powerful rifles and equipment.\n\nComplete missions, improve your arsenal, and enjoy a satisfying arcade sniping experience in a post-apocalyptic world where precision is everything.\n\nAim. Fire. Upgrade. Enjoy.\n\nYou will always be safe... but your precision and tactics are real.", "short_description": "The city belongs to the infected... but the rooftops are yours."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.palexen.com/privacy-policy", "develop
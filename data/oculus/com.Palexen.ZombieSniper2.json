111690421_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MeTJ_-BMiAsQ7kNvwFkoowJ&_nc_oc=AdrhZksS__3gzcC3dLeUSMMUbvF4lBBmfe7a-NaYaZmxnmASR8fgtjjUrPy63V988sQ&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPPyvccJdtPfJCdEXXS6-j8bc5JJ5wJacY5MfLcKOWH-Q&oe=6ADCBC1E"}, {"file_name": "ss_2.png", "id": "1404481898286994", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/507818746_1404481901620327_6035599619384496812_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AkXOhysl7tsQ7kNvwFFAbJ9&_nc_oc=AdotoVG_djIi2FjLNqotvq3FTcatUSSUcpA6ACE9X2iHTMSDFcvkSstHs78XRl2xe5U&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOw2Qp_67zFXmn2v96c34g4-JxXVLrHTx0wAa0PH8JaLw&oe=6ADCC6B9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Store_hero_2560.png", "id": "28531409386459912", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499620921_28531409393126578_4773895868748841143_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m1ZNJ04pUR4Q7kNvwE_jYnC&_nc_oc=Ado6EGDX1ZUCHb84z7hMPx8K4_yqDROc-AnOzz6IS6JS3amGL0Ta8iko-b442NluDuQ&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO3xFLELPRwdWB1VCjrvG3tclbtaPASuQBmrVFkimpnsw&oe=6ADCC102"}, "display_name": "Zombie Sniper 2", "keywords": ["Zombie", "Sniper", "Shooter", "Arcade", "Apocalipse"], "long_description": "Play as Raven 6, an elite sniper protecting the city from a secure vantage point. Take your time, line up the perfect shot, eliminate the infected, and earn rewards to unlock powerful rifles and equipment.\n\nComplete missions, improve your arsenal, and enjoy a satisfying arcade sniping experience in a post-apocalyptic world where precision is everything.\n\nAim. Fire. Upgrade. Enjoy.\n\nYou will always be safe... but your precision and tactics are real.", "short_description": "The city belongs to the infected... but the rooftops are yours."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.palexen.com/privacy-policy", "develop
111690421_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FDSTXD9SkgoQ7kNvwEQCL6K&_nc_oc=AdqeV0NjGf7-SoUXvExIHgwKiS7UGrp9rNzIXeqoyVqYNqTid7ysz1JTw8UcerPdf8c&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHaRWH3wuk7TMzEKb9KpOiAs1POoeG2NGvoquYIyJOVZA&oe=6A95C35E"}, {"file_name": "ss_2.png", "id": "1404481898286994", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/507818746_1404481901620327_6035599619384496812_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2pd6khK8tsYQ7kNvwFLRGzw&_nc_oc=AdoIOM3_hXqkgl8m7eSmXUH0pEubQegTXKOC7CEwYgTOT0324i8Yg1ln_V0X1NW1aSs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH6LwtUETrawmwclMdQlHGPziazgzC034YCYhS5iS5cEg&oe=6A95CDF9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Store_hero_2560.png", "id": "28531409386459912", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499620921_28531409393126578_4773895868748841143_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cmazB7odF10Q7kNvwFTqvxL&_nc_oc=AdqSsjbmJ00VNFc3HWpMkfRAEc5ZXICVRLpO6heYOu-jIt0DmcTsadxcuoF8jmZmV2I&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFpsQfCexcurxHfnibGVAIVAIBtCefkZmd-5ZNvx6qktA&oe=6A95C842"}, "display_name": "Zombie Sniper 2", "keywords": ["Zombie", "Sniper", "Shooter", "Arcade", "Apocalipse"], "long_description": "Play as Raven 6, an elite sniper protecting the city from a secure vantage point. Take your time, line up the perfect shot, eliminate the infected, and earn rewards to unlock powerful rifles and equipment.\n\nComplete missions, improve your arsenal, and enjoy a satisfying arcade sniping experience in a post-apocalyptic world where precision is everything.\n\nAim. Fire. Upgrade. Enjoy.\n\nYou will always be safe... but your precision and tactics are real.", "short_description": "The city belongs to the infected... but the rooftops are yours."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.palexen.com/privacy-policy", "develop
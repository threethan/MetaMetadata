111690421_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nlljtts_LGIQ7kNvwEjw4n6&_nc_oc=Adp7YweROwqZsh2ZuNZCIGuDjG-Q83mppsX6ind5JFSkIB3-XY6JL1FAP3Q8e6x_iDE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSuuvkvjHgiH5zCvMdr5WLevxXmkaQES-DQzpnnOzCtdA&oe=6AF1D41E"}, {"file_name": "ss_2.png", "id": "1404481898286994", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/507818746_1404481901620327_6035599619384496812_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lHtknON6S1kQ7kNvwFm_XpM&_nc_oc=Adqgnu-MHkZI8vFAISMELVl23nv9IaKR1OvbL7mjU4afYHSu1-pVntl0TMCozE_NzG8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRJR5Hd8ZSlYyINJmrFMldrwB85S_TnT2vJCVt8XIdRqw&oe=6AF1DEB9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Store_hero_2560.png", "id": "28531409386459912", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499620921_28531409393126578_4773895868748841143_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E1bLk3oJSv4Q7kNvwGrPcbZ&_nc_oc=AdqaDcbgyWPuLkzK0-TDXkBgQE4ze28I0XxunWen3wfAd3lDJZWCh7aZUZSw4ORuLEA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTSs7NNsGvnl-erPrM9yA4UvoRVThuilJS3VJlD85Vqww&oe=6AF1D902"}, "display_name": "Zombie Sniper 2", "keywords": ["Zombie", "Sniper", "Shooter", "Arcade", "Apocalipse"], "long_description": "Play as Raven 6, an elite sniper protecting the city from a secure vantage point. Take your time, line up the perfect shot, eliminate the infected, and earn rewards to unlock powerful rifles and equipment.\n\nComplete missions, improve your arsenal, and enjoy a satisfying arcade sniping experience in a post-apocalyptic world where precision is everything.\n\nAim. Fire. Upgrade. Enjoy.\n\nYou will always be safe... but your precision and tactics are real.", "short_description": "The city belongs to the infected... but the rooftops are yours."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.palexen.com/privacy-policy", "develop
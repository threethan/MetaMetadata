111690421_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A7I-8oVQprAQ7kNvwFAWYSZ&_nc_oc=AdoSBa3WxchHjoh2WL668Ka8bUOPItipSJGHK8TW4-7MI0HTAHzLu6-tWJgbryOmMuA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLBgP1HYDaXYjZtgkfIlI_LiddNODnMFq8o-mPNgBd-GA&oe=6A9EC59E"}, {"file_name": "ss_2.png", "id": "1404481898286994", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/507818746_1404481901620327_6035599619384496812_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4eCmxD0uqt4Q7kNvwHgUlMb&_nc_oc=AdoBYHmIwl8CdcTgv_qIQNERUO3alIDvffYtrcgdgNFxKEYlyxuq-kxv1ZtDdliQtXI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJpd98dD15JSTZtsxZ05QybyxkrBaYvaqEsptCxdgWg3Q&oe=6A9ED039"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Store_hero_2560.png", "id": "28531409386459912", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499620921_28531409393126578_4773895868748841143_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zMTm-gLb4N8Q7kNvwFNcTOh&_nc_oc=AdrkbofyluLwDggk5OBF1UO_1Bqzk4QPbvuC2B2_qtE13Erdox33LMGs_wa5b8WPIQA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLDAwSlLYtCmm_BJIWVzymhTvjNcDko1fUb9x7S_YMiBA&oe=6A9ECA82"}, "display_name": "Zombie Sniper 2", "keywords": ["Zombie", "Sniper", "Shooter", "Arcade", "Apocalipse"], "long_description": "Play as Raven 6, an elite sniper protecting the city from a secure vantage point. Take your time, line up the perfect shot, eliminate the infected, and earn rewards to unlock powerful rifles and equipment.\n\nComplete missions, improve your arsenal, and enjoy a satisfying arcade sniping experience in a post-apocalyptic world where precision is everything.\n\nAim. Fire. Upgrade. Enjoy.\n\nYou will always be safe... but your precision and tactics are real.", "short_description": "The city belongs to the infected... but the rooftops are yours."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.palexen.com/privacy-policy", "develop
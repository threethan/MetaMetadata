111690421_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jsju3kz6WP4Q7kNvwFdgExc&_nc_oc=Adqjmtx42iXcim4PRqgI21RbfKp3jJOJBKw4c5MVpQRgr9PR_-1ncJ9TFmPgUlLqoaE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM20hQRTCC7Dje1OvOn8209oXQW7Bocr8-MY6H5GK6OKA&oe=6ACB989E"}, {"file_name": "ss_2.png", "id": "1404481898286994", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/507818746_1404481901620327_6035599619384496812_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U7L6o2E-xVoQ7kNvwHmaxvz&_nc_oc=AdrKXn253zex0UgopbSXO5f5pzVSC_RPr1zHAJN7W2zpSaSLVACTGoSkkg3KWUl08sA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPvZtsWWuQdAiUS7WQZF_QOdMcT_j0U_A3UmWVdfHMg3w&oe=6ACBA339"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Store_hero_2560.png", "id": "28531409386459912", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499620921_28531409393126578_4773895868748841143_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jOLy0nXh0x8Q7kNvwGDsDLC&_nc_oc=Adpv3SPNhQ3jyqAd_C5YQV0q71v5yTyo5arJ8MWBX8vjJzjPqK9PVeyd3hG8snKtSzY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPK_KOaAN5cPJy_e2GXWi0Y6mYyhLIXmJ_w8Q3YeGF7dg&oe=6ACB9D82"}, "display_name": "Zombie Sniper 2", "keywords": ["Zombie", "Sniper", "Shooter", "Arcade", "Apocalipse"], "long_description": "Play as Raven 6, an elite sniper protecting the city from a secure vantage point. Take your time, line up the perfect shot, eliminate the infected, and earn rewards to unlock powerful rifles and equipment.\n\nComplete missions, improve your arsenal, and enjoy a satisfying arcade sniping experience in a post-apocalyptic world where precision is everything.\n\nAim. Fire. Upgrade. Enjoy.\n\nYou will always be safe... but your precision and tactics are real.", "short_description": "The city belongs to the infected... but the rooftops are yours."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.palexen.com/privacy-policy", "develop
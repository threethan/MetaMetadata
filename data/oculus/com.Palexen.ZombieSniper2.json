111690421_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jDTSaW7BxrAQ7kNvwHfUQor&_nc_oc=AdoPhs3HslijBs_GCRNWAIg8WUcdW1u_Rth3UqHcxRVcrWu8CLOIr57wH-4gofb69Dk&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHNUw7AOiyg93zbAVQ8Iob8gqpbG0mfmO9rsCaRWWvNDg&oe=6A900CDE"}, {"file_name": "ss_2.png", "id": "1404481898286994", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/507818746_1404481901620327_6035599619384496812_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_KO3368Tae0Q7kNvwEWgMP5&_nc_oc=Adqwkzwvz_p4gedj1J4moCzh7cqL9uV-Ut-BDexUwcXqqW4TH3Oakm6llX3i5Ud5kek&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHtZ4NqDWwLPWFPGdl4wwZW8gG7Cl8_xVW5Wh6v-Pc2UQ&oe=6A901779"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Store_hero_2560.png", "id": "28531409386459912", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/499620921_28531409393126578_4773895868748841143_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aJID7Oj1ZrYQ7kNvwFyHOKY&_nc_oc=AdqDTzoL6Avn17Vlto9ap8dtJASHX5G5DGHy0Xt6nrpMf00M1vkp5juj63IyTtbnYGI&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH43SuGMVQCNN-BcADWIWAg7RsdkwiNxs0n4cU-Iw3X1g&oe=6A9011C2"}, "display_name": "Zombie Sniper 2", "keywords": ["Zombie", "Sniper", "Shooter", "Arcade", "Apocalipse"], "long_description": "Play as Raven 6, an elite sniper protecting the city from a secure vantage point. Take your time, line up the perfect shot, eliminate the infected, and earn rewards to unlock powerful rifles and equipment.\n\nComplete missions, improve your arsenal, and enjoy a satisfying arcade sniping experience in a post-apocalyptic world where precision is everything.\n\nAim. Fire. Upgrade. Enjoy.\n\nYou will always be safe... but your precision and tactics are real.", "short_description": "The city belongs to the infected... but the rooftops are yours."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.palexen.com/privacy-policy", "develop
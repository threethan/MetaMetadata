111690421_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nlljtts_LGIQ7kNvwHbjUv2&_nc_oc=Adpjyp3TX2u-K_yHDyFtYfEntxUTnQCO5xKuaiTmm46SEavvjJOyqUg8sNGMpvolz2c&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR05Ml7X5Nzd4Z4mg8p0YRtPiHE9KqO7eA5xvatPUcvqg&oe=6AF3259E"}, {"file_name": "ss_2.png", "id": "1404481898286994", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/507818746_1404481901620327_6035599619384496812_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I-FmrG43CswQ7kNvwHQeJGd&_nc_oc=AdqbWdlhtMJMU6kB2AotCaJMRm36388FSeULKSmmJBUC3GrwB3ZcKUiTg1RYTFkHEqc&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRr310k7KMsZpC9tuItFStAchpQQq1jEMBgH7pcGlrWVw&oe=6AF33039"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Store_hero_2560.png", "id": "28531409386459912", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499620921_28531409393126578_4773895868748841143_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0hX1WU5_exYQ7kNvwHQrGvR&_nc_oc=AdoKSpLIQF53FovOyRFPwE-7WnkoedSj-0I0Gr5HcNimA-19BnSSEHGCaX3_Hj7CCxQ&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRt7b6wzgYdKLhpBF_Fi1hbLLUaJKsS76JD5GDY2Pz4JA&oe=6AF32A82"}, "display_name": "Zombie Sniper 2", "keywords": ["Zombie", "Sniper", "Shooter", "Arcade", "Apocalipse"], "long_description": "Play as Raven 6, an elite sniper protecting the city from a secure vantage point. Take your time, line up the perfect shot, eliminate the infected, and earn rewards to unlock powerful rifles and equipment.\n\nComplete missions, improve your arsenal, and enjoy a satisfying arcade sniping experience in a post-apocalyptic world where precision is everything.\n\nAim. Fire. Upgrade. Enjoy.\n\nYou will always be safe... but your precision and tactics are real.", "short_description": "The city belongs to the infected... but the rooftops are yours."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.palexen.com/privacy-policy", "develop
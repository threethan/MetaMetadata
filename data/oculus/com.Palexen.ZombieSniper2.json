111690421_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xYjdyYlB6LsQ7kNvwHxykNf&_nc_oc=Ado22kqe5oStOt1wBunXfVdefzpuXp7nCa287aowpxSYHuZrz0mHUWIAIVXvTbsggUs&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKBiQWlyMhUD0ItlW6R1CtmCq_ej4WpdoNeaku-TaDp4A&oe=6AB28C1E"}, {"file_name": "ss_2.png", "id": "1404481898286994", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/507818746_1404481901620327_6035599619384496812_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wAzRnzYSonUQ7kNvwEX3Xp0&_nc_oc=AdqdK8QTJLvx1Q23cCIb7yuVvA0_Hu_fYQ-w8li_QgTDQ-0n5vtSg6_eIrSDaM2JmEk&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKS9oOU5-vNKdehIh4mDT1ZLINPvzBtILVkKJiT7OgasQ&oe=6AB296B9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Store_hero_2560.png", "id": "28531409386459912", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499620921_28531409393126578_4773895868748841143_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DzkGYw1HfjIQ7kNvwHirTMC&_nc_oc=Adoo7Oy27EAgSN6ia9aFlIVM_fYxG3kzGp5_zyss6DsPJEAOjEy9sjSj1WFau4OEhW0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIbwF3yM8H1e30CdctIHfyI4Yv0Kry6bumGr6euXPizkA&oe=6AB29102"}, "display_name": "Zombie Sniper 2", "keywords": ["Zombie", "Sniper", "Shooter", "Arcade", "Apocalipse"], "long_description": "Play as Raven 6, an elite sniper protecting the city from a secure vantage point. Take your time, line up the perfect shot, eliminate the infected, and earn rewards to unlock powerful rifles and equipment.\n\nComplete missions, improve your arsenal, and enjoy a satisfying arcade sniping experience in a post-apocalyptic world where precision is everything.\n\nAim. Fire. Upgrade. Enjoy.\n\nYou will always be safe... but your precision and tactics are real.", "short_description": "The city belongs to the infected... but the rooftops are yours."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.palexen.com/privacy-policy", "develop
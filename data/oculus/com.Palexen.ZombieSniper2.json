111690421_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=X_ryEFKcLTwQ7kNvwHnfqwb&_nc_oc=AdqhZwaD5XtwdEID498euOew1oiKJdA9WbNyUHEKRvr85a07iBhZZS1DVMYy7gR4YuQ&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLY1ofoInG2WKNWrts901BX0T73SqJrDx7Ut-y2_dx00A&oe=6ABE699E"}, {"file_name": "ss_2.png", "id": "1404481898286994", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/507818746_1404481901620327_6035599619384496812_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8WxQlmSAbA4Q7kNvwFdq9FM&_nc_oc=Adrzziafl9zs3YotpELfveE7a2gBg4-fdNkhM3U8r9bYkPe9Izfu-EV5Y797le6ChaA&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK3oEHNhp6t7RW6NwnuaaPZUnqsSu6N49euJa37DF0ONQ&oe=6ABE7439"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Store_hero_2560.png", "id": "28531409386459912", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499620921_28531409393126578_4773895868748841143_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RJCK3qn17PAQ7kNvwHMjWnA&_nc_oc=AdqWAoTLw5RESZk12UXPmEpkgbxd7IE3VNB4zvDS_iZuREQwiuujlSXuLvfkpJJG8IM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJScu2qn52GTKv2v5vEB1ToLjUStKt4lYpNpLKnzlld8w&oe=6ABE6E82"}, "display_name": "Zombie Sniper 2", "keywords": ["Zombie", "Sniper", "Shooter", "Arcade", "Apocalipse"], "long_description": "Play as Raven 6, an elite sniper protecting the city from a secure vantage point. Take your time, line up the perfect shot, eliminate the infected, and earn rewards to unlock powerful rifles and equipment.\n\nComplete missions, improve your arsenal, and enjoy a satisfying arcade sniping experience in a post-apocalyptic world where precision is everything.\n\nAim. Fire. Upgrade. Enjoy.\n\nYou will always be safe... but your precision and tactics are real.", "short_description": "The city belongs to the infected... but the rooftops are yours."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.palexen.com/privacy-policy", "develop
111690421_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h7VsWodKiEcQ7kNvwHhSrNH&_nc_oc=AdrBo-NLtOOh59bV13FhglmpbMulQ4WBabh4pQkG_BKEOT0pjowIh1KpLqq8oPhnisI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL2wZh0KpQKtk7TTXEpxRz9RLnkPAKa56bRIwpuLrm8ug&oe=6AAFE91E"}, {"file_name": "ss_2.png", "id": "1404481898286994", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/507818746_1404481901620327_6035599619384496812_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wAzRnzYSonUQ7kNvwGR8oEF&_nc_oc=AdqWMh5cO5X2RYdPiQ74GQyoCAs4YGgRGd1793JZlVZok90fn1HToI9bKZbf3K-SrYA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK94makaPtqdVHFuwmGGjz4l2mSUlUgjHSmfro4PZjizg&oe=6AAFF3B9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Store_hero_2560.png", "id": "28531409386459912", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499620921_28531409393126578_4773895868748841143_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DzkGYw1HfjIQ7kNvwFgmJyP&_nc_oc=AdpNcODvSZbHa6WZqz7AKKeEtwkoQ8FKrWHfSChtqtFEhILCABqQsCu8r1-mZitiZCM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJzNAvIKH8TSh78N-CiJGK3sfAR1AUXnRf25evxyfcVtg&oe=6AAFEE02"}, "display_name": "Zombie Sniper 2", "keywords": ["Zombie", "Sniper", "Shooter", "Arcade", "Apocalipse"], "long_description": "Play as Raven 6, an elite sniper protecting the city from a secure vantage point. Take your time, line up the perfect shot, eliminate the infected, and earn rewards to unlock powerful rifles and equipment.\n\nComplete missions, improve your arsenal, and enjoy a satisfying arcade sniping experience in a post-apocalyptic world where precision is everything.\n\nAim. Fire. Upgrade. Enjoy.\n\nYou will always be safe... but your precision and tactics are real.", "short_description": "The city belongs to the infected... but the rooftops are yours."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.palexen.com/privacy-policy", "develop
111690421_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jvpNvnJ6Cp4Q7kNvwHgjOyl&_nc_oc=AdpRKkX3_q3fvWQOjrTfJ5PHtPVH0WZSeiP7krp-qPO9MpDobUTXUjr2HSRsUPoYjeE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSE7zB4JOxFYbO5mKQ-XRLxC03Fe6GFQDcEfpqBqlRuRw&oe=6AEF311E"}, {"file_name": "ss_2.png", "id": "1404481898286994", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/507818746_1404481901620327_6035599619384496812_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lHtknON6S1kQ7kNvwEZZXHv&_nc_oc=AdrABM78XSPwOrr6RZeq_r4gAj0hvhsl2474tBK8pW5dUa6iqr7kq0hY-yEcp6NYvYw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT5LrEgBu1slizzCq6c2dGjOzBg_vC4gc5QdeMUGaBKTw&oe=6AEF3BB9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Store_hero_2560.png", "id": "28531409386459912", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499620921_28531409393126578_4773895868748841143_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E1bLk3oJSv4Q7kNvwFKk-J4&_nc_oc=AdpXgVnycFUzr_lXCRvtz6_no4B3MiXQY0OfxW8LlwLrPc1hk5VdhrGvJm4g6PPc-2A&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR2zkiiSd23n9N2J1G82BxA1yM5HSG7dbXPFLKpEXiiwA&oe=6AEF3602"}, "display_name": "Zombie Sniper 2", "keywords": ["Zombie", "Sniper", "Shooter", "Arcade", "Apocalipse"], "long_description": "Play as Raven 6, an elite sniper protecting the city from a secure vantage point. Take your time, line up the perfect shot, eliminate the infected, and earn rewards to unlock powerful rifles and equipment.\n\nComplete missions, improve your arsenal, and enjoy a satisfying arcade sniping experience in a post-apocalyptic world where precision is everything.\n\nAim. Fire. Upgrade. Enjoy.\n\nYou will always be safe... but your precision and tactics are real.", "short_description": "The city belongs to the infected... but the rooftops are yours."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.palexen.com/privacy-policy", "develop
111690421_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AKlA74S2uBEQ7kNvwEHQOsa&_nc_oc=AdqgA-T9vthwy8HINuTHHuDHf5jYp3_E6mFKfL4gVJfGw3Xrwc3Vp1SRz0FioNPURts&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJuhwucryp_EIjVj8K3sHU0Jz0AMfK97_WHoG8IrxepXQ&oe=6AB7D21E"}, {"file_name": "ss_2.png", "id": "1404481898286994", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/507818746_1404481901620327_6035599619384496812_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=52k4JnxD52oQ7kNvwGsy8J6&_nc_oc=AdqXAXt4NW-scKEEy1ACOYTLkptYIti45LRCeo3U87Tj9HIvGA5ii5U0zvHs5tmLras&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLKhwAoCsAfRy00baJBH17VWKQ5wBO3xN6GcDuKu1R6HA&oe=6AB7DCB9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Store_hero_2560.png", "id": "28531409386459912", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499620921_28531409393126578_4773895868748841143_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MeJdvdSoU_AQ7kNvwGmjftv&_nc_oc=Adp8BxDjh8kQ52Mnt47XlhUTOI6HXbpaR6AGDWsG6Te7iEWPcHbgA4Q9aVKKsaTOgS8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI4ormQ4k53CExHqrJKEMeDR_u-KKziwFByCv59F6BfBA&oe=6AB7D702"}, "display_name": "Zombie Sniper 2", "keywords": ["Zombie", "Sniper", "Shooter", "Arcade", "Apocalipse"], "long_description": "Play as Raven 6, an elite sniper protecting the city from a secure vantage point. Take your time, line up the perfect shot, eliminate the infected, and earn rewards to unlock powerful rifles and equipment.\n\nComplete missions, improve your arsenal, and enjoy a satisfying arcade sniping experience in a post-apocalyptic world where precision is everything.\n\nAim. Fire. Upgrade. Enjoy.\n\nYou will always be safe... but your precision and tactics are real.", "short_description": "The city belongs to the infected... but the rooftops are yours."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.palexen.com/privacy-policy", "develop
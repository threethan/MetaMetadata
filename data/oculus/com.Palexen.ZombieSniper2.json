111690421_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DvqildsHmRMQ7kNvwG4P7tb&_nc_oc=AdpC-4cQNq3lyUoqo23UsQ3ODOspn0zF5ifWzIHJlMVH5T1WS0eWe03mlA7UHbpTgxU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKHwlVemFZI3-JhxjnU-BbftzMFzzGDBsyNTHTWLvHUXg&oe=6AA6AE9E"}, {"file_name": "ss_2.png", "id": "1404481898286994", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/507818746_1404481901620327_6035599619384496812_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6Vfr2ZUWTXAQ7kNvwEdHVVZ&_nc_oc=Adob_VvwjrxL37cx-Hmns6Jcm-4D75-5NG1w4mN7eNDUxbyys1ZpJtq4jpdD9x5yAD8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLW1FlHr26i2ZxhirMA4UAbK6ciM7afOgrk1p139u6Msw&oe=6AA6B939"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Store_hero_2560.png", "id": "28531409386459912", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499620921_28531409393126578_4773895868748841143_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dCIl87KqGboQ7kNvwFo8Nv9&_nc_oc=AdrsQ1iwj-CNBTtRnaLhPMznTGQDPBsQro9f9sgKOOwIVPgxLYcZ1BOacShoRC-J8AU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKOiR2XUayNAUQ3nH5msuu3Cl-st-97WY9S-fMucuwWuw&oe=6AA6B382"}, "display_name": "Zombie Sniper 2", "keywords": ["Zombie", "Sniper", "Shooter", "Arcade", "Apocalipse"], "long_description": "Play as Raven 6, an elite sniper protecting the city from a secure vantage point. Take your time, line up the perfect shot, eliminate the infected, and earn rewards to unlock powerful rifles and equipment.\n\nComplete missions, improve your arsenal, and enjoy a satisfying arcade sniping experience in a post-apocalyptic world where precision is everything.\n\nAim. Fire. Upgrade. Enjoy.\n\nYou will always be safe... but your precision and tactics are real.", "short_description": "The city belongs to the infected... but the rooftops are yours."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.palexen.com/privacy-policy", "develop
111690421_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=X_ryEFKcLTwQ7kNvwGIvhzf&_nc_oc=AdqRpHs-voaPV7XRq4FJBj99oZNn7dd71zRLWm67RBIQyYuP8Zz6YGyGQsWseo924qs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMTLIqlaE2TtNZM1EkH2sdO3QNJ4pnCKXfzhlwAUykVPw&oe=6ABFBB1E"}, {"file_name": "ss_2.png", "id": "1404481898286994", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/507818746_1404481901620327_6035599619384496812_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2utcr1rt7_YQ7kNvwHBfeda&_nc_oc=Adr8u5trQU23w2N-bXF5QcTR5-PuFvEf_ANFNPqAXPgcN2MPiQaRH8wmxrpCWtGfYsQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPoZdNS7BWSUNtDzOBDLjoGzW9AOxVe7kUsY7zaZPlckw&oe=6ABFC5B9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Store_hero_2560.png", "id": "28531409386459912", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499620921_28531409393126578_4773895868748841143_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BSxtO0BuiuoQ7kNvwHgCycm&_nc_oc=AdoPCgbGuDWE6M_Wa8opOyoXeJo-jgKu230wZUoTq3n9n_h_cwuHRW4WWxorYwowLRY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQORqB1b5NKgsEu90LOYlQ5VvhpY3nx1KctUbExmlyiK-A&oe=6ABFC002"}, "display_name": "Zombie Sniper 2", "keywords": ["Zombie", "Sniper", "Shooter", "Arcade", "Apocalipse"], "long_description": "Play as Raven 6, an elite sniper protecting the city from a secure vantage point. Take your time, line up the perfect shot, eliminate the infected, and earn rewards to unlock powerful rifles and equipment.\n\nComplete missions, improve your arsenal, and enjoy a satisfying arcade sniping experience in a post-apocalyptic world where precision is everything.\n\nAim. Fire. Upgrade. Enjoy.\n\nYou will always be safe... but your precision and tactics are real.", "short_description": "The city belongs to the infected... but the rooftops are yours."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.palexen.com/privacy-policy", "develop
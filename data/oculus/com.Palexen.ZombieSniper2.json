111690421_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=su9mG8kGpmMQ7kNvwH-TGgX&_nc_oc=AdqdPSOOhMn__75xmlHICXS-3ICw9d2wPYzaldKAB4ogMdiFyhPqs2q3ZT6_jnu3_os&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNRXrxt1E8vCDP6hkO471VF3m1FnAlnck2M2lXFf3_YCw&oe=6AE3539E"}, {"file_name": "ss_2.png", "id": "1404481898286994", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/507818746_1404481901620327_6035599619384496812_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Rw7ZTW0ak-gQ7kNvwE4_YQv&_nc_oc=AdqSb612ntGLz6RRarh5ymCtzXTUr9tsn4rPCMu7PXnzKklKLJHiUleCtqzLttVlw7k&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOAe6hdY9IkSgccRvqNmFWwG9GbbRwKvZB7na2vIDcABw&oe=6AE35E39"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Store_hero_2560.png", "id": "28531409386459912", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/499620921_28531409393126578_4773895868748841143_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XFMBVXaQzfoQ7kNvwGPyVrm&_nc_oc=AdqWWZc7f49VJ_6vwow9gxSDkBuEDgk5k1Koo0_O1bfpiWeNrlmUd7LVZB3QWAftlcA&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOB5HoWdeQ9rk3aHcQY7J1FKY03uMiEtamp_8ulQDZlxA&oe=6AE35882"}, "display_name": "Zombie Sniper 2", "keywords": ["Zombie", "Sniper", "Shooter", "Arcade", "Apocalipse"], "long_description": "Play as Raven 6, an elite sniper protecting the city from a secure vantage point. Take your time, line up the perfect shot, eliminate the infected, and earn rewards to unlock powerful rifles and equipment.\n\nComplete missions, improve your arsenal, and enjoy a satisfying arcade sniping experience in a post-apocalyptic world where precision is everything.\n\nAim. Fire. Upgrade. Enjoy.\n\nYou will always be safe... but your precision and tactics are real.", "short_description": "The city belongs to the infected... but the rooftops are yours."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.palexen.com/privacy-policy", "develop
111690421_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VUKPNKq3EUcQ7kNvwHL_R_p&_nc_oc=AdoVIzifyAumlycnEv66Ce7KLzxBulb5ZxUPPVvLel6R8xDLzCwd3td5XO_e5I3nMXU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMp2z3on3fpMv8gRttz7r__AKM0btu8rvy1VEeqR5kGrg&oe=6AD2301E"}, {"file_name": "ss_2.png", "id": "1404481898286994", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/507818746_1404481901620327_6035599619384496812_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rcBbSc8Xyf4Q7kNvwG-r0mc&_nc_oc=AdpyZ6cTXdUylE60V67z-Z8QkJbqmSL-Ie2p5hEOkxyVQyQFXSFZUD-zLhDzorEd_5g&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMw-aYBlcB8EWG5GJf4QiAOUN0Od9AIRxvJ1l-_upK9aA&oe=6AD23AB9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Store_hero_2560.png", "id": "28531409386459912", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499620921_28531409393126578_4773895868748841143_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QfU3MxZHetUQ7kNvwEp0Vpz&_nc_oc=Adqm669Ud72FEiG6PGfRCI-tyV5vl5l7tOhVTGC5cAOXhtMiXm1VdRHJZvlANNKffxE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPySaE6C45OeWq6q15cYzKpOa_HhY04v8EsBz50xV0Rdg&oe=6AD23502"}, "display_name": "Zombie Sniper 2", "keywords": ["Zombie", "Sniper", "Shooter", "Arcade", "Apocalipse"], "long_description": "Play as Raven 6, an elite sniper protecting the city from a secure vantage point. Take your time, line up the perfect shot, eliminate the infected, and earn rewards to unlock powerful rifles and equipment.\n\nComplete missions, improve your arsenal, and enjoy a satisfying arcade sniping experience in a post-apocalyptic world where precision is everything.\n\nAim. Fire. Upgrade. Enjoy.\n\nYou will always be safe... but your precision and tactics are real.", "short_description": "The city belongs to the infected... but the rooftops are yours."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.palexen.com/privacy-policy", "develop
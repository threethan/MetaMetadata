111690421_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3YvFydh2NGoQ7kNvwEWd-0O&_nc_oc=AdqAbdQqIxNbSaFKIRoyWBoJjCjsEVnjW6LEcU34CZ2XVknMTXXCJ3LiZBWWOId3diI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRHj8eLBBhk2O3ToICMt_8xPAby7fJcM4oxUd9sPWe0gA&oe=6AE7481E"}, {"file_name": "ss_2.png", "id": "1404481898286994", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/507818746_1404481901620327_6035599619384496812_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=op63kOhhwJ8Q7kNvwFLCncx&_nc_oc=AdqSkNmie4OnMleNjG1PNkpli_XgJijEdQcICCIy-Oh90NYjsxM0G22_BIQYZVdzifQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSRdbWTESGtkPFILByo4pMuaFL__jTb045Daot7vsqxjw&oe=6AE752B9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Store_hero_2560.png", "id": "28531409386459912", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499620921_28531409393126578_4773895868748841143_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DZndTUQ8s-IQ7kNvwFO1nkC&_nc_oc=AdqXcfT5SAQ-DC1Dx4j75PQDUAKGhEXDcHzRLreyytqvhpLSNavjtex2jnDoqfa8Nvo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQQGpP0DQE4aeg3NzDlGTsisSydRAoL27OryN7bJZBslg&oe=6AE74D02"}, "display_name": "Zombie Sniper 2", "keywords": ["Zombie", "Sniper", "Shooter", "Arcade", "Apocalipse"], "long_description": "Play as Raven 6, an elite sniper protecting the city from a secure vantage point. Take your time, line up the perfect shot, eliminate the infected, and earn rewards to unlock powerful rifles and equipment.\n\nComplete missions, improve your arsenal, and enjoy a satisfying arcade sniping experience in a post-apocalyptic world where precision is everything.\n\nAim. Fire. Upgrade. Enjoy.\n\nYou will always be safe... but your precision and tactics are real.", "short_description": "The city belongs to the infected... but the rooftops are yours."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.palexen.com/privacy-policy", "develop
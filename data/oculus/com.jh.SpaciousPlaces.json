}, {"file_name": "RoseCoast-Screenshot.png", "id": "1587738529109270", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/499298329_1587738532442603_7989255664893447972_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4kQ0RsljKyoQ7kNvwE5WyOv&_nc_oc=AdoBd9f6L00bl7BoMD_EzAn59_b4VL0IDpD2UnFpxIh1alTrut6o2BLDVutM-5vtBC0&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af95dLqkntO1w9CZ3VKHKpJQdRO43ulxiP3wIAkqvR7yeA&oe=6A244151"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ReelCoverArt.png", "id": "26331318676464896", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/499310817_26331318679798229_3163663610629890871_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r7UBw2VhJfIQ7kNvwHWCCL2&_nc_oc=AdrnlKCouqwXG5ZvluOnUjxPxVWgFNe0n_u2t-f7ft_yGxCrzui0bDpe8xKe6dkQ0Vk&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-X2S7r29-Qef9xhAzhPvHYODEMkW0h24dxAxURyV7PUw&oe=6A24242C"}, "display_name": "Spacious Places", "keywords": [], "long_description": "Spacious Places offers scenic environments to destress and decompress, surrounded by the beauty and the sounds of nature: \n  - Mountains\n  - Desert\n  - River\n  - Grassland\n  - Forest\n  - Tropics\n  - Jungle\nThe app features an array of virtual instruments that you can play, creating your own virtual sound bath, no musical training required.\n  - Harps\n  - Chimes\n  - Bells\n  - Gong\n  - Congas\n  - Drums\n  - Vibraphone\n  - Xylophones\n  - Handpan\n  - Tank Drum\n  - Kalimba\n  - Balafon\nThe sounds and scenery in these spacious places will transport you to a place of peace, calm and tranquility.", "short_description": "Spacious Places blends music and instruments with beautiful scenery to promote restfulness and improve your wellbeing. Journey through hand-crafted worlds and play along with peaceful songs using a variety of virtual instruments. Relax and take a breath, surrounded by nature's embrace, listen to the healing sounds and escape to spacious places."}]}, "developer_name": null, "developer_privacy_policy_url": "https://spaciousplaces.ai/privacy", "developer_terms_of_service_url": null, "publisher_name": "Spacious Music LLC", "support_website_url": null, "website_url": "https://spaciousplaces.ai/index.html", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}, {"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26198614639824606"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PUBLISHED", "id": "921460543733730"}, {"status": "PENDING", "id": "1145576063987745"}]}, "baseline_offer": {"id": "921460543733730"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1773298800, "status": "PUBLISHED", "id": "921460543733730"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "26233069043045832", "version": "1.0"}, "id": "479300784569493", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "8410008925778451", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "26233069043045832"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "479300784569493"}]}, "change_log": null, "created_date
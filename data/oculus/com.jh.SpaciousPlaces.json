890871_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TNnNIEq47JQQ7kNvwHBbIEU&_nc_oc=AdqnT5Rst-GeSzemN1bqOF68Aw6bylGHisk7gpxLEp4CR0t9Ph-8uuejF2NwX6knc6o&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0MgOOAFgpl13xq4i-OMImPYiYrcpYBGsY5oLCgWR_j6w&oe=69D8FEAC"}, "display_name": "Spacious Places", "keywords": [], "long_description": "Spacious Places offers scenic environments to destress and decompress, surrounded by the beauty and the sounds of nature: \n  - Mountains\n  - Desert\n  - River\n  - Grassland\n  - Forest\n  - Tropics\n  - Jungle\nThe app features an array of virtual instruments that you can play, creating your own virtual sound bath, no musical training required.\n  - Harps\n  - Chimes\n  - Bells\n  - Gong\n  - Congas\n  - Drums\n  - Vibraphone\n  - Xylophones\n  - Handpan\n  - Tank Drum\n  - Kalimba\n  - Balafon\nThe sounds and scenery in these spacious places will transport you to a place of peace, calm and tranquility.", "short_description": "Spacious Places blends music and instruments with beautiful scenery to promote restfulness and improve your wellbeing. Journey through hand-crafted worlds and play along with peaceful songs using a variety of virtual instruments. Relax and take a breath, surrounded by nature's embrace, listen to the healing sounds and escape to spacious places."}]}, "developer_name": null, "developer_privacy_policy_url": "https://spaciousplaces.ai/privacy", "developer_terms_of_service_url": null, "publisher_name": "Spacious Music LLC", "support_website_url": null, "website_url": "https://spaciousplaces.ai/index.html", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}, {"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics
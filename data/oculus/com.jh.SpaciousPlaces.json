9_1994854061455750_7322343909660779343_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TWCfUPlooFwQ7kNvwFA9GTI&_nc_oc=AdohG6SogedvZArTeoeoOzzafIQJw8Vtvl9SfNBBHyMR7YCOrKmqCWHaqy6AYsu08PA&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=8&oh=00_AfwV2Oovie7Pj-Zsdja_0U5giLP8VOmT0SpuTXiqsyWNrw&oe=69C11CEB"}, {"file_name": "Screenshot3.png", "id": "1315968156374620", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/473392023_1315968159707953_355515680031521296_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rj19VbrXcNMQ7kNvwEgAopZ&_nc_oc=AdpkbrSqBTHQolHcsP6eL0dm9XkEFqZmm3FPpVFwwNImpHEISA7cCH-_eN2M2tDen2k&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_AfxAOiu6Hhw1ObNjThjUZUnURWKwaCN-XcFtZ4kMkwSlUw&oe=69C1427C"}, {"file_name": "RoseCoast-Screenshot.png", "id": "1587738529109270", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499298329_1587738532442603_7989255664893447972_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HgX3Ti3dNFoQ7kNvwEyXYl7&_nc_oc=AdpjE-U468YtqxgF6H237IEKc-3aPmY68cRcbQgrjHP9U_T0QVhYCWMWo0FWrgjB4HU&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_Afz_kCQBaj5ub1AFe5aJ3gC_ezN-BgHBe0CsnJfoHpn4gQ&oe=69C12891"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ReelCoverArt.png", "id": "26331318676464896", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499310817_26331318679798229_3163663610629890871_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SfO1bf3TnL0Q7kNvwEcaSoG&_nc_oc=Ado1IIGwEf_rn69dpd81L4U_b-ACRW_-pXiSgpAX1Wj2IEBkX1xMrGO8M7RJhAZsMEQ&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_Afx9evZs1HK-FDBRPD1aNp3yFyFqDQnqrdAqyoAlBpX89g&oe=69C143AC"}, "display_name": "Spacious Places", "keywords": [], "long_description": "Spacious Places offers scenic environments to destress and decompress, surrounded by the beauty and the sounds of nature: \n  - Mountains\n  - Desert\n  - River\n  - Grassland\n  - Forest\n  - Tropics\n  - Jungle\nThe app features an array of virtual instruments that you can play, creating your own virtual sound bath, no musical training required.\n  - Harps\n  - Chimes\n  - Bells\n  - Gong\n  - Congas\n  - Drums\n  - Vibraphone\n  - Xylophones\n  - Handpan\n  - Tank Drum\n  - Kalimba\n  - Balafon\nThe sounds and scenery in these spacious places will transport you to a place of peace, calm and tranquility.", "short_description": "Spacious Places blends music and instruments with beautiful scenery to promote restfulness and improve your wellbeing. Journey through hand-crafted worlds and play along with peaceful songs using a variety of virtual instruments. Relax and take a breath, surrounded by nature's embrace, listen to the healing sounds and escape to spacious places."}]}, "developer_name": null, "developer_privacy_policy_url": "https://spaciousplaces.ai/privacy", "developer_terms_of_service_url": null, "publisher_name": "Spacious Music LLC", "support_website_url": null, "website_url": "https://spaciousplaces.ai/index.html", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}, {"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26232720219747381"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499618499_2146824249418118_4186979515168300601_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K1dRdG_TX1cQ7kNvwGzPNbt&_nc_oc=Adq0WByrQOtHGDxXB
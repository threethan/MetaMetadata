374620", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473392023_1315968159707953_355515680031521296_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wsvYfZo0MBcQ7kNvwGGx0q2&_nc_oc=AdrF2kFHqwBZrh-qVXLrENk3ZeXTWXECrbqnZRqIcsADQF1GzCZQKNjmWgqWpLy7Mtg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPwNDnAJq38WuOzE3fXs4P2ohqhUrsYg49e9P5LRLyFBQ&oe=6AD228FC"}, {"file_name": "RoseCoast-Screenshot.png", "id": "1587738529109270", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499298329_1587738532442603_7989255664893447972_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ueElKRlqV_UQ7kNvwGZNzxh&_nc_oc=AdrktkLlQCSN6JkNKeUJrpiz3YjTCWdPX6AuMzlmfRqPsTXlHJ9cV4Pm2iZcTUF9dtQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPqTNb1lY4_1Bj9nok6JPpEPM_ME_010kWzzS6z5S0k5Q&oe=6AD24751"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "SpaciousPlaces-CoverArt-Congas-Meta3.png", "id": "839592955824037", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499619145_839592959157370_5756886823699561789_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J6B3G6P1U6IQ7kNvwFQYijj&_nc_oc=Adqgv4fwtSPpdsltCJjrVlk-085eyMXm-5fR9u0pNVywLQE5Wl09A2PoVx6iNgaO3UM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPoM44M5FRvaInvjmP_fJ401wodVN5wI06wZr60iMY5Qg&oe=6AD23222"}, "display_name": "Spacious Places", "keywords": ["Wellness", "Meditation", "Music", "Nature", "Instrument"], "long_description": "**Spacious Places** blends musical instruments with beautiful scenery to promote wellbeing and relaxation. Play along to peaceful songs using a variety of virtual instruments and experience the tranquility of natural environments.  NOTE: THIS IS NOT A MUSIC RHYTHM GAME\n##\n# MANY SPACIOUS ENVIRONMENTS\nExperience 18 different environments, surrounded by the beauty and sounds of nature, from Mountains to Desert, Grassland to Forest, the Tropics and Jungle\n{1442861417331773} \n##\n# A WIDE VARIETY OF INSTRUMENTS\nPlay 15 instruments with your hands or mallets including Harps, Chimes, Bells, Gong, Congas, Vibraphone, Xylophone, Handpan, Tank Drum, Kalimba, Balafon, and more.  \nCreate your own virtual sound bath, no musical ability required!\n{967611555747442}\n##\n# CREATIVE INTERACTIONS\nCreatively launch fireworks, bubbles, snowflakes, lanterns or just follow along with the breathing bubble\n{1476868454099037}\n##\n# DISCOVER PEACEFUL PLACES\nThe sounds and scenery in Spacious Places will transport you to a place of peace, rest, and calm\n{979474731189469}", "short_description": "Spacious Places blends musical instruments with beautiful scenery to promote wellbeing and relaxation. Play along to peaceful songs using a variety of virtual instruments and experience the tranquility of lovely natural environments. Relax and take a breath, listen to the soundscape and escape to spacious places.\nNOTE: THIS IS NOT A MUSIC RHYTHM GAME"}]}, "developer_name": null, "developer_privacy_policy_url": "https://spaciousplaces.ai/privacy", "developer_terms_of_service_url": null, "publisher_name": "Spacious Music LLC", "support_website_url": null, "website_url": "https://spaciousplaces.ai/index.html", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}, {"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26705140812505317"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad
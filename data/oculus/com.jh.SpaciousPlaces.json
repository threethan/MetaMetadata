374620", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/473392023_1315968159707953_355515680031521296_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Qtrjp5IXZzYQ7kNvwEbVBJT&_nc_oc=AdqlRHXO1R3o3j4uOB0t_nG_tn1UZnP2y4Cf1t7P1LrrKw3IA_8ngpv0T8HIgTF5I8k&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0MYdhAOBysMlD5bZwmO3o5KEtLi92PO3UShvw_KkmAXw&oe=69E62C7C"}, {"file_name": "RoseCoast-Screenshot.png", "id": "1587738529109270", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/499298329_1587738532442603_7989255664893447972_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nqm6gf0nPmAQ7kNvwHbT4-H&_nc_oc=AdqRfw2kSDzlh_W-QTWLVrQ38ugUh9uX9Q2VTYai_rfG7o7eIEgLCAfL1Po6j8xfQy0&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3G0i4OqcFWsGpIUWDD4HgDCPethvpc4Y6US7EdFqMTfQ&oe=69E64AD1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "SpaciousPlaces-CoverArt-Congas-Meta3.png", "id": "839592955824037", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/499619145_839592959157370_5756886823699561789_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=THdFL91H_jEQ7kNvwF4McBd&_nc_oc=AdpBvg0Vvg1Fzxo7laulad28K-pR3yzXmWqDxBRutlEL7HpsjnKp_L-stpj5B6wKlqo&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2X-mtWn_eQvCcEIO27tVXoj-Jt8aaWHX-kxAMXNbNdKw&oe=69E635A2"}, "display_name": "Spacious Places", "keywords": ["Wellness", "Meditation", "Music", "Nature", "Instrument"], "long_description": "**Spacious Places** blends musical instruments with beautiful scenery to promote wellbeing and relaxation. Play along to peaceful songs using a variety of virtual instruments and experience the tranquility of natural environments. \n##\n# MANY SPACIOUS ENVIRONMENTS\nExperience 18 different environments, surrounded by the beauty and sounds of nature, from Mountains to Desert, Grassland to Forest, the Tropics and Jungle\n{1442861417331773} \n##\n# A WIDE VARIETY OF INSTRUMENTS\nPlay 15 instruments with your hands or mallets including Harps, Chimes, Bells, Gong, Congas, Vibraphone, Xylophone, Handpan, Tank Drum, Kalimba, Balafon, and more.  \nCreate your own virtual sound bath, no musical ability required!\n{967611555747442}\n##\n# CREATIVE INTERACTIONS\nCreatively launch fireworks, bubbles, snowflakes, lanterns or just follow along with the breathing bubble\n{1476868454099037}\n##\n# DISCOVER PEACEFUL PLACES\nThe sounds and scenery in Spacious Places will transport you to a place of peace, rest, and calm\n{979474731189469}", "short_description": "Spacious Places blends musical instruments with beautiful scenery to promote wellbeing and relaxation. Play along to peaceful songs using a variety of virtual instruments and experience the tranquility of lovely natural environments. Relax and take a breath, listen to the soundscape and escape to spacious places."}]}, "developer_name": null, "developer_privacy_policy_url": "https://spaciousplaces.ai/privacy", "developer_terms_of_service_url": null, "publisher_name": "Spacious Music LLC", "support_website_url": null, "website_url": "https://spaciousplaces.ai/index.html", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}, {"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26536808932671840"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/499618499_2146824249418118_418697951516830060
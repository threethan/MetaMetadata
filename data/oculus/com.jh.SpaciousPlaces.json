9_1994854061455750_7322343909660779343_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TWCfUPlooFwQ7kNvwHhW6SA&_nc_oc=AdlP5kHmI9FZGU2pi-dIz8hDwagrjTijRSPZce3lQWcVEZzLltMmtpiPL7_7NUf13Ko&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfxaabdJh0ubNGJ7G3VpY2Mmd15gQ_-waOwnppQb35u5VA&oe=69BFCB6B"}, {"file_name": "Screenshot3.png", "id": "1315968156374620", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473392023_1315968159707953_355515680031521296_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rj19VbrXcNMQ7kNvwFVUKMJ&_nc_oc=Adl2Z1tQWfQXuJ7exGi6JC_N7hLSSyUPozL2AqhRhwC7EjoWxXrCAzOyD1AB1JoupM8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfwrrnNwcT2JcvxfKLQNB-NqGLiYMWBjzqx3D46xNQM5HQ&oe=69BFF0FC"}, {"file_name": "RoseCoast-Screenshot.png", "id": "1587738529109270", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499298329_1587738532442603_7989255664893447972_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HgX3Ti3dNFoQ7kNvwHUENmQ&_nc_oc=AdkZUaVhOa-_Bf0FR9eRFaNnG3wQnwNF5l5qpyx590f_K8sdClH06OeuMse3agBmeoo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfwtOjtvJGQSI8DLmnIadOkYMKh0fOOcxrciNqcegxJwrw&oe=69BFD711"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ReelCoverArt.png", "id": "26331318676464896", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499310817_26331318679798229_3163663610629890871_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SfO1bf3TnL0Q7kNvwH8pK5G&_nc_oc=AdneNzK5o9HKMpMabnv_4N9v8qXqkoOC0bGXxQmzB2j8yh0j4h7LKgqnBI9_nBOpHeU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_Afy-Y4nHSDex_H7PVpd5NHJBoXXnI4ORrdAXjZGHFXFfdg&oe=69BFF22C"}, "display_name": "Spacious Places", "keywords": [], "long_description": "Spacious Places offers scenic environments to destress and decompress, surrounded by the beauty and the sounds of nature: \n  - Mountains\n  - Desert\n  - River\n  - Grassland\n  - Forest\n  - Tropics\n  - Jungle\nThe app features an array of virtual instruments that you can play, creating your own virtual sound bath, no musical training required.\n  - Harps\n  - Chimes\n  - Bells\n  - Gong\n  - Congas\n  - Drums\n  - Vibraphone\n  - Xylophones\n  - Handpan\n  - Tank Drum\n  - Kalimba\n  - Balafon\nThe sounds and scenery in these spacious places will transport you to a place of peace, calm and tranquility.", "short_description": "Spacious Places blends music and instruments with beautiful scenery to promote restfulness and improve your wellbeing. Journey through hand-crafted worlds and play along with peaceful songs using a variety of virtual instruments. Relax and take a breath, surrounded by nature's embrace, listen to the healing sounds and escape to spacious places."}]}, "developer_name": null, "developer_privacy_policy_url": "https://spaciousplaces.ai/privacy", "developer_terms_of_service_url": null, "publisher_name": "Spacious Music LLC", "support_website_url": null, "website_url": "https://spaciousplaces.ai/index.html", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}, {"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26232720219747381"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499618499_2146824249418118_4186979515168300601_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K1dRdG_TX1cQ7kNvwFuY1A0&_nc_oc=AdkTV9IVKL49HQmFc
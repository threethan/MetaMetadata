6374620", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473392023_1315968159707953_355515680031521296_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kJ_YGgiqyB4Q7kNvwENh34B&_nc_oc=Adoh8btjdhHd3_SagVXwSc9XQVE4L_gGoi7a4IbpiY-TRo4Eslh_bYZkURQhzz31tfs&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0FFZ7Gu3cazANiC76yvEjkBtIxsLebprzjyJJE7zK6cw&oe=69DE437C"}, {"file_name": "RoseCoast-Screenshot.png", "id": "1587738529109270", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499298329_1587738532442603_7989255664893447972_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nwgX9yWgwHcQ7kNvwG44vuI&_nc_oc=AdqDDi6nNVasUrLKqGs1axmoyVENYGoRV3VR1vGXF-lXs8QjZnGumkPB8Nkd_2za1N4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3g_9GCoqx0VMrdmRv-8Sb98aARjd_xMuGkamITRKCTWA&oe=69DE2991"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "SpaciousPlaces-CoverArt-Congas-Meta3.png", "id": "839592955824037", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499619145_839592959157370_5756886823699561789_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PfoCNb0sJB8Q7kNvwHw4xvy&_nc_oc=Adq1J_mwgB9izDpeyDHOzARFtfwjKnbuYlUFZ4Icq5xvpuY756_kDndRGxs9iA7-Fv8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1_KDw5fyfVXOD_QiEEYODqhK0MzaO0hxbSIybqdg8HoA&oe=69DE4CA2"}, "display_name": "Spacious Places", "keywords": ["Wellness", "Meditation", "Music", "Nature", "Instrument"], "long_description": "Experience spacious environments surrounded by the beauty and sounds of nature, from Mountains to Desert, Grassland, Forest, Tropics, and Jungle.\n\nThe app features an array of virtual instruments that you can play. Create your own virtual sound bath, no musical ability required!\n\nInstruments include Harps, Chimes, Bells, Gong, Congas, Vibraphone, Xylophone, Handpan, Tank Drum, Kalimba, Balafon, and more!\n\nCreatively launch fireworks, bubbles, snowflakes or lanterns or just follow along with the breathing bubble.\n\nThe sounds and scenery in Spacious Places will transport you to a place of peace, rest, and tranquility.", "short_description": "Spacious Places blends musical instruments with beautiful scenery to promote wellbeing and relaxation. Play along to peaceful songs using a variety of virtual instruments and experience the tranquility of lovely natural environments. Relax and take a breath, listen to the soundscape and escape to spacious places."}]}, "developer_name": null, "developer_privacy_policy_url": "https://spaciousplaces.ai/privacy", "developer_terms_of_service_url": null, "publisher_name": "Spacious Music LLC", "support_website_url": null, "website_url": "https://spaciousplaces.ai/index.html", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}, {"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26511270555225678"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499618499_2146824249418118_4186979515168300601_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JyjlLv5h5iUQ7kNvwFrrUlZ&_nc_oc=AdreMjokFYMcuCBoxgo8TJj174IpTd-3-XKs57Bsiu1LxOC70YOPtxlp9d_FcgRN6t8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3TkJ54rcGGqqJPy2qiB5jFnJv4PptryOM5X4_7CM3pHA&oe=69DE413D"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Spacious Places", "
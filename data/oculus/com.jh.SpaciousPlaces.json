 "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499298329_1587738532442603_7989255664893447972_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nqm6gf0nPmAQ7kNvwGmRnDc&_nc_oc=AdqpWEVwKSxY5ia6MLKeffg_kky-VuvPs456Jg69bLVUullV5ilJxKw16_ACUKel5YY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af35SlO1XW0b5s-9wamA431zpLK8W2sag3YzcXkJIQcqCw&oe=69E8B591"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ReelCoverArt.png", "id": "26331318676464896", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499310817_26331318679798229_3163663610629890871_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PgJU8MQXAqIQ7kNvwGCR4zM&_nc_oc=AdrXUQuQBF3nTr0dXhbNEn3gRkY_Mw__WDPTXz2oau2zjtj-06Dcw0SG70iA3DAIsfY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0gEdX7gR2XkAMLW1V5Zh9h28CvkHSVrbQZ10HoR_wapw&oe=69E8D0AC"}, "display_name": "Spacious Places", "keywords": [], "long_description": "Spacious Places offers scenic environments to destress and decompress, surrounded by the beauty and the sounds of nature: \n  - Mountains\n  - Desert\n  - River\n  - Grassland\n  - Forest\n  - Tropics\n  - Jungle\nThe app features an array of virtual instruments that you can play, creating your own virtual sound bath, no musical training required.\n  - Harps\n  - Chimes\n  - Bells\n  - Gong\n  - Congas\n  - Drums\n  - Vibraphone\n  - Xylophones\n  - Handpan\n  - Tank Drum\n  - Kalimba\n  - Balafon\nThe sounds and scenery in these spacious places will transport you to a place of peace, calm and tranquility.", "short_description": "Spacious Places blends music and instruments with beautiful scenery to promote restfulness and improve your wellbeing. Journey through hand-crafted worlds and play along with peaceful songs using a variety of virtual instruments. Relax and take a breath, surrounded by nature's embrace, listen to the healing sounds and escape to spacious places."}]}, "developer_name": null, "developer_privacy_policy_url": "https://spaciousplaces.ai/privacy", "developer_terms_of_service_url": null, "publisher_name": "Spacious Music LLC", "support_website_url": null, "website_url": "https://spaciousplaces.ai/index.html", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}, {"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26198614639824606"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PUBLISHED", "id": "921460543733730"}, {"status": "PENDING", "id": "1145576063987745"}]}, "baseline_offer": {"id": "921460543733730"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1773298800, "status": "PUBLISHED", "id": "921460543733730"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "26233069043045832", "version": "1.0"}, "id": "479300784569493", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "8410008925778451", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "26233069043045832"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "479300784569493"}]}, "change_log": null, "created_date": 1773380829, "id": "26233069043045832", "version": "1.0", "version_code": 3
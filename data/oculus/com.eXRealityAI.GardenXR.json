s://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491820566_866875089305874_4099356378437800870_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FNLk69zCFMEQ7kNvwGQ6ImF&_nc_oc=AdoJHUNOzLUF1LIFdR9mIGS38cMFCvPdpcvdjOj8VTIi0djmM1dy5S95cDXw-1Qy0Sg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQvGNAKUYBJYJ23VcHePXhcVWJ4LvAiC5LMlkDYBLQOrQ&oe=6B007BCB"}, {"file_name": "IMG_8305.png", "id": "1317512820409811", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499622214_1317512823743144_7188077133487629008_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lLDLAu4P7n4Q7kNvwEqZoNt&_nc_oc=AdpG4LBaq8chb4rx8Q0lXuZcvx4KY1bSLML2xStHzqGl04VQHHmJQ_CPV1Qul4eHAVo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRE7OW1NZzkFjxHtL1pzFhhoE4SPVO8jYlKaWyuGxRGkA&oe=6B007BD4"}, {"file_name": "Screen7-ViewPlantHistory_cropped_processed_by_imagy.png", "id": "1420955266438636", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499620429_1420955269771969_7984179857005330493_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iiYeLAFPZFUQ7kNvwErUnOZ&_nc_oc=AdokPagP4nmr7NcaOkYawE32fyzIHgY6qVpdK4plrEHT8u81Y_Rld8gsLQHVCXsYu0Q&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSZWMfz_I6hZWejyRtAM0XnL_d91sgP60oEFY4lWSzjjQ&oe=6B00572F"}, {"file_name": "Screen11-Point and Analyze_cropped_processed_by_imagy.png", "id": "1227224028770661", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499619805_1227224032103994_1715968187885027093_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dA-ipBIcPEAQ7kNvwENkFN5&_nc_oc=AdqgIdz1yTSlqaA2r-9EBi2WioXlWnCqonpj_WB4zBTJw3OUpMk3dnE0X20o549HqAQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTv1T6OmewqKYGzbYOi-5JbDIrTd65gsBZcq_B5f7Zmxg&oe=6B006236"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "GardenXR", "keywords": ["Gardening", "AI", "Assistant", "Nature", "Simulator"], "long_description": "## How It Works\n\nPoint your controller at any plant and scan. GardenXR identifies the species and analyzes health using Large Language Model (LLM), delivering care recommendations in seconds.\n\n## Key Features\n\n### Plant Identification\nInstantly identify species with scientific and common names powered by Plant.id.\n\n### Health Analysis\nGet a health score (0-100) with detailed assessment. The AI detects disease, nutrient deficiency, overwatering, and other issues.\n\n### Care Recommendations\nReceive actionable tips tailored to your plant's condition, including watering, light, and treatment guidance.\n\n### Voice Input\nAdd context using voice. Describe what you notice, and the AI incorporates your observations.\n\n### Plant Journal\nTrack all your plants. Review history and monitor health trends over time.\n\n## Perfect For\n\n- Home gardeners improving plant care\n- Plant parents learning to spot issues early\n- Anyone wanting healthier plants\n\n---\n\n*Requires internet connection.*\n", "short_description": "Your AI plant care assistant in VR. Point, scan, and get instant plant identification, health analysis, and custom care tips from your smart AI assistant. Voice input supported.                             "}]}, "developer_name": null, "developer_privacy_policy_url": "https://exreality.ai/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "eXReality AI LLC", "support_website_url": null, "website_url": "https://exreality.ai/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "1043107547362485"}, {"id": "1063584910766706"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb
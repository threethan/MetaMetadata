s://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491820566_866875089305874_4099356378437800870_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_cKQYd1VH9UQ7kNvwF4QP1O&_nc_oc=AdounBT0o-pM6sJony8-g28kcK0MMd5bLZmmAhnte3J3H7CVbFgwJk1cGD7v51aQBNY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRlDcaa-_jhh1aqOV3TotUv7Foyenlm4zFYUxwuHKnA9A&oe=6B0DAACB"}, {"file_name": "IMG_8305.png", "id": "1317512820409811", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499622214_1317512823743144_7188077133487629008_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k5nYTGlBWr8Q7kNvwGKUdM3&_nc_oc=AdrrwXzqX9k6WxfnuSEPhT5XEBiQ0XVAshh-9QVmsuaKam8vF4Wju5t1-gaOwolqdGM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSWigujbQ13SwSlmA4RICxwK1WPSmdAx5jC4bf-gKEnYg&oe=6B0DAAD4"}, {"file_name": "Screen7-ViewPlantHistory_cropped_processed_by_imagy.png", "id": "1420955266438636", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499620429_1420955269771969_7984179857005330493_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ubgFuNvZKtQQ7kNvwEs8gpZ&_nc_oc=AdqVyy76AIiUIMyyRW6dXHWsyWgGYo1kGntIDK3LShNtjEmp7NHCZJGRqdBEJ9p-_8Y&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSJmbQzJP_CwE2DKsLrmzRMakQJzPClGFUgbO7488-iKg&oe=6B0DBE6F"}, {"file_name": "Screen11-Point and Analyze_cropped_processed_by_imagy.png", "id": "1227224028770661", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499619805_1227224032103994_1715968187885027093_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mhCAGJ_4AX0Q7kNvwHUq2nC&_nc_oc=AdoD3pSqQay3ojg3rdF84jFQI6kQ_Zv1_u-klUYiuy-xekusvDpxMafqt_UnA_JGKb0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTrSqieJXcNCPlg13dnlrWVJZejsLq5DrsBdpiq9tGcSA&oe=6B0DC976"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "GardenXR", "keywords": ["Gardening", "AI", "Assistant", "Nature", "Simulator"], "long_description": "## How It Works\n\nPoint your controller at any plant and scan. GardenXR identifies the species and analyzes health using Large Language Model (LLM), delivering care recommendations in seconds.\n\n## Key Features\n\n### Plant Identification\nInstantly identify species with scientific and common names powered by Plant.id.\n\n### Health Analysis\nGet a health score (0-100) with detailed assessment. The AI detects disease, nutrient deficiency, overwatering, and other issues.\n\n### Care Recommendations\nReceive actionable tips tailored to your plant's condition, including watering, light, and treatment guidance.\n\n### Voice Input\nAdd context using voice. Describe what you notice, and the AI incorporates your observations.\n\n### Plant Journal\nTrack all your plants. Review history and monitor health trends over time.\n\n## Perfect For\n\n- Home gardeners improving plant care\n- Plant parents learning to spot issues early\n- Anyone wanting healthier plants\n\n---\n\n*Requires internet connection.*\n", "short_description": "Your AI plant care assistant in VR. Point, scan, and get instant plant identification, health analysis, and custom care tips from your smart AI assistant. Voice input supported.                             "}]}, "developer_name": null, "developer_privacy_policy_url": "https://exreality.ai/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "eXReality AI LLC", "support_website_url": null, "website_url": "https://exreality.ai/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "1043107547362485"}, {"id": "1063584910766706"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb
yOk95px-c3qZH7lI_aUO5G8RWtD1kNHmfKVU7C5ZN3vresIGD_Mxo3Q7v2Q&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOqOy4btbGjvzWyV4XGBqzTT6I5gjtGlANHCQJbm61J8g&oe=6ACFB44B"}, {"file_name": "IMG_8305.png", "id": "1317512820409811", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499622214_1317512823743144_7188077133487629008_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CVRHU0Wu_1MQ7kNvwGSANe5&_nc_oc=Adrx0f-ERKsPASlu0oEyhrssAHipq1DHtB7GDUN0k5mnYXlxDVmnqHTCNfv_JcDfg-k&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNPdGioQyqqb4NR8fzT7ZfUvJGCu18HOXqIZKejvAWLSA&oe=6ACFB454"}, {"file_name": "Screen7-ViewPlantHistory_cropped_processed_by_imagy.png", "id": "1420955266438636", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499620429_1420955269771969_7984179857005330493_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T7JQC60YL0kQ7kNvwF57XMQ&_nc_oc=Adrz3C1wvC4rGDCacmc6wc4fH82rQK2u8WWKjb9X3SEJAVsCXXamiEkf9hGr64ttJBw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM0elpeXDXg_MQV9FtNessoBK7ROgR07kK5VqR6OCchtA&oe=6ACF8FAF"}, {"file_name": "Screen11-Point and Analyze_cropped_processed_by_imagy.png", "id": "1227224028770661", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499619805_1227224032103994_1715968187885027093_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U3_7QlQzRZAQ7kNvwHWgNw8&_nc_oc=AdoQ8Xx83kkFOdzfqhInUQ9KJAjtWzAgnN-_3Jk9cpLw72e8Tmu5H_3XfbOcMbmCq9U&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO8YReq2Vf9q0H2QUrhFhbbFbIzmEVBnfO0Pvp7z7WIOw&oe=6ACF9AB6"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "GardenXR", "keywords": ["Gardening", "AI", "Assistant", "Nature", "Simulator"], "long_description": "## How It Works\n\nPoint your controller at any plant and scan. GardenXR identifies the species and analyzes health using Large Language Model (LLM), delivering care recommendations in seconds.\n\n## Key Features\n\n### Plant Identification\nInstantly identify species with scientific and common names powered by Plant.id.\n\n### Health Analysis\nGet a health score (0-100) with detailed assessment. The AI detects disease, nutrient deficiency, overwatering, and other issues.\n\n### Care Recommendations\nReceive actionable tips tailored to your plant's condition, including watering, light, and treatment guidance.\n\n### Voice Input\nAdd context using voice. Describe what you notice, and the AI incorporates your observations.\n\n### Plant Journal\nTrack all your plants. Review history and monitor health trends over time.\n\n## Perfect For\n\n- Home gardeners improving plant care\n- Plant parents learning to spot issues early\n- Anyone wanting healthier plants\n\n---\n\n*Requires internet connection.*\n", "short_description": "Your AI plant care assistant in VR. Point, scan, and get instant plant identification, health analysis, and custom care tips from your smart AI assistant. Voice input supported.                             "}]}, "developer_name": null, "developer_privacy_policy_url": "https://exreality.ai/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "eXReality AI LLC", "support_website_url": null, "website_url": "https://exreality.ai/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "1043107547362485"}, {"id": "1063584910766706"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "en_US"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "2572210846075
s://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/491820566_866875089305874_4099356378437800870_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vuBmvxsknbkQ7kNvwEQszDS&_nc_oc=AdpsW4iYjsokWZCumDWzlRzi9iRfozEXKzX_xXxJvqoj035JauFCx7HGzuRTba9nuLs&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTZ7-gkqqKGOOkFI3sGgecbVMi6evIoNvaWusss057CBA&oe=6AFB35CB"}, {"file_name": "IMG_8305.png", "id": "1317512820409811", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/499622214_1317512823743144_7188077133487629008_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nf5VXJPUvIwQ7kNvwEmn66T&_nc_oc=AdrvSlN-4sIqA4TcOa0CNjgPD6-BEeTLa4C7JYg_1uvE4XvxH-xSeaGR3xoP0HprIjI&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS9BEPL0DTmRw4ZVE51MZoX3085TCQC_wsDNK2B65YJhQ&oe=6AFB35D4"}, {"file_name": "Screen7-ViewPlantHistory_cropped_processed_by_imagy.png", "id": "1420955266438636", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/499620429_1420955269771969_7984179857005330493_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=As2apZ7VtkkQ7kNvwHLQ_sa&_nc_oc=AdpAwhImCxyGwhYn5kQrPitLuH0DKXn-9xJohv4BpyTTcHXuJbxSMirnEE7jc4oQagc&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSaZoRMQEbDfPSKssrDqJlm_muV2Fvx47varPVHCSkYyw&oe=6AFB496F"}, {"file_name": "Screen11-Point and Analyze_cropped_processed_by_imagy.png", "id": "1227224028770661", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499619805_1227224032103994_1715968187885027093_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P-RJWem6EogQ7kNvwErS-Wb&_nc_oc=AdpdXuGoGmNUQYuOckuwxO2a1cmblts4IISORKmpy9-ezMEdTXXQiPtHiFufg_kyYUk&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSWofdgTkbxYRCAZOHQ3X9L1DRkTb7n-o12Ih4VU5uwRw&oe=6AFB1C36"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "GardenXR", "keywords": ["Gardening", "AI", "Assistant", "Nature", "Simulator"], "long_description": "## How It Works\n\nPoint your controller at any plant and scan. GardenXR identifies the species and analyzes health using Large Language Model (LLM), delivering care recommendations in seconds.\n\n## Key Features\n\n### Plant Identification\nInstantly identify species with scientific and common names powered by Plant.id.\n\n### Health Analysis\nGet a health score (0-100) with detailed assessment. The AI detects disease, nutrient deficiency, overwatering, and other issues.\n\n### Care Recommendations\nReceive actionable tips tailored to your plant's condition, including watering, light, and treatment guidance.\n\n### Voice Input\nAdd context using voice. Describe what you notice, and the AI incorporates your observations.\n\n### Plant Journal\nTrack all your plants. Review history and monitor health trends over time.\n\n## Perfect For\n\n- Home gardeners improving plant care\n- Plant parents learning to spot issues early\n- Anyone wanting healthier plants\n\n---\n\n*Requires internet connection.*\n", "short_description": "Your AI plant care assistant in VR. Point, scan, and get instant plant identification, health analysis, and custom care tips from your smart AI assistant. Voice input supported.                             "}]}, "developer_name": null, "developer_privacy_policy_url": "https://exreality.ai/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "eXReality AI LLC", "support_website_url": null, "website_url": "https://exreality.ai/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "1043107547362485"}, {"id": "1063584910766706"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb
s://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/491820566_866875089305874_4099356378437800870_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=smJ2DqiEsAsQ7kNvwHGRAYE&_nc_oc=AdoiP38MsOyLUTNrqNsanN4aumb0ZKOgm1ElJchY7HztZW5Dj0VzP5SfewqhijsGdgs&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSblWDcWbdhe_1GOgrqWryDvQeNiPLwK6YHsFekBPN6QQ&oe=6B0B400B"}, {"file_name": "IMG_8305.png", "id": "1317512820409811", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499622214_1317512823743144_7188077133487629008_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zeV0HDGQxjIQ7kNvwGrX7Mi&_nc_oc=Adpk3ErXOe39pweIc2ug3io4OkdYuhbLdTYEMBolAElf2y6twS-XaQgvzaahVWR2xCM&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSZkt3_gWkSTXNZF_E9hSGjMGeEI-Y9CpF5fGf1O5MZ9w&oe=6B0B4014"}, {"file_name": "Screen7-ViewPlantHistory_cropped_processed_by_imagy.png", "id": "1420955266438636", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499620429_1420955269771969_7984179857005330493_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cTBhIVXh0m8Q7kNvwFfcsfD&_nc_oc=Adr1ILGgkq2700BNJkj0XBNOZcMV64uw9X0bvS8QoPcNlA_cOAh6lHzw58gOkQpVd9w&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSXXgUGxxthTb3-gbxsIStLn8HE1shdoMyPS8lnTxVf0w&oe=6B0B1B6F"}, {"file_name": "Screen11-Point and Analyze_cropped_processed_by_imagy.png", "id": "1227224028770661", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499619805_1227224032103994_1715968187885027093_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mhCAGJ_4AX0Q7kNvwHKZxX4&_nc_oc=Adq7Va9IZ8QGrc68J8Ni5cFtW2g2R5ISEnEs7duYmiwZjJSfwGVcoF-g-zKAN3BVHX8&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSjrRopWWiuDkdEe8bcgg0typIFkYcRalkwDEeDVsChKw&oe=6B0B2676"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "GardenXR", "keywords": ["Gardening", "AI", "Assistant", "Nature", "Simulator"], "long_description": "## How It Works\n\nPoint your controller at any plant and scan. GardenXR identifies the species and analyzes health using Large Language Model (LLM), delivering care recommendations in seconds.\n\n## Key Features\n\n### Plant Identification\nInstantly identify species with scientific and common names powered by Plant.id.\n\n### Health Analysis\nGet a health score (0-100) with detailed assessment. The AI detects disease, nutrient deficiency, overwatering, and other issues.\n\n### Care Recommendations\nReceive actionable tips tailored to your plant's condition, including watering, light, and treatment guidance.\n\n### Voice Input\nAdd context using voice. Describe what you notice, and the AI incorporates your observations.\n\n### Plant Journal\nTrack all your plants. Review history and monitor health trends over time.\n\n## Perfect For\n\n- Home gardeners improving plant care\n- Plant parents learning to spot issues early\n- Anyone wanting healthier plants\n\n---\n\n*Requires internet connection.*\n", "short_description": "Your AI plant care assistant in VR. Point, scan, and get instant plant identification, health analysis, and custom care tips from your smart AI assistant. Voice input supported.                             "}]}, "developer_name": null, "developer_privacy_policy_url": "https://exreality.ai/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "eXReality AI LLC", "support_website_url": null, "website_url": "https://exreality.ai/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "1043107547362485"}, {"id": "1063584910766706"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb
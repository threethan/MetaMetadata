.oculuscdn.com&oh=00_AfsPMGpKIaSZWJLsJ0IkvVQ4li31k3O2-HRfzUZmXSXjPA&oe=699C4E8B"}, {"file_name": "IMG_8305.png", "id": "1317512820409811", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499622214_1317512823743144_7188077133487629008_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DhZOZnIB3d0Q7kNvwH30BIq&_nc_oc=AdlZRMQ-fqY-Mq7PFzxW9GvNv69LFL1L1kYObNXvR-aKsrH3eqqgkxeNQ1tw9FLPI4c&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_Afue24GqmWiL_8xHDxxL5RgvdW0Ewfh1Ovs0VScwa7MnAA&oe=699C4E94"}, {"file_name": "Screen7-ViewPlantHistory_cropped_processed_by_imagy.png", "id": "1420955266438636", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499620429_1420955269771969_7984179857005330493_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YpYmeC7_ROgQ7kNvwGvhbPR&_nc_oc=AdkQRbxYEaAqbeIhhR0xvmTjWWT2iKxlq1nrNjg01rzljb982zibBKg9ZH-A3jG2FQw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_AfuSNyRXhIRlbxVJ2v3VGiyv9QmjmXvVkBA7H1CWyDgfGQ&oe=699C622F"}, {"file_name": "Screen11-Point and Analyze_cropped_processed_by_imagy.png", "id": "1227224028770661", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499619805_1227224032103994_1715968187885027093_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9YSGiF03hVEQ7kNvwHtsr-S&_nc_oc=Adn-imUbEswXyEu0emoxWDflcVBG6Gej8E0odkzgQ-XqZMUk5vo287Pe2feoBWNSV0g&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_AfsYaEsdVPsdo76lRtWfeJ2Kv8vKq40n15ubomgR1eYa0Q&oe=699C34F6"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "GardenXR", "keywords": ["Gardening", "AI", "Assistant", "Nature", "Simulator"], "long_description": "## How It Works\n\nPoint your controller at any plant and scan. GardenXR identifies the species and analyzes health using Large Language Model (LLM), delivering care recommendations in seconds.\n\n## Key Features\n\n### Plant Identification\nInstantly identify species with scientific and common names powered by Plant.id.\n\n### Health Analysis\nGet a health score (0-100) with detailed assessment. The AI detects disease, nutrient deficiency, overwatering, and other issues.\n\n### Care Recommendations\nReceive actionable tips tailored to your plant's condition, including watering, light, and treatment guidance.\n\n### Voice Input\nAdd context using voice. Describe what you notice, and the AI incorporates your observations.\n\n### Plant Journal\nTrack all your plants. Review history and monitor health trends over time.\n\n## Perfect For\n\n- Home gardeners improving plant care\n- Plant parents learning to spot issues early\n- Anyone wanting healthier plants\n\n---\n\n*Requires internet connection.*\n", "short_description": "Your AI plant care assistant in VR. Point, scan, and get instant plant identification, health analysis, and custom care tips from your smart AI assistant. Voice input supported.                             "}]}, "developer_name": null, "developer_privacy_policy_url": "https://exreality.ai/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "eXReality AI LLC", "support_website_url": null, "website_url": "https://exreality.ai/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "1043107547362485"}, {"id": "1063584910766706"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "en_US"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25722108460752982"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "767870042373830"}]}, "baseline_offer": {"id": "76787004237
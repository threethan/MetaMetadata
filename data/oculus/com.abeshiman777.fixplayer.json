content-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQHAX2U_tellOiTrZ0ndfi5gIqnKQfc2JFMDKp5ydK1-Q&oe=6AFB4B24"}, {"file_name": "1_room_alpha.png", "id": "2351773418978334", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/499623876_2351773422311667_2928819381033876156_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qGa3UtwMrPwQ7kNvwHguaDs&_nc_oc=AdrySLRZ-RvYjr0CFO4X2TaUyJe9fWE7zMMCHXh7MW_b-WOpxsVmtqPSyUCf408FDQY&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQLv6jbPyAH-AyD-jUnHNoOt5Y1qCzJsDqODMvWjdNrQw&oe=6AFB39E9"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "PinPlayer", "keywords": ["videoplayer", "passthrough", "mixedreality", "VR180", "loop"], "long_description": "PinPlayer lets you place a video screen anywhere in your real room (passthrough). It stays exactly where you put it: on a wall, on the ceiling, or next to your sofa.\n\n\u25a0 Watch in your space \u30fbGrab the screen to set its position, size and angle \u30fbBackgrounds: passthrough, black, gradient, 360\u00b0 image, or a 3D room (cinema, classroom, hotel room) \u30fbScreen glow and spatial audio from the screen\n\n\u25a0 Seamless loops \u30fb\"Natural Loop\" plays short clips without stopping at the seam \u30fbA-B loop, shuffle and continuous playback\n\n\u25a0 Quick controls \u30fbTrigger + stick: previous/next, skip, speed \u30fbPitch-preserving audio at any speed \u30fbResume, favorites, history, sorting and search\n\n\u25a0 Play from anywhere \u30fbYour Quest (downloads, recordings) \u30fbSend from a phone or PC browser on the same Wi-Fi (no extra app) \u30fbShared folders on a PC (Windows / Mac) or NAS, and DLNA media servers\n\n\u25a0 3D, VR and special videos \u30fb3D side-by-side, VR180 and VR360, detected automatically \u30fbTransparent videos and videos with depth: characters appear to stand in your room in 3D (samples included; formats described on the support page)\n\n\u25a0 More \u30fbSubtitles (.srt / .ass / .vtt), audio tracks, volume boost \u30fbBrightness, contrast, saturation and gamma \u30fbOptional hand tracking \u30fbEnglish, Japanese, Simplified Chinese, Korean\n\n\u25a0 Supported videos \u30fbmp4 / mkv / mov / m4v / webm (H.264 / H.265) \u30fbUp to about 4K 60fps \u30fbProRes, DRM-protected videos and streaming services are not supported\n\nNo account needed. No data collected.", "short_description": "Pin videos anywhere in your room. A video player for Meta Quest whose screen stays put in passthrough. Seamless loops, 3D / VR180 / VR360, and playback from your PC, NAS or phone."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/2dfixplayer", "developer_terms_of_service_url": null, "publisher_name": "Abeshiman777", "support_website_url": "https://sites.google.com/view/pinplayer-video-formats", "website_url": "https://sites.google.com/view/pinplayer-video-formats", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ja", "zh_CN", "ko"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1344772718727193"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1073729235716041"}]}, "baseline_offer": {"id": "1073729235716041"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1794402120, "status": "PUBLISHED", "id": "1073729235716041"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_r
 friends in this free multiplayer VR lab."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/monk-laboratory/home", "developer_terms_of_service_url": null, "publisher_name": "melodicmedia", "support_website_url": null, "website_url": "https://sites.google.com/view/monk-laboratory-information/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "24402013369415737"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499300913_632643622738612_3619374415902539468_n.png?stp=dst-png_s360x360&_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wH5s_Wx89KEQ7kNvwH4X72l&_nc_oc=Adrc3Na0iiq5LUUxLxztPnNdcl_SZDUaXxzQc4oKnT-y8hwbHFcUZpqpk6dA0Gws6ag&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT0FkqZEMErfnQAgXxtbd5MQmDBq4qpU4NVOMhONhGEUg&oe=6B01CC7E"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Monk Laboratory", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Action", "id": "459781504968480"}, {"topic_name": "Adventure", "id": "2691890164460465"}], "release_date": 1754499360, "lastRevision": {"nodes": [{"id": "24378909548392786", "release_type": "SCHEDULED", "administration_status": "A
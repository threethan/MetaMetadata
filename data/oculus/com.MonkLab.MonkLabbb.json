uluscdn.com/v/t64.5771-25/499618252_638366655432559_8892525464698561090_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cKoMexbJ8_AQ7kNvwHvKH3u&_nc_oc=AdpKIORRMXqEhDVMj-U6NV-6aI3kLspiyb3FCLtO0W58udUVgTAsSOWAkZ559EhZt20&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_Af2I3BX8IHbntRJw7epOrE8mgBKlV5JuKo6l9bFbxIhxhA&oe=69F1F37C"}, {"file_name": "SampleScene_Custom..._04.08.2025_11-28-49.png", "id": "1271924594590693", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499308998_1271924597924026_9053799293921254170_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wmServFGddkQ7kNvwE0CDDR&_nc_oc=AdrEG9BEn3uYiKMpfjpFyVNkvZchx5A3NzV8EKyfq6KtY1nT2JWbg8ERTmS-Fj78m5g&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1LeoKANSUHFSQ6Ona_K_XmrC78Pscvzr6RmBUzk2ApXQ&oe=69F1EB6B"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Monk Laboratory", "keywords": ["tag", "gorilla", "monke", "fangame"], "long_description": "Monk Laboratory is a free multiplayer VR game where you play as a monkey exploring using only your arms to move. Climb, swing, and launch yourself through an open playground built for full-body locomotion. With built-in voice chat, you can talk and interact with other players in real time, making every session a fun and social experience. Whether you're racing across obstacles, discovering secret rooms, or just hanging out, Monk Laboratory offers immersive, physics-based gameplay designed to keep you moving. It\u2019s easy to pick up, free to play, and constantly evolving with community feedback and regular updates.\n\n", "short_description": "Climb, swing, and chat with friends in this free multiplayer VR lab."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/monk-laboratory/home", "developer_terms_of_service_url": null, "publisher_name": "melodicmedia", "support_website_url": null, "website_url": "https://sites.google.com/view/monk-laboratory-information/home", "category"
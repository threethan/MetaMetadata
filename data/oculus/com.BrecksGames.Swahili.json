=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=8&oh=00_AfxB_7wSe5SCrCAyeYEn3SR2d-EQMbdQy4f3jzpeQTJ26Q&oe=69BD5D92"}, {"file_name": "Claw Chase_Custom..._05.10.2025_16-35-06.png", "id": "823263083387032", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/491831580_823263086720365_4005256381759946926_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=REpVOypDwGsQ7kNvwHBBnfA&_nc_oc=AdnsoZZQgFj1Kj-IzpEfI9M8z6f2Ea1Ss0wdpdQICnt3u8uhwxTSLP-8KZRFD7pLLRs&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=8&oh=00_AfwBqH96IUJ6LSez0MfyipqKAJ-8EUmIyjvgEOE_CjB_-w&oe=69BD33C5"}, {"file_name": "Claw Chase_Custom..._05.10.2025_16-34-55.png", "id": "798820889407123", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/499620860_798820892740456_2770680517496395064_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3q3FHzoEca4Q7kNvwHX32sh&_nc_oc=AdnuRbJZlEm0OojpTM2ySHOiyQGyvpcL4rNC7CyMB4vzMs5vd8gdpP-2Yu82whYChaU&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=8&oh=00_Afx54MB5bgfR9P7_-HhhidjExiMB2v1SobTpUizQPXCxGA&oe=69BD2EF8"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Swahili", "keywords": [], "long_description": "Step into the wild as a wolf in Swahili, a fast-paced social VR experience where movement is everything. Using Gorilla Tag\u2013style locomotion, you can run, climb, and leap through immersive maps alongside friends and players from around the world.\n\nCustomize your wolf with a wide range of cosmetics from the in-game shop, and celebrate with limited-time items during seasonal events, holidays, and special updates. Explore multiple maps designed for freedom and creativity \u2014 whether you\u2019re racing, roleplaying, or just hanging out, every session is a new adventure.\n\nWith an ever-growing community and frequent updates, Swahili is more than a game \u2014 it\u2019s a place to connect, play, and live out your wolf pack fantasies in VR.", "short_description": "Run, climb, and leap like a wolf in Swahili. A social VR game with Gorilla Tag\u2013style movement, seasonal updates, and endless adventures with friends."}]}, "developer_name": "Brecks", "developer_privacy_policy_url": "https://www.freeprivacypolicy.com/live/8a5438c8-ae6b-497a-be1e-9b5eae549132", "developer_terms_of_service_url": null, "publisher_name": "Brecks ", "support_website_url": null, "website_url": "https://docs.google.com/document/d/1Sqol4uimtMgI_i6F5onTVN8mcTubqVjxbLovCO6z888/edit?usp=sharing", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1023770785722696"}, {"id": "2691890164460465"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER"], "id": "9066852330105138"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/499618288_1316025323328188_4200565997354065253_n.png?stp=dst-png_s360x360&_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ke4dLk_vpAkQ7kNvwEaHAZz&_nc_oc=Adl92oy2Sg92ev6H2a1VU4r_yGEAR6k6Qe-5EtMfzDi_FzjF5MNKrKA2SocaD2k9Bys&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=8&oh=00_AfxiocfXZ_HMMPfUtV8RVF-KP3tuG3owEwr-rUHmfxNbWA&oe=69BD39D1"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Swahili", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Action", "id": "459781504968480"}, {"topic_name": "Hangout", "id": "10237
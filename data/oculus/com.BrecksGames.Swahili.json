ent-iad3-2.oculuscdn.com/v/t64.5771-25/491831778_2846402142417538_1223674436588032298_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F53weDV3_iMQ7kNvwGrwf_e&_nc_oc=AdmNLuRmI18MSwE3eeRXwLSEN6bsabrxd1dgvKBIj-Am93-OaUpf2RQl6v7xQCzNk70&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfstRPNz0KjZpxWxU77lEo0ICh04yt-puqgvcFimnB5F_g&oe=69A2C752"}, {"file_name": "Claw Chase_Custom..._05.10.2025_16-35-06.png", "id": "823263083387032", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491831580_823263086720365_4005256381759946926_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SauzCbc1Jl4Q7kNvwHRhGPJ&_nc_oc=AdnT_BDw6FCsnLH1uC-K8MEALc196rZh3woZl_k8T_RFlDHk-x9C8f5MTUM0BDuzuMg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afsxlxhe658rYzYYMtXfAc6JpJNopdvomsbYwPjiAkpf-w&oe=69A2D5C5"}, {"file_name": "Claw Chase_Custom..._05.10.2025_16-34-55.png", "id": "798820889407123", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499620860_798820892740456_2770680517496395064_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vXYnwqqGaOQQ7kNvwE-aRa6&_nc_oc=AdnDBJnyPDRiKM_FhKLyxDs4LqT2pbuQDF6XXMHnV0ct93ZS5Iy8GCF9H4uOQvS90og&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfuVWXJ565Mif5NrgI8VDtcV0PZJzVF0daXXPuOh76ZoCQ&oe=69A2D0F8"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Swahili", "keywords": [], "long_description": "Step into the wild as a wolf in Swahili, a fast-paced social VR experience where movement is everything. Using Gorilla Tag\u2013style locomotion, you can run, climb, and leap through immersive maps alongside friends and players from around the world.\n\nCustomize your wolf with a wide range of cosmetics from the in-game shop, and celebrate with limited-time items during seasonal events, holidays, and special updates. Explore multiple maps designed for freedom and creativity \u2014 whether you\u2019re racing, roleplaying, or just hanging out, every session is a new adventure.\n\nWith an ever-growing community and frequent updates, Swahili is more than a game \u2014 it\u2019s a place to connect, play, and live out your wolf pack fantasies in VR.", "short_description": "Run, climb, and leap like a wolf in Swahili. A social VR game with Gorilla Tag\u2013style movement, seasonal updates, and endless adventures with friends."}]}, "developer_name": "Brecks", "developer_privacy_policy_url": "https://www.freeprivacypolicy.com/live/8a5438c8-ae6b-497a-be1e-9b5eae549132", "developer_terms_of_service_url": null, "publisher_name": "Brecks ", "support_website_url": null, "website_url": "https://docs.google.com/document/d/1Sqol4uimtMgI_i6F5onTVN8mcTubqVjxbLovCO6z888/edit?usp=sharing", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1023770785722696"}, {"id": "2691890164460465"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER"], "id": "9066852330105138"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1501373854515481"}]}, "baseline_offer": {"id": "1501373854515481"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1759882620, "status": "PUBLISHED", "id": "1501373854515481"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "9203451376445232", "version": "1.7"}, "id": "1088844290130479", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries":
.5771-25/491831778_2846402142417538_1223674436588032298_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RBJ81GT83GEQ7kNvwGsF-Ow&_nc_oc=AdqgWFwny8Kk_b0-6ODrkFtXJ2NB_K6qyaGy-vQxqLXUeY8V9NNosBoBn9JtfPj3B9g&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR0m24NGwTU6_sVAZXn9O3GUb03F7KOLYxoZ6iUl_xN4A&oe=6AFF0B92"}, {"file_name": "Claw Chase_Custom..._05.10.2025_16-35-06.png", "id": "823263083387032", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/491831580_823263086720365_4005256381759946926_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cjXZdCMi3v8Q7kNvwGYq1pO&_nc_oc=Adp9WI8jvIopnjd2DwrFhMhfb2RYlkWdXBUuxMzcP-t8CxzcI9lxpbhmpQ9M_WTTmVQ&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRskDR1_xJGqNtd4khqUjrN55fCIoskkpOeBCIPPLDgsQ&oe=6AFF1A05"}, {"file_name": "Claw Chase_Custom..._05.10.2025_16-34-55.png", "id": "798820889407123", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/499620860_798820892740456_2770680517496395064_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oIkwwgDcUFgQ7kNvwEE2X2V&_nc_oc=AdpjnjkOztHrDSBbL0_PkDpZV-aJS1ev-mESSK4wPi68D4Prmy_Oe2a-LxPEsk92e5k&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQOMmoLR617fSVcmTOBtvtKpdyicLG4XrbtHEqN_xEOXg&oe=6AFF1538"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Swahili", "keywords": [], "long_description": "Step into the wild as a wolf in Swahili, a fast-paced social VR experience where movement is everything. Using Gorilla Tag\u2013style locomotion, you can run, climb, and leap through immersive maps alongside friends and players from around the world.\n\nCustomize your wolf with a wide range of cosmetics from the in-game shop, and celebrate with limited-time items during seasonal events, holidays, and special updates. Explore multiple maps designed for freedom and creativity \u2014 whether you\u2019re racing, roleplaying, or just hanging out, every session is a new adventure.\n\nWith an ever-growing community and frequent updates, Swahili is more than a game \u2014 it\u2019s a place to connect, play, and live out your wolf pack fantasies in VR.", "short_description": "Run, climb, and leap like a wolf in Swahili. A social VR game with Gorilla Tag\u2013style movement, seasonal updates, and endless adventures with friends."}]}, "developer_name": "Brecks", "developer_privacy_policy_url": "https://www.freeprivacypolicy.com/live/8a5438c8-ae6b-497a-be1e-9b5eae549132", "developer_terms_of_service_url": null, "publisher_name": "Brecks ", "support_website_url": null, "website_url": "https://docs.google.com/document/d/1Sqol4uimtMgI_i6F5onTVN8mcTubqVjxbLovCO6z888/edit?usp=sharing", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1023770785722696"}, {"id": "2691890164460465"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER"], "id": "9066852330105138"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499618288_1316025323328188_4200565997354065253_n.png?stp=dst-png_s360x360&_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DTfX7U32pNMQ7kNvwF3UFrc&_nc_oc=Adov-BKS2F3Ld0nfgxxgIywjMPAbWWkKW0XpclFBnYP6pmZWdOURC2jrI3tgq3f2W_M&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQS3pLgv_mM497frt_p_Our2_m5tjB8nFYusEMflj
ss=7f20f&oh=00_AQTaOGDAI3fqIv6RkQhUI0rZCl4fwSkhHa3l2enlnNihZg&oe=6AFB20B8"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Swahili", "keywords": [], "long_description": "Step into the wild as a wolf in Swahili, a fast-paced social VR experience where movement is everything. Using Gorilla Tag\u2013style locomotion, you can run, climb, and leap through immersive maps alongside friends and players from around the world.\n\nCustomize your wolf with a wide range of cosmetics from the in-game shop, and celebrate with limited-time items during seasonal events, holidays, and special updates. Explore multiple maps designed for freedom and creativity \u2014 whether you\u2019re racing, roleplaying, or just hanging out, every session is a new adventure.\n\nWith an ever-growing community and frequent updates, Swahili is more than a game \u2014 it\u2019s a place to connect, play, and live out your wolf pack fantasies in VR.", "short_description": "Run, climb, and leap like a wolf in Swahili. A social VR game with Gorilla Tag\u2013style movement, seasonal updates, and endless adventures with friends."}]}, "developer_name": "Brecks", "developer_privacy_policy_url": "https://www.freeprivacypolicy.com/live/8a5438c8-ae6b-497a-be1e-9b5eae549132", "developer_terms_of_service_url": null, "publisher_name": "Brecks ", "support_website_url": null, "website_url": "https://docs.google.com/document/d/1Sqol4uimtMgI_i6F5onTVN8mcTubqVjxbLovCO6z888/edit?usp=sharing", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1023770785722696"}, {"id": "2691890164460465"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_
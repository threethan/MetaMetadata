tI2yaAsaQ6M580rONFJ1TDSeAXtMiJVHX8AlXOv3K47cpamWUUSg&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIzeYUMZ48xxWaY1IHHD8RfLBDViHdKHx7ps5pF4xRWTg&oe=6AA5518B"}, {"file_name": "com.oculus.metacam-20250708-004254-0.mp4 - VLC media player 7_8_2025 1_37_15 AM.png", "id": "968501408639019", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491830607_968501411972352_9012171935589060547_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ePIZvnwNdOYQ7kNvwHAsrqn&_nc_oc=AdrNcehN6dQtnOettbkEaMRJpQ-0481GyuBJqy3-SkRypICVLAfdfWD0R2Xn_UluSWQ&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJEcM2DBmDUeFHq_3lZ1zhb68yJt7JI8MF1bPISr57Xiw&oe=6AA54BD4"}, {"file_name": "com.oculus.metacam-20250708-004254-0.mp4 - VLC media player 7_9_2025 8_50_18 PM.png", "id": "3625838987720968", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491828816_3625838994387634_228159314360632087_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r9hoGH7o6bAQ7kNvwFtPl2L&_nc_oc=AdqGsvapu_eM33Tb7KgCaeMCwg0Jj1-Z6w-vuQAGakcw013LYk5qv6Yke-3c7bdTYfc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ5I2prgdnlIDnVt8oetnHMBwIkc1xnFq_N3p11D8oV2g&oe=6AA547F1"}, {"file_name": "02.png", "id": "1386363002486828", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499310646_1386363005820161_7554233243955987898_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B2DFB-xqskQQ7kNvwGfcnx5&_nc_oc=Adoy1B5O2xqRblKiSzEG58xL2hYA7Icgk_Gq54cim12YOtVhs-UGDAHxAZ5Xye0ka-s&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK34p3LlDeSJmanVDrGksr4eD1gETUXRheKpanH20_h4g&oe=6AA54D79"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "commercial w sound 2.mp4 - VLC media player 5_17_2025 2_36_03 AM.png", "id": "1269410801268054", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499340115_1269410804601387_4685808903603963682_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CMux6o1mwHQQ7kNvwFcYtUZ&_nc_oc=Adpn6usLdzUORSstBT0Lhz2FmCkSvCnrmg_62jkPtsebg6Sclzo1GP7c3g0vOR66TAs&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIZYE4JFNyWg0OXZCY1EyHkcbiNQ0qySAqmS_LN7HkB_A&oe=6AA577B9"}, "display_name": "Fruit Punch", "keywords": ["punch", "fruit", "boxing", "arcade", "sports"], "long_description": "Throw hands, burst fruit, and become a master of juicy destruction in this over-the-top VR arcade boxing game! Train your fists, sharpen your reflexes, and chase high scores while fruit of all shapes and sizes come flying straight at you. Want your own vibe? Load any music you want and turn every punch into a rhythm-powered workout.\n\nFruit Punch comes out swinging with three deliciously chaotic modes:\n\n\u2022 The Splatter Ring\nPunch every fruit in sight\u2014but hit with the right strength or it won\u2019t break. Simple, right? Not when the fruit starts fighting back with physics.\n\n\u2022 The Juice Factory\nPrecision over power. Punch fruit directly into the juicer to earn points. A mode for players who like their accuracy as sharp as their punches.\n\n\u2022 Mr. Nyoki\u2019s Garden\nEndless waves, rising intensity, and pure fruity mayhem. Your stamina will be tested. Your arms will burn. You will be sticky.\n\nA fast, funny, and wildly satisfying VR rampage.\nGood luck, and may the odds be ever in your flavor!", "short_description": "Step into the ring and turn fruit into flying juice explosions! Punch your way through frantic VR challenges, from timed rounds to endless waves. Easy to pick up, wildly satisfying, and packed with delicious chaos."}]}, "developer_name": null, "developer_privacy_policy_url": "https://brasseurphoto2.wixsite.com/palmpilots-privacy-p", "developer_terms_of_service_url": null, "publisher_name": "TIOS Digital", "support_website_url": null, "website_url": "http://TIOSDigital.Com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [
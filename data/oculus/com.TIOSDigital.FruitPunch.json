728394272_7869847908984400105_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8EfQywJRnTQQ7kNvwH26Yfn&_nc_oc=Adot6VkAHCPh5haD-yxiMt-q4g9lyTKq74efMTCepRUT4xtFTk3W2wPmdd5QDkzzTyI&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHsmYqnjZbF0lGKfBS-n4LeEcZV358lvkaYq3XtePAvVg&oe=6A918B0B"}, {"file_name": "com.oculus.metacam-20250708-004254-0.mp4 - VLC media player 7_8_2025 1_37_15 AM.png", "id": "968501408639019", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/491830607_968501411972352_9012171935589060547_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1zJGUT-KG88Q7kNvwFZNKrB&_nc_oc=AdoOLaZiIFN8NQN6PFNLg4Y9DuoqipzhT36Z4qIs0NN3FDVv0YqBpT4v9rZ21gp7Kng&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEqh6D32JfkA0QT7W7SLE8hdcL35BOMzmNBt8xg6Qfg4g&oe=6A918554"}, {"file_name": "com.oculus.metacam-20250708-004254-0.mp4 - VLC media player 7_9_2025 8_50_18 PM.png", "id": "3625838987720968", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/491828816_3625838994387634_228159314360632087_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CWsf9jNvmHAQ7kNvwGZsly5&_nc_oc=AdrPJTygtJdHcUJru2LPn1oyUJh1fGiflGP2nypPAKsqa9jaNhtSIFzfchfjypdELIQ&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEDvOzsE4gYAESKEig_j8cqYOIU5bqMLKEbTQV9g-Jefg&oe=6A918171"}, {"file_name": "02.png", "id": "1386363002486828", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/499310646_1386363005820161_7554233243955987898_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PNTOI3DaLcgQ7kNvwGGuNQO&_nc_oc=AdrsRgayYgFEYgR9RmWVou3-xVogm9G295l_GFMvK6-04w38j-rB7IaKUFGqXZaIFf4&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFmiY7g9QgqwQovQxORmzfL2H8uQhGah8sTeKAGuF3Jyw&oe=6A9186F9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "commercial w sound 2.mp4 - VLC media player 5_17_2025 2_36_03 AM.png", "id": "1269410801268054", "uri": "https://scontent-hkg1-1.oculuscdn.com/v/t64.5771-25/499340115_1269410804601387_4685808903603963682_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9YWtfFOB98sQ7kNvwEhqB6z&_nc_oc=Adoal7uwJsmoCAaOqJfLsVlKN7an-0lk2w6k-tvUQvbd9oc36cyLmlNYze7199KvyCw&_nc_zt=3&_nc_ht=scontent-hkg1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHRIBOCekSzU0CPZA8B0X6nUjf6VdSWP_z-EWpZOsECng&oe=6A9178F9"}, "display_name": "Fruit Punch", "keywords": ["punch", "fruit", "boxing", "arcade", "sports"], "long_description": "Throw hands, burst fruit, and become a master of juicy destruction in this over-the-top VR arcade boxing game! Train your fists, sharpen your reflexes, and chase high scores while fruit of all shapes and sizes come flying straight at you. Want your own vibe? Load any music you want and turn every punch into a rhythm-powered workout.\n\nFruit Punch comes out swinging with three deliciously chaotic modes:\n\n\u2022 The Splatter Ring\nPunch every fruit in sight\u2014but hit with the right strength or it won\u2019t break. Simple, right? Not when the fruit starts fighting back with physics.\n\n\u2022 The Juice Factory\nPrecision over power. Punch fruit directly into the juicer to earn points. A mode for players who like their accuracy as sharp as their punches.\n\n\u2022 Mr. Nyoki\u2019s Garden\nEndless waves, rising intensity, and pure fruity mayhem. Your stamina will be tested. Your arms will burn. You will be sticky.\n\nA fast, funny, and wildly satisfying VR rampage.\nGood luck, and may the odds be ever in your flavor!", "short_description": "Step into the ring and turn fruit into flying juice explosions! Punch your way through frantic VR challenges, from timed rounds to endless waves. Easy to pick up, wildly satisfying, and packed with delicious chaos."}]}, "developer_name": null, "developer_privacy_policy_url": "https://brasseurphoto2.wixsite.com/palmpilots-privacy-p", "developer_terms_of_service_url": null, "publisher_name": "TIOS Digital", "support_website_url": null, "website_url": "http://TIOSDigital.Com/", "category": null, "comfort_rating": "COMFORTABLE_FO
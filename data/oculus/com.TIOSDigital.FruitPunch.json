728394272_7869847908984400105_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tlCtiBxrU4QQ7kNvwFuNwwp&_nc_oc=Adri2kY7Ml_VI5HMeYJfUxKLiL0Fw_I7C-7vPV-lW6x5LKC09S1AEiMf8V4m-rz4xDc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHjGAorZO80szN195MRFJhaEhmAh3AGEDQoUDetetKmqQ&oe=6A95B7CB"}, {"file_name": "com.oculus.metacam-20250708-004254-0.mp4 - VLC media player 7_8_2025 1_37_15 AM.png", "id": "968501408639019", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491830607_968501411972352_9012171935589060547_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uj0bakzXzywQ7kNvwEAawmn&_nc_oc=AdqTZ6nxhPX774dc6G6JhBv9BwhfgwDkw6CtJy6YXsJbwfe6CW8CrvGRQM1mq1pkcgQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFTW8nsSjajTbZO53Vf3zBhDpR--QGWcs3uuNddvduNOg&oe=6A95B214"}, {"file_name": "com.oculus.metacam-20250708-004254-0.mp4 - VLC media player 7_9_2025 8_50_18 PM.png", "id": "3625838987720968", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491828816_3625838994387634_228159314360632087_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FzyFJxC6iWoQ7kNvwHartWc&_nc_oc=Ado67M4ARS5em5K9Iuw7le-cJGEbp-XyCJPwN5clTX8gAFiAr_83_O9gA12TD9a7gB4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG2cidfAB866rwhTHzzlX6nMUgLZSbO8F0FRYAKdmcJng&oe=6A95AE31"}, {"file_name": "02.png", "id": "1386363002486828", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499310646_1386363005820161_7554233243955987898_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G5_oGAWG02cQ7kNvwGy-h2S&_nc_oc=AdrQ_5mzr7p4WEbEz0cPnneLQYovJ7pidrgemBbzom9GHNnb_6nDRUKTYyOvD1n15pg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGyfpeYKCsaOgeLC3QLzGbYUk2BFUQAGkaTCVCXdERdSA&oe=6A95B3B9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "commercial w sound 2.mp4 - VLC media player 5_17_2025 2_36_03 AM.png", "id": "1269410801268054", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499340115_1269410804601387_4685808903603963682_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fclpZ-ft1_YQ7kNvwG34uhl&_nc_oc=Adqt14FwWe-WnogK-0BNFkV38w2HtC3Dqev7_Q3FGCEYgdcThiyJq_iaF7CAEcNm-4g&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFBtPIpI25gzI2KHz8dpjnI6gwYm9uHjrEuawsprwqbeg&oe=6A95DDF9"}, "display_name": "Fruit Punch", "keywords": ["punch", "fruit", "boxing", "arcade", "sports"], "long_description": "Throw hands, burst fruit, and become a master of juicy destruction in this over-the-top VR arcade boxing game! Train your fists, sharpen your reflexes, and chase high scores while fruit of all shapes and sizes come flying straight at you. Want your own vibe? Load any music you want and turn every punch into a rhythm-powered workout.\n\nFruit Punch comes out swinging with three deliciously chaotic modes:\n\n\u2022 The Splatter Ring\nPunch every fruit in sight\u2014but hit with the right strength or it won\u2019t break. Simple, right? Not when the fruit starts fighting back with physics.\n\n\u2022 The Juice Factory\nPrecision over power. Punch fruit directly into the juicer to earn points. A mode for players who like their accuracy as sharp as their punches.\n\n\u2022 Mr. Nyoki\u2019s Garden\nEndless waves, rising intensity, and pure fruity mayhem. Your stamina will be tested. Your arms will burn. You will be sticky.\n\nA fast, funny, and wildly satisfying VR rampage.\nGood luck, and may the odds be ever in your flavor!", "short_description": "Step into the ring and turn fruit into flying juice explosions! Punch your way through frantic VR challenges, from timed rounds to endless waves. Easy to pick up, wildly satisfying, and packed with delicious chaos."}]}, "developer_name": null, "developer_privacy_policy_url": "https://brasseurphoto2.wixsite.com/palmpilots-privacy-p", "developer_terms_of_service_url": null, "publisher_name": "TIOS Digital", "support_website_url": null, "website_url": "http://TIOSDigital.Com/", "category": null, "comfort_rating": "COMFORTABLE_FO
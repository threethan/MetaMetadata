Z9cmcNR4qQ7kVQA0fURqB0O81jJwS-rukTF7N4yUU3p6okv_XJ3U&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKw_fcsRto8p1Yq0yXEvpNj5mWpXtlDUHgbvWqvtU_7pQ&oe=6AA00B8B"}, {"file_name": "com.oculus.metacam-20250708-004254-0.mp4 - VLC media player 7_8_2025 1_37_15 AM.png", "id": "968501408639019", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/491830607_968501411972352_9012171935589060547_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O-l-qA3BMAAQ7kNvwH6BFTV&_nc_oc=AdpV519Q9JsluKax3O9c7NqCnJ-QIsxpMHaAgrih2MWg76CXflV94eaTKtC8-o-8Los&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKFYFhJ4GuDdPyyAL2h97PCzh1A259FFPmW7dr9A7Txlg&oe=6AA005D4"}, {"file_name": "com.oculus.metacam-20250708-004254-0.mp4 - VLC media player 7_9_2025 8_50_18 PM.png", "id": "3625838987720968", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/491828816_3625838994387634_228159314360632087_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N7zMEoEucx8Q7kNvwGZqnHp&_nc_oc=Adp3yV_vFjyLOA7Qnm4x9-0l22jh0kNrlRaDeU_mMVDDiASswUXSIwgqdtwPlxiSL4M&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIFBkyTPWQ3PuaUbV99re-GcmBXXf1U9e6PCQJ_M5aUow&oe=6AA001F1"}, {"file_name": "02.png", "id": "1386363002486828", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/499310646_1386363005820161_7554233243955987898_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DSgRYzKo998Q7kNvwFjVsQd&_nc_oc=AdohiyQ05VHN9BQ3BZMmlRruiLPYxNO4uDiw3D6dgfXB8q29Azm93Li_KquFCeN1gt0&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLjzz3wg9ZVbG9Dbw1Yjam9aEgmWy59jnR_TgsE_lsxtg&oe=6AA00779"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "commercial w sound 2.mp4 - VLC media player 5_17_2025 2_36_03 AM.png", "id": "1269410801268054", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/499340115_1269410804601387_4685808903603963682_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1vK6uVrZ0iMQ7kNvwESHu3a&_nc_oc=AdrO5ugwMuOSKOCY9nDJ9FUjPawfacxtkmJKd9Rgst_HsfDNff5Mism_-tC0iIULdA8&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJqoG0aSc-HzKnTaBTSubkRv_S1UnYypGD7gNZidbP19g&oe=6A9FF979"}, "display_name": "Fruit Punch", "keywords": ["punch", "fruit", "boxing", "arcade", "sports"], "long_description": "Throw hands, burst fruit, and become a master of juicy destruction in this over-the-top VR arcade boxing game! Train your fists, sharpen your reflexes, and chase high scores while fruit of all shapes and sizes come flying straight at you. Want your own vibe? Load any music you want and turn every punch into a rhythm-powered workout.\n\nFruit Punch comes out swinging with three deliciously chaotic modes:\n\n\u2022 The Splatter Ring\nPunch every fruit in sight\u2014but hit with the right strength or it won\u2019t break. Simple, right? Not when the fruit starts fighting back with physics.\n\n\u2022 The Juice Factory\nPrecision over power. Punch fruit directly into the juicer to earn points. A mode for players who like their accuracy as sharp as their punches.\n\n\u2022 Mr. Nyoki\u2019s Garden\nEndless waves, rising intensity, and pure fruity mayhem. Your stamina will be tested. Your arms will burn. You will be sticky.\n\nA fast, funny, and wildly satisfying VR rampage.\nGood luck, and may the odds be ever in your flavor!", "short_description": "Step into the ring and turn fruit into flying juice explosions! Punch your way through frantic VR challenges, from timed rounds to endless waves. Easy to pick up, wildly satisfying, and packed with delicious chaos."}]}, "developer_name": null, "developer_privacy_policy_url": "https://brasseurphoto2.wixsite.com/palmpilots-privacy-p", "developer_terms_of_service_url": null, "publisher_name": "TIOS Digital", "support_website_url": null, "website_url": "http://TIOSDigital.Com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [
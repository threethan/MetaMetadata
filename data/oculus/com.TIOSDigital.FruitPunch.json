09774728394272_7869847908984400105_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8EfQywJRnTQQ7kNvwFmnrBO&_nc_oc=AdrAvT0P2eYEyN7aKJ8GrBaKJb8H8sVTdxm8hRVvlqFJuhFpCzCu2mc6veqxj7zCshU&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGQBYHhIc3XJB6hOgw_7tlHGxSsk5Sm1LB2_SKInRyNcg&oe=6A8EE80B"}, {"file_name": "com.oculus.metacam-20250708-004254-0.mp4 - VLC media player 7_8_2025 1_37_15 AM.png", "id": "968501408639019", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/491830607_968501411972352_9012171935589060547_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1zJGUT-KG88Q7kNvwFrVquM&_nc_oc=AdochGi2datqdOELa2Q19E7-7EVNV79Fad7crc4pCK6Fz9ZQ3PZNS3m5uWRRSz5owO0&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG0aI9vIqpVHOUMrlc4YEFpWeaBG_N9erCjsEkLKy7zuw&oe=6A8EE254"}, {"file_name": "com.oculus.metacam-20250708-004254-0.mp4 - VLC media player 7_9_2025 8_50_18 PM.png", "id": "3625838987720968", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/491828816_3625838994387634_228159314360632087_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WYQ_XvyNEYgQ7kNvwHpVgp2&_nc_oc=AdpPdldz9NW2jU3mjZbowrEDM86_S1ykagGuz2GjjWfqctjPT4hPYE2jw-X5KCa7yaA&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE8rFunMuqwpbPUtslKGR_Pcj2uyoqkM2P5AnsbeLjjLQ&oe=6A8EDE71"}, {"file_name": "02.png", "id": "1386363002486828", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/499310646_1386363005820161_7554233243955987898_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PNTOI3DaLcgQ7kNvwHA07o9&_nc_oc=Adqe-_O2mr7_AEMeY4jgmOdxwApWhMU7NKLw74zmga3pP0F0uuuV2ic_oHanRwHPfGM&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEZgjFRqMJZUNQH_nQWU6unhb8_G5xKwwxnhO0Jt4mIyA&oe=6A8EE3F9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "commercial w sound 2.mp4 - VLC media player 5_17_2025 2_36_03 AM.png", "id": "1269410801268054", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/499340115_1269410804601387_4685808903603963682_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YOJYcGwDkswQ7kNvwEcjuKP&_nc_oc=AdrNJn8EFYjDQ_l1BWvqS1uwATBC5ViI_ZRPYhMsu7AzMwMQTCxBKBM6C1Qlo_JKeak&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFCkfeLe4xHoFBr_7Y702WKcngxPA2xcEm8msJmQLQzVQ&oe=6A8ED5F9"}, "display_name": "Fruit Punch", "keywords": ["punch", "fruit", "boxing", "arcade", "sports"], "long_description": "Throw hands, burst fruit, and become a master of juicy destruction in this over-the-top VR arcade boxing game! Train your fists, sharpen your reflexes, and chase high scores while fruit of all shapes and sizes come flying straight at you. Want your own vibe? Load any music you want and turn every punch into a rhythm-powered workout.\n\nFruit Punch comes out swinging with three deliciously chaotic modes:\n\n\u2022 The Splatter Ring\nPunch every fruit in sight\u2014but hit with the right strength or it won\u2019t break. Simple, right? Not when the fruit starts fighting back with physics.\n\n\u2022 The Juice Factory\nPrecision over power. Punch fruit directly into the juicer to earn points. A mode for players who like their accuracy as sharp as their punches.\n\n\u2022 Mr. Nyoki\u2019s Garden\nEndless waves, rising intensity, and pure fruity mayhem. Your stamina will be tested. Your arms will burn. You will be sticky.\n\nA fast, funny, and wildly satisfying VR rampage.\nGood luck, and may the odds be ever in your flavor!", "short_description": "Step into the ring and turn fruit into flying juice explosions! Punch your way through frantic VR challenges, from timed rounds to endless waves. Easy to pick up, wildly satisfying, and packed with delicious chaos."}]}, "developer_name": null, "developer_privacy_policy_url": "https://brasseurphoto2.wixsite.com/palmpilots-privacy-p", "developer_terms_of_service_url": null, "publisher_name": "TIOS Digital", "support_website_url": null, "website_url": "http://TIOSDigital.Com/", "category": null, "comfort_rating": "CO
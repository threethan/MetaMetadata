728394272_7869847908984400105_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tlCtiBxrU4QQ7kNvwGf_nxA&_nc_oc=Adqw2zBS3UUmYzhonzxbIuWPOf1ZrJ8NCI5tX9NqW5JkPVEmORkjDttcCRMMC1-9OP0&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEAY7cEE3Glt_bs0gQZtG_hnWptan0MCXX5YVcTOzXPPg&oe=6A942E0B"}, {"file_name": "com.oculus.metacam-20250708-004254-0.mp4 - VLC media player 7_8_2025 1_37_15 AM.png", "id": "968501408639019", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/491830607_968501411972352_9012171935589060547_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uj0bakzXzywQ7kNvwGsCrKQ&_nc_oc=AdoMyArW15KGMUnU5Qti80sD0w1RsAXwZF0X_0PGeUJdXzzm_394En1UeAdQvs2CMlU&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF4_mFjiU6d8fK2lM7XpBlnivpOJa7_Hv-6V00wTPe43g&oe=6A942854"}, {"file_name": "com.oculus.metacam-20250708-004254-0.mp4 - VLC media player 7_9_2025 8_50_18 PM.png", "id": "3625838987720968", "uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/491828816_3625838994387634_228159314360632087_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FzyFJxC6iWoQ7kNvwGir7TG&_nc_oc=Adq36xkSbyndqksViTVbqLDfq633JgyiWk3euwDMa8YfwoBayxvZzNGLxAUXzH3QCHs&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHOkM-BR61whHX5PjANYWtlfibyTCxJRYel1_bJRnJv9Q&oe=6A942471"}, {"file_name": "02.png", "id": "1386363002486828", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/499310646_1386363005820161_7554233243955987898_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G5_oGAWG02cQ7kNvwHghKUR&_nc_oc=AdpUvDNLl8ZolYxOe3YUV1xF7eExzQNBkOc_bIKWa1HzHgBD8r_IVhwauy9yDfrCTSU&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE2XIlmprigg4Fko65kUOg522c-PYs0KxiEhLzUWjJDuw&oe=6A9429F9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "commercial w sound 2.mp4 - VLC media player 5_17_2025 2_36_03 AM.png", "id": "1269410801268054", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/499340115_1269410804601387_4685808903603963682_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9YWtfFOB98sQ7kNvwETfcLe&_nc_oc=AdpRs7MFmnrCTjaaWh3Zoio8ww8TLVIHprfW7WHacqdHphhIJUC-L4eirqt3RkTvFco&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFVWTLsCe2v8spQq266kGZCtFCKjOzlX0jKKPdcwSquUw&oe=6A941BF9"}, "display_name": "Fruit Punch", "keywords": ["punch", "fruit", "boxing", "arcade", "sports"], "long_description": "Throw hands, burst fruit, and become a master of juicy destruction in this over-the-top VR arcade boxing game! Train your fists, sharpen your reflexes, and chase high scores while fruit of all shapes and sizes come flying straight at you. Want your own vibe? Load any music you want and turn every punch into a rhythm-powered workout.\n\nFruit Punch comes out swinging with three deliciously chaotic modes:\n\n\u2022 The Splatter Ring\nPunch every fruit in sight\u2014but hit with the right strength or it won\u2019t break. Simple, right? Not when the fruit starts fighting back with physics.\n\n\u2022 The Juice Factory\nPrecision over power. Punch fruit directly into the juicer to earn points. A mode for players who like their accuracy as sharp as their punches.\n\n\u2022 Mr. Nyoki\u2019s Garden\nEndless waves, rising intensity, and pure fruity mayhem. Your stamina will be tested. Your arms will burn. You will be sticky.\n\nA fast, funny, and wildly satisfying VR rampage.\nGood luck, and may the odds be ever in your flavor!", "short_description": "Step into the ring and turn fruit into flying juice explosions! Punch your way through frantic VR challenges, from timed rounds to endless waves. Easy to pick up, wildly satisfying, and packed with delicious chaos."}]}, "developer_name": null, "developer_privacy_policy_url": "https://brasseurphoto2.wixsite.com/palmpilots-privacy-p", "developer_terms_of_service_url": null, "publisher_name": "TIOS Digital", "support_website_url": null, "website_url": "http://TIOSDigital.Com/", "category": null, "comfort_rating": "COMFORTABLE_FO
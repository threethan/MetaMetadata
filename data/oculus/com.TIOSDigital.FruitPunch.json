38jgLFnybnRriuVKGqPfdfbePvzGyqeEHQxo1UnvIy6jod8BC3A6AyyXME&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKBJuZIQ_Mj696Oa66CtIg-aX5gXpvyyazsYwFWxwHwjg&oe=6AA4000B"}, {"file_name": "com.oculus.metacam-20250708-004254-0.mp4 - VLC media player 7_8_2025 1_37_15 AM.png", "id": "968501408639019", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/491830607_968501411972352_9012171935589060547_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ePIZvnwNdOYQ7kNvwFI9kh4&_nc_oc=Adqp7KAFTAJI7I5qOZjJOrCN98x3EgnhI9VeQ6exvlsXb4oIEKQ4I3Z_5wso5_L_Bu4&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIueUBjwzY594Tk42gGCnTLgNjzHUnoRAeZdz4u-4MbmQ&oe=6AA3FA54"}, {"file_name": "com.oculus.metacam-20250708-004254-0.mp4 - VLC media player 7_9_2025 8_50_18 PM.png", "id": "3625838987720968", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/491828816_3625838994387634_228159314360632087_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r9hoGH7o6bAQ7kNvwFjGFID&_nc_oc=Adpzp6-EPjKNz_6rVilXPyX7fL7nnFwxoX1T1hGg-GQsZ370kv5xQjwD4D5_R-C4aVU&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKZw-vk0UhxnSIdt7MEHHfurLU7iAn66CacFzYaY2-q1Q&oe=6AA3F671"}, {"file_name": "02.png", "id": "1386363002486828", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/499310646_1386363005820161_7554233243955987898_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B2DFB-xqskQQ7kNvwHW96US&_nc_oc=AdrdN6f3gC9vMX7-Ho0MfpmTreHUwdxk7iE0l6-GmHjZlgxd6tR46idkX0mhXv93RK4&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJfb0TAkcN2b3Mg0ScUTTuIVzTx1kFD4XcBH_lLklLxaw&oe=6AA3FBF9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "commercial w sound 2.mp4 - VLC media player 5_17_2025 2_36_03 AM.png", "id": "1269410801268054", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/499340115_1269410804601387_4685808903603963682_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h4oY-T8pVDEQ7kNvwFR03lO&_nc_oc=Ado3v5m5kaPl8Ysa0npmjzG3W8ktL6uY6IAPyAo6OYfySCrC6uJhcOtytXDYnpBACUc&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLj6gjSc_DzKCcsS3xFUHyhuM_gjqTHZI6RjRUGSsD9aQ&oe=6AA3EDF9"}, "display_name": "Fruit Punch", "keywords": ["punch", "fruit", "boxing", "arcade", "sports"], "long_description": "Throw hands, burst fruit, and become a master of juicy destruction in this over-the-top VR arcade boxing game! Train your fists, sharpen your reflexes, and chase high scores while fruit of all shapes and sizes come flying straight at you. Want your own vibe? Load any music you want and turn every punch into a rhythm-powered workout.\n\nFruit Punch comes out swinging with three deliciously chaotic modes:\n\n\u2022 The Splatter Ring\nPunch every fruit in sight\u2014but hit with the right strength or it won\u2019t break. Simple, right? Not when the fruit starts fighting back with physics.\n\n\u2022 The Juice Factory\nPrecision over power. Punch fruit directly into the juicer to earn points. A mode for players who like their accuracy as sharp as their punches.\n\n\u2022 Mr. Nyoki\u2019s Garden\nEndless waves, rising intensity, and pure fruity mayhem. Your stamina will be tested. Your arms will burn. You will be sticky.\n\nA fast, funny, and wildly satisfying VR rampage.\nGood luck, and may the odds be ever in your flavor!", "short_description": "Step into the ring and turn fruit into flying juice explosions! Punch your way through frantic VR challenges, from timed rounds to endless waves. Easy to pick up, wildly satisfying, and packed with delicious chaos."}]}, "developer_name": null, "developer_privacy_policy_url": "https://brasseurphoto2.wixsite.com/palmpilots-privacy-p", "developer_terms_of_service_url": null, "publisher_name": "TIOS Digital", "support_website_url": null, "website_url": "http://TIOSDigital.Com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_to
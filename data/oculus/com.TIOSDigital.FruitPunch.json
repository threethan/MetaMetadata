e4JT1igSCwoBugkKNCXmkxCvyQzjFGqEBhFHVISywMHWnfdnkI8I&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJaacIdCFVN8CrrhullObT5dVL0GIwvxmgpMi9SZ7IVPw&oe=6AA15D0B"}, {"file_name": "com.oculus.metacam-20250708-004254-0.mp4 - VLC media player 7_8_2025 1_37_15 AM.png", "id": "968501408639019", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/491830607_968501411972352_9012171935589060547_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O-l-qA3BMAAQ7kNvwEqjqYV&_nc_oc=AdpX2yivIUYf_ua6FEAffYDWXzfQ1ryU-_-mTAcXwV-917YwHcaZ6jp7t4wxPtA7WB4&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKYPRNXd2D5E2eTjEhWGQdszC9JwyvuOYFLXajWqlJfvg&oe=6AA15754"}, {"file_name": "com.oculus.metacam-20250708-004254-0.mp4 - VLC media player 7_9_2025 8_50_18 PM.png", "id": "3625838987720968", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/491828816_3625838994387634_228159314360632087_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N7zMEoEucx8Q7kNvwFcqPkY&_nc_oc=Adodsejs-BGzOlpAZNOz8y9fW1NijhoVRwIYO7roWgdp_fUEacxwFSKixjBtf5PEupE&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJGIGwddHnAccrTThvxkiSvVJx8W_aOte6JCsiMkYXucw&oe=6AA15371"}, {"file_name": "02.png", "id": "1386363002486828", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/499310646_1386363005820161_7554233243955987898_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DSgRYzKo998Q7kNvwGZLJP0&_nc_oc=AdonZbY-AWVsz9seWuKgQjSwaZsQErSFJEv9sUTBm8eYtvd01vgYxcTF3AI5pMcYTmg&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIjAdacECvNXHSonWNqc1Swyc0FMHFMyzJrgXFWEIvqBg&oe=6AA158F9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "commercial w sound 2.mp4 - VLC media player 5_17_2025 2_36_03 AM.png", "id": "1269410801268054", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/499340115_1269410804601387_4685808903603963682_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h4oY-T8pVDEQ7kNvwEUy4lg&_nc_oc=Adre2cqw2E2LMU2gPWDFuyVJn7XW_FwjdRiTHMdYqlxufgHgYNaCZXgMjRGvvhyflUQ&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIGAwfYZmMG0kTEYhSOOOIdHmpcwODKmqHP585ThzkW_A&oe=6AA14AF9"}, "display_name": "Fruit Punch", "keywords": ["punch", "fruit", "boxing", "arcade", "sports"], "long_description": "Throw hands, burst fruit, and become a master of juicy destruction in this over-the-top VR arcade boxing game! Train your fists, sharpen your reflexes, and chase high scores while fruit of all shapes and sizes come flying straight at you. Want your own vibe? Load any music you want and turn every punch into a rhythm-powered workout.\n\nFruit Punch comes out swinging with three deliciously chaotic modes:\n\n\u2022 The Splatter Ring\nPunch every fruit in sight\u2014but hit with the right strength or it won\u2019t break. Simple, right? Not when the fruit starts fighting back with physics.\n\n\u2022 The Juice Factory\nPrecision over power. Punch fruit directly into the juicer to earn points. A mode for players who like their accuracy as sharp as their punches.\n\n\u2022 Mr. Nyoki\u2019s Garden\nEndless waves, rising intensity, and pure fruity mayhem. Your stamina will be tested. Your arms will burn. You will be sticky.\n\nA fast, funny, and wildly satisfying VR rampage.\nGood luck, and may the odds be ever in your flavor!", "short_description": "Step into the ring and turn fruit into flying juice explosions! Punch your way through frantic VR challenges, from timed rounds to endless waves. Easy to pick up, wildly satisfying, and packed with delicious chaos."}]}, "developer_name": null, "developer_privacy_policy_url": "https://brasseurphoto2.wixsite.com/palmpilots-privacy-p", "developer_terms_of_service_url": null, "publisher_name": "TIOS Digital", "support_website_url": null, "website_url": "http://TIOSDigital.Com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [
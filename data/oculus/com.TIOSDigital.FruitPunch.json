HOEVGu80txS9MAG2Zl30_0-sa-4W2F8MSgpUx8DJVhxmI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL7CBzRf9mtRMVT2qNE095UGd-OgkQWSNcXPJrD74cJGA&oe=6AB2A6B9"}, "display_name": "Fruit Punch", "keywords": ["punch", "fruit", "boxing", "arcade", "sports"], "long_description": "Forget the dojo. Forget the sword. All you need are two fists and a serious appetite for destruction. This retro-inspired reimagining of a classic 2D game brings fruit-smashing action into the world of old-school American boxing. \n\nPunch your way through juicy challenges, master multiple gameplay modes, and unleash your fury across a variety of colorful environments.\n\nIt\u2019s fast. It\u2019s juicy. It\u2019s ridiculously satisfying.", "short_description": "You don't have to be a ninja to smash fruit in this re-imagining of a classic  2d game brought to life in the style of old-school American boxing."}]}, "developer_name": null, "developer_privacy_policy_url": "https://brasseurphoto2.wixsite.com/palmpilots-privacy-p", "developer_terms_of_service_url": null, "publisher_name": "TIOS Digital", "support_website_url": null, "website_url": "http://TIOSDigital.Com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "459781504968480"}, {"id": "1592192974313489"}, {"id": "2710427532541308"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "39524753337123856"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc
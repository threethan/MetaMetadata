ent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHms-D603BCzupKJcm-iFAR2XaaCN7EMCiZeXU6Z0lr8w&oe=6A974291"}, {"file_name": "RatParty_Custom..._02.07.2026_19-41-07.png", "id": "1513870823300447", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/499620856_1513870826633780_1351613836232322464_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zO3SEINOa7QQ7kNvwFFXNEF&_nc_oc=Adrcp61BNFmzbPjCVwCMEVHh8Jo4Iippn2HNgSURSqGga-ZQUAfkzROc8_cFLrj6hUI&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFpYwLQ5c6NGHHCivY8ojvy7H5DQmvqxcdPAnO7uAz_xg&oe=6A972D13"}, {"file_name": "RatParty_Custom..._02.07.2026_21-14-48.png", "id": "1680777556530793", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/499620856_1680777559864126_1774708926822530783_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=99SyUPmFsjwQ7kNvwH5Wnwg&_nc_oc=AdqQFgBRtU2FQ44zsbhaO6_5l_BjLZFIvBTPfBtdfpU6jdiwRL7AraP0gag1pdy-1AA&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFD4b4ARQoTK4BDXzXbiJ5dy90C2BsOgNP7B06dyriAWA&oe=6A9737E4"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Rat Party", "keywords": ["action", "funny", "social", "partygame", "multiplayer"], "long_description": "Rat Party is a chaotic VR game built around gorilla\u2011style locomotion \u2014 that wild, arm\u2011swinging movement that makes every jump and climb feel like pure madness. You play as a rat tearing through vibrant maps, bouncing off the ground, scaling walls, and get eliminated by horror entities.", "short_description": "Rat Party is a fast, chaotic VR game where you swing, climb, and launch yourself around the map using gorilla\u2011style locomotion. Play as a rat, race your friends, explore weird spots, and cause as much trouble as you can. It\u2019s simple, loud, and stupid fun."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/rat-party/home", "developer_terms_of_service_url": null, "publisher_name": "Gumdrop", "support_w
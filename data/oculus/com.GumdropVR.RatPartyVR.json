ent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNkTDnTjmdSZj5FL1Sxi_aKPw6FuXfI_m1QRAcSdWvErQ&oe=6AE5EC11"}, {"file_name": "RatParty_Custom..._02.07.2026_19-41-07.png", "id": "1513870823300447", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499620856_1513870826633780_1351613836232322464_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pSpzNLXw06UQ7kNvwEoLcuC&_nc_oc=AdptHGRQPjHaT1Gs6qOGYFK4WHFW01o44UpVQMCYuzKCSmTPNfvSY-BAbXXV4g9jUe8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNhqsThc1exHRl9LmTCJfIsL7EswNCkYIiGpsYkOu29HQ&oe=6AE60ED3"}, {"file_name": "RatParty_Custom..._02.07.2026_21-14-48.png", "id": "1680777556530793", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499620856_1680777559864126_1774708926822530783_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lPJAWhHSav0Q7kNvwFx6C4G&_nc_oc=AdpwQhl5H5bI28GbQXiUiA3oLPHxwBYraoykMEFVJmSn25sh6YYV-nqRMnxEQd_juS4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPURPsyEAVWqR5Dyrv9pjk5Tt70QwOaBA-F_irNuhFvRQ&oe=6AE619A4"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Rat Party", "keywords": ["action", "funny", "social", "partygame", "multiplayer"], "long_description": "Rat Party is a chaotic VR game built around gorilla\u2011style locomotion \u2014 that wild, arm\u2011swinging movement that makes every jump and climb feel like pure madness. You play as a rat tearing through vibrant maps, bouncing off the ground, scaling walls, and get eliminated by horror entities.", "short_description": "Rat Party is a fast, chaotic VR game where you swing, climb, and launch yourself around the map using gorilla\u2011style locomotion. Play as a rat, race your friends, explore weird spots, and cause as much trouble as you can. It\u2019s simple, loud, and stupid fun."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/rat-party/home", "developer_terms_of_service_url": null, "publisher_name": "Gumdrop", "support_w
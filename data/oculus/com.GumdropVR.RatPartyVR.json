ent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJiSwOKxDMcGyoRs1J29qqpACA6KobVPTR5j9RXPwjNoA&oe=6AA55291"}, {"file_name": "RatParty_Custom..._02.07.2026_19-41-07.png", "id": "1513870823300447", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499620856_1513870826633780_1351613836232322464_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RfWv62ASBKgQ7kNvwF9vToP&_nc_oc=Adq5KSx2cNf4jkcsrAoXit-f4RbYJkss7IAkTP8MUzopVcsaT1BEIeztqorMxNPYJZM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQII50BLzizwV9XwW9SiT8nHnOd13431PeE4ijdwDQFeSQ&oe=6AA57553"}, {"file_name": "RatParty_Custom..._02.07.2026_21-14-48.png", "id": "1680777556530793", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499620856_1680777559864126_1774708926822530783_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cdvVr1iJqrAQ7kNvwHw-2_a&_nc_oc=Adqjjto1s3f53eeb88YJVro04BdICSaKaJy1QOrXCle8ib25qRSQEJNF-XeoCvUo4Fs&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL5AGTWrnWvt-IWWeE_vs-I6eeSCZDTVJbWhLfhxjMt0w&oe=6AA547E4"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Rat Party", "keywords": ["action", "funny", "social", "partygame", "multiplayer"], "long_description": "Rat Party is a chaotic VR game built around gorilla\u2011style locomotion \u2014 that wild, arm\u2011swinging movement that makes every jump and climb feel like pure madness. You play as a rat tearing through vibrant maps, bouncing off the ground, scaling walls, and get eliminated by horror entities.", "short_description": "Rat Party is a fast, chaotic VR game where you swing, climb, and launch yourself around the map using gorilla\u2011style locomotion. Play as a rat, race your friends, explore weird spots, and cause as much trouble as you can. It\u2019s simple, loud, and stupid fun."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/rat-party/home", "developer_terms_of_service_url": null, "publisher_name": "Gumdrop", "support_w
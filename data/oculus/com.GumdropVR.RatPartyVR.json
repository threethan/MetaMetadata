ent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOXy6yAi8EFGINsGCRRn88uogl3TgOKbEqh6hpOx9ezEA&oe=6ADCB191"}, {"file_name": "RatParty_Custom..._02.07.2026_19-41-07.png", "id": "1513870823300447", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499620856_1513870826633780_1351613836232322464_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2cU1NjBXyBcQ7kNvwHF7uBm&_nc_oc=Adpa2tM0bG0llcjphWWmREoOUeHB95sbXtGwgV4fw9viU31B3FbBCQc2ouX9qf4uzdA&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP2sGz9N6T6UbjK-zu2Y59wOorVkYmkgYrHELcUCFqzog&oe=6ADCD453"}, {"file_name": "RatParty_Custom..._02.07.2026_21-14-48.png", "id": "1680777556530793", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499620856_1680777559864126_1774708926822530783_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GqwN8Z_-d6EQ7kNvwFZcHa1&_nc_oc=Ado9o-sEFf0Gh2Ap1DdOKqeCcDJOz7PiPM87Z9oHHAM6YbLugx31PacM4lLQ9wroXvk&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMmQe5aIfaNJJihZUr3GYTLLjhsuU3T3pFzLun7X4khzg&oe=6ADCA6E4"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Rat Party", "keywords": ["action", "funny", "social", "partygame", "multiplayer"], "long_description": "Rat Party is a chaotic VR game built around gorilla\u2011style locomotion \u2014 that wild, arm\u2011swinging movement that makes every jump and climb feel like pure madness. You play as a rat tearing through vibrant maps, bouncing off the ground, scaling walls, and get eliminated by horror entities.", "short_description": "Rat Party is a fast, chaotic VR game where you swing, climb, and launch yourself around the map using gorilla\u2011style locomotion. Play as a rat, race your friends, explore weird spots, and cause as much trouble as you can. It\u2019s simple, loud, and stupid fun."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/rat-party/home", "developer_terms_of_service_url": null, "publisher_name": "Gumdrop", "support_w
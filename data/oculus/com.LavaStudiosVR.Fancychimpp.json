gCzlAXDx9lmsgeE7s81Kh81m99__MGWOcIAsdgJmr4z21aa2p7TsylzuSxIQs4c&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSGFSTFn1wZ97n3cF-jo50vZW45r5yQ-IEGAVo-OFVxRQ&oe=6B033482"}, {"file_name": "Add a heading (1).png", "id": "629637399834871", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473392314_629637403168204_4280918477583753190_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dXhIAwhTdIQQ7kNvwEwFJ1c&_nc_oc=AdqYei-1L_fmG8Vf0t7op_MuTvBR7gSGmXLBknNO-WqbXEFExf9e-A8JCvCRty8d9eY&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRjA86fhDSKyCvkkZHyRG1YDLnI8SOZRmyjBv6vj5RBmw&oe=6B0307D9"}, {"file_name": "Add a heading (3).png", "id": "1928397367987265", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473392023_1928397371320598_9036436963537282605_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=StE2AFZsPxUQ7kNvwHXV9MI&_nc_oc=AdqKjmkmwxvGO-hXhE0f1Hx4dtieb3EgMDK0GilQFdmdKPqbp2ImlYIxoOqOZX20_E4&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQROB2f0mv2gEm4M7pAsVoIKcD4rNtLuP3uXkVIWqypXHw&oe=6B031D26"}, {"file_name": "Untitled design (11).png", "id": "1085590143605990", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473392036_1085590146939323_5670802818562527441_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Q2SsarLoU_UQ7kNvwFSPKAP&_nc_oc=Adr7H3oLFVEWXio3tw2W0qdxgAMRK9hJ36l2N5MljktQivYvi6S5-cJiMNmapHdQBZ8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS2DJgjLv9XQJIUGLV6EKIhj-11lPoCwHHVQg0DfwZijg&oe=6B03340A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Paradise Island VR", "keywords": ["Action", "Fun", "Hangout"], "long_description": "Swing, climb, and leap your way through a tropical VR playground!\n\nWelcome to Paradis Island, a vibrant virtual paradise where movement is everything. Inspired by the exhilarating locomotion of Gorilla Tag, this game throws you into a lush island world where your arms are your only way to move. No buttons. No joysticks. Just pure physicality.\n\nRun on all fours, scale towering cliffs, vault across canyons, and dive into crystal-clear lagoons\u2014all with the freedom of fluid, physics-based motion. Whether you're racing your friends, exploring hidden caves, or pulling off wild stunts on palm-lined beaches, Paradis Island is your ultimate test of agility and creativity.\n\nFeatures:\n\n\ud83c\udf34 Unique arm-based locomotion in an open tropical world\n\n\ud83d\udc12 Multiplayer free-roam and competitive minigames\n\n\ud83e\uddd7 Vertical gameplay\u2014climb trees, cliffs, and ancient ruins\n\n\ud83c\udfdd\ufe0f Discover secrets, challenges, and dynamic environments\n\n\ud83c\udfa8 Customizable avatars and unlockable cosmetics\n\nGet ready to sweat, laugh, and move like never before. Your island adventure begins now!", "short_description": "Paradis Island is a game that uses gorilla loco motion but breaks the goals of vr."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/paradise-island-vr/privacy-policy?authuser=1", "developer_terms_of_service_url": null, "publisher_name": "Lava Studios VR", "support_website_url": null, "website_url": "https://sites.google.com/view/paradise-island-vr/home?authuser=1", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}, {"id": "1023770785722696"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_mod
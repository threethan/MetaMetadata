ontent-iad3-1.oculuscdn.com/v/t64.5771-25/473392325_1023562229690014_7272251497631208264_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aKeWU5cmFycQ7kNvwFUlA8x&_nc_oc=AdpIkGkqlYV-dFxJpapRu-0Fip7P9eT1lIAALxDHMJImBDrmCgN5_Ey2XL0rCNJAF14&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRSSnE0s1YrRZKVetCGQinUF6QUi0NZqDBZEsKYCoGVUA&oe=6B06F0C2"}, {"file_name": "Add a heading (1).png", "id": "629637399834871", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473392314_629637403168204_4280918477583753190_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nvbesgZLn5EQ7kNvwH7Ny1K&_nc_oc=Adqfmlm2JL5rfXffMr6v3Dj0Kxc7kc0EytRMmhKkuYA-30p6LraE9VTsBVcVYBO7ftw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRpfuSz8eBkRsK4F-vUpnA5cEGwBk3dL17sEZ7RcF5qMA&oe=6B06FC59"}, {"file_name": "Add a heading (3).png", "id": "1928397367987265", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473392023_1928397371320598_9036436963537282605_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ND8v_BsK-xIQ7kNvwF0Alzu&_nc_oc=Ado95sZVbEzRF19VUwXhbEbGZoYIodSCPM97SaXQlulk_f7fXH8AfjgBaX3-iI7ib2c&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSlPWN3rrszdQjVdWHtpv_2dtBUG2cxBHYHrwodBlvCIA&oe=6B0711A6"}, {"file_name": "Untitled design (11).png", "id": "1085590143605990", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473392036_1085590146939323_5670802818562527441_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VVtooj825FYQ7kNvwFPFe41&_nc_oc=Adphnt_kTEh-REav6XL8AWy24ZKaMEGsF8nkwgpNXNTJtUuw8CDQPVfRq3tt_CkuQoQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTvhiQ_QpFBhcjLlkelcswIKT3YGI1pa1wNH0F3PgDbkQ&oe=6B07288A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Paradise Island VR", "keywords": ["Action", "Fun", "Hangout"], "long_description": "Swing, climb, and leap your way through a tropical VR playground!\n\nWelcome to Paradis Island, a vibrant virtual paradise where movement is everything. Inspired by the exhilarating locomotion of Gorilla Tag, this game throws you into a lush island world where your arms are your only way to move. No buttons. No joysticks. Just pure physicality.\n\nRun on all fours, scale towering cliffs, vault across canyons, and dive into crystal-clear lagoons\u2014all with the freedom of fluid, physics-based motion. Whether you're racing your friends, exploring hidden caves, or pulling off wild stunts on palm-lined beaches, Paradis Island is your ultimate test of agility and creativity.\n\nFeatures:\n\n\ud83c\udf34 Unique arm-based locomotion in an open tropical world\n\n\ud83d\udc12 Multiplayer free-roam and competitive minigames\n\n\ud83e\uddd7 Vertical gameplay\u2014climb trees, cliffs, and ancient ruins\n\n\ud83c\udfdd\ufe0f Discover secrets, challenges, and dynamic environments\n\n\ud83c\udfa8 Customizable avatars and unlockable cosmetics\n\nGet ready to sweat, laugh, and move like never before. Your island adventure begins now!", "short_description": "Paradis Island is a game that uses gorilla loco motion but breaks the goals of vr."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/paradise-island-vr/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Lava Studios VR", "support_website_url": null, "website_url": "https://sites.google.com/view/paradise-island-vr/home?authuser=1", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}, {"id": "1023770785722696"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "re
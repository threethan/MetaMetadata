ontent-ord5-1.oculuscdn.com/v/t64.5771-25/473392325_1023562229690014_7272251497631208264_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H4CHjVI4oZUQ7kNvwGiQ4fM&_nc_oc=Adr21EsZMJmumBt31mKG1JfABo_TonIP_B6DnBd-WNV_S02gqKS-ZxcgWW1Lhj0x5wM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTHTPOlv50vYXztQtnE8AqRnGpgam7k-aRib9mJMmi7Rw&oe=6B0DC082"}, {"file_name": "Add a heading (1).png", "id": "629637399834871", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473392314_629637403168204_4280918477583753190_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Vtf1a0Y4RSUQ7kNvwFce9d-&_nc_oc=Adq4LkT_yn5XjojHcOd250RAfzXAYeUoc8geK682x-DGE3mwvRsDvIjYszKhqWHHIok&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQAMgWX1F1ojc07ZP9ycWG6Zi2ldp2ie11ienPDSO7uhw&oe=6B0DCC19"}, {"file_name": "Add a heading (3).png", "id": "1928397367987265", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473392023_1928397371320598_9036436963537282605_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F5eP0Qw3aRkQ7kNvwEria-a&_nc_oc=AdrpaZvIZBNh7TBMdKRCuGhkUQ4didl5tATllQrNQiLpdrP5fYxGCxGeaRS0LXhO7Sg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQR8bN4f7tFYIfU5i6rDylbx1wdxwUac4SdAuTpPexkFnQ&oe=6B0DA926"}, {"file_name": "Untitled design (11).png", "id": "1085590143605990", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473392036_1085590146939323_5670802818562527441_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9izyauAGKK4Q7kNvwEKw3kq&_nc_oc=AdrRMjvrOqvdlx9Pu2CevcZqwpKvBnpYO-vebAZSkdbYYhjeghWA1pgRN4bcAUYNn1k&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRw_mNW3obvFqN_GS3GTPSDBa03jRaNguBgdrGiyvRMkQ&oe=6B0DC00A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Paradise Island VR", "keywords": ["Action", "Fun", "Hangout"], "long_description": "Swing, climb, and leap your way through a tropical VR playground!\n\nWelcome to Paradis Island, a vibrant virtual paradise where movement is everything. Inspired by the exhilarating locomotion of Gorilla Tag, this game throws you into a lush island world where your arms are your only way to move. No buttons. No joysticks. Just pure physicality.\n\nRun on all fours, scale towering cliffs, vault across canyons, and dive into crystal-clear lagoons\u2014all with the freedom of fluid, physics-based motion. Whether you're racing your friends, exploring hidden caves, or pulling off wild stunts on palm-lined beaches, Paradis Island is your ultimate test of agility and creativity.\n\nFeatures:\n\n\ud83c\udf34 Unique arm-based locomotion in an open tropical world\n\n\ud83d\udc12 Multiplayer free-roam and competitive minigames\n\n\ud83e\uddd7 Vertical gameplay\u2014climb trees, cliffs, and ancient ruins\n\n\ud83c\udfdd\ufe0f Discover secrets, challenges, and dynamic environments\n\n\ud83c\udfa8 Customizable avatars and unlockable cosmetics\n\nGet ready to sweat, laugh, and move like never before. Your island adventure begins now!", "short_description": "Paradis Island is a game that uses gorilla loco motion but breaks the goals of vr."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/paradise-island-vr/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Lava Studios VR", "support_website_url": null, "website_url": "https://sites.google.com/view/paradise-island-vr/home?authuser=1", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}, {"id": "1023770785722696"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "re
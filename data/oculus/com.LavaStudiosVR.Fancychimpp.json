ontent-sea5-1.oculuscdn.com/v/t64.5771-25/473392325_1023562229690014_7272251497631208264_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fV2DBZDOXtMQ7kNvwEb6MEv&_nc_oc=Adr1VvF-XERjpIjc5GEPb_EnLpLCwKgjXALSf-9ilk2jCaNrtlRb_tN04Auff9IreqU&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTuL1oEbL9HhRGOlpcL9xapMY4ozF48_C6f-KV-ZIjN9Q&oe=6AFC64C2"}, {"file_name": "Add a heading (1).png", "id": "629637399834871", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473392314_629637403168204_4280918477583753190_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iAgkDijsXzEQ7kNvwHqBdQS&_nc_oc=AdpfVkA8_QHyGE-nbrA6j4EBouRv9aipm3jdixjPsjsURb3-vjAylqvs_sZOEO3KeGY&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQPjriAsd4zjie5xZ3gcCCIIfJ_UUHf9Y6qEC1zPHBTIg&oe=6AFC7059"}, {"file_name": "Add a heading (3).png", "id": "1928397367987265", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473392023_1928397371320598_9036436963537282605_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TqRQTpqZkY0Q7kNvwH-f2A8&_nc_oc=Adom_-4TuBK_rwWlGRJgmYM1tuJ14JTU6GAKp3PMQshjcZFA_4njhb6aqXP1XBzw5q4&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSyYSsyJW1Qi9f48FhLj3s26Re9IQksV0Ky4m4qib3FAA&oe=6AFC85A6"}, {"file_name": "Untitled design (11).png", "id": "1085590143605990", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473392036_1085590146939323_5670802818562527441_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3vJViX4DlwQQ7kNvwHnBERN&_nc_oc=AdpGYXDgb8FkcdRSDJrOIQLpCzQ_ED0eQontJuDA7siN4WBj6eZZWcoid6fXNA45NWc&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQFRApjmV0XXgBbUWr1p4Y_u6Ryn6OuwR9ExEiw2Hvmrw&oe=6AFC644A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Paradise Island VR", "keywords": ["Action", "Fun", "Hangout"], "long_description": "Swing, climb, and leap your way through a tropical VR playground!\n\nWelcome to Paradis Island, a vibrant virtual paradise where movement is everything. Inspired by the exhilarating locomotion of Gorilla Tag, this game throws you into a lush island world where your arms are your only way to move. No buttons. No joysticks. Just pure physicality.\n\nRun on all fours, scale towering cliffs, vault across canyons, and dive into crystal-clear lagoons\u2014all with the freedom of fluid, physics-based motion. Whether you're racing your friends, exploring hidden caves, or pulling off wild stunts on palm-lined beaches, Paradis Island is your ultimate test of agility and creativity.\n\nFeatures:\n\n\ud83c\udf34 Unique arm-based locomotion in an open tropical world\n\n\ud83d\udc12 Multiplayer free-roam and competitive minigames\n\n\ud83e\uddd7 Vertical gameplay\u2014climb trees, cliffs, and ancient ruins\n\n\ud83c\udfdd\ufe0f Discover secrets, challenges, and dynamic environments\n\n\ud83c\udfa8 Customizable avatars and unlockable cosmetics\n\nGet ready to sweat, laugh, and move like never before. Your island adventure begins now!", "short_description": "Paradis Island is a game that uses gorilla loco motion but breaks the goals of vr."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/paradise-island-vr/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Lava Studios VR", "support_website_url": null, "website_url": "https://sites.google.com/view/paradise-island-vr/home?authuser=1", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}, {"id": "1023770785722696"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "re
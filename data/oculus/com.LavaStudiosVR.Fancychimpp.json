ontent-ord5-1.oculuscdn.com/v/t64.5771-25/473392325_1023562229690014_7272251497631208264_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oYLRdb_0dacQ7kNvwF8inE2&_nc_oc=AdoaX6TLv4opPi6nwc7-3fG4pL0Tc9bHUPrMdh-saOggEAUOX6Ds-P_0IsK0Mi1roiA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ-nR5f5UJaptXVcggF4xCWjCvp5G5frfSvD0sqm25oUg&oe=6AFDB642"}, {"file_name": "Add a heading (1).png", "id": "629637399834871", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473392314_629637403168204_4280918477583753190_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iAgkDijsXzEQ7kNvwGTMhQw&_nc_oc=Adp8Y3FrN7Bt2F2IKlpB6DElK62Fw88ORW5C3Pr6nYEVreYSKnIgKgnhMfAxEiW-wD0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRqezDehAzBzigZoHijYd7QOfjxYHVZN0kh3DBIgr9TjQ&oe=6AFDC1D9"}, {"file_name": "Add a heading (3).png", "id": "1928397367987265", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473392023_1928397371320598_9036436963537282605_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O7RqQ7RGsMEQ7kNvwHV2IP3&_nc_oc=Ado_wv0Hvq79yLE02vzXBdoq7ot6Oi9Pzt0aLeRF2u8UWOj2wfA36KX0xFLmjGNk8TM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRKG7O1ZZmJPOGwv1LBUYYlqC6zQ1opEeig8pHCcrqmvg&oe=6AFDD726"}, {"file_name": "Untitled design (11).png", "id": "1085590143605990", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473392036_1085590146939323_5670802818562527441_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3vJViX4DlwQQ7kNvwGMfKHG&_nc_oc=AdrUI8sbWOEIjTe9YxX-M7I75d623VWE00tNNOtEx1FxQAwAsq9D5EPC9Tk0Q9Min0I&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQzf10WMgYo3DBm-4AcqBlruHKzNi6iQhWlRgGk03w-cQ&oe=6AFDB5CA"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Paradise Island VR", "keywords": ["Action", "Fun", "Hangout"], "long_description": "Swing, climb, and leap your way through a tropical VR playground!\n\nWelcome to Paradis Island, a vibrant virtual paradise where movement is everything. Inspired by the exhilarating locomotion of Gorilla Tag, this game throws you into a lush island world where your arms are your only way to move. No buttons. No joysticks. Just pure physicality.\n\nRun on all fours, scale towering cliffs, vault across canyons, and dive into crystal-clear lagoons\u2014all with the freedom of fluid, physics-based motion. Whether you're racing your friends, exploring hidden caves, or pulling off wild stunts on palm-lined beaches, Paradis Island is your ultimate test of agility and creativity.\n\nFeatures:\n\n\ud83c\udf34 Unique arm-based locomotion in an open tropical world\n\n\ud83d\udc12 Multiplayer free-roam and competitive minigames\n\n\ud83e\uddd7 Vertical gameplay\u2014climb trees, cliffs, and ancient ruins\n\n\ud83c\udfdd\ufe0f Discover secrets, challenges, and dynamic environments\n\n\ud83c\udfa8 Customizable avatars and unlockable cosmetics\n\nGet ready to sweat, laugh, and move like never before. Your island adventure begins now!", "short_description": "Paradis Island is a game that uses gorilla loco motion but breaks the goals of vr."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/paradise-island-vr/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Lava Studios VR", "support_website_url": null, "website_url": "https://sites.google.com/view/paradise-island-vr/home?authuser=1", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}, {"id": "1023770785722696"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "re
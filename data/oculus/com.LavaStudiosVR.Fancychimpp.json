KPGlcSaex1sPc1BLBcxe6j9OAhLQk3-LNp9qW3qfYd6pPLQbOcSVl05_OQ16aSk&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTmwGpZ6lM1AgX8zLkxvExxoEfIglQ8b6sEpBAF9JNJeQ&oe=6AFB4B82"}, {"file_name": "Add a heading (1).png", "id": "629637399834871", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/473392314_629637403168204_4280918477583753190_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iAgkDijsXzEQ7kNvwFNT2y8&_nc_oc=AdorfRI7ypADUU87W7YS5HJ6beFplZYQospskNpkENXDRzSHT5Lqs6prZtJS9IXMQzw&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSsQD0csMvdw_IqM6HBKWOdwNh6PgB7kIi0FuaVVqI2Pw&oe=6AFB1ED9"}, {"file_name": "Add a heading (3).png", "id": "1928397367987265", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/473392023_1928397371320598_9036436963537282605_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TqRQTpqZkY0Q7kNvwE7mVX6&_nc_oc=AdrFYjKyG7lFEnuskRdbdkjzSe8zg8V4F8ZWHY29QEHrvQEE3UDasuNwfnpCspsioqs&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTB5_MeoAFt0cJ0cZAOMypranrEzCSHtEelVj5iuAwUEA&oe=6AFB3426"}, {"file_name": "Untitled design (11).png", "id": "1085590143605990", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/473392036_1085590146939323_5670802818562527441_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PlsDssnt5Q0Q7kNvwEH6G2F&_nc_oc=Adq7nktzyVBHFh1UWaLOKseTAbrM030yqSc3IDuAPfThmJzz9CxXGV_GlQcaiJkQ2V4&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTxhAhX_FzxkbG9M0-HEvOP04tX4u5v9ROtEY7a5LvNoA&oe=6AFB4B0A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Paradise Island VR", "keywords": ["Action", "Fun", "Hangout"], "long_description": "Swing, climb, and leap your way through a tropical VR playground!\n\nWelcome to Paradis Island, a vibrant virtual paradise where movement is everything. Inspired by the exhilarating locomotion of Gorilla Tag, this game throws you into a lush island world where your arms are your only way to move. No buttons. No joysticks. Just pure physicality.\n\nRun on all fours, scale towering cliffs, vault across canyons, and dive into crystal-clear lagoons\u2014all with the freedom of fluid, physics-based motion. Whether you're racing your friends, exploring hidden caves, or pulling off wild stunts on palm-lined beaches, Paradis Island is your ultimate test of agility and creativity.\n\nFeatures:\n\n\ud83c\udf34 Unique arm-based locomotion in an open tropical world\n\n\ud83d\udc12 Multiplayer free-roam and competitive minigames\n\n\ud83e\uddd7 Vertical gameplay\u2014climb trees, cliffs, and ancient ruins\n\n\ud83c\udfdd\ufe0f Discover secrets, challenges, and dynamic environments\n\n\ud83c\udfa8 Customizable avatars and unlockable cosmetics\n\nGet ready to sweat, laugh, and move like never before. Your island adventure begins now!", "short_description": "Paradis Island is a game that uses gorilla loco motion but breaks the goals of vr."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/paradise-island-vr/privacy-policy?authuser=1", "developer_terms_of_service_url": null, "publisher_name": "Lava Studios VR", "support_website_url": null, "website_url": "https://sites.google.com/view/paradise-island-vr/home?authuser=1", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}, {"id": "1023770785722696"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_mod
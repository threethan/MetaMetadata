x.png", "id": "621067497509486", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473392170_621067500842819_59667068008519516_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1dlQBg2ptMgQ7kNvwH3Do8c&_nc_oc=AdrtrV0YECx2QdKhnkabdjWg-GbZZgznc6OpyW2-R7x5NQDnHzPchqiDqCMTyUo6OV0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTRnyeIBHVrSxelc08fYUgcuJfUHgUk65h6iQJ0dv_6UQ&oe=6AF1DA90"}]}, "id": "1291448549153558", "locale": "en_US", "screenshots": [{"file_name": "MeloMetaScreenshot1.png", "id": "1006786727993488", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473392105_1006786731326821_7134595964182418357_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LaUcskd9szIQ7kNvwGgspJ8&_nc_oc=Adon7EatxaoFB34jIrGZj2-xTx0A1TfEx7ohNaEdiMfyoWbUDsru0V9MWXa0W45-Te4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTl1YUoMiUH9L8cdQEqS2E79h7XcPLuKxNN19kjIeF_Hg&oe=6AF1DB9D"}, {"file_name": "MeloMetaScreenshot2.png", "id": "959173589532286", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473393759_959173592865619_3487967802132851484_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4jvH12hkSuwQ7kNvwFZ-sWL&_nc_oc=AdoDDdN4t5MtlwinOehgXgetFBKnmH0AVIm2fE_SLS8KkfGPkajNl7ms7DkFj5R2DbM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSaC38I3957K0kyx_OtcvVEbYAp7C431VMOguyxFbNdLg&oe=6AF1D859"}, {"file_name": "MeloMetaScreenshot3.png", "id": "910707774328491", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473392325_910707780995157_5665109302968308455_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bXMjIKIA_awQ7kNvwG3IggB&_nc_oc=AdpdSPOWaOQYxSZa1Uo7Ao4o7xNiycPxyCLatjyrfaZmPVW6k4D_VDTlLA_b-3mlPnI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQV5jFEN27fKDEQKTkowZe4ufXudVvrPm36_wK5MFcUXg&oe=6AF1F10B"}, {"file_name": "MeloMetaScreenshot5.png", "id": "1184104986458774", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473392168_1184104989792107_3756437261463344322_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3bHWgyq0YXcQ7kNvwHcrGKC&_nc_oc=Adrn02-U5zhCw0QgMI_i21pvFuOhpHubtPaADHzQJ-XPSTbSQlicaJ37FLBag5M_SNI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQBdwU-d0q5qHulku7XGtzOFGBM9GH4TvvUVxa6pX1P-w&oe=6AF1EFA0"}, {"file_name": "MeloMetaScreenshot6.png", "id": "9315925118492534", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473392105_9315925121825867_5361183675003147967_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r7K3ahBjw2IQ7kNvwGKVdwF&_nc_oc=AdpdPO1KbWs7AzvQ2aVB8wmUdaAoDAr5mAOtxZwGDduNDXXo3_S6HMwbFicBKpeTXVQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSu49QvkBe_sMPTJGmDhakcB8cUYUGImgMgeSeIZy-X-w&oe=6AF1FA30"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "MeloMetaThumbnail.png", "id": "598197749878350", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391935_598197753211683_4915318247077516530_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tZyL-i-IwSAQ7kNvwHvWx9y&_nc_oc=AdoejrAeDx9anR-iDKZipuh6I7o7PbSsMZtRdzx6SWAb5FWbWgFbouhbv2eThK_Sn4A&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRO9to0H5tyY2oCWnqiCkNfqofpig0i5imIxGqmJSq3RA&oe=6AF1F52D"}, "display_name": "Meloscene Beta", "keywords": ["Collaboration", "Music", "Creative", "Studio", "social"], "long_description": "Meloscene is your virtual creative studio. It is a real-time space where musicians, producers, designers, and artists can collaborate face to face in VR.\n\nJump in with just your headset, or unlock full creative control by connecting your DAW, editing software, and other tools through the free Meloscene Portal (Mac available at meloscene.com/download). A free virtual desktop with collaborative tools!\n\nSync files, collaborate live, and create side by side without feeds, distractions, or algorithms deciding what you see.\n\nYour avatar and creative environment live in the Portal. Once you are in, it is your studio. Not a game.\n\nBuilt for creators, not doomscrolling noise. Screen your work, stream reference videos, or share whatever is on your screen when the session is done.", "short_description": "NEW: Meloscene is now free. Meloscene Connect is live. Meet other creators at meloscene.com/connect and create together inside Meloscene.\n\nMeloscene is your virtual creative studio that lets you bring your computer and tools into VR/AR  on your terms. Collaborate face to face in VR and AR. Use just your headset, or unlock full creative control with the free Meloscene Portal (meloscene.com/download)."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.meloscene.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Meloscene", "support_website_url": "http://www.meloscene.com/faq", "website_url": "http://www.meloscene.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}, {"id": "1228796255027646"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER", "CO_OP"], "id": "26975597188746800"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473393333_1286588652438985_2477324980059955777_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nMvpWoDtwDQQ7kNvwFow-R7&_nc_oc=AdqwN-es8p7ehFn8Q1xzIe5pRgkYZv7eob29t1EoPVkhZczD3hkW2EL2MhtIVbL1TD0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=
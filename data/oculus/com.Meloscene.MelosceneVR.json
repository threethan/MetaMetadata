-74G3R10yWYCxwnKVs&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPm8dbiBJVOXjisQwOZAH7-OmQEL_XWUyoIPs1fkb4olA&oe=6ACD070B"}, {"file_name": "MeloMetaScreenshot5.png", "id": "1184104986458774", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473392168_1184104989792107_3756437261463344322_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PZ-RgTQF-VEQ7kNvwFcmvv9&_nc_oc=Ado_1xfb0BtGEQTvo0lTaoyeXBKTw3rECYol4yi2sWH1qNb20qxIP05ADYgci3rDTPk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMLLf5ijYcXhPT80aldAy746T7nPwWiUnXsDKzoXX8WgQ&oe=6ACD05A0"}, {"file_name": "MeloMetaScreenshot6.png", "id": "9315925118492534", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473392105_9315925121825867_5361183675003147967_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pMNKuRSdXAUQ7kNvwG8hUjL&_nc_oc=AdpwuGlp9oA9FUlEG-FNwND6qValPJLx3tjk3rmYAPXEYXZpqey41bBbaNeBER0S7p4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPD_RUlpdb5nsh9_Gx0bJNQmwTKfRaNjTMA7nluGbGL2w&oe=6ACD1030"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "MeloMetaThumbnail.png", "id": "598197749878350", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391935_598197753211683_4915318247077516530_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6RCfk4PfuW8Q7kNvwFWD794&_nc_oc=AdorpChGo-3SeYzfTo2-m0p6RH1gYXsPDXRk3tHX8jRRsCMI3pFmM2jhW6DJ9JsvNak&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQONt01UTgHh_3fzfUyKC4jDM63RNJa3vQRAdeytS7ITmQ&oe=6ACD0B2D"}, "display_name": "Meloscene Beta", "keywords": ["Collaboration", "Music", "Creative", "Studio", "chat"], "long_description": "Escape the algorithm-driven internet and step into Meloscene, the VR space where real creatives connect. No endless scrolling, no distractions, just artists, musicians, designers, podcasters, and fans collaborating in real time.\n\nCreators can use the free Meloscene Portal Software (Mac download at www.meloscene.com, Windows coming soon!) to integrate their PC, DAWs, editing tools, and creative software into VR. Work across any platform, sync files seamlessly, and collaborate live.\n\nFans and community members can experience creativity in real time, hang out in live sessions, connect with artists, and be part of something real.\n\nTo get started, download Meloscene onto your headset to enter the creative space. Install the Meloscene Portal Software on your computer to bring your favorite tools into VR. Then, step into a world where collaboration and creativity come to life.\n\nMeloscene isn\u2019t an algorithm deciding what you see. It\u2019s real people, creating together.", "short_description": "Early Access Presale \u2014 Save 20%!\nEscape algorithm-driven feeds and step into a space where creativity and community thrive. Whether you're a musician, artist, podcaster, or designer, Meloscene brings people together in real time. Connect your tools: Download the free Meloscene Portal (Mac at www.meloscene.com, Windows soon!) to integrate your PC, DAW, or creative software into VR. Sync files and collaborate effortlessly!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.meloscene.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Meloscene", "support_website_url": "http://www.meloscene.com/faq", "website_url": "http://www.meloscene.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}, {"id": "1228796255027646"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["SITTING", "ST
&_nc_ss=7f20f&oh=00_AQSDREsgf5j3wKfzTMLTrGNRRPCN_t0CR8gqzWgxz3IzNQ&oe=6AFDCE8B"}, {"file_name": "MeloMetaScreenshot5.png", "id": "1184104986458774", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473392168_1184104989792107_3756437261463344322_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KzwrGM7LekUQ7kNvwEodORy&_nc_oc=AdpybgF3L2nRo7D4vNcHvFXbs0i7pbiqiCJMnFQW9v189OUeNkfyrRt0CCWppUR5PNc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQPLOoUQu4SYYUhhmxZOG8_o2wDEycwurNuVhk_EsvhOg&oe=6AFDCD20"}, {"file_name": "MeloMetaScreenshot6.png", "id": "9315925118492534", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473392105_9315925121825867_5361183675003147967_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tUVrJ56isvUQ7kNvwF3-bSi&_nc_oc=AdqjBnO9_Q0PyOVjw-rbe3noZMZ2rdZV-CNfWsA9T9BWDz7ZereazkqKkZvy4u1m3vE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTbZKHXRRsJM2H_iLegUxN3d4hdf8ppY1caaL0LxH2Ozw&oe=6AFDD7B0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "MeloMetaThumbnail.png", "id": "598197749878350", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473391935_598197753211683_4915318247077516530_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v-RShCARrgMQ7kNvwE-bWiz&_nc_oc=AdoYwH2hvbqAnKjuL3KDSGflTdMJWEJWUyN02kg-rUpkWj8c54A4fT_t-9e2ZxnSP40&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTsTxk5aJPoGjOTYWsDWorx5AGo9uanYfYNF65T3n7Hew&oe=6AFDD2AD"}, "display_name": "Meloscene Beta", "keywords": ["Collaboration", "Music", "Creative", "Studio", "social"], "long_description": "Meloscene is your virtual creative studio. It is a real-time space where musicians, producers, designers, and artists can collaborate face to face in VR.\n\nJump in with just your headset, or unlock full creative control by connecting your DAW, editing software, and other tools through the free Meloscene Portal (Mac available at meloscene.com/download). A free virtual desktop with collaborative tools!\n\nSync files, collaborate live, and create side by side without feeds, distractions, or algorithms deciding what you see.\n\nYour avatar and creative environment live in the Portal. Once you are in, it is your studio. Not a game.\n\nBuilt for creators, not doomscrolling noise. Screen your work, stream reference videos, or share whatever is on your screen when the session is done.", "short_description": "NEW: Meloscene is now free. Meloscene Connect is live. Meet other creators at meloscene.com/connect and create together inside Meloscene.\n\nMeloscene is your virtual creative studio that lets you bring your computer and tools into VR/AR  on your terms. Collaborate face to face in VR and AR. Use just your headset, or unlock full creative control with the free Meloscene Portal (meloscene.com/download)."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.meloscene.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Meloscene", "support_website_url": "http://www.meloscene.com/faq", "website_url": "http://www.meloscene.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}, {"id": "1228796255027646"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER", "CO_OP"], "id": "26975597188746800"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-o
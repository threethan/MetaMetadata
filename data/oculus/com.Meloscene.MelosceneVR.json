7_3756437261463344322_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vOqhzWRU6ssQ7kNvwE5vUS8&_nc_oc=AdpgtbU_-PdA_UNvYvafQTggts6ToblWq84i1pUfrrrO4k6BhomwUUVV5qnwvjM-NY4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSkBcYMivn-7vlmkaKo2Vfs1mIIj4kPd4M_BQHOQxRdvw&oe=6AEF4CA0"}, {"file_name": "MeloMetaScreenshot6.png", "id": "9315925118492534", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473392105_9315925121825867_5361183675003147967_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r7K3ahBjw2IQ7kNvwGOEPUr&_nc_oc=Ado2W6gJfWWDaWtTthMre5bj5EW8GD3T7QUNEpnPz4mhGAhOrVNbLofYQmqdYaxCCYk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRSfAxGz1VR3q97_cSHpFe1seUTSqeWXATeCBUvhRFIgA&oe=6AEF5730"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "MeloMetaThumbnail.png", "id": "598197749878350", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473391935_598197753211683_4915318247077516530_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tZyL-i-IwSAQ7kNvwFormC0&_nc_oc=AdrejLsEGtEGBDIDQ_mKEuiNFn1-CQWFBC4TXe5aSBMdMfO3SKheWEEud6uo7_Yz1oM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTCglGTJ7GCgGwUmJ5vJIhW4f86bIm2fnzDsZTlYUMe0A&oe=6AEF522D"}, "display_name": "Meloscene Beta", "keywords": ["Collaboration", "Music", "Creative", "Studio", "social"], "long_description": "Meloscene is your virtual creative studio. It is a real-time space where musicians, producers, designers, and artists can collaborate face to face in VR.\n\nJump in with just your headset, or unlock full creative control by connecting your DAW, editing software, and other tools through the free Meloscene Portal (Mac available at meloscene.com/download). A free virtual desktop with collaborative tools!\n\nSync files, collaborate live, and create side by side without feeds, distractions, or algorithms deciding what you see.\n\nYour avatar and creative environment live in the Portal. Once you are in, it is your studio. Not a game.\n\nBuilt for creators, not doomscrolling noise. Screen your work, stream reference videos, or share whatever is on your screen when the session is done.", "short_description": "NEW: Meloscene is now free. Meloscene Connect is live. Meet other creators at meloscene.com/connect and create together inside Meloscene.\n\nMeloscene is your virtual creative studio that lets you bring your computer and tools into VR/AR  on your terms. Collaborate face to face in VR and AR. Use just your headset, or unlock full creative control with the free Meloscene Portal (meloscene.com/download)."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.meloscene.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Meloscene", "support_website_url": "http://www.meloscene.com/faq", "website_url": "http://www.meloscene.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}, {"id": "1228796255027646"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER", "CO_OP"], "id": "26975597188746800"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473393333_1286588652438985_2477324980059955777_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nMvpWoDtwDQQ7kNvwEnfh-2&_nc_oc=Ado7n_8RnuLTuf_t5VeU2E2hB9CuGPpXbYTGEPqnl76sbqGKg6tlJ_J0KzwEr-3dWRI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=
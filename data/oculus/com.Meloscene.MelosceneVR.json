vPpECgjII4cw30ANDw&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM8b_shmfPQm8Z04dNzV-QcICHRo-On_FmIAx0yRdBnKA&oe=6AE21F0B"}, {"file_name": "MeloMetaScreenshot5.png", "id": "1184104986458774", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473392168_1184104989792107_3756437261463344322_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bvn0pRkv6uAQ7kNvwEgSutn&_nc_oc=AdoRw2WSGoKNKmScm-zczct-o7OAsRBxlxnAxDB74vSwAuXXZYkqLc2gXcJfmn7S3Kg&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOgzQodPTUrKolF1yV4Wsg2UWzbqh5XuyFrhH_EsacosA&oe=6AE21DA0"}, {"file_name": "MeloMetaScreenshot6.png", "id": "9315925118492534", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473392105_9315925121825867_5361183675003147967_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_RG6V0SkpdcQ7kNvwEI-6xN&_nc_oc=Adp7zB-HmbrlX6J9q28KiIj_rb8oDAUBiexjmOMOM3bfrBiwg7gKEjDJ7h2RVsyzI1o&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOUmJbTvdstQvxbYfZ8lemAvpaFUIECEiPPxQWBf-ZnRA&oe=6AE1EFF0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "MeloMetaThumbnail.png", "id": "598197749878350", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473391935_598197753211683_4915318247077516530_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TIUm5yBH-dcQ7kNvwFrL3Ud&_nc_oc=AdrHNySeDU6gxYzm1k_5FXG8yQ58Eu0UlsEEY-CXW28ntnjVrioeDOrTM4Pf6WSaWno&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMg2tXW3oPzZMEEouNggkzihRma9OxZhLT2cv8z9RapiQ&oe=6AE1EAED"}, "display_name": "Meloscene Beta", "keywords": ["Collaboration", "Music", "Creative", "Studio", "chat"], "long_description": "Escape the algorithm-driven internet and step into Meloscene, the VR space where real creatives connect. No endless scrolling, no distractions, just artists, musicians, designers, podcasters, and fans collaborating in real time.\n\nCreators can use the free Meloscene Portal Software (Mac download at www.meloscene.com, Windows coming soon!) to integrate their PC, DAWs, editing tools, and creative software into VR. Work across any platform, sync files seamlessly, and collaborate live.\n\nFans and community members can experience creativity in real time, hang out in live sessions, connect with artists, and be part of something real.\n\nTo get started, download Meloscene onto your headset to enter the creative space. Install the Meloscene Portal Software on your computer to bring your favorite tools into VR. Then, step into a world where collaboration and creativity come to life.\n\nMeloscene isn\u2019t an algorithm deciding what you see. It\u2019s real people, creating together.", "short_description": "Early Access Presale \u2014 Save 20%!\nEscape algorithm-driven feeds and step into a space where creativity and community thrive. Whether you're a musician, artist, podcaster, or designer, Meloscene brings people together in real time. Connect your tools: Download the free Meloscene Portal (Mac at www.meloscene.com, Windows soon!) to integrate your PC, DAW, or creative software into VR. Sync files and collaborate effortlessly!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.meloscene.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Meloscene", "support_website_url": "http://www.meloscene.com/faq", "website_url": "http://www.meloscene.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}, {"id": "1228796255027646"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["SITTING", "ST
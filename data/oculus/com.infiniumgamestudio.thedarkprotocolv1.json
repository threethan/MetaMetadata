70cw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af84v6h-huk3VWUm217wkTQX6bRWIu0u_8R6Z4mSj0HXlg&oe=6A2D5DA5"}, {"file_name": "Gameplay3.png", "id": "1562720265084001", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499307339_1562720268417334_2860845392664928493_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kqb-tK4i8dcQ7kNvwHfqLuF&_nc_oc=AdrMIrKVOu3fKfXvmLy0-Lsf-jmBcFMWadB6i1v8Y80PMzVwth_yn9XsyBTP-qFFAv8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8xo-Lg7CBDHHoMk2LsLEWv7ssVRVtDmSS0tTbWDWjQ2g&oe=6A2D760D"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "The Dark Protocol", "keywords": ["horror", "scifi", "space", "dark", "monster"], "long_description": "The Dark Protocol is a sci-fi horror experience that throws players into the abandoned halls of a mysterious space station. In this world of darkness, only the faint outlines of rooms and corridors can be seen, forcing you to rely on your instincts and limited vision to survive.\n\nAs you explore, you\u2019ll uncover fragments of the story through scattered notes, recordings, and environmental details. Each clue brings you closer to understanding the fate of the station and the horrific experiment that has been unleashed.\n\nThe main challenge lies not only in solving puzzles and finding the right keys to progress, but also in staying hidden from the creature that relentlessly hunts you. Every sound, every movement, and every decision can mean the difference between survival and death.\n\nKey Features:\n\n    Atmospheric sci-fi horror with unique visual style.\n\n    Exploration of a large, interconnected space station.\n\n    Collect items, notes, and tools to piece together the story.\n\n    Solve environmental puzzles and unlock new areas.\n\n    Stealth-based survival \u2014 avoid the creature that stalks the corridors.\n\n    A tense, immersive experience designed to keep you on edge.", "short_description": "A sci-fi horror game set in a dark space station where only outlines of rooms are visible. Explore eerie corridors, collect items, read notes, solve puzzles, and avoid the terrifying creature lurking in the shadows. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://gist.github.com/feynyney/1cff9ddddb74bc0b56deb8eda3eeaf46", "developer_terms_of_service_url": null, "publisher_name": "Infinium Game Studio", "support_website_url": null, "website_url": "https://infiniumgamestudio.net/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "644354873106712"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24885239794430259"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491819356_1164926138937818_3423552582217390395_n.png?stp=dst-png_s360x360&_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xgP5wPwhrXoQ7kNvwHM6qiP&_nc_oc=AdrU3ucsc4KOtKSeKPkVvqHppeFBBOcBl8rQbw25kUCTFoJ0nHF4UQOMtYnMHiLXK5U&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9pO2defVKjjorRlAqd98q_qqA6tyrP_3jXxq9N5rLclA&oe=6A2D48D1"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "The Dark Protocol", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Adventure", "id": "2691890164460465"}, {"topic_name": "Survival", "id": "644354873106712"}], "release_date": 176278
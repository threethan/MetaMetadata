fference between survival and death.\n\nKey Features:\n\n    Atmospheric sci-fi horror with unique visual style.\n\n    Exploration of a large, interconnected space station.\n\n    Collect items, notes, and tools to piece together the story.\n\n    Solve environmental puzzles and unlock new areas.\n\n    Stealth-based survival \u2014 avoid the creature that stalks the corridors.\n\n    A tense, immersive experience designed to keep you on edge.", "short_description": "A sci-fi horror game set in a dark space station where only outlines of rooms are visible. Explore eerie corridors, collect items, read notes, solve puzzles, and avoid the terrifying creature lurking in the shadows. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://gist.github.com/feynyney/1cff9ddddb74bc0b56deb8eda3eeaf46", "developer_terms_of_service_url": null, "publisher_name": "Infinium Game Studio", "support_website_url": null, "website_url": "https://infiniumgamestudio.net/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "644354873106712"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24885239794430259"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1596134731752173"}]}, "baseline_offer": {"id": "1596134731752173"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1762780200, "status": "PUBLISHED", "id": "1596134731752173"}]}, "liveChannel": {"nodes": [{"latest_supported_binary
iaLyUhtz2CDEk24zpN3WhYPblM1RPN0q2PtySg&oe=6B0C57DC"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "ZergSwarms", "keywords": ["Swarm", "Alien", "zerg", "defend"], "long_description": "In this VR Swarm Defense action game, you stand atop a lone defense platform, facing relentless waves of monstrous insects. The swarms surges forward wave after wave, determined to tear down the platform beneath your feet. To survive, you must wield your weapons with precision and fight back against the horde.\n\nThe battle intensifies across 12 increasingly challenging waves, each deadlier than the last, until you face the ultimate showdown with the terrifying Swarms Boss. Only by defeating this final enemy can you claim true victory.\n\nWith its fast-paced rhythm, immersive VR perspective, and escalating tension, this game throws you straight into the chaos of survival against the swarms. Ready your weapons\u2014your fate rests on this final stand!", "short_description": "Defend your platform against endless insect swarms! Survive 12 waves and defeat the final Boss to claim victory."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.freeprivacypolicy.com/live/0459e58c-dfc4-4bb7-ad48-b1a88b8e5250", "developer_terms_of_service_url": null, "publisher_name": "Unity", "support_website_url": null, "website_url": "http://game.lvcn.net/ZergSwarm/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "644354873106712"}, {"id": "459781504968480"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD"], "supported_player_modes"
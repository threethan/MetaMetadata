GZmD5zOAKMXfVpiM&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1f6eV9TJ-Ms_Sk40C8DlUN7suqddR-fFUghSAa3TasKA&oe=69E62F4F"}, {"file_name": "Screenshot 2025-10-02 061209.png", "id": "1196088832568995", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/491827786_1196088835902328_9110910128638544780_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3qbC8NoRbb0Q7kNvwHe2NQR&_nc_oc=AdrBuRPTgOWDknmqUvCwVbrdHxeDIF1WvOhYjyWKg4vRrYORNcYBTerG6X1TQIcxt9E&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af30VWA5G2PrTkojazsq9WghLUlBML1uXwjarq8v9NomQQ&oe=69E62C7B"}, {"file_name": "Screenshot 2025-10-02 060536.png", "id": "1165858698725381", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/499619374_1165858702058714_7587112648470391540_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lVtaT0tvqhMQ7kNvwGNyEzI&_nc_oc=AdoxTnPbjZj6em2I_7uy0_IVsm1Y6QEpMqCPA11Bc6mm03lT8qoi1UxiJIJayTmFT08&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1P_A_REIZE5-OQjbCHqJT8bXLSq29o1-C4ay5v27vE7A&oe=69E63F65"}, {"file_name": "Screenshot 2025-10-02 060850.png", "id": "1103453315239240", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/499617754_1103453318572573_3519247001748030138_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8NWDUQYcPXIQ7kNvwFseMHC&_nc_oc=AdqZGJNFrfdcBqEszljyYAKuJlgvhnOfX2Ne4Z-afAgI-BqI-N6J2KjT5wp_zMIC8zM&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1GtXbZGnYNLpmBHwhQbvzJMIZIBNqpI1vQCWfBA8j-nA&oe=69E6211C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "ZergSwarms", "keywords": ["Swarm", "Alien", "zerg", "defend"], "long_description": "In this VR Swarm Defense action game, you stand atop a lone defense platform, facing relentless waves of monstrous insects. The swarms surges forward wave after wave, determined to tear down the platform beneath your feet. To survive, you must wield your weapons with precision and fight back against the horde.\n\nThe battle intensifies across 12 increasingly challenging waves, each deadlier than the last, until you face the ultimate showdown with the terrifying Swarms Boss. Only by defeating this final enemy can you claim true victory.\n\nWith its fast-paced rhythm, immersive VR perspective, and escalating tension, this game throws you straight into the chaos of survival against the swarms. Ready your weapons\u2014your fate rests on this final stand!", "short_description": "Defend your platform against endless insect swarms! Survive 12 waves and defeat the final Boss to claim victory."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.freeprivacypolicy.com/live/0459e58c-dfc4-4bb7-ad48-b1a88b8e5250", "developer_terms_of_service_url": null, "publisher_name": "Unity", "support_website_url": null, "website_url": "http://game.lvcn.net/ZergSwarm/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "644354873106712"}, {"id": "459781504968480"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD"], "supported_player_modes": ["ROOM_SCALE", "STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25135590216059424"}}]}, "scheduled_offers": {"count": 3, "nodes": [{"status": "PUBLISHED", "id": "1888539595369377"}, {"status": "PUBLISHED", "id": "1320517533108040"}, {"status": "PUBLISHED", "id": "1343330824168304"}]}, "baseline_offer": {"id": "1888539595369377"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1766980680, "status": "PUBLISHED", "id": "1888539595369377"}]}, "liveChannel": {"nod
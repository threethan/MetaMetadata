HJ2vxaKezccmzbAH5KgsqgaQ&oe=69A4444F"}, {"file_name": "Screenshot 2025-10-02 061209.png", "id": "1196088832568995", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491827786_1196088835902328_9110910128638544780_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C8f7X4TWwukQ7kNvwE6fbAQ&_nc_oc=AdlHQESh4lUqP2ADFwL8fKB3XUU-TGq3areQvlrJD0Z4PzpJL2X-IPtH9n_YaOw3h4s&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_Afsl6m5YfjhYmxVk43P_ND7CwqSX2o26i8kG0in22kv8fA&oe=69A4417B"}, {"file_name": "Screenshot 2025-10-02 060536.png", "id": "1165858698725381", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499619374_1165858702058714_7587112648470391540_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LEdiQmJI6xoQ7kNvwEmcuA1&_nc_oc=Adligm02BTRFTx0awJpETZJ6XKdRq6CbM_b5mPtkg8diJQ-OSr8S-89xdchJ4cec3a8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_AftGIeuvd_qcXh2HOy3WX-uraQuZI-S9wECtxlldXgpAQw&oe=69A41C25"}, {"file_name": "Screenshot 2025-10-02 060850.png", "id": "1103453315239240", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499617754_1103453318572573_3519247001748030138_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BaU03bKywvMQ7kNvwG_QOoT&_nc_oc=AdkxgWBprXJLk_gHz8OLflgxmIs_-kAUbzNhGVNOwH4XzsSAb-D3czeQf1XzpJk7Nyo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_Afs1YeYjC3bWVqMSKazG4nQ8Jq7elncNWiChS8M5KYW-Xw&oe=69A4361C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "ZergSwarms", "keywords": ["Swarm", "Alien", "zerg", "defend"], "long_description": "In this VR Swarm Defense action game, you stand atop a lone defense platform, facing relentless waves of monstrous insects. The swarms surges forward wave after wave, determined to tear down the platform beneath your feet. To survive, you must wield your weapons with precision and fight back against the horde.\n\nThe battle intensifies across 12 increasingly challenging waves, each deadlier than the last, until you face the ultimate showdown with the terrifying Swarms Boss. Only by defeating this final enemy can you claim true victory.\n\nWith its fast-paced rhythm, immersive VR perspective, and escalating tension, this game throws you straight into the chaos of survival against the swarms. Ready your weapons\u2014your fate rests on this final stand!", "short_description": "Defend your platform against endless insect swarms! Survive 12 waves and defeat the final Boss to claim victory."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.freeprivacypolicy.com/live/0459e58c-dfc4-4bb7-ad48-b1a88b8e5250", "developer_terms_of_service_url": null, "publisher_name": "Unity", "support_website_url": null, "website_url": "http://game.lvcn.net/ZergSwarm/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "644354873106712"}, {"id": "459781504968480"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD"], "supported_player_modes": ["ROOM_SCALE", "STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25135590216059424"}}]}, "scheduled_offers": {"count": 3, "nodes": [{"status": "PUBLISHED", "id": "1888539595369377"}, {"status": "PUBLISHED", "id": "1320517533108040"}, {"status": "PUBLISHED", "id": "1343330824168304"}]}, "baseline_offer": {"id": "1888539595369377"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1766980680, "status": "PUBLISHED", "id": "1888539595369377"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "25135971672687945", "version": "
&_nc_ohc=4lQCVHiqSSIQ7kNvwHIlKKn&_nc_oc=AdkEYhtqtkP_V48f12WdhHYbEoxzC1FHV8lpiGsbZmx4PVoGNWyTuOHUEWft3rs-Zgc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_Afy0cTlZvAz3sbkLgJnG6Kh4VeXEEiL_agm95rW6IX3xfQ&oe=69BFE6EF"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Deepak Chopra Finding Your True Self", "keywords": ["meditation", "deepak", "chopra"], "long_description": "Relax and journey on an enlightening virtual reality meditation simulation with philosopher, physician and bestselling author Deepak Chopra as he explores the role of VR in the future of wellbeing and the true nature of reality. The experience also features evocative works by acclaimed artist Abhishek Singh and an ambient score by award winning composer Brian Riordan. Directed by Gotham Chopra and produced by Wevr. Good headphones recommended.\n\n\nIn addition to the meditation experience, there is a highly informative lecture by Deepak from his personal office, where he discusses the spiritual and scientific nature of meditation and its many healing benefits.\n", "short_description": "Relax and journey on an enlightening virtual reality meditation simulation with philosopher, physician and bestselling author Deepak Chopra as he explores the role of VR in the future of wellbeing and the true nature of reality. The experience also features evocative works by acclaimed artist Abhishek Singh and an ambient score by award winning composer Brian Riordan. Directed by Gotham Chopra and produced by Wevr. Good headphones recommended."}]}, "developer_name": null, "developer_privacy_policy_url": "https://transport.wevr.com/p/privacy", "developer_terms_of_service_url": "https://transport.wevr.com/p/subscriberagreement", "publisher_name": "Wevr Inc.", "support_website_url": null, "website_url": "http://www.wevr.com/chopra", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription
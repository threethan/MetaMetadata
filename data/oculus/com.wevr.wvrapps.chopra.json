KFmYSc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTyFDP7JKqYmWVXbLH9zC3ar3CDToA-kRIjYYxLjwDtXQ&oe=6B0DA36E"}, {"file_name": "migrated_image.png", "id": "493465587991779", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12727791_177982232636640_341721144_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cd63_xee5cIQ7kNvwEp0nIh&_nc_oc=AdrbeSlP6rywNigIsRIwyDCW4ULsFhcj06g_0WFWdk5BZNUT5BEy5UwVbrbZYJRcTRo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRknYKthYJw7T7-mL09b-0G2roK6Zn0neVaJSGmsLC5wg&oe=6B0DAAAF"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Deepak Chopra Finding Your True Self", "keywords": ["meditation", "deepak", "chopra"], "long_description": "Relax and journey on an enlightening virtual reality meditation simulation with philosopher, physician and bestselling author Deepak Chopra as he explores the role of VR in the future of wellbeing and the true nature of reality. The experience also features evocative works by acclaimed artist Abhishek Singh and an ambient score by award winning composer Brian Riordan. Directed by Gotham Chopra and produced by Wevr. Good headphones recommended.\n\n\nIn addition to the meditation experience, there is a highly informative lecture by Deepak from his personal office, where he discusses the spiritual and scientific nature of meditation and its many healing benefits.\n", "short_description": "Relax and journey on an enlightening virtual reality meditation simulation with philosopher, physician and bestselling author Deepak Chopra as he explores the role of VR in the future of wellbeing and the true nature of reality. The experience also features evocative works by acclaimed artist Abhishek Singh and an ambient score by award winning composer Brian Riordan. Directed by Gotham Chopra and produced by Wevr. Good headphones recommended."}]}, "developer_name": null, "developer_privacy_policy_url": "https://transport.wevr.com/p/privacy", "developer_terms_of_service_url": "https://transport.wevr.com/p/subscriberagreement", "publisher_name": "Wevr Inc.", "support_website_url": null, "website_url": "http://www.wevr.com/chopra", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["RELAXATION_MEDITATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "613312383104803"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/11162696_646694095508213_887170310_n.png?stp=dst-png_s360x360&_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3DD1vMu11UkQ7kNvwGhyTIF&_nc_oc=Adpfh4sl27zM5PEViuNqqIVId1Um46Of2NpGYep3NIY515AYPmHA9NqDO4AjWFLeW8Y&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSx0lJpvGqCotx_dySbBKsXWVkpgjFUvW46HzmlINTkVQ&oe=6B0DAE54"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Deepak Chopra Finding Your True Self", "platform": "ANDROID", "context_category": null, "context_topics": [], "release_date": 1482220800, "lastRevision": {"nodes": [{"id": "1184237874979561", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "1148894061844063", "is_first_party": false, "enables_in_app_ads": false, "is_concept": false, "platform": "ANDROID"}, "iarc_cert": null, "iarc_email": null, "msrp": null, "translations": {"nodes": [{"images": {"nodes": [{"file_name": "migrated_image.png", "id": "3913776725329199", "image_type": "APP_IMG_LOGO_TRANSPARENT", "ur
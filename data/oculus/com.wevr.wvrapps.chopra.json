.com/p/privacy", "developer_terms_of_service_url": "https://transport.wevr.com/p/subscriberagreement", "publisher_name": "Wevr Inc.", "support_website_url": null, "website_url": "http://www.wevr.com/chopra", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["RELAXATION_MEDITATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "613312383104803"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/11162696_646694095508213_887170310_n.png?stp=dst-png_s360x360&_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ocaaZEr6eDUQ7kNvwGBm6Ps&_nc_oc=Ado2uFzXzkGs15oBPAkhAAHw9qKyr3ZS7WPpYJANsQnZ_nKU3gCpgdjHJ7hpx3wrjK4&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQR95LD8T9SCuzzxWHbrHjeenRoGblZM2tWzCKzPBKe8tA&oe=6B0B4394"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Deepak Chopra Finding Your True Self", "platform": "ANDROID", "context_category": null, "context_topics": [], "release_date": 1482220800, "lastRevision": {"nodes": [{"id": "1184237874979561", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "1148894061844063", "is_first_party": false, "enables_in_app_ads": false, "is_concept": false, "platform": "ANDROID"}, "iarc_cert": null, "iarc_email": null, "msrp": null, "translations": {"nodes": [{"images": {"nodes": [{"file_name": "migrated_image.png", "id": "3913776725329199", "image_type": "APP_IMG_LOGO_TRANSPARENT", "ur
"03-reading-page.png", "id": "1040455322197159", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/499626728_1040455325530492_7572570210693390064_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=guvpnIy9iPgQ7kNvwHf9DFb&_nc_oc=Adpdm5nclOR4OOyl_VttuLQ09Yv-9FxgJriq6vZQRNoSkP0dm-do1cZ-fuwWUkoJU4I&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTpDOt_L1ylRGP_9FAqxixRdsEiYobtLImxLdOaQbbdgQ&oe=6B085F8A"}, {"file_name": "02-bookshelf.png", "id": "2135516877087478", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499619059_2135516880420811_3896521613558368632_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ecsQAjwQXZEQ7kNvwHSuyfV&_nc_oc=Adr6Z-JlYqIyHfYFTiWdqPIseRewotafXLHdUjzSkXFuOxv6WStm4CF8JYS_bZuim_Y&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQK-ZMvT6RmjS_0z9tktMGGqGoaXgF0cYA7gfgB8iacZw&oe=6B0843B6"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "PageGrove", "keywords": ["EPUB", "reading", "books", "library", "relaxation"], "long_description": "PageGrove is a private immersive EPUB reader built for quieter reading on Meta Quest.\n\nBring your own EPUBs, choose a real-world 360\u00b0 setting, and settle in with a comfortable two-page book, adjustable text size, lighting presets, and an original synthesized soundscape.\n\n\u2022 Read in the Hohnstein forest or at the SCUT Library atrium\n\u2022 Turn pages using direct touch or either controller\n\u2022 Adjust text size, chapter, lighting, music, and ambient sound\n\u2022 Return to your bookshelf and settings at any time\n\u2022 Keep imported books, progress, and preferences on your device\n\nNo account, ads, analytics, tracking, or cloud book uploads. PageGrove does not use Meta social features, voice, avatars, spatial anchors, eye tracking, or in-app purchases.\n\nBest experienced while seated.", "short_description": "Read EPUBs in calm, immersive real-world spaces. PageGrove keeps your books and reading progress on your device, with hand and controller input, adjustable text, lighting, and an original offline soundscape."}]}, "developer_name": null, "developer_privacy_policy_url": "https://pagegrove-t2wcj.ondigitalocean.app/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Eallisto", "support_website_url": "https://pagegrove-t2wcj.ondigitalocean.app/support.html", "website_url": "https://pagegrove-t2wcj.ondigitalocean.app/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}, {"id": "393222478507326"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1115455391347009"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/499622186_1741293703773156_8142222782666511912_n.png?stp=dst-png_s360x360&_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=81ThWjys2XMQ7kNvwGaWUNp&_nc_oc=AdrVKmIzuQHuSD3AYmJP-g0jtP6iF4wUbrUQ2Uv_WlNjViHqzkCLgqXj1IpjxUS-HuU&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ1xu3g6v1-gws878cJhOZyGWTJ1iA6bjs9VVfoyMj6UQ&oe=6B084C40"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "PageGrove", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_name": "Media", "id": "434961926215971"}, {"topic_name": "Utilities", "id": "3
2 Turn pages using direct touch or either controller\n\u2022 Adjust text size, chapter, lighting, music, and ambient sound\n\u2022 Return to your bookshelf and settings at any time\n\u2022 Keep imported books, progress, and preferences on your device\n\nNo account, ads, analytics, tracking, or cloud book uploads. PageGrove does not use Meta social features, voice, avatars, spatial anchors, eye tracking, or in-app purchases.\n\nBest experienced while seated.", "short_description": "Read EPUBs in calm, immersive real-world spaces. PageGrove keeps your books and reading progress on your device, with hand and controller input, adjustable text, lighting, and an original offline soundscape."}]}, "developer_name": null, "developer_privacy_policy_url": "https://pagegrove-t2wcj.ondigitalocean.app/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Eallisto", "support_website_url": "https://pagegrove-t2wcj.ondigitalocean.app/support.html", "website_url": "https://pagegrove-t2wcj.ondigitalocean.app/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}, {"id": "393222478507326"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1115455391347009"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1387272256164515"}]}, "baseline_offer": {"id": "1387272256164515"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1788888660, "status": "PUBLISHE
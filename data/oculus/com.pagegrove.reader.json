eeps your books and reading progress on your device, with hand and controller input, adjustable text, lighting, and an original offline soundscape."}]}, "developer_name": null, "developer_privacy_policy_url": "https://pagegrove-t2wcj.ondigitalocean.app/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Eallisto", "support_website_url": "https://pagegrove-t2wcj.ondigitalocean.app/support.html", "website_url": "https://pagegrove-t2wcj.ondigitalocean.app/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}, {"id": "393222478507326"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1115455391347009"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1387272256164515"}]}, "baseline_offer": {"id": "1387272256164515"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1788888660, "status": "PUBLISHED", "id": "1387272256164515"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1116544621238086", "version": "4"}, "id": "1431907562169243", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1112156818343533", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id":
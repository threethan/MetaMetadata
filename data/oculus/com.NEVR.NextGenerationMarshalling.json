3-1.oculuscdn.com/v/t64.5771-25/491823445_1514513702890069_2979042424108725733_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0VX07uLPG-EQ7kNvwGQSEmY&_nc_oc=AdpVlasP2oq_6SFGl4cHmgMa-e-lAc0k1Qz5RXQZlRVnQllCS3SEY3vc78wIJBteVnM&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMhHzZF-fqLmorr-ASYbM549MHm20hOI_2R-pczuJatqw&oe=6ACF92BE"}, {"file_name": "13.png", "id": "823225783498441", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491820619_823225786831774_1550970093237405818_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lxGOB_-lbdQQ7kNvwEWaZWi&_nc_oc=Adp1b9hmO9o9kvr_ENGkTIHLLm2s2_ffYACsrS3VO2IGmqTu-nN0fYVHmO3wIKLFZFU&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNqnrSzBzsTBtS4JiwdgnJBPZNEL32pt1qTGQYxSHiYjg&oe=6ACF8DC5"}, {"file_name": "14.png", "id": "1277696777441112", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491820980_1277696780774445_7114369882097519010_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U4Zhb2w3t2IQ7kNvwGDuq1j&_nc_oc=AdpekRV44xCKjGR7TgVKAWvWGvxqJ5GPh4oJIOyTT-tbklnCWuVsSe0c9n5KfrAy2Ac&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN5qeTHeoT5O6-L1LRAVH2w6bhU-ro43NhVa3rh_jkcKw&oe=6ACF8DE2"}, {"file_name": "15.png", "id": "1330520558463082", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491818916_1330520565129748_6604485050286972746_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1Wy_jqblW_4Q7kNvwGwL6Hc&_nc_oc=AdpTL31SPUgOIfVYTMSIulmwIr51bNlK6votbTTL4jtdjaYmnmk9c572YpDCm-H_hVk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMShHuQ9LKKdehuFWHehpZmDRhmrm94hI1hDUGOo374lA&oe=6ACFB770"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_Cover 2560 x 1440.png", "id": "1200390952072688", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499303198_1200390955406021_6737984585865312680_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TkSkKKekvSMQ7kNvwEMAr6_&_nc_oc=AdpDrA8ktfMkR4YsPau1wPAm6FxjThPGkeGHieN1YrZJWKiPj0FskQ8FaSaQ55dzV6I&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMDIK7yMWbyZJEi-A_BiqLlsQJiSgLnog0ZjYcaSTABbw&oe=6ACFACAC"}, "display_name": "Ramp Simulator: Aircraft Marshalling", "keywords": [], "long_description": "Ramp Simulator: Aircraft Marshalling\n\nThe most effective VR training tool for airport ramp agents & ground personnel!\n\nOn the busy airport apron, precise signals are essential for guiding aircraft safely & efficiently. This app delivers professional-grade aircraft marshalling training in a fully immersive, risk-free virtual environment.\n\nCore Features\n\nIATA Signal Library \u2014 Master every standard signal used worldwide (based on IATA standards), including \"Approach,\" \"Turn Left/Right,\" \"Stop,\" \"Set Brakes,\" \"Chocks In/Out,\" \"Start Engines,\" \"Cut Engines,\" emergency stops, and more.\n\nAdvanced Body-Tracked Practice \u2014 Using Quest's body tracking, perform the signals yourself. Get real-time scoring and detailed feedback on posture, and correctness.\n\nStructured Learning Path \u2014 Begin with guided tutorials, progress through practice modes.  COMING SOON: tackle timed challenges, and randomized scenarios to develop muscle memory and confidence.\n\nRealistic Ramp Scenarios \u2014 COMING SOON: Stand on a lifelike virtual apron with different aircraft types, day/night lighting, and variable weather conditions.\n\nPerfect For \u2014 New ramp agents, recurrent/annual training, aviation academies, ground handling companies, & anyone preparing for airside ops.\n\nNo aircraft, no fuel, no risk \u2014 just powerful, repeatable, engaging training that improves safety & performance.\n\nDownload Ramp Simulator: Aircraft Marshalling today & become ramp-ready faster than ever!", "short_description": "Master professional aircraft marshalling in immersive VR! Learn IATA standard signals, then use Quest's body tracking to practice signals yourself and receive instant accuracy scoring. Perfect for ramp agents, ground handlers, aviation students & training departments. \n\nSafe, Realistic, Repeatable"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.netedgevr.com/privacy-policy", "developer_terms_of_service_url": "https://www.netedgevr.com/terms", "publisher_name": "Net Edge VR", "support_website_url": "https://www.netedgevr.com/contact", "website_url": "https://www.netedgevr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}, {"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9773074556104934"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491819407_1535411754248941_2770973552260542788_n.png?stp=dst-png_s360x360&_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HmFX3iLBGT8Q7kNvwF-hyMK&_nc_oc=Adqa58ekhQH3m1btk0qKPCcL67A9IAgR0lyGh0GJfAfLBoqawRk65Nd1HwQahShp4JE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM5dl_OQ7FUi3FL_IukwnWWaBSPsd1gBea4kd52MjVOPA&oe=6ACF9B80"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Ramp Simulator: Aircraft Marshalling", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_name": "Learning", "id": "1043107547362485"}, {"topic_name": "Hands-On Training", "id": "514087707868786"}], "release_date": 1772036220, "lastRevision": {"nodes": [{"id": "9773074589438264", "
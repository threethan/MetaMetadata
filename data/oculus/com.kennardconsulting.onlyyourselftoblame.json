edback, add the remaining campaign levels, and implement a random level generator for replayability.", "short_description": "Only Yourself To Blame is a time paradox-inducing action puzzle game, where you must deceive and battle past versions of yourself in a race to prevent nuclear annihilation.\n\nUse pistols, machine guns, grenades, tripwires and melee weapons to combat turrets, drones and other hazards. But most of all to combat yourself!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.kennardconsulting.com/privacy-oytb.ui", "developer_terms_of_service_url": null, "publisher_name": "Kennard Consulting", "support_website_url": null, "website_url": "https://www.kennardconsulting.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1008279844328894"}, {"id": "377978390272490"}, {"id": "459781504968480"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "41073214965610891"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499619382_1536384155209892_3289854421727144372_n.png?stp=dst-png_s360x360&_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XxmD2FNris4Q7kNvwGbZBAc&_nc_oc=Adou01d26qJYy7kN0OviJRGkZxOvVlk1EwokCNhsZsrRBtModcrChHI4pZgwIRgHHxY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRUSfe8SmZBNfhg9kuKlbtzZ8_Zd6NbZcHFWibjXgnJdA&oe=6B05CA0E"}, "is_concept": false, 
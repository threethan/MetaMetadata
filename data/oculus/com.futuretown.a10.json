 all skill levels! Fit with both global and local leaderboards."}]}, "developer_name": "Futuretown", "developer_privacy_policy_url": "http://futuretown.io/index.php/privacy-policy", "developer_terms_of_service_url": "http://futuretown.io/tos", "publisher_name": "Futuretown", "support_website_url": null, "website_url": "http://futuretown.io/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ARCADE", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "311383937672051"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12410493_137905436986382_2178015952031973376_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MGYfexoF0swQ7kNvwEpJW-L&_nc_oc=AdlFqxpLpGyEE3PPKe8KEC-hQ2m-1ElAME-45v-c3jD1La6uty4khuKHk4QcAz39b3s&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfyW_rf4f0DclOxu61Mg0bUNMwH0PxRjU8fxTPHNMEcIdA&oe=69AD5C8F"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "A-10 VR", "platform": "ANDROID", "context_category": null, "context_topics": [], "release_date": 1513274700, "lastRevision": {"nodes": [{"id": "1489934877729120", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "1542475959125207", "is_first_party": false, "enables_in_app_ads": false, "is_concept": false, "platform": "ANDROID"}, "iarc_cert": {"id": "1137065529761219"}, "iarc_email": null, "msrp": null, "translations": {"nodes": [{"images": {
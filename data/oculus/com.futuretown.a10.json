 against a stunning outer space landscape in this arcade shooter meant for all skill levels! Fit with both global and local leaderboards."}]}, "developer_name": "Futuretown", "developer_privacy_policy_url": "http://futuretown.io/index.php/privacy-policy", "developer_terms_of_service_url": "http://futuretown.io/tos", "publisher_name": "Futuretown", "support_website_url": null, "website_url": "http://futuretown.io/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ARCADE", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "311383937672051"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/12410493_137905436986382_2178015952031973376_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3zcAcluLjokQ7kNvwEA2-tU&_nc_oc=Adqznc8yEEwnRk2NLmvWAuUf4DqkketvFB3zlmdGiWVjUqSMOLc-4wj50_0KRnfCTSI&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGHat_F-4rT4OexmCAaQ8hgg7Qm7dbPMs66YKB2C_AjdA&oe=6A8ECD0F"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "A-10 VR", "platform": "ANDROID", "context_category": null, "context_topics": [], "release_date": 1513274700, "lastRevision": {"nodes": [{"id": "1489934877729120", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "1542475959125207", "is_first_party": false, "enables_in_app_ads": false, "is_concept": false, "platform": "ANDROID"}, "iarc_cert": {"id": "1137065529761
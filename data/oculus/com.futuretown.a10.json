 towards users trying VR for the first time, although sharp shooters will be able to spend hours mastering their gun play. Fit with both global and local leaderboards.", "short_description": "A-10 VR is a fresh virtual reality take on a classic sci-fi gallery shooter. Hone your sharp shooting skills in 4 game modes against a stunning outer space landscape in this arcade shooter meant for all skill levels! Fit with both global and local leaderboards."}]}, "developer_name": "Futuretown", "developer_privacy_policy_url": "http://futuretown.io/index.php/privacy-policy", "developer_terms_of_service_url": "http://futuretown.io/tos", "publisher_name": "Futuretown", "support_website_url": null, "website_url": "http://futuretown.io/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ARCADE", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "311383937672051"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/12410493_137905436986382_2178015952031973376_n.png?stp=dst-png_s360x360&_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Vu1_FTRj3g4Q7kNvwEaDI9F&_nc_oc=AdoBnT1UHbZ5IMab1po5-YpyJ_0QkOLgpYuMKBFgDd5uy59bw8SnzepO6v79lRux4ho&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR7yXNDvP8K_I1gYK2Yw6ST9iy21dWgXmeQYcw-ZiEjfQ&oe=6AFC71CF"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "A-10 VR", "platform": "ANDROID", "context_category": null, "context_topics": [], "release_date": 1513274700,
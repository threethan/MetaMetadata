-d-x7cl_YNk-MwYWlE27t3A&oe=6A105302"}, {"file_name": "Xmersive_Screenshot_4.png", "id": "888627597304113", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/499617831_888627600637446_3609494728857424231_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bX7ZuhN6ylUQ7kNvwGeOse0&_nc_oc=Adq7DKqLHWSz5V3GNkTw898e2uXGKM4rh9EgTvq-_XCCuuRmF6r9x3h2KEs-I9fV_cM&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7NmtUTMGOElq3DZkacvwr-Xw-KclOigai_NzvC63hH_g&oe=6A105620"}, {"file_name": "Xmersive_Screenshot_5.png", "id": "1462876322068962", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/491821849_1462876325402295_4954926223090039994_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6A1V65Q97rIQ7kNvwGDnb49&_nc_oc=Adp2ydECyIrx0O_8mAjeCvIsQJXteZRiuL_SyLmWX12ipxtVTV-kf8i7cF-qeKYLSBU&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4F4q3wYcCJyiPhrepk08bpzUnkctMdiY6twXlJa4RcUw&oe=6A107C2A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "vlcsnap-2026-03-02-17h07m54s799.png", "id": "1247796407301323", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/499620921_1247796410634656_950432509250027366_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qcNbPqZiVkAQ7kNvwF-_YNh&_nc_oc=AdoUkJxuXf446bzRLwm86PFHR2epntJmzbQt000jaujvE5kw98IQ6tye18nO_aQ7DjA&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5j5ym-BP5oSl0fyqwdNS9b85noPeZx3zSSXlYyNxaCTw&oe=6A107DA1"}, "display_name": "NEXST Xmersive", "keywords": ["UNIS", "KPOP", "Xmersive", "VRConcert", "8KVR"], "long_description": "Next-Generation VR Live Platform \u201cNEXST Xmersive\u201d\nNow Streaming: UNIS\nComing Soon: KISS OF LIFE\n\n\u201cNEXST Xmersive\u201d is more than live streaming\u2014it delivers a next-level VR concert experience. Real artists come alive through stunning 180-degree high-definition VR, captured in exceptional quality. Feel as if you are sharing the same space, closer than ever before.\n\nAs its first featured content, Xmersive presents a live performance by the global girl group \u201cUNIS.\u201d From home, enjoy an experience that surpasses even the very front row of a live venue.\n\nFeatures\n\n8K Ultra-High Resolution\nVisual clarity beyond industry standards.\n\nImmersive VR Live Experience\nMore than watching\u2014feel face-to-face with the artist, surrounded by breathtaking realism.\n\n180-Degree High-Definition VR Video\nHigh-quality visuals capture every movement and expression.\n\nWith premium ultra-high-resolution imaging, it feels as if the artist is singing and dancing right before you. Enjoy intimate performances where even eye contact feels real, delivering unmatched immersion and excitement.\n\nNew live content will be added continuously.\nExperience a special stage that appears right before your eyes\u2014only on Xmersive.\n\nContact\nFor more information, visit: xmersive.nexst.inc\nFollow Instagram: @nexst_official\nSend feedback to: contact@nexst.inc\n or X @NEXST_AI", "short_description": "Next-Generation VR Live Platform \u201cNEXST Xmersive\u201d\n\n\u201cNEXST Xmersive\u201d is more than live streaming\u2014it is a next-level VR concert experience. With stunning 180-degree high-definition VR, real artists feel truly present. Zero distance from the stage. Sense every glance, breath, and atmosphere as if you were there. From home, enjoy an experience beyond the front row. Xmersive takes live entertainment to the next dimension."}]}, "developer_name": null, "developer_privacy_policy_url": "https://xmersive.nexst.inc/xmersive-pp/", "developer_terms_of_service_url": "https://xmersive.nexst.inc/terms/", "publisher_name": "NEXST", "support_website_url": "https://xmersive.nexst.inc/", "website_url": "https://xmersive.nexst.inc/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "REQUIRED_FOR_
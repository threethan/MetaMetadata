8XwAuK-9w_P3XV1zEJIFuzw&oe=69FF2F82"}, {"file_name": "Xmersive_Screenshot_4.png", "id": "888627597304113", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499617831_888627600637446_3609494728857424231_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=awr6qAp4iroQ7kNvwEpRKqq&_nc_oc=Adrg9sMqe_OBLdM9qDbRV6X3Th4CWtmQA2zcSk-GvFdPVUJUXW7q5MT7g0F7SjsQNSE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6F1ClTETikxkv1batyJOCNccmGZ2oqHbMLGeY_Weafcw&oe=69FF32A0"}, {"file_name": "Xmersive_Screenshot_5.png", "id": "1462876322068962", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491821849_1462876325402295_4954926223090039994_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1AgZEMQgqgYQ7kNvwGvix6K&_nc_oc=AdqYPXMEgUIj64cpkZIXfq4RrbFERmFA3ssseJx8P-qb1K3hVag-uFUY9Z9gvKghK-I&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6Y779CMwMpQKbKPZRwYSq1BW0gO981eyH_QBDzjCCj2w&oe=69FF206A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "vlcsnap-2026-03-02-17h07m54s799.png", "id": "1247796407301323", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499620921_1247796410634656_950432509250027366_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E0INqRiUu_gQ7kNvwFViSy0&_nc_oc=AdpkMVr8xmsATpUQ0G_bdfGT0buLoqG7Cjd4eHlu1YacazSBKC8zG7vMTaqAj4g_K3E&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5l9fFcbDTlEkZLQsP5Pkbtqwpg8Ukc1Fwv8Z9LBkwplg&oe=69FF21E1"}, "display_name": "NEXST Xmersive", "keywords": ["UNIS", "KPOP", "Xmersive", "VRConcert", "8KVR"], "long_description": "Next-Generation VR Live Platform \u201cNEXST Xmersive\u201d\nNow Streaming: UNIS\nComing Soon: KISS OF LIFE\n\n\u201cNEXST Xmersive\u201d is more than live streaming\u2014it delivers a next-level VR concert experience. Real artists come alive through stunning 180-degree high-definition VR, captured in exceptional quality. Feel as if you are sharing the same space, closer than ever before.\n\nAs its first featured content, Xmersive presents a live performance by the global girl group \u201cUNIS.\u201d From home, enjoy an experience that surpasses even the very front row of a live venue.\n\nFeatures\n\n8K Ultra-High Resolution\nVisual clarity beyond industry standards.\n\nImmersive VR Live Experience\nMore than watching\u2014feel face-to-face with the artist, surrounded by breathtaking realism.\n\n180-Degree High-Definition VR Video\nHigh-quality visuals capture every movement and expression.\n\nWith premium ultra-high-resolution imaging, it feels as if the artist is singing and dancing right before you. Enjoy intimate performances where even eye contact feels real, delivering unmatched immersion and excitement.\n\nNew live content will be added continuously.\nExperience a special stage that appears right before your eyes\u2014only on Xmersive.\n\nContact\nFor more information, visit: xmersive.nexst.inc\nFollow Instagram: @nexst_official\nSend feedback to: contact@nexst.inc\n or X @NEXST_AI", "short_description": "Next-Generation VR Live Platform \u201cNEXST Xmersive\u201d\n\n\u201cNEXST Xmersive\u201d is more than live streaming\u2014it is a next-level VR concert experience. With stunning 180-degree high-definition VR, real artists feel truly present. Zero distance from the stage. Sense every glance, breath, and atmosphere as if you were there. From home, enjoy an experience beyond the front row. Xmersive takes live entertainment to the next dimension."}]}, "developer_name": null, "developer_privacy_policy_url": "https://xmersive.nexst.inc/xmersive-pp/", "developer_terms_of_service_url": "https://xmersive.nexst.inc/terms/", "publisher_name": "NEXST", "support_website_url": "https://xmersive.nexst.inc/", "website_url": "https://xmersive.nexst.inc/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "REQUIRED_FOR_
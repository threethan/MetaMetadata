rpJTudGxV5YYA&oe=6AEF545B"}, {"file_name": "resized_2560x1440_v2.png", "id": "1484731326155191", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/593809430_1484731329488524_578177507537121045_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lXFaK5zvkQEQ7kNvwF-dvIH&_nc_oc=AdqiDeA06be4tbIUXT8J9FanzUMYV6g6lm86qjixLQx9f0cycuVFwHDQFkNcHLZPfDQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQOM_s4Dpc9PRXb9g5HIaHXf1wjIO8BNzekn04H97AD0g&oe=6AEF4076"}, {"file_name": "resized_2560x1440 (1).png", "id": "1587051342779872", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/654877283_1587051346113205_7023164012758710371_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eeQVAMlV21IQ7kNvwGdHXqC&_nc_oc=AdojlszdXrFJ8RS7RI1RzPMs9S4IHDKdayyaxcbFNp188KGcMliCuoaUbo-cNLjW-iI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQuK6mxXyH26-m8eUxf8I13gNbdgXWiIjGoKAaYSdW1Zg&oe=6AEF3BAF"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Hazel Bouncers", "keywords": [], "long_description": "Welcome to a VR adventure where movement is everything. Using Gorilla Locomotion, you can swing, climb, jump, and explore a world full of unique locations, secrets, and challenges. Every area is designed to reward exploration and help you master your movement as you become faster and more skilled.\n\nCollect and unlock a variety of cosmetics to customize your gorilla and create your own style. As you continue exploring, you'll find new places to visit and more content to enjoy with each update.\n\nHorror Mode is coming soon and will introduce a darker experience with new environments, mysterious locations, eerie sounds, and exciting gameplay designed to test your skills. Whether you're exploring during the day or entering the horror experience, there will always be something new to discover.\n\nThe game is actively being updated with new maps, cosmetics, features, quality improvements, and future content. More surprises are planned, so keep playing and check back for every new update as the adventure continues to grow.", "short_description": "Swing, climb, and explore in a VR adventure powered by Gorilla Locomotion. Unlock cosmetics, discover new places, and improve your movement skills as you explore the world. Horror Mode is coming soon, with even more updates and content planned for the future.\n\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/hazel-privacy/accueil", "developer_terms_of_service_url": null, "publisher_name": "Fangameee", "support_website_url": null, "website_url": "https://sites.google.com/view/hazel-bouncers/accueil", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "MULTI_USER"], "id": "1247532691766540"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/507843239_1010598838109856_6750069397952272683_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zi_5wJlTm7MQ7kNvwFqxNO8&_nc_oc=AdrslSUPU1ARmTgcbQPNTKEEV7Yx2FVOt2aRqcys0zlTnaRLpvFMtilKbrmoko7mSsc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQLLiaYfyVb2swH0-EsDLZ702Yp6CXY-gDsberUURBgGA&oe=6AEF4475"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Hazel Bouncers", "platform": "ANDROID_6DOF", "context_category": {"context_
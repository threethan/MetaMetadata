ease_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "5999583346824513", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "6287200458062799"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": []}, "change_log": null, "created_date": 1687486800, "id": "6264867910296054", "version": "1.11", "version_code": 27, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "5999583346824513", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "6287200458062799"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "185484947609472"}]}, "change_log": "Patch 1.1\n\nItems \n* Added items which can be added to champions to provide bonus stats.\n* Adjusted tutorial to include item usage.\n* Added bonus rounds to earn items.\n* Added item usage to bots. \n\n\nAI Fixes\n* Fixed bug that prevented AI from purchasing 2-4 cost champions.\n* AI team compositions diversity significantly increased. \n\nGeneral Changes\n* Reduced spawn distance from northern side of the board to make both sides more consistent.\n* Champion star level now marked on their HP bars and item info.\n* Fixed Luna's walking animation freezing.\n* HP loss now increases as the game continues. \n\nBalance changes\n* Triple threat bonus reduced from 70% to 30%.\n* Increased Dusk tier 1 damage from 5 damage per second to 10 damage per second.\n* Increased Dusk tier 3 damage from 40 damage per second to 60 damage per second.\n* Jug Attack damage reduced from 40 to 30.\n* Finn base health increased from 700 to 800 .\n* Increased luna's Ability power ratio from 0.2--> 0.5.\n* Increased Infernum's Ability power ratio from 0.3-->0.6 on base damage.\n* Increased player start gold from 5 to 6.\n* Reduced first 3 preparation rounds from 30 seconds to 20 seconds. ", "created_date": 1687264246, "id": "6255066641276181", "version": "1.1", "version_code": 26, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}]}}, "viewer": {"user": null}}}
Pg&oe=6A22F57A"}, {"file_name": "screaf.png", "id": "1494225198746721", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/499298930_1494225202080054_4537922413629991019_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F-oXTeH30A4Q7kNvwHXea1e&_nc_oc=AdqEbyuvS6skK7aZGYSRKlUeMJjiZFEzsd4syTvPqm_fSDPKKtxn7nz-P_ZdJQX3p78&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9htZjtsbMCi46Kt2iMA3MICRvdIG9_7EfoqitQtcpJaA&oe=6A22EA1B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscapeart.png", "id": "1365690032116034", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/499298221_1365690035449367_7797476371268579076_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Mpg1yA4jfRsQ7kNvwESBuOi&_nc_oc=Adra_mQFx-Cwfwb6dAdROEYRv3Fthne3P7RLLzBVtkD-DrgveNJJiQsyoQOt8gQlILk&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8cuOxLpUm94y7Rl7jJ_1mNFTX88CvbI5uLNOBc70XjEA&oe=6A22E40F"}, "display_name": "Scale", "keywords": ["Climb", "Platformer", "Environment"], "long_description": "A game where you can climb almost anything, explore environments, and find all secrets.  This game is called \"Scale.\" The player's main objective is to become skilled enough to acquire all Nicoins and upgrades. Players traverse grand environments that each have their own challenges to ultimately open the grand door looming in the main menu.\n\nCurrently, Scale is a short game used primarily as a proof of concept, not intended to generate revenue, and purely for others to have fun with. There are 2 maps along with 2 short playgrounds in the main menu. While the game is quick to complete once you master its mechanics, it challenges the player's endurance to reach new areas. \n\nFinally, this is the first published game by Nicon Interactive. If you want to support a fresh game studio (with a lot of potential), look out for our social media on our website. Feel free to reach out if you have any questions!\n\nWe hope you enjoy!", "short_description": "Scale is a short adventurous platformer where you can climb almost anything. Explore the environment and upgrade your gloves to the max! Reach new heights, collect all Nicoins, and find out what's behind the door...\n\nThis is the first published game by Nicon Interactive. If you want to support a fresh game studio (with a lot of potential), look out for our social media!\n\nWe hope you enjoy!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.niconinteractive.com/scale-privacy", "developer_terms_of_service_url": null, "publisher_name": "Nicon Interactive", "support_website_url": null, "website_url": "https://www.niconinteractive.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "32998108826469631"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1313888436839887"}]}, "baseline_offer": {"id": "1313888436839887"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1779912000, "status": "PUBLISHED", "id": "1313888436839887"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "36292104270403387", "version": "0.1"}, "id": "1560567784958488", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary
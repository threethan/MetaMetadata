n.com&_nc_ss=7f20f&oh=00_AQB_AGHaFYvMSAW9xjw4KpIWEyZa4HwEjvBB-uQ4ggfH7Q&oe=6A60A65A"}, {"file_name": "Hold.png", "id": "4403178093251641", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491820496_4403178096584974_7820867634993186088_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DI1Jr-6qG6AQ7kNvwECzpxu&_nc_oc=AdpBI7Mh7LhVK85SHW9ekBBGeUj_r2_HFJjcjJOtxJYreWycsoB1qNDb5p7bqqLtjh8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCvG8Lt1CX5GbORHOVf1ydbmwczktcx0yyJyI-1QQKLpg&oe=6A60ABAA"}, {"file_name": "Venice_Level.png", "id": "2115805322489578", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491818852_2115805392489571_4232951214565542654_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BezseI-EdI8Q7kNvwEm4bOR&_nc_oc=AdrWNpVLE7Djv1miZ40nyv04oeTlbiwcZOxvnmPU6mz127fHL16FsdFbA884nJ42jvE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBCGJQ0VEZg2BFn1OVsnVmOuJWyDjgzIl25fqn3zzX_Rw&oe=6A60A86A"}, {"file_name": "Spy_Boat.png", "id": "1219441483730914", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491819982_1219441487064247_4606632052233237119_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dYj49r5ALvkQ7kNvwGe6qAc&_nc_oc=AdpgUSgPnkrPOJl-yy-1g8NHbZ9aLd7jeyaEAGTwLYTynJFNZkJjvuTB7b3xJQvSvho&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCWCXbWfEMmRElVrg5nuk6sINkneaIAHCwcoHBxtlHK_g&oe=6A60AB87"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Adobe Express - file.png", "id": "880012964941330", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491821696_880012968274663_4142236958427032935_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7RBxtYQU7aYQ7kNvwEX6fCL&_nc_oc=AdrzghCb3Y1Li6dhq4JGv2atJkJhHcR-gKZn_lAQUOoBTBU9t6GSO0qWFdLqhYt3RIM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCGDJC-GYwzvK61ahYYQ4FU6S3eDS0vG8FXYP4nuh0LEw&oe=6A60AA36"}, "display_name": "Spymaster", "keywords": ["spy", "master", "time", "physics"], "long_description": "Protocore threatens the world, and only the elite agents of NODE can stop this dangerous corporation's plans. Take on the roles of Agent Mulligan, TIC and OSCR to execute high-risk missions using their secret weapon, the C.A.S.S.E.T.T.E., becoming the ultimate **Spymaster!**\n\n\n\u200e\n\n\n**Rewind Time**\n\nManipulate time using the C.A.S.S.E.T.T.E., refining each step, each decision to conduct the perfect mission.\n\n{1968748060384564}\n\n\u200e\n\n**Unbroken Momentum**\n\nRun, climb, slide, zipline and shoot your way to safety.\n\n{934506685620409}\n\n\u200e\n\n**Become an Elite Agent**\n\n- Three Spies - Each with their own unique gameplay traits\n- Dynamic Missions - No two missions are alike, from defusing bombs to poisoning villains, each becomes more challenging, requiring a different approach \n- Varied Gameplay - Solve puzzles, shoot bad guys, infiltrate secure locations and jump into moving helicopters!\n\n\n\n\n\u200e\n\n**Early Access**\n\nSpymaster is in active development, refining its gameplay and continuing to expand its content throughout Early Access.", "short_description": "Infiltrate Protocore, a global corporation with plans that threaten the world. Command three agents with unique skills, manipulate time using the C.A.S.S.E.T.T.E., and combine action and puzzles in immersive VR missions to become a Spymaster !"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.termsfeed.com/live/1e06831f-b759-4751-9ca4-99cbf88c206b", "developer_terms_of_service_url": null, "publisher_name": "InnerspaceVR", "support_website_url": null, "website_url": "https://www.innerspacevr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "1008279844328894"}, {"id": "459781504968480"}, {"id": "2710427532541308"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_
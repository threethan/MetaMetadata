/t64.5771-25/491825481_827936560325138_3337035952769692442_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q4tHwz0onQMQ7kNvwEYZeOp&_nc_oc=AdpHYWewnVMIADxUyWxE_3IjswcP1makZj5kuhgO5p-AhU-YyNMyE1JD8WDn3et_RUU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ-PUmXqZ6cINuGkWUtYBQuNhXla3L38uhm5v1XyNZ5bA&oe=6AE9FF03"}, {"file_name": "HighresScreenshot00034.png", "id": "3500989796716960", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491823783_3500989800050293_3817477458997999322_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qcNOpTlEXuYQ7kNvwGdw9PE&_nc_oc=AdrL2oi__IaDAjb4jhWf4QkrCyVXff061e4aMV9aYGEZurJNn_ffNFAIzQF7DuIF6iI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRqkiIY5oPMYnzLixIJ77hPGXg79X-vOy3lmQaubdKtcQ&oe=6AE9E737"}, {"file_name": "HighresScreenshot00046.png", "id": "2432584603877183", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491820441_2432584607210516_5218731381166807859_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EIINroYesCwQ7kNvwHDijJS&_nc_oc=AdrI2TKeFh8MR_7ZtBnByRC2IK34qgLbRDQcUtVECu4l6tf6sjvWB4XC6e6EI2Z3TOA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSY7faeZJAG2b71nOBOT9MR5YbVJPorGkx_KWGE5sQAKg&oe=6AE9F4F3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape_NEW_With_Update.png", "id": "939001745642283", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499295279_939001748975616_8690268869550372401_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KSM9Ho002soQ7kNvwHm4IxW&_nc_oc=AdpBjXk6ZPeeKpB1MkXqCIxzv50afxletdX6121BAQS1RDnRdxg4qsiLKrBgORl54G0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRX698ODxAFKYayfuM9PcNbkqArEwVjP2V_cKd48mTA2w&oe=6AE9E7D7"}, "display_name": "Spymaster", "keywords": ["spy", "time", "action", "infiltration", "rewind"], "long_description": "Become the Spymaster: command three unique agents through time-critical missions. Harness the C.A.S.S.E.T.T.E, a top-secret device, to record, rewind, and synchronize their moves in an innovative spy game blending action, infiltration, and self-coop.\n\n{2184114965836738}\n\n**Feel like a real spy**\n\nNo two missions are alike, from defusing bombs to poisoning villains and face the cold ice of Arctic. Run, jump, climb, slide, zipline, and shoot your way to complete your objectives.\n\n{28498161179879152}\n\n**Control Multiple Agents**\n\nEmbody three playable agents, each with unique skills and weapons.\n\n{2642510269532084}\n\n**Rewind Time**\n\nUse the C.A.S.S.E.T.T.E and your brain to refine each step and conduct the perfect mission.\n\n{28564929279873803}\n\u200e\n**Enter the World of Espionage**\n\nInfiltrate Protocore and its ruthless CEO, PROTUS. Expose his plot, and lead high-stakes missions for NODE, the world's last line of defense.\n\n{2404437713720414}", "short_description": "Become the Spymaster: command three unique agents through time-critical missions. Harness the C.A.S.S.E.T.T.E, a top-secret device, to record, rewind, and synchronize their moves in an innovative spy game blending action, infiltration, and self-coop."}, {"images": {"nodes": []}, "id": "1909921966639926", "locale": "it_IT", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Spymaster", "keywords": ["spy", "time", "action", "infiltration", "rewind"], "long_description": "Diventa uno Spymaster: guida tre agenti unici in missioni in cui ogni secondo conta. Usa il C.A.S.S.E.T.T.E., un dispositivo top secret per registrare, riavvolgere e sincronizzare i movimenti degli agenti in un innovativo spy-game che combina azione, infiltrazione e cooperazione in solitaria.\n\n{2139558863343165}\n\n**Senti il brivido delle vere spie**\n\nNessuna missione \u00e8 uguale all'altra: disinnesca bombe, avvelena criminali e affronta i pericoli. Corri, salta, arrampicati, scivola, lanciati dalle teleferiche e spara per portare a termine i tuoi obiettivi.\n\n{1012797475169919}\n\n**Controlla pi\u00f9 agenti**\n\nAssumi il controllo di tre agenti giocabili, ognuno dotato di abilit\u00e0 e armi distintive.\n\n{1490326672928300}\n\n**Riavvolgi il tempo**\n\nUsa il C.A.S.S.E.T.T.E. e il tuo ingegno per perfezionare ogni mossa e portare a termine la missione perfetta.\n\n{27080257135006292}\n\n**Immergiti nel mondo dello spionaggio**\n\nInfiltrati nella Protocore e affronta il suo spietato CEO, PROTUS. Svela la sua cospirazione e porta a termine missioni ad altissimo rischio per NODE, l'ultima linea di difesa rimasta al mondo.\n\n{2337107653689796}", "short_description": "Diventa uno Spymaster: guida tre agenti unici in missioni in cui ogni secondo conta. Usa il C.A.S.S.E.T.T.E., un dispositivo top secret per registrare, riavvolgere e sincronizzare i movimenti degli agenti in un innovativo spy-game che combina azione, infiltrazione e cooperazione in solitaria."}, {"images": {"nodes": []}, "id": "1640775777488381", "locale": "zh_CN", "screenshots": [{"file_name": "01_PlanningChallenge.png", "id": "1799444597694820", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/507829691_1799444601028153_5433715299546535474_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ABIuSHoqyWUQ7kNvwEL-Oem&_nc_oc=Adq-z6r1NKLtwlYfVz5PmBaJJwl8AMgATJ583-RkysKKNRxruvISWT3ulIqi0IXupIE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRjqEUbGOzL1j_Z-apm67l9vFa9JPKj-Hr3yzIBWB36pg&oe=6AEA0BB6"}, {"file_name": "02_TrainBomb.png", "id": "1523639486012167", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491824700_1523639489345500_6507866419796202793_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s3rWpjah-nEQ7kNvwH-DG7z&_nc_oc=Ado_Dc4RQjozPS_WW1UYW1RVzx3h1BFgY-BCWq_VIbiRZCV4UwfPvXRUMNP2bKc0QDM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSM4qaV3B-4dWU87iGwylpIEta03pDAwABUu_jZivLoEw&oe=6AE9FDBA"}, {"file_name": "Arctic01.png", "id": "1625406735180800", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491823286_1625406738514133_3513
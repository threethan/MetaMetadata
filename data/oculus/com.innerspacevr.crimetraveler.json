60CEAE"}, {"file_name": "Venice02.png", "id": "2196662217753930", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491818890_2196662221087263_7533702763162913842_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BZYy9zd0jJ8Q7kNvwGuZzRZ&_nc_oc=AdruX3nn2IH5M_Qr5drjnz7kPW1YHoEPYOkbl12DLn4c4gz6ZQKjTCwmtwdGpnrlitw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCrZQwzOLsW23bWQvNW8afvSDquNk2C84cL2byWD6g3iQ&oe=6A60B909"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Spymaster", "keywords": ["\u95f4\u8c0d", "\u65f6\u95f4", "\u52a8\u4f5c", "\u6e17\u900f", "\u5012\u5e26"], "long_description": "\u539f\u6838\u96c6\u56e2\u8ba1\u5212\u5371\u5bb3\u4e16\u754c\uff0c\u53ea\u6709\u8282\u70b9\u7684\u7cbe\u82f1\u7279\u5de5\u6709\u80fd\u529b\u7834\u574f\u8fd9\u4e2a\u96c6\u56e2\u7684\u4e0d\u8f68\u4f01\u56fe\u3002\u501f\u52a9\u79d8\u5bc6\u6b66\u5668\u201c\u5361\u5e26\u201d\uff0c\u5316\u8eab\u9a6c\u5229\u6839\u7279\u5de5\u3001\u63d0\u514b\u7279\u5de5\u548c\u5965\u65af\u5361\u7279\u5de5\uff0c\u6267\u884c\u9ad8\u98ce\u9669\u7684\u4efb\u52a1\uff0c\u6210\u4e3a\u7ec8\u6781\u7684\u8c0d\u6d77\u9ad8\u624b\uff01\n\n**\u56de\u6eaf\u65f6\u95f4**\n\n\u501f\u52a9\u201c\u5361\u5e26\u201d\u64cd\u7eb5\u65f6\u95f4\uff0c\u4f18\u5316\u6bcf\u4e00\u6b65\u3001\u6bcf\u4e00\u4e2a\u51b3\u7b56\uff0c\u786e\u4fdd\u884c\u52a8\u5929\u8863\u65e0\u7f1d\u3002\n\n{1478186640444166}\n\n**\u4e00\u6c14\u5475\u6210**\n\n\u5954\u8dd1\u3001\u6500\u722c\u3001\u6ed1\u884c\u3001\u5c04\u51fb\uff0c\u6700\u7ec8\u62b5\u8fbe\u5b89\u5168\u533a\u57df\u3002\n\n{1294138146246068}\n\n**\u6210\u4e3a\u7cbe\u82f1\u7279\u5de5**\n\n- \u4e09\u4f4d\u7279\u5de5\uff0c\u5404\u6709\u5404\u7684\u957f\u5904\uff0c\u73a9\u6cd5\u5404\u4e0d\u76f8\u540c\u3002\n- \u884c\u52a8\u53d8\u5316\u83ab\u6d4b\uff0c\u6bcf\u6b21\u884c\u52a8\u90fd\u4e0d\u4e00\u6837\uff0c\u6709\u7684\u9700\u8981\u62c6\u5f39\uff0c\u6709\u7684\u9700\u8981\u4e0b\u6bd2\uff0c\u96be\u5ea6\u5c42\u5c42\u63d0\u5347\uff0c\u9700\u8981\u91c7\u7528\u4e0d\u540c\u7684\u601d\u8def\u6267\u884c\u3002\n- \u6e38\u620f\u73a9\u6cd5\u591a\u6837\uff0c\u7834\u89e3\u8c1c\u9898\uff0c\u67aa\u6740\u53cd\u6d3e\uff0c\u7a7f\u8fc7\u91cd\u91cd\u5b89\u4fdd\uff0c\u8df3\u4e0a\u63a0\u8fc7\u7684\u76f4\u5347\u673a\uff01\n\n{2554125018324135}\n\n**\u62a2\u5148\u4f53\u9a8c**\n\n\u300aSpymaster\u300b\u76ee\u524d\u8fd8\u5728\u5f00\u53d1\uff0c\u62a2\u5148\u4f53\u9a8c\u671f\u95f4\uff0c\u73a9\u6cd5\u4f1a\u4e0d\u65ad\u4f18\u5316\uff0c\u6e38\u620f\u5185\u5bb9\u4e5f\u4f1a\u7ee7\u7eed\u5145\u5b9e\u3002", "short_description": "\u5168\u7403\u4f01\u4e1a\u539f\u6838\u96c6\u56e2\u4f01\u56fe\u7978\u5bb3\u4e16\u754c\uff0c\u4f60\u4eec\u5fc5\u987b\u60f3\u65b9\u8bbe\u6cd5\u6f5c\u5165\u5176\u4e2d\u3002\u4e09\u4f4d\u7279\u5de5\u5404\u6709\u7279\u957f\uff0c\u4f9b\u4f60\u8c03\u5ea6\uff0c\u8fd8\u80fd\u5229\u7528\u5361\u5e26\u64cd\u63a7\u65f6\u95f4\uff0c\u6267\u884c\u9887\u5177\u6c89\u6d78\u611f\u7684VR\u4efb\u52a1\uff0c\u65e2\u8981\u91c7\u53d6\u60ca\u9669\u884c\u52a8\uff0c\u4e5f\u8981\u7834\u89e3\u79cd\u79cd\u8c1c\u9898\uff0c\u6700\u7ec8\u6210\u4e3a\u8c0d\u6d77\u9ad8\u624b\uff01"}, {"images": {"nodes": []}, "id": "1706651374017300", "locale": "de_DE", "screenshots": [{"file_name": "01_PlanningChallenge.png", "id": "828144176547997", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491818890_828144179881330_8841569204037628713_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a_NFDZ06e2gQ7kNvwEaaVJe&_nc_oc=AdpR9emnIcGPeosLQmSK8MqGlWZ8GQYOxMEJOoYtmdzMwjR9qg7VhyF07ndMf8w2big&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBo9-Wg4nJXcSxRXEDHSaBTbLOG8GPlEqg--GExfHO0sQ&oe=6A60D157"}, {"file_name": "02_TrainBomb.png", "id": "1290921349899402", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491824307_1290921353232735_4763071316224883862_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b3QxjmKiMOsQ7kNvwGvDrqu&_nc_oc=Adpt6NvEqc6hvDdBcnXiUFheuyHFOTaIDnIfWbntFBcaRoiaQ7gWmjdvVlnM2Wldwic&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAzL1JDZvDWGcp3g-NJccDHH2n92wMIfY5eYikrMu_enw&oe=6A60D820"}, {"file_name": "Arctic01.png", "id": "2156954648400795", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491827282_2156954651734128_6083557595907825992_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1iXc0S5DrxkQ7kNvwGtrsQm&_nc_oc=AdqA1GgU_Id89Kf2IfVWcWXBCWvNKukTliOb_gNge0K-I7rZUPfrNQJfWqQZBKqFB0c&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAtDVYUvBPgX988Acgzc3aQxTItUwxCCw9qDvkNcOd_3g&oe=6A60BB98"}, {"file_name": "Casino01.png", "id": "967855129324467", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491819859_967855132657800_1858141089707515280_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cc8x3s8bk1cQ7kNvwFqkEH7&_nc_oc=AdowNZNPm2KHATJTiOwnxcLG95prjjRZZ_0VbpavSo1jHB5hYEh4w-_0DCSGu3RcbxE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCLmcysG7VOJaTWKwJNgA0HSnMKAqGc8zfsrfxLgmKqNw&oe=6A60C771"}, {"file_name": "Venice02.png", "id": "1001291575620958", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491830615_1001291578954291_5658986239729057441_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=76hBN47DyUcQ7kNvwEXJnWt&_nc_oc=AdouEL0RQyNU8fXokk9pc81ktkCQrQIjSXoJJPAEdhuso_1g6MMhfQuQytOi0AsvAC4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCn-pKAMMS9rclCsRJFoWjIw7rZXv6sv6ftGKZdgtLUNw&oe=6A60A63A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Spymaster", "keywords": ["Spion", "Zeit", "Aktion", "Eindringen", "Zur\u00fcckspulen"], "long_description": "Protocore bedroht die Welt und nur die Eliteagenten von NODE k\u00f6nnen die Pl\u00e4ne dieses gef\u00e4hrlichen Konzerns stoppen. Schl\u00fcpfe in die Rollen der Agenten Mulligan, TIC und OSCR, um mit ihrer Geheimwaffe, der C.A.S.S.E.T.T.E., hochriskante Missionen auszuf\u00fchren und ein ultimativer **Spymaster** zu werden!\n\n**Spule die Zeit zur\u00fcck**\n\nManipuliere die Zeit mit der C.A.S.S.E.T.T.E. Verfeinere jeden Schritt und jede Entscheidung, um die perfekte Mission durchzuf\u00fchren.\n\n{950800854440548}\n\n**Ununterbrochene Bewegung**\n\nRenne, klettere, schlittere, nutze Seilrutschen und schie\u00dfe dir einen sicheren Weg frei\n\n{1651949632683119}\n\n**Steige in die Agenten-Elite auf**\n\n- Drei Spione - alle mit ihren egenen Spielmechaniken\n- Abwechslungsreiche Missionen \u2013 Keine Aufgabe gleicht der anderen. Von der Entsch\u00e4rfung von Bomben bis hin zum Vergiften von B\u00f6sewichten: Jede weitere Mission fordert dich mehr heraus und verlangt eine andere Herangehensweise.\n- Abwechslungsreicher Spielablauf: L\u00f6se R\u00e4tsel, erschie\u00dfe B\u00f6sewichte, infiltriere gesicherte Orte und springe in fliegende Hubschrauber!\n\n{1512948480195465}\n\n**Early Access**\n\nSpymaster befindet sich in aktiver Entwicklung, verfeinert sein Gameplay und erweitert seinen Inhalt w\u00e4hrend der Early Access-Phase.", "short_description": "Infiltriere Protocore, ein global agierende Firma mit Pl\u00e4nen, welche die Welt bedrohen. Steuere drei Eliteagenten mit einzigartigen F\u00e4higkeiten in actiongeladenen Sequenzen, l\u00f6se R\u00e4tsel und manipuliere die Zeit selbst, um ein Spymaster zu werden!"}, {"images": {"nodes": [{"file_name": "CoverSquare.png", "id": "1227985158730599", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491823259_1227985162063932_1839223545351691675_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YHLFvouBsJIQ7kNvwFAOKiE&_nc_oc=AdrL5MDVRUkxs2osUr2kTRj5q-4Lh1wUgU6SRZiQKw9AWXWzyxmuU2hid8bJjg4FRTs&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDlGQIMQfkTniY7pSUIP9kk3ZdTom2XKvgcgiUuMpSylg&oe=6A60D6B0"}, {"file_name": "CoverLandscape.png", "id": "937103128740395", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491823341_937103132073728_7336675141747262623_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4CZ-pW6zafwQ7kNv
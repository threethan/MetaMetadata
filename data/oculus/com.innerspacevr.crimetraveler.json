urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uv-O7BMd6H8Q7kNvwGn8F-8&_nc_oc=Adrobp6c3l-JOlq0cu7VuzCUpwhznqpqI5EQDa1CdURyJkWGOdy8r5zA19mPryvJEdw&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQV2FsIhRmG7TPGcUiXDSeE7OL-lY4nvV7gtlNL_OTm3Q&oe=6AFB2347"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Adobe Express - file.png", "id": "880012964941330", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/491821696_880012968274663_4142236958427032935_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UOOprl8CZmEQ7kNvwFdHeF5&_nc_oc=AdqFVRuFzEcY0xjyRbuZqLROlIDr6_aPz5oWtvo6is-8lZYoVKyDd8zZxa01q1dDbh4&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQvFUfiHweWDSnL3J0cmGB4nrH9DT7o9GiTK9A_h6kDew&oe=6AFB21F6"}, "display_name": "Spymaster", "keywords": ["spy", "master", "time", "physics"], "long_description": "Protocore threatens the world, and only the elite agents of NODE can stop this dangerous corporation's plans. Take on the roles of Agent Mulligan, TIC and OSCR to execute high-risk missions using their secret weapon, the C.A.S.S.E.T.T.E., becoming the ultimate **Spymaster!**\n\n\n\u200e\n\n\n**Rewind Time**\n\nManipulate time using the C.A.S.S.E.T.T.E., refining each step, each decision to conduct the perfect mission.\n\n{1968748060384564}\n\n\u200e\n\n**Unbroken Momentum**\n\nRun, climb, slide, zipline and shoot your way to safety.\n\n{934506685620409}\n\n\u200e\n\n**Become an Elite Agent**\n\n- Three Spies - Each with their own unique gameplay traits\n- Dynamic Missions - No two missions are alike, from defusing bombs to poisoning villains, each becomes more challenging, requiring a different approach \n- Varied Gameplay - Solve puzzles, shoot bad guys, infiltrate secure locations and jump into moving helicopters!\n\n\n\n\n\u200e\n\n**Early Access**\n\nSpymaster is in active development, refining its gameplay and continuing to expand its content throughout Early Access.", "short_description": "Infiltrate Protocore, a global corporation with plans that threaten the world. Command three agents with unique skills, manipulate time using the C.A.S.S.E.T.T.E., and combine action and puzzles in immersive VR missions to become a Spymaster !"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.termsfeed.com/live/1e06831f-b759-4751-9ca4-99cbf88c206b", "developer_terms_of_service_url": null, "publisher_name": "InnerspaceVR", "support_website_url": null, "website_url": "https://www.innerspacevr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "1008279844328894"}, {"id": "459781504968480"}, {"id": "2710427532541308"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "fr", "de", "zh_CN", "es"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "34652568764356852"}}]}, "scheduled_offers": {"count": 3, "nodes": [{"status": "PENDING", "id": "1834225187921585"}, {"status": "PUBLISHED", "id": "2329576341199665"}, {"status": "PUBLISHED", "id": "982626634205003"}]}, "baseline_offer": {"id": "2329576341199665"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 0, "status": "PENDING", "id": "1834225187921585"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "39770936555853355", "version": "1.078"}, "id": "1144782443714202", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"_
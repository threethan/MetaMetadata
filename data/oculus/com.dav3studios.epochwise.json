rlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o45_MglTNwAQ7kNvwFAWTkR&_nc_oc=AdrKMAH_LbR3axvY89GLFvPr6RUjheXdqjjFBKWlfgQyxPJjrI5WFy0kFj_7r8eaNgk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQX6NMnOf3I-zhW4TAj2VCYT4HKW_-yAfxFty27Br26XLw&oe=6B104306"}, {"file_name": "03_tw_lind_which_date.png", "id": "1770199040900398", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/750864147_1770199044233731_3063103742158060719_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jzS00x8n4tkQ7kNvwHO_U_v&_nc_oc=AdpEIHHrDL6pyl6KtVqwwJgcJJiHoKhPwoekSQFm_ADhlZKDN_Tja5aShGtffnTsso8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQW7lC5zyDEPsyRTe44II3SXms75sDYcxoZSTROGh1v0rA&oe=6B104200"}, {"file_name": "05_tw_hoo_the_ship.png", "id": "1782500593017747", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491830441_1782500596351080_549419814829454665_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DaCE1DedoxgQ7kNvwF4MRcA&_nc_oc=AdqCoHZx6YsNt_5LcQQOQOA-9q-wwd8OcSDOEBby4w6hXaMdvMBBOuG2BvVC_TvIUDg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVj9wDGj_GsiyXqLw4GTLbspOlO1fh62vz9OO4HtM2KGw&oe=6B103C09"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_cover_2560x1440.png", "id": "3673772376112191", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/753328995_3673772379445524_5960650648092249491_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=linysfR18UsQ7kNvwEa_UlM&_nc_oc=AdrNmBCJOHVVRbQguDKu48rvA6I4rr4JYq2RnMpOKbkmoVoB74X4ByzL9jch2IwPxWc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVrVMpP_9CybhTrGQz36--MeA62KNqCvptXQQCMLQDfAw&oe=6B10505A"}, "display_name": "EpochWise: Witness Real History", "keywords": [], "long_description": "STAND WHERE IT HAPPENED\nAn educational, documentary history app. 45 scenes, from Skara Brae to the Moon landing and the opening of the Berlin Wall. Most stand on the real land, from survey data, under the sky computed for that date and place. Watch Halley's Comet over Sussex in 1066, or the Great Fire of London from the river with Samuel Pepys.\n\nREAL WORDS, HONEST LABELS\nHear real words from chronicles, diaries, letters and broadcasts, read by a computer-generated British voice, with subtitles. A label always says what you see: a real place, a computed sky, a reconstruction from sources, or what the sources say. Where historians disagree, the app says so and shows each view. Facts name their sources.\n\nA SAFE PLACE TO WATCH\nYou watch from a viewing spot, far from the action. Before every scene a short note says what it shows, with a choice to read it as text or to leave. Battles stay far away and nobody is shown hurt. \"Leave scene\" and \"Step back\" are always there.\n\nLEARN YOUR WAY\nFour reading depths, from Quick Look to Expert. Put events in order on the Timeline. Each scene ends with a question about its sources or dates. A finished scene earns a badge.\n\nFOR FAMILIES\nUp to six explorers, pictures only, no names. Break reminders. A grown-up finds questions to talk about for each finished scene. An adult should supervise children's play. No ads, no chat, no accounts, no in-app purchases and no personal data collected. Plays offline.", "short_description": "A history app for learning: stand at real places at real moments, from Stonehenge and 1066 to the Moon landing. 45 scenes, most on the real land, under the sky computed for that date and place. Hear real words from the sources, read by a computer-generated voice. A label always says what is real, what is rebuilt and where historians disagree. You watch from a safe distance. Four reading depths. For ages 10 and up. No ads, no chat, no accounts, no in-app purchases and no personal data collected."}]}, "developer_name": null, "developer_privacy_policy_url": "https://dhl84.github.io/epochwise/privacy.html", "developer_terms_of_service_url": "https://dhl84.gi
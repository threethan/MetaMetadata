shot2.png", "id": "1173864234304946", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499296288_1173864237638279_2462020394851590536_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ni-CVvOG5CEQ7kNvwHuE9VG&_nc_oc=Adp_cnfwanV1GLM39HRk4O8aCg7O0NP5gl-wqvDqMwwz-lk5in_-wv0aDd4V4zO5Eo4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOVRUi_9fW6DqBppg1XVdxhOU9tAmxZLWY_hRTNHUiwGw&oe=6AE5E8BD"}, {"file_name": "Screenshot3.png", "id": "1358978606022789", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499618937_1358978609356122_816223264038509773_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UlYC0tHH2OEQ7kNvwHnNuEx&_nc_oc=Adr7LtxR5UmifC_DXLrh17RV69Bn7uprhGvHpX2ttiY2VJ_odD_ziqDpbWWr9iAkCUs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPE7xmYiQ7cC69N_-bqwe3Kax7GXcttWAmhM-rDBLOckQ&oe=6AE5E0E2"}, {"file_name": "Screenshot4.png", "id": "1369823617949502", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499619174_1369823621282835_4051724597108621584_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2CO1MmZJ-9cQ7kNvwG0zp8e&_nc_oc=AdqoOqI7FL4HslgrCE38poZw5p4oWVEJm1YAE9Kng9DNdjHTt8aSeK_bgne9ZIJUt_E&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNTOS2LR2oSAyZIe08uj48UXlgufcLokBoM2aCe07IVZg&oe=6AE6101E"}, {"file_name": "Screenshot5.png", "id": "1887484512204627", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499619805_1887484515537960_7832102536243317228_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cad7bFxhQOsQ7kNvwFRUcKm&_nc_oc=AdqeIDPwk6uSfXhS00ifk73ltU6zZTHQERTOjvgWpnudG5B8dTzsloMVba9CHT03-_M&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNSwgoZu9NVw6hQ2hsCtWFMtGgVsTG39TqnZiMOQajotA&oe=6AE608BD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer cover image 2560x1440 - Copy.png", "id": "2117929769014258", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499619668_2117929772347591_7305990331590425037_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iUO-ePpE7AIQ7kNvwE7VPsE&_nc_oc=AdoeQkwVhMQwVQc3zsW_l8d9imrtZI7AqZy65Qlkd9vBk-rIiZeZK_8AKMxDq0jMxSI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMvhp6v8hDtSxqyZTr4C0dokCGFpvse_M1LbnICQEY9Sw&oe=6AE5E831"}, "display_name": "Crystal Conquest", "keywords": [], "long_description": "Crystal Conquest is a **Free-To-Play** VR game where you **control the elements** and battle for victory. Harness the power of fire, water, earth, and air in epic 3v3 MOBA-inspired combat or intense dueling modes! Team up with your friends against AI or choose to fight in PvP!\n\n**Build your mage:** Choose the class that matches your playstyle and elements. Unlock class variants as you grow and customize your build. \n\n**Harness the elements:** Battle with elemental magic where each element has unique properties. Use earth, fire, water, and wind to block, dodge, and deflect your enemy's attacks. \n\n**Grow in Power:** Level up and unlock even more epic spells that change how you control the elements.\n\n**Choose Your Battle Mode:** Battle in 3v3 matches to capture crystals and topple towers, face off in duels, or team up in co-op to take on waves of AI. All modes support AI for solo or practice play.", "short_description": "Crystal Conquest is a free-to-play VR game where you control the elements and battle for victory. Harness the power of fire, water, earth, and air in epic 3v3 MOBA-inspired combat or intense dueling modes!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.mysticinteractive.com/s/MYSTIC-INTERACTIVE-PRIVACY-POLICY.pdf", "developer_terms_of_service_url": "https://www.mysticinteractive.com/terms-of-use", "publisher_name": "Mystic Interactive", "support_website_url": "https://discord.gg/KV9f2dwTdY", "website_url": "https://www.crystalconquest.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "3744040075834813"}, {"id": "2710427532541308"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER", "CO_OP"], "id": "25649479581303286"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1566552014526318"}]}, "baseline_offer": {"id": "1566552014526318"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1765526400, "status": "PUBLISHED", "id": "1566552014526318"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "29125125070405369", "version": "1.2.0"}, "id": "25740082985581976", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "25080401538211096", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "29125125070405369"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "25740082985581976"}]}, "change_log": "Patch 1.2.0 Notes\n\nNew Features\n- Added the soloable Defense game mode! Place towers and glyphs to defend your crystal against incoming waves of enemies! We have two levels for now. More are on the way!\n- Added an active sprinting ability for the Monk! Swing your arms while moving or click the left joystick to sprint.\n- Added new monster types for Defense and Conquest\n\nPerformance Improvements\n- Greatly smoothed rendering on Quest devices, especially when moving\n- Many performance fixes across all devices\n\nBalancing Changes\n- Casting now slows movement speed by 10% for non-Monk characters\n- Reduced earth, water, and force element damage\n- Increased fire element base damage slightly\n- Fire damage now stacks a Smoulder status instead of Burning directly. Smoulder acts as the ignition chance to trigger the Burning effect.\n- The Fire Whip does not stack Smoulder but can still trigger Burning if a target already has Smoulder\n- Limited the number of targets of various AoE spells to 3 for Slash, 4 for Blast, 6 for Fireball splashes, and 12 for Nova\n- Reduced Gale damage by 50%, increased cooldown to 20s, and added a slowing effect back in\n- Barriers no longer lose health over time. Reduced the health of barriers by 45%, reduced the duration to 15s, and reduced the cooldown to 45s\n- Reduced gold cost of various items\n- Increased gravity by 20%\n\nBug Fixes\n- Fixed issue where tower projectiles could fly high into the sky instead of toward a target\n- Improved targeting with Leeching Link\n- Fixed issue where golems would play a standing idle animation after dying\n- Fixed button text issues in the ring upgrade book\n- Damage over time spells now crit properly over a 1.5 second interval\n- Fixed issue where players would start facing the wrong direction after loading a map\n- Improved projectile aiming\n- Many stability improvements", "created_date": 1791872375, "id": "29125125070405369", "version": "1.2.0", "version_code": 70, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": {"id": "29125115547072988"}, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "25080401538211096", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "29125125070405369"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "25740082985581976"}]}, "change_log": null, "created_date": 1791869709, "id": "29124710490446827", "version": "1.2.0", "version_code": 69, "release_status": "PENDING", "status": "DRAFT", "binary_test_results": {"nodes": []}, "obb_binary": {"id": "29124697730448103"}, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "25080401538211096", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "29125125070405369"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": []}, "change_log": null, "created_date": 1790894393, "id": "28971335989117612", "version": "1.2.0", "version_code": 68, "release_status": "PENDING", "status": "DRAFT", "binary_test_results": {"nodes": []}, "obb_binary": {"id": "28971324215785456"}, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "25080401538211096", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "29125125070405369"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": []}, "change_log": null, "created_date": 1790893421, "id": "28971219429129268", "version": "1.2.0", "version_code": 67, "release_status": "PENDING", "status": "DRAFT", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "25080401538211096", "is_concept": false, "lat
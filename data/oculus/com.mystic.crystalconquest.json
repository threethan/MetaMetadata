pq2Xa2swY9g2qTtnInyzsvm1D4fR2jQkRI2feg&oe=6AFDC3BD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer cover image 2560x1440 - Copy.png", "id": "2117929769014258", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499619668_2117929772347591_7305990331590425037_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jHz8mEtBKB0Q7kNvwHOMDtW&_nc_oc=AdpJr7S5GLjvFdIsxkjMyrHFLAEUACKIV6soRzdo-CMX8ILYLFX9q0eC2jvOfIrQon4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQeZwx6Pe3IEVr-JqxlULNgalpZ0d2dGA3xMp-xK2kwTg&oe=6AFDDB71"}, "display_name": "Crystal Conquest", "keywords": [], "long_description": "Crystal Conquest is a **Free-To-Play** VR game where you **control the elements** and battle for victory. Harness the power of fire, water, earth, and air in epic 3v3 MOBA-inspired combat or intense dueling modes! Team up with your friends against AI or choose to fight in PvP!\n\n**Build your mage:** Choose the class that matches your playstyle and elements. Unlock class variants as you grow and customize your build. \n\n**Harness the elements:** Battle with elemental magic where each element has unique properties. Use earth, fire, water, and wind to block, dodge, and deflect your enemy's attacks. \n\n**Grow in Power:** Level up and unlock even more epic spells that change how you control the elements.\n\n**Choose Your Battle Mode:** Battle in 3v3 matches to capture crystals and topple towers, face off in duels, or team up in co-op to take on waves of AI. All modes support AI for solo or practice play.", "short_description": "Crystal Conquest is a free-to-play VR game where you control the elements and battle for victory. Harness the power of fire, water, earth, and air in epic 3v3 MOBA-inspired combat or intense dueling modes!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.mysticinteractive.com/s/MYSTIC-INTERACTIVE-PRIVACY-POLICY.pdf", "developer_terms_of_service_url": "https://www.mysticinteractive.com/terms-of-use", "publisher_name": "Mystic Interactive", "support_website_url": "https://discord.gg/KV9f2dwTdY", "website_url": "https://www.crystalconquest.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "3744040075834813"}, {"id": "2710427532541308"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER", "CO_OP"], "id": "25649479581303286"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1566552014526318"}]}, "baseline_offer": {"id": "1566552014526318"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1765526400, "status": "PUBLISHED", "id": "1566552014526318"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "29419095134341693", "version": "1.2.1"}, "id": "25740082985581976", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "25080401538211096", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "29419095134341693"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": []}, "change_log": null, "created_date": 1794622198, "id": "29581774204740451", "version": "1.2.2", "version_code": 75, "release_status": "PENDING", "status": "DRAFT", "binary_test_results": {"nodes": []}, "obb_binary": {"id": "29581764821408056"}, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "25080401538211096", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "29419095134341693"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": []}, "change_log": null, "created_date": 1794378604, "id": "29539212438996628", "version": "1.2.2", "version_code": 74, "release_status": "PENDING", "status": "DRAFT", "binary_test_results": {"nodes": []}, "obb_binary": {"id": "29539203212330884"}, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "25080401538211096", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "29419095134341693"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "25740082985581976"}]}, "change_log": "New\n\u2022 Settings menu overhaul with new options (plus a stick drift fix)\n\u2022 Easier blocking with better block feedback\n\u2022 Better spell targeting on moving enemies. Aim where they're going to be!\n\u2022 Added a DPS tracker on a practice dummy\n\nImprovements\n\u2022 Major performance boost. Quest 3 framerate dips nearly gone, Quest 2 much smoother\n\u2022 Lower memory usage\n\u2022 Better spell charging feedback\n\nBalance\n\u2022 Crowd control now has diminishing returns when reapplied\n\u2022 +10 or more health for all classes\n\u2022 25% faster casting\n\u2022 Barrier, Cleansing Wash, Inkflare and Invisibility are now instant casts\n\u2022 Slightly lower mana costs and mana cost scaling with level reworked\n\u2022 Early level-ups give a bigger % stat boost than later ones\n\u2022 Slight damage nerf to Earth and Force\n\u2022 Giant's Hammer and Purging Whip damage reduced\n\u2022 Reduced Earth Shift range by 20%\n\nFixes\n\u2022 The bow now works while walking backward\n\u2022 Shopping while dead fixed for good\n\u2022 Spell effects now dismiss when silenced\n\u2022 Conquest passive gold is back\n\u2022 Necro Ring no longer double-dips life steal\n\u2022 Fixed purple orbs that wouldn't go away\n\u2022 Queue All no longer queues Defense (co-op coming later)\n\u2022 Fixed exploit: holding a basic charge on an enemy for huge damage\n\u2022 Many more bug fixes!", "created_date": 1793658248, "id": "29419095134341693", "version": "1.2.1", "version_code": 73, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": {"id": "29419085171009356"}, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "25080401538211096", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "29419095134341693"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": []}, "change_log": null, "created_date": 1793509142, "id": "29395225970061943", "version": "1.2.1", "version_code": 72, "release_status": "PENDING", "status": "DRAFT", "binary_test_results": {"nodes": []}, "obb_binary": {"id": "29395217586729448"}, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "25080401538211096", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "29419095134341693"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": []}, "change_log": nul
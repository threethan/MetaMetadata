606022789", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499618937_1358978609356122_816223264038509773_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cT0MoXwwHlIQ7kNvwHWeQZ2&_nc_oc=AdpCKqDxVZmHgdza7aKaJTCsxXewGdxAi3-NTMXzeOH2lhv0gtjFr3nKkJ451mTGiHc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAGfO8eBiWcIZrI9PeGtxMcdhqSsga1U5FzOntN2o4DwQ&oe=6A5F67E2"}, {"file_name": "Screenshot4.png", "id": "1369823617949502", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499619174_1369823621282835_4051724597108621584_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4KYse04tc8EQ7kNvwGnhyN3&_nc_oc=AdqkVSh4G2jBCGIQVOU-lxzYN9spEuRN9fowPOgnkTzrKr9Xv-vdfDh5dQ1D9NX3BlA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCmoA6sNngewDhSyx9EZdyUkYT8HVahz1lhmm5s5Mklmg&oe=6A5F5EDE"}, {"file_name": "Screenshot5.png", "id": "1887484512204627", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499619805_1887484515537960_7832102536243317228_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TspfE_LwVY8Q7kNvwEq6nvt&_nc_oc=AdrmRc7o2MXrpmeWMi3jCo2m0Hd61ZUUnhsQjp7g6_54uWZ1qwxLTuARCUkDEFyAjhE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB2PQBvmknZGlGR-_5denBNOX1Jf44rGC67wsOwt_7zsQ&oe=6A5F577D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer cover image 2560x1440 - Copy.png", "id": "2117929769014258", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499619668_2117929772347591_7305990331590425037_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rJf1LX1kdLoQ7kNvwGXV97q&_nc_oc=AdpCmn81LyMKaa88vpiwCnqyRUHLOo2hks3t2GDiibmXqzFnLjDAGJWsc77trvLuqTs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAC4vawQq-DAuiBI4z_TN1lW_bT0BiZwjZTuejU0TrLug&oe=6A5F6F31"}, "display_name": "Crystal Conquest", "keywords": [], "long_description": "Crystal Conquest is a **Free-To-Play** VR game where you **control the elements** and battle for victory. Harness the power of fire, water, earth, and air in epic 3v3 MOBA-inspired combat or intense dueling modes! Team up with your friends against AI or choose to fight in PvP!\n\n**Build your mage:** Choose the class that matches your playstyle and elements. Unlock class variants as you grow and customize your build. \n\n**Harness the elements:** Battle with elemental magic where each element has unique properties. Use earth, fire, water, and wind to block, dodge, and deflect your enemy's attacks. \n\n**Grow in Power:** Level up and unlock even more epic spells that change how you control the elements.\n\n**Choose Your Battle Mode:** Battle in 3v3 matches to capture crystals and topple towers, face off in duels, or team up in co-op to take on waves of AI. All modes support AI for solo or practice play.", "short_description": "Crystal Conquest is a free-to-play VR game where you control the elements and battle for victory. Harness the power of fire, water, earth, and air in epic 3v3 MOBA-inspired combat or intense dueling modes!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.mysticinteractive.com/s/MYSTIC-INTERACTIVE-PRIVACY-POLICY.pdf", "developer_terms_of_service_url": "https://www.mysticinteractive.com/terms-of-use", "publisher_name": "Mystic Interactive", "support_website_url": "https://discord.gg/KV9f2dwTdY", "website_url": "https://www.crystalconquest.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "3744040075834813"}, {"id": "2710427532541308"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER", "CO_OP"], "id": "25649479581303286"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1566552014526318"}]}, "baseline_offer": {"id": "1566552014526318"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1765526400, "status": "PUBLISHED", "id": "1566552014526318"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "27862602806657608", "version": "1.0.15"}, "id": "25740082985581976", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "25080401538211096", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "27862602806657608"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "25740082985581976"}]}, "change_log": "Patch 1.0.15 Notes\n\nNew Features:\n- Added a flying geode enemy which can be found in the Conquest arena!\n\nBalancing Changes:\n- Increased max mana for all characters by roughly 25%\n- Increased mana regen bonuses from meditation and crystal zones by 25%\n- Greatly increased the stat bonuses of ring upgrades. Also increased the upgrade gold cost\n- Increased defensive power of Shadow spells against Aether spells (tower, geode attacks)\n- Reduced the casting speed of AI bots, especially at lower difficulties\n- Buffed two monster camp buffs (the camps at the portals and above the crystals)\n\n\nBug Fixes and Improvements:\n- Various bot pathing improvements\n- Improved ragdoll responsiveness and stability\n- Fixed various issues that can happen when players leave a Conquest match early\n- Fixed issues with monster gold and XP rewards in Conquest\n- Fixed issues with saving player settings\n- Increased the size of smaller golems", "created_date": 1783193550, "id": "27862602806657608", "version": "1.0.15", "version_code": 56, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "25080401538211096", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "27862602806657608"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "25740082985581976"}]}, "change_log": null, "created_date": 1783192900, "id": "27862511020000120", "version": "1.0.15", "version_code": 55, "release_status": "PENDING", "status": "DRAFT", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "25080401538211096", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "27862602806657608"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "25740082985581976"}]}, "change_log": "Patch 1.0.14 Notes\n\nNew Features:\n- Queuing for Conquest directly will let you late join matches which haven't progressed too far\n- Added new Avatars!\n\nBalancing Changes:\n- Reduced whip flicking range and slightly reduced whip flicking damage\n\nBug Fixes and Improvements:\n- Fixed targeting issues in Conquest which could happen after a disconnection\n- Fixed choppy movement and turning with bots and golems in Conquest multiplayer matches\n- Added some minor improvements to the Ruins map\n- Other stability improvements, mainly for Conquest"
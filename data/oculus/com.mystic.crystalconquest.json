cdn.com/v/t64.5771-25/499296288_1173864237638279_2462020394851590536_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aIrBfkzb6KoQ7kNvwEpfaV4&_nc_oc=Adr9W6j1yx8547gWiOUIAoNclwRyiuNQUhZmil5uac1AzURxiNBPoAb43aE530ZEO7g&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2SO8OJqXfcIlj6t1qKhhi8WcZSq_Rc2t2oMFJrE7cslg&oe=69E7773D"}, {"file_name": "Screenshot3.png", "id": "1358978606022789", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/499618937_1358978609356122_816223264038509773_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KOr9qfasQEkQ7kNvwGkICSY&_nc_oc=AdraOI5nSaHocSTDyS4GVHM88OV6k-B5jNSFT_Ii2KMReeriZhijpd0myMwzXZWz4tA&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0LuTYV_F_4uC8mEgKyMjLTzu2AWA8f6TIoIZxoq5oaiA&oe=69E76F62"}, {"file_name": "updatedscreenshot.png", "id": "1523088678946721", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/499618499_1523088682280054_3963745572868175892_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=65lvnbTynh4Q7kNvwHrWHNn&_nc_oc=Adpve_i0RQ-A72DXsit1Jizd3xYYBtzQRxPsIM_PMLSpGuHofQLaZCGF9njzEOkMKGs&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3Dr2B7jZIm4hEwItJJ85TRmIaPxqMLQKXRRvjMe6g7tw&oe=69E766BE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer cover image 2560x1440 - Copy.png", "id": "2117929769014258", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/499619668_2117929772347591_7305990331590425037_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M1jYXka07WwQ7kNvwHCMiL8&_nc_oc=AdpvEczqiPnPzEpn5VApR7VtHR_AWhIyS15tm6ZXVdZJu-UU-pfWsed1ZtJELbl_0Oc&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3_REfJ-Rbqr3op7RY-nDnolukes4B6Jg3KR5K8w_6ELw&oe=69E776B1"}, "display_name": "Crystal Conquest", "keywords": [], "long_description": "Crystal Conquest is a Free-To-Play VR game where you control the elements and battle for victory. Imagine the elemental magic of Avatar in VR across fighting, MOBA, and level based campaign modes!\n\n\n**Key Features:**\n\n- Play as elemental mages - 4 available by default, unlock more over time\n\n- Choose which spells to take into battle, unlock more over time\n\n- Customize your in-match shop - choose your potions, wands and other items, unlock more over time\n\n- Different modes to suit your mood: Duel (1v1), Conquest MOBA (3v3) or Gauntlet (players vs waves of enemies)\n\n- Single player or Multiplayer\n\n- Private lobbies available, bring your friends\n\n- Skills-based matchmaking to pair you with equal opponents\n\n- Shape the game's future by communicating with the Studio on Discord\n\n\n{719459321207239}\n\n\n\n**Build your mage:** Choose the class that matches your playstyle and elements. Unlock class variants as you grow and customize your build.\n\n{2529778434085166}\n\n\n\n**Harness the elements:** Battle with elemental magic where each element has unique properties. Use earth, fire, water, and wind to block, dodge, and deflect your enemy's attacks.\n\n{1766498407381295}\n\n\n\n**Grow in Power:** Level up and unlock even more epic spells that change how you control the elements.\n\n{1071429428371112}\n\n\n\n**Choose Your Battle Mode:** Battle in 3v3 matches to capture crystals and topple towers, face off in duels, or team up in co-op to take on waves of AI. All modes support AI for solo or practice play.\n\n{1283539703534860}", "short_description": "Crystal Conquest is a free-to-play VR game where you control the elements and battle for victory. Harness the power of fire, water, earth, and air in epic 3v3 MOBA-inspired combat or intense dueling modes!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.mysticinteractive.com/s/MYSTIC-INTERACTIVE-PRIVACY-POLICY.pdf", "developer_terms_of_service_url": "https://www.mysticinteractive.com/terms-of-use", "publisher_name": "Mystic Interactive", "support_website_url": "https://discord.gg/KV9f2dwTdY", "website_url": "https://www.crystalconquest.com/", "category": nul
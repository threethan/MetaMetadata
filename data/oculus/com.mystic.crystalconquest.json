606022789", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/499618937_1358978609356122_816223264038509773_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kSw5adi7HC8Q7kNvwH7_G4E&_nc_oc=Adojcdw9IE2woDzIR0SEusyVzY_yUqieH37MxfLqYbDDxjoQ2ER-q3734Q1JdBC6_2A&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHWSGOuNnu--oOtHYvKsVWHG_aLjdCGahO8e_NaXe2hhw&oe=6A81AEE2"}, {"file_name": "Screenshot4.png", "id": "1369823617949502", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/499619174_1369823621282835_4051724597108621584_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w8yjiPb30dMQ7kNvwEtNI_2&_nc_oc=AdoPyarhddxyn3gfnLJFGIY_ji02TQEMAOHPgISyIWDk8k4vUebtOxb9QrqgZzGs6CU&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHgRPtEUcTEN3kzhWaLgwO4Hfr2F_aNKmUQzcPSW2NPNA&oe=6A81A5DE"}, {"file_name": "Screenshot5.png", "id": "1887484512204627", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/499619805_1887484515537960_7832102536243317228_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g3OPPKmtGEUQ7kNvwFOf1wG&_nc_oc=AdraRTlXiLHtgirjxvVgwc5NMVVxl_JAJaAbGwkiVHKmfessFJ9Op4g_Lp44JxTVh7E&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEQMManma-UOfBvOyKCG1_z9A6rkF2e1-raZw9iI7Nsyw&oe=6A819E7D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer cover image 2560x1440 - Copy.png", "id": "2117929769014258", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/499619668_2117929772347591_7305990331590425037_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5V5ViOFk5-0Q7kNvwFNOSPH&_nc_oc=AdqGei9LQxwFW23H-Jo8pAWqFNeX6d5p7QOyta8vMWZIKdZzwAATq-vIbKDaykPZNGY&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEcBmg5PRoBFKvYZ5bMvEfjCFAZ7ARvR2ORc2GdS8X5wg&oe=6A81B631"}, "display_name": "Crystal Conquest", "keywords": [], "long_description": "Crystal Conquest is a **Free-To-Play** VR game where you **control the elements** and battle for victory. Harness the power of fire, water, earth, and air in epic 3v3 MOBA-inspired combat or intense dueling modes! Team up with your friends against AI or choose to fight in PvP!\n\n**Build your mage:** Choose the class that matches your playstyle and elements. Unlock class variants as you grow and customize your build. \n\n**Harness the elements:** Battle with elemental magic where each element has unique properties. Use earth, fire, water, and wind to block, dodge, and deflect your enemy's attacks. \n\n**Grow in Power:** Level up and unlock even more epic spells that change how you control the elements.\n\n**Choose Your Battle Mode:** Battle in 3v3 matches to capture crystals and topple towers, face off in duels, or team up in co-op to take on waves of AI. All modes support AI for solo or practice play.", "short_description": "Crystal Conquest is a free-to-play VR game where you control the elements and battle for victory. Harness the power of fire, water, earth, and air in epic 3v3 MOBA-inspired combat or intense dueling modes!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.mysticinteractive.com/s/MYSTIC-INTERACTIVE-PRIVACY-POLICY.pdf", "developer_terms_of_service_url": "https://www.mysticinteractive.com/terms-of-use", "publisher_name": "Mystic Interactive", "support_website_url": "https://discord.gg/KV9f2dwTdY", "website_url": "https://www.crystalconquest.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "3744040075834813"}, {"id": "2710427532541308"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER", "CO_OP"], "id": "25649479581303286"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1566552014526318"}]}, "baseline_offer": {"id": "1566552014526318"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1765526400, "status": "PUBLISHED", "id": "1566552014526318"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "28264131066504778", "version": "1.1.0"}, "id": "25740082985581976", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "25080401538211096", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "28264131066504778"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "25740082985581976"}]}, "change_log": "Patch 1.1.0 Notes \n\nNew Features\n- Added in game announcements!\n- You can now cast most spells while holding a weapon! Some spells require slamming your hammer on the ground or shooting an arrow\n- Major bot improvements (dodging, blocking, dashing/teleporting, healing, fleeing, guardian movement, etc...)\n- Boulders can now be launched with any Geomancer weapon!\n\nBalancing Changes:\n- Crystal lockout timers no longer increase past 30 seconds\n- Adjusted bot difficulty in Conquest and lowered it for multiplayer matches\n- Lowered Geomancer damage by ~10%\n- Reduced ring upgrade costs\n- Reduced Vacuum Burst's silence duration to 3 seconds\n- Removed two hand mana cost penalty when a spell or weapon in one hand is fully charged\n- Reduced levels of some of the bots in the last two levels of Gauntlet\n- Reduced the amount of homing for most projectiles\n- Reduced the damage of super golems\n\nBug Fixes and Improvements:\n- Fixed various issues with bot hand positioning and twisting\n- Removed spell cast delays on various spells like the Boulder in multiplayer matches\n- Fixed a bow issues where the string could get stuck or the secondary arrow mode would always activate\n- Improved weapon throwing accuracy\n- Improved spell hit and block accuracy at high latency\n- Prevented players from damaging guardians when outside their attack range\n- Fixed a crash that could happen while using weapons in multiplayer matches\n- Fixed issues with golem aiming and golems getting stuck\n- Fixed an issue which caused the barrier spell to shift position rapidly\n- Some spell effects no longer make long streaks when spawning in multiplayer matches\n- Spell menu changes: Spell menu spells are no longer restricted to one hand\n- Many minor fixes\n\nHotfix 1:\n- Fixed issue which could prevent players from joining a multiplayer match when playing a single player mode", "created_date": 1786224542, "id": "28264131066504778", "version": "1.1.0", "version_code": 62, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "25080401538211096", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "28264131066504778"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "25740082985581976"}]}, "change_log": "Patch 1.1.0 Notes\n\nNew Features:\n- Added in game announcements!\n- You can now cast most spells while holding a weapon! Some spells require slamming your hammer on the ground or shooting an arrow\n- Major bot improvements (dodging, blocking, dashing/teleporting, healing, fleeing, guardian movement, etc...)\n- Boulders can now be launched with any Geomancer weapon!\n\nBalancing Changes:\n- Crystal lockout timers no longer increase past 30 seconds\n- Adjusted bot difficulty in Conquest and lowered it for multiplayer matches\n- Lowered Geomancer damage by ~10%\n- Reduced ring upgrade costs\n- Reduced Vacuum Burst's silence duration to 3 seconds\n- Removed two hand mana cost penalty when a spell or weapon in one hand is fully charged\n- Reduced levels of some of the bots in the last two levels of Gauntlet\n- Reduced the amount of homing for most projectiles\n- Reduced the damage of super golems\n\nBug Fixes and Improvements:\n- Fixed various issues with bot hand positioning and twisting\n- Removed spell cast delays on various spells like the Boulder in multiplayer matches\n- Fixed a bow issues where the string could get stuck or the secondary arrow mode would always activate\n- Improved weapon throwing accuracy\n- Improved spell hit and block accuracy at high latency\n- Prevented players from damaging guardians when outside their attack range\n- Fixed a crash that could happen while using weapons in multiplayer matches\n- Fixed issues with golem aiming and golems getting stuck\n- Fixed an issue which caused the barrier spell to shift position rapidly\n- Some spell effects no longer make long streaks when spawning in multiplayer matches\n- Spell menu changes: Spell menu spells are no longer restricted to one hand\n- Many minor fixes", "created_date": 1786211160, "id": "28262370666680818", "version": "1.1.0", "version_code": 61, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "25080401538211096", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "28264131066504778"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": []}, "change_log": null, "created_date": 1785557076, "id": "28169724345945451", "version": "1.0.16", "version_code": 60, "release_status": "PENDING", "status": "DRAFT", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "25080401538211096", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "28264131066504778"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": []}, "change_log": null, "created_date": 1784663327, "id": "28047636104820943", "version": "1.0.16", "version_code": 59, "release_status": "PENDING", "status": "DRAFT", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "25080401538211096", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "28264131066504778"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": []}, "change_log": null, "created_date": 1784334088, "id": "28005041095747111", "version": "1.0.16", "version_code": 58, "release_status": "PENDING", "status": "DRAFT", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}]}}, "viewer": {"user": null}}}
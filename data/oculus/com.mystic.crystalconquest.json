=63q4GlkhDbIQ7kNvwHCEBdw&_nc_oc=Adm-84NDCt0VLFzzF6QU0JrQEvuwBjUCGlwf4LUcWn6rMuXR8ocQr-4KYIdNnQ_96C0&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AftAR-I645Gbekg6rLqY42_uHbEg7iHB_IX5UndxbJwAIg&oe=699B003D"}, {"file_name": "Screenshot3.png", "id": "1358978606022789", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499618937_1358978609356122_816223264038509773_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NH7eZvgblDgQ7kNvwFp-VU_&_nc_oc=AdlB_SeHCFrTz1yDcpu5zIxmB4P7R1zMOqb5NCe674bGNRb6jYxINnZxmTLlDb7nl94&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AfsKDvAagxWNXktLrPUXHxF0nMAZ6TNPosocUP4cbjBV-g&oe=699AF862"}, {"file_name": "updatedscreenshot.png", "id": "1523088678946721", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499618499_1523088682280054_3963745572868175892_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qTxEREI-kiUQ7kNvwGRacPu&_nc_oc=AdkBOu6eyq9zC_hux8nE4KnxmcDjIRfnUoK8z1A9Pgf5_DbSGwtznDHOyFT8dmxN8OM&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_Aftdu5LtLCkYkU4jzMsec0UIwBtkJovVEGF7O2yGz3SBYQ&oe=699AEFBE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer cover image 2560x1440 - Copy.png", "id": "2117929769014258", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499619668_2117929772347591_7305990331590425037_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MCn5LgjqCeYQ7kNvwH7KyBl&_nc_oc=Adnf1ZfSd6A7MjhLwO_HFtcR8waAZ665u-9Xj3b08yKbz-uOnqdlEMuIs7DyvpNwOq0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AfuhYg4eM2-zAkMnaibb2a8yR2hi3la2VOrOmCokyr9T5A&oe=699AFFB1"}, "display_name": "Crystal Conquest", "keywords": [], "long_description": "Crystal Conquest is a Free-To-Play VR game where you control the elements and battle for victory. Imagine the elemental magic of Avatar in VR across fighting, MOBA, and level based campaign modes!\n\n\n**Key Features:**\n\n- Play as elemental mages - 4 available by default, unlock more over time\n\n- Choose which spells to take into battle, unlock more over time\n\n- Customize your in-match shop - choose your potions, wands and other items, unlock more over time\n\n- Different modes to suit your mood: Duel (1v1), Conquest MOBA (3v3) or Gauntlet (players vs waves of enemies)\n\n- Single player or Multiplayer\n\n- Private lobbies available, bring your friends\n\n- Skills-based matchmaking to pair you with equal opponents\n\n- Shape the game's future by communicating with the Studio on Discord\n\n\n{719459321207239}\n\n\n\n**Build your mage:** Choose the class that matches your playstyle and elements. Unlock class variants as you grow and customize your build.\n\n{2529778434085166}\n\n\n\n**Harness the elements:** Battle with elemental magic where each element has unique properties. Use earth, fire, water, and wind to block, dodge, and deflect your enemy's attacks.\n\n{1766498407381295}\n\n\n\n**Grow in Power:** Level up and unlock even more epic spells that change how you control the elements.\n\n{1071429428371112}\n\n\n\n**Choose Your Battle Mode:** Battle in 3v3 matches to capture crystals and topple towers, face off in duels, or team up in co-op to take on waves of AI. All modes support AI for solo or practice play.\n\n{1283539703534860}", "short_description": "Crystal Conquest is a free-to-play VR game where you control the elements and battle for victory. Harness the power of fire, water, earth, and air in epic 3v3 MOBA-inspired combat or intense dueling modes!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.mysticinteractive.com/s/MYSTIC-INTERACTIVE-PRIVACY-POLICY.pdf", "developer_terms_of_service_url": "https://www.mysticinteractive.com/terms-of-use", "publisher_name": "Mystic Interactive", "support_website_url": "https://discord.gg/KV9f2dwTdY", "website_url": "https://www.crystalconquest.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "
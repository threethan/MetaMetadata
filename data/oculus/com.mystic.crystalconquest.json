cdn.com/v/t64.5771-25/499296288_1173864237638279_2462020394851590536_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=niDCy0lIDxQQ7kNvwF8JnyF&_nc_oc=AdqkDc92lqY9QBq8N3iMI1YwPO89nZtvNFJ46JEEHb9fVmjBjbUy8O29ST6DJoPMpR0&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7N00j2pbNwhSJU9ndcYfhWThnawFwGTIOpt1VwCHtkGA&oe=6A159BBD"}, {"file_name": "Screenshot3.png", "id": "1358978606022789", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499618937_1358978609356122_816223264038509773_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wfjThyCg1SkQ7kNvwH0bG3l&_nc_oc=AdocZeLFb0QRpWPIuiR6v50PzAgT7PHtGtDzoFOjSL864tsb_910myTlhOC_DuOGl4g&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7OkqGSKY0g7q91z2M6g_OInHXxT8NngI4iTTvbsTAk_w&oe=6A1593E2"}, {"file_name": "updatedscreenshot.png", "id": "1523088678946721", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/499618499_1523088682280054_3963745572868175892_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cawddTLqM0EQ7kNvwHGQZtX&_nc_oc=AdphTD5p8wVPWA7K9mHZXzHspfcmrrxrUxTeO4Sw7oqYrcvxCBfLeI3n01zKPNdeYcc&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5dvSS_4ast9GdYIZJidPeOcxY2bEW-PFKQFTCbz6go-w&oe=6A15C37E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer cover image 2560x1440 - Copy.png", "id": "2117929769014258", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499619668_2117929772347591_7305990331590425037_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6VpgBGKl-KsQ7kNvwFaLyz0&_nc_oc=Adqpb9EuEJvXBKdvdc7ZENW6rHh7rYVrMWanDiQxthsCYBKOOgHq-psReQXMbbpXOr4&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7c4wHEAVzkTHS8VzZzu8_0Ad6pi58RIoCyJ7f8dyZ3Hg&oe=6A159B31"}, "display_name": "Crystal Conquest", "keywords": ["moba", "free", "multiplayer", "singleplayer", "magic"], "long_description": "Crystal Conquest is a Free-To-Play VR game where you control the elements and battle for victory. Imagine the elemental magic of Avatar in VR across fighting, MOBA, and level based campaign modes!\n\n\n**Key Features:**\n\n- Play as elemental mages - 4 available by default, unlock more over time\n\n- Choose which spells to take into battle, unlock more over time\n\n- Customize your in-match shop - choose your potions, wands and other items, unlock more over time\n\n- Different modes to suit your mood: Duel (1v1), Conquest MOBA (3v3) or Gauntlet (players vs waves of enemies)\n\n- Single player or Multiplayer\n\n- Private lobbies available, bring your friends\n\n- Skills-based matchmaking to pair you with equal opponents\n\n- Shape the game's future by communicating with the Studio on Discord\n\n\n{719459321207239}\n\n\n\n**Build your mage:** Choose the class that matches your playstyle and elements. Unlock class variants as you grow and customize your build.\n\n{2529778434085166}\n\n\n\n**Harness the elements:** Battle with elemental magic where each element has unique properties. Use earth, fire, water, and wind to block, dodge, and deflect your enemy's attacks.\n\n{1766498407381295}\n\n\n\n**Grow in Power:** Level up and unlock even more epic spells that change how you control the elements.\n\n{1071429428371112}\n\n\n\n**Choose Your Battle Mode:** Battle in 3v3 matches to capture crystals and topple towers, face off in duels, or team up in co-op to take on waves of AI. All modes support AI for solo or practice play.\n\n{1283539703534860}", "short_description": "Crystal Conquest is a free-to-play VR game where you control the elements and battle for victory. Harness the power of fire, water, earth, and air in epic 3v3 MOBA-inspired combat or intense dueling modes!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.mysticinteractive.com/s/MYSTIC-INTERACTIVE-PRIVACY-POLICY.pdf", "developer_terms_of_service_url": "https://www.mysticinteractive.com/terms-of-use", "publisher_name": "Mystic Interactive", "support_website_url": "https://discord.gg/KV9f2dwTdY", "website_url": "https://www.crystalconquest.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "2710427532541308"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER", "CO_OP"], "id": "26998495699734994"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/499619098_729487069627173_4714945380630898144_n.png?stp=dst-png_s360x360&_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m0RiU6TTwyAQ7kNvwGjtFGs&_nc_oc=Adru2P9Kzn2e0r0gOM0-UnZUBnfeM0hJTXhvmoOtQ-ww7eoLoDDX6fUIGSyIO8yCctc&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7zvsbCRTOfL6TpfRJy1nJwzimBoI6zGZpC5FN_W4BRlw&oe=6A1597A6"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Crystal Conquest", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Shooter", "id": "3744040075834813"}, {"topic_name": "Fighting", "id": "2710427532541308"}, {"topic_name": "Action", "id": "459781504968480"}], "release_date": 1765526400, "lastRevision": {"nodes": [{"id": "25080401598211090", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "25080401538211096", "is_first_party": false, "enables_in_app_ads": false, "is_concept": false, "platform": "ANDROID_6DOF"}, "iarc_cert": {"id": "1499
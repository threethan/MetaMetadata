cdn.com/v/t64.5771-25/499296288_1173864237638279_2462020394851590536_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oa2vHZJOJT0Q7kNvwHhcB32&_nc_oc=Adqzl3PkU5SgxzVnR4BGKSGC9Yh4Je4XdyVnOr704leJ1rJAJVdyisKe_qZNApqawTA&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afz4BSvkhx6OFrqyXNsXMzgFP1dzpVZO8rSMIj-zCeARww&oe=69C28D3D"}, {"file_name": "Screenshot3.png", "id": "1358978606022789", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499618937_1358978609356122_816223264038509773_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8_UKFv7PLhMQ7kNvwEFjhqB&_nc_oc=AdqZf9IN2fabzA6PgHBB0ZJwzdNVq6Gcx6VLbeo8AwbdFciUOSqvUaP7U608L-bku5k&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzLoLdkdB2uJs7GHh2QALwEcIMceB1tz4CgeswAcZq3iA&oe=69C28562"}, {"file_name": "updatedscreenshot.png", "id": "1523088678946721", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/499618499_1523088682280054_3963745572868175892_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XyqFJ6oZkaUQ7kNvwFztXMO&_nc_oc=AdrdkGhblJGXGYnr9kcWwpOUPsQKFxfYEwPG-pHFzezz9_DxjY7ssUNyPpgm1OnLXqQ&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afy-Bz3hfDYPopAv0Bs1hceU9wvD1_IAANCzPlOnjirASw&oe=69C27CBE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer cover image 2560x1440 - Copy.png", "id": "2117929769014258", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499619668_2117929772347591_7305990331590425037_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=95EYXUnVfR8Q7kNvwHudA62&_nc_oc=AdrMb16ZKbg84jBccgzdTHfnSZiuv1JQl35delTHmjJ2bCBB2qFZbHbs-Bg5PD4HpvA&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwidZ-n5avmvfBXvX7WhwvT4yPxaaicJZiaLJR21GKTtg&oe=69C28CB1"}, "display_name": "Crystal Conquest", "keywords": [], "long_description": "Crystal Conquest is a Free-To-Play VR game where you control the elements and battle for victory. Imagine the elemental magic of Avatar in VR across fighting, MOBA, and level based campaign modes!\n\n\n**Key Features:**\n\n- Play as elemental mages - 4 available by default, unlock more over time\n\n- Choose which spells to take into battle, unlock more over time\n\n- Customize your in-match shop - choose your potions, wands and other items, unlock more over time\n\n- Different modes to suit your mood: Duel (1v1), Conquest MOBA (3v3) or Gauntlet (players vs waves of enemies)\n\n- Single player or Multiplayer\n\n- Private lobbies available, bring your friends\n\n- Skills-based matchmaking to pair you with equal opponents\n\n- Shape the game's future by communicating with the Studio on Discord\n\n\n{719459321207239}\n\n\n\n**Build your mage:** Choose the class that matches your playstyle and elements. Unlock class variants as you grow and customize your build.\n\n{2529778434085166}\n\n\n\n**Harness the elements:** Battle with elemental magic where each element has unique properties. Use earth, fire, water, and wind to block, dodge, and deflect your enemy's attacks.\n\n{1766498407381295}\n\n\n\n**Grow in Power:** Level up and unlock even more epic spells that change how you control the elements.\n\n{1071429428371112}\n\n\n\n**Choose Your Battle Mode:** Battle in 3v3 matches to capture crystals and topple towers, face off in duels, or team up in co-op to take on waves of AI. All modes support AI for solo or practice play.\n\n{1283539703534860}", "short_description": "Crystal Conquest is a free-to-play VR game where you control the elements and battle for victory. Harness the power of fire, water, earth, and air in epic 3v3 MOBA-inspired combat or intense dueling modes!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.mysticinteractive.com/s/MYSTIC-INTERACTIVE-PRIVACY-POLICY.pdf", "developer_terms_of_service_url": "https://www.mysticinteractive.com/terms-of-use", "publisher_name": "Mystic Interactive", "support_website_url": "https://discord.gg/KV9f2dwTdY", "website_url": "https://www.crystalconquest.com/", "category": nul
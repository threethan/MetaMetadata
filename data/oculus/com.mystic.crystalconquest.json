nary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "25080401538211096", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "27995255193392368"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": []}, "change_log": null, "created_date": 1784334088, "id": "28005041095747111", "version": "1.0.16", "version_code": 58, "release_status": "PENDING", "status": "DRAFT", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "25080401538211096", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "27995255193392368"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "25740082985581976"}]}, "change_log": "Patch 1.0.15 Hotfix 1\n\nNew Features:\n- Added speed run leaderboards for solo play Conquest during Conquest tournaments\n\nBug Fixes:\n- Fixed issues with projectile cast delays due to lag, especially with barrage\n- Fixed projectile visuals not showing up with Mind Spike\n- Prevented punches from being triggered when you set down your controllers", "created_date": 1784261422, "id": "27995255193392368", "version": "1.0.15", "version_code": 57, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "25080401538211096", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "27995255193392368"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "25740082985581976"}]}, "change_log": "Patch 1.0.15 Notes\n\nNew Features:\n- Added a flying geode enemy which can be found in the Conquest arena!\n\nBalancing Changes:\n- Increased max mana for all characters by roughly 25%\n- Increased mana regen bonuses from meditation and crystal zones by 25%\n- Greatly increased the stat bonuses of ring upgrades. Also increased the upgrade gold cost\n- Increased defensive power of Shadow spells against Aether spells (tower, geode attacks)\n- Reduced the casting speed of AI bots, especially at lower difficulties\n- Buffed two monster camp buffs (the camps at the portals and above the crystals)\n\n\nBug Fixes and Improvements:\n- Various bot pathing improvements\n- Improved ragdoll responsiveness and stability\n- Fixed various issues that can happen when players leave a Conquest match early\n- Fixed issues with monster gold and XP rewards in Conquest\n- Fixed issues with saving player settings\n- Increased the size of smaller golems", "created_date": 1783193550, "id": "27862602806657608", "version": "1.0.15", "version_code": 56, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}]}}, "viewer": {"user": null}}}
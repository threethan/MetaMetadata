2&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OFAN935UTX8Q7kNvwH7mUO-&_nc_oc=AdrRy93C7Vq2xJD0FWKet8RVkXTOF_2-3QQeEMEmNTTX3vCVhc1nGrvAnWbmv1gRNvg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM5WVI2dSuKEcxVBgSoVFaK6z1JoSzwjusJMT7kjy2gAQ&oe=6AC64431"}, "display_name": "Crystal Conquest", "keywords": [], "long_description": "Crystal Conquest is a **Free-To-Play** VR game where you **control the elements** and battle for victory. Harness the power of fire, water, earth, and air in epic 3v3 MOBA-inspired combat or intense dueling modes! Team up with your friends against AI or choose to fight in PvP!\n\n**Build your mage:** Choose the class that matches your playstyle and elements. Unlock class variants as you grow and customize your build. \n\n**Harness the elements:** Battle with elemental magic where each element has unique properties. Use earth, fire, water, and wind to block, dodge, and deflect your enemy's attacks. \n\n**Grow in Power:** Level up and unlock even more epic spells that change how you control the elements.\n\n**Choose Your Battle Mode:** Battle in 3v3 matches to capture crystals and topple towers, face off in duels, or team up in co-op to take on waves of AI. All modes support AI for solo or practice play.", "short_description": "Crystal Conquest is a free-to-play VR game where you control the elements and battle for victory. Harness the power of fire, water, earth, and air in epic 3v3 MOBA-inspired combat or intense dueling modes!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.mysticinteractive.com/s/MYSTIC-INTERACTIVE-PRIVACY-POLICY.pdf", "developer_terms_of_service_url": "https://www.mysticinteractive.com/terms-of-use", "publisher_name": "Mystic Interactive", "support_website_url": "https://discord.gg/KV9f2dwTdY", "website_url": "https://www.crystalconquest.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES
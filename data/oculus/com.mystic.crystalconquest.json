cdn.com/v/t64.5771-25/499296288_1173864237638279_2462020394851590536_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=X2cUJchDngMQ7kNvwEPFb4T&_nc_oc=Adp-6fER7vELtg_1QpOWVK8Nbtb-m3qEBU6zzSMDVqy4weFM5sV2uwGEzNclpW--X-A&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9ZLLx_rDa4hzkJtLHCZ2gRC228S8Jll1Yu4gGILlNlgw&oe=6A241C3D"}, {"file_name": "Screenshot3.png", "id": "1358978606022789", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499618937_1358978609356122_816223264038509773_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aw56USq9DxsQ7kNvwEdmyXB&_nc_oc=Ado21YGZ0gPqoPKqyCXiQ8K3uHqkL5m-SwKA4Rfk-jBA7l4UhoYrQtlz_yzEx2kgsO8&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9kvF33lUQp9nPksUHowBkUf_3HvBH5ZrNFbfWoVysZEg&oe=6A241462"}, {"file_name": "updatedscreenshot.png", "id": "1523088678946721", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499618499_1523088682280054_3963745572868175892_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nkMKnMM4CKsQ7kNvwEL-BZe&_nc_oc=AdpscxiW1hctDIlKKXy-AcT5zbUf8oHVy3Iig39gfixqNXmfwsNkOdg3JZqMY5DRK6U&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-wqN0jFSOBXDlKEV6WoEo7LaLcJ_9sCmjf1uTi2kLQCA&oe=6A2443FE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer cover image 2560x1440 - Copy.png", "id": "2117929769014258", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499619668_2117929772347591_7305990331590425037_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SHY04SmPlQ0Q7kNvwHlHmrt&_nc_oc=Adof3ib3hsx-a1JoGVvzu7GJ8mViK1JeFI2c32A8PKRmx1Y3MjEpJxkNdZQkNZlEcUk&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_yv_zfBcTlA5ZTUHYPoPGBfKtlWUcuYSfRH4h0-u20Hg&oe=6A241BB1"}, "display_name": "Crystal Conquest", "keywords": ["moba", "free", "multiplayer", "singleplayer", "magic"], "long_description": "Crystal Conquest is a Free-To-Play VR game where you control the elements and battle for victory. Imagine the elemental magic of Avatar in VR across fighting, MOBA, and level based campaign modes!\n\n\n**Key Features:**\n\n- Play as elemental mages - 4 available by default, unlock more over time\n\n- Choose which spells to take into battle, unlock more over time\n\n- Customize your in-match shop - choose your potions, wands and other items, unlock more over time\n\n- Different modes to suit your mood: Duel (1v1), Conquest MOBA (3v3) or Gauntlet (players vs waves of enemies)\n\n- Single player or Multiplayer\n\n- Private lobbies available, bring your friends\n\n- Skills-based matchmaking to pair you with equal opponents\n\n- Shape the game's future by communicating with the Studio on Discord\n\n\n{719459321207239}\n\n\n\n**Build your mage:** Choose the class that matches your playstyle and elements. Unlock class variants as you grow and customize your build.\n\n{2529778434085166}\n\n\n\n**Harness the elements:** Battle with elemental magic where each element has unique properties. Use earth, fire, water, and wind to block, dodge, and deflect your enemy's attacks.\n\n{1766498407381295}\n\n\n\n**Grow in Power:** Level up and unlock even more epic spells that change how you control the elements.\n\n{1071429428371112}\n\n\n\n**Choose Your Battle Mode:** Battle in 3v3 matches to capture crystals and topple towers, face off in duels, or team up in co-op to take on waves of AI. All modes support AI for solo or practice play.\n\n{1283539703534860}", "short_description": "Crystal Conquest is a free-to-play VR game where you control the elements and battle for victory. Harness the power of fire, water, earth, and air in epic 3v3 MOBA-inspired combat or intense dueling modes!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.mysticinteractive.com/s/MYSTIC-INTERACTIVE-PRIVACY-POLICY.pdf", "developer_terms_of_service_url": "https://www.mysticinteractive.com/terms-of-use", "publisher_name": "Mystic Interactive", "support_website_url": "https://discord.gg/KV9f2dwTdY", "website_url": "https://www.crystalconquest.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "2710427532541308"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER", "CO_OP"], "id": "26998495699734994"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/499619098_729487069627173_4714945380630898144_n.png?stp=dst-png_s360x360&_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uhNAgdzBmrgQ7kNvwEbYTI2&_nc_oc=AdoaY3p_NivXGd2TLnI1uYXtQVx5uHZMIp5o8s0tcDHFz619X3U3Y2Bcma7hWvrx6zo&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af86X85k50Xjpm9wgb2XK33F5RuVJOwj9qUlUvPBX5LQDQ&oe=6A241826"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Crystal Conquest", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Shooter", "id": "3744040075834813"}, {"topic_name": "Fighting", "id": "2710427532541308"}, {"topic_name": "Action", "id": "459781504968480"}], "release_date": 1765526400, "lastRevision": {"nodes": [{"id": "25080401598211090", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "25080401538211096", "is_first_party": false, "enables_in_app_ads": false, "is_concept": false, "platform": "ANDROID_6DOF"}, "iarc_cert": {"id": "1499
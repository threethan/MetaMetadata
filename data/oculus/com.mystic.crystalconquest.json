606022789", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499618937_1358978609356122_816223264038509773_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D86rsXWo4wIQ7kNvwHWxUDy&_nc_oc=Adp8-ipxv_j4qZakPzTCUrmTifcMKllHZ2WOdecBT3NmHYz56vl8KIrv7R-ozbcgjN0&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4woGuSTvpeSdppdx3bZu3Jxyp4h3Be7QeVQcsz-a9eiw&oe=6A0EFC62"}, {"file_name": "Screenshot4.png", "id": "1369823617949502", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/499619174_1369823621282835_4051724597108621584_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JbuOGj9kMn4Q7kNvwED-FnJ&_nc_oc=AdpMupnEoVHHvNTuoV09HTi7CJRIFfqpdjaQYlWnOH2ekrjdn_0hUd5zuVNG--X9apg&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5vgFAy0YmWGarCqMQR0j0PVEVDk5ABQ_PGKTrJYNXhqg&oe=6A0EF35E"}, {"file_name": "Screenshot5.png", "id": "1887484512204627", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499619805_1887484515537960_7832102536243317228_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=si0_ttW6KMwQ7kNvwFptGSA&_nc_oc=AdoSeQsI8pH7pUEslChKPtaYeN-U1-kcjamDMqBDB106W3d8THdKG0pEsuMvp-vPYaE&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7DPDXmm-CxCJYj_jcw0oMa7qUsDCESESBc9JIAQGgfBw&oe=6A0F243D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer cover image 2560x1440 - Copy.png", "id": "2117929769014258", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499619668_2117929772347591_7305990331590425037_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oSSO3ZPDIa4Q7kNvwGEX9Zc&_nc_oc=Adq8YNepvQBFa74iiWXcQ-Z2Vktjsg9S6kM6auYhnNdwiXR02bgXeVdwPintOhh6tXk&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4w_1kOn6Bt0Hvg2TNBd6IUKIQHFmRRWsVPipdL5DGaug&oe=6A0F03B1"}, "display_name": "Crystal Conquest", "keywords": [], "long_description": "Crystal Conquest is a **Free-To-Play** VR game where you **control the elements** and battle for victory. Harness the power of fire, water, earth, and air in epic 3v3 MOBA-inspired combat or intense dueling modes! Team up with your friends against AI or choose to fight in PvP!\n\n**Build your mage:** Choose the class that matches your playstyle and elements. Unlock class variants as you grow and customize your build. \n\n**Harness the elements:** Battle with elemental magic where each element has unique properties. Use earth, fire, water, and wind to block, dodge, and deflect your enemy's attacks. \n\n**Grow in Power:** Level up and unlock even more epic spells that change how you control the elements.\n\n**Choose Your Battle Mode:** Battle in 3v3 matches to capture crystals and topple towers, face off in duels, or team up in co-op to take on waves of AI. All modes support AI for solo or practice play.", "short_description": "Crystal Conquest is a free-to-play VR game where you control the elements and battle for victory. Harness the power of fire, water, earth, and air in epic 3v3 MOBA-inspired combat or intense dueling modes!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.mysticinteractive.com/s/MYSTIC-INTERACTIVE-PRIVACY-POLICY.pdf", "developer_terms_of_service_url": "https://www.mysticinteractive.com/terms-of-use", "publisher_name": "Mystic Interactive", "support_website_url": "https://discord.gg/KV9f2dwTdY", "website_url": "https://www.crystalconquest.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "3744040075834813"}, {"id": "2710427532541308"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER", "CO_OP"], "id": "25649479581303286"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1566552014526318"}]}, "baseline_offer": {"id": "1566552014526318"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1765526400, "status": "PUBLISHED", "id": "1566552014526318"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "27255560764028485", "version": "1.0.11"}, "id": "25740082985581976", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "25080401538211096", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "27255560764028485"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "25740082985581976"}]}, "change_log": "Patch 1.0.11 Hotfix 2\n- Fixed issues with casting the wrong spell while using the Transmute ability\n- Fixed an issue which allowed players to extend the Dragon's Breath duration indefinitely", "created_date": 1778965452, "id": "27255560764028485", "version": "1.0.11", "version_code": 45, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "25080401538211096", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "27255560764028485"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "25740082985581976"}]}, "change_log": "Patch 1.0.11 Hotfix 1\n- Renamed class levels to Mastery to avoid confusion\n- Fixed an issue which was preventing mastery gains from showing up in the UI (you were earning mastery, but you had to restart the game to see the changes)\n- Made several other UI fixes involving mastery", "created_date": 1778882856, "id": "27242936615290900", "version": "1.0.11", "version_code": 44, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "25080401538211096", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "27255560764028485"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "25740082985581976"}]}, "change_log": "Patch 1.0.11 Notes\n\nNew Features:\n- Added 4 new unlockable signature spells: Burning Bow, Purging Whip, Giant's Hammer, and Leeching Link!\n- Players can now toggle crouching by pressing down on the right joystick. The alternative way of activating Fly is now the B button\n- Added an announcement scroll to the Hub\n- Added tournaments and tournament leaderboards! The first Duel tournament starts on 5/16!\n\nBalancing Changes:\n- Reduced golem damage vs players. Increased siege and melee golem damage vs towers\n- Reduced difficulty of last two Gauntlet levels slightly\n- Reduced Daze duration for the default Hammer to 3 seconds\n\nAI Improvements:\n- Fixed AI projectile aiming issues\n- Fixed various bot pathing issues involving towers and crystal capturing\n\nBug Fixes and Improvements:\n- Improved FPS on all Quest devices\n- Fixed an issue which was causing black edges to appear when players turned their head on Quest devices\n- Fixed an bug that could cause players to be kicked off of all queues when 
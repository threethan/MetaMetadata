=2YqJCcohZlEQ7kNvwG1e-vX&_nc_oc=Adn8UBQ6xqTut0Kzds8EEx0N4WUUMv0E5Vo8n0nmHt3ZazJiJnwMJlvhS1h1b5NRFog&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Aftn9Nc_qeTQrzKWePFmphw_o8bSWwngYYgGF8xYP9cDow&oe=69A6DDBD"}, {"file_name": "Screenshot3.png", "id": "1358978606022789", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499618937_1358978609356122_816223264038509773_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2EIlaPLsX2IQ7kNvwExBgxw&_nc_oc=Adl0ROXhOEzLBOZY8qrhsZjS_7wZc3WZJFM__GfjhOQO8Z9J4wjIDUycX5nWkZPuy14&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AftF_puWNoO8m8qcBPC6Q2a3Gxif3lkNKtiATYLD1AYsZQ&oe=69A6D5E2"}, {"file_name": "updatedscreenshot.png", "id": "1523088678946721", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499618499_1523088682280054_3963745572868175892_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kFylC7vV-3sQ7kNvwH3Rakm&_nc_oc=AdmyvUoXDY82ravHBeLgM93BV1y5om1ANq9dykC58h9yisBHo_PkmFBldroZYIk6JvY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AftGIKSXgleshiYj4Y9ehZpp3Ijcj023UXm-AmEwdn33NQ&oe=69A6CD3E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer cover image 2560x1440 - Copy.png", "id": "2117929769014258", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499619668_2117929772347591_7305990331590425037_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xniVeckb_G8Q7kNvwFi4PXe&_nc_oc=AdnKLgXQohxyIsPPZ0_BciPIidvRWl38K5nsoTtCGs_CnI0OMjP3JqA5ZSbmBkJ8cVQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afuyn-CKNJnJUDsbNcgG22BdFfOB-HcGc1lO7NE2hpCdOg&oe=69A6DD31"}, "display_name": "Crystal Conquest", "keywords": [], "long_description": "Crystal Conquest is a Free-To-Play VR game where you control the elements and battle for victory. Imagine the elemental magic of Avatar in VR across fighting, MOBA, and level based campaign modes!\n\n\n**Key Features:**\n\n- Play as elemental mages - 4 available by default, unlock more over time\n\n- Choose which spells to take into battle, unlock more over time\n\n- Customize your in-match shop - choose your potions, wands and other items, unlock more over time\n\n- Different modes to suit your mood: Duel (1v1), Conquest MOBA (3v3) or Gauntlet (players vs waves of enemies)\n\n- Single player or Multiplayer\n\n- Private lobbies available, bring your friends\n\n- Skills-based matchmaking to pair you with equal opponents\n\n- Shape the game's future by communicating with the Studio on Discord\n\n\n{719459321207239}\n\n\n\n**Build your mage:** Choose the class that matches your playstyle and elements. Unlock class variants as you grow and customize your build.\n\n{2529778434085166}\n\n\n\n**Harness the elements:** Battle with elemental magic where each element has unique properties. Use earth, fire, water, and wind to block, dodge, and deflect your enemy's attacks.\n\n{1766498407381295}\n\n\n\n**Grow in Power:** Level up and unlock even more epic spells that change how you control the elements.\n\n{1071429428371112}\n\n\n\n**Choose Your Battle Mode:** Battle in 3v3 matches to capture crystals and topple towers, face off in duels, or team up in co-op to take on waves of AI. All modes support AI for solo or practice play.\n\n{1283539703534860}", "short_description": "Crystal Conquest is a free-to-play VR game where you control the elements and battle for victory. Harness the power of fire, water, earth, and air in epic 3v3 MOBA-inspired combat or intense dueling modes!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.mysticinteractive.com/s/MYSTIC-INTERACTIVE-PRIVACY-POLICY.pdf", "developer_terms_of_service_url": "https://www.mysticinteractive.com/terms-of-use", "publisher_name": "Mystic Interactive", "support_website_url": "https://discord.gg/KV9f2dwTdY", "website_url": "https://www.crystalconquest.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "
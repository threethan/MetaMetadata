606022789", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499618937_1358978609356122_816223264038509773_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iFuva0QC6_oQ7kNvwFiqE3X&_nc_oc=AdpQ93-arP8J6A2GuxnpxU4ihkAMjtl252uL-4ZP46hdv91Yoa0CSXz35c1Bql9CKlM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4a9yekxLmTuU-oRDGVk2xC33dG5X0qRMHMM_h6-wIxeQ&oe=69FC8762"}, {"file_name": "Screenshot4.png", "id": "1369823617949502", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499619174_1369823621282835_4051724597108621584_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FFWjPDXX9dQQ7kNvwEwOSUR&_nc_oc=Adrl6SfkPTV8T_55wexT15o62cS202IVPVzD_jMfC-muI3rQEgJ_EBGU6e1DDtkIxQE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af56Dqz0r8i9YWPek2bATg5GvXlVwtbZgYVFKMe9WRFaWw&oe=69FC7E5E"}, {"file_name": "Screenshot5.png", "id": "1887484512204627", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499619805_1887484515537960_7832102536243317228_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lq0vVL13Q30Q7kNvwFsxTyW&_nc_oc=AdqjXNkp18ndDV7xxXJWn1q5JDzStyQ4lZi_T01LnCOLax_Xs__YqXINGNF8CuY35HU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7RHyl-3moKiRvkKj_dMFgATyTjWF5aDKl2AduWBiw45g&oe=69FCAF3D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer cover image 2560x1440 - Copy.png", "id": "2117929769014258", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499619668_2117929772347591_7305990331590425037_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Rwb7XnTl1GQQ7kNvwEzDFt8&_nc_oc=AdrriANNn-zDQASaUfL4VIxPBJD6OcIfNziTgBrmkWEr32NWV7Q1xHSHUqyogXPVs-s&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af59KhwFJ0TiCUydVrrGGExCvEe1gRlag9ymXbQYX4z5CA&oe=69FC8EB1"}, "display_name": "Crystal Conquest", "keywords": [], "long_description": "Crystal Conquest is a **Free-To-Play** VR game where you **control the elements** and battle for victory. Harness the power of fire, water, earth, and air in epic 3v3 MOBA-inspired combat or intense dueling modes! Team up with your friends against AI or choose to fight in PvP!\n\n**Build your mage:** Choose the class that matches your playstyle and elements. Unlock class variants as you grow and customize your build. \n\n**Harness the elements:** Battle with elemental magic where each element has unique properties. Use earth, fire, water, and wind to block, dodge, and deflect your enemy's attacks. \n\n**Grow in Power:** Level up and unlock even more epic spells that change how you control the elements.\n\n**Choose Your Battle Mode:** Battle in 3v3 matches to capture crystals and topple towers, face off in duels, or team up in co-op to take on waves of AI. All modes support AI for solo or practice play.", "short_description": "Crystal Conquest is a free-to-play VR game where you control the elements and battle for victory. Harness the power of fire, water, earth, and air in epic 3v3 MOBA-inspired combat or intense dueling modes!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.mysticinteractive.com/s/MYSTIC-INTERACTIVE-PRIVACY-POLICY.pdf", "developer_terms_of_service_url": "https://www.mysticinteractive.com/terms-of-use", "publisher_name": "Mystic Interactive", "support_website_url": "https://discord.gg/KV9f2dwTdY", "website_url": "https://www.crystalconquest.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "3744040075834813"}, {"id": "2710427532541308"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER", "CO_OP"], "id": "25649479581303286"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1566552014526318"}]}, "baseline_offer": {"id": "1566552014526318"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1765526400, "status": "PUBLISHED", "id": "1566552014526318"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "26922545773996654", "version": "1.0.10"}, "id": "25740082985581976", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "25080401538211096", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "26922545773996654"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "25740082985581976"}]}, "change_log": "Patch 1.0.10 Notes\n\nNew Features:\n- Added the ability to punch without charging a spell! Punching will deal small damage to enemies. The Monk and Geomancer have the strongest punches\n- Added a runestone microphone which appears on your wrist in private lobby conquest matches. Hold the runestone toward your face to speak to your teammates anywhere on the map. This replaces the push to talk joystick button\n- Added rare and epic skins for the Monk, Illusionist, and Elementalist\n\nImprovements:\n- Improved lag with most spells\n- Improved the smoothness of character motion and turning on standalone Quest devices\n- Humanoid characters now move their jaw when making any kind of vocalization, including when speaking through voice chat\n- Prevented accidental grabs of both weapons and grab-based buttons\n- Various performance improvements\n\nConquest Fixes:\n- Fixed a spawn lock issue that could trap players in the starting area after respawning \n- Corrected bot counts in private lobby matches\n- Fixed potion description UI being incorrectly placed in the shop\n- Fixed an issue which could bots to get stuck in the ground after a player disconnect\n- Fixed golem jitter issues\n\nSpell Fixes:\n- Fixed Gale spell dealing excessive damage\n- Fixed issues with incorrect and missing spell effects\n- Ensured spell wands always use the correct element\n- A fire sound no longer plays after spawning as a Pyromancer\n\nVoice Fixes:\n- Fixed voice chat sometimes failing to activate in private lobbies without a settings toggle workaround", "created_date": 1776573554, "id": "26922545773996654", "version": "1.0.10", "version_code": 38, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "25080401538211096", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "26922545773996654"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "25740082985581976"}]}, "change_log": "1.0.9 Patch Notes\n\nNew Features:\n- Added the versatile Elementalist class! The Elementalist can slot most primary spells from the four starting classes. His signature spell is Transmute and his ultimate is Dragon's Breath which combines wind and fire\n- Added a scoreboard for multiplayer matches which shows up in the settings menu and the end of match UI\n- Added player avatars which show up on the scoreboard and future social UI\n- Added new icons for crystals, essence, and essence bundles\n\nBug Fixes:\n- Fixed a bug which could prevent a player from reaching the practice area from the tower room\n- Minor stability improvements", "created_date": 1774659782, "id": "26684632341121333", "version": "1.0.9", "version_code": 37, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "25080401538211096", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "26922545773996654"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": []}, "change_log": null, "created_date": 1774645528, "id": "26682894214628479", "version": "1.0.9", "version_code": 36, "release_status": "PENDING", "status": "DRAFT", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "25080401538211096", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "26922545773996654"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": []}, "change_log": null, "created_date": 1773644994, "id": "26558018213782747", "version": "1.0.9", "version_code": 35, "release_status": "PENDING", "status": "DRAFT", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "25080401538211096", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "26922545773996654"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": []}, "change_log": null, "created_date": 1773552905, "id": "265480599
7&_nc_sid=6e7a0a&_nc_ohc=Rm63ufi_CTkQ7kNvwGqZ7ah&_nc_oc=AdmU4zgITf002z14fX8LWRuoMqF0NB9GTy-jSbrufLcRzF7acsDYdkNWlJUjirFcgLU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfyH0tWZEXQX4n6nPvPv9RiPakg2qUihmRdbfxuPygxmRQ&oe=69BBEDE2"}, {"file_name": "Screenshot4.png", "id": "1369823617949502", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499619174_1369823621282835_4051724597108621584_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Lm0xSUZflk8Q7kNvwFuOUAY&_nc_oc=AdlzCzV0lq52l7SfBLHYxVPYHauq7cnG_yYtNfrvGB1sPo3kuHIVHJSRS5Q_56_Ekg4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfyQ5vWD0I-_TRHz_40akGRQsRMgyDNb7gNvoUPDH2m9QA&oe=69BBE4DE"}, {"file_name": "Screenshot5.png", "id": "1887484512204627", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499619805_1887484515537960_7832102536243317228_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6i9f7viijNIQ7kNvwGsLWaV&_nc_oc=AdmoEEWVmDc0oPcxyizp8t7x9LfJPU7Sv5Dd0t5j_sm81vOG5RcZJZoD9PpLhU1_HyY&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfzLt0K-7MQwhSCe2WRwdPSgXKgls8JZvlMfZtSZJt0hgQ&oe=69BBDD7D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer cover image 2560x1440 - Copy.png", "id": "2117929769014258", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499619668_2117929772347591_7305990331590425037_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uuT9iBbR2roQ7kNvwEzzTbn&_nc_oc=Admiu0SwNzXTW63rK_6v034grrqCtJitF5FLfqykVpS7BX3d38xo7-NpM_tBQzcQZUc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfyLbOQEUN0JRMLPbzq6yOUO5pg6crqEbfNvgTwEkaDYig&oe=69BBF531"}, "display_name": "Crystal Conquest", "keywords": [], "long_description": "Crystal Conquest is a **Free-To-Play** VR game where you **control the elements** and battle for victory. Harness the power of fire, water, earth, and air in epic 3v3 MOBA-inspired combat or intense dueling modes! Team up with your friends against AI or choose to fight in PvP!\n\n**Build your mage:** Choose the class that matches your playstyle and elements. Unlock class variants as you grow and customize your build. \n\n**Harness the elements:** Battle with elemental magic where each element has unique properties. Use earth, fire, water, and wind to block, dodge, and deflect your enemy's attacks. \n\n**Grow in Power:** Level up and unlock even more epic spells that change how you control the elements.\n\n**Choose Your Battle Mode:** Battle in 3v3 matches to capture crystals and topple towers, face off in duels, or team up in co-op to take on waves of AI. All modes support AI for solo or practice play.", "short_description": "Crystal Conquest is a free-to-play VR game where you control the elements and battle for victory. Harness the power of fire, water, earth, and air in epic 3v3 MOBA-inspired combat or intense dueling modes!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.mysticinteractive.com/s/MYSTIC-INTERACTIVE-PRIVACY-POLICY.pdf", "developer_terms_of_service_url": "https://www.mysticinteractive.com/terms-of-use", "publisher_name": "Mystic Interactive", "support_website_url": "https://discord.gg/KV9f2dwTdY", "website_url": "https://www.crystalconquest.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "3744040075834813"}, {"id": "2710427532541308"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER", "CO_OP"], "id": "25649479581303286"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1566552014526318"}]}, "baseline_offer": {"id": "1566552014526318"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1765526400, "status": "PUBLISHED", "id": "1566552014526318"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "26442873875297182", "version": "1.0.8"}, "id": "25740082985581976", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "25080401538211096", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "26442873875297182"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "25740082985581976"}]}, "change_log": "Patch 1.0.8 Notes\n\nNew Features:\n- Weapons now automatically spawn in your back holsters instead of being spawned manually through casting. Simply reach above or behind your shoulder and then hold grab to retrieve a weapon. When a weapon spell is slotted, you will no longer have a button bound to that spell. Also when using the spell menu instead of buttons, weapons will no longer appear in the spell menu\n- Added more visual and audio feedback for buying and selling items in the Conquest shop\n\nBalancing Changes:\n- Weapons no longer cost mana to spawn and weapon cooldowns have been increased from 12 to 20 seconds. The weapon recharge mana cost is unchanged\n- Increased the explosion radius of the love grenade and made it no longer scale with spell power\n\nBug Fixes:\n- Fixed love grenade throwing issues when more than one love grenade was being held\n- Fixed issue that prevented more shop items from being purchased after purchasing many love grenades\n- Added an item restock timer on the love grenade which was missing\n- Fixed an issue where a random spell effect could get stuck to your hand\n- Fixed an issue in multiplayer matches where a projectile attack would apparently hit but not do any damage\n- Made various performance improvements, especially with UI", "created_date": 1772586105, "id": "26442873875297182", "version": "1.0.8", "version_code": 33, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "25080401538211096", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "26442873875297182"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": []}, "change_log": null, "created_date": 1772243829, "id": "26405697039014866", "version": "1.0.8", "version_code": 31, "release_status": "PENDING", "status": "DRAFT", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "25080401538211096", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "26442873875297182"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": []}, "change_log": null, "created_date": 1772001243, "id": "26378628318388405", "version": "1.0.8", "version_code": 30, "release_status": "PENDING", "status": "DRAFT", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "25080401538211096", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "26442873875297182"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "25740082985581976"}]}, "change_log": "Valentine's Day Update (Patch 1.0.7)\n\nNew Features:\n- Added quests to the game! New players will start off with two intro quests and a new quest will be available every week. Check out the quest book in the starting Hub\n- Added the Love Grenade item which can charm your enemies! This can be purchased from the inventory shop in the Hub or earned from the first weekly quest!\n- Added difficulty settings to Conquest mode for Solo play. You will earn more crystals at higher difficulties\n- Made various improvements to the bot AI. Bots are now better at defending crystals and avoiding dangerous areas\n\nBalancing Changes:\n- Adjusted attack speed requirements for various spells. Daggers will now deal damage at low speeds\n- Golems on the winning team will now receive a stat boost once a Conquest match has lasted 15+ minutes. This boost will start small and grow over time. This will help end a long running match\n- Reduced the range of arrows from the Aeromancer's bow\n- Reduced damage taken in the Practice Conquest mode from 75% to 40%.\n\nBug Fixes:\n- Added missing icons for Shadow element spells and the Bane status effect\n- Fixed issues where tower projectiles would not aim properly at far away targets.\n- Fixed issue where weapons might not get thrown correctly\n- Fixed some issues with player message text display in the Practice match", "created_date": 1771104421, "id": "26281876901396881", "version": "1.0.7", "version_code": 29, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "25080401538211096", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "26442873875297182"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "25740082985581976"}]}, "change_log": "Patch 1.0.6 Notes\n\nNew Features:\n- Cloak and dagger your way to victory with the unlockable Illusionist class!\n- Added voice chat to private lobbies. See the voice settings menu in the hub\n- Added tutorials to practice blocking and to defeat the practice bot\n- Added a minor shop tutorial\n\nBalancing Changes:\n- Slightly increased the strength of the friendly bots in the Gauntlet\n- Buffed bow damage by 11%\n- Made throwing easier for spells\n- Targeted spells now have a wider angle for targeting\n- Most ranged golems/monsters now use the neutral Force element with their projectiles, so each class is equally effective at blocking these attacks\n- Slightly reduced the attack speed of ranged golems/monsters\n- Weapons and spells which cause a status effect now require a full charge to cast\n\nBug Fixes:\n- Fixed an bug where a selection circle could get stuck on you\n- Fixed an issue where you throwing one weapon could cause both weapons to be thrown\n- Fixed an issue where weapons might not collide with another player who uses the same weapons\n- Fixed a bug where basic cast spells would sometimes not appear in your hand after using double handed charging\n- Fixed some issues with blocking melee golem attacks\n- Improved the ease in which items can be grabbed at the Conquest shop\n- Fixed some issues that the Monk was having with grabbing certain items\n- Ensured that cooldowns are cleared upon death\n- Fixed the inability to auto-cast certain spells\n- Fixed an issue that was causing weapons to fluctuate in size\n- Fixed a bug where the grab menu button could be triggered while holding an object\n- Many stability improvements", "created_date": 1769933318, "id": "26153850060866233", "version": "1.0.6", "version_code": 28, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}]}}, "viewer": {"user": null}}}
in6-3.oculuscdn.com/v/t64.5771-25/499296288_1173864237638279_2462020394851590536_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GHpfT_iaNyIQ7kNvwFY8aIi&_nc_oc=AdqBWIgiJbXEh3uMt1HGLJw1c8QbdddNoVXY3PMGs8pwvVP-OCmLIidP3RByYltpH8M&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-beiXVnRZ8W5jUcsgSR56JIn4f2jeqn2pzxKtLEE9taQ&oe=6A39343D"}, {"file_name": "Screenshot3.png", "id": "1358978606022789", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/499618937_1358978609356122_816223264038509773_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SOxZkEo6S4MQ7kNvwF5LRGt&_nc_oc=Ado-7v0bPlDN-R9AVI_AUFD_lX9lQwA9Y95v22nd5-W_ndPRM2qBJX5Div5IgL6iiwA&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9E8VvhgGQYQJncgung7-oHw01bL-PQj9o-sB8hmquecQ&oe=6A392C62"}, {"file_name": "updatedscreenshot.png", "id": "1523088678946721", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/499618499_1523088682280054_3963745572868175892_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=49mT3e86Q4YQ7kNvwGMNRoH&_nc_oc=AdqvXlN7t1Wdbn3pzaT_NVYmiB468id9g9l-k1Q5lhioDMjXX2OHhkr0TlDASsufQ4Q&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8d7bd5W4m9b5tjN3epZAQ2SdGtOnHPcz7mPy6GVM1fog&oe=6A395BFE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer cover image 2560x1440 - Copy.png", "id": "2117929769014258", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/499619668_2117929772347591_7305990331590425037_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-CIIpditBowQ7kNvwHCTM5e&_nc_oc=AdrRpfvOgnwSGeTG7RrlpyAXVkxpSMmRoc324Y9FkW7uygWXj-MSkkZmBSiQ5ycN5a0&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8GDJSOledSdMjkXcaxJ2pGP7mWKiz2sbXv7QlH16yQRA&oe=6A3933B1"}, "display_name": "Crystal Conquest", "keywords": ["moba", "free", "multiplayer", "singleplayer", "magic"], "long_description": "Crystal Conquest is a Free-To-Play VR game where you control the elements and battle for victory. Imagine the elemental magic of Avatar in VR across fighting, MOBA, and level based campaign modes!\n\n\n**Key Features:**\n\n- Play as elemental mages - 4 available by default, unlock more over time\n\n- Choose which spells to take into battle, unlock more over time\n\n- Customize your in-match shop - choose your potions, wands and other items, unlock more over time\n\n- Different modes to suit your mood: Duel (1v1), Conquest MOBA (3v3) or Gauntlet (players vs waves of enemies)\n\n- Single player or Multiplayer\n\n- Private lobbies available, bring your friends\n\n- Skills-based matchmaking to pair you with equal opponents\n\n- Shape the game's future by communicating with the Studio on Discord\n\n\n{719459321207239}\n\n\n\n**Build your mage:** Choose the class that matches your playstyle and elements. Unlock class variants as you grow and customize your build.\n\n{2529778434085166}\n\n\n\n**Harness the elements:** Battle with elemental magic where each element has unique properties. Use earth, fire, water, and wind to block, dodge, and deflect your enemy's attacks.\n\n{1766498407381295}\n\n\n\n**Grow in Power:** Level up and unlock even more epic spells that change how you control the elements.\n\n{1071429428371112}\n\n\n\n**Choose Your Battle Mode:** Battle in 3v3 matches to capture crystals and topple towers, face off in duels, or team up in co-op to take on waves of AI. All modes support AI for solo or practice play.\n\n{1283539703534860}", "short_description": "Crystal Conquest is a free-to-play VR game where you control the elements and battle for victory. Harness the power of fire, water, earth, and air in epic 3v3 MOBA-inspired combat or intense dueling modes!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.mysticinteractive.com/s/MYSTIC-INTERACTIVE-PRIVACY-POLICY.pdf", "developer_terms_of_service_url": "https://www.mysticinteractive.com/terms-of-use", "publisher_name": "Mystic Interactive", "support_website_url": "https://discord.gg/KV9f2dwTdY", 
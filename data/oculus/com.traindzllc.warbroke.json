2Ch9b7Mle8nARwDbQVzTFc6vKUvs7Ad3gBS4Y&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFRrCiRwMaRCfZYB_PO27aL3OPvlF4lu5qticLBl0wz4Q&oe=6A843E83"}, {"file_name": "SCREEN5.png", "id": "1351573939362261", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473393325_1351573942695594_8627772183416663494_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z0v3oq4l8IoQ7kNvwHWrrHf&_nc_oc=AdrGXgEEtNn7uf-c5Cnjx60fpoa-aMyLFJ9MqD9NohyUjFHIYoovcHduaOuRh4YsYUw&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEFdYDGhuRD16g8Hwfg_3u962MaEeavFpbzAj3f4OAtTQ&oe=6A843436"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "LANDSCAPE.png", "id": "9644139012286835", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391883_9644139018953501_5648143411478632363_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Uq0OI4ZVWq0Q7kNvwHD_omF&_nc_oc=Adp470bwTOVXGFtuV-uhDlR3sqQ_pFDKdVeXgHxui5RJCmgsjVJmqG8PJ5ZiUVRuqrw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGVKqWALU5otyarczQYuGnfSWri7YztKPErqrqkg_qoIA&oe=6A843FBD"}, "display_name": "War Broke in Heaven", "keywords": ["action", "dragon", "fitness", "fight", "wrath"], "long_description": "Based on the events of the beginning and the end, this VR experience may cause motion sickness, user discretion is advised.\n\nWar Broke in Heaven is a VR experience that puts you in the air while you fight enemies and a dragon to stop the ultimate rebellion. Use controlled moving and tactics to destroy the enemy and not get engulfed by their attacks. You will have a variety of weapons at your disposal each with a unique attribute to destroy your enemy. \n\nUse your head to look at the directions you want to fly to and slash, or fire spirit bombs at the enemy. War broke in heaven has beautiful graphics that will keep you in awe and that will leave you having fun and wanting to come back to play more. ", "short_description": "An epic battle and the fall of a rebellion, this V
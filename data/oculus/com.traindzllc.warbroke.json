NKKogIMFxnDReYKzyiPWHl6ouHey5zST_Ap9M&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2Am8uJVbmnteDaCDjo7OAswpQ152d9lahBX9u0vF0shQ&oe=69D63883"}, {"file_name": "SCREEN5.png", "id": "1351573939362261", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473393325_1351573942695594_8627772183416663494_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-DdrfEELkmQQ7kNvwFC8w1V&_nc_oc=AdplrAk1zWiKAatF_NEdTGd-6p2jgNhi5UnvMt1XmluT3gt5XunwlLKPAYVMGh0HTfM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af22Lq74g6qwdYKycyajFWhi3X5dclcx8n-p3Dp6MzBr5Q&oe=69D66676"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "LANDSCAPE.png", "id": "9644139012286835", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391883_9644139018953501_5648143411478632363_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OyDqFhDFCKQQ7kNvwEvmXi0&_nc_oc=AdpQ4udotj62wvOKR8CIqbHrfuqApmr8shOR9GQMl5Cpuw8p8D3vUnooEciIGY0oZz8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0qdo2zAAyrM0uCcyGUqvwJTl6aIHahxO7Wka1pt_PHnw&oe=69D639BD"}, "display_name": "War Broke in Heaven", "keywords": ["action", "dragon", "fitness", "fight", "wrath"], "long_description": "Based on the events of the beginning and the end, this VR experience may cause motion sickness, user discretion is advised.\n\nWar Broke in Heaven is a VR experience that puts you in the air while you fight enemies and a dragon to stop the ultimate rebellion. Use controlled moving and tactics to destroy the enemy and not get engulfed by their attacks. You will have a variety of weapons at your disposal each with a unique attribute to destroy your enemy. \n\nUse your head to look at the directions you want to fly to and slash, or fire spirit bombs at the enemy. War broke in heaven has beautiful graphics that will keep you in awe and that will leave you having fun and wanting to come back to play more. ", "short_description": "An epic battle and the fall of a rebellion, this V
5vrZhHc5lGvsu7jJGgu3y3v12K2dhJ2aXrtOQ&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTTKqqGRQD204LOp4I7fY0GFtps3cnQWePDy1sOd-ygZw&oe=6AF9CC43"}, {"file_name": "SCREEN5.png", "id": "1351573939362261", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/473393325_1351573942695594_8627772183416663494_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jPmMDMdsf90Q7kNvwF7T0oB&_nc_oc=Adp1LS5X7BmDppSkKkFhwfhxwFKkTfHM0XRYyFyCMIThHAIQ3_cbcEuuowK-oJ8g6No&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSeURy_r5UfYau0h464k-Ww6qNnpiyPOPhRMCm0KXp7tA&oe=6AF9C1F6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "LANDSCAPE.png", "id": "9644139012286835", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/473391883_9644139018953501_5648143411478632363_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BgpKwG-IQ98Q7kNvwEgZRPa&_nc_oc=Adoxkv9UFWV7JtjhTOTZWjulIfR2C330mtoX_cjg0Fi0BNxpFCswLchB-1oEixhjqEA&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRwJH5jwTWvNOoEEAeu-ohqGRN4lLvfmsqyG0XWmK6DBw&oe=6AF9CD7D"}, "display_name": "War Broke in Heaven", "keywords": ["action", "dragon", "fitness", "fight", "wrath"], "long_description": "Based on the events of the beginning and the end, this VR experience may cause motion sickness, user discretion is advised.\n\nWar Broke in Heaven is a VR experience that puts you in the air while you fight enemies and a dragon to stop the ultimate rebellion. Use controlled moving and tactics to destroy the enemy and not get engulfed by their attacks. You will have a variety of weapons at your disposal each with a unique attribute to destroy your enemy. \n\nUse your head to look at the directions you want to fly to and slash, or fire spirit bombs at the enemy. War broke in heaven has beautiful graphics that will keep you in awe and that will leave you having fun and wanting to come back to play more. ", "short_description": "An epic battle and the fall of a rebellion, this V
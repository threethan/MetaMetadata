kP3McfDvQNloCIosfqvrO797rSReZV4MX_4GA&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDH2S01sBlWycng8qSMg4JhDJYIUmCvItaHkzRQXmMncQ&oe=6A65EC03"}, {"file_name": "SCREEN5.png", "id": "1351573939362261", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/473393325_1351573942695594_8627772183416663494_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AEDSPZu21VoQ7kNvwFgOWjH&_nc_oc=AdqV-p3e8qPXHioqOdGjBtnuR0PpkIir-CkfG_eogFuEEwGAvohu1MJIvxD79DQnfNQ&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAyRxAz-2-h-9_90Rdvdx3l-DQReK92GM9SpCXfOio7VQ&oe=6A6619F6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "LANDSCAPE.png", "id": "9644139012286835", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/473391883_9644139018953501_5648143411478632363_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0-TWOjT2sboQ7kNvwF0Ta4n&_nc_oc=Ado2z4CBI6SNy44RHyMfmJ6Nlft-hMO1OIbbt8nKWpAt0hy_NsOJyhYS1bpojfukctI&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAmqbZi1IuBrWQPV-DpxLxwnoMDzHJw-Pkil5wm4Py7wQ&oe=6A65ED3D"}, "display_name": "War Broke in Heaven", "keywords": ["action", "dragon", "fitness", "fight", "wrath"], "long_description": "Based on the events of the beginning and the end, this VR experience may cause motion sickness, user discretion is advised.\n\nWar Broke in Heaven is a VR experience that puts you in the air while you fight enemies and a dragon to stop the ultimate rebellion. Use controlled moving and tactics to destroy the enemy and not get engulfed by their attacks. You will have a variety of weapons at your disposal each with a unique attribute to destroy your enemy. \n\nUse your head to look at the directions you want to fly to and slash, or fire spirit bombs at the enemy. War broke in heaven has beautiful graphics that will keep you in awe and that will leave you having fun and wanting to come back to play more. ", "short_description": "An epic battle and the fall of a rebellion, this V
_sjSXjZHX-N_tIA-eZMyY-5U_vFVIn2SCW_Kc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCuHqWH9o1RXMCQ8qD2QFrzbeojmxrXsET0UgAqV9efQQ&oe=6A4BC643"}, {"file_name": "SCREEN5.png", "id": "1351573939362261", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473393325_1351573942695594_8627772183416663494_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=85F3AzQM4cMQ7kNvwEojb7N&_nc_oc=Adoc9VMtxs6X2E5B0DP0d_7O7HS2MTwDduoquGtVc_F2_z03_OHcZl2HTX_FFZo39RM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA_2d-ilJWDVro-D2iMFZhm4FuyS_SkzV58m5EyWHkL3g&oe=6A4BBBF6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "LANDSCAPE.png", "id": "9644139012286835", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391883_9644139018953501_5648143411478632363_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CtIIj7qdELsQ7kNvwEGF9E0&_nc_oc=AdppHJl7Za4TNJxpJrajVVydkejNEcQ3XEKNKrZgNfWqTcl9t4WAIftvhwVHveCnnrU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDHETpyu5duqKP5mSFEu56zEGoITvmI_-f3X7HXcS3s5g&oe=6A4BC77D"}, "display_name": "War Broke in Heaven", "keywords": ["action", "dragon", "fitness", "fight", "wrath"], "long_description": "Based on the events of the beginning and the end, this VR experience may cause motion sickness, user discretion is advised.\n\nWar Broke in Heaven is a VR experience that puts you in the air while you fight enemies and a dragon to stop the ultimate rebellion. Use controlled moving and tactics to destroy the enemy and not get engulfed by their attacks. You will have a variety of weapons at your disposal each with a unique attribute to destroy your enemy. \n\nUse your head to look at the directions you want to fly to and slash, or fire spirit bombs at the enemy. War broke in heaven has beautiful graphics that will keep you in awe and that will leave you having fun and wanting to come back to play more. ", "short_description": "An epic battle and the fall of a rebellion, this V
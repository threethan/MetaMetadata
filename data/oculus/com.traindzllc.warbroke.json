QvhKixUf7HPOY_v1ap-LY-SiGuIABtRL5xAKY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0oiAfz4yCCOSepXXEhRFHrbfJpyHIS6HMm9VDrLouPvQ&oe=69ECA203"}, {"file_name": "SCREEN5.png", "id": "1351573939362261", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473393325_1351573942695594_8627772183416663494_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K5ynPB0ht9cQ7kNvwHxrPQp&_nc_oc=AdprVC1TaIuv4yrGOjT1PAINC0HXZyHNrOmdMFAXPoUJew1L3-8X_jo4hZv5xOYvXiY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3PmO34uBX4IfO1nlQ4SbINH-syQqrK1oUupu9HuWztsw&oe=69ECCFF6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "LANDSCAPE.png", "id": "9644139012286835", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391883_9644139018953501_5648143411478632363_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d_axozQDJ3sQ7kNvwEKSjqs&_nc_oc=Adr0q6cpM__oDoiXKSwjefFzCr5ZkHgNTwav4VnhZR5oOvbShC6IqSBkh0N7PclUdtM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af31Mt9MSBZQZuGiNYaKK2EQ6qlDCc0Q3s8W-4iX31SKRA&oe=69ECA33D"}, "display_name": "War Broke in Heaven", "keywords": ["action", "dragon", "fitness", "fight", "wrath"], "long_description": "Based on the events of the beginning and the end, this VR experience may cause motion sickness, user discretion is advised.\n\nWar Broke in Heaven is a VR experience that puts you in the air while you fight enemies and a dragon to stop the ultimate rebellion. Use controlled moving and tactics to destroy the enemy and not get engulfed by their attacks. You will have a variety of weapons at your disposal each with a unique attribute to destroy your enemy. \n\nUse your head to look at the directions you want to fly to and slash, or fire spirit bombs at the enemy. War broke in heaven has beautiful graphics that will keep you in awe and that will leave you having fun and wanting to come back to play more. ", "short_description": "An epic battle and the fall of a rebellion, this V
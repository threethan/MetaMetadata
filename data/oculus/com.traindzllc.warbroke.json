zJf4P2bB-pt5Jq31NM-HGlkAca7QYoSOdvVek&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIvXL5jTO-PxvMJ0yVWOw7IiUrAeWPLGryZpz1xoN9LeQ&oe=6AA80F43"}, {"file_name": "SCREEN5.png", "id": "1351573939362261", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473393325_1351573942695594_8627772183416663494_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8riUfa-TifEQ7kNvwHHnzvQ&_nc_oc=Ado_nT3O6FL2QPaXlku5Py8SJi3ZLHvr4lAJAirp4ZGR8d9P1306Kg2KFlGWPJapDaY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKuAl4cTojiW-Hy2kj52MWvUa3wzEg60ROiFo81yPvS_A&oe=6AA804F6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "LANDSCAPE.png", "id": "9644139012286835", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391883_9644139018953501_5648143411478632363_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L1889eTVQEMQ7kNvwGcFOS5&_nc_oc=AdrD5KTeKWYgRh1XFJJu1N60d-7RQJAlePGM9A-LCdmGTAzuk5kPUw-28uCsaLFkZig&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIB6_kF-rnWBmSItE_ZqkixRfN3CekLrS4rip4TD4jmJw&oe=6AA8107D"}, "display_name": "War Broke in Heaven", "keywords": ["action", "dragon", "fitness", "fight", "wrath"], "long_description": "Based on the events of the beginning and the end, this VR experience may cause motion sickness, user discretion is advised.\n\nWar Broke in Heaven is a VR experience that puts you in the air while you fight enemies and a dragon to stop the ultimate rebellion. Use controlled moving and tactics to destroy the enemy and not get engulfed by their attacks. You will have a variety of weapons at your disposal each with a unique attribute to destroy your enemy. \n\nUse your head to look at the directions you want to fly to and slash, or fire spirit bombs at the enemy. War broke in heaven has beautiful graphics that will keep you in awe and that will leave you having fun and wanting to come back to play more. ", "short_description": "An epic battle and the fall of a rebellion, this V
87291122776285_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VKmV21wA_Y4Q7kNvwFSSKRr&_nc_oc=AdpXEZriWskdGUur4uHK2M5uiGrMTcpwcBUeSrflfb23rS88ffGpltJ3stzOUwqYYJc&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4Pxe5xa5lC17V-2DaNgXEu4v9qha1wxEMlmVfwTx2KtQ&oe=69FDFDC3"}, {"file_name": "SCREEN5.png", "id": "1351573939362261", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/473393325_1351573942695594_8627772183416663494_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G2OS5kcSM94Q7kNvwHEB5bt&_nc_oc=AdoJox8QJMI1eZ7JrW-HXqZ6IrrhAU7pf52iKTKuBnCknrrZx--dm1GuQsuNOxhg2Fc&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5h_KbxArUkxD0IaBGZH4J5z474Wj5Gsg-_s08HNMfiyw&oe=69FDF376"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "LANDSCAPE.png", "id": "9644139012286835", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/473391883_9644139018953501_5648143411478632363_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Zj499umPcrwQ7kNvwHRKuPw&_nc_oc=AdqKQhEySeFYmY25F_dN7W_ujSHupnwAXC_sC2qEOwFjMWOSxeF4QQywZDsCGWOuDkc&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5zcOf4PNvnEElr1lAzFalX_fXdswt631qbRXEmZ3oK4Q&oe=69FDFEFD"}, "display_name": "War Broke in Heaven", "keywords": ["action", "dragon", "fitness", "fight", "wrath"], "long_description": "Based on the events of the beginning and the end, this VR experience may cause motion sickness, user discretion is advised.\n\nWar Broke in Heaven is a VR experience that puts you in the air while you fight enemies and a dragon to stop the ultimate rebellion. Use controlled moving and tactics to destroy the enemy and not get engulfed by their attacks. You will have a variety of weapons at your disposal each with a unique attribute to destroy your enemy. \n\nUse your head to look at the directions you want to fly to and slash, or fire spirit bombs at the enemy. War broke in heaven has beautiful graphics that will keep you in awe and that will leave you 
DA4YWf4pgBPAR_HPqeFq-ZVQ-tdsgMXckBKoA&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKDmdJPzPjp6VfuGqVrFHtTJBbEX_Jiz9AlQyg234ZS3g&oe=6AA02643"}, {"file_name": "SCREEN5.png", "id": "1351573939362261", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/473393325_1351573942695594_8627772183416663494_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VVk1IWQd8qAQ7kNvwGswtvn&_nc_oc=AdrBtCxaJ-HfxJOtOFxOvsoUfcRRiLHjDkmCiiZAMPGShfC8LLkt7LjR7Of5W9BSmXU&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLVVPUs0rrY2U1YrzNAjl4fedUlIE6ob2NIJfUh1hx4aA&oe=6AA01BF6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "LANDSCAPE.png", "id": "9644139012286835", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/473391883_9644139018953501_5648143411478632363_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RanMKsfzCO0Q7kNvwGPrR_r&_nc_oc=Adoa1VI1hmUS8-dEnS5Z8oC1XZctW_23ITGlQW9QeG20DrrzQ6_ZEMwt3uugL7CEH00&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLg7CGb4eKfCOyZuVVCuYYWyWgIXoumiH2ftjFhIlpp5A&oe=6AA0277D"}, "display_name": "War Broke in Heaven", "keywords": ["action", "dragon", "fitness", "fight", "wrath"], "long_description": "Based on the events of the beginning and the end, this VR experience may cause motion sickness, user discretion is advised.\n\nWar Broke in Heaven is a VR experience that puts you in the air while you fight enemies and a dragon to stop the ultimate rebellion. Use controlled moving and tactics to destroy the enemy and not get engulfed by their attacks. You will have a variety of weapons at your disposal each with a unique attribute to destroy your enemy. \n\nUse your head to look at the directions you want to fly to and slash, or fire spirit bombs at the enemy. War broke in heaven has beautiful graphics that will keep you in awe and that will leave you having fun and wanting to come back to play more. ", "short_description": "An epic battle and the fall of a rebellion, this V
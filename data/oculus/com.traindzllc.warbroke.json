87291122776285_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gavAeau6XDYQ7kNvwG1oYK3&_nc_oc=Adow04JyyCSKRUlEytJDBWYDayeV-ojhAJu-g-jQABFCikOnhY3wypq7iE_cIXycdYc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4lUSZjDwa5Mq_Fj2Y676c_zFPnKxQJaypUSQkRZuaARw&oe=69FA0943"}, {"file_name": "SCREEN5.png", "id": "1351573939362261", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473393325_1351573942695594_8627772183416663494_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nW0miqai66kQ7kNvwHr18tc&_nc_oc=AdpY6-VdHMTW0owsYy_0Hz83CJQMhz7y-EC-1p5KRi8KwiXusraqCOzcM3w_hJOI5Xs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7BLGcqJqqTzqO8RzfD8YMpS44AGNFG1VrxTTLHYnajgQ&oe=69F9FEF6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "LANDSCAPE.png", "id": "9644139012286835", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473391883_9644139018953501_5648143411478632363_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ber0A_FK0soQ7kNvwGrlHco&_nc_oc=AdqJvnfaqB1otFNYNUY4vnUF8FZrDvC7Bf0xs9mWZF3HAajgP9IZo1-MfHycVH4lDWY&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6oTt3MSY2YRHSjCdKT6Ta0zioXgDeN8UVhpbPG4UlGsg&oe=69FA0A7D"}, "display_name": "War Broke in Heaven", "keywords": ["action", "dragon", "fitness", "fight", "wrath"], "long_description": "Based on the events of the beginning and the end, this VR experience may cause motion sickness, user discretion is advised.\n\nWar Broke in Heaven is a VR experience that puts you in the air while you fight enemies and a dragon to stop the ultimate rebellion. Use controlled moving and tactics to destroy the enemy and not get engulfed by their attacks. You will have a variety of weapons at your disposal each with a unique attribute to destroy your enemy. \n\nUse your head to look at the directions you want to fly to and slash, or fire spirit bombs at the enemy. War broke in heaven has beautiful graphics that will keep you in awe and that will leave you 
mbw6iEeAPO1n7isfXkMx8Jm6h2SI9_2jazKfc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_w_pzh61Hd193UBcfn7v8SECj0SfY87kWRXqBhwHRvWQ&oe=6A3FE8C3"}, {"file_name": "SCREEN5.png", "id": "1351573939362261", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473393325_1351573942695594_8627772183416663494_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Yo_F4EwcNL4Q7kNvwEUG9bA&_nc_oc=Adpt6Lr-BBEnAgWqQSc4HXBB8ZnY4PMqxDGvWb2yG8__SQ5LAnkkhCTYGX5jlzPe1LE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_6Z41VyfO2njB2Ik44D-8O4j5SbNBVmfOlQEZQJxWyiw&oe=6A3FDE76"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "LANDSCAPE.png", "id": "9644139012286835", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473391883_9644139018953501_5648143411478632363_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jY1jtnLLdH0Q7kNvwF2tcUS&_nc_oc=AdpDzduXn7yVrBilfLnyc2b2rBR_x_gD3uwCJA6b3QgL2T31-3BsQenhPQkd_3aH6B8&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8MDAchlDCtH3zCu8c-dIdt3zufcLSZVZWYZn558Vv8Yg&oe=6A3FE9FD"}, "display_name": "War Broke in Heaven", "keywords": ["action", "dragon", "fitness", "fight", "wrath"], "long_description": "Based on the events of the beginning and the end, this VR experience may cause motion sickness, user discretion is advised.\n\nWar Broke in Heaven is a VR experience that puts you in the air while you fight enemies and a dragon to stop the ultimate rebellion. Use controlled moving and tactics to destroy the enemy and not get engulfed by their attacks. You will have a variety of weapons at your disposal each with a unique attribute to destroy your enemy. \n\nUse your head to look at the directions you want to fly to and slash, or fire spirit bombs at the enemy. War broke in heaven has beautiful graphics that will keep you in awe and that will leave you having fun and wanting to come back to play more. ", "short_description": "An epic battle and the fall of a rebellion, this V
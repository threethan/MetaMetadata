b1DSyM0baF7PkbX3DUFv-YGoD0wdHinZQnADc&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD8F0sLESaS-StWqW3cek4LQgBNgQAazLpTlW0y05ip8A&oe=6A688F03"}, {"file_name": "SCREEN5.png", "id": "1351573939362261", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473393325_1351573942695594_8627772183416663494_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tIkzPebqmbYQ7kNvwEGzEZH&_nc_oc=AdpAzHiNvQ_Sd5vLJuEIOK9ji6naZfOICbDZooiivh_j7lnRksNmwXol18G2ltHxBSU&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDopJBSJ-kFj30odRMPcfrj-yh1to2v7VHhgwe73-MrWQ&oe=6A68BCF6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "LANDSCAPE.png", "id": "9644139012286835", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473391883_9644139018953501_5648143411478632363_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lBJSvZpD9kUQ7kNvwE8I9Sq&_nc_oc=Adpq2qxQiN4ILDWBDqwmij-vkxoFfVi5q7yy8eKvnMD_3pMzVz2XEsI16Ayz2WosD0g&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQABrB2JWkQLk3H9oBrQ2m1EaOej5ggqM-Qr43TI83yndw&oe=6A68903D"}, "display_name": "War Broke in Heaven", "keywords": ["action", "dragon", "fitness", "fight", "wrath"], "long_description": "Based on the events of the beginning and the end, this VR experience may cause motion sickness, user discretion is advised.\n\nWar Broke in Heaven is a VR experience that puts you in the air while you fight enemies and a dragon to stop the ultimate rebellion. Use controlled moving and tactics to destroy the enemy and not get engulfed by their attacks. You will have a variety of weapons at your disposal each with a unique attribute to destroy your enemy. \n\nUse your head to look at the directions you want to fly to and slash, or fire spirit bombs at the enemy. War broke in heaven has beautiful graphics that will keep you in awe and that will leave you having fun and wanting to come back to play more. ", "short_description": "An epic battle and the fall of a rebellion, this V
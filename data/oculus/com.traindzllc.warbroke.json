7qe6NGjTBjNXYgtv7AAdmUnkAHXmdqF81_fPg&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2XohYJ136uQPAlfvtsx7ywQtmOAZF9IhcRXTdpu76nrg&oe=69E75C03"}, {"file_name": "SCREEN5.png", "id": "1351573939362261", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/473393325_1351573942695594_8627772183416663494_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r-VNz1aAyLUQ7kNvwE_idFe&_nc_oc=Adq4VTdhSC4epqLdrQCtCQI2Cc5yJQ_0V6lNm53HI9XeDDnTcp6_12qIUpTv1GgZbDQ&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af31LZAAT5qk_CxZwqRqlxsckae_pqVkDqy5NIudGp9Wiw&oe=69E789F6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "LANDSCAPE.png", "id": "9644139012286835", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/473391883_9644139018953501_5648143411478632363_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WCT-occssV4Q7kNvwGc92lF&_nc_oc=AdoKkfL-zHFOkv1oCICguzMk2ioheiM1RxKVgYExAGiF3ehtjQQC-TYwZoaWBvlmG5g&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af33yWjSA494CsApSj02KXxSA_o6GIjrJUpu2Q6dcTjsmg&oe=69E75D3D"}, "display_name": "War Broke in Heaven", "keywords": ["action", "dragon", "fitness", "fight", "wrath"], "long_description": "Based on the events of the beginning and the end, this VR experience may cause motion sickness, user discretion is advised.\n\nWar Broke in Heaven is a VR experience that puts you in the air while you fight enemies and a dragon to stop the ultimate rebellion. Use controlled moving and tactics to destroy the enemy and not get engulfed by their attacks. You will have a variety of weapons at your disposal each with a unique attribute to destroy your enemy. \n\nUse your head to look at the directions you want to fly to and slash, or fire spirit bombs at the enemy. War broke in heaven has beautiful graphics that will keep you in awe and that will leave you having fun and wanting to come back to play more. ", "short_description": "An epic battle and the fall of a rebellion, this V
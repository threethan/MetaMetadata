i5jXYWULMKKCoA8SrfUbh7-Nr3LSUglqSvCaQ&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2CS5iOCy9aVyowv-biGnn3PJd03qPucg-aK6H8K-bqgg&oe=69E642C3"}, {"file_name": "SCREEN5.png", "id": "1351573939362261", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/473393325_1351573942695594_8627772183416663494_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r-VNz1aAyLUQ7kNvwFaJxzC&_nc_oc=AdoQrxVRpXE1qGhXdRcoOe5Em2oVVSrvFue70Iw0kIaG8wAZxbsuPEIv1xziruiu2ng&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0QpSRRNhGZE2v7FVvJA13kAmKTgb8i1ZLi1EAfwufJEw&oe=69E63876"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "LANDSCAPE.png", "id": "9644139012286835", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/473391883_9644139018953501_5648143411478632363_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WCT-occssV4Q7kNvwFtHqJl&_nc_oc=AdovafxoAkH5nbAMUxQr9x9OjzkefHHvqceIve1rWzI0WFYXKpbKrrAZXjFgyB5ELp4&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af169aQqMdWV948OABZds5PR9HdlRp9A2zuBozlIMI55Ug&oe=69E643FD"}, "display_name": "War Broke in Heaven", "keywords": ["action", "dragon", "fitness", "fight", "wrath"], "long_description": "Based on the events of the beginning and the end, this VR experience may cause motion sickness, user discretion is advised.\n\nWar Broke in Heaven is a VR experience that puts you in the air while you fight enemies and a dragon to stop the ultimate rebellion. Use controlled moving and tactics to destroy the enemy and not get engulfed by their attacks. You will have a variety of weapons at your disposal each with a unique attribute to destroy your enemy. \n\nUse your head to look at the directions you want to fly to and slash, or fire spirit bombs at the enemy. War broke in heaven has beautiful graphics that will keep you in awe and that will leave you having fun and wanting to come back to play more. ", "short_description": "An epic battle and the fall of a rebellion, this V
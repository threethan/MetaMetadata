MEJnZg&oe=69A02B03"}, {"file_name": "SCREEN5.png", "id": "1351573939362261", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473393325_1351573942695594_8627772183416663494_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CRHJ-cuCokoQ7kNvwGwAio2&_nc_oc=AdnkqeG1Uqsd-HpS6jMg4PzaKUYylAOGvkz-AQ-MTYSH4tL23tYm-3Ub1cHJLVuTzTg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Afsyg7hkJlK7rV1-ie3wN1OXHPK66g5MhfrDsOvHtRfCOA&oe=69A058F6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "LANDSCAPE.png", "id": "9644139012286835", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391883_9644139018953501_5648143411478632363_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nXmFEUqP9jYQ7kNvwGXYHxc&_nc_oc=AdkP1h7l6br046iEQ8wGTTBMTTKO2Fx_hoD1qVVvuPrqPRrVjB4MvZptPqd7IOoHi6s&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AftSstqIiOefvuovjRCnXeBr0KgZxrv7Z-ogq4GNwkwhAg&oe=69A02C3D"}, "display_name": "War Broke in Heaven", "keywords": ["action", "dragon", "fitness", "fight", "wrath"], "long_description": "Based on the events of the beginning and the end, this VR experience may cause motion sickness, user discretion is advised.\n\nWar Broke in Heaven is a VR experience that puts you in the air while you fight enemies and a dragon to stop the ultimate rebellion. Use controlled moving and tactics to destroy the enemy and not get engulfed by their attacks. You will have a variety of weapons at your disposal each with a unique attribute to destroy your enemy. \n\nUse your head to look at the directions you want to fly to and slash, or fire spirit bombs at the enemy. War broke in heaven has beautiful graphics that will keep you in awe and that will leave you having fun and wanting to come back to play more. ", "short_description": "An epic battle and the fall of a rebellion, this VR experience will keep you engaged and entertained "}]}, "developer_name": "Traindz LLC", "developer_privacy_policy_url": "http://biims.net/warbrokeinheaven", "developer
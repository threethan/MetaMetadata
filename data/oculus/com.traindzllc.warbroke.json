pObKLmh6em2Zkp0EgHoNBwrv6Riom_Lph-t1c&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8RMAKAvratpCFhgddAqdIijkHPW_sVFOs4v5lnJwH0bA&oe=6A3E9743"}, {"file_name": "SCREEN5.png", "id": "1351573939362261", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473393325_1351573942695594_8627772183416663494_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Yo_F4EwcNL4Q7kNvwGqt0R-&_nc_oc=AdpcO1weifxmDuN7w9Rd8DZsA02vFWlQtV-RZOSj7VxUsET5wy2Kc5ZKTtLkvfBgzOw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8LEL3ZICro1AeS1zAG1zhv1KiFWi9jN924lHHp_qD-Kg&oe=6A3E8CF6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "LANDSCAPE.png", "id": "9644139012286835", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473391883_9644139018953501_5648143411478632363_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jY1jtnLLdH0Q7kNvwHcoVo_&_nc_oc=Adqz1WCbB4qsPkx4_PpJMCRg921h8AvIWNe68wJmEN6M1NcBFXJqbcSrHe2jOKQRMEU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_nTpYz0xtxlY1rfKxZaxQrz0eDFs0KbSlY5LyZkidn8A&oe=6A3E987D"}, "display_name": "War Broke in Heaven", "keywords": ["action", "dragon", "fitness", "fight", "wrath"], "long_description": "Based on the events of the beginning and the end, this VR experience may cause motion sickness, user discretion is advised.\n\nWar Broke in Heaven is a VR experience that puts you in the air while you fight enemies and a dragon to stop the ultimate rebellion. Use controlled moving and tactics to destroy the enemy and not get engulfed by their attacks. You will have a variety of weapons at your disposal each with a unique attribute to destroy your enemy. \n\nUse your head to look at the directions you want to fly to and slash, or fire spirit bombs at the enemy. War broke in heaven has beautiful graphics that will keep you in awe and that will leave you having fun and wanting to come back to play more. ", "short_description": "An epic battle and the fall of a rebellion, this V
tIMnVxibsfMwRFordzT1Dy_14OAk1JXDkCdc0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPrTYcGgG0ufkiyHdg2jDB_zqrRUL2wNS4f8mRQMudSnQ&oe=6AC26D43"}, {"file_name": "SCREEN5.png", "id": "1351573939362261", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473393325_1351573942695594_8627772183416663494_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wPgkxPlPirwQ7kNvwGZ-KB7&_nc_oc=Adol5T0pBUgcfuGUR_l6wBUZifLoXdSmkcij6FP0pMKzvtENE9nMYJIv4JeVVwUGnvk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPq9Ob-LClvfphrpRBz17AutmR9RnxeO9aBInO-RhbGNw&oe=6AC262F6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "LANDSCAPE.png", "id": "9644139012286835", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391883_9644139018953501_5648143411478632363_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NMV0egHjyywQ7kNvwF7AlzD&_nc_oc=AdqfGRT4sCScEahjQX2hKIajBDYNPRpNXDtfdrNMWKqaSfI9_uv-2g23PV4joOR-58M&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQONS8iMnJ0_pG7zZGmszBlygwgn_CTH2RX9IMRWnRjeMg&oe=6AC26E7D"}, "display_name": "War Broke in Heaven", "keywords": ["action", "dragon", "fitness", "fight", "wrath"], "long_description": "Based on the events of the beginning and the end, this VR experience may cause motion sickness, user discretion is advised.\n\nWar Broke in Heaven is a VR experience that puts you in the air while you fight enemies and a dragon to stop the ultimate rebellion. Use controlled moving and tactics to destroy the enemy and not get engulfed by their attacks. You will have a variety of weapons at your disposal each with a unique attribute to destroy your enemy. \n\nUse your head to look at the directions you want to fly to and slash, or fire spirit bombs at the enemy. War broke in heaven has beautiful graphics that will keep you in awe and that will leave you having fun and wanting to come back to play more. ", "short_description": "An epic battle and the fall of a rebellion, this V
7EvWBcChW-c6Qw-4YAfXA0XEDuqv8AJM4SOwo&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL24r1SFX6jmOqoakHrbn05P_caB65_T0FDGQCBXDks-Q&oe=6AB29B43"}, {"file_name": "SCREEN5.png", "id": "1351573939362261", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473393325_1351573942695594_8627772183416663494_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mPib0eWHyXoQ7kNvwEHuj4h&_nc_oc=AdrcO73x34W4nYaiN1DgzeZACgO3u_X3OcqfGjVf42v2yPc8O0Y9YGW_bgZLV44OUYI&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJd-TCgMyfRPygcbZdFBQT1yL7GGQfz0kRGPVkxEY-gIg&oe=6AB290F6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "LANDSCAPE.png", "id": "9644139012286835", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391883_9644139018953501_5648143411478632363_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_GuQBAT__KcQ7kNvwG1fXDm&_nc_oc=AdqSKLEwxpI9k-Ur7QvCyhK6lDiNxW_KWJbaQG23WxnkiipznV2PBBUGgaivKi7y6_s&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ-tVhF0_qAUEuIzu7Mkmh3av2QxSrA-yjaWDN8_6Xn2w&oe=6AB29C7D"}, "display_name": "War Broke in Heaven", "keywords": ["action", "dragon", "fitness", "fight", "wrath"], "long_description": "Based on the events of the beginning and the end, this VR experience may cause motion sickness, user discretion is advised.\n\nWar Broke in Heaven is a VR experience that puts you in the air while you fight enemies and a dragon to stop the ultimate rebellion. Use controlled moving and tactics to destroy the enemy and not get engulfed by their attacks. You will have a variety of weapons at your disposal each with a unique attribute to destroy your enemy. \n\nUse your head to look at the directions you want to fly to and slash, or fire spirit bombs at the enemy. War broke in heaven has beautiful graphics that will keep you in awe and that will leave you having fun and wanting to come back to play more. ", "short_description": "An epic battle and the fall of a rebellion, this V
87291122776285_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=915ecnVN9hoQ7kNvwEj54KZ&_nc_oc=Adq0uurSf7Ys03saAiVoAFi_-gFv8QXeO5wrx6gYxDLoOssoSMylDCJQ0YwZ60kBeEY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4ufvLpPI1p2aKKsWuzniUp1Rp6uxQB4oBsHO_iwRvo0Q&oe=6A0343C3"}, {"file_name": "SCREEN5.png", "id": "1351573939362261", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473393325_1351573942695594_8627772183416663494_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5zEjKmQZXmwQ7kNvwE5KG5z&_nc_oc=AdoOgG6_-xdw4o9JpNUD_ewP0ZeoSjOx3gS7EU_XKHAWtJG3aNbo2uMuzK4Ih2DWOAs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af61iradR45kxb_15qu47-2TKFRLz78OFHRw1Wk4ezRfrQ&oe=6A033976"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "LANDSCAPE.png", "id": "9644139012286835", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473391883_9644139018953501_5648143411478632363_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yKSGbw6PdVgQ7kNvwEJCWog&_nc_oc=Adoco9Z6INlsIw0TRl6oNy7gPuxWtvzakg6I3BlxBqRS8mOvTjVRmiMXd7VbLeWJW4A&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7mM_OrV7hbTn2Ulp20WEwnQxKuZHn4MKVzTfhHRv-wOw&oe=6A0344FD"}, "display_name": "War Broke in Heaven", "keywords": ["action", "dragon", "fitness", "fight", "wrath"], "long_description": "Based on the events of the beginning and the end, this VR experience may cause motion sickness, user discretion is advised.\n\nWar Broke in Heaven is a VR experience that puts you in the air while you fight enemies and a dragon to stop the ultimate rebellion. Use controlled moving and tactics to destroy the enemy and not get engulfed by their attacks. You will have a variety of weapons at your disposal each with a unique attribute to destroy your enemy. \n\nUse your head to look at the directions you want to fly to and slash, or fire spirit bombs at the enemy. War broke in heaven has beautiful graphics that will keep you in awe and that will leave you 
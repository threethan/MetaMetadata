c_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfxLpCtPNlxfcXpNoq15qzAC2FKSbhNcPqaoKnu3W2vBWA&oe=69AEAB83"}, {"file_name": "SCREEN5.png", "id": "1351573939362261", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473393325_1351573942695594_8627772183416663494_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A0i24F4ykwEQ7kNvwEsT6Gu&_nc_oc=AdlXld8J6bHTqnekplTUVcWWlhU-VmPCdc0U80zFKKuCDQdhfCLFMFg93QEzB5w-kNQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfzYMMjEuHlY4z2aJVFozVm6AscIX9NPKbpoxjw-ZwxhHA&oe=69AED976"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "LANDSCAPE.png", "id": "9644139012286835", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473391883_9644139018953501_5648143411478632363_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Cd6bWoBfk5AQ7kNvwF8SRVv&_nc_oc=AdmeuQaVRHy4psXH_dTj9WWG8JCsevBL611GI6mtoFAveeqfKlxkIdP0K3ZLL-uAjHg&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afz7VlBI__q-ZtTVfCiTjOqwRUW8OM7rQR8doAzrTy1odA&oe=69AEACBD"}, "display_name": "War Broke in Heaven", "keywords": ["action", "dragon", "fitness", "fight", "wrath"], "long_description": "Based on the events of the beginning and the end, this VR experience may cause motion sickness, user discretion is advised.\n\nWar Broke in Heaven is a VR experience that puts you in the air while you fight enemies and a dragon to stop the ultimate rebellion. Use controlled moving and tactics to destroy the enemy and not get engulfed by their attacks. You will have a variety of weapons at your disposal each with a unique attribute to destroy your enemy. \n\nUse your head to look at the directions you want to fly to and slash, or fire spirit bombs at the enemy. War broke in heaven has beautiful graphics that will keep you in awe and that will leave you having fun and wanting to come back to play more. ", "short_description": "An epic battle and the fall of a rebellion, this VR experience will keep you engaged and entertained "
87291122776285_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2CCgfhqQuxEQ7kNvwGQo9wI&_nc_oc=Adr8BbqOvNF8qcnjwqo_WaAOyk6_m-y03Ct8I-PoyB8nlxYQ7dQGsUF3ZSkB_l47cMQ&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-6yWGRd3a-vIOS7vPB0GLG3-3S4-T3wWVQEOvKMbxOzQ&oe=6A2AD0C3"}, {"file_name": "SCREEN5.png", "id": "1351573939362261", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473393325_1351573942695594_8627772183416663494_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=70i9WRd0KqoQ7kNvwGMZNDT&_nc_oc=AdouQ2lzCbwrcKPJEmEYe7Qkvsu5OVz9fGvN6nzJoN6tomAYKJnI9D7ws1nW9b5yB6w&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9cD09L_VbXlF2yOULSGLGvo7Flshc-CKYV9ojKztoHkQ&oe=6A2AC676"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "LANDSCAPE.png", "id": "9644139012286835", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391883_9644139018953501_5648143411478632363_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TrME9i0EB64Q7kNvwHyPW1D&_nc_oc=AdqyhhjqntfIJEuFy30lhWq5G6JglUnZQGmwfq6EzZNz3ryr4iXie0UzB-WXI_uny2k&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-aEvVLjyuljOlzU0BySosQPL5v6VAvcxPZKpaPBosjgA&oe=6A2AD1FD"}, "display_name": "War Broke in Heaven", "keywords": ["action", "dragon", "fitness", "fight", "wrath"], "long_description": "Based on the events of the beginning and the end, this VR experience may cause motion sickness, user discretion is advised.\n\nWar Broke in Heaven is a VR experience that puts you in the air while you fight enemies and a dragon to stop the ultimate rebellion. Use controlled moving and tactics to destroy the enemy and not get engulfed by their attacks. You will have a variety of weapons at your disposal each with a unique attribute to destroy your enemy. \n\nUse your head to look at the directions you want to fly to and slash, or fire spirit bombs at the enemy. War broke in heaven has beautiful graphics that will keep you in awe and that will leave you 
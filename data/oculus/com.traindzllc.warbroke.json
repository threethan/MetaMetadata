f-JGmnjwP2oPNAnKGHc0gxlCjICMkXjjKikO4&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKwKV9j2-ttDAG9HMjGYPKnM3O-BTYSsmHQcJkqPAgydA&oe=6AA56C43"}, {"file_name": "SCREEN5.png", "id": "1351573939362261", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473393325_1351573942695594_8627772183416663494_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HRbr3s7uKn0Q7kNvwEiEN49&_nc_oc=AdoinAUPaVM4ddDiN4gYjTmPwaipUB8WcyyDqAvUAQCAva66xQKoyiJfSW-0njOz_2k&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKXFEZwZot3hfyMbOk7bURXCk_gMjsBl-XzGWHDfw54dg&oe=6AA561F6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "LANDSCAPE.png", "id": "9644139012286835", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391883_9644139018953501_5648143411478632363_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=px_lE7WPTGoQ7kNvwE_sdnD&_nc_oc=AdqAD46l1Fq6Y67tPKJlpZw5SyTruWGaMZBRRQnxgxcRAfDGTx5GjEn4wib_TOrxy6A&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJPCn1XGQgndCsKWNRW1rFVP_meBLGUeLcx0-szrqeRAw&oe=6AA56D7D"}, "display_name": "War Broke in Heaven", "keywords": ["action", "dragon", "fitness", "fight", "wrath"], "long_description": "Based on the events of the beginning and the end, this VR experience may cause motion sickness, user discretion is advised.\n\nWar Broke in Heaven is a VR experience that puts you in the air while you fight enemies and a dragon to stop the ultimate rebellion. Use controlled moving and tactics to destroy the enemy and not get engulfed by their attacks. You will have a variety of weapons at your disposal each with a unique attribute to destroy your enemy. \n\nUse your head to look at the directions you want to fly to and slash, or fire spirit bombs at the enemy. War broke in heaven has beautiful graphics that will keep you in awe and that will leave you having fun and wanting to come back to play more. ", "short_description": "An epic battle and the fall of a rebellion, this V
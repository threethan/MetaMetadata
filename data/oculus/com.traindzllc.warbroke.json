87291122776285_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QVMvgmYR7xUQ7kNvwH1smrQ&_nc_oc=AdqXYkbTvNPupS6EaDr1XcsY9n1ZoIgm2JsMy0vDMyMwb7SoJxzrT-kbOx0p0vRQLtI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8RGzQoA5t6xufDaWTgkcgSIAwZGC7VgeXqkksT06bkCg&oe=6A258AC3"}, {"file_name": "SCREEN5.png", "id": "1351573939362261", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473393325_1351573942695594_8627772183416663494_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cn87LuvW7XoQ7kNvwEQZVKQ&_nc_oc=Ado9db3TQkpb6HWuB2xW1Cgj8_DPN0NP9W_7-JTdPzniBp_fmB_tGEWIPA9DFpjHFO8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9SK-KuIASBAoQHryg6Tpq1yWQqMW9V-UJt7qq2XZP4yw&oe=6A258076"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "LANDSCAPE.png", "id": "9644139012286835", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391883_9644139018953501_5648143411478632363_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XLwnFtLtksUQ7kNvwGXQBVu&_nc_oc=AdpeBit-lfdUDZMr72zDzVIg2Ych1FrNkd-_bowXlnNeyuMB1ek8OVsIokIJyy7d4Z4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8FaCynpvjQlpLKo2s-6MjHNQ4eNTzCQyFzOhnUVCOpyA&oe=6A258BFD"}, "display_name": "War Broke in Heaven", "keywords": ["action", "dragon", "fitness", "fight", "wrath"], "long_description": "Based on the events of the beginning and the end, this VR experience may cause motion sickness, user discretion is advised.\n\nWar Broke in Heaven is a VR experience that puts you in the air while you fight enemies and a dragon to stop the ultimate rebellion. Use controlled moving and tactics to destroy the enemy and not get engulfed by their attacks. You will have a variety of weapons at your disposal each with a unique attribute to destroy your enemy. \n\nUse your head to look at the directions you want to fly to and slash, or fire spirit bombs at the enemy. War broke in heaven has beautiful graphics that will keep you in awe and that will leave you 
ZjOxTr16XPvpXR-9zFTIhGFPbpxVyjUEeD_dk&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHtY7A_XIktgZx3qxshDDkQQSPzDftr8gVryLkXBPyQAQ&oe=6A941083"}, {"file_name": "SCREEN5.png", "id": "1351573939362261", "uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/473393325_1351573942695594_8627772183416663494_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gssDwKFdb3QQ7kNvwFeb3CN&_nc_oc=AdoyzmOYskVeeZDFYRCCHLO5YvdBpaQ6uSFM9WU63JGmyQIIy_SL2TnF9n55uYLEMqI&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG9qL4Jc1DVDttFKkmlALTCHXozGvKKBrtdmkZg8Ws4rg&oe=6A940636"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "LANDSCAPE.png", "id": "9644139012286835", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/473391883_9644139018953501_5648143411478632363_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xjTpd3FQr78Q7kNvwFV3R0j&_nc_oc=AdqUlqpr9ke65cc4mQjsm7Y2KkKe_sah7Nli2F7UzWvzH_Cteah5oN1Z9-kHqHONiAE&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE_pIeNfOZplr-V3L-KLMTr3rjLbVPBmdjH1F_RdMruKQ&oe=6A9411BD"}, "display_name": "War Broke in Heaven", "keywords": ["action", "dragon", "fitness", "fight", "wrath"], "long_description": "Based on the events of the beginning and the end, this VR experience may cause motion sickness, user discretion is advised.\n\nWar Broke in Heaven is a VR experience that puts you in the air while you fight enemies and a dragon to stop the ultimate rebellion. Use controlled moving and tactics to destroy the enemy and not get engulfed by their attacks. You will have a variety of weapons at your disposal each with a unique attribute to destroy your enemy. \n\nUse your head to look at the directions you want to fly to and slash, or fire spirit bombs at the enemy. War broke in heaven has beautiful graphics that will keep you in awe and that will leave you having fun and wanting to come back to play more. ", "short_description": "An epic battle and the fall of a rebellion, this V
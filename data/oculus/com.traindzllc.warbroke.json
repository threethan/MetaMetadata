9u8ZfTTOQkd64VluNiZBbBBHNGirwMSwR3xto&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPxgCVjMzgI9hOZ8XlmaXXc-gLpdwimLG5PJ8Va5ZZQrA&oe=6AE605C3"}, {"file_name": "SCREEN5.png", "id": "1351573939362261", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473393325_1351573942695594_8627772183416663494_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zl4N5bkE-4kQ7kNvwH3fIw_&_nc_oc=Adod6wK38tzPh2qW4Zby9akI3VDqobAMMao9v5naaJDP9nxNNBfW5aOQMx7UQcLs7iw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPQ0-ZBNuC6hYH5F90Qsxk_90BivKtYOJ8eGxndMZPUjg&oe=6AE5FB76"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "LANDSCAPE.png", "id": "9644139012286835", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391883_9644139018953501_5648143411478632363_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IyhZ-yi9564Q7kNvwH8xwbA&_nc_oc=AdrKZvJUDaQxy2UINugmnGDFo3CGPvIHlvBVJ9_-R545ciKK_FttHyXWqxkA0db8vWE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMrmG4GZ0taOBreArJgvc6FpHX_ZNgDNFyvh1Gp2Bziqw&oe=6AE606FD"}, "display_name": "War Broke in Heaven", "keywords": ["action", "dragon", "fitness", "fight", "wrath"], "long_description": "Based on the events of the beginning and the end, this VR experience may cause motion sickness, user discretion is advised.\n\nWar Broke in Heaven is a VR experience that puts you in the air while you fight enemies and a dragon to stop the ultimate rebellion. Use controlled moving and tactics to destroy the enemy and not get engulfed by their attacks. You will have a variety of weapons at your disposal each with a unique attribute to destroy your enemy. \n\nUse your head to look at the directions you want to fly to and slash, or fire spirit bombs at the enemy. War broke in heaven has beautiful graphics that will keep you in awe and that will leave you having fun and wanting to come back to play more. ", "short_description": "An epic battle and the fall of a rebellion, this V
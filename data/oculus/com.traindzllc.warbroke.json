87291122776285_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=68YAEzhVZpcQ7kNvwGKxqvF&_nc_oc=AdqNx3-L4KEglo-aElvVhc0WzE36l_rFg5egwVFdIL1bKI124nRnX-u3R75cNCtB0l4&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4GQkHHgEXvMoem75KxKetgooUfgBqiiIVGG_rU9KGSVA&oe=6A0F2143"}, {"file_name": "SCREEN5.png", "id": "1351573939362261", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/473393325_1351573942695594_8627772183416663494_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gVGbNSMHN-EQ7kNvwG3m96A&_nc_oc=AdqVgMcNPHlL0x0Dd_TGaf7Fbl_HsAzoIOnQXLVOzPehEIXImIToZ6G4xAsuNhUTt9c&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7y82zyX7VykkGpLUub2hKGujC86h3RptJZ9S51bNt2fw&oe=6A0F16F6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "LANDSCAPE.png", "id": "9644139012286835", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/473391883_9644139018953501_5648143411478632363_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tFvp0kNdFJAQ7kNvwG0Z0xd&_nc_oc=Adpckwenj7o16IBBHHIzf7mpKc1gPE0LXCMxttOfw2jbRNT6t68Qh02rSFAnvDcaaqU&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4XXzso7ap-sEV7az9EO1DGbL_Qnuh87Qio4vZ7hPsG-Q&oe=6A0F227D"}, "display_name": "War Broke in Heaven", "keywords": ["action", "dragon", "fitness", "fight", "wrath"], "long_description": "Based on the events of the beginning and the end, this VR experience may cause motion sickness, user discretion is advised.\n\nWar Broke in Heaven is a VR experience that puts you in the air while you fight enemies and a dragon to stop the ultimate rebellion. Use controlled moving and tactics to destroy the enemy and not get engulfed by their attacks. You will have a variety of weapons at your disposal each with a unique attribute to destroy your enemy. \n\nUse your head to look at the directions you want to fly to and slash, or fire spirit bombs at the enemy. War broke in heaven has beautiful graphics that will keep you in awe and that will leave you 
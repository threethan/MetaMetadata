RYK0xTqGmuyxuK0hyCjDlvT6BC2B5YU5ajg_g&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE9SIFV33j8zgotSuF0nsYv3mq8Rh1WldRjIqJHqo8Gkg&oe=6A804A03"}, {"file_name": "SCREEN5.png", "id": "1351573939362261", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/473393325_1351573942695594_8627772183416663494_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=whyWQnU9ZAoQ7kNvwGGTlnE&_nc_oc=Ado7qceYGFkWLKU99padeBLaK0hy7GGNAQDLIFBj94y9zx3DDlttZYprNdeMOJNQzaY&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF6RLHfB-1JdsGmFBdwYk0DYfhcGI8vhj7bA4Po6-CSKQ&oe=6A803FB6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "LANDSCAPE.png", "id": "9644139012286835", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/473391883_9644139018953501_5648143411478632363_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rvXCIKj_jmwQ7kNvwEZG01x&_nc_oc=AdoTWAsio_p7XdHNs7NCQPZRcybGKri_2MVU1XE9hUdzEJqvr6Bir7JWDqbtea30y24&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFI1wzc9S2ZG9_oD_46LYlYA8NqpyUAsjcjHWr912PG4Q&oe=6A804B3D"}, "display_name": "War Broke in Heaven", "keywords": ["action", "dragon", "fitness", "fight", "wrath"], "long_description": "Based on the events of the beginning and the end, this VR experience may cause motion sickness, user discretion is advised.\n\nWar Broke in Heaven is a VR experience that puts you in the air while you fight enemies and a dragon to stop the ultimate rebellion. Use controlled moving and tactics to destroy the enemy and not get engulfed by their attacks. You will have a variety of weapons at your disposal each with a unique attribute to destroy your enemy. \n\nUse your head to look at the directions you want to fly to and slash, or fire spirit bombs at the enemy. War broke in heaven has beautiful graphics that will keep you in awe and that will leave you having fun and wanting to come back to play more. ", "short_description": "An epic battle and the fall of a rebellion, this V
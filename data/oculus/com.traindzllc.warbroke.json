y-iC--ye4_7_B2tu9qkHjY30iG1lpgxKJFq1s&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBJgXzRMo6ECFkhWzgxfYK4BzvGwn1BJGv1d5bdYJkIQg&oe=6A5B6003"}, {"file_name": "SCREEN5.png", "id": "1351573939362261", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473393325_1351573942695594_8627772183416663494_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ERO3Un_uw88Q7kNvwFrgy3U&_nc_oc=AdrMVj37_zG5xZ2t5cL4tSDEPxRJGX1tFPEppi46q6zkVsJjmhCT9xs75yPUwXR3wTE&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQARZhu0_Jx4aF6U3ZAX6RodOfiIiOKv4KpV6kHLpgd_lg&oe=6A5B8DF6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "LANDSCAPE.png", "id": "9644139012286835", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391883_9644139018953501_5648143411478632363_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2ds4mkBm8xYQ7kNvwEy76D5&_nc_oc=AdqI8u3FyL5QjMQCM0g056GLDyKtfKZVeFbMR08UV02QmxJETzUh9lmgTzctuWqMAFA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDrYXMaHuS5KFPX8JnUufOfIozD1ZNF1cogON7vG182Uw&oe=6A5B613D"}, "display_name": "War Broke in Heaven", "keywords": ["action", "dragon", "fitness", "fight", "wrath"], "long_description": "Based on the events of the beginning and the end, this VR experience may cause motion sickness, user discretion is advised.\n\nWar Broke in Heaven is a VR experience that puts you in the air while you fight enemies and a dragon to stop the ultimate rebellion. Use controlled moving and tactics to destroy the enemy and not get engulfed by their attacks. You will have a variety of weapons at your disposal each with a unique attribute to destroy your enemy. \n\nUse your head to look at the directions you want to fly to and slash, or fire spirit bombs at the enemy. War broke in heaven has beautiful graphics that will keep you in awe and that will leave you having fun and wanting to come back to play more. ", "short_description": "An epic battle and the fall of a rebellion, this V
c_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_Afx2N108thaZyj_dka1Ps8v23PDVnXj4XXSVMIzBd3fjuA&oe=69B54303"}, {"file_name": "SCREEN5.png", "id": "1351573939362261", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473393325_1351573942695594_8627772183416663494_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bO1IBFBW-z0Q7kNvwH0alxg&_nc_oc=AdlEP5AgX2GK2-itSiDaepaLGdZdYA7TcUX4b9tYy1N9FXVYPnt1ogLyf1_3qKBhzkI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfzlJ70_m3fJL_OHdF0174iMLcBobxIgJo8KFPFvmYal4w&oe=69B570F6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "LANDSCAPE.png", "id": "9644139012286835", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391883_9644139018953501_5648143411478632363_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gZYoWAEAzf4Q7kNvwG_wBuI&_nc_oc=AdkuJtOh2Xg7XBpJXk0yVpJqlp6bIGz1vCYcfVxEJJml3JZW-kgT-qGFZOs8Q5U4uWU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_Afw40ngWCY5rzbR3FeGq6yzhJsd3cWmDgqoIQPtWlkQcog&oe=69B5443D"}, "display_name": "War Broke in Heaven", "keywords": ["action", "dragon", "fitness", "fight", "wrath"], "long_description": "Based on the events of the beginning and the end, this VR experience may cause motion sickness, user discretion is advised.\n\nWar Broke in Heaven is a VR experience that puts you in the air while you fight enemies and a dragon to stop the ultimate rebellion. Use controlled moving and tactics to destroy the enemy and not get engulfed by their attacks. You will have a variety of weapons at your disposal each with a unique attribute to destroy your enemy. \n\nUse your head to look at the directions you want to fly to and slash, or fire spirit bombs at the enemy. War broke in heaven has beautiful graphics that will keep you in awe and that will leave you having fun and wanting to come back to play more. ", "short_description": "An epic battle and the fall of a rebellion, this VR experience will keep you engaged and entertained "
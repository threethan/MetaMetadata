iCWIUiJipirYHAPN2d1mFq-8w5H5QrmQnw788&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af94IsZwis4_q_1Jm9k0qVvFr0L4rGDWnSqTR5lU79poQw&oe=6A3D45C3"}, {"file_name": "SCREEN5.png", "id": "1351573939362261", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/473393325_1351573942695594_8627772183416663494_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Yo_F4EwcNL4Q7kNvwGlNHd2&_nc_oc=AdoZIqKAGzTQ1siu22zyvslNNG4jLvQQ8YngcY99rCBETK0ttyug7Hcg-nhPH1KBh24&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9oq4AFre3_LspKjUEwXLReGvL2DfUzS9YCCE_WxUsMwg&oe=6A3D3B76"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "LANDSCAPE.png", "id": "9644139012286835", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/473391883_9644139018953501_5648143411478632363_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jY1jtnLLdH0Q7kNvwGXLcPV&_nc_oc=Adr43uYr-Y7b8ICc975rrR4Aeti5l2DiLPZ_PcjCjU1kilbcbeCeW-hWtXGVBTYyvIk&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_6ssMUI8d2dqPZF3kER70xer1BvpkXw4c2tW88VGEClg&oe=6A3D46FD"}, "display_name": "War Broke in Heaven", "keywords": ["action", "dragon", "fitness", "fight", "wrath"], "long_description": "Based on the events of the beginning and the end, this VR experience may cause motion sickness, user discretion is advised.\n\nWar Broke in Heaven is a VR experience that puts you in the air while you fight enemies and a dragon to stop the ultimate rebellion. Use controlled moving and tactics to destroy the enemy and not get engulfed by their attacks. You will have a variety of weapons at your disposal each with a unique attribute to destroy your enemy. \n\nUse your head to look at the directions you want to fly to and slash, or fire spirit bombs at the enemy. War broke in heaven has beautiful graphics that will keep you in awe and that will leave you having fun and wanting to come back to play more. ", "short_description": "An epic battle and the fall of a rebellion, this V
Njg0HO5Ap0VCGB0xvDl809FwU7LuWcJTQDOw4&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH84YFYCXytSPhiectIHLMhs89TJ-1hmhHm5FBGmTrfvw&oe=6A883303"}, {"file_name": "SCREEN5.png", "id": "1351573939362261", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/473393325_1351573942695594_8627772183416663494_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A24UEs95yEIQ7kNvwEiFWPh&_nc_oc=Adq-CR0nP-wVScdVE0eZxM-8CZg58R7N1DhgqRE7R9Ezw2Y1O2AZy_M5NCFgcxYyD0A&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG7Wg2-vPSO63sk70grzM1dqQdajhpK_96HE_4fZNNhZg&oe=6A8828B6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "LANDSCAPE.png", "id": "9644139012286835", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/473391883_9644139018953501_5648143411478632363_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lVemYpyna9wQ7kNvwGeHeSO&_nc_oc=Adp7qjkD8ZEJ8DHf02ylwGYn2dOBq8gVFpA6NfOZaVzlpekhkT0LZkFJ3vUSi-NAz6Q&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF8I5Pj8GmZ_ql68I8coSjWdReA1r3huLzenHjsaaJaUA&oe=6A88343D"}, "display_name": "War Broke in Heaven", "keywords": ["action", "dragon", "fitness", "fight", "wrath"], "long_description": "Based on the events of the beginning and the end, this VR experience may cause motion sickness, user discretion is advised.\n\nWar Broke in Heaven is a VR experience that puts you in the air while you fight enemies and a dragon to stop the ultimate rebellion. Use controlled moving and tactics to destroy the enemy and not get engulfed by their attacks. You will have a variety of weapons at your disposal each with a unique attribute to destroy your enemy. \n\nUse your head to look at the directions you want to fly to and slash, or fire spirit bombs at the enemy. War broke in heaven has beautiful graphics that will keep you in awe and that will leave you having fun and wanting to come back to play more. ", "short_description": "An epic battle and the fall of a rebellion, this V
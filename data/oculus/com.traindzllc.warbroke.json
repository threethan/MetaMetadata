55HPYK3Y3mD3WpQQe8UPE2-MvY5IxN5VG8yNs&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNqLv_35pVVcYVq-3jz8oH1I-8emuEheU-8Jub9Sfud8g&oe=6AC904C3"}, {"file_name": "SCREEN5.png", "id": "1351573939362261", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/473393325_1351573942695594_8627772183416663494_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CQltjtmFbWEQ7kNvwEbNAqd&_nc_oc=AdqNhqJ13W71ctHqVwPLO8pqKo38toFcVGymq6-YGMds0GpFuOu0l4K8WJc7xk2s1RU&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPWkrYLK8_izf0P5OHh6y_ZXTK3PJKI-5YxUnhGltm-sg&oe=6AC8FA76"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "LANDSCAPE.png", "id": "9644139012286835", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/473391883_9644139018953501_5648143411478632363_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z6kl8jZGxhUQ7kNvwHvHNM3&_nc_oc=AdozIjZi9yz29A8NwQE6W-HVWcYeWWaUSodedBatYMFo8eGWW-K5e2gm2a-dgXXOP-M&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOi4oltuHJezO5rEzJ3kED2JWRUWON9WoLo9lxWRtDSSQ&oe=6AC905FD"}, "display_name": "War Broke in Heaven", "keywords": ["action", "dragon", "fitness", "fight", "wrath"], "long_description": "Based on the events of the beginning and the end, this VR experience may cause motion sickness, user discretion is advised.\n\nWar Broke in Heaven is a VR experience that puts you in the air while you fight enemies and a dragon to stop the ultimate rebellion. Use controlled moving and tactics to destroy the enemy and not get engulfed by their attacks. You will have a variety of weapons at your disposal each with a unique attribute to destroy your enemy. \n\nUse your head to look at the directions you want to fly to and slash, or fire spirit bombs at the enemy. War broke in heaven has beautiful graphics that will keep you in awe and that will leave you having fun and wanting to come back to play more. ", "short_description": "An epic battle and the fall of a rebellion, this V
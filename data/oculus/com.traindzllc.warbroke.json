87291122776285_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EKfQdYl6FWsQ7kNvwHq9yOV&_nc_oc=AdpyTKg8PXxeO1_rNaSNXapkU84SSMzUmNII7X_KvHGJ9wbri6oUoGrjpayCtXjWhVQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-7qIa5QAsvSzggjegl5_xWMBWNVyrFFApHUwk8Jea1EQ&oe=6A2D73C3"}, {"file_name": "SCREEN5.png", "id": "1351573939362261", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473393325_1351573942695594_8627772183416663494_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5ycdok5h5yUQ7kNvwFzqIpT&_nc_oc=AdodvATtjeNgYNp2rcl4LsHl1FSq9_dGGaWvQPp2cOLP7zbobw26ilYIf-8p7KB_-fk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9NYa9IB3H0btDL3LMLK_FB3-NRD6u1SjY2UYcucDw_3w&oe=6A2D6976"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "LANDSCAPE.png", "id": "9644139012286835", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391883_9644139018953501_5648143411478632363_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xGV22sFonEUQ7kNvwFIJv5o&_nc_oc=AdpMbOobdluS-DSemHYxtFMHy74koawSpcrY9_Naw7H4V3Or1pdJ-wDg03FCsiClcmA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-DhouIahgztD8V1kBp1U_JfCF9DC3dxRQHfJXrZop5cQ&oe=6A2D74FD"}, "display_name": "War Broke in Heaven", "keywords": ["action", "dragon", "fitness", "fight", "wrath"], "long_description": "Based on the events of the beginning and the end, this VR experience may cause motion sickness, user discretion is advised.\n\nWar Broke in Heaven is a VR experience that puts you in the air while you fight enemies and a dragon to stop the ultimate rebellion. Use controlled moving and tactics to destroy the enemy and not get engulfed by their attacks. You will have a variety of weapons at your disposal each with a unique attribute to destroy your enemy. \n\nUse your head to look at the directions you want to fly to and slash, or fire spirit bombs at the enemy. War broke in heaven has beautiful graphics that will keep you in awe and that will leave you 
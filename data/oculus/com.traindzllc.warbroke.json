87291122776285_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G9Tzgv3Y-VAQ7kNvwF28MgP&_nc_oc=Adr-IbON29AidYXj2ZEtIieKxD5LJjGBUqEqi7BZ5uaAgMnpj84oY7QAO5jPBEM391I&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4JkEhSbHMVnMlMKJIjk5Q8UXh73KxZ9rsAl_PXu0qAZA&oe=6A09DB43"}, {"file_name": "SCREEN5.png", "id": "1351573939362261", "uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/473393325_1351573942695594_8627772183416663494_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_QGQ2zC00p4Q7kNvwHVPt5f&_nc_oc=AdpfRCP37Q4n7xqZnMZlVWZ-BmUf_bplDF_5znzvZMJRZUqbqkin14Gh_yw4R8cMQa4&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4KdI3EhxYXsIJCbj1BQx_mh4SpDeqWU6InxfgG74wuEg&oe=6A09D0F6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "LANDSCAPE.png", "id": "9644139012286835", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/473391883_9644139018953501_5648143411478632363_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aTnvuXUuvOUQ7kNvwHdqxyY&_nc_oc=Adqjpxi2J1MRSvtIEs59B_8NlH79vSrj9IvitFtaZiRn5qeekT7qMagRwyHsfQh0Ujg&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6kdun1HRU27Tz3s_r-USFzHTDSXm2EMEpo6YV8H6P9NQ&oe=6A09DC7D"}, "display_name": "War Broke in Heaven", "keywords": ["action", "dragon", "fitness", "fight", "wrath"], "long_description": "Based on the events of the beginning and the end, this VR experience may cause motion sickness, user discretion is advised.\n\nWar Broke in Heaven is a VR experience that puts you in the air while you fight enemies and a dragon to stop the ultimate rebellion. Use controlled moving and tactics to destroy the enemy and not get engulfed by their attacks. You will have a variety of weapons at your disposal each with a unique attribute to destroy your enemy. \n\nUse your head to look at the directions you want to fly to and slash, or fire spirit bombs at the enemy. War broke in heaven has beautiful graphics that will keep you in awe and that will leave you 
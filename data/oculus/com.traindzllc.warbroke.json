vjKWLav0flSrK_hqfIUZiK0P6tKFLIxxImv0Q&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCk-LrWYwDbSeYsP7SnhBpVawfEEEtCczSWBZYypl4QBA&oe=6A5A46C3"}, {"file_name": "SCREEN5.png", "id": "1351573939362261", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/473393325_1351573942695594_8627772183416663494_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ERO3Un_uw88Q7kNvwGpla4D&_nc_oc=Adpd8e8cKm78-KdXJU8mxSJnpfxS3NV65MJ_ft6_wOiHaO2QPf7ijBz9Kz0it8gqt9g&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCcx2nSg9cfG0jg2oh1sL_XdxXv7dbQuc3OSidje7XrIw&oe=6A5A3C76"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "LANDSCAPE.png", "id": "9644139012286835", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/473391883_9644139018953501_5648143411478632363_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2ds4mkBm8xYQ7kNvwHBldXW&_nc_oc=Adpw_PA-lbDtHm71BaqlUohTQq6UskpJWEuZfHs7iw-cBIwN32V6q3O_lMl6UYpvsvw&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBWbvvwr6MF7kg4gomaVsylNKHCVaQw5-fa2SZtJ38cpA&oe=6A5A47FD"}, "display_name": "War Broke in Heaven", "keywords": ["action", "dragon", "fitness", "fight", "wrath"], "long_description": "Based on the events of the beginning and the end, this VR experience may cause motion sickness, user discretion is advised.\n\nWar Broke in Heaven is a VR experience that puts you in the air while you fight enemies and a dragon to stop the ultimate rebellion. Use controlled moving and tactics to destroy the enemy and not get engulfed by their attacks. You will have a variety of weapons at your disposal each with a unique attribute to destroy your enemy. \n\nUse your head to look at the directions you want to fly to and slash, or fire spirit bombs at the enemy. War broke in heaven has beautiful graphics that will keep you in awe and that will leave you having fun and wanting to come back to play more. ", "short_description": "An epic battle and the fall of a rebellion, this V
87291122776285_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aziCJ8H03kMQ7kNvwHYSzP3&_nc_oc=Adr_mOM4BaajbGCSS-oQGk5g6xeyJvO33zm4yjoX1vNQZEq6sDB8eKBzekBIH8gKMRQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3UcLesjYWLESQXa6ioFlu0sqFQkTw6Cs9MhsJVuZPoAQ&oe=69EDF383"}, {"file_name": "SCREEN5.png", "id": "1351573939362261", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473393325_1351573942695594_8627772183416663494_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AwycjtNCnjEQ7kNvwFdGC8n&_nc_oc=AdphHJJp4Ox-I2mViLtlO3Xk3_ERqV7yEYJyt1FjYZySkC9QgGOczNzfgnz6L_rONnE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3l_i-dq9q4VbDQlsuQITu8Cbg2ZNW3FuA78-r2ze9rnA&oe=69EE2176"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "LANDSCAPE.png", "id": "9644139012286835", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391883_9644139018953501_5648143411478632363_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CaByQMDl-N8Q7kNvwGf1u9t&_nc_oc=AdqwnmFK7Y1APlgA-z0RB7fVStCCS7K-5n6yCQxCxa7ZsYZuelg-aXw4-U1nI_YXiKE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2El4x7UkMfZmg-RV7eP8ALbkm1ULtuPOZpYcLJjcG4zA&oe=69EDF4BD"}, "display_name": "War Broke in Heaven", "keywords": ["action", "dragon", "fitness", "fight", "wrath"], "long_description": "Based on the events of the beginning and the end, this VR experience may cause motion sickness, user discretion is advised.\n\nWar Broke in Heaven is a VR experience that puts you in the air while you fight enemies and a dragon to stop the ultimate rebellion. Use controlled moving and tactics to destroy the enemy and not get engulfed by their attacks. You will have a variety of weapons at your disposal each with a unique attribute to destroy your enemy. \n\nUse your head to look at the directions you want to fly to and slash, or fire spirit bombs at the enemy. War broke in heaven has beautiful graphics that will keep you in awe and that will leave you 
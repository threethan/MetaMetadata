Hg-1HDP6SVCDhMhMhthrJO1dP8tztZgGOmJ7w&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCvRlaveNvtCkIVe8Vel0obLsDk-fgzOF2io8JzlNrFtQ&oe=6A4E6943"}, {"file_name": "SCREEN5.png", "id": "1351573939362261", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/473393325_1351573942695594_8627772183416663494_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=br2hOBBh970Q7kNvwHV8JHm&_nc_oc=Adrvkkh6CXiXsSeLfUlJRUdeW9P8mXgUhE5CtwR29HgZ0Xb2nzpWr3RCrsvuwXvmVqk&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDnoQTDOoAE7pp6ZRFYRi5_6zT043g9W8TL-aQ5sDcTSQ&oe=6A4E5EF6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "LANDSCAPE.png", "id": "9644139012286835", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/473391883_9644139018953501_5648143411478632363_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eDnykUJaDqQQ7kNvwEkadgX&_nc_oc=AdpyQd_J7t5DbLdvcMBmnMEfUcRRu1E6rSC-iGlPalGhaTaRy94sPw7TydY-oG8IjQo&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBuLq2uHcK37V236sSv5yYBavUNljougXpwGKEJQkPpwA&oe=6A4E6A7D"}, "display_name": "War Broke in Heaven", "keywords": ["action", "dragon", "fitness", "fight", "wrath"], "long_description": "Based on the events of the beginning and the end, this VR experience may cause motion sickness, user discretion is advised.\n\nWar Broke in Heaven is a VR experience that puts you in the air while you fight enemies and a dragon to stop the ultimate rebellion. Use controlled moving and tactics to destroy the enemy and not get engulfed by their attacks. You will have a variety of weapons at your disposal each with a unique attribute to destroy your enemy. \n\nUse your head to look at the directions you want to fly to and slash, or fire spirit bombs at the enemy. War broke in heaven has beautiful graphics that will keep you in awe and that will leave you having fun and wanting to come back to play more. ", "short_description": "An epic battle and the fall of a rebellion, this V
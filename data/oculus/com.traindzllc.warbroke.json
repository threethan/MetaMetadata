87291122776285_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6neu1t8wuLgQ7kNvwE7Vqij&_nc_oc=AdoRaK6b-s2wh9mavPoDQzvYkSMmwTT8Iat4a8jJO8uGzSi0-5Ei84EjhZESNCVo5qs&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4l7lIVQ41r0_m8w7eHKJB0uy9pYgDI3MxPejWXRIcEHw&oe=6A1EF343"}, {"file_name": "SCREEN5.png", "id": "1351573939362261", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473393325_1351573942695594_8627772183416663494_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=klXx6uejKvoQ7kNvwH4KRZl&_nc_oc=Ado1W7EXxsFubMA71pBsMhTLlTXhdPTefC1VTMiTRrymlaAAq0knRKx_qHMXX7kjwaU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4fS6VIrJNNtiMCJ5VNAFzb3nMbRWhWUuwWO4zcgQ89ww&oe=6A1EE8F6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "LANDSCAPE.png", "id": "9644139012286835", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391883_9644139018953501_5648143411478632363_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ii9WHE2fPAEQ7kNvwF8BGTs&_nc_oc=Adp9W9mFARawlohR6D1MxFJ6R61VAwIpfam7RJVOgIWMetBQJdUF6OFV9xguLlpL29w&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7YiIJoY-yMH5olIKaz3gRSWA_iJY8t81bkSuBm1FcJhw&oe=6A1EF47D"}, "display_name": "War Broke in Heaven", "keywords": ["action", "dragon", "fitness", "fight", "wrath"], "long_description": "Based on the events of the beginning and the end, this VR experience may cause motion sickness, user discretion is advised.\n\nWar Broke in Heaven is a VR experience that puts you in the air while you fight enemies and a dragon to stop the ultimate rebellion. Use controlled moving and tactics to destroy the enemy and not get engulfed by their attacks. You will have a variety of weapons at your disposal each with a unique attribute to destroy your enemy. \n\nUse your head to look at the directions you want to fly to and slash, or fire spirit bombs at the enemy. War broke in heaven has beautiful graphics that will keep you in awe and that will leave you 
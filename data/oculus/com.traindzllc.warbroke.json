subhsAsbI-AzdoXhKFq5SdBCx6P3awF0gD0ME&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP_RG-n1zBALvL6WSv2ZIGT54IcfGwvYU6ODFjMef-MOg&oe=6ACCF943"}, {"file_name": "SCREEN5.png", "id": "1351573939362261", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473393325_1351573942695594_8627772183416663494_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3RueTe6hs78Q7kNvwHkwTRU&_nc_oc=AdqqfPpkeW3S0CuvnaCF3hHhS93LkEF_L-1ZbV4aae8x68O7UQ30MURX2-hShDmKZj0&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOqLxZxYj-NsVdP0KzvdZlKGM8FwBnb2SpIrY-Y0x8y4A&oe=6ACCEEF6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "LANDSCAPE.png", "id": "9644139012286835", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391883_9644139018953501_5648143411478632363_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZA1ItwKn6TAQ7kNvwHZvERC&_nc_oc=AdruAmzDpV3oOd_vB_5WNx8NpM2_6jUP1ZJbklDNjmilHUMBdpADPm83uBeCeWELvqY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMpWnF4QbVlRw9ffN3XW_TwAQSM0L5EBRn6ch5tHizCMg&oe=6ACCFA7D"}, "display_name": "War Broke in Heaven", "keywords": ["action", "dragon", "fitness", "fight", "wrath"], "long_description": "Based on the events of the beginning and the end, this VR experience may cause motion sickness, user discretion is advised.\n\nWar Broke in Heaven is a VR experience that puts you in the air while you fight enemies and a dragon to stop the ultimate rebellion. Use controlled moving and tactics to destroy the enemy and not get engulfed by their attacks. You will have a variety of weapons at your disposal each with a unique attribute to destroy your enemy. \n\nUse your head to look at the directions you want to fly to and slash, or fire spirit bombs at the enemy. War broke in heaven has beautiful graphics that will keep you in awe and that will leave you having fun and wanting to come back to play more. ", "short_description": "An epic battle and the fall of a rebellion, this V
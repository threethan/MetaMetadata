hN3m8yVJbdzH-yO--sCMdCz-vXJMaxZHZVQqB9XXTmDPDEFz8A47o&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEhFH8MjoU-tKjlxoXjDLWBOLeNwjk0NRlLaJk0yO2AAg&oe=6A8ECA83"}, {"file_name": "SCREEN5.png", "id": "1351573939362261", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/473393325_1351573942695594_8627772183416663494_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-AT1PBYg5rEQ7kNvwHu8YiO&_nc_oc=AdoXiTBDTvk0ExfdpsHzHYeSup2CiNyaTowrIApK0_u78pAEcfz6Ngx9OtW_70pAb88&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG3NEnreNgBW6HPSqdOvqXiZWjPSNZ0gpGg4ksnIifUXw&oe=6A8EC036"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "LANDSCAPE.png", "id": "9644139012286835", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/473391883_9644139018953501_5648143411478632363_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RobXYMrK3FUQ7kNvwF-qXGm&_nc_oc=Adpp9RLOzqnzr-UrNCVvXJEG5ZtNUO_Ydp4frab72IySBueQS4ceaVp6K5G8w5aFE2Y&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEDQREXsQYsVdw5jrdxGtT9IKDyZV0QlhrJ8f11Rertxg&oe=6A8ECBBD"}, "display_name": "War Broke in Heaven", "keywords": ["action", "dragon", "fitness", "fight", "wrath"], "long_description": "Based on the events of the beginning and the end, this VR experience may cause motion sickness, user discretion is advised.\n\nWar Broke in Heaven is a VR experience that puts you in the air while you fight enemies and a dragon to stop the ultimate rebellion. Use controlled moving and tactics to destroy the enemy and not get engulfed by their attacks. You will have a variety of weapons at your disposal each with a unique attribute to destroy your enemy. \n\nUse your head to look at the directions you want to fly to and slash, or fire spirit bombs at the enemy. War broke in heaven has beautiful graphics that will keep you in awe and that will leave you having fun and wanting to come back to play more. ", "short_description": "An epic battle and the fall of a
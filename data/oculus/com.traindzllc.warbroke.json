c_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_Afz1tHAaZxTG18OHz3QAywPtjXY3ggA2G73SyiTg-pAWow&oe=69B14E83"}, {"file_name": "SCREEN5.png", "id": "1351573939362261", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473393325_1351573942695594_8627772183416663494_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A0i24F4ykwEQ7kNvwFU3BfV&_nc_oc=AdlGavl9S1wuhQdmrjXogVhPFLXtF7ddrIhi6h71hYNdO4HpnGRT46xXtYSk9aEBAXQ&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfzNKHOWUl3yF8Blj5KVCWGmritvup7_YSM9i4PDePBtCw&oe=69B14436"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "LANDSCAPE.png", "id": "9644139012286835", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391883_9644139018953501_5648143411478632363_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Cd6bWoBfk5AQ7kNvwG85CSt&_nc_oc=AdksqKyeY059F_AZO9lxGDJNo9G0k3QZ5OH0GC51irdo2dkKQsCt8OxTDX5pBxFyw0Q&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_Afx4hoQKXrALoExSij-gj-hZPKaq3X-GXF8HA0SRTLB5pQ&oe=69B14FBD"}, "display_name": "War Broke in Heaven", "keywords": ["action", "dragon", "fitness", "fight", "wrath"], "long_description": "Based on the events of the beginning and the end, this VR experience may cause motion sickness, user discretion is advised.\n\nWar Broke in Heaven is a VR experience that puts you in the air while you fight enemies and a dragon to stop the ultimate rebellion. Use controlled moving and tactics to destroy the enemy and not get engulfed by their attacks. You will have a variety of weapons at your disposal each with a unique attribute to destroy your enemy. \n\nUse your head to look at the directions you want to fly to and slash, or fire spirit bombs at the enemy. War broke in heaven has beautiful graphics that will keep you in awe and that will leave you having fun and wanting to come back to play more. ", "short_description": "An epic battle and the fall of a rebellion, this VR experience will keep you engaged and entertained "
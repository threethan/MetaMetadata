1BKVmnFa2GYqpg-cqyICHQQ6TYBnTeIlNXK08&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRTZnrh41bVVTc-PY76cHTrywY0GRDXhOQMbogLkQddeQ&oe=6AEF4043"}, {"file_name": "SCREEN5.png", "id": "1351573939362261", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473393325_1351573942695594_8627772183416663494_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WGzNuMe6yqUQ7kNvwG2ySYw&_nc_oc=Adr2q4vSnffmMI3xKyOBJdnbzde3KHTsYflaGqvrN38sHPQxp4hzDNLNW2u5tJjEIwM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSgpYgm2QQicxvu9EJsoiaPzekm9hSzFG9oTSFsfNsKkQ&oe=6AEF35F6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "LANDSCAPE.png", "id": "9644139012286835", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473391883_9644139018953501_5648143411478632363_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iHF4w0FK4-gQ7kNvwFF65xV&_nc_oc=Adrs1SVVAXE-K-LTfVYGM2gdGQB9gySFoUZ74T6v-hK9KBXIo-uzr9_XXBnvRI0qbHw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR0Ya2zNX215P1I09kjvtXeN8GP2lE0vRe3Tt2MLM2Cyg&oe=6AEF417D"}, "display_name": "War Broke in Heaven", "keywords": ["action", "dragon", "fitness", "fight", "wrath"], "long_description": "Based on the events of the beginning and the end, this VR experience may cause motion sickness, user discretion is advised.\n\nWar Broke in Heaven is a VR experience that puts you in the air while you fight enemies and a dragon to stop the ultimate rebellion. Use controlled moving and tactics to destroy the enemy and not get engulfed by their attacks. You will have a variety of weapons at your disposal each with a unique attribute to destroy your enemy. \n\nUse your head to look at the directions you want to fly to and slash, or fire spirit bombs at the enemy. War broke in heaven has beautiful graphics that will keep you in awe and that will leave you having fun and wanting to come back to play more. ", "short_description": "An epic battle and the fall of a rebellion, this V
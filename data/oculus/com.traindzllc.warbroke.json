fDNWgapC83TpZJKtw9cuviQK6eIbxU8FjIE7E&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCFO7sQadGCMk3w_ESg8CfC1Ifk536xzgeNUIw01HB2iw&oe=6A4A74C3"}, {"file_name": "SCREEN5.png", "id": "1351573939362261", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473393325_1351573942695594_8627772183416663494_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=85F3AzQM4cMQ7kNvwH0TXzs&_nc_oc=AdpznAgDJk4B0hnLd6LbxPVQP2hRdBXvjqKCCKYQcDg01kU4fmqNEbOO8kPVoCiKWMM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBkrPuDSmNLi7WKYORyfJ5tCksG28AutTjyouHMKrd9Ng&oe=6A4A6A76"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "LANDSCAPE.png", "id": "9644139012286835", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473391883_9644139018953501_5648143411478632363_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CtIIj7qdELsQ7kNvwGbPhsE&_nc_oc=AdqXbJW1OYG3Py1vzSqfVVKSYrVzZcZQbsiaku6bLpCfvFSVYDd_sDDFBE0lFNTIPG4&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC5A_4jxzM0LRMNjGiVjJSNPnDI9NMaqaEnw-c-gRGnmQ&oe=6A4A75FD"}, "display_name": "War Broke in Heaven", "keywords": ["action", "dragon", "fitness", "fight", "wrath"], "long_description": "Based on the events of the beginning and the end, this VR experience may cause motion sickness, user discretion is advised.\n\nWar Broke in Heaven is a VR experience that puts you in the air while you fight enemies and a dragon to stop the ultimate rebellion. Use controlled moving and tactics to destroy the enemy and not get engulfed by their attacks. You will have a variety of weapons at your disposal each with a unique attribute to destroy your enemy. \n\nUse your head to look at the directions you want to fly to and slash, or fire spirit bombs at the enemy. War broke in heaven has beautiful graphics that will keep you in awe and that will leave you having fun and wanting to come back to play more. ", "short_description": "An epic battle and the fall of a rebellion, this V
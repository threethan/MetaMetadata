1ZVL8siaGjZKkHm6r4bPP90frGfOBj3gcTcpQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJkbgbDilmNyQ6ROh_fglU8TZUHCmVhdgfCw_McaW3t9g&oe=6AB3ECC3"}, {"file_name": "SCREEN5.png", "id": "1351573939362261", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473393325_1351573942695594_8627772183416663494_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5dVaO6VPUVIQ7kNvwG13P4u&_nc_oc=AdoY7GgRBQIYDpFNETf3NnFeyaCQYNxcwHaHSApwLDCseZt8xF0F3CTzn47156-bGOQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJJSsVdSIa1rdMaxPP3l5xr9v7gKYS4j7WRe1HYJnH33g&oe=6AB3E276"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "LANDSCAPE.png", "id": "9644139012286835", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473391883_9644139018953501_5648143411478632363_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9qnQ1eYjwd0Q7kNvwHe2w2o&_nc_oc=AdqbQCvRCU7kX3h1EdYQfWPJIIii06JoG6SA6fXDP3wkFgENip6fYYsaPBmoFnexZtQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK3dMKlQARD7uPaqB-iYOrq-7dtAXZlu5qUYO2i7QDb_w&oe=6AB3EDFD"}, "display_name": "War Broke in Heaven", "keywords": ["action", "dragon", "fitness", "fight", "wrath"], "long_description": "Based on the events of the beginning and the end, this VR experience may cause motion sickness, user discretion is advised.\n\nWar Broke in Heaven is a VR experience that puts you in the air while you fight enemies and a dragon to stop the ultimate rebellion. Use controlled moving and tactics to destroy the enemy and not get engulfed by their attacks. You will have a variety of weapons at your disposal each with a unique attribute to destroy your enemy. \n\nUse your head to look at the directions you want to fly to and slash, or fire spirit bombs at the enemy. War broke in heaven has beautiful graphics that will keep you in awe and that will leave you having fun and wanting to come back to play more. ", "short_description": "An epic battle and the fall of a rebellion, this V
: "SCREEN4.png", "id": "2076396659440356", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473392019_2076396662773689_8266087291122776285_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jJvqZ8QXP8MQ7kNvwGBqoZb&_nc_oc=AdqfOBnq80nylrxBzv-r9ssqxkloP0qRLmdzHQClCU36Lg9IQVj4yQdKe2ObhUiGZV0&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSmHEFum1qcTyFF_NvRP-u18lwelRU43uS_rLbsM4sulA&oe=6AFF1243"}, {"file_name": "SCREEN5.png", "id": "1351573939362261", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473393325_1351573942695594_8627772183416663494_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GKZ6sLG2XMIQ7kNvwH4s5t8&_nc_oc=AdoMZPvRRpJk-ZAJ_jZQ9FZq5gmjpU4HLIXudQP1TLedWgyfpgdezoXWAVHu4nmns4I&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSYOy0saESaArtiD52_yWn34vhLBCEzJdtaLcrxMcw6vw&oe=6AFF07F6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "LANDSCAPE.png", "id": "9644139012286835", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473391883_9644139018953501_5648143411478632363_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Xtx9HO3HFMgQ7kNvwHgAY50&_nc_oc=AdoR4N58xyikkBUpWpMc6YmIlpJQIdhkUl3QRn94nhJDMuuos3tkkbRIL9bAsygo2Ik&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSAJln4NhbRptcRKafErEulpRVpEFmdJo2dbFeNbZBnrQ&oe=6AFF137D"}, "display_name": "War Broke in Heaven", "keywords": ["action", "dragon", "fitness", "fight", "wrath"], "long_description": "Based on the events of the beginning and the end, this VR experience may cause motion sickness, user discretion is advised.\n\nWar Broke in Heaven is a VR experience that puts you in the air while you fight enemies and a dragon to stop the ultimate rebellion. Use controlled moving and tactics to destroy the enemy and not get engulfed by their attacks. You will have a variety of weapons at your disposal each with a unique attribute to destroy your enemy. \n\nUse your head to look at the directions you want to fly to and slash, or fire spirit bombs at the enemy. War broke in heaven has beautiful graphics that will keep you in awe and that will leave you having fun and wanting to come back to play more. ", "short_description": "An epic battle and the fall of a rebellion, this VR experience will keep you engaged and entertained "}]}, "developer_name": "Traindz LLC", "developer_privacy_policy_url": "http://biims.net/warbrokeinheaven", "developer_terms_of_service_url": null, "publisher_name": "Traindz LLC", "support_website_url": null, "website_url": "http://biims.net/warbrokeinheaven", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9444449118955217"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473391934_617973464283098_4288500641272340701_n.png?stp=dst-png_s360x360&_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QB6_RVTTTycQ7kNvwFNq0Ow&_nc_oc=Adq1SsIUCs2PD3VTK9JphniVKD0CeQ2p-1HKsKh09Uyl4nyC16yRjyxbrkGxk7xBeEc&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQThQvROOIsWbB_Trecp5tzVhWaG_rE_MHYCkWWo8PWEmg&oe=6AFF0E0C"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "War Broke in Heaven", "platform": "ANDROID_6DOF", "context_category": {"context_category
87291122776285_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gavAeau6XDYQ7kNvwE4zL2J&_nc_oc=Adq3QhNEzOaViFrRJlh2BYJA4b5R70aBHvXsZcIvVNPnurrwimlDFX3YKcc_iG479aA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5QEYbk_jVqvVx2WgIR1YVE6zmH5p3q4J1fRiA3osaobw&oe=69FB5AC3"}, {"file_name": "SCREEN5.png", "id": "1351573939362261", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473393325_1351573942695594_8627772183416663494_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nW0miqai66kQ7kNvwGI5S5W&_nc_oc=AdovMWPcvD_tDeQCr4rYp8nN6H8lgMNN3xx96LvRr2W9NUrnToaEl7koo6qiyRUWQNQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6hg2WTxkWQ6B6F2SMd7NUD9JnRVru9XSuWBGE-dgmPWg&oe=69FB5076"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "LANDSCAPE.png", "id": "9644139012286835", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473391883_9644139018953501_5648143411478632363_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ber0A_FK0soQ7kNvwGf2mJV&_nc_oc=AdrZGTfx06iiLTvdSUuwHGnr5JrbgT4FreQAK79Z3zeO4wMG88a9GfatGyOUgUpcyw8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4KCBeCf-Y8kzc2PHE1WUmcj4qpgYNBPJdOA86Gz2QR8A&oe=69FB5BFD"}, "display_name": "War Broke in Heaven", "keywords": ["action", "dragon", "fitness", "fight", "wrath"], "long_description": "Based on the events of the beginning and the end, this VR experience may cause motion sickness, user discretion is advised.\n\nWar Broke in Heaven is a VR experience that puts you in the air while you fight enemies and a dragon to stop the ultimate rebellion. Use controlled moving and tactics to destroy the enemy and not get engulfed by their attacks. You will have a variety of weapons at your disposal each with a unique attribute to destroy your enemy. \n\nUse your head to look at the directions you want to fly to and slash, or fire spirit bombs at the enemy. War broke in heaven has beautiful graphics that will keep you in awe and that will leave you 
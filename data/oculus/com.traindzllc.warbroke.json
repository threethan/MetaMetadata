87291122776285_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QVMvgmYR7xUQ7kNvwF79YOD&_nc_oc=Ado0fRm2-jqsVLf0IUFXkkbwdk7vi9uAGE_yxPlYmScqzbDwaq7_0IHPKtOk9qhWcDY&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af96kYM9OeM63EXbwpnrW7WSJOV3y74jutkdzONwLKUneA&oe=6A282DC3"}, {"file_name": "SCREEN5.png", "id": "1351573939362261", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473393325_1351573942695594_8627772183416663494_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cn87LuvW7XoQ7kNvwHlSSw_&_nc_oc=AdqQnGJsSBS2QIP9AMgWcF9M3wFBLHp7BICDo-r--q8D-H7d8eAf2E4VP7oN6SGgn_M&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_lbkXFa7WHrMNX-YcBIbnrY-P6cMnlLrdGMa7pLkfOLQ&oe=6A282376"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "LANDSCAPE.png", "id": "9644139012286835", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391883_9644139018953501_5648143411478632363_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XLwnFtLtksUQ7kNvwHBU0BL&_nc_oc=AdqAWePUkcwCJG5Zm_KUm3XWgdH7YnDiI6jdMj0y2nWC2OEOAAkjMEDIoyVnnHQ6970&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8aXu_6UyZuOfSyruuk7wmOgutIcl323bk07fREcJhTAw&oe=6A282EFD"}, "display_name": "War Broke in Heaven", "keywords": ["action", "dragon", "fitness", "fight", "wrath"], "long_description": "Based on the events of the beginning and the end, this VR experience may cause motion sickness, user discretion is advised.\n\nWar Broke in Heaven is a VR experience that puts you in the air while you fight enemies and a dragon to stop the ultimate rebellion. Use controlled moving and tactics to destroy the enemy and not get engulfed by their attacks. You will have a variety of weapons at your disposal each with a unique attribute to destroy your enemy. \n\nUse your head to look at the directions you want to fly to and slash, or fire spirit bombs at the enemy. War broke in heaven has beautiful graphics that will keep you in awe and that will leave you 
c_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_Afw1IXjak_lzeYBQBK1w4YRk0vWobVw1SRWHkz3h4Upreg&oe=69B2A003"}, {"file_name": "SCREEN5.png", "id": "1351573939362261", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473393325_1351573942695594_8627772183416663494_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bO1IBFBW-z0Q7kNvwHJXBFx&_nc_oc=AdmZl0z03H7_X0yn-FyP_kmvUG7-NYJwdphftOxWxkraAFeK_DgC74h3Gfzez1ebcPo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfzaF87ssmNUNIYyqF-E1tvqcW2bnMu-HHesyTSbxRoL3Q&oe=69B2CDF6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "LANDSCAPE.png", "id": "9644139012286835", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473391883_9644139018953501_5648143411478632363_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gZYoWAEAzf4Q7kNvwGbBZI-&_nc_oc=Adl49NkPO_mu2qlUjNsC5ELnXLEP-x4aEyaYZEcfTD5M_l_uXhr_v9v7yygQbsQv-ok&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfyOdqMH54cLiVPvfc4RZ6ZWMZ4Q8GMnN8zkIzAn8w5kTQ&oe=69B2A13D"}, "display_name": "War Broke in Heaven", "keywords": ["action", "dragon", "fitness", "fight", "wrath"], "long_description": "Based on the events of the beginning and the end, this VR experience may cause motion sickness, user discretion is advised.\n\nWar Broke in Heaven is a VR experience that puts you in the air while you fight enemies and a dragon to stop the ultimate rebellion. Use controlled moving and tactics to destroy the enemy and not get engulfed by their attacks. You will have a variety of weapons at your disposal each with a unique attribute to destroy your enemy. \n\nUse your head to look at the directions you want to fly to and slash, or fire spirit bombs at the enemy. War broke in heaven has beautiful graphics that will keep you in awe and that will leave you having fun and wanting to come back to play more. ", "short_description": "An epic battle and the fall of a rebellion, this VR experience will keep you engaged and entertained "
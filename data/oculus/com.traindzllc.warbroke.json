9fugA2KDA-3w61FqpndxoT6mTu6yGDC6gMeCk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAFhSFBHSGcwtFlMxnaohMfUIXqwQE0Xn_67XjaWebjAA&oe=6A64D2C3"}, {"file_name": "SCREEN5.png", "id": "1351573939362261", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473393325_1351573942695594_8627772183416663494_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AEDSPZu21VoQ7kNvwE-FLmL&_nc_oc=AdoXt0sOi0ocpZeEHyR0PVkeEiSyjcwJndYXYmHkUe3pGYXe3KEV_gPCg5XQW_Qxit4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBTpcERAi1Ni6IXV3-MY8qPzy5LSzgQwRC4h8BjzxjX6Q&oe=6A64C876"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "LANDSCAPE.png", "id": "9644139012286835", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391883_9644139018953501_5648143411478632363_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0-TWOjT2sboQ7kNvwEHl_6C&_nc_oc=AdrStT6TqwnMrQ-FrzaSVGIntgPkLQ_GGY_SkoLOmVgGjrBSEzCqc-2E9CWwJ-n9vVM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCS3S3yW3wpDyVovTHLRLabDmPZzcz96qj4O4uizbFoCw&oe=6A64D3FD"}, "display_name": "War Broke in Heaven", "keywords": ["action", "dragon", "fitness", "fight", "wrath"], "long_description": "Based on the events of the beginning and the end, this VR experience may cause motion sickness, user discretion is advised.\n\nWar Broke in Heaven is a VR experience that puts you in the air while you fight enemies and a dragon to stop the ultimate rebellion. Use controlled moving and tactics to destroy the enemy and not get engulfed by their attacks. You will have a variety of weapons at your disposal each with a unique attribute to destroy your enemy. \n\nUse your head to look at the directions you want to fly to and slash, or fire spirit bombs at the enemy. War broke in heaven has beautiful graphics that will keep you in awe and that will leave you having fun and wanting to come back to play more. ", "short_description": "An epic battle and the fall of a rebellion, this V
c_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=8&oh=00_AfwVzAI6gEqpakuy6K7AdS7BpkPk1Pt5gSYP8Tf4Y5br2Q&oe=69C12083"}, {"file_name": "SCREEN5.png", "id": "1351573939362261", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/473393325_1351573942695594_8627772183416663494_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ObWhfDVGWrsQ7kNvwHQveBb&_nc_oc=AdpBdJ9A3GcdR8IvP0LdEn3de26lgqwrEtEbniH1FK6oqGbp-zrz-ExdfkGpkQ4wMrg&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=8&oh=00_Afwo2WuEMMnU4KYkDhHICI2z0vfjnBcZ_4jY6oaAOO9TTg&oe=69C14E76"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "LANDSCAPE.png", "id": "9644139012286835", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/473391883_9644139018953501_5648143411478632363_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L3i9Wcm1OGIQ7kNvwGHWiLB&_nc_oc=AdqKrtqYK84H0mSroXSxJrxgHgbqR7MhxHNjNUAoHk_zpmgEwdLEqAUcDAmOHwvDFek&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_AfyldYJ1esrzKKXFClJ0fzkio2gihmWAw_9XH_mADgKT-w&oe=69C121BD"}, "display_name": "War Broke in Heaven", "keywords": ["action", "dragon", "fitness", "fight", "wrath"], "long_description": "Based on the events of the beginning and the end, this VR experience may cause motion sickness, user discretion is advised.\n\nWar Broke in Heaven is a VR experience that puts you in the air while you fight enemies and a dragon to stop the ultimate rebellion. Use controlled moving and tactics to destroy the enemy and not get engulfed by their attacks. You will have a variety of weapons at your disposal each with a unique attribute to destroy your enemy. \n\nUse your head to look at the directions you want to fly to and slash, or fire spirit bombs at the enemy. War broke in heaven has beautiful graphics that will keep you in awe and that will leave you having fun and wanting to come back to play more. ", "short_description": "An epic battle and the fall of a rebellion, this VR experience will keep you engaged and entertained "
gr-4MmQN0maAz2pO6a15K9RyH1G025Tww_OqY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1KxkE2dn0j8HmYOZ0Lu_a1SFClDRP_G10jXYFDQQlYoA&oe=69DB7E83"}, {"file_name": "SCREEN5.png", "id": "1351573939362261", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473393325_1351573942695594_8627772183416663494_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bbPaZN9LZb0Q7kNvwEVMAbr&_nc_oc=Adrz5IXJFd0bEKRNXW4dVwvZxKxH42mAnTvoojDpb2EBvCWlkKAcFcE7NWA9T0cV3Os&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1mwWyQi5Pz3pS1ctQ5PPDPHxGxNgyMuHjQOq_c4SkYCQ&oe=69DBAC76"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "LANDSCAPE.png", "id": "9644139012286835", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391883_9644139018953501_5648143411478632363_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZcbBPsw7EyAQ7kNvwHySU_r&_nc_oc=AdoezPlTV9O7btRgIp0TbTN2S-d_H1h-id4cRwp2yRlgYTHO9hp3mNVp_U4-Qv1CRPk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af247KzC-2qidJeoAN_tikUOW79xoHuqJpgd73Q7dW9jQA&oe=69DB7FBD"}, "display_name": "War Broke in Heaven", "keywords": ["action", "dragon", "fitness", "fight", "wrath"], "long_description": "Based on the events of the beginning and the end, this VR experience may cause motion sickness, user discretion is advised.\n\nWar Broke in Heaven is a VR experience that puts you in the air while you fight enemies and a dragon to stop the ultimate rebellion. Use controlled moving and tactics to destroy the enemy and not get engulfed by their attacks. You will have a variety of weapons at your disposal each with a unique attribute to destroy your enemy. \n\nUse your head to look at the directions you want to fly to and slash, or fire spirit bombs at the enemy. War broke in heaven has beautiful graphics that will keep you in awe and that will leave you having fun and wanting to come back to play more. ", "short_description": "An epic battle and the fall of a rebellion, this V
c_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfyIlvCMt1YMqqd2QzkimJtEPjy8bZmbV_MRVN5UZks1oA&oe=69BFCF03"}, {"file_name": "SCREEN5.png", "id": "1351573939362261", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473393325_1351573942695594_8627772183416663494_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ObWhfDVGWrsQ7kNvwE2XqtV&_nc_oc=AdlFhFUYBrfvCuJPFY4C_JetMuhhiGglNYm4-D11FhhDndGFqU88o51bieHtpkq3LYw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfzUJgPpDaHBppPUfRka0UrQwh-Oy58jRfU8rzjrfiAfhA&oe=69BFFCF6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "LANDSCAPE.png", "id": "9644139012286835", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391883_9644139018953501_5648143411478632363_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L3i9Wcm1OGIQ7kNvwFUhRBn&_nc_oc=AdkT1zmA8ICCAiWJ2SbxxmANy4q3vNxx6g-5yutTqgvtu_KxPSb4XWP12KnL_ryoZKk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfwKFpm0z2LJCuAl81t7Z4CXPjdJL0czKdEL9wylOOQyYQ&oe=69BFD03D"}, "display_name": "War Broke in Heaven", "keywords": ["action", "dragon", "fitness", "fight", "wrath"], "long_description": "Based on the events of the beginning and the end, this VR experience may cause motion sickness, user discretion is advised.\n\nWar Broke in Heaven is a VR experience that puts you in the air while you fight enemies and a dragon to stop the ultimate rebellion. Use controlled moving and tactics to destroy the enemy and not get engulfed by their attacks. You will have a variety of weapons at your disposal each with a unique attribute to destroy your enemy. \n\nUse your head to look at the directions you want to fly to and slash, or fire spirit bombs at the enemy. War broke in heaven has beautiful graphics that will keep you in awe and that will leave you having fun and wanting to come back to play more. ", "short_description": "An epic battle and the fall of a rebellion, this VR experience will keep you engaged and entertained "
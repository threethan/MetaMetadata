1GBi7eAMR7rFTqQoq_YpJKy3l5O1OZvkaMdF4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2pWec-HPI3OaS_jDJyisUw47Unc2-DEo3H42NB4Es5Vg&oe=69D27C43"}, {"file_name": "SCREEN5.png", "id": "1351573939362261", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473393325_1351573942695594_8627772183416663494_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lhu7CCYRwoMQ7kNvwFRDx9H&_nc_oc=AdpWIf82_W_6mWvXU96sXG9DeI8ZEcoFPEfA7HM2AiVIYURiTUgS21CTI-t8bSwMqEY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2Wox0L8vosoL-BIYpY9U2d7o9Qa0MkdAq_kMrCbmXwdw&oe=69D271F6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "LANDSCAPE.png", "id": "9644139012286835", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473391883_9644139018953501_5648143411478632363_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O0dwST77dX0Q7kNvwFMOKAS&_nc_oc=AdodGBZRYIxlxVDSySctCMwIRGI5PKylwChIfnTC10vYVFERkcgfxE1Hztk64XCQ0fQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0SALQbd3EWVjZ6bSfd4hUNB_Ul5THq0_wN3asw7HhYAg&oe=69D27D7D"}, "display_name": "War Broke in Heaven", "keywords": ["action", "dragon", "fitness", "fight", "wrath"], "long_description": "Based on the events of the beginning and the end, this VR experience may cause motion sickness, user discretion is advised.\n\nWar Broke in Heaven is a VR experience that puts you in the air while you fight enemies and a dragon to stop the ultimate rebellion. Use controlled moving and tactics to destroy the enemy and not get engulfed by their attacks. You will have a variety of weapons at your disposal each with a unique attribute to destroy your enemy. \n\nUse your head to look at the directions you want to fly to and slash, or fire spirit bombs at the enemy. War broke in heaven has beautiful graphics that will keep you in awe and that will leave you having fun and wanting to come back to play more. ", "short_description": "An epic battle and the fall of a rebellion, this V
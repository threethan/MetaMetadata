4sdTfoOkHb6rxnNnc8S9IGL_Mifajv2-eCs3U&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKO_8sXxnwHDc71MZ0KBfYFpD-6kmvu2sx1zXcf_eKJ6Q&oe=6ABD2743"}, {"file_name": "SCREEN5.png", "id": "1351573939362261", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473393325_1351573942695594_8627772183416663494_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mTDPgGIdAdQQ7kNvwEv1Cs2&_nc_oc=AdoqNo2-1j5b2CaHlUxqIo8ZyLCnWvWUVBN8FpUNq_7opnD8dDpfmDRI-YWUKhc5FNs&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK0yDSmYfTePihq3H1H8ffkN1b0PYfaNdFoveSTsjXGTQ&oe=6ABD1CF6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "LANDSCAPE.png", "id": "9644139012286835", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391883_9644139018953501_5648143411478632363_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iH3daLrUkWkQ7kNvwGhBxD8&_nc_oc=AdrOOp9LJSz5K-UHnGf2VZ-oNZwUZlhMQSeY-J2IH5Xpe4mOPXEn0vS3ywnPbS3_oc4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKME5cgISqd28oBg5e-dtyJbEv3oGamHV7fxiED3V2iYA&oe=6ABD287D"}, "display_name": "War Broke in Heaven", "keywords": ["action", "dragon", "fitness", "fight", "wrath"], "long_description": "Based on the events of the beginning and the end, this VR experience may cause motion sickness, user discretion is advised.\n\nWar Broke in Heaven is a VR experience that puts you in the air while you fight enemies and a dragon to stop the ultimate rebellion. Use controlled moving and tactics to destroy the enemy and not get engulfed by their attacks. You will have a variety of weapons at your disposal each with a unique attribute to destroy your enemy. \n\nUse your head to look at the directions you want to fly to and slash, or fire spirit bombs at the enemy. War broke in heaven has beautiful graphics that will keep you in awe and that will leave you having fun and wanting to come back to play more. ", "short_description": "An epic battle and the fall of a rebellion, this V
87291122776285_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EKfQdYl6FWsQ7kNvwGJIKRX&_nc_oc=Adprj1bEAhWRLftZvI9M49w2714FQ2rWisMyR8kSoWCWgV-uw8_h5amoDcwqpBIBjOc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-YoVGE4fCxlfS5_am3PSwwnRwqBFJm1Ozvh2BWEvOv-w&oe=6A2EC543"}, {"file_name": "SCREEN5.png", "id": "1351573939362261", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473393325_1351573942695594_8627772183416663494_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5ycdok5h5yUQ7kNvwHL3ZOn&_nc_oc=AdpcXrMeCaBCy4ql-X02m2cHfGrgBZZ8fNe0bWbXuXD5fTYjKvf6EGggJQ_vPROxSG8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_KCoOKCjzH-5uqDw87u0xU2GBR9jJ376epXkSJhYQTsQ&oe=6A2EBAF6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "LANDSCAPE.png", "id": "9644139012286835", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391883_9644139018953501_5648143411478632363_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xGV22sFonEUQ7kNvwF-Ji5Y&_nc_oc=AdpCvQgKH02yGkrLskH10ylIYhZxVqhPz-l-khp8zVbpgDJBjR5E2-o7-pVh1e_5dDo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-AOhnOHm7RPgpURW8Xizb3B8JEEPwTtBDRD8UoHwY0lA&oe=6A2EC67D"}, "display_name": "War Broke in Heaven", "keywords": ["action", "dragon", "fitness", "fight", "wrath"], "long_description": "Based on the events of the beginning and the end, this VR experience may cause motion sickness, user discretion is advised.\n\nWar Broke in Heaven is a VR experience that puts you in the air while you fight enemies and a dragon to stop the ultimate rebellion. Use controlled moving and tactics to destroy the enemy and not get engulfed by their attacks. You will have a variety of weapons at your disposal each with a unique attribute to destroy your enemy. \n\nUse your head to look at the directions you want to fly to and slash, or fire spirit bombs at the enemy. War broke in heaven has beautiful graphics that will keep you in awe and that will leave you 
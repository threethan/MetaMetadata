87291122776285_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iQaHAY9TkAwQ7kNvwESCA9A&_nc_oc=AdppdRhm9YUuLj4WzQeTn9x1A49JiUc1pW7BRL90cETGaEANU5V_FzAX47r3NRW5dnw&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af26RgXFOdMbxtb9NPhGOnXDhSPMKEPxG51UEzlVwsP1KA&oe=69F4C343"}, {"file_name": "SCREEN5.png", "id": "1351573939362261", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/473393325_1351573942695594_8627772183416663494_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9QuMEGCuZJUQ7kNvwG1rdcY&_nc_oc=Ado12Yesel1wwpP59jB_GZnBRP7bJe7Ii0jCAL9f8wMJIJeWnz2cLYYYBgkGiD7SM7w&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0uKlbAbYhu-DqI48k5O6Ml3gig3D7o61v_72RJQgK9Tg&oe=69F4B8F6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "LANDSCAPE.png", "id": "9644139012286835", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/473391883_9644139018953501_5648143411478632363_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ktF45kQDEaQQ7kNvwGEoxuU&_nc_oc=Adpho7GdPh_i-ZcRIb8zRORZpRmKFDIwsnr0FMc4vhazAfV20PzRLvISmAjFY2gdkMY&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1nJLhJkCRZGmgrvQxaOC42ZncOvLjJwAmTWbPPUHE1Lg&oe=69F4C47D"}, "display_name": "War Broke in Heaven", "keywords": ["action", "dragon", "fitness", "fight", "wrath"], "long_description": "Based on the events of the beginning and the end, this VR experience may cause motion sickness, user discretion is advised.\n\nWar Broke in Heaven is a VR experience that puts you in the air while you fight enemies and a dragon to stop the ultimate rebellion. Use controlled moving and tactics to destroy the enemy and not get engulfed by their attacks. You will have a variety of weapons at your disposal each with a unique attribute to destroy your enemy. \n\nUse your head to look at the directions you want to fly to and slash, or fire spirit bombs at the enemy. War broke in heaven has beautiful graphics that will keep you in awe and that will leave you 
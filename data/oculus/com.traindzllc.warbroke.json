NvwEfqxXL&_nc_oc=AdoqjkF26uLu4MXtCu0KssaLEi0HvNWEK12txcb1GDrcHIzzlAXXfcKWAIXDIs4-9pg&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_Af2UEqAtqs5NBlYvblrFPbg7L9fVcskD8cMp_xNwXu-g9A&oe=69F1E803"}, {"file_name": "SCREEN5.png", "id": "1351573939362261", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/473393325_1351573942695594_8627772183416663494_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9QuMEGCuZJUQ7kNvwFRq5Mj&_nc_oc=Adp1MH3UGd49wg2QM71vvVD4HFFS-QKzI_i11E_vU22TQa1p-V2nU2itkH3PxFgrsS4&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&oh=00_Af0jRvDgPMdcUrIniBl53A25D1nOhPIDhmNdkkuTX4hO3Q&oe=69F215F6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "LANDSCAPE.png", "id": "9644139012286835", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/473391883_9644139018953501_5648143411478632363_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ktF45kQDEaQQ7kNvwF-99O2&_nc_oc=AdqmDGxWV8jwwGjzHVAtTeu8XlhJOeetCgEDYHylarXSNcc1kdbx2nTvFmXHTa7F3GA&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_Af0kU93mRIkRDg4zOROkP0Rarj8kB0KEA0CcWAkhf_upHg&oe=69F1E93D"}, "display_name": "War Broke in Heaven", "keywords": ["action", "dragon", "fitness", "fight", "wrath"], "long_description": "Based on the events of the beginning and the end, this VR experience may cause motion sickness, user discretion is advised.\n\nWar Broke in Heaven is a VR experience that puts you in the air while you fight enemies and a dragon to stop the ultimate rebellion. Use controlled moving and tactics to destroy the enemy and not get engulfed by their attacks. You will have a variety of weapons at your disposal each with a unique attribute to destroy your enemy. \n\nUse your head to look at the directions you want to fly to and slash, or fire spirit bombs at the enemy. War broke in heaven has beautiful graphics that will keep you in awe and that will leave you having fun and wanting to come back to play more. ", "short_description": "An epic battle and the fall of a rebellion, this VR experience will keep you engaged and entertained "}]}, "developer_name": "Traindz LLC", "developer_privacy_policy_url": "http://biims.net/warbrokeinheaven", "developer_terms_of_service_url": null, "publisher_name": "Traindz LLC", "support_website_url": null, "website_url": "http://biims.net/warbrokeinheaven", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9444449118955217"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/473391934_617973464283098_4288500641272340701_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-UROvl7xquAQ7kNvwFNznxx&_nc_oc=AdoK9sMXnUlFuhCT40e2tD3FT_66H1i4GYV3-Pppc85o6flEgPuz2Pl1fpCrc-S5hTk&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3Bw9_OYrGQ0oDsYHuo6TNkBTbLWTV-0m6mwWFLJJXlJA&oe=69F21C0C"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "War Broke in Heaven", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Action", "id": "459781504968480"}], "release_date": 1683647096, "lastRevision": {"nodes": [{"id": "6343012632432230", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "6343012625765564", "is_first_pa
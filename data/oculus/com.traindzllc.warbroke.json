eCFn3L5e5Xr5HSk8-wtPff3cAVYi1osDhELEU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBxVm_RW-ZoSZI3vC_OVhsCNCMw-enOw5-hEgZvQEA4jQ&oe=6A4D17C3"}, {"file_name": "SCREEN5.png", "id": "1351573939362261", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473393325_1351573942695594_8627772183416663494_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=br2hOBBh970Q7kNvwGVl8UQ&_nc_oc=Adq2SVBx00IbTBPsblAz77q5b2_Z9DgX4dLk07eIN_kcV70i3y3oMjo4Kd3eV20lilc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBSlZ9KYwsXtVzM9OR833e_06k3p6XTaT1HgxKFR-OnjA&oe=6A4D0D76"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "LANDSCAPE.png", "id": "9644139012286835", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391883_9644139018953501_5648143411478632363_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eDnykUJaDqQQ7kNvwEk9EZX&_nc_oc=AdqBNKkhmOxcYJ7hvJS7RGyMOsgffoZPTsKgir2iMp4GfnvS2SRYcIDUJMhlYkgkq_0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA9CwXyU5OuScicGjFwpmEwAGn1M0HiKxfzHuKnYg18Mw&oe=6A4D18FD"}, "display_name": "War Broke in Heaven", "keywords": ["action", "dragon", "fitness", "fight", "wrath"], "long_description": "Based on the events of the beginning and the end, this VR experience may cause motion sickness, user discretion is advised.\n\nWar Broke in Heaven is a VR experience that puts you in the air while you fight enemies and a dragon to stop the ultimate rebellion. Use controlled moving and tactics to destroy the enemy and not get engulfed by their attacks. You will have a variety of weapons at your disposal each with a unique attribute to destroy your enemy. \n\nUse your head to look at the directions you want to fly to and slash, or fire spirit bombs at the enemy. War broke in heaven has beautiful graphics that will keep you in awe and that will leave you having fun and wanting to come back to play more. ", "short_description": "An epic battle and the fall of a rebellion, this V
: "SCREEN4.png", "id": "2076396659440356", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473392019_2076396662773689_8266087291122776285_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TuI6xmTkdmYQ7kNvwHVyo0K&_nc_oc=AdpNFufCwSbnUiU9J3xZYZ-gp5lbOj7Fs9ExS14kpX7xPTSq6iseKy7998MHBH2hGMc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQS1kzjY5SzVwqoPuzY8obqvDvi44ytsjjLPjHiXeUqcMw&oe=6B0C7983"}, {"file_name": "SCREEN5.png", "id": "1351573939362261", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473393325_1351573942695594_8627772183416663494_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gWUpO6zmRaQQ7kNvwGsEpD5&_nc_oc=AdqZa4IIdDxSBuPB1TQpVFifGvxqyaNlKA0gb6DDv2tksyR1e5eWBETiCVI4ma0VgY0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQmEXNFhPWRRr7osAcDYmen0UEgd5X1rK5aoDXLd4tILg&oe=6B0C6F36"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "LANDSCAPE.png", "id": "9644139012286835", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391883_9644139018953501_5648143411478632363_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-v96T6-BHr8Q7kNvwGY46s-&_nc_oc=Adp1xC7is3Wqyclm7rbCllEYpOj9ub_vw2SZ_1PSgcG6DbS7rTFtCanl2NUj2sspbAA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSg_-QGAEcmNFzIIra0A-i1FyXoL6vxXeCpGoaBoJ96yg&oe=6B0C7ABD"}, "display_name": "War Broke in Heaven", "keywords": ["action", "dragon", "fitness", "fight", "wrath"], "long_description": "Based on the events of the beginning and the end, this VR experience may cause motion sickness, user discretion is advised.\n\nWar Broke in Heaven is a VR experience that puts you in the air while you fight enemies and a dragon to stop the ultimate rebellion. Use controlled moving and tactics to destroy the enemy and not get engulfed by their attacks. You will have a variety of weapons at your disposal each with a unique attribute to destroy your enemy. \n\nUse your head to look at the directions you want to fly to and slash, or fire spirit bombs at the enemy. War broke in heaven has beautiful graphics that will keep you in awe and that will leave you having fun and wanting to come back to play more. ", "short_description": "An epic battle and the fall of a rebellion, this VR experience will keep you engaged and entertained "}]}, "developer_name": "Traindz LLC", "developer_privacy_policy_url": "http://biims.net/warbrokeinheaven", "developer_terms_of_service_url": null, "publisher_name": "Traindz LLC", "support_website_url": null, "website_url": "http://biims.net/warbrokeinheaven", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9444449118955217"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391934_617973464283098_4288500641272340701_n.png?stp=dst-png_s360x360&_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6rSuJwKjIC4Q7kNvwHqXlZ-&_nc_oc=AdoA6-h871Fh4EjdCnYUIAdaCye_vb3TpdyyUmP24yazqGNQiyh8hHc4OHbJ-s-d81I&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQyZ9hFIm3I6VhPCmMtvggmMdg8vmpOjNCPYHF-b3j95Q&oe=6B0C754C"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "War Broke in Heaven", "platform": "ANDROID_6DOF", "context_category": {"context_category
87291122776285_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=915ecnVN9hoQ7kNvwFVqKOC&_nc_oc=AdqM-mcSQvTc00Csrbwoa237prMST17UYW084-V6mhAkk6N3nx_ZBiaHUeiP_jfjjmo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7FN3NEdENliUb0OPK6WbDcwMMglQ6vY0UEZfh9GpQ1AA&oe=6A049543"}, {"file_name": "SCREEN5.png", "id": "1351573939362261", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473393325_1351573942695594_8627772183416663494_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5zEjKmQZXmwQ7kNvwFmIvnC&_nc_oc=AdpMDI_8cTEpbqdfeSQ0Mtxd-u4Vv5Z_knmYR8Rol2oGTfJeYFUuzaXlysd_O_OI3tk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6C4u5pnTTJNMYzq2K1jOSvt1imebb1oIXi69WfCbGXQw&oe=6A048AF6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "LANDSCAPE.png", "id": "9644139012286835", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391883_9644139018953501_5648143411478632363_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yKSGbw6PdVgQ7kNvwHC2F5r&_nc_oc=AdpL6xz6dWjqJk7gdDL2LNsD3_EESlHjAshcLLyQ8dZvHY9fpJZ3oY4tUbjTAC5D80U&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5VU6mn3Pjc-lnYHmzTGhkhC7IBbcTlGGQ--WNb1wrn6Q&oe=6A04967D"}, "display_name": "War Broke in Heaven", "keywords": ["action", "dragon", "fitness", "fight", "wrath"], "long_description": "Based on the events of the beginning and the end, this VR experience may cause motion sickness, user discretion is advised.\n\nWar Broke in Heaven is a VR experience that puts you in the air while you fight enemies and a dragon to stop the ultimate rebellion. Use controlled moving and tactics to destroy the enemy and not get engulfed by their attacks. You will have a variety of weapons at your disposal each with a unique attribute to destroy your enemy. \n\nUse your head to look at the directions you want to fly to and slash, or fire spirit bombs at the enemy. War broke in heaven has beautiful graphics that will keep you in awe and that will leave you 
c_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfxLhdd0eXf_ui-QkRXmizQ5mTXO7PjtcJsUZW-c6zjqSA&oe=69AFFD03"}, {"file_name": "SCREEN5.png", "id": "1351573939362261", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473393325_1351573942695594_8627772183416663494_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A0i24F4ykwEQ7kNvwEg2XSu&_nc_oc=AdkThrXBUSDDB4Hw30xpsWLIc7YebQS07mzK0I_WY5HLlE4QrK5Vm4gzPZaghZ0DJgk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfxltEttDX6U2MPXe-HoAJtgKBLHjMAyKNr-oZl_pdGz5Q&oe=69B02AF6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "LANDSCAPE.png", "id": "9644139012286835", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473391883_9644139018953501_5648143411478632363_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Cd6bWoBfk5AQ7kNvwGK-WBu&_nc_oc=AdkpiNl9gNFl1J8LwldmjtDFODmqHE3RaU39d6mQaWwJYy_yKSbNFqpe18qBpCalPBM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afy4I31FzhmrHqTFZmy7XgyXhtN2kJbsWUgNB6NPMnGwXQ&oe=69AFFE3D"}, "display_name": "War Broke in Heaven", "keywords": ["action", "dragon", "fitness", "fight", "wrath"], "long_description": "Based on the events of the beginning and the end, this VR experience may cause motion sickness, user discretion is advised.\n\nWar Broke in Heaven is a VR experience that puts you in the air while you fight enemies and a dragon to stop the ultimate rebellion. Use controlled moving and tactics to destroy the enemy and not get engulfed by their attacks. You will have a variety of weapons at your disposal each with a unique attribute to destroy your enemy. \n\nUse your head to look at the directions you want to fly to and slash, or fire spirit bombs at the enemy. War broke in heaven has beautiful graphics that will keep you in awe and that will leave you having fun and wanting to come back to play more. ", "short_description": "An epic battle and the fall of a rebellion, this VR experience will keep you engaged and entertained "
BbZEIPoBseaVlxZ2KyD8NwSWqEzX3Rno9pMyo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFzSLGYpTpgJabG1pJDf9WcaYYHNCb2468OFjZ9lBVBcg&oe=6A8C2783"}, {"file_name": "SCREEN5.png", "id": "1351573939362261", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473393325_1351573942695594_8627772183416663494_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-AT1PBYg5rEQ7kNvwG-95Tx&_nc_oc=Adrxl68lpf5Uq2bw9Iy1D12tkPOfVH3c9xZuIkw88W3zyJBx1wtoY09wRNrhfcMad4c&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFcVQok8e-4sqC5v6pPSD_9RrFO50AlpXqWus1MhAx0nQ&oe=6A8C1D36"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "LANDSCAPE.png", "id": "9644139012286835", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391883_9644139018953501_5648143411478632363_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RobXYMrK3FUQ7kNvwFyU_d7&_nc_oc=AdomFRsy4bjGS33NuwCpyTLnZN_wtN69cBZJFo9f40T69zIHsAGd0oHf8xtFcoefQ8c&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEVHwjl9D5qbqZl9taBImgZbrFb12I9liJy-6WuFiDcyw&oe=6A8C28BD"}, "display_name": "War Broke in Heaven", "keywords": ["action", "dragon", "fitness", "fight", "wrath"], "long_description": "Based on the events of the beginning and the end, this VR experience may cause motion sickness, user discretion is advised.\n\nWar Broke in Heaven is a VR experience that puts you in the air while you fight enemies and a dragon to stop the ultimate rebellion. Use controlled moving and tactics to destroy the enemy and not get engulfed by their attacks. You will have a variety of weapons at your disposal each with a unique attribute to destroy your enemy. \n\nUse your head to look at the directions you want to fly to and slash, or fire spirit bombs at the enemy. War broke in heaven has beautiful graphics that will keep you in awe and that will leave you having fun and wanting to come back to play more. ", "short_description": "An epic battle and the fall of a rebellion, this V
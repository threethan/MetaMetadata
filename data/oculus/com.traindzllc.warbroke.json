gEHwhwCmBcMnLL4uK1JY-E-BxTto6YX0PNkcU&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzcaFTt9tjpATDSKBu6KtCr6dQm3h8haBXwWx0XRRWyDw&oe=69C66683"}, {"file_name": "SCREEN5.png", "id": "1351573939362261", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/473393325_1351573942695594_8627772183416663494_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H2V432fRGx4Q7kNvwG-wuH4&_nc_oc=Adr2E4c1-OO-hPunQzY955esRBGXE75KmIiBXmTzKRgd_o720n3Y1YVj7JiS2BSMwuc&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afx67Sy7FV2-NFnTMvEOgLbRW96OrcxfbOZf4XouoyVHxA&oe=69C69476"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "LANDSCAPE.png", "id": "9644139012286835", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/473391883_9644139018953501_5648143411478632363_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Be6SHlbiqKwQ7kNvwGuhOfz&_nc_oc=AdpAB-tX0rz6Z9BDmTd2pAFhQGs0_5iY68LcTRypo9hZ_LM3bSlcnYPk6ccVcUM7V1c&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyxvPqax2zD4P03pShhAP7HZe-HNpehxfShV9JDFMK-lg&oe=69C667BD"}, "display_name": "War Broke in Heaven", "keywords": ["action", "dragon", "fitness", "fight", "wrath"], "long_description": "Based on the events of the beginning and the end, this VR experience may cause motion sickness, user discretion is advised.\n\nWar Broke in Heaven is a VR experience that puts you in the air while you fight enemies and a dragon to stop the ultimate rebellion. Use controlled moving and tactics to destroy the enemy and not get engulfed by their attacks. You will have a variety of weapons at your disposal each with a unique attribute to destroy your enemy. \n\nUse your head to look at the directions you want to fly to and slash, or fire spirit bombs at the enemy. War broke in heaven has beautiful graphics that will keep you in awe and that will leave you having fun and wanting to come back to play more. ", "short_description": "An epic battle and the fall of a rebellion, this V
hmSu-H6K7DaZba7we2utEdYKdVFOD-AJ_UNwU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEbFrma1KJsau6hmq3C2WrYaDqMSJc1SJMqPdM5qw-JAA&oe=6A7C5583"}, {"file_name": "SCREEN5.png", "id": "1351573939362261", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473393325_1351573942695594_8627772183416663494_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zXrDI3xc3ecQ7kNvwGWMsDg&_nc_oc=AdoEIZD145Rvb2d-sTr3ZnjURcM7f9BlFuDG1_Iv0pOVm4GqSEsR5jojf8AfVY1vDLg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFHhtOBRBih2PFWtHU2WXLXzEqQuF7vQs7Y1-EszDdJhw&oe=6A7C4B36"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "LANDSCAPE.png", "id": "9644139012286835", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391883_9644139018953501_5648143411478632363_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UhYlgT5pUk4Q7kNvwH7Z_fv&_nc_oc=AdrKUUVxVzHsG2Gc5q2YK42I_a51REqr35Elodx8iENwPbXSH8A3zELz17D5I2Twa4o&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGoP82OVS3k9q5dNArzodg68qh4X_T-7V7a039DwnH4Vg&oe=6A7C56BD"}, "display_name": "War Broke in Heaven", "keywords": ["action", "dragon", "fitness", "fight", "wrath"], "long_description": "Based on the events of the beginning and the end, this VR experience may cause motion sickness, user discretion is advised.\n\nWar Broke in Heaven is a VR experience that puts you in the air while you fight enemies and a dragon to stop the ultimate rebellion. Use controlled moving and tactics to destroy the enemy and not get engulfed by their attacks. You will have a variety of weapons at your disposal each with a unique attribute to destroy your enemy. \n\nUse your head to look at the directions you want to fly to and slash, or fire spirit bombs at the enemy. War broke in heaven has beautiful graphics that will keep you in awe and that will leave you having fun and wanting to come back to play more. ", "short_description": "An epic battle and the fall of a rebellion, this V
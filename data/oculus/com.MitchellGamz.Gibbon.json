Kr8Q7kNvwH_uN64&_nc_oc=Adp7uZFj46dWMy7uAWUWi_BUxUZ7858r1Oy19xOPB4HR7nk3KHjGg8rNMYX-DK0g79o&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af43MRBvGKagB__itIpZ-QJ6tIN506Cd8YnKN5_sPOMeQg&oe=6A130E0D"}, {"file_name": "Untitled4_20250907035112.png", "id": "1141157131247946", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/491821955_1141157134581279_8548405454433956294_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xNvw3IGmwfoQ7kNvwHYWZbS&_nc_oc=AdrR4o6kS5i94Llq9kmvLuOOis385UingYME69AHVYFGKMKBlWcQmEJsSJxMXQ73568&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af58Z_V1blH_RqaAz9tkVQjg62bUg6HH9dIn7LHXioJkug&oe=6A131A66"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Gibbon Redux", "keywords": ["Gibbon", "Redux", "Ape"], "long_description": "# Survival Through Silence\n\nGibbon Redux is a VR horror game inspired by Lethal Ape and The Underrooms. Trapped in a massive research facility, you must survive against a smart, sound-sensitive monster that hunts your every move.\n\nEvery step matters\u2014the creature can hear your footsteps, forcing you to balance speed with silence as you explore dark corridors and hidden passages.\n\nFeatures include:\n\n- A large, atmospheric facility map\n\n- Monster AI that reacts to sound and player behavior\n\n- Free cosmetics\n\n- Buyable mod menus\n\n- High-quality VR graphics\n\n\nCan you outsmart the AI and make it out alive?", "short_description": "Gibbon Redux is inspired by games like Lethal Ape, The Underrooms, Lethal Ape Redux, And more. The game contains a facility in which the player must avoid a smart deadly monster."}]}, "developer_name": "MitchellGamz", "developer_privacy_policy_url": "https://sites.google.com/view/gibbon-redux/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "MitchellGamz", "support_website_url": null, "website_url": "https://sites.google.com/view/gibbon-redux/home", "category": null, "comfort_rating": "COMFO
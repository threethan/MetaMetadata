IRu2RKdVg&oe=6AA94A40"}, {"file_name": "Untitled4_20250907035129.png", "id": "1140515894634349", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/491822034_1140515897967682_1398700426869903642_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=79mCoyrNpYEQ7kNvwGFoKpH&_nc_oc=AdrMJO5cIZ9tZNY2GEssg7ZsGnDkAi3l0cz8HZchZiS-JCzx00fpGL-_rx5T6-DNoCM&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKS_D7ttARpNAAmd6luk83pI6Sga4rjzQXavf_pLOm5OA&oe=6AA9590D"}, {"file_name": "Untitled4_20250907035112.png", "id": "1141157131247946", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/491821955_1141157134581279_8548405454433956294_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QMQFxQLnjcQQ7kNvwFJsgwg&_nc_oc=AdoWMkEjFL-KFz7q-oGUbW9qnoxBuHlm0rmo2vMzJGCmYQp-Nf4OTladdcHbPFkYWlE&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKELE3No80x705SY2LkxJb3RqtEsruZ_DKzys_J7ZI4tw&oe=6AA96566"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Gibbon Redux", "keywords": ["Gibbon", "Redux", "Ape"], "long_description": "# Survival Through Silence\n\nGibbon Redux is a VR horror game inspired by Lethal Ape and The Underrooms. Trapped in a massive research facility, you must survive against a smart, sound-sensitive monster that hunts your every move.\n\nEvery step matters\u2014the creature can hear your footsteps, forcing you to balance speed with silence as you explore dark corridors and hidden passages.\n\nFeatures include:\n\n- A large, atmospheric facility map\n\n- Monster AI that reacts to sound and player behavior\n\n- Free cosmetics\n\n- Buyable mod menus\n\n- High-quality VR graphics\n\n\nCan you outsmart the AI and make it out alive?", "short_description": "Gibbon Redux is inspired by games like Lethal Ape, The Underrooms, Lethal Ape Redux, And more. The game contains a facility in which the player must avoid a smart deadly monster."}]}, "developer_name": "MitchellGamz", "developer_privacy_policy_url": "https://si
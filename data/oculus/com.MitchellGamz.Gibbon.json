n.com/v/t64.5771-25/491830776_803884602113536_6860703862068404833_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AR07H9AMgUkQ7kNvwGl7bL2&_nc_oc=AdneVn-71a5EsKuRQfvXsbSrcWdQ-A0azrPCN6eORB2WuwfS9xIPEBkUK3BCnRKbMmA&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&oh=00_AfuidROjxnSI28rRhVX1c-gdH__R4ZHM9Qw20l1sQXuUbg&oe=69A188F5"}, {"file_name": "Untitled4_20250907035027.png", "id": "1341765044151763", "uri": "https://scontent-hkg1-1.oculuscdn.com/v/t64.5771-25/491827703_1341765047485096_2773044915957863502_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iurZOUVTX6MQ7kNvwHJcNGv&_nc_oc=Adl-ZpWdJI-bAQAQCrMYWZPH-ZoXYafxncnbl2lEmcVZUZnoL1x8UZ-r6GaqOKd3-W0&_nc_zt=3&_nc_ht=scontent-hkg1-1.oculuscdn.com&oh=00_AfukdNJkG2R18syocMbdNAwUMSuDTny2NdBJ1I8vfNq0uw&oe=69A19F01"}, {"file_name": "Untitled4_20250907035146.png", "id": "754454277390823", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/499304106_754454280724156_7139758223178996642_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hWsSpKlJPKcQ7kNvwFvPn1n&_nc_oc=Adnptl0Ko6lsxpAj8LvNFdy68Bb1W3y0b7GbDX7kgh6mOQfT6ijmufrnLYeHCH_XxZQ&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&oh=00_Afs06Hv3yMl_PXX8F9_HQawFI1Y0PIRttnPqgG6MyPeY8w&oe=69A19E40"}, {"file_name": "Untitled4_20250907035129.png", "id": "1140515894634349", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/491822034_1140515897967682_1398700426869903642_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aFE9Zq2R1N4Q7kNvwEhU1zV&_nc_oc=Adnfg3YaYwsq7svbkgUTqlP6rB2HJlFeDi-CwHna6bpOh__h1ukYVU87yQclP-sBKx8&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&oh=00_Afv2uvuwXLJRtqYivEeWgc3P28mxZnkrOw4Ern0-GbftpA&oe=69A174CD"}, {"file_name": "Untitled4_20250907035112.png", "id": "1141157131247946", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/491821955_1141157134581279_8548405454433956294_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XZ_B77ARSNcQ7kNvwHvyfAh&_nc_oc=Adno5Y5Nqc7UfHTb8P5pIJZyys9nLFOaNK0HNVm8gXUtk04ePpOf18d7z5P6e1MrYSo&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&oh=00_Afss7WUfPgacvSPB9fGbnX4QQHYAyKXEwVajgZPnWdYSKw&oe=69A18126"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Gibbon Redux", "keywords": ["Gibbon", "Redux", "Ape"], "long_description": "# Survival Through Silence\n\nGibbon Redux is a VR horror game inspired by Lethal Ape and The Underrooms. Trapped in a massive research facility, you must survive against a smart, sound-sensitive monster that hunts your every move.\n\nEvery step matters\u2014the creature can hear your footsteps, forcing you to balance speed with silence as you explore dark corridors and hidden passages.\n\nFeatures include:\n\n- A large, atmospheric facility map\n\n- Monster AI that reacts to sound and player behavior\n\n- Free cosmetics\n\n- Buyable mod menus\n\n- High-quality VR graphics\n\n\nCan you outsmart the AI and make it out alive?", "short_description": "Gibbon Redux is inspired by games like Lethal Ape, The Underrooms, Lethal Ape Redux, And more. The game contains a facility in which the player must avoid a smart deadly monster."}]}, "developer_name": "MitchellGamz", "developer_privacy_policy_url": "https://sites.google.com/view/gibbon-redux/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "MitchellGamz", "support_website_url": null, "website_url": "https://sites.google.com/view/gibbon-redux/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interactio
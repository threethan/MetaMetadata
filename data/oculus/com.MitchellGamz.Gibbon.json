cdn.com/v/t64.5771-25/491822034_1140515897967682_1398700426869903642_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eXMPx6cAmZoQ7kNvwHtLCJZ&_nc_oc=AdqTuKUbh8iUbEyMqwbZgIxIXEo49abCws2SRK-3mBUa9xbuCYX03zj01KAES5vFQ5c&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEHBOAKSd58-_a-lLBUDfU5a-nUMfBHhm0ca6G2bqOn0w&oe=6A734B8D"}, {"file_name": "Untitled4_20250907035112.png", "id": "1141157131247946", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491821955_1141157134581279_8548405454433956294_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z-7-s-3UxdEQ7kNvwGV-8ev&_nc_oc=AdorUw6W6eKeP4eZsfqMPwuZWpD058Ic4E8IaKAouGm-zPY_xK8NdxZyamhVRQKEVR0&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF1lJ2rO1BXYU-wTmLXMQlEF2xdcE2q3oNmfmXeYWsIxA&oe=6A731FA6"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Gibbon Redux", "keywords": ["Gibbon", "Redux", "Ape"], "long_description": "# Survival Through Silence\n\nGibbon Redux is a VR horror game inspired by Lethal Ape and The Underrooms. Trapped in a massive research facility, you must survive against a smart, sound-sensitive monster that hunts your every move.\n\nEvery step matters\u2014the creature can hear your footsteps, forcing you to balance speed with silence as you explore dark corridors and hidden passages.\n\nFeatures include:\n\n- A large, atmospheric facility map\n\n- Monster AI that reacts to sound and player behavior\n\n- Free cosmetics\n\n- Buyable mod menus\n\n- High-quality VR graphics\n\n\nCan you outsmart the AI and make it out alive?", "short_description": "Gibbon Redux is inspired by games like Lethal Ape, The Underrooms, Lethal Ape Redux, And more. The game contains a facility in which the player must avoid a smart deadly monster."}]}, "developer_name": "MitchellGamz", "developer_privacy_policy_url": "https://sites.google.com/view/gibbon-redux/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "MitchellGamz", "support_we
nTBnN-Vsw&oe=6AAE9040"}, {"file_name": "Untitled4_20250907035129.png", "id": "1140515894634349", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/491822034_1140515897967682_1398700426869903642_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uMGZbXD56xgQ7kNvwETFhnA&_nc_oc=AdoTlcjKjatEH5pMoLzNJ3yLTs19K-051eViH-p8iBGZcgs_iY0vVHvF2G6M1XDCV1A&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLUWU0sN8swPnvZ0LUlOjx1zqXqClPC26S2ffh9NPavww&oe=6AAE9F0D"}, {"file_name": "Untitled4_20250907035112.png", "id": "1141157131247946", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/491821955_1141157134581279_8548405454433956294_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L6bN8vyAx8oQ7kNvwGo8460&_nc_oc=AdpiLjHr79uXKnGKwwxvd7AQQO96md0_z6Pzf9gEO8TZ4jAAwVAlCGuS1gCniffw1hg&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLYG2l2GJScXVK_SJWnluzBgIDj6g5I1rhiEHjiUMJ3dA&oe=6AAEAB66"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Gibbon Redux", "keywords": ["Gibbon", "Redux", "Ape"], "long_description": "# Survival Through Silence\n\nGibbon Redux is a VR horror game inspired by Lethal Ape and The Underrooms. Trapped in a massive research facility, you must survive against a smart, sound-sensitive monster that hunts your every move.\n\nEvery step matters\u2014the creature can hear your footsteps, forcing you to balance speed with silence as you explore dark corridors and hidden passages.\n\nFeatures include:\n\n- A large, atmospheric facility map\n\n- Monster AI that reacts to sound and player behavior\n\n- Free cosmetics\n\n- Buyable mod menus\n\n- High-quality VR graphics\n\n\nCan you outsmart the AI and make it out alive?", "short_description": "Gibbon Redux is inspired by games like Lethal Ape, The Underrooms, Lethal Ape Redux, And more. The game contains a facility in which the player must avoid a smart deadly monster."}]}, "developer_name": "MitchellGamz", "developer_privacy_policy_url": "https://si
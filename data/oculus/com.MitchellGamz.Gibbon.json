cdn.com/v/t64.5771-25/491822034_1140515897967682_1398700426869903642_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=khckTD8DYDMQ7kNvwGS7uMq&_nc_oc=AdosPUSGq4cOnMtZXZPhQx7P0jYs73OyIqjFgaoenJArZkXhVz0XOe7bUiLUCIm9pVA&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQASL6-hEl0P81cKuWEzok_HSGUV_R0WAFvy6uM4YSf_GA&oe=6A5B908D"}, {"file_name": "Untitled4_20250907035112.png", "id": "1141157131247946", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491821955_1141157134581279_8548405454433956294_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ELJqoRNCtS8Q7kNvwFey2sJ&_nc_oc=Adp9zWqtXxWR-9iwX5YTy6goVjn4xsS37mcXjOSfrETqywiI9hHBg5iqJpUKrHhK5Nw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDzaUPw1Z7K-jVHOlPAsX70Ey3vkLdiopQMsUOyB26keg&oe=6A5B64A6"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Gibbon Redux", "keywords": ["Gibbon", "Redux", "Ape"], "long_description": "# Survival Through Silence\n\nGibbon Redux is a VR horror game inspired by Lethal Ape and The Underrooms. Trapped in a massive research facility, you must survive against a smart, sound-sensitive monster that hunts your every move.\n\nEvery step matters\u2014the creature can hear your footsteps, forcing you to balance speed with silence as you explore dark corridors and hidden passages.\n\nFeatures include:\n\n- A large, atmospheric facility map\n\n- Monster AI that reacts to sound and player behavior\n\n- Free cosmetics\n\n- Buyable mod menus\n\n- High-quality VR graphics\n\n\nCan you outsmart the AI and make it out alive?", "short_description": "Gibbon Redux is inspired by games like Lethal Ape, The Underrooms, Lethal Ape Redux, And more. The game contains a facility in which the player must avoid a smart deadly monster."}]}, "developer_name": "MitchellGamz", "developer_privacy_policy_url": "https://sites.google.com/view/gibbon-redux/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "MitchellGamz", "support_we
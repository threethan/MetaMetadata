cdn.com/v/t64.5771-25/491822034_1140515897967682_1398700426869903642_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HMewaYEzUBYQ7kNvwH92kOk&_nc_oc=Adp8M3m6MARWeDPz4SV0MeDQqf-OV1t_sa8v5MGkOCbQ_KkTxttQalYf87pmUhKbLVM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af99JA0EvT88JZMiH_id6kdtt1rn1zFHQgT6RVlJT6UzNg&oe=6A3FE10D"}, {"file_name": "Untitled4_20250907035112.png", "id": "1141157131247946", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491821955_1141157134581279_8548405454433956294_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nCAX0i4NgFQQ7kNvwEEHilJ&_nc_oc=Adoumt8O83utJZo6Bc9F7R35Dx3NBP3gXgwivzZojrDFl1q3zxa2iV5W5-2-_HPcg7k&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9esajmg-x21RrLYY_UuzIVR7NWj_mgnGw2fcE2L_yF_g&oe=6A3FED66"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Gibbon Redux", "keywords": ["Gibbon", "Redux", "Ape"], "long_description": "# Survival Through Silence\n\nGibbon Redux is a VR horror game inspired by Lethal Ape and The Underrooms. Trapped in a massive research facility, you must survive against a smart, sound-sensitive monster that hunts your every move.\n\nEvery step matters\u2014the creature can hear your footsteps, forcing you to balance speed with silence as you explore dark corridors and hidden passages.\n\nFeatures include:\n\n- A large, atmospheric facility map\n\n- Monster AI that reacts to sound and player behavior\n\n- Free cosmetics\n\n- Buyable mod menus\n\n- High-quality VR graphics\n\n\nCan you outsmart the AI and make it out alive?", "short_description": "Gibbon Redux is inspired by games like Lethal Ape, The Underrooms, Lethal Ape Redux, And more. The game contains a facility in which the player must avoid a smart deadly monster."}]}, "developer_name": "MitchellGamz", "developer_privacy_policy_url": "https://sites.google.com/view/gibbon-redux/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "MitchellGamz", "support_we
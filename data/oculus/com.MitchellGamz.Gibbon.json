cdn.com/v/t64.5771-25/491822034_1140515897967682_1398700426869903642_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a7tC-3YgjO0Q7kNvwEMhXp6&_nc_oc=AdrA4K_zR9gpiW7283XBmrW8r4nIL3N0MpKXCiaRkO1YvCXOl098X-dwF_T-2otNrVA&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9XluJH6OAhf2_XsvsPjaCv0rdnxdTXK67SzD0dRMXrGg&oe=6A3D3E0D"}, {"file_name": "Untitled4_20250907035112.png", "id": "1141157131247946", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/491821955_1141157134581279_8548405454433956294_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Yh-h8CkcjAsQ7kNvwFJH6pq&_nc_oc=AdopCDHgHhu21PEzxu9R2SW3tHCeiaGiwRCHKcqxWz7SinuZoGAVomtf9jzeMxPZSF8&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-1i1QIhCxgIKI8tHkIXiLvJv7gQDY07pzAh2liLourBg&oe=6A3D4A66"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Gibbon Redux", "keywords": ["Gibbon", "Redux", "Ape"], "long_description": "# Survival Through Silence\n\nGibbon Redux is a VR horror game inspired by Lethal Ape and The Underrooms. Trapped in a massive research facility, you must survive against a smart, sound-sensitive monster that hunts your every move.\n\nEvery step matters\u2014the creature can hear your footsteps, forcing you to balance speed with silence as you explore dark corridors and hidden passages.\n\nFeatures include:\n\n- A large, atmospheric facility map\n\n- Monster AI that reacts to sound and player behavior\n\n- Free cosmetics\n\n- Buyable mod menus\n\n- High-quality VR graphics\n\n\nCan you outsmart the AI and make it out alive?", "short_description": "Gibbon Redux is inspired by games like Lethal Ape, The Underrooms, Lethal Ape Redux, And more. The game contains a facility in which the player must avoid a smart deadly monster."}]}, "developer_name": "MitchellGamz", "developer_privacy_policy_url": "https://sites.google.com/view/gibbon-redux/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "MitchellGamz", "support_we
F9BB"}, {"file_name": "2.png", "id": "322497102844580", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031505_322497106177913_1885731480804630613_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OQ3gpBeQ1NgQ7kNvwGZOgkW&_nc_oc=Adp4034ks-pDPfgWQ9TVd_4eKwqLcPsHW1ZE4vqn9m8epfRSrRGob_vb0bc6kMGs2Xk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT_cwN_weqUQ8gtKg3mGtFo16Ta7YUyGhNePAaqh_Q7IA&oe=6AEDDB45"}, {"file_name": "3.png", "id": "623902955323651", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982666_623902958656984_627104830482221034_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6nHFU8ut-_wQ7kNvwHXCIFc&_nc_oc=AdoyTAHuIiFvHVtJRjXu3kmV-LOjzr4jOjTM0sSqkn-8plAypXiV4_WDH8XrGmbj0NM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQx6yUlXjP20ny9Vm9zYDH63fkToSgg6n0-57Y0Kwsj3w&oe=6AEDFB36"}, {"file_name": "4.png", "id": "435400698123614", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974444_435400701456947_1868629701117421690_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R1M8ATfxxxMQ7kNvwH_JscL&_nc_oc=AdrdyaXvug06KPrkOpeeq022ldF-ELJeSiexaG25oT9tV1GeJ7QuTHlFNXvCgAuGJDA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS9zRIC-eqarN8w3SVztcD92-jkiA0l4ouOHnXIpSgSSA&oe=6AEDE776"}, {"file_name": "5.png", "id": "300658551972783", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39003239_300658555306116_2868297386557494839_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cqO20WWwEU4Q7kNvwE638kG&_nc_oc=AdrXc76F0k2eB8u-0_HfDfod2XN7s3fbui0k00K39g4gojHfN6HanzL71ox_AyEy_28&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTlGf19nDADE9EG0S1A4ZzcknfXbwhYcmRdEuOd_CbB_w&oe=6AEDEE19"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover.png", "id": "1342356962880780", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031553_1342356966214113_3465353394871499435_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6Xw2NBTkElUQ7kNvwHV7F0L&_nc_oc=Adre-aw-KlVpDgrRxEa8pVgVSR6eHDfVhbAXcKAf7KbvZw46rhZZMF2VXmUnnHBTQ1E&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTpt8Pi9gVy--P7OmKUo7jmE5zZa0PYRITrRzolKB5iuA&oe=6AEE0CA2"}, "display_name": "Facing", "keywords": [], "long_description": "A physics-based online sword fighting VR game.\n\nHit your opponent's headset with your sword. Protect your headset from your opponent's weapons by parrying or dodging.\n\ngame rules\n\u30fbCan only use weapons \u30fbCan only attack the opponent's headset\n\u00b7For the sake of fairness, the range of player activities is limited to one step\n\u00b7After the preparation is completed, enter the duel stage for a duel\n\u00b7The faster you swing your weapon, the more damage you can do. The farther the opponent's weapon is sent flying.\n\u30fbAfter the weapon collides, there will be an offset that prevents you from swinging the sword accurately and continuously. Of course, you can take advantage of this offset with repeated practice.\n\u00b7 The game is 2 rounds with 7 points. The first person to score 7 points wins 1 round. Win 2 rounds to win the game.\n\nhint\nAs mentioned above, the single-player game provided by the game is limited. If you are a solo player, you may not have a good experience.\nYou can add friends in our Discord to make an appointment to play together at a fixed time.\nOur Discord:https://discord.gg/hY7uA8ppv7\nThe game needs a certain amount of real space to play, be careful not to hit the wall, the game defaults to 90Hz refresh rate, 72Hz Quest users will be at a disadvantage in confrontation, please buy carefully.\nThe game can be matched with Steam and Pico(CN) cross-platform.", "short_description": "A physics-based online sword fighting VR game.\n\nHit your opponent's headset with a tight grip on your sword. Protect your headset from your opponent's weapons by parrying or dodging."}]}, "developer_name": null, "developer_privacy_policy_url": "https://zzwei.games/privacypolicy/", "dev
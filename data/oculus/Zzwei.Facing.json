85BB"}, {"file_name": "2.png", "id": "322497102844580", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031505_322497106177913_1885731480804630613_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XqbEKCvS3BwQ7kNvwHnBDzs&_nc_oc=Adrpwv8kMCKNStbNkUO4PYXtfUtj_M5xWtFTDJhYjj_v9iJV3rIgBD3SdhBAZ0pDE9E&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQToACMavqrnDejlc7Bjrppp1J5pp-hvGCFk7CnGDSorCA&oe=6AF89F85"}, {"file_name": "3.png", "id": "623902955323651", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982666_623902958656984_627104830482221034_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G9eXD_UzbXgQ7kNvwGGH-TO&_nc_oc=AdqbrZMILMjE5kwtj82D8PxWfgWLk2XL73s-HjtB89pgGvWCQ5LldwqioFMFjFYc6M8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTXG3mpBFqI8QPY8cPxllQhESzFf8_9LmA2tDtc4u1RFg&oe=6AF88736"}, {"file_name": "4.png", "id": "435400698123614", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974444_435400701456947_1868629701117421690_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IezeLW0G4ysQ7kNvwGT07Wx&_nc_oc=AdrqttFibtSQ1r1uSQ2xxTghfcBsvLoRF0p1FVe-6A_JZRuVnra45-5t14dxhnnZPUU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQCNcldLOE98mMMeQ1HCSLvvTScFg6iv74V5ZfFiIJOqQ&oe=6AF8ABB6"}, {"file_name": "5.png", "id": "300658551972783", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39003239_300658555306116_2868297386557494839_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tb2LpsL3hH4Q7kNvwF6_pLF&_nc_oc=Ado2qLnxHCEt3j5SNk5yMxxD_CEvribDmz1ekotviso1ywq9cY5mkpT_XMEadGa-7ZM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSPUBsSu9yeWE2rRsz3r2kt7LOVL12BQCEJQjEMd1KAsg&oe=6AF87A19"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover.png", "id": "1342356962880780", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031553_1342356966214113_3465353394871499435_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rIMi8f4z4UQQ7kNvwGQLs9u&_nc_oc=AdrllGunlNeEVGCOXPecA58RwnuIjFqWPpQ8QlxMEX1aLmtBrbpbddeHf2DDWIvPnoE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ-dx13SfiJAnbVGIxbZ86RhWee_Ya-Cti4qjUWdRpDVA&oe=6AF898A2"}, "display_name": "Facing", "keywords": [], "long_description": "A physics-based online sword fighting VR game.\n\nHit your opponent's headset with your sword. Protect your headset from your opponent's weapons by parrying or dodging.\n\ngame rules\n\u30fbCan only use weapons \u30fbCan only attack the opponent's headset\n\u00b7For the sake of fairness, the range of player activities is limited to one step\n\u00b7After the preparation is completed, enter the duel stage for a duel\n\u00b7The faster you swing your weapon, the more damage you can do. The farther the opponent's weapon is sent flying.\n\u30fbAfter the weapon collides, there will be an offset that prevents you from swinging the sword accurately and continuously. Of course, you can take advantage of this offset with repeated practice.\n\u00b7 The game is 2 rounds with 7 points. The first person to score 7 points wins 1 round. Win 2 rounds to win the game.\n\nhint\nAs mentioned above, the single-player game provided by the game is limited. If you are a solo player, you may not have a good experience.\nYou can add friends in our Discord to make an appointment to play together at a fixed time.\nOur Discord:https://discord.gg/hY7uA8ppv7\nThe game needs a certain amount of real space to play, be careful not to hit the wall, the game defaults to 90Hz refresh rate, 72Hz Quest users will be at a disadvantage in confrontation, please buy carefully.\nThe game can be matched with Steam and Pico(CN) cross-platform.", "short_description": "A physics-based online sword fighting VR game.\n\nHit your opponent's headset with a tight grip on your sword. Protect your headset from your opponent's weapons by parrying or dodging."}]}, "developer_name": null, "developer_privacy_policy_url": "https://zzwei.games/privacypolicy/", "dev
D37B"}, {"file_name": "2.png", "id": "322497102844580", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/39031505_322497106177913_1885731480804630613_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RZZyFcEbqDQQ7kNvwG1-7QW&_nc_oc=AdqKDyqH4Bw-cMEEdrRnkXR9IIpPFUhkPcJfRoYz6so5VUS_KTdpLqruunouB8LmTtM&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCFlO1Xm8luJ73hViJ2bbTQg2g0upYRYUKvTfwcJ6dpKA&oe=6A54ED45"}, {"file_name": "3.png", "id": "623902955323651", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982666_623902958656984_627104830482221034_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tQBAPvuAGKcQ7kNvwEFaTi3&_nc_oc=Adp2V-FG9CkzY9P4F6KvtUlLMLAcBlBd74n57EgYaDN6pI4ntzAhn2c-nZ0X8cyi9sA&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD0GsEII6-n323bGaRZinxkSJToO6V914B-GXbtPFAylA&oe=6A54D4F6"}, {"file_name": "4.png", "id": "435400698123614", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38974444_435400701456947_1868629701117421690_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=baawZit5XzMQ7kNvwFoaZed&_nc_oc=AdoyLexvbiWj3CkEyDTScywFWota8K7Uk50ohJ5Gn3Q4-Ro4FV4Lv62GvH9Od84KqIw&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC19qv-J4um8DAMSWqOS7WIf88E9utcVjSh2QW6jyJ9qw&oe=6A54F976"}, {"file_name": "5.png", "id": "300658551972783", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/39003239_300658555306116_2868297386557494839_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8r680QCUThwQ7kNvwFZeEwm&_nc_oc=AdrMChyZTBhVVBJSivjCWZxI897YKPN8opgdGgCLLWshyU_5DNQ5WOreQgUfum70KCc&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBPwkjCXQ8-3mjp4PKh4_lxBrHyBxzGY0OkZdEW9qvQRQ&oe=6A550019"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover.png", "id": "1342356962880780", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39031553_1342356966214113_3465353394871499435_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9z612jdwFl4Q7kNvwFc0WKP&_nc_oc=AdqqeKOVqiNIE5rjwwqnIYeq9FK9kZ-DT3W7CJ-RdVGv9P63zGCrLDz41zy4Ds1oMfM&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDGyq0Q04Kuc-8Uov5V_YslP8INsR4Tcnz6sHK7RUQJ6A&oe=6A54E662"}, "display_name": "Facing", "keywords": [], "long_description": "A physics-based online sword fighting VR game.\n\nHit your opponent's headset with your sword. Protect your headset from your opponent's weapons by parrying or dodging.\n\ngame rules\n\u30fbCan only use weapons \u30fbCan only attack the opponent's headset\n\u00b7For the sake of fairness, the range of player activities is limited to one step\n\u00b7After the preparation is completed, enter the duel stage for a duel\n\u00b7The faster you swing your weapon, the more damage you can do. The farther the opponent's weapon is sent flying.\n\u30fbAfter the weapon collides, there will be an offset that prevents you from swinging the sword accurately and continuously. Of course, you can take advantage of this offset with repeated practice.\n\u00b7 The game is 2 rounds with 7 points. The first person to score 7 points wins 1 round. Win 2 rounds to win the game.\n\nhint\nAs mentioned above, the single-player game provided by the game is limited. If you are a solo player, you may not have a good experience.\nYou can add friends in our Discord to make an appointment to play together at a fixed time.\nOur Discord:https://discord.gg/hY7uA8ppv7\nThe game needs a certain amount of real space to play, be careful not to hit the wall, the game defaults to 90Hz refresh rate, 72Hz Quest users will be at a disadvantage in confrontation, please buy carefully.\nThe game can be matched with Steam and Pico(CN) cross-platform.", "short_description": "A physics-based online sword fighting VR game.\n\nHit your opponent's headset with a tight grip on your sword. Protect your headset from your opponent's weapons by parrying or dodging."}]}, "developer_name": null, "developer_privacy_policy_url": "https://zzwei.games/privacypolicy/", "dev
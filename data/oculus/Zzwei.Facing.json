8A3B"}, {"file_name": "2.png", "id": "322497102844580", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031505_322497106177913_1885731480804630613_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PuzCE1g2cqYQ7kNvwF-rwYK&_nc_oc=AdounQyV6_JXnDTGi_hcLjz9OgkkC89qXYUK044EDT_rQhct8IV526q8cvTA57p26p4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9m6m20VbcyAzzWPU-kfP6cQFAOxSFIPDtQtxMk_8KSHg&oe=6A296BC5"}, {"file_name": "3.png", "id": "623902955323651", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982666_623902958656984_627104830482221034_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uToY7hdycCAQ7kNvwErrrOI&_nc_oc=Ado_qFrn22vwymsJiLGMPA0qylXJQ-3UhaTihLvVwu3AwXBhdrLJ-0P0SIKihbwYtB4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-boPTfJtLVYktMeXOPdBaugA49PBcQOD60eg3CWhhvog&oe=6A295376"}, {"file_name": "4.png", "id": "435400698123614", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974444_435400701456947_1868629701117421690_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Zd9c4aKCNOQQ7kNvwEaAADP&_nc_oc=Adrpxk56HS41OAy9FBRg8HX_ImMfXp9ZaHhno8eazw-jaeBoYNEh4SdngXx7JPTtdKs&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af977wpj24akHVp6pvMXnDGxYXhtUsXEyN6_Bqkbqvit6A&oe=6A2977F6"}, {"file_name": "5.png", "id": "300658551972783", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39003239_300658555306116_2868297386557494839_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6rMYvvvFUjgQ7kNvwEt24Nc&_nc_oc=AdqvRMtgQhGuKDKVKFCNEyPSpEyC8LTe7C1lRM1xiON-pD4vVfqx9J39XbNmElk0-Vk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9UjtsDqhECCACee5lbJNjD_HE9oAEwc-P9Z8sDFzaEZg&oe=6A297E99"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover.png", "id": "1342356962880780", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031553_1342356966214113_3465353394871499435_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lL2R2qzfUEIQ7kNvwHR3BVF&_nc_oc=Adr51tpri9ALm8cr6ooZDc0HZYSm_zUweDdBzp6KmOOSZYz1vL7uzGAeO-ONYS_38ek&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9aesp4cuG_MQbtT72Q9WkqpX8xvUANHDb1mSr_rbN_oQ&oe=6A2964E2"}, "display_name": "Facing", "keywords": [], "long_description": "A physics-based online sword fighting VR game.\n\nHit your opponent's headset with your sword. Protect your headset from your opponent's weapons by parrying or dodging.\n\ngame rules\n\u30fbCan only use weapons \u30fbCan only attack the opponent's headset\n\u00b7For the sake of fairness, the range of player activities is limited to one step\n\u00b7After the preparation is completed, enter the duel stage for a duel\n\u00b7The faster you swing your weapon, the more damage you can do. The farther the opponent's weapon is sent flying.\n\u30fbAfter the weapon collides, there will be an offset that prevents you from swinging the sword accurately and continuously. Of course, you can take advantage of this offset with repeated practice.\n\u00b7 The game is 2 rounds with 7 points. The first person to score 7 points wins 1 round. Win 2 rounds to win the game.\n\nhint\nAs mentioned above, the single-player game provided by the game is limited. If you are a solo player, you may not have a good experience.\nYou can add friends in our Discord to make an appointment to play together at a fixed time.\nOur Discord:https://discord.gg/hY7uA8ppv7\nThe game needs a certain amount of real space to play, be careful not to hit the wall, the game defaults to 90Hz refresh rate, 72Hz Quest users will be at a disadvantage in confrontation, please buy carefully.\nThe game can be matched with Steam and Pico(CN) cross-platform.", "short_description": "A physics-based online sword fighting VR game.\n\nHit your opponent's headset with a tight grip on your sword. Protect your headset from your opponent's weapons by parrying or dodging."}]}, "developer_name": null, "developer_privacy_policy_url": "https://zzwei.games/privacypolicy/", "dev
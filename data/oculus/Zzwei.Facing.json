2D3B"}, {"file_name": "2.png", "id": "322497102844580", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/39031505_322497106177913_1885731480804630613_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PuzCE1g2cqYQ7kNvwHYXhv3&_nc_oc=Adr1bjzN-We4JUAvO3VwtOa6fx37hffOO1Thff8vFKmaOeAHFR670ifgYOG_a8HS9WE&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8ELNIL5cJa2Tg2W4ivOZK2uAyJmBFn39oVvjJLN3dn6w&oe=6A2C0EC5"}, {"file_name": "3.png", "id": "623902955323651", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/38982666_623902958656984_627104830482221034_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sKdBa4zyUj4Q7kNvwG_dZWl&_nc_oc=AdpREBNernUrHS6SEdTa0KvsUZpMD_xjqquwQJeWvh7XbseKETj7wuFOGiLKw2T2Iio&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8VS3ApagKeshpHXql-JxRNsHihiRZguvrEc-Dc_N4C6g&oe=6A2C2EB6"}, {"file_name": "4.png", "id": "435400698123614", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/38974444_435400701456947_1868629701117421690_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Zd9c4aKCNOQQ7kNvwGfV1Zs&_nc_oc=AdqgJJGi5L5AVCZkA7qZ1orbYJoZAWenL_PUQZJpJf6jhYMjH1_PPtZP827LhY-XQp4&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9__CoZYqahLrt9ICb27byu8rfK5dHbWO2ZGXy6qWZc7g&oe=6A2C1AF6"}, {"file_name": "5.png", "id": "300658551972783", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/39003239_300658555306116_2868297386557494839_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pfeBOvFwv6UQ7kNvwEZhVqA&_nc_oc=Adq9jo619Y9RtOrfEpXw8OgmypLjwvQhZ6JflDunhc0w7K5o5acUHgV91ytld2adH34&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_9-ClvsJs_X2EaYS8HPprhCvvh6rxIq56VW_fL9yrdCQ&oe=6A2C2199"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover.png", "id": "1342356962880780", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/39031553_1342356966214113_3465353394871499435_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zZFdR_ED_2YQ7kNvwEMTrZf&_nc_oc=Adp4_h0zZekVU9iFG2G8bdtXHVBAArCMzrRK6AgB2bhuF3lk6LPEKJQ4RvWpe6B2AEc&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_aF8boFAfqcUT25djzjMvwjALMRhAobKSWjejX_L5UlA&oe=6A2C07E2"}, "display_name": "Facing", "keywords": [], "long_description": "A physics-based online sword fighting VR game.\n\nHit your opponent's headset with your sword. Protect your headset from your opponent's weapons by parrying or dodging.\n\ngame rules\n\u30fbCan only use weapons \u30fbCan only attack the opponent's headset\n\u00b7For the sake of fairness, the range of player activities is limited to one step\n\u00b7After the preparation is completed, enter the duel stage for a duel\n\u00b7The faster you swing your weapon, the more damage you can do. The farther the opponent's weapon is sent flying.\n\u30fbAfter the weapon collides, there will be an offset that prevents you from swinging the sword accurately and continuously. Of course, you can take advantage of this offset with repeated practice.\n\u00b7 The game is 2 rounds with 7 points. The first person to score 7 points wins 1 round. Win 2 rounds to win the game.\n\nhint\nAs mentioned above, the single-player game provided by the game is limited. If you are a solo player, you may not have a good experience.\nYou can add friends in our Discord to make an appointment to play together at a fixed time.\nOur Discord:https://discord.gg/hY7uA8ppv7\nThe game needs a certain amount of real space to play, be careful not to hit the wall, the game defaults to 90Hz refresh rate, 72Hz Quest users will be at a disadvantage in confrontation, please buy carefully.\nThe game can be matched with Steam and Pico(CN) cross-platform.", "short_description": "A physics-based online sword fighting VR game.\n\nHit your opponent's headset with a tight grip on your sword. Protect your headset from your opponent's weapons by parrying or dodging."}]}, "developer_name": null, "developer_privacy_policy_url": "https://zzwei.games/privacypolicy/", "dev
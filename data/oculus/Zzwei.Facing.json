2EFB"}, {"file_name": "2.png", "id": "322497102844580", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/39031505_322497106177913_1885731480804630613_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eqf8BvcM1SkQ7kNvwETfxCj&_nc_oc=AdqUj6QYVSvBrR9NDMimYKIiYd511NdnzR2fUE0aCzF1jfbkd--deopkJp-FD1aGrHg&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEtU0swe5aq661g1LZCe25iD1S_f7stRhgF620vN1n0ng&oe=6A9748C5"}, {"file_name": "3.png", "id": "623902955323651", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/38982666_623902958656984_627104830482221034_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UhZPnVw7DhQQ7kNvwFkiDtl&_nc_oc=AdoqXFRwhLb6bw4D-nyqRia4tFEhZzOXSCbXAxW0za0X5pU7eA4nlCcQCeZwslME6fI&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEjTElWv6Ez1n-p1cIRFKjxYUZR0Av2TnuWywo51MaJiQ&oe=6A973076"}, {"file_name": "4.png", "id": "435400698123614", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/38974444_435400701456947_1868629701117421690_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-FW_9-ZNdSoQ7kNvwHxk5nj&_nc_oc=AdrEdViuNUFcbbEJe9gEaaRxVC67pam9vYWyxOxpnx6EFpbR6nnGLSlpL4swoetNXF0&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEer0n7SWdRekTSUkgnWrVRP1SzlEMvWDUX3p1umZEQ2A&oe=6A971CB6"}, {"file_name": "5.png", "id": "300658551972783", "uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/39003239_300658555306116_2868297386557494839_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tWvPJVCy0eAQ7kNvwH_nmRL&_nc_oc=AdrFGG_UvQSLZYY9eLUmYSAl9YlM35TaFBqfXI62_PnJyTZUfl_toZMry5E7FbHl0hU&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEH97c6d36atNsxBJxOUYYfSacwz5Glrgf3pqkczYhgKw&oe=6A972359"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover.png", "id": "1342356962880780", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/39031553_1342356966214113_3465353394871499435_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WdHa9-c4DhUQ7kNvwEMmpym&_nc_oc=Adpu9GUVPdR2BcNsVgwoxIgsbGbMS6Ge3E4-lW_8GkDaBJVDdfp91jlRMTplG0ABQ4A&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGSqjjrwArEQJV0g1H2IT6KnMjIn0adeQrmAk67Qu2x6g&oe=6A9741E2"}, "display_name": "Facing", "keywords": [], "long_description": "A physics-based online sword fighting VR game.\n\nHit your opponent's headset with your sword. Protect your headset from your opponent's weapons by parrying or dodging.\n\ngame rules\n\u30fbCan only use weapons \u30fbCan only attack the opponent's headset\n\u00b7For the sake of fairness, the range of player activities is limited to one step\n\u00b7After the preparation is completed, enter the duel stage for a duel\n\u00b7The faster you swing your weapon, the more damage you can do. The farther the opponent's weapon is sent flying.\n\u30fbAfter the weapon collides, there will be an offset that prevents you from swinging the sword accurately and continuously. Of course, you can take advantage of this offset with repeated practice.\n\u00b7 The game is 2 rounds with 7 points. The first person to score 7 points wins 1 round. Win 2 rounds to win the game.\n\nhint\nAs mentioned above, the single-player game provided by the game is limited. If you are a solo player, you may not have a good experience.\nYou can add friends in our Discord to make an appointment to play together at a fixed time.\nOur Discord:https://discord.gg/hY7uA8ppv7\nThe game needs a certain amount of real space to play, be careful not to hit the wall, the game defaults to 90Hz refresh rate, 72Hz Quest users will be at a disadvantage in confrontation, please buy carefully.\nThe game can be matched with Steam and Pico(CN) cross-platform.", "short_description": "A physics-based online sword fighting VR game.\n\nHit your opponent's headset with a tight grip on your sword. Protect your headset from your opponent's weapons by parrying or dodging."}]}, "developer_name": null, "developer_privacy_policy_url": "https://zzwei.games/privacypolicy/", "dev
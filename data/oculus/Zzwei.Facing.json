F8BB"}, {"file_name": "2.png", "id": "322497102844580", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/39031505_322497106177913_1885731480804630613_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dv8MiqLrQ2sQ7kNvwFKt_BK&_nc_oc=Adro-lo3ygNSNx7_ME2EEfcH5UCFmhj401F5oj2AmDpqUKZvE3lDz7gi7hjEBad5G10&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOQT37kKp7xLQZqn562OGovJttogXpy-AmM4ix4M4qnpw&oe=6AD0DA45"}, {"file_name": "3.png", "id": "623902955323651", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38982666_623902958656984_627104830482221034_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wPmZsE6SE3AQ7kNvwEQ_sEw&_nc_oc=AdpVz4OyAhRvL4Oojv1OKcFqmiN1u3xxPiA4Mtuad7hyWssbZD81rlS4PdZhANxRrjc&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN3t52RRHRmy8y3wseo9S1U6_D6L2SZ6Akv9YoZ_fE4sw&oe=6AD0FA36"}, {"file_name": "4.png", "id": "435400698123614", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38974444_435400701456947_1868629701117421690_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1J7fgR-sZqgQ7kNvwH5LeuK&_nc_oc=Adp0vMpkCGk8px1Oq7a0UPSuMEkcp1NFYuJm1menlIm6NN-0VAV00Kon8cy-GRLkBLs&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOrL8MikACmg1P2GSdkOe1W3tCcnxQ5XGw7pXi7rmH9yA&oe=6AD0E676"}, {"file_name": "5.png", "id": "300658551972783", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/39003239_300658555306116_2868297386557494839_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hESb1RCLjSwQ7kNvwFjDEnX&_nc_oc=AdpIEijMBtdBQ_DjzwprB6OmMhJTplPaPce2S6KYD4w_UGlc6Fg5hBhtTrcfbczEa_s&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNrHnGbLwT9Ek39WPs2xCyjYF-c1dffVNv9gKClDZYpwA&oe=6AD0ED19"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover.png", "id": "1342356962880780", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/39031553_1342356966214113_3465353394871499435_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eGR8Iat9WLAQ7kNvwGJimlB&_nc_oc=AdqJC6kCVkkNxow6hNUsTZxpHxbyTrBXkF56gqpNoKV__Klv-TdbMPncOunjBv1Z1qY&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQObmNN8m49frNS8B6RBUD8bw7-3ZJywRzhn0tPXYeDA1A&oe=6AD0D362"}, "display_name": "Facing", "keywords": [], "long_description": "A physics-based online sword fighting VR game.\n\nHit your opponent's headset with your sword. Protect your headset from your opponent's weapons by parrying or dodging.\n\ngame rules\n\u30fbCan only use weapons \u30fbCan only attack the opponent's headset\n\u00b7For the sake of fairness, the range of player activities is limited to one step\n\u00b7After the preparation is completed, enter the duel stage for a duel\n\u00b7The faster you swing your weapon, the more damage you can do. The farther the opponent's weapon is sent flying.\n\u30fbAfter the weapon collides, there will be an offset that prevents you from swinging the sword accurately and continuously. Of course, you can take advantage of this offset with repeated practice.\n\u00b7 The game is 2 rounds with 7 points. The first person to score 7 points wins 1 round. Win 2 rounds to win the game.\n\nhint\nAs mentioned above, the single-player game provided by the game is limited. If you are a solo player, you may not have a good experience.\nYou can add friends in our Discord to make an appointment to play together at a fixed time.\nOur Discord:https://discord.gg/hY7uA8ppv7\nThe game needs a certain amount of real space to play, be careful not to hit the wall, the game defaults to 90Hz refresh rate, 72Hz Quest users will be at a disadvantage in confrontation, please buy carefully.\nThe game can be matched with Steam and Pico(CN) cross-platform.", "short_description": "A physics-based online sword fighting VR game.\n\nHit your opponent's headset with a tight grip on your sword. Protect your headset from your opponent's weapons by parrying or dodging."}]}, "developer_name": null, "developer_privacy_policy_url": "https://zzwei.games/privacypolicy/", "dev
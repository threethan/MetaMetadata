3DBB"}, {"file_name": "2.png", "id": "322497102844580", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031505_322497106177913_1885731480804630613_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IjGeIqF-2MIQ7kNvwGOwNfM&_nc_oc=AdrOk2QfOb0CrCM8-n8P1x5d9sT00qv3N_zyWGoImNd8Dr1EfmvPc3z9ZFi6B8EyvSk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI_ZMdXeEA-Cu9YVCBtE51X3F4HfjyphQrH94lrN0lYTA&oe=6AB91F45"}, {"file_name": "3.png", "id": "623902955323651", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982666_623902958656984_627104830482221034_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_bXlWDF0AzcQ7kNvwEIytd6&_nc_oc=AdoFWbF9dVyRHuP3edeo2o6Qb95Qstr6Uq2jrg2qIJscDf5PkXe7vZI4voLgr8m-Zj8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKwxa8M9ehYBRT3Db_4GBvE9XMaLJQI8Wps8YRrbCI55g&oe=6AB906F6"}, {"file_name": "4.png", "id": "435400698123614", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974444_435400701456947_1868629701117421690_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bTsOfrAOduQQ7kNvwFOLNYw&_nc_oc=AdrXeY5fdiGB5oqfPurc2IOYGR-19u2YreVAo8IbgsGSSKZUNRpN_dhj1VX8LZ7eLQw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLzcMiOjwke5PlnTcROHOXvo4M5NmX69GPNlRu5bq94HA&oe=6AB92B76"}, {"file_name": "5.png", "id": "300658551972783", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39003239_300658555306116_2868297386557494839_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8scORIjvQUYQ7kNvwEr-NZU&_nc_oc=AdqXYT7qPnIGT_CDgw4GDFj0oCRx57qAAKYLYpU6cMst4N6oUK7-9iRi3M860LNg85w&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKVDLwfNwTH4tHqud5kyABLVcdE0arr9X8a6qD2-ZGB9A&oe=6AB93219"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover.png", "id": "1342356962880780", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031553_1342356966214113_3465353394871499435_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YBMzhkzt9pYQ7kNvwFHNQ75&_nc_oc=Adq6Cj4aTC0ajwFDgz9JwPSSJoUnQkGY4BoLUwphwXqDivKReU9Wc18pjs4L-_MnRjk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI_AzxKjJOoK8Ww0Ub_GEh-k92JU6pifkqKhJ4371ivFg&oe=6AB91862"}, "display_name": "Facing", "keywords": [], "long_description": "A physics-based online sword fighting VR game.\n\nHit your opponent's headset with your sword. Protect your headset from your opponent's weapons by parrying or dodging.\n\ngame rules\n\u30fbCan only use weapons \u30fbCan only attack the opponent's headset\n\u00b7For the sake of fairness, the range of player activities is limited to one step\n\u00b7After the preparation is completed, enter the duel stage for a duel\n\u00b7The faster you swing your weapon, the more damage you can do. The farther the opponent's weapon is sent flying.\n\u30fbAfter the weapon collides, there will be an offset that prevents you from swinging the sword accurately and continuously. Of course, you can take advantage of this offset with repeated practice.\n\u00b7 The game is 2 rounds with 7 points. The first person to score 7 points wins 1 round. Win 2 rounds to win the game.\n\nhint\nAs mentioned above, the single-player game provided by the game is limited. If you are a solo player, you may not have a good experience.\nYou can add friends in our Discord to make an appointment to play together at a fixed time.\nOur Discord:https://discord.gg/hY7uA8ppv7\nThe game needs a certain amount of real space to play, be careful not to hit the wall, the game defaults to 90Hz refresh rate, 72Hz Quest users will be at a disadvantage in confrontation, please buy carefully.\nThe game can be matched with Steam and Pico(CN) cross-platform.", "short_description": "A physics-based online sword fighting VR game.\n\nHit your opponent's headset with a tight grip on your sword. Protect your headset from your opponent's weapons by parrying or dodging."}]}, "developer_name": null, "developer_privacy_policy_url": "https://zzwei.games/privacypolicy/", "dev
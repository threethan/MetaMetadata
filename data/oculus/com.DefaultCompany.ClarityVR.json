6B10444E"}, {"file_name": "1. Defiance Scenario Hints.png", "id": "1448597677400562", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499627379_1448597680733895_3054697953889034083_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wUtzNIH-HpgQ7kNvwErP5F7&_nc_oc=AdoibRutmKA6nnXMkmVMhv6Lqb4ZPAPb7mLHGiH-B79s46dBedrvkbU06KddH8BPeW0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXEJc3llm7AZAhE5tF6Nu0CLeZYZ_DqKvEvR6rJQhUTOg&oe=6B1035E9"}, {"file_name": "1 Jay throwing chair.png", "id": "1118468311167240", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499619369_1118468314500573_4767955291719046848_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S0akFpXNziYQ7kNvwH6J0GL&_nc_oc=Adr_78rJMUTJzQGmsqegjoDJYNA9S164tpFXuf8fPQgN5yEqz5HOhLw2xX-9BYZZCu8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQUGvmBBmoT4wDNLtK21sAJggzKD1uOAb_gF7TxbGGNzNQ&oe=6B103964"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "EnactEd", "keywords": [], "long_description": "TRAIN FOR THE HARD LESSONS.\n\nPractise teacher decision-making before the classroom makes the stakes real.\n\nEnactEd places you in an interactive VR classroom where AI-driven students respond to what you say. Rehearse classroom management and teaching strategies, explore different approaches and learn from personalised feedback.\n\nPRACTICE THAT RESPONDS TO YOU\n\u2022 Establish routines and settle a class.\n\u2022 Manage low-level chatter and attention-seeking behaviour.\n\u2022 Respond to defiance without escalating conflict.\n\u2022 Give instructions and release students to independent work.\n\u2022 Explore your own lesson ideas in Free Teaching Practice.\n\nChoose scenarios in any order and select your challenge level. Use subject-specific slides, consult optional hints on the classroom monitor and review feedback after each session.\n\nDesigned for pre-service teachers, practising educators and teacher-education programmes. Practise strategies such as parallel acknowledgement, positive redirection, limited choice, take-up time and wait-and-scan.\n\nTRY BEFORE YOU BUY\nDownload free and receive five minutes of live practice across your choice of scenarios. Continue with prepaid one-hour practice packs. Up to three named learner profiles share the account\u2019s practice balance.\n\nRequires an internet connection and microphone access. AI responses and feedback may be inaccurate. Challenging scenarios may include simulated aggression and strong language.", "short_description": "Train for the hard lessons. EnactEd is an AI-powered virtual classroom for practising classroom management, behaviour support and teacher decision-making. Speak naturally with virtual students, respond to challenging behaviour and reflect on personalised feedback. Try five minutes free, then purchase additional live practice time."}]}, "developer_name": null, "developer_privacy_policy_url": "https://cpr.pedagogiesenacted.com/enacted-privacy.html", "developer_terms_of_service_url": "https://cpr.pedagogiesenacted.com/enacted-terms.html", "publisher_name": "Enacted PTY LTD", "support_website_url": "https://www.pedagogiesenacted.com/contact", "website_url": "https://www.pedagogiesenacted.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "29030930629939825"}}]}, "scheduled_offers": {"count": 1,
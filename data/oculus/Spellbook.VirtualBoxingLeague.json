zH78wLmV25J7kw4CdnPJKo&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSCkTQUGhVQcrnzZX-z5nk7LmZe_URWiQnSurUpxqv9LQ&oe=6AFB4B9D"}, {"file_name": "vbl ss5 (1).png", "id": "345400373892367", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38984454_345400377225700_481721522969066790_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UiVOw-T27DYQ7kNvwHwxU2G&_nc_oc=Adr6_jxK7_QPWW10pXnjvEaNY30Bph82nKrf6xrJk4IrzNkGSUPSaBd8QRnUIEgh5fQ&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTagnoddCzyIj2vSXL40zNRJybe3rwvmhqfEx_okVq5Tw&oe=6AFB21A0"}, {"file_name": "vbl ss3 (1).png", "id": "247778197507044", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38974602_247778200840377_151218868185294919_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7UQPZZ2MMIEQ7kNvwGwdKfF&_nc_oc=AdoITzVnkMq0rhdsJLGL7Dp7C171umgU31DjYLn5pvQrQeuOVV0rhX-iJzopr7_PFAc&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRBQHcP5kcZ1hP2c47uIbysCsKYg28eTiyhaWbFjOBEew&oe=6AFB1DCA"}, {"file_name": "vbl ss4 (1).png", "id": "900897190485234", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38974797_900897193818567_6836463381219320834_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jwyGCec99xgQ7kNvwG-9r3i&_nc_oc=AdqLsd0-19r-e-oPjLLongsYrYBrU0zWJg3--J3XjSuzCtJReIrTHNo0L-MKb_TiCWk&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQeLMOTUO6VgBTKSoVVucjLmoGt88EeLz7A-sslL1Kq8A&oe=6AFB19EB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "vbl simple 2560x1440.png", "id": "1075908663205594", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/39001654_1075908666538927_3112951141652817843_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vqXKW-6xWOAQ7kNvwFJu61l&_nc_oc=AdoQ1fi-OzQ2FsY17IRqMDLVOz8Sp23RPOCq6YxQyREQNh-v3JlDI-biN0RRfBG2A2s&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQWG2b7aWc-Sd0P4qAwrt7TohyUwTE4WMvhwLokQy5Vmw&oe=6AFB3A1F"}, "display_name": "Virtual Boxing League", "keywords": [], "long_description": "Virtual Boxing League is a realistic physics and skill-based VR boxing simulation!\n\nLearn how to box, build self-confidence, have fun and get a great workout while developing your own personal fighting style!\n\nChallenge AI boxers in five ladders with opponents adopting distinct styles based on motion captures from real professionals!\n\nOther VR boxing games are an arcade experience with unrealistic physics -- We've created a new concept that builds real fighting skills and rewards your boxing instincts!\n\nEnjoy 5 additional mini-games when you need a break from the ring:\n- Ball Blaster is a high-tech musical arcade experience.\n- Punch-A-Tron is an old steam-powered carnival contraption.\n- Bum Rush is a wild banjo-strumming bathroom brawl.\n- Body Bag trains your speed, strength, and accuracy.\n- Ping Pong Punch teaches delicate control of your meat mitts.", "short_description": "Virtual Boxing League is a realistic physics and skill-based VR boxing simulation! Learn how to box, build self-confidence, have fun and get a great workout while developing your own personal fighting style!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://files.spellbook.com/tib/vblprivacy.txt", "developer_terms_of_service_url": null, "publisher_name": "Spellbook", "support_website_url": null, "website_url": "https://www.Spellbook.com/", "category": "GAMES", "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["FIGHTING", "ARCADE", "ACTION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "sup
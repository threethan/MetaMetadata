rd5-2.oculuscdn.com/v/t64.5771-25/38984454_345400377225700_481721522969066790_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dAWtbyMmNMkQ7kNvwGu9ZQy&_nc_oc=Adpi3GLy1WNmpGV6qJ_MEdzyCHHAhSS9yP74EZGrbYra0USZ4LVnrnM2-QP4rS4L-N4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBF8yUmB_q6BLuKyaOfFhN0UZfg5AfEnNiiVcnykOnPAw&oe=6A4A78A0"}, {"file_name": "vbl ss3 (1).png", "id": "247778197507044", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974602_247778200840377_151218868185294919_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uf47FC-fa2IQ7kNvwFQwOGo&_nc_oc=AdqR0Lm-ag6-C20uTuORs4AuWj6hbM7RrqxX1l-2X5kvW-RxV5yqijUEVPFnF-PFi_Q&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBsUZHn-ptz8O0AtCxp1J9Ae9eMTWjzIXmDCAeiGB6Xpg&oe=6A4A74CA"}, {"file_name": "vbl ss4 (1).png", "id": "900897190485234", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974797_900897193818567_6836463381219320834_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l8UjfxvORCMQ7kNvwFoHRPu&_nc_oc=AdrDcAUhYsqOEF-F8iKphitmQU1U1LTPDiB7k52V2PK-dQGWYWMiD_xB63mCZH3rQMU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDH25stTtAgwx7Ij7IoQTj16XwCsxjQbT-EZCN1cvypnw&oe=6A4A70EB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "vbl simple 2560x1440.png", "id": "1075908663205594", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39001654_1075908666538927_3112951141652817843_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RgXD78Sag6sQ7kNvwHmUBkG&_nc_oc=Adp6BC7QFXQ0nqpaGfkRIe1moH8PGu9NWddJDKmE9gXfYOufjXb68qNnBWNBvTSSYm8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCD1iVhHoPvDXIaz0fjVexh1BfpWcE06F8AeeHc96r5kw&oe=6A4A58DF"}, "display_name": "Virtual Boxing League", "keywords": [], "long_description": "Virtual Boxing League is a realistic physics and skill-based VR boxing simulation!\n\nLearn how to box, build self-confidence, have fun and get a great workout while developing your own personal fighting style!\n\nChallenge AI boxers in five ladders with opponents adopting distinct styles based on motion captures from real professionals!\n\nOther VR boxing games are an arcade experience with unrealistic physics -- We've created a new concept that builds real fighting skills and rewards your boxing instincts!\n\nEnjoy 5 additional mini-games when you need a break from the ring:\n- Ball Blaster is a high-tech musical arcade experience.\n- Punch-A-Tron is an old steam-powered carnival contraption.\n- Bum Rush is a wild banjo-strumming bathroom brawl.\n- Body Bag trains your speed, strength, and accuracy.\n- Ping Pong Punch teaches delicate control of your meat mitts.", "short_description": "Virtual Boxing League is a realistic physics and skill-based VR boxing simulation! Learn how to box, build self-confidence, have fun and get a great workout while developing your own personal fighting style!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://files.spellbook.com/tib/vblprivacy.txt", "developer_terms_of_service_url": null, "publisher_name": "Spellbook", "support_website_url": null, "website_url": "https://www.Spellbook.com/", "category": "GAMES", "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["FIGHTING", "ARCADE", "ACTION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26145987445047843"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5
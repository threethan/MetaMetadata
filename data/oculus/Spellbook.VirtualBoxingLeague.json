rd5-2.oculuscdn.com/v/t64.5771-25/38984454_345400377225700_481721522969066790_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=t897LvIiC-AQ7kNvwHEtozp&_nc_oc=AdqxCeMGilaf0CfGgsS6ujHNLyVhoZOf9qkzXHuZJGgaW3URcg86j0nIDwwqdxQXIHE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBi0GpJdM6geMq4O4g3R0NIMeUqEwC0ENHexBCnfQelEA&oe=6A5261A0"}, {"file_name": "vbl ss3 (1).png", "id": "247778197507044", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974602_247778200840377_151218868185294919_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7a8XFQbweZcQ7kNvwHAswJz&_nc_oc=AdpREBI8-TeC07Emf6SChxW1aiQlkK3nKya52Tcbb93miFFrcxxHz9GSg3POEpZpjDc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBCewY_zxJkAR3Qk78afRxMJAx3kr3cdvquDcmYjoPS9w&oe=6A525DCA"}, {"file_name": "vbl ss4 (1).png", "id": "900897190485234", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974797_900897193818567_6836463381219320834_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dmxh-UvPrPcQ7kNvwHTft7I&_nc_oc=AdpKhH5NvtnZfYAGU6FJtG-nZ9hTGPFIMCszhHB2dVX3wKlPu0zFsFe3vgq7qBenvUQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAiX5-fPxvZocceM8KQ6fClkOCxPmiNJA5nRQWz_igxvg&oe=6A5259EB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "vbl simple 2560x1440.png", "id": "1075908663205594", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39001654_1075908666538927_3112951141652817843_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UwN1JPFRitAQ7kNvwFrp2G0&_nc_oc=Adrvwk5qc9iieQcd-wc1YxIKLB9FDOPk6PJAD3SlOtidC1Tt-Nv0kTgsK1KIc_OklwE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBGGcrS_6y-hqrE049jqHjVQUPYgrz0xQQ0h19ef-tHLg&oe=6A5241DF"}, "display_name": "Virtual Boxing League", "keywords": [], "long_description": "Virtual Boxing League is a realistic physics and skill-based VR boxing simulation!\n\nLearn how to box, build self-confidence, have fun and get a great workout while developing your own personal fighting style!\n\nChallenge AI boxers in five ladders with opponents adopting distinct styles based on motion captures from real professionals!\n\nOther VR boxing games are an arcade experience with unrealistic physics -- We've created a new concept that builds real fighting skills and rewards your boxing instincts!\n\nEnjoy 5 additional mini-games when you need a break from the ring:\n- Ball Blaster is a high-tech musical arcade experience.\n- Punch-A-Tron is an old steam-powered carnival contraption.\n- Bum Rush is a wild banjo-strumming bathroom brawl.\n- Body Bag trains your speed, strength, and accuracy.\n- Ping Pong Punch teaches delicate control of your meat mitts.", "short_description": "Virtual Boxing League is a realistic physics and skill-based VR boxing simulation! Learn how to box, build self-confidence, have fun and get a great workout while developing your own personal fighting style!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://files.spellbook.com/tib/vblprivacy.txt", "developer_terms_of_service_url": null, "publisher_name": "Spellbook", "support_website_url": null, "website_url": "https://www.Spellbook.com/", "category": "GAMES", "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["FIGHTING", "ARCADE", "ACTION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26145987445047843"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5
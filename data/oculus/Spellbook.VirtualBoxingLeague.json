m4rBPI4QGEu0kPfiuYAS2g&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQuE-vHRdrxDTF2qU9c-RcxFKd-ergubosI1UEgPDptYg&oe=6B0C6F1D"}, {"file_name": "vbl ss5 (1).png", "id": "345400373892367", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38984454_345400377225700_481721522969066790_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vq8XG2ZIyoAQ7kNvwHk-Lo5&_nc_oc=AdpFKzDhZu5-s_oj-sSPRhTmrEn9fCWM6P9ryK6ZsYDmR0cMlphABnsrZTSGh-HFxzk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQGBpOGuczzuVQJ9sqUuTEMwxQ-5n5o5bYMeK5rnRznrg&oe=6B0C7D60"}, {"file_name": "vbl ss3 (1).png", "id": "247778197507044", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974602_247778200840377_151218868185294919_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=--EPi8NvxAMQ7kNvwEX0qIA&_nc_oc=Adrwc7CWLRgs0P2n_5z0YDGD2H-YfJ9Kvk7CFRT5gOD6fa9vh2LH9Cx_mfCkurW5t2o&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSJkukx1_tnNT6UrKJg-zsquMKDHda2bA5dmsUqWJCliQ&oe=6B0C798A"}, {"file_name": "vbl ss4 (1).png", "id": "900897190485234", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974797_900897193818567_6836463381219320834_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=13fx8nNFUSgQ7kNvwFTu75u&_nc_oc=AdpimyWDuKbRge2Z8wMw5h0LWdmY1mHG9RBNoByrzA2-0oUnf7B-Wo-sIVI5Lt8O9ng&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQuEmXUtN0iuKY3Pc9lQ6CyYHKAniC5lBBMoIExrP-vgg&oe=6B0C75AB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "vbl simple 2560x1440.png", "id": "1075908663205594", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39001654_1075908666538927_3112951141652817843_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fEpk-Hd17dwQ7kNvwF-mknC&_nc_oc=Adq9rTSJ_Geh8iAoAWMqjwKUuX4jB5JLgmOhipvdA0l0J7MB3rfr29JJV5WJ_LYmm-4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQmP2zLlIaw62rVgdyOPapbTam6D96qXsWTbg87WWRMhg&oe=6B0C5D9F"}, "display_name": "Virtual Boxing League", "keywords": [], "long_description": "Virtual Boxing League is a realistic physics and skill-based VR boxing simulation!\n\nLearn how to box, build self-confidence, have fun and get a great workout while developing your own personal fighting style!\n\nChallenge AI boxers in five ladders with opponents adopting distinct styles based on motion captures from real professionals!\n\nOther VR boxing games are an arcade experience with unrealistic physics -- We've created a new concept that builds real fighting skills and rewards your boxing instincts!\n\nEnjoy 5 additional mini-games when you need a break from the ring:\n- Ball Blaster is a high-tech musical arcade experience.\n- Punch-A-Tron is an old steam-powered carnival contraption.\n- Bum Rush is a wild banjo-strumming bathroom brawl.\n- Body Bag trains your speed, strength, and accuracy.\n- Ping Pong Punch teaches delicate control of your meat mitts.", "short_description": "Virtual Boxing League is a realistic physics and skill-based VR boxing simulation! Learn how to box, build self-confidence, have fun and get a great workout while developing your own personal fighting style!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://files.spellbook.com/tib/vblprivacy.txt", "developer_terms_of_service_url": null, "publisher_name": "Spellbook", "support_website_url": null, "website_url": "https://www.Spellbook.com/", "category": "GAMES", "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["FIGHTING", "ARCADE", "ACTION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "sup
778197507044", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974602_247778200840377_151218868185294919_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BFfzXpkWowYQ7kNvwF0y2Bc&_nc_oc=AdqccTTt5j2C4zIjI_ePGy2MgZUucW1w14SGXWGQdHFCN_T0davuiX6FjdZqXiHlVHg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTLTjeEFqPBecSQy4gppozIaoRLrpsYjTVuw01uQJ8ojw&oe=6AF87ACA"}, {"file_name": "vbl ss4 (1).png", "id": "900897190485234", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974797_900897193818567_6836463381219320834_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yTe22HA7Or4Q7kNvwGg4O06&_nc_oc=AdrIa2dBfzUdKVlhz5O7TqfuvqcV31L9XEJCiNn9zXQ73mutjFbsbsoHp40sRD9LVHw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSMxbl6pbRhOl7dQnbyunTVa9x_FDISzvV-AgRIBxTnkg&oe=6AF876EB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "vbl simple 2560x1440.png", "id": "1075908663205594", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39001654_1075908666538927_3112951141652817843_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CfmeSNCjklUQ7kNvwErfB68&_nc_oc=AdonmJyGWBC3y0_6tnGwNKDLcoDua1YWx0tvYGLfzWkgKuuSlLWybMIG_6cBr8DVhEs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS4mN2UpzURyghQqNyB8wLAYga-H5o3M4xx0TnLsvPZlQ&oe=6AF8971F"}, "display_name": "Virtual Boxing League", "keywords": [], "long_description": "Virtual Boxing League is a realistic physics and skill-based VR boxing simulation!\n\nLearn how to box, build self-confidence, have fun and get a great workout while developing your own personal fighting style!\n\nChallenge AI boxers in five ladders with opponents adopting distinct styles based on motion captures from real professionals!\n\nOther VR boxing games are an arcade experience with unrealistic physics -- We've created a new concept that builds real fighting skills and rewards your boxing instincts!\n\nEnjoy 5 additional mini-games when you need a break from the ring:\n- Ball Blaster is a high-tech musical arcade experience.\n- Punch-A-Tron is an old steam-powered carnival contraption.\n- Bum Rush is a wild banjo-strumming bathroom brawl.\n- Body Bag trains your speed, strength, and accuracy.\n- Ping Pong Punch teaches delicate control of your meat mitts.", "short_description": "Virtual Boxing League is a realistic physics and skill-based VR boxing simulation! Learn how to box, build self-confidence, have fun and get a great workout while developing your own personal fighting style!"}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.theinfiniteblack.com/tib/vblprivacy.txt", "developer_terms_of_service_url": null, "publisher_name": "Spellbook", "support_website_url": null, "website_url": "https://www.Spellbook.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["FIGHTING", "ARCADE", "ACTION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1044814156181645"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "597782925169703"}]}, "baseline_offer": {"id": "597782925169703"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1662583620, "status": "PUBLISHED", "id": "597782925169703"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "7115941175145756", "version": "1.0.2.8"}, "id": "3207454196149612", "channel_name": "LIVE"
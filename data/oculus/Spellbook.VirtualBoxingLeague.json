, "id": "247778197507044", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/38974602_247778200840377_151218868185294919_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kERnPCju-mcQ7kNvwEs6hDT&_nc_oc=AdpccIn4Teepj5vm35DqcbGdjgeLxsG9A99wdKiLHyMPpCuSPwChREIHYncEhJNAhJc&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHKLMalcvxcQfMfcrPfXudnfJ4oT5wzHErb00E7aPMyCw&oe=6A8D790A"}, {"file_name": "vbl ss4 (1).png", "id": "900897190485234", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/38974797_900897193818567_6836463381219320834_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UjI2EHSCxj4Q7kNvwFqq-5e&_nc_oc=AdqrXldz8h4djJCbpROXeGXANMnACibfaX5FohdtnD9sft7IYVuk3I5WIat4q6h93rg&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF0eyu7wlgFJ_yKfAtb9lALM_Q_Xjydf2APdAXw-yVqXQ&oe=6A8D752B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "vbl simple 2560x1440.png", "id": "1075908663205594", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/39001654_1075908666538927_3112951141652817843_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YD1dID1uezkQ7kNvwGxX-d_&_nc_oc=AdoMfRXEvwJGWC_ImEWQYX_XxIKyH8UUf-WR7KYGbMPgsIfxiHCRuFMd_EBIflD1R9E&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFvVHHGQaKp14dp7KhJSbdeWx1ZF9PjdtVj2p__uMaivA&oe=6A8D955F"}, "display_name": "Virtual Boxing League", "keywords": [], "long_description": "Virtual Boxing League is a realistic physics and skill-based VR boxing simulation!\n\nLearn how to box, build self-confidence, have fun and get a great workout while developing your own personal fighting style!\n\nChallenge AI boxers in five ladders with opponents adopting distinct styles based on motion captures from real professionals!\n\nOther VR boxing games are an arcade experience with unrealistic physics -- We've created a new concept that builds real fighting skills and rewards your boxing instincts!\n\nEnjoy 5 additional mini-games when you need a break from the ring:\n- Ball Blaster is a high-tech musical arcade experience.\n- Punch-A-Tron is an old steam-powered carnival contraption.\n- Bum Rush is a wild banjo-strumming bathroom brawl.\n- Body Bag trains your speed, strength, and accuracy.\n- Ping Pong Punch teaches delicate control of your meat mitts.", "short_description": "Virtual Boxing League is a realistic physics and skill-based VR boxing simulation! Learn how to box, build self-confidence, have fun and get a great workout while developing your own personal fighting style!"}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.theinfiniteblack.com/tib/vblprivacy.txt", "developer_terms_of_service_url": null, "publisher_name": "Spellbook", "support_website_url": null, "website_url": "https://www.Spellbook.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["FIGHTING", "ARCADE", "ACTION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1044814156181645"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "597782925169703"}]}, "baseline_offer": {"id": "597782925169703"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1662583620, "status": "PUBLISHED", "id": "597782925169703"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "7115941175145756", "version": "1.0.2.8"}, "id": "3207454196149612", "channel
4OanmTPhVu99j2o9QP-hVNnJw&oe=6AFC84A8"}, "display_name": "Tiny Home", "keywords": [], "long_description": "Are you interested in a narrated story that guides you through coloring your world? Do you want to master your breathing by using our exercises that incorporate the environment? Have you ever felt the need to escape to a sound garden with nothing but yourself and calming sounds?\n\nListen to our stories as they guide you through a narrative which combines painting your environment, looking for clues and uncovering the elements that make up the world. Navigate and teleport through the world to discover the secrets of our stories. Experience our breathing guide to slow the tempo of your life and master the control of your breath. Relax by escaping to our sound gardens - simple rooms with special audio sensory experiences. We hope we have something that helps you relax and find your inner peace.", "short_description": "Set your mind at ease with Tiny Home - paint the world by listening to a story and uncovering its character, or relax by controlling your breath with our mindfulness guides, or explore beautiful and solitary environments. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.tinyhome.tech/tinyhome/privacy", "developer_terms_of_service_url": "https://www.tinyhome.tech/tinyhome/terms", "publisher_name": "Tiny Home Studios", "support_website_url": "https://www.tinyhome.tech/contact", "website_url": "https://www.tinyhome.tech/", "category": "ENTERTAINMENT", "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["RELAXATION_MEDITATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_
t64.5771-25/75299164_561898628934196_7926294636267062475_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pG2UC0PqMvAQ7kNvwEa1u6g&_nc_oc=AdoZSWeEOt-Fp42VD-W03sxE_PtdxP-a-2_XJJKxd8S7envQaMqeaD8O0Y9Wyw0D4dI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMmjPvkp20upiWKWAh3QLE6St_l82T0313DsqcKRkMfeQ&oe=6ACE6416"}, {"file_name": "Screenshot 2.png", "id": "425251922816036", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/227942961_425251926149369_5592382975199203668_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5I3xS-XeNDQQ7kNvwFDiS92&_nc_oc=AdrBaLiPT7C9Bi16PlUMtWimDlgSANmzZosFxy1aywzDecc6gjz-v0uCgfehco0rHGQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMDP_diamQTdQqA6CcTKyiYqW4j6ySCNHNh2e0Ig2Pupg&oe=6ACE5D29"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer cover 1a.png", "id": "1251845642224930", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982512_1251845645558263_1335720434005801722_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yElm5BwhoxcQ7kNvwE7ovjy&_nc_oc=AdrOoWQOhlDxRuIGVxfo76YcA1SYJKEaQVp8Npb67HBuIC3irOPFeUga6fTcx15N6hI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMca18kULfZl-X23Itpj082xuVxdFYjMiBwj4V4cJW1lg&oe=6ACE3C07"}, "display_name": "N1C2 v1.4", "keywords": [], "long_description": "ClearConnect is a new exciting experience with 100% immersion in training, products and solutions.\nIt is a space to work, learn, meet and train from anywhere in the world.\n\nClearConnect makes it possible to join in different environments like a virtual classroom that allows you to collaborate in real-time and it is great for design sessions and looking under the hood at products. You can also access a conference room with a great view. The \u201cNew Product Introduction Platform\u201d, is a place to join to showcase, test and use prototypes to make better decisions and get a real feel for your product line. Our virtual data center allows to pick up, rack, and cable equipment just like you would in the real world. \n\nAny off-platform monetization of content accessible in this app conforms to the Oculus Bulk IAP or Subscription Licenses app policy outlined here: https://developer.oculus.com/policy/app-policies/", "short_description": "ClearConnect introduces the future of training and collaboration providing a space in the VR World that combines lectures and labs to meet and interact in real time with your colleagues."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.n1c2.com/privacy_policy", "developer_terms_of_service_url": null, "publisher_name": "NterOne", "support_website_url": null, "website_url": "https://www.n1c2.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1063584910766706"}, {"id": "2687655338230691"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL", "EXPERIENCE_360_NON_GAME", "SOCIAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "MULTI_USER"], "id": "1022301858473962"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1753778508304839"}]}, "baseline_offer": {"id": "1753778508304839"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1657731600, "status": "PUBLISHED", "id": "1753778508304839"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "6082335361820947", "version": "1.0"}, "id": "913207656302390", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primar
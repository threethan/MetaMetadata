1_2708719016696395421_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fWFFSWLXmD8Q7kNvwGKeZ99&_nc_oc=AdrgfFuPIbgMz4CnPeTMdiQ5J7ScthddNPJwdYBMTKJUHDT26P8CDhyVLNVzJoQxQFk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOllUIxY7hPikGBxo22iVynnkmYaz1JXovFHKwl5_DF6Q&oe=6ACFA62A"}, {"file_name": "Screenshot 4.png", "id": "561898625600863", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75299164_561898628934196_7926294636267062475_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pG2UC0PqMvAQ7kNvwGacbUg&_nc_oc=AdofqhardxRYpx_iLIywLWHtdFWY0Rhz_WOU5ey7nh2TyBl8v00nkD4y-U_LoyKWdbY&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNwT8yRf7QB0eMBQYnJbhokQ1jXUAHa9-zFATLcJ_q4eA&oe=6ACFB596"}, {"file_name": "Screenshot 2.png", "id": "425251922816036", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/227942961_425251926149369_5592382975199203668_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5I3xS-XeNDQQ7kNvwHUXedJ&_nc_oc=AdqAjyRR12L9JdXYdXFTCdFgBy_Ct894kiumN38Ovh7gF6SOqzY5ypNf-_hVtWHCTVQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM22MVjD4jlPan9eM7IjSeUzjOv33my73qoDUmm_139xA&oe=6ACFAEA9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer cover 1a.png", "id": "600847448349239", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39001681_600847451682572_2658560326946100437_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4xmVhZm5JVUQ7kNvwFzssbl&_nc_oc=Ado3pWXgNHKrOR6_Q-SWWpHXywsoP2uDXGCFFtm3FsSUtHvaLKMNRiht_uzJs_U26G4&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM2SNCoRedz_zhHgOQilgVkLGClyMYR-io24Uh5PVhCZQ&oe=6ACF9BBA"}, "display_name": "ClearConnect", "keywords": [], "long_description": "ClearConnect is a new exciting experience with 100% immersion in training, products and solutions.\nIt is a space to work, learn, meet and train from anywhere in the world.\n\nClearConnect makes it possible to join in different environments like a virtual classroom that allows you to collaborate in real-time and it is great for design sessions and looking under the hood at products. You can also access a conference room with a great view. The \u201cNew Product Introduction Platform\u201d, is a place to join to showcase, test and use prototypes to make better decisions and get a real feel for your product line. Our virtual data center allows to pick up, rack, and cable equipment just like you would in the real world. \n\nAny off-platform monetization of content accessible in this app conforms to the Oculus Bulk IAP or Subscription Licenses app policy outlined here: https://developer.oculus.com/policy/app-policies/", "short_description": "ClearConnect introduces the future of training and collaboration providing a space in the VR World that combines lectures and labs to meet and interact in real time with your colleagues."}]}, "developer_name": "NterOne Sotfware", "developer_privacy_policy_url": "https://www.n1c2.com/privacy_policy", "developer_terms_of_service_url": null, "publisher_name": "NterOne", "support_website_url": null, "website_url": "https://www.n1c2.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1063584910766706"}, {"id": "2687655338230691"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL", "EXPERIENCE_360_NON_GAME", "SOCIAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "MULTI_USER"], "id": "600892538612609"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982
t64.5771-25/75299164_561898628934196_7926294636267062475_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QzmrVVzKk3cQ7kNvwElSfvw&_nc_oc=AdqB9oXfAyzIJpwrs3lObTEN9R6cwJ4kOLZkoad8N_H1mZTCKmvhUNfAOvpoD6zTvQA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRGlelJV9FwtYGW9UiQtDF9KzNNQbxxnrwYPVLtM5s25A&oe=6AEE0816"}, {"file_name": "Screenshot 2.png", "id": "425251922816036", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/227942961_425251926149369_5592382975199203668_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m1ZXSEzgrrIQ7kNvwGKWjZ4&_nc_oc=AdrGOAxEzXKeozblmtbXs-mt_FY2Sja_k8jtShUge5peHGJtA95jenlNgsvQjtZ3O9Y&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTMrkNBX95ndRKXdxw5CA1iOv0D2bslwq3q79u6fK9jqw&oe=6AEE0129"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer cover 1a.png", "id": "1251845642224930", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982512_1251845645558263_1335720434005801722_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QWzeymTO2CgQ7kNvwFajO0c&_nc_oc=Adr8Bnpnrv14giWzHjVa3Uy-G3Wk03RbMfOQiOBgIB0Pye7cTpgJUa_gl86cZl76UI8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR4JpY6rbVL3lG9Lqv24is_hGgUIA0NvIHdYT9yAn239g&oe=6AEDE007"}, "display_name": "N1C2 v1.4", "keywords": [], "long_description": "ClearConnect is a new exciting experience with 100% immersion in training, products and solutions.\nIt is a space to work, learn, meet and train from anywhere in the world.\n\nClearConnect makes it possible to join in different environments like a virtual classroom that allows you to collaborate in real-time and it is great for design sessions and looking under the hood at products. You can also access a conference room with a great view. The \u201cNew Product Introduction Platform\u201d, is a place to join to showcase, test and use prototypes to make better decisions and get a real feel for your product line. Our virtual data center allows to pick up, rack, and cable equipment just like you would in the real world. \n\nAny off-platform monetization of content accessible in this app conforms to the Oculus Bulk IAP or Subscription Licenses app policy outlined here: https://developer.oculus.com/policy/app-policies/", "short_description": "ClearConnect introduces the future of training and collaboration providing a space in the VR World that combines lectures and labs to meet and interact in real time with your colleagues."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.n1c2.com/privacy_policy", "developer_terms_of_service_url": null, "publisher_name": "NterOne", "support_website_url": null, "website_url": "https://www.n1c2.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1063584910766706"}, {"id": "2687655338230691"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL", "EXPERIENCE_360_NON_GAME", "SOCIAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "MULTI_USER"], "id": "1022301858473962"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1753778508304839"}]}, "baseline_offer": {"id": "1753778508304839"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1657731600, "status": "PUBLISHED", "id": "1753778508304839"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "6082335361820947", "version": "1.0"}, "id": "913207656302390", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primar
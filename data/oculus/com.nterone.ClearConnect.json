1_2708719016696395421_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ogo4ZWnLkeQQ7kNvwH0HtGi&_nc_oc=AdrHbFYeVeZAkZDNjh8n9KUicMAszcDzj8HuCeugOyw3CgQznm8pKFU5FdZoP5RZNeY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTtbbEIxTf_3Y5uQ7Z_hUrey5QFyONnaBY_3pPzabUlpQ&oe=6AF884AA"}, {"file_name": "Screenshot 4.png", "id": "561898625600863", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75299164_561898628934196_7926294636267062475_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZN2TjVe6RVAQ7kNvwF2BmGP&_nc_oc=Adr7UDG87z_0IP6fJVln7ymaqMUQAH52w1LT_FDkXe1dJ9WjHdAuAT_Rmrhdjct0Zl4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS9MA_-up_I6Xk0gEuTmkLL19zz1VmaeQj7SOSLELZHDg&oe=6AF89416"}, {"file_name": "Screenshot 2.png", "id": "425251922816036", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/227942961_425251926149369_5592382975199203668_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=knEL1TQghrwQ7kNvwF95JxV&_nc_oc=AdrWoPKHEkvP-VGbXO6-sdJhOPBB7Zny9DG2GbpV8qIdz_XGs0reH9T0VETSHM7Va3A&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ5Kxz7uz2ND-RTf6s1_p9vfWucDOAnzeXmDor7PcxvBg&oe=6AF88D29"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer cover 1a.png", "id": "600847448349239", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39001681_600847451682572_2658560326946100437_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PIPfFwr-1-sQ7kNvwFTujEn&_nc_oc=Adp_Bw-rc1lwT71ozSni7K9kUHbGotOQ3VRxPT3EIPA5Pl4n10WMjpIvTHzilK5gA8E&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSufsrNijhfm8O3audrAVk5UjzjvGFPOAc7sgVQb-fXcA&oe=6AF87A3A"}, "display_name": "ClearConnect", "keywords": [], "long_description": "ClearConnect is a new exciting experience with 100% immersion in training, products and solutions.\nIt is a space to work, learn, meet and train from anywhere in the world.\n\nClearConnect makes it possible to join in different environments like a virtual classroom that allows you to collaborate in real-time and it is great for design sessions and looking under the hood at products. You can also access a conference room with a great view. The \u201cNew Product Introduction Platform\u201d, is a place to join to showcase, test and use prototypes to make better decisions and get a real feel for your product line. Our virtual data center allows to pick up, rack, and cable equipment just like you would in the real world. \n\nAny off-platform monetization of content accessible in this app conforms to the Oculus Bulk IAP or Subscription Licenses app policy outlined here: https://developer.oculus.com/policy/app-policies/", "short_description": "ClearConnect introduces the future of training and collaboration providing a space in the VR World that combines lectures and labs to meet and interact in real time with your colleagues."}]}, "developer_name": "NterOne Sotfware", "developer_privacy_policy_url": "https://www.n1c2.com/privacy_policy", "developer_terms_of_service_url": null, "publisher_name": "NterOne", "support_website_url": null, "website_url": "https://www.n1c2.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1063584910766706"}, {"id": "2687655338230691"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL", "EXPERIENCE_360_NON_GAME", "SOCIAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "MULTI_USER"], "id": "600892538612609"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982
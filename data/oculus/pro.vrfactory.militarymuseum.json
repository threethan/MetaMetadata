/v/t64.5771-25/491819982_763559310046024_901354513863244642_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jcRC1HIw6_IQ7kNvwGfXB0g&_nc_oc=AdnWUJX-9ALCdUvTKWmRhqDXGE1uHAztCnrZnF-f6fn4pBFFY14auSMYiQyPKklFQYI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfypTP6ilagJh7lfU639DfLy06uVbjKuwEUG9I4Teowf8g&oe=69AEC286"}]}, "id": "1299671727944363", "locale": "en_US", "screenshots": [{"file_name": "BC_s1.png", "id": "1456511198763786", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491823259_1456511205430452_3759301095696677364_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=128Dn_lP8YwQ7kNvwFCUPBS&_nc_oc=Adn4OEMFf3xeWErEGMlSN0lFiX4nBQo55SX4hMg7DRPqvryqBDqZ4HofyvSL_4em6Jc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afw4UDO6aJWW_R_CWaSWwb2Ow0VefA4aihOjqwUM164taw&oe=69AEA898"}, {"file_name": "BC_s4.png", "id": "648936688155516", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499312468_648936691488849_3537115260097036807_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pzHeTP76bk4Q7kNvwG7fgux&_nc_oc=Adld2KQk9cyTbGBdwyW155x0w2h1quBSla2plvHvYnH6QezxLMMZGVW0uWNyQ2sNSxM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfwIqpBwOgLcRsEwRjCZWIvAnvoO7C3zW03OdiqrmtusqA&oe=69AEC0A5"}, {"file_name": "BC_s2.png", "id": "830906745991972", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491819854_830906749325305_8007553494364622338_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=js38DqdoOZgQ7kNvwEkP2tU&_nc_oc=Adlvrh-CH58_QPfCb2w6dbrIYRYGZvzQ5igmieCSHkysVT0qBIwimbKj19XtRDBALtQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afy1iUZTx3ypa6W2L2ZSAgYzD0aeEtEn80PB3pf7vbCHKA&oe=69AED188"}, {"file_name": "BC_s5.png", "id": "1588644169140924", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491823366_1588644175807590_5764699982406272219_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HFvh4sq3TxkQ7kNvwFV3gL0&_nc_oc=Adkbb6uhU7M5WPPp83P-0ujWZ0dVjIwfi7QYkfwTt5p0y9VzesKcF23iZ6kMJC5fhU0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfxU0tP2xVyPyzICG5FdtgfL1eY50W9utuXWr1Nj6utj_A&oe=69AEBE22"}, {"file_name": "BC_s3.png", "id": "1708914259756036", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491823802_1708914266422702_1301336280523144377_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GWzcBOgUEt4Q7kNvwFwmrdg&_nc_oc=AdmQyNrM-vAQdoXeg_d7mTLSILHFz4zvQ2Jp8zhh9c6JBnAud_QCXkOqvPypi091DIY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfxSl4BeagFOO6lf6EVxLHk5hq8QxReb0xa0tDK1aUhE3w&oe=69AED405"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "BATTLECRAFTER VR", "keywords": ["warfare", "restoration", "history", "simulation", "crafting"], "long_description": "# \u2694\ufe0fBecome the Master Restorer\u2694\ufe0f \nIn **BattleCrafter VR**, you become the galaxy\u2019s leading restoration specialist, tasked with bringing legendary weapons, armor, and battle techniques from humanity\u2019s past back to life. The future of the colossal Marsian War Museum\u2019s exhibitions depends on your skill and precision.\n\n__\n# \ud83d\udee0\ufe0fCraft, Upgrade, and Evolve\ud83d\udee0\ufe0f\nEach **mission** is a new assignment: restore four key historical **artifacts** \u2013 from ancient **swords**\ud83d\udde1\ufe0f to modern **rifles**\ud83d\udd2b \u2013 and install them inside massive multimedia domes that recreate iconic battles. The better your craftsmanship, the higher your reward, which you can reinvest into advanced workshop upgrades like 3D printers, magnetic assembly platforms, and laser welding tools.\n\n__\n# \ud83c\udf93History Reimagined in VR\ud83c\udf93\n\u2694\ufe0f**BattleCrafter VR**\u2692\ufe0f combines realistic hands-on simulation with an educational journey through the evolution of warfare. Discover how strategies, weapons, and technologies changed over centuries \u2013 all in deeply immersive VR. Every task demands focus and precision, and completing a perfect restoration is immensely satisfying.\n\n# \ud83e\ude90Welcome to the year 2125, on Mars \ud83e\ude90\u2013 where the history of war meets the future of technology. ", "short_description": "Step into the year 2125 as the galaxy\u2019s top restoration specialist and bring humanity\u2019s greatest battles back to life. Rebuild weapons, armor, and war artifacts from ancient swords to modern rifles, then showcase them in Mars\u2019 massive War Museum domes. Use futuristic tools, earn rewards for precision, and discover how warfare evolved through immersive VR missions. Each assignment takes you to a new era and a new challenge."}]}, "developer_name": "VR Factory Games S.A.", "developer_privacy_policy_url": "https://vrfactory.pro/our-games/battlecrafter-vr/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "VR Factory Games S.A.", "support_website_url": null, "website_url": "https://vrfactory.pro/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9307969755933916"}}]}, "scheduled_offers": {"count": 8, "nodes": [{"status": "PUBLISHED", "id": "2558187251233589"}, {"status": "PUBLISHED", "id": "844695574638145"}, {"status": "PUBLISHED", "id": "1613135026726966"}, {"status": "PUBLISHED", "id": "832122579575904"}, {"status": "PUBLISHED", "id": "783245517666426"}, {"status": "PUBLISHED", "id": "883364347987645"}, {"status": "PUBLISHED", "id":
/v/t64.5771-25/491819982_763559310046024_901354513863244642_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vI4QYaT9IGUQ7kNvwEFk30l&_nc_oc=Adnzt-5xM9DGWNejzP4Ybglk-N0m-u2vbSWcwTEPvJu0QX4jhlOSVY_MTW_CxAWlyvg&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afx2tYn3NykBxYwrUiK-kswXOHbepjPSNpPFrJ-JCeOhyQ&oe=69B01406"}]}, "id": "1299671727944363", "locale": "en_US", "screenshots": [{"file_name": "BC_s1.png", "id": "1456511198763786", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491823259_1456511205430452_3759301095696677364_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xvAMucFLJyMQ7kNvwGm1LZU&_nc_oc=Admab62fgxHBBUSGEC_oc3qAEpR17qhlamdHPJRRw21lkpYYsP_RINGMxoLkz9S_kyI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfxWrtSW3J7QBQKueLt7acpBXWmJXNzz1iLHoYovAEljhg&oe=69AFFA18"}, {"file_name": "BC_s4.png", "id": "648936688155516", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499312468_648936691488849_3537115260097036807_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pzHeTP76bk4Q7kNvwF16iZo&_nc_oc=Adnl5b3YDXCe7SiJL0nP6L2syAApC5XzFSjFPQMOErYmFtNNrTRVcxf0Lx08_PI17v4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfwnXWtXhnrdHqEU7UuN4TIstJERCOUIHghCB3u5Aw0n2w&oe=69B01225"}, {"file_name": "BC_s2.png", "id": "830906745991972", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491819854_830906749325305_8007553494364622338_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=js38DqdoOZgQ7kNvwF2lEaD&_nc_oc=AdmNoDbboz1NH7yCYOA-P33ixImwFdANVWJo87CRTSYhxeG2bVPEyuS7NAPpcxM0QoM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfxRFPhBvj4QObPyMNoOvzLJrJQhudYOWDx1RpTwVDPixw&oe=69B02308"}, {"file_name": "BC_s5.png", "id": "1588644169140924", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491823366_1588644175807590_5764699982406272219_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IiDZlftIDm0Q7kNvwH5I9Rd&_nc_oc=Adke7o33mEOKznyy7MKbQaP3u6706aSblJpb1eFsVESdhtmrRkuiVAdfIMRgvcozHo4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfyluAW-V4BrCL66HTWLN7Xx8s8AtBMSg-lsuWQwwogpfQ&oe=69B00FA2"}, {"file_name": "BC_s3.png", "id": "1708914259756036", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491823802_1708914266422702_1301336280523144377_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GWzcBOgUEt4Q7kNvwEWt9jn&_nc_oc=Adme3gO74bQfAKaYQDBfi-SRX_4VH_6UvoUJ_yuuTYYjGorRiFauabnkP0tx899hb0A&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfzDgRxOstsclE-7F1HcncW85NSvZTc2QEjvGGdjJmngNg&oe=69B02585"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "BATTLECRAFTER VR", "keywords": ["warfare", "restoration", "history", "simulation", "crafting"], "long_description": "# \u2694\ufe0fBecome the Master Restorer\u2694\ufe0f \nIn **BattleCrafter VR**, you become the galaxy\u2019s leading restoration specialist, tasked with bringing legendary weapons, armor, and battle techniques from humanity\u2019s past back to life. The future of the colossal Marsian War Museum\u2019s exhibitions depends on your skill and precision.\n\n__\n# \ud83d\udee0\ufe0fCraft, Upgrade, and Evolve\ud83d\udee0\ufe0f\nEach **mission** is a new assignment: restore four key historical **artifacts** \u2013 from ancient **swords**\ud83d\udde1\ufe0f to modern **rifles**\ud83d\udd2b \u2013 and install them inside massive multimedia domes that recreate iconic battles. The better your craftsmanship, the higher your reward, which you can reinvest into advanced workshop upgrades like 3D printers, magnetic assembly platforms, and laser welding tools.\n\n__\n# \ud83c\udf93History Reimagined in VR\ud83c\udf93\n\u2694\ufe0f**BattleCrafter VR**\u2692\ufe0f combines realistic hands-on simulation with an educational journey through the evolution of warfare. Discover how strategies, weapons, and technologies changed over centuries \u2013 all in deeply immersive VR. Every task demands focus and precision, and completing a perfect restoration is immensely satisfying.\n\n# \ud83e\ude90Welcome to the year 2125, on Mars \ud83e\ude90\u2013 where the history of war meets the future of technology. ", "short_description": "Step into the year 2125 as the galaxy\u2019s top restoration specialist and bring humanity\u2019s greatest battles back to life. Rebuild weapons, armor, and war artifacts from ancient swords to modern rifles, then showcase them in Mars\u2019 massive War Museum domes. Use futuristic tools, earn rewards for precision, and discover how warfare evolved through immersive VR missions. Each assignment takes you to a new era and a new challenge."}]}, "developer_name": "VR Factory Games S.A.", "developer_privacy_policy_url": "https://vrfactory.pro/our-games/battlecrafter-vr/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "VR Factory Games S.A.", "support_website_url": null, "website_url": "https://vrfactory.pro/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9307969755933916"}}]}, "scheduled_offers": {"count": 8, "nodes": [{"status": "PUBLISHED", "id": "783245517666426"}, {"status": "PUBLISHED", "id": "883364347987645"}, {"status": "PUBLISHED", "id": "783612808071527"}, {"status": "PUBLISHED", "id": "24993994383605474"}, {"status": "PUBLISHED", "id": "2558187251233589"}, {"status": "PUBLISHED", "id": "844695574638145"}, {"status": "PUBLISHED", "id"
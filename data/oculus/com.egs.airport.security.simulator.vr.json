id": "1240599264267868", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491824671_1240599267601201_8974050697945188571_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lngPMC6gS8IQ7kNvwF0fXMp&_nc_oc=Adqy399J1YEqxumb3IdcnhKq3Z_zYJf8Zoicgc8ErU7_q28WlS2JOvawgvdxGpO5GVk&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBUD7MATLhK2VWRhFBwWqGMy6vvs_N9FFWjWBom0U8lZA&oe=6A635EDD"}, {"file_name": "1.png", "id": "2154708848690831", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491827626_2154708852024164_6986791482020423831_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CAs3BvC5BKYQ7kNvwHZnlSK&_nc_oc=AdrpNQo0TGfPCPj8ErSsfMmxtv-s0bgEAgVw-uIYTYAlWFENX5osCirLdl_gmMAjDCs&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCxJaPfGs0XdUcpDrnGG4TJ1_SJdBTM9ho8iu_3jYirwA&oe=6A637463"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Airport Security Simulator VR", "keywords": ["airport", "job", "simulator", "inspector", "security"], "long_description": "Airport Security Simulator is an immersive VR experience where you take on the role of an airport security officer responsible for protecting the airport and ensuring passenger safety.\n\nEvery passenger must pass through your checkpoint before boarding their flight. Carefully verify documents, scan passengers for suspicious items, inspect luggage, and monitor health vitals to detect potential threats or medical risks.\n\nYour job is to ensure that only safe and authorized travelers are allowed to continue their journey.\n\n\u2708\ufe0f Experience the Full Airport Security Process\n\nPassengers will go through multiple stages of inspection, and every step requires your attention and decision-making skills.\n\n\ud83d\udec2 Passport & Boarding Pass Check\nVerify passenger identity and confirm their boarding pass before allowing them to proceed.\n\n\ud83d\udd0e Passenger Body Scanner\nUse a full body scanner to detect hidden or prohibited items.\n\n\ud83d\udcbc Luggage Inspection\nOpen briefcases and bags to inspect items and identify suspicious objects.\n\n\u2764\ufe0f Health & Vital Monitoring\nCheck passenger vitals to identify medical emergencies or possible infections.\n\n\u2705 Security Approval Decision\nMake the final call \u2014 approve the passenger to travel or stop them from boarding.\n\n\ud83d\udc6e Can You Keep the Airport Safe?\n\nAs an airport security officer, every decision matters. A small mistake could allow a threat to pass through the checkpoint.\n\nStay alert, inspect carefully, and protect the airport.\n\nWelcome to Airport Security Simulator.", "short_description": "Step into the role of an airport security officer in VR. Check passports, scan passengers, inspect luggage, monitor health vitals, and decide who is cleared to fly."}]}, "developer_name": null, "developer_privacy_policy_url": "https://engaginggamesstudio.com/privacy.htm", "developer_terms_of_service_url": null, "publisher_name": "Engaging Games Studios", "support_website_url": null, "website_url": "https://engaginggamesstudio.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "1990104051447093"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26079696761684573"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PUBLISHED", "id": "1381020310538927"}, {"status": "PUBLISHED", "id": "1722410248476031"}]}, "baseline_offer": {"id": "13810203105
ymWNj4YZHnWINik4F7ULo3yU_lKC6Dxf1f9jIK-7yPwG634&_nc_zt=3&_nc_ht=scontent-lhr8-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2CWbXZYQMfD6ICCQtOZ_DwbsikAEf6TFtwNBhvDdv3Wg&oe=69E230BC"}, {"file_name": "3s.png", "id": "4301936623353571", "uri": "https://scontent-lhr8-2.oculuscdn.com/v/t64.5771-25/491819356_4301936626686904_4609015156343029325_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HCBuLPrSegcQ7kNvwFRlV3z&_nc_oc=AdoPMbNlG9btQOq4ckPpInp9LeRKEbhZc05PqY0Fcm5tIUgxQB05daMgkufFB6zZtio&_nc_zt=3&_nc_ht=scontent-lhr8-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3qp5CwFRCuhjR4f-EXXaRX5MMhA0f6dQYE6NNrX88jRg&oe=69E239AF"}, {"file_name": "4s.png", "id": "1632192431533607", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/491821099_1632192434866940_8891024331350784959_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_xw8-Ic3nCEQ7kNvwHQ-y37&_nc_oc=AdqUMYmwrfzlOMkL0je6Mm3QVUsiRpfPFKccNOHh6Mdknx-Em5rwEf_RqY9Lj9f--qQ&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2gmiiLtdX4mIQvxqkMsnm9bODcGavI3XMP3CvMAp2vVA&oe=69E24887"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Airport Security: Spot The Threat", "keywords": ["airport", "job", "simulator", "inspector", "security"], "long_description": "\ud83d\udd0d Every Passenger Is Hiding Something\u2026\n\nCan you spot the threat before it\u2019s too late?\n\nStep into the role of an airport security officer in a high-stakes VR experience where every decision can stop danger \u2014 or let it through.\n\n\u2708\ufe0f Inspect. Detect. Decide.\n\nPassengers line up at your checkpoint \u2014 but not all of them are innocent.\n\nSome carry fake identities.\nSome hide dangerous items.\nSome are nervous for a reason.\n\n\ud83d\udc49 It\u2019s your job to find out why.\n\n\ud83d\udec2 Check Documents \u2014 Spot the Fake\n\nCompare passports and boarding passes carefully.\nOne small mismatch could reveal a fraudulent traveler.\n\n\ud83d\udd0e Scan Passengers \u2014 Find Hidden Threats\n\nUse advanced body scanners to uncover concealed weapons and illegal items.\nStay sharp \u2014 not everything is obvious.\n\n\ud83d\udcbc Inspect Luggage \u2014 Nothing Is Safe\n\nOpen bags and examine every item.\nSuspicious objects can be hidden in plain sight.\n\n\u2764\ufe0f Monitor Vitals \u2014 Detect the Risk\n\nCheck passenger health indicators to identify hidden medical dangers or infections.\n\n\u2705 Approve\u2026 or Stop Them\n\nMake the final call:\n\n\u2714 Allow safe passengers through\n\u274c Stop suspicious individuals\n\ud83d\udea8 Prevent threats before it\u2019s too late\n\n\u26a0\ufe0f One Mistake Changes Everything\n\nLet the wrong passenger through\u2026\nAnd the consequences are on you.\n\n\ud83d\udc6e Are You Ready to Take Control?\n\nStay alert. Trust your instincts.\nProtect the airport at all costs.", "short_description": "Spot hidden threats, catch fake identities, and stop dangerous passengers in this intense VR security experience. Every decision matters."}]}, "developer_name": null, "developer_privacy_policy_url": "https://engaginggamesstudio.com/privacy.htm", "developer_terms_of_service_url": null, "publisher_name": "Engaging Games Studios", "support_website_url": null, "website_url": "https://engaginggamesstudio.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "1008279844328894"}, {"id": "821934236779161"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "2643603727
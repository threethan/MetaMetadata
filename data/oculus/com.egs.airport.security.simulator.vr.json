zyXPLo9TaE1EuX200&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAdacPSagVI9gSjtLPjSF3d3fU4lALhzs8mPtLW2d_LKA&oe=6A63534A"}, {"file_name": "2s cleaned.png", "id": "1659797428774520", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491819859_1659797435441186_8826193583674537802_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6_5KCWbckJkQ7kNvwGKmF-L&_nc_oc=AdqMEf9e5EE_mOCGAEBn0G0WdJ_ATJWMXzOx-Sb3G6PG8816X0lDUK0Mmi0323NPGfA&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAj7lUHKUwNK1RPIa2Y1x-8oCMJ1h171h0WmRdRdJeoUg&oe=6A6363BC"}, {"file_name": "3s.png", "id": "4301936623353571", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491819356_4301936626686904_4609015156343029325_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iHTFGWkJtfUQ7kNvwFG2NVu&_nc_oc=Adqq0ovl3SOH-XmDXR9BLL9yth9FUISezGRQhY9FjIoW2-U6FM5ReZCnB9HV0Lo8yv0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCVP7mSlDSbg2cyUuHqFKMHOqbrQyovuu0bJPzJ6CYRJw&oe=6A636CAF"}, {"file_name": "4s.png", "id": "1632192431533607", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491821099_1632192434866940_8891024331350784959_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bdAglFRdO1AQ7kNvwEFAkXb&_nc_oc=AdpW7RLLL8PxOZ0ZZEGdTNzAEdbC42vTiI_fAafkgyIRsHoXK6jdGP7AjIisj6KACeQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDmWyElS9m07cArP6r8DCz41gP1sr9lLAkBHS4PNnL4vg&oe=6A637B87"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Airport Security Simulator VR", "keywords": ["airport", "job", "simulator", "inspector", "security"], "long_description": "Airport Security Simulator is an immersive VR experience where you take on the role of an airport security officer responsible for protecting the airport and ensuring passenger safety.\n\nEvery passenger must pass through your checkpoint before boarding their flight. Carefully verify documents, scan passengers for suspicious items, inspect luggage, and monitor health vitals to detect potential threats or medical risks.\n\nYour job is to ensure that only safe and authorized travelers are allowed to continue their journey.\n\n\u2708\ufe0f Experience the Full Airport Security Process\n\nPassengers will go through multiple stages of inspection, and every step requires your attention and decision-making skills.\n\n\ud83d\udec2 Passport & Boarding Pass Check\nVerify passenger identity and confirm their boarding pass before allowing them to proceed.\n\n\ud83d\udd0e Passenger Body Scanner\nUse a full body scanner to detect hidden or prohibited items.\n\n\ud83d\udcbc Luggage Inspection\nOpen briefcases and bags to inspect items and identify suspicious objects.\n\n\u2764\ufe0f Health & Vital Monitoring\nCheck passenger vitals to identify medical emergencies or possible infections.\n\n\u2705 Security Approval Decision\nMake the final call \u2014 approve the passenger to travel or stop them from boarding.\n\n\ud83d\udc6e Can You Keep the Airport Safe?\n\nAs an airport security officer, every decision matters. A small mistake could allow a threat to pass through the checkpoint.\n\nStay alert, inspect carefully, and protect the airport.\n\nWelcome to Airport Security Simulator.", "short_description": "Step into the role of an airport security officer in VR. Check passports, scan passengers, inspect luggage, monitor health vitals, and decide who is cleared to fly. Spot hidden threats, catch fake identities, and stop dangerous passengers in this intense VR security experience. Every decision matters."}]}, "developer_name": null, "developer_privacy_policy_url": "https://engaginggamesstudio.com/privacy.htm", "developer_terms_of_service_url": null, "publisher_name": "Engaging Games Studios", "support_website_url": null, "website_url": "https://engaginggamesstudio.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "contex
295321", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/39036608_3289431274628654_5687486781159746094_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IZJNx4XosEAQ7kNvwGrh8Pr&_nc_oc=Adpu3JTMYklms4ypitaXCs9nYDnsFS7f-4evQHl2RJFb31Ft2KdAm7wgN57SBwzga5Q&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAub_gFB7OABSTyJkwkT8Gw1VQYPbAtoh891TpcnndxNA&oe=6A564639"}, "display_name": "VXRLabs", "keywords": [], "long_description": "VXRLabs is a cutting-edge virtual reality educational lab application that combines the best of both worlds - education and entertainment. Designed to be multiplayer and synchronous, the app offers a unique and immersive learning experience unlike any other. In VXRLabs, students can enter the metaverse and engage with educational content in a fun, interactive and engaging way.\n\nWith its multiplayer capability, VXRLabs provides an opportunity for students to collaborate and connect with their peers from around the world, creating a truly global learning community. The synchronous nature of the app ensures that students are able to learn in real-time, with the support and guidance of their teachers and classmates.\n\nIn VXRLabs, students will be able to explore and interact with virtual environments, simulations and educational games that have been specifically designed to engage their minds and challenge their skills. The app leverages the latest advances in virtual reality technology to bring the content to life, and to create an environment that is both visually stunning and intellectually stimulating.\n\nWith its focus on learning through play, VXRLabs is perfect for students of all ages and backgrounds. Whether you are a student looking to improve your grades, or a teacher looking to enhance your lessons, VXRLabs is the ideal educational tool for you. So, enter the metaverse today, and start your journey to educational success with VXRLabs!", "short_description": "VXRLabs is a cutting-edge virtual reality educational lab application that combines the best of both worlds - education and entertainment. Designed to be multiplayer and synchronous, the app offers a unique and immersive learning experience unlike any other. In VXRLabs, students can enter the metaverse and engage with educational content in a fun, interactive and engaging way."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.victoryxr.com/policies/", "developer_terms_of_service_url": null, "publisher_name": "VictoryXR", "support_website_url": null, "website_url": "https://www.victoryxr.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "1905209433156638"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "504700521817588"}]}, "baseline_offer": {"id": "504700521817588"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1678770000, "status": "PUBLISHED", "id": "504700521817588"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "27546360184983724", "version": "2.3.1.1"}, "id": "890437938671888", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "6140788979300821", "is_concept": false, "latest_released_binary":
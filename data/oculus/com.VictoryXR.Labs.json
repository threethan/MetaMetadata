t=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAkR2JzV4qwn2OCjRJpItWz6OJUH86XiMpSzSS8vtWxEQ&oe=6A564503"}, {"file_name": "4.png", "id": "541106781574493", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/39031530_541106784907826_5835082623799534278_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nZNva5N1rgUQ7kNvwFhsF-b&_nc_oc=AdqFLohp3JVaiEeHb-cQHgIvDC0k8l2vrIKeoyRiCQ-n96ItQzSYe-Ob2jj0JqODYDU&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCUJpwnE3VBDhT34g76vlYGWlEgPSYHVaCDeY3FJJSfRw&oe=6A56521F"}, {"file_name": "3.png", "id": "1042076224079081", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/75507165_1042076227412414_3830714875381655073_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=X2t8w48ZBlYQ7kNvwFP-XN5&_nc_oc=Adp8RXohznGCagz6SDJxlP29x7aSwRpVCDHrRe12R9kmtWUqV5N8ZWbbQX7tp0BFCGw&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAPT9mYiZgdfpsjgGzCxN4F9XxV7sB796TsQq8uku0GOg&oe=6A5646D1"}, {"file_name": "Screenshot (101).png", "id": "7890342664417137", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/38974827_7890342671083803_453965033696878370_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=51z5XNXkNHsQ7kNvwGr_NOH&_nc_oc=AdraoEd4eXhW3vos28I24dfIZ8w0FSTxORBd5GxpQvM_aJwdE3HFwZ3vblwBj6w55Fw&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCxK8qcqwNh3qPr0l912_mmBjC7EdRcgPS2rasHClhMYg&oe=6A562C92"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VXRLabs Video Thumbnail-02.png", "id": "421785453650022", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/38974827_421785456983355_6542445322438488438_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y49l5aYBFWUQ7kNvwEfkceW&_nc_oc=AdqUw-9pe7GAJvomHoTa85K8vWuticP47gkNsAgXp1sZym73QsGIHQgX5e2EQJCy6hU&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAO7Sz_t5km3Fw8uovfzLOKJ5B8vTMuiHk758tRRj3cLg&oe=6A5630AD"}, "display_name": "VXRLabs by VictoryXR", "keywords": ["victoryxr", "education", "biology", "chemistry", "school"], "long_description": "VXRLabs is a 3D spatial learning platform accessible on PCs and Meta Quest headsets. It offers a wide range of immersive content, including:\n1. **Field Trips:** Explore 150+ locations like the Great Wall, Iceland, the Redwood forests, and much more.\n2. **Chemistry:** A robust virtual lab comparable to a $100,000 real-world setup.\n3. **Biology:** Includes animal dissections, cadaver exploration, and more.\n4. **English & Literature:** Gamified exploration books like To Kill a Mockingbird and The Great Gatsby.\n5. **History:** Visit sites like Thomas Edison\u2019s cabin, the Edmund Pettus Bridge, and the Berlin Wall.\n6. **Career & Technical Education:** CTE training in trades, tech, healthcare, and life sciences.\n7. **CSI:** Conduct crime scene investigations in a multi-student environment.\n8. **Creator Space:** Students build their own VR worlds, unleashing their creativity.\n9. **Entrepreneurship & Business:** Learn from the stories of Edison, to an advanced logistics simulation for universities.\n\n\n**Key Features:**\n- Accessible on both PCs and VR headsets\n- Created by teachers, the lessons are focused and educational\n- Synchronous and asynchronous. Some lessons can have many students, while others are solo\n- Robust license management so a group of students can be nestled under the appropriate educator or institution\n- A 3D AI Creator tool for deployment to web browsers for complete accessibility\n\n**Bottom Line:** Why buy many immersive education applications when the VictoryXR all-in-one application covers all of what you will need?", "short_description": "VXRLabs is a 3D learning platform accessible on Meta Quest headsets. It offers immersive content, including 150+ global field trips, virtual chemistry and biology labs, gamified literature and history experiences, CTE training, crime scene investigations, and VR world creation.\n\nKey features include educator-focused lessons, synchronous and asynchronous learning, robust license management, and a 3D AI Creator tool for web deployment."}]}, "developer_name": "VictoryXR", "developer_privacy_policy_url": "https://www.victoryxr.com/policies/", "developer_terms_of_service_url": null, "publisher_name": "VictoryXR", "support_website_url": null, "website_url": "https://www.victoryxr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "1043107547362485"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "26133423189610771"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/54809986_1736196303857096_163355163059031908_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A9ocefzj_NQQ7kNvwEj5Bvg&_nc_oc=AdrHXjQ3HuSpu6MjPThDDoqVQbxelQzonq3Jiv_keJxZMKdp-FRuIWlfslUwCt4SeR0&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCStRQ1XWnnQDl_InuESqQRLbrcaXGsYYs3ohLDOqNwWA&oe=6A563DC3"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "VXRLabs by VictoryXR", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_name": "Hands-On Training", "id": "514087707868786"}, {"topic_name": "Learning", "id": "1043107547362485"}], "release_date": 1678770000, "lastRevision": {"nodes": [{"id": "6140788982634154", "release_type": "SCHEDULED", "a
9027943664113596_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uRO26pHdL0QQ7kNvwHQc68O&_nc_oc=AdpFi1y7kIoNmTep0w2DpK0rfih8WuF9NH6128ecLrn_xQuQ2UTsdzIwYKmyFFkTfVs&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQRk2Qv_X2FGO2Xx6gntR82fM9AkxyPQV44uqXfQzPwRQ&oe=6AFB2A39"}, {"file_name": "screenshot_2.png", "id": "1093561950116278", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499303471_1093561956782944_1711273838901820704_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vPK2ORrfongQ7kNvwHAlImI&_nc_oc=Adotlb4Atmnn9PBnrM1L1kKzSVvSafwf6Ev9a9lGHKxc9Y4nlBo5yGwzqEmelz2sAu0&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ9q3axj1hu6rkoQhiSWg4vHHRhNaVm5djiI1_ZCLv4PA&oe=6AFB1E37"}, {"file_name": "screenshot_3.png", "id": "1684248466694192", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499312267_1684248470027525_1179739328174651329_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Rq-lI76Ok-4Q7kNvwEvFEKJ&_nc_oc=Adp8uMgn6acs7rwj4g8KGFUEGPbmOpjHpjoaYtcGcx4H40wRUjSgx6DhOP6uoRBpcYE&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQRYBTokumMUapnwgNUTm_jHH7NIEX1f6K2ir_Y51lLXA&oe=6AFB4BDC"}, {"file_name": "screenshot_4.png", "id": "1640605800982321", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/753328995_1640605804315654_3605595971539850929_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8IY-uT8iS-EQ7kNvwG_SSVe&_nc_oc=AdqNcseQIqgiI0khKqHKeUPNK2GZM4u_3HgFAxScsFUj1xtr5-LbnNRMqpyiXEDVr3s&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRYy7iuepRAeym9kyJQdoBhnXBjsE5UgmL2JblRYLiTMQ&oe=6AFB2710"}, {"file_name": "screenshot_5.png", "id": "1336229955114039", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/499311606_1336229958447372_6964389978607666586_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oC3kehDMv9sQ7kNvwGXza8p&_nc_oc=AdqPGHTc_hV1T_unoalBSRPiLxcRYMgfQN7EQDwT8x-jqvV5lyid2Au6Tqebo2LHqXk&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRJiSQ3AwbNsDapwKb_LKU5AyVRE0bW7hVakdrWbI1cOw&oe=6AFB2B04"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_cover.png", "id": "1117199897374740", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/499303976_1117199900708073_401369004790633654_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cfk5Nc4JJskQ7kNvwG29cMA&_nc_oc=AdoFfyylMQslyrAlq7pqmhzNSIab6Y-sTjV2IJub2LUBqDTKwusrpabHuxUnlsMXKwA&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQleDiFr4wZ-bkhLmh7qlU8sCTXOWx8z1Tvm80e40XZWg&oe=6AFB2FFE"}, "display_name": "Driving Simulator Malibu", "keywords": ["driving", "car", "simulator", "malibu", "racing"], "long_description": "The dream drive, from the driver's seat - in Malibu.\n\nTHE CAR\nA V12 sports car with a race cockpit: a racing wheel, bucket seats, a roll cage, shift lights across the dash and a live display behind the wheel. Grip the wheel, work the gear stick and pull the handbrake with your own hands - or drive with the joysticks.\n\nA REAL 6-SPEED MANUAL\nMove the stick through a real H-pattern: 1 3 5 up top, 2 4 6 underneath, reverse far right. Rev it to the shift lights and snap the next gear in. Prefer to cruise? Switch to automatic.\n\n50 MILES OF CALIFORNIA\nThe Pacific Coast Highway past Malibu and the Santa Monica Pier, the tunnel onto the 10, the 405 over the Sepulveda Pass past the Getty, the 101 through the Valley, then Malibu Canyon down to the ocean.\n\nROAD EVENTS\nSeven events on real roads, from the PCH Sunset Sprint to The Full Loop. Quick-travel to the start line, watch the lights count you down and race for gold. Your best run comes back as a ghost car to beat.\n\nSPEED TRAPS AND RUSH HOUR\nSix speed cameras record your top speed. In Rush Hour, thread through heavy traffic - close passes build your combo, a crash loses it.\n\nSUNSET, DAY AND NIGHT\nGolden hour over the Pacific, bright California sun, or the city lit up after dark.\n\nMALIBU FM\nAn original soundtrack on the car radio.\n\nPlus paint colours, interior trims, twenty achievements, career ranks and a map with quick travel.", "short_description": "Slide into the race seat of a V12 sports car and drive a 50-mile loop of Southern California. Cruise the Pacific Coast Highway at sunset with the ocean on your right, blast through the tunnel onto the Santa Monica Freeway, climb the 405 over the Sepulveda Pass, run the 101 through the Valley and carve Malibu Canyon back to the coast. Shift a real 6-speed manual with your own hand, race road events against your own ghost, hit the speed traps and weave through rush hour."}]}, "developer_name": "Citiview Studios", "developer_privacy_policy_url": "https://citiview-games.pages.dev/drivingsimulatormalibu/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Citiview Studios", "support_website_url": null, "website_url": "https://citiview-games.pages.dev/drivingsimulatormalibu/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "2776542286000603"}, {"id": "1990104051447093"}, {"id": "673385183287495"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1387216041141598"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "2168207930768751"}]}, "baseline_offer": {"id": "2168207930768751"}, "is_app
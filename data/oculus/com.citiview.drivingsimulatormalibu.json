Zo2K2o3AB1Rp-P6I&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRzO5SDyNHj54XfYuoZIxHmIBcVuvD6MQfxoiY2gzxpfg&oe=6AF1D91C"}, {"file_name": "screenshot_4.png", "id": "1640605800982321", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/753328995_1640605804315654_3605595971539850929_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MREX_6J-cVsQ7kNvwEpN5HD&_nc_oc=AdqO9edDuZUiMq5hhn8Fm9WtiEtbeML4pXzy8ciRaRoN_fphhA7tHgIub63W22nAO0A&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR41x29-urx2ykr7-8IoBKbnDGU3HhgEhlzhCKnf-Gylw&oe=6AF1EC90"}, {"file_name": "screenshot_5.png", "id": "1336229955114039", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499311606_1336229958447372_6964389978607666586_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MCTwaZBi6I0Q7kNvwFiIfjl&_nc_oc=AdpuSWgfzWRSbsVwaz5Yp1ZRejXmmXOASLYnqhKKXFiAJtl-Yo7s59u1GxAliOoxXQ8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSwFzfIV83lJmL6cPk087zqXI5BgDol278RiXFDz4dcfA&oe=6AF1F084"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_cover.png", "id": "1117199897374740", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499303976_1117199900708073_401369004790633654_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OSlcZ0JY9ygQ7kNvwHPSSVE&_nc_oc=AdpiEhj_hahrdAV3eecM02u03xnT7YTZ1cmOgBkyQD2RBRkyqjMI1oO3aFkRSFbViu4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQjFAMpsg2Sv0mnDT1SMlLs7w81c9NPq9wz6kd77gRgTw&oe=6AF1F57E"}, "display_name": "Driving Simulator Malibu", "keywords": ["driving", "car", "simulator", "malibu", "racing"], "long_description": "The dream drive, from the driver's seat - in Malibu.\n\nTHE CAR\nA V12 sports car with a race cockpit: a racing wheel, bucket seats, a roll cage, shift lights across the dash and a live display behind the wheel. Grip the wheel, work the gear stick and pull the handbrake with your own hands - or drive with the joysticks.\n\nA REAL 6-SPEED MANUAL\nMove the stick through a real H-pattern: 1 3 5 up top, 2 4 6 underneath, reverse far right. Rev it to the shift lights and snap the next gear in. Prefer to cruise? Switch to automatic.\n\n50 MILES OF CALIFORNIA\nThe Pacific Coast Highway past Malibu and the Santa Monica Pier, the tunnel onto the 10, the 405 over the Sepulveda Pass past the Getty, the 101 through the Valley, then Malibu Canyon down to the ocean.\n\nROAD EVENTS\nSeven events on real roads, from the PCH Sunset Sprint to The Full Loop. Quick-travel to the start line, watch the lights count you down and race for gold. Your best run comes back as a ghost car to beat.\n\nSPEED TRAPS AND RUSH HOUR\nSix speed cameras record your top speed. In Rush Hour, thread through heavy traffic - close passes build your combo, a crash loses it.\n\nSUNSET, DAY AND NIGHT\nGolden hour over the Pacific, bright California sun, or the city lit up after dark.\n\nMALIBU FM\nAn original soundtrack on the car radio.\n\nPlus paint colours, interior trims, twenty achievements, career ranks and a map with quick travel.", "short_description": "Slide into the race seat of a V12 sports car and drive a 50-mile loop of Southern California. Cruise the Pacific Coast Highway at sunset with the ocean on your right, blast through the tunnel onto the Santa Monica Freeway, climb the 405 over the Sepulveda Pass, run the 101 through the Valley and carve Malibu Canyon back to the coast. Shift a real 6-speed manual with your own hand, race road events against your own ghost, hit the speed traps and weave through rush hour."}]}, "developer_name": "Citiview Studios", "developer_privacy_policy_url": "https://citiview-games.pages.dev/drivingsimulatormalibu/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Citiview Studios", "support_website_url": null, "website_url": "https://citiview-games.pages.dev/drivingsimulatormalibu/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id":
erience with shooting and earn some cash to buy bigger guns, you can go on missions to take down much more dangerous prey that won't just run away at the sight of your pistol! Happy hunting!", "short_description": "Embark on a great adventure to hunt down some prehistoric beasts!"}]}, "developer_name": "VDimension", "developer_privacy_policy_url": "https://www.vdimension.co.uk/privacy", "developer_terms_of_service_url": "https://www.vdimension.co.uk/terms-of-service", "publisher_name": "VDimension", "support_website_url": null, "website_url": "https://www.vdimension.co.uk/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ACTION", "DINOSAURS", "FIGHTING", "SHOOTER", "ADVENTURE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GEAR_VR_CONTROLLER", "TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "684637092566779"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/11162700_220257268515587_6992393713519427584_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DltDZeB_5-EQ7kNvwGVfrbZ&_nc_oc=AdqjryhGmLdcs6zn06EIb2CfVNzUyGg8fzaJnPvy6nEtTHf4KQsItsPcwjRVnZj1bXg&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFb2w5w_zGKXYDGqSKDngBJ4n38NT4B-nnmHUcr5ZHkvw&oe=6A8D8573"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Dinosaur Hunter", "platform": "ANDROID", "context_category": null, "context_topics": [], "release_date": 1513271242, "lastRevision": {"nodes": [{"id": "1617094575015940", "release_type": "SCHEDULED", "administration_status": "APPROVED"
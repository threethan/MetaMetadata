rlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j_LcgsrEcgoQ7kNvwGRi98j&_nc_oc=AdpMWgEpAQobYRoPNowFTi-2PBifaqPvhd5uhqGmAse3xZFAHh3squtZLHGXEdIyOD4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQR7VVPsSqeightxPTJAe0P_hXqjcqQ0KbVtrlLpqzTLDA&oe=6B0C7525"}, {"file_name": "2_sort.png", "id": "2288023258710537", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/908835868_2288023262043870_4290063126748269690_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J-jYkCLvj-MQ7kNvwHuGS-p&_nc_oc=AdpBvWsy9rXFEWWeQA2bwwj8n23IR99HuhYI16L_fIO0DbB9IE2_A7y1ZUPxUv6yha8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSVuBvCBU5XNQY2PmNiBRijssJS0XyNyfphdNHpN49DRQ&oe=6B0C6585"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Dise\u00f1o sin t\u00edtulo.png", "id": "1115069367909843", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/654961355_1115069371243176_7211050424363525163_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iITu6eND7PEQ7kNvwG6vbmZ&_nc_oc=Adowei1Dpa_cO8uhMVeSgRhys4-3uNfEI4H22YzKbXgFhO9UsD61qRPxfeoB7rCGY1c&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRz2o4WOFNEc0YFTOGIdx_iGgzUJvr-zQ23ayKGTdKeZQ&oe=6B0C7A9D"}, "display_name": "Trash Inspector", "keywords": ["recycling", "sorting", "conveyor", "arcade", "job"], "long_description": "Welcome to your new job at the recycling plant. It sounds simple. It isn't.\n\nTrash Inspector puts you in front of a conveyor belt that never stops. Bottles, cans, newspapers, cardboard, glass jars and the occasional mystery object come rolling toward you, and it's your job to grab each one and send it to the right bin before the belt gets buried.\n\nSORT WITH YOUR HANDS\n\nPick up every item, check what it's made of and throw it into the right container. Plastic, paper, glass and more: every material has its place, and a perfect throw from across the room feels as good as it sounds.\n\nSURVIVE THE WAVES\n\nEvery wave is faster and messier than the last. Keep your head cool, your hands quick and your bins clean, because mistakes pile up fast.\n\nUPGRADE YOUR PLANT\n\nEarn cash for every clean shift and spend it in the shop to improve your plant and take on bigger, crazier waves.\n\nFEATURES\n\n- Fast, physical sorting gameplay built for VR hands\n- Wave-based challenge that keeps ramping up\n- Bright, colorful low poly recycling plant\n- Shop with upgrades to grow your plant\n- Pick-up-and-play sessions, perfect for short breaks\n\nGrab your gloves. The belt is already moving.", "short_description": "Grab, sort and throw your way through a chaotic recycling plant! Trash pours down the conveyor belt in faster and faster waves: plastic, paper, glass and more. Toss every item into the right bin before it piles up, earn cash and upgrade your plant in this frantic, hands-on VR sorting game."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1l3gIGLoUfPkIz9t8Leh57z1u7Y3Dife2TikUbY4QVwU/edit?usp=drive_link", "developer_terms_of_service_url": null, "publisher_name": "Chema Luque", "support_website_url": null, "website_url": "https://beacons.ai/chemaluque", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "es"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "40351796897767484"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.
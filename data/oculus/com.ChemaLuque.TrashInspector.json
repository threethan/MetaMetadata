=4BxZtYuEWCoQ7kNvwE2hvh2&_nc_oc=AdqbS6un2DO6awk185dYOYsIzho9lebf_LviInYr762GOtqEDhV2QgvBNHK55TK4ovM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWSvBZLxdrZxmHd9NTQ67nNQevnVTrHVALaR5J45AVpMA&oe=6B0F0B97"}, {"file_name": "layered_icon_composited.png", "id": "2014069079253200", "image_type": "APP_IMG_LAYERED_ICON_512", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/595129854_2014069082586533_7990176744198578786_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=t8gE9eTlPr0Q7kNvwHwdPm6&_nc_oc=Adrq-loEoS-sKmyJ7nEsZpaZXR8_kQl6dD06dPU-hYQUcL7SWw_ka8zCWd5JO9iUKgI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVP45Q3jM_v7cB6drF2GFsFbhk7XvfiFqqxU-IUY7pvVw&oe=6B0EFD47"}, {"file_name": "Dise\u00f1o sin t\u00edtulo (2).png", "id": "1826679041683386", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/595119480_1826679045016719_5835265684303815842_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1oC624wt0j0Q7kNvwHimDFX&_nc_oc=AdqT63X2bYUjM-j-U-Qj1SKFXp4A621CVuYaCfYBBlogjWwANMZbBLiArVxWe3BQIHc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVjQYujvw9RrufNP-dLlOEJuwhvKEtdJ9ybiTIFzayAuQ&oe=6B0F20EA"}, {"file_name": "uba_APP_IMG_COVER_PORTRAIT.png", "id": "1825680191933152", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/596068480_1825680195266485_2663807149138573427_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f9wnZyR9itgQ7kNvwGASo5d&_nc_oc=AdpMVyRDoWUrbcu9Yz5qUv-KBWmZwgXZGWdDx0YdNcc6RDJmnWokZbGMVQGlmp-heFM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQX0ogobmXNHLKkKsjSA8nNTQ4JuzS_FSDvDLzXVnJ_uVw&oe=6B0EF62F"}, {"file_name": "Imagen de ChatGPT 4 oct 2026, 10_36_15.png", "id": "1735192594205375", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/596168449_173519260420537
oculuscdn.com&_nc_ss=7f30f&oh=00_AQXCxuc099fYapy_n8Q5Qno8Yy4uxp9YXi2A_KQZ0aggag&oe=6B0F0885"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Dise\u00f1o sin t\u00edtulo.png", "id": "1115069367909843", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/654961355_1115069371243176_7211050424363525163_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yCVcHRmeRwsQ7kNvwGh88t3&_nc_oc=AdpoHnKeVIgnxHVC7Hvn3OqqvB_EgGwR9JQ7Xo3InZ6ka27ne7iKiXNeWPZmvFLli2M&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWHJ-Y7RXmapkCIMHDgD827YL-fn6Lnm2Io5D83BtO4gg&oe=6B0F1D9D"}, "display_name": "Trash Inspector", "keywords": ["recycling", "sorting", "conveyor", "arcade", "job"], "long_description": "Welcome to your new job at the recycling plant. It sounds simple. It isn't.\n\nTrash Inspector puts you in front of a conveyor belt that never stops. Bottles, cans, newspapers, cardboard, glass jars and the occasional mystery object come rolling toward you, and it's your job to grab each one and send it to the right bin before the belt gets buried.\n\nSORT WITH YOUR HANDS\n\nPick up every item, check what it's made of and throw it into the right container. Plastic, paper, glass and more: every material has its place, and a perfect throw from across the room feels as good as it sounds.\n\nSURVIVE THE WAVES\n\nEvery wave is faster and messier than the last. Keep your head cool, your hands quick and your bins clean, because mistakes pile up fast.\n\nUPGRADE YOUR PLANT\n\nEarn cash for every clean shift and spend it in the shop to improve your plant and take on bigger, crazier waves.\n\nFEATURES\n\n- Fast, physical sorting gameplay built for VR hands\n- Wave-based challenge that keeps ramping up\n- Bright, colorful low poly recycling plant\n- Shop with upgrades to grow your plant\n- Pick-up-and-play sessions, perfect for short breaks\n\nGrab your gloves. The belt is already moving.", "short_description": "Grab, sort and throw your way through a chaotic recycling plant! Trash pours down the conveyor belt in faster and faster waves: plastic, paper, glass and more. Toss every item into the right bin before it piles up, earn cash and upgrade your plant in this frantic, hands-on VR sorting game."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1l3gIGLoUfPkIz9t8Leh57z1u7Y3Dife2TikUbY4QVwU/edit?usp=drive_link", "developer_terms_of_service_url": null, "publisher_name": "Chema Luque", "support_website_url": null, "website_url": "https://beacons.ai/chemaluque", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "es"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "40351796897767484"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PUBLISHED", "id": "1121821294058648"}, {"status": "PUBLISHED", "id": "1489047056403729"}]}, "baseline_offer": {"id": "1489047056403729"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1796760000, "status": "PUBLISHED", "id": "1121821294058648"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "40237477749199400", "version": "1.0"}, "id": "977882804594937", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": 
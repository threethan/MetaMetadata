": "1355496559717499", "locale": "en_US", "screenshots": [{"file_name": "2-glaucoma.png", "id": "1626023958880301", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491823259_1626023962213634_9203125755874718148_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KAdRcSmnIiYQ7kNvwHnzAMc&_nc_oc=AdrzF6Xiu-DAhIqrFT1mNukWnseDtSNAWYLgBM2GcAq68UeIrW_zwXj2wzqXS1BmCk8&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOTUddGO2xk_gu9BrC2a2A0YJSghKuZDePTFuKzEfZFjQ&oe=6ACCE8F8"}, {"file_name": "5-short-sight.png", "id": "1098829562737581", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491821704_1098829566070914_9015251957043414955_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ivKRcbTZMJkQ7kNvwE5ndin&_nc_oc=AdoWAB9TIKO0E-9U8BmA-TUlTXI7coMEYc1UghVkq06G4SjAhTUPZ5E8VlgSRbYUDik&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNfGHJHFJ1SYvsUBQxTlZy98OCJ9SrbpyPo7Iby6SHOpg&oe=6ACCEEC1"}, {"file_name": "3-macular.png", "id": "1085043174266183", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491823366_1085043180932849_2241775312523508159_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9pvvnP0OxmoQ7kNvwGfTygY&_nc_oc=AdoAX0HhdQoPMby9o8Zj5X6HQ_ZXHXyBZeriTh5iznafmpNp2guC-ePgUb8dg11UwNA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPELYwRrMlW179_zRAuMTIIWbR6o72tflWtTb9dorMUQA&oe=6ACCF820"}, {"file_name": "4-cataract.png", "id": "1639090274574775", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491823940_1639090277908108_8723184674625913725_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wdRY0Efq0rQQ7kNvwH4QE9p&_nc_oc=AdqnnNlIW4GM701ss40ZakUR18HpSgrg69HRbvdZS5LCYqPMMebzVqN4U3UZxRAQrSo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPb4PPycZQeuVHDWeGgwWf0pzpYgNMedZ1tvjPnY_nguw&oe=6ACCEB82"}, {"file_name": "1-colour.png", "id": "1097617029311924", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491821796_1097617032645257_3702885578162111283_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iv2DDUIO4CsQ7kNvwHOQ54p&_nc_oc=AdoovFrqirYYF33pKo0A6gq11piZGdHnni8ZgvvslMP8TPGq8S0yBQ1EwA2bl5dXhyk&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMBzFf4T-fD58L7RVJQpI34-4LaFVup_DjtnLOunEdmKA&oe=6ACCEEDE"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "pour", "keywords": ["accessibility", "a11y", "inclusion", "simulation", "blindness"], "long_description": "pour is an educational tool. It shows how the world in front of you can fail someone: the sign that cannot be read, the red and green that look the same, the button a shaking hand cannot hit.\n\nLook at your own room, your own screen, your own product:\n\n- Colour vision: red-green and blue-yellow deficiencies and full colour blindness, drawn on the headset's own passthrough so the room stays sharp.\n- Sight loss: tunnel vision, central loss, half-field loss, floaters, cataract, double vision and more.\n- Low vision: blur that follows depth, so near-vision loss blurs what is near and short sight blurs what is far. Low contrast, low light, glare and an older eye.\n- Hands: tremor, drift and spasm on the pointer.\n- Hearing: tinnitus, a ringing that is not in the room.\n\nEvery simulation runs at mild, moderate or severe, or anywhere between on a dial. Simulations that can make you feel unwell ask first. Hold a grip to see the real room and compare.\n\nThese are stand-ins for problems, not for people. Nobody sees, hears or feels exactly this: every condition is a range. pour is not a medical device and diagnoses nothing.\n\nCamera images and depth stay on the headset: never stored, never sent. No account, no adverts, no tracking. Non-profit, and free at pour.dev.\n", "short_description": "See your room the way it can fail someone. pour lays simulations of colour blindness, sight loss, low vision, tremor and tinnitus over the real world through the headset's own passthrough, each at mild, moderate or severe, with the share of people each one stands for. Built for designers, developers, teachers and anyone who makes things other people have to use. Free, with no account and nothing sent anywhere."}]}, "developer_name": null, "developer_privacy_policy_url": "https://pour.dev/quest/privacy/", "developer_terms_of_service_url": null, "publisher_name": "pour", "support_website_url": null, "website_url": "https://pour.dev/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "478089301798119"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1328406457020875"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1433316128695526"}]}, "baseline_offer": {"id": "1433316128695526"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1790001240, "status": "PUBLISHED", "id": "1433316128695526"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1368598949668292", "version": "1.3.0"}, "id": "1385974493700087", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1328406453687542", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1368598949668292"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1385974493700087"}]}, "change_log": "Six new guided sessions are played on the card itself: point at it and pull the trigger. Snip the wire puts a lamp out through colour blindness. Press the right one finds the error on a form, the broken printer and a free seat. Steady hands presses a small cross and crowded buttons with a shaking pointer. Faint things finds a pale button and link through low contrast, dim light and a clouded lens. Find it hunts a note on a noticeboard with part of the field of view gone. Which door reads a door number through short sight, uneven focus and ghost images. The Contrast and light session has been removed. Near and far vision loss now blur smoothly.", "created_date": 1791381635, "id": "1368598949668292", "version": "1.3.0", "version_code": 27, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1328406453687542", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1368598949668292"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1385974493700087"}]}, "change_log": "Six guided sessions: Sight loss on an eye chart; Colour, with colour plates and real photographs of red, green, blue and yellow things; Contrast and light; Seeing things; Your own screen, with your own phone; and Hands, pressing buttons with a shaking pointer. The simulations are sorted into eight clearer groups. Text size now enlarges every panel. Test cards no longer show twice in the camera simulations. Clearer help and descriptions, and a fix to the question before simulations that move the room.", "created_date": 1790430306, "id": "1340468199148034", "version": "1.2.0", "version_code": 26, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1328406453687542", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1368598949668292"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1385974493700087"}]}, "change_log": "A maintenance release. Nothing changes in use.", "created_date": 1790334033, "id": "1338500182678169", "version": "1.1.1", "version_code": 25, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1328406453687542", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1368598949668292"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1385974493700087"}]}, "change_log": "Sessions: six short guided sessions (Sight loss, Colour, Colour in the world, Focus, One eye, Contrast and light) step through simulations with a task at each step. Test cards appear in the room: a letter chart and a fading-letters chart on the wall, colour plates, a photograph and a card of charts at arm's length, and an Amsler grid and a reading card in the left hand. Curtain over one eye, reduced acuity in one eye and double vision can be on either eye, and Sight in one eye chooses the left or the right eye. The thumbstick steps the strength. The simulations drawn from the camera run smoothly again. Left and right half-field loss are removed.", "created_date": 1790333220, "id": "1338482206013300", "version": "1.1.0", "version_code": 24, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1328406453687542", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1368598949668292"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": []}, "change_log": null, "created_date": 1790332090, "id": "1338460242682163", "version": "1.0.0", "version_code": 23, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}]}}, "viewer": {"user": null}}}
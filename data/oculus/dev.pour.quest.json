zDlykQ7kNvwEYg56s&_nc_oc=AdqAsb8-2t60BwcQsdNXPBRtwuBe7ikSpi5QzYfkzsjtC1NFwbt9VfXdv3JhTAkQ2_0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOxPTgCr3bp1Eg6sMBRa99yCSzbTFXrYSyOR5zxEMxh4Q&oe=6AC25CF8"}, {"file_name": "5-short-sight.png", "id": "1098829562737581", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491821704_1098829566070914_9015251957043414955_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=djBzSM7QmD4Q7kNvwE4g_f9&_nc_oc=Adq8Kww5oT18w1ajQdUx95i37_QxKWuWG2pr02mksSJKEK9ZSBU6dcVYTPdtKzkIYJM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNY2UG6oHRXo1L44-MM-kj8fUL2LOdWFMts5AdmYtot-A&oe=6AC262C1"}, {"file_name": "3-macular.png", "id": "1085043174266183", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491823366_1085043180932849_2241775312523508159_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=befdMLO6KnIQ7kNvwFnSXkH&_nc_oc=AdrTQtLC8JHo2MEXuHkjFKUOoo_2CdmoVlQS4s9KzGpuTeFuFNyPaV8PuGbVFFYn4Lg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOXMlwZ5rdcKswJQBxHlJKauVeRQGzsCx5dzkzAj9RL5w&oe=6AC26C20"}, {"file_name": "4-cataract.png", "id": "1639090274574775", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491823940_1639090277908108_8723184674625913725_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Yl9nVzNq5B4Q7kNvwEnQwmD&_nc_oc=AdpQeRVBns-nf5RxJTWeqRZ7xBnBqmtlVCOQSKWUpgR4N_jOcH8tHuu0VLht_0Df_9M&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOg73G4m39UoLO0LfulgFaYO38TBFbq0O9AKSe_AwTblg&oe=6AC25F82"}, {"file_name": "1-colour.png", "id": "1097617029311924", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491821796_1097617032645257_3702885578162111283_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=p6ATmgGt1LsQ7kNvwFpdW11&_nc_oc=Adr54mwtOFgXzOfSv1O2NmX-8qX9FUe08FDBV9Ey5sfP7wKp4Dqq7NoAtGXpVgCqS6g&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMFHKcnm-1ZlHKwByNEENaUj680nQCPlq85iP0x8DGQ-A&oe=6AC262DE"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "pour", "keywords": ["accessibility", "a11y", "inclusion", "simulation", "blindness"], "long_description": "pour is an educational tool. It shows how the world in front of you can fail someone: the sign that cannot be read, the red and green that look the same, the button a shaking hand cannot hit.\n\nLook at your own room, your own screen, your own product:\n\n- Colour vision: red-green and blue-yellow deficiencies and full colour blindness, drawn on the headset's own passthrough so the room stays sharp.\n- Sight loss: tunnel vision, central loss, half-field loss, floaters, cataract, double vision and more.\n- Low vision: blur that follows depth, so near-vision loss blurs what is near and short sight blurs what is far. Low contrast, low light, glare and an older eye.\n- Hands: tremor, drift and spasm on the pointer.\n- Hearing: tinnitus, a ringing that is not in the room.\n\nEvery simulation runs at mild, moderate or severe, or anywhere between on a dial. Simulations that can make you feel unwell ask first. Hold a grip to see the real room and compare.\n\nThese are stand-ins for problems, not for people. Nobody sees, hears or feels exactly this: every condition is a range. pour is not a medical device and diagnoses nothing.\n\nCamera images and depth stay on the headset: never stored, never sent. No account, no adverts, no tracking. Non-profit, and free at pour.dev.\n", "short_description": "See your room the way it can fail someone. pour lays simulations of colour blindness, sight loss, low vision, tremor and tinnitus over the real world through the headset's own passthrough, each at mild, moderate or severe, with the share of people each one stands for. Built for designers, developers, teachers and anyone who makes things other people have to use. Free, with no account and nothing sent anywhere."}]}, "developer_name": null, "developer_privacy_policy_url": "https://pour.dev/quest/privacy/", "developer_terms_of_service_url": null, "publisher_name": "pour", "support_website_url": null, "website_url": "https://pour.dev/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "478089301798119"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1328406457020875"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1433316128695526"}]}, "baseline_offer": {"id": "1433316128695526"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1790001240, "status": "PUBLISHED", "id": "1433316128695526"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1340468199148034", "version": "1.2.0"}, "id": "1385974493700087", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1328406453687542", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1340468199148034"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1385974493700087"}]}, "change_log": "Six guided sessions: Sight loss on an eye chart; Colour, with colour plates and real photographs of red, green, blue and yellow things; Contrast and light; Seeing things; Your own screen, with your own phone; and Hands, pressing buttons with a shaking pointer. The simulations are sorted into eight clearer groups. Text size now enlarges every panel. Test cards no longer show twice in the camera simulations. Clearer help and descriptions, and a fix to the question before simulations that move the room.", "created_date": 1790430306, "id": "1340468199148034", "version": "1.2.0", "version_code": 26, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1328406453687542", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1340468199148034"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1385974493700087"}]}, "change_log": "A maintenance release. Nothing changes in use.", "created_date": 1790334033, "id": "1338500182678169", "version": "1.1.1", "version_code": 25, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1328406453687542", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1340468199148034"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1385974493700087"}]}, "change_log": "Sessions: six short guided sessions (Sight loss, Colour, Colour in the world, Focus, One eye, Contrast and light) step through simulations with a task at each step. Test cards appear in the room: a letter chart and a fading-letters chart on the wall, colour plates, a photograph and a card of charts at arm's length, and an Amsler grid and a reading card in the left hand. Curtain over one eye, reduced acuity in one eye and double vision can be on either eye, and Sight in one eye chooses the left or the right eye. The thumbstick steps the strength. The simulations drawn from the camera run smoothly again. Left and right half-field loss are removed.", "created_date": 1790333220, "id": "1338482206013300", "version": "1.1.0", "version_code": 24, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1328406453687542", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1340468199148034"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": []}, "change_log": null, "created_date": 1790332090, "id": "1338460242682163", "version": "1.0.0", "version_code": 23, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1328406453687542", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1340468199148034"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1385974493700087"}]}, "change_log": "Much faster: the camera simulations are back to a smooth frame rate. Curtain over one eye, lazy eye and double vision can be on the left or the right eye; press the thumbstick in to swap. The thumbstick steps the strength.", "created_date": 1790273562, "id": "1337399112788276", "version": "1.0.0", "version_code": 22, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}]}}, "viewer": {"user": null}}}
23958880301", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491823259_1626023962213634_9203125755874718148_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KAdRcSmnIiYQ7kNvwHnzAMc&_nc_oc=AdrzF6Xiu-DAhIqrFT1mNukWnseDtSNAWYLgBM2GcAq68UeIrW_zwXj2wzqXS1BmCk8&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOTUddGO2xk_gu9BrC2a2A0YJSghKuZDePTFuKzEfZFjQ&oe=6ACCE8F8"}, {"file_name": "5-short-sight.png", "id": "1098829562737581", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491821704_1098829566070914_9015251957043414955_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ivKRcbTZMJkQ7kNvwE5ndin&_nc_oc=AdoWAB9TIKO0E-9U8BmA-TUlTXI7coMEYc1UghVkq06G4SjAhTUPZ5E8VlgSRbYUDik&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNfGHJHFJ1SYvsUBQxTlZy98OCJ9SrbpyPo7Iby6SHOpg&oe=6ACCEEC1"}, {"file_name": "4-cataract.png", "id": "1639090274574775", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491823940_1639090277908108_8723184674625913725_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wdRY0Efq0rQQ7kNvwH4QE9p&_nc_oc=AdqnnNlIW4GM701ss40ZakUR18HpSgrg69HRbvdZS5LCYqPMMebzVqN4U3UZxRAQrSo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPb4PPycZQeuVHDWeGgwWf0pzpYgNMedZ1tvjPnY_nguw&oe=6ACCEB82"}, {"file_name": "3-macular.png", "id": "1085043174266183", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491823366_1085043180932849_2241775312523508159_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9pvvnP0OxmoQ7kNvwGfTygY&_nc_oc=AdoAX0HhdQoPMby9o8Zj5X6HQ_ZXHXyBZeriTh5iznafmpNp2guC-ePgUb8dg11UwNA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPELYwRrMlW179_zRAuMTIIWbR6o72tflWtTb9dorMUQA&oe=6ACCF820"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "pour: accessibility simulations", "keywords": ["accessibility", "a11y", "inclusion", "simulation", "blindness"], "long_description": "pour is an educational tool. It shows how the world in front of you can fail someone: the sign that cannot be read, the red and green that look the same, the button a shaking hand cannot hit.\n\nLook at your own room, your own screen, your own product:\n\n- Colour vision: red-green and blue-yellow deficiencies and full colour blindness, drawn on the headset's own passthrough so the room stays sharp.\n- Sight loss: tunnel vision, central loss, ring loss, cataract, double vision and more.\n- Low vision: blur that follows depth, so near-vision loss blurs what is near and short sight blurs what is far. Low contrast, low light, glare and an older eye.\n- Hands: tremor, drift and spasm on the pointer.\n- Hearing: tinnitus, a ringing that is not in the room.\n- Sessions: eleven short guided sessions with test cards and tasks, six of them played on the card itself: snip the right wire, find the error on a form, hit a small cross with a shaking hand.\n\nEach simulation steps between mild, moderate and severe. Simulations that can make you feel unwell ask first. Hold a grip to see the real room and compare.\n\nThese are stand-ins for problems, not for people. Nobody sees, hears or feels exactly this: every condition is a range. pour is not a medical device and diagnoses nothing. The test cards are for showing, not for testing anyone's sight.\n\nCamera images and depth stay on the headset: never stored, never sent. No account, no adverts, no tracking. Non-profit, and free at pour.dev.", "short_description": "See your room the way it can fail someone. pour lays simulations of colour blindness, sight loss, low vision, tremor and tinnitus over the real world through the headset's own passthrough, each at mild, moderate or severe, with the share of people each one stands for. Built for designers, developers, teachers and anyone who makes things other people have to use. Free, with no account and nothing sent anywhere."}]}, "developer_name": null, "developer_privacy_policy_url": "https://pour.dev/quest/privacy/", "developer_terms_of_service_url": null, "
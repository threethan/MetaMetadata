.com&oh=00_AfsaQECgIdUpIXP2eY7PXyaitOAqwEhccy5vTuD1FFm8bA&oe=69984E68"}]}, "id": "1056114682583472", "locale": "en_US", "screenshots": [{"file_name": "Picture 1.png", "id": "891199665886794", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75367587_891199669220127_5485198444585935829_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hHnNZ-leV0UQ7kNvwHwRuBF&_nc_oc=AdnV1J5BoFxIMU60jrguzIYhPRD1RGCtWMWA55A2dL8yEPNT5_yD1S7wxetflIvtK2U&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&oh=00_Afsso1KAHCt5MjgJsizmmPzwdCyD6XysNlu_wWtRmtFQpQ&oe=69984393"}, {"file_name": "Picture 2.png", "id": "1647708672756583", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031340_1647708676089916_8461424291594965379_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oUlvcXMkS_UQ7kNvwG6EVwi&_nc_oc=Admb9qdukgJ5NhpagOJfjX0TVxwuqITTnxVpaUoUPfi2AodUm4EK735UAwrJbkECECI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&oh=00_AftsYTM8tt4EzEbpaavphE4u90BJAK93C9myhwGYXCZFJw&oe=69984E15"}, {"file_name": "Picture 3.png", "id": "453494903768795", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974751_453494907102128_9056554922113121411_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sRA-V60PwTAQ7kNvwE33znn&_nc_oc=AdlesI3Swug13Z9-O25I20CBdy0v0VOmLsBL2zB4va5LVAi5-eiMw9CPxFQ6VieTbM4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&oh=00_AfsPKym3lgMxAzAkuvIXtB-GIU1HFxJ1pQuHSugkn2wqrw&oe=6998574B"}, {"file_name": "Picture 4.png", "id": "1042167284226546", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974792_1042167287559879_6781408860502880089_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c4ndSqg7JRIQ7kNvwF-cec1&_nc_oc=AdnuNFrz7Olid2q-OmzrYdSbtaW7T7fSlC10aMQ6qg18-cPiUN-Mynvq2x5-_MDb-h0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&oh=00_Afs9hM0DW5gOP4psuRgrqMRf0sgzjQoi73umlvhVsJnZGA&oe=699846BD"}, {"file_name": "Picture 5.png", "id": "1513990049996907", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39035471_1513990053330240_3673974849952779443_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O9AtIswykeEQ7kNvwHQLN8g&_nc_oc=AdnkuascXKedfWQ8tQZpoPiQ70MwfRn4hdENz8amtex-EHqwtfJgihFcSHLCoU5Sgz0&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&oh=00_AfvX7KseNVcnktdrFk_DRfC5NCQaNhJ2eK4gqZbktf8atA&oe=69985E8B"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Extinction Facility", "keywords": ["fangame", "gorilla", "monkey", "horror"], "long_description": "Extinction Facility is an immersive VR horror fan game that brings a fresh and terrifying twist to the Gorilla Tag-inspired genre. Set in a dark, sprawling facility, the game draws heavily from chilling inspirations like \"Big Scary\" and \"Scary Baboon,\" creating an atmosphere filled with tension, suspense, and unexpected frights.\n\nThe players navigate through the eerie environment while trying to survive against horrifying creatures. The unsettling design of the monsters, combined with the ominous atmosphere, ensures that every step you take is filled with dread. While the gameplay is rooted in fear, it maintains a sense of fun and excitement, making it as exhilarating as it is terrifying.", "short_description": "Extinction Facility is a VR horror fan game inspired by the eerie and intense vibes of \"Big Scary\" and \"Scary Baboon.\" While it draws from these chilling influences, it offers a unique, heart-racing experience as players navigate through a dark, terrifying facility. The game balances fear and fun, backed by an amazing community that makes the suspenseful adventure worth diving into."}]}, "developer_name": null, "developer_privacy_policy_url": "https://ezra-1-shop.fourthwall.com/pages/privacy-policy-19372f45-86af-40b1-ae25-e3deababc97a", "developer_terms_of_service_url": null, "publisher_name": "PanzeeStudios", "support_website_url": null, "website_url": "https://ezra-1-shop.fourthwall.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_c
.com&oh=00_Afv3n5ukgvZnfdKq7j85dTMVLTyMU3Cd2GIx3vo6cba2tw&oe=69999FE8"}]}, "id": "1056114682583472", "locale": "en_US", "screenshots": [{"file_name": "Picture 1.png", "id": "891199665886794", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75367587_891199669220127_5485198444585935829_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hHnNZ-leV0UQ7kNvwECRRQM&_nc_oc=Adn-nuqg6ahDpozqry3WNnDFwj77pxiPHvDeTnNRmYcubwg23z8mMYRJnXsb57yQJiw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfuSa4CN-ATG_7-bGUnF2e3aeNxfHaAHj2jqiMuzXS7HrA&oe=69999513"}, {"file_name": "Picture 2.png", "id": "1647708672756583", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031340_1647708676089916_8461424291594965379_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zX_VB9REkrkQ7kNvwH6B0qG&_nc_oc=AdlE8vC05fp6igxYnzMxK2Wmb5jyapt15yMfbjZrfyJUwG3NR4Ip-l3owQgFb1wTDrw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afsb6s4i_jzJUGvU1j_hxMDxIk_3fifPE9JKTv7nQVEddw&oe=69999F95"}, {"file_name": "Picture 3.png", "id": "453494903768795", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974751_453494907102128_9056554922113121411_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sRA-V60PwTAQ7kNvwHuN938&_nc_oc=Adno_WvEMsgDvWOFHV5e7FkBSpUzET5dcRriwrEOstrk0t34SRVG6ULTUlBC2q4jTmc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afv75mbPy3wFSPiC7u4ScxD4SRhhh7Nd5MWx6rS8NzKDAQ&oe=6999A8CB"}, {"file_name": "Picture 4.png", "id": "1042167284226546", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974792_1042167287559879_6781408860502880089_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c4ndSqg7JRIQ7kNvwE5j4pK&_nc_oc=AdkD3_pglhYTTvDP0k4sAwDZ2XVJnUO4SnP80XJrNZq6bUuWylH7ZcAHxlXekE4d5Kw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfsxEsLyiVcumhc12ZGEy9jMwK3qMFHMjydJDL3jDM6XVg&oe=6999983D"}, {"file_name": "Picture 5.png", "id": "1513990049996907", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39035471_1513990053330240_3673974849952779443_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=In5ZtLjAMOoQ7kNvwHSQwOs&_nc_oc=Adm7cTyXXESAHt8z0YPViK7wMOyr47m3QanHKUukvRNFLV5ApP6PW2DiiujQajceHOw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afud0CoSVP1RPY0im-IPnbd7j-zvZMJgEBXhsXKIcCmECA&oe=6999B00B"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Extinction Facility", "keywords": ["fangame", "gorilla", "monkey", "horror"], "long_description": "Extinction Facility is an immersive VR horror fan game that brings a fresh and terrifying twist to the Gorilla Tag-inspired genre. Set in a dark, sprawling facility, the game draws heavily from chilling inspirations like \"Big Scary\" and \"Scary Baboon,\" creating an atmosphere filled with tension, suspense, and unexpected frights.\n\nThe players navigate through the eerie environment while trying to survive against horrifying creatures. The unsettling design of the monsters, combined with the ominous atmosphere, ensures that every step you take is filled with dread. While the gameplay is rooted in fear, it maintains a sense of fun and excitement, making it as exhilarating as it is terrifying.", "short_description": "Extinction Facility is a VR horror fan game inspired by the eerie and intense vibes of \"Big Scary\" and \"Scary Baboon.\" While it draws from these chilling influences, it offers a unique, heart-racing experience as players navigate through a dark, terrifying facility. The game balances fear and fun, backed by an amazing community that makes the suspenseful adventure worth diving into."}]}, "developer_name": null, "developer_privacy_policy_url": "https://ezra-1-shop.fourthwall.com/pages/privacy-policy-19372f45-86af-40b1-ae25-e3deababc97a", "developer_terms_of_service_url": null, "publisher_name": "PanzeeStudios", "support_website_url": null, "website_url": "https://ezra-1-shop.fourthwall.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_c
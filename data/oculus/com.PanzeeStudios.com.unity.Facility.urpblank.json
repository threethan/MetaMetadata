tdNI&_nc_oc=AdprFtq4uFzBSu42GWHWYajRp36pSt71K06SAWhqJnGyHL6xOC1Rktir3J30h1Zfrwk&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSVjshsZoS_yG6CImgYSU0rLEC9BAmVHKUEgyvmWRwlog&oe=6AECA1FD"}, {"file_name": "Picture 5.png", "id": "1513990049996907", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/39035471_1513990053330240_3673974849952779443_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=541cQSkJ0L8Q7kNvwHlvlO7&_nc_oc=AdrFMy025yLkN32Re0tjz9jDYSlx784qW_D0LHpHx6qMvNdGahQ6ZuW6tqtQ9xKQUTg&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTBZrDJbVDDNCgJF1w9vHSLz57CaRBSvo11oishfgXbAQ&oe=6AECB9CB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Art 1.png", "id": "3996096637387601", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/39031619_3996096640720934_8681280990124369889_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cPHcxWSccq8Q7kNvwHqrvmZ&_nc_oc=AdrG_4JIUKB0Qaq-lvia6sIoXtoNyj-myzmD7XI2ajj3U6zSFwoQOl-3VYvevJBI90k&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQWUV8Ty8IKfVLLAvT3Z0iah9NygQs2N6ljXGZIBGxUQg&oe=6AEC9B3B"}, "display_name": "(OLD) Extinction Facility", "keywords": ["fangame", "gorilla", "monkey", "horror"], "long_description": "Extinction Facility is an immersive VR horror fan game that brings a fresh and terrifying twist to the Gorilla Tag-inspired genre. Set in a dark, sprawling facility, the game draws heavily from chilling inspirations like \"Big Scary\" and \"Scary Baboon,\" creating an atmosphere filled with tension, suspense, and unexpected frights.\n\nThe players navigate through the eerie environment while trying to survive against horrifying creatures. The unsettling design of the monsters, combined with the ominous atmosphere, ensures that every step you take is filled with dread. While the gameplay is rooted in fear, it maintains a sense of fun and excitement, making it as exhilarating as it is terrifying.", "short_description": "Extinction Facility is a VR horror fan game inspired by the eerie and intense vibes of \"Big Scary\" and \"Scary Baboon.\" While it draws from these chilling influences, it offers a unique, heart-racing experience as players navigate through a dark, terrifying facility. The game balances fear and fun, backed by an amazing community that makes the suspenseful adventure worth diving into."}]}, "developer_name": null, "developer_privacy_policy_url": "https://ezra-1-shop.fourthwall.com/pages/privacy-policy-19372f45-86af-40b1-ae25-e3deababc97a", "developer_terms_of_service_url": null, "publisher_name": "PanzeeStudios", "support_website_url": null, "website_url": "https://ezra-1-shop.fourthwall.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "644354873106712"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "39440436622269764"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38982593_1275665733793948_3542089962079257218_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=krblrUu9Yv0Q7kNvwGjiGAR&_nc_oc=AdpkAXYGGiZdYsXnNK0PZ9NqoIPgrZYMF6gNgVPbTyJ4uhenYKnXFp7bW2aPnpYnY7Q&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTKFSdzKXaU2ibl5Eu1WL6yAdamdBcbPt8qP3T99RnT5Q&oe=6AECA176"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "(OLD) Extinction Facility", "platform": "ANDROID_6DO
5829_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RDaD2Zrbd14Q7kNvwHfzpT9&_nc_oc=AdqpZ9IFB8JvTxz8FUj_39CuvsrgslY1bV3oc69riZT2LK9r-9lZmj1NYggaCf7l8Co&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPYqQ23X-fwKlfr40Wyg1FGywOia-xdIUGlxfNwL1EaIA&oe=6ADE1E53"}, {"file_name": "Picture 2.png", "id": "1647708672756583", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031340_1647708676089916_8461424291594965379_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5XAoRit5hmwQ7kNvwG9lsyE&_nc_oc=Adrz0ouXqQPM9b3ANQSsxtwhbXNCM5RjfZei8HVzfNz5MznNarGNP7YHRTMYnlBOUNs&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPLKdhziM2HdKssFXbnRgsheiS08xXShg5nYYfZvLN2aA&oe=6ADDF095"}, {"file_name": "Picture 3.png", "id": "453494903768795", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974751_453494907102128_9056554922113121411_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FT89u388Ny0Q7kNvwGMKYKk&_nc_oc=Adpw887mXvSAhy8xDNCV0JDnqud6DwpGfyUseBdAz_GCgadNVqDooIJRRrS2egp3Wew&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP5-ICRcso72rsyRHMTjjpDL7vKaupfD3zKINvfTAg5ZA&oe=6ADDF9CB"}, {"file_name": "Picture 4.png", "id": "1042167284226546", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974792_1042167287559879_6781408860502880089_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d41dRFjc1q8Q7kNvwHTXAbF&_nc_oc=AdrJaF5jgLMWUoaegK8BryI2mAqge3SmXHALwK0EmQo74V3FKd2kOBRAZZUIrlWFYfY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNS1FOO6FibKCkOdgCM5jbKhTGsK2pEeNLrnflLPWfJ6Q&oe=6ADE217D"}, {"file_name": "Picture 5.png", "id": "1513990049996907", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39035471_1513990053330240_3673974849952779443_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yyGKwvorG6UQ7kNvwE7hLs-&_nc_oc=Adoe_T5uA_xiPcWZxglMbI9eMDm7PVgZWK7VhmKNr3YmCYYpGK7zzX-CLpP0RKYmj60&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM70GKMroEBThYGts0M09CcVkk9cunhkq-ldVMValuxHw&oe=6ADE010B"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Extinction Facility", "keywords": ["fangame", "gorilla", "monkey", "horror"], "long_description": "Extinction Facility is an immersive VR horror fan game that brings a fresh and terrifying twist to the Gorilla Tag-inspired genre. Set in a dark, sprawling facility, the game draws heavily from chilling inspirations like \"Big Scary\" and \"Scary Baboon,\" creating an atmosphere filled with tension, suspense, and unexpected frights.\n\nThe players navigate through the eerie environment while trying to survive against horrifying creatures. The unsettling design of the monsters, combined with the ominous atmosphere, ensures that every step you take is filled with dread. While the gameplay is rooted in fear, it maintains a sense of fun and excitement, making it as exhilarating as it is terrifying.", "short_description": "Extinction Facility is a VR horror fan game inspired by the eerie and intense vibes of \"Big Scary\" and \"Scary Baboon.\" While it draws from these chilling influences, it offers a unique, heart-racing experience as players navigate through a dark, terrifying facility. The game balances fear and fun, backed by an amazing community that makes the suspenseful adventure worth diving into."}]}, "developer_name": null, "developer_privacy_policy_url": "https://ezra-1-shop.fourthwall.com/pages/privacy-policy-19372f45-86af-40b1-ae25-e3deababc97a", "developer_terms_of_service_url": null, "publisher_name": "PanzeeStudios", "support_website_url": null, "website_url": "https://ezra-1-shop.fourthwall.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_gra
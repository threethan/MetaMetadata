.com&oh=00_AftC2fySL-AkSOd0VkGfn0iNSOvVuearoUmCMfr_JHZZjA&oe=69A42BE8"}]}, "id": "1056114682583472", "locale": "en_US", "screenshots": [{"file_name": "Picture 1.png", "id": "891199665886794", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75367587_891199669220127_5485198444585935829_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g39GQNDoQ-YQ7kNvwG8jWFy&_nc_oc=Adkva6u6uIK4UYeHnhIAtVHp_JOeTpiIiuw80CTXQC8nJ_Uhg3hEal8GsOl8mo5rhi4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AfsZpngfhl6QD2GDL-QdjM_IPpYL2pGIO_tDRjBTg7S5mg&oe=69A42113"}, {"file_name": "Picture 2.png", "id": "1647708672756583", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031340_1647708676089916_8461424291594965379_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PHT3OSIc6M8Q7kNvwHgz69Y&_nc_oc=AdnrIYcisd4HVYlFjToSpJs4sfvRZHyA1Pxrh7d68pJpVTxKJigQF_jPtQzE94V0i6s&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_AfuylxnTw_jqdyWSGaRn1-VgFR52TNIt3jZz3DhQSSsDGg&oe=69A42B95"}, {"file_name": "Picture 3.png", "id": "453494903768795", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974751_453494907102128_9056554922113121411_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cI942-0bjAAQ7kNvwFZkdb0&_nc_oc=AdnXKRdTKR9o3N18bN7-ufYRWyp6YZv5zWFcoxaMmon3Hh9h9rkhuKdk_c9wyOgoT8Q&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_Afvwes8Ogd-x5n_06HPjegYKmQEPWLii2M1XupAhdZJf9A&oe=69A434CB"}, {"file_name": "Picture 4.png", "id": "1042167284226546", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974792_1042167287559879_6781408860502880089_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4-9HbiAHe7wQ7kNvwHA0HhL&_nc_oc=AdllLAbwuqwfYjXIbLY7Fq2cIVj7B60-Ijh-EpQ2ocj5iAZySqs3ITpbV4CtpXbA3vs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_Afs1RXblOgvFBzmj4o3VM6GSvvAUJ_ggEypyCNPLupSMVA&oe=69A4243D"}, {"file_name": "Picture 5.png", "id": "1513990049996907", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39035471_1513990053330240_3673974849952779443_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KFQM3t5gAKgQ7kNvwEl--u1&_nc_oc=AdnM3rjPhzo7-8KPjWzcbEvhTnn09IgdJoq461mwJi6GicLbiQVbPy1Pq0YOjlgx-no&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfsyMsUWqIBX1b8Ewm-Oq3HTajkOMJ8yqhExK2pEqKgNnw&oe=69A43C0B"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Extinction Facility", "keywords": ["fangame", "gorilla", "monkey", "horror"], "long_description": "Extinction Facility is an immersive VR horror fan game that brings a fresh and terrifying twist to the Gorilla Tag-inspired genre. Set in a dark, sprawling facility, the game draws heavily from chilling inspirations like \"Big Scary\" and \"Scary Baboon,\" creating an atmosphere filled with tension, suspense, and unexpected frights.\n\nThe players navigate through the eerie environment while trying to survive against horrifying creatures. The unsettling design of the monsters, combined with the ominous atmosphere, ensures that every step you take is filled with dread. While the gameplay is rooted in fear, it maintains a sense of fun and excitement, making it as exhilarating as it is terrifying.", "short_description": "Extinction Facility is a VR horror fan game inspired by the eerie and intense vibes of \"Big Scary\" and \"Scary Baboon.\" While it draws from these chilling influences, it offers a unique, heart-racing experience as players navigate through a dark, terrifying facility. The game balances fear and fun, backed by an amazing community that makes the suspenseful adventure worth diving into."}]}, "developer_name": null, "developer_privacy_policy_url": "https://ezra-1-shop.fourthwall.com/pages/privacy-policy-19372f45-86af-40b1-ae25-e3deababc97a", "developer_terms_of_service_url": null, "publisher_name": "PanzeeStudios", "support_website_url": null, "website_url": "https://ezra-1-shop.fourthwall.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_c
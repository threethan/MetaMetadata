n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DcQjxyobisMQ7kNvwGS9B-V&_nc_oc=AdrHr1GKH9RlLPFFyNelbfk_hlxIADTwtWfBtIEU5jDs3Sfo5_fjLlzpbobYJarx2mI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJszsawzgv2nYttUyxegVcxpGODOR5eD21UWCPMhW8_sQ&oe=6AAABD0A"}, {"file_name": "004.png", "id": "2180146662825162", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491821686_2180146666158495_3729774277211220550_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KeOz9re2pB4Q7kNvwGV01Em&_nc_oc=AdpWhu8xI3c5v_yLRJStIjEkGEbQbmMSL4GyIlRQ7IRUBF7oQz2eUMFXJ_Uo8faCRpM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKQvpso6Q3DxryS-LnF8cRxg3wbKhCbcxSD853STpGmNA&oe=6AAA8DF7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Meta ss.png", "id": "1047518824468511", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491827601_1047518827801844_8737567683879972937_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h04BVAu0EZkQ7kNvwGhO_GY&_nc_oc=AdowQF26-9LcAkok-0Jg1YLItm4xGMV6zDE-fBIc7MxuddyCEjbvfCcFoVdnySfqZ6E&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL8WGjvguBmLBPQU5EV-AzKvtX2ypk2nGVhrr8iAWTeDg&oe=6AAA9DEF"}, "display_name": "Frontline Strike - VR FPS Shooting Game", "keywords": [], "long_description": "Frontline Strike VR, a fast-paced military shooter built exclusively for Meta Quest.\n\nDeploy into industrial battlefields filled with warehouses, container yards, factories, and tactical combat zones where danger can appear around every corner. Stay alert, use cover wisely, and engage hostile forces in thrilling firefights that test your accuracy, awareness, and combat instincts.\n\nTake command of a growing collection of weapons, including assault rifles, submachine guns, and pistols. Reload manually, aim with precision, and react quickly as enemies push your position from multiple directions. Every encounter demands skill, strategy, and fast decision-making.\n\nWhether you're advancing through enemy territory, defending key positions, or hunting down opponents across the battlefield, Frontline Strike VR delivers immersive first-person action designed specifically for virtual reality.\n\nFEATURES\n\n\u2022 Immersive VR military combat\n\u2022 Realistic weapon handling and manual reloading\n\u2022 Assault rifles, SMGs, and pistols\n\u2022 Challenging AI enemy soldiers\n\u2022 Team Deathmatch and Free-for-All modes\n\u2022 Multiple industrial combat environments\n\u2022 Tactical gameplay focused on positioning and accuracy\n\u2022 Competitive scoring and progression\n\u2022 Optimized exclusively for Meta Quest\n\nFrom close-quarters engagements to long-range firefights, every match offers a unique combat experience. Learn the battlefield, master your weapons, and prove yourself as an elite frontline operator.\n\nSuit up, lock and load, and prepare for battle.", "short_description": "Enter the battlefield in Frontline Strike VR, a fast-paced first-person shooter built for virtual reality. Engage in intense firefights across industrial combat zones, master realistic weapon handling and manual reloading, and battle skilled AI opponents in action-packed game modes. Use tactics, precision, and quick reflexes to dominate the frontline in immersive VR combat designed exclusively for Meta Quest."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.abstron.com/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Abstron Pvt Ltd", "support_website_url": "https://www.abstron.com/", "website_url": "https://abstron.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}, {"id": "275629210202852"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommend
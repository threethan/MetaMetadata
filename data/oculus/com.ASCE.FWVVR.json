4844242_1488193122231732622_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x0z0sVcNy7kQ7kNvwH_S_A6&_nc_oc=AdreFvl5LFifqCrgCb0BRq_CSka7SvFr08ny8adA28iz6WU_m_lYP9Hhyd_Q1WP14EA&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQTFalSnEvoRiSlg8vRe6KvcJ5nByMU_H1L4SdaV55gOQ&oe=6B086585"}, "display_name": "Future World Vision VR", "keywords": [], "long_description": "Welcome to Future World Vision by ASCE.\nNever before has the future looked so exciting.\n\nFrom autonomous vehicles to the most cutting-edge green technologies, the built environment is reshaping before our eyes.\n\nExciting as it is, these changes breed challenges. The future will require a new way of doing things. A new approach. A new vision.\n\nASCE has launched a bold, comprehensive project to anticipate, reimagine, and prepare for future changes - FUTURE WORLD VISION.\n\nExplore two cities of the future here, the Floating City and the Mega City.\n", "short_description": "Never before has the future looked so exciting.\nExplore two cities of the future here, the Floating City and the Mega City.\n\n\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.futureworldvision.org/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "ASCE", "support_website_url": "https://www.futureworldvision.org/contact-us", "website_url": "https://www.futureworldvision.org/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EXPERIENCE_360_NON_GAME"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["S
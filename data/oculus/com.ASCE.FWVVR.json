}, "display_name": "Future World Vision VR", "keywords": [], "long_description": "Welcome to Future World Vision by ASCE.\nNever before has the future looked so exciting.\n\nFrom autonomous vehicles to the most cutting-edge green technologies, the built environment is reshaping before our eyes.\n\nExciting as it is, these changes breed challenges. The future will require a new way of doing things. A new approach. A new vision.\n\nASCE has launched a bold, comprehensive project to anticipate, reimagine, and prepare for future changes - FUTURE WORLD VISION.\n\nExplore two cities of the future here, the Floating City and the Mega City.\n", "short_description": "Never before has the future looked so exciting.\nExplore two cities of the future here, the Floating City and the Mega City.\n\n\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.futureworldvision.org/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "ASCE", "support_website_url": "https://www.futureworldvision.org/contact-us", "website_url": "https://www.futureworldvision.org/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EXPERIENCE_360_NON_GAME"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "938425670823933"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/38974493_903619483655641_4032892998215842679_n.png?stp=dst-png_s360x360&_nc_cat=
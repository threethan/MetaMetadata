1_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hXyTHFXnuB0Q7kNvwG9y4Ji&_nc_oc=AdrQmA5jP67oHcyrnshFEz33MekfwvU7g8UCFUUCptB3t5eX748qnnp0ejv_QQniFS0&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_8Jc20YudJee5phMrsxl3JgbLn6jRmx8wjStbdo2eqyQ&oe=6A3946BC"}, {"file_name": "KMPlayer64_FnZPWpyRaW.png", "id": "781988376326622", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/39031552_781988379659955_521422328161545888_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8bNjkd2J4yUQ7kNvwEr1z4w&_nc_oc=AdrGpF0ZT9eeeGAVV3kO7JdR7siBOB1lRrNlYlsUhGHilyDtZrLEP5IomQjmATwfdDs&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-Ke_spcSbWba6ce_S5EKvXexHXS7TZd9DIOwaVBUNFhA&oe=6A3961C4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "FWV_Oculus_Cover_32bit_16.9.png", "id": "405672491510909", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/39003273_405672494844242_1488193122231732622_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U6kGuYHhtcsQ7kNvwEg-QbP&_nc_oc=Ado5rtvbiyrZ47g-0vONMwNhqvMHyh4MiTREJKeR9ut11ShNc6CRFGHqPzziJMz6alM&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_akWyfvUpNtqpfDztrntZlIqs0GbwLz0t8fCiqh_bDlQ&oe=6A3931C5"}, "display_name": "Future World Vision VR", "keywords": [], "long_description": "Welcome to Future World Vision by ASCE.\nNever before has the future looked so exciting.\n\nFrom autonomous vehicles to the most cutting-edge green technologies, the built environment is reshaping before our eyes.\n\nExciting as it is, these changes breed challenges. The future will require a new way of doing things. A new approach. A new vision.\n\nASCE has launched a bold, comprehensive project to anticipate, reimagine, and prepare for future changes - FUTURE WORLD VISION.\n\nExplore two cities of the future here, the Floating City and the Mega City.\n", "short_description": "Never before has the future looked so exciting.\nExplore two cities of the future here, the Floating Cit
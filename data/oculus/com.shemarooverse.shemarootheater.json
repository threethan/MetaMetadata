d=6e7a0a&_nc_ohc=-qPMXUI-a7UQ7kNvwGrF02H&_nc_oc=AdqHrM3FKTccqcb2qgTw3sau8pGUi8UmKcKaPmD6pBeQiCZD1YSCZNxVzkpIJAtp6bU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMllkLYRY0Z1kH4NVuc3ydxJTqBlYBNgOWHpqfVNHLNgw&oe=6AC2761E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover-art-2560x1440.png", "id": "1460007012182946", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491819239_1460007015516279_6305451358250604038_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KvSu5G4lUBgQ7kNvwH3Fmqk&_nc_oc=AdryqthnqRUBVxnu3PU9RLNXASgBVMvxg6-8IJq54piiUIiNtGh5LvGwTvoEPztpXVU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNaWQpVMLfr8A_U_XiyGbvFN2Hs0jjLGoxd7g7A4tjZMA&oe=6AC26EC0"}, "display_name": "Shemaroo Theatre", "keywords": ["BollywoodVR", "VRCinema", "VirtualRealityEntertainment", "BollywoodMovies", "VREntertainment"], "long_description": "Shemaroo Theatre brings the magic of Bollywood to the Metaverse. Powered by Shemaroo Entertainment Pvt. Ltd., one of India\u2019s largest media and entertainment companies, this immersive VR app transports you into a vibrant virtual world where cinema meets community.\nSpawn in front of Shemaroo\u2019s beloved kids\u2019 IP statue, Bal Ganesh, and step into a beautifully designed theater space featuring a welcoming cafeteria and interactive UI. From here, choose between three unique theaters:\n- Public Theater \u2013 Watch blockbuster Bollywood films \n- Children\u2019s Theater \u2013 A safe, fun space for kids to enjoy family-friendly content\n- Private Theater \u2013 Create your own screening room to watch with friends and family\nWhether you want to enjoy a movie solo or share the experience with others, Shemaroo Theatre offers a multiplayer social cinema unlike anything else. Chat, connect, and celebrate Bollywood culture\u2014all from the comfort of your home.\n\u2728 Key Features:\n- Immersive VR environment with interactive spaces.\n- Multiplayer experience\u2014watch with friends, family, or global audiences.\n- Choice of public, kids, or private theaters.\n- Access to Shemaroo\u2019s library of Bollywood blockbusters.\n- Socialize, explore, and relive the magic of cinema in VR.\nShemaroo Theatre is more than just a movie app\u2014it\u2019s a social destination for Bollywood fans worldwide.\n", "short_description": "Step into Shemaroo Theatre, a virtual cinema powered by Shemaroo Entertainment. Watch Bollywood blockbusters in stunning VR\u2014alone or with friends\u2014across public, kids, and private theaters. Socialize, explore, and experience the magic of movies like never before"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.shemarooverse.com/en/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "ShemarooVerse Digital Limited", "support_website_url": null, "website_url": "https://www.shemarooverse.com/en", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25536149139392245"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "932352309517812"}]}, "baseline_offer": {"id": "932352309517812"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1774612920, "status": "PUBLISHED", "id": "932352309517812"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "
f&oh=00_Af9OcywzKSgm7JPiruGZHnwH50Ngu2G1Gg3SUj0ffwb1pw&oe=6A37E714"}, {"file_name": "deer_1.png", "id": "1332717592157844", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491823940_1332717595491177_2494044677614522896_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nvmCKtq_afsQ7kNvwEDVQTK&_nc_oc=AdriSp3F8N31gSYbMdTn7vihTQQ0UtN8yePk6XaGKmvHZp9a6yMscnY6Scu5tXOsgnk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9d1YBma59ltkGwrX-2LnhIrHrY7ju-1bsYPp1auAglpQ&oe=6A37F00B"}, {"file_name": "ss_fire.png", "id": "983148271233690", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491823790_983148274567023_2120001592240190564_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f-8MQg8QAewQ7kNvwF_cKvC&_nc_oc=Adqze1ANuRj1rIyMwpKb1Oxf7ivX87jD4i3xPuAIi1Qb9hDp0AFKKdT1UCfm-7oKXBM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8Ux786wB0vOO6cKWaWF9erRVj3gt4z5nepKnfQtdN7aQ&oe=6A37FE0F"}, {"file_name": "s.png", "id": "4255777344660911", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491823746_4255777357994243_7334746589021874546_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u_yseL8QUPMQ7kNvwGznPK9&_nc_oc=AdqYqUlZ00if0r-Yx46rwjDuWKFIekPNMchlvTQkVOS7fj571LGrldgUHZ_BHIXWvps&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8CciFmqQsNFcV8Ws2FKfJwdxwxcIl7pzWonP3lUBuA9A&oe=6A37E4ED"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "AnimalBlocksZombieHorde_12_2560x1440.png", "id": "1195903555894012", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499618093_1195903559227345_7587350963945298034_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WbwB_BqDKHcQ7kNvwE_mAbI&_nc_oc=Adrae6EtoWBeeHztr1s2uq9UMSzHrUz1MJ8dPlTlx-Og6egvTkmZhYTgY2WGLBGi0M0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af91zYNq-uvhpVXqoeVyD0gAl-xQgQf4lg9yJtORLEyGcw&oe=6A37FE60"}, "display_name": "Animal Blocks", "keywords": ["sandbox", "multiplayer", "building", "survival", "monsters"], "long_description": "Enter **Animal Blocks**, the chaotic Minecraft-inspired VR sandbox where you build, roleplay, survive, and show off your style. \n\n# **\ud83e\uddf1 Build and Roleplay in Blockhaven**  \nSky bases, bunkers, traps, forts, castles \u2014 it\u2019s all block-based and yours to shape.\n{2909585475894360}\n\n# **\ud83c\udfae Game Modes** \n- **\ud83c\udf11 Survive 99 Nights** \n{2110015899579189}\n- \ud83e\udddf **Zombies**\n{955142100673993}\n- \ud83d\udd0d **Dark Forest**\n{1008531195001414}\n- \u26cf\ufe0f **Mining**\n{4451251821810128}\n- \ud83e\uddf1 **Creative**\n{1811662810005411}\n\n# **\ud83e\uddf0\ud83e\ude84\ud83d\udd2b\ud83d\udd78\ufe0f\ud83e\uddf9 Gadgets, Guns, Weapons!**  \nGrapple hooks, flying brooms, web slingers, sticky bombs, wings, and more!\n\n# **\ud83d\udc3c\ud83e\udd96\ud83d\udc31\ud83e\udd88\ud83d\udc38 Pick Your Animal**  \nBe an axolotl, panda, dinosaur, cat, shark\u2026 or something totally custom.\n\n# **\ud83d\uddfa\ufe0f Explore Player Worlds**  \nJump into wild player-made maps \u2014 or build your own and invite your friends!", "short_description": "Animal Blocks is a game inspired by Gorilla Tag movement mechanics and Minecraft. You can build, play PVP , or try to survive against wild monsters and zombies."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.animalblocksvr.com/privacy-policy", "developer_terms_of_service_url": "https://www.animalblocksvr.com/code-of-conduct", "publisher_name": "RemioVR", "support_website_url": "https://www.animalblocksvr.com/", "website_url": "https://www.animalblocksvr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "459781504968480"}, {"id": "644354873106712"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "
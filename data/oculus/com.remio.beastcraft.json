f20f&oh=00_AQDaNjT9uBJjEioB_ObH23Y8THe5tGWeA98LI0ujfcYJrg&oe=6A660B94"}, {"file_name": "deer_1.png", "id": "1332717592157844", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/491823940_1332717595491177_2494044677614522896_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9eCIrsAke2QQ7kNvwFHmV1A&_nc_oc=Adqr9cAt5A5MtP1vyJ9To5AvXy3IVtSexBdHNcYsi0fWUCls9deVd85qic8zuuRpEIg&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAvP8AbjoVyIihH2dU63ObuJ0UcmWwZYJ4Rvq2fCqIs9w&oe=6A66148B"}, {"file_name": "ss_fire.png", "id": "983148271233690", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/491823790_983148274567023_2120001592240190564_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jB5jUvHWp-MQ7kNvwFuDHEQ&_nc_oc=AdrPAUMRnJ0veEwiBpNCcP1frqMvaQgPHU-_GtNrDHrO0_guhvQCeHs7EjmQ9DqBUwE&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCV2Et4iSj3JLpe7cZ-_tb5orBNNPQ0kwNYDOTXgegwmw&oe=6A66228F"}, {"file_name": "s.png", "id": "4255777344660911", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/491823746_4255777357994243_7334746589021874546_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZxUMzjNyij8Q7kNvwG2DJZ2&_nc_oc=Adoin8_40YUDNfjfRxpxLOpbyMHzosEbUrai5MMNsM7y7h0S4cDS2qLlrRjsecssmV0&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAkuN0norocBGdso6EoYHDp3BXKSPrecAIP1XJTecbyNg&oe=6A66096D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "AnimalBlocksCarts_2560x1440_03.png", "id": "1011506208453365", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/499312454_1011506211786698_7720303956786300647_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ob7EV0FH19cQ7kNvwFykBUA&_nc_oc=Adqj7e7qPJem3epShCBQAR50kpvwtuBv8gmOwKJcOh6mFFRssjPb3b4SBvk0dKxIlWk&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAe_ocNzINmhLnA_VtlqteA44JqnypDOA-BDUJ9yYvmhg&oe=6A661BF1"}, "display_name": "Animal Blocks", "keywords": ["sandbox", "multiplayer", "building", "survival", "monsters"], "long_description": "Enter **Animal Blocks**, the chaotic Minecraft-inspired VR sandbox where you build, roleplay, survive, and show off your style. \n\n# **\ud83e\uddf1 Build and Roleplay in Blockhaven**  \nSky bases, bunkers, traps, forts, castles \u2014 it\u2019s all block-based and yours to shape.\n{2909585475894360}\n\n# **\ud83c\udfae Game Modes** \n- **\ud83c\udf11 Survive 99 Nights** \n{2110015899579189}\n- \ud83e\udddf **Zombies**\n{955142100673993}\n- \ud83d\udd0d **Dark Forest**\n{1008531195001414}\n- \u26cf\ufe0f **Mining**\n{4451251821810128}\n- \ud83e\uddf1 **Creative**\n{1811662810005411}\n\n# **\ud83e\uddf0\ud83e\ude84\ud83d\udd2b\ud83d\udd78\ufe0f\ud83e\uddf9 Gadgets, Guns, Weapons!**  \nGrapple hooks, flying brooms, web slingers, sticky bombs, wings, and more!\n\n# **\ud83d\udc3c\ud83e\udd96\ud83d\udc31\ud83e\udd88\ud83d\udc38 Pick Your Animal**  \nBe an axolotl, panda, dinosaur, cat, shark\u2026 or something totally custom.\n\n# **\ud83d\uddfa\ufe0f Explore Player Worlds**  \nJump into wild player-made maps \u2014 or build your own and invite your friends!", "short_description": "Animal Blocks is a game inspired by Gorilla Tag movement mechanics and Minecraft. You can build, play PVP , or try to survive against wild monsters and zombies."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.animalblocksvr.com/privacy-policy", "developer_terms_of_service_url": "https://www.animalblocksvr.com/code-of-conduct", "publisher_name": "RemioVR", "support_website_url": "https://www.animalblocksvr.com/", "website_url": "https://www.animalblocksvr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "459781504968480"}, {"id": "644354873106712"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQ
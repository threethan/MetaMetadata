f20f&oh=00_Af-_yNkgDgKiR8ajuiz64MlWU4up1J-JvRuYa1L0gvlvsQ&oe=6A43C494"}, {"file_name": "deer_1.png", "id": "1332717592157844", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491823940_1332717595491177_2494044677614522896_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LcOTngZLqL0Q7kNvwHU3MAM&_nc_oc=Adotc6bzdBIJ3TZkPB_l9xLKzD6MlVZDfujVh5DSlVQkQqMyaA6b8KkEwweKTV_zOUo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_VZUxd3hZeJVJY9CHyQU69UsCQNBDSuvLhywkdLwEWGQ&oe=6A43CD8B"}, {"file_name": "ss_fire.png", "id": "983148271233690", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491823790_983148274567023_2120001592240190564_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-cCSYOv6IoAQ7kNvwEUQ2Ph&_nc_oc=AdoQhpJhcTbI-adxc5SDGkBu-uDIOmn6agwYfEI0H73HlCTvye3a8j8wibWxTI0vovA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9zQ3bfy-xpFgOUs4DcBYo4b2-p6-NuSkep7VeAGjHigQ&oe=6A43DB8F"}, {"file_name": "s.png", "id": "4255777344660911", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491823746_4255777357994243_7334746589021874546_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5DYJcqcKkYEQ7kNvwHZ931Y&_nc_oc=Adrxk89ORpmXKwdtePPZGFtSg66NnDikb4aIu4rm57jf2AB5GCEWrfccbgC_2x5mgow&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_o4NupWVJ6rnzkPgKPsZRN8CDY0_Mh-HgHqhfRryen0Q&oe=6A43C26D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "AnimalBlocksCarts_2560x1440_03.png", "id": "1011506208453365", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499312454_1011506211786698_7720303956786300647_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7h9bBPgCeM0Q7kNvwF2lnmV&_nc_oc=AdpbiaCZjfUO5X7q3lV3EKDcyoP956p9mT38CkCwlITWOAtogSCKR0RVVuflheKkh70&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_H6qjU_t1aYH5LuI3M4ac6RZ4kpl1Z4cpH_1ktmQHgjw&oe=6A43D4F1"}, "display_name": "Animal Blocks", "keywords": ["sandbox", "multiplayer", "building", "survival", "monsters"], "long_description": "Enter **Animal Blocks**, the chaotic Minecraft-inspired VR sandbox where you build, roleplay, survive, and show off your style. \n\n# **\ud83e\uddf1 Build and Roleplay in Blockhaven**  \nSky bases, bunkers, traps, forts, castles \u2014 it\u2019s all block-based and yours to shape.\n{2909585475894360}\n\n# **\ud83c\udfae Game Modes** \n- **\ud83c\udf11 Survive 99 Nights** \n{2110015899579189}\n- \ud83e\udddf **Zombies**\n{955142100673993}\n- \ud83d\udd0d **Dark Forest**\n{1008531195001414}\n- \u26cf\ufe0f **Mining**\n{4451251821810128}\n- \ud83e\uddf1 **Creative**\n{1811662810005411}\n\n# **\ud83e\uddf0\ud83e\ude84\ud83d\udd2b\ud83d\udd78\ufe0f\ud83e\uddf9 Gadgets, Guns, Weapons!**  \nGrapple hooks, flying brooms, web slingers, sticky bombs, wings, and more!\n\n# **\ud83d\udc3c\ud83e\udd96\ud83d\udc31\ud83e\udd88\ud83d\udc38 Pick Your Animal**  \nBe an axolotl, panda, dinosaur, cat, shark\u2026 or something totally custom.\n\n# **\ud83d\uddfa\ufe0f Explore Player Worlds**  \nJump into wild player-made maps \u2014 or build your own and invite your friends!", "short_description": "Animal Blocks is a game inspired by Gorilla Tag movement mechanics and Minecraft. You can build, play PVP , or try to survive against wild monsters and zombies."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.animalblocksvr.com/privacy-policy", "developer_terms_of_service_url": "https://www.animalblocksvr.com/code-of-conduct", "publisher_name": "RemioVR", "support_website_url": "https://www.animalblocksvr.com/", "website_url": "https://www.animalblocksvr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "459781504968480"}, {"id": "644354873106712"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQ
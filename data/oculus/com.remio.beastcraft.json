Q7kNvwGZsTrE&_nc_oc=AdpfJ7ssaiyfEvuN6_ggGgE6hGkityMWNPwiOTOU5phcJYzJAk3jEzVJZIuSX-Ppsh4&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNu2nbJjvMJftraogpGlkw1i45plEbrN5SLPMTwMYpXeg&oe=6AD39519"}, {"file_name": "ss_1.png", "id": "825818046988182", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/491823930_825818053654848_5912142274205285217_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qZXY4e5h1EMQ7kNvwELnm-g&_nc_oc=Ado9geprdZ9ouw52aGEqyodvCEOkeacAhGXntdVcgFVash8huLakJWFiMszaI7lYRFs&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMXBMznSkAvpEb-61ipHIJDO1f6HQkd4vcBfTtp3ck0mg&oe=6AD3B054"}, {"file_name": "deer_1.png", "id": "1332717592157844", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/491823940_1332717595491177_2494044677614522896_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pTrASlnMY1AQ7kNvwFm_t76&_nc_oc=AdoJ38XWozVhHBvN0ircnnK-BuuDhO-5TjL7hkMTu6YpWGO_0sMkkIYBIdcmKLivgAk&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN80iUrfNfGUNLO3bNRsuZ5y3QFrVZp6ao97Xik8GGfcQ&oe=6AD3B94B"}, {"file_name": "s.png", "id": "4255777344660911", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/491823746_4255777357994243_7334746589021874546_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IwZFJcVfBfMQ7kNvwEw-7Js&_nc_oc=AdqAKC46tTRR-Q6CO7R9wG-629hqs5xBzGVB_TNwCribYukfcE-T5f7gDskZ1IgPpyQ&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPHXXP2Ayr7ZLdunPTefoLf3XJgLHzWTOvbNYMdIKbSKg&oe=6AD3AE2D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "AnimalBlocksCoverArt_2560x1440.png", "id": "1518215032857058", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/491825481_1518215036190391_3126051047249417807_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CICuFov2ha0Q7kNvwEMuXRR&_nc_oc=Adqm6uEjB-KZ9QRlqdJGUSOPvY_0NEPqcJo9CPhDXxCAeOtv4i1fqN_d_P4nFAvzGjc&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQONNN8QJG_-KAAy5hsbV24DCq30BR-ILbYoyZk_GDAGvw&oe=6AD3A7A1"}, "display_name": "Animal Blocks", "keywords": ["sandbox", "multiplayer", "building", "survival", "monsters"], "long_description": "Enter **Animal Blocks**, the chaotic Minecraft-inspired VR sandbox where you build, roleplay, survive, and show off your style. \n\n# **\ud83c\udf34 Battle in Jungle Combat**\nBattle other players, earn XP, and level up different combat classes\u2014each with unique weapons and play styles.\n{1034054556264024}\n\n# **\ud83c\udfae Game Modes** \n- **\ud83c\udf11 Survive 99 Nights** \n{2110015899579189}\n- \ud83e\udddf **Zombies**\n{955142100673993}\n- \ud83d\udd0d **Dark Forest**\n{1008531195001414}\n- \u26cf\ufe0f **Mining**\n{4451251821810128}\n\n# **\ud83e\uddf1 Build and Roleplay**  \nSky bases, bunkers, traps, forts, castles \u2014 it\u2019s all block-based and yours to shape.\n{2909585475894360}\n\n# **\ud83e\uddf0\ud83e\ude84\ud83d\udd2b\ud83d\udd78\ufe0f\ud83e\uddf9 Gadgets, Guns, Weapons!**  \nGrapple hooks, flying brooms, web slingers, sticky bombs, wings, and more!\n\n# **\ud83d\udc3c\ud83e\udd96\ud83d\udc31\ud83e\udd88\ud83d\udc38 Pick Your Animal**  \nBe an axolotl, panda, dinosaur, cat, shark\u2026 or something totally custom.\n\n# **\ud83d\uddfa\ufe0f Explore Player Worlds**  \nJump into wild player-made maps \u2014 or build your own and invite your friends!", "short_description": "Animal Blocks is a game inspired by Gorilla Tag movement mechanics and Minecraft. You can build, play PVP , or try to survive against wild monsters and zombies."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.animalblocksvr.com/privacy-policy", "developer_terms_of_service_url": "https://www.animalblocksvr.com/code-of-conduct", "publisher_name": "RemioVR", "support_website_url": "https://www.animalblocksvr.com/", "website_url": "https://www.animalblocksvr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_ca
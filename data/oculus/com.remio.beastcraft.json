Q7kNvwEOBrQ1&_nc_oc=AdpGbh9j9EVMSRZ4ykQ7WxvRy0tB-l6D_MKqDI76mql46pMGA9yrrWZe1v6fHZeCJQ8&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPoIIXG-Y8sPmN7LKPCb1vdFWWt8kcZL-dSthGtGAtc9Q&oe=6AE21599"}, {"file_name": "ss_1.png", "id": "825818046988182", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491823930_825818053654848_5912142274205285217_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4QqRJiL9f0cQ7kNvwHk6kh_&_nc_oc=Adr3KLvfAnRlpZ8DRCCx1L51WayDgUdZKb6PXqepH89yYx_5ZKD3h3GvviJufc2VGuc&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNW7cuL5y1_sI2mNW2BkPPpxmk7saiayQ-O0mDkcY7O0A&oe=6AE1F894"}, {"file_name": "deer_1.png", "id": "1332717592157844", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491823940_1332717595491177_2494044677614522896_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_I9AHu-tf88Q7kNvwF3JQ8O&_nc_oc=AdqU2oXBrJKbvTgKQ2-0QDVGf_7q5Qjxmc083An8i4hBTe9qd8V8YbJIC6tT1JV2EZw&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM4f7FQhXe683XtyUJX76_PNtp6YqO03KDG_S8adRNcXw&oe=6AE2018B"}, {"file_name": "s.png", "id": "4255777344660911", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491823746_4255777357994243_7334746589021874546_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Omx1MAdfTCkQ7kNvwF87loI&_nc_oc=AdqDkpAm3M_YCQKFwHAbX77i3VXjTOf0Oi90fAGN90EQ_nnzhwUfoo4EQl1-8eDnhms&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNYAEGEKvJRwVZtFvKys-xyQ2BXgV5phvJj6ZyxXYi6Cg&oe=6AE1F66D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "AnimalBlocksCoverArt_2560x1440.png", "id": "1518215032857058", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491825481_1518215036190391_3126051047249417807_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nPoTlzzhbYAQ7kNvwHRA0G3&_nc_oc=Ado9AW4e6OsRmOIc5jcGdPnDtLgCt4yEMxxCLcFqcgrm78X10-W2PGQ6fi2J5yummOM&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQODzs9P3Sj324D1W-x1wKJKGdRApFpJD0Fz2rkjRVtO9w&oe=6AE1EFE1"}, "display_name": "Animal Blocks", "keywords": ["sandbox", "multiplayer", "building", "survival", "monsters"], "long_description": "Enter **Animal Blocks**, the chaotic Minecraft-inspired VR sandbox where you build, roleplay, survive, and show off your style. \n\n# **\ud83c\udf34 Battle in Jungle Combat**\nBattle other players, earn XP, and level up different combat classes\u2014each with unique weapons and play styles.\n{1034054556264024}\n\n# **\ud83c\udfae Game Modes** \n- **\ud83c\udf11 Survive 99 Nights** \n{2110015899579189}\n- \ud83e\udddf **Zombies**\n{955142100673993}\n- \ud83d\udd0d **Dark Forest**\n{1008531195001414}\n- \u26cf\ufe0f **Mining**\n{4451251821810128}\n\n# **\ud83e\uddf1 Build and Roleplay**  \nSky bases, bunkers, traps, forts, castles \u2014 it\u2019s all block-based and yours to shape.\n{2909585475894360}\n\n# **\ud83e\uddf0\ud83e\ude84\ud83d\udd2b\ud83d\udd78\ufe0f\ud83e\uddf9 Gadgets, Guns, Weapons!**  \nGrapple hooks, flying brooms, web slingers, sticky bombs, wings, and more!\n\n# **\ud83d\udc3c\ud83e\udd96\ud83d\udc31\ud83e\udd88\ud83d\udc38 Pick Your Animal**  \nBe an axolotl, panda, dinosaur, cat, shark\u2026 or something totally custom.\n\n# **\ud83d\uddfa\ufe0f Explore Player Worlds**  \nJump into wild player-made maps \u2014 or build your own and invite your friends!", "short_description": "Animal Blocks is a game inspired by Gorilla Tag movement mechanics and Minecraft. You can build, play PVP , or try to survive against wild monsters and zombies."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.animalblocksvr.com/privacy-policy", "developer_terms_of_service_url": "https://www.animalblocksvr.com/code-of-conduct", "publisher_name": "RemioVR", "support_website_url": "https://www.animalblocksvr.com/", "website_url": "https://www.animalblocksvr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_ca
ription": "Jump into **Animal Blocks** \u2014 a playful, chaotic sandbox inspired by Minecraft and Roblox, where you can build, battle, survive, and role-play!\n\n\ud83c\udf33 **Survive 99 Nights in the Forest. Rescue kids. Collect resources. Craft.**  \n\n\ud83c\udf11 **Survive the Dark Forest \u2014 Scary Monsters. PvP**\n\n\u26cf\ufe0f **Shooter Maps: Docks & Rivals**\n\n\ud83e\uddf1 **Build your house, decorate with furniture, or use TNT. Explore Player Worlds** \n\n\ud83e\uddf9 **Gadgets & Weapons**  \n\n\ud83d\ude48 **Pick Your Animal. Be a monkey, axolotl, dinosaur** ", "short_description": "Animal Blocks is a game inspired by Gorilla Tag movement mechanics and Minecraft. You can build, play the crown tag game , or try to survive against wild monsters."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.animalblocksvr.com/privacy-policy", "developer_terms_of_service_url": "https://www.animalblocksvr.com/code-of-conduct", "publisher_name": "RemioVR", "support_website_url": "https://www.animalblocksvr.com/", "website_url": "https://www.animalblocksvr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "459781504968480"}, {"id": "644354873106712"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "36336162449316086"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/491823271_14250148
reenshots": [{"file_name": "Screenshot 2024-04-26 at 1.36.29 AM.png", "id": "397375406455902", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/57569483_397375409789235_9167516067076574827_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9iuHp5bSUnEQ7kNvwE4B9_X&_nc_oc=AdoNoPHC-P9ZeE6jepfM4ckbdY_QCKC72HBo2-Ru1wjLLl-HYIWAzrADk4pV3jcDTZc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSX0gEjEGXoPDU7xUqV7a5m9vHzKbnn7UQwbQ0xbPk2Sg&oe=6B0054B8"}, {"file_name": "Screenshot 2024-04-26 at 12.25.47 AM.png", "id": "3307224682920421", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974627_3307224686253754_777325882876845850_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7-ddGbmG7agQ7kNvwGrTN9Q&_nc_oc=AdpSs6S4c-2PvfGqUNJtWEUaagPz3r3w0pn3Txaaht9ypNQqGRxXmLwKzAkPyVGeKMc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQMdAcqFUK0SuIPX7bNq_FxqyNVf7nCyaYYZ9ca1nwtNw&oe=6B007345"}, {"file_name": "Screenshot 2024-04-26 at 12.17.28 AM.png", "id": "435321545745867", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75622009_435321549079200_2974455210166216529_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vAb1YDEg75sQ7kNvwGRxDDJ&_nc_oc=AdqE-SmbeW4J3rXXRzM74D4QmYpD7QvfvV-bp_X5xarD21Uw0Brbkrg_phb5RIkq9JM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTt6ftttZnHX-HsSbIW1TxDu5wU_NHx99yyVHsdbUW0UQ&oe=6B006EB3"}, {"file_name": "Screenshot 2024-04-26 at 1.02.32 AM.png", "id": "1879740189143965", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39035403_1879740192477298_67763767635381086_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4fSWN8RB0F0Q7kNvwHtfEgi&_nc_oc=AdoHiTX9GaObzvCvJvMZPgSzXCWRC5Zks0VwyS2EWiysV7DWV0hyNGY4Lr4GXiYidGI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRLic534JiThfxHD1aqI8G70HkMnXZ78JHiZtytiopeTA&oe=6B00701A"}, {"file_name": "Screenshot 2024-04-26 at 1.05.52 AM.png", "id": "364008362727318", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39003285_364008366060651_8273232648582101348_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1apAW85CdYUQ7kNvwFHAXd3&_nc_oc=AdqwwTDpuFzu7HzaCHnxOQStxomrO_zhktGR_FoL7VbeW64d2l6xdvNm3w1Kk2qX5_E&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRVNg1lxw3MnsyOxQqYUssyA_0V_jvZIylIFL7R61wlkw&oe=6B0071A8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Screenshot 2024-04-26 at 12.19.50 AM.png", "id": "1254133988879668", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75542964_1254133992213001_1426704643780221508_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fOGF-eedlBYQ7kNvwE1XBmc&_nc_oc=Ado87IGVdFdEgr9qUEvyq6drkZGpMX4RDhFOZCEQwntlcR6PsuaThiUcviy-gl-mJAk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS0v6JmjfbWIOBGG49GiXpvrlDp6eHxdRa-uTtTiXD2TQ&oe=6B0079B9"}, "display_name": "Beastcraft", "keywords": [], "long_description": "Immerse yourself in \"Beastcraft,\" a voxel-based virtual reality world where friendship, creativity, and strategy collide. In this dynamic multiplayer game, players can create, save, and publish their own worlds, sharing their creativity with a global community. Choose your avatar from an eclectic roster, including killer sharks, mysterious aliens, agile cats, undead zombies, formidable ogres, and playful pandas. Each avatar brings a unique perspective to your adventures and construction efforts.\n\nWield an array of unique weapons, ranging from simple plungers to the mighty Thor's Hammer, tailoring your combat style to suit your strategic needs. Engage in exhilarating gameplay modes such as the infectious \"Infected Mode,\" where tagging becomes a thrilling chase, or join forces in clans to build and destroy fortresses in strategic battles that test your teamwork and creativity.\n\n\"Beastcraft\" is more than just a game; it's a platform for expression and interaction. Build elaborate structures, devise complex game strategies, or simply explore the vast, player-created landscapes. Whether you\u2019re battling it out with other avatars, constructing monumental edifices, or contributing to your clan's dominion, every action in \"Beastcraft\" shapes your experience in this endlessly evolving VR universe. Explore, build, battle, and connect in \"Beastcraft\" \u2014 where your imagination is your greatest weapon.", "short_description": "Make friends a voxel-based VR world where you can create, save, and publish your own worlds. Choose from avatars like killer sharks, aliens, cats, zombies, ogres, and pandas while wielding unique weapons from plungers to Thor's Hammer in this dynamic multiplayer game. Tag each other in infected mode, or join clans, building and destroying fortresses. In Beastcraft, you create your experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.remiovr.com/beastcraft-privacy-policy", "developer_terms_of_service_url": "https://www.remiovr.com/terms-of-use", "publisher_name": "Future of VR", "support_website_url": "https://www.remiovr.com/contact-us", "website_url": "https://www.remiovr.com/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1725996564472128"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "26431677296431367"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1102
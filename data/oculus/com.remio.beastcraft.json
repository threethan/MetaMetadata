Q7kNvwG8iXiw&_nc_oc=AdpIUjVt9-uSLeGLqtRI35I1AI4w9zCwP1h9pMfdt7AzcYsWJg27z7Po2RxWW9laTuI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSNdCZfaQyYB1GVhCe1Uj5BWd3UdIM2QX-uRbtjrln_zg&oe=6AEF4499"}, {"file_name": "ss_1.png", "id": "825818046988182", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491823930_825818053654848_5912142274205285217_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iwtrXh4AqHsQ7kNvwFpYSzO&_nc_oc=Adrp8ShKFvC3Sr6C-vgLPJHjtuGs4K58v3jDgb8oNB8iDxkMmst_0DUk9M-Qv3zhNac&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQuwGPZ0ihD9OT8E873qRWfYqB8i4NVx9LgIYwx5oC-3w&oe=6AEF5FD4"}, {"file_name": "deer_1.png", "id": "1332717592157844", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491823940_1332717595491177_2494044677614522896_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DnG3M4ASrdgQ7kNvwHBfh0f&_nc_oc=AdpOyJv2GJtIN0lWDwi-ItkfKSpMqPqoM47vo1CJuOZCJqIA4wwPioDdOhkB9V7gGgY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQuu7C2aTnhbGTzhY9XKU4Dn54nP5P8W9S9SUBtuZC1RA&oe=6AEF68CB"}, {"file_name": "s.png", "id": "4255777344660911", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491823746_4255777357994243_7334746589021874546_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ws7OzRYbXdIQ7kNvwHvPq9K&_nc_oc=Adqt8vgkxAxvsUjh6TakNJv9yoUvZ4ZwKSaw-egXw8b6ojYvQxAOY2oLN338CjVIhCc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ3VsU0FB0H9W1apMj1Rx5_f5_eB_Uy8PRAGSPwBDeyWg&oe=6AEF5DAD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "AnimalBlocksCoverArt_2560x1440.png", "id": "1518215032857058", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491825481_1518215036190391_3126051047249417807_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6WjfE2GegKQQ7kNvwEKaPXM&_nc_oc=AdozvcOhYJRofBaPEcbJXUiPOElwtb9U-IbzX6NlAX4RS6xbyNqJlh438_j559_gvzQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR0MJ_W9Um9AO2MnxsH-03-RY9IDD-_Hf38IwJPfap7qg&oe=6AEF5721"}, "display_name": "Animal Blocks", "keywords": ["sandbox", "multiplayer", "building", "survival", "monsters"], "long_description": "Enter **Animal Blocks**, the chaotic Minecraft-inspired VR sandbox where you build, roleplay, survive, and show off your style. \n\n# **\ud83c\udf34 Battle in Jungle Combat**\nBattle other players, earn XP, and level up different combat classes\u2014each with unique weapons and play styles.\n{1034054556264024}\n\n# **\ud83c\udfae Game Modes** \n- **\ud83c\udf11 Survive 99 Nights** \n{2110015899579189}\n- \ud83e\udddf **Zombies**\n{955142100673993}\n- \ud83d\udd0d **Dark Forest**\n{1008531195001414}\n- \u26cf\ufe0f **Mining**\n{4451251821810128}\n\n# **\ud83e\uddf1 Build and Roleplay**  \nSky bases, bunkers, traps, forts, castles \u2014 it\u2019s all block-based and yours to shape.\n{2909585475894360}\n\n# **\ud83e\uddf0\ud83e\ude84\ud83d\udd2b\ud83d\udd78\ufe0f\ud83e\uddf9 Gadgets, Guns, Weapons!**  \nGrapple hooks, flying brooms, web slingers, sticky bombs, wings, and more!\n\n# **\ud83d\udc3c\ud83e\udd96\ud83d\udc31\ud83e\udd88\ud83d\udc38 Pick Your Animal**  \nBe an axolotl, panda, dinosaur, cat, shark\u2026 or something totally custom.\n\n# **\ud83d\uddfa\ufe0f Explore Player Worlds**  \nJump into wild player-made maps \u2014 or build your own and invite your friends!", "short_description": "Animal Blocks is a game inspired by Gorilla Tag movement mechanics and Minecraft. You can build, play PVP , or try to survive against wild monsters and zombies."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.animalblocksvr.com/privacy-policy", "developer_terms_of_service_url": "https://www.animalblocksvr.com/code-of-conduct", "publisher_name": "RemioVR", "support_website_url": "https://www.animalblocksvr.com/", "website_url": "https://www.animalblocksvr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_ca
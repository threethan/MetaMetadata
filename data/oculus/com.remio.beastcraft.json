AcLSkE&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFtPNjolbm2cfr51f9Il2gdXRwZe0p0W-pYfxCs68Izfw&oe=6A917D05"}, {"file_name": "Screenshot 2024-04-26 at 12.17.28 AM.png", "id": "435321545745867", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/75622009_435321549079200_2974455210166216529_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xCQDMB2PYXMQ7kNvwFigNnB&_nc_oc=AdpiBybPyrBMiZPEjAqA6eR8C5a7ugejrbEd2Wxeh8FZZwgk3dK7C3swEQ6jwiDVqqo&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGFWVjkQIfJs6zO5Uq-twKRLpJWtbwaRoc7R1EoLlnJ0A&oe=6A917873"}, {"file_name": "Screenshot 2024-04-26 at 1.02.32 AM.png", "id": "1879740189143965", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/39035403_1879740192477298_67763767635381086_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ijW-nhH482sQ7kNvwHFlbgQ&_nc_oc=Adq3v6gRfs5bN7K4wFxNPPTLD_mQfnycGyn0P54J6XknZ72zNk6k9LUaAoXZZeLPSjw&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEytx92tqKBFjGGdrpqcNfJ9hrD7mFfDZHzx0X-JcXwgQ&oe=6A9179DA"}, {"file_name": "Screenshot 2024-04-26 at 1.05.52 AM.png", "id": "364008362727318", "uri": "https://scontent-hkg1-1.oculuscdn.com/v/t64.5771-25/39003285_364008366060651_8273232648582101348_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GlI3B6N69U0Q7kNvwHas4-Q&_nc_oc=AdoahGDeWi_j8g1pplNgmzRFrPOiYyD3htGo_8viJS4XFzrrIRIo8Pj2v-hXYpS9B90&_nc_zt=3&_nc_ht=scontent-hkg1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGGniCM3Y14Xb1yBEYE0YlWlSup3wie-LE1BuT9J3u3DQ&oe=6A917B68"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Screenshot 2024-04-26 at 12.19.50 AM.png", "id": "1254133988879668", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/75542964_1254133992213001_1426704643780221508_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SniKR6INxigQ7kNvwF7Ofnb&_nc_oc=AdpVjSltNoD93jswbbNisGK6eBgRTNeAZn0lEB7YheoqPXvpB0wvpceCrKnTDTB28MQ&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFqDrx8AebLF94ivc--0yvoCLN19ZRVaJ23W-PgngFuGw&oe=6A918379"}, "display_name": "Beastcraft", "keywords": [], "long_description": "Immerse yourself in \"Beastcraft,\" a voxel-based virtual reality world where friendship, creativity, and strategy collide. In this dynamic multiplayer game, players can create, save, and publish their own worlds, sharing their creativity with a global community. Choose your avatar from an eclectic roster, including killer sharks, mysterious aliens, agile cats, undead zombies, formidable ogres, and playful pandas. Each avatar brings a unique perspective to your adventures and construction efforts.\n\nWield an array of unique weapons, ranging from simple plungers to the mighty Thor's Hammer, tailoring your combat style to suit your strategic needs. Engage in exhilarating gameplay modes such as the infectious \"Infected Mode,\" where tagging becomes a thrilling chase, or join forces in clans to build and destroy fortresses in strategic battles that test your teamwork and creativity.\n\n\"Beastcraft\" is more than just a game; it's a platform for expression and interaction. Build elaborate structures, devise complex game strategies, or simply explore the vast, player-created landscapes. Whether you\u2019re battling it out with other avatars, constructing monumental edifices, or contributing to your clan's dominion, every action in \"Beastcraft\" shapes your experience in this endlessly evolving VR universe. Explore, build, battle, and connect in \"Beastcraft\" \u2014 where your imagination is your greatest weapon.", "short_description": "Make friends a voxel-based VR world where you can create, save, and publish your own worlds. Choose from avatars like killer sharks, aliens, cats, zombies, ogres, and pandas while wielding unique weapons from plungers to Thor's Hammer in this dynamic multiplayer game. Tag each other in infected mode, or join clans, building and destroying fortresses. In Beastcraft, you create your experience."}]}, "developer_name": null, "developer_p
5/39035403_1879740192477298_67763767635381086_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DoF4joep76kQ7kNvwGbwRnh&_nc_oc=AdmUq7XGNQiNijCRY8TJevlulzgEp2hw99zWwxhuRd9RNEafsoZDYTdKvwts9zySe4k&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_Afwb5_o2YU3vB10BaVz5UuWE0JH--cCfY1EYNXOv_cNQRw&oe=69BE89DA"}, {"file_name": "Screenshot 2024-04-26 at 1.05.52 AM.png", "id": "364008362727318", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39003285_364008366060651_8273232648582101348_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XIvGFICwK-AQ7kNvwGq5oEB&_nc_oc=AdmGiV2ce3Mxokb0yWhzCSRxRm5zndWlZ_yM3WcAnVQoeUX-ei4v2vL4QYmRzCTrmLA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfzV1s9CQ3QRFUB2lqkLhTBQmXdpyYEuxOHb_pv0UrF0dw&oe=69BE8B68"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Screenshot 2024-04-26 at 12.19.50 AM.png", "id": "1254133988879668", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75542964_1254133992213001_1426704643780221508_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xlyrci7AfFkQ7kNvwFz-HUF&_nc_oc=AdkPCH6nSoW52pI_vVHfrvpkfXzRL-9gXVcGtHKuc_OYboA4-TDHFhelz-IduiNpLOw&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfzNC6hohdOhTw4V5r6WOznRR59f85BHGf8qoU1tRt9Tug&oe=69BE9379"}, "display_name": "Beastcraft", "keywords": [], "long_description": "Immerse yourself in \"Beastcraft,\" a voxel-based virtual reality world where friendship, creativity, and strategy collide. In this dynamic multiplayer game, players can create, save, and publish their own worlds, sharing their creativity with a global community. Choose your avatar from an eclectic roster, including killer sharks, mysterious aliens, agile cats, undead zombies, formidable ogres, and playful pandas. Each avatar brings a unique perspective to your adventures and construction efforts.\n\nWield an array of unique weapons, ranging from simple plungers to the mighty Thor's Hammer, tailoring your combat style to suit your strategic needs. Engage in exhilarating gameplay modes such as the infectious \"Infected Mode,\" where tagging becomes a thrilling chase, or join forces in clans to build and destroy fortresses in strategic battles that test your teamwork and creativity.\n\n\"Beastcraft\" is more than just a game; it's a platform for expression and interaction. Build elaborate structures, devise complex game strategies, or simply explore the vast, player-created landscapes. Whether you\u2019re battling it out with other avatars, constructing monumental edifices, or contributing to your clan's dominion, every action in \"Beastcraft\" shapes your experience in this endlessly evolving VR universe. Explore, build, battle, and connect in \"Beastcraft\" \u2014 where your imagination is your greatest weapon.", "short_description": "Make friends a voxel-based VR world where you can create, save, and publish your own worlds. Choose from avatars like killer sharks, aliens, cats, zombies, ogres, and pandas while wielding unique weapons from plungers to Thor's Hammer in this dynamic multiplayer game. Tag each other in infected mode, or join clans, building and destroying fortresses. In Beastcraft, you create your experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.remiovr.com/beastcraft-privacy-policy", "developer_terms_of_service_url": "https://www.remiovr.com/terms-of-use", "publisher_name": "Future of VR", "support_website_url": "https://www.remiovr.com/contact-us", "website_url": "https://www.remiovr.com/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1725996564472128"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "sup
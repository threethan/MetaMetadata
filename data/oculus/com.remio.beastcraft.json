Q7kNvwF09xu3&_nc_oc=Adp4MWav7cJvO16EOh37vzCChhjUYZtfXmbi5HdK-HPtGUI6zYCBFt2K2sKo1ps_-Zs&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOOLL6MOP4p4TsuAJdlCEwnQKst7WcKY7mNmUt2wcxzoA&oe=6ACE4F19"}, {"file_name": "ss_1.png", "id": "825818046988182", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491823930_825818053654848_5912142274205285217_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5v34lfMecgwQ7kNvwGrxZzA&_nc_oc=AdoJYqL412x6W4Lb-B14UY5AGfbZWD3yFZ69Bm-IxUnzBUhM07uiHJMG7IUvuYVTVK0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOTv9OGw-IB6tEiCxaiJY1dXAcZfvKAG3Ja1Kjz7Ga0fg&oe=6ACE6A54"}, {"file_name": "deer_1.png", "id": "1332717592157844", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491823940_1332717595491177_2494044677614522896_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8lL71Ji23oYQ7kNvwFsGO1O&_nc_oc=Adpnk7KFqF9hOVnrsnkH-cphMazNv35owOrPi9jFDMwisRS7C3SyXDKvtzWNSpJURiE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM7KxBf03Tc7Aa4Xdbb93X92TG-DYliy54ejKgpMzp29A&oe=6ACE3B0B"}, {"file_name": "s.png", "id": "4255777344660911", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491823746_4255777357994243_7334746589021874546_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zBgPbz7GK7cQ7kNvwGagJQl&_nc_oc=Adr323Ax5SMZNRwAc0DARKOkVEjUKCN1TxWcUpi2p3QbQqQafTO68tCTBN9B0QEHBiY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP7KyY0M3OBB7Iw0y2vD3f8Gzszyk7LoN4a8LRS3TkEjA&oe=6ACE682D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "AnimalBlocksCoverArt_2560x1440.png", "id": "1518215032857058", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491825481_1518215036190391_3126051047249417807_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uuP6eTTX4s8Q7kNvwGfuuYm&_nc_oc=AdpJVY5L-UuxQYvnJ47WTxqJl7l3S4retgCwfI3XQk48Qlpv_-XIP8fLtJyJD9_CYRE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPl9nuPTK4uA6GCIY2NXpp_vOI6vds2YEhMPlajGwtZuQ&oe=6ACE61A1"}, "display_name": "Animal Blocks", "keywords": ["sandbox", "multiplayer", "building", "survival", "monsters"], "long_description": "Enter **Animal Blocks**, the chaotic Minecraft-inspired VR sandbox where you build, roleplay, survive, and show off your style. \n\n# **\ud83c\udf34 Battle in Jungle Combat**\nBattle other players, earn XP, and level up different combat classes\u2014each with unique weapons and play styles.\n{1034054556264024}\n\n# **\ud83c\udfae Game Modes** \n- **\ud83c\udf11 Survive 99 Nights** \n{2110015899579189}\n- \ud83e\udddf **Zombies**\n{955142100673993}\n- \ud83d\udd0d **Dark Forest**\n{1008531195001414}\n- \u26cf\ufe0f **Mining**\n{4451251821810128}\n\n# **\ud83e\uddf1 Build and Roleplay**  \nSky bases, bunkers, traps, forts, castles \u2014 it\u2019s all block-based and yours to shape.\n{2909585475894360}\n\n# **\ud83e\uddf0\ud83e\ude84\ud83d\udd2b\ud83d\udd78\ufe0f\ud83e\uddf9 Gadgets, Guns, Weapons!**  \nGrapple hooks, flying brooms, web slingers, sticky bombs, wings, and more!\n\n# **\ud83d\udc3c\ud83e\udd96\ud83d\udc31\ud83e\udd88\ud83d\udc38 Pick Your Animal**  \nBe an axolotl, panda, dinosaur, cat, shark\u2026 or something totally custom.\n\n# **\ud83d\uddfa\ufe0f Explore Player Worlds**  \nJump into wild player-made maps \u2014 or build your own and invite your friends!", "short_description": "Animal Blocks is a game inspired by Gorilla Tag movement mechanics and Minecraft. You can build, play PVP , or try to survive against wild monsters and zombies."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.animalblocksvr.com/privacy-policy", "developer_terms_of_service_url": "https://www.animalblocksvr.com/code-of-conduct", "publisher_name": "RemioVR", "support_website_url": "https://www.animalblocksvr.com/", "website_url": "https://www.animalblocksvr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_ca
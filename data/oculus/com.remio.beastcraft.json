uscdn.com&_nc_ss=7f20f&oh=00_AQJXWldWwUios90n25CKi76R7rr11b5SOh24tIo90LLQrw&oe=6A9D8799"}, {"file_name": "ss_1.png", "id": "825818046988182", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491823930_825818053654848_5912142274205285217_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I--5PWEOlscQ7kNvwFNuqkB&_nc_oc=Adr2K_CuLKH8ssuQOA8zOjbzyJbl7qXgyjyeROyj7TYz6GJhkd_hH560wLn5M_cwVg8&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJqssgSKGHLtnq21yDw3d8fRhlTML71Xrrj_PDn66Q1_w&oe=6A9D6A94"}, {"file_name": "deer_1.png", "id": "1332717592157844", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491823940_1332717595491177_2494044677614522896_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Mw9D8oYXD2sQ7kNvwFt8n3K&_nc_oc=AdpjGvfRev4mBLFAlhz3gkGeBeDZaac2YOdI-56zHT_ahqMYCc-qn8KlAl0pHy4aiyQ&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKKYuPAuW2kIIHa2zCYjXXx5aoe0Gj4j-55oNXcH_xG_A&oe=6A9D738B"}, {"file_name": "s.png", "id": "4255777344660911", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491823746_4255777357994243_7334746589021874546_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JZNgk-csDCcQ7kNvwGVbYxn&_nc_oc=Ado4kiP17Jp7g-O4lXXspRvVjylugFWEESgx8gpc3B0pkkIfCvvgItzma6hGnbGYHis&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKM6DXCL7Mamdvn2LzVmzEr_SLcTKwpt8SWXlV1OhtGIQ&oe=6A9D686D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "AnimalBlocksCoverArt_2560x1440.png", "id": "1518215032857058", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491825481_1518215036190391_3126051047249417807_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YlKeJ_e0mTAQ7kNvwFQ0wvg&_nc_oc=AdrWj_TqrhliwH-j4zHJ2cTPW-O2WTdszXhLE-qnkDQ64Aop06doEc9jasGNzMSMgqY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKyQJwGuM2jiWlFp1oA00pXV9FB0tBsPju6Y8aYekU5Fw&oe=6A9D61E1"}, "display_name": "Animal Blocks", "keywords": ["sandbox", "multiplayer", "building", "survival", "monsters"], "long_description": "Enter **Animal Blocks**, the chaotic Minecraft-inspired VR sandbox where you build, roleplay, survive, and show off your style. \n\n# **\ud83c\udf34 Battle in Jungle Combat**\nBattle other players, earn XP, and level up different combat classes\u2014each with unique weapons and play styles.\n{1034054556264024}\n\n# **\ud83c\udfae Game Modes** \n- **\ud83c\udf11 Survive 99 Nights** \n{2110015899579189}\n- \ud83e\udddf **Zombies**\n{955142100673993}\n- \ud83d\udd0d **Dark Forest**\n{1008531195001414}\n- \u26cf\ufe0f **Mining**\n{4451251821810128}\n\n# **\ud83e\uddf1 Build and Roleplay**  \nSky bases, bunkers, traps, forts, castles \u2014 it\u2019s all block-based and yours to shape.\n{2909585475894360}\n\n# **\ud83e\uddf0\ud83e\ude84\ud83d\udd2b\ud83d\udd78\ufe0f\ud83e\uddf9 Gadgets, Guns, Weapons!**  \nGrapple hooks, flying brooms, web slingers, sticky bombs, wings, and more!\n\n# **\ud83d\udc3c\ud83e\udd96\ud83d\udc31\ud83e\udd88\ud83d\udc38 Pick Your Animal**  \nBe an axolotl, panda, dinosaur, cat, shark\u2026 or something totally custom.\n\n# **\ud83d\uddfa\ufe0f Explore Player Worlds**  \nJump into wild player-made maps \u2014 or build your own and invite your friends!", "short_description": "Animal Blocks is a game inspired by Gorilla Tag movement mechanics and Minecraft. You can build, play PVP , or try to survive against wild monsters and zombies."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.animalblocksvr.com/privacy-policy", "developer_terms_of_service_url": "https://www.animalblocksvr.com/code-of-conduct", "publisher_name": "RemioVR", "support_website_url": "https://www.animalblocksvr.com/", "website_url": "https://www.animalblocksvr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "459781504968480"}, {"id": "644354873106712"}, {"id
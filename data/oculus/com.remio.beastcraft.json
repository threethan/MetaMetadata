z5g&oe=6A3960C5"}, {"file_name": "Screenshot 2024-04-26 at 12.17.28 AM.png", "id": "435321545745867", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/75622009_435321549079200_2974455210166216529_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MLv3jRd9hcoQ7kNvwEEDLjC&_nc_oc=AdokGMYEuZ-QEs22qyjII4hxANo_jZAl0_ODAJGeAK94krSVUgsuYVWho7Ecnit0DgY&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-nEbCkm78V3aTgAONWa2eHVaycWLiexBxuNVxDSKjInA&oe=6A395C33"}, {"file_name": "Screenshot 2024-04-26 at 1.02.32 AM.png", "id": "1879740189143965", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/39035403_1879740192477298_67763767635381086_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y0EZZe26J6wQ7kNvwFC14zc&_nc_oc=AdoqYZWDVdJNjX22Tbk0Mc-BFsxQ2gzMzdlCa-uCVcpSokgFHiUKTcIXXGvm4t0GLPE&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af960-qWlZvuu9WeobsnN0sm45sUX2NVyYEOjKbSiaWRhA&oe=6A395D9A"}, {"file_name": "Screenshot 2024-04-26 at 1.05.52 AM.png", "id": "364008362727318", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/39003285_364008366060651_8273232648582101348_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zAkgu6VNCLAQ7kNvwHQVoPg&_nc_oc=AdppZshzVzwRSWM7hfiNhhwh8lfrGM_QMGR07dCF85pbgIuI458GnkB8FUaGNCSCPPE&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9bSeqGLEbqNS02WiiMjAQzGDIbI8gBbLfxdcvrpuVLhw&oe=6A395F28"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Screenshot 2024-04-26 at 12.19.50 AM.png", "id": "1254133988879668", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/75542964_1254133992213001_1426704643780221508_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sGiHsY2FpwAQ7kNvwFMSQYd&_nc_oc=Adq8HWPJ6fQBhh6YaV2522PJGqZ3PERrynw6Mx6uHmRFKn35Z-XpkA-JBWg7KKM3yT0&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-CW2FpJJWhi6pxPpE-jbP_yLykkx5IEbhqQm1-RyCzlg&oe=6A392EF9"}, "display_name": "Beastcraft", "keywords": [], "long_description": "Immerse yourself in \"Beastcraft,\" a voxel-based virtual reality world where friendship, creativity, and strategy collide. In this dynamic multiplayer game, players can create, save, and publish their own worlds, sharing their creativity with a global community. Choose your avatar from an eclectic roster, including killer sharks, mysterious aliens, agile cats, undead zombies, formidable ogres, and playful pandas. Each avatar brings a unique perspective to your adventures and construction efforts.\n\nWield an array of unique weapons, ranging from simple plungers to the mighty Thor's Hammer, tailoring your combat style to suit your strategic needs. Engage in exhilarating gameplay modes such as the infectious \"Infected Mode,\" where tagging becomes a thrilling chase, or join forces in clans to build and destroy fortresses in strategic battles that test your teamwork and creativity.\n\n\"Beastcraft\" is more than just a game; it's a platform for expression and interaction. Build elaborate structures, devise complex game strategies, or simply explore the vast, player-created landscapes. Whether you\u2019re battling it out with other avatars, constructing monumental edifices, or contributing to your clan's dominion, every action in \"Beastcraft\" shapes your experience in this endlessly evolving VR universe. Explore, build, battle, and connect in \"Beastcraft\" \u2014 where your imagination is your greatest weapon.", "short_description": "Make friends a voxel-based VR world where you can create, save, and publish your own worlds. Choose from avatars like killer sharks, aliens, cats, zombies, ogres, and pandas while wielding unique weapons from plungers to Thor's Hammer in this dynamic multiplayer game. Tag each other in infected mode, or join clans, building and destroying fortresses. In Beastcraft, you create your experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.remiovr.com/beastcraft-privacy-policy", "developer_terms_of_service_url": "htt
uscdn.com&_nc_ss=7f20f&oh=00_AQIR6TpoS9m4vZuZtbK7pqiaX-J6ZAi6BNyoRFAvqBDbHA&oe=6A9AE499"}, {"file_name": "ss_1.png", "id": "825818046988182", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/491823930_825818053654848_5912142274205285217_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j-dILlOmcJwQ7kNvwGd0Ux8&_nc_oc=AdpCKmLR6DxZawZm81Yubt8a8njD9JyWYHVrT_aZVyxahzggnF42RnnOd--S7UwkcG0&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJNQ4Rd-6N7SuXCGy8rFlh1h9Iqq1LkxAUjlXQltE3kww&oe=6A9AC794"}, {"file_name": "deer_1.png", "id": "1332717592157844", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/491823940_1332717595491177_2494044677614522896_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sxosos-B4IkQ7kNvwGFQlXi&_nc_oc=Ado8NgFovVCtlZA2_PckrFh3T8AoXFKsrmgPRzQxJPVU6MCLqcqIWLnvZe8rNzKZN5Y&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIwj49YTGQHTCGkK2FVUmdgRFIuRaDhX2Wv2DVNq-eFfA&oe=6A9AD08B"}, {"file_name": "s.png", "id": "4255777344660911", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/491823746_4255777357994243_7334746589021874546_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5FUh0zrEU0YQ7kNvwEOcl0k&_nc_oc=AdrEPug8XL6ihUddw9ZWxnTDnG5cShyVT3K-KARhswrBFvSDGJnuRLD_NvHSRMfyH_Q&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJCQk1HsOstAaXdbUBDwZ-Jj1neg5ciXbEZb7h5nv0KKQ&oe=6A9AC56D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "AnimalBlocksCoverArt_2560x1440.png", "id": "1518215032857058", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/491825481_1518215036190391_3126051047249417807_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9RdWjF_cWKoQ7kNvwE2Mh6R&_nc_oc=AdquuJPgml5TkQFUXx4Ven_GdBR95xvxS_qDwvaln7Sk2m_2unz2jPff-Wix3A4UnBY&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL_VnGbN_2C9fdgDSvfa95zepe_cj1ydp8WPgxl0F5IOQ&oe=6A9ABEE1"}, "display_name": "Animal Blocks", "keywords": ["sandbox", "multiplayer", "building", "survival", "monsters"], "long_description": "Enter **Animal Blocks**, the chaotic Minecraft-inspired VR sandbox where you build, roleplay, survive, and show off your style. \n\n# **\ud83c\udf34 Battle in Jungle Combat**\nBattle other players, earn XP, and level up different combat classes\u2014each with unique weapons and play styles.\n{1034054556264024}\n\n# **\ud83c\udfae Game Modes** \n- **\ud83c\udf11 Survive 99 Nights** \n{2110015899579189}\n- \ud83e\udddf **Zombies**\n{955142100673993}\n- \ud83d\udd0d **Dark Forest**\n{1008531195001414}\n- \u26cf\ufe0f **Mining**\n{4451251821810128}\n\n# **\ud83e\uddf1 Build and Roleplay**  \nSky bases, bunkers, traps, forts, castles \u2014 it\u2019s all block-based and yours to shape.\n{2909585475894360}\n\n# **\ud83e\uddf0\ud83e\ude84\ud83d\udd2b\ud83d\udd78\ufe0f\ud83e\uddf9 Gadgets, Guns, Weapons!**  \nGrapple hooks, flying brooms, web slingers, sticky bombs, wings, and more!\n\n# **\ud83d\udc3c\ud83e\udd96\ud83d\udc31\ud83e\udd88\ud83d\udc38 Pick Your Animal**  \nBe an axolotl, panda, dinosaur, cat, shark\u2026 or something totally custom.\n\n# **\ud83d\uddfa\ufe0f Explore Player Worlds**  \nJump into wild player-made maps \u2014 or build your own and invite your friends!", "short_description": "Animal Blocks is a game inspired by Gorilla Tag movement mechanics and Minecraft. You can build, play PVP , or try to survive against wild monsters and zombies."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.animalblocksvr.com/privacy-policy", "developer_terms_of_service_url": "https://www.animalblocksvr.com/code-of-conduct", "publisher_name": "RemioVR", "support_website_url": "https://www.animalblocksvr.com/", "website_url": "https://www.animalblocksvr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "459781504968480"}, {"id": "644354873106712"}, {"id
_777325882876845850_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7HXUhZA0z8sQ7kNvwEptW2S&_nc_oc=AdqKnirz4r6lhJsitqg7-7h0ygupzPZSfRajUrEBSBy7foVT3A-vJ5iaIlw1541sGJc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKWS-oRmusxsWACjj8RSYY4SRzdVeIZed77vk1jQJr1Qw&oe=6AB7B885"}, {"file_name": "Screenshot 2024-04-26 at 12.17.28 AM.png", "id": "435321545745867", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75622009_435321549079200_2974455210166216529_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YexRmiLDazAQ7kNvwEwg6ge&_nc_oc=AdrxiIl1ptvOYZMH_d8WZpA8XzR6-VujB-dpHjWlZx56NFzst3HiXwPCsWhQdxOR5Go&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLPmjZPjvQaSQYfJr3UZPGa4Fx4DjS9lvMx136YF6ca4A&oe=6AB7EC33"}, {"file_name": "Screenshot 2024-04-26 at 1.02.32 AM.png", "id": "1879740189143965", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39035403_1879740192477298_67763767635381086_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lXRCugzY35wQ7kNvwGGgI-n&_nc_oc=Adr8lpj5_M0U6jBKMHpbQRBT3rtqlL6B9fTKNERlwqpEdCIXLJzjsNm6Qu4Ms3Wl3Mw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIvmyi-q18vcrQh49n3uqv6AAR_XPBfJjE02AH4gH1htQ&oe=6AB7ED9A"}, {"file_name": "Screenshot 2024-04-26 at 1.05.52 AM.png", "id": "364008362727318", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39003285_364008366060651_8273232648582101348_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OBdzcA3e_EIQ7kNvwGdE4rs&_nc_oc=AdqAgU0EdHCHwzRYJRr4B2z_JmJdNa8XEvn6p1Xeqc-_33UTivmaIBxUhFrU2vbQ7NM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK-HhTquIOveu5FDl3xdbMAOu5YdADJO9sGoT4aKtAS6w&oe=6AB7EF28"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Screenshot 2024-04-26 at 12.19.50 AM.png", "id": "1254133988879668", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75542964_1254133992213001_1426704643780221508_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_0Hx9m8xjUwQ7kNvwHRYQQS&_nc_oc=AdpYTXO4TZ9i6xLUf2dKk_DcQAmEVvCgnH68Resertl8CLJaAZ4ydj8sP8UWFR8kl_o&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ5OFUFXkmgsDsvV_960FpjDUhRviM05wQrsFV5g_INhw&oe=6AB7BEF9"}, "display_name": "Beastcraft", "keywords": [], "long_description": "Immerse yourself in \"Beastcraft,\" a voxel-based virtual reality world where friendship, creativity, and strategy collide. In this dynamic multiplayer game, players can create, save, and publish their own worlds, sharing their creativity with a global community. Choose your avatar from an eclectic roster, including killer sharks, mysterious aliens, agile cats, undead zombies, formidable ogres, and playful pandas. Each avatar brings a unique perspective to your adventures and construction efforts.\n\nWield an array of unique weapons, ranging from simple plungers to the mighty Thor's Hammer, tailoring your combat style to suit your strategic needs. Engage in exhilarating gameplay modes such as the infectious \"Infected Mode,\" where tagging becomes a thrilling chase, or join forces in clans to build and destroy fortresses in strategic battles that test your teamwork and creativity.\n\n\"Beastcraft\" is more than just a game; it's a platform for expression and interaction. Build elaborate structures, devise complex game strategies, or simply explore the vast, player-created landscapes. Whether you\u2019re battling it out with other avatars, constructing monumental edifices, or contributing to your clan's dominion, every action in \"Beastcraft\" shapes your experience in this endlessly evolving VR universe. Explore, build, battle, and connect in \"Beastcraft\" \u2014 where your imagination is your greatest weapon.", "short_description": "Make friends a voxel-based VR world where you can create, save, and publish your own worlds. Choose from avatars like killer sharks, aliens, cats, zombies, ogres, and pandas while wielding unique weapons from plungers to Thor's Hammer in this dynamic multiplayer game. Tag each other in infected mode, or join clans, building and destroying fortresses. In Beastcraft, you create your experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.remiovr.com/beastcraft-privacy-policy", "developer_terms_of_service_url": "https://www.remiovr.com/terms-of-use", "publisher_name": "Future of VR", "support_website_url": "https://www.remiovr.com/contact-us", "website_url": "https://www.remiovr.com/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1725996564472128"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "26431677296431367"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1102873464158007"}]}, "baseline_offer": {"id": "1102873464158007"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1715981833, "status": "PUBLISHED", "id": "1102873464158007"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "39882252638040365", "version": "2.241"}, "id": "314945788285433", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "26317184997880598", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "39882252638040365"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{
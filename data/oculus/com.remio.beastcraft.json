reenshots": [{"file_name": "Screenshot 2024-04-26 at 1.36.29 AM.png", "id": "397375406455902", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/57569483_397375409789235_9167516067076574827_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5khfGlf9YiEQ7kNvwHsvAdW&_nc_oc=Ado4Y0BbR-i9IAdEbugeriKW22y2EGH4wVakk8JfW-1H_62vGocbz_aJ6-6bDyfW8Po&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS1Siur-quVkHqTzNBb9FZS8hHYRbkC3Ip8BaN53yMtSA&oe=6B032FF8"}, {"file_name": "Screenshot 2024-04-26 at 12.25.47 AM.png", "id": "3307224682920421", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974627_3307224686253754_777325882876845850_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0xyeOhF-isQQ7kNvwGAql6q&_nc_oc=AdonBegDGwESYBAMG-ZcD8hGEBTXx3kbPowx3KcsMGJ_UD0ZX0ilyONo6JH8qJAlTIY&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSyi3tgKfybHFbCIMMKNMuv6X-pU6G0WngCDeuUZpd1EQ&oe=6B031645"}, {"file_name": "Screenshot 2024-04-26 at 12.17.28 AM.png", "id": "435321545745867", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75622009_435321549079200_2974455210166216529_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FSYKIH6iAcAQ7kNvwGxZq5I&_nc_oc=AdoUmm1Xj7aJububcAsb8cePaUECKaR9e5xaezhNINelhZL6PGNkMUIXeNrEaSc2Rsg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSQxVwn_idPm0Cw_5VgVUUrOAaOap4PzlxZ7IHxfKXQGQ&oe=6B0311B3"}, {"file_name": "Screenshot 2024-04-26 at 1.02.32 AM.png", "id": "1879740189143965", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39035403_1879740192477298_67763767635381086_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lXaKkC62ipEQ7kNvwHEzY-9&_nc_oc=AdrWUzxW4xL3u99TDuOaE1stUb3cZEy3tK7Ef75Mmk64XnV4vZVqR-amtyyJ75xyKYc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQoBXfO2DrsXn1nSqZUw0RuUowOPI3gu8ysMYjp5OUPFg&oe=6B03131A"}, {"file_name": "Screenshot 2024-04-26 at 1.05.52 AM.png", "id": "364008362727318", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39003285_364008366060651_8273232648582101348_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LzCo_hn61-wQ7kNvwGlLNMn&_nc_oc=AdoD4y_PK4h6hFZrWhwXmXZAShDwnQsUJtIrE-FnPUCrJ1qDGQ5VuWwmOhawhHnLtXc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT61A_5seogw2h26SynzI7gpy89wNde7D_LDd_MRyzWyw&oe=6B0314A8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Screenshot 2024-04-26 at 12.19.50 AM.png", "id": "1254133988879668", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75542964_1254133992213001_1426704643780221508_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kCCrE03-kvsQ7kNvwE9dE3_&_nc_oc=Adq1k8LK3tYHXUmkcyaG4NXY5I6N3rHf3EqVuP51GTWTb2AAzgLiZJP_fhBxUxMqBzM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTG8YfAfLOokYuMw4ec28FqdchJiKbhNxmFhHEC62Uf6A&oe=6B031CB9"}, "display_name": "Beastcraft", "keywords": [], "long_description": "Immerse yourself in \"Beastcraft,\" a voxel-based virtual reality world where friendship, creativity, and strategy collide. In this dynamic multiplayer game, players can create, save, and publish their own worlds, sharing their creativity with a global community. Choose your avatar from an eclectic roster, including killer sharks, mysterious aliens, agile cats, undead zombies, formidable ogres, and playful pandas. Each avatar brings a unique perspective to your adventures and construction efforts.\n\nWield an array of unique weapons, ranging from simple plungers to the mighty Thor's Hammer, tailoring your combat style to suit your strategic needs. Engage in exhilarating gameplay modes such as the infectious \"Infected Mode,\" where tagging becomes a thrilling chase, or join forces in clans to build and destroy fortresses in strategic battles that test your teamwork and creativity.\n\n\"Beastcraft\" is more than just a game; it's a platform for expression and interaction. Build elaborate structures, devise complex game strategies, or simply explore the vast, player-created landscapes. Whether you\u2019re battling it out with other avatars, constructing monumental edifices, or contributing to your clan's dominion, every action in \"Beastcraft\" shapes your experience in this endlessly evolving VR universe. Explore, build, battle, and connect in \"Beastcraft\" \u2014 where your imagination is your greatest weapon.", "short_description": "Make friends a voxel-based VR world where you can create, save, and publish your own worlds. Choose from avatars like killer sharks, aliens, cats, zombies, ogres, and pandas while wielding unique weapons from plungers to Thor's Hammer in this dynamic multiplayer game. Tag each other in infected mode, or join clans, building and destroying fortresses. In Beastcraft, you create your experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.remiovr.com/beastcraft-privacy-policy", "developer_terms_of_service_url": "https://www.remiovr.com/terms-of-use", "publisher_name": "Future of VR", "support_website_url": "https://www.remiovr.com/contact-us", "website_url": "https://www.remiovr.com/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1725996564472128"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "26431677296431367"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1102
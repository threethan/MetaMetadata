Q7kNvwEoOHMI&_nc_oc=AdqrM4Pqu2vZ0YoKYi2rVV8zmIBl8nURqyFEUkRJpzPE8ZOAK-DS0XqzrdFj3IgQsLU&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSP3pU8HVicRjcnHs_3PiALAp5pNbe7ZScq8IOIsXCuvw&oe=6AF33919"}, {"file_name": "ss_1.png", "id": "825818046988182", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491823930_825818053654848_5912142274205285217_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i1GI5K6h5I0Q7kNvwHskHvV&_nc_oc=Adq0JyO7Q9kmUis4uMfPxjMdk4ibF_RooMKgGEJJyTg2WgiQ6bLb64jposGeF5I1zyY&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRhvAQhoXRwD0RYaCgVOEvY6U3GKDNKSMrCz7mn4RlCVg&oe=6AF35454"}, {"file_name": "deer_1.png", "id": "1332717592157844", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491823940_1332717595491177_2494044677614522896_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z82_L0tHM68Q7kNvwGJId8c&_nc_oc=Adpu4os2tm5zLahxIckmP4y_ESAunNF16SMP8yvbxJC0eW_vCowHof11i2NdbPr7H9Y&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRTKvLodkLc2vkSofgsJfRGIJu6vAPKV3mO4qgzPlB6aw&oe=6AF3250B"}, {"file_name": "s.png", "id": "4255777344660911", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491823746_4255777357994243_7334746589021874546_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cxR-GXp1GmsQ7kNvwEVK3YN&_nc_oc=Ado8QkMVFVFp0lnAKaFuBD1X9FOqAMdFeG_7FiXvgpyJBiJArGx4HhtHAarU1rNUm2U&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS036NQg8Vsq2NgpwOAyvmj6NTXLaDDSVeYuLKvxP0Etg&oe=6AF3522D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "AnimalBlocksCoverArt_2560x1440.png", "id": "1518215032857058", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491825481_1518215036190391_3126051047249417807_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IF-vrqxXR-IQ7kNvwE6Vn4n&_nc_oc=AdqF01dK_GAHlIVMOxwlk29s4Bc7LGOaEQ5DDOguCPB93SGJaDkB3SwUbziQAkq5Y80&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTBkd3Gb0NsGxyjJK3gJ3jJ-8Qx6HC1Ya43f1BUkkzSRQ&oe=6AF34BA1"}, "display_name": "Animal Blocks", "keywords": ["sandbox", "multiplayer", "building", "survival", "monsters"], "long_description": "Enter **Animal Blocks**, the chaotic Minecraft-inspired VR sandbox where you build, roleplay, survive, and show off your style. \n\n# **\ud83c\udf34 Battle in Jungle Combat**\nBattle other players, earn XP, and level up different combat classes\u2014each with unique weapons and play styles.\n{1034054556264024}\n\n# **\ud83c\udfae Game Modes** \n- **\ud83c\udf11 Survive 99 Nights** \n{2110015899579189}\n- \ud83e\udddf **Zombies**\n{955142100673993}\n- \ud83d\udd0d **Dark Forest**\n{1008531195001414}\n- \u26cf\ufe0f **Mining**\n{4451251821810128}\n\n# **\ud83e\uddf1 Build and Roleplay**  \nSky bases, bunkers, traps, forts, castles \u2014 it\u2019s all block-based and yours to shape.\n{2909585475894360}\n\n# **\ud83e\uddf0\ud83e\ude84\ud83d\udd2b\ud83d\udd78\ufe0f\ud83e\uddf9 Gadgets, Guns, Weapons!**  \nGrapple hooks, flying brooms, web slingers, sticky bombs, wings, and more!\n\n# **\ud83d\udc3c\ud83e\udd96\ud83d\udc31\ud83e\udd88\ud83d\udc38 Pick Your Animal**  \nBe an axolotl, panda, dinosaur, cat, shark\u2026 or something totally custom.\n\n# **\ud83d\uddfa\ufe0f Explore Player Worlds**  \nJump into wild player-made maps \u2014 or build your own and invite your friends!", "short_description": "Animal Blocks is a game inspired by Gorilla Tag movement mechanics and Minecraft. You can build, play PVP , or try to survive against wild monsters and zombies."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.animalblocksvr.com/privacy-policy", "developer_terms_of_service_url": "https://www.animalblocksvr.com/code-of-conduct", "publisher_name": "RemioVR", "support_website_url": "https://www.animalblocksvr.com/", "website_url": "https://www.animalblocksvr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_ca
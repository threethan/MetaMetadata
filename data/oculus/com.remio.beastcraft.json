f20f&oh=00_AQD0o5jKXY_aOZZYRar4xYMH7J2L8J2ggZI3nBIGfsweuw&oe=6A54E814"}, {"file_name": "deer_1.png", "id": "1332717592157844", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491823940_1332717595491177_2494044677614522896_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zlpQPTDY7UkQ7kNvwGsLxbf&_nc_oc=AdpaqS0zPfamjk506HEBeUrSvBmE0cMFgo0APffyPzBIFRIz0KfzFJ-afhMVHZExFWs&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDWNEY6uxpTCBiwhjM87aLda7ZsdaJFeisNA_VQ3NCS_g&oe=6A54F10B"}, {"file_name": "ss_fire.png", "id": "983148271233690", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491823790_983148274567023_2120001592240190564_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=akKwClHiM_sQ7kNvwHGcs2G&_nc_oc=AdruYS7p4F_S2dVhEdQ6JPksrHrfxwppUSI5K5Iqylwr_1chodNXIg47QFt-V2L3BbE&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBRFbOHRP7uQAo9SujDlrn_J_TuVKoCh-89y8itGD1-aQ&oe=6A54FF0F"}, {"file_name": "s.png", "id": "4255777344660911", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491823746_4255777357994243_7334746589021874546_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bTvKwct8O1oQ7kNvwGhZhVN&_nc_oc=AdovvTy5d_pNb6Gj5hfGUuYopWne8kpJV5zWiwwVvOMWBiv5fRwVQIGjisBmgw0GhJc&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCCbPIlhMkQ1Pr4saZUNEbIU7OvCy4rJFcCy-S3Fq5JNA&oe=6A54E5ED"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "AnimalBlocksCarts_2560x1440_03.png", "id": "1011506208453365", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/499312454_1011506211786698_7720303956786300647_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aOxdBFDRS4cQ7kNvwE0dWXc&_nc_oc=AdocNcIqesnge1zGCckqjO-euJM6Xk6MyCj2xcVbHi3YzcpuPv6czrGv_2X-svtiS9I&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCNZVE9O9GdoSzNGtqKHcdYCv6ix67PY2NdnaUHLQN-PQ&oe=6A54F871"}, "display_name": "Animal Blocks", "keywords": ["sandbox", "multiplayer", "building", "survival", "monsters"], "long_description": "Enter **Animal Blocks**, the chaotic Minecraft-inspired VR sandbox where you build, roleplay, survive, and show off your style. \n\n# **\ud83e\uddf1 Build and Roleplay in Blockhaven**  \nSky bases, bunkers, traps, forts, castles \u2014 it\u2019s all block-based and yours to shape.\n{2909585475894360}\n\n# **\ud83c\udfae Game Modes** \n- **\ud83c\udf11 Survive 99 Nights** \n{2110015899579189}\n- \ud83e\udddf **Zombies**\n{955142100673993}\n- \ud83d\udd0d **Dark Forest**\n{1008531195001414}\n- \u26cf\ufe0f **Mining**\n{4451251821810128}\n- \ud83e\uddf1 **Creative**\n{1811662810005411}\n\n# **\ud83e\uddf0\ud83e\ude84\ud83d\udd2b\ud83d\udd78\ufe0f\ud83e\uddf9 Gadgets, Guns, Weapons!**  \nGrapple hooks, flying brooms, web slingers, sticky bombs, wings, and more!\n\n# **\ud83d\udc3c\ud83e\udd96\ud83d\udc31\ud83e\udd88\ud83d\udc38 Pick Your Animal**  \nBe an axolotl, panda, dinosaur, cat, shark\u2026 or something totally custom.\n\n# **\ud83d\uddfa\ufe0f Explore Player Worlds**  \nJump into wild player-made maps \u2014 or build your own and invite your friends!", "short_description": "Animal Blocks is a game inspired by Gorilla Tag movement mechanics and Minecraft. You can build, play PVP , or try to survive against wild monsters and zombies."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.animalblocksvr.com/privacy-policy", "developer_terms_of_service_url": "https://www.animalblocksvr.com/code-of-conduct", "publisher_name": "RemioVR", "support_website_url": "https://www.animalblocksvr.com/", "website_url": "https://www.animalblocksvr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "459781504968480"}, {"id": "644354873106712"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQ
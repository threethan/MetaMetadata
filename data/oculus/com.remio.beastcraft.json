.47 AM.png", "id": "3307224682920421", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974627_3307224686253754_777325882876845850_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OeCxKctWHa8Q7kNvwEwGD6E&_nc_oc=AdoNEfWROzQi6xn-OBawBzPt91unvngt_tmjUCdTMUrvuND0TvBELocSJc7tweUsQ7w&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM1heCtDIGc1A5p8i1HxElEp78owIstC6QClhmiKwjm0Q&oe=6AE1E885"}, {"file_name": "Screenshot 2024-04-26 at 12.17.28 AM.png", "id": "435321545745867", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75622009_435321549079200_2974455210166216529_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JqDRVKnNcHAQ7kNvwElrjs3&_nc_oc=AdoCEMDWN7nvc003d1kdz_sLGjHPYhTx0xLq59vGIajx4-b_f2Nu5ggN3wokbZ-rRAM&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP_0Y-w90NNJzGzx40p4ASCgGLFL1lhhnOIZD7NmvUvVA&oe=6AE21C33"}, {"file_name": "Screenshot 2024-04-26 at 1.02.32 AM.png", "id": "1879740189143965", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39035403_1879740192477298_67763767635381086_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bcuhK23lrGUQ7kNvwFNQbOT&_nc_oc=AdpX34BDlamI4Y6vkPbn8H5IhaXgSBRz9EZMI7yoK899MT4vb3__mwyRVnk2lPFEe14&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMzlg4_CilEnUTjMdzeIELCbNJOPXNK7vnVPSh-ukDomA&oe=6AE21D9A"}, {"file_name": "Screenshot 2024-04-26 at 1.05.52 AM.png", "id": "364008362727318", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39003285_364008366060651_8273232648582101348_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eCaxzJUXxA0Q7kNvwG_064D&_nc_oc=AdpNNgw7IqZlblfvPxDgmf7QyhM5zmKFNapBcaUBX9VdtNBJix7EQgjGqtbBgmxusOs&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPGJZlYyhLiulVtLup1AzESPv5SSe6iZ_EvfBLMK1zuug&oe=6AE21F28"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Screenshot 2024-04-26 at 12.19.50 AM.png", "id": "1254133988879668", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75542964_1254133992213001_1426704643780221508_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tGgjDFdKOzIQ7kNvwGXY_s1&_nc_oc=AdpLp7bfxIE2N64AhCAOnJn-laB1Wa4-v6zgiBpc64bKw0UfQNzkHHt6QssJvslw9W8&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNwKSD0v1_QlE7kCcA6bpoco4mDpCLrcki92tIKtUg28g&oe=6AE1EEF9"}, "display_name": "Beastcraft", "keywords": [], "long_description": "Immerse yourself in \"Beastcraft,\" a voxel-based virtual reality world where friendship, creativity, and strategy collide. In this dynamic multiplayer game, players can create, save, and publish their own worlds, sharing their creativity with a global community. Choose your avatar from an eclectic roster, including killer sharks, mysterious aliens, agile cats, undead zombies, formidable ogres, and playful pandas. Each avatar brings a unique perspective to your adventures and construction efforts.\n\nWield an array of unique weapons, ranging from simple plungers to the mighty Thor's Hammer, tailoring your combat style to suit your strategic needs. Engage in exhilarating gameplay modes such as the infectious \"Infected Mode,\" where tagging becomes a thrilling chase, or join forces in clans to build and destroy fortresses in strategic battles that test your teamwork and creativity.\n\n\"Beastcraft\" is more than just a game; it's a platform for expression and interaction. Build elaborate structures, devise complex game strategies, or simply explore the vast, player-created landscapes. Whether you\u2019re battling it out with other avatars, constructing monumental edifices, or contributing to your clan's dominion, every action in \"Beastcraft\" shapes your experience in this endlessly evolving VR universe. Explore, build, battle, and connect in \"Beastcraft\" \u2014 where your imagination is your greatest weapon.", "short_description": "Make friends a voxel-based VR world where you can create, save, and publish your own worlds. Choose from avatars like killer sharks, aliens, cats, zombies, ogres, and pandas while wielding unique weapons from plungers to Thor's Hammer in this dynamic multiplayer game. Tag each other in infected mode, or join clans, building and destroying fortresses. In Beastcraft, you create your experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.remiovr.com/beastcraft-privacy-policy", "developer_terms_of_service_url": "https://www.remiovr.com/terms-of-use", "publisher_name": "Future of VR", "support_website_url": "https://www.remiovr.com/contact-us", "website_url": "https://www.remiovr.com/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1725996564472128"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "26431677296431367"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1102873464158007"}]}, "baseline_offer": {"id": "1102873464158007"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1715981833, "status": "PUBLISHED", "id": "1102873464158007"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "40795820396683580", "version": "2.243"}, "id": "314945788285433", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "26317184997880598", "is_concept": false, "latest_released_binary": {"__ty
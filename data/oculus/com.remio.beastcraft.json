ORSDI1oRJb1GLAfpTAAEaUvYhI8&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFgNTnCg-B_UeLXsTgihRB1tF7q24WqNwa9-p6hDrWG6A&oe=6A8D8885"}, {"file_name": "Screenshot 2024-04-26 at 12.17.28 AM.png", "id": "435321545745867", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/75622009_435321549079200_2974455210166216529_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=X_kK_aP7DRoQ7kNvwExgv2W&_nc_oc=Adoco3AgJ4QrAY70ivD3_5GaOuj5b7FETrX2O-5c1oPB5MgLsxQZS_E6_DNUYtIrfKM&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHrJ5VBi9JJvO46aURJdufHlTMf_s8osTvm_6iCKfkyVA&oe=6A8D83F3"}, {"file_name": "Screenshot 2024-04-26 at 1.02.32 AM.png", "id": "1879740189143965", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/39035403_1879740192477298_67763767635381086_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YxGL8DZPsmkQ7kNvwGONae3&_nc_oc=AdqnDEuRMrxjJH6F-YlDBUV8ZSN-g8LVHLnawD0G1PI9bpkWTkJaDnm762BtAW-j0iA&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGhuhV11BqgiqDbrJ4Wu-4Z7EYx1cDc2b5iuoTJOE_gNw&oe=6A8D855A"}, {"file_name": "Screenshot 2024-04-26 at 1.05.52 AM.png", "id": "364008362727318", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/39003285_364008366060651_8273232648582101348_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aa0Q0Uh3rM8Q7kNvwEvTFtH&_nc_oc=AdoI0GtcMoMYNwat2Z2HQrTnq7p_w4PjNS_8au9VTSRZQZ1U60S-ZhH7R7dDXXc9gsM&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGA6diGYWzoEPxoe9oj9Rk0cglm26L7QQH5Qpnc1vx61g&oe=6A8D86E8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Screenshot 2024-04-26 at 12.19.50 AM.png", "id": "1254133988879668", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/75542964_1254133992213001_1426704643780221508_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2uKhyH-xNtkQ7kNvwHSovtU&_nc_oc=Adp3qu0rAbVEALbQK5VTRziNPk3GR3iqP66BwNn5wSPSd1METwG4oHQXle0bZgDJ1XY&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEDuQH9NsWhEiUJQGmLwKU5oFnJMLDAudyVLB2S-hC1sw&oe=6A8D8EF9"}, "display_name": "Beastcraft", "keywords": [], "long_description": "Immerse yourself in \"Beastcraft,\" a voxel-based virtual reality world where friendship, creativity, and strategy collide. In this dynamic multiplayer game, players can create, save, and publish their own worlds, sharing their creativity with a global community. Choose your avatar from an eclectic roster, including killer sharks, mysterious aliens, agile cats, undead zombies, formidable ogres, and playful pandas. Each avatar brings a unique perspective to your adventures and construction efforts.\n\nWield an array of unique weapons, ranging from simple plungers to the mighty Thor's Hammer, tailoring your combat style to suit your strategic needs. Engage in exhilarating gameplay modes such as the infectious \"Infected Mode,\" where tagging becomes a thrilling chase, or join forces in clans to build and destroy fortresses in strategic battles that test your teamwork and creativity.\n\n\"Beastcraft\" is more than just a game; it's a platform for expression and interaction. Build elaborate structures, devise complex game strategies, or simply explore the vast, player-created landscapes. Whether you\u2019re battling it out with other avatars, constructing monumental edifices, or contributing to your clan's dominion, every action in \"Beastcraft\" shapes your experience in this endlessly evolving VR universe. Explore, build, battle, and connect in \"Beastcraft\" \u2014 where your imagination is your greatest weapon.", "short_description": "Make friends a voxel-based VR world where you can create, save, and publish your own worlds. Choose from avatars like killer sharks, aliens, cats, zombies, ogres, and pandas while wielding unique weapons from plungers to Thor's Hammer in this dynamic multiplayer game. Tag each other in infected mode, or join clans, building and destroying fortresses. In Beastcraft, you create your experience."}]}, "developer_n
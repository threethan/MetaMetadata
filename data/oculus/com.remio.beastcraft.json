uscdn.com&_nc_ss=7f20f&oh=00_AQE_Uff_j2u50umYG9jW3Yev-vTvSoQSh1ofjl-aw6VS7g&oe=6A82F159"}, {"file_name": "ss_1.png", "id": "825818046988182", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491823930_825818053654848_5912142274205285217_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xl3Kb_Fo1c4Q7kNvwHprMQS&_nc_oc=Adpkwmz2BwCKIb147PyTDVGSKQPlHSmorZCsA2zb3SSwCbbNNTMNJ260ETpm86aEbhQ&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEx799F0lkdsauko0ah0WvH0ax-vemeucDseGV2UmEeMQ&oe=6A830C94"}, {"file_name": "deer_1.png", "id": "1332717592157844", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491823940_1332717595491177_2494044677614522896_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-dVTzx1sRq8Q7kNvwHzCYtQ&_nc_oc=Adq7QCiEqMU30I5v_00VpqRLKTRSzXrgOEzyoHOXXzjoFxViy9CAQ9ZTJe1tVw-tqK4&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGkIG8iFrotjrVb0t4mnhSKFUL9f0ch370SWpVVFPRCsQ&oe=6A83158B"}, {"file_name": "s.png", "id": "4255777344660911", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491823746_4255777357994243_7334746589021874546_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GeO9jTSS2uoQ7kNvwFmNFB1&_nc_oc=Adq7mG3d_LrzUMdXmUyjXGiZOfG6Pr7QAwpxrU3M6axHrgaS8spbXxw7Tyn6fKPHA70&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFckzLxKu3yVjm_n2pKmGrABwz1nIFHskbL45pNMuQDLg&oe=6A830A6D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "AnimalBlocksCoverArt_2560x1440.png", "id": "1518215032857058", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491825481_1518215036190391_3126051047249417807_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2XVCoriZ5VsQ7kNvwExfoGb&_nc_oc=AdrrylpsXpTLtALLbr5wwZVaN-vRPShmeqpYz1dklT9TjXqbeFTBdGgdnU_H-ebL9Zc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEkLrVahcnkY0AHa4cS08-Fx-e-TwS7DJOznJF9QBia1w&oe=6A8303E1"}, "display_name": "Animal Blocks", "keywords": ["sandbox", "multiplayer", "building", "survival", "monsters"], "long_description": "Enter **Animal Blocks**, the chaotic Minecraft-inspired VR sandbox where you build, roleplay, survive, and show off your style. \n\n# **\ud83c\udf34 Battle in Jungle Combat**\nBattle other players, earn XP, and level up different combat classes\u2014each with unique weapons and play styles.\n{1034054556264024}\n\n# **\ud83c\udfae Game Modes** \n- **\ud83c\udf11 Survive 99 Nights** \n{2110015899579189}\n- \ud83e\udddf **Zombies**\n{955142100673993}\n- \ud83d\udd0d **Dark Forest**\n{1008531195001414}\n- \u26cf\ufe0f **Mining**\n{4451251821810128}\n\n# **\ud83e\uddf1 Build and Roleplay**  \nSky bases, bunkers, traps, forts, castles \u2014 it\u2019s all block-based and yours to shape.\n{2909585475894360}\n\n# **\ud83e\uddf0\ud83e\ude84\ud83d\udd2b\ud83d\udd78\ufe0f\ud83e\uddf9 Gadgets, Guns, Weapons!**  \nGrapple hooks, flying brooms, web slingers, sticky bombs, wings, and more!\n\n# **\ud83d\udc3c\ud83e\udd96\ud83d\udc31\ud83e\udd88\ud83d\udc38 Pick Your Animal**  \nBe an axolotl, panda, dinosaur, cat, shark\u2026 or something totally custom.\n\n# **\ud83d\uddfa\ufe0f Explore Player Worlds**  \nJump into wild player-made maps \u2014 or build your own and invite your friends!", "short_description": "Animal Blocks is a game inspired by Gorilla Tag movement mechanics and Minecraft. You can build, play PVP , or try to survive against wild monsters and zombies."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.animalblocksvr.com/privacy-policy", "developer_terms_of_service_url": "https://www.animalblocksvr.com/code-of-conduct", "publisher_name": "RemioVR", "support_website_url": "https://www.animalblocksvr.com/", "website_url": "https://www.animalblocksvr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "459781504968480"}, {"id": "644354873106712"}, {"id
f&oh=00_Af_Q1xXmYmR9rkC9yRT6SbbDynqSpQpYA9GYm011TG3uwQ&oe=6A33F294"}, {"file_name": "deer_1.png", "id": "1332717592157844", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/491823940_1332717595491177_2494044677614522896_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T89ibQkDaPoQ7kNvwFaIiMk&_nc_oc=AdqwtGGo9ZhQOdFPz1ZVBKriFFGqCrhQdN_ZAq5SmvW0x51leNnAKy2tkXHbOpV4pFU&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_4dqo4P9KDzgFP3oabbmo0drS6V6v6YMtq4URmQ_Ir1Q&oe=6A33FB8B"}, {"file_name": "ss_fire.png", "id": "983148271233690", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/491823790_983148274567023_2120001592240190564_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CYR6QnP_2OIQ7kNvwFzRKiM&_nc_oc=Adqzt_QkvTYzLJ3cqytm8l28nZMxTqCTQNF_MYTPwKoO2nz2UD7YMy7eZUOs8U0C4QU&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-h1iUiJUIwAxId8aaOAnViebZr9q00RuqP5eAk62CX9w&oe=6A34098F"}, {"file_name": "s.png", "id": "4255777344660911", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/491823746_4255777357994243_7334746589021874546_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Km8HRjYfqzIQ7kNvwEcNMNF&_nc_oc=AdolWUNORBtc3vcwv6Cad_hEVsPlUzWFjbGwXypjcbPOWEEdAV1f9Zn9eK2EbgUMMbY&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_NCU7jgU24329bq9qkZsjBsSq01pW8ucv7LRuM5vbHNQ&oe=6A33F06D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "AnimalBlocksZombieHorde_12_2560x1440.png", "id": "1195903555894012", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499618093_1195903559227345_7587350963945298034_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lXHiTJ5-1J0Q7kNvwEO8EFN&_nc_oc=Adqeu6LZXXrGpbDaRkPmGwuNZvxW-kQm_JcC7uDvnex1YD_b8UOVG0GKvS1jIEsx4XU&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af__p7IUAQ2iXrUT9tejcxEnxhScqoHBrvnv6dZAg5CTtw&oe=6A3409E0"}, "display_name": "Animal Blocks", "keywords": ["sandbox", "multiplayer", "building", "survival", "monsters"], "long_description": "Enter **Animal Blocks**, the chaotic Minecraft-inspired VR sandbox where you build, roleplay, survive, and show off your style. \n\n# **\ud83e\uddf1 Build and Roleplay in Blockhaven**  \nSky bases, bunkers, traps, forts, castles \u2014 it\u2019s all block-based and yours to shape.\n{2909585475894360}\n\n# **\ud83c\udfae Game Modes** \n- **\ud83c\udf11 Survive 99 Nights** \n{2110015899579189}\n- \ud83e\udddf **Zombies**\n{955142100673993}\n- \ud83d\udd0d **Dark Forest**\n{1008531195001414}\n- \u26cf\ufe0f **Mining**\n{4451251821810128}\n- \ud83e\uddf1 **Creative**\n{1811662810005411}\n\n# **\ud83e\uddf0\ud83e\ude84\ud83d\udd2b\ud83d\udd78\ufe0f\ud83e\uddf9 Gadgets, Guns, Weapons!**  \nGrapple hooks, flying brooms, web slingers, sticky bombs, wings, and more!\n\n# **\ud83d\udc3c\ud83e\udd96\ud83d\udc31\ud83e\udd88\ud83d\udc38 Pick Your Animal**  \nBe an axolotl, panda, dinosaur, cat, shark\u2026 or something totally custom.\n\n# **\ud83d\uddfa\ufe0f Explore Player Worlds**  \nJump into wild player-made maps \u2014 or build your own and invite your friends!", "short_description": "Animal Blocks is a game inspired by Gorilla Tag movement mechanics and Minecraft. You can build, play PVP , or try to survive against wild monsters and zombies."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.animalblocksvr.com/privacy-policy", "developer_terms_of_service_url": "https://www.animalblocksvr.com/code-of-conduct", "publisher_name": "RemioVR", "support_website_url": "https://www.animalblocksvr.com/", "website_url": "https://www.animalblocksvr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "459781504968480"}, {"id": "644354873106712"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "
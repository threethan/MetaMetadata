uoazXow&oe=6A104983"}, {"file_name": "Screenshot5.png", "id": "797867729592153", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/491822034_797867732925486_2108684750588200818_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HKmqXq3sjY8Q7kNvwHuMm6L&_nc_oc=Adq3VkXLWpxKwTwvDjnb2SKhZI7ZTKtIsNazaBtCIBIQyljrt3BH0AJsmuzdx0tLYGU&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6gbe5uB5bwAlRHlK__bcI_kDVvQo6HUVQjO8cvwfErIA&oe=6A107313"}, {"file_name": "Screenshot3.png", "id": "1169994058271984", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/491827725_1169994061605317_4697635022498708725_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Wc1BCKaNl1UQ7kNvwFbxo6X&_nc_oc=AdomIsqXnnbvWHtT6a3MOXgjQtuzXgeRKxJ0jVcKvYvKcpom-QfSuZcE8l0yc5ZNZ60&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4hrIfWKTxI8Rq9RsyYqkgHQGEgYlMrgcVHvg1g0y8IIA&oe=6A106AC9"}, {"file_name": "Screenshot4.png", "id": "707982438955147", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/491830599_707982442288480_185332730515943011_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yovQcq_E8UsQ7kNvwGY4KOM&_nc_oc=AdrGdkHKIVOVWugGMljvBftyiL9mJxNp2oqOx5WjG8ugZ2dPafF4kj1GQUHEcY0to74&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6bvBFaiYAB7Ql1fxlliS4yFJPtTgPACHeWuqj5hWrZxQ&oe=6A1072ED"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Flappin", "keywords": [], "long_description": "Flappin takes the world\u2019s favorite bird-flapping chaos and cranks it up for VR. You\u2019re the wings now \u2014 literally! Pump your arms, weave through endless pipes, and fight gravity one frantic flap at a time.\n\nSimple? Sure. Silly? Absolutely. Addictive? You bet. Every run dares you to go just a little farther, and every \u201calmost made it\u201d guarantees you\u2019ll want to try again.\n\nWith controls so easy anyone can play (but few can truly master), it\u2019s perfect for party nights, quick pick-up sessions, or those times you just need to flap it out. Warning: intense flapping, uncontrollable giggling, and \u201cjust one more try\u201d syndrome highly likely.", "short_description": "Flap those wings like your life depends on it! Flappin brings the ridiculous joy of the classic bird game into VR. Swing your arms, dodge those pipes, and see how far you can make it before gravity wins. Easy to start, impossible to stop!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://flappinprivacypolicy.framer.website/", "developer_terms_of_service_url": null, "publisher_name": "n00bird", "support_website_url": null, "website_url": "https://flappinprivacypolicy.framer.website/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "528142316460358"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24515723011453221"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lhr8-1.oculuscdn.com/v/t64.5771-25/491822808_1321735336053588_4972883434730424658_n.png?stp=dst-png_s360x360&_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lsBlyhiEV3kQ7kNvwEzTxEj&_nc_oc=AdrWYwVAGQwCHtwpckQXrVATdqAoxYZP3veTsqF568QMS7qU2XSxcW8Pj9M_RvCu1sE&_nc_zt=3&_nc_ht=scontent-lhr8-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af639819zBaRZyxOU56M5Nt2o64DFeEAn1bEcz8Ot86DkQ&oe=6A105933"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Flappin", "platform": "ANDRO
5771-25/507838217_1783413199207781_6876378939734086519_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pttF2QzsgRcQ7kNvwEFbhVg&_nc_oc=AdqUYTnJWwxcBuEcwTJux-bbrF1nxkOMco9w6NgyzxhveVEbK6vcB__qoBfBzC-yb80&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQR9Mqq3fEmLd3vp5bSIDnSLluJKjoalFHAquLfPMchitg&oe=6B0C5043"}, {"file_name": "Screenshot5.png", "id": "797867729592153", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491822034_797867732925486_2108684750588200818_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=myeXOceKJxsQ7kNvwHijDoY&_nc_oc=Adp9iZParWzwWX93jzbvuSR73RPyb-5bbcbCRmWcqMgySnwwVHGX1_rKnSuwgqDZRWs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSuuTiNT7rxnE9LN-ONdLZuF2H-6t-hSeQjJfbFPuuJdA&oe=6B0C79D3"}, {"file_name": "Screenshot3.png", "id": "1169994058271984", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491827725_1169994061605317_4697635022498708725_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bcfZzb9tWVAQ7kNvwEmar4e&_nc_oc=AdoYplqP_fo2YNf3ZtuCG1EKK2R6i2IMdHAdpznQ_Hq1waeQo9jQH_0zuvccsVuoCEQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSS-SyD6_0CMKp7wV8bxsC1I1iLYkpx9ZITwZQ-pjTa3g&oe=6B0C7189"}, {"file_name": "Screenshot4.png", "id": "707982438955147", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491830599_707982442288480_185332730515943011_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cXwM_RQHcFkQ7kNvwHoW4Zi&_nc_oc=Adov979DH1fktwcSNMEDCb3DBmSNbPkhLYr78u2Uhn-a0Ve9bVlxvjH5oxbWPUTxSGA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQTTID19p4xQT856sX9ht-cuDQgIgpUyxx-3JfL7hCwWw&oe=6B0C79AD"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Flappin", "keywords": [], "long_description": "Flappin takes the world\u2019s favorite bird-flapping chaos and cranks it up for VR. You\u2019re the wings now \u2014 literally! Pump your arms, weave through endless pipes, and fight gravity one frantic flap at a time.\n\nSimple? Sure. Silly? Absolutely. Addictive? You bet. Every run dares you to go just a little farther, and every \u201calmost made it\u201d guarantees you\u2019ll want to try again.\n\nWith controls so easy anyone can play (but few can truly master), it\u2019s perfect for party nights, quick pick-up sessions, or those times you just need to flap it out. Warning: intense flapping, uncontrollable giggling, and \u201cjust one more try\u201d syndrome highly likely.", "short_description": "Flap those wings like your life depends on it! Flappin brings the ridiculous joy of the classic bird game into VR. Swing your arms, dodge those pipes, and see how far you can make it before gravity wins. Easy to start, impossible to stop!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://flappinprivacypolicy.framer.website/", "developer_terms_of_service_url": null, "publisher_name": "n00bird", "support_website_url": null, "website_url": "https://flappinprivacypolicy.framer.website/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "528142316460358"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24515723011453221"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491822808_1321735336053588_4972883434730424658_
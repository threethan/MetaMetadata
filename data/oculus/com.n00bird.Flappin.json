GlAZFxA&oe=69F49A03"}, {"file_name": "Screenshot5.png", "id": "797867729592153", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/491822034_797867732925486_2108684750588200818_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2SjUuP_WHLoQ7kNvwF7zjaq&_nc_oc=AdocFibexV8_qGzjpGgF9utUDZXdm8avpfV9EZqpsbjUuHrJEYipohRrK-0WFdih-IE&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1roTWIfyPgRSxlSpirpFtHrb6TNFIvWl8aVtszoOXxAA&oe=69F4C393"}, {"file_name": "Screenshot3.png", "id": "1169994058271984", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/491827725_1169994061605317_4697635022498708725_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KSmra33etBwQ7kNvwERI8fa&_nc_oc=Adq7ytlVNsVfYC3LVI3TwY-pthCVzASEMa3ISSW37QLM7JtdOsJczEMygwTv7tagizk&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1z9nnXI2SIcI9O1SuwrRn3_JE5HbZSnZjc7V8Um2TB9w&oe=69F4BB49"}, {"file_name": "Screenshot4.png", "id": "707982438955147", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/491830599_707982442288480_185332730515943011_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-QLOyo-UKBUQ7kNvwFXbsoX&_nc_oc=AdrHvPrQh3ycecGIdwKTAPFiPU9mVC7mMWGsT-89YUe2BeuybsXUrnmvWybAa5U3FXs&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af39KZcwB9ovjyurtHKfUuHHA68kffB0MlGWIPuECGXupA&oe=69F4C36D"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Flappin", "keywords": [], "long_description": "Flappin takes the world\u2019s favorite bird-flapping chaos and cranks it up for VR. You\u2019re the wings now \u2014 literally! Pump your arms, weave through endless pipes, and fight gravity one frantic flap at a time.\n\nSimple? Sure. Silly? Absolutely. Addictive? You bet. Every run dares you to go just a little farther, and every \u201calmost made it\u201d guarantees you\u2019ll want to try again.\n\nWith controls so easy anyone can play (but few can truly master), it\u2019s perfect for party nights, quick pick-up sessions, or those times you just need to flap it out. Warning: intense flapping, uncontrollable giggling, and \u201cjust one more try\u201d syndrome highly likely.", "short_description": "Flap those wings like your life depends on it! Flappin brings the ridiculous joy of the classic bird game into VR. Swing your arms, dodge those pipes, and see how far you can make it before gravity wins. Easy to start, impossible to stop!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://flappinprivacypolicy.framer.website/", "developer_terms_of_service_url": null, "publisher_name": "n00bird", "support_website_url": null, "website_url": "https://flappinprivacypolicy.framer.website/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "528142316460358"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24515723011453221"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/491822808_1321735336053588_4972883434730424658_n.png?stp=dst-png_s360x360&_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NQuoQGWrI_0Q7kNvwH8Qdlj&_nc_oc=AdqPVu9lP10K5y6j-RUc5M3OrV-Eo3xQXcFq3r_tM0WWNPHsF77AlfZMoHkvZaEwINs&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1NjKDK3zvCU-IEnKDlNKAjP7v9f3jEdUMh0i21xkbg1A&oe=69F4A9B3"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Flappin", "platform": "ANDRO
93NocYA&oe=69E61983"}, {"file_name": "Screenshot5.png", "id": "797867729592153", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/491822034_797867732925486_2108684750588200818_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Xi4Om2Z4dlEQ7kNvwERAo9x&_nc_oc=AdrpnNCPaUnsMfxwGiHDrFRW60kt9m1e1dHqhUAgXnbm6x9gToaGNdwV2QeGr1Bjg6s&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1cmW4JFrznPCWyvoak1EXnHSjpo6GgQZulo6LJNY9ogg&oe=69E64313"}, {"file_name": "Screenshot3.png", "id": "1169994058271984", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/491827725_1169994061605317_4697635022498708725_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MVbUpZfDe2EQ7kNvwFmo2H_&_nc_oc=AdpyTB1VxjK8p0OOFuEFHPKbsm14AZCTyLNueVRB9ty162NfSLQZA1nRc7SSHdR0ij8&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1f15_OrI25W3naos0qsQMQpAXistq6iLyTuZgxZsS5ow&oe=69E63AC9"}, {"file_name": "Screenshot4.png", "id": "707982438955147", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/491830599_707982442288480_185332730515943011_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q8XwYRsdRKIQ7kNvwGZzRKu&_nc_oc=AdpEzIYhVTNI6fAwliq7wZOI_y48s_GfrSiMJjryffzLpSlv3csjNPtUmg1FehrXd-0&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2-PWSccwx_4UYEMPKc_rOiAxl1lgbHx9R0-jq49EsgLA&oe=69E642ED"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Flappin", "keywords": [], "long_description": "Flappin takes the world\u2019s favorite bird-flapping chaos and cranks it up for VR. You\u2019re the wings now \u2014 literally! Pump your arms, weave through endless pipes, and fight gravity one frantic flap at a time.\n\nSimple? Sure. Silly? Absolutely. Addictive? You bet. Every run dares you to go just a little farther, and every \u201calmost made it\u201d guarantees you\u2019ll want to try again.\n\nWith controls so easy anyone can play (but few can truly master), it\u2019s perfect for party nights, quick pick-up sessions, or those times you just need to flap it out. Warning: intense flapping, uncontrollable giggling, and \u201cjust one more try\u201d syndrome highly likely.", "short_description": "Flap those wings like your life depends on it! Flappin brings the ridiculous joy of the classic bird game into VR. Swing your arms, dodge those pipes, and see how far you can make it before gravity wins. Easy to start, impossible to stop!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://flappinprivacypolicy.framer.website/", "developer_terms_of_service_url": null, "publisher_name": "n00bird", "support_website_url": null, "website_url": "https://flappinprivacypolicy.framer.website/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "528142316460358"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24515723011453221"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/491822808_1321735336053588_4972883434730424658_n.png?stp=dst-png_s360x360&_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Tir8wMoEcDQQ7kNvwFZOi1i&_nc_oc=AdpuLwFCcj9TmWRzbCBhxu0bk9BvIK06nFNPb-WGpu0AsUoeCTy9gxZi-3W0CZrlGe8&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0BcxUbib_DKgOaBcDkpFohWChd9YhaQyJasY0jhXU_vg&oe=69E62933"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Flappin", "platform": "ANDRO
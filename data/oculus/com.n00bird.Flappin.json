mJD5EdQ&oe=6A1AD583"}, {"file_name": "Screenshot5.png", "id": "797867729592153", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/491822034_797867732925486_2108684750588200818_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KgUXyEqsek4Q7kNvwGkK5wA&_nc_oc=AdqFwG8ELktKh1v_lHUSzk7fy_374E4LYWxQ0rRNUHXZU_zbnx8wIjEjqbDaWmnoy-8&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6ix0YyjFX9m8b84iXngJclPXgpmvgvKi4xmVGvIn9cPw&oe=6A1AFF13"}, {"file_name": "Screenshot3.png", "id": "1169994058271984", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/491827725_1169994061605317_4697635022498708725_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o0DBhVox_lcQ7kNvwG23jR4&_nc_oc=AdoV-_icjm6XfaNXCihjQVjILjSjJ2TgDXrzqhO1Sxe-JlJ1HLtxfdWbwEcg1iZlRZ8&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4EG0nA2kcr1Z8iUe1gEiBYEtHeRCh488vmTOXQjz90jQ&oe=6A1AF6C9"}, {"file_name": "Screenshot4.png", "id": "707982438955147", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/491830599_707982442288480_185332730515943011_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OWgRCbrw68AQ7kNvwG_aRDf&_nc_oc=AdqWXMjDPBPnDOsxm3npODAbptSHUWQv-5WHTHMDHvPBZR6lGz-jjhMoNtgwMo1GIyk&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4xKIGdFVuauK6ykHWhyDcUX3DwDxiyI3OFwxZ2bhvt6A&oe=6A1AFEED"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Flappin", "keywords": [], "long_description": "Flappin takes the world\u2019s favorite bird-flapping chaos and cranks it up for VR. You\u2019re the wings now \u2014 literally! Pump your arms, weave through endless pipes, and fight gravity one frantic flap at a time.\n\nSimple? Sure. Silly? Absolutely. Addictive? You bet. Every run dares you to go just a little farther, and every \u201calmost made it\u201d guarantees you\u2019ll want to try again.\n\nWith controls so easy anyone can play (but few can truly master), it\u2019s perfect for party nights, quick pick-up sessions, or those times you just need to flap it out. Warning: intense flapping, uncontrollable giggling, and \u201cjust one more try\u201d syndrome highly likely.", "short_description": "Flap those wings like your life depends on it! Flappin brings the ridiculous joy of the classic bird game into VR. Swing your arms, dodge those pipes, and see how far you can make it before gravity wins. Easy to start, impossible to stop!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://flappinprivacypolicy.framer.website/", "developer_terms_of_service_url": null, "publisher_name": "n00bird", "support_website_url": null, "website_url": "https://flappinprivacypolicy.framer.website/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "528142316460358"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24515723011453221"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/491822808_1321735336053588_4972883434730424658_n.png?stp=dst-png_s360x360&_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LrTkYloNyskQ7kNvwEbOC1B&_nc_oc=AdrJw7RU7cqQPdtRyzQ-UqHB0IWWpaXJPrv_l0B2XD6tU9rqy2-vTTh612SUjCnEy1I&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5l-Ume3TMPrkdEMbXgOOYLX6897PdC920n6dWeFSAd0w&oe=6A1AE533"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Flappin", "platform": "ANDRO
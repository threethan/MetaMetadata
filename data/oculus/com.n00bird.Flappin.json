5771-25/507838217_1783413199207781_6876378939734086519_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pttF2QzsgRcQ7kNvwFGLaeZ&_nc_oc=Ado07cq5dbqCeTA0gWiUWkTJ9z1MEkWxi0MS3QXMhWcQxG-7RZIVUx8LjBJsCuyK5Mc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQR-OAvq1Vd3FeZExe_pcvlSDLQujFpuCPeVbvQcZczwaA&oe=6B0DA1C3"}, {"file_name": "Screenshot5.png", "id": "797867729592153", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491822034_797867732925486_2108684750588200818_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=myeXOceKJxsQ7kNvwHRnwwG&_nc_oc=AdqkeO_O0XSCDi1cYPuW3LdCbjm3G1rLf-2r6PDqikAdh2rYBC-G6cKJKDCH4GXkCYI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTR3w5qDkLEKHHb2mnaZP9lzZ_TcJfHITpd4WMX2fmESA&oe=6B0DCB53"}, {"file_name": "Screenshot3.png", "id": "1169994058271984", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491827725_1169994061605317_4697635022498708725_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0EePLUM3HOsQ7kNvwFgDbU-&_nc_oc=AdqVCHnELAycoXzBRw2lHhQ6o837Yba3UTgci2wuGpwguHipBAcD8RcwjV5GvGm8ZLo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQpN1JvKNoNN228_tI3222Y606gFHjc1tA9Jl1_f7rdJg&oe=6B0DC309"}, {"file_name": "Screenshot4.png", "id": "707982438955147", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491830599_707982442288480_185332730515943011_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cXwM_RQHcFkQ7kNvwGmo_lM&_nc_oc=Adon0O3GTmJ6WFx5s0AoRMD5lHLDm8uHLZFQ09y2cRtev_lIQOtRycaPAQaRUeM4b4c&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQS8st0vJ9lZpiOgKZSQEzrasSDh5dYmmnlihGUK1RkB-g&oe=6B0DCB2D"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Flappin", "keywords": [], "long_description": "Flappin takes the world\u2019s favorite bird-flapping chaos and cranks it up for VR. You\u2019re the wings now \u2014 literally! Pump your arms, weave through endless pipes, and fight gravity one frantic flap at a time.\n\nSimple? Sure. Silly? Absolutely. Addictive? You bet. Every run dares you to go just a little farther, and every \u201calmost made it\u201d guarantees you\u2019ll want to try again.\n\nWith controls so easy anyone can play (but few can truly master), it\u2019s perfect for party nights, quick pick-up sessions, or those times you just need to flap it out. Warning: intense flapping, uncontrollable giggling, and \u201cjust one more try\u201d syndrome highly likely.", "short_description": "Flap those wings like your life depends on it! Flappin brings the ridiculous joy of the classic bird game into VR. Swing your arms, dodge those pipes, and see how far you can make it before gravity wins. Easy to start, impossible to stop!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://flappinprivacypolicy.framer.website/", "developer_terms_of_service_url": null, "publisher_name": "n00bird", "support_website_url": null, "website_url": "https://flappinprivacypolicy.framer.website/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "528142316460358"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24515723011453221"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491822808_1321735336053588_4972883434730424658_
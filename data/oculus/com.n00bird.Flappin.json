yDOSpzg&oe=6A2599C3"}, {"file_name": "Screenshot5.png", "id": "797867729592153", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491822034_797867732925486_2108684750588200818_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LyEIaUTva-cQ7kNvwGFYiwt&_nc_oc=AdqK4QGBOFGbidyUiDz6Ve0GbNZKcd3MadGcQiw3c5URnfR7Xa53B4oF0Glsvh6U0Ng&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_7M217swlTIMp7ff5oo_Y8Fh5YMeBPcnYCaDCYoys_LA&oe=6A258B13"}, {"file_name": "Screenshot3.png", "id": "1169994058271984", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491827725_1169994061605317_4697635022498708725_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VN_9TeA0hvwQ7kNvwFuKPxV&_nc_oc=Adp0lquZvSYKbRpvHuOZ3GAYP2u35ArtYYfww_pvcB94tmBDuJ4MnWOAqSOUrl3NSoQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af85eaw6BNqeg2nds-GZCF56s7gd7JZ4B_wEUG0EuhCT7Q&oe=6A2582C9"}, {"file_name": "Screenshot4.png", "id": "707982438955147", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491830599_707982442288480_185332730515943011_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8YVUNupFOPgQ7kNvwEeleyG&_nc_oc=AdoClJZbdD9slPW9QTZ7h2K2UZmrVi4FYWWgcOJNU9P-jt8OtoX2r7qG5ROH6nyTaGQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8LFno8knDg5DFRPhx1zA1l55i3LJ6osWDce0IKKOtkpA&oe=6A258AED"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Flappin", "keywords": [], "long_description": "Flappin takes the world\u2019s favorite bird-flapping chaos and cranks it up for VR. You\u2019re the wings now \u2014 literally! Pump your arms, weave through endless pipes, and fight gravity one frantic flap at a time.\n\nSimple? Sure. Silly? Absolutely. Addictive? You bet. Every run dares you to go just a little farther, and every \u201calmost made it\u201d guarantees you\u2019ll want to try again.\n\nWith controls so easy anyone can play (but few can truly master), it\u2019s perfect for party nights, quick pick-up sessions, or those times you just need to flap it out. Warning: intense flapping, uncontrollable giggling, and \u201cjust one more try\u201d syndrome highly likely.", "short_description": "Flap those wings like your life depends on it! Flappin brings the ridiculous joy of the classic bird game into VR. Swing your arms, dodge those pipes, and see how far you can make it before gravity wins. Easy to start, impossible to stop!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://flappinprivacypolicy.framer.website/", "developer_terms_of_service_url": null, "publisher_name": "n00bird", "support_website_url": null, "website_url": "https://flappinprivacypolicy.framer.website/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "528142316460358"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24515723011453221"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491822808_1321735336053588_4972883434730424658_n.png?stp=dst-png_s360x360&_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-B4_AOS55_kQ7kNvwH70mpM&_nc_oc=AdreQWOTcw2nn1eOej61AVFUMKmBV-erUXb-paQ4lQqfl8X5DCP1cthU0ihOxS5N2TA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-uSyIFZSbQBwZ_pB54h-vRBahSXAdybcsS15EJtTsStw&oe=6A257133"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Flappin", "platform": "ANDRO
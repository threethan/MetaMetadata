oe=6AAA8844"}, {"file_name": "scr5.png", "id": "2581633205594203", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491823802_2581633208927536_2455715099625227839_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ONnu3SrisiAQ7kNvwGlWWFz&_nc_oc=AdpGiH_l0_OlbcMAyEsFeI0PPgVvBPTGDvbbtigJmgJXNKQhKi9X_xfZN6HSYRj26mE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKWXkfMyQRq52snJsXg4c9oBjJhHii4JRAq-ifikyOebg&oe=6AAA99DA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Porta360-preview-image-big.png", "id": "1107774098251680", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491825305_1107774101585013_1398149668813918986_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0NFC8GKz0c8Q7kNvwE6FeGw&_nc_oc=Adrg4KgW1aIojYsFbfxhcaDRuO5KIJ9eayUgMhKpH6QoCPp24DnFjLWa5W_YgwaeUtg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJe4-CUt4cBI__dkgM8srfW021DgjaojVCWxqCXaIr4RA&oe=6AAAB212"}, "display_name": "Porta360", "keywords": ["stream", "travel", "Movies", "Cinema", "Video360"], "long_description": "# Travel the World in VR \u2014 No Borders, No Language Barriers!\n\nTransform your VR headset into a personal teleport and explore the globe from home. Experience high-quality **360\u00b0 video** capturing the atmosphere and beauty of iconic locations worldwide.\n\nOur project has officially launched! We begin with our first showcase location to introduce the core experience, with a commitment to regularly adding new cities, historical sites, and natural wonders over time.\n\n### Key Features & Highlights\n\n* **The World Speaks Your Language:** No foreign audio or distracting subtitles. Our system supports almost every language, delivering commentary in your native tongue.\n* **Immersive Ambient Sound:** Enjoy authentic spatial background audio\u2014from vibrant city streets to soothing nature\u2014for a 100% realistic feel.\n* **Growing Content:** Be among the first to explore new updates as we continuously film and add fresh international locations.\n* **Optimized for Standalone VR:** Designed specifically for VR headsets to ensure smooth playback and comfortable viewing.\n* **Intuitive Controls:** Easily pick your language and navigate destinations using simple controller interactions.\n\n### Perfect For\n* **Travel Enthusiasts** wanting to preview destinations or explore remotely.\n* **Relaxation & Escape** after a long day\u2014step into peaceful, exotic atmospheres instantly.\n* **Cultural Discovery** in an engaging, interactive format.\n\n*Put on your headset, choose your language, and start your journey today!*\n{993522363699444}\n{1771700827200401}", "short_description": "Travel Anywhere in VR \u2014 No Borders, No Language Barriers!\n\nTransform your VR headset into a personal teleport. Experience high-quality 360\u00b0 videos with full immersion and realistic ambient atmosphere.\n\nKey Highlights:\n\nYour Language First: Unique audio system supporting almost every world language. Enjoy stories and facts natively\u2014no subtitles needed.\n\nAtmospheric Sound: Authentic ambient audio creates a true 100% presence.\n\nGrowing Library: Starting with our first location, we\u2019re regularly addi"}]}, "developer_name": null, "developer_privacy_policy_url": "https://porta360.pp.ua/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Sokolov Oleksandr", "support_website_url": null, "website_url": "https://porta360.pp.ua/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}, {"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "sq", "ar", "hy", "az", "z
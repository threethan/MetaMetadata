fM6Jcd4ROhQ&oe=6B0D9C46"}, {"file_name": "screenshot-2_2560x1440.png", "id": "1148736267706104", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491824665_1148736271039437_2925315365902145807_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AiRTUQ_HpKsQ7kNvwFIMO3O&_nc_oc=AdoYa1g1Cp0V86Z32U2NP62jOz7_TcIC_m1mkmcH88I2hYUVqvAxDM2bQAqRsBJpFAs&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQT54hVgdOypfWKSKMU13_P8gWTy7f7vnQtOvbiHMB4e4g&oe=6B0DA9E7"}, {"file_name": "screenshot-4_2560x1440.png", "id": "1641640614110231", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491823901_1641640617443564_4208495950910049883_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1IYmKgdKFNkQ7kNvwGDFH_5&_nc_oc=AdrUavUJJfO0zkwW_dRoVHoDgC-dbvj7uf97DvMED-wbXXR2DM2tAFmz3mhgKWQh_Yg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRPLkylGNAicZKzkdgOi5qvllsXqQ7pw2wPjACwXPLv5Q&oe=6B0DBDB2"}, {"file_name": "screenshot-3_2560x1440.png", "id": "2492793954577412", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491823296_2492793967910744_4054746465604242719_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=t3tNBfr8GO0Q7kNvwFy1G2x&_nc_oc=AdpsWQUp1dhrVbhptSsLgna5j7QTef5bX9dXd572jsRGpVQrGCu6nK0ITfPB-7RMf9A&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTfjRGPXHembGu4wt3TpS5NCINhGTWlhBwQeBGf3b4_Pw&oe=6B0DBE56"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "F-night-shift-2k-thumbnail-2560x1440.png", "id": "954114754161377", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491821704_954114757494710_4731228781743725925_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l67XLoM8FIUQ7kNvwHyaVtH&_nc_oc=AdokxsPS9Vi-V_aq7Xh7EPo8mCwR7E5muSvlB8DjNk27UVcYQqlsgGSVG79HlwOucfs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTV4UyLLsw1tsba1-BweBRYAWRqGBwP1t_8ON_bF0L5nw&oe=6B0DBC13"}, "display_name": "Dr Certified", "keywords": ["casual", "doctor", "tabletop", "mixedreality", "surgery"], "long_description": "Every real doctor went home. You're what's left.\n\nNight Owl Hospital has one surgeon on shift tonight, and it's you. Your patients have swallowed a sofa and a spare bolt, among other things. Nobody has asked about your qualifications. Please don't bring it up.\n\n\ud83d\udcac JOIN OUR DISCORD\n\n**discord.gg/yKReqfqAr6**\n\n{1390348339582908}\n\nDr Certified puts the surgery board on your actual table in mixed reality. Pinch the tweezers with your own fingers, or hold them like a pen on a controller, and lift out whatever's inside. Touch the rim and the monitor screams, the tweezers jolt and your fee shrinks.\n\n{1081084698266687}\n\n{1137668395428452}\n\n- **15 very odd patients**, each with their own board, story and voice\n- **68 levels** across 7 chapters, each ending in a Board Exam\n- **6 tools to master**, starting with a humble pair of tweezers\n- **Emergencies mid-pull:** cardiac arrest won't wait for you to finish\n- **Call-outs:** operate in the back of a rocking ambulance or a bumpy air ambulance\n- **Climb from Intern to Surgeon General**, and fill your Honours wall\n- **A Daily Patient** with a growing streak bonus\n\n{1662123128786530}\n\n{3698051717013320}\n\n{3851657961659003}\n\nOperate in your own room, or in a cosy med-bay on the moon.\n\n{1011377272001843}\n\n{2229011074668922}\n\n- **Hand tracking or Touch controllers**, seated or standing\n- **Easy, Normal or Surgeon** difficulty, Assisted grip, colour-blind modes, text up to 130%, Reduce flashing\n- **Too easy?** Turn on Shaky hands\n\nMade by a tiny studio that reads every review. Tell us what to fix, and which patient you want to treat next.", "short_description": "Every doctor at Night Owl General went home, so tonight the patients are yours. Dr Certified is a steady-hands surgery game in mixed reality: \n\nThe board lands on your real table, and you lift out whatever your patients swallowed with tweezers pinched in your own fingers. Touch the rim and the monitor screams. Clean pulls earn fees, stars and your next degree, all the way from Intern to Surgeon General."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.sabutech.net/games/dr-certified/privacy", "developer_terms_of_service_url": "https://www.sabutech.net/games/dr-certified/tos", "publisher_name": "Sabutech", "support_website_url": null, "website_url": "https://www.sabutech.net/games/dr-certified", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "1676485315806614"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1366956643172913"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1137354725417056"}]}, "baseline_offer": {"id": "1137354725417056"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1794527700, "status": "PUBLISHED", "id": "1137354725417056"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1402617952940115", "version": "0.1.5"}, "id": "4039840869645204", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1366956633172914", "is_concept": false, "latest_released_b
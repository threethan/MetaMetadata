_nc_sid=6e7a0a&_nc_ohc=Fott5Gjr3i4Q7kNvwE2KKMD&_nc_oc=AdoLc6c2ZGX11qq5wcWHkQsXsyfa0J-mZBBnywMn9ofGbx65oJRIZKUcyGR94e-yzHk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVkMn3qtxuau9u4GQrpvRV5M_8FN2kawOCFS8ab4KPRQg&oe=6B0F0E7E"}, {"file_name": "screenshot-1_2560x1440.png", "id": "29882447024689570", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491823901_29882447034689569_8928495523039111535_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-MbkDcGcSI4Q7kNvwHlLtDv&_nc_oc=AdoQnhuQbawExik1md415V8wcHiqwi3TwtnLWCkarM2EFobNh-b0TZRZJIRysHmSSa8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQUpvjeX8a7AabK5VqviO3DtxQ6eckS_1m0wQKpMC_EPHg&oe=6B0EEDC6"}, {"file_name": "screenshot-2_2560x1440.png", "id": "1148736267706104", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491824665_1148736271039437_2925315365902145807_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AiRTUQ_HpKsQ7kNvwGcCJR-&_nc_oc=AdqlucxbKH02P8_9D08wOkMpQk89S-FMpY5uciMB1M-geV1MvGG4MEb5E7zdeNIzfF4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQV4VWrh7oJPjus7ZRU1lbPkHM7kijITM49Snn40NV0fXA&oe=6B0EFB67"}, {"file_name": "screenshot-4_2560x1440.png", "id": "1641640614110231", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491823901_1641640617443564_4208495950910049883_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1IYmKgdKFNkQ7kNvwGYkePX&_nc_oc=AdoKCgIqCieVvWQ1k8rDcln6qiN6tIkeOy45sMmaCnwsesplHcA73SIpC8lK46tzQXA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQUuB5TVlX-UsCeBJYW97GoODdfoSpwSJb7jbbztuA16Jg&oe=6B0F0F32"}, {"file_name": "screenshot-3_2560x1440.png", "id": "2492793954577412", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491823296_2492793967910744_4054746465604242719_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=t3tNBfr8GO0Q7kNvwGomcS5&_nc_oc=AdoRa7mfmJaBL-DtIls8h4Jsg8f32iz85wb04pACjn8M08NATfKBihcyd_em0h0GvBM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQUCzxbZlw7xguCh22dBcaKryjVfv_Pfd3YVyz6ABF09kA&oe=6B0F0FD6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "F-night-shift-2k-thumbnail-2560x1440.png", "id": "954114754161377", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491821704_954114757494710_4731228781743725925_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ng6qFgGF0WIQ7kNvwH7V5Ls&_nc_oc=Adr1lVpbXs52EmbEVm2B_kW_k0g4JcC1VTWEFk8RDaPwdf9lLxBCH8islwm_TbEWouo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWRhOizfi_JIOmJ4LN5CRskSZFeX62NjFyW4IN-TY4kJA&oe=6B0F0D93"}, "display_name": "Dr Certified", "keywords": ["casual", "doctor", "tabletop", "mixedreality", "surgery"], "long_description": "Every real doctor went home. You're what's left.\n\nNight Owl Hospital has one surgeon on shift tonight, and it's you. Your patients have swallowed a sofa and a spare bolt, among other things. Nobody has asked about your qualifications. Please don't bring it up.\n\n\ud83d\udcac JOIN OUR DISCORD\n\n**discord.gg/yKReqfqAr6**\n\n{1390348339582908}\n\nDr Certified puts the surgery board on your actual table in mixed reality. Pinch the tweezers with your own fingers, or hold them like a pen on a controller, and lift out whatever's inside. Touch the rim and the monitor screams, the tweezers jolt and your fee shrinks.\n\n{1081084698266687}\n\n{1137668395428452}\n\n- **15 very odd patients**, each with their own board, story and voice\n- **68 levels** across 7 chapters, each ending in a Board Exam\n- **6 tools to master**, starting with a humble pair of tweezers\n- **Emergencies mid-pull:** cardiac arrest won't wait for you to finish\n- **Call-outs:** operate in the back of a rocking ambulance or a bumpy air ambulance\n- **Climb from Intern to Surgeon General**, and fill your Honours wall\n- **A Daily Patient** with a growing streak bonus\n\n{1662123128786530}\n\n{3698051717013320}\n\n{3851657961659003}\n\nOperate in your own room, or in a cosy med-bay on the moon.\n\n{1011377272001843}\n\n{2229011074668922}\n\n- **Hand tracking or Touch controllers**, seated or standing\n- **Easy, Normal or Surgeon** difficulty, Assisted grip, colour-blind modes, text up to 130%, Reduce flashing\n- **Too easy?** Turn on Shaky hands\n\nMade by a tiny studio that reads every review. Tell us what to fix, and which patient you want to treat next.", "short_description": "Every doctor at Night Owl General went home, so tonight the patients are yours. Dr Certified is a steady-hands surgery game in mixed reality: \n\nThe board lands on your real table, and you lift out whatever your patients swallowed with tweezers pinched in your own fingers. Touch the rim and the monitor screams. Clean pulls earn fees, stars and your next degree, all the way from Intern to Surgeon General."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.sabutech.net/games/dr-certified/privacy", "developer_terms_of_service_url": "https://www.sabutech.net/games/dr-certified/tos", "publisher_name": "Sabutech", "support_website_url": null, "website_url": "https://www.sabutech.net/games/dr-certified", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "1676485315806614"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1366956643172913"}, "review_messages": []}]}, "cover_square_
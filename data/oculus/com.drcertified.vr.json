_nc_sid=6e7a0a&_nc_ohc=N59EjCQYeFYQ7kNvwG-v4S5&_nc_oc=AdoPemLRXjta-qOw-Xlr_Jv9FyB0oIQbeGti2sFiiJDIXtpp88IPEFcWL1QN37QoqX8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSn7w7vm3sZrEz-fD0AGIZu4oEaLM3YwhoBIGDROsvvEg&oe=6B0C6B7E"}, {"file_name": "screenshot-1_2560x1440.png", "id": "29882447024689570", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491823901_29882447034689569_8928495523039111535_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_AONcDDdPDYQ7kNvwGzNmDM&_nc_oc=AdoZ8_HNXMHW0N-s8w6z2YJZqfFSaAF16pNS8Qu3_jrlskTlRqTvesWQ1x0UDmJY660&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQDMW_zTWlane2MkOVkm8Uj3wjWQrF_tK_ELF9n1J2mAQ&oe=6B0C8306"}, {"file_name": "screenshot-2_2560x1440.png", "id": "1148736267706104", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491824665_1148736271039437_2925315365902145807_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AiRTUQ_HpKsQ7kNvwGt2Wp1&_nc_oc=AdoQ3IP2BZ1H0MuL-cY0ydM3z81IW1fzG87_3x31RqGwqe-2LmMPAYVXQrBiP6qdNnA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTuzlI8aszCuW76RUioZo8NFCDH-LviCzKskF2YMsmk-g&oe=6B0C5867"}, {"file_name": "screenshot-4_2560x1440.png", "id": "1641640614110231", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491823901_1641640617443564_4208495950910049883_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SgNrRJejCHMQ7kNvwHUNgZt&_nc_oc=AdrmqYSyHdwIppfe2aCkxHE-KAg1k3Ycz6-mt---dESZp9qKiC16z4ZbDzmL3I0xr7Y&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSaDxDsgFZhhqMEBi2gzLHwHNtT8nKpPevGE96iGpjGKQ&oe=6B0C6C32"}, {"file_name": "screenshot-3_2560x1440.png", "id": "2492793954577412", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491823296_2492793967910744_4054746465604242719_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gQ3mmUC80_oQ7kNvwF4Two1&_nc_oc=Ado13K0rDBB8amtc8xKh_yNBUZcpxNVNQiB9PBgE3yi1mYNHl4XCDVSI-n7rLtcUwWM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTVNB1WLPZAAF0lWzM-8ogOP6m-cZJ_x78yAa7zjBTeiw&oe=6B0C6CD6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "F-night-shift-2k-thumbnail-2560x1440.png", "id": "954114754161377", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491821704_954114757494710_4731228781743725925_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l67XLoM8FIUQ7kNvwE6U8XD&_nc_oc=AdoOmbhhyVJ9rirr5pGeJTQtgwLq3ASuW01MckCV7W5wuMWOOEnKHAhNeQaNGDVLfts&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQKiFuZBfDduV8NWE3gkP4bcUIs-F-pry515Hxkr0wcXw&oe=6B0C6A93"}, "display_name": "Dr Certified", "keywords": ["casual", "doctor", "tabletop", "mixedreality", "surgery"], "long_description": "Every real doctor went home. You're what's left.\n\nNight Owl Hospital has one surgeon on shift tonight, and it's you. Your patients have swallowed a sofa and a spare bolt, among other things. Nobody has asked about your qualifications. Please don't bring it up.\n\n\ud83d\udcac JOIN OUR DISCORD\n\n**discord.gg/yKReqfqAr6**\n\n{1390348339582908}\n\nDr Certified puts the surgery board on your actual table in mixed reality. Pinch the tweezers with your own fingers, or hold them like a pen on a controller, and lift out whatever's inside. Touch the rim and the monitor screams, the tweezers jolt and your fee shrinks.\n\n{1081084698266687}\n\n{1137668395428452}\n\n- **15 very odd patients**, each with their own board, story and voice\n- **68 levels** across 7 chapters, each ending in a Board Exam\n- **6 tools to master**, starting with a humble pair of tweezers\n- **Emergencies mid-pull:** cardiac arrest won't wait for you to finish\n- **Call-outs:** operate in the back of a rocking ambulance or a bumpy air ambulance\n- **Climb from Intern to Surgeon General**, and fill your Honours wall\n- **A Daily Patient** with a growing streak bonus\n\n{1662123128786530}\n\n{3698051717013320}\n\n{3851657961659003}\n\nOperate in your own room, or in a cosy med-bay on the moon.\n\n{1011377272001843}\n\n{2229011074668922}\n\n- **Hand tracking or Touch controllers**, seated or standing\n- **Easy, Normal or Surgeon** difficulty, Assisted grip, colour-blind modes, text up to 130%, Reduce flashing\n- **Too easy?** Turn on Shaky hands\n\nMade by a tiny studio that reads every review. Tell us what to fix, and which patient you want to treat next.", "short_description": "Every doctor at Night Owl General went home, so tonight the patients are yours. Dr Certified is a steady-hands surgery game in mixed reality: \n\nThe board lands on your real table, and you lift out whatever your patients swallowed with tweezers pinched in your own fingers. Touch the rim and the monitor screams. Clean pulls earn fees, stars and your next degree, all the way from Intern to Surgeon General."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.sabutech.net/games/dr-certified/privacy", "developer_terms_of_service_url": "https://www.sabutech.net/games/dr-certified/tos", "publisher_name": "Sabutech", "support_website_url": null, "website_url": "https://www.sabutech.net/games/dr-certified", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "1676485315806614"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1366956643172913"}, "review_messages": []}]}, "cover_square_
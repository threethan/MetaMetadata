_1535067844168336_2577432998181701977_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eg_HTHeiuSsQ7kNvwF8PWm0&_nc_oc=AdoTYcaqXBHMM09lSimh87BJIq4ozwQ7TU31Trtb9QAePdWiX7SmUauqqfRvDNgotGQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af662q5xyCEOd0ZlDVWYmikTTBmQl9lwlxNk58IYFvEONg&oe=6A1EDEAF"}, {"file_name": "sc1.png", "id": "970838058419426", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491823291_970838061752759_3381049554980909856_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yirAC-TvIkYQ7kNvwFQ7RXh&_nc_oc=Adox_2vkxRNf_vicOgOdqTddHsjUK0DIg8hnkTJqX2hGPriugbCDsxr5f1cAAFnfFRo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7mGfEcIr1qDCVLeMdL2JFOYXfbYxBlq4xznMLm8-uD0A&oe=6A1EE91B"}, {"file_name": "sc5.png", "id": "725085590443375", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491819281_725085593776708_2993026543759591356_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UDDkkzub1_gQ7kNvwHHewr-&_nc_oc=AdpMZdgXUduf54J27gA_Mkucn2ZSSbH_JSpzaN42rWjNoL_qmYt58OjAh-NczwqLu3M&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7IIYJyU-8-HaopIeJ19Se0Cmd9p6ngVVkDiUL0ShEoHw&oe=6A1ED42B"}, {"file_name": "sc4.png", "id": "1098581088265925", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491818849_1098581091599258_5804491157825447559_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Gj0FSNtt118Q7kNvwGC97_2&_nc_oc=AdqNBYLVlArVa6tsXYzqflgcgthZ0HwddcuXgdVk_lVc0rYlsxftPyg7SjmsbcuhRL8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7oXCpD4WXYxtXqlkw-hk2dGwJJWYsv6QdTHQP5epYUKA&oe=6A1EDD8A"}, {"file_name": "sc3.png", "id": "1473989197691124", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491818849_1473989201024457_6750337486758137990_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zzOPZvrinGMQ7kNvwFIj896&_nc_oc=AdpU4BVJEHTZJh10Dd0AoK6kegoYBIBl2UwlGwKKkV0gVV0LZbl7HCdUrxgP9l4sAjA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af74p7c-wuzNSDRg14vOOlSabDAyKrSnhvfts5ukAdCS4w&oe=6A1EDD07"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x140fish(1).png", "id": "2587817504923198", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491822327_2587817511589864_5335932229179638572_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3C32HxHd94EQ7kNvwGzd-CB&_nc_oc=AdplCYbCnMcWOnXDl46mGhwqVEzwGFSMeRBISUnIAxK--PudyZlP-ifBwb7F-He0hbE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5ST3ioGXmyLEZRfoExKloP5npvpREB4xjb0dEoNzsh5g&oe=6A1ED7FC"}, "display_name": "Fish Battles", "keywords": ["shooter", "ocean", "fish", "battle"], "long_description": "\ud83c\udfae Fish Battles \u2013 VR Battle Royale in the Deep! \ud83d\udc20\ud83d\ude80\n\nDive into the ultimate underwater battle royale, built exclusively for VR!\nWhether you're in it for laughs or aiming for the crown, Fish Battles brings fast-paced, fin-slapping action to life.\n\nNo internet connection required.\n\u2013 Choose your map, pick a specie, and fight to level up.\n\n\ud83e\uddec Choose Your Species\n\n22 unique sea creatures (not just fish!) to master, including:\n\n- \ud83e\uddad Sea Lion\n\n- \ud83e\udd88 White Shark\n\n- \ud83d\udc22 Green Turtle\n\n- \ud83d\udc20 Peacock Grouper\n\n- \ud83d\udef8 Stingray\n...and more!\n\n\ud83d\uddfa\ufe0f Battle Across Submerged Cities\n\nFight across 9 unique underwater maps, each representing a city reclaimed by the sea.\n\n\ud83c\udfc6 Climb the Leaderboard\n\nEarn points from kills, wins, and survival.\nUnlock quirky nicknames, rise through the global ranks, and become the #1 Sea Warrior.\nOnly one can rule the reef\u2014will it be you?\n\nStrap on your headset and dive into the mayhem. The ocean is waiting.", "short_description": "Fish Battles is a fast-paced VR battle royale where sea creatures fight with rifles and rockets in underwater cities. Compete and become the #1 fish fighter! No internet connection required."}]}, "developer_name": null, "developer_privacy_policy_ur
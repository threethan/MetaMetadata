_1535067844168336_2577432998181701977_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sJz1gEblPZcQ7kNvwGoJdXw&_nc_oc=AdqEcZkh1jfalGJkRb-xv3dgLIVlORpzi-WpgnAAJF0aFCZJ1Ib4JjkLyUfnq-E0gGU&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0Z5oeFgZxvkHoAw96Hy1xB6D2EipAX4jZ5EFQuhuHMtg&oe=69F4AEAF"}, {"file_name": "sc1.png", "id": "970838058419426", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/491823291_970838061752759_3381049554980909856_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LkPl-dflNKQQ7kNvwEjous5&_nc_oc=AdqZLIwt_M95tW0FiXtNwLKrEYut4Y5OufY8Vj8QXWRrgdCP3DgLSm9wePrknRlGXvc&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2Ls7E2WAYqxVStQkvdM6Nhx9MII_kYrjx62biNxS6jYw&oe=69F4B91B"}, {"file_name": "sc5.png", "id": "725085590443375", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/491819281_725085593776708_2993026543759591356_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1Mjw0IAuedwQ7kNvwEGDHnf&_nc_oc=Adoiq1BA2_Rx3ptkPGmaDY2MUPOEhzVJ7n2PObnwglYYlMwzcJviNuZsTv5ObYmRRqo&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0iFIPbbUPX0oc6dQaqIS2yslg7ByY2LPEtOYLzgzyKKg&oe=69F4A42B"}, {"file_name": "sc4.png", "id": "1098581088265925", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/491818849_1098581091599258_5804491157825447559_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n6jOq1Pg0zMQ7kNvwFF6Eid&_nc_oc=AdresnnNPARk4Hw-OOyC2S2WQ9Lh3efrENThgYpDf47Z-vYm5oMucUYxaG-mNXMPWKE&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2Log7djPlo94MizASDtLhXsh6z2LZD2Zh2TQ-lpb4qVA&oe=69F4AD8A"}, {"file_name": "sc3.png", "id": "1473989197691124", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/491818849_1473989201024457_6750337486758137990_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AZVSc00LvjIQ7kNvwEgRKtQ&_nc_oc=Adqf0j5BkWSzlcubJxu-WZ8hMlHUnL3VNoNtkqqz53hQz-KXtv5jZZOB1pRyQ5Vc3MY&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2R2wzePTZdvFPY_bVVTe6UMRkoPB6lz0MWtsSVkBzKkw&oe=69F4AD07"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x140fish(1).png", "id": "2587817504923198", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/491822327_2587817511589864_5335932229179638572_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v7bhW6ZKprAQ7kNvwEHFWkr&_nc_oc=Adq2IiYCAZuN11A6n5mpCVBjxvmdlePgApY0OLnD0LMVaGwZPbdsTpB5LcWuPPFQp-8&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1FQI04wbmJe0QikzZ0SW2ZkCJaJI5JH2Xsefoq64mmwQ&oe=69F4A7FC"}, "display_name": "Fish Battles", "keywords": ["shooter", "ocean", "fish", "battle"], "long_description": "\ud83c\udfae Fish Battles \u2013 VR Battle Royale in the Deep! \ud83d\udc20\ud83d\ude80\n\nDive into the ultimate underwater battle royale, built exclusively for VR!\nWhether you're in it for laughs or aiming for the crown, Fish Battles brings fast-paced, fin-slapping action to life.\n\nNo internet connection required.\n\u2013 Choose your map, pick a specie, and fight to level up.\n\n\ud83e\uddec Choose Your Species\n\n22 unique sea creatures (not just fish!) to master, including:\n\n- \ud83e\uddad Sea Lion\n\n- \ud83e\udd88 White Shark\n\n- \ud83d\udc22 Green Turtle\n\n- \ud83d\udc20 Peacock Grouper\n\n- \ud83d\udef8 Stingray\n...and more!\n\n\ud83d\uddfa\ufe0f Battle Across Submerged Cities\n\nFight across 9 unique underwater maps, each representing a city reclaimed by the sea.\n\n\ud83c\udfc6 Climb the Leaderboard\n\nEarn points from kills, wins, and survival.\nUnlock quirky nicknames, rise through the global ranks, and become the #1 Sea Warrior.\nOnly one can rule the reef\u2014will it be you?\n\nStrap on your headset and dive into the mayhem. The ocean is waiting.", "short_description": "Fish Battles is a fast-paced VR battle royale where sea creatures fight with rifles and rockets in underwater cities. Compete and become the #1 fish fighter! No internet connection required."}]}, "developer_name": null, "developer_privacy_policy_ur
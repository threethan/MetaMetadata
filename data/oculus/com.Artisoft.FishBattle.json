GsYXohraBNLgXZNt8YWg-BG9bFZYfWWMH4g&oe=6A393B07"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x140fish(1).png", "id": "2587817504923198", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/491822327_2587817511589864_5335932229179638572_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O2kdPEb-HPAQ7kNvwFSplM7&_nc_oc=AdrK3GOFbVvFy4Isc6OGFuWVhbHchNMyATixEOflv433iBo3IzL6wIZYs9r6UUmiObY&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-9xpwpPpflLcfNS-Gs4RFffzmRHMBFaoV_yGW-aS52pQ&oe=6A3935FC"}, "display_name": "Fish Battles", "keywords": ["shooter", "ocean", "fish", "battle"], "long_description": "\ud83c\udfae Fish Battles \u2013 VR Battle Royale in the Deep! \ud83d\udc20\ud83d\ude80\n\nDive into the ultimate underwater battle royale, built exclusively for VR!\nWhether you're in it for laughs or aiming for the crown, Fish Battles brings fast-paced, fin-slapping action to life.\n\nNo internet connection required.\n\u2013 Choose your map, pick a specie, and fight to level up.\n\n\ud83e\uddec Choose Your Species\n\n22 unique sea creatures (not just fish!) to master, including:\n\n- \ud83e\uddad Sea Lion\n\n- \ud83e\udd88 White Shark\n\n- \ud83d\udc22 Green Turtle\n\n- \ud83d\udc20 Peacock Grouper\n\n- \ud83d\udef8 Stingray\n...and more!\n\n\ud83d\uddfa\ufe0f Battle Across Submerged Cities\n\nFight across 9 unique underwater maps, each representing a city reclaimed by the sea.\n\n\ud83c\udfc6 Climb the Leaderboard\n\nEarn points from kills, wins, and survival.\nUnlock quirky nicknames, rise through the global ranks, and become the #1 Sea Warrior.\nOnly one can rule the reef\u2014will it be you?\n\nStrap on your headset and dive into the mayhem. The ocean is waiting.", "short_description": "Fish Battles is a fast-paced VR battle royale where sea creatures fight with rifles and rockets in underwater cities. Compete and become the #1 fish fighter! No internet connection required."}]}, "developer_name": null, "developer_privacy_policy_url": "https://artisoft.pl/policies/fb_v2.html", "developer_terms_of_service_url": null, "publisher_name": "Artisoft", "support_website_url": "https://fishbattles.artisoft.pl/support.html", "website_url": "https://fishbattles.artisoft.pl/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26038001805805205"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/491820428_1139348137521479_9080905251655374010_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l8HTUd4HFkIQ7kNvwFahqwy&_nc_oc=AdqVbeRIfDR-o-Po7GvHDgGlN-swqBl3rypMogTgqU1u-QmqGCeO_JHY3Nli53JdAa0&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9Tvkfohxl8yXyCAIgn3aEtMUXAdRYMOwIfBzUW9DOzUQ&oe=6A39373B"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Fish Battles", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Shooter", "id": "3744040075834813"}, {"topic_name": "Action", "id": "459781504968480"}], "release_date": 1761868860, "lastRevision": {"nodes": [{"id": "24388681300737272", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "24388681187403950", "is_first
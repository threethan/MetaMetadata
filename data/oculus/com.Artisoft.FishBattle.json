YZ5STmnunv1bDoIRymcqm8_j0O2eCr3_uO8crwr-zGwRAAsU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQW3TN-PtgpkjRflhn2J2jfkHJWbGmeGJlM82Tw4tIA8Q&oe=6AFDBEF3"}, {"file_name": "sc3.png", "id": "1073248754395786", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491821081_1073248757729119_1767991249456040132_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FoUpLyA_lM8Q7kNvwFskzn3&_nc_oc=Adq1xGQDDJgQYgOH03c3MuUiaCsRMPRcP7tLWXOora_2YeIuzcEj5FTyZphKHjYSzFg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRUFNl9oxnSZDWfG6ia5nrhRSd3fEUtFDaiFIPGQel-2Q&oe=6AFDC7B8"}, {"file_name": "sc4.png", "id": "1152247216711318", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491818890_1152247220044651_8282296680481254245_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_CY3RWcf6wAQ7kNvwGzrEQJ&_nc_oc=AdqX709TeGR8-oFcKytN-fNtuZ4uUl_mQ1sJ54ePhMq1U-XQ89dWKnEfxY07xCq6_VI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSUY2p5e-QYzjmkJILpYmyeojKXbFSLHUDTrt6uP5M8aw&oe=6AFDDEBF"}, {"file_name": "sc5.png", "id": "1376711046727779", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491819239_1376711050061112_4387463469350703712_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LDA59Ju85zwQ7kNvwE0rThD&_nc_oc=Adq_guCB--ViQEN-LkCpnDVXCpjQZKPBY01YtlDamGC6mXts1py72DYMfIiWzQoZIuU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRUgKFFpEI1YzGKrjXoKUJwQ3V2jj0FxJBvSJWc8CpSdQ&oe=6AFDD713"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x140fish(1).png", "id": "1383098766075644", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491827611_1383098769408977_472863015462951418_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Cgu_qoxnevEQ7kNvwEM6D67&_nc_oc=AdpM-tizzCYpbMKxddGQ1443XUd55EiR75lduX_9JGrAr91Z0uBaKSDsDQmFe8lbUyI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQlgFI2OoejCZ49UkdgKAjiHnKakjKinLlfvn-PElQrPg&oe=6AFDB4AB"}, "display_name": "Fish Battles", "keywords": ["shooter", "ocean", "fish"], "long_description": "\ud83c\udfae Fish Battles \u2013 VR Battle Royale in the Deep! \ud83d\udc20\ud83d\ude80\n\nDive into the ultimate underwater battle royale, built exclusively for VR!\nWhether you're in it for laughs or aiming for the crown, Fish Battles brings fast-paced, fin-slapping action to life.\n\nThis game is meant for Online play only, but it contains Offline training, which allows you to upskill a bit. \n\n\ud83c\udf10 Online Modes:\n- Quick Play \u2013 Instantly jump into a match with random players.\n\n- Create Party \u2013 Host a private party for up to 6 friends and battle it out together.\n\n- Join Party \u2013 Got a code? Join your friends\u2019 party and dominate the ocean.\n\n\n\ud83d\udc21 Offline Mode:\n- Training \u2013 Choose your map, pick a specie, and fight bots to level up before diving into the online fray.\n\n\n\ud83e\uddec Choose Your Species\n\n11 unique sea creatures (not just fish!) to master, including:\n\n- \ud83e\uddad Sea Lion\n\n- \ud83e\udd88 Shark\n\n- \ud83d\udc22 Green Turtle\n\n- \ud83d\udc20 Peacock Grouper\n\n- \ud83d\udef8 Stingray\n...and more!\n\n\ud83d\uddfa\ufe0f Battle Across Submerged Cities\n\nFight across 5 unique underwater maps, each representing a city reclaimed by the sea.\n\n\ud83c\udfc6 Climb the Leaderboard\n\nEarn points from kills, wins, and survival.\nUnlock quirky nicknames, rise through the global ranks, and become the #1 Sea Warrior.\nOnly one can rule the reef\u2014will it be you?\n\n\nStrap on your headset and dive into the mayhem. The ocean is waiting.", "short_description": "Fish Battles is a fast-paced VR battle royale where sea creatures fight with rifles and rockets in underwater cities. Compete online, climb the global leaderboard, and become the #1 fish fighter!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://artisoft.pl/policies/fb_v1.html", "developer_terms_of_service_url": null, "publisher_name": "Artisoft", "support_website_url": "https://fishbattles.artisoft.pl/support.html", "website_url": "https://fishbattles.artisoft.pl/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER"], "id": "24459070423698359"}}]}, "scheduled_offers": {"count": 10, "nodes": [{"status": "PUBLISHED", "id": "2848976832122554"}, {"status": "PUBLISHED", "id": "1695253258204755"}, {"status": "PUBLISHED", "id": "1358545736399896"}, {"status": "PUBLISHED", "id": "1326521526331702"}, {"status": "PUBLISHED", "id": "1503567478210333"}, {"status": "PUBLISHED", "id": "875782728853000"}, {"status": "PUBLISHED", "id": "1192069963122992"}, {"status": "PUBLISHED", "id": "2370242006750271"}, {"status": "PUBLISHED", "id": "32328570650092135"}, {"status": "PUBLISHED", "id": "1174395051368096"}]}, "baseline_offer": {"id": "1358545736399896"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1792774800, "status": "PUBLISHED", "id": "2848976832122554"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "26038487189090000", "version": "0.41"}, "id": "24029431753379683", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBina
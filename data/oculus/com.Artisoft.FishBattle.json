_1535067844168336_2577432998181701977_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aTpvjyOmgB0Q7kNvwEsogkT&_nc_oc=Adq-uGIJqYcOWvx0vZlCB3tjgu0cdTLnopXSlcSlhN7fqGvo-4tL46wLSH5kttX5fHE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_3FQmeak_BA1HNRjpgwXF8WxBPF0BfdIeOg76scJZ8eg&oe=6A3BDFAF"}, {"file_name": "sc1.png", "id": "970838058419426", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491823291_970838061752759_3381049554980909856_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8fW85JyVDRsQ7kNvwF1ooPB&_nc_oc=AdoU5ELNQdqjxh8spkVWDajmr3dx2rHxSzpwvwEbGlXgwcYw41zwllSvmgSeDnV3Qo4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_Mdkks8KPzka_68-6DkYkwRgDq4nDPFjiQ1nUQQdtBMw&oe=6A3BEA1B"}, {"file_name": "sc5.png", "id": "725085590443375", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491819281_725085593776708_2993026543759591356_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jH9fIKvsYQIQ7kNvwE1rijZ&_nc_oc=AdqCgdtPFJjn1Iz8b9StCqWqSBkeUi6302M84FfF3HJ2DJjpfmIsRN0MiSqQ0-slK8Y&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_1hMHXUW_YWcKAtAaPhlCOxzmaFesgTvnEnmPK0LWPQQ&oe=6A3BD52B"}, {"file_name": "sc4.png", "id": "1098581088265925", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491818849_1098581091599258_5804491157825447559_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wf52Eduq0WgQ7kNvwGzzwpH&_nc_oc=AdrQxwpgHnGi-2AJ6BlCw39R2YtVIhSuAeHhaO-8UBzEtkBAHSRL6xRV9aJ6suGFYgs&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af84g8M2Vx0DuBWLvzBqwdf5mZ90_4ZcrSLa11tYOuqInQ&oe=6A3BDE8A"}, {"file_name": "sc3.png", "id": "1473989197691124", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491818849_1473989201024457_6750337486758137990_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gG5cgAbHbGEQ7kNvwE_epGP&_nc_oc=AdrxcjHmKjmWpCKajKdkwn2dPjlkezTWcHObBoXu9fCeTbavmKwopYLCpEawTukGd2o&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9gRTjcmiMdCRyVQzjXa5PvbAYmByiJ2gvtNIFXlEWn_w&oe=6A3BDE07"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x140fish(1).png", "id": "2587817504923198", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491822327_2587817511589864_5335932229179638572_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RVu0NgxrCPUQ7kNvwE65aKQ&_nc_oc=Adoj6KxpiVki5CiT9zhFlJMEzxaju9FCFnAhtaKBNPgl3w08y08AyQV47d3fa6bHnHc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8btdkPTeHqUlK221xWZqRsRFj8RPwt5H2Qz3LWm2YQSg&oe=6A3BD8FC"}, "display_name": "Fish Battles", "keywords": ["shooter", "ocean", "fish", "battle"], "long_description": "\ud83c\udfae Fish Battles \u2013 VR Battle Royale in the Deep! \ud83d\udc20\ud83d\ude80\n\nDive into the ultimate underwater battle royale, built exclusively for VR!\nWhether you're in it for laughs or aiming for the crown, Fish Battles brings fast-paced, fin-slapping action to life.\n\nNo internet connection required.\n\u2013 Choose your map, pick a specie, and fight to level up.\n\n\ud83e\uddec Choose Your Species\n\n22 unique sea creatures (not just fish!) to master, including:\n\n- \ud83e\uddad Sea Lion\n\n- \ud83e\udd88 White Shark\n\n- \ud83d\udc22 Green Turtle\n\n- \ud83d\udc20 Peacock Grouper\n\n- \ud83d\udef8 Stingray\n...and more!\n\n\ud83d\uddfa\ufe0f Battle Across Submerged Cities\n\nFight across 9 unique underwater maps, each representing a city reclaimed by the sea.\n\n\ud83c\udfc6 Climb the Leaderboard\n\nEarn points from kills, wins, and survival.\nUnlock quirky nicknames, rise through the global ranks, and become the #1 Sea Warrior.\nOnly one can rule the reef\u2014will it be you?\n\nStrap on your headset and dive into the mayhem. The ocean is waiting.", "short_description": "Fish Battles is a fast-paced VR battle royale where sea creatures fight with rifles and rockets in underwater cities. Compete and become the #1 fish fighter! No internet connection required."}]}, "developer_name": null, "developer_privacy_policy_ur
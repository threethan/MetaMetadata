yWw&oe=6A413873"}, {"file_name": "sc3.png", "id": "1073248754395786", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/491821081_1073248757729119_1767991249456040132_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EIZgOhLET5QQ7kNvwFKex32&_nc_oc=AdpK5bhv2uOseJ94alGpni_D1dslPEpgGoBH4IfsjlmFfG7v17DO0xNVRzcfHo1YDlU&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af83wklkjSfziu_0MtCt6Qf87BPbEJ8XNAMMAzS0vLNMpg&oe=6A414138"}, {"file_name": "sc4.png", "id": "1152247216711318", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/491818890_1152247220044651_8282296680481254245_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r_cS8T58DlsQ7kNvwFvOhyB&_nc_oc=AdrrUIUbjTKVzWhRJbYXdSoC_EmFx8hQcBrYhiCRvTksvKluGyEMQrDDvXZqMaHUctw&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-d8qbJGeOWLOvswzkFSlsft5cWpGd6Za2AYoRKFCjmAQ&oe=6A411FFF"}, {"file_name": "sc5.png", "id": "1376711046727779", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/491819239_1376711050061112_4387463469350703712_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OE4e71fO4lIQ7kNvwHu-DYf&_nc_oc=AdomN_aazAmHSmXB50fdEGTuwVrHm09aw1tyXEo3VXVos8ds8Ymb_GEQ1kFGbveQV88&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af81DvIYaL6nfamdLkRFoQGalMfQluKAwTfmmJs4UoDr2Q&oe=6A411853"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x140fish(1).png", "id": "1383098766075644", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/491827611_1383098769408977_472863015462951418_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EJyUEauhF7cQ7kNvwGixX8i&_nc_oc=Adqw9t_PUwWDYbf9FmkqgHpaHMfLud0LWB9mUTgSuSaFfLGrtJyLmOWWCjAj_YiJdC0&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9guUzKWd7nUXWMBUuQuMOZAQtMpTs4ohRiMfpN6Ypk5Q&oe=6A412E2B"}, "display_name": "Fish Battles", "keywords": ["shooter", "ocean", "fish"], "long_description": "\ud83c\udfae Fish Battles \u2013 VR Battle Royale in the Deep! \ud83d\udc20\ud83d\ude80\n\nDive into the ultimate underwater battle royale, built exclusively for VR!\nWhether you're in it for laughs or aiming for the crown, Fish Battles brings fast-paced, fin-slapping action to life.\n\nThis game is meant for Online play only, but it contains Offline training, which allows you to upskill a bit. \n\n\ud83c\udf10 Online Modes:\n- Quick Play \u2013 Instantly jump into a match with random players.\n\n- Create Party \u2013 Host a private party for up to 6 friends and battle it out together.\n\n- Join Party \u2013 Got a code? Join your friends\u2019 party and dominate the ocean.\n\n\n\ud83d\udc21 Offline Mode:\n- Training \u2013 Choose your map, pick a specie, and fight bots to level up before diving into the online fray.\n\n\n\ud83e\uddec Choose Your Species\n\n11 unique sea creatures (not just fish!) to master, including:\n\n- \ud83e\uddad Sea Lion\n\n- \ud83e\udd88 Shark\n\n- \ud83d\udc22 Green Turtle\n\n- \ud83d\udc20 Peacock Grouper\n\n- \ud83d\udef8 Stingray\n...and more!\n\n\ud83d\uddfa\ufe0f Battle Across Submerged Cities\n\nFight across 5 unique underwater maps, each representing a city reclaimed by the sea.\n\n\ud83c\udfc6 Climb the Leaderboard\n\nEarn points from kills, wins, and survival.\nUnlock quirky nicknames, rise through the global ranks, and become the #1 Sea Warrior.\nOnly one can rule the reef\u2014will it be you?\n\n\nStrap on your headset and dive into the mayhem. The ocean is waiting.", "short_description": "Fish Battles is a fast-paced VR battle royale where sea creatures fight with rifles and rockets in underwater cities. Compete online, climb the global leaderboard, and become the #1 fish fighter!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://artisoft.pl/policies/fb_v1.html", "developer_terms_of_service_url": null, "publisher_name": "Artisoft", "support_website_url": "https://fishbattles.artisoft.pl/support.html", "website_url": "https://fishbattles.artisoft.pl/", "category": null, "comfort_rating": "COMFORTABLE
yyw&oe=6A316673"}, {"file_name": "sc3.png", "id": "1073248754395786", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491821081_1073248757729119_1767991249456040132_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6iq1gIA2VuQQ7kNvwE5FYCK&_nc_oc=Adpnaaj2q1_8j6wTQHLNuMvevQZGTgcqoPfIhyEVC1AASyaL1G2yPauy-7jNOEx-42k&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_Ha2iyC0LowkorLwyx9cHVrhVt0v4kmx9qEa3V28Z8Iw&oe=6A316F38"}, {"file_name": "sc4.png", "id": "1152247216711318", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491818890_1152247220044651_8282296680481254245_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tK8YH0OvYYcQ7kNvwFiIA4b&_nc_oc=AdrZky-lxcndsj7eowF3vl_x5d6n1NF6ryON477hGYqifWKgsYUcdUX3l1MFXzwL8T0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9ZEvGJOcqvZD3ZdZGTmvVGnWUWih9Pjvutehd9YIKAYA&oe=6A314DFF"}, {"file_name": "sc5.png", "id": "1376711046727779", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491819239_1376711050061112_4387463469350703712_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=baVLmDXcZvkQ7kNvwGxwHHp&_nc_oc=AdpH7xWrxZubcjwwHReoQz1H8Nz2Oc9hta9IiVIapZVc8kkaEWqU8k272HsWgtlUcYo&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8-lvHisnE_BL-JC7xaV5nWluU7u0JqqTrsq3EamhD_Dg&oe=6A314653"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x140fish(1).png", "id": "1383098766075644", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491827611_1383098769408977_472863015462951418_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DjICylG4GR4Q7kNvwGejzF6&_nc_oc=AdqNs0GQGY8HfntoU-8sMUo_cE6zfl6aqtH75xYX8uAL6eunEmDZnEmiMA0tTTwXoyo&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_I7bXyEU2tXATtJ3aIJ3RsLbqWHbJIc_UotNMvhDolbg&oe=6A315C2B"}, "display_name": "Fish Battles", "keywords": ["shooter", "ocean", "fish"], "long_description": "\ud83c\udfae Fish Battles \u2013 VR Battle Royale in the Deep! \ud83d\udc20\ud83d\ude80\n\nDive into the ultimate underwater battle royale, built exclusively for VR!\nWhether you're in it for laughs or aiming for the crown, Fish Battles brings fast-paced, fin-slapping action to life.\n\nThis game is meant for Online play only, but it contains Offline training, which allows you to upskill a bit. \n\n\ud83c\udf10 Online Modes:\n- Quick Play \u2013 Instantly jump into a match with random players.\n\n- Create Party \u2013 Host a private party for up to 6 friends and battle it out together.\n\n- Join Party \u2013 Got a code? Join your friends\u2019 party and dominate the ocean.\n\n\n\ud83d\udc21 Offline Mode:\n- Training \u2013 Choose your map, pick a specie, and fight bots to level up before diving into the online fray.\n\n\n\ud83e\uddec Choose Your Species\n\n11 unique sea creatures (not just fish!) to master, including:\n\n- \ud83e\uddad Sea Lion\n\n- \ud83e\udd88 Shark\n\n- \ud83d\udc22 Green Turtle\n\n- \ud83d\udc20 Peacock Grouper\n\n- \ud83d\udef8 Stingray\n...and more!\n\n\ud83d\uddfa\ufe0f Battle Across Submerged Cities\n\nFight across 5 unique underwater maps, each representing a city reclaimed by the sea.\n\n\ud83c\udfc6 Climb the Leaderboard\n\nEarn points from kills, wins, and survival.\nUnlock quirky nicknames, rise through the global ranks, and become the #1 Sea Warrior.\nOnly one can rule the reef\u2014will it be you?\n\n\nStrap on your headset and dive into the mayhem. The ocean is waiting.", "short_description": "Fish Battles is a fast-paced VR battle royale where sea creatures fight with rifles and rockets in underwater cities. Compete online, climb the global leaderboard, and become the #1 fish fighter!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://artisoft.pl/policies/fb_v1.html", "developer_terms_of_service_url": null, "publisher_name": "Artisoft", "support_website_url": "https://fishbattles.artisoft.pl/support.html", "website_url": "https://fishbattles.artisoft.pl/", "category": null, "comfort_rating": "COMFORTABLE
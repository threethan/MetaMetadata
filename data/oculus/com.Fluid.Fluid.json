ENT", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982607_690148956260496_6818253247735988207_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DPUObGvD09EQ7kNvwFCMBEc&_nc_oc=Adm2GIsffyB3nOMXazEpiFga7_Qmy4BH5RwJgeHjLcmoO0CcBiCjiWs8XJgJkBhRt8Q&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfvfMgJzdUxRBwW4i1BY_pn4a8zOE0THtOAOQMXLfb7U0Q&oe=69A974F5"}]}, "id": "1477213567094066", "locale": "en_US", "screenshots": [{"file_name": "smarttv 1.png", "id": "803281735463330", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491822034_803281738796663_1192707244839949480_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=10FteZVRiB0Q7kNvwGzlsdo&_nc_oc=Adm16zD0aM4UnjcN-RlnkN4Y2kpD2cnyOrYedSd5_sSpFy6hsp0Odt_cO5u_Ps1qwaI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfvcoHaMl_MmrqnUtgvbLxP5msqRqTJEcJeGqIdHmX2t4g&oe=69A97A57"}, {"file_name": "Screenshot-1.png", "id": "3715217121957667", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473392127_3715217125291000_4057790498626262101_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yuhsVI5tFvcQ7kNvwHpHl9X&_nc_oc=AdkU1bWTKfiEIjKlsNZDykH1IOdo4guejCCuW1sKn2X2FgUiJL0gkyE-oHD8bPY9U8M&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfvgmARaYbCr5MylkW64iEcGea80s6ZXW4R6AKErMfgAAw&oe=69A991FB"}, {"file_name": "Screenshot.png", "id": "9347445165351774", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473392023_9347445175351773_1304065713031920436_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Mb3pSE5fKv4Q7kNvwHSe1Ef&_nc_oc=AdmR5ib2zAzXnaNhf_tAhgRWh3JLyWSQeUV6S-bowqGzEnSagYI2rl-2P2gmRDXrKPg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfuRKk2bCZ0VRHLtErtA8faBSD9NE3dd3_dVIBtMTE2Rkw&oe=69A98CF1"}, {"file_name": "Screenshot.png", "id": "1513467826707408", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473392168_1513467830040741_2579543078842798870_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fTd8mB9ENugQ7kNvwFM5-DD&_nc_oc=Admvv75iuU3BgJFM9xRf5rgt36BteCO5_BC4ZxSwGj_Fu6QiLNen-23mwjYgEgVcYN8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AftpYjxZilFb5Sxq5h8hjufW_rPHjx_HX3KaNJunCLGSeQ&oe=69A96021"}, {"file_name": "Screenshot-2.png", "id": "1370761794272177", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473393961_1370761797605510_8557991468053698635_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=puIQhyTBzT4Q7kNvwFcyt9X&_nc_oc=Adlim23PcY6E8W4Ktkwck48pchbpFAf-l0JlviG2sxe_bUA42Aqkp8XA_T_2rOoQ42s&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfuznmT-h0AU6kJo7fVqVjZYKjfMvS1ik0HGtFX5cB9cQA&oe=69A96794"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "16_9.png", "id": "1566334741483998", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499618277_1566334744817331_1936161901977034439_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uCeEq4qaEaIQ7kNvwHttz2S&_nc_oc=Adkwz99v5MuVYtzGEEitjdXVRfleYT3bjN-xPSo7CLtgjD20wBKXDu7UmfoFX6tw5M0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfsC_T2kXCoESdqV7uGmBWDaZvpbjO2B6mhq798qBlkwyw&oe=69A98448"}, "display_name": "Fluid Browser + Video Player", "keywords": ["video", "streaming", "productivity", "browser"], "long_description": "# Browser - Video Player - Gaming Hub - Smart Tv - Screen Sharing\n\nYou can have **windows** all around you or play your favorite game solo or stream it to friends in a personal home theater. It runs entirely on your headset. **No PC required.**\n\n* \ud83d\udcfa **Smart TV** Perfect for watching streaming services or **local video** files with light fx. **Note**: Netflix is not supported.\n{1531996061225774}\n* \u25b6\ufe0f **Play local video files** saved on your headset, including 3D SBS video. (MKV and MP4 supported, ISO and MVC not supported)\n* \ud83c\udfae Use a **Gamepad** to play Xbox Cloud Gaming, GeForce Now & other online games (gamepad tracking only for Xbox/PS5 controller)\n{1340957747347833}\n* \ud83d\udedc **Screen Sharing** tabs + video files in private rooms from headset to headset (no pc needed)\n* \ud83d\udc65 **Join rooms** to collaborate or watch videos together on shared screens.\n* \ud83c\udfde\ufe0f Beautiful **virtual environments** or full mixed-reality experience \n* \ud83d\udcbb **Apps and webpages** can be placed anywhere around you in 3D space. \n{1211559177549801}\n* \ud83d\udda5\ufe0f **Fluid Link**, our (experimental & paid) PC screen streaming add on.\n* \ud83d\uddb1\ufe0f Wireless **Mouse & Keyboard** support for maximum productivity \n* \u2328\ufe0f **International Keyboard Layouts**: Supports multiple languages \n\n\ud83d\udc4b This app is in Early Access and is actively being developed. Please let us know about any bugs you encounter via the in-app help chat or our discord.", "short_description": "Fluid is a browser, video player, gaming hub, smart tv & private hangout room in 1 app. You can have windows all around you or play your favorite game solo or stream it to friends in a personal home theater. It runs entirely on your headset. No PC required."}]}, "developer_name": "Fluid", "developer_privacy_policy_url": "https://www.fluid.so/privacy", "developer_terms_of_service_url": "https://www.fluid.so/tos", "publisher_name": "Fluid", "support_website_url": "https://fluid.so/support", "website_url": "https://fluid.so/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}, {"id": "393222478507326"}, {"id": "1063584910766706"}, {"id": "1055187466124150"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD", "HAND_TRACKING", "OCULUS_TOUCH", "TRACKED_KEYBOARD"], "supported_playe
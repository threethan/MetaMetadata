ENT", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982607_690148956260496_6818253247735988207_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MtNNTz7FtboQ7kNvwESOjS4&_nc_oc=AdmxhEECDMYAPvEmlxibGwo-7fBM_MXERDSLgE973LrWdlUuGG6m8IcuuAZqod96Eo8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfzhG_vRitcVNVfop9xbIRzjPwd8bHEMgSnx5aGeVphLnQ&oe=69B946F5"}]}, "id": "1477213567094066", "locale": "en_US", "screenshots": [{"file_name": "smarttv 1.png", "id": "803281735463330", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491822034_803281738796663_1192707244839949480_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rlta7pUXHQIQ7kNvwEWYefD&_nc_oc=AdlFXgm-vJppI8mmLJjOlCHk3_YJHWePsYq5W_llh8JJ4XG8tEDUGJQAw629L4qtaWA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfyhkYPdy2ZAca5xDLHW-fT9pD4zEnylDzU4uusjhokQlw&oe=69B94C57"}, {"file_name": "Screenshot-1.png", "id": "3715217121957667", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473392127_3715217125291000_4057790498626262101_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f05K6tBFvmcQ7kNvwEIvFYe&_nc_oc=AdmyZibVvYUJ0d0mguDAKfBF3uQL35jQs3fc_zty4zLfOHlEE7bBg82bhDIDJZRF-GE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfzMxyeVnQrBrhIy0cCQX_b06MbnToWhaPBGyDU-QkChzg&oe=69B963FB"}, {"file_name": "Screenshot.png", "id": "9347445165351774", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473392023_9347445175351773_1304065713031920436_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zhkHcaptJtQQ7kNvwHtLA9H&_nc_oc=AdmPHJGVHsXwvQotczfyCNnfAEshFX-p_NRg2Ez6Dde40sEkwr4dTPWI4jVrrk7hVlE&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfyOrQgl1gf8OOnfI36fdIJHZVWPVjF3_o0o1ou00fIEsg&oe=69B95EF1"}, {"file_name": "Screenshot.png", "id": "1513467826707408", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473392168_1513467830040741_2579543078842798870_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=efsi6m3GyHUQ7kNvwGWlKEk&_nc_oc=Admlbjfc_jDMi1PZ35KdBBZfSaqLwe_tSyA9ww54wpQt_lhOStsRnhXRV93-XIUZJ1U&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfwiTEnbukVuAQO3sJg0v5aLRCrUR32yvKtmVQAr2rcNGg&oe=69B93221"}, {"file_name": "Screenshot-2.png", "id": "1370761794272177", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473393961_1370761797605510_8557991468053698635_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VNYkEbtultwQ7kNvwHim31H&_nc_oc=AdnGXoxohFxXQ-QVYTRX3kXare31T-54_amihBLlEZ5DtmVh2OnleO-XEUHhfYXERKU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfwW5nXpcYSB9ZudeES7BIzkY-5gROfe-h_QsiWzj_tZaA&oe=69B93994"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "16_9.png", "id": "1566334741483998", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499618277_1566334744817331_1936161901977034439_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v5r2LP2Iaq8Q7kNvwEE8Hkc&_nc_oc=AdngqdJXGRJ3mg00DD-MkQFMhJtQ_NujcL6Ujd_soi3EIAJFH6UmyRBpUQ0a2WWa48c&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfyW9JeI5uIMFICW6swRxoR94qbxfG0Xb2MhKrHX_5jefw&oe=69B95648"}, "display_name": "Fluid Browser + Video Player", "keywords": ["video", "streaming", "productivity", "browser"], "long_description": "# Browser - Video Player - Gaming Hub - Smart Tv - Screen Sharing\n\nYou can have **windows** all around you or play your favorite game solo or stream it to friends in a personal home theater. It runs entirely on your headset. **No PC required.**\n\n* \ud83d\udcfa **Smart TV** Perfect for watching streaming services or **local video** files with light fx. **Note**: Netflix is not supported.\n{1531996061225774}\n* \u25b6\ufe0f **Play local video files** saved on your headset, including 3D SBS video. (MKV and MP4 supported, ISO and MVC not supported)\n* \ud83c\udfae Use a **Gamepad** to play Xbox Cloud Gaming, GeForce Now & other online games (gamepad tracking only for Xbox/PS5 controller)\n{1340957747347833}\n* \ud83d\udedc **Screen Sharing** tabs + video files in private rooms from headset to headset (no pc needed)\n* \ud83d\udc65 **Join rooms** to collaborate or watch videos together on shared screens.\n* \ud83c\udfde\ufe0f Beautiful **virtual environments** or full mixed-reality experience \n* \ud83d\udcbb **Apps and webpages** can be placed anywhere around you in 3D space. \n{1211559177549801}\n* \ud83d\udda5\ufe0f **Fluid Link**, our (experimental & paid) PC screen streaming add on.\n* \ud83d\uddb1\ufe0f Wireless **Mouse & Keyboard** support for maximum productivity \n* \u2328\ufe0f **International Keyboard Layouts**: Supports multiple languages \n\n\ud83d\udc4b This app is in Early Access and is actively being developed. Please let us know about any bugs you encounter via the in-app help chat or our discord.", "short_description": "Fluid is a browser, video player, gaming hub, smart tv & private hangout room in 1 app. You can have windows all around you or play your favorite game solo or stream it to friends in a personal home theater. It runs entirely on your headset. No PC required."}]}, "developer_name": "Fluid", "developer_privacy_policy_url": "https://www.fluid.so/privacy", "developer_terms_of_service_url": "https://www.fluid.so/tos", "publisher_name": "Fluid", "support_website_url": "https://fluid.so/support", "website_url": "https://fluid.so/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}, {"id": "393222478507326"}, {"id": "1063584910766706"}, {"id": "1055187466124150"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD", "HAND_TRACKING", "OCULUS_TOUCH", "TRACKED_KEYBOARD"], "supported_playe
ENT", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982607_690148956260496_6818253247735988207_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hQRNi6wX3vYQ7kNvwF1Gc3q&_nc_oc=Adn4WzSh_jf1XO3lfmrddmCu7C-tkiGnbprWcdG4kDeEgamBHgix7-IFkkvH5MDEU1s&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfxYR2PnxWHvvJZ-YbXHch-dnVfczAsGggcvU4SdRyQldQ&oe=69BE8CF5"}]}, "id": "1477213567094066", "locale": "en_US", "screenshots": [{"file_name": "smarttv 1.png", "id": "803281735463330", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491822034_803281738796663_1192707244839949480_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DikGKIGE7pIQ7kNvwF_G82K&_nc_oc=AdmWDXE-IMkaBHzLhgCxi_g5ejOkiJmlqOsYXkHeNpkmSk9yqHthJsmOSv5orNaT8sg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_Afwt-p69p4DiMqWYnF2lwzKZnyYJJcUuym2mz_zAwNPUiA&oe=69BE9257"}, {"file_name": "Screenshot-1.png", "id": "3715217121957667", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473392127_3715217125291000_4057790498626262101_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dCGICVqv3EUQ7kNvwGBmK4R&_nc_oc=AdnsxwEZxBdm9I0cyv2wcn23GJ93laCLTiAJ3uln_PzpTIKoUpNE8G2mDqFqsfOMams&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfxSvopiNC5NpQZLU4G4yr7Pw3gqB78AhuvKOMalLrmZMA&oe=69BEA9FB"}, {"file_name": "Screenshot.png", "id": "9347445165351774", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473392023_9347445175351773_1304065713031920436_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lvTkTCUJq1wQ7kNvwFX1SnU&_nc_oc=AdlRTgi2wCPtgKYSKK8wiwuIHWHslMcSQ8PcU_UswYjwSejUVfzzmRNX76ZSVPA7xXo&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_Afx2kMr4G8XT7rS-i9UBv62SfU1dEpnrNoVcP-pNqeZwsQ&oe=69BEA4F1"}, {"file_name": "Screenshot.png", "id": "1513467826707408", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473392168_1513467830040741_2579543078842798870_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EER_ptBg7t0Q7kNvwE9J3lr&_nc_oc=Adn20qABSGIXea4gvczUUPm7nN0sWuvTrf1gb01w3tknErv-UAt-8an0BFZyGI-Ifn4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfzF3Rg7tgOQZ9jJpojKTs4vTftE64nFFYgdY6zFrQow_g&oe=69BE7821"}, {"file_name": "Screenshot-2.png", "id": "1370761794272177", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473393961_1370761797605510_8557991468053698635_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=73QMCmJ42fkQ7kNvwG5XBa9&_nc_oc=AdlnqRDh-8H_nSOAYRO_oAAA1A1nLXWnhMA1iNd_xeiLsGj7C0M6MCSSuBm1o8yyX6I&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfwnrWe0I7XNs29ITD2EmNRKKJstNgq7eEx5IZ3zeNa6Fw&oe=69BE7F94"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "16_9.png", "id": "1566334741483998", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499618277_1566334744817331_1936161901977034439_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PGMoJiBYyx0Q7kNvwGasUaw&_nc_oc=Adl_dOHDhJb4yeTeG1FDGyGEhaMORstrrXwHvp-CQdRgd91StDt3ns3zs8RH2TwObrA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfxsrY8ZH7-h474SOvtSrSv_Erc0diEyg5bLbZP8-10E4A&oe=69BE9C48"}, "display_name": "Fluid Browser + Video Player", "keywords": ["video", "streaming", "productivity", "browser"], "long_description": "# Browser - Video Player - Gaming Hub - Smart Tv - Screen Sharing\n\nYou can have **windows** all around you or play your favorite game solo or stream it to friends in a personal home theater. It runs entirely on your headset. **No PC required.**\n\n* \ud83d\udcfa **Smart TV** Perfect for watching streaming services or **local video** files with light fx. **Note**: Netflix is not supported.\n{1531996061225774}\n* \u25b6\ufe0f **Play local video files** saved on your headset, including 3D SBS video. (MKV and MP4 supported, ISO and MVC not supported)\n* \ud83c\udfae Use a **Gamepad** to play Xbox Cloud Gaming, GeForce Now & other online games (gamepad tracking only for Xbox/PS5 controller)\n{1340957747347833}\n* \ud83d\udedc **Screen Sharing** tabs + video files in private rooms from headset to headset (no pc needed)\n* \ud83d\udc65 **Join rooms** to collaborate or watch videos together on shared screens.\n* \ud83c\udfde\ufe0f Beautiful **virtual environments** or full mixed-reality experience \n* \ud83d\udcbb **Apps and webpages** can be placed anywhere around you in 3D space. \n{1211559177549801}\n* \ud83d\udda5\ufe0f **Fluid Link**, our (experimental & paid) PC screen streaming add on.\n* \ud83d\uddb1\ufe0f Wireless **Mouse & Keyboard** support for maximum productivity \n* \u2328\ufe0f **International Keyboard Layouts**: Supports multiple languages \n\n\ud83d\udc4b This app is in Early Access and is actively being developed. Please let us know about any bugs you encounter via the in-app help chat or our discord.", "short_description": "Fluid is a browser, video player, gaming hub, smart tv & private hangout room in 1 app. You can have windows all around you or play your favorite game solo or stream it to friends in a personal home theater. It runs entirely on your headset. No PC required."}]}, "developer_name": "Fluid", "developer_privacy_policy_url": "https://www.fluid.so/privacy", "developer_terms_of_service_url": "https://www.fluid.so/tos", "publisher_name": "Fluid", "support_website_url": "https://fluid.so/support", "website_url": "https://fluid.so/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}, {"id": "393222478507326"}, {"id": "1063584910766706"}, {"id": "1055187466124150"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD", "HAND_TRACKING", "OCULUS_TOUCH", "TRACKED_KEYBOARD"], "supported_playe
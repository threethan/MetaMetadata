c=Mgd1ONQ5w1kQ7kNvwFffsU-&_nc_oc=Ado0EWZheV5dBi_6yAPv0B0rcQXFZKgHB4qE_i0c1H1RJAE8D_obO1EwmSLWy3HtEqA&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxiEaaXrsVuwEfI4Jn_Hq9_CIl71ZHKdFhN-Dne3QzKjg&oe=69CE8261"}, {"file_name": "Screenshot-2.png", "id": "1370761794272177", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473393961_1370761797605510_8557991468053698635_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w54h_GuuVloQ7kNvwEAWZHr&_nc_oc=AdryTXkSEhohcZbTdM9Q-USnO2gVo5k69jEd71UpusnVQPIY1hiz80E8SX_8ItsPuUQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxwwlycXcJeUtDtLbbtxzXEalDpWdnFLflHtlrtToVXtg&oe=69CE5194"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "16_9.png", "id": "1566334741483998", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499618277_1566334744817331_1936161901977034439_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gspSdfMUElEQ7kNvwHmEPHt&_nc_oc=AdrvzSQFVNMkui5N7PAmFd-E5quyAwdiQdjaFw_3v0zVCmTX5v3wWq8DGVCKaTd0M1Y&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afx2m21CpFWeqdMFHS3Kt_vIMNmPckQOYe4PQq7ZtjGNlQ&oe=69CE6E48"}, "display_name": "Fluid Browser + Video Player", "keywords": ["video", "streaming", "productivity", "browser"], "long_description": "# Browser - Video Player - Gaming Hub - Smart Tv - Screen Sharing\n\nYou can have **windows** all around you or play your favorite game solo or stream it to friends in a personal home theater. It runs entirely on your headset. **No PC required.**\n\n* \ud83d\udcfa **Smart TV** Perfect for watching streaming services or **local video** files with light fx. **Note**: Netflix is not supported.\n{1531996061225774}\n* \u25b6\ufe0f **Play local video files** saved on your headset, including 3D SBS video. (MKV and MP4 supported, ISO and MVC not supported)\n* \ud83c\udfae Use a **Gamepad** to play Xbox Cloud Gaming, GeForce Now & other online games (gamepad tracking only for Xbox/PS5 controller)\n{1340957747347833}\n* \ud83d\udedc **Screen Sharing** tabs + video files in private rooms from headset to headset (no pc needed)\n* \ud83d\udc65 **Join rooms** to collaborate or watch videos together on shared screens.\n* \ud83c\udfde\ufe0f Beautiful **virtual environments** or full mixed-reality experience \n* \ud83d\udcbb **Apps and webpages** can be placed anywhere around you in 3D space. \n{1211559177549801}\n* \ud83d\udda5\ufe0f **Fluid Link**, our (experimental & paid) PC screen streaming add on.\n* \ud83d\uddb1\ufe0f Wireless **Mouse & Keyboard** support for maximum productivity \n* \u2328\ufe0f **International Keyboard Layouts**: Supports multiple languages \n\n\ud83d\udc4b This app is in Early Access and is actively being developed. Please let us know about any bugs you encounter via the in-app help chat or our discord.", "short_description": "Fluid is a browser, video player, gaming hub, smart tv & private hangout room in 1 app. You can have windows all around you or play your favorite game solo or stream it to friends in a personal home theater. It runs entirely on your headset. No PC required."}]}, "developer_name": "Fluid", "developer_privacy_policy_url": "https://www.fluid.so/privacy", "developer_terms_of_service_url": "https://www.fluid.so/tos", "publisher_name": "Fluid", "support_website_url": "https://fluid.so/support", "website_url": "https://fluid.so/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}, {"id": "393222478507326"}, {"id": "1063584910766706"}, {"id": "1055187466124150"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD", "HAND_TRACKING", "OCULUS_TOUCH", "TRACKED_KEYBOARD"], "supported_player_modes": ["SITTING", "ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER"], "id": "26400681139550048"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499618432_871462518614633_7179811164861204839_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I5rRP6AqqtAQ7kNvwGP0hca&_nc_oc=AdqtB8K2Vmjh-Zo2YdXsaXaclsxo3n3HrJfSjO6MB_jIGXmHOBAh21V6RU1r441YxQg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfygwISiMvsTwYMdRkgpARBxYScNlp_eqrVCWzNqu_KXlg&oe=69CE57FF"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Fluid Browser + Video Player", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_name": "Media", "id": "434961926215971"}, {"topic_name": "Utilities", "id": "393222478507326"}, {"topic_name": "Productivity", "id": "1063584910766706"}, {"topic_name": "Computer Link", "id": "1055187466124150"}], "release_date": 1696948079, "lastRevision": {"nodes": [{"id": "6946182758759843", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "6946182742093178", "is_first_party": false, "enables_in_app_ads": false, "is_concept": false, "platform": "ANDROID_6DOF"}, "iarc_cert": {"id": "1040497263986882"}, "iarc_email": null, "msrp": null, "translations": {"nodes": [{"images": {"nodes": [{"file_name": "Mini Landscape Cover Art (1).png", "id": "864254745041332", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39036649_864254748374665_8657007443117093945_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YsoeqLIsnDIQ7kNvwFOWluT&_nc_oc=AdouyJacc_FLTz7IvzjCblJBkfqOe6s5xoAvdFI_bAbZxb7uqr9CWIH5niLr4UKHHB0&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.
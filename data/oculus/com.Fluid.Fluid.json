ENT", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982607_690148956260496_6818253247735988207_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oQiihSe7lJ4Q7kNvwGXVtIA&_nc_oc=AdmJ5KvBmMBm6KZ4S2jJsFiHtpp87KhCnpZFQMe5Czlc2Az_3L3suQWuuBg77MZx3AU&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfwJOdKjE_mgNbBQLOHUP3biQS8CWQkOsP-nFrb0EUreiw&oe=69B6A3F5"}]}, "id": "1477213567094066", "locale": "en_US", "screenshots": [{"file_name": "smarttv 1.png", "id": "803281735463330", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491822034_803281738796663_1192707244839949480_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zke6ucl0SPYQ7kNvwEooBNB&_nc_oc=AdnnszQtZ3ZnMWI6imdA-BR7Lql-b0TfKickPOq8QgZCBsHqyZKO_3pJ-mrROB6plcs&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfxoZodHALgm9JOpkb8sDjWbyauEbrmE5gXjf2sav1Kcyw&oe=69B6A957"}, {"file_name": "Screenshot-1.png", "id": "3715217121957667", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473392127_3715217125291000_4057790498626262101_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qUhot8gVX30Q7kNvwHCw1Bo&_nc_oc=AdnWqNBcxhYXhB5VMckV0lKXhJ_cGa2WU-kZMWkJ95JDh8PkB2q_4K6YRarEjQITYfM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_Afx-ifnCvzwOWmWn_ePJ6wAzpD6TfvZ0qI4qMhfx3esb4Q&oe=69B6C0FB"}, {"file_name": "Screenshot.png", "id": "9347445165351774", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473392023_9347445175351773_1304065713031920436_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3d_wm_3EMuYQ7kNvwEZk3Ri&_nc_oc=AdlOg2ByLU-nuh0AgxadmIYLQMhRrCPgR0SIQrgKQqc3nXwKtJwkLW-f-ppXO-jjVSM&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfzXaBL5zWyRB_qGXfMWmN52ctDrH_EGhCfcrw-wXHtNQw&oe=69B6BBF1"}, {"file_name": "Screenshot.png", "id": "1513467826707408", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473392168_1513467830040741_2579543078842798870_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=efsi6m3GyHUQ7kNvwERY1QM&_nc_oc=AdkWvnjpUuTjmm34lthHJ2TIxbOjovEnxPRU5iz_W8fVzj06jZX9WxVAhYzvAqzMBiQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfxJHubaH7EEdi0zgw_5xLSS_Dg7lLmAbg6UTPLbAH-V7Q&oe=69B68F21"}, {"file_name": "Screenshot-2.png", "id": "1370761794272177", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473393961_1370761797605510_8557991468053698635_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a-ZBgxvFOc8Q7kNvwENkWYE&_nc_oc=AdnQrclt-y0dBKnJqF_e98x2Var3bHjF687IbT-3HBs-Cg5rEWHPlsbE5WsMfk9o06k&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfxuXEY8-7SFP84hb-a4tN5CSv-uEUzfT764XouyfH44Rw&oe=69B69694"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "16_9.png", "id": "1566334741483998", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499618277_1566334744817331_1936161901977034439_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v5r2LP2Iaq8Q7kNvwGxm2LU&_nc_oc=Adnkn2tsSR7tra37AvfsdwlRimJjkDsn7FiZiD6FuB2w8PKU2_GfJ09YHfZGoiGl33Q&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_Afzhyclm0-kn9w4OaQyQaSnkYQhKUOSfVimFJ8Z9TjlDDA&oe=69B6B348"}, "display_name": "Fluid Browser + Video Player", "keywords": ["video", "streaming", "productivity", "browser"], "long_description": "# Browser - Video Player - Gaming Hub - Smart Tv - Screen Sharing\n\nYou can have **windows** all around you or play your favorite game solo or stream it to friends in a personal home theater. It runs entirely on your headset. **No PC required.**\n\n* \ud83d\udcfa **Smart TV** Perfect for watching streaming services or **local video** files with light fx. **Note**: Netflix is not supported.\n{1531996061225774}\n* \u25b6\ufe0f **Play local video files** saved on your headset, including 3D SBS video. (MKV and MP4 supported, ISO and MVC not supported)\n* \ud83c\udfae Use a **Gamepad** to play Xbox Cloud Gaming, GeForce Now & other online games (gamepad tracking only for Xbox/PS5 controller)\n{1340957747347833}\n* \ud83d\udedc **Screen Sharing** tabs + video files in private rooms from headset to headset (no pc needed)\n* \ud83d\udc65 **Join rooms** to collaborate or watch videos together on shared screens.\n* \ud83c\udfde\ufe0f Beautiful **virtual environments** or full mixed-reality experience \n* \ud83d\udcbb **Apps and webpages** can be placed anywhere around you in 3D space. \n{1211559177549801}\n* \ud83d\udda5\ufe0f **Fluid Link**, our (experimental & paid) PC screen streaming add on.\n* \ud83d\uddb1\ufe0f Wireless **Mouse & Keyboard** support for maximum productivity \n* \u2328\ufe0f **International Keyboard Layouts**: Supports multiple languages \n\n\ud83d\udc4b This app is in Early Access and is actively being developed. Please let us know about any bugs you encounter via the in-app help chat or our discord.", "short_description": "Fluid is a browser, video player, gaming hub, smart tv & private hangout room in 1 app. You can have windows all around you or play your favorite game solo or stream it to friends in a personal home theater. It runs entirely on your headset. No PC required."}]}, "developer_name": "Fluid", "developer_privacy_policy_url": "https://www.fluid.so/privacy", "developer_terms_of_service_url": "https://www.fluid.so/tos", "publisher_name": "Fluid", "support_website_url": "https://fluid.so/support", "website_url": "https://fluid.so/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}, {"id": "393222478507326"}, {"id": "1063584910766706"}, {"id": "1055187466124150"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD", "HAND_TRACKING", "OCULUS_TOUCH", "TRACKED_KEYBOARD"], "supported_playe
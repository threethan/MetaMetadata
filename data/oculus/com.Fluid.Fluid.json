_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kd7D7g0PJekQ7kNvwHPbIPQ&_nc_oc=AdrWgxGqbrpltu2CPYInSZOhjnAsnmzSK9REvwA9VS7Zhjika8omdVZMSLJr5969obk&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af43dn19ZXRyHCKSroHHjhnXBVG0BZWoMhKmT-aFZ1Hbag&oe=6A11BEE1"}, {"file_name": "Screenshot-2.png", "id": "1370761794272177", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/473393961_1370761797605510_8557991468053698635_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E8E2rLBC8kcQ7kNvwEVKiJZ&_nc_oc=AdrWq8W0LhBJzYzY9-MiOTTtbfB6ayI4s4x_OBxIqLPpPJsi_YWUjsp1lpKGynYnOLo&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af55EGut7hgaN3AwV01asIxSTVsXOyhVt6xP3FwRK7au6A&oe=6A11C654"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "16_9.png", "id": "1566334741483998", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/499618277_1566334744817331_1936161901977034439_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2ZhwMEvHXq0Q7kNvwH9CYZM&_nc_oc=Adp3mr50Pqc6lcoQ86pkAANvqLQpy39V58lxgTEKNDG36G_4ThixKClqKdgXAjllEcc&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5yCcVr9zhjo91Ssy-38WZ8TCZABgaiuUCsFX9oJHmomA&oe=6A11AAC8"}, "display_name": "Fluid Browser + Video Player", "keywords": ["video", "streaming", "productivity", "browser"], "long_description": "# Browser - Video Player - Gaming Hub - Smart Tv - Screen Sharing\n\nYou can have **windows** all around you or play your favorite game solo or stream it to friends in a personal home theater. It runs entirely on your headset. **No PC required.**\n\n* \ud83d\udcfa **Smart TV** Perfect for watching streaming services or **local video** files with light fx. **Note**: Netflix is not supported.\n{1531996061225774}\n* \u25b6\ufe0f **Play local video files** saved on your headset, including 3D SBS video. (MKV and MP4 supported, ISO and MVC not supported)\n* \ud83c\udfae Use a **Gamepad** to play Xbox Cloud Gaming, GeForce Now & other online games (gamepad tracking only for Xbox/PS5 controller)\n{1340957747347833}\n* \ud83d\udedc **Screen Sharing** tabs + video files in private rooms from headset to headset (no pc needed)\n* \ud83d\udc65 **Join rooms** to collaborate or watch videos together on shared screens.\n* \ud83c\udfde\ufe0f Beautiful **virtual environments** or full mixed-reality experience \n* \ud83d\udcbb **Apps and webpages** can be placed anywhere around you in 3D space. \n{1211559177549801}\n* \ud83d\udda5\ufe0f **Fluid Link**, our (experimental & paid) PC screen streaming add on.\n* \ud83d\uddb1\ufe0f Wireless **Mouse & Keyboard** support for maximum productivity \n* \u2328\ufe0f **International Keyboard Layouts**: Supports multiple languages \n\n\ud83d\udc4b This app is in Early Access and is actively being developed. Please let us know about any bugs you encounter via the in-app help chat or our discord.", "short_description": "Fluid is a browser, video player, gaming hub, smart tv & private hangout room in 1 app. You can have windows all around you or play your favorite game solo or stream it to friends in a personal home theater. It runs entirely on your headset. No PC required."}]}, "developer_name": "Fluid", "developer_privacy_policy_url": "https://www.fluid.so/privacy", "developer_terms_of_service_url": "https://www.fluid.so/tos", "publisher_name": "Fluid", "support_website_url": "https://fluid.so/support", "website_url": "https://fluid.so/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}, {"id": "393222478507326"}, {"id": "1063584910766706"}, {"id": "1055187466124150"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_d
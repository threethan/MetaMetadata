ENT", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982607_690148956260496_6818253247735988207_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DPUObGvD09EQ7kNvwFYTNcO&_nc_oc=AdkKxOyRM5xMlB3KsdvlLnV1xopm0OVUyFtBNfHUuomvICl85V5gmmYQ2_-9BZstlFI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfsUEwNt01UWTcGCo0qvZTuZRDF5Y9BHRKGg6RZUM17L0Q&oe=69A82375"}]}, "id": "1477213567094066", "locale": "en_US", "screenshots": [{"file_name": "smarttv 1.png", "id": "803281735463330", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491822034_803281738796663_1192707244839949480_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nRD_jjLvm4oQ7kNvwGlbNV7&_nc_oc=AdlbF8ADpWzGGpXrfW-GAE3DyXlUJF7umiA6yyipZVaC04sAvfhNLSxOwsaDDil45_A&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfsPJWRZkFi0J__jRDI_VAEnGIwQMF4iL6-dxxBs_1M3hQ&oe=69A828D7"}, {"file_name": "Screenshot-1.png", "id": "3715217121957667", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473392127_3715217125291000_4057790498626262101_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yuhsVI5tFvcQ7kNvwEa4CDW&_nc_oc=Adlb2zn1gFYcZqtLwL5PUSsaUo24Pgr-Mr0VDL5hu3uG8qgTchuZe2lwzzE5GAx2aMc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afv5ScGatu8S9YMPWuQKRl3KhwuZoBGcbPS3Hv5F5ya-Rw&oe=69A8083B"}, {"file_name": "Screenshot.png", "id": "9347445165351774", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473392023_9347445175351773_1304065713031920436_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4bEB3q_MGsMQ7kNvwGxnRRt&_nc_oc=AdmY9J_8-DA5ZSsIYlY20kpj_55kp7viXp8W0C3lhDCGLF29G0ewfFr-ksc4VEfe-IQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AftOa4AQcgVstwTIv23XsW14nLwJE5PKFodQX0SZKw4Rhg&oe=69A83B71"}, {"file_name": "Screenshot.png", "id": "1513467826707408", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473392168_1513467830040741_2579543078842798870_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fTd8mB9ENugQ7kNvwFERFD1&_nc_oc=AdnN82ygQBEFFjzbUIY0X25KZhJh9R06lUN0vuUvmGHoe2iteCvdHW_Y1b9aKG1z7pY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afs3hFOToza8vkG8WbLV7NLGL_uHDIDbjRAUH7uxNWtVMw&oe=69A80EA1"}, {"file_name": "Screenshot-2.png", "id": "1370761794272177", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473393961_1370761797605510_8557991468053698635_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VlvmHo_DhYgQ7kNvwHMagIM&_nc_oc=AdlzhKkji5vGlEGnsyLDycJjrd0Dg77JKG5zEoyCbLnjpZETSZudTqyvPbIdcD6j-5M&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AftcJUh2B4vi3mJtXeMZSyKR1oVEnJ0FHCXTuo6yGaH1jw&oe=69A81614"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "16_9.png", "id": "1566334741483998", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499618277_1566334744817331_1936161901977034439_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uCeEq4qaEaIQ7kNvwHiq4h7&_nc_oc=AdlexC6yAuh6-jbELKpE7R_SeOOSmgMhGIF21F64TM3GtmNUE4mJsEYzMxfyyCkUfs0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfuLAS-WCQPLotEMA6lBRcf_hzNDggLb6oxUY0EvUeZ9Wg&oe=69A832C8"}, "display_name": "Fluid Browser + Video Player", "keywords": ["video", "streaming", "productivity", "browser"], "long_description": "# Browser - Video Player - Gaming Hub - Smart Tv - Screen Sharing\n\nYou can have **windows** all around you or play your favorite game solo or stream it to friends in a personal home theater. It runs entirely on your headset. **No PC required.**\n\n* \ud83d\udcfa **Smart TV** Perfect for watching streaming services or **local video** files with light fx. **Note**: Netflix is not supported.\n{1531996061225774}\n* \u25b6\ufe0f **Play local video files** saved on your headset, including 3D SBS video. (MKV and MP4 supported, ISO and MVC not supported)\n* \ud83c\udfae Use a **Gamepad** to play Xbox Cloud Gaming, GeForce Now & other online games (gamepad tracking only for Xbox/PS5 controller)\n{1340957747347833}\n* \ud83d\udedc **Screen Sharing** tabs + video files in private rooms from headset to headset (no pc needed)\n* \ud83d\udc65 **Join rooms** to collaborate or watch videos together on shared screens.\n* \ud83c\udfde\ufe0f Beautiful **virtual environments** or full mixed-reality experience \n* \ud83d\udcbb **Apps and webpages** can be placed anywhere around you in 3D space. \n{1211559177549801}\n* \ud83d\udda5\ufe0f **Fluid Link**, our (experimental & paid) PC screen streaming add on.\n* \ud83d\uddb1\ufe0f Wireless **Mouse & Keyboard** support for maximum productivity \n* \u2328\ufe0f **International Keyboard Layouts**: Supports multiple languages \n\n\ud83d\udc4b This app is in Early Access and is actively being developed. Please let us know about any bugs you encounter via the in-app help chat or our discord.", "short_description": "Fluid is a browser, video player, gaming hub, smart tv & private hangout room in 1 app. You can have windows all around you or play your favorite game solo or stream it to friends in a personal home theater. It runs entirely on your headset. No PC required."}]}, "developer_name": "Fluid", "developer_privacy_policy_url": "https://www.fluid.so/privacy", "developer_terms_of_service_url": "https://www.fluid.so/tos", "publisher_name": "Fluid", "support_website_url": "https://fluid.so/support", "website_url": "https://fluid.so/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}, {"id": "393222478507326"}, {"id": "1063584910766706"}, {"id": "1055187466124150"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD", "HAND_TRACKING", "OCULUS_TOUCH", "TRACKED_KEYBOARD"], "supported_playe
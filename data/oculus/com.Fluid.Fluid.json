ENT", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982607_690148956260496_6818253247735988207_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q5nI9kybWo0Q7kNvwH3vr0v&_nc_oc=Adnz6GbRFCTa1vl6BfXN3ObsyIZ5kQD_FEEYabwhTaFxr2klnpY2mk8urp9LUMRUTRc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfwnQFJA2QcpwZ3aAsIK5en1R7uZlqUSF9YZmcqndjhngg&oe=69AC17F5"}]}, "id": "1477213567094066", "locale": "en_US", "screenshots": [{"file_name": "smarttv 1.png", "id": "803281735463330", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491822034_803281738796663_1192707244839949480_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=10FteZVRiB0Q7kNvwHpZFoG&_nc_oc=AdlII6W1rJhBqSxK4bWUnq4PTroLypoNd12hUMMv33eej_GakTEa4NgTOrwS6SEc5N4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfwjwmjhYVGXx5baELJxxruz1q9gkXDS7AeMQyjGxIDy8w&oe=69AC1D57"}, {"file_name": "Screenshot-1.png", "id": "3715217121957667", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473392127_3715217125291000_4057790498626262101_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_PbpGv5E76YQ7kNvwGjzr6m&_nc_oc=AdnTH3ui6iqVim4tbv2qujwb1s2bPuBEk6AVK1SXAm4EVLHXnSG_eVjRzJO9uCqur9Q&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_Afx0fOxLXqzKZ9CcRtau5r_qAHaq50w5o3AfzOsWsKP1mA&oe=69AC34FB"}, {"file_name": "Screenshot.png", "id": "9347445165351774", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473392023_9347445175351773_1304065713031920436_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Mb3pSE5fKv4Q7kNvwH9ROn5&_nc_oc=Adm4BO46RNYt4POWMt25jdd_8G1FJy0M5JiU4OCm9HO0HmBjEWM3P2zKAR20ZDyhQXU&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afxt7PDxYhZ1uV-tJfcI0MPM-3V2mK2EyHceMbvVccKMpw&oe=69AC2FF1"}, {"file_name": "Screenshot.png", "id": "1513467826707408", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473392168_1513467830040741_2579543078842798870_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TbujzTg6BFgQ7kNvwHlXOiW&_nc_oc=AdnvLX7UQRRIvjY5G0rkLPNRRlhKG2migu6c4IK2VTXqWwT2_uSCVJvp5HtZAA5waGU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfxLor5-GEjNkpPGYd21g4GX_gRpki1_VK-_ndKMytpGkg&oe=69AC0321"}, {"file_name": "Screenshot-2.png", "id": "1370761794272177", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473393961_1370761797605510_8557991468053698635_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=puIQhyTBzT4Q7kNvwEgfUU0&_nc_oc=Adnk-RDMA5FczWmkvJ5EocEtKJVw7bkEPoyNpPg2xu0Rxp0YIdxECV4OIMl9uglRYIo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfzKOl4G3nkNZzbyfztILwgcwuFX6-NnqJSA3BD05uLQaA&oe=69AC0A94"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "16_9.png", "id": "1566334741483998", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499618277_1566334744817331_1936161901977034439_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qTCCzglvuSIQ7kNvwFCCk40&_nc_oc=AdkhxomZBt0HmL6hwcPQPrr50H7D7UAc6Dx-rSkowh3pPeY6c9PVkJRtZxd9hyMynmo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfxayuJ5_3mVNPRn3R8VeZbfeEwO16WT40FLfC8Gaeur2w&oe=69AC2748"}, "display_name": "Fluid Browser + Video Player", "keywords": ["video", "streaming", "productivity", "browser"], "long_description": "# Browser - Video Player - Gaming Hub - Smart Tv - Screen Sharing\n\nYou can have **windows** all around you or play your favorite game solo or stream it to friends in a personal home theater. It runs entirely on your headset. **No PC required.**\n\n* \ud83d\udcfa **Smart TV** Perfect for watching streaming services or **local video** files with light fx. **Note**: Netflix is not supported.\n{1531996061225774}\n* \u25b6\ufe0f **Play local video files** saved on your headset, including 3D SBS video. (MKV and MP4 supported, ISO and MVC not supported)\n* \ud83c\udfae Use a **Gamepad** to play Xbox Cloud Gaming, GeForce Now & other online games (gamepad tracking only for Xbox/PS5 controller)\n{1340957747347833}\n* \ud83d\udedc **Screen Sharing** tabs + video files in private rooms from headset to headset (no pc needed)\n* \ud83d\udc65 **Join rooms** to collaborate or watch videos together on shared screens.\n* \ud83c\udfde\ufe0f Beautiful **virtual environments** or full mixed-reality experience \n* \ud83d\udcbb **Apps and webpages** can be placed anywhere around you in 3D space. \n{1211559177549801}\n* \ud83d\udda5\ufe0f **Fluid Link**, our (experimental & paid) PC screen streaming add on.\n* \ud83d\uddb1\ufe0f Wireless **Mouse & Keyboard** support for maximum productivity \n* \u2328\ufe0f **International Keyboard Layouts**: Supports multiple languages \n\n\ud83d\udc4b This app is in Early Access and is actively being developed. Please let us know about any bugs you encounter via the in-app help chat or our discord.", "short_description": "Fluid is a browser, video player, gaming hub, smart tv & private hangout room in 1 app. You can have windows all around you or play your favorite game solo or stream it to friends in a personal home theater. It runs entirely on your headset. No PC required."}]}, "developer_name": "Fluid", "developer_privacy_policy_url": "https://www.fluid.so/privacy", "developer_terms_of_service_url": "https://www.fluid.so/tos", "publisher_name": "Fluid", "support_website_url": "https://fluid.so/support", "website_url": "https://fluid.so/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}, {"id": "393222478507326"}, {"id": "1063584910766706"}, {"id": "1055187466124150"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD", "HAND_TRACKING", "OCULUS_TOUCH", "TRACKED_KEYBOARD"], "supported_playe
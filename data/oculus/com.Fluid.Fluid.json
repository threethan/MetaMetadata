ENT", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982607_690148956260496_6818253247735988207_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aFyRMiPxJOkQ7kNvwHJeuU2&_nc_oc=AdlkopujeibGwdXovHG3RB4tNe4RktfwGZIJZ33MnDmYPngpPLUUJrFbO5tSJKHvz5w&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfxxaJQNcu42regpfMna1UVMs7q699oxJWwQdwOlNhOtZQ&oe=69B15DF5"}]}, "id": "1477213567094066", "locale": "en_US", "screenshots": [{"file_name": "smarttv 1.png", "id": "803281735463330", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491822034_803281738796663_1192707244839949480_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r5R_GvrwyzYQ7kNvwHERDlt&_nc_oc=Adlu3einWJyiGyFAD3YnJV83dBGwY9Y942vX7ZVVpVhsrFaEV38ImtyKVisi7TTiscg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_Afz0DkbkA-_4KyYVJzTzbE8_6bcdn4okKgkpqkZUTRwcFw&oe=69B16357"}, {"file_name": "Screenshot-1.png", "id": "3715217121957667", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473392127_3715217125291000_4057790498626262101_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C5c3XdRAZ6sQ7kNvwFiz2uU&_nc_oc=AdmoMMzbvpY7UzXB7AV4BNydysYLrySEZaDH5jUfbdfr-lTP_CGVvNJBFTQIFgCfEww&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfzG2UrKqgJsCdR98D75yMF5PjEHGlp8mjYKu5v8A5atog&oe=69B17AFB"}, {"file_name": "Screenshot.png", "id": "9347445165351774", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473392023_9347445175351773_1304065713031920436_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3QDBoXbPKwsQ7kNvwEjRJZM&_nc_oc=Adnk5fJaHU_MezA69phimTOhCpYy7yuI9aFclL74QcGsGXwtpYvYRcd0YQVtjzEksYM&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_Afzpon186JG8n6jX2GhGyffbx1oMZzhH_mPF4BuC-AxEPA&oe=69B175F1"}, {"file_name": "Screenshot.png", "id": "1513467826707408", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473392168_1513467830040741_2579543078842798870_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f3Xys4kx7a8Q7kNvwEEjRpC&_nc_oc=Adkovycj14s2oaaTYYTTNsdpD7Qx32ThHL5Rajacvv92JKjuFwoHDXfqrG3DiXfrN4g&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfxhFTTpyMMjDKHsst-hXfH-biDepdff1RHRhy65ekvWSA&oe=69B14921"}, {"file_name": "Screenshot-2.png", "id": "1370761794272177", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473393961_1370761797605510_8557991468053698635_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EouyFiJV42kQ7kNvwFcr_ou&_nc_oc=AdmFZfDqof0kSRCG-0rZEwg9XWzkoIg3HcwXrxz3-6gy7vDasPcUyykN_my_5w0_s8s&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_Afw5P-7a_anvj2UUazueX5330mIC47uFvumx8gl-S_ki_w&oe=69B15094"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "16_9.png", "id": "1566334741483998", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499618277_1566334744817331_1936161901977034439_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oVLQpNTDP4gQ7kNvwExVA_0&_nc_oc=Admf0LPFnjYF2k5WSJNNEKXwoTi4-VhvZ3Nyk6J9_DMJwh99TwlOsi27RsXGMv00mtY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_Afxqqtlgok-3lsXYaD9bL4bQJ6AUgtTU5BgsxlG6K-lrJg&oe=69B16D48"}, "display_name": "Fluid Browser + Video Player", "keywords": ["video", "streaming", "productivity", "browser"], "long_description": "# Browser - Video Player - Gaming Hub - Smart Tv - Screen Sharing\n\nYou can have **windows** all around you or play your favorite game solo or stream it to friends in a personal home theater. It runs entirely on your headset. **No PC required.**\n\n* \ud83d\udcfa **Smart TV** Perfect for watching streaming services or **local video** files with light fx. **Note**: Netflix is not supported.\n{1531996061225774}\n* \u25b6\ufe0f **Play local video files** saved on your headset, including 3D SBS video. (MKV and MP4 supported, ISO and MVC not supported)\n* \ud83c\udfae Use a **Gamepad** to play Xbox Cloud Gaming, GeForce Now & other online games (gamepad tracking only for Xbox/PS5 controller)\n{1340957747347833}\n* \ud83d\udedc **Screen Sharing** tabs + video files in private rooms from headset to headset (no pc needed)\n* \ud83d\udc65 **Join rooms** to collaborate or watch videos together on shared screens.\n* \ud83c\udfde\ufe0f Beautiful **virtual environments** or full mixed-reality experience \n* \ud83d\udcbb **Apps and webpages** can be placed anywhere around you in 3D space. \n{1211559177549801}\n* \ud83d\udda5\ufe0f **Fluid Link**, our (experimental & paid) PC screen streaming add on.\n* \ud83d\uddb1\ufe0f Wireless **Mouse & Keyboard** support for maximum productivity \n* \u2328\ufe0f **International Keyboard Layouts**: Supports multiple languages \n\n\ud83d\udc4b This app is in Early Access and is actively being developed. Please let us know about any bugs you encounter via the in-app help chat or our discord.", "short_description": "Fluid is a browser, video player, gaming hub, smart tv & private hangout room in 1 app. You can have windows all around you or play your favorite game solo or stream it to friends in a personal home theater. It runs entirely on your headset. No PC required."}]}, "developer_name": "Fluid", "developer_privacy_policy_url": "https://www.fluid.so/privacy", "developer_terms_of_service_url": "https://www.fluid.so/tos", "publisher_name": "Fluid", "support_website_url": "https://fluid.so/support", "website_url": "https://fluid.so/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}, {"id": "393222478507326"}, {"id": "1063584910766706"}, {"id": "1055187466124150"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD", "HAND_TRACKING", "OCULUS_TOUCH", "TRACKED_KEYBOARD"], "supported_playe
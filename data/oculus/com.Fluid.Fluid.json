ENT", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982607_690148956260496_6818253247735988207_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q5nI9kybWo0Q7kNvwFLO1qB&_nc_oc=AdmxMDjm2koaouPVx8LBaBPJhTn3e1iAV8rItIxMjTCedJVWHWO1tp7g6572z7vMbnU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afzw-eQ-QMxn1n0KSeiSG6LTeue9VEnY4G3vYt7NbEOvLA&oe=69AEBAF5"}]}, "id": "1477213567094066", "locale": "en_US", "screenshots": [{"file_name": "smarttv 1.png", "id": "803281735463330", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491822034_803281738796663_1192707244839949480_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P5DmbDSXtiwQ7kNvwGZkly3&_nc_oc=AdloJX29e-cI06pVni4tUlAxUP45MJZr8zKFyc5bET3w213QCG9qWYXF9-w49Z6NZTQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfxdiucDhCYL5_7ktAcXbpa2sw_OB8OW0aGbysq11vX22w&oe=69AEC057"}, {"file_name": "Screenshot-1.png", "id": "3715217121957667", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473392127_3715217125291000_4057790498626262101_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_PbpGv5E76YQ7kNvwEnlGdU&_nc_oc=AdmBmzLUOk7CjZGxjvI0Rf2REtIUTjRjlFvjtqUaWLasGuqr1GutiBev4tEgAdGgalg&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afy_anyBShIjppZQGbA21OhG-V_rWYwk9G0P11lHAA64mg&oe=69AED7FB"}, {"file_name": "Screenshot.png", "id": "9347445165351774", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473392023_9347445175351773_1304065713031920436_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qSXDFGyuxqgQ7kNvwGGlvp2&_nc_oc=Admp68sQNYKfcd9i6KPnZkV5eRTWDZZP3TuHkQB2CgjVaTkRD0o8q291YNtd79YJMmI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfxC6y2ewaj_QyBT4SXAhWP0tCu_vvWnA2SfS9VYLdx_lQ&oe=69AED2F1"}, {"file_name": "Screenshot.png", "id": "1513467826707408", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473392168_1513467830040741_2579543078842798870_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f3Xys4kx7a8Q7kNvwFJEH6Q&_nc_oc=AdmF6nd9Qdm0Fqc_rYgY8rD7IsNe8rJ0OCQCbtJtELrdPWqk-1CffzBXWdF3Rax3sjg&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afx1DnDZQqdSFsy6fZkXGeTwyaVc6Jsv-uEPB6SBRoIK5w&oe=69AEA621"}, {"file_name": "Screenshot-2.png", "id": "1370761794272177", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473393961_1370761797605510_8557991468053698635_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ii18x6JfREkQ7kNvwFmnf6Y&_nc_oc=AdnNIPiuJnALpn2UDXCyK-I_TKhcEd3Cmr0zI43lfq5Sj52QZFVe1aupA94K8Qa2MmM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfwujmlWHRD9lnIfRI9xoCHGUVqnB8K4IZoWIkWPh292Gg&oe=69AEAD94"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "16_9.png", "id": "1566334741483998", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499618277_1566334744817331_1936161901977034439_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oVLQpNTDP4gQ7kNvwELUWLW&_nc_oc=AdmeFcCroZv21_7cvdwAGx1QbXcE3mBrBXHJQk_N8W4OAuFe2RZozqlnvhLrk8dcicY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfyRxe7bi4CpZJecaF23170sx8ENT6c-DwURrVHC7G6_5Q&oe=69AECA48"}, "display_name": "Fluid Browser + Video Player", "keywords": ["video", "streaming", "productivity", "browser"], "long_description": "# Browser - Video Player - Gaming Hub - Smart Tv - Screen Sharing\n\nYou can have **windows** all around you or play your favorite game solo or stream it to friends in a personal home theater. It runs entirely on your headset. **No PC required.**\n\n* \ud83d\udcfa **Smart TV** Perfect for watching streaming services or **local video** files with light fx. **Note**: Netflix is not supported.\n{1531996061225774}\n* \u25b6\ufe0f **Play local video files** saved on your headset, including 3D SBS video. (MKV and MP4 supported, ISO and MVC not supported)\n* \ud83c\udfae Use a **Gamepad** to play Xbox Cloud Gaming, GeForce Now & other online games (gamepad tracking only for Xbox/PS5 controller)\n{1340957747347833}\n* \ud83d\udedc **Screen Sharing** tabs + video files in private rooms from headset to headset (no pc needed)\n* \ud83d\udc65 **Join rooms** to collaborate or watch videos together on shared screens.\n* \ud83c\udfde\ufe0f Beautiful **virtual environments** or full mixed-reality experience \n* \ud83d\udcbb **Apps and webpages** can be placed anywhere around you in 3D space. \n{1211559177549801}\n* \ud83d\udda5\ufe0f **Fluid Link**, our (experimental & paid) PC screen streaming add on.\n* \ud83d\uddb1\ufe0f Wireless **Mouse & Keyboard** support for maximum productivity \n* \u2328\ufe0f **International Keyboard Layouts**: Supports multiple languages \n\n\ud83d\udc4b This app is in Early Access and is actively being developed. Please let us know about any bugs you encounter via the in-app help chat or our discord.", "short_description": "Fluid is a browser, video player, gaming hub, smart tv & private hangout room in 1 app. You can have windows all around you or play your favorite game solo or stream it to friends in a personal home theater. It runs entirely on your headset. No PC required."}]}, "developer_name": "Fluid", "developer_privacy_policy_url": "https://www.fluid.so/privacy", "developer_terms_of_service_url": "https://www.fluid.so/tos", "publisher_name": "Fluid", "support_website_url": "https://fluid.so/support", "website_url": "https://fluid.so/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}, {"id": "393222478507326"}, {"id": "1063584910766706"}, {"id": "1055187466124150"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD", "HAND_TRACKING", "OCULUS_TOUCH", "TRACKED_KEYBOARD"], "supported_playe
ENT", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38982607_690148956260496_6818253247735988207_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hQRNi6wX3vYQ7kNvwH7k2Ug&_nc_oc=Adn-ffAyAgU06ZfrWrdU7hKYWNMWVb2-mDcRX2KJRVZ5NL00efDEDvkGtF5IoPUU6u8&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=8&oh=00_AfwSmhM73k6GbZI0-298Mr_MrbM5QlEZS7dY5a_0bzZLHQ&oe=69BD3B75"}]}, "id": "1477213567094066", "locale": "en_US", "screenshots": [{"file_name": "smarttv 1.png", "id": "803281735463330", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/491822034_803281738796663_1192707244839949480_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DikGKIGE7pIQ7kNvwEFNIjC&_nc_oc=Adn2ikMeBYaCxZMB08aNxg54jhCDskqqczRmbc3rEpGXE8ui9kl9ZM2xsoTZbkKrSaM&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=8&oh=00_AfzWJ2xqJ20uW9eK_uO0XM5DUU94A2Pjqc5f08kj592iPA&oe=69BD40D7"}, {"file_name": "Screenshot-1.png", "id": "3715217121957667", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/473392127_3715217125291000_4057790498626262101_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dCGICVqv3EUQ7kNvwE1VzwA&_nc_oc=Adm9_UwaiRQZVPYJeJNI72yku0EaK2jZ77iHkDvsANWODxoji32TUi22WozfXe-DErY&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=8&oh=00_AfwbsnBnB9AYKyLw7CQri8aOwVlQUsN8A2sC4n21bKk-0Q&oe=69BD587B"}, {"file_name": "Screenshot.png", "id": "9347445165351774", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/473392023_9347445175351773_1304065713031920436_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lvTkTCUJq1wQ7kNvwE6GQv2&_nc_oc=AdlrJQIYZFLew11yw33JRuR4byEftoyxiCguiBGZGtJiPFgmGQQH5FC5_6TIHTmJxRo&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=8&oh=00_Afwl9cTZ3G7WtkUwCnwJYgfL9rwy17jVU66k8FVmoKGkZQ&oe=69BD5371"}, {"file_name": "Screenshot.png", "id": "1513467826707408", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/473392168_1513467830040741_2579543078842798870_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dELNQJHJRJcQ7kNvwHh1zH4&_nc_oc=AdnUcCab4qtV9N4kHE_rwye7cV--flSar0_D4ZzBXk8TYCeheDv3E7o5nhII-LhP7MM&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=8&oh=00_Afwttk0VBOxaLcRebxyWPTiJ1C61SbVFIctBE_fLmy9dgQ&oe=69BD5EE1"}, {"file_name": "Screenshot-2.png", "id": "1370761794272177", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/473393961_1370761797605510_8557991468053698635_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=73QMCmJ42fkQ7kNvwHmVYqm&_nc_oc=AdnxOR2sq0bfp-MmDgGO2l-gLAkrgQoqHInI99enDc4DTsfkSmf7Cv5FdtBZHM8aG-w&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=8&oh=00_Afxw5Qzd6v8aC1OCJnEUHE8ch6dlAuSavuyLni8AG4TkDg&oe=69BD2E14"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "16_9.png", "id": "1566334741483998", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499618277_1566334744817331_1936161901977034439_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0IFbdN8RCxsQ7kNvwExakwA&_nc_oc=AdmdIi1CJyCYcdCpdCf6QaoMeiEoHq2Bp_qR6jQpIe44pzoXmkX--snR6Kouu-0DB7w&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=8&oh=00_AfzF7X_34yll7mlKdqEZWKvPrh3JeEMX0kGZ7VdwceOoXQ&oe=69BD4AC8"}, "display_name": "Fluid Browser + Video Player", "keywords": ["video", "streaming", "productivity", "browser"], "long_description": "# Browser - Video Player - Gaming Hub - Smart Tv - Screen Sharing\n\nYou can have **windows** all around you or play your favorite game solo or stream it to friends in a personal home theater. It runs entirely on your headset. **No PC required.**\n\n* \ud83d\udcfa **Smart TV** Perfect for watching streaming services or **local video** files with light fx. **Note**: Netflix is not supported.\n{1531996061225774}\n* \u25b6\ufe0f **Play local video files** saved on your headset, including 3D SBS video. (MKV and MP4 supported, ISO and MVC not supported)\n* \ud83c\udfae Use a **Gamepad** to play Xbox Cloud Gaming, GeForce Now & other online games (gamepad tracking only for Xbox/PS5 controller)\n{1340957747347833}\n* \ud83d\udedc **Screen Sharing** tabs + video files in private rooms from headset to headset (no pc needed)\n* \ud83d\udc65 **Join rooms** to collaborate or watch videos together on shared screens.\n* \ud83c\udfde\ufe0f Beautiful **virtual environments** or full mixed-reality experience \n* \ud83d\udcbb **Apps and webpages** can be placed anywhere around you in 3D space. \n{1211559177549801}\n* \ud83d\udda5\ufe0f **Fluid Link**, our (experimental & paid) PC screen streaming add on.\n* \ud83d\uddb1\ufe0f Wireless **Mouse & Keyboard** support for maximum productivity \n* \u2328\ufe0f **International Keyboard Layouts**: Supports multiple languages \n\n\ud83d\udc4b This app is in Early Access and is actively being developed. Please let us know about any bugs you encounter via the in-app help chat or our discord.", "short_description": "Fluid is a browser, video player, gaming hub, smart tv & private hangout room in 1 app. You can have windows all around you or play your favorite game solo or stream it to friends in a personal home theater. It runs entirely on your headset. No PC required."}]}, "developer_name": "Fluid", "developer_privacy_policy_url": "https://www.fluid.so/privacy", "developer_terms_of_service_url": "https://www.fluid.so/tos", "publisher_name": "Fluid", "support_website_url": "https://fluid.so/support", "website_url": "https://fluid.so/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}, {"id": "393222478507326"}, {"id": "1063584910766706"}, {"id": "1055187466124150"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD", "HAND_TRACKING", "OCULUS_TOUCH", "TRACKED_KEYBOARD"], "supported_playe
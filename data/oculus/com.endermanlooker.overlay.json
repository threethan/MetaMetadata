cdn.com/v/t64.5771-25/39001707_516057927903860_840566423213476145_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bw4sJytc7rMQ7kNvwGNJvg1&_nc_oc=AdlGCiI864LnYqgfZl_4coWz-o8gvn0mAwgN31Cgtka6OKLYWueKcG773RwVbxa_yXg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfxD9C7XtqL4rYrTkre0cumn5pLHlT3VJWEauFaTwxiZng&oe=69B2ABEC"}, {"file_name": "com.oculus.vrshell-20241017-195018 (1).png", "id": "1477315279633967", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75269590_1477315282967300_6902411700634986750_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=guxHVZR0Ve0Q7kNvwHhI1OX&_nc_oc=AdmOjA7DGuxomrAq-9rlC8z-QgzvmfRdxB-STJt1gPcfv2HV0MJPdtwuR2EdYzbovpE&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfwzCaCV8Vkig_ieXiW8vbad30dtoGV4e7RzcXuSfOYgoA&oe=69B2C34E"}, {"file_name": "com.oculus.vrshell-20241017-195018 (2).png", "id": "868657635420370", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38984459_868657638753703_7920335696979320615_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hrBH_hTNakYQ7kNvwHny21e&_nc_oc=Adl5hoxG1a0Mov5jdXztwPufl5W3TUAWv_iFtSDaRtSmgc7nhc0Cr2HllOlbKV_8_j4&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfwZ4rKwcOdKxpY4dOpiHuttaSXJqps1lrNejndvKFjFTw&oe=69B2A5CC"}, {"file_name": "com.oculus.vrshell-20241017-195018 (3).png", "id": "904756681586224", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974764_904756684919557_1870494909465188263_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fiqiEC6HVGkQ7kNvwH4GdUI&_nc_oc=AdkXJ_BJzblMOECdLdJoBOyt8e1rJ73_2tLew_p7pxtJ1l-KimvzXOEl291J6cVgJTk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_Afy5ZgmREtWUGGKHg72VJpyZilG51Haz3Jwk0HgwZTfq6w&oe=69B2C0A0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "com.oculus.vrshell-20241013-112000 (4).png", "id": "1078337093855330", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75361354_1078337097188663_4931571908985595186_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qdqDE9tx3CQQ7kNvwHoqaOM&_nc_oc=AdnFeTDvCH30QvUqaoiqw0K7OmHoZu3HguVizDEDJvgElgiNcLnUzFMh5K2z73a7-kM&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfzitsvhbfM3P0c9bpKUDhNdBtWsN0bydkDDL7wDCpiEyg&oe=69B2C4DD"}, "display_name": "Overlay", "keywords": ["Browser", "Chores", "Youtube", "Chrome", "MR"], "long_description": "# Overlay: Revolutionizing Your Daily Routine with Immersive Web Browsing\nImagine being able to browse your favorite websites, watch videos, and stay entertained while still being productive and tackling your daily chores. Welcome to Overlay, the innovative VR web browser that follows you wherever you go!\n\n## **Access Your Favorite Media Sites**\n\nWith Overlay, you can seamlessly access popular media sites like:\n* YouTube: Watch your favorite videos, music, and live streams in stunning VR\n* Twitch: Catch your favorite gaming streams and interact with the community in real-time\n* Netflix: Enjoy your favorite TV shows and movies in a fully immersive environment\n\nAnd many more!\n\n## **Stay Productive with Passthrough Technology**\n\nUsing passthrough technology, Overlay allows you to see your real-world surroundings while still browsing the web. This means you can:\n* Do laundry while watching your favorite TV show\n* Cook dinner while catching up on the latest YouTube videos\n* Work on your latest project while listening to music or podcasts\n* Take care of your household chores without missing a beat\n{1136935348215479}\n{565087002572255}", "short_description": "A powerful VR media experience that allows you to take your media with you. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://pink-danya-32.tiiny.site/privacypolicy.html", "developer_terms_of_service_url": null, "publisher_name": "Overlay VR", "support_website_url": null, "website_url": "https://pink-danya-32.tiiny.site/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "3626922114
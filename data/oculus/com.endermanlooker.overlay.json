_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eLVHSBR0o04Q7kNvwHE48IT&_nc_oc=AdldUo24aWzYIIL37TrLXSiTgvE9oFFK2aX5-N1v7BEItTNiv5J1TvD4LrTo1thAJpk&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&oh=00_AfsNaqgezU9x6w9FjzBdXdOYp8QzPxHav21XbfSDSYxQVQ&oe=69A1886C"}, {"file_name": "com.oculus.vrshell-20241017-195018 (1).png", "id": "1477315279633967", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/75269590_1477315282967300_6902411700634986750_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l2Fso96ppDYQ7kNvwH5QSPA&_nc_oc=Adma929Xmf9UPtsnSq2QF-fnO7CGnP9h4Hw_4fSfEJBJGoGW7NPh3r1s5R6hqEZDsi0&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&oh=00_AfuOSLBx-G4hO4JwQNb4VtCO9p5T_K2WQvm_l0gm_C6HJA&oe=69A19FCE"}, {"file_name": "com.oculus.vrshell-20241017-195018 (2).png", "id": "868657635420370", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/38984459_868657638753703_7920335696979320615_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C2OlkYlUcv8Q7kNvwEpw2pf&_nc_oc=AdnldF9VPh516_y55uFbLcH6MSvZHfqP6CfpUm821NxK9IguBjSOdJ0FIev76Hf0GLU&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&oh=00_Aft9hbkCiOm_uK20q9bUqeDqiouP9w-g7TgYGFCO6AiNBg&oe=69A1824C"}, {"file_name": "com.oculus.vrshell-20241017-195018 (3).png", "id": "904756681586224", "uri": "https://scontent-hkg1-1.oculuscdn.com/v/t64.5771-25/38974764_904756684919557_1870494909465188263_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5Vt7N4omxPcQ7kNvwFpOyln&_nc_oc=AdkTaGYV9TNYjj3SEiU3FNbILn2-d8bjCxTD43CQAvA5TC4xVk-gExJzFHLswACQKtM&_nc_zt=3&_nc_ht=scontent-hkg1-1.oculuscdn.com&oh=00_Aftmc-VjU3kaHRB68cgkS1QRWk5-Inn1A6VJKFpUcIVBdw&oe=69A19D20"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "com.oculus.vrshell-20241013-112000 (4).png", "id": "1078337093855330", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/75361354_1078337097188663_4931571908985595186_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qzlGCUxMyLYQ7kNvwGtI2pb&_nc_oc=AdkmKpRDB-ztKs1Jzu00BllY-TdA2eyIxHU6NIJpEzgy5ImzbWgJuVIQEZS9jhRkRHg&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&oh=00_Afv07-MPJiDn1rmH1gUjBhYPN2Tvew7QMbPdG0JXp_50hQ&oe=69A1A15D"}, "display_name": "Overlay", "keywords": ["Browser", "Chores", "Youtube", "Chrome", "MR"], "long_description": "# Overlay: Revolutionizing Your Daily Routine with Immersive Web Browsing\nImagine being able to browse your favorite websites, watch videos, and stay entertained while still being productive and tackling your daily chores. Welcome to Overlay, the innovative VR web browser that follows you wherever you go!\n\n## **Access Your Favorite Media Sites**\n\nWith Overlay, you can seamlessly access popular media sites like:\n* YouTube: Watch your favorite videos, music, and live streams in stunning VR\n* Twitch: Catch your favorite gaming streams and interact with the community in real-time\n* Netflix: Enjoy your favorite TV shows and movies in a fully immersive environment\n\nAnd many more!\n\n## **Stay Productive with Passthrough Technology**\n\nUsing passthrough technology, Overlay allows you to see your real-world surroundings while still browsing the web. This means you can:\n* Do laundry while watching your favorite TV show\n* Cook dinner while catching up on the latest YouTube videos\n* Work on your latest project while listening to music or podcasts\n* Take care of your household chores without missing a beat\n{1136935348215479}\n{565087002572255}", "short_description": "A powerful VR media experience that allows you to take your media with you. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://pink-danya-32.tiiny.site/privacypolicy.html", "developer_terms_of_service_url": null, "publisher_name": "Overlay VR", "support_website_url": null, "website_url": "https://pink-danya-32.tiiny.site/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NO
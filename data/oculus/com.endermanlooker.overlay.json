cdn.com/v/t64.5771-25/39001707_516057927903860_840566423213476145_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bw4sJytc7rMQ7kNvwGDSMDo&_nc_oc=AdkdZnWZiBPJOrcsdKqhpe44ytLTRYqp54R6Q3Y0G1wWmokvwTAQazuI_O02VKPEy8o&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfyEdxfNNB_rRbF50MJQPeF29JGhqdUX73urGTtg46W-Ng&oe=69B15A6C"}, {"file_name": "com.oculus.vrshell-20241017-195018 (1).png", "id": "1477315279633967", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75269590_1477315282967300_6902411700634986750_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8jwXKq93UQMQ7kNvwGrz7Pu&_nc_oc=AdkctdW1Lig0eeWhdy88qijW9lbc1YQahtOFpAfcOoZVQRt2lV0NGjtwbKusrl1LklA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfwTbt0ao6bbhQyGUT3VZXIJ6SrU5ncQbbFdd4PNcAnhDQ&oe=69B171CE"}, {"file_name": "com.oculus.vrshell-20241017-195018 (2).png", "id": "868657635420370", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38984459_868657638753703_7920335696979320615_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CUtEEohIgw0Q7kNvwHUvpkC&_nc_oc=AdnlGUrq7L26x8X_WhoSW-_YQ8tXbCMZh0Uh668EMviPPYXNvYbD9KhG_xt9eoJq0-w&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfwSxXYYXLMhH4XXbUn0xKhvbIMlDbkvUpWdHRvAuyPrcQ&oe=69B1544C"}, {"file_name": "com.oculus.vrshell-20241017-195018 (3).png", "id": "904756681586224", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974764_904756684919557_1870494909465188263_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l3LbDgPUSR4Q7kNvwGCL45D&_nc_oc=AdkXu58dIhahCmCO5WpMlvOTteIo86n54LXMUChk3_g7edfs1Wabap36HBnozhijpws&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfyuJ4POrQv8l2kaoyzaTld8xuJeUN-L2nLp1eAGqx5Qng&oe=69B16F20"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "com.oculus.vrshell-20241013-112000 (4).png", "id": "1078337093855330", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75361354_1078337097188663_4931571908985595186_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qdqDE9tx3CQQ7kNvwHYsKgB&_nc_oc=AdmkckBdR6MTvTpiQVSb0HaSdTqJlxCudnl0ZkbOcV0Bhi7rRanlQ7elfIUbs6GKMWs&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_Afx7HPaDUeFrC9ENf1VWqTts-ts3oJVUHIj8DXqOUpaqaQ&oe=69B1735D"}, "display_name": "Overlay", "keywords": ["Browser", "Chores", "Youtube", "Chrome", "MR"], "long_description": "# Overlay: Revolutionizing Your Daily Routine with Immersive Web Browsing\nImagine being able to browse your favorite websites, watch videos, and stay entertained while still being productive and tackling your daily chores. Welcome to Overlay, the innovative VR web browser that follows you wherever you go!\n\n## **Access Your Favorite Media Sites**\n\nWith Overlay, you can seamlessly access popular media sites like:\n* YouTube: Watch your favorite videos, music, and live streams in stunning VR\n* Twitch: Catch your favorite gaming streams and interact with the community in real-time\n* Netflix: Enjoy your favorite TV shows and movies in a fully immersive environment\n\nAnd many more!\n\n## **Stay Productive with Passthrough Technology**\n\nUsing passthrough technology, Overlay allows you to see your real-world surroundings while still browsing the web. This means you can:\n* Do laundry while watching your favorite TV show\n* Cook dinner while catching up on the latest YouTube videos\n* Work on your latest project while listening to music or podcasts\n* Take care of your household chores without missing a beat\n{1136935348215479}\n{565087002572255}", "short_description": "A powerful VR media experience that allows you to take your media with you. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://pink-danya-32.tiiny.site/privacypolicy.html", "developer_terms_of_service_url": null, "publisher_name": "Overlay VR", "support_website_url": null, "website_url": "https://pink-danya-32.tiiny.site/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "3626922114
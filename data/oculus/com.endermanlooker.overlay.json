a0a&_nc_ohc=F6U0KTaC0iAQ7kNvwH_QTxM&_nc_oc=AdqLmVHS3q4kx4t5H5Usm-i8U30IUC8KKFY78xoQW2vK4oZvaSTCSXc2RwjJGOounH0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI1Ie2LOKJBzOI_be44FBn0rIMSFgievbtT2EPjLDC7sw&oe=6AB93EAC"}, {"file_name": "com.oculus.vrshell-20241017-195018 (1).png", "id": "1477315279633967", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75269590_1477315282967300_6902411700634986750_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o18kEdAMruEQ7kNvwHaRf6T&_nc_oc=AdpW2F555jJa-lie36DZ7TkRvw8p-_vu1LHWnfYcGUa3dp6lRm4moDCLFgMdW-j_6ys&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKL2UEaf0WzQuQ5leXl1RTnw5_5QObvUalsN2IF7r8cng&oe=6AB91DCE"}, {"file_name": "com.oculus.vrshell-20241017-195018 (2).png", "id": "868657635420370", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38984459_868657638753703_7920335696979320615_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3XVjDBpItBEQ7kNvwEY-vcx&_nc_oc=AdoZTK2ln1FidUFZPlWKUgQQ-GEQGA6XkG-6Axytq41alcfxm6fim0vZdwLA2tygHg4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLP9lcF7U0cJhPcJ8qGQYbTBnJLGbfGcn7cp_33R6VsJw&oe=6AB9388C"}, {"file_name": "com.oculus.vrshell-20241017-195018 (3).png", "id": "904756681586224", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974764_904756684919557_1870494909465188263_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-H5iqj97XnoQ7kNvwEAChHS&_nc_oc=AdroO6V46ANCCGdTxGLFHMTv3Q9ENQk4tkyPpwvtZVbH_2UD-v361bHIUrQfZbRRxLI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLvxGffey-i8uJmOd_RdtoatdWU6F4nPML0kApzzx4gbQ&oe=6AB91B20"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "com.oculus.vrshell-20241013-112000 (4).png", "id": "1078337093855330", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75361354_1078337097188663_4931571908985595186_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=flAb_eZ78kEQ7kNvwEW31vx&_nc_oc=Ados-SUajbsPO89AZUlgwJeglQqEFOMxUduLAnt49BB8ewsBTCU5fPv0XGV0u76OVwE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLyV8bRbdLyxUAfgJPjcpTZOIVBDFg1fZGMDl0Fc3_Fhg&oe=6AB91F5D"}, "display_name": "Overlay", "keywords": ["Browser", "Chores", "Youtube", "Chrome", "MR"], "long_description": "# Overlay: Revolutionizing Your Daily Routine with Immersive Web Browsing\nImagine being able to browse your favorite websites, watch videos, and stay entertained while still being productive and tackling your daily chores. Welcome to Overlay, the innovative VR web browser that follows you wherever you go!\n\n## **Access Your Favorite Media Sites**\n\nWith Overlay, you can seamlessly access popular media sites like:\n* YouTube: Watch your favorite videos, music, and live streams in stunning VR\n* Twitch: Catch your favorite gaming streams and interact with the community in real-time\n* Netflix: Enjoy your favorite TV shows and movies in a fully immersive environment\n\nAnd many more!\n\n## **Stay Productive with Passthrough Technology**\n\nUsing passthrough technology, Overlay allows you to see your real-world surroundings while still browsing the web. This means you can:\n* Do laundry while watching your favorite TV show\n* Cook dinner while catching up on the latest YouTube videos\n* Work on your latest project while listening to music or podcasts\n* Take care of your household chores without missing a beat\n{1136935348215479}\n{565087002572255}", "short_description": "A powerful VR media experience that allows you to take your media with you. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://pink-danya-32.tiiny.site/privacypolicy.html", "developer_terms_of_service_url": null, "publisher_name": "Overlay VR", "support_website_url": null, "website_url": "https://pink-danya-32.tiiny.site/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}],
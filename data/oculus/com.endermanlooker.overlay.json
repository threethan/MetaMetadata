cdn.com/v/t64.5771-25/39001707_516057927903860_840566423213476145_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TZzQ-k7nJ9gQ7kNvwG4ieXY&_nc_oc=AdkV5Ca_edCGOKI5Ibm9Totvi98pRDYRsmX-nbzaa0G5mbvqn6x7hlKqgOM6Nza0TL8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfyySjvvrIDwQwVszZpLMi8UimZIwxvmm5p_VKxvX592Gw&oe=69AC146C"}, {"file_name": "com.oculus.vrshell-20241017-195018 (1).png", "id": "1477315279633967", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75269590_1477315282967300_6902411700634986750_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=le1Gh6UPDywQ7kNvwElqjke&_nc_oc=AdlpTIpj2vRzqByHh-NVmtyGQOVs4jmlDeFkN4NITG8GB0eEuyCj2Jz2Vb1JGe5R7dg&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfwOzaZcCAvNT_9eKXLGsBoVjRzo3MoD1ZiKhVojob-GEw&oe=69AC2BCE"}, {"file_name": "com.oculus.vrshell-20241017-195018 (2).png", "id": "868657635420370", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38984459_868657638753703_7920335696979320615_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iOilQd6An4QQ7kNvwHf7jI7&_nc_oc=AdkQq68StaBx2W-2B07q0DRZ6m_iA-yGLXzuQq1DvK_LTStkt8Uqq73gVrLkHk9UC1Y&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afy52jfLj2_cdnjW9diVeD55T3LR4SBbGUnuRTUd37idZw&oe=69AC0E4C"}, {"file_name": "com.oculus.vrshell-20241017-195018 (3).png", "id": "904756681586224", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974764_904756684919557_1870494909465188263_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HsH7ZgzXsbEQ7kNvwGyHjBu&_nc_oc=AdmPym9e51hgRGjObvAcw8A0JZQ0vxPXIepK_h1ewlxUmbcXQgJ3Yt4BOWlF5nUONT4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfwkKoGASMsLXolIj-yxFGr8ny3g87AT0HSIemxGXU0z7Q&oe=69AC2920"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "com.oculus.vrshell-20241013-112000 (4).png", "id": "1078337093855330", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75361354_1078337097188663_4931571908985595186_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WkFdUH05TtYQ7kNvwGM9FHj&_nc_oc=AdkxzrkEk-KjoeYWPJ4WAUANeLY2ZR8CDv190aRyWPMqdrCSNRlGaNLh0130FaF-cpM&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfyhonNzqD54mU4NnOrEYKlLSJYrO8OWSo-nkqMEbFAYhA&oe=69AC2D5D"}, "display_name": "Overlay", "keywords": ["Browser", "Chores", "Youtube", "Chrome", "MR"], "long_description": "# Overlay: Revolutionizing Your Daily Routine with Immersive Web Browsing\nImagine being able to browse your favorite websites, watch videos, and stay entertained while still being productive and tackling your daily chores. Welcome to Overlay, the innovative VR web browser that follows you wherever you go!\n\n## **Access Your Favorite Media Sites**\n\nWith Overlay, you can seamlessly access popular media sites like:\n* YouTube: Watch your favorite videos, music, and live streams in stunning VR\n* Twitch: Catch your favorite gaming streams and interact with the community in real-time\n* Netflix: Enjoy your favorite TV shows and movies in a fully immersive environment\n\nAnd many more!\n\n## **Stay Productive with Passthrough Technology**\n\nUsing passthrough technology, Overlay allows you to see your real-world surroundings while still browsing the web. This means you can:\n* Do laundry while watching your favorite TV show\n* Cook dinner while catching up on the latest YouTube videos\n* Work on your latest project while listening to music or podcasts\n* Take care of your household chores without missing a beat\n{1136935348215479}\n{565087002572255}", "short_description": "A powerful VR media experience that allows you to take your media with you. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://pink-danya-32.tiiny.site/privacypolicy.html", "developer_terms_of_service_url": null, "publisher_name": "Overlay VR", "support_website_url": null, "website_url": "https://pink-danya-32.tiiny.site/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "3626922114
&_nc_ss=7f30f&oh=00_AQUthY9iOgxPd7XOu0ztFsLo-GrB_ie0daiLrZhd_--u1w&oe=6B0F04E0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "com.oculus.vrshell-20241013-112000 (4).png", "id": "1078337093855330", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75361354_1078337097188663_4931571908985595186_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eo4isCrZq5cQ7kNvwE9ak22&_nc_oc=Adr4YHd6ebisQ-ZS6ksqKWJM6mv7GN4rD3l0CsC0HOZXFIL7jzZzlfQp53gJGeV5Pa8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWYP8cmiRggBxJLjlZHP_Z0TldlHT5g4WvsOU9apylm5w&oe=6B0F091D"}, "display_name": "Overlay", "keywords": ["Browser", "Chores", "Youtube", "Chrome", "MR"], "long_description": "# Overlay: Revolutionizing Your Daily Routine with Immersive Web Browsing\nImagine being able to browse your favorite websites, watch videos, and stay entertained while still being productive and tackling your daily chores. Welcome to Overlay, the innovative VR web browser that follows you wherever you go!\n\n## **Access Your Favorite Media Sites**\n\nWith Overlay, you can seamlessly access popular media sites like:\n* YouTube: Watch your favorite videos, music, and live streams in stunning VR\n* Twitch: Catch your favorite gaming streams and interact with the community in real-time\n* Netflix: Enjoy your favorite TV shows and movies in a fully immersive environment\n\nAnd many more!\n\n## **Stay Productive with Passthrough Technology**\n\nUsing passthrough technology, Overlay allows you to see your real-world surroundings while still browsing the web. This means you can:\n* Do laundry while watching your favorite TV show\n* Cook dinner while catching up on the latest YouTube videos\n* Work on your latest project while listening to music or podcasts\n* Take care of your household chores without missing a beat\n{1136935348215479}\n{565087002572255}", "short_description": "A powerful VR media experience that allows you to take your media with you. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://pink-danya-32.tiiny.site/privacypolicy.html", "developer_terms_of_service_url": null, "publisher_name": "Overlay VR", "support_website_url": null, "website_url": "https://pink-danya-32.tiiny.site/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8531928623542608"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974764_524566133520506_8409314649205711209_n.png?stp=dst-png_s360x360&_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uTOdws20Mg0Q7kNvwG50FJ3&_nc_oc=Adp0x9fNE1_L5dz_Wde9WZ4vxJ7EWn5wzOh6NdWQaaDU88EV6AHQm_RTnnIjXgsWIu0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQUpxu6UsCx5T4KAkM31RV11aMvUZeuV44dK6R2dF-aRNw&oe=6B0EFB44"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Overlay", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_name": "Media", "id": "434961926215971"}], "release_date": 1729609200, "lastRevision": {"nodes": [{"id": "8463417870393684", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "8463417847060353", "is_first_party": false, "enables_in_app_ads": false, "is_c
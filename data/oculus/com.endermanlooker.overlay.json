cdn.com/v/t64.5771-25/39001707_516057927903860_840566423213476145_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JvgwtL0B54wQ7kNvwH_CWtq&_nc_oc=AdlCl1Cf8mYWrzCGxL4V37mFyoAXlcuTQpCG_XKa44JIwzgoWZ3aQ49PMFtTh42SqZ8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afyyyx6GUDVD4So-4vsk7Fmt-_6TTwwB8BO80VKkL2LFQw&oe=69AD65EC"}, {"file_name": "com.oculus.vrshell-20241017-195018 (1).png", "id": "1477315279633967", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75269590_1477315282967300_6902411700634986750_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=le1Gh6UPDywQ7kNvwHfhd3a&_nc_oc=AdkOSimecoJgMqhCkK2gGPWymRKKy0L_2yyn89ipeiaWdTsg1yC9OeFibX3qPxmRr8Q&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfxS6cCx26-mEWRGkdGokEWaduNpdB-PmBPIOPFC79c9FQ&oe=69AD7D4E"}, {"file_name": "com.oculus.vrshell-20241017-195018 (2).png", "id": "868657635420370", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38984459_868657638753703_7920335696979320615_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iOilQd6An4QQ7kNvwE6TN9w&_nc_oc=AdneqvlHz7lIM6nJSfstlGk7Rd2IkiYlZfT4b94v1UUSBfv7TDyOnINR8nM_dCYDulk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfzZuFTJLl0KBMlvY2jH-H9f_obohKGfAcQEDNfF5Lcuhw&oe=69AD5FCC"}, {"file_name": "com.oculus.vrshell-20241017-195018 (3).png", "id": "904756681586224", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974764_904756684919557_1870494909465188263_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HsH7ZgzXsbEQ7kNvwEQto_X&_nc_oc=AdkQc2cJ3CEjFW_ysqAOp5Nm2K8KC0cQwWUIbMMByOJK1WuFZs8rmt_F3rzTQUhEgog&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afy7yIGb9S0GTzvysN6zpzbTaKYK8ADytftkjeMsP7WAMQ&oe=69AD7AA0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "com.oculus.vrshell-20241013-112000 (4).png", "id": "1078337093855330", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75361354_1078337097188663_4931571908985595186_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WkFdUH05TtYQ7kNvwED2bKu&_nc_oc=Adnz4ekK8VQVxoCVnlCyfyAnS8mnyLKHuOTwfBPvyEXLj6SH5Z7YJw55Hh3ODiJH-fc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afz7HOo_r18lZ9z26gmjPefKV-sRCexmixS-SzOJpHS0yQ&oe=69AD7EDD"}, "display_name": "Overlay", "keywords": ["Browser", "Chores", "Youtube", "Chrome", "MR"], "long_description": "# Overlay: Revolutionizing Your Daily Routine with Immersive Web Browsing\nImagine being able to browse your favorite websites, watch videos, and stay entertained while still being productive and tackling your daily chores. Welcome to Overlay, the innovative VR web browser that follows you wherever you go!\n\n## **Access Your Favorite Media Sites**\n\nWith Overlay, you can seamlessly access popular media sites like:\n* YouTube: Watch your favorite videos, music, and live streams in stunning VR\n* Twitch: Catch your favorite gaming streams and interact with the community in real-time\n* Netflix: Enjoy your favorite TV shows and movies in a fully immersive environment\n\nAnd many more!\n\n## **Stay Productive with Passthrough Technology**\n\nUsing passthrough technology, Overlay allows you to see your real-world surroundings while still browsing the web. This means you can:\n* Do laundry while watching your favorite TV show\n* Cook dinner while catching up on the latest YouTube videos\n* Work on your latest project while listening to music or podcasts\n* Take care of your household chores without missing a beat\n{1136935348215479}\n{565087002572255}", "short_description": "A powerful VR media experience that allows you to take your media with you. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://pink-danya-32.tiiny.site/privacypolicy.html", "developer_terms_of_service_url": null, "publisher_name": "Overlay VR", "support_website_url": null, "website_url": "https://pink-danya-32.tiiny.site/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "3626922114
id": "1477315279633967", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75269590_1477315282967300_6902411700634986750_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YIUvUj62BvgQ7kNvwHqePh6&_nc_oc=AdlSsHrJABsPeQgMLVjAcBkn-uw64ai-Jy7XBgR8pZZH-T6hkp4rdgaQjf_JOSHnKDQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfvRuO7RKeOqOUbiRDiEwjTVCbQmgjyZFR-wNJPMtH4WMQ&oe=699DAB4E"}, {"file_name": "com.oculus.vrshell-20241017-195018 (2).png", "id": "868657635420370", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38984459_868657638753703_7920335696979320615_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L_SaVVH68acQ7kNvwFeOyzY&_nc_oc=Adm_Pb5wxMCTruaDvAkJmNIpYr3l2c41rGnRPstFF4Je8XyjdScT5ExG5d7HGktSfzI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfvXke22ZIZgFVAZWYZdnFv7G4TQ3TbPthVWcxQamv_LPw&oe=699D8DCC"}, {"file_name": "com.oculus.vrshell-20241017-195018 (3).png", "id": "904756681586224", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974764_904756684919557_1870494909465188263_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BQBR8ucyvVIQ7kNvwFVlt5O&_nc_oc=AdlEib--pqt8lTWVdHfPEYhSnkwiPhg12Zxw3Ge85mStuA9Y3fs3QUhNx-riT4EBPwA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AftqdOa6q9wY-nttTvcsR-8Hp1-PUkEouoj-ruzQezrIzA&oe=699DA8A0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "com.oculus.vrshell-20241013-112000 (4).png", "id": "1078337093855330", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75361354_1078337097188663_4931571908985595186_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5wBCR2yNcsAQ7kNvwF2tERn&_nc_oc=AdnX7dcRV2kLPrvU6ZMVfzUwCFMrtcHvRK4vAc9acoDQkrgEdPdzhvT59XZSoArAPlk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Aftreap359xmYgGf7sth9C6nTISveeokNNXGyEcsNhto_A&oe=699DACDD"}, "display_name": "Overlay", "keywords": ["Browser", "Chores", "Youtube", "Chrome", "MR"], "long_description": "# Overlay: Revolutionizing Your Daily Routine with Immersive Web Browsing\nImagine being able to browse your favorite websites, watch videos, and stay entertained while still being productive and tackling your daily chores. Welcome to Overlay, the innovative VR web browser that follows you wherever you go!\n\n## **Access Your Favorite Media Sites**\n\nWith Overlay, you can seamlessly access popular media sites like:\n* YouTube: Watch your favorite videos, music, and live streams in stunning VR\n* Twitch: Catch your favorite gaming streams and interact with the community in real-time\n* Netflix: Enjoy your favorite TV shows and movies in a fully immersive environment\n\nAnd many more!\n\n## **Stay Productive with Passthrough Technology**\n\nUsing passthrough technology, Overlay allows you to see your real-world surroundings while still browsing the web. This means you can:\n* Do laundry while watching your favorite TV show\n* Cook dinner while catching up on the latest YouTube videos\n* Work on your latest project while listening to music or podcasts\n* Take care of your household chores without missing a beat\n{1136935348215479}\n{565087002572255}", "short_description": "A powerful VR media experience that allows you to take your media with you. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://pink-danya-32.tiiny.site/privacypolicy.html", "developer_terms_of_service_url": null, "publisher_name": "Overlay VR", "support_website_url": null, "website_url": "https://pink-danya-32.tiiny.site/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["SI
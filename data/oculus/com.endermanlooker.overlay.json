cdn.com/v/t64.5771-25/39001707_516057927903860_840566423213476145_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MLwoA7_YkrcQ7kNvwFcJcXA&_nc_oc=Adm6Bl9RJPyrmu8_INr1gFsbuHB8RKWMggX2hpo6pIqp2MuWCjxjBMQNKxx1_kCuS-I&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afss8g9RdwMeI9-aTsrbeL7_UO308kP_lffZ09pxyfOwRQ&oe=69A81FEC"}, {"file_name": "com.oculus.vrshell-20241017-195018 (1).png", "id": "1477315279633967", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75269590_1477315282967300_6902411700634986750_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J2KgM4mnzJsQ7kNvwGinJbr&_nc_oc=Adlzcftigx6GmzG7k4FCBtnenUP-JB7oSvwaRXMBoqoKenJ6qvj8q8f3JrgoaUWOwCE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfvUAJrdSl-CIaxXK2lnFEbzNep6jVk6O_syTGYvdjTwyA&oe=69A8374E"}, {"file_name": "com.oculus.vrshell-20241017-195018 (2).png", "id": "868657635420370", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38984459_868657638753703_7920335696979320615_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7Ja-L66xThsQ7kNvwG3tUol&_nc_oc=AdkVn3EDEUDPHVZNguFWr8FjgAvrJq-4745aOjlcOZvPjM5nQ7eiGo7Xv0oQZgWNX5E&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfvD4Y6TfhZsMHxjH21DQ-alP4-PxluB_10u9PeHO0fzrg&oe=69A819CC"}, {"file_name": "com.oculus.vrshell-20241017-195018 (3).png", "id": "904756681586224", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974764_904756684919557_1870494909465188263_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rIof8pyK6t4Q7kNvwFEr4Uw&_nc_oc=Adktw7HX0SinGzaoxvwl_7xRUIOWHuAki006uaIhkgl964VIal3Hu3rSrt6bUdak2oE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afv6RlIFHn52NwS3ffL3fk9uONXdr8_0ajuwBpLIb8EPpw&oe=69A834A0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "com.oculus.vrshell-20241013-112000 (4).png", "id": "1078337093855330", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75361354_1078337097188663_4931571908985595186_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dTC9cthHopAQ7kNvwFF6Dls&_nc_oc=Adm2wVjZY30SW2MtyJao6wNctGc1RwUgmWj8dMIrg62O3VScUkNHAqtXcTGjD4owGYk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Aftuh2XL9GncIv8NKSVNjRduYOBi8lmJESWOgPIYGoHIsg&oe=69A838DD"}, "display_name": "Overlay", "keywords": ["Browser", "Chores", "Youtube", "Chrome", "MR"], "long_description": "# Overlay: Revolutionizing Your Daily Routine with Immersive Web Browsing\nImagine being able to browse your favorite websites, watch videos, and stay entertained while still being productive and tackling your daily chores. Welcome to Overlay, the innovative VR web browser that follows you wherever you go!\n\n## **Access Your Favorite Media Sites**\n\nWith Overlay, you can seamlessly access popular media sites like:\n* YouTube: Watch your favorite videos, music, and live streams in stunning VR\n* Twitch: Catch your favorite gaming streams and interact with the community in real-time\n* Netflix: Enjoy your favorite TV shows and movies in a fully immersive environment\n\nAnd many more!\n\n## **Stay Productive with Passthrough Technology**\n\nUsing passthrough technology, Overlay allows you to see your real-world surroundings while still browsing the web. This means you can:\n* Do laundry while watching your favorite TV show\n* Cook dinner while catching up on the latest YouTube videos\n* Work on your latest project while listening to music or podcasts\n* Take care of your household chores without missing a beat\n{1136935348215479}\n{565087002572255}", "short_description": "A powerful VR media experience that allows you to take your media with you. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://pink-danya-32.tiiny.site/privacypolicy.html", "developer_terms_of_service_url": null, "publisher_name": "Overlay VR", "support_website_url": null, "website_url": "https://pink-danya-32.tiiny.site/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "3626922114
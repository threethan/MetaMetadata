cdn.com/v/t64.5771-25/39001707_516057927903860_840566423213476145_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7thP4MaCAcUQ7kNvwH5KUug&_nc_oc=AdpSc7DGVWZJye2KLJGaEvtto9NluWxENMOxmiGsn1ykyl1KGZV6fHwItGftTCqm1CI&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=8&oh=00_AfwEz6157dRlVjtLsrjaouqlrNz3Jz0TZ_GyqYj2oKxN4w&oe=69C12C6C"}, {"file_name": "com.oculus.vrshell-20241017-195018 (1).png", "id": "1477315279633967", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/75269590_1477315282967300_6902411700634986750_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bxqm8tKAqKkQ7kNvwHjrbwZ&_nc_oc=Adrcn2c-JkpY912TKRg2LxeEhm5T8R5mkui9irJChdBP7ZnzoatwncBdGG6Rb9BSp0U&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_AfxkmOPu8mXCrlp4lWZWYFIL5QVa3NHt4_at3GxiisU6LA&oe=69C143CE"}, {"file_name": "com.oculus.vrshell-20241017-195018 (2).png", "id": "868657635420370", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38984459_868657638753703_7920335696979320615_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eI2H2OyAcJ8Q7kNvwH4Yewm&_nc_oc=AdrXxm4DisDvIOA-tbL_W3tTk1IQP87lawBk4lF1pwvEbHv9nig20aboQmNvTmpQlBc&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=8&oh=00_Afwl12cO0ur5QBvRU2mrSvvTX9SwNagCcv_moV3fhKJZXg&oe=69C1264C"}, {"file_name": "com.oculus.vrshell-20241017-195018 (3).png", "id": "904756681586224", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974764_904756684919557_1870494909465188263_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ftRRc-9Y7bAQ7kNvwFlawjs&_nc_oc=AdpHCaZIQ_knOITkDsTYDtt8BfgCQ1R-0rm9UdppoGhLjUD2weGvkQYCltkMPtjs9lQ&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=8&oh=00_Afxgct_Py1qIw5jV9anNxNppIqChsXz2Yf9x99dqB_h6LA&oe=69C14120"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "com.oculus.vrshell-20241013-112000 (4).png", "id": "1078337093855330", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/75361354_1078337097188663_4931571908985595186_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=INr3yXfuRloQ7kNvwHzRFc_&_nc_oc=Adrkj9ULXC1fyoolrgBJr4Jg74URVpOs5oovVDShfRi8-XreQVf_XvUtV17zrCNPkCo&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_AfzvpoDppUlILawSuGDwJc-ZL00eDmE9fZ1pi1FvuXq-DA&oe=69C1455D"}, "display_name": "Overlay", "keywords": ["Browser", "Chores", "Youtube", "Chrome", "MR"], "long_description": "# Overlay: Revolutionizing Your Daily Routine with Immersive Web Browsing\nImagine being able to browse your favorite websites, watch videos, and stay entertained while still being productive and tackling your daily chores. Welcome to Overlay, the innovative VR web browser that follows you wherever you go!\n\n## **Access Your Favorite Media Sites**\n\nWith Overlay, you can seamlessly access popular media sites like:\n* YouTube: Watch your favorite videos, music, and live streams in stunning VR\n* Twitch: Catch your favorite gaming streams and interact with the community in real-time\n* Netflix: Enjoy your favorite TV shows and movies in a fully immersive environment\n\nAnd many more!\n\n## **Stay Productive with Passthrough Technology**\n\nUsing passthrough technology, Overlay allows you to see your real-world surroundings while still browsing the web. This means you can:\n* Do laundry while watching your favorite TV show\n* Cook dinner while catching up on the latest YouTube videos\n* Work on your latest project while listening to music or podcasts\n* Take care of your household chores without missing a beat\n{1136935348215479}\n{565087002572255}", "short_description": "A powerful VR media experience that allows you to take your media with you. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://pink-danya-32.tiiny.site/privacypolicy.html", "developer_terms_of_service_url": null, "publisher_name": "Overlay VR", "support_website_url": null, "website_url": "https://pink-danya-32.tiiny.site/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "3626922114
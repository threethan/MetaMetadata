a0a&_nc_ohc=YHaCNK6YKAUQ7kNvwH4ujiF&_nc_oc=Adql-TBjqmYYxh1crrfHRDQ-0Ser6F6j7ues5Ptj6Gu8upbcSSUyHnpFeAJy30FcDvo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2ENh85PRA678yjNnzVsOf5TnzyG_zbTV3f4AaTWDJcUA&oe=69D8E76C"}, {"file_name": "com.oculus.vrshell-20241017-195018 (1).png", "id": "1477315279633967", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75269590_1477315282967300_6902411700634986750_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lSz5bzav9-8Q7kNvwGmIXTF&_nc_oc=Ado3yX06jsv61R9MZ2woKbvBgRn6yCYcoGV8jrxhyDCcpbHx7s40XkmxNFmDfk75iKE&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2tir4noLdHvN0LZEo9QMohxSUNaGAU9NtNfX7ZHNFKtw&oe=69D8FECE"}, {"file_name": "com.oculus.vrshell-20241017-195018 (2).png", "id": "868657635420370", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38984459_868657638753703_7920335696979320615_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2qsrdZ-ayZcQ7kNvwF3SZ5S&_nc_oc=AdqgksvMbnPjKO7oLAmp4wfAPmaKvgyjwQQSyK28u6kU5IT-SRkBYpfi_6w1O9rNKiQ&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1Ju9oltrFfTBWpPKfWehbYVXD3jFxzgJx7M-k6v7B6lw&oe=69D8E14C"}, {"file_name": "com.oculus.vrshell-20241017-195018 (3).png", "id": "904756681586224", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974764_904756684919557_1870494909465188263_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j4oNxf8ZCG4Q7kNvwFxQrim&_nc_oc=AdqbY88kjjmmatWfW851on3DTLNV6zlupzLeL1ErY5RunxbXNDHumhDCmkag3iiHVsE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1Wu0mZ5DYF_9KsyzauhKK9HfHfWzlyzMoNPBY9097HDw&oe=69D8FC20"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "com.oculus.vrshell-20241013-112000 (4).png", "id": "1078337093855330", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75361354_1078337097188663_4931571908985595186_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9nVwWJApuvUQ7kNvwFQ-WDQ&_nc_oc=Adpo0xtUTDKozqFXflbRp6CGuC0QIxst3rj9SWdEyEL9IshtHHEPmz4DgZrBYZwORFU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0fhX3pU18cdXXX6g_svabGf5E0XEezgHr5zGm6WsPmZg&oe=69D9005D"}, "display_name": "Overlay", "keywords": ["Browser", "Chores", "Youtube", "Chrome", "MR"], "long_description": "# Overlay: Revolutionizing Your Daily Routine with Immersive Web Browsing\nImagine being able to browse your favorite websites, watch videos, and stay entertained while still being productive and tackling your daily chores. Welcome to Overlay, the innovative VR web browser that follows you wherever you go!\n\n## **Access Your Favorite Media Sites**\n\nWith Overlay, you can seamlessly access popular media sites like:\n* YouTube: Watch your favorite videos, music, and live streams in stunning VR\n* Twitch: Catch your favorite gaming streams and interact with the community in real-time\n* Netflix: Enjoy your favorite TV shows and movies in a fully immersive environment\n\nAnd many more!\n\n## **Stay Productive with Passthrough Technology**\n\nUsing passthrough technology, Overlay allows you to see your real-world surroundings while still browsing the web. This means you can:\n* Do laundry while watching your favorite TV show\n* Cook dinner while catching up on the latest YouTube videos\n* Work on your latest project while listening to music or podcasts\n* Take care of your household chores without missing a beat\n{1136935348215479}\n{565087002572255}", "short_description": "A powerful VR media experience that allows you to take your media with you. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://pink-danya-32.tiiny.site/privacypolicy.html", "developer_terms_of_service_url": null, "publisher_name": "Overlay VR", "support_website_url": null, "website_url": "https://pink-danya-32.tiiny.site/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}],
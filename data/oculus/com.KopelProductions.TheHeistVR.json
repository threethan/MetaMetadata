-paced arcade shooter for the Oculus Quest. Play as an experienced thief as you infiltrate 3 different locations and escape with the cash. You must defend yourself from the incoming police as you wait for your bomb to explode and force your way through the armored doors.", "short_description": "The Heist VR is a fun, fast-paced arcade shooter for the Oculus Quest. Play as an experienced thief as you infiltrate 3 different locations and escape with the cash. You must defend yourself from the incoming police as you wait for your bomb to explode and force your way through the armored doors."}]}, "developer_name": "WonderSense Games", "developer_privacy_policy_url": "https://docs.google.com/document/d/1uI4U2i9qEdBFLGpiB0ddKHIksfOFCBpb17v7OP9o4fs/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "WonderSense Games", "support_website_url": null, "website_url": "https://wondersensegames.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE", "ACTION", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1050510485883116"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-hkg4-2.oculuscdn.com/v/t64.5771-25/38984471_382142740431553_1962716013816951155_n.png?stp=dst-png_s360x360&_nc_cat=1&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JCmJBHYs2-YQ7kNvwFZzloR&_nc_oc=Adq0hBRUZeTPcdY_HnLlMoBbsai2s9MavlxFO4626-isyRjkK5o4DszQSxD1bsGITnY&_nc_zt=3&_nc_ht=scon
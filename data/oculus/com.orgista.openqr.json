.com/v/t64.5771-25/499296027_2191619095068492_5698662351279385098_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Dgbn0FrU2PUQ7kNvwHZDxOY&_nc_oc=Adq37zUmVq1OZH1gPFnT5WieHTF8lXlMa5P4jHLzBOUw8R0gXR3Ul3tjpDaxw6iuCYU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS1XDCEXKs64Or9PO5zQU0IFaAVUdSaDH9wjuWQke1TSA&oe=6AEB48A7"}, {"file_name": "openqr_metaquest_store_02_scanning.png", "id": "1631760518499501", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499308063_1631760521832834_262161603826586622_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AEQbFt1oAkwQ7kNvwEw7w26&_nc_oc=Adqcyjh3jCVa-gedKspcWFOo2_CEdi934qJy83kv77crOQ4PZ0ClPYPFR69IoO0ihzI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQToL_yphKc8JiseUFDJt1P6Ii-DrP0DbaN2DAoiqRbBdA&oe=6AEB3FF4"}, {"file_name": "openqr_metaquest_store_01_ready.png", "id": "3013682692357413", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499307352_3013682695690746_8019523881704477708_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=86ThJ3-QU50Q7kNvwGthmTb&_nc_oc=AdogTLAu3e2GfThYFEYSZkYo3nhTn0zWQUhO8GGGrcTmMsX6rREUVZ_w9jx3NJIWnPs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR3wc3U3MyiT3v-YN31IW3po5WJEWP-3erElAF8C_s2wQ&oe=6AEB3515"}, {"file_name": "openqr_metaquest_store_04_opening_link.png", "id": "1252726940384790", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499310819_1252726943718123_8999351956007794998_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8aDRtRVQMYIQ7kNvwHD18dS&_nc_oc=Adqaz68Lc3x3jodEq5uJJ9OFyTN9Tb-gpznWRoD0D0rEMUlqv4F7Y5NOF4saCR7Vi-Q&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSROve79GI6ZA83dCQd9RlS7fUGWv4Te2MbnIvRhQmi8w&oe=6AEB483C"}, {"file_name": "openqr_metaquest_store_03_camera_preview.png", "id": "1800116557897338", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499299093_1800116561230671_3349816583068448143_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LVapjG7CvAcQ7kNvwGJPo8-&_nc_oc=AdpGS9R6GrDao3bDlxpr40ncavnULrJxX8cKMHBplahy2a7lckwDVR54MdgFRZthFmQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQphr6rhT1UJam6K3Ec_DmI7dBYvTvk3uTuwPmfqRdRkw&oe=6AEB3AAA"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "OpenQR", "keywords": ["scanner", "qr", "camera"], "long_description": "Typing a long web address with Quest controllers is slow. With OpenQR you look at the QR code instead: it reads the code through passthrough and opens it.\n\n- **Websites** open in your browser.\n- **YouTube links** play in YouTube VR, 360\u00b0 videos included.\n- **Meta Horizon Store links** go straight to the Store page.\n- **3D tours** like Matterport open in the browser, one tap from VR.\n\nWhen you close the app OpenQR opened, you're back at the scanner for the next code.\n\nFor developers: put your app's deep link (myapp://\u2026) in a QR code and OpenQR opens your app.\n\n### Your privacy\nOpenQR has no internet access of its own and no account, tracking or analytics. It reads camera frames on the headset to find the code, then throws them away. Nothing is saved or sent.\n\n### What it won't open\nOpenQR only opens web and app links. It blocks scripts, files and app-launch tricks. For Wi-Fi details, contacts or plain text, it shows what it found and doesn't open it.", "short_description": "QR code scanner"}]}, "developer_name": null, "developer_privacy_policy_url": "https://orgista.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Orgista", "support_website_url": "https://orgista.com/support", "website_url": "https://orgista.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "393222478507326"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_gra
.com/v/t64.5771-25/499296027_2191619095068492_5698662351279385098_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3dgT0bBA_PUQ7kNvwF7E8lK&_nc_oc=Adr3L7AUXU4LAXq0-XxDAFx-fTAtJv0UDgyLRIy4yGy2UhLSDgPOwhKPQmNcnfAmuuk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOy95t4rzufmAjsG_IgNTFlESanPzMGaf_cJ1Om0PTcuw&oe=6ADF6B27"}, {"file_name": "openqr_metaquest_store_02_scanning.png", "id": "1631760518499501", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499308063_1631760521832834_262161603826586622_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GJuQypGuHtIQ7kNvwG-1IOK&_nc_oc=Adr9BtyGxyWTaHwxCU51FcjLarJZJcTZ5mV7FOlSmS652NQEjtC3fi0Zgi3AnDhth8I&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOGLLs2ro28B8jgoEoXrpFgFHj0Jl1l0F2szZTM-mG8IA&oe=6ADF6274"}, {"file_name": "openqr_metaquest_store_01_ready.png", "id": "3013682692357413", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499307352_3013682695690746_8019523881704477708_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HGXkwEUzt8AQ7kNvwG01WZY&_nc_oc=AdrIDkqgVZ0W8xWJcEKcOGtVNp1yAA82vUx1jf-IRVUcOofWb7rcRngNG-iYJ4r7_oc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNwl5BvgJfBZ20UWqCNys5oN_mnJV0EsCTQxpz9Xk5aSA&oe=6ADF5795"}, {"file_name": "openqr_metaquest_store_04_opening_link.png", "id": "1252726940384790", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499310819_1252726943718123_8999351956007794998_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tLf0w7EwXWwQ7kNvwFThbJx&_nc_oc=AdrYwa7_84yMpzlqnj_Y8burEqnm5aMSdLn0bvwqJYdQT4QK3oGTO1MdqBWUtZHRT2k&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOgS9O8sSfL2xT4Y12BAmFbDjUWfMwo-AS0830nq4QHtg&oe=6ADF6ABC"}, {"file_name": "openqr_metaquest_store_03_camera_preview.png", "id": "1800116557897338", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499299093_1800116561230671_3349816583068448143_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YTT9SlArL90Q7kNvwGi7fav&_nc_oc=AdqOTDb9UHxHN1v5daUjZlNNE9bNqC_RJXojy4NRmhzTS_cn_CIX86ekP80Fc0mNZBg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM-bZZKudk4dNQXjlsJ5DS3dEFL7DanZKQtoe2vr6xCcg&oe=6ADF5D2A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "OpenQR", "keywords": ["scanner", "qr", "camera"], "long_description": "Typing a long web address with Quest controllers is slow. With OpenQR you look at the QR code instead: it reads the code through passthrough and opens it.\n\n- **Websites** open in your browser.\n- **YouTube links** play in YouTube VR, 360\u00b0 videos included.\n- **Meta Horizon Store links** go straight to the Store page.\n- **3D tours** like Matterport open in the browser, one tap from VR.\n\nWhen you close the app OpenQR opened, you're back at the scanner for the next code.\n\nFor developers: put your app's deep link (myapp://\u2026) in a QR code and OpenQR opens your app.\n\n### Your privacy\nOpenQR has no internet access of its own and no account, tracking or analytics. It reads camera frames on the headset to find the code, then throws them away. Nothing is saved or sent.\n\n### What it won't open\nOpenQR only opens web and app links. It blocks scripts, files and app-launch tricks. For Wi-Fi details, contacts or plain text, it shows what it found and doesn't open it.", "short_description": "QR code scanner"}]}, "developer_name": null, "developer_privacy_policy_url": "https://orgista.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Orgista", "support_website_url": "https://orgista.com/support", "website_url": "https://orgista.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "393222478507326"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_gra
.com/v/t64.5771-25/499296027_2191619095068492_5698662351279385098_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R_28bNhhhnAQ7kNvwFuzwfC&_nc_oc=AdpRofaTG_IRojMKFu2Ol6NiTqOGXXMLYIvbONsvhuE-GPBE_IgZB5ayHxgpCSxvSk8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSAMRm3Z1rp_dnIlAUlZgzKwiTwqdN55lV1ioDxGH1psg&oe=6AE75427"}, {"file_name": "openqr_metaquest_store_02_scanning.png", "id": "1631760518499501", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499308063_1631760521832834_262161603826586622_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dGcYoYN7PA4Q7kNvwF1PCkS&_nc_oc=Adr_cX3shGIQX_LKOEc8AJwEjInMccV9xa7bR1lD9_XMOEDN1HQMGIBbzkS4eHME8Co&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTPi7_MagRCw2a96VefIBCr2BMmlDAZ_p5LhatVoznemQ&oe=6AE74B74"}, {"file_name": "openqr_metaquest_store_01_ready.png", "id": "3013682692357413", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499307352_3013682695690746_8019523881704477708_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2MJ6Dwbw6wIQ7kNvwFLI1rN&_nc_oc=Adq4T3JqBlWDG_nMfhorXwHVmPG4MpWISSmRLBBQJxn9FyPfs0rS_MpRbN6cR8MUQZs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT7unkjy8e0P9QMI7YsQugUfeSe9svHxbLqJKCJlddMrg&oe=6AE74095"}, {"file_name": "openqr_metaquest_store_04_opening_link.png", "id": "1252726940384790", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499310819_1252726943718123_8999351956007794998_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ctx_tOFV2YMQ7kNvwH62UL7&_nc_oc=Adou0oZ32qUWVC2ZpbajyLVyrjNGOZo4KZVmei04BPVYWA13R32eQhjPrg6geGUAilU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS8tMP3-pP0WiwVIqxg0TgnyPepl-lRT3S_ixzdrIZnxw&oe=6AE753BC"}, {"file_name": "openqr_metaquest_store_03_camera_preview.png", "id": "1800116557897338", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499299093_1800116561230671_3349816583068448143_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GGPWNwXNrdQQ7kNvwE_UaOl&_nc_oc=Adq0ddqv_dVfHm5PCy5FjstaEnXXWon_draYMAbovKQDPt8JcEuROy2mXF7lUjXSbWM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTXMC5JyrjPDGrJ72_xLcxIekDgkeb7qMat_keiiYe3gQ&oe=6AE7462A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "OpenQR", "keywords": ["scanner", "qr", "camera"], "long_description": "Typing a long web address with Quest controllers is slow. With OpenQR you look at the QR code instead: it reads the code through passthrough and opens it.\n\n- **Websites** open in your browser.\n- **YouTube links** play in YouTube VR, 360\u00b0 videos included.\n- **Meta Horizon Store links** go straight to the Store page.\n- **3D tours** like Matterport open in the browser, one tap from VR.\n\nWhen you close the app OpenQR opened, you're back at the scanner for the next code.\n\nFor developers: put your app's deep link (myapp://\u2026) in a QR code and OpenQR opens your app.\n\n### Your privacy\nOpenQR has no internet access of its own and no account, tracking or analytics. It reads camera frames on the headset to find the code, then throws them away. Nothing is saved or sent.\n\n### What it won't open\nOpenQR only opens web and app links. It blocks scripts, files and app-launch tricks. For Wi-Fi details, contacts or plain text, it shows what it found and doesn't open it.", "short_description": "QR code scanner"}]}, "developer_name": null, "developer_privacy_policy_url": "https://orgista.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Orgista", "support_website_url": "https://orgista.com/support", "website_url": "https://orgista.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "393222478507326"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_gra
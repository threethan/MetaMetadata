.com/v/t64.5771-25/499296027_2191619095068492_5698662351279385098_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R_28bNhhhnAQ7kNvwEgQ-vp&_nc_oc=AdokMuX-J07hSCi9Q2KscN_KxlOHo_Kav2FMT4btjTvaSFTHIu-lOfjRZ43aroSUQzc&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTzEck7l2JtgNUPAZ1qjsht5dPnTbFgrO9wzeNiMFnk-Q&oe=6AE8A5A7"}, {"file_name": "openqr_metaquest_store_02_scanning.png", "id": "1631760518499501", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/499308063_1631760521832834_262161603826586622_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dGcYoYN7PA4Q7kNvwFpKIb6&_nc_oc=AdrFpFtALXEcx-w-SxXAqBjFz3WUXZeLPYvMIvaeXRUVeO7HVYIjsNb27Q5n81ZhMnI&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ9meLCIIzsp4UwHGOHhSuO1FN0qj-9fm4YcR5HnZ8Ckg&oe=6AE89CF4"}, {"file_name": "openqr_metaquest_store_01_ready.png", "id": "3013682692357413", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/499307352_3013682695690746_8019523881704477708_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2MJ6Dwbw6wIQ7kNvwERcB-Q&_nc_oc=AdpIZO1fq_emq8gotezc2PX5nlvm6Y3QciDBwHEhS8Cujf0crP4j8MSE3_ypalbvPYI&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRhI1sfUizJcJihPGdYVym56TOGQrmpXd36OXjMo2-rew&oe=6AE89215"}, {"file_name": "openqr_metaquest_store_04_opening_link.png", "id": "1252726940384790", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/499310819_1252726943718123_8999351956007794998_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8aDRtRVQMYIQ7kNvwEeqj3t&_nc_oc=AdrOIkgMcAxwM5oFxho3_MDdk9gfhq9cEXkkcN1spFBSaQe5xT2PWgW76rp6dQ4oZzw&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQYukIkhub8iOvy2S_DOiNOqUR8gDzKpX_3NypRNM1odQ&oe=6AE8A53C"}, {"file_name": "openqr_metaquest_store_03_camera_preview.png", "id": "1800116557897338", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/499299093_1800116561230671_3349816583068448143_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GGPWNwXNrdQQ7kNvwH6mSXu&_nc_oc=Adr6KpQZRBDko6hfYRqTqFjRckpTgKbngB39L9vTAXKvxVYQJU43jt7z8hGqNDijcqg&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRooPC31-hXw4vu1g_00BzLNd6cNW4UY_UDKKzbwC3CtA&oe=6AE897AA"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "OpenQR", "keywords": ["scanner", "qr", "camera"], "long_description": "Typing a long web address with Quest controllers is slow. With OpenQR you look at the QR code instead: it reads the code through passthrough and opens it.\n\n- **Websites** open in your browser.\n- **YouTube links** play in YouTube VR, 360\u00b0 videos included.\n- **Meta Horizon Store links** go straight to the Store page.\n- **3D tours** like Matterport open in the browser, one tap from VR.\n\nWhen you close the app OpenQR opened, you're back at the scanner for the next code.\n\nFor developers: put your app's deep link (myapp://\u2026) in a QR code and OpenQR opens your app.\n\n### Your privacy\nOpenQR has no internet access of its own and no account, tracking or analytics. It reads camera frames on the headset to find the code, then throws them away. Nothing is saved or sent.\n\n### What it won't open\nOpenQR only opens web and app links. It blocks scripts, files and app-launch tricks. For Wi-Fi details, contacts or plain text, it shows what it found and doesn't open it.", "short_description": "QR code scanner"}]}, "developer_name": null, "developer_privacy_policy_url": "https://orgista.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Orgista", "support_website_url": "https://orgista.com/support", "website_url": "https://orgista.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "393222478507326"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_gra
.com/v/t64.5771-25/499296027_2191619095068492_5698662351279385098_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Dgbn0FrU2PUQ7kNvwHIvU4L&_nc_oc=Adoq0aorNHgIfAwZvHFvq_oNEWcxPHpTWCp0kCZC55M1YTtks5w9wPV5WM89wout1pk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQlXLkda06AsLM37flY5lvara-ayqjpGh6O4TDFVlyX-Q&oe=6AE9F727"}, {"file_name": "openqr_metaquest_store_02_scanning.png", "id": "1631760518499501", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499308063_1631760521832834_262161603826586622_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dGcYoYN7PA4Q7kNvwG-orxa&_nc_oc=Adp9TT6sZAyhwURqSbn3OO9EQlBv2-nA5XPmEcC0zbzN50vevzSjvo5eHvUjiw_KJxY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSkKLS-FFSWD-K3KqlzZJ6CD91rkFQdkYbGYfRAI7KCsw&oe=6AE9EE74"}, {"file_name": "openqr_metaquest_store_01_ready.png", "id": "3013682692357413", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499307352_3013682695690746_8019523881704477708_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=86ThJ3-QU50Q7kNvwFjFewV&_nc_oc=AdqHOAa7AQY-ROenSvtqwAmtiHVDLigXRV6tSyhBN8IyDUg7M-fKZ_FukxjnBRE0fpI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR0XsII15DqndG9gNibMyUqDJ_TYzctR1qQKiHgGgD1hw&oe=6AE9E395"}, {"file_name": "openqr_metaquest_store_04_opening_link.png", "id": "1252726940384790", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499310819_1252726943718123_8999351956007794998_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8aDRtRVQMYIQ7kNvwEcmfTi&_nc_oc=Adpt1UMnsgqlVmhR2ZkRo2Jr9NedNY2jm8z09uYEvcatIK-dcd-dhsd0ab485OkJluM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRCMEWtZCxFWPqF6ipzVamAgjQ2vVP6VWynRL2iyVqZ3g&oe=6AE9F6BC"}, {"file_name": "openqr_metaquest_store_03_camera_preview.png", "id": "1800116557897338", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499299093_1800116561230671_3349816583068448143_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LVapjG7CvAcQ7kNvwFRSK6S&_nc_oc=AdrTVMTetFwj51c5M_YF8JDH7kAQc0AiksRCTT-Ll7fMSAGBaf_ZTlMgQ7UqP0-1BA0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTWrPKJAgxMYn6MDsLqIf7zdWxa5S8Zd5w5pk56BxFYtw&oe=6AE9E92A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "OpenQR", "keywords": ["scanner", "qr", "camera"], "long_description": "Typing a long web address with Quest controllers is slow. With OpenQR you look at the QR code instead: it reads the code through passthrough and opens it.\n\n- **Websites** open in your browser.\n- **YouTube links** play in YouTube VR, 360\u00b0 videos included.\n- **Meta Horizon Store links** go straight to the Store page.\n- **3D tours** like Matterport open in the browser, one tap from VR.\n\nWhen you close the app OpenQR opened, you're back at the scanner for the next code.\n\nFor developers: put your app's deep link (myapp://\u2026) in a QR code and OpenQR opens your app.\n\n### Your privacy\nOpenQR has no internet access of its own and no account, tracking or analytics. It reads camera frames on the headset to find the code, then throws them away. Nothing is saved or sent.\n\n### What it won't open\nOpenQR only opens web and app links. It blocks scripts, files and app-launch tricks. For Wi-Fi details, contacts or plain text, it shows what it found and doesn't open it.", "short_description": "QR code scanner"}]}, "developer_name": null, "developer_privacy_policy_url": "https://orgista.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Orgista", "support_website_url": "https://orgista.com/support", "website_url": "https://orgista.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "393222478507326"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_gra
I1Y5NLQWozfvQi6jTXu0uI4lcBueKp52Wkb88xyZsmO-dT4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQUKqPibYp6D4gCVCjqTBn0WSPVak0hR4jWfNqiINCiByQ&oe=6B103FD4"}]}, "id": "2303935327051414", "locale": "en_US", "screenshots": [{"file_name": "openqr_metaquest_store_05_passthrough_scan.png", "id": "2191619091735159", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499296027_2191619095068492_5698662351279385098_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UwlYbFHk4MsQ7kNvwEKpFgh&_nc_oc=Adr8cv91jq8Wn0Tzz6k57QIWkOZwo1ydDCA8dP76iZSIPMbc3wEA9LLjgD8yIEhyZq4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXVYj8nFFHY_gXXTMpfaexg6Y5T1tOR_StngQ9xc0fMKg&oe=6B106AE7"}, {"file_name": "openqr_metaquest_store_02_scanning.png", "id": "1631760518499501", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499308063_1631760521832834_262161603826586622_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ONslY-luYBYQ7kNvwHMjC-c&_nc_oc=AdpBzqjXJHUvkj_4-FPaSWfD0p_v71LmmacfXjpvts9lIS3Q6chE4gKoWgoe_2dq4aI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQU5WxV20k2Z_sXMCxtNfPAkkNuH09mMYsu5BL9TGcwlCw&oe=6B106234"}, {"file_name": "openqr_metaquest_store_01_ready.png", "id": "3013682692357413", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499307352_3013682695690746_8019523881704477708_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BYfVRoXqfzoQ7kNvwH2v6gM&_nc_oc=AdoWBcj-jaNnRsUV22sIknl2IvNu2aVEgYpqfTJND7BYm9OGBtp9oY71tO3oWr0bj7Y&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXBHpzjjU6tFkAserHJDMc03-M9KvwQuayH9Okiy2ONxg&oe=6B105755"}, {"file_name": "openqr_metaquest_store_04_opening_link.png", "id": "1252726940384790", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499310819_1252726943718123_8999351956007794998_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xLB05onhUAIQ7kNvwG19vqu&_nc_oc=AdqQr8OzYcX9Q-rysNeGe6go8EQsHvnMt5B2HMjmscZNrZGhLM2Ql2GShjxPTsr4yAA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWqc7XTF6SClG3118030ZQnOQ5dKDHgkZjBIlNDmUZPFg&oe=6B106A7C"}, {"file_name": "openqr_metaquest_store_03_camera_preview.png", "id": "1800116557897338", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499299093_1800116561230671_3349816583068448143_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J2usfjyEzeQQ7kNvwHhdLv4&_nc_oc=AdqaYjTlOpApw-8jkndDiddYDrQYMkKu3R3zoUX92y-2c4tuGQkr4jmnX0tAsUXFbvI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWUgx01JxI9wE6LxnI0EzW89sInGawCH9AhqSoDOTvwzA&oe=6B105CEA"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "OpenQR", "keywords": ["scanner", "qr", "camera"], "long_description": "Typing a long web address with Quest controllers is slow. With OpenQR you look at the QR code instead: it reads the code through passthrough and opens it.\n\n- **Websites** open in your browser.\n- **YouTube links** play in YouTube VR, 360\u00b0 videos included.\n- **Meta Horizon Store links** go straight to the Store page.\n- **3D tours** like Matterport open in the browser, one tap from VR.\n\nWhen you close the app OpenQR opened, you're back at the scanner for the next code.\n\nFor developers: put your app's deep link (myapp://\u2026) in a QR code and OpenQR opens your app.\n\n### Your privacy\nOpenQR has no internet access of its own and no account, tracking or analytics. It reads camera frames on the headset to find the code, then throws them away. Nothing is saved or sent.\n\n### What it won't open\nOpenQR only opens web and app links. It blocks scripts, files and app-launch tricks. For Wi-Fi details, contacts or plain text, it shows what it found and doesn't open it.", "short_description": "QR code scanner"}]}, "developer_name": null, "developer_privacy_policy_url": "https://orgista.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Orgista", "support_website_url": "https://orgista.com/support", "website_url": "https://orgista.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "393222478507326"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1333087189895546"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1109044781676253"}]}, "baseline_offer": {"id": "1109044781676253"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1791918300, "status": "PUBLISHED", "id": "1109044781676253"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1331804033357195", "version": "1.0.60"}, "id": "38145924175021154", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1236442736226659", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1331804033357195"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "38145924175021154"}]}, "change_log": null, "created_date": 1791855256, "id": "1331804033357195", "version": "1.0.60", "version_code": 61, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null
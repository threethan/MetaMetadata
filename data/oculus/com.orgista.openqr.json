.com/v/t64.5771-25/499296027_2191619095068492_5698662351279385098_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XQfbbLQGDI8Q7kNvwH0PYZu&_nc_oc=AdoLaa5lBgC1hTL6DpRbS1yRfSXulN8wwcPNijE0_wqTPCFPqEiLXhgjKb0QmiZHq64&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNX0Bd-ahWNxm6CNA7zzQCF-EC49SAg4zuEHIlF4qT2GQ&oe=6AE4B127"}, {"file_name": "openqr_metaquest_store_02_scanning.png", "id": "1631760518499501", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499308063_1631760521832834_262161603826586622_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zRkHVX9h-JQQ7kNvwGXtc_x&_nc_oc=Ado6Xsa0LqQWbcqfuXctMQykYr5J81oyMFBZoWqx3PLUcseRITAxNoCvCBmKpm0Vx3E&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOwXYG3h9CyTR_2480p_9hO7BhqKFEJse2zuC-lIKhN0w&oe=6AE4A874"}, {"file_name": "openqr_metaquest_store_01_ready.png", "id": "3013682692357413", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499307352_3013682695690746_8019523881704477708_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m_r1ECmUN8EQ7kNvwHH6ZiH&_nc_oc=AdrngfszFWb_2OnhJV2ZfYb9lUGUC5pKO4--M4R4GRamFLk6KA52hn3DombufK8HK8s&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPqxgG8J2hGOk5aYDu_RLD1tAxG-Md8zdxYVSIl4wLBMg&oe=6AE49D95"}, {"file_name": "openqr_metaquest_store_04_opening_link.png", "id": "1252726940384790", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499310819_1252726943718123_8999351956007794998_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ctx_tOFV2YMQ7kNvwEXL05x&_nc_oc=AdpS9NHguWJoGL_tmyS4fxwfeRvuEd6uleBbpbugyA-CC-yaUToZuAHhNYT8N0fC_9U&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPEGIdPueX1AX3gnpkwBw5bxOPALftInomjxJZnt7FvUA&oe=6AE4B0BC"}, {"file_name": "openqr_metaquest_store_03_camera_preview.png", "id": "1800116557897338", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499299093_1800116561230671_3349816583068448143_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BaLaIol47vkQ7kNvwH01Yw8&_nc_oc=AdooSDnUKWEcQzmk8Dn0E1Qw5AcWsaB7ZZrABBap_dBtuPV1_v7_OH2EKFPBSDLzVn8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM_ViZ71D2-Txvwc4Lgqo2Llz_DQn9SFpNk1FZiuWmyBA&oe=6AE4A32A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "OpenQR", "keywords": ["scanner", "qr", "camera"], "long_description": "Typing a long web address with Quest controllers is slow. With OpenQR you look at the QR code instead: it reads the code through passthrough and opens it.\n\n- **Websites** open in your browser.\n- **YouTube links** play in YouTube VR, 360\u00b0 videos included.\n- **Meta Horizon Store links** go straight to the Store page.\n- **3D tours** like Matterport open in the browser, one tap from VR.\n\nWhen you close the app OpenQR opened, you're back at the scanner for the next code.\n\nFor developers: put your app's deep link (myapp://\u2026) in a QR code and OpenQR opens your app.\n\n### Your privacy\nOpenQR has no internet access of its own and no account, tracking or analytics. It reads camera frames on the headset to find the code, then throws them away. Nothing is saved or sent.\n\n### What it won't open\nOpenQR only opens web and app links. It blocks scripts, files and app-launch tricks. For Wi-Fi details, contacts or plain text, it shows what it found and doesn't open it.", "short_description": "QR code scanner"}]}, "developer_name": null, "developer_privacy_policy_url": "https://orgista.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Orgista", "support_website_url": "https://orgista.com/support", "website_url": "https://orgista.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "393222478507326"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_gra
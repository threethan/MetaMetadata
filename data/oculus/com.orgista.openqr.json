.com/v/t64.5771-25/499296027_2191619095068492_5698662351279385098_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3Zy8tIHzMNoQ7kNvwFqNv9u&_nc_oc=AdqL65iJcy1n8E2xuqbPf2jXgew-_h-CJu0u4-Gga_pICfgFOqFpkffVxumBzRMiSsU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT5-RQdVXWtLuKzXc8Q8MmdyUQ_ZbIKnVNxj6g9YZNGiQ&oe=6AF1E027"}, {"file_name": "openqr_metaquest_store_02_scanning.png", "id": "1631760518499501", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499308063_1631760521832834_262161603826586622_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3nYM2Eqk5Q4Q7kNvwGT4Pgt&_nc_oc=Adq11o8kfgOk_Iaiqsqx1awiYJvYatcsw0Y4PJEU_vl7pk0YmthvuSSDbDnu0Y-i7Uk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRZmi6D9v14phXqMMFUPC5Hq-ihzAPsl0o9FuiUu8x2ZQ&oe=6AF1D774"}, {"file_name": "openqr_metaquest_store_01_ready.png", "id": "3013682692357413", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499307352_3013682695690746_8019523881704477708_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4Ld9QBm7U8cQ7kNvwGKMPYE&_nc_oc=AdrxRQ8DvisD-fuWpAyumkRL4F8n3_9-DuL_f0aEyjKfYfUwGinLP0KNHK8ai4F5eMw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT_T2_5FyVP_L37n5ByWtMW3nzXa2ZGpSo6UGgSUwSaAg&oe=6AF204D5"}, {"file_name": "openqr_metaquest_store_04_opening_link.png", "id": "1252726940384790", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499310819_1252726943718123_8999351956007794998_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Kzx_hhtcxwYQ7kNvwFrRoPM&_nc_oc=Adrhpg_CFnU9hd70VzdF6eXbzM1s9aJHf3IgMLBec6AzOkyHKyXn5MwQe9mUgSmkS9s&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT1b02Viy3N6xuqfAnQWpTVhpEC06RMnVk4-_Lrc30aBg&oe=6AF1DFBC"}, {"file_name": "openqr_metaquest_store_03_camera_preview.png", "id": "1800116557897338", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499299093_1800116561230671_3349816583068448143_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kDQZNDGJFbUQ7kNvwH2Jnjc&_nc_oc=AdozpO8OuDhCrQ9LyYPzUSQ4vM2EnvN-2yNrcVHxbthqPH_FoCrmkJ3KxKkD3N8BIbg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQPU8lH1MbWUNBAoauVZQxziJQ18wJfg5_8NXaYIbEL4Q&oe=6AF20A6A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "OpenQR", "keywords": ["scanner", "qr", "camera"], "long_description": "Typing a long web address with Quest controllers is slow. With OpenQR you look at the QR code instead: it reads the code through passthrough and opens it.\n\n- **Websites** open in your browser.\n- **YouTube links** play in YouTube VR, 360\u00b0 videos included.\n- **Meta Horizon Store links** go straight to the Store page.\n- **3D tours** like Matterport open in the browser, one tap from VR.\n\nWhen you close the app OpenQR opened, you're back at the scanner for the next code.\n\nFor developers: put your app's deep link (myapp://\u2026) in a QR code and OpenQR opens your app.\n\n### Your privacy\nOpenQR has no internet access of its own and no account, tracking or analytics. It reads camera frames on the headset to find the code, then throws them away. Nothing is saved or sent.\n\n### What it won't open\nOpenQR only opens web and app links. It blocks scripts, files and app-launch tricks. For Wi-Fi details, contacts or plain text, it shows what it found and doesn't open it.", "short_description": "QR code scanner"}]}, "developer_name": null, "developer_privacy_policy_url": "https://orgista.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Orgista", "support_website_url": "https://orgista.com/support", "website_url": "https://orgista.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "393222478507326"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_gra
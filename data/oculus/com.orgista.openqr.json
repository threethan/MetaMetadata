.com/v/t64.5771-25/499296027_2191619095068492_5698662351279385098_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S8LiUZVV7gwQ7kNvwFZpo2T&_nc_oc=Adpk4X8jZDX6OtptgU03pwC94BtQ3Nju7KHhCmQElSSf8Uc2GzcsPQPW1B4BErSjku0&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTWfDZrXw7f4CqgJKRI2WZE8l1MaDEEaB6279mPhE8gRA&oe=6AF9C927"}, {"file_name": "openqr_metaquest_store_02_scanning.png", "id": "1631760518499501", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/499308063_1631760521832834_262161603826586622_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rp6GhUkKUZQQ7kNvwG7kTy_&_nc_oc=AdpkT78rzoh0RJJzIbXggPGlS7ZF3urzfjfs79Pxbd4FlFvfYjwFqpDbGyyMygnSheM&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRHCKPToETXEKe4LGC22VM2H8oO1r2grcl84PW78iQmPw&oe=6AF9C074"}, {"file_name": "openqr_metaquest_store_01_ready.png", "id": "3013682692357413", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/499307352_3013682695690746_8019523881704477708_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2sjf0CKm3PkQ7kNvwGSifG8&_nc_oc=Adph4fFpZCFoN3Fntrv9vtuEtFNe-ruYXr-MHkGFVx_FoAD2v6UYHYgQjmRuks-xyao&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQeRpNQwisDSHmI7IEfh9buIOdA93fqIN-W3V8Brc034Q&oe=6AF9B595"}, {"file_name": "openqr_metaquest_store_04_opening_link.png", "id": "1252726940384790", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499310819_1252726943718123_8999351956007794998_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bY-hz49u7owQ7kNvwGKfj8D&_nc_oc=AdqMKBPL4OiCpR0yM0ABrC1nPTLstF2IKH6_Kzy6NLi_AFDRT1I3zke1acCKYhalUg4&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTjeNgV7Odet9mKdpmKSltrHHsoNBsJbS4curUgWYmGIA&oe=6AF9C8BC"}, {"file_name": "openqr_metaquest_store_03_camera_preview.png", "id": "1800116557897338", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/499299093_1800116561230671_3349816583068448143_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zDFviShE3SYQ7kNvwETyMlo&_nc_oc=AdoS_MmOoOVtjcbNnrQnNqJL4VxwYoZ-JZLNHDoJUOP5GndxaUA4nRV9IwaR0g0fkJc&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQY-m0OsHz4LiDb36uEfQeC5JUp2I0Y-_0k9e8IsCegwA&oe=6AF9BB2A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "OpenQR", "keywords": ["scanner", "qr", "camera"], "long_description": "Typing a long web address with Quest controllers is slow. With OpenQR you look at the QR code instead: it reads the code through passthrough and opens it.\n\n- **Websites** open in your browser.\n- **YouTube links** play in YouTube VR, 360\u00b0 videos included.\n- **Meta Horizon Store links** go straight to the Store page.\n- **3D tours** like Matterport open in the browser, one tap from VR.\n\nWhen you close the app OpenQR opened, you're back at the scanner for the next code.\n\nFor developers: put your app's deep link (myapp://\u2026) in a QR code and OpenQR opens your app.\n\n### Your privacy\nOpenQR has no internet access of its own and no account, tracking or analytics. It reads camera frames on the headset to find the code, then throws them away. Nothing is saved or sent.\n\n### What it won't open\nOpenQR only opens web and app links. It blocks scripts, files and app-launch tricks. For Wi-Fi details, contacts or plain text, it shows what it found and doesn't open it.", "short_description": "QR code scanner"}]}, "developer_name": null, "developer_privacy_policy_url": "https://orgista.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Orgista", "support_website_url": "https://orgista.com/support", "website_url": "https://orgista.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "393222478507326"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_gra
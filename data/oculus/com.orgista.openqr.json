.com/v/t64.5771-25/499296027_2191619095068492_5698662351279385098_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BImMhAOIGGQQ7kNvwGWhOkV&_nc_oc=Adr9eOaYGVQJPMFgN-N3IYNNzFWmjcxqy0UG1Eeio_0btpbEbu0xrPt764I6bUKJVbE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS9jEkz1F9EUF9N7mWfxdIjnqgTEpeWvbJh4Fb-1ZICdw&oe=6AEF3D27"}, {"file_name": "openqr_metaquest_store_02_scanning.png", "id": "1631760518499501", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499308063_1631760521832834_262161603826586622_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3nYM2Eqk5Q4Q7kNvwHoYGCb&_nc_oc=AdogXv9w0iuP5bVuCUvgl8PZFFpLD12huJBSGqP8fwz1jxkaxnQ-fheyzP8-7rxAWmY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT32WfhlRPU9lgyWFV9wMc1MKY3fPyN8WPiZg6RG3vI5Q&oe=6AEF3474"}, {"file_name": "openqr_metaquest_store_01_ready.png", "id": "3013682692357413", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499307352_3013682695690746_8019523881704477708_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IPKKUEId3yQQ7kNvwHyXNtO&_nc_oc=AdqCMPxvz6vedpAQd0b4VyMGTwzzWkWUhwDflNMy7atHXerohd03KhJSrV512IgEVoU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSStLlpukH0YXDvpwY-7FyPsTUMq6IGGwU7hD-VgZhdKw&oe=6AEF61D5"}, {"file_name": "openqr_metaquest_store_04_opening_link.png", "id": "1252726940384790", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499310819_1252726943718123_8999351956007794998_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1_nvT7CRa58Q7kNvwGW64Iu&_nc_oc=Adon3yMLrq7ZCwr41YPBMmLe1PGLzsVRffQFai-3WQvfB1Fsf4nSRfm0qe_x370n94A&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT5_HhH0A1LkX3a8t3ZUSrcWIfxhUBilgCmO_gtggO8VQ&oe=6AEF3CBC"}, {"file_name": "openqr_metaquest_store_03_camera_preview.png", "id": "1800116557897338", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499299093_1800116561230671_3349816583068448143_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-lbJFMjXexQQ7kNvwGQhqdb&_nc_oc=AdqMhIj_iLJVsmEhU22XqIViP46kjGuOd754AnIXeaXtxtrXYGYu_74Vq5r5wzOItro&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRaHTGCsveY4lnn9GJzejrXHlCW_jR9VyO8fHbQ7lbK7w&oe=6AEF676A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "OpenQR", "keywords": ["scanner", "qr", "camera"], "long_description": "Typing a long web address with Quest controllers is slow. With OpenQR you look at the QR code instead: it reads the code through passthrough and opens it.\n\n- **Websites** open in your browser.\n- **YouTube links** play in YouTube VR, 360\u00b0 videos included.\n- **Meta Horizon Store links** go straight to the Store page.\n- **3D tours** like Matterport open in the browser, one tap from VR.\n\nWhen you close the app OpenQR opened, you're back at the scanner for the next code.\n\nFor developers: put your app's deep link (myapp://\u2026) in a QR code and OpenQR opens your app.\n\n### Your privacy\nOpenQR has no internet access of its own and no account, tracking or analytics. It reads camera frames on the headset to find the code, then throws them away. Nothing is saved or sent.\n\n### What it won't open\nOpenQR only opens web and app links. It blocks scripts, files and app-launch tricks. For Wi-Fi details, contacts or plain text, it shows what it found and doesn't open it.", "short_description": "QR code scanner"}]}, "developer_name": null, "developer_privacy_policy_url": "https://orgista.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Orgista", "support_website_url": "https://orgista.com/support", "website_url": "https://orgista.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "393222478507326"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_gra
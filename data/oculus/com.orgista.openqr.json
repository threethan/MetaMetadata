.com/v/t64.5771-25/499296027_2191619095068492_5698662351279385098_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BImMhAOIGGQQ7kNvwE8_eRZ&_nc_oc=Adpvxks_Fuawv2zTP_6WhPkaEND63AmJk1_HjxFmHV0_K8l0nMCR1efGpF3KYmP6fEY&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTTn5uzjYnz0Adytse8zSL_XiUip03mDA4nADEbdPn1xg&oe=6AF08EA7"}, {"file_name": "openqr_metaquest_store_02_scanning.png", "id": "1631760518499501", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499308063_1631760521832834_262161603826586622_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3nYM2Eqk5Q4Q7kNvwHQSnda&_nc_oc=AdoG9INtV4C2wXOtkZHixK8DlKA-YOuBVYsbfMbfQkE1_83gkuXo7cy3FTH9dXfkgWY&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSUxgvAyPpL74EC0JwbwpCvhydI4jK5_TQW34K_mA9QvA&oe=6AF085F4"}, {"file_name": "openqr_metaquest_store_01_ready.png", "id": "3013682692357413", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499307352_3013682695690746_8019523881704477708_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IPKKUEId3yQQ7kNvwEeLl21&_nc_oc=AdqRh0iLNZAuJaha10wUIVQBqBHQdf_0M4HwZeOpplbvksiSlM_z-SR_eXCfqCR4ipo&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSVRW4oPTL7XNF3vhlTYmKA-4pkCWUJGe-pJL3lZq11iQ&oe=6AF0B355"}, {"file_name": "openqr_metaquest_store_04_opening_link.png", "id": "1252726940384790", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499310819_1252726943718123_8999351956007794998_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Kzx_hhtcxwYQ7kNvwH3ii3z&_nc_oc=AdovzIjnL4oM61oPMsWf3XYQ5BIc6SBeC1bwL9R-5U7gz-5eTUA96twsZF-T0e0UUkw&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ6Q-LwecbRvquB4Ap26A1frqyAcascHLLtuwYX4YgakA&oe=6AF08E3C"}, {"file_name": "openqr_metaquest_store_03_camera_preview.png", "id": "1800116557897338", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499299093_1800116561230671_3349816583068448143_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-lbJFMjXexQQ7kNvwGgE-Uu&_nc_oc=AdpDwm8VBODxLobBUCln1XTchS4rflre1vuzY5biBblJ49isE0pL_0NcMg9-0PGT9g0&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTdphXi29lbqeqIK07Gz0ddCIsj6_yXYMglEyTdTUnS9A&oe=6AF080AA"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "OpenQR", "keywords": ["scanner", "qr", "camera"], "long_description": "Typing a long web address with Quest controllers is slow. With OpenQR you look at the QR code instead: it reads the code through passthrough and opens it.\n\n- **Websites** open in your browser.\n- **YouTube links** play in YouTube VR, 360\u00b0 videos included.\n- **Meta Horizon Store links** go straight to the Store page.\n- **3D tours** like Matterport open in the browser, one tap from VR.\n\nWhen you close the app OpenQR opened, you're back at the scanner for the next code.\n\nFor developers: put your app's deep link (myapp://\u2026) in a QR code and OpenQR opens your app.\n\n### Your privacy\nOpenQR has no internet access of its own and no account, tracking or analytics. It reads camera frames on the headset to find the code, then throws them away. Nothing is saved or sent.\n\n### What it won't open\nOpenQR only opens web and app links. It blocks scripts, files and app-launch tricks. For Wi-Fi details, contacts or plain text, it shows what it found and doesn't open it.", "short_description": "QR code scanner"}]}, "developer_name": null, "developer_privacy_policy_url": "https://orgista.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Orgista", "support_website_url": "https://orgista.com/support", "website_url": "https://orgista.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "393222478507326"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_gra
.com/v/t64.5771-25/499296027_2191619095068492_5698662351279385098_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3dgT0bBA_PUQ7kNvwESbYmo&_nc_oc=AdqDFx4Y_kihl1ZW5zPtCsLBdTv3O2GA6T8mUOqJ2yFBRPvqdjwbk2FM5TXwwAunnmw&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPWzkxmLxqVDY0YWunan6Y_5EbKtcBwDbR-m_49yQoqSQ&oe=6AE0BCA7"}, {"file_name": "openqr_metaquest_store_02_scanning.png", "id": "1631760518499501", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499308063_1631760521832834_262161603826586622_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GJuQypGuHtIQ7kNvwGpah6Q&_nc_oc=AdoPr7MlOZGAN_OA7iM1sYtwlS_3CgECYIPAvSlAK0ZhIPC-QsRR7Cauxx5McV7on4w&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP2EyUWvLIR0dK9jJkxcMQmZG6R8aNOO19RNBtxXKstkQ&oe=6AE0B3F4"}, {"file_name": "openqr_metaquest_store_01_ready.png", "id": "3013682692357413", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499307352_3013682695690746_8019523881704477708_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HGXkwEUzt8AQ7kNvwEq2qOV&_nc_oc=Adrf3cHpbnGIy5mZbXgFVKLWQ4mDyCQye0yGGBjYRy_RlXcRg393HsrTo_crhcGOrbo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPTunsZnAON6yNwOq0WUd6EA7oOaDnRhe9LixbIthtUKQ&oe=6AE0A915"}, {"file_name": "openqr_metaquest_store_04_opening_link.png", "id": "1252726940384790", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499310819_1252726943718123_8999351956007794998_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y3gFFxlKmcIQ7kNvwFDp4jp&_nc_oc=Adre9w38uzKJU8MlLo4krzZxBpuqWUk-UJ_hJzc3D8vXT3yVeQG1rHuYB4cZtQtItNY&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNa4-jeXlFJZywdCaicqT7F1_qBoqhTvx9SoVg6hGR8bQ&oe=6AE0BC3C"}, {"file_name": "openqr_metaquest_store_03_camera_preview.png", "id": "1800116557897338", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499299093_1800116561230671_3349816583068448143_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YTT9SlArL90Q7kNvwEGehT3&_nc_oc=Adrn8Dq955QC7AIXhLg6rhurAEhS7ryg1olmw4fB-qsciJeqnUKc0ATgjDeR_gBbDF8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNopuQe94ovfpCkcubtVMrjkg_4pg5fU3pTnWrSJ3zEBQ&oe=6AE0AEAA"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "OpenQR", "keywords": ["scanner", "qr", "camera"], "long_description": "Typing a long web address with Quest controllers is slow. With OpenQR you look at the QR code instead: it reads the code through passthrough and opens it.\n\n- **Websites** open in your browser.\n- **YouTube links** play in YouTube VR, 360\u00b0 videos included.\n- **Meta Horizon Store links** go straight to the Store page.\n- **3D tours** like Matterport open in the browser, one tap from VR.\n\nWhen you close the app OpenQR opened, you're back at the scanner for the next code.\n\nFor developers: put your app's deep link (myapp://\u2026) in a QR code and OpenQR opens your app.\n\n### Your privacy\nOpenQR has no internet access of its own and no account, tracking or analytics. It reads camera frames on the headset to find the code, then throws them away. Nothing is saved or sent.\n\n### What it won't open\nOpenQR only opens web and app links. It blocks scripts, files and app-launch tricks. For Wi-Fi details, contacts or plain text, it shows what it found and doesn't open it.", "short_description": "QR code scanner"}]}, "developer_name": null, "developer_privacy_policy_url": "https://orgista.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Orgista", "support_website_url": "https://orgista.com/support", "website_url": "https://orgista.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "393222478507326"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_gra
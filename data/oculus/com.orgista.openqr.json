.com/v/t64.5771-25/499296027_2191619095068492_5698662351279385098_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XQfbbLQGDI8Q7kNvwEt2UVi&_nc_oc=AdpoIcytv8Jm2gAp_q_oiH15gOsetAVBeIQPpvm5vT4IunfHXBxlB8n4sdhm3OLXXoU&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPG-hfEAByEtGyRt_kVrT1UeBydfIkAkTkZANW8LRkjrQ&oe=6AE20E27"}, {"file_name": "openqr_metaquest_store_02_scanning.png", "id": "1631760518499501", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499308063_1631760521832834_262161603826586622_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GJuQypGuHtIQ7kNvwE0vUVQ&_nc_oc=AdpwfT8MD1yPRV1jtoAyo1KYWHm6SLAHpZkIbSn3zyabnyzhrwydwfmCXDIiF1SrBZc&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMoOwZYEGiOWmP9fQX_GQdXsD-O1syR67ouLw68ble9zg&oe=6AE20574"}, {"file_name": "openqr_metaquest_store_01_ready.png", "id": "3013682692357413", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499307352_3013682695690746_8019523881704477708_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m_r1ECmUN8EQ7kNvwE3B8vK&_nc_oc=AdqMZ8s8t3C1DXl0kUo-yX5ooAznXwc1NQaKXKoCjnK_B5I77vwzaQg_68HKFqtDqfc&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM-w-j0NRmE9iaIyLG6Ghfys195DodImSXJqpjLNGBnTQ&oe=6AE1FA95"}, {"file_name": "openqr_metaquest_store_04_opening_link.png", "id": "1252726940384790", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499310819_1252726943718123_8999351956007794998_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y3gFFxlKmcIQ7kNvwGsc_b6&_nc_oc=Adp2qwfV7y9U7LvSQ8MFtw1Oh5ekdaDN5G8Jc_lDGv0ciTKIOo-IPmNnwjfNDB9eiJk&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNebl7-3m_m0TOflEh49fsrPxaiAUQph8f02HTC4OZMEA&oe=6AE20DBC"}, {"file_name": "openqr_metaquest_store_03_camera_preview.png", "id": "1800116557897338", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499299093_1800116561230671_3349816583068448143_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BaLaIol47vkQ7kNvwEdu2Uq&_nc_oc=AdpEHg3tmsv6ZAGx_u5fXImozu_Mx9L4k-4gsxp4ZhKr4sGPKHr5w59DEm5Cc1wSWJs&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMqgXQj6W5HpUaTO2amQsZCc9sTXwBQgU_k0_1Wfy_6qQ&oe=6AE2002A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "OpenQR", "keywords": ["scanner", "qr", "camera"], "long_description": "Typing a long web address with Quest controllers is slow. With OpenQR you look at the QR code instead: it reads the code through passthrough and opens it.\n\n- **Websites** open in your browser.\n- **YouTube links** play in YouTube VR, 360\u00b0 videos included.\n- **Meta Horizon Store links** go straight to the Store page.\n- **3D tours** like Matterport open in the browser, one tap from VR.\n\nWhen you close the app OpenQR opened, you're back at the scanner for the next code.\n\nFor developers: put your app's deep link (myapp://\u2026) in a QR code and OpenQR opens your app.\n\n### Your privacy\nOpenQR has no internet access of its own and no account, tracking or analytics. It reads camera frames on the headset to find the code, then throws them away. Nothing is saved or sent.\n\n### What it won't open\nOpenQR only opens web and app links. It blocks scripts, files and app-launch tricks. For Wi-Fi details, contacts or plain text, it shows what it found and doesn't open it.", "short_description": "QR code scanner"}]}, "developer_name": null, "developer_privacy_policy_url": "https://orgista.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Orgista", "support_website_url": "https://orgista.com/support", "website_url": "https://orgista.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "393222478507326"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_gra
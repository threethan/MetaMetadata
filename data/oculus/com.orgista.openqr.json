.com/v/t64.5771-25/499296027_2191619095068492_5698662351279385098_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3dgT0bBA_PUQ7kNvwEZhOMt&_nc_oc=AdpmXYhgoteM3z0wbScoQIMo1uzx3UWT7SnSoomMEPxTx1no1cejjRifOeON-Lb0asI&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMS-jJPUvYrvmlXB0dmc_a7i_jKqbztVd2RGdUtQtPpNg&oe=6ADE19A7"}, {"file_name": "openqr_metaquest_store_02_scanning.png", "id": "1631760518499501", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499308063_1631760521832834_262161603826586622_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cOnq943niQMQ7kNvwF6b4dT&_nc_oc=AdpjuinEKvUkETS2DW8VL7XrFos3nJ1eiNfiWFOAvLuw3xoDafLUimj8BuuSfqBSGSY&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNniDZWEkgCipsigA83iGBOQ2sGio0saY2dm_cyii5sBA&oe=6ADE10F4"}, {"file_name": "openqr_metaquest_store_01_ready.png", "id": "3013682692357413", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499307352_3013682695690746_8019523881704477708_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HGXkwEUzt8AQ7kNvwFGMWZT&_nc_oc=AdoKdnIDIwgsk09_BDBuJoXjrSVlT2YWyYJQS81h81z0_2BdR2AeZ8tkWktfuIxgZj0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNefMNxUYO_ZKTV_3Sf9ypPYU90aoN83BaUHaxlzniK6A&oe=6ADE0615"}, {"file_name": "openqr_metaquest_store_04_opening_link.png", "id": "1252726940384790", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499310819_1252726943718123_8999351956007794998_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tLf0w7EwXWwQ7kNvwE97esn&_nc_oc=AdpKRFPxeQijPOyckhhNQTt-oRwkINAV36F9FpM6KUX3bKsezP962kZm9ro529sRluY&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMdR_UX47X2-cm7-eo7-9wJ3YQiS0_vaAqsFhEKNAwE0Q&oe=6ADE193C"}, {"file_name": "openqr_metaquest_store_03_camera_preview.png", "id": "1800116557897338", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499299093_1800116561230671_3349816583068448143_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YTT9SlArL90Q7kNvwHLQ5Pq&_nc_oc=AdqLlEnlhDXiACMbHxu9_VQl4H3-Kf8OECYJt7RqyXq6jOloxLy9fZIdXk5JHflEMuk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQODl5Fq1-AFyLpp238wZzbBvosoq-l0dYdPGqQbDfFLgw&oe=6ADE0BAA"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "OpenQR", "keywords": ["scanner", "qr", "camera"], "long_description": "Typing a long web address with Quest controllers is slow. With OpenQR you look at the QR code instead: it reads the code through passthrough and opens it.\n\n- **Websites** open in your browser.\n- **YouTube links** play in YouTube VR, 360\u00b0 videos included.\n- **Meta Horizon Store links** go straight to the Store page.\n- **3D tours** like Matterport open in the browser, one tap from VR.\n\nWhen you close the app OpenQR opened, you're back at the scanner for the next code.\n\nFor developers: put your app's deep link (myapp://\u2026) in a QR code and OpenQR opens your app.\n\n### Your privacy\nOpenQR has no internet access of its own and no account, tracking or analytics. It reads camera frames on the headset to find the code, then throws them away. Nothing is saved or sent.\n\n### What it won't open\nOpenQR only opens web and app links. It blocks scripts, files and app-launch tricks. For Wi-Fi details, contacts or plain text, it shows what it found and doesn't open it.", "short_description": "QR code scanner"}]}, "developer_name": null, "developer_privacy_policy_url": "https://orgista.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Orgista", "support_website_url": "https://orgista.com/support", "website_url": "https://orgista.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "393222478507326"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_gra
.com/v/t64.5771-25/499296027_2191619095068492_5698662351279385098_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R_28bNhhhnAQ7kNvwGXIDbi&_nc_oc=AdpwmQQbb1idvnZ8AuSJbizrrtNEHhb4b1MioenXMwpYbkBCW8tfYJIjBq-a4jSsBhY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPD1fptFE0ZuVwED_RYfDCqHdjCmjZq_wCtWvJSvxsWIA&oe=6AE602A7"}, {"file_name": "openqr_metaquest_store_02_scanning.png", "id": "1631760518499501", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499308063_1631760521832834_262161603826586622_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zRkHVX9h-JQQ7kNvwGyGjYr&_nc_oc=AdriIyY0nlmxguJmIlH1TMHomPddA4DBV8uJVgHNrmKJNaRw1P8i-qfpBxBoA6xBZ34&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP3tSn48P_kL9bol9Y36AgYGX0i1phCXsKLJeFoIYL2_g&oe=6AE5F9F4"}, {"file_name": "openqr_metaquest_store_01_ready.png", "id": "3013682692357413", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499307352_3013682695690746_8019523881704477708_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2MJ6Dwbw6wIQ7kNvwEynBKw&_nc_oc=AdoYZm0oYVh_SSAAI0LqmEqtHjs70cUBN1d2-vzWFAzx0D-zcj8Z7Vy9WZhRGO2tDG8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO405l-MXfHClEyj6HYtzo1xOjjoQ0Fzelkd2EuOjnqww&oe=6AE5EF15"}, {"file_name": "openqr_metaquest_store_04_opening_link.png", "id": "1252726940384790", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499310819_1252726943718123_8999351956007794998_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ctx_tOFV2YMQ7kNvwE8kpOn&_nc_oc=Adr_5HgdUbBNXPX090Nq4RtfrcUxaui54z_WyAinxC_MZLSc1SQ0z9IHp3oB3EIrYho&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP20rtTW2cTQAICWHq2g51iucKiFfxzfpp4CXSsUGHFtg&oe=6AE6023C"}, {"file_name": "openqr_metaquest_store_03_camera_preview.png", "id": "1800116557897338", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499299093_1800116561230671_3349816583068448143_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GGPWNwXNrdQQ7kNvwEZA9oR&_nc_oc=Adqmrs7IjLUytQZlzxCPgOMo0XrqBy0YXh4Inr2QY-Y3xTTAMVX8JISJMdp51m-XbdM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMQc3jvLckkRaGyhPsbh12lyuarPVgeotKS6pgilQN7yg&oe=6AE5F4AA"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "OpenQR", "keywords": ["scanner", "qr", "camera"], "long_description": "Typing a long web address with Quest controllers is slow. With OpenQR you look at the QR code instead: it reads the code through passthrough and opens it.\n\n- **Websites** open in your browser.\n- **YouTube links** play in YouTube VR, 360\u00b0 videos included.\n- **Meta Horizon Store links** go straight to the Store page.\n- **3D tours** like Matterport open in the browser, one tap from VR.\n\nWhen you close the app OpenQR opened, you're back at the scanner for the next code.\n\nFor developers: put your app's deep link (myapp://\u2026) in a QR code and OpenQR opens your app.\n\n### Your privacy\nOpenQR has no internet access of its own and no account, tracking or analytics. It reads camera frames on the headset to find the code, then throws them away. Nothing is saved or sent.\n\n### What it won't open\nOpenQR only opens web and app links. It blocks scripts, files and app-launch tricks. For Wi-Fi details, contacts or plain text, it shows what it found and doesn't open it.", "short_description": "QR code scanner"}]}, "developer_name": null, "developer_privacy_policy_url": "https://orgista.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Orgista", "support_website_url": "https://orgista.com/support", "website_url": "https://orgista.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "393222478507326"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_gra
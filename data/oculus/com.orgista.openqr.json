.com/v/t64.5771-25/499296027_2191619095068492_5698662351279385098_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Quf2kBOBeOYQ7kNvwEKwsuI&_nc_oc=AdohH4jOwgO_AssSiiscHayn6RO_pt0bO-gl2tvg4XQjq3IYPe9NoFvrIrPxOcz5O8c&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ0Buhomu14YTl0ZeVhcCdopJYE3MrAS2PYqIS0_hxNWA&oe=6AF877A7"}, {"file_name": "openqr_metaquest_store_02_scanning.png", "id": "1631760518499501", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499308063_1631760521832834_262161603826586622_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rp6GhUkKUZQQ7kNvwG8Q_og&_nc_oc=AdpqtytvLErxaNrsjjtFXacePv_k8KbltNevjcpDCGvIInNnOg_W45G3ugzw2BTgN_0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS7vAsGodXdZzdf5ezzzb0Awr8HkJS8RGE-hpLFklIcsw&oe=6AF8A734"}, {"file_name": "openqr_metaquest_store_01_ready.png", "id": "3013682692357413", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499307352_3013682695690746_8019523881704477708_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BJsETj1UglIQ7kNvwH3buoI&_nc_oc=Adp2J_Be-MGkWR3qcP5Iaem9gaC7W8symdoKlv7wLFegi9jhwe25di4bZZ2UgLNjGBU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRXeuueyMCGfr0hXGsiM6G_BJHJHeZK8bjTj3PcE6L_CQ&oe=6AF89C55"}, {"file_name": "openqr_metaquest_store_04_opening_link.png", "id": "1252726940384790", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499310819_1252726943718123_8999351956007794998_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bY-hz49u7owQ7kNvwEjaQiU&_nc_oc=Adpc2H6NN-IH--in9QZdQ8GTLntsGO2B3LNM9rAL55fuIrY5IyQ8TunAM8ihZa9vCpY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSoFkslH0jQhhMWSw6PK0QmI02_LgIW_yGbBXiXwkdItA&oe=6AF8773C"}, {"file_name": "openqr_metaquest_store_03_camera_preview.png", "id": "1800116557897338", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499299093_1800116561230671_3349816583068448143_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iD3qNXRajhYQ7kNvwG5G3j8&_nc_oc=AdotwXxFB8cBDqEB48DB6YJXRj1SH6S-ezhXOpxENyQ1c22BkzXRPRGXRSYHCKCcAiU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ1kVoVnVXDvV9yBjRAVTIGpvQsH4QiIk4IlbFqcnXc6w&oe=6AF8A1EA"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "OpenQR", "keywords": ["scanner", "qr", "camera"], "long_description": "Typing a long web address with Quest controllers is slow. With OpenQR you look at the QR code instead: it reads the code through passthrough and opens it.\n\n- **Websites** open in your browser.\n- **YouTube links** play in YouTube VR, 360\u00b0 videos included.\n- **Meta Horizon Store links** go straight to the Store page.\n- **3D tours** like Matterport open in the browser, one tap from VR.\n\nWhen you close the app OpenQR opened, you're back at the scanner for the next code.\n\nFor developers: put your app's deep link (myapp://\u2026) in a QR code and OpenQR opens your app.\n\n### Your privacy\nOpenQR has no internet access of its own and no account, tracking or analytics. It reads camera frames on the headset to find the code, then throws them away. Nothing is saved or sent.\n\n### What it won't open\nOpenQR only opens web and app links. It blocks scripts, files and app-launch tricks. For Wi-Fi details, contacts or plain text, it shows what it found and doesn't open it.", "short_description": "QR code scanner"}]}, "developer_name": null, "developer_privacy_policy_url": "https://orgista.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Orgista", "support_website_url": "https://orgista.com/support", "website_url": "https://orgista.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "393222478507326"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_gra
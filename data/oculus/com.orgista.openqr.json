.com/v/t64.5771-25/499296027_2191619095068492_5698662351279385098_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3Zy8tIHzMNoQ7kNvwFo5F-l&_nc_oc=AdoN3roAsxWwyqW_mf2uzVDBaUYX43JIWVILXufdHluoiA6vZKKZWJoQPBZn44GopKA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQEN6FUchkIPu2OfvvqEDbqOG4XF4mjMrmvcrapk8AHgg&oe=6AF48327"}, {"file_name": "openqr_metaquest_store_02_scanning.png", "id": "1631760518499501", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499308063_1631760521832834_262161603826586622_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=msKlfkyTDMoQ7kNvwHrN-9P&_nc_oc=AdrRpJ7-ZEOmn6vhx6InlloaNJjDa1SgjhIJk5h7K12aOn-A9JFrlhdoB_LV4l87UD8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQjE61M3aziToYncIMHWqO2BZkbhQB0OM3RvUjX0WD9PA&oe=6AF47A74"}, {"file_name": "openqr_metaquest_store_01_ready.png", "id": "3013682692357413", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499307352_3013682695690746_8019523881704477708_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4Ld9QBm7U8cQ7kNvwG5rb_T&_nc_oc=Adon1ErWy11diBkujz8CnSVr4u6HLtIG-W5P6dU4yXnyjkKhoK2aDkK-WIdnqg-aWOo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQqaIYY7JpJSyLd7f62ZCOLgluKwVG_R-wOsUxNwpM-IA&oe=6AF46F95"}, {"file_name": "openqr_metaquest_store_04_opening_link.png", "id": "1252726940384790", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499310819_1252726943718123_8999351956007794998_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UsBNWiqVe-4Q7kNvwFE1biI&_nc_oc=Adp5cSlnn5N9dEHne4eYHzdwcLHuu-qfjwsejMHOze7oguIOIugPVJrFwR64H_L-eUA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR2GecRttC6s6UkwqT3v973qW1B0IAxYku1aQ2SUBLKtQ&oe=6AF482BC"}, {"file_name": "openqr_metaquest_store_03_camera_preview.png", "id": "1800116557897338", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499299093_1800116561230671_3349816583068448143_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kDQZNDGJFbUQ7kNvwEYgmzR&_nc_oc=AdqEUFfXCkzelhU5mhEid1Lvksw9myUYiilL2_kjOEKPIAUrBQ4nUS-KGl1Utudhccw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRmuaVCuXTYq7mRrTJBtRoOcxP79FhnyX0NRA4KXdLBgA&oe=6AF4752A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "OpenQR", "keywords": ["scanner", "qr", "camera"], "long_description": "Typing a long web address with Quest controllers is slow. With OpenQR you look at the QR code instead: it reads the code through passthrough and opens it.\n\n- **Websites** open in your browser.\n- **YouTube links** play in YouTube VR, 360\u00b0 videos included.\n- **Meta Horizon Store links** go straight to the Store page.\n- **3D tours** like Matterport open in the browser, one tap from VR.\n\nWhen you close the app OpenQR opened, you're back at the scanner for the next code.\n\nFor developers: put your app's deep link (myapp://\u2026) in a QR code and OpenQR opens your app.\n\n### Your privacy\nOpenQR has no internet access of its own and no account, tracking or analytics. It reads camera frames on the headset to find the code, then throws them away. Nothing is saved or sent.\n\n### What it won't open\nOpenQR only opens web and app links. It blocks scripts, files and app-launch tricks. For Wi-Fi details, contacts or plain text, it shows what it found and doesn't open it.", "short_description": "QR code scanner"}]}, "developer_name": null, "developer_privacy_policy_url": "https://orgista.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Orgista", "support_website_url": "https://orgista.com/support", "website_url": "https://orgista.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "393222478507326"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_gra
.com/v/t64.5771-25/499296027_2191619095068492_5698662351279385098_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XQfbbLQGDI8Q7kNvwEX8DLF&_nc_oc=AdpehOU1NaJvnCi9yAx-PBgZsOdEdRR79TpDo7RNz0--q9-hu-zkglyw32ecRFfbqa0&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOV1em7F8boriHXTFB_CWmdnfBDWgZKtq6CUoQuUtAJtA&oe=6AE35FA7"}, {"file_name": "openqr_metaquest_store_02_scanning.png", "id": "1631760518499501", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/499308063_1631760521832834_262161603826586622_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zRkHVX9h-JQQ7kNvwG8Nz9j&_nc_oc=Adr-B9zHLkSTQxFReOhROe_UYfzqQ9Z2EeqPhvE4d4jWxZXQybQTm2GYY_RcYnpoCt4&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN0R0zq_h_QV0fR3Th6EK9_D7GwUFzhhYUSfX5xq4Qn5A&oe=6AE356F4"}, {"file_name": "openqr_metaquest_store_01_ready.png", "id": "3013682692357413", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/499307352_3013682695690746_8019523881704477708_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m_r1ECmUN8EQ7kNvwED-9WY&_nc_oc=AdqIwu6A9Y5pL4UPKfyQOBHzbk0kWJnN1PazVEMARxIG9w_Uw5ffFq0NKpC_luMWaYk&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO_EBUjfkgSmQbWc2CFO8kYlhE78Hc4g9FRA2jfOIRlJQ&oe=6AE34C15"}, {"file_name": "openqr_metaquest_store_04_opening_link.png", "id": "1252726940384790", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499310819_1252726943718123_8999351956007794998_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y3gFFxlKmcIQ7kNvwFUj2eu&_nc_oc=AdqudH_u2MWTAZ2s2zQibhQCZRPVXNNobjC5pVzYB_aqOd5i8nBmbC28oe3cG728h8o&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO2T8z4kPo_mwHUTw_yhgjC1znIlbQke1KhwLRBEQs_Fw&oe=6AE35F3C"}, {"file_name": "openqr_metaquest_store_03_camera_preview.png", "id": "1800116557897338", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/499299093_1800116561230671_3349816583068448143_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BaLaIol47vkQ7kNvwFTsjdR&_nc_oc=AdrVlgyh5XKyAT0PO60FaHUSdksY1kwkhXTjz54raBKXUEzADm58kVZFsqCa53zIkRM&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPU6zzcFvg-fioIXKU053QZuAt04K65GOOf_nmnsvX5_Q&oe=6AE351AA"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "OpenQR", "keywords": ["scanner", "qr", "camera"], "long_description": "Typing a long web address with Quest controllers is slow. With OpenQR you look at the QR code instead: it reads the code through passthrough and opens it.\n\n- **Websites** open in your browser.\n- **YouTube links** play in YouTube VR, 360\u00b0 videos included.\n- **Meta Horizon Store links** go straight to the Store page.\n- **3D tours** like Matterport open in the browser, one tap from VR.\n\nWhen you close the app OpenQR opened, you're back at the scanner for the next code.\n\nFor developers: put your app's deep link (myapp://\u2026) in a QR code and OpenQR opens your app.\n\n### Your privacy\nOpenQR has no internet access of its own and no account, tracking or analytics. It reads camera frames on the headset to find the code, then throws them away. Nothing is saved or sent.\n\n### What it won't open\nOpenQR only opens web and app links. It blocks scripts, files and app-launch tricks. For Wi-Fi details, contacts or plain text, it shows what it found and doesn't open it.", "short_description": "QR code scanner"}]}, "developer_name": null, "developer_privacy_policy_url": "https://orgista.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Orgista", "support_website_url": "https://orgista.com/support", "website_url": "https://orgista.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "393222478507326"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_gra
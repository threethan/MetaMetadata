.com/v/t64.5771-25/499296027_2191619095068492_5698662351279385098_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BImMhAOIGGQQ7kNvwFbh3y1&_nc_oc=AdpEM1SaUfBemUGTwyQCymqnFB2Zs8YW-X873JYN-vWEI6cIsXHiL_EqZIEBkOJMGJs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRyAE2Vvg45hEoSLE4o0tMjcM9WGEwIqddiHuRz-_gZiQ&oe=6AEDEBA7"}, {"file_name": "openqr_metaquest_store_02_scanning.png", "id": "1631760518499501", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499308063_1631760521832834_262161603826586622_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AEQbFt1oAkwQ7kNvwE5NcHk&_nc_oc=Ado9WuRuMc_lsM8Tm077sV46vU2xI1IdRkBd2Z2jRdHdCZ3cWrI83gjFUlDwwnWFD0E&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRr3ReFfZNrNJ9-n5opKXf3guocOfU1TMwjrjpO9_B_5g&oe=6AEDE2F4"}, {"file_name": "openqr_metaquest_store_01_ready.png", "id": "3013682692357413", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499307352_3013682695690746_8019523881704477708_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IPKKUEId3yQQ7kNvwG8u4YR&_nc_oc=AdqtyKmcxPe6_27dwcLt0uTNnMWq6gxW3_oDEc5oObpQ6ZQuk4UuZxMGekNy66F_2VY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR6L2eVj30D8BAnxx0ZzGRSBn-ALoET2CQjJtUYbW_obg&oe=6AEDD815"}, {"file_name": "openqr_metaquest_store_04_opening_link.png", "id": "1252726940384790", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499310819_1252726943718123_8999351956007794998_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1_nvT7CRa58Q7kNvwEZPwYy&_nc_oc=AdoejsJBIiHK7OifrtKnFjCflE08y6ix6sIatkPwBMiTNb6o2FO52Fi5fe8Ch6swNkE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRx1p1AAe9XmSTh5ZmNmYVCaqCJY16rx72WeFdCu00-mw&oe=6AEDEB3C"}, {"file_name": "openqr_metaquest_store_03_camera_preview.png", "id": "1800116557897338", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499299093_1800116561230671_3349816583068448143_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-lbJFMjXexQQ7kNvwFEYmMw&_nc_oc=Adq2e5G-riml95z0cwL-CAzFaCcrIO8XVMPGtRkBBh3YKPzRIGdPy5uZTyU5dCF7lSM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR1qZUIeDFNV6gEgzdhyehV12kQcfBBp9puZE-HEoD7Sw&oe=6AEDDDAA"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "OpenQR", "keywords": ["scanner", "qr", "camera"], "long_description": "Typing a long web address with Quest controllers is slow. With OpenQR you look at the QR code instead: it reads the code through passthrough and opens it.\n\n- **Websites** open in your browser.\n- **YouTube links** play in YouTube VR, 360\u00b0 videos included.\n- **Meta Horizon Store links** go straight to the Store page.\n- **3D tours** like Matterport open in the browser, one tap from VR.\n\nWhen you close the app OpenQR opened, you're back at the scanner for the next code.\n\nFor developers: put your app's deep link (myapp://\u2026) in a QR code and OpenQR opens your app.\n\n### Your privacy\nOpenQR has no internet access of its own and no account, tracking or analytics. It reads camera frames on the headset to find the code, then throws them away. Nothing is saved or sent.\n\n### What it won't open\nOpenQR only opens web and app links. It blocks scripts, files and app-launch tricks. For Wi-Fi details, contacts or plain text, it shows what it found and doesn't open it.", "short_description": "QR code scanner"}]}, "developer_name": null, "developer_privacy_policy_url": "https://orgista.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Orgista", "support_website_url": "https://orgista.com/support", "website_url": "https://orgista.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "393222478507326"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_gra
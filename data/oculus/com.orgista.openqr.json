.com/v/t64.5771-25/499296027_2191619095068492_5698662351279385098_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3Zy8tIHzMNoQ7kNvwFGv_PL&_nc_oc=AdqFK1phwL45ZHK6B6xB-E7Ow7dx12gC7Xl5tXfOZ7qRX9V6GGb3rMCcQpEz7aL90xk&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSHE-JaBAOzruROBYqI75gCFBWwSTZEtS1oB7-JNH5ZBA&oe=6AF331A7"}, {"file_name": "openqr_metaquest_store_02_scanning.png", "id": "1631760518499501", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499308063_1631760521832834_262161603826586622_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=msKlfkyTDMoQ7kNvwEU6QWs&_nc_oc=Ado5NX-lzRHWXi7U2yUzsnV31X5qNhMQJEb0lYetB8RtJkYdiowoQkFE1XZP5nOW-u0&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS4ereVU4xfB-_b4HEaDRKWfgeBMo-8t1CfZNiKcTbSlw&oe=6AF328F4"}, {"file_name": "openqr_metaquest_store_01_ready.png", "id": "3013682692357413", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499307352_3013682695690746_8019523881704477708_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4Ld9QBm7U8cQ7kNvwF688yp&_nc_oc=Adp8x8wow_-oXt1z6PEZ8kcNdmbU9ahyiYH88B7WFFinbRC6RQspSu9fvytJQFENkko&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSJZSxUM2_XJLEWG9e1HkSTPPgKApE2TJSym29hHQsLNg&oe=6AF35655"}, {"file_name": "openqr_metaquest_store_04_opening_link.png", "id": "1252726940384790", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499310819_1252726943718123_8999351956007794998_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Kzx_hhtcxwYQ7kNvwF1uebr&_nc_oc=Ado6aqaAAkNJovPoLDbHaoTmoehBI3X2BfMKWx3uaIrDwU_Ll2EevoFNghjn6H4bTrc&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTR1SfGiN_bBH24mlsPtwptu6ZHFK52KwhDYv1PDedSjQ&oe=6AF3313C"}, {"file_name": "openqr_metaquest_store_03_camera_preview.png", "id": "1800116557897338", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499299093_1800116561230671_3349816583068448143_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kDQZNDGJFbUQ7kNvwFaYxLM&_nc_oc=Adp2Pnko6sgEA1J7R_G0aNZB5cgdEBhl_pECVQ66OkXxVkErqVArXIY0xlvzBh3ePf0&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRfzwacReR4B-5dN_bla_VkkNqcSncKDxH9OqvP1c1O0g&oe=6AF35BEA"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "OpenQR", "keywords": ["scanner", "qr", "camera"], "long_description": "Typing a long web address with Quest controllers is slow. With OpenQR you look at the QR code instead: it reads the code through passthrough and opens it.\n\n- **Websites** open in your browser.\n- **YouTube links** play in YouTube VR, 360\u00b0 videos included.\n- **Meta Horizon Store links** go straight to the Store page.\n- **3D tours** like Matterport open in the browser, one tap from VR.\n\nWhen you close the app OpenQR opened, you're back at the scanner for the next code.\n\nFor developers: put your app's deep link (myapp://\u2026) in a QR code and OpenQR opens your app.\n\n### Your privacy\nOpenQR has no internet access of its own and no account, tracking or analytics. It reads camera frames on the headset to find the code, then throws them away. Nothing is saved or sent.\n\n### What it won't open\nOpenQR only opens web and app links. It blocks scripts, files and app-launch tricks. For Wi-Fi details, contacts or plain text, it shows what it found and doesn't open it.", "short_description": "QR code scanner"}]}, "developer_name": null, "developer_privacy_policy_url": "https://orgista.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Orgista", "support_website_url": "https://orgista.com/support", "website_url": "https://orgista.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "393222478507326"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_gra
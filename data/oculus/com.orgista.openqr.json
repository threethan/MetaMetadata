.com/v/t64.5771-25/499296027_2191619095068492_5698662351279385098_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Quf2kBOBeOYQ7kNvwFehEAT&_nc_oc=AdqLHzYkru8Ywl09sWyajV5BfhZQyIO64L-vUXCf_loGh2Ho_euo0FeBKE5fXI7CZUk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTLGWaGKyjeOWMPPDx_yLqi2ksmzd0yKqlu-E6A5FJ81A&oe=6AF72627"}, {"file_name": "openqr_metaquest_store_02_scanning.png", "id": "1631760518499501", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499308063_1631760521832834_262161603826586622_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rp6GhUkKUZQQ7kNvwF7zsf9&_nc_oc=Adpp51MH2oBCr0WFUbxxq5pXYMlxE2rqUrP-wVBFGmE1GyhuSvQg_KzULobdrxnA-9g&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR1Ur6jxg_3MJb7FceM7Th9XlQYLc9txtVzs0jBiOILoA&oe=6AF71D74"}, {"file_name": "openqr_metaquest_store_01_ready.png", "id": "3013682692357413", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499307352_3013682695690746_8019523881704477708_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BJsETj1UglIQ7kNvwFpt44A&_nc_oc=AdqoOOulgn_wfs5Wp8SGFnypHGq9wpBKXMOC9ZYBRJJ5mzfDE_adR8fRz7K5NXBFM_I&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRWZcJpKNBGi931mJDA-jyv9BJrEDB9WSoPUBqXBqy9Iw&oe=6AF74AD5"}, {"file_name": "openqr_metaquest_store_04_opening_link.png", "id": "1252726940384790", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499310819_1252726943718123_8999351956007794998_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UsBNWiqVe-4Q7kNvwF_gnpj&_nc_oc=AdqX8B2WtAheiVsaCoy-jIBMriePDAYXsN5b3UsErRBn_zCliWDYnG3bCmny3TemyQ4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT4sv2CP8bkvvmm_gc1jVkzVSo3T5VWyEzTHk3bVqcWXw&oe=6AF725BC"}, {"file_name": "openqr_metaquest_store_03_camera_preview.png", "id": "1800116557897338", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499299093_1800116561230671_3349816583068448143_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iD3qNXRajhYQ7kNvwGXsF-_&_nc_oc=AdqRSKPLfvXu9RlKnT9NqVfE1DfH7WW4ar2kkSw5YJWy3IYXH_FKU3J8VRVcU3UjhFc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSTVBCYz4WRt5pyN23-2Jtl-eONI66DGHwX2SK7hRN7Kg&oe=6AF7182A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "OpenQR", "keywords": ["scanner", "qr", "camera"], "long_description": "Typing a long web address with Quest controllers is slow. With OpenQR you look at the QR code instead: it reads the code through passthrough and opens it.\n\n- **Websites** open in your browser.\n- **YouTube links** play in YouTube VR, 360\u00b0 videos included.\n- **Meta Horizon Store links** go straight to the Store page.\n- **3D tours** like Matterport open in the browser, one tap from VR.\n\nWhen you close the app OpenQR opened, you're back at the scanner for the next code.\n\nFor developers: put your app's deep link (myapp://\u2026) in a QR code and OpenQR opens your app.\n\n### Your privacy\nOpenQR has no internet access of its own and no account, tracking or analytics. It reads camera frames on the headset to find the code, then throws them away. Nothing is saved or sent.\n\n### What it won't open\nOpenQR only opens web and app links. It blocks scripts, files and app-launch tricks. For Wi-Fi details, contacts or plain text, it shows what it found and doesn't open it.", "short_description": "QR code scanner"}]}, "developer_name": null, "developer_privacy_policy_url": "https://orgista.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Orgista", "support_website_url": "https://orgista.com/support", "website_url": "https://orgista.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "393222478507326"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_gra
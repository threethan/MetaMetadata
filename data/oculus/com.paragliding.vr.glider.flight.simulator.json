_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSSoe0NjEMOuEwI-KQS-MSVPdAMH8j5xxH22NlRvySbRQ&oe=6AF48EE2"}, {"file_name": "SS5.png", "id": "2326002208135460", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/604347072_2326002211468793_8664187445377913303_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0A9YEiQ23o0Q7kNvwEo7jBR&_nc_oc=AdqjvzPBrR4YRlVq65rbzQBIy3pXLNsIPiK3abEi78f4FehHlDiDOM_uDthyiTTsLgI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRvzuESxKD4L9GtKVKywOkwU5JHeFDX8a5Npr6dqRRgSw&oe=6AF482A5"}, {"file_name": "SS4.png", "id": "2167005647182352", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491830576_2167005650515685_2340323408131002516_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tVdkwleHeL0Q7kNvwGmnyS-&_nc_oc=Adr91lls9wbDdYIJupTRmKhs4PcNr6pQng0bgnerbVflE0o4rLqOPdB7F5Sw0Pc-9fc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRSnbAO5TmzD2fDaEsQcFTHReTU-2WSgm2AI5uKPGojxg&oe=6AF47DCD"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Paragliding VR: Glider Flight Simulator", "keywords": ["Paragliding", "Gliding", "Flying", "Skydiving", "Parachute"], "long_description": "Take the leap in Paragliding VR: Glider Flight Simulator, an immersive VR flying experience built around the thrill of cliff jumping, gliding through the open sky, and landing safely below.\n\nStep to the edge, jump from the cliff, grab your controls, and guide your paraglider through the air. Steer left and right, adjust your flight path, enjoy the height and scenery, and aim for the perfect landing.\n\nExplore three unique environments, each offering a different atmosphere and breathtaking views as you soar above the landscape.\n\nWhether you enjoy paragliding, gliding, flying, cliff jumping, or VR flight simulator games, this experience delivers simple controls and an exciting feeling of aerial freedom.\n\nFeatures\n\n\u2022 Immersive VR paragliding gameplay\n\u2022 Jump from high cliffs and glide through the sky\n\u2022 Simple and intuitive glider controls\n\u2022 Three different environments to explore\n\u2022 Aim and prepare for smooth landings\n\u2022 Beautiful aerial views and a strong sense of height\n\u2022 Relaxing yet exciting VR flying experience\n\u2022 Designed for fans of paragliding, gliding and flight simulation", "short_description": "Jump from breathtaking cliffs, control your paraglider, glide through the sky, and master smooth landings across three beautiful environments in this immersive VR glider flight experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://hasanswy.wixsite.com/emberpeak", "developer_terms_of_service_url": null, "publisher_name": "Ember Peak", "support_website_url": null, "website_url": "https://hasanswy.wixsite.com/emberpeak", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1317413781460991"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491823837_947032835118484_5821692567903484982_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mjYpFwh4Yn8Q7kNvwFSG-kl&_nc_oc=AdqJt9MYOe8a4iWfLT0P6WDMmA8c_AfP7Ii39U9NTJMvWcbHHLI0sobt68K_18aDrZc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTR6STFGA16viBeAbJNRubtg1vBJP_nWaZ8pI_BdiWb7Q&oe=6AF4712E"}, "is_concept": false, "is_
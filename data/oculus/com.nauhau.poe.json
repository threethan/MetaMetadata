KQpfu0D2P8KGzuVA&oe=6ADE26D3"}, {"file_name": "scree_0000_Tonwertkorrektur-1-Kopie.png", "id": "924042063903022", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491823905_924042067236355_1008182681619650678_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A3roqQxh90IQ7kNvwEASo0v&_nc_oc=AdqzkmGqggso1qHq8wJ3hs9OTVAzilMia5NW5DOGuZCZPFddAbmotO6Uir4KLI88MVI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMGzIi4TExYqK8nxVERR_RfNy9dkqge9fFdpaQRBhM-GQ&oe=6ADE00A8"}, {"file_name": "scree_0002_Tonwertkorrektur-1-Kopie-3.png", "id": "2179195259640783", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491823279_2179195266307449_5513267349714068693_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6dcD_6ORNdMQ7kNvwHYqZD7&_nc_oc=AdpMfIUduCoitrzVvlZ1Rz1ESM2g4SvWvj1_UfOr214qD5e1jr9wyHyooM6hEGX2Wv8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOKomqcslv6DZVgPmO99sNxAM49z46PVg24bW0e62sTpg&oe=6ADE1807"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "The Raven", "keywords": ["school", "literature", "horror", "mystery", "classic"], "long_description": "Step inside the mind of a literary legend.\n\n\"The Raven\" invites students and literature enthusiasts into a hauntingly beautiful 180\u00b0 stereoscopic VR experience. Witness Edgar Allan Poe in his abandoned mansion, tormented by the loss of his wife and teetering on the edge of madness.\n\nA New Way to Teach Classics Designed as a powerful educational tool, this app transforms the traditional reading experience into a visceral event. Students don\u2019t just read the poem; they live it. By combining the original, unabridged text with immersive storytelling, we make classic literature accessible, engaging, and unforgettable for the modern classroom.\n\nKey Features:\n\nWorld-Class Performance: Featuring the powerful baritone voice of opera singer Ronan Collett. His haunting delivery captures the rhythm, rhyme, and desperation of Poe\u2019s most famous work.\n\nOriginal Visual Interpretation: Beyond a simple reading, this experience utilizes surprising \"cosmic horror\" visualizations to illustrate the narrator's fracturing psyche. Is the Raven real, or a manifestation of his grief?\n\nImmersive Atmosphere: Watch Poe play the piano in stereo 3D as he battles his demons. The 180\u00b0 format places the viewer directly in the room, creating an intimate connection with the protagonist.\n", "short_description": "Experience Edgar Allan Poe\u2019s masterpiece like never before. A 180\u00b0 stereoscopic performance featuring opera baritone Ronan Collett. The ultimate immersive literature tool for the classroom."}]}, "developer_name": null, "developer_privacy_policy_url": "https://nau-hau.com/privacy-policy-nau-hau-showrooms", "developer_terms_of_service_url": null, "publisher_name": "NAU-HAU GmbH", "support_website_url": null, "website_url": "https://www.nau-hau.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}, {"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "29272882255636705"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491824322_935858962635107_3713920725296168498_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OUESCLPEM08Q7kNvwF1EOQz&_nc_oc=Adpbat7Y5fCXu4IvxCSh-qHVx83nLsqO1VYmPtM4xLon9hTXZKWvBb87NGbVHGr-jIo&_nc_zt=3&_nc_ht
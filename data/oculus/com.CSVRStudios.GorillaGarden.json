eo_trailer": null, "video_trailer_thumbnail": null, "display_name": "Growilla Garden", "keywords": [], "long_description": "In this unique gardening adventure, you'll start with a humble plot and a dream: to create the most magnificent garden paradise this side of the jungle. Plant seeds, nurture a vibrant collection of flora, and watch your hard work blossom into a thriving oasis. But it's not just about pretty plants; it's about profit! Harvest your crops, sell them for a tidy sum, and use your earnings to expand your garden, unlock exotic new plants, and discover secret tools to accelerate your growth.", "short_description": "Grow your way into paradise in Growilla Garden! Plant seeds, nurture unique plants, and watch your garden come to life as you earn cash and... maybe\u2026 acquire some \"borrowed\" treasures. Upgrade your crops, expand your plot, and create the best garden. Explore the world, meet up with friends!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/csvrstudios/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "CSVRStudios", "support_website_url": null, "website_url": "https://sites.google.com/view/csvrstudios/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "MULTI_USER"], "id": "31004676932509528"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "P
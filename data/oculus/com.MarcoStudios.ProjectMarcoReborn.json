bnail": null, "display_name": "Project Marco Reborn", "keywords": [], "long_description": "This is a fun and exciting Gorilla Tag fan game where you and your friends can run, jump, and climb your way through all kinds of crazy environments! With intuitive movement mechanics, you\u2019ll feel like a real gorilla as you swing through the world, play different game modes, and just have a great time with others. Whether you're chasing your friends in a fast-paced game of tag or just exploring and messing around, there\u2019s always something fun to do. If you love Gorilla Tag, you\u2019ll definitely enjoy this!", "short_description": "A fun gorilla tag fan game where you can have fun with your friends! Also this is not the same as Project Marco/H1unter"}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1ZFZg29s65rMhfEfsN1q4fwxS-o_Zebeos7Zhd9Cdyv0/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Marco", "support_website_url": null, "website_url": "https://sites.google.com/view/project-marco-reborn/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9986601371455783"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499335442_9691664204295357_8914968298254309517_n.png?stp=dst-png_s360x360&_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=atuWf
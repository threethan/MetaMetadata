1", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499318642_9963651883718214_8411071481427615941_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dGzXWj31hsEQ7kNvwGHYe-q&_nc_oc=AdrasXPemEiu5JoXOkqS9r5-IRovAbxVEuiwwKnK8_Dwn9ASPOh7nstzY8OxLan_XM0&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0Tu-x5NFJWiqCO3gzZBSnztYNf7463d0VtwW3WrqVRPQ&oe=69F1FE74"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Project Marco Reborn", "keywords": [], "long_description": "This is a fun and exciting Gorilla Tag fan game where you and your friends can run, jump, and climb your way through all kinds of crazy environments! With intuitive movement mechanics, you\u2019ll feel like a real gorilla as you swing through the world, play different game modes, and just have a great time with others. Whether you're chasing your friends in a fast-paced game of tag or just exploring and messing around, there\u2019s always something fun to do. If you love Gorilla Tag, you\u2019ll definitely enjoy this!", "short_description": "A fun gorilla tag fan game where you can have fun with your friends! Also this is not the same as Project Marco/H1unter"}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1ZFZg29s65rMhfEfsN1q4fwxS-o_Zebeos7Zhd9Cdyv0/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Marco", "support_website_url": null, "website_url": "https://sites.google.com/view/project-marco-reborn/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "su
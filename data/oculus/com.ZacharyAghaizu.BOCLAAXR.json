42985", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491819281_1129536482376318_889329453674954414_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hfWquzi7WWcQ7kNvwFvKoyD&_nc_oc=AdrEX5dIh63QJiQpWvyzI5ikLV4lmwkrw1vaWwG43TA9oBSdo1cmju45lkfrDenk0Zc&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4_quvk5dovQvVNWMLIrY12guO27ot0zxPNXm7iNI4iBw&oe=6A14682E"}, {"file_name": "BOCLAAXR_SCREENSHOT_6.png", "id": "1875762486628215", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491824671_1875762489961548_2238575366893791072_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AvyvpvBBdbMQ7kNvwFhrhtA&_nc_oc=AdocHv66yoUEm2AV0L2xABNjD56XEiID7LrIofq27rngnqDL5hV3JiUrHXgILmfHz04&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6ZeShOEQJmdW0ay6zPhVtwpdrgVhp-Vhtb2Mz_t8ycPw&oe=6A1447CB"}, {"file_name": "BOCLAAXR_SCREENSHOT_11.png", "id": "1482981623000487", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491823746_1482981626333820_779126953593279730_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=09_CcpX752EQ7kNvwG20xtG&_nc_oc=Adp7E-8Ql2k3Nh7XhvMihbR5k91BRdgw6WzCa-L3CuzEZhs6ULs8ereoQlU5zeeDBfI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5qIwJiaJqfo2FK06xlFucfCfdOWwemhPreuRisXk4IfA&oe=6A147213"}, {"file_name": "BOCLAAXR_SCREENSHOT_19.png", "id": "4325378117705600", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491820887_4325378124372266_8577150763181365989_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L7qUfdnUkc4Q7kNvwF1rOrC&_nc_oc=AdpmrfdMXpvYtc3CnIPsmCj4e3AwhSjm42gtih5gczde5bLaO1nPmVWQczxbrfucrAM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6TjADGNpQpREqyXKDaudoxjg-O_jexaIiRsmzHU52E4w&oe=6A14408E"}, {"file_name": "BOCLAAXR_SCREENSHOT_20.png", "id": "1243362311173224", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491819934_1243362314506557_3561223490589410822_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Aiap90RrtDoQ7kNvwEkVctp&_nc_oc=AdrRZeix-XeNc55S1uml7MBGE3wQJquZM4AmeYS3DHuD5d6lGPsXxLltmFcG2raj8Wg&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7Zy63ecynb8Je6YM3oCQS0Q8bua5brh4LNohcCo-86sA&oe=6A1449CC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BOCLAAXR VIDEO COVER IMAGE.png", "id": "1382531620172776", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491818890_1382531623506109_2520221483317255496_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c2IO8RfPuMcQ7kNvwHjJAEQ&_nc_oc=AdomabafOrObU74VfeZTvUzDLFEFXEB01VVyVIWZCW7YOJIZx0MQh7zwxCG_jl-qAhI&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6Sc55gjWSgP4ry8DFa9ihrzQFIACTQFdaFVVboE8I1Gg&oe=6A145448"}, "display_name": "BOCLAAXR", "keywords": ["music", "multiplayer", "synth", "rhythm", "creative"], "long_description": "Step into an immersive creative space where you can draw and paint music around you, turning sound into vivid visuals that fill the room. Build ideas on the spot using expressive live looping, sampling, and layering tools that let you create full tracks in real time. Shape your music with high-quality samplers, loopers, recorders, and synthesizers, or connect wirelessly to your DAW for deeper production. Join others in a shared multiplayer studio\u2014complete with a collaborative stage\u2014where musicians can jam, perform, and develop ideas together instantly. Whether you\u2019re sketching rhythms or crafting full songs, this app offers a fresh, intuitive, and inspiring way to make music in mixed reality and VR.\n\n\u2e3b\n\nUpdated Feature List:\n\t\u2022\tDraw and paint music as immersive sound visuals in 3D space\n\t\u2022\tPowerful live looping for instant real-time creation\n\t\u2022\tHigh-quality samplers, loopers, recorders, and synthesizers\n\t\u2022\tSampling, layering, and sound-design tools\n\t\u2022\tWireless MIDI / DAW integration\n\t\u2022\tShared multiplayer studio with a collaborative stage\n\t\u2022\tWorks in both Mixed Reality and full VR\n\t\u2022\tComplete creative toolkit included with your purchase", "short_description": "Unlock your creative power with this immersive music-making and visual app for Meta Quest. Draw sounds, interact to create music, live-loop, sample, and produce with high-quality samplers, recorders, synthesizers, and wireless MIDI/DAW integration. Collaborate in real-time multiplayer and create in both Mixed Reality and VR. A one-time purchase gives you the full, intuitive toolkit to bring your ideas to life."}]}, "developer_name": null, "developer_privacy_policy_url": "https://zacharyaghaizu.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Zachary Aghaizu", "support_website_url": "https://zacharyaghaizu.com/boclaaxr", "website_url": "https://www.zacharyaghaizu.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}, {"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER", "CO_OP"], "id": "25446095044999487"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1574768750390873"}]}, "baseline_offer": {"id": "1574768750390873"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1767174120, "status": "PUBLISHED", "id": "1574768750390873"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "26642198508722462", "version": "1.1.1"}, "i
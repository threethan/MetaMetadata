_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "24817941527814845", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "26642198508722462"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1290884112346927"}]}, "change_log": "-UI Improvements\n-Pitch Shift Fix\n-New Side-chain bounce toggle option for Synth and Midi mode\n-Quantize Subdivisions option fix + extension from 1/1 - 1/32", "created_date": 1773244205, "id": "26191774090431575", "version": "1.0.8", "version_code": 10, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "24817941527814845", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "26642198508722462"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1290884112346927"}]}, "change_log": "-The hide loop ui accidentally triggers muting \n- Previous colour not working for hand edit\n-  Bring material option in", "created_date": 1770389197, "id": "25878731071735880", "version": "1.0.7", "version_code": 9, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "24817941527814845", "is_concept": false, "latest_released_bi
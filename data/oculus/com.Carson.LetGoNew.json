32261_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EOFaXrHBTysQ7kNvwGg5v_K&_nc_oc=AdpW7wFShyqnXF9VbapOLGhqSRoilgNWsvHcA9bRGOJIY1ZBkeB0lC2nLg0HNJVeoNc&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJRkfkuTNRHGHxj-6VlsKwX5RfbMFqJ-4JmKMUJHRnQ4g&oe=6A9FFF57"}, {"file_name": "ScreenShot5.png", "id": "2991226437742703", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499305194_2991226441076036_1447357281608301735_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TpOakTbXvHAQ7kNvwHgj-8o&_nc_oc=Adq6RPvozdyDgFC1zJotrsNbz_hSOyemv2twGGo1qgy-7lXkAOxy77bsVG8dXj_Aoqc&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ7Jhwd01LWsvLQkUeHvjwcZfgo3kpWvKd-Wfk0UDDl8g&oe=6A9FFABD"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Let Go", "keywords": [], "long_description": "You are trapped in a floating world woven from obsession and shackles.\nEvery platform here is a past you cannot let go, a fear you dare not face, or a self-imposed constraint you cling to tightly.\nYou do not need to fight. You do not need to save the world.\nYou only need to leap forward.\nEvery jump is an act of letting go;\nEvery landing is a moment of liberation.\nLeap higher, move forward, until you reach that light\u2014weightless and unbound.\nWhen you stand at the end, you will understand:\nThe meaning of this journey was never about the arrival,\nBut about finally learning to Let Go.", "short_description": "Break free from reality and run wild in the virtual world!"}, {"images": {"nodes": []}, "id": "1439567424036438", "locale": "ja_JP", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Let Go", "keywords": [], "long_description": "\u3042\u306a\u305f\u306f\u57f7\u5ff5\u3068\u8db3\u304b\u305b\u3067\u7de8\u307e\u308c\u305f\u6d6e\u904a\u4e16\u754c\u306b\u9589\u3058\u8fbc\u3081\u3089\u308c\u3066\u3044\u307e\u3059\u3002\n\u3053\u3053\u306b\u3042\u308b\u3059\u3079\u3066\u306e\u30d7\u30e9\u30c3\u
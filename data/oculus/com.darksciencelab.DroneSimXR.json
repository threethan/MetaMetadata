{"data": {"node": {"__typename": "Application", "id": "23919242984379524", "organization": {"id": "945044232025807", "viewer_permissions": [], "application_groupings": {"nodes": [{"viewer_has_update_access": false, "full_applications": {"nodes": [{"id": "23919242984379524"}]}, "id": "1741677846417074"}]}}, "firstRevision": {"nodes": [{"application": {"id": "23919242984379524", "release_date": 1759327200, "is_concept": false, "platform": "ANDROID_6DOF", "scheduled_offers": {"count": 1}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "27026398203663971"}, "id": "2150641398788650"}]}}, "binary": null, "live_binary": null, "created_date": 1772667525, "id": "26457587867211677", "is_initial_release": false, "name_with_fallback": "v4", "pdp_metadata_with_fallback": {"version": 3, "application": {"is_concept": false, "latest_released_pdp_metadata": {"id": "25529061320064341"}, "release_status": "RELEASED", "id": "23919242984379524"}, "id": "25529061320064341", "release_status": "RELEASED", "status": "APPROVED"}, "release_date": null, "administration_status": "APPROVED", "is_first": false, "release_status": "PENDING", "release_type": "SCHEDULED", "pdp_metadata": null, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491821799_1198565642136912_109314430738451856_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IH6_v-xiu9kQ7kNvwHClhFs&_nc_oc=Adqp5Gn94uJpUp3326VCeoRoXIgi8rC9Vi4NqeA66ow0GSdpZphYEaaHHqaBfFhQDlM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4w9GRv3HiulaFTpcqEEyd07GCqsFtmeeDYth1awzoRCA&oe=6A072839"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Drone Sim XR", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Simulation", "id": "331529188132278"}, {"topic_name": "Adventure", "id": "2691890164460465"}], "release_date": 1759327200, "lastRevision": {"nodes": [{"id": "23919243037712852", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "23919242984379524", "is_first_party": false, "enables_in_app_ads": false, "is_concept": false, "platform": "ANDROID_6DOF"}, "iarc_cert": {"id": "1765304410798275"}, "iarc_email": null, "msrp": null, "translations": {"nodes": [{"images": {"nodes": []}, "id": "1891609931604972", "locale": "de_DE", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Drone Sim XR", "keywords": ["fpvDrohne", "droneSimulator", "metaQuest3Passthrough", "vrDrohnenRennen", "Quadrocopter"], "long_description": "Drone Sim XR ist ein spannender Drohnen-Simulator in gemischter Realit\u00e4t, der den Komfort deines Zimmers mit dem Abenteuergeist malerischer Orte verbindet.\n\nSteuere deine Drohne und genie\u00dfe den Flug sowohl aus der Third-Person-Perspektive als auch aus der immersiven First-Person-Sicht \u2014 sieh dich selbst und deine Umgebung durch die Kamera der Drohne.\n\nFliege durch ein Fenster oder eine T\u00fcr hinaus und erkunde f\u00fcnf atmosph\u00e4rische Umgebungen: \ud83c\udfdd\ufe0f Insel \u2022 \ud83c\udf32 Wald \u2022 \ud83c\udf38 Japan \u2022 \ud83c\udfdc\ufe0f \u00c4gypten \u2022 \u2744\ufe0f Winter\n\nDank der Meta Quest 3 Passthrough-Technologie siehst du die Drohne direkt in deinem echten Raum \u2013 fast wie im echten Leben. Verfolge den Flug \u00fcber ein virtuelles Display oder setze eine virtuelle FPV-Brille auf f\u00fcr vollst\u00e4ndiges Eintauchen.\n\n- Volle Mixed Reality-Integration mit Passthrough\n- 5 stimmungsvolle Umgebungen au\u00dferhalb deines Raums\n- 2 realistische Steuerungsmodi f\u00fcr Drohnen\n- Virtuelles FPV-Display und Brille\n- Unterst\u00fctzung f\u00fcr Controller, Gamepad (f\u00fcr jetzt nur PS) und Handtracking\n- Perfekt f\u00fcr Fans von VR-Drohnenrennen\n\nWillkommen bei Drone Sim XR \u2013 dem Drohnensimulator mit voller Mixed-Reality-Unterst\u00fctzung f\u00fcr Meta Quest 3 Ger\u00e4te!", "short_description": "Drone Sim XR ist ein spannender Drohnen-Simulator in gemischter Realit\u00e4t, der den Komfort deines Zimmers mit dem Abenteuergeist malerischer Orte verbindet."}, {"images": {"nodes": [{"file_name": "1008_1440.png", "id": "1380424686411364", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499310682_1380424689744697_8455901659714622460_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ovbke5WrOSQQ7kNvwF_BAZg&_nc_oc=Adrupd-6XldVLwXX50Fhd5wMArfwkBexvesdobtBUQsIg6AbkdNdQB0OmZovYjvMGrU&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af44QEytag4Mi7ZJotP9XGuEpDFMZ0glAKKvUfDTScMM0w&oe=6A071CC3"}, {"file_name": "DroneSimXR_1024_1024_transperent.png", "id": "1340265160367150", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499307963_1340265167033816_4324286363793501405_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ujBfo9otfzIQ7kNvwGShO59&_nc_oc=AdpFN9e07gaJIuI-_iAdrophLU2ctRVRDWJ6upiZI69w6QC-emc7XdbC1H6HWpftsnI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4njsqrgt0N0K27o4T5cdhIlL91FQrJTomyKxDMbEQQ8A&oe=6A073C63"}, {"file_name": "1440_1440.png", "id": "1265178371950970", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499303222_1265178375284303_490385031383838418_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1URL7X_vP7MQ7kNvwFF78st&_nc_oc=AdrPmbfQOxIH1YmtLwGGam8c02BjNxyK9CmZY3qdu5IcPulQhETN5NAaPUv7hQQcXKk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7Ln1cxx2tysDF7aPAFl2ubb6nca8Rfu2ZsD0lqcGvNMw&oe=6A0728DA"}, {"file_name": "512x512.png", "id": "1115371883794950", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499303981_1115371887128283_435171528240854825_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b7OiKPjnvnEQ7kNvwF7zp8R&_nc_oc=AdqVSMj1rZD4uQLBkUmZZYQKBv7-NxeGtSQGDVsBbqCmTBJaJWIPz91I7z4tC4mUwfc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6iUeDQgU5Pwuat7wSvAFeLeaulTXwiCMlXrwY7vn3b5A&oe=6A071816"}, {"file_name": "2560_1440_albom.png", "id": "1002269935441644", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499300498_1002269942108310_7408565824570369633_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Qr9qMdy5eiwQ7kNvwHuzGfc&_nc_oc=Adpk5quCTcti6fYkV365fbJPgZ2ej72EfeRa-RFJXOqAnWmICIxNRewVv9VbISf3wqA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5t-3cnF9qTizv_EC7xibXcPGq0r1N0znIGK7byzmYCnw&oe=6A07267C"}, {"file_name": "3000_900.png", "id": "721144580596794", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499305432_721144583930127_8956924811536760252_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZhQKnEsXV8IQ7kNvwGnjM3P&_nc_oc=AdqN7YODpBNDtQs-7D_046H8gbtKiz-FlzX8sjpPQLAioelt75eIWgwdneFv_M_PoK8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6BNNfqP3_-_L0snX1styPtAtIVES2Cq8F5f3UqmzYRWw&oe=6A0742A2"}]}, "id": "1715362066041628", "locale": "en_US", "screenshots": [{"file_name": "2560_1440_Screen_1imgs_4.png", "id": "1816048092629096", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491827725_1816048095962429_95169351532975447_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Bf3LPAB-exYQ7kNvwFhfHuX&_nc_oc=AdqyDLz-CV5YNi_GrcYg79dmFxQFxGSPgF-bR_rkfo3k0zaCaL81wJTuPFpjWG-m5Sw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5N_FMUlneHe_6t_xcBLYqFmw5yXrqzeAY8Cm51Wo4-7w&oe=6A0715CD"}, {"file_name": "2560_1440_Screen_1imgs_2.png", "id": "2843240842553886", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491825050_2843240849220552_6554436694829226423_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O4dHQa_chhoQ7kNvwFDCbNM&_nc_oc=AdphvlNclpkBD_quJgxk7fLctnPHfTE8Ams25NJbHtIT-jgHAV-5iozNlK7g6kF4MjU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4jiGZIX0eHdRKGlhIrwjrD4911rWJVEChBPjFxW8M-9w&oe=6A073142"}, {"file_name": "2560_1440_Screen_1imgs_1.png", "id": "575968435480340", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491819476_575968438813673_3394773491825149518_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F6uEwWZ1l4MQ7kNvwGgxZSu&_nc_oc=Adrx0ENmGB2x3cfBpWA5xdiLJPCMNqR2HoxjDDa779F66KneOgRlp7dEaforMiPDF9A&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4W_AYlsacFwNcTwBWpdNUcAYCWqx3N3CtPzswL43Nyaw&oe=6A0743E0"}, {"file_name": "2560_1440_Screen_1imgs_5.png", "id": "4281899142086819", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491830460_4281899145420152_7358136303343778754_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z9Z2j4y82BYQ7kNvwG_2qNn&_nc_oc=AdoLUMcQsg95p3yLZ_JM3fTQc3aShwi1eeEIwwP-Cc8Y4tWC0hjlJqb6T26kPCLLl04&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7jh5NPu3q8z9WXFJWlC6WIdQOvO2YYQ1_R1K2jmwWiFA&oe=6A072408"}, {"file_name": "2560_1440_Screen_1imgs_3.png", "id": "1472604424175402", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491830460_1472604427508735_91677171034992708_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BmtJL2F7Cs0Q7kNvwGCKcFq&_nc_oc=AdpK3SoIGzn8deuO47kVEI5YS-eDtXAQCJo_m5ip-yh_pCd_Fesg2JCOKDAumTSMQ-g&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af730Wtlmllt_mkh0QucyIgutDy04_LGdHMerJ0YS5rPTA&oe=6A072D8C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Drone Sim XR", "keywords": ["dronesimulator", "fpvdrone", "metaquest3passthrough", "vrdroneracing", "quadcopter"], "long_description": "Drone Sim XR is an exciting drone simulator in mixed reality, combining the comfort of your room with the spirit of adventure in picturesque locations.\n\nControl a drone and enjoy the flight from both third-person and immersive first-person views \u2014 seeing yourself and your surroundings from the drone\u2019s onboard camera.\n\nFly out the window or door and explore five beautiful, atmospheric environments: \ud83c\udfdd\ufe0f Island \u2022 \ud83c\udf32 Forest \u2022 \ud83c\udf38 Japan \u2022 \ud83c\udfdc\ufe0f Egypt \u2022 \u2744\ufe0f Winter\n\nThanks to Meta Quest 3 passthrough technology, you can see the drone flying right in your real room \u2014 just like in real life. Watch the flight on a virtual screen or put on virtual FPV goggles for full immersion.\n\n- Full mixed reality integration with passthrough support\n- 5 scenic environments beyond your room\n- 2 realistic drone control modes\n- Virtual FPV display and goggles\n- Support for controllers, gamepad (for now only PS), and hand tracking\n- Ideal for VR drone racing fans\n\nWelcome to Drone Sim XR \u2014 the drone simulator with full mixed reality support for Meta Quest 3 devices!", "short_description": "Drone Sim XR is an exciting drone simulator in mixed reality, combining the comfort of your room with the spirit of adventure in picturesque locations.\n\n"}, {"images": {"nodes": []}, "id": "685401207417023", "locale": "ru_RU", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Drone Sim XR", "keywords": ["\u0414\u0440\u043e\u043d", "FPV", "Passthrough", "\u0414\u0440\u043e\u043d\u0440\u0435\u0439\u0441\u0438\u043d\u0433", "\u041a\u0432\u0430\u0434\u0440\u043e\u043a\u043e\u043f\u0442\u0435\u0440"], "long_description": "Drone Sim XR \u2014 \u0437\u0430\u0445\u0432\u0430\u0442\u044b\u0432\u0430\u044e\u0449\u0438\u0439 \u0441\u0438\u043c\u0443\u043b\u044f\u0442\u043e\u0440 \u0434\u0440\u043e\u043d\u0430 \u0432 \u0441\u043c\u0435\u0448\u0430\u043d\u043d\u043e\u0439 \u0440\u0435\u0430\u043b\u044c\u043d\u043e\u0441\u0442\u0438, \u0441\u043e\u0432\u043c\u0435\u0449\u0430\u044e\u0449\u0438\u0439 \u043e\u0434\u043d\u043e\u0432\u0440\u0435\u043c\u0435\u043d\u043d\u043e \u0443\u044e\u0442 \u0442\u0432\u043e\u0435\u0439 \u043a\u043e\u043c\u043d\u0430\u0442\u044b \u0441 \u0434\u0443\u0445\u043e\u043c \u043f\u0440\u0438\u043a\u043b\u044e\u0447\u0435\u043d\u0438\u0439 \u0432 \u0436\u0438\u0432\u043e\u043f\u0438\u0441\u043d\u044b\u0445 \u043b\u043e\u043a\u0430\u0446\u0438\u044f\u0445.\n\n\u0423\u043f\u0440\u0430\u0432\u043b\u044f\u0439 \u0434\u0440\u043e\u043d\u043e\u043c \u043e\u0442 \u0442\u0440\u0435\u0442\u044c\u0435\u0433\u043e \u043b\u0438\u0446\u0430 \u0438\u043b\u0438 \u043f\u043e\u0433\u0440\u0443\u0436\u0430\u0439\u0441\u044f \u043e\u0442 \u043f\u0435\u0440\u0432\u043e\u0433\u043e \u2014 \u0447\u0435\u0440\u0435\u0437 \u043a\u0430\u043c\u0435\u0440\u0443 \u0434\u0440\u043e\u043d\u0430, \u0432\u0438\u0434\u044f \u0441\u0435\u0431\u044f \u0438 \u043e\u043a\u0440\u0443\u0436\u0430\u044e\u0449\u0438\u0439 \u043c\u0438\u0440 \u0441\u043e \u0441\u0442\u043e\u0440\u043e\u043d\u044b.\n\n\u0412\u044b\u043b\u0435\u0442\u0430\u0439 \u0447\u0435\u0440\u0435\u0437 \u043e\u043a\u043d\u043e \u0438\u043b\u0438 \u0434\u0432\u0435\u0440\u044c \u0438 \u0438\u0441\u0441\u043b\u0435\u0434\u0443\u0439 \u043e\u0434\u043d\u0443 \u0438\u0437 \u043f\u044f\u0442\u0438 \u0430\u0442\u043c\u043e\u0441\u0444\u0435\u0440\u043d\u044b\u0445 \u043b\u043e\u043a\u0430\u0446\u0438\u0439: \ud83c\udfdd\ufe0f \u041e\u0441\u0442\u0440\u043e\u0432 \u2022 \ud83c\udf32 \u041b\u0435\u0441 \u2022 \ud83c\udf38 \u042f\u043f\u043e\u043d\u0438\u044f \u2022 \ud83c\udfdc\ufe0f \u0415\u0433\u0438\u043f\u0435\u0442 \u2022 \u2744\ufe0f \u0417\u0438\u043c\u0430\n\n\u0411\u043b\u0430\u0433\u043e\u0434\u0430\u0440\u044f \u0442\u0435\u0445\u043d\u043e\u043b\u043e\u0433\u0438\u0438 Meta Quest 3 passthrough, \u0442\u044b \u0432\u0438\u0434\u0438\u0448\u044c \u0434\u0440\u043e\u043d \u0432 \u0441\u0432\u043e\u0435\u0439 \u043a\u043e\u043c\u043d\u0430\u0442\u0435, \u043a\u0430\u043a \u0432 \u0440\u0435\u0430\u043b\u044c\u043d\u043e\u0441\u0442\u0438. \u0423\u043f\u0440\u0430\u0432\u043b\u044f\u0439 \u0438\u043c \u0447\u0435\u0440\u0435\u0437 \u0432\u0438\u0440\u0442\u0443\u0430\u043b\u044c\u043d\u044b\u0439 \u0434\u0438\u0441\u043f\u043b\u0435\u0439 \u0438\u043b\u0438 \u043d\u0430\u0434\u0435\u043d\u044c \u0432\u0438\u0440\u0442\u0443\u0430\u043b\u044c\u043d\u044b\u0435 FPV \u043e\u0447\u043a\u0438 \u0434\u043b\u044f \u043f\u043e\u043b\u043d\u043e\u0433\u043e \u043f\u043e\u0433\u0440\u0443\u0436\u0435\u043d\u0438\u044f.\n\n- \u041f\u043e\u043b\u043d\u0430\u044f \u0438\u043d\u0442\u0435\u0433\u0440\u0430\u0446\u0438\u044f Mixed Reality \u0441 \u043f\u043e\u0434\u0434\u0435\u0440\u0436\u043a\u043e\u0439 passthrough\n- 5 \u0436\u0438\u0432\u043e\u043f\u0438\u0441\u043d\u044b\u0445 \u043b\u043e\u043a\u0430\u0446\u0438\u0439 \u0437\u0430 \u043f\u0440\u0435\u0434\u0435\u043b\u0430\u043c\u0438 \u043a\u043e\u043c\u043d\u0430\u0442\u044b\n- 2 \u0440\u0435\u0430\u043b\u0438\u0441\u0442\u0438\u0447\u043d\u044b\u0445 \u0440\u0435\u0436\u0438\u043c\u0430 \u0443\u043f\u0440\u0430\u0432\u043b\u0435\u043d\u0438\u044f \u0434\u0440\u043e\u043d\u043e\u043c\n- \u0412\u0438\u0440\u0442\u0443\u0430\u043b\u044c\u043d\u044b\u0439 \u0434\u0438\u0441\u043f\u043b\u0435\u0439 \u0438 FPV-\u043e\u0447\u043a\u0438\n- \u041f\u043e\u0434\u0434\u0435\u0440\u0436\u043a\u0430 \u043a\u043e\u043d\u0442\u0440\u043e\u043b\u043b\u0435\u0440\u043e\u0432, \u0433\u0435\u0439\u043c\u043f\u0430\u0434\u0430 (\u043f\u043e\u043a\u0430 \u0442\u043e\u043b\u044c\u043a\u043e PS) \u0438 \u0442\u0440\u0435\u043a\u0438\u043d\u0433\u0430 \u0440\u0443\u043a\n- \u0418\u0434\u0435\u0430\u043b\u044c\u043d\u043e \u0434\u043b\u044f \u0444\u0430\u043d\u0430\u0442\u043e\u0432 VR-\u0434\u0440\u043e\u043d\u0440\u0435\u0439\u0441\u0438\u043d\u0433\u0430\n\n\u0414\u043e\u0431\u0440\u043e \u043f\u043e\u0436\u0430\u043b\u043e\u0432\u0430\u0442\u044c \u0432 Drone Sim XR \u2014 \u0441\u0438\u043c\u0443\u043b\u044f\u0442\u043e\u0440 \u0434\u0440\u043e\u043d\u0430 \u0441 \u043f\u043e\u043b\u043d\u043e\u0439 \u043f\u043e\u0434\u0434\u0435\u
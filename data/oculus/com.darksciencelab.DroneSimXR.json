gs_2.png", "id": "2843240842553886", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491825050_2843240849220552_6554436694829226423_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AValvs-8y8wQ7kNvwEcsUBK&_nc_oc=AdqtUWaAdn_BDIZyfp-PgjP-tV6OyRdyNOqvvifomn7GG9DwgNQFX-PTpYlVb1Z2wcI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVBuaET4U8GLfsHcz8jeZl7-nrb6LP0rbWSTfy5BylAKQ&oe=6B106702"}, {"file_name": "2560_1440_Screen_1imgs_1.png", "id": "575968435480340", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491819476_575968438813673_3394773491825149518_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VxJdrnqxJpYQ7kNvwGJeFHW&_nc_oc=AdojhC3Nsmsrm8FQUADF_Y6Itgb5r_pUq9b5EgjHuqypFustGD2rU9kgMLfeBZPJTDM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXVldUhXwet_zKDOtDaujaBpumiuIKLKEIzQTHdW1cx0A&oe=6B104160"}, {"file_name": "2560_1440_Screen_1imgs_5.png", "id": "4281899142086819", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491830460_4281899145420152_7358136303343778754_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uMk8YUpQJnAQ7kNvwFAOE1-&_nc_oc=AdpUhxuJZbfNjINDAmv9oB_knWkHHVmXeiVYmr5nUPFyzfdR7ercoqSiHoRX1on9Jg4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQULkAVRIsICA0GYfNXhkm8w0ZQoDT3Oj1aC8DHXutDuKw&oe=6B1059C8"}, {"file_name": "2560_1440_Screen_1imgs_3.png", "id": "1472604424175402", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491830460_1472604427508735_91677171034992708_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EvtHBPJv1-MQ7kNvwEEQ6NC&_nc_oc=AdpacWS4YuN0Ysfz5X_Pe1qjiGQ4WyQt7I2o36CW8uy4-YY-hG4he1Xod2nW9EMYdlM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWk0tE3RWAxx3SCEOVdIvp8IPOgPUmVJyD90gQ-zlH1hg&oe=6B10634C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Drone Sim XR", "keywords": ["dronesimulator", "fpvdrone", "metaquest3passthrough", "vrdroneracing", "quadcopter"], "long_description": "Drone Sim XR is an exciting drone simulator in mixed reality, combining the comfort of your room with the spirit of adventure in picturesque locations.\n\nControl a drone and enjoy the flight from both third-person and immersive first-person views \u2014 seeing yourself and your surroundings from the drone\u2019s onboard camera.\n\nFly out the window or door and explore five beautiful, atmospheric environments: \ud83c\udfdd\ufe0f Island \u2022 \ud83c\udf32 Forest \u2022 \ud83c\udf38 Japan \u2022 \ud83c\udfdc\ufe0f Egypt \u2022 \u2744\ufe0f Winter\n\nThanks to Meta Quest 3 passthrough technology, you can see the drone flying right in your real room \u2014 just like in real life. Watch the flight on a virtual screen or put on virtual FPV goggles for full immersion.\n\n- Full mixed reality integration with passthrough support\n- 5 scenic environments beyond your room\n- 2 realistic drone control modes\n- Virtual FPV display and goggles\n- Support for controllers, gamepad (for now only PS), and hand tracking\n- Ideal for VR drone racing fans\n\nWelcome to Drone Sim XR \u2014 the drone simulator with full mixed reality support for Meta Quest 3 devices!", "short_description": "Drone Sim XR is an exciting drone simulator in mixed reality, combining the comfort of your room with the spirit of adventure in picturesque locations.\n\n"}, {"images": {"nodes": []}, "id": "685401207417023", "locale": "ru_RU", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Drone Sim XR", "keywords": ["\u0414\u0440\u043e\u043d", "FPV", "Passthrough", "\u0414\u0440\u043e\u043d\u0440\u0435\u0439\u0441\u0438\u043d\u0433", "\u041a\u0432\u0430\u0434\u0440\u043e\u043a\u043e\u043f\u0442\u0435\u0440"], "long_description": "Drone Sim XR \u2014 \u0437\u0430\u0445\u0432\u0430\u0442\u044b\u0432\u0430\u044e\u0449\u0438\u0439 \u0441\u0438\u043c\u0443\u043b\u044f\u0442\u043e\u0440 \u0434\u0440\u043e\u043d\u0430 \u0432 \u0441\u043c\u0435\u0448\u0430\u043d\u043d\u043e\u0439 \u0440\u0435\u0430\u043b\u044c\u043d\u043e\u0441\u0442\u0438, \u0441\u043e\u0432\u043c\u0435\u0449\u0430\u044e\u0449\u0438\u0439 \u043e\u0434\u043d\u043e\u0432\u0440\u0435\u043c\u0435\u043d\u043d\u043e \u0443\u044e\u0442 \u0442\u0432\u043e\u0435\u0439 \u043a\u043e\u043c\u043d\u0430\u0442\u044b \u0441 \u0434\u0443\u0445\u043e\u043c \u043f\u0440\u0438\u043a\u043b\u044e\u0447\u0435\u043d\u0438\u0439 \u0432 \u0436\u0438\u0432\u043e\u043f\u0438\u0441\u043d\u044b\u0445 \u043b\u043e\u043a\u0430\u0446\u0438\u044f\u0445.\n\n\u0423\u043f\u0440\u0430\u0432\u043b\u044f\u0439 \u0434\u0440\u043e\u043d\u043e\u043c \u043e\u0442 \u0442\u0440\u0435\u0442\u044c\u0435\u0433\u043e \u043b\u0438\u0446\u0430 \u0438\u043b\u0438 \u043f\u043e\u0433\u0440\u0443\u0436\u0430\u0439\u0441\u044f \u043e\u0442 \u043f\u0435\u0440\u0432\u043e\u0433\u043e \u2014 \u0447\u0435\u0440\u0435\u0437 \u043a\u0430\u043c\u0435\u0440\u0443 \u0434\u0440\u043e\u043d\u0430, \u0432\u0438\u0434\u044f \u0441\u0435\u0431\u044f \u0438 \u043e\u043a\u0440\u0443\u0436\u0430\u044e\u0449\u0438\u0439 \u043c\u0438\u0440 \u0441\u043e \u0441\u0442\u043e\u0440\u043e\u043d\u044b.\n\n\u0412\u044b\u043b\u0435\u0442\u0430\u0439 \u0447\u0435\u0440\u0435\u0437 \u043e\u043a\u043d\u043e \u0438\u043b\u0438 \u0434\u0432\u0435\u0440\u044c \u0438 \u0438\u0441\u0441\u043b\u0435\u0434\u0443\u0439 \u043e\u0434\u043d\u0443 \u0438\u0437 \u043f\u044f\u0442\u0438 \u0430\u0442\u043c\u043e\u0441\u0444\u0435\u0440\u043d\u044b\u0445 \u043b\u043e\u043a\u0430\u0446\u0438\u0439: \ud83c\udfdd\ufe0f \u041e\u0441\u0442\u0440\u043e\u0432 \u2022 \ud83c\udf32 \u041b\u0435\u0441 \u2022 \ud83c\udf38 \u042f\u043f\u043e\u043d\u0438\u044f \u2022 \ud83c\udfdc\ufe0f \u0415\u0433\u0438\u043f\u0435\u0442 \u2022 \u2744\ufe0f \u0417\u0438\u043c\u0430\n\n\u0411\u043b\u0430\u0433\u043e\u0434\u0430\u0440\u044f \u0442\u0435\u0445\u043d\u043e\u043b\u043e\u0433\u0438\u0438 Meta Quest 3 
c_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qRzsVgQpgKIQ7kNvwGD_wHD&_nc_oc=Adp1WWOanWBmbwFYQ5J8SVPIopr-KnDevIH8o5n66o8p8K0qVoEguyZ2g4SMcOt_ALQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQuvEBsLRogRMhfrVAOFRvnueALwbUqcdFYzH3Z2mk3xg&oe=6B0DD176"}, {"file_name": "5.png", "id": "2692322534311960", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473393560_2692322540978626_4045449699693174858_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iMxODGDk1eUQ7kNvwG2VU85&_nc_oc=AdqSHeQKEPS7YZXC3Rl46LijLTGhE4v90nbrhrHzjT_EiDkJTl0stqm0udLSELwu5qY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSEe_BRNEKrsisMC5CFg_w4Dc2wgl8Hq6UBpGK5LQPLIA&oe=6B0DA791"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Nature of Eastern Mongolia", "keywords": [], "long_description": "Eastern Mongolia is a sweeping landscape of vast steppes, rolling hills, and endless skies. As one of the most expansive grassland regions in the country, it offers an open, boundless environment that captures the essence of Mongolia\u2019s nomadic heritage. The terrain is marked by wide plains, salt lakes, and gently undulating ridges that create a deep sense of space, freedom, and stillness.\n\nThis region is shaped by seasonal contrasts\u2014from lush green pastures in summer to golden, wind-blown expanses in autumn\u2014each offering a different experience of the land\u2019s raw and natural beauty. The air is clear, the horizon is unbroken, and the sense of scale is unmatched.\n\nEastern Mongolia also holds deep cultural and historical significance. Believed to be the birthplace of Chinggis Khaan, the landscape is dotted with ancient monuments, sacred sites, and traces of past civilizations, all blending into the natural scenery.\n\nWhether explored through virtual reality or in person, Eastern Mongolia invites reflection, connection, and a powerful sense of openness that is both grounding and inspiring.", "short_description": "Eastern Mongolia is a vast expanse of open steppe, gentle hills, and endless sky. Known for its rich grasslands and sweeping horizons, the region is home to wild gazelles, rare birds, and sacred historical sites. Its wide, open landscapes offer a powerful sense of freedom and connection to the nomadic way of life."}]}, "developer_name": null, "developer_privacy_policy_url": "https://digitalsolutions.mn/policy.html", "developer_terms_of_service_url": null, "publisher_name": "Digital Solutions", "support_website_url": null, "website_url": "https://digitalsolutions.mn/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["mn", "en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "23914259171533652"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PUBLISHED", "id": "861910730236360"}, {"status": "PUBLISHED", "id": "988056170115231"}]}, "baseline_offer": {"id": "861910730236360"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1773190080, "status": "PUBLISHED", "id": "861910730236360"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "23915878254705077", "version": "1.0"}, "id": "9766199436772422", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application
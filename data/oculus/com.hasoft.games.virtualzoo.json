ss=7f20f&oh=00_AQRZ42vIQ0x5NWbWrO9oPWCnno6UJR8VgTzHAi2liNwOoQ&oe=6B070A16"}, {"file_name": "migrated_image.png", "id": "210890793325057", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/11162690_510656702601736_3434315365243420672_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eLk-WTYBBdgQ7kNvwEMfF55&_nc_oc=AdoaWNCyNU8OztCGVnorXJANGCuQ4xetzLKNt3X8atCQWBcW_q4ioWJbedqpJtDpiYI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSCwhUs55igVLFXp1pipo7pnlQYXDZR9Clfok_WOfKVPQ&oe=6B06FD1A"}, {"file_name": "migrated_image.png", "id": "1101537566846428", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/11162700_286111548569698_6750775844337090560_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_HRQWKY0myYQ7kNvwGiehPx&_nc_oc=AdrQ4HD5XWzbPn5-j-6y0U1wP40iAVYkoK3c2QDUBUtDJwSvyBxUIHEWBurcydnIzgw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSZB2s_WWB_K9enL45Fxedy_x5hPLnw20ZC_xiNo7edLw&oe=6B072325"}, {"file_name": "migrated_image.png", "id": "518555618807636", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/11162682_179116105994090_8275689972598571008_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fOQxTyE3aqIQ7kNvwGe8G2X&_nc_oc=AdqhkiNv88AAaQkSYMWQsT7I1NRIacWPJMIur-krc2od0i0qMmVNJDLrq-W1TOV3jJg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ_ZqCJUE3M94ma8kfGm_MFLweb0HE8xCmsIaGkqrEScA&oe=6B06F19D"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Zoo Park", "keywords": ["animals", "zoo", "park", "forest", "nature"], "long_description": "Zoo Park was developed for you to see the animals on their natural environment with the beautiful graphics and sounds. \n\nUsing your virtual reality glasses, you can see the animals moving closely with animations. It will be an exciting journey for you. \n\nYou don't need to go to a zoo to see the animals. Your children will also enjoy the virtual simulations as if they are in a zoo and know the names of many animals. Elephant, Lion, Lioness, Zebra, Crocodile, Hippopotamus, Rhinoceros, Chicken, Cow, Goat, Pig, Sheep, Bear, Boar, Fox, Rabbit, Stag, Wolf, Crow and more.\n\nHow to play\nIt is very easy. You should look at where you want to move. When you approach to animals, your movements will be slower or stop so that you will have time to examine them closely. You can use touchpad to go forward, back, left and right.\n\nFeatures\n- Very beautiful graphics. Realistic forest environment\n- Nice animated animals in Zoo\n- Natural sounds of animals", "short_description": "Zoo Park was developed for you to see the animals on their natural environment with the beautiful graphics and sounds."}]}, "developer_name": null, "developer_privacy_policy_url": "http://provr.net/privacy2.html", "developer_terms_of_service_url": "http://provr.net/privacy2.html", "publisher_name": "HASoft", "support_website_url": null, "website_url": "https://www.facebook.com/HASoft-Mobile-GamesApplications-680466725426771", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["EDUCATIONAL", "SIMULATION", "ADVENTURE", "ACTION", "EXPLORATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD", "GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "387783899774014"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "353810161712743"}]}, "baseline_offer": {"id": "353810161712743"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1508346000, "status": "PUBLISHED", "id": "353810161712743"}]}, "liveChannel": {"nodes
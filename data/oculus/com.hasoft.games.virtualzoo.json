eb4WtK1ERx4_DhuFuHKBBhFYZ8&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0JpBWP6K6fA7omP8dhvnHNSWnmGNJUGN76msABCffwJQ&oe=69E78306"}, {"file_name": "migrated_image.png", "id": "208088447206320", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/11162716_476745332724218_1676433208595447808_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6B_UdCzEyiEQ7kNvwE-y-bA&_nc_oc=AdorKrSnlFyEPFslBIcISvc0m4ESAfkGy-5poW872lEZa11g6qQPi7Nc7peoyEE2lpQ&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3WQmQutXswkd1rtNRQiXD2By_kGqIa0FVlrn6DmaT0fw&oe=69E76AD6"}, {"file_name": "migrated_image.png", "id": "290138991968813", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/11162690_510656702601736_3434315365243420672_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gLrvXPGxF9wQ7kNvwGbaAGX&_nc_oc=Adr1Dgz9vJwqZf-BLkun6rjqUgPm7mDaeV4oK13Va_wL_pb7m3_B7ThQOqjYmUCcyag&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af35ivAXjMLV0GSR5ssJq7P4SAfxtVLwp5lsPLGQ_b2fpA&oe=69E75DDA"}, {"file_name": "migrated_image.png", "id": "2526122730961072", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/11162700_286111548569698_6750775844337090560_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Gl3wKLmY6twQ7kNvwGzxWA-&_nc_oc=AdpkTPCHDLrZkCS3vW5SQzJtjgWRw13KBNTT_85D5Gp4AyPNdeczCb8cgLTQjC42qfk&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0PBThd6DDuDIwtcdwpCH_xRtL6Bjmx6mC8vr3wSA4Bvg&oe=69E783E5"}, {"file_name": "migrated_image.png", "id": "526738798265020", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/11162682_179116105994090_8275689972598571008_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5RxGOmjkggkQ7kNvwEU8PPE&_nc_oc=AdrXQvz-AGM1iWIQaAxwTthdDEe18DnI6jh_jjFjAhiJ7V76z2SfdPmUcZ_BvPorQNI&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af01Yf6Jnun86rnhgY6NMvL7WUzv3e7H7sozw_0I24OwJg&oe=69E78A9D"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Zoo Park", "keywords": ["animals", "zoo", "park", "forest", "nature"], "long_description": "Zoo Park was developed for you to see the animals on their natural environment with the beautiful graphics and sounds. \n\nUsing your virtual reality glasses, you can see the animals moving closely with animations. It will be an exciting journey for you. \n\nYou don't need to go to a zoo to see the animals. Your children will also enjoy the virtual simulations as if they are in a zoo and know the names of many animals. Elephant, Lion, Lioness, Zebra, Crocodile, Hippopotamus, Rhinoceros, Chicken, Cow, Goat, Pig, Sheep, Bear, Boar, Fox, Rabbit, Stag, Wolf, Crow and more.\n\nHow to play\nIt is very easy. You should look at where you want to move. When you approach to animals, your movements will be slower or stop so that you will have time to examine them closely. You can use touchpad to go forward, back, left and right.\n\nFeatures\n- Very beautiful graphics. Realistic forest environment\n- Nice animated animals in Zoo\n- Natural sounds of animals", "short_description": "Zoo Park was developed for you to see the animals on their natural environment with the beautiful graphics and sounds."}]}, "developer_name": null, "developer_privacy_policy_url": "http://provr.net/privacy2.html", "developer_terms_of_service_url": "http://provr.net/privacy2.html", "publisher_name": "HASoft", "support_website_url": null, "website_url": "https://www.facebook.com/HASoft-Mobile-GamesApplications-680466725426771", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE", "EDUCATIONAL", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD", "GEAR_VR_CONTROLLE
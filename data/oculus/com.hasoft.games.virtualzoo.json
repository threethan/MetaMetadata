oZCJfXbSeGKWlk9Ijnizu5VwA8&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO8NgGcPtvfTt2L2WTSvaIlocMtmcK6r4XMv_HjBezhLg&oe=6AE35186"}, {"file_name": "migrated_image.png", "id": "208088447206320", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/11162716_476745332724218_1676433208595447808_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tthVMs-D-9MQ7kNvwEMEL0u&_nc_oc=AdqneB2rXSsVbd3o82a_jBMazzyu9PPLIBa3V08l3z8X1CR9usYJ-KGyZh9lGRJm6C4&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMV8HSnE-WwhUuO6URS9O6NhGkAJhJe2d8dMqoGYKYVag&oe=6AE33956"}, {"file_name": "migrated_image.png", "id": "290138991968813", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/11162690_510656702601736_3434315365243420672_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lEprd1oegVwQ7kNvwHiD1rf&_nc_oc=AdqMcr7BIrW9TLRi1eSJD2oTCB6a1QxfFq3u19T6dMCqgiF42tPT9DmECaSQUbIGXoE&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNYPmIAbg9xW2BEXwCJ2UsJfUK2FR4NAhfqMSvbQgNYUw&oe=6AE3649A"}, {"file_name": "migrated_image.png", "id": "2526122730961072", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/11162700_286111548569698_6750775844337090560_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WCkxXermg9wQ7kNvwFflcWm&_nc_oc=AdqOYw5JNbdOKHQD1Z54ZomwurzDNyUj0CKR4moyukWxP8f_PeK2EV-rWx7dRQmDLSI&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOr-U4YhgMG85GuA-vmAgOQH4v61tV_zLLD-bpGtHssjw&oe=6AE35265"}, {"file_name": "migrated_image.png", "id": "526738798265020", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/11162682_179116105994090_8275689972598571008_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YgfqcwoIUekQ7kNvwEwFQoK&_nc_oc=Adq92D-Tx9lqib5fdsR_yF2WTwhDFxX8-cWexQybBgUMw5c4CqJ5v2bLq3rzmdLWyqs&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNUdiOFGrUrLiwgnqdFSeJ87lkYSdKyMA78TTl_1km6Rg&oe=6AE3591D"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Zoo Park", "keywords": ["animals", "zoo", "park", "forest", "nature"], "long_description": "Zoo Park was developed for you to see the animals on their natural environment with the beautiful graphics and sounds. \n\nUsing your virtual reality glasses, you can see the animals moving closely with animations. It will be an exciting journey for you. \n\nYou don't need to go to a zoo to see the animals. Your children will also enjoy the virtual simulations as if they are in a zoo and know the names of many animals. Elephant, Lion, Lioness, Zebra, Crocodile, Hippopotamus, Rhinoceros, Chicken, Cow, Goat, Pig, Sheep, Bear, Boar, Fox, Rabbit, Stag, Wolf, Crow and more.\n\nHow to play\nIt is very easy. You should look at where you want to move. When you approach to animals, your movements will be slower or stop so that you will have time to examine them closely. You can use touchpad to go forward, back, left and right.\n\nFeatures\n- Very beautiful graphics. Realistic forest environment\n- Nice animated animals in Zoo\n- Natural sounds of animals", "short_description": "Zoo Park was developed for you to see the animals on their natural environment with the beautiful graphics and sounds."}]}, "developer_name": null, "developer_privacy_policy_url": "http://provr.net/privacy2.html", "developer_terms_of_service_url": "http://provr.net/privacy2.html", "publisher_name": "HASoft", "support_website_url": null, "website_url": "https://www.facebook.com/HASoft-Mobile-GamesApplications-680466725426771", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE", "EDUCATIONAL", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD", "GEAR_VR_CONTROLLE
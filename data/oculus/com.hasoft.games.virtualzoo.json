9lnziGkJP69i7ovyOExCTgH6cA&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH2M1uwI0a_FCzSYifqRya8Hy6ZYv8ojViDbNIjqZ9fkA&oe=6A86D046"}, {"file_name": "migrated_image.png", "id": "208088447206320", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/11162716_476745332724218_1676433208595447808_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mkfo-FDTlS4Q7kNvwF8tuw1&_nc_oc=Adr32ez7BcvhZ41YMqpgNAnp3Y3rcROK6Q6w1mfguCmz05kGi5pZ6wpIAAoWjjz51MA&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGw_LnICNej1v2d9zafsf4-zN7pdU11-o64cCZ0J2AQcQ&oe=6A86F056"}, {"file_name": "migrated_image.png", "id": "290138991968813", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/11162690_510656702601736_3434315365243420672_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_T4AzLozMAUQ7kNvwEisp-P&_nc_oc=AdrnkWaELAV6LcFb6xTsp9LLz75x90VB7JLYJzuvs1RYRB0vuOh3dCH14MSRut2epuw&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGZe3NoqGxHw5yQDgRUnRCsbLXqQ-8KYiydP_xTF29JjA&oe=6A86E35A"}, {"file_name": "migrated_image.png", "id": "2526122730961072", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/11162700_286111548569698_6750775844337090560_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BwbtUewud2gQ7kNvwGuw5Bo&_nc_oc=AdoHUDq3_cC_jVo2isdQvZqafulsqrwGcR_d0p99xXea3WFc80ctjoD9hZN318UBDKg&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFs7TFxsjjlLg795Ctkv9D5RliTrgd5xlJBcDgt1q5sbA&oe=6A86D125"}, {"file_name": "migrated_image.png", "id": "526738798265020", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/11162682_179116105994090_8275689972598571008_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O8B5GSnfY0QQ7kNvwGQQlV1&_nc_oc=AdrOi3qtVfDrbzPE7o2sSGD0SFfCTKW5yC0ym2Kseb01FL7xB_De8pgmSb4Rc-_k_yI&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFc6DkNoT9Kqxr5vAsQnsLilpozVms_CbAuiUCZZeo81Q&oe=6A86D7DD"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Zoo Park", "keywords": ["animals", "zoo", "park", "forest", "nature"], "long_description": "Zoo Park was developed for you to see the animals on their natural environment with the beautiful graphics and sounds. \n\nUsing your virtual reality glasses, you can see the animals moving closely with animations. It will be an exciting journey for you. \n\nYou don't need to go to a zoo to see the animals. Your children will also enjoy the virtual simulations as if they are in a zoo and know the names of many animals. Elephant, Lion, Lioness, Zebra, Crocodile, Hippopotamus, Rhinoceros, Chicken, Cow, Goat, Pig, Sheep, Bear, Boar, Fox, Rabbit, Stag, Wolf, Crow and more.\n\nHow to play\nIt is very easy. You should look at where you want to move. When you approach to animals, your movements will be slower or stop so that you will have time to examine them closely. You can use touchpad to go forward, back, left and right.\n\nFeatures\n- Very beautiful graphics. Realistic forest environment\n- Nice animated animals in Zoo\n- Natural sounds of animals", "short_description": "Zoo Park was developed for you to see the animals on their natural environment with the beautiful graphics and sounds."}]}, "developer_name": null, "developer_privacy_policy_url": "http://provr.net/privacy2.html", "developer_terms_of_service_url": "http://provr.net/privacy2.html", "publisher_name": "HASoft", "support_website_url": null, "website_url": "https://www.facebook.com/HASoft-Mobile-GamesApplications-680466725426771", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE", "EDUCATIONAL", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD", "GEAR_VR_CONTROLLE
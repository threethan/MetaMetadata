ZG9ep_nTKV2YAGceB039eLBTq0&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8FfVGkeyxxEviyR9rUiGBt1JHQL9PXCV6GIWQWmYJDuw&oe=6A33FA06"}, {"file_name": "migrated_image.png", "id": "208088447206320", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/11162716_476745332724218_1676433208595447808_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LaLj0YleBfwQ7kNvwFJHFbx&_nc_oc=Ado8L78hw5kfL7oODdD-ybPVs6x2SfWBPFDRjH8o9OTD2pPseDsyG6wwX23A9dttY8A&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_o343zczEo0cKn2Ln665bnXYq_bVCYLiGA4MceibG6KQ&oe=6A341A16"}, {"file_name": "migrated_image.png", "id": "290138991968813", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/11162690_510656702601736_3434315365243420672_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=X-1dBRKifaEQ7kNvwFuktb0&_nc_oc=AdqdJ06I96ctpsi57CSOWlLf4dB4Qr5VD3VzdpMdWrvNXFle6l3meN9vBynIPndsi24&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9EKIMmqY2SVeMVJ0h0MCkJnC2oEnkp4JzcoFyGHFrjvg&oe=6A340D1A"}, {"file_name": "migrated_image.png", "id": "2526122730961072", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/11162700_286111548569698_6750775844337090560_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G737ICIsv54Q7kNvwGcK_KQ&_nc_oc=AdrGmXC9QdutvKhdqx1QGSU6ElqXZj804nB_bhSKdGO9sw7AxM6-BCtMu2NRAsV2B8k&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_JWdaSjyq4RbRMxY8YZWj-nOdrjZ_XxLMbkD63wto9QQ&oe=6A33FAE5"}, {"file_name": "migrated_image.png", "id": "526738798265020", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/11162682_179116105994090_8275689972598571008_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-KVqumtfL64Q7kNvwF12c10&_nc_oc=Adrsi2icbOCq9sdjPkqluCcgVcw8kVmY9T5fGT71mA1sjfNRwMYLSVcfd_e0LXNEiZs&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9BYaaOVmRPyb_gsbBSiC8oy2dSMqOy6w7K7OAH9-JUHA&oe=6A34019D"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Zoo Park", "keywords": ["animals", "zoo", "park", "forest", "nature"], "long_description": "Zoo Park was developed for you to see the animals on their natural environment with the beautiful graphics and sounds. \n\nUsing your virtual reality glasses, you can see the animals moving closely with animations. It will be an exciting journey for you. \n\nYou don't need to go to a zoo to see the animals. Your children will also enjoy the virtual simulations as if they are in a zoo and know the names of many animals. Elephant, Lion, Lioness, Zebra, Crocodile, Hippopotamus, Rhinoceros, Chicken, Cow, Goat, Pig, Sheep, Bear, Boar, Fox, Rabbit, Stag, Wolf, Crow and more.\n\nHow to play\nIt is very easy. You should look at where you want to move. When you approach to animals, your movements will be slower or stop so that you will have time to examine them closely. You can use touchpad to go forward, back, left and right.\n\nFeatures\n- Very beautiful graphics. Realistic forest environment\n- Nice animated animals in Zoo\n- Natural sounds of animals", "short_description": "Zoo Park was developed for you to see the animals on their natural environment with the beautiful graphics and sounds."}]}, "developer_name": null, "developer_privacy_policy_url": "http://provr.net/privacy2.html", "developer_terms_of_service_url": "http://provr.net/privacy2.html", "publisher_name": "HASoft", "support_website_url": null, "website_url": "https://www.facebook.com/HASoft-Mobile-GamesApplications-680466725426771", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE", "EDUCATIONAL", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD", "GEAR_VR_CONTROLLE
dH3yCe-SxoEjWxgrRBtKSs18Xk&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afws9qQ6wFt0yf2u0bb65LOMwRL6wr-jxP9e7D8gpUjHuQ&oe=69C7DF06"}, {"file_name": "migrated_image.png", "id": "208088447206320", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/11162716_476745332724218_1676433208595447808_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XS8Uf0_SVuQQ7kNvwG6DZW2&_nc_oc=AdqZFdLK07BEcK7xqk4M6j4emMmbDlQkgK8Rw89ohmLGYR6YgPhI7L5efByd2sE8owk&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afw5KlZN_psNplf6t4NoSPJ_CjJvXwjitAUSRuXLrslKJg&oe=69C7C6D6"}, {"file_name": "migrated_image.png", "id": "290138991968813", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/11162690_510656702601736_3434315365243420672_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YrhgaCzB_FwQ7kNvwHDyZ_7&_nc_oc=AdpNIw6lZ_h51UDoXg8J5ni82T_OnGmN_4KI8TbkGFec7tdhV-wKoIsGp5JRszV3lEw&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzfZQ-p8H0Q_G3r83zJtmkWdmXWN60HjQkVMq7CSEm9hA&oe=69C7B9DA"}, {"file_name": "migrated_image.png", "id": "2526122730961072", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/11162700_286111548569698_6750775844337090560_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rjEle74hGTMQ7kNvwHLjd7J&_nc_oc=AdqiprdTWg71f_Wj_OdWv9LgPsAGhH5bekgHLNo5L3uW1jaNEkmz5llqV_bAHOByu6Y&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyxU9ZDb2vt4Kl6mdlArrk3-FBG-Gz-Z2489ueMeIlVOQ&oe=69C7DFE5"}, {"file_name": "migrated_image.png", "id": "526738798265020", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/11162682_179116105994090_8275689972598571008_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TpIThMAHamEQ7kNvwGOH8Nt&_nc_oc=Adqgrsz8HqAyLL_bJ23z6O-GymLTCwB8gfxNoIejNAspO7fHBDzWtfLqas307aCCpic&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afz2_jz5qpnqgSUWmCiQTJZH3CUhNQ_by9ka3zk-wMYMoA&oe=69C7E69D"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Zoo Park", "keywords": ["animals", "zoo", "park", "forest", "nature"], "long_description": "Zoo Park was developed for you to see the animals on their natural environment with the beautiful graphics and sounds. \n\nUsing your virtual reality glasses, you can see the animals moving closely with animations. It will be an exciting journey for you. \n\nYou don't need to go to a zoo to see the animals. Your children will also enjoy the virtual simulations as if they are in a zoo and know the names of many animals. Elephant, Lion, Lioness, Zebra, Crocodile, Hippopotamus, Rhinoceros, Chicken, Cow, Goat, Pig, Sheep, Bear, Boar, Fox, Rabbit, Stag, Wolf, Crow and more.\n\nHow to play\nIt is very easy. You should look at where you want to move. When you approach to animals, your movements will be slower or stop so that you will have time to examine them closely. You can use touchpad to go forward, back, left and right.\n\nFeatures\n- Very beautiful graphics. Realistic forest environment\n- Nice animated animals in Zoo\n- Natural sounds of animals", "short_description": "Zoo Park was developed for you to see the animals on their natural environment with the beautiful graphics and sounds."}]}, "developer_name": null, "developer_privacy_policy_url": "http://provr.net/privacy2.html", "developer_terms_of_service_url": "http://provr.net/privacy2.html", "publisher_name": "HASoft", "support_website_url": null, "website_url": "https://www.facebook.com/HASoft-Mobile-GamesApplications-680466725426771", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE", "EDUCATIONAL", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD", "GEAR_VR_CONTROLLE
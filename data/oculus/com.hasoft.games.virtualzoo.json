HHEFDaocIAoMESCAsp34Q6fTog&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2t9kQ6DaYVBgzWAFZ98mX22V884Rm9TsTE_4Nivpk6KQ&oe=69DF9A06"}, {"file_name": "migrated_image.png", "id": "208088447206320", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/11162716_476745332724218_1676433208595447808_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=31Y3yauC0NQQ7kNvwEWeM3s&_nc_oc=AdrU55HY-9kQyTaJiH0bEEpxxPG9xqA1f4fwHsXbivvx59dK-Vtf6KWj111PPvxD_BM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1SwIYri_EdoYmsPMKI7Ze6eKIIv6GfEVKznDE5GD4ElA&oe=69DF81D6"}, {"file_name": "migrated_image.png", "id": "290138991968813", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/11162690_510656702601736_3434315365243420672_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QWpc4ooE4QUQ7kNvwFRSiCI&_nc_oc=AdrAbY1zvkz7FBhRDRHFAUZYAQQP4AoS-Iby3O99dvHxrujy8topKAvr6UYXJpx_Ln4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1oVZPKOwnpYNEVetU5krwwqYbnzXe4F_rfq_HPYQnqkg&oe=69DF74DA"}, {"file_name": "migrated_image.png", "id": "2526122730961072", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/11162700_286111548569698_6750775844337090560_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ijyMspM5PXkQ7kNvwFwFPqN&_nc_oc=AdrxuK9sSKVjinta0nud4-K1oJpv7IUfaiHOifGUNkw4mkN05ptycYBsck1tmg9QTDQ&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3BLtaJuvTS_PkwZZxpTInvT5rFjD31onR6Ne5igt-3tA&oe=69DF9AE5"}, {"file_name": "migrated_image.png", "id": "526738798265020", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/11162682_179116105994090_8275689972598571008_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PeouwFcMo4cQ7kNvwEuwt12&_nc_oc=AdpHZW9NE_s1EJUni708zkOcANQNEtSAb_bX7y9OJk5XV4irTvkGhR_B6_Z6W68tnB0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af38yEdC9ywfcH2EkMcmwLE4Qdzq0Ri3HKxmbMGsmW4ceQ&oe=69DFA19D"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Zoo Park", "keywords": ["animals", "zoo", "park", "forest", "nature"], "long_description": "Zoo Park was developed for you to see the animals on their natural environment with the beautiful graphics and sounds. \n\nUsing your virtual reality glasses, you can see the animals moving closely with animations. It will be an exciting journey for you. \n\nYou don't need to go to a zoo to see the animals. Your children will also enjoy the virtual simulations as if they are in a zoo and know the names of many animals. Elephant, Lion, Lioness, Zebra, Crocodile, Hippopotamus, Rhinoceros, Chicken, Cow, Goat, Pig, Sheep, Bear, Boar, Fox, Rabbit, Stag, Wolf, Crow and more.\n\nHow to play\nIt is very easy. You should look at where you want to move. When you approach to animals, your movements will be slower or stop so that you will have time to examine them closely. You can use touchpad to go forward, back, left and right.\n\nFeatures\n- Very beautiful graphics. Realistic forest environment\n- Nice animated animals in Zoo\n- Natural sounds of animals", "short_description": "Zoo Park was developed for you to see the animals on their natural environment with the beautiful graphics and sounds."}]}, "developer_name": null, "developer_privacy_policy_url": "http://provr.net/privacy2.html", "developer_terms_of_service_url": "http://provr.net/privacy2.html", "publisher_name": "HASoft", "support_website_url": null, "website_url": "https://www.facebook.com/HASoft-Mobile-GamesApplications-680466725426771", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE", "EDUCATIONAL", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD", "GEAR_VR_CONTROLLE
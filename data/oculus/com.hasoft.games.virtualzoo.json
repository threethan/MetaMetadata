R-MHpk5iN2QtdM_AejLy6FpWW0&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8qZWML1zcwi-oYsFkE1aypnUMoHYf9ybluaXQ5XCC_cw&oe=6A354B86"}, {"file_name": "migrated_image.png", "id": "208088447206320", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/11162716_476745332724218_1676433208595447808_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LaLj0YleBfwQ7kNvwHACr5w&_nc_oc=Adqu4Uei5VyUt4q4lSNv7EzPs3tr76Ddc0ryGRLJWWBWfHE1-pAGOxjbw2d_zP_Ecrs&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af84x97RDG1eXKpov7YNem6oG47QrIk8U8Ksej7IWbLuRQ&oe=6A356B96"}, {"file_name": "migrated_image.png", "id": "290138991968813", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/11162690_510656702601736_3434315365243420672_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2-D4K6x1o_cQ7kNvwHx6mSo&_nc_oc=AdpOzpThZL9GH-ggCI_yI3Sez0KHL_K8FNY1RJW-Kt6BfPcu_tka8flauS0_IN9Cn8w&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9yL6k-chabFkluKeOgXuganJzZVDW5foVLKgu20uI5dQ&oe=6A355E9A"}, {"file_name": "migrated_image.png", "id": "2526122730961072", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/11162700_286111548569698_6750775844337090560_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Q69tPB57Xf0Q7kNvwFdNcbF&_nc_oc=AdqwcpwCOXSn87otBvAuwUS4btd_lGuxS4oiV3dlq1OfrY8qteiNyADpyhmaxOQ7Fgc&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_bAP4lcwrvUt3g8NZxfI0XLtOxVw2sRbGJG3mzZh-SoA&oe=6A354C65"}, {"file_name": "migrated_image.png", "id": "526738798265020", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/11162682_179116105994090_8275689972598571008_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-KVqumtfL64Q7kNvwH3nAyp&_nc_oc=AdrUVWn2RSr8xofLFhK8-Jla7dLIabCXBkd2ComEfExZiGtfDoAzNkFwhydNDxfI524&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9lGwbKkLBeToyxNjC2uW841eL41duZDJRWJWRFwtAh9A&oe=6A35531D"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Zoo Park", "keywords": ["animals", "zoo", "park", "forest", "nature"], "long_description": "Zoo Park was developed for you to see the animals on their natural environment with the beautiful graphics and sounds. \n\nUsing your virtual reality glasses, you can see the animals moving closely with animations. It will be an exciting journey for you. \n\nYou don't need to go to a zoo to see the animals. Your children will also enjoy the virtual simulations as if they are in a zoo and know the names of many animals. Elephant, Lion, Lioness, Zebra, Crocodile, Hippopotamus, Rhinoceros, Chicken, Cow, Goat, Pig, Sheep, Bear, Boar, Fox, Rabbit, Stag, Wolf, Crow and more.\n\nHow to play\nIt is very easy. You should look at where you want to move. When you approach to animals, your movements will be slower or stop so that you will have time to examine them closely. You can use touchpad to go forward, back, left and right.\n\nFeatures\n- Very beautiful graphics. Realistic forest environment\n- Nice animated animals in Zoo\n- Natural sounds of animals", "short_description": "Zoo Park was developed for you to see the animals on their natural environment with the beautiful graphics and sounds."}]}, "developer_name": null, "developer_privacy_policy_url": "http://provr.net/privacy2.html", "developer_terms_of_service_url": "http://provr.net/privacy2.html", "publisher_name": "HASoft", "support_website_url": null, "website_url": "https://www.facebook.com/HASoft-Mobile-GamesApplications-680466725426771", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE", "EDUCATIONAL", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD", "GEAR_VR_CONTROLLE
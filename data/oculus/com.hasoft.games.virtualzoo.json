Ofkn3lVep5GdbWHzMRHxY297Mo&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6EWSsYIdAWyPwjezVHJhA4bXYDteaRndCefCiazLKHXw&oe=6A09CA06"}, {"file_name": "migrated_image.png", "id": "208088447206320", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/11162716_476745332724218_1676433208595447808_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VLxHZLesU10Q7kNvwEoPQ9I&_nc_oc=AdoCs0kq2BAVfvEOC07g2waXOYy9Zc2-v0stCHdnLC3_O_wcL9LJT6ES1iQkcr08kg0&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4v6Y4-erazbvdWdrABv61BUPbf0sjAoensoIqKQCA9ww&oe=6A09B1D6"}, {"file_name": "migrated_image.png", "id": "290138991968813", "uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/11162690_510656702601736_3434315365243420672_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KIwPP5lU44kQ7kNvwHoiwhX&_nc_oc=Adqd7Ae44tRP4GljIuTpW6XW4Q9ehnDpjPIATh-zpjKLhqOXuR1Gnf0Gvbf7RcBn0dQ&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7KNvYeSzi1O6MxI3YSofT1KH7VJvf_X3d7w5q8BpTmMA&oe=6A09DD1A"}, {"file_name": "migrated_image.png", "id": "2526122730961072", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/11162700_286111548569698_6750775844337090560_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GPdpN-auUJ4Q7kNvwHrXKev&_nc_oc=AdoB_ICTfpIJyjmYCaTuL49gqDhBVR04Ucb0njevcOSTtuE7ntqtYWEk8SiO3TgnIwg&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af62jgqDHRKk0kFs-Qi3L90SCi11wL4HUC6Nz1smSfXfOg&oe=6A09CAE5"}, {"file_name": "migrated_image.png", "id": "526738798265020", "uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/11162682_179116105994090_8275689972598571008_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Vvmu8M2BfokQ7kNvwFzbHNZ&_nc_oc=AdpkOnK0OlECDqNb7oQEnBwgsrbb1cbVD6Trjn6bbk98MtGS_QKuLiqNoN50nT7vuu8&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6Yno1ZJ3UZIj2WPacHHMf8pNygYve3u-wz-syGYD8lpw&oe=6A09D19D"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Zoo Park", "keywords": ["animals", "zoo", "park", "forest", "nature"], "long_description": "Zoo Park was developed for you to see the animals on their natural environment with the beautiful graphics and sounds. \n\nUsing your virtual reality glasses, you can see the animals moving closely with animations. It will be an exciting journey for you. \n\nYou don't need to go to a zoo to see the animals. Your children will also enjoy the virtual simulations as if they are in a zoo and know the names of many animals. Elephant, Lion, Lioness, Zebra, Crocodile, Hippopotamus, Rhinoceros, Chicken, Cow, Goat, Pig, Sheep, Bear, Boar, Fox, Rabbit, Stag, Wolf, Crow and more.\n\nHow to play\nIt is very easy. You should look at where you want to move. When you approach to animals, your movements will be slower or stop so that you will have time to examine them closely. You can use touchpad to go forward, back, left and right.\n\nFeatures\n- Very beautiful graphics. Realistic forest environment\n- Nice animated animals in Zoo\n- Natural sounds of animals", "short_description": "Zoo Park was developed for you to see the animals on their natural environment with the beautiful graphics and sounds."}]}, "developer_name": null, "developer_privacy_policy_url": "http://provr.net/privacy2.html", "developer_terms_of_service_url": "http://provr.net/privacy2.html", "publisher_name": "HASoft", "support_website_url": null, "website_url": "https://www.facebook.com/HASoft-Mobile-GamesApplications-680466725426771", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE", "EDUCATIONAL", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD", "GEAR_VR_CONTROLLE
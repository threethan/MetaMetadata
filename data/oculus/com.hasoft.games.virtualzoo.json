rS9w1mNV7XBjEnhZpwXeDem5tE&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIHW7xVU2PKngXhMonFuyVyQ0NEp-sk_Sf1nTJcm7dZFA&oe=6AA16686"}, {"file_name": "migrated_image.png", "id": "208088447206320", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/11162716_476745332724218_1676433208595447808_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bVCLVTQXH-sQ7kNvwFyo7zP&_nc_oc=Adpr5O8y12pCXYuHjORtCGSrd3gUTGNof06Q_SYaR-xQ4NfDr5LpErLsnoIfuqLMhXU&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL5nqZ6ld-FbjEg3uZe9VWt4lDAxGXBQEdOOyxg9sE9EQ&oe=6AA14E56"}, {"file_name": "migrated_image.png", "id": "290138991968813", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/11162690_510656702601736_3434315365243420672_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hLYKTvAL5YYQ7kNvwEzrq_T&_nc_oc=AdrlsiXkjtfKjA4WgU1UacfnDedLUSzGBxiIbnmR-k2khi-BoHG3Iob4erJagb7ewLA&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJxFmfrv3FQCMnBmjAT_eSHx_6xof5WI7HSIjGeure_kA&oe=6AA1799A"}, {"file_name": "migrated_image.png", "id": "2526122730961072", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/11162700_286111548569698_6750775844337090560_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cmgE8gOb4pgQ7kNvwGYvySc&_nc_oc=AdoMuo1HwMwLIVfJurSmGRqVNgxtBTOOf4WHT_9W7MBB3UVfEI8-wi6euR0wGFpC57Q&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJN5PeTtafDYTAXi9xTTc-DZwvdqnF774hD8-GzoIw5nw&oe=6AA16765"}, {"file_name": "migrated_image.png", "id": "526738798265020", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/11162682_179116105994090_8275689972598571008_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W5p-8De_Iy0Q7kNvwFfCzoY&_nc_oc=AdqcU9uqxlqRBq-2mx8P3-V8GJ3c9xcBGRCggkXmUaRjiHKWNUd8Ioo_JA-LvVT23_w&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJJegO15xix0WlpmYy3-r5YuvBuNsmDYE_mMRShBG_cyg&oe=6AA16E1D"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Zoo Park", "keywords": ["animals", "zoo", "park", "forest", "nature"], "long_description": "Zoo Park was developed for you to see the animals on their natural environment with the beautiful graphics and sounds. \n\nUsing your virtual reality glasses, you can see the animals moving closely with animations. It will be an exciting journey for you. \n\nYou don't need to go to a zoo to see the animals. Your children will also enjoy the virtual simulations as if they are in a zoo and know the names of many animals. Elephant, Lion, Lioness, Zebra, Crocodile, Hippopotamus, Rhinoceros, Chicken, Cow, Goat, Pig, Sheep, Bear, Boar, Fox, Rabbit, Stag, Wolf, Crow and more.\n\nHow to play\nIt is very easy. You should look at where you want to move. When you approach to animals, your movements will be slower or stop so that you will have time to examine them closely. You can use touchpad to go forward, back, left and right.\n\nFeatures\n- Very beautiful graphics. Realistic forest environment\n- Nice animated animals in Zoo\n- Natural sounds of animals", "short_description": "Zoo Park was developed for you to see the animals on their natural environment with the beautiful graphics and sounds."}]}, "developer_name": null, "developer_privacy_policy_url": "http://provr.net/privacy2.html", "developer_terms_of_service_url": "http://provr.net/privacy2.html", "publisher_name": "HASoft", "support_website_url": null, "website_url": "https://www.facebook.com/HASoft-Mobile-GamesApplications-680466725426771", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE", "EDUCATIONAL", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD", "GEAR_VR_CONTROLLE
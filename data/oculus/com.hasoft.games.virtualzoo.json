jF_U30Im4pEo2kWFFFUPuCnBDVzyqQP2fg&oe=699DAF06"}, {"file_name": "migrated_image.png", "id": "208088447206320", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/11162716_476745332724218_1676433208595447808_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x15E6WrmvZcQ7kNvwGWB_2F&_nc_oc=Adnx0dS3bOapZWX2x1d43Ko3tBdynA2D5hQWRiomSIFzDRGDDM3UTqLqYWUint88m-s&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfvG9oiwA9l25qbg50PEhiOhsfW2Foyx8-zi7AzmPG8itQ&oe=699D96D6"}, {"file_name": "migrated_image.png", "id": "290138991968813", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/11162690_510656702601736_3434315365243420672_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BnTaysw2KG8Q7kNvwF-scv1&_nc_oc=Adktt6Ti2VDGTXolc1eIzVu3NpQ7wWld_A-1wjd4fvtkAMVwNF04WthRiChUIF4SJ0Y&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Afv7KI4C3rmKp6i1J01ph0nzgsZsj36jqdPrsA1Ymzacmg&oe=699D89DA"}, {"file_name": "migrated_image.png", "id": "2526122730961072", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/11162700_286111548569698_6750775844337090560_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OdXrwwukJAoQ7kNvwEC4BmJ&_nc_oc=AdktBs9WSr9OA1hCv69G46slhooRLvq-8kS4wOXIwmw9Lr4sz8sxHkSjk9XKGFGNw9o&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Aftv-Hhw0y8_gZPOwUCCIMZZ9LZOtSfvT2HToDCRPHQFCg&oe=699DAFE5"}, {"file_name": "migrated_image.png", "id": "526738798265020", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/11162682_179116105994090_8275689972598571008_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aOZvHQUveEYQ7kNvwHBYraV&_nc_oc=AdmVbCf3Q5pxBn0AimfCcOHx7-_UV2gvSVc_x0GYFNbuYTyAxUjiOabFMQ8SVQvO2yc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Aft9mCokFwZHRLk2mLLFDreDt9rAboPhOtdPFfNfeZezNw&oe=699DB69D"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Zoo Park", "keywords": ["animals", "zoo", "park", "forest", "nature"], "long_description": "Zoo Park was developed for you to see the animals on their natural environment with the beautiful graphics and sounds. \n\nUsing your virtual reality glasses, you can see the animals moving closely with animations. It will be an exciting journey for you. \n\nYou don't need to go to a zoo to see the animals. Your children will also enjoy the virtual simulations as if they are in a zoo and know the names of many animals. Elephant, Lion, Lioness, Zebra, Crocodile, Hippopotamus, Rhinoceros, Chicken, Cow, Goat, Pig, Sheep, Bear, Boar, Fox, Rabbit, Stag, Wolf, Crow and more.\n\nHow to play\nIt is very easy. You should look at where you want to move. When you approach to animals, your movements will be slower or stop so that you will have time to examine them closely. You can use touchpad to go forward, back, left and right.\n\nFeatures\n- Very beautiful graphics. Realistic forest environment\n- Nice animated animals in Zoo\n- Natural sounds of animals", "short_description": "Zoo Park was developed for you to see the animals on their natural environment with the beautiful graphics and sounds."}]}, "developer_name": null, "developer_privacy_policy_url": "http://provr.net/privacy2.html", "developer_terms_of_service_url": "http://provr.net/privacy2.html", "publisher_name": "HASoft", "support_website_url": null, "website_url": "https://www.facebook.com/HASoft-Mobile-GamesApplications-680466725426771", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE", "EDUCATIONAL", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD", "GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "662532501863457"}, "review_messages": [
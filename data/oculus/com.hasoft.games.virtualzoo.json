IJSo_dxzcIBSQy1KvPeNJsIx3E&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRzdBFcvdtvxzemZoLcN0Vw1gFJ7iMjYYMraQUl8AC2BQ&oe=6AF32386"}, {"file_name": "migrated_image.png", "id": "208088447206320", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/11162716_476745332724218_1676433208595447808_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EOu_k9K6gQsQ7kNvwGvAGzr&_nc_oc=Adoc81VSVh0Hg1TGo4KQSXkEfEtbyNs5xsXdRR2fkQxTAPlykKfxL7uKNOXcP3RvowM&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQscN2qRVXnRf5KiuFiy5frGGla7Ud9-VuQtvkMPTMpog&oe=6AF34396"}, {"file_name": "migrated_image.png", "id": "290138991968813", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/11162690_510656702601736_3434315365243420672_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fdtzJ1PZi9EQ7kNvwHmEImN&_nc_oc=Adob1CzmGKzSO2WRva_KpnwVvDbTHiuRzhN8AqnrcnC_0lgPli0Rt5BY0o2XraEF200&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR_XrKzEKmibNcdiiCZkDaZcMu0YXiwCA-KdyTFhtCBZQ&oe=6AF3369A"}, {"file_name": "migrated_image.png", "id": "2526122730961072", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/11162700_286111548569698_6750775844337090560_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4zGO_ZMHPOIQ7kNvwG2LDN-&_nc_oc=Adqm_xUF2fimSzpcCWBeMl4HzuSgL80Hu0pCJcW-L8tOgyjC-Fdu-sWuEy-7o3gm7Zk&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTdIVrVDPTNOrjp3pMGqfPJYhXejZVU7rTYLc2h_3OeBg&oe=6AF32465"}, {"file_name": "migrated_image.png", "id": "526738798265020", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/11162682_179116105994090_8275689972598571008_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Niuy6oVUgTgQ7kNvwEJ0SIJ&_nc_oc=AdrAiF4bj9A738HaniVcItyXAiSufhxNK5ciUCkbZ9T4UPbiGnGdAVePeWEtFBm0Yog&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSSo6jMbG53PiQC3mwFVdJ9gouy9wUxNcUO9u7RwHXazA&oe=6AF32B1D"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Zoo Park", "keywords": ["animals", "zoo", "park", "forest", "nature"], "long_description": "Zoo Park was developed for you to see the animals on their natural environment with the beautiful graphics and sounds. \n\nUsing your virtual reality glasses, you can see the animals moving closely with animations. It will be an exciting journey for you. \n\nYou don't need to go to a zoo to see the animals. Your children will also enjoy the virtual simulations as if they are in a zoo and know the names of many animals. Elephant, Lion, Lioness, Zebra, Crocodile, Hippopotamus, Rhinoceros, Chicken, Cow, Goat, Pig, Sheep, Bear, Boar, Fox, Rabbit, Stag, Wolf, Crow and more.\n\nHow to play\nIt is very easy. You should look at where you want to move. When you approach to animals, your movements will be slower or stop so that you will have time to examine them closely. You can use touchpad to go forward, back, left and right.\n\nFeatures\n- Very beautiful graphics. Realistic forest environment\n- Nice animated animals in Zoo\n- Natural sounds of animals", "short_description": "Zoo Park was developed for you to see the animals on their natural environment with the beautiful graphics and sounds."}]}, "developer_name": null, "developer_privacy_policy_url": "http://provr.net/privacy2.html", "developer_terms_of_service_url": "http://provr.net/privacy2.html", "publisher_name": "HASoft", "support_website_url": null, "website_url": "https://www.facebook.com/HASoft-Mobile-GamesApplications-680466725426771", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE", "EDUCATIONAL", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD", "GEAR_VR_CONTROLLE
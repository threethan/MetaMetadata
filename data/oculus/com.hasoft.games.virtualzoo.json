M3wsozZYJQPN8etXVkSkBngbmo&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSidB6U-AjksK_W5OOLDdGWh6ZpGnWnb1YnqMgbautjnw&oe=6AE89786"}, {"file_name": "migrated_image.png", "id": "208088447206320", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/11162716_476745332724218_1676433208595447808_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mJraBD5H77gQ7kNvwFJc39k&_nc_oc=AdpwCcBBkdJ-nfc-XntWrKOyt0YuND_ePEUoJEYXSaRNGqD3cKSZH1hZmbkHzfwGmeA&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRwMXioBrJ4GeY5Cmq1tbj4XQE_zD_2jvFIjEu9jTKS8A&oe=6AE8B796"}, {"file_name": "migrated_image.png", "id": "290138991968813", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/11162690_510656702601736_3434315365243420672_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dcN9GYAyW7gQ7kNvwHdnZBA&_nc_oc=AdrK6e-T-88IUNwYa6AmsepWj6HSlJZAhSv-s46xnzqn-yI1PWhq7LMn7NBH8JijFIw&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSmxdW_X2r5tkg-Ddpv-gM9zOd7uIsueA7xGpx5skp9QA&oe=6AE8AA9A"}, {"file_name": "migrated_image.png", "id": "2526122730961072", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/11162700_286111548569698_6750775844337090560_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OjE-qmg6aCIQ7kNvwGdb2Pi&_nc_oc=AdrUxzm8FhjXSIO_4C_l9z7u9WgTx25Ihb_3psmbs80lxIeSk7Pnb5VIi2RlH0cPpQA&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQZ7JSGLeqrNM8RjgkPG3Lev7_-3kN5M-FS5K29_P0xcQ&oe=6AE89865"}, {"file_name": "migrated_image.png", "id": "526738798265020", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/11162682_179116105994090_8275689972598571008_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QJ1KVigqW3kQ7kNvwG77n21&_nc_oc=AdpPWHHvOUBFAtZZWaix_1i3vy9AwwIwqmi8pX-aakhS8_RQnMvnYxqLBYAleXdokms&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSp77ktxJoiwDArd2SUpu9SwUruWIlGPY_6v5uS1LZsJg&oe=6AE89F1D"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Zoo Park", "keywords": ["animals", "zoo", "park", "forest", "nature"], "long_description": "Zoo Park was developed for you to see the animals on their natural environment with the beautiful graphics and sounds. \n\nUsing your virtual reality glasses, you can see the animals moving closely with animations. It will be an exciting journey for you. \n\nYou don't need to go to a zoo to see the animals. Your children will also enjoy the virtual simulations as if they are in a zoo and know the names of many animals. Elephant, Lion, Lioness, Zebra, Crocodile, Hippopotamus, Rhinoceros, Chicken, Cow, Goat, Pig, Sheep, Bear, Boar, Fox, Rabbit, Stag, Wolf, Crow and more.\n\nHow to play\nIt is very easy. You should look at where you want to move. When you approach to animals, your movements will be slower or stop so that you will have time to examine them closely. You can use touchpad to go forward, back, left and right.\n\nFeatures\n- Very beautiful graphics. Realistic forest environment\n- Nice animated animals in Zoo\n- Natural sounds of animals", "short_description": "Zoo Park was developed for you to see the animals on their natural environment with the beautiful graphics and sounds."}]}, "developer_name": null, "developer_privacy_policy_url": "http://provr.net/privacy2.html", "developer_terms_of_service_url": "http://provr.net/privacy2.html", "publisher_name": "HASoft", "support_website_url": null, "website_url": "https://www.facebook.com/HASoft-Mobile-GamesApplications-680466725426771", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE", "EDUCATIONAL", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD", "GEAR_VR_CONTROLLE
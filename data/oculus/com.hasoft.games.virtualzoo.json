6ziPiLLckvBqjuDpXxi8WcQmlY&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDvyvYy-bEy14pKuGilaw3vFDC775MMj8P1o6EpK65wig&oe=6A4A6386"}, {"file_name": "migrated_image.png", "id": "208088447206320", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/11162716_476745332724218_1676433208595447808_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Cv6kgcSOCRwQ7kNvwGwg96x&_nc_oc=Adp3NBPtwS0uyFxaMQ78CJbdCI7wKXn_jxiukNhbLNwuP_Dfl1gSYccNzZ5EMIKXs7Q&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD__uxLVkpiCxQVgcT9aLBKh3Xf8Cc6EPyMZmacSpQLhw&oe=6A4A8396"}, {"file_name": "migrated_image.png", "id": "290138991968813", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/11162690_510656702601736_3434315365243420672_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DrGFhlWftO4Q7kNvwGXWlGU&_nc_oc=Adq3S4vqVWQfoWgLm49_q5fMvrxlVzvyaNYSlXspE11yGy2PbuULrdl3_CmIOhOV9xo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCoiHOrJv7bot5uXy_xdjXo5C4OGL7Vzwl2wwY8eRjovA&oe=6A4A769A"}, {"file_name": "migrated_image.png", "id": "2526122730961072", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/11162700_286111548569698_6750775844337090560_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hQX00_m5RRgQ7kNvwFnQA3V&_nc_oc=Adqv4iFDdwxzngbNBw9UP8JsfM9dWAf-ztsJTyFCampLRZSJxc7lh7LRZSKTH9trobY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAVu-P0HEXppMPUSptbQJsi95NqNvFAZpmeImen6qQ_yw&oe=6A4A6465"}, {"file_name": "migrated_image.png", "id": "526738798265020", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/11162682_179116105994090_8275689972598571008_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uFs6qs0pMu8Q7kNvwFD8Fc5&_nc_oc=AdqUykt91TiePjcAj-2JNtdjnsk0SGlUfmaypnbI1eJZMo_lToRx5NBw8iX19h-iTNs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBYDlxzdSxC2Z7YPd_rEAQMmcvA5cMLMkPoA_ns2Oz0vg&oe=6A4A6B1D"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Zoo Park", "keywords": ["animals", "zoo", "park", "forest", "nature"], "long_description": "Zoo Park was developed for you to see the animals on their natural environment with the beautiful graphics and sounds. \n\nUsing your virtual reality glasses, you can see the animals moving closely with animations. It will be an exciting journey for you. \n\nYou don't need to go to a zoo to see the animals. Your children will also enjoy the virtual simulations as if they are in a zoo and know the names of many animals. Elephant, Lion, Lioness, Zebra, Crocodile, Hippopotamus, Rhinoceros, Chicken, Cow, Goat, Pig, Sheep, Bear, Boar, Fox, Rabbit, Stag, Wolf, Crow and more.\n\nHow to play\nIt is very easy. You should look at where you want to move. When you approach to animals, your movements will be slower or stop so that you will have time to examine them closely. You can use touchpad to go forward, back, left and right.\n\nFeatures\n- Very beautiful graphics. Realistic forest environment\n- Nice animated animals in Zoo\n- Natural sounds of animals", "short_description": "Zoo Park was developed for you to see the animals on their natural environment with the beautiful graphics and sounds."}]}, "developer_name": null, "developer_privacy_policy_url": "http://provr.net/privacy2.html", "developer_terms_of_service_url": "http://provr.net/privacy2.html", "publisher_name": "HASoft", "support_website_url": null, "website_url": "https://www.facebook.com/HASoft-Mobile-GamesApplications-680466725426771", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE", "EDUCATIONAL", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD", "GEAR_VR_CONTROLLE
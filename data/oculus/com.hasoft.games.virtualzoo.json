a75JclK-a_Woo0ci3HqlVXf6ZU&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHMeg-0wrPhE0lOePf7c5EiR1I9JW8Kql__Q1HT0q4IIQ&oe=6A92E606"}, {"file_name": "migrated_image.png", "id": "208088447206320", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/11162716_476745332724218_1676433208595447808_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PwWI6OcNRlkQ7kNvwG14SH6&_nc_oc=AdrNzelFLZ2oS9iYM12urm5AMSt1qiPokOYPJzyU6Dd-iDMzA46S1r9t_KXUi87iFNM&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHgI7fOGniEYagGxH1vizCylNBUAzCZvJ8azaTxyWa8gA&oe=6A92CDD6"}, {"file_name": "migrated_image.png", "id": "290138991968813", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/11162690_510656702601736_3434315365243420672_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GQg4A2Hi2z4Q7kNvwGFaTGJ&_nc_oc=AdqcnNeFXn2GEBIU5Ff_j60bgMzvOd6Fi8YhE-UiLMJ5drmtTMhZVgym8kNuQfGjdOU&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGMQUWn4ffQhK_SmoGqX8V5hsKIJa5M4blLeRyBC0Vi9w&oe=6A92C0DA"}, {"file_name": "migrated_image.png", "id": "2526122730961072", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/11162700_286111548569698_6750775844337090560_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5ij2Q1BSIJsQ7kNvwH4xtY3&_nc_oc=AdrsdZ4dp3hsVz29aDrPCzTz9z2gLK41GfMzsmlmEj2Pcc-D9sZvgNc3Y543riqHadk&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGchY1MG__YzapDgwiFOMa8K-qqg9dBeSks3Nn4oCEPOw&oe=6A92AEA5"}, {"file_name": "migrated_image.png", "id": "526738798265020", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/11162682_179116105994090_8275689972598571008_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9xQnFxi4k0wQ7kNvwGGQbs7&_nc_oc=AdoRRIR66RVRgeBI4-pLjwgMBEbtBNlkDqt_fh40Uk3igTeEwo7Yp0O3N20aoYRXWkQ&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHaWdWUgPPIJ6cxpQWDJqCort4M3xk8ML8u477R8Y6DwQ&oe=6A92B55D"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Zoo Park", "keywords": ["animals", "zoo", "park", "forest", "nature"], "long_description": "Zoo Park was developed for you to see the animals on their natural environment with the beautiful graphics and sounds. \n\nUsing your virtual reality glasses, you can see the animals moving closely with animations. It will be an exciting journey for you. \n\nYou don't need to go to a zoo to see the animals. Your children will also enjoy the virtual simulations as if they are in a zoo and know the names of many animals. Elephant, Lion, Lioness, Zebra, Crocodile, Hippopotamus, Rhinoceros, Chicken, Cow, Goat, Pig, Sheep, Bear, Boar, Fox, Rabbit, Stag, Wolf, Crow and more.\n\nHow to play\nIt is very easy. You should look at where you want to move. When you approach to animals, your movements will be slower or stop so that you will have time to examine them closely. You can use touchpad to go forward, back, left and right.\n\nFeatures\n- Very beautiful graphics. Realistic forest environment\n- Nice animated animals in Zoo\n- Natural sounds of animals", "short_description": "Zoo Park was developed for you to see the animals on their natural environment with the beautiful graphics and sounds."}]}, "developer_name": null, "developer_privacy_policy_url": "http://provr.net/privacy2.html", "developer_terms_of_service_url": "http://provr.net/privacy2.html", "publisher_name": "HASoft", "support_website_url": null, "website_url": "https://www.facebook.com/HASoft-Mobile-GamesApplications-680466725426771", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE", "EDUCATIONAL", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD", "GEAR_VR_CONTROLLE
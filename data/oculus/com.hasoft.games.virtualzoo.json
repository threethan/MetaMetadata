f5JrwTjSgt9830M3hQvY2gvEqM&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMNsJ-Lp9sCDtQ-YXRpcCwLKhtyriUA35zfcA4ICu_qbA&oe=6ACF8B06"}, {"file_name": "migrated_image.png", "id": "208088447206320", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/11162716_476745332724218_1676433208595447808_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VfS7gO-OA2gQ7kNvwEtvR49&_nc_oc=AdpNcPAFpU2V8Ad_X0eUPnCJOskF9MgueWp9XGR4VSmH0p78KHvNWqr_zdP8MIOp1lw&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOa6wpArCuMmQ8OHxXkJyFfGrpMoZWUOzeSGDaUfRgwCA&oe=6ACFAB16"}, {"file_name": "migrated_image.png", "id": "290138991968813", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/11162690_510656702601736_3434315365243420672_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nmArec8iFysQ7kNvwG4RyMn&_nc_oc=AdqycoTcKtSIISK8Os1gVwNfStI16DT1uMueJdxTKjjUt004CgzIhi0zUESQlXd2xqE&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOTKtbK6Qx5SwQaoyHrPRBxHSTInRo1mHJXjhYFJtYqQg&oe=6ACF9E1A"}, {"file_name": "migrated_image.png", "id": "2526122730961072", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/11162700_286111548569698_6750775844337090560_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l9eBEOxqXiYQ7kNvwHR1cgT&_nc_oc=AdqVz1oofVbiYA34KpPPR-blLWOKRVRp6BGCmw-G6DwPxDtfRmeGSmfE4ENElloTpKw&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOSG0_9mgPDldKI5uq1xB9nlQonN2Cc_1gdwlNAxnKlwA&oe=6ACF8BE5"}, {"file_name": "migrated_image.png", "id": "526738798265020", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/11162682_179116105994090_8275689972598571008_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XNcb__LzhkIQ7kNvwFMtB_Z&_nc_oc=AdovaR4nDl-RKDtnXiGi4tsCUyU8YZb2VaWm_SFKsXxWG2-mtznF-zfvYeak5jUg4VY&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNze1hxiy01Z8pkLfuX0UETGh5OKCOt_6oHFZwmm0Matw&oe=6ACF929D"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Zoo Park", "keywords": ["animals", "zoo", "park", "forest", "nature"], "long_description": "Zoo Park was developed for you to see the animals on their natural environment with the beautiful graphics and sounds. \n\nUsing your virtual reality glasses, you can see the animals moving closely with animations. It will be an exciting journey for you. \n\nYou don't need to go to a zoo to see the animals. Your children will also enjoy the virtual simulations as if they are in a zoo and know the names of many animals. Elephant, Lion, Lioness, Zebra, Crocodile, Hippopotamus, Rhinoceros, Chicken, Cow, Goat, Pig, Sheep, Bear, Boar, Fox, Rabbit, Stag, Wolf, Crow and more.\n\nHow to play\nIt is very easy. You should look at where you want to move. When you approach to animals, your movements will be slower or stop so that you will have time to examine them closely. You can use touchpad to go forward, back, left and right.\n\nFeatures\n- Very beautiful graphics. Realistic forest environment\n- Nice animated animals in Zoo\n- Natural sounds of animals", "short_description": "Zoo Park was developed for you to see the animals on their natural environment with the beautiful graphics and sounds."}]}, "developer_name": null, "developer_privacy_policy_url": "http://provr.net/privacy2.html", "developer_terms_of_service_url": "http://provr.net/privacy2.html", "publisher_name": "HASoft", "support_website_url": null, "website_url": "https://www.facebook.com/HASoft-Mobile-GamesApplications-680466725426771", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE", "EDUCATIONAL", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD", "GEAR_VR_CONTROLLE
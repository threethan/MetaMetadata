L1xeLBwf7iONrzIvpCT1ryb02Q&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBSHq1e3SyauGTketgCs_xox9Vj4qoEvDSqdUMxT_gAzw&oe=6A539E06"}, {"file_name": "migrated_image.png", "id": "208088447206320", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/11162716_476745332724218_1676433208595447808_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a4zA9VNTztMQ7kNvwGld-gR&_nc_oc=Adr_VBWUfmqJbdlnN9m8-yPWUCkHMjvi0wBP0u8J1AkLMvqRIZBYkp6iu9g8qLVu8Dw&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAYSnAR3u0yvoliICdhQTISCGWPVU32IM405ncNZuNlsA&oe=6A5385D6"}, {"file_name": "migrated_image.png", "id": "290138991968813", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/11162690_510656702601736_3434315365243420672_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1B0Zftf9Al4Q7kNvwE0tlkn&_nc_oc=AdqxTdvjx8YPUowzc2lZ_4xa4UDXH5T2dVShOYcCIrFyso9z1ehVlUTL7P69tMAwbTo&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC4Ol-tLniLf-y__gzKHiOgdErLpctQUCwqxcHJeUc-WA&oe=6A53B11A"}, {"file_name": "migrated_image.png", "id": "2526122730961072", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/11162700_286111548569698_6750775844337090560_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n8uYg573eq0Q7kNvwF3yVS1&_nc_oc=Adpm5cCRZF0wfUNXF-qZWxoHCFz4Wd19iwfupNDiNAb-h7Upttv1e9GtlgbWveDaVHY&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCAufnXI9Ah5d53Uv4ajotu1HH11ddcKD36aD52gHW18g&oe=6A539EE5"}, {"file_name": "migrated_image.png", "id": "526738798265020", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/11162682_179116105994090_8275689972598571008_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CU1LP61VZAYQ7kNvwFgcBdi&_nc_oc=AdqJ72qOUn9hsxtioTd38j7GuHgCcbGRG96BdWSmff47Fsrs63rwvaJatlOXERGD2aY&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDqUdJjsl9i7PvBOeLFg7k2KcIAVz-zUykwp7knAHqnbg&oe=6A53A59D"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Zoo Park", "keywords": ["animals", "zoo", "park", "forest", "nature"], "long_description": "Zoo Park was developed for you to see the animals on their natural environment with the beautiful graphics and sounds. \n\nUsing your virtual reality glasses, you can see the animals moving closely with animations. It will be an exciting journey for you. \n\nYou don't need to go to a zoo to see the animals. Your children will also enjoy the virtual simulations as if they are in a zoo and know the names of many animals. Elephant, Lion, Lioness, Zebra, Crocodile, Hippopotamus, Rhinoceros, Chicken, Cow, Goat, Pig, Sheep, Bear, Boar, Fox, Rabbit, Stag, Wolf, Crow and more.\n\nHow to play\nIt is very easy. You should look at where you want to move. When you approach to animals, your movements will be slower or stop so that you will have time to examine them closely. You can use touchpad to go forward, back, left and right.\n\nFeatures\n- Very beautiful graphics. Realistic forest environment\n- Nice animated animals in Zoo\n- Natural sounds of animals", "short_description": "Zoo Park was developed for you to see the animals on their natural environment with the beautiful graphics and sounds."}]}, "developer_name": null, "developer_privacy_policy_url": "http://provr.net/privacy2.html", "developer_terms_of_service_url": "http://provr.net/privacy2.html", "publisher_name": "HASoft", "support_website_url": null, "website_url": "https://www.facebook.com/HASoft-Mobile-GamesApplications-680466725426771", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE", "EDUCATIONAL", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD", "GEAR_VR_CONTROLLE
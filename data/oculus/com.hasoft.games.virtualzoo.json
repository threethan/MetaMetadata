m_JqQDX9HAVR1umOiyJv5YSKJM&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Afw982V-nT9oSrJidhUDMXNQV2wCyD-u9vWif4ZIEBV2-w&oe=69C68D86"}, {"file_name": "migrated_image.png", "id": "208088447206320", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/11162716_476745332724218_1676433208595447808_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XS8Uf0_SVuQQ7kNvwFGOsiM&_nc_oc=AdosVC4UIgvgMi-f4GtOP8ePyHPdfP9LtBl_17WXgTdp_keqOKNEW7wTWkZeladbsyE&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyaQVHW1-H-EvbE4uireVX1S6AIL8TXzYHp01YdjIr0Dw&oe=69C67556"}, {"file_name": "migrated_image.png", "id": "290138991968813", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/11162690_510656702601736_3434315365243420672_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YrhgaCzB_FwQ7kNvwH5hL1k&_nc_oc=AdoxzpFzNur0hW-IEfqkgzixhncgF3Vwzbn1VnwDhCOgmSjxJLZ3j489R3L1v1S4RDA&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzBcrWQ4Afn35w-kQHj_jE7SZu1t-K0204cXF5s8oWQ_g&oe=69C6685A"}, {"file_name": "migrated_image.png", "id": "2526122730961072", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/11162700_286111548569698_6750775844337090560_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rjEle74hGTMQ7kNvwGl2quQ&_nc_oc=AdpVvewL_qv2u729qjyDQ6XzywZiswzd6NrM0MQUClde8Xg8gkwXWc4FFz3KRx4yXnU&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxdpYsn4e5vvW-c52iH1606cOQXuretjWK4LIdkVniIbg&oe=69C68E65"}, {"file_name": "migrated_image.png", "id": "526738798265020", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/11162682_179116105994090_8275689972598571008_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TpIThMAHamEQ7kNvwHn4H0D&_nc_oc=AdrwLIxxVYyKDA42j6HIW3nVQol3raksIQHPxNk49kbVI9MmiNpIt1hyFYsZ-qPL_DA&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afyzl5FU90AmoLmOVVoehMrrsN7EQwjZNkAmigVyQNTByQ&oe=69C6951D"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Zoo Park", "keywords": ["animals", "zoo", "park", "forest", "nature"], "long_description": "Zoo Park was developed for you to see the animals on their natural environment with the beautiful graphics and sounds. \n\nUsing your virtual reality glasses, you can see the animals moving closely with animations. It will be an exciting journey for you. \n\nYou don't need to go to a zoo to see the animals. Your children will also enjoy the virtual simulations as if they are in a zoo and know the names of many animals. Elephant, Lion, Lioness, Zebra, Crocodile, Hippopotamus, Rhinoceros, Chicken, Cow, Goat, Pig, Sheep, Bear, Boar, Fox, Rabbit, Stag, Wolf, Crow and more.\n\nHow to play\nIt is very easy. You should look at where you want to move. When you approach to animals, your movements will be slower or stop so that you will have time to examine them closely. You can use touchpad to go forward, back, left and right.\n\nFeatures\n- Very beautiful graphics. Realistic forest environment\n- Nice animated animals in Zoo\n- Natural sounds of animals", "short_description": "Zoo Park was developed for you to see the animals on their natural environment with the beautiful graphics and sounds."}]}, "developer_name": null, "developer_privacy_policy_url": "http://provr.net/privacy2.html", "developer_terms_of_service_url": "http://provr.net/privacy2.html", "publisher_name": "HASoft", "support_website_url": null, "website_url": "https://www.facebook.com/HASoft-Mobile-GamesApplications-680466725426771", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE", "EDUCATIONAL", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD", "GEAR_VR_CONTROLLE
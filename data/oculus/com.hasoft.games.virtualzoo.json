AySXZBwtaEBxL2j5qM80MlnAFQ&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af24S4iHa0ZcxEcye6VTdLMYGBAzQz7JD_bi0TC5vxBH6A&oe=69E23D06"}, {"file_name": "migrated_image.png", "id": "208088447206320", "uri": "https://scontent-lhr8-1.oculuscdn.com/v/t64.5771-25/11162716_476745332724218_1676433208595447808_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W3-XyoqhIGAQ7kNvwFnJaO8&_nc_oc=Adp_mV_Cl16Vpj7Kzv1-EhZ19tI0q7XhpVvobsgnAZfU7FJ_Q5zDjJ0__OuS_VfTc6E&_nc_zt=3&_nc_ht=scontent-lhr8-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af20LcG9oSaYVvQyNO_9XsKN0HwQTist9GGcy9MfU-qT1A&oe=69E224D6"}, {"file_name": "migrated_image.png", "id": "290138991968813", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/11162690_510656702601736_3434315365243420672_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ULLDtimxWZYQ7kNvwFCD8wU&_nc_oc=Adpajq4uUO8R_IM7_3miyJjpG7xK2qecEMaUwv9ukFXDf7GnwJLKjo0EeCN6rlKACLg&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3GjHkxDPRA5M-LZveyk-R2kmtTANRIYrppoCo9pIRY_w&oe=69E2501A"}, {"file_name": "migrated_image.png", "id": "2526122730961072", "uri": "https://scontent-lhr8-2.oculuscdn.com/v/t64.5771-25/11162700_286111548569698_6750775844337090560_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=p4DZzNLQuBgQ7kNvwFFrBkN&_nc_oc=AdrFe94bUdWqOp6AfTM5SkQ_yu0cjT3--LUKgNOknrti7X63EplsqlST6jkrOC7TkGE&_nc_zt=3&_nc_ht=scontent-lhr8-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0KgeqG-x9oy80OAkeblQQL5ZPgvB48GawB7iKhQJD1oA&oe=69E23DE5"}, {"file_name": "migrated_image.png", "id": "526738798265020", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/11162682_179116105994090_8275689972598571008_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Okyu7E1E-cUQ7kNvwFBRyCf&_nc_oc=AdoIB7KVOabNXx0Ila3nnC6_Nxh7MuLSVhnaTYIyVw61sLB0YdOnS-XTsE5i-F13eng&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af39Ehlwk47eml2ywoNnQJipmOd5JLOOOMltleo2jjPf1Q&oe=69E2449D"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Zoo Park", "keywords": ["animals", "zoo", "park", "forest", "nature"], "long_description": "Zoo Park was developed for you to see the animals on their natural environment with the beautiful graphics and sounds. \n\nUsing your virtual reality glasses, you can see the animals moving closely with animations. It will be an exciting journey for you. \n\nYou don't need to go to a zoo to see the animals. Your children will also enjoy the virtual simulations as if they are in a zoo and know the names of many animals. Elephant, Lion, Lioness, Zebra, Crocodile, Hippopotamus, Rhinoceros, Chicken, Cow, Goat, Pig, Sheep, Bear, Boar, Fox, Rabbit, Stag, Wolf, Crow and more.\n\nHow to play\nIt is very easy. You should look at where you want to move. When you approach to animals, your movements will be slower or stop so that you will have time to examine them closely. You can use touchpad to go forward, back, left and right.\n\nFeatures\n- Very beautiful graphics. Realistic forest environment\n- Nice animated animals in Zoo\n- Natural sounds of animals", "short_description": "Zoo Park was developed for you to see the animals on their natural environment with the beautiful graphics and sounds."}]}, "developer_name": null, "developer_privacy_policy_url": "http://provr.net/privacy2.html", "developer_terms_of_service_url": "http://provr.net/privacy2.html", "publisher_name": "HASoft", "support_website_url": null, "website_url": "https://www.facebook.com/HASoft-Mobile-GamesApplications-680466725426771", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE", "EDUCATIONAL", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD", "GEAR_VR_CONTROLLE
UtX2GTIQpET99KLdljXEe1eevQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8xodsuTgZ8YOWwjgownqSiOR_SPKtCzMJv6xr5nHqR5A&oe=6A315706"}, {"file_name": "migrated_image.png", "id": "208088447206320", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/11162716_476745332724218_1676433208595447808_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gttPKxwBWbAQ7kNvwGrwILD&_nc_oc=Adom_mF3_p9FOHhn4jl7dNoKE-n2aEijEAcdpKyydtEBbieT7hKrZOu-VEKb-8_K_eo&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af97zp6ibFNTttdGSW2dupHqChGp7KFb-W7c-Abjid4FNA&oe=6A317716"}, {"file_name": "migrated_image.png", "id": "290138991968813", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/11162690_510656702601736_3434315365243420672_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=X-1dBRKifaEQ7kNvwF92Fad&_nc_oc=Adp4fGNusdcYLBrzb42fYq7XhjIsUN4wb9vyJNkApTT61oWxebpa_zPOxUi6e9LLVvE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af98JCoQZcx-LkiovRHQLZOTX4-kAZSZhNzNy8fi3Hrf3w&oe=6A316A1A"}, {"file_name": "migrated_image.png", "id": "2526122730961072", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/11162700_286111548569698_6750775844337090560_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G737ICIsv54Q7kNvwFA2TJq&_nc_oc=Adp18QOmVFCLf54Ij2Iv1HUejhaeVXK3dYo7qD3I5sStdPfo7LwyJBbSNLLeRxhcNtc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8MQSUr0ruec04x5mFqo3BsOGcjCNq1YT91oSXJBZZ6YA&oe=6A3157E5"}, {"file_name": "migrated_image.png", "id": "526738798265020", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/11162682_179116105994090_8275689972598571008_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ow3ASs-vZ4YQ7kNvwEgX15A&_nc_oc=Ado-WN5R4D5wh8fyZddDmGep7JvYcKq0r6iSW8rNEPVLT1S7mBFI-KuOKP2O8CVt9uQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9XuEyv150bS-_5E8g3c2QWEHH-C5bvuDrpJID6Sf6How&oe=6A315E9D"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Zoo Park", "keywords": ["animals", "zoo", "park", "forest", "nature"], "long_description": "Zoo Park was developed for you to see the animals on their natural environment with the beautiful graphics and sounds. \n\nUsing your virtual reality glasses, you can see the animals moving closely with animations. It will be an exciting journey for you. \n\nYou don't need to go to a zoo to see the animals. Your children will also enjoy the virtual simulations as if they are in a zoo and know the names of many animals. Elephant, Lion, Lioness, Zebra, Crocodile, Hippopotamus, Rhinoceros, Chicken, Cow, Goat, Pig, Sheep, Bear, Boar, Fox, Rabbit, Stag, Wolf, Crow and more.\n\nHow to play\nIt is very easy. You should look at where you want to move. When you approach to animals, your movements will be slower or stop so that you will have time to examine them closely. You can use touchpad to go forward, back, left and right.\n\nFeatures\n- Very beautiful graphics. Realistic forest environment\n- Nice animated animals in Zoo\n- Natural sounds of animals", "short_description": "Zoo Park was developed for you to see the animals on their natural environment with the beautiful graphics and sounds."}]}, "developer_name": null, "developer_privacy_policy_url": "http://provr.net/privacy2.html", "developer_terms_of_service_url": "http://provr.net/privacy2.html", "publisher_name": "HASoft", "support_website_url": null, "website_url": "https://www.facebook.com/HASoft-Mobile-GamesApplications-680466725426771", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE", "EDUCATIONAL", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD", "GEAR_VR_CONTROLLE
iCHJN9sef8etiBjtoPAbN8-eqZVAzUgQTA&oe=69A6E986"}, {"file_name": "migrated_image.png", "id": "208088447206320", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/11162716_476745332724218_1676433208595447808_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tg7hf5y2ZDsQ7kNvwFR5whQ&_nc_oc=AdmeT1KljP29IwqCa2BkRlQt45ufIC8A6E6blc3TXWTPryTRmidvE_mx3Y9k9L1Wi7k&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Aft_jR5512EQB6Bq4HytLIwGBZLG0nFcRpm9Pi0Mn0CKAQ&oe=69A6D156"}, {"file_name": "migrated_image.png", "id": "290138991968813", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/11162690_510656702601736_3434315365243420672_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TaonL2ZpTsQQ7kNvwHiFZB2&_nc_oc=Adk1i08YWNccVaxrEvbc9RcSR_A_FvRwGpAt0G-wmXsrYiez7FyIir1KxeORJumHKCg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfsrcYATQM_K_YyOj2i89hQjeE-l3Hw6T4aKnOWitDkF5w&oe=69A6C45A"}, {"file_name": "migrated_image.png", "id": "2526122730961072", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/11162700_286111548569698_6750775844337090560_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dQwoC2Wi2gUQ7kNvwGu4gwp&_nc_oc=AdnFuqOZMrUl_q2ZLO9iOGOfEcbuPye2cYi0o7mdB0_RkW6X_q1GY2gT58a5hLQgR60&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfsxSOSmCtTxFDqnf23qFJ8w1CQ9VeqPv0OrJogj7XKkhw&oe=69A6EA65"}, {"file_name": "migrated_image.png", "id": "526738798265020", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/11162682_179116105994090_8275689972598571008_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=afv0RPVqsSwQ7kNvwEmZlGG&_nc_oc=AdmSPTNL7UKu5bmKOGd_IhvSjwkZ-O1dAK8C1scMe1wpjYs3pCuoLarlg71rFBWI4Ws&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfvECQ2IYljPJ9GAURstSEWg5VgJOhgQkOJodGmx-SdduA&oe=69A6F11D"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Zoo Park", "keywords": ["animals", "zoo", "park", "forest", "nature"], "long_description": "Zoo Park was developed for you to see the animals on their natural environment with the beautiful graphics and sounds. \n\nUsing your virtual reality glasses, you can see the animals moving closely with animations. It will be an exciting journey for you. \n\nYou don't need to go to a zoo to see the animals. Your children will also enjoy the virtual simulations as if they are in a zoo and know the names of many animals. Elephant, Lion, Lioness, Zebra, Crocodile, Hippopotamus, Rhinoceros, Chicken, Cow, Goat, Pig, Sheep, Bear, Boar, Fox, Rabbit, Stag, Wolf, Crow and more.\n\nHow to play\nIt is very easy. You should look at where you want to move. When you approach to animals, your movements will be slower or stop so that you will have time to examine them closely. You can use touchpad to go forward, back, left and right.\n\nFeatures\n- Very beautiful graphics. Realistic forest environment\n- Nice animated animals in Zoo\n- Natural sounds of animals", "short_description": "Zoo Park was developed for you to see the animals on their natural environment with the beautiful graphics and sounds."}]}, "developer_name": null, "developer_privacy_policy_url": "http://provr.net/privacy2.html", "developer_terms_of_service_url": "http://provr.net/privacy2.html", "publisher_name": "HASoft", "support_website_url": null, "website_url": "https://www.facebook.com/HASoft-Mobile-GamesApplications-680466725426771", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE", "EDUCATIONAL", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD", "GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "662532501863457"}, "review_messages": [
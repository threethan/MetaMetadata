UM5P-3Z10GGNlIIjvEHWbBdPto&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4Cob0qI9KWB6cCPztHX-go-UFKBZTISrfXoyQCVWSf5g&oe=6A048406"}, {"file_name": "migrated_image.png", "id": "208088447206320", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/11162716_476745332724218_1676433208595447808_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8XS_T333cL0Q7kNvwE3MLkq&_nc_oc=AdpuLTqlXB-KWjyrKFFLSkRmpi-9I4wGm-GlEJn7ELt91zazUlK3A7wIhj1DBMQ98IY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6sDZwq--WnpklQ5047o5KvlIjOjVtgPKrvUfdQRSLIwQ&oe=6A046BD6"}, {"file_name": "migrated_image.png", "id": "290138991968813", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/11162690_510656702601736_3434315365243420672_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UQ-q3vfu-kkQ7kNvwGKQMzV&_nc_oc=AdrTfxMcDzD8iJ1vPHIBljfuK5wVU5tpCRRLqIZ2ILuy1iFmTx51r9RMwHE02LBcDbY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5hd4KVrNqW4TmRPElWa3ksMD1xEA75FJ7PzbdVOi3zpQ&oe=6A04971A"}, {"file_name": "migrated_image.png", "id": "2526122730961072", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/11162700_286111548569698_6750775844337090560_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o-0aN-vPJzAQ7kNvwF4Sibe&_nc_oc=AdrcwkgwGRX6tTfW-vTBXC9j1iYbjEkABfvY6gQgO065o1ieKzvYI95O6DoJuyyFgaU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7qoUHO7gN3q0ZFxegGNPkWVHsKQQFvUvfcPzD-c8fIEA&oe=6A0484E5"}, {"file_name": "migrated_image.png", "id": "526738798265020", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/11162682_179116105994090_8275689972598571008_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rSy4hWw5KD8Q7kNvwEpudAW&_nc_oc=Adrz6HbvtqMifs37cJbhMlciSQqBoILB7bCrrt7EgMovyFEpZoB0Z85kVlPIHs3ar18&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af53OPW39sC3vzq3bF53ZDHmZhwp3AvO3MLpPdiYqUvzFw&oe=6A048B9D"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Zoo Park", "keywords": ["animals", "zoo", "park", "forest", "nature"], "long_description": "Zoo Park was developed for you to see the animals on their natural environment with the beautiful graphics and sounds. \n\nUsing your virtual reality glasses, you can see the animals moving closely with animations. It will be an exciting journey for you. \n\nYou don't need to go to a zoo to see the animals. Your children will also enjoy the virtual simulations as if they are in a zoo and know the names of many animals. Elephant, Lion, Lioness, Zebra, Crocodile, Hippopotamus, Rhinoceros, Chicken, Cow, Goat, Pig, Sheep, Bear, Boar, Fox, Rabbit, Stag, Wolf, Crow and more.\n\nHow to play\nIt is very easy. You should look at where you want to move. When you approach to animals, your movements will be slower or stop so that you will have time to examine them closely. You can use touchpad to go forward, back, left and right.\n\nFeatures\n- Very beautiful graphics. Realistic forest environment\n- Nice animated animals in Zoo\n- Natural sounds of animals", "short_description": "Zoo Park was developed for you to see the animals on their natural environment with the beautiful graphics and sounds."}]}, "developer_name": null, "developer_privacy_policy_url": "http://provr.net/privacy2.html", "developer_terms_of_service_url": "http://provr.net/privacy2.html", "publisher_name": "HASoft", "support_website_url": null, "website_url": "https://www.facebook.com/HASoft-Mobile-GamesApplications-680466725426771", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE", "EDUCATIONAL", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD", "GEAR_VR_CONTROLLE
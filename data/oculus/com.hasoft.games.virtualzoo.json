Ipt4zWtwZ4p8Cat2ryqt2T9Kh8&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBlscdRovg_3VeAFV-pVw11l6sa_VA5PMJyvN9G_3KMbg&oe=6A54EF86"}, {"file_name": "migrated_image.png", "id": "208088447206320", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/11162716_476745332724218_1676433208595447808_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a4zA9VNTztMQ7kNvwEwpVaN&_nc_oc=AdqFHBKhG1aMsaWVZOdX7JZYx3PtamlbVVfzW3TvjW5sNGhX01MtUsUlLDUSOT6K8rk&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDVqsbX2x8Hib2yiz-U-4Kt8exgHAoJ5eSGWdlvlxzFdg&oe=6A54D756"}, {"file_name": "migrated_image.png", "id": "290138991968813", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/11162690_510656702601736_3434315365243420672_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e1JxMKk8MKQQ7kNvwELHaER&_nc_oc=Ado2ZcpwNC07krIkAQ6VVQtbARcmVgcwoY5TDpyAqLr5x5ivlXAxkCOtnSCgQ3EgOxQ&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD11pcktnreZq6vl_NwJQwHS2bq4982NOK63WBFuRzwKA&oe=6A55029A"}, {"file_name": "migrated_image.png", "id": "2526122730961072", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/11162700_286111548569698_6750775844337090560_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oVsmtkdTVfAQ7kNvwGtN-vo&_nc_oc=Adp_tzBBHb5UI0Z0JXeG3Sj-RAPiSX8G45PFoX5bMNsq6KjyFeAQc0pxUNh-tFv_FxU&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB_a-a41aXA4cK3n_wKp_K4jD1yveE4XxSHqZSdA-XHUg&oe=6A54F065"}, {"file_name": "migrated_image.png", "id": "526738798265020", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/11162682_179116105994090_8275689972598571008_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CU1LP61VZAYQ7kNvwEpPfdJ&_nc_oc=AdoIhTNufbHBss0eLGhxUA3Spjd80AWY9DCgvGg_zQi_YrRxG7abwXJHM80yGsiCggE&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAUIjNcI7yB2Etwwack6mg3aitZkwVlrjBts2g-5Mna4A&oe=6A54F71D"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Zoo Park", "keywords": ["animals", "zoo", "park", "forest", "nature"], "long_description": "Zoo Park was developed for you to see the animals on their natural environment with the beautiful graphics and sounds. \n\nUsing your virtual reality glasses, you can see the animals moving closely with animations. It will be an exciting journey for you. \n\nYou don't need to go to a zoo to see the animals. Your children will also enjoy the virtual simulations as if they are in a zoo and know the names of many animals. Elephant, Lion, Lioness, Zebra, Crocodile, Hippopotamus, Rhinoceros, Chicken, Cow, Goat, Pig, Sheep, Bear, Boar, Fox, Rabbit, Stag, Wolf, Crow and more.\n\nHow to play\nIt is very easy. You should look at where you want to move. When you approach to animals, your movements will be slower or stop so that you will have time to examine them closely. You can use touchpad to go forward, back, left and right.\n\nFeatures\n- Very beautiful graphics. Realistic forest environment\n- Nice animated animals in Zoo\n- Natural sounds of animals", "short_description": "Zoo Park was developed for you to see the animals on their natural environment with the beautiful graphics and sounds."}]}, "developer_name": null, "developer_privacy_policy_url": "http://provr.net/privacy2.html", "developer_terms_of_service_url": "http://provr.net/privacy2.html", "publisher_name": "HASoft", "support_website_url": null, "website_url": "https://www.facebook.com/HASoft-Mobile-GamesApplications-680466725426771", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE", "EDUCATIONAL", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD", "GEAR_VR_CONTROLLE
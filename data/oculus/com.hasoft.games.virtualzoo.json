WOve3GN2se3kd370bRorZNWs-Q&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3nQ8YpXflKNN93chwMmsYjb3zFNO3cnNcLXXsElYmSew&oe=69D7B106"}, {"file_name": "migrated_image.png", "id": "208088447206320", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/11162716_476745332724218_1676433208595447808_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4JvncEBONyIQ7kNvwFMdvhj&_nc_oc=Ado-O0lFlBWS9ccd70BWNgKI0bj7QaNvGBHPoUwcHneahagUTz2l8LxsGz4jaXxNwaI&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2IHuWjod0x3q6dk6-YXKRPEUpYio0NgbkG6mGGyl1HmQ&oe=69D798D6"}, {"file_name": "migrated_image.png", "id": "290138991968813", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/11162690_510656702601736_3434315365243420672_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mYf4dB9wDyMQ7kNvwE9qksr&_nc_oc=AdrQM90RJ3DNKcUWheP_RiE5qQEVWIFVZf7MMH-2OhsHLgeaEaihx4m_bysJFugE2HA&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1FZYm_8m3g1AFWCjP5Le4kcyd6cU0Xmmn2EPKcoSg2EA&oe=69D78BDA"}, {"file_name": "migrated_image.png", "id": "2526122730961072", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/11162700_286111548569698_6750775844337090560_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_PorbzwuKAMQ7kNvwHhgNFg&_nc_oc=AdrPMCKbtZcX3A04wqUQ-aylylYbcL-YtUWmZ3CMUhTiIERw3NlIEkabR8alnXtZunU&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3zaiqgXP1b38jYtEuRq2DuwAUXcWnfLGdAuGW6BJUo-g&oe=69D7B1E5"}, {"file_name": "migrated_image.png", "id": "526738798265020", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/11162682_179116105994090_8275689972598571008_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H6wVZ1hUutQQ7kNvwH4mNaA&_nc_oc=AdqTcsglmZepokRdtHHEZA0vMFR7Chw0OQpJ6uAYBjjJC9bNNrzQVYG_JJRIFqJg2J0&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3Z_pRR5OP2W6ZX5woMAtBxpU-DRyidD7sRmx8Yorxiwg&oe=69D7B89D"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Zoo Park", "keywords": ["animals", "zoo", "park", "forest", "nature"], "long_description": "Zoo Park was developed for you to see the animals on their natural environment with the beautiful graphics and sounds. \n\nUsing your virtual reality glasses, you can see the animals moving closely with animations. It will be an exciting journey for you. \n\nYou don't need to go to a zoo to see the animals. Your children will also enjoy the virtual simulations as if they are in a zoo and know the names of many animals. Elephant, Lion, Lioness, Zebra, Crocodile, Hippopotamus, Rhinoceros, Chicken, Cow, Goat, Pig, Sheep, Bear, Boar, Fox, Rabbit, Stag, Wolf, Crow and more.\n\nHow to play\nIt is very easy. You should look at where you want to move. When you approach to animals, your movements will be slower or stop so that you will have time to examine them closely. You can use touchpad to go forward, back, left and right.\n\nFeatures\n- Very beautiful graphics. Realistic forest environment\n- Nice animated animals in Zoo\n- Natural sounds of animals", "short_description": "Zoo Park was developed for you to see the animals on their natural environment with the beautiful graphics and sounds."}]}, "developer_name": null, "developer_privacy_policy_url": "http://provr.net/privacy2.html", "developer_terms_of_service_url": "http://provr.net/privacy2.html", "publisher_name": "HASoft", "support_website_url": null, "website_url": "https://www.facebook.com/HASoft-Mobile-GamesApplications-680466725426771", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE", "EDUCATIONAL", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD", "GEAR_VR_CONTROLLE
xdMzbWSUnV46OeL0HaGAhLnAEk&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGh7J0iUSKLrjeDSySvZ6_MuoscNYnsYr9wqXZvN2UrEg&oe=6A93FF46"}, {"file_name": "migrated_image.png", "id": "208088447206320", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/11162716_476745332724218_1676433208595447808_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PwWI6OcNRlkQ7kNvwF_StSP&_nc_oc=AdrCGiVnDqengyLRPX0jGpSGdF6MvcTr5UaQ0XYAM4yjCKSVwMLbp42M5Peb6gXOubc&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHuRr0AwcERaRSpe9UVGaOcs-ZF5IocVgKqmmUoL5TbqA&oe=6A941F56"}, {"file_name": "migrated_image.png", "id": "290138991968813", "uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/11162690_510656702601736_3434315365243420672_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TPWkhfnCZ-IQ7kNvwHUGtES&_nc_oc=AdqznIdAuG97QE13lEyGYUoLr4M3kl1jx5Urek3ebj1GK8dbjXTtBWZPQOT4X_sLQys&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGypRZZ6oK2Jj-JgdTyjUSpLjt8gaHvj4bW9O8OqZTlpQ&oe=6A94125A"}, {"file_name": "migrated_image.png", "id": "2526122730961072", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/11162700_286111548569698_6750775844337090560_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o2aC_WANqA4Q7kNvwGzmUyi&_nc_oc=AdoiZKLi3Mmx9Wc_y74hQopFSpwyDugr6sBBPy_CXH8hfaQLTqXB0Xso_yhKLJKwQ98&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFBuzzB9TsbphY0xFML7J-ZKL_lHQfPA07ennaO5bgDzg&oe=6A940025"}, {"file_name": "migrated_image.png", "id": "526738798265020", "uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/11162682_179116105994090_8275689972598571008_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9xQnFxi4k0wQ7kNvwF2E-Vn&_nc_oc=Adr8QJBG44Rh56insSEEfdgijsdv79SVuK50-HeyjhE2VMYbDWAbbPYDnwAuFE6xs78&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEtcfrsTq4zxcF9_T55qVEdVBW3uYe6WxEK0GOfLke_lA&oe=6A9406DD"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Zoo Park", "keywords": ["animals", "zoo", "park", "forest", "nature"], "long_description": "Zoo Park was developed for you to see the animals on their natural environment with the beautiful graphics and sounds. \n\nUsing your virtual reality glasses, you can see the animals moving closely with animations. It will be an exciting journey for you. \n\nYou don't need to go to a zoo to see the animals. Your children will also enjoy the virtual simulations as if they are in a zoo and know the names of many animals. Elephant, Lion, Lioness, Zebra, Crocodile, Hippopotamus, Rhinoceros, Chicken, Cow, Goat, Pig, Sheep, Bear, Boar, Fox, Rabbit, Stag, Wolf, Crow and more.\n\nHow to play\nIt is very easy. You should look at where you want to move. When you approach to animals, your movements will be slower or stop so that you will have time to examine them closely. You can use touchpad to go forward, back, left and right.\n\nFeatures\n- Very beautiful graphics. Realistic forest environment\n- Nice animated animals in Zoo\n- Natural sounds of animals", "short_description": "Zoo Park was developed for you to see the animals on their natural environment with the beautiful graphics and sounds."}]}, "developer_name": null, "developer_privacy_policy_url": "http://provr.net/privacy2.html", "developer_terms_of_service_url": "http://provr.net/privacy2.html", "publisher_name": "HASoft", "support_website_url": null, "website_url": "https://www.facebook.com/HASoft-Mobile-GamesApplications-680466725426771", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE", "EDUCATIONAL", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD", "GEAR_VR_CONTROLLE
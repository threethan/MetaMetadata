NLDgF10B00RkO4wpbD6z0zR5Eg&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af51H7Dz7ksRqTW7CAqj0Bzuv5VV_TKMGS_ZJ3TBZGSMQg&oe=69FB4986"}, {"file_name": "migrated_image.png", "id": "208088447206320", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/11162716_476745332724218_1676433208595447808_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H5IYG1Hdu1EQ7kNvwHTThpt&_nc_oc=Adq0SEhSyJx4SWHlERbkDn0VR7xJQdAGuuQ6Vg3CCy-8PtJQM8C1NDvZUOJJkAP1y38&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6XMZrr58YQC6Wdtru19bOQWZfwzSIzxt-fzszHMTZocw&oe=69FB3156"}, {"file_name": "migrated_image.png", "id": "290138991968813", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/11162690_510656702601736_3434315365243420672_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WyfSvQgsUSQQ7kNvwH0uXjQ&_nc_oc=AdoVPVxIruARHRyvhP0ZqyZ-G0GcwWjXQvkiksO5z9Nj6GJmAK7xa_UHIoPpl_GJUGY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5irUs1GmeH54j_UfaDyDHyY2yc0k0IGq6oFKHkPQ2chA&oe=69FB5C9A"}, {"file_name": "migrated_image.png", "id": "2526122730961072", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/11162700_286111548569698_6750775844337090560_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YGuX_45t3O8Q7kNvwHpqrPZ&_nc_oc=Adqfy0P8YNDKT8HjKtGSPynBsRgnjgGSK2wooiv1VIZo4rkWQAiiR_fnO_qh0XLymlQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5HMEvezgJuT3TDK9Xy8Q5DHeQ6RQ9zu8hEpxQfhX_C-Q&oe=69FB4A65"}, {"file_name": "migrated_image.png", "id": "526738798265020", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/11162682_179116105994090_8275689972598571008_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BV_Rnu7r0MMQ7kNvwH5aGI1&_nc_oc=AdqfZOAX6if6fyhuWKqZHS-_W3HF5RUKDu9PJXgpFB_FSdMJDFgzf1Iu9QRxDZEczxw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5FoZoiyAGWzQp6N8VgkGN1xmE5GrrgQc8xKPU5akHnRA&oe=69FB511D"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Zoo Park", "keywords": ["animals", "zoo", "park", "forest", "nature"], "long_description": "Zoo Park was developed for you to see the animals on their natural environment with the beautiful graphics and sounds. \n\nUsing your virtual reality glasses, you can see the animals moving closely with animations. It will be an exciting journey for you. \n\nYou don't need to go to a zoo to see the animals. Your children will also enjoy the virtual simulations as if they are in a zoo and know the names of many animals. Elephant, Lion, Lioness, Zebra, Crocodile, Hippopotamus, Rhinoceros, Chicken, Cow, Goat, Pig, Sheep, Bear, Boar, Fox, Rabbit, Stag, Wolf, Crow and more.\n\nHow to play\nIt is very easy. You should look at where you want to move. When you approach to animals, your movements will be slower or stop so that you will have time to examine them closely. You can use touchpad to go forward, back, left and right.\n\nFeatures\n- Very beautiful graphics. Realistic forest environment\n- Nice animated animals in Zoo\n- Natural sounds of animals", "short_description": "Zoo Park was developed for you to see the animals on their natural environment with the beautiful graphics and sounds."}]}, "developer_name": null, "developer_privacy_policy_url": "http://provr.net/privacy2.html", "developer_terms_of_service_url": "http://provr.net/privacy2.html", "publisher_name": "HASoft", "support_website_url": null, "website_url": "https://www.facebook.com/HASoft-Mobile-GamesApplications-680466725426771", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE", "EDUCATIONAL", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD", "GEAR_VR_CONTROLLE
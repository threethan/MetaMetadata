3P4ISGuPqGG1lMq5s_PBZCDX9E&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxE58nMOlwF6Lj0d1h-4v8utmp9xywKAX8wwC_zS0bLwg&oe=69CFC806"}, {"file_name": "migrated_image.png", "id": "208088447206320", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/11162716_476745332724218_1676433208595447808_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b4h5ZO4kJ44Q7kNvwE_0UMA&_nc_oc=AdqccmR01W4zYKh3fdOeN-n8WOPSn0MZqFin4CW66tw7kXEeDDArC0wPrjC4fxTNTYE&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzT98PIFK-1vnia954bmelCQPaj8V4ef_j87tMgu-hl1w&oe=69CFAFD6"}, {"file_name": "migrated_image.png", "id": "290138991968813", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/11162690_510656702601736_3434315365243420672_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xf3gBBet-csQ7kNvwEZm11Z&_nc_oc=AdqDQYMX2O3D-BwfvDQ78hH9UEobv7q9aQ7tpOBk15NxA7v7MDEM0859p3mbjq9Hfdk&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxPyKD6xAeb3WvQF6DO0ecI_UgA3Ve5sGPhD_9Jh7M4cw&oe=69CFA2DA"}, {"file_name": "migrated_image.png", "id": "2526122730961072", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/11162700_286111548569698_6750775844337090560_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xgYupgCuRJAQ7kNvwFLXhor&_nc_oc=AdoG9O6dIL3GNQ8XZ6lYhvZKIUADcQKrxHIa4OL49levnGGA_6m4kp9cDxrZ2VA39Tg&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwbNX69I68YgP8Ylrlrh64RvL0MQU1-eg603QLkZgJd6Q&oe=69CFC8E5"}, {"file_name": "migrated_image.png", "id": "526738798265020", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/11162682_179116105994090_8275689972598571008_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-7meAwcEt1MQ7kNvwG42nxA&_nc_oc=AdobcFno0zVpQyCfAcm_oOhTVHS-VqvCXyCYjm8ogcWqH9GW5nAbD0_Xtu0LZBSftVI&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afx-UrOrCVW5HbRTkb_UhzCYpEHO8ejMsmntl1v3BRHJFw&oe=69CFCF9D"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Zoo Park", "keywords": ["animals", "zoo", "park", "forest", "nature"], "long_description": "Zoo Park was developed for you to see the animals on their natural environment with the beautiful graphics and sounds. \n\nUsing your virtual reality glasses, you can see the animals moving closely with animations. It will be an exciting journey for you. \n\nYou don't need to go to a zoo to see the animals. Your children will also enjoy the virtual simulations as if they are in a zoo and know the names of many animals. Elephant, Lion, Lioness, Zebra, Crocodile, Hippopotamus, Rhinoceros, Chicken, Cow, Goat, Pig, Sheep, Bear, Boar, Fox, Rabbit, Stag, Wolf, Crow and more.\n\nHow to play\nIt is very easy. You should look at where you want to move. When you approach to animals, your movements will be slower or stop so that you will have time to examine them closely. You can use touchpad to go forward, back, left and right.\n\nFeatures\n- Very beautiful graphics. Realistic forest environment\n- Nice animated animals in Zoo\n- Natural sounds of animals", "short_description": "Zoo Park was developed for you to see the animals on their natural environment with the beautiful graphics and sounds."}]}, "developer_name": null, "developer_privacy_policy_url": "http://provr.net/privacy2.html", "developer_terms_of_service_url": "http://provr.net/privacy2.html", "publisher_name": "HASoft", "support_website_url": null, "website_url": "https://www.facebook.com/HASoft-Mobile-GamesApplications-680466725426771", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE", "EDUCATIONAL", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD", "GEAR_VR_CONTROLLE
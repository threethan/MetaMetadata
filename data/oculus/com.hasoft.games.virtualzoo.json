qV_2jA24Y0PXYBPFl8YU6c1wQgFs-4utmw&oe=699B0C06"}, {"file_name": "migrated_image.png", "id": "208088447206320", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/11162716_476745332724218_1676433208595447808_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PBq2GA2Dxe0Q7kNvwFRdERC&_nc_oc=AdlSTnaPxZZY_8Gs52ormHU9W9TgbfTbhUKEn-mhM2aq2pm0phbxSTZD2hL6VcW-uXc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_Afun8bFKPwTpmAGkqvaDQPY9HGnb_i4HXeUB97qrpskhgQ&oe=699AF3D6"}, {"file_name": "migrated_image.png", "id": "290138991968813", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/11162690_510656702601736_3434315365243420672_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BnTaysw2KG8Q7kNvwHu-ulL&_nc_oc=AdkRth-nkem0xng2EETYLirUgIvJzSqNDfu0gDWgQFSapT7n8DMfeY5rSPCveChLoA0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_Afse5SR0LXdXPZczy6Eu5aDJTFezvlrd2czusdqfXjGDXw&oe=699AE6DA"}, {"file_name": "migrated_image.png", "id": "2526122730961072", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/11162700_286111548569698_6750775844337090560_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OdXrwwukJAoQ7kNvwFDBF4F&_nc_oc=AdlKMqNbTmFEbjpt_QYNvoI45Cts00jKoJXRzKXxvWBB1Iek0kVwsB3GLiBIrYGYYOE&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfvUlaDB3IRIJABGKjZqxatDIJfRTKtnpA93ehuH2Oc1Tw&oe=699B0CE5"}, {"file_name": "migrated_image.png", "id": "526738798265020", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/11162682_179116105994090_8275689972598571008_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V2jGFWTkDHkQ7kNvwEQoJ-6&_nc_oc=AdnY0EnbAvbnYYzkgOn0UjWuaOleDPjPxNjrtq7iyy99uI9tHy2EsgtVA9ZgdDrRCyk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AfsvFQYzkAFZ3yAqc0pFC99C7ieopVC3aeVE1nVqif6DHw&oe=699B139D"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Zoo Park", "keywords": ["animals", "zoo", "park", "forest", "nature"], "long_description": "Zoo Park was developed for you to see the animals on their natural environment with the beautiful graphics and sounds. \n\nUsing your virtual reality glasses, you can see the animals moving closely with animations. It will be an exciting journey for you. \n\nYou don't need to go to a zoo to see the animals. Your children will also enjoy the virtual simulations as if they are in a zoo and know the names of many animals. Elephant, Lion, Lioness, Zebra, Crocodile, Hippopotamus, Rhinoceros, Chicken, Cow, Goat, Pig, Sheep, Bear, Boar, Fox, Rabbit, Stag, Wolf, Crow and more.\n\nHow to play\nIt is very easy. You should look at where you want to move. When you approach to animals, your movements will be slower or stop so that you will have time to examine them closely. You can use touchpad to go forward, back, left and right.\n\nFeatures\n- Very beautiful graphics. Realistic forest environment\n- Nice animated animals in Zoo\n- Natural sounds of animals", "short_description": "Zoo Park was developed for you to see the animals on their natural environment with the beautiful graphics and sounds."}]}, "developer_name": null, "developer_privacy_policy_url": "http://provr.net/privacy2.html", "developer_terms_of_service_url": "http://provr.net/privacy2.html", "publisher_name": "HASoft", "support_website_url": null, "website_url": "https://www.facebook.com/HASoft-Mobile-GamesApplications-680466725426771", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE", "EDUCATIONAL", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD", "GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "662532501863457"}, "review_messages": [
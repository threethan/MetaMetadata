8LN_QPpj7MawzYlTTeLsnjzeu4&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3uTwwBtelMkgnKaRHEUQ9J9_FkVg6yK7W0PchMqwlopw&oe=69E8D486"}, {"file_name": "migrated_image.png", "id": "208088447206320", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/11162716_476745332724218_1676433208595447808_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s6kon6X9QXcQ7kNvwGEkO5x&_nc_oc=AdoDirfL9Yw6Qtnhefi35VQM4ADPlmnlF3fSID8GLFneoQAmKLym_3IshFGONjBg1Vc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0iE6IfQRS927eDogU6fgul7oN7h3AnNTGo8hxFT6uMAA&oe=69E8BC56"}, {"file_name": "migrated_image.png", "id": "290138991968813", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/11162690_510656702601736_3434315365243420672_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gLrvXPGxF9wQ7kNvwFW13m5&_nc_oc=AdrYoN6BN_1gZq6WXXtFoE5oJBDTOLjTINPfZalXT5ZM3emE0a3bqhuysntz3_-ayjw&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3mr3O_0Icl9tAVf2SlxWy9M_JlP82-2QdUWpt4uD5ZRA&oe=69E8AF5A"}, {"file_name": "migrated_image.png", "id": "2526122730961072", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/11162700_286111548569698_6750775844337090560_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Gl3wKLmY6twQ7kNvwE57aqG&_nc_oc=Adrb6vphi-MNnAb84sUNH0CVYNjYHWjhuKc6XwkIQpBWPHJwX3O-tsmfMX0InzxJMJ8&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1p3eQdlRkCaniB99Guz9W5O0-1ypNYIbgtZCL1E9_sPQ&oe=69E8D565"}, {"file_name": "migrated_image.png", "id": "526738798265020", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/11162682_179116105994090_8275689972598571008_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fSVHNUtAlb8Q7kNvwE9mOC1&_nc_oc=AdoCDwKVtkv3BVgaPdjq3yQ141G0_Ue7JBObereslUDox6qvKbnlVuF7XjOPaEvJutg&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1vydiPb6AE81BrY_6OjQu_6-roQ3byCFLwJuJfhfim3w&oe=69E8DC1D"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Zoo Park", "keywords": ["animals", "zoo", "park", "forest", "nature"], "long_description": "Zoo Park was developed for you to see the animals on their natural environment with the beautiful graphics and sounds. \n\nUsing your virtual reality glasses, you can see the animals moving closely with animations. It will be an exciting journey for you. \n\nYou don't need to go to a zoo to see the animals. Your children will also enjoy the virtual simulations as if they are in a zoo and know the names of many animals. Elephant, Lion, Lioness, Zebra, Crocodile, Hippopotamus, Rhinoceros, Chicken, Cow, Goat, Pig, Sheep, Bear, Boar, Fox, Rabbit, Stag, Wolf, Crow and more.\n\nHow to play\nIt is very easy. You should look at where you want to move. When you approach to animals, your movements will be slower or stop so that you will have time to examine them closely. You can use touchpad to go forward, back, left and right.\n\nFeatures\n- Very beautiful graphics. Realistic forest environment\n- Nice animated animals in Zoo\n- Natural sounds of animals", "short_description": "Zoo Park was developed for you to see the animals on their natural environment with the beautiful graphics and sounds."}]}, "developer_name": null, "developer_privacy_policy_url": "http://provr.net/privacy2.html", "developer_terms_of_service_url": "http://provr.net/privacy2.html", "publisher_name": "HASoft", "support_website_url": null, "website_url": "https://www.facebook.com/HASoft-Mobile-GamesApplications-680466725426771", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE", "EDUCATIONAL", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD", "GEAR_VR_CONTROLLE
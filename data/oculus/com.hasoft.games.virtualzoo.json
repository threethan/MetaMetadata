HrBsuzzsnrJKl5LRF4T9ykvYzM&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4hfqLIwvfUKU_aSFYY38z64_MQLU49YdJgQ8yuDOGxiA&oe=6A1AED86"}, {"file_name": "migrated_image.png", "id": "208088447206320", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/11162716_476745332724218_1676433208595447808_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sge9r-zAku8Q7kNvwGK4rxE&_nc_oc=Adra-8pLQNd6zXmRbnvA_XqtQMe070po76eYAWjp2BvUKLiGIUHZF0DrEPvZwq6-c9o&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4RzN1W4vwT_xm74LTiDOpqYUyHoLlH9YAZRFRayOaKSg&oe=6A1AD556"}, {"file_name": "migrated_image.png", "id": "290138991968813", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/11162690_510656702601736_3434315365243420672_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XGO0dHgvqPEQ7kNvwFCtUsr&_nc_oc=AdqSZVdOSkzpNJlhXKrVUUhV_hknNqGwLHf9JQOdw1sILqJtjz3NvQXxdUxh-csE588&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7w29RaqGg9cQNm1w9XLfT8OFJCIfMWAAsogP5EtYaCQw&oe=6A1B009A"}, {"file_name": "migrated_image.png", "id": "2526122730961072", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/11162700_286111548569698_6750775844337090560_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CldxrmFZ45kQ7kNvwEnU9Og&_nc_oc=AdpYgPnpVvrzx6UpaWLoljSQskrAgsQ6Q3yG-HAmzG4c5i28gbDbns-GrRMbkw8bY84&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4AeZ8L7bqLj085jHVqcw6nieacN4T-AVMNiR8ZTdxcHQ&oe=6A1AEE65"}, {"file_name": "migrated_image.png", "id": "526738798265020", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/11162682_179116105994090_8275689972598571008_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YJZ7wlM_494Q7kNvwHus3Mh&_nc_oc=AdrIH4E6KPD978MAkq-aMckYVIAkU64KDwYMtyd5tm6juJdfSIVtS8vNlPMplryDIJk&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4P3jfHWC0xQ7HRSalMAr2dfQqFOOt6kEx3hu2KPuUb9Q&oe=6A1AF51D"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Zoo Park", "keywords": ["animals", "zoo", "park", "forest", "nature"], "long_description": "Zoo Park was developed for you to see the animals on their natural environment with the beautiful graphics and sounds. \n\nUsing your virtual reality glasses, you can see the animals moving closely with animations. It will be an exciting journey for you. \n\nYou don't need to go to a zoo to see the animals. Your children will also enjoy the virtual simulations as if they are in a zoo and know the names of many animals. Elephant, Lion, Lioness, Zebra, Crocodile, Hippopotamus, Rhinoceros, Chicken, Cow, Goat, Pig, Sheep, Bear, Boar, Fox, Rabbit, Stag, Wolf, Crow and more.\n\nHow to play\nIt is very easy. You should look at where you want to move. When you approach to animals, your movements will be slower or stop so that you will have time to examine them closely. You can use touchpad to go forward, back, left and right.\n\nFeatures\n- Very beautiful graphics. Realistic forest environment\n- Nice animated animals in Zoo\n- Natural sounds of animals", "short_description": "Zoo Park was developed for you to see the animals on their natural environment with the beautiful graphics and sounds."}]}, "developer_name": null, "developer_privacy_policy_url": "http://provr.net/privacy2.html", "developer_terms_of_service_url": "http://provr.net/privacy2.html", "publisher_name": "HASoft", "support_website_url": null, "website_url": "https://www.facebook.com/HASoft-Mobile-GamesApplications-680466725426771", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE", "EDUCATIONAL", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD", "GEAR_VR_CONTROLLE
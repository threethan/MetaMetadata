bdm-I_ck_ZDaO9VtpQm0Id38pI&_nc_zt=3&_nc_ht=scontent-dfw5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6c_FKSoFbgchyPiJJrVFMWTJEi4zCIYRmjWWTd9SL_EQ&oe=69FDEC86"}, {"file_name": "migrated_image.png", "id": "208088447206320", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/11162716_476745332724218_1676433208595447808_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zcO_l5BcdtwQ7kNvwFf7VT1&_nc_oc=AdqNSG56m2_7uYuVEJ37JxuUj9vJQF6IkgP-eV5YudxOclotRI9SJ2qg5QQAW3ylGv4&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7ZKb1wse6aTCJGtBlh7TKk6JQLPQ3ZsB9nbqTyzMttUg&oe=69FDD456"}, {"file_name": "migrated_image.png", "id": "290138991968813", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/11162690_510656702601736_3434315365243420672_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J-0CjqvorDUQ7kNvwFxsdSb&_nc_oc=AdoIerF8J5zyr675A0xIOQGbMfgfv0ed2a6VLbbBchjequ000bJrW1LH5HsvvRQktEs&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af76UH40slS5lFr_xWkexaK5RbP8g0UC3asRbqkCtrRF5g&oe=69FDFF9A"}, {"file_name": "migrated_image.png", "id": "2526122730961072", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/11162700_286111548569698_6750775844337090560_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tQmIypU4FFUQ7kNvwEhxyS9&_nc_oc=AdrktJCwuXSMWL8qj1qoItuo77PuvosAm5cDijqrzEJ7N_UNfm6GD4v2mVn2Mzo1SSA&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6b98_6aLHDzv30jNGG1WQb7RwZSyhnRgwyO7Rsu_H2_w&oe=69FDED65"}, {"file_name": "migrated_image.png", "id": "526738798265020", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/11162682_179116105994090_8275689972598571008_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QEeh-KLLWWcQ7kNvwGS8hvJ&_nc_oc=AdqVR2GzZ85tMi4e5szqRSduQnm2qmnKZAFYDMBqdggXHK5pq2IZnfMaa2j9Jtt_jCk&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af49pnhgqL_vWdVIAJYRoLijHb31cxxd7232WZoxbloesg&oe=69FDF41D"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Zoo Park", "keywords": ["animals", "zoo", "park", "forest", "nature"], "long_description": "Zoo Park was developed for you to see the animals on their natural environment with the beautiful graphics and sounds. \n\nUsing your virtual reality glasses, you can see the animals moving closely with animations. It will be an exciting journey for you. \n\nYou don't need to go to a zoo to see the animals. Your children will also enjoy the virtual simulations as if they are in a zoo and know the names of many animals. Elephant, Lion, Lioness, Zebra, Crocodile, Hippopotamus, Rhinoceros, Chicken, Cow, Goat, Pig, Sheep, Bear, Boar, Fox, Rabbit, Stag, Wolf, Crow and more.\n\nHow to play\nIt is very easy. You should look at where you want to move. When you approach to animals, your movements will be slower or stop so that you will have time to examine them closely. You can use touchpad to go forward, back, left and right.\n\nFeatures\n- Very beautiful graphics. Realistic forest environment\n- Nice animated animals in Zoo\n- Natural sounds of animals", "short_description": "Zoo Park was developed for you to see the animals on their natural environment with the beautiful graphics and sounds."}]}, "developer_name": null, "developer_privacy_policy_url": "http://provr.net/privacy2.html", "developer_terms_of_service_url": "http://provr.net/privacy2.html", "publisher_name": "HASoft", "support_website_url": null, "website_url": "https://www.facebook.com/HASoft-Mobile-GamesApplications-680466725426771", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE", "EDUCATIONAL", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD", "GEAR_VR_CONTROLLE
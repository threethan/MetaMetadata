4ATRpbd0MIcRI8h-6I6ZuyGknE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKm8g08D5oOKsxGEihtNqJRFaEoIkOcwbtOZKEQcAAH4Q&oe=6ABBC486"}, {"file_name": "migrated_image.png", "id": "208088447206320", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/11162716_476745332724218_1676433208595447808_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B4whUVQ6qTYQ7kNvwFL4TtQ&_nc_oc=AdrIILic1PCFhZT6uJSASMvgCIU-n5rPgydpmDR4ME9-SzwU2skBLQSpruDGLtohZmw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKRvCKmm4x2K3nWyybMfI9ktvUCZY_r2AcPr-2WeP-8Ag&oe=6ABBE496"}, {"file_name": "migrated_image.png", "id": "290138991968813", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/11162690_510656702601736_3434315365243420672_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RRf5pKoIXFoQ7kNvwHSwN9_&_nc_oc=Adq5hEk3CRS4NuFA5qJc0m3w5lRtwS1yYCz7eUqZJISixvWdLefQrIk55AX4dITao_E&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJaTocpDEff3yMlGrs2OfHCh_8s0KmaKGoBpitN_TzxJw&oe=6ABBD79A"}, {"file_name": "migrated_image.png", "id": "2526122730961072", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/11162700_286111548569698_6750775844337090560_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eoXoeABjywQQ7kNvwGpIjbw&_nc_oc=Adqe1ybEkbL4r_S_afo6v60RjKcnE2AGLiKDbARclA--PzVO6UJqOAu9VjSglPYdjKs&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ-67ztnoAnavGVb2aTYq3Dc8_E6f_wtQ1dBXyA0xovDg&oe=6ABBC565"}, {"file_name": "migrated_image.png", "id": "526738798265020", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/11162682_179116105994090_8275689972598571008_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NhHukej2fB8Q7kNvwHfro8k&_nc_oc=AdqA5v9bMyFWg1Im5tQVdXpD_XvJYEIrnPDpiJAytNVHbcaF4mG0AjVRi703eaI2QiU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK_b0V7m8fYk9QzRIftR9eYkU5mYPyJTL0h49zcVXJq1g&oe=6ABBCC1D"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Zoo Park", "keywords": ["animals", "zoo", "park", "forest", "nature"], "long_description": "Zoo Park was developed for you to see the animals on their natural environment with the beautiful graphics and sounds. \n\nUsing your virtual reality glasses, you can see the animals moving closely with animations. It will be an exciting journey for you. \n\nYou don't need to go to a zoo to see the animals. Your children will also enjoy the virtual simulations as if they are in a zoo and know the names of many animals. Elephant, Lion, Lioness, Zebra, Crocodile, Hippopotamus, Rhinoceros, Chicken, Cow, Goat, Pig, Sheep, Bear, Boar, Fox, Rabbit, Stag, Wolf, Crow and more.\n\nHow to play\nIt is very easy. You should look at where you want to move. When you approach to animals, your movements will be slower or stop so that you will have time to examine them closely. You can use touchpad to go forward, back, left and right.\n\nFeatures\n- Very beautiful graphics. Realistic forest environment\n- Nice animated animals in Zoo\n- Natural sounds of animals", "short_description": "Zoo Park was developed for you to see the animals on their natural environment with the beautiful graphics and sounds."}]}, "developer_name": null, "developer_privacy_policy_url": "http://provr.net/privacy2.html", "developer_terms_of_service_url": "http://provr.net/privacy2.html", "publisher_name": "HASoft", "support_website_url": null, "website_url": "https://www.facebook.com/HASoft-Mobile-GamesApplications-680466725426771", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE", "EDUCATIONAL", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD", "GEAR_VR_CONTROLLE
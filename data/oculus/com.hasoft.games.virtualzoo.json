1SXEvDgXOVY_6LyxWI8kCihqMk&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ-8PCh0qsRIQF4G_F_X5sFQ5Pq5SpW1n4bl1R_ptIOXw&oe=6AB13886"}, {"file_name": "migrated_image.png", "id": "208088447206320", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/11162716_476745332724218_1676433208595447808_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KaScCcn4osgQ7kNvwFaVL03&_nc_oc=Adq4foOdU2Ow9oDSMuEXMxNNgUc9G4OgnvUxhfwqFU5h1OFXPZtRRYLQH5WDhZZNTuw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK9HS9pIHiGS9XvoiL4h14KZSRUzUcNRz70Y2tjSEBaPg&oe=6AB15896"}, {"file_name": "migrated_image.png", "id": "290138991968813", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/11162690_510656702601736_3434315365243420672_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=skSc1xazcCYQ7kNvwF6GXTz&_nc_oc=Adq9wOboNlrkwjamqyh0ihEI26KdtSh0e6n7Lq2FhQ-OENLIXlZLWyagNl1CmTQG1oA&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJPmNmnRfDALYiGqJdCpv14AT_PGpSD2YxTTflqm9y8Ww&oe=6AB14B9A"}, {"file_name": "migrated_image.png", "id": "2526122730961072", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/11162700_286111548569698_6750775844337090560_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_Y8F9OluIuEQ7kNvwFnVTfb&_nc_oc=AdrAUvhYmw4wVHw6ZlSrWZF5zKF4gAVOnPLaS62OdM60-CnS-LICpfAsdEc0y0drnB8&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLPDG1ITwQlCuMSGOqq53PaK6_Z9SvivugMFiKAlELJlw&oe=6AB13965"}, {"file_name": "migrated_image.png", "id": "526738798265020", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/11162682_179116105994090_8275689972598571008_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fqIsuhzSpgYQ7kNvwE6GzTN&_nc_oc=AdpsflwJ0OmVFQS51AtfJHYgnJnpsuVZvhgd7PEMTtlSzuBZ2ehS6lSgLWwfaPPbA3M&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLjwEvxeDSbZb0u8OzDWxEeS6cXA4pFEmosJcpNzvYcdQ&oe=6AB1401D"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Zoo Park", "keywords": ["animals", "zoo", "park", "forest", "nature"], "long_description": "Zoo Park was developed for you to see the animals on their natural environment with the beautiful graphics and sounds. \n\nUsing your virtual reality glasses, you can see the animals moving closely with animations. It will be an exciting journey for you. \n\nYou don't need to go to a zoo to see the animals. Your children will also enjoy the virtual simulations as if they are in a zoo and know the names of many animals. Elephant, Lion, Lioness, Zebra, Crocodile, Hippopotamus, Rhinoceros, Chicken, Cow, Goat, Pig, Sheep, Bear, Boar, Fox, Rabbit, Stag, Wolf, Crow and more.\n\nHow to play\nIt is very easy. You should look at where you want to move. When you approach to animals, your movements will be slower or stop so that you will have time to examine them closely. You can use touchpad to go forward, back, left and right.\n\nFeatures\n- Very beautiful graphics. Realistic forest environment\n- Nice animated animals in Zoo\n- Natural sounds of animals", "short_description": "Zoo Park was developed for you to see the animals on their natural environment with the beautiful graphics and sounds."}]}, "developer_name": null, "developer_privacy_policy_url": "http://provr.net/privacy2.html", "developer_terms_of_service_url": "http://provr.net/privacy2.html", "publisher_name": "HASoft", "support_website_url": null, "website_url": "https://www.facebook.com/HASoft-Mobile-GamesApplications-680466725426771", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE", "EDUCATIONAL", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD", "GEAR_VR_CONTROLLE
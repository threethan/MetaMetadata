OFPrKa9lJ-eJc8Fy1TJU_Hs6ew&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJeGjomUXVlA3pILsbgCbkncZbuo6FwSGbEPnjLhjWIyw&oe=6AAD4406"}, {"file_name": "migrated_image.png", "id": "208088447206320", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/11162716_476745332724218_1676433208595447808_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SXo4gApC2OgQ7kNvwF70hsS&_nc_oc=AdrfV1e0G1cXRWtzLkox8e7j48xBEYcNteFPTQiP_1u4-z9jQTQKkfas4PTzn5zJKKA&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIyb2wrOUpLimQN4V6Unx7SAAH2UgwXKEWoiHdLUe4sXA&oe=6AAD2BD6"}, {"file_name": "migrated_image.png", "id": "290138991968813", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/11162690_510656702601736_3434315365243420672_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Tw2pSLSlAVwQ7kNvwGIvvcQ&_nc_oc=Ado2UQCRoF2cVejIVuut7dHUnQAduZUGJ0b_BZBfdOxUhu_NpHvyN6lp8M8gKkxB4N8&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQISxP8-X4JNdBujqxf7AX23_Dsmqk3p76uisVOnRxxoAQ&oe=6AAD571A"}, {"file_name": "migrated_image.png", "id": "2526122730961072", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/11162700_286111548569698_6750775844337090560_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qZDPtOaROxcQ7kNvwFpXqRb&_nc_oc=AdrL3IsvGMF0WtVqVkAzuflWYFCken3TMN8z4syAL6hSlZzxjJl5ZcnS_l4Uw5ERdbs&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQITTOtepWbS3PL0H3VboWghov6mCQffLx0RPO17NzjZFg&oe=6AAD44E5"}, {"file_name": "migrated_image.png", "id": "526738798265020", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/11162682_179116105994090_8275689972598571008_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YKQmLoNXd2gQ7kNvwGuMmvX&_nc_oc=Adq8i-1qo4OYObEBDwEpHXGd8pg07phJEOGWiVsFwgb-R4bz61MX6jKk8zwvszmXLDc&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKYOA4uoWySwf9djXZ0Irpp4nkzxGjzbcayki6eKYZJOA&oe=6AAD4B9D"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Zoo Park", "keywords": ["animals", "zoo", "park", "forest", "nature"], "long_description": "Zoo Park was developed for you to see the animals on their natural environment with the beautiful graphics and sounds. \n\nUsing your virtual reality glasses, you can see the animals moving closely with animations. It will be an exciting journey for you. \n\nYou don't need to go to a zoo to see the animals. Your children will also enjoy the virtual simulations as if they are in a zoo and know the names of many animals. Elephant, Lion, Lioness, Zebra, Crocodile, Hippopotamus, Rhinoceros, Chicken, Cow, Goat, Pig, Sheep, Bear, Boar, Fox, Rabbit, Stag, Wolf, Crow and more.\n\nHow to play\nIt is very easy. You should look at where you want to move. When you approach to animals, your movements will be slower or stop so that you will have time to examine them closely. You can use touchpad to go forward, back, left and right.\n\nFeatures\n- Very beautiful graphics. Realistic forest environment\n- Nice animated animals in Zoo\n- Natural sounds of animals", "short_description": "Zoo Park was developed for you to see the animals on their natural environment with the beautiful graphics and sounds."}]}, "developer_name": null, "developer_privacy_policy_url": "http://provr.net/privacy2.html", "developer_terms_of_service_url": "http://provr.net/privacy2.html", "publisher_name": "HASoft", "support_website_url": null, "website_url": "https://www.facebook.com/HASoft-Mobile-GamesApplications-680466725426771", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE", "EDUCATIONAL", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD", "GEAR_VR_CONTROLLE
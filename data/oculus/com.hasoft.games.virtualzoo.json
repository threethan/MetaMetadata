RvwHxlWqW0iKvDS5RYVTwf52ag&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDF21P6B-fw4CnDNtcRJ6q1npA2X88OgonQWMvYdXzKDg&oe=6A50FB06"}, {"file_name": "migrated_image.png", "id": "208088447206320", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/11162716_476745332724218_1676433208595447808_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FF5lD-atXfMQ7kNvwGM4Ifz&_nc_oc=Adp1wR5U1fKWLHAD4BbEu9hL8_T3A9u0U_B78OXXhapCx46O-jXdkN0lmiCAPkZuPJQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCyFeKeCe3TV0N2G5ybfr519O4YBD6atGRwyd9TloC_NA&oe=6A511B16"}, {"file_name": "migrated_image.png", "id": "290138991968813", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/11162690_510656702601736_3434315365243420672_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1B0Zftf9Al4Q7kNvwEtPjvb&_nc_oc=Ado46Yh5VRkWKriAu3G1VmhdYDvaAW1a6E1PVM0BFEWfGh9gwdi1NKPDicRQnLAAdCA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCUJy3tVH3MFruPtWouSPhC0FlrL8sGDAOoHh0z0esWIQ&oe=6A510E1A"}, {"file_name": "migrated_image.png", "id": "2526122730961072", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/11162700_286111548569698_6750775844337090560_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n8uYg573eq0Q7kNvwF_hqNN&_nc_oc=AdqHUVm9He_GFHRk0ZmRnewVfSz4PvosiaV3th-ub_Edg3-73lbGaQ93d_hHpDx6uG4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAPR0qMWPUMhL4pxiyjs2U1qV7f1yum48lzS26mUe4DAw&oe=6A50FBE5"}, {"file_name": "migrated_image.png", "id": "526738798265020", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/11162682_179116105994090_8275689972598571008_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a6cFEVWleWMQ7kNvwGZS8Y1&_nc_oc=AdrjrfF-klxvd6n0kSDtXTY1nSKX-YhrhMxgWcGyZisAeh8N4rEvtG7bdQrzwNWDp2c&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDcIoWOYY7vcTLVTgxcH5N02OPRVgwgvyNH_iJ80F5vCw&oe=6A51029D"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Zoo Park", "keywords": ["animals", "zoo", "park", "forest", "nature"], "long_description": "Zoo Park was developed for you to see the animals on their natural environment with the beautiful graphics and sounds. \n\nUsing your virtual reality glasses, you can see the animals moving closely with animations. It will be an exciting journey for you. \n\nYou don't need to go to a zoo to see the animals. Your children will also enjoy the virtual simulations as if they are in a zoo and know the names of many animals. Elephant, Lion, Lioness, Zebra, Crocodile, Hippopotamus, Rhinoceros, Chicken, Cow, Goat, Pig, Sheep, Bear, Boar, Fox, Rabbit, Stag, Wolf, Crow and more.\n\nHow to play\nIt is very easy. You should look at where you want to move. When you approach to animals, your movements will be slower or stop so that you will have time to examine them closely. You can use touchpad to go forward, back, left and right.\n\nFeatures\n- Very beautiful graphics. Realistic forest environment\n- Nice animated animals in Zoo\n- Natural sounds of animals", "short_description": "Zoo Park was developed for you to see the animals on their natural environment with the beautiful graphics and sounds."}]}, "developer_name": null, "developer_privacy_policy_url": "http://provr.net/privacy2.html", "developer_terms_of_service_url": "http://provr.net/privacy2.html", "publisher_name": "HASoft", "support_website_url": null, "website_url": "https://www.facebook.com/HASoft-Mobile-GamesApplications-680466725426771", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE", "EDUCATIONAL", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD", "GEAR_VR_CONTROLLE
J5A0pHCQqOKMyTM8zT6BFpgq5E&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBOQN5i1hempJieuCfmorgdgochDmdqx5zJmLINFg3UWA&oe=6A4E5806"}, {"file_name": "migrated_image.png", "id": "208088447206320", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/11162716_476745332724218_1676433208595447808_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Cq78wwyXbkQQ7kNvwH-pkiH&_nc_oc=AdpS9o0VVd4I2c8-EiKnj0l7QabTH9ZFQeNNaua7rrwUOtd9VbcM3-nSH-OxJOpefJo&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDZTBzVEOsI5TuWEZqZmZgXmsjYhxlU8rKa1Mg1YJgF9w&oe=6A4E3FD6"}, {"file_name": "migrated_image.png", "id": "290138991968813", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/11162690_510656702601736_3434315365243420672_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uLB3_Rtl27sQ7kNvwEfqqDY&_nc_oc=Adp73BAn50bK-9IHHLUGSbYEZGTgN2fbsHjVW5ghRypqmM3kQEmk0-jTlycMoq0CMe4&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCqks33x23uhncl-d1FYPa-IBfO_R6zwwedAXcEhVTIVg&oe=6A4E6B1A"}, {"file_name": "migrated_image.png", "id": "2526122730961072", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/11162700_286111548569698_6750775844337090560_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AFZJ5qf4OqsQ7kNvwHjPSaQ&_nc_oc=AdpHKcyGqWzMoMlDBh9shtcjKJt3U5ADLwhuZnVCOkghUorieq19uWrdM28QwIHnHIM&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC3ATZCb01p1UAw7JpFSoQQx06BTyi6XxRh--qMS7Uqow&oe=6A4E58E5"}, {"file_name": "migrated_image.png", "id": "526738798265020", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/11162682_179116105994090_8275689972598571008_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3AlCuo9DItIQ7kNvwGJuA-u&_nc_oc=Adq-eX-VpJq9GvRW4CEFfL0p7QxblD4OaL5HbB92WekYqf66OkEBjiyZCDuYWZuKbsE&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD16FiwCVVgiNqz8omBD9kQmb0UZX8YIFMb7IUD_Vf5Cw&oe=6A4E5F9D"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Zoo Park", "keywords": ["animals", "zoo", "park", "forest", "nature"], "long_description": "Zoo Park was developed for you to see the animals on their natural environment with the beautiful graphics and sounds. \n\nUsing your virtual reality glasses, you can see the animals moving closely with animations. It will be an exciting journey for you. \n\nYou don't need to go to a zoo to see the animals. Your children will also enjoy the virtual simulations as if they are in a zoo and know the names of many animals. Elephant, Lion, Lioness, Zebra, Crocodile, Hippopotamus, Rhinoceros, Chicken, Cow, Goat, Pig, Sheep, Bear, Boar, Fox, Rabbit, Stag, Wolf, Crow and more.\n\nHow to play\nIt is very easy. You should look at where you want to move. When you approach to animals, your movements will be slower or stop so that you will have time to examine them closely. You can use touchpad to go forward, back, left and right.\n\nFeatures\n- Very beautiful graphics. Realistic forest environment\n- Nice animated animals in Zoo\n- Natural sounds of animals", "short_description": "Zoo Park was developed for you to see the animals on their natural environment with the beautiful graphics and sounds."}]}, "developer_name": null, "developer_privacy_policy_url": "http://provr.net/privacy2.html", "developer_terms_of_service_url": "http://provr.net/privacy2.html", "publisher_name": "HASoft", "support_website_url": null, "website_url": "https://www.facebook.com/HASoft-Mobile-GamesApplications-680466725426771", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE", "EDUCATIONAL", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD", "GEAR_VR_CONTROLLE
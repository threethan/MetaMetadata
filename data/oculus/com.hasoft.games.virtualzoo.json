2_PxurihRlx9pw23N2KNTp23VU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7-wSUAF_GWPke5jGV_CjOZi_wkyxwIeZWcMX_w5VGEuA&oe=6A0DBE86"}, {"file_name": "migrated_image.png", "id": "208088447206320", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/11162716_476745332724218_1676433208595447808_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uLRLgGqkQ0kQ7kNvwEhPD2a&_nc_oc=Ado6HV1U8DVjknbqEqsEL1aJmmTpW-tILO7GF4vUriqCK0PICgVCxV0lje9ZThCYbmY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4rvjmjlDFpwO6poYU-GAXJEeebyG-6hYMV3e19xFl_0A&oe=6A0DA656"}, {"file_name": "migrated_image.png", "id": "290138991968813", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/11162690_510656702601736_3434315365243420672_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P36r6DMvjgkQ7kNvwGGSPPM&_nc_oc=AdosYOM6oGO2AtJTJgXexteXB7pMnFFn1TU5p9OY9JYd4GmwKEKRHgZQb0gaF2jWEdY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6GGoQfDxa4U2UJEXsa7BtlXLn_-1Won0eqCyblHWFrWQ&oe=6A0DD19A"}, {"file_name": "migrated_image.png", "id": "2526122730961072", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/11162700_286111548569698_6750775844337090560_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c330NkLYLUkQ7kNvwFeaOI4&_nc_oc=AdpBNU-58kNOCybHMC34PUjlIBxQcifssz192gR-J8NGQFqV3i-X8zOp9D4OKDj_tow&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5Gg4ZQDiq1sPZjg-hRb53OBoxVTSMMl292089ngAVe9w&oe=6A0DBF65"}, {"file_name": "migrated_image.png", "id": "526738798265020", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/11162682_179116105994090_8275689972598571008_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UiuDAliXTzIQ7kNvwF-DVla&_nc_oc=AdpTb6LNa9vEgdW1GhZ2Dt3yD2PBlAZS8n_ZPkRjXGL1IeETKS337LzyJxwkigtAgLM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5FSEgNxPqCI_z5qMlmSKAykEUx4ojGhbJA6_FCkM1ChA&oe=6A0DC61D"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Zoo Park", "keywords": ["animals", "zoo", "park", "forest", "nature"], "long_description": "Zoo Park was developed for you to see the animals on their natural environment with the beautiful graphics and sounds. \n\nUsing your virtual reality glasses, you can see the animals moving closely with animations. It will be an exciting journey for you. \n\nYou don't need to go to a zoo to see the animals. Your children will also enjoy the virtual simulations as if they are in a zoo and know the names of many animals. Elephant, Lion, Lioness, Zebra, Crocodile, Hippopotamus, Rhinoceros, Chicken, Cow, Goat, Pig, Sheep, Bear, Boar, Fox, Rabbit, Stag, Wolf, Crow and more.\n\nHow to play\nIt is very easy. You should look at where you want to move. When you approach to animals, your movements will be slower or stop so that you will have time to examine them closely. You can use touchpad to go forward, back, left and right.\n\nFeatures\n- Very beautiful graphics. Realistic forest environment\n- Nice animated animals in Zoo\n- Natural sounds of animals", "short_description": "Zoo Park was developed for you to see the animals on their natural environment with the beautiful graphics and sounds."}]}, "developer_name": null, "developer_privacy_policy_url": "http://provr.net/privacy2.html", "developer_terms_of_service_url": "http://provr.net/privacy2.html", "publisher_name": "HASoft", "support_website_url": null, "website_url": "https://www.facebook.com/HASoft-Mobile-GamesApplications-680466725426771", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE", "EDUCATIONAL", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD", "GEAR_VR_CONTROLLE
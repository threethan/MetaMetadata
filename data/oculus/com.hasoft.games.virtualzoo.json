h_RwjbmrwSFX-gy2kfspAsyD7Q&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-F5hsu-39IqNOq9y-y4nNFrBVfS079wTNOcd6z0va2IA&oe=6A451D86"}, {"file_name": "migrated_image.png", "id": "208088447206320", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/11162716_476745332724218_1676433208595447808_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jIXeiQxLsoIQ7kNvwFVuQLr&_nc_oc=AdpzOtRk3YKDZT3ZGzDf090hUDR0j0huovP6gN4s8u6WSGw_tzV8mthO4aEcBmG4j3U&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_mnQzUik6kJndmyZGz7cM74nIk79vblDhV50de2UokBQ&oe=6A450556"}, {"file_name": "migrated_image.png", "id": "290138991968813", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/11162690_510656702601736_3434315365243420672_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XzAYYlEab-cQ7kNvwEyuGJa&_nc_oc=Adq-92sSvajX5p7jyn8JqCb360vs_RSgbq_Bs4sebBt-2uBGWqxPX_NGfWRMHQmnqWE&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_HHaIVoap3AVEF8dDak-d7usp-u8UNBt_xy9FmdpmMwA&oe=6A45309A"}, {"file_name": "migrated_image.png", "id": "2526122730961072", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/11162700_286111548569698_6750775844337090560_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pv8_ChvcuKcQ7kNvwEwTehK&_nc_oc=AdoY9bhQEQFP_MUKLs4MuQsTYn_UUVjR5BiCOTJ9Gj8M_XKy2hFgOsHFG2F_cOGqr5U&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_hRE506NsKRLkzD_R8S36h9E3w9msRkOWvRPrFkpWB5w&oe=6A451E65"}, {"file_name": "migrated_image.png", "id": "526738798265020", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/11162682_179116105994090_8275689972598571008_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IWQX8IWHj8sQ7kNvwGL8UUV&_nc_oc=Adoar5B73qUNcX9U6s8ORV8VvVgaZpMZJ7Ac6BvspghOCbKABmMRxeVV4sgUnaDG1_o&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8fWn7sXLuuMVNHmO61VRMNwx5tjUIahiRrPhmFZQKYYg&oe=6A45251D"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Zoo Park", "keywords": ["animals", "zoo", "park", "forest", "nature"], "long_description": "Zoo Park was developed for you to see the animals on their natural environment with the beautiful graphics and sounds. \n\nUsing your virtual reality glasses, you can see the animals moving closely with animations. It will be an exciting journey for you. \n\nYou don't need to go to a zoo to see the animals. Your children will also enjoy the virtual simulations as if they are in a zoo and know the names of many animals. Elephant, Lion, Lioness, Zebra, Crocodile, Hippopotamus, Rhinoceros, Chicken, Cow, Goat, Pig, Sheep, Bear, Boar, Fox, Rabbit, Stag, Wolf, Crow and more.\n\nHow to play\nIt is very easy. You should look at where you want to move. When you approach to animals, your movements will be slower or stop so that you will have time to examine them closely. You can use touchpad to go forward, back, left and right.\n\nFeatures\n- Very beautiful graphics. Realistic forest environment\n- Nice animated animals in Zoo\n- Natural sounds of animals", "short_description": "Zoo Park was developed for you to see the animals on their natural environment with the beautiful graphics and sounds."}]}, "developer_name": null, "developer_privacy_policy_url": "http://provr.net/privacy2.html", "developer_terms_of_service_url": "http://provr.net/privacy2.html", "publisher_name": "HASoft", "support_website_url": null, "website_url": "https://www.facebook.com/HASoft-Mobile-GamesApplications-680466725426771", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE", "EDUCATIONAL", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD", "GEAR_VR_CONTROLLE
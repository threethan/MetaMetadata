p-1qpIJSYoy8DLj5HAjH9_L5-0&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_1LuDB5hKil3svr-vCp9lBzCGYpV5qho2ywE87DS1cpg&oe=6A43CC06"}, {"file_name": "migrated_image.png", "id": "208088447206320", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/11162716_476745332724218_1676433208595447808_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jIXeiQxLsoIQ7kNvwGKo2SK&_nc_oc=AdrynpCtUg5rC_6fnPFkacSb4OWkRNd_3oEFI5Zs5FHKClMLB4EivzL_54Rz2hF-jZ4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8xwvBLqBE8UveB_uM2OM57ZSb_CNFjxCm9Rwoj_WDioQ&oe=6A43EC16"}, {"file_name": "migrated_image.png", "id": "290138991968813", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/11162690_510656702601736_3434315365243420672_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m6xvpwqq1ucQ7kNvwF2pgem&_nc_oc=AdpjoJ7uzfPzVtmFx5C41NJ0yruDImqraCxxXMvmMlHJlsLc8Abbg6zMiqg4bnnAt7Q&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8q4gj41pmR0eGALGbDAHgdODJLk3OOqkfN0GFk4JoJuQ&oe=6A43DF1A"}, {"file_name": "migrated_image.png", "id": "2526122730961072", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/11162700_286111548569698_6750775844337090560_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vt5LxWtmM_YQ7kNvwFDnVnR&_nc_oc=AdonRUblS9Dv61f2W2WOU_uVIVFRuTtFPG6xmrJ2vbm3Xbpd4VmHVuc_49-vFuzj7WM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_6lK7Zrasb7UuyKvHxAnNFkm4CS8xTCnTnh1aD0PBXag&oe=6A43CCE5"}, {"file_name": "migrated_image.png", "id": "526738798265020", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/11162682_179116105994090_8275689972598571008_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IWQX8IWHj8sQ7kNvwG6bRD4&_nc_oc=Adol4Lk1sTUQp8DG6Ng0tAgjVLGr3lakyHo50C3cbOpC9t_yC7EGjCWGkXhibvYUn8U&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8MhWMq7b20QQ7GTy0yB2n-uSX4XLYUgF_d_JbYhm98sQ&oe=6A43D39D"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Zoo Park", "keywords": ["animals", "zoo", "park", "forest", "nature"], "long_description": "Zoo Park was developed for you to see the animals on their natural environment with the beautiful graphics and sounds. \n\nUsing your virtual reality glasses, you can see the animals moving closely with animations. It will be an exciting journey for you. \n\nYou don't need to go to a zoo to see the animals. Your children will also enjoy the virtual simulations as if they are in a zoo and know the names of many animals. Elephant, Lion, Lioness, Zebra, Crocodile, Hippopotamus, Rhinoceros, Chicken, Cow, Goat, Pig, Sheep, Bear, Boar, Fox, Rabbit, Stag, Wolf, Crow and more.\n\nHow to play\nIt is very easy. You should look at where you want to move. When you approach to animals, your movements will be slower or stop so that you will have time to examine them closely. You can use touchpad to go forward, back, left and right.\n\nFeatures\n- Very beautiful graphics. Realistic forest environment\n- Nice animated animals in Zoo\n- Natural sounds of animals", "short_description": "Zoo Park was developed for you to see the animals on their natural environment with the beautiful graphics and sounds."}]}, "developer_name": null, "developer_privacy_policy_url": "http://provr.net/privacy2.html", "developer_terms_of_service_url": "http://provr.net/privacy2.html", "publisher_name": "HASoft", "support_website_url": null, "website_url": "https://www.facebook.com/HASoft-Mobile-GamesApplications-680466725426771", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE", "EDUCATIONAL", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD", "GEAR_VR_CONTROLLE
8L0owDq8lG2UKG91ju2y2t5rTk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af527XamFiL5EGB-trUAB4yNUF3Gss1702LRYtyBS-V-Ow&oe=6A0B1B86"}, {"file_name": "migrated_image.png", "id": "208088447206320", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/11162716_476745332724218_1676433208595447808_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VLxHZLesU10Q7kNvwFArEKk&_nc_oc=Ados5J34caOK3afxeU8jHk1-WqB4chXYu2VZt1SL8mlHYsFYn6Z85HgKYbYOv4kIuBw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4ba2qCg3IWP89Il1OXxnzVMJJ3LkmNncPE8Vdb5Fty6Q&oe=6A0B0356"}, {"file_name": "migrated_image.png", "id": "290138991968813", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/11162690_510656702601736_3434315365243420672_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KIwPP5lU44kQ7kNvwEJHJgp&_nc_oc=AdrGyuLOV0OvBEq5C4EYvjY6AjI__ofBB75byvG0UtG8REZ3zOOxqeiHENZK4CHDCGk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6pSTzSAlZCK-JmMCmJxpew7DV1CbPn_emrZDwAQnw5kQ&oe=6A0B2E9A"}, {"file_name": "migrated_image.png", "id": "2526122730961072", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/11162700_286111548569698_6750775844337090560_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GPdpN-auUJ4Q7kNvwEgI03t&_nc_oc=AdrVqXtZEftXnScFd3nAVMipYUsafhQO-ZtPCE1B_qMVN7afsLs-Z_gJsG0ijmyxKDQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6kuKsKgZSWSBDIvHCYdMBzY30JMXAvr2An8_K7686pWA&oe=6A0B1C65"}, {"file_name": "migrated_image.png", "id": "526738798265020", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/11162682_179116105994090_8275689972598571008_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Vvmu8M2BfokQ7kNvwGDxdZ_&_nc_oc=Adqbd2oPkAuGOYmVMd2X5EWrLuSWSs6hjnwUkl41awj8YqOq2iuEuVtIXEOdcZ-6QoQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5inUXXPzgIsMTv61HA0fJCRGxEcEkUoxETdETbfPgdtQ&oe=6A0B231D"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Zoo Park", "keywords": ["animals", "zoo", "park", "forest", "nature"], "long_description": "Zoo Park was developed for you to see the animals on their natural environment with the beautiful graphics and sounds. \n\nUsing your virtual reality glasses, you can see the animals moving closely with animations. It will be an exciting journey for you. \n\nYou don't need to go to a zoo to see the animals. Your children will also enjoy the virtual simulations as if they are in a zoo and know the names of many animals. Elephant, Lion, Lioness, Zebra, Crocodile, Hippopotamus, Rhinoceros, Chicken, Cow, Goat, Pig, Sheep, Bear, Boar, Fox, Rabbit, Stag, Wolf, Crow and more.\n\nHow to play\nIt is very easy. You should look at where you want to move. When you approach to animals, your movements will be slower or stop so that you will have time to examine them closely. You can use touchpad to go forward, back, left and right.\n\nFeatures\n- Very beautiful graphics. Realistic forest environment\n- Nice animated animals in Zoo\n- Natural sounds of animals", "short_description": "Zoo Park was developed for you to see the animals on their natural environment with the beautiful graphics and sounds."}]}, "developer_name": null, "developer_privacy_policy_url": "http://provr.net/privacy2.html", "developer_terms_of_service_url": "http://provr.net/privacy2.html", "publisher_name": "HASoft", "support_website_url": null, "website_url": "https://www.facebook.com/HASoft-Mobile-GamesApplications-680466725426771", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE", "EDUCATIONAL", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD", "GEAR_VR_CONTROLLE
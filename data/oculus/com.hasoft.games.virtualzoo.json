_lOHqzBO9w2kvAuY_u_yri7nWY&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG7dGCxwVr21A3asmGr0uawwD7ifT3IvMEVBhNP6A5m1Q&oe=6A974B06"}, {"file_name": "migrated_image.png", "id": "208088447206320", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/11162716_476745332724218_1676433208595447808_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Hq5mw55psNgQ7kNvwG-LaVB&_nc_oc=AdrfHU14FDIp3u3kRrN4jtcS4jG-S-OLbikzqkQ6xTv1vkyDk8UVjlR5hPfNf5-ZLXI&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHg6V8lNeDcXapBcWLdPrvs0t62RwO8FsMgwae_NyIZ3Q&oe=6A9732D6"}, {"file_name": "migrated_image.png", "id": "290138991968813", "uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/11162690_510656702601736_3434315365243420672_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TPWkhfnCZ-IQ7kNvwF7bFO6&_nc_oc=AdoNZOcEB-l9xMvm1HHtiPPrMryvM8Kj1UcgeqKnfeTxt6NH0ZA-9RbzOBEI0YIW1Lo&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFGxIT-drLLI3JeJterFAoDrMaMIaZ0ABsgLF4hyY0SKw&oe=6A9725DA"}, {"file_name": "migrated_image.png", "id": "2526122730961072", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/11162700_286111548569698_6750775844337090560_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wtzfvnS52MAQ7kNvwEErK5y&_nc_oc=AdqbzOczALfcHFH9PhLsjw59WAroQFIp3X3KprUZFpdt8BHIrxk4X9iy6fM-YSlmPm0&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEUqGXbSLvGziIEfqJLKEsRsSnbKP2_wkPGiADy48evtA&oe=6A974BE5"}, {"file_name": "migrated_image.png", "id": "526738798265020", "uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/11162682_179116105994090_8275689972598571008_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gT_EGqVgXL4Q7kNvwF208Wx&_nc_oc=AdoIrIqzicSmD9NZnWlEiiDnrJP_AGNt1hNWH_xZ5Qv_QxkFeo58aAKyaYMdQhDXtjw&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHgtEbrrUqan-pufJJqX_MOGrY9gp_jPTLSaKKeHMr4Vw&oe=6A97529D"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Zoo Park", "keywords": ["animals", "zoo", "park", "forest", "nature"], "long_description": "Zoo Park was developed for you to see the animals on their natural environment with the beautiful graphics and sounds. \n\nUsing your virtual reality glasses, you can see the animals moving closely with animations. It will be an exciting journey for you. \n\nYou don't need to go to a zoo to see the animals. Your children will also enjoy the virtual simulations as if they are in a zoo and know the names of many animals. Elephant, Lion, Lioness, Zebra, Crocodile, Hippopotamus, Rhinoceros, Chicken, Cow, Goat, Pig, Sheep, Bear, Boar, Fox, Rabbit, Stag, Wolf, Crow and more.\n\nHow to play\nIt is very easy. You should look at where you want to move. When you approach to animals, your movements will be slower or stop so that you will have time to examine them closely. You can use touchpad to go forward, back, left and right.\n\nFeatures\n- Very beautiful graphics. Realistic forest environment\n- Nice animated animals in Zoo\n- Natural sounds of animals", "short_description": "Zoo Park was developed for you to see the animals on their natural environment with the beautiful graphics and sounds."}]}, "developer_name": null, "developer_privacy_policy_url": "http://provr.net/privacy2.html", "developer_terms_of_service_url": "http://provr.net/privacy2.html", "publisher_name": "HASoft", "support_website_url": null, "website_url": "https://www.facebook.com/HASoft-Mobile-GamesApplications-680466725426771", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE", "EDUCATIONAL", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD", "GEAR_VR_CONTROLLE
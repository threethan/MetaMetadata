yTQDyCe5VeeThHRDwPadRse-w0&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE9i0zi6WcIh_Tvpqu-wD1Vrdglzi8fFKS_ZMUaj5bgiw&oe=6A8AC4C6"}, {"file_name": "migrated_image.png", "id": "208088447206320", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/11162716_476745332724218_1676433208595447808_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TCxTN9X5SUwQ7kNvwEp2Ujr&_nc_oc=AdoDz2mQS9cP27MeX9yBgOP4JZI0MoAHAnfgkO_ejWX7yk0ugIu-KnKNRi70nO1GNr0&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF3qCk65nBt6VQD4wbDBTNfh65TWaME_JqfFEEHppRiRA&oe=6A8AE4D6"}, {"file_name": "migrated_image.png", "id": "290138991968813", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/11162690_510656702601736_3434315365243420672_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GE-Z3UyKpY8Q7kNvwHfkKtT&_nc_oc=AdqYk_Cu61Deb1ewZ_BgyULJMbg5oBCfys9Y-HQTrEp7Md5LW0hIFRzR4bPr3qxpkOg&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFipu8sCAJno-OtYyaLenrwzvWxV6eIhzdPbSvRab8ZNg&oe=6A8AD7DA"}, {"file_name": "migrated_image.png", "id": "2526122730961072", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/11162700_286111548569698_6750775844337090560_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SkCu41weKzkQ7kNvwHOCGKs&_nc_oc=AdoRsJChpAeoYDRrspM5ATw_RY8GsQN8NchmBR9SaA9MSwrohWcdmfbfrrR9S_7an0M&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH0VhUmscS5yWyhgTvCob3xW-oinpnFwxmKHKdbjIA3RQ&oe=6A8AC5A5"}, {"file_name": "migrated_image.png", "id": "526738798265020", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/11162682_179116105994090_8275689972598571008_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NhAHpodWW84Q7kNvwGchMvu&_nc_oc=AdoSF7T8afN_rWH6Ie1h2I9fZh93PF_dpMfPoUHw6HL2oepgIfGv5-qY739ZO24ca74&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFs3sd2MOg4ygTI1c7bcwbi1MjpEiw91aVOOx_tgC1VVg&oe=6A8ACC5D"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Zoo Park", "keywords": ["animals", "zoo", "park", "forest", "nature"], "long_description": "Zoo Park was developed for you to see the animals on their natural environment with the beautiful graphics and sounds. \n\nUsing your virtual reality glasses, you can see the animals moving closely with animations. It will be an exciting journey for you. \n\nYou don't need to go to a zoo to see the animals. Your children will also enjoy the virtual simulations as if they are in a zoo and know the names of many animals. Elephant, Lion, Lioness, Zebra, Crocodile, Hippopotamus, Rhinoceros, Chicken, Cow, Goat, Pig, Sheep, Bear, Boar, Fox, Rabbit, Stag, Wolf, Crow and more.\n\nHow to play\nIt is very easy. You should look at where you want to move. When you approach to animals, your movements will be slower or stop so that you will have time to examine them closely. You can use touchpad to go forward, back, left and right.\n\nFeatures\n- Very beautiful graphics. Realistic forest environment\n- Nice animated animals in Zoo\n- Natural sounds of animals", "short_description": "Zoo Park was developed for you to see the animals on their natural environment with the beautiful graphics and sounds."}]}, "developer_name": null, "developer_privacy_policy_url": "http://provr.net/privacy2.html", "developer_terms_of_service_url": "http://provr.net/privacy2.html", "publisher_name": "HASoft", "support_website_url": null, "website_url": "https://www.facebook.com/HASoft-Mobile-GamesApplications-680466725426771", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE", "EDUCATIONAL", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD", "GEAR_VR_CONTROLLE
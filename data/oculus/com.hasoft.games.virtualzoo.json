cjS8vuOEgvXgFwJpIgTBezlibc&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_GslMzK6M7gn65WyOSlM29J2wuHNURHjJBMBsY-MU_Yw&oe=6A47C086"}, {"file_name": "migrated_image.png", "id": "208088447206320", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/11162716_476745332724218_1676433208595447808_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Cv6kgcSOCRwQ7kNvwGI6KIz&_nc_oc=AdpPPvClTXu83e6LWPKV0oQk1gX4z4TabWfF-YJE5zfz5fsoKi5oUIGQoeNHfzbwn9o&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_8-pJgElz8eMa5A-QCCUxKl0hsg4CAL5byMu7s2KgUtA&oe=6A47E096"}, {"file_name": "migrated_image.png", "id": "290138991968813", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/11162690_510656702601736_3434315365243420672_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XzAYYlEab-cQ7kNvwGGGztX&_nc_oc=Adq8TtAPZgFYbkWPWLXuUt0WFspCPjZDQJorkx9lE2uCeVrH7YP0K9Q-Q9RpzBaHkRY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8XekK6uewNbVsDRRFORz4gKfZIWpnf7z7W7N_wd__Q1Q&oe=6A47D39A"}, {"file_name": "migrated_image.png", "id": "2526122730961072", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/11162700_286111548569698_6750775844337090560_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pv8_ChvcuKcQ7kNvwFY5IXu&_nc_oc=AdpfI1VAiAo3WqTAZEtFQXshCS6fYOjEVQ7do-6rHKs0GHU0j45KvuZ_BPI-PcpniR0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8mMLMmhpZD-3Ka4tZ0dfUIdlbypvBs4oTvZd6HDX1X5Q&oe=6A47C165"}, {"file_name": "migrated_image.png", "id": "526738798265020", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/11162682_179116105994090_8275689972598571008_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uFs6qs0pMu8Q7kNvwEnygqq&_nc_oc=Ado8G1LDcALtRqzWBplKpSEjW2E8i5yMDXq8jVfqnwe79Ev5a5CmgloglpDoEtfD1UE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8eNqgLZfC_1Nqphe260q3fQ02we19mPlm5qHBqQdOuFg&oe=6A47C81D"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Zoo Park", "keywords": ["animals", "zoo", "park", "forest", "nature"], "long_description": "Zoo Park was developed for you to see the animals on their natural environment with the beautiful graphics and sounds. \n\nUsing your virtual reality glasses, you can see the animals moving closely with animations. It will be an exciting journey for you. \n\nYou don't need to go to a zoo to see the animals. Your children will also enjoy the virtual simulations as if they are in a zoo and know the names of many animals. Elephant, Lion, Lioness, Zebra, Crocodile, Hippopotamus, Rhinoceros, Chicken, Cow, Goat, Pig, Sheep, Bear, Boar, Fox, Rabbit, Stag, Wolf, Crow and more.\n\nHow to play\nIt is very easy. You should look at where you want to move. When you approach to animals, your movements will be slower or stop so that you will have time to examine them closely. You can use touchpad to go forward, back, left and right.\n\nFeatures\n- Very beautiful graphics. Realistic forest environment\n- Nice animated animals in Zoo\n- Natural sounds of animals", "short_description": "Zoo Park was developed for you to see the animals on their natural environment with the beautiful graphics and sounds."}]}, "developer_name": null, "developer_privacy_policy_url": "http://provr.net/privacy2.html", "developer_terms_of_service_url": "http://provr.net/privacy2.html", "publisher_name": "HASoft", "support_website_url": null, "website_url": "https://www.facebook.com/HASoft-Mobile-GamesApplications-680466725426771", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE", "EDUCATIONAL", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD", "GEAR_VR_CONTROLLE
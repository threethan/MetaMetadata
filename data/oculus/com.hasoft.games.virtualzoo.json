ycX97mIWWaAblfEvMubE4sC3rE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1ZMHq6exGHhKkcWU2snLhnI6iVTWnatOCnUyiBQvjf_w&oe=69E4E006"}, {"file_name": "migrated_image.png", "id": "208088447206320", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/11162716_476745332724218_1676433208595447808_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6B_UdCzEyiEQ7kNvwEwBQCe&_nc_oc=AdqqgQ_IOLuxKdOPlMALHDc7mW-tZPlfht-2ugKW1pEzWX05-Bp9VsNNC0NWxtn6YQs&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3HRIDuFBW4IqCaGxMAqOTwRj4P3JBDLfqH9Xu9KdiSPg&oe=69E4C7D6"}, {"file_name": "migrated_image.png", "id": "290138991968813", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/11162690_510656702601736_3434315365243420672_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ULLDtimxWZYQ7kNvwFeT0-M&_nc_oc=AdqIiCEkvnud4SgqDVn_d-lBm0nQFuNyV6g-lHRWL94H3KmlqYFRRyFbr2EqNObho_0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3FSDLQxL30XWswb6AG0QE9CFk7ZhJW9CiTY0MQ2ICEXg&oe=69E4BADA"}, {"file_name": "migrated_image.png", "id": "2526122730961072", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/11162700_286111548569698_6750775844337090560_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=p4DZzNLQuBgQ7kNvwGB14X9&_nc_oc=Adrp8IJE3822cAYzGZKmpdeFSfP1WQCXWPI-fBnpZmkZAItnZ78p5dtYElemisPRv1k&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af19urLHN0TiCgrOtYJtlQF4gA-zT5UWfr1GCu0u-vs-Lg&oe=69E4E0E5"}, {"file_name": "migrated_image.png", "id": "526738798265020", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/11162682_179116105994090_8275689972598571008_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5RxGOmjkggkQ7kNvwGg9fbT&_nc_oc=AdoBPsZrw9BvOhuyZboxpf7AZDhceJTRYcSh72ONzr-FU79nntJHjF2LrjDfEQdpHro&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1Q9V1NsoYGUUK29KuZ-HoJ8Jb_jRKYqer0jBGKQftYDw&oe=69E4E79D"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Zoo Park", "keywords": ["animals", "zoo", "park", "forest", "nature"], "long_description": "Zoo Park was developed for you to see the animals on their natural environment with the beautiful graphics and sounds. \n\nUsing your virtual reality glasses, you can see the animals moving closely with animations. It will be an exciting journey for you. \n\nYou don't need to go to a zoo to see the animals. Your children will also enjoy the virtual simulations as if they are in a zoo and know the names of many animals. Elephant, Lion, Lioness, Zebra, Crocodile, Hippopotamus, Rhinoceros, Chicken, Cow, Goat, Pig, Sheep, Bear, Boar, Fox, Rabbit, Stag, Wolf, Crow and more.\n\nHow to play\nIt is very easy. You should look at where you want to move. When you approach to animals, your movements will be slower or stop so that you will have time to examine them closely. You can use touchpad to go forward, back, left and right.\n\nFeatures\n- Very beautiful graphics. Realistic forest environment\n- Nice animated animals in Zoo\n- Natural sounds of animals", "short_description": "Zoo Park was developed for you to see the animals on their natural environment with the beautiful graphics and sounds."}]}, "developer_name": null, "developer_privacy_policy_url": "http://provr.net/privacy2.html", "developer_terms_of_service_url": "http://provr.net/privacy2.html", "publisher_name": "HASoft", "support_website_url": null, "website_url": "https://www.facebook.com/HASoft-Mobile-GamesApplications-680466725426771", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE", "EDUCATIONAL", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD", "GEAR_VR_CONTROLLE
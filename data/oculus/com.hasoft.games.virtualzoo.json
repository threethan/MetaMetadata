_ohc=alQkjk-9SPIQ7kNvwFv8OLx&_nc_oc=Adr4MA7BW4GtaMx4-ZMFph4INQlfkNohORKNE1iG5kHFhmyhQ4-WilYS4OSxB_S77yk&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRUJRDP-Mim9lldrPzML-vApsbxj7fC1u5hriuPT6zyhA&oe=6AFB4C5D"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Zoo Park", "keywords": ["animals", "zoo", "park", "forest", "nature"], "long_description": "Zoo Park was developed for you to see the animals on their natural environment with the beautiful graphics and sounds. \n\nUsing your virtual reality glasses, you can see the animals moving closely with animations. It will be an exciting journey for you. \n\nYou don't need to go to a zoo to see the animals. Your children will also enjoy the virtual simulations as if they are in a zoo and know the names of many animals. Elephant, Lion, Lioness, Zebra, Crocodile, Hippopotamus, Rhinoceros, Chicken, Cow, Goat, Pig, Sheep, Bear, Boar, Fox, Rabbit, Stag, Wolf, Crow and more.\n\nHow to play\nIt is very easy. You should look at where you want to move. When you approach to animals, your movements will be slower or stop so that you will have time to examine them closely. You can use touchpad to go forward, back, left and right.\n\nFeatures\n- Very beautiful graphics. Realistic forest environment\n- Nice animated animals in Zoo\n- Natural sounds of animals", "short_description": "Zoo Park was developed for you to see the animals on their natural environment with the beautiful graphics and sounds."}]}, "developer_name": null, "developer_privacy_policy_url": "http://provr.net/privacy2.html", "developer_terms_of_service_url": "http://provr.net/privacy2.html", "publisher_name": "HASoft", "support_website_url": null, "website_url": "https://www.facebook.com/HASoft-Mobile-GamesApplications-680466725426771", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["
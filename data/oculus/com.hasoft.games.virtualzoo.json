7HXByVvVW2piEei5M0kY72BsvM&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSx5QY55RocAOjwmjHm7NJ5W9eHGL93ZpHDGHgLvqIEYw&oe=6AF9BB06"}, {"file_name": "migrated_image.png", "id": "208088447206320", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/11162716_476745332724218_1676433208595447808_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6DxgmHUwgt4Q7kNvwHraoKR&_nc_oc=AdoWhbRAAaNu61F2IZPy1yWKywX1pO26nbuUdAtnDs82ZkkpuxMiBeUHnWToHIAIqu4&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRYLxSD6xo-NnBIDyJQSB1oyYc3lFxNtNkqnREW7hRNGw&oe=6AF9DB16"}, {"file_name": "migrated_image.png", "id": "290138991968813", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/11162690_510656702601736_3434315365243420672_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XYUFYSQfzTwQ7kNvwG-PiUl&_nc_oc=AdqpETCIpKrwUeKK9OWsZxEMUyN15pSwWtOlpAjdjT0TcBLXm_wvg93xZBA3-BF5zhc&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQJMKAHFTnw37kUUnhgF0r_lIctKS0s0VNlsJcnVPzChg&oe=6AF9CE1A"}, {"file_name": "migrated_image.png", "id": "2526122730961072", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/11162700_286111548569698_6750775844337090560_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H0LYtWdypnkQ7kNvwEhEmD2&_nc_oc=Adr1ytecW0s-n-brULp3kGYpuqiwHukYiIUEGX6ipTLA_XzZm6lLO-TCqIMQMIQX8pc&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRYlP5SQP0gMPoFFhUFhr4xKBvydNK17mG07DEZqZiChQ&oe=6AF9BBE5"}, {"file_name": "migrated_image.png", "id": "526738798265020", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/11162682_179116105994090_8275689972598571008_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=alQkjk-9SPIQ7kNvwFA2Z3b&_nc_oc=AdrjV3K7BikChHSYh5ZzJryek7njy5DpX0-H2apE0CSS7IQOcCV-Aq_k-QnYQQaWRJA&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR6fR_R7ovx7LbboThGOjiDgXK1ORu3Xbg_RBkfN4Vbdg&oe=6AF9C29D"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Zoo Park", "keywords": ["animals", "zoo", "park", "forest", "nature"], "long_description": "Zoo Park was developed for you to see the animals on their natural environment with the beautiful graphics and sounds. \n\nUsing your virtual reality glasses, you can see the animals moving closely with animations. It will be an exciting journey for you. \n\nYou don't need to go to a zoo to see the animals. Your children will also enjoy the virtual simulations as if they are in a zoo and know the names of many animals. Elephant, Lion, Lioness, Zebra, Crocodile, Hippopotamus, Rhinoceros, Chicken, Cow, Goat, Pig, Sheep, Bear, Boar, Fox, Rabbit, Stag, Wolf, Crow and more.\n\nHow to play\nIt is very easy. You should look at where you want to move. When you approach to animals, your movements will be slower or stop so that you will have time to examine them closely. You can use touchpad to go forward, back, left and right.\n\nFeatures\n- Very beautiful graphics. Realistic forest environment\n- Nice animated animals in Zoo\n- Natural sounds of animals", "short_description": "Zoo Park was developed for you to see the animals on their natural environment with the beautiful graphics and sounds."}]}, "developer_name": null, "developer_privacy_policy_url": "http://provr.net/privacy2.html", "developer_terms_of_service_url": "http://provr.net/privacy2.html", "publisher_name": "HASoft", "support_website_url": null, "website_url": "https://www.facebook.com/HASoft-Mobile-GamesApplications-680466725426771", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE", "EDUCATIONAL", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD", "GEAR_VR_CONTROLLE
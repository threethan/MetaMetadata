hBKSGrIgpH4yZ1BrUbWFzwmtZK3RnD8CxJ4&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHZ1_PHgPwx3lw6ciB5mNHluAO1UU8Uk4RLO2q7ymw3Gg&oe=6A857EC6"}, {"file_name": "migrated_image.png", "id": "208088447206320", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/11162716_476745332724218_1676433208595447808_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h70v3eWFAXsQ7kNvwG8qVHG&_nc_oc=Adoz1f5emPpgqxeqdt0n_cr6id5R4dostWvNq1W0yuTVEp6kud9__NW_BQnNFFbSQyU&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE5GD86v9ms4BBxX69KqxvDjXpixUqHUB7o4_YXP3fGcQ&oe=6A859ED6"}, {"file_name": "migrated_image.png", "id": "290138991968813", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/11162690_510656702601736_3434315365243420672_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_T4AzLozMAUQ7kNvwG3A9um&_nc_oc=Adoa9dGoTwED5XdbbQgIMAcRmpBJigCufdYb7c-A-GIdEate7O-IovN_Q-g43AhOs7c&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFsx9MgiWc1esrjpz7S8lywZgknnh-5lcmubxKg1nolRA&oe=6A8591DA"}, {"file_name": "migrated_image.png", "id": "2526122730961072", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/11162700_286111548569698_6750775844337090560_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BwbtUewud2gQ7kNvwFtQWQP&_nc_oc=AdrcCSza851IQGxSEyAxc1PlIDIjejQnLEI77a2r-G31KiuIt1g3gb_FVpsfdpJ7DA4&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGqh6hl5bdTCnj-lKkPzDZMbOL8rr8ZHt-HVY4uVjp1Lw&oe=6A857FA5"}, {"file_name": "migrated_image.png", "id": "526738798265020", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/11162682_179116105994090_8275689972598571008_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jMvtnfvO6zsQ7kNvwGgiqw4&_nc_oc=AdrK-9ZDweJ8Ju5NW9JKvA83qoVi4a7V6W4N9HhkM5y1VmKDLJl8dSrJC6RTZS-77ZU&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEldD1yELkCAsZOXN0Rr3l3dnSVMUPkCIVqrD6GoyULTg&oe=6A85865D"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Zoo Park", "keywords": ["animals", "zoo", "park", "forest", "nature"], "long_description": "Zoo Park was developed for you to see the animals on their natural environment with the beautiful graphics and sounds. \n\nUsing your virtual reality glasses, you can see the animals moving closely with animations. It will be an exciting journey for you. \n\nYou don't need to go to a zoo to see the animals. Your children will also enjoy the virtual simulations as if they are in a zoo and know the names of many animals. Elephant, Lion, Lioness, Zebra, Crocodile, Hippopotamus, Rhinoceros, Chicken, Cow, Goat, Pig, Sheep, Bear, Boar, Fox, Rabbit, Stag, Wolf, Crow and more.\n\nHow to play\nIt is very easy. You should look at where you want to move. When you approach to animals, your movements will be slower or stop so that you will have time to examine them closely. You can use touchpad to go forward, back, left and right.\n\nFeatures\n- Very beautiful graphics. Realistic forest environment\n- Nice animated animals in Zoo\n- Natural sounds of animals", "short_description": "Zoo Park was developed for you to see the animals on their natural environment with the beautiful graphics and sounds."}]}, "developer_name": null, "developer_privacy_policy_url": "http://provr.net/privacy2.html", "developer_terms_of_service_url": "http://provr.net/privacy2.html", "publisher_name": "HASoft", "support_website_url": null, "website_url": "https://www.facebook.com/HASoft-Mobile-GamesApplications-680466725426771", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE", "EDUCATIONAL", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD", "GEA
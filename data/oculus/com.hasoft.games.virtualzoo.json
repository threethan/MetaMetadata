gn-U_ZMFhffXpvXAJzmwkffv_NmKSjZPnQ&oe=699C5D86"}, {"file_name": "migrated_image.png", "id": "208088447206320", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/11162716_476745332724218_1676433208595447808_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PBq2GA2Dxe0Q7kNvwGBApA_&_nc_oc=AdnnEyX2vvvvBY5fvGWFJUOc6QtWvzggUq59l0F0gc55dj48Hs8a4Dqe1lPAe7VvIac&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_AftEl1u3ANyq1zh0IH68gylZqkztdSnHH9sjvwSqB6qe2Q&oe=699C4556"}, {"file_name": "migrated_image.png", "id": "290138991968813", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/11162690_510656702601736_3434315365243420672_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BnTaysw2KG8Q7kNvwEi2I4s&_nc_oc=AdlqjvLYyKlsYgV3cpwmCXieypCW4pXCRfEzJPXQauHBNHSOyDKb2ZXEGhgcoCgdfQU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_Afu_5xm3MezAyHZKFdyXURpSlKrG1J7csb0WIkq0d8HTiw&oe=699C385A"}, {"file_name": "migrated_image.png", "id": "2526122730961072", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/11162700_286111548569698_6750775844337090560_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OdXrwwukJAoQ7kNvwFTH-hG&_nc_oc=AdmHPCFvNHn5lXc36oyGN-KaGB348-XZ232KDJLvzN7aSKIjinR131o_BX4v9hmnEeU&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfthDdXCFKuL9ZO0EBgnLDaJMaForsqayBE6Zwnc0xpubQ&oe=699C5E65"}, {"file_name": "migrated_image.png", "id": "526738798265020", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/11162682_179116105994090_8275689972598571008_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V2jGFWTkDHkQ7kNvwHGSqke&_nc_oc=AdnnkxZAV9SgLO7722YLLcH8kd_KlcIaigmptm8MysVkUUy1DdGMPe4TQRCFq5Y6q8U&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AfuqfMtxa0bsUFV5F1ZG3mVCEs7GExoOm5PVMCMPmWyGng&oe=699C651D"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Zoo Park", "keywords": ["animals", "zoo", "park", "forest", "nature"], "long_description": "Zoo Park was developed for you to see the animals on their natural environment with the beautiful graphics and sounds. \n\nUsing your virtual reality glasses, you can see the animals moving closely with animations. It will be an exciting journey for you. \n\nYou don't need to go to a zoo to see the animals. Your children will also enjoy the virtual simulations as if they are in a zoo and know the names of many animals. Elephant, Lion, Lioness, Zebra, Crocodile, Hippopotamus, Rhinoceros, Chicken, Cow, Goat, Pig, Sheep, Bear, Boar, Fox, Rabbit, Stag, Wolf, Crow and more.\n\nHow to play\nIt is very easy. You should look at where you want to move. When you approach to animals, your movements will be slower or stop so that you will have time to examine them closely. You can use touchpad to go forward, back, left and right.\n\nFeatures\n- Very beautiful graphics. Realistic forest environment\n- Nice animated animals in Zoo\n- Natural sounds of animals", "short_description": "Zoo Park was developed for you to see the animals on their natural environment with the beautiful graphics and sounds."}]}, "developer_name": null, "developer_privacy_policy_url": "http://provr.net/privacy2.html", "developer_terms_of_service_url": "http://provr.net/privacy2.html", "publisher_name": "HASoft", "support_website_url": null, "website_url": "https://www.facebook.com/HASoft-Mobile-GamesApplications-680466725426771", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE", "EDUCATIONAL", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD", "GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "662532501863457"}, "review_messages": [
gJVzlb-bQIuZDwV0pcR3Tp0bwA&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSK50kCx8srx2gFF7IwtWeF60jzsfxlXEr7uFfQQuX75A&oe=6AEC8C06"}, {"file_name": "migrated_image.png", "id": "208088447206320", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/11162716_476745332724218_1676433208595447808_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w0OrR1kRJ8kQ7kNvwFhADLN&_nc_oc=AdqIUhO2mrcTc67m2hyCNzt2ydjQ9QJ5-CYesT0Dq2PEU7odi6XdRklhLb5h8JjAjNA&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQvGRUI7VMsNsg8kTPjfBa2Zg8DFIOl7xv98N94eiYyAg&oe=6AECAC16"}, {"file_name": "migrated_image.png", "id": "290138991968813", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/11162690_510656702601736_3434315365243420672_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y7pkR1VHuGgQ7kNvwHy8t3-&_nc_oc=AdrnRCurC0JFjceYzw32pdjH9_6e_YxdKx9tfo7qj4eweIPV-YSPUltqsDrlvlXodQI&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSHIx2DTEtDgSzl6vgh60Zr74l_QtAeVwP3yp0DUHt5jQ&oe=6AEC9F1A"}, {"file_name": "migrated_image.png", "id": "2526122730961072", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/11162700_286111548569698_6750775844337090560_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RW0RaQRGfXoQ7kNvwHCwB0H&_nc_oc=AdpRFZAjIXeaD9kUTX7nId9b56NQg61Ori_9ZFTyGt1aKIVqhP7gHRV9QNKg0OVD8Xc&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR2QkNS38SW_LvUcXvh6ap6U7LNRxn4MnU10eRr8vBhKw&oe=6AEC8CE5"}, {"file_name": "migrated_image.png", "id": "526738798265020", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/11162682_179116105994090_8275689972598571008_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n0nHDmnlZokQ7kNvwHSF9XI&_nc_oc=AdqR0P7bmM72UhQBxJOLp4WHyofXsCv6KCRxMhPZ43q1cKJVqpHq5W838Hk3i4ZyHKA&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT7W6KfVWzfN8M54o0Ay2-DCh7NErTQtats-UH77wLChA&oe=6AEC939D"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Zoo Park", "keywords": ["animals", "zoo", "park", "forest", "nature"], "long_description": "Zoo Park was developed for you to see the animals on their natural environment with the beautiful graphics and sounds. \n\nUsing your virtual reality glasses, you can see the animals moving closely with animations. It will be an exciting journey for you. \n\nYou don't need to go to a zoo to see the animals. Your children will also enjoy the virtual simulations as if they are in a zoo and know the names of many animals. Elephant, Lion, Lioness, Zebra, Crocodile, Hippopotamus, Rhinoceros, Chicken, Cow, Goat, Pig, Sheep, Bear, Boar, Fox, Rabbit, Stag, Wolf, Crow and more.\n\nHow to play\nIt is very easy. You should look at where you want to move. When you approach to animals, your movements will be slower or stop so that you will have time to examine them closely. You can use touchpad to go forward, back, left and right.\n\nFeatures\n- Very beautiful graphics. Realistic forest environment\n- Nice animated animals in Zoo\n- Natural sounds of animals", "short_description": "Zoo Park was developed for you to see the animals on their natural environment with the beautiful graphics and sounds."}]}, "developer_name": null, "developer_privacy_policy_url": "http://provr.net/privacy2.html", "developer_terms_of_service_url": "http://provr.net/privacy2.html", "publisher_name": "HASoft", "support_website_url": null, "website_url": "https://www.facebook.com/HASoft-Mobile-GamesApplications-680466725426771", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE", "EDUCATIONAL", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD", "GEAR_VR_CONTROLLE
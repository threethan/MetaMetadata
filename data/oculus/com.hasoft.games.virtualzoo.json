c_dfS3s3cano5M27ptVaQkSkcA&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQImLG4vPH7axIrOKpLoB57L9s2al0WHqzceUEyn6n9X1A&oe=6ABE6786"}, {"file_name": "migrated_image.png", "id": "208088447206320", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/11162716_476745332724218_1676433208595447808_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rR2bJICIvj0Q7kNvwFy274B&_nc_oc=Adr-JZrsUyzK9LI10cG0U5ZO0nglgvycXxyBu4IOWV_2ytuDbW5Vbsb7-mZlhVUDI_0&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ9_QmI3BtA6QOdWrSsnjIVD86EZw9lL4yxQkaojeMOog&oe=6ABE8796"}, {"file_name": "migrated_image.png", "id": "290138991968813", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/11162690_510656702601736_3434315365243420672_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RRf5pKoIXFoQ7kNvwHzUplh&_nc_oc=AdpYG4NkfcUCNJ6aJKTVrTYRJan-IVDBENXOvF4NibwFw1eCWoVACLnzB_RZagpejv4&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJHOzm3sXfD9NSsRKEWih2ZezYCS7mBVJ3zCjxswEPRMA&oe=6ABE7A9A"}, {"file_name": "migrated_image.png", "id": "2526122730961072", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/11162700_286111548569698_6750775844337090560_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eoXoeABjywQQ7kNvwE45OpC&_nc_oc=Adra9FKjGlHBEXpZeV8ziYgnVpnwBOqRePOek3AjX976OcHGvjsgtPVF1th9GHyXnPg&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK-Rj41gi0aspy7PkX0SqMe3iOg1k88JP9O88qvkwqV7g&oe=6ABE6865"}, {"file_name": "migrated_image.png", "id": "526738798265020", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/11162682_179116105994090_8275689972598571008_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iawfISh6jgoQ7kNvwGgmACT&_nc_oc=Adr_YjWBsR7KuDqoTPDAy1lJ6laiq7fLSWDZolJ2m6GPinFDd4pvZT2cfdSM_4QkwF0&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLs9ZzzIE8xpnSWHV--3VFVoIPbYOZqZrwK9I-1-uOOnQ&oe=6ABE6F1D"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Zoo Park", "keywords": ["animals", "zoo", "park", "forest", "nature"], "long_description": "Zoo Park was developed for you to see the animals on their natural environment with the beautiful graphics and sounds. \n\nUsing your virtual reality glasses, you can see the animals moving closely with animations. It will be an exciting journey for you. \n\nYou don't need to go to a zoo to see the animals. Your children will also enjoy the virtual simulations as if they are in a zoo and know the names of many animals. Elephant, Lion, Lioness, Zebra, Crocodile, Hippopotamus, Rhinoceros, Chicken, Cow, Goat, Pig, Sheep, Bear, Boar, Fox, Rabbit, Stag, Wolf, Crow and more.\n\nHow to play\nIt is very easy. You should look at where you want to move. When you approach to animals, your movements will be slower or stop so that you will have time to examine them closely. You can use touchpad to go forward, back, left and right.\n\nFeatures\n- Very beautiful graphics. Realistic forest environment\n- Nice animated animals in Zoo\n- Natural sounds of animals", "short_description": "Zoo Park was developed for you to see the animals on their natural environment with the beautiful graphics and sounds."}]}, "developer_name": null, "developer_privacy_policy_url": "http://provr.net/privacy2.html", "developer_terms_of_service_url": "http://provr.net/privacy2.html", "publisher_name": "HASoft", "support_website_url": null, "website_url": "https://www.facebook.com/HASoft-Mobile-GamesApplications-680466725426771", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE", "EDUCATIONAL", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD", "GEAR_VR_CONTROLLE
bwcWkSid4iJLaxx1R3aOPkCwpKwmxf41cQ&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-A9p-hjUTCi3f1QoGZkd1vlt7u_vS9m4X1B1nKmCCWSg&oe=6A22D686"}, {"file_name": "migrated_image.png", "id": "208088447206320", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/11162716_476745332724218_1676433208595447808_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=41DijxQc9QAQ7kNvwH2jJs4&_nc_oc=Adpn5-YEChL6__hq34DKUDPqrsugWH4IzMPpdHXZNPjgGgv9heJmcKcGH6-fxzAxfAQ&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9Vdj4XlBal39-coZgAzUwhTERPUBnQRCcxk7vrIBNdRA&oe=6A22F696"}, {"file_name": "migrated_image.png", "id": "290138991968813", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/11162690_510656702601736_3434315365243420672_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=csli5RnhniAQ7kNvwEq3Qtc&_nc_oc=Adr2OJN2I3_l-3jS-eI37FlZzvK4DWLhdQZcYq4w1RrKnmyhKDMPC6F2xngoCpWKfUc&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9Qgit0KPjnggqHhMKDJnyvEHNORI929koEQ4H5n13vhg&oe=6A22E99A"}, {"file_name": "migrated_image.png", "id": "2526122730961072", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/11162700_286111548569698_6750775844337090560_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kRfoZpxWkYsQ7kNvwG3wOCH&_nc_oc=AdriBsRe4W51Itgvy93kaqhLIwKbbLl-Icu1tfLod5QjvoRBtxoExsQiwMtrvlnGOjY&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9h6bXZJxgigPYTEAnIAyhnKiud7yZT0oyFRVJY9DrV4Q&oe=6A22D765"}, {"file_name": "migrated_image.png", "id": "526738798265020", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/11162682_179116105994090_8275689972598571008_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y7vrfLarME8Q7kNvwEQFCFG&_nc_oc=AdrOaECSqw1OuGr_2psEb5HBPJUOnPNpUZKJsTF2q34eDHXLT_41Q098y733cZoWIds&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8ZinYcHeIuMFS9Ufoil9pHA-a5uyP_xcMwPAHSMUJ-fw&oe=6A22DE1D"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Zoo Park", "keywords": ["animals", "zoo", "park", "forest", "nature"], "long_description": "Zoo Park was developed for you to see the animals on their natural environment with the beautiful graphics and sounds. \n\nUsing your virtual reality glasses, you can see the animals moving closely with animations. It will be an exciting journey for you. \n\nYou don't need to go to a zoo to see the animals. Your children will also enjoy the virtual simulations as if they are in a zoo and know the names of many animals. Elephant, Lion, Lioness, Zebra, Crocodile, Hippopotamus, Rhinoceros, Chicken, Cow, Goat, Pig, Sheep, Bear, Boar, Fox, Rabbit, Stag, Wolf, Crow and more.\n\nHow to play\nIt is very easy. You should look at where you want to move. When you approach to animals, your movements will be slower or stop so that you will have time to examine them closely. You can use touchpad to go forward, back, left and right.\n\nFeatures\n- Very beautiful graphics. Realistic forest environment\n- Nice animated animals in Zoo\n- Natural sounds of animals", "short_description": "Zoo Park was developed for you to see the animals on their natural environment with the beautiful graphics and sounds."}]}, "developer_name": null, "developer_privacy_policy_url": "http://provr.net/privacy2.html", "developer_terms_of_service_url": "http://provr.net/privacy2.html", "publisher_name": "HASoft", "support_website_url": null, "website_url": "https://www.facebook.com/HASoft-Mobile-GamesApplications-680466725426771", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE", "EDUCATIONAL", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD", "GEAR_
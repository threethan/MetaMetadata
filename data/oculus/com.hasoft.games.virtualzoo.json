o7ZQlboEA1jFGSpCwPi5xdTfS4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAx7gIQi_sgid8Q5Z8QxnQP3NLna5OfQ03MBISu8xPo2g&oe=6A491206"}, {"file_name": "migrated_image.png", "id": "208088447206320", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/11162716_476745332724218_1676433208595447808_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Cv6kgcSOCRwQ7kNvwGnuAEf&_nc_oc=AdrXxmbCBGCBTEPExC1LfloJvxZxh_9xdTV1KyVp8fvY0rRSo-WxblRRAHink04oSIs&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDSVRDl4jOGVN841kLfVeZ0mGY0rPNPJGTLqapmDKhmaA&oe=6A493216"}, {"file_name": "migrated_image.png", "id": "290138991968813", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/11162690_510656702601736_3434315365243420672_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DrGFhlWftO4Q7kNvwFEvf0r&_nc_oc=AdrvylJOIYnd32S1oQab00T19PUH0G0YkrTSUFMyUnstoa3Ft0oj9yLoaM-_ZbkQWYM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC3mdEpqr5fUC0IuvQ6aYVSIbCOJux_eEELzzqOO4R6FA&oe=6A49251A"}, {"file_name": "migrated_image.png", "id": "2526122730961072", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/11162700_286111548569698_6750775844337090560_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hQX00_m5RRgQ7kNvwFuuQ7p&_nc_oc=AdpSip5AGFnB-ivsyTZLoceH5mRCppEsuDvupxzUM1QoLs57Zg4CvEYsgw28jFM9Ed4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAIRC-KNYlCI2-UbGuR0d3qVKaNHoKe44TPu8CUXht7zQ&oe=6A4912E5"}, {"file_name": "migrated_image.png", "id": "526738798265020", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/11162682_179116105994090_8275689972598571008_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uFs6qs0pMu8Q7kNvwEBPhSS&_nc_oc=Adopqp2bzSRuSM-3yLK3cBqL2yeuLaL95wHybwyVJD_QqUgXU_yEtD9bQbG9K_uWyxg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB9ZFTizTqtodmhFyKJuL68lcU7wRhnyeUDG3KFvHPj-g&oe=6A49199D"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Zoo Park", "keywords": ["animals", "zoo", "park", "forest", "nature"], "long_description": "Zoo Park was developed for you to see the animals on their natural environment with the beautiful graphics and sounds. \n\nUsing your virtual reality glasses, you can see the animals moving closely with animations. It will be an exciting journey for you. \n\nYou don't need to go to a zoo to see the animals. Your children will also enjoy the virtual simulations as if they are in a zoo and know the names of many animals. Elephant, Lion, Lioness, Zebra, Crocodile, Hippopotamus, Rhinoceros, Chicken, Cow, Goat, Pig, Sheep, Bear, Boar, Fox, Rabbit, Stag, Wolf, Crow and more.\n\nHow to play\nIt is very easy. You should look at where you want to move. When you approach to animals, your movements will be slower or stop so that you will have time to examine them closely. You can use touchpad to go forward, back, left and right.\n\nFeatures\n- Very beautiful graphics. Realistic forest environment\n- Nice animated animals in Zoo\n- Natural sounds of animals", "short_description": "Zoo Park was developed for you to see the animals on their natural environment with the beautiful graphics and sounds."}]}, "developer_name": null, "developer_privacy_policy_url": "http://provr.net/privacy2.html", "developer_terms_of_service_url": "http://provr.net/privacy2.html", "publisher_name": "HASoft", "support_website_url": null, "website_url": "https://www.facebook.com/HASoft-Mobile-GamesApplications-680466725426771", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE", "EDUCATIONAL", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD", "GEAR_VR_CONTROLLE
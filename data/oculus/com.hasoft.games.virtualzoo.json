AyBGkTmEXP0PYs6H2ldjdB9w8o&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP3LvIUEarZ30LMOHtf1HkxU4xBfvyCmGIyP_PdEyBQkA&oe=6ADCBA06"}, {"file_name": "migrated_image.png", "id": "208088447206320", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/11162716_476745332724218_1676433208595447808_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GJ9LtR8XjQQQ7kNvwFZWf1c&_nc_oc=AdrmpLsc7Gu3Jk1Mr9b-wXSidq1d0Rj3zNR5XM8Z6Py1jcEcJyqoP5YYmB0Q3C9aqyw&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPW7I4Q8AuvCT-uWzc3Zpva8cfPe6Ch7P6qsnC5I02PAQ&oe=6ADCDA16"}, {"file_name": "migrated_image.png", "id": "290138991968813", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/11162690_510656702601736_3434315365243420672_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9zPhgBR0VlAQ7kNvwGLj4Vr&_nc_oc=AdpyLURaZbd_hZIdpodWB8xSNTqOb-zXFD5iSIZf8sqB0X2gJGx96HvOYsLuiWYFT30&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNXYBnlHwnAmAJcPVwVdMeZhGrwNroDJQomnlwex63epA&oe=6ADCCD1A"}, {"file_name": "migrated_image.png", "id": "2526122730961072", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/11162700_286111548569698_6750775844337090560_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EmKl591FU1MQ7kNvwFoiFdI&_nc_oc=Adp_zqudUOJLZl82nJk1u0ETGgZzsTCBMrtnoDhyBcFIW2mLz5LxdF6dN5FSJLr9qN4&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOdGVKU1wdDkz8i6uV0_LIYzJFdbSajnCj5dUtLvMjgUQ&oe=6ADCBAE5"}, {"file_name": "migrated_image.png", "id": "526738798265020", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/11162682_179116105994090_8275689972598571008_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B5DbzppnBYoQ7kNvwGUjhU9&_nc_oc=Adr4rXvsF9TnPFW6F1Tiv3_UFTFyRobUGEwzxnqHHKm2P66viDUYjM57kAk1c6qe45M&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNNCzFcnC9i-141pjIRA1sYmjZgP8CHh9Ioh1DPZ3xEJQ&oe=6ADCC19D"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Zoo Park", "keywords": ["animals", "zoo", "park", "forest", "nature"], "long_description": "Zoo Park was developed for you to see the animals on their natural environment with the beautiful graphics and sounds. \n\nUsing your virtual reality glasses, you can see the animals moving closely with animations. It will be an exciting journey for you. \n\nYou don't need to go to a zoo to see the animals. Your children will also enjoy the virtual simulations as if they are in a zoo and know the names of many animals. Elephant, Lion, Lioness, Zebra, Crocodile, Hippopotamus, Rhinoceros, Chicken, Cow, Goat, Pig, Sheep, Bear, Boar, Fox, Rabbit, Stag, Wolf, Crow and more.\n\nHow to play\nIt is very easy. You should look at where you want to move. When you approach to animals, your movements will be slower or stop so that you will have time to examine them closely. You can use touchpad to go forward, back, left and right.\n\nFeatures\n- Very beautiful graphics. Realistic forest environment\n- Nice animated animals in Zoo\n- Natural sounds of animals", "short_description": "Zoo Park was developed for you to see the animals on their natural environment with the beautiful graphics and sounds."}]}, "developer_name": null, "developer_privacy_policy_url": "http://provr.net/privacy2.html", "developer_terms_of_service_url": "http://provr.net/privacy2.html", "publisher_name": "HASoft", "support_website_url": null, "website_url": "https://www.facebook.com/HASoft-Mobile-GamesApplications-680466725426771", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE", "EDUCATIONAL", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD", "GEAR_VR_CONTROLLE
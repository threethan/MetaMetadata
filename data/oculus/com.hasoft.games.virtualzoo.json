2C31SuEszNx1Vn6pVELhZVMsK4XdjQHNtg&oe=69F0BD86"}, {"file_name": "migrated_image.png", "id": "208088447206320", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/11162716_476745332724218_1676433208595447808_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0u2olXQKZTAQ7kNvwHOP0M8&_nc_oc=AdrGEU78BtvqcqZv6QQlUp0qpFitV4jo9cSbm9PVnV2KLaxkOFTgdo_FTG3YUSxDwv4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Af2yp11QWKW158NDutDFPFOYrd9nkSZ05zeqP7E58GsGeg&oe=69F0A556"}, {"file_name": "migrated_image.png", "id": "290138991968813", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/11162690_510656702601736_3434315365243420672_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o42ADLpZUFcQ7kNvwGM3XxO&_nc_oc=Ado0fOzUp4OjwABybETaUy94Ci3n-4VIoFMHxlW2uU6C2YfRXyTg5xC21atgw4PUxz0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Af025IcCwbbUsNsaaGLyoZzBBg_Qnfj1S-N_XDVZZ4WogA&oe=69F0D09A"}, {"file_name": "migrated_image.png", "id": "2526122730961072", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/11162700_286111548569698_6750775844337090560_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=69_K55I5B04Q7kNvwHV0FDq&_nc_oc=AdoWVBi7pDJdGQS5r_0TnF4w-Sj1mBx8yWWxIugLg62vH4Q1w5JMCGSJ-ghIPy8VyKY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af3pHwUl3DtM-dzvdzJM4sG3g8P0U2XKKp2BD4u8ckD_bg&oe=69F0BE65"}, {"file_name": "migrated_image.png", "id": "526738798265020", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/11162682_179116105994090_8275689972598571008_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ofYZcesEnOMQ7kNvwEJ1Ha9&_nc_oc=Adqy5diaxeteNsuvU3VJ1Gddqa67JlQiRGad7M5k6TDfPWaSPlM77Q5uN-8eH9qCsJQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Af2aSIcIbUREGTWh3by8HOfCZaeDim9xzXN8UzOOwRJEjw&oe=69F0C51D"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Zoo Park", "keywords": ["animals", "zoo", "park", "forest", "nature"], "long_description": "Zoo Park was developed for you to see the animals on their natural environment with the beautiful graphics and sounds. \n\nUsing your virtual reality glasses, you can see the animals moving closely with animations. It will be an exciting journey for you. \n\nYou don't need to go to a zoo to see the animals. Your children will also enjoy the virtual simulations as if they are in a zoo and know the names of many animals. Elephant, Lion, Lioness, Zebra, Crocodile, Hippopotamus, Rhinoceros, Chicken, Cow, Goat, Pig, Sheep, Bear, Boar, Fox, Rabbit, Stag, Wolf, Crow and more.\n\nHow to play\nIt is very easy. You should look at where you want to move. When you approach to animals, your movements will be slower or stop so that you will have time to examine them closely. You can use touchpad to go forward, back, left and right.\n\nFeatures\n- Very beautiful graphics. Realistic forest environment\n- Nice animated animals in Zoo\n- Natural sounds of animals", "short_description": "Zoo Park was developed for you to see the animals on their natural environment with the beautiful graphics and sounds."}]}, "developer_name": null, "developer_privacy_policy_url": "http://provr.net/privacy2.html", "developer_terms_of_service_url": "http://provr.net/privacy2.html", "publisher_name": "HASoft", "support_website_url": null, "website_url": "https://www.facebook.com/HASoft-Mobile-GamesApplications-680466725426771", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE", "EDUCATIONAL", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD", "GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "662532501863457"}, "review_messages": [
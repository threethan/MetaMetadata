yHs3VcwElGXma0p1yXolOF6w2w&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwZGjWCYYyUSLsHP3bEVmhJ7S7E4mhBFZqsxo3WPLd3Fw&oe=69CA8206"}, {"file_name": "migrated_image.png", "id": "208088447206320", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/11162716_476745332724218_1676433208595447808_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NqTPIHbfKiUQ7kNvwEbmvNA&_nc_oc=Adol7Nw-UGNPnyhmJ8qYE26enmt1t7vpiO8R1SS6tLJzIk2Mn_fNf06CX8xvvzz11NI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyFxC8e0G9HTxT0Ul9TdXkHVJteFb5gjQKPl1khPspJew&oe=69CA69D6"}, {"file_name": "migrated_image.png", "id": "290138991968813", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/11162690_510656702601736_3434315365243420672_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ChYZ4bDJwAEQ7kNvwEd3QkU&_nc_oc=AdqecLvmLvN8PJPhHjVU391KhGHfqzHHgPYp4hsCqMKCQaIfqnKzD_z0kc7o6-ApnFE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afynr5y5y7Swtmm28Kt8CcSjmqoM-x-k1Y5erWZRP-xSoA&oe=69CA5CDA"}, {"file_name": "migrated_image.png", "id": "2526122730961072", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/11162700_286111548569698_6750775844337090560_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nvcfuawG0egQ7kNvwG-SydN&_nc_oc=Adq6PHN0Av84SD5woxS0w3WI9_KgxbrU9AXV_od9UPPo6_72cwZiu8siSmHtDsp5dyM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzI19mSDjkjWqbdQJP-Jr_xTcDlZSl18KbMNqedeEunxQ&oe=69CA82E5"}, {"file_name": "migrated_image.png", "id": "526738798265020", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/11162682_179116105994090_8275689972598571008_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=itIvoy-gl0MQ7kNvwHoi-Dw&_nc_oc=AdrvzpMJ4ZJRTeNusjzq1F8Cu0T7TiYSKzb5WGd2QC4EG2F1b7HBgG_bDiuFC7zvE9M&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxJOdpkvq_J63bDA2DYqUp-pOLQm1oXGBf-Kp6csSb_Fw&oe=69CA899D"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Zoo Park", "keywords": ["animals", "zoo", "park", "forest", "nature"], "long_description": "Zoo Park was developed for you to see the animals on their natural environment with the beautiful graphics and sounds. \n\nUsing your virtual reality glasses, you can see the animals moving closely with animations. It will be an exciting journey for you. \n\nYou don't need to go to a zoo to see the animals. Your children will also enjoy the virtual simulations as if they are in a zoo and know the names of many animals. Elephant, Lion, Lioness, Zebra, Crocodile, Hippopotamus, Rhinoceros, Chicken, Cow, Goat, Pig, Sheep, Bear, Boar, Fox, Rabbit, Stag, Wolf, Crow and more.\n\nHow to play\nIt is very easy. You should look at where you want to move. When you approach to animals, your movements will be slower or stop so that you will have time to examine them closely. You can use touchpad to go forward, back, left and right.\n\nFeatures\n- Very beautiful graphics. Realistic forest environment\n- Nice animated animals in Zoo\n- Natural sounds of animals", "short_description": "Zoo Park was developed for you to see the animals on their natural environment with the beautiful graphics and sounds."}]}, "developer_name": null, "developer_privacy_policy_url": "http://provr.net/privacy2.html", "developer_terms_of_service_url": "http://provr.net/privacy2.html", "publisher_name": "HASoft", "support_website_url": null, "website_url": "https://www.facebook.com/HASoft-Mobile-GamesApplications-680466725426771", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE", "EDUCATIONAL", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD", "GEAR_VR_CONTROLLE
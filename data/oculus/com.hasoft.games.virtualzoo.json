nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_Afzovs6RI4e7CW8MHhFe_ydMZPjGHQ5D6Q8RDq1H_jEsSg&oe=69BFF606"}, {"file_name": "migrated_image.png", "id": "208088447206320", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/11162716_476745332724218_1676433208595447808_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BKvcmQXOLAAQ7kNvwEE9rJs&_nc_oc=AdmCrKaTgcsSkXw2pIpUsDxSAXBjjaR5NtW0MHxotOx0jLT6mIxXzoNhWmgFBIriwrI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfyLREOtGS1nEbSmi3mec25R_II697i9xqbn1OtBJU8Eog&oe=69BFDDD6"}, {"file_name": "migrated_image.png", "id": "290138991968813", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/11162690_510656702601736_3434315365243420672_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JAwBlMoBioIQ7kNvwHAI0r3&_nc_oc=AdmH14gy8UXNvjs_rcarvyyBqS0IId7EoLCKxO6uA7XNZHgjoLJ1ac0uGzrLa-2Hnj0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfwNVmsatz08VTgUBoEYRb2vtzKHACvCeMENeFfb5Yipfw&oe=69BFD0DA"}, {"file_name": "migrated_image.png", "id": "2526122730961072", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/11162700_286111548569698_6750775844337090560_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1YicQ93FuQgQ7kNvwEcQLt3&_nc_oc=AdmXz3liLpuKGd9sFw4TIBxIn0hVF6YKr1R_xKRDLnjQvygkTq-6pANmGKyfpehFQdU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfykgZJJXm-KhMhsUwCuhrGwxmu20ME7raHH_fjm-hSYkg&oe=69BFF6E5"}, {"file_name": "migrated_image.png", "id": "526738798265020", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/11162682_179116105994090_8275689972598571008_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=92bRJ8IR_IoQ7kNvwEhhRHl&_nc_oc=AdnaPabwaIqYbEgEwFyzBuE_vAdz-qc6tYiH9hVZ-Jw0s6xvMz2vt4skoG0ES_tCHLs&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfyX8QoAhD3rcCmQ7xTrjTOsLWF2iMCqOGftdIPcp_YKwA&oe=69BFFD9D"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Zoo Park", "keywords": ["animals", "zoo", "park", "forest", "nature"], "long_description": "Zoo Park was developed for you to see the animals on their natural environment with the beautiful graphics and sounds. \n\nUsing your virtual reality glasses, you can see the animals moving closely with animations. It will be an exciting journey for you. \n\nYou don't need to go to a zoo to see the animals. Your children will also enjoy the virtual simulations as if they are in a zoo and know the names of many animals. Elephant, Lion, Lioness, Zebra, Crocodile, Hippopotamus, Rhinoceros, Chicken, Cow, Goat, Pig, Sheep, Bear, Boar, Fox, Rabbit, Stag, Wolf, Crow and more.\n\nHow to play\nIt is very easy. You should look at where you want to move. When you approach to animals, your movements will be slower or stop so that you will have time to examine them closely. You can use touchpad to go forward, back, left and right.\n\nFeatures\n- Very beautiful graphics. Realistic forest environment\n- Nice animated animals in Zoo\n- Natural sounds of animals", "short_description": "Zoo Park was developed for you to see the animals on their natural environment with the beautiful graphics and sounds."}]}, "developer_name": null, "developer_privacy_policy_url": "http://provr.net/privacy2.html", "developer_terms_of_service_url": "http://provr.net/privacy2.html", "publisher_name": "HASoft", "support_website_url": null, "website_url": "https://www.facebook.com/HASoft-Mobile-GamesApplications-680466725426771", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE", "EDUCATIONAL", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD", "GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tr
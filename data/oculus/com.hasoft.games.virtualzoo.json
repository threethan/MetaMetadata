3B0gocdqY18IWRZi-fW-TQX9Jg&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4MeWQ6njkdG_lOqQnI-k2Nejcd4z8gJI_HmYuvEGP0RA&oe=6A1D9086"}, {"file_name": "migrated_image.png", "id": "208088447206320", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/11162716_476745332724218_1676433208595447808_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uYaDl3rWJ9MQ7kNvwEBDPXd&_nc_oc=AdrwNJMNEOQWonKaIMFxTG7RrBSdiJu_e9aoDzp4cMC3iJ6ZCNwJ_UFsFm5fVkP0p8M&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af64MFFlyESzMF_5BFLb4O6TV1t4tGAEq-tMfjNcQ1vEZA&oe=6A1D7856"}, {"file_name": "migrated_image.png", "id": "290138991968813", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/11162690_510656702601736_3434315365243420672_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NbRY0gDA2yUQ7kNvwHLRcEV&_nc_oc=Adr8CLFHkfgV3DHRZP4qUAhvTUK4B5xYOm2tDl87Ak0rfwpwNVZl51ppJuBRDVCg69A&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af77uQjf-x_8MzD870kLCB75vxZyR3Huicb6noqFPz9MVA&oe=6A1DA39A"}, {"file_name": "migrated_image.png", "id": "2526122730961072", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/11162700_286111548569698_6750775844337090560_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=69s_tQzBtFgQ7kNvwGiuaap&_nc_oc=AdrPkrx6ugcFDilac1_uBajfZ86JZrNqpQm0-yvHABClkhhWk8iCcgsFo2kjAQWGuQo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6RdMX3JSgg80oU8r04kVAsBirnyul9nb_Au5RgjaHfQA&oe=6A1D9165"}, {"file_name": "migrated_image.png", "id": "526738798265020", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/11162682_179116105994090_8275689972598571008_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2m1oe1uZzzsQ7kNvwFAhbMJ&_nc_oc=AdqpCWR0sncIQHmK7kNvHyWLLCqoVuJVPW5di7wK-bNmxowkD4NETWRDJnJAtSeDeAI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4Qoo99XvkX1UsvDDxAllZYVhfMxUqH80WnBxBf_TTpEg&oe=6A1D981D"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Zoo Park", "keywords": ["animals", "zoo", "park", "forest", "nature"], "long_description": "Zoo Park was developed for you to see the animals on their natural environment with the beautiful graphics and sounds. \n\nUsing your virtual reality glasses, you can see the animals moving closely with animations. It will be an exciting journey for you. \n\nYou don't need to go to a zoo to see the animals. Your children will also enjoy the virtual simulations as if they are in a zoo and know the names of many animals. Elephant, Lion, Lioness, Zebra, Crocodile, Hippopotamus, Rhinoceros, Chicken, Cow, Goat, Pig, Sheep, Bear, Boar, Fox, Rabbit, Stag, Wolf, Crow and more.\n\nHow to play\nIt is very easy. You should look at where you want to move. When you approach to animals, your movements will be slower or stop so that you will have time to examine them closely. You can use touchpad to go forward, back, left and right.\n\nFeatures\n- Very beautiful graphics. Realistic forest environment\n- Nice animated animals in Zoo\n- Natural sounds of animals", "short_description": "Zoo Park was developed for you to see the animals on their natural environment with the beautiful graphics and sounds."}]}, "developer_name": null, "developer_privacy_policy_url": "http://provr.net/privacy2.html", "developer_terms_of_service_url": "http://provr.net/privacy2.html", "publisher_name": "HASoft", "support_website_url": null, "website_url": "https://www.facebook.com/HASoft-Mobile-GamesApplications-680466725426771", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE", "EDUCATIONAL", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD", "GEAR_VR_CONTROLLE
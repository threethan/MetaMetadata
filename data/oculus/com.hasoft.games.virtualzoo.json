eJTseqVu4E51MHbEKfx9QeCzJM&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAqKEW8Lkt6XlVLvNfDjxDioyRnJaAouml4Tu17K0IpTg&oe=6A661306"}, {"file_name": "migrated_image.png", "id": "208088447206320", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/11162716_476745332724218_1676433208595447808_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iZ0msuwdOu0Q7kNvwF8FPAT&_nc_oc=AdqjbqO7j2bBJASDmbKoXqLSplcKDQEntW5-vAAHNhtyKMMBDYZQ5J64HDCg-V4lCn4&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDjZ609SmBON6VIBxlJwlEWwNctEDO8u_w8U8XFao_JvQ&oe=6A65FAD6"}, {"file_name": "migrated_image.png", "id": "290138991968813", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/11162690_510656702601736_3434315365243420672_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f0mxpY38I-EQ7kNvwFYMfUH&_nc_oc=AdoFhrKoSNykKg8RkONDizX7trFIRoTd5XYXBkD5rCNM1ZpEkC5sOxwD9tWxsgJKzE8&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDvpDM3g1ZsQ5YNKb6lHEju6tRLU0PxTZalZ5tEbGeTtA&oe=6A66261A"}, {"file_name": "migrated_image.png", "id": "2526122730961072", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/11162700_286111548569698_6750775844337090560_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OnA_4Sl8u8MQ7kNvwEau_7x&_nc_oc=AdqrLbI08K4e1_g_ysY59Dif9V2QcmJYO1V1deVP8r84Y9WClvN7JeCnAX5LKSpeZBQ&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCk9ig3OIrFOxlBVUCUaorTSW1c6kjC0NB-JWArfgLH4A&oe=6A6613E5"}, {"file_name": "migrated_image.png", "id": "526738798265020", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/11162682_179116105994090_8275689972598571008_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cjxh4DbYMSsQ7kNvwFID9ro&_nc_oc=AdrxEW7lLWeoYlPKQpvq9zKZQDa85zsoWYQKRJBj8RGp_Ow3PUFJI0wJcZz8wAKjKTM&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBst7bnj6Hbm8Wu-AQqXDGIkkXn9Z0bZ8W7KAaiCSZcLA&oe=6A661A9D"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Zoo Park", "keywords": ["animals", "zoo", "park", "forest", "nature"], "long_description": "Zoo Park was developed for you to see the animals on their natural environment with the beautiful graphics and sounds. \n\nUsing your virtual reality glasses, you can see the animals moving closely with animations. It will be an exciting journey for you. \n\nYou don't need to go to a zoo to see the animals. Your children will also enjoy the virtual simulations as if they are in a zoo and know the names of many animals. Elephant, Lion, Lioness, Zebra, Crocodile, Hippopotamus, Rhinoceros, Chicken, Cow, Goat, Pig, Sheep, Bear, Boar, Fox, Rabbit, Stag, Wolf, Crow and more.\n\nHow to play\nIt is very easy. You should look at where you want to move. When you approach to animals, your movements will be slower or stop so that you will have time to examine them closely. You can use touchpad to go forward, back, left and right.\n\nFeatures\n- Very beautiful graphics. Realistic forest environment\n- Nice animated animals in Zoo\n- Natural sounds of animals", "short_description": "Zoo Park was developed for you to see the animals on their natural environment with the beautiful graphics and sounds."}]}, "developer_name": null, "developer_privacy_policy_url": "http://provr.net/privacy2.html", "developer_terms_of_service_url": "http://provr.net/privacy2.html", "publisher_name": "HASoft", "support_website_url": null, "website_url": "https://www.facebook.com/HASoft-Mobile-GamesApplications-680466725426771", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE", "EDUCATIONAL", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD", "GEAR_VR_CONTROLLE
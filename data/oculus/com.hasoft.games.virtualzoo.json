_xFWasFm1dWcOsgNkVSCbLzrM4&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBXfC6CoSBjYCc1RhAAqmW53dasEcMMai0UYmm3T8Fw0A&oe=6A564106"}, {"file_name": "migrated_image.png", "id": "208088447206320", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/11162716_476745332724218_1676433208595447808_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a4zA9VNTztMQ7kNvwECL5Mw&_nc_oc=Adpu0rg6j8BLWrxZOWUpF6EG_aiTEs9I6leSCPedoXIIwW7U_8Ns93InEHredyIRUTs&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCs8DlxdGJipQp2PFh2a1D0DkXIMek7RWxSp-mqg9IR2w&oe=6A5628D6"}, {"file_name": "migrated_image.png", "id": "290138991968813", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/11162690_510656702601736_3434315365243420672_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e1JxMKk8MKQQ7kNvwHDH9pz&_nc_oc=Adp3pU3g0vf8akXkYDQFi-U_HhrTA7yHczffQdcB1KulZZ8jgpfmkMw-iMJE9xYYCmc&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBGJI-CG3wTSp8W-MVHR2edyDFQbWaEhRkIiQoiCU2oYg&oe=6A56541A"}, {"file_name": "migrated_image.png", "id": "2526122730961072", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/11162700_286111548569698_6750775844337090560_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oVsmtkdTVfAQ7kNvwEDX-iQ&_nc_oc=AdpLN8KwbgIVoTlclfaMGCXayodFGEVp6l-Y90eW7LwAtyP4JxCFmpVLiyx0AuWd1Ts&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDTn6brbhkKxYbmvCKj5kz5fmn2M4souDiONiMUcFsFfw&oe=6A5641E5"}, {"file_name": "migrated_image.png", "id": "526738798265020", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/11162682_179116105994090_8275689972598571008_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CU1LP61VZAYQ7kNvwGd_g3a&_nc_oc=AdpbgUDpAvFSRdK45G0KWmLOh86FWwoTINsW8jB5DXQpKr8EX8J9mv-b-NXyndk50YA&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCyd12AvaC3E_K2_pUSTgtB9X3qpmh0emU3rhdiTSPsng&oe=6A56489D"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Zoo Park", "keywords": ["animals", "zoo", "park", "forest", "nature"], "long_description": "Zoo Park was developed for you to see the animals on their natural environment with the beautiful graphics and sounds. \n\nUsing your virtual reality glasses, you can see the animals moving closely with animations. It will be an exciting journey for you. \n\nYou don't need to go to a zoo to see the animals. Your children will also enjoy the virtual simulations as if they are in a zoo and know the names of many animals. Elephant, Lion, Lioness, Zebra, Crocodile, Hippopotamus, Rhinoceros, Chicken, Cow, Goat, Pig, Sheep, Bear, Boar, Fox, Rabbit, Stag, Wolf, Crow and more.\n\nHow to play\nIt is very easy. You should look at where you want to move. When you approach to animals, your movements will be slower or stop so that you will have time to examine them closely. You can use touchpad to go forward, back, left and right.\n\nFeatures\n- Very beautiful graphics. Realistic forest environment\n- Nice animated animals in Zoo\n- Natural sounds of animals", "short_description": "Zoo Park was developed for you to see the animals on their natural environment with the beautiful graphics and sounds."}]}, "developer_name": null, "developer_privacy_policy_url": "http://provr.net/privacy2.html", "developer_terms_of_service_url": "http://provr.net/privacy2.html", "publisher_name": "HASoft", "support_website_url": null, "website_url": "https://www.facebook.com/HASoft-Mobile-GamesApplications-680466725426771", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE", "EDUCATIONAL", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD", "GEAR_VR_CONTROLLE
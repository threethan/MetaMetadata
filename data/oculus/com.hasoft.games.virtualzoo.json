SffoCRCoWA1dHFyoGKsu1ewnBM&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHKpoXggvE4ylRFQAoPaXj05qLlGKEW0Svq2rgntopXnQ&oe=6A81C286"}, {"file_name": "migrated_image.png", "id": "208088447206320", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/11162716_476745332724218_1676433208595447808_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-YxD-qHaaA0Q7kNvwHLjFmz&_nc_oc=AdoNUSfpgvDqY28jLBo4j_B1H1bROFBPSKCsl1lE9OrZf4IDRVcwNgcYRKWYx1COKoA&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGBfvGPkYwiMNvZT-7ewEfi4l1RYp0kS5vzG_6kS-ONfw&oe=6A81AA56"}, {"file_name": "migrated_image.png", "id": "290138991968813", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/11162690_510656702601736_3434315365243420672_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ig282aJTg44Q7kNvwHMmMoT&_nc_oc=AdqTPI399pvzmReb7psq8JLI6amztUCZjMDX-SAe6CETRNj5Bx7SyE-8HyRPm670YT8&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFtLsDInOytoUWtKd3M4qikpFVDiziKm9WN7vENHlGOFQ&oe=6A819D5A"}, {"file_name": "migrated_image.png", "id": "2526122730961072", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/11162700_286111548569698_6750775844337090560_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cwmSqezDl-sQ7kNvwGy2PYb&_nc_oc=AdqGRNdvdm7G5cAqUGra22CwuC0Kfb1HZ9hKBXfiAsa3Btd_HAie2PE2gpo4KZUJr14&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFS66FwnBKmHKGAGBf05ITb87jwxpjZkkGUTRSKLYWK_g&oe=6A81C365"}, {"file_name": "migrated_image.png", "id": "526738798265020", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/11162682_179116105994090_8275689972598571008_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eZia9yZKK4kQ7kNvwFPV5R6&_nc_oc=Ado0zb7LwCi3ceCrtinzcWQZS_C_9LlOaib0lBNueR7DwVGINvWVRUu800016adcVjA&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFNCzFVCHHa5H_1-tT6x_1si6S0f5NiqMWK4AnhNs1Zew&oe=6A8191DD"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Zoo Park", "keywords": ["animals", "zoo", "park", "forest", "nature"], "long_description": "Zoo Park was developed for you to see the animals on their natural environment with the beautiful graphics and sounds. \n\nUsing your virtual reality glasses, you can see the animals moving closely with animations. It will be an exciting journey for you. \n\nYou don't need to go to a zoo to see the animals. Your children will also enjoy the virtual simulations as if they are in a zoo and know the names of many animals. Elephant, Lion, Lioness, Zebra, Crocodile, Hippopotamus, Rhinoceros, Chicken, Cow, Goat, Pig, Sheep, Bear, Boar, Fox, Rabbit, Stag, Wolf, Crow and more.\n\nHow to play\nIt is very easy. You should look at where you want to move. When you approach to animals, your movements will be slower or stop so that you will have time to examine them closely. You can use touchpad to go forward, back, left and right.\n\nFeatures\n- Very beautiful graphics. Realistic forest environment\n- Nice animated animals in Zoo\n- Natural sounds of animals", "short_description": "Zoo Park was developed for you to see the animals on their natural environment with the beautiful graphics and sounds."}]}, "developer_name": null, "developer_privacy_policy_url": "http://provr.net/privacy2.html", "developer_terms_of_service_url": "http://provr.net/privacy2.html", "publisher_name": "HASoft", "support_website_url": null, "website_url": "https://www.facebook.com/HASoft-Mobile-GamesApplications-680466725426771", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE", "EDUCATIONAL", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD", "GEAR_VR_CONTROLLE
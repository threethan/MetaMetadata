supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "9567193440033235"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1693431441563137"}]}, "baseline_offer": {"id": "1693431441563137"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1757601060, "status": "PUBLISHED", "id": "1693431441563137"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "27735570329435602", "version": "6.6.8"}, "id": "1035305641058942", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "6795516673867606", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "27735570329435602"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1035305641058942"}]}, "change_log": "Version 6.6.8 (Build 309)\n\nIn this update, we are bringing exciting new ways to win and improving your overall Pokeroo experience:\n\n\nNew Daily Bonus Slot Machine: Claim your free chips every day with our brand-new interactive slot machine, featuring a convenient countdown timer so you always know exactly when your next spin is ready.\nPerformance Enhancements: We have applied various under-the-hood optimizations and general stability improvements to ensure your time at the tables is smoother and more reliable than ever.\nLooking Ahead: With this update complete, our team is now 100% laser-focused on finalizing our highly anticipated Multi-Table Tournaments (MTT). Get ready for the ultimate competitive experience!", "created_date": 1785750074, "id": "27735570329435602", "version": "6.6.8", "version_code": 309, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": {"id": "27735565399436095"}, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "6795516673867606", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "27735570329435602"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": []}, "change_log": null, "created_date": 1785330279, "id": "27679822848343684", "version": "6.6.8", "version_code": 308, "release_status": "PENDING", "status": "DRAFT", "binary_test_results": {"nodes": []}, "obb_binary": {"id": "27679817065010929"}, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "6795516673867606", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "27735570329435602"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": []}, "change_log": null, "created_date": 1785304057, "id": "27676277742031528", "version": "6.6.8", "version_code": 307, "release_status": "PENDING", "status": "DRAFT", "binary_test_results": {"nodes": []}, "obb_binary": {"id": "27676273098698659"}, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "6795516673867606", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "27735570329435602"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1035305641058942"}]}, "change_log": "# Pokeroo Release Notes \u2014 Version 6.6.8 (Build 306)\n\nWe are thrilled to bring you the latest major update for Pokeroo! While many of the improvements in this version happen under the hood, these foundational updates are vital for delivering the smooth, responsive, and polished social poker experience you have been eagerly awaiting.\n\n### What\u2019s New & Improved in This Build:\n\n* Comprehensive Infrastructure Audit & Service: We conducted a full, rigorous audit of the entire game infrastructure and thoroughly cleaned out legacy code to optimize overall system health and performance.\n* VR & Cross-Platform Stability: We have implemented crucial architectural fixes to dramatically improve stability across all supported platforms (Meta VR, Android, and iOS).\n* Optimized Performance & Bug Squashing: This build resolves persistent issues regarding player avatar positioning, seating sync, and background data flow. These fixes lay the groundwork for faster performance and smoother gameplay sessions.\n* Faster Future Updates: By streamlining our core systems and clearing out legacy technical debt, our development team is now equipped to squash bugs and roll out exciting upcoming features\u2014including our daily bonus machine and tournaments, which will follow shortly\u2014much faster than ever before.\n\nThank you for being part of our community and playing Pokeroo! Stay tuned as we continue to expand the experience.", "created_date": 1784721275, "id": "27598631806462789", "version": "6.6.8", "version_code": 306, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": {"id": "27598626763129960"}, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "6795516673867606", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "27735570329435602"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": []}, "change_log": null, "created_date": 1784553254, "id": "27575210012138302", "version": "6.6.8", "version_code": 305, "release_status": "PENDING", "status": "DRAFT", "binary_test_results": {"nodes": []}, "obb_binary": {"id": "27575204102138893"}, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}]}}, "viewer": {"user": null}}}
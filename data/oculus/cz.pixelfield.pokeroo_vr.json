6B0C6579"}, {"file_name": "Store 4.png", "id": "1760588761666890", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499312369_1760588765000223_5198054771904601874_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_aid=0&_nc_ohc=oFHYLNGnY3oQ7kNvwH8XhOO&_nc_oc=AdqUjIgEkUFdC2AVcCD1EjHKvQ6oIoXaX7pjjXfy1a8w_6BUolvnz729rSPml6lt4iw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSr7jvg61MTXP6gg4qJfGEwXBh9zyo62IH6T1-0-iuqqQ&oe=6B0C4F9F"}, {"file_name": "Store 5.png", "id": "1852044615812025", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/753032404_1852044619145358_8974330215113304002_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SpeXdpnJ6KMQ7kNvwH5PhSh&_nc_oc=Adp8iXZERygD8Vzhd90ZeBB3Jz-2k4KY86LJznMOzG9kpaIo8vOj7RppQ36hYV3ceOI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSP1kIctTgGGji-Ks7xtKHAnGOIOsT0HWjp0wbiOWfMvQ&oe=6B0C4B8D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Meta Vid.png", "id": "1544372353213123", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499314648_1544372356546456_8386597391256218242_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GnE_7RlxebQQ7kNvwH89ymS&_nc_oc=AdrKrUCZZ4NApFxK-QltjEcxlHhWbhG_khpXmtFeHVEqXNTr1q0Sjo2ToxQFuBWEtQY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRJKBI_WGb98PxhN3hznKUkCJs17cNsgZI3twUQFlbBNQ&oe=6B0C54F5"}, "display_name": "Pokeroo Global", "keywords": [], "long_description": "Welcome to Pokeroo Global, the ultimate VR poker adventure!\n\nStep into an immersive 3D social casino built for virtual reality. Put on your headset, physically stand at the tables with your true-to-life 3D avatar, and experience highly detailed, real-world casino environments right from your living room.\n\nLIVE OPEN-MIC COMMUNITY\nPoker is social! Our built-in open mic connects you instantly. Talk, laugh, read bluffs, and use VR hand gestures to interact naturally with friends from around the world.\n\nMASSIVE MTT TOURNAMENTS\nThe wait is over! Battle through massive Multi-Table Tournaments at our 6-player tables. All mechanics (including blind structures and table balancing) strictly follow official Poker Tournament Directors Association (TDA) rules for a true professional experience.\n\n100% FAIR & TRULY RANDOM\nOur card dealing uses the industry-standard Fisher-Yates shuffle algorithm to guarantee a truly random, provably fair deck every single hand.\n\nTRAVEL, LEVEL UP & COMPETE\nExplore exotic poker rooms globally. Log achievements in your interactive Passport, earn trophies to raise your levels, and climb the global leaderboards to build your poker legacy.\n\nDAILY FREE BONUS\nClaim your daily free bonus spin at the terminal to fuel your next flight.\n\nCROSS-PLATFORM PLAY\nEnjoy seamless matchmaking with a massive global community, whether they are in VR, or playing on PC and mobile.\n\nTerms of Service \n https://pokerooglobal.com/terms-%26-conditions", "short_description": "Step into the ultimate VR social poker adventure! Physically stand at the tables with your 3D avatar, talk with friends using the live open mic, and use natural hand gestures. Check in at the terminal to travel the globe, play massive Multi-Table Tournaments (MTTs), and grind cash games. Earn trophies to raise your levels and dominate the global leaderboards in a 100% fair, truly random Texas Hold'em experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.pokerooglobal.com/privacy-policy", "developer_terms_of_service_url": "https://www.pokerooglobal.com/terms-%26-conditions", "publisher_name": "Amigo Moos Sociedad Anonima", "support_website_url": null, "website_url": "https://www.pokerooglobal.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1676485315806614"}, {"id": "102
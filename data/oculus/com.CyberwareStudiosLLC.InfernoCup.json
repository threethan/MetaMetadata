etition.\nInferno Cup puts you at the helm of a dragon from your chosen clan, giving you the chance to harness the power of fire or frost, train your skills, and conquer the opposing team to win!\nAre you ready to become the ultimate champion?\nCome forth dragon rider, your destiny beckons!", "short_description": "Take part in Inferno Cup, the ultimate live action dragon riding sport competition. \nSoar through the skies on the back of majestic dragons to compete for glory.\n\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://infernocupvr.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Cyberware Studios", "support_website_url": null, "website_url": "https://infernocupvr.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "7159653840816982"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/39001707_180952038398548_5163857428327332396_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=glMPRS7qCNgQ7kNvwFFV8ze&_nc_oc=Adr2fXpYcI7Pc1HGR6kNIYJD3Q3QwJgL5VdcZSDorBy9jBV07dui_sr-xH1SgadpF28&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4I13_C6Q8hVgUHtu6t9TaCEXAaLoK10b5cxN6xQLITXQ&oe=6A1AE505"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Inferno Cup (Demo)", "platform": "ANDROID_6DO
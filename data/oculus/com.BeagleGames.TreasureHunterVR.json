4_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6NO5hvkmptYQ7kNvwG7nXa-&_nc_oc=AdpY3oft-0SjyeUzlwGnX1KRor-hdCpEdwfscwuNagw7g--3N8s11ctRE7bHUCoSBAY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKlTZ24KGoXDVY316V3IW3LwGIhWmRMIWd1MWTaRT5Xew&oe=6AB3E58C"}, {"file_name": "migrated_image.png", "id": "227586865025628", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/11162704_1440534279364325_3553473486204698624_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o__YokVtH8gQ7kNvwFOkJxS&_nc_oc=Adob5Xn1pSVtKbtsQMBua9uwGKa3cxQr7F2nOlhpTw0fu2AAF7yjYB8dgNgZzjv2hAw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ1-ZQ6xx-Mw6c-7SE8IUHurrgvYOrG0QUsKzP_mWnoyg&oe=6AB3C822"}, {"file_name": "migrated_image.png", "id": "223793988733980", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/11162684_1918532331768953_3442552378077741056_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VWPZkSvSlYsQ7kNvwFJBrst&_nc_oc=AdoTeSZgDCf6ane8mD9U4hmBLkXIS713giTv5RuJ5R5M989P2TyfRjjFmoBd4l9n_w8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI8l7MUt8b63_c7r2ZhdPHTeanaudqgjL4ZRZU0RpEtXQ&oe=6AB3E14A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Treasure Hunter VR", "keywords": ["puzzle", "arcade", "egypt", "light", "adventure"], "long_description": "Plunge into  the atmosphere of ancient Egypt. Help young Jane  explore lost in the sands ancient temple, full of crafty traps  and find all the hidden treasures of the Pharaoh.\n \nTreasure Hunter VR -This is an atmospheric spatial puzzle based on the physics of light. The game was designed for a long immersive experience in virtual reality. We set ourselves the task to create not only unique mechanics of the game, but also to extend the average player session in VR.\n \n\n- 12 unique levels\n- Immersive atmospheric experience\n- Detailed Ancient Egyptian temple\n- Interesting puzzles\n- Comfort control created specifically for Gear VR", "short_descr
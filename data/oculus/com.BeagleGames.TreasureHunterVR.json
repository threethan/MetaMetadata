4_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qlp4SOr8tSMQ7kNvwF_ljT0&_nc_oc=AdrYDnIupvP4ochNF-bxbHUxjF6ck7KQEk-ai_kEGLTiQc68r2mBnXeRfhMDkd-c0WI&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3puq8-RXqlmZMTNWHaOoe4omfCtH4U3uL-2sL_CejfrA&oe=69D90C8C"}, {"file_name": "migrated_image.png", "id": "227586865025628", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/11162704_1440534279364325_3553473486204698624_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vfkYgzt6NsgQ7kNvwHb8uFe&_nc_oc=Adqb-J8V8Z87Xv8EQFtYOXGMup-tZmPsEB2YRETPVv4ybX8pX3lhwt4AguB9rIuj2Qg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2kKby-SE_0mmLfoZHrjEPKXlKsAWAy2_mAIO2ftM8svA&oe=69D8EF22"}, {"file_name": "migrated_image.png", "id": "223793988733980", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/11162684_1918532331768953_3442552378077741056_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GuElFTe_uYQQ7kNvwH-J9Ig&_nc_oc=AdpfUvwnqd0l0ogD8TKz1b7uQafm-dSIFnO_Za2jVH5zb5SqcU-OD3wVA9ywUOVixhk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3cg-1S9iXR4DH4nz2DGUwnvLFFxOfs1qZjZ3udswuTDA&oe=69D9084A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Treasure Hunter VR", "keywords": ["puzzle", "arcade", "egypt", "light", "adventure"], "long_description": "Plunge into  the atmosphere of ancient Egypt. Help young Jane  explore lost in the sands ancient temple, full of crafty traps  and find all the hidden treasures of the Pharaoh.\n \nTreasure Hunter VR -This is an atmospheric spatial puzzle based on the physics of light. The game was designed for a long immersive experience in virtual reality. We set ourselves the task to create not only unique mechanics of the game, but also to extend the average player session in VR.\n \n\n- 12 unique levels\n- Immersive atmospheric experience\n- Detailed Ancient Egyptian temple\n- Interesting puzzles\n- Comfort control created specifically for Gear VR", "short_descr
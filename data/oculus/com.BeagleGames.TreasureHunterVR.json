4_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sNc9I4ZFr1YQ7kNvwH-Qux_&_nc_oc=AdpW3nrFmrfLzmM6v3slgXG5srY6yTUL42GnlFO_5QI4qvBLdLncXzM_O4NQFAAXMPw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNNmPuKA65fi8oJGJoNlofbJYIwbiqCDae_GjdT1nC3-w&oe=6AE4AD0C"}, {"file_name": "migrated_image.png", "id": "227586865025628", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/11162704_1440534279364325_3553473486204698624_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nTcg3ze0qYQQ7kNvwHU2YKo&_nc_oc=AdrSbgrIUSVH8EPx7rODn67KHgRjS2tWCmv4kpy30nkB-DlBpUfb7pHEWfo_2IHIfUM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPRcq6QF6Em1LzOMgIEQ9ritQi7xdZGPs0sdp8QAD-jYw&oe=6AE48FA2"}, {"file_name": "migrated_image.png", "id": "223793988733980", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/11162684_1918532331768953_3442552378077741056_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7v_bH9fadEMQ7kNvwGWrsqT&_nc_oc=AdrBkR9xZi55dhPri0C0EMak8gd8Dkc5y5eeWwxixZKZxDH_jPAq0c5t_feVaYfw4Kw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO0H8EexJgYFcuQ_5h8K7WYakGyo0ff5OSEV49XvEN98A&oe=6AE4A8CA"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Treasure Hunter VR", "keywords": ["puzzle", "arcade", "egypt", "light", "adventure"], "long_description": "Plunge into  the atmosphere of ancient Egypt. Help young Jane  explore lost in the sands ancient temple, full of crafty traps  and find all the hidden treasures of the Pharaoh.\n \nTreasure Hunter VR -This is an atmospheric spatial puzzle based on the physics of light. The game was designed for a long immersive experience in virtual reality. We set ourselves the task to create not only unique mechanics of the game, but also to extend the average player session in VR.\n \n\n- 12 unique levels\n- Immersive atmospheric experience\n- Detailed Ancient Egyptian temple\n- Interesting puzzles\n- Comfort control created specifically for Gear VR", "short_descr
4_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6BhvtLv6Nm4Q7kNvwFiIYm8&_nc_oc=AdqnMofPq-cgFQhkqSnwinkQlwKiD1fHN4XilW9sk2uPI4lDZjco__eiMg_O0-QFln0&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKT-9DXIiqt4EToECiVWz5Vic5OXEGGJla1Ab33pPI3Tg&oe=6ABD200C"}, {"file_name": "migrated_image.png", "id": "227586865025628", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/11162704_1440534279364325_3553473486204698624_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L8SK0DNUZ8MQ7kNvwFr3Sps&_nc_oc=AdralF4dQRG2lxeONREgHLRSD43EIm_2uwrEePkxJKWp25N2qTFMVun0aplqnmo16rk&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKmEvD6ZN3kgb_i9mQCydbw6VVwc0oxqk7jx4a6oRsujA&oe=6ABD02A2"}, {"file_name": "migrated_image.png", "id": "223793988733980", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/11162684_1918532331768953_3442552378077741056_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bzrZtjqMMCwQ7kNvwGnUkSy&_nc_oc=Adqd9fxcJU0K7xGwTfhZEojMvhHkRRgKztT4haOC-Dx5V9G0eBGwXmndxsgOx-gS7Gk&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJTW408pJdsNiIAxoe-m3vrSu434tsp4ipctuepSczxsA&oe=6ABD1BCA"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Treasure Hunter VR", "keywords": ["puzzle", "arcade", "egypt", "light", "adventure"], "long_description": "Plunge into  the atmosphere of ancient Egypt. Help young Jane  explore lost in the sands ancient temple, full of crafty traps  and find all the hidden treasures of the Pharaoh.\n \nTreasure Hunter VR -This is an atmospheric spatial puzzle based on the physics of light. The game was designed for a long immersive experience in virtual reality. We set ourselves the task to create not only unique mechanics of the game, but also to extend the average player session in VR.\n \n\n- 12 unique levels\n- Immersive atmospheric experience\n- Detailed Ancient Egyptian temple\n- Interesting puzzles\n- Comfort control created specifically for Gear VR", "short_descr
f&oh=00_AQTaDcfP1KnPdAssvk4RgE7LnpUIFURlzsBxQDWuVSZZWQ&oe=6AFF18E5"}, {"file_name": "migrated_image.png", "id": "519359865390619", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/11162693_178342762711392_7188359649463107584_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2y3MNLu-4zAQ7kNvwENwN-1&_nc_oc=Ado5Avd6jCqrqgffnZkfoGqLuhmsM6TSaupbt5t3nWY8iKwB617DXdYklkd2wITWtHg&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS5KRY-IDRF0xa7_7qFtVyS9OpkUiXUBx4ClS63bi0UDA&oe=6AFF0B0C"}, {"file_name": "migrated_image.png", "id": "227586865025628", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/11162704_1440534279364325_3553473486204698624_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=agdlV1dU5FwQ7kNvwGBj2b-&_nc_oc=AdqSFPj8v2cHw1wvCzfYd0WgH79oVfvJDHKYCe_n2E7Kxm0UaTcOz5ECBF2P766JS6k&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ96uQH6KXl-DlUri-29eFAL5fQmgnloGCfGvNiX7gi8Q&oe=6AFF25E2"}, {"file_name": "migrated_image.png", "id": "223793988733980", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/11162684_1918532331768953_3442552378077741056_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UT4n2heEqqAQ7kNvwG9_Idj&_nc_oc=AdpCvs2vgAEVTQ1hLBdMGRufsXD7bxaIs5dZntVsS2bIQ5B93iID0YLgv_lRW1wmAP4&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQqG4VgT2pTJqk0G6NWPRfUjzQw2RsYF9ihdBDmw1NoRw&oe=6AFF06CA"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Treasure Hunter VR", "keywords": ["puzzle", "arcade", "egypt", "light", "adventure"], "long_description": "Plunge into  the atmosphere of ancient Egypt. Help young Jane  explore lost in the sands ancient temple, full of crafty traps  and find all the hidden treasures of the Pharaoh.\n \nTreasure Hunter VR -This is an atmospheric spatial puzzle based on the physics of light. The game was designed for a long immersive experience in virtual reality. We set ourselves the task to create not only unique mechanics of the game, but also to extend the average player session in VR.\n \n\n- 12 unique levels\n- Immersive atmospheric experience\n- Detailed Ancient Egyptian temple\n- Interesting puzzles\n- Comfort control created specifically for Gear VR", "short_description": "Plunge into  the atmosphere of ancient Egypt. Help young Jane  explore lost in the sands ancient temple, full of crafty traps  and find all the hidden treasures of the Pharaoh."}]}, "developer_name": null, "developer_privacy_policy_url": "http://beaglegames.com/privacy-policy/", "developer_terms_of_service_url": "http://beaglegames.com/privacy-policy/", "publisher_name": "Beagle Games", "support_website_url": null, "website_url": "http://beaglegames.com/games/treasurehuntervr/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ADVENTURE", "CASUAL", "EDUCATIONAL", "PUZZLE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "628128321824755"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/11162698_1885979984988832_6272463104861274112_n.png?stp=dst-png_s360x360&_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jUBytstlaagQ7kNvwEcyJ4t&_nc_oc=AdosiDgsL-eZP5S09sbxkhpjCTPxAgytKy56sN19Uq80LNsWx7xQrd-eIIshNy-BYV4&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTMTq0aXsDIP6rMlweFvABl8gqYY3tlauWsAGDkCTEDZw&oe=6AFF1A1A"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Treasure Hunter VR", "platform
4_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lpC8oVv5gIQQ7kNvwFwQu7Z&_nc_oc=AdoACyZgxsS24eVr44ENoEGg3Z0r58bVqcuYLMbxgGZtmITRuaZJzFeXiHbUFXtjz9A&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3-Cqt5QlgYza1gEFXdXxo32iJwVS56JS3MCZwTYh74-g&oe=69E63B8C"}, {"file_name": "migrated_image.png", "id": "227586865025628", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/11162704_1440534279364325_3553473486204698624_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KRPgST9U8DkQ7kNvwF45TOU&_nc_oc=Ado8__iA7IJlJLB6Sjx4jKYC8pMqGvjqw3LdTAGDjpcMyKB8HS1nvK3jxa5aS5zqLuk&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0u47fRYht-PJ5q_3koN-1nYTRibkxEZbEkrwR3SiIFZQ&oe=69E61E22"}, {"file_name": "migrated_image.png", "id": "223793988733980", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/11162684_1918532331768953_3442552378077741056_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4uZQ4z6fQ2cQ7kNvwF9XXXY&_nc_oc=Adp5myzuHguOBeKBQa9uOjDpORilwivvEoBuLhwcc17yX9Ck23zGmcM4AVCMem_aH9s&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1crktoBr0efhfQfh0UL3zp8bHbDi1k4Oi0k7vKl-mrwg&oe=69E6374A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Treasure Hunter VR", "keywords": ["puzzle", "arcade", "egypt", "light", "adventure"], "long_description": "Plunge into  the atmosphere of ancient Egypt. Help young Jane  explore lost in the sands ancient temple, full of crafty traps  and find all the hidden treasures of the Pharaoh.\n \nTreasure Hunter VR -This is an atmospheric spatial puzzle based on the physics of light. The game was designed for a long immersive experience in virtual reality. We set ourselves the task to create not only unique mechanics of the game, but also to extend the average player session in VR.\n \n\n- 12 unique levels\n- Immersive atmospheric experience\n- Detailed Ancient Egyptian temple\n- Interesting puzzles\n- Comfort control created specifically for Gear VR", "short_descr
4_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GhyRUVKqyIIQ7kNvwHqHPtU&_nc_oc=Adq6v2ppKlMIe0V2zllH-ufVfZyYWLGcZQsYSlYQK3acXp-n4Sal0msxZWUU7kiKyAc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7VH4Ws9lB6gcHT2mlUJKa23UpCcR_7MIEpfgM1CAiH3A&oe=6A00998C"}, {"file_name": "migrated_image.png", "id": "227586865025628", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/11162704_1440534279364325_3553473486204698624_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jtB0XwDGzmcQ7kNvwEhjPYt&_nc_oc=Adri6wmGRybwsi2FJx6-vzBJvYdOCMR6J71JfmY9is4UDWY3xrAabVbu4Od8Ynmz-DU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5xjId_w83S6il0ysf_kFJCXDA9idR1d8vFubRQXDuw9A&oe=6A007C22"}, {"file_name": "migrated_image.png", "id": "223793988733980", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/11162684_1918532331768953_3442552378077741056_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Nuts56WSvckQ7kNvwHajBBU&_nc_oc=Adrx-SQPmzh3ILxeW9Sk9SHMnebDP0YG-2uyBZc5DynkF5WA69DMhoPkozoGGQl70Ws&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4g6iF-NC66cjNAh_omnrTQ05K8QnI4dKQ2CyAQtGftmw&oe=6A00954A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Treasure Hunter VR", "keywords": ["puzzle", "arcade", "egypt", "light", "adventure"], "long_description": "Plunge into  the atmosphere of ancient Egypt. Help young Jane  explore lost in the sands ancient temple, full of crafty traps  and find all the hidden treasures of the Pharaoh.\n \nTreasure Hunter VR -This is an atmospheric spatial puzzle based on the physics of light. The game was designed for a long immersive experience in virtual reality. We set ourselves the task to create not only unique mechanics of the game, but also to extend the average player session in VR.\n \n\n- 12 unique levels\n- Immersive atmospheric experience\n- Detailed Ancient Egyptian temple\n- Interesting puzzles\n- Comfort control created specifically for Gear VR", "short_descr
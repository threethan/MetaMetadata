4_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9jNO6Spy-roQ7kNvwE_mIyC&_nc_oc=AdrSdHnRCPPDUGOkZ3U7PVE4LUy7k-ClbLl7NdfQygjmjYz9GlH1KJQ8iTMew6tZtXE&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOFWOx20QOIY9ABx0tbHBZRTRN26_W1P32-aanRujYXbQ&oe=6ADE158C"}, {"file_name": "migrated_image.png", "id": "227586865025628", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/11162704_1440534279364325_3553473486204698624_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wy5VQwop68UQ7kNvwG8N1y-&_nc_oc=Adr3wDRPBwBOVAqsAX-SVIR2T3JvJT8ClCsg1I2k59bM1lzktArZESRiS2riEuUX-DA&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMyoVPY-syq5eEwa9BkP0ayQNZFuR8I5B8Rcz7Hqb6P1Q&oe=6ADDF822"}, {"file_name": "migrated_image.png", "id": "223793988733980", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/11162684_1918532331768953_3442552378077741056_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zdC6nAuWYcsQ7kNvwGI78iK&_nc_oc=AdrukPDOFL-GRnzbE7IPehYShvMbVllW2-kwqLL5SUWpnDJaATpYnBHxeRKWYm2enso&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN3Qz2sKw7m058anJZ_d9TePT0tAIF1euHwEcJilZgkzw&oe=6ADE114A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Treasure Hunter VR", "keywords": ["puzzle", "arcade", "egypt", "light", "adventure"], "long_description": "Plunge into  the atmosphere of ancient Egypt. Help young Jane  explore lost in the sands ancient temple, full of crafty traps  and find all the hidden treasures of the Pharaoh.\n \nTreasure Hunter VR -This is an atmospheric spatial puzzle based on the physics of light. The game was designed for a long immersive experience in virtual reality. We set ourselves the task to create not only unique mechanics of the game, but also to extend the average player session in VR.\n \n\n- 12 unique levels\n- Immersive atmospheric experience\n- Detailed Ancient Egyptian temple\n- Interesting puzzles\n- Comfort control created specifically for Gear VR", "short_descr
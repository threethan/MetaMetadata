4_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h6NgqH2wG7IQ7kNvwHnBeGp&_nc_oc=Ado5jdxNVhQ0GguuvElYjoEeQ9CziAMT6ReRhW7H0hAwCXNVVMZYa8dtJY8Ee63GECk&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8Q0hPKhbXS8NE05pgOiqiAIj2YOZf3sHrvE6401Qp_Cg&oe=6A45278C"}, {"file_name": "migrated_image.png", "id": "227586865025628", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/11162704_1440534279364325_3553473486204698624_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b_iyXDlIT6AQ7kNvwFjmYun&_nc_oc=AdpSTMe3QvE5sglMSZq0bkHm22ZmuNPj9VTnFoKfWf01JHqnstSGDW45amJofdUZPxc&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_zJmr2ljZ59jPakMjAc3rG3n90ClOL9bCHYOkIdGBHSw&oe=6A450A22"}, {"file_name": "migrated_image.png", "id": "223793988733980", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/11162684_1918532331768953_3442552378077741056_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DSgppF94-qgQ7kNvwHVKQqP&_nc_oc=AdqOMLl-dbVXc7rBjuWv14i3oM6AjSFKQDH41kCKny0boRRYrkBl4962WhVzTKeX-R8&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8BDTQF18XYoM6Vws801ETqajiKutMeEm2onxvL9ZZ_8A&oe=6A45234A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Treasure Hunter VR", "keywords": ["puzzle", "arcade", "egypt", "light", "adventure"], "long_description": "Plunge into  the atmosphere of ancient Egypt. Help young Jane  explore lost in the sands ancient temple, full of crafty traps  and find all the hidden treasures of the Pharaoh.\n \nTreasure Hunter VR -This is an atmospheric spatial puzzle based on the physics of light. The game was designed for a long immersive experience in virtual reality. We set ourselves the task to create not only unique mechanics of the game, but also to extend the average player session in VR.\n \n\n- 12 unique levels\n- Immersive atmospheric experience\n- Detailed Ancient Egyptian temple\n- Interesting puzzles\n- Comfort control created specifically for Gear VR", "short_descr
4_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KlnXrFUsyQQQ7kNvwGTSzwM&_nc_oc=AdoU_Sr3wOYAFhBdyEPYNdc-kgDpFU8iUKhrG9nLNT4lDnrr8p3gHugTtxu6UoP7sEI&_nc_zt=3&_nc_ht=scontent-lhr8-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2DbVlQKxSMnRCyO63-wVIwEIxlWXY14dV9c0LdhJc2pg&oe=69E2470C"}, {"file_name": "migrated_image.png", "id": "227586865025628", "uri": "https://scontent-lhr8-2.oculuscdn.com/v/t64.5771-25/11162704_1440534279364325_3553473486204698624_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5qusc66lZGUQ7kNvwF6BEFc&_nc_oc=AdrOBYghiBISVmEwlhxSbjebg8kGBaG1qT3BlbRsoIXN3-q11QledzumSWRQYV2cnQE&_nc_zt=3&_nc_ht=scontent-lhr8-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0YVBec1sIiWiTH5IbbRSQHQK1cUMe1C9IwgwWqvsv2zg&oe=69E229A2"}, {"file_name": "migrated_image.png", "id": "223793988733980", "uri": "https://scontent-lhr8-1.oculuscdn.com/v/t64.5771-25/11162684_1918532331768953_3442552378077741056_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aGkKBZ1GB8YQ7kNvwFtmEa7&_nc_oc=AdqXtkmwgU_s1gEo3hBraqZf5P5A9GhUiKW9NWKXY2lJ76XN0DAOqwNJtpVdlYPdrjo&_nc_zt=3&_nc_ht=scontent-lhr8-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2c3ATSZzk6A5riE-y6Gs4wYG7A7p0a9wHOo_YktOuT-A&oe=69E242CA"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Treasure Hunter VR", "keywords": ["puzzle", "arcade", "egypt", "light", "adventure"], "long_description": "Plunge into  the atmosphere of ancient Egypt. Help young Jane  explore lost in the sands ancient temple, full of crafty traps  and find all the hidden treasures of the Pharaoh.\n \nTreasure Hunter VR -This is an atmospheric spatial puzzle based on the physics of light. The game was designed for a long immersive experience in virtual reality. We set ourselves the task to create not only unique mechanics of the game, but also to extend the average player session in VR.\n \n\n- 12 unique levels\n- Immersive atmospheric experience\n- Detailed Ancient Egyptian temple\n- Interesting puzzles\n- Comfort control created specifically for Gear VR", "short_descr
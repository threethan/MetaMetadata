4_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JLK3TOD_hyUQ7kNvwF8TDWq&_nc_oc=Ado9_oJOjOoZHjGQpDg1OSr-eeWQgYymMtTfG1aJOTP6BM9cLUCt4TC5ETk2xLqJEZk&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFMjHaXMbodzqCD81Hm9vXQmeUxyuoDvodeRAtGSx3q-Q&oe=6A81944C"}, {"file_name": "migrated_image.png", "id": "227586865025628", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/11162704_1440534279364325_3553473486204698624_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4sLyklRcsIkQ7kNvwGFkITM&_nc_oc=AdpqHqigsLnqvwVMapSfG1Tlo0BXmNMif-xAkZBM9ZouyAUFCVEKi5e1yhTFgOqmSLM&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFSgYGmuNIjlb5pEwflMID_VlO7Y4luvjxA7Fh5JemINA&oe=6A81AF22"}, {"file_name": "migrated_image.png", "id": "223793988733980", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/11162684_1918532331768953_3442552378077741056_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AkJzFJgysDUQ7kNvwEcQ5iV&_nc_oc=AdoMxM-a3_98jzIc-r44Q7NHZkO_DcK8gMuqWpJBJn4pa705w5ciqy2RLJis6_c01u8&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH0pYTTPpgnoK8hRzXejn41H9OqiHWfvgpMxWTQkgMm4Q&oe=6A81900A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Treasure Hunter VR", "keywords": ["puzzle", "arcade", "egypt", "light", "adventure"], "long_description": "Plunge into  the atmosphere of ancient Egypt. Help young Jane  explore lost in the sands ancient temple, full of crafty traps  and find all the hidden treasures of the Pharaoh.\n \nTreasure Hunter VR -This is an atmospheric spatial puzzle based on the physics of light. The game was designed for a long immersive experience in virtual reality. We set ourselves the task to create not only unique mechanics of the game, but also to extend the average player session in VR.\n \n\n- 12 unique levels\n- Immersive atmospheric experience\n- Detailed Ancient Egyptian temple\n- Interesting puzzles\n- Comfort control created specifically for Gear VR", "short_descr
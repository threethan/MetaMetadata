f&oh=00_AQQd6RFOds8BuIFhFwEespgVZSPh4OVulHadDncetMQw8Q&oe=6B05B065"}, {"file_name": "migrated_image.png", "id": "519359865390619", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/11162693_178342762711392_7188359649463107584_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lfATb57k5P0Q7kNvwFtQHgl&_nc_oc=AdpgKxt1acbAUbJUyswEE0R7wMY8lWWdIuukB2OAoPZjUzv4Zv8VT_6FaOEJgYm6UmY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRfdn980IjKoj6ZbojDCPvhCEEV5chhIh_mOQ8CERQABw&oe=6B05A28C"}, {"file_name": "migrated_image.png", "id": "227586865025628", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/11162704_1440534279364325_3553473486204698624_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7Z0EurZ6UPYQ7kNvwEDa4ox&_nc_oc=AdoECFYHSbJVwDOhVhGRW6xiD31wuaRdwTXGE-nzteJB5ldltEMemW5NA3yC_HQzVc8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRNkp9DW2YjPSwECKzBrVshmeb3GfGkc8I_RNk34UTAiQ&oe=6B05BD62"}, {"file_name": "migrated_image.png", "id": "223793988733980", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/11162684_1918532331768953_3442552378077741056_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-MlgxmwDPegQ7kNvwGO-BSP&_nc_oc=Ado2LI1Eiw4NOISBCviPK81EXt2I7c4xcDbaMxB7In6INyWH3AR1-SaBdq1cGDT6zYs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRiVSx1BEna4LvXmNY_TFQbGUx5-M9sjx4K27KPLWAcGA&oe=6B05D68A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Treasure Hunter VR", "keywords": ["puzzle", "arcade", "egypt", "light", "adventure"], "long_description": "Plunge into  the atmosphere of ancient Egypt. Help young Jane  explore lost in the sands ancient temple, full of crafty traps  and find all the hidden treasures of the Pharaoh.\n \nTreasure Hunter VR -This is an atmospheric spatial puzzle based on the physics of light. The game was designed for a long immersive experience in virtual reality. We set ourselves the task to create not only unique mechanics of the game, but also to extend the average player session in VR.\n \n\n- 12 unique levels\n- Immersive atmospheric experience\n- Detailed Ancient Egyptian temple\n- Interesting puzzles\n- Comfort control created specifically for Gear VR", "short_description": "Plunge into  the atmosphere of ancient Egypt. Help young Jane  explore lost in the sands ancient temple, full of crafty traps  and find all the hidden treasures of the Pharaoh."}]}, "developer_name": null, "developer_privacy_policy_url": "http://beaglegames.com/privacy-policy/", "developer_terms_of_service_url": "http://beaglegames.com/privacy-policy/", "publisher_name": "Beagle Games", "support_website_url": null, "website_url": "http://beaglegames.com/games/treasurehuntervr/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ADVENTURE", "CASUAL", "EDUCATIONAL", "PUZZLE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "628128321824755"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/11162698_1885979984988832_6272463104861274112_n.png?stp=dst-png_s360x360&_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ps4cZ7HAoeAQ7kNvwF7N-Vq&_nc_oc=AdpZomGz5vrUAdyJl7vjfZGBtWTJ5EqhFt0i1cwC3dnSgYm7Ce0pAHH1R5JEiTPVwMM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQt1-Db2xZaflxQIvpdbKeXUlr_Fjw7rjpYHEEXVLHB7g&oe=6B05B19A"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Treasure Hunter VR", "platform
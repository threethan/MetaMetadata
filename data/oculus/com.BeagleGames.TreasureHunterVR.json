4_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6i3QGlSVqoIQ7kNvwFKtShX&_nc_oc=AdrHk1IdCnj19jZgK2w03V_84mBvTGrvGO2TzvxQ3seeYamNg9eXQswTnBAI4Fl00ZE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4noy9KCKMFgYMnoHATvwP910GU9JPfzgNqtQs7fSYvmg&oe=6A1EEC0C"}, {"file_name": "migrated_image.png", "id": "227586865025628", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/11162704_1440534279364325_3553473486204698624_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hvKWbyZfK-QQ7kNvwG56wbj&_nc_oc=AdrmGv2DWeZYVBOr81vAcX2cLsj_76moNqi18HQt_kg7_jZE3h6i1MSF5TgvsqzX3JA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af59G6zxK10BKaAqu00oXkCrUwrZQS98REgU-QCs6-5XQA&oe=6A1ECEA2"}, {"file_name": "migrated_image.png", "id": "223793988733980", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/11162684_1918532331768953_3442552378077741056_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ze4uc8gsYkEQ7kNvwGlo8FG&_nc_oc=AdoLfbFgYw5RIdh2jKmjLiw3esAI9lejShGAg8Wei0ERXozU4sIYoutZDfdKVu2FiFw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4l1qXRxd0MCq2AHvH1hfxp6YQ68ZgCGuiCexjYjzXwUQ&oe=6A1EE7CA"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Treasure Hunter VR", "keywords": ["puzzle", "arcade", "egypt", "light", "adventure"], "long_description": "Plunge into  the atmosphere of ancient Egypt. Help young Jane  explore lost in the sands ancient temple, full of crafty traps  and find all the hidden treasures of the Pharaoh.\n \nTreasure Hunter VR -This is an atmospheric spatial puzzle based on the physics of light. The game was designed for a long immersive experience in virtual reality. We set ourselves the task to create not only unique mechanics of the game, but also to extend the average player session in VR.\n \n\n- 12 unique levels\n- Immersive atmospheric experience\n- Detailed Ancient Egyptian temple\n- Interesting puzzles\n- Comfort control created specifically for Gear VR", "short_descr
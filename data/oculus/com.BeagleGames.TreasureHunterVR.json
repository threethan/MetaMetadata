4_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E0XDYOcpK3gQ7kNvwEVK17y&_nc_oc=AdpJ3B8_Aja1Sds7hECJAlHUpUTvLqa8dTxEDJiOOtPw_L4EW8NJ--Sies_6kcdRAa0&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEN6YtX6j5cSYnkunGoVb2KV8HxlqPGJsptrANJof1X2g&oe=6A77408C"}, {"file_name": "migrated_image.png", "id": "227586865025628", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/11162704_1440534279364325_3553473486204698624_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8BRiUgAVV0MQ7kNvwG8fI9u&_nc_oc=Adq7_jrNKEHwid8gZl5BET8i5UJSN9iouie1DYiRBBkcfcOYuWLeymY6VS7QzAMdhHU&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHGmAJzR3Ei1PBv85Sv0_x8shA_ZDw-Bf1VdU13QW4uNA&oe=6A772322"}, {"file_name": "migrated_image.png", "id": "223793988733980", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/11162684_1918532331768953_3442552378077741056_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R27EgY9A8r0Q7kNvwEGRveF&_nc_oc=Adq1tzVCHSOuaDEoJOV0f8FOCNCEoUH5lGlQ4O0xCtaMEkqI4vfnJT5f3T-GUEDXRvg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEBquorYJWnpLNaJe5m0-rDU_pEy2HEJNe64XloAUP6MQ&oe=6A773C4A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Treasure Hunter VR", "keywords": ["puzzle", "arcade", "egypt", "light", "adventure"], "long_description": "Plunge into  the atmosphere of ancient Egypt. Help young Jane  explore lost in the sands ancient temple, full of crafty traps  and find all the hidden treasures of the Pharaoh.\n \nTreasure Hunter VR -This is an atmospheric spatial puzzle based on the physics of light. The game was designed for a long immersive experience in virtual reality. We set ourselves the task to create not only unique mechanics of the game, but also to extend the average player session in VR.\n \n\n- 12 unique levels\n- Immersive atmospheric experience\n- Detailed Ancient Egyptian temple\n- Interesting puzzles\n- Comfort control created specifically for Gear VR", "short_descr
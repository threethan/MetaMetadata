4_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6NO5hvkmptYQ7kNvwHWIcFH&_nc_oc=AdoW36k7vK3NSPl2BgyefPqVDxPl2l44EH39gO5OmiofcmD7G6q4E0WaydH-_5rXoJY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKaQOyOuvcX5mQGo75VGMzkR7h_pFzfQxRxfQ36cs8Kjw&oe=6AB5370C"}, {"file_name": "migrated_image.png", "id": "227586865025628", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/11162704_1440534279364325_3553473486204698624_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NSj5A_pX6skQ7kNvwF_zb82&_nc_oc=Adr7Vjb7nEhhNw9ylmAXH2WKNTPyZ7sEjwuKVCi77Pz0v0BDj4xydV0a5jwMmNFYi8U&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQISUfQRPg05SS1MxN3PQCnELX3MosO0w7xXRfFGJl9o6A&oe=6AB519A2"}, {"file_name": "migrated_image.png", "id": "223793988733980", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/11162684_1918532331768953_3442552378077741056_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VWPZkSvSlYsQ7kNvwE4BO8a&_nc_oc=AdrHsoxDL3bYLdT0OBJrh5fI5J5DL4F4vs8zadNB5l6vlXcq8jg7ZP4Ur1mk41jDRf0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKgp2twCc2q5PwOTbtEAPQo7hS8l9WiECJGTpVeLaM0Kw&oe=6AB532CA"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Treasure Hunter VR", "keywords": ["puzzle", "arcade", "egypt", "light", "adventure"], "long_description": "Plunge into  the atmosphere of ancient Egypt. Help young Jane  explore lost in the sands ancient temple, full of crafty traps  and find all the hidden treasures of the Pharaoh.\n \nTreasure Hunter VR -This is an atmospheric spatial puzzle based on the physics of light. The game was designed for a long immersive experience in virtual reality. We set ourselves the task to create not only unique mechanics of the game, but also to extend the average player session in VR.\n \n\n- 12 unique levels\n- Immersive atmospheric experience\n- Detailed Ancient Egyptian temple\n- Interesting puzzles\n- Comfort control created specifically for Gear VR", "short_descr
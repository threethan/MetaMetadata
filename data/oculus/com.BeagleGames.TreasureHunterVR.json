4_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8hMcwDLcPIIQ7kNvwFLs-WR&_nc_oc=AdpY9zCFEyEnsjnocnFCw__AL_KIyV3qDRSJ-FBbGyWP4LLF5Pr0sfNP7Hm3QFCikgo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOAMVfgKtAeC1PDzDNdPtF0WEPbrEvbbQTZLKsQiaBkaw&oe=6AC3B78C"}, {"file_name": "migrated_image.png", "id": "227586865025628", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/11162704_1440534279364325_3553473486204698624_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lXZJT0dRA3UQ7kNvwFiF-eS&_nc_oc=AdqhrRbvHRESbyx3Kkhx2ph7LikP1azae7XAD_ZwdBiB7Wa7nLe5hNHmFz1prm9kurk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMMrFNDBtBRJbJWwzad_dHmebRrE-h6bIhxcoKGA-Cbvw&oe=6AC3D262"}, {"file_name": "migrated_image.png", "id": "223793988733980", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/11162684_1918532331768953_3442552378077741056_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OgFgOF5zSNkQ7kNvwHW0kzQ&_nc_oc=Adr6C5LNB6cyOnM87mDw7sXINkDEzF1q2DqprmnV5O_FwEmOY2GWmMYPZqaBzspfuMw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOQde5l_Kwx-IQA09MkaA2w8282BOb1wQEbut6yungLWw&oe=6AC3B34A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Treasure Hunter VR", "keywords": ["puzzle", "arcade", "egypt", "light", "adventure"], "long_description": "Plunge into  the atmosphere of ancient Egypt. Help young Jane  explore lost in the sands ancient temple, full of crafty traps  and find all the hidden treasures of the Pharaoh.\n \nTreasure Hunter VR -This is an atmospheric spatial puzzle based on the physics of light. The game was designed for a long immersive experience in virtual reality. We set ourselves the task to create not only unique mechanics of the game, but also to extend the average player session in VR.\n \n\n- 12 unique levels\n- Immersive atmospheric experience\n- Detailed Ancient Egyptian temple\n- Interesting puzzles\n- Comfort control created specifically for Gear VR", "short_descr
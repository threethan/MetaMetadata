f&oh=00_AQRHPIHRfbYvq-f8KxNLmQQ2BctGVVeOkmj7Fo8R0vZONg&oe=6B01BBE5"}, {"file_name": "migrated_image.png", "id": "519359865390619", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/11162693_178342762711392_7188359649463107584_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2y3MNLu-4zAQ7kNvwGCvVWC&_nc_oc=AdoL8aW0d8EceNqF5sZCZ8bx0zmS3IbxY0OUeOEOZkkJWhACZO2_S1Rc2EyXVM4WkAs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTaRUetkf9hG9jyGYTEkX0Bi807QnMq5IUcDKKjHLnWjg&oe=6B01E64C"}, {"file_name": "migrated_image.png", "id": "227586865025628", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/11162704_1440534279364325_3553473486204698624_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W3n8WBgLProQ7kNvwGVSYsT&_nc_oc=AdrfdupU0li69v43OrJIZ2QaaUXjWbcRbPjUu6eZW1z9dPwSkNDSE0GS3oPb4paqnEI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRbf7nxdOu-8egcg9k9syHGa9VzEyo2kQZbmvidHc1WvA&oe=6B01C8E2"}, {"file_name": "migrated_image.png", "id": "223793988733980", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/11162684_1918532331768953_3442552378077741056_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UT4n2heEqqAQ7kNvwFl2x8P&_nc_oc=Adr1bQ4sgWkAokRDLQiqm1XKSRv3o_xM7I2puwSyWAI16d0oIuk3vvRjhrmbg3JmsDk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQsUkyjRJTaPVqCDLTwp7ZV92ipZBYaq1WyYDB8MRIlsg&oe=6B01E20A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Treasure Hunter VR", "keywords": ["puzzle", "arcade", "egypt", "light", "adventure"], "long_description": "Plunge into  the atmosphere of ancient Egypt. Help young Jane  explore lost in the sands ancient temple, full of crafty traps  and find all the hidden treasures of the Pharaoh.\n \nTreasure Hunter VR -This is an atmospheric spatial puzzle based on the physics of light. The game was designed for a long immersive experience in virtual reality. We set ourselves the task to create not only unique mechanics of the game, but also to extend the average player session in VR.\n \n\n- 12 unique levels\n- Immersive atmospheric experience\n- Detailed Ancient Egyptian temple\n- Interesting puzzles\n- Comfort control created specifically for Gear VR", "short_description": "Plunge into  the atmosphere of ancient Egypt. Help young Jane  explore lost in the sands ancient temple, full of crafty traps  and find all the hidden treasures of the Pharaoh."}]}, "developer_name": null, "developer_privacy_policy_url": "http://beaglegames.com/privacy-policy/", "developer_terms_of_service_url": "http://beaglegames.com/privacy-policy/", "publisher_name": "Beagle Games", "support_website_url": null, "website_url": "http://beaglegames.com/games/treasurehuntervr/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ADVENTURE", "CASUAL", "EDUCATIONAL", "PUZZLE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "628128321824755"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/11162698_1885979984988832_6272463104861274112_n.png?stp=dst-png_s360x360&_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Sy1hWk6_CTAQ7kNvwH7yaWk&_nc_oc=Adpri8efZD-d4CJYwy39-A4254WtPCahxCp_3VXgJf4_ZMqs80j4TpiwTnqL0sixX8M&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ8B6TJOPEX30D82NBj2ZmPdZrvtL-yhehDP53SqhxshQ&oe=6B01BD1A"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Treasure Hunter VR", "platform
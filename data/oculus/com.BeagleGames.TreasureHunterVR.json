584_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mVRjdzPP8cUQ7kNvwHyARlI&_nc_oc=AdqADTswu_g3VTm0xpYUCmYvNYu_8oVirOt73Jnax6ntHY14w92bRUN9-VgdN5teIJc&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKc5OV2CbAk2jLXg3aLwYZBu8FiDapVVrcUvlMfChdY8g&oe=6AAE9F8C"}, {"file_name": "migrated_image.png", "id": "227586865025628", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/11162704_1440534279364325_3553473486204698624_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jJEw-rUEsLIQ7kNvwEK9IQp&_nc_oc=AdrtskLapHsYJ8Uk3C2M-jV5INu8JpBEPPKb9HikqnvtK3q_w0KD_zGsO3dTREMzyIw&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLRyq7-8U0BTE7BaRwu30je24jm5S9ls5xIoIDqIsuGnQ&oe=6AAE8222"}, {"file_name": "migrated_image.png", "id": "223793988733980", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/11162684_1918532331768953_3442552378077741056_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rNqnNVRMEGMQ7kNvwElGu1n&_nc_oc=AdoXmCiUioTGkdVy0sSZd1tkG0eqoRd1QbFtu2NgzzeHWWGtzo7_6Bna3Dq86M6_5-4&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ73Mbom_f8ieuyOqS9mP0-XYSONXFSJVDIqktCQUJvFA&oe=6AAE9B4A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Treasure Hunter VR", "keywords": ["puzzle", "arcade", "egypt", "light", "adventure"], "long_description": "Plunge into  the atmosphere of ancient Egypt. Help young Jane  explore lost in the sands ancient temple, full of crafty traps  and find all the hidden treasures of the Pharaoh.\n \nTreasure Hunter VR -This is an atmospheric spatial puzzle based on the physics of light. The game was designed for a long immersive experience in virtual reality. We set ourselves the task to create not only unique mechanics of the game, but also to extend the average player session in VR.\n \n\n- 12 unique levels\n- Immersive atmospheric experience\n- Detailed Ancient Egyptian temple\n- Interesting puzzles\n- Comfort control created specifically for Gear VR", "short_des
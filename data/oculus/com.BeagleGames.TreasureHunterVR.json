4_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ef6OSkSLlfQQ7kNvwFTbdFB&_nc_oc=AdpL9IOLQfNSK1S-mYvY-VPJ1tsSBgQPcY1fhcaHDNb25w5XzGb68kmncrxwW6vVxpM&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1XDeFacuQ9777qbVIp4PqXOidcQvK0gGeq-CX-zctAfg&oe=69F36A8C"}, {"file_name": "migrated_image.png", "id": "227586865025628", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/11162704_1440534279364325_3553473486204698624_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T0qQwkC80m8Q7kNvwHRieig&_nc_oc=AdpzH9BDZIzPGr8EZ-OjvdAzC39jrp2wb65NVPY5bRnYHaWlOvaFJe-JMS0SsKKAudY&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af00JpqIFdXnIFielyRkWgxfCubyNeic7reUtcy0ODGOlw&oe=69F34D22"}, {"file_name": "migrated_image.png", "id": "223793988733980", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/11162684_1918532331768953_3442552378077741056_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PK0_IF9b3LUQ7kNvwE0961Q&_nc_oc=Adqv3fh139jsAbNUBGdiNkZPw5teKRd0TzMzssn6UUinyu5fvOTafmHM-E0Ns8NmEhA&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3s2mtqVyFotmuJ-69wV8Vtkl6uXHuIbn75977ASZgEBw&oe=69F3664A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Treasure Hunter VR", "keywords": ["puzzle", "arcade", "egypt", "light", "adventure"], "long_description": "Plunge into  the atmosphere of ancient Egypt. Help young Jane  explore lost in the sands ancient temple, full of crafty traps  and find all the hidden treasures of the Pharaoh.\n \nTreasure Hunter VR -This is an atmospheric spatial puzzle based on the physics of light. The game was designed for a long immersive experience in virtual reality. We set ourselves the task to create not only unique mechanics of the game, but also to extend the average player session in VR.\n \n\n- 12 unique levels\n- Immersive atmospheric experience\n- Detailed Ancient Egyptian temple\n- Interesting puzzles\n- Comfort control created specifically for Gear VR", "short_descr
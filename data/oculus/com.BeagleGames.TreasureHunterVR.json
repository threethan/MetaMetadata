4_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mVRjdzPP8cUQ7kNvwGmrGFv&_nc_oc=AdrorZdEnBtP5HqCZTZZfIvqmX3v1ZiiLG1_eC4nKJ16TreFchVS0XBkEWFEpn4n-YY&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQInzUMQR30d7XDeKAQIUIgX_vy7edA4ISSfjEUBawPUng&oe=6AAD4E0C"}, {"file_name": "migrated_image.png", "id": "227586865025628", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/11162704_1440534279364325_3553473486204698624_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jJEw-rUEsLIQ7kNvwGDNatG&_nc_oc=AdqaH1_53GJn5zc5kNrI1pEcWGPC7oFi37p62K4nmc4TXTHDAZ93PxzaaB85QVxqIvc&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLwHawQ_w3CafoRFVs-SlmeHuaz99dt7q_Zu9NfXJLXEw&oe=6AAD30A2"}, {"file_name": "migrated_image.png", "id": "223793988733980", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/11162684_1918532331768953_3442552378077741056_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rNqnNVRMEGMQ7kNvwFCrw86&_nc_oc=Adpgf7pa9vJaPifWBaeTOwWTDKFdePtza7eMnYXa3atcR5VFAyBnhhvnYdmLG2K3DjI&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQILbw2UFnU4d7oWyCiKc8E4AG64DOZP1fsO08w8FTv2_g&oe=6AAD49CA"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Treasure Hunter VR", "keywords": ["puzzle", "arcade", "egypt", "light", "adventure"], "long_description": "Plunge into  the atmosphere of ancient Egypt. Help young Jane  explore lost in the sands ancient temple, full of crafty traps  and find all the hidden treasures of the Pharaoh.\n \nTreasure Hunter VR -This is an atmospheric spatial puzzle based on the physics of light. The game was designed for a long immersive experience in virtual reality. We set ourselves the task to create not only unique mechanics of the game, but also to extend the average player session in VR.\n \n\n- 12 unique levels\n- Immersive atmospheric experience\n- Detailed Ancient Egyptian temple\n- Interesting puzzles\n- Comfort control created specifically for Gear VR", "short_descr
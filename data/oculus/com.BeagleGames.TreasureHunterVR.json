4_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NN8OSQZSr9IQ7kNvwHfkpTe&_nc_oc=AdqaXdgGaP08jYb3KgluyxOs06ze6wmDa1hjFj6-76gouTd4C672BwstTIMQynslKeE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCl7kKeDqBu0O7qz8XsguZ4n4vQOS9SjyVyQ8GYTOgslQ&oe=6A5F858C"}, {"file_name": "migrated_image.png", "id": "227586865025628", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/11162704_1440534279364325_3553473486204698624_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=28yORdCj9fIQ7kNvwGe0fOx&_nc_oc=AdpXBIU3ff7pa5MIpyK7Mzn8sUsLqk0SRFiXPk7z9RUrnzuLxGrmBTwmRM6LwNwDEtQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAdFcbiMgoMZuKIKHc-oRGf0u96s72O8RypJiNNXVFPhw&oe=6A5F6822"}, {"file_name": "migrated_image.png", "id": "223793988733980", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/11162684_1918532331768953_3442552378077741056_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m_4xD3IpDKEQ7kNvwEjeEH6&_nc_oc=AdpiuGr-Iug3yeyas7ztrJZXbdN_vH5GqH29077G2fSY7OWpkPMFg4v0RLP3mysiCoo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC4xNsAkbkwSdM2m9Aer4983w9kd-5N9LlD6nVuwSTKzg&oe=6A5F814A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Treasure Hunter VR", "keywords": ["puzzle", "arcade", "egypt", "light", "adventure"], "long_description": "Plunge into  the atmosphere of ancient Egypt. Help young Jane  explore lost in the sands ancient temple, full of crafty traps  and find all the hidden treasures of the Pharaoh.\n \nTreasure Hunter VR -This is an atmospheric spatial puzzle based on the physics of light. The game was designed for a long immersive experience in virtual reality. We set ourselves the task to create not only unique mechanics of the game, but also to extend the average player session in VR.\n \n\n- 12 unique levels\n- Immersive atmospheric experience\n- Detailed Ancient Egyptian temple\n- Interesting puzzles\n- Comfort control created specifically for Gear VR", "short_descr
4_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O1qzQhwkW2YQ7kNvwGK5_Hy&_nc_oc=AdrA_gl0DBYTgdIhjrUQGFpCgbwCj75yFg5JN9K1mwcDGBATbIsPIh9LItSd0yfkKe8&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJv4c3snRRZ3Bak-kV3xdL6DwBHp7WsX3vwcAjaeSupPg&oe=6A9D7C0C"}, {"file_name": "migrated_image.png", "id": "227586865025628", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/11162704_1440534279364325_3553473486204698624_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oRhG-539tucQ7kNvwGyn_Cb&_nc_oc=AdqkVPH9PwfwLoMML2DYitY3il0r16vudZMn_H82o1ke7zPlJa2armS52V-IXyjPXEY&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJNnfNg3vkLnmqRsSFotUN_ASExAqV5Q1iTM9DWnLINFw&oe=6A9D5EA2"}, {"file_name": "migrated_image.png", "id": "223793988733980", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/11162684_1918532331768953_3442552378077741056_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mIsXVqja_5MQ7kNvwHyJTqB&_nc_oc=Ado_bt6RjFF8nHc3cai9Ri1ncRWd0vwxa_FJFyPd2R5yCZenYxxlCFzeGaZv1xyMXFc&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLcNhiZ1SN1Z19Rn2AZJf8cukBBCKoDR0OMHR5-msnmgg&oe=6A9D77CA"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Treasure Hunter VR", "keywords": ["puzzle", "arcade", "egypt", "light", "adventure"], "long_description": "Plunge into  the atmosphere of ancient Egypt. Help young Jane  explore lost in the sands ancient temple, full of crafty traps  and find all the hidden treasures of the Pharaoh.\n \nTreasure Hunter VR -This is an atmospheric spatial puzzle based on the physics of light. The game was designed for a long immersive experience in virtual reality. We set ourselves the task to create not only unique mechanics of the game, but also to extend the average player session in VR.\n \n\n- 12 unique levels\n- Immersive atmospheric experience\n- Detailed Ancient Egyptian temple\n- Interesting puzzles\n- Comfort control created specifically for Gear VR", "short_descr
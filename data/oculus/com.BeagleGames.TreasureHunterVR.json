4_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wIT4xvInzNwQ7kNvwEjRQ4n&_nc_oc=AdpP5oKPfiV1e2HMOn_P5nr5K_JvaW3eUeoZN7cXipFBHiSUPqGpi1IRkGwAIyUp29s&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKN7Yj93TDoWfm8-bBqb3ZA1pKPO0MilThROAeRf0a24Q&oe=6AA5650C"}, {"file_name": "migrated_image.png", "id": "227586865025628", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/11162704_1440534279364325_3553473486204698624_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QrJKyzFYAokQ7kNvwGuGw_X&_nc_oc=AdrIF5S_wpdqSg-HjjnwH7LS1FzauJTak2aY6svvoomwVwgNcZ_rHGgzWSdx_8uv_DY&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKG09QsGKAuwfGKjcVtlE_VvVe1l3vewmzqlsI-EMAc5Q&oe=6AA547A2"}, {"file_name": "migrated_image.png", "id": "223793988733980", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/11162684_1918532331768953_3442552378077741056_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=skJTmmbQ5s0Q7kNvwEjl_Rj&_nc_oc=AdqcOeQGOKKvFPv0Cf9bOkNQvlVGfwKktgORGxe65HKd3LhXWKOKprYWDc6VXssnaKo&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIIkkKXalFPeCmFXzBh2nHBs7hQxn0LSKNHxOhSGSJNuQ&oe=6AA560CA"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Treasure Hunter VR", "keywords": ["puzzle", "arcade", "egypt", "light", "adventure"], "long_description": "Plunge into  the atmosphere of ancient Egypt. Help young Jane  explore lost in the sands ancient temple, full of crafty traps  and find all the hidden treasures of the Pharaoh.\n \nTreasure Hunter VR -This is an atmospheric spatial puzzle based on the physics of light. The game was designed for a long immersive experience in virtual reality. We set ourselves the task to create not only unique mechanics of the game, but also to extend the average player session in VR.\n \n\n- 12 unique levels\n- Immersive atmospheric experience\n- Detailed Ancient Egyptian temple\n- Interesting puzzles\n- Comfort control created specifically for Gear VR", "short_descr
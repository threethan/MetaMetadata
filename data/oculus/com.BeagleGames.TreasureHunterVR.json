4_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=80YipOMEU5wQ7kNvwFpG9UR&_nc_oc=AdrndGwxUrg9zgUljVfoseK1DTiKcFEpXrxSuPQxOcvqo6iLd2y4cbQWZeQ5EZih--I&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDGu4QQsIBrN9FudJZ2pUjBAxI1iRXACNsnMDgBwOt0Yw&oe=6A5A3F8C"}, {"file_name": "migrated_image.png", "id": "227586865025628", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/11162704_1440534279364325_3553473486204698624_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ITLKQEmv7BsQ7kNvwFbMP5N&_nc_oc=Ado6E5SkYCo0udiqRWBkXnv8qvrgmBPExP1zdEhrpgkhs541zhmmQN2ZoskoCW-qbRA&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBr1hs0WtlVGVGO30jcXqRVCK9NQQiosg0PyEJI3XQkQA&oe=6A5A2222"}, {"file_name": "migrated_image.png", "id": "223793988733980", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/11162684_1918532331768953_3442552378077741056_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EDOjVoBLQPgQ7kNvwGN7BYn&_nc_oc=Adq6Z2Ark1Q1z3QKvd_3hK-6fueDHcbB8Ry9DyDOY-8z10wYYUtRPg9y62ioYS13Xbo&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDhGIsHd3IagKAQpHrTl4qzWhPTp7zkDHrxnB5d1kU29Q&oe=6A5A3B4A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Treasure Hunter VR", "keywords": ["puzzle", "arcade", "egypt", "light", "adventure"], "long_description": "Plunge into  the atmosphere of ancient Egypt. Help young Jane  explore lost in the sands ancient temple, full of crafty traps  and find all the hidden treasures of the Pharaoh.\n \nTreasure Hunter VR -This is an atmospheric spatial puzzle based on the physics of light. The game was designed for a long immersive experience in virtual reality. We set ourselves the task to create not only unique mechanics of the game, but also to extend the average player session in VR.\n \n\n- 12 unique levels\n- Immersive atmospheric experience\n- Detailed Ancient Egyptian temple\n- Interesting puzzles\n- Comfort control created specifically for Gear VR", "short_descr
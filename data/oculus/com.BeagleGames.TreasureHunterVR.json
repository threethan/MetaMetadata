4_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hwl0poa1LTAQ7kNvwGbcoHv&_nc_oc=Adp4nazhEEDrody2dlTnkOTudfp3gUvMswoQ7qRXVeAuxMlCL6TQ2vky7y6ZUD5T3CA&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_mxZdaFDiZgwgNYsJbMKFVLGjLpzAzB3kRRInlFODxPA&oe=6A26D50C"}, {"file_name": "migrated_image.png", "id": "227586865025628", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/11162704_1440534279364325_3553473486204698624_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_oY-fX7yxkkQ7kNvwFxRP_H&_nc_oc=AdrH6l7UbPR7K9abs2hQfFFdorTLwULSrsTzzObuAMo1c0BMmkE_FacX0-Y-7Uj3XmM&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8MbLqqWuczNm9toazN2x_wxMTbUsqalxNmYB6oT-plXg&oe=6A26B7A2"}, {"file_name": "migrated_image.png", "id": "223793988733980", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/11162684_1918532331768953_3442552378077741056_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=liE9jbbvk1MQ7kNvwG2X3-j&_nc_oc=Adqgz_MrhPz2W9QTyZPszcCnFu1vMTaJxjiqBWBeyuPVcqYroNiX5q_a-Jg1TbkkFls&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-LOKNGyQhtY2IV1T2gW381VQ4wICffeEhzq7F1amlcvg&oe=6A26D0CA"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Treasure Hunter VR", "keywords": ["puzzle", "arcade", "egypt", "light", "adventure"], "long_description": "Plunge into  the atmosphere of ancient Egypt. Help young Jane  explore lost in the sands ancient temple, full of crafty traps  and find all the hidden treasures of the Pharaoh.\n \nTreasure Hunter VR -This is an atmospheric spatial puzzle based on the physics of light. The game was designed for a long immersive experience in virtual reality. We set ourselves the task to create not only unique mechanics of the game, but also to extend the average player session in VR.\n \n\n- 12 unique levels\n- Immersive atmospheric experience\n- Detailed Ancient Egyptian temple\n- Interesting puzzles\n- Comfort control created specifically for Gear VR", "short_descr
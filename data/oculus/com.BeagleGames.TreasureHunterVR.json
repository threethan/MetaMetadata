4_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Gqr-OQKaiLQQ7kNvwHDL-ih&_nc_oc=AdoDHVBXwL1Ld47K6VjQStKGuycZhvd2Gajx9n6UKr36TG1KnlC2FYRa7rxaXCuqFDc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFL1lTQJmQdDDRvRj_WuFQgvYLbz_P2cBwjd9xQnfBKIA&oe=6A7C4E4C"}, {"file_name": "migrated_image.png", "id": "227586865025628", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/11162704_1440534279364325_3553473486204698624_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AFInKskbTncQ7kNvwHTBJeT&_nc_oc=AdomsQAiqNQhhTOPmUDiFahhUM9oHIo09d7auhTHaz-O0LugOQmZ3w8XKhF31T1hNsc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHiBhgnwP9VrBEj0rdNd7o-_dfr94frTZ5oBLXiOj14rQ&oe=6A7C6922"}, {"file_name": "migrated_image.png", "id": "223793988733980", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/11162684_1918532331768953_3442552378077741056_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5NI9cnvw0tkQ7kNvwH1NbQR&_nc_oc=AdouKJYc_43k3vfE9cgCtGrDtOXhekOjYh1OMkpGtAxuWDwFHoiarXbKjFiQY_xQFzk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHiRqzz_Bf7WX8kAszOyk-bSeCSaq8SJkA-Sdi480TZ7Q&oe=6A7C4A0A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Treasure Hunter VR", "keywords": ["puzzle", "arcade", "egypt", "light", "adventure"], "long_description": "Plunge into  the atmosphere of ancient Egypt. Help young Jane  explore lost in the sands ancient temple, full of crafty traps  and find all the hidden treasures of the Pharaoh.\n \nTreasure Hunter VR -This is an atmospheric spatial puzzle based on the physics of light. The game was designed for a long immersive experience in virtual reality. We set ourselves the task to create not only unique mechanics of the game, but also to extend the average player session in VR.\n \n\n- 12 unique levels\n- Immersive atmospheric experience\n- Detailed Ancient Egyptian temple\n- Interesting puzzles\n- Comfort control created specifically for Gear VR", "short_descr
f&oh=00_AQQd8Znr6jYKsyXnmRM8QZJw6IyB8-ePjjw0yBkKR-_dTA&oe=6B0C8025"}, {"file_name": "migrated_image.png", "id": "519359865390619", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/11162693_178342762711392_7188359649463107584_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UfmVWA99H_IQ7kNvwF1cD53&_nc_oc=AdoulESbaILbXWCMqyVNBnPehyFFI0shjNH1z6jJpts4pfws9wkPwCb774oSdciJENo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTYLv9laD7V2iHen4NJStFMPVAQz6aiAk-pHIJUJ590BA&oe=6B0C724C"}, {"file_name": "migrated_image.png", "id": "227586865025628", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/11162704_1440534279364325_3553473486204698624_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YL1WxtPet98Q7kNvwGKBCYD&_nc_oc=AdqwEh77b1cFreWMOCjxuXH62btxR7MD0Nf5u20RysKEoFQ3hlcs37UakFabM03azsk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQ3320YLX-C_D-mAshF6gMNv6Gajfw9spHddREHuj6wcw&oe=6B0C54E2"}, {"file_name": "migrated_image.png", "id": "223793988733980", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/11162684_1918532331768953_3442552378077741056_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZrshPUdvKwEQ7kNvwESt17e&_nc_oc=AdpRGafbGyHXeGUAY9-I_8CWSZGvzIJkFPPF-fiN0UjJcqCsPmp23Om4cHuNglrVRBc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRycqpWIW3ps5Kf_dE7T147ZCgmNLyF9bkk-_38eQf-Og&oe=6B0C6E0A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Treasure Hunter VR", "keywords": ["puzzle", "arcade", "egypt", "light", "adventure"], "long_description": "Plunge into  the atmosphere of ancient Egypt. Help young Jane  explore lost in the sands ancient temple, full of crafty traps  and find all the hidden treasures of the Pharaoh.\n \nTreasure Hunter VR -This is an atmospheric spatial puzzle based on the physics of light. The game was designed for a long immersive experience in virtual reality. We set ourselves the task to create not only unique mechanics of the game, but also to extend the average player session in VR.\n \n\n- 12 unique levels\n- Immersive atmospheric experience\n- Detailed Ancient Egyptian temple\n- Interesting puzzles\n- Comfort control created specifically for Gear VR", "short_description": "Plunge into  the atmosphere of ancient Egypt. Help young Jane  explore lost in the sands ancient temple, full of crafty traps  and find all the hidden treasures of the Pharaoh."}]}, "developer_name": null, "developer_privacy_policy_url": "http://beaglegames.com/privacy-policy/", "developer_terms_of_service_url": "http://beaglegames.com/privacy-policy/", "publisher_name": "Beagle Games", "support_website_url": null, "website_url": "http://beaglegames.com/games/treasurehuntervr/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ADVENTURE", "CASUAL", "EDUCATIONAL", "PUZZLE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "628128321824755"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/11162698_1885979984988832_6272463104861274112_n.png?stp=dst-png_s360x360&_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rIev-KQOv38Q7kNvwGVsUbh&_nc_oc=AdrCZPuIALQmo4e1UqMgwaL7GfwV1COg8LvvQwDafJShVTb9XiPynrbdoVF8BIFyWOk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSytUMRlnS9sdSKKpyaBX67J2ECCd41bCg0RSN4PiIXVg&oe=6B0C815A"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Treasure Hunter VR", "platform
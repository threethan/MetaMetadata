4_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x3viWAO4LicQ7kNvwFRB8Vn&_nc_oc=Adpnfz-82mxBnFbuC8c1KKY-_FpxVnZEfLydKP-XDO4aI9SGp7Tqzu75TiTif0zOQdc&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6brJRYFyi11qkUuQr56WvgjWW0T94-8GCpt8v30ofFBg&oe=6A15B18C"}, {"file_name": "migrated_image.png", "id": "227586865025628", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/11162704_1440534279364325_3553473486204698624_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EJfsgMDyUlQQ7kNvwGkC2mb&_nc_oc=AdphN2UG0JTuiHPYk4kC0Qvb3XxVU6YHrW_znc_1WVJivz7eoE8N1txoHvuTkQt0fQs&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af47cqd6sahxzS6CEd8VsTg_OK3FYnpOK_IHU9nRtTGb2w&oe=6A159422"}, {"file_name": "migrated_image.png", "id": "223793988733980", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/11162684_1918532331768953_3442552378077741056_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TxL4ea6fa4MQ7kNvwEOArBv&_nc_oc=AdqBv2XrKnnBoKPlVgP1IgWLKczWSO1-MD9yM9GymbDD699TNyiuqTZR4zzFQ9ap73c&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af780Yl0SzmSdL2s2F17y52BZG6I25bpzmiLXD3SFQ_GIw&oe=6A15AD4A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Treasure Hunter VR", "keywords": ["puzzle", "arcade", "egypt", "light", "adventure"], "long_description": "Plunge into  the atmosphere of ancient Egypt. Help young Jane  explore lost in the sands ancient temple, full of crafty traps  and find all the hidden treasures of the Pharaoh.\n \nTreasure Hunter VR -This is an atmospheric spatial puzzle based on the physics of light. The game was designed for a long immersive experience in virtual reality. We set ourselves the task to create not only unique mechanics of the game, but also to extend the average player session in VR.\n \n\n- 12 unique levels\n- Immersive atmospheric experience\n- Detailed Ancient Egyptian temple\n- Interesting puzzles\n- Comfort control created specifically for Gear VR", "short_descr
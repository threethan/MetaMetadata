4_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4Iiia77_S78Q7kNvwH_SZfC&_nc_oc=AdraaUNcSJo-m3gy5jGd48nBNYnO9IjgIws43upG8EstyhcneG0NIAQPqggv9yUsJ1Y&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9Aoh-Oyhwkv9E6ThIDRivD_ToMUsG-hy62JMAEPM1YRg&oe=6A37F88C"}, {"file_name": "migrated_image.png", "id": "227586865025628", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/11162704_1440534279364325_3553473486204698624_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QZrqr8I03sEQ7kNvwGt-HKm&_nc_oc=AdphX19AZyx6tr2cnAXlMYGgeu6wfpFCrQP1FmsvFD6_OhIct2gb0HhPO8DbMVldNMA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9CIx_DW_NpFALa8GseG_iwsyxogXX5uN23Qf0CC2ctfQ&oe=6A381362"}, {"file_name": "migrated_image.png", "id": "223793988733980", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/11162684_1918532331768953_3442552378077741056_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HV3cKdAYVi4Q7kNvwHIvoJL&_nc_oc=Adou-H-A4fKWlgnuNXEfhh9_W4FVUc4ftnhOegDOGc9N8OWs24uydTCWB16D8qRYhxI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-KCuTZszzRgF6lEBOxpksVuGJtDTfkJCBOdNig18AazA&oe=6A37F44A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Treasure Hunter VR", "keywords": ["puzzle", "arcade", "egypt", "light", "adventure"], "long_description": "Plunge into  the atmosphere of ancient Egypt. Help young Jane  explore lost in the sands ancient temple, full of crafty traps  and find all the hidden treasures of the Pharaoh.\n \nTreasure Hunter VR -This is an atmospheric spatial puzzle based on the physics of light. The game was designed for a long immersive experience in virtual reality. We set ourselves the task to create not only unique mechanics of the game, but also to extend the average player session in VR.\n \n\n- 12 unique levels\n- Immersive atmospheric experience\n- Detailed Ancient Egyptian temple\n- Interesting puzzles\n- Comfort control created specifically for Gear VR", "short_descr
4_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GVyKDUoqsxYQ7kNvwGjHhKO&_nc_oc=AdrsQZBO24qDJu4eNg8EJk0wSO0dN5_7US_8r80V-q2w_M2tcyO-0R32l-O6EAR9Vck&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPY81Mw46q2SHRGj6-VyMgappca-s8u9q8KnEhMgjFRwA&oe=6AC2660C"}, {"file_name": "migrated_image.png", "id": "227586865025628", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/11162704_1440534279364325_3553473486204698624_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lXZJT0dRA3UQ7kNvwHio9xC&_nc_oc=AdqEGssNXMYBd0POnZAJkGPpT6MIeMMnRJKrNcPe9esqUYG6mcNNv9z9EICj6vFClYE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOHxpMbvVwsQj5aUKUjdnotk2EKyJPB9FXfdPYTl-73XA&oe=6AC280E2"}, {"file_name": "migrated_image.png", "id": "223793988733980", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/11162684_1918532331768953_3442552378077741056_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RqPznJcEb0sQ7kNvwHSJ4lx&_nc_oc=AdrdwuRHN2KQeeds-BLPcvC3ezUVwR_5QmQuYRbeVcjKv7dt-2d3nERDWU84OfIm1ws&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMAUZND2pleyce8BAIcy7mOWaW22Xq7HFjieDF3xQK_2g&oe=6AC261CA"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Treasure Hunter VR", "keywords": ["puzzle", "arcade", "egypt", "light", "adventure"], "long_description": "Plunge into  the atmosphere of ancient Egypt. Help young Jane  explore lost in the sands ancient temple, full of crafty traps  and find all the hidden treasures of the Pharaoh.\n \nTreasure Hunter VR -This is an atmospheric spatial puzzle based on the physics of light. The game was designed for a long immersive experience in virtual reality. We set ourselves the task to create not only unique mechanics of the game, but also to extend the average player session in VR.\n \n\n- 12 unique levels\n- Immersive atmospheric experience\n- Detailed Ancient Egyptian temple\n- Interesting puzzles\n- Comfort control created specifically for Gear VR", "short_descr
4_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8w5vH2o4keMQ7kNvwHQtmhN&_nc_oc=AdpusnBxpYYnVod2RMJ97GlAODiSa7C69v3Yy9dEYGWbn_OPoBPUHNf0BUn-mU3Z3xI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af34sS-ZlBiAhM6EVAnfkBNi1bGRlex4roTfarJ8hCvChA&oe=69DE528C"}, {"file_name": "migrated_image.png", "id": "227586865025628", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/11162704_1440534279364325_3553473486204698624_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c4zVhhsK7vMQ7kNvwG5432N&_nc_oc=Adot3pT8Ljqehn4Cudyi5gGFhuTbwiOGmm0KCVi5Bi8i6PHxVqX-WV4t6XId-ZUCtX4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0HNnm_cb04mXM-K1Jf3JwNjC10mCLoTIv7d0tQ9hVo4Q&oe=69DE3522"}, {"file_name": "migrated_image.png", "id": "223793988733980", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/11162684_1918532331768953_3442552378077741056_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uNirwcKtfcQQ7kNvwHpgWbp&_nc_oc=AdqVVrVF3JSu-Ln3VEdtLTuPaI6lp5Ax-VnsTRiOqruYQgxyItsfoLAL51DClpSdUsM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0Rv28edHvMUsETHEwhBwuiWryNr3CNohRDnR540fw6yQ&oe=69DE4E4A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Treasure Hunter VR", "keywords": ["puzzle", "arcade", "egypt", "light", "adventure"], "long_description": "Plunge into  the atmosphere of ancient Egypt. Help young Jane  explore lost in the sands ancient temple, full of crafty traps  and find all the hidden treasures of the Pharaoh.\n \nTreasure Hunter VR -This is an atmospheric spatial puzzle based on the physics of light. The game was designed for a long immersive experience in virtual reality. We set ourselves the task to create not only unique mechanics of the game, but also to extend the average player session in VR.\n \n\n- 12 unique levels\n- Immersive atmospheric experience\n- Detailed Ancient Egyptian temple\n- Interesting puzzles\n- Comfort control created specifically for Gear VR", "short_descr
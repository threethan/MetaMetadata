f&oh=00_AQSOdz374AJGgz3drdf6jjtlZa2a5Qzm-Mlv6ehns3dm3Q&oe=6B006A65"}, {"file_name": "migrated_image.png", "id": "519359865390619", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/11162693_178342762711392_7188359649463107584_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2y3MNLu-4zAQ7kNvwGHbzzR&_nc_oc=AdppQhSamhNxhPgFCqUxQFnKuHSJHIhaWZq0pXY0oe18Te33dtaAI95PHfpE5DXbQKA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRHXnu93oido4G05kldYUXNOIHPNMgqwpkQhGgacT5Cig&oe=6B005C8C"}, {"file_name": "migrated_image.png", "id": "227586865025628", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/11162704_1440534279364325_3553473486204698624_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W3n8WBgLProQ7kNvwHReXbg&_nc_oc=Adp0wJyfVhmaqjiCHIy-9h1ydUJ6ZipYWFQxeU5csP1cTK9vYrYORp7hJDKlOSi-26o&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQazOxOxgQmeyIDJ8mXpuBWLHGqFtHc4pnD301lnrmiQA&oe=6B007762"}, {"file_name": "migrated_image.png", "id": "223793988733980", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/11162684_1918532331768953_3442552378077741056_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UT4n2heEqqAQ7kNvwFAJzu1&_nc_oc=Adr3DTRI9WkOtLUYKezdIRahTbShxZnwnLWiZjcISqKmTD2hL93G2li9S26V1tz_eZg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT8HCHAqnC2ez6MlmRU2KU0rDZLZypzUHwdYieqcGlatg&oe=6B00584A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Treasure Hunter VR", "keywords": ["puzzle", "arcade", "egypt", "light", "adventure"], "long_description": "Plunge into  the atmosphere of ancient Egypt. Help young Jane  explore lost in the sands ancient temple, full of crafty traps  and find all the hidden treasures of the Pharaoh.\n \nTreasure Hunter VR -This is an atmospheric spatial puzzle based on the physics of light. The game was designed for a long immersive experience in virtual reality. We set ourselves the task to create not only unique mechanics of the game, but also to extend the average player session in VR.\n \n\n- 12 unique levels\n- Immersive atmospheric experience\n- Detailed Ancient Egyptian temple\n- Interesting puzzles\n- Comfort control created specifically for Gear VR", "short_description": "Plunge into  the atmosphere of ancient Egypt. Help young Jane  explore lost in the sands ancient temple, full of crafty traps  and find all the hidden treasures of the Pharaoh."}]}, "developer_name": null, "developer_privacy_policy_url": "http://beaglegames.com/privacy-policy/", "developer_terms_of_service_url": "http://beaglegames.com/privacy-policy/", "publisher_name": "Beagle Games", "support_website_url": null, "website_url": "http://beaglegames.com/games/treasurehuntervr/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ADVENTURE", "CASUAL", "EDUCATIONAL", "PUZZLE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "628128321824755"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/11162698_1885979984988832_6272463104861274112_n.png?stp=dst-png_s360x360&_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Sy1hWk6_CTAQ7kNvwF5YURx&_nc_oc=AdqqHYd7_1turVMaVlsWw6dB7NCXEhmfV6rEMQ6zeHvvqbgzMV7_WoUBAcqYVA-RfKc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ7j7eN84eahdmo_QZQ7_6KvmaWpa3zKmAAxy4-RAMdSQ&oe=6B006B9A"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Treasure Hunter VR", "platform
4_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=58ej8Ddhz8oQ7kNvwFdozof&_nc_oc=Adqvj71ur0_09U47jnp-xUMzuzEvsRIgwUZrwEFFyyt55AIxctgdoOgCGzclbl_gdag&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-fQbZ7oB4tYl9s9ogPS15vmgtBar0YocCoo6oPms0mKg&oe=6A34040C"}, {"file_name": "migrated_image.png", "id": "227586865025628", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/11162704_1440534279364325_3553473486204698624_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZyrKjb_YUHYQ7kNvwG55Zej&_nc_oc=Adq2ANnecdUScOn1eCo9yrkpO39uZd7UO5DYB354V_5YS3NOteF7D23OoKSMva3y9AY&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_gmbB2kUSe2dWvi-NwOzPeKEr6LDsh0XrdgXcinscjHg&oe=6A341EE2"}, {"file_name": "migrated_image.png", "id": "223793988733980", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/11162684_1918532331768953_3442552378077741056_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Qb169_reJKIQ7kNvwGbqzxV&_nc_oc=Adq3NvKiD8V-Ew4KbYnlYW0K3QH1fVGeIvBm8WmnHSEudpnSxNGpIhH515rjZlgCgwM&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_QpFkInD5hiurOdiu6kXNe1SeTZ8p5l7YX2TPPKLzSUA&oe=6A33FFCA"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Treasure Hunter VR", "keywords": ["puzzle", "arcade", "egypt", "light", "adventure"], "long_description": "Plunge into  the atmosphere of ancient Egypt. Help young Jane  explore lost in the sands ancient temple, full of crafty traps  and find all the hidden treasures of the Pharaoh.\n \nTreasure Hunter VR -This is an atmospheric spatial puzzle based on the physics of light. The game was designed for a long immersive experience in virtual reality. We set ourselves the task to create not only unique mechanics of the game, but also to extend the average player session in VR.\n \n\n- 12 unique levels\n- Immersive atmospheric experience\n- Detailed Ancient Egyptian temple\n- Interesting puzzles\n- Comfort control created specifically for Gear VR", "short_descr
4_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8hMcwDLcPIIQ7kNvwGsJbAC&_nc_oc=Adr4a1lZnqPx5j02RWeI_ruZi70EUj-0eH8IMWO3T2O2zuaQEB9P_oNbqvxg73XZzkQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPYdLI9WpNDjusFf0oqD9D0m-QQ4WFGTA9q0JepiBtNpw&oe=6AC65A8C"}, {"file_name": "migrated_image.png", "id": "227586865025628", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/11162704_1440534279364325_3553473486204698624_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kZvONl7erCwQ7kNvwGj75d1&_nc_oc=AdrXn1OciWsNFxYUk0acJBgRLinH3v-1JJDaJMSBzYK4NHNi8BKEWv4go3KyRnRbxJU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM9bW6HrfkDW-8-mrpWLB3yPGloUdriqr_SBveLYF3fhg&oe=6AC67562"}, {"file_name": "migrated_image.png", "id": "223793988733980", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/11162684_1918532331768953_3442552378077741056_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OgFgOF5zSNkQ7kNvwHuRRNU&_nc_oc=Ado0pTUwC8NOJ7XEiATOVUCzTudXsMFoj9rw4lwWR4EPUDOY32NL3kuiVEwWo2E0CJI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMynNqKt2ZTCPi923VegVz9enDJekPWYPIA-IE1rPWYww&oe=6AC6564A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Treasure Hunter VR", "keywords": ["puzzle", "arcade", "egypt", "light", "adventure"], "long_description": "Plunge into  the atmosphere of ancient Egypt. Help young Jane  explore lost in the sands ancient temple, full of crafty traps  and find all the hidden treasures of the Pharaoh.\n \nTreasure Hunter VR -This is an atmospheric spatial puzzle based on the physics of light. The game was designed for a long immersive experience in virtual reality. We set ourselves the task to create not only unique mechanics of the game, but also to extend the average player session in VR.\n \n\n- 12 unique levels\n- Immersive atmospheric experience\n- Detailed Ancient Egyptian temple\n- Interesting puzzles\n- Comfort control created specifically for Gear VR", "short_descr
4_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lZBjercZQKMQ7kNvwF0udwN&_nc_oc=AdrLDXApyKjXeR86Smu8AiW6EFYMTzNrWnlK7g9BbrTF9us_SJMZMEgFHPaoFZrHCaU&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4Iy7jNLzGdGj2hxu8eV6KZUmgz8ToPYdnhuE__68EuTA&oe=6A033C8C"}, {"file_name": "migrated_image.png", "id": "227586865025628", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/11162704_1440534279364325_3553473486204698624_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jtB0XwDGzmcQ7kNvwEdV8Ts&_nc_oc=AdrMJjiSwqMx9m3pfCcHrFOioGII5H0Ceij_KS10bF8N7FRp8maHT_o04I8PmyTSVsk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7bf_rESf3tkcBh1QVCrok2Wqg9h14zRgsHtoYUsjdXOQ&oe=6A031F22"}, {"file_name": "migrated_image.png", "id": "223793988733980", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/11162684_1918532331768953_3442552378077741056_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bDNJZRRibz0Q7kNvwHBjpWa&_nc_oc=Adoo_aYWKHT0PSlgauJn4ZqZgTyQxd6tUFUrCgMSvwSvuyz1nwg9Vt9dlz65LugHGuc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af568qWfDL1z4Db1pcp51eSQAJ-S_zP8U_Mn3V08TLUiWA&oe=6A03384A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Treasure Hunter VR", "keywords": ["puzzle", "arcade", "egypt", "light", "adventure"], "long_description": "Plunge into  the atmosphere of ancient Egypt. Help young Jane  explore lost in the sands ancient temple, full of crafty traps  and find all the hidden treasures of the Pharaoh.\n \nTreasure Hunter VR -This is an atmospheric spatial puzzle based on the physics of light. The game was designed for a long immersive experience in virtual reality. We set ourselves the task to create not only unique mechanics of the game, but also to extend the average player session in VR.\n \n\n- 12 unique levels\n- Immersive atmospheric experience\n- Detailed Ancient Egyptian temple\n- Interesting puzzles\n- Comfort control created specifically for Gear VR", "short_descr
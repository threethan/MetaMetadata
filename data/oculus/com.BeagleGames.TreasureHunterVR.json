4_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qwIZeYhZM_oQ7kNvwHDt6m9&_nc_oc=Adrjf0qmdbAxcLyIn5r4h5MnCY9pFhjvEOy9GysNJzvxTbkQWzJrJh1I97L_0lV0w-I&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5MuFO1niXVnAy898UCIRoGmSerMh8E8FsVf9lKxp2hog&oe=6A09D40C"}, {"file_name": "migrated_image.png", "id": "227586865025628", "uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/11162704_1440534279364325_3553473486204698624_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SV4t0P4LDtQQ7kNvwFk1ZwD&_nc_oc=Adr_sfAL7HQAqBhvbaHi-DJslP1ZtoPz2-1yjjB9Y6gJsdk66pbo0vkL3aAQ5xEg-AM&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af74BAZ_ZN0D9JIfK6jfL2OK6r485mai3_HoVpu27RCVAA&oe=6A09B6A2"}, {"file_name": "migrated_image.png", "id": "223793988733980", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/11162684_1918532331768953_3442552378077741056_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ofh2yt9lMRkQ7kNvwE16s2m&_nc_oc=AdoW6MUm6eV45B3ELtIHdS8CQKI-69xMY-xJ681I416CLMhvrP-AXzYfYlZ5g5UFUEM&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7MTnEYY0VqaNxrgUZqIFR9oHDdNlGwzbr_7zlwZ6zPGQ&oe=6A09CFCA"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Treasure Hunter VR", "keywords": ["puzzle", "arcade", "egypt", "light", "adventure"], "long_description": "Plunge into  the atmosphere of ancient Egypt. Help young Jane  explore lost in the sands ancient temple, full of crafty traps  and find all the hidden treasures of the Pharaoh.\n \nTreasure Hunter VR -This is an atmospheric spatial puzzle based on the physics of light. The game was designed for a long immersive experience in virtual reality. We set ourselves the task to create not only unique mechanics of the game, but also to extend the average player session in VR.\n \n\n- 12 unique levels\n- Immersive atmospheric experience\n- Detailed Ancient Egyptian temple\n- Interesting puzzles\n- Comfort control created specifically for Gear VR", "short_descr
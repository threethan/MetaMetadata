4_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=467EPWkhHrEQ7kNvwGht8oM&_nc_oc=Ado3ZYPHFfzV6Z5GZkc3kkQ67qFg9wjeC8tXOp4VWpCt1XdfhqBXgUQ1Tcj50nad-RA&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1yR7-Mm8z4MGOcxc7zvHCFCPLEVK--iCLnQ9zjx-jZgA&oe=69F8B08C"}, {"file_name": "migrated_image.png", "id": "227586865025628", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/11162704_1440534279364325_3553473486204698624_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Csu-NokujTkQ7kNvwFakvUB&_nc_oc=Adpt3a4u-VfAV0GJVKyT-zGXuaTIkgHl40oEYR2NV-MP9tkMvt-yhzoweGy6dNfXtT8&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3i6B7dHYE1NkRt4f-cW8FtkJ5ndRHL7OuWVQlpQdw8Hg&oe=69F89322"}, {"file_name": "migrated_image.png", "id": "223793988733980", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/11162684_1918532331768953_3442552378077741056_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bExKPaU0w6oQ7kNvwGl6_Zm&_nc_oc=Adok-fk2Kh0QTjLN_ovg8KGA2Y1OvaB8s8ElMGbkicnJIH4jVbot7Qo1OXRfJQgpyek&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1cL77W_fCu4Zr8a2oADi7Cc5-iO1R-W3impF9ka4yfig&oe=69F8AC4A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Treasure Hunter VR", "keywords": ["puzzle", "arcade", "egypt", "light", "adventure"], "long_description": "Plunge into  the atmosphere of ancient Egypt. Help young Jane  explore lost in the sands ancient temple, full of crafty traps  and find all the hidden treasures of the Pharaoh.\n \nTreasure Hunter VR -This is an atmospheric spatial puzzle based on the physics of light. The game was designed for a long immersive experience in virtual reality. We set ourselves the task to create not only unique mechanics of the game, but also to extend the average player session in VR.\n \n\n- 12 unique levels\n- Immersive atmospheric experience\n- Detailed Ancient Egyptian temple\n- Interesting puzzles\n- Comfort control created specifically for Gear VR", "short_descr
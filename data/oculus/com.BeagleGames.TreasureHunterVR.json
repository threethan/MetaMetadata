4_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oDDMl8oTQx0Q7kNvwH_zj2b&_nc_oc=Adoyai-K4X9KBIIvg9E12RqDppFZV2QkZ_NrKamr32llc0z2OsAEEwqxm6S6XUez0jc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJHZuKBwvogL-8Co4pj45a_iI0pW6j8kuC2DqSQLQgyxw&oe=6AAFF10C"}, {"file_name": "migrated_image.png", "id": "227586865025628", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/11162704_1440534279364325_3553473486204698624_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jJEw-rUEsLIQ7kNvwGO_mah&_nc_oc=AdoY9RU7cXeyEwJgCUMygQCil_UOKsKwyfJGfOu8kaJn6djADLNPkWhiySTZEp93wQA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKNSndxBGqVkAHS24DGjPEOlm9avxQE3uwg-BUsmZY3Wg&oe=6AAFD3A2"}, {"file_name": "migrated_image.png", "id": "223793988733980", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/11162684_1918532331768953_3442552378077741056_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VSGveYDeamIQ7kNvwHhdA2_&_nc_oc=AdoJdNzjxEW8k-8sfAJrMvn769CSGiULcrtXsjbhRTrDLZ-Mfa_o4fvRgsNwBqeMYGw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIWXmnAJMpuBC7nFLTiWZ1iEwBPMwA3A51oj1VEhLa6Eg&oe=6AAFECCA"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Treasure Hunter VR", "keywords": ["puzzle", "arcade", "egypt", "light", "adventure"], "long_description": "Plunge into  the atmosphere of ancient Egypt. Help young Jane  explore lost in the sands ancient temple, full of crafty traps  and find all the hidden treasures of the Pharaoh.\n \nTreasure Hunter VR -This is an atmospheric spatial puzzle based on the physics of light. The game was designed for a long immersive experience in virtual reality. We set ourselves the task to create not only unique mechanics of the game, but also to extend the average player session in VR.\n \n\n- 12 unique levels\n- Immersive atmospheric experience\n- Detailed Ancient Egyptian temple\n- Interesting puzzles\n- Comfort control created specifically for Gear VR", "short_descr
4_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XF-bT5bcm48Q7kNvwFaGEJR&_nc_oc=AdocUIWtkD3m9Ia03tyvrTH3R4jI5z1iexrSzAmBcmRYnS7IO6cH4K3AZYL_5zen2II&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-U0OfflwHRp7kwPhWb3OyQTyFtQ8jqqyDlWfN4_JaNig&oe=6A42848C"}, {"file_name": "migrated_image.png", "id": "227586865025628", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/11162704_1440534279364325_3553473486204698624_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b_iyXDlIT6AQ7kNvwFR2Btz&_nc_oc=AdqmRVXxPUPfM7lkMLgvYamb90i908TMTShu4oYMcxo94uMUOCxRfxa-yfaC99gtpWc&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_0tnXbwbw-THhvJ7UjaqLGnDpBRMwUYcToQ_PdHGDC4Q&oe=6A426722"}, {"file_name": "migrated_image.png", "id": "223793988733980", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/11162684_1918532331768953_3442552378077741056_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y0LlIjc-_UYQ7kNvwHT1Fbx&_nc_oc=Adq9gPVly714HCj_4kJC7BRRAVrfPhbo5Cn2wWbu9ax-Pae101x2poMFq8nRhWnQUhY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8UXpuAekdHb_PtCoT4nOI8l0-Vtoo7KPNYP2gx9oLe2w&oe=6A42804A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Treasure Hunter VR", "keywords": ["puzzle", "arcade", "egypt", "light", "adventure"], "long_description": "Plunge into  the atmosphere of ancient Egypt. Help young Jane  explore lost in the sands ancient temple, full of crafty traps  and find all the hidden treasures of the Pharaoh.\n \nTreasure Hunter VR -This is an atmospheric spatial puzzle based on the physics of light. The game was designed for a long immersive experience in virtual reality. We set ourselves the task to create not only unique mechanics of the game, but also to extend the average player session in VR.\n \n\n- 12 unique levels\n- Immersive atmospheric experience\n- Detailed Ancient Egyptian temple\n- Interesting puzzles\n- Comfort control created specifically for Gear VR", "short_descr
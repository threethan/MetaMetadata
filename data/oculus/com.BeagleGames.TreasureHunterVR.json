4_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TGEhX3THJJ4Q7kNvwGMZrAQ&_nc_oc=AdrLzRmz3jPXhBzrW47BY_DkC485agl-BtRLCcTUu7cKTUKdfIlHZC-iRKVUpY9JMVs&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNKxCstaECXcKVxM9GCUlrHt0nAE2O_wjcD012GuJoDWQ&oe=6AC7AC0C"}, {"file_name": "migrated_image.png", "id": "227586865025628", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/11162704_1440534279364325_3553473486204698624_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kZvONl7erCwQ7kNvwGmq410&_nc_oc=Adq3OOd4YorBa6QPyEPcVBs1GAIN1EOqgkEMMrCCXIw2oeLjpndpE7UOXBU-SXdWku4&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPPlCY33ikxxFC-Ehg8y7Ex83VEntYvqtvwY-DapKK9ow&oe=6AC7C6E2"}, {"file_name": "migrated_image.png", "id": "223793988733980", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/11162684_1918532331768953_3442552378077741056_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oSxdpr5MlRIQ7kNvwFkMf02&_nc_oc=AdoCLqVC1UlNMqEjQS3Sl1ruwy4v4kzxqBFC7hNXFOAtgjv5hF0tkl5p_OrNNvyFKjQ&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMH5ShO8wcI-kMkf052ukALI35CXyuKV_a3kLJsQ7ad-g&oe=6AC7A7CA"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Treasure Hunter VR", "keywords": ["puzzle", "arcade", "egypt", "light", "adventure"], "long_description": "Plunge into  the atmosphere of ancient Egypt. Help young Jane  explore lost in the sands ancient temple, full of crafty traps  and find all the hidden treasures of the Pharaoh.\n \nTreasure Hunter VR -This is an atmospheric spatial puzzle based on the physics of light. The game was designed for a long immersive experience in virtual reality. We set ourselves the task to create not only unique mechanics of the game, but also to extend the average player session in VR.\n \n\n- 12 unique levels\n- Immersive atmospheric experience\n- Detailed Ancient Egyptian temple\n- Interesting puzzles\n- Comfort control created specifically for Gear VR", "short_descr
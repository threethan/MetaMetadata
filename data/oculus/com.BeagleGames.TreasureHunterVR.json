4_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=38YD2ZFcgDEQ7kNvwGROY_z&_nc_oc=Adoc5q_t7gnI5lRr0TTtfLjjdM0--Ap6-U2VJ4To0F_WF_DSLYyqZ9fhYWOhgn79VT8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ8fZugAqfU19dY4NTnkqGMGLqGPmXBVRLgaQKr0MaujQ&oe=6A99878C"}, {"file_name": "migrated_image.png", "id": "227586865025628", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/11162704_1440534279364325_3553473486204698624_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oRhG-539tucQ7kNvwGOA6zu&_nc_oc=Adpk6ttKpyt9fToGIH23lNfHnkLNu6lZmr0-R6asZ96sYwwKIAGuoGWZCdK6FK2mwRw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJzdezpZ06-K1qzx7JEtiofI9muHJ1CxSqXbXq2sBl3Jw&oe=6A99A262"}, {"file_name": "migrated_image.png", "id": "223793988733980", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/11162684_1918532331768953_3442552378077741056_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=974fuNvzQu8Q7kNvwEJAthw&_nc_oc=AdrCoENziQhnh-ct8Y7xfBP_4vqMiJiF2hH4e_ioDU17x99HcKKhdk_VDZ_OohN3tyE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJoaJ_8H_B1vVhtDsXupI46-nvvKTg2hNekqi7G_3PFcw&oe=6A99834A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Treasure Hunter VR", "keywords": ["puzzle", "arcade", "egypt", "light", "adventure"], "long_description": "Plunge into  the atmosphere of ancient Egypt. Help young Jane  explore lost in the sands ancient temple, full of crafty traps  and find all the hidden treasures of the Pharaoh.\n \nTreasure Hunter VR -This is an atmospheric spatial puzzle based on the physics of light. The game was designed for a long immersive experience in virtual reality. We set ourselves the task to create not only unique mechanics of the game, but also to extend the average player session in VR.\n \n\n- 12 unique levels\n- Immersive atmospheric experience\n- Detailed Ancient Egyptian temple\n- Interesting puzzles\n- Comfort control created specifically for Gear VR", "short_descr
4_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6i3QGlSVqoIQ7kNvwE0AiPe&_nc_oc=Adp1N71Pfm3XwLKXFCSIbN_URSaf-enG0sAZ4ZUAtEaSXnC31QyVVVbG5lrBYIoRIyQ&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5LFE1wU4xbNapw-A6ZDUjwWSwg8LHhRbCRJcBg56KGiQ&oe=6A203D8C"}, {"file_name": "migrated_image.png", "id": "227586865025628", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/11162704_1440534279364325_3553473486204698624_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hvKWbyZfK-QQ7kNvwH_9oKI&_nc_oc=Ado4pvMRASj-9PVGJcV_zPkcO0ETQmCOiEJEinK06ipuDNIFKorzAth2BNIsQS-xo_I&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af76sgmVz8NU5p7dBKnK9E7-QUGwqo6n84I0LKkLABlXMA&oe=6A202022"}, {"file_name": "migrated_image.png", "id": "223793988733980", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/11162684_1918532331768953_3442552378077741056_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ze4uc8gsYkEQ7kNvwGinD1W&_nc_oc=Ado4HhFdNBvNX_ncfMYBDyunxrcp6GCdyD-o3V1DWKbIH0OA_-IOaJQuV7NZaHowJ6Y&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7nSI5nR1GtD0_xNMjUA1DplVxFah9ciV2cwqYdzwRoDQ&oe=6A20394A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Treasure Hunter VR", "keywords": ["puzzle", "arcade", "egypt", "light", "adventure"], "long_description": "Plunge into  the atmosphere of ancient Egypt. Help young Jane  explore lost in the sands ancient temple, full of crafty traps  and find all the hidden treasures of the Pharaoh.\n \nTreasure Hunter VR -This is an atmospheric spatial puzzle based on the physics of light. The game was designed for a long immersive experience in virtual reality. We set ourselves the task to create not only unique mechanics of the game, but also to extend the average player session in VR.\n \n\n- 12 unique levels\n- Immersive atmospheric experience\n- Detailed Ancient Egyptian temple\n- Interesting puzzles\n- Comfort control created specifically for Gear VR", "short_descr
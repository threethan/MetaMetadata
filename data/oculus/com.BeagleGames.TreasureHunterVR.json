f&oh=00_AQTKAyvQ02x494PJF6uqmfFkJDAh3mFYHpkQ-j6KMK7B-w&oe=6B0B2EA5"}, {"file_name": "migrated_image.png", "id": "519359865390619", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/11162693_178342762711392_7188359649463107584_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UfmVWA99H_IQ7kNvwHvcVdK&_nc_oc=AdpqUPAx4nTcGuPVFFud7sBJmCYRJN_6MSIKraRH2kA1bTbiHLVYSJ7oLQGSzxQUoE4&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTLnDayxcowpsjLvQcbw5-BKSo81QL6P98_wRcyHob_RA&oe=6B0B20CC"}, {"file_name": "migrated_image.png", "id": "227586865025628", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/11162704_1440534279364325_3553473486204698624_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7t9dmyZHsZ4Q7kNvwGakDcR&_nc_oc=AdrsBNSZac_PteVmz5mcsoaruEjGRwkj26kYH6g3PRupjMwXNW-RfZx4tqNwBLv8dkQ&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQT7x9dgGdX_9BfEJR68CBOpn-pBxfJ_H-CS56wPfOFB4A&oe=6B0B3BA2"}, {"file_name": "migrated_image.png", "id": "223793988733980", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/11162684_1918532331768953_3442552378077741056_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZrshPUdvKwEQ7kNvwGwBrxp&_nc_oc=AdoGO9A1b7FKUADz8Vq4fuVlPP47qDFK4JqKpPaIGi1GB2GCmLZps9z4yYOtG9y4xwo&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQR9V4mfEAJ4o8eAAj8FvmWsnp-LpiScfD5SlOI3Me9w3w&oe=6B0B1C8A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Treasure Hunter VR", "keywords": ["puzzle", "arcade", "egypt", "light", "adventure"], "long_description": "Plunge into  the atmosphere of ancient Egypt. Help young Jane  explore lost in the sands ancient temple, full of crafty traps  and find all the hidden treasures of the Pharaoh.\n \nTreasure Hunter VR -This is an atmospheric spatial puzzle based on the physics of light. The game was designed for a long immersive experience in virtual reality. We set ourselves the task to create not only unique mechanics of the game, but also to extend the average player session in VR.\n \n\n- 12 unique levels\n- Immersive atmospheric experience\n- Detailed Ancient Egyptian temple\n- Interesting puzzles\n- Comfort control created specifically for Gear VR", "short_description": "Plunge into  the atmosphere of ancient Egypt. Help young Jane  explore lost in the sands ancient temple, full of crafty traps  and find all the hidden treasures of the Pharaoh."}]}, "developer_name": null, "developer_privacy_policy_url": "http://beaglegames.com/privacy-policy/", "developer_terms_of_service_url": "http://beaglegames.com/privacy-policy/", "publisher_name": "Beagle Games", "support_website_url": null, "website_url": "http://beaglegames.com/games/treasurehuntervr/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ADVENTURE", "CASUAL", "EDUCATIONAL", "PUZZLE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "628128321824755"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/11162698_1885979984988832_6272463104861274112_n.png?stp=dst-png_s360x360&_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lBKKdZotG-gQ7kNvwGBM5Yk&_nc_oc=AdrepHmLp6UOBjbzIqMVySp33-p9EqNy-UiincSLhcP3NA0G-WgQLjUA6J--k_4uXkY&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRHJMR973K93-Olyiv0wAcGb5pntQIheyTC2ygXPGc2DA&oe=6B0B2FDA"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Treasure Hunter VR", "platform
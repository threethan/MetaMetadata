4_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cwGvyNwp9ZUQ7kNvwFhBd-A&_nc_oc=Adr4S8jbBxZmLy00sA9nT6_q_rtK27EEIHQO1HC7aFgLBF8M8791Rbu3uhV5W3UOhvU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMFme0r58PwVBp8Rnk0NKmYcvHaicUSk3kNdFdMTGBBiw&oe=6ADF670C"}, {"file_name": "migrated_image.png", "id": "227586865025628", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/11162704_1440534279364325_3553473486204698624_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wy5VQwop68UQ7kNvwFrnQxK&_nc_oc=AdpE7D2JuW9vSYyZUMGlJqF6iKnx0cYaqWlx4SSbOrrmvlXyOc6amF-Xkc-yyuTu42A&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO172gSTvQeYJudHmuXBYV5XB6XAd8fX4i6G7O-V3VvaA&oe=6ADF49A2"}, {"file_name": "migrated_image.png", "id": "223793988733980", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/11162684_1918532331768953_3442552378077741056_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IWd5E6brNnoQ7kNvwGa1iqU&_nc_oc=Ado36tDjku6rsI_vkgkEelLjHi0_YynlezzffiEq3z-yoDEjMDCpHPoTcyNzTUBq4PE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNfiZSLh3y8_RiZzPHXBcpnJ-WCJbeSL0YRjB3FAOKI6w&oe=6ADF62CA"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Treasure Hunter VR", "keywords": ["puzzle", "arcade", "egypt", "light", "adventure"], "long_description": "Plunge into  the atmosphere of ancient Egypt. Help young Jane  explore lost in the sands ancient temple, full of crafty traps  and find all the hidden treasures of the Pharaoh.\n \nTreasure Hunter VR -This is an atmospheric spatial puzzle based on the physics of light. The game was designed for a long immersive experience in virtual reality. We set ourselves the task to create not only unique mechanics of the game, but also to extend the average player session in VR.\n \n\n- 12 unique levels\n- Immersive atmospheric experience\n- Detailed Ancient Egyptian temple\n- Interesting puzzles\n- Comfort control created specifically for Gear VR", "short_descr
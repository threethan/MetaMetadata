4_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qwIZeYhZM_oQ7kNvwHPVi2l&_nc_oc=AdpIj7EqZzGLLddC-uStdcH9Db-Ttu1VWNjQOpQwnLJ2LzlEw042Sq7LdFoQMUKF1lA&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4wPUULlCuBbasQhVk7Phv3CvY2nPY9rWSzDSQz2vxJ6Q&oe=6A0C770C"}, {"file_name": "migrated_image.png", "id": "227586865025628", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/11162704_1440534279364325_3553473486204698624_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3vP9bjEc1q8Q7kNvwE8Ekxn&_nc_oc=AdqLGrwGsrFiZk_a-RMUc7ejt6SB0j5aSiuwA0HFr0z7OK3TslGxz15iTesjpLcnIU0&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6T8qQ5pOmv8TLaP7RL_75mrY6ClqegjbAiJPwx6OGI1w&oe=6A0C59A2"}, {"file_name": "migrated_image.png", "id": "223793988733980", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/11162684_1918532331768953_3442552378077741056_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ofh2yt9lMRkQ7kNvwHJeY2H&_nc_oc=AdrnJG21z0erA5pcX8PjOinpFrmF6lg-nY41p0aEam-wo0XtfHSL5_eK5UhGGMOlMPM&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5-02-R0GloUQRTMOvkuzzJc0TmXO7rqGYGDy07PuwDEA&oe=6A0C72CA"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Treasure Hunter VR", "keywords": ["puzzle", "arcade", "egypt", "light", "adventure"], "long_description": "Plunge into  the atmosphere of ancient Egypt. Help young Jane  explore lost in the sands ancient temple, full of crafty traps  and find all the hidden treasures of the Pharaoh.\n \nTreasure Hunter VR -This is an atmospheric spatial puzzle based on the physics of light. The game was designed for a long immersive experience in virtual reality. We set ourselves the task to create not only unique mechanics of the game, but also to extend the average player session in VR.\n \n\n- 12 unique levels\n- Immersive atmospheric experience\n- Detailed Ancient Egyptian temple\n- Interesting puzzles\n- Comfort control created specifically for Gear VR", "short_descr
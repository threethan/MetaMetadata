63512652300288_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PcWcIow-ouIQ7kNvwFJ9BIn&_nc_oc=AdrOV4cCERaIQ2MM_QJCySw1n2-B6CasYa0SW5hsX7BFiiS1u9NMRFteQ5e8tRsUl08&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMw_qdNxf-zZ6ybPyt3NLJ5z7i3mE1wuiYuRpXLcFrC4A&oe=6AE5F522"}, "display_name": "Treasure Hunter VR", "keywords": ["puzzle", "arcade", "egypt", "light", "adventure"], "long_description": "Plunge into  the atmosphere of ancient Egypt. Help young Jane  explore lost in the sands ancient temple, full of crafty traps  and find all the hidden treasures of the Pharaoh.\n \nTreasure Hunter VR -This is an atmospheric spatial puzzle based on the physics of light. The game was designed for a long immersive experience in virtual reality. We set ourselves the task to create not only unique mechanics of the game, but also to extend the average player session in VR.\n \n\n- 12 unique levels\n- Immersive atmospheric experience\n- Detailed Ancient Egyptian temple\n- Interesting puzzles\n- Comfort control created specifically for Gear VR", "short_description": "Plunge into  the atmosphere of ancient Egypt. Help young Jane  explore lost in the sands ancient temple, full of crafty traps  and find all the hidden treasures of the Pharaoh."}]}, "developer_name": null, "developer_privacy_policy_url": "http://beaglegames.com/privacy-policy/", "developer_terms_of_service_url": "http://beaglegames.com/privacy-policy/", "publisher_name": "Beagle Games", "support_website_url": null, "website_url": "http://beaglegames.com/games/treasurehuntervr/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ADVENTURE", "CASUAL", "PUZZLE", "EDUCATIONAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["e
4_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2I5guj40vRQQ7kNvwEm6Vrg&_nc_oc=AdrRMy96k4tJ2LdmZ-xFooaPSyh9XY68aBO7XQkfqk50Kv7PD6CB0roVbyPRbnD8HZ0&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1cPArsYl7P8QoCFEr11DpUuJuqK5ItXfUTHfVIcGetZQ&oe=69D3C68C"}, {"file_name": "migrated_image.png", "id": "227586865025628", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/11162704_1440534279364325_3553473486204698624_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Av4b7eoV86kQ7kNvwFMc4SN&_nc_oc=AdpNv25lzS2eaVDV1goE1HLjP_ltlhi0xGOH6gNU0f13iojsxH6H9_HcshCSkA5YZAE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2OkRmqcbm2QMEFPgEbJzdDYt6Wbj6EOUU8-LbG_WTyJw&oe=69D3A922"}, {"file_name": "migrated_image.png", "id": "223793988733980", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/11162684_1918532331768953_3442552378077741056_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VW4C4RL-NQIQ7kNvwG8p1iO&_nc_oc=Adp-1pBP42bQ9pDXDfk5xPnwyakDdE1dPENalkmAy_Jze5hT9tnZTGzYJ_d5VCMwpMQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2YDW5WQIM6j6qdCDjFn7VY91Q-_A3WQ2ZOxgAFUJ7iww&oe=69D3C24A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Treasure Hunter VR", "keywords": ["puzzle", "arcade", "egypt", "light", "adventure"], "long_description": "Plunge into  the atmosphere of ancient Egypt. Help young Jane  explore lost in the sands ancient temple, full of crafty traps  and find all the hidden treasures of the Pharaoh.\n \nTreasure Hunter VR -This is an atmospheric spatial puzzle based on the physics of light. The game was designed for a long immersive experience in virtual reality. We set ourselves the task to create not only unique mechanics of the game, but also to extend the average player session in VR.\n \n\n- 12 unique levels\n- Immersive atmospheric experience\n- Detailed Ancient Egyptian temple\n- Interesting puzzles\n- Comfort control created specifically for Gear VR", "short_descr
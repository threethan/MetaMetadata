4_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NN8OSQZSr9IQ7kNvwHLO2Ik&_nc_oc=AdowZ2KjMLMrmhSODHkf0xMR1EVdDHr2uunrLx3ELx7-3ZnqoMvwzOIQ1u5yFdHu6WU&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAtgYrYRJNDu7rG-9Teqw1t0MxMwWQbxB1QWZUz0J9DVw&oe=6A5CE28C"}, {"file_name": "migrated_image.png", "id": "227586865025628", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/11162704_1440534279364325_3553473486204698624_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NeSVQnyu2REQ7kNvwFm8C3k&_nc_oc=AdpiqYKL5C0TuZza958sBY4xjh19fBJXh8lPIw8BukRHm0NUQP3bAi6JEj3WO_Ik8G4&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB2xYgF69LpFG_p8VVmk1mQ6zphtkJBVziO4ud2eJ24pw&oe=6A5CC522"}, {"file_name": "migrated_image.png", "id": "223793988733980", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/11162684_1918532331768953_3442552378077741056_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m_4xD3IpDKEQ7kNvwHiySvK&_nc_oc=AdoMSVTWeZHdKr36fAFpCJxL5fugjmlONtPuPdvwrkC4fRy4p9gy55rpDA4PUwfexUA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCXghtgfyW9MlhK35aFCxu6KQaq0gCPr9k93gZHyfG2MQ&oe=6A5CDE4A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Treasure Hunter VR", "keywords": ["puzzle", "arcade", "egypt", "light", "adventure"], "long_description": "Plunge into  the atmosphere of ancient Egypt. Help young Jane  explore lost in the sands ancient temple, full of crafty traps  and find all the hidden treasures of the Pharaoh.\n \nTreasure Hunter VR -This is an atmospheric spatial puzzle based on the physics of light. The game was designed for a long immersive experience in virtual reality. We set ourselves the task to create not only unique mechanics of the game, but also to extend the average player session in VR.\n \n\n- 12 unique levels\n- Immersive atmospheric experience\n- Detailed Ancient Egyptian temple\n- Interesting puzzles\n- Comfort control created specifically for Gear VR", "short_descr
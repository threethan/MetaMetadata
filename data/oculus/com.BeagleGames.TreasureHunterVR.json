f&oh=00_AQSccMCa7oWgoDSKjk1gl02XHJgepUlokW8FV3VpEVCk4A&oe=6AFB2465"}, {"file_name": "migrated_image.png", "id": "519359865390619", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/11162693_178342762711392_7188359649463107584_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gk-SDXB-tj0Q7kNvwFgiGoT&_nc_oc=Adqb2tUa0i81dh8eHLPBkz4Jy8eoSziGbkGRw4pfYkQVeI25VeL_YVJdfH09QeNao38&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ9ri8ZdZ6rN058iymJO67doXUFwqSj4qbkqaVnChl1bg&oe=6AFB168C"}, {"file_name": "migrated_image.png", "id": "227586865025628", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/11162704_1440534279364325_3553473486204698624_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1cE_rHUVrBIQ7kNvwH7frgi&_nc_oc=AdrmRHXiEyA6hex67IQV2GdmeQOgVYkBjeV_8kdvuL0nD9En8RkOzb_dZ1BD6qAUVdg&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR7hKUc6HWK2Mrn-lOL0HKKwRSYQjy10iLfmgHsyPFKQg&oe=6AFB3162"}, {"file_name": "migrated_image.png", "id": "223793988733980", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/11162684_1918532331768953_3442552378077741056_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q6xg4GotuEcQ7kNvwFhSMb-&_nc_oc=Adq-6AWFGbh-cxhGbc8z1zKGc-sks-nQX-1YVN-yStMen_aUcdmRjKthE_IYRDOWZ94&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTAlbogSU10F5c47hQmREy0GzJgnOSML-5OoPt2YLoKXw&oe=6AFB4A8A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Treasure Hunter VR", "keywords": ["puzzle", "arcade", "egypt", "light", "adventure"], "long_description": "Plunge into  the atmosphere of ancient Egypt. Help young Jane  explore lost in the sands ancient temple, full of crafty traps  and find all the hidden treasures of the Pharaoh.\n \nTreasure Hunter VR -This is an atmospheric spatial puzzle based on the physics of light. The game was designed for a long immersive experience in virtual reality. We set ourselves the task to create not only unique mechanics of the game, but also to extend the average player session in VR.\n \n\n- 12 unique levels\n- Immersive atmospheric experience\n- Detailed Ancient Egyptian temple\n- Interesting puzzles\n- Comfort control created specifically for Gear VR", "short_description": "Plunge into  the atmosphere of ancient Egypt. Help young Jane  explore lost in the sands ancient temple, full of crafty traps  and find all the hidden treasures of the Pharaoh."}]}, "developer_name": null, "developer_privacy_policy_url": "http://beaglegames.com/privacy-policy/", "developer_terms_of_service_url": "http://beaglegames.com/privacy-policy/", "publisher_name": "Beagle Games", "support_website_url": null, "website_url": "http://beaglegames.com/games/treasurehuntervr/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ADVENTURE", "CASUAL", "EDUCATIONAL", "PUZZLE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "628128321824755"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/11162698_1885979984988832_6272463104861274112_n.png?stp=dst-png_s360x360&_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yruKX6LgsYYQ7kNvwHHLt0n&_nc_oc=AdqiVgJYz986NvM80hUbLttLpKC012fxEwxniPxmvOApFKWtpJosFxMawVkDLddNDJM&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQx4Fo83tTPQjSZKkeJMBR46madpshh7r5JhE_whfpsDw&oe=6AFB259A"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Treasure Hunter VR", "platform
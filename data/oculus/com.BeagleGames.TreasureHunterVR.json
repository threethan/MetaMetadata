4_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nkmc8E7GU3QQ7kNvwE-TUYa&_nc_oc=Ado-z4m5fQkM5nXU7Ti9f9mffty56495mcCpadHGmwzHcIbWxRGuSK_nm6yhodrnbfY&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEb_7hXluGD6cauHDxUFyWQ1OJhyrhUexXsy84Xt6eI9A&oe=6A84374C"}, {"file_name": "migrated_image.png", "id": "227586865025628", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/11162704_1440534279364325_3553473486204698624_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cybrW45H8hkQ7kNvwEs4kq7&_nc_oc=AdqXpOK_Pw5RnxLnA3JFC7NVsehkjmfCUZr8DiP22ahblZE5Yd7gwxCCnpGlbYu7fHs&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEkLmA5eHYNYudO2Bmlaa-tfc-q6XQLGlhJvbIK8rnDag&oe=6A845222"}, {"file_name": "migrated_image.png", "id": "223793988733980", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/11162684_1918532331768953_3442552378077741056_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5K2U-vTjlGwQ7kNvwEUjDWi&_nc_oc=AdqxE_uHltnkBGoWwKmpen9zE8hqpgWaOKS36qFyv1Fyx35pfFhQk8RZiPjLxqjEKIk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEdds0jhy3XY3GFVHG7Xgha9bIlqLNn5vfkS5lF47xeHw&oe=6A84330A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Treasure Hunter VR", "keywords": ["puzzle", "arcade", "egypt", "light", "adventure"], "long_description": "Plunge into  the atmosphere of ancient Egypt. Help young Jane  explore lost in the sands ancient temple, full of crafty traps  and find all the hidden treasures of the Pharaoh.\n \nTreasure Hunter VR -This is an atmospheric spatial puzzle based on the physics of light. The game was designed for a long immersive experience in virtual reality. We set ourselves the task to create not only unique mechanics of the game, but also to extend the average player session in VR.\n \n\n- 12 unique levels\n- Immersive atmospheric experience\n- Detailed Ancient Egyptian temple\n- Interesting puzzles\n- Comfort control created specifically for Gear VR", "short_descr
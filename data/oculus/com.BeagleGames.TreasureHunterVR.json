4_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0ggmadaz3psQ7kNvwFeip2v&_nc_oc=AdrTW79ZmpWG_OipE0p5E9rcewSHgjnz0faZtZ2Syj-KzC_prif-WIoHe1bZs5auHes&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB6e_2dciVbq6Nd2J-xofi3xZRSyInxW-gsRWzvnlcg8Q&oe=6A60D70C"}, {"file_name": "migrated_image.png", "id": "227586865025628", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/11162704_1440534279364325_3553473486204698624_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=28yORdCj9fIQ7kNvwFA2uBM&_nc_oc=AdpdQdiHhqy6xtEXpJy7e4prTRmbcgml4iwvkCo5UXmMjy-zfZvP5d0bprOwXCRqJgs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCtFDtFazz4Etm4KNd8lbiC9S4j31jQSJMKlftqSIlYxA&oe=6A60B9A2"}, {"file_name": "migrated_image.png", "id": "223793988733980", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/11162684_1918532331768953_3442552378077741056_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HfwWPzALg4IQ7kNvwHtTrth&_nc_oc=AdrIX1Qg4ABRZBLOjpQJdrTwlpMMt7zljlc74QgL-1Nph4PqfZzT0wB713gAcyUq0Kk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBpraJyAb5W1hoMoP0287mmN6PXeKDRY1iVit68gMIn8Q&oe=6A60D2CA"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Treasure Hunter VR", "keywords": ["puzzle", "arcade", "egypt", "light", "adventure"], "long_description": "Plunge into  the atmosphere of ancient Egypt. Help young Jane  explore lost in the sands ancient temple, full of crafty traps  and find all the hidden treasures of the Pharaoh.\n \nTreasure Hunter VR -This is an atmospheric spatial puzzle based on the physics of light. The game was designed for a long immersive experience in virtual reality. We set ourselves the task to create not only unique mechanics of the game, but also to extend the average player session in VR.\n \n\n- 12 unique levels\n- Immersive atmospheric experience\n- Detailed Ancient Egyptian temple\n- Interesting puzzles\n- Comfort control created specifically for Gear VR", "short_descr
4_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mVRjdzPP8cUQ7kNvwEgJ4Ts&_nc_oc=Ado3ivu-CBkSM0sBd7ZOgJu9Sy9ZXM38SoJk-I-QJ-RudtT-DjM2VH6Er0RKtB9X22I&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJhO85rfEi65__ZD_QYyd2Lm7JZs5YHxe3eJvXUplPWUw&oe=6AABFC8C"}, {"file_name": "migrated_image.png", "id": "227586865025628", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/11162704_1440534279364325_3553473486204698624_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vhzixt5ravcQ7kNvwGO0oe1&_nc_oc=AdpqBmG3KB0BUhRGW4lbSaolyZPqHgTZO7iXq_N0aPyBH0fVTFOnD3PLkf5jqzYMn0o&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLQQcGtw789WwekjPw8wIw3nB0W8n64hGiltDadV8jfNw&oe=6AABDF22"}, {"file_name": "migrated_image.png", "id": "223793988733980", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/11162684_1918532331768953_3442552378077741056_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rNqnNVRMEGMQ7kNvwG3b-Dc&_nc_oc=Adr9sx-SdPZSumHXUAO2v45czBZ7HQhmsTGdeDzYH-0GUzkdBFVlUu6jjItq243zGZA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLRihM1ms7N5SIFsevM8eP_YxEuzLuY8TCXSxnGRoz6yg&oe=6AABF84A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Treasure Hunter VR", "keywords": ["puzzle", "arcade", "egypt", "light", "adventure"], "long_description": "Plunge into  the atmosphere of ancient Egypt. Help young Jane  explore lost in the sands ancient temple, full of crafty traps  and find all the hidden treasures of the Pharaoh.\n \nTreasure Hunter VR -This is an atmospheric spatial puzzle based on the physics of light. The game was designed for a long immersive experience in virtual reality. We set ourselves the task to create not only unique mechanics of the game, but also to extend the average player session in VR.\n \n\n- 12 unique levels\n- Immersive atmospheric experience\n- Detailed Ancient Egyptian temple\n- Interesting puzzles\n- Comfort control created specifically for Gear VR", "short_descr
4_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6BhvtLv6Nm4Q7kNvwEDwv0n&_nc_oc=AdqzGjrG3bJWMUuB61X5XuLGVUvkD6HALmd5ZDBkKfQOEcIqyMFJAHVrVJ4fBmrUOGc&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJDvt6x4Yrs9IdruOgTWIHAuUOlQnDzAs3a16VA_c6rYw&oe=6ABE718C"}, {"file_name": "migrated_image.png", "id": "227586865025628", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/11162704_1440534279364325_3553473486204698624_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L8SK0DNUZ8MQ7kNvwHkHtyE&_nc_oc=Ado7N1-IIR9kwPu6Mnz4D81LVdZD5oZdOZvU6TVzy5VAWUCPEkwJ6g35_aEjhS9tN-s&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLv4jgfZIrnKR1BVIsy7rZIhycUfKWMIUftyBGOtyAKdQ&oe=6ABE8C62"}, {"file_name": "migrated_image.png", "id": "223793988733980", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/11162684_1918532331768953_3442552378077741056_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bzrZtjqMMCwQ7kNvwFc-5w7&_nc_oc=AdoxG7SHA34HvGX4i7JcoTiMMAoCxXFvSInolwXYSwQmzhSFt8yb6PN4WngLT5SzMpU&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLNn0CritQHnaAWkRy_U0Hi5PFu_MHLMMzR0qWpAiyGBQ&oe=6ABE6D4A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Treasure Hunter VR", "keywords": ["puzzle", "arcade", "egypt", "light", "adventure"], "long_description": "Plunge into  the atmosphere of ancient Egypt. Help young Jane  explore lost in the sands ancient temple, full of crafty traps  and find all the hidden treasures of the Pharaoh.\n \nTreasure Hunter VR -This is an atmospheric spatial puzzle based on the physics of light. The game was designed for a long immersive experience in virtual reality. We set ourselves the task to create not only unique mechanics of the game, but also to extend the average player session in VR.\n \n\n- 12 unique levels\n- Immersive atmospheric experience\n- Detailed Ancient Egyptian temple\n- Interesting puzzles\n- Comfort control created specifically for Gear VR", "short_descr
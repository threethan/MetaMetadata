4_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oDDMl8oTQx0Q7kNvwGsTKXq&_nc_oc=Adq_OOb-kpq16G0FRTOsIskA6S4BKWdXDLzChGJGE9UvCb4lpehyZkOATPWHWKkuyEs&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKMydKWkj4oVIuyIjyAxjULahcVJ4aNzjqiXqzXMVEMsA&oe=6AB2940C"}, {"file_name": "migrated_image.png", "id": "227586865025628", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/11162704_1440534279364325_3553473486204698624_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o__YokVtH8gQ7kNvwHJpDkh&_nc_oc=AdoZv5OrFaSzjk4idtAdHI4VSH3ePnjYi1cxCBAUw4t9W49h10xLxkPzmf_CuhmS5kA&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLsxYq_Z1Ja4CG93bkGh9gf02PrFp4SDXdeVNksRgR8Iw&oe=6AB276A2"}, {"file_name": "migrated_image.png", "id": "223793988733980", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/11162684_1918532331768953_3442552378077741056_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VSGveYDeamIQ7kNvwFABfov&_nc_oc=AdrcfSJHRdxxzM_F-cyo3nGF9ax5VwoZWXys59hgnT4opydO9C7Xj4AqG9TwbvRWV9Y&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJJQq4xbCOzVa9uOpY_LD2kYhYj-dhThacBohSJ25NmVg&oe=6AB28FCA"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Treasure Hunter VR", "keywords": ["puzzle", "arcade", "egypt", "light", "adventure"], "long_description": "Plunge into  the atmosphere of ancient Egypt. Help young Jane  explore lost in the sands ancient temple, full of crafty traps  and find all the hidden treasures of the Pharaoh.\n \nTreasure Hunter VR -This is an atmospheric spatial puzzle based on the physics of light. The game was designed for a long immersive experience in virtual reality. We set ourselves the task to create not only unique mechanics of the game, but also to extend the average player session in VR.\n \n\n- 12 unique levels\n- Immersive atmospheric experience\n- Detailed Ancient Egyptian temple\n- Interesting puzzles\n- Comfort control created specifically for Gear VR", "short_descr
f&oh=00_AQTGLjgy0eIkdCmEVk7fh_55XaDl4pnoB1vGM1p5s7PKHA&oe=6B09A4E5"}, {"file_name": "migrated_image.png", "id": "519359865390619", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/11162693_178342762711392_7188359649463107584_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6J68LSln5DkQ7kNvwHW9HME&_nc_oc=AdoafjtJ9s3eMO0GXsqODjNptwIU7JWM49p-PWYFbFXDeeehkLDY6c8HPyMz__jAh-E&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSHNPibPFHGcJVqs0zSgGt8elyZjbrwT0-EYOVTBXyNFg&oe=6B09CF4C"}, {"file_name": "migrated_image.png", "id": "227586865025628", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/11162704_1440534279364325_3553473486204698624_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7t9dmyZHsZ4Q7kNvwFhyToq&_nc_oc=AdqQujA4LYRDEQIZ3S_4Pgm1NDaOQ4pxEPKpWlNUc3KSom6IrB6g_UJSbBt42FAOiJE&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQReoXsl5lZeNa90Uh4RlXJTPXMY3x_gQF-QrSs245L0vw&oe=6B09B1E2"}, {"file_name": "migrated_image.png", "id": "223793988733980", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/11162684_1918532331768953_3442552378077741056_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-Mo6DyXx7yUQ7kNvwEPPT2t&_nc_oc=Adpwls-W0kEA700aPI7xdxJH2LHq9yRpLmEY8-d5eH4HjSBubUdUVv_J4thKUvaIgxk&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRb17Q3X0V1T4LaIQMxJEMRhlv8_fMkhScrxtKZ4iJ1YA&oe=6B09CB0A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Treasure Hunter VR", "keywords": ["puzzle", "arcade", "egypt", "light", "adventure"], "long_description": "Plunge into  the atmosphere of ancient Egypt. Help young Jane  explore lost in the sands ancient temple, full of crafty traps  and find all the hidden treasures of the Pharaoh.\n \nTreasure Hunter VR -This is an atmospheric spatial puzzle based on the physics of light. The game was designed for a long immersive experience in virtual reality. We set ourselves the task to create not only unique mechanics of the game, but also to extend the average player session in VR.\n \n\n- 12 unique levels\n- Immersive atmospheric experience\n- Detailed Ancient Egyptian temple\n- Interesting puzzles\n- Comfort control created specifically for Gear VR", "short_description": "Plunge into  the atmosphere of ancient Egypt. Help young Jane  explore lost in the sands ancient temple, full of crafty traps  and find all the hidden treasures of the Pharaoh."}]}, "developer_name": null, "developer_privacy_policy_url": "http://beaglegames.com/privacy-policy/", "developer_terms_of_service_url": "http://beaglegames.com/privacy-policy/", "publisher_name": "Beagle Games", "support_website_url": null, "website_url": "http://beaglegames.com/games/treasurehuntervr/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ADVENTURE", "CASUAL", "EDUCATIONAL", "PUZZLE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "628128321824755"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/11162698_1885979984988832_6272463104861274112_n.png?stp=dst-png_s360x360&_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lBKKdZotG-gQ7kNvwEXtlS7&_nc_oc=AdrAe5Fwfae1Zo8jCuEFhUBrx-WTJz9bSwiYzP1nZdIyQ5WcOunm6Zch5Y6zxK6gnNA&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSQqtxoybm-ViW-3Djz308zZL-z-v7iEAqeOzmXVK3fHQ&oe=6B09A61A"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Treasure Hunter VR", "platform
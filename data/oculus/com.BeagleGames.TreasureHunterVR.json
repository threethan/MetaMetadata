4_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JXWZbY6LxNwQ7kNvwECFCc8&_nc_oc=AdrkJd8XCwf9_AiGbZJrHseKYYamW9xkaHoVGpFbBhjvXOJW89-FISMRSBojg6tM1hA&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0rjKFj_SjTJDFm4e8L0jGtoFCaDRQPkfws0etuMPDVlw&oe=69DD010C"}, {"file_name": "migrated_image.png", "id": "227586865025628", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/11162704_1440534279364325_3553473486204698624_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c4zVhhsK7vMQ7kNvwHzzZdd&_nc_oc=AdqlF_likQ3HW_uX34LLMWg2jMdsWKisWGVTNAZlaxHteedSvpyQax3b63QUdKmpNho&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af20_Lo7khj5fK6lVxdjlQ7F-j8UzRf6fQ7dy_lrunBNlw&oe=69DCE3A2"}, {"file_name": "migrated_image.png", "id": "223793988733980", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/11162684_1918532331768953_3442552378077741056_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=84MMfNTfxHEQ7kNvwHJ9zdl&_nc_oc=Ado2BZc8asaXj-n4DFkmD7AoL2MLtppz_y9KzeIZjRAOqi2aJH6urTfAkv1GxNAjI0I&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1T7urVe-zVIeO6IZfmtJgMVZmzMDQnvCyeT4-RDLKOew&oe=69DCFCCA"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Treasure Hunter VR", "keywords": ["puzzle", "arcade", "egypt", "light", "adventure"], "long_description": "Plunge into  the atmosphere of ancient Egypt. Help young Jane  explore lost in the sands ancient temple, full of crafty traps  and find all the hidden treasures of the Pharaoh.\n \nTreasure Hunter VR -This is an atmospheric spatial puzzle based on the physics of light. The game was designed for a long immersive experience in virtual reality. We set ourselves the task to create not only unique mechanics of the game, but also to extend the average player session in VR.\n \n\n- 12 unique levels\n- Immersive atmospheric experience\n- Detailed Ancient Egyptian temple\n- Interesting puzzles\n- Comfort control created specifically for Gear VR", "short_descr
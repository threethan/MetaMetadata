4_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wbfA9-03WNoQ7kNvwFB9jKe&_nc_oc=AdpxBXeC3lRZs2qt4vaQb4vOe_6OQwzHoE6HYhviYh0E7_x69CapK1utAKV2-ex835o&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGEDTaG5ApI5IT71Z520k_Rn7U6U_Bp_iwIx6l4TkTsDQ&oe=6A79E38C"}, {"file_name": "migrated_image.png", "id": "227586865025628", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/11162704_1440534279364325_3553473486204698624_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8BRiUgAVV0MQ7kNvwEk0JM7&_nc_oc=AdpC-qCz4Rht93ZpMXflG4YJ3EYv9jJOBHN77ahmuP5ee-TT6QTo6jp0UATgYnwEkic&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQElUdYFSa8MZ6lRFizS77thRR_A5pFFQt2vdxcrqocKew&oe=6A79C622"}, {"file_name": "migrated_image.png", "id": "223793988733980", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/11162684_1918532331768953_3442552378077741056_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KUd7YDmQfSMQ7kNvwGe3Q5P&_nc_oc=Adqd3SxjZqRcR47Qi8hI9gJXsF4vxnoQe7dWdm_QoM5WUQj0rARyR2hHX2-d1cIIO2I&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFYKktSnGlsaIYc-heLu8WrDV1oaI656bB-3c42kd3dgg&oe=6A79DF4A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Treasure Hunter VR", "keywords": ["puzzle", "arcade", "egypt", "light", "adventure"], "long_description": "Plunge into  the atmosphere of ancient Egypt. Help young Jane  explore lost in the sands ancient temple, full of crafty traps  and find all the hidden treasures of the Pharaoh.\n \nTreasure Hunter VR -This is an atmospheric spatial puzzle based on the physics of light. The game was designed for a long immersive experience in virtual reality. We set ourselves the task to create not only unique mechanics of the game, but also to extend the average player session in VR.\n \n\n- 12 unique levels\n- Immersive atmospheric experience\n- Detailed Ancient Egyptian temple\n- Interesting puzzles\n- Comfort control created specifically for Gear VR", "short_descr
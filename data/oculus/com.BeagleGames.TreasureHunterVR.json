4_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=38YD2ZFcgDEQ7kNvwHkSc19&_nc_oc=AdqL-iMrBVZhT0KZuBX5tfgwaqPbyPRj87lFuhVnuKZUWwlkXjNoj74km19RBg9KesU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIzi_eB1RifZLvYjKvwn9kS3E9y_GeYMAMDbgdcuwMiPw&oe=6A98360C"}, {"file_name": "migrated_image.png", "id": "227586865025628", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/11162704_1440534279364325_3553473486204698624_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=04MvdeQZzyMQ7kNvwFBcBeg&_nc_oc=AdqCnNhAwa7BadBQD0m4H4Pjt69XVmgNT2PiQqVptgC0iSDSvVFdd_bzGJqRyEusUh8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI9AzJbiXOD4K1GpwcXNslouL1sq4ovAt2gj5mXf2MF6Q&oe=6A9850E2"}, {"file_name": "migrated_image.png", "id": "223793988733980", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/11162684_1918532331768953_3442552378077741056_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=974fuNvzQu8Q7kNvwE7r1Rn&_nc_oc=AdphWZK0rzHUI4ZsTlzFT0qDZedj6wh-vfQyXXpaZT4PpayLZtNkSmFUujtG_SdtwV4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLwOK7O0GWsKsk6jE87T-nx9In8e3A3tHZEafvWSW023w&oe=6A986A0A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Treasure Hunter VR", "keywords": ["puzzle", "arcade", "egypt", "light", "adventure"], "long_description": "Plunge into  the atmosphere of ancient Egypt. Help young Jane  explore lost in the sands ancient temple, full of crafty traps  and find all the hidden treasures of the Pharaoh.\n \nTreasure Hunter VR -This is an atmospheric spatial puzzle based on the physics of light. The game was designed for a long immersive experience in virtual reality. We set ourselves the task to create not only unique mechanics of the game, but also to extend the average player session in VR.\n \n\n- 12 unique levels\n- Immersive atmospheric experience\n- Detailed Ancient Egyptian temple\n- Interesting puzzles\n- Comfort control created specifically for Gear VR", "short_descr
4_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lZBjercZQKMQ7kNvwHC6rAR&_nc_oc=AdqVVmVipfvdQuSupx51OsBiVusZQfgyVS5hSQHCaOXND6akB5khthMyFQVplJrikGc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af61wtTBrhXV8dNuTmUN_RnwkDFezAcNk8q9ycLb7_0VgA&oe=6A048E0C"}, {"file_name": "migrated_image.png", "id": "227586865025628", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/11162704_1440534279364325_3553473486204698624_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E0miVw-F5GUQ7kNvwGUDinf&_nc_oc=AdqKK2YhTLsjrkS27pOl80jJ8vOpGKNPL1DzWnNF1x5zFRvYEJeNzV9CJ4NXNYsgDfU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5fFRh7fS61BPAiVah-vN3VjQ8KYryNGRx-XS0LaNy-CQ&oe=6A0470A2"}, {"file_name": "migrated_image.png", "id": "223793988733980", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/11162684_1918532331768953_3442552378077741056_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bDNJZRRibz0Q7kNvwHlvAl4&_nc_oc=Ado49HNf2HkEKMSSFzkqg3NHA7Qg5brmuB7BsMdP5l9vnylAPu6Lm25Mg5SJGbbWeas&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7C2vWI9oP1wt_OHYvDaimBVxMSrEPrzaQQyQ7FNYAquQ&oe=6A0489CA"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Treasure Hunter VR", "keywords": ["puzzle", "arcade", "egypt", "light", "adventure"], "long_description": "Plunge into  the atmosphere of ancient Egypt. Help young Jane  explore lost in the sands ancient temple, full of crafty traps  and find all the hidden treasures of the Pharaoh.\n \nTreasure Hunter VR -This is an atmospheric spatial puzzle based on the physics of light. The game was designed for a long immersive experience in virtual reality. We set ourselves the task to create not only unique mechanics of the game, but also to extend the average player session in VR.\n \n\n- 12 unique levels\n- Immersive atmospheric experience\n- Detailed Ancient Egyptian temple\n- Interesting puzzles\n- Comfort control created specifically for Gear VR", "short_descr
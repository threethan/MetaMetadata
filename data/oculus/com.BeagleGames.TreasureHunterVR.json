4_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YOHX85c08C4Q7kNvwG9OtGn&_nc_oc=AdqViVVWzgCNAeV4zsKS8fUKnfwmNcgxWEahfeib7d_byJlT5T6E-fGie-0OZ962wnQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQCTE5ZadU_qMq2bWI069arxk0ABkJOZJ3R43VL7xVyZQ&oe=6AE7500C"}, {"file_name": "migrated_image.png", "id": "227586865025628", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/11162704_1440534279364325_3553473486204698624_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nTcg3ze0qYQQ7kNvwH0-P30&_nc_oc=Adp99ZH83Xj9zFie30r5Z5lgVGbGeI8TdG9SzDM25Mb8U-1J4Fntr0WIy1GnBYNWhwo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRQJhhK0539D0qq6cZPnhGDNA78qU4cHb9cwpsjVzqs9A&oe=6AE76AE2"}, {"file_name": "migrated_image.png", "id": "223793988733980", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/11162684_1918532331768953_3442552378077741056_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HUsvPEhrSmcQ7kNvwGZlN_S&_nc_oc=AdokjIfdpPDwgJcECFan0sz2Du_gOMFR6k4u7zEzJoATjwXfggDJaO2P-5SiCLvKXCo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTDWJh41B1aE9C9DrZNpJK2JfyZYIP0c5fLDI5EjvDvrQ&oe=6AE74BCA"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Treasure Hunter VR", "keywords": ["puzzle", "arcade", "egypt", "light", "adventure"], "long_description": "Plunge into  the atmosphere of ancient Egypt. Help young Jane  explore lost in the sands ancient temple, full of crafty traps  and find all the hidden treasures of the Pharaoh.\n \nTreasure Hunter VR -This is an atmospheric spatial puzzle based on the physics of light. The game was designed for a long immersive experience in virtual reality. We set ourselves the task to create not only unique mechanics of the game, but also to extend the average player session in VR.\n \n\n- 12 unique levels\n- Immersive atmospheric experience\n- Detailed Ancient Egyptian temple\n- Interesting puzzles\n- Comfort control created specifically for Gear VR", "short_descr
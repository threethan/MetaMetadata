4_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0ggmadaz3psQ7kNvwHUUbWG&_nc_oc=AdoJMALojQv2UJf6tgf6zg_9Ido0PQuVgnC6oXMvjhhaiXDWuZPdWMCF7vMf3z1FRJM&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCmqp9AWGFwxECp4pvQfaM1bJ7cuzEHJ1EeStEMZySGAg&oe=6A62288C"}, {"file_name": "migrated_image.png", "id": "227586865025628", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/11162704_1440534279364325_3553473486204698624_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=28yORdCj9fIQ7kNvwGuW934&_nc_oc=AdoMsxir0k34DEFgFuJuYN78QCMwyXD1gy2EUECwVPcqnvkJnwrgk99W4IrKU96N9pU&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDb0TIeSIxb0A_HvJ_XoUCBvYRa_7NwZ3dm4hj__cLT6A&oe=6A620B22"}, {"file_name": "migrated_image.png", "id": "223793988733980", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/11162684_1918532331768953_3442552378077741056_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HfwWPzALg4IQ7kNvwEt7v8O&_nc_oc=AdqaL3OclmwSyCJ4L3sdxT1Lw9HLhl0x9yKM1prRzCPIhA1D8fVatfauq9zLR-F2ims&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC-KQ-VujmXEqhbZoqtx6UzCeqRsdbbSWZ6zxnbcawVjQ&oe=6A62244A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Treasure Hunter VR", "keywords": ["puzzle", "arcade", "egypt", "light", "adventure"], "long_description": "Plunge into  the atmosphere of ancient Egypt. Help young Jane  explore lost in the sands ancient temple, full of crafty traps  and find all the hidden treasures of the Pharaoh.\n \nTreasure Hunter VR -This is an atmospheric spatial puzzle based on the physics of light. The game was designed for a long immersive experience in virtual reality. We set ourselves the task to create not only unique mechanics of the game, but also to extend the average player session in VR.\n \n\n- 12 unique levels\n- Immersive atmospheric experience\n- Detailed Ancient Egyptian temple\n- Interesting puzzles\n- Comfort control created specifically for Gear VR", "short_descr
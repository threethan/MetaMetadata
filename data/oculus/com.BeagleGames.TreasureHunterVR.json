f&oh=00_AQTV2nQBIT5oKQcqY4EF_bWSp3dUbdl5C1iC9cSbqRj0sw&oe=6B085365"}, {"file_name": "migrated_image.png", "id": "519359865390619", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/11162693_178342762711392_7188359649463107584_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6J68LSln5DkQ7kNvwEYnZJS&_nc_oc=AdoZbLyOhSTSuzOwHOSJi6k641fH-VOJu_kpaOfcyHCVYfGHMNVKkVnUMtifknNQQag&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRuJ3y1iwReRjIeEIGW2TFFHm2m838ZWwiLxNlm66x4mA&oe=6B08458C"}, {"file_name": "migrated_image.png", "id": "227586865025628", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/11162704_1440534279364325_3553473486204698624_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7t9dmyZHsZ4Q7kNvwETtGNl&_nc_oc=AdopW8yR9Mv_LDsVCl2EbQWR1gcho4v3Uxz8IeIYgqOFdWDz2D1fa4qW5K4z8lwls6Y&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR4Jk1FbA2qhSjPYPX3nBZWm_aeR4f6NVQxpUoXEo_cdw&oe=6B086062"}, {"file_name": "migrated_image.png", "id": "223793988733980", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/11162684_1918532331768953_3442552378077741056_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-Mo6DyXx7yUQ7kNvwHLySfe&_nc_oc=AdqJAjJEw8m6-GgKin_5vaKykMUlLwmc105uZhH3PR2SC5vvFc1P2R1zpoS-ztCSDF4&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSc5bbr_axUmawF5hcY5UDkxFTxLWoy1nQvsHoWzRIpTw&oe=6B08414A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Treasure Hunter VR", "keywords": ["puzzle", "arcade", "egypt", "light", "adventure"], "long_description": "Plunge into  the atmosphere of ancient Egypt. Help young Jane  explore lost in the sands ancient temple, full of crafty traps  and find all the hidden treasures of the Pharaoh.\n \nTreasure Hunter VR -This is an atmospheric spatial puzzle based on the physics of light. The game was designed for a long immersive experience in virtual reality. We set ourselves the task to create not only unique mechanics of the game, but also to extend the average player session in VR.\n \n\n- 12 unique levels\n- Immersive atmospheric experience\n- Detailed Ancient Egyptian temple\n- Interesting puzzles\n- Comfort control created specifically for Gear VR", "short_description": "Plunge into  the atmosphere of ancient Egypt. Help young Jane  explore lost in the sands ancient temple, full of crafty traps  and find all the hidden treasures of the Pharaoh."}]}, "developer_name": null, "developer_privacy_policy_url": "http://beaglegames.com/privacy-policy/", "developer_terms_of_service_url": "http://beaglegames.com/privacy-policy/", "publisher_name": "Beagle Games", "support_website_url": null, "website_url": "http://beaglegames.com/games/treasurehuntervr/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ADVENTURE", "CASUAL", "EDUCATIONAL", "PUZZLE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "628128321824755"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw5-3.oculuscdn.com/v/t64.5771-25/11162698_1885979984988832_6272463104861274112_n.png?stp=dst-png_s360x360&_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lBKKdZotG-gQ7kNvwG4x4Mc&_nc_oc=AdpsyrLiVimHlZw1DV0FtjZ-PRoeqjSRSiOSrS0NBLKUwdiiC_uUSSvBeGp-pMFc_sk&_nc_zt=3&_nc_ht=scontent-dfw5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQKOsMFlVbFWNJMFduGF1xr9uDtSetUqxZoG_JBPbBxeg&oe=6B08549A"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Treasure Hunter VR", "platform
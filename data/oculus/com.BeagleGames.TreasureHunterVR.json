4_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KlnXrFUsyQQQ7kNvwFXuaVw&_nc_oc=Adrm6u-gWTlOjhC_UGHzasR0iq0q8D9WEj5XO9b_Uewe3fuZhVlaNspvUcu5nbBQG3g&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1DX5LMXammwpzC2BQKOEbFN0hbOx14UlgX1Kx1_XRbDQ&oe=69E4EA0C"}, {"file_name": "migrated_image.png", "id": "227586865025628", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/11162704_1440534279364325_3553473486204698624_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KRPgST9U8DkQ7kNvwHo2zkn&_nc_oc=AdocNYxuFTSYSq1a4kzzxC9nH8Pr5b6aZY_k4Oh-vYYp1bfSRcjHSTNmeayLCK6FpP8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2NPIWUlwykmYeSlZjcrhBRB5mB1pfrGZ1JeZAEkqG_IA&oe=69E4CCA2"}, {"file_name": "migrated_image.png", "id": "223793988733980", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/11162684_1918532331768953_3442552378077741056_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aGkKBZ1GB8YQ7kNvwGjGXr4&_nc_oc=AdqOKEm1P9Xmcu8kjJDrrsmUCCMSyav59IDHw9V6_NiMyZixxvhfoPeNCO_SUqmArXc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1GIplQHoPbqWNPz31CuL3SMFR2uqN96-2upa_oI3gttw&oe=69E4E5CA"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Treasure Hunter VR", "keywords": ["puzzle", "arcade", "egypt", "light", "adventure"], "long_description": "Plunge into  the atmosphere of ancient Egypt. Help young Jane  explore lost in the sands ancient temple, full of crafty traps  and find all the hidden treasures of the Pharaoh.\n \nTreasure Hunter VR -This is an atmospheric spatial puzzle based on the physics of light. The game was designed for a long immersive experience in virtual reality. We set ourselves the task to create not only unique mechanics of the game, but also to extend the average player session in VR.\n \n\n- 12 unique levels\n- Immersive atmospheric experience\n- Detailed Ancient Egyptian temple\n- Interesting puzzles\n- Comfort control created specifically for Gear VR", "short_descr
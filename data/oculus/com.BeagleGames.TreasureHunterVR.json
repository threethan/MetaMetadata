4_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KlnXrFUsyQQQ7kNvwH1_GIK&_nc_oc=AdrADeVowjovKMnvZwAPblhsixAj-krc_EKrS_0_Xe_MsOqzKKSwNba-Z56G__2UBr0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0tMmMzDSdLYFYdEF5Y0HgECNa1I80CNhT-rGDqzfqKJQ&oe=69E3988C"}, {"file_name": "migrated_image.png", "id": "227586865025628", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/11162704_1440534279364325_3553473486204698624_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5qusc66lZGUQ7kNvwFxxcTg&_nc_oc=AdqogSRT_Ezkzcw4snrixcS4hgrPanegSSx9l55uni4wyh95wZry50KbHtd-g4uqlzw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0cHMj28Ja5Fl1EFnKMcAQYypYhpsIO6uR2xaR_kd5BsQ&oe=69E37B22"}, {"file_name": "migrated_image.png", "id": "223793988733980", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/11162684_1918532331768953_3442552378077741056_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aGkKBZ1GB8YQ7kNvwG9YZ0w&_nc_oc=AdqRuWYLHyj671mgtbFA_Mq1lFfmCkjty9_LEgMPf5w7Zzk-PK3htbosWm88IuW2h-k&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2eXxHWo0Tsz4hqET6bzot964LTsc6rK_bPQeO_q2I1dQ&oe=69E3944A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Treasure Hunter VR", "keywords": ["puzzle", "arcade", "egypt", "light", "adventure"], "long_description": "Plunge into  the atmosphere of ancient Egypt. Help young Jane  explore lost in the sands ancient temple, full of crafty traps  and find all the hidden treasures of the Pharaoh.\n \nTreasure Hunter VR -This is an atmospheric spatial puzzle based on the physics of light. The game was designed for a long immersive experience in virtual reality. We set ourselves the task to create not only unique mechanics of the game, but also to extend the average player session in VR.\n \n\n- 12 unique levels\n- Immersive atmospheric experience\n- Detailed Ancient Egyptian temple\n- Interesting puzzles\n- Comfort control created specifically for Gear VR", "short_descr
4_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JNQqtfowdx8Q7kNvwFecDxu&_nc_oc=AdrYik4zNeWM9gSpc6u5VB7pyVF-B1X-ftUPOTl4HUKzfmmvGmsGixLiK7jymqixltk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7TImdtf1Z9Tb2OWu4FTJiMdd2owGUFIJ-2XInybfhb6g&oe=69FCA50C"}, {"file_name": "migrated_image.png", "id": "227586865025628", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/11162704_1440534279364325_3553473486204698624_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GTwHGFJREe0Q7kNvwEtQBKa&_nc_oc=AdqN4T8VlUW0DIbSPzkUVRIHWDyNfHEnK8ci1IrWhp0QLjKJEAtmjcHLLKKEQHtO8OY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4nihQIyORUyFUhbt5TUJh5YG-RMFd_9qVFQpFe9FLy8A&oe=69FC87A2"}, {"file_name": "migrated_image.png", "id": "223793988733980", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/11162684_1918532331768953_3442552378077741056_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bgDMzQy8AqcQ7kNvwEhbO1H&_nc_oc=AdrhuzbIgA97hYzw2nPS26w5OtsJlsxGNNSZACGnNBP59wR3zrhA9KC1mNCIWaPimOQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7ODdiyIX3DqXSXkkfneUpFexSklEYm28DiztFv4_mqNg&oe=69FCA0CA"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Treasure Hunter VR", "keywords": ["puzzle", "arcade", "egypt", "light", "adventure"], "long_description": "Plunge into  the atmosphere of ancient Egypt. Help young Jane  explore lost in the sands ancient temple, full of crafty traps  and find all the hidden treasures of the Pharaoh.\n \nTreasure Hunter VR -This is an atmospheric spatial puzzle based on the physics of light. The game was designed for a long immersive experience in virtual reality. We set ourselves the task to create not only unique mechanics of the game, but also to extend the average player session in VR.\n \n\n- 12 unique levels\n- Immersive atmospheric experience\n- Detailed Ancient Egyptian temple\n- Interesting puzzles\n- Comfort control created specifically for Gear VR", "short_descr
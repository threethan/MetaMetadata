4_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h6NgqH2wG7IQ7kNvwGNbImh&_nc_oc=AdroV-lS03wPVWHvlcT1QcvFuqHVagc5m9jNecLOXwUs_egMTgCBKHf1zp7vsR2hfNY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8XLrhrNfecpTbAecUfQwZYIGu7EnE7MOE1VGpwZEpPLQ&oe=6A47CA8C"}, {"file_name": "migrated_image.png", "id": "227586865025628", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/11162704_1440534279364325_3553473486204698624_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PsyhEcbZyVUQ7kNvwFNrwmy&_nc_oc=AdoikXZCSeeM1_VhLgDVmclOO9CuZJl2ZnEQuIDVu13NBvULLzU7JIWxD3_sg2rPNGw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-VBFevj6HO-0t4NsKiBZAWChBdg_UBDbBNRvbnEy5iWA&oe=6A47AD22"}, {"file_name": "migrated_image.png", "id": "223793988733980", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/11162684_1918532331768953_3442552378077741056_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DSgppF94-qgQ7kNvwER4fnx&_nc_oc=AdpBLZfW3qwjWX1pLJtfJh8f_a_G5q7LiK2Q9miusU5reZretvWw39ZE-1wV_MCqPIU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-xJXoSa3GbWaKPXyYwpv-YQdu1EHvWk81phjenGJImQg&oe=6A47C64A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Treasure Hunter VR", "keywords": ["puzzle", "arcade", "egypt", "light", "adventure"], "long_description": "Plunge into  the atmosphere of ancient Egypt. Help young Jane  explore lost in the sands ancient temple, full of crafty traps  and find all the hidden treasures of the Pharaoh.\n \nTreasure Hunter VR -This is an atmospheric spatial puzzle based on the physics of light. The game was designed for a long immersive experience in virtual reality. We set ourselves the task to create not only unique mechanics of the game, but also to extend the average player session in VR.\n \n\n- 12 unique levels\n- Immersive atmospheric experience\n- Detailed Ancient Egyptian temple\n- Interesting puzzles\n- Comfort control created specifically for Gear VR", "short_descr
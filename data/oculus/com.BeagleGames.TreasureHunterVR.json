4_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N16at8DFbsQQ7kNvwFJO-U_&_nc_oc=Adpb94j5UXwa_CYYYWbwhbNXUd10ACNPVt-FBDuBc5WqVrQzyxG1ygg1Zhh9WO_J5wI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIh2Dc6sldgWe88xP6diZ5JDnDnIy0CNnmVc0B8ny4LKA&oe=6AB92B8C"}, {"file_name": "migrated_image.png", "id": "227586865025628", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/11162704_1440534279364325_3553473486204698624_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1BKrwPOtKTgQ7kNvwEFknA2&_nc_oc=AdrcXx28XuFaIaTGLEXWyVzscJJr-E2kOAkx7YVOBEVDvsiqMiCwmQXTn1ni2ggFlP8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK_lp_wwvRQPb0UVK0pcvoJDDzadq0HNEk-7d6MsEbUPg&oe=6AB90E22"}, {"file_name": "migrated_image.png", "id": "223793988733980", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/11162684_1918532331768953_3442552378077741056_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SXBKBFWxf2EQ7kNvwGDiZ-O&_nc_oc=Adpe4E-WzctTKt8ywUlpq8MHnIBnYsrAIzKGh7spmLGzOFNkC2EZVlyAtcQCL6BK4WE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJag9ebNSsBGqMntLGEugZVh0r3H9qHJRkx7y68TROvvA&oe=6AB9274A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Treasure Hunter VR", "keywords": ["puzzle", "arcade", "egypt", "light", "adventure"], "long_description": "Plunge into  the atmosphere of ancient Egypt. Help young Jane  explore lost in the sands ancient temple, full of crafty traps  and find all the hidden treasures of the Pharaoh.\n \nTreasure Hunter VR -This is an atmospheric spatial puzzle based on the physics of light. The game was designed for a long immersive experience in virtual reality. We set ourselves the task to create not only unique mechanics of the game, but also to extend the average player session in VR.\n \n\n- 12 unique levels\n- Immersive atmospheric experience\n- Detailed Ancient Egyptian temple\n- Interesting puzzles\n- Comfort control created specifically for Gear VR", "short_descr
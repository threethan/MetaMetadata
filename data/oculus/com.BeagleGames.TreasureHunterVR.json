4_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y33ARKnF2JIQ7kNvwFGpXQQ&_nc_oc=AdqXH63hcIJXR2lXbbd0hlrOrwu8pCpeoXA2_X3E0cF9Scz6L-86scbgDAAQCcH7xm4&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBPgqhQ7mY9pHcggOs9M4yoooIZ2ZiVFB-BL0TjoMUfSA&oe=6A6E060C"}, {"file_name": "migrated_image.png", "id": "227586865025628", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/11162704_1440534279364325_3553473486204698624_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fmrm2C8cP70Q7kNvwHD9h1m&_nc_oc=AdooMdOBlZda53IEOSk_Tz5WLOqMePEA38bZxkZ967xSnlLoX9EltvZIqU9CbVw_MCk&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAijYTRQcQYawYGuek_pmMCcWPOUJYSs-f0nEoAiLw0_w&oe=6A6DE8A2"}, {"file_name": "migrated_image.png", "id": "223793988733980", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/11162684_1918532331768953_3442552378077741056_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xycTLGDR5oAQ7kNvwE5prQ5&_nc_oc=AdpE8eRVz4vthqzJDiVRxJH8RGD86RisTTNZ4ks86oUn2FXV4vK3M-skpY_vtBOpgQE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAbv-1Ds4trTgmcpudj0XNUEHYxXbTEigr_IEQDBPmcCw&oe=6A6E01CA"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Treasure Hunter VR", "keywords": ["puzzle", "arcade", "egypt", "light", "adventure"], "long_description": "Plunge into  the atmosphere of ancient Egypt. Help young Jane  explore lost in the sands ancient temple, full of crafty traps  and find all the hidden treasures of the Pharaoh.\n \nTreasure Hunter VR -This is an atmospheric spatial puzzle based on the physics of light. The game was designed for a long immersive experience in virtual reality. We set ourselves the task to create not only unique mechanics of the game, but also to extend the average player session in VR.\n \n\n- 12 unique levels\n- Immersive atmospheric experience\n- Detailed Ancient Egyptian temple\n- Interesting puzzles\n- Comfort control created specifically for Gear VR", "short_descr
4_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2Wjf1NxSkukQ7kNvwHGWHbl&_nc_oc=AdoLWouyGBHRmF1T36A4dGGGAKuUtPK4mqyDvce_twOQnpHXEE1gt5AWcEbevhGIszA&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQMZuXNX-6GyQxFjRqZut73lSDPXoWBvEOJ8JXg2LMoXw&oe=6AF08A8C"}, {"file_name": "migrated_image.png", "id": "227586865025628", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/11162704_1440534279364325_3553473486204698624_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zbZZe7ByxS4Q7kNvwHKxlQE&_nc_oc=Adqu-rMmOqvYshajsn08S46mOIZCyLbgwSL3TuRvyaiVbYgguL5NqVMx5fCydlZAgA4&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSHYepD8CUJDzPjPg5CwN8kvIbWl739WcSPnVen5p7Ljg&oe=6AF0A562"}, {"file_name": "migrated_image.png", "id": "223793988733980", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/11162684_1918532331768953_3442552378077741056_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zG3ztAccocgQ7kNvwE6Sdl5&_nc_oc=AdpKvUmYa1Tmw-c1MBaJh_l_ITfD_7C2ESyqNhGO3ZJG-xnD2fO_ufT3U5hj94bAC5M&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQPcvicRlOo0nIV2Ju8SJZbQ356mORnJPnmsI4AcaTfvQ&oe=6AF0864A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Treasure Hunter VR", "keywords": ["puzzle", "arcade", "egypt", "light", "adventure"], "long_description": "Plunge into  the atmosphere of ancient Egypt. Help young Jane  explore lost in the sands ancient temple, full of crafty traps  and find all the hidden treasures of the Pharaoh.\n \nTreasure Hunter VR -This is an atmospheric spatial puzzle based on the physics of light. The game was designed for a long immersive experience in virtual reality. We set ourselves the task to create not only unique mechanics of the game, but also to extend the average player session in VR.\n \n\n- 12 unique levels\n- Immersive atmospheric experience\n- Detailed Ancient Egyptian temple\n- Interesting puzzles\n- Comfort control created specifically for Gear VR", "short_descr
4_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7O4mNb6LTwsQ7kNvwFA4EZo&_nc_oc=Adq6MQumWzDeracNwo9I5evE55GdZt0cSI3QU1d3bzfP63PmkPPZRuVmmdu9Bz8ldmo&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9YD4pZUeOWps0Q8M03zPe16CwMjoqiQCmW1IDKdzX0xg&oe=6A3A9B8C"}, {"file_name": "migrated_image.png", "id": "227586865025628", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/11162704_1440534279364325_3553473486204698624_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oHWKisDZ1l8Q7kNvwGEnjZq&_nc_oc=AdrZ48UPcSb-1A5OGQ5ytvTLhxcoOIV0gcm643TloXZBycSUBbASO1UBOlDgeXBavOg&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_Zwrve42jf_l9mrF0jk5kji_fVNy-BD6a1TRbHp7Djdw&oe=6A3AB662"}, {"file_name": "migrated_image.png", "id": "223793988733980", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/11162684_1918532331768953_3442552378077741056_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_dsyk_tDCTAQ7kNvwEGGKCU&_nc_oc=Ado6NOAURd4fkv6gHOwTLOU9B2ha0uTE68BVkR02xqko9vEs3J5GcrpYk5DgEdYKLyw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9hE6wdNI9afqeXI5OkronVlnIxbVXtPppQLqAp7GEiGw&oe=6A3A974A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Treasure Hunter VR", "keywords": ["puzzle", "arcade", "egypt", "light", "adventure"], "long_description": "Plunge into  the atmosphere of ancient Egypt. Help young Jane  explore lost in the sands ancient temple, full of crafty traps  and find all the hidden treasures of the Pharaoh.\n \nTreasure Hunter VR -This is an atmospheric spatial puzzle based on the physics of light. The game was designed for a long immersive experience in virtual reality. We set ourselves the task to create not only unique mechanics of the game, but also to extend the average player session in VR.\n \n\n- 12 unique levels\n- Immersive atmospheric experience\n- Detailed Ancient Egyptian temple\n- Interesting puzzles\n- Comfort control created specifically for Gear VR", "short_descr
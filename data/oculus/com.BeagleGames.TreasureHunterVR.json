4_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bbzsd2Qq6-EQ7kNvwFLdc0w&_nc_oc=AdoDqj4OjX6c87xl3WQ29qS5tcr6atmCoEy0n3v5eYrJIIWVYR9mxIuoBJIjSK18J_Y&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSFMv2m8WCjReqOSYwIxVlhBfaJBo4J75K06cEhU9STZw&oe=6AF32D8C"}, {"file_name": "migrated_image.png", "id": "227586865025628", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/11162704_1440534279364325_3553473486204698624_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zbZZe7ByxS4Q7kNvwF6wbFE&_nc_oc=Adr0nG1BpuS0iJEz5usFn0DbNRZAMWg4dNrHkLOKUyi7k1pWzvDNFNdIEEDFTqCBv0M&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTFtmokvnfecW-KYhtywlSZXyO1iPM68I6J8SSUGXJXtA&oe=6AF34862"}, {"file_name": "migrated_image.png", "id": "223793988733980", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/11162684_1918532331768953_3442552378077741056_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gvnkhI9Da1EQ7kNvwE_6z2I&_nc_oc=AdrfPfX5uU1DTzi9McDB1CoO1IcSgNg9Zz-nS4AIiVKtanEpnBkjiAHHyHAjMr6JdzA&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRkQnaSCzEy_0Cw7_OspbFM7Drig39QOFQi_SKQrYqlTA&oe=6AF3294A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Treasure Hunter VR", "keywords": ["puzzle", "arcade", "egypt", "light", "adventure"], "long_description": "Plunge into  the atmosphere of ancient Egypt. Help young Jane  explore lost in the sands ancient temple, full of crafty traps  and find all the hidden treasures of the Pharaoh.\n \nTreasure Hunter VR -This is an atmospheric spatial puzzle based on the physics of light. The game was designed for a long immersive experience in virtual reality. We set ourselves the task to create not only unique mechanics of the game, but also to extend the average player session in VR.\n \n\n- 12 unique levels\n- Immersive atmospheric experience\n- Detailed Ancient Egyptian temple\n- Interesting puzzles\n- Comfort control created specifically for Gear VR", "short_descr
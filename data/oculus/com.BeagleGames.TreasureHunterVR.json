584_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wIT4xvInzNwQ7kNvwEEys4S&_nc_oc=Adpnr6WAk_woa5adOhQfI4BZu4-b3Pq1vaspccQXrSRuFfCImDrUnu52lwdDzpC8_7c&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLF8Cy9vgtB0q_nQ-DUGmxcqG_WRxJdtqtzzYWglWRQeA&oe=6AA4138C"}, {"file_name": "migrated_image.png", "id": "227586865025628", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/11162704_1440534279364325_3553473486204698624_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Dh6650Wg1LYQ7kNvwHYJim-&_nc_oc=AdosUSFG_zYYB-2reM2We4nQSwLgW9D1HvJmwsOJypRK_5KeVfm-dTDxwe9I1BEU4Bk&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJa-mNBjcPTGAGuvWLpDN-bO3sKC-EngGtVN8qw6B6puQ&oe=6AA3F622"}, {"file_name": "migrated_image.png", "id": "223793988733980", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/11162684_1918532331768953_3442552378077741056_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=skJTmmbQ5s0Q7kNvwHzd73a&_nc_oc=AdpEHUMZA93UXfQ-nzncmpL2BMv66N1pXgFko1xJ4TzcsUMqXXBZMgldARWbLD-2VBY&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL0f9eVYHzZJUrlHfQd8j0-4D_fnFuJFWM8ZNviAvJpkA&oe=6AA40F4A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Treasure Hunter VR", "keywords": ["puzzle", "arcade", "egypt", "light", "adventure"], "long_description": "Plunge into  the atmosphere of ancient Egypt. Help young Jane  explore lost in the sands ancient temple, full of crafty traps  and find all the hidden treasures of the Pharaoh.\n \nTreasure Hunter VR -This is an atmospheric spatial puzzle based on the physics of light. The game was designed for a long immersive experience in virtual reality. We set ourselves the task to create not only unique mechanics of the game, but also to extend the average player session in VR.\n \n\n- 12 unique levels\n- Immersive atmospheric experience\n- Detailed Ancient Egyptian temple\n- Interesting puzzles\n- Comfort control created specifically for Gear VR", "short_des
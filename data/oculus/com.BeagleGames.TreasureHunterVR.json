4_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DfYbEAkEh7UQ7kNvwH_tjWx&_nc_oc=AdqleCumqcywMKsFIy_6j-6WX9T0Glkly5rHJ8Frq2tgAnnXc9EhaC5XopP_piTt8Q8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD2vYKRQK7H3HNwpYNARw4HsNQ1OBksM-9ZPdN-sBFBBw&oe=6A491C0C"}, {"file_name": "migrated_image.png", "id": "227586865025628", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/11162704_1440534279364325_3553473486204698624_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PsyhEcbZyVUQ7kNvwETjiWx&_nc_oc=AdpfzKjsi2Ks5pqItjxtote2rHTW5g6XYNTAYWjdRFbb-t5URqKrX-Wj4ptGmce2_Lw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCjy8JrfemXUVFOMaD4t8kYitAL2jE-lbdq6zAB9sHolg&oe=6A48FEA2"}, {"file_name": "migrated_image.png", "id": "223793988733980", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/11162684_1918532331768953_3442552378077741056_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=In1CGIQpm20Q7kNvwGrdwn6&_nc_oc=AdpOPtm1bLI7McP-3gbOBRCUEvh8AJraJNwj0hYiM50qqt7LFc_Ca9teLqxjV0R6Z0E&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDZIAlcWNiBlb8nWLgG8AN46usgxAnz5TeoFJ0L0Lrb6g&oe=6A4917CA"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Treasure Hunter VR", "keywords": ["puzzle", "arcade", "egypt", "light", "adventure"], "long_description": "Plunge into  the atmosphere of ancient Egypt. Help young Jane  explore lost in the sands ancient temple, full of crafty traps  and find all the hidden treasures of the Pharaoh.\n \nTreasure Hunter VR -This is an atmospheric spatial puzzle based on the physics of light. The game was designed for a long immersive experience in virtual reality. We set ourselves the task to create not only unique mechanics of the game, but also to extend the average player session in VR.\n \n\n- 12 unique levels\n- Immersive atmospheric experience\n- Detailed Ancient Egyptian temple\n- Interesting puzzles\n- Comfort control created specifically for Gear VR", "short_descr
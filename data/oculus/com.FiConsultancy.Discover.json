/v/t64.5771-25/491824671_942149735330085_126942281298023256_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BBWewFnJ45AQ7kNvwHdW508&_nc_oc=AdqQEmJwIQTV6o-1i2Z1W9OsrhqRZZzTUthZYxh_J6b7zCuLcF0Qj4NJMvaPEwwWwb8&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEXQVN_3Y0_UYCrLZrOxW8_iHHdMs9Velolb9GOnNWfxg&oe=6A90136E"}, {"file_name": "vlcsnap-2025-02-18-16h57m14s582.png", "id": "9520666237976878", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473391952_9520666241310211_5850816830106565474_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nUt2iAzH5nQQ7kNvwHomlDC&_nc_oc=Adoyz2zR2Lwj7Zk2jFTCTRczSO2Erx3NwnEKhzqFpLj7IM6RIZ9k7S2dpmkXJKLk-Ao&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG29XGfG0_NuTZa6kSsX09YzjHSD0b5t2bDQKgxakAatg&oe=6A903324"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Frame 1 (1).png", "id": "1781587339471494", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491824328_1781587342804827_4931645829602710294_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=p2eGFh14GfUQ7kNvwHD_uaN&_nc_oc=AdpUDdv0e_5CdMpEsLLTYE-FdsCGyU2cvl6cyB8uSsUKUadFgA-rIiuO-FickF4SiSw&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEetWZ7QAkcE5bdGt8f9d5GbLCXBInjL6XXHMpPIaoc8w&oe=6A903AAD"}, "display_name": "Nexus Arcade in Mixed Reality", "keywords": ["Arcade", "Racing", "Sports", "Action", "Simulation"], "long_description": "Your space becomes the arcade.\n\nNexus Arcade brings four mixed reality experiences into your room using Meta Quest. Play fast kart racing through virtual portals, set up tenpin bowling in your space, train with boxing targets, and test your aim in shooting range challenges.\n\nDesigned for quick, active gameplay, Nexus Arcade blends real-world movement with virtual arcade experiences. Whether you want a short session, a party-style game, or a mixed reality showcase, Nexus Arcade gives you multiple ways to play.\n\nIncludes:\nKart Racing\nTenpin Bowling\nBoxing Trainer\nShooting Range\n\nStep in, look around, and bring the arcade into your room.", "short_description": "Turn your room into a mixed reality arcade. Race karts, bowl, train with boxing targets and enter shooting range challenges with Nexus Arcade on Meta Quest."}]}, "developer_name": null, "developer_privacy_policy_url": "https://nexusarcadevr.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Nexus Mixed Reality Ent Limited", "support_website_url": "https://discord.gg/B5zjZ4gqC", "website_url": "https://nexusarcadevr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "459781504968480"}, {"id": "331529188132278"}, {"id": "1592192974313489"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "MULTI_USER", "MULTI_USER"], "id": "27208231818797854"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499300897_1005992511860502_2925515773467104054_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nYVOwFrLE18Q7kNvwGhzhvh&_nc_oc=AdpTqlgP8YHhfIa69NSHV5nWzsVoXY72HbFt-XvCTrrKRiA2KCePZw82SD6diCJRsWk&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHdrGk6qwShrXIfacIlMc2EO067A0h98laSCwFBy3fz9Q&oe=6A903680"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Nexus Arcade in Mixed Reality", "platform": "ANDROID_6DOF", "context_category": {"context_category": 
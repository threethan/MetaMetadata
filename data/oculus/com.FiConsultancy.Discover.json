_1229490528215721_2400571863063428306_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7LCB3lVUnygQ7kNvwHciRTR&_nc_oc=AdqizoSNDWrQ2Q62B46XZyAaCokkpsRYICiyLrWdoU6NBoJ4syBH8UUnLA50VDe3YxE&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-09brUA4Raq8IElmUGc1hm-D71onsNInUXEhnUM8xExg&oe=6A2C0A42"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Image.png", "id": "747601094058687", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/43931328_747601097392020_590499727033776173_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bc4X0mmrGxcQ7kNvwES9Lku&_nc_oc=Adq6R4DktpEFIYpvNJzUiklSntftnWPtUxVdJx70h_hQ3TuGlfYOwUTuTxmF1xI1p9o&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_usAfo2nvVApGWgPwDXuANS4BtCAn-UDY52zUhFFFMeQ&oe=6A2C29A6"}, "display_name": "Nexus Arcade", "keywords": [], "long_description": "Step into the future of gaming with Nexus Arcade, a pioneering mixed reality platform designed to deliver unparalleled immersive experiences. Nexus Arcade offers four exciting games that blend physical activity with digital engagement, creating a unique and thrilling gaming environment.\n\nNexus Arcade is more than just a gaming platform; it\u2019s a gateway to a new era of interactive entertainment. Whether you\u2019re looking to compete, train, or simply have fun, Nexus Arcade offers something for everyone. Join us on Meta App Lab and be part of the gaming revolution.", "short_description": "Nexus Arcade is a cutting-edge mixed reality gaming platform that brings the excitement of four immersive games\u2014Ten Pin Bowling, Boxing Mitt Training, Car Racing, and Shooting Range\u2014directly to your VR headset. Experience the perfect blend of physical and digital worlds, offering unparalleled gaming experiences from the comfort of your home."}]}, "developer_name": null, "developer_privacy_policy_url": "https://nexusarcadevr.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "FI Consultancy", "
/v/t64.5771-25/491824671_942149735330085_126942281298023256_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VvpljGD6TTYQ7kNvwGfJxvW&_nc_oc=AdrVNx982dI0TlASnJGXsx6kyjWJONTIwBdgv1S_gpHNZjms00Mt2z07q_4My1VyDCo&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRq7sb6QdRNm0BFP3RhXGWpEmZX9VvC6Mw3HccyOaxljQ&oe=6AE8A02E"}, {"file_name": "vlcsnap-2025-02-18-16h57m14s582.png", "id": "9520666237976878", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/473391952_9520666241310211_5850816830106565474_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nDfbXaBQOaUQ7kNvwF4H2ON&_nc_oc=AdqSQY3yN71sNXXxhGaetQPrNN1VESRniKKc90PYYDn8Zhm8DGiL7EN3T8S1G9_7chI&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSv1JuwvgFTKr9pR0EUsNnXyoX_9T1rOwFOu-FbWU8aAQ&oe=6AE8BFE4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Frame 1 (1).png", "id": "1781587339471494", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/491824328_1781587342804827_4931645829602710294_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NsMbPOwaCaEQ7kNvwF37Oyz&_nc_oc=AdpkC-KCnMWMn0xhHG2GtfRSrgfTpmI14w8EbchH4vm1hFza_0CpzdsOZe5YIIb3SFM&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTah6nr41_3rFFTbuyRCoNnWRiVatLQto1zf9xgf1v0sw&oe=6AE88F2D"}, "display_name": "Nexus Arcade in Mixed Reality", "keywords": ["Arcade", "Racing", "Sports", "Action", "Simulation"], "long_description": "Your space becomes the arcade.\n\nNexus Arcade brings four mixed reality experiences into your room using Meta Quest. Play fast kart racing through virtual portals, set up tenpin bowling in your space, train with boxing targets, and test your aim in shooting range challenges.\n\nDesigned for quick, active gameplay, Nexus Arcade blends real-world movement with virtual arcade experiences. Whether you want a short session, a party-style game, or a mixed reality showcase, Nexus Arcade gives you multiple ways to play.\n\nIncludes:\nKart Racing\nTenpin Bowling\nBoxing Trainer\nShooting Range\n\nStep in, look around, and bring the arcade into your room.", "short_description": "Turn your room into a mixed reality arcade. Race karts, bowl, train with boxing targets and enter shooting range challenges with Nexus Arcade on Meta Quest."}]}, "developer_name": null, "developer_privacy_policy_url": "https://nexusarcadevr.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Nexus Mixed Reality Ent Limited", "support_website_url": "https://discord.gg/B5zjZ4gqC", "website_url": "https://nexusarcadevr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "459781504968480"}, {"id": "331529188132278"}, {"id": "1592192974313489"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "MULTI_USER", "MULTI_USER"], "id": "27208231818797854"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/499300897_1005992511860502_2925515773467104054_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uxX0VJp_EasQ7kNvwGd4hOg&_nc_oc=AdqxwoIsASwShujisjHKGBZ6v9hy4yfPvnMbanwaPr-y9XewCd5eSoANFO1AZCTM8nI&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRjMpm2h8HzqnDFi1QRszyQa8ZzeDpIE-mykTEXsCCYPQ&oe=6AE8C340"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Nexus Arcade in Mixed Reality", "platform": "ANDROID_6DOF", "context_category": {"context_category": 
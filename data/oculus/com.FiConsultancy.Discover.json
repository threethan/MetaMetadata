c_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XWiByPtvhZoQ7kNvwEv7DmF&_nc_oc=AdkZCFQ8v7HyoU8XRkp_2dpCeReOzfMfn-NRk-JyonLHV_HsRNtIJYwCSnq_gk_HZII&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfxMK1oCmHTsBIH-yLvE25exj7V9dKckjMPu80VgUmkmjQ&oe=69BE9DC2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Image.png", "id": "747601094058687", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/43931328_747601097392020_590499727033776173_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lV81NhqlcjgQ7kNvwHTzbYx&_nc_oc=AdkTYIPdt1ltvYEmCW5DM4McxcHk8VzHUfn3WLM_FtAMr1nOffoovrWN7TCONWutnOA&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfwryQRH5rN_lpcxoZVIT8yAOsMxJHJueQdyGbBfTKuiOw&oe=69BE84E6"}, "display_name": "Nexus Arcade", "keywords": [], "long_description": "Step into the future of gaming with Nexus Arcade, a pioneering mixed reality platform designed to deliver unparalleled immersive experiences. Nexus Arcade offers four exciting games that blend physical activity with digital engagement, creating a unique and thrilling gaming environment.\n\nNexus Arcade is more than just a gaming platform; it\u2019s a gateway to a new era of interactive entertainment. Whether you\u2019re looking to compete, train, or simply have fun, Nexus Arcade offers something for everyone. Join us on Meta App Lab and be part of the gaming revolution.", "short_description": "Nexus Arcade is a cutting-edge mixed reality gaming platform that brings the excitement of four immersive games\u2014Ten Pin Bowling, Boxing Mitt Training, Car Racing, and Shooting Range\u2014directly to your VR headset. Experience the perfect blend of physical and digital worlds, offering unparalleled gaming experiences from the comfort of your home."}]}, "developer_name": null, "developer_privacy_policy_url": "https://nexusarcadevr.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "FI Consultancy", "support_website_url": null, "website_url": "https://ne
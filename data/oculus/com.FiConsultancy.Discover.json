om/v/t64.5771-25/491824671_942149735330085_126942281298023256_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zHQFaLnPQ9wQ7kNvwHap7N7&_nc_oc=AdqPtDWORQpZ4yFEfJJ3B8JfsFy7IWaJYz3txYEnzEfPIIjilabNQONGC3GShPPjlb8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4RvfIq2Y-U4AVoOhK7hkMZpNBt4dZT1SRfXwvAquxYmw&oe=6A048CAE"}, {"file_name": "vlcsnap-2025-02-18-16h57m14s582.png", "id": "9520666237976878", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391952_9520666241310211_5850816830106565474_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JRxfVxxeB7EQ7kNvwGxRHI8&_nc_oc=AdqJjhEd50Jhye-VbelMYuvAFo2NeiMzthYiRmmFVFeA-S8OTDMSsc_YFoPpvX9rjYk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af56M54BI_thFFCAwk21JH6qb_DEpDOWcvbVMvcl8ugxug&oe=6A047424"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Frame 1 (1).png", "id": "1781587339471494", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491824328_1781587342804827_4931645829602710294_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mRShvGg9Q0sQ7kNvwFagFTs&_nc_oc=Adr4FZ9QQT_mGpjpl-cWn8J8BupmBZ_Xahgke0bN3UHZTjc671_BKzOmAnQ2v-KW3pc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5Bv9i6kH8ZuPthuG1NleCugWCl9jie6pGm2dfGwh-mdQ&oe=6A047BAD"}, "display_name": "Nexus Arcade in Mixed Reality", "keywords": ["Arcade", "Racing", "Sports", "Action", "Simulation"], "long_description": "Your space becomes the arcade.\n\nNexus Arcade brings four mixed reality experiences into your room using Meta Quest. Play fast kart racing through virtual portals, set up tenpin bowling in your space, train with boxing targets, and test your aim in shooting range challenges.\n\nDesigned for quick, active gameplay, Nexus Arcade blends real-world movement with virtual arcade experiences. Whether you want a short session, a party-style game, or a mixed reality showcase, Nexus Arcade gives you multiple ways to play.\n\nIncludes:\nKart Racing\nTenpin Bowling\nBoxing Trainer\nShooting Range\n\nStep in, look around, and bring the arcade into your room.", "short_description": "Turn your room into a mixed reality arcade. Race karts, bowl, train with boxing targets and enter shooting range challenges with Nexus Arcade on Meta Quest."}]}, "developer_name": null, "developer_privacy_policy_url": "https://nexusarcadevr.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Nexus Mixed Reality Ent Limited", "support_website_url": "https://discord.gg/B5zjZ4gqC", "website_url": "https://nexusarcadevr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "673385183287495"}, {"id": "3744040075834813"}, {"id": "1592192974313489"}, {"id": "2776542286000603"}, {"id": "459781504968480"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26575303685424007"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491823930_1460314121807630_1896621729476051658_n.png?stp=dst-png_s360x360&_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9gxd4Bk5a00Q7kNvwEbt9Yx&_nc_oc=AdqrsRG70hun4bvFuie6lpP9hCWWZl8ah5C3Hs87oyw6BVUVEEdKov19Wl0TD5ClwGg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6g63OsBSk2XqZpEcW60T9BNeGZBZRrQC8-h_Kk9Jqjxg&oe=6A04950C"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Nexus Arcade in Mixed Reality", "platform": "ANDROID_6DOF", "context_category": {"context_category":
_1229490528215721_2400571863063428306_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7LCB3lVUnygQ7kNvwEZZnXR&_nc_oc=AdqDQXu6Pr5aRAvGFxnYYt7X674phco4zkwQZoKY1_cOHr6bepcEWXQS6ficktU41jU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_xl8GDCapzovBLhrBiMahZJFafDCMvWVWRUWJg8KwGAQ&oe=6A2AB8C2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Image.png", "id": "747601094058687", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/43931328_747601097392020_590499727033776173_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bc4X0mmrGxcQ7kNvwH_oKR3&_nc_oc=Ado0OdbT0SCBByXDtuqcNTL-3h7yrkVfTDcLZKjhGQS9BwVqbGUX8UvGqC0rXPWPtSY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8AcRIhazW6lYJvrZVSH-Kv-gk3-03sd7vn4CDRv6sB-w&oe=6A2AD826"}, "display_name": "Nexus Arcade", "keywords": [], "long_description": "Step into the future of gaming with Nexus Arcade, a pioneering mixed reality platform designed to deliver unparalleled immersive experiences. Nexus Arcade offers four exciting games that blend physical activity with digital engagement, creating a unique and thrilling gaming environment.\n\nNexus Arcade is more than just a gaming platform; it\u2019s a gateway to a new era of interactive entertainment. Whether you\u2019re looking to compete, train, or simply have fun, Nexus Arcade offers something for everyone. Join us on Meta App Lab and be part of the gaming revolution.", "short_description": "Nexus Arcade is a cutting-edge mixed reality gaming platform that brings the excitement of four immersive games\u2014Ten Pin Bowling, Boxing Mitt Training, Car Racing, and Shooting Range\u2014directly to your VR headset. Experience the perfect blend of physical and digital worlds, offering unparalleled gaming experiences from the comfort of your home."}]}, "developer_name": null, "developer_privacy_policy_url": "https://nexusarcadevr.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "FI Consultancy", "
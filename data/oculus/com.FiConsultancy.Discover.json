c_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2tP2me69whAQ7kNvwEz8f-J&_nc_oc=Adn0XuzimzKZT59fE36G2_yqOz-mh5UfPLbRbZVHsUpRFfEOhJaDkT_byrD3zcRs4Vo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_Afw8cbrGVFXBKq4uILeZCsJSIWdJRiU-nf-RFODsqezFew&oe=69B6B4C2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Image.png", "id": "747601094058687", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/43931328_747601097392020_590499727033776173_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZJZyPE3KauEQ7kNvwGswVW8&_nc_oc=AdmbV3ZrzZY1fu4xeYlN7rdGu2qz-NMoKCZ3u1NDanrHaObndFbXhJH-FOVmOLoI-Dg&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfyJEU1eA96WqjQ31zNfLP0vVH7k4qi4ZNBhPnxRB_A7mA&oe=69B69BE6"}, "display_name": "Nexus Arcade", "keywords": [], "long_description": "Step into the future of gaming with Nexus Arcade, a pioneering mixed reality platform designed to deliver unparalleled immersive experiences. Nexus Arcade offers four exciting games that blend physical activity with digital engagement, creating a unique and thrilling gaming environment.\n\nNexus Arcade is more than just a gaming platform; it\u2019s a gateway to a new era of interactive entertainment. Whether you\u2019re looking to compete, train, or simply have fun, Nexus Arcade offers something for everyone. Join us on Meta App Lab and be part of the gaming revolution.", "short_description": "Nexus Arcade is a cutting-edge mixed reality gaming platform that brings the excitement of four immersive games\u2014Ten Pin Bowling, Boxing Mitt Training, Car Racing, and Shooting Range\u2014directly to your VR headset. Experience the perfect blend of physical and digital worlds, offering unparalleled gaming experiences from the comfort of your home."}]}, "developer_name": null, "developer_privacy_policy_url": "https://nexusarcadevr.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "FI Consultancy", "support_website_url": null, "website_url": "https://ne
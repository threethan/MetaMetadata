long_description": "Step into this uniquely atmospheric game, where your goal is simple:\n\nDefeat waves of increasingly powerful enemies. During each run, upgrade your stats to adapt and survive as long as possible.\n\nIt features a tutorial, a standard mode where you must defeat all enemy waves, and an endless mode that challenges you to last as long as you can.\n\nYou can also compare your scores with other players in the built-in leaderboard.\n", "short_description": "Face endless waves of enemies, upgrade your skills, and climb the leaderboard in this intense survival challenge."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/cosmicwarvr/privacy-policy?authuser=0", "developer_terms_of_service_url": null, "publisher_name": "Unity", "support_website_url": null, "website_url": "https://sites.google.com/view/cosmicwarvr/accueil?authuser=0", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "644354873106712"}, {"id": "3744040075834813"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24264725839835733"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499307962_2007351873344411_2181570699315062201_n.png?stp=dst-png_s360x360&_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cooeDm1-NxgQ7kNvwEdeTTs&_nc_oc=Adr1RPmVqKvyhTR8kmOgHzpW4w2E1XvtIZl7p6RW957GJ2
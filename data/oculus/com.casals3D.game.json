0.png", "id": "30795132360130637", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/491823485_30795132363463970_5828659215839234750_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dwGoE_8AAOAQ7kNvwF3SwFO&_nc_oc=AdouIR62dIY_5inzmoTExPaALCoiGJBZgKAt43CB9DF9aU0LQbtIBv3jNjpeSb-axN0&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEO4I71dKdeXzGzO6alxHwU_eXAJHfAl_ZML5_UHmtvwQ&oe=6A8EC835"}, "display_name": "Cosmic War", "keywords": [], "long_description": "Step into this uniquely atmospheric game, where your goal is simple:\n\nDefeat waves of increasingly powerful enemies. During each run, upgrade your stats to adapt and survive as long as possible.\n\nIt features a tutorial, a standard mode where you must defeat all enemy waves, and an endless mode that challenges you to last as long as you can.\n\nYou can also compare your scores with other players in the built-in leaderboard.\n", "short_description": "Face endless waves of enemies, upgrade your skills, and climb the leaderboard in this intense survival challenge."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/cosmicwarvr/privacy-policy?authuser=0", "developer_terms_of_service_url": null, "publisher_name": "Unity", "support_website_url": null, "website_url": "https://sites.google.com/view/cosmicwarvr/accueil?authuser=0", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "644354873106712"}, {"id": "3744040075834813"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SI
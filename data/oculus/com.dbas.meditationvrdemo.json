s. It is fully operable offline, allowing for complete experiences without the need for an internet connection.", "short_description": "Immersive meditation content for emotional stability"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.eznwellness.com/static/etc/privacy", "developer_terms_of_service_url": null, "publisher_name": "\uc774\uc9c0\uc564\uc6f0\ub2c8\uc2a4 \uc8fc\uc2dd\ud68c\uc0ac", "support_website_url": null, "website_url": "https://www.eznwellness.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ko"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24174191358905196"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499619529_1978080626339674_2865069659034805748_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y2nE4hBz2BgQ7kNvwFmEFdB&_nc_oc=AdpgE9IW9PZCYe-6jqrL1uwl8-LU-JYHON6O48pOA9OzPr4nppQswlgZz0yzdEP3VEg&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1sL9o2-oIC_2xGFE55pGTKuQbHjJiIzVR7jsspfhZMaA&oe=69DF8F51"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Inner Scape", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_name": "Fitness & Wellness", "id": "810139357995560"}], "release_date": 1758578400, "lastRevision": {"nodes": [{"id": "9929647613786142", "release_t
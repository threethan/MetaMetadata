.com/v/t64.5771-25/491825415_1218343160169363_2263201430021844960_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SNSg0tV1qTEQ7kNvwEKPxL8&_nc_oc=AdqIroNNVWFS4gTBiclpJF8n6EqRgvJJpPdEOyYN7PZJdtysqYbXj2VFsH8lLhZUP44&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7oNuV-gBtTBq81Q2lMdCzBnSfbXbL20pudISBz1hSrwg&oe=6A12F0B6"}, {"file_name": "XPZ_Screenshot_06.png", "id": "854632523638947", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/491818900_854632526972280_6701071052096553381_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0Gkohm3ypkEQ7kNvwFZNBzD&_nc_oc=AdpBiJMERdknPIm-4Cgv4TUiypY89GHdss5gQkG5dVr_I_mwixRxU4DS6gJMMKd-Rw8&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af41jRtJKKQUVLkoITvdx94iHKdCvaFREDtflUDuPJg0Zg&oe=6A130FA8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "XploitZERO_Key Art_Landscape.png", "id": "851391407496299", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/491823783_851391414162965_4053303436264422722_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=27gzXJAovM8Q7kNvwG8K7dV&_nc_oc=Adp8tkdJ6B-SxwO1SPq-7F7qpqHAd1uRxYij_me1RLiqLDCGriZuCiqJSM39h-QU82Y&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5iFoo89SMoa-QIdGCr-BaMqbX2cx5X2lsgswpUT6kEzQ&oe=6A131234"}, "display_name": "Xploit.Zero", "keywords": ["Hacker", "Turret", "Virus", "AR", "Arcade"], "long_description": "Zploit.\u1d22\u1d07\u0280\u1d0f puts you in the role of a XRunner whose connection to reality has been compromised.\nA security Breach has opened inside your room, and the invading viruses have found a path toward your NeuroGate, the anchor preventing your consciousness from becoming lost within the digital matrix.\n\nBuild turrets to defend yourself from DDoS viruses, swarms that advance from the Breach following routes projected across your own room.\nSimultaneously, protect those turrets from the relentless attacks of Malworm viruses, airborne creatures that strike from above to disable your defenses.\n\nOrganize your defenses and turn your room into a true Augmented Reality battlefield.\nYou decide where to place your turrets and how to adapt your space to withstand the digital assault.", "short_description": "Zploit.\u1d22\u1d07\u0280\u1d0f is a fast, intense XR tower-defense arcade experience that blends strategy and action. As an XRunner caught between reality and the digital matrix, a Breach opens in your room, sending DDoS swarms toward your NeuroGate. Place your turrets strategically across your space, then defend them from airborne Malworms trying to shut them down. Turn your room into a living AR battlefield and hold the line."}]}, "developer_name": null, "developer_privacy_policy_url": "https://aaagamestudios.com/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "AAA Games Studios S.L.", "support_website_url": "https://aaagamestudios.com/index.html#about", "website_url": "https://www.aaagamestudios.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "275629210202852"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24364900106485042"}}]}, "scheduled_offers": {"count": 3, "nodes": [{"status": "PUBLISHED", "id": "1502685468217217"}, {"status": "PUBLISHED", "id": "969917192193818"}, {"status": "PUBLISHED", "id": "1349221663627822"}]}, "baseline_offer": {"id": "1349221663627822"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1779123600, "sta
hJiQ4Q7kNvwFRgLtM&_nc_oc=Ado_Uqd-0oA_gQ5bmDMp1pTEv8XHxMxnN0joEUHyE3T8cpufb32EMY7UgCKMr0ArFMg&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxRBK88zqXiKwnO8LNCMQc6NYaRH7kvya2Le2Yo1DqW_g&oe=69C2834F"}, {"file_name": "XPZ_Screenshot04.png", "id": "968014989220990", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491823296_968014992554323_7156409964858030018_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mNd39SkmA2oQ7kNvwHjphz4&_nc_oc=Adp86zru9eKMQ8re3VwsE0BXLBemStDTyTErJPZgFMxiTgtVNjLMPFUp6eYeibbVIDU&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afxut4w9g_7bGeeW5BPV7loTBtRxN5rKJR5lxfUN3cWZNg&oe=69C29AE1"}, {"file_name": "XPZ_Screenshot05.png", "id": "967045972505631", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491821081_967045975838964_1133222401294464158_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YpQ-HelujB8Q7kNvwG17Dgs&_nc_oc=AdprJT-1gpnUPcBbhK-6k6vqsX26t11Qo0fIDvLvLj3cmb6P4Jv4K4lFoRJaJxy3zOY&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afws6ifRSa4dUqZFT7-VlknfHcubGHQiQlcMX9getJ3BHw&oe=69C2805C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "XploitZERO_Key Art_Landscape.png", "id": "851391407496299", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/491823783_851391414162965_4053303436264422722_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3yuGjmUrM3oQ7kNvwEVQ7Pc&_nc_oc=AdqMH1Ai3Lmy7w0zQp6_sz4VeIqG6VcU-PVKHmFXT6DKxRPE6dXOKXMMBrGzMFqHr3g&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afzr0reiq3hBNE5NY2F16FYgwEHfSkDhF2UXNDxLa38jTA&oe=69C26E74"}, "display_name": "Xploit ZERO", "keywords": ["Arcade", "Fitness", "Action", "MR", "TowerDefense"], "long_description": "Xploit ZERO is a mixed reality arcade tower-defense game where your real room becomes the battlefield.\n\nBuild and place turrets across your space to stop waves of digital enemies, then jump into first-person combat to defend them. \n\nAs an **XRunner**, a digital Breach opens inside your room, sending viruses toward your **NeuroGate**, the anchor keeping your connection to reality.\n\n# \ud83d\udd76\ufe0f Your Room Is the Level\n\nAttack paths are projected across your real environment and adapt to the size and layout of your room. You decide where to place your turrets and how to organize your space to stop the assault.\n\n# \u2694\ufe0f Strategy and Action\n\nDDoS viruses advance along the attack path toward your NeuroGate, while airborne **Malworm** viruses attack your turrets directly.\n\nTo survive, you must:\n- Build and upgrade turrets using **Memory Cores**\n- Defend them in first-person combat\n- React quickly as pressure increases\n\n# \ud83c\udfae Game Modes\n\n**Countdown Mode**  \nA fast-paced **5-minute countdown** designed for intense arcade sessions.\n\n**Endless Mode**  \nSurvive as long as possible and chase high scores under constant pressure.\n\n# \ud83d\udcac Early Access & Community\n\nXploit ZERO is available in **Early Access** with **5 fully playable levels**, offering a complete experience from day one.\n\nBecause every room is different, player feedback is essential to refine balance and difficulty. \nOur main community hub is Discord, where we actively gather feedback during Early Access.\n\n\u2139\ufe0f To enjoy a better experience, make sure you have at least 8 ft x 8 ft (2.5 m x 2.5 m) of play space.", "short_description": "Xploit ZERO is a mixed reality arcade tower-defense game where your real room becomes the battlefield.\nBuild and place turrets across your space to stop waves of digital enemies, then jump into first-person combat to defend them.\nAs an XRunner, a digital Breach opens inside your room, sending DDoS swarms toward your NeuroGate. Hold the line and protect your space."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.aaagamestudios.com/xploit.zero/privacy-policy.html", "developer_terms_of_service_url": "https://www.aaagamestudios.com/xploit.zero/legal-notice.html", "publisher_name": "AAA Games Studios S.L.", "support_website_url": "https://www.aaagamestudios.com/xploit.zero/early-access.html", "website_url": "https://www.aaagamestudios.com/xploit.zero/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "275629210202852"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26040639945577708"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491819854_855276044208904_8226690140496844957_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=p74ecU6Olj4Q7kNvwHh22U0&_nc_oc=AdrZ0DJxPitmIh-IsZm9HDRqNvguM-BgG_tlxZKI8t3QcNYJX8az6sA4IswkC9mJ4OE&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afwh6k8IfvPrWNU0ZcliJn7EKRTGk5xsF4M2LKllySOSTg&oe=69C26D5B"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Xploit ZERO", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Action", "id": "459781504968480"}, {"topic_name": "Strategy", "id": "275629210202852"}, {"topic_name": "Arcade", "id": "1592192974313489"}], "release_date": 1773757800, "lastRevision": {"nodes": [{"id": "24364900119818374", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "24364900086485044"
AQDy781cZDeyX4p-vKe5YgGk5HKOYGeAewxqMnBr_sI0mw&oe=6A6899AA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "imagen de portada.png", "id": "1622714972349258", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/491820855_1622714975682591_1524617146993487012_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9Aa54lJjpVEQ7kNvwEOackD&_nc_oc=AdpwO27cnerowBuYnCAeRIu_35bwM4vS_2l8JYknn2W7dwrQ1-NP0sVpuhjTZDjYxe0&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBfmCxWVbfvhx8ykbuBtpSNJBXJjsiFosIs3NiUbVZ8DQ&oe=6A68988D"}, "display_name": "Xploit ZERO", "keywords": ["fitness", "combate", "invasores", "r\u00e1pido", "t\u00e1ctica"], "long_description": "Un ciberataque amenaza con cortar tu \u00faltimo v\u00ednculo con la realidad. Para sobrevivir, piensa r\u00e1pido, re\u00fane n\u00facleos de memoria, fortifica tu posici\u00f3n y reacciona \u00e1gilmente para repeler a los invasores. \u00bfTe atreves?\n\n**Xploit ZERO es el juego de acci\u00f3n y estrategia en Realidad Mixta que convierte tu propia habitaci\u00f3n en un campo de batalla.**\n\n{1507763590969456}\ud83c\udfe0 Escanea tu habitaci\u00f3n en segundos y l\u00e1nzate a la acci\u00f3n.{27062951439996127}\u2694\ufe0f Consigue recursos y fortifica. El tiempo apremia.{1358224226114774}\u26a1Mu\u00e9vete r\u00e1pido y derriba los drones enemigos.{1443354170218761}\ud83d\udc7e  Los atacantes evolucionan; tus defensas tambi\u00e9n.{1209753834367151}\ud83d\udd25 R\u00e1pido, intenso y rejugable. Diversi\u00f3n garantizada.\n\n\u2139\ufe0f Acceso Anticipado & Comunidad.\n\nXploit ZERO est\u00e1 disponible en Acceso Anticipado (\"Early Access\") con 5 niveles completamente jugables y 2 modos de dificultad, ofreciendo horas de diversi\u00f3n extrema desde el primer d\u00eda. Sigue a Xploit ZERO en redes sociales y ay\u00fadanos a llevar la innovaci\u00f3n a\u00fan m\u00e1s lejos.", "short_description": "Xploit ZERO es el juego de acci\u00f3n y estrategia en Realidad Mixta que convierte tu habitaci\u00f3n en un campo de batalla. Piensa r\u00e1pido, construye tus defensas y reacciona en tiempo real para repeler a los invasores en partidas cortas, intensas y llenas de diversi\u00f3n. \u00bfTe atreves?"}, {"images": {"nodes": [{"file_name": "Xploit_zero_360.2.png", "id": "26529534970073330", "image_type": "APP_IMG_CUBEMAP_SOURCE", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/595136811_26529534980073329_7286307846810146766_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L39pey1yEG4Q7kNvwExuNbP&_nc_oc=AdrZndhOFdMMbQQqEjVVQqFJP8ijXcRMT6Y5Qw7F4gEQW9L08UdegzEm7FRj-KoTqS4&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAAKYc_0RBJqSfSbZ2ByF__X1UwzZQ4v4wTl9bgCWZVUQ&oe=6A689096"}, {"file_name": "Shot2.png", "id": "26394552166891673", "image_type": "APP_IMG_MARKDOWN_INLINE", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491828104_26394552180225005_6856735165680477736_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0KWvUzOdrfcQ7kNvwH_hREU&_nc_oc=AdoHNWDZrZI6OXgEch_xNMwTZGgpqK1x3asQPo1ETgKhQrUqEmBP4t2Nn0Yt-DJACMg&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAIHIp3iBgb0Zfpp0__a-D0h40fc0i6Vb38Qg93OMnsxw&oe=6A6897E2"}, {"file_name": "Shot5.png", "id": "3160157457501506", "image_type": "APP_IMG_MARKDOWN_INLINE", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/499298502_3160157460834839_8317283677516400765_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fw1mlIMHv08Q7kNvwHwf-D1&_nc_oc=AdrdVGeAsK-moxHOoYlOt8d8fd7p-fbplLo-f7wiYQtZ9hnJwYosOBCef0mFvXbI-OM&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD8F8x672QXSc9dhKhoz97Tx5ALHDgQXVzcENj2yo7-3w&oe=6A689FD9"}, {"file_name": "Shot3.png", "id": "2659403194432547", "image_type": "APP_IMG_MARKDOWN_INLINE", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/491824322_2659403197765880_1538727125860821274_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8gf7hwloSmMQ7kNvwGPQZ_J&_nc_oc=AdplzmT4v158L3Pni5IiCxmGqqRTlE5lv7p
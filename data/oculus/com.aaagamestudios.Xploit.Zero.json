DcQ&oe=6A91844B"}, {"file_name": "XPZ_Screenshot_08.png", "id": "1218343156836030", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/491825415_1218343160169363_2263201430021844960_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xf55Ab6nWHQQ7kNvwHyaUMS&_nc_oc=AdppZooPz9cK6-Qki4H6iTjZ7UB63I3ZYpUJ1UZEoDRMH9SJ9IDT_0YjgRT9JK4B0O8&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGmPVvCV0sLfEgYoqtY4Ir9Pb9TZ8UWBR14zLOUy4cebA&oe=6A9180B6"}, {"file_name": "XPZ_Screenshot_06.png", "id": "854632523638947", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/491818900_854632526972280_6701071052096553381_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vyR2G_9a-z4Q7kNvwGThaVc&_nc_oc=AdpH60ZKZHiZlSpxAeHyo9__pyg4WK3WKKXpYTTG8OrkfErNfbKE9bEJG7X_QjGIbyg&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGjRic-NQjdFS_mR64JSEIJhyf6ssRowol19cbh66qT-A&oe=6A916768"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "XploitZERO_Key Art_Landscape.png", "id": "851391407496299", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/491823783_851391414162965_4053303436264422722_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TikO_WEjQwQQ7kNvwGRQNx-&_nc_oc=AdriV07GkUyNA0MkEB9sKwmGwohwzYs0kEO3vetZF97DqbhXZ385EoQrMqZPOq5DyO8&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFjCionOr7JtTvtSrkHGpKAh5L__8O_qPepTfSS399nYQ&oe=6A9169F4"}, "display_name": "Xploit.Zero", "keywords": ["Hacker", "Turret", "Virus", "AR", "Arcade"], "long_description": "Zploit.\u1d22\u1d07\u0280\u1d0f puts you in the role of a XRunner whose connection to reality has been compromised.\nA security Breach has opened inside your room, and the invading viruses have found a path toward your NeuroGate, the anchor preventing your consciousness from becoming lost within the digital matrix.\n\nBuild turrets to defend yourself from DDoS viruses, swarms that advance from the Breach following routes projected across your own room.\nSimultaneously, protect those turrets from the relentless attacks of Malworm viruses, airborne creatures that strike from above to disable your defenses.\n\nOrganize your defenses and turn your room into a true Augmented Reality battlefield.\nYou decide where to place your turrets and how to adapt your space to withstand the digital assault.", "short_description": "Zploit.\u1d22\u1d07\u0280\u1d0f is a fast, intense XR tower-defense arcade experience that blends strategy and action. As an XRunner caught between reality and the digital matrix, a Breach opens in your room, sending DDoS swarms toward your NeuroGate. Place your turrets strategically across your space, then defend them from airborne Malworms trying to shut them down. Turn your room into a living AR battlefield and hold the line."}]}, "developer_name": null, "developer_privacy_policy_url": "https://aaagamestudios.com/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "AAA Games Studios S.L.", "support_website_url": "https://aaagamestudios.com/index.html#about", "website_url": "https://www.aaagamestudios.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "275629210202852"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24364900106485042"}}]}, "scheduled_offers": {"count": 5, "nodes": [{"status": "PUBLISHED", "id": "1023892840040328"}, {"status": "PUBLISHED", "id": "1351023910270710"}, {"status": "PUBLISHED", "id": "1502685468217217"},
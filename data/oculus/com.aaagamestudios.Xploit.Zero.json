L55toQ7kNvwFiTBUY&_nc_oc=Ado_otkY1nnDgh1gpx2a7lFW7T2ma0L41qnVCSG5U1WdKdbyzyUkJ1JeOdsFc-S1GsI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afwbu6lg-EjeVkxGotKzYu648HbfGXbKszZ8GrU62Q7UrQ&oe=69CD0F4F"}, {"file_name": "XPZ_Screenshot04.png", "id": "968014989220990", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823296_968014992554323_7156409964858030018_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HDNPML2mgR8Q7kNvwHG1dnw&_nc_oc=AdqTGUnTD1X7EogreQeFJnRnvVdhxRvdQ8GDgmESmvaT0XENyrZdChmUlc-NPbXtNs8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyxzPtK_GiJtVdkTBd4hEvqD9j_izDcUSwS9Rmox3uYSw&oe=69CD26E1"}, {"file_name": "XPZ_Screenshot05.png", "id": "967045972505631", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491821081_967045975838964_1133222401294464158_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dij7jWE37lsQ7kNvwF03kps&_nc_oc=Adp9Da9JUKKa4OPOZJ0Vm9fXJnxVpPkFpZ5i_q4hzqGx-vLOdTQ2XCQMIEfDfp6C0J0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyjJ2M1Rpbm6ic5hes46G-AtAII8YRYaX-xbSSGQ2Mmng&oe=69CD0C5C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "XploitZERO_Key Art_Landscape.png", "id": "851391407496299", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823783_851391414162965_4053303436264422722_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=p97VTLHAE84Q7kNvwGqrDL7&_nc_oc=AdrgXNr2HVZ16KwIDPwutVT-kvTBw2rt5y5Um7qW9PQ6F2farPVkFVKEfrn7zr3_rh0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwB_Eu8ScwmOsSNfM09F6c7D-BOn5Q-4bb7-fpFcOkHqQ&oe=69CCFA74"}, "display_name": "Xploit ZERO", "keywords": ["Arcade", "Fitness", "Action", "MR", "Defense"], "long_description": "# Turn your room into a battlefield and defend it in mixed reality\n\nIn Xploit ZERO, digital enemies invade your real-world space. Your room becomes the map, and every corner counts.\n\nXploit ZERO is a mixed reality arcade tower-defense game where your real room becomes the battlefield. Place turrets anywhere in your environment, react in real time, and fight off waves of enemies trying to overwhelm your defenses. Move, aim, and adapt as the pressure increases. Survival depends on your strategy.\n\n# \ud83c\udfe0 Your room becomes the map\nPlay directly in your real environment using Mixed Reality (MR).\n\n# \u2694\ufe0f Place turrets anywhere\nCollect **Memory Cores** to build your defense strategy.\n\n#  \ud83d\udc7e Fight incoming waves\nEnemies attack from multiple directions, stay alert.\n# \u26a1 Physical interaction\nUse your hands to build, place, and control your defenses, and engage in first-person combat against flying enemies.\n# \u231bFast-paced gameplay\nReact quickly and adapt your strategy in real time as the pressure increases.\n# \ud83c\udfae Game Modes\n**Countdown Mode**  \nA fast-paced **5-minute countdown** designed for intense arcade sessions.\n\n**Endless Mode**  \nSurvive as long as possible and chase high scores under constant pressure.\n\n# \ud83d\udcac Early Access & Community\nXploit ZERO is available in **Early Access** with **5 fully playable levels**, offering a complete experience from day one. Follow Xploit ZERO on social media and join us as we push innovation forward.\n\n# \u2139\ufe0f Play Space \nTo enjoy a better experience, make sure you have at least 8 ft x 8 ft (2.5 m x 2.5 m) of play space.", "short_description": "Turn your room into a battlefield and defend it in mixed reality\n\nIn Xploit ZERO, digital enemies break into your physical space. Place turrets anywhere, react in real time, and survive waves of enemies invading your room."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.aaagamestudios.com/xploit.zero/privacy-policy.html", "developer_terms_of_service_url": "https://www.aaagamestudios.com/xploit.zero/legal-notice.html", "publisher_name": "AAA Games Studios S.L.", "support_website_url": "https://www.aaagamestudios.com/xploit.zero/early-access.html", "website_url": "https://www.aaagamestudios.com/xploit.zero/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "275629210202852"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26131929533115415"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491819854_855276044208904_8226690140496844957_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6ZmUXy1sPh8Q7kNvwFsndyC&_nc_oc=AdqhBsaZB9T9tNf4elUC2d7v46BdjXgDJ_rcp2jV_Tgdf_KRw8JOyIhIMA_U4xDhsfo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afxg4tYLyjv_oprtFoX2l6bnzXjPKlW3gJJoTL2o7COLNg&oe=69CCF95B"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Xploit ZERO", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Action", "id": "459781504968480"}, {"topic_name": "Strategy", "id": "275629210202852"}, {"topic_name": "Arcade", "id": "1592192974313489"}], "release_date": 1773757800, "lastRevision": {"nodes": [{"id": "24364900119818374", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "24364900086485044", "is_first_party": false, "enables_in_app_ads": false, "is_concept": false, "platform": "ANDROID_6DOF"}, "iarc_cert": {"id": "871850802469799"}, "
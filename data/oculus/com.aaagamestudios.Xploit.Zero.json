7pEKns&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afzet1sbqqZxoHU3xu3Z7xoyEgHxucsvYv5KAahDpQ7pIg&oe=69C28927"}, {"file_name": "XPZ_Screenshot_02.png", "id": "1980772412493923", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491824318_1980772415827256_4576371616307416305_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sxntw5vrUe0Q7kNvwEVUF75&_nc_oc=AdroSsePQw-wfvBkFoBHGC8NyjIjalDYqlOGURdRh0X6_Dsxjr4OsGMQSBrhiXr68ZI&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzDUMu2lSHsIR99tKmsP-16II0PNPjDVXwT1kXUqVyjTw&oe=69C288CB"}, {"file_name": "XPZ_Screenshot_08.png", "id": "1218343156836030", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/491825415_1218343160169363_2263201430021844960_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TWbiNGbA3AIQ7kNvwFtROze&_nc_oc=AdpfNUFsdUXZPfp2IXMjfmUeqTybSwxRWjW7nUQZV_LaujTWOFSNCANx3i5st4lXuPs&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfznOWs3uPliu3FAOMAZ8CLKZlR4lxBaEcuGSIVlE5arOA&oe=69C28536"}, {"file_name": "XPZ_Screenshot_06.png", "id": "854632523638947", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/491818900_854632526972280_6701071052096553381_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9qSDwv7TyCkQ7kNvwEyYfBQ&_nc_oc=AdroI9FMiz3aFvSu75KXbWepskfHBIlxX7FvxUV4i0veYjEOyzKLvjMDzQSSbswK9ko&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxltNWp0OsYGfaIqtYW70cNkjPBcCoku3_mWnZOZX2FAg&oe=69C26BE8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "XploitZERO_Key Art_Landscape.png", "id": "851391407496299", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/491823783_851391414162965_4053303436264422722_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3yuGjmUrM3oQ7kNvwEVQ7Pc&_nc_oc=AdqMH1Ai3Lmy7w0zQp6_sz4VeIqG6VcU-PVKHmFXT6DKxRPE6dXOKXMMBrGzMFqHr3g&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afzr0reiq3hBNE5NY2F16FYgwEHfSkDhF2UXNDxLa38jTA&oe=69C26E74"}, "display_name": "Xploit.Zero", "keywords": ["Hacker", "Turret", "Virus", "AR", "Arcade"], "long_description": "Zploit.\u1d22\u1d07\u0280\u1d0f puts you in the role of a XRunner whose connection to reality has been compromised.\nA security Breach has opened inside your room, and the invading viruses have found a path toward your NeuroGate, the anchor preventing your consciousness from becoming lost within the digital matrix.\n\nBuild turrets to defend yourself from DDoS viruses, swarms that advance from the Breach following routes projected across your own room.\nSimultaneously, protect those turrets from the relentless attacks of Malworm viruses, airborne creatures that strike from above to disable your defenses.\n\nOrganize your defenses and turn your room into a true Augmented Reality battlefield.\nYou decide where to place your turrets and how to adapt your space to withstand the digital assault.", "short_description": "Zploit.\u1d22\u1d07\u0280\u1d0f is a fast, intense XR tower-defense arcade experience that blends strategy and action. As an XRunner caught between reality and the digital matrix, a Breach opens in your room, sending DDoS swarms toward your NeuroGate. Place your turrets strategically across your space, then defend them from airborne Malworms trying to shut them down. Turn your room into a living AR battlefield and hold the line."}]}, "developer_name": null, "developer_privacy_policy_url": "https://aaagamestudios.com/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "AAA Games Studios S.L.", "support_website_url": "https://aaagamestudios.com/index.html#about", "website_url": "https://www.aaagamestudios.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "275629210202852"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection
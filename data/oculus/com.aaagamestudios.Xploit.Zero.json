om&_nc_ss=7f20f&oh=00_AQJFKmx9WBjwiOfj9-uElUJvoPvUnThT2Jj3gUJQsUM6sg&oe=6AA2B09D"}, {"file_name": "XploitZERO_Screenshot_Enemies.png", "id": "26388955970726953", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491825575_26388955974060286_4311064872432007175_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s-o-RWZ-5jcQ7kNvwF5lHvd&_nc_oc=AdqHIL133pHOA-DTkugan9YZni4CWR8crJOhlFzV1qnlLnNI7LvZ7T97q2rASCvDtUc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLXjHsv-BEBdLQd5Ez2O-eL8bezap92fNmKDUBcBVCL7w&oe=6AA2CA0B"}, {"file_name": "XPZ_Screenshot04.png", "id": "968014989220990", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823296_968014992554323_7156409964858030018_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3PBEJXeFmd0Q7kNvwF6Ohcp&_nc_oc=AdqoN4sBPS4WBWbz4rLf6ibu_tXfZfhVBaguh7rcH1oLtHEg5bFTRrNcRo1R--34u3Q&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIwJWbST27qHXLQiVqX5lyx-a8PEcyVKGVGjmr-lL_meg&oe=6AA2B9E1"}, {"file_name": "XPZ_Screenshot03.png", "id": "792272050144473", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491825034_792272053477806_1043335263352651152_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PqMdVxlyUJwQ7kNvwG17iX3&_nc_oc=Adoqi54hDCUKDZQ5k8iQST1akRRFG0EdTVlYbOUEbuSlqrHIGDdzDMy2HIfPvOinsTw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKDcAM99U5n7G3FWM00yTouxGviUylL9pTE7kQVqM-aZg&oe=6AA2A24F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "XploitZERO_Key Art_Landscape.png", "id": "851391407496299", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823783_851391414162965_4053303436264422722_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EYdhqXYXS0sQ7kNvwFDGT-n&_nc_oc=AdpwTDRV5jOsDoXbDylDFiaQ2_7fMEiQH-HOC6bvalqneyA5GGogAy9UiOvuq_mo6nk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ-RMt3fZkUCj5KUKdZKz1wTpcK4coEG3xP1BcWyUAGOQ&oe=6AA2C5B4"}, "display_name": "Xploit ZERO", "keywords": ["fitness", "combat", "invaders", "fastpaced", "tactics"], "long_description": "An ultra-massive cyber\u2011attack is threatening to cut off your link to reality. To survive, think fast, gather memory cores, fortify your defenses, and react in real time to repel invaders. Do you dare?\n\n**Xploit ZERO is a Mixed Reality action\u2011strategy game where your real room becomes the battlefield.**\n\n{1283311743754604}\ud83c\udfe0 Scan your room in seconds and jump into the action {26394552166891673}\u2694\ufe0f Gather resources and fortify. Time is pressing {2608985609496919}\u26a1Move fast and tear down incoming drones {2659403194432547}\ud83d\udc7e Enemies evolve. So must your defenses {987509193801569}\ud83d\udd25 Fast, intense, replayable. Guaranteed fun\n\n\u2139\ufe0f **Early Access & Community**\n\nXploit ZERO is available in Early Access with 5 fully playable levels and 2 difficulty settings, delivering hours of extreme fun from day one. Follow Xploit ZERO on social media and join us as we push innovation forward.", "short_description": " Xploit ZERO is a Mixed Reality action\u2011strategy game where your real room becomes the battlefield. Think fast, build your defenses, and react in real time to repel invaders in short, engaging bursts of pure fun. Do you dare?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.aaagamestudios.com/xploit.zero/privacy-policy.html", "developer_terms_of_service_url": "https://www.aaagamestudios.com/xploit.zero/legal-notice.html", "publisher_name": "AAA Games Studios S.L.", "support_website_url": "https://www.aaagamestudios.com/xploit.zero/early-access.html", "website_url": "https://www.aaagamestudios.com/xploit.zero/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "275629210202852"}, {"id": "644354873106712"}, {"id": "1592192974313489"}], "external_subscription_ty
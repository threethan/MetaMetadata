pexlClA0sZuyw&oe=6B048121"}, {"file_name": "XPZ_Screenshot03.png", "id": "792272050144473", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491825034_792272053477806_1043335263352651152_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LPgMFeIrFQ8Q7kNvwHe2YV4&_nc_oc=AdpUUv7gAdnYDDmT9nB2EPF67Ev5VX0sBiMYPX0Nqx2I20xw8DM3SBwdmMwvtoT_GAg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTzDdFTmX5IU5XH3DCAL5bCAmcSv6FY1qUnnjAF3hM74w&oe=6B04698F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "XploitZERO_Key Art_Landscape.png", "id": "851391407496299", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823783_851391414162965_4053303436264422722_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Cgyu5h9Eh9gQ7kNvwFnOzZ1&_nc_oc=AdouxD-FiUeSkyqjAZqhcNxmW5kWfHnKoAwGD4afXb2E5xlQICzW3qVWEd8cD1G-uZc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSB1Agqnxwv4sqAgKXR4yrXxrl1DzJBtodhc1seW6vaDw&oe=6B0454B4"}, "display_name": "Xploit ZERO", "keywords": ["fitness", "combat", "invaders", "fastpaced", "tactics"], "long_description": "An ultra-massive cyber\u2011attack is threatening to cut off your link to reality. To survive, think fast, gather memory cores, fortify your defenses, and react in real time to repel invaders. Do you dare?\n\n**Xploit ZERO is a Mixed Reality action\u2011strategy game where your real room becomes the battlefield.**\n\n{1283311743754604}\ud83c\udfe0 Scan your room in seconds and jump into the action {26394552166891673}\u2694\ufe0f Gather resources and fortify. Time is pressing {2608985609496919}\u26a1Move fast and tear down incoming drones {2659403194432547}\ud83d\udc7e Enemies evolve. So must your defenses {987509193801569}\ud83d\udd25 Fast, intense, replayable. Guaranteed fun\n\n\u2139\ufe0f **Early Access & Community**\n\nXploit ZERO is available in Early Access with 5 fully playable levels and 2 difficulty settings, delivering hours of extreme fun from day one. Follow Xploit ZERO on social media and join us as we push innovation forward.", "short_description": " Xploit ZERO is a Mixed Reality action\u2011strategy game where your real room becomes the battlefield. Think fast, build your defenses, and react in real time to repel invaders in short, engaging bursts of pure fun. Do you dare?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.aaagamestudios.com/xploit.zero/privacy-policy.html", "developer_terms_of_service_url": "https://www.aaagamestudios.com/xploit.zero/legal-notice.html", "publisher_name": "AAA Games Studios S.L.", "support_website_url": "https://www.aaagamestudios.com/xploit.zero/early-access.html", "website_url": "https://www.aaagamestudios.com/xploit.zero/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "275629210202852"}, {"id": "644354873106712"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26345301128444920"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491819854_855276044208904_8226690140496844957_n.png?stp=dst-png_s360x360&_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qbW48gpSeWsQ7kNvwEBuAwi&_nc_oc=AdpGnm3-rdF55vIoivVD1q5yE_YUxRg6vQl41sQqIDpB9debHb0N5GsULLZcDTF2rBo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQiYepwtTL8ifgLjnzWg67QAlGMTiFjuEHGdLVFPKiM7w&oe=
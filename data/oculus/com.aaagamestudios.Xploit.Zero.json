9854_1737093740983810_4984110102426265163_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cuPKvuU5RkEQ7kNvwH_atNA&_nc_oc=AdoszrFMEozOjlAE6aXO3ObBR8vP29eQ2mKcH1twUU5jn71MOshHpSbcD8Y1yWL1vks&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af91RETiJV0kfeLihNO84j5pNKE0qqbtIek0rRaW3fc_Og&oe=6A36C5F8"}, {"file_name": "screenshot2.png", "id": "897711773319097", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/491821725_897711776652430_3737280325436544967_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m5T38EevUXkQ7kNvwHon9X8&_nc_oc=AdorxinT79UT9iGXnfxEHhynbRMLpX7-JtSiGFaMB1Eal6L4qIzLzQjy4pJA1QeTF_k&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8AWqq73KJSQhxbr1CvbJdEMvnl2uyUcu2hPHNijR308A&oe=6A3694AC"}, {"file_name": "screenshot3.png", "id": "962799192964192", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/491821674_962799196297525_6177054777544388345_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2R8y1P6pTfcQ7kNvwEL9pXp&_nc_oc=Adrb7oJTNqxnEbH2zrmKAvFISt9K9k9n-Xr2V3Zx3uiFoKfJMjDCq25__iCE5OPTdpo&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_t5ItactchZNbE9T0woADISAhHlFp1eVNT2yfYmw1hfg&oe=6A36B54C"}, {"file_name": "screenshot4.png", "id": "1646142613384875", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/491823279_1646142616718208_915422939693559853_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hPIBRj4yA28Q7kNvwEZleif&_nc_oc=AdqxhNr7HbmV6LAFQxEZIJfWtP7c7Xme-qrP8i15YYPv54a8RdUv2pxjKKpHiKUDZD8&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9lv_5z2hzCXRlGdkLz7TMDs53gE47n_4depdMWmicy-g&oe=6A36946D"}, {"file_name": "screenshot5.png", "id": "1873764566915913", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/491819845_1873764573582579_4301038171609040086_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o6pJkLzzHIkQ7kNvwEwg7h3&_nc_oc=AdrwUWIoHaFmhugtwyL-GAHQhAXwO7eF-pPwi475sG_bRUhHWPuHNBDyeWle7p3NS3E&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9-WqBdnQZBivux4LMHI49QzqmUZZZRegAwZr6vcdPRhw&oe=6A36B8EA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "imagen de portada.png", "id": "1622714972349258", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/491820855_1622714975682591_1524617146993487012_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=APtIxwSATFgQ7kNvwEUPkph&_nc_oc=AdoFr47Z5MaCBD83Y_g-GNCMEOXkdQnLkhiDHcbzKNQ1RsFc8aevHY5iRliTr06Y35U&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-7CLSRBwDWzFzwwCG2zqJh54MoVY8SglRaWEfUx3qX6A&oe=6A36B7CD"}, "display_name": "Xploit ZERO", "keywords": ["fitness", "combate", "invasores", "r\u00e1pido", "t\u00e1ctica"], "long_description": "Un ciberataque amenaza con cortar tu \u00faltimo v\u00ednculo con la realidad. Para sobrevivir, piensa r\u00e1pido, re\u00fane n\u00facleos de memoria, fortifica tu posici\u00f3n y reacciona \u00e1gilmente para repeler a los invasores. \u00bfTe atreves?\n\n**Xploit ZERO es el juego de acci\u00f3n y estrategia en Realidad Mixta que convierte tu propia habitaci\u00f3n en un campo de batalla.**\n\n{1507763590969456}\ud83c\udfe0 Escanea tu habitaci\u00f3n en segundos y l\u00e1nzate a la acci\u00f3n.{27062951439996127}\u2694\ufe0f Consigue recursos y fortifica. El tiempo apremia.{1358224226114774}\u26a1Mu\u00e9vete r\u00e1pido y derriba los drones enemigos.{1443354170218761}\ud83d\udc7e  Los atacantes evolucionan; tus defensas tambi\u00e9n.{1209753834367151}\ud83d\udd25 R\u00e1pido, intenso y rejugable. Diversi\u00f3n garantizada.\n\n\u2139\ufe0f Acceso Anticipado & Comunidad.\n\nXploit ZERO est\u00e1 disponible en Acceso Anticipado (\"Early Access\") con 5 niveles completamente jugables y 2 modos de dificultad, ofreciendo horas de diversi\u00f3n extrema desde el primer d\u00eda. Sigue a Xploit ZERO en redes sociales y ay\u00fadanos a llevar la innovaci\u00f3n a\u00fan m\u00e1s lejos.", "short_description": "Xploit ZERO es el juego de acci\u00f3n y estrategia en Realidad Mixta que convierte tu habitaci\u00f3n en un campo de batalla. Piensa r\u00e1pido, construye tus defensas y reacciona en tiempo real para repeler a los invasores en partidas cortas, intensas y llenas de diversi\u00f3n. \u00bfTe atreves?"}, {"images": {"nodes": [{"file_name": "Xploit_zero_360.2.png", "id": "26529534970073330", "image_type": "APP_IMG_CUBEMAP_SOURCE", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/595136811_26529534980073329_7286307846810146766_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zNYvBJlQNFgQ7kNvwFRZ2wT&_nc_oc=AdoRpItVgNOnkRQtkogVPF_BWCLCnfAo_SBJQztEv7mwnGVHvJ0x1Bew4whMer3tF98&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9T_maaScqfHPHCFgLMTvgMODNdJ8pLKIKxrnQD5TIkRA&oe=6A36AFD6"}, {"file_name": "Shot2.png", "id": "26394552166891673", "image_type": "APP_IMG_MARKDOWN_INLINE", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/491828104_26394552180225005_6856735165680477736_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=63u7JP0POVsQ7kNvwHA9s9_&_nc_oc=AdoPL1yqS1hXO1ZlPGiXP5xZI4S8n07V_hJgPSJogn2-VTcuZ0qJAgFhiBUjOUpaFIU&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8uHTcPANVFfMtYAkDkhuHDak8SplT0RWsJkVyJzb5nUQ&oe=6A36B722"}, {"file_name": "Shot5.png", "id": "3160157457501506", "image_type": "APP_IMG_MARKDOWN_INLINE", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/499298502_3160157460834839_8317283677516400765_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3U_nZdhcKVwQ7kNvwGKfEN3&_nc_oc=AdpPmu4DOsUX5wVkR7UPAt47nVNUuckBeD05508wx98Leg90MKpn9WI5_t1dSYhdrPs&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af80tJPJfSJtv2ygkMdKDT-O0tYQRKVZOoEQkBgQOTVCVg&oe=6A36BF19"}, {"file_name": "Shot3.png", "id": "2659403194432547", "image_type": "APP_IMG_MARKDOWN_INLINE", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/491824322_2659403197765880_1538727125860821274_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=muFuUm5njA0Q7kNvwEEdaG9&_nc_oc=AdqaziM5ynkc
AQBOGJkcvq8EeYZTo3-eIbR4sGNPekHMsDExN6C4z9ggtg&oe=6A5624AA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "imagen de portada.png", "id": "1622714972349258", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/491820855_1622714975682591_1524617146993487012_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Xeucp-Gd7J8Q7kNvwG0-ULz&_nc_oc=Adrms2rc7aCaH5TBgpKP0ypnUfX_LoOwalCx2lgiFndAEOZ1HRWUJXlZJpm8WW0QmwY&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCYVzxcPd3dSVqcB8ThUVeanbkQisUWRVwInUfIpEze4A&oe=6A56238D"}, "display_name": "Xploit ZERO", "keywords": ["fitness", "combate", "invasores", "r\u00e1pido", "t\u00e1ctica"], "long_description": "Un ciberataque amenaza con cortar tu \u00faltimo v\u00ednculo con la realidad. Para sobrevivir, piensa r\u00e1pido, re\u00fane n\u00facleos de memoria, fortifica tu posici\u00f3n y reacciona \u00e1gilmente para repeler a los invasores. \u00bfTe atreves?\n\n**Xploit ZERO es el juego de acci\u00f3n y estrategia en Realidad Mixta que convierte tu propia habitaci\u00f3n en un campo de batalla.**\n\n{1507763590969456}\ud83c\udfe0 Escanea tu habitaci\u00f3n en segundos y l\u00e1nzate a la acci\u00f3n.{27062951439996127}\u2694\ufe0f Consigue recursos y fortifica. El tiempo apremia.{1358224226114774}\u26a1Mu\u00e9vete r\u00e1pido y derriba los drones enemigos.{1443354170218761}\ud83d\udc7e  Los atacantes evolucionan; tus defensas tambi\u00e9n.{1209753834367151}\ud83d\udd25 R\u00e1pido, intenso y rejugable. Diversi\u00f3n garantizada.\n\n\u2139\ufe0f Acceso Anticipado & Comunidad.\n\nXploit ZERO est\u00e1 disponible en Acceso Anticipado (\"Early Access\") con 5 niveles completamente jugables y 2 modos de dificultad, ofreciendo horas de diversi\u00f3n extrema desde el primer d\u00eda. Sigue a Xploit ZERO en redes sociales y ay\u00fadanos a llevar la innovaci\u00f3n a\u00fan m\u00e1s lejos.", "short_description": "Xploit ZERO es el juego de acci\u00f3n y estrategia en Realidad Mixta que convierte tu habitaci\u00f3n en un campo de batalla. Piensa r\u00e1pido, construye tus defensas y reacciona en tiempo real para repeler a los invasores en partidas cortas, intensas y llenas de diversi\u00f3n. \u00bfTe atreves?"}, {"images": {"nodes": [{"file_name": "Xploit_zero_360.2.png", "id": "26529534970073330", "image_type": "APP_IMG_CUBEMAP_SOURCE", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/595136811_26529534980073329_7286307846810146766_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IfIkHzKUI-gQ7kNvwEsZB2d&_nc_oc=AdoXrp_eWAdT3XPl-9OKMjIIfuOMAaBbfNKX9cgV9-Ply2T4nni7yDvZhN2D-cGKmwg&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDQNnHiL2PkVp4i8xICn4x1JkX_CYSnCZPNnUnEhcbQgA&oe=6A5653D6"}, {"file_name": "Shot2.png", "id": "26394552166891673", "image_type": "APP_IMG_MARKDOWN_INLINE", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/491828104_26394552180225005_6856735165680477736_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vBgtY0hsALwQ7kNvwHQE6N4&_nc_oc=AdrBzHOOINrr6QLL7A4jplrf05ayBWN8WuRNu0DWvHbAMyjEQJllrDtahK1V3bbbtxY&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC4EZhmVjs4bCWazY0gHEb-5izakIkWgLu5jbl72Budcw&oe=6A5622E2"}, {"file_name": "Shot5.png", "id": "3160157457501506", "image_type": "APP_IMG_MARKDOWN_INLINE", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/499298502_3160157460834839_8317283677516400765_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b7vZLADL0TsQ7kNvwEXJNxJ&_nc_oc=AdogbxwsohRfGEYOkZnd1eXq_Rmbbe2mnASOt7NYBJ33GSnERPVgXYXfSCQ2QfY46Ew&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAecQPHWaPlrPk4b7Ycv1BCis1TjOKEx2bNYfSBU8Jf9A&oe=6A562AD9"}, {"file_name": "Shot3.png", "id": "2659403194432547", "image_type": "APP_IMG_MARKDOWN_INLINE", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/491824322_2659403197765880_1538727125860821274_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vAmzDxGQNBMQ7kNvwEje75j&_nc_oc=Adp7DecKBxnX-YdgMB0a3sDmMdXoFl4X0gQ
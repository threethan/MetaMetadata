c_ohc=pC48LXheF4YQ7kNvwEG3iOi&_nc_oc=Adrvn-uaMQ9f_1hkCieSSvWErb4jxZLgEcmxKtT8-EY4gYVvCGrsHOhxI76MIzPhXIk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af3SRGrmIsMWzh6tbZ_laZ1sg4SMYEKcS9BGdc-ecVGScA&oe=69F0BF61"}, {"file_name": "XPZ_Screenshot03.png", "id": "792272050144473", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491825034_792272053477806_1043335263352651152_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CStlv5zV7YgQ7kNvwHOilMg&_nc_oc=AdoAvDBDZyZEiD8VFUm_YttidXsZ2oH4meTh0p2hMadEbislEXOfSoEDWEhBEz3v-6Q&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af0cQOXzIxNSwWZrqbU6sUXYiPmcZAnt5CNuXPw0TFyzeg&oe=69F0A7CF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "XploitZERO_Key Art_Landscape.png", "id": "851391407496299", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823783_851391414162965_4053303436264422722_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jw1BZTMafGAQ7kNvwF4gu3L&_nc_oc=AdowXoEzYPFISrIm0SPQ_BM3r6qYhO49i07l7EGF2vrjI1unVZsTh4UiW4-crLlATD0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af2tqefiEPpJ1ggH94BXCAtMfmTUnfcuROVjcN4YS0poeg&oe=69F0CB34"}, "display_name": "Xploit ZERO", "keywords": ["fitness", "combat", "invaders", "fastpaced", "tactics"], "long_description": "An ultra-massive cyber\u2011attack is threatening to cut off your link to reality. To survive, think fast, gather memory cores, fortify your defenses, and react in real time to repel invaders. Do you dare?\n\n**Xploit ZERO is a Mixed Reality action\u2011strategy game where your real room becomes the battlefield.**\n\n{1283311743754604}\ud83c\udfe0 Scan your room in seconds and jump into the action {26394552166891673}\u2694\ufe0f Gather resources and fortify. Time is pressing {2608985609496919}\u26a1Move fast and tear down incoming drones {2659403194432547}\ud83d\udc7e Enemies evolve. So must your defenses {987509193801569}\ud83d\udd25 Fast, intense, replayable. Guaranteed fun\n\n\u2139\ufe0f **Early Access & Community**\n\nXploit ZERO is available in Early Access with 5 fully playable levels and 2 difficulty settings, delivering hours of extreme fun from day one. Follow Xploit ZERO on social media and join us as we push innovation forward.", "short_description": " Xploit ZERO is a Mixed Reality action\u2011strategy game where your real room becomes the battlefield. Think fast, build your defenses, and react in real time to repel invaders in short, engaging bursts of pure fun. Do you dare?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.aaagamestudios.com/xploit.zero/privacy-policy.html", "developer_terms_of_service_url": "https://www.aaagamestudios.com/xploit.zero/legal-notice.html", "publisher_name": "AAA Games Studios S.L.", "support_website_url": "https://www.aaagamestudios.com/xploit.zero/early-access.html", "website_url": "https://www.aaagamestudios.com/xploit.zero/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "275629210202852"}, {"id": "644354873106712"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26345301128444920"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491819854_855276044208904_8226690140496844957_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=meS4Oa-_VCEQ7kNvwHPjdCY&_nc_oc=Adr7i56L2qWX2GvcDXajgLn6ILneptHomggM2UeaMViVlOaYohw63u-lkwOwlagRRsg&_nc_zt=3&_nc_ht=scontent-iad6
cdn.com/v/t64.5771-25/499312046_4006086976386010_7025838585055209175_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u1DMeIb9xm0Q7kNvwHw5K7m&_nc_oc=AdpJWwLmzmFdxA4FipGJR5edWG5a5x-4BgSCNb6zsnjJ_X8hXbp7svGsXUEhSXiDsFw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFxWHeYn_ijrrSGgxjFvn8YM2CTNJbz26JHaVXXyB5tqg&oe=6A8C2A8A"}, {"file_name": "screenshot_LaserT_6.png", "id": "1346303313112432", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499304162_1346303316445765_639425653150023621_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wwaHke6F1jgQ7kNvwE6zjtH&_nc_oc=AdrGE76Ek9K7XjtvdkMAjTudM4G0jqlCoCKMObALxGpu2_ctL5QeYivWpB6LnsoJ_PY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG0R7xIIfLzaQREErm0B7X1wypPzzH24NS8DKsNXZmGPA&oe=6A8C2184"}, {"file_name": "screenshot_LaserT_2.png", "id": "1376210856975287", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499297140_1376210860308620_7491228154117118837_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DpRmz4ecRO4Q7kNvwHQl3fR&_nc_oc=AdrP44JYRZAgTpLd_i8rzxgNgpQ2y_JnWH7aS9QotGM6m-WrNLSTsZpNRyiHhj3yY5k&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGrGG-XIyHeqalztPjDGn4o4BkOBTqA6YflRB4whGg55Q&oe=6A8C20CE"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Optics Table PRO - Snell's Law", "keywords": ["physics", "Laser"], "long_description": "*** TO ACCESS THIS VERSION, A LICENSE IS REQUIRED AND IT CAN BE ACQUIRED DIRECTLY THROUGH XENNIAL OR ONE OF ITS DISTRIBUTION PARTNERS. ***\n\nWelcome to Xennial\u2019s Virtual Reality (VR) Optics Table, an immersive educational experience designed for Middle and High School Physics programs. This immersive STEM learning experience brings the principles of Snell\u2019s Law of Light Reflection and Refraction to life, eliminating the need for traditional and expensive lab equipment. The VR Optics Table includes features such as single-beam and triple-beam lasers, lenses, and mirrors, offering 
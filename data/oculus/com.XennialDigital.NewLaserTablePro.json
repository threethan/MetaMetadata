329054", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499304720_1497222881662387_8769496744960022477_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f8LqvzS-Ye4Q7kNvwHT9jXb&_nc_oc=Adnxu5zapttTXlKCQSfY3SX6KkFfwRoZqCJfIIsfWckwGsb_bMR6gO6D3UqayXor9Zg&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Aft-sV70cAknS79mCgWYG5mLjQ5FzIygxn5_L9xKC_Rcdw&oe=69A828C4"}, {"file_name": "screenshot_LaserT_1.png", "id": "4006086973052677", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499312046_4006086976386010_7025838585055209175_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tc_cjK43vBUQ7kNvwEAWbgV&_nc_oc=Adn27Booikt59BR8jHBHxUXqderv3iooXSCJ6XmgjcKBLt8BoVRUOBvDkLIdA6wf57k&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afs6oS_ZHJo4hsQGqoUdatyItteaozrK24kpG1OdMhDiqw&oe=69A8170A"}, {"file_name": "screenshot_LaserT_6.png", "id": "1346303313112432", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499304162_1346303316445765_639425653150023621_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MkELteOiD7QQ7kNvwEeyAYl&_nc_oc=Adl0A8rUEcYyO5y9dOR6c6qfDh8I2_dRvqKme1_Y6OR3NECyqNh_GjmEFpk0LFjNi9w&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfuS-qeTkHyou66BtJ6SF0GMysSAEP1CWYhLDBVJYdyFWQ&oe=69A80E04"}, {"file_name": "screenshot_LaserT_2.png", "id": "1376210856975287", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499297140_1376210860308620_7491228154117118837_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=osYWIr5NGRQQ7kNvwFU-Xs-&_nc_oc=AdkjT-ZjFD5n5c5ZTOhTdBdVTSBvRDabciMf92XPmUu_EPZmfLWARCy-qArXC8v7auU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AftnwKP6GHerfWcDgYiYamYIZaTX13I6kfz_XV2i4mzBgw&oe=69A80D4E"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Optics Table PRO - Snell's Law", "keywords": ["physics", "Laser"], "long_description": "*** TO ACCESS THIS VERSION, A LICENSE IS REQUIRED AND IT CAN BE ACQUIRED DIRECTLY THROUGH XENNIAL OR ONE OF ITS DISTRIBUTION PARTNERS. ***\n\nWelcome to Xennial\u2019s Virtual Reality (VR) Optics Table, an immersive educational experience designed for Middle and High School Physics programs. This immersive STEM learning experience brings the principles of Snell\u2019s Law of Light Reflection and Refraction to life, eliminating the need for traditional and expensive lab equipment. The VR Optics Table includes features such as single-beam and triple-beam lasers, lenses, and mirrors, offering hands-on exploration of light behavior.\n", "short_description": "This immersive STEM learning experience brings the principles of Snell\u2019s Law of Light Reflection and Refraction to life, eliminating the need for traditional and expensive lab equipment. \n\n*** IMPORTANT NOTE: THIS VERSION IS NOT FOR SINGLE DEVICES. TO ACCESS THE PRO VERSION, AN ANNUAL LICENSE IS REQUIRED AND CAN ONLY BE ACQUIRED DIRECTLY THROUGH XENNIAL OR ONE OF ITS DISTRIBUTION PARTNERS. TO LEARN MORE: XENNIAL@XENNIALDIGITAL.COM ***"}]}, "developer_name": "Xennial", "developer_privacy_policy_url": "https://www.xennialdigital.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Xennial", "support_website_url": null, "website_url": "https://www.xennialdigital.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}, {"id": "514087707868786"}], "external_subscription_type": "REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24536353469292677"}, "review_messages": []}]
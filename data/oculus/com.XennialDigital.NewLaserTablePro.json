cdn.com/v/t64.5771-25/499312046_4006086976386010_7025838585055209175_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3oFLFNVgVY8Q7kNvwHkcRlR&_nc_oc=AdoVRZPxAnq1wBispIwSa6qUAyYpJKgnua6hHbx1l0kisI4Y7VKA39tCgo82jm4bf6A&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af59TiE-meCP8BBjeVewB8dViFc5oridTMko2wJvQ8RUgA&oe=6A00A3CA"}, {"file_name": "screenshot_LaserT_6.png", "id": "1346303313112432", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499304162_1346303316445765_639425653150023621_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C6pYIs2YKDkQ7kNvwGl-IwW&_nc_oc=AdqxsZEsOFk7e7P-5DLO4mpAsISsdUjHrahP4B8Es40bcb9kG7-QfirzxMUcZgxnhtE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af71qKbvZnGaeerNB44VsDT8REIXRvqJcI0IZ0-qXAGwSg&oe=6A009AC4"}, {"file_name": "screenshot_LaserT_2.png", "id": "1376210856975287", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499297140_1376210860308620_7491228154117118837_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uIsLTYeFxoUQ7kNvwGsd2FI&_nc_oc=AdrxcwoGC21IXJjpTqC8TMnrBj-lR87eUyMOp3OHFFnARr2Y8YoGitn9XkvRMxmdvC0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4VIEZZoJUl2vTk-IYu1snJqEu2PDbIpjpKbAwZLGaH3w&oe=6A009A0E"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Optics Table PRO - Snell's Law", "keywords": ["physics", "Laser"], "long_description": "*** TO ACCESS THIS VERSION, A LICENSE IS REQUIRED AND IT CAN BE ACQUIRED DIRECTLY THROUGH XENNIAL OR ONE OF ITS DISTRIBUTION PARTNERS. ***\n\nWelcome to Xennial\u2019s Virtual Reality (VR) Optics Table, an immersive educational experience designed for Middle and High School Physics programs. This immersive STEM learning experience brings the principles of Snell\u2019s Law of Light Reflection and Refraction to life, eliminating the need for traditional and expensive lab equipment. The VR Optics Table includes features such as single-beam and triple-beam lasers, lenses, and mirrors, offering 
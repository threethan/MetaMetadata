cdn.com/v/t64.5771-25/499312046_4006086976386010_7025838585055209175_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mEljbsDP8GsQ7kNvwF97fCO&_nc_oc=AdqE-A0UbIIsP3s_V5XxZnq8IHg53N1u3_f1Ooywz80xsZpTKI9jYzDNFx4kvpV79co&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIjUrYZDlZG5X48XCSjrbWM6Z_rj9p_6mt-vDNTbpW8Og&oe=6A9ED7CA"}, {"file_name": "screenshot_LaserT_6.png", "id": "1346303313112432", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499304162_1346303316445765_639425653150023621_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VkcVWfpVNscQ7kNvwFme5-d&_nc_oc=AdqLk-sDK0WGz6HnJCb2GTvO8wiRR6RlVxh2MaXBgcHcIhEvVc09E-A_4RPjxr6AovU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJyZNaF3TtKhSOBq3-b7IhqZ1FdtAnCqOSz2-3uiUSyyQ&oe=6A9ECEC4"}, {"file_name": "screenshot_LaserT_2.png", "id": "1376210856975287", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499297140_1376210860308620_7491228154117118837_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pv93-fpr4PkQ7kNvwHculQ_&_nc_oc=AdoBGNQXZgNVeSa0pJXbZS4An2P-BTvl5JrOxLHcUk2dyZng9QzYzPRkPiNIHcY1Csc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLDANSBInIKAoabK8OV0rHBOFFMzpKYc_6YVS7tptgijA&oe=6A9ECE0E"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Optics Table PRO - Snell's Law", "keywords": ["physics", "Laser"], "long_description": "*** TO ACCESS THIS VERSION, A LICENSE IS REQUIRED AND IT CAN BE ACQUIRED DIRECTLY THROUGH XENNIAL OR ONE OF ITS DISTRIBUTION PARTNERS. ***\n\nWelcome to Xennial\u2019s Virtual Reality (VR) Optics Table, an immersive educational experience designed for Middle and High School Physics programs. This immersive STEM learning experience brings the principles of Snell\u2019s Law of Light Reflection and Refraction to life, eliminating the need for traditional and expensive lab equipment. The VR Optics Table includes features such as single-beam and triple-beam lasers, lenses, and mirrors, offering 
cdn.com/v/t64.5771-25/499312046_4006086976386010_7025838585055209175_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gmTWlMbesqcQ7kNvwESZAj0&_nc_oc=AdpPyrJQhF3VnzuXqPRMqi0Iy6YfjGE3HCyG3D9rqFc1cONM5xFovV3JfJaicNeyhaM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFPPdqsyi2BQIIHdC_mGzgFi30NybzrRlrjSZM9gHM1VA&oe=6A7B070A"}, {"file_name": "screenshot_LaserT_6.png", "id": "1346303313112432", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499304162_1346303316445765_639425653150023621_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sM1_LMJl1cQQ7kNvwHTRV7D&_nc_oc=AdrYGhNasKITPQgd-TRRXYR4tKmQMi5IFmkC78xfI5pPdYecgahEXI4sblW1c40h0zQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGl5pp5ur2qdJP9K2br0cDJlGb2IIf81-A05Hp_OP6SMA&oe=6A7B3644"}, {"file_name": "screenshot_LaserT_2.png", "id": "1376210856975287", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499297140_1376210860308620_7491228154117118837_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LDEO2jlPJXMQ7kNvwEjCQhp&_nc_oc=Adq_W8jQZkJGZVj-ZJTwI9aTNNCM76cYAGIIzCkwx17o46F2BKfroa3lnl779av1ZxI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEhgVNgo07zXpEN1TZSZW5nsq0EvBN5J6HpXzeO5RBWZw&oe=6A7B358E"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Optics Table PRO - Snell's Law", "keywords": ["physics", "Laser"], "long_description": "*** TO ACCESS THIS VERSION, A LICENSE IS REQUIRED AND IT CAN BE ACQUIRED DIRECTLY THROUGH XENNIAL OR ONE OF ITS DISTRIBUTION PARTNERS. ***\n\nWelcome to Xennial\u2019s Virtual Reality (VR) Optics Table, an immersive educational experience designed for Middle and High School Physics programs. This immersive STEM learning experience brings the principles of Snell\u2019s Law of Light Reflection and Refraction to life, eliminating the need for traditional and expensive lab equipment. The VR Optics Table includes features such as single-beam and triple-beam lasers, lenses, and mirrors, offering 
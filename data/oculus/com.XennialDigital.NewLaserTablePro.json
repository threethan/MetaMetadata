.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gSs_cJVk-VQQ7kNvwHcK33U&_nc_oc=Adl8bytfB-hVXkRX0j2mlsShSYbv9Zby-DbJyDMudBpz_Dn8v2F3iYhZ6kwyiExiJvU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfvZOpi-r43FO5jDjiwV0WR81N3-CYvb0Qhhxkd6nYuFsQ&oe=69A2C804"}, {"file_name": "screenshot_LaserT_2.png", "id": "1376210856975287", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499297140_1376210860308620_7491228154117118837_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2IvmwgZ3Bx8Q7kNvwG_sbU9&_nc_oc=AdltzCXeY6rGjrTOrVu9PjkcvEo8xtSUc-D31jNGGeN_-1AoKyzAFcQ26eKyyAIik9k&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Afskkmg5ebyrt5xofWFRTe8pZRSWDkod_aOyENaF76hJow&oe=69A2C74E"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Optics Table PRO - Snell's Law", "keywords": ["physics", "Laser"], "long_description": "*** TO ACCESS THIS VERSION, A LICENSE IS REQUIRED AND IT CAN BE ACQUIRED DIRECTLY THROUGH XENNIAL OR ONE OF ITS DISTRIBUTION PARTNERS. ***\n\nWelcome to Xennial\u2019s Virtual Reality (VR) Optics Table, an immersive educational experience designed for Middle and High School Physics programs. This immersive STEM learning experience brings the principles of Snell\u2019s Law of Light Reflection and Refraction to life, eliminating the need for traditional and expensive lab equipment. The VR Optics Table includes features such as single-beam and triple-beam lasers, lenses, and mirrors, offering hands-on exploration of light behavior.\n", "short_description": "This immersive STEM learning experience brings the principles of Snell\u2019s Law of Light Reflection and Refraction to life, eliminating the need for traditional and expensive lab equipment. \n\n*** IMPORTANT NOTE: THIS VERSION IS NOT FOR SINGLE DEVICES. TO ACCESS THE PRO VERSION, AN ANNUAL LICENSE IS REQUIRED AND CAN ONLY BE ACQUIRED DIRECTLY THROUGH XENNIAL OR ONE OF ITS DISTRIBUTION PARTNERS. TO LEARN MORE: XENNIAL@XENNIALDIGITAL.COM ***"}]}, "developer_name": "Xennial"
cdn.com/v/t64.5771-25/499312046_4006086976386010_7025838585055209175_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HHe3vTDfBoUQ7kNvwE6Cjp6&_nc_oc=Adp-cFwpgom_aodsIenwUQ_ISGs6-q4WaY1hTwsvBJpRBV12n-ePKkpLsT0-b8_HslI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_kDEprgoSMlhk5qzgZbdfutL1-W4-lmPS58oBnQwv-uw&oe=6A2EC84A"}, {"file_name": "screenshot_LaserT_6.png", "id": "1346303313112432", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499304162_1346303316445765_639425653150023621_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=86Hnc2Ca19kQ7kNvwGE10Ts&_nc_oc=AdrXbueOJTFigCVgwJWzVDhGbv5TapIX3Elsy5aXmXDJwu-FiNmt2O7zJohT-5E-6Dk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_efayIrArjYhoWvA4OERtLBx5A2LJMT1rs_sCXHmkUzg&oe=6A2EBF44"}, {"file_name": "screenshot_LaserT_2.png", "id": "1376210856975287", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499297140_1376210860308620_7491228154117118837_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5l7Wl9HqhKQQ7kNvwEeDONw&_nc_oc=Adrg2I5V7j-xo-jQoC_Jk-YskReTC-szEMJixOyeqIuljDA4grtLbmbVsA4jrci8IZc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8k2GRU-OssHklCy_8RVxIyNVwo7-d537R_GKieL1G4bA&oe=6A2EBE8E"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Optics Table PRO - Snell's Law", "keywords": ["physics", "Laser"], "long_description": "*** TO ACCESS THIS VERSION, A LICENSE IS REQUIRED AND IT CAN BE ACQUIRED DIRECTLY THROUGH XENNIAL OR ONE OF ITS DISTRIBUTION PARTNERS. ***\n\nWelcome to Xennial\u2019s Virtual Reality (VR) Optics Table, an immersive educational experience designed for Middle and High School Physics programs. This immersive STEM learning experience brings the principles of Snell\u2019s Law of Light Reflection and Refraction to life, eliminating the need for traditional and expensive lab equipment. The VR Optics Table includes features such as single-beam and triple-beam lasers, lenses, and mirrors, offering 
cdn.com/v/t64.5771-25/499312046_4006086976386010_7025838585055209175_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=p1laOOx_Y7MQ7kNvwEdzjo3&_nc_oc=AdrfMfshFgXItNZMPJyxL7-XFP-4cqPnkRp_SJvPV3XXY2LVBfCanfiAzNOlm-oOgIk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_6G7ySMH7yhqhhhQuijAaY6m9heWh9XOmZtQOPa2ew6w&oe=6A3BF74A"}, {"file_name": "screenshot_LaserT_6.png", "id": "1346303313112432", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499304162_1346303316445765_639425653150023621_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FAN7UaLOeFwQ7kNvwFWQfuy&_nc_oc=AdrNotLLBT7P79kbbUkGtDnyWCq3Ab2GJ4-7iHpN4fWJRfWCwoqhdgVlZw-ZplrBGKw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_1Is5kSR9qO4jSGGd1dN4mMQAy2VMgcrmlNtM5niQvRQ&oe=6A3BEE44"}, {"file_name": "screenshot_LaserT_2.png", "id": "1376210856975287", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499297140_1376210860308620_7491228154117118837_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gxxfCzuCkHYQ7kNvwFcWfyq&_nc_oc=AdrBzmmSTmb5uFfPpM_QveeL5tf3IJouWTVaiLEBYhXVsbLHzWQ_q9uU0ZbcnUVt8YA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8UC0lCb5dhYDFCDRANvlydUfacsssw6zlxMlO8lzz_1w&oe=6A3BED8E"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Optics Table PRO - Snell's Law", "keywords": ["physics", "Laser"], "long_description": "*** TO ACCESS THIS VERSION, A LICENSE IS REQUIRED AND IT CAN BE ACQUIRED DIRECTLY THROUGH XENNIAL OR ONE OF ITS DISTRIBUTION PARTNERS. ***\n\nWelcome to Xennial\u2019s Virtual Reality (VR) Optics Table, an immersive educational experience designed for Middle and High School Physics programs. This immersive STEM learning experience brings the principles of Snell\u2019s Law of Light Reflection and Refraction to life, eliminating the need for traditional and expensive lab equipment. The VR Optics Table includes features such as single-beam and triple-beam lasers, lenses, and mirrors, offering 
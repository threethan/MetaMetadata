cdn.com/v/t64.5771-25/499312046_4006086976386010_7025838585055209175_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xy_WGDC17vEQ7kNvwHSLxp8&_nc_oc=Adr3FGFFdpOwTmY62IO1APL59_pfwReBE-ttLLyfzX2_eHvNrglJXukpWsPc1ny6JwU&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOsAy044wzJMMhAekkftVgiOSXE70lBgbDlVDLK4ZnEJQ&oe=6AD0F0CA"}, {"file_name": "screenshot_LaserT_6.png", "id": "1346303313112432", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/499304162_1346303316445765_639425653150023621_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SaEDOslfW4UQ7kNvwGR217M&_nc_oc=AdozyG-bQfcbQ_MIzWl_b4OQ9QOw95e3tMMU93pQH5vAvLvUOQlKPvzXFMBP4LZsaSQ&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMUg9Y1R9BaergOILPXGFItld3TIbi8Q6roI1oM5VNf2A&oe=6AD0E7C4"}, {"file_name": "screenshot_LaserT_2.png", "id": "1376210856975287", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499297140_1376210860308620_7491228154117118837_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-6stqcs7I0MQ7kNvwGhPw4p&_nc_oc=Adp0DATteFPf34Tj6RvebULqIwBhLeQDhEwUdjOqK5X7vyjjj96M6aRLuBqSmanPX04&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMoYmwqpGrGx9qw_x06zDdDVRyvror9tiuh9bHmQ9FLtg&oe=6AD0E70E"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Optics Table PRO - Snell's Law", "keywords": ["physics", "Laser"], "long_description": "*** TO ACCESS THIS VERSION, A LICENSE IS REQUIRED AND IT CAN BE ACQUIRED DIRECTLY THROUGH XENNIAL OR ONE OF ITS DISTRIBUTION PARTNERS. ***\n\nWelcome to Xennial\u2019s Virtual Reality (VR) Optics Table, an immersive educational experience designed for Middle and High School Physics programs. This immersive STEM learning experience brings the principles of Snell\u2019s Law of Light Reflection and Refraction to life, eliminating the need for traditional and expensive lab equipment. The VR Optics Table includes features such as single-beam and triple-beam lasers, lenses, and mirrors, offering 
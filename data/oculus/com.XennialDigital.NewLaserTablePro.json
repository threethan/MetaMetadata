329054", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499304720_1497222881662387_8769496744960022477_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TakmKNW_G6cQ7kNvwGhRzcG&_nc_oc=AdmIYKEjA5u2c8Mm1VVnvdvqmPiTwJBoEp8DLzUK6JlUBC63Q2DGNyNzecGSddauIcg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_Afv7U1yiaa2AqaP5_TJESL6p9JiQANR1HY5RggSfW3NZzA&oe=69A97A44"}, {"file_name": "screenshot_LaserT_1.png", "id": "4006086973052677", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499312046_4006086976386010_7025838585055209175_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MMz_7CD5RFAQ7kNvwFzw_Ah&_nc_oc=AdlSPrK5fzjozeOK3ptvu_MUmSObMrM4au2z_uE7hItK9d8-h_rbUThgJBozetPqXqw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_Afs_yiex_YCINr3xPp94xf2bB4U7XE3fJ-tR3ClW5DvorQ&oe=69A9688A"}, {"file_name": "screenshot_LaserT_6.png", "id": "1346303313112432", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499304162_1346303316445765_639425653150023621_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MkELteOiD7QQ7kNvwG3XOJg&_nc_oc=AdmsV4oFjZXLQpMhhw-A3CHcT99o72op2MESMY7WQpRrRINBp4PVeoQIw896KOldcf0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_Afs0z7D26VnEKPousEV_xja2idgNH6DVr56_FEke7hX4hg&oe=69A997C4"}, {"file_name": "screenshot_LaserT_2.png", "id": "1376210856975287", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499297140_1376210860308620_7491228154117118837_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3LB_cBmiRAMQ7kNvwFLCorc&_nc_oc=AdkhphhnI0nQBy_X5224W9iFkEQQ9cl13DZwjMXwINEWnHgq_ny_nZ7ISzepKQTGR9M&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_Afuhi2iViWSLpyXiODtaBh9OEZJXFZD7smi2-91RLJk2Bw&oe=69A9970E"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Optics Table PRO - Snell's Law", "keywords": ["physics", "Laser"], "long_description": "*** TO ACCESS THIS VERSION, A LICENSE IS REQUIRED AND IT CAN BE ACQUIRED DIRECTLY THROUGH XENNIAL OR ONE OF ITS DISTRIBUTION PARTNERS. ***\n\nWelcome to Xennial\u2019s Virtual Reality (VR) Optics Table, an immersive educational experience designed for Middle and High School Physics programs. This immersive STEM learning experience brings the principles of Snell\u2019s Law of Light Reflection and Refraction to life, eliminating the need for traditional and expensive lab equipment. The VR Optics Table includes features such as single-beam and triple-beam lasers, lenses, and mirrors, offering hands-on exploration of light behavior.\n", "short_description": "This immersive STEM learning experience brings the principles of Snell\u2019s Law of Light Reflection and Refraction to life, eliminating the need for traditional and expensive lab equipment. \n\n*** IMPORTANT NOTE: THIS VERSION IS NOT FOR SINGLE DEVICES. TO ACCESS THE PRO VERSION, AN ANNUAL LICENSE IS REQUIRED AND CAN ONLY BE ACQUIRED DIRECTLY THROUGH XENNIAL OR ONE OF ITS DISTRIBUTION PARTNERS. TO LEARN MORE: XENNIAL@XENNIALDIGITAL.COM ***"}]}, "developer_name": "Xennial", "developer_privacy_policy_url": "https://www.xennialdigital.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Xennial", "support_website_url": null, "website_url": "https://www.xennialdigital.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}, {"id": "514087707868786"}], "external_subscription_type": "REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24536353469292677"}, "review_messages": []}]
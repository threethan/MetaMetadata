.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VH0ruhNNm9MQ7kNvwFL2HcY&_nc_oc=AdnU8enHTRPyHg56ymbIshhx5brlMov4OG9khwwXzARy6gTnW2GfL2kcYB4MZqMtv3E&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_Aft0_t049yKcd0A-7SPrfkToya5seiYayr_Y41-D0MqA-w&oe=69A41984"}, {"file_name": "screenshot_LaserT_2.png", "id": "1376210856975287", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499297140_1376210860308620_7491228154117118837_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2IvmwgZ3Bx8Q7kNvwEXJSrk&_nc_oc=AdkDvR2hO5sxv3-BHbi7aa_2228XlyDynSqzdw6FmiHBr1aWfGPexwMs2vEYKbu7yxE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AfvQplwUbiaz3Nh4-Lq4PA6Rq25z2IzlznYeNhHI2d5Rtg&oe=69A418CE"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Optics Table PRO - Snell's Law", "keywords": ["physics", "Laser"], "long_description": "*** TO ACCESS THIS VERSION, A LICENSE IS REQUIRED AND IT CAN BE ACQUIRED DIRECTLY THROUGH XENNIAL OR ONE OF ITS DISTRIBUTION PARTNERS. ***\n\nWelcome to Xennial\u2019s Virtual Reality (VR) Optics Table, an immersive educational experience designed for Middle and High School Physics programs. This immersive STEM learning experience brings the principles of Snell\u2019s Law of Light Reflection and Refraction to life, eliminating the need for traditional and expensive lab equipment. The VR Optics Table includes features such as single-beam and triple-beam lasers, lenses, and mirrors, offering hands-on exploration of light behavior.\n", "short_description": "This immersive STEM learning experience brings the principles of Snell\u2019s Law of Light Reflection and Refraction to life, eliminating the need for traditional and expensive lab equipment. \n\n*** IMPORTANT NOTE: THIS VERSION IS NOT FOR SINGLE DEVICES. TO ACCESS THE PRO VERSION, AN ANNUAL LICENSE IS REQUIRED AND CAN ONLY BE ACQUIRED DIRECTLY THROUGH XENNIAL OR ONE OF ITS DISTRIBUTION PARTNERS. TO LEARN MORE: XENNIAL@XENNIALDIGITAL.COM ***"}]}, "developer_name": "Xennial"
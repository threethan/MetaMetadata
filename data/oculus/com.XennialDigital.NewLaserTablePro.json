cdn.com/v/t64.5771-25/499312046_4006086976386010_7025838585055209175_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nevSY6n5FR0Q7kNvwHfUmsT&_nc_oc=AdqLD225I0YFDe9BgrPEJ4sVDcX_DPwZgyZJrLjqRYUfGVrtqlDAEKvnV0ZTfXuopYQ&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO0jPmXdNSu6XyIwYPhW4CeKywBXWBBCiqPe56E4z8lzg&oe=6AC7B64A"}, {"file_name": "screenshot_LaserT_6.png", "id": "1346303313112432", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/499304162_1346303316445765_639425653150023621_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=onzos347zSYQ7kNvwGyqOJS&_nc_oc=AdrVyqW9sjM0PUWJAAOp6soAO_ye-XYv0yDNmBNgFkClgaMCNhKILVfLLFCyuAFpv9Q&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPmuiCBbnouV0jouE9fOErsOKXFaPsAMFohtzWM5w6FCg&oe=6AC7AD44"}, {"file_name": "screenshot_LaserT_2.png", "id": "1376210856975287", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499297140_1376210860308620_7491228154117118837_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M5eQZNUxEMkQ7kNvwFG5h1t&_nc_oc=AdqpYQDnuZk_EiURfk_ONw9xqyEwZVAh72Rbvnlx5V1_A3mZi3PVMu-3jSmTw4izWbM&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM6Rc0uzu7F4MehbaH6yRndOmwfuNu-puITgCKVQd6tLQ&oe=6AC7AC8E"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Optics Table PRO - Snell's Law", "keywords": ["physics", "Laser"], "long_description": "*** TO ACCESS THIS VERSION, A LICENSE IS REQUIRED AND IT CAN BE ACQUIRED DIRECTLY THROUGH XENNIAL OR ONE OF ITS DISTRIBUTION PARTNERS. ***\n\nWelcome to Xennial\u2019s Virtual Reality (VR) Optics Table, an immersive educational experience designed for Middle and High School Physics programs. This immersive STEM learning experience brings the principles of Snell\u2019s Law of Light Reflection and Refraction to life, eliminating the need for traditional and expensive lab equipment. The VR Optics Table includes features such as single-beam and triple-beam lasers, lenses, and mirrors, offering 
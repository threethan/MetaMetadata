12046_4006086976386010_7025838585055209175_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=49OW-HFNJgwQ7kNvwGIIjAo&_nc_oc=AdovcZW3O88gwTR-M2_Eaqv8k5lEhzZjexSNwwWSnIMA_SQhpPhVi3DFom1Yfau2XbQ&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0AUswZ_TWOH54tNFqcdnjloq5UIEixht30iLamnKX6fw&oe=69F1EB0A"}, {"file_name": "screenshot_LaserT_6.png", "id": "1346303313112432", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499304162_1346303316445765_639425653150023621_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5wPu6rL2W0gQ7kNvwFu5oYc&_nc_oc=AdrdC6Ec1nTytRJlUQa1z624H3SsSowD-rz-Ws24-KcsXANTJKC7cPwESx4vqhRMRYs&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_Af3sZWe4mSeddEylPk7of_FlJeYakVrJJUJptn6o2OXz9A&oe=69F21A44"}, {"file_name": "screenshot_LaserT_2.png", "id": "1376210856975287", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499297140_1376210860308620_7491228154117118837_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UrJ4T9aSyrMQ7kNvwHWY7vm&_nc_oc=AdrHBDISwMQ77zqR8Ga4HYDWXQ4B0OWJ5lGUDWYUvv1cRMK7Kh_HKUy7QnboLwIZ0jA&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_Af26d1GeFDbzbTIN685nfdSEEgrgryeOm80uOcVHWQY8lA&oe=69F2198E"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Optics Table PRO - Snell's Law", "keywords": ["physics", "Laser"], "long_description": "*** TO ACCESS THIS VERSION, A LICENSE IS REQUIRED AND IT CAN BE ACQUIRED DIRECTLY THROUGH XENNIAL OR ONE OF ITS DISTRIBUTION PARTNERS. ***\n\nWelcome to Xennial\u2019s Virtual Reality (VR) Optics Table, an immersive educational experience designed for Middle and High School Physics programs. This immersive STEM learning experience brings the principles of Snell\u2019s Law of Light Reflection and Refraction to life, eliminating the need for traditional and expensive lab equipment. The VR Optics Table includes features such as single-beam and triple-beam lasers, lenses, and mirrors, offering hands-on exploration of light behavior.\n", "short_description": "This immersive STEM learning experience brings the principles of Snell\u2019s Law of Light Reflection and Refraction to life, eliminating the need for traditional and expensive lab equipment. \n\n*** IMPORTANT NOTE: THIS VERSION IS NOT FOR SINGLE DEVICES. TO ACCESS THE PRO VERSION, AN ANNUAL LICENSE IS REQUIRED AND CAN ONLY BE ACQUIRED DIRECTLY THROUGH XENNIAL OR ONE OF ITS DISTRIBUTION PARTNERS. TO LEARN MORE: XENNIAL@XENNIALDIGITAL.COM ***"}]}, "developer_name": "Xennial", "developer_privacy_policy_url": "https://www.xennialdigital.com/privacy/", "developer_terms_of_service_url": "https://www.xennialdigital.com/terms/", "publisher_name": "Xennial", "support_website_url": null, "website_url": "https://www.xennialdigital.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}, {"id": "514087707868786"}], "external_subscription_type": "REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9876495452371721"}}]}, "scheduled_offers": {"count": 0, "nodes": []}, "baseline_offer": null, "is_approved": true, "firstOffer": {"nodes": []}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "23918235057771191", "version": "0.2.99"}, "id": "2430960060591785", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Applicat
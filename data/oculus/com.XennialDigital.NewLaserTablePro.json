cdn.com/v/t64.5771-25/499312046_4006086976386010_7025838585055209175_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3oFLFNVgVY8Q7kNvwHWKXUb&_nc_oc=Adpn213i1V70jmhHJRPHdyiK_eRHwccRGuwvRqxclbyoI_d0qMpvDv3cJiREIW5BAOs&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7v9ODoy5Tl9QENkEZU0NIZcv_w70GTeKYb9riiduvMlg&oe=6A01F54A"}, {"file_name": "screenshot_LaserT_6.png", "id": "1346303313112432", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499304162_1346303316445765_639425653150023621_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C6pYIs2YKDkQ7kNvwHZ_2O6&_nc_oc=Adp7mabWpFD_gZX7j7tRGhuMUiOqmyPNflHSj-9CGcmxqyK7nlbci2ZeyOUM0PgiV3g&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7bnJNRa0Rqucxv4r29q6i--_9MymzST54ndDSNSkfgEw&oe=6A01EC44"}, {"file_name": "screenshot_LaserT_2.png", "id": "1376210856975287", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499297140_1376210860308620_7491228154117118837_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uIsLTYeFxoUQ7kNvwF4hGRV&_nc_oc=AdoXSwTnIBtQ9cWf-7R_R4pveLBl9SMqJH8o2kWeLo0gi7hsJFNlitnhX25Bd_YeYG8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7JytZ51q3vo70cR1E2i_GX-MAL4YbTxW_Niw1iKMV4hA&oe=6A01EB8E"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Optics Table PRO - Snell's Law", "keywords": ["physics", "Laser"], "long_description": "*** TO ACCESS THIS VERSION, A LICENSE IS REQUIRED AND IT CAN BE ACQUIRED DIRECTLY THROUGH XENNIAL OR ONE OF ITS DISTRIBUTION PARTNERS. ***\n\nWelcome to Xennial\u2019s Virtual Reality (VR) Optics Table, an immersive educational experience designed for Middle and High School Physics programs. This immersive STEM learning experience brings the principles of Snell\u2019s Law of Light Reflection and Refraction to life, eliminating the need for traditional and expensive lab equipment. The VR Optics Table includes features such as single-beam and triple-beam lasers, lenses, and mirrors, offering 
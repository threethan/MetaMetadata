cdn.com/v/t64.5771-25/499312046_4006086976386010_7025838585055209175_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KUd-5OVclHMQ7kNvwERPOOb&_nc_oc=AdoWYU4x_XxR5-opJDOCotH0bnIR-x2P4oq7CjqszvjBdusESG60hbUAmxWBNu8bL_E&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4s8I1DXAfxrkeSTo4QJTIhOWjnIpnHq96LWGtShPge0g&oe=6A0DD2CA"}, {"file_name": "screenshot_LaserT_6.png", "id": "1346303313112432", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499304162_1346303316445765_639425653150023621_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LzPHq2aYlSAQ7kNvwE1JqV-&_nc_oc=AdpGieQgcfzfVnd5cOv45vcL40qpp2VFuI6JbARR9lSFI7fKVcbmytYmpm8Cgfq_oR8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4tDGyhXrsGEn3T9nxER3ABSLGjiMi-WmZf8IG3TMRdPw&oe=6A0DC9C4"}, {"file_name": "screenshot_LaserT_2.png", "id": "1376210856975287", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499297140_1376210860308620_7491228154117118837_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RLahq3C0KbIQ7kNvwHly-Qi&_nc_oc=AdrYkiB78y22I58kTk-Kw5qQcrs8shCWEwuB4wiGX9qmO-nY6bq_iskdTu0GGKsehw4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6Qv61-d2S6O_z8sfGagQhNSmHIoWAQqFtdKB_EH9Z7hQ&oe=6A0DC90E"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Optics Table PRO - Snell's Law", "keywords": ["physics", "Laser"], "long_description": "*** TO ACCESS THIS VERSION, A LICENSE IS REQUIRED AND IT CAN BE ACQUIRED DIRECTLY THROUGH XENNIAL OR ONE OF ITS DISTRIBUTION PARTNERS. ***\n\nWelcome to Xennial\u2019s Virtual Reality (VR) Optics Table, an immersive educational experience designed for Middle and High School Physics programs. This immersive STEM learning experience brings the principles of Snell\u2019s Law of Light Reflection and Refraction to life, eliminating the need for traditional and expensive lab equipment. The VR Optics Table includes features such as single-beam and triple-beam lasers, lenses, and mirrors, offering 
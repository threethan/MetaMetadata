//scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491823366_1453314579656950_4332639043576670353_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OGt2PVNRGXUQ7kNvwFDzQHA&_nc_oc=Adrl5QjXMQUJ2rczxQ-fsJyz7XvgZR9txc0DssZ7QAhFrVUANEI2zxhnwhWdDesUgSQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMIw8X9jpsuH9x1NqTmSiY0tRohqkbPeU_109cGtU7-qQ&oe=6ABFB869"}, {"file_name": "simulacro-cover-art_portrait.png", "id": "924839306685450", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491824741_924839313352116_969654771377605305_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vVyYEYUeFZEQ7kNvwGe_GZq&_nc_oc=AdoSSbZaz4Gxn_KY-ZmdsSIN_bAAmq13A7m_q9Z4p_KvKQvQq64sRPnOTMU3XaoIKX8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN1i4CtEycUsH32ifMpLAw--lpKrcyoDkJvU4nUCm3CiA&oe=6ABFC982"}, {"file_name": "simulacro-cover-art.png", "id": "866542156372985", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491824328_866542159706318_1299842899000183183_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=20pBNGFzg8AQ7kNvwGK32vF&_nc_oc=AdqI0TA4ov2payT9-kNfFHkTgUVyZ9DA2zfCJSwlFy7mhAerKbr7YamcCYbcLu0wjBI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOvjxi1EJ21fik0JMJQTUI_1IbCtIWarA3Tc6alwiISFA&oe=6ABFAC07"}]}, "id": "2510337079485254", "locale": "en_US", "screenshots": [{"file_name": "es.kendra.simulacro-20260216-165259.png", "id": "923974420122122", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491827626_923974423455455_2165815749110729398_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vo4vSQ2QjcMQ7kNvwExlvY3&_nc_oc=AdoFWkzPDTXDygk7EWFP5h7aVmOPOZQMvZgZqgDupe2xclvNyEN907vNJ5hUFWK-JYE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPL16QmdGowtevEL8OKcMnX3WuhKSjxhZhUaqL0__mbHw&oe=6ABFB052"}, {"file_name": "es.kendra.simulacro-20260216-164653.png", "id": "1450774073086023", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491819356_1450774076419356_1260803299171603764_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YK7apgRrko8Q7kNvwGN_5wK&_nc_oc=Adobn9zSKGfbV6VKy_TCWORg82qJluw7fqvezV_gRhSn-FtIopBiX89VWTPuFc--oYM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOSb2Ezfr53cIq1LAlewKG0CL-EaXuAYYo8VTDXD2i_Qw&oe=6ABFBE1B"}, {"file_name": "es.kendra.simulacro-20260216-165839.png", "id": "787595840438663", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491818852_787595847105329_5387788108499779374_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZJaHD8AZVlYQ7kNvwFJE05b&_nc_oc=AdpMBSAdQ7hZUsxgl8wGgqI_zKacupyiRDbRLW2xuy4Y_p7tMMyFKHQCMR2WfdeiXFA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMy90G5RNCaSUkVA2_J0hP85iSgnIFVJrzsUcPU14YXqg&oe=6ABFD348"}, {"file_name": "es.kendra.simulacro-20251024-164234.png", "id": "1549552280220668", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491821099_1549552283554001_4507672407451699888_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W5FN3BfaQT8Q7kNvwEBkkhF&_nc_oc=Adon17TTxVUKIUdzl2ieASgWIuaoUFx_6j7FLqIEWsybTuC_-fEc4NKlThx88JHPnts&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPwIqv2lq7d1q4kucW8NcQXFFUa3LWx2REqHnAm1q22sg&oe=6ABFB49D"}, {"file_name": "es.kendra.simulacro-20260216-165531.png", "id": "1272599888119383", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491827743_1272599891452716_1925367564886174129_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Srysm-IHpxIQ7kNvwEjtNuj&_nc_oc=AdpzLneqrU-yWPPhl5wwi_nSMlsftdcbYbqPF2Bxk4fK7mhXbfDEZ6ds5I2Q-CZWdRs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOe76TcnkmGMAHZ6NA24Aw1-xstdNnTgtbEmneeuV3H4g&oe=6ABFA9C6"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Simulacro", "keywords": [], "long_description": "Step into a virtual audiovisual studio and experience what it is like to prepare and carry out a production in virtual reality.\n\nSimulacro lets you explore professional production environments where you can take on different roles, experiment with cameras, lighting, and staging, and collaborate with other users in an immersive space designed for learning, practicing, and creating.\n\nWhether you are a student, educator, or audiovisual professional, Simulacro provides a safe environment to train real production workflows without the limitations of a physical set. Plan scenes, test technical configurations, make creative decisions, and discover how a production team works from the inside.\n\nKey features:\n\n\u2022 Explore virtual audiovisual production environments.\n\u2022 Operate virtual cameras and experiment with different positions and framing options.\n\u2022 Design and adjust lighting setups in real time.\n\u2022 Practice professional filmmaking and broadcasting workflows.\n\u2022 Collaborate with other users in shared immersive experiences.\n\u2022 Learn through hands-on experimentation in virtual reality.\n\nSimulacro transforms virtual reality into a powerful learning and creative tool, bringing audiovisual production closer to everyone and allowing users to practice, experiment, and improve before stepping onto a real set.\n\nPut on your headset, step into the studio, and discover a new way to learn and create.\n", "short_description": "Simulacro is a virtual-reality software designed for audiovisual professionals and students to plan, rehearse, and organize their productions in a virtual environment before going into a real set or location. It\u2019s like running a rehearsal of your production\u2014saving time and enhancing creativity."}, {"images": {"nodes": [{"file_name": "simulacro-logo.png", "id": "26088359697454031", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491821725_26088359700787364_7306499452259292163_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vAwQel1XIrYQ7kNvwGzg6zI&_nc_oc=AdqBnDeQ7icpbAD0rB7HuLNAmRfqElmSx_X5odcYVu7hm6OExHukxDDrUtC3aAm2u88&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNPIKUkg8kwihTldfscBm9HhX-HPsK8vuYpco_u9VfL9g&oe=6ABFD2F0"}, {"file_name": "simulacro-cover-art.png", "id": "1239697451454123", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491820001_1239697454787456_8018176793629208740_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BnHRh9fSmoEQ7kNvwFQrhm_&_nc_oc=AdrsmAzUrCvIlLxu4VoUlbaPlaVVhNbsFPV8KKQtGYoeeEr6yvBKEZjZ-wDWoFrEsZM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOhy8QphNam12BQsBl-34NcNiYxruHfylznNFwE5S8gHg&oe=6ABFB8ED"}, {"file_name": "simulacro-cover-art_square_portrait.png", "id": "955992313646550", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491822327_955992320313216_6276562608641881164_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z-v_hq337DUQ7kNvwHMveJZ&_nc_oc=AdqGEVN2lkjhQw16eGWHMpq6W8H7BoFJR46FgvQ6qQlwuVjJn_iDEjuCQ1pNhp43e3U&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOgt0Bmr4GAzzY2dL7p_cjyWES6vNRhs9QymGZPgnVCuA&oe=6ABFB9D7"}, {"file_name": "simulacro-cover-art_square.png", "id": "907038768639929", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491823296_907038771973262_5688638684661640858_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wRZY61N3VQsQ7kNvwFC8r0A&_nc_oc=Adr8M2eDpYSq-E6c-X6R6CFM7Ul88XMMEJjrSC_4aMxU6RHwQNZi3g9YJn7hATZQ0KY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNQUIJ8Pq8hzGjxdYILX5FgX4Y5wR_zW1UBDWMdIehYrg&oe=6ABFD62E"}]}, "id": "897637356722317", "locale": "es_ES", "screenshots": [{"file_name": "es.kendra.simulacro-20260216-165259.png", "id": "2433302217086782", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491820387_2433302220420115_2004880495417692180_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gWGWfHxhLdAQ7kNvwHhYj9p&_nc_oc=AdrD4wBUAc1ZFGaqFfh_zBUzEfztpO2A1gwNZSb6Mx2yKMtNi2OftdZUg0zqTuqCsRo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNpmZ0VJddhPq2MOqN-W8nSOcK-YP1KTIKOUD4cpiIpgQ&oe=6ABFD76C"}, {"file_name": "es.kendra.simulacro-20260216-165839.png", "id": "34112839781694367", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491823279_34112839811694364_8335683061248124650_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_jJ6JdDGQwcQ7kNvwG0epEW&_nc_oc=Adrn44qUzw5eQ2H6w7pWyanVQqmca73oJw_9guFGeSTV7LV40wCdOE9vw6dHol_YRvE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPpLVSZab89U6nv-nh3ibFjkE-yPf_q7-GGN6f1YNXBkg&oe=6ABFC6C9"}, {"file_name": "es.kendra.simulacro-20260216-164653.png", "id": "1839710753402735", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491824292_1839710760069401_5677698466159078454_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rf87KTufcZUQ7kNvwGKO39Z&_nc_oc=AdrurW1bakOtHibtaAnfVrXbmvmd0kM_1RXHZKfFxr4SBiMfemYaXQaKf9VaEx_IQBA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO1Gks3d_goDP1T4cNJd9iLdnxKrxoAUV1fj3-pzxC-dg&oe=6ABFCD6D"}, {"file_name": "es.kendra.simulacro-20251024-164234.png", "id": "1418829773064091", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491819983_1418829776397424_1895906212229626056_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_vTUpXgreucQ7kNvwHwfvB5&_nc_oc=AdqBWxS2i-EhdPPS4ZDTCmEaoOFccVpsaw-KWW_9qWAKPCdn5JPvm24x9vDqyiRgzN4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNwOZDhh5A56XtK0uRejECsfauLxoafini2-2kFDu1TxA&oe=6ABFC90D"}, {"file_name": "es.kendra.simulacro-20260216-165531.png", "id": "771609438872464", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491825257_771609442205797_1691241102694721912_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dYfVqdnfA2kQ7kNvwGAzSh6&_nc_oc=AdouW0BXEn-Qa68lLuDrETKUIDJznXm6vDaOztHFjN6j7u92y-hMnEAUTDd5EN_fRGE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPswp-_KvVonrGEdrqP86XoD4sTFcfDxYoHAJlb3_WRAw&oe=6ABFD343"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Simulacro", "keywords": [], "long_description": "Entra en un plat\u00f3 audiovisual virtual y vive la experiencia de preparar y desarrollar un rodaje en realidad virtual.\n\nSimulacro te permite explorar entornos profesionales de producci\u00f3n audiovisual donde podr\u00e1s asumir diferentes roles, experimentar con c\u00e1maras, iluminaci\u00f3n y puesta en escena, y colaborar con otros usuarios en un espacio inmersivo dise\u00f1ado para aprender, practicar y crear.\n\nYa seas estudiante, docente o profesional del sector audiovisual, Simulacro ofrece un entorno seguro para entrenar procesos reales de producci\u00f3n sin las limitaciones de un rodaje f\u00edsico. Planifica escenas, prueba configuraciones t\u00e9cnicas, toma decisiones creativas y descubre c\u00f3mo funciona un equipo de producci\u00f3n desde dentro.\n\nCaracter\u00edsticas principales:\n\n\u2022 Explora escenarios virtuales de producci\u00f3n audiovisual.\n\u2022 Maneja c\u00e1maras virtuales y experimenta con diferentes posiciones y encuadres.\n\u2022 Dise\u00f1a y ajusta esquemas de iluminaci\u00f3n en tiempo real.\n\u2022 Practica flujos de trabajo propios de un rodaje profesional.\n\u2022 Colabora con otros usuarios en experiencias compartidas.\n\u2022 Aprende mediante la experimentaci\u00f3n directa en realidad virtual.\n\nSimulacro convierte la realidad virtual en una herramienta de aprendizaje y creaci\u00f3n para acercar el mundo del audiovisual a cualquier persona, permitiendo practicar, experimentar y mejorar antes de pasar al plat\u00f3 real.\n\nPonte las gafas, entra en escena y descubre una nueva forma de aprender y crear.\n", "short_description": "Simulacro es un software de realidad virtual dise\u00f1ado para que profesionales y estudiantes de comunicaci\u00f3n audiovisual puedan planificar, ensayar y organizar sus producciones en un entorno virtual antes de ir a rodar a un plat\u00f3 o localizaci\u00f3n real.\nEs como un hacer un simulacro de tu producci\u00f3n, pero ahorrando tiempo y mejorando el proceso creativo."}]}, "developer_name": "Kendra", "developer_privacy_policy_url": "https://kendra.es/privacy-policy-for-simulacro/", "developer_terms_of_service_url": null, "publisher_name": "Kendra Realidades Alternativas SL", "support_website_url": null, "website_url": "https://simulacro.gal/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "1063584910766706"}], "external_subscription_type": "REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "es"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "CO_OP"], "id": "27765753613059849"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "4494356254117744"}]}, "baseline_offer": {"id": "4494356254117744"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1789146360, "status": "PUBLISHED", "id": "4494356254117744"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "28521662560802280", "version": "0.5.10"}, "id": "1933101617511803", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "24688362224132352", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "28521662560802280"}, "release_status": "RELEASED"}, "binary_release_channels": {"n
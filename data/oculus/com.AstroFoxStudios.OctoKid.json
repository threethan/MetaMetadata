2", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473392168_544957561468375_3639563635144489999_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J5-4lTlqd8QQ7kNvwEEDCQj&_nc_oc=AdqyzIBjQpyiE3io7ApswX2-FG1Xa2tcLO1jlSMFrVLRQm7PAAcIIB1b3vfk30SteXY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJgXprpGhNNv8FyAiLPsqPTUK7TnFZQqtjHw2M_VZgO2g&oe=6AB2A429"}]}, "id": "1257037865990978", "locale": "en_US", "screenshots": [{"file_name": "ScreenshotEdited_UseTools.png", "id": "1174285637748317", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473392129_1174285641081650_5057845893161029950_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ASQSnPcA6Z0Q7kNvwG5r8CH&_nc_oc=AdpH2Ptq9SAWwgCVWrT6id4MvtM4aJV6jvKFGmDlksAxiwcVoJyNkWpfoT7LRx9yuFo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ5WrSVPy0UQhwvwCEcVPv08IouhCD1w7iuTtuz9DWK-g&oe=6AB2A441"}, {"file_name": "ScreenshotEdited_FindTreasure.png", "id": "950203280529295", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473393469_950203283862628_5022957251259808908_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pZyDG_CsNpQQ7kNvwGpdwYV&_nc_oc=AdqeITViA6y3JwrnFaY59ZLaUMpVANVRtLR-jglsIZTA_nhuWxHvJYLZgQcHPd5gPeU&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL8XY7iW8QaZIk4JsDBXTKCkSH2gd3XWIIT87_SctoF7Q&oe=6AB2972F"}, {"file_name": "ScreenshotEdited_ExploreTheOceans.png", "id": "1375912747156537", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473392301_1375912750489870_7064854329659738642_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ASWnuKd6C2AQ7kNvwEasYxA&_nc_oc=AdqrRZsogbZaA4KfWVGBWQYESenrYtOmwgWrgbH2vT-GaOYq-UG-H-SjQSn35HTKQsE&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQInO5kK6ccuX-MH9geCEg85Y1U2zeJUlfjaT83NdZOYvA&oe=6AB279C8"}, {"file_name": "ScreenshotSized_TreasureIsland.png", "id": "1110278400782641", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473392036_1110278404115974_3104724029484161853_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_C8Km51G0iIQ7kNvwGbuIr2&_nc_oc=AdrxZbpJJYtBBcp_yxEIWInuJzyRRLUKM8bEf4E44XaJOuMHvKMYNlGaesZ67BRTN2E&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL-CK27ffI9ednuz74xQP-0ceIRjLiFRzVohMh26tSoAA&oe=6AB2A1DE"}, {"file_name": "ScreenshotSized_TakingCowboysHat.png", "id": "1905349053557181", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473393333_1905349056890514_5404405864169297915_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SXkR1XvfG_IQ7kNvwGRDJDR&_nc_oc=AdpAxa7yukcRSUK2Q3NfU41wfHCwQoNYk0FEBMUk46dMs5Y1Bk6O7PRrb68O0zh10Kg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKGP-YrPUNiLUa1Iq-4jjTSS4TRrlQ0F6DwpYAyKMyRXQ&oe=6AB2864B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440TrailerCover.png", "id": "1206378811497322", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473392129_1206378814830655_1365346645050814148_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1QNUsZhq_iUQ7kNvwEnLc_7&_nc_oc=Adr25B3kNnZZ6aU2nmnK3kyDa7yndaevcF33_tgspDu4L61tYCtPhDoqVQgKFeqe05o&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQInMPGu4bUr2nL6bP0GwDLGpyEwpYlLZmkVuzhwhxroQg&oe=6AB27D3A"}, "display_name": "OctoKid", "keywords": ["adventure", "puzzle", "simulation", "underwater", "child"], "long_description": "Submerge yourself in an underwater adventure as a cheeky octopus in OctoKid. Explore sunken towns, befriend sea creatures, and discover treasures of the deep to become the master of the oceans! \n\nIt is up to you to sling, leap, climb, stick and camouflage your way through various environments on your hunt to find your missing friend.\n\nFluid Hand-Based Locomotion\nGlide effortlessly across the ocean floor with intuitive, hand-based movement mechanics, offering an unparalleled sense of freedom as you slip through coral reefs and hidden underwater caves.\n\nExpansive Underwater World: Explore a vibrant, open ocean brimming with life\u2014from bustling coral towns to erie ships\u2014offering endless opportunities for discovery and adventure.\n\nDiverse Cast of Characters\nMeet a host of unforgettable creatures, including rideable seahorses, hungry sharks, and ditzy dolphins, each bringing their own quirks to the journey. These characters will aid or hinder you as you navigate the challenges of the deep.\n\nCreative Problem-Solving and Exploration\nFace puzzles and obstacles designed to encourage experimentation. Use your octopus abilities to find inventive solutions, with no single correct path\u2014just the most entertaining one tailored to your style of play.\n", "short_description": "A whimsical adventure where you embrace your inner octopus to unlock the secrets of the ocean."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1k0owSBxjblbVp8OfBmiJs3Zrpr617dUnSihHfEbeiwk/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "OctoKid", "support_website_url": null, "website_url": "https://www.youtube.com/@OctoKid-game", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9669156333149175"}}]}, "scheduled_offers": {"count": 7, "nodes": [{"status": "PUBLISHED", "id": "1805876510829790"}, {"status": "PUBLISHED", "id": "1737669550900244"}, {"status": "PUBLISHED", "id
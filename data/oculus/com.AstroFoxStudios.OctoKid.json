 "544957558135042", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/473392168_544957561468375_3639563635144489999_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m8JUdzrGa8kQ7kNvwGrXacr&_nc_oc=AdqjFA2tguqKoAxpwbcEQVq78j-ox9CNixbsAmukKAXYvjHmj046i9yqn26PISM7Zzo&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ7C7Urrb0hhnvHe1nZHhIiA11tOgIE5fu4wEQknhZT5w&oe=6AA423A9"}]}, "id": "1257037865990978", "locale": "en_US", "screenshots": [{"file_name": "ScreenshotEdited_UseTools.png", "id": "1174285637748317", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/473392129_1174285641081650_5057845893161029950_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aIIVzZsQIOwQ7kNvwHjpp3a&_nc_oc=Ado7FHIkVQft7x6_Dz186QQx2jszlz7XrHMsGsspvi4-7OvCTlia0U6uqF1zN8z1oDE&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLibNYl8Gu_7du4I0ZDA95bhjdbGNrfS8omS6fWREVuDQ&oe=6AA423C1"}, {"file_name": "ScreenshotEdited_FindTreasure.png", "id": "950203280529295", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/473393469_950203283862628_5022957251259808908_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4BoyOsY5pTEQ7kNvwEiEa_O&_nc_oc=AdpMW4IfWdHBvSznuMu4m2jxuIULhyHueNpchC4Dao09sgsY6ocilUBgKsguCtagmMc&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJZRxeW-5MZ5iv8cuNAdZk1YEHgCZ0VGP4carmqhn3tKA&oe=6AA416AF"}, {"file_name": "ScreenshotEdited_ExploreTheOceans.png", "id": "1375912747156537", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/473392301_1375912750489870_7064854329659738642_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fPaDSvNE82MQ7kNvwE2oaa2&_nc_oc=Adrs3rVSxLuOOyC3skn7N39GLpk1Zqm9Dvj_haNhhuBjjvr5ibUFULphXrpOnJh0IaU&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL0GBKaPv1keGBe9TRBhl7tJqdYH-Nnls_ELhuA1t_6Ag&oe=6AA3F948"}, {"file_name": "ScreenshotSized_TreasureIsland.png", "id": "1110278400782641", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/473392036_1110278404115974_3104724029484161853_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uo8mIizxXXUQ7kNvwHggYU4&_nc_oc=AdpT5Cn3qqnWH14KTUYyLSHHA5Od4Us5ezrc1YL3Z3gxQXqgQ5CNl0aZufdroUjLc7Q&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLjN6jUH22kFHd_APzKE-tAkmcUUQs-Or7jwuKKS5IEfg&oe=6AA4215E"}, {"file_name": "ScreenshotSized_TakingCowboysHat.png", "id": "1905349053557181", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/473393333_1905349056890514_5404405864169297915_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lGas8tnaRaQQ7kNvwGQ-B4Q&_nc_oc=Adr-lBSSfRR0SnsvnANVJjew6OIFDX-yW2XxR77F_z_fnK2GRBLcgDZdYhzMA0l1FlI&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJfm4VQJWXiJlj9h9vos1fsfyDizaqFuZJbrqpa9otVqw&oe=6AA405CB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440TrailerCover.png", "id": "1206378811497322", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/473392129_1206378814830655_1365346645050814148_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pjLv73MBtS0Q7kNvwGH9j-7&_nc_oc=AdozjkXm7ao2qoFu7MoYG9gGmyb28eOPv5VWXpAWo4XFmXAxdT1fV5Xpks8OUEz2jcw&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKkxiYc0nvK_ZsR1mSs8qDO3vST8fWf4pS4XgWL4vmpwQ&oe=6AA3FCBA"}, "display_name": "OctoKid", "keywords": ["adventure", "puzzle", "simulation", "underwater", "child"], "long_description": "Submerge yourself in an underwater adventure as a cheeky octopus in OctoKid. Explore sunken towns, befriend sea creatures, and discover treasures of the deep to become the master of the oceans! \n\nIt is up to you to sling, leap, climb, stick and camouflage your way through various environments on your hunt to find your missing friend.\n\nFluid Hand-Based Locomotion\nGlide effortlessly across the ocean floor with intuitive, hand-based movement mechanics, offering an unparalleled sense of freedom as you slip through coral reefs and hidden underwater caves.\n\nExpansive Underwater World: Explore a vibrant, open ocean brimming with life\u2014from bustling coral towns to erie ships\u2014offering endless opportunities for discovery and adventure.\n\nDiverse Cast of Characters\nMeet a host of unforgettable creatures, including rideable seahorses, hungry sharks, and ditzy dolphins, each bringing their own quirks to the journey. These characters will aid or hinder you as you navigate the challenges of the deep.\n\nCreative Problem-Solving and Exploration\nFace puzzles and obstacles designed to encourage experimentation. Use your octopus abilities to find inventive solutions, with no single correct path\u2014just the most entertaining one tailored to your style of play.\n", "short_description": "A whimsical adventure where you embrace your inner octopus to unlock the secrets of the ocean."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1k0owSBxjblbVp8OfBmiJs3Zrpr617dUnSihHfEbeiwk/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "OctoKid", "support_website_url": null, "website_url": "https://www.youtube.com/@OctoKid-game", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9669156333149175"}}]}, "scheduled_offers": {"count": 6, "nodes": [{"status": "PUBLISHED", "id": "1737669550900244"}, {"status": "PUBLISHED", "id": "2616767925448665"}, {"sta
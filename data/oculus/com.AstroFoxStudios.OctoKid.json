3hKshtzChAlqqLYG_0Vlvpw&oe=6B09B35D"}, {"file_name": "Shot3.png", "id": "2205563807508920", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499628456_2205563810842253_8470917042334740775_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6hGGLYFSwXgQ7kNvwENBTlC&_nc_oc=AdqZ4Y5kzwoWp4JH0YA9KMDqSetJwAmqg6LBzi0scA_PJyMbs7TEmTW87zPNr5ogRRI&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ6646-VfYpV75TOCNrrJS9FsP8_HdZ4tOYVVQ3enVcJA&oe=6B09B476"}, {"file_name": "2.png", "id": "1074400142302367", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499620341_1074400145635700_7384453347905714234_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nfC0m9hhdGkQ7kNvwFEb_iP&_nc_oc=AdolHnJ5cNd46Q3XFFDoFl4B4BEi3SpDxM0J-DXXgFignOCydN8tjgoHf6c4JvMasvI&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS0sKnKhdBVov53vD92eFjYvnYDjPawchRyYzBCpmjRDQ&oe=6B09C2FE"}, {"file_name": "4-brightened.png", "id": "2583485788820167", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/593801605_2583485792153500_6390804457007027383_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s8QnXY3GAQMQ7kNvwFyYJni&_nc_oc=AdqgOPeXICjURwOuXtVHiSz54ESG4Iw7MiIR4Z9mCvxSVvTFGgWJEGAfB6t_o7EEk6U&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSq82fuOF5VUxy40TWFpqJw5eHXHpFNRD-aFXx6dmcjXQ&oe=6B09A8A6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "I_Am_Octopus_2560x1440.png", "id": "1651127956362274", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499623115_1651127959695607_7188145749045593519_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XVXVQXOGb9YQ7kNvwG1CwTd&_nc_oc=AdpNHwEn3zHQMuJBa8rI106V-68147JsSV3AnIlaK8od8jLMsgabhh4oROOXOIO1mlU&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQgMSswzHO-zGTQgCOutJRq1BpzVX9Tj44yIOJv_KZkww&oe=6B09B026"}, "display_name": "I Am Octopus", "keywords": ["puzzle", "simulation", "underwater", "octopus", "sandbox"], "long_description": "You wake up in Dr Docto's lab. He wants to see what an octopus can do. Show him. Swing around your tank, wreck his desk, flush yourself down the toilet and fight your way out through 10 levels of his worst experiments.\n\n# \ud83e\udd91  Your Arms Are the Tentacles\nReach out and stick to anything. Grab walls, swing from pipes, fling yourself across the room and climb straight up the glass. Once it clicks, nothing else moves like it.\n{1492956486004336}\n\n# \u270b  Grab Everything\nPick up shells, rocks, hammers, potions, fish and Dr Docto's stuff. If it isn't bolted down, it's yours.\n\n{1552753286900830}\n\n# \ud83d\udca5  Cause Chaos in the Lab\nGet out of the water and onto the scientist's desk. Knock things off shelves, smash glass and make a mess of his experiments.\n\n# \ud83d\udebd Escape the Toilet Pipe\nRace down a giant toilet pipe while a drill chases you from behind. How far can you get? Post your best distance on the leaderboard.\n\n{986979427786771}\n\n# \ud83c\udf0b  Outrun the Lava\nIn Lava Lands the floor really is lava, and it's rising. Launch, jump and fly through the obstacles before it catches you.\n\n# \ud83d\ude80  Weapons and Gadgets\nRocket launchers, jetpack, hammers, jet skis, bubble guns, bombs and more!\n\n{3938100129665209}\n\n# \ud83c\udfa8  Unlock New Tentacle Skins\nComplete achievements to earn new tentacles: metal, rainbow, lava and cameo are only the beginning. Make your octopus your own\n\n{1673540980820038}\n\n# \ud83d\udcac JOIN OUR DISCORD\nhttps://discord.gg/qaHH4hZn7c\n", "short_description": "\ud83d\udc19 I Am Octopus is a physics-driven VR octopus sandbox. Eight tentacles, one evil scientist, and a lab full of things to grab, smash and eat."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1W7N6YNSDoTKS8CE-1zm9OGkCeehHff4DgO7IO-b4ULI/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "OctoKid", "support_website_url": null, "website_url": "https://iamoctopus.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "1990104051447093"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "29230339886604195"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499624069_1611601570449588_7451648998071502723_n.png?stp=dst-png_s360x360&_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZIFNqdNkdZ4Q7kNvwEsOqVl&_nc_oc=AdoDRhiAaxjEciAV02osbwcWpThFgNr4AQZi-lcuY3ZREiQ2vx434mYhxCqy2s9XOJA&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS21lGEcgdT8_AHCB8D_n06b8CcG3iY3HrQoaccRKt6jQ&oe=6B09B62B"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "I Am Octopus", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Adventure", "id": "2691890164460465"}, {"topic_name": "Sandbox", "id": "1990104051447093"}, {"topic_name": "Simulation", "id": "331529188132278"}], "release_date": 1774613640, "lastRevision": {"nodes": [{"id": "9608086565922819", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "9608086525922823", "is_first_party": false, "enables_in_app_ads": 
png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6sn_A0Ac-r8Q7kNvwEF5u-K&_nc_oc=AdrnH0p-Saw_V-nhDfsCPzioGXvz2IEZcKMIt3zr3ni3f2cLbXk0t3LmcKJ_MUfJWKw&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRxbyrbIFvddfbxftSJA_2Xep2zRag38vteag9wnHQEsQ&oe=6AE89E5F"}, {"file_name": "TentacleRainbowOutside.png", "id": "4528135120842339", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/499622184_4528135124175672_3511363741787137780_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Cnf-vnQR4l0Q7kNvwExO5jH&_nc_oc=AdoE7leMi12ReRcNsxYBucEbzpOcN0OiuAyjZmugcotp1WgVHrzagdISfm0qdnMeuFs&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRjI0KRHm44nS98LpiGjkfHaTu7qzb_66oid8ay_n4JKg&oe=6AE8B50B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImage_Shading_Lighting2.png", "id": "1003556942600281", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499619668_1003556945933614_6328488806965023609_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IUPeNaNwmiQQ7kNvwGZ3WsS&_nc_oc=AdrwmpURU9Y2uuNFAaMMojLJ-5Xcm4nA9v2Av6iv3ArrcLAAt1-TiVo-1iNpQRgby24&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRRKHdMWTo15QnWBB9Rc25FzDBWXDv3K6fNVGGbiL9fgQ&oe=6AE89D84"}, "display_name": "I Am Octopus", "keywords": ["puzzle", "simulation", "underwater", "octopus", "sandbox"], "long_description": "**\ud83d\udc19What would you do if you woke up one day and you were an Octopus\ud83d\udc19** \n\nEven worse, being held captive by the evil Dr Docto who is back on his evil ways...and wait, is he using you as a test subject?\n{551689834705146}\nIt is up to you to sling, leap, climb, stick, battle, eat and camouflage your way through various experiments that Dr Docto has in store for you as you try to escape his clutches to become stronger...so much stronger...\n{2261700674357472}\n# \ud83e\udd8d Fluid Hand-Based Locomotion \ud83d\udc19\nGlide effortlessly through tanks and across the laboratory floor with intuitive, hand-based movement, offering an unparalleled sense of freedom as you manoeuvre around tricky puzzles and outwit Dr Docto.\n{838212458588756}\n# \ud83c\udfc6Creative Problem-Solving and Exploration\ud83e\udde9\nFace puzzles and obstacles designed to encourage experimentation. Use your octopus abilities to find inventive solutions, outwitting Dr Docto and proving your worth\n{2672923563073399}", "short_description": "Dr Docto is up to his evil ways and is trying to create a new type of Super Octopus. Can you survive the trials and escape?\n\nUse your octopus abilities to become stronger...so much stronger..."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1W7N6YNSDoTKS8CE-1zm9OGkCeehHff4DgO7IO-b4ULI/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "OctoKid", "support_website_url": null, "website_url": "https://www.youtube.com/@iamoctopus-vr", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "1990104051447093"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "28837222892582565"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/593734382_1093980423599763_3908341434615900255_n.png?stp=dst-png_s360x360&_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wyhzdkvZ45cQ7kNvwEpfha-&_nc_oc=AdrEdVY2VhU2Z9P3ouklysP4NcpZO5s81YpEkO09c2pXbZOerUIZ0j5rYJ0TxH_tqxk&_nc_z
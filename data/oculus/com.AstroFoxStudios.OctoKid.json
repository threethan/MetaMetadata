n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1VRDwgs7pnIQ7kNvwHU0J_2&_nc_oc=AdriOgtjnYP_irMD4zooyVwtmrLRhlh2eV2of6jHh9pXPYfE9nYOld1UjjHFqv45ey0&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLf5i29wgFc9oQrvGKV46hhIGdHVI8stkNQ2jpNcgUqUg&oe=6AB69C0B"}, {"file_name": "turret.png", "id": "1376398380708380", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499620341_1376398384041713_3441413981880375147_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YFvTIgv71zUQ7kNvwEBjDNh&_nc_oc=AdpQ-TxjY5waZudigRSnoGOwol33iwvLUTJEKOGnCqYpquDOc2R6S2SgJFpixSHpZSM&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIUeBHLa1OXqZiZgZ-iCLXKoiNh9NqN-HxXmubuHIf5XA&oe=6AB669C8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImage_Shading_Lighting2.png", "id": "1003556942600281", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499619668_1003556945933614_6328488806965023609_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tPE4NQe5124Q7kNvwEuBeyW&_nc_oc=Adp8F6lOrQ6PTbyV2HZXvzmB4qFN8l0LOMTcDtpzGnsVF3FVJrvJ5N8-QzSqk1GgwgI&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKX1qWhjuGpHmKPJ-IEC1X3QtT4JP4vtlQ9IIgLikadGw&oe=6AB68484"}, "display_name": "I Am Octopus", "keywords": ["adventure", "puzzle", "simulation", "underwater", "octopus"], "long_description": "**\ud83d\udc19What would you do if you woke up one day and you were an Octopus\ud83d\udc19** \n\nEven worse, being held captive by the evil Dr Docto who is back on his evil ways...and wait, is he using you as a test subject?\n{551689834705146}\nIt is up to you to sling, leap, climb, stick, battle, eat and camouflage your way through various experiments that Dr Docto has in store for you as you try to escape his clutches to become stronger...so much stronger...\n{2261700674357472}\n# \ud83e\udd8d Fluid Hand-Based Locomotion \ud83d\udc19\nGlide effortlessly through tanks and across the laboratory floor with intuitive, hand-based movement, offering an unparalleled sense of freedom as you manoeuvre around tricky puzzles and outwit Dr Docto.\n{838212458588756}\n# \ud83c\udfc6Creative Problem-Solving and Exploration\ud83e\udde9\nFace puzzles and obstacles designed to encourage experimentation. Use your octopus abilities to find inventive solutions, outwitting Dr Docto and proving your worth\n{2672923563073399}", "short_description": "Dr Docto is up to his evil ways and is trying to create a new type of Super Octopus. Can you survive the trials and escape?\n\nUse your octopus abilities to become stronger...so much stronger..."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1W7N6YNSDoTKS8CE-1zm9OGkCeehHff4DgO7IO-b4ULI/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "OctoKid", "support_website_url": null, "website_url": "https://www.youtube.com/@iamoctopus-vr", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "459781504968480"}, {"id": "331529188132278"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "28271979345773592"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/499619836_1028841816355531_6682923681196234282_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ojh4Iti-ZZ4Q7kNvwGIPL5L&_nc_oc=Ado3CiXXrXrsFc3rs0ns5Nh-jQtvn4ua2fOEFPPrzQJSveF1Zvxs9L4r3wU
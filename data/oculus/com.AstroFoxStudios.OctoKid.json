gsy4Q7kNvwElExvn&_nc_oc=AdoMmJrMhBYEuTClZNxtbL-Ez1pJNs_NkGRcv33TSwQDVhJXDg-nlYTVujxu3sAStRY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGDHWeIMmcEqOBF4RF5hpS4oQbxZbVn_BoYT_RAARx6aw&oe=6A7C6A8C"}, {"file_name": "Screen_4.png", "id": "1482369780260044", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499618252_1482369786926710_1663914425661675740_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ho3FHmfddLMQ7kNvwGjN3xY&_nc_oc=Adq1jOaef9iCptlAqEs_FSrnlcJD-O81s1J6YmEAgQwsiryv2CqJHatNU3kdTgUgRAA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF7ywCQyWGk8ZaKa4akR2BvuKCcnrbeq6_oP3EhJ05f3A&oe=6A7C5CF9"}, {"file_name": "Screen_5.png", "id": "961122093080452", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499618442_961122096413785_3046747836212769998_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Tu9FJ30KhdgQ7kNvwE-6YMn&_nc_oc=Adp8zM91Ht_ixvG5NpNtNba4PvOa1QT9BY4YvKFuFL9prx9PUNTvASSWFdWcjieh_l0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEohbeJ70Pv1ldaZOtGzxwo4aif9LPPkUGMruyUFjfFmg&oe=6A7C6DCD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImage_Shading_Lighting2.png", "id": "1003556942600281", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499619668_1003556945933614_6328488806965023609_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Qm13bjK_VT4Q7kNvwF_0mys&_nc_oc=AdqMErBAmkas9iZubJL2STJIpEvwlnBIP7ZgiMXDWnxrz8HwVP5caCvfmxiXWItVxbY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHK0B_iFchEazCa61-CTN2iZTCaV3cd194Ks3ThDFSKOQ&oe=6A7C4A44"}, "display_name": "I Am Octopus", "keywords": ["adventure", "puzzle", "simulation", "underwater", "octopus"], "long_description": "**\ud83d\udc19What would you do if you woke up one day and you were an Octopus\ud83d\udc19** \n\nEven worse, being held captive by the evil Dr Docto who is back on his evil ways...and wait, is he using you as a test subject?\n{551689834705146}\nIt is up to you to sling, leap, climb, stick, battle, eat and camouflage your way through various experiments that Dr Docto has in store for you as you try to escape his clutches to become stronger...so much stronger...\n{2261700674357472}\n# \ud83e\udd8d Fluid Hand-Based Locomotion \ud83d\udc19\nGlide effortlessly through tanks and across the laboratory floor with intuitive, hand-based movement, offering an unparalleled sense of freedom as you manoeuvre around tricky puzzles and outwit Dr Docto.\n{838212458588756}\n# \ud83c\udfc6Creative Problem-Solving and Exploration\ud83e\udde9\nFace puzzles and obstacles designed to encourage experimentation. Use your octopus abilities to find inventive solutions, outwitting Dr Docto and proving your worth\n{2672923563073399}", "short_description": "Dr Docto is up to his evil ways and is trying to create a new type of Super Octopus. Can you survive the trials and escape?\n\nUse your octopus abilities to become stronger...so much stronger..."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1W7N6YNSDoTKS8CE-1zm9OGkCeehHff4DgO7IO-b4ULI/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "OctoKid", "support_website_url": null, "website_url": "https://www.youtube.com/@iamoctopus-vr", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "459781504968480"}, {"id": "331529188132278"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user
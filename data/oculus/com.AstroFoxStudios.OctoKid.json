/473392036_1110278404115974_3104724029484161853_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ixCgxJjuHDIQ7kNvwG0FRcc&_nc_oc=AdrLEp-Bj5M7OxosKMlNepQSQGrUcF3yfUVs5b3XYpcPOS7BIYqMEn6-tsoj7EDazhM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJU5bRLwLVrTSZa8EG1kTpSVbeGCKdEQXSO379zarwvhg&oe=6AA815DE"}, {"file_name": "ScreenshotSized_TakingCowboysHat.png", "id": "1905349053557181", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473393333_1905349056890514_5404405864169297915_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bxtv6CKXehsQ7kNvwHA96EC&_nc_oc=AdqMdS-ZoFpMbv8SMr9O1d_5FIiO5Cw01H8FCHwOZu20yFrt7xS_42VrGZT6St_9sB4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK-5yAagaQSS0UnIhnMlj0NilqJ00ErGTwmY31cVqigWw&oe=6AA7FA4B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440TrailerCover.png", "id": "1206378811497322", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473392129_1206378814830655_1365346645050814148_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nV_Xpvj-SSkQ7kNvwGH_Bcw&_nc_oc=AdqvzapBCw57l0Cf6FTdk8QzTaL3L1J6qgSjqo2SL8fZXYtCmS876lOVvjP5NS4jRpw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ1xJuV5DHbI6q2YSydei-nRE9goYb698vXDpXUZ9l6HA&oe=6AA7F13A"}, "display_name": "OctoKid", "keywords": ["adventure", "puzzle", "simulation", "underwater", "child"], "long_description": "Submerge yourself in an underwater adventure as a cheeky octopus in OctoKid. Explore sunken towns, befriend sea creatures, and discover treasures of the deep to become the master of the oceans! \n\nIt is up to you to sling, leap, climb, stick and camouflage your way through various environments on your hunt to find your missing friend.\n\nFluid Hand-Based Locomotion\nGlide effortlessly across the ocean floor with intuitive, hand-based movement mechanics, offering an unparalleled sense of freedom as you slip through coral reefs and hidden underwater caves.\n\nExpansive Underwater World: Explore a vibrant, open ocean brimming with life\u2014from bustling coral towns to erie ships\u2014offering endless opportunities for discovery and adventure.\n\nDiverse Cast of Characters\nMeet a host of unforgettable creatures, including rideable seahorses, hungry sharks, and ditzy dolphins, each bringing their own quirks to the journey. These characters will aid or hinder you as you navigate the challenges of the deep.\n\nCreative Problem-Solving and Exploration\nFace puzzles and obstacles designed to encourage experimentation. Use your octopus abilities to find inventive solutions, with no single correct path\u2014just the most entertaining one tailored to your style of play.\n", "short_description": "A whimsical adventure where you embrace your inner octopus to unlock the secrets of the ocean."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1k0owSBxjblbVp8OfBmiJs3Zrpr617dUnSihHfEbeiwk/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "OctoKid", "support_website_url": null, "website_url": "https://www.youtube.com/@OctoKid-game", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9669156333149175"}}]}, "scheduled_offers": {"count": 7, "nodes": [{"status": "PUBLISHED", "id": "1805876510829790"}, {"status": "PUBLISHED", "id": "1737669550900244"}, {"status": "PUBLISHED", "id
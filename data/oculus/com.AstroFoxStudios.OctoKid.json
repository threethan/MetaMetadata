b=1-7&_nc_sid=6e7a0a&_nc_ohc=ShSPBIfRSLcQ7kNvwEoVf_0&_nc_oc=AdrnLCvhF_2E5KJv0gy4Na3XrdnIAb21_2IOMcYX3VCvtlYRi-R9iKpjG6K59YUbIbg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5_Q5ZfidoO8oHIJGYTDSlUXBxvDXXyczxJfXqxwrvTCA&oe=6A00A839"}, {"file_name": "Screen_5.png", "id": "961122093080452", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499618442_961122096413785_3046747836212769998_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D-z5fn0MNFYQ7kNvwEfMA9w&_nc_oc=AdoQKaI7CW8NJP-Zm2KlpmpDPJ0TJxLe7Yj3raoKRgYk-3ajkpLXOOZcWph-EthRLbo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6Cg1BSmh6jYn11ECtGwgra56fjmW5BKYuoKhLo3beTAg&oe=6A0080CD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover_Landscape.png", "id": "949261940825887", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499618512_949261944159220_1327135970651479371_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TJCAHicfJPcQ7kNvwFmMY8G&_nc_oc=AdqYlFpQXnylE8GqT1OcbpOL2HmlZQL_0xoCF4BIeFc1YmTdlIz_V1GaDAIJyDuokuo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af42BiRXYliA4kGIV0PkRgaCO0gdE1bgOMeONnIWxekO5w&oe=6A008E13"}, "display_name": "I Am Octopus", "keywords": ["adventure", "puzzle", "simulation", "underwater", "octopus"], "long_description": "**\ud83d\udc19What would you do if you woke up one day and you were an Octopus\ud83d\udc19** \n\nEven worse, being held captive by the evil Dr Docto who is back on his evil ways...and wait, is he using you as a test subject?\n{551689834705146}\nIt is up to you to sling, leap, climb, stick, battle, eat and camouflage your way through various experiments that Dr Docto has in store for you as you try to escape his clutches to become stronger...so much stronger...\n{2261700674357472}\n# \ud83e\udd8d Fluid Hand-Based Locomotion \ud83d\udc19\nGlide effortlessly through tanks and across the laboratory floor with intuitive, hand-based movement, offering an unparalleled sense of freedom as you manoeuvre around tricky puzzles and outwit Dr Docto.\n{838212458588756}\n# \ud83c\udfc6Creative Problem-Solving and Exploration\ud83e\udde9\nFace puzzles and obstacles designed to encourage experimentation. Use your octopus abilities to find inventive solutions, outwitting Dr Docto and proving your worth\n{2672923563073399}", "short_description": "Dr Docto is up to his evil ways and is trying to create a new type of Super Octopus. Can you survive the trials and escape?\n\nUse your octopus abilities to become stronger...so much stronger..."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1W7N6YNSDoTKS8CE-1zm9OGkCeehHff4DgO7IO-b4ULI/", "developer_terms_of_service_url": null, "publisher_name": "OctoKid", "support_website_url": null, "website_url": "https://www.youtube.com/@iamoctopus-vr", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "459781504968480"}, {"id": "331529188132278"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26761048063533402"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499619680_1430446918265048_2150753813481591559_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dhFx3ejIPs4Q7kNvwFmY-lr&_nc_oc=Adq6-Pbwr-RPJiJF5n5rbKjB0KOJjG24ASPcJOJLVxLTQAUpGWSzy2zdPr7Zubqdll0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.
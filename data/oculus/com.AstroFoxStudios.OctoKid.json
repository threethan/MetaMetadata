b=1-7&_nc_sid=6e7a0a&_nc_ohc=Gcq3Zl4KQIYQ7kNvwFUApDv&_nc_oc=AdoDtqRmHc140KNCq2aL8c4jRSzV1_7pe8EWghq1i6OSfHjIS9M1GjTmQ_rVxpAxSO4&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1wtolpG3EuE9D7ER4zwFs27p2JB7ZtaDU74L_Y4Ff-2w&oe=69F340F9"}, {"file_name": "Screen_5.png", "id": "961122093080452", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499618442_961122096413785_3046747836212769998_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Pi7yjWHjyK0Q7kNvwGpkkjk&_nc_oc=AdpG9BJgUxJUCFrw6kvC46OiMXPaG4F4JNGbB77eStqi2ECj75tTA_hPLlRMcAxWeUo&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1BN_GLQiPgI9LOyhUDc0amTiri6_Xs3joRnK9uC98icQ&oe=69F351CD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover_Landscape.png", "id": "949261940825887", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/499618512_949261944159220_1327135970651479371_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U0vuqhbLyA0Q7kNvwGEXtdt&_nc_oc=AdrB47rZVJKiXzM999Nt2yq_BRkaU5Qd7oyeNJbOcjypbaa0huuBdeMdgrr6u2YSyzk&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1egmua0PgZh0h0Rnu-k44h4ZueDJNjdOyUFNWvOwEc-g&oe=69F35F13"}, "display_name": "I Am Octopus", "keywords": ["adventure", "puzzle", "simulation", "underwater", "octopus"], "long_description": "**\ud83d\udc19What would you do if you woke up one day and you were an Octopus\ud83d\udc19** \n\nEven worse, being held captive by the evil Dr Docto who is back on his evil ways...and wait, is he using you as a test subject?\n{551689834705146}\nIt is up to you to sling, leap, climb, stick, battle, eat and camouflage your way through various experiments that Dr Docto has in store for you as you try to escape his clutches to become stronger...so much stronger...\n{2261700674357472}\n# \ud83e\udd8d Fluid Hand-Based Locomotion \ud83d\udc19\nGlide effortlessly through tanks and across the laboratory floor with intuitive, hand-based movement, offering an unparalleled sense of freedom as you manoeuvre around tricky puzzles and outwit Dr Docto.\n{838212458588756}\n# \ud83c\udfc6Creative Problem-Solving and Exploration\ud83e\udde9\nFace puzzles and obstacles designed to encourage experimentation. Use your octopus abilities to find inventive solutions, outwitting Dr Docto and proving your worth\n{2672923563073399}", "short_description": "Dr Docto is up to his evil ways and is trying to create a new type of Super Octopus. Can you survive the trials and escape?\n\nUse your octopus abilities to become stronger...so much stronger..."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1W7N6YNSDoTKS8CE-1zm9OGkCeehHff4DgO7IO-b4ULI/", "developer_terms_of_service_url": null, "publisher_name": "OctoKid", "support_website_url": null, "website_url": "https://www.youtube.com/@iamoctopus-vr", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "459781504968480"}, {"id": "331529188132278"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26761048063533402"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499619680_1430446918265048_2150753813481591559_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lXOGa7n0964Q7kNvwEwbt2F&_nc_oc=AdoISfEuxL5rsJRikKNgqcAqk2MBZDKHVZnGJiuPyISnqfy5vkrL7iHFjvdF1EDl4fk&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.
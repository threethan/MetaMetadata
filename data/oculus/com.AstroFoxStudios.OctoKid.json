sid=6e7a0a&_nc_ohc=D9wGuJw3E98Q7kNvwHMycvI&_nc_oc=Adoc6j4xn1lqg-8xJ0Pm5XFMlLVDaN-hqjazUxN4_3aA5G_Bm77J2qVNOysjhqDvXns&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF8LaRCjRNHcthf93pN1MeIPxKwCcUh31D8QT2p-DJmLg&oe=6A79C948"}, {"file_name": "ScreenshotSized_TreasureIsland.png", "id": "1110278400782641", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473392036_1110278404115974_3104724029484161853_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O5SJODAGzScQ7kNvwFKhyud&_nc_oc=Adps0yNZsMBUIgTZJw5OSNewz4wZTpYkVtUYAlQpJq9phXZ9tRL_v7K-LcSx-TcfRT8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF9n0D1EVdhRF9tzND26XTDtA4F-NaoKQUyP6cwV0KSkQ&oe=6A79B91E"}, {"file_name": "ScreenshotSized_TakingCowboysHat.png", "id": "1905349053557181", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473393333_1905349056890514_5404405864169297915_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=86v2xqBDgL0Q7kNvwHinVtI&_nc_oc=AdrNr2kolZfIbmtnU_Q4Lqs-O7OwscrbyIuoxAsPavevOAw-npoWP33ikxpBdx96tpc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHsGQUeZd5qvMQLPRIF-UmY3DvJj63pzwSYZ_QADsD_5g&oe=6A79D5CB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440TrailerCover.png", "id": "1206378811497322", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473392129_1206378814830655_1365346645050814148_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oHo5sgdV3JgQ7kNvwHk3ZEQ&_nc_oc=AdqmAO_8JbWrSvsBJN5iqzr-N4WYIolNvkVSvyS_iVhNShwPQzJARKHkrnU5OVwKWbs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGnstBM_unQiGp-C-uLhvCsVBUAfv-BJv3jvrr_In4aIw&oe=6A79CCBA"}, "display_name": "OctoKid", "keywords": ["adventure", "puzzle", "simulation", "underwater", "child"], "long_description": "Submerge yourself in an underwater adventure as a cheeky octopus in OctoKid. Explore sunken towns, befriend sea creatures, and discover treasures of the deep to become the master of the oceans! \n\nIt is up to you to sling, leap, climb, stick and camouflage your way through various environments on your hunt to find your missing friend.\n\nFluid Hand-Based Locomotion\nGlide effortlessly across the ocean floor with intuitive, hand-based movement mechanics, offering an unparalleled sense of freedom as you slip through coral reefs and hidden underwater caves.\n\nExpansive Underwater World: Explore a vibrant, open ocean brimming with life\u2014from bustling coral towns to erie ships\u2014offering endless opportunities for discovery and adventure.\n\nDiverse Cast of Characters\nMeet a host of unforgettable creatures, including rideable seahorses, hungry sharks, and ditzy dolphins, each bringing their own quirks to the journey. These characters will aid or hinder you as you navigate the challenges of the deep.\n\nCreative Problem-Solving and Exploration\nFace puzzles and obstacles designed to encourage experimentation. Use your octopus abilities to find inventive solutions, with no single correct path\u2014just the most entertaining one tailored to your style of play.\n", "short_description": "A whimsical adventure where you embrace your inner octopus to unlock the secrets of the ocean."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1k0owSBxjblbVp8OfBmiJs3Zrpr617dUnSihHfEbeiwk/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "OctoKid", "support_website_url": null, "website_url": "https://www.youtube.com/@OctoKid-game", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supp
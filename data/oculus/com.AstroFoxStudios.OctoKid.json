sid=6e7a0a&_nc_ohc=WOidUonLemsQ7kNvwEmWjYL&_nc_oc=Adp9U2BqUy3nKIJDA6PDXYnvNL-dRXtQaiUPF-NADFiHNk4JURmvV26c0mDL4fEJZug&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG43ias1sECNW6nfvPKOS3QXv6wpa_hQJuKkaEQySUuaw&oe=6A8303C8"}, {"file_name": "ScreenshotSized_TreasureIsland.png", "id": "1110278400782641", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473392036_1110278404115974_3104724029484161853_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SlcEZ7n_ts8Q7kNvwGL6wJI&_nc_oc=AdoTBQuoOmCgiAQSmm61s6eLenMWAXErGjea1C6tMvvHGwh3hGZgj9Q-m9ctIRX7D3Y&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHRMiDtem1ujGSm4FYWC9eAcrma9hiPl09vFbYwNNhmlg&oe=6A82F39E"}, {"file_name": "ScreenshotSized_TakingCowboysHat.png", "id": "1905349053557181", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473393333_1905349056890514_5404405864169297915_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KOnq_WfMqfIQ7kNvwE7jbSy&_nc_oc=AdqreGE0LErCMyQhw-AWU7xTQYUvR38670cJBNmQ8SeDUXHdAkggJ1oz6QAurkFHCEY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGyApwr56hZDf277ovkg6U80cKknedShp7DVpYETgka1w&oe=6A83104B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440TrailerCover.png", "id": "1206378811497322", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473392129_1206378814830655_1365346645050814148_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3j5gkx60SyoQ7kNvwEl__Pi&_nc_oc=AdpA4tSQE1xSKoee8AZs_TxHBPfWLYickgT9lSlQWtOUhS3iyZNrhd4FaBIGf4volus&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFicZ_uOlBnmxx_BIwrfRvbhyXw3evRVwuv1KfyN7LlOg&oe=6A83073A"}, "display_name": "OctoKid", "keywords": ["adventure", "puzzle", "simulation", "underwater", "child"], "long_description": "Submerge yourself in an underwater adventure as a cheeky octopus in OctoKid. Explore sunken towns, befriend sea creatures, and discover treasures of the deep to become the master of the oceans! \n\nIt is up to you to sling, leap, climb, stick and camouflage your way through various environments on your hunt to find your missing friend.\n\nFluid Hand-Based Locomotion\nGlide effortlessly across the ocean floor with intuitive, hand-based movement mechanics, offering an unparalleled sense of freedom as you slip through coral reefs and hidden underwater caves.\n\nExpansive Underwater World: Explore a vibrant, open ocean brimming with life\u2014from bustling coral towns to erie ships\u2014offering endless opportunities for discovery and adventure.\n\nDiverse Cast of Characters\nMeet a host of unforgettable creatures, including rideable seahorses, hungry sharks, and ditzy dolphins, each bringing their own quirks to the journey. These characters will aid or hinder you as you navigate the challenges of the deep.\n\nCreative Problem-Solving and Exploration\nFace puzzles and obstacles designed to encourage experimentation. Use your octopus abilities to find inventive solutions, with no single correct path\u2014just the most entertaining one tailored to your style of play.\n", "short_description": "A whimsical adventure where you embrace your inner octopus to unlock the secrets of the ocean."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1k0owSBxjblbVp8OfBmiJs3Zrpr617dUnSihHfEbeiwk/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "OctoKid", "support_website_url": null, "website_url": "https://www.youtube.com/@OctoKid-game", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supp
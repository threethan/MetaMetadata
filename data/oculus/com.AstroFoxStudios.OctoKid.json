0a&_nc_ohc=IQKoWPnC_EAQ7kNvwEkmFc4&_nc_oc=AdpzPKvuP-f7EiL593q0gSBAyKaZOvdCoS-FNUKa8kCxHwoXVqInOvp9_MkL3OzmDKA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR53Q6Sl-d6LkumlgkQWbEvkofpAX1bPduN8VTM3A7rww&oe=6AFDE40B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440TrailerCover.png", "id": "1206378811497322", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473392129_1206378814830655_1365346645050814148_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=X3HPQCMIsIsQ7kNvwF1tbyo&_nc_oc=AdoRqgajs6aegrmRDSuestdWW-ckJAd4avLDPUgAvcC1hOhV55T-PtcWyBWo5Uu9_84&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSpmwC1ER581ksWecWlA76MKuf7PU_l9_ljZ0A71dcsFA&oe=6AFDDAFA"}, "display_name": "OctoKid", "keywords": ["adventure", "puzzle", "simulation", "underwater", "child"], "long_description": "Submerge yourself in an underwater adventure as a cheeky octopus in OctoKid. Explore sunken towns, befriend sea creatures, and discover treasures of the deep to become the master of the oceans! \n\nIt is up to you to sling, leap, climb, stick and camouflage your way through various environments on your hunt to find your missing friend.\n\nFluid Hand-Based Locomotion\nGlide effortlessly across the ocean floor with intuitive, hand-based movement mechanics, offering an unparalleled sense of freedom as you slip through coral reefs and hidden underwater caves.\n\nExpansive Underwater World: Explore a vibrant, open ocean brimming with life\u2014from bustling coral towns to erie ships\u2014offering endless opportunities for discovery and adventure.\n\nDiverse Cast of Characters\nMeet a host of unforgettable creatures, including rideable seahorses, hungry sharks, and ditzy dolphins, each bringing their own quirks to the journey. These characters will aid or hinder you as you navigate the challenges of the deep.\n\nCreative Problem-Solving and Exploration\nFace puzzles and obstacles designed to encourage experimentation. Use your octopus abilities to find inventive solutions, with no single correct path\u2014just the most entertaining one tailored to your style of play.\n", "short_description": "A whimsical adventure where you embrace your inner octopus to unlock the secrets of the ocean."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1k0owSBxjblbVp8OfBmiJs3Zrpr617dUnSihHfEbeiwk/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "OctoKid", "support_website_url": null, "website_url": "https://www.youtube.com/@OctoKid-game", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9669156333149175"}}]}, "scheduled_offers": {"count": 8, "nodes": [{"status": "PUBLISHED", "id": "1865571834580986"}, {"status": "PUBLISHED", "id": "1805876510829790"}, {"status": "PUBLISHED", "id": "1737669550900244"}, {"status": "PUBLISHED", "id": "2616767925448665"}, {"status": "PUBLISHED", "id": "910363602009901"}, {"status": "PUBLISHED", "id": "979913451214877"}, {"status": "PUBLISHED", "id": "2410461776069446"}, {"status": "PENDING", "id": "1596236118133658"}]}, "baseline_offer": {"id": "1865571834580986"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1793901600, "status": "PUBLISHED", "id": "1865571834580986"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "Andr
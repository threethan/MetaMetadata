png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j3qKRYxmzOUQ7kNvwEN75qp&_nc_oc=Adoi7AQzp7d530JGsIDLsmfzK9TX9x1lf-w4Jl8lRKF2PezfVxSkDKpC8mHbmqEZ8Uo&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOZ_u_3ufiQnWUDPHjatU0e83ojf3_rdxGVlcQ56Ukthg&oe=6AD3865F"}, {"file_name": "TentacleRainbowOutside.png", "id": "4528135120842339", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/499622184_4528135124175672_3511363741787137780_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LwYjYXhyokIQ7kNvwE0N2Hw&_nc_oc=Ado41kqCtzPfIFLdsJzf9hiYmOrwS7jywT-aGIo8sLRBbCas3j2gKhA4hqow9l59pnU&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMiXJbqNgdL7x67r5jd3hkoWOUS88AjRNxNr5YZB2G0sA&oe=6AD39D0B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImage_Shading_Lighting2.png", "id": "1003556942600281", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/499619668_1003556945933614_6328488806965023609_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P-724MjKITEQ7kNvwHj0jt1&_nc_oc=Adrmquo_GQXOXdbMFhlX0z3r2DGCarVRmeBzGqqLQ_RnG24Hc2i8vMxS0fLHVxhhqcc&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMt5krRNwo3uuBCbX1e6vU8Wf75ieubbj1_sZ2wdpNclQ&oe=6AD38584"}, "display_name": "I Am Octopus", "keywords": ["puzzle", "simulation", "underwater", "octopus", "sandbox"], "long_description": "**\ud83d\udc19What would you do if you woke up one day and you were an Octopus\ud83d\udc19** \n\nEven worse, being held captive by the evil Dr Docto who is back on his evil ways...and wait, is he using you as a test subject?\n{551689834705146}\nIt is up to you to sling, leap, climb, stick, battle, eat and camouflage your way through various experiments that Dr Docto has in store for you as you try to escape his clutches to become stronger...so much stronger...\n{2261700674357472}\n# \ud83e\udd8d Fluid Hand-Based Locomotion \ud83d\udc19\nGlide effortlessly through tanks and across the laboratory floor with intuitive, hand-based movement, offering an unparalleled sense of freedom as you manoeuvre around tricky puzzles and outwit Dr Docto.\n{838212458588756}\n# \ud83c\udfc6Creative Problem-Solving and Exploration\ud83e\udde9\nFace puzzles and obstacles designed to encourage experimentation. Use your octopus abilities to find inventive solutions, outwitting Dr Docto and proving your worth\n{2672923563073399}", "short_description": "Dr Docto is up to his evil ways and is trying to create a new type of Super Octopus. Can you survive the trials and escape?\n\nUse your octopus abilities to become stronger...so much stronger..."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1W7N6YNSDoTKS8CE-1zm9OGkCeehHff4DgO7IO-b4ULI/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "OctoKid", "support_website_url": null, "website_url": "https://www.youtube.com/@iamoctopus-vr", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "1990104051447093"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "28837222892582565"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/593734382_1093980423599763_3908341434615900255_n.png?stp=dst-png_s360x360&_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tyZLhOxDLDgQ7kNvwE7PgS0&_nc_oc=AdquXsBFL5F0Gpz-Jp72ogwitDhb-INwMjDIt4-XeVpcsZVQyzvLXlFH-_wbcdJlWYs&_nc_z
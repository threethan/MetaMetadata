sid=6e7a0a&_nc_ohc=3lHa5NdJ2G4Q7kNvwEhKb-Z&_nc_oc=AdpUe9OqSWjmhziqE0yGaByCXRAdUALJKwimYg4v6PPBHxljSgGCv1dbohxBqHkpVHs&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDAEBq6dYi0YczoESA4TkoZzkYZ25uYaqD-SePy1UCjnw&oe=6A5A2548"}, {"file_name": "ScreenshotSized_TreasureIsland.png", "id": "1110278400782641", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/473392036_1110278404115974_3104724029484161853_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nA4oezZWLh8Q7kNvwHgOKKK&_nc_oc=AdqYhnqlDOt-DPI5giE9seHeYGJoAd9RgiwXex0No8YfaaKIuI33_mvsbzQjOGctzcU&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB-20xkpOa26uW8Za4-SAz1BLBjuCzLeliPzGURNDjHvQ&oe=6A5A151E"}, {"file_name": "ScreenshotSized_TakingCowboysHat.png", "id": "1905349053557181", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/473393333_1905349056890514_5404405864169297915_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eYxB7cfNMWcQ7kNvwEX_PSv&_nc_oc=AdptWFBtpAKqilrapM76KBUpn9fP5EBlcmiEfdluhtA6Z-tRjWZQJtmLsiXl8EQ1Vu0&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDs8jWLvNt07-objhy539oRtqjZEvUqcJeati0-8KB_qA&oe=6A5A31CB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440TrailerCover.png", "id": "1206378811497322", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/473392129_1206378814830655_1365346645050814148_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MXdTPoL7OAUQ7kNvwECKEBq&_nc_oc=AdroNQnsuXFiaZNyPVeXSEpvtYxewuRi8HN_ABS7jr-CTRFBymhm8pIAOn9IerURL2w&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBJp9kEZmQnuxWvnl-R0J6IE9r4qOyf227DTvyMtU9feg&oe=6A5A28BA"}, "display_name": "OctoKid", "keywords": ["adventure", "puzzle", "simulation", "underwater", "child"], "long_description": "Submerge yourself in an underwater adventure as a cheeky octopus in OctoKid. Explore sunken towns, befriend sea creatures, and discover treasures of the deep to become the master of the oceans! \n\nIt is up to you to sling, leap, climb, stick and camouflage your way through various environments on your hunt to find your missing friend.\n\nFluid Hand-Based Locomotion\nGlide effortlessly across the ocean floor with intuitive, hand-based movement mechanics, offering an unparalleled sense of freedom as you slip through coral reefs and hidden underwater caves.\n\nExpansive Underwater World: Explore a vibrant, open ocean brimming with life\u2014from bustling coral towns to erie ships\u2014offering endless opportunities for discovery and adventure.\n\nDiverse Cast of Characters\nMeet a host of unforgettable creatures, including rideable seahorses, hungry sharks, and ditzy dolphins, each bringing their own quirks to the journey. These characters will aid or hinder you as you navigate the challenges of the deep.\n\nCreative Problem-Solving and Exploration\nFace puzzles and obstacles designed to encourage experimentation. Use your octopus abilities to find inventive solutions, with no single correct path\u2014just the most entertaining one tailored to your style of play.\n", "short_description": "A whimsical adventure where you embrace your inner octopus to unlock the secrets of the ocean."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1k0owSBxjblbVp8OfBmiJs3Zrpr617dUnSihHfEbeiwk/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "OctoKid", "support_website_url": null, "website_url": "https://www.youtube.com/@OctoKid-game", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supp
enshot 2024-08-29 152439.png", "id": "1083354099876401", "uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/57575347_1083354109876400_2150945295140510025_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qMOWLi48L_UQ7kNvwFjEiTX&_nc_oc=AdpUaMfHPljPpnY8NXeso56dOIdITYQSO2pOU5qeijugA8ZeTFZRxTzrjQzjPz9l5C0&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFkBVwlP_8vBiSO-M3ZmilGfyyiNOgKpzWpE3dYn1wAMA&oe=6A974AC0"}, {"file_name": "Screenshot 2024-08-29 153310.png", "id": "1706751140083993", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/75340703_1706751143417326_4955385660501928662_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FBmSijeRvzIQ7kNvwH-34Z9&_nc_oc=Adq7DRIhhU6Hc1FJ9BV5kjfli0tvuVhFQejf5i6xK5MQNl-6BRJutBzMbLXFDtN9Do0&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF7hxT-M8y6fNNVg-slgoS0qyDLdrSGJU-RQ_MT9xKsew&oe=6A9722D3"}, {"file_name": "Screenshot 2024-08-29 153805 (1).png", "id": "1750179509127850", "uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/38974667_1750179515794516_926704380804471609_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bBXn33BdrgsQ7kNvwFy-ADV&_nc_oc=Adpx_R0nhuBQ8fXkLJoEwz3o5qdOMkMTcbWU8XsAky4NTvws6PPO2XurN0VWINF0Jnk&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEckMMZDRKIHj3JIs9BysW-dt-XuGQky99wqTqvz6JJxA&oe=6A9721B5"}, {"file_name": "Screenshot 2024-08-29 154346.png", "id": "527324349804133", "uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/38974888_527324353137466_8256677203317541477_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xQdDpAIWWN8Q7kNvwFlhVE2&_nc_oc=Adqnnh8A9jAWdZmQ0wZsbEAV7OjDgL4Ug_9t1R6MjNTrZUcN1uCRi9G18YLQDS5JiXQ&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGKDUYcfxHAlnTLF78wYmBLZ5eUaFMZxXLYww1Bn4Hu8Q&oe=6A971C2A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Tiledmedia Player", "keywords": ["Video", "Streaming", "Multiview", "360Video", "ClearVR"], "long_description": "Tiledmedia\u2019s ClearVR format is an efficient and scalable solution for streaming 360/180-degree Virtual Reality video to VR headsets and mobile devices, both live and on-demand. It also supports versatile multiview, with a virtually unlimited number of windows, keeping everything in perfect sync. The app includes VR360 content with resolutions up to 8192x8192 pixels (stereoscopic 8K). It also showcases an elaborate \u201cinfinite multiview\u201d example. All content in this application streams from content distribution networks.", "short_description": "Tiledmedia\u2019s demo application delivers extremely high-quality VR360/180 content, supporting resolutions up to 16K, along with versatile immersive multiview capabilities."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.tiledmedia.com/apps-privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Tiledmedia", "support_website_url": null, "website_url": "http://www.tiledmedia.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["MEDIA_PLAYER"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8360054300728347"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/39001663_1197267034104198_3389167720599673818_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LJnnCbzzhIEQ7kNvwH2FuAm&_nc_oc=Adrl90SmOQ65x_Hj4U-UhqT8hh80xAx2r1LojnjLqVb3
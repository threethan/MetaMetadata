enshot 2024-08-29 152439.png", "id": "1083354099876401", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/57575347_1083354109876400_2150945295140510025_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yU_0kz5QrOEQ7kNvwGvctYM&_nc_oc=Adpv600TBdaK4SfLcYREy9B6_U2OThHmcolD9r98R5zZO-XKe7S37PtwJRfex-5e_08&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRE3i-mEMa4vr2vwl1CnlDbZoYbO9fOPkA1mUIIzISVZQ&oe=6AF9BAC0"}, {"file_name": "Screenshot 2024-08-29 153310.png", "id": "1706751140083993", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/75340703_1706751143417326_4955385660501928662_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Xc_1sYUBDIUQ7kNvwF925-B&_nc_oc=Adpk71Ri2k88l-4bRe9D0_SrxtWF_6kyRT6zrMNCUdqFIhocHdS6jm-KxfpH0QBaIl8&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSGq67PKIQO7Qu5v9u9nH3TD9p6UOyERhF3Krjy1ivIsA&oe=6AF9CB13"}, {"file_name": "Screenshot 2024-08-29 153805 (1).png", "id": "1750179509127850", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974667_1750179515794516_926704380804471609_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VmEdT_ADslUQ7kNvwG5dYsC&_nc_oc=Adqsw2H9gHq7Zxtp86K4AAOy3uSIuQTUYSRtK3WnsNhd94BFCDswiKJ-MBurN-nn87A&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTNZ2u1BDIkVarWFkQc5Bs1pF0bqBg2_CHUrzkyAroRkg&oe=6AF9C9F5"}, {"file_name": "Screenshot 2024-08-29 154346.png", "id": "527324349804133", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974888_527324353137466_8256677203317541477_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GjXZR5cxESgQ7kNvwEvBoi-&_nc_oc=AdrGNjnJ-ad90coCTY73JqDxC3BhjTYa2ncXTOMsgm7PLDxfTRa5oypeLf-ryqio2Ps&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSzW2QtGc-_95Or6oib8zpf0tWs6Q5Ki2_e6BHkNdNzWg&oe=6AF9C46A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Tiledmedia Player", "keywords": ["Video", "Streaming", "Multiview", "360Video", "ClearVR"], "long_description": "Tiledmedia\u2019s ClearVR format is an efficient and scalable solution for streaming 360/180-degree Virtual Reality video to VR headsets and mobile devices, both live and on-demand. It also supports versatile multiview, with a virtually unlimited number of windows, keeping everything in perfect sync. The app includes VR360 content with resolutions up to 8192x8192 pixels (stereoscopic 8K). It also showcases an elaborate \u201cinfinite multiview\u201d example. All content in this application streams from content distribution networks.", "short_description": "Tiledmedia\u2019s demo application delivers extremely high-quality VR360/180 content, supporting resolutions up to 16K, along with versatile immersive multiview capabilities."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.tiledmedia.com/apps-privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Tiledmedia", "support_website_url": null, "website_url": "http://www.tiledmedia.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["MEDIA_PLAYER"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8360054300728347"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39001663_1197267034104198_3389167720599673818_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M3-kc07beXEQ7kNvwF2xkFn&_nc_oc=AdoUCZsJLcnUPGzyOUuAwYdb4_M6Lg3aTPO-rqJmuGoe
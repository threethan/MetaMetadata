enshot 2024-08-29 152439.png", "id": "1083354099876401", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/57575347_1083354109876400_2150945295140510025_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6BH1YrWDoWcQ7kNvwFpcCke&_nc_oc=Ado0Bx0U5KVAKm_cESQsYUsK2TP4SKMpFtOmLJEVYZPKCRXFVs742qPsapjj1fWDdmk&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBMY4q4scSI68fNKr7-EvIMKa-iPDYOSGbK2o3FnAlbOA&oe=6A6612C0"}, {"file_name": "Screenshot 2024-08-29 153310.png", "id": "1706751140083993", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/75340703_1706751143417326_4955385660501928662_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=la1h1_KuXH8Q7kNvwG5N4DI&_nc_oc=AdoMbRVFKXK4owFGCAz99dy3QirJa8oEfEMzviLOd8VpOe_XaJt6LD-mV0d_Ei0QqfY&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAS0oIt_rgut013MtjiHkXAY4vpA0m5_DFtiZFtc7ulcA&oe=6A662313"}, {"file_name": "Screenshot 2024-08-29 153805 (1).png", "id": "1750179509127850", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974667_1750179515794516_926704380804471609_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UYt1audJrHQQ7kNvwFhtC0P&_nc_oc=AdpWZ27OmA4rLyIHxS3vK4c_MZiqnFw-_EeAbxfKlpUbmPiv7wqUcG4X-xuO2VE0S7g&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC0_jgRAkRiCe8whk-kZXu6TmG7kOvH5lhKkosTaXO5YA&oe=6A6621F5"}, {"file_name": "Screenshot 2024-08-29 154346.png", "id": "527324349804133", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974888_527324353137466_8256677203317541477_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-wo8KoQ7lKUQ7kNvwGCzu9C&_nc_oc=AdoHbVQlrduwhnkaagfWg_8CAqo1tpFjvz5_F4QORqiPLNg2ZiJK-NgM9NBMfibqilo&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBvTjiKGfo17yMHENCVjC4d7AS3FPqRsKtCmWuqeWhFJw&oe=6A661C6A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Tiledmedia Player", "keywords": ["Video", "Streaming", "Multiview", "360Video", "ClearVR"], "long_description": "Tiledmedia\u2019s ClearVR format is an efficient and scalable solution for streaming 360/180-degree Virtual Reality video to VR headsets and mobile devices, both live and on-demand. It also supports versatile multiview, with a virtually unlimited number of windows, keeping everything in perfect sync. The app includes VR360 content with resolutions up to 8192x8192 pixels (stereoscopic 8K). It also showcases an elaborate \u201cinfinite multiview\u201d example. All content in this application streams from content distribution networks.", "short_description": "Tiledmedia\u2019s demo application delivers extremely high-quality VR360/180 content, supporting resolutions up to 16K, along with versatile immersive multiview capabilities."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.tiledmedia.com/apps-privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Tiledmedia", "support_website_url": null, "website_url": "http://www.tiledmedia.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["MEDIA_PLAYER"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8360054300728347"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39001663_1197267034104198_3389167720599673818_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PXL_OCSPJCoQ7kNvwG-JZiO&_nc_oc=Ado0DVZ-j66F20nV0Mfz-Ofd_AOP8YD_p4NI28yZzzvD
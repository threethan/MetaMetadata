enshot 2024-08-29 152439.png", "id": "1083354099876401", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/57575347_1083354109876400_2150945295140510025_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kEHCAMfRxOgQ7kNvwFDJbvo&_nc_oc=Adp9Go1QsuywXTYzmQaJUNY4RSKq03-yIsZILrcxtP87i-3HCVQ26NJDnBU8m7HV9MM&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG4LMdhKCjHbru2xNCDJD5pI-7EGa7Y9AJoaK3Z5deibA&oe=6A8070C0"}, {"file_name": "Screenshot 2024-08-29 153310.png", "id": "1706751140083993", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/75340703_1706751143417326_4955385660501928662_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mWSQXS1o9hQQ7kNvwHlzWm1&_nc_oc=AdoxMyjK_gRmruZcFqWA2egkg2NIdUUJM4DmeIF8SXCR8UkN9Gm39xMqQkTZqrqP4Mg&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFJ4skl8EQXABRkCRC2ZkIA6tpsZy8aLzqhAYLpQAMSJQ&oe=6A8048D3"}, {"file_name": "Screenshot 2024-08-29 153805 (1).png", "id": "1750179509127850", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38974667_1750179515794516_926704380804471609_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=meWJ9E055XQQ7kNvwEw3AoQ&_nc_oc=AdoGs82VkBHEnWRFsa9lAoEUmuzajEMtRLrNDrpLY26ojCtYH1JJHyhPjpUcSkguCRM&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHcximv9aZwokyoSI4TiwR257YPAPj5dHPd7liUjmY3Fw&oe=6A8047B5"}, {"file_name": "Screenshot 2024-08-29 154346.png", "id": "527324349804133", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38974888_527324353137466_8256677203317541477_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uDtPoPUhQ7IQ7kNvwHZqlEe&_nc_oc=AdoJmeEyHIuSh9R2AUMymKPZmbtUqpXr3qqh0etKP0F11_g6_LR5rBBg9FM1PdaZwpg&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFqrrTzqDZMRH_zeaRptqSf2CrVNVPd9Sut6GSPlbCOEw&oe=6A80422A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Tiledmedia Player", "keywords": ["Video", "Streaming", "Multiview", "360Video", "ClearVR"], "long_description": "Tiledmedia\u2019s ClearVR format is an efficient and scalable solution for streaming 360/180-degree Virtual Reality video to VR headsets and mobile devices, both live and on-demand. It also supports versatile multiview, with a virtually unlimited number of windows, keeping everything in perfect sync. The app includes VR360 content with resolutions up to 8192x8192 pixels (stereoscopic 8K). It also showcases an elaborate \u201cinfinite multiview\u201d example. All content in this application streams from content distribution networks.", "short_description": "Tiledmedia\u2019s demo application delivers extremely high-quality VR360/180 content, supporting resolutions up to 16K, along with versatile immersive multiview capabilities."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.tiledmedia.com/apps-privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Tiledmedia", "support_website_url": null, "website_url": "http://www.tiledmedia.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["MEDIA_PLAYER"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8360054300728347"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/39001663_1197267034104198_3389167720599673818_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=co81jm8hC5MQ7kNvwF3Ok23&_nc_oc=AdqcX5fVqryldhhDeiTDp4fk67snF1qr8gPa8ajqbbJb
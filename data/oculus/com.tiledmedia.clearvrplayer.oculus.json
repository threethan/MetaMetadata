enshot 2024-08-29 152439.png", "id": "1083354099876401", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/57575347_1083354109876400_2150945295140510025_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DY73LNovE90Q7kNvwEc3nTn&_nc_oc=Adqs1gONLi9hP3hn9p3b7IdXiRU8J9HMmHU_gUeitaYc_bjI5Pl6mYMWGGBTR4takl4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_OePYgXbGJDkCXKv2a9gs-I2FyhLsWC-oCvhj5k50WLg&oe=6A2D6240"}, {"file_name": "Screenshot 2024-08-29 153310.png", "id": "1706751140083993", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75340703_1706751143417326_4955385660501928662_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5tXNEV3Vg0kQ7kNvwE9go_I&_nc_oc=AdqKBxkZRcHe-XmNwRJR9pzCHWglLp-h1hBXVx0VCJrW8MOeAwRYYep_vLX0K_acrio&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-uGPJuCS_vwxlzT5Y2Sw8AI_G0QmKVDuTfcW5GNNjGiA&oe=6A2D7293"}, {"file_name": "Screenshot 2024-08-29 153805 (1).png", "id": "1750179509127850", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974667_1750179515794516_926704380804471609_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bgoAm2bylUAQ7kNvwE35F3m&_nc_oc=AdpWxbMvWK1FsBktZ15xRsT9vN3Yzo8w7un_lOLcfGrg6KbbIyhYL3wmYAFiv_lhof0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8lgIIHDJ66Xj8LB3aCxCcIpnua4TlFPArnYQK9txKK_w&oe=6A2D7175"}, {"file_name": "Screenshot 2024-08-29 154346.png", "id": "527324349804133", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974888_527324353137466_8256677203317541477_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mAC2PVMd-kgQ7kNvwESJau5&_nc_oc=Adr3MYQA3KkFNe-ne3I1jzr00STKsjm9wzXdp8gSAK_tWCRUOZNQcfL33qppuAOC8YQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9xJfrQNiCdeUZg_IQ55vKs9aaZjV18BSV7pdLPZKRBCA&oe=6A2D6BEA"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Tiledmedia Player", "keywords": ["Video", "Streaming", "Multiview", "360Video", "ClearVR"], "long_description": "Tiledmedia\u2019s ClearVR format is an efficient and scalable solution for streaming 360/180-degree Virtual Reality video to VR headsets and mobile devices, both live and on-demand. It also supports versatile multiview, with a virtually unlimited number of windows, keeping everything in perfect sync. The app includes VR360 content with resolutions up to 8192x8192 pixels (stereoscopic 8K). It also showcases an elaborate \u201cinfinite multiview\u201d example. All content in this application streams from content distribution networks.", "short_description": "Tiledmedia\u2019s demo application delivers extremely high-quality VR360/180 content, supporting resolutions up to 16K, along with versatile immersive multiview capabilities."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.tiledmedia.com/apps-privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Tiledmedia", "support_website_url": null, "website_url": "http://www.tiledmedia.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["MEDIA_PLAYER"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8360054300728347"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39001663_1197267034104198_3389167720599673818_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UDUDl7uYZ_4Q7kNvwF2JR4t&_nc_oc=AdpYMPLLu4_8HJo5GWYEz822270Jir89ZJKD59qCGai3
enshot 2024-08-29 152439.png", "id": "1083354099876401", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/57575347_1083354109876400_2150945295140510025_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Qcy6Zh6weJMQ7kNvwEzQmBe&_nc_oc=AdqWi3YW9WN4UfGphcWDjLZ9fncfwVpo8wif56MIXkEr52WaWDIHxxeBhT7qUdDt7lo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ0wyPvJw_oVzUdGsJo5h5geR_lkVDV4tOB9ch-57QLxg&oe=6AA7FDC0"}, {"file_name": "Screenshot 2024-08-29 153310.png", "id": "1706751140083993", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75340703_1706751143417326_4955385660501928662_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=li-ESY9v0x4Q7kNvwGc4SJp&_nc_oc=AdrDPC827UBYTEdcaQWFvp8b9VCbXwlzCatvuPy_V2jeQY1LFVnaNrC1lhmeosnjdEw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLWmhYkqqwiOIKUYs87XO12VkGmrTHjUTTNKiaHddDdTA&oe=6AA80E13"}, {"file_name": "Screenshot 2024-08-29 153805 (1).png", "id": "1750179509127850", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974667_1750179515794516_926704380804471609_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PRppyjJHSA0Q7kNvwFhyWGY&_nc_oc=AdrRVGyp89eazKAV2Xa6QhkfoCZ_NNRcvvbzwqEFnndQFdY0caPCNyv0dqlsYss3eDE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK_64LBgeN55qFWQax9bu26nOFNcix11-b7fF5Q9eMaOQ&oe=6AA80CF5"}, {"file_name": "Screenshot 2024-08-29 154346.png", "id": "527324349804133", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974888_527324353137466_8256677203317541477_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h9fL6o1s6xIQ7kNvwGTSQC2&_nc_oc=AdqR6hiHAO_-eV1CoaJilVgUHW7_uiplF--ZNu3oxVwqKXsfeNd2N74tOrti5i99qeU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIq5fGdNTM6bDOYXg6jYsNJuthS7QbDZUeVlShp158s0A&oe=6AA8076A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Tiledmedia Player", "keywords": ["Video", "Streaming", "Multiview", "360Video", "ClearVR"], "long_description": "Tiledmedia\u2019s ClearVR format is an efficient and scalable solution for streaming 360/180-degree Virtual Reality video to VR headsets and mobile devices, both live and on-demand. It also supports versatile multiview, with a virtually unlimited number of windows, keeping everything in perfect sync. The app includes VR360 content with resolutions up to 8192x8192 pixels (stereoscopic 8K). It also showcases an elaborate \u201cinfinite multiview\u201d example. All content in this application streams from content distribution networks.", "short_description": "Tiledmedia\u2019s demo application delivers extremely high-quality VR360/180 content, supporting resolutions up to 16K, along with versatile immersive multiview capabilities."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.tiledmedia.com/apps-privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Tiledmedia", "support_website_url": null, "website_url": "http://www.tiledmedia.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["MEDIA_PLAYER"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8360054300728347"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39001663_1197267034104198_3389167720599673818_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CmSM5iRQnQ4Q7kNvwGg89Kf&_nc_oc=AdrJK3LqB2QHjpVSwJL3pHM8JupZi3m8ooKAdnqtEdDU
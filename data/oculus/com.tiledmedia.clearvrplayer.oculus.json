enshot 2024-08-29 152439.png", "id": "1083354099876401", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/57575347_1083354109876400_2150945295140510025_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=__iih_F63LIQ7kNvwFEYZrw&_nc_oc=Adq5tJeNiIGCUK-vEuF60KGmcYigRQyTqwmFhOoXP5EEUfdO9HpnjNb9DYinWegRA1A&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHN6i9baerbMdUIUxJNmNpd8w1nYSFekFHKecAjB3D4Xg&oe=6A71F040"}, {"file_name": "Screenshot 2024-08-29 153310.png", "id": "1706751140083993", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/75340703_1706751143417326_4955385660501928662_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W5rsfJd1srUQ7kNvwFmwyKs&_nc_oc=AdqZvVNPX8BHquHmthiu4hLPwK3cL-hMw7XUBFTPpZnxUIr-ZPCWu_LmkQ-m4cWMY8I&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEtTPWOMG-_sBSlqD9-xrJMAaVsKGPtV6Qf_Kl6cfWbOg&oe=6A720093"}, {"file_name": "Screenshot 2024-08-29 153805 (1).png", "id": "1750179509127850", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974667_1750179515794516_926704380804471609_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3BkcA3WWLeIQ7kNvwHQhqlQ&_nc_oc=Adpcrmt_dDS9-L-udXE7qE2LPnZ-S-55WBJ8UqRXcI2uJmE1EPNNgZ96HdnUNpzzToE&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFVRCMA16Z0BbaWUx2pUBcdg4Uc-jeC-moxyDmwdauwAQ&oe=6A71FF75"}, {"file_name": "Screenshot 2024-08-29 154346.png", "id": "527324349804133", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974888_527324353137466_8256677203317541477_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=StMPvDjo0KIQ7kNvwFb9BQU&_nc_oc=AdqzfjnSAROShklq16haWBz78A3hkmZ3VvR37o9lenU8aEcuJU1JoApCRSx6SJp6auE&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFUwAVizeK_3FqmknRhNskGb1bqN5AIxHOuVUhzBMRluw&oe=6A71F9EA"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Tiledmedia Player", "keywords": ["Video", "Streaming", "Multiview", "360Video", "ClearVR"], "long_description": "Tiledmedia\u2019s ClearVR format is an efficient and scalable solution for streaming 360/180-degree Virtual Reality video to VR headsets and mobile devices, both live and on-demand. It also supports versatile multiview, with a virtually unlimited number of windows, keeping everything in perfect sync. The app includes VR360 content with resolutions up to 8192x8192 pixels (stereoscopic 8K). It also showcases an elaborate \u201cinfinite multiview\u201d example. All content in this application streams from content distribution networks.", "short_description": "Tiledmedia\u2019s demo application delivers extremely high-quality VR360/180 content, supporting resolutions up to 16K, along with versatile immersive multiview capabilities."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.tiledmedia.com/apps-privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Tiledmedia", "support_website_url": null, "website_url": "http://www.tiledmedia.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["MEDIA_PLAYER"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8360054300728347"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39001663_1197267034104198_3389167720599673818_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I1jiEjeKuqUQ7kNvwG04ERB&_nc_oc=Adr7lDKqeSSliBFUbtD8FkE3EPvmCRFVUg_PXKOq-OxZ
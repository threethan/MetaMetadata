enshot 2024-08-29 152439.png", "id": "1083354099876401", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/57575347_1083354109876400_2150945295140510025_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Eo1zSFF6c_wQ7kNvwG5xNwT&_nc_oc=AdpvfRd5ZtRqpAgK9tuULTP8F0yo0UDvc93tfO9hHY2-V4h1xjKnVWrnTrHse9OD2-k&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4PrhjO512KreVryB6xbESbVWlwnranxiYTqyLIz4LRgA&oe=6A106140"}, {"file_name": "Screenshot 2024-08-29 153310.png", "id": "1706751140083993", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/75340703_1706751143417326_4955385660501928662_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xeQ4F_94nn4Q7kNvwGywsOt&_nc_oc=AdqSD84sXtlrU1XaNqcvDdOGZSukvWVcq6oqD8Dssa8bOiwMQMpVGDHgbf0PcPzx2eQ&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7chn-DIDQE3Q5hb0n3KPLbXTIg1fXcnnYQO8x2C4dXCw&oe=6A107193"}, {"file_name": "Screenshot 2024-08-29 153805 (1).png", "id": "1750179509127850", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/38974667_1750179515794516_926704380804471609_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yiO5yZrryLwQ7kNvwEqI_fV&_nc_oc=Adqj66m7LRwDNsX1jpHv4phogTkGA66WeLXYLLMngdY9JDf1FCkJZyIJJCOkzy_UtgY&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4ho9OfhtQLclOPr3C_gacdhS27Bt3twY2vnabAEgIgdA&oe=6A107075"}, {"file_name": "Screenshot 2024-08-29 154346.png", "id": "527324349804133", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/38974888_527324353137466_8256677203317541477_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b4px4nDWEv8Q7kNvwFKNhLo&_nc_oc=AdpYG5jkYsm6hJxbrU3oBsXIeqYsolnURu5ahAh3ekPvDpWJZaL6Ieq3NftfRCQaFto&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7uFc9NXzzXPvkZJeNkpwEiLY8PEiIli4k-ZMFfW1QlOw&oe=6A106AEA"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Tiledmedia Player", "keywords": ["Video", "Streaming", "Multiview", "360Video", "ClearVR"], "long_description": "Tiledmedia\u2019s ClearVR format is an efficient and scalable solution for streaming 360/180-degree Virtual Reality video to VR headsets and mobile devices, both live and on-demand. It also supports versatile multiview, with a virtually unlimited number of windows, keeping everything in perfect sync. The app includes VR360 content with resolutions up to 8192x8192 pixels (stereoscopic 8K). It also showcases an elaborate \u201cinfinite multiview\u201d example. All content in this application streams from content distribution networks.", "short_description": "Tiledmedia\u2019s demo application delivers extremely high-quality VR360/180 content, supporting resolutions up to 16K, along with versatile immersive multiview capabilities."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.tiledmedia.com/apps-privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Tiledmedia", "support_website_url": null, "website_url": "http://www.tiledmedia.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["MEDIA_PLAYER"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8360054300728347"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/39001663_1197267034104198_3389167720599673818_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RrkmpM6DIkcQ7kNvwHu5PFr&_nc_oc=Ado5iKXJNr_qMXwExg4mEuCVEqETXZVNWoJetXhwCTJJ
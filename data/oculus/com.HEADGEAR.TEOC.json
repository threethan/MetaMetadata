cdn.com/v/t64.5771-25/75361355_380339049810894_8629917805136921546_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iE_S9GU1R9oQ7kNvwH1TvD6&_nc_oc=AdqdEDH88FyoBrtb3vSwAqfoA0O11lNAN1TzXVFDpAsv-ooW7Bj90W3oSRD9kiVSQPA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_jBXXikPHSBi71tREUPdrwBky9ALmwlJDtC2w0nSjXYQ&oe=6A3FEAA3"}, {"file_name": "HighresScreenshot00081.png", "id": "376313343811121", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031312_376313347144454_2073303015962398022_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gz80pUA-DQMQ7kNvwG29Vu6&_nc_oc=AdqiaRXb8ZhYS4uqkkyMgPLOMHPTwSe7hoBKzM6tRD8bFRUq31vIPSIRyJZIwE6tKPg&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8xE08OjGIgaY1o4x7-nWzOPHKnEikkT-spaAVoxk4XRQ&oe=6A3FE5B7"}, {"file_name": "HighresScreenshot00034.png", "id": "361423311640761", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75297579_361423314974094_4468664441597916853_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4hFLpgf8RdoQ7kNvwGa2ALd&_nc_oc=AdpEV7_c2oCpTPeFO09kPIXuZqWKXXz6ey5qoem3gmREAGdSqN8cEBw7qHo3UiD7wsY&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-wh70OZiRO8ybh39vPBjgu3aNPnV4kE0HXKpmMW3w-KA&oe=6A3FE420"}, {"file_name": "consume.png", "id": "356221875528110", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39001669_356221878861443_261896368707707264_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nsVvitTNvE8Q7kNvwEIcZ3c&_nc_oc=AdqvZcl7TmYEC4o840Bk2pVc2_mlU0T9Z1VTvBcELrIKn6X-rA_rMqV3iwT_M3bpNfI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-F-UsTrgRtCEnvY42nz7AbekK02U0yXyjpZyxb8Wrcng&oe=6A3FD083"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "38982553_2716489995261681_7852865887418274915_n[1].png", "id": "1017968672039348", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974845_1017968675372681_3537640423345626257_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zFmSolVafuEQ7kNvwHysayZ&_nc_oc=AdoGVhlb6HgvdjmpaLaidKgcsDYLrqz5f2HIfD8ziI0Rs5EErajx2pzcjg7z3PeV1q4&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_bRsv48em4niGRRYoP5RPTgEu4SKs96Pq4yCFMi1mDOg&oe=6A3FE9C6"}, "display_name": "TEOC", "keywords": ["arcade", "puzzle", "casual", "atmospheric", "puzzler"], "long_description": "Evolve from an atomic state to marine-life in this spatial arcade puzzler with just one goal: Consume or be Consumed! \n\nPowered by elemental forces and mythical artifacts navigate your way through 3 environments with 30+ rounds each to get through. Will you be able to top the leaderboard for each of these? \n\nTEOC provides\u2026\n\u2022 more than 5 hours of mesmerizing gameplay,\n\u2022 a beautiful minimalist style with ambient adaptive soundtracks,\n\u2022 10+ game mechanics to master,\n\u2022 additional powerups to collect and use across all 90+ rounds\n\u2022 with daily powerup rewards for coming back\n\u2022 to compete on the 3 leaderboards,\n\u2022 increasingly challenging level design all procedurally generated\n\u2022 and seated or standing play options!\n\n\n", "short_description": "Evolve from an atomic state to marine-life in this spatial arcade puzzler with just one goal: Consume or be Consumed! \n\nPowered by elemental forces and mythical artifacts navigate your way through 3 environments with 30+ rounds each to get through. Will you be able to top the leaderboard for each of these? With >5 hours of mesmerizing gameplay, 10+ game mechanics to master and all set in a beautiful minimalist style with ambient adaptive soundtracks, you can enjoy it seated or standing up!\n"}]}, "developer_name": "HEADGEAR GbR", "developer_privacy_policy_url": "https://headgear.io/legal.html", "developer_terms_of_service_url": "https://headgear.io/legal.html#terms", "publisher_name": "HEADGEAR GbR", "support_website_url": null, "website_url": "https://headgear.io/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_categ
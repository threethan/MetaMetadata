cdn.com/v/t64.5771-25/75361355_380339049810894_8629917805136921546_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MbC6XHfFuhsQ7kNvwEGez_X&_nc_oc=AdpnSZUpq8Rdg4zQhsefuHeN5psZfV7Ch4y5JQCH218Ct005Xibll7OtqTdL1oacVHQ&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ_Xg5wThI7PcFqQntwczpAtPi4TVh2ZmwN9z4q9LyTOg&oe=6AA179A3"}, {"file_name": "HighresScreenshot00081.png", "id": "376313343811121", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/39031312_376313347144454_2073303015962398022_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VLSS8UyKz9AQ7kNvwEx5E8z&_nc_oc=AdpmRi7kx1NiDDQ4SJMXRofpoDvEh8ZVjY78uVe8mfWqP7mfkPeIB9lhVBnqgC0ZHHs&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQICsUgQibIBsYPBaTCR7bFR0dOL0MGwHd8Q29qECoyscQ&oe=6AA174B7"}, {"file_name": "HighresScreenshot00034.png", "id": "361423311640761", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/75297579_361423314974094_4468664441597916853_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mSoLuDRHOzAQ7kNvwG2pxmr&_nc_oc=Ado8nDSl_qHO-icmEfqP_nQ-fZOpmkAr1mXEKeHl2tEpSOPeBk5PB0y6YXaF0LIiLNk&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQInNIZ2WUl8aKB9mCYA3au3sv1Ohvsp53ovGqCrjxAHgQ&oe=6AA17320"}, {"file_name": "consume.png", "id": "356221875528110", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/39001669_356221878861443_261896368707707264_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=igpAy5Ly8ogQ7kNvwGez4q_&_nc_oc=AdprJH56cTTHyqfxpdSaAFRTs_o68XyuZfuwU4Ks2TSrSBKXWmflgZy0wUb-0doZUd4&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJUwxf4CNDYuVP4_bRVWlo5_mStmbzGwJ53PT_u_5xAkA&oe=6AA15F83"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "38982553_2716489995261681_7852865887418274915_n[1].png", "id": "1017968672039348", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38974845_1017968675372681_3537640423345626257_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EVQpPAn2w-cQ7kNvwFHCL3G&_nc_oc=AdrJfzzd0f4TUMfyeLDaQ4IsXhPH8OGPxtN7zym3g86cN5DQ4wlTGilTWd78mhdf1zQ&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIGF1WvNJV5SsTZ43VjfoHFv6MEFDEeBcAC4f8YG89VLw&oe=6AA178C6"}, "display_name": "TEOC", "keywords": ["arcade", "puzzle", "casual", "atmospheric", "puzzler"], "long_description": "Evolve from an atomic state to marine-life in this spatial arcade puzzler with just one goal: Consume or be Consumed! \n\nPowered by elemental forces and mythical artifacts navigate your way through 3 environments with 30+ rounds each to get through. Will you be able to top the leaderboard for each of these? \n\nTEOC provides\u2026\n\u2022 more than 5 hours of mesmerizing gameplay,\n\u2022 a beautiful minimalist style with ambient adaptive soundtracks,\n\u2022 10+ game mechanics to master,\n\u2022 additional powerups to collect and use across all 90+ rounds\n\u2022 with daily powerup rewards for coming back\n\u2022 to compete on the 3 leaderboards,\n\u2022 increasingly challenging level design all procedurally generated\n\u2022 and seated or standing play options!\n\n\n", "short_description": "Evolve from an atomic state to marine-life in this spatial arcade puzzler with just one goal: Consume or be Consumed! \n\nPowered by elemental forces and mythical artifacts navigate your way through 3 environments with 30+ rounds each to get through. Will you be able to top the leaderboard for each of these? With >5 hours of mesmerizing gameplay, 10+ game mechanics to master and all set in a beautiful minimalist style with ambient adaptive soundtracks, you can enjoy it seated or standing up!\n"}]}, "developer_name": "HEADGEAR GbR", "developer_privacy_policy_url": "https://headgear.io/legal.html", "developer_terms_of_service_url": "https://headgear.io/legal.html#terms", "publisher_name": "HEADGEAR GbR", "support_website_url": null, "website_url": "https://headgear.io/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_categ
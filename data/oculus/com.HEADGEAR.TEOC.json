cdn.com/v/t64.5771-25/75361355_380339049810894_8629917805136921546_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2yLr3E1QOpUQ7kNvwE17eQF&_nc_oc=Adq4t9te3yRdirlPLY8pdUKIZpQedkR47GltXYnkjFkWJ_KwB8LNDqd6ssaPzcsPBJQ&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMPS9vM7bSLAmzXON1RVT9pxa8O68CDo-wGvVx9YaqeIQ&oe=6AC7B523"}, {"file_name": "HighresScreenshot00081.png", "id": "376313343811121", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/39031312_376313347144454_2073303015962398022_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i6PFQfNeLDMQ7kNvwGqrduW&_nc_oc=AdrpQH-1uIP9YKIGhBTxH41iO82uW9xVDlWhF_w1FkHQjdSiXa8vuKCGK_be8Pfo5Uo&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNjm-PTQ3C0kU5MaTomuUHU-ID0PmnIRd5a-XRBFvoWbQ&oe=6AC7B037"}, {"file_name": "HighresScreenshot00034.png", "id": "361423311640761", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/75297579_361423314974094_4468664441597916853_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3OQombmZ8lwQ7kNvwFJzDDP&_nc_oc=Adqhub11hjb-V4l3NTaYrqh9Df38Y1yhRT7YL8kY1vWLyGzfAxAawpx-gvTpuMnGD5Q&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNaO4gU6QHqu3Lkh0Hqrlqqg7fmNGIKuJnh6PIBTa0Oag&oe=6AC7AEA0"}, {"file_name": "consume.png", "id": "356221875528110", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/39001669_356221878861443_261896368707707264_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m_vNpXMmVcsQ7kNvwGrbKFA&_nc_oc=AdolZpOn9Eww8EvHo8QkaiV1schqnajYAKyUbi46BbNJOJZZvpxKTk6Y_cXQi17UVeE&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNP6vAM1oLxFN4LG5EkYQ_HjDRgKZgPw-qwtKohqRGaQg&oe=6AC79B03"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "38982553_2716489995261681_7852865887418274915_n[1].png", "id": "1017968672039348", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38974845_1017968675372681_3537640423345626257_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6Oj8ZPsnXYsQ7kNvwG0-H-n&_nc_oc=Adr2Gf0zivs-PfjMcIlRRC69GR5eueiwvNK4cAIg8KJZShL4d_CpE7bPvC18YqleSmw&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOFU3JOc-aD6NPD_pNnUqaBbHvLCkB7FPhBfz9xJhNIBQ&oe=6AC7B446"}, "display_name": "TEOC", "keywords": ["arcade", "puzzle", "casual", "atmospheric", "puzzler"], "long_description": "Evolve from an atomic state to marine-life in this spatial arcade puzzler with just one goal: Consume or be Consumed! \n\nPowered by elemental forces and mythical artifacts navigate your way through 3 environments with 30+ rounds each to get through. Will you be able to top the leaderboard for each of these? \n\nTEOC provides\u2026\n\u2022 more than 5 hours of mesmerizing gameplay,\n\u2022 a beautiful minimalist style with ambient adaptive soundtracks,\n\u2022 10+ game mechanics to master,\n\u2022 additional powerups to collect and use across all 90+ rounds\n\u2022 with daily powerup rewards for coming back\n\u2022 to compete on the 3 leaderboards,\n\u2022 increasingly challenging level design all procedurally generated\n\u2022 and seated or standing play options!\n\n\n", "short_description": "Evolve from an atomic state to marine-life in this spatial arcade puzzler with just one goal: Consume or be Consumed! \n\nPowered by elemental forces and mythical artifacts navigate your way through 3 environments with 30+ rounds each to get through. Will you be able to top the leaderboard for each of these? With >5 hours of mesmerizing gameplay, 10+ game mechanics to master and all set in a beautiful minimalist style with ambient adaptive soundtracks, you can enjoy it seated or standing up!\n"}]}, "developer_name": "HEADGEAR GbR", "developer_privacy_policy_url": "https://headgear.io/legal.html", "developer_terms_of_service_url": "https://headgear.io/legal.html#terms", "publisher_name": "HEADGEAR GbR", "support_website_url": null, "website_url": "https://headgear.io/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_categ
cdn.com/v/t64.5771-25/75361355_380339049810894_8629917805136921546_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JNdUiti02G8Q7kNvwE0dvnq&_nc_oc=AdpQrHGAvN5Fw7G99OkL2pmdPslNfpFYOqd_aLeJbb60HhLbcsisw1L6F1vzdX8H5KU&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPXV2cWgAp5cOW_5dRMV5wJf3kS_wJXVezUTTCECRsdGQ&oe=6AC51223"}, {"file_name": "HighresScreenshot00081.png", "id": "376313343811121", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/39031312_376313347144454_2073303015962398022_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i6PFQfNeLDMQ7kNvwE9NISG&_nc_oc=Adpzu0au6BvYhshcjybLyScWYXi2A05vbMeBmYgpdJCkYSMBwKVZRMKn6msIko8zhXw&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP214Sjpsb3-4TSH58T7SHaQq3r0024TpkZRo8w0DEamQ&oe=6AC50D37"}, {"file_name": "HighresScreenshot00034.png", "id": "361423311640761", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/75297579_361423314974094_4468664441597916853_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3OQombmZ8lwQ7kNvwGrexAN&_nc_oc=Ado-K2pyhpmRGNblumagLM6B3xHSMI1iVe9Q9TDstmzHXfgqYqdEuhkMQpiuYryeSxI&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPokcEF6z1Z0FVwPIn1WVt_yIgkKsPe7PtcCMPihWSBgg&oe=6AC50BA0"}, {"file_name": "consume.png", "id": "356221875528110", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/39001669_356221878861443_261896368707707264_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YhVANsZ7bRIQ7kNvwHPjJ88&_nc_oc=AdpWC045c0xlh4GR9ip4lPAtwpDe5QgZM33pMcnjlnVXr4s77-8n9SPmtjnjpcsP66s&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNw1UW5dvXn9Al8yZOrQGEDKkixYaBuOkjf9I0kNTOL5A&oe=6AC4F803"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "38982553_2716489995261681_7852865887418274915_n[1].png", "id": "1017968672039348", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38974845_1017968675372681_3537640423345626257_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6Oj8ZPsnXYsQ7kNvwFN57fz&_nc_oc=Adr6U2pQmencfdyksJkdorPC145_6-_YmT9GHRVBH4RD_YT8a_h7gCvn8n86wAy6Jag&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPzP9kDr9NzrJ0mDi4MoTSzTHEtbdj00U_KrFRtWqmAvQ&oe=6AC51146"}, "display_name": "TEOC", "keywords": ["arcade", "puzzle", "casual", "atmospheric", "puzzler"], "long_description": "Evolve from an atomic state to marine-life in this spatial arcade puzzler with just one goal: Consume or be Consumed! \n\nPowered by elemental forces and mythical artifacts navigate your way through 3 environments with 30+ rounds each to get through. Will you be able to top the leaderboard for each of these? \n\nTEOC provides\u2026\n\u2022 more than 5 hours of mesmerizing gameplay,\n\u2022 a beautiful minimalist style with ambient adaptive soundtracks,\n\u2022 10+ game mechanics to master,\n\u2022 additional powerups to collect and use across all 90+ rounds\n\u2022 with daily powerup rewards for coming back\n\u2022 to compete on the 3 leaderboards,\n\u2022 increasingly challenging level design all procedurally generated\n\u2022 and seated or standing play options!\n\n\n", "short_description": "Evolve from an atomic state to marine-life in this spatial arcade puzzler with just one goal: Consume or be Consumed! \n\nPowered by elemental forces and mythical artifacts navigate your way through 3 environments with 30+ rounds each to get through. Will you be able to top the leaderboard for each of these? With >5 hours of mesmerizing gameplay, 10+ game mechanics to master and all set in a beautiful minimalist style with ambient adaptive soundtracks, you can enjoy it seated or standing up!\n"}]}, "developer_name": "HEADGEAR GbR", "developer_privacy_policy_url": "https://headgear.io/legal.html", "developer_terms_of_service_url": "https://headgear.io/legal.html#terms", "publisher_name": "HEADGEAR GbR", "support_website_url": null, "website_url": "https://headgear.io/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_categ
cdn.com/v/t64.5771-25/75361355_380339049810894_8629917805136921546_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AD69Ert8sJQQ7kNvwEtv8_I&_nc_oc=AdoM323vauUgZ7r4e5ocLaC3r-YvRKTtIonlfO1pZucTQZIHUHrAPJ_lYjQrj2_9pSc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDaC69Ia2zliIhdPXe7hNjrLw3b3dEc7frCmdq50MuT3w&oe=6A4A76A3"}, {"file_name": "HighresScreenshot00081.png", "id": "376313343811121", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031312_376313347144454_2073303015962398022_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jPM1dmyPpk4Q7kNvwG0dUFl&_nc_oc=Adr9DjmxnO-WCwVZI7_yGKilMk52CxxfI2N3Aq_9NwhHz1mQqalAH0qb_cMMw9T24eQ&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCeXh7DeJvPIMgqlWMqIKq30qYxzi7SiJthtCRFq6vVrQ&oe=6A4A71B7"}, {"file_name": "HighresScreenshot00034.png", "id": "361423311640761", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75297579_361423314974094_4468664441597916853_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GQtvpv_B98MQ7kNvwFFpVNC&_nc_oc=AdpE3G2Ssczj8xW73jjs7xpOeey_ejpoLKkDY0t22MeF3IvPuvJusIOPhZXvA0Nml5w&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCoEMFs6yX5EnzEcP_-uWbyQPIJYQ4h6mlKPR8jsiSToQ&oe=6A4A7020"}, {"file_name": "consume.png", "id": "356221875528110", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39001669_356221878861443_261896368707707264_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Lw20j_uj5OgQ7kNvwFrWlOY&_nc_oc=AdrVbGmdcirJIqs0v007nD-IApIdH2AZEfOrrR5btbh_eGttmTITjcJfbEhdZtKfN88&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC8dJS2LsssXJFWeThbNFSdm5HZcU04a-PCEab01yX0Lw&oe=6A4A5C83"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "38982553_2716489995261681_7852865887418274915_n[1].png", "id": "1017968672039348", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974845_1017968675372681_3537640423345626257_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-9ZQoVubPo0Q7kNvwF_u_ml&_nc_oc=Adq23VTZbCCefA8ks7sZbypLM7K40_bq50HijMw4ENZaGyqT6XktHXEZQv9zjG4dlmU&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCIVrR7oeeBh7lPCrBB8AQZcnE4MTBXu_ZVoTf2M8zgjg&oe=6A4A75C6"}, "display_name": "TEOC", "keywords": ["arcade", "puzzle", "casual", "atmospheric", "puzzler"], "long_description": "Evolve from an atomic state to marine-life in this spatial arcade puzzler with just one goal: Consume or be Consumed! \n\nPowered by elemental forces and mythical artifacts navigate your way through 3 environments with 30+ rounds each to get through. Will you be able to top the leaderboard for each of these? \n\nTEOC provides\u2026\n\u2022 more than 5 hours of mesmerizing gameplay,\n\u2022 a beautiful minimalist style with ambient adaptive soundtracks,\n\u2022 10+ game mechanics to master,\n\u2022 additional powerups to collect and use across all 90+ rounds\n\u2022 with daily powerup rewards for coming back\n\u2022 to compete on the 3 leaderboards,\n\u2022 increasingly challenging level design all procedurally generated\n\u2022 and seated or standing play options!\n\n\n", "short_description": "Evolve from an atomic state to marine-life in this spatial arcade puzzler with just one goal: Consume or be Consumed! \n\nPowered by elemental forces and mythical artifacts navigate your way through 3 environments with 30+ rounds each to get through. Will you be able to top the leaderboard for each of these? With >5 hours of mesmerizing gameplay, 10+ game mechanics to master and all set in a beautiful minimalist style with ambient adaptive soundtracks, you can enjoy it seated or standing up!\n"}]}, "developer_name": "HEADGEAR GbR", "developer_privacy_policy_url": "https://headgear.io/legal.html", "developer_terms_of_service_url": "https://headgear.io/legal.html#terms", "publisher_name": "HEADGEAR GbR", "support_website_url": null, "website_url": "https://headgear.io/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_categ
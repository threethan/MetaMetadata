cdn.com/v/t64.5771-25/75361355_380339049810894_8629917805136921546_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZgfpiqaO3g8Q7kNvwFC_Apv&_nc_oc=AdrJLAZr-cTwilPaVIGicE61qMRHYDponzzAqD4nukiBG5aU3dDgGelVx18JHAOO740&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMtjCtWrHLwyupMMIVibKPxOCVlxbqUNuTVOp_-I2xqvg&oe=6ABFCC23"}, {"file_name": "HighresScreenshot00081.png", "id": "376313343811121", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031312_376313347144454_2073303015962398022_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mF7nPS6vvdoQ7kNvwHFEOTg&_nc_oc=Adru0dsN2Uugp2RHZlqPOw8H9m8j2vHstkoNCcKjXY8rHlGQGMDee98YmpvZK-A9NXU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMRmn_Efnp8Qp9ToSX-Ih1jxGRgzMz0URo2d48zW61xhg&oe=6ABFC737"}, {"file_name": "HighresScreenshot00034.png", "id": "361423311640761", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75297579_361423314974094_4468664441597916853_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q4mNCC3fywwQ7kNvwEo_2-a&_nc_oc=Adq0NPc-ZzDlCSjE4rBSbow2jxgh8tq81htiWnuACnphrsY9aqgf_kbl6YWek3HWHfk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN30VT8LOEe6rWeAPQnaLx9itY16YN2wGQhTtIck2PyGw&oe=6ABFC5A0"}, {"file_name": "consume.png", "id": "356221875528110", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39001669_356221878861443_261896368707707264_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GVkJK4-c9vcQ7kNvwHa4gf0&_nc_oc=AdrRFK5tFcxYeJOcO1B6e0JUUr3svPdB-hNcYn6hBQMatErbVHePK5CR2uRB1YHD63A&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOpKDXIv60yEyLP8S_5xdltWK2ifqIyo5xlTbX0YbGLxg&oe=6ABFB203"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "38982553_2716489995261681_7852865887418274915_n[1].png", "id": "1017968672039348", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974845_1017968675372681_3537640423345626257_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=51Z6xqv-YAYQ7kNvwFiuO8v&_nc_oc=AdqCTcA9y0Z5vrtF49E5KFPBeQcA7fIm7Rxf8_AMRwkFuVJX4eGpO0bo2kGU6B80ZkY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMesBZjJqkhyTQDBL0HVZYvd3b4OadtIzXJVEKhzGN_ag&oe=6ABFCB46"}, "display_name": "TEOC", "keywords": ["arcade", "puzzle", "casual", "atmospheric", "puzzler"], "long_description": "Evolve from an atomic state to marine-life in this spatial arcade puzzler with just one goal: Consume or be Consumed! \n\nPowered by elemental forces and mythical artifacts navigate your way through 3 environments with 30+ rounds each to get through. Will you be able to top the leaderboard for each of these? \n\nTEOC provides\u2026\n\u2022 more than 5 hours of mesmerizing gameplay,\n\u2022 a beautiful minimalist style with ambient adaptive soundtracks,\n\u2022 10+ game mechanics to master,\n\u2022 additional powerups to collect and use across all 90+ rounds\n\u2022 with daily powerup rewards for coming back\n\u2022 to compete on the 3 leaderboards,\n\u2022 increasingly challenging level design all procedurally generated\n\u2022 and seated or standing play options!\n\n\n", "short_description": "Evolve from an atomic state to marine-life in this spatial arcade puzzler with just one goal: Consume or be Consumed! \n\nPowered by elemental forces and mythical artifacts navigate your way through 3 environments with 30+ rounds each to get through. Will you be able to top the leaderboard for each of these? With >5 hours of mesmerizing gameplay, 10+ game mechanics to master and all set in a beautiful minimalist style with ambient adaptive soundtracks, you can enjoy it seated or standing up!\n"}]}, "developer_name": "HEADGEAR GbR", "developer_privacy_policy_url": "https://headgear.io/legal.html", "developer_terms_of_service_url": "https://headgear.io/legal.html#terms", "publisher_name": "HEADGEAR GbR", "support_website_url": null, "website_url": "https://headgear.io/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_categ
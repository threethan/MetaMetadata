cdn.com/v/t64.5771-25/75361355_380339049810894_8629917805136921546_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pZ9HLakBpZsQ7kNvwE7uqzt&_nc_oc=AdqJBkxvaTUqmpxg3jvCsoWkNCRY-1B3FbjuoJ4S7MUnkDT2AXUI9wSPJwnV2YfqNwo&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMNikc2t0QJxCa1nawc7kr3K1lq6uQgBQIS6i3RQBX7mg&oe=6AE364A3"}, {"file_name": "HighresScreenshot00081.png", "id": "376313343811121", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/39031312_376313347144454_2073303015962398022_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kXqDYqN_tdQQ7kNvwHdMCRl&_nc_oc=Adrp1ngcutCmvGduius2CTTl_bqRdo6rvkOqtfl-uAHJ0MCwdCsQHWPo0S83DpLbVHA&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNlCfGA4mnWsh6527gyQK_1IFdjqRS02tVqH72QV2cLMQ&oe=6AE35FB7"}, {"file_name": "HighresScreenshot00034.png", "id": "361423311640761", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/75297579_361423314974094_4468664441597916853_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=De5q1SGcQSQQ7kNvwGIWq30&_nc_oc=Adod-7g2dViHsCgyn48Mm9NHwseFl73IHoKWkTSbIqU63G9yNWQuWVm2LQPtjeR0MPg&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPX5_OvnkoH0vIvJ6kexkEMVYzAoqr6IiD_chAnkNKI7g&oe=6AE35E20"}, {"file_name": "consume.png", "id": "356221875528110", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/39001669_356221878861443_261896368707707264_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=87-J7vK-6MkQ7kNvwEp91IC&_nc_oc=AdoOIEumVcwo9QYl4i_PPMXg2l2TfFH87DrMMzatGNcKTTSwH3mT9jNUpuvK9zhVQTY&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNV_orZJwz0uluXFkzwSGBDTzNaO4ibUKbAjEEqn2IMYw&oe=6AE34A83"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "38982553_2716489995261681_7852865887418274915_n[1].png", "id": "1017968672039348", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/38974845_1017968675372681_3537640423345626257_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xcqtgyiAcpMQ7kNvwHxCqJ2&_nc_oc=AdqNz78aiaAES3kYU3KxIi2CzsNF4JxgqNT0WVMgAmMWz-0jrLUb9FYlX6aqJ6SR14M&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPuSHpySDVK7Liw3JzInjWsMUjjyTM3llTTFtAXoGKvGQ&oe=6AE363C6"}, "display_name": "TEOC", "keywords": ["arcade", "puzzle", "casual", "atmospheric", "puzzler"], "long_description": "Evolve from an atomic state to marine-life in this spatial arcade puzzler with just one goal: Consume or be Consumed! \n\nPowered by elemental forces and mythical artifacts navigate your way through 3 environments with 30+ rounds each to get through. Will you be able to top the leaderboard for each of these? \n\nTEOC provides\u2026\n\u2022 more than 5 hours of mesmerizing gameplay,\n\u2022 a beautiful minimalist style with ambient adaptive soundtracks,\n\u2022 10+ game mechanics to master,\n\u2022 additional powerups to collect and use across all 90+ rounds\n\u2022 with daily powerup rewards for coming back\n\u2022 to compete on the 3 leaderboards,\n\u2022 increasingly challenging level design all procedurally generated\n\u2022 and seated or standing play options!\n\n\n", "short_description": "Evolve from an atomic state to marine-life in this spatial arcade puzzler with just one goal: Consume or be Consumed! \n\nPowered by elemental forces and mythical artifacts navigate your way through 3 environments with 30+ rounds each to get through. Will you be able to top the leaderboard for each of these? With >5 hours of mesmerizing gameplay, 10+ game mechanics to master and all set in a beautiful minimalist style with ambient adaptive soundtracks, you can enjoy it seated or standing up!\n"}]}, "developer_name": "HEADGEAR GbR", "developer_privacy_policy_url": "https://headgear.io/legal.html", "developer_terms_of_service_url": "https://headgear.io/legal.html#terms", "publisher_name": "HEADGEAR GbR", "support_website_url": null, "website_url": "https://headgear.io/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_categ
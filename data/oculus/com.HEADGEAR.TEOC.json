cdn.com/v/t64.5771-25/75361355_380339049810894_8629917805136921546_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NKUevsnG6bsQ7kNvwG_qIlR&_nc_oc=AdoeC4TbcCLD6dBmgQx4xP3FqSj2uCBOfc-NJQWx4mTZ1Ne0NRBWuKlz2ldczUo-dg0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af29oICIvqZjlJsQdSiCXjtOH7ACd7JN88j8_9zHqtb6vA&oe=69ECA3E3"}, {"file_name": "HighresScreenshot00081.png", "id": "376313343811121", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031312_376313347144454_2073303015962398022_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DAb8B7wnSfMQ7kNvwF2BUMQ&_nc_oc=Adp7z9GvRG905qq8ktHEJRkz30OsbDWmq_dzm7lLDhjnHACda5aQCETVF98ceD_BnnI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0Z1O_iJK-EwZqvS_Xg7tVKtVZMLA74Yv45wBBovriqpQ&oe=69ECD737"}, {"file_name": "HighresScreenshot00034.png", "id": "361423311640761", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75297579_361423314974094_4468664441597916853_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uEeJxQlx93gQ7kNvwFxuBlB&_nc_oc=Adpi-swqZSE2NKOYIgRJLDo9MHaDvse_vb5LsWLviVn_DrOur7-mj3uZPnbg9PepfRw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0xCXf8MG9VyzUsV_RVwASmnOk3qjMq8mrZwFp8EzlGRw&oe=69ECD5A0"}, {"file_name": "consume.png", "id": "356221875528110", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39001669_356221878861443_261896368707707264_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g9OyVU6k-kwQ7kNvwFQ2OMc&_nc_oc=AdqQHtlRDLP--zyyO67bQpyoaLJvH-7tBadFAT7tXNZg4ICY81ZRqtBnDSNFuQoGeBM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2URlaeqho8TEtKNpWPNmsiPYFOLlnB6ilJWs_SvkqOFg&oe=69ECC203"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "38982553_2716489995261681_7852865887418274915_n[1].png", "id": "1017968672039348", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974845_1017968675372681_3537640423345626257_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aaZHwAga0ZkQ7kNvwGcygtP&_nc_oc=AdqKqIovIAs2_eVw2L5nR4ygovC74P2W771PDQasx9mcUE9gmIKXf4Ne31yfbwvyPQg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af11ZnQ_totyx5G3C_bjIQRcmH0-XF6YWhmEIc_n92hs5Q&oe=69ECA306"}, "display_name": "TEOC", "keywords": ["arcade", "puzzle", "casual", "atmospheric", "puzzler"], "long_description": "Evolve from an atomic state to marine-life in this spatial arcade puzzler with just one goal: Consume or be Consumed! \n\nPowered by elemental forces and mythical artifacts navigate your way through 3 environments with 30+ rounds each to get through. Will you be able to top the leaderboard for each of these? \n\nTEOC provides\u2026\n\u2022 more than 5 hours of mesmerizing gameplay,\n\u2022 a beautiful minimalist style with ambient adaptive soundtracks,\n\u2022 10+ game mechanics to master,\n\u2022 additional powerups to collect and use across all 90+ rounds\n\u2022 with daily powerup rewards for coming back\n\u2022 to compete on the 3 leaderboards,\n\u2022 increasingly challenging level design all procedurally generated\n\u2022 and seated or standing play options!\n\n\n", "short_description": "Evolve from an atomic state to marine-life in this spatial arcade puzzler with just one goal: Consume or be Consumed! \n\nPowered by elemental forces and mythical artifacts navigate your way through 3 environments with 30+ rounds each to get through. Will you be able to top the leaderboard for each of these? With >5 hours of mesmerizing gameplay, 10+ game mechanics to master and all set in a beautiful minimalist style with ambient adaptive soundtracks, you can enjoy it seated or standing up!\n"}]}, "developer_name": "HEADGEAR GbR", "developer_privacy_policy_url": "https://headgear.io/legal.html", "developer_terms_of_service_url": "https://headgear.io/legal.html#terms", "publisher_name": "HEADGEAR GbR", "support_website_url": null, "website_url": "https://headgear.io/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_categ
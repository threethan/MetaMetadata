80339049810894_8629917805136921546_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=puE34yMf5xAQ7kNvwGRhXbV&_nc_oc=AdpdN0VnEEC4x7-RuscB0NvTzRZW9KPxyaUObErHFct2K1vTuI5s3SkQ94HoROlbQLI&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_AfzAuhvrftiPkyrxOL7hRRneJiUaPTmStimvyuZ7lbbs-g&oe=69C12263"}, {"file_name": "HighresScreenshot00081.png", "id": "376313343811121", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39031312_376313347144454_2073303015962398022_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kdEjRLNaRugQ7kNvwHoMeO0&_nc_oc=AdrJixCHbQ8DayQ0G0qUQPbO1NM49-DhyxZb6Sb0anngzHPz6p9OSxtLBlcdYvvswKk&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_AfzLw1hkuTdmpxd_uXv1rpkHQZ2TR3V9UAYSO6om0aJQFA&oe=69C11D77"}, {"file_name": "HighresScreenshot00034.png", "id": "361423311640761", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/75297579_361423314974094_4468664441597916853_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9D8hbaCUwTYQ7kNvwHg9BgT&_nc_oc=AdpkA_HvxGlN8SvPgOtlbD2yj-0tTVF199kEbnIIrsSqBaYiGEbnZtgCNcaSxz9w0aw&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_Afy0dQVMBl_LOUvzDvW0wkB6gehvGXjq92Pgwaf_AMV9Eg&oe=69C11BE0"}, {"file_name": "consume.png", "id": "356221875528110", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39001669_356221878861443_261896368707707264_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VJOWmyjsdtQQ7kNvwHJhE2X&_nc_oc=AdppcwFAxzM-8B68GvdQ_RCTYXjv-ALNMBhWo19RlYMkSaj2ueX9pwrZnhX5fA69FS0&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=8&oh=00_Afy_bqFnXcH4vAmcNd4FoHxSGc-rj6CwKNBxlvPQf8QVWA&oe=69C14083"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "38982553_2716489995261681_7852865887418274915_n[1].png", "id": "1017968672039348", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974845_1017968675372681_3537640423345626257_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VZ1hp40gmV8Q7kNvwGMStTy&_nc_oc=Adqx18WxKAO_PkQ-k1yzt6E2AbEuTMmanGrYHPPHkWi2Sle5Ff0Dk_sw8wp6rGfbrB0&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_AfyZAhsG3tU32N0sMJ_uahtozt5n9CyBosbdu_goEIf__Q&oe=69C12186"}, "display_name": "TEOC", "keywords": ["arcade", "puzzle", "casual", "atmospheric", "puzzler"], "long_description": "Evolve from an atomic state to marine-life in this spatial arcade puzzler with just one goal: Consume or be Consumed! \n\nPowered by elemental forces and mythical artifacts navigate your way through 3 environments with 30+ rounds each to get through. Will you be able to top the leaderboard for each of these? \n\nTEOC provides\u2026\n\u2022 more than 5 hours of mesmerizing gameplay,\n\u2022 a beautiful minimalist style with ambient adaptive soundtracks,\n\u2022 10+ game mechanics to master,\n\u2022 additional powerups to collect and use across all 90+ rounds\n\u2022 with daily powerup rewards for coming back\n\u2022 to compete on the 3 leaderboards,\n\u2022 increasingly challenging level design all procedurally generated\n\u2022 and seated or standing play options!\n\n\n", "short_description": "Evolve from an atomic state to marine-life in this spatial arcade puzzler with just one goal: Consume or be Consumed! \n\nPowered by elemental forces and mythical artifacts navigate your way through 3 environments with 30+ rounds each to get through. Will you be able to top the leaderboard for each of these? With >5 hours of mesmerizing gameplay, 10+ game mechanics to master and all set in a beautiful minimalist style with ambient adaptive soundtracks, you can enjoy it seated or standing up!\n"}]}, "developer_name": "HEADGEAR GbR", "developer_privacy_policy_url": "https://headgear.io/legal.html", "developer_terms_of_service_url": "https://headgear.io/legal.html#terms", "publisher_name": "HEADGEAR GbR", "support_website_url": null, "website_url": "https://headgear.io/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscrip
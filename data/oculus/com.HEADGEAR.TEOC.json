cdn.com/v/t64.5771-25/75361355_380339049810894_8629917805136921546_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O2z-Mq2jYHEQ7kNvwGyMKkp&_nc_oc=AdpTxpbYYB1i4D6QL7hyv0hGTCpbC9-mkAHx_GgB4wIdDRbDJ8MDya2umjQd8UCdCKU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5uUy60aREt-oIGbwhB799Dao_2HHZ_h9p52ato18Qk8Q&oe=6A1EF523"}, {"file_name": "HighresScreenshot00081.png", "id": "376313343811121", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031312_376313347144454_2073303015962398022_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KAsW10lvfW8Q7kNvwHF2ebB&_nc_oc=AdoIQwNVZ-d3nGxUe4l3klTMJLvEDxHJUusxwMfHyn-ujYnUHJmy2-vmkbFwoDNVjjA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7AftxOInME7eryRte0ZiYegSM-pxI8zvJCpp5265orVQ&oe=6A1EF037"}, {"file_name": "HighresScreenshot00034.png", "id": "361423311640761", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75297579_361423314974094_4468664441597916853_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_73psIlsCDgQ7kNvwH-iSPh&_nc_oc=AdrLD5lSIM0_Q1-5bwh_pvFcoN4w0ewJvrFrwHho8qT8TkvpcP7el0z6UJPHx0If6s8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4JtDzRF5Womld6xfwYBGklOgEwbBqlo9oWWvxGBrp_rw&oe=6A1EEEA0"}, {"file_name": "consume.png", "id": "356221875528110", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39001669_356221878861443_261896368707707264_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fDDDS4D0a-4Q7kNvwFYARl7&_nc_oc=Adp1yFrRCymveejRSqH6jUHTWVuR4cJ2yPOFq2TMqcvqtU_WEhn7pYZ6Y17z7Neztqk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5jj84upD49mkcDxvg6YDq4L3iyfFp3eJt8OKYnuOwoHQ&oe=6A1EDB03"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "38982553_2716489995261681_7852865887418274915_n[1].png", "id": "1017968672039348", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974845_1017968675372681_3537640423345626257_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=riO1PddWtrUQ7kNvwFGON6X&_nc_oc=AdrvYflVCVtYMgVIUiUUrPvzNp2d9_hkMDqV7jgYCtb20KqgGUP6MmR0BwZbAwWcJp0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6OIiqbN7Cx8zhd_VABPAC_y8AvVu5ZP8I4TFZh7uunqQ&oe=6A1EF446"}, "display_name": "TEOC", "keywords": ["arcade", "puzzle", "casual", "atmospheric", "puzzler"], "long_description": "Evolve from an atomic state to marine-life in this spatial arcade puzzler with just one goal: Consume or be Consumed! \n\nPowered by elemental forces and mythical artifacts navigate your way through 3 environments with 30+ rounds each to get through. Will you be able to top the leaderboard for each of these? \n\nTEOC provides\u2026\n\u2022 more than 5 hours of mesmerizing gameplay,\n\u2022 a beautiful minimalist style with ambient adaptive soundtracks,\n\u2022 10+ game mechanics to master,\n\u2022 additional powerups to collect and use across all 90+ rounds\n\u2022 with daily powerup rewards for coming back\n\u2022 to compete on the 3 leaderboards,\n\u2022 increasingly challenging level design all procedurally generated\n\u2022 and seated or standing play options!\n\n\n", "short_description": "Evolve from an atomic state to marine-life in this spatial arcade puzzler with just one goal: Consume or be Consumed! \n\nPowered by elemental forces and mythical artifacts navigate your way through 3 environments with 30+ rounds each to get through. Will you be able to top the leaderboard for each of these? With >5 hours of mesmerizing gameplay, 10+ game mechanics to master and all set in a beautiful minimalist style with ambient adaptive soundtracks, you can enjoy it seated or standing up!\n"}]}, "developer_name": "HEADGEAR GbR", "developer_privacy_policy_url": "https://headgear.io/legal.html", "developer_terms_of_service_url": "https://headgear.io/legal.html#terms", "publisher_name": "HEADGEAR GbR", "support_website_url": null, "website_url": "https://headgear.io/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_categ
cdn.com/v/t64.5771-25/75361355_380339049810894_8629917805136921546_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a0m3P1VC-yAQ7kNvwG0iFxP&_nc_oc=Adr4nOBkhIqRILY10tMl9GqkBylFCS2oAoKW5VtF0Z2ja4j4AZTFMhU4EwikM5wVto8&_nc_zt=3&_nc_ht=scontent-lhr8-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3TttdEz_SrzQxvMQscky9gLflMwJgve64hg_NXOLhWKg&oe=69E25023"}, {"file_name": "HighresScreenshot00081.png", "id": "376313343811121", "uri": "https://scontent-lhr8-1.oculuscdn.com/v/t64.5771-25/39031312_376313347144454_2073303015962398022_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=82j6gokgw9sQ7kNvwFXLVYN&_nc_oc=AdqF1-63GwA7Qx9T97n25btYFsbU1T6T497bRs4jEKFztDDW75wEp3415Hiygs0wUQo&_nc_zt=3&_nc_ht=scontent-lhr8-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0641y4Zlnhu-G28lkkge1CQsimOIcTh5daBXFM1usa3A&oe=69E24B37"}, {"file_name": "HighresScreenshot00034.png", "id": "361423311640761", "uri": "https://scontent-lhr8-1.oculuscdn.com/v/t64.5771-25/75297579_361423314974094_4468664441597916853_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=17XNdQBvnywQ7kNvwEdnKnS&_nc_oc=AdoQoH2doFxxY8MEOaJBj030W_dMC3kqtuWoj-gsCc-XtTP_JWTqRHLR0mFTU942T4g&_nc_zt=3&_nc_ht=scontent-lhr8-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1OKKZPahHsBqXUs2rLT00JlBFQO0AXCScpsZWGC87XQw&oe=69E249A0"}, {"file_name": "consume.png", "id": "356221875528110", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/39001669_356221878861443_261896368707707264_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BA8Qa7xcPT4Q7kNvwHXp644&_nc_oc=Adq-9Jq6jgFFvTli5iPApIqC047VDZW7sLqVxA4pPQmnunlrVoSeUNIQPPtkiW8tBJA&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1GFeJHD__RoPa_XSNZlF3vwqvIvqk_glbjVxIClljpqQ&oe=69E23603"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "38982553_2716489995261681_7852865887418274915_n[1].png", "id": "1017968672039348", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/38974845_1017968675372681_3537640423345626257_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OBWWinxpzSgQ7kNvwE-fRg0&_nc_oc=Adr20_gAjqSp_-Ro5ZoGfM2hYInBRGAONUNAJ8v3OPAoe69MbR-2xIWHl9sG1V0osnA&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af25JI3Grv8tUV8g4tHBjfWg7XWlsvAXfE2dt1C1Nse5ZQ&oe=69E24F46"}, "display_name": "TEOC", "keywords": ["arcade", "puzzle", "casual", "atmospheric", "puzzler"], "long_description": "Evolve from an atomic state to marine-life in this spatial arcade puzzler with just one goal: Consume or be Consumed! \n\nPowered by elemental forces and mythical artifacts navigate your way through 3 environments with 30+ rounds each to get through. Will you be able to top the leaderboard for each of these? \n\nTEOC provides\u2026\n\u2022 more than 5 hours of mesmerizing gameplay,\n\u2022 a beautiful minimalist style with ambient adaptive soundtracks,\n\u2022 10+ game mechanics to master,\n\u2022 additional powerups to collect and use across all 90+ rounds\n\u2022 with daily powerup rewards for coming back\n\u2022 to compete on the 3 leaderboards,\n\u2022 increasingly challenging level design all procedurally generated\n\u2022 and seated or standing play options!\n\n\n", "short_description": "Evolve from an atomic state to marine-life in this spatial arcade puzzler with just one goal: Consume or be Consumed! \n\nPowered by elemental forces and mythical artifacts navigate your way through 3 environments with 30+ rounds each to get through. Will you be able to top the leaderboard for each of these? With >5 hours of mesmerizing gameplay, 10+ game mechanics to master and all set in a beautiful minimalist style with ambient adaptive soundtracks, you can enjoy it seated or standing up!\n"}]}, "developer_name": "HEADGEAR GbR", "developer_privacy_policy_url": "https://headgear.io/legal.html", "developer_terms_of_service_url": "https://headgear.io/legal.html#terms", "publisher_name": "HEADGEAR GbR", "support_website_url": null, "website_url": "https://headgear.io/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_categ
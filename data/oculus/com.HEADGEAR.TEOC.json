cdn.com/v/t64.5771-25/75361355_380339049810894_8629917805136921546_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NKUevsnG6bsQ7kNvwGyGw5s&_nc_oc=AdoDNIS0_AZswu5K90t7VrCUhfN9ua1PJVgkx_eG8Z1vMw_BJ7Zw8D6-kvlVHu_EExI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1ewrCWqkDa-Yq2suTfhi-CXpvkXNI9LYfeel0cOvseIw&oe=69EA3923"}, {"file_name": "HighresScreenshot00081.png", "id": "376313343811121", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031312_376313347144454_2073303015962398022_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iwnsm8arC5wQ7kNvwGhTL0H&_nc_oc=Adq_C_YO6n5VluyHg3UdrJA--mLJGTxboAqfsAExqzg4YLpn2Jwrc0h1s_jXNiZDVrU&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af33bQGOBdbOdfPs7xCt9AbRJj8OcBgGBz0nU0rK-iX9Dg&oe=69EA3437"}, {"file_name": "HighresScreenshot00034.png", "id": "361423311640761", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75297579_361423314974094_4468664441597916853_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dV05DGgBUjMQ7kNvwHLtz15&_nc_oc=AdqEtoOgsGHenevPotI5gj69Q9XR4UlhIke-UJkK74ntV3Pct_Kvw61OAp3gl2m2kq0&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0rJ9GmyPYcme_L438kipD9zy79oHS6OdeT4XwBTQmJDw&oe=69EA32A0"}, {"file_name": "consume.png", "id": "356221875528110", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39001669_356221878861443_261896368707707264_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8OpKMA8EMH0Q7kNvwFqnqbZ&_nc_oc=AdrnTL9_b3HI6Qhd5eEZyOmzWxaX6_8wgBWdWFtfIgf1bzQxsZHOSDMY_m14v97UFG0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2RJXFKg_4kwVUorobkZ3W86AUF_pjYKCo--HQx7AZr4Q&oe=69EA1F03"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "38982553_2716489995261681_7852865887418274915_n[1].png", "id": "1017968672039348", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974845_1017968675372681_3537640423345626257_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rZWEeWofn9AQ7kNvwFAeX_5&_nc_oc=Adr9JpLBly9jATvBTMXCIghHP4KY3hbj6zbLyepReLT7Ceb1qg3xdp-cVMw2LA_uBG0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3VYky4_3VTgqYc-pC3qvVLxgMSvFp5zjIQnTbHY3PYbQ&oe=69EA3846"}, "display_name": "TEOC", "keywords": ["arcade", "puzzle", "casual", "atmospheric", "puzzler"], "long_description": "Evolve from an atomic state to marine-life in this spatial arcade puzzler with just one goal: Consume or be Consumed! \n\nPowered by elemental forces and mythical artifacts navigate your way through 3 environments with 30+ rounds each to get through. Will you be able to top the leaderboard for each of these? \n\nTEOC provides\u2026\n\u2022 more than 5 hours of mesmerizing gameplay,\n\u2022 a beautiful minimalist style with ambient adaptive soundtracks,\n\u2022 10+ game mechanics to master,\n\u2022 additional powerups to collect and use across all 90+ rounds\n\u2022 with daily powerup rewards for coming back\n\u2022 to compete on the 3 leaderboards,\n\u2022 increasingly challenging level design all procedurally generated\n\u2022 and seated or standing play options!\n\n\n", "short_description": "Evolve from an atomic state to marine-life in this spatial arcade puzzler with just one goal: Consume or be Consumed! \n\nPowered by elemental forces and mythical artifacts navigate your way through 3 environments with 30+ rounds each to get through. Will you be able to top the leaderboard for each of these? With >5 hours of mesmerizing gameplay, 10+ game mechanics to master and all set in a beautiful minimalist style with ambient adaptive soundtracks, you can enjoy it seated or standing up!\n"}]}, "developer_name": "HEADGEAR GbR", "developer_privacy_policy_url": "https://headgear.io/legal.html", "developer_terms_of_service_url": "https://headgear.io/legal.html#terms", "publisher_name": "HEADGEAR GbR", "support_website_url": null, "website_url": "https://headgear.io/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_categ
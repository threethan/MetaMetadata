80339049810894_8629917805136921546_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EGlDyS0Ag_AQ7kNvwGD-4c2&_nc_oc=AdmcDagTTgC57vvJsUZqrcub0LgwLUb6Hm440MZo2QwYf-XSPqzM0Tmd9EI-0n6qGso&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfwLPsEKHUOwHyImGMQSFs6A_I3jAubS-Lxq5LxSi-NqvA&oe=69B15063"}, {"file_name": "HighresScreenshot00081.png", "id": "376313343811121", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031312_376313347144454_2073303015962398022_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ajuu68ITILsQ7kNvwHf3kaT&_nc_oc=Adl-2Z_fhmokhaN1Fzkbsm-U0-X34fnMKC-Bvk8aYX70ZrU5CNRftp5g6lGJHjqP_kg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfzuCqANsLO-p0TIs8y4m-XBH87Y8FoNv43WNYf3dD8zVA&oe=69B14B77"}, {"file_name": "HighresScreenshot00034.png", "id": "361423311640761", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75297579_361423314974094_4468664441597916853_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7uXHkZNlcRsQ7kNvwEpRkWY&_nc_oc=AdkF7Zc2hNgBt6TumE2QQ-IKgYwJN270nEkE7PAU4oQSlKav4qmhTxCMJ_Gw480ojtU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfzLmsXEkBkmvzKY0gMubaPDD1ISV6ugiF9da8dYo5vnQg&oe=69B149E0"}, {"file_name": "consume.png", "id": "356221875528110", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39001669_356221878861443_261896368707707264_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UChDsBS5q2EQ7kNvwG4ZyKF&_nc_oc=AdlE-7UdQ9zKDDmgtFtaKnaAwXE1zhauW8O_KNBohF-l73Zw5B7p6UuoLlq6q0MboLQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_Afyh9d4SI6gmxWKbK3toblrFa1fJSIBCccEiDS05gch1Gg&oe=69B16E83"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "38982553_2716489995261681_7852865887418274915_n[1].png", "id": "1017968672039348", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974845_1017968675372681_3537640423345626257_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TjGod3ISLuUQ7kNvwHfY7k-&_nc_oc=AdmxmM_--q7YKC8cjXaI_oq_1CJlmZjPPvcY5puBTGsLH2DMIVsi5p5UxKVi9W293xk&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_Afx5gFUAi3w5XQ5s1YgrYQa2rc6ykTGEx_SdCVxwJQ_Rxg&oe=69B14F86"}, "display_name": "TEOC", "keywords": ["arcade", "puzzle", "casual", "atmospheric", "puzzler"], "long_description": "Evolve from an atomic state to marine-life in this spatial arcade puzzler with just one goal: Consume or be Consumed! \n\nPowered by elemental forces and mythical artifacts navigate your way through 3 environments with 30+ rounds each to get through. Will you be able to top the leaderboard for each of these? \n\nTEOC provides\u2026\n\u2022 more than 5 hours of mesmerizing gameplay,\n\u2022 a beautiful minimalist style with ambient adaptive soundtracks,\n\u2022 10+ game mechanics to master,\n\u2022 additional powerups to collect and use across all 90+ rounds\n\u2022 with daily powerup rewards for coming back\n\u2022 to compete on the 3 leaderboards,\n\u2022 increasingly challenging level design all procedurally generated\n\u2022 and seated or standing play options!\n\n\n", "short_description": "Evolve from an atomic state to marine-life in this spatial arcade puzzler with just one goal: Consume or be Consumed! \n\nPowered by elemental forces and mythical artifacts navigate your way through 3 environments with 30+ rounds each to get through. Will you be able to top the leaderboard for each of these? With >5 hours of mesmerizing gameplay, 10+ game mechanics to master and all set in a beautiful minimalist style with ambient adaptive soundtracks, you can enjoy it seated or standing up!\n"}]}, "developer_name": "HEADGEAR GbR", "developer_privacy_policy_url": "https://headgear.io/legal.html", "developer_terms_of_service_url": "https://headgear.io/legal.html#terms", "publisher_name": "HEADGEAR GbR", "support_website_url": null, "website_url": "https://headgear.io/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscrip
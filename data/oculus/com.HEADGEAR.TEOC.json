cdn.com/v/t64.5771-25/75361355_380339049810894_8629917805136921546_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3tOBZc47sPAQ7kNvwG7UvDM&_nc_oc=AdqZT-iHDsVzJQmCEClkOvkoUKxYLkdTmPSOEZvB-auEsFJR7RnVT3HasKJuLL3UDx8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI9NPGiicENU1LbiTQ9p1A8Dw3_kpkO71N2_IC67WY9cA&oe=6AA81123"}, {"file_name": "HighresScreenshot00081.png", "id": "376313343811121", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031312_376313347144454_2073303015962398022_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6jXAxVWz81QQ7kNvwFDfMx7&_nc_oc=Adr0xBCrKU_Hs2brCHxqBhYp-mrXjGixbZGRYnQnNNQLqxcHfDDK4k2NRrcDksDz_78&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKQGCVgqkreLRF7uvmoQz16N_oNNksKHQLFG276S-ZlDg&oe=6AA80C37"}, {"file_name": "HighresScreenshot00034.png", "id": "361423311640761", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75297579_361423314974094_4468664441597916853_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qgqKbG8vYREQ7kNvwGGJz4s&_nc_oc=AdqKpGj3--38N4Qn3Whce6te0ddEwaa04L3LnRB6_nvk-vJKQSOzo-3YKvEDlrX93vg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKG_2Z_TQXJWmWM2aXgJicv0rqAG4z-32GeD-JSSdTCgw&oe=6AA80AA0"}, {"file_name": "consume.png", "id": "356221875528110", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39001669_356221878861443_261896368707707264_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YLMq3v7MUKkQ7kNvwFgdcY-&_nc_oc=AdpZCrpvsSrH7iDlEzz--Dsa1Nbshu_CdAHsitniX7i7NeislXZ2LJ_09RHwuu0c0dM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLsS298g_d3ZEORGfl3Woaj9RFeKY6v0v1ODg2Ua3kRFw&oe=6AA7F703"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "38982553_2716489995261681_7852865887418274915_n[1].png", "id": "1017968672039348", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974845_1017968675372681_3537640423345626257_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KdWkfYfUaRoQ7kNvwFMSvku&_nc_oc=AdpRQj4bUVCfqY5f1mahToWzgLdFDkn1Sfq0iPfQ1m8tJdueJnjdg1ODW7xetJIlHHw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI4_rnESzYOyVzwPbfrTwxSC4TLVbXfbwMEjGRn9fV0Sw&oe=6AA81046"}, "display_name": "TEOC", "keywords": ["arcade", "puzzle", "casual", "atmospheric", "puzzler"], "long_description": "Evolve from an atomic state to marine-life in this spatial arcade puzzler with just one goal: Consume or be Consumed! \n\nPowered by elemental forces and mythical artifacts navigate your way through 3 environments with 30+ rounds each to get through. Will you be able to top the leaderboard for each of these? \n\nTEOC provides\u2026\n\u2022 more than 5 hours of mesmerizing gameplay,\n\u2022 a beautiful minimalist style with ambient adaptive soundtracks,\n\u2022 10+ game mechanics to master,\n\u2022 additional powerups to collect and use across all 90+ rounds\n\u2022 with daily powerup rewards for coming back\n\u2022 to compete on the 3 leaderboards,\n\u2022 increasingly challenging level design all procedurally generated\n\u2022 and seated or standing play options!\n\n\n", "short_description": "Evolve from an atomic state to marine-life in this spatial arcade puzzler with just one goal: Consume or be Consumed! \n\nPowered by elemental forces and mythical artifacts navigate your way through 3 environments with 30+ rounds each to get through. Will you be able to top the leaderboard for each of these? With >5 hours of mesmerizing gameplay, 10+ game mechanics to master and all set in a beautiful minimalist style with ambient adaptive soundtracks, you can enjoy it seated or standing up!\n"}]}, "developer_name": "HEADGEAR GbR", "developer_privacy_policy_url": "https://headgear.io/legal.html", "developer_terms_of_service_url": "https://headgear.io/legal.html#terms", "publisher_name": "HEADGEAR GbR", "support_website_url": null, "website_url": "https://headgear.io/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_categ
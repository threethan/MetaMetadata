80339049810894_8629917805136921546_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CFZWsHoFZeEQ7kNvwEb5CSv&_nc_oc=AdnpGcVtPe8depingFn2kUb3ERT301eTSrA-QFCSDa1S1ODmMNU7V334eZTCI6fC39A&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfzHAsqDOh1FA2Z1IkDqXfNufbDayTnLZjz1GC4qhw7Ipw&oe=69B2A1E3"}, {"file_name": "HighresScreenshot00081.png", "id": "376313343811121", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031312_376313347144454_2073303015962398022_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ajuu68ITILsQ7kNvwFP9WX6&_nc_oc=AdmseUk52k3UieGD-MZXy4ucoJGTIMYSpSnq-VqDOiQpBS3H91jdPpm1-mkcHGBoBhw&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfymEE4m53NsqH1vfiZxFDkQM-AJq2w2b_aSa4KpzoLozQ&oe=69B29CF7"}, {"file_name": "HighresScreenshot00034.png", "id": "361423311640761", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75297579_361423314974094_4468664441597916853_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7uXHkZNlcRsQ7kNvwHRQIM2&_nc_oc=Admh0JysvrDFuJvEj3cV7cTSNa3blXOJqleMRGnezi04kSNDubbjPJI7CetwrqxamqY&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfwGjZ-lMbMciyoqN_aBskpRSPzObpTAerlv9rk5YQNusw&oe=69B29B60"}, {"file_name": "consume.png", "id": "356221875528110", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39001669_356221878861443_261896368707707264_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UChDsBS5q2EQ7kNvwFtqPVh&_nc_oc=AdlXu-Px_XmfvSlR43YlVR9gaD8c03_G4SGcOqLcXpoo5LT-nTG1iZiMZPAhNiKZJlI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfyCGMPNjlmEQqjIR7g7tx0jGBI1KkOJq2sPh00NujBSoQ&oe=69B2C003"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "38982553_2716489995261681_7852865887418274915_n[1].png", "id": "1017968672039348", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974845_1017968675372681_3537640423345626257_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TjGod3ISLuUQ7kNvwHSCJRf&_nc_oc=AdnXJiLAQfAOv7Sy-IsVdssTX3vSO2vH34Op2VyCxPALavvqYwvpzHiloOKzcHu5Rbw&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfzhkUXMHZ4cPS3EkX4u6veHlA8WYD-Zh2kpxbQJGDsK2w&oe=69B2A106"}, "display_name": "TEOC", "keywords": ["arcade", "puzzle", "casual", "atmospheric", "puzzler"], "long_description": "Evolve from an atomic state to marine-life in this spatial arcade puzzler with just one goal: Consume or be Consumed! \n\nPowered by elemental forces and mythical artifacts navigate your way through 3 environments with 30+ rounds each to get through. Will you be able to top the leaderboard for each of these? \n\nTEOC provides\u2026\n\u2022 more than 5 hours of mesmerizing gameplay,\n\u2022 a beautiful minimalist style with ambient adaptive soundtracks,\n\u2022 10+ game mechanics to master,\n\u2022 additional powerups to collect and use across all 90+ rounds\n\u2022 with daily powerup rewards for coming back\n\u2022 to compete on the 3 leaderboards,\n\u2022 increasingly challenging level design all procedurally generated\n\u2022 and seated or standing play options!\n\n\n", "short_description": "Evolve from an atomic state to marine-life in this spatial arcade puzzler with just one goal: Consume or be Consumed! \n\nPowered by elemental forces and mythical artifacts navigate your way through 3 environments with 30+ rounds each to get through. Will you be able to top the leaderboard for each of these? With >5 hours of mesmerizing gameplay, 10+ game mechanics to master and all set in a beautiful minimalist style with ambient adaptive soundtracks, you can enjoy it seated or standing up!\n"}]}, "developer_name": "HEADGEAR GbR", "developer_privacy_policy_url": "https://headgear.io/legal.html", "developer_terms_of_service_url": "https://headgear.io/legal.html#terms", "publisher_name": "HEADGEAR GbR", "support_website_url": null, "website_url": "https://headgear.io/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscrip
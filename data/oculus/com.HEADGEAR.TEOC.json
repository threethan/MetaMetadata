cdn.com/v/t64.5771-25/75361355_380339049810894_8629917805136921546_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6ZY56GQpGBcQ7kNvwEBFv8C&_nc_oc=AdrFjd7Qui_SJVbznaASnv1_PbU9SEOn-yRsP8ipTOBt8uVVdNb0p4glGe3KqcZO-XQ&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2tzzZWOQRzO5-ZQ2Vi2p2qrlk8gE7-fpfjKUnrytIwaQ&oe=69F616A3"}, {"file_name": "HighresScreenshot00081.png", "id": "376313343811121", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/39031312_376313347144454_2073303015962398022_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qUZlIGhZwJ0Q7kNvwE5bgBd&_nc_oc=AdrsNSMD1KpTVRIgrN9gvmv40lH_Hvr-Awsmw1AjQJilrT52kW63JfN7HVqaTFMN9Pg&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3KAW2rfHE7_lMEnTCVYFMyz6v_KnCW6rHmzBecAuE17Q&oe=69F611B7"}, {"file_name": "HighresScreenshot00034.png", "id": "361423311640761", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/75297579_361423314974094_4468664441597916853_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YY4Y_JUzbfsQ7kNvwGbU1cR&_nc_oc=Adpbl2aEwH2eHcgogqjZKXV8wFXxPHsD-fgywD9stDIfi1axV8DWtzvAJIWm6nRCpT4&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af06eUxYDAZzA4oQ5Qxmfrxjo6c2Ii-PCqH_kJ_hc9GSNg&oe=69F61020"}, {"file_name": "consume.png", "id": "356221875528110", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/39001669_356221878861443_261896368707707264_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EKbWvkUEtg0Q7kNvwHURzvK&_nc_oc=AdpRNryKbCRKLMna4zI_8deiMLl0Bm8H13cooFrgbJPfYP5NbGlDv-gos-sVXRd1flE&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1urRgEv100ma1gJogUyg5QRrHiTOyQNo9qwIyIlmH6rw&oe=69F5FC83"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "38982553_2716489995261681_7852865887418274915_n[1].png", "id": "1017968672039348", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/38974845_1017968675372681_3537640423345626257_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GsvAFXhU0g8Q7kNvwE9pZ29&_nc_oc=AdoAXRCsLM-lpVT7gDPpi4hgvHvEWkpmGlUwN7we-eg4_20eG1FxT4S9tJz9m81REcg&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3Q1WOXlXW5swW0YoM1J4L-15BI8I4ZLHiZ9k3s1dRBuA&oe=69F615C6"}, "display_name": "TEOC", "keywords": ["arcade", "puzzle", "casual", "atmospheric", "puzzler"], "long_description": "Evolve from an atomic state to marine-life in this spatial arcade puzzler with just one goal: Consume or be Consumed! \n\nPowered by elemental forces and mythical artifacts navigate your way through 3 environments with 30+ rounds each to get through. Will you be able to top the leaderboard for each of these? \n\nTEOC provides\u2026\n\u2022 more than 5 hours of mesmerizing gameplay,\n\u2022 a beautiful minimalist style with ambient adaptive soundtracks,\n\u2022 10+ game mechanics to master,\n\u2022 additional powerups to collect and use across all 90+ rounds\n\u2022 with daily powerup rewards for coming back\n\u2022 to compete on the 3 leaderboards,\n\u2022 increasingly challenging level design all procedurally generated\n\u2022 and seated or standing play options!\n\n\n", "short_description": "Evolve from an atomic state to marine-life in this spatial arcade puzzler with just one goal: Consume or be Consumed! \n\nPowered by elemental forces and mythical artifacts navigate your way through 3 environments with 30+ rounds each to get through. Will you be able to top the leaderboard for each of these? With >5 hours of mesmerizing gameplay, 10+ game mechanics to master and all set in a beautiful minimalist style with ambient adaptive soundtracks, you can enjoy it seated or standing up!\n"}]}, "developer_name": "HEADGEAR GbR", "developer_privacy_policy_url": "https://headgear.io/legal.html", "developer_terms_of_service_url": "https://headgear.io/legal.html#terms", "publisher_name": "HEADGEAR GbR", "support_website_url": null, "website_url": "https://headgear.io/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_categ
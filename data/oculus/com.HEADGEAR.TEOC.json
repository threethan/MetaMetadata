cdn.com/v/t64.5771-25/75361355_380339049810894_8629917805136921546_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6O9v6xM1_CwQ7kNvwFCDf_3&_nc_oc=AdrwYTWCXJ3HFynE1O0nkQwRPovwazq-9uvdv4yjHrsVl4bfteuTFO8O7BJi1f48riA&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOPEZGrupmwzqcyKGpmNWjh3fydfbAZdmUmq3kyd3Bs1Q&oe=6AE21323"}, {"file_name": "HighresScreenshot00081.png", "id": "376313343811121", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39031312_376313347144454_2073303015962398022_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kXqDYqN_tdQQ7kNvwG3ke7r&_nc_oc=AdqI0Q4_iwIpKPlukzbkZL8_-U6qG0khFLBJa9yzFNkCcLhJBg_Dd7A3hGyijoNBwhw&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPNoi5n7M4t7BEdAK1JuRPWHSBdZkKacrM2LctIVd2CvA&oe=6AE20E37"}, {"file_name": "HighresScreenshot00034.png", "id": "361423311640761", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75297579_361423314974094_4468664441597916853_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=De5q1SGcQSQQ7kNvwE3FskP&_nc_oc=AdrHAQKW0tUtvO1QiE-jOMl2dq08kU9Gu_NrLPA11dYg7AwmmKy-xErTStlDQcU5GzY&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQME0bA3sIoEWGj7aWVzbubTFnyLA5tHIJPbelTIWBPSYg&oe=6AE20CA0"}, {"file_name": "consume.png", "id": "356221875528110", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39001669_356221878861443_261896368707707264_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=87-J7vK-6MkQ7kNvwEHoVJ4&_nc_oc=AdrLTqopMhdW75ln_zy3nVJ1USB7csmeQKgJHoRk6GVqsQdnxL8WdbnnUeHYjuVq5A8&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPrueKCX1Pzfe_Y2c1hLCLWmJL32f8uHKilcE2sjm1azw&oe=6AE1F903"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "38982553_2716489995261681_7852865887418274915_n[1].png", "id": "1017968672039348", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974845_1017968675372681_3537640423345626257_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xcqtgyiAcpMQ7kNvwF2Homa&_nc_oc=AdoSUqQC-MXqqWT5cgCwADgTjyrmeuWV5FZ5Zqx83Ppqn9KWFfWT-9vAZaa5lWmkYd8&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOCjXPYH6suO2i95jaD4fFKul8hxdNHg1r_nhAV0yFNFQ&oe=6AE21246"}, "display_name": "TEOC", "keywords": ["arcade", "puzzle", "casual", "atmospheric", "puzzler"], "long_description": "Evolve from an atomic state to marine-life in this spatial arcade puzzler with just one goal: Consume or be Consumed! \n\nPowered by elemental forces and mythical artifacts navigate your way through 3 environments with 30+ rounds each to get through. Will you be able to top the leaderboard for each of these? \n\nTEOC provides\u2026\n\u2022 more than 5 hours of mesmerizing gameplay,\n\u2022 a beautiful minimalist style with ambient adaptive soundtracks,\n\u2022 10+ game mechanics to master,\n\u2022 additional powerups to collect and use across all 90+ rounds\n\u2022 with daily powerup rewards for coming back\n\u2022 to compete on the 3 leaderboards,\n\u2022 increasingly challenging level design all procedurally generated\n\u2022 and seated or standing play options!\n\n\n", "short_description": "Evolve from an atomic state to marine-life in this spatial arcade puzzler with just one goal: Consume or be Consumed! \n\nPowered by elemental forces and mythical artifacts navigate your way through 3 environments with 30+ rounds each to get through. Will you be able to top the leaderboard for each of these? With >5 hours of mesmerizing gameplay, 10+ game mechanics to master and all set in a beautiful minimalist style with ambient adaptive soundtracks, you can enjoy it seated or standing up!\n"}]}, "developer_name": "HEADGEAR GbR", "developer_privacy_policy_url": "https://headgear.io/legal.html", "developer_terms_of_service_url": "https://headgear.io/legal.html#terms", "publisher_name": "HEADGEAR GbR", "support_website_url": null, "website_url": "https://headgear.io/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_categ
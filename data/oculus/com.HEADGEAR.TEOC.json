80339049810894_8629917805136921546_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=puE34yMf5xAQ7kNvwFq8u6m&_nc_oc=Admm2ZumktumgmqgNu-ZDwzYEWNDLXImWQfI_xcWgREWzDrqlMnU8CMVNWABnbgd24w&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_Afyz8wcNvGTL2Tz8wCTCT6Bh9kmQM_rrpFObzoEcFoWwHg&oe=69BE7F63"}, {"file_name": "HighresScreenshot00081.png", "id": "376313343811121", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031312_376313347144454_2073303015962398022_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EU0q_6l2T_gQ7kNvwGAsgF3&_nc_oc=AdmgoyteaUwGXvGMunGIKdH72qeUurOJ6K9ld5mSubBYtOvwb5x6uIZqmMLFfNpQC54&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfyxoBluwEOQZmt7zKcaH2HcNujUgR3kiEmd4tGlrw-Vlg&oe=69BE7A77"}, {"file_name": "HighresScreenshot00034.png", "id": "361423311640761", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75297579_361423314974094_4468664441597916853_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o2uWGZEvS3MQ7kNvwFoUEyZ&_nc_oc=AdlBNJUOSpogOzvOmZNjZH4p1b5F-zuumxkyn8N5d5GimtFvCD8ypAz0hZTDT9TSLZk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfykmG0U6Sdujhc7hp52kmQYWaWkCK-gBj-NBZSDVJ4SHg&oe=69BE78E0"}, {"file_name": "consume.png", "id": "356221875528110", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39001669_356221878861443_261896368707707264_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IJB9wvGgmegQ7kNvwHcnlq3&_nc_oc=AdmhLpNrk0pVyeEmPwTmS89aIX9zUXBrpBZLl9JIWEMh6sOc4uJJCICKjIA7gOmIfsI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfyAtd84nO7ztL8y_7miD4gGXT40VbY1O6VMtn031jH9DQ&oe=69BE9D83"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "38982553_2716489995261681_7852865887418274915_n[1].png", "id": "1017968672039348", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974845_1017968675372681_3537640423345626257_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fS2mjI7-lCMQ7kNvwFVR0VU&_nc_oc=Adl-FAnRzovnUi6HwrRJNYlWt39bWdh8m2lsV5v6_kG6CBuJlEpgMnncU9CdczIA_Lc&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_Afwb17gBEYplL7QP9L4fZBNqQIlH6mmtsrL5FqdXYtBvag&oe=69BE7E86"}, "display_name": "TEOC", "keywords": ["arcade", "puzzle", "casual", "atmospheric", "puzzler"], "long_description": "Evolve from an atomic state to marine-life in this spatial arcade puzzler with just one goal: Consume or be Consumed! \n\nPowered by elemental forces and mythical artifacts navigate your way through 3 environments with 30+ rounds each to get through. Will you be able to top the leaderboard for each of these? \n\nTEOC provides\u2026\n\u2022 more than 5 hours of mesmerizing gameplay,\n\u2022 a beautiful minimalist style with ambient adaptive soundtracks,\n\u2022 10+ game mechanics to master,\n\u2022 additional powerups to collect and use across all 90+ rounds\n\u2022 with daily powerup rewards for coming back\n\u2022 to compete on the 3 leaderboards,\n\u2022 increasingly challenging level design all procedurally generated\n\u2022 and seated or standing play options!\n\n\n", "short_description": "Evolve from an atomic state to marine-life in this spatial arcade puzzler with just one goal: Consume or be Consumed! \n\nPowered by elemental forces and mythical artifacts navigate your way through 3 environments with 30+ rounds each to get through. Will you be able to top the leaderboard for each of these? With >5 hours of mesmerizing gameplay, 10+ game mechanics to master and all set in a beautiful minimalist style with ambient adaptive soundtracks, you can enjoy it seated or standing up!\n"}]}, "developer_name": "HEADGEAR GbR", "developer_privacy_policy_url": "https://headgear.io/legal.html", "developer_terms_of_service_url": "https://headgear.io/legal.html#terms", "publisher_name": "HEADGEAR GbR", "support_website_url": null, "website_url": "https://headgear.io/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscrip
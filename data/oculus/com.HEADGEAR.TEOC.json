cdn.com/v/t64.5771-25/75361355_380339049810894_8629917805136921546_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JcmL2ld573oQ7kNvwGt917o&_nc_oc=AdoRXBR10t9lmCSZ3pNp2DcyRt3YSHQdjLZBLWoBU_LSB5mqYhU3w6Z7ZrYLcDnEYjE&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCCoNJ7FiSaUT5QHVeKj1vZzh8qO_ZeYLTRYioM8WButw&oe=6A662623"}, {"file_name": "HighresScreenshot00081.png", "id": "376313343811121", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/39031312_376313347144454_2073303015962398022_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c_LkjhKz44EQ7kNvwHDPVxL&_nc_oc=AdoFGHaLd4JJrqF9-z_wVeoVKztUjktEyXU7qAWvmw6N4zNDoQXQ7pImez-qAWCBEzE&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAnBLu3QW6--nPXmtCnIcN5CoWQgffKOMgdJgiXAfhTbA&oe=6A662137"}, {"file_name": "HighresScreenshot00034.png", "id": "361423311640761", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/75297579_361423314974094_4468664441597916853_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lyDcBXGB5Q8Q7kNvwFvF4Dt&_nc_oc=AdrctIHtuEfKoEd0AG0EiIpXwPbcOJl0OygJ5e0oL9d3TU8HkTSnRbRYUD2MDGafeyc&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDHpFyc2MDvdoB9Vc1-6CAd8nDcBcjTM4zDnb95sErQ3w&oe=6A661FA0"}, {"file_name": "consume.png", "id": "356221875528110", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/39001669_356221878861443_261896368707707264_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Q1sJWWsvQ-0Q7kNvwEPN_ks&_nc_oc=AdoIHGjHHBKvzMpd-78uYZQrRi3W1kKAQ_vFSfKq98Qmj2yQcSGlWD6o09NZ5mbOR6I&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAmLFrPlYxjOFw3CbTU_h8GNIhYcrdCalasAYUzUGTVDg&oe=6A660C03"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "38982553_2716489995261681_7852865887418274915_n[1].png", "id": "1017968672039348", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/38974845_1017968675372681_3537640423345626257_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Sa1nwtAx3RMQ7kNvwGZgPNB&_nc_oc=AdrRO8sN3zDhmazy8S5Ylfjx-1qnNHrJeiFSu5_o_VhDsP5gley-mVdvYsMJ5v-tyKk&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDlQGoz_OxHSGaW4pnnv0OHXWIUP3-SQ_ej8xVrH27Hlg&oe=6A662546"}, "display_name": "TEOC", "keywords": ["arcade", "puzzle", "casual", "atmospheric", "puzzler"], "long_description": "Evolve from an atomic state to marine-life in this spatial arcade puzzler with just one goal: Consume or be Consumed! \n\nPowered by elemental forces and mythical artifacts navigate your way through 3 environments with 30+ rounds each to get through. Will you be able to top the leaderboard for each of these? \n\nTEOC provides\u2026\n\u2022 more than 5 hours of mesmerizing gameplay,\n\u2022 a beautiful minimalist style with ambient adaptive soundtracks,\n\u2022 10+ game mechanics to master,\n\u2022 additional powerups to collect and use across all 90+ rounds\n\u2022 with daily powerup rewards for coming back\n\u2022 to compete on the 3 leaderboards,\n\u2022 increasingly challenging level design all procedurally generated\n\u2022 and seated or standing play options!\n\n\n", "short_description": "Evolve from an atomic state to marine-life in this spatial arcade puzzler with just one goal: Consume or be Consumed! \n\nPowered by elemental forces and mythical artifacts navigate your way through 3 environments with 30+ rounds each to get through. Will you be able to top the leaderboard for each of these? With >5 hours of mesmerizing gameplay, 10+ game mechanics to master and all set in a beautiful minimalist style with ambient adaptive soundtracks, you can enjoy it seated or standing up!\n"}]}, "developer_name": "HEADGEAR GbR", "developer_privacy_policy_url": "https://headgear.io/legal.html", "developer_terms_of_service_url": "https://headgear.io/legal.html#terms", "publisher_name": "HEADGEAR GbR", "support_website_url": null, "website_url": "https://headgear.io/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_categ
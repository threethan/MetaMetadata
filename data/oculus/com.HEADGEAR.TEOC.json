80339049810894_8629917805136921546_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7uSJ22lddOUQ7kNvwHt6Gjf&_nc_oc=Adlgx2CXLpTrJiDFQWjaxz82DO9LcEGJfcgXj-XuRlGguA1joGDfgqdjueQf-rh-mAw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_Afzo1lk7NIrrnLvw5l_CrNRGr40GzibRNTu5eePb78QyYw&oe=69B7E7E3"}, {"file_name": "HighresScreenshot00081.png", "id": "376313343811121", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031312_376313347144454_2073303015962398022_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nGAPb5K5EBYQ7kNvwHkodAv&_nc_oc=AdkRJfoqqgjRwKKic-fw_xy6o9huB3fqA05TNFUvPMWQzEizyMwW0mKtzNZKd3KC6U8&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afzh1-S_bX8w5XobGvNDGU3mTNUreKvKQFwoj1ko-Ht6qQ&oe=69B7E2F7"}, {"file_name": "HighresScreenshot00034.png", "id": "361423311640761", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75297579_361423314974094_4468664441597916853_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oAhdUEId8OcQ7kNvwGxNXnI&_nc_oc=AdkC7ECtckolgA4CWoywe_gdHbE_a4_aD64Alk1fjnCPF1vq15UxPmxmgK71YVetbQY&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfxU24ptTVL5GDtT1fcgDcFKrrmPAKi99IGYlPZDDcFfGQ&oe=69B7E160"}, {"file_name": "consume.png", "id": "356221875528110", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39001669_356221878861443_261896368707707264_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Kyg8Ozr5RXQQ7kNvwEM3ra3&_nc_oc=Admo5JRS8RsPin-6zL9uBXxuOinZQMnL1U_iM_ZRrkDfaE2I8ONubhfvySHhPZt8vAc&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afz_MFXBoDfm4_Zh0sR9oO36y9UobJRZCzOm6HgvcYyWew&oe=69B80603"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "38982553_2716489995261681_7852865887418274915_n[1].png", "id": "1017968672039348", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974845_1017968675372681_3537640423345626257_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=05W6PYPmSKwQ7kNvwGS7sNM&_nc_oc=Adk_76kr_pb73gQlFY_ccCLl4Sw6BPeehoCNAworWosfjg8cOB-idZiafLFVLv2mwAs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_Afy4puQ9VuJGrjTBBfVdsS6ZNxjEctX3niETIfp7_bVUyw&oe=69B7E706"}, "display_name": "TEOC", "keywords": ["arcade", "puzzle", "casual", "atmospheric", "puzzler"], "long_description": "Evolve from an atomic state to marine-life in this spatial arcade puzzler with just one goal: Consume or be Consumed! \n\nPowered by elemental forces and mythical artifacts navigate your way through 3 environments with 30+ rounds each to get through. Will you be able to top the leaderboard for each of these? \n\nTEOC provides\u2026\n\u2022 more than 5 hours of mesmerizing gameplay,\n\u2022 a beautiful minimalist style with ambient adaptive soundtracks,\n\u2022 10+ game mechanics to master,\n\u2022 additional powerups to collect and use across all 90+ rounds\n\u2022 with daily powerup rewards for coming back\n\u2022 to compete on the 3 leaderboards,\n\u2022 increasingly challenging level design all procedurally generated\n\u2022 and seated or standing play options!\n\n\n", "short_description": "Evolve from an atomic state to marine-life in this spatial arcade puzzler with just one goal: Consume or be Consumed! \n\nPowered by elemental forces and mythical artifacts navigate your way through 3 environments with 30+ rounds each to get through. Will you be able to top the leaderboard for each of these? With >5 hours of mesmerizing gameplay, 10+ game mechanics to master and all set in a beautiful minimalist style with ambient adaptive soundtracks, you can enjoy it seated or standing up!\n"}]}, "developer_name": "HEADGEAR GbR", "developer_privacy_policy_url": "https://headgear.io/legal.html", "developer_terms_of_service_url": "https://headgear.io/legal.html#terms", "publisher_name": "HEADGEAR GbR", "support_website_url": null, "website_url": "https://headgear.io/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscrip
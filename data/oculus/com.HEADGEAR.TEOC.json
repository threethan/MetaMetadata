cdn.com/v/t64.5771-25/75361355_380339049810894_8629917805136921546_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z8nghZnQGc8Q7kNvwGUCOnr&_nc_oc=AdoxvlYzLgwR6EXyGZ9t8h8cfsh_2yXQTxwGzx6uUzgdl2DLGToDCVea2XRh3JCNszw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af41BZHLXHTrhE5_NZQ9GvWxvpcY7mZKniFQdkUPboES3w&oe=6A0B2EA3"}, {"file_name": "HighresScreenshot00081.png", "id": "376313343811121", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031312_376313347144454_2073303015962398022_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PtL9Rkk0W3AQ7kNvwEk3L5x&_nc_oc=Adpb94AFrbuqKJz_Il_1kZg-DkDFscF_mtof6Ys923w9MDNbrcV-jcBs15B-N76qUrg&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4e3Hkj-DPqbonKUPVAIy0pqqwsYGisYpEQeTrUn0XVmw&oe=6A0B29B7"}, {"file_name": "HighresScreenshot00034.png", "id": "361423311640761", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75297579_361423314974094_4468664441597916853_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MiO9L9PTMFwQ7kNvwF9R7Nb&_nc_oc=AdqvPTNdiFKS_fqwWaIM6B9AIr9UJeWnKjifwM96nkt99HtURBchxMAaaz1myMcbXNo&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af79mqEdnlvuIcK-7KuF27gfl2nn3gnTTkgOe6oVH1TTwg&oe=6A0B2820"}, {"file_name": "consume.png", "id": "356221875528110", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39001669_356221878861443_261896368707707264_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g973n9gIZT4Q7kNvwEknDgp&_nc_oc=AdqBVQ1Q8pSHrcdKhsaRQK2oRKjHd4sc8sINUmJL4x8HHH1XGxpYCGyaSMXJ2U2T_5o&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af74nDf71pQ9GO37wxaKMH9No_-WuzI_YlzxZI7dnMPrAw&oe=6A0B1483"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "38982553_2716489995261681_7852865887418274915_n[1].png", "id": "1017968672039348", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974845_1017968675372681_3537640423345626257_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z2ys9S22WosQ7kNvwEIWEha&_nc_oc=AdpqkU2NuDrbM0NgX3eC9PvvGk1kVB0QzqqtyjHRjOa-fSab1JjWjfYvL842nQkuoB4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4m5t2nYUftj63WMVIaOewZq8MMEf3cBAaFo7y6rHRJNQ&oe=6A0B2DC6"}, "display_name": "TEOC", "keywords": ["arcade", "puzzle", "casual", "atmospheric", "puzzler"], "long_description": "Evolve from an atomic state to marine-life in this spatial arcade puzzler with just one goal: Consume or be Consumed! \n\nPowered by elemental forces and mythical artifacts navigate your way through 3 environments with 30+ rounds each to get through. Will you be able to top the leaderboard for each of these? \n\nTEOC provides\u2026\n\u2022 more than 5 hours of mesmerizing gameplay,\n\u2022 a beautiful minimalist style with ambient adaptive soundtracks,\n\u2022 10+ game mechanics to master,\n\u2022 additional powerups to collect and use across all 90+ rounds\n\u2022 with daily powerup rewards for coming back\n\u2022 to compete on the 3 leaderboards,\n\u2022 increasingly challenging level design all procedurally generated\n\u2022 and seated or standing play options!\n\n\n", "short_description": "Evolve from an atomic state to marine-life in this spatial arcade puzzler with just one goal: Consume or be Consumed! \n\nPowered by elemental forces and mythical artifacts navigate your way through 3 environments with 30+ rounds each to get through. Will you be able to top the leaderboard for each of these? With >5 hours of mesmerizing gameplay, 10+ game mechanics to master and all set in a beautiful minimalist style with ambient adaptive soundtracks, you can enjoy it seated or standing up!\n"}]}, "developer_name": "HEADGEAR GbR", "developer_privacy_policy_url": "https://headgear.io/legal.html", "developer_terms_of_service_url": "https://headgear.io/legal.html#terms", "publisher_name": "HEADGEAR GbR", "support_website_url": null, "website_url": "https://headgear.io/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_categ
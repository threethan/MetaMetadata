cdn.com/v/t64.5771-25/75361355_380339049810894_8629917805136921546_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k9VzQ6WK7NUQ7kNvwH_j07K&_nc_oc=AdoDTLB7oeUkRho_d7KjlLJmLiKeMp1YHyflJGtguiVXe4RRAWt7wQMDIhedWiJvuh0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBhmq5PnGUJkcY8BsoZEcACu-TUXZt9BtS_l1B28B-dHA&oe=6A5F5663"}, {"file_name": "HighresScreenshot00081.png", "id": "376313343811121", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031312_376313347144454_2073303015962398022_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZLAMpf3Fha8Q7kNvwH4rutI&_nc_oc=AdoTO02g0cIS2UQJZEGxibAyF260gKt0UX8uvAac-BkBXmnDIJ6xRCOZNGoPFGcol70&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDiE13nstLO5Khcpu6uDCL7g2wFzgRWUX14jhqUAgoGGQ&oe=6A5F89B7"}, {"file_name": "HighresScreenshot00034.png", "id": "361423311640761", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75297579_361423314974094_4468664441597916853_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pPLm5_9mQvAQ7kNvwHtIwDC&_nc_oc=AdquVc_HkJ4h3jSH-o6h4j12GUdnODxUyyhWXsUR5aVyjPaX4pumDYAPJEdsb9A-Jlg&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBaYbp_u4VyLIqgWqEnSBBSLYGZqLd1qz3XWCN6vW9DEA&oe=6A5F8820"}, {"file_name": "consume.png", "id": "356221875528110", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39001669_356221878861443_261896368707707264_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=quuAkUEb_N0Q7kNvwHYz-wF&_nc_oc=Adp032FEZGrM3IE_J6dJusOz-R8pEw3wQ4plqU2e8ftvyibSwUfeb8NnBTn7VNpecEo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCgKqe9IES2VN-x_UF2wpNjBCLkrbXCm0RW3meC8uTN7w&oe=6A5F7483"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "38982553_2716489995261681_7852865887418274915_n[1].png", "id": "1017968672039348", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974845_1017968675372681_3537640423345626257_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1bd8EgjQhisQ7kNvwGTs34a&_nc_oc=Adrhb1g06V_rt83ZpQSBqQ6leLC3Oa4YSSK2EjXRDdbIRI3L8n0KhR_2z805wxvdWR4&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBFqYqIg2RF-Jpf-1Y2sAOZ01OZOVCMNpEhMZVHEBtqbA&oe=6A5F5586"}, "display_name": "TEOC", "keywords": ["arcade", "puzzle", "casual", "atmospheric", "puzzler"], "long_description": "Evolve from an atomic state to marine-life in this spatial arcade puzzler with just one goal: Consume or be Consumed! \n\nPowered by elemental forces and mythical artifacts navigate your way through 3 environments with 30+ rounds each to get through. Will you be able to top the leaderboard for each of these? \n\nTEOC provides\u2026\n\u2022 more than 5 hours of mesmerizing gameplay,\n\u2022 a beautiful minimalist style with ambient adaptive soundtracks,\n\u2022 10+ game mechanics to master,\n\u2022 additional powerups to collect and use across all 90+ rounds\n\u2022 with daily powerup rewards for coming back\n\u2022 to compete on the 3 leaderboards,\n\u2022 increasingly challenging level design all procedurally generated\n\u2022 and seated or standing play options!\n\n\n", "short_description": "Evolve from an atomic state to marine-life in this spatial arcade puzzler with just one goal: Consume or be Consumed! \n\nPowered by elemental forces and mythical artifacts navigate your way through 3 environments with 30+ rounds each to get through. Will you be able to top the leaderboard for each of these? With >5 hours of mesmerizing gameplay, 10+ game mechanics to master and all set in a beautiful minimalist style with ambient adaptive soundtracks, you can enjoy it seated or standing up!\n"}]}, "developer_name": "HEADGEAR GbR", "developer_privacy_policy_url": "https://headgear.io/legal.html", "developer_terms_of_service_url": "https://headgear.io/legal.html#terms", "publisher_name": "HEADGEAR GbR", "support_website_url": null, "website_url": "https://headgear.io/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_categ
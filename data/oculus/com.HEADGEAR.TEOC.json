cdn.com/v/t64.5771-25/75361355_380339049810894_8629917805136921546_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OgzDplN2cd4Q7kNvwHfe53A&_nc_oc=AdqquXEZHA9RuGlUYEW4yFMyofdYwyP9tG4wwJU_lwgh4y-qbnZ0nu_YocwmeVm4JrA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9XbPljb1iSt9_Ot8qPtKk5UBY7qg1nmUNOf7oJtAsYqw&oe=6A3801A3"}, {"file_name": "HighresScreenshot00081.png", "id": "376313343811121", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031312_376313347144454_2073303015962398022_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wt9dnGqTO2QQ7kNvwGeWehM&_nc_oc=AdojQW5siNACobgNnOavJD57cesgZaer5tTQ6jGVZ3NESAf9YyBfZA104W_6-6HhWrY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af--DN4Q8bUXp45aKB4Xkjag5GIMF5ukDPyOaTg_c9TgzA&oe=6A37FCB7"}, {"file_name": "HighresScreenshot00034.png", "id": "361423311640761", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75297579_361423314974094_4468664441597916853_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uSvSKW-cE78Q7kNvwE0j96D&_nc_oc=Adq7wo4pYYL8DGY6y5yifx_ilmBzm2ECUneEyXmNgAoU1iKEkTYfNbMjZruxiOaADi8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-LBhMgxHnMWJD5vBT_ozJF_gis5sKfeJCR45PJU5zFzw&oe=6A37FB20"}, {"file_name": "consume.png", "id": "356221875528110", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39001669_356221878861443_261896368707707264_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Q_kLe4iZ9gUQ7kNvwHMqYOj&_nc_oc=Ado3ma2_5td_rS7zQlbCo1jBFeT4Z4g8drefKdaOZpgB8yELcqn_o8EzBHDgjXz81qg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8ojKQ3nK9X6zgFbmEs_7RU_zaxgCM0_SJ14tqKV3xVxA&oe=6A37E783"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "38982553_2716489995261681_7852865887418274915_n[1].png", "id": "1017968672039348", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974845_1017968675372681_3537640423345626257_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oXOos-poBw8Q7kNvwEK74b4&_nc_oc=Adom_2Y8jyScsDpzOmDv-hoWPftkfoq4WNaAT7RJU6aAVL4QAaHAmdyXWry7fvhEo5k&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9jsihkY9_D_9POV-ZZHdyY0DZIuoGC3roiM93xd8CnXA&oe=6A3800C6"}, "display_name": "TEOC", "keywords": ["arcade", "puzzle", "casual", "atmospheric", "puzzler"], "long_description": "Evolve from an atomic state to marine-life in this spatial arcade puzzler with just one goal: Consume or be Consumed! \n\nPowered by elemental forces and mythical artifacts navigate your way through 3 environments with 30+ rounds each to get through. Will you be able to top the leaderboard for each of these? \n\nTEOC provides\u2026\n\u2022 more than 5 hours of mesmerizing gameplay,\n\u2022 a beautiful minimalist style with ambient adaptive soundtracks,\n\u2022 10+ game mechanics to master,\n\u2022 additional powerups to collect and use across all 90+ rounds\n\u2022 with daily powerup rewards for coming back\n\u2022 to compete on the 3 leaderboards,\n\u2022 increasingly challenging level design all procedurally generated\n\u2022 and seated or standing play options!\n\n\n", "short_description": "Evolve from an atomic state to marine-life in this spatial arcade puzzler with just one goal: Consume or be Consumed! \n\nPowered by elemental forces and mythical artifacts navigate your way through 3 environments with 30+ rounds each to get through. Will you be able to top the leaderboard for each of these? With >5 hours of mesmerizing gameplay, 10+ game mechanics to master and all set in a beautiful minimalist style with ambient adaptive soundtracks, you can enjoy it seated or standing up!\n"}]}, "developer_name": "HEADGEAR GbR", "developer_privacy_policy_url": "https://headgear.io/legal.html", "developer_terms_of_service_url": "https://headgear.io/legal.html#terms", "publisher_name": "HEADGEAR GbR", "support_website_url": null, "website_url": "https://headgear.io/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_categ
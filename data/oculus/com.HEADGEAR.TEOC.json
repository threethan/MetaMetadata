cdn.com/v/t64.5771-25/75361355_380339049810894_8629917805136921546_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V8gYDdPy7zIQ7kNvwEwuIqf&_nc_oc=AdqvAsDP10y6HYx7bJSfvUbIaapdc7KJAyiXFEqUDklcF72K_3aWJoaoSsS9BQ989vs&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4tdPSLUKuXSzeO1mb_Df5FwSkdfhEzwWZX-Dsgr7IF5Q&oe=6A0F2323"}, {"file_name": "HighresScreenshot00081.png", "id": "376313343811121", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/39031312_376313347144454_2073303015962398022_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0eLXEs16agcQ7kNvwGW5omY&_nc_oc=AdoMufxhu9STfxx4ky0E63okGJzrm_5aeO_JDCA8I-fb0BVwKeYpLHNisRRf0liUQ14&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6s-UBEqlGPI9RCvasffEs_zOD3va6bKxAO2vvcq9gWew&oe=6A0F1E37"}, {"file_name": "HighresScreenshot00034.png", "id": "361423311640761", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/75297579_361423314974094_4468664441597916853_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S5Y8S0QLWvkQ7kNvwGAgs3D&_nc_oc=AdqTUbCrcCKBd1aePPWhVdnLCk4jzdYesDydjePVONuticU_sfpHASe-FXJspQvXLR0&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6lF2bVKAPFmCaXNZ_aHLPoQNkXxGnemyLmMClmwmcaqw&oe=6A0F1CA0"}, {"file_name": "consume.png", "id": "356221875528110", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/39001669_356221878861443_261896368707707264_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GOrJvtyLC4gQ7kNvwFfIcXn&_nc_oc=AdqU1m1U8H-T-9dz0G7T-RF1cx_MpW_pwtwPWqOO1LWAqwf-k_sFhGvFvU0ns_SeoY0&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5wlM_DbRgnBOX9EdLNAHeM41Yxh6N4amF_N_Q1n6lkqw&oe=6A0F0903"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "38982553_2716489995261681_7852865887418274915_n[1].png", "id": "1017968672039348", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974845_1017968675372681_3537640423345626257_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GzjQeHJCvSkQ7kNvwEd0Ety&_nc_oc=AdqPAEEmDsnab2r-qmyFjXEZgDXCB6HjgUzyYHlv7RHEhMGZ5D_7m3pUEKv_YQzAa30&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5V3hKW8NBT-G9MSqT74ggbsGsoKRf1fJjRodP_BWk5vQ&oe=6A0F2246"}, "display_name": "TEOC", "keywords": ["arcade", "puzzle", "casual", "atmospheric", "puzzler"], "long_description": "Evolve from an atomic state to marine-life in this spatial arcade puzzler with just one goal: Consume or be Consumed! \n\nPowered by elemental forces and mythical artifacts navigate your way through 3 environments with 30+ rounds each to get through. Will you be able to top the leaderboard for each of these? \n\nTEOC provides\u2026\n\u2022 more than 5 hours of mesmerizing gameplay,\n\u2022 a beautiful minimalist style with ambient adaptive soundtracks,\n\u2022 10+ game mechanics to master,\n\u2022 additional powerups to collect and use across all 90+ rounds\n\u2022 with daily powerup rewards for coming back\n\u2022 to compete on the 3 leaderboards,\n\u2022 increasingly challenging level design all procedurally generated\n\u2022 and seated or standing play options!\n\n\n", "short_description": "Evolve from an atomic state to marine-life in this spatial arcade puzzler with just one goal: Consume or be Consumed! \n\nPowered by elemental forces and mythical artifacts navigate your way through 3 environments with 30+ rounds each to get through. Will you be able to top the leaderboard for each of these? With >5 hours of mesmerizing gameplay, 10+ game mechanics to master and all set in a beautiful minimalist style with ambient adaptive soundtracks, you can enjoy it seated or standing up!\n"}]}, "developer_name": "HEADGEAR GbR", "developer_privacy_policy_url": "https://headgear.io/legal.html", "developer_terms_of_service_url": "https://headgear.io/legal.html#terms", "publisher_name": "HEADGEAR GbR", "support_website_url": null, "website_url": "https://headgear.io/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_categ
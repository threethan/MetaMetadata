cdn.com/v/t64.5771-25/75361355_380339049810894_8629917805136921546_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=szD3AQyi5JAQ7kNvwH2jxXk&_nc_oc=AdrsNjJg1pL6XhtcFX67FMr798J-Ff8sa14FoPGUejb1b5oFcYE6eJp5pIfPHMEko4M&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8KVJYzkTqCv_NUBbSfwjbJOX95kyemdIT6QfzQWZKsHg&oe=6A43DF23"}, {"file_name": "HighresScreenshot00081.png", "id": "376313343811121", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031312_376313347144454_2073303015962398022_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_GypYG9h-WkQ7kNvwHdd7a1&_nc_oc=AdoVrJoStBlgtkt8g0PGzv9JrzzdT-1Y0lA8scEG3szcpygcx4ViFaL7hMOvlwXP5F8&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9pa4hzKXKzBJ2Ligh_BDRfsrXKPNU5HWBbdGPKSa9FaQ&oe=6A43DA37"}, {"file_name": "HighresScreenshot00034.png", "id": "361423311640761", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75297579_361423314974094_4468664441597916853_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zyCfEraNSIgQ7kNvwECjZIw&_nc_oc=AdpdfiQDxoHnJbJMdD7ChkfLAnSaCfqSuNOrQQ6yYlYxBJOTFWq1nNvXZaEhTWUlCHk&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9U_OB0GNJm_2_QUetBqHs4JBclvnBhcfUvWqEMvYNPNg&oe=6A43D8A0"}, {"file_name": "consume.png", "id": "356221875528110", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39001669_356221878861443_261896368707707264_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vJzjIaLS_4gQ7kNvwHB4hx5&_nc_oc=AdpjcI1e9L0URKI-qXJqO5AyJH14OX9-aEY_BlHu3fLi2eHe38-JAHYEG2aCJdTDQao&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-m5zqKZrnmqS9rA1YuKsl10quCKvlvLnns2yFPEGmDRA&oe=6A43C503"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "38982553_2716489995261681_7852865887418274915_n[1].png", "id": "1017968672039348", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974845_1017968675372681_3537640423345626257_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F6LZIaXWIYoQ7kNvwG8Xdqd&_nc_oc=AdpK5i9LvRjlIw60j_4nMjaMHDPwrTaoVlpuVi17HEqdV2xu-wwIjiKv7xn-QvoJHbE&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8KRzsUOoC0iYJ8no42CUY5wXUzJGn0774mk-bOVYhAhw&oe=6A43DE46"}, "display_name": "TEOC", "keywords": ["arcade", "puzzle", "casual", "atmospheric", "puzzler"], "long_description": "Evolve from an atomic state to marine-life in this spatial arcade puzzler with just one goal: Consume or be Consumed! \n\nPowered by elemental forces and mythical artifacts navigate your way through 3 environments with 30+ rounds each to get through. Will you be able to top the leaderboard for each of these? \n\nTEOC provides\u2026\n\u2022 more than 5 hours of mesmerizing gameplay,\n\u2022 a beautiful minimalist style with ambient adaptive soundtracks,\n\u2022 10+ game mechanics to master,\n\u2022 additional powerups to collect and use across all 90+ rounds\n\u2022 with daily powerup rewards for coming back\n\u2022 to compete on the 3 leaderboards,\n\u2022 increasingly challenging level design all procedurally generated\n\u2022 and seated or standing play options!\n\n\n", "short_description": "Evolve from an atomic state to marine-life in this spatial arcade puzzler with just one goal: Consume or be Consumed! \n\nPowered by elemental forces and mythical artifacts navigate your way through 3 environments with 30+ rounds each to get through. Will you be able to top the leaderboard for each of these? With >5 hours of mesmerizing gameplay, 10+ game mechanics to master and all set in a beautiful minimalist style with ambient adaptive soundtracks, you can enjoy it seated or standing up!\n"}]}, "developer_name": "HEADGEAR GbR", "developer_privacy_policy_url": "https://headgear.io/legal.html", "developer_terms_of_service_url": "https://headgear.io/legal.html#terms", "publisher_name": "HEADGEAR GbR", "support_website_url": null, "website_url": "https://headgear.io/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_categ
cdn.com/v/t64.5771-25/75361355_380339049810894_8629917805136921546_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HEsVvHdO7K0Q7kNvwF_VYrc&_nc_oc=Adq57coVbGAtab1n2RRt6RDxv5J_E-K6ZAXhj_DdGNQHEN7nW7RbnZ2jJRFMzd-GGdc&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7xSwZKfNYuiB_m1aoMZ4uEpZyMRYXT_pGz9MkEwzToNQ&oe=6A1B00A3"}, {"file_name": "HighresScreenshot00081.png", "id": "376313343811121", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/39031312_376313347144454_2073303015962398022_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=POQFPGr9lksQ7kNvwFcw0Ho&_nc_oc=AdrCLRSN_I6D8P-FqxTcEG3e7KUuelLlbexcNbKRk5q_G2w4UkIXGpgCzvD1UFiv5mE&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5XKJP9L0N1wZQ-2nKZ2gkA5La4va969uCL8GqaNjSsQw&oe=6A1AFBB7"}, {"file_name": "HighresScreenshot00034.png", "id": "361423311640761", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/75297579_361423314974094_4468664441597916853_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j6EXEsaUWyUQ7kNvwGozQ4Y&_nc_oc=AdqcE_4zTPwCfMl9vbHsmnld5HKZoUnqQVfl_yKPaMB5e0okNkRlGoh0xe87PjLDc18&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4pVp8bRy0D2iRjRd0_yHAfHIQn9QX1ocue-K3B9zHTkQ&oe=6A1AFA20"}, {"file_name": "consume.png", "id": "356221875528110", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/39001669_356221878861443_261896368707707264_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8ITZtOsZxHAQ7kNvwF75yNQ&_nc_oc=Adp9ttfFAkbkQV9F79W1a0-f54c0b9xiac7XAExtdclkSvKBXBVrpfpVugHTBakFQto&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4mAszjhZbBWsdSNPC48O36MQ6sdmIT8csxShIAEk_CkA&oe=6A1AE683"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "38982553_2716489995261681_7852865887418274915_n[1].png", "id": "1017968672039348", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/38974845_1017968675372681_3537640423345626257_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EAJMF6sChNgQ7kNvwEtqfte&_nc_oc=AdpMgfkMVdU5m8DpmDj9kxHTTGn9pjc_kz5D6QXD_zo7eyzg2uJq2MeqOaMTkGd8THE&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4pNPm3Lgl6K8MEOr0-tAkhX0_YYVCEHnIGs3ogESKeGg&oe=6A1AFFC6"}, "display_name": "TEOC", "keywords": ["arcade", "puzzle", "casual", "atmospheric", "puzzler"], "long_description": "Evolve from an atomic state to marine-life in this spatial arcade puzzler with just one goal: Consume or be Consumed! \n\nPowered by elemental forces and mythical artifacts navigate your way through 3 environments with 30+ rounds each to get through. Will you be able to top the leaderboard for each of these? \n\nTEOC provides\u2026\n\u2022 more than 5 hours of mesmerizing gameplay,\n\u2022 a beautiful minimalist style with ambient adaptive soundtracks,\n\u2022 10+ game mechanics to master,\n\u2022 additional powerups to collect and use across all 90+ rounds\n\u2022 with daily powerup rewards for coming back\n\u2022 to compete on the 3 leaderboards,\n\u2022 increasingly challenging level design all procedurally generated\n\u2022 and seated or standing play options!\n\n\n", "short_description": "Evolve from an atomic state to marine-life in this spatial arcade puzzler with just one goal: Consume or be Consumed! \n\nPowered by elemental forces and mythical artifacts navigate your way through 3 environments with 30+ rounds each to get through. Will you be able to top the leaderboard for each of these? With >5 hours of mesmerizing gameplay, 10+ game mechanics to master and all set in a beautiful minimalist style with ambient adaptive soundtracks, you can enjoy it seated or standing up!\n"}]}, "developer_name": "HEADGEAR GbR", "developer_privacy_policy_url": "https://headgear.io/legal.html", "developer_terms_of_service_url": "https://headgear.io/legal.html#terms", "publisher_name": "HEADGEAR GbR", "support_website_url": null, "website_url": "https://headgear.io/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_categ
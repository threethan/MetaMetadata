cdn.com/v/t64.5771-25/75361355_380339049810894_8629917805136921546_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3DXlXLnT7vMQ7kNvwHuLU4Q&_nc_oc=Adp3PCQYIavrPV0IxcwslrGzgt9pd0e1Ua40hHEzd7Ti-fMFVI_3tjFoTP7Yttr1fgM&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPMPI4psJk5wPfeLllBDFBte3puOqBatpkixHnWsTmqVQ&oe=6ACF9E23"}, {"file_name": "HighresScreenshot00081.png", "id": "376313343811121", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031312_376313347144454_2073303015962398022_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PKSimz_XrZsQ7kNvwEjy2K4&_nc_oc=AdpYRfDjXfPp0zHxlxgIkRZvA5OLTXPsUBEojmw5XR6_djFZGAbt8ym8FlJ3pqjSjvk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM79A6mNwAk1gbRl9RTeYyzTrrCacXcD7ML2Ce2ZDNPiA&oe=6ACF9937"}, {"file_name": "HighresScreenshot00034.png", "id": "361423311640761", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75297579_361423314974094_4468664441597916853_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BOJlzznti2oQ7kNvwEKfb2T&_nc_oc=Ado2yKTnnl4BJ4y1Kfe3Yaxwk-a-xgsIZOqXufji1SUJ7my9OEHq-bpO_8mozbJHvEo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMN1Whb95VtAgNNreQN_mEW65Qfv-7SLbgpuJzrlMkj3w&oe=6ACF97A0"}, {"file_name": "consume.png", "id": "356221875528110", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39001669_356221878861443_261896368707707264_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V023mOICNKEQ7kNvwGs7Lfh&_nc_oc=Adr5DH0DlutrW-qyyzRMv6i4nEMdy-c-V0aL9FhR0B0Yijf7kCDjAqq2953dDiEXwnk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO_TJ6rE21ssYGpEpsuFygkQdrMjyzLh0aj7_RpL7T7qA&oe=6ACF8403"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "38982553_2716489995261681_7852865887418274915_n[1].png", "id": "1017968672039348", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974845_1017968675372681_3537640423345626257_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CYDIbzCXlDoQ7kNvwEPuwb9&_nc_oc=Adq5Hd7sDvrsMrptZTOVaKQAo4jS3crHLp73cAEkzuYNEKCGdkCshDlhP0y41DoFs0Y&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMtc1axKre_IyGID0kmLbr2U1GDhXRIGDuWwDKwI-NIOg&oe=6ACF9D46"}, "display_name": "TEOC", "keywords": ["arcade", "puzzle", "casual", "atmospheric", "puzzler"], "long_description": "Evolve from an atomic state to marine-life in this spatial arcade puzzler with just one goal: Consume or be Consumed! \n\nPowered by elemental forces and mythical artifacts navigate your way through 3 environments with 30+ rounds each to get through. Will you be able to top the leaderboard for each of these? \n\nTEOC provides\u2026\n\u2022 more than 5 hours of mesmerizing gameplay,\n\u2022 a beautiful minimalist style with ambient adaptive soundtracks,\n\u2022 10+ game mechanics to master,\n\u2022 additional powerups to collect and use across all 90+ rounds\n\u2022 with daily powerup rewards for coming back\n\u2022 to compete on the 3 leaderboards,\n\u2022 increasingly challenging level design all procedurally generated\n\u2022 and seated or standing play options!\n\n\n", "short_description": "Evolve from an atomic state to marine-life in this spatial arcade puzzler with just one goal: Consume or be Consumed! \n\nPowered by elemental forces and mythical artifacts navigate your way through 3 environments with 30+ rounds each to get through. Will you be able to top the leaderboard for each of these? With >5 hours of mesmerizing gameplay, 10+ game mechanics to master and all set in a beautiful minimalist style with ambient adaptive soundtracks, you can enjoy it seated or standing up!\n"}]}, "developer_name": "HEADGEAR GbR", "developer_privacy_policy_url": "https://headgear.io/legal.html", "developer_terms_of_service_url": "https://headgear.io/legal.html#terms", "publisher_name": "HEADGEAR GbR", "support_website_url": null, "website_url": "https://headgear.io/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_categ
cdn.com/v/t64.5771-25/75361355_380339049810894_8629917805136921546_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=haPEHUGz_GoQ7kNvwFswJio&_nc_oc=AdoVAwC4r02Qf50mg_aVOBvxSgQvuI1C4OuAOdrxt6DBsJXomCa_u93oKCkTdUrrD-0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE669i3lNcdN5653ho6v8ess1v-iqcxeTIWaw-hcGLesg&oe=6A79B463"}, {"file_name": "HighresScreenshot00081.png", "id": "376313343811121", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031312_376313347144454_2073303015962398022_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eY2USWSp7EAQ7kNvwFgXC0N&_nc_oc=AdoMjh5BLwKsiWicgskBaYRIlkwUSqZToETMIYFSetrRojJFYyvFSOhVsBYBAB9SN3A&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEugJOhRtC_zynAd3Tkrdn8aJMPSStfB6UYCAyURObovA&oe=6A79AF77"}, {"file_name": "HighresScreenshot00034.png", "id": "361423311640761", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75297579_361423314974094_4468664441597916853_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pwwPNZ9MyGIQ7kNvwGOjHoa&_nc_oc=Adoeg7IES0ksE5HNW8-6QWaAZQjQt_wJPm0Q6h3mNigfuH9FxBZkoA8vyJ6aLBZYmdE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGbr9mZmbhKQ6wzNHX1qx3LuIQKsNWrCvNYisFxZF_6Cw&oe=6A79E620"}, {"file_name": "consume.png", "id": "356221875528110", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39001669_356221878861443_261896368707707264_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qYb9zbaT58UQ7kNvwF3Kd9u&_nc_oc=AdoPxMLEhU7PzHyJUX7U75tclI5KXNxUuw6ygEoW8OFpugBgWb90L9cq5ovuzYbXIH0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEVR9jFUQHHrsuWz-3B3PZGxDtiKAiZZfuLacw16KOlXw&oe=6A79D283"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "38982553_2716489995261681_7852865887418274915_n[1].png", "id": "1017968672039348", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974845_1017968675372681_3537640423345626257_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d9CIdbkHSVwQ7kNvwGnTRcy&_nc_oc=AdrSry_FLQFb7pBbsSDUeW5Pr0TnIkGMEfxzDaSKTrI4xk8LkSXpbnO9hYOdtqvTAps&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFyItkest9Hr-VC7Tsh36NpsDrzUEuhMhBWZCFMJCbCZg&oe=6A79B386"}, "display_name": "TEOC", "keywords": ["arcade", "puzzle", "casual", "atmospheric", "puzzler"], "long_description": "Evolve from an atomic state to marine-life in this spatial arcade puzzler with just one goal: Consume or be Consumed! \n\nPowered by elemental forces and mythical artifacts navigate your way through 3 environments with 30+ rounds each to get through. Will you be able to top the leaderboard for each of these? \n\nTEOC provides\u2026\n\u2022 more than 5 hours of mesmerizing gameplay,\n\u2022 a beautiful minimalist style with ambient adaptive soundtracks,\n\u2022 10+ game mechanics to master,\n\u2022 additional powerups to collect and use across all 90+ rounds\n\u2022 with daily powerup rewards for coming back\n\u2022 to compete on the 3 leaderboards,\n\u2022 increasingly challenging level design all procedurally generated\n\u2022 and seated or standing play options!\n\n\n", "short_description": "Evolve from an atomic state to marine-life in this spatial arcade puzzler with just one goal: Consume or be Consumed! \n\nPowered by elemental forces and mythical artifacts navigate your way through 3 environments with 30+ rounds each to get through. Will you be able to top the leaderboard for each of these? With >5 hours of mesmerizing gameplay, 10+ game mechanics to master and all set in a beautiful minimalist style with ambient adaptive soundtracks, you can enjoy it seated or standing up!\n"}]}, "developer_name": "HEADGEAR GbR", "developer_privacy_policy_url": "https://headgear.io/legal.html", "developer_terms_of_service_url": "https://headgear.io/legal.html#terms", "publisher_name": "HEADGEAR GbR", "support_website_url": null, "website_url": "https://headgear.io/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_categ
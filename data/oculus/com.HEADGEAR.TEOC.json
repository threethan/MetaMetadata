cdn.com/v/t64.5771-25/75361355_380339049810894_8629917805136921546_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IUgoxqcJtDMQ7kNvwG5gJX_&_nc_oc=Adq9MqGoCtTArnlWjwEx25HRWqiP9nLkwgCM3XjiiTRWS3_YbZLlm1fqO_pN5cjGREw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1VZHvDX9Ag8JNLbk2fLWHnJTReyaTovn9zoGU3whHtDQ&oe=69D39763"}, {"file_name": "HighresScreenshot00081.png", "id": "376313343811121", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031312_376313347144454_2073303015962398022_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sQZkOuWnqzcQ7kNvwEqplb9&_nc_oc=AdqdQs1w_z_0NlUUalqjYf7TEdMdvqabqj5PM3UOA8t0v_Bs6TbUXl9V1OEK-zGLT_U&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1LQGzIXlKz33pzwTd_QG2KABjjp9e8bulD31K2Ya3ikw&oe=69D39277"}, {"file_name": "HighresScreenshot00034.png", "id": "361423311640761", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75297579_361423314974094_4468664441597916853_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5EQMKOWBiC8Q7kNvwHVT_FT&_nc_oc=AdpYwkb-mp8iinyWIOzmj4jk1MSXYVS1HdrJ-whlngB90kwvED4bUCmGHQSUNv07vZc&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af36R2CUcQnBb-r3dCCi0VVMaAvdT0coPgueMqBg2s8_6g&oe=69D390E0"}, {"file_name": "consume.png", "id": "356221875528110", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39001669_356221878861443_261896368707707264_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HSevoP8Af3sQ7kNvwEDL5zM&_nc_oc=AdrC4QzKzDMXinDaAtL7Ei_pxGod-hhWyBucuPjBwv9AE4BmXmeNKJVy4cfzPHlcZDg&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3bxdhkrGnHcXxF-6Fx93zUVovCXbiVR4Sf60Gr9T5K3Q&oe=69D3B583"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "38982553_2716489995261681_7852865887418274915_n[1].png", "id": "1017968672039348", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974845_1017968675372681_3537640423345626257_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I6JwX5kUHm4Q7kNvwH9IJn5&_nc_oc=AdoanP434_0SD8ZlVLQti2PNO6A8npEux911HbumIpS1ZtQE6bawn4OWUs-0XRlEWhw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2R7Dmnecip7Q6Oro_JaRjTINXD3i3PwsWJMWd7jZiOLw&oe=69D39686"}, "display_name": "TEOC", "keywords": ["arcade", "puzzle", "casual", "atmospheric", "puzzler"], "long_description": "Evolve from an atomic state to marine-life in this spatial arcade puzzler with just one goal: Consume or be Consumed! \n\nPowered by elemental forces and mythical artifacts navigate your way through 3 environments with 30+ rounds each to get through. Will you be able to top the leaderboard for each of these? \n\nTEOC provides\u2026\n\u2022 more than 5 hours of mesmerizing gameplay,\n\u2022 a beautiful minimalist style with ambient adaptive soundtracks,\n\u2022 10+ game mechanics to master,\n\u2022 additional powerups to collect and use across all 90+ rounds\n\u2022 with daily powerup rewards for coming back\n\u2022 to compete on the 3 leaderboards,\n\u2022 increasingly challenging level design all procedurally generated\n\u2022 and seated or standing play options!\n\n\n", "short_description": "Evolve from an atomic state to marine-life in this spatial arcade puzzler with just one goal: Consume or be Consumed! \n\nPowered by elemental forces and mythical artifacts navigate your way through 3 environments with 30+ rounds each to get through. Will you be able to top the leaderboard for each of these? With >5 hours of mesmerizing gameplay, 10+ game mechanics to master and all set in a beautiful minimalist style with ambient adaptive soundtracks, you can enjoy it seated or standing up!\n"}]}, "developer_name": "HEADGEAR GbR", "developer_privacy_policy_url": "https://headgear.io/legal.html", "developer_terms_of_service_url": "https://headgear.io/legal.html#terms", "publisher_name": "HEADGEAR GbR", "support_website_url": null, "website_url": "https://headgear.io/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_categ
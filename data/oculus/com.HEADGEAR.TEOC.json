80339049810894_8629917805136921546_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=puE34yMf5xAQ7kNvwF46Faf&_nc_oc=Adkjwx-7eObH-tiZdlBZ3DU7Aitl4T23K6EZ-5K7nlbn3If5ALkTov_dMYYXH3thrJs&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfwCPqbskOgMThmtzhq0k69RHVmiMqsQv6gVCC129pPxUQ&oe=69BFD0E3"}, {"file_name": "HighresScreenshot00081.png", "id": "376313343811121", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031312_376313347144454_2073303015962398022_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kdEjRLNaRugQ7kNvwHunwwe&_nc_oc=Adk33D1sNcV-DAR3ojj1QFKgnYRg48jNP1aX1UsuvblYZA9-aVVloekt8vcEyJZPx3I&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfxrXopX7-PbH8hAEbjnCLG98TbsxFnoNWAjG8hxkYYkaQ&oe=69BFCBF7"}, {"file_name": "HighresScreenshot00034.png", "id": "361423311640761", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75297579_361423314974094_4468664441597916853_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9D8hbaCUwTYQ7kNvwHA6-GC&_nc_oc=AdnhL8zbfvvvzHtoIte99Qs-Elmv85L7vfRxeChdOOqTmTLN_qDtECv_o2X6vsx7_rU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_Afwh-bZMn2qxjoAqFbGjdD3beZv2lYPOc2isTvxEwjAL2g&oe=69BFCA60"}, {"file_name": "consume.png", "id": "356221875528110", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39001669_356221878861443_261896368707707264_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IJB9wvGgmegQ7kNvwFWmJ55&_nc_oc=AdlRT-6alIEaiP3pjgdVHktXJHZvl23PE9uXjh24r7uS4PzTTuu5IGXjGTZR9FXIiBE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfzvvBNwrylC7_IxAGg40onKGtRJguAXhC2oKcj1EeUMgw&oe=69BFEF03"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "38982553_2716489995261681_7852865887418274915_n[1].png", "id": "1017968672039348", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974845_1017968675372681_3537640423345626257_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VZ1hp40gmV8Q7kNvwHsYyqA&_nc_oc=AdmRft7RAIlpkZ-x6ZVdOUFEVI8fnzxt8XGKHwkQftQmAQYBsGINVCQj37xzkY7iXDQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfyLWnMlZscnFw4bg8QgIncPTjD3YTuCmEgzIlIhrcWNIw&oe=69BFD006"}, "display_name": "TEOC", "keywords": ["arcade", "puzzle", "casual", "atmospheric", "puzzler"], "long_description": "Evolve from an atomic state to marine-life in this spatial arcade puzzler with just one goal: Consume or be Consumed! \n\nPowered by elemental forces and mythical artifacts navigate your way through 3 environments with 30+ rounds each to get through. Will you be able to top the leaderboard for each of these? \n\nTEOC provides\u2026\n\u2022 more than 5 hours of mesmerizing gameplay,\n\u2022 a beautiful minimalist style with ambient adaptive soundtracks,\n\u2022 10+ game mechanics to master,\n\u2022 additional powerups to collect and use across all 90+ rounds\n\u2022 with daily powerup rewards for coming back\n\u2022 to compete on the 3 leaderboards,\n\u2022 increasingly challenging level design all procedurally generated\n\u2022 and seated or standing play options!\n\n\n", "short_description": "Evolve from an atomic state to marine-life in this spatial arcade puzzler with just one goal: Consume or be Consumed! \n\nPowered by elemental forces and mythical artifacts navigate your way through 3 environments with 30+ rounds each to get through. Will you be able to top the leaderboard for each of these? With >5 hours of mesmerizing gameplay, 10+ game mechanics to master and all set in a beautiful minimalist style with ambient adaptive soundtracks, you can enjoy it seated or standing up!\n"}]}, "developer_name": "HEADGEAR GbR", "developer_privacy_policy_url": "https://headgear.io/legal.html", "developer_terms_of_service_url": "https://headgear.io/legal.html#terms", "publisher_name": "HEADGEAR GbR", "support_website_url": null, "website_url": "https://headgear.io/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscrip
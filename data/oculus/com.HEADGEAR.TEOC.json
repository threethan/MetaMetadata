cdn.com/v/t64.5771-25/75361355_380339049810894_8629917805136921546_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RcAus7XjE4YQ7kNvwGePyYO&_nc_oc=AdowK_wWUKJK9JKTIy-C_tAYR2VIa2ok1UwRUn4weh8Dn-v1T0DjhOj5nkVlKbHuGtE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afwdo2L10t-CBIDPYNjFusXtJLQFoAY8o72jhheO76jQ6g&oe=69D0F463"}, {"file_name": "HighresScreenshot00081.png", "id": "376313343811121", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031312_376313347144454_2073303015962398022_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZsYbN99xbcEQ7kNvwEXW8GP&_nc_oc=AdpgUY-GKKBaQ1jTgBBit98izEe5P8VTozANEBqBx0LU2-CZEKgrR6SIYQGwlHHvdYU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxsACookeQnNQ5JbHvMIKMxbaF9hmmNt7BQAtURzTzhCA&oe=69D0EF77"}, {"file_name": "HighresScreenshot00034.png", "id": "361423311640761", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75297579_361423314974094_4468664441597916853_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2zsn49gp9FYQ7kNvwFSwQmw&_nc_oc=AdpZAiz79-MJuZvDGT_letO5WWHZ96E2Mr2Be33nJQeFhyhDb8L4G6cTIdaQIuQIjCo&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwWyayKPTvDyCT_Y-O8djqQzuQ4Uz2NDK111xCUOj1d9w&oe=69D0EDE0"}, {"file_name": "consume.png", "id": "356221875528110", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39001669_356221878861443_261896368707707264_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HSevoP8Af3sQ7kNvwF801aC&_nc_oc=AdpyucgPZe86Kko0kuAVoKAyQinowdniBTLc7UIfxp3Ak35M4jSd4DORmQXYODb2wmk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzMddog-8Sm9sc-pfjPo_K0iBORNSCIHC-EmtH7jrlFuQ&oe=69D11283"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "38982553_2716489995261681_7852865887418274915_n[1].png", "id": "1017968672039348", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974845_1017968675372681_3537640423345626257_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zx_DeuSeFBIQ7kNvwFLpSCA&_nc_oc=AdoadR5gTDDfEyV-21Iwz7-QBJBxqEYGMBY_fdSnfhnGDw8IXeTAGqnRhbW0JjhUarQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afx7mcdXtSnXaGZwg27HXrC9xdgRVh5xmnyoCWPQhCjv_w&oe=69D0F386"}, "display_name": "TEOC", "keywords": ["arcade", "puzzle", "casual", "atmospheric", "puzzler"], "long_description": "Evolve from an atomic state to marine-life in this spatial arcade puzzler with just one goal: Consume or be Consumed! \n\nPowered by elemental forces and mythical artifacts navigate your way through 3 environments with 30+ rounds each to get through. Will you be able to top the leaderboard for each of these? \n\nTEOC provides\u2026\n\u2022 more than 5 hours of mesmerizing gameplay,\n\u2022 a beautiful minimalist style with ambient adaptive soundtracks,\n\u2022 10+ game mechanics to master,\n\u2022 additional powerups to collect and use across all 90+ rounds\n\u2022 with daily powerup rewards for coming back\n\u2022 to compete on the 3 leaderboards,\n\u2022 increasingly challenging level design all procedurally generated\n\u2022 and seated or standing play options!\n\n\n", "short_description": "Evolve from an atomic state to marine-life in this spatial arcade puzzler with just one goal: Consume or be Consumed! \n\nPowered by elemental forces and mythical artifacts navigate your way through 3 environments with 30+ rounds each to get through. Will you be able to top the leaderboard for each of these? With >5 hours of mesmerizing gameplay, 10+ game mechanics to master and all set in a beautiful minimalist style with ambient adaptive soundtracks, you can enjoy it seated or standing up!\n"}]}, "developer_name": "HEADGEAR GbR", "developer_privacy_policy_url": "https://headgear.io/legal.html", "developer_terms_of_service_url": "https://headgear.io/legal.html#terms", "publisher_name": "HEADGEAR GbR", "support_website_url": null, "website_url": "https://headgear.io/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_categ
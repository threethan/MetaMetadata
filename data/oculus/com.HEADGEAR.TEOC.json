cdn.com/v/t64.5771-25/75361355_380339049810894_8629917805136921546_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z8nghZnQGc8Q7kNvwG-dbaQ&_nc_oc=AdpYuF0X11Ml-FvACBUWASrkgHAXLxp46Tf_D5I84gfdwevvceASiT6TU4uz2AHo2CE&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6KH2O_U0EZE_nJTUL2zvsTxkujV4UvOU3wSCUd2ojgUg&oe=6A0C8023"}, {"file_name": "HighresScreenshot00081.png", "id": "376313343811121", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/39031312_376313347144454_2073303015962398022_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PtL9Rkk0W3AQ7kNvwGvJDWi&_nc_oc=AdopBFkVUP7IRJejPLKx7gglySeV6xxtOxPWtR5Hf_GgS-zl9P4AQul59IDSoR-WoM4&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5gELHkZxm2mEf-kseqP_XYPdkw_VHWe0KcWDKQRGOiSg&oe=6A0C7B37"}, {"file_name": "HighresScreenshot00034.png", "id": "361423311640761", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/75297579_361423314974094_4468664441597916853_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MiO9L9PTMFwQ7kNvwGmA-UA&_nc_oc=AdolXxXMj3-erAV9t4P-Xg-JKvmb3tLbMgAr_vpztHJ5TRktdZ0Xx9pszLnDUgVqkHk&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5dDx-yZ0dXr9fmJWPdriuBri76VBv1UHtnT4ydr2pLHw&oe=6A0C79A0"}, {"file_name": "consume.png", "id": "356221875528110", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/39001669_356221878861443_261896368707707264_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GOrJvtyLC4gQ7kNvwHWb_NQ&_nc_oc=Adr9H_-XM0iKX-2RFZoGFTMRki1LsRNqzUpuW5ca8Y9PQ5RDT8DpztAznsKamHyHyDo&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4KWgUa4gMEeaqikz26kShcx6HFORA1JnxCoKRJX2XgjA&oe=6A0C6603"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "38982553_2716489995261681_7852865887418274915_n[1].png", "id": "1017968672039348", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38974845_1017968675372681_3537640423345626257_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z2ys9S22WosQ7kNvwEyM7zL&_nc_oc=AdrUk4ySJmeTLbTtD8zhDglW-8zJp7ACtAtm6Jg21DG0rX50LLVli23s--Tgafiir5M&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6SWjwlX5XB0cEnOLdxqNiSC-pj5AjFmOTjnUa8HKCWKg&oe=6A0C7F46"}, "display_name": "TEOC", "keywords": ["arcade", "puzzle", "casual", "atmospheric", "puzzler"], "long_description": "Evolve from an atomic state to marine-life in this spatial arcade puzzler with just one goal: Consume or be Consumed! \n\nPowered by elemental forces and mythical artifacts navigate your way through 3 environments with 30+ rounds each to get through. Will you be able to top the leaderboard for each of these? \n\nTEOC provides\u2026\n\u2022 more than 5 hours of mesmerizing gameplay,\n\u2022 a beautiful minimalist style with ambient adaptive soundtracks,\n\u2022 10+ game mechanics to master,\n\u2022 additional powerups to collect and use across all 90+ rounds\n\u2022 with daily powerup rewards for coming back\n\u2022 to compete on the 3 leaderboards,\n\u2022 increasingly challenging level design all procedurally generated\n\u2022 and seated or standing play options!\n\n\n", "short_description": "Evolve from an atomic state to marine-life in this spatial arcade puzzler with just one goal: Consume or be Consumed! \n\nPowered by elemental forces and mythical artifacts navigate your way through 3 environments with 30+ rounds each to get through. Will you be able to top the leaderboard for each of these? With >5 hours of mesmerizing gameplay, 10+ game mechanics to master and all set in a beautiful minimalist style with ambient adaptive soundtracks, you can enjoy it seated or standing up!\n"}]}, "developer_name": "HEADGEAR GbR", "developer_privacy_policy_url": "https://headgear.io/legal.html", "developer_terms_of_service_url": "https://headgear.io/legal.html#terms", "publisher_name": "HEADGEAR GbR", "support_website_url": null, "website_url": "https://headgear.io/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_categ
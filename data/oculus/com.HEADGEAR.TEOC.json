cdn.com/v/t64.5771-25/75361355_380339049810894_8629917805136921546_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dtReCw3b5LwQ7kNvwGxLtqV&_nc_oc=AdrCIlVaCld1ZNYHaH-F7aKpaVd--bsI3NVzyfW3butMcNtJWcRPshuONIbRXTVK4PU&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af91Qn_chy0zp_VIvxzV7z5LY_4_k3y434WeFFweG6VuDA&oe=6A4530A3"}, {"file_name": "HighresScreenshot00081.png", "id": "376313343811121", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39031312_376313347144454_2073303015962398022_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_GypYG9h-WkQ7kNvwGHPtgH&_nc_oc=Adr_zIagxEtHvJ4qcq7Bu4PSE2ukrGV71HZjhRPXIxGnaX9aGEZR9V3HcZ1_omNkeM8&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_zMx0cfnHYH20OsVIHA_vycRrbi-NSGK04-N2leHcLBw&oe=6A452BB7"}, {"file_name": "HighresScreenshot00034.png", "id": "361423311640761", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75297579_361423314974094_4468664441597916853_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zyCfEraNSIgQ7kNvwFPsPs1&_nc_oc=AdqAIMTEThLKJhytW2gg02dlaC_SdO112dC9gQZD3d3yCPVPx5rYN9Eov_ZkZdVJi-s&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8NbD-3vSaixgv_kB3_JpKT0HxUX34XpS_wrxrTcHAmhw&oe=6A452A20"}, {"file_name": "consume.png", "id": "356221875528110", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/39001669_356221878861443_261896368707707264_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vJzjIaLS_4gQ7kNvwHy1Iyq&_nc_oc=AdrFo4a8ZNlBqtdnptS0PGiKErPwi3vFIU7ljy6JX8MMJQ0aADRE2JiW0zxae8TnQq4&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9mIs4j_AEwrx0QNr_0FWwAldlYt-4KaeXQo_eTtyYsrA&oe=6A451683"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "38982553_2716489995261681_7852865887418274915_n[1].png", "id": "1017968672039348", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974845_1017968675372681_3537640423345626257_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F6LZIaXWIYoQ7kNvwF407qE&_nc_oc=AdqAQ1BCBEDi-ju-WpzIxP3lN9ChoJzJTSHpAGRiJ-btHXWsrSd4zk7jZ9x8Ptj2s2k&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9PkLofXxIKhLP9HP0_txbh3CMtyeI1AThmoQrA2kDKbA&oe=6A452FC6"}, "display_name": "TEOC", "keywords": ["arcade", "puzzle", "casual", "atmospheric", "puzzler"], "long_description": "Evolve from an atomic state to marine-life in this spatial arcade puzzler with just one goal: Consume or be Consumed! \n\nPowered by elemental forces and mythical artifacts navigate your way through 3 environments with 30+ rounds each to get through. Will you be able to top the leaderboard for each of these? \n\nTEOC provides\u2026\n\u2022 more than 5 hours of mesmerizing gameplay,\n\u2022 a beautiful minimalist style with ambient adaptive soundtracks,\n\u2022 10+ game mechanics to master,\n\u2022 additional powerups to collect and use across all 90+ rounds\n\u2022 with daily powerup rewards for coming back\n\u2022 to compete on the 3 leaderboards,\n\u2022 increasingly challenging level design all procedurally generated\n\u2022 and seated or standing play options!\n\n\n", "short_description": "Evolve from an atomic state to marine-life in this spatial arcade puzzler with just one goal: Consume or be Consumed! \n\nPowered by elemental forces and mythical artifacts navigate your way through 3 environments with 30+ rounds each to get through. Will you be able to top the leaderboard for each of these? With >5 hours of mesmerizing gameplay, 10+ game mechanics to master and all set in a beautiful minimalist style with ambient adaptive soundtracks, you can enjoy it seated or standing up!\n"}]}, "developer_name": "HEADGEAR GbR", "developer_privacy_policy_url": "https://headgear.io/legal.html", "developer_terms_of_service_url": "https://headgear.io/legal.html#terms", "publisher_name": "HEADGEAR GbR", "support_website_url": null, "website_url": "https://headgear.io/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_categ
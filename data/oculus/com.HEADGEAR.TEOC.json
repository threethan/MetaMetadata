cdn.com/v/t64.5771-25/75361355_380339049810894_8629917805136921546_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F_jb1eayGboQ7kNvwG26KjQ&_nc_oc=AdoV1pKrRq4-2amGSzfIqanWg1d3wRLQfOM8uRlTBhhOboknWeOKaxGYusleor_uOkQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLZNB7jXhXFw_O7n6fqCoUUPJAHNSyp-_xTAqSNHHCHzg&oe=6ABBD7A3"}, {"file_name": "HighresScreenshot00081.png", "id": "376313343811121", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031312_376313347144454_2073303015962398022_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BYYtW5Fq1PsQ7kNvwHyX_Hj&_nc_oc=AdpLWOGQXBNEpVa4z4rrYRMnlhkcV2MjFxXzOlDznE-zD1nPW16FZuVNrpg5DEoZKEo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLp_5pJ1FbPE5R9BILNj7ltQeWj-t4OFZhhUpVthtVYmg&oe=6ABBD2B7"}, {"file_name": "HighresScreenshot00034.png", "id": "361423311640761", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75297579_361423314974094_4468664441597916853_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PKyGwEsq5fQQ7kNvwHInUcv&_nc_oc=AdpD6lyrUZtwMpLst8yz_7quNAIqa2U9lJSQTaGEL62GUDxgLAeaJ8pQ3g2Z_REHJ1I&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIQH2KKEVon6D2o-bLFxfOaehehyNkQCbZXMHKTgc8WJg&oe=6ABBD120"}, {"file_name": "consume.png", "id": "356221875528110", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39001669_356221878861443_261896368707707264_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Zfzl38_IXuMQ7kNvwHRSP22&_nc_oc=Adr_7Uk1htJckLsTkm3ZHk1L8JbT0-Qf_HQV2dvLPvEw6KI2BbNgT_NZQsBgfi6woNM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKYVbt3K38cMBx23A3FIKmB7Z4oQh0fS8Ck-GJCAYA5lA&oe=6ABBBD83"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "38982553_2716489995261681_7852865887418274915_n[1].png", "id": "1017968672039348", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974845_1017968675372681_3537640423345626257_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DgnzZ5uTJuUQ7kNvwECOxPc&_nc_oc=Adqg0-Ouw7qwC635dHcZU88mXgFzNIxTmMG-FGSLj-2PrBzkcp9hOCBgp-aCbG1bUOg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJU4x_5Wst5Z9UrjqJv7-mqUwEBl3kDg2my3bYqOH6p_w&oe=6ABBD6C6"}, "display_name": "TEOC", "keywords": ["arcade", "puzzle", "casual", "atmospheric", "puzzler"], "long_description": "Evolve from an atomic state to marine-life in this spatial arcade puzzler with just one goal: Consume or be Consumed! \n\nPowered by elemental forces and mythical artifacts navigate your way through 3 environments with 30+ rounds each to get through. Will you be able to top the leaderboard for each of these? \n\nTEOC provides\u2026\n\u2022 more than 5 hours of mesmerizing gameplay,\n\u2022 a beautiful minimalist style with ambient adaptive soundtracks,\n\u2022 10+ game mechanics to master,\n\u2022 additional powerups to collect and use across all 90+ rounds\n\u2022 with daily powerup rewards for coming back\n\u2022 to compete on the 3 leaderboards,\n\u2022 increasingly challenging level design all procedurally generated\n\u2022 and seated or standing play options!\n\n\n", "short_description": "Evolve from an atomic state to marine-life in this spatial arcade puzzler with just one goal: Consume or be Consumed! \n\nPowered by elemental forces and mythical artifacts navigate your way through 3 environments with 30+ rounds each to get through. Will you be able to top the leaderboard for each of these? With >5 hours of mesmerizing gameplay, 10+ game mechanics to master and all set in a beautiful minimalist style with ambient adaptive soundtracks, you can enjoy it seated or standing up!\n"}]}, "developer_name": "HEADGEAR GbR", "developer_privacy_policy_url": "https://headgear.io/legal.html", "developer_terms_of_service_url": "https://headgear.io/legal.html#terms", "publisher_name": "HEADGEAR GbR", "support_website_url": null, "website_url": "https://headgear.io/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_categ
cdn.com/v/t64.5771-25/75361355_380339049810894_8629917805136921546_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gJo7D0ZYXtkQ7kNvwF6XNkL&_nc_oc=AdoPzER0O9Ng-mZO3wAvH1t8X3X7M7h9J_rMs0MuL_tJcIZqB1GaqcITQky112-gaaE&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxlKvNuIuQJ8ndQphVIxJPjhauzrDov1ssgB66-r_m0vQ&oe=69C7B9E3"}, {"file_name": "HighresScreenshot00081.png", "id": "376313343811121", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/39031312_376313347144454_2073303015962398022_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ddaC3xO3kR0Q7kNvwEHvZlf&_nc_oc=AdqJYuMQDy3qiK1RO06onsHlMgQDq9luasX6N4F_xNeOtbJ_bZGPN4feMl-sQQD4yqw&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxmSHvtPL6hHujh3pTxtUnqN-vJaaFPi2rK51pqmiiVtQ&oe=69C7B4F7"}, {"file_name": "HighresScreenshot00034.png", "id": "361423311640761", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/75297579_361423314974094_4468664441597916853_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Bo4g_ZUCBiEQ7kNvwFmiIEa&_nc_oc=AdpUXSwD6BzdgkN4mL-0x_glW0mkC4yn9v5DaWevJAxQUs6iQTQWoh8IcswtS38N4OM&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfytOnj5Wp28UJXXMx83Ndvy0wcGgiGlYOHCvpdnrZ5bAQ&oe=69C7B360"}, {"file_name": "consume.png", "id": "356221875528110", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/39001669_356221878861443_261896368707707264_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PnEVSkpIfAYQ7kNvwF-Wvsb&_nc_oc=AdpPf7ceME0GzLRWW4hlpLLx2gKgbcqwlh3B47N9Q7x-tc2QAQi5pUNvkTXB6MYfW2A&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzJpSa1p1rhLd9wGkXWv-e0kJ8zBdg3_1upN4OSgxBp2Q&oe=69C7D803"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "38982553_2716489995261681_7852865887418274915_n[1].png", "id": "1017968672039348", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/38974845_1017968675372681_3537640423345626257_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4T582nUm7tgQ7kNvwG7DVeC&_nc_oc=AdoIecGDaxYlB1mdKEr4wkemeqRpxgE1xnYVPx_f2h6X8q640-idUXF8O1za-WGf6kc&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyU8DLnj42Dq2hYbfQ43KGFsPk0oSa6vOJUg8ZaHfiuBQ&oe=69C7B906"}, "display_name": "TEOC", "keywords": ["arcade", "puzzle", "casual", "atmospheric", "puzzler"], "long_description": "Evolve from an atomic state to marine-life in this spatial arcade puzzler with just one goal: Consume or be Consumed! \n\nPowered by elemental forces and mythical artifacts navigate your way through 3 environments with 30+ rounds each to get through. Will you be able to top the leaderboard for each of these? \n\nTEOC provides\u2026\n\u2022 more than 5 hours of mesmerizing gameplay,\n\u2022 a beautiful minimalist style with ambient adaptive soundtracks,\n\u2022 10+ game mechanics to master,\n\u2022 additional powerups to collect and use across all 90+ rounds\n\u2022 with daily powerup rewards for coming back\n\u2022 to compete on the 3 leaderboards,\n\u2022 increasingly challenging level design all procedurally generated\n\u2022 and seated or standing play options!\n\n\n", "short_description": "Evolve from an atomic state to marine-life in this spatial arcade puzzler with just one goal: Consume or be Consumed! \n\nPowered by elemental forces and mythical artifacts navigate your way through 3 environments with 30+ rounds each to get through. Will you be able to top the leaderboard for each of these? With >5 hours of mesmerizing gameplay, 10+ game mechanics to master and all set in a beautiful minimalist style with ambient adaptive soundtracks, you can enjoy it seated or standing up!\n"}]}, "developer_name": "HEADGEAR GbR", "developer_privacy_policy_url": "https://headgear.io/legal.html", "developer_terms_of_service_url": "https://headgear.io/legal.html#terms", "publisher_name": "HEADGEAR GbR", "support_website_url": null, "website_url": "https://headgear.io/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_categ
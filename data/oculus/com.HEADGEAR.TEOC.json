cdn.com/v/t64.5771-25/75361355_380339049810894_8629917805136921546_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qOnYWTyfiZcQ7kNvwG7Q35l&_nc_oc=AdpooaF7dRGFrIdi8qbrsDrATCahqH4HXztyjOuN2XZwlDzfPkE23z4GkoCMc5Ala9w&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK4OcKcTpsvqoGuL5CLsIjH-WvUCuUPv6RNJ_pimZDbvg&oe=6AB7E323"}, {"file_name": "HighresScreenshot00081.png", "id": "376313343811121", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031312_376313347144454_2073303015962398022_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hhkR7zI6LnsQ7kNvwHOhKSZ&_nc_oc=AdplNisWsg3J21nLRlZRnQEGTB__uQLX-F9jLUM1Gtvj2hGcOrPhqSuDZzo7SyK9FAs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIw8Yjpsl-PzV_rGvswbh0I-HJS0Z9z3Lf2mHJLfrBUIA&oe=6AB7DE37"}, {"file_name": "HighresScreenshot00034.png", "id": "361423311640761", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75297579_361423314974094_4468664441597916853_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2YPVf9wjPpYQ7kNvwHdZhrd&_nc_oc=Adri6QzIeA-85pkTy-fUlsvsi0ZwnmhINywRxTlTtqIO_W-8ay9tsttJinXs9uj_iaQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLrGcb4Akn5QNhr1ZBzLEb0cM_Fi-oCzvGS2rFm3ZdOJA&oe=6AB7DCA0"}, {"file_name": "consume.png", "id": "356221875528110", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39001669_356221878861443_261896368707707264_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-MzpNwCaUOYQ7kNvwHwtt__&_nc_oc=AdoUJCUoti5iYfvAQutJLM9pJH7ng_fxtCQx9aAmA_7Sretv97a3i2Hs_uXLhYyhShM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ_1bY-zKRyk4-B43gekazEmpwfEXH5dG-aQ2D4F4qGMg&oe=6AB7C903"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "38982553_2716489995261681_7852865887418274915_n[1].png", "id": "1017968672039348", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974845_1017968675372681_3537640423345626257_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OL-yWF9XczcQ7kNvwEQIFAZ&_nc_oc=AdoNEZE0cI3Moeo3DelqRWowI0-DTgllf_8v5fkAnF2zGi7O5sZ5w2VzOpZdhyl38GM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIF28QxLC1O1iYu6wOTPaIQwKfwCVOwHtZV5AFg9EzBpw&oe=6AB7E246"}, "display_name": "TEOC", "keywords": ["arcade", "puzzle", "casual", "atmospheric", "puzzler"], "long_description": "Evolve from an atomic state to marine-life in this spatial arcade puzzler with just one goal: Consume or be Consumed! \n\nPowered by elemental forces and mythical artifacts navigate your way through 3 environments with 30+ rounds each to get through. Will you be able to top the leaderboard for each of these? \n\nTEOC provides\u2026\n\u2022 more than 5 hours of mesmerizing gameplay,\n\u2022 a beautiful minimalist style with ambient adaptive soundtracks,\n\u2022 10+ game mechanics to master,\n\u2022 additional powerups to collect and use across all 90+ rounds\n\u2022 with daily powerup rewards for coming back\n\u2022 to compete on the 3 leaderboards,\n\u2022 increasingly challenging level design all procedurally generated\n\u2022 and seated or standing play options!\n\n\n", "short_description": "Evolve from an atomic state to marine-life in this spatial arcade puzzler with just one goal: Consume or be Consumed! \n\nPowered by elemental forces and mythical artifacts navigate your way through 3 environments with 30+ rounds each to get through. Will you be able to top the leaderboard for each of these? With >5 hours of mesmerizing gameplay, 10+ game mechanics to master and all set in a beautiful minimalist style with ambient adaptive soundtracks, you can enjoy it seated or standing up!\n"}]}, "developer_name": "HEADGEAR GbR", "developer_privacy_policy_url": "https://headgear.io/legal.html", "developer_terms_of_service_url": "https://headgear.io/legal.html#terms", "publisher_name": "HEADGEAR GbR", "support_website_url": null, "website_url": "https://headgear.io/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_categ
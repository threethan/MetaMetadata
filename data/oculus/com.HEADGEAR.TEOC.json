cdn.com/v/t64.5771-25/75361355_380339049810894_8629917805136921546_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5t3gLZVQY6YQ7kNvwEgxfFI&_nc_oc=AdqkaLcWK8-jr0HjUY9KTUHEAkd9P9KqLoHAhEkh0aLkIe7DNFY2XXz0wB7xwdqwu6E&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7lbaPup52fnZLz1k_UQ1uUF49F0AKEueKKgbpj0Dq7hw&oe=69FDFFA3"}, {"file_name": "HighresScreenshot00081.png", "id": "376313343811121", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/39031312_376313347144454_2073303015962398022_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vdPXyYr6m-QQ7kNvwFiW7ko&_nc_oc=Adqbon1gSm1_kDbF988w9QBihYldYI0AvB8C2PTAHAusuZkdbnngm5jdVxveTQEZjL8&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7ncSZCE9ajhKBjPB7EEj3PlQb0JZ3M67XxHgkh5KIfsw&oe=69FDFAB7"}, {"file_name": "HighresScreenshot00034.png", "id": "361423311640761", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/75297579_361423314974094_4468664441597916853_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8GTRzSafM98Q7kNvwEJipZ6&_nc_oc=Adr_oU1ZUN5D4u-jugP2cxt7qqCXtupIiEheRRrPAf6vZTMtvViL6nt48uVTNtMatkY&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6VhFh-C-swu0jW5ypHvY6oGEi3szBnBrg17rtznoHSUg&oe=69FDF920"}, {"file_name": "consume.png", "id": "356221875528110", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/39001669_356221878861443_261896368707707264_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oCwxKxZoEbIQ7kNvwE0IPMM&_nc_oc=Ado3mKM-momsyAkkx5dcU-3uQOwAWPBiiXAZ8iT1PbTTMpu0xJPfrKIa6prQ7OIVfjQ&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6zqkbkk9ms3XG325MBpdYAHttFQxpDFOfZ58wCUoKUFQ&oe=69FDE583"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "38982553_2716489995261681_7852865887418274915_n[1].png", "id": "1017968672039348", "uri": "https://scontent-dfw5-3.oculuscdn.com/v/t64.5771-25/38974845_1017968675372681_3537640423345626257_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Jr2SD4z0yjoQ7kNvwHE0jR2&_nc_oc=AdqfT0Kbghs0NdlkrkQ7F4bcgkw95v5QF9ZM0vk91xr2mtqQDLhsBQ1Ctbf_3d2CxsU&_nc_zt=3&_nc_ht=scontent-dfw5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7SgbO2yE0i3scEyfQEnBQ7T-zBkiM32n9Y9vzr92ugHQ&oe=69FDFEC6"}, "display_name": "TEOC", "keywords": ["arcade", "puzzle", "casual", "atmospheric", "puzzler"], "long_description": "Evolve from an atomic state to marine-life in this spatial arcade puzzler with just one goal: Consume or be Consumed! \n\nPowered by elemental forces and mythical artifacts navigate your way through 3 environments with 30+ rounds each to get through. Will you be able to top the leaderboard for each of these? \n\nTEOC provides\u2026\n\u2022 more than 5 hours of mesmerizing gameplay,\n\u2022 a beautiful minimalist style with ambient adaptive soundtracks,\n\u2022 10+ game mechanics to master,\n\u2022 additional powerups to collect and use across all 90+ rounds\n\u2022 with daily powerup rewards for coming back\n\u2022 to compete on the 3 leaderboards,\n\u2022 increasingly challenging level design all procedurally generated\n\u2022 and seated or standing play options!\n\n\n", "short_description": "Evolve from an atomic state to marine-life in this spatial arcade puzzler with just one goal: Consume or be Consumed! \n\nPowered by elemental forces and mythical artifacts navigate your way through 3 environments with 30+ rounds each to get through. Will you be able to top the leaderboard for each of these? With >5 hours of mesmerizing gameplay, 10+ game mechanics to master and all set in a beautiful minimalist style with ambient adaptive soundtracks, you can enjoy it seated or standing up!\n"}]}, "developer_name": "HEADGEAR GbR", "developer_privacy_policy_url": "https://headgear.io/legal.html", "developer_terms_of_service_url": "https://headgear.io/legal.html#terms", "publisher_name": "HEADGEAR GbR", "support_website_url": null, "website_url": "https://headgear.io/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_categ
cdn.com/v/t64.5771-25/75361355_380339049810894_8629917805136921546_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qOnYWTyfiZcQ7kNvwF2bqI6&_nc_oc=AdoovgatlTqADtj1nI8Z4FU-SIukw0nV4pjIS1iRdRU7S6BohESrPaopLK_scpgW4as&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIuaKEFw3PUeDUnR7-k8vpT4NNBKwUfUOI-Exe51-u_kA&oe=6ABA8623"}, {"file_name": "HighresScreenshot00081.png", "id": "376313343811121", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031312_376313347144454_2073303015962398022_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BYYtW5Fq1PsQ7kNvwEtRqL2&_nc_oc=Adp-iB36GuDXVgRMrMqpO6ELXM2pSXuEY9fFfLEHy5geGBtrjiiFAFxrPpKNUjyVcIQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLQtCJ2pCz6VMnMCoNRWjaJGlB10azgno-gAYDHvP8VOw&oe=6ABA8137"}, {"file_name": "HighresScreenshot00034.png", "id": "361423311640761", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75297579_361423314974094_4468664441597916853_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PKyGwEsq5fQQ7kNvwEhgXdm&_nc_oc=Adrmt7JprK_nXjBhPnHoA5qkYHlESUPgharHMRnT8Dg_nmzH4mrknchNIPGxqlQTsdw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLqrMiYKktlCGh7jW1hWCVJTEX3ixn0cOz0W7TZgu7Yxw&oe=6ABA7FA0"}, {"file_name": "consume.png", "id": "356221875528110", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39001669_356221878861443_261896368707707264_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Zfzl38_IXuMQ7kNvwHRgkLg&_nc_oc=AdquDpqiL7k-KJDKhQi-zBPoEiF3bgfSWsttviZai0z_6IiNcWU70XXKsR37Sf4cr3E&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKzdiY3xSRc9fGlmnmjnORnnPFGzrPoZNWg8ZldAYlJag&oe=6ABA6C03"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "38982553_2716489995261681_7852865887418274915_n[1].png", "id": "1017968672039348", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974845_1017968675372681_3537640423345626257_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DgnzZ5uTJuUQ7kNvwFtfFpm&_nc_oc=AdoTo23441USrwMvUVEozKAFqHH0BCTQsywscD5ET8LogwWBJYidw9Mq35hFZPpIX6s&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJZ4__QSZ9votRaVwx5oQsIMxBFprJsiPMALfFupNEM1w&oe=6ABA8546"}, "display_name": "TEOC", "keywords": ["arcade", "puzzle", "casual", "atmospheric", "puzzler"], "long_description": "Evolve from an atomic state to marine-life in this spatial arcade puzzler with just one goal: Consume or be Consumed! \n\nPowered by elemental forces and mythical artifacts navigate your way through 3 environments with 30+ rounds each to get through. Will you be able to top the leaderboard for each of these? \n\nTEOC provides\u2026\n\u2022 more than 5 hours of mesmerizing gameplay,\n\u2022 a beautiful minimalist style with ambient adaptive soundtracks,\n\u2022 10+ game mechanics to master,\n\u2022 additional powerups to collect and use across all 90+ rounds\n\u2022 with daily powerup rewards for coming back\n\u2022 to compete on the 3 leaderboards,\n\u2022 increasingly challenging level design all procedurally generated\n\u2022 and seated or standing play options!\n\n\n", "short_description": "Evolve from an atomic state to marine-life in this spatial arcade puzzler with just one goal: Consume or be Consumed! \n\nPowered by elemental forces and mythical artifacts navigate your way through 3 environments with 30+ rounds each to get through. Will you be able to top the leaderboard for each of these? With >5 hours of mesmerizing gameplay, 10+ game mechanics to master and all set in a beautiful minimalist style with ambient adaptive soundtracks, you can enjoy it seated or standing up!\n"}]}, "developer_name": "HEADGEAR GbR", "developer_privacy_policy_url": "https://headgear.io/legal.html", "developer_terms_of_service_url": "https://headgear.io/legal.html#terms", "publisher_name": "HEADGEAR GbR", "support_website_url": null, "website_url": "https://headgear.io/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_categ
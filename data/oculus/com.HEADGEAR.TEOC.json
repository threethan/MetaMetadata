cdn.com/v/t64.5771-25/75361355_380339049810894_8629917805136921546_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ru19NGaBKxAQ7kNvwE4xIHf&_nc_oc=AdrjvKrtFrijXCfnR_gM4BPVTaYsEMZ7zMFZQ3cQddbQGnARK0IU60k2WUbQ6rrgSWM&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDLZaBHIFyGxZ_9B0lpolSX9xMzPBQ8zGqW1jDoNKHxeQ&oe=6A5502A3"}, {"file_name": "HighresScreenshot00081.png", "id": "376313343811121", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39031312_376313347144454_2073303015962398022_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C8ZzelriXN0Q7kNvwEobE5g&_nc_oc=AdrI-_y3FExTxFAB_a4Bwq2IG5OFzDqlgRe5BONbfimpN4t2q6KOOWhvNwpPpYUQgzw&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBFGkmW0Zoh95gurMrLvCVlRAbkFgTzoTWCJU5L1WShzg&oe=6A54FDB7"}, {"file_name": "HighresScreenshot00034.png", "id": "361423311640761", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75297579_361423314974094_4468664441597916853_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=numDEhtuQfQQ7kNvwElsqjs&_nc_oc=Adq01mkGiWX52QfrCs8XhpGLb2-WTiKPZZrSEALNdHCEQqyNCq8Nb7dQ8qeJLO1ZJSI&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDhkfk0ejUvQBi1KAG38aQt1ssf-QTb-Cp35I9FIrJVtA&oe=6A54FC20"}, {"file_name": "consume.png", "id": "356221875528110", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/39001669_356221878861443_261896368707707264_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DP7ldhSemu4Q7kNvwHXxMP7&_nc_oc=Adrly3R5Wv9L7aZUFql0MiSgrucOoWikL7d-O4Ry7IyChsxIBCPZKcN7rWaDfQerxmE&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAws2t3ZXjtjXY-TaoS4tqGiNPBref4PpjbW5jbPQ_PcA&oe=6A54E883"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "38982553_2716489995261681_7852865887418274915_n[1].png", "id": "1017968672039348", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974845_1017968675372681_3537640423345626257_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9kCtAQkOw7EQ7kNvwHD0sSO&_nc_oc=AdrDRthr_ZiuhZpnYz201FyO0JJtvGKlIP4Smh8N-vlXK02D5K62826b4AE2K7BKzrY&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDwBUga_jcvcsyfaoPuC3rSIkx8Y5ec7v3O2weUKxxMvg&oe=6A5501C6"}, "display_name": "TEOC", "keywords": ["arcade", "puzzle", "casual", "atmospheric", "puzzler"], "long_description": "Evolve from an atomic state to marine-life in this spatial arcade puzzler with just one goal: Consume or be Consumed! \n\nPowered by elemental forces and mythical artifacts navigate your way through 3 environments with 30+ rounds each to get through. Will you be able to top the leaderboard for each of these? \n\nTEOC provides\u2026\n\u2022 more than 5 hours of mesmerizing gameplay,\n\u2022 a beautiful minimalist style with ambient adaptive soundtracks,\n\u2022 10+ game mechanics to master,\n\u2022 additional powerups to collect and use across all 90+ rounds\n\u2022 with daily powerup rewards for coming back\n\u2022 to compete on the 3 leaderboards,\n\u2022 increasingly challenging level design all procedurally generated\n\u2022 and seated or standing play options!\n\n\n", "short_description": "Evolve from an atomic state to marine-life in this spatial arcade puzzler with just one goal: Consume or be Consumed! \n\nPowered by elemental forces and mythical artifacts navigate your way through 3 environments with 30+ rounds each to get through. Will you be able to top the leaderboard for each of these? With >5 hours of mesmerizing gameplay, 10+ game mechanics to master and all set in a beautiful minimalist style with ambient adaptive soundtracks, you can enjoy it seated or standing up!\n"}]}, "developer_name": "HEADGEAR GbR", "developer_privacy_policy_url": "https://headgear.io/legal.html", "developer_terms_of_service_url": "https://headgear.io/legal.html#terms", "publisher_name": "HEADGEAR GbR", "support_website_url": null, "website_url": "https://headgear.io/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_categ
-25/39031312_376313347144454_2073303015962398022_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4k5fcON-V74Q7kNvwGBnlgy&_nc_oc=AdqxYM9J1JC8at1FO6qrzZuwdK6xUn5dMI27Sq2_tvoJpKzfeHkeeCh3UCYRKzrR1Q8&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Afx2pUxI-gtW_Q3zEtHalkkE9f_bgbYiCTgQ7Q-nU9n8nw&oe=69CBA977"}, {"file_name": "HighresScreenshot00034.png", "id": "361423311640761", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/75297579_361423314974094_4468664441597916853_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8uNL3fXb3mUQ7kNvwFMH-xw&_nc_oc=AdpNX9Ex39cTIhsDX4Fzx_BQKq2Py2V9zUG_BHiSOfdF7EcBLjWgVvlv0V0tIf5JV0E&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzCUVKiant0aU8eMydaM8ZJrmi6yp00pm-Jm34oxJkntw&oe=69CBE020"}, {"file_name": "consume.png", "id": "356221875528110", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39001669_356221878861443_261896368707707264_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cAtSyN2je3cQ7kNvwFtz8xx&_nc_oc=AdoqccEfTyovtJ-RQeVHAvhJNIBefbOR-9oCdroHSpeFy5VSBGYDVGnQ0u9TKOXJoBU&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzBY9ctK-SsLWbeEWZFYizCZh0wixfsG3xi-LnCZ4BpMg&oe=69CBCC83"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "38982553_2716489995261681_7852865887418274915_n[1].png", "id": "1017968672039348", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974845_1017968675372681_3537640423345626257_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YL9GU2O8kcUQ7kNvwEAPzKC&_nc_oc=AdoQT10xB6ak4Njdpb-xfG-c_DX83iShZ1VaiG1FKpgXXRXR9RfJLUvHz1iQIJ9F2Fc&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwIafwGsmwpnQwFCqT_01MN_yGGFIWaQCpdzN5QeiYpSQ&oe=69CBAD86"}, "display_name": "TEOC", "keywords": ["arcade", "puzzle", "casual", "atmospheric", "puzzler"], "long_description": "Evolve from an atomic state to marine-life in this spatial arcade puzzler with just one goal: Consume or be Consumed! \n\nPowered by elemental forces and mythical artifacts navigate your way through 3 environments with 30+ rounds each to get through. Will you be able to top the leaderboard for each of these? \n\nTEOC provides\u2026\n\u2022 more than 5 hours of mesmerizing gameplay,\n\u2022 a beautiful minimalist style with ambient adaptive soundtracks,\n\u2022 10+ game mechanics to master,\n\u2022 additional powerups to collect and use across all 90+ rounds\n\u2022 with daily powerup rewards for coming back\n\u2022 to compete on the 3 leaderboards,\n\u2022 increasingly challenging level design all procedurally generated\n\u2022 and seated or standing play options!\n\n\n", "short_description": "Evolve from an atomic state to marine-life in this spatial arcade puzzler with just one goal: Consume or be Consumed! \n\nPowered by elemental forces and mythical artifacts navigate your way through 3 environments with 30+ rounds each to get through. Will you be able to top the leaderboard for each of these? With >5 hours of mesmerizing gameplay, 10+ game mechanics to master and all set in a beautiful minimalist style with ambient adaptive soundtracks, you can enjoy it seated or standing up!\n"}]}, "developer_name": "HEADGEAR GbR", "developer_privacy_policy_url": "https://headgear.io/legal.html", "developer_terms_of_service_url": "https://headgear.io/legal.html#terms", "publisher_name": "HEADGEAR GbR", "support_website_url": null, "website_url": "https://headgear.io/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "PUZZLE", "ARCADE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_mo
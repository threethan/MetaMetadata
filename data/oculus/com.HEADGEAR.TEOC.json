cdn.com/v/t64.5771-25/75361355_380339049810894_8629917805136921546_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GiKwgqfoaYMQ7kNvwGu9R3k&_nc_oc=AdpNQLdn2E3T2Ec-6TE_6qGxMpHtb4gX14SV5C-rVPz5CyaxwLu7zOp9jLhM7WO2ZLI&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTDKejSjzHQxrVDrDzqMutHeYSmsVzlWUbtPiyoMjcBiw&oe=6AF336A3"}, {"file_name": "HighresScreenshot00081.png", "id": "376313343811121", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39031312_376313347144454_2073303015962398022_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Dd6DA0yXIGMQ7kNvwH3lYiz&_nc_oc=Adqk7IZo1J3S-TQj5aIxJE8phLC2Ztmckoke3jGKVwwJpdzSNi7yh2Y11Z_Tr_Oy9uc&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTL-B8y0heoc6GQzBrDZeEuw6yVEHCfTGSDagDS0Jd7JA&oe=6AF331B7"}, {"file_name": "HighresScreenshot00034.png", "id": "361423311640761", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75297579_361423314974094_4468664441597916853_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3W8MzrbiRO4Q7kNvwH460i6&_nc_oc=Adq-mGcxKoKS1OoFM35xEUmM7J0AKM0Lcxa-1mQ_LZLlUma6jq8lA8zCfZl04pE_Nl8&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQN2z6fPyCUiShsJp5S02w9c4vKkxToPdnQgug5SAUCwA&oe=6AF33020"}, {"file_name": "consume.png", "id": "356221875528110", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39001669_356221878861443_261896368707707264_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gGscNip8ehcQ7kNvwHmT5QK&_nc_oc=Adr4KHmomJ5zsxWjDUOw8RiHXUjzL9evc4-5t4HQjJoM8L8XH-H2Fzeo8sKfxx2v-0k&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR087pY1sRez6xuuVVjRcKibk4xkdHth845bJb77Eda9g&oe=6AF354C3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "38982553_2716489995261681_7852865887418274915_n[1].png", "id": "1017968672039348", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974845_1017968675372681_3537640423345626257_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QAP1HvnBkXwQ7kNvwHNxzh-&_nc_oc=AdrV5PTBIySOeWd2Tj_QDt1yKZX8-k8x6NrsN8qPZm_JcPsSYy0gudTzC98qlImxcm8&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTjOfo88UNf_kXy6S0wT0kF6zH-6PNHrqU8WnGuJ0dkVA&oe=6AF335C6"}, "display_name": "TEOC", "keywords": ["arcade", "puzzle", "casual", "atmospheric", "puzzler"], "long_description": "Evolve from an atomic state to marine-life in this spatial arcade puzzler with just one goal: Consume or be Consumed! \n\nPowered by elemental forces and mythical artifacts navigate your way through 3 environments with 30+ rounds each to get through. Will you be able to top the leaderboard for each of these? \n\nTEOC provides\u2026\n\u2022 more than 5 hours of mesmerizing gameplay,\n\u2022 a beautiful minimalist style with ambient adaptive soundtracks,\n\u2022 10+ game mechanics to master,\n\u2022 additional powerups to collect and use across all 90+ rounds\n\u2022 with daily powerup rewards for coming back\n\u2022 to compete on the 3 leaderboards,\n\u2022 increasingly challenging level design all procedurally generated\n\u2022 and seated or standing play options!\n\n\n", "short_description": "Evolve from an atomic state to marine-life in this spatial arcade puzzler with just one goal: Consume or be Consumed! \n\nPowered by elemental forces and mythical artifacts navigate your way through 3 environments with 30+ rounds each to get through. Will you be able to top the leaderboard for each of these? With >5 hours of mesmerizing gameplay, 10+ game mechanics to master and all set in a beautiful minimalist style with ambient adaptive soundtracks, you can enjoy it seated or standing up!\n"}]}, "developer_name": "HEADGEAR GbR", "developer_privacy_policy_url": "https://headgear.io/legal.html", "developer_terms_of_service_url": "https://headgear.io/legal.html#terms", "publisher_name": "HEADGEAR GbR", "support_website_url": null, "website_url": "https://headgear.io/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_categ
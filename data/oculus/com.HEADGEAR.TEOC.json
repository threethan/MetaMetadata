cdn.com/v/t64.5771-25/75361355_380339049810894_8629917805136921546_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pcQfHBsxnocQ7kNvwGhg7vj&_nc_oc=Adrbf3jbuebv_RAlkpz_zdheUGeCbpxTG6tXJGNzG0hWduZToTeXzWYTq7XON3imPvs&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfycIfwAH-Dh5yYkTjp0mmdY9hkqconAhDsP4mNCRLniSg&oe=69C3C563"}, {"file_name": "HighresScreenshot00081.png", "id": "376313343811121", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39031312_376313347144454_2073303015962398022_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fEc8JxCwuQ8Q7kNvwGDLM7Y&_nc_oc=AdqcJPcAx_5ybhHKn-FM7ZkPW1AyLJslkgWgMXZ_fM1hjrR6zHOr0w-CWgEFglRQVms&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxoyyhxWlAjGqp367Dk3qZfquFle2YKfB336Zf7H5jtfw&oe=69C3C077"}, {"file_name": "HighresScreenshot00034.png", "id": "361423311640761", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/75297579_361423314974094_4468664441597916853_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=shEXLrUSznYQ7kNvwFWqsRz&_nc_oc=Adr8dhHe9k2Scnr0NJXbXR72lcDffjNyfRUA-UzclgnR3ULOZ3UefHHvDqO42dKwjFY&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxoDC1Nji3xp6OjZGvrGFdv8tWX9XxM79dF_p5mBEijjQ&oe=69C3BEE0"}, {"file_name": "consume.png", "id": "356221875528110", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39001669_356221878861443_261896368707707264_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VJOWmyjsdtQQ7kNvwHICciG&_nc_oc=AdrjQlxialR6445dGlwGARCBGLbiQ-9Xf8XXHHDNud23UdPjES3YGjk2jkfNVkboSSY&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afy6_amJy6r-fwmPtYEgVD7Kr3xOsnVmrh21AJNNSBiZRw&oe=69C3E383"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "38982553_2716489995261681_7852865887418274915_n[1].png", "id": "1017968672039348", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974845_1017968675372681_3537640423345626257_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_9XlChK2FgMQ7kNvwFKZ9ba&_nc_oc=AdoZ0ljUQVNY8HOdkGikNrBcLhKp4LiDtybBSv9C3TcZx11dwTLFdYxf70Rs2OnCX8Q&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzQYr9D9hhL6m34CnhvBtbXX1dIvmcizNUXXWCFwuAbMQ&oe=69C3C486"}, "display_name": "TEOC", "keywords": ["arcade", "puzzle", "casual", "atmospheric", "puzzler"], "long_description": "Evolve from an atomic state to marine-life in this spatial arcade puzzler with just one goal: Consume or be Consumed! \n\nPowered by elemental forces and mythical artifacts navigate your way through 3 environments with 30+ rounds each to get through. Will you be able to top the leaderboard for each of these? \n\nTEOC provides\u2026\n\u2022 more than 5 hours of mesmerizing gameplay,\n\u2022 a beautiful minimalist style with ambient adaptive soundtracks,\n\u2022 10+ game mechanics to master,\n\u2022 additional powerups to collect and use across all 90+ rounds\n\u2022 with daily powerup rewards for coming back\n\u2022 to compete on the 3 leaderboards,\n\u2022 increasingly challenging level design all procedurally generated\n\u2022 and seated or standing play options!\n\n\n", "short_description": "Evolve from an atomic state to marine-life in this spatial arcade puzzler with just one goal: Consume or be Consumed! \n\nPowered by elemental forces and mythical artifacts navigate your way through 3 environments with 30+ rounds each to get through. Will you be able to top the leaderboard for each of these? With >5 hours of mesmerizing gameplay, 10+ game mechanics to master and all set in a beautiful minimalist style with ambient adaptive soundtracks, you can enjoy it seated or standing up!\n"}]}, "developer_name": "HEADGEAR GbR", "developer_privacy_policy_url": "https://headgear.io/legal.html", "developer_terms_of_service_url": "https://headgear.io/legal.html#terms", "publisher_name": "HEADGEAR GbR", "support_website_url": null, "website_url": "https://headgear.io/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_categ
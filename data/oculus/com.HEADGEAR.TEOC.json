cdn.com/v/t64.5771-25/75361355_380339049810894_8629917805136921546_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=68VPN0pd6NoQ7kNvwH6tfg7&_nc_oc=AdpMZsnYTBbZfqV5s5VMvOBD9wFPOWYx41l_8bmnLFOaB65YLAu823tkrE-7QpndjdE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIpfZhbnCbi8D-aHBCBrTaldj3fILBQvmZeurizbWzSWA&oe=6A9ED6A3"}, {"file_name": "HighresScreenshot00081.png", "id": "376313343811121", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031312_376313347144454_2073303015962398022_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3Eu4X-llEIYQ7kNvwGnUPIG&_nc_oc=Adp7up6MRGQaG7RZf4oQM1Bb94849fMNE4SK9SiTK80oOntmdLiSd4c-Yfk5LIzVvIM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJoQDqeWXnM7FrWlo14_SDwlhSbLwuBFl1DrRb7Vgftrw&oe=6A9ED1B7"}, {"file_name": "HighresScreenshot00034.png", "id": "361423311640761", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75297579_361423314974094_4468664441597916853_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ELXGOSmVmyMQ7kNvwFVGhzY&_nc_oc=AdoZN1NAxqPtbUIS-UaQIVm2P5gJPMm3FCIITZyiP0KFmNIDqkIbOibXox9brC1Isus&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLmQ5J638nFXvz6JYfMMN3dKZjYYoCpAGJWH7QcIex_xg&oe=6A9ED020"}, {"file_name": "consume.png", "id": "356221875528110", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39001669_356221878861443_261896368707707264_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=igpAy5Ly8ogQ7kNvwHPVZ2m&_nc_oc=AdqyYhERZjkYBKQCdHHP2kjNiTi7v8vOpKTaSzysembF4RnY9qk8SfFU5mRpxCPM0s4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQILSPM2AnBz1hheJqXXu5JLyJ47Ey2Ww0CWAWd50bCqjg&oe=6A9EBC83"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "38982553_2716489995261681_7852865887418274915_n[1].png", "id": "1017968672039348", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974845_1017968675372681_3537640423345626257_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g_oSIs3L_BUQ7kNvwHtU3tm&_nc_oc=AdrMEGWOfUzyC5RaAmPMNsiJZ-RKEHwvCf2ljnv9wzqtaYsVSbb4JWBqI38JXHXWk84&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJHFDddoK8kI1cbLEddjyTaky88mp8Rf0AnPbVyOiagJw&oe=6A9ED5C6"}, "display_name": "TEOC", "keywords": ["arcade", "puzzle", "casual", "atmospheric", "puzzler"], "long_description": "Evolve from an atomic state to marine-life in this spatial arcade puzzler with just one goal: Consume or be Consumed! \n\nPowered by elemental forces and mythical artifacts navigate your way through 3 environments with 30+ rounds each to get through. Will you be able to top the leaderboard for each of these? \n\nTEOC provides\u2026\n\u2022 more than 5 hours of mesmerizing gameplay,\n\u2022 a beautiful minimalist style with ambient adaptive soundtracks,\n\u2022 10+ game mechanics to master,\n\u2022 additional powerups to collect and use across all 90+ rounds\n\u2022 with daily powerup rewards for coming back\n\u2022 to compete on the 3 leaderboards,\n\u2022 increasingly challenging level design all procedurally generated\n\u2022 and seated or standing play options!\n\n\n", "short_description": "Evolve from an atomic state to marine-life in this spatial arcade puzzler with just one goal: Consume or be Consumed! \n\nPowered by elemental forces and mythical artifacts navigate your way through 3 environments with 30+ rounds each to get through. Will you be able to top the leaderboard for each of these? With >5 hours of mesmerizing gameplay, 10+ game mechanics to master and all set in a beautiful minimalist style with ambient adaptive soundtracks, you can enjoy it seated or standing up!\n"}]}, "developer_name": "HEADGEAR GbR", "developer_privacy_policy_url": "https://headgear.io/legal.html", "developer_terms_of_service_url": "https://headgear.io/legal.html#terms", "publisher_name": "HEADGEAR GbR", "support_website_url": null, "website_url": "https://headgear.io/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_categ
cdn.com/v/t64.5771-25/75361355_380339049810894_8629917805136921546_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8FIKGKQB7n8Q7kNvwFYyJH9&_nc_oc=Adq33pDpxR2wzfyLm48JdrLhe5qWsYdJ5w8bi5ZW0O6Wi6l8q-VuWYvU5RkuHkilWD8&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5X_TiWicSqgSv6gAd08FjNhuqT0amcMPmHwVPKns80gQ&oe=6A1317A3"}, {"file_name": "HighresScreenshot00081.png", "id": "376313343811121", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/39031312_376313347144454_2073303015962398022_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=chKZgFSGKzcQ7kNvwGYr0N7&_nc_oc=Adr-tQmcyMgEiCpLGyHcUJZxySMnBo6IX6D-62iOw6wJ6gamYTenKf7jDnhoMxsdwaE&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6TDihuYK5cfGO-eeZS3-RBmWe1AxC5pwXVH-wpeOFkLA&oe=6A1312B7"}, {"file_name": "HighresScreenshot00034.png", "id": "361423311640761", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/75297579_361423314974094_4468664441597916853_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kQ_xaWGhE5gQ7kNvwHSzyfK&_nc_oc=AdpHIzpW_uvbKDSVUlZ01jBtZpTS5VVBr4TP-3zLg0-ZJhCQUuOnHwieJN-siz8S8co&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4sxJykwen9wn6-MgBg2LgL1yy-AZojGUGMacv47QewRA&oe=6A131120"}, {"file_name": "consume.png", "id": "356221875528110", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/39001669_356221878861443_261896368707707264_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Gn6LtMhgMzAQ7kNvwHLlzPB&_nc_oc=AdqnNlRjA6UzSsULBsaM-NvQJBxrVtbjmcOckpIx-UOXkHDRX1ESJ3zEYX4oHKHX2sM&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af67z6tVPM3PEBNEzAyKcWAVWq9fCr9ILcBrcvWalVkV6w&oe=6A12FD83"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "38982553_2716489995261681_7852865887418274915_n[1].png", "id": "1017968672039348", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38974845_1017968675372681_3537640423345626257_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B46S24f4jtIQ7kNvwGUcDHp&_nc_oc=AdpRZBhKgk2vqfPuxvfmAzXUuphv-o4-NUyE4wvjbpDz_bLqzuWVYmDhkL_UG2BNAhM&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af44ypp968ZjpdoRlrQX6IJokpS1olp0UhEg5eT0dukL3Q&oe=6A1316C6"}, "display_name": "TEOC", "keywords": ["arcade", "puzzle", "casual", "atmospheric", "puzzler"], "long_description": "Evolve from an atomic state to marine-life in this spatial arcade puzzler with just one goal: Consume or be Consumed! \n\nPowered by elemental forces and mythical artifacts navigate your way through 3 environments with 30+ rounds each to get through. Will you be able to top the leaderboard for each of these? \n\nTEOC provides\u2026\n\u2022 more than 5 hours of mesmerizing gameplay,\n\u2022 a beautiful minimalist style with ambient adaptive soundtracks,\n\u2022 10+ game mechanics to master,\n\u2022 additional powerups to collect and use across all 90+ rounds\n\u2022 with daily powerup rewards for coming back\n\u2022 to compete on the 3 leaderboards,\n\u2022 increasingly challenging level design all procedurally generated\n\u2022 and seated or standing play options!\n\n\n", "short_description": "Evolve from an atomic state to marine-life in this spatial arcade puzzler with just one goal: Consume or be Consumed! \n\nPowered by elemental forces and mythical artifacts navigate your way through 3 environments with 30+ rounds each to get through. Will you be able to top the leaderboard for each of these? With >5 hours of mesmerizing gameplay, 10+ game mechanics to master and all set in a beautiful minimalist style with ambient adaptive soundtracks, you can enjoy it seated or standing up!\n"}]}, "developer_name": "HEADGEAR GbR", "developer_privacy_policy_url": "https://headgear.io/legal.html", "developer_terms_of_service_url": "https://headgear.io/legal.html#terms", "publisher_name": "HEADGEAR GbR", "support_website_url": null, "website_url": "https://headgear.io/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_categ
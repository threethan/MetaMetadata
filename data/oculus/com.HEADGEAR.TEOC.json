cdn.com/v/t64.5771-25/75361355_380339049810894_8629917805136921546_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=in3AycDbcRIQ7kNvwHsFP_i&_nc_oc=AdqD5cfyCWTcRMTRccAOPDLrpzerTdes5X8pflelLrQWWfAzziG6GjA-ci6veVy7gOM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5RHLAUxzpBKHQcD51LeC0jShNO7AbJ5M19pGBzoMzzDQ&oe=6A01F423"}, {"file_name": "HighresScreenshot00081.png", "id": "376313343811121", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031312_376313347144454_2073303015962398022_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nbT2LtnuOmEQ7kNvwE2_djD&_nc_oc=AdoXr8FiHHHFUvObjM1F_Fwl6cIs0EUZXy_ydgB5_C50F9Lq7xNn4hW3pl-KuwfD_qY&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6n7e8R7e3kP_MAYQzm2OEFGpsAowwYkWNtlhQI2cqCtQ&oe=6A01EF37"}, {"file_name": "HighresScreenshot00034.png", "id": "361423311640761", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75297579_361423314974094_4468664441597916853_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=coO3Gv1Q0EwQ7kNvwEivWft&_nc_oc=AdpxXps-cGDNeRdLBPWmMAH9YurVithQM0qXnIOI8kebhAi1SNITptNluzy7ENfNAFU&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5f3zmhwZNAziCeEoCFC8pOwJVYXoI2i-7NIggVOc0t7g&oe=6A01EDA0"}, {"file_name": "consume.png", "id": "356221875528110", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39001669_356221878861443_261896368707707264_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6EDLXQz4MmYQ7kNvwGvrZWj&_nc_oc=Ado0CygxNjQHU3eEhrTKLkQFkCZWK-bE0Eu1vZOPAxDVlXOLiQccE90wmE67pPlq9RQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4TLfwM7pmFVDiGjdVFfNSxUaoc2H2sLJBlOSmqPUBTjQ&oe=6A01DA03"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "38982553_2716489995261681_7852865887418274915_n[1].png", "id": "1017968672039348", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974845_1017968675372681_3537640423345626257_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XmaXTgsCexsQ7kNvwEpJf2c&_nc_oc=AdrGa0404PNG1fHo4yxk8rkidgOYzWqUWtKuRdpprOZunXHFCAWrm4pCUmCBuXg8loc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af59v8c4GCVlef7mcTAaj6f00s_kaLG8nvhabbtMvyNtMA&oe=6A01F346"}, "display_name": "TEOC", "keywords": ["arcade", "puzzle", "casual", "atmospheric", "puzzler"], "long_description": "Evolve from an atomic state to marine-life in this spatial arcade puzzler with just one goal: Consume or be Consumed! \n\nPowered by elemental forces and mythical artifacts navigate your way through 3 environments with 30+ rounds each to get through. Will you be able to top the leaderboard for each of these? \n\nTEOC provides\u2026\n\u2022 more than 5 hours of mesmerizing gameplay,\n\u2022 a beautiful minimalist style with ambient adaptive soundtracks,\n\u2022 10+ game mechanics to master,\n\u2022 additional powerups to collect and use across all 90+ rounds\n\u2022 with daily powerup rewards for coming back\n\u2022 to compete on the 3 leaderboards,\n\u2022 increasingly challenging level design all procedurally generated\n\u2022 and seated or standing play options!\n\n\n", "short_description": "Evolve from an atomic state to marine-life in this spatial arcade puzzler with just one goal: Consume or be Consumed! \n\nPowered by elemental forces and mythical artifacts navigate your way through 3 environments with 30+ rounds each to get through. Will you be able to top the leaderboard for each of these? With >5 hours of mesmerizing gameplay, 10+ game mechanics to master and all set in a beautiful minimalist style with ambient adaptive soundtracks, you can enjoy it seated or standing up!\n"}]}, "developer_name": "HEADGEAR GbR", "developer_privacy_policy_url": "https://headgear.io/legal.html", "developer_terms_of_service_url": "https://headgear.io/legal.html#terms", "publisher_name": "HEADGEAR GbR", "support_website_url": null, "website_url": "https://headgear.io/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_categ
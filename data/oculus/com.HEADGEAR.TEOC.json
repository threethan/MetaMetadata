cdn.com/v/t64.5771-25/75361355_380339049810894_8629917805136921546_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k9VzQ6WK7NUQ7kNvwHe3eM7&_nc_oc=AdpvcZkfX8avvtr1SSBkHww5xc-eN08XZYr0d9ZFFNgipj9oS5di-zmQNCMVHbWWu9M&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQALaI9c2wugwfgZurMGAQJVXbGEYFvbvmUIUd9XlBqnhg&oe=6A5E04E3"}, {"file_name": "HighresScreenshot00081.png", "id": "376313343811121", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031312_376313347144454_2073303015962398022_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZLAMpf3Fha8Q7kNvwEXgEoM&_nc_oc=AdqyxGzb3idJcQ23LH3WK2nVJ_5khssiEnOwI1JBAQGiXlhdaRG50XgYh9FH29eY7Wo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQACWmCcMqZsMjRY1O2DX_EwalCLzg95oCLemMlchs2Lmg&oe=6A5E3837"}, {"file_name": "HighresScreenshot00034.png", "id": "361423311640761", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75297579_361423314974094_4468664441597916853_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pPLm5_9mQvAQ7kNvwHdNRAO&_nc_oc=Adp1-nLI33b6ur_D8mc8QyrBHi43_oBuODOhjpSd8EX4zp2NTHm8CZ5O9DTXG0nHJ3E&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAqF5-wuChq0a_BSLpI05cu4qlePd50PmJNj3yYXDpi7A&oe=6A5E36A0"}, {"file_name": "consume.png", "id": "356221875528110", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39001669_356221878861443_261896368707707264_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fQWR9FWUgUAQ7kNvwGjr9BB&_nc_oc=AdqRty7ys1SFBaVdnhUHDrgi9Ivnh-80AayG0OrhaarKKiqACGP9XMwLhMMnKiWI9Og&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA-g5_JN3S-cvaYQkBh1WFq1HQiziYf4mk1TXnWYTsvAA&oe=6A5E2303"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "38982553_2716489995261681_7852865887418274915_n[1].png", "id": "1017968672039348", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974845_1017968675372681_3537640423345626257_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1bd8EgjQhisQ7kNvwH7t4fe&_nc_oc=AdoeOxJyGhNO1lFlzkXnxn_MfWROtqrd_-BFRQL2k29t5v9KqddBldh8mgqh42wxgBg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQByD7O0iSPH0AU2JvGAkoPqIbrEXcsWQOd_J0OlGAloEQ&oe=6A5E0406"}, "display_name": "TEOC", "keywords": ["arcade", "puzzle", "casual", "atmospheric", "puzzler"], "long_description": "Evolve from an atomic state to marine-life in this spatial arcade puzzler with just one goal: Consume or be Consumed! \n\nPowered by elemental forces and mythical artifacts navigate your way through 3 environments with 30+ rounds each to get through. Will you be able to top the leaderboard for each of these? \n\nTEOC provides\u2026\n\u2022 more than 5 hours of mesmerizing gameplay,\n\u2022 a beautiful minimalist style with ambient adaptive soundtracks,\n\u2022 10+ game mechanics to master,\n\u2022 additional powerups to collect and use across all 90+ rounds\n\u2022 with daily powerup rewards for coming back\n\u2022 to compete on the 3 leaderboards,\n\u2022 increasingly challenging level design all procedurally generated\n\u2022 and seated or standing play options!\n\n\n", "short_description": "Evolve from an atomic state to marine-life in this spatial arcade puzzler with just one goal: Consume or be Consumed! \n\nPowered by elemental forces and mythical artifacts navigate your way through 3 environments with 30+ rounds each to get through. Will you be able to top the leaderboard for each of these? With >5 hours of mesmerizing gameplay, 10+ game mechanics to master and all set in a beautiful minimalist style with ambient adaptive soundtracks, you can enjoy it seated or standing up!\n"}]}, "developer_name": "HEADGEAR GbR", "developer_privacy_policy_url": "https://headgear.io/legal.html", "developer_terms_of_service_url": "https://headgear.io/legal.html#terms", "publisher_name": "HEADGEAR GbR", "support_website_url": null, "website_url": "https://headgear.io/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_categ
cdn.com/v/t64.5771-25/75361355_380339049810894_8629917805136921546_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YhvvFJmtjl0Q7kNvwHjqZeA&_nc_oc=AdpUKgflIh6MD5oUNhafqkIJmhrv-SWaxKZozkJnIGfjw_6mklY3OEIyTuPvMHs6lRc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDJfvEv5WIfDoMOFiTNlZOLOYI9xXLr2xyZzMt3qbCgRQ&oe=6A6231A3"}, {"file_name": "HighresScreenshot00081.png", "id": "376313343811121", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031312_376313347144454_2073303015962398022_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1M4CNBycTL0Q7kNvwHDxfgG&_nc_oc=AdpMAf0-H6FA0ySpaicmzIqNezMr81TE6bWvqugAcN5XwA3mD5kCupsI-xFRMWzqAEQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAg2PHFUOF3rtSLS_TI_cxOpoG5nQ0f0ZeRG_eIackgNw&oe=6A622CB7"}, {"file_name": "HighresScreenshot00034.png", "id": "361423311640761", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75297579_361423314974094_4468664441597916853_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QYCGaYCnlWAQ7kNvwG8d6YP&_nc_oc=Adr9wJyR-fsxxT7_6acnlKZA4XcMXfhQngRXz1jF7EEB6EdifJ85v-qkTmDl-eILWrc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCih0UspcM9nPo58JuuZoyJq9aeJegb5Tk6mZA2SUhJEA&oe=6A622B20"}, {"file_name": "consume.png", "id": "356221875528110", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39001669_356221878861443_261896368707707264_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=quuAkUEb_N0Q7kNvwGRVeq6&_nc_oc=AdpZRp0bKk04UAY17mNI4FgZzk3YRpTTTJD_l5pF2mqBsKvhijtzns-PaIS8SBfGeVM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBg0RiwpRMSEA0cEt3jYVHUJwHX0Ip-ClV8VHIRUSyPFg&oe=6A621783"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "38982553_2716489995261681_7852865887418274915_n[1].png", "id": "1017968672039348", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974845_1017968675372681_3537640423345626257_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l1xcIvlMalYQ7kNvwFr_aZ6&_nc_oc=AdqiU3wSxRnKoBr8BeMQ-ShPbC0eUBOdGazGhKxqpWKlZP8LdK2CoWLd3CbqfLEBA80&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC5T08CZ-K1x8Y3btPouQIV9HBmaJ8GHry076iDx3iaRQ&oe=6A6230C6"}, "display_name": "TEOC", "keywords": ["arcade", "puzzle", "casual", "atmospheric", "puzzler"], "long_description": "Evolve from an atomic state to marine-life in this spatial arcade puzzler with just one goal: Consume or be Consumed! \n\nPowered by elemental forces and mythical artifacts navigate your way through 3 environments with 30+ rounds each to get through. Will you be able to top the leaderboard for each of these? \n\nTEOC provides\u2026\n\u2022 more than 5 hours of mesmerizing gameplay,\n\u2022 a beautiful minimalist style with ambient adaptive soundtracks,\n\u2022 10+ game mechanics to master,\n\u2022 additional powerups to collect and use across all 90+ rounds\n\u2022 with daily powerup rewards for coming back\n\u2022 to compete on the 3 leaderboards,\n\u2022 increasingly challenging level design all procedurally generated\n\u2022 and seated or standing play options!\n\n\n", "short_description": "Evolve from an atomic state to marine-life in this spatial arcade puzzler with just one goal: Consume or be Consumed! \n\nPowered by elemental forces and mythical artifacts navigate your way through 3 environments with 30+ rounds each to get through. Will you be able to top the leaderboard for each of these? With >5 hours of mesmerizing gameplay, 10+ game mechanics to master and all set in a beautiful minimalist style with ambient adaptive soundtracks, you can enjoy it seated or standing up!\n"}]}, "developer_name": "HEADGEAR GbR", "developer_privacy_policy_url": "https://headgear.io/legal.html", "developer_terms_of_service_url": "https://headgear.io/legal.html#terms", "publisher_name": "HEADGEAR GbR", "support_website_url": null, "website_url": "https://headgear.io/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_categ
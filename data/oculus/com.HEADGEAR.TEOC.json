80339049810894_8629917805136921546_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xUhdEoUJUNgQ7kNvwH9GD9B&_nc_oc=Adlf7L7mzn-B6xZym-4Ou4z2356CyuJiSGiRY-0FAVUqz1m6P_vkJIE3RgjvOz9grZs&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfxeFeyA0Hzbsf0R72RvtET_uknW3M3DFriDr_Th-DuwaQ&oe=69AD5BE3"}, {"file_name": "HighresScreenshot00081.png", "id": "376313343811121", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031312_376313347144454_2073303015962398022_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oIGLyQuiSsYQ7kNvwERdP6o&_nc_oc=AdmDN9fuBAQ8Oj5_PHVDAYtbd8GMIOtMlH2GrufL1l6INb6t9_aFNZW5_JF8fOQ9ZIc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afx7rpF1kEIrWPxQj-4D3PWO4Us2kvPz07XIwnUrCVcaPQ&oe=69AD56F7"}, {"file_name": "HighresScreenshot00034.png", "id": "361423311640761", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75297579_361423314974094_4468664441597916853_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E8lra5nhuU0Q7kNvwH7zlMK&_nc_oc=AdmnZXcWRtzAVaqevv0cnWhHqUZHAbe2X1XR6--0BfsfTiHKVTggPkBuSPcfW5xBcr8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afww8XX8gCFhpHcuFx8vVsttEhErNl6hWWKHxOtrwf6h7g&oe=69AD5560"}, {"file_name": "consume.png", "id": "356221875528110", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39001669_356221878861443_261896368707707264_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qfzcjz9ir3oQ7kNvwGqY_iA&_nc_oc=Adl0NpOS4NEDXoPN4IDBjQBy8t15BSY_DqATmdx1u6CeusCExF0c8-vy20TdBkXzvf8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afz0A1eVOBn1h1wLuNM62UL3DI2eUdVRPTNUJiKmJ9VYcA&oe=69AD7A03"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "38982553_2716489995261681_7852865887418274915_n[1].png", "id": "1017968672039348", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974845_1017968675372681_3537640423345626257_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BOkldBl1r5wQ7kNvwH8fOOd&_nc_oc=AdlrshwQMfR_O6CjP8H2JHM25cCD70L_MhWvwZKu4mccv_4VNjantifX2JrJ6rym80M&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfxpLzkHKrFoAPywoYjbrfDB4aoX0mKdmtz0yNTKD4Q2wg&oe=69AD5B06"}, "display_name": "TEOC", "keywords": ["arcade", "puzzle", "casual", "atmospheric", "puzzler"], "long_description": "Evolve from an atomic state to marine-life in this spatial arcade puzzler with just one goal: Consume or be Consumed! \n\nPowered by elemental forces and mythical artifacts navigate your way through 3 environments with 30+ rounds each to get through. Will you be able to top the leaderboard for each of these? \n\nTEOC provides\u2026\n\u2022 more than 5 hours of mesmerizing gameplay,\n\u2022 a beautiful minimalist style with ambient adaptive soundtracks,\n\u2022 10+ game mechanics to master,\n\u2022 additional powerups to collect and use across all 90+ rounds\n\u2022 with daily powerup rewards for coming back\n\u2022 to compete on the 3 leaderboards,\n\u2022 increasingly challenging level design all procedurally generated\n\u2022 and seated or standing play options!\n\n\n", "short_description": "Evolve from an atomic state to marine-life in this spatial arcade puzzler with just one goal: Consume or be Consumed! \n\nPowered by elemental forces and mythical artifacts navigate your way through 3 environments with 30+ rounds each to get through. Will you be able to top the leaderboard for each of these? With >5 hours of mesmerizing gameplay, 10+ game mechanics to master and all set in a beautiful minimalist style with ambient adaptive soundtracks, you can enjoy it seated or standing up!\n"}]}, "developer_name": "HEADGEAR GbR", "developer_privacy_policy_url": "https://headgear.io/legal.html", "developer_terms_of_service_url": "https://headgear.io/legal.html#terms", "publisher_name": "HEADGEAR GbR", "support_website_url": null, "website_url": "https://headgear.io/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscrip
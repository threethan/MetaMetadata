cdn.com/v/t64.5771-25/75361355_380339049810894_8629917805136921546_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1HmB5AkqotcQ7kNvwHAvFEb&_nc_oc=AdoBY7tUcxHGM_9awxh2-Hxoyl7CM4ATr_sdslGqQZ6NwGoP2BaPm5pGPgW1vwOxOn4&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_tB9jA9J-Jvdw2LVXqBtXsXd7mFMm5wOuobwwTU0auvw&oe=6A32BBA3"}, {"file_name": "HighresScreenshot00081.png", "id": "376313343811121", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/39031312_376313347144454_2073303015962398022_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CMhqaBt-3IMQ7kNvwGvEkuf&_nc_oc=AdrSxjgJNFb8YPUh_03xmwO6a6ca5ErdIdpBhmJVYSIkZCX4jx7q6Ok7BtnI37xBwHM&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_-zFUz1H2XWqyJEjlwBqbtiHngFtO3mDel6_ypkJyhRQ&oe=6A32B6B7"}, {"file_name": "HighresScreenshot00034.png", "id": "361423311640761", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/75297579_361423314974094_4468664441597916853_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BVWzB9-eJZoQ7kNvwELMojN&_nc_oc=AdoOALEhedbD9I3eZ6B3MKP4PoaIYPy2bd_t_9l2rwcEyQIuGYWSfnVvR86v458I24Q&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-DHQ9TXjv2mc0yYZ4c6280Ah_YLkvP3uMX5crYgjMXhQ&oe=6A32B520"}, {"file_name": "consume.png", "id": "356221875528110", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/39001669_356221878861443_261896368707707264_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-xscWyntBUYQ7kNvwHibDQ-&_nc_oc=AdoDY-z1TCo513SctDonxM_wA4F1bxhsfVb9mkaw835YNiFlHBkQO7TmaY0GKdzIuqs&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_OuVBoWbo2wYMsYcKyudRUYk-hFPFGMW8lHv71VkXwBw&oe=6A32A183"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "38982553_2716489995261681_7852865887418274915_n[1].png", "id": "1017968672039348", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/38974845_1017968675372681_3537640423345626257_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iCZqHaoRB3oQ7kNvwG1iGqu&_nc_oc=AdorKKig7V_X8IOwnQVLSF_hD3Ny99qPbRKvMZUtaD866-DVmOd9nPGzeLdnD_8_tFw&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9eGM7TcRKdZP3_qlHSD_yNrOzp7Pzke2uFGbw11ftnrQ&oe=6A32BAC6"}, "display_name": "TEOC", "keywords": ["arcade", "puzzle", "casual", "atmospheric", "puzzler"], "long_description": "Evolve from an atomic state to marine-life in this spatial arcade puzzler with just one goal: Consume or be Consumed! \n\nPowered by elemental forces and mythical artifacts navigate your way through 3 environments with 30+ rounds each to get through. Will you be able to top the leaderboard for each of these? \n\nTEOC provides\u2026\n\u2022 more than 5 hours of mesmerizing gameplay,\n\u2022 a beautiful minimalist style with ambient adaptive soundtracks,\n\u2022 10+ game mechanics to master,\n\u2022 additional powerups to collect and use across all 90+ rounds\n\u2022 with daily powerup rewards for coming back\n\u2022 to compete on the 3 leaderboards,\n\u2022 increasingly challenging level design all procedurally generated\n\u2022 and seated or standing play options!\n\n\n", "short_description": "Evolve from an atomic state to marine-life in this spatial arcade puzzler with just one goal: Consume or be Consumed! \n\nPowered by elemental forces and mythical artifacts navigate your way through 3 environments with 30+ rounds each to get through. Will you be able to top the leaderboard for each of these? With >5 hours of mesmerizing gameplay, 10+ game mechanics to master and all set in a beautiful minimalist style with ambient adaptive soundtracks, you can enjoy it seated or standing up!\n"}]}, "developer_name": "HEADGEAR GbR", "developer_privacy_policy_url": "https://headgear.io/legal.html", "developer_terms_of_service_url": "https://headgear.io/legal.html#terms", "publisher_name": "HEADGEAR GbR", "support_website_url": null, "website_url": "https://headgear.io/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_categ
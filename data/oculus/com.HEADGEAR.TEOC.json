cdn.com/v/t64.5771-25/75361355_380339049810894_8629917805136921546_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8eLbK5Q-4OUQ7kNvwH306dc&_nc_oc=Adp6ACArZJfmTjXGVur9rDwnl6v0jh9ybbj3Q-Ox3DT-h8LPEKnQHCaQ3Mrq1u33qiQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af35O6tJZIQhQVaA617j5-kfKYglCzCuiQ4sH1rQFXPf3Q&oe=69DB8063"}, {"file_name": "HighresScreenshot00081.png", "id": "376313343811121", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031312_376313347144454_2073303015962398022_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GfdI2VsUKdAQ7kNvwGL0Hh4&_nc_oc=AdpKtYiMevuW06gd2F2UaCMzw6FDjswT7SnzEPdYr2L5RocTjYYMi6oMEjckXzSOOY0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3J1Arx_3P2OlbskoE3LgDT_Xhanp8KPH6JxtCJfuO_Pw&oe=69DB7B77"}, {"file_name": "HighresScreenshot00034.png", "id": "361423311640761", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75297579_361423314974094_4468664441597916853_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RiDNsEIVU5AQ7kNvwGnx4kK&_nc_oc=Adpl8-kDbk4U7pWqJlI1TNCOPzRPiWPW510B53ojFZijmHEFp9NvyrfhwYcGCVHMXh8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af07tXCHnzQbuRdu5nj1LVM_gBedXswqwuUWyaFlWkM5FQ&oe=69DBB220"}, {"file_name": "consume.png", "id": "356221875528110", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39001669_356221878861443_261896368707707264_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YVa5mpCwS_wQ7kNvwE2HLt-&_nc_oc=AdpV81IgtLL1XSoHp_xOrR_p_BV-b2EiNo5DkDVMwuq6YAdZppfsGz5dcQZIP5Bh0YE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1QDC-FoH42K0JKQ8deYBiM3Xh7uv8D5oemKQAhunwyoA&oe=69DB9E83"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "38982553_2716489995261681_7852865887418274915_n[1].png", "id": "1017968672039348", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974845_1017968675372681_3537640423345626257_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m4lxq5gTtgIQ7kNvwGYyMjW&_nc_oc=AdpWeWvOVkD77BkQeRI3ZYozgx-20ahtY6YKSuXzeHiUyJrN2tFMTOTkCDpWEHMdkcg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0-6akQnjVkwGlF5hqmAetMUeMiuqATmfUDlP2xnRb_tA&oe=69DB7F86"}, "display_name": "TEOC", "keywords": ["arcade", "puzzle", "casual", "atmospheric", "puzzler"], "long_description": "Evolve from an atomic state to marine-life in this spatial arcade puzzler with just one goal: Consume or be Consumed! \n\nPowered by elemental forces and mythical artifacts navigate your way through 3 environments with 30+ rounds each to get through. Will you be able to top the leaderboard for each of these? \n\nTEOC provides\u2026\n\u2022 more than 5 hours of mesmerizing gameplay,\n\u2022 a beautiful minimalist style with ambient adaptive soundtracks,\n\u2022 10+ game mechanics to master,\n\u2022 additional powerups to collect and use across all 90+ rounds\n\u2022 with daily powerup rewards for coming back\n\u2022 to compete on the 3 leaderboards,\n\u2022 increasingly challenging level design all procedurally generated\n\u2022 and seated or standing play options!\n\n\n", "short_description": "Evolve from an atomic state to marine-life in this spatial arcade puzzler with just one goal: Consume or be Consumed! \n\nPowered by elemental forces and mythical artifacts navigate your way through 3 environments with 30+ rounds each to get through. Will you be able to top the leaderboard for each of these? With >5 hours of mesmerizing gameplay, 10+ game mechanics to master and all set in a beautiful minimalist style with ambient adaptive soundtracks, you can enjoy it seated or standing up!\n"}]}, "developer_name": "HEADGEAR GbR", "developer_privacy_policy_url": "https://headgear.io/legal.html", "developer_terms_of_service_url": "https://headgear.io/legal.html#terms", "publisher_name": "HEADGEAR GbR", "support_website_url": null, "website_url": "https://headgear.io/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_categ
cdn.com/v/t64.5771-25/75361355_380339049810894_8629917805136921546_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3DXlXLnT7vMQ7kNvwGEgyY3&_nc_oc=Adq7TPM6m9l3E538nA4qYgFIGObYCMldUDXIQIC8SN7nPugZ-RG3aWu3BeRhYVsz2uU&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMibYJbbiz9suq2zHb-g3mwm2yS4qcZVCaQUlTNA7niYg&oe=6AD0EFA3"}, {"file_name": "HighresScreenshot00081.png", "id": "376313343811121", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/39031312_376313347144454_2073303015962398022_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rta6wHpS3_YQ7kNvwEJPGdK&_nc_oc=Adrt7fVJsO1kSUNy3qGV37rgeMTjihUC7onvZBVjUirgUf3fR-xLBdxL5KoiAt9YuQM&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNW6xDavMA83J3wqA0tVaogcXccstU0rp_jSaZYw_o4pw&oe=6AD0EAB7"}, {"file_name": "HighresScreenshot00034.png", "id": "361423311640761", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/75297579_361423314974094_4468664441597916853_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gei9TF8W5KwQ7kNvwFr5xwL&_nc_oc=AdpmiRShK3qFy_Roh0kHTKE2J5U-D-wYcCrTgQ1BcEEhniFUni73n3V1LvkKc4uIuSo&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMmfOvpd24Z40-is5-e0PX3v95S6CXH15yKYPLT4lTcHg&oe=6AD0E920"}, {"file_name": "consume.png", "id": "356221875528110", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/39001669_356221878861443_261896368707707264_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V023mOICNKEQ7kNvwEM2pQZ&_nc_oc=AdoUHkPuMX6S8a4s9f3Ci-MkCuAVajKmGWcB-lJgCTWRYp9n6NvbJBkjcdzpjgpXaIY&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOpohu3xw-IJmuo8dvBpaQ99t4AVdtTONkX7nzacWjocA&oe=6AD0D583"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "38982553_2716489995261681_7852865887418274915_n[1].png", "id": "1017968672039348", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38974845_1017968675372681_3537640423345626257_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GsIo6vHGHtkQ7kNvwHxAkWC&_nc_oc=AdrVqZNSZaX8kGW5pI5eOxhOsgEwFFRV5y2dT6a6ViS2hwrtKnxJK-l6UDMwwJilUmk&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP9aQa10xFQt6aOWk1gwR_Zu-fsMejbZkMK5sbtvfrHOQ&oe=6AD0EEC6"}, "display_name": "TEOC", "keywords": ["arcade", "puzzle", "casual", "atmospheric", "puzzler"], "long_description": "Evolve from an atomic state to marine-life in this spatial arcade puzzler with just one goal: Consume or be Consumed! \n\nPowered by elemental forces and mythical artifacts navigate your way through 3 environments with 30+ rounds each to get through. Will you be able to top the leaderboard for each of these? \n\nTEOC provides\u2026\n\u2022 more than 5 hours of mesmerizing gameplay,\n\u2022 a beautiful minimalist style with ambient adaptive soundtracks,\n\u2022 10+ game mechanics to master,\n\u2022 additional powerups to collect and use across all 90+ rounds\n\u2022 with daily powerup rewards for coming back\n\u2022 to compete on the 3 leaderboards,\n\u2022 increasingly challenging level design all procedurally generated\n\u2022 and seated or standing play options!\n\n\n", "short_description": "Evolve from an atomic state to marine-life in this spatial arcade puzzler with just one goal: Consume or be Consumed! \n\nPowered by elemental forces and mythical artifacts navigate your way through 3 environments with 30+ rounds each to get through. Will you be able to top the leaderboard for each of these? With >5 hours of mesmerizing gameplay, 10+ game mechanics to master and all set in a beautiful minimalist style with ambient adaptive soundtracks, you can enjoy it seated or standing up!\n"}]}, "developer_name": "HEADGEAR GbR", "developer_privacy_policy_url": "https://headgear.io/legal.html", "developer_terms_of_service_url": "https://headgear.io/legal.html#terms", "publisher_name": "HEADGEAR GbR", "support_website_url": null, "website_url": "https://headgear.io/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_categ
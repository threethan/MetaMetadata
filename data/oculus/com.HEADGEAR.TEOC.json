cdn.com/v/t64.5771-25/75361355_380339049810894_8629917805136921546_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3DXlXLnT7vMQ7kNvwG3JUTA&_nc_oc=AdptReKdJaDlKegu3dJK2xLKzmLTfXzcRR8d5Nc0GTU8HTSTrlm33huZu51uDkd1qNc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPASEK-XwmWg4sO4PiBBDeuAeA71z6LlHYdi0lRDfiLiw&oe=6AD24123"}, {"file_name": "HighresScreenshot00081.png", "id": "376313343811121", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031312_376313347144454_2073303015962398022_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rta6wHpS3_YQ7kNvwF7qX40&_nc_oc=AdpmRYPi6HzopfFjYjtLl9L8yut3zFJBR7V0IKCvuOM3kG4Il2UGPwSp-db8PQqgq28&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPRs_0yvJpPHjkU4JKtwIfU_wqlVFMDWUTRFQIChyhWDw&oe=6AD23C37"}, {"file_name": "HighresScreenshot00034.png", "id": "361423311640761", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75297579_361423314974094_4468664441597916853_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gei9TF8W5KwQ7kNvwGeyMEM&_nc_oc=AdoJaGDo8UOeN71NyoA--IeBQF_2f3Wy5ZRg2iDiRIcRFRZmTBVpdDJGGrNZhdG2G3E&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNA0CRRYiOz-0qeb3iNA5kVGscwbqOSDeb-sxoYMh01pA&oe=6AD23AA0"}, {"file_name": "consume.png", "id": "356221875528110", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39001669_356221878861443_261896368707707264_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EGk3JU7buF0Q7kNvwF7oVic&_nc_oc=AdojYPx-gqdOc3WusXGyg0ffXMUWa9P1Km4Xq1qpMLfj0hByqpUn9TJ_A3lS5ZUYUmU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPgvloCQlUecoCQFes1VyNnbKPaxH46M3xcX_JW4qug-g&oe=6AD22703"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "38982553_2716489995261681_7852865887418274915_n[1].png", "id": "1017968672039348", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974845_1017968675372681_3537640423345626257_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GsIo6vHGHtkQ7kNvwHdgV-D&_nc_oc=AdpHFYRXfpDsDDumuT7sz7WBj3BgAtJIeRuWRfczZiP1hVkXoNNEC0sVmv-2_V3yCoE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQME7dnOLa9e1nL_W-KwXfLqu5D8gNnHBmglqGPxhQuHCA&oe=6AD24046"}, "display_name": "TEOC", "keywords": ["arcade", "puzzle", "casual", "atmospheric", "puzzler"], "long_description": "Evolve from an atomic state to marine-life in this spatial arcade puzzler with just one goal: Consume or be Consumed! \n\nPowered by elemental forces and mythical artifacts navigate your way through 3 environments with 30+ rounds each to get through. Will you be able to top the leaderboard for each of these? \n\nTEOC provides\u2026\n\u2022 more than 5 hours of mesmerizing gameplay,\n\u2022 a beautiful minimalist style with ambient adaptive soundtracks,\n\u2022 10+ game mechanics to master,\n\u2022 additional powerups to collect and use across all 90+ rounds\n\u2022 with daily powerup rewards for coming back\n\u2022 to compete on the 3 leaderboards,\n\u2022 increasingly challenging level design all procedurally generated\n\u2022 and seated or standing play options!\n\n\n", "short_description": "Evolve from an atomic state to marine-life in this spatial arcade puzzler with just one goal: Consume or be Consumed! \n\nPowered by elemental forces and mythical artifacts navigate your way through 3 environments with 30+ rounds each to get through. Will you be able to top the leaderboard for each of these? With >5 hours of mesmerizing gameplay, 10+ game mechanics to master and all set in a beautiful minimalist style with ambient adaptive soundtracks, you can enjoy it seated or standing up!\n"}]}, "developer_name": "HEADGEAR GbR", "developer_privacy_policy_url": "https://headgear.io/legal.html", "developer_terms_of_service_url": "https://headgear.io/legal.html#terms", "publisher_name": "HEADGEAR GbR", "support_website_url": null, "website_url": "https://headgear.io/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_categ
cdn.com/v/t64.5771-25/75361355_380339049810894_8629917805136921546_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YIqNelxwJ5kQ7kNvwGEdWhy&_nc_oc=AdoKbQcqpGYrUdaT7q-Ll1EZPT-l5NaD3ovomOQOmnUZlKZtsyy9Dbp3-iGRb7-iNXs&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR-GVjmiKia7adq-DcCRBQVyGcfWId18KAzCoqhtfNIgA&oe=6AEB4DA3"}, {"file_name": "HighresScreenshot00081.png", "id": "376313343811121", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031312_376313347144454_2073303015962398022_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aXKYZ4_1pKoQ7kNvwH-2m7y&_nc_oc=AdrGpzunbFGBfJncBGDuGELkQFweB7fadwOPfpRYRFgC8FB1hdRD-XGaDfGjutAIlNU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRa2otr4XGcK8c4mo783e-9K2kTwBwYOFKDwgPREifp2A&oe=6AEB48B7"}, {"file_name": "HighresScreenshot00034.png", "id": "361423311640761", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75297579_361423314974094_4468664441597916853_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tozzewdqn2gQ7kNvwGqK-G3&_nc_oc=AdrsB8h_jzvkow-0hcm0c1QKfprewtvJoqQQWU3oJ8xVRJ-xFXPBHcpkq4jdI4k6JNs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSp5HJEJjndOTR44JeEJ8qX9AOUevTHt3QwPITb7b2fGg&oe=6AEB4720"}, {"file_name": "consume.png", "id": "356221875528110", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39001669_356221878861443_261896368707707264_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wdsj4k4QMhEQ7kNvwE8WKC9&_nc_oc=Adpfrk09IigtpOXVzTXjzWIWasjP-ac5JLKV0bNpBYdsfUZGzdqg1Ud3it9njnc1iHw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRBp4cHPo20_S-xTv8LE4J77GbO4YjP6lPMlYSxCjeFAA&oe=6AEB3383"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "38982553_2716489995261681_7852865887418274915_n[1].png", "id": "1017968672039348", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974845_1017968675372681_3537640423345626257_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=py594lL3S8UQ7kNvwFM8-ik&_nc_oc=Adq7KoD0BtOHmjjPh0fyyIZ1hP78b_vUuJd1hYf_-7dFiSwKHciWQfiq9vbzkPsn6Ac&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQROj-fynUJdpT5RWfw4Hy9zibcoVmzZrGL89DVE_E7ckQ&oe=6AEB4CC6"}, "display_name": "TEOC", "keywords": ["arcade", "puzzle", "casual", "atmospheric", "puzzler"], "long_description": "Evolve from an atomic state to marine-life in this spatial arcade puzzler with just one goal: Consume or be Consumed! \n\nPowered by elemental forces and mythical artifacts navigate your way through 3 environments with 30+ rounds each to get through. Will you be able to top the leaderboard for each of these? \n\nTEOC provides\u2026\n\u2022 more than 5 hours of mesmerizing gameplay,\n\u2022 a beautiful minimalist style with ambient adaptive soundtracks,\n\u2022 10+ game mechanics to master,\n\u2022 additional powerups to collect and use across all 90+ rounds\n\u2022 with daily powerup rewards for coming back\n\u2022 to compete on the 3 leaderboards,\n\u2022 increasingly challenging level design all procedurally generated\n\u2022 and seated or standing play options!\n\n\n", "short_description": "Evolve from an atomic state to marine-life in this spatial arcade puzzler with just one goal: Consume or be Consumed! \n\nPowered by elemental forces and mythical artifacts navigate your way through 3 environments with 30+ rounds each to get through. Will you be able to top the leaderboard for each of these? With >5 hours of mesmerizing gameplay, 10+ game mechanics to master and all set in a beautiful minimalist style with ambient adaptive soundtracks, you can enjoy it seated or standing up!\n"}]}, "developer_name": "HEADGEAR GbR", "developer_privacy_policy_url": "https://headgear.io/legal.html", "developer_terms_of_service_url": "https://headgear.io/legal.html#terms", "publisher_name": "HEADGEAR GbR", "support_website_url": null, "website_url": "https://headgear.io/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_categ
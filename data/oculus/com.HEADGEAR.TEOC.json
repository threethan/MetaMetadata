cdn.com/v/t64.5771-25/75361355_380339049810894_8629917805136921546_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g-Va2f3w7dwQ7kNvwGCy4ka&_nc_oc=AdpOtTet0vKR4AOk-2V7QG39gU5O3VUzEDaOrvgtZ7drpY5PkIAHn8CTknIiGw97bUE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af266QaXLoZoJk9DiqWTcLjBQvxbiP3Q1QiMWL1MZlBuTw&oe=69EDF563"}, {"file_name": "HighresScreenshot00081.png", "id": "376313343811121", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031312_376313347144454_2073303015962398022_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DAb8B7wnSfMQ7kNvwG7TRUb&_nc_oc=Adoq9wtmTwIQO32nFZ2kKceMTSjH0KK7jsZN45riRlrWS5ojry9cA1v6EZ3NaxaVXuE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2Cah6rPYwF5vQkmoVKQJV43UXf_oaeHKqvCVe67-IMmg&oe=69EDF077"}, {"file_name": "HighresScreenshot00034.png", "id": "361423311640761", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75297579_361423314974094_4468664441597916853_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uEeJxQlx93gQ7kNvwFSen_a&_nc_oc=AdpPIPajIdxrOTwqxTCaDMEFk2GalytEz_y89fAWpxr-Y4yCXKofKivkuMn7ReSd1Ps&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3Nnhw1fZ7BmjT9FjhMp690Si4dmWM_O2eeHG9kSBULig&oe=69EE2720"}, {"file_name": "consume.png", "id": "356221875528110", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39001669_356221878861443_261896368707707264_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g9OyVU6k-kwQ7kNvwHnLfhG&_nc_oc=AdojhSAG-DzdsZ1UrA2YhHGLTpzLejpJ2eveq1_zMcOpl7mBk9Ic_5biNkT_TCg4JfU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0ckf8MnZJV6hjzUA6hC7DEPmxhGLrgmsS7aq5x3dAPvw&oe=69EE1383"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "38982553_2716489995261681_7852865887418274915_n[1].png", "id": "1017968672039348", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974845_1017968675372681_3537640423345626257_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aaZHwAga0ZkQ7kNvwFxnpnJ&_nc_oc=AdrU-UFa8500WBBezVrbj7jLmd9UFv_1ihKZ9UW10-4RhmlwXQV5LJgN6jdS4qTxR0c&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1BiLKHcpbc_OJXSA868iKXvSdXH56njH7P9ugDiecsBg&oe=69EDF486"}, "display_name": "TEOC", "keywords": ["arcade", "puzzle", "casual", "atmospheric", "puzzler"], "long_description": "Evolve from an atomic state to marine-life in this spatial arcade puzzler with just one goal: Consume or be Consumed! \n\nPowered by elemental forces and mythical artifacts navigate your way through 3 environments with 30+ rounds each to get through. Will you be able to top the leaderboard for each of these? \n\nTEOC provides\u2026\n\u2022 more than 5 hours of mesmerizing gameplay,\n\u2022 a beautiful minimalist style with ambient adaptive soundtracks,\n\u2022 10+ game mechanics to master,\n\u2022 additional powerups to collect and use across all 90+ rounds\n\u2022 with daily powerup rewards for coming back\n\u2022 to compete on the 3 leaderboards,\n\u2022 increasingly challenging level design all procedurally generated\n\u2022 and seated or standing play options!\n\n\n", "short_description": "Evolve from an atomic state to marine-life in this spatial arcade puzzler with just one goal: Consume or be Consumed! \n\nPowered by elemental forces and mythical artifacts navigate your way through 3 environments with 30+ rounds each to get through. Will you be able to top the leaderboard for each of these? With >5 hours of mesmerizing gameplay, 10+ game mechanics to master and all set in a beautiful minimalist style with ambient adaptive soundtracks, you can enjoy it seated or standing up!\n"}]}, "developer_name": "HEADGEAR GbR", "developer_privacy_policy_url": "https://headgear.io/legal.html", "developer_terms_of_service_url": "https://headgear.io/legal.html#terms", "publisher_name": "HEADGEAR GbR", "support_website_url": null, "website_url": "https://headgear.io/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_categ
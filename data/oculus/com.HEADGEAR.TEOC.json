cdn.com/v/t64.5771-25/75361355_380339049810894_8629917805136921546_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dtReCw3b5LwQ7kNvwG63tGD&_nc_oc=Ado8CGjZZ2wu-pxUEbc469rBries17cgtsA-EmF9YX_yTvnCQrZfCCOvuJpRPI_9HGY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af98jozFvItG-u0kzK9aj_o4AfHV4fpE90wYF1X1vabM4Q&oe=6A47D3A3"}, {"file_name": "HighresScreenshot00081.png", "id": "376313343811121", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031312_376313347144454_2073303015962398022_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TwROieswn2MQ7kNvwHwfdn7&_nc_oc=AdoQY_vSNCWvsloU0TTAlCer9lWvI67JgM5izSt3WM5j4eH3uxz1gQA_ICW27MHw8OE&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9ZUdf433FoCv5pG0QBCDguY25lxwsbqt_w5qcj_tlxZQ&oe=6A47CEB7"}, {"file_name": "HighresScreenshot00034.png", "id": "361423311640761", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75297579_361423314974094_4468664441597916853_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BsenkaFoNCMQ7kNvwG8ZJ-R&_nc_oc=AdoPKN84nGEU7wu7aKeNJrKrLfZQpDYshYmPQeGea_N2VdUIhhI_yDM6fCd1dOJwno0&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-cKEWwyDMHDiYYkZLG5cK4sBNRrL9r-3fy5CEMgvqSAw&oe=6A47CD20"}, {"file_name": "consume.png", "id": "356221875528110", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39001669_356221878861443_261896368707707264_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Lw20j_uj5OgQ7kNvwH9n3nV&_nc_oc=AdpMAAZZItAoQIjG5983ixvp5zaGrVHhYMJCJCTk0rpJ8PQ2q62b1rfNpvllYu-1Vjw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9ALSaqe-Zi24D6A8n408tgy_Vnu4aVsiVCVulG7LyW1w&oe=6A47B983"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "38982553_2716489995261681_7852865887418274915_n[1].png", "id": "1017968672039348", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974845_1017968675372681_3537640423345626257_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pI85rDVC6OQQ7kNvwH-x1Rf&_nc_oc=AdqyY3jS9CsosYuLOa5Y9deHFZfnDLCHgZs6E1_n_xVKi8iuu5DHpIwHmJf1_xT0vI4&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_jGqYXAsZlloYzpbdxuazLVMCO8UzFLh1EVT5ycLQiXg&oe=6A47D2C6"}, "display_name": "TEOC", "keywords": ["arcade", "puzzle", "casual", "atmospheric", "puzzler"], "long_description": "Evolve from an atomic state to marine-life in this spatial arcade puzzler with just one goal: Consume or be Consumed! \n\nPowered by elemental forces and mythical artifacts navigate your way through 3 environments with 30+ rounds each to get through. Will you be able to top the leaderboard for each of these? \n\nTEOC provides\u2026\n\u2022 more than 5 hours of mesmerizing gameplay,\n\u2022 a beautiful minimalist style with ambient adaptive soundtracks,\n\u2022 10+ game mechanics to master,\n\u2022 additional powerups to collect and use across all 90+ rounds\n\u2022 with daily powerup rewards for coming back\n\u2022 to compete on the 3 leaderboards,\n\u2022 increasingly challenging level design all procedurally generated\n\u2022 and seated or standing play options!\n\n\n", "short_description": "Evolve from an atomic state to marine-life in this spatial arcade puzzler with just one goal: Consume or be Consumed! \n\nPowered by elemental forces and mythical artifacts navigate your way through 3 environments with 30+ rounds each to get through. Will you be able to top the leaderboard for each of these? With >5 hours of mesmerizing gameplay, 10+ game mechanics to master and all set in a beautiful minimalist style with ambient adaptive soundtracks, you can enjoy it seated or standing up!\n"}]}, "developer_name": "HEADGEAR GbR", "developer_privacy_policy_url": "https://headgear.io/legal.html", "developer_terms_of_service_url": "https://headgear.io/legal.html#terms", "publisher_name": "HEADGEAR GbR", "support_website_url": null, "website_url": "https://headgear.io/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_categ
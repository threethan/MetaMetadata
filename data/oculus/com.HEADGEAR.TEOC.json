cdn.com/v/t64.5771-25/75361355_380339049810894_8629917805136921546_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=in3AycDbcRIQ7kNvwGzjYo6&_nc_oc=Adq5NF79hX5S1TEQIcwlaJRQiphXaJm96VlzN-aOcRj6UF1fqHY-Nk9fSfceAvAjpqY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5xRNByprfvNCFyMTG3LKPDgGTKTlb9PGfJql4ycvEYeg&oe=6A0345A3"}, {"file_name": "HighresScreenshot00081.png", "id": "376313343811121", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031312_376313347144454_2073303015962398022_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YhA_kouWPx0Q7kNvwFKnkYS&_nc_oc=AdqlbsmbQzxyPW25MOFuuzeJ9La6vbjgP6RkQ3SMILRwZy9pUWT030jk-KawklQbOBU&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6_TyHP1QR1cLxflV4XwgpEX2lJVmKLAw1obf1cN45Jow&oe=6A0340B7"}, {"file_name": "HighresScreenshot00034.png", "id": "361423311640761", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75297579_361423314974094_4468664441597916853_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6W96KKU9iGMQ7kNvwFdmTrv&_nc_oc=AdpbqvFg0sy2WQ1ePC29gdKNyNKTnK-aI9q5IUgpp3QCr9LwAXvWjb5clQeFkUQ4QPY&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5WN5ys1JAiA69deFm96AEI5xa7m4Dgp2Thc0Zm6tfcww&oe=6A033F20"}, {"file_name": "consume.png", "id": "356221875528110", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39001669_356221878861443_261896368707707264_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6EDLXQz4MmYQ7kNvwELzkZ3&_nc_oc=Adp3LYmckL_Vq3vtU5IV_T-xLyMK8l5qEpYB6F8PXQNgt7NhcJutZNMXtu9kFbizu50&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7OqXCZcMob_MRbxX1akYjUrnwUYNDt17NuOZQPv_nzeQ&oe=6A032B83"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "38982553_2716489995261681_7852865887418274915_n[1].png", "id": "1017968672039348", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974845_1017968675372681_3537640423345626257_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GKSCPxPkPBAQ7kNvwGqeUHJ&_nc_oc=AdrXzdFsbIpX8OwCuB5CHUd7DyEyC27vOwbmGD57iQ7p5pbJUW4XfnSBJ1UzbLL_21Q&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5Fgy88KYqENM6S2YYg_nGQZz5hEWOdCOaXoKD8FEH6Eg&oe=6A0344C6"}, "display_name": "TEOC", "keywords": ["arcade", "puzzle", "casual", "atmospheric", "puzzler"], "long_description": "Evolve from an atomic state to marine-life in this spatial arcade puzzler with just one goal: Consume or be Consumed! \n\nPowered by elemental forces and mythical artifacts navigate your way through 3 environments with 30+ rounds each to get through. Will you be able to top the leaderboard for each of these? \n\nTEOC provides\u2026\n\u2022 more than 5 hours of mesmerizing gameplay,\n\u2022 a beautiful minimalist style with ambient adaptive soundtracks,\n\u2022 10+ game mechanics to master,\n\u2022 additional powerups to collect and use across all 90+ rounds\n\u2022 with daily powerup rewards for coming back\n\u2022 to compete on the 3 leaderboards,\n\u2022 increasingly challenging level design all procedurally generated\n\u2022 and seated or standing play options!\n\n\n", "short_description": "Evolve from an atomic state to marine-life in this spatial arcade puzzler with just one goal: Consume or be Consumed! \n\nPowered by elemental forces and mythical artifacts navigate your way through 3 environments with 30+ rounds each to get through. Will you be able to top the leaderboard for each of these? With >5 hours of mesmerizing gameplay, 10+ game mechanics to master and all set in a beautiful minimalist style with ambient adaptive soundtracks, you can enjoy it seated or standing up!\n"}]}, "developer_name": "HEADGEAR GbR", "developer_privacy_policy_url": "https://headgear.io/legal.html", "developer_terms_of_service_url": "https://headgear.io/legal.html#terms", "publisher_name": "HEADGEAR GbR", "support_website_url": null, "website_url": "https://headgear.io/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_categ
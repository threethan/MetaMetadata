cdn.com/v/t64.5771-25/75361355_380339049810894_8629917805136921546_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F5KegClav4UQ7kNvwHA3wPN&_nc_oc=Adrz7aJUJ62bhjb9HUBgjw7prIl7mYsWZtxj8UX2EgIkL-sCcpsQiqoroW_yY9c26g4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6vrFGgcFjl5M5LrgJiEAvCgEpQGVOFFAhwodTvTuW1rQ&oe=6A05E8A3"}, {"file_name": "HighresScreenshot00081.png", "id": "376313343811121", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031312_376313347144454_2073303015962398022_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YhA_kouWPx0Q7kNvwHK9uud&_nc_oc=AdpLlegqbbcXJdtg24pdKxwPYKxwTkrNYI_I9f_9DBmNDd0gYV4E6Nfi37jmWCpBOq4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4JMs_RYtDeIM-q1D0oJlFUnoRb7Vlbs3MZzUqG-Mf1pw&oe=6A05E3B7"}, {"file_name": "HighresScreenshot00034.png", "id": "361423311640761", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75297579_361423314974094_4468664441597916853_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6W96KKU9iGMQ7kNvwF0F-Ds&_nc_oc=Ado3qIlHMVAK0Lm3_Tr1rQAj-oyhqr2oSucCy8L9RK3hXSiIfSsBnSvpRZqY9GzufWs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4ePUPBrK8edJZ_UXQtlUFpPTsqyLlh5W9iMtFC5Ms5RA&oe=6A05E220"}, {"file_name": "consume.png", "id": "356221875528110", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39001669_356221878861443_261896368707707264_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DnYut-tO4r4Q7kNvwHiekaj&_nc_oc=Ado-g39iNa8N27WQ-l6B0x90IiSMXXId4XnqteXY_9DWpF51Co6jVNDwnf0n_Mx4g28&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4oUt37nAM3zNrfk_i8W4l7CjSnqHkSUlsfvuZkIQ3dJw&oe=6A05CE83"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "38982553_2716489995261681_7852865887418274915_n[1].png", "id": "1017968672039348", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974845_1017968675372681_3537640423345626257_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GKSCPxPkPBAQ7kNvwGu-Ado&_nc_oc=AdqfNLCfoT69n07thC_onxiL_zMZZnjVomvP7AhJDHNDtlLFtbsKJpwjCArNRVh2zA8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5G0PWq4L8v8dGJNaUPX1ek6CMfkMKS7-IRVlFKWHGhiA&oe=6A05E7C6"}, "display_name": "TEOC", "keywords": ["arcade", "puzzle", "casual", "atmospheric", "puzzler"], "long_description": "Evolve from an atomic state to marine-life in this spatial arcade puzzler with just one goal: Consume or be Consumed! \n\nPowered by elemental forces and mythical artifacts navigate your way through 3 environments with 30+ rounds each to get through. Will you be able to top the leaderboard for each of these? \n\nTEOC provides\u2026\n\u2022 more than 5 hours of mesmerizing gameplay,\n\u2022 a beautiful minimalist style with ambient adaptive soundtracks,\n\u2022 10+ game mechanics to master,\n\u2022 additional powerups to collect and use across all 90+ rounds\n\u2022 with daily powerup rewards for coming back\n\u2022 to compete on the 3 leaderboards,\n\u2022 increasingly challenging level design all procedurally generated\n\u2022 and seated or standing play options!\n\n\n", "short_description": "Evolve from an atomic state to marine-life in this spatial arcade puzzler with just one goal: Consume or be Consumed! \n\nPowered by elemental forces and mythical artifacts navigate your way through 3 environments with 30+ rounds each to get through. Will you be able to top the leaderboard for each of these? With >5 hours of mesmerizing gameplay, 10+ game mechanics to master and all set in a beautiful minimalist style with ambient adaptive soundtracks, you can enjoy it seated or standing up!\n"}]}, "developer_name": "HEADGEAR GbR", "developer_privacy_policy_url": "https://headgear.io/legal.html", "developer_terms_of_service_url": "https://headgear.io/legal.html#terms", "publisher_name": "HEADGEAR GbR", "support_website_url": null, "website_url": "https://headgear.io/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_categ
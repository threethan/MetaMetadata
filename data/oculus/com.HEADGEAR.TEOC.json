80339049810894_8629917805136921546_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CFZWsHoFZeEQ7kNvwEzPHh2&_nc_oc=AdmZzdrhZhPYY0MQT2ONlvQfDwwj8zCy1I87x90eSlmPpzRbJbwYoc33te7BJFrWMGk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfzeLv2cHMsL0kL3HOvnJkMmivEA6DbF_dJrPTDBU9d9uA&oe=69B544E3"}, {"file_name": "HighresScreenshot00081.png", "id": "376313343811121", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031312_376313347144454_2073303015962398022_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jS5DqER1Pr0Q7kNvwHXuXN7&_nc_oc=AdmAbAH40DEZexWTjpuEYB-Ir2vI-Bp5oIFEm9vc5tmGFyMm6qnoqVKNLn5mj1hY-EE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfzV7o4APl8DWBMGD8RHZ4_1D-qqgW2mq8hh3TbYvxwKkw&oe=69B53FF7"}, {"file_name": "HighresScreenshot00034.png", "id": "361423311640761", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75297579_361423314974094_4468664441597916853_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H0evDNzq588Q7kNvwHnmgia&_nc_oc=AdlszIdcqg8qxL0a3E0UXejOlBh0Yr9qL8b70BxQ41TepPZQ4y-SNhR9X_fhL4SMfd8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_Afzk6TYoh7zjUoSLp2A-3pwpMsvA6SI0Fx3e5uDaFj_FIA&oe=69B53E60"}, {"file_name": "consume.png", "id": "356221875528110", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39001669_356221878861443_261896368707707264_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Kyg8Ozr5RXQQ7kNvwFWEfBQ&_nc_oc=AdkWnItePIZtjIOBs9oqLDE3m2y402DVTnkQMD1gN5ee91Ewwo8f8haAGQZoYaph4aM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfyCkzFACqpTal2_G557X9JWl2Z5_fvdq5dPpdJ8Gt5WQg&oe=69B56303"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "38982553_2716489995261681_7852865887418274915_n[1].png", "id": "1017968672039348", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974845_1017968675372681_3537640423345626257_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1zzreVaLHAcQ7kNvwG_bVMw&_nc_oc=AdnZYO3MiQjCw1lq2IVDqmsDLtI2D1AVXEj3lYyzfbV1NaFHPBbwkTtYNhhXQfMbS1I&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfzKUqA7QQL_zO-edUpA1vslXzs54qRbGaW66qGZDR2JCw&oe=69B54406"}, "display_name": "TEOC", "keywords": ["arcade", "puzzle", "casual", "atmospheric", "puzzler"], "long_description": "Evolve from an atomic state to marine-life in this spatial arcade puzzler with just one goal: Consume or be Consumed! \n\nPowered by elemental forces and mythical artifacts navigate your way through 3 environments with 30+ rounds each to get through. Will you be able to top the leaderboard for each of these? \n\nTEOC provides\u2026\n\u2022 more than 5 hours of mesmerizing gameplay,\n\u2022 a beautiful minimalist style with ambient adaptive soundtracks,\n\u2022 10+ game mechanics to master,\n\u2022 additional powerups to collect and use across all 90+ rounds\n\u2022 with daily powerup rewards for coming back\n\u2022 to compete on the 3 leaderboards,\n\u2022 increasingly challenging level design all procedurally generated\n\u2022 and seated or standing play options!\n\n\n", "short_description": "Evolve from an atomic state to marine-life in this spatial arcade puzzler with just one goal: Consume or be Consumed! \n\nPowered by elemental forces and mythical artifacts navigate your way through 3 environments with 30+ rounds each to get through. Will you be able to top the leaderboard for each of these? With >5 hours of mesmerizing gameplay, 10+ game mechanics to master and all set in a beautiful minimalist style with ambient adaptive soundtracks, you can enjoy it seated or standing up!\n"}]}, "developer_name": "HEADGEAR GbR", "developer_privacy_policy_url": "https://headgear.io/legal.html", "developer_terms_of_service_url": "https://headgear.io/legal.html#terms", "publisher_name": "HEADGEAR GbR", "support_website_url": null, "website_url": "https://headgear.io/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscrip
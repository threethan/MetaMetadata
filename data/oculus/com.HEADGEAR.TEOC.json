cdn.com/v/t64.5771-25/75361355_380339049810894_8629917805136921546_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2cru5-nDeaoQ7kNvwGUZ56A&_nc_oc=AdqNv7wYJxV_fwD3gl5p2WrEIiHQ_xQyHMmzGoB6GuQe5EgQf_nWFR8mOyFaz_9V5_o&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEfAE248_mJcRbAnUmPrstx--LUhKU0gfZ4zL0f2EbIsw&oe=6A95D463"}, {"file_name": "HighresScreenshot00081.png", "id": "376313343811121", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031312_376313347144454_2073303015962398022_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5a1354tr2N0Q7kNvwEvNguT&_nc_oc=Adoc1DsBwcakV2EJju0lMUS-NmSTUrbOrVEpm0Bfd15mpJNIIkFK3pF6UL_vx3mUfss&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF1tZJO_Fq-P_3uw1KvqWyL1nZk-D9qUZa9jiuwkGluEg&oe=6A95CF77"}, {"file_name": "HighresScreenshot00034.png", "id": "361423311640761", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75297579_361423314974094_4468664441597916853_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5FLUC5SH0SYQ7kNvwHC6ElO&_nc_oc=AdqO206NnedBMMysIsQzUSB4-2V-8T02Jr92CDoBsThWOkpbxD9PjwkyWwKWL_QvK3g&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGJh4jICWW8vx-Z2mIJc57lP8j23kBhezx43uicExo5vQ&oe=6A95CDE0"}, {"file_name": "consume.png", "id": "356221875528110", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39001669_356221878861443_261896368707707264_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5W_4f8NiypMQ7kNvwHMIU2R&_nc_oc=AdrLjgn6VgDX1s0tAE1imxEwGXxIw1Twv60Ud7rrKQCn8yQAQYtYA6p1FXkzixQaH34&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEAJTXbK4UEU0stiSyTpO_VAj1E54oxtJRvRgOdUdc5DQ&oe=6A95BA43"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "38982553_2716489995261681_7852865887418274915_n[1].png", "id": "1017968672039348", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974845_1017968675372681_3537640423345626257_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xrot3OGoqb8Q7kNvwGTucOK&_nc_oc=Adphp5e16LKzDPUx9MtGW1HwCjFXP9qYOEJDXue7FTzWLY3KN1ByFbr-yx8ypNcCddM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFnpr3pyZCgFaK243ADMwdJYTLD2_VJGOTYkvzgW6xGkw&oe=6A95D386"}, "display_name": "TEOC", "keywords": ["arcade", "puzzle", "casual", "atmospheric", "puzzler"], "long_description": "Evolve from an atomic state to marine-life in this spatial arcade puzzler with just one goal: Consume or be Consumed! \n\nPowered by elemental forces and mythical artifacts navigate your way through 3 environments with 30+ rounds each to get through. Will you be able to top the leaderboard for each of these? \n\nTEOC provides\u2026\n\u2022 more than 5 hours of mesmerizing gameplay,\n\u2022 a beautiful minimalist style with ambient adaptive soundtracks,\n\u2022 10+ game mechanics to master,\n\u2022 additional powerups to collect and use across all 90+ rounds\n\u2022 with daily powerup rewards for coming back\n\u2022 to compete on the 3 leaderboards,\n\u2022 increasingly challenging level design all procedurally generated\n\u2022 and seated or standing play options!\n\n\n", "short_description": "Evolve from an atomic state to marine-life in this spatial arcade puzzler with just one goal: Consume or be Consumed! \n\nPowered by elemental forces and mythical artifacts navigate your way through 3 environments with 30+ rounds each to get through. Will you be able to top the leaderboard for each of these? With >5 hours of mesmerizing gameplay, 10+ game mechanics to master and all set in a beautiful minimalist style with ambient adaptive soundtracks, you can enjoy it seated or standing up!\n"}]}, "developer_name": "HEADGEAR GbR", "developer_privacy_policy_url": "https://headgear.io/legal.html", "developer_terms_of_service_url": "https://headgear.io/legal.html#terms", "publisher_name": "HEADGEAR GbR", "support_website_url": null, "website_url": "https://headgear.io/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_categ
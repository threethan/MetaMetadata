80339049810894_8629917805136921546_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xUhdEoUJUNgQ7kNvwEBO4Cj&_nc_oc=AdnqJ5cdlYOoCVclA-vPtq_4rvjazaRkoMNbMmLypd7F073HrMXdmX2JVUjSq4mL4ss&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfzQIuIcEigGg_x-zy8FdBwsJC2_y2TNjQmO2FSYBoNMFQ&oe=69AC0A63"}, {"file_name": "HighresScreenshot00081.png", "id": "376313343811121", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031312_376313347144454_2073303015962398022_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oIGLyQuiSsYQ7kNvwFKFAqN&_nc_oc=AdklEOyTyeexU7jnmZxqIhLlaP_ZN-GP9imtWq64EM8ow3kEDpeGnFiInwfL93iUbrM&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afwcozk2OkaCUU1JxvTdMvc4nS312DZLt2tYGHdOPh6cIg&oe=69AC0577"}, {"file_name": "HighresScreenshot00034.png", "id": "361423311640761", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75297579_361423314974094_4468664441597916853_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E8lra5nhuU0Q7kNvwFf3CsT&_nc_oc=AdnMqOPQx2ROI6duZhiZAI43zfoEglp8Z_aXEhSwk1wuJKtIIviKui_Vcx0G6wHmTI8&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfxkFiC-5zkyMnp10B8W08-K5SS7YAVFWk75ZZ3M2H9cFw&oe=69AC03E0"}, {"file_name": "consume.png", "id": "356221875528110", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39001669_356221878861443_261896368707707264_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kaYOq47IgAMQ7kNvwGRLSPC&_nc_oc=AdnqE5uHVtt2NZ1vF_8ssuPSkGGQh2JkZXDIUfTWMepHLb_mtUEQbLp7wlGbNLZ0KWQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_Afxnlu6BhyQqazmhZBA-bh8CBABsF_3GLPsyXHORrIqf6g&oe=69AC2883"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "38982553_2716489995261681_7852865887418274915_n[1].png", "id": "1017968672039348", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974845_1017968675372681_3537640423345626257_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BOkldBl1r5wQ7kNvwFP7S8U&_nc_oc=AdkbwUyR0WcfAyxCVLrfp6YnnnYWuLr7X9QgyZC1eXOZiMtVygZ5j1JTUIGoNcfBNus&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfwfwWP6Bdr31JRl78NzvzSwBt3om63VCIeGu29WYK1obg&oe=69AC0986"}, "display_name": "TEOC", "keywords": ["arcade", "puzzle", "casual", "atmospheric", "puzzler"], "long_description": "Evolve from an atomic state to marine-life in this spatial arcade puzzler with just one goal: Consume or be Consumed! \n\nPowered by elemental forces and mythical artifacts navigate your way through 3 environments with 30+ rounds each to get through. Will you be able to top the leaderboard for each of these? \n\nTEOC provides\u2026\n\u2022 more than 5 hours of mesmerizing gameplay,\n\u2022 a beautiful minimalist style with ambient adaptive soundtracks,\n\u2022 10+ game mechanics to master,\n\u2022 additional powerups to collect and use across all 90+ rounds\n\u2022 with daily powerup rewards for coming back\n\u2022 to compete on the 3 leaderboards,\n\u2022 increasingly challenging level design all procedurally generated\n\u2022 and seated or standing play options!\n\n\n", "short_description": "Evolve from an atomic state to marine-life in this spatial arcade puzzler with just one goal: Consume or be Consumed! \n\nPowered by elemental forces and mythical artifacts navigate your way through 3 environments with 30+ rounds each to get through. Will you be able to top the leaderboard for each of these? With >5 hours of mesmerizing gameplay, 10+ game mechanics to master and all set in a beautiful minimalist style with ambient adaptive soundtracks, you can enjoy it seated or standing up!\n"}]}, "developer_name": "HEADGEAR GbR", "developer_privacy_policy_url": "https://headgear.io/legal.html", "developer_terms_of_service_url": "https://headgear.io/legal.html#terms", "publisher_name": "HEADGEAR GbR", "support_website_url": null, "website_url": "https://headgear.io/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscrip
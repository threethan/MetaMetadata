cdn.com/v/t64.5771-25/75361355_380339049810894_8629917805136921546_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JcmL2ld573oQ7kNvwEKX6Ov&_nc_oc=AdpD4BSSJumZI20dhVhaguEZEKofDuUwMZWzqu7WnVwvf6xmhvAJ2FKCMnqYFiHzaUY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDKKQLws1E0aHUKA3izw8lhBtxIK9KzFkGCQQZq_VH2Gg&oe=6A649C63"}, {"file_name": "HighresScreenshot00081.png", "id": "376313343811121", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031312_376313347144454_2073303015962398022_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1M4CNBycTL0Q7kNvwGDBgHP&_nc_oc=Adq9ZbtIjVHqvzlz0h1lX3oCX_kLatLJHK5uTn5954VKBiE6jX7ucrsJFVQt4xI5ciA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDHUtPTkSz0FZk3bFDp01G2bsRTO7svPQUt_8VvKXh9Zg&oe=6A64CFB7"}, {"file_name": "HighresScreenshot00034.png", "id": "361423311640761", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75297579_361423314974094_4468664441597916853_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QYCGaYCnlWAQ7kNvwHyVaoV&_nc_oc=Adqf5UzmjNujUDf6qJpHhwPsf4ojg0IQkc7UHQ1zbAyFvzqYNwkK7C_Zs_Q3dJFaD2g&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCJQSdbXEtFm1dNxpJIJIdGLUjGnmMO0jj0ADiVv2zCZQ&oe=6A64CE20"}, {"file_name": "consume.png", "id": "356221875528110", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39001669_356221878861443_261896368707707264_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Q1sJWWsvQ-0Q7kNvwFFOW7b&_nc_oc=AdrzrOxdIx4U3d1BC4KGbO7KEnY_upUP_OF4XeKaAVtg3Sl_qIJaxULLCGXtuZPPLC0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB3p2iy5K_pJhgNGH73Ry-qIHJOpsPlB79C5khPnLu9_Q&oe=6A64BA83"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "38982553_2716489995261681_7852865887418274915_n[1].png", "id": "1017968672039348", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974845_1017968675372681_3537640423345626257_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l1xcIvlMalYQ7kNvwGold9p&_nc_oc=AdpbvA0o91D6xFZ6GFZWCpMbXhlxsWrc1hfwlgsO9Wfv0dqlzq7fswmmUd9clUog5c4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDJ5G6ZWoqG4q5HbLO7hhUvhb71hEOAvO-HloqFlwutPw&oe=6A649B86"}, "display_name": "TEOC", "keywords": ["arcade", "puzzle", "casual", "atmospheric", "puzzler"], "long_description": "Evolve from an atomic state to marine-life in this spatial arcade puzzler with just one goal: Consume or be Consumed! \n\nPowered by elemental forces and mythical artifacts navigate your way through 3 environments with 30+ rounds each to get through. Will you be able to top the leaderboard for each of these? \n\nTEOC provides\u2026\n\u2022 more than 5 hours of mesmerizing gameplay,\n\u2022 a beautiful minimalist style with ambient adaptive soundtracks,\n\u2022 10+ game mechanics to master,\n\u2022 additional powerups to collect and use across all 90+ rounds\n\u2022 with daily powerup rewards for coming back\n\u2022 to compete on the 3 leaderboards,\n\u2022 increasingly challenging level design all procedurally generated\n\u2022 and seated or standing play options!\n\n\n", "short_description": "Evolve from an atomic state to marine-life in this spatial arcade puzzler with just one goal: Consume or be Consumed! \n\nPowered by elemental forces and mythical artifacts navigate your way through 3 environments with 30+ rounds each to get through. Will you be able to top the leaderboard for each of these? With >5 hours of mesmerizing gameplay, 10+ game mechanics to master and all set in a beautiful minimalist style with ambient adaptive soundtracks, you can enjoy it seated or standing up!\n"}]}, "developer_name": "HEADGEAR GbR", "developer_privacy_policy_url": "https://headgear.io/legal.html", "developer_terms_of_service_url": "https://headgear.io/legal.html#terms", "publisher_name": "HEADGEAR GbR", "support_website_url": null, "website_url": "https://headgear.io/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_categ
80339049810894_8629917805136921546_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=raGj5GdzQFkQ7kNvwG1Hqc4&_nc_oc=AdkwQ-uxfDI3IlkRCLafSNf31Q9UCgPVYPYyZOgLnmyUV_pcSpOMWzfkbHm_4WPQVwQ&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=8&oh=00_AfyUyzaZBS8rpEGTGDUxuJqeDt8wj3bsKRSQoJ09TqyiMQ&oe=69BD2DE3"}, {"file_name": "HighresScreenshot00081.png", "id": "376313343811121", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/39031312_376313347144454_2073303015962398022_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EU0q_6l2T_gQ7kNvwHQ_h-G&_nc_oc=AdmUq2sMpdV24PD3AedtCKB8L2OI1E5i36KlE4zgz3ogCYZNG0bqvWTlyJoxZ2gm_zk&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=8&oh=00_Afz2uUXZCXXVFdmg_6VEuEVd7fAOV3rKNGsIYyEu4Tftvg&oe=69BD28F7"}, {"file_name": "HighresScreenshot00034.png", "id": "361423311640761", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/75297579_361423314974094_4468664441597916853_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o2uWGZEvS3MQ7kNvwE-nEcA&_nc_oc=AdmMi490iVUJ9qhgAFWNY3lXj-IXM_smZdbiJ6O9j7PV6pHXuZRXWEcZbwhMXFnQssA&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=8&oh=00_Afy8eTI0zoeuppTV6b3-k2YI2tibi9RC70_jKd46wOOBHA&oe=69BD5FA0"}, {"file_name": "consume.png", "id": "356221875528110", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/39001669_356221878861443_261896368707707264_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IJB9wvGgmegQ7kNvwGbO7Zq&_nc_oc=AdmEFqhk2P5kVFMFeKsRRHO2-iF_Z1x4m9KhF5Rpuh-Hq6LRzF_EtWjewsBBZvOa1hQ&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=8&oh=00_AfyZHUCJCLpI6hqnMBa_RcF3neeAYtc4s4QJ0eMwLa7NWw&oe=69BD4C03"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "38982553_2716489995261681_7852865887418274915_n[1].png", "id": "1017968672039348", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974845_1017968675372681_3537640423345626257_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fS2mjI7-lCMQ7kNvwH0qBZ6&_nc_oc=AdkzgxhMIx-WJ7PIKECyPacYr9NXARURRpzD6wf-9TCl9ic5EJHZstIk1bECUF5Phhg&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=8&oh=00_AfyIxCv6-ToHJ962Z87jWpP76oerQdGCWjGElx15rH6cXQ&oe=69BD2D06"}, "display_name": "TEOC", "keywords": ["arcade", "puzzle", "casual", "atmospheric", "puzzler"], "long_description": "Evolve from an atomic state to marine-life in this spatial arcade puzzler with just one goal: Consume or be Consumed! \n\nPowered by elemental forces and mythical artifacts navigate your way through 3 environments with 30+ rounds each to get through. Will you be able to top the leaderboard for each of these? \n\nTEOC provides\u2026\n\u2022 more than 5 hours of mesmerizing gameplay,\n\u2022 a beautiful minimalist style with ambient adaptive soundtracks,\n\u2022 10+ game mechanics to master,\n\u2022 additional powerups to collect and use across all 90+ rounds\n\u2022 with daily powerup rewards for coming back\n\u2022 to compete on the 3 leaderboards,\n\u2022 increasingly challenging level design all procedurally generated\n\u2022 and seated or standing play options!\n\n\n", "short_description": "Evolve from an atomic state to marine-life in this spatial arcade puzzler with just one goal: Consume or be Consumed! \n\nPowered by elemental forces and mythical artifacts navigate your way through 3 environments with 30+ rounds each to get through. Will you be able to top the leaderboard for each of these? With >5 hours of mesmerizing gameplay, 10+ game mechanics to master and all set in a beautiful minimalist style with ambient adaptive soundtracks, you can enjoy it seated or standing up!\n"}]}, "developer_name": "HEADGEAR GbR", "developer_privacy_policy_url": "https://headgear.io/legal.html", "developer_terms_of_service_url": "https://headgear.io/legal.html#terms", "publisher_name": "HEADGEAR GbR", "support_website_url": null, "website_url": "https://headgear.io/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscrip
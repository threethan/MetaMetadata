cdn.com/v/t64.5771-25/75361355_380339049810894_8629917805136921546_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OEjKGdFP9QsQ7kNvwHtu73d&_nc_oc=Adr8RVUIsBx8KIelMX_cWUdG1yLKrBu120mSXpgxrmajGpkuvvo7xPUKtdSwwXMFqho&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKaKaS3SV3-PIVp2QN7TtVlLDxMd68ljwUOJZ4ImSdl6Q&oe=6A9AE223"}, {"file_name": "HighresScreenshot00081.png", "id": "376313343811121", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39031312_376313347144454_2073303015962398022_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=esXcV-0v5VwQ7kNvwEmj4AP&_nc_oc=AdpeHygddQKlpbi4evtv1dtH7yDtZdi76RGsxqHhau__Hk3A0AW5Mm-bkkpmOC7qEe8&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJFH3jeQw3d1KKpK-Bs3UCMEejfoHAqljFPLlIAqAFLRA&oe=6A9ADD37"}, {"file_name": "HighresScreenshot00034.png", "id": "361423311640761", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/75297579_361423314974094_4468664441597916853_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XszKsA4URo0Q7kNvwEdZFBp&_nc_oc=AdrEaSqeOAaO2ELoQ8xu71mdKD8Nd_ZTgm5vTxi5L2c5upxbmOLFgPCDeoKww7hbIAU&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLHS67kfJ8_EhAXu0GmseovBHzQLU9KWnGxecayaSmnqA&oe=6A9ADBA0"}, {"file_name": "consume.png", "id": "356221875528110", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39001669_356221878861443_261896368707707264_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6fQuXvOAU9gQ7kNvwF1xkm-&_nc_oc=AdprdongkvO3jXZ-wujUv4ZyKthkyoBpkWlB7OTGlBU0uzuyjWVVv5Pd1p5-L6rterE&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL6awsPin4YRMht9yFtWPlnU96yxFeoQLGcP8CDTxAz4A&oe=6A9AC803"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "38982553_2716489995261681_7852865887418274915_n[1].png", "id": "1017968672039348", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974845_1017968675372681_3537640423345626257_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_wtpBcgSZ-EQ7kNvwGcDKbl&_nc_oc=Adqb19WsMIb6Gdg671RcT5n-mCgi3LwNQGInO-XMed65T9LDjrwRXImyOfnP5smDp3k&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI_6HYKYtFfEWznK6PObX0Z4azxrZ4RhexoerH7bEDm1A&oe=6A9AE146"}, "display_name": "TEOC", "keywords": ["arcade", "puzzle", "casual", "atmospheric", "puzzler"], "long_description": "Evolve from an atomic state to marine-life in this spatial arcade puzzler with just one goal: Consume or be Consumed! \n\nPowered by elemental forces and mythical artifacts navigate your way through 3 environments with 30+ rounds each to get through. Will you be able to top the leaderboard for each of these? \n\nTEOC provides\u2026\n\u2022 more than 5 hours of mesmerizing gameplay,\n\u2022 a beautiful minimalist style with ambient adaptive soundtracks,\n\u2022 10+ game mechanics to master,\n\u2022 additional powerups to collect and use across all 90+ rounds\n\u2022 with daily powerup rewards for coming back\n\u2022 to compete on the 3 leaderboards,\n\u2022 increasingly challenging level design all procedurally generated\n\u2022 and seated or standing play options!\n\n\n", "short_description": "Evolve from an atomic state to marine-life in this spatial arcade puzzler with just one goal: Consume or be Consumed! \n\nPowered by elemental forces and mythical artifacts navigate your way through 3 environments with 30+ rounds each to get through. Will you be able to top the leaderboard for each of these? With >5 hours of mesmerizing gameplay, 10+ game mechanics to master and all set in a beautiful minimalist style with ambient adaptive soundtracks, you can enjoy it seated or standing up!\n"}]}, "developer_name": "HEADGEAR GbR", "developer_privacy_policy_url": "https://headgear.io/legal.html", "developer_terms_of_service_url": "https://headgear.io/legal.html#terms", "publisher_name": "HEADGEAR GbR", "support_website_url": null, "website_url": "https://headgear.io/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_categ
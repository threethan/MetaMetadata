11-1.oculuscdn.com/v/t64.5771-25/75361355_380339049810894_8629917805136921546_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JqO_HnzMA24Q7kNvwF9DFPr&_nc_oc=Adp_vcYH_ABcmnRFN33mz0EIG9NmcZGlIo8aANjHdU3_7M8379av8pywe-7vABf9www&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHdM58yyv1_poHaEE_VgvOiEP3xdi80w0S-DL0rsEweGg&oe=6A8ECC63"}, {"file_name": "HighresScreenshot00081.png", "id": "376313343811121", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/39031312_376313347144454_2073303015962398022_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MDEqBhF-ZFcQ7kNvwFlm0Um&_nc_oc=Adr4GZ5rVJ5UynIxa8DPfOSCiOFCRM_rbzM_fOeqqRhSyWRiX7gDwq870cPuTGrQ-Gc&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH9Q49rjtYH-2zgjXGWaakWg65T1B9fKbSVDr8Lm5gNdg&oe=6A8EC777"}, {"file_name": "HighresScreenshot00034.png", "id": "361423311640761", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/75297579_361423314974094_4468664441597916853_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k2h9qlpoJz0Q7kNvwFwEFOW&_nc_oc=AdrCN3Wa6g5LBJPF3O8BjHFA6xDYeKtNnoP4MAvQ3-DnBvFskeCI9hAODkms3O5PuCs&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHrDUG7YixLjXV7dJntTDFAiFvaIh64Pcn-MtZPkbE2iw&oe=6A8EC5E0"}, {"file_name": "consume.png", "id": "356221875528110", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/39001669_356221878861443_261896368707707264_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pbAaL5lGS3QQ7kNvwFj5xpy&_nc_oc=AdoyHjXiE8AYsCcPU3sp3aDECIFSG57rkZCSSnl0eNHXIv4QeXyrGQLiZX3HF_wXz0E&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEvGU8BU8P4cmHgaoxj5-kvllNKSqxoLdw9_N6QvODsPQ&oe=6A8EEA83"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "38982553_2716489995261681_7852865887418274915_n[1].png", "id": "1017968672039348", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/38974845_1017968675372681_3537640423345626257_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ak8jp37LcqYQ7kNvwGeapEc&_nc_oc=AdoVfmr68DF-PPcjw6rGK49WqPX7bpIEHaYKstM2fraAWz96feTnFA4iidnjZcQdw_4&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGfXu6lK0-U8Hea1Jk-a6roMqeW5aXy-JUl_z7xAvJRGw&oe=6A8ECB86"}, "display_name": "TEOC", "keywords": ["arcade", "puzzle", "casual", "atmospheric", "puzzler"], "long_description": "Evolve from an atomic state to marine-life in this spatial arcade puzzler with just one goal: Consume or be Consumed! \n\nPowered by elemental forces and mythical artifacts navigate your way through 3 environments with 30+ rounds each to get through. Will you be able to top the leaderboard for each of these? \n\nTEOC provides\u2026\n\u2022 more than 5 hours of mesmerizing gameplay,\n\u2022 a beautiful minimalist style with ambient adaptive soundtracks,\n\u2022 10+ game mechanics to master,\n\u2022 additional powerups to collect and use across all 90+ rounds\n\u2022 with daily powerup rewards for coming back\n\u2022 to compete on the 3 leaderboards,\n\u2022 increasingly challenging level design all procedurally generated\n\u2022 and seated or standing play options!\n\n\n", "short_description": "Evolve from an atomic state to marine-life in this spatial arcade puzzler with just one goal: Consume or be Consumed! \n\nPowered by elemental forces and mythical artifacts navigate your way through 3 environments with 30+ rounds each to get through. Will you be able to top the leaderboard for each of these? With >5 hours of mesmerizing gameplay, 10+ game mechanics to master and all set in a beautiful minimalist style with ambient adaptive soundtracks, you can enjoy it seated or standing up!\n"}]}, "developer_name": "HEADGEAR GbR", "developer_privacy_policy_url": "https://headgear.io/legal.html", "developer_terms_of_service_url": "https://headgear.io/legal.html#terms", "publisher_name": "HEADGEAR GbR", "support_website_url": null, "website_url": "https://headgear.io/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags"
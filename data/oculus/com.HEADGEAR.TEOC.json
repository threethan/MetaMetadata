11-1.oculuscdn.com/v/t64.5771-25/75361355_380339049810894_8629917805136921546_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JqO_HnzMA24Q7kNvwEJOhy8&_nc_oc=Adr7PaFYK48i3oHXPHrzFBLyM08z2DxxAPr4AE9Jp0cmM3Eass466XulccERGJJBe2Q&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGGpZ1ZJBRYeRW5MPOWEZ2LZdyKyh2IOFAl0k_EpBGphg&oe=6A8D7AE3"}, {"file_name": "HighresScreenshot00081.png", "id": "376313343811121", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/39031312_376313347144454_2073303015962398022_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MDEqBhF-ZFcQ7kNvwGPJnWT&_nc_oc=AdqV3SBXxemN4PTuXQFyu0mnQq7eqpiTs0zVeZ_gUc_EGx2Qp8lIJc-120SUH5gFzdM&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQERUhbw2-HhLa0Z-JjsLQM439LhgQaKTNAwalb1eMtnbQ&oe=6A8D75F7"}, {"file_name": "HighresScreenshot00034.png", "id": "361423311640761", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/75297579_361423314974094_4468664441597916853_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k2h9qlpoJz0Q7kNvwEHE_6i&_nc_oc=AdowyCUUHd8xxcKV01IT69nAtxojOKfKCifBTK5PIqbMhKB4Hw1_ZjoRdrXefPfTdQU&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGLFqMUJRSZQLe-snbGI_MUrUfFe3dkiCW54RB5uhsP8g&oe=6A8D7460"}, {"file_name": "consume.png", "id": "356221875528110", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/39001669_356221878861443_261896368707707264_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Wt18wAy0eRgQ7kNvwE2sNdi&_nc_oc=AdpgZSgkuRCoJ4vZGAVj_IfV7hKCCxXMwsNPImHPC3HojNL7egfk3BR1ttYf75KMzqw&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFIA-_REb47YayWuT4NadrGbfL9mzGuwU6JmvZ-4SSGfQ&oe=6A8D9903"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "38982553_2716489995261681_7852865887418274915_n[1].png", "id": "1017968672039348", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/38974845_1017968675372681_3537640423345626257_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ak8jp37LcqYQ7kNvwFdkXfC&_nc_oc=Adqwwbs1NO7rPA6BOctYs_ZMXhZQ0NAAZ8DT8NHXWjUKcTD_GXqi_nziRbGM1Bn_yc4&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEr9RjN2aNTa-2UxBc4HNTtr-_kG7CPJpg9PU17_OZ4Jw&oe=6A8D7A06"}, "display_name": "TEOC", "keywords": ["arcade", "puzzle", "casual", "atmospheric", "puzzler"], "long_description": "Evolve from an atomic state to marine-life in this spatial arcade puzzler with just one goal: Consume or be Consumed! \n\nPowered by elemental forces and mythical artifacts navigate your way through 3 environments with 30+ rounds each to get through. Will you be able to top the leaderboard for each of these? \n\nTEOC provides\u2026\n\u2022 more than 5 hours of mesmerizing gameplay,\n\u2022 a beautiful minimalist style with ambient adaptive soundtracks,\n\u2022 10+ game mechanics to master,\n\u2022 additional powerups to collect and use across all 90+ rounds\n\u2022 with daily powerup rewards for coming back\n\u2022 to compete on the 3 leaderboards,\n\u2022 increasingly challenging level design all procedurally generated\n\u2022 and seated or standing play options!\n\n\n", "short_description": "Evolve from an atomic state to marine-life in this spatial arcade puzzler with just one goal: Consume or be Consumed! \n\nPowered by elemental forces and mythical artifacts navigate your way through 3 environments with 30+ rounds each to get through. Will you be able to top the leaderboard for each of these? With >5 hours of mesmerizing gameplay, 10+ game mechanics to master and all set in a beautiful minimalist style with ambient adaptive soundtracks, you can enjoy it seated or standing up!\n"}]}, "developer_name": "HEADGEAR GbR", "developer_privacy_policy_url": "https://headgear.io/legal.html", "developer_terms_of_service_url": "https://headgear.io/legal.html#terms", "publisher_name": "HEADGEAR GbR", "support_website_url": null, "website_url": "https://headgear.io/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags"
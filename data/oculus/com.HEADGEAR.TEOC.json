cdn.com/v/t64.5771-25/75361355_380339049810894_8629917805136921546_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=68VPN0pd6NoQ7kNvwFsD8KE&_nc_oc=AdoKxkWCPvwZxdp7XX84Qt6b1pMD4KzOjdQmWfjSImK6EiUjTrH97V-VIcOyM74ioW0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLkG5rS3GTaIMW6pa_o93iAXQBSHWB24SsuGYgPd6iI9g&oe=6A9C33A3"}, {"file_name": "HighresScreenshot00081.png", "id": "376313343811121", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031312_376313347144454_2073303015962398022_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=esXcV-0v5VwQ7kNvwF-HMrI&_nc_oc=AdpmuOor-cKaX7hux6Oqyz8A0QuxyyBDCTR-WeSS1pmnP6D8GlUR14XjlL4MIAav7M0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIvEbmQVyN7kxj_kprWXmp6LtG2QVgVHaEQk3OLKoYEug&oe=6A9C2EB7"}, {"file_name": "HighresScreenshot00034.png", "id": "361423311640761", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75297579_361423314974094_4468664441597916853_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XszKsA4URo0Q7kNvwEpZwt4&_nc_oc=Adro7VnC-AlpUt00El7XCu7rRQ8KFSDyn8DYBdMOhSZAUL-JPs3samB7mYzgXJDgrno&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJr-R9Izpt--nfSseGkhhV-nGTlIejBIeDkeLUSNkKjUg&oe=6A9C2D20"}, {"file_name": "consume.png", "id": "356221875528110", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39001669_356221878861443_261896368707707264_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6fQuXvOAU9gQ7kNvwGGyGNt&_nc_oc=AdoZSsvDgnVyX61roHDK8LyfpTqCS5sVpAmiY64pGBZ8NAR7Asw6XhBGM64uxb_HGe8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLjjCPAAqwNmsV4jDmeU8Of636xxeUKj_8fKdmVhUNljQ&oe=6A9C1983"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "38982553_2716489995261681_7852865887418274915_n[1].png", "id": "1017968672039348", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974845_1017968675372681_3537640423345626257_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_wtpBcgSZ-EQ7kNvwF1sbsp&_nc_oc=AdpPPLu1wT37CAcHVu0RtVvumqaCO5uDvHPfFP8LrD5diQTaA3KaikIx8xw8UgMjLgs&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIETTkkIGGL6Dx2v-gYzSYxFzMjYk1ZhC4UL9S1fNY1XQ&oe=6A9C32C6"}, "display_name": "TEOC", "keywords": ["arcade", "puzzle", "casual", "atmospheric", "puzzler"], "long_description": "Evolve from an atomic state to marine-life in this spatial arcade puzzler with just one goal: Consume or be Consumed! \n\nPowered by elemental forces and mythical artifacts navigate your way through 3 environments with 30+ rounds each to get through. Will you be able to top the leaderboard for each of these? \n\nTEOC provides\u2026\n\u2022 more than 5 hours of mesmerizing gameplay,\n\u2022 a beautiful minimalist style with ambient adaptive soundtracks,\n\u2022 10+ game mechanics to master,\n\u2022 additional powerups to collect and use across all 90+ rounds\n\u2022 with daily powerup rewards for coming back\n\u2022 to compete on the 3 leaderboards,\n\u2022 increasingly challenging level design all procedurally generated\n\u2022 and seated or standing play options!\n\n\n", "short_description": "Evolve from an atomic state to marine-life in this spatial arcade puzzler with just one goal: Consume or be Consumed! \n\nPowered by elemental forces and mythical artifacts navigate your way through 3 environments with 30+ rounds each to get through. Will you be able to top the leaderboard for each of these? With >5 hours of mesmerizing gameplay, 10+ game mechanics to master and all set in a beautiful minimalist style with ambient adaptive soundtracks, you can enjoy it seated or standing up!\n"}]}, "developer_name": "HEADGEAR GbR", "developer_privacy_policy_url": "https://headgear.io/legal.html", "developer_terms_of_service_url": "https://headgear.io/legal.html#terms", "publisher_name": "HEADGEAR GbR", "support_website_url": null, "website_url": "https://headgear.io/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_categ
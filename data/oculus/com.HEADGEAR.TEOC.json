11-1.oculuscdn.com/v/t64.5771-25/75361355_380339049810894_8629917805136921546_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EpyDslz2nY4Q7kNvwGuH_po&_nc_oc=AdpDC3I7Q1te6nEw7OVeS30kK0TyCkjyCgMatYsRPXurz1F4S4IMVNLJ9sILRUKlaR8&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFB8yT0y0t5IZV2RTTS6ZCN8Xws3B28s1B3IaDPFBVGlw&oe=6A8591E3"}, {"file_name": "HighresScreenshot00081.png", "id": "376313343811121", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/39031312_376313347144454_2073303015962398022_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AEa2Q2oxdSgQ7kNvwHGZysc&_nc_oc=Adq-ruDtkyyg1l2lZfz6nfNhl1-lzcAT0aOU2Wk6BftnPTQJNeae4_n8cRy_oxflKG0&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE6m3yfBA7Jz7XQ3dA40TsOGNcwYokIPzihOJ_XWTEw3g&oe=6A858CF7"}, {"file_name": "HighresScreenshot00034.png", "id": "361423311640761", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/75297579_361423314974094_4468664441597916853_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4ETg2p7ev0MQ7kNvwEe1GgY&_nc_oc=AdreSADX3jTwZ2fdVgiNeKcKolllK0wqNMnDK6KtngrQYIwEU4uzb-orc8Ouv81tQ0g&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFY4qUnjitJEA7YTe19aIt-FhW-tSpwb8-c7RP-rsAENw&oe=6A858B60"}, {"file_name": "consume.png", "id": "356221875528110", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/39001669_356221878861443_261896368707707264_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dtjnBmxCoasQ7kNvwGuh2YY&_nc_oc=Adq3YILeICLYx107xA-QfAg3_PGeNuFJKyWV5R0cOOwnFdPeAT2X6GrRSLSY6k8tZXM&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF6eurrwaCcjAhrxdcgl8rMZ1z8MhtwTYr73bnjrfUbNA&oe=6A85B003"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "38982553_2716489995261681_7852865887418274915_n[1].png", "id": "1017968672039348", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/38974845_1017968675372681_3537640423345626257_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pzzE-EmjKgsQ7kNvwHEBVeY&_nc_oc=AdpePTj7GRi4s8Cj6zlhBIDxXntNpetNaBZzU-P2IiVWaEwhI6JO5Yn2IQIXlWFWv7o&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEi93Tp8q7KVK13AFy8d3wgZeQ1Zv5bBDUrmwoCZ2OsQw&oe=6A859106"}, "display_name": "TEOC", "keywords": ["arcade", "puzzle", "casual", "atmospheric", "puzzler"], "long_description": "Evolve from an atomic state to marine-life in this spatial arcade puzzler with just one goal: Consume or be Consumed! \n\nPowered by elemental forces and mythical artifacts navigate your way through 3 environments with 30+ rounds each to get through. Will you be able to top the leaderboard for each of these? \n\nTEOC provides\u2026\n\u2022 more than 5 hours of mesmerizing gameplay,\n\u2022 a beautiful minimalist style with ambient adaptive soundtracks,\n\u2022 10+ game mechanics to master,\n\u2022 additional powerups to collect and use across all 90+ rounds\n\u2022 with daily powerup rewards for coming back\n\u2022 to compete on the 3 leaderboards,\n\u2022 increasingly challenging level design all procedurally generated\n\u2022 and seated or standing play options!\n\n\n", "short_description": "Evolve from an atomic state to marine-life in this spatial arcade puzzler with just one goal: Consume or be Consumed! \n\nPowered by elemental forces and mythical artifacts navigate your way through 3 environments with 30+ rounds each to get through. Will you be able to top the leaderboard for each of these? With >5 hours of mesmerizing gameplay, 10+ game mechanics to master and all set in a beautiful minimalist style with ambient adaptive soundtracks, you can enjoy it seated or standing up!\n"}]}, "developer_name": "HEADGEAR GbR", "developer_privacy_policy_url": "https://headgear.io/legal.html", "developer_terms_of_service_url": "https://headgear.io/legal.html#terms", "publisher_name": "HEADGEAR GbR", "support_website_url": null, "website_url": "https://headgear.io/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags"
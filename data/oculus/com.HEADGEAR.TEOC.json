cdn.com/v/t64.5771-25/75361355_380339049810894_8629917805136921546_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HEsVvHdO7K0Q7kNvwHS4a-f&_nc_oc=AdrnHZetHUpjd1cBdyE7j7lJ5tYd0junXG3yzEZDZ-ToRXqF5rjm5cJJhQnZt3VR2Fk&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4lE0sv2rKp8Vh_DkRZkeDdbAOCfH-cWsT4mXsJrvs8ag&oe=6A1C5223"}, {"file_name": "HighresScreenshot00081.png", "id": "376313343811121", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/39031312_376313347144454_2073303015962398022_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=POQFPGr9lksQ7kNvwHe5Qq9&_nc_oc=AdoS2jlpW_HIXegBX8ag6co6bLlTI7hvIH1AvmMCpqPn35XioJNti5UMusIvcv00a-A&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5fE3aXoG62uw5yVYCpntzWx9nIt-sMkaMRAhzBIRLl8A&oe=6A1C4D37"}, {"file_name": "HighresScreenshot00034.png", "id": "361423311640761", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/75297579_361423314974094_4468664441597916853_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j6EXEsaUWyUQ7kNvwEJbYSA&_nc_oc=AdqIq_dANO1zPGikEY2y5qIz9q_OkWysYn1YFTAWC7DzDzMUY_SyhBCzAUWP5LDei3U&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5S4U2OX4-cEe7VGNlYtOFXuG-QzzYRGsIztGPHq3T6Uw&oe=6A1C4BA0"}, {"file_name": "consume.png", "id": "356221875528110", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/39001669_356221878861443_261896368707707264_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fDDDS4D0a-4Q7kNvwGovzkC&_nc_oc=AdpOtv_NPRhqa9aSMdgUlNf3waFD7LOck4sRXbTTlhbpQkqK9ujuKCr-tqGH-W7t-tk&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7ODflEY_Udu2EXouzNUVUZlReXbfSP1QAgLK0nj5PFrQ&oe=6A1C3803"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "38982553_2716489995261681_7852865887418274915_n[1].png", "id": "1017968672039348", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38974845_1017968675372681_3537640423345626257_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EAJMF6sChNgQ7kNvwEJaFqZ&_nc_oc=Adp8h-GMe2zKLD4Qx1TrisL9xoUBxtBO4Rbc2NsdTe9SbOTqjQ-SHGGzNbVtH7Wn3no&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af65A5qlQa36QnbVHGOxjVEZOnLqOTQ2d1UsYnRdMrsXiQ&oe=6A1C5146"}, "display_name": "TEOC", "keywords": ["arcade", "puzzle", "casual", "atmospheric", "puzzler"], "long_description": "Evolve from an atomic state to marine-life in this spatial arcade puzzler with just one goal: Consume or be Consumed! \n\nPowered by elemental forces and mythical artifacts navigate your way through 3 environments with 30+ rounds each to get through. Will you be able to top the leaderboard for each of these? \n\nTEOC provides\u2026\n\u2022 more than 5 hours of mesmerizing gameplay,\n\u2022 a beautiful minimalist style with ambient adaptive soundtracks,\n\u2022 10+ game mechanics to master,\n\u2022 additional powerups to collect and use across all 90+ rounds\n\u2022 with daily powerup rewards for coming back\n\u2022 to compete on the 3 leaderboards,\n\u2022 increasingly challenging level design all procedurally generated\n\u2022 and seated or standing play options!\n\n\n", "short_description": "Evolve from an atomic state to marine-life in this spatial arcade puzzler with just one goal: Consume or be Consumed! \n\nPowered by elemental forces and mythical artifacts navigate your way through 3 environments with 30+ rounds each to get through. Will you be able to top the leaderboard for each of these? With >5 hours of mesmerizing gameplay, 10+ game mechanics to master and all set in a beautiful minimalist style with ambient adaptive soundtracks, you can enjoy it seated or standing up!\n"}]}, "developer_name": "HEADGEAR GbR", "developer_privacy_policy_url": "https://headgear.io/legal.html", "developer_terms_of_service_url": "https://headgear.io/legal.html#terms", "publisher_name": "HEADGEAR GbR", "support_website_url": null, "website_url": "https://headgear.io/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_categ
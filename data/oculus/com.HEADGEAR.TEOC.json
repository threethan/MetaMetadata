80339049810894_8629917805136921546_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=raGj5GdzQFkQ7kNvwEazE_J&_nc_oc=AdmbhrkZEad7_iypXNsjVQ5JLRZ2d_22iyzUBksMb7qUg3S7E5YjP55_MV4mc31Rey4&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_Afw10FY5g9GbDsbIUsftAGjnbOuWaeboXukTygX2S5ovWQ&oe=69BA8AE3"}, {"file_name": "HighresScreenshot00081.png", "id": "376313343811121", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39031312_376313347144454_2073303015962398022_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nGAPb5K5EBYQ7kNvwFnfHJz&_nc_oc=Admk-rpHNW0gzkKa74Fxl1Qd0PV2NsqfjWGVVJ-MUOafyMpBeKr3lItaIAMmIi3s9bQ&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_Afz4MIDj1ZK5DLNC6hT8OmN9v8b1CPIYSgQYD_gsElF7fw&oe=69BA85F7"}, {"file_name": "HighresScreenshot00034.png", "id": "361423311640761", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/75297579_361423314974094_4468664441597916853_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oAhdUEId8OcQ7kNvwHLwW4C&_nc_oc=AdkNgKoXbARsT4LXBd9-pP4blbfRUvHu7rXFB_6PWR7nnCduQ7vJ2GpZtz0AiOlmL8s&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_AfzJzL5VKzZC_cVcfCG_9_cDxnDLfE-Wu5gpzCi_0dSrEw&oe=69BA8460"}, {"file_name": "consume.png", "id": "356221875528110", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39001669_356221878861443_261896368707707264_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GgAmmVwhV3sQ7kNvwEexr_P&_nc_oc=AdnWxmycLf_iUim2OPX9QImUbdJiDf7Jj0Fd8_IVNuLR3rKqeJpvXeoeJJbF-swOqEE&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=8&oh=00_AfySHCmDW4imYbPuwyX3NDnL6fcpH1pJaxAsLQQtVM0F3w&oe=69BAA903"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "38982553_2716489995261681_7852865887418274915_n[1].png", "id": "1017968672039348", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974845_1017968675372681_3537640423345626257_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=05W6PYPmSKwQ7kNvwGFczUR&_nc_oc=Adm6N6xD-09LtjqZddrikSesv1TYZUkbfGPsa6MThSPfrE5d7PZPauAaEiwaRmjYuYs&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_AfydZeg-y0sDZKdGbVvtwYEaILfd709QbqLNPOp_vW23rA&oe=69BA8A06"}, "display_name": "TEOC", "keywords": ["arcade", "puzzle", "casual", "atmospheric", "puzzler"], "long_description": "Evolve from an atomic state to marine-life in this spatial arcade puzzler with just one goal: Consume or be Consumed! \n\nPowered by elemental forces and mythical artifacts navigate your way through 3 environments with 30+ rounds each to get through. Will you be able to top the leaderboard for each of these? \n\nTEOC provides\u2026\n\u2022 more than 5 hours of mesmerizing gameplay,\n\u2022 a beautiful minimalist style with ambient adaptive soundtracks,\n\u2022 10+ game mechanics to master,\n\u2022 additional powerups to collect and use across all 90+ rounds\n\u2022 with daily powerup rewards for coming back\n\u2022 to compete on the 3 leaderboards,\n\u2022 increasingly challenging level design all procedurally generated\n\u2022 and seated or standing play options!\n\n\n", "short_description": "Evolve from an atomic state to marine-life in this spatial arcade puzzler with just one goal: Consume or be Consumed! \n\nPowered by elemental forces and mythical artifacts navigate your way through 3 environments with 30+ rounds each to get through. Will you be able to top the leaderboard for each of these? With >5 hours of mesmerizing gameplay, 10+ game mechanics to master and all set in a beautiful minimalist style with ambient adaptive soundtracks, you can enjoy it seated or standing up!\n"}]}, "developer_name": "HEADGEAR GbR", "developer_privacy_policy_url": "https://headgear.io/legal.html", "developer_terms_of_service_url": "https://headgear.io/legal.html#terms", "publisher_name": "HEADGEAR GbR", "support_website_url": null, "website_url": "https://headgear.io/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscrip
80339049810894_8629917805136921546_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EGlDyS0Ag_AQ7kNvwFp1gbA&_nc_oc=Adm3CSGCQ-YwrzH1NGucwMbwStUqRpqUSPosM5dRGUQzEiZ14JlZlT3vknvkOtlz1_M&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfwtHb0lJEPmqY8h2PTa2LCmHfzPUgv7hf6MfLWWmqKFYQ&oe=69AEAD63"}, {"file_name": "HighresScreenshot00081.png", "id": "376313343811121", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031312_376313347144454_2073303015962398022_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oIGLyQuiSsYQ7kNvwGsluEQ&_nc_oc=AdmH69Cr29nNPSbssCL-_3MoStaUm5rSvAhi4sJl3DhrT-iQK09VtGWqGradkDOirvc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfwDE6PP5xlpHMZn48Il5BR8SUvJuAsUNuI03QKYSQn7bQ&oe=69AEA877"}, {"file_name": "HighresScreenshot00034.png", "id": "361423311640761", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75297579_361423314974094_4468664441597916853_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E8lra5nhuU0Q7kNvwHqyjeV&_nc_oc=Adm44nfNjzy00v6EVvGW22SIw0EhXP8jx4MdemwBFPacANbfFLdbpcwYDp0fkCAOxzE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfxVKMi_3vmrkBUQN-L7NxzVkC9K21gaFhc_1XUnK_mLeQ&oe=69AEA6E0"}, {"file_name": "consume.png", "id": "356221875528110", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39001669_356221878861443_261896368707707264_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qfzcjz9ir3oQ7kNvwEo3P58&_nc_oc=AdlIrMU90WIJAga3PMwVS1q51i14G9ae-In6Y45KzgMCGK2v2xW-q0UzXN0nvbUUTBE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afx6RjBbrA7gS4hd6g_1phkIvnazylF75SUS5nRzRCPRVw&oe=69AECB83"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "38982553_2716489995261681_7852865887418274915_n[1].png", "id": "1017968672039348", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974845_1017968675372681_3537640423345626257_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BOkldBl1r5wQ7kNvwHgsspI&_nc_oc=AdmY1AcdMbByrATdhbgXNjWzqtMj5NgeiiQWAuXqRCFfkbRbjQnyFZMPH0g4_EXYABs&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afxu2QQhW455de8GFkuOUTHM5MnRMwOCpP6CZ-_Ut3IZFQ&oe=69AEAC86"}, "display_name": "TEOC", "keywords": ["arcade", "puzzle", "casual", "atmospheric", "puzzler"], "long_description": "Evolve from an atomic state to marine-life in this spatial arcade puzzler with just one goal: Consume or be Consumed! \n\nPowered by elemental forces and mythical artifacts navigate your way through 3 environments with 30+ rounds each to get through. Will you be able to top the leaderboard for each of these? \n\nTEOC provides\u2026\n\u2022 more than 5 hours of mesmerizing gameplay,\n\u2022 a beautiful minimalist style with ambient adaptive soundtracks,\n\u2022 10+ game mechanics to master,\n\u2022 additional powerups to collect and use across all 90+ rounds\n\u2022 with daily powerup rewards for coming back\n\u2022 to compete on the 3 leaderboards,\n\u2022 increasingly challenging level design all procedurally generated\n\u2022 and seated or standing play options!\n\n\n", "short_description": "Evolve from an atomic state to marine-life in this spatial arcade puzzler with just one goal: Consume or be Consumed! \n\nPowered by elemental forces and mythical artifacts navigate your way through 3 environments with 30+ rounds each to get through. Will you be able to top the leaderboard for each of these? With >5 hours of mesmerizing gameplay, 10+ game mechanics to master and all set in a beautiful minimalist style with ambient adaptive soundtracks, you can enjoy it seated or standing up!\n"}]}, "developer_name": "HEADGEAR GbR", "developer_privacy_policy_url": "https://headgear.io/legal.html", "developer_terms_of_service_url": "https://headgear.io/legal.html#terms", "publisher_name": "HEADGEAR GbR", "support_website_url": null, "website_url": "https://headgear.io/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscrip
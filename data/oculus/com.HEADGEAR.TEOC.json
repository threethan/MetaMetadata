80339049810894_8629917805136921546_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7uSJ22lddOUQ7kNvwFxtg9D&_nc_oc=AdmPt2rANdsEdU_QhqgWeopfFudt0pT81Oq7pbD5IqSMg77EQicgcJNWsxZ6gU15WYA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfyenLJQJM7tIkgDcSJTlJSZo0MzoVI0iR3euA3WeH7Gbg&oe=69B93963"}, {"file_name": "HighresScreenshot00081.png", "id": "376313343811121", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031312_376313347144454_2073303015962398022_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nGAPb5K5EBYQ7kNvwHcTiCZ&_nc_oc=Adk9zEfHV8a5JCEx994ghZopaeQ0OI_0yq8h49FoOs-hp77G8QtqiC51Ar_UmI8mUIQ&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfwZC93eyvX15ZBXRtxIoYX6kxITZh0C0skG9qx1BIPnrw&oe=69B93477"}, {"file_name": "HighresScreenshot00034.png", "id": "361423311640761", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75297579_361423314974094_4468664441597916853_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oAhdUEId8OcQ7kNvwHnZO2x&_nc_oc=Adk-62bFpnq1ABgPkgfsri3e-2QLYrgnJVNf1x4wdtAtK_PAlStb5PSQLt8blzCpbaw&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfzVDNoi3uIh84OcKIM2IKxUimbOBumiZ4wZZyHfOsmdqA&oe=69B932E0"}, {"file_name": "consume.png", "id": "356221875528110", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39001669_356221878861443_261896368707707264_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GgAmmVwhV3sQ7kNvwHlDqg-&_nc_oc=AdlR-wyupt-T4vKeZfW4iO4Fb1nNwlB6MTlkn57fynyjSZYAqmvsVqCepe1aZV5EdZw&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfxeaagsQnGVYPJbkZCNKlUOt3PGboOFblmZqGrWvm5PJQ&oe=69B95783"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "38982553_2716489995261681_7852865887418274915_n[1].png", "id": "1017968672039348", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974845_1017968675372681_3537640423345626257_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=05W6PYPmSKwQ7kNvwGa0d-v&_nc_oc=AdlALsZ4Bxex_l0_CciTq6-MZd9aEoj3DR4V8UpLUVXp1mRG0ebE5pRukdZ-N3avug0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfyIa0TQiHfAksk38VNtsBpxfCyg7bo2dV0NAdXiyV02LQ&oe=69B93886"}, "display_name": "TEOC", "keywords": ["arcade", "puzzle", "casual", "atmospheric", "puzzler"], "long_description": "Evolve from an atomic state to marine-life in this spatial arcade puzzler with just one goal: Consume or be Consumed! \n\nPowered by elemental forces and mythical artifacts navigate your way through 3 environments with 30+ rounds each to get through. Will you be able to top the leaderboard for each of these? \n\nTEOC provides\u2026\n\u2022 more than 5 hours of mesmerizing gameplay,\n\u2022 a beautiful minimalist style with ambient adaptive soundtracks,\n\u2022 10+ game mechanics to master,\n\u2022 additional powerups to collect and use across all 90+ rounds\n\u2022 with daily powerup rewards for coming back\n\u2022 to compete on the 3 leaderboards,\n\u2022 increasingly challenging level design all procedurally generated\n\u2022 and seated or standing play options!\n\n\n", "short_description": "Evolve from an atomic state to marine-life in this spatial arcade puzzler with just one goal: Consume or be Consumed! \n\nPowered by elemental forces and mythical artifacts navigate your way through 3 environments with 30+ rounds each to get through. Will you be able to top the leaderboard for each of these? With >5 hours of mesmerizing gameplay, 10+ game mechanics to master and all set in a beautiful minimalist style with ambient adaptive soundtracks, you can enjoy it seated or standing up!\n"}]}, "developer_name": "HEADGEAR GbR", "developer_privacy_policy_url": "https://headgear.io/legal.html", "developer_terms_of_service_url": "https://headgear.io/legal.html#terms", "publisher_name": "HEADGEAR GbR", "support_website_url": null, "website_url": "https://headgear.io/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscrip
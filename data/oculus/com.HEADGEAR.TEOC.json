cdn.com/v/t64.5771-25/75361355_380339049810894_8629917805136921546_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ru19NGaBKxAQ7kNvwEd6FBB&_nc_oc=AdrwcdwRbwqxb74wqG_lq0N4sGIYHNo8FXy8XNZ6PGaBKugoYhnMAMgGy8yDHQzLudY&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBkZhraKYbDEEMjQoqQlr-Mye4viN4FJmm5ZfE8TeiUyg&oe=6A565423"}, {"file_name": "HighresScreenshot00081.png", "id": "376313343811121", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/39031312_376313347144454_2073303015962398022_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uFlrGkAPAlsQ7kNvwEWjiEM&_nc_oc=AdrSsorKpP1XC6BXFJELiYg_3dNaNsDD5pWjf-1UJavOs_A-78iUesVJasJYWr95VMQ&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCl-RLG-0W9Xt-a5STdw7NnI69mHKTq7hYulC-fEioqPg&oe=6A564F37"}, {"file_name": "HighresScreenshot00034.png", "id": "361423311640761", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/75297579_361423314974094_4468664441597916853_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-rXIwAYMkrQQ7kNvwHWnd4q&_nc_oc=Adp-iZV3ghXjFvcSdaGVvhQT_hAAQ2b7diri7rLSJ25nlCxeOl1egg3ZUSKpAstM714&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB2u7S4KfkUhSXCiwv6D7_A_kYZPht_zvFRfRa1xotxdQ&oe=6A564DA0"}, {"file_name": "consume.png", "id": "356221875528110", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/39001669_356221878861443_261896368707707264_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DP7ldhSemu4Q7kNvwFKgWdY&_nc_oc=AdpxI4SzBzQNfVvjIJHP2GS3nB_U1XX0d8W0ypYPfsrs-p67W0Au1g5ZgNVihD7YS10&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA9MmFKF8WB2RrZTkDw1_F9QlLBYLHGJ92o_WFigYuGew&oe=6A563A03"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "38982553_2716489995261681_7852865887418274915_n[1].png", "id": "1017968672039348", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/38974845_1017968675372681_3537640423345626257_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x5s3fdBHTq4Q7kNvwFBHaps&_nc_oc=AdoRJRLnnLkr7QZZoKMIFYOAeD-BiTkch-FFWfEXztXCiwHbTr1IuQp-XWLJV4fPSpg&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAk5pDPFJdA11p-swIoKDTfd-E1pwdBKiSKBiIhhZhGTA&oe=6A565346"}, "display_name": "TEOC", "keywords": ["arcade", "puzzle", "casual", "atmospheric", "puzzler"], "long_description": "Evolve from an atomic state to marine-life in this spatial arcade puzzler with just one goal: Consume or be Consumed! \n\nPowered by elemental forces and mythical artifacts navigate your way through 3 environments with 30+ rounds each to get through. Will you be able to top the leaderboard for each of these? \n\nTEOC provides\u2026\n\u2022 more than 5 hours of mesmerizing gameplay,\n\u2022 a beautiful minimalist style with ambient adaptive soundtracks,\n\u2022 10+ game mechanics to master,\n\u2022 additional powerups to collect and use across all 90+ rounds\n\u2022 with daily powerup rewards for coming back\n\u2022 to compete on the 3 leaderboards,\n\u2022 increasingly challenging level design all procedurally generated\n\u2022 and seated or standing play options!\n\n\n", "short_description": "Evolve from an atomic state to marine-life in this spatial arcade puzzler with just one goal: Consume or be Consumed! \n\nPowered by elemental forces and mythical artifacts navigate your way through 3 environments with 30+ rounds each to get through. Will you be able to top the leaderboard for each of these? With >5 hours of mesmerizing gameplay, 10+ game mechanics to master and all set in a beautiful minimalist style with ambient adaptive soundtracks, you can enjoy it seated or standing up!\n"}]}, "developer_name": "HEADGEAR GbR", "developer_privacy_policy_url": "https://headgear.io/legal.html", "developer_terms_of_service_url": "https://headgear.io/legal.html#terms", "publisher_name": "HEADGEAR GbR", "support_website_url": null, "website_url": "https://headgear.io/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_categ
cdn.com/v/t64.5771-25/75361355_380339049810894_8629917805136921546_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IWqOXbVX0UEQ7kNvwFEZ6qF&_nc_oc=AdqWZ5quew3Nf-9-XyxoSCij0NHpxX0GVksOESJQ5X1aiOi7hZfjZ17mhGZTg4kzSZc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCaGddk7h9_re9jOYGZYPhXVRqJGC-xvTKeT2UgizRi3g&oe=6A4FBCA3"}, {"file_name": "HighresScreenshot00081.png", "id": "376313343811121", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031312_376313347144454_2073303015962398022_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KAPFg7sYpBAQ7kNvwG_V3l6&_nc_oc=AdrGl9UUTxW_VeLzIYdy0wi0dygQE4PoCrlx-6qY9SIQc_FR5kW3sK3vbwOP71iYCdk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB7-yfRdRJBWcjPPWGu30kUAGGWWZxe06o0A506r-b7Wg&oe=6A4FB7B7"}, {"file_name": "HighresScreenshot00034.png", "id": "361423311640761", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75297579_361423314974094_4468664441597916853_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-mTWn8UWYikQ7kNvwFdouRP&_nc_oc=AdouVYBrx9rOSdu2jJE82VAH-Au7CDbY46kOIiweV67QURSe0YhMEa8-XIqs9zsvRHY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDnz8xMPO3_PidCF-iwvtZ1Tj9KkkuawM5hv-5JORKUUw&oe=6A4FB620"}, {"file_name": "consume.png", "id": "356221875528110", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39001669_356221878861443_261896368707707264_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NVPB3mHVKHsQ7kNvwHWl0-F&_nc_oc=AdoSosz8UihwYkluf4Gk-dT-hh2oNTg9yNEM6SRJc4NeNd4mZLnUT7eqZHHIbeW-AeM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAWBQgBAaICShfpg0D-OYrjJ5zbwO4ZjDFwaR3XNi3fbw&oe=6A4FA283"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "38982553_2716489995261681_7852865887418274915_n[1].png", "id": "1017968672039348", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974845_1017968675372681_3537640423345626257_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pxbs6YU2_O8Q7kNvwEPAmEQ&_nc_oc=Adq_SH3nmXBzAfR34f6GfHrM5pHeTPoySuMKDtOZI1l3W6IXYGxpHJHabSFWKQoBKaE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBQP_I4vgwZfT8RzCaefIq-A0lX_EHnuTJT4JLAXnBAIg&oe=6A4FBBC6"}, "display_name": "TEOC", "keywords": ["arcade", "puzzle", "casual", "atmospheric", "puzzler"], "long_description": "Evolve from an atomic state to marine-life in this spatial arcade puzzler with just one goal: Consume or be Consumed! \n\nPowered by elemental forces and mythical artifacts navigate your way through 3 environments with 30+ rounds each to get through. Will you be able to top the leaderboard for each of these? \n\nTEOC provides\u2026\n\u2022 more than 5 hours of mesmerizing gameplay,\n\u2022 a beautiful minimalist style with ambient adaptive soundtracks,\n\u2022 10+ game mechanics to master,\n\u2022 additional powerups to collect and use across all 90+ rounds\n\u2022 with daily powerup rewards for coming back\n\u2022 to compete on the 3 leaderboards,\n\u2022 increasingly challenging level design all procedurally generated\n\u2022 and seated or standing play options!\n\n\n", "short_description": "Evolve from an atomic state to marine-life in this spatial arcade puzzler with just one goal: Consume or be Consumed! \n\nPowered by elemental forces and mythical artifacts navigate your way through 3 environments with 30+ rounds each to get through. Will you be able to top the leaderboard for each of these? With >5 hours of mesmerizing gameplay, 10+ game mechanics to master and all set in a beautiful minimalist style with ambient adaptive soundtracks, you can enjoy it seated or standing up!\n"}]}, "developer_name": "HEADGEAR GbR", "developer_privacy_policy_url": "https://headgear.io/legal.html", "developer_terms_of_service_url": "https://headgear.io/legal.html#terms", "publisher_name": "HEADGEAR GbR", "support_website_url": null, "website_url": "https://headgear.io/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_categ
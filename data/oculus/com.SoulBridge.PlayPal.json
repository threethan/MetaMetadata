on-v1-origin.png", "id": "1841418946817816", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499619836_1841418950151149_8942303108232596395_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QrLnBo7lPrQQ7kNvwEcNURk&_nc_oc=AdoItpjRcvT-fUVD5dDJf9O9YudLHP2AbzD83QYefjkJpnnMG1V3yxvBOrW3Cpw5GcM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAbTeKUC8WNVzr7BP-iH_wN7Rk0UystFDQqkweeDIDoYQ&oe=6A6B5DFF"}, {"file_name": "04-5554-2.png", "id": "2469813680138279", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499302348_2469813683471612_3344528986393649658_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vnTNqDKF3pUQ7kNvwF2rupi&_nc_oc=Adrz_5_iXM54bbr7eBo1ytI7a20rHrxu_pezwheEiAWmcMDt4raY0W81DVzqmJzZt48&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCRG68omls8rXlRt7C5dd2q-t-u9teVbHldPBNzPGF4hQ&oe=6A6B6513"}, {"file_name": "1114_1.png", "id": "1314307034132045", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499618093_1314307037465378_252344928507729145_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JrrtlevhggUQ7kNvwFTnDFR&_nc_oc=AdpPXIr_eW1gEbjvqmUhmnGLNo6es3c8bdXXhGZH5kfqukp2iK2vEWY8u4XD-Xvv4-k&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB2k3ikwvHldO2GVvwq2vvKX9OyIOf3i7OXZJM-7p6QSA&oe=6A6B6ADC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560-1440.png", "id": "1493398808473464", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499619681_1493398811806797_4814558169893038949_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zi6NRZ-20lMQ7kNvwFQGF42&_nc_oc=AdqywqIGOS7CpMSOTH_-3mgDXlqFQRw4k5HjjfTkYi9Ue1vYbSHMnAbesJSuHR2L-Qg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD3qncLqSpmAc06nYWy7BdAo8lZLpLScfDqbMkBXyd0fg&oe=6A6B44D0"}, "display_name": "PlayPal - AI Sims", "keywords": ["AI", "dating", "roleplay", "simulation", "girlfriend"], "long_description": "In PlayPal, dozens of AI companions with unique personalities are waiting to meet you. From an elegant secretary, to a sharp-tongued cosplay shop clerk, a gentle market owner, a book-loving cafe barista, a witty casino manager, and a clever pizza shop owner, every character has a story to uncover. Get to know them, explore their lives, and open your heart as they become more than just companions.\n# Here's what you can do:\n- **Social & Chat**:  Meet dozens of residents, complete their quests, build affection, and discover their personal stories. Along the way, you might even find your soulmate. Start a voice conversation with them anytime, anywhere, or invite up to three companions into a lively group chat.\n\n{2776649812703410}\n\n- **Entertainment**: Spend quality time with your companions in all kinds of fun ways. Invite them to your home to watch TV, throw a pool party, enjoy a group dance performance at the Casino, or challenge them to a card game.\n\n{946468804620192}\n\n- **Farm & Crafting**: Slow things down and enjoy peaceful farm life by planting crops, raising animals, and selling your harvest to earn coins. Gather resources, craft useful items, and fulfill special orders from your companions.\n\n{1601869101023453}\n\n- **Explore**:  Venture into more than 10 unique themed worlds, each filled with activities and surprises. Go fishing, practice archery, cast magic against monsters, or jump into exciting shooting challenges.\n\n{1862989054412344}\n\n\nThe game is still in development, with exciting features to come. Join us: https://discord.gg/xgtkNRXMPs", "short_description": "In PlayPal, dozens of AI companions with unique personalities are waiting to meet you. From an elegant secretary, to a sharp-tongued cosplay shop clerk, a gentle market owner, a book-loving cafe barista, a witty casino manager, and a clever pizza shop owner, every character has a story to uncover. Get to know them, explore their lives, and open your heart as they become more than just companions."}]}, "developer_name": null, "developer_privacy_policy_url": "http
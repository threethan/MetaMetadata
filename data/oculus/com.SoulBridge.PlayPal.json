y.\n\nYou can choose multiple AI companions to join you on quests, explore maps, and collect rewards and essential items for various missions.", "short_description": "Living in a lively town alongside AI companions. Play together, fight together, live together with them."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/174Yg9I_HYAYVVqyU-v6d4krVl9V69c2HiN_Us1aqmPU/edit?tab=t.0", "developer_terms_of_service_url": "https://docs.google.com/document/d/1THYFCmnHSjYTnwwNpx_yP2775axSON0e_7cdTOTUkro/edit?tab=t.0", "publisher_name": "SoulBridge", "support_website_url": null, "website_url": "https://playpal.carrd.co/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1023770785722696"}, {"id": "331529188132278"}, {"id": "1990104051447093"}], "external_subscription_type": "REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "27986760037638781"}}]}, "scheduled_offers": {"count": 3, "nodes": [{"status": "PUBLISHED", "id": "1191641892489622"}, {"status": "PUBLISHED", "id": "1130497755423069"}, {"status": "PUBLISHED", "id": "946888087540388"}]}, "baseline_offer": {"id": "1191641892489622"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1743466020, "status": "PUBLISHED", "id": "1191641892489622"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "34010573678590690", "version": "0.9.3.1"}, "id": "1539723553398503", "channel_name": "LIVE"}]}, "is_fo
on-v1-origin.png", "id": "1841418946817816", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499619836_1841418950151149_8942303108232596395_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EanHW9hmzKEQ7kNvwGU7Peg&_nc_oc=AdoeI5vbZUWvjOPqa0xU3xRQc66gY4evUGD_TQRR2h1iZnAOSr_jL2FHr9Fal1Mfht0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIdu_rOY8A19fn1h6gVRtmSi6mpLvrzY1pJZm_OILDaBg&oe=6AB28EFF"}, {"file_name": "04-5554-2.png", "id": "2469813680138279", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499302348_2469813683471612_3344528986393649658_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f7SN4MRWL4QQ7kNvwEzBnQ5&_nc_oc=Adr5QVR6rnSB_D-5ptYT06Ic20Da65mcW2p4BOOkUSXhUUFIJaoU_YoP1vIbQ2pXMko&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJXijx70GHlJWvhF9R1qfVbzJb3apLd3nNUGsV4yptwxA&oe=6AB29613"}, {"file_name": "1114_1.png", "id": "1314307034132045", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499618093_1314307037465378_252344928507729145_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zcQ-J8j4SK4Q7kNvwEpa2SZ&_nc_oc=AdonvRfaaioVPRfpO2UYJ0J6VDhgIF88-jVL8_v049M0R8SwbuU_9cmhuF-UZR0eAjM&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJQ5J37hhd_-HDIfY2qZ_V_KlBS4u0STzdCvgbErwSwVA&oe=6AB29BDC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560-1440.png", "id": "1493398808473464", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499619681_1493398811806797_4814558169893038949_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-ymEdi5aRWgQ7kNvwHCn22u&_nc_oc=AdojBEbFRlX4sZfkm2pE44rt6_za6t0IfBFT3EfwUl54GVViOg0rz_3exOMoLhtPLa8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKAP2c--7FCHsGhp-e8Vo7ucT-I_rWh6mqVcxKadCPdtw&oe=6AB275D0"}, "display_name": "PlayPal - AI Sims", "keywords": ["AI", "dating", "roleplay", "simulation", "girlfriend"], "long_description": "In PlayPal, dozens of AI companions with unique personalities are waiting to meet you. From an elegant secretary, to a sharp-tongued cosplay shop clerk, a gentle market owner, a book-loving cafe barista, a witty casino manager, and a clever pizza shop owner, every character has a story to uncover. Get to know them, explore their lives, and open your heart as they become more than just companions.\n# Here's what you can do:\n- **Social & Chat**:  Meet dozens of residents, complete their quests, build affection, and discover their personal stories. Along the way, you might even find your soulmate. Start a voice conversation with them anytime, anywhere, or invite up to three companions into a lively group chat.\n\n{2776649812703410}\n\n- **Entertainment**: Spend quality time with your companions in all kinds of fun ways. Invite them to your home to watch TV, throw a pool party, enjoy a group dance performance at the Casino, or challenge them to a card game.\n\n{946468804620192}\n\n- **Farm & Crafting**: Slow things down and enjoy peaceful farm life by planting crops, raising animals, and selling your harvest to earn coins. Gather resources, craft useful items, and fulfill special orders from your companions.\n\n{1601869101023453}\n\n- **Explore**:  Venture into more than 10 unique themed worlds, each filled with activities and surprises. Go fishing, practice archery, cast magic against monsters, or jump into exciting shooting challenges.\n\n{1862989054412344}\n\n\nThe game is still in development, with exciting features to come. Join us: https://discord.gg/xgtkNRXMPs", "short_description": "In PlayPal, dozens of AI companions with unique personalities are waiting to meet you. From an elegant secretary, to a sharp-tongued cosplay shop clerk, a gentle market owner, a book-loving cafe barista, a witty casino manager, and a clever pizza shop owner, every character has a story to uncover. Get to know them, explore their lives, and open your heart as they become more than just companions."}]}, "developer_name": null, "developer_privacy_policy_url": "http
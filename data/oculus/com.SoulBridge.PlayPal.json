iBpBL_Q&oe=6A858393"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "PlayPal - AI Town", "keywords": ["AI", "simulator", "casual", "living"], "long_description": "Welcome to our demo version of PlayPal - AI Town! In this casual simulation game, you become the mayor of a vibrant town filled with AI companions. Each AI has its own unique personality and life story, offering engaging interactions. You can chat with them anytime.\n\nTo unlock these AI companions, you'll need to build your relationship with them. Once unlocked, they can run their own shops and help boost the town's economy.\n\nYou can choose multiple AI companions to join you on quests, explore maps, and collect rewards and essential items for various missions.", "short_description": "Living in a lively town alongside AI companions. Play together, fight together, live together with them."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/174Yg9I_HYAYVVqyU-v6d4krVl9V69c2HiN_Us1aqmPU/edit?tab=t.0", "developer_terms_of_service_url": "https://docs.google.com/document/d/1THYFCmnHSjYTnwwNpx_yP2775axSON0e_7cdTOTUkro/edit?tab=t.0", "publisher_name": "SoulBridge", "support_website_url": null, "website_url": "https://playpal.carrd.co/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1023770785722696"}, {"id": "331529188132278"}, {"id": "1990104051447093"}], "external_subscription_type": "REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "2798676
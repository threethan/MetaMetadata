771-25/499620444_763442149678874_322755567518990958_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dzH7Cl-L2KgQ7kNvwHDc1UG&_nc_oc=AdpwUKOpDm-KSbWRr1ZwBYBraesPIHSGytfGmGsKoYfAsC5kT_8XR-PSlIRe2Wkjkpg&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_Af3bk-iwfvp_K43XlpY2knnSjquUMQ5uyMc-ZLlthXO3Fg&oe=69F2139D"}, {"file_name": "screenshot-3.png", "id": "1292008629422492", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499618274_1292008632755825_6789969044111444888_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PbSPRSb2ErMQ7kNvwGprofG&_nc_oc=AdqhedO9OP74g1LZSNWgZ4uMLnNljohcQC7affGLBu8hH2Ewr7KuSkAmfJn35sHXg7o&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_Af2v4prvWWXzS5Gj2P0wyECtMQ_GK2b6lqmeGMTgqpx-zw&oe=69F20E6A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover-2560-1440-11.png", "id": "4457269181221394", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499618251_4457269184554727_7536675999419750929_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fG2Fal9t6T4Q7kNvwEj-zeL&_nc_oc=Adq2Aco03QfbWCH22dWtiUNvb6BxcopDktC1OHXK_-W2_Q4HWe6bFYY52wWFJRTg0zo&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_Af3sRWqtawUCncBCl5P4L7upMwj-dN61bhHnUppDRZrNxw&oe=69F2062D"}, "display_name": "PlayPal - AI Sims", "keywords": ["AI", "dating", "roleplay", "simulation", "girlfriend"], "long_description": "Welcome to the world of **PlayPal**  with a group of charming AI companions, where you can chat, roleplay, play games and more. They will simulate life in this world, and you can participate and change their behaviors.\n# Here's what you can do:\n- **Social & Chat**: You can start a voice conversation with them anytime and anywhere, support for English, French, German, Spanish, Italian, Japanese and Chinese. Or you can have them follow you as you tour the world. Start a card game or go on an adventure with them. You can engage in various fun activities with them.\n\n{2740834432918257}\n\n- **Themed World**: There are more than 10 different themed worlds waiting for you to explore. You can fish, practice archery, cast magical attacks on monsters, and play shooting games.\n\n{1862989054412344}\n\n- **Casino Club**: You can play the drums and pool here, invite your friends to do group dances, or dance together with them in Night.\n\n{946468804620192}\n\n- **Farm management**: You can also enjoy a relaxing time on the farm, planting a variety of crops and selling them to own coins. You can also raise farm animals. Perhaps catching butterflies can be a lot of fun too.Shooting small rabbits with a bow and arrow is also quite fun.\n\n{1601869101023453}\n\n- **Crafting**: Gather various resources to craft items and fulfill orders from your companions.Perhaps you might find it tiring, so you can capture some Pals to help you with the work.\n\n{1721392888824853}\n\nThe game is still in development, with exciting features to come. Join us: https://discord.gg/xgtkNRXMPs\n", "short_description": "Welcome to the world of PlayPal with a group of charming AI characters, where you can chat, roleplay, play games, complete their quests, and more.They will simulate life in this world, and you can participate and change their behaviors.\nAlternatively, you can simply chat with them, support for English, French, German, Spanish, Italian, Japanese and Chinese."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/174Yg9I_HYAYVVqyU-v6d4krVl9V69c2HiN_Us1aqmPU/edit?tab=t.0", "developer_terms_of_service_url": "https://docs.google.com/document/d/1THYFCmnHSjYTnwwNpx_yP2775axSON0e_7cdTOTUkro/edit?tab=t.0", "publisher_name": "SoulBridge", "support_website_url": null, "website_url": "https://playpal.carrd.co/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}, {"id": "821934236779161"}, {"id": "331529188132278"}], "external_subscripti
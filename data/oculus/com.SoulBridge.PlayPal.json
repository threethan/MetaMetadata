3-2.oculuscdn.com/v/t64.5771-25/499617847_1408539077956108_5209653969793749948_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2ewF7kjcDKYQ7kNvwHX39in&_nc_oc=Adr7O3sfdkLa-DskuM7cQdFRx488c9biZ8utyrvDl7p3UI4xD00htAmyaHnVNdEqQDU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4QBPlzjUdtrdR6EwJBRsrxZfHsafhNltuoPpiRPt8CFg&oe=6A0DAE37"}, {"file_name": "1114_1.png", "id": "1314307034132045", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499618093_1314307037465378_252344928507729145_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Wd0z4lBI9U8Q7kNvwGXHjcs&_nc_oc=AdpdvUknzA2Y6hwtJ-kmBOYKfb-zhPFr2QPR5THwkpgwqWKWZL-6AngWq5nXv4a6pgQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7MKgVBsVdsUCw6IB8m-Xk95053ALwdIguFMfgR1ddNeg&oe=6A0DD05C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "3-2560-1440.png", "id": "816075361234904", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491819375_816075364568237_2374187472670783285_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D-EpwgDPChEQ7kNvwFsggfY&_nc_oc=AdqwajNWwJ0QSZWUkNGjsBm_eIA6EKftd4gSIj0iiIPhMAsdKWkQsYMrHhme1MQE0b8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5O0RGw3fn-a08yDcT0jkff25Su_tgro4JsUDdtQpGOFg&oe=6A0DAF9E"}, "display_name": "PlayPal - AI Sims", "keywords": ["AI", "dating", "roleplay", "simulation", "girlfriend"], "long_description": "Welcome to the world of **PlayPal**  with a group of charming AI companions, where you can chat, roleplay, play games and more. They will simulate life in this world, and you can participate and change their behaviors.\n# Here's what you can do:\n- **Social & Chat**: You can start a voice conversation with them anytime and anywhere, support for English, French, German, Spanish, Italian, Japanese and Chinese. Or you can have them follow you as you tour the world. Start a card game or go on an adventure with them. You can engage in various fun activities with them.\n\n{2740834432918257}\n\n- **Themed World**: There are more than 10 different themed worlds waiting for you to explore. You can fish, practice archery, cast magical attacks on monsters, and play shooting games.\n\n{1862989054412344}\n\n- **Casino Club**: You can play the drums and pool here, invite your friends to do group dances, or dance together with them in Night.\n\n{946468804620192}\n\n- **Farm management**: You can also enjoy a relaxing time on the farm, planting a variety of crops and selling them to own coins. You can also raise farm animals. Perhaps catching butterflies can be a lot of fun too.Shooting small rabbits with a bow and arrow is also quite fun.\n\n{1601869101023453}\n\n- **Crafting**: Gather various resources to craft items and fulfill orders from your companions.Perhaps you might find it tiring, so you can capture some Pals to help you with the work.\n\n{1721392888824853}\n\nThe game is still in development, with exciting features to come. Join us: https://discord.gg/xgtkNRXMPs\n", "short_description": "Welcome to the world of PlayPal with a group of charming AI characters, where you can chat, roleplay, play games, complete their quests, and more.They will simulate life in this world, and you can participate and change their behaviors.\nAlternatively, you can simply chat with them, support for English, French, German, Spanish, Italian, Japanese and Chinese."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/174Yg9I_HYAYVVqyU-v6d4krVl9V69c2HiN_Us1aqmPU/edit?tab=t.0", "developer_terms_of_service_url": "https://docs.google.com/document/d/1THYFCmnHSjYTnwwNpx_yP2775axSON0e_7cdTOTUkro/edit?tab=t.0", "publisher_name": "SoulBridge", "support_website_url": null, "website_url": "https://playpal.carrd.co/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}, {"id": "821934236779161"}
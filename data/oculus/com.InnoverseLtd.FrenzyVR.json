-__kC6GMJDp4HzC40_vA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE_cdXmeS7kuiBO7rQKoN9GF5m7G4Ux4G9DJM7wqsEUJQ&oe=6A844690"}, {"file_name": "Screenshot5.png", "id": "880776882536974", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974655_880776885870307_730458897018616067_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sbRUFFNGDKAQ7kNvwHEBnZL&_nc_oc=AdpPz1-s9pNcMD_QGE9b5mV6ehJ_g3e_5LNBL43VqBTYZ2esa4AUoJM9D_QPfePoWVk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE_XcTR-V0N7k7i3lhsFC3NcnEx-9n9siRM9xfGqJkNpw&oe=6A8452DE"}, {"file_name": "Screenshot4.png", "id": "272936900942329", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974883_272936904275662_2662082753078920897_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cw9-uclNTBgQ7kNvwHHl73x&_nc_oc=AdrY50bIj1q8Bidc9hHR8u_bpUaffA7kZmWVhWvm86tqdH90Qua2F5r1xKPhmzgf6mA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHpZ8JIBe9cMYq4QgI3TEJHZAd9_Hn9Bx06jGa63EZOmQ&oe=6A844874"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Banner Landscape.png", "id": "518109149255436", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974584_518109152588769_9082015115285105038_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eYFdffagre0Q7kNvwEwEg99&_nc_oc=AdpD5VObCiMk_w6niyTYuD8Leezs9Q8Z5AGc1rcmFOHcivzFg7J9Sw-Xic5SWHHlFN0&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHUI4PNF9f_LQ0tt3bG8gaj9iFnI9Wv4h2_yHJk9QAe_g&oe=6A84339B"}, "display_name": "Frenzy VR", "keywords": [], "long_description": "Frenzy VR is a game full of mayhem and destruction. You are placed inside carefully constructed environments where you can go mad and be free to do what you please in a world without consequences. A VR game where all objects can be a weapon, with the added bonus of having satisfying destruction physics. Ever dreamed of hitting your best friend in the face with a toaster? Probably not, but now I mentioned it I bet 
dn.com&_nc_ss=7f20f&oh=00_AQJrdxkF6-w9kxgq0-0A-vDKvZfcBAyCVK-_xSpUewAlgA&oe=6AB13997"}, {"file_name": "Screenshot3.png", "id": "359778832413523", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982608_359778835746856_211841733235979620_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hXOwPXqXIecQ7kNvwHtvi08&_nc_oc=AdpWUgzvPG9sdFDXxSEgo2qK-AV0Wn3A5F4yDxfNvArKXex8XxpDJlgS4ZlGYmvWAsE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJsCWg1Rf77nSIvxr2MOueymeUQK6lNJl9o-U4HLMeRHg&oe=6AB151D0"}, {"file_name": "Screenshot5.png", "id": "880776882536974", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974655_880776885870307_730458897018616067_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HtQronLQ61UQ7kNvwFVxBMe&_nc_oc=AdpDevMz2K-ctC0WXhHLnQCI-W1-Y_pkdsTySVT5lyXrdxcED2XYbjdT-skGF7bE1Zw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJh9DzEc1QUPahgJeBxBTM_zbAuhhqaWHBofStGS7rtDw&oe=6AB125DE"}, {"file_name": "Screenshot4.png", "id": "272936900942329", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974883_272936904275662_2662082753078920897_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y3MkThhDNDIQ7kNvwEgzXz8&_nc_oc=Adr3FS__tT4N2bNL4k1-14y0kpG3UQdrUISrYR1jiIojhhPMplgI5fNNx5BBp0C3VfI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQItUIQekkk_PNPg5u5UmFjTiyKs9s8pse3-Q3dNG8umow&oe=6AB153B4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Banner Landscape.png", "id": "518109149255436", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974584_518109152588769_9082015115285105038_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l0D-euIERR0Q7kNvwH4hi02&_nc_oc=Ado28vTeJquNBFfOzY_VVYJDWH-HhvYmC3O4-dr-B8ipvbA5pYHEcl-RI1ahcm8CKeo&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIigLhfCe4kmIpi96-0740mp9Kzm96CsPyK9QrYk3nLnQ&oe=6AB13EDB"}, "display_name": "Frenzy VR", "keywords": [], "long_description": "Frenzy VR is a game full of mayhem and destruction. You are placed inside carefully constructed environments where you can go mad and be free to do what you please in a world without consequences. A VR game where all objects can be a weapon, with the added bonus of having satisfying destruction physics. Ever dreamed of hitting your best friend in the face with a toaster? Probably not, but now I mentioned it I bet you want to try it! Frenzy VR is great for stress relief, anger management, and of course just having a bit of fun!\n\n", "short_description": "A destruction and mayhem sandbox playground"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.innoverse.co.uk/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Innoverse Ltd", "support_website_url": null, "website_url": "https://www.innoverse.co.uk/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2710427532541308"}, {"id": "1990104051447093"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "FIGHTING", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "5205085132844253"}}]}, "scheduled_offers": {"count": 20, "nodes": [{"status": "PUBLISHED", "id": "1600709514833609"}, {"status": "PUBLISHED", "id": "2179458412907127"}, {"status": "PUBLISHED", "id": "26159986960356607"}, {"status": "PUBLISHED", "id": "897742812757575"}, {"status": "PUBLISHED", "id": "1575626173437873"}, {"status": "PUBLISHED", "id": "1855863745337132"}, {"status": "PUBLISHED", "id": "1330486948443161"}
luscdn.com/v/t64.5771-25/39001727_1435267930466865_1521832622986079609_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2Wr2h6eKjAcQ7kNvwGNDDba&_nc_oc=Ado5roCFrN_czNZj1UYpd1HBMXcAuP0jR86fetP12hRRQhTDtNv4fckPOES6JDfOQq0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQJx1IsBEtIQ47JYOwGZOkn3h5qRigefWnph_F5-Vhs3A&oe=6B007D40"}, {"file_name": "fss2.png", "id": "487757603627320", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75371505_487757606960653_694722185615763208_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LcDcBbjlpOwQ7kNvwHSm8GA&_nc_oc=AdpO89K9hYKu88Zus6YkwhJZ9-vm7pmbZj0T4UXFMJGkdWXmYndlPGTMujmDouk88jU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSNkJ2idNiAWOHxoBF3ErcLd51FZfRiejef6lrXT4A1qg&oe=6B0079BC"}, {"file_name": "fss4.png", "id": "1472874233617175", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974518_1472874236950508_7625030607912362245_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gtp5dBLXbDEQ7kNvwFDJtGz&_nc_oc=Adqs-O9mn9oEkPpZJjMiCXBxoCj5-SGt8iH-9JQxZ3f-wWEt4tty55b1i3mtmR5VVx4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSIFEEheuD6LyxhWSVJALljslnla_1ajd2yc_Rm6wpGNg&oe=6B006B26"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "FVR Multiplayer Landscape Cover.png", "id": "1058016647153281", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499312236_1058016650486614_3321378648357181045_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zOmyfpBDfFkQ7kNvwFErkG1&_nc_oc=Adrc8jFJHRGlR5q5oQhC4xSWWkgcHY4o4RIv859wT6w5jIe8j1AHnIRK4C51lE8Vr_s&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRg59M4Ttcen5Au_AJTaHneRbM1OzmqJ19xSEwaclZJTQ&oe=6B006FCF"}, "display_name": "Frenzy VR", "keywords": ["frenzy", "physics", "shooter", "sandbox", "labs"], "long_description": "#                                                                                                                                                                                                      \n{1066880332875476}\n\n# Multiplayer Update Now Live!                              \nThe most requested feature in Frenzy VR history is finally here. Squad up with friends across sandbox mode or any modded map.\n{1588884729638917}\n\n# Fully Interactive & Destructive Environments. \nNothing is off limits. Tear apart everything in sight and crash out with zero real-world consequences.\n{1254229240162704}\n\n# Ragdolls\nWatch NPCs fly with physics-driven ragdolls that react to every hit, every time.\n{3621268474697014}\n\n# Over 50 Different Weapons at Your Disposal\nFrom melee to firearms, every weapon carries real weight and impact built for pure chaos.\n{940982865718899}\n\n# 10+ Maps, Missions & Endless Mods\nUnique maps, scenarios, and enemies in every level, with community-made mods adding even more ways to play.\n{1374121444409265}\n\n# Story Mode & Free Play\nTake on the full campaign, or cut loose in free play and make the mayhem your own.\n{2395213497552433}", "short_description": "Frenzy VR is an action sandbox built around destruction, shooting, ragdolls, and mayhem. Did we mention there are a ton of weapons? Melee weapons, ranged weapons, modded weapons, realistic weapons, fantastical weapons, or any object you can get your hands on! Dive into a full story campaign with multiple missions, explore free play across 10+ destructible maps, or play community made content. Crash out and cause chaos with zero real-world consequences, solo or in multiplayer gamemodes."}]}, "developer_name": "Innoverse Ltd", "developer_privacy_policy_url": "https://clique.games/privacy", "developer_terms_of_service_url": "https://clique.games/terms", "publisher_name": "Clique Games", "support_website_url": null, "website_url": "https://www.innoverse.co.uk/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "co
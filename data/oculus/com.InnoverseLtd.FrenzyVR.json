7757606960653_694722185615763208_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sIEdiFCUieQQ7kNvwGsmGAE&_nc_oc=AdoGoYkuSn9pha2BKWqKHewCe0Dg3CVrc3fvpYnIjP91h4BlOPXqu7vc6Xbty9wdCXw&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNwbZMLZweBqfO-FtLhEs_iomj77OeAjbHd40qKmhZ73A&oe=6AD3A6BC"}, {"file_name": "fss4.png", "id": "1472874233617175", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974518_1472874236950508_7625030607912362245_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nlSFxiZ955wQ7kNvwHxswb4&_nc_oc=AdoYM8NBTXhDlYsZatfWF2jnBMRFMHDd9_KFOc5KtzDqS2S6FmyTARrB6wy9sE1lLnU&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMkdXGqCOIBK2cmGaaiLr1pCdP-q05ZSpQxBrkoTh12zA&oe=6AD39826"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "FVR Multiplayer Landscape Cover.png", "id": "1058016647153281", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/499312236_1058016650486614_3321378648357181045_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vXR0W_xDsNAQ7kNvwHDazr6&_nc_oc=Adqt-qFAAymWJcv1PbQhdif1tzAekyFZ8BMoAWt7nmHEbfLz7Qn47S137Y3P6h2Zec8&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMTxOxfe0Ja2Z14K_Ta91kuN5SLeOcnSVL1DLv8iWmCuQ&oe=6AD39CCF"}, "display_name": "Frenzy VR", "keywords": ["frenzy", "physics", "shooter", "sandbox", "labs"], "long_description": "#                                                                                                                                                                                                      \n{1066880332875476}\n\n# Multiplayer Update Now Live!                              \nThe most requested feature in Frenzy VR history is finally here. Squad up with friends across sandbox mode or any modded map.\n{1588884729638917}\n\n# Fully Interactive & Destructive Environments. \nNothing is off limits. Tear apart everything in sight and crash out with zero real-world consequences.\n{1254229240162704}\n\n# Ragdolls\nWatch NPCs fly with physics-driven ragdolls that react to every hit, every time.\n{3621268474697014}\n\n# Over 50 Different Weapons at Your Disposal\nFrom melee to firearms, every weapon carries real weight and impact built for pure chaos.\n{940982865718899}\n\n# 10+ Maps, Missions & Endless Mods\nUnique maps, scenarios, and enemies in every level, with community-made mods adding even more ways to play.\n{1374121444409265}\n\n# Story Mode & Free Play\nTake on the full campaign, or cut loose in free play and make the mayhem your own.\n{2395213497552433}", "short_description": "Frenzy VR is an action sandbox built around destruction, shooting, ragdolls, and mayhem. Did we mention there are a ton of weapons? Melee weapons, ranged weapons, modded weapons, realistic weapons, fantastical weapons, or any object you can get your hands on! Dive into a full story campaign with multiple missions, explore free play across 10+ destructible maps, or play community made content. Crash out and cause chaos with zero real-world consequences, solo or in multiplayer gamemodes."}]}, "developer_name": "Innoverse Ltd", "developer_privacy_policy_url": "https://clique.games/privacy", "developer_terms_of_service_url": "https://clique.games/terms", "publisher_name": "Clique Games", "support_website_url": null, "website_url": "https://www.innoverse.co.uk/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1990104051447093"}, {"id": "1008279844328894"}, {"id": "3744040075834813"}, {"id": "2710427532541308"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "FIGHTING", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": 
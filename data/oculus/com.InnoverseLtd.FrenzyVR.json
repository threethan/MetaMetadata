-0FGzeBwswSkn2Iln4d8&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-gW5txlXV9kTz2PmDiIhvylZleRTVjaLt22YRIyRSRAQ&oe=6A3FF0D0"}, {"file_name": "Screenshot5.png", "id": "880776882536974", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974655_880776885870307_730458897018616067_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=knDiXvkrhxwQ7kNvwFl8DE7&_nc_oc=AdpumChi-56pdGCbGmvi0wBZ6v2bcgmSmeoWhEGr3NhT77z0iy4Ay2OOu-MdnzDrFy8&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_oNj1l11pCDbU33nKsBoN70h5SPdT9h1dlaWE9KZZhrQ&oe=6A3FC4DE"}, {"file_name": "Screenshot4.png", "id": "272936900942329", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974883_272936904275662_2662082753078920897_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3cUhsp5HJH4Q7kNvwHhrOPJ&_nc_oc=AdrrFYKAXxbsenzcX6sjXcfquypwydolc-LyEqoSSNWraXKWY3ms5P_ngStqANwpIV4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8B5NPLPEJ5JQaP5LGCRSb0GbZPAaepM-ja30JFqUihvA&oe=6A3FF2B4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Banner Landscape.png", "id": "518109149255436", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974584_518109152588769_9082015115285105038_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Bub_dHz5yKgQ7kNvwFNIfkY&_nc_oc=Adpz5y6chwGmnU-7kmygLmXGZnM0_hgJaQiR4uc937ifKxqatPSJOjlFqFoFYqG-Qgo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-yna5U-_9fGXDcHGHMEKSk8FW1oLvdJ2Rq-96sWwQhGA&oe=6A3FDDDB"}, "display_name": "Frenzy VR", "keywords": [], "long_description": "Frenzy VR is a game full of mayhem and destruction. You are placed inside carefully constructed environments where you can go mad and be free to do what you please in a world without consequences. A VR game where all objects can be a weapon, with the added bonus of having satisfying destruction physics. Ever dreamed of hitting your best friend in the face with a toaster? Probably not, but now I mentioned it I bet 
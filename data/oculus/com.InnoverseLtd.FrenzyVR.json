KX1SY0RgN3833TM9eajQ&oe=69F0BC26"}, {"file_name": "fss5.png", "id": "1435267927133532", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39001727_1435267930466865_1521832622986079609_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UQHv7LaaMNoQ7kNvwEv1OX0&_nc_oc=AdqeKOdG07nE2q4x4yFcPfWpYAbLy5NdD0-Md8llaNWfLFBZ-4Vj8UwfWfnuYLehaMM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af0anph2fFNogBJqyOqSsMqP1i65vUip6bJtaKBzzyK4Ew&oe=69F0B000"}, {"file_name": "fss2.png", "id": "487757603627320", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75371505_487757606960653_694722185615763208_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=snp8KNm6-lYQ7kNvwHV7i0n&_nc_oc=Adr7pN5dQzEmVch2ZDYR9O8xdGDVFOjGSRIVUiY5DuNvcY6x5xHOEYbnIeBMdzTOd4s&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Af15cW1o4v7ZJCmRFcdk7iBb6KJvi5JB_ZGIgh7jbGmrZg&oe=69F0AC7C"}, {"file_name": "fss4.png", "id": "1472874233617175", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974518_1472874236950508_7625030607912362245_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zXxTBK-LY_wQ7kNvwHE5ZdE&_nc_oc=Adr2QgTG2MitSP1yKO6YnUpCOP-CKTABzlBqV1-x83SpkN7moA3YCbESfGGeblVpgKc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af0po7_r_r79Oaak-R5vDbBLc0gTrbOaCKB_sIT4NrQrpA&oe=69F09DE6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "fvrabtestlandmods.png", "id": "838172881603221", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974667_838172884936554_1546969593173240089_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j7lv_noqAoYQ7kNvwHEKSNh&_nc_oc=Adr_01OFapLo3LQTefe75t9ze-72YUbL5IqZyH2sRNc3Ee1uwUIs0j2e1pXoDZ7A3es&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Af2KsMZa4SoRRQYJXHhCozCX5Ke98oeej7gThZEmlr9ZFA&oe=69F0BE06"}, "display_name": "Frenzy VR", "keywords": ["frenzy", "extinction", "physics", "shooter", "cheap"], "long_description": "# Frenzy VR is an action fighter all about destruction & interactive environments. \n\nYou can use **any object** as a weapon with our advanced destruction physics for realistic mayhem. Frenzy VR includes a **story mode** with deep narrative secrets, levels, and objectives. Take the chaos into your own hands with **free play modes** allowing unlimited creativity across **various maps** like offices, apartments, prisons, and more.\n\n{2109188632847206}\n\n# FULLY INTERACTIVE AND DESTRUCTIBLE WORLDS\nAll maps feature fully destructible items, objects, & enemies\n{1205834334006646}\n# RAGDOLL PHYSICS WITH MELEE / RANGED WEAPONS\nNPCs use realistic physics ragdolls for ultimate chaos and mayhem\n{1288794592495760}\n# STORY MODE WITH NARRATIVE AND CAMPAIGN\nComplete the full story with multiple missions and take down the Reborn Company\n{427514700347104}\n# 10+ REALISTIC MAPS AND MISSIONS\nGo ballistic in fully interactable worlds built specifically for you to destroy \n{1040111410694158}\n# FULL WEAPON CUSTOMIZATION AND UPGRADES\nRealistic gun and melee weapon physics that feel just like real life\n{1439551213390894}\n# FIGHT VICIOUS AND CRAZY NPCS\nShow no mercy as you fight back against the corrupt NPCs\n{1556545868591589}\n# MODS, MINIGAMES AND GAMEMODES\nYou'll never run out of things to do with our infinitely replayable gamemodes & Mod Support!\n{887725349457146}", "short_description": "\ud83d\udee0\ufe0fMod Support Update!\n- You can now download mods from in-game\n- Create and upload your own mods via Mod.io\n\nFrenzy VR is an action sandbox all about destruction, shooting, ragdolls, realistic combat, and mayhem within interactive destructible environments. Play on multiple levels, with tens of weapons, all with a deep and hidden narrative. Explore weapon customization, boss fights, mini-games, and free play modes! "}]}, "developer_name": "Innoverse Ltd", "developer_privacy_policy_url": "https://clique.games/privacy", "developer_terms_of_service_url": "https://clique.games/terms", "publisher_name": "Clique Games", "support_website_url": null, "website_url": "https://
4XmUCHDFOUinHtZcW3fo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9eCvPepbVO-APMa8onwNOTVUXi0SR44GGYeeRcc7Nwmw&oe=6A4293D0"}, {"file_name": "Screenshot5.png", "id": "880776882536974", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974655_880776885870307_730458897018616067_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8FrZ_36ph2cQ7kNvwFx-3Tf&_nc_oc=Adp1Nyx8V76GlmAas2mvqi9XXt731QIEqsyGa36y5HvCUUH-TWC2VI3P0oewAuy6i8A&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-Q_a_Z0LaVdTDHHUI61tPr0vBcmrT73Poyb1CjGY73_A&oe=6A4267DE"}, {"file_name": "Screenshot4.png", "id": "272936900942329", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974883_272936904275662_2662082753078920897_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LH9SA4Hq4_QQ7kNvwEEmiWw&_nc_oc=AdrKKE_PriTkyppHYmHx1a95qkM9EJXANgsIgU8q_Eqt8KpbUPdCjjPd45seJU4_W9Y&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_8IS_jiOCLHQPtJYEpcXYCZAP7NgjuoiJANj1fbhpHUw&oe=6A4295B4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Banner Landscape.png", "id": "518109149255436", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974584_518109152588769_9082015115285105038_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EYi2hl0icjQQ7kNvwEWwvKA&_nc_oc=AdoHDKmJH8yC3gYT6nQ-YdII-NEt7DePTGN-mGfDy8fjOSsPQI_SbjzGNaDNvMR0i2k&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-UKaevZ-WnmH7jqVZY_Se_WDOwcaKR_C_NvamLHTpYiA&oe=6A4280DB"}, "display_name": "Frenzy VR", "keywords": [], "long_description": "Frenzy VR is a game full of mayhem and destruction. You are placed inside carefully constructed environments where you can go mad and be free to do what you please in a world without consequences. A VR game where all objects can be a weapon, with the added bonus of having satisfying destruction physics. Ever dreamed of hitting your best friend in the face with a toaster? Probably not, but now I mentioned it I bet 
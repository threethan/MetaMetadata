luscdn.com/v/t64.5771-25/39001727_1435267930466865_1521832622986079609_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Cfmeu3nX6JMQ7kNvwGjbWLW&_nc_oc=Adrc-yYza8D5XNBF2b5x6tbfotcbapzy1tv0oYTaSIe_nrr6cbQZYNOofiNZckMGw3Y&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRNu1DliN5w8VC0-oIFR7jnnzlzghZASKE274EvpI7htg&oe=6AFB3740"}, {"file_name": "fss2.png", "id": "487757603627320", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/75371505_487757606960653_694722185615763208_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KAodRFcmdO0Q7kNvwGEMaVv&_nc_oc=AdoUgUPnOs3V6izvUlQ4Qyw2CRr8UBqc2sMp43DEvbwis6dG4avsEZfCa3sZonSv80E&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS_hvbwE6bm86Y58FIvIKcfVKItiQZQFNglNGJrLVEFCw&oe=6AFB33BC"}, {"file_name": "fss4.png", "id": "1472874233617175", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38974518_1472874236950508_7625030607912362245_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dtyVObj0YLMQ7kNvwHrK_Dm&_nc_oc=Adpx0JOBOx7p9dzB8ym7zCbOOlD1cQBgAUH0sVOWcItrd_mZAFGH9S1vFeWiCV4pXDs&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ5knwIbOBh8gjHvq0HPE9qwZc253uy5BoU4wAk1y-FbQ&oe=6AFB2526"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "FVR Multiplayer Landscape Cover.png", "id": "1058016647153281", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/499312236_1058016650486614_3321378648357181045_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l2RfjPwoCZEQ7kNvwFG449T&_nc_oc=AdpwO1gpgXThCNizWj_YdaEwHWZpJKGt_Wg8z-JP_i4Vc7vwZsMZThAodoZ9HFpmJFI&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSk2wmuYz18MNMoBheEoHvOLuuBPPCc5msIA6wEmeObcw&oe=6AFB29CF"}, "display_name": "Frenzy VR", "keywords": ["frenzy", "physics", "shooter", "sandbox", "labs"], "long_description": "#                                                                                                                                                                                                      \n{1066880332875476}\n\n# Multiplayer Update Now Live!                              \nThe most requested feature in Frenzy VR history is finally here. Squad up with friends across sandbox mode or any modded map.\n{1588884729638917}\n\n# Fully Interactive & Destructive Environments. \nNothing is off limits. Tear apart everything in sight and crash out with zero real-world consequences.\n{1254229240162704}\n\n# Ragdolls\nWatch NPCs fly with physics-driven ragdolls that react to every hit, every time.\n{3621268474697014}\n\n# Over 50 Different Weapons at Your Disposal\nFrom melee to firearms, every weapon carries real weight and impact built for pure chaos.\n{940982865718899}\n\n# 10+ Maps, Missions & Endless Mods\nUnique maps, scenarios, and enemies in every level, with community-made mods adding even more ways to play.\n{1374121444409265}\n\n# Story Mode & Free Play\nTake on the full campaign, or cut loose in free play and make the mayhem your own.\n{2395213497552433}", "short_description": "Frenzy VR is an action sandbox built around destruction, shooting, ragdolls, and mayhem. Did we mention there are a ton of weapons? Melee weapons, ranged weapons, modded weapons, realistic weapons, fantastical weapons, or any object you can get your hands on! Dive into a full story campaign with multiple missions, explore free play across 10+ destructible maps, or play community made content. Crash out and cause chaos with zero real-world consequences, solo or in multiplayer gamemodes."}]}, "developer_name": "Innoverse Ltd", "developer_privacy_policy_url": "https://clique.games/privacy", "developer_terms_of_service_url": "https://clique.games/terms", "publisher_name": "Clique Games", "support_website_url": null, "website_url": "https://www.innoverse.co.uk/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "co
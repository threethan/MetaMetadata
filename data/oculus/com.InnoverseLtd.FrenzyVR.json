qImxTfYUkiixEDkQxr8c&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEHSzXAQHHKOi1wWNwyBbdaejEm-DByPZUgO7VfXM0lRw&oe=6A92C710"}, {"file_name": "Screenshot5.png", "id": "880776882536974", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38974655_880776885870307_730458897018616067_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YIGCrXRolQ4Q7kNvwF5ZbGe&_nc_oc=AdqX_gYO5xyuYpNH180DupuqRILbZWxuPqnrYKkViKNtW5RtpA68n6hBpf6r2DlViKc&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF5CtPBLZqcKU8NFqfhJSPMwGbTCnv3FQR0IRzwnFxvog&oe=6A92D35E"}, {"file_name": "Screenshot4.png", "id": "272936900942329", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974883_272936904275662_2662082753078920897_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GeH-oV5mbawQ7kNvwFN9tIa&_nc_oc=Adoks7HIhuq_-wLgD3qk_RZkRVL_uoaicwWPWntHZQRjkaZlIgRmIQLNDvDCYzd4ExU&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFG31m8YaS7VXT8UWC35i1GTy_7Cw4beb52LZnGwgtWRA&oe=6A92C8F4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Banner Landscape.png", "id": "518109149255436", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974584_518109152588769_9082015115285105038_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ft-p5Ats4m8Q7kNvwEoJgW3&_nc_oc=AdopEo63NmlW4zeGonM0A_fGGxzjZJv0nkhFrXeRyMsSNFj7Zun_2npk4NZT9soHuPA&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE_I2jj5dVg8Md9Yf8LBlr9Ewx2A8SSX0Fj9-3QyJRHlw&oe=6A92B41B"}, "display_name": "Frenzy VR", "keywords": [], "long_description": "Frenzy VR is a game full of mayhem and destruction. You are placed inside carefully constructed environments where you can go mad and be free to do what you please in a world without consequences. A VR game where all objects can be a weapon, with the added bonus of having satisfying destruction physics. Ever dreamed of hitting your best friend in the face with a toaster? Probably not, but now I mentioned it I bet 
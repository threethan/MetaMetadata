dn.com&_nc_ss=7f20f&oh=00_AQKlOysBPi55fYwiUEH7zugYDqr6Boj7MxkmYgY1ZIZzPQ&oe=6AAFE817"}, {"file_name": "Screenshot3.png", "id": "359778832413523", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982608_359778835746856_211841733235979620_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hXOwPXqXIecQ7kNvwGnskez&_nc_oc=AdrdVSV48X2zjq1pALlgetGC6fG_AMjznLo2RJN5Oht6ylOg_Xw0hnSmuggNKjfUzeI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIWpHQyHy-15eA3-ms5_Yc1QiacGsFADXhsmJWv432OZA&oe=6AB00050"}, {"file_name": "Screenshot5.png", "id": "880776882536974", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974655_880776885870307_730458897018616067_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9T-2-J-a27YQ7kNvwHWYXWj&_nc_oc=Adrw3sxeh75eEmfd_jGmHP2JfaillI5kX5Idz9pOJlFvW5H65Nzz7dCwlVl5b7kE7dQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJoI6hBoJLaYsJl1VyBJXrR2sydfCHdGAHDp0j8lpx0Qg&oe=6AAFD45E"}, {"file_name": "Screenshot4.png", "id": "272936900942329", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974883_272936904275662_2662082753078920897_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A2mVxf5lB8UQ7kNvwE1GBX5&_nc_oc=AdrO5M8aowfJ7k3XS4hgYExZocZpbf0tdjImmVTaMtunmuHCkJ2-66a2LtfblTADrAU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIcHcVTw6sLEVN9BmxokclpSBwoK1zMQh_Sfhf0zhJeBw&oe=6AB00234"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Banner Landscape.png", "id": "518109149255436", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974584_518109152588769_9082015115285105038_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l0D-euIERR0Q7kNvwGTEoBs&_nc_oc=AdoqVt8gjBq2ps3-1uLtlzZu2cZMQIJDlLh86B_N39mgnQ3E4oAU0lT_WJyqE3xc86E&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK6nM0VyA-cLpFKJMQ4cNUJvWlf5e4dGouSRM3h4cOjVQ&oe=6AAFED5B"}, "display_name": "Frenzy VR", "keywords": [], "long_description": "Frenzy VR is a game full of mayhem and destruction. You are placed inside carefully constructed environments where you can go mad and be free to do what you please in a world without consequences. A VR game where all objects can be a weapon, with the added bonus of having satisfying destruction physics. Ever dreamed of hitting your best friend in the face with a toaster? Probably not, but now I mentioned it I bet you want to try it! Frenzy VR is great for stress relief, anger management, and of course just having a bit of fun!\n\n", "short_description": "A destruction and mayhem sandbox playground"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.innoverse.co.uk/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Innoverse Ltd", "support_website_url": null, "website_url": "https://www.innoverse.co.uk/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2710427532541308"}, {"id": "1990104051447093"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "FIGHTING", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "5205085132844253"}}]}, "scheduled_offers": {"count": 20, "nodes": [{"status": "PUBLISHED", "id": "1600709514833609"}, {"status": "PUBLISHED", "id": "2179458412907127"}, {"status": "PUBLISHED", "id": "26159986960356607"}, {"status": "PUBLISHED", "id": "897742812757575"}, {"status": "PUBLISHED", "id": "1575626173437873"}, {"status": "PUBLISHED", "id": "1855863745337132"}, {"status": "PUBLISHED", "id": "1330486948443161"}
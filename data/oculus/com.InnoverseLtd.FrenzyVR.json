UvlTLkq49xPJqLM8zpBk&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAiBP9gOilI-8rZkh5WZ2Jc4e8cLwwRbjrXKE2kUgXMgQ&oe=6A5265D0"}, {"file_name": "Screenshot5.png", "id": "880776882536974", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974655_880776885870307_730458897018616067_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cmGcIsVQt28Q7kNvwEsnmOT&_nc_oc=AdqJYKZOOj1nSnaScHzOiD7qJ9m73f43-_iPYLEamk4SaU5qyXRFUae2fY29EK0sBSU&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBfvtjeOSlTj7DRZLzOXYPmjmikx_apw8aLN_lVZAGrtw&oe=6A5239DE"}, {"file_name": "Screenshot4.png", "id": "272936900942329", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974883_272936904275662_2662082753078920897_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XHUOhRfzcLsQ7kNvwECL254&_nc_oc=AdpAVPuorkSydWAkvr7F-wh2NrLfHFMj_GI9OyEuLJwloyQnb9hN_wOHsBRO-ivww5s&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBnRFzVEogPxZG7E7o6FAodJcBMyPaD4QpQCWW5wIWQzw&oe=6A5267B4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Banner Landscape.png", "id": "518109149255436", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974584_518109152588769_9082015115285105038_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=20mxtHHIa5gQ7kNvwHSM2ef&_nc_oc=AdpQugMzPKoxLygKnDj7CX5ORK1HIiKXagi8jQDvWjJuVHw6zLPsjJQKH5XNJKO1L-Y&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCK-2jj-wI1dKp-m-IPiY_3jShm-jET1ecW7mUDoNtIZA&oe=6A5252DB"}, "display_name": "Frenzy VR", "keywords": [], "long_description": "Frenzy VR is a game full of mayhem and destruction. You are placed inside carefully constructed environments where you can go mad and be free to do what you please in a world without consequences. A VR game where all objects can be a weapon, with the added bonus of having satisfying destruction physics. Ever dreamed of hitting your best friend in the face with a toaster? Probably not, but now I mentioned it I bet 
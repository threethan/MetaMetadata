ZAH8oAH_VUYuiD9t8HC9wu8O4nthrn0u1XkNHd5blkx6ZO7g&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_lfLZ2Bfqv-oynmCnfWsL-ECsZsnjqsgxgEk-o6EQV8g&oe=6A36B650"}, {"file_name": "Screenshot5.png", "id": "880776882536974", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/38974655_880776885870307_730458897018616067_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qL4rpQcICPwQ7kNvwEbIe6k&_nc_oc=AdqOy3k002KN9MeO3HUXjB4uyffnyYzVv5kdao4hRcUfFoDzTKqdiioMxZn_MEoRb78&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-LaQ1xb0AMQf9sjXp6-_D4SjRGAtSF5uOeg9I-FZIAHg&oe=6A36C29E"}, {"file_name": "Screenshot4.png", "id": "272936900942329", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/38974883_272936904275662_2662082753078920897_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zlK87bMSVLYQ7kNvwFMo_Ce&_nc_oc=Adp6FW3rmg9xiquJoRDpMFa0IpA64Cf4qbTWD78NUm-QeE3Wgiy9EcOgVhCdDHKv3ck&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af95HD8LI96OPoJahkUa1z27h1tM8tjUCKTwK2QUEFf5lw&oe=6A36B834"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Banner Landscape.png", "id": "518109149255436", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/38974584_518109152588769_9082015115285105038_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I79e-4arvuEQ7kNvwE-azn-&_nc_oc=AdoIy1rIkdnEYK6v7bXDksJaO0JJkl0HNNClyEOQ1Xkzrz-OXNy6Nqz01yU3Vxhurdc&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_rMgLSiU4rqNNT4qhq9faXkBS5qXgMWQqrb9VmP34-LQ&oe=6A36A35B"}, "display_name": "Frenzy VR", "keywords": [], "long_description": "Frenzy VR is a game full of mayhem and destruction. You are placed inside carefully constructed environments where you can go mad and be free to do what you please in a world without consequences. A VR game where all objects can be a weapon, with the added bonus of having satisfying destruction physics. Ever dreamed of hitting your best friend in the face with a toaster? Probably not, but now I mentioned it I bet you want to try it! Frenzy VR is great for stress relief, anger management, and of course just having a bit of fun!\n\n", "short_description": "A destruction and mayhem sandbox playground"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.innoverse.co.uk/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Innoverse Ltd", "support_website_url": null, "website_url": "https://www.innoverse.co.uk/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2710427532541308"}, {"id": "1990104051447093"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "FIGHTING", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "5205085132844253"}}]}, "scheduled_offers": {"count": 19, "nodes": [{"status": "PUBLISHED", "id": "2179458412907127"}, {"status": "PUBLISHED", "id": "26159986960356607"}, {"status": "PUBLISHED", "id": "897742812757575"}, {"status": "PUBLISHED", "id": "1575626173437873"}, {"status": "PUBLISHED", "id": "1855863745337132"}, {"status": "PUBLISHED", "id": "1330486948443161"}, {"status": "PUBLISHED", "id": "1038019615181507"}, {"status": "PUBLISHED", "id": "684821937386134"}, {"status": "PUBLISHED", "id": "1783147249206106"}, {"status": "PUBLISHED", "id": "916312996615673"}, {"status": "PUBLISHED", "id": "1207921683836226"}, {"status": "CANCELLED", "id": "1248718716284499"}, {"status": "PUBLISHED", "id": "1731907950979121"}, {"status": "PUBLISHED", "id": "1167554307
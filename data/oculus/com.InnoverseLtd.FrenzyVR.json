-aWQE4sDUDV6vi75OX9o&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAmMu1zSl4voWsTlVaLE2IhlsdPArS20Uf31OpkM01ieQ&oe=6A60AE10"}, {"file_name": "Screenshot5.png", "id": "880776882536974", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974655_880776885870307_730458897018616067_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8qHkYQtO09QQ7kNvwGInaNM&_nc_oc=AdrX3nR2Legu0f2_O9gc-SXJQfV0Y74tT373v1NWPrqeX_graBxRgJUmJEyX10OeD3s&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDAczlHKRFTwyuftxWjjtp1hi4oEmpt0ZxPTi2JmJiYUQ&oe=6A60BA5E"}, {"file_name": "Screenshot4.png", "id": "272936900942329", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974883_272936904275662_2662082753078920897_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3SI8EueD_bQQ7kNvwGN2V69&_nc_oc=Ado01DCbtAtKxogddyvBDgVFy9xqrptHiU5lxegpI5UgMBc2DuByP-wBm4CrO1VZOr0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAzPudFwoiqLbkU8vXiHjHgMxHsybRlAf1Fb1Aeip3hzQ&oe=6A60AFF4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Banner Landscape.png", "id": "518109149255436", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974584_518109152588769_9082015115285105038_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RWtsN_44PiUQ7kNvwEb7QaE&_nc_oc=AdqV-1BqZqKjjJkFsjZGXvr7AaRgv6DbIGs5GBecHRQndmkar5IadsEB_v7RzNydZp4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB2bX4dmnLR-aZlBIRoy7Ly3PYvuEzjWABy2GmajWtcgQ&oe=6A60D35B"}, "display_name": "Frenzy VR", "keywords": [], "long_description": "Frenzy VR is a game full of mayhem and destruction. You are placed inside carefully constructed environments where you can go mad and be free to do what you please in a world without consequences. A VR game where all objects can be a weapon, with the added bonus of having satisfying destruction physics. Ever dreamed of hitting your best friend in the face with a toaster? Probably not, but now I mentioned it I bet 
cRw9cVjRA7BTqUA-hgXI&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGqplp5cRtqRbWokWAyLxmH63Z2W6ak06jqNEbnTDZbBA&oe=6A902410"}, {"file_name": "Screenshot5.png", "id": "880776882536974", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38974655_880776885870307_730458897018616067_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uvLOC7vbnzkQ7kNvwH-IXER&_nc_oc=AdqGNvS3Gc67rUwHsiGdorDHXxFY0XGGTmaZveA9YUFo3BW7MbG4TzmLWkcCcxEcbqE&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEhvFqQvgy3epLEp9AigSXNlOQRmDh7gRW7sSeUZ4wegA&oe=6A90305E"}, {"file_name": "Screenshot4.png", "id": "272936900942329", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974883_272936904275662_2662082753078920897_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_IcopYQazEMQ7kNvwHjElFN&_nc_oc=AdpgzKeInmbArXOfphjCVgZKzv5O0RzpaWsva6y5kjD-cevFxk0TaiNiZqNVE-zmLH4&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFZjP2_C4_qQbnlfDKY5VVn47e4CAN35S2DvSkUHTeJ8A&oe=6A9025F4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Banner Landscape.png", "id": "518109149255436", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974584_518109152588769_9082015115285105038_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ft-p5Ats4m8Q7kNvwGlhHu5&_nc_oc=AdqDRDUpDy7RPfdJIHfrVwjbcXWHKyNjxwPFsf1-Cxwag84H2xxk4Fsg6j-KJlYSl58&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHG3JqGnm-7Q7-xWIB6iOOLcA9XxoUG3vdEzA8fu9HtNw&oe=6A90111B"}, "display_name": "Frenzy VR", "keywords": [], "long_description": "Frenzy VR is a game full of mayhem and destruction. You are placed inside carefully constructed environments where you can go mad and be free to do what you please in a world without consequences. A VR game where all objects can be a weapon, with the added bonus of having satisfying destruction physics. Ever dreamed of hitting your best friend in the face with a toaster? Probably not, but now I mentioned it I bet 
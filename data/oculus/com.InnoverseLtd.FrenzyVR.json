kFq2qm-CTAUSX4SqqA39WfI_RN-1k0GUCLFm42DXqCG-RApV1tSebm6D3J8g&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_AfuodcK9WiJ-fKYuOuCD5scFULPtbbAb65fscB5rH-GFZg&oe=699C4074"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Banner Landscape.png", "id": "518109149255436", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974584_518109152588769_9082015115285105038_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nW2RmBHon4QQ7kNvwFpWR4H&_nc_oc=AdmcqvqbQ8Z8Ynxh0LxOp-GNfBcdDm3GRcA5Dce3_MhbRWpKcoLfDQjq6ISmsDvTUEM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AftJjTBsLIe7AKQc0lzpyQFZdEiQ3nHBJW9ONxKhOdR4Yg&oe=699C63DB"}, "display_name": "Frenzy VR", "keywords": [], "long_description": "Frenzy VR is a game full of mayhem and destruction. You are placed inside carefully constructed environments where you can go mad and be free to do what you please in a world without consequences. A VR game where all objects can be a weapon, with the added bonus of having satisfying destruction physics. Ever dreamed of hitting your best friend in the face with a toaster? Probably not, but now I mentioned it I bet you want to try it! Frenzy VR is great for stress relief, anger management, and of course just having a bit of fun!\n\n", "short_description": "A destruction and mayhem sandbox playground"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.innoverse.co.uk/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Innoverse Ltd", "support_website_url": null, "website_url": "https://www.innoverse.co.uk/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2710427532541308"}, {"id": "1990104051447093"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "FIGHTING", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area
dn.com&_nc_ss=7f20f&oh=00_AQKB6hnMRzzcsxRV9BlHJC67rzMvbeY5DLweVFna0kiA0w&oe=6AABF397"}, {"file_name": "Screenshot3.png", "id": "359778832413523", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982608_359778835746856_211841733235979620_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fhRJlPf2ZuMQ7kNvwEdZuik&_nc_oc=Adop6zdfrljemfuuFAte-5qpej9xfMhuQYiZ_33-DibqpCgt4EAD1k20c0E1eGCKoMM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKdeVeHPcy5rJz6rFJY4uH4CpQ5YG6gMeQIA5Sya-dsQw&oe=6AAC0BD0"}, {"file_name": "Screenshot5.png", "id": "880776882536974", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974655_880776885870307_730458897018616067_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wZoo4PrPTCgQ7kNvwEYZaXd&_nc_oc=AdpAHdw3LRi6k4yvFaBaEWve-g5hWkhCP6228ca-yoUGYLd5cTMCX6oMFnB1yEyj01M&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLfXcbSrEi_nncOsxpBdA7_VusqhQIsILCuPFyR2_UyYA&oe=6AABDFDE"}, {"file_name": "Screenshot4.png", "id": "272936900942329", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974883_272936904275662_2662082753078920897_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=coSpw_XeQDYQ7kNvwGMrPl9&_nc_oc=AdpT4kuSOW6RhpHuOd7WM859UsQ7TR8_sHCbrvPCVx6lpqwI_8VHlXFW-PigRZYI_Rg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKYhQMQIOaY-rbhRxapKew9fjQd8DbQO9pfRX_B2LGo-g&oe=6AAC0DB4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Banner Landscape.png", "id": "518109149255436", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974584_518109152588769_9082015115285105038_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZT4T9vY069wQ7kNvwHui_Ng&_nc_oc=AdpsenNNaq9Qvky5JDICqr3VPECpV-WQWt6iM_bgffDEG9UyU2pG-bcNxpXLXSZfJ90&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK8rbh8XIlS52QxsVPPoa-hVwcCZTtEwC6x9OYbx3PnEA&oe=6AABF8DB"}, "display_name": "Frenzy VR", "keywords": [], "long_description": "Frenzy VR is a game full of mayhem and destruction. You are placed inside carefully constructed environments where you can go mad and be free to do what you please in a world without consequences. A VR game where all objects can be a weapon, with the added bonus of having satisfying destruction physics. Ever dreamed of hitting your best friend in the face with a toaster? Probably not, but now I mentioned it I bet you want to try it! Frenzy VR is great for stress relief, anger management, and of course just having a bit of fun!\n\n", "short_description": "A destruction and mayhem sandbox playground"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.innoverse.co.uk/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Innoverse Ltd", "support_website_url": null, "website_url": "https://www.innoverse.co.uk/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2710427532541308"}, {"id": "1990104051447093"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "FIGHTING", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "5205085132844253"}}]}, "scheduled_offers": {"count": 20, "nodes": [{"status": "PUBLISHED", "id": "1600709514833609"}, {"status": "PUBLISHED", "id": "2179458412907127"}, {"status": "PUBLISHED", "id": "26159986960356607"}, {"status": "PUBLISHED", "id": "897742812757575"}, {"status": "PUBLISHED", "id": "1575626173437873"}, {"status": "PUBLISHED", "id": "1855863745337132"}, {"status": "PUBLISHED", "id": "1330486948443161"}
luscdn.com/v/t64.5771-25/39001727_1435267930466865_1521832622986079609_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Cfmeu3nX6JMQ7kNvwEg7PdU&_nc_oc=Adpyu2ibZb1YnJWJsHJaDPREwzN8sAZ26_LKsnpT4xJjiTPGMg2Uk48p674J3lZYltE&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSjkJ-dZZo-2l6u_mTI0p5S78ZfZ9-ICHFx-AENsWhXHg&oe=6AFC88C0"}, {"file_name": "fss2.png", "id": "487757603627320", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75371505_487757606960653_694722185615763208_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KAodRFcmdO0Q7kNvwGYIFaS&_nc_oc=AdpOlad6w96HWVzHmTbjIZQeTm5MsAaQy8WgIcQFMHT0oXrCZUs19V4z6_ZA0aLg7HY&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSwM47AgUHlYByB6XGwc8dcqcBRwURnweU9zvaBONwl7Q&oe=6AFC853C"}, {"file_name": "fss4.png", "id": "1472874233617175", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974518_1472874236950508_7625030607912362245_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dtyVObj0YLMQ7kNvwEbJskv&_nc_oc=Adq7btPu-3dhvtXxXxgI3XLn7swBMUMyE-gTdXGrtbSI0Gp6Gx5BBsS-NPQpt9zKKbs&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS0Lf7_jHHQ4_EOGbwiBMjCRIF3JtrqsD3APV3bXeAU2g&oe=6AFC76A6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "FVR Multiplayer Landscape Cover.png", "id": "1058016647153281", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499312236_1058016650486614_3321378648357181045_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l2RfjPwoCZEQ7kNvwEfM8v4&_nc_oc=AdpLS-1ZXuLe0ius7B7xY_0tiA7iv5IflOJhK9wV0v8Qag4yUmUwgptU7286gN_jXOk&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQJFGEWlxyhe_Jx5I96xcd5cNdinofPYRSk-6h9kxsUuw&oe=6AFC7B4F"}, "display_name": "Frenzy VR", "keywords": ["frenzy", "physics", "shooter", "sandbox", "labs"], "long_description": "#                                                                                                                                                                                                      \n{1066880332875476}\n\n# Multiplayer Update Now Live!                              \nThe most requested feature in Frenzy VR history is finally here. Squad up with friends across sandbox mode or any modded map.\n{1588884729638917}\n\n# Fully Interactive & Destructive Environments. \nNothing is off limits. Tear apart everything in sight and crash out with zero real-world consequences.\n{1254229240162704}\n\n# Ragdolls\nWatch NPCs fly with physics-driven ragdolls that react to every hit, every time.\n{3621268474697014}\n\n# Over 50 Different Weapons at Your Disposal\nFrom melee to firearms, every weapon carries real weight and impact built for pure chaos.\n{940982865718899}\n\n# 10+ Maps, Missions & Endless Mods\nUnique maps, scenarios, and enemies in every level, with community-made mods adding even more ways to play.\n{1374121444409265}\n\n# Story Mode & Free Play\nTake on the full campaign, or cut loose in free play and make the mayhem your own.\n{2395213497552433}", "short_description": "Frenzy VR is an action sandbox built around destruction, shooting, ragdolls, and mayhem. Did we mention there are a ton of weapons? Melee weapons, ranged weapons, modded weapons, realistic weapons, fantastical weapons, or any object you can get your hands on! Dive into a full story campaign with multiple missions, explore free play across 10+ destructible maps, or play community made content. Crash out and cause chaos with zero real-world consequences, solo or in multiplayer gamemodes."}]}, "developer_name": "Innoverse Ltd", "developer_privacy_policy_url": "https://clique.games/privacy", "developer_terms_of_service_url": "https://clique.games/terms", "publisher_name": "Clique Games", "support_website_url": null, "website_url": "https://www.innoverse.co.uk/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "co
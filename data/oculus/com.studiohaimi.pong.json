ygqpIePOmg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSbdJyJqR3kuTB5E1dBfB2U2x2J0NfEhaCfQVHqngOlAw&oe=6B046DB7"}, {"file_name": "pickpong-shot-19-black-hole-1.png", "id": "2002077747120598", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/593784242_2002077753787264_877993162355938176_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tx5PSu4NNXYQ7kNvwHPc9mY&_nc_oc=AdoNIML4zG9NWSetXaU2-Jkqs6h0qlyttY9y_5CMB2dWb_mWygRCaDTmdhZ3dUiMNQQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTlVpPZxQkgrBDVUEHVmn-zP4bN_PFoSxj3O615ECG3cw&oe=6B04674F"}, {"file_name": "pickpong-screenshot-1.png", "id": "1446348131036177", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499628882_1446348134369510_8319179834794611666_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wg3CiAtZ20cQ7kNvwEufYMP&_nc_oc=AdqCqhsVvkNN8VM7j5DbAvGY5VmW2jP0BBeO5qLEx9DgCUnXm_mFms2R14pE3O5kpaI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSSAcvpYQQszK9N4P0C6yODZq888ymIIjlunSdk8_KWBA&oe=6B046C87"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "PickPong cover A-2560x1440.png", "id": "2214349695846014", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499620530_2214349699179347_7900237870410851438_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bZQ0WqVQKvQQ7kNvwFqQYda&_nc_oc=AdpJAUAxKze2PykBz4MEHoE6Uw2Q3mmO8bxp77rEldMQHj61qMCl9TgdRGQC3hPLG0w&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQgRWaznL5ePk3_Xbo-mLvJZ15oN6_oNZIRJf9UuyDJ9A&oe=6B045622"}, "display_name": "PickPong", "keywords": ["pickleball", "paddle", "fitness", "arcade", "brickbreaker"], "long_description": "PickPong: VR pickleball meets brick-breaker.\nGrab a paddle and rally against walls of glowing bricks. Shots go where your swing goes, so dinks, drives, lobs and smashes all hit the way they should. Every hit has 3D spatial sound.\n\nEight ways to break\n\u2022 Chaos: balls split into clones under a shattered moon\n\u2022 Chop Shop: Chopbots duck, dodge and bolt their parts back on\n\u2022 Black Hole: crack a ball of bricks around a turning core\n\u2022 Siege: pieces drop from above, so don\u2019t let the wall fill\n\u2022 Stress Relief: no clock, no lives, just a beach and a wall\n\u2026and more.\n\nPlay your way\nThree difficulties, seated or standing play, and smooth 120 Hz on Meta Quest 3.", "short_description": "Pickleball, meet brick-breaker. Swing a real paddle to smash walls of glowing bricks across eight arcade levels, each in its own hand-built world."}]}, "developer_name": null, "developer_privacy_policy_url": "https://pickpong.pages.dev/privacy", "developer_terms_of_service_url": null, "publisher_name": "Haimi Studios", "support_website_url": null, "website_url": "https://pickpong.pages.dev/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "459781504968480"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ARCADE", "SPORTS"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "30329658359970953"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499626728_1168065136137193_6147306433837572471_n.png?stp=dst-png_s360x360&_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SNvLLYcc7CUQ7kNvwFAs-it&_nc_oc=AdoTZIXVwH5O2cbtNFDyg5MSh-u9_jPuQd35fz6Jvg3mLtxtfVZguOa0
P45vB5fycg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR0UJQ8u-wPbPMDKJ9KJuxt_R5TeutiolNs4T1OqWo4zQ&oe=6B031C37"}, {"file_name": "pickpong-shot-19-black-hole-1.png", "id": "2002077747120598", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/593784242_2002077753787264_877993162355938176_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BgDtaKj7oTYQ7kNvwEtGEjD&_nc_oc=AdoqBUeX4D0jaDW5HOy2qlj6JXFF-_RNV5PbCcJfNIZMQ72c6K1E4aqBIgCC6CTy3-g&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRKkRf_VQWl30Qs7cP-sczes8tYhFhZwv7eOyAHx2Obsg&oe=6B0315CF"}, {"file_name": "pickpong-screenshot-1.png", "id": "1446348131036177", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499628882_1446348134369510_8319179834794611666_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yiwSaBljLIQQ7kNvwEJA8t7&_nc_oc=Adpk2Vz94WOJaS_EhdjhhpXaCmbn9znu7kBPrzes4HH7Y0BwH8veEZaKlkq_O6vvP_Q&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTwVXjbKRGcW3r48pBzt2weF1kYYyPY4LMcvIl8vQLlPQ&oe=6B031B07"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "PickPong cover A-2560x1440.png", "id": "2214349695846014", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499620530_2214349699179347_7900237870410851438_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bZQ0WqVQKvQQ7kNvwHr6X82&_nc_oc=Ado3s58pssNf1J6Y_gXne7vSW32XkQBQYdr_Yo86UhmNxOp-4BLRi_BtM71NgzkRyn0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQK-gFknblnIweQjgKCrNOSAntznuw1J-5Vwx5odRsMVA&oe=6B0304A2"}, "display_name": "PickPong", "keywords": ["pickleball", "paddle", "fitness", "arcade", "brickbreaker"], "long_description": "PickPong: VR pickleball meets brick-breaker.\nGrab a paddle and rally against walls of glowing bricks. Shots go where your swing goes, so dinks, drives, lobs and smashes all hit the way they should. Every hit has 3D spatial sound.\n\nEight ways to break\n\u2022 Chaos: balls split into clones under a shattered moon\n\u2022 Chop Shop: Chopbots duck, dodge and bolt their parts back on\n\u2022 Black Hole: crack a ball of bricks around a turning core\n\u2022 Siege: pieces drop from above, so don\u2019t let the wall fill\n\u2022 Stress Relief: no clock, no lives, just a beach and a wall\n\u2026and more.\n\nPlay your way\nThree difficulties, seated or standing play, and smooth 120 Hz on Meta Quest 3.", "short_description": "Pickleball, meet brick-breaker. Swing a real paddle to smash walls of glowing bricks across eight arcade levels, each in its own hand-built world."}]}, "developer_name": null, "developer_privacy_policy_url": "https://pickpong.pages.dev/privacy", "developer_terms_of_service_url": null, "publisher_name": "Haimi Studios", "support_website_url": null, "website_url": "https://pickpong.pages.dev/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "459781504968480"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ARCADE", "SPORTS"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "30329658359970953"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499626728_1168065136137193_6147306433837572471_n.png?stp=dst-png_s360x360&_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SNvLLYcc7CUQ7kNvwFPppk1&_nc_oc=AdpWapZW_jquAc6Q07toOrCxEL63mNQ6-RVgJN8b9tSjlZJgLw5zehtx
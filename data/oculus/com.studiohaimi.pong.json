=AdnDZnHwYengIVMU61gmOxD2hq81cY_rG7KLsWDnRdNqIfwok6vQqZq_lBiO7E_6YRA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&oh=00_Afs7ANzITQSfKRKkV_CBKWSgl3nhBQLJWjbhz1xT56LX6A&oe=69985AE3"}, {"file_name": "pong_playing_dual_paddle.png", "id": "742994326359394", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974841_742994329692727_99870647304979003_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MNywWHVMnzEQ7kNvwGCpQ2_&_nc_oc=Adk4M-DaBNYuUj_F1jRtGOn6y3T3RSUGPL8-kzotWMa3z2FMujqqvCNHmuFoZxX-YQI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&oh=00_AftZwV6OBLdYS_HPqSBwkWKQbqhwkmnb07oAPZDr6wcg4g&oe=69985BDA"}, {"file_name": "pong_doublepaddle.png", "id": "1240184833067745", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/57572928_1240184836401078_2658798679411300089_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Bm4r-L1V-8MQ7kNvwHerKv6&_nc_oc=AdkKEkSzaA1HyL_rg2VUzQCrDWZW81vSlc47L_bPVufKDbStKXqrpUSdfL8UiwzrgNg&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&oh=00_AftMqUuZEJHnIqKLR4yX2EoiZ1ud_dX-vbCIPqR5rkAvsg&oe=69985D34"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "pong_cover_landscape.png", "id": "933708114135474", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974838_933708117468807_6856193097951590791_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=X0qsggCUDJMQ7kNvwFXB-Jf&_nc_oc=AdlG7muXRzNggdcISaHRSju1Rn-zdu6YidOWdONJ_bCe2A3hGeYsuEkDfF-noh2YtRw&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&oh=00_Afsg2cB2Yxo6zxbNMBkrfW1BqpUL5qDsXVtVK9yPYry4NQ&oe=69984D6F"}, "display_name": "Brick Buster Reimagined", "keywords": [], "long_description": "Unleash the Retro Fun in VR: Brick Buster Reimagined!\nRediscover the classic paddle game with a virtual reality twist! Immerse yourself in an engaging world where nostalgia meets cutting-edge technology. Swing powerful paddles and obliterate bricks in a fully immersive 360-degree environment, offering limitless gameplay possibilities.\nExperience non-stop action with balls featuring built-in assistance, ensuring they return to you every time. Enhance your gameplay with exciting power-ups, such as the pistol and magneto, or create massive blast radiuses by swinging hard at the balls.\nDodge obstacles like mines by leaning, crouching, and avoiding them in real-time. With VR reflecting your every move, you'll need agility and strategy to master Brick Buster Reimagined. Get ready for a thrilling fusion of retro charm and modern technology as this classic game gets an incredible upgrade. Don't just play \u2013 live the ultimate arcade experience!", "short_description": "Brick Buster Reimagined: VR Retro Gaming at its Best!\nExperience classic arcade fun like never before in our immersive VR game! Break bricks with powerful paddles, dodge obstacles, and use game-changing power-ups for non-stop action. Enjoy a fusion of nostalgic charm and cutting-edge technology in a fully interactive 360-degree environment. Don't just play, live the ultimate arcade adventure in VR!\n\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.haimistudios.com/#privacy", "developer_terms_of_service_url": null, "publisher_name": "Haimi Studios", "support_website_url": null, "website_url": "https://www.haimistudios.com/", "category": "GAMES", "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ARCADE", "SPORTS"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8462847220412048"}, "review_messages"
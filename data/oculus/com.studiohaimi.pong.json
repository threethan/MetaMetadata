ntent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSPDGJnwvAV_DOwB83gNFYw6LvRQ2GTGPhirpxZLlKEaA&oe=6AFB1856"}, {"file_name": "pong_magneto.png", "id": "441042917125774", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38974827_441042920459107_6965789285775475705_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WQiF9CLVPtEQ7kNvwFIrd1H&_nc_oc=Adq58bFGWyEHMVVK3DTxQaSiBUX-4kdCBKJsM9W0MeRfYYjOvfZB5P4OL99g-tfSdJ0&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTAiqYtlil9U2cHtcS1jMJSosVcRFKWMSdw5Xz-YgxBfA&oe=6AFB36A3"}, {"file_name": "pong_playing_dual_paddle.png", "id": "742994326359394", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38974841_742994329692727_99870647304979003_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=36lkk_MI5p4Q7kNvwFfJRsZ&_nc_oc=Adq2KMFuD2kX9vp1vANbWDskfA6VBlUgp-YaZnHXzSVx_V9NHrXsA_P1UivWGDFtwU4&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSu-mHMaOZHL6MCaKIKg2f7DPeSbeNeH5B_HgXaW45RiA&oe=6AFB379A"}, {"file_name": "pong_doublepaddle.png", "id": "1240184833067745", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/57572928_1240184836401078_2658798679411300089_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0U4uu84UF9YQ7kNvwHqok8T&_nc_oc=Adrs29SPhJyaQqys_pknmWQkrQ_C4KRBwrZr9OCPJuBLR-4Hq2lHOpVkhXvgdqYfIlE&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRDyF8CEwzN8n03JZqqrQ7XrELn1_jCcXdjXO1pD6ELRA&oe=6AFB38F4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "pong_cover_landscape.png", "id": "933708114135474", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38974838_933708117468807_6856193097951590791_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uLxqL9dx1oIQ7kNvwFFTGcJ&_nc_oc=AdoMdzXOQxPm4WnOp06h3WtOkfmeihS_xBAsy9AM2UhEAlWuZciAB01xTDcgcFO82Ys&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTIKaGrwaqMCwlQxxCCjnI7i0CRh0qLNPBkzTnHJWbAOg&oe=6AFB292F"}, "display_name": "Brick Buster Reimagined", "keywords": [], "long_description": "Unleash the Retro Fun in VR: Brick Buster Reimagined!\nRediscover the classic paddle game with a virtual reality twist! Immerse yourself in an engaging world where nostalgia meets cutting-edge technology. Swing powerful paddles and obliterate bricks in a fully immersive 360-degree environment, offering limitless gameplay possibilities.\nExperience non-stop action with balls featuring built-in assistance, ensuring they return to you every time. Enhance your gameplay with exciting power-ups, such as the pistol and magneto, or create massive blast radiuses by swinging hard at the balls.\nDodge obstacles like mines by leaning, crouching, and avoiding them in real-time. With VR reflecting your every move, you'll need agility and strategy to master Brick Buster Reimagined. Get ready for a thrilling fusion of retro charm and modern technology as this classic game gets an incredible upgrade. Don't just play \u2013 live the ultimate arcade experience!", "short_description": "Brick Buster Reimagined: VR Retro Gaming at its Best!\nExperience classic arcade fun like never before in our immersive VR game! Break bricks with powerful paddles, dodge obstacles, and use game-changing power-ups for non-stop action. Enjoy a fusion of nostalgic charm and cutting-edge technology in a fully interactive 360-degree environment. Don't just play, live the ultimate arcade adventure in VR!\n\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.haimistudios.com/#privacy", "developer_terms_of_service_url": null, "publisher_name": "Haimi Studios", "support_website_url": null, "website_url": "https://www.haimistudios.com/", "category": "GAMES", "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1592192974313489"}], "external_subscri
Lo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSnZ-odkZA30HGzs_YSE7tc9qX3K6cOj6tZ3u6gdgNM9Q&oe=6AFDD637"}, {"file_name": "pickpong-shot-19-black-hole-1.png", "id": "2002077747120598", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/593784242_2002077753787264_877993162355938176_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J7BgZ0p1jbwQ7kNvwE_spfg&_nc_oc=AdrIIdwCZnO3ztD1ZEflm3wG_-2Cc1Fjm-I0wYl1KmeerBNvHGe-eO_peTekvstOua4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQPsE4Ls4g3m2Qtjl19LiIkRibMc0ct8TiKLh9_ooOpQQ&oe=6AFDCFCF"}, {"file_name": "pickpong-screenshot-1.png", "id": "1446348131036177", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499628882_1446348134369510_8319179834794611666_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l0Q7aGSAfW4Q7kNvwG11Xfh&_nc_oc=Adr0Jh8744ff83EPJWaEHhzt0wU0XRAFRdxOnyGJ6HfUEhfrxUHKqAd-RGrzc7X7SgU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRuQfbvmr_BMVIZisD2WI1_6W-tI2GnhBhR3TEPphA7FA&oe=6AFDD507"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "PickPong", "keywords": ["pickleball", "paddle", "fitness", "arcade", "brickbreaker"], "long_description": "PickPong: VR pickleball meets brick-breaker.\nGrab a paddle and rally against walls of glowing bricks. Shots go where your swing goes, so dinks, drives, lobs and smashes all hit the way they should. Every hit has 3D spatial sound.\n\nEight ways to break\n\u2022 Chaos: balls split into clones under a shattered moon\n\u2022 Chop Shop: Chopbots duck, dodge and bolt their parts back on\n\u2022 Black Hole: crack a ball of bricks around a turning core\n\u2022 Siege: pieces drop from above, so don\u2019t let the wall fill\n\u2022 Stress Relief: no clock, no lives, just a beach and a wall\n\u2026and more.\n\nPlay your way\nThree difficulties, seated or standing play, and smooth 120 Hz on Meta Quest 3.", "short_description": "Pickleball, meet brick-breaker. Swing a real paddle to smash walls of glowing bricks across eight arcade levels, each in its own hand-built world."}]}, "developer_name": null, "developer_privacy_policy_url": "https://pickpong.pages.dev/privacy", "developer_terms_of_service_url": null, "publisher_name": "Haimi Studios", "support_website_url": null, "website_url": "https://pickpong.pages.dev/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "459781504968480"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ARCADE", "SPORTS"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "30314745701462219"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499620316_1128684933293682_2289590304311078573_n.png?stp=dst-png_s360x360&_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AuJ3WbDJlBQQ7kNvwEFponb&_nc_oc=AdrKZ8k6KDqC46Snzou8pLhtHYDeECjyju9_Dio-Geg-5l5MN0PdkXrf4nP7HL1-aEc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTkODjlGKVQOgNdn3XEyH-bKRRvHVtQVmcYvslLsnswbQ&oe=6AFDCF3F"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "PickPong", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Sports", "id": "2776542286000603"}, {"topic_name": "Action", "id": "459781504968480"}, {"topic_name": "Arca
lq71O71EiE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSELDgFK0Zo_HQvEqFpVx1rp5XDCqWLQk-kXG5ZlqGeCw&oe=6B01CAB7"}, {"file_name": "pickpong-shot-19-black-hole-1.png", "id": "2002077747120598", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/593784242_2002077753787264_877993162355938176_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BgDtaKj7oTYQ7kNvwHdQmA8&_nc_oc=AdptKNh6dZPtX8KmFcM3RhDL-Ve9XWJxdA1hGzzUGZDRTIcFao_Dh5fov7QPyaeyfrE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSpCZ8I9kTlrvvCv9Whi3BJ7O_0CSV3bkOuuDijZQRC2Q&oe=6B01C44F"}, {"file_name": "pickpong-screenshot-1.png", "id": "1446348131036177", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499628882_1446348134369510_8319179834794611666_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yiwSaBljLIQQ7kNvwE-AuM6&_nc_oc=AdqntRepBKF1ow39Ay4PwjjqXHd6OmwFYX56yNLZZGu4ZClIrgoS33kdb8lf_1_jCX0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQsUSxAoFbfmse9rAxKNukcn7W3-E2BtAdqDNVA7RQpQw&oe=6B01C987"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "PickPong cover A-2560x1440.png", "id": "2214349695846014", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499620530_2214349699179347_7900237870410851438_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bZQ0WqVQKvQQ7kNvwH4Kb74&_nc_oc=AdodXg8cYSPWV53vXS_lV8PUcNtvmJyGvF2gOMEDscjq_oc6Fi9kVgKbWVhZ-ON7HHA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQSbMdO1ZRhYDQIAI9JhkyMDwiUwC6xCs7VFsxx3pdvHA&oe=6B01EB62"}, "display_name": "PickPong", "keywords": ["pickleball", "paddle", "fitness", "arcade", "brickbreaker"], "long_description": "PickPong: VR pickleball meets brick-breaker.\nGrab a paddle and rally against walls of glowing bricks. Shots go where your swing goes, so dinks, drives, lobs and smashes all hit the way they should. Every hit has 3D spatial sound.\n\nEight ways to break\n\u2022 Chaos: balls split into clones under a shattered moon\n\u2022 Chop Shop: Chopbots duck, dodge and bolt their parts back on\n\u2022 Black Hole: crack a ball of bricks around a turning core\n\u2022 Siege: pieces drop from above, so don\u2019t let the wall fill\n\u2022 Stress Relief: no clock, no lives, just a beach and a wall\n\u2026and more.\n\nPlay your way\nThree difficulties, seated or standing play, and smooth 120 Hz on Meta Quest 3.", "short_description": "Pickleball, meet brick-breaker. Swing a real paddle to smash walls of glowing bricks across eight arcade levels, each in its own hand-built world."}]}, "developer_name": null, "developer_privacy_policy_url": "https://pickpong.pages.dev/privacy", "developer_terms_of_service_url": null, "publisher_name": "Haimi Studios", "support_website_url": null, "website_url": "https://pickpong.pages.dev/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "459781504968480"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ARCADE", "SPORTS"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "30329658359970953"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499626728_1168065136137193_6147306433837572471_n.png?stp=dst-png_s360x360&_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SNvLLYcc7CUQ7kNvwG8MYva&_nc_oc=AdqvT9yo1bWsTtuv-GvWK2DAsK6FnwfDaqxh-II0chqHz9o-geYFXUpN
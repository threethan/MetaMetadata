7_441042920459107_6965789285775475705_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x7M6Lw-ZnAcQ7kNvwG8ZiG-&_nc_oc=AdqhnCVLToSebBvFBhaD7e5Gn5fSfu8Q78wCtMlNRIWtFFIb7WIkHfWf7o8IVBu4t7s&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNBO2CdrYPgkqKXDbECXls8Q4otoG85OUZHHS0yj97ayA&oe=6AC64263"}, {"file_name": "pong_playing_dual_paddle.png", "id": "742994326359394", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974841_742994329692727_99870647304979003_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bSGoVRszJlIQ7kNvwEzoVaS&_nc_oc=Adpkt1ZAbQjIBifmJSd_5mKrhSmRIw0WyedlazXJ9MvKJ2XguuKKBO0nqd0PE3UXpnA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP_M5kAI_-J0l3xX1BU5kl6pro07wOKkjg_em07jg93kQ&oe=6AC6435A"}, {"file_name": "pong_doublepaddle.png", "id": "1240184833067745", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/57572928_1240184836401078_2658798679411300089_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pMGwlxyMPn8Q7kNvwH27RAj&_nc_oc=AdrFA8K8pLZXc804Ay9PU3M1KZ7mW_6LOn1OBMQOkCXZgWv19_KH-hz9DJjyBlMAwKk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNDjBRi7_CW3sBtqr2KPs8dcUBdeIrYiVX9qqmosnvbSQ&oe=6AC644B4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "pong_cover_landscape.png", "id": "933708114135474", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974838_933708117468807_6856193097951590791_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C8qw5NBaVhkQ7kNvwEBhZEZ&_nc_oc=AdpIMtvnLlx1GcGQgnk2YQDfiSu3EAYlD1O6vfMYmT6Jf0IPjhSjhj8HaTuq4Qmz5M8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMFyNk1LzJ7t9_rqKPkrQ-i0wSTcJ3wPiDDwDyGQTnnUw&oe=6AC66D2F"}, "display_name": "Brick Buster Reimagined", "keywords": [], "long_description": "Unleash the Retro Fun in VR: Brick Buster Reimagined!\nRediscover the classic paddle game with a virtual reality twist! Immerse yourself in an engaging world where nostalgia meets cutting-edge technology. Swing powerful paddles and obliterate bricks in a fully immersive 360-degree environment, offering limitless gameplay possibilities.\nExperience non-stop action with balls featuring built-in assistance, ensuring they return to you every time. Enhance your gameplay with exciting power-ups, such as the pistol and magneto, or create massive blast radiuses by swinging hard at the balls.\nDodge obstacles like mines by leaning, crouching, and avoiding them in real-time. With VR reflecting your every move, you'll need agility and strategy to master Brick Buster Reimagined. Get ready for a thrilling fusion of retro charm and modern technology as this classic game gets an incredible upgrade. Don't just play \u2013 live the ultimate arcade experience!", "short_description": "Brick Buster Reimagined: VR Retro Gaming at its Best!\nExperience classic arcade fun like never before in our immersive VR game! Break bricks with powerful paddles, dodge obstacles, and use game-changing power-ups for non-stop action. Enjoy a fusion of nostalgic charm and cutting-edge technology in a fully interactive 360-degree environment. Don't just play, live the ultimate arcade adventure in VR!\n\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.haimistudios.com/#privacy", "developer_terms_of_service_url": null, "publisher_name": "Haimi Studios", "support_website_url": null, "website_url": "https://www.haimistudios.com/", "category": "GAMES", "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ARCADE", "SPORTS"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "sup
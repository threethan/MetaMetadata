fLuXVUlncUeQF4Ufn1W4w0hx5UFahusDqRUSBFxci6jnMybg_Ox0qq6lp7CIYIBc&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHeT-rDTRTMdlotL13BXOhaec_D5e6FNGwAVU_D366apA&oe=6A81C324"}, {"file_name": "424de3b3-daf5-4fde-9bb3-3ba535eb08758.png", "id": "625367353356044", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/499312344_625367356689377_7563112419838826281_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H1AFsfJy4DUQ7kNvwGrlNNY&_nc_oc=AdqneqOI75LaMBqrfE5-0R52s6dtyiA0d3hZvT_UOxgZzu2W8K4mrdTSjz7DE0ixNLk&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFny1Cp2ZILVLnl3aMT0EeM5qTS6AR9TNjU5JGZxMUF9Q&oe=6A819684"}, {"file_name": "499300910_1831425341124527_7223003411761842309_n.png", "id": "1252056206600776", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/491823943_1252056209934109_6341143657588704375_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xN-DrQ-srssQ7kNvwH75Co3&_nc_oc=AdoEWyU1Wvddw_LKgwkHDatw8sylHlD1e97uXEv-b_qo1r3z17OEKb29P8eA7C3VGLE&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHStdtg8ZHK2HwCVGclA7PjuFDFf_moTq8iTEo7aaoX6A&oe=6A81982D"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "BattlePix: Bodycam Tactical Shooter", "keywords": ["pixel", "shooter", "action", "tactical", "bodycam"], "long_description": "BattlePix: Bodycam Tactical Shooter is an immersive, high-intensity tactical shooter that throws you straight into the chaos of close-quarters combat. Inspired by the large-scale mayhem of BattleBit, this game combines fast-paced action with calculated strategy, all viewed through a visceral, bodycam-style perspective that puts you right on the front lines.\n\nEngage in skill-based firefights where every corner could hide an enemy, and every decision could mean the difference between survival and defeat. Whether you're storming rooms, clearing buildings, or holding the line in tense arena battles, BattlePix emphasizes teamwork, precision, and quick thinking. With realistic weapon handling, dynamic environments, and relentless AI enemies, you'll need to use every tactical advantage to stay alive.\n\nPerfect your aim, coordinate your movements, and outsmart your opponents in a variety of mission scenarios. From solo ops to intense arena shootouts, BattlePix challenges even the most seasoned shooter fans. If you're a fan of BattleBit\u2019s chaotic energy but crave a more grounded and tactical experience, this is your battlefield.\n\nLock and load\u2014it\u2019s time to prove your skills.", "short_description": "BattlePix: Bodycam Tactical Shooter drops you into an intense, high-stakes combat zone where every shot counts. Inspired by the fast-paced chaos of BattleBit, this tactical shooter puts you in the heart of the action with a gritty bodycam perspective. Engage in adrenaline-fueled firefights, eliminate multiple enemies, and push your reflexes to the limit in the arena. Whether you're breaching doors or locking down objectives, BattlePix challenges your aim, awareness, and survival instincts. "}]}, "developer_name": "MB Game Studio", "developer_privacy_policy_url": "https://mbgamestudio.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "MB Game Studio", "support_website_url": null, "website_url": "https://mbgamestudio.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "644354873106712"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction
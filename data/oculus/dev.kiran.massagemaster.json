3o_E-yQ&oe=6AFDC4A2"}, {"file_name": "screenshot_2_2560x1440.png", "id": "2935943896767127", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/596149727_2935943900100460_8983138502830369430_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AfQMcBco5dcQ7kNvwFcxXgf&_nc_oc=AdrXFkeCRJ0Z4aOq2dzEWL4dYpaxKGtRppClNqkPel98Htpsg4mhtzN6hM2Dfv-i5o4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSvPW52FuW1-FB1IqvZ66x0ufa0x68OBZ2Fq_aqv9WiVA&oe=6AFDCE00"}, {"file_name": "screenshot_3_2560x1440.png", "id": "1121016767280894", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/673645340_1121016770614227_3175561298679434809_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=akNb_Q8zHIkQ7kNvwGLahMw&_nc_oc=AdpLYzTMvK8JV9gx6dC9cFgpAM2q4v-F2UiXB-osD4W9BpzPIRGJ6bURxY-hG5tZ9eA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTJ8jGGXeSJy6TN4j6AayHjt16HxMiyRaKy8NcGZ2ivfg&oe=6AFDC0F7"}, {"file_name": "screenshot_5_2560x1440.png", "id": "1810898820148705", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/604317775_1810898823482038_8685722634184027324_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F6Xdb0x8560Q7kNvwFkO3jr&_nc_oc=AdqvB_EKeweuUnM0r-REaq3v4AOGyZPysvYSQ1CR5zIxANl-iynEB5Mc8GBZuLzjoUk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRunxAP8bE_XYdXOwtOx8pkdNAxy_luog7YT9iEhv2AIg&oe=6AFDC7C9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_cover_2560x1440.png", "id": "2913396319017795", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/604360590_2913396322351128_4866030576111155010_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UBfS84sOSsYQ7kNvwEE6GBg&_nc_oc=AdqYMRI0x9rzpMIhK5R50yGg6C1ojHO71tEOHvtqbw1bGZXjYDRIFiFJC8hQIDD9DYs&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTi2He-GVqxrPsT_nNCRo16-0EGGrYss61ccdr1p6sxNA&oe=6AFDBE44"}, "display_name": "Massage Master", "keywords": ["massage", "Spa", "simulator", "job", "funny"], "long_description": "Welcome to your very own back-alley massage clinic. Your tools: your real hands.\n\nMassage Master is a hand-tracking-only physics comedy. No controllers, no buttons: press your palm into a customer's back and the deeper you push, the harder the pressure. Your hand glows blue when it's too soft, green when it's perfect and red when someone is about to regret booking.\n\nLEARN THE CRAFT\n- Warm up muscles with long glides, then hunt for the hidden knot\n- Work knots with circles, thumbs and knuckles, or hold the pressure\n- Grab arms and legs to stretch them (gently... ideally)\n- Therapist Vision reveals tense muscles glowing under the skin\n\nEVERY CUSTOMER REACTS\nTen personalities, fully voiced. The Tough Guy quietly cries. The Drama Queen screams at a light touch. The Bodybuilder begs for more. Press too hard and they'll rise off the table, then slowly turn and stare at you.\n\nDO SOMETHING RIDICULOUS\nEverything is physical. Stack hot stones on a snoring customer. Boop a nose. Put the massage gun where it absolutely doesn't belong. Pull a leg and slide someone down the table. Answer the phone mid-massage.\n\nBUILD YOUR EMPIRE\nEarn fees and tips, buy the TurboMassage 9000, a giant rolling pin and the Ancient Healing Stick, and grow your back-alley room into an Absolutely Ridiculous Celebrity Spa.\n\nFix backs. Make money. Try not to destroy anybody.\n", "short_description": "Run your own tiny massage clinic, using only your real hands. Press into sore shoulders, find the hidden knots, stretch stiff arms and legs, and try not to make your customers scream. Every customer reacts to everything you do: blissful sighs, wide-eyed stares, snoring, and the occasional \"GOOD LORD!\". Do it properly for big tips, or grab the massage gun and see what happens."}]}, "developer_name": null, "developer_privacy_policy_url": "https://gist.github.com/krngd2/0cae2b2ab508ee8b7e9b886548f1d572", "developer_terms_of_service_url": null, "publisher_name": "Kiran Dot Dev", "support_website_url": null, "website_url": "https://kiran.dev/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1625826775935335"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/673536876_2028531031131716_9046934707901481694_n.png?stp=dst-png_s360x360&_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=glmP7y2z1G0Q7kNvwEQTr38&_nc_oc=Adqa-izj-ZJ6axn-oG11_EaSWtQc4DENAJhrjaVzXGj6V-wA4v5Evy-eC4s-NKHSjZI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRb0Rp84613jocASXNwXJV6yZLvoU0fXKiKfTKw8G0cnw&oe=6AFDBACE"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Massage Master", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Simulation", "id": "331529188132278"}], "release_date": 1790863560, "lastRevision": {"nodes": [{"id": "1625826782602001", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "1625826765935336", "is_first_party": false, "enables_in_app_ads": false, "is_concept": false, "platform": "ANDROID_6DOF"}, "iarc_cert": {"id": "931754196284232"}, "iarc_email": null, 
AdqkAkmOqHJQ0D_gbMqBGlvIHnMY8aIsjDKx18o-Fvu4l30y31NR-QxuRdKJF50pKnM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLD_lriU5-nkwIL_q9lddhd8A4cvKGtj4LIVgjuLW0blw&oe=6AB9277F"}, {"file_name": "491830812_26795922253327627_4599453453632506942_n.png", "id": "1933953653920576", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499618442_1933953657253909_3435525407015223368_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_aLNRC_owIcQ7kNvwGIEz5G&_nc_oc=AdqHF7xdUqLzYGt8qM7oeWKrUtl8D-cyDy8GWlkAgAbW9hduMwS0UiJBh4suB8QMPYQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLeuj3DUgED0UdlWgi4HrSUvDB3v_zwvvQ_UWqU90PCYQ&oe=6AB92088"}, {"file_name": "499618069_938183348697797_2195693348777108856_n.png", "id": "843709918231588", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499618264_843709921564921_7156685029955870712_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4mLcRZ8hEJIQ7kNvwHpWuwb&_nc_oc=AdqDC7gWsmQZ6s-_n28cC20osfVy5QymRfN-PS2n7HgsKPuUP3M-klWR7yPlepsEQVc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI-I1winVhiEqOaQRvq5O7vzFMEPoW_9Z_Zrspg-fGrXg&oe=6AB93D45"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "MarineVerse for Teams", "keywords": ["sailing", "marineverse", "team", "sail", "boat"], "long_description": "Bring sailing to your school, club, event or organisation with MarineVerse for Teams.\n\nMarineVerse for Teams is the team and event edition of MarineVerse Sailing Club, designed for group use in educational, training and public event settings. It makes it easy to introduce people to sailing, run guided sessions, and create memorable shared experiences in VR.\n\nWhether you are a sailing school, yacht club, community organisation, event organiser or training provider, MarineVerse for Teams helps people get on the water faster - no wind, weather or marina required.\n\n# IDEAL FOR GROUPS\n\n* Sailing schools and yacht clubs\n* Schools, colleges and training programs\n* Public events, activations and exhibitions\n* Community organisations and team experiences\n\n# TEACH REAL SAILING CONCEPTS\n\n* Use authentic sailing mechanics in VR\n* Introduce points of sail, sail trim, steering and boat handling\n* Support beginner-friendly learning in a safe, repeatable environment\n\n# CREATE ENGAGING TEAM EXPERIENCES\n\n* Let participants learn, sail and race together\n* Run structured sessions for classes, groups and events\n* Offer a fun, accessible introduction to sailing\n* Great for both first-timers and experienced sailors\n\n# EXPLORE THE MARINEVERSE WORLD\n\n* Sail in 8 locations from Sydney to New York\n* Experience dinghies, yachts, catamarans and more ( Hansa 303, Waszp, Opti )\n* Combine learning, free sailing and racing in one platform\n\nA valid MarineVerse Sailing Pass is required to use MarineVerse for Teams.", "short_description": "A VR sailing solution for schools, clubs and events. Learn, race and connect on the water together."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.marineverse.com/privacy", "developer_terms_of_service_url": "https://www.marineverse.com/terms-of-service", "publisher_name": "MarineVerse", "support_website_url": "https://www.marineverse.com/contact", "website_url": "https://www.marineverse.com/for-teams", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "2776542286000603"}, {"id": "726368587961803"}, {"id": "514087707868786"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "pl", "fr", "es", "de", "he", "ja"], "supported_input_devices": ["GAMEPAD", "HAND_TRACKING", "OCULUS_TOUCH"], "supported_playe
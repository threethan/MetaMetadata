kLX7ImcW6fEQ7kNvwFZ8Iyg&_nc_oc=AdrFbpqaakHJgixVxCKYoObH1r8rRhja3NMAzJ4R6iaQAqKNVffb7giSyTljmH8Hri8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2wmjBo9_ky8dBJQCEgc5oKA_4OOzHYm3HP78DBJx2LOQ&oe=69DBADC8"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "WhipLashVR", "keywords": [], "long_description": "Welcome to WhipLashVR; a horror game using the popular Gorilla Tag Locomotion to traverse around. This game contains Flashing Lights, Jump scares, and Some mild gore. This game is intended to be scary and induce fear. Do NOT play this game if you get scared easily or if you have photosensitive epilepsy. ", "short_description": "This, is WhipLashVR. In this game, you are a vervet (a species of monkey) who wanders around a massive open-world facility. You have been almost killed by something when exploring and now you lost your memory. You are quickly put inside a training room to regain your lost knowledge and to find out what really happened.\nWhipLashVR uses Gorilla Tag Locomotion."}]}, "developer_name": "Macka's Studio", "developer_privacy_policy_url": "https://docs.google.com/document/d/1HYtP4-gvcilZSUXVxiVqU_OFnrmtJzT_vkBOWhSK-88/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Macka", "support_website_url": null, "website_url": "https://docs.google.com/document/d/1HYtP4-gvcilZSUXVxiVqU_OFnrmtJzT_vkBOWhSK-88/edit?usp=sharing", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_mo
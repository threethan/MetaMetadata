nail": null, "display_name": "Flight Simulator: Airplane Pilot", "keywords": ["flightsimulator", "airplanepilot", "airplanegame", "flyingsimulator", "pilotsimulator"], "long_description": "Take control of realistic aircraft and experience the excitement of flying like a real pilot in Flight Simulator: Airplane Pilot. Explore beautiful environments, complete challenging missions, and master every takeoff and landing in an immersive VR flight simulation.\n\nWhether you're a beginner or an experienced aviation fan, you'll enjoy smooth controls, realistic flight physics, and exciting gameplay designed for virtual reality.\n\nFeatures\nFly a variety of realistic airplanes.\nExperience immersive VR cockpit controls.\nComplete exciting flight missions and challenges.\nPractice takeoffs, landings, and navigation.\nExplore detailed airports, cities, mountains, and open skies.\nEnjoy realistic flight physics and dynamic weather.\nImprove your flying skills with intuitive controls.\nPlay in free flight or complete mission-based objectives.\n\nFrom short training flights to challenging cross-country adventures, every mission tests your piloting skills. Learn how to control your aircraft, manage altitude and speed, and perform smooth landings like a professional pilot.\n\nStart your aviation journey today and become the ultimate airplane pilot!", "short_description": "Fly realistic airplanes, complete missions, and become the ultimate airplane pilot."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/zylostudio/privacy-policymeta-quest", "developer_terms_of_service_url": null, "publisher_name": "ZYLO Studio", "support_website_url": null, "website_url": "https://sites.google.com/view/zylostudio/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQ
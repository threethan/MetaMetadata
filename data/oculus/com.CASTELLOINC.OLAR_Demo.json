VoIXwo6d56XaEbA&oe=69F8B087"}, {"file_name": "OLAR_PressKit_ScreenShot_02.png", "id": "1218433396322439", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473393059_1218433399655772_6676755666889811965_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c5tNQMGxL-UQ7kNvwGZd46a&_nc_oc=AdoqGW1djo5xDPWsOD4xWCdrTnG6e9w-PJbWaiZ63eGxXQti1DfvdH_WuDfJCjGh1Wc&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0kWJjOsS1XLQE_NAhuEiekqAd8twBbJLaGqZX0cIYISQ&oe=69F8A298"}, {"file_name": "OLAR_PressKit_ScreenShot_27.png", "id": "944099977591081", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391798_944099980924414_6874446848030355773_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FTQvihjFqAIQ7kNvwEt-96E&_nc_oc=Adrk0KzHKztBrPeOPLRHGsK2LNGpb0Ftsf-gXory6VSPQ7CxCZFi9cQpJaK_m9Kavo0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3pnHXxLLfIXPETLbzqzht97EY9XoFE2-woQ-Qpz1aQWw&oe=69F89E1B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "OLAR_Meta_Landscape_Demo.png", "id": "1177657530437072", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391787_1177657533770405_1583614191154617955_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g-J5c2qnvicQ7kNvwGzu-DC&_nc_oc=AdpSExpI0_Uo2sgTVvyd1AZqlBFe1WKb76r-0dAY3K3ooVlECUOMmjmKCCozV5pnoi8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3wT0gXwyC--REkoXudoZriGuFLrp5gCLNcnBwxUYKL-A&oe=69F892FF"}, "display_name": "Of Lies and Rain Demo", "keywords": [], "long_description": "Hi everyone. this is 'Of Lies and Rain' demo!\n\nThis preview offers you the chance to explore the game\u2019s opening level, should be about an hour of  gameplay. It\u2019s the perfect way in our opinion to get a feel for the experience and decide if it\u2019s worth your money before the full release.\n\nPlease keep in mind that we\u2019re a small, dedicated team of just five people, and this is only our second game ever. Over the past two years, we\u2019ve poured our hearts and souls into crafting this adventure, and we\u2019re aiming for a 2025 launch.\n\nWe\u2019re not locking in an exact release date yet, our goal is to polish every detail as much as we can. Once it\u2019s ready, we\u2019ll announce the official release.\n\nEnjoy the demo, and thanks for joining us on this journey!\"\n\n\n# Of Lies and Rain\n\nOf Lies and Rain is a story-driven first-person shooter built exclusively for VR. Set in a dark, sci-fi, post-apocalyptic world, you\u2019ll fight to reclaim your past and save humanity from the brink of extinction.\n\n# September 7, 2048\n\nThe world you once knew is gone, and so is your memory. An unfamiliar voice urges you to defeat A.D.E., the AI behind the long lasting 20-year war that has driven humanity into hiding beneath the Earth. The surface is now ruled by hostile machines, new lifeforms fighting for their survival.\n", "short_description": "Of Lies and Rain is a story-driven first person adventure built exclusively for VR. With a mix of stealth and fast paced combat you'll be immersed in a post apocalyptic world at the edge of the real and digital realm."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.castelloinc.it/wp-content/uploads/2024/08/Castello-inc-Privacy-Policy.pdf", "developer_terms_of_service_url": null, "publisher_name": "Castello Inc Srl", "support_website_url": null, "website_url": "https://www.castelloinc.it/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "3744040075834813"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["O
026", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/12138792_544420059050024_882150392_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zTSeEH8rNI0Q7kNvwG8SXm-&_nc_oc=AdqVKRDRr2i2ClbuBRaudAwPBk1kfuov9axdrnZwgYo8JJjiNel9Y4KXkVRMI9gnl6w&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMt9Waw1fLl6JeScJIbQvM317VB2LeXQ-lMMUfHst5jCw&oe=6AC5280B"}, {"file_name": "migrated_image.png", "id": "142503690468517", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/12138771_1642311102705194_1485284725_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a7wgQcpxjzIQ7kNvwG5nUc1&_nc_oc=AdqvGG000O1rF4_Wh38DtemLVjCjvVJE1VYfeILR2QAd8ZcXmq6qeuN9PLfzwQAnj1w&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO9xHl_lpf7YkkhcCwIeNS_fuHQoWOvIiZy18DKcTPyOA&oe=6AC4FFE2"}, {"file_name": "migrated_image.png", "id": "2801778173248143", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/12138792_188572198148304_471043821_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aFDSek_QK8sQ7kNvwE9tDnS&_nc_oc=AdrWQ5Dpg1TMy2p1LqaTG2KD2SUCEKszINlvvYz7AgyM1npocW5dNY-x1g66Xr9Ixww&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMXP38p8vVzw7-IOs1HN_8sL2118yeh7EkC4YBee7JO6w&oe=6AC515F2"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "FindingVR", "keywords": [], "long_description": "FindingVR is a first person action/adventure game designed exactly for VR. Imagine that you are no longer a person who control the Hero from a top-down view, you are the Hero himself!\nPlayers could solve puzzles using their intelligence and control skills. The joy of game is based on the adventures as the player explore in the virtual world and the sense of achievements when mission completed. We believe that the intense boss battle will make the player excited.\nYour mission is to find out what happened to this world, and how to save this world. Also, you need to defeat those enemies who stand in front of you, find out the right way in the dungeon, and defeat the final boss of each chapter to move on to the next stage.\nYou can use both touchpad and gamepad to play this exciting, deep ,VR game. This might be the most challenging game you can play by using only touchpad in Gear VR ever.", "short_description": ""}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.time-vr.com/", "developer_terms_of_service_url": "http://www.time-vr.com/", "publisher_name": "TVR", "support_website_url": null, "website_url": "http://www.time-vr.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ADVENTURE", "EXPLORATION", "PUZZLE"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": [], "supported_input_devices": ["TOUCHPAD", "GAMEPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1088220295290384"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "934324746639433"}]}, "baseline_offer": {"id": "934324746639433"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1448265600, "status": "PUBLISHED", "id": "934324746639433"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1147778215239989", "version": "1.1.2"}, "id": "159298537758349", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "971783956201151", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1147778215239989"}, "release_status": "RELEASED"}, "binary_release_channels"
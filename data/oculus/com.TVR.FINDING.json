026", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/12138792_544420059050024_882150392_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u6gEuHX7fz4Q7kNvwGgtPYg&_nc_oc=AdqS9EuPDMzMPCaTf17m5jWp3O0SMg3HznZq9p_UT8dKh6wrz3fA5nxb5JwYbFaX4vs&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3D2aGAl7EQwyRNMHIOv77b2wl8tTpEvAwi_FVhqrKkdw&oe=69D8F34B"}, {"file_name": "migrated_image.png", "id": "142503690468517", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/12138771_1642311102705194_1485284725_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uaK-GWmjaFQQ7kNvwGwF3ii&_nc_oc=AdrlpSV58B5uhaebgeRQKGf0qVugEZmAjG3UUQ8Lnl9bnCq8I-kBLcgldifMM0LqA9s&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0sE80znJGjEZk75ne-VfZNgHNOEmwbEOO-9SFoo2DKtg&oe=69D90362"}, {"file_name": "migrated_image.png", "id": "2801778173248143", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/12138792_188572198148304_471043821_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=opu0ldbVA9wQ7kNvwF-CLnn&_nc_oc=Ado7BqchAR1HWD_KRv-g5pY3-yek_UJK2paz2x7His1X4wPCc2aCDjMSArs2m_hMIP4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3rxo4QwVCphx8q9wsY0g3YSET34CkqcjE9_j65vJFJng&oe=69D8E132"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "FindingVR", "keywords": [], "long_description": "FindingVR is a first person action/adventure game designed exactly for VR. Imagine that you are no longer a person who control the Hero from a top-down view, you are the Hero himself!\nPlayers could solve puzzles using their intelligence and control skills. The joy of game is based on the adventures as the player explore in the virtual world and the sense of achievements when mission completed. We believe that the intense boss battle will make the player excited.\nYour mission is to find out what happened to this world, and how to save this world. Also, you need to defeat those enemies who stand in front of you, find out the right way in the dungeon, and defeat the final boss of each chapter to move on to the next stage.\nYou can use both touchpad and gamepad to play this exciting, deep ,VR game. This might be the most challenging game you can play by using only touchpad in Gear VR ever.", "short_description": ""}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.time-vr.com/", "developer_terms_of_service_url": "http://www.time-vr.com/", "publisher_name": "TVR", "support_website_url": null, "website_url": "http://www.time-vr.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ADVENTURE", "EXPLORATION", "PUZZLE"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": [], "supported_input_devices": ["TOUCHPAD", "GAMEPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1088220295290384"}}]}, "scheduled_offers": {"count": 0, "nodes": []}, "baseline_offer": null, "is_approved": true, "firstOffer": {"nodes": []}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1147778215239989", "version": "1.1.2"}, "id": "159298537758349", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "971783956201151", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1147778215239989"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "159298537758349"}]}, "change_log": "Update to mobile sdk 1.0", "created_date": 1453383390, "id": "
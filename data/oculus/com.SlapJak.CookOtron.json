&_nc_oc=Adk8Qjb5KqWMLGnHjR9h5DE97uLZY67GhQxqAwyUFoC30Zs80xKval71smaa2uY_BjM&_nc_zt=3&_nc_ht=scontent-hkg1-1.oculuscdn.com&oh=00_AfvbaCgyBFsFnv1kf5g7FhpjqH5xBH7Et5RfhyQfbyDwhA&oe=69A1942C"}, {"file_name": "HighresScreenshot00138.png", "id": "861854387994372", "uri": "https://scontent-hkg1-1.oculuscdn.com/v/t64.5771-25/38982564_861854391327705_7627913156293170364_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z417zoANxSoQ7kNvwFrkcIw&_nc_oc=AdkSiLI8-2dxEvamg8ahZCd9-OoK4S5DOzdY3zurO-G-i7JybVUUndbmNE1SycB3A8o&_nc_zt=3&_nc_ht=scontent-hkg1-1.oculuscdn.com&oh=00_AftmlZjvZTeS4T1DhbB2KItThZhYoVzSEUwEvDblPzqMEg&oe=69A17E2C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "All Hail the Cook-o-tron ", "keywords": [], "long_description": "All Hail the Cook-o-tron is a physics based cooking action game built from the ground up just for VR.\n\nFeatures: \n* Arcade Mode with an Online leaderboard\n* Campaign spanning 36 handcrafted levels\n* Defeat 6 bosses with their own unique mechanics\n* Master 7 food prep stations and over 80 dishes\n* Physics-based cooking gameplay enabling assembly of dishes in any way you like\n* Various customer archetypes with their unique quirks\n* Casual and Heroic difficulty\n* Progressive difficulty curve designed not to overwhelm yet provide a solid challenge\n", "short_description": "All Hail the Cook-o-tron is a physics-based VR cooking game. Play as a contender in a competition designed to hone your cooking skills to ultimately please the robotic food critic known as the Cook-o-tron.\n"}]}, "developer_name": "Slapunas and Jakayaki", "developer_privacy_policy_url": "https://cookotron.com/privacypolicy.html", "developer_terms_of_service_url": null, "publisher_name": "Slapunas and Jakayaki", "support_website_url": null, "website_url": "https://cookotron.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics
00115.png", "id": "1076562566142874", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974648_1076562569476207_8864068340333880954_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dZ1hJq2AD5QQ7kNvwE2Wf9U&_nc_oc=AdnV09sOA7EoHfD4ywOcvIsFTLuFpD2y7XSnyaHUf3hyvQrif5RWg7DkZh3KebkXXAo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_Afye2AaoL83Fs1IIQEs00lHIgPdEjUgw26pXMr3Rsk6vDg&oe=69B2B7AC"}, {"file_name": "HighresScreenshot00138.png", "id": "861854387994372", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982564_861854391327705_7627913156293170364_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XjiNAssTz28Q7kNvwF-G-EE&_nc_oc=Adkfnrq7HkFJaBMlJ7bVPE9Gq16ydRrb2HsMlcPUjnL71It2ULCUR7cL_pvVdlKvF2U&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfwFVR8cyN-m-xymbIAh793ymZUG-SjIiW5aa3z0Puj_tQ&oe=69B2A1AC"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "All Hail the Cook-o-tron ", "keywords": [], "long_description": "All Hail the Cook-o-tron is a physics based cooking action game built from the ground up just for VR.\n\nFeatures: \n* Arcade Mode with an Online leaderboard\n* Campaign spanning 36 handcrafted levels\n* Defeat 6 bosses with their own unique mechanics\n* Master 7 food prep stations and over 80 dishes\n* Physics-based cooking gameplay enabling assembly of dishes in any way you like\n* Various customer archetypes with their unique quirks\n* Casual and Heroic difficulty\n* Progressive difficulty curve designed not to overwhelm yet provide a solid challenge\n", "short_description": "All Hail the Cook-o-tron is a physics-based VR cooking game. Play as a contender in a competition designed to hone your cooking skills to ultimately please the robotic food critic known as the Cook-o-tron.\n"}]}, "developer_name": "Slapunas and Jakayaki", "developer_privacy_policy_url": "https://cookotron.com/privacypolicy.html", "developer_terms_of_service_url": null, "publisher_name": "Slapunas and Jakayaki", 
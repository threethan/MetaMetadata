.com&_nc_ss=7f20f&oh=00_AQHD-a9vorlusRYAZLPKL_Qe6fvn22aSDJ24dWZUJ_cL6Q&oe=6A8D965C"}, {"file_name": "HighresScreenshot00115.png", "id": "1076562566142874", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/38974648_1076562569476207_8864068340333880954_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wQeQo6kBS-sQ7kNvwH07Brx&_nc_oc=Adqd4pS2LfLq3NKfZf6hC2V4xZWnZE48jmqlm6QIRiZvnKOgdpQLFrwJviyPfYd_Z-E&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFsvG54fdVkZ-F-nbuXYIuAD-Gd9_wf-Fu6DRK1mwoyRQ&oe=6A8D90AC"}, {"file_name": "HighresScreenshot00138.png", "id": "861854387994372", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/38982564_861854391327705_7627913156293170364_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fGSZDj4pgfkQ7kNvwHpcTjp&_nc_oc=AdoeFDCJSTR21DgmdPgXrqLhhEPW1w0kEl3vr1l_r5cjLldyCKyEApAD-tC_c_d8_hg&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFrbUpBvDeovKzhmthaazFtTniR_xqB3hnFb6k-AKKNlA&oe=6A8D7AAC"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "All Hail the Cook-o-tron ", "keywords": [], "long_description": "All Hail the Cook-o-tron is a physics based cooking action game built from the ground up just for VR.\n\nFeatures: \n* Arcade Mode with an Online leaderboard\n* Campaign spanning 36 handcrafted levels\n* Defeat 6 bosses with their own unique mechanics\n* Master 7 food prep stations and over 80 dishes\n* Physics-based cooking gameplay enabling assembly of dishes in any way you like\n* Various customer archetypes with their unique quirks\n* Casual and Heroic difficulty\n* Progressive difficulty curve designed not to overwhelm yet provide a solid challenge\n", "short_description": "All Hail the Cook-o-tron is a physics-based VR cooking game. Play as a contender in a competition designed to hone your cooking skills to ultimately please the robotic food critic known as the Cook-o-tron.\n"}]}, "developer_name": "Slapunas and Jakayaki", "developer_privacy_policy_url": "
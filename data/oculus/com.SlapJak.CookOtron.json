p6UNQV3H2YFiLhPnIqliororO8IUnAQPP7G9kJrFgRtUa5yZEQ8jky0bo_w2ip42Q&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQT6mAJ65-wWSau_Df56NT1KRbe9Qy2gkP5bAgZPVfRcNw&oe=6B0C6383"}, "display_name": "All Hail the Cook-o-tron", "keywords": ["cook", "cooking", "food", "cookotron", "simulator"], "long_description": "All Hail the Cook-o-tron is a physics based cooking action game built from the ground up just for VR.\n\nFeatures: \n* Arcade Mode with an Online leaderboard\n* Campaign spanning 36 handcrafted levels\n* Defeat 6 bosses with their own unique mechanics\n* Master 7 food prep stations and over 80 dishes\n* Physics-based cooking gameplay enabling assembly of dishes in any way you like\n* Various customer archetypes with their unique quirks\n* Casual and Heroic difficulty\n* Progressive difficulty curve designed not to overwhelm yet provide a solid challenge\n", "short_description": "All Hail the Cook-o-tron is a physics-based VR cooking game. Play as a contender in a competition designed to hone your cooking skills to ultimately please the robotic food critic known as the Cook-o-tron.\n"}]}, "developer_name": "Slapunas and Jakayaki", "developer_privacy_policy_url": "https://gist.githubusercontent.com/jakayaki/d7b5a5066ae3fcf773ff79cea7cfd986/raw/f5c2f91e2aa7683b010564c1a0629b445f8b6abd/gistfile1.txt", "developer_terms_of_service_url": null, "publisher_name": "Slapunas and Jakayaki", "support_website_url": null, "website_url": "https://cookotron.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE", "FOOD", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": n
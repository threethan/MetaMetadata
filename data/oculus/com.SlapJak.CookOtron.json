_name": "HighresScreenshot00143.png", "id": "736791470536589", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/38974593_736791473869922_1568944848504155469_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RBpr7A64i0wQ7kNvwFG1OQf&_nc_oc=Ado1_SG9eMw7zhTq9bwRHflhgiLU4TJT3MfCV0D6cVE8EcWnWN7AEQWT6_0XhtGws2w&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLKcpswiTryx4XZmMDP-bRpWsN7xyu4572xTI2gs_64pA&oe=6AA945DC"}, {"file_name": "HighresScreenshot00115.png", "id": "1076562566142874", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/38974648_1076562569476207_8864068340333880954_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cQd0dFooSX0Q7kNvwEn6nCd&_nc_oc=AdpxrFVhN8pkwPC26Ba727mVQXuLZwH-rBK-wtBQ-MTeJpvxTKXiVsXQO2FNKayU0eY&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJmgkm7f09bYYjW_VomuuL5i4jJ7UJ-_8eRGK7J6BE5kQ&oe=6AA9402C"}, {"file_name": "HighresScreenshot00138.png", "id": "861854387994372", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/38982564_861854391327705_7627913156293170364_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dtHMlZyr-egQ7kNvwFgjRGp&_nc_oc=Adr8BXBBOK-VmOUwrmnO0uTCwlgy8xKx0giKoUk-j2_7fS7coZHYMVRhnnm3kqAA4JM&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLAPqrMEbv8OkK7dzAW_uqXya4GYeZFQRH0jmE3vXOOPw&oe=6AA9626C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "AllHailTheCookotron_CoverArt_Landscapev1.png", "id": "730047544354415", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/38974914_730047547687748_8557040659628875130_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZwToNfc9QtMQ7kNvwEQktMR&_nc_oc=AdqR0dPNH3gqxoijGewQSQh9NBeoiwipCMS01NOFSzs9dyvXgfOpnuFJoDPcUGEObdA&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJkxtZ2guDko2AA6SYd1cf4RvvMZsKIJqL7_rVEtzEA-Q&oe=6AA94AC3"}, "display_name": "All Hail the Cook-o-tron", "keywords": ["cook", "cooking", "food", "cookotron", "simulator"], "long_description": "All Hail the Cook-o-tron is a physics based cooking action game built from the ground up just for VR.\n\nFeatures: \n* Arcade Mode with an Online leaderboard\n* Campaign spanning 36 handcrafted levels\n* Defeat 6 bosses with their own unique mechanics\n* Master 7 food prep stations and over 80 dishes\n* Physics-based cooking gameplay enabling assembly of dishes in any way you like\n* Various customer archetypes with their unique quirks\n* Casual and Heroic difficulty\n* Progressive difficulty curve designed not to overwhelm yet provide a solid challenge\n", "short_description": "All Hail the Cook-o-tron is a physics-based VR cooking game. Play as a contender in a competition designed to hone your cooking skills to ultimately please the robotic food critic known as the Cook-o-tron.\n"}]}, "developer_name": "Slapunas and Jakayaki", "developer_privacy_policy_url": "https://gist.githubusercontent.com/jakayaki/d7b5a5066ae3fcf773ff79cea7cfd986/raw/f5c2f91e2aa7683b010564c1a0629b445f8b6abd/gistfile1.txt", "developer_terms_of_service_url": null, "publisher_name": "Slapunas and Jakayaki", "support_website_url": null, "website_url": "https://cookotron.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE", "FOOD", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8158332547549249"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent
&_nc_oc=AdlJdTa-czZrdephxmhxV1ygZWhiiq0dRIv0fqjQeZwy_Qg8GqF-5bw2SxfvfY1GcgM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Aft2y3U81MLyKeO2RDRlPJYba-ZUh22yj1MnyXmIsK-KDw&oe=6999AB2C"}, {"file_name": "HighresScreenshot00138.png", "id": "861854387994372", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982564_861854391327705_7627913156293170364_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FxJO0dA2CvoQ7kNvwFkcksn&_nc_oc=Adke1tc9h6QZQNL6tSWZa41fweYTGdi8uRZIFiWe6EGUQgGbL4q_kkiCJYeNA1t_XtQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfsTQ7zAZe_qaIqzQHchYrNmzeyGFpzO8cOk1NkM1wfGlA&oe=6999952C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "All Hail the Cook-o-tron ", "keywords": [], "long_description": "All Hail the Cook-o-tron is a physics based cooking action game built from the ground up just for VR.\n\nFeatures: \n* Arcade Mode with an Online leaderboard\n* Campaign spanning 36 handcrafted levels\n* Defeat 6 bosses with their own unique mechanics\n* Master 7 food prep stations and over 80 dishes\n* Physics-based cooking gameplay enabling assembly of dishes in any way you like\n* Various customer archetypes with their unique quirks\n* Casual and Heroic difficulty\n* Progressive difficulty curve designed not to overwhelm yet provide a solid challenge\n", "short_description": "All Hail the Cook-o-tron is a physics-based VR cooking game. Play as a contender in a competition designed to hone your cooking skills to ultimately please the robotic food critic known as the Cook-o-tron.\n"}]}, "developer_name": "Slapunas and Jakayaki", "developer_privacy_policy_url": "https://cookotron.com/privacypolicy.html", "developer_terms_of_service_url": null, "publisher_name": "Slapunas and Jakayaki", "support_website_url": null, "website_url": "https://cookotron.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics
&_nc_oc=AdoHPrX_qxnamPVqzF6asKBAV8oGenrLQkfglMmkZSk_MdPBPkew7Um0sgof5p_aums&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Af1t2aMNo7FKLuNFVFa7GTC_IxqOekTiGCsxsOwOmDM7PQ&oe=69F0AE2C"}, {"file_name": "HighresScreenshot00138.png", "id": "861854387994372", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982564_861854391327705_7627913156293170364_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WzRMkmMBeMMQ7kNvwEr9qTJ&_nc_oc=Ado_FtJIpHa61ApGwzykQ6L_1qCXLxJruq-MWyKbDbgb0zMhtHpUySRG-hFM4ZrKb2Y&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af0WXlcFKVNwDZxBYBKI1iZVupMa7jOpgDIAUZ35gWKwZw&oe=69F0D06C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "All Hail the Cook-o-tron ", "keywords": [], "long_description": "All Hail the Cook-o-tron is a physics based cooking action game built from the ground up just for VR.\n\nFeatures: \n* Arcade Mode with an Online leaderboard\n* Campaign spanning 36 handcrafted levels\n* Defeat 6 bosses with their own unique mechanics\n* Master 7 food prep stations and over 80 dishes\n* Physics-based cooking gameplay enabling assembly of dishes in any way you like\n* Various customer archetypes with their unique quirks\n* Casual and Heroic difficulty\n* Progressive difficulty curve designed not to overwhelm yet provide a solid challenge\n", "short_description": "All Hail the Cook-o-tron is a physics-based VR cooking game. Play as a contender in a competition designed to hone your cooking skills to ultimately please the robotic food critic known as the Cook-o-tron.\n"}]}, "developer_name": "Slapunas and Jakayaki", "developer_privacy_policy_url": "https://cookotron.com/privacypolicy.html", "developer_terms_of_service_url": null, "publisher_name": "Slapunas and Jakayaki", "support_website_url": null, "website_url": "https://cookotron.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics
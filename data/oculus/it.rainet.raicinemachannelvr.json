culuscdn.com/v/t64.5771-25/39031588_2139877619645348_2213468424569356288_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mF_xowbZdxgQ7kNvwGQMdQg&_nc_oc=AdoDTEkHeXhsSfoXWiei4ORZxPrLOPcSQjasYtKu8W8z6J4HuYRlYTHslWAaC8HLro8&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6UxCNFh2LmvlV32MQEcqYwPMWmMh--3mrA-ca8pMH1Ww&oe=6A09C920"}, {"file_name": "migrated_image.png", "id": "204628907527478", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/38974785_355434438452645_1955443329344733184_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FjIF8oK9aQcQ7kNvwFiJRd_&_nc_oc=AdoCC_28ZjE99e7zRy3T4-TNLf4zOqWJy8duCjDz8J2Ywpl4DNjHB8zgmBZP9BRtCHQ&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af671zBLx8AhqBQ56TazZSDJ83oKWomB9Fx341ah4aKIIw&oe=6A09D5A7"}, {"file_name": "migrated_image.png", "id": "512751179668860", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/38974651_2160030517630735_2823149645100744704_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Be91zBbqs3EQ7kNvwEWzufs&_nc_oc=AdrB1MtUHehe5vbOx90ARt2j_15hu0ZXmDwDm5Q8_YQRzOdv8yscEUNzHC8jRx-ijgM&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5DuHopwXEkwop4fNNaJz90pi1knuZgcnHq8qkpgXEniQ&oe=6A09D6A9"}, {"file_name": "migrated_image.png", "id": "218446816035223", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/38974445_368286943891195_8262301490090082304_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JItrXw97fsoQ7kNvwHWkQs0&_nc_oc=AdpeBZSJFAyh2Rd9GEok3G7HQZqgwSgyKYuAgbAcwI7GeINCN4tqpCMxNU6NXhI7G7o&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6xRLEAgrOnFoMzlYyH1kOgIyaHzh3cj0PYnc5-zmoFbQ&oe=6A09D61A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Rai Cinema Channel VR", "keywords": ["cinema", "virtualreality", "vr", "cortometraggi", "film"], "long_description": "Rai \u00e8 la prima media company a lanciare un\u2019APP VR tutta italiana per offrire ai propri utenti una vasta gamma di contenuti originali in realt\u00e0 virtuale.\nCon l\u2019app potrai fruire contenuti esclusivi sia VR 360\u00b0 sia lineari, potrai vivere un\u2019esperienza completamente immersiva nella \u201cvirtual room\u201d di Rai Cinema e scegliere se essere al fianco delle star sui red carpet dei festival di cinema, assistere a speciali interviste o se essere catapultati in cortometraggi VR.\nUna volta scaricata, lanciata la APP ed indossato il visore, potrai attivare i contenuti con lo sguardo o con il controller del vostro dispositivo.\nSelezionando le immagini o i men\u00f9 si avr\u00e0 accesso a tutti i contenuti: i video tradizionali saranno proiettati sul grande schermo del salotto mentre i video immersivi a 360\u00b0 appariranno intorno all'utente sostituendosi all\u2019ambiente virtuale.", "short_description": "Rai Cinema Channel VR, la prima App VR targata Rai"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.rai.it/privacy/PrivacyPolicy.html", "developer_terms_of_service_url": "https://www.rai.it/privacy/PrivacyPolicy.html", "publisher_name": "RAI Radiotelevisione Italiana S.p.A.", "support_website_url": "https://www.rai.it/raicinema/", "website_url": "https://www.rai.it/raicinema/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["MEDIA_PLAYER", "MOVIE", "MUSIC_VIDEO"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "it"], "supported_input_devices": ["GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "342721964388937"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/39001697_386605208728015_9089021499876048896
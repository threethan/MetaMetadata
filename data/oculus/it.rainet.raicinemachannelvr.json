culuscdn.com/v/t64.5771-25/39031588_2139877619645348_2213468424569356288_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RMd81BnhLu4Q7kNvwHG4_2n&_nc_oc=Adpa0eZFIiuLSMk0LhOKorZVeAWWnRa4Yf1n2joY0mCoajp4sUIgxHzyiDmpoEYyfJE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJDYVcKZbFiuaO786q7SVmCm0aELxXoDm7KOR2ibwvT4A&oe=6AB920A0"}, {"file_name": "migrated_image.png", "id": "204628907527478", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974785_355434438452645_1955443329344733184_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iNcDzVvRurMQ7kNvwEoRP_9&_nc_oc=AdpUiWdOuULzlA84IO3eOTXY7XGaRlRMT6LSskmW-Pr3mMIhBSyHm_751CsjtpathPU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIBXAowuKhBBBTZBPREYyUxY1vaQlLEJCXT0XP8PQiVNQ&oe=6AB92D27"}, {"file_name": "migrated_image.png", "id": "512751179668860", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974651_2160030517630735_2823149645100744704_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XiEZ-r9ySCYQ7kNvwF3iqaA&_nc_oc=AdrnrfLru1LSp9mc3S0ASg735sZyUrV9fxjQUfBK_KmiN6LJN6MF7FPmAfKGzanj4u4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKMW9Jroagi0oEd6t3_6tysxse8Ock1NqvYC6BrFTkXpQ&oe=6AB92E29"}, {"file_name": "migrated_image.png", "id": "218446816035223", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974445_368286943891195_8262301490090082304_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3HIUvSqAPAcQ7kNvwEXgLMx&_nc_oc=AdoQfk-ItauZhuP-nmiBldZGIMokDU_Crp1XcfSVJKs6l_dYYnWPK2GCXYZ_QlnI-2A&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL2B-eN1myO7qDhas4BQCx9LSK4cqfLHIsW6yUN9wcfcA&oe=6AB92D9A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Rai Cinema Channel VR", "keywords": ["cinema", "virtualreality", "vr", "cortometraggi", "film"], "long_description": "Rai \u00e8 la prima media company a lanciare un\u2019APP VR tutta italiana per offrire ai propri utenti una vasta gamma di contenuti originali in realt\u00e0 virtuale.\nCon l\u2019app potrai fruire contenuti esclusivi sia VR 360\u00b0 sia lineari, potrai vivere un\u2019esperienza completamente immersiva nella \u201cvirtual room\u201d di Rai Cinema e scegliere se essere al fianco delle star sui red carpet dei festival di cinema, assistere a speciali interviste o se essere catapultati in cortometraggi VR.\nUna volta scaricata, lanciata la APP ed indossato il visore, potrai attivare i contenuti con lo sguardo o con il controller del vostro dispositivo.\nSelezionando le immagini o i men\u00f9 si avr\u00e0 accesso a tutti i contenuti: i video tradizionali saranno proiettati sul grande schermo del salotto mentre i video immersivi a 360\u00b0 appariranno intorno all'utente sostituendosi all\u2019ambiente virtuale.", "short_description": "Rai Cinema Channel VR, la prima App VR targata Rai"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.rai.it/privacy/PrivacyPolicy.html", "developer_terms_of_service_url": "https://www.rai.it/privacy/PrivacyPolicy.html", "publisher_name": "RAI Radiotelevisione Italiana S.p.A.", "support_website_url": "https://www.rai.it/raicinema/", "website_url": "https://www.rai.it/raicinema/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["MEDIA_PLAYER", "MOVIE", "MUSIC_VIDEO"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "it"], "supported_input_devices": ["GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "342721964388937"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39001697_386605208728015_9089021499876048896
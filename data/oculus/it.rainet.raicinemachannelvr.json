culuscdn.com/v/t64.5771-25/39031588_2139877619645348_2213468424569356288_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c9tQTNMCdGcQ7kNvwEP50Ac&_nc_oc=AdrK1X6bNz8PapyhM6aVdHtn4iR10Tb7vrxXK1SeyISlEPrnXg7_KFQYvVHclgS_JI4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afx4ThxZNq49AiL1N7SbhbQjnNz7ANvFmw9RVDzjRk-qYQ&oe=69D118A0"}, {"file_name": "migrated_image.png", "id": "204628907527478", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974785_355434438452645_1955443329344733184_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N5mOO-m3ebcQ7kNvwELXrTw&_nc_oc=AdprQJRp0VoHFHm72g7F9RcFm3jakDNvbAF8WQaNjtxjHhAKqKwfa8t5gNooDotuoE8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afzxr35OUhJMQlO794BwE72UV7kZ8vXXSUjuO9gz5TkZUg&oe=69D12527"}, {"file_name": "migrated_image.png", "id": "512751179668860", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974651_2160030517630735_2823149645100744704_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=auuR1Ul9u-oQ7kNvwGXnhFP&_nc_oc=AdqshzaKBvZLdc68kDMBnYQvJWqAC-5RpUMXapZWbCyQZOxnPvOY_I67OZSKID26mGQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyDSEHr4yD9Oc8voAyAZsvD5hmENF-EXTm1yka9D0q54w&oe=69D12629"}, {"file_name": "migrated_image.png", "id": "218446816035223", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974445_368286943891195_8262301490090082304_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qtoSsI0ayM4Q7kNvwH0AEbR&_nc_oc=AdrTekbgx5nxeITOhD-UCFM4ntDpeeq-u99vp2V5Tf5SmtUOwEMPyyzrBFNqmiIwtII&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afz4PQEboOblibcE4uWo9_xnXa9clhX3Ket26FlCcUTshg&oe=69D1259A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Rai Cinema Channel VR", "keywords": ["cinema", "virtualreality", "vr", "cortometraggi", "film"], "long_description": "Rai \u00e8 la prima media company a lanciare un\u2019APP VR tutta italiana per offrire ai propri utenti una vasta gamma di contenuti originali in realt\u00e0 virtuale.\nCon l\u2019app potrai fruire contenuti esclusivi sia VR 360\u00b0 sia lineari, potrai vivere un\u2019esperienza completamente immersiva nella \u201cvirtual room\u201d di Rai Cinema e scegliere se essere al fianco delle star sui red carpet dei festival di cinema, assistere a speciali interviste o se essere catapultati in cortometraggi VR.\nUna volta scaricata, lanciata la APP ed indossato il visore, potrai attivare i contenuti con lo sguardo o con il controller del vostro dispositivo.\nSelezionando le immagini o i men\u00f9 si avr\u00e0 accesso a tutti i contenuti: i video tradizionali saranno proiettati sul grande schermo del salotto mentre i video immersivi a 360\u00b0 appariranno intorno all'utente sostituendosi all\u2019ambiente virtuale.", "short_description": "Rai Cinema Channel VR, la prima App VR targata Rai"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.rai.it/privacy/PrivacyPolicy.html", "developer_terms_of_service_url": "https://www.rai.it/privacy/PrivacyPolicy.html", "publisher_name": "RAI Radiotelevisione Italiana S.p.A.", "support_website_url": "https://www.rai.it/raicinema/", "website_url": "https://www.rai.it/raicinema/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["MEDIA_PLAYER", "MOVIE", "MUSIC_VIDEO"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "it"], "supported_input_devices": ["GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "342721964388937"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39001697_386605208728015_9089021499876048896
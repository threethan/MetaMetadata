culuscdn.com/v/t64.5771-25/39031588_2139877619645348_2213468424569356288_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yoAiBytw-2QQ7kNvwFmHUCx&_nc_oc=AdpF9pkPi96OEdqOnpRl_kO1n-A6bsXo6S6BDGuU_n48rXP60m0o0cEp4g10Gpl2MPU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLDrA6oux7kSU7Lth91MFTgtYpjX6eanf46WFkVu0igxw&oe=6A9C1FA0"}, {"file_name": "migrated_image.png", "id": "204628907527478", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974785_355434438452645_1955443329344733184_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FUsboMYfZHEQ7kNvwG6f0GR&_nc_oc=AdqvJ1gKRIykm6q30xoxRV8xgUQHJgevGDIwcSMhQlSre-tnHZF6M2bCryzlZfSWtgE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJLjD3BX-8TdHv4aRyA5IrmVAa4BBvhP42SCheqIl27Zg&oe=6A9C2C27"}, {"file_name": "migrated_image.png", "id": "512751179668860", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974651_2160030517630735_2823149645100744704_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rk-GjfHheNkQ7kNvwFaP-os&_nc_oc=Adp5y1bZfUxkt--lyhPYqmza5o4y0Vh9FOXezputzivp4pqk6dKiM_aLgBlDsclGOM4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJCp6jCD08OpNt9eA8n1m6IVI3FhqqYlwaJCoBEqEJI_w&oe=6A9C2D29"}, {"file_name": "migrated_image.png", "id": "218446816035223", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974445_368286943891195_8262301490090082304_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KFKOULEYiUcQ7kNvwHXJuUa&_nc_oc=AdoBC_VBgWBMSejcKCgOEveTYAFSLFPu_Em_aREz5CpwrhBeWKprhhHqt5zKdX0xiW4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIAXQ9K1qr3un78KvB3o7kR5jHiL6YH9Vzo7kIMLNIk8w&oe=6A9C2C9A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Rai Cinema Channel VR", "keywords": ["cinema", "virtualreality", "vr", "cortometraggi", "film"], "long_description": "Rai \u00e8 la prima media company a lanciare un\u2019APP VR tutta italiana per offrire ai propri utenti una vasta gamma di contenuti originali in realt\u00e0 virtuale.\nCon l\u2019app potrai fruire contenuti esclusivi sia VR 360\u00b0 sia lineari, potrai vivere un\u2019esperienza completamente immersiva nella \u201cvirtual room\u201d di Rai Cinema e scegliere se essere al fianco delle star sui red carpet dei festival di cinema, assistere a speciali interviste o se essere catapultati in cortometraggi VR.\nUna volta scaricata, lanciata la APP ed indossato il visore, potrai attivare i contenuti con lo sguardo o con il controller del vostro dispositivo.\nSelezionando le immagini o i men\u00f9 si avr\u00e0 accesso a tutti i contenuti: i video tradizionali saranno proiettati sul grande schermo del salotto mentre i video immersivi a 360\u00b0 appariranno intorno all'utente sostituendosi all\u2019ambiente virtuale.", "short_description": "Rai Cinema Channel VR, la prima App VR targata Rai"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.rai.it/privacy/PrivacyPolicy.html", "developer_terms_of_service_url": "https://www.rai.it/privacy/PrivacyPolicy.html", "publisher_name": "RAI Radiotelevisione Italiana S.p.A.", "support_website_url": "https://www.rai.it/raicinema/", "website_url": "https://www.rai.it/raicinema/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["MEDIA_PLAYER", "MOVIE", "MUSIC_VIDEO"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "it"], "supported_input_devices": ["GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "342721964388937"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39001697_386605208728015_9089021499876048896
dn.com/v/t64.5771-25/38982695_481013318319830_5804856370443829815_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r90YKQRDkZEQ7kNvwE4QOOS&_nc_oc=Ado5-2taBsOf-ndR7hcCE5gJ-FC5t9QVwUP6WbrAFVCpxZqS_WP-jMaTwVZciffi81s&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA8moVRbkalL1E5CBoS5vsB_GkAOBaBPZhrvhFuVMJdig&oe=6A5F6E3E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u82f1\u6587\u5c01\u9762.png", "id": "547566118229054", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974866_547566121562387_4798772193684726159_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BE8eY_nzOWEQ7kNvwGgOVrQ&_nc_oc=Adpa42tsMM0GIVWebDJqJoHDyiUFbMQT0YhEO9bU6wiz0kqMuv_E-ta19I5lmRZwCdU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBppuIJ-4qHt0InVhYD5BybXbri_iiUc6Hy_FckruWk2g&oe=6A5F6814"}, "display_name": "Fantasy Puzzle", "keywords": [], "long_description": "Start your fantasy journey with this magical jigsaw puzzle game.\nProfessional 3D modeling, Soothing alpha brainwave music helps you relax your brain and improve attentionprecise, Wonderful movements allow you to immerse yourself in the game.\n\nThe game has 25, 50, 100, 600, and other challenging gameplay modes waiting for you to experience!\n\nThis edition contains a picture of the river during the Mona Lisa, van gogh Starry Night\uff0cQingming Dynasty, lotus flowers, a pottery figurine from the Tang Dynasty, and a magnolia vase.\n\nWe will update DLC periodically, please stay tuned.\n\nIf you have any questions or suggestions, you can communicate here:\nhttps://discord.gg/fTmFqqFS\n\ufeff", "short_description": "This is a fantasy dynamic jigsaw puzzle\nStart your fantasy journey with this magical jigsaw puzzle game."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/fantasy-puzzle-space-privacy-p/home", "developer_terms_of_service_url": null, "publisher_name": "Game Oasis", "support_website_url": null, "website_url": "https://
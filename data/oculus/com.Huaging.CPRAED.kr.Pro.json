cb=1-7&_nc_sid=6e7a0a&_nc_ohc=-k1fjWYN6tcQ7kNvwFeQeCD&_nc_oc=AdoGQK0aMp6DYwHLZb62qHmPmbYf5ug8U0jNGZST_vxsoD0WKZ56_xA2cER4r2hOv28&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2MdbKfORTu71OL6ttLohGK6arm-NRsL1LJW85OUCX33Q&oe=69EE2336"}, {"file_name": "\u87a2\u5e55\u622a\u5716_005_kr.png", "id": "801302995885813", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491819983_801303002552479_2376498398477849746_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xG71Ltg5yOUQ7kNvwFKr0XR&_nc_oc=Adqd8FjS0uZPp4pixhZz-GetERDLF5rq_wVDrSFmUy6-yBKB_2241GncJR7alMbdCok&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2U4DKG8HP5mblZI9yZRpR5zg74YyqpE8pPwf5eKhgw2A&oe=69EE1C08"}, {"file_name": "\u9762\u677f.png", "id": "2355277388208038", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491822737_2355277391541371_1690352550379247786_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JdvjIJmvB7kQ7kNvwEU9w9o&_nc_oc=AdofypQh5OtYNaDcfCVO1UEb09lc6IIq8-_2QVkvSUJzv15CSHdDtOw07RSazPo2tRc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1Cn3R4H3OXpzBAJn-cJMvNTTwPn8Nzc_duRKAISTDukg&oe=69EE0DBC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u5fc3\u52d5\u5373\u6551\uff1aCPR+AED MR\u8a13\u7df4 \u5c08\u696d\u7248\uff08\u97d3\u570b\u7248\uff09.png", "id": "793753070275755", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491820382_793753073609088_5727275568138266673_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZeEYQcSQo6QQ7kNvwG0aqnR&_nc_oc=AdqT_ZpydD-95Mp4ia1WiTlpvMbgueCI6yg2KRlj_-mf8S41oDD6M1Q3Ag4u6780xsQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3H_lvCpw2i-jlZPZNPbYMDbvHxoXFDNSHzBQBivvoCrA&oe=69EE1356"}, "display_name": "\uc2ec\ucff5 \uad6c\uc870: \uc2ec\ud3d0\uc18c\uc0dd\uc220 (CPR)+AED MR \ud6c8\ub828 (\ud504\ub85c)", "keywords": ["\uc2ec\ud3d0\uc18c\uc0dd\uc220", "\uc790\ub3d9\uc2ec\uc7a5\ucda9\uaca9\uae30", "\uc2ec\ud3d0\uc18c\uc0dd\uc220\ud6c8\ub828", "CPR\ud6c8\ub828", "AED\uad50\uc721"], "long_description": "# CPR \ubc0f AED \ucd08\ubcf4 \ud559\uc2b5\uc790\uc5d0\uac8c \uc801\ud569\n\ub2e8\uacc4\ubcc4 \uc548\ub0b4\ub97c \ud1b5\ud574 \uc751\uae09 \ub300\uc751 \uacfc\uc815\uc744 \uc774\ud574\ud558\uace0 \uc62c\ubc14\ub978 \ubc18\uc751 \ub2a5\ub825\uc744 \uae30\ub97c \uc218 \uc788\uc2b5\ub2c8\ub2e4.\n\n**\ucd5c\uc2e0 \uc9c0\uce68\uc5d0 \ub530\ub978 \uc644\uc804\ud55c \uad6c\uc870 \uc808\ucc28 \uc2dc\ubbac\ub808\uc774\uc158**\n\n2020\ub144 \ud55c\uad6d \uc2ec\ud3d0\uc18c\uc0dd\uc220 \uc9c0\uce68(\uc131\uc778 \uae30\ubcf8\uc0dd\uba85\uc9c0\uc9c0, BLS)\uc744 \uae30\ubc18\uc73c\ub85c, \uad6d\uc81c \ubc0f \uad6d\ub0b4 \ud45c\uc900\uc744 \uacb0\ud569\ud558\uc5ec \uc644\uc804\ud558\uac8c \uc2dc\ubbac\ub808\uc774\uc158:\n\n- \uc758\uc2dd \ud655\uc778! \u2192 119 \uc2e0\uace0, AED \uc694\uccad! \u2192 \uac00\uc2b4 \uc555\ubc15 \uc2dc\uc791! \u2192 AED \uc0ac\uc6a9! \uc804\uae30 \ucda9\uaca9 \ud6c4 \uc555\ubc15 \uacc4\uc18d!\n- \uac01 \ub2e8\uacc4\ub9c8\ub2e4 \uba85\ud655\ud55c \uc9c0\uc2dc\ub97c \uc81c\uacf5\ud569\ub2c8\ub2e4. \uc2e4\uc218\uac00 \uc788\ub354\ub77c\ub3c4 \uacfc\uc815\uc744 \ub05d\uae4c\uc9c0 \ub9c8\uce60 \uc218 \uc788\uc5b4 \ucd08\ubcf4\uc790\uc758 \uc88c\uc808\uac10\uc744 \ucd5c\uc18c\ud654\ud569\ub2c8\ub2e4.\n- \uc21c\ucc28\uc801\uc778 \ud559\uc2b5\uc73c\ub85c \uc808\ucc28\uc801 \uc774\ud574\uc640 \uadfc\uc721 \uae30\uc5b5\uc744 \ud615\uc131\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4.\n- \uc2e4\uc81c \uc751\uae09 \uc0c1\ud669\uc5d0\uc11c \uce68\ucc29\ud558\uace0 \uc815\ud655\ud558\uac8c \ub300\uc751\ud560 \uc218 \uc788\ub3c4\ub85d \uc900\ube44\uc2dc\ud0b5\ub2c8\ub2e4.\n\n**\ub2e4\uad6d\uc5b4 \uc74c\uc131 \ubc0f \uc778\ud130\ud398\uc774\uc2a4 \uc9c0\uc6d0**\n- \ub2e4\uad6d\uc5b4 \uc804\ud658 \uae30\ub2a5\uc73c\ub85c \uc804 \uc138\uacc4 \uad50\uc721 \uc218\uc694\uc5d0 \ub300\uc751.\n- \ubc88\uc5ed \ubc0f \uc778\ub825 \ube44\uc6a9\uc744 \uc904\uc774\uace0, \uad50\uc721 \ud6a8\uc728\uc131\uacfc \uc811\uadfc\uc131\uc744 \ud5a5\uc0c1\uc2dc\ud0b5\ub2c8\ub2e4.\n\n**\uc2e4\uc2dc\uac04 \uac00\uc2b4 \uc555\ubc15 \uc2dc\uac01 \ud53c\ub4dc\ubc31**\n- \uc2dc\uac01 \ubc0f \uccad\uac01 \ud53c\ub4dc\ubc31\uc744 \ud1b5\ud574 \uc555\ubc15 \uae4a\uc774\uc640 \ub9ac\ub4ec\uc744 \uc989\uc2dc \ud30c\uc545.\n- \ub9ac\ub4ec \uc2e0\ud638\uac00 \uc801\uc808\ud55c \uc555\ubc15 \uc18d\ub3c4\ub97c \uc720\uc9c0\ud558\ub3c4\ub85d \uc9c0\uc6d0\ud558\uc5ec \uc2e4\uc81c \uc751\uae09 \uc0c1\ud669\uc744 \ub354\uc6b1 \ud604\uc2e4\uc801\uc73c\ub85c \uc7ac\ud604\ud569\ub2c8\ub2e4.\n\n**\u2018\uc2dc\ud5d8 \ubaa8\ub4dc\u2019\ub85c \uc2e4\uc804 \uc2dc\ubbac\ub808\uc774\uc158 \uac00\ub2a5**\n- \ud654\uba74 \uc548\ub0b4 \uc5c6\uc774 \uc74c\uc131 \uc9c0\uc2dc\ub9cc\uc73c\ub85c \uc9c4\ud589\ub418\ub294 \uc0c1\ud669\uc744 \uc81c\uacf5\ud569\ub2c8\ub2e4.\n- \ud6c8\ub828\uc0dd\uc758 \uc808\ucc28 \uc219\ub828\ub3c4\ub97c \uc2e4\uc81c\ub85c \uc2dc\ud5d8\ud558\uc5ec, \uc2e4\uc81c \uc751\uae09 \uc0c1\ud669\uc5d0 \uac00\uae4c\uc6b4 \uacbd\ud5d8\uc744 \uc81c\uacf5\ud569\ub2c8\ub2e4.\n\n**\uc644\uc804\ud55c \uc131\uc801 \ud3c9\uac00 \uc2dc\uc2a4\ud15c**\n- \uc2e4\uc2dc\uac04 \uac1c\uc778 \uc810\uc218 \ubd80\uc5ec \ubc0f \uc628\ub77c\uc778 \uae30\ub85d \uc870\ud68c \uae30\ub2a5\uc744 \uc9c0\uc6d0\ud569\ub2c8\ub2e4.\n- \ud6c8\ub828\uc0dd\uacfc \uac15\uc0ac\uac00 \ud559\uc2b5 \uc131\uacfc\uc640 \ud5a5\uc0c1 \uc815\ub3c4\ub97c \ucd94\uc801\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4.\n- \uc870\uc791 \ub370\uc774\ud130\ub97c \ubd84\uc11d\ud558\uc5ec \uc57d\uc810\uc744 \ube60\ub974\uac8c \ud30c\uc545\ud558\uace0, \ub9de\ucda4\ud615 \uad50\uc721 \uac15\ud654\ub97c \uc9c0\uc6d0\ud569\ub2c8\ub2e4.\n\n**\ub2e8\uccb4 \ud65c\ub3d9 \ubc0f \ubc31\uc5d4\ub4dc \uad00\ub9ac \uc9c0\uc6d0**\n- \ub2e4\uc778 \ud6c8\ub828 \ud65c\ub3d9\uc744 \uc0dd\uc131\ud558\uc5ec \uac01 \ucc38\uac00\uc790\uc758 \uc218\ud589 \uacb0\uacfc\ub97c \uae30\ub85d\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4.\n- \ubc31\uc5d4\ub4dc\uc5d0\uc11c \uc790\ub3d9\uc73c\ub85c \uc131\uc801 \ud1b5\uacc4 \ubc0f \uc2dc\uac01\ud654 \ubcf4\uace0\uc11c\ub97c \uc0dd\uc131\ud569\ub2c8\ub2e4.\n- \uad00\ub9ac\uc790\ub294 \ub370\uc774\ud130\ub97c \uae30\ubc18\uc73c\ub85c \ud559\uc2b5 \uc9c4\ub3c4 \ucd94\uc801\uacfc \uad50\uc721 \uc870\uc815\uc744 \uc218\ud589\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4\n\n\ud83d\udca1 **\ubcf8 \uc11c\ube44\uc2a4\ub294 \uad6c\ub3c5 \uae30\ubc18 \uc11c\ube44\uc2a4\uc785\ub2c8\ub2e4. \ubaa8\ub4e0 \uae30\ub2a5\uc744 \ucf8c\uc801\ud558\uac8c \uc774\uc6a9\ud558\uc2dc\ub824\uba74 \uc548\uc815\uc801\uc778 \uc778\ud130\ub137 \ud658\uacbd\uc5d0\uc11c \uc0ac\uc6a9\ud558\uc2dc\ub294 \uac83\uc744 \uad8c\uc7a5\ud569\ub2c8\ub2e4.**\n\n\uc81c\ud488\uc5d0 \ub300\ud55c \uad81\uae08\ud55c \uc810\uc774\ub098 \uc758\uacac, \uc81c\uc548 \ub610\ub294 \uc0c1\ub2f4\uc774 \uc788\uc73c\uc2dc\uba74 \uc544\ub798 \uc774\uba54\uc77c \uc8fc\uc18c\ub85c \ud3b8\ud558\uac8c \ubb38\uc758\ud574 \uc8fc\uc2dc\uae30 \ubc14\ub78d\ub2c8\ub2e4.\n\n\ud83d\udce9\ubb38\uc758\uff1ahuagingofficial@gmail.com", "short_description": "CPR \ubc0f AED \ucd08\ubcf4 \ud559\uc2b5\uc790\uc5d0\uac8c \uc801\ud569\n\ub2e8\uacc4\ubcc4 \uc548\ub0b4\ub97c \ud1b5\ud574 \uc751\uae09 \ub300\uc751 \uacfc\uc815\uc744 \uc774\ud574\ud558\uace0 \uc62c\ubc14\ub978 \ubc18\uc751 \ub2a5\ub825\uc744 \uae30\ub97c \uc218 \uc788\uc2b5\ub2c8\ub2e4.\n\n\ud55c\uad6d \ubcf4\uac74\ubcf5\uc9c0\ubd80\uc758 \u300a2020\ub144 \ud55c\uad6d \uc2ec\ud3d0\uc18c\uc0dd\uc220 \uc9c0\uce68(\uc131\uc778 \uae30\ubcf8\uc0dd\uba85\uc9c0\uc9c0, BLS)\u300b\uc744 \uae30\ubc18\uc73c\ub85c, \ud559\uad50, \uae30\uc5c5 \ud504\ub85c\uadf8\ub7a8, \uc804\ubb38 \uad50\uc721\uae30\uad00 \ubc0f \ub2e8\uccb4 \ud6c8\ub828\uc5d0 \ub9de\ucdb0 \uc124\uacc4\ub418\uc5c8\uc2b5\ub2c8\ub2e4. \uc644\uc804\ud55c \ud559\uc2b5 \ubc0f \ud3c9\uac00 \uc2dc\uc2a4\ud15c\uc744 \uc81c\uacf5\ud569\ub2c8\ub2e4.\n\n\uc774 \uc11c\ube44\uc2a4\ub294 \uc720\ub8cc \uad6c\ub3c5 \uae30\ubc18\uc785\ub2c8\ub2e4. \ubaa8\ub4e0 \uae30\ub2a5\uc5d0 \ub300\ud55c \uc804\uccb4 \uc811\uadfc \uad8c\ud55c\uacfc \ucd5c\uc0c1\uc758 \uacbd\ud5d8\uc744 \uc704\ud574 \uc548\uc815\uc801\uc778 \uc778\ud130\ub137 \uc5f0\uacb0 \ud658\uacbd\uc5d0\uc11c \uc0ac\uc6a9\ud574 \uc8fc\uc138\uc694.\n"}, {"images": {"nodes": [{"file_name": "CPR+AEDLogo_Icon_Foreground_KR(en).png", "id": "3153004648192879", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491822034_3153004651526212_3689632914282206812_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DsVfAbKJQEgQ7kNvwH5hl7t&_nc_oc=AdpMg0k3DIhkARgTN8edKynCkLMP_DTp0B8x7wtVvhVOj2i6xXc1Yx9JktcCZKP5sz4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af14PP-GxQVL1Wl6f6eTaEWRb62DUbwf6QXZ7vB6blybUQ&oe=69EE13BD"}, {"file_name": "PDP Art_KR(en).png", "id": "1152656870059054", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491824560_1152656873392387_2720940703971699353_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vccT3g7E198Q7kNvwHLl-oW&_nc_oc=AdqpYUDPks3_QJ7pGhXMCHH34lWARg8N1Ys5Z8JhtNRxrrVT-FwoFnYeQvTcTTi7oII&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1XfIojWU4gF9M-XCIDU5QuvV_TOEYSbNp6y0ak7Vg1Ig&oe=69EE0802"}, {"file_name": "Portrait_KR(en).png", "id": "1124808623049710", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491825009_1124808626383043_1480108280619956200_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_oHGlLj3oXUQ7kNvwFk7Kgy&_nc_oc=AdpPMODZewjfJIm391xlwD5igmsMrprqD0hB9EguLvQiGx8bZL6CE5LKDwl-Dd-xhvk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2VXmEQgfL8BypoJP6y-ijs-opFlArkRbIfVHQ7BRn8-w&oe=69EE0D31"}, {"file_name": "CPR+AEDLogo_Icon_KR(en).png", "id": "931235782554298", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823485_931235785887631_8253092318600374134_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AixJt2WeO04Q7kNvwFD0hDc&_nc_oc=AdooEmUw_j-UwjgrnQswh5gU19R0MRIo7UkgNMm
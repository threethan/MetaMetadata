d3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLRAajpJ1aJQCSy8F8IBvixMLmY24FC3f-tEwahgN2Hbg&oe=6A985EF4"}, {"file_name": "show_test_en.png", "id": "1299107685342138", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491830007_1299107688675471_6221243196139837211_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L146ysiRZAEQ7kNvwE4L1fO&_nc_oc=AdrDxmqqLAGzcb5UAaTU47TM6KBg2S7fiVRVwLOB4Llcn93D39B0TyWv1vt3YyeZOb4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK3eL7JJwxOmbIGbQw7ASZ3XjmRtzof-A2zUtyJjL52uw&oe=6A986A5F"}, {"file_name": "\u6210\u7e3e_en.png", "id": "1305568201253615", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491822800_1305568204586948_6647554989950197956_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wuhF5Gc1a-sQ7kNvwFVOo1G&_nc_oc=Adr7ABGMjFrRbW8djdv8TVl2Qwtaqsjv6nUQ0H0NFzKrrzMbJVZX9RQ1197UKpKarqw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLmRgKLvGj7zjrEFP4aOA3m-cRfizmQeGIOKB1ANNHDPA&oe=6A985043"}, {"file_name": "\u87a2\u5e55\u622a\u5716_005_en.png", "id": "1316589686744004", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491824213_1316589690077337_6407229494548091322_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JfXeDCGGHn4Q7kNvwG195ON&_nc_oc=AdpKYH7l9MP2ZGpz9V1DFv4FtO4T2GPkwvOgj1PaactZmaf-P6ayJdA5gSA6iyktyaI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJr3D-jxJJDDQ2jLEpGncAcJXpPXTUKkt4D3Nelr3ApDg&oe=6A986A2E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u5fc3\u52d5\u5373\u6551\uff1aCPR+AED MR\u8a13\u7df4\uff08\u7f8e\u570b\u7248\uff09(1920x1080)2m.png", "id": "1508236407193924", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491821881_1508236413860590_6901290350086078181_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_qf9EDcVSbgQ7kNvwEF_eHK&_nc_oc=AdrpetN7lmS4T61rJaziIK_cBP7zg_zmT8FLvx_2mfx_cYTJ38mWDkmg5ro7iah-X44&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJYpUTT1GXmuq5DV6psGeZx6x1pqcshlB4R6RnVIc-diA&oe=6A983419"}, "display_name": "Heartbeat Rescue: CPR+AED MR (Pro, KR)", "keywords": ["AED", "CPR", "training", "emergency", "resuscitation"], "long_description": "# Ideal for first-time learners of CPR and AED\nStep-by-step guidance explains the emergency process and builds proper reactions.\n\n**Simulates the Full Rescue Procedure (Latest Guidelines)**\n\nBased on the latest AHA CPR guidelines, integrating international practices and U.S. standards:\n- Check (responsiveness & breathing) \u2192 Call (dial 911 & get AED) \u2192 Compress (chest compressions) \u2192 Shock (use AED)\n- Clear instructions minimize frustration for beginners.\n- Sequential teaching builds understanding and muscle memory.\n- Prepares users to stay calm and respond correctly.\n\n\n**Multilingual Voice & Interface Support**\n- Global training support with easy language switching.\n- Cuts translation costs and improves accessibility.\n\n\n**Real-Time Compression Feedback**\n- Visual and auditory feedback shows depth and rhythm.\n- Rhythm cues guide proper rate, simulating real-life needs.\n\n\n**\u201cTest Mode\u201d for Real-Life Simulation**\n- Visual prompts removed; audio only.\n- Tests CPR familiarity under pressure, simulating emergencies.\n\n\n**Comprehensive Performance Evaluation**\n- Real-time scoring with online record access.\n- Supports tracking progress and targeted improvement.\n\n\n**Group Training & Backend Management**\n- Multi-user sessions with individual records.\n- Backend generates summaries and visual reports.\n- Helps admins monitor and adjust training.\n\n\ud83d\udca1 **Subscription-based service. For full features, use with a stable internet connection.**\n\n\ud83d\udce9 Contact us: huagingofficial@gmail.com", "short_description": "Ideal for first-time CPR and AED learners.\nStep-by-step guidance explains the emergency process and builds proper response skills. Based on the latest AHA guidelines, this version suits schools, companies, instructors, and group training. \nIt offers a complete learning and assessment system with flexibility. This is a subscription service; for full access and best performance, please connect to a stable internet.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.huaging.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "HUAGING Digital Technology", "support_website_url": "https://www.huaging.com/en/contact", "website_url": "https://www.huaging.com/en/collections/cpr-and-aed-PRO", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "478089301798119"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ko", "zh_TW", "ja", "id"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24207430718942720"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1730855221650411"}]}, "baseline_offer": {"id": "1730855221650411"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1757033700, "status": "PUBLISHED", "id": "1730855221650411"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "27162717280080701", "version": "0.3.9"}, "id": "1643987409602691", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "24207430705609388", "is_concept": false, "latest_
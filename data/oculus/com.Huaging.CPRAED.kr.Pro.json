c_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TNg0zLfS7YEQ7kNvwGVnc9h&_nc_oc=Adm1MvbxVbHU6GlThKHbzFKtcpfb5PsAte4nC-8pTK34O-tHXqXV3BuEU0NnzAu2tEc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afts-1k6p-AxFIgo2Qq2yQHh4MbRI6CjC9RTJjAfC3Ultg&oe=69A0581F"}, {"file_name": "\u6210\u7e3e_en.png", "id": "1305568201253615", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491822800_1305568204586948_6647554989950197956_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=39Xx3GLW0gYQ7kNvwEjME4k&_nc_oc=AdlCL4YAQ41XvnEpLydYFfJa8cj_JZpMzYmqN9OxtpAeMuWL6M5Rs3QwE_AKVnHThfk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfsYHFbklw6f192OAM9wkBOjgiVRzJ1HZ623utuKoNfZew&oe=69A03E03"}, {"file_name": "\u87a2\u5e55\u622a\u5716_005_en.png", "id": "1316589686744004", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491824213_1316589690077337_6407229494548091322_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HrtOYndFdAIQ7kNvwFq0Rzi&_nc_oc=AdnLqfp1zhTT9azaPpIoIACO0UW18s4l56-TLpm1oSeLdkRxwnKlrCEjS0eWHe1ZTOU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfsZBd5ukFDZJr0tf91FEA8gqJhaqYF2JO6yT1H0eooqAg&oe=69A057EE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u5fc3\u52d5\u5373\u6551\uff1aCPR+AED MR\u8a13\u7df4\uff08\u7f8e\u570b\u7248\uff09(1920x1080)2m.png", "id": "1508236407193924", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491821881_1508236413860590_6901290350086078181_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OTLXcvkEaIwQ7kNvwEANSsO&_nc_oc=AdmOAJcWPfVA4VWtGhUgB0yrjWIxhS98g4lbaR5rxAZbp6gJd8Dh2a4KTbVSu0nK308&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfspZ-n1hNj7Crs3qLeUcqVWshYhttTZ0tMpwLM0ZtEwEQ&oe=69A05A19"}, "display_name": "Heartbeat Rescue: CPR+AED MR (Pro, KR)", "keywords": ["AED", "CPR", "training", "emergency", "resuscitation"], "long_description": "# Ideal for first-time learners of CPR and AED\nStep-by-step guidance explains the emergency process and builds proper reactions.\n\n**Simulates the Full Rescue Procedure (Latest Guidelines)**\n\nBased on the latest AHA CPR guidelines, integrating international practices and U.S. standards:\n- Check (responsiveness & breathing) \u2192 Call (dial 911 & get AED) \u2192 Compress (chest compressions) \u2192 Shock (use AED)\n- Clear instructions minimize frustration for beginners.\n- Sequential teaching builds understanding and muscle memory.\n- Prepares users to stay calm and respond correctly.\n\n\n**Multilingual Voice & Interface Support**\n- Global training support with easy language switching.\n- Cuts translation costs and improves accessibility.\n\n\n**Real-Time Compression Feedback**\n- Visual and auditory feedback shows depth and rhythm.\n- Rhythm cues guide proper rate, simulating real-life needs.\n\n\n**\u201cTest Mode\u201d for Real-Life Simulation**\n- Visual prompts removed; audio only.\n- Tests CPR familiarity under pressure, simulating emergencies.\n\n\n**Comprehensive Performance Evaluation**\n- Real-time scoring with online record access.\n- Supports tracking progress and targeted improvement.\n\n\n**Group Training & Backend Management**\n- Multi-user sessions with individual records.\n- Backend generates summaries and visual reports.\n- Helps admins monitor and adjust training.\n\n\ud83d\udca1 **Subscription-based service. For full features, use with a stable internet connection.**\n\n\ud83d\udce9 Contact us: huagingofficial@gmail.com", "short_description": "Ideal for first-time CPR and AED learners.\nStep-by-step guidance explains the emergency process and builds proper response skills. Based on the latest AHA guidelines, this version suits schools, companies, instructors, and group training. \nIt offers a complete learning and assessment system with flexibility. This is a subscription service; for full access and best performance, please connect to a stable internet.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.huaging.com/privacy-policy", "developer_terms_of_service_url"
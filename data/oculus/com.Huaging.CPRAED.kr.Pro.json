s2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0pB6iIWy5FWtg-jUP-n3Z1bK_rHKnSrMsXa6Cljq8IDQ&oe=69DA4EB4"}, {"file_name": "show_test_en.png", "id": "1299107685342138", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491830007_1299107688675471_6221243196139837211_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xXA4RWyIs5wQ7kNvwHrNA_K&_nc_oc=Adrw4H6AQkGvgisijqYaNfy83b_IZlTWgn1Vrje-iET9l56UIDfEePD7m6VCPYavWns&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1homI9KSb165O9bx6Btym4oyIH22QqZ6_QGQ073OBe3w&oe=69DA5A1F"}, {"file_name": "\u6210\u7e3e_en.png", "id": "1305568201253615", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491822800_1305568204586948_6647554989950197956_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=diQCYZ4o76kQ7kNvwG2dHG7&_nc_oc=AdpBWdu7D3cZ7ieGCDLUpWYDXrATmSNZWCIaWCHd2klEqL9q_sMC6DbTU2hpORZoGXs&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1pTpAiMMygpWG8X3gmSZ8t2gRNG0PmRb48mJzJnN01VA&oe=69DA4003"}, {"file_name": "\u87a2\u5e55\u622a\u5716_005_en.png", "id": "1316589686744004", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491824213_1316589690077337_6407229494548091322_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mvGJp9UA8qUQ7kNvwE-BCh_&_nc_oc=AdpCWTI87veqRR8HXn16skz2nSzgb7lJ_fq9K2et2ceSS_3_o7SbE7fGgOSzR5Z_xXs&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2ILodSi6qzo6w7ZxXRSaLSFM2e6Vb8J-C8RYElIBKh_w&oe=69DA59EE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u5fc3\u52d5\u5373\u6551\uff1aCPR+AED MR\u8a13\u7df4\uff08\u7f8e\u570b\u7248\uff09(1920x1080)2m.png", "id": "1508236407193924", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491821881_1508236413860590_6901290350086078181_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IlunIX7EevMQ7kNvwHawMIW&_nc_oc=AdonrsawBjdtXFOnoNY4GeopX-Osi7NVmjbYGG9rrA24k0pXG16dfzAJBco1k8h5yAQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2psRZku02NtdL5mEAmaaNbmLt8b5hlVFeP5gdtvNZD1Q&oe=69DA5C19"}, "display_name": "Heartbeat Rescue: CPR+AED MR (Pro, KR)", "keywords": ["AED", "CPR", "training", "emergency", "resuscitation"], "long_description": "# Ideal for first-time learners of CPR and AED\nStep-by-step guidance explains the emergency process and builds proper reactions.\n\n**Simulates the Full Rescue Procedure (Latest Guidelines)**\n\nBased on the latest AHA CPR guidelines, integrating international practices and U.S. standards:\n- Check (responsiveness & breathing) \u2192 Call (dial 911 & get AED) \u2192 Compress (chest compressions) \u2192 Shock (use AED)\n- Clear instructions minimize frustration for beginners.\n- Sequential teaching builds understanding and muscle memory.\n- Prepares users to stay calm and respond correctly.\n\n\n**Multilingual Voice & Interface Support**\n- Global training support with easy language switching.\n- Cuts translation costs and improves accessibility.\n\n\n**Real-Time Compression Feedback**\n- Visual and auditory feedback shows depth and rhythm.\n- Rhythm cues guide proper rate, simulating real-life needs.\n\n\n**\u201cTest Mode\u201d for Real-Life Simulation**\n- Visual prompts removed; audio only.\n- Tests CPR familiarity under pressure, simulating emergencies.\n\n\n**Comprehensive Performance Evaluation**\n- Real-time scoring with online record access.\n- Supports tracking progress and targeted improvement.\n\n\n**Group Training & Backend Management**\n- Multi-user sessions with individual records.\n- Backend generates summaries and visual reports.\n- Helps admins monitor and adjust training.\n\n\ud83d\udca1 **Subscription-based service. For full features, use with a stable internet connection.**\n\n\ud83d\udce9 Contact us: huagingofficial@gmail.com", "short_description": "Ideal for first-time CPR and AED learners.\nStep-by-step guidance explains the emergency process and builds proper response skills. Based on the latest AHA guidelines, this version suits schools, companies, instructors, and group training. \nIt offers a complete learning and assessment system with flexibility. This is a subscription service; for full access and best performance, please connect to a stable internet.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.huaging.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "HUAGING Digital Technology", "support_website_url": "https://www.huaging.com/en/contact", "website_url": "https://www.huaging.com/en/collections/cpr-and-aed-PRO", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "478089301798119"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ko", "zh_TW", "ja", "id"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24207430718942720"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1730855221650411"}]}, "baseline_offer": {"id": "1730855221650411"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1757033700, "status": "PUBLISHED", "id": "1730855221650411"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "26064517359900704", "version": "0.3.4"}, "id": "1643987409602691", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "24207430705609388", "is_concept": false, "latest_
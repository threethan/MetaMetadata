oe=69BAAAB4"}, {"file_name": "show_test_en.png", "id": "1299107685342138", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/491830007_1299107688675471_6221243196139837211_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b1MHAsl3P5QQ7kNvwHJB61Z&_nc_oc=AdmhxODNgToZ_g3cRz8zgMgjuSsTRNL-2avQO5327d7xNSWKWPa-zoReH3aKvk1gF9c&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_AfyzBkEzvAAAEhaM5xfJSTKIoJ6EiwPznAdnXyu4OZIQug&oe=69BAB61F"}, {"file_name": "\u6210\u7e3e_en.png", "id": "1305568201253615", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/491822800_1305568204586948_6647554989950197956_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gr3uu1Ew-FoQ7kNvwEjRLh2&_nc_oc=AdkD6msfZX1WVLL6iwk7-X2CJk04qOXJvpYJHqYn85OVM-UXwMYjQC1foOqoN6cuupo&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=8&oh=00_AfxweoEXForRFT-bgLDT9WYgmUszv3SXRY52--ZqGq_J_w&oe=69BA9C03"}, {"file_name": "\u87a2\u5e55\u622a\u5716_005_en.png", "id": "1316589686744004", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/491824213_1316589690077337_6407229494548091322_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mEHHWBB-c5gQ7kNvwF1y3xt&_nc_oc=AdnRfMsE7m0hFNelC-MZ95UN63b-m-UPavpOaR3Dsb-cY2kYyRF1aiQ2S8t5Bk67uHU&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=8&oh=00_AfweGBSQDQUjZ3StQ5L-Ty5B7bUihOXZ761HqGRWP9V6Tg&oe=69BAB5EE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u5fc3\u52d5\u5373\u6551\uff1aCPR+AED MR\u8a13\u7df4\uff08\u7f8e\u570b\u7248\uff09(1920x1080)2m.png", "id": "1508236407193924", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/491821881_1508236413860590_6901290350086078181_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YSFPrqFExqMQ7kNvwEuWcar&_nc_oc=AdktrnnAJPLKhtmG0sk7WO19DRrT_6mpSUYGAKyamp_wt-BFPat7t-_aj4F3p44-Q6o&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_AfwjfEQ7AqAiA28V6S0XPBGLyNX_zk6WRY84YNaSDZTC9Q&oe=69BA7FD9"}, "display_name": "Heartbeat Rescue: CPR+AED MR (Pro, KR)", "keywords": ["AED", "CPR", "training", "emergency", "resuscitation"], "long_description": "# Ideal for first-time learners of CPR and AED\nStep-by-step guidance explains the emergency process and builds proper reactions.\n\n**Simulates the Full Rescue Procedure (Latest Guidelines)**\n\nBased on the latest AHA CPR guidelines, integrating international practices and U.S. standards:\n- Check (responsiveness & breathing) \u2192 Call (dial 911 & get AED) \u2192 Compress (chest compressions) \u2192 Shock (use AED)\n- Clear instructions minimize frustration for beginners.\n- Sequential teaching builds understanding and muscle memory.\n- Prepares users to stay calm and respond correctly.\n\n\n**Multilingual Voice & Interface Support**\n- Global training support with easy language switching.\n- Cuts translation costs and improves accessibility.\n\n\n**Real-Time Compression Feedback**\n- Visual and auditory feedback shows depth and rhythm.\n- Rhythm cues guide proper rate, simulating real-life needs.\n\n\n**\u201cTest Mode\u201d for Real-Life Simulation**\n- Visual prompts removed; audio only.\n- Tests CPR familiarity under pressure, simulating emergencies.\n\n\n**Comprehensive Performance Evaluation**\n- Real-time scoring with online record access.\n- Supports tracking progress and targeted improvement.\n\n\n**Group Training & Backend Management**\n- Multi-user sessions with individual records.\n- Backend generates summaries and visual reports.\n- Helps admins monitor and adjust training.\n\n\ud83d\udca1 **Subscription-based service. For full features, use with a stable internet connection.**\n\n\ud83d\udce9 Contact us: huagingofficial@gmail.com", "short_description": "Ideal for first-time CPR and AED learners.\nStep-by-step guidance explains the emergency process and builds proper response skills. Based on the latest AHA guidelines, this version suits schools, companies, instructors, and group training. \nIt offers a complete learning and assessment system with flexibility. This is a subscription service; for full access and best performance, please connect to a stable internet.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.huaging.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "HUAGING Digital Technology", "support_website_url": "https://www.huaging.com/en/contact", "website_url": "https://www.huaging.com/en/collections/cpr-and-aed-PRO", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "478089301798119"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ko", "zh_TW", "ja", "id"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24207430718942720"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1730855221650411"}]}, "baseline_offer": {"id": "1730855221650411"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1757033700, "status": "PUBLISHED", "id": "1730855221650411"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "25993380500347724", "version": "0.3.3"}, "id": "1643987409602691", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "24207430705609388", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "25993380500347724"}, "release_status": "RELE
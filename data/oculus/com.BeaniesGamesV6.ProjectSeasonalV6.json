X5ws1&_nc_oc=AdrLmA2-UQ-Sy9D7qBxdBl34VuPGyee-w7Bh7I701n-2UJXO6SYSdcpN32UJGSyMvAQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNkNYjhO_c-WjQhXlT_JbQnqlVeXoo2FeascLRmWcXxrw&oe=6AD22ECE"}, {"file_name": "screenshot4.png", "id": "1436868187311843", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499295272_1436868190645176_7531870685699609970_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8J2Xg3lNqpoQ7kNvwFCLfk9&_nc_oc=Adoui7SIDF5t2CPq0QWIwYrpxF0Fia9WZJUFo18f3XK6To3Xftjf6r0DCLROcq-PacE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP8Cm-4IisngX8-_1gVgLDwefGTZDXmeCZqYEzwc66N-A&oe=6AD2443F"}, {"file_name": "screenshot2.png", "id": "26138061562552124", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499304952_26138061569218790_8781901503410935442_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MJEBIfSg-fMQ7kNvwEmKWoc&_nc_oc=Ado6zhtS3fFFZT9dyPYgqfSLVXGH3FQkxsWTKrv2lpQgYwa7bc5JJIcAe00Pq62TRa8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPdZahR-Rkz29M7hcs82hQ4-ESZeD2Yx6752xxzgzkyjw&oe=6AD2523E"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Project Seasonal V6", "keywords": ["Seasonal", "Project", "New"], "long_description": "Project Seasonal V6 is a Gorilla Tag fangame on App Lab built around a chill, fun vibe with seasonal themes that keep things feeling fresh. It currently features a forest-style map you can explore, along with smooth, classic gorilla locomotion movement that makes getting around feel natural and satisfying.\n\nThe game is designed to be simple to jump into but still fun to mess around in, whether you\u2019re climbing, running, or just exploring the environment. There are already some cool features in place, and even more content is planned for future updates, including new maps, additions, and improvements.\n\nIf you like Gorilla Tag-style movement and want something with its own twist and ongoing updates, Project Seasonal V6 is a solid place to check out and just have fun.", "short_description": "Project Seasonal V6 is a Gorilla Tag fangame on App Lab with a chill vibe and seasonal themes. It features a forest map, uses classic gorilla locomotion for movement, and has some fun features to mess around with\u2014plus a lot more stuff coming soon."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/project-seasonalstuff/home?read_current=1", "developer_terms_of_service_url": null, "publisher_name": "Beanie", "support_website_url": null, "website_url": "https://sites.google.com/view/project-seasonalstuff/home?authuser=1&read_current=1", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "275629210202852"}, {"id": "644354873106712"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "MULTI_USER", "MULTI_USER"], "id": "26467981272888490"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1627843981862219"}]}, "baseline_offer": {"id": "1627843981862219"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1774291920, "status": "PUBLISHED", "id": "1627843981862219"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "28034968842856384", "version": "6"}, "id": "1270101731727821", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__
lace to check out and just have fun.", "short_description": "Project Seasonal V6 is a Gorilla Tag fangame on App Lab with a chill vibe and seasonal themes. It features a forest map, uses classic gorilla locomotion for movement, and has some fun features to mess around with\u2014plus a lot more stuff coming soon."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/project-seasonalstuff/home?read_current=1", "developer_terms_of_service_url": null, "publisher_name": "Beanie", "support_website_url": null, "website_url": "https://sites.google.com/view/project-seasonalstuff/home?authuser=1&read_current=1", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "275629210202852"}, {"id": "644354873106712"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "MULTI_USER", "MULTI_USER"], "id": "26467981272888490"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1627843981862219"}]}, "baseline_offer": {"id": "1627843981862219"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1774291920, "status": "PUBLISHED", "id": "1627843981862219"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "28034968842856384", "version": "6"}, "id": "1270101731727821", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__
mage ChatXR.png", "id": "1156828252314618", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/57570293_1156828258981284_5128504887558746966_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HryugUt1DpwQ7kNvwHZ98dz&_nc_oc=AdpFLUw5XSy45n5LgUxGEtiCCQyFKHw0_4-Ehd8wF2HQvrN-7MFoTIR_peqpDXzgQxo&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHv6ILiHPdw1zWXaDEZTzq641GoTscqidXZzx3zkGLgHw&oe=6A7DB9B8"}, "display_name": "Chat XR", "keywords": [], "long_description": "Welcome to Chat XR, the ultimate social experience in extended reality! \nConnect, Create, and Communicate!\nExpress your creativity in the Art Chat Room, where you can collaborate with friends on artistic projects, or explore the latest works from up-and-coming artists. Dive into Chat XR Music to discover new artists, enjoy live performances, and connect with other music lovers.\n\nChat XR is more than just an app\u2014it\u2019s a community-building platform that brings people together in a shared virtual space. With our innovative technology, characters and sets come to life right in your home, creating a seamless blend of reality and virtual interaction.\n\nJoin us in Chat XR and transform the way you connect, create, and communicate!", "short_description": "Welcome to Chat XR, the ultimate social experience in extended reality! Meet up with friends, make new connections, and engage in dynamic discussions in a vibrant, immersive environment. Whether you\u2019re looking to participate in lively topic discussions, compete in our exciting trivia game show, or engage in passionate political debates, Chat XR has something for everyone."}]}, "developer_name": "Paul Vowell", "developer_privacy_policy_url": "https://chatxr.io/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "4D Fun Inc", "support_website_url": "https://4dfun.io/", "website_url": "https://chatxr.io/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "3626922114
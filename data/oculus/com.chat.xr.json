lay_name": "Chat XR", "keywords": [], "long_description": "Welcome to Chat XR, the ultimate social experience in extended reality! \nConnect, Create, and Communicate!\nExpress your creativity in the Art Chat Room, where you can collaborate with friends on artistic projects, or explore the latest works from up-and-coming artists. Dive into Chat XR Music to discover new artists, enjoy live performances, and connect with other music lovers.\n\nChat XR is more than just an app\u2014it\u2019s a community-building platform that brings people together in a shared virtual space. With our innovative technology, characters and sets come to life right in your home, creating a seamless blend of reality and virtual interaction.\n\nJoin us in Chat XR and transform the way you connect, create, and communicate!", "short_description": "Welcome to Chat XR, the ultimate social experience in extended reality! Meet up with friends, make new connections, and engage in dynamic discussions in a vibrant, immersive environment. Whether you\u2019re looking to participate in lively topic discussions, compete in our exciting trivia game show, or engage in passionate political debates, Chat XR has something for everyone."}]}, "developer_name": "Paul Vowell", "developer_privacy_policy_url": "https://chatxr.io/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "4D Fun Inc", "support_website_url": "https://4dfun.io/", "website_url": "https://chatxr.io/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "2687655338230691"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supporte
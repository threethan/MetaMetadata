96424914_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B7xq8vdiXroQ7kNvwExd0QH&_nc_oc=AdqPV17oBObL2ev7m0PYffIBKNDbTepFR0EKmMpPCdY63Et3-wEpLZYcrFMHz7vVXZ0&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTz0IN_GeRVA7Oqz_EaJxCOYX5aBMI5lo5bHm3ejrziug&oe=6B083C5D"}, {"file_name": "02-helios-tutorial.png", "id": "2818899021818025", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/499300541_2818899025151358_360136140372549368_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f_fXsSwbFz0Q7kNvwEzlLW1&_nc_oc=AdporXdn37LtMFYLVcCsfxGpeXHhdWD0sLv1tlPZhRgUfN-JmQ3tdYCSdnY3RzO8Zb8&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQmtavEQ54Ps_ChYeviwiJUIfbCxbczlGDq7AtSkNv1iw&oe=6B085512"}, {"file_name": "03-pull-hydrogen.png", "id": "1054661097489532", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/499299845_1054661100822865_2270747996044071301_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wHcus3sh3k4Q7kNvwF9rWCb&_nc_oc=AdqxSws35KmLURZtEVhYTZhnSAuYeXiD4o6_ci8JXPidzViaHfDpTr2RPpJodG8FXaM&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRPNx-ggsXohdJuKpNCXcvThreFM9JOhxdg1LcabGCzEQ&oe=6B086B20"}, {"file_name": "06-challenge-mode.png", "id": "1048379037942310", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499314351_1048379041275643_9065269578023189354_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VIsAJ-4VZpoQ7kNvwEATw2w&_nc_oc=AdogisR1e9IA666gDYQofszpbZdRlk0VcD_6_-G8OQB1OQT8OqUrh0mvLvv1JHiSeZE&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQCgLsQi8zrgBiThvKbVbuUQMbDaE-TRQWlFOpQEqjdxQ&oe=6B084AE4"}, {"file_name": "07-specimen-cabinet.png", "id": "1075740994974517", "uri": "https://scontent-dfw5-3.oculuscdn.com/v/t64.5771-25/499310596_1075740998307850_7583973766082183369_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PB9C7nddADIQ7kNvwFpWLtW&_nc_oc=AdpIdks9zpsd5El4jfgrAHRIqes5dgxZOlXygM9NIgQHHL1DTYYY_fyX6BdzZ1dsDfA&_nc_zt=3&_nc_ht=scontent-dfw5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSPWdZc32KBog2NFJtDxv1bo4SoECjDSDFGQ8X2IVJB4Q&oe=6B084C66"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Atomic_Smash_Lab_Poster_4K.png", "id": "949676024883577", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/673652249_949676028216910_691829145299184120_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0GXcylYQ4UwQ7kNvwHpUMDp&_nc_oc=AdrxMRWxAPwiVeAaiRb8WQh9WYjNFSDjqYIDBTK3ZAb7X0_TOWqbkr2LF73mMLMDLvg&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTCBS9rqswCOZhDAlz7yxXd_JHSQzCJXUXOcHVsSb8G5w&oe=6B086340"}, "display_name": "Atomic Smash Lab", "keywords": ["science", "education", "atomic", "fun", "cool"], "long_description": "# Your living room is now a laboratory.\n\n**Atomic Smash Lab** turns your real space into a holographic chemistry playground. Reach into a floating periodic table of all **118 elements**, pull real atoms into the air, and smash them together to build actual molecules \u2014 water, caffeine, table salt, rust, even uranium hexafluoride.\n\n## What you do\n- **Pull fully-formed atoms** off the table, built to the real Bohr model.\n- **Grab one in each hand and push them together to fuse.** Real chemistry makes a real, named molecule.\n- Everything drifts in zero-gravity \u2014 pinch, spin, and knock atoms around like the coolest desk toy.\n\n## 180+ real molecules\nEach comes with a **fun fact**, from the water covering your planet to the caffeine in your coffee. Collect them all in your **Specimen Cabinet**.\n\n## A lab that sings\nEvery element rings on its own **pentatonic** note, so each molecule you build sounds like a gentle glass-bowl chord.\n\n## Endless challenges\n- **Molecule Lab** \u2014 an ever-growing recipe ladder.\n- **Challenge Mode** \u2014 ten themed, timed gauntlets, from *Kitchen & Flavor* to *Radioactive* and the ultra-hard *Megamolecules*.\n- **Helios**, a friendly helium mascot, teaches you the ropes.\n\n## Built for everyone\nFully **seated and stationary** \u2014 play from your couch, bed, or a classroom desk. Real science under the fun makes it a genuine **teaching tool**.\n\n*Pull an atom. Smash it together. Discover the universe, one molecule at a time.*", "short_description": "A holographic chemistry lab in your living room \u2014 smash atoms into molecules."}]}, "developer_name": "Sam Robison", "developer_privacy_policy_url": "https://sammyr72.github.io/atomic-smash-lab/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Sam Robison", "support_website_url": null, "website_url": "https://sammyr72.github.io/atomic-smash-lab/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1392709163921499"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw5-3.oculuscdn.com/v/t64.5771-25/499311585_1710804086629177_5333242497170912486_n.png?stp=dst-png_s360x360&_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nyZOYJFt05gQ7kNvwE-iGOF&_nc_oc=AdqxYV2EC7410bVe7qHBNy25EQe95ADQmIidBNXhSRaBJAlhReuD1H2FkGqVXsrIc-w&_nc_zt=3&_nc_ht=scontent-dfw5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRn9OQVRt2FgYAj-2F4ahS9fBhctYbuLEWPFXz23DCxRQ&oe=6B086B55"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_
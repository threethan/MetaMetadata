t=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMdRpl8DPSe-tcr5xj5yGjhAFLNz7ApnX_7C-vKTi0yEg&oe=6AC27453"}]}, "id": "1991680161484335", "locale": "en_US", "screenshots": [{"file_name": "meta1.png", "id": "988398790882272", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491830822_988398807548937_6074407942773592479_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4jCLnkq1l0sQ7kNvwFWbfOn&_nc_oc=AdovBTyRxj17_rO8B88qa1uddaywm1m_uAywErIhGQF9d7-YEsU8BGMVjEfHV0DOOAg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNvXMXhia_pR8h0huYvZDBb3b1ol8ZXOtU0bdhH9_odgg&oe=6AC2785A"}, {"file_name": "meta5.png", "id": "3421193434727416", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491830576_3421193438060749_5052904432392973502_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WUqZNak0ioQQ7kNvwEKQASU&_nc_oc=Adoa6m000HYrbXPGb_YU18AN9Bs5SpR6j5zDXpfmjhNoKsNUqhb4eQ0j4incfV41yC4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOltwLWJVFUdxOhdvhNpGf8lSvuROS1lwGDYlghdGpOhw&oe=6AC27DD4"}, {"file_name": "meta2.png", "id": "1092284936472364", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/673547970_1092284939805697_3526364396762342131_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AUkbDvqMjf4Q7kNvwHnnaJJ&_nc_oc=AdoF5O95RZwJsR41tCKBmHerIdikCwHd8c-HJ-SG8ZNKSyfR313wqVGRtUe7SLa0YxM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP1tKwK8Ptt_MSxT9j6-PnLwy0p0KpNtls4leVH56iarA&oe=6AC255ED"}, {"file_name": "meta4.png", "id": "3142286362643994", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/596061819_3142286365977327_1372779045116644819_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8s8FmUkhVx8Q7kNvwE6vIfa&_nc_oc=AdoPUiPD4CejsPYKkCvqEbA0Hw2irBix8VRsU4XMo96FPSSHjcxgHLrP_x8WF-EFonU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMhLiBalqmsJWeh53alLNOsn4qp2jhKdHtkgeEjO1_CxA&oe=6AC266D9"}, {"file_name": "meta3.png", "id": "2602336840200861", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491830576_2602336846867527_838210037389357455_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wJFA3ADF2uAQ7kNvwElYyPz&_nc_oc=AdruVvoAfMWc-0gkbq_Psro2J5zKwEVGRlmTaT1Iw07jD4EJy0yebzvoRps0IgxExqM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM_QmTh6CauiMO3pa2b4_VtC-IV1GdKprhkN4KI_wWUDg&oe=6AC262E4"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Atomic Smash Lab", "keywords": ["science", "education", "atomic", "fun", "cool"], "long_description": "# Your living room is now a laboratory.\n\n**Atomic Smash Lab** turns your real space into a holographic chemistry playground. Reach into a floating periodic table of all **118 elements**, pull real atoms into the air, and smash them together to build actual molecules \u2014 water, caffeine, table salt, rust, even uranium hexafluoride.\n\n## What you do\n- **Pull fully-formed atoms** off the table, built to the real Bohr model.\n- **Grab one in each hand and push them together to fuse.** Real chemistry makes a real, named molecule.\n- Everything drifts in zero-gravity \u2014 pinch, spin, and knock atoms around like the coolest desk toy.\n\n## 180+ real molecules\nEach comes with a **fun fact**, from the water covering your planet to the caffeine in your coffee. Collect them all in your **Specimen Cabinet**.\n\n## A lab that sings\nEvery element rings on its own **pentatonic** note, so each molecule you build sounds like a gentle glass-bowl chord.\n\n## Endless challenges\n- **Molecule Lab** \u2014 an ever-growing recipe ladder.\n- **Challenge Mode** \u2014 ten themed, timed gauntlets, from *Kitchen & Flavor* to *Radioactive* and the ultra-hard *Megamolecules*.\n- **Helios**, a friendly helium mascot, teaches you the ropes.\n\n## Built for everyone\nFully **seated and stationary** \u2014 play from your couch, bed, or a classroom desk. Real science under the fun makes it a genuine **teaching tool**.\n\n*Pull an atom. Smash it together. Discover the universe, one molecule at a time.*", "short_description": "A holographic chemistry lab in your living room \u2014 smash atoms into molecules."}]}, "developer_name": "Sam Robison", "developer_privacy_policy_url": "https://sammyr72.github.io/atomic-smash-lab/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Sam Robison", "support_website_url": null, "website_url": "https://sammyr72.github.io/atomic-smash-lab/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1337991362726613"}}]}, "scheduled_offers": {"count": 3, "nodes": [{"status": "PUBLISHED", "id": "2196843237896961"}, {"status": "PUBLISHED", "id": "1198654685776198"}, {"status": "PUBLISHED", "id": "939166712558850"}]}, "baseline_offer": {"id": "2196843237896961"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1790510400, "status": "PUBLISHED", "id": "2196843237896961"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1382983024894113", "version": "1.0.18"}, "id": "1500889764564718", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1258445094014574", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1382983024894113"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1500889764564718"}]}, "change_log": "\"Welcome to Atomic Smash Lab \u2014 our initial release.\n\nStep into a zero-gravity laboratory and build matter with your hands. Pull any of the 118 elements off a holographic periodic table and turn a real atom over in your fingers: a nucleus packed with its true protons and neutrons, electrons humming in their shells. Then bring two together and feel them fuse.\n\nTake on a recipe and the finished molecule appears in your off hand as a ghost \u2014 its real three-dimensional shape, with an empty socket for every atom it still needs. Bring the right element close and its place lights up. Push, and it snaps home.\n\n\u2022 All 118 elements, each built from its actual atomic structure\n\u2022 Grab, lasso, and tractor-beam atoms in free-floating 0G\n\u2022 180+ real molecules, from water and salt to caffeine, adrenaline and penicillin\n\u2022 Build a buckyball \u2014 all 60 carbons, in a true truncated-icosahedron cage\n\u2022 Timed challenges when you want the pressure\n\u2022 A specimen cabinet that shelves everything you discover, lightest to heaviest\n\nThank you for playing. Tell us what you'd like to see next.\"", "created_date": 1790106525, "id": "1382983024894113", "version": "1.0.18", "version_code": 57, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1258445094014574", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1382983024894113"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1500889764564718"}]}, "change_log": "\"Welcome to Atomic Smash Lab \u2014 our initial release.\r\n\r\nStep into a zero-gravity laboratory and build matter with your hands. Pull any of the 118 elements off a holographic periodic table and turn a real atom over in your fingers: a nucleus packed with its true protons and neutrons, electrons humming in their shells. Then bring two together and feel them fuse.\r\n\r\nTake on a recipe and the finished molecule appears in your off hand as a ghost \u2014 its real three-dimensional shape, with an empty socket for every atom it still needs. Bring the right element close and its place lights up. Push, and it snaps home.\r\n\r\n\u2022 All 118 elements, each built from its actual atomic structure\r\n\u2022 Grab, lasso, and tractor-beam atoms in free-floating 0G\r\n\u2022 180+ real molecules, from water and salt to caffeine, adrenaline and penicillin\r\n\u2022 Build a buckyball \u2014 all 60 carbons, in a true truncated-icosahedron cage\r\n\u2022 Timed challenges when you want the pressure\r\n\u2022 A specimen cabinet that shelves everything you discover, lightest to heaviest\r\n\r\nThank you for playing. Tell us what you'd like to see next.\"", "created_date": 1789757700, "id": "1376106088915140", "version": "1.0.17", "version_code": 56, "release_status": "PENDING", "status": "CHANGES_REQUESTED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1258445094014574", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1382983024894113"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1500889764564718"}]}, "change_log": "\"Welcome to Atomic Smash Lab \u2014 our initial release.\r\n\r\nStep into a zero-gravity laboratory and build matter with your hands. Pull any of the 118 elements off a holographic periodic table and turn a real atom over in your fingers: a nucleus packed with its true protons and neutrons, electrons humming in their shells. Then bring two together and feel them fuse.\r\n\r\n\u2022 All 118 elements, each built from its actual atomic structure\r\n\u2022 Grab, lasso, and tractor-beam atoms in free-floating 0G\r\n\u2022 Fuse real chemistry, from water and salt all the way to penicillin\r\n\u2022 A recipe ladder that keeps unlocking as you discover\r\n\u2022 Timed challenges when you want the pressure\r\n\u2022 A specimen cabinet that remembers everything you've ever made\r\n\r\nThank you for playing. Tell us what you'd like to see next.\"", "created_date": 1789746077, "id": "1375828868942862", "version": "1.0.12", "version_code": 51, "release_status": "PENDING", "status": "DRAFT", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1258445094014574", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1382983024894113"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1500889764564718"}]}, "change_log": "\"Welcome to Atomic Smash Lab! This is our first release. \\n \\n What's in the lab: \\n - Mixed reality: a periodic table wall, supply racks and a specimen cabinet appear in your own room using color passthrough. \\n - All 118 elements: build any of them from protons, neutrons and electrons. \\n - The Electron Lasso: aim at a tile or atom from across the room, squeeze the trigger and pull it in. \\n - Smash atoms: grab one atom in each hand and push them together to form covalent bonds. \\n- 188 molecules to collect and show off in your trophy cabinet. \\n- Recipes to chase: 6 active targets, and a harder one appears each time you finish one. \\n - Challenge Mode: pick a category, race the clock and earn stars. \\n - Helios, your lab guide, walks you through the basics in a short tutorial. \\n - Pause anywhere: take the headset off and everything freezes where you left it. \\n \\n This version requires Touch controllers. \\n \\n Found a bug? Report it from the in-game settings menu. Thanks for playing!\"", "created_date": 1789574047, "id": "1372125802646502", "version": "1.0.7", "version_code": 46, "release_status": "PENDING", "status": "CHANGES_REQUESTED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1258445094014574", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1382983024894113"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1500889764564718"}]}, "change_log": "Atomic Smash Lab: Launch Release (v1.0.6)\r\n\r\nWelcome to the lab! Build real chemistry with your hands, right in your room.\r\n\r\nWhat's inside\r\n\r\nA holographic periodic table. All 118 elements, in a menu that wraps around you. Pull out the first ten elements (Hydrogen to Neon) as fully formed atoms, and read about the rest.\r\nSmash atoms into molecules. Grab an atom in each hand and push them together. Real 3D molecule shapes form in front of you, with correct names from water to dinitrogen tetroxide.\r\nMolecule Lab. A recipe board that never runs out. Finish a recipe and a slightly harder one takes its place, with the ingredients you need glowing on the table.\r\nChallenge Mode. Timed quests in six categories: Light & Lively, Heavy Metal, Kitchen & Flavor, Medicine Cabinet, Fuel & Industry, and Radioactive. Faster builds earn more stars, and your best scores are saved.\r\nSpecimen Cabinet. A museum of everything you've built, with 90+ specimens to collect. Reach toward one and it turns into a spinning 3D model. Pull out a copy to use in more chemistry.\r\nElectron Lasso. Point, pull the trigger, and yank to reel in atoms and molecules from across the room.\r\nChemistry you can hear. Each element plays its own note based on its place in the periodic table, and each molecule forms a chord.\r\nMeet Helios. A friendly helium atom walks you through your first build. You can call him back any time from Options.\r\nControls: GRIP to grab, TRIGGER to lasso, STICK to spin, B / Y to discard. Hand tracking works too: swipe to move through menus, pinch to grab and select.\r\n\r\nFound a bug? Go to Options and choose Report Bug to send it from inside your headset.\r\n\r\nA Baglunch Games production, designed and built by Sam Robison.", "created_date": 1789252086, "id": "1365668043292278", "version": "1.0.6", "version_code": 45, "release_status": "PENDING", "status": "CHANGES_REQUESTED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}]}}, "viewer": {"user": null}}}
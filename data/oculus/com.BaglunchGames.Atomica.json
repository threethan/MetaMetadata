: "en_US", "screenshots": [{"file_name": "01-title-card.png", "id": "1495127659082290", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499308026_1495127665748956_1426020550596424914_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4vy_BEoWUUIQ7kNvwHnVTRD&_nc_oc=AdqpIpcxm_--q4M4ByBQUJ9dndZxyodEyFY890W5xNNjhzT05V51dM5JlBZVd1Gp394&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMZxu0fncvcg7IBG56FDIM2Ka2-BiZ8b07O7LqvJVeTdg&oe=6AC25CDD"}, {"file_name": "02-helios-tutorial.png", "id": "2818899021818025", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499300541_2818899025151358_360136140372549368_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k9cgVbiUp8YQ7kNvwE035E2&_nc_oc=AdolJ2k_JngWLCqwVitL91N5mhRwH7vSoidTGPbAjjzypZTcisLQWenrsG9ONT5Eys4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMPbGKjgNfM1gLRQfk0O_Bghlk0xVtUfnXb6a5kL2707A&oe=6AC27592"}, {"file_name": "03-pull-hydrogen.png", "id": "1054661097489532", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499299845_1054661100822865_2270747996044071301_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=22WHo5DMFdQQ7kNvwGh53kv&_nc_oc=AdoFTNAPlsqN8qN34WkEnMzyv2jaJv6yUO5z36WdBhBodrSm7ZICGjZ_kdg7fpcf_Yo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOMCJn7fiPVm2iRdtG4eSpnVLt0qlA6XVy0acEOCQcdbg&oe=6AC25360"}, {"file_name": "06-challenge-mode.png", "id": "1048379037942310", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499314351_1048379041275643_9065269578023189354_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yBAMJQk56jcQ7kNvwHjTZXx&_nc_oc=Adot7xx5SRrG13vAoKjEvP6XOBBnSn7WJY4tJXkzVAe3H3pEaMtuaOdpeoWHlN9si44&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMnVMU0aQ5ivocTBWl_IrWz13mxd-R8LFgNXEwhQXYZxA&oe=6AC26B64"}, {"file_name": "07-specimen-cabinet.png", "id": "1075740994974517", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499310596_1075740998307850_7583973766082183369_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k3r8oHU5WkUQ7kNvwGkgv1Y&_nc_oc=AdpONKxvI7U8BFPK-UYAVLWyYXQOJTSQPt0JeZlF_dQJsq3l0b9fwcqCdPaoBB8gK6o&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNxZE2WiQBrlYrxFeAv3kPv1KAIKmL19keirXFP_aEJ-w&oe=6AC26CE6"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Atomic Smash Lab", "keywords": ["science", "education", "atomic", "fun", "cool"], "long_description": "# Your living room is now a laboratory.\n\n**Atomic Smash Lab** turns your real space into a holographic chemistry playground. Reach into a floating periodic table of all **118 elements**, pull real atoms into the air, and smash them together to build actual molecules \u2014 water, caffeine, table salt, rust, even uranium hexafluoride.\n\n## What you do\n- **Pull fully-formed atoms** off the table, built to the real Bohr model.\n- **Grab one in each hand and push them together to fuse.** Real chemistry makes a real, named molecule.\n- Everything drifts in zero-gravity \u2014 pinch, spin, and knock atoms around like the coolest desk toy.\n\n## 180+ real molecules\nEach comes with a **fun fact**, from the water covering your planet to the caffeine in your coffee. Collect them all in your **Specimen Cabinet**.\n\n## A lab that sings\nEvery element rings on its own **pentatonic** note, so each molecule you build sounds like a gentle glass-bowl chord.\n\n## Endless challenges\n- **Molecule Lab** \u2014 an ever-growing recipe ladder.\n- **Challenge Mode** \u2014 ten themed, timed gauntlets, from *Kitchen & Flavor* to *Radioactive* and the ultra-hard *Megamolecules*.\n- **Helios**, a friendly helium mascot, teaches you the ropes.\n\n## Built for everyone\nFully **seated and stationary** \u2014 play from your couch, bed, or a classroom desk. Real science under the fun makes it a genuine **teaching tool**.\n\n*Pull an atom. Smash it together. Discover the universe, one molecule at a time.*", "short_description": "A holographic chemistry lab in your living room \u2014 smash atoms into molecules."}]}, "developer_name": "Sam Robison", "developer_privacy_policy_url": "https://sammyr72.github.io/atomic-smash-lab/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Sam Robison", "support_website_url": null, "website_url": "https://sammyr72.github.io/atomic-smash-lab/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1382974134895002"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499311585_1710804086629177_5333242497170912486_n.png?stp=dst-png_s360x360&_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JkBCYZ_WF74Q7kNvwFeT73p&_nc_oc=AdovJRBN-BYzcjco7-g3hi8aamXK9vK3EwAfJWL83rzzVG8HKDHK3mJCUsgh-DiWY94&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQORMYHf_iJGctpmTNMgp2uhDk6YRvdGsXcvPsyMkVZiQQ&oe=6AC25395"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Atomic Smash Lab", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_name": "Learning", "id": "1043107547362485"}], "release_date": 1790510400, "lastRevision": {"nodes": [{"id": "1258445107347906", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "1258445094014574", "is_f
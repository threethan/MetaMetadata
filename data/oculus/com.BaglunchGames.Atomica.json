96424914_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qrd5y9q3O1sQ7kNvwFhPiEK&_nc_oc=AdpR72rwnvUSD8tP-ZgKv6kTrR2Dvm6bHVz2DToRqtoEC1z6-56weMxP0Py_EnA83qU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT3BaekXmH2A4A1EiwxuwNP5rDTx__lKjHleiyExmbjpA&oe=6B00535D"}, {"file_name": "02-helios-tutorial.png", "id": "2818899021818025", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499300541_2818899025151358_360136140372549368_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EEtiYhq2HVEQ7kNvwFmJ7ib&_nc_oc=AdqbgIzeH-RiT8E5V8TZAXw9K2oII2x579liGnKrwtMt0mQa3viuIFex-bk2vLnYrmw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQEiXJkyzFcFD9PRQ0ZdicvAWhbwm6QryRm_rnAVFOltw&oe=6B006C12"}, {"file_name": "03-pull-hydrogen.png", "id": "1054661097489532", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499299845_1054661100822865_2270747996044071301_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PHNc9Ft68hYQ7kNvwEXMT7-&_nc_oc=AdqG6pjeK7oj-ddl6vNwLKoX3qUXxXbHW62hx6TEEfEk6dMMVYihcm9v1Hn8Gn86NFo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSgCQsw6K5jyuIDklfMcD0sIbcHfd_R1Lg4VpvznIdBDA&oe=6B008220"}, {"file_name": "06-challenge-mode.png", "id": "1048379037942310", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499314351_1048379041275643_9065269578023189354_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Gb5EtDgWSXoQ7kNvwH5tVEB&_nc_oc=AdrL1rHEtwx93LiF5ZjR5ZNOE3m-LOYltnSDQqbRUCkD9c1Klwbn_HJAjn0aqeOcNw8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSM3iqlkz2AYVinNNpp1M0a3Au2w5E01D-rUn_U2d3P5A&oe=6B0061E4"}, {"file_name": "07-specimen-cabinet.png", "id": "1075740994974517", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499310596_1075740998307850_7583973766082183369_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QezhUlqYrrUQ7kNvwGDg70R&_nc_oc=Adr5--n3BHfG-hTm1vASbdZ0RHuPpKNomfIXbnV9z6tKprIurzLS0L7sexSIqia6XPU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT2XsWMMsXcYvyc-sg1CyTJCRFI4d7hZSZcHB_hE-kF9g&oe=6B006366"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Atomic_Smash_Lab_Poster_4K.png", "id": "949676024883577", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/673652249_949676028216910_691829145299184120_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IdVunYbtkm8Q7kNvwEhX-bJ&_nc_oc=AdqxfG88CWZqCYmlHAzYHyJq8VdW4D_j85Y2yPe5Dc4GNoLOiAqN80zT7wCC2xKoMIE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR5-jBFtgEj75I1Nk5MDEdS-6I4X1_v52s5Vuw_x1Gs3A&oe=6B007A40"}, "display_name": "Atomic Smash Lab", "keywords": ["science", "education", "atomic", "fun", "cool"], "long_description": "# Your living room is now a laboratory.\n\n**Atomic Smash Lab** turns your real space into a holographic chemistry playground. Reach into a floating periodic table of all **118 elements**, pull real atoms into the air, and smash them together to build actual molecules \u2014 water, caffeine, table salt, rust, even uranium hexafluoride.\n\n## What you do\n- **Pull fully-formed atoms** off the table, built to the real Bohr model.\n- **Grab one in each hand and push them together to fuse.** Real chemistry makes a real, named molecule.\n- Everything drifts in zero-gravity \u2014 pinch, spin, and knock atoms around like the coolest desk toy.\n\n## 180+ real molecules\nEach comes with a **fun fact**, from the water covering your planet to the caffeine in your coffee. Collect them all in your **Specimen Cabinet**.\n\n## A lab that sings\nEvery element rings on its own **pentatonic** note, so each molecule you build sounds like a gentle glass-bowl chord.\n\n## Endless challenges\n- **Molecule Lab** \u2014 an ever-growing recipe ladder.\n- **Challenge Mode** \u2014 ten themed, timed gauntlets, from *Kitchen & Flavor* to *Radioactive* and the ultra-hard *Megamolecules*.\n- **Helios**, a friendly helium mascot, teaches you the ropes.\n\n## Built for everyone\nFully **seated and stationary** \u2014 play from your couch, bed, or a classroom desk. Real science under the fun makes it a genuine **teaching tool**.\n\n*Pull an atom. Smash it together. Discover the universe, one molecule at a time.*", "short_description": "A holographic chemistry lab in your living room \u2014 smash atoms into molecules."}]}, "developer_name": "Sam Robison", "developer_privacy_policy_url": "https://sammyr72.github.io/atomic-smash-lab/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Sam Robison", "support_website_url": null, "website_url": "https://sammyr72.github.io/atomic-smash-lab/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1392709163921499"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499311585_1710804086629177_5333242497170912486_n.png?stp=dst-png_s360x360&_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vThznWX5xFYQ7kNvwGgUXW7&_nc_oc=AdqLfdYoQMm4zGSwG7l_9cJHxXe7Kd8vb_gWudoi_FYZ615yWgpeyXCWq7u5b4Q3dto&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTgAOVt5Hko-jhhyE3iLeGbDzDqq91h83uPEMXqlW8mIA&oe=6B008255"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_
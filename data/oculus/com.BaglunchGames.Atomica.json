_kQ7kNvwFJEAuq&_nc_oc=Adr9x5_viObhJ5w83_fa6bFzLbLn37ESTRxsFJ-frH8zRa9tagPdLa_cl7EGFDemxj8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRjVO2BpSq-JO7WJD1l_nd4oEd9tDxCbuAh9gwGLmXhFg&oe=6B0084AD"}, {"file_name": "meta4.png", "id": "3142286362643994", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/596061819_3142286365977327_1372779045116644819_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4s3qc6DaxB8Q7kNvwFtEr0F&_nc_oc=AdrzyHw0A8jW75COxCoTn2YsVwqvCIFXdqecY6222130AacDuDS_M5CRyu-YdiHFesg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTdxlVuyHG0rkJ96U3rJ2l0T7ur0DhTlCCK7F-FWTW2RQ&oe=6B005D59"}, {"file_name": "meta3.png", "id": "2602336840200861", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491830576_2602336846867527_838210037389357455_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GdJo5hPDg_oQ7kNvwHnxn5z&_nc_oc=Adq7nhxwLvBx7y6qOfnjsONmFJ0H5nzjbIB9j-cnucR-TsA40UTd5iPh7Gi3q9LUYks&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRhIkGNde7HQlMH_LBLwfmqB59cvsQq4Z86SYYJUf7ugw&oe=6B005964"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Atomic Smash Lab", "keywords": ["science", "education", "atomic", "fun", "cool"], "long_description": "# Your living room is now a laboratory.\n\n**Atomic Smash Lab** turns your real space into a holographic chemistry playground. Reach into a floating periodic table of all **118 elements**, pull real atoms into the air, and smash them together to build actual molecules \u2014 water, caffeine, table salt, rust, even uranium hexafluoride.\n\n## What you do\n- **Pull fully-formed atoms** off the table, built to the real Bohr model.\n- **Grab one in each hand and push them together to fuse.** Real chemistry makes a real, named molecule.\n- Everything drifts in zero-gravity \u2014 pinch, spin, and knock atoms around like the coolest desk toy.\n\n## 180+ real molecules\nEach comes with a **fun fact**, from the water covering your planet to the caffeine in your coffee. Collect them all in your **Specimen Cabinet**.\n\n## A lab that sings\nEvery element rings on its own **pentatonic** note, so each molecule you build sounds like a gentle glass-bowl chord.\n\n## Endless challenges\n- **Molecule Lab** \u2014 an ever-growing recipe ladder.\n- **Challenge Mode** \u2014 ten themed, timed gauntlets, from *Kitchen & Flavor* to *Radioactive* and the ultra-hard *Megamolecules*.\n- **Helios**, a friendly helium mascot, teaches you the ropes.\n\n## Built for everyone\nFully **seated and stationary** \u2014 play from your couch, bed, or a classroom desk. Real science under the fun makes it a genuine **teaching tool**.\n\n*Pull an atom. Smash it together. Discover the universe, one molecule at a time.*", "short_description": "A holographic chemistry lab in your living room \u2014 smash atoms into molecules."}]}, "developer_name": "Sam Robison", "developer_privacy_policy_url": "https://sammyr72.github.io/atomic-smash-lab/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Sam Robison", "support_website_url": null, "website_url": "https://sammyr72.github.io/atomic-smash-lab/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1337991362726613"}}]}, "scheduled_offers": {"count": 3, "nodes": [{"status": "PUBLISHED", "id": "2
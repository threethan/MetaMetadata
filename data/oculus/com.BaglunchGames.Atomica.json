eEQ7kNvwFura9P&_nc_oc=AdrHXv8Q362luNmQirPgYtj2WMqLEJlx7afyOWTkJPi0qdvlrtv-e7_OeQChU1G08f4&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQPflQM5kBJQZshrMYxsHMzqIaQqW9tLAyl5nwj3yMtXg&oe=6B086DAD"}, {"file_name": "meta4.png", "id": "3142286362643994", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/596061819_3142286365977327_1372779045116644819_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nzKLN3iPxKIQ7kNvwFGvi7s&_nc_oc=AdoiAdvPaF-hIxEBSWesqNfHTVw8anX0RjgtwbWmpPyd1aY2NIAkJX27bZIAuVOXtGI&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSHsc-_L2wSVkFO8JaHTkt4RCOZeGBtcDUMuI38eJdP1g&oe=6B084659"}, {"file_name": "meta3.png", "id": "2602336840200861", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/491830576_2602336846867527_838210037389357455_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bQAxc8nTFpIQ7kNvwGmvqEk&_nc_oc=Adrh0VnWqBweOGykau9cPacvrNUgOW3Watsugy9_NSVlZtgXYfyWWOdu5ejxoF25Rtg&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRWuOv01ktRCjvOCdQhNm4SZDATmr46kN75hGCSXbnzjQ&oe=6B084264"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Atomic Smash Lab", "keywords": ["science", "education", "atomic", "fun", "cool"], "long_description": "# Your living room is now a laboratory.\n\n**Atomic Smash Lab** turns your real space into a holographic chemistry playground. Reach into a floating periodic table of all **118 elements**, pull real atoms into the air, and smash them together to build actual molecules \u2014 water, caffeine, table salt, rust, even uranium hexafluoride.\n\n## What you do\n- **Pull fully-formed atoms** off the table, built to the real Bohr model.\n- **Grab one in each hand and push them together to fuse.** Real chemistry makes a real, named molecule.\n- Everything drifts in zero-gravity \u2014 pinch, spin, and knock atoms around like the coolest desk toy.\n\n## 180+ real molecules\nEach comes with a **fun fact**, from the water covering your planet to the caffeine in your coffee. Collect them all in your **Specimen Cabinet**.\n\n## A lab that sings\nEvery element rings on its own **pentatonic** note, so each molecule you build sounds like a gentle glass-bowl chord.\n\n## Endless challenges\n- **Molecule Lab** \u2014 an ever-growing recipe ladder.\n- **Challenge Mode** \u2014 ten themed, timed gauntlets, from *Kitchen & Flavor* to *Radioactive* and the ultra-hard *Megamolecules*.\n- **Helios**, a friendly helium mascot, teaches you the ropes.\n\n## Built for everyone\nFully **seated and stationary** \u2014 play from your couch, bed, or a classroom desk. Real science under the fun makes it a genuine **teaching tool**.\n\n*Pull an atom. Smash it together. Discover the universe, one molecule at a time.*", "short_description": "A holographic chemistry lab in your living room \u2014 smash atoms into molecules."}]}, "developer_name": "Sam Robison", "developer_privacy_policy_url": "https://sammyr72.github.io/atomic-smash-lab/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Sam Robison", "support_website_url": null, "website_url": "https://sammyr72.github.io/atomic-smash-lab/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1337991362726613"}}]}, "scheduled_offers": {"count": 3, "nodes": [{"status": "PUBLISHED", "id": "2196843237896961"}, {"status": "PUBLISHED", "id": "1198654685776198"}, {"status": "PUBLISHED", "id": "939166712558850"}]}, "baseline_offer": {"id": "2196843237896961"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1790510400, "status": "PUBLISHED", "id": "2196843237896961"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1499141526611595", "version": "1.0.30"}, "id": "1500889764564718", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1258445094014574", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1499141526611595"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1500889764564718"}]}, "change_log": "1.0.30 (build 69) \u2014 In tune\r\nShort version (for the \"What's new\" box)\r\nIn tune. The atoms now sing in the key of whatever the glass armonica is playing, and their chimes and hums have a fuller, shimmering glass voice.\r\n\r\nChanges\r\nIn the music's key. Chimes are struck in the key of the piece that is playing, following it as it modulates. Hums already floating glide to the new key.\r\nA fuller voice. Chimes shimmer, bloom after the strike and ring in a small hall; low notes have more body; hums slowly turn between round and glassy.\r\nWith music off, the atoms drift between keys by themselves, as before.", "created_date": 1794847981, "id": "1499141526611595", "version": "1.0.30", "version_code": 69, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application":
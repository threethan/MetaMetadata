_kQ7kNvwE2WtKk&_nc_oc=AdrfW5ipY1HhUOaK1c4L6EKm3HvZtCK5xHX0_tmMY9MIpXgE3VW6O-Ev6k9zA8OG1cQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTEmMMim84v4KTETU_E4Y0sMZ6ZxdtfkSVKwXCyI7BwuQ&oe=6AFDE1AD"}, {"file_name": "meta4.png", "id": "3142286362643994", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/596061819_3142286365977327_1372779045116644819_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4s3qc6DaxB8Q7kNvwGXC0Gw&_nc_oc=Adr-JcTOaM6DOPkbSxuW3b1YSe0sdzSiJb1l531At0nmQ6kWVKWJxYz1MiWsZTfCkzg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRFDcOafumV7rfvbHPA_NduXiPtSRsYDuHQ4ET8x48_Ow&oe=6AFDBA59"}, {"file_name": "meta3.png", "id": "2602336840200861", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491830576_2602336846867527_838210037389357455_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hUtvtDUSOtEQ7kNvwGWx419&_nc_oc=AdoPlzE0fkad-VfLbxXJPEYjoJNsCFR7IMXh8IwgJvr4oezieJb1Eui01N5nhcK4SEs&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQidv2VaI1WNw0YiuiNN_BVmDHxlu9hMA3HDNMJ1MQmNg&oe=6AFDB664"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Atomic Smash Lab", "keywords": ["science", "education", "atomic", "fun", "cool"], "long_description": "# Your living room is now a laboratory.\n\n**Atomic Smash Lab** turns your real space into a holographic chemistry playground. Reach into a floating periodic table of all **118 elements**, pull real atoms into the air, and smash them together to build actual molecules \u2014 water, caffeine, table salt, rust, even uranium hexafluoride.\n\n## What you do\n- **Pull fully-formed atoms** off the table, built to the real Bohr model.\n- **Grab one in each hand and push them together to fuse.** Real chemistry makes a real, named molecule.\n- Everything drifts in zero-gravity \u2014 pinch, spin, and knock atoms around like the coolest desk toy.\n\n## 180+ real molecules\nEach comes with a **fun fact**, from the water covering your planet to the caffeine in your coffee. Collect them all in your **Specimen Cabinet**.\n\n## A lab that sings\nEvery element rings on its own **pentatonic** note, so each molecule you build sounds like a gentle glass-bowl chord.\n\n## Endless challenges\n- **Molecule Lab** \u2014 an ever-growing recipe ladder.\n- **Challenge Mode** \u2014 ten themed, timed gauntlets, from *Kitchen & Flavor* to *Radioactive* and the ultra-hard *Megamolecules*.\n- **Helios**, a friendly helium mascot, teaches you the ropes.\n\n## Built for everyone\nFully **seated and stationary** \u2014 play from your couch, bed, or a classroom desk. Real science under the fun makes it a genuine **teaching tool**.\n\n*Pull an atom. Smash it together. Discover the universe, one molecule at a time.*", "short_description": "A holographic chemistry lab in your living room \u2014 smash atoms into molecules."}]}, "developer_name": "Sam Robison", "developer_privacy_policy_url": "https://sammyr72.github.io/atomic-smash-lab/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Sam Robison", "support_website_url": null, "website_url": "https://sammyr72.github.io/atomic-smash-lab/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1337991362726613"}}]}, "scheduled_offers": {"count": 3, "nodes": [{"status": "PUBLISHED", "id": "2
96424914_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=db33AMSQAakQ7kNvwEsF3wP&_nc_oc=AdobnTJj4alJIEbgd71NBHtvkb0AmD0XgejLhJsWnXxzDqmyMjkUPhN-eR2c40wqt2g&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT1bkiJRB2u6NqkqWQiirRBH7Wk52AyCEQmWsHS1fF4FQ&oe=6AFC971D"}, {"file_name": "02-helios-tutorial.png", "id": "2818899021818025", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/499300541_2818899025151358_360136140372549368_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=netNSukgEJ0Q7kNvwET2AnV&_nc_oc=Adq0wJAOJ_FRAr-Tet1ygngvLXECeC99W7Z4PhKRwLhdBp9DHVj8ohu_yj--6Z0QFIM&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR7Lu03XcH0227XSCRIF-1RNA7OQR7VhoVMDF6aFEGEvQ&oe=6AFC7792"}, {"file_name": "03-pull-hydrogen.png", "id": "1054661097489532", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499299845_1054661100822865_2270747996044071301_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1GvrAUiX-6MQ7kNvwFRDgRY&_nc_oc=AdpzSZgF7Kycnm0VTUe8rG54iRpl-mE9qoYcgWyboNas5AmT3ssaXdEdTfHZfoR1Uao&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTz1-HunYx23C3n5ftvwqmUtbcQKacW1XpGv3mhVnJxEg&oe=6AFC8DA0"}, {"file_name": "06-challenge-mode.png", "id": "1048379037942310", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499314351_1048379041275643_9065269578023189354_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GAasKsVeAJ0Q7kNvwEWMRMo&_nc_oc=AdpdVYnkK0wT137LvGWfXF7AdOeesr29aVxgRfJcHmPPHPVN0yuSBN_jHO7EKYw-EGE&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR3U2Wqh1dYJhZV-E1A3b57_yzZkzd3IdSesZDmkIfL4Q&oe=6AFC6D64"}, {"file_name": "07-specimen-cabinet.png", "id": "1075740994974517", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499310596_1075740998307850_7583973766082183369_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=grbNCFNinLAQ7kNvwH2BqYN&_nc_oc=Adoycnf7oauexcdqiyht5Zrouv79lq5tbBwJ5fQvRx2_GwWyJ5tWnzg0b9bKkgFS3XI&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRfpNZY_O93VkZzYegW84l7QtQpbKVw0P8xH1LNlSEmNg&oe=6AFC6EE6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Atomic_Smash_Lab_Poster_4K.png", "id": "949676024883577", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/673652249_949676028216910_691829145299184120_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e30u1ezxsHIQ7kNvwHGClSc&_nc_oc=AdoVVxtxT3fMRaFl8bekJAVTNqngMRr2WIwHBmGXXWBNYUy51RuKZUEFsu4UKwDpnoI&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR_vAKXirvy74nMIg09eSAZeyNMiy2zCE2j8Bv_ppMy5A&oe=6AFC85C0"}, "display_name": "Atomic Smash Lab", "keywords": ["science", "education", "atomic", "fun", "cool"], "long_description": "# Your living room is now a laboratory.\n\n**Atomic Smash Lab** turns your real space into a holographic chemistry playground. Reach into a floating periodic table of all **118 elements**, pull real atoms into the air, and smash them together to build actual molecules \u2014 water, caffeine, table salt, rust, even uranium hexafluoride.\n\n## What you do\n- **Pull fully-formed atoms** off the table, built to the real Bohr model.\n- **Grab one in each hand and push them together to fuse.** Real chemistry makes a real, named molecule.\n- Everything drifts in zero-gravity \u2014 pinch, spin, and knock atoms around like the coolest desk toy.\n\n## 180+ real molecules\nEach comes with a **fun fact**, from the water covering your planet to the caffeine in your coffee. Collect them all in your **Specimen Cabinet**.\n\n## A lab that sings\nEvery element rings on its own **pentatonic** note, so each molecule you build sounds like a gentle glass-bowl chord.\n\n## Endless challenges\n- **Molecule Lab** \u2014 an ever-growing recipe ladder.\n- **Challenge Mode** \u2014 ten themed, timed gauntlets, from *Kitchen & Flavor* to *Radioactive* and the ultra-hard *Megamolecules*.\n- **Helios**, a friendly helium mascot, teaches you the ropes.\n\n## Built for everyone\nFully **seated and stationary** \u2014 play from your couch, bed, or a classroom desk. Real science under the fun makes it a genuine **teaching tool**.\n\n*Pull an atom. Smash it together. Discover the universe, one molecule at a time.*", "short_description": "A holographic chemistry lab in your living room \u2014 smash atoms into molecules."}]}, "developer_name": "Sam Robison", "developer_privacy_policy_url": "https://sammyr72.github.io/atomic-smash-lab/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Sam Robison", "support_website_url": null, "website_url": "https://sammyr72.github.io/atomic-smash-lab/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1392709163921499"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499311585_1710804086629177_5333242497170912486_n.png?stp=dst-png_s360x360&_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DW1luCDVVnUQ7kNvwF959BJ&_nc_oc=AdpBvwHsZ-Uuv2-LiqPEvwiZEEHgPGYvxREQAdTY-kzKH8E6cwARJocgdyHsJF2JBdM&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRTSBTIrx00xUH_XpMup6EhsPGtk8TQuhiFFGgPz_mvpw&oe=6AFC8DD5"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_
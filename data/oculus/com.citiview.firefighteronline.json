/v/t64.5771-25/595129854_1802697357430161_6023157026756989066_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7U2oSK08C9EQ7kNvwGHGKj1&_nc_oc=AdpPkZ88VSLnmlcFx6xd8yeOMUF453gmM6ZPxKO1fVKUpLkpuAsckeVdtCzcud3qeA0&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSFhPGIkBPweXkNNrPJBKeibQCLdULXae-Cic5nDuhDtA&oe=6AFC8D2D"}, {"file_name": "screenshot_1.png", "id": "2739927733072297", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/673645340_2739927736405630_7342375038248027283_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=86_onJ8yTO0Q7kNvwH53chG&_nc_oc=Adq07Cyc8ZQZVk8RerFltqNM9jVDvf2Um4E-yr3o5d0OnQXe2H17lAf_e_JaiOrz5iM&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQdimWAeNiqBHWxzgNjQv6pXu7m5l1PSi0S4t_5VEvurg&oe=6AFC70ED"}, {"file_name": "screenshot_4.png", "id": "1618962646405939", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/595129854_1618962649739272_1457805708767855297_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mNxTb2hwTA0Q7kNvwFH6G2D&_nc_oc=AdqF307Bfk_BnL_qW2lqlmiI2akMs3IjwLwBWZ7PjIw66YZ1BH4mIEA0d-DGOUiqFCw&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSzV0l1oNaX1h6PcQvlB1E7tx-_46RveijqrQyIh0H08g&oe=6AFC9279"}, {"file_name": "screenshot_5.png", "id": "1726508189479608", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/596106838_1726508192812941_3940384275291150932_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0o2Rgw6nWrgQ7kNvwHUcplP&_nc_oc=AdqcuGABVoDEN39FxYnlJkWMum7MTQOYJs_-Lo3GC_104uh9WcX29Da-cpMjOgAUfR4&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSRIAf0eZaT9qmjM8TOYy7wMiDLUbdH_cDgNs5c_yNdpQ&oe=6AFC65C7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_cover_2560x1440.png", "id": "2939219539790177", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/604375581_2939219543123510_8526449746743365169_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KjRUReC_BcMQ7kNvwE-_YpR&_nc_oc=AdovWPoL2AjvhcVaSY3CpPia3k2Mb9GCd6fNBieAvfkAg7YQfYHvoO6u_n07oqLjnmE&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRK5oEjj42hm-8l_Thw6N-dDaaPMnzR97hiNY-rU9IFFw&oe=6AFC761F"}, "display_name": "Firefighter Online", "keywords": ["firefighter", "multiplayer", "simulation", "rescue", "cooperative"], "long_description": "Firefighter Online puts the whole of Firefighter Simulator on one crew.\n\nFIGHT FIRES TOGETHER\nEvery fire and every boarded door is shared. Two hoses knock a blaze down twice as fast, and it goes out on everyone's headset at the same moment. Chop through a boarded door and it is open for the whole crew.\n\nA REAL CREW\nEveryone else on the call is a firefighter in full turnout gear with breathing apparatus, their own helmet colour and their number overhead. You see and hear their nozzle - the stream, the fog, the hiss, the hose dragging back to the pump.\n\nTWENTY CALLS\nThe Engine House, Midnight Alley, the Grand Atrium, a smoke-filled house, a subway, a cold store, a church, an office, a tank farm, an engine room, a tower block, a car park, a club, a night ward, a school, a barn, a dock, a theatre, a road tunnel and a paper mill. The host picks the call and the crew rolls out together.\n\nONE BUTTON TO PLAY\nPress B and choose QUICK JOIN, or PRIVATE STATION for a 4-digit code your friends type in. REGROUP puts you beside your crew. Voice chat is optional and off by default. Mute, block or report anyone from the Crew list.\n\nPlay solo whenever you like - the station is yours the moment the game loads.\n\nControls: right trigger water, A stream / fog, left hand axe, MENU calls, B online menu.", "short_description": "Fight real fires with a real crew. Twenty calls from Firefighter Simulator - tunnels, theatres, towers, a paper mill - now played together: the fires are shared, so two hoses knock a blaze down twice as fast. Quick Join finds a crew in seconds, or open a private station for friends with a 4-digit code. Play solo any time."}]}, "developer_name": null, "developer_privacy_policy_url": "https://citiview-games.pages.dev/firefighteronline/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Citiview Studios", "support_website_url": null, "website_url": "https://citiview-games.pages.dev/firefighteronline/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1341869389005924"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/596061819_2195430404350170_7029088921721206779_n.png?stp=dst-png_s360x360&_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JH_dQlckqxAQ7kNvwGHcvea&_nc_oc=AdoxtD58-drg6Sm-0JGXYHsWqnyKAr7JLzmu9CGNkW118iVIQLvSSebbCi5J98h2jVk&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQi_iVVbzY3MxJNrZvDiAp_PzRF_Cb7kBEnrrUS9H9wVw&oe=6AFC688F"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Firefighter Online", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Simulation", "id": "331529188132278"}], "release_date": 1790687040, "lastRevision": {"nodes": [{"id": "1341869395672590", "release_type": "SCHEDULED", "administration_status": "APPRO
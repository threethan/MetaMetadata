v8hNjiFG35r4Ky-_9Y0JU48GF2cASQ&oe=6B0B3FBB"}, {"file_name": "image-2560x1440 (1).png", "id": "1159123811893787", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974482_1159123815227120_5027545272939608262_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9S_CdwObCjIQ7kNvwFC5k9l&_nc_oc=AdojJ_7kiJ5cRXnwvT7gEP3xJwmrf8wJzLlfOTbx6El90rp7z_NeUusnH6AkjJKfFhs&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSprxjhuTqqaEhKHeucm4hG7AIbH2ffJRadsiS95MMxRQ&oe=6B0B3A79"}, {"file_name": "image-2560x1440 (1).png", "id": "1031658652038029", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/57568677_1031658655371362_3526120158726678189_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TJBogiYVxFkQ7kNvwHAP5Xu&_nc_oc=AdpBBllaPQO3eY2UqyjAfX6GeNNNwZ6R7MV3YO57ExlqO7iBaX7hbE1EOuKn6Sxq1xU&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSSXPV97Tv-W-0sSJk98MqXsv8khdwHPnIaWA0YHG18BA&oe=6B0B3C89"}, {"file_name": "image-2560x1440 (1).png", "id": "2125534927846521", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/65395359_2125534931179854_4817256747704764355_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vSAp_OSZozQQ7kNvwGQXFO2&_nc_oc=AdpRPjIOrHmNvB0qOPyUPkUYn05XUQbf2xBSPkmmWLT_K9vzrTmbRTQmzcwpNhr-KCM&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRj3In3Cf09uhh394X20CcHpCAYFF9NmO9RkRQ8QD1uRg&oe=6B0B28F9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "image-2560x1440.png", "id": "811892977466542", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39035401_811892980799875_7740895787897875644_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WrdVJVK7PkoQ7kNvwEDEoOA&_nc_oc=AdrQq7RDKIpZgs7O6W5Y5IEh0W-ISAzSNwNExBnRemg69HE86A1aueN6l4YcDZ4tj7Y&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTYu-cTZSiDgIWBFqmsXU4hhMIGstu4R9eNWLFx4ti_-Q&oe=6B0B30FB"}, "display_name": "Scary Spot", "keywords": [], "long_description": "\n\"Scary Spot: The GorillaTag Nightmare\" plunges players into a chilling alternate reality where the beloved VR game takes a terrifying turn. In this spine-tingling fan game, darkness shrouds every corner as you navigate through eerie environments filled with whispers of the unknown.\n\nThe once lively arenas of GorillaTag are now transformed into haunted battlegrounds, where fear lurks in every shadow. As you sprint and leap through the darkness, you're not alone. Sinister forces, unseen and relentless, stalk your every move. Their presence is felt through unsettling sounds and glimpses of their malevolent forms darting just beyond sight.\n\nTo survive the nightmarish ordeal, players must rely on their wits and reflexes as they evade the relentless pursuit of the unknown entities. But beware - the line between reality and nightmare blurs, and the game's rules may change at any moment, trapping players in a twisted labyrinth of horror.\n\n\"Scary Spot\" delivers an immersive horror experience, blending the adrenaline-fueled action of GorillaTag with the tension and terror of a survival horror game. Will you emerge victorious from the darkness, or become just another victim of the Scary Spot's chilling grasp?", "short_description": "Horror game (:"}]}, "developer_name": null, "developer_privacy_policy_url": "https://scaryspot.w3spaces.com/Tos/Tos.html", "developer_terms_of_service_url": null, "publisher_name": "Scary Spot", "support_website_url": null, "website_url": "https://scaryspot.w3spaces.com/Tos/Tos.html", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended
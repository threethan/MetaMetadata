png", "id": "1159123811893787", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974482_1159123815227120_5027545272939608262_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tJVFLmWI4_gQ7kNvwF1rAkH&_nc_oc=Adpgr9cRsM35uoGsNBrxh0yepOyUh4F0Pda7j959Z1VieSsqTG5mEHGOS06YAmeKOPE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRMSqUvvq9m9Uf0F2ExH97qzSNJ512YvzCjELUK24gwOg&oe=6B0DA539"}, {"file_name": "image-2560x1440 (1).png", "id": "1031658652038029", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/57568677_1031658655371362_3526120158726678189_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vnzvw_DEJNIQ7kNvwEcybKa&_nc_oc=AdrSVAuGxmRCmZUFE_umo0M3sMR0mcPSKeO-pt2LdpErJZaYH5z5AYJl5aZmHzy1enk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSqN5n5dqh6ZCpfYzb3S9Aj7PRVEruE6c4pqMtcikxFTg&oe=6B0DA749"}, {"file_name": "image-2560x1440 (1).png", "id": "2125534927846521", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/65395359_2125534931179854_4817256747704764355_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vLGdkrt7mrIQ7kNvwHdxcZb&_nc_oc=AdoUIdLy1QylLxQWEAmPNgZQPw2RqC4tAq-dOdxagTbxjKHKS7lQ0WqxlkMWn81V_cU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRqYwI0pUoCDMEKXRcTEs5RUDmH58InqRE9-PBxLbbOIg&oe=6B0DCBF9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "image-2560x1440.png", "id": "811892977466542", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39035401_811892980799875_7740895787897875644_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WrdVJVK7PkoQ7kNvwFtxkhz&_nc_oc=AdoOd-d4TxVmpLnpm7l87IEmeL5eYscyl157wDxUaIkAHCiktf37ZLcG9b14V9CFY2s&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTgfcCHRyB1cF6tU8CSral_nQpcsbHj9h9TnbgaOKS3ww&oe=6B0D9BBB"}, "display_name": "Scary Spot", "keywords": [], "long_description": "\n\"Scary Spot: The GorillaTag Nightmare\" plunges players into a chilling alternate reality where the beloved VR game takes a terrifying turn. In this spine-tingling fan game, darkness shrouds every corner as you navigate through eerie environments filled with whispers of the unknown.\n\nThe once lively arenas of GorillaTag are now transformed into haunted battlegrounds, where fear lurks in every shadow. As you sprint and leap through the darkness, you're not alone. Sinister forces, unseen and relentless, stalk your every move. Their presence is felt through unsettling sounds and glimpses of their malevolent forms darting just beyond sight.\n\nTo survive the nightmarish ordeal, players must rely on their wits and reflexes as they evade the relentless pursuit of the unknown entities. But beware - the line between reality and nightmare blurs, and the game's rules may change at any moment, trapping players in a twisted labyrinth of horror.\n\n\"Scary Spot\" delivers an immersive horror experience, blending the adrenaline-fueled action of GorillaTag with the tension and terror of a survival horror game. Will you emerge victorious from the darkness, or become just another victim of the Scary Spot's chilling grasp?", "short_description": "Horror game (:"}]}, "developer_name": null, "developer_privacy_policy_url": "https://scaryspot.w3spaces.com/Tos.html", "developer_terms_of_service_url": null, "publisher_name": "Scary Spot", "support_website_url": null, "website_url": "https://scaryspot.w3spaces.com/Tos.html", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "da"], "supported_input_devices":
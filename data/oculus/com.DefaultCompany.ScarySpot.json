png", "id": "1159123811893787", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974482_1159123815227120_5027545272939608262_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5sIIHHjjuaYQ7kNvwHtnyfX&_nc_oc=Adq0s-XJV6Lmode9hC5wZQdkjRQq0bGPV7e9DHRCRTn2sUJzueHP_Df01pyNBRTSDDc&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRe3lwg_1lHPZslqaWg06qUIVgtExGthNNamcpuZsphbg&oe=6B031939"}, {"file_name": "image-2560x1440 (1).png", "id": "1031658652038029", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/57568677_1031658655371362_3526120158726678189_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Xxc0wAfAb8IQ7kNvwGQIVXs&_nc_oc=Adpn4pqsBqkng7t4CxXW0sSvxtD93995toJWBXlOGD0b4UIqQaImdZi2YlvH_c-4W20&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR_DsKQ7GOLt02qm22LjrR5SsL81ayu8UpmMb6WSV3Ggg&oe=6B031B49"}, {"file_name": "image-2560x1440 (1).png", "id": "2125534927846521", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/65395359_2125534931179854_4817256747704764355_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CJMyzm2IPNMQ7kNvwH4mJCj&_nc_oc=AdriE8iTBkPK3hP-9Qlg7Asm3XwRSyu-Wff0-RYu7BoyG9UcDbR7Zre27zNu_5lYiKs&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTW4PLoQAtqSxgBzuSeVkgguHrKrj24Nf7VNgNKd41u0Q&oe=6B0307B9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "image-2560x1440.png", "id": "811892977466542", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39035401_811892980799875_7740895787897875644_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QBNiB3-Gw90Q7kNvwHdHebZ&_nc_oc=AdpQNHUy3S6ffQHfQQcxFpOA4vCXj2xBVgwn3TnGqQcc5HnSys-EXPKHhkYqwkHg0Ts&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQIhw-zWKplKvHoRIM9hpyGBJSiTOWCIxPAuMn1IPFcvA&oe=6B030FBB"}, "display_name": "Scary Spot", "keywords": [], "long_description": "\n\"Scary Spot: The GorillaTag Nightmare\" plunges players into a chilling alternate reality where the beloved VR game takes a terrifying turn. In this spine-tingling fan game, darkness shrouds every corner as you navigate through eerie environments filled with whispers of the unknown.\n\nThe once lively arenas of GorillaTag are now transformed into haunted battlegrounds, where fear lurks in every shadow. As you sprint and leap through the darkness, you're not alone. Sinister forces, unseen and relentless, stalk your every move. Their presence is felt through unsettling sounds and glimpses of their malevolent forms darting just beyond sight.\n\nTo survive the nightmarish ordeal, players must rely on their wits and reflexes as they evade the relentless pursuit of the unknown entities. But beware - the line between reality and nightmare blurs, and the game's rules may change at any moment, trapping players in a twisted labyrinth of horror.\n\n\"Scary Spot\" delivers an immersive horror experience, blending the adrenaline-fueled action of GorillaTag with the tension and terror of a survival horror game. Will you emerge victorious from the darkness, or become just another victim of the Scary Spot's chilling grasp?", "short_description": "Horror game (:"}]}, "developer_name": null, "developer_privacy_policy_url": "https://scaryspot.w3spaces.com/Tos.html", "developer_terms_of_service_url": null, "publisher_name": "Scary Spot", "support_website_url": null, "website_url": "https://scaryspot.w3spaces.com/Tos.html", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "da"], "supported_input_devices":
tO9wqwiH-Hg3j0MXEWWSe4v3Lwdn7Q&oe=6B08647B"}, {"file_name": "image-2560x1440 (1).png", "id": "1159123811893787", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974482_1159123815227120_5027545272939608262_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PevJ0x9kAxAQ7kNvwHyHI_4&_nc_oc=AdpFkMXoa3EDe8GYoumaqi-s0E5i5FJ1I57GtVbBW1RoGZpB4DGrGrVLlQlKjV5CmZ8&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTlcT0Nz73RN4Sh2-ibyD1t_yv557T2643SpW4ql_ZMyw&oe=6B085F39"}, {"file_name": "image-2560x1440 (1).png", "id": "1031658652038029", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/57568677_1031658655371362_3526120158726678189_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zcr5FMZPbxoQ7kNvwGPgzag&_nc_oc=Adp8ZxY1WDEKgb_uEL7RK0G1YnMUdPdC6CD8SlWv9uukeMdYf4jL9aEn83eHNqz919Q&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR_vPDvNyrfdrAfcJP8gt3fMM9BfW14lmtTv1DgZ1Yb-w&oe=6B086149"}, {"file_name": "image-2560x1440 (1).png", "id": "2125534927846521", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/65395359_2125534931179854_4817256747704764355_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VnLVqzUnZjEQ7kNvwHmk_76&_nc_oc=Ado5lOXUujkZATWC_fa3c9wNDIcs58gE5FcWk5DFBvB1CKQVLz1H6InUj668OS9nAI0&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQdZ5bJljc7aB7oavJExW9W_C9xLgkOKxj-rWABqzRPXQ&oe=6B084DB9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "image-2560x1440.png", "id": "811892977466542", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39035401_811892980799875_7740895787897875644_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vwld93Uu6uEQ7kNvwHpvQB-&_nc_oc=AdoSikHLCaqzCDpJhVTnW6udZ7Ph3R5KuN9vI6SZ7IGJIvGKkqjM1xws6czm4xQO43o&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTHx-DwqFYGY2P2UI9AWZGaB6AiaAAk9gyPmi85jKOyWg&oe=6B0855BB"}, "display_name": "Scary Spot", "keywords": [], "long_description": "\n\"Scary Spot: The GorillaTag Nightmare\" plunges players into a chilling alternate reality where the beloved VR game takes a terrifying turn. In this spine-tingling fan game, darkness shrouds every corner as you navigate through eerie environments filled with whispers of the unknown.\n\nThe once lively arenas of GorillaTag are now transformed into haunted battlegrounds, where fear lurks in every shadow. As you sprint and leap through the darkness, you're not alone. Sinister forces, unseen and relentless, stalk your every move. Their presence is felt through unsettling sounds and glimpses of their malevolent forms darting just beyond sight.\n\nTo survive the nightmarish ordeal, players must rely on their wits and reflexes as they evade the relentless pursuit of the unknown entities. But beware - the line between reality and nightmare blurs, and the game's rules may change at any moment, trapping players in a twisted labyrinth of horror.\n\n\"Scary Spot\" delivers an immersive horror experience, blending the adrenaline-fueled action of GorillaTag with the tension and terror of a survival horror game. Will you emerge victorious from the darkness, or become just another victim of the Scary Spot's chilling grasp?", "short_description": "Horror game (:"}]}, "developer_name": null, "developer_privacy_policy_url": "https://scaryspot.w3spaces.com/Tos/Tos.html", "developer_terms_of_service_url": null, "publisher_name": "Scary Spot", "support_website_url": null, "website_url": "https://scaryspot.w3spaces.com/Tos/Tos.html", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended
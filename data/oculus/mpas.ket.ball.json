dn.com/v/t64.5771-25/38974784_550149922483524_5311296080246210560_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fZH5TZtLKWcQ7kNvwHRuHbY&_nc_oc=AdqBhAmnRzavk_9k2YrQ2CKkVpXobFtbnLfW6Zpcgf8oJvmLY9Ps5yNqT_tAvc5wU-s&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSIn_t9vr_PuNwEwtODU6IRNfZ-qNtHl1tlnR8lAkBoCQ&oe=6AFB1A70"}, "display_name": "Virtual Reality Basketball", "keywords": ["Basketball", "Controller", "NBA", "Shoot"], "long_description": "Virtual Reality Basketball is a basketball simulator where you get to use your motion controller to shoot! \n\nVirtual Reality Basketball features three (3) different game modes. \n\nFree roam allows you to score as many times as you like. However, you have a maximum of three (3) consequent shoots. \n\nTime \u2013 Attack mode counts your successful shoots taken in an one (1) minute period. \n\n10 \u2013 Step Challenge is the hardest game mode where you have to score 10 shots from predefined positions to win.", "short_description": "Use your controller to shoot in Virtual Reality Basketball!"}]}, "developer_name": "Vlasios Kasapakis", "developer_privacy_policy_url": "https://sites.google.com/view/virtual-reality-basketball/home/privacy-policy-vr-basketball", "developer_terms_of_service_url": null, "publisher_name": "Vlasios Kasapakis", "support_website_url": null, "website_url": "https://sites.google.com/view/virtual-reality-basketball/home", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "SPORTS", "ARCADE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_in
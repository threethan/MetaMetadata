_AQQPDxXu4MJ2pnWbg2iWvpUL7V6G1nw3fuHNFJ-75WhryQ&oe=6B045460"}, {"file_name": "3.png", "id": "457457597035268", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982618_457457600368601_3188675145621070132_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YZlM-F2jNRIQ7kNvwHB7Wtc&_nc_oc=AdoO-kOvz35FTHfl-pEzHgzvORd6Dufqfr9MWbfj-bOHTrEIL5Eta9HGXCssTLvqj_w&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSZWb-oY6cl0QfzYoN1tAiqWHPDnEgIvk-HMXA6FhUB1g&oe=6B04659B"}, {"file_name": "5.png", "id": "996534591863687", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/57572927_996534595197020_5398134876768491404_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RUCiCbXDypEQ7kNvwFhQuev&_nc_oc=Ado79UwImCxm0kk2WLXbMNasolCmzVtDHguA2h2Gi-le6OwyTj2ChNx7HGhqCr0dD4s&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSjpF83ub68UjUnM6BRC02DR4hieKGui0p8XYshgKjOeg&oe=6B04741E"}, {"file_name": "6.png", "id": "1011659503768096", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982699_1011659507101429_7519951062421030461_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1c0qjnA4uQoQ7kNvwGUMgOq&_nc_oc=Ado2c0RwOz0EtY7teXzNIp3ml3q--Iuh2gwAsWO2DYZaRJxPHAJm1jYE4aeytsPG-I8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSbENUW3q1UsOIVAXOtyG81b9HPEfibg6HbJQsKsNBCXg&oe=6B048745"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VideoThumbnail.png", "id": "987837626121564", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974695_987837632788230_1015870060816177121_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WEOATZ9HxZoQ7kNvwGp81WJ&_nc_oc=Adr5K1eEPMzr2o8N5rAHAJRmlcoJyTlsDXZi9A87h3Ltt2jppOlmtejqcFeeOCz2NOU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSYSJUAzTr8Feb4lGFGG_NnV3TeVnlt1CtQk5oeumzHxw&oe=6B046AF3"}, "display_name": "VR Kart 360", "keywords": [], "long_description": "Strap into your VR headsets for VR Kart 360 !\n\nExperience the adrenaline of immersive kart racing like never before. Dive into thrilling tracks, compete globally, and fine-tune your kart to dominate. Feel every turn and bump in VR's fully immersive world.\n{2749921605164381}\n\n{1010189834052785}\n- Immersive VR Experience: Feel the excitement of kart racing with realistic sensations.\n- Thrilling Tracks: Test your skills on challenging tracks designed for strategy and precision.\n- Global Competition: Compete worldwide, climb leaderboards, and become the ultimate champion.\n- Customizable Karts: Personalize your kart with upgrades for better performance and appearance.\n- Intense Head-to-Head Races: Compete against AI and real players in adrenaline-pumping races.\n- Skill Mastery: Hone reflexes and focus to navigate sharp corners and lead the pack.\n- VR Enhancements: Heightened realism and immersion elevate your kart racing experience.\n\n{348264668061132}\n\nWhy Choose Kart 360 VR:\nEmbark on an exhilarating journey where each race is a challenge and victory makes you a legend. With stunning visuals and a true-to-life VR environment, Kart 360 VR is the definitive choice for racing enthusiasts and VR gamers alike.\n\n{797696912453103}", "short_description": "Strap into your VR headsets and dive into the adrenaline-pumping world of Kart 360 VR! Get ready for an unparalleled immersive kart racing experience where speed meets skill, and legends are forged in the heat of intense virtual competition."}]}, "developer_name": null, "developer_privacy_policy_url": "https://geniegaming.com/vr-policy", "developer_terms_of_service_url": null, "publisher_name": "Genie Gaming Ltd", "support_website_url": null, "website_url": "https://geniegaming.com/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "673385183287495"}, {"id": "331529188132278"}, {"
_AQQmVVbwaR0F_i7uQKXZYThQ-d0KDtcibFHBd4PZLiGUCA&oe=6AFB19E0"}, {"file_name": "3.png", "id": "457457597035268", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38982618_457457600368601_3188675145621070132_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JWFjNNyI0KIQ7kNvwGrCeZI&_nc_oc=AdqutUfEDUBR3Gz1nOW3Al5lj45-gIee5M58t2u8XF-UiEU6SWVnu2fwp1bm7a02Kvo&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSVym2eMa-MmagHCNGigUhWbqGDJLtoD-wor-85LuCXOg&oe=6AFB2B1B"}, {"file_name": "5.png", "id": "996534591863687", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/57572927_996534595197020_5398134876768491404_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=96jPmARaKAsQ7kNvwFZUw7t&_nc_oc=AdoHPT-J04dd70B7gBkJI9nPUTUhvVQbzHoj8Rv8xO6Zof3S89ZDLp3QNxqqaObA1ZE&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT9rg8pfWwHTYxcwKMhFfKyQiSrFFugPEWXer65n6t0Ag&oe=6AFB399E"}, {"file_name": "6.png", "id": "1011659503768096", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38982699_1011659507101429_7519951062421030461_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f5xyMEvmGQwQ7kNvwGWuQVG&_nc_oc=Adqw8jtL_FAUdSzzz_i5_xELy7UnhBmZajvM-GUP8VVbtSNnJyoGORJ2Xwp-jFHl-xc&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRDjP5y2Pod8HkzSpPHvxZHk0GAfRgSMkyruoSK-CDWLg&oe=6AFB4CC5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VideoThumbnail.png", "id": "987837626121564", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38974695_987837632788230_1015870060816177121_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wKKuZUo4PkUQ7kNvwHZy5gP&_nc_oc=Ado3bxrIAFQGGel4BvNlvoVI_ZvBto9VQTQ1k2QjxvdWAUc1Uh66Wqb-VpDaZlcLoT0&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRgkH-SjOdgDj2S5YDBsnec5O3UswpNeK22CDyin5t16Q&oe=6AFB3073"}, "display_name": "VR Kart 360", "keywords": [], "long_description": "Strap into your VR headsets for VR Kart 360 !\n\nExperience the adrenaline of immersive kart racing like never before. Dive into thrilling tracks, compete globally, and fine-tune your kart to dominate. Feel every turn and bump in VR's fully immersive world.\n{2749921605164381}\n\n{1010189834052785}\n- Immersive VR Experience: Feel the excitement of kart racing with realistic sensations.\n- Thrilling Tracks: Test your skills on challenging tracks designed for strategy and precision.\n- Global Competition: Compete worldwide, climb leaderboards, and become the ultimate champion.\n- Customizable Karts: Personalize your kart with upgrades for better performance and appearance.\n- Intense Head-to-Head Races: Compete against AI and real players in adrenaline-pumping races.\n- Skill Mastery: Hone reflexes and focus to navigate sharp corners and lead the pack.\n- VR Enhancements: Heightened realism and immersion elevate your kart racing experience.\n\n{348264668061132}\n\nWhy Choose Kart 360 VR:\nEmbark on an exhilarating journey where each race is a challenge and victory makes you a legend. With stunning visuals and a true-to-life VR environment, Kart 360 VR is the definitive choice for racing enthusiasts and VR gamers alike.\n\n{797696912453103}", "short_description": "Strap into your VR headsets and dive into the adrenaline-pumping world of Kart 360 VR! Get ready for an unparalleled immersive kart racing experience where speed meets skill, and legends are forged in the heat of intense virtual competition."}]}, "developer_name": null, "developer_privacy_policy_url": "https://geniegaming.com/vr-policy", "developer_terms_of_service_url": null, "publisher_name": "Genie Gaming Ltd", "support_website_url": null, "website_url": "https://geniegaming.com/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "673385183287495"}, {"id": "331529188132278"}, {"
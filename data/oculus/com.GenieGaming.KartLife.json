A2DB5B"}, {"file_name": "5.png", "id": "996534591863687", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/57572927_996534595197020_5398134876768491404_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IsTPynOFTmgQ7kNvwF3OSJW&_nc_oc=AdnlB5doON6RbsLePkPIrZ9Wij9UL351xR99QbXHsPTcuEpj1Tc71UVAY4KGp0EFAXY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Afs-Q2uXR-ClyzQcfu5JNXrB_tPOepPUdzpz9Gh6gvDggA&oe=69A2E9DE"}, {"file_name": "6.png", "id": "1011659503768096", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982699_1011659507101429_7519951062421030461_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BabpftYPbSEQ7kNvwFGg71a&_nc_oc=AdklhgsX7YfXU7bvv4c0d5jHs5F7W7z1IUhk1y6C8RiyztWfApCIzpAK2GAQLLWe4EU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Afss4bSa80cm5OmPNVfOLcUN-Aspn6YJ5QKLTwedUCxXIw&oe=69A2FD05"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VideoThumbnail.png", "id": "987837626121564", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974695_987837632788230_1015870060816177121_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wGWuwvjm59YQ7kNvwGLVx48&_nc_oc=AdnTcwZ2udm3pmr-vlmYtrQrzKuUnSZpJoN8rfVAO-3THNIAbyGEkG0aA1hyH4c1w3I&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfvmMphMXKSpNa3W2HFsu9hyN1lIwpxYZ3yWDrbDB9aqXA&oe=69A2E0B3"}, "display_name": "VR Kart 360", "keywords": [], "long_description": "Strap into your VR headsets for VR Kart 360 !\n\nExperience the adrenaline of immersive kart racing like never before. Dive into thrilling tracks, compete globally, and fine-tune your kart to dominate. Feel every turn and bump in VR's fully immersive world.\n{2749921605164381}\n\n{1010189834052785}\n- Immersive VR Experience: Feel the excitement of kart racing with realistic sensations.\n- Thrilling Tracks: Test your skills on challenging tracks designed for strategy and precision.\n- Global Competition: Compete worldwide, climb leaderboards, and become the ultimate champion.\n- Customizable Karts: Personalize your kart with upgrades for better performance and appearance.\n- Intense Head-to-Head Races: Compete against AI and real players in adrenaline-pumping races.\n- Skill Mastery: Hone reflexes and focus to navigate sharp corners and lead the pack.\n- VR Enhancements: Heightened realism and immersion elevate your kart racing experience.\n\n{348264668061132}\n\nWhy Choose Kart 360 VR:\nEmbark on an exhilarating journey where each race is a challenge and victory makes you a legend. With stunning visuals and a true-to-life VR environment, Kart 360 VR is the definitive choice for racing enthusiasts and VR gamers alike.\n\n{797696912453103}", "short_description": "Strap into your VR headsets and dive into the adrenaline-pumping world of Kart 360 VR! Get ready for an unparalleled immersive kart racing experience where speed meets skill, and legends are forged in the heat of intense virtual competition."}]}, "developer_name": null, "developer_privacy_policy_url": "https://geniegaming.com/vr-policy", "developer_terms_of_service_url": null, "publisher_name": "Genie Gaming Ltd", "support_website_url": null, "website_url": "https://geniegaming.com/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "673385183287495"}, {"id": "331529188132278"}, {"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "zh_CN", "fr", "it", "de", "es", "ja", "pt_BR", "pt", "ru", "ru_UA"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "MULTI_USER"], "id": "26507626968850632"}}]}, "scheduled_offers": {"count": 2, "nodes": [
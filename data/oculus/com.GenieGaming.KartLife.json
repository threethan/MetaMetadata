_AQXVPQ7qH-javcDfbTcck3RQAhPy_951gYbF2sS58NmgBA&oe=6B106A20"}, {"file_name": "3.png", "id": "457457597035268", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982618_457457600368601_3188675145621070132_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Rt1k3KPmFQYQ7kNvwFDHghb&_nc_oc=AdpMuMMeRy6dKNS0-Jg3PE0pc0VXSCe6wg0CB3Gy1Nvp_slSLyBA_XIM7X2RPc4Gj4M&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQU509HMgUBdgoZyJskxr1_Gu-3z2hRYeTaHu0mYnbhdOA&oe=6B10431B"}, {"file_name": "5.png", "id": "996534591863687", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/57572927_996534595197020_5398134876768491404_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v_wOwIdLmogQ7kNvwE1Aut4&_nc_oc=AdpiPt8VJOLn80dbocq2VNyYbcMnU4XlY5Xzxu-Xsvse9w1l8ktqlZc9Um0V9TB6GKI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQUUJAFQWt5ljbA--TKxK0q3pegrlTZjrxSacWSecNKcCw&oe=6B10519E"}, {"file_name": "6.png", "id": "1011659503768096", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982699_1011659507101429_7519951062421030461_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OMwP36wMqQYQ7kNvwE6MTYC&_nc_oc=Adq2twIVCdsoicgD3XPg7TIBRcYX2gIKmJIWyPErDei6_-8cW9kx7W_wFp8a1rV3UYw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVIlKcZmeI48_IV-qBezySER2VXTCoN9b-VzkLAKQPFdQ&oe=6B1064C5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VideoThumbnail.png", "id": "987837626121564", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974695_987837632788230_1015870060816177121_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=58gXlUKj6ZUQ7kNvwGeP9ll&_nc_oc=AdpTTTJrop3-Lz0RIEfHlJ-2NLHa0q7VwvM-oFCy35V6U8HpL-OUfJfwlh1GPucnrNg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWhdjL8IoqL3qqPlB8fCURytJRDW0bV1x_uiRy01LXtsg&oe=6B104873"}, "display_name": "VR Kart 360", "keywords": [], "long_description": "Strap into your VR headsets for VR Kart 360 !\n\nExperience the adrenaline of immersive kart racing like never before. Dive into thrilling tracks, compete globally, and fine-tune your kart to dominate. Feel every turn and bump in VR's fully immersive world.\n{2749921605164381}\n\n{1010189834052785}\n- Immersive VR Experience: Feel the excitement of kart racing with realistic sensations.\n- Thrilling Tracks: Test your skills on challenging tracks designed for strategy and precision.\n- Global Competition: Compete worldwide, climb leaderboards, and become the ultimate champion.\n- Customizable Karts: Personalize your kart with upgrades for better performance and appearance.\n- Intense Head-to-Head Races: Compete against AI and real players in adrenaline-pumping races.\n- Skill Mastery: Hone reflexes and focus to navigate sharp corners and lead the pack.\n- VR Enhancements: Heightened realism and immersion elevate your kart racing experience.\n\n{348264668061132}\n\nWhy Choose Kart 360 VR:\nEmbark on an exhilarating journey where each race is a challenge and victory makes you a legend. With stunning visuals and a true-to-life VR environment, Kart 360 VR is the definitive choice for racing enthusiasts and VR gamers alike.\n\n{797696912453103}", "short_description": "Strap into your VR headsets and dive into the adrenaline-pumping world of Kart 360 VR! Get ready for an unparalleled immersive kart racing experience where speed meets skill, and legends are forged in the heat of intense virtual competition."}]}, "developer_name": null, "developer_privacy_policy_url": "https://geniegaming.com/vr-policy", "developer_terms_of_service_url": null, "publisher_name": "Genie Gaming Ltd", "support_website_url": null, "website_url": "https://geniegaming.com/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "673385183287495"}, {"id": "331529188132278"}, {"
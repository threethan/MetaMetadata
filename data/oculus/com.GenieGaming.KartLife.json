_AQTD6V95YVEOLefwq4SGT8chitRCa_wBz3sfOwK5IM7g9w&oe=6B0848E0"}, {"file_name": "3.png", "id": "457457597035268", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38982618_457457600368601_3188675145621070132_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l9yOvtYNqxYQ7kNvwHn99Bc&_nc_oc=AdqsQ0J_UnwVuLlWsWC8k0cuDl0FEP79aTqbwEeBSBq3lnaXk1n0aMW7t7ewkYrdAJA&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTzz773tykP4vj7OAB2Xlkds5JCwp5oWmFu01eLuntvNw&oe=6B085A1B"}, {"file_name": "5.png", "id": "996534591863687", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/57572927_996534595197020_5398134876768491404_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aZH4mRr3luAQ7kNvwGnH_0g&_nc_oc=Adra6K5jliNmkYptsYeaDN04Iratq4YBK_Vf8e7p9rKdznhQEnd9W5t-6FoFHksiU58&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQtrJFXbGEjbxErOMKYNBjN56quEV2r9eDLKXLtnetS7g&oe=6B08689E"}, {"file_name": "6.png", "id": "1011659503768096", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38982699_1011659507101429_7519951062421030461_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tdpDeGnVAsQQ7kNvwGiPHKi&_nc_oc=AdrWqhvgnmQLZctnH7N9SzWEzmcj4m7aCjkA9zz3EAvFs7D6C-B6wuQMUlGqJZNPEDw&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRtgPl5ljErqhbP1zuR2QBw_aqDIaa7XN-rnsH3QIMkWg&oe=6B084385"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VideoThumbnail.png", "id": "987837626121564", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974695_987837632788230_1015870060816177121_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IvvVzJt8EOAQ7kNvwH6WAua&_nc_oc=AdqAL4zMsV02Xnr_TAvoZNfXGR5F-7Y8AhKxZb5PQP6zdV8TWNofcUprxEqgT5WPHqA&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTOnnogrcQvpHJM9zVUKRfhHrQODWV_hpyE7Jo8ttpoZA&oe=6B085F73"}, "display_name": "VR Kart 360", "keywords": [], "long_description": "Strap into your VR headsets for VR Kart 360 !\n\nExperience the adrenaline of immersive kart racing like never before. Dive into thrilling tracks, compete globally, and fine-tune your kart to dominate. Feel every turn and bump in VR's fully immersive world.\n{2749921605164381}\n\n{1010189834052785}\n- Immersive VR Experience: Feel the excitement of kart racing with realistic sensations.\n- Thrilling Tracks: Test your skills on challenging tracks designed for strategy and precision.\n- Global Competition: Compete worldwide, climb leaderboards, and become the ultimate champion.\n- Customizable Karts: Personalize your kart with upgrades for better performance and appearance.\n- Intense Head-to-Head Races: Compete against AI and real players in adrenaline-pumping races.\n- Skill Mastery: Hone reflexes and focus to navigate sharp corners and lead the pack.\n- VR Enhancements: Heightened realism and immersion elevate your kart racing experience.\n\n{348264668061132}\n\nWhy Choose Kart 360 VR:\nEmbark on an exhilarating journey where each race is a challenge and victory makes you a legend. With stunning visuals and a true-to-life VR environment, Kart 360 VR is the definitive choice for racing enthusiasts and VR gamers alike.\n\n{797696912453103}", "short_description": "Strap into your VR headsets and dive into the adrenaline-pumping world of Kart 360 VR! Get ready for an unparalleled immersive kart racing experience where speed meets skill, and legends are forged in the heat of intense virtual competition."}]}, "developer_name": null, "developer_privacy_policy_url": "https://geniegaming.com/vr-policy", "developer_terms_of_service_url": null, "publisher_name": "Genie Gaming Ltd", "support_website_url": null, "website_url": "https://geniegaming.com/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "673385183287495"}, {"id": "331529188132278"}, {"
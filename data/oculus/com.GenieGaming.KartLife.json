_AQX3loUR2d7mtyaJ0zxfCt8rc79uWWbbofEoAXbRVfZnpQ&oe=6B0F18A0"}, {"file_name": "3.png", "id": "457457597035268", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982618_457457600368601_3188675145621070132_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Rt1k3KPmFQYQ7kNvwG-7TLT&_nc_oc=AdrxvUpBONO06O2GQOeEo9BloVhrv8krkuu9GoP__2RaUyyQcnlQIH7fDBQ-nCr2Z7w&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVmO0_DnIyhL5G2ggl9uuJ8C0aA3O1LlfBMs7WCt0F1vA&oe=6B0EF19B"}, {"file_name": "5.png", "id": "996534591863687", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/57572927_996534595197020_5398134876768491404_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v_wOwIdLmogQ7kNvwGuZB5v&_nc_oc=Adp82Kz5tpjL11X3wG4s4pQWPFTqGg72jwEyKHSuQN2RwxbMY2HtQOconNuZJealwag&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXGUsE6LompahZQmXcOmlqpMXcAXvTaSqw3Neb5ly2JXQ&oe=6B0F001E"}, {"file_name": "6.png", "id": "1011659503768096", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982699_1011659507101429_7519951062421030461_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OMwP36wMqQYQ7kNvwFjQBXF&_nc_oc=Adom8AleCctAvhsnZLTHJ8g9jPQScUtIeJCVl7WK9xSTtCX36sYUeUgLY-KLrBkZHpA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQUyTvJIJP2OWEwhfWUQbBw1uUvb7BWUYGmwP3A_Zuk-Aw&oe=6B0F1345"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VideoThumbnail.png", "id": "987837626121564", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974695_987837632788230_1015870060816177121_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=58gXlUKj6ZUQ7kNvwHklV5V&_nc_oc=AdpSrpLeQfIZy0rxaEILiOPvkpiuYKdhpDxqob3HQDFToq62dT8Ow19o5-_fBWnP0XI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXGkPRij3I1CsAMEfJDeWauTKEVF96r9I3LHO1IhPx0Yg&oe=6B0EF6F3"}, "display_name": "VR Kart 360", "keywords": [], "long_description": "Strap into your VR headsets for VR Kart 360 !\n\nExperience the adrenaline of immersive kart racing like never before. Dive into thrilling tracks, compete globally, and fine-tune your kart to dominate. Feel every turn and bump in VR's fully immersive world.\n{2749921605164381}\n\n{1010189834052785}\n- Immersive VR Experience: Feel the excitement of kart racing with realistic sensations.\n- Thrilling Tracks: Test your skills on challenging tracks designed for strategy and precision.\n- Global Competition: Compete worldwide, climb leaderboards, and become the ultimate champion.\n- Customizable Karts: Personalize your kart with upgrades for better performance and appearance.\n- Intense Head-to-Head Races: Compete against AI and real players in adrenaline-pumping races.\n- Skill Mastery: Hone reflexes and focus to navigate sharp corners and lead the pack.\n- VR Enhancements: Heightened realism and immersion elevate your kart racing experience.\n\n{348264668061132}\n\nWhy Choose Kart 360 VR:\nEmbark on an exhilarating journey where each race is a challenge and victory makes you a legend. With stunning visuals and a true-to-life VR environment, Kart 360 VR is the definitive choice for racing enthusiasts and VR gamers alike.\n\n{797696912453103}", "short_description": "Strap into your VR headsets and dive into the adrenaline-pumping world of Kart 360 VR! Get ready for an unparalleled immersive kart racing experience where speed meets skill, and legends are forged in the heat of intense virtual competition."}]}, "developer_name": null, "developer_privacy_policy_url": "https://geniegaming.com/vr-policy", "developer_terms_of_service_url": null, "publisher_name": "Genie Gaming Ltd", "support_website_url": null, "website_url": "https://geniegaming.com/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "673385183287495"}, {"id": "331529188132278"}, {"
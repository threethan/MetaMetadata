7&_nc_sid=6e7a0a&_nc_ohc=3SAILd6ATV0Q7kNvwEtwPHH&_nc_oc=AdqyDP15oIrjcVOw4OUKZaIZRaE8vd3ebuE7V36IjTEjNx9yIX2hH2KyR0jQ0DXXQhY&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQYz345rNxwIfnX-P0s7AQX6f86eAFhTY1AKu4DaxswmA&oe=6B087208"}, {"file_name": "screenshot_3.png", "id": "1106432421765870", "uri": "https://scontent-dfw5-3.oculuscdn.com/v/t64.5771-25/491824700_1106432428432536_5215038081709906477_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Kno5hI_pB6MQ7kNvwELZiBP&_nc_oc=AdogqisVoPrueThqU0chAMQdUfz3BV5PVfR4R0k33nh4-2yuflkNjWky7_-K1FIjRAY&_nc_zt=3&_nc_ht=scontent-dfw5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTnvZ92GC_N2xxYiPLbA7-8ZXr_GIxKVtqfI0FH0FVcEg&oe=6B084544"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_cover.png", "id": "1771808244070952", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/491824318_1771808250737618_8762603609103128330_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CP6qTLFCo_wQ7kNvwHtC09U&_nc_oc=Adq6vPTQ3E5ccXEuf_ZhEapm0E7zXQa9lyx5IU-oc14V301UGn9IcTzjwJB398fnP1k&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR15alp0xsF0azgN6Z6-PHs-vs8c0R3cqI_6dPJ7xlhRQ&oe=6B0869C7"}, "display_name": "Flight Simulator Dubai", "keywords": ["flight", "simulator", "airplane", "dubai", "pilot"], "long_description": "Flight Simulator Dubai puts you in the captain's seat over the real city.\n\nTHE REAL DUBAI\nThe coastline, the terrain and thousands of buildings come from real satellite and map data. Fly round the Burj Khalifa, along the Palm Jumeirah, past the Burj Al Arab and Ain Dubai, over The World islands and down the Marina skyline. Cars stream along the motorways, yachts and ships work the Gulf and other aircraft share the sky.\n\nTHREE REAL AIRPORTS\nDubai International with both runways, Al Maktoum International and Sharjah International, with their real taxiways and approach lights.\n\nTHE PRIVATE JET\nAn ultra-long-range jet with a glass cockpit: live flight displays, a moving map and an autopilot. Fly it with the side-stick and thrust levers in your hands, or with the thumbsticks. Then stand up and walk back through the cabin while the city goes by outside the windows.\n\nFOUR AIRCRAFT\nThe private jet, a twin-engine fighter, a four-seat light plane and a helicopter. Each has its own cockpit and its own way of flying.\n\nYOUR OWN HANGAR\nWalk around your aircraft, repaint them and power wash them clean, then choose one and fly.\n\nMISSIONS AND FREE FLIGHT\nLandings at all three airports, a ring course round the Palm, a skyline run past the Burj Khalifa, a night landing and a city tour - or just fly, by day, at sunset or at night.\n\nFLY TOGETHER ONLINE\nQuick Match or a private sky with a 4-digit code. Join up on a friend's wing or ride in their aircraft. Voice chat stays off until you turn it on.", "short_description": "Fly the real Dubai, built from real map data: the Burj Khalifa, the Palm Jumeirah, the Burj Al Arab, The World islands and three real airports. Take the left seat of an ultra-long-range private jet and walk through its cabin in flight. A fighter, a light plane and a helicopter wait in your own hangar. Fly solo or together online."}]}, "developer_name": null, "developer_privacy_policy_url": "https://citiview-games.pages.dev/flightsimulatordubai/privacy", "developer_terms_of_service_url": null, "publisher_name": "Citiview Studios", "support_website_url": "https://citiview-games.pages.dev/flightsimulatordubai/", "website_url": "https://citiview-games.pages.dev/flightsimulatordubai/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "1990104051447093"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_
791557_8690170285324933060_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Gwjr7OyyveMQ7kNvwFc2Xgi&_nc_oc=Adp4ieWmv6vS7xXf810n5e3uxK2zgdXB0vzHRfEpuZQOMPehn3Mdlr1ii305TY6KEWE&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS1big6qLzziBnOnyuMbe1iZffJlTWNt760YTj7y9ycEA&oe=6AF9CB8E"}, {"file_name": "WhatsApp Image 2026-10-31 at 14.27.18.png", "id": "2179668059293889", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/491824322_2179668069293888_6954149545979037891_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JhoDGure35cQ7kNvwGqaO2t&_nc_oc=Adp9_DI16NEkyQbSdqJvHObHyNBpjlimI5wchcLYqEm2WJKrq6IZoa8Eu1tiuOtLwQA&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSPi0u9AN_MxMXWy9zG7-0AiCeq_8dCI76vRU06iXgB3g&oe=6AF9CFB7"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Bytestudio Remote Desktop", "keywords": ["desktop", "linux", "ubuntu", "remote", "gnome"], "long_description": "# Bytestudio Remote Desktop Client for Meta Quest 3\n\nA remote desktop client for Meta Quest 3 that connects to Ubuntu PCs running GNOME Remote Desktop (RDP protocol with H.264 video codec).\n\n## Features\n\n- **1920\u00d71080 desktop** on a 2-meter floating panel with H.264 HW acceleration\n- **Passthrough enabled** \u2014 see your hands and keyboard in the room\n- **Qualcomm hardware H.264 decoding** for smooth, efficient video\n- **Pointer stabilization** for comfortable pointing with hand and controllers\n- **Dual-hand control** with conflict resolution\n- **Bluetooth keyboard support** for physical keyboards\n- **Virtual keyboard**\n-**Audio**\n- **Audio playback** (PCM, 300ms buffer)\n- **Draggable & resizable panels** for flexible workspace layout\n- **Server certificate pinning** (TOFU, like SSH) for security\n\n## Requirements\n\n- **Meta Quest 3** \n- **PC with GNOME** (tested: Ubuntu 26.04)\n- **GNOME Remote Desktop enabled** (RDP server running)\n- **Local network connection** (Ethernet + Wi-Fi 5/6 GHz recommended for best latency)\n\n## Known Limitations\n\n- **GNOME desktop only** \u2014 not compatible with KDE, XFCE, or other desktop environments\n- **Single display support** \u2014 only the primary monitor is shared\n- **30 fps max**  (Bytestudio Remote Desktop limit)\n- **No clipboard, microphone, or file sharing**\n- **No auto-reconnect** on network failure\n- **Physical keyboard** not yet fully tested on real hardware\n\n## Getting Started\n\n1. Enable GNOME Remote Desktop on your Ubuntu PC\n2. Install the app on Meta Quest 3\n3. Enter your PC's local IP, username, and password in the app\n4. Connect and start working in VR!", "short_description": "Remote desktop (RDP) client for Linux on Meta Quest 3\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://bytestudio-vr.github.io/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "byte_studio", "support_website_url": null, "website_url": "https://bytestudio-vr.github.io/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "393222478507326"}, {"id": "1063584910766706"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "TRACKED_KEYBOARD"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1483364651518582"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/604360590_1141528144967226_5168447433515771415_n.png?stp=dst-png_s360x360&_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rC_9vplk3Z4Q7kNvwEH1x4k&_nc_oc=AdoV_YElB6Zb1YI-ue_diwReSt3fs_3fwhphCILVDE
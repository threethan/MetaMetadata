2295777373", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499624395_1103022299110706_5508132195459517887_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n3MrIBaGrGUQ7kNvwGNf0kE&_nc_oc=AdpJVwm4KqlO5FPbVlS3P24jJ2-Md_R47_bEjbWejkaF7geGu_e3d-eTFYWZLs0bSrY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSgOG2-PCZyikJESUEtSWEek1vP9Pr-WwbpqdPWR7I7wg&oe=6AEDE6A7"}, {"file_name": "4.png", "id": "4180911832213207", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499620559_4180911835546540_2984367946415086066_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9V2tc_d6jwoQ7kNvwE_L_1m&_nc_oc=AdqbSAo3-hGFrulN7BZM2F9fvGiK0zCcAC-zJvaR5c2TtWyNG1SkCSwx_MfeOFBMGkk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTMYWK_A9o20CGTLssvnKLmqucOY7HF0iS9YQy1O4ivww&oe=6AEE0009"}, {"file_name": "5.png", "id": "1439528925005268", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499628454_1439528928338601_7614864539638179229_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LE4TzNRi32kQ7kNvwFsKiln&_nc_oc=AdoCX_bulJopi6-pgxMrrTFzGQOyYxtVhFBPUHnuqt6b9nRDLE4lQbCz4L4SlKsQZpA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTUr_OET5Oal9T3nNTx6guRDOocpdszxnW3kFvmuPUBuw&oe=6AEDDEAA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "duckz_landscape.png", "id": "1758541358550886", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/834130288_1758541361884219_7701986802944604616_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A6ZDplrcsvoQ7kNvwHKVRrp&_nc_oc=AdoNC4o7xPWdepeETATg3BRLj2XZ3zvn8OIA24Ck8DbdQN_27oFKX0-_FVJFBWEC8-w&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRhaX7D33rbwt-yC7-uvCnEK0WOJE-uDCqFBhWJazjLBw&oe=6AEE0418"}, "display_name": "Duck Z", "keywords": ["Survival", "Zombies", "Multiplayer", "Horror"], "long_description": "Welcome to Quackville.\nWhere did everybody go?\n\nAn empty town. A curious little duck. And something that feels just a little\u2026 off.
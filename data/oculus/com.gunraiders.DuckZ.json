2295777373", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499624395_1103022299110706_5508132195459517887_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I9BUPWIgl-YQ7kNvwHQCOni&_nc_oc=AdrFprNeepwIOjLItc931UI20rChx-gMj774HxY1IaXpPDgAhYkcx2iIGATgpVw38CU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQlzSuC2lorqUUAHmbRKJ6Sfs8h0v6KYb2ZA2XlHX9bsg&oe=6AF5CFA7"}, {"file_name": "4.png", "id": "4180911832213207", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499620559_4180911835546540_2984367946415086066_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iTtiWM7GYuUQ7kNvwFg1fcR&_nc_oc=AdrGdGhjZIzXOB4ZYD-PWeBHNN9pSjrK6XYWrmz_U4HYcc5ipLkiVEfUXnaMg8sra7Y&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTskoWxslZVCd5EpVZFwx_OOHRHUqu-G5lhzNMdTx-25A&oe=6AF5E909"}, {"file_name": "5.png", "id": "1439528925005268", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499628454_1439528928338601_7614864539638179229_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sTVvWp47PKEQ7kNvwGOWsBN&_nc_oc=AdpMrJJ5XgwE9FlUVX6JtQgfTDUwcDWEkBZFwsOrPvGuRkipfw0tcGJZKAfe9ZbXCHk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS3BDVGQ9gmpCGDr1JcoLJQj9ZF_D6WeAdyT01uhYUy7Q&oe=6AF5C7AA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "duckz_landscape.png", "id": "1758541358550886", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/834130288_1758541361884219_7701986802944604616_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Fcm8YamWSx0Q7kNvwFDLcAx&_nc_oc=AdoLFLeh-AT1mvQIqt5Gz8fTt6YNBF22xg4RyIELm8l_MKUY2uFamoP0n8WUF4qx73s&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS1wzMtRz2g25Io0LRKkui3BeaAT7OVn3SAfKN3UVSQ-g&oe=6AF5ED18"}, "display_name": "Duck Z", "keywords": ["Survival", "Zombies", "Multiplayer", "Horror"], "long_description": "Welcome to Quackville.\nWhere did everybody go?\n\nAn empty town. A curious little duck. And something that feels just a little\u2026 off.
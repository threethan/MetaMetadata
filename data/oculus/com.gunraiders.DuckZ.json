2295777373", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499624395_1103022299110706_5508132195459517887_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PPsGqfmjG1wQ7kNvwFfEFSv&_nc_oc=Ado6dc_0raVMkqROTxPJciLYS7dhb12buJo8Ro_Lyl1k7Cj111qCeXd4cp6VXZKYdcg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQer7616FcKvNQpK_FzAK91UJJqfHKYnVQFTuqONxC8aw&oe=6AF1DB27"}, {"file_name": "4.png", "id": "4180911832213207", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499620559_4180911835546540_2984367946415086066_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lBl3XoQhJt8Q7kNvwG20jla&_nc_oc=AdoxudQABYqtt0fMcwwOAbO9BgPggFhZA4_IGofbnqt_v5BnzPdTzHvuvoF5pdsP4eI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSW0RnXE63ONIfwQGH8guvMhtdxC7KY1AGqbsI76QaA8Q&oe=6AF1F489"}, {"file_name": "5.png", "id": "1439528925005268", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499628454_1439528928338601_7614864539638179229_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-CJZXxbLeaYQ7kNvwFBBguA&_nc_oc=Adq9Gua_I-QXhjjtGdEQNWUL0fer1zEZl1kq7PytNguFor8rIje06uB_SJ6sQT4-4M8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTtwESduYml9pE8m7H7nHiGPtHhz7nMrTfFtGEVI7iVPA&oe=6AF1D32A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "duckz_landscape.png", "id": "1758541358550886", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/834130288_1758541361884219_7701986802944604616_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CmVWVWodAlMQ7kNvwHMMp5_&_nc_oc=Adp5euEY4kePJB5Zh8iVbGVqOpLqEf_ahV3I-sft8-QXnXOJsS8U0SzZpKmoAFU9ItU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSEcAn9ntQCqCenwzJic7IdeZ_W7G0FVPisnVujDbucxA&oe=6AF1F898"}, "display_name": "Duck Z", "keywords": ["Survival", "Zombies", "Multiplayer", "Horror"], "long_description": "Welcome to Quackville.\nWhere did everybody go?\n\nAn empty town. A curious little duck. And something that feels just a little\u2026 off.
2295777373", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499624395_1103022299110706_5508132195459517887_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PPsGqfmjG1wQ7kNvwHTENDe&_nc_oc=Adr2YlaMt_UiY7iriE6hsAKPXvnTXb5xhruLb6Qu0-QvVCmfAJfnTb7KVc7pzJAbuIw&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSWKhN9z24COC3UBa-Tqu-NwOD6YmqVU4GNdUjm-AaIIQ&oe=6AF089A7"}, {"file_name": "4.png", "id": "4180911832213207", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499620559_4180911835546540_2984367946415086066_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lBl3XoQhJt8Q7kNvwFA2lrR&_nc_oc=AdpR8SSjejOj9CQOzJsAFfF_pt6JRVzjdD4Gb-TeoVDvqjvlrOQFn1QRrsCzeUwCun0&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSMla8Gw-qsQWn2ZFVMkfHg0fj7VCrfCu3CdlzMHMnIAQ&oe=6AF0A309"}, {"file_name": "5.png", "id": "1439528925005268", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499628454_1439528928338601_7614864539638179229_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-CJZXxbLeaYQ7kNvwFyPx0S&_nc_oc=AdpIv_OcQjwnr47eH4w1l-KLydt22-AKFe0Qh1lwv56gCl1VdfkjUlhL8DjJYti8Utc&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQV4l-2nNxvBcmFJfAPZSbGlKYop58IAfCFBZVdlgYWRw&oe=6AF081AA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "duckz_landscape.png", "id": "1758541358550886", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/834130288_1758541361884219_7701986802944604616_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CmVWVWodAlMQ7kNvwHmOpG2&_nc_oc=Adr3ElIpOkWmp-y9Sv0XjIBCvlIMby07Nx8BuzMMZiRpbSsM_L1q5VlhhR8fz5dvgt4&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT-uN1JPRyGdYy5NbWhFru6mxm3LeH_t9_PoWce5V24gA&oe=6AF0A718"}, "display_name": "Duck Z", "keywords": ["Survival", "Zombies", "Multiplayer", "Horror"], "long_description": "Welcome to Quackville.\nWhere did everybody go?\n\nAn empty town. A curious little duck. And something that feels just a little\u2026 off.
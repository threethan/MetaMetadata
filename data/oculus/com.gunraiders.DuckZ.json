2295777373", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499624395_1103022299110706_5508132195459517887_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XBK2Epxj9iAQ7kNvwGt3yEZ&_nc_oc=AdrdiCqRJfeejmd7CnAt_8quHk3ZzEWYU8eGKAa0765swl4YLgK_KlIyo3JOMPWhZP0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRDUgnweJcu2ldhuyyab1dCI-uNP4uQrDct9LPUt96GSQ&oe=6AF8AAE7"}, {"file_name": "4.png", "id": "4180911832213207", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499620559_4180911835546540_2984367946415086066_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qEc7GsNs_VkQ7kNvwE74LKl&_nc_oc=AdqENiGraW7gCScv63UDf3rKDcBjJXkxObpn9N4XNRNWYnqvnurlVqwDaB_QEpndb8s&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSCzQmbs5iE59yVylmfqZiewWfBxYX-lljrznTiHfnxSw&oe=6AF88C09"}, {"file_name": "5.png", "id": "1439528925005268", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499628454_1439528928338601_7614864539638179229_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JgGiDpmu7DgQ7kNvwFa9K86&_nc_oc=AdrNZdH3bTIHYuCOzn6xAQ2yG-PE9goKctGjM3eGrIotePAuE8vlpS3oTDTkCwdX54M&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRoW9jz9N8_qsZbhXvBv12LynhWfN0I9zXTxbKVAs4i2w&oe=6AF8A2EA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "duckz_landscape.png", "id": "1758541358550886", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/834130288_1758541361884219_7701986802944604616_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oodwc_QpPpMQ7kNvwF3gzeH&_nc_oc=AdogMq_293s5B52PgEXIK0lkxH6BftBOEWALTe7JFGSLBwd0xgkBfjJbvy4Yurp7xaI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR3_LaMffFSvQ6zHycDGXKC5fh76-I4r5JhKn7Tq_HvUw&oe=6AF89018"}, "display_name": "Duck Z", "keywords": ["Survival", "Zombies", "Multiplayer", "Horror"], "long_description": "Welcome to Quackville.\nWhere did everybody go?\n\nAn empty town. A curious little duck. And something that feels just a little\u2026 off.
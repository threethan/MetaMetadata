2295777373", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499624395_1103022299110706_5508132195459517887_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I9BUPWIgl-YQ7kNvwEvxXhZ&_nc_oc=AdoD57BZlKimXuhbGo63YthauxMDhGCAoGBOijJs-DxF3GrSBLt_CkuUcO1c7FMzfgg&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRJK-9gm62LBS_imXTGy8qPzIuKv1sbloj7V0nP0Wd9lA&oe=6AF32CA7"}, {"file_name": "4.png", "id": "4180911832213207", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499620559_4180911835546540_2984367946415086066_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lBl3XoQhJt8Q7kNvwG-BNA2&_nc_oc=Adqw5rY6g9AtHO10AY_PVPiUMvfw_k1iIPDxkFxwJbaQ-F054S9tdGLNdy6ChwO45c4&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS6FAIzIHun7hTe1XA09IbAo_IsmHSTVaCWb44RacyLgw&oe=6AF34609"}, {"file_name": "5.png", "id": "1439528925005268", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499628454_1439528928338601_7614864539638179229_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-CJZXxbLeaYQ7kNvwFypn-9&_nc_oc=AdoCko5Zmb6aPWdzcfJC3x4G_SyFluujyxNqlzag95rQ5pdOMmaqjfaoGBthy2vRN8A&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSMaQ99ofqV6OMRk6tHDsGFDs0UhzydLkTWTnPWuIrI5w&oe=6AF324AA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "duckz_landscape.png", "id": "1758541358550886", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/834130288_1758541361884219_7701986802944604616_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CmVWVWodAlMQ7kNvwFvJUMY&_nc_oc=AdrmF0VzSvhVulI4Agu-48o4wf29g08M60b0SBQrjAICRPPxod0wKsGXYk_6jEXJ98U&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQHSG2AsfFqVX83CNmA5e9Xk06oLPEsxZ-jRW4tOGO9DQ&oe=6AF34A18"}, "display_name": "Duck Z", "keywords": ["Survival", "Zombies", "Multiplayer", "Horror"], "long_description": "Welcome to Quackville.\nWhere did everybody go?\n\nAn empty town. A curious little duck. And something that feels just a little\u2026 off.
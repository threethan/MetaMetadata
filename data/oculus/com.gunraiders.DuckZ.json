2295777373", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499624395_1103022299110706_5508132195459517887_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PPsGqfmjG1wQ7kNvwEZyEoD&_nc_oc=AdpTuMVy4u58Pm6ejixTFnwY5mD9gSVfPHTpVLIYELHQfpoNUH14TTsmKsgrz9V3Ilw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQgVnENn2zEbTwFpkVfic6J2vjdpLEHx4-jD4ltVU6z-A&oe=6AEF3827"}, {"file_name": "4.png", "id": "4180911832213207", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499620559_4180911835546540_2984367946415086066_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9V2tc_d6jwoQ7kNvwGWhX9q&_nc_oc=AdqRvpiND2vLTcOFuWBTPm9D43oNp_-8TfOYHlBqy7zjMeX06Lt9OlAhkoBLDZwzS2M&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRV4NcDaMzgsZH05RBILzjgxzrMKkbHXBQYX46479IQJQ&oe=6AEF5189"}, {"file_name": "5.png", "id": "1439528925005268", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499628454_1439528928338601_7614864539638179229_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LE4TzNRi32kQ7kNvwFsSjpe&_nc_oc=Adp4DCp769YMRWjY0PosO4xvIX9LJBfCB9crZoIOgR5Ths33nBRi8MUbPxV34dbrhJU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTcqqtYw3hcpdQU9BqbU-R2U1-ZTMtg0yifWCeSfr5P6A&oe=6AEF686A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "duckz_landscape.png", "id": "1758541358550886", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/834130288_1758541361884219_7701986802944604616_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A6ZDplrcsvoQ7kNvwFUTdjX&_nc_oc=AdoVQmYi6tR8eRIpB5sF1rAY2IfChX8zEwqHAYc9Ym5U739q7JYKz2mAq0qupVQtfd8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQlPOqdl5boEQbBE1ivCZQ8DohDVXIjSCM4TdpVJ62LFw&oe=6AEF5598"}, "display_name": "Duck Z", "keywords": ["Survival", "Zombies", "Multiplayer", "Horror"], "long_description": "Welcome to Quackville.\nWhere did everybody go?\n\nAn empty town. A curious little duck. And something that feels just a little\u2026 off.
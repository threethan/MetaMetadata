tless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RyxRrYfEV50Q7kNvwGwQR1M&_nc_oc=Adq1g1s4u-yLrUjapKth1meS8fbS4pInfKbaLn6igKIRefRUu9e58Qd4sd9ROavp-R4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR2f5XSV5w5-Pji4kvGhOZ0JFPHFSeJGWSfTuyykt7_Fw&oe=6B05D07C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer cover.png", "id": "816359714384287", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491825345_816359717717620_7554063884059335957_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PGFvMufb4G0Q7kNvwFMDLtH&_nc_oc=Adql_pjuMmLUGWy18qnDE3C_rHEAWIGkj1VFsrIDS1gPdi5hkT9M5dNljk8Fu8VeX2c&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTO-5VzWuVb4ULaZ6W6eM5PdVO9vXTnr5GMIUuPFkSLEw&oe=6B05B605"}, "display_name": "Evrience Fire", "keywords": ["Counseling", "Therapy", "Psychology", "Training", "Education"], "long_description": "Evrience Fire offers a revolutionary way to practice therapy and counseling skills through VR. Create fully customized client cases - from help request to age, gender, appearance, voice, and language. Interact naturally with AI-driven clients who respond authentically to your questions and support. Perfect for universities, healthcare institutions, and trainees, Evrience Fire provides a realistic, safe, and fully immersive environment to build confidence and sharpen counseling techniques.\nEvery conversation is truly dynamic.", "short_description": "Generate fully custom client cases, including the client\u2019s type of help request, age, gender, appearance, voice, and any language. Interact naturally, and build experience in a safe, immersive environment to train with your AI client. Evrience Fire brings therapy education to life."}]}, "developer_name": null, "developer_privacy_policy_url": "https://evrience.com/evrience-fire-privacy-policy", "developer_terms_of_service_url": "https://evrience.com/evrience-fire-terms-of-service/", "publisher_name": "Evrience", "support_
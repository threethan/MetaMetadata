: {"file_name": "Trailer cover.png", "id": "816359714384287", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/491825345_816359717717620_7554063884059335957_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AwAhTNikDQEQ7kNvwFaVvUv&_nc_oc=AdrYpE28oGECnYho-LkAmn8jjTN_Ww1YNa--ZHmh1SbXnB0RGfO1cLnZJy_yJWP2Lfs&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIKmz38eO_rUR1uEGJvzodUSgjriboZgANfR8Sb5NvE-g&oe=6AA14BC5"}, "display_name": "Evrience Fire", "keywords": ["Counseling", "Therapy", "Psychology", "Training", "Education"], "long_description": "Evrience Fire offers a revolutionary way to practice therapy and counseling skills through VR. Create fully customized client cases - from help request to age, gender, appearance, voice, and language. Interact naturally with AI-driven clients who respond authentically to your questions and support. Perfect for universities, healthcare institutions, and trainees, Evrience Fire provides a realistic, safe, and fully immersive environment to build confidence and sharpen counseling techniques.\nEvery conversation is truly dynamic.", "short_description": "Generate fully custom client cases, including the client\u2019s type of help request, age, gender, appearance, voice, and any language. Interact naturally, and build experience in a safe, immersive environment to train with your AI client. Evrience Fire brings therapy education to life."}]}, "developer_name": null, "developer_privacy_policy_url": "https://evrience.com/evrience-fire-privacy-policy", "developer_terms_of_service_url": "https://evrience.com/evrience-fire-terms-of-service/", "publisher_name": "Evrience", "support_website_url": null, "website_url": "https://evrience.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}, {"id": "514087707868786"}], "external_subscription_type": "REQUIRED", "genre
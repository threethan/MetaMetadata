tless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jZfhcInDFQYQ7kNvwFnWzjg&_nc_oc=AdrcaivkAAU53StijYrDt_WamhCfXw_mbG25NXOkhmSMf4g94vYODqoiUCtf19EwlVY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQThYC3xpct24w8JPwQVhJEwp78Z7wiuKt3UIHsEH0tvUA&oe=6B0721FC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer cover.png", "id": "816359714384287", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491825345_816359717717620_7554063884059335957_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PGFvMufb4G0Q7kNvwESxqsI&_nc_oc=AdoF1_vPlsKVKgsHhNRmFGbxTjRvh4Y6jzC3oL8S1FFON2LtnFetaFvzz8GsfMYqAII&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTeLzcz-LIj-XY_SVwuNezOuRkX4_e8tEJSV3ynZQEJ8A&oe=6B070785"}, "display_name": "Evrience Fire", "keywords": ["Counseling", "Therapy", "Psychology", "Training", "Education"], "long_description": "Evrience Fire offers a revolutionary way to practice therapy and counseling skills through VR. Create fully customized client cases - from help request to age, gender, appearance, voice, and language. Interact naturally with AI-driven clients who respond authentically to your questions and support. Perfect for universities, healthcare institutions, and trainees, Evrience Fire provides a realistic, safe, and fully immersive environment to build confidence and sharpen counseling techniques.\nEvery conversation is truly dynamic.", "short_description": "Generate fully custom client cases, including the client\u2019s type of help request, age, gender, appearance, voice, and any language. Interact naturally, and build experience in a safe, immersive environment to train with your AI client. Evrience Fire brings therapy education to life."}]}, "developer_name": null, "developer_privacy_policy_url": "https://evrience.com/evrience-fire-privacy-policy", "developer_terms_of_service_url": "https://evrience.com/evrience-fire-terms-of-service/", "publisher_name": "Evrience", "support_
e=69A18E64"}]}, "id": "1229389062639602", "locale": "en_US", "screenshots": [{"file_name": "screenshot1.png", "id": "1210598511189838", "uri": "https://scontent-hkg4-2.oculuscdn.com/v/t64.5771-25/491818885_1210598514523171_4681484764980211272_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kfnsYBDhJtYQ7kNvwHAWfWv&_nc_oc=Adn-I_AZDoyx8iewMlF41Wq60SrNpj0fJqSe-LdFH1e9jDkG2L9cpdzGGbpu-HahOKs&_nc_zt=3&_nc_ht=scontent-hkg4-2.oculuscdn.com&oh=00_AfsagQZDO0W6WIrjyb8Z8fEC3GyzBb30QSkVGCOH1W7F3w&oe=69A1AA47"}, {"file_name": "screenshot2.png", "id": "2122821221796899", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/491823286_2122821225130232_7342915343237903025_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d_LBfaBj7awQ7kNvwEmfF97&_nc_oc=Admp7LgTg09gFP9xpB2aulUAoZjGvWcyVkgvvGw7AF3pEM9PM7Uchke6mfIs_4hMtI8&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&oh=00_Aft9M_bZaoA5ZPzhY6f5wxeBix-XyeF-ArIfO5DxjuGu6w&oe=69A18CC8"}, {"file_name": "screenshot3.png", "id": "2395225734324183", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/491823790_2395225740990849_9191415238963141377_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H7iPgzs5IvgQ7kNvwEcBmRK&_nc_oc=Adm-FQn5ZWjKqAqDB_ysPRpkkEJ0aB4zMm28AqBCSEVfCuImVhei4mA-pRUxHCdIdkY&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&oh=00_AfuN0DD0JPIzU4YVy4KstoPnHCcf9Pj_eb5n-qtG9inLaQ&oe=69A1A8B0"}, {"file_name": "screenshot4.png", "id": "2125408591645441", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/491820141_2125408594978774_678640502799082710_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4uhw6d5zKU4Q7kNvwGpVF_P&_nc_oc=AdlQVcM_nvDIyGWmlUOqp4TvZ0PF-4c2J_gieGKjSUUQx4UcZ2wE6VxfJuDyNAlpjLU&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&oh=00_AfvOFHZyCJcP6bwTXien_aoMo-Pby4Q51mdcGYv4zolbGw&oe=69A19274"}, {"file_name": "screenshot5.png", "id": "2099756650790305", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/491823286_2099756654123638_1317517176648265485_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v5LCje2zYJIQ7kNvwHzCpoJ&_nc_oc=AdkIH0K3RKWyGLnTR9GwUt4_z15kzCcofXs-_yBbZOBp5SwyD8HnsYoYUFmu_v5dz-M&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&oh=00_AftUMbVyzAr_b1FYqvvPI4x8SjZaABRu9FOwYb9zdx6rbg&oe=69A1957B"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Lost Rooms", "keywords": [], "long_description": "Lost Rooms is a thrilling VR game where players explore the eerie and infinite maze of the Backrooms, a series of seemingly endless, interconnected rooms with unsettling vibes. What sets Lost Rooms apart is its unique locomotion system inspired by Gorilla Tag. Instead of traditional VR movement, players use their arms and hands to physically propel themselves through the environment, climbing walls, vaulting over obstacles, and navigating tight spaces. The game combines the creepy, mysterious atmosphere of the Backrooms with the dynamic, immersive movement mechanics, making each exploration tense and exhilarating.", "short_description": "Lost Rooms is a VR game where you explore the eerie Backrooms using Gorilla Tag-style locomotion. Propel yourself through endless, unsettling rooms by physically climbing, jumping, and vaulting, blending horror with dynamic, immersive movement."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/lost-rooms-vr/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Ronkos", "support_website_url": null, "website_url": "https://sites.google.com/view/lost-rooms-vr/about", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_a
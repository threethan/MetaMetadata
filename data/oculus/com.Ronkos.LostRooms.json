492736460275258", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/86625092_492736466941924_3247671518079131392_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IpuPuQ8mzMAQ7kNvwHnNCMw&_nc_oc=AdmoHoivTr6SPgyMKOukeIWGJvmXcEAGR8qL_wovkEzvvI9nPvwE_xaRt7qsCbSez-c&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Aft53CXeNJS409MbXL0bM5ykapTzOcI6yS_T5gPAHIKYhw&oe=699DB613"}, {"file_name": "screenshot1.png", "id": "2831163313724379", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974468_2831163320391045_6625642741675889539_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h92T9QVSppYQ7kNvwG8NiOC&_nc_oc=AdlbTliaUQJVrrDBYBFVR1R0z0Xf3KsBqTRoor9-ii5Z28eTn9PDgXaCLQRLC6EyIqk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfvOgnPiMYNW1fa3vdwASaEZWVnNmjTmRnLF_uTaeiP5pw&oe=699DAA5A"}, {"file_name": "lostrooms1.png", "id": "936118161662883", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031569_936118164996216_4916112338171934752_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-b1CKhGNxuAQ7kNvwFRQXGJ&_nc_oc=AdnQjOu5u_Kpo-0lL1kMqBEq2T9OHd9bucEJVRVVLozY1P36nKn3TfS_UV8MKcfWh44&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AftKZzLBbvLPBfy8wYwj3ulLPquxvDivQz2rMf7Z0QWsag&oe=699DB722"}, {"file_name": "lostrooms2.png", "id": "8852489891448218", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031354_8852489901448217_1171953163224386872_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fM-fD49elXUQ7kNvwHJbGl7&_nc_oc=AdkLtqxbPfQXOIj0TSp9U4j0ALQ6WAJD32SdO_eQSydp-mMRnvsABO1d2Po7KPYgkZ8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Afsss1tRI-zlFrrVG5MxhthkgevsOLHrGFolGQJUe1Sx8w&oe=699D81BE"}, {"file_name": "lost rooms 3.png", "id": "1093681705759567", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982538_1093681712426233_288620176058379747_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8F3uSG7LzYcQ7kNvwHvlw0P&_nc_oc=Adn21X82aePIdJU-z5Uk_bqsY4_FOqULGbM1KnCsylgSaNzXd-aplrpmOFFVx29HuLQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfsboT3eJxlKK_oHD_HBGWOS89mFh9jxFfHQcs6b6p_qoA&oe=699D9B9F"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Lost Rooms", "keywords": [], "long_description": "Lost Rooms is a thrilling VR game where players explore the eerie and infinite maze of the Backrooms, a series of seemingly endless, interconnected rooms with unsettling vibes. What sets Lost Rooms apart is its unique locomotion system inspired by Gorilla Tag. Instead of traditional VR movement, players use their arms and hands to physically propel themselves through the environment, climbing walls, vaulting over obstacles, and navigating tight spaces. The game combines the creepy, mysterious atmosphere of the Backrooms with the dynamic, immersive movement mechanics, making each exploration tense and exhilarating.", "short_description": "Lost Rooms is a VR game where you explore the eerie Backrooms using Gorilla Tag-style locomotion. Propel yourself through endless, unsettling rooms by physically climbing, jumping, and vaulting, blending horror with dynamic, immersive movement."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/lost-rooms-vr/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Ronkos", "support_website_url": null, "website_url": "https://sites.google.com/view/lost-rooms-vr/about", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], 
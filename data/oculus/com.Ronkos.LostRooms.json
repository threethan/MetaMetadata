u_IQSv4tKQ&oe=699AF6E4"}]}, "id": "1525103788767213", "locale": "en_US", "screenshots": [{"file_name": "screenshot1.png", "id": "1040043861517259", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499299808_1040043864850592_3217614074179934021_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dj0R6aKjkqYQ7kNvwGzb-BV&_nc_oc=AdlU7IKV4wS1E1M6HBjJm52A7BxOg_hvwytlZMKGFCFFm21UOWwVC6Y35NAvbKKc3fo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AfvQ7IxiWCchEqJgfHwYy9CyW0XT65_GtOaue8-AXoV-0w&oe=699B08F2"}, {"file_name": "screenshot2.png", "id": "1197863165492437", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491819464_1197863168825770_5039759233798209748_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5JfgBSP6aisQ7kNvwEiEW6S&_nc_oc=Adkv8M0rjdtD11leBKkIkR0kHG4IIYnWj30ui-I5ZRY-tjYA8O8n9jQbckL6eNV02zQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_AftB99dk0wjWwH5Bn_E7rFRLPMrl3sSKzdBckFNsLviTXg&oe=699B078E"}, {"file_name": "screenshot3.png", "id": "843311981377250", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491818916_843311984710583_491693453362357902_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IKNT2PflpRMQ7kNvwGj4Sga&_nc_oc=AdmPEgMF6vy7ovlWAYL5EPO1LzFPDIW_mxo_TJ-lFl-SFQwATeIF2JEhPuz0r3acP-s&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_AfsKsMVT_QDj4pM6K3_HcCIx-SMvtbenLB7mbeIJCychzg&oe=699B0586"}, {"file_name": "screenshot4.png", "id": "1866509203947106", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499307962_1866509207280439_4454976256845978743_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sOB2mFKWh4oQ7kNvwEfqPnt&_nc_oc=AdnF7vNgXDeBcJlXfBfYBl4CcoxQQxSjVkn_pUKkj7Tqfqq0XOBy5bC9qXHZictSc5g&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AftpxwG4nS_lxQ8Y1DqC-Afwy-H0_TqrnS9KtHdI3DlInQ&oe=699AF696"}, {"file_name": "screenshot5.png", "id": "2012390556243241", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499303391_2012390559576574_250274696072693027_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bqGslIeSLkUQ7kNvwEnCNZT&_nc_oc=AdlkCHtu9oPE7jpmzTmN2C8Pnj1n_NAY-ya3nNASKOrmOkg4PM7X9uuKh7RYpQbymDU&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AftT6y_XjkmDfZyuN454aNXwTH65EechqiusDKYmgOP8ww&oe=699AEC97"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Lost Rooms", "keywords": [], "long_description": "Lost Rooms is a thrilling VR game where players explore the eerie and infinite maze of the Backrooms, a series of seemingly endless, interconnected rooms with unsettling vibes. What sets Lost Rooms apart is its unique locomotion system inspired by Gorilla Tag. Instead of traditional VR movement, players use their arms and hands to physically propel themselves through the environment, climbing walls, vaulting over obstacles, and navigating tight spaces. The game combines the creepy, mysterious atmosphere of the Backrooms with the dynamic, immersive movement mechanics, making each exploration tense and exhilarating.", "short_description": "Lost Rooms is a VR game where you explore the eerie Backrooms using Gorilla Tag-style locomotion. Propel yourself through endless, unsettling rooms by physically climbing, jumping, and vaulting, blending horror with dynamic, immersive movement."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/lost-rooms-vr/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Ronkos", "support_website_url": null, "website_url": "https://sites.google.com/view/lost-rooms-vr/about", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "suppo
tent-atl3-1.oculuscdn.com&oh=00_Af0LCjVKKkvmN6aBIIvTJxfCDzgeln7f4h2bkQ2SZSY8ag&oe=69F21722"}, {"file_name": "lostrooms2.png", "id": "8852489891448218", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39031354_8852489901448217_1171953163224386872_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0r_JM1EI-pYQ7kNvwFwmliz&_nc_oc=Adpy55fUbjwQKj-fOpnULcBxvdd8P8CktVWMU-5l3v9deG32iP7HL9i_zjott_6svAE&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0BQSHa7IKnwY0ly0cAtjSxNj-zUyMK2b9tTmQAV5ORYQ&oe=69F219FE"}, {"file_name": "lost rooms 3.png", "id": "1093681705759567", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38982538_1093681712426233_288620176058379747_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T7DKJ1K6FO8Q7kNvwF3WMvq&_nc_oc=AdoCmIWFlvYUJL1fCRSbR8kE6SPc1fL180ijCf_0WOJ95UUaPF0fy_8GgKpbgVnYQMs&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3QaV7geMbst5HbK6Jkk07LGa7wP9hWAIdcXg5rd1qtuA&oe=69F1FB9F"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Lost Rooms", "keywords": [], "long_description": "Lost Rooms is a thrilling VR game where players explore the eerie and infinite maze of the Backrooms, a series of seemingly endless, interconnected rooms with unsettling vibes. What sets Lost Rooms apart is its unique locomotion system inspired by Gorilla Tag. Instead of traditional VR movement, players use their arms and hands to physically propel themselves through the environment, climbing walls, vaulting over obstacles, and navigating tight spaces. The game combines the creepy, mysterious atmosphere of the Backrooms with the dynamic, immersive movement mechanics, making each exploration tense and exhilarating.", "short_description": "Lost Rooms is a VR game where you explore the eerie Backrooms using Gorilla Tag-style locomotion. Propel yourself through endless, unsettling rooms by physically climbing, jumping, and vaulting, blending horror with dynamic, immersive movement."}]}, "develo
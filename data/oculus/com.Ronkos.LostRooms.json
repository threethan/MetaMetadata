zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRDfkq-1qxV2tmRA4g1sdgZYIo83ccyAHxdf-MWBqS05g&oe=6AEC92C7"}, {"file_name": "screenshot4.png", "id": "2125408591645441", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/491820141_2125408594978774_678640502799082710_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jh9ZJwNCewAQ7kNvwFGilDT&_nc_oc=AdrcSzxaC7DQ3gQXIB0Lekef46Bq9wvsIy3ga30HQgbxOdacB1Vn6vaaLYycPvBJWbw&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRrTNfy8Wlvny1JiTzSicpRfUa4s_tIY2bQKy6USbhZAw&oe=6AECB334"}, {"file_name": "screenshot2.png", "id": "2122821221796899", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/491823286_2122821225130232_7342915343237903025_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6_eIARSBVr0Q7kNvwGjuHvs&_nc_oc=AdpuBb-dgCjTYJZaXwJBePMQ3rp0ccXqn0cixXsom0bFiNWHorzH3C6Xhl0kNyU_m0o&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSTt9oaEzK6e8YwUmWffLzGjQORj1M7v-SmN1-QSbSXkw&oe=6AECAD88"}, {"file_name": "screenshot3.png", "id": "2395225734324183", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/491823790_2395225740990849_9191415238963141377_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=blh1BakO57MQ7kNvwH7rJ3d&_nc_oc=Adp_4Zv6NaxTn5cirMRcSS7U8z_Y2F5kGXFDXhaz3IxmExwYzTdiQLshQJ3d2mJqldQ&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTieFNnI7NR33nNvFsCs0fwU4mlbENpX6O1sQOWUPF6ZQ&oe=6AEC9130"}, {"file_name": "screenshot5.png", "id": "2099756650790305", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/491823286_2099756654123638_1317517176648265485_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mK7vJ_34zZIQ7kNvwHRJlbR&_nc_oc=AdrfUtfRomVFPc_DjBQIVhylP7YwYmMf16fpzI6FJLR28fFc8Z_aLZAHp5FwnFao3KE&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTfX7hHOn8mkZV5BZ8I1Kw7h4dfwU_zJCbw-FQmlcANHg&oe=6AECB63B"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Lost Rooms", "keywords": [], "long_description": "Lost Rooms is a thrilling VR game where players explore the eerie and infinite maze of the Backrooms, a series of seemingly endless, interconnected rooms with unsettling vibes. What sets Lost Rooms apart is its unique locomotion system inspired by Gorilla Tag. Instead of traditional VR movement, players use their arms and hands to physically propel themselves through the environment, climbing walls, vaulting over obstacles, and navigating tight spaces. The game combines the creepy, mysterious atmosphere of the Backrooms with the dynamic, immersive movement mechanics, making each exploration tense and exhilarating.", "short_description": "Lost Rooms is a VR game where you explore the eerie Backrooms using Gorilla Tag-style locomotion. Propel yourself through endless, unsettling rooms by physically climbing, jumping, and vaulting, blending horror with dynamic, immersive movement."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/lost-rooms-vr/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Ronkos", "support_website_url": null, "website_url": "https://sites.google.com/view/lost-rooms-vr/about", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "28852610661037719"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-
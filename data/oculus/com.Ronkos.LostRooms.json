zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTlJtQkBmxft_KNUCK9BS8CzvbEYrMTDPpFja9XzAnqlQ&oe=6AF9C1C7"}, {"file_name": "screenshot4.png", "id": "2125408591645441", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/491820141_2125408594978774_678640502799082710_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xBmdjpSCmjcQ7kNvwGnZJBj&_nc_oc=AdoKxTiOg04ouQfrb3r9jRqfznf9ht78ThBEZedj67hZ-E4_1xbxgKfP9OZnKR9kOl4&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTIO3MQUYTOXEx1ELDUv8iaLwM01UtGx77588rrbl6nkQ&oe=6AF9E234"}, {"file_name": "screenshot2.png", "id": "2122821221796899", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/491823286_2122821225130232_7342915343237903025_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rNZeXMq-IqwQ7kNvwGS_UdW&_nc_oc=AdqGpPtHT9yJe0Ts4s2iVqQZTC3pzKhHJu-lphqxAdhMn9Rw_uxrBsBhd1e_Dtc35l4&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTbPZ5GY4mDSQs-Bdz26QdQKXPfy3ZTPXA8RtxHDFcikQ&oe=6AF9DC88"}, {"file_name": "screenshot3.png", "id": "2395225734324183", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/491823790_2395225740990849_9191415238963141377_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aricge0Oe-oQ7kNvwHAsjsI&_nc_oc=AdrfzH6uo_p-qSikFw2v43QVcZliQtPdMQEVCkgcXOl_jYmL9qPRGBGvQnzzCGUDfUQ&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTEQgI3s1q_-s_1jX1MzCTol4gMmHE4PT8WTH_H_MUx9Q&oe=6AF9C030"}, {"file_name": "screenshot5.png", "id": "2099756650790305", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/491823286_2099756654123638_1317517176648265485_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ecl5Zg-5-44Q7kNvwF8uPNp&_nc_oc=AdpNYZ2CmMJ9HKC6fd2cbe_nwHRRFyF3R5uFv_O4TDSClxo3yPWCDb6ollM3aRetQhQ&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQyrAu8SsMkTOKpHnUtLDBDPfGbdhdo0ZDt_99eHOIoOQ&oe=6AF9E53B"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Lost Rooms", "keywords": [], "long_description": "Lost Rooms is a thrilling VR game where players explore the eerie and infinite maze of the Backrooms, a series of seemingly endless, interconnected rooms with unsettling vibes. What sets Lost Rooms apart is its unique locomotion system inspired by Gorilla Tag. Instead of traditional VR movement, players use their arms and hands to physically propel themselves through the environment, climbing walls, vaulting over obstacles, and navigating tight spaces. The game combines the creepy, mysterious atmosphere of the Backrooms with the dynamic, immersive movement mechanics, making each exploration tense and exhilarating.", "short_description": "Lost Rooms is a VR game where you explore the eerie Backrooms using Gorilla Tag-style locomotion. Propel yourself through endless, unsettling rooms by physically climbing, jumping, and vaulting, blending horror with dynamic, immersive movement."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/lost-rooms-vr/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Ronkos", "support_website_url": null, "website_url": "https://sites.google.com/view/lost-rooms-vr/about", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "28852610661037719"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-
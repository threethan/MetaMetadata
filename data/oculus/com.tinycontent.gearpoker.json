q68K79VEQ7kNvwF-TvAT&_nc_oc=AdodfAie-S9NOAjB9Wmol2Wa0b91X7ZbFuVliDrjROeZ03-9RW3ser2Ludw1y6ip6GE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRCX8tX5-ctobI_bARVfcj-ztIecDbrWS2vK46eWegZFA&oe=6B0DC54B"}, {"file_name": "SS1.png", "id": "567064968072454", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982721_567064971405787_4672036885606849560_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ESI-vqEDUNwQ7kNvwGsvwj7&_nc_oc=AdpVchEl-Ul4DALmhUsqBcAECmwrYBNydch2xhLTXXfRh7dzwm-QdSTVer35pZ_t_HA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRboYtHDgLAT0GVN3OuQjzCVplToSnkPIrhTFMJ1gNfYw&oe=6B0DAE2F"}, {"file_name": "SS4.png", "id": "416647226572748", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75356792_416647229906081_8768521853214104008_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f94a4dB6hHwQ7kNvwHJVImU&_nc_oc=Adp92j_EyL4NtMd3WY_hXOB57tzZfhVXag9JcARAoXb84RQGeue5Uq11Enrsoef9Xt4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRxThjo8Yi2STBHdMcUN78R5Z2o-5kfR2LC9i5KHL-dpA&oe=6B0DB262"}, {"file_name": "SS2.png", "id": "297878989208045", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031375_297878992541378_183972035221925865_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0UCkhHF7OoUQ7kNvwGhDme6&_nc_oc=AdoL4U1lnYWMvekSndXIO8am2CT5b0DM9FwJhBU1JlMag0u4JiKkWi9dnFGSSE8Kv6Y&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQsnDgtxx49jrexsm_qmk-WRo2dstN52HEQKi-WWA_qQg&oe=6B0DA81A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover-Art-Landscape.png", "id": "1343171842862659", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39035383_1343171846195992_8932016081078023285_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_rlrbzbTuSwQ7kNvwHaok_H&_nc_oc=AdoLyckv_5Donb4vButKt4WZuhbNyOOb1wyGteNlrmyhCdBUCxulRlmkYCYef9kn_cU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSW_BAvqLXFT2m-oVgDCfjqU80xqFL7OjheyECZo6JqFA&oe=6B0DC3BF"}, "display_name": "MetaTable Poker", "keywords": ["Poker", "Casino", "MetaTable", "Card", "Social"], "long_description": "MetaTable Poker is the ultimate social card platform to play Texas Hold\u2019em in VR. Complete cross-platform with Rift, Go, Quest, and iOS.\n\nBATTLE tables, now in beta, allow you to teleport within the level and acquire weapons. Shoot your opponents out of the hand and avoid getting hit. \n\nCreate a private game and invite your friends to play with a unique PIN. You can use private tables to test your friends\u2019 poker skills or just hang out and chat in VR.\n\nFood, drink, funny hats and other objects are available for purchase. MetaTable Poker allows you to spend your hard-earned chips on unique objects. You can share these objects with your friends at the table.\n\nMetaTable Poker\u2019s features:\n\n- Realistic Texas Hold\u2019em gameplay\n- BATTLE tables blend poker and arena play\n- Voice chat\n- Private table rental\n- Cross-platform play with Oculus and iOS\n- Unique environments", "short_description": "MetaTable Poker is the ultimate social card platform to play Texas Hold\u2019em in VR. Our BATTLE tables are in beta and blend poker and combat arena style play - a truly unique twist on poker."}]}, "developer_name": "Tiny Content", "developer_privacy_policy_url": "https://www.metatable.co/privacy-policy-2021", "developer_terms_of_service_url": "https://www.metatable.co/terms-of-service", "publisher_name": "Tiny Content", "support_website_url": null, "website_url": "https://metatable.co/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "SOCIAL", "STRATEGY"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": null, "recommended_graphics": null, "recommen
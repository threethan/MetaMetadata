R9z-fg8cQ7kNvwEvupue&_nc_oc=Adox65V7sw043F555sxINAdkDwMDoAv9JhT-vTJR8ww1XbmkQEZYrVyPJmBR8DlaMYg&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTxFJm62_FZ_PYnGrAAE1GfpM1fZSlfvJEKG3LQNgZ2EA&oe=6AFC698B"}, {"file_name": "SS1.png", "id": "567064968072454", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982721_567064971405787_4672036885606849560_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zfvvpekmkOsQ7kNvwGufXHu&_nc_oc=AdqoC22yAxJKJc_rRIg_5KpR30OBcuHbHO6rEiGPPsCoIrqO_3lojr5SuhXaVHN1ut0&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRlb2ytwGzF8_lz2_Nf_UemeWG5QdqRHrQaB8O2ZHAa6g&oe=6AFC8AAF"}, {"file_name": "SS4.png", "id": "416647226572748", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75356792_416647229906081_8768521853214104008_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F9U59B9MAAQQ7kNvwGzCwqX&_nc_oc=AdoY0ij8bydVtErfnbDfObPU2NWFif1y5LxF5nPttAniGGfHFnxi39sKHL3cECWGMuU&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRwf1ZPXdctSPekmZSTLizbRkpVeX-hf3bgg96hexAdQw&oe=6AFC8EE2"}, {"file_name": "SS2.png", "id": "297878989208045", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39031375_297878992541378_183972035221925865_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5nPETc55X9kQ7kNvwGcHaKN&_nc_oc=Ado2jzc6ixGQq586OTA6c0WX-ate2xOOHgdEB0t1bP_aECt5_1kv8ehkkMo0_CXsEbY&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS6Abxfubw5bdCodiSZORfnMmgRYKr55hBE7kKVZG6FtA&oe=6AFC849A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover-Art-Landscape.png", "id": "1343171842862659", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39035383_1343171846195992_8932016081078023285_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VFZvSYZTFIoQ7kNvwFQ-vFQ&_nc_oc=AdrgJ3CVMTY5jDHTwSnf-wq0DFAXF92R7vwGl5SAKnNAQk_uKUfR0dymAR2EpV52zxE&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSMSuUdMaJP9deenFM54b14OZPBpGyYmyEVnKevNBEdJQ&oe=6AFC67FF"}, "display_name": "MetaTable Poker", "keywords": ["Poker", "Casino", "MetaTable", "Card", "Social"], "long_description": "MetaTable Poker is the ultimate social card platform to play Texas Hold\u2019em in VR. Complete cross-platform with Rift, Go, Quest, and iOS.\n\nBATTLE tables, now in beta, allow you to teleport within the level and acquire weapons. Shoot your opponents out of the hand and avoid getting hit. \n\nCreate a private game and invite your friends to play with a unique PIN. You can use private tables to test your friends\u2019 poker skills or just hang out and chat in VR.\n\nFood, drink, funny hats and other objects are available for purchase. MetaTable Poker allows you to spend your hard-earned chips on unique objects. You can share these objects with your friends at the table.\n\nMetaTable Poker\u2019s features:\n\n- Realistic Texas Hold\u2019em gameplay\n- BATTLE tables blend poker and arena play\n- Voice chat\n- Private table rental\n- Cross-platform play with Oculus and iOS\n- Unique environments", "short_description": "MetaTable Poker is the ultimate social card platform to play Texas Hold\u2019em in VR. Our BATTLE tables are in beta and blend poker and combat arena style play - a truly unique twist on poker."}]}, "developer_name": "Tiny Content", "developer_privacy_policy_url": "https://www.metatable.co/privacy-policy-2021", "developer_terms_of_service_url": "https://www.metatable.co/terms-of-service", "publisher_name": "Tiny Content", "support_website_url": null, "website_url": "https://metatable.co/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "SOCIAL", "STRATEGY"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": null, "recommended_graphics": null, "recommen
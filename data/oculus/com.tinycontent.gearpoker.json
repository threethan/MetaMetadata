": "SS1.png", "id": "567064968072454", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982721_567064971405787_4672036885606849560_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I8Y5DYDci5sQ7kNvwEG_eCE&_nc_oc=AdpdSjb-BeS954EvgkAcyuR-rbsaK8p07TfrImqq4cHWRZ4yYaGY2NYuztY3gS2xrYk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-r1tkU0p8QB5i4k-ZW2-BJr-O8mktmEJY5oAhU5b9JaA&oe=6A3A85EF"}, {"file_name": "SS4.png", "id": "416647226572748", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75356792_416647229906081_8768521853214104008_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BneVAAbFM90Q7kNvwEobfXu&_nc_oc=Adq9YL7vQ7Tg_VDtwLIDIm1Am3Lq2EG0a9I7BI0354gc28aUj_BO_pODHtyVtoJJqiA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af95UilnKdKKjciBmbkzI6ItkymYWVvS85BLLpXHKWJ0Ag&oe=6A3A8A22"}, {"file_name": "SS2.png", "id": "297878989208045", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031375_297878992541378_183972035221925865_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qHuYuV6QhIoQ7kNvwF9acCM&_nc_oc=AdqVZUp6X6CyAlB4rllkSb3_Uv0g6uvveeWhGk2Ahtj-xkDcqoCEciPvDvgRxdajWmQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_-WpeyuAsU61u_KpUw4mA8ze5Ak3lSTk5HNY0V72ELpA&oe=6A3AB81A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover-Art-Landscape.png", "id": "1343171842862659", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39035383_1343171846195992_8932016081078023285_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QM4c3GH1TegQ7kNvwEO5Y18&_nc_oc=AdrIw4Mm_vDF4P3JHHbE2AxEWHLQjy7caVa2QwzzwPrh1gHcXjUOiu0updMKzC8VUSw&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8B_q2mhhae82UALiLyTd0pokDJmfGmBE1JeJ01vQ26SA&oe=6A3A9B7F"}, "display_name": "MetaTable Poker", "keywords": ["Poker", "Casino", "MetaTable", "Card", "Social"], "long_description": "MetaTable Poker is the ultimate social card platform to play Texas Hold\u2019em in VR. Complete cross-platform with Rift, Go, Quest, and iOS.\n\nBATTLE tables, now in beta, allow you to teleport within the level and acquire weapons. Shoot your opponents out of the hand and avoid getting hit. \n\nCreate a private game and invite your friends to play with a unique PIN. You can use private tables to test your friends\u2019 poker skills or just hang out and chat in VR.\n\nFood, drink, funny hats and other objects are available for purchase. MetaTable Poker allows you to spend your hard-earned chips on unique objects. You can share these objects with your friends at the table.\n\nMetaTable Poker\u2019s features:\n\n- Realistic Texas Hold\u2019em gameplay\n- BATTLE tables blend poker and arena play\n- Voice chat\n- Private table rental\n- Cross-platform play with Oculus and iOS\n- Unique environments", "short_description": "MetaTable Poker is the ultimate social card platform to play Texas Hold\u2019em in VR. Our BATTLE tables are in beta and blend poker and combat arena style play - a truly unique twist on poker."}]}, "developer_name": "Tiny Content", "developer_privacy_policy_url": "https://www.metatable.co/privacy-policy-2021", "developer_terms_of_service_url": "https://www.metatable.co/terms-of-service", "publisher_name": "Tiny Content", "support_website_url": null, "website_url": "https://metatable.co/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "SOCIAL", "STRATEGY"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD", "GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER"], "id": "538055247693393"}, "review_messages": []}]}, "cover_square
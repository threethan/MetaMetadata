": "SS1.png", "id": "567064968072454", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982721_567064971405787_4672036885606849560_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Xw2aUtsBrHsQ7kNvwEZBrAt&_nc_oc=AdqohmskzDzuSK4iSIIO6ZitAEQEuhulXU_92gZ9gsfg4SxzANXbT0ehrR2jWXSt2rk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO6Oa1k5Ngz-IZWLZehf8I-fNL74JSdStZLEYi72WzBFA&oe=6AD25AAF"}, {"file_name": "SS4.png", "id": "416647226572748", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75356792_416647229906081_8768521853214104008_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=73u3vJH_62cQ7kNvwGaaHkU&_nc_oc=AdoPJalLRXj-koXlX5BqPOSrmpfvPHmk3Rr-RZ6E7Rxj78DL21m-k4fLt9kr0EhdTaE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOcxKi5hTXKqqHm1Dq67u-U01hO2MjDflozLax1BsPsqA&oe=6AD226A2"}, {"file_name": "SS2.png", "id": "297878989208045", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031375_297878992541378_183972035221925865_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l6KUUrxYA2wQ7kNvwHnjlBQ&_nc_oc=AdqinOqOSoZUvxU4MAKJbWt3U6YfvExzrjc8Dkt7PNcZvsI04p-8lJP_qtVcISXA1L0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM1_l8-59KgD3SKgKtyj5e5uqD6ls8X8-iUPfWszcvtjA&oe=6AD2549A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover-Art-Landscape.png", "id": "1343171842862659", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39035383_1343171846195992_8932016081078023285_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UB3sswZjXTIQ7kNvwEae-O2&_nc_oc=AdrLNPzQpkjQyDEow8P6ojVLOQpE4gOc8WOBI0v7tPwpAOuNfYSyq-XicjCu0uiExlA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMybOCgsZLtf9-OzLpQ_sqepFDAK5uqarpuyETfR2Y1cA&oe=6AD237FF"}, "display_name": "MetaTable Poker", "keywords": ["Poker", "Casino", "MetaTable", "Card", "Social"], "long_description": "MetaTable Poker is the ultimate social card platform to play Texas Hold\u2019em in VR. Complete cross-platform with Rift, Go, Quest, and iOS.\n\nBATTLE tables, now in beta, allow you to teleport within the level and acquire weapons. Shoot your opponents out of the hand and avoid getting hit. \n\nCreate a private game and invite your friends to play with a unique PIN. You can use private tables to test your friends\u2019 poker skills or just hang out and chat in VR.\n\nFood, drink, funny hats and other objects are available for purchase. MetaTable Poker allows you to spend your hard-earned chips on unique objects. You can share these objects with your friends at the table.\n\nMetaTable Poker\u2019s features:\n\n- Realistic Texas Hold\u2019em gameplay\n- BATTLE tables blend poker and arena play\n- Voice chat\n- Private table rental\n- Cross-platform play with Oculus and iOS\n- Unique environments", "short_description": "MetaTable Poker is the ultimate social card platform to play Texas Hold\u2019em in VR. Our BATTLE tables are in beta and blend poker and combat arena style play - a truly unique twist on poker."}]}, "developer_name": "Tiny Content", "developer_privacy_policy_url": "https://www.metatable.co/privacy-policy-2021", "developer_terms_of_service_url": "https://www.metatable.co/terms-of-service", "publisher_name": "Tiny Content", "support_website_url": null, "website_url": "https://metatable.co/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "SOCIAL", "STRATEGY"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD", "GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER"], "id": "538055247693393"}, "review_messages": []}]}, "cover_square
cdn.com/v/t64.5771-25/12138999_190603405083887_1986441023147999232_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=90wEdhZ6gu0Q7kNvwE7dutj&_nc_oc=AdnmcuFAS48DTQ2xZSQIZgZq3bQUpnDO-3cDIP4tAAG5zFmaocPpxj4_c-q6Xoke7h0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AftiAlzK0YPoyOulsGdt_Zt68XGFsrB2lDNQAZththRwAw&oe=69A2C9B9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "SS6.png", "id": "2044551719096029", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/12138999_2044551722429362_8817000776976039936_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LnH0V8mG7kIQ7kNvwF-XA2l&_nc_oc=AdkhnVMwQDgyCq2tMI5lerS3BVCYW2OlmFFEdqV2JSpLdMy6JeYp6rebcXMvcWK1_ds&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afs142nhvJUh5vo_eHfpHlmGcNfUBXkii_04TZvCQE7ZDA&oe=69A2FC01"}, "display_name": "MetaTable Poker", "keywords": ["Poker", "Casino", "MetaTable", "Card", "Social"], "long_description": "MetaTable Poker is the ultimate social card platform to play Texas Hold\u2019em in VR. Compete against your friends and other Gear, Go and Oculus players in 4 unique environments.\n\nAs the first platform to offer private tables for rent by the hour, MetaTable Poker allows you create a game and invite your friends to play by providing them with a unique PIN number. You can use private tables to test your friends\u2019 poker skills or just hang out and chat in VR.\n\nAnd what\u2019s a poker game without food, drink, funny hats and other objects to play with? MetaTable Poker allows you to spend your hard-earned chips on 32 unique objects. You can share these objects with your friends at the table.\n\nSome of MetaTable Poker\u2019s features:\n\n- Realistic Texas Hold\u2019em gameplay\n- Oculus Avatar support\n- Voice chat\n- Private table rental\n- Objects to purchase with your chips\n- 4 unique environments", "short_description": "MetaTable Poker is the ultimate social card platform to play Texas Hold\u2019em in VR."}]}, "developer_name": "Tiny Content", "developer_p
": "SS1.png", "id": "567064968072454", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982721_567064971405787_4672036885606849560_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YZg65TX1dOYQ7kNvwGQqG8M&_nc_oc=AdoYrsmiraGhnEqMsr1eGhbs-Mf4J0hUK0tLKBNBR4fDTklvfJCBdLS3oVpYvUy360A&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB72tmNNjl3vOMzK4A8sF5mEnCeSY1QLYsjrVcMw6xzFg&oe=6A68AA6F"}, {"file_name": "SS4.png", "id": "416647226572748", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/75356792_416647229906081_8768521853214104008_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sORDFe5SPu8Q7kNvwHqU0Ie&_nc_oc=Adry8as-UvpjFuYz5UaU4GgH2Tp1Vpg2N1TWnfys5FBsk_JJcdSegfB_a3mcPmRvJFc&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBKCbzlOKMST67YM-ckQkNP15eAnhKX-lCrMHUxXjvJkg&oe=6A68AEA2"}, {"file_name": "SS2.png", "id": "297878989208045", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/39031375_297878992541378_183972035221925865_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KTYxkvu4lhoQ7kNvwEymYat&_nc_oc=AdqV6ADUTBymUYkRCzQ2SZOaWu3bsacZ3M-vvPKmyO7iLEfkEhTsi0fEF4DPOp5gG7U&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAX1Aa3wUqgL9DHELnnN9M3LSRb_hv1zBAJgFS1W42TVQ&oe=6A68A45A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover-Art-Landscape.png", "id": "1343171842862659", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39035383_1343171846195992_8932016081078023285_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MRJHtdrFhboQ7kNvwGcTzdp&_nc_oc=AdrwVjk8yPvFYxlDgQr046q2qoD1iMMXQWPj47lpWCasYYLq7zmb7MmU1cKQ2uy4RuQ&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDpcm_sOhrw4HYk9zAMYl1tnt0Iv-c1WvYuGM00ZZrYbQ&oe=6A68BFFF"}, "display_name": "MetaTable Poker", "keywords": ["Poker", "Casino", "MetaTable", "Card", "Social"], "long_description": "MetaTable Poker is the ultimate social card platform to play Texas Hold\u2019em in VR. Complete cross-platform with Rift, Go, Quest, and iOS.\n\nBATTLE tables, now in beta, allow you to teleport within the level and acquire weapons. Shoot your opponents out of the hand and avoid getting hit. \n\nCreate a private game and invite your friends to play with a unique PIN. You can use private tables to test your friends\u2019 poker skills or just hang out and chat in VR.\n\nFood, drink, funny hats and other objects are available for purchase. MetaTable Poker allows you to spend your hard-earned chips on unique objects. You can share these objects with your friends at the table.\n\nMetaTable Poker\u2019s features:\n\n- Realistic Texas Hold\u2019em gameplay\n- BATTLE tables blend poker and arena play\n- Voice chat\n- Private table rental\n- Cross-platform play with Oculus and iOS\n- Unique environments", "short_description": "MetaTable Poker is the ultimate social card platform to play Texas Hold\u2019em in VR. Our BATTLE tables are in beta and blend poker and combat arena style play - a truly unique twist on poker."}]}, "developer_name": "Tiny Content", "developer_privacy_policy_url": "https://www.metatable.co/privacy-policy-2021", "developer_terms_of_service_url": "https://www.metatable.co/terms-of-service", "publisher_name": "Tiny Content", "support_website_url": null, "website_url": "https://metatable.co/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "SOCIAL", "STRATEGY"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD", "GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER"], "id": "538055247693393"}, "review_messages": []}]}, "cover_square
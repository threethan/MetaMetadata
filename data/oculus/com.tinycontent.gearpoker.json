tbbhAKPsQ7kNvwGSU7F8&_nc_oc=AdrWD6pM_SAgBvi4KsvBEuOFy55UtFI2vjrHO8qj1eC8pdVtucJU7P841uM-uQ2__Qw&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR2eyVPwfsmzTx0LoYPJE8JJOGmgAIrxnRJsNZPCcnmww&oe=6B08470B"}, {"file_name": "SS1.png", "id": "567064968072454", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/38982721_567064971405787_4672036885606849560_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2zOevos9V-oQ7kNvwHdwxK-&_nc_oc=AdrweoyTp_uk8w-QP9tW5ByHrUusAF9Z_kcAZy3QqRDFc5ooYsSTriMn9Ir2aox5lcQ&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQi0ApbH2haNi97hsLPjJxZInDTArMf0l8e39F9ttIY-Q&oe=6B08682F"}, {"file_name": "SS4.png", "id": "416647226572748", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/75356792_416647229906081_8768521853214104008_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tI3yJY5aD08Q7kNvwFiL7za&_nc_oc=Adomrq9Z_TbG2cUGWyrTS00hEb5qpC3tXYUBu9gbDcGVLspzEBnGdBpGir6Whph9IRA&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQJTNzzZegfymhw7eDacuovhje4T6OwZdlCyNokk4MJGQ&oe=6B086C62"}, {"file_name": "SS2.png", "id": "297878989208045", "uri": "https://scontent-dfw5-3.oculuscdn.com/v/t64.5771-25/39031375_297878992541378_183972035221925865_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cQK98cA1NcYQ7kNvwEaVxku&_nc_oc=Adq5hXJJA5iD-RMDkWLJQ1UTr9I4lLXvY0_lEY8oUlslSkmPsZTqtBmocPE0sDIHigI&_nc_zt=3&_nc_ht=scontent-dfw5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSL5hrSZPuADLTegZNQnwDT-SuHb3UyTykdxscq7SSU-A&oe=6B08621A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover-Art-Landscape.png", "id": "1343171842862659", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39035383_1343171846195992_8932016081078023285_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R4ocG0SZWzIQ7kNvwHlQpr2&_nc_oc=AdpzY8oIZ1xEVrieZ_ZUiEC-qecKMdbld43wPJdlTLcQ08TMsUmgtKzwWZN2W4IZAyE&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSsjvWpLLe_v3-SPuTcwlsbUmieSGEE5TimA0fIlOWhGA&oe=6B08457F"}, "display_name": "MetaTable Poker", "keywords": ["Poker", "Casino", "MetaTable", "Card", "Social"], "long_description": "MetaTable Poker is the ultimate social card platform to play Texas Hold\u2019em in VR. Complete cross-platform with Rift, Go, Quest, and iOS.\n\nBATTLE tables, now in beta, allow you to teleport within the level and acquire weapons. Shoot your opponents out of the hand and avoid getting hit. \n\nCreate a private game and invite your friends to play with a unique PIN. You can use private tables to test your friends\u2019 poker skills or just hang out and chat in VR.\n\nFood, drink, funny hats and other objects are available for purchase. MetaTable Poker allows you to spend your hard-earned chips on unique objects. You can share these objects with your friends at the table.\n\nMetaTable Poker\u2019s features:\n\n- Realistic Texas Hold\u2019em gameplay\n- BATTLE tables blend poker and arena play\n- Voice chat\n- Private table rental\n- Cross-platform play with Oculus and iOS\n- Unique environments", "short_description": "MetaTable Poker is the ultimate social card platform to play Texas Hold\u2019em in VR. Our BATTLE tables are in beta and blend poker and combat arena style play - a truly unique twist on poker."}]}, "developer_name": "Tiny Content", "developer_privacy_policy_url": "https://www.metatable.co/privacy-policy-2021", "developer_terms_of_service_url": "https://www.metatable.co/terms-of-service", "publisher_name": "Tiny Content", "support_website_url": null, "website_url": "https://metatable.co/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "SOCIAL", "STRATEGY"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": null, "recommended_graphics": null, "recommen
405787_4672036885606849560_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZnDpbRpCyUMQ7kNvwHMPEMJ&_nc_oc=Adk_-xkkVO12y7GBucM1W_odQv7yy_o0yNK1CCw-mYZMqkVKBE7Y9KUTuKfTAgcOnSA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_AfvL92iuqLNiw2UuygfbVeoh5pPIkvYduAJse9OW4op8Sg&oe=699C51EF"}, {"file_name": "SS4.png", "id": "416647226572748", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75356792_416647229906081_8768521853214104008_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aWtwBJseHbsQ7kNvwH-7KLB&_nc_oc=Adm_9_EwlU95dXfCiCAbwQFMd8pttAKGfmUUYXlpi0ID_WreTW3TEIjxCVekq0mEAFM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_AfvC6wDCg-hCAwUiH3dL65YxxivummSEvcAkoKbrZyj1Pw&oe=699C5622"}, {"file_name": "SS2.png", "id": "297878989208045", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031375_297878992541378_183972035221925865_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lH2tGEzKPesQ7kNvwHsHaPM&_nc_oc=AdmzaLSxJm8W6_-tqC07JubtMTz4za7YxtcE-Dxen0F_uq8QXvZEG-ffvBKff0gyjio&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfstlDvMrvMhtHujDOkeZPoBSZ2fmOihq1cQiKmJGmvF-A&oe=699C4BDA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover-Art-Landscape.png", "id": "1343171842862659", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39035383_1343171846195992_8932016081078023285_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=01iSMLdwMIEQ7kNvwHKKbQz&_nc_oc=AdnJJ6lzenT9U2IuWvArQS9B1jNnK2BP8nJ-BHSDWW4q8waxqmlM6GJWZJ3Y89aF26g&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfvgJs5AcyV8HOer4Sp1uPLb7ph5o-FCbxoDy29PnDeC2g&oe=699C677F"}, "display_name": "MetaTable Poker", "keywords": ["Poker", "Casino", "MetaTable", "Card", "Social"], "long_description": "MetaTable Poker is the ultimate social card platform to play Texas Hold\u2019em in VR. Complete cross-platform with Rift, Go, Quest, and iOS.\n\nBATTLE tables, now in beta, allow you to teleport within the level and acquire weapons. Shoot your opponents out of the hand and avoid getting hit. \n\nCreate a private game and invite your friends to play with a unique PIN. You can use private tables to test your friends\u2019 poker skills or just hang out and chat in VR.\n\nFood, drink, funny hats and other objects are available for purchase. MetaTable Poker allows you to spend your hard-earned chips on unique objects. You can share these objects with your friends at the table.\n\nMetaTable Poker\u2019s features:\n\n- Realistic Texas Hold\u2019em gameplay\n- BATTLE tables blend poker and arena play\n- Voice chat\n- Private table rental\n- Cross-platform play with Oculus and iOS\n- Unique environments", "short_description": "MetaTable Poker is the ultimate social card platform to play Texas Hold\u2019em in VR. Our BATTLE tables are in beta and blend poker and combat arena style play - a truly unique twist on poker."}]}, "developer_name": "Tiny Content", "developer_privacy_policy_url": "https://www.metatable.co/privacy-policy-2021", "developer_terms_of_service_url": "https://www.metatable.co/terms-of-service", "publisher_name": "Tiny Content", "support_website_url": null, "website_url": "https://metatable.co/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "SOCIAL", "STRATEGY"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD", "GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER"], "id": "538055247693393"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982700_544722633940406_5083385246360528834_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&_nc_sid
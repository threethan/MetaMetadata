405787_4672036885606849560_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i3SRhJq9G54Q7kNvwFICIVO&_nc_oc=Adm-Ru9S1zEo9TKOpHQ_wdO6D1M3tJ5hvQgosxqwwrt1Thti3BpWixCCEAuzm7T_3LA&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_Afv3U6VQe6pbuC5HqfCWLBCmz9B8YcZt2WwDE_v3-kAB8Q&oe=69A58C6F"}, {"file_name": "SS4.png", "id": "416647226572748", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75356792_416647229906081_8768521853214104008_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wIkCCC4mDHAQ7kNvwF6FeEg&_nc_oc=AdkMnh9nz853arxroaw0xYlbTXrVKuSBREPjaMbph8eO9X_hjLL1ZMrhYkAE_BqH8s8&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_AfsnQFoaMgFlPNAQSIH5GpKz-rB6z8facIv92pTo6uGSyg&oe=69A590A2"}, {"file_name": "SS2.png", "id": "297878989208045", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39031375_297878992541378_183972035221925865_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2Xxp0JWkfhoQ7kNvwGnEbT-&_nc_oc=AdlK0KFK9OVTUfFHjdMCDFBeE2AcsEy22G6s9xBuMRwKJIuPgrriP4XI-9w0GgxqoGY&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&oh=00_AfuOC2lE0X5FqhAkZYqUd64bXtqxCHaroBpTAe5hcUCHTA&oe=69A5865A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover-Art-Landscape.png", "id": "1343171842862659", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39035383_1343171846195992_8932016081078023285_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WuFDFogwXuoQ7kNvwHQ9mFm&_nc_oc=AdnSE4szypS-gFTb1pfOMjTGrm1RsPvAHGSw-6N0UXdsuY4J8CezpBYj4aKsmoPAM6I&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_AftKw2SZ7aFnxqLzcQo558oxq1z_NK2ZOLXbqvzFU6vOyg&oe=69A569BF"}, "display_name": "MetaTable Poker", "keywords": ["Poker", "Casino", "MetaTable", "Card", "Social"], "long_description": "MetaTable Poker is the ultimate social card platform to play Texas Hold\u2019em in VR. Complete cross-platform with Rift, Go, Quest, and iOS.\n\nBATTLE tables, now in beta, allow you to teleport within the level and acquire weapons. Shoot your opponents out of the hand and avoid getting hit. \n\nCreate a private game and invite your friends to play with a unique PIN. You can use private tables to test your friends\u2019 poker skills or just hang out and chat in VR.\n\nFood, drink, funny hats and other objects are available for purchase. MetaTable Poker allows you to spend your hard-earned chips on unique objects. You can share these objects with your friends at the table.\n\nMetaTable Poker\u2019s features:\n\n- Realistic Texas Hold\u2019em gameplay\n- BATTLE tables blend poker and arena play\n- Voice chat\n- Private table rental\n- Cross-platform play with Oculus and iOS\n- Unique environments", "short_description": "MetaTable Poker is the ultimate social card platform to play Texas Hold\u2019em in VR. Our BATTLE tables are in beta and blend poker and combat arena style play - a truly unique twist on poker."}]}, "developer_name": "Tiny Content", "developer_privacy_policy_url": "https://www.metatable.co/privacy-policy-2021", "developer_terms_of_service_url": "https://www.metatable.co/terms-of-service", "publisher_name": "Tiny Content", "support_website_url": null, "website_url": "https://metatable.co/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "SOCIAL", "STRATEGY"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD", "GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER"], "id": "538055247693393"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38982700_544722633940406_5083385246360528834_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&_nc_sid
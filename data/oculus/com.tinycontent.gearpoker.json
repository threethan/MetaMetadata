405787_4672036885606849560_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EIzdPXhXe7EQ7kNvwGv3nTN&_nc_oc=Adn8Pn1zAdD_D8i2qzcxC5qIL7KCJmLf_yqhhEEjh8w5_7GkJNPUpxr00QbkBcm4bI0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&oh=00_Afs7VDs__eY5XHU91YJBgVUHX2SAdiqSEe4RIvEZsPg13g&oe=69985D6F"}, {"file_name": "SS4.png", "id": "416647226572748", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75356792_416647229906081_8768521853214104008_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W0wuvJl_gbsQ7kNvwG7rwRH&_nc_oc=Adn4A2cNtR3osvky0mB1EjMCg0XcAmqqol8WDGZ41N_ux9uAl0QxwiEKj1TxYvWlI8Y&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&oh=00_Aft5eJt8RJgbw48h2N8jHg79oXmR8wtOseUbOBLXKgd7fg&oe=699861A2"}, {"file_name": "SS2.png", "id": "297878989208045", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39031375_297878992541378_183972035221925865_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Lu7zBIDKjAYQ7kNvwGhx4D0&_nc_oc=Adn308bXaHPH6c3qFkqtOQqE6mL67p4jwlTE2XMVo4F6YtI7ly4PCskb74FOzWLukqo&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&oh=00_AfucTFZYS96gI_FAkALdp3YeBviGobTL4wn0D4Hg9QkQ1g&oe=6998575A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover-Art-Landscape.png", "id": "1343171842862659", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39035383_1343171846195992_8932016081078023285_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1deJHkBRDnAQ7kNvwH-e0Q8&_nc_oc=AdmRIqUO_X4DRNO5SuoN1OSjUCJUx0dzFVUAZtCVSFzEQ8UCTgX_J-fi3IfEdh473o4&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&oh=00_Afsoiyn1a2g8ekw1teGTkGJNMEABGesYp-zxk2BFtlOiCA&oe=699872FF"}, "display_name": "MetaTable Poker", "keywords": ["Poker", "Casino", "MetaTable", "Card", "Social"], "long_description": "MetaTable Poker is the ultimate social card platform to play Texas Hold\u2019em in VR. Complete cross-platform with Rift, Go, Quest, and iOS.\n\nBATTLE tables, now in beta, allow you to teleport within the level and acquire weapons. Shoot your opponents out of the hand and avoid getting hit. \n\nCreate a private game and invite your friends to play with a unique PIN. You can use private tables to test your friends\u2019 poker skills or just hang out and chat in VR.\n\nFood, drink, funny hats and other objects are available for purchase. MetaTable Poker allows you to spend your hard-earned chips on unique objects. You can share these objects with your friends at the table.\n\nMetaTable Poker\u2019s features:\n\n- Realistic Texas Hold\u2019em gameplay\n- BATTLE tables blend poker and arena play\n- Voice chat\n- Private table rental\n- Cross-platform play with Oculus and iOS\n- Unique environments", "short_description": "MetaTable Poker is the ultimate social card platform to play Texas Hold\u2019em in VR. Our BATTLE tables are in beta and blend poker and combat arena style play - a truly unique twist on poker."}]}, "developer_name": "Tiny Content", "developer_privacy_policy_url": "https://www.metatable.co/privacy-policy-2021", "developer_terms_of_service_url": "https://www.metatable.co/terms-of-service", "publisher_name": "Tiny Content", "support_website_url": null, "website_url": "https://metatable.co/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "SOCIAL", "STRATEGY"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD", "GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER"], "id": "538055247693393"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982700_544722633940406_5083385246360528834_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&_nc_sid
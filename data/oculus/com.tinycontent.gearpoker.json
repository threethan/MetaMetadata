": "SS1.png", "id": "567064968072454", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982721_567064971405787_4672036885606849560_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pjCAw6xXCX0Q7kNvwEUexqO&_nc_oc=Adqvqr03jdg_RaeVSr7sh_Jvhmi8yEg-J7-ndOmcSJNB_wgB4aRCKc8XuA9bBNKGqaY&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAvUGFcz-iqq832-xP3XShc9C7wMjP16jW4QnWDC3DnKg&oe=6A53926F"}, {"file_name": "SS4.png", "id": "416647226572748", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/75356792_416647229906081_8768521853214104008_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wljCgoM9tzAQ7kNvwGjDBe0&_nc_oc=Adpq9uekp-3LcmYApbwtCijA6s-tc5eycR0NFZVQlErDbAyTob2rMALEbv86fNKGjpU&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAOKxU0kdqKbthUm_V4MNk8P2zRQ5oHZLP2RdHoBZFcEg&oe=6A5396A2"}, {"file_name": "SS2.png", "id": "297878989208045", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/39031375_297878992541378_183972035221925865_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FLywHjUsgY0Q7kNvwEFERGS&_nc_oc=AdqWEGBmE7WA2e_fGUZbr_xXq_eW4gnzdglSehaMj1y150PfCCTjd_Hnahb5wbaTT2g&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBWubGrTjEoKCejqefRqSm-3ORiaIiEP5YfKb03ed6iCg&oe=6A538C5A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover-Art-Landscape.png", "id": "1343171842862659", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39035383_1343171846195992_8932016081078023285_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Cd85kjdZn_AQ7kNvwF_XZ_0&_nc_oc=Adp49CI_-1Dp72kBOhNoOyrIoBU9431y4MFx1C-qXN3_NQM4tlxS3LoOUZ5krNBzlAs&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAUBAT4lI-tgfLZhke7GJoEJ0L2ccuJ6-pBRd6ATI_0fw&oe=6A53A7FF"}, "display_name": "MetaTable Poker", "keywords": ["Poker", "Casino", "MetaTable", "Card", "Social"], "long_description": "MetaTable Poker is the ultimate social card platform to play Texas Hold\u2019em in VR. Complete cross-platform with Rift, Go, Quest, and iOS.\n\nBATTLE tables, now in beta, allow you to teleport within the level and acquire weapons. Shoot your opponents out of the hand and avoid getting hit. \n\nCreate a private game and invite your friends to play with a unique PIN. You can use private tables to test your friends\u2019 poker skills or just hang out and chat in VR.\n\nFood, drink, funny hats and other objects are available for purchase. MetaTable Poker allows you to spend your hard-earned chips on unique objects. You can share these objects with your friends at the table.\n\nMetaTable Poker\u2019s features:\n\n- Realistic Texas Hold\u2019em gameplay\n- BATTLE tables blend poker and arena play\n- Voice chat\n- Private table rental\n- Cross-platform play with Oculus and iOS\n- Unique environments", "short_description": "MetaTable Poker is the ultimate social card platform to play Texas Hold\u2019em in VR. Our BATTLE tables are in beta and blend poker and combat arena style play - a truly unique twist on poker."}]}, "developer_name": "Tiny Content", "developer_privacy_policy_url": "https://www.metatable.co/privacy-policy-2021", "developer_terms_of_service_url": "https://www.metatable.co/terms-of-service", "publisher_name": "Tiny Content", "support_website_url": null, "website_url": "https://metatable.co/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "SOCIAL", "STRATEGY"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD", "GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER"], "id": "538055247693393"}, "review_messages": []}]}, "cover_square
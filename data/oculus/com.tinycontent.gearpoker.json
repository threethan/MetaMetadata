tbbhAKPsQ7kNvwF0QQF3&_nc_oc=Ado3zdBXz-0rdnq4oYU9ck5SaxA0XkXK_ApI8YCQBEVzztcX-ASZ-DIOMDhhBwRrO2s&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQX-3nNkp8-HY1Uo13TrYfPRZUONUdag5eklfO5uGz2yg&oe=6B06F58B"}, {"file_name": "SS1.png", "id": "567064968072454", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982721_567064971405787_4672036885606849560_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=psE3T_kIHx0Q7kNvwEuRaDU&_nc_oc=AdolklurPHQdF3erzdT8jtoXZdMPMs2RtL_luXVi7ALbw_MlIkRYxkpEldo_PdIvnrw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTHZxEV5k_7K4E8mRlivjRvk1r7OItwC4qEE3Dv0GkKVA&oe=6B0716AF"}, {"file_name": "SS4.png", "id": "416647226572748", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75356792_416647229906081_8768521853214104008_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tI3yJY5aD08Q7kNvwG5KRbb&_nc_oc=AdqUXu0Zy8nXcq4Rhzh3TMfGNzRfkIClT5AIGgpl4wa4AkwUuIo6Lli9d8uR7D9n1ZI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRXR21x1Hb9fGTX5FUJdTS4A1DmZnY8BdjTkw8-PkNW2w&oe=6B071AE2"}, {"file_name": "SS2.png", "id": "297878989208045", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031375_297878992541378_183972035221925865_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DbsEvHjbvCAQ7kNvwHMTndE&_nc_oc=Adp0aDvRFuJMqggMtyryyhJyaV-Wrd1-oNqRSSyHx8mnNxRR1toJeYLYwqavy1Cc4PA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSF-23JtXFQjVDgSI8N-jGTyLsWwd-qTGoHiBXoQzSbUA&oe=6B07109A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover-Art-Landscape.png", "id": "1343171842862659", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39035383_1343171846195992_8932016081078023285_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nIIN0RsvVRMQ7kNvwEi-omU&_nc_oc=AdrDVCPsR01rFYMCX7x_ehYmGUhvl0aslPtLZmJbQQdNlRgsYB9pqxGCxu8Ae1W7q6w&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTWdfdT_yoLbTujSDb61rGv3BpLKgHgoQOMkMFyACwrUw&oe=6B06F3FF"}, "display_name": "MetaTable Poker", "keywords": ["Poker", "Casino", "MetaTable", "Card", "Social"], "long_description": "MetaTable Poker is the ultimate social card platform to play Texas Hold\u2019em in VR. Complete cross-platform with Rift, Go, Quest, and iOS.\n\nBATTLE tables, now in beta, allow you to teleport within the level and acquire weapons. Shoot your opponents out of the hand and avoid getting hit. \n\nCreate a private game and invite your friends to play with a unique PIN. You can use private tables to test your friends\u2019 poker skills or just hang out and chat in VR.\n\nFood, drink, funny hats and other objects are available for purchase. MetaTable Poker allows you to spend your hard-earned chips on unique objects. You can share these objects with your friends at the table.\n\nMetaTable Poker\u2019s features:\n\n- Realistic Texas Hold\u2019em gameplay\n- BATTLE tables blend poker and arena play\n- Voice chat\n- Private table rental\n- Cross-platform play with Oculus and iOS\n- Unique environments", "short_description": "MetaTable Poker is the ultimate social card platform to play Texas Hold\u2019em in VR. Our BATTLE tables are in beta and blend poker and combat arena style play - a truly unique twist on poker."}]}, "developer_name": "Tiny Content", "developer_privacy_policy_url": "https://www.metatable.co/privacy-policy-2021", "developer_terms_of_service_url": "https://www.metatable.co/terms-of-service", "publisher_name": "Tiny Content", "support_website_url": null, "website_url": "https://metatable.co/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "SOCIAL", "STRATEGY"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": null, "recommended_graphics": null, "recommen
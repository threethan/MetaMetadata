q68K79VEQ7kNvwEcT8Dw&_nc_oc=AdruOmhZN9PJCBoLnDnqfj15Kn0vWybP8MZaTGNX57FPwJzlh0ajOZs657yv-6lpPgU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWWNnRLOxhY_uGoAtmT11yUH-fHVlnRnmA-nhhYwrA6og&oe=6B10684B"}, {"file_name": "SS1.png", "id": "567064968072454", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982721_567064971405787_4672036885606849560_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w5abR4y-bcAQ7kNvwGOJX89&_nc_oc=AdpR9WlSUZuqbEjDwZYdjl7lT_e2npKRsG3J-2vfC3vrfOupNjmzr4Olko6V7v4dpv0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQW5w3zQWPErNps-2352nLCaHUVPT7Ls9qKkpArLe1Ak0A&oe=6B10512F"}, {"file_name": "SS4.png", "id": "416647226572748", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75356792_416647229906081_8768521853214104008_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f94a4dB6hHwQ7kNvwGwgfwL&_nc_oc=Adrd2Bp-Mwcs7kPdcoTqy5FL5yxtm2hxNO2333t10KsjHn7QCjwuAy7al_x3gIN_6-c&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXfsaVjtvwLKKp1x5KFHMzkmiJHB7bs-uQ0aSvxf9pjhw&oe=6B105562"}, {"file_name": "SS2.png", "id": "297878989208045", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031375_297878992541378_183972035221925865_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VlXv1hXzk1wQ7kNvwGJVWHA&_nc_oc=Adqhe61016HzNYn4R4hBvTEGYEoQT62IzV5usldpbQ3_diaxCbrjWovm6z8Upytflbo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQV6S7zJJpHjPin4IgfOqUvXbaavpsS9MERKp2rJsBikMg&oe=6B104B1A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover-Art-Landscape.png", "id": "1343171842862659", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39035383_1343171846195992_8932016081078023285_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yMD0SgJztqwQ7kNvwFXfdff&_nc_oc=AdpcmFRvYXn6Qk43A0NUVw6GXwcoy3UiQPACt_6TX7ClJ_UbQoMQduF7oEGBFLvwrXU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQUHpmQ-5-5NsW3OFKc5v0W5Avwrqkp-O9nhSLDqga2SCQ&oe=6B1066BF"}, "display_name": "MetaTable Poker", "keywords": ["Poker", "Casino", "MetaTable", "Card", "Social"], "long_description": "MetaTable Poker is the ultimate social card platform to play Texas Hold\u2019em in VR. Complete cross-platform with Rift, Go, Quest, and iOS.\n\nBATTLE tables, now in beta, allow you to teleport within the level and acquire weapons. Shoot your opponents out of the hand and avoid getting hit. \n\nCreate a private game and invite your friends to play with a unique PIN. You can use private tables to test your friends\u2019 poker skills or just hang out and chat in VR.\n\nFood, drink, funny hats and other objects are available for purchase. MetaTable Poker allows you to spend your hard-earned chips on unique objects. You can share these objects with your friends at the table.\n\nMetaTable Poker\u2019s features:\n\n- Realistic Texas Hold\u2019em gameplay\n- BATTLE tables blend poker and arena play\n- Voice chat\n- Private table rental\n- Cross-platform play with Oculus and iOS\n- Unique environments", "short_description": "MetaTable Poker is the ultimate social card platform to play Texas Hold\u2019em in VR. Our BATTLE tables are in beta and blend poker and combat arena style play - a truly unique twist on poker."}]}, "developer_name": "Tiny Content", "developer_privacy_policy_url": "https://www.metatable.co/privacy-policy-2021", "developer_terms_of_service_url": "https://www.metatable.co/terms-of-service", "publisher_name": "Tiny Content", "support_website_url": null, "website_url": "https://metatable.co/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "SOCIAL", "STRATEGY"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": null, "recommended_graphics": null, "recommen
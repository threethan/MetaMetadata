tbbhAKPsQ7kNvwGskrnl&_nc_oc=AdoothUf0rmyJCaoHL2B_nJ6S9K1kxQBEm7lgf1DepwJlsPeUizhj1JljrpIJTND6SU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTIxdxGCKQf5h9drcqa8CLDq3dVbLJipwgXsxJSHVx69g&oe=6B05A40B"}, {"file_name": "SS1.png", "id": "567064968072454", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982721_567064971405787_4672036885606849560_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=psE3T_kIHx0Q7kNvwGrd4sa&_nc_oc=AdpcYaalNbvC81xAbkl3KSqqun9S3H49mEn0u1fvMu4XH8gwpIOsZeWK8R8MTGg5sY8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRaDRq-L2-r_wRczDowD9aSMKwkua3nKGDuhnlF60EVng&oe=6B05C52F"}, {"file_name": "SS4.png", "id": "416647226572748", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75356792_416647229906081_8768521853214104008_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tI3yJY5aD08Q7kNvwH01JXU&_nc_oc=AdrdBCAbfkliDFWIY5p1jDTkLhsE9zXPhZVg6NHvHqyFTXYDuglTrLhFw5AYIVvCmzg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQJWrBlJg9ATHd2FsD2brJjRvAzGP_JxOTEIaGQA3b_8Q&oe=6B05C962"}, {"file_name": "SS2.png", "id": "297878989208045", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031375_297878992541378_183972035221925865_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DbsEvHjbvCAQ7kNvwEqU93J&_nc_oc=AdpQjkEE02oE_DTNjROzMCAwCi7pgIU66zCDg2V3D9kkotfrUcFGrm13-PRwsT_2vTE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS2-W5iTydiMRyNn0bHDTvx59X9kSq3EA_pF-HM5VPeUQ&oe=6B05BF1A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover-Art-Landscape.png", "id": "1343171842862659", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39035383_1343171846195992_8932016081078023285_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nIIN0RsvVRMQ7kNvwHY5bUx&_nc_oc=Adp-xyHFWnsRgu1bVaN_5G9DqB_0iFCttnLB6ardufQl5vBbDbXLu2v8WsAg-AGLWWU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ1HuOK7gemMserIsxU1TNJOL1ygrJdQ-TjZuP3ljh5wA&oe=6B05A27F"}, "display_name": "MetaTable Poker", "keywords": ["Poker", "Casino", "MetaTable", "Card", "Social"], "long_description": "MetaTable Poker is the ultimate social card platform to play Texas Hold\u2019em in VR. Complete cross-platform with Rift, Go, Quest, and iOS.\n\nBATTLE tables, now in beta, allow you to teleport within the level and acquire weapons. Shoot your opponents out of the hand and avoid getting hit. \n\nCreate a private game and invite your friends to play with a unique PIN. You can use private tables to test your friends\u2019 poker skills or just hang out and chat in VR.\n\nFood, drink, funny hats and other objects are available for purchase. MetaTable Poker allows you to spend your hard-earned chips on unique objects. You can share these objects with your friends at the table.\n\nMetaTable Poker\u2019s features:\n\n- Realistic Texas Hold\u2019em gameplay\n- BATTLE tables blend poker and arena play\n- Voice chat\n- Private table rental\n- Cross-platform play with Oculus and iOS\n- Unique environments", "short_description": "MetaTable Poker is the ultimate social card platform to play Texas Hold\u2019em in VR. Our BATTLE tables are in beta and blend poker and combat arena style play - a truly unique twist on poker."}]}, "developer_name": "Tiny Content", "developer_privacy_policy_url": "https://www.metatable.co/privacy-policy-2021", "developer_terms_of_service_url": "https://www.metatable.co/terms-of-service", "publisher_name": "Tiny Content", "support_website_url": null, "website_url": "https://metatable.co/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "SOCIAL", "STRATEGY"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": null, "recommended_graphics": null, "recommen
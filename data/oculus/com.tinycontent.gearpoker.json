", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/12386401_326793387848091_8801435330164031488_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UJIsONoDFQkQ7kNvwE9Noqf&_nc_oc=Adr3mvE4vMWxesnOVAVxymeeNeIoENlTGMmY4tcSKxU-1OtBQxDCGH8Ctqt_CC5xIv0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVlGJ0tUoON5AZeT3DL3zk6tArvbpRfwDzveTYQvNQhNA&oe=6B103E9C"}, {"file_name": "migrated_image.png", "id": "236849207469816", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12386356_165630047457832_3733909645039763456_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gAYLgAoXLHoQ7kNvwFElCdd&_nc_oc=Adqgzo9qvMM0FcsiSd6moUSrb1zsLqp_LfpKR7Hg5cJNzrP-d8izmt1trX2E6RSq6AA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVIFbBWP7N5P8X1a0r5JpLrX6o6LwTP7FC6TDMMgkQlhQ&oe=6B104F8C"}, {"file_name": "migrated_image.png", "id": "209007576853962", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/12138999_190603405083887_1986441023147999232_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Cv_cuhPNHP0Q7kNvwGOjm2L&_nc_oc=Adqvkj0cwk0SoMBtXjX3xhGMEmVNRTC5_B_Vp835E5FjAves2Y0sv_hDdAGDzkMGVJo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQUQfIthNjpJg3tY4Ut7K8HV-XGMmynmMrZpxU7Oj6gM9g&oe=6B1069B9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "SS6.png", "id": "2044551719096029", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12138999_2044551722429362_8817000776976039936_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Fyvb1YdlK78Q7kNvwGBERUg&_nc_oc=Adp6bg4qXGb8oaDrLTNYfmhECSVUDuLeOP8tn8J6oHa5WirzrzYGwwSa-qwOcqAE0VM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVbH_tGL9S9FRWjZMQWy0VeZly2FcgiD0fkcygFt9Rtng&oe=6B1063C1"}, "display_name": "MetaTable Poker", "keywords": ["Poker", "Casino", "MetaTable", "Card", "Social"], "long_description": "MetaTable Poker is the ultimate social card platform to play Texas Hold\u2019em in VR. Compete against your friends and other Gear, Go and Oculus players in 4 unique environments.\n\nAs the first platform to offer private tables for rent by the hour, MetaTable Poker allows you create a game and invite your friends to play by providing them with a unique PIN number. You can use private tables to test your friends\u2019 poker skills or just hang out and chat in VR.\n\nAnd what\u2019s a poker game without food, drink, funny hats and other objects to play with? MetaTable Poker allows you to spend your hard-earned chips on 32 unique objects. You can share these objects with your friends at the table.\n\nSome of MetaTable Poker\u2019s features:\n\n- Realistic Texas Hold\u2019em gameplay\n- Oculus Avatar support\n- Voice chat\n- Private table rental\n- Objects to purchase with your chips\n- 4 unique environments", "short_description": "MetaTable Poker is the ultimate social card platform to play Texas Hold\u2019em in VR."}]}, "developer_name": "Tiny Content", "developer_privacy_policy_url": "https://www.metatable.co/privacy-policy", "developer_terms_of_service_url": "https://www.metatable.co/terms-of-service", "publisher_name": "Tiny Content", "support_website_url": null, "website_url": "https://metatable.co/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["SOCIAL", "CASUAL", "STRATEGY"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD", "GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER"], "id": "2845095985788652"}}]}, "scheduled_offers": {"count": 0, "nodes": []}, "baseline_offe
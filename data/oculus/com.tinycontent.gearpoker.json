R9z-fg8cQ7kNvwEHDZlW&_nc_oc=AdoUOJFNyfIVdfDQuwx-m-BC3fmhPT5HnJ0eVgMVRIJpuvJLAxEIz1am_i_cQgSrHEI&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQThtYYRSO4o9t-NMzkRAw4UxlPYNBwA_ZruY6LlXEXp3w&oe=6AFB180B"}, {"file_name": "SS1.png", "id": "567064968072454", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38982721_567064971405787_4672036885606849560_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=87m5P92CC-0Q7kNvwGnnSB_&_nc_oc=AdoaFl1E46QvsXR5TFkbgLzcxYqvwRRX6JE0lhoS-ZBwgmh-XX6T_r4ev1MSXpTbVNs&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRf1PS7d60ah_5v_-Q-p4LQZnkUBtbLJP_oCM6npIhPYw&oe=6AFB392F"}, {"file_name": "SS4.png", "id": "416647226572748", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/75356792_416647229906081_8768521853214104008_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F9U59B9MAAQQ7kNvwHS7YnG&_nc_oc=AdqtcEUoyWrKEn5dMVv6BVeVkqV5o2-8vGt-EPrTrVNr2g0uQ0O-dCI3K2TnP8Btqt0&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSNnumeZW3risrIoSKf8H7nVmLh_xPuyn8tWFchxUz2eQ&oe=6AFB3D62"}, {"file_name": "SS2.png", "id": "297878989208045", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/39031375_297878992541378_183972035221925865_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qGzRaDLRVmkQ7kNvwExxYmk&_nc_oc=AdqZB3Lhmq8FSNsiQdNXzZyCKJUVQ3RyqvbxqTP1BMKSKssNGwfvxMgV7r0BNN7K2aY&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTw4bX0Hgox3ACrrLCuEpP4gXi-Zl76fWkBfPJBSnXTpg&oe=6AFB331A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover-Art-Landscape.png", "id": "1343171842862659", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/39035383_1343171846195992_8932016081078023285_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=28055XTpOSYQ7kNvwHF_1yM&_nc_oc=AdoJJEhO7Pg_U3_3NmHO6TYJVeSIKeOq_ftthB4Vbkcx7xV5056ijoVIt5waU2SwlkQ&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRJl2XRKOCnofgQHgjr4JRPc3mL7mgpqETTa3GjZespag&oe=6AFB167F"}, "display_name": "MetaTable Poker", "keywords": ["Poker", "Casino", "MetaTable", "Card", "Social"], "long_description": "MetaTable Poker is the ultimate social card platform to play Texas Hold\u2019em in VR. Complete cross-platform with Rift, Go, Quest, and iOS.\n\nBATTLE tables, now in beta, allow you to teleport within the level and acquire weapons. Shoot your opponents out of the hand and avoid getting hit. \n\nCreate a private game and invite your friends to play with a unique PIN. You can use private tables to test your friends\u2019 poker skills or just hang out and chat in VR.\n\nFood, drink, funny hats and other objects are available for purchase. MetaTable Poker allows you to spend your hard-earned chips on unique objects. You can share these objects with your friends at the table.\n\nMetaTable Poker\u2019s features:\n\n- Realistic Texas Hold\u2019em gameplay\n- BATTLE tables blend poker and arena play\n- Voice chat\n- Private table rental\n- Cross-platform play with Oculus and iOS\n- Unique environments", "short_description": "MetaTable Poker is the ultimate social card platform to play Texas Hold\u2019em in VR. Our BATTLE tables are in beta and blend poker and combat arena style play - a truly unique twist on poker."}]}, "developer_name": "Tiny Content", "developer_privacy_policy_url": "https://www.metatable.co/privacy-policy-2021", "developer_terms_of_service_url": "https://www.metatable.co/terms-of-service", "publisher_name": "Tiny Content", "support_website_url": null, "website_url": "https://metatable.co/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "SOCIAL", "STRATEGY"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": null, "recommended_graphics": null, "recommen
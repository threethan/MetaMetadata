6TViCt6kCohlH2fxAQ&oe=6A6B635A"}, {"file_name": "0_Custom..._02.03.2026_20-57-41.png", "id": "1427554231697898", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499303971_1427554235031231_6614844961333418316_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XHoEi-lowAwQ7kNvwE7vvk2&_nc_oc=AdrNgo-pDhhcEJBuwMPvZpNgBFJ-nRpfPAO3FDpXLdB6ayp5VP_Z88x3hdkolXRNBKU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQANkSSfKSO53hBM6Vixq9A_8zrAuQEjB1qoU25gRnGgRg&oe=6A6B43AA"}, {"file_name": "0_Custom..._02.03.2026_20-57-49.png", "id": "1701536561225587", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499304131_1701536564558920_5405651228690545696_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a2LrwLXERDkQ7kNvwEMAjCF&_nc_oc=AdqNV5hgufAPAZl89lUoWYUIqVmKCveieSDu2pJMjVSe7WYa9yLG4tRmY6evZOaFm18&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAmHBikQtuAp_r7zZnGH7JsRU3as8Jk7Q91_WTa2lO23Q&oe=6A6B4C93"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Idk.png", "id": "1561691171609333", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499307931_1561691174942666_6665935880951983008_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=X3100Qj2BycQ7kNvwH2HSgI&_nc_oc=AdphCZoLNx2-Al4-hpLe8BnR4EPV3ZeFqDwKcRDsrhIyW1zvBHsQkMsuBI6pWQswjAw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCRWW_xULKdDRzph8ojXieClwW0qsORW-ojCF7SilpK6w&oe=6A6B4CD4"}, "display_name": "BananazVR", "keywords": ["adventure", "tag"], "long_description": "Immerse yourself in a thrilling VR experience with this Gorilla Tag-inspired multiplayer game, where agility, strategy, and fast-paced movement are the keys to victory. Chase and be chased in heart-pounding rounds of Tag across dynamic environments designed for climbing, jumping, and hiding. Choose from public rooms to join spontaneous matches with players from around the world, or create private rooms to play exclusively with friends.\n\nRefine your skills with customizable turning mechanics, whether you prefer smooth rotation or snap turning for comfort and precision. Explore cleverly designed maps with unique hiding spots that add a layer of stealth and creativity to each match.\n\nWhether you're an experienced VR player or new to the genre, this game captures the raw fun and community-driven energy of Gorilla Tag while introducing its own twist on gameplay and social interaction. Leap, duck, and outmaneuver your opponents in a vibrant world built for virtual freedom. Ditch Humanity for life", "short_description": "Welcome to Bananaz VR a world where you swing your arms in various maps you can play tag swing swim, etc Ditch Humanity for life"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.termsfeed.com/live/4b42f7dc-7fe4-4a5b-8a8a-c587afd574bf", "developer_terms_of_service_url": null, "publisher_name": "HeriXD3", "support_website_url": null, "website_url": "https://sites.google.com/view/bananazvr/terms-of-service", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1023770785722696"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER"], "id": "25959166307074729"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499304131_2104829126948386_55174705381708292_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M1i0jISBJjMQ7kNvwGGxnrJ&_nc_oc=AdrS9ybyARaJTtQVOT9yiXAIyVwz
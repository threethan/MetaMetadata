d=6e7a0a&_nc_ohc=YPiSyfgDeOwQ7kNvwH2OR2u&_nc_oc=AdrMu_MHH6O6pMqGduQR0GAVqKpic_mTi-eQMJST8FPPV5zoJFVoVruPY-I20td3Eyo&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKzfv4O2LXLOUTUVM5GehK7yBetnbIrFZ14zUfvgOJy8Q&oe=6AA02B0B"}, {"file_name": "screenshot_5_2560x1440.png", "id": "2011008832961395", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/499618264_2011008836294728_1001319765678553226_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Q29u8CqI20kQ7kNvwGyefUW&_nc_oc=Adrj1WfMAIodCaR8DdJzSpMm0HbqlwQTbk_kiWPvIzYZX-EZKUo8CjfSeLDQBxcl850&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK8bPObJoEjXQeB_xuCZ639o9VWmoLyNnQA7uW_jYu8cg&oe=6AA013F5"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Brick Tag", "keywords": [], "long_description": "\ud83e\udda0 BUILT IN MODS \ud83e\udda0\nExplore the COOLEST mods that are easy to get. Rockets, Fly, No Clip, Speed Hacks, X Ray, Teleport, Laptop, and much more!\n\ud83d\udcf8 FREE CAMERA MOD: MOST ADVANCED CAMERA \ud83d\udcf8\nOur built-in camera mod lets you switch between first-person, third-person, and other exciting perspectives to enhance your gameplay experience.\n\ud83c\udfe0 GAME MODES\ud83c\udfe0\nHave fun and talk with other bricks in our casual mode or show your inner brick and jump into an infection lobby. More game modes soon to come..\n\u2757\ufe0f\u2757\ufe0fBIG UPDATES CONSTANTLY\u2757\ufe0f\u2757\ufe0f\nWe do our best to get out updates every week or every other week to best support our community. We built what the community wants!\n\ud83c\udfc0 SHOOT HOOPS LIKE NEVER BEFORE \ud83c\udfc0\nHit the basketball court for some epic trick shots. Whether you\u2019re a baller or just want hit some jumpers, the court is yours.\n\ud83d\udecd\ufe0f EXPLORE THE MALL AND GET COSMETICS \ud83d\udecd\ufe0f\nVisit our in-game mall and deck out your brick with an array of cosmetics. From funky outfits to stylish accessories, there\u2019s something for everyone.\n\ud83e\udd73 JOIN THE BRICK TAG NOW \ud83e\udd73\nReady to experience life as a brick? Join the Brick Tag now and embark on a tiny, yet massive adventure. Play for free and let the fun begin! Join our Discord to get support or find people to play with: https://discord.gg/3FV4u7xsbq", "short_description": "\ud83e\udd8d BRICK TAG: UNLEASH YOUR INNER BRICK \ud83e\udd8d\nShrink down to action figure size and explore an exciting room as a brick. With no legs and a lot of personality, you\u2019ll run on your hands through various fun-filled activities."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/bricktag/home", "developer_terms_of_service_url": null, "publisher_name": "KingKelley", "support_website_url": null, "website_url": "https://sites.google.com/view/bricktag/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "27106595318937713"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499312310_2449265502252449_2974532208111666487_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UzgZejgxzKEQ7kNvwGZ9A15&_nc_oc=Adr_p7rt-jCqb-sPbHRcWPAd-lQO4tRP00oH1tA2PYJmJtcM7WJQs2HBG7X5bycFzsY&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKeq_kmMkT88asGxaPYv9WtV4HIwYONoEHFlK8uo5ZZ2g&oe=6AA0125D"}, "is
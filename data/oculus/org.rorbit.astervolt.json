26735_4314982471912331778_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mCKyIJbNqzcQ7kNvwHysckh&_nc_oc=AdoODtuci6sZp566zJG43CkW43CHsyq5_LUW7gaAb67Clh-iyQDwzavRy0DhfCfdiIk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQU3Em4MnwTg61A_xQnb9luPXmto5qAX6iJysnC64eja3w&oe=6B0F191A"}, {"file_name": "01_cockpit_battle_vr.png", "id": "2336031683862109", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823802_2336031693862108_7549938917972343546_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pih9URSYshsQ7kNvwFHKG41&_nc_oc=AdrL0OeMF-pfrdJJtt51iHr0X178inbzk0GmCiFBDzQpXVfQ5CONoRaXG9CC2fPLaWg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXjL8DDZXxhTtdSxRHWagmnHsmY_lkmVC-HHY2AKUxuvw&oe=6B0EF2C1"}, {"file_name": "03_training_in_the_cockpit_vr.png", "id": "3030868800610098", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491823812_3030868803943431_3217698245431716267_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=92uX84RVNU8Q7kNvwHFPf5X&_nc_oc=AdolLMmSyGheSBWytZlAiQqu6UMovbak9uckryqb86OoVILkD3Qrzm_m883MbgDsEHY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWFp_oLF_wTuCl_AVhQmyvzWWFTA4tfmDaNh0vmu7IqdA&oe=6B0F08E9"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Astervolt", "keywords": [], "long_description": "Astervolt is a 3D arcade space shooter, and in the headset you sit in the pilot's seat. Fly a small ship freely through asteroid fields and enemy fleets and take great warships apart.\n\nNO ONE TOLD THEM THE WAR WAS OVER\n\nPLAYING IN VR\n- Fly with the Touch controllers: the left stick moves and slides the ship, the right stick turns its nose, the right trigger fires, the grips roll; the other buttons raise the shield, change guns and use your special and your captain's ability.\n- Watch from behind the ship, from the cockpit or from the holographic SIM cockpit - press the right stick to change the view. The 2D modes work in the headset too.\n- The HUD hangs before you in flight; menus float in space - point with your right hand and pull the trigger.\n- Press the left stick to recentre your seat.\n\nTHE CAMPAIGN\nThirty story missions in five chapters and six side missions, against the Graft Collective and the traitors of Helion. Four captains, a decision after every mission and three endings. A narrator and the whole cast speak over a crackling field radio - every line is voiced in English.\n\nMORE WAYS TO PLAY\n- The shooter: 110 levels with turning rock fields, great ships and fights inside tunnels.\n- Free play: an endless run through generated sectors, with a boss in every fifth.\n- Network game: up to four players on the local network, or one ship for two.\n\nWHAT YOU FLY AND FIGHT\n- Eight ships, 43 weapons, shields and modules.\n- Great ships out of hyperspace: strike their escort, brid", "short_description": "Take the pilot's seat and fly freely through asteroid fields and enemy fleets. A fully voiced campaign of thirty missions, 110 shooter levels and endless free play - with your head in the cockpit.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.rorbit.pl/policy.html#astervolt", "developer_terms_of_service_url": null, "publisher_name": "RORBIT", "support_website_url": null, "website_url": "https://www.rorbit.pl/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}, {"id": "3744040075834813"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1522484317604481"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "4441650536146478"}]}, "baseline_offer": {"id": "4441650536146478"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1794329940, "status": "PUBLISHED", "id": "4441650536146478"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1540727995780113", "version": "1.1.7"}, "id": "1740921320935246", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1522484267604486", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1540727995780113"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1740921320935246"}]}, "change_log": null, "created_date": 1794177786, "id": "1540727995780113", "version": "1.1.7", "version_code": 10107, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1522484267604486", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1540727995780113"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1740921320935246"}]}, "change_log": null, "created_date": 1794175824, "id": "1540696315783281", "version": "1.1.6", "version_code": 10106, "release_status": "PENDING", "status": "DRAFT", "binary_test_results": {"nodes": []}, "obb_binary"
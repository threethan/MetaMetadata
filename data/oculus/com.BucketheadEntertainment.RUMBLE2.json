rWck7Es5_jGKJeNg&oe=6AAFE008"}, {"file_name": "2.png", "id": "2780650448791434", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491822550_2780650452124767_5169725459229517077_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3GPJCQ7jEpwQ7kNvwFafVte&_nc_oc=AdpJXzSjEp1ujM9tZCO5XjDwtJFSov4wo2DENXYP9DbF0Wjw36LS5kERrg6iso22208&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLKvAz7y0VFFCCojusQsmdNAeK14rw-nB_AMmjFisr7PQ&oe=6AB00141"}, {"file_name": "3.png", "id": "1488153132274640", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491823783_1488153135607973_2100406579539007308_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8v3pxWhWfX0Q7kNvwESBkPF&_nc_oc=Adp7FrjdsMogPl4-By8BSKlit4c_Rcd94pUGAuNPLhfpljXl8wsOSeakFE2wf2j54bA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIc-kxrkEPnrEuCeT3hkuKXzBv_EA6ko85n_MEasFQMkw&oe=6AAFF9C6"}, {"file_name": "4.png", "id": "767348956366221", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491819859_767348959699554_72470764419806838_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k4vADYAiVzMQ7kNvwEwJy_c&_nc_oc=AdolGYPv6guEr1J-ZWMBEwHXcbAV_ucCFHi43yxMb1Bs04xUx8WTt-MTARfYpLx5ne4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJbR-8ByfVdH_PwSyJ32i0dYeqLJbdFPoDjPT3cwgu2AA&oe=6AAFDBBC"}, {"file_name": "5.png", "id": "1524497728768378", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491823746_1524497732101711_7828710630991023770_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=byAGbmf1uRIQ7kNvwExzdTz&_nc_oc=AdoMgfKB5CpEejp03BALyG52HW2KtG9BJfDfV28OqYcFqEYOUcuMPHdpIjxwgOrfRlg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJhQ1FaKiddBeIvd85BHfCqkxGeftic_yDLoGGzhXbzAw&oe=6AAFE799"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "RUMBLE", "keywords": ["fighting", "action", "social", "multiplayer", "sports"], "long_description": "# WELCOME TO RUMBLE!\n\nInstead of with button inputs, this multiplayer VR fighting game is played by performing martial arts-inspired movements. RUMBLE has a heavy focus on practice and repetition, on getting good. You won\u2019t be a master on day one, but keep fighting, keep learning, and one day you will be.\n\n# RUMBLE'S ACTION\n\nIn RUMBLE, you will find many moves to master! Each move you learn has its own unique effect, and you can combine the effects of different moves by performing them in a combo to create your own unique attacks!\n\nYou can perform a move by striking the martial arts-inspired pose that is tied to the move you want to use. By chaining poses together, you can perform multiple moves back to back, combining their effects to form a move combo! The faster you become, the more complex your combos can be, allowing for more unique and creative ways to attack your opponent and defend yourself.\n\nOur community has already taken RUMBLE\u2019s combat mechanics further than we imagined, expanded the boundaries of what was thought possible several times over. How far will you push the envelope? What new tech will you discover?", "short_description": "Become the greatest RUMBLE fighter the world has ever seen! By performing specific martial-arts-inspired movements, you can control the earth around you. Gain mastery over this power, and use it to defeat your opponents in intense 1-on-1 PVP duels!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://rumble.bucketheadentertainment.com/privacy_policy.html", "developer_terms_of_service_url": "https://rumble.bucketheadentertainment.com/eula.html", "publisher_name": "Buckethead Entertainment", "support_website_url": "https://discord.gg/rSaTNYU4CF", "website_url": "https://bucketheadentertainment.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "459781504968480"}, {"id": "2710427532541308"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER"], "id": "24375141315456752"}}]}, "scheduled_offers": {"count": 6, "nodes": [{"status": "PUBLISHED", "id": "1023233410173242"}, {"status": "PUBLISHED", "id": "1603814721118386"}, {"status": "PUBLISHED", "id": "1974003140163577"}, {"status": "PENDING", "id": "841189748455348"}, {"status": "PUBLISHED", "id": "1432166018704275"}, {"status": "PUBLISHED", "id": "884890091012226"}]}, "baseline_offer": {"id": "1974003140163577"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1784566800, "status": "PUBLISHED", "id": "1023233410173242"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "28527715146865994", "version": "0.5.1.5"}, "id": "1079468633829966", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "24375141285456755", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "28527715146865994"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1079468633829966"}]}, "change_log": "CHANGES:\n- Added a new sound effect to the player intended to simulate air rushing past one's ear when moving quickly.\n- Footstep sounds now become louder when moving quickly.\n- Added a new setting that allows the feature that clenches the player's hands when hitting a pose to be turned off.\n- The friend list in the Phone is now ordered alphabetically.\n\nFIXES:\n- Attempting a \"host steal\" will no longer work, nor result in the game freezing.\n- Setting your Quest's system language to Turkish will no longer disable your controllers.\n- A player's fists will no longer get stuck in a closed state after getting picked up by a pedestal.\n- Matchmaking as a party should no longer take more time than expected.\n- The Dressing Room's curtains will no longer randomly be offset from their regular positions.", "created_date": 1789131668, "id": "28527715146865994", "version": "0.5.1.5", "version_code": 47, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": {"id": "28527699393534236"}, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "24375141285456755", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "28527715146865994"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": []}, "change_log": null, "created_date": 1789126568, "id": "28526753483628827", "version": "0.5.1.5", "version_code": 46, "release_status": "PENDING", "status": "DRAFT", "binary_test_results": {"nodes": []}, "obb_binary": {"id": "28526748406962668"}, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "24375141285456755", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "28527715146865994"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": []}, "change_log": null, "created_date": 1788992488, "id": "28505036592467183", "version": "0.5.1.5", "version_code": 45, "release_status": "PENDING", "status": "DRAFT", "binary_test_results": {"nodes": []}, "obb_binary": {"id": "28505033599134149"}, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "24375141285456755", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "28527715146865994"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1079468633829966"}]}, "change_log": "CHANGES:\n- Adjusted Structure motion SFX settings to be more present during gameplay.\n- Added SFX to the Park's waterfalls.\n- Updated the background environment textures across all scenes.\n\nFIXES:\n- Audio playing during scene switches has been fixed.\n- Reverted the increased height at which you could target structures.\n- Improved Gear Market button responsiveness.\n- Added collision to the Party Board.\n- Fixed the Matchmaker ToolTip not turning off when ToolTips are turned off.\n- Shiftstone Quickswapper rocks no longer fly off.\n- Fixed a bug that would allow you to play Host for a second time after a rematch.\n- (probably) Fixed a bug where you'd get stuck when joining a Park with 3 players.", "created_date": 1788783471, "id": "28472860672351442", "version": "0.5.1.4", "version_code": 44, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": {"id": "28472856045685238"}, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "24375141285456755", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "28527715146865994"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": []}, "change_log": null, "created_dat
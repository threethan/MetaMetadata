}, {"file_name": "Screenshot2A.png", "id": "1654036933024954", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/491828050_1654036936358287_56730664059673181_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aaIEbgVeorQQ7kNvwFaZD7V&_nc_oc=Adp0bwJQoNiHGb3286zgfLBCllUQn2k9RA4n8GIbZDoUSqtgrJMq69ewkghaeJ7spWU&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJCmslEkodDsihA5Rmk91AdFEULn-W5dRLY-YHUqyXLZw&oe=6AB696C5"}, {"file_name": "Gym.png", "id": "1380892407358623", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491823790_1380892414025289_6681446954649429287_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZG4bYHeyb0sQ7kNvwFnKI0G&_nc_oc=AdpW5pQ1b6vzIY1oy3qeoffgJ48o8fs56by8YKh1Y01QbqeWfdBGbp79KtZ4yNnqOC4&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJGGJOW-_KdzjTEuxvA71z-8LJFiL78wt62mkiWlE2DAA&oe=6AB66FEA"}, {"file_name": "5.png", "id": "1428768412595272", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491818885_1428768415928605_5521139702266035953_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-B6RoLuoINYQ7kNvwG2k5Oa&_nc_oc=Adq6QnRbhEluaKqcmN4kLn4irwkqWWjipiTHXftvmbwpy31w2pP9g3cWuTF_Gy28hEI&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLkbudVL8qy8K14nRd94cI8HyEIPwQ_jX7nR7g48PvPAA&oe=6AB69D68"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "05TrailerThumbnail.png", "id": "2109059059986614", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491820855_2109059066653280_2891347952050079249_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C5yLoUp36wwQ7kNvwEngc9M&_nc_oc=AdougzlY4Q0q1TU-x_CzHHWPSSm5LOCi7DKxGqj0IKLcY2QHP8C3SevXvNekcKbfNwY&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLw1RRF2LYzn_4r2ERr598OoZZIsxyYhBZXO-ZQyOLJiA&oe=6AB67964"}, "display_name": "RUMBLE", "keywords": ["fighting", "action", "social", "multiplayer", "sports"], "long_description": "                                                                                                                                                \n# Experience VR combat like you never have before\nRUMBLE's physics-based combat system is both functionally unique, and refreshingly intense!\n{1791280115207031}\n\n# Improve your newfound EARTHBENDING skills in the GYM\nThe GYM features all kinds of useful tools to help you learn the basics of bending!\n{3983435738619465}\n\n# Test your mastery against other fighters in the ARENA\nEngage in intense 1 on 1 battles against other earthbenders in the ARENA!\n{1748248603063630}\n\n# Customize your fighting style with SHIFTSTONES\nShiftstones grant you new abilities that further personalize your combat style!\n{1958631431408782}\n\n# Unlock NEW powers and equipment as you PLAY\nEarn all kinds of rewards like new moves and new cosmetics just by playing the game!\n{2623141834767886}\n\n# Begin your EARTHBENDING journey with RUMBLE TODAY!\nBut there is more! RUMBLE also features...\n\n\n**- THE PARK**\n\nWhere you can train, hang around, or even play Minigames with up to 6 players!\n\n**- CROSSPLAY & CROSS PROGRESSION**\n\nNo matter what platform you play on, you will be able to play with everyone!\n\n**- THE ROCK CAM**\n\nAn in-game handheld camera with which you can create all sorts of fun photos and videos!\n\n**AND MORE IS ON THE WAY!**\n\nStay tuned for what's next, we're still actively updating RUMBLE with all kinds of exciting new features!\n\n", "short_description": "Master your new earthbending powers and become the greatest martial artist the world has ever seen! Master the moves, craft your combos, and take to the arena to engage in one of the most intense and exciting 1-on-1 VR fighting games out there!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://rumble.bucketheadentertainment.com/privacy_policy.html", "developer_terms_of_service_url": "https://rumble.bucketheadentertainment.com/eula.html", "publisher_name": "Buckethead Entertainment", "support_website_url": null, "w
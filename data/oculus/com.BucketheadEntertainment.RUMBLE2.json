ontent-iad6-1.oculuscdn.com/v/t64.5771-25/491821696_900865796163389_7383690005335837115_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sIsEFllQ4N4Q7kNvwG-l8_R&_nc_oc=AdrAC8fmzN7KB3StmE6t6dRJoCbNuZ2BNXQEW_nBOh4ocmxu039l17K4RVjgXW09SB4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBBJqOJQnByue94btQCgQFGrfCIO6RLxtcF-v1yCjLEfw&oe=6A48FC50"}, {"file_name": "5.png", "id": "1428768412595272", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491818885_1428768415928605_5521139702266035953_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5SoJ1g913VYQ7kNvwHBoFHg&_nc_oc=AdrdMVKAFm_hJsTvms3-67sSnyhRwGxKhSGagzotH0qv18MC-jBQSqFl-9WaIZiF44A&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBUNAFK2XztuTVRLrwHysTpZVVl0iW6ew8EuT4_I8033Q&oe=6A4930E8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "05TrailerThumbnail.png", "id": "2109059059986614", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491820855_2109059066653280_2891347952050079249_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vH_gcGsq1_oQ7kNvwGRwZsJ&_nc_oc=AdpveRarCO4kVolrYaX7L3TvO9rjLk7MY5OmL0YZmEZwoZKWWnwfmEa7JuU5s5W_SoM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB0ptjYy1Ozd3F73zwuZzFnaWNY7IdPe3sNdF_QzBreow&oe=6A490CE4"}, "display_name": "RUMBLE", "keywords": ["fighting", "action", "social", "multiplayer", "sports"], "long_description": "# Welcome to RUMBLE!\nRUMBLE is a VR multiplayer fighting game where you get earthbending powers! Earn Battle Points by defeating other players in intense 1-on-1 matches in the arena, rank up, and unlock more powers to play with!\n\n\n# Earthbending in VR\nYour new earthbending abilities are performed by making movements inspired by real martial arts. All abilities have their own pose you need to hit just right in order to use them effectively. When you\u2019ve mastered the movements, you can start combining them together to attack your opponent, and defend yourself from their strikes!\n\nEven when you\u2019ve unlocked all of the moves available to you, there will still be much to learn. Keep fighting, and you will continue to get better and better!\n\n# RUMBLE also has\u2026\n\n- The Park\n\nBesides 1v1 arena matches, you can also go to the Park! Up to 6 players can join a Park, where you can then train together, play mini-games, host tournaments, or play with the toys scattered all throughout the area!\n\n- Cross-Platform Play\n\nRUMBLE features cross-platform play, meaning that if you play on PC but a friend plays on Standalone VR hardware, you will still be able to play together!\n\n- Character Customization\n\nRUMBLE features a big character customization system for those who really enjoy making their own characters look interesting and unique. At the Gear Market, you can trade in Gear Coins (which you earn by playing online) for new items to customize your character with!\n\n# Start your RUMBLE earthbending journey today!", "short_description": "Master your new earthbending powers and become the greatest martial artist the world has ever seen! Master the moves, craft your combos, and take to the arena to engage in one of the most intense and exciting 1-on-1 VR fighting games out there!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://rumble.bucketheadentertainment.com/privacy_policy.html", "developer_terms_of_service_url": "https://rumble.bucketheadentertainment.com/eula.html", "publisher_name": "Buckethead Entertainment", "support_website_url": null, "website_url": "https://bucketheadentertainment.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "459781504968480"}, {"id": "2710427532541308"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_gr
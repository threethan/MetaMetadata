88153135607973_2100406579539007308_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Gk50IhPDZaIQ7kNvwEWkOI9&_nc_oc=AdrIWd3DctJZwRc4Njv9n4-mCUs5OPdMgu5mnqt9CuWRpg9_qFTYa6A572L8hP7dx_Y&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOeW_pKT405L8cxLtrcFjBBbU4d3iDZM1dC6i_hsJ0_aA&oe=6AD240C6"}, {"file_name": "4.png", "id": "767348956366221", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491819859_767348959699554_72470764419806838_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aNyFOu5xIWMQ7kNvwFv5lX_&_nc_oc=Adr9EgpNDV-Ybabh6dix3WfXgOFdi6ZQTBxMogXb1NPxyaXGS3h2o0DibQrKIamNvvg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNAdYKIvABkVyIcJ9E9pCixq1b_frLbeesgVjqiUYe7cw&oe=6AD25AFC"}, {"file_name": "5.png", "id": "1524497728768378", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491823746_1524497732101711_7828710630991023770_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qMJD9WwhLMMQ7kNvwHB7Ovt&_nc_oc=AdoOibMOw7z2q_Z70mEMtdLdcrM3FkrUj6qsSvg27k14fJwG7QCkDn7pXy37oOGkRbQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPpDCyY_s6NsA_ZCJKACvqE4Wfp-2N5Rrf4dy77zfoEqw&oe=6AD22E99"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "RUMBLE", "keywords": ["fighting", "action", "social", "multiplayer", "sports"], "long_description": "# WELCOME TO RUMBLE!\n\nInstead of with button inputs, this multiplayer VR fighting game is played by performing martial arts-inspired movements. RUMBLE has a heavy focus on practice and repetition, on getting good. You won\u2019t be a master on day one, but keep fighting, keep learning, and one day you will be.\n\n# RUMBLE'S ACTION\n\nIn RUMBLE, you will find many moves to master! Each move you learn has its own unique effect, and you can combine the effects of different moves by performing them in a combo to create your own unique attacks!\n\nYou can perform a move by striking the martial arts-inspired pose that is tied to the move you want to use. By chaining poses together, you can perform multiple moves back to back, combining their effects to form a move combo! The faster you become, the more complex your combos can be, allowing for more unique and creative ways to attack your opponent and defend yourself.\n\nOur community has already taken RUMBLE\u2019s combat mechanics further than we imagined, expanded the boundaries of what was thought possible several times over. How far will you push the envelope? What new tech will you discover?", "short_description": "Become the greatest RUMBLE fighter the world has ever seen! By performing specific martial-arts-inspired movements, you can control the earth around you. Gain mastery over this power, and use it to defeat your opponents in intense 1-on-1 PVP duels!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://rumble.bucketheadentertainment.com/privacy_policy.html", "developer_terms_of_service_url": "https://rumble.bucketheadentertainment.com/eula.html", "publisher_name": "Buckethead Entertainment", "support_website_url": "https://discord.gg/rSaTNYU4CF", "website_url": "https://bucketheadentertainment.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "459781504968480"}, {"id": "2710427532541308"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER"], "id": "24375141315456752"}}]}, "scheduled_offers": {"count": 6, "nodes": [{"status": "PUBLISHED", "id": "1432166018704275"}, {"st
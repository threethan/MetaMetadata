0a&_nc_ohc=IaW2er45J6cQ7kNvwHjPOTF&_nc_oc=AdqClzB3NsGDTThY-J8TLEQNSmBeHAWBXjPjQrvIc6IxcNyoaiFo1IHFZGBwOyGqTM0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWuJu2x-qpuzM4YwuKPgaecZkMq99PoYFEH5aMHbH8V8Q&oe=6B0EF53C"}, {"file_name": "Screenshot2A.png", "id": "1654036933024954", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491828050_1654036936358287_56730664059673181_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Nn7EhYm6cJ0Q7kNvwELsH23&_nc_oc=AdoUq0VlAD7hW65Z5FdU62HSSRPCAGms8E0s7sDSfZt3M2bKMEXHuc37YvGkH2iN7R4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWgjwYiZlWzULqWMEFOnFSpYIZJ_5Ukw5585dthKE7CGQ&oe=6B0EEB45"}, {"file_name": "Gym.png", "id": "1380892407358623", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823790_1380892414025289_6681446954649429287_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OFUsPxTc2fYQ7kNvwFETfCN&_nc_oc=Adr7bbkHzGm3qNjJqgtfdgbnLtSQhb1x-efJar1RcWIYEWU1VMu8bNoHbmd9IKoxMVA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXf3v1ZDngomfE_-mw3qay5Urq7Mjax8S8UUa0LmGELeQ&oe=6B0EFCAA"}, {"file_name": "5.png", "id": "1428768412595272", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491818885_1428768415928605_5521139702266035953_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S1xjAfAoJ9kQ7kNvwEL4QtZ&_nc_oc=AdokExSD7FpNwd7UUc9CcsPPqdGxaGfHWBDz8ZDodWdb7xN4ugnJxO0aQ4U7pM0JKpo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQV4YW5ITROL5iw_lBtd9Nk1vmYp5cuI8o8ur-5d5B5Riw&oe=6B0EF1E8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "05TrailerThumbnail.png", "id": "2109059059986614", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491820855_2109059066653280_2891347952050079249_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UMS4jcbOz7UQ7kNvwEp6ikZ&_nc_oc=Adq1AQH6cGBY88xWKqSqFqVfin264HyIuL9LRAA9qMctpoaUjmMacCMw7eUNwTJLSc0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVV7boThiqQ6ltzsi9aXfOmc3zX7Nn3PhcpEgdqN9pOkQ&oe=6B0F0624"}, "display_name": "RUMBLE", "keywords": ["fighting", "action", "social", "multiplayer", "sports"], "long_description": "                                                                                                                                                \n# Experience VR combat like you never have before\nRUMBLE's physics-based combat system is both functionally unique, and refreshingly intense!\n{1791280115207031}\n\n# Improve your newfound EARTHBENDING skills in the GYM\nThe GYM features all kinds of useful tools to help you learn the basics of bending!\n{3983435738619465}\n\n# Test your mastery against other fighters in the ARENA\nEngage in intense 1 on 1 battles against other earthbenders in the ARENA!\n{1748248603063630}\n\n# Customize your fighting style with SHIFTSTONES\nShiftstones grant you new abilities that further personalize your combat style!\n{1958631431408782}\n\n# Unlock NEW powers and equipment as you PLAY\nEarn all kinds of rewards like new moves and new cosmetics just by playing the game!\n{2623141834767886}\n\n# Begin your EARTHBENDING journey with RUMBLE TODAY!\nBut there is more! RUMBLE also features...\n\n\n**- THE PARK**\n\nWhere you can train, hang around, or even play Minigames with up to 6 players!\n\n**- CROSSPLAY & CROSS PROGRESSION**\n\nNo matter what platform you play on, you will be able to play with everyone!\n\n**- THE ROCK CAM**\n\nAn in-game handheld camera with which you can create all sorts of fun photos and videos!\n\n**AND MORE IS ON THE WAY!**\n\nStay tuned for what's next, we're still actively updating RUMBLE with all kinds of exciting new features!\n\n", "short_description": "Master your new earthbending powers and become the greatest martial artist the world has ever seen! Master the moves, craft your combos, and take to the arena to engage in one of the most intense and exciting 1-on-1 VR fighting games out there!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://rumble.bucketheadentertainment.com/privacy_policy.html", "developer_terms_of_service_url": "https://rumble.bucketheadentertainment.com/eula.html", "publisher_name": "Buckethead Entertainment", "support_website_url": null, "website_url": "https://bucketheadentertainment.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "459781504968480"}, {"id": "2710427532541308"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER"], "id": "28584673107836864"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/585819904_2163181511119806_7862947564804935451_n.png?stp=dst-png_s360x360&_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EV-k5g6bibQQ7kNvwHXyWXq&_nc_oc=Adoh-qARx2XzLnuVOAbsRhSuu3ccXlm0jZJ1NuiEKhmJm1E_Al-1DJ0LhWsGm0Nvhc0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVBjnXRB0G62piE-7NoTMKZz8PzVyMMk8G9OEh36sDapQ&oe=6B0EF67F"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "RUMBLE", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Sports", "id": "2776542286000603"}, {"topic_name": "Action", "id": "459781504968480"}, {"topic_name": "Fighting", "id": "2710427532541308"}], "re
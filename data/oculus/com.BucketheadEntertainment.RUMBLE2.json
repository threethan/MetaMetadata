}, {"file_name": "Screenshot2A.png", "id": "1654036933024954", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491828050_1654036936358287_56730664059673181_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0WedDR8HIlMQ7kNvwEMUhH9&_nc_oc=AdqvwpFW2EDvwYGG3ovKWvJDDF58A5WeCdQOXGgbazh4SeJhXPU3_gFhc0lrgmrEZZY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMqQCU5aVJ6uUe_19aL9Rhq0PeSQJ0CuIQYcmdAq3xj1w&oe=6AD24645"}, {"file_name": "Gym.png", "id": "1380892407358623", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491823790_1380892414025289_6681446954649429287_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8Y1V4heJyTgQ7kNvwHQ9bMx&_nc_oc=AdqRALNtr1MdrrxyEsBCezyq2DIRCW0cJguyXA0zb9PlMUCQdjElwNT4pZkgFnDzO9k&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOkIEPWOiHm4KjZFVLET8RwzFT_fXYU8bAQiGSY5Iyb2Q&oe=6AD257AA"}, {"file_name": "5.png", "id": "1428768412595272", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491818885_1428768415928605_5521139702266035953_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SVlzQnbdv_YQ7kNvwFYvMBd&_nc_oc=Adphe0a7mQbKBmXXx37HSuB9bJfJXbC8eaMXnCDsSqDeb_qNrDdlTZ_sLc8R8CwvEi0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOS424K0C7V1CA4zQ83MishXhMqn1NSIVNtnf_7GRsaQA&oe=6AD24CE8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "05TrailerThumbnail.png", "id": "2109059059986614", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491820855_2109059066653280_2891347952050079249_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b9jJAT9DhiwQ7kNvwHCLDFv&_nc_oc=AdqqHw6Fo-0kXUlInOMjHlfPwOns-PqpogrKCeRlU-RfJG5Uxy2Itd_nHdAVm7mVKVg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNRLt9dRBf6WRhPhMXMi2jSLGPKcujJWid8RTENvtzv7A&oe=6AD228E4"}, "display_name": "RUMBLE", "keywords": ["fighting", "action", "social", "multiplayer", "sports"], "long_description": "                                                                                                                                                \n# Experience VR combat like you never have before\nRUMBLE's physics-based combat system is both functionally unique, and refreshingly intense!\n{1791280115207031}\n\n# Improve your newfound EARTHBENDING skills in the GYM\nThe GYM features all kinds of useful tools to help you learn the basics of bending!\n{3983435738619465}\n\n# Test your mastery against other fighters in the ARENA\nEngage in intense 1 on 1 battles against other earthbenders in the ARENA!\n{1748248603063630}\n\n# Customize your fighting style with SHIFTSTONES\nShiftstones grant you new abilities that further personalize your combat style!\n{1958631431408782}\n\n# Unlock NEW powers and equipment as you PLAY\nEarn all kinds of rewards like new moves and new cosmetics just by playing the game!\n{2623141834767886}\n\n# Begin your EARTHBENDING journey with RUMBLE TODAY!\nBut there is more! RUMBLE also features...\n\n\n**- THE PARK**\n\nWhere you can train, hang around, or even play Minigames with up to 6 players!\n\n**- CROSSPLAY & CROSS PROGRESSION**\n\nNo matter what platform you play on, you will be able to play with everyone!\n\n**- THE ROCK CAM**\n\nAn in-game handheld camera with which you can create all sorts of fun photos and videos!\n\n**AND MORE IS ON THE WAY!**\n\nStay tuned for what's next, we're still actively updating RUMBLE with all kinds of exciting new features!\n\n", "short_description": "Master your new earthbending powers and become the greatest martial artist the world has ever seen! Master the moves, craft your combos, and take to the arena to engage in one of the most intense and exciting 1-on-1 VR fighting games out there!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://rumble.bucketheadentertainment.com/privacy_policy.html", "developer_terms_of_service_url": "https://rumble.bucketheadentertainment.com/eula.html", "publisher_name": "Buckethead Entertainment", "support_website_url": null, "w
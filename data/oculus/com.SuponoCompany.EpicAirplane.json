L&_nc_oc=AdoTEScIWZMYdR4UZsmB3rIIIMEdSFiCgfufHQNc5sr6luiIR2OEPbLn4r7NTht2RlY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRYom9z4uwr6_x6872zXbMXtqEoFkEZCeFmNffNlUfGPg&oe=6AF1DB33"}, {"file_name": "New Project (7).png", "id": "1415034250506888", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/604317775_1415034257173554_167785937111041627_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_jkEw1MfiKcQ7kNvwE5QZET&_nc_oc=AdrI2sNzfP29uBaPZG8tLlfijEUzTzNqyr9FxFi-VhxT9tTOScQpvXR_44YSq8LTY-U&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRJGqOyfNibp_sM8cYzCC5UZWeyD8dec8GTvVLxNlezmA&oe=6AF1DA83"}, {"file_name": "New Project (8).png", "id": "1646232997129203", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/604360590_1646233000462536_7905824981380781826_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wYcUNUAKmL8Q7kNvwFwjbDu&_nc_oc=Adp1ZA7dSOhs2-4RU1o2UItJ06d2P2C-yniioQPHuNnaDH-akvaPurq1WUTIEmHuCQ8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTYMK17v5Aqxvv_v8nuvC0M8Dbo47XKDpE89pim9hwd1w&oe=6AF1E180"}, {"file_name": "New Project (9).png", "id": "2143764383222165", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491831569_2143764386555498_5316445906416859397_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Mfs1Q19RkWsQ7kNvwF-BSc9&_nc_oc=Ado9N0ofjZDBGnDUpLhrdzV0GhwtpV8RxrJ88wsNemMl8UmgOEQl71BRfiV3QG-bWa4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTfjctqE3Cnmx3WLScDu2hIBNUsBYyEAuayrNvylpM0ow&oe=6AF1D6C7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "New Project (1).png", "id": "909612068474385", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/585799753_909612071807718_194084672995195084_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f3Nz1PQm858Q7kNvwHgZf0Z&_nc_oc=AdqA6nLvUky6yA87r5qSUwgXv4dqdRJgI32Pn-HenOP0CXg8cfmPwekXonT2rZ2_Ydg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTpZUOr_u8bAjMnRSPMhQz49DygCn-U4EkqQ0YM9gOrVg&oe=6AF202EC"}, "display_name": "Epic plane", "keywords": ["airplane", "flying", "flight", "slingshot", "arcade"], "long_description": "Epic Airplane is a physics-based VR flying game where every flight starts the same thrilling way: grab your plane by both wingtips, pull back like a slingshot, and let go to launch into the sky.\n\nOnce airborne, bank and dive through uniquely themed worlds \u2014 a lush forest, ancient ruins, a rocky canyon, a snowy mountain pass, and windswept pyramids \u2014 each with its own hazards and scenery. Dodge falling obstacles, thread the terrain, and fly as far as you can before gravity brings you back down.\n\nCollect floating coins mid-flight and earn more with every meter flown, then spend them in the Garage to unlock and upgrade a growing fleet of planes. Boost your Speed, lighten your Weight for longer glides, multiply your coin earnings, or save up for emergency mid-flight Boosters \u2014 every upgrade is a step toward flying further than before.\n\nFeel every crash, coin, and victory with responsive haptic feedback, and track your best distance as you push to beat your own record.\n\nHow far will you fly?", "short_description": "Pull back, let go, and soar! Launch your plane slingshot-style and fly as far as you can through forests, ancient ruins, snowy peaks, and windswept pyramids. Dodge falling obstacles, grab coins mid-air, and upgrade your fleet in the Garage. How far will you fly?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://erp.suponoholdings.com/vr-terms", "developer_terms_of_service_url": null, "publisher_name": "Supono Holdings LTD", "support_website_url": null, "website_url": "https://suponoholdings.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "459781504968480"}, {"id": "1592192974313489"}], "external_subscrip
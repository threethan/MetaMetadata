5Aqxvv_v8nuvC0M8Dbo47XKDpE89pim9hwd1w&oe=6AF1E180"}, {"file_name": "New Project (9).png", "id": "2143764383222165", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491831569_2143764386555498_5316445906416859397_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Mfs1Q19RkWsQ7kNvwF-BSc9&_nc_oc=Ado9N0ofjZDBGnDUpLhrdzV0GhwtpV8RxrJ88wsNemMl8UmgOEQl71BRfiV3QG-bWa4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTfjctqE3Cnmx3WLScDu2hIBNUsBYyEAuayrNvylpM0ow&oe=6AF1D6C7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "New Project (1).png", "id": "909612068474385", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/585799753_909612071807718_194084672995195084_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f3Nz1PQm858Q7kNvwHgZf0Z&_nc_oc=AdqA6nLvUky6yA87r5qSUwgXv4dqdRJgI32Pn-HenOP0CXg8cfmPwekXonT2rZ2_Ydg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTpZUOr_u8bAjMnRSPMhQz49DygCn-U4EkqQ0YM9gOrVg&oe=6AF202EC"}, "display_name": "Epic plane", "keywords": ["airplane", "flying", "flight", "slingshot", "arcade"], "long_description": "Epic Airplane is a physics-based VR flying game where every flight starts the same thrilling way: grab your plane by both wingtips, pull back like a slingshot, and let go to launch into the sky.\n\nOnce airborne, bank and dive through uniquely themed worlds \u2014 a lush forest, ancient ruins, a rocky canyon, a snowy mountain pass, and windswept pyramids \u2014 each with its own hazards and scenery. Dodge falling obstacles, thread the terrain, and fly as far as you can before gravity brings you back down.\n\nCollect floating coins mid-flight and earn more with every meter flown, then spend them in the Garage to unlock and upgrade a growing fleet of planes. Boost your Speed, lighten your Weight for longer glides, multiply your coin earnings, or save up for emergency mid-flight Boosters \u2014 every upgrade is a step toward flying further than before.\n\nFeel every crash, coin, and victory with responsive haptic feedback, and track your best distance as you push to beat your own record.\n\nHow far will you fly?", "short_description": "Pull back, let go, and soar! Launch your plane slingshot-style and fly as far as you can through forests, ancient ruins, snowy peaks, and windswept pyramids. Dodge falling obstacles, grab coins mid-air, and upgrade your fleet in the Garage. How far will you fly?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://erp.suponoholdings.com/vr-terms", "developer_terms_of_service_url": null, "publisher_name": "Supono Holdings LTD", "support_website_url": null, "website_url": "https://suponoholdings.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "459781504968480"}, {"id": "1592192974313489"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1511356420989232"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1632509461927772"}]}, "baseline_offer": {"id": "1632509461927772"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1789578600, "status": "PUBLISHED", "id": "1632509461927772"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1510209477770593", "version": "1.0"}, "id": "1533622114716889", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__
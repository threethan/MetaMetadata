"}, {"file_name": "GWACKAMOLE_OfficialScreenShots_2.png", "id": "176274041306288", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974856_176274044639621_5752179533034131528_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d-F1yF-kL2kQ7kNvwHfvVKV&_nc_oc=Adp2zsAgpSh_srU3TXZQonSES2tYU_zzshv5QTJN-kzl4P1WD2Qx0vfknSDa27RfLUs&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRK-4VukDJvlSsMPd4rrBIlaCYHrbimWRycNLeHvLHnqQ&oe=6AFC93F4"}, {"file_name": "GWACKAMOLE_OfficialScreenShots_3.png", "id": "338695218004794", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39035304_338695221338127_1342561817767033406_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8d9ORkJ-QT0Q7kNvwHCk60W&_nc_oc=AdoB98h_Zg8uCmqHnB1Avddcc8ZXiBMFpspuk2VPLbmBg-4fexSqhKElmPuEVyXswrc&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSH2Lg9gGvDDJRIy921VqpSlTM61vqNBdJS5NXpP3oCCg&oe=6AFC6AB7"}, {"file_name": "GWACKAMOLE_OfficialScreenShots_4.png", "id": "448396779928731", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974864_448396783262064_2255614967393247225_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4TTEzuPIB80Q7kNvwExRaUy&_nc_oc=AdqGzfq-VW39YjCa24LHDq7XVQhG9Ffh6CQDUm-cnMGHwppj9GPrZGIQ_SW00-Ia914&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSLk5lfreKpOIpITzWoicJQ6IKZsPDEeuKFL09pctBUeg&oe=6AFC8DE8"}, {"file_name": "GWACKAMOLE_OfficialScreenShots_5.png", "id": "979654809285779", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/39001673_979654812619112_1232644871229546155_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8R5qZVXGLVYQ7kNvwEQ4boe&_nc_oc=AdrKoFnHlCDO8GerHz91ngHA9T1q2gie14PSB4_G8OE5_kKnL29quSlgbx4OvtxtgGU&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT738XRk-3nOg_OHMbJGRJC_MflPJCYvubkWe1nBvfSSA&oe=6AFC63AC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Gwack-a-mole videoThumb_2560x1440.png", "id": "376888274089436", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39003274_376888277422769_693623872900729112_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z74u_3HxzK0Q7kNvwEpk5S6&_nc_oc=AdpCP7WH6v7KArwJQJFwVFbGf0618wplXVTNugjpccR18Rj91eCg4s2BBEIEIT_6Bcg&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR2MZ6Sv41YmcgDgXX43b8c7kVOs_FMgbc3jhbHnzSciw&oe=6AFC78E7"}, "display_name": "Gwack-a-mole", "keywords": [], "long_description": "Welcome to Wacky Farms, home of the world largest pit-less avocados! \n\nOn the farm your job is to smash the avocados as quickly as they appear.  You keep smashing and they keep coming. And at all cost avoid smashing the rotten avocados.\n\nGame Features:\nTimer Mode:  Just like the classic arcade game Whac-a-Mole, get as many as possible within the time limit.\nSurvival Mode:  Continuous play, but miss enough avocados in a row and you will be eliminated!\nThree playable game boards, each with its own level of difficulty/skill.\nUp to 8 players can compete using one headset.\nLeft handed smashers compatible.\nDual wield feature, for extra smashability!", "short_description": "Expert smashers needed!! \nWacky Farms looking for strong & fast avocado crushers to make their fresh daily Gwack-a-mole!  \n\nA spinoff of the classic arcade Whac-a-Mole, featuring two game modes, and three different Gwack-a-mole machines available to play, the challenge is on!\n\nPlay solo or challenge your friends and family to beat that high score. Up to 8 players can play using the same headset via pass and play. \n\nDid we mention you can dual wield?! Grab your mallets and lets get smashing!\n"}]}, "developer_name": "eStudio NooN", "developer_privacy_policy_url": "http://www.estudionoon.com/Gwack-a-mole/privacy-policy.php", "developer_terms_of_service_url": null, "publisher_name": "eStudio NooN", "support_website_url": null, "website_url": "http://w
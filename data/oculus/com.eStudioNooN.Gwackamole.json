=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS74MrNw6i4J8U2HLuzNo-ps3vLzkIlm392n_W6MC7KJg&oe=6B05D66C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Gwack-a-mole videoThumb_2560x1440.png", "id": "376888274089436", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39003274_376888277422769_693623872900729112_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YaOBv_4ixFwQ7kNvwEflY5Q&_nc_oc=Adon9wcCzI6hP5HSxxVkWmhwcCmWkQVJ2ew0BXxSiDt10XKy07PRNxn229L6xASOKuU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRouu5kgkC0G9l75MAQYcxbgrwqJECPhjikS-mRdKkD8g&oe=6B05B367"}, "display_name": "Gwack-a-mole", "keywords": [], "long_description": "Welcome to Wacky Farms, home of the world largest pit-less avocados! \n\nOn the farm your job is to smash the avocados as quickly as they appear.  You keep smashing and they keep coming. And at all cost avoid smashing the rotten avocados.\n\nGame Features:\nTimer Mode:  Just like the classic arcade game Whac-a-Mole, get as many as possible within the time limit.\nSurvival Mode:  Continuous play, but miss enough avocados in a row and you will be eliminated!\nThree playable game boards, each with its own level of difficulty/skill.\nUp to 8 players can compete using one headset.\nLeft handed smashers compatible.\nDual wield feature, for extra smashability!", "short_description": "Expert smashers needed!! \nWacky Farms looking for strong & fast avocado crushers to make their fresh daily Gwack-a-mole!  \n\nA spinoff of the classic arcade Whac-a-Mole, featuring two game modes, and three different Gwack-a-mole machines available to play, the challenge is on!\n\nPlay solo or challenge your friends and family to beat that high score. Up to 8 players can play using the same headset via pass and play. \n\nDid we mention you can dual wield?! Grab your mallets and lets get smashing!\n"}]}, "developer_name": "eStudio NooN", "developer_privacy_policy_url": "http://www.estudionoon.com/Gwack-a-mole/privacy-policy.php", "developer_terms_of_service_url": null, "publisher_name": "eStudio NooN", "support_website_url": null, "website_url": "http://www.eStudioNooN.com/Gwack-a-mole", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE", "CASUAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "MULTI_USER"], "id": "674151400267130"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "424475312681896"}]}, "baseline_offer": {"id": "424475312681896"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1640840400, "status": "PUBLISHED", "id": "424475312681896"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "7000983343260720", "version": "0.1.27"}, "id": "1152644385256936", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "6520359507989775", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "7000983343260720"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1152644385256936"}]}, "change_log": "\n", "created_date": 1633409190, "id": "7000983343260720", "version": "0.1.27", "version_code": 2, "release_status": "RELEASED", "status": "APP
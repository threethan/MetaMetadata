02332273_6895939704512839680_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7QgYJvhA5-AQ7kNvwFoj_Nk&_nc_oc=Adoh4MgQ9nlTw1ixk-6mGRCfn13B_gtrEPJeaqECClliGD_rnDYn1HQtA0TG3qjX9y8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHeOGdM3vyJ4-bfH1v9dDZwHHpjGLhPyb0E6rI_LJc_ug&oe=6A773B2E"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Divinity Defense", "keywords": ["Defence", "TowerDefense", "Tower", "Divinity", "TD"], "long_description": "Are you ready for a real tower defense game in virtual reality? New VR game Divinity Defence will take you to a new virtual world. Travel virtual reality without leaving your room.\n\nDivinity Tower Defence game is a TD VR game where you defend your castle by building towers alongside the paths of your enemies. Also, you can smash your enemies forces with your hands or burn them down while they are trying to attack your castle. Don\u2019t forget to collect coins. Tower defense games have never been so immersive. This TD VR game allows you to control everything. Don\u2019t be an observer, interact!", "short_description": "Virtual reality wars are waiting for you in new VR game Divinity Tower Defense!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://drive.google.com/file/d/1_ejU6kXXMoz73MECPWIFu0lq-xKJ39j-/view?usp=sharing", "developer_terms_of_service_url": "http://vicovr.com/", "publisher_name": "3DiVi Company", "support_website_url": null, "website_url": "http://vicovr.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ARCADE", "CASUAL", "PUZZLE", "SIMULATION", "STRATEGY"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes"
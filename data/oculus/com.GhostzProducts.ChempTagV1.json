ay_name": "Chemp Tag!", "keywords": ["Gorilla", "Tag", "Chemp", "Fangame"], "long_description": "Chemp Tag has anything you can imagine! You can play the gamemodes like horror, speeding wall, low gravity, hangout, and more! There are a few maps for you and your best buddies to hang out in, and to play your own games. There is a fanart room to check out all the best art by the members inside of Chemp Tags Discord community. I hope you have fun playing Chemp Tag!", "short_description": "Master the unique hand-locomotion of Chemp Tag! Escape the terrors in Horror Chapter 1, defy physics in Low Gravity, and outrun the deadly Speeding Wall in this high-energy VR \n\nThere is a bunch of gamemodes for you and your friends! A few maps to have fun in, and fan art room to check out cool art made by people in the chemp tag discord community!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/chemptag/privacy-policy?authuser=4", "developer_terms_of_service_url": null, "publisher_name": "Ghostz", "support_website_url": null, "website_url": "https://sites.google.com/view/chemptag/home?authuser=4", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1023770785722696"}, {"id": "644354873106712"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "27437279065862778"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "967591995861087"}]}, "baseline_of
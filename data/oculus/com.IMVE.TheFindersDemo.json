6607_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1wjIncPzYzEQ7kNvwFQFTvh&_nc_oc=Adr7zHzxfXkg3dY2ypPL9_L40v40kFFBef_S33_RLxi71BIe4SwQRWSjxkxIl0vfmso&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXaiS-LSHi_nArum8FvtznOz9RlLlaca1zvkfKAqqbqGg&oe=6B1051D1"}, "display_name": "The Finders (Demo)", "keywords": ["finder", "pet", "cat", "finding", "challenge"], "long_description": "\"The Finders\" is a VR game that challenges players to find objects throughout Pet-World. It\u2019s a mini open-world game where players can explore maps, complete exciting quests, play various mini-games, hang out with other players (Full version), collect objects, and level up to become the best \"Finder.\"\n\nFeatures:\n- Cute animals\n- Sandbox exploration\n- Main Quest \n- Mini games\n\nMore features will be added in the full version, which will be released in February 2025!", "short_description": "\"The Finders\" is a VR game that challenges players to find objects throughout Pet-World. It\u2019s a mini open-world game where players can explore maps, complete exciting quests, play various mini-games, hang out with other players (Full version), collect objects, and level up to become the best \"Finder.\"\n\nThis game is still in the demo version and will be fully released in February 2025!"}]}, "developer_name": "IMVE", "developer_privacy_policy_url": "https://drive.google.com/file/d/1L63MkjRvHCBl8wRmhS2sCvGNS1qj5p0G/view?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "IMVE", "support_website_url": null, "website_url": "https://imve.co.id/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}, {"id": "2691890164460465"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED"
in every moment.\n\nAre you brave enough to face the horrors of Chimp Safe and outsmart the mutants, or will you become just another victim in the depths of the bunker?", "short_description": "Cool Chimps is a VR survival horror game where players explore a dangerous nuclear bunker overrun by intelligent mutant chimps. Outsmart predators, solve puzzles, and escape before it\u2019s too late!\""}]}, "developer_name": "chimpscares", "developer_privacy_policy_url": "https://sites.google.com/view/coolchimps/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "chimpscares", "support_website_url": null, "website_url": "https://sites.google.com/view/coolchimps/home?authuser=0", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "29322685220710880"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1182923050158946"}]}, "baseline_offer": {"id": "1182923050158946"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1744912440, "status": "PUBLISHED", "id": "1182923050158946"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "34567038552942161", "version": "0.19"}, "id": "1148556667006469", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBina
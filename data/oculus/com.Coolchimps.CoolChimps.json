_11-03-36.png", "id": "3070806553089208", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391924_3070806556422541_3207533555842024710_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j2sk-g0tD40Q7kNvwFRstHJ&_nc_oc=Adn5hp6aisMrLjFZ3xGl5U8FR14YgdijErWNwfrmwYjDU0ZN98b4frFEMtt4AYhHeBE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfytgGKez3QCIO4m_JLidHIQ1o1UVpiOLXeRnakzj4BLgA&oe=69B6A9EE"}, {"file_name": "SampleScene_Custom..._27.03.2025_11-03-58.png", "id": "513608218469834", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391883_513608221803167_4133559235040658427_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yzzozMPIDksQ7kNvwEVq-ak&_nc_oc=AdnC2VRARP9BtOJrE3VQ42iRb93YIc__HAJxwu3WYgsfyQq3PeRMD-ft2BeYZE6S0nU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfxNKs0G80rHWy_I0j_oSVBwut9Rapvt-WCEN1FasDS7Kg&oe=69B6A071"}, {"file_name": "SampleScene_Custom..._27.03.2025_11-04-19.png", "id": "581136201603867", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473391924_581136204937200_1885997537842753681_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=khXlnw56xUcQ7kNvwEs8586&_nc_oc=Adn1LQzUWsbj4bMa4Rbmc1c-nucheyAWe3u6GMrYXd7NWA4X67hYJtj2kNAtdPl-Rmw&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfxePHgb6hjgtWqH_vqOtmAPfgkLHJoOKw4GsdHm2PiwZw&oe=69B6B954"}, {"file_name": "SampleScene_Custom..._27.03.2025_11-04-35.png", "id": "1582418175836304", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391888_1582418179169637_3590472074617371809_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P3jAohuexfYQ7kNvwHwFmzJ&_nc_oc=AdmR7K7swnh6jsPk1vJO2z8aoPhzlWDdrh7P3XWzUrVIS1qMTTlWXk-2ma7KNGaR1Zk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfxdbHbw3yJ40z-7d6E9Qulyvhe54Xf6-6nMggKlLenGMQ&oe=69B6BA69"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Cool chimps", "keywords": [], "long_description": "In Cool Chimps, players are trapped in Chimp Safe, an abandoned nuclear bunker where failed experiments have given rise to intelligent and mutated chimps. What was once a refuge has become a deathtrap, and only the smartest and most resourceful can survive\n\nNavigate through dark, claustrophobic corridors filled with hazards, solve challenging puzzles to unlock new areas, and use stealth to avoid detection by the chimps. Each decision matters as the chimps adapt to your behavior, making escape increasingly difficult.\n\nDynamic AI that reacts to your choices and movement patterns.\n\nPuzzle-solving mechanics that drive the story forward\n\nImmersive soundscapes that heighten the tension in every moment.\n\nAre you brave enough to face the horrors of Chimp Safe and outsmart the mutants, or will you become just another victim in the depths of the bunker?", "short_description": "Cool Chimps is a VR survival horror game where players explore a dangerous nuclear bunker overrun by intelligent mutant chimps. Outsmart predators, solve puzzles, and escape before it\u2019s too late!\""}]}, "developer_name": "chimpscares", "developer_privacy_policy_url": "https://sites.google.com/view/coolchimps/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "chimpscares", "support_website_url": null, "website_url": "https://sites.google.com/view/coolchimps/home?authuser=0", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "29
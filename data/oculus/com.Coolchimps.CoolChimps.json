1.oculuscdn.com/v/t64.5771-25/473391924_3070806556422541_3207533555842024710_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WRj4k6ME18UQ7kNvwGPko6V&_nc_oc=Adkp9_muap1uKu5w65iRuHERoZILQpKkrUYLkON9zCNb4pDyoE54Zd0yiNzM0ykSmKk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afte9BKnb3ps82ILXGDT94AJLgL9Cbf16AQgM9cW3eR00g&oe=699D9D6E"}, {"file_name": "SampleScene_Custom..._27.03.2025_11-03-58.png", "id": "513608218469834", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391883_513608221803167_4133559235040658427_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h9VPCxl913EQ7kNvwFpKq_l&_nc_oc=AdmcNguzG64zv8chvPENUrgZHQ156xtOSOpAbkGHnNY3I9LmpWYKxcX5iQKQ9CYmo90&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfvDNl9YxYCPOTlXYOurab6c77qQ9KEZGlLPYacOQhM0ow&oe=699D93F1"}, {"file_name": "SampleScene_Custom..._27.03.2025_11-04-19.png", "id": "581136201603867", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473391924_581136204937200_1885997537842753681_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HoqsBLfFHtQQ7kNvwGLkUfh&_nc_oc=AdmgKk9iZQKoPiqk7pnyqW1MI2Z7-N4i7Iw2s-j9rGYQkw-7T6siz-PMX1zs9hlbNNs&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AftwjUqQRdxhICQBzHRXRbVi7AdbgtiBR6-eV8dsE5i2gg&oe=699DACD4"}, {"file_name": "SampleScene_Custom..._27.03.2025_11-04-35.png", "id": "1582418175836304", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391888_1582418179169637_3590472074617371809_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A_3bDCQRJRsQ7kNvwHEZDR5&_nc_oc=AdkH9bQhAs0RLGJn4ivZUaNj8l6nudqGnvU7zx0iBluN4ZnPntg94XvBA3D0ikkFlYs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfsWAu-TcB6oFpn6Ys9aRRoTTkfX93Z2UTGX3oLYh6QNZA&oe=699DADE9"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Cool chimps", "keywords": [], "long_description": "In Cool Chimps, players are trapped in Chimp Safe, an abandoned nuclear bunker where failed experiments have given rise to intelligent and mutated chimps. What was once a refuge has become a deathtrap, and only the smartest and most resourceful can survive\n\nNavigate through dark, claustrophobic corridors filled with hazards, solve challenging puzzles to unlock new areas, and use stealth to avoid detection by the chimps. Each decision matters as the chimps adapt to your behavior, making escape increasingly difficult.\n\nDynamic AI that reacts to your choices and movement patterns.\n\nPuzzle-solving mechanics that drive the story forward\n\nImmersive soundscapes that heighten the tension in every moment.\n\nAre you brave enough to face the horrors of Chimp Safe and outsmart the mutants, or will you become just another victim in the depths of the bunker?", "short_description": "Cool Chimps is a VR survival horror game where players explore a dangerous nuclear bunker overrun by intelligent mutant chimps. Outsmart predators, solve puzzles, and escape before it\u2019s too late!\""}]}, "developer_name": "chimpscares", "developer_privacy_policy_url": "https://sites.google.com/view/coolchimps/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "chimpscares", "support_website_url": null, "website_url": "https://sites.google.com/view/coolchimps/home?authuser=0", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "29322685220710880"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscd
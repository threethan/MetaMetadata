XL2LXC_Zg7WaE6-L_UdQbI&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=8&oh=00_Afxu5V8raHuVv328Tw2aHxNHncpg8YBY1D4jF2FKcbhMlg&oe=69BD37F1"}, {"file_name": "SampleScene_Custom..._27.03.2025_11-04-19.png", "id": "581136201603867", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/473391924_581136204937200_1885997537842753681_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZtgD3vDl6KgQ7kNvwH0-oWO&_nc_oc=Adl2L23cOJHlH-dyhY6D-10cByXBbK2z5p2wIW7KWZTi0hL8Iyb8u9D8v8vKDwNXB3s&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=8&oh=00_AfxNQH-V65saJwOJUkQWzlfVuKRatw67QrjcUXV4xpK4TQ&oe=69BD50D4"}, {"file_name": "SampleScene_Custom..._27.03.2025_11-04-35.png", "id": "1582418175836304", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/473391888_1582418179169637_3590472074617371809_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JxYW7A20TqoQ7kNvwG93-0e&_nc_oc=AdnxehVWJNskGkDWwgvldPFQ4F9oQVBCUrnmYBMfyOzPsdD6ilYXcrgA912C5OO0kpM&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=8&oh=00_AfzF0naiBBIp0C3WToAcOwO6hqN783ciK8FMT8FlVWVi2A&oe=69BD51E9"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Cool chimps", "keywords": [], "long_description": "In Cool Chimps, players are trapped in Chimp Safe, an abandoned nuclear bunker where failed experiments have given rise to intelligent and mutated chimps. What was once a refuge has become a deathtrap, and only the smartest and most resourceful can survive\n\nNavigate through dark, claustrophobic corridors filled with hazards, solve challenging puzzles to unlock new areas, and use stealth to avoid detection by the chimps. Each decision matters as the chimps adapt to your behavior, making escape increasingly difficult.\n\nDynamic AI that reacts to your choices and movement patterns.\n\nPuzzle-solving mechanics that drive the story forward\n\nImmersive soundscapes that heighten the tension in every moment.\n\nAre you brave enough to face the horrors of Chimp Safe and outsmart the mutants, or will you become just another victim in the depths of the bunker?", "short_description": "Cool Chimps is a VR survival horror game where players explore a dangerous nuclear bunker overrun by intelligent mutant chimps. Outsmart predators, solve puzzles, and escape before it\u2019s too late!\""}]}, "developer_name": "chimpscares", "developer_privacy_policy_url": "https://sites.google.com/view/coolchimps/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "chimpscares", "support_website_url": null, "website_url": "https://sites.google.com/view/coolchimps/home?authuser=0", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "29322685220710880"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1182923050158946"}]}, "baseline_offer": {"id": "1182923050158946"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1744912440, "status": "PUBLISHED", "id": "1182923050158946"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "34525986507047366", "version": "0.18"}, "id": "1148556667006469", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "29029999989979406", "is_concept": fa
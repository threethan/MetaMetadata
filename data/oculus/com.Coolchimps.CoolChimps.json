_11-03-36.png", "id": "3070806553089208", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473391924_3070806556422541_3207533555842024710_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qulP0DzMdQsQ7kNvwH5Dkq1&_nc_oc=Adlx6o93hYpLydKsSqmrTTf5vP_pX2OVxaNPHoIKeBViOuq08p9Mbu80ghmTik9CwpI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afw8Jk_ZKMvJwYCipOAwqn0h9JS6IbJ1mjErpwVDoKgHNA&oe=69AEC0EE"}, {"file_name": "SampleScene_Custom..._27.03.2025_11-03-58.png", "id": "513608218469834", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473391883_513608221803167_4133559235040658427_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Qi6mv93JpLIQ7kNvwGGqG_j&_nc_oc=Adlfg81g5_hXtAtE8LdOfIz-e8sFog-stnw0bGnTlQeBJfqXhzZuqDBKIBfwQT4yY-s&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afw9ij2VNKGgBezGChc0TuMiHChLCyEIT7Y2nEtZ6QE01g&oe=69AEB771"}, {"file_name": "SampleScene_Custom..._27.03.2025_11-04-19.png", "id": "581136201603867", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473391924_581136204937200_1885997537842753681_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=du0OwaY75v4Q7kNvwHZEoyI&_nc_oc=AdmxcwdVsavxIDzbDn9hhGgOauFs1hWMXSz4m634wFrOheRx5yg59w41lc-_zcyG9QQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afwuiu7AjakPHgR01MYrACZfKPfAEGPFp6I9v97NL-B-SA&oe=69AED054"}, {"file_name": "SampleScene_Custom..._27.03.2025_11-04-35.png", "id": "1582418175836304", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473391888_1582418179169637_3590472074617371809_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=anlrGBP57jQQ7kNvwEN5gJW&_nc_oc=Adks5qnCX1gm1UeU9azKkMoytKGGcjs0QMpJZs-Mf6Ax5m3GmmQR7cZgQV7MMW3q5lQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfyW3HYzuhEg_3eYQDjGbzerxvUD6c7Gv4u1Hyok0HVFTQ&oe=69AED169"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Cool chimps", "keywords": [], "long_description": "In Cool Chimps, players are trapped in Chimp Safe, an abandoned nuclear bunker where failed experiments have given rise to intelligent and mutated chimps. What was once a refuge has become a deathtrap, and only the smartest and most resourceful can survive\n\nNavigate through dark, claustrophobic corridors filled with hazards, solve challenging puzzles to unlock new areas, and use stealth to avoid detection by the chimps. Each decision matters as the chimps adapt to your behavior, making escape increasingly difficult.\n\nDynamic AI that reacts to your choices and movement patterns.\n\nPuzzle-solving mechanics that drive the story forward\n\nImmersive soundscapes that heighten the tension in every moment.\n\nAre you brave enough to face the horrors of Chimp Safe and outsmart the mutants, or will you become just another victim in the depths of the bunker?", "short_description": "Cool Chimps is a VR survival horror game where players explore a dangerous nuclear bunker overrun by intelligent mutant chimps. Outsmart predators, solve puzzles, and escape before it\u2019s too late!\""}]}, "developer_name": "chimpscares", "developer_privacy_policy_url": "https://sites.google.com/view/coolchimps/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "chimpscares", "support_website_url": null, "website_url": "https://sites.google.com/view/coolchimps/home?authuser=0", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "29
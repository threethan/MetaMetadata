ile_name": "Image10.png", "id": "1412085490570184", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499303391_1412085493903517_3982394700689002949_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sv4lepBouDsQ7kNvwEEc_Uz&_nc_oc=AdqGV4jLYypNxWKZRP9P7s0IfIF5yNqTL2J-AYx-pKvTvVGkKFiULfC2fyFIg5WYhko&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Af10IHfhGOeIynxzNAtr-lWmHvCsRYeBqsffbeaNv00pCA&oe=69F0B2A5"}, {"file_name": "Image5.png", "id": "2296542017490988", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491830911_2296542020824321_8997493646992504664_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r41M7DU_3KUQ7kNvwGsBMCO&_nc_oc=AdrwCGol0Hoc-Fj8rJwPIBML55QUk2nlhqLUGnOV-zuLmG7sHpx2EgwavB25mKkgfsk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Af0XlxsCkbcFTUgr93aJQ6WOJteKfj7AL1nIoS_NEgnPAg&oe=69F0B833"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Game Name.png", "id": "858603299999832", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499295512_858603303333165_221985803058323794_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-f8U77zA33AQ7kNvwEP3ygq&_nc_oc=Adr4Jst-KWD407_kCbtszr1RHwRbFNlZe-Z0d5Brh_7YsKYIqzWntYdTcetKDJSRRDs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Af3Z-cRzXSZMv9NQi01hsATphSGRvNQUkznfQAEqUh7e9Q&oe=69F0B832"}, "display_name": "Stardew Garden", "keywords": ["garden", "stardew", "grow", "flower", "plant"], "long_description": "**Play at Stardew Garden for a chance to win real flowers!!!**  \na cozy, stylized gardening game set on a peaceful balcony. It\u2019s all about growing beautiful plants, relaxing, and enjoying a slow-paced, soothing experience\n# Features:  \n**\ud83c\udf3c Grow over 75 different types of plants, including flowers, aquatic plants, fruits, and vegetables \u2014 with a main focus on flowers**  \n  \n**\ud83d\uddfa\ufe0f Discover rare, beautiful, and uniquely shaped plants from across all seven continents, these plants are inspired by real-world botanical wonders \u2014 strange, exotic, and visually stunning**  \n  \n**\ud83d\udca6 Water, fertilize, and weed your garden, each action influences how your plants grow and thrive**  \n  \n**\ud83c\udf27\ufe0fEnjoy a dynamic weather system rain, sunshine, clouds, and more \u2014 changing the mood and visuals of your garden**  \n  \n**\ud83e\uddd8 No grinding, no clutter \u2014 just pure gardening and chill vibes, you only need to buy seeds; everything else flows naturally**\n  \n**\ud83c\udf19 Go to sleep, then watch your plants grow, time moves gently \u2014 and every morning brings surprises**  \n  \n**\ud83d\udc3f\ufe0f Interact with small animal visitors from squirrels to birds, you can feed them, play with them, and enjoy their company.**", "short_description": "play at Stardew Garden for a chance to win real flowers\uff01\uff01\uff01growing beautiful plants, relaxing, and enjoying a slow-paced, soothing experience"}]}, "developer_name": null, "developer_privacy_policy_url": "https://github.com/ShiSuoGameStudio/LMagicRealityStudioPrivacyPolicy/blob/main/LMagic%20Reality%20Policy.txt", "developer_terms_of_service_url": null, "publisher_name": "LMagic Reality Studio", "support_website_url": null, "website_url": "http://www.lmagicreality.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "zh_CN"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "32612813431697744"}, "review_messages": []}]}
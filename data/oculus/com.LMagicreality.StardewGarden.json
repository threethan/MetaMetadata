rd5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD3i-JLhrUfldIzPPJhZG9aMb7AlDAO0Wsq0USHivBA2w&oe=6A524629"}, {"file_name": "Image10.png", "id": "1412085490570184", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499303391_1412085493903517_3982394700689002949_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0OwL4-C0cLYQ7kNvwHEobBv&_nc_oc=AdqN8TMw-dumlGlqJx8WL1hVLwnbgEzk54zvv9_JWizZjRXM_0s2a9TqvRT01J-KyVs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBgRnQXL23eWOt4pUctzf78-nJKj3dboCqm_n21lPv2lg&oe=6A5241A5"}, {"file_name": "Image5.png", "id": "2296542017490988", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491830911_2296542020824321_8997493646992504664_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m2-iH7eT4zcQ7kNvwH3nUUN&_nc_oc=AdrnmSDTOOBbS4GktSUrnJAZCh_dNpfUfXQA_oVjfCbxpcEDGmY8ea9Ss6_JAx0Z0BQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAKnUPud1l6BBINIJP6mZ4L76HIaXp0uIFd-h31dx6R2g&oe=6A524733"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Game Name.png", "id": "858603299999832", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499295512_858603303333165_221985803058323794_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nu62MmYPI24Q7kNvwERdP52&_nc_oc=AdqvtJeJ5qdyum_lIv9vtz3VYN-DKwXLnTF7Q6olAoz1JbxhaHVxBITzM9pz9ovyqJc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDxt3w7-gUFqcTih7t6-g8ltOYX__L_SuzzqfUW6SYAVg&oe=6A524732"}, "display_name": "Stardew Garden", "keywords": ["garden", "stardew", "grow", "flower", "plant"], "long_description": "**Play at Stardew Garden for a chance to win real flowers!!!**  \na cozy, stylized gardening game set on a peaceful balcony. It\u2019s all about growing beautiful plants, relaxing, and enjoying a slow-paced, soothing experience\n# Features:  \n**\ud83c\udf3c Grow over 75 different types of plants, including flowers, aquatic plants, fruits, and vegetables \u2014 with a main focus on flowers**  \n  \n**\ud83d\uddfa\ufe0f Discover rare, beautiful, and uniquely shaped plants from across all seven continents, these plants are inspired by real-world botanical wonders \u2014 strange, exotic, and visually stunning**  \n  \n**\ud83d\udca6 Water, fertilize, and weed your garden, each action influences how your plants grow and thrive**  \n  \n**\ud83c\udf27\ufe0fEnjoy a dynamic weather system rain, sunshine, clouds, and more \u2014 changing the mood and visuals of your garden**  \n  \n**\ud83e\uddd8 No grinding, no clutter \u2014 just pure gardening and chill vibes, you only need to buy seeds; everything else flows naturally**\n  \n**\ud83c\udf19 Go to sleep, then watch your plants grow, time moves gently \u2014 and every morning brings surprises**  \n  \n**\ud83d\udc3f\ufe0f Interact with small animal visitors from squirrels to birds, you can feed them, play with them, and enjoy their company.**", "short_description": "play at Stardew Garden for a chance to win real flowers\uff01\uff01\uff01growing beautiful plants, relaxing, and enjoying a slow-paced, soothing experience"}]}, "developer_name": null, "developer_privacy_policy_url": "https://github.com/ShiSuoGameStudio/LMagicRealityStudioPrivacyPolicy/blob/main/LMagic%20Reality%20Policy.txt", "developer_terms_of_service_url": null, "publisher_name": "LMagic Reality Studio", "support_website_url": null, "website_url": "http://www.lmagicreality.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "zh_CN"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE
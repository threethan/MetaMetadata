n.com&_nc_ss=7f20f&oh=00_AQSWHZdEfHDDeLGDfiBg4T0thtVOK2hy4m6RyADAIiLixw&oe=6AFDD09D"}, {"file_name": "13_screenshot_02.png", "id": "1422301600031947", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491823901_1422301606698613_2851049377529238286_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_rXaCRfllEUQ7kNvwEgye3b&_nc_oc=AdqgLKKxftJ6wkLFys0Fhx8oXr8VPuHOKIS3Fv6T_Vn6qAVL9MQ2nsvYM0IAtx-2raU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSG_6WZv7MVnGmjvY_kP-up5tg-YPtXRYgKUx3MICZVxg&oe=6AFDAC68"}, {"file_name": "14_screenshot_03.png", "id": "1137697165273237", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491825415_1137697168606570_1442794505401849700_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=teRRuDclzgcQ7kNvwEes-lC&_nc_oc=Adr9hdQbXGrhsfgUpGFyCw8XvZ7lKkKhjLNvyfK1rbvayk7m9ESo0evj_9D472Ae83c&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQLQvQcWR5T0dqubDXcA_xgY0ZCe4e4b1iQYiVB0dLNXA&oe=6AFDD4E1"}, {"file_name": "15_screenshot_04.png", "id": "3647054015459104", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491824322_3647054022125770_6119449375701195791_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Wd280sBNQYAQ7kNvwFPHZSG&_nc_oc=Adpk3_1zvUS5ijD-kbqaeso-4V0x9mByTIEm4eHGZytnUG4nnaX8y754EmheUQIjItE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT0ZwGsa-R0okjlk9WSTpXpzNi-FVbd8HNqKV1By8Tc-g&oe=6AFDBE48"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Final Rideout", "keywords": ["Dirtbike", "Motocross", "bikes", "physics"], "long_description": "Final Rideout is about the ride itself.\n\nHold the handlebars and the bike is yours to manage. Throttle, brakes, clutch and gears all sit in your hands, and the bike answers to how you use them. Lean into a corner, carry too much speed, come up short on a jump: the bike lets you know, and the next run goes better.\n\nRide through city streets, along a busy interstate and down through a canyon. Every run goes from start to finish against the clock, and your best times wait for you back in the garage.\n\nThe garage is also where you make the bike your own: change the bodywork, paint, graphics and parts until it looks the way you want.\n\nTake it slow and clean, or send it off every jump you find.", "short_description": "Final Rideout is dirt biking you ride with your own hands. Hold the bars, work the throttle and clutch, and let the bike answer to every lean, every brake and every landing as you chase a cleaner, faster run."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/final-rideout/home/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "RadShot", "support_website_url": null, "website_url": "https://sites.google.com/view/final-rideout/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}, {"id": "673385183287495"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1294034090469424"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "4426692330904278"}]}, "baseline_offer": {"id": "4426692330904278"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1793439300, "status": "PUBLISHED", "id": "4426692330904278"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results
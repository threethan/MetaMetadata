content-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRmwzLcSpcO2i7kruOUuVrhzstNH7QmDyT6ppWMy81NWw&oe=6B0869BE"}, {"file_name": "16_screenshot_05.png", "id": "1110806428390837", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/491828104_1110806438390836_227912593037577151_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uN2T9m5im6wQ7kNvwGMUvXa&_nc_oc=AdrcCJDfzjMhWmu102EHy-2x4kEP-X9I1e2GZQXG3IvCRTII7T4zTgrFwhgTobcRsxk&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS8JCANy7eAyL_xkVHvNaj_rIgyLJUrTO__6LNGujjAIg&oe=6B085C9D"}, {"file_name": "13_screenshot_02.png", "id": "1422301600031947", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/491823901_1422301606698613_2851049377529238286_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DrEO0DiDGg8Q7kNvwE_59Wo&_nc_oc=AdpEQ7pVHbX_AwLNugE0_YHRnuH3FdavyMuPm3-5X145iqS5cuomcy3Rq2bns0o6-fo&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSQjW3EKgpc_G4Eab2XjE4cpOhCdh0YwRoT37iyU-C8mg&oe=6B0870A8"}, {"file_name": "14_screenshot_03.png", "id": "1137697165273237", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/491825415_1137697168606570_1442794505401849700_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ehrTV2aWcD0Q7kNvwEDr1cX&_nc_oc=AdpM-HScKKgxc6CZ1G5GarUGi8BFnzhP2PQJDkiJpc7qOaTg-P2bK7GSCmkHR2VqI5w&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT6hzt_cDd7M8LTW5zq8sgI2hvs34WOMZ3p5L-BvXSACA&oe=6B0860E1"}, {"file_name": "15_screenshot_04.png", "id": "3647054015459104", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/491824322_3647054022125770_6119449375701195791_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Qi_3N9z3GLQQ7kNvwEMF4Vg&_nc_oc=AdptMB69LwaDO_A4issW5uQadLkwc10wJNjCEjctOnhngj7kLRyuXLnzVnx3ImNgJzU&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT3l8E_sPqd6nQNL161Ur1xA7_qIt0KscMPpxBckwQBzg&oe=6B084A48"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Final Rideout", "keywords": ["Dirtbike", "Motocross", "bikes", "physics"], "long_description": "Final Rideout is about the ride itself.\n\nHold the handlebars and the bike is yours to manage. Throttle, brakes, clutch and gears all sit in your hands, and the bike answers to how you use them. Lean into a corner, carry too much speed, come up short on a jump: the bike lets you know, and the next run goes better.\n\nRide through city streets, along a busy interstate and down through a canyon. Every run goes from start to finish against the clock, and your best times wait for you back in the garage.\n\nThe garage is also where you make the bike your own: change the bodywork, paint, graphics and parts until it looks the way you want.\n\nTake it slow and clean, or send it off every jump you find.", "short_description": "Final Rideout is dirt biking you ride with your own hands. Hold the bars, work the throttle and clutch, and let the bike answer to every lean, every brake and every landing as you chase a cleaner, faster run."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/final-rideout/home/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "RadShot", "support_website_url": null, "website_url": "https://sites.google.com/view/final-rideout/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}, {"id": "673385183287495"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes"
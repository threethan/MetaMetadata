content-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQhA2ytb4GUAQ_QEcMxAzEr1_PK3jyKgyoJ7nNHmOkmsw&oe=6B0B44FE"}, {"file_name": "16_screenshot_05.png", "id": "1110806428390837", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/491828104_1110806438390836_227912593037577151_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Cq_Sq_SSilUQ7kNvwFS3GVN&_nc_oc=AdoLxMN8nribJqHkUoC2Qch-j77vMn0p0SpqecOeJX1oUXxYu-P0amPswWCkDyWauSY&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQoUSn3kZRnKUQeUZToMVWm0LlPURONjia7FGih2lz1OA&oe=6B0B37DD"}, {"file_name": "13_screenshot_02.png", "id": "1422301600031947", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/491823901_1422301606698613_2851049377529238286_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7cMdWN_o61cQ7kNvwF7Nlxg&_nc_oc=Adq4N72i4mTHMMVc261qDY38I7qyIqZIWPSCInscYGPNr2NkgEGOdjGTEpOxElahwHs&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQ-LFOJVtk3UrAkJ3YlAyaubql8l5yRa1hwMh638TPFOg&oe=6B0B13A8"}, {"file_name": "14_screenshot_03.png", "id": "1137697165273237", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/491825415_1137697168606570_1442794505401849700_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HmiaGMeFOQQQ7kNvwHeBlDR&_nc_oc=Ado9Qv077ZZuiWvBX1TZfPIjmp1DbfS9A2WPO7-XimKFmbNqYIB0RmGObCKdDgScGLg&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQbMJSGutRRxQX-C-WD_J0gM0J0Hf2J0PmqNoWFJmxMXg&oe=6B0B3C21"}, {"file_name": "15_screenshot_04.png", "id": "3647054015459104", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/491824322_3647054022125770_6119449375701195791_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Qi_3N9z3GLQQ7kNvwE2xqiR&_nc_oc=Adp7yrBw0_ypFKrbiJ5C4W5LMM6IDPweabXeoXNmWlxNdYgr7Kl-cvidZkLvFmkjf9c&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQRH0WQwQEGDVmtonH48f6NvAAGieYN3xGNlCzeWihvIg&oe=6B0B2588"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Final Rideout", "keywords": ["Dirtbike", "Motocross", "bikes", "physics"], "long_description": "Final Rideout is about the ride itself.\n\nHold the handlebars and the bike is yours to manage. Throttle, brakes, clutch and gears all sit in your hands, and the bike answers to how you use them. Lean into a corner, carry too much speed, come up short on a jump: the bike lets you know, and the next run goes better.\n\nRide through city streets, along a busy interstate and down through a canyon. Every run goes from start to finish against the clock, and your best times wait for you back in the garage.\n\nThe garage is also where you make the bike your own: change the bodywork, paint, graphics and parts until it looks the way you want.\n\nTake it slow and clean, or send it off every jump you find.", "short_description": "Final Rideout is dirt biking you ride with your own hands. Hold the bars, work the throttle and clutch, and let the bike answer to every lean, every brake and every landing as you chase a cleaner, faster run."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/final-rideout/home/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "RadShot", "support_website_url": null, "website_url": "https://sites.google.com/view/final-rideout/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}, {"id": "673385183287495"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes"
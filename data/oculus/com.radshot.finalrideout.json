content-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQR3u-oJyolN7UbJd7OYo3kNLJDf9eUb0W2Wr9xnk_oX7g&oe=6B0DAFBE"}, {"file_name": "16_screenshot_05.png", "id": "1110806428390837", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491828104_1110806438390836_227912593037577151_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OUEtDPdDpyEQ7kNvwHhq8rl&_nc_oc=AdpfXpJjrWqGZSiD6m6ygc071oQnBUzba3AdFZiPd4NbNIGHmUMalsMMHcbELLY_Xn4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSMLUAlNXkqlk7RPBDieuFCqKxjL8r8qS4ZgPFWkqQcCw&oe=6B0DA29D"}, {"file_name": "13_screenshot_02.png", "id": "1422301600031947", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491823901_1422301606698613_2851049377529238286_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_LV9gc2275oQ7kNvwHI05Th&_nc_oc=AdpMMwY_55WZWLaco3HiotfOPwv1fg8ln0F5ljO3pfBkvzSk5kCB78fCpc8zpvPBKus&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSkfTEZeuoRkcshLHXjkMJ3S157E2ptJgSiCdTjJNeFPg&oe=6B0DB6A8"}, {"file_name": "14_screenshot_03.png", "id": "1137697165273237", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491825415_1137697168606570_1442794505401849700_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HmiaGMeFOQQQ7kNvwEubSIf&_nc_oc=AdoU2_KqN34-gZPLMvZ4Fgknsz6cqpHdWoY5XKKDJIXPMkjjM2R8BGVLGU1y6O5y7Lw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQg6lXSFYKK2Rxj-pQ9f36F2708bAwHUxAELknh6kW9Ag&oe=6B0DA6E1"}, {"file_name": "15_screenshot_04.png", "id": "3647054015459104", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491824322_3647054022125770_6119449375701195791_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x87MKmpCvsYQ7kNvwG5mKKF&_nc_oc=AdoDC_5Q3Tm7ZgUKA09etZ9gPJO8PU8G7yjhseMKfN9AP0Ta8ipv75ahTW87EMabM_I&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSwsC0AfOiWgMgZmoXuAeuIyTXF0B1EesGlEkByRE4yvQ&oe=6B0DC888"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Final Rideout", "keywords": ["Dirtbike", "Motocross", "bikes", "physics"], "long_description": "Final Rideout is about the ride itself.\n\nHold the handlebars and the bike is yours to manage. Throttle, brakes, clutch and gears all sit in your hands, and the bike answers to how you use them. Lean into a corner, carry too much speed, come up short on a jump: the bike lets you know, and the next run goes better.\n\nRide through city streets, along a busy interstate and down through a canyon. Every run goes from start to finish against the clock, and your best times wait for you back in the garage.\n\nThe garage is also where you make the bike your own: change the bodywork, paint, graphics and parts until it looks the way you want.\n\nTake it slow and clean, or send it off every jump you find.", "short_description": "Final Rideout is dirt biking you ride with your own hands. Hold the bars, work the throttle and clutch, and let the bike answer to every lean, every brake and every landing as you chase a cleaner, faster run."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/final-rideout/home/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "RadShot", "support_website_url": null, "website_url": "https://sites.google.com/view/final-rideout/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}, {"id": "673385183287495"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes"
 "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499307931_1401277858225191_1139797551011718441_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OQz4f-AGXc0Q7kNvwGmEzlw&_nc_oc=AdpnCi7ijcm-Eg3eTMLvR2JRSmPJezG8FyeE-s8bUQS3d6Vwt4hi9FiWVe-GvAS3xpE&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIIjXGivgUppfcgh7dJjodxqj7dgeWgPXV2ojNCYf_2-A&oe=6ABD2E99"}, {"file_name": "SS5_1.png", "id": "2009730616506905", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499307931_2009730619840238_63730390878936123_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hXUE57LPaXYQ7kNvwHdnVG2&_nc_oc=AdoSx5MisSDvboaZ9xSv2aS9FZyPKkE8FZotzNp3dhqPMJmjk4vpA0BamERYq_IQMuM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIqS6_6gdXgSjrxxy5J3ViEpA4vayZn0vNdJMM-2qNIPQ&oe=6ABD1C02"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailerss.png", "id": "1415229259669041", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491822045_1415229263002374_1316771994605676758_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Uqctgd3KlmIQ7kNvwHvgzYg&_nc_oc=AdpKjF0OVqxK3Z_v5tj7z1gvQU9CAty74T8XBeMPrUHt9gC0AScdruj4K3W1G0-xlvs&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLnIFETlcHksM3HnaWrBnHHGNaWfmKYFx5aHLsue9oPPw&oe=6ABD08BF"}, "display_name": "Containment Initiative 2: Recon", "keywords": [], "long_description": "Containment Initiative 2: Recon is a singleplayer version of Containment Initiative 2 designed for standalone headsets.\n\n# Story:\nKay is your communications specialist and will provide mission details and valuable information while you try to find a means of escape.\n\n# Realistic Reloading:\nEach weapon handles and reloads just like it's real world counterpart. Mastering reloading is essential to surviving the horde!\n\n# Progression:\nUnlock guns by successfully obtaining supply drops or by finding hidden weapon caches scattered around Sector 4.\n\n# Dismemberment/Blood:\nHeadshots trigger a slow motion effect for maximum carnage!\n\n# Mission Types:\n- Supply drop missions require the player to put their money on the line for a chance to unlock better equipment.\n- Scanner Defense missions push the action to maximum by giving the player plenty of ammo and putting them on the defensive.\n- Take a slower pace and visit different areas for a chance to collect crafting materials and ammo\n", "short_description": "Explore, scavenge, and fight as you attempt to escape from Sector 4. Survive the horde by finding supplies to upgrade your gear, collecting supply drops and finding hidden caches of weapons and equipment."}]}, "developer_name": null, "developer_privacy_policy_url": "https://gwyngames.net/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Gwyn Games LLC", "support_website_url": null, "website_url": "https://gwyngames.net/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "644354873106712"}, {"id": "459781504968480"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25538871092418425"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499298337_1372514483970011_1385197304118841606_n.png?stp=dst-png_s360x360&_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qfVZKhJUDYwQ7kNvwFwQL5n&_nc_oc=AdrPSS062xIDxfJbvYpmleYNAvnBOly_vqvqIpNl3axBN8S8GWUEL0pdfixxUzLHqXc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_A
GxE0gQ7kNvwEV8Ehz&_nc_oc=AdpMvI5cgHjeBIK_XDKA3IO1hCi7_mDIDYV9GlI-gum8dDhVpMBUhncYMQD2rxa5orU&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR0Vde3PmDy9KiPJOGJfk8efzztDNstD1-uNIPs0WL6TQ&oe=6AFC7493"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_cover.png", "id": "1130846949516236", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/585799753_1130846952849569_7416840723248265138_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BP6-pIQAUqoQ7kNvwF3SfSG&_nc_oc=AdqNbICf7A3GA3lEKQ_xvFmEFcR2RVnQMrfr84jo-mtVMP_3fI9vmvlGwaCVDa5-p00&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQUqwos5SYnk-QyBtpVBcQL0h9hlB0MAIOyMGoGMY_KHA&oe=6AFC7001"}, "display_name": "Flight Simulator Vienna", "keywords": ["flight", "simulator", "vienna", "jet", "pilot"], "long_description": "Flight Simulator Vienna puts you in the captain's seat over the real Vienna.\n\nTHE REAL VIENNA\nReal satellite, elevation and map data: St. Stephen's Cathedral and its patterned roof, the Hofburg, the State Opera, the Rathaus, the Parliament, the Karlskirche, the Belvedere, Schoenbrunn and the Gloriette, the Riesenrad in the Prater, the Donauturm, the DC Tower, UNO City and the Gasometers.\n\nTHE DANUBE AND THE HILLS\nFly the Danube through the Vienna Gate between the Kahlenberg and the Bisamberg, over the vineyards and Klosterneuburg Abbey, out to Lake Neusiedl, with the Alps on the horizon.\n\nA LIVING CITY\nTrains on their real tracks, the U6 on its viaduct, boats and river cruisers on the Danube. At night the Ring lights up.\n\nAIR TRAFFIC CONTROL\nTaxi and takeoff clearances, traffic calls and your landing clearance.\n\nENGLISH AND GERMAN\nSwitch every menu between English and German in Settings.\n\nYOUR GLASS HANGAR\nEvery flight starts in your glass hangar on the Danube, the Riesenrad out of the doors. Walk around, repaint, wash, fly.\n\nFOUR AIRCRAFT\nTwo private jets with walk-through cabins, a midsize jet with yokes and a twin-engine fighter.\n\nELEVEN MISSIONS\nThe Danube run, the Ringstrasse, the Vienna Woods, a fighter scramble, Vienna by night and a city tour.\n\nFLY TOGETHER ONLINE\nQuick Match or a private sky with a code. Voice chat stays off until you turn it on.", "short_description": "Fly the real Vienna, built from real satellite and map data: St. Stephen's Cathedral, the Hofburg, the Ringstrasse, Schoenbrunn, the Riesenrad, the Danube, the Vienna Woods and Lake Neusiedl. Start in your own glass hangar on the Danube, talk to air traffic control and land at Vienna Schwechat. English and German menus."}]}, "developer_name": null, "developer_privacy_policy_url": "https://citiview-games.pages.dev/flightsimulatorvienna/privacy", "developer_terms_of_service_url": null, "publisher_name": "Citiview Studios", "support_website_url": null, "website_url": "https://citiview-games.pages.dev/flightsimulatorvienna/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "de"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1376716652191537"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1645968590405283"}]}, "baseline_offer": {"id": "1645968590405283"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1791919800, "status": "PUBLISHED", "id": "1645968590405283"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "b
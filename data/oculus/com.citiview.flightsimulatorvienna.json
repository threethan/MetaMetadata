/604310912_2261439524704826_428376450045943612_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Hlp047jZS9wQ7kNvwF9aH2Q&_nc_oc=AdqtyzfZTOOP3uU8Kpbke1pFctsHKVzdJdJz1sEtNKmkUGrIbAg30EfMfgYAHTZWoHE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ6U6tEUVeiJmZm8EXdYaDLaNeP8PKNp_VrmtLWx3yPMA&oe=6AFDD7F7"}, {"file_name": "screenshot_1.png", "id": "1406678224949009", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/673525341_1406678228282342_3900072011954086115_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YpU3OuFU8H4Q7kNvwG4Hlge&_nc_oc=AdpO3BA-k-DO0q8w1IQVWqYMlAlFfJtm-3fqXpByVZ9iOXDFcrGI4L3DbmdzkkRny30&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRLUpkMmOE2gsJZewQdSxjr50-ZdgIcoAL1q0mvD9Xn0w&oe=6AFDD893"}, {"file_name": "screenshot_4.png", "id": "1462504502393678", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491830904_1462504505727011_8937535604585591596_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=adSspFyw-WIQ7kNvwHa8hMC&_nc_oc=AdrLGGgfOHEnbzd0mniGIzdmvxIYpeP5iKEytSv0jbdVoihUcLb46ovUKUn_Ak_byeo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTPq0ZNWxnCeisO7-E6_27kfOtQtDSQyTnH1leSHdwSlw&oe=6AFDBBDD"}, {"file_name": "screenshot_2.png", "id": "1324649337408564", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/737543484_1324649340741897_6407207390622646131_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j-9-GxCDHGEQ7kNvwH9ZrIv&_nc_oc=AdrmUcKvLxrMH21YZAsCXcONI7arrELvORUwiMppk3uAhc_kdbKx7VGjMtA0mw-ni3I&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTtAZb6Ba3qlb19lLIPACmYSBNULzct2ksE7T12gaXvlg&oe=6AFDAE33"}, {"file_name": "screenshot_5.png", "id": "1592922818523656", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/595119480_1592922821856989_7193736834210748320_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZH7hLJGxE0gQ7kNvwEhP9Hm&_nc_oc=Adq3Ql-J1nU4IGtgJkjktIuT10xtIOz9aIZjHFO0cbeBm5VfmG97FUCPq9hlFYo5q9c&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQDjKvCUE_840XpMDxE8f3Kctbn5TLydKv08-nWpT3Hww&oe=6AFDC613"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_cover.png", "id": "1130846949516236", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/585799753_1130846952849569_7416840723248265138_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ncawa4wZJCsQ7kNvwHN2h6_&_nc_oc=AdoUgXq8CivHeyGzlMOK1JejQpXEgv2kvw5pD5jSIMRfd4vj3JgC4SCRpF2wyYacNLc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTdJzDNwIdvATEWOepYND2pt5GzIpkGpzo4bLeusd8BTg&oe=6AFDC181"}, "display_name": "Flight Simulator Vienna", "keywords": ["flight", "simulator", "vienna", "jet", "pilot"], "long_description": "Flight Simulator Vienna puts you in the captain's seat over the real Vienna.\n\nTHE REAL VIENNA\nReal satellite, elevation and map data: St. Stephen's Cathedral and its patterned roof, the Hofburg, the State Opera, the Rathaus, the Parliament, the Karlskirche, the Belvedere, Schoenbrunn and the Gloriette, the Riesenrad in the Prater, the Donauturm, the DC Tower, UNO City and the Gasometers.\n\nTHE DANUBE AND THE HILLS\nFly the Danube through the Vienna Gate between the Kahlenberg and the Bisamberg, over the vineyards and Klosterneuburg Abbey, out to Lake Neusiedl, with the Alps on the horizon.\n\nA LIVING CITY\nTrains on their real tracks, the U6 on its viaduct, boats and river cruisers on the Danube. At night the Ring lights up.\n\nAIR TRAFFIC CONTROL\nTaxi and takeoff clearances, traffic calls and your landing clearance.\n\nENGLISH AND GERMAN\nSwitch every menu between English and German in Settings.\n\nYOUR GLASS HANGAR\nEvery flight starts in your glass hangar on the Danube, the Riesenrad out of the doors. Walk around, repaint, wash, fly.\n\nFOUR AIRCRAFT\nTwo private jets with walk-through cabins, a midsize jet with yokes and a twin-engine fighter.\n\nELEVEN MISSIONS\nThe Danube run, the Ringstrasse, the Vienna Woods, a fighter scramble, Vienna by night and a city tour.\n\nFLY TOGETHER ONLINE\nQuick Match or a private sky with a code. Voice chat stays off until you turn it on.", "short_description": "Fly the real Vienna, built from real satellite and map data: St. Stephen's Cathedral, the Hofburg, the Ringstrasse, Schoenbrunn, the Riesenrad, the Danube, the Vienna Woods and Lake Neusiedl. Start in your own glass hangar on the Danube, talk to air traffic control and land at Vienna Schwechat. English and German menus."}]}, "developer_name": null, "developer_privacy_policy_url": "https://citiview-games.pages.dev/flightsimulatorvienna/privacy", "developer_terms_of_service_url": null, "publisher_name": "Citiview Studios", "support_website_url": null, "website_url": "https://citiview-games.pages.dev/flightsimulatorvienna/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "de"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1376716652191537"}}]}, "scheduled_offers": {"count": 0, "nodes": []}, "baseline_offer": null, "is_approved": true, "firstOffer": {"nodes": []}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1385276468002222", "version": "1.0.1"}, "id": "966755642681963", "channel_name": "LIVE"}]}, "is_for_ocu
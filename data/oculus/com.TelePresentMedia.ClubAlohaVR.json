hots": [{"file_name": "Screenshots 1.png", "id": "2381657658975901", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/604282317_2381657662309234_7041602305045788029_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=19ki4Scu70kQ7kNvwHjf3J2&_nc_oc=AdrQH0R1RW_2lD1-fpaAycdELGIzG4C8rYfLSU8ytuZ-OLc40Tm7-ApgOSjCwIpkeUI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_lCpI9crOh0116uWN0OnIqEhjaiG9NbbOjxv32k-FOcg&oe=6A3BE061"}, {"file_name": "Screenshots 2.png", "id": "1728761561617316", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499623314_1728761564950649_1045578112675396372_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FeGiKk79f8sQ7kNvwFpLC2N&_nc_oc=AdqKTSRccaePifnKAOOPikqzL6XM49oCccr4OVaR0Nb0qMVj0FB2wv_iIdOxbyTzjWo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-osZY-lQmMklKtgHflSvRBDelLMmDzLuG9thkkbKXmYA&oe=6A3BFD4C"}, {"file_name": "Screenshots 3.png", "id": "1702821550959414", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499620875_1702821554292747_3354699770005703089_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PwDcmBIU7B4Q7kNvwE_KhDF&_nc_oc=AdoSDX_4Nd14PcAh0KeKeVe77fPY6AyG97EX4wKqAEQOM8uupMl6LtAXWeCTBPkWECY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_nWn5DZP9wc3Wvoq7riqCgciWwK5ziICsiNY00Ig3OPA&oe=6A3BF559"}, {"file_name": "Screenshots 4.png", "id": "1416424980170031", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499619697_1416424983503364_6245342490642894753_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=La8dAEB9imsQ7kNvwEdYlLe&_nc_oc=Ado_jJmxMvC8TdfwYvdbDOXXUdvQe2mRXmwQ3jFl9tWnHYVlGcJcaVjVC7Xn0C_BAhM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-zFGcyhCwz2DnfQZC5HppY6fMM0NG1VAwZ9IMNYbkYwg&oe=6A3BFDA6"}, {"file_name": "Screenshots 5.png", "id": "1490958239476937", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499622214_1490958242810270_4178306165619001768_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OUc06hemM6wQ7kNvwGK8RRM&_nc_oc=AdqvNEApXbDRexdCeBl8EpICy9F7voJkNYoIX7RpfLMovM-Y1TR5Ww6mOttkbG9LUtg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-Gu03AhyT5IVKcrw4Oy1ljs_Q1HEcXqkx6gQZywGyGmw&oe=6A3BF8C2"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Club Aloha VR", "keywords": [], "long_description": "Club Aloha VR is a real live music venue where Maui-based musicians perform for you live in their full human form. They can see, hear, and talk with you in real time. Like really real time.\n\nOur early adopters call it \u201cthe best live music experience in VR.\u201d\n\nLaunch into a virtual nightclub where real musicians perform live from a dedicated custom studio designed to create a conventional stage experience while seamlessly presenting the virtual audience to the artists. They feel like you are there in the studio \u2014 and you will feel it too. The result is an authentic night out with friends, music, and conversation.\n\nEvery show is performed live from Maui, Hawaii featuring talented local musicians playing pop, rock, reggae, country, folk, and island-inspired favorites. No pre-recorded videos. No AI performers. Just real musicians sharing live performances with their audience in VR.\n\nUnlike traditional livestreams, Club Aloha VR creates genuine social presence. Dance and cheer for the band, talk with other fans, clap your hands, request songs, and torch up your lighter for encores while experiencing the energy of a real venue from anywhere in the world.\n\nFeatures:\n\u2022 Live interactive concerts in real time\n\u2022 Full-fidelity stereo audio from the PA system\n\u2022 Social VR with live audience interaction\n\u2022 Interactive crowd participation\n\u2022 A welcoming community of music fans and musicians\n\nDiscover why our growing community keeps coming back for the most personal live music experience in VR.", "short_description": "It's not just a multiplayer VR app. It's a live music venue where our Maui based musicians can see, hear and talk directly with you in real time!\n\n\u201cIt\u2019s the best music experience I\u2019ve seen in VR\u201d is what our fans tell us.\n\nClub Aloha is the first VR live music venue featuring real-time shows where fans and musicians can see, hear, and talk with each other just like a live concert. You are an avatar to them, and they are IRL to you. You\u2019ll swear you\u2019re at a real club!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://clubalohavr.com/privacy-policy", "developer_terms_of_service_url": "https://clubalohavr.com/tos", "publisher_name": "TelePresent Media, Inc.", "support_website_url": null, "website_url": "http://clubalohavr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}, {"id": "2687655338230691"}, {"id": "1228796255027646"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "27172988159003394"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499618432_2433276647195570_4975563642139353997_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8LNls0b7sTYQ7kNvwGuzGRU&_nc_oc=Adp0E8YdUrDTZ2fZpVRRJl7y1AjRdW6GVoqZZrdiGTRyLnHR__lgWqx-DOEy34D8J6I&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8BBP3UxTSVRYznAl__7SIqzqrHBfgPxV6Sil9Oeg940g&oe=6A3BE550"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Club Aloha
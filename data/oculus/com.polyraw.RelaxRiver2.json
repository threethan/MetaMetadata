5mM1ih6yz_p1vszetkmtWMqpypjh3enw&oe=6A6CC135"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "RR2560x1440Cover.png", "id": "1632889327547783", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491823901_1632889330881116_4679377153659819734_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SdZkCSbwX1wQ7kNvwESJceb&_nc_oc=AdrSbxt1lsjs6P1Sm3M9_vEA7_EKNKbmyk46Q2sXKShDNKSdr9-JpGHJey8iFgmKAHg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCQkyDXo8uGS_CNk0GX9vB1Gy8y9ASt8pWpjIESIEgHsg&oe=6A6CA659"}, "display_name": "Relax River 2", "keywords": ["relax", "river", "boat", "journey", "tour"], "long_description": "Settle into your little boat and let the world slow down as you drift along a tranquil river winding through vibrant forests, rocky cliffs, and peaceful mountain scenery. This new chapter builds on the beloved relaxing-river experience that introduced many players to calm, meditative VR journeys\u2014now completely remastered for modern hardware with richer environments and gentle optional interactions.\n\nYour ride remains fully guided and effortless: just sit back and immerse yourself in the peaceful atmosphere as nature surrounds you. Watch fish glide beneath the water\u2019s surface, observe wildlife along the riverbanks, and, if you wish, toss a bit of food into the water and see curious fish gather around your boat.\n\nWhether you\u2019re looking to unwind, enjoy a mindful break, or introduce someone to a serene first moment in VR, this soothing river ride is crafted to help you relax\u2014no menus, no stress, just pure quiet beauty.", "short_description": "Drift down a peaceful river aboard a small boat and unwind in a beautifully remastered relaxing VR experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.polyrawdevelopment.com/privacypolicyR2.html", "developer_terms_of_service_url": null, "publisher_name": "Polyraw Development", "support_website_url": null, "website_url": "https:/
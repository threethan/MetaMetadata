5582207949309_408727525579819108_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gZaiyjmhsesQ7kNvwHLdOry&_nc_oc=AdrLXJNc73gKpCBjCS74VQRSz5X-KDo5ikhZ-lDW6cKiq7pVtutXgucvq2gZzopH0XA&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQF9P8YV1I9yE8d8dUsHz_VFw9nLo_KpC7HrlP3k5XsaQ&oe=6AFB2335"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "RR2560x1440Cover.png", "id": "1632889327547783", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/491823901_1632889330881116_4679377153659819734_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e7PjxLX3RkYQ7kNvwHPIGSA&_nc_oc=AdqqKKU-V-3fQ85uaaIRkg9Y6tWaL5asVsabPn7-mjqrE6JPSq1Rjvh0EFPnukBy9Ks&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSNIgKKX-jyv2ZH4-vE68aHk06BjzAh03O02FX0PX6s6g&oe=6AFB4099"}, "display_name": "Relax River 2", "keywords": ["relax", "river", "boat", "journey", "tour"], "long_description": "Settle into your little boat and let the world slow down as you drift along a tranquil river winding through vibrant forests, rocky cliffs, and peaceful mountain scenery. This new chapter builds on the beloved relaxing-river experience that introduced many players to calm, meditative VR journeys\u2014now completely remastered for modern hardware with richer environments and gentle optional interactions.\n\nYour ride remains fully guided and effortless: just sit back and immerse yourself in the peaceful atmosphere as nature surrounds you. Watch fish glide beneath the water\u2019s surface, observe wildlife along the riverbanks, and, if you wish, toss a bit of food into the water and see curious fish gather around your boat.\n\nWhether you\u2019re looking to unwind, enjoy a mindful break, or introduce someone to a serene first moment in VR, this soothing river ride is crafted to help you relax\u2014no menus, no stress, just pure quiet beauty.", "short_description": "Drift down a peaceful river aboard a small boat and unwind in a beautifully remastered relaxing VR experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.polyrawdevelopment.com/privacypolicyR2.html", "developer_terms_of_service_url": null, "publisher_name": "Polyraw Development", "support_website_url": null, "website_url": "https://www.polyrawdevelopment.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}, {"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25422477137382131"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/491820433_1389683789321239_8667349746569313672_n.png?stp=dst-png_s360x360&_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MOyVd0fD-fwQ7kNvwFrKpqW&_nc_oc=AdpF0ELywa6SCP8FvXrZGjmBqoRBdrbUY5xBG1tYFY9eFIw_r4mRtwYajKaLdpY3NmE&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ-5SgnCeMi87ur3UQk1KpMaIbzWs92lJa9I6PGN9iIoQ&oe=6AFB2596"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Relax River 2", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_name": "Fitness & Wellness", "id": "810139357995560"}, {"topic_name": "Travel & Exploration", "id": "726368587961803"}], "release_date": 1764339480, "lastRevision": {"nodes": [{"id": "25422477150715463", "release_type": "SCHEDULED", "administration_sta
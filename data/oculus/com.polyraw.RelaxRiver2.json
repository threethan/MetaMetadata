_sid=6e7a0a&_nc_ohc=Sqb3WJGPpewQ7kNvwHKGQgy&_nc_oc=AdrHSKA3Q5eBVU0bllYqfKF1CS9yRHOs77WcVUdfHjCOZlpoyYfFT7uEaSAQsa7VLIM&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTguVS7Uny18yAkUsFVhPh0496LuLtq5rg9m8tUuh0FgA&oe=6B086F99"}, "display_name": "Relax River 2", "keywords": ["relax", "river", "boat", "journey", "tour"], "long_description": "Settle into your little boat and let the world slow down as you drift along a tranquil river winding through vibrant forests, rocky cliffs, and peaceful mountain scenery. This new chapter builds on the beloved relaxing-river experience that introduced many players to calm, meditative VR journeys\u2014now completely remastered for modern hardware with richer environments and gentle optional interactions.\n\nYour ride remains fully guided and effortless: just sit back and immerse yourself in the peaceful atmosphere as nature surrounds you. Watch fish glide beneath the water\u2019s surface, observe wildlife along the riverbanks, and, if you wish, toss a bit of food into the water and see curious fish gather around your boat.\n\nWhether you\u2019re looking to unwind, enjoy a mindful break, or introduce someone to a serene first moment in VR, this soothing river ride is crafted to help you relax\u2014no menus, no stress, just pure quiet beauty.", "short_description": "Drift down a peaceful river aboard a small boat and unwind in a beautifully remastered relaxing VR experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.polyrawdevelopment.com/privacypolicyR2.html", "developer_terms_of_service_url": null, "publisher_name": "Polyraw Development", "support_website_url": null, "website_url": "https://www.polyrawdevelopment.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}, {"id": "726368587961803"}], "external_subscription_type": "NOT_REQU
WWPFV50uvdtrECI-IZgHV5T-aM9ZdUaElRK62Uw&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=8&oh=00_AfxSyL17szJUPv_gVm3auuJD5BslnGBS05M7qZwkwkmrcA&oe=69AADBB5"}, {"file_name": "Screen05.png", "id": "840163325369493", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/491818885_840163332036159_4852134321186776422_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a7sfdwgCo9UQ7kNvwHW2osF&_nc_oc=AdkluFlT6wxrjSk3-kKuiHvTmgYmbDnwlBPyskzNYd-V6kJr83OUvU52O-EOYY05zFA&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=8&oh=00_AfxO9JU6wlGv8YpWtFnNArUjvaJUodFqmDrL78ScyjfDQw&oe=69AAB810"}, {"file_name": "Screen02.png", "id": "1275582201282643", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/491824322_1275582207949309_408727525579819108_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HEkkTb3K7aEQ7kNvwF34OOQ&_nc_oc=Adn__VlvmGMIoo4lJH1kjkS7iv2KyzYaxhJdcopQhEnLiSQ_fw81GePqr93jOBjWYqY&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=8&oh=00_Afzx3XsvMDPZarW3gn-2LcOYvEtZEN7ObEBJF-dgDlxVQA&oe=69AABC75"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "RR2560x1440Cover.png", "id": "1632889327547783", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/491823901_1632889330881116_4679377153659819734_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=p-evQthGrLMQ7kNvwHc7ung&_nc_oc=AdmPos5ZwBDH2647KLqnjBvaIMwSBJ6PP8xf7Wal3AP0lCBU6hGUMwuh-S1rvirdN9s&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=8&oh=00_AfzkDg6sF8Cbf2sFMXanMerRevIfPuLsKEqnwPFLkD-AjQ&oe=69AAD9D9"}, "display_name": "Relax River 2", "keywords": ["relax", "river", "boat", "journey", "tour"], "long_description": "Settle into your little boat and let the world slow down as you drift along a tranquil river winding through vibrant forests, rocky cliffs, and peaceful mountain scenery. This new chapter builds on the beloved relaxing-river experience that introduced many players to calm, meditative VR journeys\u2014now completely remastered for modern hardware with richer environments and gentle optional interactions.\n\nYour ride remains fully guided and effortless: just sit back and immerse yourself in the peaceful atmosphere as nature surrounds you. Watch fish glide beneath the water\u2019s surface, observe wildlife along the riverbanks, and, if you wish, toss a bit of food into the water and see curious fish gather around your boat.\n\nWhether you\u2019re looking to unwind, enjoy a mindful break, or introduce someone to a serene first moment in VR, this soothing river ride is crafted to help you relax\u2014no menus, no stress, just pure quiet beauty.", "short_description": "Drift down a peaceful river aboard a small boat and unwind in a beautifully remastered relaxing VR experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.polyrawdevelopment.com/privacypolicyR2.html", "developer_terms_of_service_url": null, "publisher_name": "Polyraw Development", "support_website_url": null, "website_url": "https://www.polyrawdevelopment.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}, {"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25422477137382131"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1553099129449507"}]}, "baseline_offer": {"id": "1553099129449507"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1764339480, "status": "PUBLISHED", "id": "1553099129449507"}]}, "liveChannel": {"nodes":
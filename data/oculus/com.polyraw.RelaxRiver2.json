8EorD1lB0kM1HXQg6J68&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0OUKCts8-7S7Un4E_WMfOWQAq5MenWntbQWAUNynzjNQ&oe=69F20CB5"}, {"file_name": "Screen05.png", "id": "840163325369493", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/491818885_840163332036159_4852134321186776422_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HHRUXEaUoU0Q7kNvwFwx5Xc&_nc_oc=AdqhwwlNvU0C3ClfEC7Egr9VkyoBd4EdwJqGhsxrK_P6lraF08c0wre2ZRaYfJLAEfU&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af35OWe9YmroCvVgU8U1lb1KM5M2e8_WSJV-W1uL7WcgKQ&oe=69F1E910"}, {"file_name": "Screen02.png", "id": "1275582201282643", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/491824322_1275582207949309_408727525579819108_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AivQf5Id2BUQ7kNvwFfyo74&_nc_oc=AdrAxnl0Ht3g4HrqNZwTStndbgI2VLP3Y3SZOYchtd3m9oJHb4y8SuowziS6ZAbJMuE&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0NiPTTWfgS_Sy4S-SA-JUFrHlEYijxZ648o3D40cPw-g&oe=69F1ED75"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "RR2560x1440Cover.png", "id": "1632889327547783", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/491823901_1632889330881116_4679377153659819734_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rkWuZQfdONAQ7kNvwGfFK3C&_nc_oc=AdoEtkSzTjgADZQsmgNMPjZI4rrwHF0Fk9kpp_zWuDX_YFcT1IIWI4msp2TS8gaBzrc&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_Af01m_QyJnYEyfeCNe6t_YNNK0rfasOYkSZ2Cn8P5dAADA&oe=69F20AD9"}, "display_name": "Relax River 2", "keywords": ["relax", "river", "boat", "journey", "tour"], "long_description": "Settle into your little boat and let the world slow down as you drift along a tranquil river winding through vibrant forests, rocky cliffs, and peaceful mountain scenery. This new chapter builds on the beloved relaxing-river experience that introduced many players to calm, meditative VR journeys\u2014now completely remastered for modern hardware with richer environments and gentle optional interactions.\n\nYour ride remains fully guided and effortless: just sit back and immerse yourself in the peaceful atmosphere as nature surrounds you. Watch fish glide beneath the water\u2019s surface, observe wildlife along the riverbanks, and, if you wish, toss a bit of food into the water and see curious fish gather around your boat.\n\nWhether you\u2019re looking to unwind, enjoy a mindful break, or introduce someone to a serene first moment in VR, this soothing river ride is crafted to help you relax\u2014no menus, no stress, just pure quiet beauty.", "short_description": "Drift down a peaceful river aboard a small boat and unwind in a beautifully remastered relaxing VR experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.polyrawdevelopment.com/privacypolicyR2.html", "developer_terms_of_service_url": null, "publisher_name": "Polyraw Development", "support_website_url": null, "website_url": "https://www.polyrawdevelopment.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}, {"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25422477137382131"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1553099129449507"}]}, "baseline_offer": {"id": "1553099129449507"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1764339480, "status": "PUBLISHED", "id": "1553099129449507"}]}, "liveChannel": {"nodes": [{"latest_supported_
ideo_trailer": null, "video_trailer_thumbnail": null, "display_name": "Moth+Flame", "keywords": [], "long_description": "Moth+Flame, an award-winning developer of communication technology and the premier provider of enterprise-grade immersive learning, has created the first-ever marketplace for corporate immersive learning content. The Promise immersive learning platform, powered by on device AI and NLP, offers innovative and adaptive learning programs for mastering technical and cognitive skills. Through partnerships with leading content developers and subject matter experts, such as the National Urban League and SHRM, Moth+Flame harnesses the best immersive experiences, supported by photo-realism and true-to-life reenactment scenarios.", "short_description": "The Moth+Flame immersive learning platform, powered by on device AI and NLP, offers innovative and adaptive learning experiences for practicing having difficult conversations using your voice. Through partnerships with leading content developers and subject matter experts, such as the National Urban League and SHRM, Moth+Flame harnesses the best immersive experiences, supported by photo-realism and true-to-life reenactment scenarios."}]}, "developer_name": null, "developer_privacy_policy_url": "https://support.promisevr.com/hc/en-us/articles/8613633776915-Privacy-Policy", "developer_terms_of_service_url": "https://support.promisevr.com/hc/en-us/articles/4406539065619-Terms-of-Service", "publisher_name": "Moth+Flame VR", "support_website_url": "https://support.promisevr.com/", "website_url": "https://mothandflamevr.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "539527055410505"}], "external_subscription_type": "REQUIRED", "genres": ["EDUCATIONAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "re
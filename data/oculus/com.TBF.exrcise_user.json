/t64.5771-25/38982635_636567378441452_960187589548057727_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GOxmx5K7T2sQ7kNvwGmQmtG&_nc_oc=Adkt52Zp2cD-DCxhP-brf5AVa6P1x2hG_h5Q8SMVQ9a04St-Dbwbsf1ri3GMowIzlt8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&oh=00_AfvW18mqc0FD3WJypb-FzYZt_ck6EiuCLhi4eYC8qvN2hw&oe=6998478A"}, "display_name": "eXRcise", "keywords": [], "long_description": "Puedes ejercitarte y disfrutar de entrenamientos profesionales solo, con un entrenador real o con tus amigos. Divi\u00e9rtete y ponte a prueba en el modo arcade, elige tu sesi\u00f3n diaria entre varios entrenamientos y ejercicios predefinidos dise\u00f1ados por profesionales cualificados. \n\nMejora tu t\u00e9cnica y tu salud gracias a los ejercicios y a los comentarios de los profesionales.\n\nNo olvides elegir el mejor entorno, puede ser una playa, lo alto de la ciudad o incluso la luna. \n\nTe acompa\u00f1aremos en toda tu experiencia en eXRcise, disfrutalo!!! ", "short_description": "Una aplicacion para el entrenamiento fisico, mental y social. "}]}, "developer_name": "XR First Tech Investments SL", "developer_privacy_policy_url": "https://exrcise.app/Privacy_Policy_eXRcise_EN.pdf", "developer_terms_of_service_url": "https://exrcise.app/Terms_Conditions_eXRcise.pdf", "publisher_name": "XR First Tech Investments SL", "support_website_url": "https://exrciser.com/contact", "website_url": "https://exrcise.app/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SPORTS"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "es_CO", "es", "es_VE", "es_PR", "es_PE", "es_MX", "es_CL", "es_AR"], "supported_input_devices": ["OCULUS_TOUCH"],
dCts7EVnWrUXDIVWpl_FWtBtncr64YhlA&oe=69BD32FD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover_Landscape.png", "id": "674076768466191", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/473391739_674076775132857_1037063208857033402_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x8mTDnFap5MQ7kNvwFyZPpo&_nc_oc=Adk-fJgyffk9yxyy6CZ8SRNeF1z0mXbXAJOh9AeIIhBOZaAhuTxaJd9-i21jvfkJa7U&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=8&oh=00_AfxRNU00kv7Lyvw15--40Mh7OxdXe4AnAyLy9ME7pRZJ0g&oe=69BD541C"}, "display_name": "eXRcise", "keywords": [], "long_description": "\u00a1Cuida tu salud entrenando con Realidad Virtual! Una app dise\u00f1ada para que tu rutina de ejercicios sea divertida, con entrenamientos dise\u00f1ados por profesionales que aprovechan al m\u00e1ximo las tecnolog\u00edas de RV. En eXRcise encontrar\u00e1s una gran variedad de entrenamientos de cardio, fuerza y movilidad, \u00a1adem\u00e1s de un modo desaf\u00edo centrado en el boxeo!\n\n\ud83c\udfafEntr\u00e9nate seg\u00fan tus OBJETIVOS\n\n\ud83d\udccaObt\u00e9n ESTAD\u00cdSTICAS de tu rendimiento\n\n\ud83c\udfdd\ufe0fElige tu ESCENARIO favorito para una experiencia inmersiva: un gimnasio virtual, la playa, \u00a1o incluso la luna!\n\n\ud83e\udd4aEntr\u00e9nate contra ti mismo con nuestro modo RETO\n\n\ud83d\udcaa\ud83c\udffdEntrenamientos creados por ENTRENADORES PROFESIONALES, con orientaci\u00f3n durante todo el ejercicio.\n\nY... \u00a1CLASES DE GIMNASIO! Entrena como si estuvieras en una clase de fitness desde cualquier lugar.\n\n Si tienes alguna duda, ponte en contacto con nosotros en exrciser-info@exrciser.com", "short_description": "Let your eXRcise flow\u2728"}]}, "developer_name": "XR First Tech Investments SL", "developer_privacy_policy_url": "https://exrciser.com/Privacy_Policy_eXRcise_EN.pdf", "developer_terms_of_service_url": "https://exrciser.com/Terms_Conditions_eXRcise.pdf", "publisher_name": "XR First Tech Investments SL", "support_website_url": nul
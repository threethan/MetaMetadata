223476_983692359813004_7557367347621088005_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RTDmp62Ph2YQ7kNvwH1ml7K&_nc_oc=AdogGr3JG1-5aRtx0omU8NZvJ7nlLJV1OWTrB9HheeAa4jKI727QCfAppmN7pX_8JVk&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQoC0Bhp098qE2SxLhuzfR87DfdtC5ObH04MysxMdg0Rg&oe=6B0B25CF"}, {"file_name": "05.png", "id": "451372747457171", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38984456_451372750790504_2680730408523464405_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rDjyfHOStKkQ7kNvwGzYX1e&_nc_oc=Adru_mn1y3oQzom_9mZYqHGA0Rnx_jVmq5yqR3LEHJO0sp8shux-ArM9kjYIB1jH6Kg&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQp95UO7blevquIzOBUJ-1e-o0hmB1Y4GBdMzEQOxe0jQ&oe=6B0B2EFD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover_Landscape.png", "id": "674076768466191", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/473391739_674076775132857_1037063208857033402_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S6Of8hYOdrkQ7kNvwGWwX3Y&_nc_oc=AdrFp2Su-Ui6DPL98kJqnbhAyfdXibH_v6ejnUJ--4QXxTTKoAclnZiC38rCzjsk3Gs&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRbrDXwhsDbJRDh8o6zEsyIDdN9JCHiDW6dRxnCfq4PjA&oe=6B0B17DC"}, "display_name": "eXRcise", "keywords": [], "long_description": "\u00a1Cuida tu salud entrenando con Realidad Virtual! Una app dise\u00f1ada para que tu rutina de ejercicios sea divertida, con entrenamientos dise\u00f1ados por profesionales que aprovechan al m\u00e1ximo las tecnolog\u00edas de RV. En eXRcise encontrar\u00e1s una gran variedad de entrenamientos de cardio, fuerza y movilidad, \u00a1adem\u00e1s de un modo desaf\u00edo centrado en el boxeo!\n\n\ud83c\udfafEntr\u00e9nate seg\u00fan tus OBJETIVOS\n\n\ud83d\udccaObt\u00e9n ESTAD\u00cdSTICAS de tu rendimiento\n\n\ud83c\udfdd\ufe0fElige tu ESCENARIO favorito para una experiencia inmersiva: un gimnasio virtual, la playa, \u00a1o incluso la luna!\n\n\ud83e\udd4aEntr\u00e9nate contra ti mismo con nuestro modo RETO\n\n\ud83d\udcaa\ud83c\udffdEntrenamientos creados por ENTRENADORES PROFESIONALES, con orientaci\u00f3n durante todo el ejercicio.\n\nY... \u00a1CLASES DE GIMNASIO! Entrena como si estuvieras en una clase de fitness desde cualquier lugar.\n\n Si tienes alguna duda, ponte en contacto con nosotros en exrciser-info@exrciser.com", "short_description": "Let your eXRcise flow\u2728"}]}, "developer_name": "XR First Tech Investments SL", "developer_privacy_policy_url": "https://exrciser.com/Privacy_Policy_eXRcise_EN.pdf", "developer_terms_of_service_url": "https://exrciser.com/Terms_Conditions_eXRcise.pdf", "publisher_name": "XR First Tech Investments SL", "support_website_url": null, "website_url": "https://exrciser.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SPORTS"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "es_CO", "es", "es_VE", "es_PR", "es_PE", "es_MX", "es_CL", "es_AR"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "MULTI_USER"], "id": "9750926851690125"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/473391848_1329302354851924_6503551401117416064_n.png?stp=dst-png_s360x360&_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P21yWxs_wwgQ7kNvwGfsoPa&_nc_oc=AdonHbeInupLesDMxt_MDMILxvQqQTkQrpknpjkkqAYbv3o3mN_BLvP5i5XEQBaTRcU&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f3
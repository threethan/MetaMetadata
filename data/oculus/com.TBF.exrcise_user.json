&_nc_ohc=xx2bFqd2w9sQ7kNvwG9ehB0&_nc_oc=AdoCpBrw7CXOAAQ28VXaPDM08o0A-tGJmkYY-olk9oiDxepy9i478zpQBb-CboUSkdI&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFEZzEq1UrlE_MAu3eveluC935QpRANPZVcucSR7ZKsDQ&oe=6A8EE25F"}, "display_name": "eXRcise", "keywords": [], "long_description": "You can exercise and enjoy professional workouts on your own, with a real trainer, or with your friends. Have fun and get challenged in the arcade mode, choose your daily session from several predefined workouts and exercises designed by qualified professionals. \n\nImprove your technique and health. Get exercises and feedback from sports and fitness professionals.\n\nDon't forget to choose the best environment, it can be a beach, the top of the city or even the moon. \n\nWe are with you throughout your eXRcise experience, have fun!\n", "short_description": "VR app for physical, social and mind health"}, {"images": {"nodes": [{"file_name": "Icon (1).png", "id": "1207821500616500", "image_type": "APP_IMG_ICON", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/38982544_1207821503949833_7279465545522210509_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DZsJBjYYyOYQ7kNvwFVBIyc&_nc_oc=AdpfJe51ae3Ld-r5948mIzS8XX0rk-hSt_b61Idc_8oWIVNSeZaejUQwKr_AN0xryxA&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEZ7_atuHvD5LtElUtQMYardn4vTws56shL1PKOL44kNQ&oe=6A8EC60C"}, {"file_name": "Cover Portrait (1).png", "id": "1029738121275803", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/39001702_1029738124609136_1954560374588661011_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9bPby2uuVIcQ7kNvwGBr7kP&_nc_oc=Adq0yqIBG4c0r_ESVFmOzwPteAcuQbgum4bUs3SaSGqGv708tV8xM9kaZXmlS9eC0F0&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGQEZJdkMEYzoD9Smsm33cU-Bqcp_o0_j8ZFvOECweTNw&oe=6A8ECA3B"}, {"file_name": "Mini Landscape (1).png", "id": "663383675677594", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri"
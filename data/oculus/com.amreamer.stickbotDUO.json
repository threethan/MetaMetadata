cPI4--sLyq8JnQR1Nj9KKSQ&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AftlFJnGtPeK6TKr4mxsF1KwHgCqy5P_rJtpf_WPhdNxKQ&oe=699C531D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover-image-video.png", "id": "1233595261905016", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491821923_1233595265238349_602594154407094045_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tZUnwB1A3JsQ7kNvwEYUIzG&_nc_oc=AdmvTGXIcgvQiFCuUB1J9L5WLKO-cUx2fLRPLQYFjuugbSOdOIYPtui5Pkt6iJ2P4M0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_Afv74mbiNZDpRUKg0vVwQ1gT0_vmtRM8AkoPvV9ZdsI2sg&oe=699C3FE3"}, "display_name": "StickbotDUO", "keywords": [], "long_description": "Remote hosted ip server automates the local ip sharing.  StickbotDUO uses UDP to communicate with each other over the local router.\n\nManual ip entry is supported.\nClap hands above head to activate Arcade Mode, and enter each others ip's using the virtual keyboard. That's it, without internet, just a LAN router.\n\nTested with a low-cost portable pocket router.\n\n\nUsing StickbotDUO with a VPN to simulate a LAN WIFI across the internet: NOT TESTED\n\nMulti-player mode works even without internet connection, manual ip entry instead supported instead.", "short_description": "StickbotDUO lets you dance with your mirror bot, or with a friend with another Quest 2 or 3 using your local WIFI. If internet access is not available, StickbotDUO shows local ip addresses to share with each other."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1yoz_u_ZBN883uI4H4c54Da69kIorsDypjN2DXn6bBmM/edit?tab=t.0", "developer_terms_of_service_url": null, "publisher_name": "amre-amer.com", "support_website_url": "https://docs.google.com/document/d/1LOFFleOUyG4_YQE0ALAhgEyKZ939ShYJBmesxfhBRfA/edit?usp=sharing", "website_url": "https://sites.google.com/amre-amer.com/resume/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context
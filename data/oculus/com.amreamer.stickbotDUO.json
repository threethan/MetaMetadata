-sjc6-1.oculuscdn.com/v/t64.5771-25/491820559_1333175441808028_3595707680450206723_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lU1d3_vRW2sQ7kNvwEL_uFh&_nc_oc=Admpw6-4I_9mrSqeoc2rFfcpjWpWARY47T15aqxMwq1u8YKgAd5WD6sXbCkAuyeMddA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfzloayUORkIEp-ZYDH5WKmTp0JBk4EHDcg30Onmb3pxKg&oe=69B16B1D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover-image-video.png", "id": "1233595261905016", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491821923_1233595265238349_602594154407094045_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PlxuZMxw60oQ7kNvwEeX86u&_nc_oc=AdlQCWoVJtNWBJE53iQ_gJIMCp9mZhqWXVWiMEyhx6lVxazXH0iQZg1zWfiq3XVau7A&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfyLh1z5TSLGbmvag4RbJF_7kiyRRAZ2s-Crfk_1AMYZBw&oe=69B157E3"}, "display_name": "StickbotDUO", "keywords": [], "long_description": "Remote hosted ip server automates the local ip sharing.  StickbotDUO uses UDP to communicate with each other over the local router.\n\nManual ip entry is supported.\nClap hands above head to activate Arcade Mode, and enter each others ip's using the virtual keyboard. That's it, without internet, just a LAN router.\n\nTested with a low-cost portable pocket router.\n\n\nUsing StickbotDUO with a VPN to simulate a LAN WIFI across the internet: NOT TESTED\n\nMulti-player mode works even without internet connection, manual ip entry instead supported instead.", "short_description": "StickbotDUO lets you dance with your mirror bot, or with a friend with another Quest 2 or 3 using your local WIFI. If internet access is not available, StickbotDUO shows local ip addresses to share with each other."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1yoz_u_ZBN883uI4H4c54Da69kIorsDypjN2DXn6bBmM/edit?tab=t.0", "developer_terms_of_service_url": null, "publisher_name": "amre-amer.com", "support_website_url": "https://docs.google.com/documen
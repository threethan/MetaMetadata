c_XCeTK8ycrsi3gb-mTn5QU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&oh=00_AfujFOX_MPwT9Bo8aKPgvQWjgtQW4ZXl_s1oADRAhtGApA&oe=69985E9D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover-image-video.png", "id": "1233595261905016", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491821923_1233595265238349_602594154407094045_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MjNfvy5XEEQQ7kNvwHUYuGj&_nc_oc=AdkS3GfX6KJS7ra92FKEISCUP4njTUS6gr991hsEFUJTivSnJeHFbpD9EkA69x0MtbU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&oh=00_AftNX9fbOJG8vcr37JbK_TX6uT8Kft-bQ-aP3u-iOnyLmQ&oe=69984B63"}, "display_name": "StickbotDUO", "keywords": [], "long_description": "Remote hosted ip server automates the local ip sharing.  StickbotDUO uses UDP to communicate with each other over the local router.\n\nManual ip entry is supported.\nClap hands above head to activate Arcade Mode, and enter each others ip's using the virtual keyboard. That's it, without internet, just a LAN router.\n\nTested with a low-cost portable pocket router.\n\n\nUsing StickbotDUO with a VPN to simulate a LAN WIFI across the internet: NOT TESTED\n\nMulti-player mode works even without internet connection, manual ip entry instead supported instead.", "short_description": "StickbotDUO lets you dance with your mirror bot, or with a friend with another Quest 2 or 3 using your local WIFI. If internet access is not available, StickbotDUO shows local ip addresses to share with each other."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1yoz_u_ZBN883uI4H4c54Da69kIorsDypjN2DXn6bBmM/edit?tab=t.0", "developer_terms_of_service_url": null, "publisher_name": "amre-amer.com", "support_website_url": "https://docs.google.com/document/d/1LOFFleOUyG4_YQE0ALAhgEyKZ939ShYJBmesxfhBRfA/edit?usp=sharing", "website_url": "https://sites.google.com/amre-amer.com/resume/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context
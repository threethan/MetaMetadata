9574"}, {"file_name": "screenshot-4.png", "id": "1333175438474695", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491820559_1333175441808028_3595707680450206723_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q34yX1yQwNcQ7kNvwHNYjHU&_nc_oc=Adp5J7CZEPSYANXTbKAXTeVqPOWyOvssZXxb0tDDF-UH6OGBdN_4Pyo8Rpm39Q_vufY&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDjzL2SjyvuZR8JgNV7olPo89G4DA-UUKNJQsgJxO1U2Q&oe=6A68AB9D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover-image-video.png", "id": "1233595261905016", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/491821923_1233595265238349_602594154407094045_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6yZiEHD-jOkQ7kNvwH8g4nj&_nc_oc=AdpPo3xm4dp7pzPewQ6lQydkeAtbDGMyWzg-9s8S3bsnqMt1SVqQJosbp-bN-9dhH3I&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBHV_5qcfr5wphXR09QOt_C8wGiE-8uAJvc6hb_593-OA&oe=6A689863"}, "display_name": "StickbotDUO", "keywords": [], "long_description": "Remote hosted ip server automates the local ip sharing.  StickbotDUO uses UDP to communicate with each other over the local router.\n\nManual ip entry is supported.\nClap hands above head to activate Arcade Mode, and enter each others ip's using the virtual keyboard. That's it, without internet, just a LAN router.\n\nTested with a low-cost portable pocket router.\n\n\nUsing StickbotDUO with a VPN to simulate a LAN WIFI across the internet: NOT TESTED\n\nMulti-player mode works even without internet connection, manual ip entry instead supported instead.", "short_description": "StickbotDUO lets you dance with your mirror bot, or with a friend with another Quest 2 or 3 using your local WIFI. If internet access is not available, StickbotDUO shows local ip addresses to share with each other."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1yoz_u_ZBN883uI4H4c54Da69kIorsDypjN2DXn6bBmM/edit?tab=t.0", "developer_terms_of_service_ur
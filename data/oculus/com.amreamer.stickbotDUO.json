V8q7pnFC_Zht-5BE-GKSwHS2Q&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJsd0kEru5N-PL9iDAJSZokJlWuhLx7jcOvXohUue9Jhw&oe=6AAE7D45"}, {"file_name": "screenshot-2.png", "id": "3129027460593170", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/491820047_3129027463926503_5952380251195163124_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O_aJgfRqsgcQ7kNvwGnWi0G&_nc_oc=AdobkYcRZSynNprX1M8C6-vYfGs76FsD6WOfUt138VdX0cPPv_tik0atg4j520wk2Dc&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKGUYcra8XFHqy7m0fzIe131vEQ17chNEG_QF0WVFOh9g&oe=6AAE91FD"}, {"file_name": "screenshot-3.png", "id": "2206778396509303", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/491819511_2206778399842636_8853489469554596339_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M_cAMcw2ukgQ7kNvwGwCWQR&_nc_oc=AdofmdHrt1-bMzSP5V69d-O9fgy6EREmbZLj8hAnQf5thSqduj88LILFGqbK0Kq0NEQ&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIvrSApnSucrV1PamaJQCwLjnV6U5S8UOQRdbhcvZFbGQ&oe=6AAEAD34"}, {"file_name": "screenshot-4.png", "id": "1333175438474695", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/491820559_1333175441808028_3595707680450206723_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vqwq1HZlS3YQ7kNvwEDrVEm&_nc_oc=Adq53OKX52vK8EXYV7SkCB2eRV56CKpkdjdVtSGcis5FJpLFReS9hUrUmkbK4Qd8tjo&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLB2SRoscHOrL13r41g9a8GRijVJpTY4WoIcxwUbMAWOQ&oe=6AAE8B1D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover-image-video.png", "id": "1233595261905016", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/491821923_1233595265238349_602594154407094045_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-uM8PZxwgf4Q7kNvwGeM6mJ&_nc_oc=AdqI4KCp3tCmUStm1nWu4B0fN8BTUrOVUXS2EsZDeVXYBHTpfJmns9nwGmNUACpI0IQ&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLJKNM61kUuyO81ES4K1DUPKq9xT26NvM3dn9c72PTKdw&oe=6AAEB023"}, "display_name": "StickbotDUO", "keywords": [], "long_description": "Remote hosted ip server automates the local ip sharing.  StickbotDUO uses UDP to communicate with each other over the local router.\n\nManual ip entry is supported.\nClap hands above head to activate Arcade Mode, and enter each others ip's using the virtual keyboard. That's it, without internet, just a LAN router.\n\nTested with a low-cost portable pocket router.\n\n\nUsing StickbotDUO with a VPN to simulate a LAN WIFI across the internet: NOT TESTED\n\nMulti-player mode works even without internet connection, manual ip entry instead supported instead.", "short_description": "StickbotDUO lets you dance with your mirror bot, or with a friend with another Quest 2 or 3 using your local WIFI. If internet access is not available, StickbotDUO shows local ip addresses to share with each other."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1yoz_u_ZBN883uI4H4c54Da69kIorsDypjN2DXn6bBmM/edit?tab=t.0", "developer_terms_of_service_url": null, "publisher_name": "amre-amer.com", "support_website_url": "https://docs.google.com/document/d/1LOFFleOUyG4_YQE0ALAhgEyKZ939ShYJBmesxfhBRfA/edit?usp=sharing", "website_url": "https://sites.google.com/amre-amer.com/resume/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1023770785722696"}, {"id": "459781504968480"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER"], "id": "2488254135
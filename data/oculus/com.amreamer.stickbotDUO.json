3534"}, {"file_name": "screenshot-4.png", "id": "1333175438474695", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491820559_1333175441808028_3595707680450206723_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8ROGwfTA-5wQ7kNvwFu4d2h&_nc_oc=Adpd8GSsFLNxge4lH1gNCtnJs5hX-kjIW6ZG3fsPB_tQDhrFRi5oyCyaow8TdAjX_8k&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-GJ5d2nLLQMfB_rLTGPQ9rlYrS0YexPx5qg7z0WT1D1w&oe=6A45131D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover-image-video.png", "id": "1233595261905016", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/491821923_1233595265238349_602594154407094045_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KiYTpRJtGMMQ7kNvwGic5ip&_nc_oc=AdpSuCzrU390iGbCxauHaZcCBhiFKWaqY4xZdHm-Jv4SFHeqs_ugubo9eBdX5TmArYs&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8Q6uDi0tEftPV7YPx9LCAf8b_jWkaEuwWd8f9YwiKX2Q&oe=6A453823"}, "display_name": "StickbotDUO", "keywords": [], "long_description": "Remote hosted ip server automates the local ip sharing.  StickbotDUO uses UDP to communicate with each other over the local router.\n\nManual ip entry is supported.\nClap hands above head to activate Arcade Mode, and enter each others ip's using the virtual keyboard. That's it, without internet, just a LAN router.\n\nTested with a low-cost portable pocket router.\n\n\nUsing StickbotDUO with a VPN to simulate a LAN WIFI across the internet: NOT TESTED\n\nMulti-player mode works even without internet connection, manual ip entry instead supported instead.", "short_description": "StickbotDUO lets you dance with your mirror bot, or with a friend with another Quest 2 or 3 using your local WIFI. If internet access is not available, StickbotDUO shows local ip addresses to share with each other."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1yoz_u_ZBN883uI4H4c54Da69kIorsDypjN2DXn6bBmM/edit?tab=t.0", "developer_terms_of_service_ur
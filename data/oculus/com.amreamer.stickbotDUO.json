-ams2-1.oculuscdn.com/v/t64.5771-25/491820559_1333175441808028_3595707680450206723_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v2hOr02QkkAQ7kNvwHv5jTO&_nc_oc=AdlCdyqq7Ie3o1YIo186izFE-zaZk8ARYehZsSEbJ8fkj5D5mJzyPQTZ7rjBS0xB0pI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AftkHEVlL2CoveFmoUnNz81clSjpSgHX8z_gZtl94AS4EA&oe=69A8309D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover-image-video.png", "id": "1233595261905016", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491821923_1233595265238349_602594154407094045_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zMvWkRXwBDkQ7kNvwGuiSew&_nc_oc=AdmbahKmFAeNx23Q44DBT-ODLxgNi-3nTqq7-XoCWPkrUe3PSDgP_RXlb5FrTsPNo0Y&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AftoqNISVuf8AudxYc8Jswe-wlgqJyy3Yv7NLc7oF7y7lg&oe=69A81D63"}, "display_name": "StickbotDUO", "keywords": [], "long_description": "Remote hosted ip server automates the local ip sharing.  StickbotDUO uses UDP to communicate with each other over the local router.\n\nManual ip entry is supported.\nClap hands above head to activate Arcade Mode, and enter each others ip's using the virtual keyboard. That's it, without internet, just a LAN router.\n\nTested with a low-cost portable pocket router.\n\n\nUsing StickbotDUO with a VPN to simulate a LAN WIFI across the internet: NOT TESTED\n\nMulti-player mode works even without internet connection, manual ip entry instead supported instead.", "short_description": "StickbotDUO lets you dance with your mirror bot, or with a friend with another Quest 2 or 3 using your local WIFI. If internet access is not available, StickbotDUO shows local ip addresses to share with each other."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1yoz_u_ZBN883uI4H4c54Da69kIorsDypjN2DXn6bBmM/edit?tab=t.0", "developer_terms_of_service_url": null, "publisher_name": "amre-amer.com", "support_website_url": "https://docs.google.com/documen
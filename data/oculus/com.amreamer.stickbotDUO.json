oX9aYVjK_wonrSnm5x-c0&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF9QbZFjcknWRi_Yy4vXZTVlwdcn0Md60ML3KwQ41K0JQ&oe=6A8D87C5"}, {"file_name": "screenshot-2.png", "id": "3129027460593170", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/491820047_3129027463926503_5952380251195163124_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ljLPq2svPscQ7kNvwFjnEA-&_nc_oc=AdqRhCc2o9A_wQxHW3UD_f9B51oYnVtYKGvbqLDRqFmsAacjA7iwsW1O3GijaLEkM9I&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHg1B5AVhyi0DCNlMfwg5UtNmXUzydW8isHOonFZNCGQA&oe=6A8D643D"}, {"file_name": "screenshot-3.png", "id": "2206778396509303", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/491819511_2206778399842636_8853489469554596339_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WttVbZluj6IQ7kNvwHNCKnF&_nc_oc=Adrg1WQ18hZ2V8kvS1z88oxHjHSVa5n-_FRCR6C-seKVUfLj84fEHpp2-96gfZbCXmc&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGgql3cbHBbz4Ru_qBgkxp2K6ihgIaP-ZRX6lJLfvk4Vw&oe=6A8D7F74"}, {"file_name": "screenshot-4.png", "id": "1333175438474695", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/491820559_1333175441808028_3595707680450206723_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XFATUnkZK-sQ7kNvwEcQniX&_nc_oc=Ado7RK3Ys5Xjao3nHvFdc9bqR19bddM5aPsWU91cx_v0InRHJRaG3Aqj-UfkDOFUNj0&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF6aXsHNonU08tpXlMxVUfDQzClw2BVxjMn1wgo1gJ2xQ&oe=6A8D959D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover-image-video.png", "id": "1233595261905016", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/491821923_1233595265238349_602594154407094045_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-DO14_wnU-cQ7kNvwEwKlKs&_nc_oc=AdosRVRiHQwB0LoREDfGmH8CLYzZXm5OkjDmNxJTDyppR0Rvt3BdIUFEmAqz59Amwnc&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGE9G9g4xotQz9_5m-Tc1qbvwwybx9T3uEf5VNdvezB1Q&oe=6A8D8263"}, "display_name": "StickbotDUO", "keywords": [], "long_description": "Remote hosted ip server automates the local ip sharing.  StickbotDUO uses UDP to communicate with each other over the local router.\n\nManual ip entry is supported.\nClap hands above head to activate Arcade Mode, and enter each others ip's using the virtual keyboard. That's it, without internet, just a LAN router.\n\nTested with a low-cost portable pocket router.\n\n\nUsing StickbotDUO with a VPN to simulate a LAN WIFI across the internet: NOT TESTED\n\nMulti-player mode works even without internet connection, manual ip entry instead supported instead.", "short_description": "StickbotDUO lets you dance with your mirror bot, or with a friend with another Quest 2 or 3 using your local WIFI. If internet access is not available, StickbotDUO shows local ip addresses to share with each other."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1yoz_u_ZBN883uI4H4c54Da69kIorsDypjN2DXn6bBmM/edit?tab=t.0", "developer_terms_of_service_url": null, "publisher_name": "amre-amer.com", "support_website_url": "https://docs.google.com/document/d/1LOFFleOUyG4_YQE0ALAhgEyKZ939ShYJBmesxfhBRfA/edit?usp=sharing", "website_url": "https://sites.google.com/amre-amer.com/resume/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1023770785722696"}, {"id": "459781504968480"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER"], "id": "2488254135
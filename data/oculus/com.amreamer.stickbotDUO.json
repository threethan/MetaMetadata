D674"}, {"file_name": "screenshot-4.png", "id": "1333175438474695", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491820559_1333175441808028_3595707680450206723_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d0Y3cst8q-AQ7kNvwHYAWRc&_nc_oc=AdrkoIXdsxuVqbiuIP5_BrfxlQU5D889Yu_VVlSeLV8Enmc3Q-u75ZrJg36KyNSGlwU&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1CaY4EsMusJsphi6Yj884n77ubjRq6gOlBS180WjNt-w&oe=69DCEC9D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover-image-video.png", "id": "1233595261905016", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491821923_1233595265238349_602594154407094045_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gzjV-tusErkQ7kNvwFsL56w&_nc_oc=AdpYsMjtdU6YdeJfY1-xz_wXssVrfbVRJYo-1f6QSSbSIV5W0BWrpgjyvJS75DCt_zo&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0aw3VCiuCrj0-_jDs4_qIO083isgbOZ5ONnras25UFhw&oe=69DCD963"}, "display_name": "StickbotDUO", "keywords": [], "long_description": "Remote hosted ip server automates the local ip sharing.  StickbotDUO uses UDP to communicate with each other over the local router.\n\nManual ip entry is supported.\nClap hands above head to activate Arcade Mode, and enter each others ip's using the virtual keyboard. That's it, without internet, just a LAN router.\n\nTested with a low-cost portable pocket router.\n\n\nUsing StickbotDUO with a VPN to simulate a LAN WIFI across the internet: NOT TESTED\n\nMulti-player mode works even without internet connection, manual ip entry instead supported instead.", "short_description": "StickbotDUO lets you dance with your mirror bot, or with a friend with another Quest 2 or 3 using your local WIFI. If internet access is not available, StickbotDUO shows local ip addresses to share with each other."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1yoz_u_ZBN883uI4H4c54Da69kIorsDypjN2DXn6bBmM/edit?tab=t.0", "developer_terms_of_service_ur
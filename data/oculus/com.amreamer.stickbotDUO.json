E7F4"}, {"file_name": "screenshot-4.png", "id": "1333175438474695", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/491820559_1333175441808028_3595707680450206723_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EOBgj_CZ9lUQ7kNvwGOoI5e&_nc_oc=Ado9eKtfxp2EWCA2Bqg2uShVIQNE4Xx3NeZbvZQANdAoD4lCyZeoeZO0EVzIGua_OZM&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG5UJfd4h92fHR7_Kj9gaO5Yo4N5LubdzpUOfZgu8o2Lg&oe=6A86FE1D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover-image-video.png", "id": "1233595261905016", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/491821923_1233595265238349_602594154407094045_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ANDVkZIRa3oQ7kNvwHe08Kd&_nc_oc=Adqil2Ib7e5IW6fuCqLVMHyR4HgpTUiuYxK7e7yiEdB6Y1ddI97o7YWRTaPGoS0B9pk&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGqjf5Z7CW55Fr1ufL_pbBDCHeAVkFhRPt-bdftY_7AWg&oe=6A86EAE3"}, "display_name": "StickbotDUO", "keywords": [], "long_description": "Remote hosted ip server automates the local ip sharing.  StickbotDUO uses UDP to communicate with each other over the local router.\n\nManual ip entry is supported.\nClap hands above head to activate Arcade Mode, and enter each others ip's using the virtual keyboard. That's it, without internet, just a LAN router.\n\nTested with a low-cost portable pocket router.\n\n\nUsing StickbotDUO with a VPN to simulate a LAN WIFI across the internet: NOT TESTED\n\nMulti-player mode works even without internet connection, manual ip entry instead supported instead.", "short_description": "StickbotDUO lets you dance with your mirror bot, or with a friend with another Quest 2 or 3 using your local WIFI. If internet access is not available, StickbotDUO shows local ip addresses to share with each other."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1yoz_u_ZBN883uI4H4c54Da69kIorsDypjN2DXn6bBmM/edit?tab=t.0", "developer_terms_of_service_ur
yyp4jnhXbTaIOuRGPilAq8TX4&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6lIcxi0P2K0_uyxN-F3PiEhL20EVbWnRT4Z-oi5-uGPQ&oe=6A119AC5"}, {"file_name": "screenshot-2.png", "id": "3129027460593170", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/491820047_3129027463926503_5952380251195163124_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Bb1wkaGoWeMQ7kNvwHT_-5H&_nc_oc=AdoRyGK8xXrnqdmFN1nft3o_M_f-Q9DBpXjdLhg_knKmW9_OFxPbLfB9CpdRZblkeWg&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5RkY47ega4bDreGgLK7MsMQazV0OUePZ-s3S_mL65CKg&oe=6A11AF7D"}, {"file_name": "screenshot-3.png", "id": "2206778396509303", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/491819511_2206778399842636_8853489469554596339_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZCK_rkFdewcQ7kNvwHglfsg&_nc_oc=AdryhiyL5vCfFd23HBb5oIOPU0m86oXGbD21BAP8tQeAIMjm_DhZiz0rg9LjpF3C2_o&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7jgABrwBjuoB5RagSbm5Tl2qOpxaBANQnK_IqnQrYlOw&oe=6A11CAB4"}, {"file_name": "screenshot-4.png", "id": "1333175438474695", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/491820559_1333175441808028_3595707680450206723_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8Is4qeHzR08Q7kNvwEOWgyd&_nc_oc=AdoJMDxHv5w_Wn9_1GSmDIK57cGocjQZ8zXO16K3To-naFjtbRDA9WJTojCCOfoNSoQ&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7SQ9crq5U5qDSk0BgfQJNcqs0qci0OS3cvWHWffW8h4g&oe=6A11A89D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover-image-video.png", "id": "1233595261905016", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/491821923_1233595265238349_602594154407094045_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=38WBEmjVnz0Q7kNvwGio4Sy&_nc_oc=AdqEskoeKgDWT1sWDh8AaQ-RO04GG72c5N4skaKJh23AEIVW1-N2z8iuzQvc_Ns-QWQ&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4J53v3dWWa1HhfPEq3HhVXdoDSy3uKdQEy7oViBts2Sg&oe=6A11CDA3"}, "display_name": "StickbotDUO", "keywords": [], "long_description": "Remote hosted ip server automates the local ip sharing.  StickbotDUO uses UDP to communicate with each other over the local router.\n\nManual ip entry is supported.\nClap hands above head to activate Arcade Mode, and enter each others ip's using the virtual keyboard. That's it, without internet, just a LAN router.\n\nTested with a low-cost portable pocket router.\n\n\nUsing StickbotDUO with a VPN to simulate a LAN WIFI across the internet: NOT TESTED\n\nMulti-player mode works even without internet connection, manual ip entry instead supported instead.", "short_description": "StickbotDUO lets you dance with your mirror bot, or with a friend with another Quest 2 or 3 using your local WIFI. If internet access is not available, StickbotDUO shows local ip addresses to share with each other."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1yoz_u_ZBN883uI4H4c54Da69kIorsDypjN2DXn6bBmM/edit?tab=t.0", "developer_terms_of_service_url": null, "publisher_name": "amre-amer.com", "support_website_url": "https://docs.google.com/document/d/1LOFFleOUyG4_YQE0ALAhgEyKZ939ShYJBmesxfhBRfA/edit?usp=sharing", "website_url": "https://sites.google.com/amre-amer.com/resume/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1023770785722696"}, {"id": "459781504968480"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER"], "id": "2488254135
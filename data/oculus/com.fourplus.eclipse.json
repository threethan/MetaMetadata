v/t64.5771-25/473391959_1137979731031328_3156194736345169927_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pV8063sBr1EQ7kNvwEtXhDy&_nc_oc=AdmDO_Zg-kcvaw50A28qQgZd2sD2tnKuHYD2eYK_WBE5otOyQ35V8MIUC6EDc_6DDDg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afv7pl6RFBwzY5fmwpF4MHleu2soSfP8_gRh_i7iYZb_6Q&oe=69A2E4E9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Eclipse Creator Cover Art Landscape.png", "id": "957846473187195", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473397253_957846476520528_5428661636472088689_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tRXmzI6IyeQQ7kNvwEjCO3S&_nc_oc=AdnqJ7klODOVzWCRp1pDUl_nwLIN3ewSLTRRaHR4HLbJNG430sTRx1iyblCneZ5MgcM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfuwAfPvWO7J8BfX6q6wUTknGuYAudrFkEETyvhzCrjc4w&oe=69A2CEE6"}, "display_name": "Eclipse Creator", "keywords": ["Eclipse", "Laboratory", "FourPlus", "Biology", "Science"], "long_description": "Eclipse Creator is a hands-on, VR/AR laboratory training platform for life sciences that bridges the gap between theory and practice.  \n\n\ud83c\udf93Please note, the app is designed primarily for use in educational institutions, industry and healthcare settings. Those wishing to experience Eclipse Creator can trial a FREE DEMO included and then sign up for the unrestricted version on our website. \n\nInstructors from industry and education can easily store and scale training courses in order to perform industry-relevant training, on-demand, anywhere, without the safety risks or waste produced in physical workplaces. Educators can transform classroom concepts into professional experience, enabling students to explore facilities and train on equipment they do not usually have access to.  ", "short_description": "Eclipse Creator is a hands-on, VR/AR laboratory training platform for life sciences that bridges the gap between theory and practice.  \n\n\ud83c\udf93Please note, the app is designed primarily for use in educational institutions, industry and healthcare settings. Those wishing to experience Eclipse Creator can trial a FREE DEMO included and then sign up for the unrestricted version on our website. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://eclipsecreator.com/?page_id=2456", "developer_terms_of_service_url": null, "publisher_name": "FourPlus Immersive", "support_website_url": null, "website_url": "https://eclipsecreator.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "23965768026345506"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "603345065862937"}]}, "baseline_offer": {"id": "603345065862937"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1743580680, "status": "PUBLISHED", "id": "603345065862937"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "26479003155021968", "version": "0.1.50"}, "id": "1635122580569586", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "8182073581808204", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "26479003155021968"}, "release_status": "RELEASED"}, "binary_release_channels"
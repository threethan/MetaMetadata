t64.5771-25/499617831_1488779646220938_6916002986647243245_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a5MLrnSndZAQ7kNvwH4Y0vN&_nc_oc=AdpYsKY58jKTYoqLfp7EjFWq9-2V3HCAF9TKGisbRTnZH3Fxy9Ons5gw-lo7oQMLN48&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-VJf06gVL8BprH99byA_bD2nGa_4KAkntPRBFOdXzrCw&oe=6A2EBEF8"}, "display_name": "Skillveri Kelvin Lite: HVAC VR Training", "keywords": [], "long_description": "Step into the future of training with Skillveri Kelvin Lite, the ultimate VR simulation for aspiring HVAC technicians. This \"Lite\" version offers a powerful, hands-on preview of the essential skills required to service modern heating and cooling systems.\n\nForget watching videos - start doing. Using Skillveri\u2019s advanced hand-tracking technology, you can interact with tools and turn the valves naturally with your hands, just as you would in the field - no controllers needed! \nImmerse yourself in a realistic workshop, and navigate complex tasks with ease using visual cues and instructions. \n\nIdentify system issues, repeat and refine - practice until you can\u2019t go wrong!\n\nReady to scale your training? For our fully-loaded Standard and Pro versions, perfect for schools and enterprises, contact us at usa@skillveri.com.", "short_description": "Master HVAC servicing in VR! Practice brazing, leak testing, and refrigerant charging in a high-fidelity, hands-on simulation."}]}, "developer_name": "Skillveri Inc", "developer_privacy_policy_url": "https://skillveri.com/kelvin-lite-privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Skillveri Inc", "support_website_url": null, "website_url": "https://www.skillveri.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "1043107547362485"}], "external_subscription_type": "REQUIRED", "genres": [], "has_in_app_ads"
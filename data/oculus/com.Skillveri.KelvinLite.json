.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QuV7HBlOxAgQ7kNvwHWmCEI&_nc_oc=AdoFmA7dosmWyNSLZNEExdFgmbHrftjrySmAcv9iXB91SYbAaUs_W4aO9J3zkqVr9HU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6TfsgINnKTNn_MzgG5iS6cowAijv6lyRaIWJN-Eyky5g&oe=69FB3584"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "4_KelvinLite.png", "id": "1488779642887605", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499617831_1488779646220938_6916002986647243245_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uWk04idbWHkQ7kNvwEf58v0&_nc_oc=Adqqbw4mOQ3DCN7YkEPecjbRE7c1hRKNDj_NGBB96DCqk-wWMxUrko5GXDclGRfmWSc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5HhFJTc_O3a_i7coBCyddR8mar-FLb96dV4lB945TAkw&oe=69FB5478"}, "display_name": "Skillveri Kelvin Lite: HVAC VR Training", "keywords": [], "long_description": "Step into the future of training with Skillveri Kelvin Lite, the ultimate VR simulation for aspiring HVAC technicians. This \"Lite\" version offers a powerful, hands-on preview of the essential skills required to service modern heating and cooling systems.\n\nForget watching videos - start doing. Using Skillveri\u2019s advanced hand-tracking technology, you can interact with tools and turn the valves naturally with your hands, just as you would in the field - no controllers needed! \nImmerse yourself in a realistic workshop, and navigate complex tasks with ease using visual cues and instructions. \n\nIdentify system issues, repeat and refine - practice until you can\u2019t go wrong!\n\nReady to scale your training? For our fully-loaded Standard and Pro versions, perfect for schools and enterprises, contact us at usa@skillveri.com.", "short_description": "Master HVAC servicing in VR! Practice brazing, leak testing, and refrigerant charging in a high-fidelity, hands-on simulation."}]}, "developer_name": "Skillveri Inc", "developer_privacy_policy_url": "https://skillveri.com/kelvin-lite-privacy-policy/", "developer_terms_o
41", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499618264_1504505791137474_6564963585481288256_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ciRFkaMa4zoQ7kNvwGDrd3f&_nc_oc=AdoULs-ZtQqwWvLuAhlNAzPCVnrtF_6GbigmykQ4Kq7wCijG5V6lx05CiskNcu6129A&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6ri0EiQn0UG6bJcYU1PtyAa9QHzWZ-CIOS3EQi6798bw&oe=6A0341AA"}, {"file_name": "38974535_1258784945034883_909213723295103334_n.png", "id": "1280776713522304", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499619805_1280776716855637_7112871519063258032_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NB_BQGh-l10Q7kNvwEgQ7ps&_nc_oc=AdpDn0IP6waHxevo2vbMtZXGUzwli6Cv6aj3x6aHcfxadTQctXNTWYx99mJWdkeunZo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7a16LQ6pFVgZXSzr6bepxQ3KCzuGyMTVDMKYFBejV8kQ&oe=6A031E84"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "4_KelvinLite.png", "id": "1488779642887605", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499617831_1488779646220938_6916002986647243245_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bIf7aIK6swEQ7kNvwF5pWNy&_nc_oc=AdoGAU3M1vFsCi5CWKGFIjvmrx4p3M1pVDRGBOm1OUcRCnow9QiPwisLFfpvdU5GLcU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5jigW8zyNG5iIy2sPf07r_201p3o3saU6tJrwwR93JxA&oe=6A033D78"}, "display_name": "Skillveri Kelvin Lite: HVAC VR Training", "keywords": [], "long_description": "Step into the future of training with Skillveri Kelvin Lite, the ultimate VR simulation for aspiring HVAC technicians. This \"Lite\" version offers a powerful, hands-on preview of the essential skills required to service modern heating and cooling systems.\n\nForget watching videos - start doing. Using Skillveri\u2019s advanced hand-tracking technology, you can interact with tools and turn the valves naturally with your hands, just as you would in the field - no controllers needed! \nImmerse yourself in a realistic workshop, and navigate complex tasks with ease using visual cues and instructions. \n\nIdentify system issues, repeat and refine - practice until you can\u2019t go wrong!\n\nReady to scale your training? For our fully-loaded Standard and Pro versions, perfect for schools and enterprises, contact us at usa@skillveri.com.", "short_description": "Master HVAC servicing in VR! Practice brazing, leak testing, and refrigerant charging in a high-fidelity, hands-on simulation."}]}, "developer_name": "Skillveri Inc", "developer_privacy_policy_url": "https://skillveri.com/kelvin-lite-privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Skillveri Inc", "support_website_url": null, "website_url": "https://www.skillveri.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}, {"id": "514087707868786"}], "external_subscription_type": "REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "nl", "fr", "de", "es", "hu"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26679399678350607"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1698037978048407"}]}, "baseline_offer": {"id": "1698037978048407"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1777438920, "status": "PUBLISHED", "id": "1698037978048407"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "27013394051617833", "version": "3.26043021"}, "id": "2681915092168537", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": fals
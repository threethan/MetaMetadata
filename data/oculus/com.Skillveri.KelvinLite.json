.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QuV7HBlOxAgQ7kNvwENkrbE&_nc_oc=Adof8MebKAHkOCnIr6Wgv4d4I7XfBh93W4pnQ4L5iBbw9tGnuGBKEQQ0wHUukimTtOc&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af71RagThZcpDYpGR8mjdjH-REq1jXE-m1EfSxGzj7gCnA&oe=69FDD884"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "4_KelvinLite.png", "id": "1488779642887605", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/499617831_1488779646220938_6916002986647243245_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BFbswfUrymIQ7kNvwE_D5Kw&_nc_oc=Ado_GcJloYAELrAth-JlRsLDLSuS_sMCx4QX60Zx1O70yEorWWm2vZoRLCeLBUqkxw4&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7knEeYnRrivPMzZAzfWcikzDmLZDx267wDlJN7vbAiSA&oe=69FDF778"}, "display_name": "Skillveri Kelvin Lite: HVAC VR Training", "keywords": [], "long_description": "Step into the future of training with Skillveri Kelvin Lite, the ultimate VR simulation for aspiring HVAC technicians. This \"Lite\" version offers a powerful, hands-on preview of the essential skills required to service modern heating and cooling systems.\n\nForget watching videos - start doing. Using Skillveri\u2019s advanced hand-tracking technology, you can interact with tools and turn the valves naturally with your hands, just as you would in the field - no controllers needed! \nImmerse yourself in a realistic workshop, and navigate complex tasks with ease using visual cues and instructions. \n\nIdentify system issues, repeat and refine - practice until you can\u2019t go wrong!\n\nReady to scale your training? For our fully-loaded Standard and Pro versions, perfect for schools and enterprises, contact us at usa@skillveri.com.", "short_description": "Master HVAC servicing in VR! Practice brazing, leak testing, and refrigerant charging in a high-fidelity, hands-on simulation."}]}, "developer_name": "Skillveri Inc", "developer_privacy_policy_url": "https://skillveri.com/kelvin-lite-privacy-policy/", "developer_terms_o
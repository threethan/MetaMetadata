.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8NIaghgED1QQ7kNvwG8zwoW&_nc_oc=AdpMA8XzCXOjC9C6gFEJT9eJ3G60a7mzZ07SCDyp0Gnj94X9yC_RnUxytpnXWx_eHFo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2pbX1sMocC0tThYx9KVj9-Dz-_cth8ywoasMj3jA8u_Q&oe=69F89284"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "4_KelvinLite.png", "id": "1488779642887605", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499617831_1488779646220938_6916002986647243245_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cx-n7Jp1SRkQ7kNvwF42UQd&_nc_oc=Adq9FHnk_bpsDEnw-8G3zjB2h9fMqtboyK3IJfOiX03EyOVbTAbVhc6EK7ZAoJFAzCU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0ULp4OnaY7eW8nWfMUMZxBx8k1BffX62iH8sYNBYLPRA&oe=69F8B178"}, "display_name": "Skillveri Kelvin Lite: HVAC VR Training", "keywords": [], "long_description": "Step into the future of training with Skillveri Kelvin Lite, the ultimate VR simulation for aspiring HVAC technicians. This \"Lite\" version offers a powerful, hands-on preview of the essential skills required to service modern heating and cooling systems.\n\nForget watching videos - start doing. Using Skillveri\u2019s advanced hand-tracking technology, you can interact with tools and turn the valves naturally with your hands, just as you would in the field - no controllers needed! \nImmerse yourself in a realistic workshop, and navigate complex tasks with ease using visual cues and instructions. \n\nIdentify system issues, repeat and refine - practice until you can\u2019t go wrong!\n\nReady to scale your training? For our fully-loaded Standard and Pro versions, perfect for schools and enterprises, contact us at usa@skillveri.com.", "short_description": "Master HVAC servicing in VR! Practice brazing, leak testing, and refrigerant charging in a high-fidelity, hands-on simulation."}]}, "developer_name": "Skillveri Inc", "developer_privacy_policy_url": "https://skillveri.com/kelvin-lite-privacy-policy/", "developer_terms_o
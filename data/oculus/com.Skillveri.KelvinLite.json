s2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-PHW-X2vZKRi3y1Maet7VxGtk32flT6HF0WQ5ybmImpQ&oe=6A3E7C07"}, {"file_name": "38974813_5928683240550600_263121794450703303_n.png", "id": "1504505787804141", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499618264_1504505791137474_6564963585481288256_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oXzbKiwCP0YQ7kNvwENzv8F&_nc_oc=AdpRICCqRI4QFXAsPpRT35ii7_YbBW81H57_z_SNhG9uZPYxNHwFb4QNiqg9FCo-E70&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-xnV1rlIQsQefibIqo9qoGmg_3xwfJLjDe8jyJ6K-11w&oe=6A3E952A"}, {"file_name": "38974535_1258784945034883_909213723295103334_n.png", "id": "1280776713522304", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499619805_1280776716855637_7112871519063258032_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R63rPyjMVXcQ7kNvwGu2w47&_nc_oc=AdqKd4sqJAmvpqn3VzVf5HdE7tTswB84_liJk7swBeEAM8aiCYtABjmAdpV4BtjHLNU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8S3u9hEjKUAZnK2UECMxtkNs6ytDWvDhJJYg41AVVQsw&oe=6A3EAA44"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "4_KelvinLite.png", "id": "1488779642887605", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499617831_1488779646220938_6916002986647243245_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bXl-j_E9fDIQ7kNvwHms6fZ&_nc_oc=AdrK-P9Sf3VXbbkvLWmb0woIUcDDpWhSYkCaNXeLqri3QXMohX_BzXJOWDT6UCKKwzo&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_JMqPBGcl8k1gBe1peWoPQKTZ6hHdTfHvc-JFTlc124g&oe=6A3E90F8"}, "display_name": "Skillveri Kelvin Lite: HVAC VR Training", "keywords": [], "long_description": "Step into the future of training with Skillveri Kelvin Lite, the ultimate VR simulation for aspiring HVAC technicians. This \"Lite\" version offers a powerful, hands-on preview of the essential skills required to service modern heating and cooling systems.\n\nForget watching videos - start doing. Using Skillveri\u2019s advanced hand-tracking technology, you can interact with tools and turn the valves naturally with your hands, just as you would in the field - no controllers needed! \nImmerse yourself in a realistic workshop, and navigate complex tasks with ease using visual cues and instructions. \n\nIdentify system issues, repeat and refine - practice until you can\u2019t go wrong!\n\nReady to scale your training? For our fully-loaded Standard and Pro versions, perfect for schools and enterprises, contact us at usa@skillveri.com.", "short_description": "Master HVAC servicing in VR! Practice brazing, leak testing, and refrigerant charging in a high-fidelity, hands-on simulation."}]}, "developer_name": "Skillveri Inc", "developer_privacy_policy_url": "https://skillveri.com/kelvin-lite-privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Skillveri Inc", "support_website_url": null, "website_url": "https://www.skillveri.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}, {"id": "514087707868786"}], "external_subscription_type": "REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "nl", "fr", "de", "es", "hu"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26679399678350607"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1698037978048407"}]}, "baseline_offer": {"id": "1698037978048407"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1777438920, "status": "PUBLISHED", "id": "1698037978048407"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "An
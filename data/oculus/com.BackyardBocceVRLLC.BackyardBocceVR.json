_nc_ss=7f20f&oh=00_Af0rizbso-Y9DGOQOx-X1pZWzJwm1UIH-2O3TOQVtNeSIQ&oe=69F2066F"}, {"file_name": "Roof2.png", "id": "602861132068870", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974835_602861135402203_7988358339945255283_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=08MrjltGwNcQ7kNvwERnLEp&_nc_oc=AdrndOrGlewYCPsAUN3E4nu-iqJAYd6qBdhMQ4K2MEsjfXZ74W48C0m2tnwNUr1XGK0&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_Af1qeePpJnsQeODmGr5l1t9SLC_0hqVvPOkZe3ctgIAZpg&oe=69F205D0"}, {"file_name": "Sunset Garden.png", "id": "992910482545583", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39031529_992910485878916_7558536400619069083_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gv9aTZTC0nwQ7kNvwGocU-7&_nc_oc=AdoDVIIi7SL0-9NGvC2eI993pcypAbHPlxIGLVmwm9SrUTwWzeMYTjKdGFT3clqc6cI&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af14ubwgQEA7_NbIddOft3NJOaAbdzs6-zQphJ2SiUZ-Bw&oe=69F21877"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Backyard Bocce VR Thumbnail-01.png", "id": "516114197977459", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974666_516114201310792_687206025314467996_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3IGnIgTrjwwQ7kNvwFfOKYC&_nc_oc=Adq0L1v7aRHCD09_qJAHKNfjQ6ZUEXABY2PLTJIHwrZwHsIfAralOVUJ5EW6vTkxuvE&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&oh=00_Af09D0oH5PkQxpaTj_ZMk6-cga4a3shmykN2qUNKMAssyA&oe=69F1F134"}, "display_name": "Backyard Bocce VR", "keywords": [], "long_description": "Bocce is an ancient game of skill dating back over 7,000 years. The rules are simple, throw your ball as close as you can to the pauline. Whoever is closer scores points, then you move to that location and repeat. These simple rules create endless possibilities for variation in game play over different terrain and with different obstacles. \n\n*4 unique levels offering different challenges\n*48 hidden balls to customize your player\n*Play with up to 8 players at once in online multiplaye
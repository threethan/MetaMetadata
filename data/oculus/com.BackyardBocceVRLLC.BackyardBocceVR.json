Q7kNvwEC4Xmx&_nc_oc=AdkDB62aiVjh_tkXl3EikqyxGSic_gsWIJvXk8b9ahqNOIU0DzKtakEvw43M1_N6aZU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AfvxUyxbyrc7PFwtd1VRCZYuYUhB0w2482vp5Mlos9i6DQ&oe=699EF7EF"}, {"file_name": "Roof2.png", "id": "602861132068870", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974835_602861135402203_7988358339945255283_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tbfR45W5XZUQ7kNvwG1xEKg&_nc_oc=AdmrI2UXJ95Sx7r89ZfpWh7l0Du8lQ5I_SeOkbHLv1vZk-TNjcJOgbExKvCkTrTHTbk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_Afu-gO70TPEuTA7nZmvZcfmvbz8QbE9rGp_P9cO1Q6wLng&oe=699EF750"}, {"file_name": "Sunset Garden.png", "id": "992910482545583", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031529_992910485878916_7558536400619069083_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rBqyyiQaIhgQ7kNvwGWqe2C&_nc_oc=AdmM-KLI5ODwKBrDiHdShNwsgqrQXb95cLeOutbHbW9t6Qosg_-UyFDcXptFh238wvo&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AfuPASM2859NDtuYhGGYMv0qxSDLFFL_5DrK9WYWs8o4RA&oe=699ED1B7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Backyard Bocce VR Thumbnail-01.png", "id": "516114197977459", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974666_516114201310792_687206025314467996_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c5zkIH4pjQsQ7kNvwHQQJno&_nc_oc=AdlDGzJYlcYYYASne_NKBiN4KdRys9M1N92teXAYyVCHI1KnjT-xsm0BwdWQRrzjjJE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AftuV5DAgAtbQLi572wsXfjG9EOBfENc7JnRNI2pWIkliA&oe=699EE2B4"}, "display_name": "Backyard Bocce VR", "keywords": [], "long_description": "Bocce / Boules Petanque / Boccia is an ancient game of skill dating back over 7,000 years. The rules are simple, throw your ball as close as you can to the pauline. Whoever is closer scores points, then you move to that location and repeat. These simple rules create endless possibilities for variation in game play over different terrain and with different obstacles. \n\n*4 unique levels offering different challenges\n*48 hidden balls to customize your player\n*Play with up to 8 players at once in online multiplayer\n\nThis isn't tournament bocce, constrained to small square! Explore wherever you want, throw the pauline wherever you want, play wherever you want!", "short_description": "Backyard Bocce VR - Play bocce with your friends across diverse landscapes. Explore wherever you want, throw the pauline wherever you want, play wherever you want!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://backyardboccevr.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Backyard Bocce VR LLC", "support_website_url": null, "website_url": "http://www.backyardboccevr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER", "CO_OP"], "id": "32076572318625232"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974877_1541853343357930_8495391464306444867_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PblrN3aKt4AQ7kNvwETNnbY&_nc_oc=Adnvy3Uk-4nE78hBHyDxzhuIiheHNEccTjExtgUm_-KXwqK3KzAhOp1ej-wuKKsDRLw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AfvNH6d6sPk5KGtums7nK-oN_lk4KxXNf0KIXT0dwQHChA&oe=699EDDA1"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, 
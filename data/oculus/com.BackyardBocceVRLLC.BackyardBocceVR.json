65145_1847871226734800309_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fKJWftHuiIQQ7kNvwH_mRzR&_nc_oc=AdlDJ_jpdCVcovGWqYhS1GXy8Rt86FPp9aS6Aw7bH3VBTa1WKjlKhRNwx3ej6586eLk&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=8&oh=00_Afx-hfWzPvqDVVmycyHsheHZ1D8UFNQUNCHVkTpXfGvo-w&oe=69AAD56F"}, {"file_name": "Roof2.png", "id": "602861132068870", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/38974835_602861135402203_7988358339945255283_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y9T714WzX9IQ7kNvwFNAw7m&_nc_oc=AdnHA8KUNZ5o-9GgBBZCAy--ftg0_lHelzmiA6rIiUrTAYiEgpLiz9yp4v8lbueu3_4&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=8&oh=00_Afxuyxd2ec2naBjnDfdOaiDy0f8WgtnZRC83p30MPGKeMw&oe=69AAD4D0"}, {"file_name": "Sunset Garden.png", "id": "992910482545583", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/39031529_992910485878916_7558536400619069083_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xuOCVo3Jec4Q7kNvwG4eny_&_nc_oc=AdkNArJoruZlNw5vS5uImobrItWPPuqzAE_UlUYH3oTVLrZGLUjBltYNtVZhJBGjwbU&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=8&oh=00_AfxetpmYfCHs3mcFCHSbaQpd4XPSCdPtrdWH2fDtUjX4xQ&oe=69AAE777"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Backyard Bocce VR Thumbnail-01.png", "id": "516114197977459", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/38974666_516114201310792_687206025314467996_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=t05XeDOpWxEQ7kNvwF4cJ78&_nc_oc=AdnlcpHUkaP7k1Xobij4rdgXB6-YpM6V5D0-RGWMfmtOOi8AsLZKfX0fkm658bWk3H8&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=8&oh=00_AfxZGfIkv6uk483kotOLcfi8ABOMGD_oQ2pfowXgG_fdEw&oe=69AAC034"}, "display_name": "Backyard Bocce VR", "keywords": [], "long_description": "Bocce / Boules Petanque / Boccia is an ancient game of skill dating back over 7,000 years. The rules are simple, throw your ball as close as you can to the pauline. Whoever is closer scores points, then you move to that location and repeat. These simple rules create endless possibilities for variation in game play over different terrain and with different obstacles. \n\n*4 unique levels offering different challenges\n*48 hidden balls to customize your player\n*Play with up to 8 players at once in online multiplayer\n\nThis isn't tournament bocce, constrained to small square! Explore wherever you want, throw the pauline wherever you want, play wherever you want!", "short_description": "Backyard Bocce VR - Play bocce with your friends across diverse landscapes. Explore wherever you want, throw the pauline wherever you want, play wherever you want!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://backyardboccevr.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Backyard Bocce VR LLC", "support_website_url": null, "website_url": "http://www.backyardboccevr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER", "CO_OP"], "id": "32076572318625232"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/38974877_1541853343357930_8495391464306444867_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xZVE0bqIGScQ7kNvwF9tpdI&_nc_oc=Admrw_CJMbmXQBoYnHNBqrq3EDS2gqL7H4YeYaca1dQrcb0snWDqZ315ZcOqEc_poNo&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=8&oh=0
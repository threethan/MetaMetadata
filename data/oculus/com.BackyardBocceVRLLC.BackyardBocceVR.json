Q7kNvwE0rEBM&_nc_oc=AdkZKSSjJJQXLkBdljq7DtPfbVieD4WE9gUsFZkjt35H11-l4sWev--sj7L_Ppm00H8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_Afs9R2hQ0BioUF1N4VZxkQgtBuLcKYz-QMgSwm_ee42V7A&oe=69A43DEF"}, {"file_name": "Roof2.png", "id": "602861132068870", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974835_602861135402203_7988358339945255283_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XoxxEMVarKoQ7kNvwGDhHWp&_nc_oc=AdlB0Ico6vM6YloheTNmXK90gqKg5knKomzT_VrS6MocYRaf-J6x8lq2ob7HcV4aDPc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AfsFqvDhKrAFjU0z4V1mhGdMGZ7M4dVAmxhR62blayCPIQ&oe=69A43D50"}, {"file_name": "Sunset Garden.png", "id": "992910482545583", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031529_992910485878916_7558536400619069083_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OTxL80w0ifcQ7kNvwFExXO-&_nc_oc=AdkDYk1ReIWNNmD_pbVMDpVQhYpDBEi2BOWSz6jljUZGsw6vvLVl3mBFn43OAWhPnKY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_AfvInmL76T4hLTqTIsxzsuCPozpo5Hz7u9FEsU7ApBu0AA&oe=69A44FF7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Backyard Bocce VR Thumbnail-01.png", "id": "516114197977459", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974666_516114201310792_687206025314467996_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tGDUnTdpcOYQ7kNvwEqR44A&_nc_oc=Adn1IBzPXID34idU52pTewzpV2LXMLMvgrkWXIAKQH_J0CvxYzL7TlAUvo6nNS0myT0&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfszPMH8Zt0QN6F_jguH3NWHeENEc-vnMaPSupLPSkx_LA&oe=69A428B4"}, "display_name": "Backyard Bocce VR", "keywords": [], "long_description": "Bocce / Boules Petanque / Boccia is an ancient game of skill dating back over 7,000 years. The rules are simple, throw your ball as close as you can to the pauline. Whoever is closer scores points, then you move to that location and repeat. These simple rules create endless possibilities for variation in game play over different terrain and with different obstacles. \n\n*4 unique levels offering different challenges\n*48 hidden balls to customize your player\n*Play with up to 8 players at once in online multiplayer\n\nThis isn't tournament bocce, constrained to small square! Explore wherever you want, throw the pauline wherever you want, play wherever you want!", "short_description": "Backyard Bocce VR - Play bocce with your friends across diverse landscapes. Explore wherever you want, throw the pauline wherever you want, play wherever you want!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://backyardboccevr.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Backyard Bocce VR LLC", "support_website_url": null, "website_url": "http://www.backyardboccevr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER", "CO_OP"], "id": "32076572318625232"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974877_1541853343357930_8495391464306444867_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YdziUr6dPNQQ7kNvwHllWle&_nc_oc=AdnJROdvMlLDhgyRz2lg4mCMXpME6gSeE_meluc6XWRWsiU43fBnvtJ3r1gC0cgYfPM&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_Aft_O553KLOkHih4b0r4U1ochJRjjuSPWjJYO6OXGUbFoA&oe=69A423A1"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, 
Q7kNvwFnJvdR&_nc_oc=AdkTfnuk2Tfmhvds_XJ1z_M51EpRG8gGtGnDcJ71Xgiis_aw9o6wjv9xXacYaUxn1NA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfsHPj0uRzKJzbO320w5aWjQYxAig9PPuGhOHZNa7Bjnkw&oe=69A6E0EF"}, {"file_name": "Roof2.png", "id": "602861132068870", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974835_602861135402203_7988358339945255283_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XoxxEMVarKoQ7kNvwGEtnP8&_nc_oc=AdmyuYysR7WgGbo0EYu8rWNCe8QmNmpbK11Cwxbw2OxYdb13vJJ9E6I7yZS-xjmPSfU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfsoRzppc0TNMWC3NMb9v67haScEcl-TEEbUJiJbJKu3TA&oe=69A6E050"}, {"file_name": "Sunset Garden.png", "id": "992910482545583", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031529_992910485878916_7558536400619069083_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OTxL80w0ifcQ7kNvwGMWEGB&_nc_oc=AdmtXQxNRQ6Ftw0rMKnao_eQwV7eRmrExk9AtwtSxikd1AWnm7mJMJ36CoiXBtJZBpg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Aft5s9XYjGfHpMjvGryO6sW_MkhomIVTjOFedWCXMRUm-A&oe=69A6F2F7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Backyard Bocce VR Thumbnail-01.png", "id": "516114197977459", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974666_516114201310792_687206025314467996_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ECKtExoLbZEQ7kNvwG9x41C&_nc_oc=Adlmflfygfs0pb5QtmbjqZtWjlIDPrga55tSrY2-mkomhSV0ZM22_zq2ZoeaunBwNvE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Afs06RzDdffNi2Kw_0KsfK34_z-y_m7o43_pvHD6ENKT7A&oe=69A6CBB4"}, "display_name": "Backyard Bocce VR", "keywords": [], "long_description": "Bocce / Boules Petanque / Boccia is an ancient game of skill dating back over 7,000 years. The rules are simple, throw your ball as close as you can to the pauline. Whoever is closer scores points, then you move to that location and repeat. These simple rules create endless possibilities for variation in game play over different terrain and with different obstacles. \n\n*4 unique levels offering different challenges\n*48 hidden balls to customize your player\n*Play with up to 8 players at once in online multiplayer\n\nThis isn't tournament bocce, constrained to small square! Explore wherever you want, throw the pauline wherever you want, play wherever you want!", "short_description": "Backyard Bocce VR - Play bocce with your friends across diverse landscapes. Explore wherever you want, throw the pauline wherever you want, play wherever you want!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://backyardboccevr.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Backyard Bocce VR LLC", "support_website_url": null, "website_url": "http://www.backyardboccevr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER", "CO_OP"], "id": "32076572318625232"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974877_1541853343357930_8495391464306444867_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I5OvPOpRicQQ7kNvwEkuxHU&_nc_oc=Admxp0bXxixNRXf2DJVMCZOGn7MfK_tMtZMmWHDVG8Wq2vkEzNpE4jbVkFq9K_7MY44&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfsAXMxlMKmvUK58qJvCGe0fT_MoMNm0WHoP2GqU1neIrA&oe=69A6C6A1"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, 
9gMIvwenIDmnI50NvmFI0SPKtMxs6Z1iw&oe=6AFB26F4"}, "display_name": "Backyard Bocce VR", "keywords": [], "long_description": "Bocce / Boules Petanque / Boccia is an ancient game of skill dating back over 7,000 years. The rules are simple, throw your ball as close as you can to the pauline. Whoever is closer scores points, then you move to that location and repeat. These simple rules create endless possibilities for variation in game play over different terrain and with different obstacles. \n\n*4 unique levels offering different challenges\n*48 hidden balls to customize your player\n*Play with up to 8 players at once in online multiplayer\n\nThis isn't tournament bocce, constrained to small square! Explore wherever you want, throw the pauline wherever you want, play wherever you want!", "short_description": "Backyard Bocce VR - Play bocce with your friends across diverse landscapes. Explore wherever you want, throw the pauline wherever you want, play wherever you want!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://backyardboccevr.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Backyard Bocce VR LLC", "support_website_url": null, "website_url": "http://www.backyardboccevr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER", "CO_OP"], "id": "32076572318625232"}, "
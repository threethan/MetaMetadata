135402203_7988358339945255283_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9kXaSBjC98UQ7kNvwEKB1qY&_nc_oc=AdnGkCDj_rFxFWBp1ZwH-KOKPBQnRllnE3Q5ddid5QbsEA_T0e2iskSbyX69Qteyock&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&oh=00_AfuBOcEk_BHZECQl9BS18HD1pjtHW3YW7eVtDVqLtylmww&oe=69985FD0"}, {"file_name": "Sunset Garden.png", "id": "992910482545583", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031529_992910485878916_7558536400619069083_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mJF1qycOPdwQ7kNvwF-j43f&_nc_oc=AdmHlKnY7WwBigZ90Ze1D_ZEjitr-G4yRcAJ-wimd88wrha2ytHtemDY0n9BCxNzlVc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&oh=00_Afvb3-ISj34R9URt0v_wsYbjW54bqcEu8_s49z73IlSItw&oe=69987277"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Backyard Bocce VR Thumbnail-01.png", "id": "516114197977459", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974666_516114201310792_687206025314467996_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=caf373HQyi4Q7kNvwHnl1q4&_nc_oc=AdnX7hgiqHu5ulR6ZsPWIITpCrbhjEABMvbDkukbQVT8r5vHR2ppuly8d2K-bY5nkmA&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&oh=00_Afu9-1Vb6bkfjDeZjsiNcvmVNfezV5LjEacdSSPhhjQYaA&oe=69984B34"}, "display_name": "Backyard Bocce VR", "keywords": [], "long_description": "Bocce is an ancient game of skill dating back over 7,000 years. The rules are simple, throw your ball as close as you can to the pauline. Whoever is closer scores points, then you move to that location and repeat. These simple rules create endless possibilities for variation in game play over different terrain and with different obstacles. \n\n*4 unique levels offering different challenges\n*48 hidden balls to customize your player\n*Play with up to 8 players at once in online multiplayer\n\nThis isn't tournament bocce, constrained to small square! Explore wherever you want, throw the pauline wherever you want, play wherever you want!", "short_description": "Backyard Bocce VR - Play bocce with your frien
Q7kNvwFjLOgU&_nc_oc=AdnxjwwGyw6T4uTBWR4-LHGy4a3g6UNour7tHtDsnkQnAezfbPieqVr8AWzT_13JGb4&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_AfvrqHkhlxP-LUyuBjRQlZJOQWkLsJU76-JUtMesHpMSYw&oe=69A58F6F"}, {"file_name": "Roof2.png", "id": "602861132068870", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974835_602861135402203_7988358339945255283_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XoxxEMVarKoQ7kNvwH8MOEL&_nc_oc=AdntHD4ahEBcwPLKiAXF4OoWl6_g2zLw4jIxHj1PIA3zTyDvJMCAQG5vZPd5juRri_w&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_AfuCtu6tKh7mI8X8q85cHUwwxrU8ZHoT5W-KGPHeaLUsAA&oe=69A58ED0"}, {"file_name": "Sunset Garden.png", "id": "992910482545583", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39031529_992910485878916_7558536400619069083_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OTxL80w0ifcQ7kNvwHiXe5d&_nc_oc=AdlP8DQ_XPdugtbZqIBu7CEeYxCsSG9JvIdHfO_n4F0hxyjiq0Q9Mhl5SdOzHRmUA7o&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_AfsYigqdLICFzAl6a0Mh34_-QEcyLrS_eFQwbpm_-cic7w&oe=69A56937"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Backyard Bocce VR Thumbnail-01.png", "id": "516114197977459", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974666_516114201310792_687206025314467996_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ECKtExoLbZEQ7kNvwHwBfwr&_nc_oc=AdkDkMhTIhIzAtwEd4dQk5eRS5bUUX4hv5Ys2ZUk8FOT4ahp5Jvd97ZNYeIfyB3G_1U&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&oh=00_AfvwSpeCAHTOdbzCBV4vi9vUnByMZvlRwr5J-2NrAS5Siw&oe=69A57A34"}, "display_name": "Backyard Bocce VR", "keywords": [], "long_description": "Bocce / Boules Petanque / Boccia is an ancient game of skill dating back over 7,000 years. The rules are simple, throw your ball as close as you can to the pauline. Whoever is closer scores points, then you move to that location and repeat. These simple rules create endless possibilities for variation in game play over different terrain and with different obstacles. \n\n*4 unique levels offering different challenges\n*48 hidden balls to customize your player\n*Play with up to 8 players at once in online multiplayer\n\nThis isn't tournament bocce, constrained to small square! Explore wherever you want, throw the pauline wherever you want, play wherever you want!", "short_description": "Backyard Bocce VR - Play bocce with your friends across diverse landscapes. Explore wherever you want, throw the pauline wherever you want, play wherever you want!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://backyardboccevr.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Backyard Bocce VR LLC", "support_website_url": null, "website_url": "http://www.backyardboccevr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER", "CO_OP"], "id": "32076572318625232"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974877_1541853343357930_8495391464306444867_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I5OvPOpRicQQ7kNvwHIhhUl&_nc_oc=AdnBb7DY7_0WsCERr3qLKyta_sYSa8P9RrqXlzI9NNj5OJqpIAc-4ejEkpDLBe0DGWg&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_AfsncFQxUKhtwGAT7dFhl6WWnHP6adpzlwTl7cNMnWDSBw&oe=69A57521"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, 
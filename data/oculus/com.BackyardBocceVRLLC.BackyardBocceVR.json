Q7kNvwHeeN2-&_nc_oc=AdmOpwKi7GgsUQppVovC7i7pN0iNIgk-wf6uJvnVYb8fmdMWWa4WHtTZuTfHnpO3qAg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AfsQF5IkX7Y9AiVjrHEp7jqq8YBDHcxm98S_fE4-HsUGBA&oe=699B036F"}, {"file_name": "Roof2.png", "id": "602861132068870", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974835_602861135402203_7988358339945255283_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9kXaSBjC98UQ7kNvwGLXk57&_nc_oc=AdmG7lgzi_fj6hRc0qVOdiDndyXkufXEq0padfiV0aJC11Qx29L2vRkQ9t1-kutO79k&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_Aft2qxH9c2lLbTvKWpHJffh9RyUtOzMcHVAi6hI-ZNZIqQ&oe=699B02D0"}, {"file_name": "Sunset Garden.png", "id": "992910482545583", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031529_992910485878916_7558536400619069083_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mJF1qycOPdwQ7kNvwETtu9m&_nc_oc=Adlnl313YgaPITbk1-y7NMW380OpBL3tEY_anEpQAFr-Hn-I6qz7DlSdbL7CmbgOh4U&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_AfsCeOb2JPMwDkxg_cqBuJ2u3kODmAa9Yk_9OTJQnaVtjw&oe=699B1577"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Backyard Bocce VR Thumbnail-01.png", "id": "516114197977459", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974666_516114201310792_687206025314467996_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=reHvjQ3poasQ7kNvwFOF8a4&_nc_oc=Adkzlc54W33D951m8pXfWBQIvcm2bFAumfCMy9fCTtU-Lq3FUeV4cDq00oyHN88SQnU&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_Afuc9fcA8MyAJab0NTBtFC0w9A1TjDDBpg3InQMC_6o51w&oe=699AEE34"}, "display_name": "Backyard Bocce VR", "keywords": [], "long_description": "Bocce / Boules Petanque / Boccia is an ancient game of skill dating back over 7,000 years. The rules are simple, throw your ball as close as you can to the pauline. Whoever is closer scores points, then you move to that location and repeat. These simple rules create endless possibilities for variation in game play over different terrain and with different obstacles. \n\n*4 unique levels offering different challenges\n*48 hidden balls to customize your player\n*Play with up to 8 players at once in online multiplayer\n\nThis isn't tournament bocce, constrained to small square! Explore wherever you want, throw the pauline wherever you want, play wherever you want!", "short_description": "Backyard Bocce VR - Play bocce with your friends across diverse landscapes. Explore wherever you want, throw the pauline wherever you want, play wherever you want!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://backyardboccevr.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Backyard Bocce VR LLC", "support_website_url": null, "website_url": "http://www.backyardboccevr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER", "CO_OP"], "id": "32076572318625232"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974877_1541853343357930_8495391464306444867_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jII8bNzLe_kQ7kNvwGkJb5o&_nc_oc=Adnt6xbL1j7YdyakMXagTk0vLsetody4d83T4-kgTuyc8q_fLfkQp78eVD5gpAAN6DE&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfvZRTjfhgPoUa30g6IUFxCsPMR6BQZ2ADp4dJDDvxOhdw&oe=699AE921"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, 
Q7kNvwGzJwvF&_nc_oc=Adnf4RAuhEwE8AlxiQphx4dkbmLHi7HuhUvWATKoM3q23lGWgGZw9TIhnru_TIwUH9g&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&oh=00_AftwJAwolsF8l1rp0GU92g6yXTPEtYhWCc-t6ySegs_vDQ&oe=6998606F"}, {"file_name": "Roof2.png", "id": "602861132068870", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974835_602861135402203_7988358339945255283_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9kXaSBjC98UQ7kNvwEKB1qY&_nc_oc=AdnGkCDj_rFxFWBp1ZwH-KOKPBQnRllnE3Q5ddid5QbsEA_T0e2iskSbyX69Qteyock&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&oh=00_AfuBOcEk_BHZECQl9BS18HD1pjtHW3YW7eVtDVqLtylmww&oe=69985FD0"}, {"file_name": "Sunset Garden.png", "id": "992910482545583", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031529_992910485878916_7558536400619069083_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mJF1qycOPdwQ7kNvwF-j43f&_nc_oc=AdmHlKnY7WwBigZ90Ze1D_ZEjitr-G4yRcAJ-wimd88wrha2ytHtemDY0n9BCxNzlVc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&oh=00_Afvb3-ISj34R9URt0v_wsYbjW54bqcEu8_s49z73IlSItw&oe=69987277"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Backyard Bocce VR Thumbnail-01.png", "id": "516114197977459", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974666_516114201310792_687206025314467996_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=caf373HQyi4Q7kNvwHnl1q4&_nc_oc=AdnX7hgiqHu5ulR6ZsPWIITpCrbhjEABMvbDkukbQVT8r5vHR2ppuly8d2K-bY5nkmA&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&oh=00_Afu9-1Vb6bkfjDeZjsiNcvmVNfezV5LjEacdSSPhhjQYaA&oe=69984B34"}, "display_name": "Backyard Bocce VR", "keywords": [], "long_description": "Bocce / Boules Petanque / Boccia is an ancient game of skill dating back over 7,000 years. The rules are simple, throw your ball as close as you can to the pauline. Whoever is closer scores points, then you move to that location and repeat. These simple rules create endless possibilities for variation in game play over different terrain and with different obstacles. \n\n*4 unique levels offering different challenges\n*48 hidden balls to customize your player\n*Play with up to 8 players at once in online multiplayer\n\nThis isn't tournament bocce, constrained to small square! Explore wherever you want, throw the pauline wherever you want, play wherever you want!", "short_description": "Backyard Bocce VR - Play bocce with your friends across diverse landscapes. Explore wherever you want, throw the pauline wherever you want, play wherever you want!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://backyardboccevr.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Backyard Bocce VR LLC", "support_website_url": null, "website_url": "http://www.backyardboccevr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER", "CO_OP"], "id": "32076572318625232"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974877_1541853343357930_8495391464306444867_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cvBfLI9qesIQ7kNvwHgIC0l&_nc_oc=Adlt-Sd_BeD8Wn9tmfRw2IENFQVS6_OrtNeJ2NMdb_qQ1lFWB0NgZO0rwqfYLk4iksc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&oh=00_AfsKZ5n_ue4BlRUPTqLFmzY2C98asd9dUeIPIxm6GKoBeg&oe=69984621"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, 
135402203_7988358339945255283_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BgB-x_gtf90Q7kNvwEpPOxZ&_nc_oc=AdnzFq9WfolR7ra9_p7J25b5hbmeR_ds8DzdK2u4OnSWViMj4SbfZniCwWiEOCwNunY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfsS8v9_rn-3NhiUaVuFu32ARHACElXC1SQ_TBC6SkuJ8w&oe=69A2EBD0"}, {"file_name": "Sunset Garden.png", "id": "992910482545583", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031529_992910485878916_7558536400619069083_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_Z2uy4S5kKgQ7kNvwF115Fj&_nc_oc=Admb8h7ZUHkqd9ufOju1HpSizpruFH_Lr_XN3i-iHb8hpQ-72pvzkveQomNrEs7MA8Q&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfvEq2ZTV7XCnc_OS7rrKAkzvyEvtmfqEn8_y2sNoi4fNg&oe=69A2FE77"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Backyard Bocce VR Thumbnail-01.png", "id": "516114197977459", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974666_516114201310792_687206025314467996_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tGDUnTdpcOYQ7kNvwFHN9b7&_nc_oc=Adk4kyK5ha0y-64C_dAcEExbdUyZGm81gCklD4VvQ6tdft3l5_tiUaEHzSvGxwqFUQQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AftR_UXPV2FkanxzkxdkySgp7lCqmqi51oqqUx7FtGu1WQ&oe=69A2D734"}, "display_name": "Backyard Bocce VR", "keywords": [], "long_description": "Bocce is an ancient game of skill dating back over 7,000 years. The rules are simple, throw your ball as close as you can to the pauline. Whoever is closer scores points, then you move to that location and repeat. These simple rules create endless possibilities for variation in game play over different terrain and with different obstacles. \n\n*4 unique levels offering different challenges\n*48 hidden balls to customize your player\n*Play with up to 8 players at once in online multiplayer\n\nThis isn't tournament bocce, constrained to small square! Explore wherever you want, throw the pauline wherever you want, play wherever you want!", "short_description": "Backyard Bocce VR - Play bocce with your frien
iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AftwZJM4YcOf_1vDP81_3V0L6PrP-yQJvGYxywtaNhYOrA&oe=69A983EF"}, {"file_name": "Roof2.png", "id": "602861132068870", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974835_602861135402203_7988358339945255283_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y9T714WzX9IQ7kNvwGtLaM6&_nc_oc=AdnnUORV7Nqo2-Vn_VR-8Qe8ahQoYzMGzNFNpdeo8BfRQ8zB04qEw5swiz1Ebn-2mxM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_Afuxt9xUHoEzzBLL86rb2ELg-ql4AMxfdaPyh8GyqVGtzQ&oe=69A98350"}, {"file_name": "Sunset Garden.png", "id": "992910482545583", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031529_992910485878916_7558536400619069083_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xuOCVo3Jec4Q7kNvwGf7JQD&_nc_oc=Adlii3MpvbpNT6xarGWM3mtcCJbS3JCm3SuPtR6Kuanb5dxMWfw6yjCz3OkE2NKlkEM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfsDX_ONEegyFNOiHicvfV07ngLwdzJlnaW8fbOdLSviPg&oe=69A995F7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Backyard Bocce VR Thumbnail-01.png", "id": "516114197977459", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974666_516114201310792_687206025314467996_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=t05XeDOpWxEQ7kNvwH_DFnZ&_nc_oc=AdlPX1Ivsf8D71AnmUUWq9ra0jt3BM9k-bWiiQfM7nO1ncggWnch1RnY3r9hMIeEqAs&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfsMvXvJCrxYuTFkhwRWMzUMkg9PSfg4h4mKUeccOmiViA&oe=69A96EB4"}, "display_name": "Backyard Bocce VR", "keywords": [], "long_description": "Bocce is an ancient game of skill dating back over 7,000 years. The rules are simple, throw your ball as close as you can to the pauline. Whoever is closer scores points, then you move to that location and repeat. These simple rules create endless possibilities for variation in game play over different terrain and with different obstacles. \n\n*4 unique levels offering different challenges\n*48 hidden balls to customize your player\n*Play with up to 8 players at once in online multiplayer\n\nThis isn't tournament bocce, constrained to small square! Explore wherever you want, throw the pauline wherever you want, play wherever you want!", "short_description": "Backyard Bocce VR - Play bocce with your friends across diverse landscapes. Explore wherever you want, throw the pauline wherever you want, play wherever you want!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://backyardboccevr.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Backyard Bocce VR LLV", "support_website_url": null, "website_url": "http://www.backyardboccevr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "MULTI_USER", "CO_OP"], "id": "27339701785645666"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PUBLISHED", "id": "1139682184662865"}, {"status": "PUBLISHED", "id": "484232847993736"}]}, "baseline_offer": {"id": "484232847993736"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1755277200, "status": "PUBLISHED", "id": "1139682184662865"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "27781159698166537", "version": "1.0.10"}, "id": "2873789782785072", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"
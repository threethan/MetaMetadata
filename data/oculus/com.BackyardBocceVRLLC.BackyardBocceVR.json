135402203_7988358339945255283_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tbfR45W5XZUQ7kNvwFTB9Po&_nc_oc=AdlQWh-bX8untgHMGJhyfD4OGE_oPIrTaN_yiIaf_2AhPOo99C7Bqyol-WIBZ7vl3n8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AfurJrchL6IzF-SoRioDllM5ofbVaG7yMKCV3JLKGZcuyA&oe=699C5450"}, {"file_name": "Sunset Garden.png", "id": "992910482545583", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031529_992910485878916_7558536400619069083_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rBqyyiQaIhgQ7kNvwGP_pHZ&_nc_oc=AdmtKk504mc3OvgqMcGt2zSzx9SeOdfKrEpAZ4Litg4Etuw-OVNYmbymGJjt1JSE0kc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_Afs2W5iiAi-8uQzbJxCHXHYREyr5xv8NVfr78RCqd1KTbQ&oe=699C66F7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Backyard Bocce VR Thumbnail-01.png", "id": "516114197977459", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974666_516114201310792_687206025314467996_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=reHvjQ3poasQ7kNvwG5lVzw&_nc_oc=Adlo2Jc6LjDBS7U8b7LkWgDhBHaquG7err8mPOEN9wg1eNoNQcLai1T3wDFbd62VlFw&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_Afsm5p2_lyeBZ8E0YUvm2Y5hNPoRG2nbfasDZR4sXoyzJw&oe=699C3FB4"}, "display_name": "Backyard Bocce VR", "keywords": [], "long_description": "Bocce is an ancient game of skill dating back over 7,000 years. The rules are simple, throw your ball as close as you can to the pauline. Whoever is closer scores points, then you move to that location and repeat. These simple rules create endless possibilities for variation in game play over different terrain and with different obstacles. \n\n*4 unique levels offering different challenges\n*48 hidden balls to customize your player\n*Play with up to 8 players at once in online multiplayer\n\nThis isn't tournament bocce, constrained to small square! Explore wherever you want, throw the pauline wherever you want, play wherever you want!", "short_description": "Backyard Bocce VR - Play bocce with your frien
uscdn.com/v/t64.5771-25/39036675_448953544465145_1847871226734800309_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ldkJNT2zbcUQ7kNvwGdDQGZ&_nc_oc=Adpv2pMdLAOfcfti78R_rC5Nwbq4-t3JETRpYytJh3TTSoKWDrDgkcGs-4j-3rfGbU0&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH0DXEeob0FltID6lZd38F-1YOtHiUBNfIYUt3QOpnfPw&oe=6A8EE8EF"}, {"file_name": "Roof2.png", "id": "602861132068870", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/38974835_602861135402203_7988358339945255283_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LRcRWWlLi-cQ7kNvwHT813c&_nc_oc=AdqRX828dry4oID4bYqtKgiEMHI4s7lBQexK57EOrTGNEYfbG0BHO8ZpL5qCQYRHjOw&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFXH2zvq7avyg7--X4iFTS5YRHLNtDw9JqWAxtCuZo2RA&oe=6A8EE850"}, {"file_name": "Sunset Garden.png", "id": "992910482545583", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/39031529_992910485878916_7558536400619069083_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3-BuDMZxA_UQ7kNvwHXHOYN&_nc_oc=AdpYmVavvMmiEwE3rlxUp0OmCZdrQM6LXJdauxd8Rv3iS9WROz87KBSe1XHDvxjtqZs&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF7o3rEtEiPaxxJAVJRdSnB6T1uaFQShIREm9-7KIxmQg&oe=6A8EFAF7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Backyard Bocce VR Thumbnail-01.png", "id": "516114197977459", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/38974666_516114201310792_687206025314467996_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fMFhNQ0NjCcQ7kNvwE1cdat&_nc_oc=AdpbaGxaPnH4yVgtsvh1HI-CWP7LTiMuEx8L7Vnq0LI8P287_0ebnpPfKCWzLk7VsZM&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHHdfRGDSrM7zHZDYLeldfouRBg62Iq12thIisJt0A-sA&oe=6A8ED3B4"}, "display_name": "Backyard Bocce VR", "keywords": [], "long_description": "Bocce / Boules Petanque / Boccia is an ancient game of skill dating back over 7,000 years. The rules are simple, throw your ball as close as you can to the pauline. Whoever is closer scores points, then you move to that location and repeat. These simple rules create endless possibilities for variation in game play over different terrain and with different obstacles. \n\n*4 unique levels offering different challenges\n*48 hidden balls to customize your player\n*Play with up to 8 players at once in online multiplayer\n\nThis isn't tournament bocce, constrained to small square! Explore wherever you want, throw the pauline wherever you want, play wherever you want!", "short_description": "Backyard Bocce VR - Play bocce with your friends across diverse landscapes. Explore wherever you want, throw the pauline wherever you want, play wherever you want!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://backyardboccevr.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Backyard Bocce VR LLC", "support_website_url": null, "website_url": "http://www.backyardboccevr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER", "CO_OP"], "id": "32076572318625232"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/38974877_1541853343357930_8495391464306444867_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HJ5IVNZhW-cQ7kNvwGQPJ-h&_nc_oc=AdqwSOeKPYTQe5V6Mr720KN5lF4moXEW2OgrYg2_u3nG5NOCDWw1zujF7T_AXZNV
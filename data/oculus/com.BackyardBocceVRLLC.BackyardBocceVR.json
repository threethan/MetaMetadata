Q7kNvwF0yAi6&_nc_oc=AdnRIsPwgtuqpZWCKxY-6mDCB6UAPQAZs3Pz00aJyzkk3g1OvVuvK_40BVnta3-EW4c&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Aftseg93efyQbWZhDWN0KQKaxb_X9hKG7h3Ca3iJqMNokw&oe=699DA66F"}, {"file_name": "Roof2.png", "id": "602861132068870", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974835_602861135402203_7988358339945255283_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tbfR45W5XZUQ7kNvwFVTanH&_nc_oc=Adlz8ASg7Z0Q7MbwNStMoLsOlnzQY_ZUeKruk3OPm1p7pXcrW53u0TrvNRtQ0i8u4xE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfvWNiIoUkPdWiq_xqwlnQWokyMSiOEMrf3qpbm3apCW9A&oe=699DA5D0"}, {"file_name": "Sunset Garden.png", "id": "992910482545583", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031529_992910485878916_7558536400619069083_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rBqyyiQaIhgQ7kNvwFadsPO&_nc_oc=AdmLS2_oQf5VMNWlOOTwv_r_Hn0yMbwdJyzV2Tu81ThozCpPfnQhp-m4lUhYeiaC3EY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfsqFLN8x6HVbhgzE9Y3WxPTR716kNIc3azTgQ9K966ZKQ&oe=699D8037"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Backyard Bocce VR Thumbnail-01.png", "id": "516114197977459", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974666_516114201310792_687206025314467996_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c5zkIH4pjQsQ7kNvwHnpa0Y&_nc_oc=AdkB_6DE3Mnt5aGn-YQJbcxnnwmcrtb_TTdBKAJ4jlrX0jvfTyPFqYIhobmxnAmYjik&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AftKFzuphQFnS3s4r-kFMAsHPZfUhQSmymma5Ta5LFh2FQ&oe=699D9134"}, "display_name": "Backyard Bocce VR", "keywords": [], "long_description": "Bocce / Boules Petanque / Boccia is an ancient game of skill dating back over 7,000 years. The rules are simple, throw your ball as close as you can to the pauline. Whoever is closer scores points, then you move to that location and repeat. These simple rules create endless possibilities for variation in game play over different terrain and with different obstacles. \n\n*4 unique levels offering different challenges\n*48 hidden balls to customize your player\n*Play with up to 8 players at once in online multiplayer\n\nThis isn't tournament bocce, constrained to small square! Explore wherever you want, throw the pauline wherever you want, play wherever you want!", "short_description": "Backyard Bocce VR - Play bocce with your friends across diverse landscapes. Explore wherever you want, throw the pauline wherever you want, play wherever you want!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://backyardboccevr.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Backyard Bocce VR LLC", "support_website_url": null, "website_url": "http://www.backyardboccevr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER", "CO_OP"], "id": "32076572318625232"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974877_1541853343357930_8495391464306444867_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PblrN3aKt4AQ7kNvwG3Y_vN&_nc_oc=AdlbmVD-P-4Ut06eGvRwos2tLHvqXlsp5cHicLTVA_8CBCYy5Y-FDeLOxOjSTkswfWw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfuREEdARKSU9tWAwxsWHizBWDZligsDDt4uhuMdeYfYFQ&oe=699D8C21"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, 
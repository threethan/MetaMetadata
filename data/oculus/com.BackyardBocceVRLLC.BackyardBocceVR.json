135402203_7988358339945255283_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tbfR45W5XZUQ7kNvwFVTanH&_nc_oc=Adlz8ASg7Z0Q7MbwNStMoLsOlnzQY_ZUeKruk3OPm1p7pXcrW53u0TrvNRtQ0i8u4xE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfvWNiIoUkPdWiq_xqwlnQWokyMSiOEMrf3qpbm3apCW9A&oe=699DA5D0"}, {"file_name": "Sunset Garden.png", "id": "992910482545583", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031529_992910485878916_7558536400619069083_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rBqyyiQaIhgQ7kNvwFadsPO&_nc_oc=AdmLS2_oQf5VMNWlOOTwv_r_Hn0yMbwdJyzV2Tu81ThozCpPfnQhp-m4lUhYeiaC3EY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfsqFLN8x6HVbhgzE9Y3WxPTR716kNIc3azTgQ9K966ZKQ&oe=699D8037"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Backyard Bocce VR Thumbnail-01.png", "id": "516114197977459", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974666_516114201310792_687206025314467996_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c5zkIH4pjQsQ7kNvwHnpa0Y&_nc_oc=AdkB_6DE3Mnt5aGn-YQJbcxnnwmcrtb_TTdBKAJ4jlrX0jvfTyPFqYIhobmxnAmYjik&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AftKFzuphQFnS3s4r-kFMAsHPZfUhQSmymma5Ta5LFh2FQ&oe=699D9134"}, "display_name": "Backyard Bocce VR", "keywords": [], "long_description": "Bocce is an ancient game of skill dating back over 7,000 years. The rules are simple, throw your ball as close as you can to the pauline. Whoever is closer scores points, then you move to that location and repeat. These simple rules create endless possibilities for variation in game play over different terrain and with different obstacles. \n\n*4 unique levels offering different challenges\n*48 hidden balls to customize your player\n*Play with up to 8 players at once in online multiplayer\n\nThis isn't tournament bocce, constrained to small square! Explore wherever you want, throw the pauline wherever you want, play wherever you want!", "short_description": "Backyard Bocce VR - Play bocce with your frien
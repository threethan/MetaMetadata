135402203_7988358339945255283_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9kXaSBjC98UQ7kNvwGLXk57&_nc_oc=AdmG7lgzi_fj6hRc0qVOdiDndyXkufXEq0padfiV0aJC11Qx29L2vRkQ9t1-kutO79k&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_Aft2qxH9c2lLbTvKWpHJffh9RyUtOzMcHVAi6hI-ZNZIqQ&oe=699B02D0"}, {"file_name": "Sunset Garden.png", "id": "992910482545583", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031529_992910485878916_7558536400619069083_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mJF1qycOPdwQ7kNvwETtu9m&_nc_oc=Adlnl313YgaPITbk1-y7NMW380OpBL3tEY_anEpQAFr-Hn-I6qz7DlSdbL7CmbgOh4U&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_AfsCeOb2JPMwDkxg_cqBuJ2u3kODmAa9Yk_9OTJQnaVtjw&oe=699B1577"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Backyard Bocce VR Thumbnail-01.png", "id": "516114197977459", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974666_516114201310792_687206025314467996_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=reHvjQ3poasQ7kNvwFOF8a4&_nc_oc=Adkzlc54W33D951m8pXfWBQIvcm2bFAumfCMy9fCTtU-Lq3FUeV4cDq00oyHN88SQnU&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_Afuc9fcA8MyAJab0NTBtFC0w9A1TjDDBpg3InQMC_6o51w&oe=699AEE34"}, "display_name": "Backyard Bocce VR", "keywords": [], "long_description": "Bocce is an ancient game of skill dating back over 7,000 years. The rules are simple, throw your ball as close as you can to the pauline. Whoever is closer scores points, then you move to that location and repeat. These simple rules create endless possibilities for variation in game play over different terrain and with different obstacles. \n\n*4 unique levels offering different challenges\n*48 hidden balls to customize your player\n*Play with up to 8 players at once in online multiplayer\n\nThis isn't tournament bocce, constrained to small square! Explore wherever you want, throw the pauline wherever you want, play wherever you want!", "short_description": "Backyard Bocce VR - Play bocce with your frien
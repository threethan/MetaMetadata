6E5C"}, {"file_name": "migrated_image.png", "id": "144443983569875", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/12427649_456808784714619_852784955124613120_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6WY8OrcnqkkQ7kNvwGYjith&_nc_oc=AdoqG9YWas155ICOZIotjULB7MAcuJMhtDRnGnrqTXpiztdY7a-Z4mzlvSp7vGi4B4k&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7RVnpO1KA5AV-aTMAk6cdLkvUJV7Us9Szq4Vymum3thA&oe=6A047B83"}, {"file_name": "migrated_image.png", "id": "230648738284151", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/11162763_176598276262202_4256242998980902912_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0zO-whQV3WQQ7kNvwEzUA9_&_nc_oc=Adp_QmNJDkvVh_Gus_kX2kijBdNlInMoG6KG7R8WsMN4TbYzrBcwvp3cQ1f1zIqRCcA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7HmI1GLj_fD2QMpAqokAzYJphOPC5eW0HYeTqIJtGlwA&oe=6A0481C8"}, {"file_name": "migrated_image.png", "id": "239337600445669", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/11162766_313807375790667_7447167700045922304_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-jsFuNBxGMIQ7kNvwG8rPBq&_nc_oc=Adqaxznlq_CfG3UBQ_i1ZH_MCK-vIH5fCVyB53JXONdytIybT-1fl_9uqBVl3ISw7M0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6nf7Oq5te_R6NIlBerfCzmCbVoAb-BfsAnRDABMMqjVg&oe=6A04864E"}, {"file_name": "migrated_image.png", "id": "528127864559513", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/11162716_527967557576747_5858260710852657152_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pfxWQLaIVQMQ7kNvwEhjkyi&_nc_oc=Adpcj4wl0Yv9juzOjU8h7_lDUD4Rmdn0eBHDSL31DcZwzjwRlfeew6369ax1frzjZhA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6KZ8MZLn0TreynBHkbouR16G_K9CbKwfQdNmTBZ8OXqg&oe=6A047242"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Wentworth VR", "keywords": ["narrative", "interactive", "drama", "fremantle", "prisoner"], "long_description": "Wentworth VR is a ground breaking interactive cinematic virtual reality experience. It\u2019s the official extension of the award winning TV series Wentworth.\n\nAs a new prisoner at Wentworth, you must find your feet and figure out who to trust in this dangerous new environment.\nThe previous occupant of your cell committed suicide in mysterious circumstances, and the J-Block crew are on the warpath about stolen gear. \n\nWhile trying to navigate complex prison politics, you must also try to piece together your own past - and what you did to get put in here. Are you ready to be locked up?\n\nNOTE: Wentworth VR needs 1GB free to successfully install. If you are having issues installing the app with an error of 'download failed', this may be due to not enough free space on your device.", "short_description": "The official VR app for the hit TV series Wentworth"}]}, "developer_name": "Start VR", "developer_privacy_policy_url": "https://startvr.co/privacy/", "developer_terms_of_service_url": "https://startvr.co/privacy/", "publisher_name": "Start VR", "support_website_url": null, "website_url": "http://www.wentworthvr.com/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE", "MOVIE", "NARRATIVE"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD", "GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "697316421279003"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974872_352513638714551_5156765033836838912_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0OJ6fWtVfEoQ7kNvwEucvIJ&_nc_oc=A
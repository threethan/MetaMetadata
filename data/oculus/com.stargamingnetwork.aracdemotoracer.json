_aos8xVfhAgQ7kNvwGeNTuI&_nc_oc=AdrdvwK3BuHaG80Xs2ItNG_fbNiBQmWZ9zR9UkEKZ9J4njaQrPnHUJWGnpb_z2ydKtM&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRTuxmpzqRMFSBIB4GjnCjKIJzVt8umRPhBwV4nZs9qyg&oe=6AFB1D00"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/oqHE3n", "id": "1511061745711431", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38974447_1511061752378097_2771438612519059456_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dWAhGfhPZmoQ7kNvwFYw_yH&_nc_oc=Adpo29bmYKBsOfcx3q6VlZ1x23NzuCkhzVtM9sBYFCa3EE8TI86hsT0exkB0ENxSvUc&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQSd4zeIER81nqEcPDXaB89I1Yo3HXELTYapvmOvDkSCA&oe=6AFB44FE"}, "display_name": "Arcade Motobike Racer", "keywords": ["Motorcycle"], "long_description": "SGN brings the Arcade home with Arcade Series Motobike Racing.  Arcade style Motorbike racing on your VR Headset! \n\nTwo different modes to challenge you. Timed Mode has eight different locations to race. Make it to the end of each one with time remaining to unlock the next. Try to unlock all eight.\n\nArcade mode offers one endless track to compete for the highest school. Compete against your friends and the world with the highest score on the Leaderboard.\n\nArcade Series Motobike Racing has all the fun and excitement of an Arcade game on your console. Stack your quarters relive the classic game play.", "short_description": "SGN brings the Arcade home with Arcade Series Motobike Racing.  Arcade style Motorbike racing on your VR Headset! \n\nArcade Series Motobike Racing has all the fun and excitement of an Arcade game on your console. Stack your quarters relive the classic game play."}]}, "developer_name": "Star Gaming Network", "developer_privacy_policy_url": "https://sgngames.com/privacypolicy.php", "developer_terms_of_service_url": "https://sgngames.com/termsofservice.php", "publisher_name": "Star Gaming Network", "support_website_url": "http://sg
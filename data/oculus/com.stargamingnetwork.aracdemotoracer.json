-J2e48r34PWkycyRSI1EjmDXaTeKU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4uFb5WVxlVFP-70SO4ANgRw5-NyNxwTiJdbVGM5dQV_g&oe=6A1D7F76"}, {"file_name": "migrated_image.png", "id": "550452908909456", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/57572957_501710873650172_6271185579723980800_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ouvr_V7RVW0Q7kNvwEvvxGc&_nc_oc=AdoYR410iWu72D4ajMzZ7ymeGBW1KOFnNbD-KYNNVwUmYe2gx_47BLW0F899CqmBB5M&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7JkHlvIzefsWyCFLv1q7SC9wxNQgCi9lYVSNOYtgwixQ&oe=6A1DAC6B"}, {"file_name": "migrated_image.png", "id": "507302683295536", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/57572944_599628664203705_6528393424276553728_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8rYJMY0L7A0Q7kNvwEToV8n&_nc_oc=Adrp31Y69rWw9xOqVE6J6kB5v05KwOLIilVGAEaH3AlWIny1zQUrGGnzXiTD13WgeA8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5qUpbobVkCSXtTsKA7PeuKB0UCd0ZWK8A_OQEE1ddgAg&oe=6A1DA100"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/oqHE3n", "id": "1511061745711431", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974447_1511061752378097_2771438612519059456_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sIkDauVS--cQ7kNvwHXwaj7&_nc_oc=AdoB9DptOI5y27_4vUWw87bLc0sLx97Bg7JQ92Gdt89eNt6TZYudcdfZnd8SD_NQXL8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af54DB5J6LiBKpfd58arAptrCs4ASqxlp_HwIKd_z-j8nw&oe=6A1D90BE"}, "display_name": "Arcade Motobike Racer", "keywords": ["Motorcycle"], "long_description": "SGN brings the Arcade home with Arcade Series Motobike Racing.  Arcade style Motorbike racing on your VR Headset! \n\nTwo different modes to challenge you. Timed Mode has eight different locations to race. Make it to the end of each one with time remaining to unlock the next. Try to unlock all eight.\n\nArcade mode offers one endless track to compete for the highest school. Compete against your friends and the world with the highest score on the Leaderboard.\n\nArcade Series Motobike Racing has all the fun and excitement of an Arcade game on your console. Stack your quarters relive the classic game play.", "short_description": "SGN brings the Arcade home with Arcade Series Motobike Racing.  Arcade style Motorbike racing on your VR Headset! \n\nArcade Series Motobike Racing has all the fun and excitement of an Arcade game on your console. Stack your quarters relive the classic game play."}]}, "developer_name": "Star Gaming Network", "developer_privacy_policy_url": "https://sgngames.com/privacypolicy.php", "developer_terms_of_service_url": "https://sgngames.com/termsofservice.php", "publisher_name": "Star Gaming Network", "support_website_url": "http://sgngames.com/contactus.php", "website_url": "http://sgngames.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE", "RACING"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "737606360547229"}}]}, "scheduled_offers": {"count": 0, "nodes": []}, "baseline_offer": null, "is_approved": true, "firstOffer": {"nodes": []}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "2636774309772335", "version": "1.0"}, "id": "457727881564345", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "2616254075
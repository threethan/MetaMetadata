sid=6e7a0a&_nc_ohc=tSCSSbpvoQUQ7kNvwEGXJsn&_nc_oc=AdmwLmIWkrm7ZzQzsjzDBHePq2A5Vi7uhCvWFqLbX6MG44bDQ2icRMcOA73F5Sp0tos&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_Afu_3XrVB0PfQrPoMulspRH9g-bx19u14rgPPpN2oxLFbQ&oe=699F00BE"}, "display_name": "Arcade Motobike Racer", "keywords": ["Motorcycle"], "long_description": "SGN brings the Arcade home with Arcade Series Motobike Racing.  Arcade style Motorbike racing on your VR Headset! \n\nTwo different modes to challenge you. Timed Mode has eight different locations to race. Make it to the end of each one with time remaining to unlock the next. Try to unlock all eight.\n\nArcade mode offers one endless track to compete for the highest school. Compete against your friends and the world with the highest score on the Leaderboard.\n\nArcade Series Motobike Racing has all the fun and excitement of an Arcade game on your console. Stack your quarters relive the classic game play.", "short_description": "SGN brings the Arcade home with Arcade Series Motobike Racing.  Arcade style Motorbike racing on your VR Headset! \n\nArcade Series Motobike Racing has all the fun and excitement of an Arcade game on your console. Stack your quarters relive the classic game play."}]}, "developer_name": "Star Gaming Network", "developer_privacy_policy_url": "https://sgngames.com/privacypolicy.php", "developer_terms_of_service_url": "https://sgngames.com/termsofservice.php", "publisher_name": "Star Gaming Network", "support_website_url": "http://sgngames.com/contactus.php", "website_url": "http://sgngames.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE", "RACING"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devi
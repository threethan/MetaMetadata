rSVQKPOleUYQ7kNvwFETsen&_nc_oc=AdrZDUIXQJemp8peykNeMyGGVMHofou92bn3VzD3nwigPNmEPkKNbjR98aYaUysuEbM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_n6CtbmR2yPEoBgD4rQKPoqIa2mNXtdfrRhKBpDtZAJA&oe=6A2D4E83"}, {"file_name": "External House.png", "id": "1269762908605986", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491820586_1269762911939319_6879772196275912059_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lz8M1wSDzloQ7kNvwF34Jh6&_nc_oc=AdromMZMjxCAI-nALTzcfcF9lZWzvHRkDwSoWzalvZIskDl4lNlkSaJEHGoHBQlKCEE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8jt5sW22zFPOFj27bbhNWJn6uAgrLOXONERqBmxujbVw&oe=6A2D5F5B"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Canibuild", "keywords": [], "long_description": "Canibuild makes property visualization easy, helping you focus on the details that matter most. Whether you\u2019re a homeowner, CGI artist, developer, architect or sales agent, you can step inside a future home before construction begins and watch your ideas take shape in real time.\n\nCanibuild lets you explore immersive spaces created from your floor plans or property models, making it easier to communicate your vision clearly and keep projects moving smoothly. Accessible on any device, Canibuild gives you the freedom to view your projects from wherever you are and make decisions when needed.\n\nUse Canibuild to:\n\n\u2022 Explore immersive virtual spaces: Experience your future home through walkable, interactive and dollhouse views.\n\u2022 Collaborate and review: Simplify design reviews with real-time tools built directly into the experience.\n\u2022 Share your experience: Quickly share your space with family, friends and contractors so they can better understand your future home.\n\u2022 Present your space: Connect easily with local and international clients through public or guided viewing sessions.\n\nDiscover a new way to visualize property with Canibuild and change how you experience spaces before they are built.", "short_description": "Know Possibilities Now.\n\nCanibuild takes the guesswork out of designing a space as it brings it to life in a 1:1 VR experience. See all the details and walk through a property before its built helping you make the important decisions in your design."}]}, "developer_name": null, "developer_privacy_policy_url": "https://canibuild.com/en-us/privacy-policy/", "developer_terms_of_service_url": "https://canibuild.com/en-us/terms-conditions/", "publisher_name": "CANIBUILD AU PTY LTD", "support_website_url": "https://canibuild.com/en-au/contact-us/", "website_url": "https://canibuild.com/en-au/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}, {"id": "1063584910766706"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "MULTI_USER"], "id": "26422996917352126"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823934_1298761588885292_6536445902045952382_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wVu1zdScQcIQ7kNvwGBB9B-&_nc_oc=AdpIsIoKQjzx6r7CbqCtBriC8Y9qjiCnNw0f2gP8NiD9XKJwbwZOkM0j3HbxpzsueGk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8ZiLOI0oujJGlMp-Xc-NLPpq6f5_fxEikM2gN5ec0qBw&oe=6A2D7814"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Canibuild", "platform": "ANDROID_6DOF", "context_category": {"context_category
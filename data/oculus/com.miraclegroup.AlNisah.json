PBDC6m1oQ7kNvwHJsY9l&_nc_oc=AdqFOok7HE-AzwUDPTPWkGkNimX-qyjLxoJkgxQ1OTg1Crzz1hZ_SGXPMdkoW9NpLDI&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFwV192GiN1TCo1ubE_nCTmWR0IwqZf9fduGd7jkKr5qw&oe=6A971C46"}, {"file_name": "ss 5.png", "id": "1593766201840084", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/491818885_1593766205173417_1636673139800414938_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yfGfqjfJOaAQ7kNvwGqx89b&_nc_oc=AdqfTLmuFEzvc_CL24DdkLQXS0y70KVhsz-IQS_DXid8oyymzPTDYIXU5SS_SGCP0rM&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHxjN93ty8ws3__1n8uOOYE3MCGUJRBpN6aT1ys_oACdA&oe=6A974998"}, {"file_name": "ss 4.png", "id": "806634302465925", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/491819281_806634309132591_6777497152443672383_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Uf2lEuPnht8Q7kNvwEGzYxH&_nc_oc=AdrJDSpNw4foZpmTWC19R-sRN2yFh4Z0ziYKOxIlvHb9TAySfpRLrrv4IbU9vt7cUgE&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG6ca6F1c0G83Luue9tJFbkv3LhgCrRLCsl7T3mZqsw0A&oe=6A9739FA"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Surah ALNisah", "keywords": ["quran", "quran3d", "quranvr", "nisa", "education"], "long_description": "Surah ALNisa \u2013 VR Experience\n\nExperience the profound teachings of Surah ALNisa, the fourth chapter of the Holy Quran, in an immersive virtual reality environment designed for Meta Quest.\n\nThis VR experience allows you to reflect, listen, and engage with the verses of Surah ALNisa in a calm and distraction-free setting. High-quality audio and smooth navigation make it easy to follow along, whether for recitation, memorization, or contemplation.\n\nSurah ALNisa emphasizes justice, equality, social responsibility, and guidance for family and community life. It provides vital lessons on rights, responsibilities, and ethical conduct, offering timeless guidance for both personal and societal growth.\n\nFeatures:\nComplete recitation of Surah ALNisa\nClear, high-quality audio\nImmersive VR environment for reflection and focus\nEasy verse navigation\nSmooth and optimized performance on Meta Quest\n\nIdeal for daily listening, memorization, and spiritual reflection, this VR experience brings the Quran to life, creating a meaningful connection with the teachings of Allah in a modern, interactive way.", "short_description": "We are thrilled to bring Surah ALNisa to our VR Quran app.\nImmerse yourself in the complete recitation with clear audio and smooth navigation, designed for a focused and meaningful spiritual VR experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.miraclegroup.work/privacy", "developer_terms_of_service_url": null, "publisher_name": "Miracle Group", "support_website_url": null, "website_url": "https://www.miraclegroup.work/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25960968386921058"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/491827601_1423672582536653_6495967838486160594_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=op8Ph1YSEiUQ7kNvwF6vlyo&_nc_oc=AdpjR3xP77w4JlLWmJ0SLA-WQVCDvy-CbMFQoor2WVau3NPHbAYp3QRyX6jqJkcmu4w&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHIpESteMBwezHsISWow_usUMWFG0sv_LJMRjnd9mjvUA&o
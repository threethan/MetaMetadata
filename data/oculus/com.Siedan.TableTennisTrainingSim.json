Ew_Miwkf_-wfDPrpBtuKixO5rvfP8A&oe=699EDCC3"}, {"file_name": "en5.png", "id": "9653778068042396", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491820560_9653778074709062_1096914425578904634_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fRkw41BHVH0Q7kNvwGHBXaq&_nc_oc=AdlJgNmT3WetnLuHps-KGBZ1P1WS3cLiBQSvwrcSnQG7Zhjv6KPVoNhyt0a5rL0CCF4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AfsuWUhXJ4EAhoq7gt7O093Rva85TgGhLPwXtCSXn_erqw&oe=699EF3D5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "t3s__cover.png", "id": "1701923837081980", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491831784_1701923840415313_7449942571803150049_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T8tP1L6j6ckQ7kNvwGjw-aC&_nc_oc=Adn2iu3VqP96p5fRpCoFjvOsAtM0lKg9pq-T0rB6JVPt8Q5ki_lStuWpSe38ODwaz-E&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AfvRcLyQx6X8sVUGNMTeOIgQ0tlMpmGwYdNwTqnpFHJVYw&oe=699F039D"}, "display_name": "Table Tennis Training Simulator", "keywords": [], "long_description": "Table Tennis Training Simulator (T3S) is a very pure table tennis training simulation software that is based on a realistic and rigorous physical system, providing a series of innovative training tools aimed at improving table tennis skills. After more than half a year of trial, I have constantly come up with new ideas and suggestions from my teammates, gradually improving and taking into account the needs of beginners. If everyone has improved their skills by using T3S, it would be a great honor for me. Thank you. ", "short_description": "This is a table tennis training simulation software that is based on a realistic and rigorous physical system, providing a series of innovative coaching tools aimed at improving table tennis skills."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1K9QQ2IwcQMV2TbDKZy7S0LGAn8YJlsdKCRKKPF1gjOo/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Sie
ame": "Screenshot_20261021_214834.png", "id": "1632424824938894", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/499619404_1632424828272227_7894796106481589347_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BpP4s8SsGY4Q7kNvwED7Pmp&_nc_oc=AdpJA0h8jTAhHZq-eUaxY29TFrVHx4C-wddp7r0Y1uq2auBHmNReo6arLIQJQs697BI&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRLkMziAIOMSHic2k1rYOOwcHT5bbSLBYclWC9S5ZvEnA&oe=6AF9DEDF"}, {"file_name": "Screenshot_20261021_215219.png", "id": "1422321273450722", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/593858738_1422321276784055_260170431410994095_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MXbkThYSmVUQ7kNvwH6JMw5&_nc_oc=Adpkv7WBqgHTLMuRaLze8p83VkOJFzUesqcRwA8N7B7wSm0vBoR8CSEgJ9uwb0dLR2c&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQnrmB9xO6r_Eq3xPHW79hHKlfVti6wWmT5Zt8IraR4nQ&oe=6AF9D8CF"}, {"file_name": "Screenshot_20261021_215513.png", "id": "2277473586539545", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499620414_2277473589872878_2148036327385365515_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XhSNzh51JaEQ7kNvwHGBPiD&_nc_oc=Ado5q7VB7CNN-wpobXnLxw-uVCixZ7oHko64L7umfF55k00mKBx2B-1HA4SAbkQ23o8&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRvWkwFTmxZG53YBV3bGijmAPENDZTW44Y8aBjsJMT-IQ&oe=6AF9D885"}, {"file_name": "Screenshot_20261021_215538.png", "id": "2312840046158919", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/593945819_2312840052825585_3097401916087006245_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Epnv4IXWs8AQ7kNvwF28BMu&_nc_oc=AdoofUUMjnBwSh_5RH6yu-O0nj8-fUl0K5vmiYN0AJPnY3cTPkEfStOpZAqlXAH48ws&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTTySATeqQh3dS0P-gPYW8Yf-3-XDQwhNSDOhcFX2kJ_Q&oe=6AF9BB5B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Screenshot_20261021_215118.png", "id": "3687219384765689", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/491823746_3687219391432355_4762358757043249597_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VzxG-9nieDAQ7kNvwFqqj3b&_nc_oc=Adp52ZnkW1u2Fiib7WeokAeT5nkMywcGv-1o4_EUDpLH_yUIUtnfmb7e52PWyqENISM&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQmQoXbzGmqhQ3JVEDG1y0pvFqP1VFmZAITug6m7N3iNA&oe=6AF9E24E"}, "display_name": "The Forgotten House", "keywords": ["Escape", "Fun", "Mystery", "Puzzle"], "long_description": "You wake with a pounding headache, surrounded by unfamiliar walls. You cannot remember how you arrived\u2014or why the house feels strangely familiar.\n\nThe Forgotten House is a first-person psychological mystery built around exploration, puzzles, and fragmented memories. Search the house for clues, uncover hidden objects, and piece together the life you have forgotten.\n\nAt the heart of the mystery is Morphis, an invention capable of accessing memories. Through it, moments from your past begin to return. So do voices claiming to know what happened to you.\n\nTheir instructions may lead you forward. Their stories may contradict what you discover. Pay attention to the details: a familiar object, a hidden message, or a remembered conversation could change your understanding of everything.\n\n\u2022 Explore a house filled with secrets\nSearch its rooms and basement for clues that connect the present to your forgotten past.\n\n\u2022 Solve connected puzzles\nFind codes, examine objects, and use what you learn to uncover hidden places.\n\n\u2022 Recover fragments of your life\nExperience memories that gradually reveal the people, relationships, and events behind your disappearance.\n\n\u2022 Decide whom to believe\nListen carefully to the voices coming through Morphis. Help and manipulation can sound very much alike.\n\nThe house holds your memories. Finding them is only the beginning.", "short_description": "Trapped in a mysterious house with no memory of your past, explore forgotten rooms, solve puzzles, and uncover memories through a strange invention called Morphis. Voices promise to help you escape\u2014but discovering who to trust may be your hardest puzzle."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.resortstudio.net/the-forgetten-house", "developer_terms_of_service_url": null, "publisher_name": "ResortStudio", "support_website_url": null, "website_url": "https://www.resortstudio.net/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1114596744494079"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "3168528696871649"}]}, "baseline_offer": {"id": "3168528696871649"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1793019780, "status": "PUBLISHED", "id": "3168528696871649"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1124351270185293", "version": "1.0"}, "id": "1421924886179062", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1111802281440192", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1124351270185293"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1421924
uluscdn.com/v/t64.5771-25/75326673_655290492883355_6533036241384583083_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7yCazNZ35AEQ7kNvwG4bzRe&_nc_oc=AdoN69g_1QR7zvOyB_vCCE0TiswQdgocNwgNhXontIPT0nMKd07tR__xg9nlMokpqYg&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9U-0fQeMc56j2Z2ZX2uwypKD_LB98nUgm_Pkf0IK918w&oe=6A2FF6A7"}, {"file_name": "Screenshot5.png", "id": "1012860986400600", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/65227603_1012860989733933_3114375969068639733_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LUfsQyu1m5YQ7kNvwHC900y&_nc_oc=Adr0rD_FJhbs6Ng6X6jh7jA7toyL98htNGYf4Tnq_h7a-dgm50BmKxcX4GTvhE9b5Rs&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9w2XvMEgMLAaYpNrG0jFHzNznbX2QXBGZvkXCY4I_v4w&oe=6A2FF73D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Screenshot4.png", "id": "1005420113821059", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39035429_1005420117154392_2451060714789390847_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c8HM9k2Gf0IQ7kNvwEqy9GC&_nc_oc=AdrBTFgWnmDcbxCixS-61nkj_TWddWRmW8kJE_JAMHsSQcD5d13BcB_RL79qnilEWdg&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-X6DVt9RNeVokuSR5eu6H87mEgXMzfVFQlirCc1s0vGw&oe=6A30119B"}, "display_name": "Virtua - Virtual Reality Experience", "keywords": [], "long_description": "Virtua is an immersive VR software developed exclusively for internal medical training at BD (Becton Dickinson). This cutting-edge platform allows medical professionals to engage in realistic virtual scenarios, practicing device usage and placement techniques in a safe and controlled environment. With Virtua, BD aims to enhance the skills and confidence of its personnel, ensuring they stay updated with the latest advancements in medical technology. Please note that Virtua is not a substitute for comprehensive professional medical education and the consultation of user manuals, contraindications, and prohibited uses associated with BD's medical devices.", "short_description": "Virtua is an immersive VR software designed exclusively for internal medical training at BD (Becton Dickinson). Experience realistic virtual scenarios to enhance medical device usage and placement skills within a secure and controlled environment."}]}, "developer_name": null, "developer_privacy_policy_url": "https://doc.clickup.com/9007031206/p/h/8cdrrx6-7687/c8ab1e43415bed6/8cdrrx6-7707", "developer_terms_of_service_url": "https://doc.clickup.com/9007031206/p/h/8cdrrx6-7687/c8ab1e43415bed6/8cdrrx6-7647", "publisher_name": "FormulaXR", "support_website_url": null, "website_url": "https://www.bd.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "478089301798119"}, {"id": "514087707868786"}], "external_subscription_type": "REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "pt_BR", "es"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "MULTI_USER"], "id": "278932798064021"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "665463758958670"}]}, "baseline_offer": {"id": "665463758958670"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1690414967, "status": "PUBLISHED", "id": "665463758958670"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "8641258965976598", "version": "3.2.0"}, "id": "169831472659658", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "Andr
585_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i5GnHggvx-kQ7kNvwHAssLv&_nc_oc=AdpzNMMSqddJR1MmOke_uEJcORE5gRrAEEb4TPdVMZNpzVTYTSXYFi5swC_d7fDeGAs&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6Zi6nc-0ny0hoWBxQgo3yXkvfucdYJOq57y7PF5SgxHA&oe=6A09D012"}, {"file_name": "Screenshot 2024-09-19 140044_1.png", "id": "875052024558662", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/39035311_875052027891995_4491343046544077449_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sBbnH9Hez2wQ7kNvwGBQaCu&_nc_oc=AdopiUO2kq_H7KwLVFZ3ywBbqFYtYdkB8cMNpzQI_046Qr0K5fZ-2lMJpWDazs1k7gs&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7KLt3FjTBHk0oyaJMPHmP7Maf5W9OQJCNKQldH-awEKg&oe=6A09D61F"}, {"file_name": "Screenshot 2024-09-19 140104_1.png", "id": "1242115010275622", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/38974512_1242115016942288_5501748253489110433_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=15pz0Ijwi7IQ7kNvwHWOEB0&_nc_oc=Adq566XrZcF-yjwyHDr73cxvT8co-40KAme3X8dp1PkPf_PPr5BOREIrwx1rXg777w0&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7gcsALnaBy9e06LlGwtK8TCasfUspMWUV87nyIHRM66g&oe=6A09B54E"}, {"file_name": "Screenshot 2024-09-19 140128_1.png", "id": "544846457927476", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/38974579_544846461260809_5296880946640316475_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-TeFQsNDJvAQ7kNvwGZHfhQ&_nc_oc=AdoiRnEME9EcD7S2UUECstxgb7_hheHh8Zr8Swn1z-sMukzCiER6R3U1vnfSeoMe-68&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7ERRyAcdsDVFSbWsdZBFm6rWY2pgNElPlfEWq6UXzb-w&oe=6A09DF37"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BalanceBubbles_Trailer_Short.00_00_20_07.Still001 (1).png", "id": "1089442505874767", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/75258663_1089442509208100_1440755612146663990_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UcqdxxK6DzcQ7kNvwHMd6mZ&_nc_oc=AdqhALOS_kx6snUGigRrxSVJ5HBf18s0XReEtS66Qzx8vXT9A8dV0HMATEpg3Ph5ops&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5hVmynE7j5Oopm2LTktVFA1YYus1xgXndHX2h9VVdXng&oe=6A09BB09"}, "display_name": "HoloMoves: Balance Bubbles", "keywords": [], "long_description": "Balance Bubbles is an innovative exergame that makes rehabilitation both fun and effective! Specifically designed for rehabilitation centers and physical therapy, this game focuses on helping players improve their static balance through controlled body movements. In Balance Bubbles, music bubbles float toward the player, who must lean left or right to pop them. Each bubble popped produces a unique sound, letting players craft a symphony of harmonious notes as they advance through the game.\n\nThis game is ideal for rehabilitation exercises, as it targets specific physical therapy goals by encouraging precise movements to build strength and stability. Balance Bubbles makes working on your balance an immersive and enjoyable experience, all while achieving important therapeutic outcomes.\n\n**(!) Balance Bubbles is part of the larger HoloMoves package, a subscription service offering a wide variety of exergames specifically designed for rehabilitation and physical therapy. Get a personal license and learn more at www.holomoves.nl/en**", "short_description": "Balance Bubbles is an innovative exergame that makes rehabilitation both fun and effective! Specifically designed for rehabilitation centers and physical therapy, this game focuses on helping players improve their static balance through controlled body movements. In Balance Bubbles, music bubbles float toward the player, who must lean left or right to pop them. Each bubble popped produces a unique sound, letting players craft a symphony of harmonious notes as they advance through the game."}]}, "developer_name": null, "developer_privacy_policy_url": "https://holomoves.nl/en/privacy/", "developer_terms_of_service_url": null, "publisher_name": "HoloMoves
id": "485041437679884", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/57569436_485041441013217_4515494555141559585_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PJqe6EhUQPIQ7kNvwHxDIyR&_nc_oc=Adq_gfYbIksdfJ3ErEDhOlBE44j-AHnhJGiYlJd5X89sk7FE-n_oaYLm4bnoeW566VI&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO3SlWCyUBZSt0iFT1ukKU_ZWT_toEMjVb06iMoL3kc9w&oe=6AD38592"}, {"file_name": "Screenshot 2024-09-19 140044_1.png", "id": "875052024558662", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39035311_875052027891995_4491343046544077449_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IaUVMerqrn0Q7kNvwFAtomj&_nc_oc=AdqBgiF9OE4uMTHzU7NfwpIkVgIHYwQJK1xG66NgxlG87CNFTlX8juslCl3nq7P9J60&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPccmvgaKG5Cvbm_EGpKSRzyTcwqR3mz6Om-YXxPBJ5Ug&oe=6AD38B9F"}, {"file_name": "Screenshot 2024-09-19 140104_1.png", "id": "1242115010275622", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974512_1242115016942288_5501748253489110433_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wODI1CGERSoQ7kNvwGSU-RU&_nc_oc=Adow5WBPGIZMRA3uDVwsom9BN_OM_mYHknZ6hYCw8ahGWXZjhBbpFAhrVUnVAyS_Afk&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM3KRhAw-OVAMDaWlQTDwxNiivFqYJR3eU9ikVORygtzQ&oe=6AD3A30E"}, {"file_name": "Screenshot 2024-09-19 140128_1.png", "id": "544846457927476", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/38974579_544846461260809_5296880946640316475_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5uKpZvC4sn8Q7kNvwG1NIWN&_nc_oc=Ado_R5ukSII11tLdLMDdmBWeD52lFKgdy4dZFk7RSpnlQlh72UJ8wpxm754qq1OJUlo&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNMzPZDzizbCz_BzNimkkCCHWYoND1l_PCXxO8lt5EzdQ&oe=6AD394B7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BalanceBubbles_Trailer_Short.00_00_20_07.Still001 (1).png", "id": "1089442505874767", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/75258663_1089442509208100_1440755612146663990_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dAbHYZfazvEQ7kNvwEe-PDj&_nc_oc=Adr3f7aCsvJMzaPn2uC_h-nFxhSc9__SK5ZHTV6StbPeFqRWq0koEJT8F_PQ-ZkVCj4&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPGVth14KMXoT0ajT2CezWz67mKVXW2aasOB6W4C1wjvw&oe=6AD3A8C9"}, "display_name": "HoloMoves: Balance Bubbles", "keywords": [], "long_description": "Balance Bubbles is an innovative exergame that makes rehabilitation both fun and effective! Specifically designed for rehabilitation centers and physical therapy, this game focuses on helping players improve their static balance through controlled body movements. In Balance Bubbles, music bubbles float toward the player, who must lean left or right to pop them. Each bubble popped produces a unique sound, letting players craft a symphony of harmonious notes as they advance through the game.\n\nThis game is ideal for rehabilitation exercises, as it targets specific physical therapy goals by encouraging precise movements to build strength and stability. Balance Bubbles makes working on your balance an immersive and enjoyable experience, all while achieving important therapeutic outcomes.\n\n**(!) Balance Bubbles is part of the larger HoloMoves package, a subscription service offering a wide variety of exergames specifically designed for rehabilitation and physical therapy. Get a personal license and learn more at www.holomoves.nl/en**", "short_description": "Balance Bubbles is an innovative exergame that makes rehabilitation both fun and effective! Specifically designed for rehabilitation centers and physical therapy, this game focuses on helping players improve their static balance through controlled body movements. In Balance Bubbles, music bubbles float toward the player, who must lean left or right to pop them. Each bubble popped produces a unique sound, letting players craft a symphony of harmonious notes as they advance through the game."}]}, "developer_name": null, "developer_
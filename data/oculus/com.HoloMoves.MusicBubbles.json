id": "485041437679884", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/57569436_485041441013217_4515494555141559585_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VjPAMzds3bAQ7kNvwEUw02G&_nc_oc=AdoEwQAYhgA3Nvmw5Ec7Jh7a3VSqkkvHRer-U5625KLjYAyZSuSrLUlczrGiBOvAx5g&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNqImc3dBaozFGXwp7bJOwE6mPqfC17gFQNC1zVph_vyg&oe=6AE0B492"}, {"file_name": "Screenshot 2024-09-19 140044_1.png", "id": "875052024558662", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39035311_875052027891995_4491343046544077449_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=88lhHKE8WpkQ7kNvwG12Kx2&_nc_oc=AdqdAqXSQDGpsAwl-HEl-ky-oXdYq4C1UZo8uvZGJSnjipSF2W9964ZywbJoUxKWY_U&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNgwCsgwxN_-wU7RKpWE8nxx3X19-ol8J04S4RUFnBw2w&oe=6AE0BA9F"}, {"file_name": "Screenshot 2024-09-19 140104_1.png", "id": "1242115010275622", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974512_1242115016942288_5501748253489110433_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rCOE88Py5pkQ7kNvwFGgXrA&_nc_oc=AdrvOshxEMc5O0w2Zs0TR09VprYa_CUeXNbFrMDYrdXe986cdrUy4ZlPlXLZg9yYioQ&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOEURfbpDEGBGV8XskmJhFQItFM2c4V9h7BDTgYKpz7XA&oe=6AE099CE"}, {"file_name": "Screenshot 2024-09-19 140128_1.png", "id": "544846457927476", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974579_544846461260809_5296880946640316475_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CG5_bIsXrnsQ7kNvwEmNeTz&_nc_oc=AdprOVKHMfEagYeYggjeQS5l3UdH3HJ9Qt42Htqik3xwqvA0xKgj7Z70Tnf9GOJmEx0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPi6brcqIGqqnBI-9UZrmggnqg7jITXytZrlhSTY936mA&oe=6AE0C3B7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BalanceBubbles_Trailer_Short.00_00_20_07.Still001 (1).png", "id": "1089442505874767", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75258663_1089442509208100_1440755612146663990_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VLk7nWxOUOUQ7kNvwF6QHMP&_nc_oc=AdozNB3BmkWXw1MAmAQtf_Q9uCJ3nOFLaIFHug8brr2LO8C5eE8cBiA2SpGsp6-Tv9k&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNagaqCRfaySO86hrx_PEXEm5IXFtakyuff7hcE9fMq1A&oe=6AE09F89"}, "display_name": "HoloMoves: Balance Bubbles", "keywords": [], "long_description": "Balance Bubbles is an innovative exergame that makes rehabilitation both fun and effective! Specifically designed for rehabilitation centers and physical therapy, this game focuses on helping players improve their static balance through controlled body movements. In Balance Bubbles, music bubbles float toward the player, who must lean left or right to pop them. Each bubble popped produces a unique sound, letting players craft a symphony of harmonious notes as they advance through the game.\n\nThis game is ideal for rehabilitation exercises, as it targets specific physical therapy goals by encouraging precise movements to build strength and stability. Balance Bubbles makes working on your balance an immersive and enjoyable experience, all while achieving important therapeutic outcomes.\n\n**(!) Balance Bubbles is part of the larger HoloMoves package, a subscription service offering a wide variety of exergames specifically designed for rehabilitation and physical therapy. Get a personal license and learn more at www.holomoves.nl/en**", "short_description": "Balance Bubbles is an innovative exergame that makes rehabilitation both fun and effective! Specifically designed for rehabilitation centers and physical therapy, this game focuses on helping players improve their static balance through controlled body movements. In Balance Bubbles, music bubbles float toward the player, who must lean left or right to pop them. Each bubble popped produces a unique sound, letting players craft a symphony of harmonious notes as they advance through the game."}]}, "developer_name": null, "developer_
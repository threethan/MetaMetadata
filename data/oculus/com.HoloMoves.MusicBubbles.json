id": "485041437679884", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/57569436_485041441013217_4515494555141559585_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZljOjIFfgwEQ7kNvwEryAqu&_nc_oc=Adops7YnzV_EHoq5w0-cClAjoliBoUnRctabcmdGjmLtAUZN137-hXcK7ZucHX0z40w&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN6Jl9LWm8361JnEb252JcdgWk_A2Sq1vyN38w56GYwTg&oe=6AE20612"}, {"file_name": "Screenshot 2024-09-19 140044_1.png", "id": "875052024558662", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39035311_875052027891995_4491343046544077449_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=88lhHKE8WpkQ7kNvwEPqHPe&_nc_oc=Adq_l3eB2Z4etI-B4Mk680yAAQOtgGLHYbTh_x9G5vFHAihSnbN8dswHKX9HNRwtYmw&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNt2_THuGUu0CJ4WGBVRQdvqK033Z_kADF_ATTJPMxZqw&oe=6AE20C1F"}, {"file_name": "Screenshot 2024-09-19 140104_1.png", "id": "1242115010275622", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974512_1242115016942288_5501748253489110433_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZU9Kj4md8pYQ7kNvwH6amvm&_nc_oc=AdpKv3Eg8QsgjtA5xZOhZsmXrw3zxCec4lPfmBwAOpCF9zv1queINEXNrOZIwn7zmJU&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNTgY3E2QAoxpl-4iVc7F36rtR6fyr6R-c3VE-WU6qNYA&oe=6AE1EB4E"}, {"file_name": "Screenshot 2024-09-19 140128_1.png", "id": "544846457927476", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974579_544846461260809_5296880946640316475_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CG5_bIsXrnsQ7kNvwHYudFU&_nc_oc=Adpa_rPK4E_kMukImD4Gq7h3lccgtqS3OAfTB4A6xbLitGn_1ubaDTa_wA-xTNYDiIM&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOLnAWhYxPNKugoOx82NR-tc5-xZeFM2oZP7O6l0WMOvQ&oe=6AE21537"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BalanceBubbles_Trailer_Short.00_00_20_07.Still001 (1).png", "id": "1089442505874767", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75258663_1089442509208100_1440755612146663990_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VLk7nWxOUOUQ7kNvwE_EgeG&_nc_oc=AdroEY18HsrWZDA49PFino9YicFh5WdF18pUZDzzw3isKYC3s44bi0XOjHgVrvP8V3I&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNE2qJtk6PnP9BxLjMadRlo3RQdQMwRHJjt1szYZ1EEIQ&oe=6AE1F109"}, "display_name": "HoloMoves: Balance Bubbles", "keywords": [], "long_description": "Balance Bubbles is an innovative exergame that makes rehabilitation both fun and effective! Specifically designed for rehabilitation centers and physical therapy, this game focuses on helping players improve their static balance through controlled body movements. In Balance Bubbles, music bubbles float toward the player, who must lean left or right to pop them. Each bubble popped produces a unique sound, letting players craft a symphony of harmonious notes as they advance through the game.\n\nThis game is ideal for rehabilitation exercises, as it targets specific physical therapy goals by encouraging precise movements to build strength and stability. Balance Bubbles makes working on your balance an immersive and enjoyable experience, all while achieving important therapeutic outcomes.\n\n**(!) Balance Bubbles is part of the larger HoloMoves package, a subscription service offering a wide variety of exergames specifically designed for rehabilitation and physical therapy. Get a personal license and learn more at www.holomoves.nl/en**", "short_description": "Balance Bubbles is an innovative exergame that makes rehabilitation both fun and effective! Specifically designed for rehabilitation centers and physical therapy, this game focuses on helping players improve their static balance through controlled body movements. In Balance Bubbles, music bubbles float toward the player, who must lean left or right to pop them. Each bubble popped produces a unique sound, letting players craft a symphony of harmonious notes as they advance through the game."}]}, "developer_name": null, "developer_
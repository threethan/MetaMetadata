id": "485041437679884", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/57569436_485041441013217_4515494555141559585_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u46X7l8xHWwQ7kNvwGLzCHC&_nc_oc=AdrAL7j30eoFN-IV7XLuPRL1qebY9uqbGYtqNS9p3FB_LGzWhkH4w8o19qorE7BArEQ&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBx_XZP6Hz5ZXymGdNCY60C7ihkSuUQWRamq18KdtIkug&oe=6A60D312"}, {"file_name": "Screenshot 2024-09-19 140044_1.png", "id": "875052024558662", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39035311_875052027891995_4491343046544077449_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8n9z0hvxQ6sQ7kNvwGI6nPj&_nc_oc=AdrB5CsL9Yo8tQPk1D1PwDtDE0bugsaqyOL997IJX1cpCcRit9R8vUbNVVXy-eLknLY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCzOLLZeGZ760jAst7tyqhzwUNNfpItVw1CuIEKosqJTA&oe=6A60D91F"}, {"file_name": "Screenshot 2024-09-19 140104_1.png", "id": "1242115010275622", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974512_1242115016942288_5501748253489110433_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0hQmK9aHoncQ7kNvwFf5wO2&_nc_oc=Adob3im_D0cLx_SPIARGZerbpr4MmJ7VSpA6U6XgBXZyfWdBCo9uyMk5QvjxnXYFiMQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDQngkWC7Q92Dyx2BbSsHbnF-YFiuAiKfPgaOHRCR6CMA&oe=6A60B84E"}, {"file_name": "Screenshot 2024-09-19 140128_1.png", "id": "544846457927476", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974579_544846461260809_5296880946640316475_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cP2ydvUBL-QQ7kNvwHubWNa&_nc_oc=AdrPspLAeE_OLvrFefWd6o5jShXJsuyCYBYT4818PAHF0VEMOaT1ceiCIFPxvZGspao&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCH_I38CWTRQxtlbQYA8FfTxS_FxUK08yteSQx5APxVnw&oe=6A60A9F7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BalanceBubbles_Trailer_Short.00_00_20_07.Still001 (1).png", "id": "1089442505874767", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75258663_1089442509208100_1440755612146663990_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TgD3e1PkuWgQ7kNvwEr3pBn&_nc_oc=AdoWuWasrAFG81gi5Oiono2-v2dtH1DxAMptGYZ8uSiMF2SRcxpQ-fAiRdXsmbyldn8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAmqm2YSzvyh4HRrWWHal2scPwJxAv4t2xkzFRZ4PMpqg&oe=6A60BE09"}, "display_name": "HoloMoves: Balance Bubbles", "keywords": [], "long_description": "Balance Bubbles is an innovative exergame that makes rehabilitation both fun and effective! Specifically designed for rehabilitation centers and physical therapy, this game focuses on helping players improve their static balance through controlled body movements. In Balance Bubbles, music bubbles float toward the player, who must lean left or right to pop them. Each bubble popped produces a unique sound, letting players craft a symphony of harmonious notes as they advance through the game.\n\nThis game is ideal for rehabilitation exercises, as it targets specific physical therapy goals by encouraging precise movements to build strength and stability. Balance Bubbles makes working on your balance an immersive and enjoyable experience, all while achieving important therapeutic outcomes.\n\n**(!) Balance Bubbles is part of the larger HoloMoves package, a subscription service offering a wide variety of exergames specifically designed for rehabilitation and physical therapy. Get a personal license and learn more at www.holomoves.nl/en**", "short_description": "Balance Bubbles is an innovative exergame that makes rehabilitation both fun and effective! Specifically designed for rehabilitation centers and physical therapy, this game focuses on helping players improve their static balance through controlled body movements. In Balance Bubbles, music bubbles float toward the player, who must lean left or right to pop them. Each bubble popped produces a unique sound, letting players craft a symphony of harmonious notes as they advance through the game."}]}, "developer_name": null, "developer_
id": "485041437679884", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/57569436_485041441013217_4515494555141559585_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vmTl2HCU0JUQ7kNvwFJbBN2&_nc_oc=Adr4jfV37Ei41V3Q0j0FGwCgIwVGFLTOl_djH3KrkvlBBdPZrS5hsaP13EXa6OTStlc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOSMKpljdRa4Wi8Kcze5A2Onjk7f5rvtxdy5XPNGyjxDw&oe=6ACB9C92"}, {"file_name": "Screenshot 2024-09-19 140044_1.png", "id": "875052024558662", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39035311_875052027891995_4491343046544077449_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lq1kllOZn_8Q7kNvwEAZVqf&_nc_oc=AdoAv5ydeinttwmr3zzbogcbGyhdXdvWcve7HjfEMdQdEF129fbmx3bJKkEn0v8qlDM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP5C-LWQW9poJUPcWjdBrwPrGDsnBxrp6myqOYd3PMBKg&oe=6ACBA29F"}, {"file_name": "Screenshot 2024-09-19 140104_1.png", "id": "1242115010275622", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974512_1242115016942288_5501748253489110433_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tLQz8GJYzDsQ7kNvwFEoGWN&_nc_oc=Ado7E1o6aZIftOwUNZe7t9P0RspruPqHdofqz8XapKVlDLQSJWeopo7b97NYoddqO_U&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP7PJeQdiO5PvMBGk3keLERXWyIBz2eFNRlkhl3mZ8ewQ&oe=6ACBBA0E"}, {"file_name": "Screenshot 2024-09-19 140128_1.png", "id": "544846457927476", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974579_544846461260809_5296880946640316475_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=15lTXkGVkRoQ7kNvwGLMAYd&_nc_oc=AdqF_IO1YmuloPk9Z5E970LffRdrl77B1_HtyHrImc7IFShVh9jIAOxAv_cMM3Mu6aQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMHg5AvLjwjahVXtCLErjePC-ti9U5086C6PFrLBrvWXg&oe=6ACBABB7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BalanceBubbles_Trailer_Short.00_00_20_07.Still001 (1).png", "id": "1089442505874767", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75258663_1089442509208100_1440755612146663990_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9LlntL8_XykQ7kNvwGll-3U&_nc_oc=Adr5P8YoIMuQUZYYe3p_ztOgoe-07HfmdyuyBcEMNAZv51QUQ1E7boucqHvrCKBSYSM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNolTUqbXvSkm8qMf6P1ARr7lHcsqfglzODzb8tzW21vA&oe=6ACBBFC9"}, "display_name": "HoloMoves: Balance Bubbles", "keywords": [], "long_description": "Balance Bubbles is an innovative exergame that makes rehabilitation both fun and effective! Specifically designed for rehabilitation centers and physical therapy, this game focuses on helping players improve their static balance through controlled body movements. In Balance Bubbles, music bubbles float toward the player, who must lean left or right to pop them. Each bubble popped produces a unique sound, letting players craft a symphony of harmonious notes as they advance through the game.\n\nThis game is ideal for rehabilitation exercises, as it targets specific physical therapy goals by encouraging precise movements to build strength and stability. Balance Bubbles makes working on your balance an immersive and enjoyable experience, all while achieving important therapeutic outcomes.\n\n**(!) Balance Bubbles is part of the larger HoloMoves package, a subscription service offering a wide variety of exergames specifically designed for rehabilitation and physical therapy. Get a personal license and learn more at www.holomoves.nl/en**", "short_description": "Balance Bubbles is an innovative exergame that makes rehabilitation both fun and effective! Specifically designed for rehabilitation centers and physical therapy, this game focuses on helping players improve their static balance through controlled body movements. In Balance Bubbles, music bubbles float toward the player, who must lean left or right to pop them. Each bubble popped produces a unique sound, letting players craft a symphony of harmonious notes as they advance through the game."}]}, "developer_name": null, "developer_
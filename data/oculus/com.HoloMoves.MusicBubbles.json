id": "485041437679884", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/57569436_485041441013217_4515494555141559585_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R62la3nW_YEQ7kNvwGhMN2d&_nc_oc=AdrG5KOOemi1iR28IC-6RsK2apdE78_M5KV1Sj4HxiDEiKcqM3UJOEfjnTPgGj47tnc&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLIkfHRIQIXsySQlqdU8suMkTOEweLgJm-CZd-7KPd7vA&oe=6AA16C92"}, {"file_name": "Screenshot 2024-09-19 140044_1.png", "id": "875052024558662", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/39035311_875052027891995_4491343046544077449_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EEvoGwcw5G0Q7kNvwFlPEcp&_nc_oc=AdoSAZ3GqZd-LQRirOQe4wDWsvX840LcwjLCwqARJ0gsb4O-yVDEzQFuxn4QfHLpyRc&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLHZEdGpJETPdWwAh9jIV3UfFB3hQGskd_dfc6pXe_m6Q&oe=6AA1729F"}, {"file_name": "Screenshot 2024-09-19 140104_1.png", "id": "1242115010275622", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38974512_1242115016942288_5501748253489110433_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MsoGPPbrLPYQ7kNvwHdAoNi&_nc_oc=AdrztHXroTTOgoAaK6r_7lCJ4G5TOJk1Vx4m_8ARl_RVG5asgK724uY7Xm-1lCD5LWI&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIzMmTrRCuopKErDvRK69wJDSkn2kBMZR4Hncw-M0W9tw&oe=6AA151CE"}, {"file_name": "Screenshot 2024-09-19 140128_1.png", "id": "544846457927476", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38974579_544846461260809_5296880946640316475_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VMBW09sy1CEQ7kNvwEmDT4U&_nc_oc=AdrHlk-USHGa0Ptkfn46h_FWR-W-cGys0Tz1QUnUux0OY9k3BfBus73vjUCZwnGxWVM&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIXNK5TDPVZGuYhZOrAReNNKo7w7rGOHaU0m7mvlDe2hw&oe=6AA17BB7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BalanceBubbles_Trailer_Short.00_00_20_07.Still001 (1).png", "id": "1089442505874767", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/75258663_1089442509208100_1440755612146663990_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=05ChS02GPNQQ7kNvwHxOUAH&_nc_oc=AdpJ4vTCgdEMpLCjCqLmMdTPqLp0YhnVsysLr_U5Y-sglsV-a2vuPwjFGKlz9hFt02o&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLcqFz5zeMacvIk9XFH1-HVMn8RortdWSO06nmusdLskQ&oe=6AA15789"}, "display_name": "HoloMoves: Balance Bubbles", "keywords": [], "long_description": "Balance Bubbles is an innovative exergame that makes rehabilitation both fun and effective! Specifically designed for rehabilitation centers and physical therapy, this game focuses on helping players improve their static balance through controlled body movements. In Balance Bubbles, music bubbles float toward the player, who must lean left or right to pop them. Each bubble popped produces a unique sound, letting players craft a symphony of harmonious notes as they advance through the game.\n\nThis game is ideal for rehabilitation exercises, as it targets specific physical therapy goals by encouraging precise movements to build strength and stability. Balance Bubbles makes working on your balance an immersive and enjoyable experience, all while achieving important therapeutic outcomes.\n\n**(!) Balance Bubbles is part of the larger HoloMoves package, a subscription service offering a wide variety of exergames specifically designed for rehabilitation and physical therapy. Get a personal license and learn more at www.holomoves.nl/en**", "short_description": "Balance Bubbles is an innovative exergame that makes rehabilitation both fun and effective! Specifically designed for rehabilitation centers and physical therapy, this game focuses on helping players improve their static balance through controlled body movements. In Balance Bubbles, music bubbles float toward the player, who must lean left or right to pop them. Each bubble popped produces a unique sound, letting players craft a symphony of harmonious notes as they advance through the game."}]}, "developer_name": null, "developer_
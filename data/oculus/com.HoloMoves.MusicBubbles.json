id": "485041437679884", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/57569436_485041441013217_4515494555141559585_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9rYcF6VUw-kQ7kNvwGN4X_x&_nc_oc=AdpOuUlg2UiRPl73j_H3qbtIH7GRKWX81tvvDyUd0CE3esQIjj6sXcyrXeYevWjRJh4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHhyD62yKN1YpyCbX9_wRIwTVojj0YeX4XEbQ21yqdiAg&oe=6A734812"}, {"file_name": "Screenshot 2024-09-19 140044_1.png", "id": "875052024558662", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39035311_875052027891995_4491343046544077449_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YUvcSAZKRUAQ7kNvwHb8deF&_nc_oc=AdoWR0v--9o-teGXZ6ceSHrYVIzf28mnAy8pI55NYCQoeh7HHgxtafVOpPvntTyYf1E&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHuDszkbosr2ia7BSGTzcSziYibpJNhRKeyFP8k0rLw7A&oe=6A734E1F"}, {"file_name": "Screenshot 2024-09-19 140104_1.png", "id": "1242115010275622", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974512_1242115016942288_5501748253489110433_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BN1r6Z9seF8Q7kNvwF5xlAK&_nc_oc=AdrjLn4FjPnGxYfY0pFanxgF-TddGncAn6qnn4Sk-sHuM9wYCs7IanPKD-39BCcRHBE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGtFmKMBXGiPemrMQONAQmkKWzAkMxanQC0F-o0530Npw&oe=6A732D4E"}, {"file_name": "Screenshot 2024-09-19 140128_1.png", "id": "544846457927476", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974579_544846461260809_5296880946640316475_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nfN3atngjPQQ7kNvwENt0Tg&_nc_oc=AdphPyC--EMNns5RoF5w4mpWGhT8iFtdM2-7IHDJrfC-FipdchcOnxkzd7RZ8oPXDVk&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQErR_P6nN-DSrsruwbDsquisUcoZzTlFHaxBpZQibnlkg&oe=6A731EF7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BalanceBubbles_Trailer_Short.00_00_20_07.Still001 (1).png", "id": "1089442505874767", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75258663_1089442509208100_1440755612146663990_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fCP7nBDTxzIQ7kNvwHJoMBW&_nc_oc=AdoOQ6CC_6-DbVzlVZwQJpGUblOrWL3x4nWKKCWjopSiAEMuioCkav7S_EC1XAYNT7g&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGlSTw_VHp0oc8jntE5doLTs6H_tkwURWG9vbzWMMOAyw&oe=6A733309"}, "display_name": "HoloMoves: Balance Bubbles", "keywords": [], "long_description": "Balance Bubbles is an innovative exergame that makes rehabilitation both fun and effective! Specifically designed for rehabilitation centers and physical therapy, this game focuses on helping players improve their static balance through controlled body movements. In Balance Bubbles, music bubbles float toward the player, who must lean left or right to pop them. Each bubble popped produces a unique sound, letting players craft a symphony of harmonious notes as they advance through the game.\n\nThis game is ideal for rehabilitation exercises, as it targets specific physical therapy goals by encouraging precise movements to build strength and stability. Balance Bubbles makes working on your balance an immersive and enjoyable experience, all while achieving important therapeutic outcomes.\n\n**(!) Balance Bubbles is part of the larger HoloMoves package, a subscription service offering a wide variety of exergames specifically designed for rehabilitation and physical therapy. Get a personal license and learn more at www.holomoves.nl/en**", "short_description": "Balance Bubbles is an innovative exergame that makes rehabilitation both fun and effective! Specifically designed for rehabilitation centers and physical therapy, this game focuses on helping players improve their static balance through controlled body movements. In Balance Bubbles, music bubbles float toward the player, who must lean left or right to pop them. Each bubble popped produces a unique sound, letting players craft a symphony of harmonious notes as they advance through the game."}]}, "developer_name": null, "developer_
585_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jlobXKqoML4Q7kNvwGmzByM&_nc_oc=AdqPBaGhwiH5ZlVySCMkveBJmot6RYTEawEcpTFCCdgipAqq9XYl1aHR19qFOJHnMpE&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3Ugl25xinKHINo5gRX20q-JNgns2AOsN6-ozZ_yLkqgQ&oe=69F4B812"}, {"file_name": "Screenshot 2024-09-19 140044_1.png", "id": "875052024558662", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39035311_875052027891995_4491343046544077449_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bSCtY-5iQRsQ7kNvwEyhFKk&_nc_oc=Ado9OCSvm22rS-pRjgJrwSuirlW8zD1DjRQZkPMmiFkNJei75SPS2THvhD2APQZYzp8&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0AkUNze8CYhYESa0RhwMB1Jlr1bVDZsKFlR2q33Vw1-w&oe=69F4BE1F"}, {"file_name": "Screenshot 2024-09-19 140104_1.png", "id": "1242115010275622", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974512_1242115016942288_5501748253489110433_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AOYs7XWfRywQ7kNvwE22c6x&_nc_oc=Adre_t8nLkcaevjoTV0_x53pBqk1GNzHv_uFP9INz_ZDrxqi6sdCxwCzJYxDznrYWWM&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3gctF5rivvfLXgoLJkuIOvMsGOjK-64ZTz5NRPAkdP5g&oe=69F49D4E"}, {"file_name": "Screenshot 2024-09-19 140128_1.png", "id": "544846457927476", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974579_544846461260809_5296880946640316475_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7PNJOlnnqV0Q7kNvwHxxWgp&_nc_oc=AdomACT6xQyVBuzo-WAVEgjleAQxpl2YnIduFa741KBofEcNKCZKj86RV2h8eex1_XU&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1Lew1O08bIvCjnmu2ElFDfGhOEKkLMBxvFCHERM5naGQ&oe=69F4C737"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BalanceBubbles_Trailer_Short.00_00_20_07.Still001 (1).png", "id": "1089442505874767", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/75258663_1089442509208100_1440755612146663990_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r12TUmt_qScQ7kNvwEEgp1e&_nc_oc=AdqBthGtWMZmPsbKtSIaH9KaEwy4YOCEiID7Ll4vsXRObt8nYh89P_PToSNmlbg4OZc&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2pYiovWGgboaiqZJIiSchxMuXgAyayWnUM0bHBbFvZww&oe=69F4A309"}, "display_name": "HoloMoves: Balance Bubbles", "keywords": [], "long_description": "Balance Bubbles is an innovative exergame that makes rehabilitation both fun and effective! Specifically designed for rehabilitation centers and physical therapy, this game focuses on helping players improve their static balance through controlled body movements. In Balance Bubbles, music bubbles float toward the player, who must lean left or right to pop them. Each bubble popped produces a unique sound, letting players craft a symphony of harmonious notes as they advance through the game.\n\nThis game is ideal for rehabilitation exercises, as it targets specific physical therapy goals by encouraging precise movements to build strength and stability. Balance Bubbles makes working on your balance an immersive and enjoyable experience, all while achieving important therapeutic outcomes.\n\n**(!) Balance Bubbles is part of the larger HoloMoves package, a subscription service offering a wide variety of exergames specifically designed for rehabilitation and physical therapy. Get a personal license and learn more at www.holomoves.nl/en**", "short_description": "Balance Bubbles is an innovative exergame that makes rehabilitation both fun and effective! Specifically designed for rehabilitation centers and physical therapy, this game focuses on helping players improve their static balance through controlled body movements. In Balance Bubbles, music bubbles float toward the player, who must lean left or right to pop them. Each bubble popped produces a unique sound, letting players craft a symphony of harmonious notes as they advance through the game."}]}, "developer_name": null, "developer_privacy_policy_url": "https://holomoves.nl/en/privacy/", "developer_terms_of_service_url": null, "publisher_name": "HoloMoves
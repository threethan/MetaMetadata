585_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LHuDG3PaQ6QQ7kNvwFlRQAp&_nc_oc=AdofRDWryJdY8J6ZuoAmgpoQ_qx1FmLfRcOdprg8280UlFLz9IJfI6R_lhM7sVBBZIA&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3SgK_p7hKttf8bcKNruCJdE0jQPZpAZ7FxzUu1ZV-iLg&oe=69EF7212"}, {"file_name": "Screenshot 2024-09-19 140044_1.png", "id": "875052024558662", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39035311_875052027891995_4491343046544077449_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k_rAOKahELwQ7kNvwFRU15d&_nc_oc=AdrYW9XM8IzzdLWC7nPSUJhVmuNHVm9a1vZHlJGQztGv6aquoXfen2pQaV_Bq9jJoVg&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2HMWnSEhknulP3vnMVMojQ4aVMJuBX25hRlegTlOj7sw&oe=69EF781F"}, {"file_name": "Screenshot 2024-09-19 140104_1.png", "id": "1242115010275622", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974512_1242115016942288_5501748253489110433_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e5kgUxWipccQ7kNvwErdm6W&_nc_oc=AdrFaRX98nLu1ptzTq5AReu98jOXh_HM1e3tVbOUfH8Q0bim9LJwTJBPEyL9TF31VnQ&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af38dYJbSq0khdY46zgWcmmOzHvpBHBLYNWOVUGveRiMQQ&oe=69EF574E"}, {"file_name": "Screenshot 2024-09-19 140128_1.png", "id": "544846457927476", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974579_544846461260809_5296880946640316475_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-yZ_dDzTDlUQ7kNvwGkHcpx&_nc_oc=Adon4lkEhkj4vlw35TGBo31JN_HjjL5E_U27J2rqBGSebOnRv4FNYItE3Nnlwz8Tbuc&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af250pXOIM51ieT1zbB58aoW7P-3W07u1uybIklf3VLZ_g&oe=69EF8137"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BalanceBubbles_Trailer_Short.00_00_20_07.Still001 (1).png", "id": "1089442505874767", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/75258663_1089442509208100_1440755612146663990_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XgHTkd2gXIsQ7kNvwHQVyxo&_nc_oc=AdrxHqW_J2Jzcx-nzNoSSy7mQaIaWVkAnYxoleqT-nXqDsnUfFW3BHxmfr2dm8Bz980&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af36pzXOL04mAT-WXQX9xZDdT6VPcedvQbzhsLg5zgxDuw&oe=69EF5D09"}, "display_name": "HoloMoves: Balance Bubbles", "keywords": [], "long_description": "Balance Bubbles is an innovative exergame that makes rehabilitation both fun and effective! Specifically designed for rehabilitation centers and physical therapy, this game focuses on helping players improve their static balance through controlled body movements. In Balance Bubbles, music bubbles float toward the player, who must lean left or right to pop them. Each bubble popped produces a unique sound, letting players craft a symphony of harmonious notes as they advance through the game.\n\nThis game is ideal for rehabilitation exercises, as it targets specific physical therapy goals by encouraging precise movements to build strength and stability. Balance Bubbles makes working on your balance an immersive and enjoyable experience, all while achieving important therapeutic outcomes.\n\n**(!) Balance Bubbles is part of the larger HoloMoves package, a subscription service offering a wide variety of exergames specifically designed for rehabilitation and physical therapy. Get a personal license and learn more at www.holomoves.nl/en**", "short_description": "Balance Bubbles is an innovative exergame that makes rehabilitation both fun and effective! Specifically designed for rehabilitation centers and physical therapy, this game focuses on helping players improve their static balance through controlled body movements. In Balance Bubbles, music bubbles float toward the player, who must lean left or right to pop them. Each bubble popped produces a unique sound, letting players craft a symphony of harmonious notes as they advance through the game."}]}, "developer_name": null, "developer_privacy_policy_url": "https://holomoves.nl/en/privacy/", "developer_terms_of_service_url": null, "publisher_name": "HoloMoves
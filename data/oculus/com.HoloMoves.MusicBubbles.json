id": "485041437679884", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/57569436_485041441013217_4515494555141559585_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FWsetb9dpsAQ7kNvwGfYoA_&_nc_oc=AdrH6oTESa8_fJs2POI0kgmsrbgpNNG-VB4cMm5lPs-kqjALgYtZXPskYVW7IevKpZY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHURtPkbSEYYFVBmpSJJnfqkuIYj0bQ3ULj4h_gDVIqPA&oe=6A70A512"}, {"file_name": "Screenshot 2024-09-19 140044_1.png", "id": "875052024558662", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39035311_875052027891995_4491343046544077449_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3VV0E9snrP0Q7kNvwFkxWJk&_nc_oc=Adq4v-HtdcRGwVkeENVp61qGH6UesAuWN56Ht0WnRQUVvNe8w7nnbzMQKlhUIXOVlZ0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG2uxPJBp2rwY55EOnvkKKGSS90oZ0zEjqPciMUZ1a0PA&oe=6A70AB1F"}, {"file_name": "Screenshot 2024-09-19 140104_1.png", "id": "1242115010275622", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974512_1242115016942288_5501748253489110433_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vHLMrXSHPtAQ7kNvwFM9KgE&_nc_oc=AdpFUPRT8iCsF6gJdc6Vg56PC3wWzTRosRMUYDIQjLQ0U2AOKdp7x69-rJtpETrq30E&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGl5_Y513V-P24C3vTtGlW6TNvz63SAJm43RnmaH5-PxA&oe=6A708A4E"}, {"file_name": "Screenshot 2024-09-19 140128_1.png", "id": "544846457927476", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974579_544846461260809_5296880946640316475_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nfN3atngjPQQ7kNvwHaciUf&_nc_oc=AdpT3ch689PBhcZcXTwtEDJFAxM31czK6QW4pe0kbY6IwnKbIZREh-5ayLe57RHpZvA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH3l7sGClGjEYvHL4Ni6hEQk9ue56AK0t64fvTzZ34lIg&oe=6A707BF7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BalanceBubbles_Trailer_Short.00_00_20_07.Still001 (1).png", "id": "1089442505874767", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75258663_1089442509208100_1440755612146663990_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fCP7nBDTxzIQ7kNvwEtN8-m&_nc_oc=AdqWNl_oaBdQXyPnD8xcDOnz2-oHy7u1JlbSdiVXKDsYhl-sSkHvgNLvsiGHGHX9mMA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFhKIhSZTv6x99k-W9R5VI5Ca7xm23xZZXTMJUBnHWSQQ&oe=6A709009"}, "display_name": "HoloMoves: Balance Bubbles", "keywords": [], "long_description": "Balance Bubbles is an innovative exergame that makes rehabilitation both fun and effective! Specifically designed for rehabilitation centers and physical therapy, this game focuses on helping players improve their static balance through controlled body movements. In Balance Bubbles, music bubbles float toward the player, who must lean left or right to pop them. Each bubble popped produces a unique sound, letting players craft a symphony of harmonious notes as they advance through the game.\n\nThis game is ideal for rehabilitation exercises, as it targets specific physical therapy goals by encouraging precise movements to build strength and stability. Balance Bubbles makes working on your balance an immersive and enjoyable experience, all while achieving important therapeutic outcomes.\n\n**(!) Balance Bubbles is part of the larger HoloMoves package, a subscription service offering a wide variety of exergames specifically designed for rehabilitation and physical therapy. Get a personal license and learn more at www.holomoves.nl/en**", "short_description": "Balance Bubbles is an innovative exergame that makes rehabilitation both fun and effective! Specifically designed for rehabilitation centers and physical therapy, this game focuses on helping players improve their static balance through controlled body movements. In Balance Bubbles, music bubbles float toward the player, who must lean left or right to pop them. Each bubble popped produces a unique sound, letting players craft a symphony of harmonious notes as they advance through the game."}]}, "developer_name": null, "developer_
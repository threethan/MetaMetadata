id": "485041437679884", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/57569436_485041441013217_4515494555141559585_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FWsetb9dpsAQ7kNvwFMSBiL&_nc_oc=AdoJVICr5-DwJjsZQTznTlZaVVjOsiOEjnKbLscKITyKw-tzVlFgEPLCwUb6rK-gDr8&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFoAIoRfeTuP5kg9enJTxx4gylIXfJtQt_9OrDqdC4b4Q&oe=6A71F692"}, {"file_name": "Screenshot 2024-09-19 140044_1.png", "id": "875052024558662", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39035311_875052027891995_4491343046544077449_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YUvcSAZKRUAQ7kNvwHr0RUp&_nc_oc=AdodavI5mqL_PJ6WZbUxEEXi0yUMMZHg_gtyyViIvj6OjHaZoKnSfgUjbcp4J9R1sko&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFCHJcMYWXZFZ-Pf9Bq6sEZMoW7Da7ZqKN7pUuHT_fiiw&oe=6A71FC9F"}, {"file_name": "Screenshot 2024-09-19 140104_1.png", "id": "1242115010275622", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974512_1242115016942288_5501748253489110433_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vHLMrXSHPtAQ7kNvwGCJnn2&_nc_oc=AdoWHWtW16DMoNmJ67XiDWwvGCM7D7k3hYdEr7xIcaYob-jh8UUzPYiZaDjWc6s_sPk&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEnk4gZq25Hft3hb2t9uGuzAae5iNug-WVIIHqAV0HeTw&oe=6A71DBCE"}, {"file_name": "Screenshot 2024-09-19 140128_1.png", "id": "544846457927476", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974579_544846461260809_5296880946640316475_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nfN3atngjPQQ7kNvwFWxEzp&_nc_oc=Adoc9Sf-uR_UkvqADaJQKmEPcAmnzzuA4U2aFNSUxIpEKUc6Sc_51HdyykxRQxUlxe0&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHI2DNyOcvshz3vHXL_ucgK-nUD0nhdqfYlPCHjxKhC8g&oe=6A71CD77"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BalanceBubbles_Trailer_Short.00_00_20_07.Still001 (1).png", "id": "1089442505874767", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75258663_1089442509208100_1440755612146663990_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fCP7nBDTxzIQ7kNvwHgvZwJ&_nc_oc=AdqcenpOrpGr36CTmwoUTtzsSyH60WKKi5SyiGOmcheufIRpchRJLsSNS7IxB4G4MKs&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHZNgtBi8XB8zhzvjT4WJ2HQoYquMhRGn8hqGGtCjMniQ&oe=6A71E189"}, "display_name": "HoloMoves: Balance Bubbles", "keywords": [], "long_description": "Balance Bubbles is an innovative exergame that makes rehabilitation both fun and effective! Specifically designed for rehabilitation centers and physical therapy, this game focuses on helping players improve their static balance through controlled body movements. In Balance Bubbles, music bubbles float toward the player, who must lean left or right to pop them. Each bubble popped produces a unique sound, letting players craft a symphony of harmonious notes as they advance through the game.\n\nThis game is ideal for rehabilitation exercises, as it targets specific physical therapy goals by encouraging precise movements to build strength and stability. Balance Bubbles makes working on your balance an immersive and enjoyable experience, all while achieving important therapeutic outcomes.\n\n**(!) Balance Bubbles is part of the larger HoloMoves package, a subscription service offering a wide variety of exergames specifically designed for rehabilitation and physical therapy. Get a personal license and learn more at www.holomoves.nl/en**", "short_description": "Balance Bubbles is an innovative exergame that makes rehabilitation both fun and effective! Specifically designed for rehabilitation centers and physical therapy, this game focuses on helping players improve their static balance through controlled body movements. In Balance Bubbles, music bubbles float toward the player, who must lean left or right to pop them. Each bubble popped produces a unique sound, letting players craft a symphony of harmonious notes as they advance through the game."}]}, "developer_name": null, "developer_
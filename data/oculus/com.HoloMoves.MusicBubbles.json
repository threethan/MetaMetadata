id": "485041437679884", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/57569436_485041441013217_4515494555141559585_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HHXsqL4fhU4Q7kNvwGTzw50&_nc_oc=AdoCt6k1dBNnfwjktHu55bKotrKrXpzpS8KBflOx6a3BM43whF0d4c38BsbIeFAeOeU&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHTMR4SjzDZHbU-jgD9uzDM40sbeIt7TN3q49tWJYtp2Q&oe=6A8827D2"}, {"file_name": "Screenshot 2024-09-19 140044_1.png", "id": "875052024558662", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/39035311_875052027891995_4491343046544077449_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P8Kcb_OvkyIQ7kNvwGFWPxB&_nc_oc=AdrnLidb-6DLYGHqIS1WeONHUyFvDYWMSblZN0rrGEXpwvaKlmIIO5oNRoJchMRE740&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFiOFEPweAtwFm2f_PxD9Wn20Ez-qHvySycV8NsS98v2Q&oe=6A882DDF"}, {"file_name": "Screenshot 2024-09-19 140104_1.png", "id": "1242115010275622", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/38974512_1242115016942288_5501748253489110433_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e7wUZrbicroQ7kNvwEcHtEU&_nc_oc=AdprwHhwKTDQ90HpUrX5eBKphUWkDZ6MnGQB2zmYVv-McHSQcTMfc1o0A4GLvPc64vg&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFsfF8ld-BUuUGJeLH7Cgmmc8Qizwfw0B7EzMzNwECjSg&oe=6A88454E"}, {"file_name": "Screenshot 2024-09-19 140128_1.png", "id": "544846457927476", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/38974579_544846461260809_5296880946640316475_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l8TU4e6rHFsQ7kNvwFy3Adj&_nc_oc=AdpiM_RnhSu6oWmnZTzNyv24YmNxmnWs5FRMM2p4feAFD3pP67W8mHPw4mHrDlvEaHQ&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH4bqtIDPo9dGVs5EQbivEvu0BAl4qOWR-zEQ3euOulWw&oe=6A8836F7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BalanceBubbles_Trailer_Short.00_00_20_07.Still001 (1).png", "id": "1089442505874767", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/75258663_1089442509208100_1440755612146663990_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4BwDXXnMlJgQ7kNvwHULZJ-&_nc_oc=Adr97e-wKmSVi9gDP-Wv_nRERCp0jYYLfv7qmcsVQrWS7K6414bPRb4ofcszy-DvWZU&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFv8rzEQTvKp4JLI_Rn_LRN7YegNmWrCKwRVqU6px4O2A&oe=6A884B09"}, "display_name": "HoloMoves: Balance Bubbles", "keywords": [], "long_description": "Balance Bubbles is an innovative exergame that makes rehabilitation both fun and effective! Specifically designed for rehabilitation centers and physical therapy, this game focuses on helping players improve their static balance through controlled body movements. In Balance Bubbles, music bubbles float toward the player, who must lean left or right to pop them. Each bubble popped produces a unique sound, letting players craft a symphony of harmonious notes as they advance through the game.\n\nThis game is ideal for rehabilitation exercises, as it targets specific physical therapy goals by encouraging precise movements to build strength and stability. Balance Bubbles makes working on your balance an immersive and enjoyable experience, all while achieving important therapeutic outcomes.\n\n**(!) Balance Bubbles is part of the larger HoloMoves package, a subscription service offering a wide variety of exergames specifically designed for rehabilitation and physical therapy. Get a personal license and learn more at www.holomoves.nl/en**", "short_description": "Balance Bubbles is an innovative exergame that makes rehabilitation both fun and effective! Specifically designed for rehabilitation centers and physical therapy, this game focuses on helping players improve their static balance through controlled body movements. In Balance Bubbles, music bubbles float toward the player, who must lean left or right to pop them. Each bubble popped produces a unique sound, letting players craft a symphony of harmonious notes as they advance through the game."}]}, "developer_name": null, "developer_
id": "485041437679884", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/57569436_485041441013217_4515494555141559585_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3Vl2DDGxKWoQ7kNvwGpBrDX&_nc_oc=Adr6qfHlVmiw7wVVqqE_RgJlKHB158f96-Zo8_ewClhT8ktTQF2Y3JRk6ZL49QSqwTc&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIosDc977sR8Gvsxfk0ioSC-Z5BliNO14t1KyHwyBurmQ&oe=6AB68492"}, {"file_name": "Screenshot 2024-09-19 140044_1.png", "id": "875052024558662", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39035311_875052027891995_4491343046544077449_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2JQNeOAxypUQ7kNvwGr7fEH&_nc_oc=AdpRMo5f9ZKm2rbAW15wtoYMszcNu_I6AHBbEwFo98xT5fEHUjcgark-SHugS3ngzUA&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLzJCyrRF3bl3iCSr0Nsxnhqs4ODwWMDhP5gs-BnyIgsg&oe=6AB68A9F"}, {"file_name": "Screenshot 2024-09-19 140104_1.png", "id": "1242115010275622", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974512_1242115016942288_5501748253489110433_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2Xdli34LnkAQ7kNvwFkIXVg&_nc_oc=AdpJYd_nU1UoDGqUQunIfbh6hKL0DsydshH1BWq-5uc2IRJ7GttVLZr4dqRozU_ivUM&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI0c9CdNtWQl6c7oMXaTWCguXnFtletDXjQTQqifJ0qBA&oe=6AB669CE"}, {"file_name": "Screenshot 2024-09-19 140128_1.png", "id": "544846457927476", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974579_544846461260809_5296880946640316475_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0MUe6lj9pDkQ7kNvwHk7HJ1&_nc_oc=AdrCyfx9GxEle6gkpJWlqifTRo5PH_qvgp88T9961Bj95XeNZjoaWl89teyu6dtc2dw&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJknCQVYu1hpTRLHirsM-AL6bDKjytPCpeXCTC5dVTqaA&oe=6AB693B7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BalanceBubbles_Trailer_Short.00_00_20_07.Still001 (1).png", "id": "1089442505874767", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75258663_1089442509208100_1440755612146663990_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pbk5xYLGvnwQ7kNvwGtkrEh&_nc_oc=AdrKboSeGN4VzbautdMn6CK6EM4X2434qGBRnEdC8UULMjDYhe8I-4wPVV1Pj090yu0&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIll8x7tOJahs6PBE6lneX9BvWu39eCgFc6fnXb77_qdQ&oe=6AB66F89"}, "display_name": "HoloMoves: Balance Bubbles", "keywords": [], "long_description": "Balance Bubbles is an innovative exergame that makes rehabilitation both fun and effective! Specifically designed for rehabilitation centers and physical therapy, this game focuses on helping players improve their static balance through controlled body movements. In Balance Bubbles, music bubbles float toward the player, who must lean left or right to pop them. Each bubble popped produces a unique sound, letting players craft a symphony of harmonious notes as they advance through the game.\n\nThis game is ideal for rehabilitation exercises, as it targets specific physical therapy goals by encouraging precise movements to build strength and stability. Balance Bubbles makes working on your balance an immersive and enjoyable experience, all while achieving important therapeutic outcomes.\n\n**(!) Balance Bubbles is part of the larger HoloMoves package, a subscription service offering a wide variety of exergames specifically designed for rehabilitation and physical therapy. Get a personal license and learn more at www.holomoves.nl/en**", "short_description": "Balance Bubbles is an innovative exergame that makes rehabilitation both fun and effective! Specifically designed for rehabilitation centers and physical therapy, this game focuses on helping players improve their static balance through controlled body movements. In Balance Bubbles, music bubbles float toward the player, who must lean left or right to pop them. Each bubble popped produces a unique sound, letting players craft a symphony of harmonious notes as they advance through the game."}]}, "developer_name": null, "developer_
585_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s-USbaofSUQQ7kNvwGln3Gr&_nc_oc=AdrWFK2XubckxaOOdTJWePh-aUxbPqzztPzvUV6s2u5GGwi7bxHE3c9UBCUAJGN6yI4&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af64-KtpESWZ-N5TDJjxA0k7M_Hr6YlFdcwDeZGMnwT0dQ&oe=6A033892"}, {"file_name": "Screenshot 2024-09-19 140044_1.png", "id": "875052024558662", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39035311_875052027891995_4491343046544077449_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2vAYTc1lIqkQ7kNvwETqzbl&_nc_oc=Adov_21kOvCSvN-eL7krIgUGkmofyqoKpqpHT8v7pO_QjS54AD8tNjAQ9QlUlRiuQXM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4UpKuDe6576cAEUxcIDXVV_nWMdwzQUcI7ZNYigQuhxw&oe=6A033E9F"}, {"file_name": "Screenshot 2024-09-19 140104_1.png", "id": "1242115010275622", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974512_1242115016942288_5501748253489110433_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U2gw9veFgEcQ7kNvwHsIkVe&_nc_oc=AdpMupGUYGeWMiq95UuamZ2fc9JMoGidkA2ZbzLOOsbmfribw6K-AQBwwows57HWsxw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5q7Va0BGwPrgXxucLdw3LQpN4E0XGMTvjLn_QHfPF38Q&oe=6A031DCE"}, {"file_name": "Screenshot 2024-09-19 140128_1.png", "id": "544846457927476", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974579_544846461260809_5296880946640316475_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e4nN8QL_IRIQ7kNvwHtitXv&_nc_oc=Adows9JT0Opom2Flg6WkJa3fSK87gPtke0zlRoKFo5j4a-tqTSI444AuPHm636ZA2OQ&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af52J96mXH1OUmyl_rntw8VOBct6mVCtUfxoVfpUdURADw&oe=6A0347B7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BalanceBubbles_Trailer_Short.00_00_20_07.Still001 (1).png", "id": "1089442505874767", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75258663_1089442509208100_1440755612146663990_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u52WCd4Xr0AQ7kNvwGyg84t&_nc_oc=AdpZGin9TMfoEIYvuY2qykg0t1oBeY035VpqxkseWonl7_9_uyIBGnFkHMtumUoG5pE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6EqCGll4pyvYIfzEH_H6fWTFnR7iNzcp1TKFIzGX09Yw&oe=6A032389"}, "display_name": "HoloMoves: Balance Bubbles", "keywords": [], "long_description": "Balance Bubbles is an innovative exergame that makes rehabilitation both fun and effective! Specifically designed for rehabilitation centers and physical therapy, this game focuses on helping players improve their static balance through controlled body movements. In Balance Bubbles, music bubbles float toward the player, who must lean left or right to pop them. Each bubble popped produces a unique sound, letting players craft a symphony of harmonious notes as they advance through the game.\n\nThis game is ideal for rehabilitation exercises, as it targets specific physical therapy goals by encouraging precise movements to build strength and stability. Balance Bubbles makes working on your balance an immersive and enjoyable experience, all while achieving important therapeutic outcomes.\n\n**(!) Balance Bubbles is part of the larger HoloMoves package, a subscription service offering a wide variety of exergames specifically designed for rehabilitation and physical therapy. Get a personal license and learn more at www.holomoves.nl/en**", "short_description": "Balance Bubbles is an innovative exergame that makes rehabilitation both fun and effective! Specifically designed for rehabilitation centers and physical therapy, this game focuses on helping players improve their static balance through controlled body movements. In Balance Bubbles, music bubbles float toward the player, who must lean left or right to pop them. Each bubble popped produces a unique sound, letting players craft a symphony of harmonious notes as they advance through the game."}]}, "developer_name": null, "developer_privacy_policy_url": "https://holomoves.nl/en/privacy/", "developer_terms_of_service_url": null, "publisher_name": "HoloMoves
id": "485041437679884", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/57569436_485041441013217_4515494555141559585_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i9QRwLMlNGwQ7kNvwGsWea5&_nc_oc=Ado9qoYzHgulPEDWXNufA_BscopK2tCNpnXbkbtaB94BxZZaQaLS8tyqDg9N3LlNDrs&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH4WfR7J2UQtznczV_kPi90kQFGYkFOX1sksYHqclTk9A&oe=6A7B3112"}, {"file_name": "Screenshot 2024-09-19 140044_1.png", "id": "875052024558662", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39035311_875052027891995_4491343046544077449_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gc8cLPaWsikQ7kNvwE5lYen&_nc_oc=Adpy4kNPPCbUlqW5sMpY_C_b2XMp3iEvFumjlr3zXnQySlmueeOXYKCaldcN45tRBow&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFYdWpgaK7blsF9WCdltVGuTigAFVKTdHXWHwioX251UA&oe=6A7B371F"}, {"file_name": "Screenshot 2024-09-19 140104_1.png", "id": "1242115010275622", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974512_1242115016942288_5501748253489110433_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QJp7TDYEpvwQ7kNvwGAufqP&_nc_oc=Adrgq1W6WA4n1Nr801Cy1j0ZeIudJDfBfKhjx6wOWms5FSBA9STs16KmO6HFn12b1Sc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGRcvRpKG6PiKp0Us5qZwYGeE0ZNDM1iEiim57oTvINLA&oe=6A7B164E"}, {"file_name": "Screenshot 2024-09-19 140128_1.png", "id": "544846457927476", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974579_544846461260809_5296880946640316475_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EY0y_u1GX2gQ7kNvwGrQJaM&_nc_oc=AdqEvB5kvopm4GDrzsslGxRiyTJnG5iQAHgYr7-Wv-TdTIK7DHsiAhril38yiut2dYA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFQjXnIlEWsJx7Cce9_m6KXDrmwA8I7Qxx8S9mv5C4yKQ&oe=6A7B07F7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BalanceBubbles_Trailer_Short.00_00_20_07.Still001 (1).png", "id": "1089442505874767", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75258663_1089442509208100_1440755612146663990_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qf2UlrrG4zMQ7kNvwHYfT-h&_nc_oc=AdolEo0nSl-Ezay332kdIfw-OtWqkc0m0Uk5jNhy6CgGO7PxZbxFz3bhLCEVOGdsIDk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHx15Bq5mtaIE8ZTLq15uK5ml6J_dIWgMEbQO2Rs_5xGQ&oe=6A7B1C09"}, "display_name": "HoloMoves: Balance Bubbles", "keywords": [], "long_description": "Balance Bubbles is an innovative exergame that makes rehabilitation both fun and effective! Specifically designed for rehabilitation centers and physical therapy, this game focuses on helping players improve their static balance through controlled body movements. In Balance Bubbles, music bubbles float toward the player, who must lean left or right to pop them. Each bubble popped produces a unique sound, letting players craft a symphony of harmonious notes as they advance through the game.\n\nThis game is ideal for rehabilitation exercises, as it targets specific physical therapy goals by encouraging precise movements to build strength and stability. Balance Bubbles makes working on your balance an immersive and enjoyable experience, all while achieving important therapeutic outcomes.\n\n**(!) Balance Bubbles is part of the larger HoloMoves package, a subscription service offering a wide variety of exergames specifically designed for rehabilitation and physical therapy. Get a personal license and learn more at www.holomoves.nl/en**", "short_description": "Balance Bubbles is an innovative exergame that makes rehabilitation both fun and effective! Specifically designed for rehabilitation centers and physical therapy, this game focuses on helping players improve their static balance through controlled body movements. In Balance Bubbles, music bubbles float toward the player, who must lean left or right to pop them. Each bubble popped produces a unique sound, letting players craft a symphony of harmonious notes as they advance through the game."}]}, "developer_name": null, "developer_
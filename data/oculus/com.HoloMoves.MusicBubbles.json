id": "485041437679884", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/57569436_485041441013217_4515494555141559585_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KlsSmHz9GNoQ7kNvwFYdkQC&_nc_oc=AdrpJoAztQq4k4I_j6PDv6-8GZzASCV1kGIYocnYZpGmEyEXLrWLNtPhUS0wgTQN07U&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQK45TpXNdblEL7wRK-XhKck7zdw0uFC_VEyhfqwZFPmA&oe=6AF32992"}, {"file_name": "Screenshot 2024-09-19 140044_1.png", "id": "875052024558662", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39035311_875052027891995_4491343046544077449_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EwGYzpnKRYUQ7kNvwEHYujT&_nc_oc=Adrk0d_OxrDxu8c4-kf3Xo0uJOPZiKNCSTYP-HSiLFJL4ojmfpLBHNceDmtYvmiffDI&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQToZVtXJg3HJXtqFH8P3gCzHDJGR-IMeo3jZU3bjgk9cA&oe=6AF32F9F"}, {"file_name": "Screenshot 2024-09-19 140104_1.png", "id": "1242115010275622", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974512_1242115016942288_5501748253489110433_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tASK2-ZsRGsQ7kNvwEtklyM&_nc_oc=AdpfvbaZPSc56TtpEj7K8nMslX7Qk93RH-8O73wES0SMq3klB0jbIX2LOc6PEiubdL0&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRTNZxKY3C-Jco-XVIn503uGvT_LYweYGUB6aIyNOVbzw&oe=6AF3470E"}, {"file_name": "Screenshot 2024-09-19 140128_1.png", "id": "544846457927476", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974579_544846461260809_5296880946640316475_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eiPn6GtTNUwQ7kNvwFZPRbs&_nc_oc=AdqyzCUnWJNdJ-wLS7KMkOEFnz8Ple1vb5qr8O4ohS4SbQfslTo5ZNhU7RzDko0B4PQ&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSD_s6K7NPNQxypsf5ZYDOfTa8GbXEntBzjX2P36QZ7rA&oe=6AF338B7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BalanceBubbles_Trailer_Short.00_00_20_07.Still001 (1).png", "id": "1089442505874767", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75258663_1089442509208100_1440755612146663990_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aqHXzyJpNzsQ7kNvwG8xdom&_nc_oc=AdqMM_MNDpzG9EQSwkuNkyviUlTr6xXoLwWZOSKeAvUCP0Pg0-fe07AZShWfrt3KaPc&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSVIkJw0JHWO18Sq9aPxhQsNfCmESKhhxcFGvMyAr5AcQ&oe=6AF34CC9"}, "display_name": "HoloMoves: Balance Bubbles", "keywords": [], "long_description": "Balance Bubbles is an innovative exergame that makes rehabilitation both fun and effective! Specifically designed for rehabilitation centers and physical therapy, this game focuses on helping players improve their static balance through controlled body movements. In Balance Bubbles, music bubbles float toward the player, who must lean left or right to pop them. Each bubble popped produces a unique sound, letting players craft a symphony of harmonious notes as they advance through the game.\n\nThis game is ideal for rehabilitation exercises, as it targets specific physical therapy goals by encouraging precise movements to build strength and stability. Balance Bubbles makes working on your balance an immersive and enjoyable experience, all while achieving important therapeutic outcomes.\n\n**(!) Balance Bubbles is part of the larger HoloMoves package, a subscription service offering a wide variety of exergames specifically designed for rehabilitation and physical therapy. Get a personal license and learn more at www.holomoves.nl/en**", "short_description": "Balance Bubbles is an innovative exergame that makes rehabilitation both fun and effective! Specifically designed for rehabilitation centers and physical therapy, this game focuses on helping players improve their static balance through controlled body movements. In Balance Bubbles, music bubbles float toward the player, who must lean left or right to pop them. Each bubble popped produces a unique sound, letting players craft a symphony of harmonious notes as they advance through the game."}]}, "developer_name": null, "developer_
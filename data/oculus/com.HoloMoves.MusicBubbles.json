585_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s-USbaofSUQQ7kNvwEtigUj&_nc_oc=Ado56CI4eq3ExJJJ75SiKp5xvs4b9oqJEYWl8FAWKMYsdxMqCh3IB65RLQFHd0RbCFs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6hpccICPj8zokg3MNvBPwn6WSuiUN5XjzB7uuazcAYfA&oe=6A009592"}, {"file_name": "Screenshot 2024-09-19 140044_1.png", "id": "875052024558662", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39035311_875052027891995_4491343046544077449_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tyCCo3VGYLIQ7kNvwGE7-VX&_nc_oc=AdpswKjjU5VDY5n2Q89brRAUsZjp34v5l9b0vWDWyXbRtoasSwosoDfc52KN1hmWwt0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4LEqktmJuRxHp0-c5OB47iwjDtCoWyIL-V8Vmv7EgJYA&oe=6A009B9F"}, {"file_name": "Screenshot 2024-09-19 140104_1.png", "id": "1242115010275622", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974512_1242115016942288_5501748253489110433_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U2gw9veFgEcQ7kNvwEEm4vf&_nc_oc=AdqrI45MMxTxxLRAYBnHTwqB5PleD2c1ZATgDxlVFJ8q7YmQk-GoclKAdvQCE_V4oiQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af59DFGKLKJ35XPF4pBO67PB4kAnEGaRRnAuMYUm3_jH3g&oe=6A007ACE"}, {"file_name": "Screenshot 2024-09-19 140128_1.png", "id": "544846457927476", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974579_544846461260809_5296880946640316475_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aPWE_UP2KQEQ7kNvwEjqiBp&_nc_oc=Adr6fApkzfjGkOmsM_kIEoeMjdGPrzcQJbcByZtTWJs4PRmaStWOzidvHMZIvrilPS8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7Xb6NBDF82RP5SkBxyLuaCC4wCqjkbvBxxKLR9TJXB3g&oe=6A00A4B7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BalanceBubbles_Trailer_Short.00_00_20_07.Still001 (1).png", "id": "1089442505874767", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75258663_1089442509208100_1440755612146663990_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nhcEDdMGg0gQ7kNvwFx1lTa&_nc_oc=AdrHPYpOsC32WW0C1qQlMBmpbyDRMU6Wysg_MKzCWH9MpnwQoNlLPVomU8mCjOEX-hs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4P7T8aVhzsM6mMWl8KRqD-uXADEu0ipsjkQlVoJP818A&oe=6A008089"}, "display_name": "HoloMoves: Balance Bubbles", "keywords": [], "long_description": "Balance Bubbles is an innovative exergame that makes rehabilitation both fun and effective! Specifically designed for rehabilitation centers and physical therapy, this game focuses on helping players improve their static balance through controlled body movements. In Balance Bubbles, music bubbles float toward the player, who must lean left or right to pop them. Each bubble popped produces a unique sound, letting players craft a symphony of harmonious notes as they advance through the game.\n\nThis game is ideal for rehabilitation exercises, as it targets specific physical therapy goals by encouraging precise movements to build strength and stability. Balance Bubbles makes working on your balance an immersive and enjoyable experience, all while achieving important therapeutic outcomes.\n\n**(!) Balance Bubbles is part of the larger HoloMoves package, a subscription service offering a wide variety of exergames specifically designed for rehabilitation and physical therapy. Get a personal license and learn more at www.holomoves.nl/en**", "short_description": "Balance Bubbles is an innovative exergame that makes rehabilitation both fun and effective! Specifically designed for rehabilitation centers and physical therapy, this game focuses on helping players improve their static balance through controlled body movements. In Balance Bubbles, music bubbles float toward the player, who must lean left or right to pop them. Each bubble popped produces a unique sound, letting players craft a symphony of harmonious notes as they advance through the game."}]}, "developer_name": null, "developer_privacy_policy_url": "https://holomoves.nl/en/privacy/", "developer_terms_of_service_url": null, "publisher_name": "HoloMoves
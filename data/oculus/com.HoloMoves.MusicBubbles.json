id": "485041437679884", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/57569436_485041441013217_4515494555141559585_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9aVEdQiWQVAQ7kNvwGnCLKC&_nc_oc=AdpZvrbD45_SYJEM0q25kEOVlf3yC3R7-wt8o271icLOcJka3bYHyBAfSOgPdCdqMHo&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJd7BG1uGkjkPL2Vj1LVw6HCRZy_-pF0Je5xcjvRT8Suw&oe=6AAD4A12"}, {"file_name": "Screenshot 2024-09-19 140044_1.png", "id": "875052024558662", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39035311_875052027891995_4491343046544077449_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q6GNPcZddO0Q7kNvwEyqL-r&_nc_oc=AdoV_IdI4Afrwac-zRLP1Z-0--JEhcXbrSPK1pCAzwbbkqJt5RP8obVHPtVvHcJ9UkM&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLTGxIBhu8mnq-8vNAM7KTslU4A1N4mYOWq5pm13BNrnw&oe=6AAD501F"}, {"file_name": "Screenshot 2024-09-19 140104_1.png", "id": "1242115010275622", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974512_1242115016942288_5501748253489110433_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jenjYds2uz0Q7kNvwGgkEqF&_nc_oc=AdqFh-lPXbGF6zBFeqnMGZylX_afK9wMibDa5wEefAK5mUNez1Wiwcj3Tp1aRj1UXnI&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ6_AnCHX7_PrShl0eAZo4Rpa_8ZYEljeSbAUv95nbVuw&oe=6AAD2F4E"}, {"file_name": "Screenshot 2024-09-19 140128_1.png", "id": "544846457927476", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974579_544846461260809_5296880946640316475_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ICaFpCewB18Q7kNvwEMeJQk&_nc_oc=AdoCRvCfKoC8VbMYwXEUdQAPA5QlYgYqnXsLn16Ms-E1wHRPeilpQORJuu3dqjRnJDI&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK21FN5j74Mqr4YhGy2UPiwKS2AopNwEdw9kGzO-gGFzg&oe=6AAD5937"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BalanceBubbles_Trailer_Short.00_00_20_07.Still001 (1).png", "id": "1089442505874767", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75258663_1089442509208100_1440755612146663990_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jo255ZKPOFMQ7kNvwEwIH9-&_nc_oc=AdqxR78dt8Drg4AhkaPbKZSHm4XgWCRA9y88EmCGt13EJsuoO2i9GPMAcJLtt2DqeLo&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJbzCsXLRsjVSkkH4BI5hJ_0J04wjCuVg142Wyr15BwMw&oe=6AAD3509"}, "display_name": "HoloMoves: Balance Bubbles", "keywords": [], "long_description": "Balance Bubbles is an innovative exergame that makes rehabilitation both fun and effective! Specifically designed for rehabilitation centers and physical therapy, this game focuses on helping players improve their static balance through controlled body movements. In Balance Bubbles, music bubbles float toward the player, who must lean left or right to pop them. Each bubble popped produces a unique sound, letting players craft a symphony of harmonious notes as they advance through the game.\n\nThis game is ideal for rehabilitation exercises, as it targets specific physical therapy goals by encouraging precise movements to build strength and stability. Balance Bubbles makes working on your balance an immersive and enjoyable experience, all while achieving important therapeutic outcomes.\n\n**(!) Balance Bubbles is part of the larger HoloMoves package, a subscription service offering a wide variety of exergames specifically designed for rehabilitation and physical therapy. Get a personal license and learn more at www.holomoves.nl/en**", "short_description": "Balance Bubbles is an innovative exergame that makes rehabilitation both fun and effective! Specifically designed for rehabilitation centers and physical therapy, this game focuses on helping players improve their static balance through controlled body movements. In Balance Bubbles, music bubbles float toward the player, who must lean left or right to pop them. Each bubble popped produces a unique sound, letting players craft a symphony of harmonious notes as they advance through the game."}]}, "developer_name": null, "developer_
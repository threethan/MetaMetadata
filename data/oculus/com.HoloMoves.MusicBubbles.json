id": "485041437679884", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/57569436_485041441013217_4515494555141559585_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HHXsqL4fhU4Q7kNvwFvnJcV&_nc_oc=Adq_48mORsCHOTRY3BQqiGRu7krun5EGobyDBsrmTtwEf8tkVjhWgnY-dStwmBlvTJI&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFBXYIEEdeLv90da96ahPifa0BBTxwAVH4oOAsxuotSXQ&oe=6A86D652"}, {"file_name": "Screenshot 2024-09-19 140044_1.png", "id": "875052024558662", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39035311_875052027891995_4491343046544077449_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P8Kcb_OvkyIQ7kNvwH5W1j_&_nc_oc=AdpR9JWbKs7E_RSFxDjsiRetHaLbVtDWtzRsj5d9QzB3DPqJxJbMnO9SBsz7oBaRpwc&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHPSw4MoAG5yIV8-o-eHCHa_Nfd6PaPV_qDahEpL6vkAQ&oe=6A86DC5F"}, {"file_name": "Screenshot 2024-09-19 140104_1.png", "id": "1242115010275622", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974512_1242115016942288_5501748253489110433_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e7wUZrbicroQ7kNvwFfIJ2g&_nc_oc=AdqHQNOGcB4JnoWfwc3vB2Dqlplg3phI_CqLWI9deVKmgmzEauewZXnaOXdn43RBfp0&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHoI0eFmbli0drCyzu5pUGcl9iq01Q4ClpTPi3p6p6g-A&oe=6A86F3CE"}, {"file_name": "Screenshot 2024-09-19 140128_1.png", "id": "544846457927476", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974579_544846461260809_5296880946640316475_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=68klJY_GjeQQ7kNvwEfTNFq&_nc_oc=AdrwI_z6mtjJS4TSJdCnGMGL1GVBbekaemOqkpZoC_3jSjiUQM5jyl3ws0hzifHAwlE&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG7HrVeKXxTDXEkthxdm9Oz-3kY1pZCZjxbj_VM4QdaAA&oe=6A86E577"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BalanceBubbles_Trailer_Short.00_00_20_07.Still001 (1).png", "id": "1089442505874767", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75258663_1089442509208100_1440755612146663990_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ueLbiq5WjQwQ7kNvwHV5Wtq&_nc_oc=AdpacUUY-0733OqCN1tGLGQaKDkdv73j21xZu3xmCKstsgGgdPePyqKX7G3bepn3avA&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHk3xUX05k_9WDrwZ5zuBKS_NUsUnag7XPM3FRfMmu8eA&oe=6A86F989"}, "display_name": "HoloMoves: Balance Bubbles", "keywords": [], "long_description": "Balance Bubbles is an innovative exergame that makes rehabilitation both fun and effective! Specifically designed for rehabilitation centers and physical therapy, this game focuses on helping players improve their static balance through controlled body movements. In Balance Bubbles, music bubbles float toward the player, who must lean left or right to pop them. Each bubble popped produces a unique sound, letting players craft a symphony of harmonious notes as they advance through the game.\n\nThis game is ideal for rehabilitation exercises, as it targets specific physical therapy goals by encouraging precise movements to build strength and stability. Balance Bubbles makes working on your balance an immersive and enjoyable experience, all while achieving important therapeutic outcomes.\n\n**(!) Balance Bubbles is part of the larger HoloMoves package, a subscription service offering a wide variety of exergames specifically designed for rehabilitation and physical therapy. Get a personal license and learn more at www.holomoves.nl/en**", "short_description": "Balance Bubbles is an innovative exergame that makes rehabilitation both fun and effective! Specifically designed for rehabilitation centers and physical therapy, this game focuses on helping players improve their static balance through controlled body movements. In Balance Bubbles, music bubbles float toward the player, who must lean left or right to pop them. Each bubble popped produces a unique sound, letting players craft a symphony of harmonious notes as they advance through the game."}]}, "developer_name": null, "developer_
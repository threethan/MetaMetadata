id": "485041437679884", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/57569436_485041441013217_4515494555141559585_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lUz1dwQMvFwQ7kNvwHwHuJD&_nc_oc=Adqkwj0LjfF47tRQ3DT4XPYwHHFoiMo13s1B5jJOniS0hMChvT8tIhQMjyhLcf6_so8&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHj6DIwabUSFfdmCG50yF3v08syr4V51HcwEE00QVFsvg&oe=6A8ACAD2"}, {"file_name": "Screenshot 2024-09-19 140044_1.png", "id": "875052024558662", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39035311_875052027891995_4491343046544077449_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D13F-oAIPoQQ7kNvwHmNxA5&_nc_oc=AdoDh40bay3ysNI2VOyy5Fv9KV9AE5XE_CFbFEy7CtQy9ZxyR2mx0SBwcV5lJSHANEw&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFkwggRYxN8Ziq9uXr7Ft0n-8EmYy2pk7isRvDIobjCJA&oe=6A8AD0DF"}, {"file_name": "Screenshot 2024-09-19 140104_1.png", "id": "1242115010275622", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974512_1242115016942288_5501748253489110433_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=olVf-7lLayEQ7kNvwE1CXtH&_nc_oc=AdoeLht-tbLS38y4QaVOWr_bYo7HVs4dVqKFjhk0lLC1u5RClNSZ4pb1kybuohdOeF8&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHxIk_jFuzs3RmsAZviFNSoW2N92S8UkkLI0Ob8swqXyw&oe=6A8AE84E"}, {"file_name": "Screenshot 2024-09-19 140128_1.png", "id": "544846457927476", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/38974579_544846461260809_5296880946640316475_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l8TU4e6rHFsQ7kNvwH2nUoj&_nc_oc=Ado1BMUxu4CAg919bQIpesmowfu_Pa07mTq5ALaiLXqCJPkncZY-6VEoi6NTcyM9HMA&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHGmD7oAVMwAw72821X5j9qOOQtnjHkPiRWHI9hcSfXnQ&oe=6A8AD9F7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BalanceBubbles_Trailer_Short.00_00_20_07.Still001 (1).png", "id": "1089442505874767", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/75258663_1089442509208100_1440755612146663990_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4BwDXXnMlJgQ7kNvwER0_rO&_nc_oc=Adr3avLPRuaZb-Dwz8yrrDuvIIWviOz0sqahcS5w9CZjtN66UD5dKV9gkticvRn_GUY&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEDyoFahZBRB2EH2s05VPJvgVdrODnjZRp1Js7A7uXGLw&oe=6A8AEE09"}, "display_name": "HoloMoves: Balance Bubbles", "keywords": [], "long_description": "Balance Bubbles is an innovative exergame that makes rehabilitation both fun and effective! Specifically designed for rehabilitation centers and physical therapy, this game focuses on helping players improve their static balance through controlled body movements. In Balance Bubbles, music bubbles float toward the player, who must lean left or right to pop them. Each bubble popped produces a unique sound, letting players craft a symphony of harmonious notes as they advance through the game.\n\nThis game is ideal for rehabilitation exercises, as it targets specific physical therapy goals by encouraging precise movements to build strength and stability. Balance Bubbles makes working on your balance an immersive and enjoyable experience, all while achieving important therapeutic outcomes.\n\n**(!) Balance Bubbles is part of the larger HoloMoves package, a subscription service offering a wide variety of exergames specifically designed for rehabilitation and physical therapy. Get a personal license and learn more at www.holomoves.nl/en**", "short_description": "Balance Bubbles is an innovative exergame that makes rehabilitation both fun and effective! Specifically designed for rehabilitation centers and physical therapy, this game focuses on helping players improve their static balance through controlled body movements. In Balance Bubbles, music bubbles float toward the player, who must lean left or right to pop them. Each bubble popped produces a unique sound, letting players craft a symphony of harmonious notes as they advance through the game."}]}, "developer_name": null, "developer_
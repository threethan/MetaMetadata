id": "485041437679884", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/57569436_485041441013217_4515494555141559585_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R62la3nW_YEQ7kNvwHEGvXD&_nc_oc=AdqlNmK5mPcprS3tnCmNhEMHrGHkSoyt26KatymZIqKxh0DXB_xPbGJxgrogKYnwuj8&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJpXIJzPdMw8v2gVPlH66TR4HK9yJ1J0cphPDgMtPkXxw&oe=6AA01B12"}, {"file_name": "Screenshot 2024-09-19 140044_1.png", "id": "875052024558662", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/39035311_875052027891995_4491343046544077449_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QCoqJ9GXoSEQ7kNvwGleg9P&_nc_oc=Adqdvm3Me37gHlpXXWUheFogiBIG1QcS7TQVbcKZpHfjeqxmHV5HWH-KmCMGe_1y0Fs&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKb6nZ4cvouqUNenlCDUAzl-wSSu7hD4GeK9BFgIaUaIg&oe=6AA0211F"}, {"file_name": "Screenshot 2024-09-19 140104_1.png", "id": "1242115010275622", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38974512_1242115016942288_5501748253489110433_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MsoGPPbrLPYQ7kNvwHM26Yw&_nc_oc=AdrhJi5zKLT4RiV-MXdhfLs6UrGPVN8di5rdJlHjdOpYXjtMXDGtYsdTwIT1N7VtkX4&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL8qxgCbg1qZf5yQHDsEx84wmlE6YshdfXF4PXYxCjGcQ&oe=6AA0004E"}, {"file_name": "Screenshot 2024-09-19 140128_1.png", "id": "544846457927476", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38974579_544846461260809_5296880946640316475_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VMBW09sy1CEQ7kNvwG7DOg_&_nc_oc=AdowI8ZkY0y6b8EdQRaPfZG2l92bX-PyV2H_NVLBYlO5YShWJmjUMjOJCgkRJuQuCYM&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ0j4CZxA1eirDvC065Ys1pKhlTN410jMALnLCOibiIew&oe=6AA02A37"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BalanceBubbles_Trailer_Short.00_00_20_07.Still001 (1).png", "id": "1089442505874767", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/75258663_1089442509208100_1440755612146663990_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=05ChS02GPNQQ7kNvwFdTd0q&_nc_oc=AdrIqwn99l9iQRmXClfhSMpwYZndtGuQVlCIkWruYXzTKrpjTnXZte-wJnwqAK4EYR8&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIq6yFQud3WQL69ENK8wTD3WAuWBGwPsL_hCpQ0cS8krA&oe=6AA00609"}, "display_name": "HoloMoves: Balance Bubbles", "keywords": [], "long_description": "Balance Bubbles is an innovative exergame that makes rehabilitation both fun and effective! Specifically designed for rehabilitation centers and physical therapy, this game focuses on helping players improve their static balance through controlled body movements. In Balance Bubbles, music bubbles float toward the player, who must lean left or right to pop them. Each bubble popped produces a unique sound, letting players craft a symphony of harmonious notes as they advance through the game.\n\nThis game is ideal for rehabilitation exercises, as it targets specific physical therapy goals by encouraging precise movements to build strength and stability. Balance Bubbles makes working on your balance an immersive and enjoyable experience, all while achieving important therapeutic outcomes.\n\n**(!) Balance Bubbles is part of the larger HoloMoves package, a subscription service offering a wide variety of exergames specifically designed for rehabilitation and physical therapy. Get a personal license and learn more at www.holomoves.nl/en**", "short_description": "Balance Bubbles is an innovative exergame that makes rehabilitation both fun and effective! Specifically designed for rehabilitation centers and physical therapy, this game focuses on helping players improve their static balance through controlled body movements. In Balance Bubbles, music bubbles float toward the player, who must lean left or right to pop them. Each bubble popped produces a unique sound, letting players craft a symphony of harmonious notes as they advance through the game."}]}, "developer_name": null, "developer_
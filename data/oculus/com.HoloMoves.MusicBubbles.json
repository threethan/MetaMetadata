id": "485041437679884", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/57569436_485041441013217_4515494555141559585_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BFhiDltyUbIQ7kNvwEKEgB1&_nc_oc=AdrQTNBb8M6j0qFvijottxN7M6SVrQ_CAqAK5qV0LH-gMnh9kKEyXxSvEI1cLf-wlS8&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQARip2dzK8959I6juREv6Owb8CJtdIJE5sfRaLh5pTm_w&oe=6A525292"}, {"file_name": "Screenshot 2024-09-19 140044_1.png", "id": "875052024558662", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39035311_875052027891995_4491343046544077449_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n8z8Q6PAejYQ7kNvwFILHbk&_nc_oc=Adqz2Nw_aG_AUM5D0qBrgc3jGvPw-g9W87ROQlqCEesUhU1QFPNCr1XPFJQjRRkLhQw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA1CaTgBRMqxScKnxW-CWhYgTaN1oB3OtzBxISi0VKmcw&oe=6A52589F"}, {"file_name": "Screenshot 2024-09-19 140104_1.png", "id": "1242115010275622", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974512_1242115016942288_5501748253489110433_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=048pUG9xrzwQ7kNvwFATSn3&_nc_oc=AdoMHypHmhKyN9KPW94pP0nZtyz55VjuBBm-IkBu75-cuNLBJpE04SGWMHA-XQQADAY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB_vXp6Mytacg5TM0o5QXiie3koOig5lO1Pj36KtRjTvg&oe=6A5237CE"}, {"file_name": "Screenshot 2024-09-19 140128_1.png", "id": "544846457927476", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974579_544846461260809_5296880946640316475_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VkydbgGI4WwQ7kNvwE0COLY&_nc_oc=AdpQibkYBsPhy6DKhAdzHYZvF0Gb6doZlLMdxlVi2CWPdDmMD35DlXVjmUGm0r0zJtk&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDiIi4g-p4EmZQwE3khzlazm_WSuqn5Yh3PB_4TiFTpEQ&oe=6A5261B7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BalanceBubbles_Trailer_Short.00_00_20_07.Still001 (1).png", "id": "1089442505874767", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75258663_1089442509208100_1440755612146663990_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MvAfvI6vMP0Q7kNvwHmpRek&_nc_oc=Adqj99EwFGu6DRanvqaFzDaLwZJhMygM0BvjtGk3aEiTfR49H6zCTruTBPQq1MrUB4s&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCmlSPFc2xjMiDpK8-3XwNh3bcNR0SSCvOEtPWZBLfGfA&oe=6A523D89"}, "display_name": "HoloMoves: Balance Bubbles", "keywords": [], "long_description": "Balance Bubbles is an innovative exergame that makes rehabilitation both fun and effective! Specifically designed for rehabilitation centers and physical therapy, this game focuses on helping players improve their static balance through controlled body movements. In Balance Bubbles, music bubbles float toward the player, who must lean left or right to pop them. Each bubble popped produces a unique sound, letting players craft a symphony of harmonious notes as they advance through the game.\n\nThis game is ideal for rehabilitation exercises, as it targets specific physical therapy goals by encouraging precise movements to build strength and stability. Balance Bubbles makes working on your balance an immersive and enjoyable experience, all while achieving important therapeutic outcomes.\n\n**(!) Balance Bubbles is part of the larger HoloMoves package, a subscription service offering a wide variety of exergames specifically designed for rehabilitation and physical therapy. Get a personal license and learn more at www.holomoves.nl/en**", "short_description": "Balance Bubbles is an innovative exergame that makes rehabilitation both fun and effective! Specifically designed for rehabilitation centers and physical therapy, this game focuses on helping players improve their static balance through controlled body movements. In Balance Bubbles, music bubbles float toward the player, who must lean left or right to pop them. Each bubble popped produces a unique sound, letting players craft a symphony of harmonious notes as they advance through the game."}]}, "developer_name": null, "developer_
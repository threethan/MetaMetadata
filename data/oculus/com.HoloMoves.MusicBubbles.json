id": "485041437679884", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/57569436_485041441013217_4515494555141559585_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lzClBlNMCQMQ7kNvwFVhKQt&_nc_oc=AdqaPne0pdJYfXKYMD26Z7DdbC8COU-iill8CTBWXwHYAdaiZciOQUN7wHBlCkHAk1o&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGtvVz9oPUeGZVJW5My9NKzDPZNqaMypfq7koZOZXD2Ag&oe=6A843352"}, {"file_name": "Screenshot 2024-09-19 140044_1.png", "id": "875052024558662", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39035311_875052027891995_4491343046544077449_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Vnre0vxTPv8Q7kNvwGLTU75&_nc_oc=Adr4eDTv-as6NMOi77ReMtMbmwbF56Lb00K_Avj5dMq_iYcZUJeusSXDp6cGUsU8N84&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEAhDrn9-flScK4VXkOk4PnC3m6VsafbqZ3nXDYNNBMNA&oe=6A84395F"}, {"file_name": "Screenshot 2024-09-19 140104_1.png", "id": "1242115010275622", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974512_1242115016942288_5501748253489110433_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=86pj7NztdLEQ7kNvwGU_zWK&_nc_oc=AdqvrOWoXOIIvDD-v3F6TrS-53_H2YFs-mC9NHZRO1xRyT_aSq_0pSpiwEfQLB8d31Q&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF__8NQ4yniwV0SP1MFnDg3_UH-x6oXTlTd3hbfoXtrcw&oe=6A8450CE"}, {"file_name": "Screenshot 2024-09-19 140128_1.png", "id": "544846457927476", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974579_544846461260809_5296880946640316475_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=68klJY_GjeQQ7kNvwGwbNub&_nc_oc=AdoFCEglkjcBdMpWuBg8ifPziMYEXW7VD7-Xd3VayRgtnoCNrWzLWsXFkSW8afzLHvQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEfNoRN7NI8wA1mdTPDcpV2yK3HHmS8s4_UOCqMIyQIPA&oe=6A844277"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BalanceBubbles_Trailer_Short.00_00_20_07.Still001 (1).png", "id": "1089442505874767", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75258663_1089442509208100_1440755612146663990_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ueLbiq5WjQwQ7kNvwFwnRZa&_nc_oc=AdokQrVmEDs19HfQ1tFWRDY57GtLjc8bk4teqnVmG_RJQzFJURK_rZD0oQbOo3qzPKA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF29nJ30-fsJAHaRgM9HbAs8Fcg9GvSp3FCWtCXaV6Fiw&oe=6A845689"}, "display_name": "HoloMoves: Balance Bubbles", "keywords": [], "long_description": "Balance Bubbles is an innovative exergame that makes rehabilitation both fun and effective! Specifically designed for rehabilitation centers and physical therapy, this game focuses on helping players improve their static balance through controlled body movements. In Balance Bubbles, music bubbles float toward the player, who must lean left or right to pop them. Each bubble popped produces a unique sound, letting players craft a symphony of harmonious notes as they advance through the game.\n\nThis game is ideal for rehabilitation exercises, as it targets specific physical therapy goals by encouraging precise movements to build strength and stability. Balance Bubbles makes working on your balance an immersive and enjoyable experience, all while achieving important therapeutic outcomes.\n\n**(!) Balance Bubbles is part of the larger HoloMoves package, a subscription service offering a wide variety of exergames specifically designed for rehabilitation and physical therapy. Get a personal license and learn more at www.holomoves.nl/en**", "short_description": "Balance Bubbles is an innovative exergame that makes rehabilitation both fun and effective! Specifically designed for rehabilitation centers and physical therapy, this game focuses on helping players improve their static balance through controlled body movements. In Balance Bubbles, music bubbles float toward the player, who must lean left or right to pop them. Each bubble popped produces a unique sound, letting players craft a symphony of harmonious notes as they advance through the game."}]}, "developer_name": null, "developer_
id": "485041437679884", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/57569436_485041441013217_4515494555141559585_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-hws8IcHqQUQ7kNvwEygAiY&_nc_oc=Adp2wEKGmQh7F9IrX3BO6N3STyRtVNw4Gt-C0g4Hl6mZPL1PhDtypqtUuKNlMFOvHk0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT72KQuRyPtsckd7CxdqicjaAodr5H6iOuTQTa7sU5fgA&oe=6AEDE392"}, {"file_name": "Screenshot 2024-09-19 140044_1.png", "id": "875052024558662", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39035311_875052027891995_4491343046544077449_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ppcc-VZZsSAQ7kNvwENtrm8&_nc_oc=AdqnQeF4Fa1XkZQiW4k6wy3myTXiu-yrscm0DIzNLes2s_iHBxX2e94MV1FmYSGh1_4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSsodsT6oDiudfc9bt0AGQjQlakTinmGPqkvC208EaQgg&oe=6AEDE99F"}, {"file_name": "Screenshot 2024-09-19 140104_1.png", "id": "1242115010275622", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974512_1242115016942288_5501748253489110433_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GWY7xEOOvesQ7kNvwEDMhlX&_nc_oc=AdoSSLdKfkOGD0EYm81biYr9EPpiSXaCuUQgAKTSq_6gvXsOYBza6dmW15_266gTmhs&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSDNbFVYSFk0W8IvpIHWB83TUCF_Avvzz1BVbMdbiiA-w&oe=6AEE010E"}, {"file_name": "Screenshot 2024-09-19 140128_1.png", "id": "544846457927476", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974579_544846461260809_5296880946640316475_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9XOOGr6Wtz0Q7kNvwE70nS6&_nc_oc=Adpatp2oSBUe4Bt6RMpGS7RuJiEQwxOEs-mRK4rT1KuwLzt4I9OFSMzcLk3SgyacFcE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSnxk2btJg73o_fMi_Spz2cJBDIIsZNj2nFo6edjd7Biw&oe=6AEDF2B7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BalanceBubbles_Trailer_Short.00_00_20_07.Still001 (1).png", "id": "1089442505874767", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75258663_1089442509208100_1440755612146663990_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e2kio1CZLQgQ7kNvwFsVnOt&_nc_oc=AdpSiQjKonRYQ8HVpLDmQOAh-7pZAG5uyVnwJYJ_i0P0Ja545agu5R3BQpLR-zGc4EA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTL_N_PQxm_RssuT1hjbVvprTkN2wFeMrQ7l2CuTwZrGA&oe=6AEE06C9"}, "display_name": "HoloMoves: Balance Bubbles", "keywords": [], "long_description": "Balance Bubbles is an innovative exergame that makes rehabilitation both fun and effective! Specifically designed for rehabilitation centers and physical therapy, this game focuses on helping players improve their static balance through controlled body movements. In Balance Bubbles, music bubbles float toward the player, who must lean left or right to pop them. Each bubble popped produces a unique sound, letting players craft a symphony of harmonious notes as they advance through the game.\n\nThis game is ideal for rehabilitation exercises, as it targets specific physical therapy goals by encouraging precise movements to build strength and stability. Balance Bubbles makes working on your balance an immersive and enjoyable experience, all while achieving important therapeutic outcomes.\n\n**(!) Balance Bubbles is part of the larger HoloMoves package, a subscription service offering a wide variety of exergames specifically designed for rehabilitation and physical therapy. Get a personal license and learn more at www.holomoves.nl/en**", "short_description": "Balance Bubbles is an innovative exergame that makes rehabilitation both fun and effective! Specifically designed for rehabilitation centers and physical therapy, this game focuses on helping players improve their static balance through controlled body movements. In Balance Bubbles, music bubbles float toward the player, who must lean left or right to pop them. Each bubble popped produces a unique sound, letting players craft a symphony of harmonious notes as they advance through the game."}]}, "developer_name": null, "developer_
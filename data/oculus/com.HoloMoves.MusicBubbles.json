id": "485041437679884", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/57569436_485041441013217_4515494555141559585_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AvJUVBUuSC4Q7kNvwFUXat4&_nc_oc=AdrUSlawZbcLslE8PZwz8SeC3c_gYY_WplYzoajr460fdmFXgXv4oJKtJEGDprxsYh0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJH-6XvI-6cum51cOeeb6M8yu3O6wrTHOYQFvP_72B6cg&oe=6AA56112"}, {"file_name": "Screenshot 2024-09-19 140044_1.png", "id": "875052024558662", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39035311_875052027891995_4491343046544077449_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iopi8L8XbAcQ7kNvwHrKhkA&_nc_oc=AdoWMLZiXAknDk9WXsFunhbU9ZolOnsWjpAT_olchFsYMQJmp5xHu9bx3700rOq4kk8&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLmwnxOcalaibKI_rZij7C64dWSlmV_yn6clOggbKy94Q&oe=6AA5671F"}, {"file_name": "Screenshot 2024-09-19 140104_1.png", "id": "1242115010275622", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974512_1242115016942288_5501748253489110433_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jiBOHLvJQ_kQ7kNvwG4LtnX&_nc_oc=AdowN7nsymI9NCZYLOduQutpeFEymaUs-Kj4eE096Us3A-G9-trjFvzbbxOI52rtC34&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ2r8Qkpe9pq59QbNb4FJKA2WDLFpm_TVymCIqEccRkUw&oe=6AA5464E"}, {"file_name": "Screenshot 2024-09-19 140128_1.png", "id": "544846457927476", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974579_544846461260809_5296880946640316475_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gTf5M78GhkEQ7kNvwHNQZ7Y&_nc_oc=Adpvd4YB-NRawVRZxrE0AplmCQeJt8dUicT1NezTnzPZbcGGVsgSCbFjiuDwHIFpmVI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL-c8L-htJxqyzcKJ09fCIh4KASu4JzUvAerVoEIXfbiA&oe=6AA57037"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BalanceBubbles_Trailer_Short.00_00_20_07.Still001 (1).png", "id": "1089442505874767", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75258663_1089442509208100_1440755612146663990_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VgVtna7JXGMQ7kNvwH4C38y&_nc_oc=Adp0b1iRlL1zKyLiz5J5532_QMPrvQzcSa1dFZth-xGO6Lc272u4xWNmVysEx4ytSjc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJGx6ksWKLOIUViDpl2ZZBwDDH5o1qWfr2WH3eLW0W5LQ&oe=6AA54C09"}, "display_name": "HoloMoves: Balance Bubbles", "keywords": [], "long_description": "Balance Bubbles is an innovative exergame that makes rehabilitation both fun and effective! Specifically designed for rehabilitation centers and physical therapy, this game focuses on helping players improve their static balance through controlled body movements. In Balance Bubbles, music bubbles float toward the player, who must lean left or right to pop them. Each bubble popped produces a unique sound, letting players craft a symphony of harmonious notes as they advance through the game.\n\nThis game is ideal for rehabilitation exercises, as it targets specific physical therapy goals by encouraging precise movements to build strength and stability. Balance Bubbles makes working on your balance an immersive and enjoyable experience, all while achieving important therapeutic outcomes.\n\n**(!) Balance Bubbles is part of the larger HoloMoves package, a subscription service offering a wide variety of exergames specifically designed for rehabilitation and physical therapy. Get a personal license and learn more at www.holomoves.nl/en**", "short_description": "Balance Bubbles is an innovative exergame that makes rehabilitation both fun and effective! Specifically designed for rehabilitation centers and physical therapy, this game focuses on helping players improve their static balance through controlled body movements. In Balance Bubbles, music bubbles float toward the player, who must lean left or right to pop them. Each bubble popped produces a unique sound, letting players craft a symphony of harmonious notes as they advance through the game."}]}, "developer_name": null, "developer_
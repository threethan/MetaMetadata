id": "485041437679884", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/57569436_485041441013217_4515494555141559585_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r1JyLGOAu8MQ7kNvwE6hlST&_nc_oc=Adq1B1c68KGMk76XnNXRCaVruqSqVtKPaQdHoN4Pt73RNiQYmJLNlmR0JWWI9twizQA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKNKLAHYbIZX5iKPNIxOAW0Gh8y5vmOPQc0OxeaMowDDQ&oe=6A9D7812"}, {"file_name": "Screenshot 2024-09-19 140044_1.png", "id": "875052024558662", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39035311_875052027891995_4491343046544077449_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QCoqJ9GXoSEQ7kNvwEK5kj3&_nc_oc=Adq9r9msH3msuBhizuWehu7wT08yPdPpvjDJK4Q240uooAyXpVxhl-HjNSvZUEWm8FM&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLERrmK1fRAaoVHrdv8_OD6HZ4Kj_KzKmucs0_9DHsYLA&oe=6A9D7E1F"}, {"file_name": "Screenshot 2024-09-19 140104_1.png", "id": "1242115010275622", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974512_1242115016942288_5501748253489110433_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f32dD4BYYiwQ7kNvwGqbi66&_nc_oc=AdrETzeo8pYRSYwL1Kn9coEue0UTai0cltL2d3buD8fJBZtPi35nsaijuPdjn8PSXtg&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIi_H0R1KXJM5jliqQRsrk7R__L9wZUw5yiwIp_RQM08A&oe=6A9D5D4E"}, {"file_name": "Screenshot 2024-09-19 140128_1.png", "id": "544846457927476", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974579_544846461260809_5296880946640316475_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RoqFY4_T2g8Q7kNvwEiyhtA&_nc_oc=AdqI-owuByoz54TVhCkDaCBepoihAgCmeyTdspFzFkLWJGN7UgL0xPAKHr0WlWL_dFo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJnoMZtthDc1kcNZL3E94BoYvYtWq_cP6pavkvaDx4HKQ&oe=6A9D8737"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BalanceBubbles_Trailer_Short.00_00_20_07.Still001 (1).png", "id": "1089442505874767", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75258663_1089442509208100_1440755612146663990_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=09cCOLpBYrIQ7kNvwGqAQyZ&_nc_oc=AdrqDr15-L9z4XBxF2gQUSmPUqjwvZJSgWrkZwjLLH-HAYuvRZEgmKLqHbX4iiOTcJ4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIg2WgW81WxbS3tnQotD0Sit1ZsfJZGytFG8AGKG4nSSw&oe=6A9D6309"}, "display_name": "HoloMoves: Balance Bubbles", "keywords": [], "long_description": "Balance Bubbles is an innovative exergame that makes rehabilitation both fun and effective! Specifically designed for rehabilitation centers and physical therapy, this game focuses on helping players improve their static balance through controlled body movements. In Balance Bubbles, music bubbles float toward the player, who must lean left or right to pop them. Each bubble popped produces a unique sound, letting players craft a symphony of harmonious notes as they advance through the game.\n\nThis game is ideal for rehabilitation exercises, as it targets specific physical therapy goals by encouraging precise movements to build strength and stability. Balance Bubbles makes working on your balance an immersive and enjoyable experience, all while achieving important therapeutic outcomes.\n\n**(!) Balance Bubbles is part of the larger HoloMoves package, a subscription service offering a wide variety of exergames specifically designed for rehabilitation and physical therapy. Get a personal license and learn more at www.holomoves.nl/en**", "short_description": "Balance Bubbles is an innovative exergame that makes rehabilitation both fun and effective! Specifically designed for rehabilitation centers and physical therapy, this game focuses on helping players improve their static balance through controlled body movements. In Balance Bubbles, music bubbles float toward the player, who must lean left or right to pop them. Each bubble popped produces a unique sound, letting players craft a symphony of harmonious notes as they advance through the game."}]}, "developer_name": null, "developer_
id": "485041437679884", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/57569436_485041441013217_4515494555141559585_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lzClBlNMCQMQ7kNvwEibu_K&_nc_oc=AdqSn-OoI9udN-OvKb7CqBtdOKyt9TX9p1JPzP1kB5XgXKWHkJEs9tKJGnvDSvrczfM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEBymIosclyQDPih5X6pUV19w33KEUwYbYqrAfue1wDGw&oe=6A831A12"}, {"file_name": "Screenshot 2024-09-19 140044_1.png", "id": "875052024558662", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39035311_875052027891995_4491343046544077449_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Vnre0vxTPv8Q7kNvwEOJ9rP&_nc_oc=AdpRBdeoyX_hrpnr2k2G2vg9XxUlTGDlB0CPMjGozVM37dUQmg40DwgsYhOlkb67WCY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH4RUBzAPLKGslfDOoL-NdWLrVn5Pt-KharHZphPHoVUw&oe=6A82E7DF"}, {"file_name": "Screenshot 2024-09-19 140104_1.png", "id": "1242115010275622", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974512_1242115016942288_5501748253489110433_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=86pj7NztdLEQ7kNvwEUDMBf&_nc_oc=Adpiu7n6b4lw9HZXgLC5fyOCJlceeMG2qbVAhZX3y7TxMTti-DDvx0fMlxVKJghegn8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE1j1Z09_n6b0ANd6gxRRuX4Bav7jVJTtlgk3UAgp65AA&oe=6A82FF4E"}, {"file_name": "Screenshot 2024-09-19 140128_1.png", "id": "544846457927476", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974579_544846461260809_5296880946640316475_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4Pk-AABsgnAQ7kNvwFuCpM9&_nc_oc=Adq4nXORKEjzoPKT_3PHkalwoDqdc6ORMjf8CnYaebdGPWIAy8sSs9Fu55yCmLvEK8A&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHD6ErDQ_qP0ZzAubd0g6d5a8y2GFxHlZUkOmqRaz7zLA&oe=6A82F0F7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BalanceBubbles_Trailer_Short.00_00_20_07.Still001 (1).png", "id": "1089442505874767", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75258663_1089442509208100_1440755612146663990_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K0u8fYm-1H0Q7kNvwEyLsCR&_nc_oc=AdqrFGqsqhD9dTEeIHXbfh6FYYDiKK4vKFOa474igMh_q6njgbNQDnlVU6eX_olVvvI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE2WfnIhkfo9SeTtPtoxQnth-0lf4SKRDcfddGPnEZsOg&oe=6A830509"}, "display_name": "HoloMoves: Balance Bubbles", "keywords": [], "long_description": "Balance Bubbles is an innovative exergame that makes rehabilitation both fun and effective! Specifically designed for rehabilitation centers and physical therapy, this game focuses on helping players improve their static balance through controlled body movements. In Balance Bubbles, music bubbles float toward the player, who must lean left or right to pop them. Each bubble popped produces a unique sound, letting players craft a symphony of harmonious notes as they advance through the game.\n\nThis game is ideal for rehabilitation exercises, as it targets specific physical therapy goals by encouraging precise movements to build strength and stability. Balance Bubbles makes working on your balance an immersive and enjoyable experience, all while achieving important therapeutic outcomes.\n\n**(!) Balance Bubbles is part of the larger HoloMoves package, a subscription service offering a wide variety of exergames specifically designed for rehabilitation and physical therapy. Get a personal license and learn more at www.holomoves.nl/en**", "short_description": "Balance Bubbles is an innovative exergame that makes rehabilitation both fun and effective! Specifically designed for rehabilitation centers and physical therapy, this game focuses on helping players improve their static balance through controlled body movements. In Balance Bubbles, music bubbles float toward the player, who must lean left or right to pop them. Each bubble popped produces a unique sound, letting players craft a symphony of harmonious notes as they advance through the game."}]}, "developer_name": null, "developer_
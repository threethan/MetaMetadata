id": "485041437679884", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/57569436_485041441013217_4515494555141559585_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kjwjQdQjeOkQ7kNvwFahdDT&_nc_oc=AdptA4Ft9XiEflNDiBq6-BydSno2EwXFONd5fHYBdBjEVKe2WKH9U0st9rdE0JbLdi0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGhXz5IDhgyVD2ODmKajbLJCDzPF9eW_6H6tGOagw1wtg&oe=6A7F2592"}, {"file_name": "Screenshot 2024-09-19 140044_1.png", "id": "875052024558662", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39035311_875052027891995_4491343046544077449_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mQkrxF1HoBYQ7kNvwELwy-V&_nc_oc=AdosTNMmM5TsEzQsjYwR3NByvScHQaBNzye7SemMIB-Olnko-t5T5aM_Encaf4owjSI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGuq57MUtnPJ_BCZZ8iGthzwU1jUQI9JeQghQtaBUcWbA&oe=6A7F2B9F"}, {"file_name": "Screenshot 2024-09-19 140104_1.png", "id": "1242115010275622", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974512_1242115016942288_5501748253489110433_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oobaW7F1bRcQ7kNvwFT1ZEM&_nc_oc=AdpflnIW0pBFVO7K0Lt9_x7LrSMPLMWOzvqJy_JRv6eG-0ok1uhd6BEqmpVnbmcaAKg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFFgK2td-UTD7jKi0CdKVs2os9AFSvhSbgJzcUvJY84dw&oe=6A7F0ACE"}, {"file_name": "Screenshot 2024-09-19 140128_1.png", "id": "544846457927476", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974579_544846461260809_5296880946640316475_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4tozghl7GqoQ7kNvwGB9xEZ&_nc_oc=Ado_FbZPu0jPPkc0oe_cS1p62Lt-wQOtj3xEJKbOKCr_hmYaN5wxzQP5lGyeYqyBfqg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEPCXFrZwOsxf6BcDGevky0FQpl_rMVLiRrPm-i5bQQKw&oe=6A7EFC77"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BalanceBubbles_Trailer_Short.00_00_20_07.Still001 (1).png", "id": "1089442505874767", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75258663_1089442509208100_1440755612146663990_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qmU8gZsjFRUQ7kNvwGWIPEt&_nc_oc=AdpgC9vyPYr_0VvoKP61IHHaNZ09JZ2cmQHBTmUbNSHDcFYkF-6IfyxPBmZO7Tw_oho&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGPRbrlR7g52JUxZ23h3cvNVDO5pm-7ONtjuLj0AC86yQ&oe=6A7F1089"}, "display_name": "HoloMoves: Balance Bubbles", "keywords": [], "long_description": "Balance Bubbles is an innovative exergame that makes rehabilitation both fun and effective! Specifically designed for rehabilitation centers and physical therapy, this game focuses on helping players improve their static balance through controlled body movements. In Balance Bubbles, music bubbles float toward the player, who must lean left or right to pop them. Each bubble popped produces a unique sound, letting players craft a symphony of harmonious notes as they advance through the game.\n\nThis game is ideal for rehabilitation exercises, as it targets specific physical therapy goals by encouraging precise movements to build strength and stability. Balance Bubbles makes working on your balance an immersive and enjoyable experience, all while achieving important therapeutic outcomes.\n\n**(!) Balance Bubbles is part of the larger HoloMoves package, a subscription service offering a wide variety of exergames specifically designed for rehabilitation and physical therapy. Get a personal license and learn more at www.holomoves.nl/en**", "short_description": "Balance Bubbles is an innovative exergame that makes rehabilitation both fun and effective! Specifically designed for rehabilitation centers and physical therapy, this game focuses on helping players improve their static balance through controlled body movements. In Balance Bubbles, music bubbles float toward the player, who must lean left or right to pop them. Each bubble popped produces a unique sound, letting players craft a symphony of harmonious notes as they advance through the game."}]}, "developer_name": null, "developer_
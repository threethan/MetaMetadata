585_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7vLyPPtqftgQ7kNvwHRFSqL&_nc_oc=AdplvpRjK4mMgp-WQv-BhMeYAOS3j57G4nBR_WpyvbF6TubT89vcolu_q71eqFwqhns&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af48datM_S2LG4woYNpczTI_yNObDTy9hqm0QE-JoYDKZA&oe=6A203992"}, {"file_name": "Screenshot 2024-09-19 140044_1.png", "id": "875052024558662", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39035311_875052027891995_4491343046544077449_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I8fx52J8g1QQ7kNvwHcDGZc&_nc_oc=AdqnNekelj1rKx9HeccpKvPs-ktU07XpTd4yEHgH-UHoSurw3so29YLMnCzpWHRWfmQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4A0YtcYorG4LOaGdJ2HfIPjBpvhVJSMbG04iU7cjaCsg&oe=6A203F9F"}, {"file_name": "Screenshot 2024-09-19 140104_1.png", "id": "1242115010275622", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974512_1242115016942288_5501748253489110433_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3MMoWFOTKmQQ7kNvwFbBJnm&_nc_oc=Adq0hOweVHbdJR7IXZMWtCPmq-42mte87V4Tr4XGdhS_k85QEvzfd5xEkhw1ETN3qhg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7SEubAUjYYFnz29x8uSnBrLSpIzaxsUZbXchZ94oKuiQ&oe=6A201ECE"}, {"file_name": "Screenshot 2024-09-19 140128_1.png", "id": "544846457927476", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974579_544846461260809_5296880946640316475_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NVzHUZoFK8UQ7kNvwGxdmhl&_nc_oc=AdpdaR1dr8AbN87WQzERxB7jTkcPFKtdaiiTxmTS53B99IkSI7H49hUFk-rFsAcIeXg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4dtjKauASqDI7gvA-D7YaWzfHd2E9bT_FeuLAvf7OPWw&oe=6A2048B7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BalanceBubbles_Trailer_Short.00_00_20_07.Still001 (1).png", "id": "1089442505874767", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75258663_1089442509208100_1440755612146663990_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Qrlvh8OVHrIQ7kNvwFtZua6&_nc_oc=AdpvNCx-zO7KE8liwicRqWyawIy2MAnm-t1OuHRGqialKu9tr91XPFvvodlqjQJHzp0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7p-Pq4HFsGajbz_nbfZiJJREP51BPbz9SdOwZh9jsUFA&oe=6A202489"}, "display_name": "HoloMoves: Balance Bubbles", "keywords": [], "long_description": "Balance Bubbles is an innovative exergame that makes rehabilitation both fun and effective! Specifically designed for rehabilitation centers and physical therapy, this game focuses on helping players improve their static balance through controlled body movements. In Balance Bubbles, music bubbles float toward the player, who must lean left or right to pop them. Each bubble popped produces a unique sound, letting players craft a symphony of harmonious notes as they advance through the game.\n\nThis game is ideal for rehabilitation exercises, as it targets specific physical therapy goals by encouraging precise movements to build strength and stability. Balance Bubbles makes working on your balance an immersive and enjoyable experience, all while achieving important therapeutic outcomes.\n\n**(!) Balance Bubbles is part of the larger HoloMoves package, a subscription service offering a wide variety of exergames specifically designed for rehabilitation and physical therapy. Get a personal license and learn more at www.holomoves.nl/en**", "short_description": "Balance Bubbles is an innovative exergame that makes rehabilitation both fun and effective! Specifically designed for rehabilitation centers and physical therapy, this game focuses on helping players improve their static balance through controlled body movements. In Balance Bubbles, music bubbles float toward the player, who must lean left or right to pop them. Each bubble popped produces a unique sound, letting players craft a symphony of harmonious notes as they advance through the game."}]}, "developer_name": null, "developer_privacy_policy_url": "https://holomoves.nl/en/privacy/", "developer_terms_of_service_url": null, "publisher_name": "HoloMoves
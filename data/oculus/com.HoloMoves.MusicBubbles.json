id": "485041437679884", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/57569436_485041441013217_4515494555141559585_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BFhiDltyUbIQ7kNvwGAFcjB&_nc_oc=AdoJilGfyymfiOfTF1jH6x1pLqxLp3uZm58Sr_bR6qYtuAptkdTa9QWs58X6NTQ3xnA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAXMfFv6s0l-GTQ8LFaaztVuzAWCOUjNv0QXmu7eF8Qhw&oe=6A510112"}, {"file_name": "Screenshot 2024-09-19 140044_1.png", "id": "875052024558662", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39035311_875052027891995_4491343046544077449_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aQt6JZ0mFA0Q7kNvwFUZR99&_nc_oc=AdrwEsR7QnI8S2j0sm1xJjjIGYJgQE0nOZvi21LTDVnqlGrPquv7Bkqu8cFjeAkc4dI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBmDNnQsGpTZ4pH73hIoesQxxS_U3dQG7O6uUZ-DZ_OTw&oe=6A51071F"}, {"file_name": "Screenshot 2024-09-19 140104_1.png", "id": "1242115010275622", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974512_1242115016942288_5501748253489110433_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=048pUG9xrzwQ7kNvwHfkTun&_nc_oc=AdpSmuOhj6G8iGCc5iIj405tMOTetATz0mm2SVH0keY5O0y7rHCfQ7P74HhXJ2ZWeII&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCNdzq0vQPdABtXAEG_3IyMaCqLsj0nIHbqjdeYGfkZMQ&oe=6A50E64E"}, {"file_name": "Screenshot 2024-09-19 140128_1.png", "id": "544846457927476", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974579_544846461260809_5296880946640316475_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VkydbgGI4WwQ7kNvwH2t80a&_nc_oc=Ado6pjKlYcmiSNgIBn0gfPMUSJ68Vdvu1iQEe2cyvHimInv4GDmElDWgg-QA7sVt61Q&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA6isOfi_KZhRFEd7iURgvk_K6ILPOqTNhFgOV-mWEC6w&oe=6A511037"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BalanceBubbles_Trailer_Short.00_00_20_07.Still001 (1).png", "id": "1089442505874767", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75258663_1089442509208100_1440755612146663990_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MvAfvI6vMP0Q7kNvwEuND8c&_nc_oc=Adq-H16OZCnF6P6ZyT4cyQ9cb5NWocVkGvsqCTvbw8UQgOX3g_teQGAmyTchY21L3CE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDzGoJ4ugE4_T-OUCm9AM4aSxEhYryfH1tsX5Zn4dwT2A&oe=6A50EC09"}, "display_name": "HoloMoves: Balance Bubbles", "keywords": [], "long_description": "Balance Bubbles is an innovative exergame that makes rehabilitation both fun and effective! Specifically designed for rehabilitation centers and physical therapy, this game focuses on helping players improve their static balance through controlled body movements. In Balance Bubbles, music bubbles float toward the player, who must lean left or right to pop them. Each bubble popped produces a unique sound, letting players craft a symphony of harmonious notes as they advance through the game.\n\nThis game is ideal for rehabilitation exercises, as it targets specific physical therapy goals by encouraging precise movements to build strength and stability. Balance Bubbles makes working on your balance an immersive and enjoyable experience, all while achieving important therapeutic outcomes.\n\n**(!) Balance Bubbles is part of the larger HoloMoves package, a subscription service offering a wide variety of exergames specifically designed for rehabilitation and physical therapy. Get a personal license and learn more at www.holomoves.nl/en**", "short_description": "Balance Bubbles is an innovative exergame that makes rehabilitation both fun and effective! Specifically designed for rehabilitation centers and physical therapy, this game focuses on helping players improve their static balance through controlled body movements. In Balance Bubbles, music bubbles float toward the player, who must lean left or right to pop them. Each bubble popped produces a unique sound, letting players craft a symphony of harmonious notes as they advance through the game."}]}, "developer_name": null, "developer_
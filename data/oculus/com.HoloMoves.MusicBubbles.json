585_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TqCpAUj3Xp4Q7kNvwF7AY1k&_nc_oc=AdrgZyebqVqmthg225fM0mV657UytZR34ipn7V9sQQi7jCKOVzhL83xOjvZQZ2Vhsjo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCj6jdJ-fs3W9giRlPQ9TPPCBwuSZZQo171JjlrBdE3lA&oe=6A491812"}, {"file_name": "Screenshot 2024-09-19 140044_1.png", "id": "875052024558662", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39035311_875052027891995_4491343046544077449_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j8sNJTAQizMQ7kNvwEPhS9l&_nc_oc=AdppWuNM82uTjRcbV-1lEQ36radJr37_SDFVQNkWJ1BMGfZZYYx0tPygtp4k6jRO3z4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD3t5GoaWJ3jH177pfj_3jRADSNBB7RkGe3T9h6fPZdZQ&oe=6A491E1F"}, {"file_name": "Screenshot 2024-09-19 140104_1.png", "id": "1242115010275622", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974512_1242115016942288_5501748253489110433_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3uQRQJ38SDkQ7kNvwEdCPFA&_nc_oc=Adop7x50NTxM6rypHSYFW_sYDVCxTDOBmcdrGzHKkJb-LpggGZ2lOHnlMMD_tZIVFTs&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA_DmcLwTbx_g_GAb8Ux1sekTEwhO7oNK7Zr_p2JWUz3Q&oe=6A48FD4E"}, {"file_name": "Screenshot 2024-09-19 140128_1.png", "id": "544846457927476", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974579_544846461260809_5296880946640316475_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vN1lq78-6MsQ7kNvwHZ9I3z&_nc_oc=Adoo9mk1yvTRRow5OmVyRpeIAn2U-FA05AuTBpDpMDZ0e0wt7AoJVA9lZAlTjrvuA-M&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAKSHm5jUMaShROo-dDMgF4aeP7zXpDSoIvsoehcoBoDQ&oe=6A492737"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BalanceBubbles_Trailer_Short.00_00_20_07.Still001 (1).png", "id": "1089442505874767", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75258663_1089442509208100_1440755612146663990_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tS5FjhaFsqMQ7kNvwHyFE_w&_nc_oc=AdqrEGj_Zfw1geCdGFIqJ6FHrBL9-TjE94mt3sdN6qG8wOGRb6a6ST1mg8YjOCsHG4o&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA_sqrlL02tnMerOeROKvgEJBOlsszIspq3q4bYTQ0-qQ&oe=6A490309"}, "display_name": "HoloMoves: Balance Bubbles", "keywords": [], "long_description": "Balance Bubbles is an innovative exergame that makes rehabilitation both fun and effective! Specifically designed for rehabilitation centers and physical therapy, this game focuses on helping players improve their static balance through controlled body movements. In Balance Bubbles, music bubbles float toward the player, who must lean left or right to pop them. Each bubble popped produces a unique sound, letting players craft a symphony of harmonious notes as they advance through the game.\n\nThis game is ideal for rehabilitation exercises, as it targets specific physical therapy goals by encouraging precise movements to build strength and stability. Balance Bubbles makes working on your balance an immersive and enjoyable experience, all while achieving important therapeutic outcomes.\n\n**(!) Balance Bubbles is part of the larger HoloMoves package, a subscription service offering a wide variety of exergames specifically designed for rehabilitation and physical therapy. Get a personal license and learn more at www.holomoves.nl/en**", "short_description": "Balance Bubbles is an innovative exergame that makes rehabilitation both fun and effective! Specifically designed for rehabilitation centers and physical therapy, this game focuses on helping players improve their static balance through controlled body movements. In Balance Bubbles, music bubbles float toward the player, who must lean left or right to pop them. Each bubble popped produces a unique sound, letting players craft a symphony of harmonious notes as they advance through the game."}]}, "developer_name": null, "developer_privacy_policy_url": "https://holomoves.nl/en/privacy/", "developer_terms_of_service_url": null, "publisher_name": "HoloMoves
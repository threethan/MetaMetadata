id": "485041437679884", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/57569436_485041441013217_4515494555141559585_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2-caHGImKisQ7kNvwFILE7a&_nc_oc=AdrshxwKFJzY2uk7fNvfRIVq5stkoHk9LMNBDiiRpx4P2eQVPsiSx9qVziIhSbyzCIs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK3h6pjuSzaC_J4z-ljap0oL6RmtE0snAI-2ZmareX2Hg&oe=6A986A52"}, {"file_name": "Screenshot 2024-09-19 140044_1.png", "id": "875052024558662", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39035311_875052027891995_4491343046544077449_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CG8BrD0C_OUQ7kNvwGhM_Yk&_nc_oc=Adq3kfnwrHRsukwrN8Gms-84PEcQgZz3-kgQlc10ovOelkdIl6cMX5KNGVuXuivYqXY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL0ZUQ7RyE8DVaCyyGehmJ7uPscLhXNLVsIJ5fi0Ea4Ow&oe=6A98381F"}, {"file_name": "Screenshot 2024-09-19 140104_1.png", "id": "1242115010275622", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974512_1242115016942288_5501748253489110433_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Zg4OLN_sn6IQ7kNvwHYfkWa&_nc_oc=AdrDt3WBp50LQg0vUtw9wZxDpn18XxpS67nFP_ywvT4BS52VlqDXhICCNkF71msWG78&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKLPpXTDD3Gy7yBSFIlEeTsdRalQ6tU2o0tBhNgVFEx9w&oe=6A984F8E"}, {"file_name": "Screenshot 2024-09-19 140128_1.png", "id": "544846457927476", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974579_544846461260809_5296880946640316475_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JrOG-sPJsQ8Q7kNvwF6MLTR&_nc_oc=AdrNhYQQykTSOn0cz1l_iIpCs1aj3ekIyoF1YucuKCoGwKdnsHKYAsYJ_uOLwIn0ZEI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJrfHwUMbjqc21txzUvuzhLT_cK9Mgs8NC3KP3wAOIhkw&oe=6A984137"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BalanceBubbles_Trailer_Short.00_00_20_07.Still001 (1).png", "id": "1089442505874767", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75258663_1089442509208100_1440755612146663990_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EYyEQ4GckMUQ7kNvwHcA0nG&_nc_oc=AdpZyxHMh84k_CqmZ2hpeYxo-AlSwLwEvN4o8nzKJHWsYfpkRB-LaxoZsqFEaDJ33dQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIb-SzcxB3N5M7r4ZIj2bmXh1NFVa5tazsXSIczsdkSWA&oe=6A985549"}, "display_name": "HoloMoves: Balance Bubbles", "keywords": [], "long_description": "Balance Bubbles is an innovative exergame that makes rehabilitation both fun and effective! Specifically designed for rehabilitation centers and physical therapy, this game focuses on helping players improve their static balance through controlled body movements. In Balance Bubbles, music bubbles float toward the player, who must lean left or right to pop them. Each bubble popped produces a unique sound, letting players craft a symphony of harmonious notes as they advance through the game.\n\nThis game is ideal for rehabilitation exercises, as it targets specific physical therapy goals by encouraging precise movements to build strength and stability. Balance Bubbles makes working on your balance an immersive and enjoyable experience, all while achieving important therapeutic outcomes.\n\n**(!) Balance Bubbles is part of the larger HoloMoves package, a subscription service offering a wide variety of exergames specifically designed for rehabilitation and physical therapy. Get a personal license and learn more at www.holomoves.nl/en**", "short_description": "Balance Bubbles is an innovative exergame that makes rehabilitation both fun and effective! Specifically designed for rehabilitation centers and physical therapy, this game focuses on helping players improve their static balance through controlled body movements. In Balance Bubbles, music bubbles float toward the player, who must lean left or right to pop them. Each bubble popped produces a unique sound, letting players craft a symphony of harmonious notes as they advance through the game."}]}, "developer_name": null, "developer_
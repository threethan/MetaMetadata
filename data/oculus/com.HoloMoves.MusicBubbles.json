id": "485041437679884", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/57569436_485041441013217_4515494555141559585_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O8i2vC-CqGQQ7kNvwHEr2dX&_nc_oc=AdrlDgoxNLIMCWPQi0kjucGvN9HLSD6J_T7nxv4bcf_geruT2xOsiLmivZk1XANT8zc&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHGnYONYON7MIduViVOa41SnYE2curI63fvA2-JDtSl2g&oe=6A92B3D2"}, {"file_name": "Screenshot 2024-09-19 140044_1.png", "id": "875052024558662", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39035311_875052027891995_4491343046544077449_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3xwR1tB25G8Q7kNvwF8wssP&_nc_oc=Adp2CjQQ9PyRfDBemWinohl9ZCokwls9vk8mJHv8rCrVl4-S4iLPuLOqlTnRlqE-d7o&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF3tlgI4U97x_5RPJvtrMNxwZz9ZHfwycWgnZ6uN3ThFQ&oe=6A92B9DF"}, {"file_name": "Screenshot 2024-09-19 140104_1.png", "id": "1242115010275622", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974512_1242115016942288_5501748253489110433_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o64dvw3GsacQ7kNvwFUFQWK&_nc_oc=Adr2h4V2ou0q2kXWYzCRoiPzqZU_Jk3wHjudHyP6FDDqOznVET7I-xM6_8g2VuqrLSk&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFi0stC6GgWeZY_oRDnJzCnDX-1SZXH7Sfig7iYhqnwow&oe=6A92D14E"}, {"file_name": "Screenshot 2024-09-19 140128_1.png", "id": "544846457927476", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974579_544846461260809_5296880946640316475_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sha5LILi9Q0Q7kNvwF0wsb7&_nc_oc=Ado4Ug0pbLloe66QQaRpyd4fFSl4zugOzlmc5vbOdD6JdNrgrFg4g7WF3EWtlPV-UHg&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFg3-POPbYdMYGVfl0fL3jq89z6AZHtp0UW-NIUEC9JNQ&oe=6A92C2F7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BalanceBubbles_Trailer_Short.00_00_20_07.Still001 (1).png", "id": "1089442505874767", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75258663_1089442509208100_1440755612146663990_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iudgCMtetioQ7kNvwFoeCEv&_nc_oc=AdrN1WS8Rx8cuKHBra66wARzETdZtTM1e7Z9h_9t2M4JVrE7xZfZFPiUSeLuaZzmL8s&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFnzb7aVtUFMwCuMFW4YEsCehJ7I-zLHk_9svoIxr_NzA&oe=6A92D709"}, "display_name": "HoloMoves: Balance Bubbles", "keywords": [], "long_description": "Balance Bubbles is an innovative exergame that makes rehabilitation both fun and effective! Specifically designed for rehabilitation centers and physical therapy, this game focuses on helping players improve their static balance through controlled body movements. In Balance Bubbles, music bubbles float toward the player, who must lean left or right to pop them. Each bubble popped produces a unique sound, letting players craft a symphony of harmonious notes as they advance through the game.\n\nThis game is ideal for rehabilitation exercises, as it targets specific physical therapy goals by encouraging precise movements to build strength and stability. Balance Bubbles makes working on your balance an immersive and enjoyable experience, all while achieving important therapeutic outcomes.\n\n**(!) Balance Bubbles is part of the larger HoloMoves package, a subscription service offering a wide variety of exergames specifically designed for rehabilitation and physical therapy. Get a personal license and learn more at www.holomoves.nl/en**", "short_description": "Balance Bubbles is an innovative exergame that makes rehabilitation both fun and effective! Specifically designed for rehabilitation centers and physical therapy, this game focuses on helping players improve their static balance through controlled body movements. In Balance Bubbles, music bubbles float toward the player, who must lean left or right to pop them. Each bubble popped produces a unique sound, letting players craft a symphony of harmonious notes as they advance through the game."}]}, "developer_name": null, "developer_
585_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=THiXshVQGCAQ7kNvwFN8hi5&_nc_oc=AdrMmgkjnVuGfDfWPQcaxSOsRpvlR8n2FPD-25NQfMV1C-vCON8XyxG1Ph0tULDCxqM&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2TGa_tCbQoJn-vah98HmwQJ75DN-8rVj5OeZRl3HnI6w&oe=69E78912"}, {"file_name": "Screenshot 2024-09-19 140044_1.png", "id": "875052024558662", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/39035311_875052027891995_4491343046544077449_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kZZoviJaPJsQ7kNvwFJ1z-8&_nc_oc=AdoxI8iXNcVCGuRwDbiCQ6dYL_LoPgVgrTzdYv0xLIL7ZtDjuTO-xKUBkHNOFem73T4&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1RaqGv2w7da5WVem8PmCy-h7QqnO4UA0G9F_FttCeA1g&oe=69E78F1F"}, {"file_name": "Screenshot 2024-09-19 140104_1.png", "id": "1242115010275622", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38974512_1242115016942288_5501748253489110433_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dv_fzikZRCIQ7kNvwEFsqu5&_nc_oc=Ado5tPpfguhvzgF2Pwlod8ycyrSGluXd9BAIBGEnGo34qz97u2Djeokror5acnbp_uA&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0zxYsKbBcK7jiKXfwYJk3_tn6mTPAKc98JKKCsCV0a-w&oe=69E76E4E"}, {"file_name": "Screenshot 2024-09-19 140128_1.png", "id": "544846457927476", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38974579_544846461260809_5296880946640316475_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RWS8rw5fYBAQ7kNvwHVduH2&_nc_oc=AdoxATFIfBPNF3JQ-Q0FVD3hYwQuItRgFZW9lryyQqzjhJe0jGceKIwjdPaOcjAhLxs&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af16mJ02i4zRcns3HLRbokBIopTv0t9az6TZBe52SGteXA&oe=69E75FF7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BalanceBubbles_Trailer_Short.00_00_20_07.Still001 (1).png", "id": "1089442505874767", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/75258663_1089442509208100_1440755612146663990_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5iwHy-1Pz28Q7kNvwGRaKeM&_nc_oc=Ado4C1psrI7sswJLK6_rIfOEityvJPesK7zfAWrCtLsx7JRUF1sYKZe_M2ozZnrlzAQ&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0CtJwHgtWrxP-p8po02gN5MjFnB8rI2LprZet6CCTLAg&oe=69E77409"}, "display_name": "HoloMoves: Balance Bubbles", "keywords": [], "long_description": "Balance Bubbles is an innovative exergame that makes rehabilitation both fun and effective! Specifically designed for rehabilitation centers and physical therapy, this game focuses on helping players improve their static balance through controlled body movements. In Balance Bubbles, music bubbles float toward the player, who must lean left or right to pop them. Each bubble popped produces a unique sound, letting players craft a symphony of harmonious notes as they advance through the game.\n\nThis game is ideal for rehabilitation exercises, as it targets specific physical therapy goals by encouraging precise movements to build strength and stability. Balance Bubbles makes working on your balance an immersive and enjoyable experience, all while achieving important therapeutic outcomes.\n\n**(!) Balance Bubbles is part of the larger HoloMoves package, a subscription service offering a wide variety of exergames specifically designed for rehabilitation and physical therapy. Get a personal license and learn more at www.holomoves.nl/en**", "short_description": "Balance Bubbles is an innovative exergame that makes rehabilitation both fun and effective! Specifically designed for rehabilitation centers and physical therapy, this game focuses on helping players improve their static balance through controlled body movements. In Balance Bubbles, music bubbles float toward the player, who must lean left or right to pop them. Each bubble popped produces a unique sound, letting players craft a symphony of harmonious notes as they advance through the game."}]}, "developer_name": null, "developer_privacy_policy_url": "https://holomoves.nl/en/privacy/", "developer_terms_of_service_url": null, "publisher_name": "HoloMoves
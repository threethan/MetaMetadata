4555141559585_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RBlu8DBvgXoQ7kNvwGHg_ZJ&_nc_oc=AdpAYvtV9njMfjqcz-fL2FcO17utNtUh8XzH5551K5kgwTspyI_4v3ncfy-ITolBk7w&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7sepztUS7vl7w-AK-zav74x3uhbBwu426fXDxvjNaHNA&oe=6A11B912"}, {"file_name": "Screenshot 2024-09-19 140044_1.png", "id": "875052024558662", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/39035311_875052027891995_4491343046544077449_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sx0jXuvv7XMQ7kNvwH7_-qB&_nc_oc=Adruuq6vMSoeSw6inDRF32DsKTXPXjhMjYGMBlh4yqEtzl6jftTQJlNMbRbuk62nZes&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4ej1rn01-JMDpXG2aKIYHZvXGGleOMcNJmlQ_Jl7Xv3g&oe=6A11BF1F"}, {"file_name": "Screenshot 2024-09-19 140104_1.png", "id": "1242115010275622", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/38974512_1242115016942288_5501748253489110433_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-T5zdEuDJuAQ7kNvwFnPPQV&_nc_oc=AdqdEXaVUPBxY3FdDUUEV6vd_p9bzr6g8NoKo1i1ZS-9_MRAK4JFoznVsiR3aVzcGWU&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5kvROwSMZ2hB_dPfIUGCpF-yeDZGIfRnUaHv3oGo6ghw&oe=6A119E4E"}, {"file_name": "Screenshot 2024-09-19 140128_1.png", "id": "544846457927476", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/38974579_544846461260809_5296880946640316475_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=68cZ_tLpbiQQ7kNvwE4avoJ&_nc_oc=AdqpLNLNSlW80xH6YKETLKiDa-KjDLVL5WKOcCVPO45R7V9hfr_pnKjrrbc565H5VEk&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6dFt-iwYsTx3wTN5hZf7KkVs3Jnia2PekUBuJnMU_-oQ&oe=6A11C837"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BalanceBubbles_Trailer_Short.00_00_20_07.Still001 (1).png", "id": "1089442505874767", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/75258663_1089442509208100_1440755612146663990_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NlMv8fa3oRUQ7kNvwH7-XHa&_nc_oc=AdpJR2ym76anL-ypw6BnxTA7VPEfTPPmmGX41epuWzQtx84-zFqgHXzeHp2Yf6nLRCE&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7oNlnlOasBRCd3zE3h7FUwJYfNT9EYZxXGyVk0r6OrIA&oe=6A11A409"}, "display_name": "HoloMoves: Balance Bubbles", "keywords": [], "long_description": "Balance Bubbles is an innovative exergame that makes rehabilitation both fun and effective! Specifically designed for rehabilitation centers and physical therapy, this game focuses on helping players improve their static balance through controlled body movements. In Balance Bubbles, music bubbles float toward the player, who must lean left or right to pop them. Each bubble popped produces a unique sound, letting players craft a symphony of harmonious notes as they advance through the game.\n\nThis game is ideal for rehabilitation exercises, as it targets specific physical therapy goals by encouraging precise movements to build strength and stability. Balance Bubbles makes working on your balance an immersive and enjoyable experience, all while achieving important therapeutic outcomes.\n\n**(!) Balance Bubbles is part of the larger HoloMoves package, a subscription service offering a wide variety of exergames specifically designed for rehabilitation and physical therapy. Get a personal license and learn more at www.holomoves.nl/en**", "short_description": "Balance Bubbles is an innovative exergame that makes rehabilitation both fun and effective! Specifically designed for rehabilitation centers and physical therapy, this game focuses on helping players improve their static balance through controlled body movements. In Balance Bubbles, music bubbles float toward the player, who must lean left or right to pop them. Each bubble popped produces a unique sound, letting players craft a symphony of harmonious notes as they advance through the game."}]}, "developer_name": null, "developer_privacy_policy_url": "https://holomoves.nl/en/privacy/", "developer_terms_of_service_url": null, "publisher_name": 
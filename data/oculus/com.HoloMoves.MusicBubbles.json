id": "485041437679884", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/57569436_485041441013217_4515494555141559585_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HJ3FAUWe4q8Q7kNvwHkQdyO&_nc_oc=Adp-s1VMxTDt1-wn2cIImDxkPci-IwbiPv0DOImcmgeej5xBXhc0qi4YS3YhTR113Io&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPQ7bHrLiCXr8TNwuCDN7hyemv-hbcWti73QLEVZOWaYA&oe=6AC11092"}, {"file_name": "Screenshot 2024-09-19 140044_1.png", "id": "875052024558662", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39035311_875052027891995_4491343046544077449_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wygWbzPbem4Q7kNvwHcwM-e&_nc_oc=AdrJUMxhwD-CCcdJqRUX8Jc9bnRSDmMlLBrfv22xDPz7XsQoHmMwABtc16Zx-NVDGfs&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN09aGWA13yUMprZY0TdvjZCAfBwgFs5SAhN_4Xt1mWfA&oe=6AC1169F"}, {"file_name": "Screenshot 2024-09-19 140104_1.png", "id": "1242115010275622", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974512_1242115016942288_5501748253489110433_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dEH5zIgvaHsQ7kNvwEkjVBW&_nc_oc=AdqCOMKD6fMcVrf_9295v8TBwFef4EvJGz0__XUDSEBjbWBInhIRBHceySTpVzgC22Y&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN6WZILf7eBXJrMK7yG_3SC4T-_OY1Av3k5zwZntpKCvQ&oe=6AC12E0E"}, {"file_name": "Screenshot 2024-09-19 140128_1.png", "id": "544846457927476", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974579_544846461260809_5296880946640316475_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A1hZcSa6cYgQ7kNvwEDp35C&_nc_oc=Adp1V2gsQSJXVriqB6D9R99wcxInmi3AZO0HKPUnZm_Hs2cC7Vtt2_7xFUUD4Y1ezEo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMZ3ci6UETuSqNPqp9aApnGqW1dXemjy3ye3c4klyFiFw&oe=6AC11FB7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BalanceBubbles_Trailer_Short.00_00_20_07.Still001 (1).png", "id": "1089442505874767", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75258663_1089442509208100_1440755612146663990_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NlduWG1H7_sQ7kNvwFZff6E&_nc_oc=AdpFJcdzKSjFiZjB_PadJVD5Jx2QOcGUfWdqDR5pmba76Rlda_pHMq5SwufA1n2gQnM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOZ4hxtc8QV_PkefZyjehDQJschOhOcEzn2-4P44tFsQw&oe=6AC133C9"}, "display_name": "HoloMoves: Balance Bubbles", "keywords": [], "long_description": "Balance Bubbles is an innovative exergame that makes rehabilitation both fun and effective! Specifically designed for rehabilitation centers and physical therapy, this game focuses on helping players improve their static balance through controlled body movements. In Balance Bubbles, music bubbles float toward the player, who must lean left or right to pop them. Each bubble popped produces a unique sound, letting players craft a symphony of harmonious notes as they advance through the game.\n\nThis game is ideal for rehabilitation exercises, as it targets specific physical therapy goals by encouraging precise movements to build strength and stability. Balance Bubbles makes working on your balance an immersive and enjoyable experience, all while achieving important therapeutic outcomes.\n\n**(!) Balance Bubbles is part of the larger HoloMoves package, a subscription service offering a wide variety of exergames specifically designed for rehabilitation and physical therapy. Get a personal license and learn more at www.holomoves.nl/en**", "short_description": "Balance Bubbles is an innovative exergame that makes rehabilitation both fun and effective! Specifically designed for rehabilitation centers and physical therapy, this game focuses on helping players improve their static balance through controlled body movements. In Balance Bubbles, music bubbles float toward the player, who must lean left or right to pop them. Each bubble popped produces a unique sound, letting players craft a symphony of harmonious notes as they advance through the game."}]}, "developer_name": null, "developer_
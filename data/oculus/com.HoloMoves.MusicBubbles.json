585_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SlavlxCTDAYQ7kNvwFn91O4&_nc_oc=AdoJjp64PwZ1U3HUsyy9BF7V3cka9mNCpoF6OKeD8A5u3WDP-liT-Rs-i5Xp-GrYEew&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1DhqHNXNJYXKdRyvD1T0HodhqYwfcsrMYA9WgzWhc8Cw&oe=69E0F192"}, {"file_name": "Screenshot 2024-09-19 140044_1.png", "id": "875052024558662", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39035311_875052027891995_4491343046544077449_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ji5RMXfvNbkQ7kNvwEHXCus&_nc_oc=Adpn-6-SOQ6r5kg_mCGufswj-QT9HBZVbqN1GHzL3b_XVOI2D2SY3FeKdDC5YFl3LNQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3mGv-2DvM6qjh2t4GlyiHqZ8hjBPzZXERl3HNxv1O0tg&oe=69E0F79F"}, {"file_name": "Screenshot 2024-09-19 140104_1.png", "id": "1242115010275622", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974512_1242115016942288_5501748253489110433_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A6FPLnBstb4Q7kNvwGNrgN5&_nc_oc=AdoAtVAP9aJRWmllTk25wdeFdEyo9KT_U79TX4ic16YDjZ2i0i5T_N2o3zyBB17w8mU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0XiSbyBTkZwT541A7YHJTwqDUr2Cv_kYkhzoJWjvZMAw&oe=69E0D6CE"}, {"file_name": "Screenshot 2024-09-19 140128_1.png", "id": "544846457927476", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974579_544846461260809_5296880946640316475_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tpoIKIQlarwQ7kNvwHu_A07&_nc_oc=Adql3BaRuXA-YYhBGv74WL_LdvSf8OvbItpaBVuegbhArxOWxRMms51QXC9JYMUpae4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0qzVh8CQ5yb8yCWNQ0LpnCrZyDa83vJeRQv3wIpL2Ydg&oe=69E0C877"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BalanceBubbles_Trailer_Short.00_00_20_07.Still001 (1).png", "id": "1089442505874767", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75258663_1089442509208100_1440755612146663990_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bxeWpJ62Z_MQ7kNvwH07Fmo&_nc_oc=AdpeBOm2iAAeIgrEEsbNaVCZmaY7XrguiS0apwunYAcEwDc6HI8Du1xbYl9nIJOnFCk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1g0tQkTzwfTQmCspc9hH28qagtepirgvv2p6FT00sOEg&oe=69E0DC89"}, "display_name": "HoloMoves: Balance Bubbles", "keywords": [], "long_description": "Balance Bubbles is an innovative exergame that makes rehabilitation both fun and effective! Specifically designed for rehabilitation centers and physical therapy, this game focuses on helping players improve their static balance through controlled body movements. In Balance Bubbles, music bubbles float toward the player, who must lean left or right to pop them. Each bubble popped produces a unique sound, letting players craft a symphony of harmonious notes as they advance through the game.\n\nThis game is ideal for rehabilitation exercises, as it targets specific physical therapy goals by encouraging precise movements to build strength and stability. Balance Bubbles makes working on your balance an immersive and enjoyable experience, all while achieving important therapeutic outcomes.\n\n**(!) Balance Bubbles is part of the larger HoloMoves package, a subscription service offering a wide variety of exergames specifically designed for rehabilitation and physical therapy. Get a personal license and learn more at www.holomoves.nl/en**", "short_description": "Balance Bubbles is an innovative exergame that makes rehabilitation both fun and effective! Specifically designed for rehabilitation centers and physical therapy, this game focuses on helping players improve their static balance through controlled body movements. In Balance Bubbles, music bubbles float toward the player, who must lean left or right to pop them. Each bubble popped produces a unique sound, letting players craft a symphony of harmonious notes as they advance through the game."}]}, "developer_name": null, "developer_privacy_policy_url": "https://holomoves.nl/en/privacy/", "developer_terms_of_service_url": null, "publisher_name": "HoloMoves
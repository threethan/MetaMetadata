id": "485041437679884", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/57569436_485041441013217_4515494555141559585_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r1JyLGOAu8MQ7kNvwG9PGPa&_nc_oc=AdoHd9ojWk9jjp1hTx_Nnkbbsc_IIFtfrOFTQgGnQAFMuXHTp007Ott8-8VlGnqg1l0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKaF96UQC_g6i7hFDT4eIodEqUgVSi16094N0QvzotQvQ&oe=6A9C2692"}, {"file_name": "Screenshot 2024-09-19 140044_1.png", "id": "875052024558662", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39035311_875052027891995_4491343046544077449_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XdXl80Ns5FsQ7kNvwE18E6N&_nc_oc=AdpFK8q2_qJJSL4FknJ1mslsu_L1wSFm0H1dV_xfcBGNRCKcKr_iMrb6QpfgnSqrndc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKb5ZGYp5T435OcEif8ZDEZHiPMx2n3UDIX-lnEuXLaHQ&oe=6A9C2C9F"}, {"file_name": "Screenshot 2024-09-19 140104_1.png", "id": "1242115010275622", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974512_1242115016942288_5501748253489110433_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f32dD4BYYiwQ7kNvwEIPLM7&_nc_oc=AdpFxPlmMTTJ68hja3OjQ1krNMUSJU9m1IJ2BJwA1vjIrI8-i_U9OqUJ9gld7_WDQus&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKmtIYrIVZ7k-XU3DnxNvA2lkTLqeg9TSLmOwTaNdmctw&oe=6A9C440E"}, {"file_name": "Screenshot 2024-09-19 140128_1.png", "id": "544846457927476", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974579_544846461260809_5296880946640316475_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RoqFY4_T2g8Q7kNvwEuOAsA&_nc_oc=Adr-ipanJMS9gC7-FcMzjWw6kvPWpLsDDAEjGVPjyiXYc0EBwFsQTGhQqTeSEnyeGYk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJtLJd_K_HXRr9ftzjMmDyzajovOReAJPzId95a8H0u5w&oe=6A9C35B7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BalanceBubbles_Trailer_Short.00_00_20_07.Still001 (1).png", "id": "1089442505874767", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75258663_1089442509208100_1440755612146663990_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=09cCOLpBYrIQ7kNvwF_4EF6&_nc_oc=AdqAy-6dCpGVOvtLoFfwlJ_mwy5xhAVxrQ5786aOqcK7n1MeLCAUPEUIn4mAf1Is1Ts&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKFM4HJM4h22W_g5TkiOLSvxBdlozZnPoLdygwdW6SaGg&oe=6A9C1189"}, "display_name": "HoloMoves: Balance Bubbles", "keywords": [], "long_description": "Balance Bubbles is an innovative exergame that makes rehabilitation both fun and effective! Specifically designed for rehabilitation centers and physical therapy, this game focuses on helping players improve their static balance through controlled body movements. In Balance Bubbles, music bubbles float toward the player, who must lean left or right to pop them. Each bubble popped produces a unique sound, letting players craft a symphony of harmonious notes as they advance through the game.\n\nThis game is ideal for rehabilitation exercises, as it targets specific physical therapy goals by encouraging precise movements to build strength and stability. Balance Bubbles makes working on your balance an immersive and enjoyable experience, all while achieving important therapeutic outcomes.\n\n**(!) Balance Bubbles is part of the larger HoloMoves package, a subscription service offering a wide variety of exergames specifically designed for rehabilitation and physical therapy. Get a personal license and learn more at www.holomoves.nl/en**", "short_description": "Balance Bubbles is an innovative exergame that makes rehabilitation both fun and effective! Specifically designed for rehabilitation centers and physical therapy, this game focuses on helping players improve their static balance through controlled body movements. In Balance Bubbles, music bubbles float toward the player, who must lean left or right to pop them. Each bubble popped produces a unique sound, letting players craft a symphony of harmonious notes as they advance through the game."}]}, "developer_name": null, "developer_
585_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2GFsBtxg4PUQ7kNvwFfwnOn&_nc_oc=AdqlvDPz-Zf8fR_bCCV9ls4H77Zihrzj41SA7VZA4CmttdAKoodU0Rrl8oo8CtT7P10&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af81F8yviSvGTSSyv9rSltpkMhUwrNBffudEv17-1B9Zig&oe=6A428092"}, {"file_name": "Screenshot 2024-09-19 140044_1.png", "id": "875052024558662", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39035311_875052027891995_4491343046544077449_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pfsX-EYW3IMQ7kNvwFgsvoV&_nc_oc=Adp8eDS3s6J-Lj2vc3jN5ZySffEMk2vGWZf-SIpZdbVZAQ4iug8ri7635y2K3ZTm9es&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8Hbnpk5ddZmhen4NugSdTDaM4TG8BF6AiIPnj9iQZuPw&oe=6A42869F"}, {"file_name": "Screenshot 2024-09-19 140104_1.png", "id": "1242115010275622", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974512_1242115016942288_5501748253489110433_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BdlxJV97Lj0Q7kNvwHOs_-x&_nc_oc=AdrTcMtAnRRW4N7C8pyDw8O3t2W_FlWF9n7hZhDOlD0QTq2dtniv_HW0AaAa8WBHHQo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8a9ZCCbZTRaP0BySCK4p1JB7ifdjbfQuaVjI3IWpWDsA&oe=6A4265CE"}, {"file_name": "Screenshot 2024-09-19 140128_1.png", "id": "544846457927476", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974579_544846461260809_5296880946640316475_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6KSbYJp7eJ0Q7kNvwEVQds5&_nc_oc=AdoHEt6WFZvwWyXMOXpZSVULNJZ0f8p_rYSJpTvcLHVrpBKbjgVX0IiBClD5u9dFFYM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8cyDwDB057Ja4YienP90n1aNdbvVQoe3Wt5-h1cxVYxQ&oe=6A428FB7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BalanceBubbles_Trailer_Short.00_00_20_07.Still001 (1).png", "id": "1089442505874767", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75258663_1089442509208100_1440755612146663990_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7cNB-VAd6UcQ7kNvwGVP2Gs&_nc_oc=Adr9-9IZNk_wba_Q7ZlLn0L-9Xm5pmgrtnm94yQgf8g5P53PFvG2R5hutEDkekmd49k&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-gbLItGCq8ATY4TucYwvySBHGiboMbh-f6k2flKmZ2TQ&oe=6A426B89"}, "display_name": "HoloMoves: Balance Bubbles", "keywords": [], "long_description": "Balance Bubbles is an innovative exergame that makes rehabilitation both fun and effective! Specifically designed for rehabilitation centers and physical therapy, this game focuses on helping players improve their static balance through controlled body movements. In Balance Bubbles, music bubbles float toward the player, who must lean left or right to pop them. Each bubble popped produces a unique sound, letting players craft a symphony of harmonious notes as they advance through the game.\n\nThis game is ideal for rehabilitation exercises, as it targets specific physical therapy goals by encouraging precise movements to build strength and stability. Balance Bubbles makes working on your balance an immersive and enjoyable experience, all while achieving important therapeutic outcomes.\n\n**(!) Balance Bubbles is part of the larger HoloMoves package, a subscription service offering a wide variety of exergames specifically designed for rehabilitation and physical therapy. Get a personal license and learn more at www.holomoves.nl/en**", "short_description": "Balance Bubbles is an innovative exergame that makes rehabilitation both fun and effective! Specifically designed for rehabilitation centers and physical therapy, this game focuses on helping players improve their static balance through controlled body movements. In Balance Bubbles, music bubbles float toward the player, who must lean left or right to pop them. Each bubble popped produces a unique sound, letting players craft a symphony of harmonious notes as they advance through the game."}]}, "developer_name": null, "developer_privacy_policy_url": "https://holomoves.nl/en/privacy/", "developer_terms_of_service_url": null, "publisher_name": "HoloMoves
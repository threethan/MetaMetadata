id": "485041437679884", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/57569436_485041441013217_4515494555141559585_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BFhiDltyUbIQ7kNvwG0d4Ud&_nc_oc=AdpsL1GTaX8CGzByyJ5lm90OedRBaXs9iusIMW0doJr5YjGWDTI27N4-xloVtxu5b5s&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBIuzx-TgW8tV-HoGcYKwL2fqZ39zWhlQd8c_qFqrLXLg&oe=6A4FAF92"}, {"file_name": "Screenshot 2024-09-19 140044_1.png", "id": "875052024558662", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39035311_875052027891995_4491343046544077449_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aQt6JZ0mFA0Q7kNvwEhqwhf&_nc_oc=AdqylmnfekKdhcK1_zaOKhyQ_3-cevuS78Hjqz9ppdtazhKMv1BaJp6p2TPlzPZfLu0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAXu9oNVX2KfoEUVEwvNpkVWCNVpuFpbnXnKF8vFvffNQ&oe=6A4FB59F"}, {"file_name": "Screenshot 2024-09-19 140104_1.png", "id": "1242115010275622", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974512_1242115016942288_5501748253489110433_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=048pUG9xrzwQ7kNvwEFfVcJ&_nc_oc=AdoqQ18_74wbi4iu5-wN0IPiw3ptvms695rmm4QMlmI1KEk0ShBk-L89uLabKVbLiT8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBK8IjFHuj78KVBWPoB5zz4hqJjXVdeP0L5BuxHpt9Nkw&oe=6A4F94CE"}, {"file_name": "Screenshot 2024-09-19 140128_1.png", "id": "544846457927476", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974579_544846461260809_5296880946640316475_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NQQuSBRgKS4Q7kNvwGEjA0t&_nc_oc=Adr41e699tOVlewrNkrmVpLyBomNsqlkUfcVoEK7Uwk8gFIb29CzXlvsOtFm3EWst-Q&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBvURPgAqHwaRZlRreJuE16IfzuYaz3ojKtzJr8Awbvug&oe=6A4FBEB7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BalanceBubbles_Trailer_Short.00_00_20_07.Still001 (1).png", "id": "1089442505874767", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75258663_1089442509208100_1440755612146663990_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EJ1b-7SyZ60Q7kNvwFB8kYp&_nc_oc=Adr3a8lxDAWyVe1ZnYaSZump7tygoLZlPx6YhvU7IPk077AZqDSdkC87hli1bT8AV_8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBGN4pqHBuPvSWvJrgm2cMr4Eyh2XOj_PfC8QH4hTBo_g&oe=6A4F9A89"}, "display_name": "HoloMoves: Balance Bubbles", "keywords": [], "long_description": "Balance Bubbles is an innovative exergame that makes rehabilitation both fun and effective! Specifically designed for rehabilitation centers and physical therapy, this game focuses on helping players improve their static balance through controlled body movements. In Balance Bubbles, music bubbles float toward the player, who must lean left or right to pop them. Each bubble popped produces a unique sound, letting players craft a symphony of harmonious notes as they advance through the game.\n\nThis game is ideal for rehabilitation exercises, as it targets specific physical therapy goals by encouraging precise movements to build strength and stability. Balance Bubbles makes working on your balance an immersive and enjoyable experience, all while achieving important therapeutic outcomes.\n\n**(!) Balance Bubbles is part of the larger HoloMoves package, a subscription service offering a wide variety of exergames specifically designed for rehabilitation and physical therapy. Get a personal license and learn more at www.holomoves.nl/en**", "short_description": "Balance Bubbles is an innovative exergame that makes rehabilitation both fun and effective! Specifically designed for rehabilitation centers and physical therapy, this game focuses on helping players improve their static balance through controlled body movements. In Balance Bubbles, music bubbles float toward the player, who must lean left or right to pop them. Each bubble popped produces a unique sound, letting players craft a symphony of harmonious notes as they advance through the game."}]}, "developer_name": null, "developer_
585_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WloIuGLTrjcQ7kNvwFjE4o0&_nc_oc=AdpvysbHBX_w3guydDgf4yLSW5hF0B_u9SSN5qkgQedx-Gj9lCrKHDgqUKpFvw7y8qE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7pIuMCTBWP7MK4Jr_wJe72pC5EBhXO7FWJN4oGGeYcVg&oe=6A048A12"}, {"file_name": "Screenshot 2024-09-19 140044_1.png", "id": "875052024558662", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39035311_875052027891995_4491343046544077449_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2vAYTc1lIqkQ7kNvwGKDF_U&_nc_oc=AdoOyC6bt2E5f_ywy8dmenKf4Tcr_S9HyYZCF8laUxGs4tQ7brDrFBvfXb0xOloWns0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5lRY42e5MF48Qw10Ubk9Hackl6rHQT-OXGnE814mjd8A&oe=6A04901F"}, {"file_name": "Screenshot 2024-09-19 140104_1.png", "id": "1242115010275622", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974512_1242115016942288_5501748253489110433_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=klDPjJBYSnsQ7kNvwFij21M&_nc_oc=AdrfjDEEmPGY8LhPQl0x95kucQwnZN44kJslkq_35ABQqYgoiRtL5BGmcU3Vx63kFvo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af69y0iajcK9rGWpml3BLqAE_qyu4trJ-U62gGIoOC_KPA&oe=6A046F4E"}, {"file_name": "Screenshot 2024-09-19 140128_1.png", "id": "544846457927476", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974579_544846461260809_5296880946640316475_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e4nN8QL_IRIQ7kNvwHkh4xX&_nc_oc=Ado6J6SiPe9NOYLJFqkCp6YINjOqJh1zMf0TRo31acEo3P8kMt02clM4WYu1rWiGCwo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6XWqEx4n0H28iSF3cO0V8a5-_SSfGtEWW3qg1H_-bzHw&oe=6A049937"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BalanceBubbles_Trailer_Short.00_00_20_07.Still001 (1).png", "id": "1089442505874767", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75258663_1089442509208100_1440755612146663990_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u52WCd4Xr0AQ7kNvwHBY6CS&_nc_oc=Adr0wDVxsdWTHc9bp0XMgrobsWzMaWv5SkcoBDAukpZV5MepI6iLdl6t4YSsPimc3x4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4dm69pfov86elJ3nfMM-CShJ9dyGIWYuuiVCJ6lHeDMg&oe=6A047509"}, "display_name": "HoloMoves: Balance Bubbles", "keywords": [], "long_description": "Balance Bubbles is an innovative exergame that makes rehabilitation both fun and effective! Specifically designed for rehabilitation centers and physical therapy, this game focuses on helping players improve their static balance through controlled body movements. In Balance Bubbles, music bubbles float toward the player, who must lean left or right to pop them. Each bubble popped produces a unique sound, letting players craft a symphony of harmonious notes as they advance through the game.\n\nThis game is ideal for rehabilitation exercises, as it targets specific physical therapy goals by encouraging precise movements to build strength and stability. Balance Bubbles makes working on your balance an immersive and enjoyable experience, all while achieving important therapeutic outcomes.\n\n**(!) Balance Bubbles is part of the larger HoloMoves package, a subscription service offering a wide variety of exergames specifically designed for rehabilitation and physical therapy. Get a personal license and learn more at www.holomoves.nl/en**", "short_description": "Balance Bubbles is an innovative exergame that makes rehabilitation both fun and effective! Specifically designed for rehabilitation centers and physical therapy, this game focuses on helping players improve their static balance through controlled body movements. In Balance Bubbles, music bubbles float toward the player, who must lean left or right to pop them. Each bubble popped produces a unique sound, letting players craft a symphony of harmonious notes as they advance through the game."}]}, "developer_name": null, "developer_privacy_policy_url": "https://holomoves.nl/en/privacy/", "developer_terms_of_service_url": null, "publisher_name": "HoloMoves
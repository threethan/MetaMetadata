id": "485041437679884", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/57569436_485041441013217_4515494555141559585_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HJ3FAUWe4q8Q7kNvwGP_tUx&_nc_oc=AdpoxpYaZNqO6TD9zbWht4AjyDJMWAl_NdjarZ3iJ6YjZNtBvbbHc-rBX52DpHU1E5E&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOPVm_HSNY5XGId7gPjfgQ4ZKkrm-eTUHAz79_5GJS1YQ&oe=6ABFBF12"}, {"file_name": "Screenshot 2024-09-19 140044_1.png", "id": "875052024558662", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39035311_875052027891995_4491343046544077449_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o5cvIV5RKxoQ7kNvwF8Ixi8&_nc_oc=AdrElyGOSgNo_932qzRRZUDn1U1gAIPTj408-WJqfe85DjcmYmQhv0YoWmngbkWfp8o&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMNNok4O54-5tICrq2bgiFj807xZUBn2_saiGASbPQAAA&oe=6ABFC51F"}, {"file_name": "Screenshot 2024-09-19 140104_1.png", "id": "1242115010275622", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974512_1242115016942288_5501748253489110433_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dEH5zIgvaHsQ7kNvwESUpuO&_nc_oc=AdoaeyjfSAdhBFjg8kUTOsslmAlJNAwwaGVSXAhNZtyrcKC1_c_hGdY38OsSs0zxhHo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMjs4jSVu4b1Mi7BmHcvRc2kkryiUC4RQ0-Q653iBK7fQ&oe=6ABFDC8E"}, {"file_name": "Screenshot 2024-09-19 140128_1.png", "id": "544846457927476", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974579_544846461260809_5296880946640316475_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A1hZcSa6cYgQ7kNvwHxO1jx&_nc_oc=AdpH7O_0dfzB1LtyZLGd7NEIJW5AE7BCzDQqG1IjWXSuEMkG_U4RUKgtKt-Rk1QByu0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMhnsbrPZwfVojY0MCz4v_R00K1jpuzm-bjIKwLxQt9PQ&oe=6ABFCE37"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BalanceBubbles_Trailer_Short.00_00_20_07.Still001 (1).png", "id": "1089442505874767", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75258663_1089442509208100_1440755612146663990_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NlduWG1H7_sQ7kNvwELScoS&_nc_oc=Ado0zwhQy9LqfLK9oeGsk87feq9LYjrwOQhdJuM6wcJsGHHPl81agiAOO_PQm1SqysY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOg2UVKCJyTr7kJ8WGoVb5POnAWcqaZTAj0v3Ot7_q9vw&oe=6ABFAA09"}, "display_name": "HoloMoves: Balance Bubbles", "keywords": [], "long_description": "Balance Bubbles is an innovative exergame that makes rehabilitation both fun and effective! Specifically designed for rehabilitation centers and physical therapy, this game focuses on helping players improve their static balance through controlled body movements. In Balance Bubbles, music bubbles float toward the player, who must lean left or right to pop them. Each bubble popped produces a unique sound, letting players craft a symphony of harmonious notes as they advance through the game.\n\nThis game is ideal for rehabilitation exercises, as it targets specific physical therapy goals by encouraging precise movements to build strength and stability. Balance Bubbles makes working on your balance an immersive and enjoyable experience, all while achieving important therapeutic outcomes.\n\n**(!) Balance Bubbles is part of the larger HoloMoves package, a subscription service offering a wide variety of exergames specifically designed for rehabilitation and physical therapy. Get a personal license and learn more at www.holomoves.nl/en**", "short_description": "Balance Bubbles is an innovative exergame that makes rehabilitation both fun and effective! Specifically designed for rehabilitation centers and physical therapy, this game focuses on helping players improve their static balance through controlled body movements. In Balance Bubbles, music bubbles float toward the player, who must lean left or right to pop them. Each bubble popped produces a unique sound, letting players craft a symphony of harmonious notes as they advance through the game."}]}, "developer_name": null, "developer_
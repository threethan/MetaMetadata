4555141559585_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5yiXBqA82ugQ7kNvwETHHKD&_nc_oc=AdqRSJJYeLZ-oxOkSLKHRzaUDQD2WeF_ZNqtjB6_lQMLW6QCKNjETy3TRNsqpXLPdcw&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8HEDWVEbpPY49o1N6uud3QKs4wO8nwlpj8TQjbb2Echg&oe=6A394612"}, {"file_name": "Screenshot 2024-09-19 140044_1.png", "id": "875052024558662", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/39035311_875052027891995_4491343046544077449_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1bi2vy_aj7QQ7kNvwEyniLm&_nc_oc=AdpVJ8zopesgr-VdquQ7RjghyeNhSXy0HYKoVqKseuR_7cW3TiMT8g71FQWK9H89yS4&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9EMnjtxPOODOonNN1F52u_gSM7Y3bKLHcHak-UgiTpiQ&oe=6A394C1F"}, {"file_name": "Screenshot 2024-09-19 140104_1.png", "id": "1242115010275622", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/38974512_1242115016942288_5501748253489110433_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1O20hxrOk3cQ7kNvwHA9vMr&_nc_oc=Adp-6bk40HzRii3VU88vqZH6H7Whxo3tPO5Ipk-lt5e3ZxPOXF88jfZSeIqYIv0Yz1M&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9gpAp_gekOQ3y6QwMYqt4-3TtTuaRON0fZhfW3GY7XGA&oe=6A39638E"}, {"file_name": "Screenshot 2024-09-19 140128_1.png", "id": "544846457927476", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/38974579_544846461260809_5296880946640316475_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7Bn7ZQwyPEgQ7kNvwES2_qr&_nc_oc=Adpd_LZywO6G7MIs_iY6sawYYJDRidS_L8-ScNhKfDEMg3mN3ITMEWsuSEy--AVPamU&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-U8Sghg5AS4phECHtVrbfD8lA76_3CaHsA4-Md-ZDtXg&oe=6A395537"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BalanceBubbles_Trailer_Short.00_00_20_07.Still001 (1).png", "id": "1089442505874767", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/75258663_1089442509208100_1440755612146663990_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YZhA8KdjVP8Q7kNvwFMica8&_nc_oc=AdoJqlzMUgq4lsmX6w27faf5uN0baOzZP3ekUlMrv3priURo--jvHFSadKK7NOta5_0&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af96r1THuE1TpotKzdOcDqabtvxlNKKk-niAWPQD5_QvRQ&oe=6A393109"}, "display_name": "HoloMoves: Balance Bubbles", "keywords": [], "long_description": "Balance Bubbles is an innovative exergame that makes rehabilitation both fun and effective! Specifically designed for rehabilitation centers and physical therapy, this game focuses on helping players improve their static balance through controlled body movements. In Balance Bubbles, music bubbles float toward the player, who must lean left or right to pop them. Each bubble popped produces a unique sound, letting players craft a symphony of harmonious notes as they advance through the game.\n\nThis game is ideal for rehabilitation exercises, as it targets specific physical therapy goals by encouraging precise movements to build strength and stability. Balance Bubbles makes working on your balance an immersive and enjoyable experience, all while achieving important therapeutic outcomes.\n\n**(!) Balance Bubbles is part of the larger HoloMoves package, a subscription service offering a wide variety of exergames specifically designed for rehabilitation and physical therapy. Get a personal license and learn more at www.holomoves.nl/en**", "short_description": "Balance Bubbles is an innovative exergame that makes rehabilitation both fun and effective! Specifically designed for rehabilitation centers and physical therapy, this game focuses on helping players improve their static balance through controlled body movements. In Balance Bubbles, music bubbles float toward the player, who must lean left or right to pop them. Each bubble popped produces a unique sound, letting players craft a symphony of harmonious notes as they advance through the game."}]}, "developer_name": null, "developer_privacy_policy_url": "https://holomoves.nl/en/privacy/", "developer_terms_of_service_url": null, "publisher_name": 
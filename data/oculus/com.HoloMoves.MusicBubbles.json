id": "485041437679884", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/57569436_485041441013217_4515494555141559585_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A53ADPtliaIQ7kNvwHOR3MZ&_nc_oc=Adr_vHWJrqp8QqWNQu2HHtaOYs1AIzOduJF4ml8Diy_s1f2iKKJuAWcWJDtU1N5TE_c&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNmIa0v5X2loYmXvqtUNzlOx0WSbrpSaQEqE6lEkHyH7w&oe=6AD0E292"}, {"file_name": "Screenshot 2024-09-19 140044_1.png", "id": "875052024558662", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/39035311_875052027891995_4491343046544077449_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IaUVMerqrn0Q7kNvwEi2YSP&_nc_oc=AdoqGdQ9wDqCjbvyceCs87BgFGJLumcRgxw-EaRkySurXB1IPHNoz4rElp-vZ1AXZxc&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNlT1r23jP5IC0yur5123eCDnZtRi2_N8LsEzfQkYKcKg&oe=6AD0E89F"}, {"file_name": "Screenshot 2024-09-19 140104_1.png", "id": "1242115010275622", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38974512_1242115016942288_5501748253489110433_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YYV78AFLeKgQ7kNvwGQWIVg&_nc_oc=Adr_ytrew0o9eFHjo71H9LZCAnOiatnvWmf9rlLEr10GGF-MI6ZtF-0zITJJ0azvJu8&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP5CUZy-qXGCspjWfHMYQ2aSvdNAz80a8pHfOs6Lg6Zgg&oe=6AD1000E"}, {"file_name": "Screenshot 2024-09-19 140128_1.png", "id": "544846457927476", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38974579_544846461260809_5296880946640316475_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rKTCgFNVl-kQ7kNvwHZuJrb&_nc_oc=Adpyja6HLzFXPBRuUnrmJJZ_a11SG31on5eWgR_MezIqb7XolXxGveGgqeMpRaN7nVI&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPRc5MY8bFduzt-4mDTpUQ6JkQocFaZLkupU1eOAaKqnQ&oe=6AD0F1B7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BalanceBubbles_Trailer_Short.00_00_20_07.Still001 (1).png", "id": "1089442505874767", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/75258663_1089442509208100_1440755612146663990_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GdfSce3hPSIQ7kNvwG5KLOx&_nc_oc=Adrw5DsFhmF7D87NWpJEI23jHPh7bMP9N-6HU9Y7ewghFyvbuiiutdjv2xBlfm-xbfY&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN88frWNNFjKMzK_kG-tZkXg9EKFW1tpUubdEGHY5C3Gg&oe=6AD105C9"}, "display_name": "HoloMoves: Balance Bubbles", "keywords": [], "long_description": "Balance Bubbles is an innovative exergame that makes rehabilitation both fun and effective! Specifically designed for rehabilitation centers and physical therapy, this game focuses on helping players improve their static balance through controlled body movements. In Balance Bubbles, music bubbles float toward the player, who must lean left or right to pop them. Each bubble popped produces a unique sound, letting players craft a symphony of harmonious notes as they advance through the game.\n\nThis game is ideal for rehabilitation exercises, as it targets specific physical therapy goals by encouraging precise movements to build strength and stability. Balance Bubbles makes working on your balance an immersive and enjoyable experience, all while achieving important therapeutic outcomes.\n\n**(!) Balance Bubbles is part of the larger HoloMoves package, a subscription service offering a wide variety of exergames specifically designed for rehabilitation and physical therapy. Get a personal license and learn more at www.holomoves.nl/en**", "short_description": "Balance Bubbles is an innovative exergame that makes rehabilitation both fun and effective! Specifically designed for rehabilitation centers and physical therapy, this game focuses on helping players improve their static balance through controlled body movements. In Balance Bubbles, music bubbles float toward the player, who must lean left or right to pop them. Each bubble popped produces a unique sound, letting players craft a symphony of harmonious notes as they advance through the game."}]}, "developer_name": null, "developer_
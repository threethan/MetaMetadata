585_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SlavlxCTDAYQ7kNvwEA1g5U&_nc_oc=AdqS161n2pAI8Pf2yVrBdwYdL95HVYOM4rGx3Q86esAGpBatouvhJRU8yS2U8RS59gI&_nc_zt=3&_nc_ht=scontent-lhr8-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af04r6zh95UgUiAWjRLqhus7pGBrGh984W63schtyFRbIg&oe=69E24312"}, {"file_name": "Screenshot 2024-09-19 140044_1.png", "id": "875052024558662", "uri": "https://scontent-lhr8-1.oculuscdn.com/v/t64.5771-25/39035311_875052027891995_4491343046544077449_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ji5RMXfvNbkQ7kNvwH7Yiww&_nc_oc=AdomUGU8KMVQ0ZL-vZhfVCU-clTiMXtRZaQ1zXNem8RRKcoG91IB8eotJ0JdD8k5ZkQ&_nc_zt=3&_nc_ht=scontent-lhr8-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2LgkLxcqN7zhNP2V9JDH641Mqhsej3dhIoyKmUs7vmPg&oe=69E2491F"}, {"file_name": "Screenshot 2024-09-19 140104_1.png", "id": "1242115010275622", "uri": "https://scontent-lhr8-1.oculuscdn.com/v/t64.5771-25/38974512_1242115016942288_5501748253489110433_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A6FPLnBstb4Q7kNvwFOQQSq&_nc_oc=AdpIz4bZeIYgeBpBfaOJ0ygSjuTh6hvSHxjTd6kgzloCp-d38MAdVsN84dobd31xzIw&_nc_zt=3&_nc_ht=scontent-lhr8-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0kzgmiZ2Ji5EkaFB2xKt55atW5zT9rICdn5_pH8oFETQ&oe=69E2284E"}, {"file_name": "Screenshot 2024-09-19 140128_1.png", "id": "544846457927476", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/38974579_544846461260809_5296880946640316475_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=52VH3EGYYUgQ7kNvwHsRCQM&_nc_oc=AdoMoo1fZRFH00m-WKpgh6Bmik5NpATM6iZ8_u3d0wSQHQG13kGCFgqgXQrafJHUQqE&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1t79wAhbd1x2ZMxs8oYg9anN0h3WVafkqTyPsT-d7PFQ&oe=69E219F7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BalanceBubbles_Trailer_Short.00_00_20_07.Still001 (1).png", "id": "1089442505874767", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/75258663_1089442509208100_1440755612146663990_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M03XN89xZmQQ7kNvwHXF8Iz&_nc_oc=AdqGpW8NtBHOpvGfjPJYlqETlaTT7Nkags9gd9xRRgRY-6P61jVJkPMJQ4aT2jTCbAg&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af31_EYmGX9VGkFGUmA5fqFaUa2XBgcl6CBfVFH6YQ2xJw&oe=69E22E09"}, "display_name": "HoloMoves: Balance Bubbles", "keywords": [], "long_description": "Balance Bubbles is an innovative exergame that makes rehabilitation both fun and effective! Specifically designed for rehabilitation centers and physical therapy, this game focuses on helping players improve their static balance through controlled body movements. In Balance Bubbles, music bubbles float toward the player, who must lean left or right to pop them. Each bubble popped produces a unique sound, letting players craft a symphony of harmonious notes as they advance through the game.\n\nThis game is ideal for rehabilitation exercises, as it targets specific physical therapy goals by encouraging precise movements to build strength and stability. Balance Bubbles makes working on your balance an immersive and enjoyable experience, all while achieving important therapeutic outcomes.\n\n**(!) Balance Bubbles is part of the larger HoloMoves package, a subscription service offering a wide variety of exergames specifically designed for rehabilitation and physical therapy. Get a personal license and learn more at www.holomoves.nl/en**", "short_description": "Balance Bubbles is an innovative exergame that makes rehabilitation both fun and effective! Specifically designed for rehabilitation centers and physical therapy, this game focuses on helping players improve their static balance through controlled body movements. In Balance Bubbles, music bubbles float toward the player, who must lean left or right to pop them. Each bubble popped produces a unique sound, letting players craft a symphony of harmonious notes as they advance through the game."}]}, "developer_name": null, "developer_privacy_policy_url": "https://holomoves.nl/en/privacy/", "developer_terms_of_service_url": null, "publisher_name": "HoloMoves
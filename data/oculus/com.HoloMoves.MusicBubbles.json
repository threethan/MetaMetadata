_1.png", "id": "485041437679884", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/57569436_485041441013217_4515494555141559585_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i9QRwLMlNGwQ7kNvwFkeF_2&_nc_oc=Adrwfb5gZRLD28ThByf10XuBEWc9GNddfRVhhokSxCpdu2WID8xmZTvJ_iPM4P9UitI&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH06cQhWPSnpMmCjJz5djDAUT1Nzd9yRqorMIwU03ZOIA&oe=6A7D9BD2"}, {"file_name": "Screenshot 2024-09-19 140044_1.png", "id": "875052024558662", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/39035311_875052027891995_4491343046544077449_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mQkrxF1HoBYQ7kNvwGOvY81&_nc_oc=AdrRGsp7mHPQbs1OAdLgzrEl0yPDfePnLFNinR1lEeNmMf_KTmjZTmRYCyYB3LDZ0vI&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG6J-MvxgpcRkmtGD9Tv8TBDhuGgX2VWHRIc_XD6_StKA&oe=6A7DA1DF"}, {"file_name": "Screenshot 2024-09-19 140104_1.png", "id": "1242115010275622", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/38974512_1242115016942288_5501748253489110433_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QJp7TDYEpvwQ7kNvwFxM5nD&_nc_oc=AdqQqXaVo5L00TipqXtYT0D7w15Bo5XVoIwViDXTiVuJ-Kb64hpFwARSAKXZfar1Y3U&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFwjVj1yfRaVKss1BiMz_I2zCCqVMDdGtjm5XRZfCvn0g&oe=6A7DB94E"}, {"file_name": "Screenshot 2024-09-19 140128_1.png", "id": "544846457927476", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/38974579_544846461260809_5296880946640316475_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4tozghl7GqoQ7kNvwG8dhEx&_nc_oc=Adql0cdJMJJoCnRAPdfUKoJE4jfSocxw7KjGoWZgMwcL7cDbyS-YWY6Ei_EnyxS1B0Y&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF3eFUL1XKT3RtEYSohrGJxnYcDMVlAyxAptK9noM8iUQ&oe=6A7DAAF7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BalanceBubbles_Trailer_Short.00_00_20_07.Still001 (1).png", "id": "1089442505874767", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/75258663_1089442509208100_1440755612146663990_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qmU8gZsjFRUQ7kNvwHb5Vyf&_nc_oc=AdoAJflJjbGVOvkyICwODrjK_r6AjQZs148cfquBSFUGn4vVLI3Z5F6xnR_z3FQAXwQ&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF182btBvploPgholtwUr8Wau3ej5ATHw8wjhY4vsF99g&oe=6A7DBF09"}, "display_name": "HoloMoves: Balance Bubbles", "keywords": [], "long_description": "Balance Bubbles is an innovative exergame that makes rehabilitation both fun and effective! Specifically designed for rehabilitation centers and physical therapy, this game focuses on helping players improve their static balance through controlled body movements. In Balance Bubbles, music bubbles float toward the player, who must lean left or right to pop them. Each bubble popped produces a unique sound, letting players craft a symphony of harmonious notes as they advance through the game.\n\nThis game is ideal for rehabilitation exercises, as it targets specific physical therapy goals by encouraging precise movements to build strength and stability. Balance Bubbles makes working on your balance an immersive and enjoyable experience, all while achieving important therapeutic outcomes.\n\n**(!) Balance Bubbles is part of the larger HoloMoves package, a subscription service offering a wide variety of exergames specifically designed for rehabilitation and physical therapy. Get a personal license and learn more at www.holomoves.nl/en**", "short_description": "Balance Bubbles is an innovative exergame that makes rehabilitation both fun and effective! Specifically designed for rehabilitation centers and physical therapy, this game focuses on helping players improve their static balance through controlled body movements. In Balance Bubbles, music bubbles float toward the player, who must lean left or right to pop them. Each bubble popped produces a unique sound, letting players craft a symphony of harmonious notes as they advance through the game."}]}, "developer_name": null, "
585_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5yiXBqA82ugQ7kNvwF0EAFb&_nc_oc=AdrNKbjF-JmLSqvKBFkiEBp8hq8RxhuF-DBhF7dgdbrcpxB_G8jreLPfrEftzbe7Iq0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-153Kqdjr6vsc3O2hoVB9RoBicaN10zg7AGnI72RiyrQ&oe=6A37F492"}, {"file_name": "Screenshot 2024-09-19 140044_1.png", "id": "875052024558662", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39035311_875052027891995_4491343046544077449_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1bi2vy_aj7QQ7kNvwFXzRbg&_nc_oc=AdqRu2LubD8FKY66Z47TW0Mu3vzXEL_5yJ2nDwf1Rg-PFOOZu4Yrr_TqNii_aT3Pqf0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-Z6L2OuKrpN7bA69-ANFzB9cgiiJeEcHzqeuG2tyNcSw&oe=6A37FA9F"}, {"file_name": "Screenshot 2024-09-19 140104_1.png", "id": "1242115010275622", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974512_1242115016942288_5501748253489110433_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1O20hxrOk3cQ7kNvwEoQ5NZ&_nc_oc=AdoK9OLV7DKql0Jb8xmZZQCbZOy71s0VMcy7T4OvznX_rn78-LLTvxSYcLFvcmupbTQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9_vugqjlpKFmZ9GqysfTn1hmGVaPQZPLQQl0K3QZUZAg&oe=6A38120E"}, {"file_name": "Screenshot 2024-09-19 140128_1.png", "id": "544846457927476", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974579_544846461260809_5296880946640316475_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lGacawFGZ3MQ7kNvwFKZv4W&_nc_oc=Adp1DnwKFLa6w43VzteEIBRjMAkoQ30QS8Six0sfd00eSv7wneryA5Kcpl_vFtLdQ3k&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_WEgvSi9BZD3TQybTHuwZTDN1rd5a9D42FOpV6mIEVow&oe=6A3803B7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BalanceBubbles_Trailer_Short.00_00_20_07.Still001 (1).png", "id": "1089442505874767", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75258663_1089442509208100_1440755612146663990_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-2XyKdZt35gQ7kNvwE5CCHY&_nc_oc=AdqkWlvkqCeeuwnQSRSEhn2bmttV0HvqXc_bhDRnWx8AyiXdrXHK7YZOBOjxkytFzpE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_fGz69R9pIlmIphAbcBNz4yY0kDM1FXqyvjKOnNw8zzg&oe=6A37DF89"}, "display_name": "HoloMoves: Balance Bubbles", "keywords": [], "long_description": "Balance Bubbles is an innovative exergame that makes rehabilitation both fun and effective! Specifically designed for rehabilitation centers and physical therapy, this game focuses on helping players improve their static balance through controlled body movements. In Balance Bubbles, music bubbles float toward the player, who must lean left or right to pop them. Each bubble popped produces a unique sound, letting players craft a symphony of harmonious notes as they advance through the game.\n\nThis game is ideal for rehabilitation exercises, as it targets specific physical therapy goals by encouraging precise movements to build strength and stability. Balance Bubbles makes working on your balance an immersive and enjoyable experience, all while achieving important therapeutic outcomes.\n\n**(!) Balance Bubbles is part of the larger HoloMoves package, a subscription service offering a wide variety of exergames specifically designed for rehabilitation and physical therapy. Get a personal license and learn more at www.holomoves.nl/en**", "short_description": "Balance Bubbles is an innovative exergame that makes rehabilitation both fun and effective! Specifically designed for rehabilitation centers and physical therapy, this game focuses on helping players improve their static balance through controlled body movements. In Balance Bubbles, music bubbles float toward the player, who must lean left or right to pop them. Each bubble popped produces a unique sound, letting players craft a symphony of harmonious notes as they advance through the game."}]}, "developer_name": null, "developer_privacy_policy_url": "https://holomoves.nl/en/privacy/", "developer_terms_of_service_url": null, "publisher_name": "HoloMoves", "support_website_url": null, "website_url": "https://holomoves.nl/en/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}], "external_subscription_type": "REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "7978350892287511"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PUBLISHED", "id": "688173717260490"}, {"status": "PUBLISHED", "id": "490303087253385"}]}, "baseline_offer": {"id": "688173717260490"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1748856840, "status": "PUBLISHED", "id": "688173717260490"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "9012200992235824", "version": "1.2.2.1"}, "id": "351334134739938", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "7978350862287514", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "9012200992235824"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "351334134739938"}]}, "change_log": null, "created_date": 1739442000, "id": "9012200992235824", "version": "1.2.2.1", "version_code": 7, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"cou
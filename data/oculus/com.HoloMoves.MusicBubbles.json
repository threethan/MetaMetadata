.png", "id": "485041437679884", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/57569436_485041441013217_4515494555141559585_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lUz1dwQMvFwQ7kNvwF_duEg&_nc_oc=AdoggkSg42CsAg9Z5rMKS4KqxDQTuiiFh58fSR13jsZF7Qb83s3HtS9lOVsAQId-3E4&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHv8EBhvfdraqmmk0AU_AfBvpFEQejQMdG-nkxX69Gs1Q&oe=6A8D6DD2"}, {"file_name": "Screenshot 2024-09-19 140044_1.png", "id": "875052024558662", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/39035311_875052027891995_4491343046544077449_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cWEZI2IOoaMQ7kNvwEwCBYO&_nc_oc=AdqCtYk0Tn3RBRXNFKPJkYlr8NcxjSddPX6oeh68Eq3HopjjIL0DNNXGbDB9FZVb9qQ&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE5VFhdpxE252GeE7vjAaJC-U19wEUtzHiMp7rblvlgaA&oe=6A8D73DF"}, {"file_name": "Screenshot 2024-09-19 140104_1.png", "id": "1242115010275622", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/38974512_1242115016942288_5501748253489110433_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=olVf-7lLayEQ7kNvwE2V7a_&_nc_oc=AdqPJwDpfKKsyik3YeBnq32tyeSlXQPnGD3i5JCEvg_d5WnXM9XX5k0LItgYsX4QkXM&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHRKGLr7mKyQ_Pv9QJOD2Re52wxXjndM-S6rArqNFkv3Q&oe=6A8D8B4E"}, {"file_name": "Screenshot 2024-09-19 140128_1.png", "id": "544846457927476", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/38974579_544846461260809_5296880946640316475_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xeW0G-kr5HcQ7kNvwF2ivGd&_nc_oc=AdpPZknDwF5Z0R90xmMolCNnQbGTxnxJ2oip_Vp8kJ5wDHD96NgBWw2cFl1gx4bcsi8&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGdd46pYufWy_m8sZwghDOJGJidTDf7OWqwJNED_1edTQ&oe=6A8D7CF7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BalanceBubbles_Trailer_Short.00_00_20_07.Still001 (1).png", "id": "1089442505874767", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/75258663_1089442509208100_1440755612146663990_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x-dvAaaVdLQQ7kNvwFnRXlS&_nc_oc=Adryvh0NdQlfdHPrGYwEWgTACFwmrNKI2-E2mBpugNrRs3vylkbwe0SMkZerwF2YKQY&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFG68qRHxIYQ_HYBIjb5ALASh4s-yz7oxbc2TFIAxfMlA&oe=6A8D9109"}, "display_name": "HoloMoves: Balance Bubbles", "keywords": [], "long_description": "Balance Bubbles is an innovative exergame that makes rehabilitation both fun and effective! Specifically designed for rehabilitation centers and physical therapy, this game focuses on helping players improve their static balance through controlled body movements. In Balance Bubbles, music bubbles float toward the player, who must lean left or right to pop them. Each bubble popped produces a unique sound, letting players craft a symphony of harmonious notes as they advance through the game.\n\nThis game is ideal for rehabilitation exercises, as it targets specific physical therapy goals by encouraging precise movements to build strength and stability. Balance Bubbles makes working on your balance an immersive and enjoyable experience, all while achieving important therapeutic outcomes.\n\n**(!) Balance Bubbles is part of the larger HoloMoves package, a subscription service offering a wide variety of exergames specifically designed for rehabilitation and physical therapy. Get a personal license and learn more at www.holomoves.nl/en**", "short_description": "Balance Bubbles is an innovative exergame that makes rehabilitation both fun and effective! Specifically designed for rehabilitation centers and physical therapy, this game focuses on helping players improve their static balance through controlled body movements. In Balance Bubbles, music bubbles float toward the player, who must lean left or right to pop them. Each bubble popped produces a unique sound, letting players craft a symphony of harmonious notes as they advance through the game."}]}, "developer_name": nul
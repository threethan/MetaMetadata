585_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RBlu8DBvgXoQ7kNvwH0-FN8&_nc_oc=Adrlpi_JnDk4mXqgv1R8um6QRyo9eaLvTdBXSk7iEGMZ3sTgmZ7CiLEKv3G01P-JCDE&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5vAbvZHCaHbe0E8RmGoRdCSwXICH2FWbzlsLIpCcQe_w&oe=6A130A92"}, {"file_name": "Screenshot 2024-09-19 140044_1.png", "id": "875052024558662", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/39035311_875052027891995_4491343046544077449_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mORaFVR-qUEQ7kNvwGVNpE2&_nc_oc=AdrDWnT-TzH26tDxHwPceztNA5TGDtwIBLSlElCrvFxeEndjJ2OQiGR4Ay7G_LK_4ZQ&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7Dnyf1QFxpBT89C5uxtrvBU7IhpgdryQ8uV15b12tYAw&oe=6A13109F"}, {"file_name": "Screenshot 2024-09-19 140104_1.png", "id": "1242115010275622", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38974512_1242115016942288_5501748253489110433_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-T5zdEuDJuAQ7kNvwEOpNkL&_nc_oc=Adq6kUAp5xkRQXwszASImh7cxo8NA-Wagmuln3Pk4C2xtzYCD8tfslBgOO9AceQP3HU&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4JOvLxM1SKj2CS2XtpWij0Ryr_ZVNQ6xznzRXVZSgKIA&oe=6A12EFCE"}, {"file_name": "Screenshot 2024-09-19 140128_1.png", "id": "544846457927476", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38974579_544846461260809_5296880946640316475_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=68cZ_tLpbiQQ7kNvwGEC1yU&_nc_oc=AdpHV2GQCL7fwC1zZNdy1Opah1_OO-xpCbWn5NI7PZPSNYKJDfTOAX46gBvNqI3PT4s&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7ZxnQxK9oeC6szkU5Mmlyuq52k0DuoZ98knOfLkYCd8A&oe=6A1319B7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BalanceBubbles_Trailer_Short.00_00_20_07.Still001 (1).png", "id": "1089442505874767", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/75258663_1089442509208100_1440755612146663990_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NlMv8fa3oRUQ7kNvwHVItee&_nc_oc=AdqIb7AGlCya2TNQH0K-GHli_mDOkuJsv421B6wBlDJ3Yf78nezra6zCX3s1HE2lFV0&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af46Z7kFEHrc_L9c0sS5XkPfIP-oyqBu4K8AF9EutDz0jw&oe=6A12F589"}, "display_name": "HoloMoves: Balance Bubbles", "keywords": [], "long_description": "Balance Bubbles is an innovative exergame that makes rehabilitation both fun and effective! Specifically designed for rehabilitation centers and physical therapy, this game focuses on helping players improve their static balance through controlled body movements. In Balance Bubbles, music bubbles float toward the player, who must lean left or right to pop them. Each bubble popped produces a unique sound, letting players craft a symphony of harmonious notes as they advance through the game.\n\nThis game is ideal for rehabilitation exercises, as it targets specific physical therapy goals by encouraging precise movements to build strength and stability. Balance Bubbles makes working on your balance an immersive and enjoyable experience, all while achieving important therapeutic outcomes.\n\n**(!) Balance Bubbles is part of the larger HoloMoves package, a subscription service offering a wide variety of exergames specifically designed for rehabilitation and physical therapy. Get a personal license and learn more at www.holomoves.nl/en**", "short_description": "Balance Bubbles is an innovative exergame that makes rehabilitation both fun and effective! Specifically designed for rehabilitation centers and physical therapy, this game focuses on helping players improve their static balance through controlled body movements. In Balance Bubbles, music bubbles float toward the player, who must lean left or right to pop them. Each bubble popped produces a unique sound, letting players craft a symphony of harmonious notes as they advance through the game."}]}, "developer_name": null, "developer_privacy_policy_url": "https://holomoves.nl/en/privacy/", "developer_terms_of_service_url": null, "publisher_name": "HoloMoves
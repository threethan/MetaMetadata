585_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a7PMRRj-7tsQ7kNvwFY78If&_nc_oc=AdoRZ3-zApvyVaC_WbvFMbaxKZ48T8czOy9Gbgl9ESxtKZS7KJsQHxJBTNXELcY-zIs&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9z2OCsnNOJu04Yqt_F0l5eIcdIaPVpqb9gbKo5HknCoQ&oe=6A315D12"}, {"file_name": "Screenshot 2024-09-19 140044_1.png", "id": "875052024558662", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39035311_875052027891995_4491343046544077449_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hNJqiMv8klIQ7kNvwEdkeMV&_nc_oc=Ado4IsF4j3XumhCWD1Q64em0Ot_QbjngUugJF3cvRdmukPpfTYJ6YDI4SLRjSxAiy0k&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-S_MGlV1MLvkFvLUfyi2uuWyE_uR1Akq166iZFaRe-7g&oe=6A31631F"}, {"file_name": "Screenshot 2024-09-19 140104_1.png", "id": "1242115010275622", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974512_1242115016942288_5501748253489110433_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7Tai9Gzuas4Q7kNvwFL3bHl&_nc_oc=AdpYwc9WlRmazKJvIjPiGt9vPqkz0jE13NNyJt4kOZ17jClBiSxWSDctAU9Zn9TbbdQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_YBC1DhpCNrNBXxFAR85v5Y6X74GXlNBFvjbb_EtXfWg&oe=6A31424E"}, {"file_name": "Screenshot 2024-09-19 140128_1.png", "id": "544846457927476", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974579_544846461260809_5296880946640316475_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KgkBkF88nacQ7kNvwFsNVBi&_nc_oc=AdqFrBvFSkdjEYizgiV2A9knTJFNagnt8wYFJNAEh1kgczDEx1vB_dhw4xTv_Dr_sqo&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8GjANbe79q5Wmk4dNbpcasHqpKOLBmQVhyXx3Dz3_b6Q&oe=6A316C37"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BalanceBubbles_Trailer_Short.00_00_20_07.Still001 (1).png", "id": "1089442505874767", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75258663_1089442509208100_1440755612146663990_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w1mpZQIAAYgQ7kNvwHTwWYo&_nc_oc=AdpVXFnDM1sMdsrAoqNrU4TnbUjv-4A31Kao1eGnfp4SO49G7XEmXQA7p5c2iWVLPRs&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_YGLj4sl-1NSAxEisbMYBtcJ-ASrwjJGIkhKkUGbLNjQ&oe=6A314809"}, "display_name": "HoloMoves: Balance Bubbles", "keywords": [], "long_description": "Balance Bubbles is an innovative exergame that makes rehabilitation both fun and effective! Specifically designed for rehabilitation centers and physical therapy, this game focuses on helping players improve their static balance through controlled body movements. In Balance Bubbles, music bubbles float toward the player, who must lean left or right to pop them. Each bubble popped produces a unique sound, letting players craft a symphony of harmonious notes as they advance through the game.\n\nThis game is ideal for rehabilitation exercises, as it targets specific physical therapy goals by encouraging precise movements to build strength and stability. Balance Bubbles makes working on your balance an immersive and enjoyable experience, all while achieving important therapeutic outcomes.\n\n**(!) Balance Bubbles is part of the larger HoloMoves package, a subscription service offering a wide variety of exergames specifically designed for rehabilitation and physical therapy. Get a personal license and learn more at www.holomoves.nl/en**", "short_description": "Balance Bubbles is an innovative exergame that makes rehabilitation both fun and effective! Specifically designed for rehabilitation centers and physical therapy, this game focuses on helping players improve their static balance through controlled body movements. In Balance Bubbles, music bubbles float toward the player, who must lean left or right to pop them. Each bubble popped produces a unique sound, letting players craft a symphony of harmonious notes as they advance through the game."}]}, "developer_name": null, "developer_privacy_policy_url": "https://holomoves.nl/en/privacy/", "developer_terms_of_service_url": null, "publisher_name": "HoloMoves
id": "485041437679884", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/57569436_485041441013217_4515494555141559585_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8HSliBkCEv0Q7kNvwG6Lh1x&_nc_oc=Adof27-q9V7UNVnFVtUxJMelD_6z-qM5TwAWnT76Hqn2vFV4HeFSFor64KgE8aEF1ts&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPLJXMGZ-WT6cIgDucVfE03ITGfmUGTASEhGSqcDNPjBQ&oe=6AC3B392"}, {"file_name": "Screenshot 2024-09-19 140044_1.png", "id": "875052024558662", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39035311_875052027891995_4491343046544077449_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wygWbzPbem4Q7kNvwGjbMj5&_nc_oc=AdqQu5fAJqpciJaJN9FM5xS-FVmk-o8zMMu3Ik7n5pFsK0DkmziV5OJSq67ETXd-rH4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPjPs5RRnWvmGWJRuCS3MFxjGs-mzC0wqEsQ5RJm8lfYw&oe=6AC3B99F"}, {"file_name": "Screenshot 2024-09-19 140104_1.png", "id": "1242115010275622", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974512_1242115016942288_5501748253489110433_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Naw_Sob2GL0Q7kNvwFo7ueM&_nc_oc=Adrx-Zj_uHt4CpqfIsqoqYfTatzxR288DR3jg0K7YehJaaEYZ3EwDc9kTBQhnePxmg4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNuzpYg757Cj3yxorngcUxdLszFsNigEJkd0eYcI72PVw&oe=6AC3D10E"}, {"file_name": "Screenshot 2024-09-19 140128_1.png", "id": "544846457927476", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974579_544846461260809_5296880946640316475_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TcNVhF6VIn0Q7kNvwGpIuUx&_nc_oc=Adr-2m4zw5cCjTv5_PnK9WvAQnFhEewuAxEyjBuwCIsxj2HJ778bJE6wzs4U5LKovEo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPvtw0CAJHfMGeNKlPV0lRrFWcCnss3-aF7jtLbXBAsLw&oe=6AC3C2B7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BalanceBubbles_Trailer_Short.00_00_20_07.Still001 (1).png", "id": "1089442505874767", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75258663_1089442509208100_1440755612146663990_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=t5J1DuVOhIgQ7kNvwECD6gc&_nc_oc=AdrYbphiKUzVfMoZw4-jpc6lkqirbTSCWtDUs8GIpEslNd7HdsfKBrWkZK17xV4jNzo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP1G4ha18nhYRP1xx_c5p7N-T-qS_AAamGmTiK313feBA&oe=6AC3D6C9"}, "display_name": "HoloMoves: Balance Bubbles", "keywords": [], "long_description": "Balance Bubbles is an innovative exergame that makes rehabilitation both fun and effective! Specifically designed for rehabilitation centers and physical therapy, this game focuses on helping players improve their static balance through controlled body movements. In Balance Bubbles, music bubbles float toward the player, who must lean left or right to pop them. Each bubble popped produces a unique sound, letting players craft a symphony of harmonious notes as they advance through the game.\n\nThis game is ideal for rehabilitation exercises, as it targets specific physical therapy goals by encouraging precise movements to build strength and stability. Balance Bubbles makes working on your balance an immersive and enjoyable experience, all while achieving important therapeutic outcomes.\n\n**(!) Balance Bubbles is part of the larger HoloMoves package, a subscription service offering a wide variety of exergames specifically designed for rehabilitation and physical therapy. Get a personal license and learn more at www.holomoves.nl/en**", "short_description": "Balance Bubbles is an innovative exergame that makes rehabilitation both fun and effective! Specifically designed for rehabilitation centers and physical therapy, this game focuses on helping players improve their static balance through controlled body movements. In Balance Bubbles, music bubbles float toward the player, who must lean left or right to pop them. Each bubble popped produces a unique sound, letting players craft a symphony of harmonious notes as they advance through the game."}]}, "developer_name": null, "developer_
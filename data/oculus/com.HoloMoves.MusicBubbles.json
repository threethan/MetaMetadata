585_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_iB8bH_v4nsQ7kNvwFef6EW&_nc_oc=AdrswDEkjQmllovJrPyqQ74EiYLSm_Ogs73JykAHVK6IOucVAzXHAWDCNiiJdCNUmas&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_A6fjZXVjZyagHQSsHfw9Zmq_zZ3zFlNkIyRryi9DWjQ&oe=6A2EBA12"}, {"file_name": "Screenshot 2024-09-19 140044_1.png", "id": "875052024558662", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39035311_875052027891995_4491343046544077449_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hNJqiMv8klIQ7kNvwEfnlM_&_nc_oc=AdrL9xOvThhJ8yVL9s-MT7b7ZZ0QUNmEhrHxL0ctPpcZqBGFrm7fpFxQFHBLUjwZC_8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9ECB6nC3LCTlejl8NZc93cChmPTu9iO_EsXkDlKlLFqA&oe=6A2EC01F"}, {"file_name": "Screenshot 2024-09-19 140104_1.png", "id": "1242115010275622", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974512_1242115016942288_5501748253489110433_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ljltYxXTpdkQ7kNvwHrstIJ&_nc_oc=Adq2eyb7JwesFZWtQUIJ4Bl2InUyAvVhq67GWrQA_nIQKPnKCmhKLtA9Us65bcdARNU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9KUsBiwE4i_XWDGdi0zkow8riGOGYt4FvUkGfbRzalbQ&oe=6A2E9F4E"}, {"file_name": "Screenshot 2024-09-19 140128_1.png", "id": "544846457927476", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974579_544846461260809_5296880946640316475_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f1JFLMfYkCUQ7kNvwExFol9&_nc_oc=Adqoui7l-017ftqawxcP9RSLz3FLugWVXhQLTI2rb865b6bTUStYjVjH6Tq4NfXDS-w&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9_APStvFRocgnFfjTEX_zu8v34P27CSxckQQPMZwSsWw&oe=6A2EC937"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BalanceBubbles_Trailer_Short.00_00_20_07.Still001 (1).png", "id": "1089442505874767", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75258663_1089442509208100_1440755612146663990_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uX9EcUAZ3GgQ7kNvwHBvRHo&_nc_oc=AdonJ9Fx5AZJZhR4mZvRPhqxDoO2-efHTn4UbQ5JX6-E1ilwhHQgkfkBBDtz7kHNZmE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8G2cNm0fFKMuaYrd9OL-iI_Qb-Zu0ScihwDKG3D8vyeA&oe=6A2EA509"}, "display_name": "HoloMoves: Balance Bubbles", "keywords": [], "long_description": "Balance Bubbles is an innovative exergame that makes rehabilitation both fun and effective! Specifically designed for rehabilitation centers and physical therapy, this game focuses on helping players improve their static balance through controlled body movements. In Balance Bubbles, music bubbles float toward the player, who must lean left or right to pop them. Each bubble popped produces a unique sound, letting players craft a symphony of harmonious notes as they advance through the game.\n\nThis game is ideal for rehabilitation exercises, as it targets specific physical therapy goals by encouraging precise movements to build strength and stability. Balance Bubbles makes working on your balance an immersive and enjoyable experience, all while achieving important therapeutic outcomes.\n\n**(!) Balance Bubbles is part of the larger HoloMoves package, a subscription service offering a wide variety of exergames specifically designed for rehabilitation and physical therapy. Get a personal license and learn more at www.holomoves.nl/en**", "short_description": "Balance Bubbles is an innovative exergame that makes rehabilitation both fun and effective! Specifically designed for rehabilitation centers and physical therapy, this game focuses on helping players improve their static balance through controlled body movements. In Balance Bubbles, music bubbles float toward the player, who must lean left or right to pop them. Each bubble popped produces a unique sound, letting players craft a symphony of harmonious notes as they advance through the game."}]}, "developer_name": null, "developer_privacy_policy_url": "https://holomoves.nl/en/privacy/", "developer_terms_of_service_url": null, "publisher_name": "HoloMoves
id": "485041437679884", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/57569436_485041441013217_4515494555141559585_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AvJUVBUuSC4Q7kNvwEwW4wB&_nc_oc=AdrSyZhInPAp6OtKtrACy14bFJX11Pt6j8v3-p-R_fRNNMoXtWRws25-9HWULLDAje8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ3JffOia_RMLuK0YcVAFILX2r0A90VjiGZsKgN4H2t4g&oe=6AA2BE12"}, {"file_name": "Screenshot 2024-09-19 140044_1.png", "id": "875052024558662", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39035311_875052027891995_4491343046544077449_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EEvoGwcw5G0Q7kNvwE3UQLc&_nc_oc=AdqHY_43jZ6RlN_nfyCsaSXKqnAsb9dv76w0RniQAsdJTzQqXIeN-Mhmn7ts4uFNCWM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIvwZrXYxUSNlGNg9WHRLPWhS2RBDzmQY6fgRCqclUjjA&oe=6AA2C41F"}, {"file_name": "Screenshot 2024-09-19 140104_1.png", "id": "1242115010275622", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974512_1242115016942288_5501748253489110433_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jiBOHLvJQ_kQ7kNvwGBsPMd&_nc_oc=AdpW8RRMtvblZF2Ci96_HUhC5uW2PzgYQrAxOCnP4e3RYZzZ0EU8OO55D15CwWSguiA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJbzbsihU_p7QDtIQ0k3A42AWG2rBCYCyEuKRKCG8M9_Q&oe=6AA2A34E"}, {"file_name": "Screenshot 2024-09-19 140128_1.png", "id": "544846457927476", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974579_544846461260809_5296880946640316475_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VMBW09sy1CEQ7kNvwGGlCra&_nc_oc=AdqJbKxoFAHKNORhR1_g_93ZeCP1b92zGap7rnrE2hlAm0pvtO1QB5dxuVLHOvaUMZ4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQImZKlMo_BTe2lK1Cp201_PRm6zmI4o8gFuzpZfT-xYvQ&oe=6AA2CD37"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BalanceBubbles_Trailer_Short.00_00_20_07.Still001 (1).png", "id": "1089442505874767", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75258663_1089442509208100_1440755612146663990_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=05ChS02GPNQQ7kNvwEQg2EJ&_nc_oc=AdoYq8EqSgpGqNahsKaLw59GkQxbLgThvtSO5ZfpViN0bZbtJcCQQtBSX-s7I2iHtBo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKzAzZEnoBR9IEp3DhzjUQAlgo7ECaxoM18St5MvZv-rw&oe=6AA2A909"}, "display_name": "HoloMoves: Balance Bubbles", "keywords": [], "long_description": "Balance Bubbles is an innovative exergame that makes rehabilitation both fun and effective! Specifically designed for rehabilitation centers and physical therapy, this game focuses on helping players improve their static balance through controlled body movements. In Balance Bubbles, music bubbles float toward the player, who must lean left or right to pop them. Each bubble popped produces a unique sound, letting players craft a symphony of harmonious notes as they advance through the game.\n\nThis game is ideal for rehabilitation exercises, as it targets specific physical therapy goals by encouraging precise movements to build strength and stability. Balance Bubbles makes working on your balance an immersive and enjoyable experience, all while achieving important therapeutic outcomes.\n\n**(!) Balance Bubbles is part of the larger HoloMoves package, a subscription service offering a wide variety of exergames specifically designed for rehabilitation and physical therapy. Get a personal license and learn more at www.holomoves.nl/en**", "short_description": "Balance Bubbles is an innovative exergame that makes rehabilitation both fun and effective! Specifically designed for rehabilitation centers and physical therapy, this game focuses on helping players improve their static balance through controlled body movements. In Balance Bubbles, music bubbles float toward the player, who must lean left or right to pop them. Each bubble popped produces a unique sound, letting players craft a symphony of harmonious notes as they advance through the game."}]}, "developer_name": null, "developer_
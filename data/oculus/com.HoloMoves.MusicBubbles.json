id": "485041437679884", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/57569436_485041441013217_4515494555141559585_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rtrsTpNXl3UQ7kNvwFmjAx1&_nc_oc=AdrSt_IqjAWhFYS73sKm82xD3ovhuojT7AVEs_wOSCMx9ebJDrLzYwqbRxvtHr-nHrw&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPUM8MPH1wXQhQ4ouiCp6qVnOVtyAvMurvNZFtHDfEWOg&oe=6AC7A812"}, {"file_name": "Screenshot 2024-09-19 140044_1.png", "id": "875052024558662", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/39035311_875052027891995_4491343046544077449_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-5a3q9nRjB8Q7kNvwHIsjfV&_nc_oc=AdrXwLQXGNV8znwkEVCmtB6KVitGtOyc9rOT3OQK_ezROEueSJ94AA9gRrmvPopelGM&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNDAxcjDDmwn0cDjjwLHXcBWM_YNWSdWAR971-gqV2VFw&oe=6AC7AE1F"}, {"file_name": "Screenshot 2024-09-19 140104_1.png", "id": "1242115010275622", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38974512_1242115016942288_5501748253489110433_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1aDJhJlFi88Q7kNvwE7IPqt&_nc_oc=Adp7lrJhI4HCCNI1XMjqRgeJd6Ox0X8oLE34bBHCPC9VhEVgI9uPi3zfGLvlHBCRXSY&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOBYOJdEZF87mJ3tUEPVNxo9jU3Y2kCscO9gQ558dL6_A&oe=6AC7C58E"}, {"file_name": "Screenshot 2024-09-19 140128_1.png", "id": "544846457927476", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38974579_544846461260809_5296880946640316475_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pe2zcz40HVgQ7kNvwErDniy&_nc_oc=AdrPNml1xCt-NNhH82_DXfs2zI-R1u-UpCGbLwSlayhCIb-Bpkl4VWhviDIQLDA0j_Q&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNcmQ_OiJNx1mmmp-lNr2uMiczS7ERPkNANjI8Chu2e6g&oe=6AC7B737"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BalanceBubbles_Trailer_Short.00_00_20_07.Still001 (1).png", "id": "1089442505874767", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/75258663_1089442509208100_1440755612146663990_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AcfWK_geZnsQ7kNvwFd_hhu&_nc_oc=AdpvFmdMBc5FiE0ML68AMIID5jk5G-lZm8Mswhf6zCfMQUe_PlnqKoh-2k6aoiBi-QA&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOCJEm6gPncdegydoGGulZ3iQaDmk-gkBU3_NmMP6LbeQ&oe=6AC7CB49"}, "display_name": "HoloMoves: Balance Bubbles", "keywords": [], "long_description": "Balance Bubbles is an innovative exergame that makes rehabilitation both fun and effective! Specifically designed for rehabilitation centers and physical therapy, this game focuses on helping players improve their static balance through controlled body movements. In Balance Bubbles, music bubbles float toward the player, who must lean left or right to pop them. Each bubble popped produces a unique sound, letting players craft a symphony of harmonious notes as they advance through the game.\n\nThis game is ideal for rehabilitation exercises, as it targets specific physical therapy goals by encouraging precise movements to build strength and stability. Balance Bubbles makes working on your balance an immersive and enjoyable experience, all while achieving important therapeutic outcomes.\n\n**(!) Balance Bubbles is part of the larger HoloMoves package, a subscription service offering a wide variety of exergames specifically designed for rehabilitation and physical therapy. Get a personal license and learn more at www.holomoves.nl/en**", "short_description": "Balance Bubbles is an innovative exergame that makes rehabilitation both fun and effective! Specifically designed for rehabilitation centers and physical therapy, this game focuses on helping players improve their static balance through controlled body movements. In Balance Bubbles, music bubbles float toward the player, who must lean left or right to pop them. Each bubble popped produces a unique sound, letting players craft a symphony of harmonious notes as they advance through the game."}]}, "developer_name": null, "developer_
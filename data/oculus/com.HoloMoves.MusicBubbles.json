tl3-3.oculuscdn.com/v/t64.5771-25/39035311_875052027891995_4491343046544077449_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=maN7rhfleHgQ7kNvwG-O84F&_nc_oc=AdnHYi8On89W4zhvJ8xUyAJ1uGY6NCPh6axj-3tXm93cODXSgnjQ2pxZT9kAbqORl3w&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_AfsPlgQXwRAoazhPezTRd6soIjHBzUdmiIaid_nVy_R5HA&oe=69A56BDF"}, {"file_name": "Screenshot 2024-09-19 140104_1.png", "id": "1242115010275622", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974512_1242115016942288_5501748253489110433_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jyihZ8j_aYgQ7kNvwFfmXT_&_nc_oc=AdmthSiKDaKCQ-C8tM01bD4NH2l24JBSg8EKrPWv3G-v0DgjAphDS0oq2UkPIyskQpk&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_AfsE1PLQ1Cim3-MWeU19p3BDddNSIevRcR4aBcxzKfhqQw&oe=69A5834E"}, {"file_name": "Screenshot 2024-09-19 140128_1.png", "id": "544846457927476", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974579_544846461260809_5296880946640316475_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e8k40n9WA6kQ7kNvwEs6dwu&_nc_oc=AdmL53X7QXW5tyjezycers6EyxjT2gqErgZkI689TUKS5NylWzHJ8B-jJuQlAmEz0Xk&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_AfvG6YELaP6HnEVKXNMRB685CEyC5Q8o4cBfuvjmJGE3NQ&oe=69A574F7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BalanceBubbles_Trailer_Short.00_00_20_07.Still001 (1).png", "id": "1089442505874767", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75258663_1089442509208100_1440755612146663990_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3Ux8QSixKCIQ7kNvwHOhvIb&_nc_oc=AdkY0Qhpofon0de16XAgDeszQqN21-uhBMoRPvHDzYH3DVQIcYlzxpiGO5CVOXXFoEY&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_Aft2I-xba_AJ4pSQKtB3J7u9scZrDUTScUdFiZdyIqSX_g&oe=69A58909"}, "display_name": "HoloMoves: Balance Bubbles", "keywords": [], "long_description": "Balance Bubbles is an innovative exergame that makes rehabilitation both fun and effective! Specifically designed for rehabilitation centers and physical therapy, this game focuses on helping players improve their static balance through controlled body movements. In Balance Bubbles, music bubbles float toward the player, who must lean left or right to pop them. Each bubble popped produces a unique sound, letting players craft a symphony of harmonious notes as they advance through the game.\n\nThis game is ideal for rehabilitation exercises, as it targets specific physical therapy goals by encouraging precise movements to build strength and stability. Balance Bubbles makes working on your balance an immersive and enjoyable experience, all while achieving important therapeutic outcomes.\n\n**(!) Balance Bubbles is part of the larger HoloMoves package, a subscription service offering a wide variety of exergames specifically designed for rehabilitation and physical therapy. Get a personal license and learn more at www.holomoves.nl/en**", "short_description": "Balance Bubbles is an innovative exergame that makes rehabilitation both fun and effective! Specifically designed for rehabilitation centers and physical therapy, this game focuses on helping players improve their static balance through controlled body movements. In Balance Bubbles, music bubbles float toward the player, who must lean left or right to pop them. Each bubble popped produces a unique sound, letting players craft a symphony of harmonious notes as they advance through the game."}]}, "developer_name": null, "developer_privacy_policy_url": "https://holomoves.nl/en/privacy/", "developer_terms_of_service_url": null, "publisher_name": "HoloMoves", "support_website_url": null, "website_url": "https://holomoves.nl/en/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}], "external_subscription_type": "REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "MOVEMENT", "
_1.png", "id": "485041437679884", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/57569436_485041441013217_4515494555141559585_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8ZWwH8ZUmP4Q7kNvwHKoEc9&_nc_oc=Adq0KL1kEtL_us6M4hjKDCtdKsqCj1UupkptWbXGl-0NlNsXCmOG_JOI0J2_N6mGHa8&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJQxYMip8wJA8uJsNFS8M4m-1SbMADhhQ9zYP0co09JIw&oe=6AA95592"}, {"file_name": "Screenshot 2024-09-19 140044_1.png", "id": "875052024558662", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/39035311_875052027891995_4491343046544077449_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tRUMAcOlb-AQ7kNvwHYf5ZG&_nc_oc=AdqKZwRJT_Xj27DTh4GWeC9q9NMWsiYO3whZ1T6gNQEJqR4hhBIPbaduL97mPekLtG0&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLfVKvQxzD29VuCswk9olqTKarREdi9lpD_mX9_GZ22MQ&oe=6AA95B9F"}, {"file_name": "Screenshot 2024-09-19 140104_1.png", "id": "1242115010275622", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/38974512_1242115016942288_5501748253489110433_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ofYThqKyBqYQ7kNvwGH07Zy&_nc_oc=AdoFgpNPA0U8sMeOcKHG8Bi_KBwj0kZMJOKg9y5mswklhpxNaVCE85XYEcq_RmE7vl0&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJvicopCJYPUhFgzSOK-HPh7nNIZdJoVlstle8rg4VYlA&oe=6AA93ACE"}, {"file_name": "Screenshot 2024-09-19 140128_1.png", "id": "544846457927476", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/38974579_544846461260809_5296880946640316475_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MqsKeiYCjj0Q7kNvwEaS56N&_nc_oc=AdpUc15a7shs-oRvZYFZ8c4L2lScADyX9IZUTkryardPEKXZ-_dFOidYV4YxnrYrWvU&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJH5PjXXVbjqenIVyGFas-t5NdjBuqq_YJ1Q1J-2Mst2w&oe=6AA964B7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BalanceBubbles_Trailer_Short.00_00_20_07.Still001 (1).png", "id": "1089442505874767", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/75258663_1089442509208100_1440755612146663990_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UDKKRJTwnCYQ7kNvwEA37eX&_nc_oc=AdoLQlV9_c3rzsYnz0vxwBjEELcMfbfkTQa1zI_KfO-a9RCfx63Hd8K6WB4v9pP0f9I&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLtTz0r5VhJLddCtLZESJD6q-3DHJU5DmRAQC5mRQMVVg&oe=6AA94089"}, "display_name": "HoloMoves: Balance Bubbles", "keywords": [], "long_description": "Balance Bubbles is an innovative exergame that makes rehabilitation both fun and effective! Specifically designed for rehabilitation centers and physical therapy, this game focuses on helping players improve their static balance through controlled body movements. In Balance Bubbles, music bubbles float toward the player, who must lean left or right to pop them. Each bubble popped produces a unique sound, letting players craft a symphony of harmonious notes as they advance through the game.\n\nThis game is ideal for rehabilitation exercises, as it targets specific physical therapy goals by encouraging precise movements to build strength and stability. Balance Bubbles makes working on your balance an immersive and enjoyable experience, all while achieving important therapeutic outcomes.\n\n**(!) Balance Bubbles is part of the larger HoloMoves package, a subscription service offering a wide variety of exergames specifically designed for rehabilitation and physical therapy. Get a personal license and learn more at www.holomoves.nl/en**", "short_description": "Balance Bubbles is an innovative exergame that makes rehabilitation both fun and effective! Specifically designed for rehabilitation centers and physical therapy, this game focuses on helping players improve their static balance through controlled body movements. In Balance Bubbles, music bubbles float toward the player, who must lean left or right to pop them. Each bubble popped produces a unique sound, letting players craft a symphony of harmonious notes as they advance through the game."}]}, "developer_name": null, "
Q7kNvwHphBG-&_nc_oc=Adoua4A8vjFpBdo8UbYXzzaQs7MvOycFoR602MjirFAI1b9Ch7jJKo_udesM37u8A50&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-AsMDPPcnYNMjutO1JMbeFBjZUUsPbpwk4-yJ_IlDosA&oe=6A22E671"}, {"file_name": "migrated_image.png", "id": "503915403849657", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/12504647_1613397245621369_741789342199971840_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A_3upAxdzcMQ7kNvwGJSeCD&_nc_oc=AdrsCCU1AILnlHPV0uypykvreG8T2BnsZpS94tQKqE_pT3um2LR60qsgQlARpLtPnOg&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_mpRtsQn0r-vM--JFQzwPr_DUPqjC5klNbffsrWa3Vqw&oe=6A22FC63"}, {"file_name": "migrated_image.png", "id": "214678446270570", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/11162678_367766243614273_8732669583745351680_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3Csce3sJg8gQ7kNvwEX41cJ&_nc_oc=AdpiPn6b-4PdizTCIBQ6IBFCtlxBAyGYsK_GS8KD3CHnWoqYLLbiM0E1F0ZwU6iEgDc&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-X1Fj9FNVaJdXHayxyYBqon8GEeCnLJqliCeSGraF4fg&oe=6A22F128"}, {"file_name": "migrated_image.png", "id": "144304540242505", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/12331050_329187584112763_4810020976727162880_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Q_o45AOE4V0Q7kNvwFi36F9&_nc_oc=Adq3s7LFEv4QrTx_rZ-6IE539qovm8CacOvK3wtJuDl0KYjImI4BFgrXbAemZfsroi4&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-TqmWMPpm7Ik5e0LwBHX3_9-XhWwLVenWcKf9V8l5y6A&oe=6A22F24F"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "The Purge Day", "keywords": ["Horror", "Purge", "Day", "Shooter", "Aliens"], "long_description": "\u201cThe action is fast, the aliens look great and at times the immersion can be truly terrifying.\u201d - The VR Shop\n\n\u201cThis is fu*king horror shooter\u201d - Escape\n\nSomething strange has happened. No one knows what. It is unstoppable. Our civilization is almost dead but Jack Bowman has to save his wife. Do you want to know how this story finishes?\nChoose your weapon and fight against alien swarm in Asian agglomeration.\nThe Purge Day is the first person narrative, immersive horror shooter designed exclusively for VR.\n\nTPD contains :\nSuspenseful story\nInteresting and challenging achievements\nHigh quality sounds and voiceovers\nA large selection of weapons\nImmersive and not easy gameplay\nA large number of opponents\nEach chapter finishes with a powerful boss \nNo motion sickness\n\nController not required but supported.", "short_description": "The Purge Day is the first person narrative, immersive horror shooter designed exclusively for VR.\nChoose your weapon and fight against alien swarm in Asian agglomeration."}]}, "developer_name": null, "developer_privacy_policy_url": "http://redlimbstudio.com/privacy-policy.html", "developer_terms_of_service_url": "http://redlimbstudio.com/privacy-policy.html", "publisher_name": "Red Limb Studio", "support_website_url": null, "website_url": "http://redlimbstudio.com/tpd.html", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["SHOOTER", "HORROR", "ACTION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD", "TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1146167436151886"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/12138933_1103676193080769_1835948143645032448_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PnFl5GvYhrAQ7kNvwGGsfm0&_nc_oc=AdrWLskazpcUSQutpLIMo6n9OjGgnvrA4_VaGd1RQx9lokCzcyCO6x4wkPC4txsywgs&_nc_zt=3&_nc
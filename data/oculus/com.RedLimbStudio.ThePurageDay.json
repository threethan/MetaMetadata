rNA&_nc_oc=AdoGQBJGxduCS2ZpoijTh8waGuvi1deGOtTiXaSYG3G-793Pl7rHpDMfCyC8Z8mgp7A&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIuta6PtLQRMdixs7oXofW5jCyZ0KN1Au9VoxExIJ3drQ&oe=6AA56AF1"}, {"file_name": "migrated_image.png", "id": "503915403849657", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/12504647_1613397245621369_741789342199971840_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jCcTrk114W4Q7kNvwHyKnVd&_nc_oc=AdpWFJJ42H8Owvk7Kl85_PGPArX9kfWS9Yg884stiviFUI03FIlEuUXDAQUHa4Nekw0&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIHcuHewS8nbJt9bmyacHDulOp4gt7yNLe43JiHqC8NgQ&oe=6AA548A3"}, {"file_name": "migrated_image.png", "id": "214678446270570", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/11162678_367766243614273_8732669583745351680_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YCHj4QRvb0wQ7kNvwGd2q0D&_nc_oc=AdoT77g3vQmvsgkzE1d-IqAkyuqaaCI6XN1NHzMrKU8wO7SqJvu2DRBL4toSIQ0LFus&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIBPTp_TpEevS2qeu9Vrtz7Dtlsi3ElOOhn6v2cUOqMtw&oe=6AA575A8"}, {"file_name": "migrated_image.png", "id": "144304540242505", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/12331050_329187584112763_4810020976727162880_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Qe7vEloaQbkQ7kNvwG2k14j&_nc_oc=AdrXy8GDtgDzQuna8d7WhwCLDEwZjQJlZKCgycCnibNXS-YmfvSLlDKi8dYTHeGFxRE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLfHNwxwi-CVfF1mW5lGH5mfcrS0aeCJUkWCTmFnl5pQA&oe=6AA576CF"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "The Purge Day", "keywords": ["Horror", "Purge", "Day", "Shooter", "Aliens"], "long_description": "\u201cThe action is fast, the aliens look great and at times the immersion can be truly terrifying.\u201d - The VR Shop\n\n\u201cThis is fu*king horror shooter\u201d - Escape\n\nSomething strange has happened. No one knows what. It is unstoppable. Our civilization is almost dead but Jack Bowman has to save his wife. Do you want to know how this story finishes?\nChoose your weapon and fight against alien swarm in Asian agglomeration.\nThe Purge Day is the first person narrative, immersive horror shooter designed exclusively for VR.\n\nTPD contains :\nSuspenseful story\nInteresting and challenging achievements\nHigh quality sounds and voiceovers\nA large selection of weapons\nImmersive and not easy gameplay\nA large number of opponents\nEach chapter finishes with a powerful boss \nNo motion sickness\n\nController not required but supported.", "short_description": "The Purge Day is the first person narrative, immersive horror shooter designed exclusively for VR.\nChoose your weapon and fight against alien swarm in Asian agglomeration."}]}, "developer_name": null, "developer_privacy_policy_url": "http://redlimbstudio.com/privacy-policy.html", "developer_terms_of_service_url": "http://redlimbstudio.com/privacy-policy.html", "publisher_name": "Red Limb Studio", "support_website_url": null, "website_url": "http://redlimbstudio.com/tpd.html", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["SHOOTER", "HORROR", "ACTION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD", "TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1146167436151886"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/12138933_1103676193080769_1835948143645032448_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6-Bs0et8blgQ7kNvwGUhyQM&_nc_oc=AdoQTrMuQTwYEqzB6e-DexT4Hj3r3biPLyUzIkAj4LMDgpowbArUquoAIal-IP9-Nq4&_nc_zt=3&_nc_ht=sconten
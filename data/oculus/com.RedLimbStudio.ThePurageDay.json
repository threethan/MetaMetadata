-iad3-1.oculuscdn.com&oh=00_AfvC0XMm3GAX9ZHuaskdteNNDGW1lcUd8v-D9EksoYz91A&oe=699D86B1"}, {"file_name": "migrated_image.png", "id": "503915403849657", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/12504647_1613397245621369_741789342199971840_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uCP5ZR2pYVAQ7kNvwGItm61&_nc_oc=AdndDKoo_SF5y_UFSRm1wXZrf_zkwgtx5Ja1d5BujOXhDXfgC14R8jxej5fz0nSbunA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AftnraNQ_JFirhm1x5LrF9VCmspvapUWtmGUVRJj-kgxKg&oe=699D9CA3"}, {"file_name": "migrated_image.png", "id": "214678446270570", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/11162678_367766243614273_8732669583745351680_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v_AtsjAC8K8Q7kNvwH1igVw&_nc_oc=Adlpn_KA3eALpXDVNWC2Wvq4RizZz1dL-W0odh6zqvaZjrm6fYG-APFBaY2xLbWNiSU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Afs-8hplNmxyCmXTG0muA9Y_JsqDVGLTvNrh0yhvc4LIXQ&oe=699D9168"}, {"file_name": "migrated_image.png", "id": "144304540242505", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/12331050_329187584112763_4810020976727162880_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=abnnfyKwvrsQ7kNvwFAVyKe&_nc_oc=AdkoCoUm3bU7dY5IFYONj7yO4_-WAZitzCJQ7_3gKUOwYP9L7PGKJdSe0ZFsaSVdlfw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfuOQ_1RwqQGTi06WLW8gmO-LL0tJwYBDzLe1Q_aIowQMg&oe=699D928F"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "The Purge Day", "keywords": ["Horror", "Purge", "Day", "Shooter", "Aliens"], "long_description": "\u201cThe action is fast, the aliens look great and at times the immersion can be truly terrifying.\u201d - The VR Shop\n\n\u201cThis is fu*king horror shooter\u201d - Escape\n\nSomething strange has happened. No one knows what. It is unstoppable. Our civilization is almost dead but Jack Bowman has to save his wife. Do you want to know how this story finishes?\nChoose your weapon and fight against alien swarm in Asian agglomeration.\nThe Purge Day is the first person narrative, immersive horror shooter designed exclusively for VR.\n\nTPD contains :\nSuspenseful story\nInteresting and challenging achievements\nHigh quality sounds and voiceovers\nA large selection of weapons\nImmersive and not easy gameplay\nA large number of opponents\nEach chapter finishes with a powerful boss \nNo motion sickness\n\nController not required but supported.", "short_description": "The Purge Day is the first person narrative, immersive horror shooter designed exclusively for VR.\nChoose your weapon and fight against alien swarm in Asian agglomeration."}]}, "developer_name": null, "developer_privacy_policy_url": "http://redlimbstudio.com/privacy-policy.html", "developer_terms_of_service_url": "http://redlimbstudio.com/privacy-policy.html", "publisher_name": "Red Limb Studio", "support_website_url": null, "website_url": "http://redlimbstudio.com/tpd.html", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["SHOOTER", "HORROR", "ACTION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD", "TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1146167436151886"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/12138933_1103676193080769_1835948143645032448_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P1IOgB7KdNcQ7kNvwHQGzPy&_nc_oc=AdmAUyMgQOP3da5OtE7sNbHP_TJji8eTGtTLMqwLx8phEFfhZ7iillEJNgXS-4iMgTc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Aft41lcqfLF5kqQHZg6AsoHzZHlp7RoitBp636RtBHlA0Q&oe=699DA6AD"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": f
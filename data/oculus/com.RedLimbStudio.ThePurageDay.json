rlrv&_nc_oc=AdqcpBeiRiIMXMun_GIoQzETzFxj2XpfV2oCVtirbDKq7Rq6wfNQfbJzX1wys8wlglY&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_qS_rVjUcPLj7VFPJt3n3lWqNSSvvcyDYriZRpxTltGQ&oe=6A2C20F1"}, {"file_name": "migrated_image.png", "id": "503915403849657", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/12504647_1613397245621369_741789342199971840_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4F1n2EwmrOsQ7kNvwFQx_o7&_nc_oc=AdovCIld5E1-BcTho5G-atnKvTQ4VgzdaSb4RsQ9ncaxPgpxEyCZmgvOc7G3w_Pu0d8&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-aIl9W_m8eNTc3r8-moI_W1dRo7VSB1m0C2WwF1RuueQ&oe=6A2BFEA3"}, {"file_name": "migrated_image.png", "id": "214678446270570", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/11162678_367766243614273_8732669583745351680_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FjY6CFVoyMMQ7kNvwHtz2Ol&_nc_oc=AdomQhrLIkFWkmp4BF8WOoIXSZbIAV-PgjgG6j7T6XOKgj79U21cGCmJz8V_otxFMI4&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-mFWFbBOy8IotWqr04oERjUKhNu6MCyQ0igHqahndBoQ&oe=6A2C2BA8"}, {"file_name": "migrated_image.png", "id": "144304540242505", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/12331050_329187584112763_4810020976727162880_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cleTAZNAEMMQ7kNvwG5TvKx&_nc_oc=AdqC3vS1iF8eKXL325nVkaT4wyXxpr3Il3g8si56vK792OIoF8SEEoiyrwDkktEhtBM&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9LbdSNTRlcigB96OOoXcwgncUvfxrdxbsdiUN1AojRdA&oe=6A2C2CCF"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "The Purge Day", "keywords": ["Horror", "Purge", "Day", "Shooter", "Aliens"], "long_description": "\u201cThe action is fast, the aliens look great and at times the immersion can be truly terrifying.\u201d - The VR Shop\n\n\u201cThis is fu*king horror shooter\u201d - Escape\n\nSomething strange has happened. No one knows what. It is unstoppable. Our civilization is almost dead but Jack Bowman has to save his wife. Do you want to know how this story finishes?\nChoose your weapon and fight against alien swarm in Asian agglomeration.\nThe Purge Day is the first person narrative, immersive horror shooter designed exclusively for VR.\n\nTPD contains :\nSuspenseful story\nInteresting and challenging achievements\nHigh quality sounds and voiceovers\nA large selection of weapons\nImmersive and not easy gameplay\nA large number of opponents\nEach chapter finishes with a powerful boss \nNo motion sickness\n\nController not required but supported.", "short_description": "The Purge Day is the first person narrative, immersive horror shooter designed exclusively for VR.\nChoose your weapon and fight against alien swarm in Asian agglomeration."}]}, "developer_name": null, "developer_privacy_policy_url": "http://redlimbstudio.com/privacy-policy.html", "developer_terms_of_service_url": "http://redlimbstudio.com/privacy-policy.html", "publisher_name": "Red Limb Studio", "support_website_url": null, "website_url": "http://redlimbstudio.com/tpd.html", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["SHOOTER", "HORROR", "ACTION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD", "TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1146167436151886"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/12138933_1103676193080769_1835948143645032448_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PiQb0Eeu7d8Q7kNvwGPD3ey&_nc_oc=Ado_iHkdJd8WO4_HIwYo1tgm9VSZQL63r2f8wBkuZZa2gZdr3YgJSso33cJHW-P1IcU&_nc_zt=3&_nc_ht=sconte
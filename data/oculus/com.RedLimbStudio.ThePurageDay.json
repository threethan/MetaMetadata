x0yY&_nc_oc=AdpdcRFxosWp-1xlLKG_idfIozL2QoZr8fjADdOV9fWOwS9ZDdox8P3xpo2T0zPS-94&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_13nk6jvrsIabx5W92opGZkUgnZw2m-nxuuLTzkb3lLw&oe=6A2437F1"}, {"file_name": "migrated_image.png", "id": "503915403849657", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/12504647_1613397245621369_741789342199971840_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B7nOOwPB-pcQ7kNvwGdMSG7&_nc_oc=Ados_SdLBEnnv80gAd7LG9oD3ddhWjn9HFI1rRHVLShsKYiMxQhNl_fGV6UFBZaFKiI&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8mMKHZVz33N9KVLFAw7sW0ACSSB3UssuU4HCLUiNy_qw&oe=6A2415A3"}, {"file_name": "migrated_image.png", "id": "214678446270570", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/11162678_367766243614273_8732669583745351680_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3Csce3sJg8gQ7kNvwGEecp5&_nc_oc=AdoT1RJ1N5aBg4f7G2OoFbG3-QXl77rAWIfx6qYjE4vJzPwNflBF8q9Pkym2DP5KFm4&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8QEeSUBK7jgknEZ5_5a4_D8vup46QyOsk8NrS0KDlCAg&oe=6A2442A8"}, {"file_name": "migrated_image.png", "id": "144304540242505", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/12331050_329187584112763_4810020976727162880_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Q_o45AOE4V0Q7kNvwEPBavn&_nc_oc=AdqUkcEQ9SZRFOgFB37IdpBT349uejTimFF8jgHkhx0YYOrrg4d5iOkvcZnLeAOnVh4&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8c5byD47fL5f57uDqYykxVkvWUFST236LlFWyORPUjCw&oe=6A2443CF"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "The Purge Day", "keywords": ["Horror", "Purge", "Day", "Shooter", "Aliens"], "long_description": "\u201cThe action is fast, the aliens look great and at times the immersion can be truly terrifying.\u201d - The VR Shop\n\n\u201cThis is fu*king horror shooter\u201d - Escape\n\nSomething strange has happened. No one knows what. It is unstoppable. Our civilization is almost dead but Jack Bowman has to save his wife. Do you want to know how this story finishes?\nChoose your weapon and fight against alien swarm in Asian agglomeration.\nThe Purge Day is the first person narrative, immersive horror shooter designed exclusively for VR.\n\nTPD contains :\nSuspenseful story\nInteresting and challenging achievements\nHigh quality sounds and voiceovers\nA large selection of weapons\nImmersive and not easy gameplay\nA large number of opponents\nEach chapter finishes with a powerful boss \nNo motion sickness\n\nController not required but supported.", "short_description": "The Purge Day is the first person narrative, immersive horror shooter designed exclusively for VR.\nChoose your weapon and fight against alien swarm in Asian agglomeration."}]}, "developer_name": null, "developer_privacy_policy_url": "http://redlimbstudio.com/privacy-policy.html", "developer_terms_of_service_url": "http://redlimbstudio.com/privacy-policy.html", "publisher_name": "Red Limb Studio", "support_website_url": null, "website_url": "http://redlimbstudio.com/tpd.html", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["SHOOTER", "HORROR", "ACTION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD", "TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1146167436151886"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/12138933_1103676193080769_1835948143645032448_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PnFl5GvYhrAQ7kNvwFSpp3x&_nc_oc=AdrlSYvOASpx0bePzW8qSr_VrDhVha_ZvHw-bS9OH2PjK9boB4jokcE_2hJSYXdVmDI&_nc_zt=3&_nc_ht=sconte
-iad3-1.oculuscdn.com&oh=00_AfuNVZr0GJhNWr9Fs4sl1grQlgeH0GvpB2HqBc3ksVu6zg&oe=69A029B1"}, {"file_name": "migrated_image.png", "id": "503915403849657", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/12504647_1613397245621369_741789342199971840_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uCP5ZR2pYVAQ7kNvwH8PeSm&_nc_oc=AdlfNcfDcID5q6DfAcAqLuAVTkxRopZZsLlxc5HwqjFa_KydmkSQSmSIz7eVT3BYgA8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afs5Guvl7eP2jO7dV8XUHkk4r4lfTfT3rCVM-Hyo7q-cZw&oe=69A03FA3"}, {"file_name": "migrated_image.png", "id": "214678446270570", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/11162678_367766243614273_8732669583745351680_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PnVFo330HMAQ7kNvwFoyWVb&_nc_oc=AdlkRjgKZPdbdtk81KV02dCebzz1B8cGUzpVmWbRZWJxzwfL1EHurcC76LX-gtwApOw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfvfAL3eDJEFkZ9s1iwSzG07Z2DEFUAE0-dyus14TFI1vQ&oe=69A03468"}, {"file_name": "migrated_image.png", "id": "144304540242505", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/12331050_329187584112763_4810020976727162880_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MVyBsSRXgoYQ7kNvwFDBrr1&_nc_oc=AdnQvdaKTA2siXiziBk4hsY6fWxIcVy96jqfVJSMAxl6NwlOdNYM9XIaa_bbh15XjyY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfsmLEE-3C811oMoFQRTerTtzWEQS_el_tH2Rg8s3VIY4Q&oe=69A0358F"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "The Purge Day", "keywords": ["Horror", "Purge", "Day", "Shooter", "Aliens"], "long_description": "\u201cThe action is fast, the aliens look great and at times the immersion can be truly terrifying.\u201d - The VR Shop\n\n\u201cThis is fu*king horror shooter\u201d - Escape\n\nSomething strange has happened. No one knows what. It is unstoppable. Our civilization is almost dead but Jack Bowman has to save his wife. Do you want to know how this story finishes?\nChoose your weapon and fight against alien swarm in Asian agglomeration.\nThe Purge Day is the first person narrative, immersive horror shooter designed exclusively for VR.\n\nTPD contains :\nSuspenseful story\nInteresting and challenging achievements\nHigh quality sounds and voiceovers\nA large selection of weapons\nImmersive and not easy gameplay\nA large number of opponents\nEach chapter finishes with a powerful boss \nNo motion sickness\n\nController not required but supported.", "short_description": "The Purge Day is the first person narrative, immersive horror shooter designed exclusively for VR.\nChoose your weapon and fight against alien swarm in Asian agglomeration."}]}, "developer_name": null, "developer_privacy_policy_url": "http://redlimbstudio.com/privacy-policy.html", "developer_terms_of_service_url": "http://redlimbstudio.com/privacy-policy.html", "publisher_name": "Red Limb Studio", "support_website_url": null, "website_url": "http://redlimbstudio.com/tpd.html", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["SHOOTER", "HORROR", "ACTION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD", "TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1146167436151886"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/12138933_1103676193080769_1835948143645032448_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ulI2sjLMvL4Q7kNvwEFJncI&_nc_oc=Adl8L1VkLR264dxJafW_G92s9IKI2_C911KYge4q6msueQaTmtOrRR46zuEwnsEVEtc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Aft5gQzaQ5-MaWxapeNTBQLSMYakznn4YbXJhiMhA6HdKQ&oe=69A049AD"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": f
LRAM&_nc_oc=AdruV-Z5zXh9YiuYbKmTUD6hDPg1IxFLBM6z_CFb0ECWUgIr9qreySEAcGDcUtLisvU&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af87uwAfK5UdULeDzJVeZd3Zb6OeHv-U2jz3v_4HV07-Xg&oe=6A32B871"}, {"file_name": "migrated_image.png", "id": "503915403849657", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/12504647_1613397245621369_741789342199971840_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wbWgc_VvgAUQ7kNvwGz2o3a&_nc_oc=AdqlbGdllK0-Ve5oHSt7BTYJ9Eb50Vz0Gpc1mSncppDF-Gt2dzW8cvPMf_Z_Hf25SZI&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_nXOcExR_TidhSodoco8LW9-jVg2dOjqRy8CsqndqLmw&oe=6A329623"}, {"file_name": "migrated_image.png", "id": "214678446270570", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/11162678_367766243614273_8732669583745351680_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WXMRrGIcmEwQ7kNvwFPThwl&_nc_oc=AdpM2iXF0AoSsKhpCNw8OmxyY4fDZ9-TQlD3dMAy7ucAI-u7cISz16MTDFcZzYnFwkY&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_grlO2p084-XVGOPwVJsYrV6FNVTsFqaEQz3LKIbFQxA&oe=6A32C328"}, {"file_name": "migrated_image.png", "id": "144304540242505", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/12331050_329187584112763_4810020976727162880_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qLkHaEcEOZUQ7kNvwHRjBbT&_nc_oc=AdpLtONgQFMGuOwha3vwUKyBHvw6NFJFsZBdnBz4QeMwgzGpP2TDggUzfPrWYv6Tl1Q&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-bC_OyXWNjrBB714kJ42gnytDHCjQBdufG7tHx-GJFxg&oe=6A32C44F"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "The Purge Day", "keywords": ["Horror", "Purge", "Day", "Shooter", "Aliens"], "long_description": "\u201cThe action is fast, the aliens look great and at times the immersion can be truly terrifying.\u201d - The VR Shop\n\n\u201cThis is fu*king horror shooter\u201d - Escape\n\nSomething strange has happened. No one knows what. It is unstoppable. Our civilization is almost dead but Jack Bowman has to save his wife. Do you want to know how this story finishes?\nChoose your weapon and fight against alien swarm in Asian agglomeration.\nThe Purge Day is the first person narrative, immersive horror shooter designed exclusively for VR.\n\nTPD contains :\nSuspenseful story\nInteresting and challenging achievements\nHigh quality sounds and voiceovers\nA large selection of weapons\nImmersive and not easy gameplay\nA large number of opponents\nEach chapter finishes with a powerful boss \nNo motion sickness\n\nController not required but supported.", "short_description": "The Purge Day is the first person narrative, immersive horror shooter designed exclusively for VR.\nChoose your weapon and fight against alien swarm in Asian agglomeration."}]}, "developer_name": null, "developer_privacy_policy_url": "http://redlimbstudio.com/privacy-policy.html", "developer_terms_of_service_url": "http://redlimbstudio.com/privacy-policy.html", "publisher_name": "Red Limb Studio", "support_website_url": null, "website_url": "http://redlimbstudio.com/tpd.html", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["SHOOTER", "HORROR", "ACTION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD", "TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1146167436151886"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/12138933_1103676193080769_1835948143645032448_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dRDP29reKQAQ7kNvwG6RO0t&_nc_oc=Adr__--mciHGLOy9-OZBPRZxo4k1FdZHa7fuy5uy2r70n7Nd9PrrFC8sdW7oGSVkKLY&_nc_zt=3&_nc_ht=sconte
j4PfkOf-5bgMVVW1H_7NQSpTI4N8Ix4Dd9pSOA56jM28PYk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afvvd-2Wv6kdsFzimvswNDU10qhmntlW8q33FoaouFuYhQ&oe=69A812B1"}, {"file_name": "migrated_image.png", "id": "503915403849657", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12504647_1613397245621369_741789342199971840_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xe5o8WdiLOsQ7kNvwEuybIK&_nc_oc=AdmTHP4jhgcTV22HI5nciV4yTY7XuOODjjpLl_2Q-fV4n1JnmhvU309k2dLWMtwvmvU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Aftc80d31vz6GezqBIG5FI9UB_DBb0djT0VrRYqrZY4kYQ&oe=69A828A3"}, {"file_name": "migrated_image.png", "id": "214678446270570", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/11162678_367766243614273_8732669583745351680_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sH_oE4a9cuAQ7kNvwEB6cwS&_nc_oc=Adn3AfV3g-045TefQeRn6occb4uExnL6tnN4Cy7d_X2bd8LHGv_K6fVxq3YuFCCil9c&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfuNdEzO-lvd3EWqdMuYpl2IfuNq0l30OBSSgZZmR9esdQ&oe=69A81D68"}, {"file_name": "migrated_image.png", "id": "144304540242505", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12331050_329187584112763_4810020976727162880_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mvbTrX8aGw8Q7kNvwFtsZrF&_nc_oc=AdmjP7GF2Xg7SmPJyvvFvCzXqnwiY1kVOAVvumveBi1kpHOzjs6cgK-J1ms4KacYSq0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AftItvBn6E0onvv2NWCIv4k7KEVeT0IWwljOLag4JwYwpQ&oe=69A81E8F"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "The Purge Day", "keywords": ["Horror", "Purge", "Day", "Shooter", "Aliens"], "long_description": "\u201cThe action is fast, the aliens look great and at times the immersion can be truly terrifying.\u201d - The VR Shop\n\n\u201cThis is fu*king horror shooter\u201d - Escape\n\nSomething strange has happened. No one knows what. It is unstoppable. Our civilization is almost dead but Jack Bowman has to save his wife. Do you want to know how this story finishes?\nChoose your weapon and fight against alien swarm in Asian agglomeration.\nThe Purge Day is the first person narrative, immersive horror shooter designed exclusively for VR.\n\nTPD contains :\nSuspenseful story\nInteresting and challenging achievements\nHigh quality sounds and voiceovers\nA large selection of weapons\nImmersive and not easy gameplay\nA large number of opponents\nEach chapter finishes with a powerful boss \nNo motion sickness\n\nController not required but supported.", "short_description": "The Purge Day is the first person narrative, immersive horror shooter designed exclusively for VR.\nChoose your weapon and fight against alien swarm in Asian agglomeration."}]}, "developer_name": null, "developer_privacy_policy_url": "http://redlimbstudio.com/privacy-policy.html", "developer_terms_of_service_url": "http://redlimbstudio.com/privacy-policy.html", "publisher_name": "Red Limb Studio", "support_website_url": null, "website_url": "http://redlimbstudio.com/tpd.html", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["SHOOTER", "HORROR", "ACTION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD", "TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1146167436151886"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12138933_1103676193080769_1835948143645032448_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7qeYGMP5N_0Q7kNvwGT9szX&_nc_oc=AdmlJq0NY2azZW4L-RfaI74bXMciV5QZ1-l75K0k5in0qsi77C7lAzeGbCRkyc1xMHM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfuM65DcN
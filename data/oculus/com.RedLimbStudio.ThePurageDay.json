2fpP&_nc_oc=Adpno0cLQg18EjPP8fjMik06odgD77HrzhCDu9XvSzVnT8GW_lByoZm6Bbqw4XLWxB4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBSHw1ivWu1iV0aML8y29HsHvrEBEueod90EtXOAEA0Rg&oe=6A637FF1"}, {"file_name": "migrated_image.png", "id": "503915403849657", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/12504647_1613397245621369_741789342199971840_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2U7m6p1irjMQ7kNvwEhA-71&_nc_oc=Adoww05Iz_pu-wDlolh9ycSs0skWmTgkrDB0xZEuhpT48FbJca6tWUAWwVW1jCElb4M&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCABBFsz13NRQVIxaHk7szdpZio2i1pQbZIKF4VPvtZHg&oe=6A635DA3"}, {"file_name": "migrated_image.png", "id": "214678446270570", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/11162678_367766243614273_8732669583745351680_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Rsn1_oar4Y8Q7kNvwF26SBX&_nc_oc=Adr25rF1nmpPT6iyxZ-Zbs3WOjEQ0S93w34H-6WlUdFsjoSGVjfyfRV0CmoO1TBkf4E&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAJOTYpo-U738W_k8o6uH-TAIg8NTJtF0mVq0QZJGqVJQ&oe=6A635268"}, {"file_name": "migrated_image.png", "id": "144304540242505", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/12331050_329187584112763_4810020976727162880_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W1cnGQ79bicQ7kNvwHbfgeg&_nc_oc=AdqrMDBbePNwb-4BCthDh6gIi8FGw_3bF3pqSQsicRFsJPaYyZKLGjTo6j14da4F8u8&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAVxu6JIy9ZUZrzivo6YKSW29-Gr8GAGk_hlkprT0vmIA&oe=6A63538F"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "The Purge Day", "keywords": ["Horror", "Purge", "Day", "Shooter", "Aliens"], "long_description": "\u201cThe action is fast, the aliens look great and at times the immersion can be truly terrifying.\u201d - The VR Shop\n\n\u201cThis is fu*king horror shooter\u201d - Escape\n\nSomething strange has happened. No one knows what. It is unstoppable. Our civilization is almost dead but Jack Bowman has to save his wife. Do you want to know how this story finishes?\nChoose your weapon and fight against alien swarm in Asian agglomeration.\nThe Purge Day is the first person narrative, immersive horror shooter designed exclusively for VR.\n\nTPD contains :\nSuspenseful story\nInteresting and challenging achievements\nHigh quality sounds and voiceovers\nA large selection of weapons\nImmersive and not easy gameplay\nA large number of opponents\nEach chapter finishes with a powerful boss \nNo motion sickness\n\nController not required but supported.", "short_description": "The Purge Day is the first person narrative, immersive horror shooter designed exclusively for VR.\nChoose your weapon and fight against alien swarm in Asian agglomeration."}]}, "developer_name": null, "developer_privacy_policy_url": "http://redlimbstudio.com/privacy-policy.html", "developer_terms_of_service_url": "http://redlimbstudio.com/privacy-policy.html", "publisher_name": "Red Limb Studio", "support_website_url": null, "website_url": "http://redlimbstudio.com/tpd.html", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["SHOOTER", "HORROR", "ACTION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD", "TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1146167436151886"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12138933_1103676193080769_1835948143645032448_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_vKdGRhjiC0Q7kNvwGRQwRb&_nc_oc=Adp7sBrUmD-aS1iGwcKV1Sngcpj7BwKNAgosqQZkphdom9k5wT_ULcFCgaWtYxyMAuY&_nc_zt=3&_nc_ht=sconte
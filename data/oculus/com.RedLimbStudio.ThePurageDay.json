9mb&_nc_oc=AdpSKevnjuVm-mSUnKakgyfe98vTTJVDp4wgEnyAQElcN2T8sN5lChBVGciyjews50A&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOi7UbwfSTjPhJf5EXZoTjp9JeQK2QyT37j6PifbZbsLg&oe=6AC90371"}, {"file_name": "migrated_image.png", "id": "503915403849657", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/12504647_1613397245621369_741789342199971840_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CvenHm_9sqUQ7kNvwFqHJPI&_nc_oc=AdoFHNDuWm94D8-6JSN1sUaJpEdJXK-SD7i4LQRIjyAMhasytCU4XYPITiHIKU1Igi0&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMXlEim1LALJ70ZrO00ZNa0i01LmUmxVegZbr_xDkbgrg&oe=6AC91963"}, {"file_name": "migrated_image.png", "id": "214678446270570", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/11162678_367766243614273_8732669583745351680_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oOvLuR6-6dEQ7kNvwHmFIny&_nc_oc=Adqm_-sgYmbf4LZ-kYKRW44xTyInwTz1DPr2HODIyEbdIIevwhnGbcXh8ar5R4mz_JA&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMFX6iHD5AalQNTIED8_1CNkZ97_eYBVzyzU0PNBb7MyA&oe=6AC90E28"}, {"file_name": "migrated_image.png", "id": "144304540242505", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/12331050_329187584112763_4810020976727162880_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rmCIc0G9F3cQ7kNvwFdplFT&_nc_oc=Ado4geaefKvLd67IORhAlX3x56vHvYlBliTP0itRH4ggrIIbLrHzwcxz-Tz6hMhl-5I&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMfPvI3NlBastjntQwb632CrnGCVv8aIJXJ_cQ51o_P4A&oe=6AC90F4F"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "The Purge Day", "keywords": ["Horror", "Purge", "Day", "Shooter", "Aliens"], "long_description": "\u201cThe action is fast, the aliens look great and at times the immersion can be truly terrifying.\u201d - The VR Shop\n\n\u201cThis is fu*king horror shooter\u201d - Escape\n\nSomething strange has happened. No one knows what. It is unstoppable. Our civilization is almost dead but Jack Bowman has to save his wife. Do you want to know how this story finishes?\nChoose your weapon and fight against alien swarm in Asian agglomeration.\nThe Purge Day is the first person narrative, immersive horror shooter designed exclusively for VR.\n\nTPD contains :\nSuspenseful story\nInteresting and challenging achievements\nHigh quality sounds and voiceovers\nA large selection of weapons\nImmersive and not easy gameplay\nA large number of opponents\nEach chapter finishes with a powerful boss \nNo motion sickness\n\nController not required but supported.", "short_description": "The Purge Day is the first person narrative, immersive horror shooter designed exclusively for VR.\nChoose your weapon and fight against alien swarm in Asian agglomeration."}]}, "developer_name": null, "developer_privacy_policy_url": "http://redlimbstudio.com/privacy-policy.html", "developer_terms_of_service_url": "http://redlimbstudio.com/privacy-policy.html", "publisher_name": "Red Limb Studio", "support_website_url": null, "website_url": "http://redlimbstudio.com/tpd.html", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["SHOOTER", "HORROR", "ACTION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD", "TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1146167436151886"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/12138933_1103676193080769_1835948143645032448_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vVwWKPbQb6YQ7kNvwFPIWj6&_nc_oc=AdoB0fWk1ZMMWvJZubifJDKw_JYramGlEMf-N5l0eJ1eEG8yotoG1Zc-U2-CdNqJdXw&_nc_zt=3&_nc_ht=sconten
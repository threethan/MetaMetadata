6Jy&_nc_oc=AdoI7Nb7BYJ53XNDXyMxZRt_x7-2YnOsA_1BZeAOC6chLPAK9-10woEsCb1TWOTKPnE&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKrcees3LBAYlVY_CZXfIqQzccNWq4HGqQDjBjSDQ2xDQ&oe=6AB68E71"}, {"file_name": "migrated_image.png", "id": "503915403849657", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/12504647_1613397245621369_741789342199971840_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-LCX66FeTJ0Q7kNvwFMB6v7&_nc_oc=AdpEpo5jwJNa9sjBBWnNo4XReqs5W2pbOSu8CSo20068fpqbOzC71FkzoIbMS21oVpE&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIW8tonzPbUodyufgXUga8V_2CBx8sSgKDGrL3qMyES-g&oe=6AB66C23"}, {"file_name": "migrated_image.png", "id": "214678446270570", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/11162678_367766243614273_8732669583745351680_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sNnniD90ujoQ7kNvwHB-j2D&_nc_oc=AdqGYafZM8tRZ8PjMDGp7FiPDKYjLA5jiNUJeeEoyYJfwfD9FyIAIqP0oiTcPRaRneI&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLD_i3EZn3lNymSBTBlIbce8NVMw9Xmo0AQscIC8AUtMA&oe=6AB69928"}, {"file_name": "migrated_image.png", "id": "144304540242505", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/12331050_329187584112763_4810020976727162880_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Tt9zticNA5oQ7kNvwGkrLrU&_nc_oc=AdrMZ8exYYacL1evHuUrdQmU4-F1Z6xBbEKbr_D3ZLXu9ThyVQNBYfo6-syfFCuPZAQ&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKcMeUyJXjeONv1PwTT_iLR-8sTztJPfTHDpXAOTvbxGA&oe=6AB69A4F"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "The Purge Day", "keywords": ["Horror", "Purge", "Day", "Shooter", "Aliens"], "long_description": "\u201cThe action is fast, the aliens look great and at times the immersion can be truly terrifying.\u201d - The VR Shop\n\n\u201cThis is fu*king horror shooter\u201d - Escape\n\nSomething strange has happened. No one knows what. It is unstoppable. Our civilization is almost dead but Jack Bowman has to save his wife. Do you want to know how this story finishes?\nChoose your weapon and fight against alien swarm in Asian agglomeration.\nThe Purge Day is the first person narrative, immersive horror shooter designed exclusively for VR.\n\nTPD contains :\nSuspenseful story\nInteresting and challenging achievements\nHigh quality sounds and voiceovers\nA large selection of weapons\nImmersive and not easy gameplay\nA large number of opponents\nEach chapter finishes with a powerful boss \nNo motion sickness\n\nController not required but supported.", "short_description": "The Purge Day is the first person narrative, immersive horror shooter designed exclusively for VR.\nChoose your weapon and fight against alien swarm in Asian agglomeration."}]}, "developer_name": null, "developer_privacy_policy_url": "http://redlimbstudio.com/privacy-policy.html", "developer_terms_of_service_url": "http://redlimbstudio.com/privacy-policy.html", "publisher_name": "Red Limb Studio", "support_website_url": null, "website_url": "http://redlimbstudio.com/tpd.html", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["SHOOTER", "HORROR", "ACTION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD", "TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1146167436151886"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/12138933_1103676193080769_1835948143645032448_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-YQuD3MzrDEQ7kNvwEDn2ZV&_nc_oc=AdqOU515jC8h-Odi9X2v27iRu24qZa07U-HD-5O_GEqFtB59iWsZ7J8Zsp26BDo7ILM&_nc_zt=3&_nc_ht=sconten
C2Wc&_nc_oc=Adq9CZjzs9pkW9VJ6v-tSUrUalgZNXj0YdMJZVl7aF2elQTkNplUWbrxkc2g1K5sbSg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4kYYE-mXaed0c-AiJCb6Uq6fwogsARNCh5lkExXwowIQ&oe=6A0736F1"}, {"file_name": "migrated_image.png", "id": "503915403849657", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/12504647_1613397245621369_741789342199971840_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A5Uvve062O0Q7kNvwGLeWsW&_nc_oc=AdoScE1XTf7kYJidcNjq-HZKEt-Xva8nPW9tlFwTcxqE1HzZ4OlNDXx7MN2TLXTlHlY&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5WHZESb2_2X1jXGfv4m_3zKQmAXcyKZL_TfU5Wc9tuIQ&oe=6A0714A3"}, {"file_name": "migrated_image.png", "id": "214678446270570", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/11162678_367766243614273_8732669583745351680_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b9Jzvu1bGfUQ7kNvwE1kl7_&_nc_oc=Adq5HCi1Nk53hOuLbhtyN4VCWaXnNDym0wOU5SwzlxNx-dmYYXzzv1E6CNQ82quMNNQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af602XT56--9UKzqa2pofoFoxvthDZkL8f0DUgQ7pJ4bww&oe=6A0741A8"}, {"file_name": "migrated_image.png", "id": "144304540242505", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/12331050_329187584112763_4810020976727162880_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_Mtw-3pIV6cQ7kNvwE4MzjL&_nc_oc=Adr-ndXuNPC7ng9VGNzflCnJ8CGlGG5pWxm3Cx0uu4SQ4vgF_WwBUIG4ZxgC0YnYuig&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4u0HdWOFhJW_VSaP5AjPcs0Mm1lvxvalStga-kR1ZxhQ&oe=6A0742CF"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "The Purge Day", "keywords": ["Horror", "Purge", "Day", "Shooter", "Aliens"], "long_description": "\u201cThe action is fast, the aliens look great and at times the immersion can be truly terrifying.\u201d - The VR Shop\n\n\u201cThis is fu*king horror shooter\u201d - Escape\n\nSomething strange has happened. No one knows what. It is unstoppable. Our civilization is almost dead but Jack Bowman has to save his wife. Do you want to know how this story finishes?\nChoose your weapon and fight against alien swarm in Asian agglomeration.\nThe Purge Day is the first person narrative, immersive horror shooter designed exclusively for VR.\n\nTPD contains :\nSuspenseful story\nInteresting and challenging achievements\nHigh quality sounds and voiceovers\nA large selection of weapons\nImmersive and not easy gameplay\nA large number of opponents\nEach chapter finishes with a powerful boss \nNo motion sickness\n\nController not required but supported.", "short_description": "The Purge Day is the first person narrative, immersive horror shooter designed exclusively for VR.\nChoose your weapon and fight against alien swarm in Asian agglomeration."}]}, "developer_name": null, "developer_privacy_policy_url": "http://redlimbstudio.com/privacy-policy.html", "developer_terms_of_service_url": "http://redlimbstudio.com/privacy-policy.html", "publisher_name": "Red Limb Studio", "support_website_url": null, "website_url": "http://redlimbstudio.com/tpd.html", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["SHOOTER", "HORROR", "ACTION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD", "TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1146167436151886"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12138933_1103676193080769_1835948143645032448_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SwiNPplpiocQ7kNvwE8Umi6&_nc_oc=Adrj-N0LLBCYEV9AWqJNdawiZu3hORaFfNkKUUg1ALgwMTVCHN6M7nZ6nBOmFUcoGpQ&_nc_zt=3&_nc_ht=sconte
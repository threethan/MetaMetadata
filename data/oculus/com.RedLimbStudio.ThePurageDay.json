AFT&_nc_oc=AdpR80wlTj_s1uzLpZkRVQk_4PGqK3KyNfyOyJn0i67nPOvrphG6bvJ-_IaXrn9jGnA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNj_mKhp3lCHx-FdoaovtJUBMPwM6RM_Gsjs1h4_2Iz_w&oe=6ADF6CF1"}, {"file_name": "migrated_image.png", "id": "503915403849657", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/12504647_1613397245621369_741789342199971840_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9MZutE6IR0UQ7kNvwGtw47q&_nc_oc=AdodSicNrDcHSk1gsZhOuvk0Y_RoQbo5fZ5Vs7MDHRZKzEtX3qGkvUNKHU7WNFlbBf0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNvhkfMtwsa0jEghx3wntYSkqOj9qaWDfMkwT5xV8b-uw&oe=6ADF4AA3"}, {"file_name": "migrated_image.png", "id": "214678446270570", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/11162678_367766243614273_8732669583745351680_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g7SitXBGIsUQ7kNvwHOunjQ&_nc_oc=AdoNH2ci1OFfil4RIGSj_V0vgQst8TKPGxte2uTkOwKVgesz2Yk5X-97kjL45yrWq7A&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPny0fGQ774ifkrw4YzrahynrXRZmjd5LeFNm7vyX9W3Q&oe=6ADF77A8"}, {"file_name": "migrated_image.png", "id": "144304540242505", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12331050_329187584112763_4810020976727162880_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=04K2RLDtJ3UQ7kNvwHzNoZp&_nc_oc=AdozdyMc4QD-LK879-ohw6-MvD6Q62DfLWLoSPlCUidZB3IMKpltyotpg5rhB5dKQT0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMzFfVuayt2n-hzQkUWAOI-0D_qQC0uVlYtrCaxO0I8pA&oe=6ADF78CF"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "The Purge Day", "keywords": ["Horror", "Purge", "Day", "Shooter", "Aliens"], "long_description": "\u201cThe action is fast, the aliens look great and at times the immersion can be truly terrifying.\u201d - The VR Shop\n\n\u201cThis is fu*king horror shooter\u201d - Escape\n\nSomething strange has happened. No one knows what. It is unstoppable. Our civilization is almost dead but Jack Bowman has to save his wife. Do you want to know how this story finishes?\nChoose your weapon and fight against alien swarm in Asian agglomeration.\nThe Purge Day is the first person narrative, immersive horror shooter designed exclusively for VR.\n\nTPD contains :\nSuspenseful story\nInteresting and challenging achievements\nHigh quality sounds and voiceovers\nA large selection of weapons\nImmersive and not easy gameplay\nA large number of opponents\nEach chapter finishes with a powerful boss \nNo motion sickness\n\nController not required but supported.", "short_description": "The Purge Day is the first person narrative, immersive horror shooter designed exclusively for VR.\nChoose your weapon and fight against alien swarm in Asian agglomeration."}]}, "developer_name": null, "developer_privacy_policy_url": "http://redlimbstudio.com/privacy-policy.html", "developer_terms_of_service_url": "http://redlimbstudio.com/privacy-policy.html", "publisher_name": "Red Limb Studio", "support_website_url": null, "website_url": "http://redlimbstudio.com/tpd.html", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["SHOOTER", "HORROR", "ACTION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD", "TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1146167436151886"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12138933_1103676193080769_1835948143645032448_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3IqTGVd9D-MQ7kNvwFh3WYI&_nc_oc=AdrEC-8YxqPrgl81Y9WMlKLBbE8GkP-x95ZTGVLJh3tiArf_43FoQOredL5Ejc36MaE&_nc_zt=3&_nc_ht=sconten
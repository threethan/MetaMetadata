lEU&_nc_oc=AdpHylqWks4KVm7UV2dgDDOkOo_kERtEuAacx9OQTCKDfh7rEIzRBtwnpLst6oJd3-o&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEZSUfnggqINR0K4eybeD8R3-rCV-13FKtNPMsHVEgfbQ&oe=6A9722B1"}, {"file_name": "migrated_image.png", "id": "503915403849657", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/12504647_1613397245621369_741789342199971840_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AYwQJoB9J-kQ7kNvwHFd0QD&_nc_oc=AdpyReqSO-VmBp6unb7SLNcQUhJoIMqn78S5_wGP-rwnFGq9MCm143LorMVQ6wFK7SU&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEx4GIuAkNAuE6YirlS-xTcNsvjUcYsoPGrecn2FUAckA&oe=6A9738A3"}, {"file_name": "migrated_image.png", "id": "214678446270570", "uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/11162678_367766243614273_8732669583745351680_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2yX1wlb88AQQ7kNvwHq0dft&_nc_oc=AdqLwQGdJPzddOsJfZ8xIjlUTB7jeQdR1c6NAiaay3PCa6Wxb2Aq3P1U1Q01QRcJDIA&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF8NgXsmpELMNZYINup5ewEa46jTKGRFqxlzN2WMEQH_w&oe=6A972D68"}, {"file_name": "migrated_image.png", "id": "144304540242505", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/12331050_329187584112763_4810020976727162880_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vekT7JjL6GIQ7kNvwFjI9bB&_nc_oc=Adpx7vbRYq3lN_k_a8CVv1Lj-R2r3EcCyMB-ku2Uh8q5jAynIEwiLGe83uME2barnUQ&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEAW1_yq8E0PnQWALrJhMmMriMUhqv4A9Eg-W0LkT9FvA&oe=6A972E8F"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "The Purge Day", "keywords": ["Horror", "Purge", "Day", "Shooter", "Aliens"], "long_description": "\u201cThe action is fast, the aliens look great and at times the immersion can be truly terrifying.\u201d - The VR Shop\n\n\u201cThis is fu*king horror shooter\u201d - Escape\n\nSomething strange has happened. No one knows what. It is unstoppable. Our civilization is almost dead but Jack Bowman has to save his wife. Do you want to know how this story finishes?\nChoose your weapon and fight against alien swarm in Asian agglomeration.\nThe Purge Day is the first person narrative, immersive horror shooter designed exclusively for VR.\n\nTPD contains :\nSuspenseful story\nInteresting and challenging achievements\nHigh quality sounds and voiceovers\nA large selection of weapons\nImmersive and not easy gameplay\nA large number of opponents\nEach chapter finishes with a powerful boss \nNo motion sickness\n\nController not required but supported.", "short_description": "The Purge Day is the first person narrative, immersive horror shooter designed exclusively for VR.\nChoose your weapon and fight against alien swarm in Asian agglomeration."}]}, "developer_name": null, "developer_privacy_policy_url": "http://redlimbstudio.com/privacy-policy.html", "developer_terms_of_service_url": "http://redlimbstudio.com/privacy-policy.html", "publisher_name": "Red Limb Studio", "support_website_url": null, "website_url": "http://redlimbstudio.com/tpd.html", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["SHOOTER", "HORROR", "ACTION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD", "TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1146167436151886"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/12138933_1103676193080769_1835948143645032448_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4NNYnLYDOFEQ7kNvwGYwOug&_nc_oc=AdqK9UiKAvol-aunTuhdjav2SD1YkcvEN8NROQLtWWe1yeoznY5Hmj6dqylnL74xp8k&_nc_zt=3&_nc_ht=sconten
WtHV&_nc_oc=AdpyB8zsKBgY2K-WoP8QIVINrzLyZLhgZZMCM5mjE6iQd8j115JKrt4FBE1gCBlzl5U&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1uoKCF1a5bPXUV46jF-n7GQ5GLZ-zhdOjgNMpgcPqJ2Q&oe=69EA35F1"}, {"file_name": "migrated_image.png", "id": "503915403849657", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12504647_1613397245621369_741789342199971840_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wWQUoyBAcZYQ7kNvwFs36ze&_nc_oc=AdrSLbSI-FZaGZQcZ9qItC81sg8unUqHFPkIJCPQzAoLAp8V4t7qsHqI4No7vHHZdMc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3Cd3dTUlOfL9fYHwz4ILvIo1EAylEq_lbTCD92qQnPdA&oe=69EA13A3"}, {"file_name": "migrated_image.png", "id": "214678446270570", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/11162678_367766243614273_8732669583745351680_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V9FlkccKL4sQ7kNvwGrw9ZH&_nc_oc=AdpdhTsR-JDj_VeTiUzbC-AhE0a8SDsdy7ECNPyA0eVToYEFNap1I8y4n77XR4R_r98&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af06ACh_oNSFF9p1525TUezIiTCFyITQnh-SlQLKnjfKOw&oe=69EA0868"}, {"file_name": "migrated_image.png", "id": "144304540242505", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/12331050_329187584112763_4810020976727162880_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XS087O8Tv-0Q7kNvwEDsfoL&_nc_oc=AdpAwD4dLM8_ufMsCb_HUcogtKBdAL9cxeWCZ19MjBOHAP9iyA7mqkU3p3DmgmzLGuU&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3HfdjxjUiAdp2I7eC8NdESenByKc9Qtut8ymv7-dt7BA&oe=69EA098F"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "The Purge Day", "keywords": ["Horror", "Purge", "Day", "Shooter", "Aliens"], "long_description": "\u201cThe action is fast, the aliens look great and at times the immersion can be truly terrifying.\u201d - The VR Shop\n\n\u201cThis is fu*king horror shooter\u201d - Escape\n\nSomething strange has happened. No one knows what. It is unstoppable. Our civilization is almost dead but Jack Bowman has to save his wife. Do you want to know how this story finishes?\nChoose your weapon and fight against alien swarm in Asian agglomeration.\nThe Purge Day is the first person narrative, immersive horror shooter designed exclusively for VR.\n\nTPD contains :\nSuspenseful story\nInteresting and challenging achievements\nHigh quality sounds and voiceovers\nA large selection of weapons\nImmersive and not easy gameplay\nA large number of opponents\nEach chapter finishes with a powerful boss \nNo motion sickness\n\nController not required but supported.", "short_description": "The Purge Day is the first person narrative, immersive horror shooter designed exclusively for VR.\nChoose your weapon and fight against alien swarm in Asian agglomeration."}]}, "developer_name": null, "developer_privacy_policy_url": "http://redlimbstudio.com/privacy-policy.html", "developer_terms_of_service_url": "http://redlimbstudio.com/privacy-policy.html", "publisher_name": "Red Limb Studio", "support_website_url": null, "website_url": "http://redlimbstudio.com/tpd.html", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["SHOOTER", "HORROR", "ACTION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD", "TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1146167436151886"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12138933_1103676193080769_1835948143645032448_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Q1KcFKUEMkgQ7kNvwGbFjZ2&_nc_oc=AdqUKFEjUkYjk0rqkZfDJfbpUhZq4Ylm7EbYmzFjMPRRxmYgUvYbCnoSUhlc4g3DMLs&_nc_zt=3&_nc_ht=sconte
7PE&_nc_oc=AdrUX-Job2lflsOPF6PJWsVf2YxgrGhPmtkTU4fTikfZdb6DnGfq5dZ_ez0gIwmycpU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQSgRuByfiFGuCx9A2if6_1epW67iB2CRoX3xxTXN8omg&oe=6AF727F1"}, {"file_name": "migrated_image.png", "id": "503915403849657", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12504647_1613397245621369_741789342199971840_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ONW8wJVBqSEQ7kNvwExe4BS&_nc_oc=AdoULggFg-ip45Tt8vPiog_r3Yb_Rvz0LcT42vNNxUpyKdpzfWbr3_65q7ogJgYAJMA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTeqC1PWMSKNfO1-k0bmGq4l-bvdvkrQQ1oHIvf-5QqKA&oe=6AF73DE3"}, {"file_name": "migrated_image.png", "id": "214678446270570", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/11162678_367766243614273_8732669583745351680_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CWl7sX66vdAQ7kNvwGC8_D8&_nc_oc=AdqfOgPPFJd3P06DTgAk_wpOBFd9PxjMhQB4ZSMBEzoUfN6Thn0nd58WvdLxtoUJ8yk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQWRHLuhy1yVB4AcqcGYD_aEh0HqLZxN_uVjq1viL_C9A&oe=6AF732A8"}, {"file_name": "migrated_image.png", "id": "144304540242505", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12331050_329187584112763_4810020976727162880_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fcS8u9VLOAYQ7kNvwEtCq--&_nc_oc=Adq9AbHL_60O8hJes4ayhi9DNUqmW8-aUeyD22mGdoyqwNCzkAaw1snRg9egWxqM-Mg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTIwWqLvmhcpAESgNzxc1mMV1JFMKKYsLiaXFvEMPgLhw&oe=6AF733CF"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "The Purge Day", "keywords": ["Horror", "Purge", "Day", "Shooter", "Aliens"], "long_description": "\u201cThe action is fast, the aliens look great and at times the immersion can be truly terrifying.\u201d - The VR Shop\n\n\u201cThis is fu*king horror shooter\u201d - Escape\n\nSomething strange has happened. No one knows what. It is unstoppable. Our civilization is almost dead but Jack Bowman has to save his wife. Do you want to know how this story finishes?\nChoose your weapon and fight against alien swarm in Asian agglomeration.\nThe Purge Day is the first person narrative, immersive horror shooter designed exclusively for VR.\n\nTPD contains :\nSuspenseful story\nInteresting and challenging achievements\nHigh quality sounds and voiceovers\nA large selection of weapons\nImmersive and not easy gameplay\nA large number of opponents\nEach chapter finishes with a powerful boss \nNo motion sickness\n\nController not required but supported.", "short_description": "The Purge Day is the first person narrative, immersive horror shooter designed exclusively for VR.\nChoose your weapon and fight against alien swarm in Asian agglomeration."}]}, "developer_name": null, "developer_privacy_policy_url": "http://redlimbstudio.com/privacy-policy.html", "developer_terms_of_service_url": "http://redlimbstudio.com/privacy-policy.html", "publisher_name": "Red Limb Studio", "support_website_url": null, "website_url": "http://redlimbstudio.com/tpd.html", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["SHOOTER", "HORROR", "ACTION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD", "TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1146167436151886"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12138933_1103676193080769_1835948143645032448_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2ZkqzADqnOgQ7kNvwHP4y3N&_nc_oc=AdoyLZZE_6qGnEXMQiCeb5jQx7OcAb5fa7neBftJkZ0gBa6ixT21RHnBTL_81TzAWYM&_nc_zt=3&_nc_ht=sconten
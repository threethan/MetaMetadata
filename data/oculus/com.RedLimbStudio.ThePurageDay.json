qaO3&_nc_oc=AdqoaWDlLInM8qBzmisaco9Eza13jZUi0Kxo1Vq13XFoVuSQ03cja6_Rc15IQeRJWew&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDrmt9CzCNXJIxKS7QvRhEfTii6qwF6LE4-pEGHpMZ21g&oe=6A622E71"}, {"file_name": "migrated_image.png", "id": "503915403849657", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/12504647_1613397245621369_741789342199971840_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gIjXuKbe7GcQ7kNvwEIqyu3&_nc_oc=AdrUtAzg0Uk6o_rYhPiOTfc7I4KaDxjxg4RqkqpcoDG-ieYikfd2lH_eGOCN4G8I4LE&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBkr6sJZ0f8W7SO0BVMktxQhj_Hnb7ujsCclyjFs2OPzA&oe=6A620C23"}, {"file_name": "migrated_image.png", "id": "214678446270570", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/11162678_367766243614273_8732669583745351680_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Rsn1_oar4Y8Q7kNvwHDPHDk&_nc_oc=AdrZdZypJgAyWur9p3USSaywq4J00YhP7XFwAwCa1WAXuldbKLTKctplmQ7Jz7krdNQ&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB4FW0CcFa-NOsHyMsn7Exw8KEbOd9CRBWcFKCYO3cQ1Q&oe=6A6200E8"}, {"file_name": "migrated_image.png", "id": "144304540242505", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/12331050_329187584112763_4810020976727162880_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W1cnGQ79bicQ7kNvwGWAKKc&_nc_oc=AdqFct2yc1EyK6P8L4klGR6GHXIbsrCJJUA5K0O4tqt_R_BU2zEqS2DWrX1lyFl_gOc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDPdpxIHEojPDc7uYTIvzLhXBxG6zc77HWYzSZYLXlYtQ&oe=6A62020F"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "The Purge Day", "keywords": ["Horror", "Purge", "Day", "Shooter", "Aliens"], "long_description": "\u201cThe action is fast, the aliens look great and at times the immersion can be truly terrifying.\u201d - The VR Shop\n\n\u201cThis is fu*king horror shooter\u201d - Escape\n\nSomething strange has happened. No one knows what. It is unstoppable. Our civilization is almost dead but Jack Bowman has to save his wife. Do you want to know how this story finishes?\nChoose your weapon and fight against alien swarm in Asian agglomeration.\nThe Purge Day is the first person narrative, immersive horror shooter designed exclusively for VR.\n\nTPD contains :\nSuspenseful story\nInteresting and challenging achievements\nHigh quality sounds and voiceovers\nA large selection of weapons\nImmersive and not easy gameplay\nA large number of opponents\nEach chapter finishes with a powerful boss \nNo motion sickness\n\nController not required but supported.", "short_description": "The Purge Day is the first person narrative, immersive horror shooter designed exclusively for VR.\nChoose your weapon and fight against alien swarm in Asian agglomeration."}]}, "developer_name": null, "developer_privacy_policy_url": "http://redlimbstudio.com/privacy-policy.html", "developer_terms_of_service_url": "http://redlimbstudio.com/privacy-policy.html", "publisher_name": "Red Limb Studio", "support_website_url": null, "website_url": "http://redlimbstudio.com/tpd.html", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["SHOOTER", "HORROR", "ACTION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD", "TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1146167436151886"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/12138933_1103676193080769_1835948143645032448_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_vKdGRhjiC0Q7kNvwEVf3oK&_nc_oc=Adphr-0gAqHkoznFTOzT9GiPDfXwEb-thCWCJaO08bMD3dEPwSuvHc5lNo1qohJ4t-E&_nc_zt=3&_nc_ht=sconte
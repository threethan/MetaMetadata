oe=6999A823"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VideCover.png", "id": "233807520367930", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/12410461_233807523701263_7900757851851718656_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rUJ60dSDLVEQ7kNvwFt04OR&_nc_oc=Admk5Ei_J6heWf1HYuwgGwhUyFgHUGe9RT7qEz4J9TLC99vjJmuQKi5742v01kSgCpM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfvLZBJvf8tDl2AkoWf1lf8TZNf3pcdfe9w7hjd9eEIUtg&oe=6999BF80"}, "display_name": "The Purge Day", "keywords": ["Horror", "Purge", "Day", "Shooter", "Aliens"], "long_description": "Something strange has happened. No one knows what. It is unstoppable. Our civilization is almost dead but John Bowman has to save his wife. Do you want to know how this story finishes?\nChoose your weapon and fight against alien swarm in Asian agglomeration.\nThe Purge Day is the first person narrative, immersive horror shooter designed exclusively for VR.\n\nTPD contains :\nSuspenseful story\nInteresting and challenging achievements\nHigh quality sounds and voiceovers\nA large selection of weapons\nImmersive and not easy gameplay\nA large number of opponents\nEach chapter finishes with a powerful boss \nNo motion sickness\n\nController not required but supported.", "short_description": "The Purge Day is the first person narrative, immersive horror shooter designed exclusively for VR.\nChoose your weapon and fight against alien swarm in Asian agglomeration."}]}, "developer_name": null, "developer_privacy_policy_url": "http://redlimbstudio.com/privacy-policy.html", "developer_terms_of_service_url": "http://redlimbstudio.com/privacy-policy.html", "publisher_name": "Red Limb Studio", "support_website_url": null, "website_url": "http://redlimbstudio.com/tpd.html", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["SHOOTER", "HORROR", "ACTION"], "has_in
loLP&_nc_oc=AdoOv1eqCEqrz32I3RaVO4n_Eu2mJwwsm19kJo4SLSra5bqq6ZnbLYyHwRIPRPxDHHk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE6IAP-eI3Yk8ZBH1BsQNhZlZf3zHwfjOq_LzsYFm3auA&oe=6A7B3AF1"}, {"file_name": "migrated_image.png", "id": "503915403849657", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12504647_1613397245621369_741789342199971840_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ttRj5s0pW0wQ7kNvwE7OvxA&_nc_oc=Adq2tPKuZgzipU-VSm1vVwCYYMwSTd9kU-gjLRFExqjy67-GA03pIQcPMOkT38X2PCw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGA3loP-Z4J4f5gnX4FYv3Ev95rpSdlSaxlGHu62ECNag&oe=6A7B18A3"}, {"file_name": "migrated_image.png", "id": "214678446270570", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/11162678_367766243614273_8732669583745351680_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N80c9k9BfSgQ7kNvwE2TP_l&_nc_oc=Adro0pXIVBnFIbHp-m843N9VqGZSQsxi11XHbm965dWeYKo4n6uGzHggrApfqJcSJ3w&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEa2ELNJOjPOhaeAT7J_1Q2DcKPEFrsPi022cTHBAFmPQ&oe=6A7B0D68"}, {"file_name": "migrated_image.png", "id": "144304540242505", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/12331050_329187584112763_4810020976727162880_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aTK1nivrL0YQ7kNvwE6MuAr&_nc_oc=AdqrRGVX8Hcv7YjWX7qnxAyBfrWy5Fy8Qx4UgD1DWuZ2vw6xZwh_rW1bMmJtVWoGu9M&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHEyqC-7u6Via2aHdsDqAy7GrP_YOXFQ2El4YWXcaPYtg&oe=6A7B0E8F"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "The Purge Day", "keywords": ["Horror", "Purge", "Day", "Shooter", "Aliens"], "long_description": "\u201cThe action is fast, the aliens look great and at times the immersion can be truly terrifying.\u201d - The VR Shop\n\n\u201cThis is fu*king horror shooter\u201d - Escape\n\nSomething strange has happened. No one knows what. It is unstoppable. Our civilization is almost dead but Jack Bowman has to save his wife. Do you want to know how this story finishes?\nChoose your weapon and fight against alien swarm in Asian agglomeration.\nThe Purge Day is the first person narrative, immersive horror shooter designed exclusively for VR.\n\nTPD contains :\nSuspenseful story\nInteresting and challenging achievements\nHigh quality sounds and voiceovers\nA large selection of weapons\nImmersive and not easy gameplay\nA large number of opponents\nEach chapter finishes with a powerful boss \nNo motion sickness\n\nController not required but supported.", "short_description": "The Purge Day is the first person narrative, immersive horror shooter designed exclusively for VR.\nChoose your weapon and fight against alien swarm in Asian agglomeration."}]}, "developer_name": null, "developer_privacy_policy_url": "http://redlimbstudio.com/privacy-policy.html", "developer_terms_of_service_url": "http://redlimbstudio.com/privacy-policy.html", "publisher_name": "Red Limb Studio", "support_website_url": null, "website_url": "http://redlimbstudio.com/tpd.html", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["SHOOTER", "HORROR", "ACTION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD", "TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1146167436151886"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12138933_1103676193080769_1835948143645032448_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YmdtdxGg6WAQ7kNvwETkhuC&_nc_oc=AdoRnIRjT8-QuTwH1lD4a-kHAUptP5PQRxrzc8wQe-pOxGOIjF6zcot3Q7lyLZt0v_0&_nc_zt=3&_nc_ht=sconte
Jw8&_nc_oc=AdqX2dM3NRXPqEbWGGFO9VWdyAJynBXQaRev4kLH2xkkwAfE06Swbs4ox6Wh4hqDl8w&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSbgbauU0t7TuM--5zuGJxf1x44LfudI7U4GQlAFc_n_g&oe=6AEC9BF1"}, {"file_name": "migrated_image.png", "id": "503915403849657", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/12504647_1613397245621369_741789342199971840_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_3byRb_pAdUQ7kNvwFQf3B4&_nc_oc=AdqvpeE2C7lpajAL1tC0ESDVondEA-dhzbD7gJuRPFAfK8UHtBrAY5XPqwGvNUWOLAc&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTs4id5k0CMWAk7aLdYOl1pwy906MALeT0Ki76zRvQDaw&oe=6AECB1E3"}, {"file_name": "migrated_image.png", "id": "214678446270570", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/11162678_367766243614273_8732669583745351680_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VdJ-mGWJxcUQ7kNvwGc0SyV&_nc_oc=AdpVvjXZ_nu4IrOJbXds_OBphLYaOBJf-gHVuqKnwmGnGkjgXWt_8eowuXFXp7PVbrQ&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQfQONE-HJI39Da4KNenemhz61_ovZKZyZEZDxlBxM79g&oe=6AECA6A8"}, {"file_name": "migrated_image.png", "id": "144304540242505", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/12331050_329187584112763_4810020976727162880_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s_qdj2oq08oQ7kNvwEryAbD&_nc_oc=Adouz6IZ9CqX1mdAx3EzRqXIvqmEx9hgYc3pFKYP3URvHZkCnexYUMmqZ8FRf8hsa08&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS5c__yrVJAmBWlisYA9FcmvISS8tVgyHYb20mO1Y-gZQ&oe=6AECA7CF"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "The Purge Day", "keywords": ["Horror", "Purge", "Day", "Shooter", "Aliens"], "long_description": "\u201cThe action is fast, the aliens look great and at times the immersion can be truly terrifying.\u201d - The VR Shop\n\n\u201cThis is fu*king horror shooter\u201d - Escape\n\nSomething strange has happened. No one knows what. It is unstoppable. Our civilization is almost dead but Jack Bowman has to save his wife. Do you want to know how this story finishes?\nChoose your weapon and fight against alien swarm in Asian agglomeration.\nThe Purge Day is the first person narrative, immersive horror shooter designed exclusively for VR.\n\nTPD contains :\nSuspenseful story\nInteresting and challenging achievements\nHigh quality sounds and voiceovers\nA large selection of weapons\nImmersive and not easy gameplay\nA large number of opponents\nEach chapter finishes with a powerful boss \nNo motion sickness\n\nController not required but supported.", "short_description": "The Purge Day is the first person narrative, immersive horror shooter designed exclusively for VR.\nChoose your weapon and fight against alien swarm in Asian agglomeration."}]}, "developer_name": null, "developer_privacy_policy_url": "http://redlimbstudio.com/privacy-policy.html", "developer_terms_of_service_url": "http://redlimbstudio.com/privacy-policy.html", "publisher_name": "Red Limb Studio", "support_website_url": null, "website_url": "http://redlimbstudio.com/tpd.html", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["SHOOTER", "HORROR", "ACTION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD", "TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1146167436151886"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/12138933_1103676193080769_1835948143645032448_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5scj7xP-3a0Q7kNvwHY1ZPk&_nc_oc=AdpTUF7kw-W2MuWX-e4LWC6H0SD7hJS0tW0TNPH7enly6l50mS3EW5wKCiORRclOA00&_nc_zt=3&_nc_ht=sconten
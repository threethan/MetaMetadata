LyrO&_nc_oc=AdolN1_CY5-BNX40ikECM2YkqSk7LTnIFQ13mF4J5qMOVjpCPDUeSYiUKQTYkeYzHII&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB3qJ_gy6ErjiPpkyrXQaVPcAENDlPzW9LpgQtQ2gKMYw&oe=6A60A4B1"}, {"file_name": "migrated_image.png", "id": "503915403849657", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/12504647_1613397245621369_741789342199971840_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gIjXuKbe7GcQ7kNvwE1xtSG&_nc_oc=Adp9o3_yGmXBxFbRDj_Qp4LuCYzPhHk_ENJzHtq3NWVMToFo-RSMcC_JxQqprO6Nhq8&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBu0cz_Lp3h50I3QHLmvnpYFn9zIJsE7p0IN3VQDtMFzg&oe=6A60BAA3"}, {"file_name": "migrated_image.png", "id": "214678446270570", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/11162678_367766243614273_8732669583745351680_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Rsn1_oar4Y8Q7kNvwF5f_K8&_nc_oc=AdpGU3dmmhgEr6K9vxWR9pF3i9iKQFURQQluvOOXQaoS7xLhZIHoVaZNqK0qi7S-Dys&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDh_VO0PslgSLN6nP9B1afx2nS5EfDRz6PlI8nbndYvxQ&oe=6A60AF68"}, {"file_name": "migrated_image.png", "id": "144304540242505", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/12331050_329187584112763_4810020976727162880_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W1cnGQ79bicQ7kNvwEP-UT1&_nc_oc=AdreHGNQxZLb5xd1fF6Nn_oHGsDczfvDV90EvIwzpCGL-90pwQt7i_lWqhY2lM3GGjg&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQApvw9L6rMQly8vo_H2-00pRBi-Pp8gWOMPAIx4jmzzdQ&oe=6A60B08F"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "The Purge Day", "keywords": ["Horror", "Purge", "Day", "Shooter", "Aliens"], "long_description": "\u201cThe action is fast, the aliens look great and at times the immersion can be truly terrifying.\u201d - The VR Shop\n\n\u201cThis is fu*king horror shooter\u201d - Escape\n\nSomething strange has happened. No one knows what. It is unstoppable. Our civilization is almost dead but Jack Bowman has to save his wife. Do you want to know how this story finishes?\nChoose your weapon and fight against alien swarm in Asian agglomeration.\nThe Purge Day is the first person narrative, immersive horror shooter designed exclusively for VR.\n\nTPD contains :\nSuspenseful story\nInteresting and challenging achievements\nHigh quality sounds and voiceovers\nA large selection of weapons\nImmersive and not easy gameplay\nA large number of opponents\nEach chapter finishes with a powerful boss \nNo motion sickness\n\nController not required but supported.", "short_description": "The Purge Day is the first person narrative, immersive horror shooter designed exclusively for VR.\nChoose your weapon and fight against alien swarm in Asian agglomeration."}]}, "developer_name": null, "developer_privacy_policy_url": "http://redlimbstudio.com/privacy-policy.html", "developer_terms_of_service_url": "http://redlimbstudio.com/privacy-policy.html", "publisher_name": "Red Limb Studio", "support_website_url": null, "website_url": "http://redlimbstudio.com/tpd.html", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["SHOOTER", "HORROR", "ACTION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD", "TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1146167436151886"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12138933_1103676193080769_1835948143645032448_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HaT_WAeml34Q7kNvwEmzk1U&_nc_oc=AdoDdZGk105sDbU8W2jNRdr3zTSwTl14Kv_TMMhjr-fsUCx2AgyOkU0R0-OCww7mYkw&_nc_zt=3&_nc_ht=sconte
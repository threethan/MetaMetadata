F2j&_nc_oc=AdqxCeP0vlgFdP0dQv0xvP4NHzebs3Zu9HiCObMEHYFfWCmMdxKh3mDhCps3RgkXVh0&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSbHvoJAZ29iycacse692OqgjmqA9Ipr1zPQzlH4lwVnw&oe=6AF9CAF1"}, {"file_name": "migrated_image.png", "id": "503915403849657", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/12504647_1613397245621369_741789342199971840_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w1ybqfSzmT0Q7kNvwFf_OLd&_nc_oc=AdrwrHwk5kzQ_BNfsrrOeP-0MUYkb8jHijELsxPzZ3vYQV8GzrklFgqQ0a7jnoQSa00&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQuiHc0iFpbe2u3u1mXV-gytR1EgTXZdxhJVSnX1l6qLg&oe=6AF9E0E3"}, {"file_name": "migrated_image.png", "id": "214678446270570", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/11162678_367766243614273_8732669583745351680_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CWl7sX66vdAQ7kNvwFI7o6B&_nc_oc=AdobjjTqI784hOp_Oqc87qCmymA96gt8eawUPKLUh-0AMwR4p8OTU495K0MBk9kMJfo&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTGIjrU-Mt-dGUt8bXipTbAjQOcMLKGCqtaQnH06em6Og&oe=6AF9D5A8"}, {"file_name": "migrated_image.png", "id": "144304540242505", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/12331050_329187584112763_4810020976727162880_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fcS8u9VLOAYQ7kNvwG4cOuL&_nc_oc=AdpkOBSY5_kCD1TWtYWKL3kcHzLp0qpUl4evJ6MvVoxr5BvmAFKcU7sXOMTxxKOeGrk&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ4BLtV3lHpfE5GtkYw2MQO2fm44V0dEjsZWfcTvLbj5w&oe=6AF9D6CF"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "The Purge Day", "keywords": ["Horror", "Purge", "Day", "Shooter", "Aliens"], "long_description": "\u201cThe action is fast, the aliens look great and at times the immersion can be truly terrifying.\u201d - The VR Shop\n\n\u201cThis is fu*king horror shooter\u201d - Escape\n\nSomething strange has happened. No one knows what. It is unstoppable. Our civilization is almost dead but Jack Bowman has to save his wife. Do you want to know how this story finishes?\nChoose your weapon and fight against alien swarm in Asian agglomeration.\nThe Purge Day is the first person narrative, immersive horror shooter designed exclusively for VR.\n\nTPD contains :\nSuspenseful story\nInteresting and challenging achievements\nHigh quality sounds and voiceovers\nA large selection of weapons\nImmersive and not easy gameplay\nA large number of opponents\nEach chapter finishes with a powerful boss \nNo motion sickness\n\nController not required but supported.", "short_description": "The Purge Day is the first person narrative, immersive horror shooter designed exclusively for VR.\nChoose your weapon and fight against alien swarm in Asian agglomeration."}]}, "developer_name": null, "developer_privacy_policy_url": "http://redlimbstudio.com/privacy-policy.html", "developer_terms_of_service_url": "http://redlimbstudio.com/privacy-policy.html", "publisher_name": "Red Limb Studio", "support_website_url": null, "website_url": "http://redlimbstudio.com/tpd.html", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["SHOOTER", "HORROR", "ACTION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD", "TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1146167436151886"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/12138933_1103676193080769_1835948143645032448_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AELxk34bxqEQ7kNvwE0FEeK&_nc_oc=AdolwBtrovx5-T58G4zCCfaysH0c17IBSVoMeSMyeoLidzWW9IwzDx-82xSbqpnkA30&_nc_zt=3&_nc_ht=sconten
-Pq&_nc_oc=AdoK8n3kd-sUg1WjAPVV_8UhcNFCqP5cihh1J3bEjaNf78D9cPEQgK4onSJ5ervuyEQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKvu6kpzh-QT1hr3JLPA0fsXVNnUCoEnMv1IxNte0vQoA&oe=6A998D71"}, {"file_name": "migrated_image.png", "id": "503915403849657", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12504647_1613397245621369_741789342199971840_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AYwQJoB9J-kQ7kNvwGESDni&_nc_oc=Adp7_is5B31BZTxdlh2s0vpHiFxBh2d1Rlz4PdMZdXj6svgMoxxRQz8AlKRFVDEKmLI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKQ7t_N66Bei_ydB8ICpOw_Mvqq3GeqDg8YXOJqfu_MQw&oe=6A99A363"}, {"file_name": "migrated_image.png", "id": "214678446270570", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/11162678_367766243614273_8732669583745351680_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SWA12GoY9vsQ7kNvwFMH27R&_nc_oc=Adovdi7EHCYpOVkWykhzr4KwlkGb77BDR2y5mTvwIZVSgfTL49SINdJ88tXqNyDsphI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL15um29GX1XTjAHFRIkFvBSWo-eySr8SLB8r4176EMSA&oe=6A999828"}, {"file_name": "migrated_image.png", "id": "144304540242505", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12331050_329187584112763_4810020976727162880_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8tmgqwxep3IQ7kNvwHkVLbb&_nc_oc=AdowFjTs7cCfAMTNRRSL4efHUKpsqSuYXlGkvu9dC4251hDWmK_YsPDIk2-CW1dAoko&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJUjLY4PmJpy7iq1zZ9IR_pT5X00tum3ifxookOLX0sdg&oe=6A99994F"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "The Purge Day", "keywords": ["Horror", "Purge", "Day", "Shooter", "Aliens"], "long_description": "\u201cThe action is fast, the aliens look great and at times the immersion can be truly terrifying.\u201d - The VR Shop\n\n\u201cThis is fu*king horror shooter\u201d - Escape\n\nSomething strange has happened. No one knows what. It is unstoppable. Our civilization is almost dead but Jack Bowman has to save his wife. Do you want to know how this story finishes?\nChoose your weapon and fight against alien swarm in Asian agglomeration.\nThe Purge Day is the first person narrative, immersive horror shooter designed exclusively for VR.\n\nTPD contains :\nSuspenseful story\nInteresting and challenging achievements\nHigh quality sounds and voiceovers\nA large selection of weapons\nImmersive and not easy gameplay\nA large number of opponents\nEach chapter finishes with a powerful boss \nNo motion sickness\n\nController not required but supported.", "short_description": "The Purge Day is the first person narrative, immersive horror shooter designed exclusively for VR.\nChoose your weapon and fight against alien swarm in Asian agglomeration."}]}, "developer_name": null, "developer_privacy_policy_url": "http://redlimbstudio.com/privacy-policy.html", "developer_terms_of_service_url": "http://redlimbstudio.com/privacy-policy.html", "publisher_name": "Red Limb Studio", "support_website_url": null, "website_url": "http://redlimbstudio.com/tpd.html", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["SHOOTER", "HORROR", "ACTION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD", "TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1146167436151886"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12138933_1103676193080769_1835948143645032448_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1gBJVbAp8HoQ7kNvwFldMrM&_nc_oc=Ado21APyN5vw8xmd15i_6mXB72OMTT61bNU2BnHMerm0Br__mrjenhpTZLxonxEgZKA&_nc_zt=3&_nc_ht=sconten
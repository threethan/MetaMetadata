n_ep&_nc_oc=AdrUoHzB7N1AS_hVer1VCXaHUN6gw0_WeUGUngOiStb3kgcKaDWTfFL9yLHjeOkXljw&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEuQgV1Wt2_zC6-uMX1RVBqwmTG-EO3Ay-0yo6TtdlcBw&oe=6A8831B1"}, {"file_name": "migrated_image.png", "id": "503915403849657", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/12504647_1613397245621369_741789342199971840_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SWjW40n8OeUQ7kNvwHNTrHb&_nc_oc=AdpF4iM6CAOsZbKSn-fnROveEbfFYRtpaCdLda0JpPMs_2m-h1A7FkNn8GyUV1kRPZk&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEVnNa5zT6I8kiMTHGGg5hmThrZwKv-eXuv8zgTFFvDsQ&oe=6A8847A3"}, {"file_name": "migrated_image.png", "id": "214678446270570", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/11162678_367766243614273_8732669583745351680_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Sz-KpfB9G_gQ7kNvwG02WRP&_nc_oc=Adri19CLE5SEc-kOXvGmzVsdpTezEoH2mjL4d_RNOJYKeCf7hniIGVf4vHyOKOkH9bY&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEg9Ng2Hhxe4izOZPXFOAauRW6IlZdslOs_VuTPtEAZvg&oe=6A883C68"}, {"file_name": "migrated_image.png", "id": "144304540242505", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/12331050_329187584112763_4810020976727162880_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1QIL3D-9ucoQ7kNvwFgTQtj&_nc_oc=AdrLHRVA8fSdzh4nxUzCRcAYhkrisJZ70Sdno2SxObiTtRh3w09ljNTV6FTx5h0MRro&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFcRWYhz1vU51Kt-Hg7e32yubHjVtOK3uBjpDTNn7eueA&oe=6A883D8F"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "The Purge Day", "keywords": ["Horror", "Purge", "Day", "Shooter", "Aliens"], "long_description": "\u201cThe action is fast, the aliens look great and at times the immersion can be truly terrifying.\u201d - The VR Shop\n\n\u201cThis is fu*king horror shooter\u201d - Escape\n\nSomething strange has happened. No one knows what. It is unstoppable. Our civilization is almost dead but Jack Bowman has to save his wife. Do you want to know how this story finishes?\nChoose your weapon and fight against alien swarm in Asian agglomeration.\nThe Purge Day is the first person narrative, immersive horror shooter designed exclusively for VR.\n\nTPD contains :\nSuspenseful story\nInteresting and challenging achievements\nHigh quality sounds and voiceovers\nA large selection of weapons\nImmersive and not easy gameplay\nA large number of opponents\nEach chapter finishes with a powerful boss \nNo motion sickness\n\nController not required but supported.", "short_description": "The Purge Day is the first person narrative, immersive horror shooter designed exclusively for VR.\nChoose your weapon and fight against alien swarm in Asian agglomeration."}]}, "developer_name": null, "developer_privacy_policy_url": "http://redlimbstudio.com/privacy-policy.html", "developer_terms_of_service_url": "http://redlimbstudio.com/privacy-policy.html", "publisher_name": "Red Limb Studio", "support_website_url": null, "website_url": "http://redlimbstudio.com/tpd.html", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["SHOOTER", "HORROR", "ACTION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD", "TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1146167436151886"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/12138933_1103676193080769_1835948143645032448_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G-IxPAWj2loQ7kNvwEVheic&_nc_oc=AdpfAhSr4sS1Slq7YCFb3eh8ZDG78FZzHwuzlpD40-G30Bp0rEseH22ien7ZKXbMxOs&_nc_zt=3&_nc_ht=sconte
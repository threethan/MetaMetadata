cah&_nc_oc=Adoc42qPZ2of0OnB78PzwpeKBq0tCO90AcoAQExbHrofi-8-oT-LzOfoQgb3s6bcYfI&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQXpmES7qYNFBEayU9eE4Awvt26EXJXIlDPE19MWoPhqA&oe=6AF09071"}, {"file_name": "migrated_image.png", "id": "503915403849657", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/12504647_1613397245621369_741789342199971840_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TABmO3fC4G4Q7kNvwG6oSi-&_nc_oc=Adry4ag3ATTC-b0n0zWEb50Bry8urL9DWRlmXu9x90at4Ql_1vlSW9LGZNcGj-cPQj4&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTNAVmF1fHuHAnKxCYPlYURqCcpQvLUUt2YrjTSPxNxxA&oe=6AF0A663"}, {"file_name": "migrated_image.png", "id": "214678446270570", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/11162678_367766243614273_8732669583745351680_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7E64Tg2xdqMQ7kNvwG21BWJ&_nc_oc=AdpeKGE402G5YuMoV4fXmYtNfK-kO7eqaVMaC-iQhCSge72iw-IWYDG7DgdV-6gI9RU&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTNuTA4DO0Wv2v4CXUYWp0buGAp6C1XVR16OEo5m_9YPA&oe=6AF09B28"}, {"file_name": "migrated_image.png", "id": "144304540242505", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/12331050_329187584112763_4810020976727162880_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hUdnIFHu87QQ7kNvwHaL5Ke&_nc_oc=AdrK8xfQncfVIuw-ZCEfiaF45kZgGevfhAVO-eqDMai_KRdT5W0AzFsCK_17bAo1vUY&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRrn9F4IUMpHNzVf0udbjv0tRo2YIPuI8gxOpbER9_caA&oe=6AF09C4F"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "The Purge Day", "keywords": ["Horror", "Purge", "Day", "Shooter", "Aliens"], "long_description": "\u201cThe action is fast, the aliens look great and at times the immersion can be truly terrifying.\u201d - The VR Shop\n\n\u201cThis is fu*king horror shooter\u201d - Escape\n\nSomething strange has happened. No one knows what. It is unstoppable. Our civilization is almost dead but Jack Bowman has to save his wife. Do you want to know how this story finishes?\nChoose your weapon and fight against alien swarm in Asian agglomeration.\nThe Purge Day is the first person narrative, immersive horror shooter designed exclusively for VR.\n\nTPD contains :\nSuspenseful story\nInteresting and challenging achievements\nHigh quality sounds and voiceovers\nA large selection of weapons\nImmersive and not easy gameplay\nA large number of opponents\nEach chapter finishes with a powerful boss \nNo motion sickness\n\nController not required but supported.", "short_description": "The Purge Day is the first person narrative, immersive horror shooter designed exclusively for VR.\nChoose your weapon and fight against alien swarm in Asian agglomeration."}]}, "developer_name": null, "developer_privacy_policy_url": "http://redlimbstudio.com/privacy-policy.html", "developer_terms_of_service_url": "http://redlimbstudio.com/privacy-policy.html", "publisher_name": "Red Limb Studio", "support_website_url": null, "website_url": "http://redlimbstudio.com/tpd.html", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["SHOOTER", "HORROR", "ACTION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD", "TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1146167436151886"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/12138933_1103676193080769_1835948143645032448_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HCiCW2JaR2cQ7kNvwEoszGd&_nc_oc=Adp7puNpZg4EWpyp_2TiUJBDX8iqP6uG3kJO_im34rwF-DxgfgN2vsB-tBeIw1gDPE4&_nc_zt=3&_nc_ht=sconten
e.png", "id": "525561935035337", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12331021_1850298365201095_6926656576174424064_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sN_iBeUfCNcQ7kNvwGN_3yD&_nc_oc=AdrbummToPx2K4ZcbFPm5a70ur9xidgu6nOSQ7GOzUlc7MQSq53nHuQlFnH5LnK_O5A&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSsSGc3Ms0ycBpSWUCvJvdPfD-FAxoFaYr57OxqYdsFVw&oe=6B06F9F1"}, {"file_name": "migrated_image.png", "id": "503915403849657", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12504647_1613397245621369_741789342199971840_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y80lUIiHiwkQ7kNvwHHzghn&_nc_oc=AdrdBQ6ZNWTXvVPRNHM2RW8Dy_7PLFd7hD6YxkTEbRVS8Y2aVWcrblb8S21FDAt3zAo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ6TbKPj5sHwhcLZmPV0phht7VD5MfbcgjIVqiVLTFJew&oe=6B070FE3"}, {"file_name": "migrated_image.png", "id": "214678446270570", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/11162678_367766243614273_8732669583745351680_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T58bxWCEdz4Q7kNvwFggi0j&_nc_oc=AdrWS_hhIkuCpn1lLBWbzgZFho4F7EPrnW3EmLyJldfLWL7RZkKcFGYUG7eHGa7z4Ns&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRZmdzxjL413K-TVF25hcSLSLNm5TP6LTc5CoyL2-fueA&oe=6B0704A8"}, {"file_name": "migrated_image.png", "id": "144304540242505", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/12331050_329187584112763_4810020976727162880_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WfMTcrmVDxQQ7kNvwFqwiE-&_nc_oc=AdrRS9vv1hEndeS81qrhnnw866Yrptj05hSCdR8ya_R2n3RBh8GGn3CTZma2ySgkyMY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT06OgubXdN9MwLh9mk2_EVcuzKQAlkX0BYQp8lSyvODw&oe=6B0705CF"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "The Purge Day", "keywords": ["Horror", "Purge", "Day", "Shooter", "Aliens"], "long_description": "\u201cThe action is fast, the aliens look great and at times the immersion can be truly terrifying.\u201d - The VR Shop\n\n\u201cThis is fu*king horror shooter\u201d - Escape\n\nSomething strange has happened. No one knows what. It is unstoppable. Our civilization is almost dead but Jack Bowman has to save his wife. Do you want to know how this story finishes?\nChoose your weapon and fight against alien swarm in Asian agglomeration.\nThe Purge Day is the first person narrative, immersive horror shooter designed exclusively for VR.\n\nTPD contains :\nSuspenseful story\nInteresting and challenging achievements\nHigh quality sounds and voiceovers\nA large selection of weapons\nImmersive and not easy gameplay\nA large number of opponents\nEach chapter finishes with a powerful boss \nNo motion sickness\n\nController not required but supported.", "short_description": "The Purge Day is the first person narrative, immersive horror shooter designed exclusively for VR.\nChoose your weapon and fight against alien swarm in Asian agglomeration."}]}, "developer_name": null, "developer_privacy_policy_url": "http://redlimbstudio.com/privacy-policy.html", "developer_terms_of_service_url": "http://redlimbstudio.com/privacy-policy.html", "publisher_name": "Red Limb Studio", "support_website_url": null, "website_url": "http://redlimbstudio.com/tpd.html", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["SHOOTER", "HORROR", "ACTION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD", "TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1146167436151886"}, "review_messages": []}]}, "cover_sq
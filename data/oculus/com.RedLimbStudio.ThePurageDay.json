-iad3-1.oculuscdn.com&oh=00_Afv1jDaqaEwHsWJu-S7g9oDAXcR1USmzxXDEisPdy7Gp5g&oe=69999231"}, {"file_name": "migrated_image.png", "id": "503915403849657", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/12504647_1613397245621369_741789342199971840_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1DmBFj3gVLoQ7kNvwEZ09_J&_nc_oc=Adk7rbdtBJqQz5Jixdi-TmXCGY5iEtbiJ-1Q8y5UmZYy-CsT4pqAZZBQZgUzbST0fN4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfvZF6_iidK6opsrlPWB3WDzxFSlfpCnDmgfnxTAmOeoVA&oe=6999A823"}, {"file_name": "migrated_image.png", "id": "214678446270570", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/11162678_367766243614273_8732669583745351680_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n5ckp8J0GHcQ7kNvwGtqMo_&_nc_oc=Adk9XW5CDBOCIJlMTOYl_ZYdMZcu0ea0TZb7m37RNBYQg1AXT7qCytpJjdB5mvQkuYM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AftmUX3dHu5ZD-GCkwKFyu16LtxE8cJxf_DnI4yvF-JAQQ&oe=69999CE8"}, {"file_name": "migrated_image.png", "id": "144304540242505", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/12331050_329187584112763_4810020976727162880_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W-mQykuidewQ7kNvwH5WDIv&_nc_oc=AdlgfCmtHLeZBwSBksniXmlhbM6KKZseldOVDmsw6BuyKKM9gAh--AG8rB4hYkbmtXY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfsOxGQMBIIYLqLyYsQKiIVlgCZc0-5EfmWldSzaTLuB0Q&oe=69999E0F"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "The Purge Day", "keywords": ["Horror", "Purge", "Day", "Shooter", "Aliens"], "long_description": "\u201cThe action is fast, the aliens look great and at times the immersion can be truly terrifying.\u201d - The VR Shop\n\n\u201cThis is fu*king horror shooter\u201d - Escape\n\nSomething strange has happened. No one knows what. It is unstoppable. Our civilization is almost dead but Jack Bowman has to save his wife. Do you want to know how this story finishes?\nChoose your weapon and fight against alien swarm in Asian agglomeration.\nThe Purge Day is the first person narrative, immersive horror shooter designed exclusively for VR.\n\nTPD contains :\nSuspenseful story\nInteresting and challenging achievements\nHigh quality sounds and voiceovers\nA large selection of weapons\nImmersive and not easy gameplay\nA large number of opponents\nEach chapter finishes with a powerful boss \nNo motion sickness\n\nController not required but supported.", "short_description": "The Purge Day is the first person narrative, immersive horror shooter designed exclusively for VR.\nChoose your weapon and fight against alien swarm in Asian agglomeration."}]}, "developer_name": null, "developer_privacy_policy_url": "http://redlimbstudio.com/privacy-policy.html", "developer_terms_of_service_url": "http://redlimbstudio.com/privacy-policy.html", "publisher_name": "Red Limb Studio", "support_website_url": null, "website_url": "http://redlimbstudio.com/tpd.html", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["SHOOTER", "HORROR", "ACTION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD", "TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1146167436151886"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/12138933_1103676193080769_1835948143645032448_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AQkoTOLmVJoQ7kNvwEtXdSC&_nc_oc=AdnBRcBosYoQLgnWqwjs7ZC_YCw5YN5AhnbbNMKrd-SY4juC_cmFlbqobrkD2HMj2VI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfsqjrLkdzotCQI8PWxaVbdr5KHCyEe2pPSmHaQhww83Uw&oe=6999B22D"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": f
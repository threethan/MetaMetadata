tq5Q&_nc_oc=AdrnDc1jZXMmHVSPr1jWBKGOjoih-zu2gH2seyV-38xxIvahLlaiCK2TrNTRY62Ny-Y&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-0MPR27t3B_BkIlhiX1BnopR5CuhjP_oxA6yRA2Tc65Q&oe=6A3FE771"}, {"file_name": "migrated_image.png", "id": "503915403849657", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/12504647_1613397245621369_741789342199971840_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4v77BEQlM3sQ7kNvwEtYVU_&_nc_oc=AdpbHUKvOzYI_w9iFOaED_BBHqkiXv0x5uO_D53u6WDViNv7vgcQMs5AR_VZhcD12PU&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9WIabi-OhJZkBKlZJX_SMRUOHFkN0osoC2GLFqGnVinQ&oe=6A3FC523"}, {"file_name": "migrated_image.png", "id": "214678446270570", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/11162678_367766243614273_8732669583745351680_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0H0puwylXNIQ7kNvwFQJHF-&_nc_oc=AdqsGsuOVWvW4avkrQNYcRTUyW2s-v0yVS1tmzjP8ACEop5Rx55GndnWX4Bu84mvxjE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af__1ONxbEGoK7vD1sKQ23pmenEwu6P26RVVdufDBXfE7A&oe=6A3FF228"}, {"file_name": "migrated_image.png", "id": "144304540242505", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/12331050_329187584112763_4810020976727162880_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JFWqEVvBqIcQ7kNvwEpzong&_nc_oc=AdpKd8AfQHLTtXrAeqDFydkhDmAfHuF3fAr0xZOlpB1fDkDUP_F9c1ID1RFAu1b8bXk&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9YV1cYYl7U2fLQMlEwjcblpZbRyT__DgYpoG60FhWtLg&oe=6A3FF34F"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "The Purge Day", "keywords": ["Horror", "Purge", "Day", "Shooter", "Aliens"], "long_description": "\u201cThe action is fast, the aliens look great and at times the immersion can be truly terrifying.\u201d - The VR Shop\n\n\u201cThis is fu*king horror shooter\u201d - Escape\n\nSomething strange has happened. No one knows what. It is unstoppable. Our civilization is almost dead but Jack Bowman has to save his wife. Do you want to know how this story finishes?\nChoose your weapon and fight against alien swarm in Asian agglomeration.\nThe Purge Day is the first person narrative, immersive horror shooter designed exclusively for VR.\n\nTPD contains :\nSuspenseful story\nInteresting and challenging achievements\nHigh quality sounds and voiceovers\nA large selection of weapons\nImmersive and not easy gameplay\nA large number of opponents\nEach chapter finishes with a powerful boss \nNo motion sickness\n\nController not required but supported.", "short_description": "The Purge Day is the first person narrative, immersive horror shooter designed exclusively for VR.\nChoose your weapon and fight against alien swarm in Asian agglomeration."}]}, "developer_name": null, "developer_privacy_policy_url": "http://redlimbstudio.com/privacy-policy.html", "developer_terms_of_service_url": "http://redlimbstudio.com/privacy-policy.html", "publisher_name": "Red Limb Studio", "support_website_url": null, "website_url": "http://redlimbstudio.com/tpd.html", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["SHOOTER", "HORROR", "ACTION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD", "TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1146167436151886"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12138933_1103676193080769_1835948143645032448_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A4uS9ZfD8AcQ7kNvwF017Sv&_nc_oc=Adr3MkjVRJLmUUUOn7rpdq8pHy1i2jzsQwljbXcQylgllH1As9OFClg3QKT0tp3lIMQ&_nc_zt=3&_nc_ht=sconte
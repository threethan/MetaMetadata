e.png", "id": "525561935035337", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/12331021_1850298365201095_6926656576174424064_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A7eAL3ZIgsMQ7kNvwGApVte&_nc_oc=Ado12sJDoT5M6tVy66DVj2DQNAZclJWiQSCGYpFBw-VQ3TuxD5-GqlHh5lwAAYSUVZI&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQAwcCC35M3vTSxjOxVYAPTzZv1MatTLlbOlHuN0O8rQQ&oe=6B0B26B1"}, {"file_name": "migrated_image.png", "id": "503915403849657", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/12504647_1613397245621369_741789342199971840_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dJck_aGA-GsQ7kNvwH5tXdc&_nc_oc=AdqpGLM0F4bfPCiquFw7CDSIWZC5C0K7rR2oll5iK9ep1Mz8TXY7_Bl9Ln19uG2b6H0&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSco_J4J3o5zjXq636gDiWv6RwMD9lH0EszAsLFL7nbAQ&oe=6B0B3CA3"}, {"file_name": "migrated_image.png", "id": "214678446270570", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/11162678_367766243614273_8732669583745351680_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T5yKr6mShlkQ7kNvwHnn1FO&_nc_oc=Adqz8urGUa0P0ehKmwNN6QYEa--rkjVge3TYaYkh4z_W0l-TpZ2SxMzVlbvzusLq9MU&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQT4CXLBv_UDj42fEQpvOSJc6Mk5YSMFH2_OnJZ9D00mDw&oe=6B0B3168"}, {"file_name": "migrated_image.png", "id": "144304540242505", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/12331050_329187584112763_4810020976727162880_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lqfrBYB_VDoQ7kNvwFqfQEd&_nc_oc=AdrrMkADRpTsUd9-8p7N5MQ9ezFf2MkIe0wCyaXjhJvuPX4f3_U3FjCQhZ8ss5JZaH8&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRAd9HYH3nqC5wwfjwh3X0ZScVSNWuBeTT2HJVcqWKPew&oe=6B0B328F"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "The Purge Day", "keywords": ["Horror", "Purge", "Day", "Shooter", "Aliens"], "long_description": "\u201cThe action is fast, the aliens look great and at times the immersion can be truly terrifying.\u201d - The VR Shop\n\n\u201cThis is fu*king horror shooter\u201d - Escape\n\nSomething strange has happened. No one knows what. It is unstoppable. Our civilization is almost dead but Jack Bowman has to save his wife. Do you want to know how this story finishes?\nChoose your weapon and fight against alien swarm in Asian agglomeration.\nThe Purge Day is the first person narrative, immersive horror shooter designed exclusively for VR.\n\nTPD contains :\nSuspenseful story\nInteresting and challenging achievements\nHigh quality sounds and voiceovers\nA large selection of weapons\nImmersive and not easy gameplay\nA large number of opponents\nEach chapter finishes with a powerful boss \nNo motion sickness\n\nController not required but supported.", "short_description": "The Purge Day is the first person narrative, immersive horror shooter designed exclusively for VR.\nChoose your weapon and fight against alien swarm in Asian agglomeration."}]}, "developer_name": null, "developer_privacy_policy_url": "http://redlimbstudio.com/privacy-policy.html", "developer_terms_of_service_url": "http://redlimbstudio.com/privacy-policy.html", "publisher_name": "Red Limb Studio", "support_website_url": null, "website_url": "http://redlimbstudio.com/tpd.html", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["SHOOTER", "HORROR", "ACTION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD", "TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1146167436151886"}, "review_messages": []}]}, "cover_sq
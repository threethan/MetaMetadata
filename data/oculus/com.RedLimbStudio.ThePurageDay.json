gYy1&_nc_oc=AdpQipoxAXkOYb8g3BoWl_-CCiRT517z4A9HbHEuMLeXYy6aWEV3xNeF7b366pF9JTc&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6virafRk4NS2714vHB7jIRW3kPJh0MWqAg7awSA_ynhA&oe=6A107171"}, {"file_name": "migrated_image.png", "id": "503915403849657", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/12504647_1613397245621369_741789342199971840_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SRq05z4LaqIQ7kNvwEWTetW&_nc_oc=Adrnghd-jHU5_gGfRwPzMGdM-MLXAO0YcrwE00myktzJF8E3FlPB1lCh3frH41UhG6I&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5_B4J6GHSG6PB7m_pLuGWZ4kBclvCJuvls21o3IFjb-g&oe=6A104F23"}, {"file_name": "migrated_image.png", "id": "214678446270570", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/11162678_367766243614273_8732669583745351680_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8sFdWQzKcPUQ7kNvwGDBCJq&_nc_oc=AdrsAKWSfLHm3WAcxUWwUtgxvl_HzayhAXIhIXJWWMhMIa8rjJJ3Ykw6VDh2bMXUSrE&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af55e7ExIgW-nwNwpLxlqFEdCvRf3sQQyZ0-mzvVYNmhIg&oe=6A107C28"}, {"file_name": "migrated_image.png", "id": "144304540242505", "uri": "https://scontent-lhr8-1.oculuscdn.com/v/t64.5771-25/12331050_329187584112763_4810020976727162880_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y-qY2Au9c5gQ7kNvwHY8NUh&_nc_oc=Adr47LbP6spiW-rwsiIs0f60BoPtk_XckgDNcdQwjBpj98nk3CqLkAGgxY7dnXkeFwc&_nc_zt=3&_nc_ht=scontent-lhr8-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6s4APCfgK_Jn327axKFltM--tECNXgKkrc1ubRwo8qiw&oe=6A107D4F"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "The Purge Day", "keywords": ["Horror", "Purge", "Day", "Shooter", "Aliens"], "long_description": "\u201cThe action is fast, the aliens look great and at times the immersion can be truly terrifying.\u201d - The VR Shop\n\n\u201cThis is fu*king horror shooter\u201d - Escape\n\nSomething strange has happened. No one knows what. It is unstoppable. Our civilization is almost dead but Jack Bowman has to save his wife. Do you want to know how this story finishes?\nChoose your weapon and fight against alien swarm in Asian agglomeration.\nThe Purge Day is the first person narrative, immersive horror shooter designed exclusively for VR.\n\nTPD contains :\nSuspenseful story\nInteresting and challenging achievements\nHigh quality sounds and voiceovers\nA large selection of weapons\nImmersive and not easy gameplay\nA large number of opponents\nEach chapter finishes with a powerful boss \nNo motion sickness\n\nController not required but supported.", "short_description": "The Purge Day is the first person narrative, immersive horror shooter designed exclusively for VR.\nChoose your weapon and fight against alien swarm in Asian agglomeration."}]}, "developer_name": null, "developer_privacy_policy_url": "http://redlimbstudio.com/privacy-policy.html", "developer_terms_of_service_url": "http://redlimbstudio.com/privacy-policy.html", "publisher_name": "Red Limb Studio", "support_website_url": null, "website_url": "http://redlimbstudio.com/tpd.html", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["SHOOTER", "HORROR", "ACTION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD", "TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1146167436151886"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lhr8-2.oculuscdn.com/v/t64.5771-25/12138933_1103676193080769_1835948143645032448_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=X3_JzOOV6wgQ7kNvwFIi5DX&_nc_oc=AdpgH-u2YM5xQxgjGngRSnfleN7vKDAIosBQa4HgaOco1M2fJ_yZbsKaNiAHzcMNuzo&_nc_zt=3&_nc_ht=sconte
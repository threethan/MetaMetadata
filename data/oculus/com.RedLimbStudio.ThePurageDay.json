kNvwGzYVzZ&_nc_oc=Adokw-47o8mGCT8aPr8RUbsBhFcmveMLunJM22wpZKY65PgEe_74oUsN_eQp1oomkfA&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEyketJmt1-dfTO8IwwDTrOn30dW2f9b3ZcTkLyKyLxgw&oe=6A858EB1"}, {"file_name": "migrated_image.png", "id": "503915403849657", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/12504647_1613397245621369_741789342199971840_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zzK04O3Ibv4Q7kNvwFDVDe0&_nc_oc=AdorIsqm_VcfS8lNRanTzoEWviAEvpXxZZhKtjhg5fvHb_9y4nfVKDu_f8BVfpk6gsA&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEXiXD-zeRGLlw3NraUH9HzArS8kcNdS2kXq_mzPbwMyw&oe=6A85A4A3"}, {"file_name": "migrated_image.png", "id": "214678446270570", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/11162678_367766243614273_8732669583745351680_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LRnaAjDPwr0Q7kNvwGdTHcB&_nc_oc=Adr1IaFIft45xKm_yrM7iCOgbuhN-c-SDVoIW59NMxWL_cThDyKHG28cBDH05k-QQwk&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGvpG78quw1HpuCxhS1zPFSwL2ehc3lSaGcbunM8p0ing&oe=6A859968"}, {"file_name": "migrated_image.png", "id": "144304540242505", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/12331050_329187584112763_4810020976727162880_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RvSq8gMcHPEQ7kNvwF9Xs9I&_nc_oc=Adr9BEiYuwTfI0aC7a750zbpYHe1VP2ZKeTLOQdMVNd7DzqwOvWEEG2xjAJAD_zwBnA&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGqzSVhQ7etGHTQ8Njp5Li9Obn1CcHSuF4Vj4t9vgYsDw&oe=6A859A8F"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "The Purge Day", "keywords": ["Horror", "Purge", "Day", "Shooter", "Aliens"], "long_description": "\u201cThe action is fast, the aliens look great and at times the immersion can be truly terrifying.\u201d - The VR Shop\n\n\u201cThis is fu*king horror shooter\u201d - Escape\n\nSomething strange has happened. No one knows what. It is unstoppable. Our civilization is almost dead but Jack Bowman has to save his wife. Do you want to know how this story finishes?\nChoose your weapon and fight against alien swarm in Asian agglomeration.\nThe Purge Day is the first person narrative, immersive horror shooter designed exclusively for VR.\n\nTPD contains :\nSuspenseful story\nInteresting and challenging achievements\nHigh quality sounds and voiceovers\nA large selection of weapons\nImmersive and not easy gameplay\nA large number of opponents\nEach chapter finishes with a powerful boss \nNo motion sickness\n\nController not required but supported.", "short_description": "The Purge Day is the first person narrative, immersive horror shooter designed exclusively for VR.\nChoose your weapon and fight against alien swarm in Asian agglomeration."}]}, "developer_name": null, "developer_privacy_policy_url": "http://redlimbstudio.com/privacy-policy.html", "developer_terms_of_service_url": "http://redlimbstudio.com/privacy-policy.html", "publisher_name": "Red Limb Studio", "support_website_url": null, "website_url": "http://redlimbstudio.com/tpd.html", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["SHOOTER", "HORROR", "ACTION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD", "TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1146167436151886"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/12138933_1103676193080769_1835948143645032448_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G-IxPAWj2loQ7kNvwGSmHj6&_nc_oc=AdomiC-FWXaF6EEz1TP7CrXtZUsxRZ5XiKQCfTuEBjXhPneguiTaPp4TYd-tTqyCxmc&_nc_zt=3&_nc
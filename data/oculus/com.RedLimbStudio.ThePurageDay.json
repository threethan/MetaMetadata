gdS0&_nc_oc=AdqGBCyAMy3UnSno6CIxRzzbU5gftMwgZoWw2dAUh6JbaePKnwhzenj6w4HbrmU6f3s&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwUItIc-lHrUbfpTpuOtoV3qCahRcJb37ehHajor558sw&oe=69C513B1"}, {"file_name": "migrated_image.png", "id": "503915403849657", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/12504647_1613397245621369_741789342199971840_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EkPBBoEx6ZcQ7kNvwHaG5n5&_nc_oc=Ado8_EtLNdJ7OhCPYloUjeLzUiKpYpC_IcKVniJZkziI4ZAHdITpVqqNGOIaR3lria4&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzO_CNjRnSinZEvN590CHFsfM84afCLEAp5p_6iu8QE1g&oe=69C529A3"}, {"file_name": "migrated_image.png", "id": "214678446270570", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/11162678_367766243614273_8732669583745351680_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uLd9_7HHltYQ7kNvwFkDc1T&_nc_oc=Adp7ohl-umoO3PlWZ0XrIEJHIL0NcnQ1X4p3LZ4u1Tryjv-xoZRWiSyIjl_ebc0hETk&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxO50AUNaWazSqXk3P9F7lqYi5e8cvb1Wam8ruEg59uYQ&oe=69C51E68"}, {"file_name": "migrated_image.png", "id": "144304540242505", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/12331050_329187584112763_4810020976727162880_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=20dUVm7aUBQQ7kNvwGvSZGA&_nc_oc=Adq_JsjN86yhGLBoVrgdNIz1MA5pIRhZnLDqR7k4dTZuFbQyywISdo_iBo0EvAYH4cg&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyWN_kAXa6P1blwHHmovEK10N0k3Gky6X_QBhjPf0qTVw&oe=69C51F8F"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "The Purge Day", "keywords": ["Horror", "Purge", "Day", "Shooter", "Aliens"], "long_description": "\u201cThe action is fast, the aliens look great and at times the immersion can be truly terrifying.\u201d - The VR Shop\n\n\u201cThis is fu*king horror shooter\u201d - Escape\n\nSomething strange has happened. No one knows what. It is unstoppable. Our civilization is almost dead but Jack Bowman has to save his wife. Do you want to know how this story finishes?\nChoose your weapon and fight against alien swarm in Asian agglomeration.\nThe Purge Day is the first person narrative, immersive horror shooter designed exclusively for VR.\n\nTPD contains :\nSuspenseful story\nInteresting and challenging achievements\nHigh quality sounds and voiceovers\nA large selection of weapons\nImmersive and not easy gameplay\nA large number of opponents\nEach chapter finishes with a powerful boss \nNo motion sickness\n\nController not required but supported.", "short_description": "The Purge Day is the first person narrative, immersive horror shooter designed exclusively for VR.\nChoose your weapon and fight against alien swarm in Asian agglomeration."}]}, "developer_name": null, "developer_privacy_policy_url": "http://redlimbstudio.com/privacy-policy.html", "developer_terms_of_service_url": "http://redlimbstudio.com/privacy-policy.html", "publisher_name": "Red Limb Studio", "support_website_url": null, "website_url": "http://redlimbstudio.com/tpd.html", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["SHOOTER", "HORROR", "ACTION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD", "TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1146167436151886"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/12138933_1103676193080769_1835948143645032448_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Rq45OJ0SHFIQ7kNvwG02N8I&_nc_oc=AdrScAavVChOKeFzP0aF7riitaZpHdpcBLcUohWHhm0iWTcOUMSiQJVYPKBgXeR_cs4&_nc_zt=3&_nc_ht=sconte
Q7kNvwGKuFHp&_nc_oc=AdqrdheMxgnnsNRBUET41gdo4Kx1_9YtFwANpYaGlT4ELLP66THBXQ5gm8qAlga7zfI&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af82TXuws3xa_kIPYXdyNOjlwS0N7EWeA4_T5X8SGCddhA&oe=6A467EF1"}, {"file_name": "migrated_image.png", "id": "503915403849657", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/12504647_1613397245621369_741789342199971840_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uI-Fkt3XGekQ7kNvwEsHwM-&_nc_oc=AdpObGgov3609iYYH56ECtK_pr20FdLZGrlICb3LZE3zA7CTabAWV6VKsOhOw_MKFQI&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-Gt9hr9kmneGDWd_VZcKh5uRVoghqIpIsQGWFXPy4EYw&oe=6A465CA3"}, {"file_name": "migrated_image.png", "id": "214678446270570", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/11162678_367766243614273_8732669583745351680_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ip1DSOhE430Q7kNvwG21d0a&_nc_oc=AdrsMKks-m8GDg_m1o60m7bwapjjDYanbfXAFAB_dbR4jdtmGRyD08-u0bDUTfctkYg&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9VMA_vQ6Fken26-TbXn6xCCW2MWu5ew7Q1FVvLy0cs3A&oe=6A4689A8"}, {"file_name": "migrated_image.png", "id": "144304540242505", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/12331050_329187584112763_4810020976727162880_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pzM2BOYdA_YQ7kNvwG3LAC6&_nc_oc=AdrO75JSRgbpao__FohadhegDnDLeaTL_Dp5N4hXbA_sfDiL0lZPlawLBRzLlN5zA28&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9LP9ZyxsFmgxU2kQbABn6bL-tmGPdo3tBI8s-sdL6p-g&oe=6A468ACF"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "The Purge Day", "keywords": ["Horror", "Purge", "Day", "Shooter", "Aliens"], "long_description": "\u201cThe action is fast, the aliens look great and at times the immersion can be truly terrifying.\u201d - The VR Shop\n\n\u201cThis is fu*king horror shooter\u201d - Escape\n\nSomething strange has happened. No one knows what. It is unstoppable. Our civilization is almost dead but Jack Bowman has to save his wife. Do you want to know how this story finishes?\nChoose your weapon and fight against alien swarm in Asian agglomeration.\nThe Purge Day is the first person narrative, immersive horror shooter designed exclusively for VR.\n\nTPD contains :\nSuspenseful story\nInteresting and challenging achievements\nHigh quality sounds and voiceovers\nA large selection of weapons\nImmersive and not easy gameplay\nA large number of opponents\nEach chapter finishes with a powerful boss \nNo motion sickness\n\nController not required but supported.", "short_description": "The Purge Day is the first person narrative, immersive horror shooter designed exclusively for VR.\nChoose your weapon and fight against alien swarm in Asian agglomeration."}]}, "developer_name": null, "developer_privacy_policy_url": "http://redlimbstudio.com/privacy-policy.html", "developer_terms_of_service_url": "http://redlimbstudio.com/privacy-policy.html", "publisher_name": "Red Limb Studio", "support_website_url": null, "website_url": "http://redlimbstudio.com/tpd.html", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["SHOOTER", "HORROR", "ACTION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD", "TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1146167436151886"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/12138933_1103676193080769_1835948143645032448_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9MvM9Z9fqPEQ7kNvwEuNCOz&_nc_oc=AdqS77V9SVqSRCNRraEiZ6tpCibGOJxgkeNOkuem_3TTsCE7Na7xqfjLgb4Ia08ZQv4&_nc_zt=3&_nc
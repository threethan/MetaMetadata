cRJ&_nc_oc=AdoFxViXwBVw-zhwD79uYCwBZcQSyw_tzqmWYHaJ2JiycAidiOotFZ1CEeYBr_hrWI4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR0oIVtiRASsR9FXIshSBpaqgI4277Hlla10m_a8iubOw&oe=6AE755F1"}, {"file_name": "migrated_image.png", "id": "503915403849657", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12504647_1613397245621369_741789342199971840_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j7Pwk2PpVn8Q7kNvwHyzgAn&_nc_oc=Adpn2XVy4kzbJ1e7BeK8APawiHVHCDpQzABnse7YsuwdY9oMhjn7C193pKm6UnlP7wE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS90xNeLvIp-mL_teBHSSH6yfe8LFctH5svoBmDkGOjew&oe=6AE76BE3"}, {"file_name": "migrated_image.png", "id": "214678446270570", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/11162678_367766243614273_8732669583745351680_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AmvsRdF808gQ7kNvwHQoRRT&_nc_oc=AdoY61KF24hl7h97u51_8j_lnLxyC9kZm7Mx9zXXD3BIhgEHE3Ns37DtCsJRMDL6QRA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ1AuA0VLTF8tuYs-sEI_l-6BX3_5rdYja827HwI65u-g&oe=6AE760A8"}, {"file_name": "migrated_image.png", "id": "144304540242505", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12331050_329187584112763_4810020976727162880_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uBq6WYegGiYQ7kNvwH_SwMr&_nc_oc=AdrLXdOq4TlWGtAVIaBQpeU5Scr3MaRvHhvg3Pj93Qe_xjXcsHYTaHRngWKfFxgPtlI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ2Vbc12IWIAIKA4FzSjk3pRot8wo2mhI-9F7hhROzphw&oe=6AE761CF"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "The Purge Day", "keywords": ["Horror", "Purge", "Day", "Shooter", "Aliens"], "long_description": "\u201cThe action is fast, the aliens look great and at times the immersion can be truly terrifying.\u201d - The VR Shop\n\n\u201cThis is fu*king horror shooter\u201d - Escape\n\nSomething strange has happened. No one knows what. It is unstoppable. Our civilization is almost dead but Jack Bowman has to save his wife. Do you want to know how this story finishes?\nChoose your weapon and fight against alien swarm in Asian agglomeration.\nThe Purge Day is the first person narrative, immersive horror shooter designed exclusively for VR.\n\nTPD contains :\nSuspenseful story\nInteresting and challenging achievements\nHigh quality sounds and voiceovers\nA large selection of weapons\nImmersive and not easy gameplay\nA large number of opponents\nEach chapter finishes with a powerful boss \nNo motion sickness\n\nController not required but supported.", "short_description": "The Purge Day is the first person narrative, immersive horror shooter designed exclusively for VR.\nChoose your weapon and fight against alien swarm in Asian agglomeration."}]}, "developer_name": null, "developer_privacy_policy_url": "http://redlimbstudio.com/privacy-policy.html", "developer_terms_of_service_url": "http://redlimbstudio.com/privacy-policy.html", "publisher_name": "Red Limb Studio", "support_website_url": null, "website_url": "http://redlimbstudio.com/tpd.html", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["SHOOTER", "HORROR", "ACTION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD", "TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1146167436151886"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/12138933_1103676193080769_1835948143645032448_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5XJQ1mbZ5LkQ7kNvwEtlGAm&_nc_oc=AdozI-vZrog_O56zJDeRyA8R3S0P8Qh1nHX6fOQPhJsGXQddHZElxnQEXbKLjT89bU8&_nc_zt=3&_nc_ht=sconten
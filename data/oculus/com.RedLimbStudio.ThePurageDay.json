zlub&_nc_oc=AdrLPBwoHgGHsFPUyzr8UTGIZtcR1vi7XZQO9o0OtDhh-PGc1qetahfaySZIt_xmXN0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8lR1qqC94BB89uYfuskrEEbPcnYIBu_UpXuPlrKsEFAQ&oe=6A37FE71"}, {"file_name": "migrated_image.png", "id": "503915403849657", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/12504647_1613397245621369_741789342199971840_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0LI5XZeHJYEQ7kNvwFxgNjZ&_nc_oc=AdrOcWtyQ6ut1tcAY32ds9FHTFmwhwbGMPb7MWaF8sDNYvIsdO6ImoasnSPUMI5is_0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8SPFTGagxuBmeRA_36-s9S8SxMByWiPOLAa2TUr3gh3w&oe=6A381463"}, {"file_name": "migrated_image.png", "id": "214678446270570", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/11162678_367766243614273_8732669583745351680_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wujppLIzfA4Q7kNvwFuwdMS&_nc_oc=AdrlyChVLwHFw1GyrM7F0rmhPagfkl-sG9sq5KPGhgB6YXKB_OhdCZ5eLO_kaV9ThVM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_YuqHFjRfK9omJtPhtMdIutPtBqZI1v-0reYcSS87jgg&oe=6A380928"}, {"file_name": "migrated_image.png", "id": "144304540242505", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12331050_329187584112763_4810020976727162880_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0HNZBC3OmAcQ7kNvwFLTMXR&_nc_oc=Adpo4FMrIH9nl2-Q5LR466rncw3gYQlQNu1fXwvAn9sa300rTmHSIe0s70X0X5vTzoc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8kr_TPPWxaWAI44nmbvz3q0O6RbylTXiugqWbHre1T4Q&oe=6A380A4F"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "The Purge Day", "keywords": ["Horror", "Purge", "Day", "Shooter", "Aliens"], "long_description": "\u201cThe action is fast, the aliens look great and at times the immersion can be truly terrifying.\u201d - The VR Shop\n\n\u201cThis is fu*king horror shooter\u201d - Escape\n\nSomething strange has happened. No one knows what. It is unstoppable. Our civilization is almost dead but Jack Bowman has to save his wife. Do you want to know how this story finishes?\nChoose your weapon and fight against alien swarm in Asian agglomeration.\nThe Purge Day is the first person narrative, immersive horror shooter designed exclusively for VR.\n\nTPD contains :\nSuspenseful story\nInteresting and challenging achievements\nHigh quality sounds and voiceovers\nA large selection of weapons\nImmersive and not easy gameplay\nA large number of opponents\nEach chapter finishes with a powerful boss \nNo motion sickness\n\nController not required but supported.", "short_description": "The Purge Day is the first person narrative, immersive horror shooter designed exclusively for VR.\nChoose your weapon and fight against alien swarm in Asian agglomeration."}]}, "developer_name": null, "developer_privacy_policy_url": "http://redlimbstudio.com/privacy-policy.html", "developer_terms_of_service_url": "http://redlimbstudio.com/privacy-policy.html", "publisher_name": "Red Limb Studio", "support_website_url": null, "website_url": "http://redlimbstudio.com/tpd.html", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["SHOOTER", "HORROR", "ACTION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD", "TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1146167436151886"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/12138933_1103676193080769_1835948143645032448_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fVEqXSVIVrAQ7kNvwF_-dJD&_nc_oc=AdoVZjUKj314MmjCic14xPZSLJS_tYA0x9JWgQO5ef93xVs3lIdlJcPK1Se9KIBIdps&_nc_zt=3&_nc_ht=sconte
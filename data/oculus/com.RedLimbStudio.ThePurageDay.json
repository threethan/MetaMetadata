Hiv&_nc_oc=AdqZDsAe-MUXrZYM-np2dH3oZoKWSQhORcCm1XH9i6c1ANfltiu_7Xxn-6DKiGJOUGU&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGhhTqX8MInxfRbc0ZXQpLAMSPpfWK0yJj-cF9xfY7Edg&oe=6A940F31"}, {"file_name": "migrated_image.png", "id": "503915403849657", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/12504647_1613397245621369_741789342199971840_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3xIEDeowvr0Q7kNvwHeNV9U&_nc_oc=AdpqJxPUW5SGePFqo1gNnXeW7p-R1eQF0P1n5eQUqenS-DS-Rk0dP4eUkj2Jl53BmRk&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEjBkCQ57ja_E0ri2fNDIgX1unrZ-HkGZ1c81ySAU2ndA&oe=6A942523"}, {"file_name": "migrated_image.png", "id": "214678446270570", "uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/11162678_367766243614273_8732669583745351680_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2yX1wlb88AQQ7kNvwHT8EZu&_nc_oc=AdrPU3ZQSB0ER99r2MfOp3EFRswNBhMGMJVZePeKtO8KtI_cTQSs1AoTOGNQ4xCdEas&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH5DrLVOI4wD9M2rFvH5UvCXJKqVsnby69oe3MGwyDy4w&oe=6A9419E8"}, {"file_name": "migrated_image.png", "id": "144304540242505", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/12331050_329187584112763_4810020976727162880_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vekT7JjL6GIQ7kNvwFGZ3Vf&_nc_oc=AdrP4bS67JLPfc1OQwTiXoJThc02bB9Kxt7shx6qq_f7yRor6pWRe-9r5yPhMjnYZhE&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGLntby1cHQgtoZX5CBke9RospZbpmBtg-sSpmyUqM6mg&oe=6A941B0F"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "The Purge Day", "keywords": ["Horror", "Purge", "Day", "Shooter", "Aliens"], "long_description": "\u201cThe action is fast, the aliens look great and at times the immersion can be truly terrifying.\u201d - The VR Shop\n\n\u201cThis is fu*king horror shooter\u201d - Escape\n\nSomething strange has happened. No one knows what. It is unstoppable. Our civilization is almost dead but Jack Bowman has to save his wife. Do you want to know how this story finishes?\nChoose your weapon and fight against alien swarm in Asian agglomeration.\nThe Purge Day is the first person narrative, immersive horror shooter designed exclusively for VR.\n\nTPD contains :\nSuspenseful story\nInteresting and challenging achievements\nHigh quality sounds and voiceovers\nA large selection of weapons\nImmersive and not easy gameplay\nA large number of opponents\nEach chapter finishes with a powerful boss \nNo motion sickness\n\nController not required but supported.", "short_description": "The Purge Day is the first person narrative, immersive horror shooter designed exclusively for VR.\nChoose your weapon and fight against alien swarm in Asian agglomeration."}]}, "developer_name": null, "developer_privacy_policy_url": "http://redlimbstudio.com/privacy-policy.html", "developer_terms_of_service_url": "http://redlimbstudio.com/privacy-policy.html", "publisher_name": "Red Limb Studio", "support_website_url": null, "website_url": "http://redlimbstudio.com/tpd.html", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["SHOOTER", "HORROR", "ACTION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD", "TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1146167436151886"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/12138933_1103676193080769_1835948143645032448_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jE3GseoK2BMQ7kNvwETT8Cj&_nc_oc=AdoOkkpS_M_az5VoeQ0AKMLbkPkXFsoHvlRKb1EpyrefkZttIsyC-OuF0Gz3Tjok41c&_nc_zt=3&_nc_ht=sconten
Q7kNvwEb8zUK&_nc_oc=AdqayCgwAqCEjAeYU2ZvIRU-hTrWxEFGU6G7S31P5boP5XXLH_0ETwfdC4_BomjV-VM&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9dk0YxLsjLggV0qiQQAvR80cym8XMYzH0qV8UAOJPeGw&oe=6A36ACF1"}, {"file_name": "migrated_image.png", "id": "503915403849657", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/12504647_1613397245621369_741789342199971840_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2nOfxqTDnJcQ7kNvwHHlnpZ&_nc_oc=AdpeN1rm-aGBdlr1iACvcUd2ZlLZzEq0cFQ2kia-ztXrKxxSnUica8ZAMD6gIDalzoE&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_tDUXF45y9GHyWu5VTcE1z_vCsyoBXK_h0kG4IgcdpdQ&oe=6A36C2E3"}, {"file_name": "migrated_image.png", "id": "214678446270570", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/11162678_367766243614273_8732669583745351680_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wujppLIzfA4Q7kNvwGOGPbp&_nc_oc=AdrDObGDm5UEH8201yWiO8v6X4cCPis1ftKxfAw1VIz1qGjSoulD9zwfHNldT_c4LeI&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-CNQDSmF-BJsJJMPuTP9GpgSJhc0qjQ5sN29QTSZvymQ&oe=6A36B7A8"}, {"file_name": "migrated_image.png", "id": "144304540242505", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/12331050_329187584112763_4810020976727162880_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0HNZBC3OmAcQ7kNvwHx1vRd&_nc_oc=AdpmA9uAuHtl2vQ_Bb4A3MbAiSQf5CrvNkNN5ZWjNNfjcCBanAwi4zTBiH9IiWiN49Q&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_ouZKDy-h8D-QMx-BnsH6HSeC9ltKNYr5z_Am6D6-kBA&oe=6A36B8CF"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "The Purge Day", "keywords": ["Horror", "Purge", "Day", "Shooter", "Aliens"], "long_description": "\u201cThe action is fast, the aliens look great and at times the immersion can be truly terrifying.\u201d - The VR Shop\n\n\u201cThis is fu*king horror shooter\u201d - Escape\n\nSomething strange has happened. No one knows what. It is unstoppable. Our civilization is almost dead but Jack Bowman has to save his wife. Do you want to know how this story finishes?\nChoose your weapon and fight against alien swarm in Asian agglomeration.\nThe Purge Day is the first person narrative, immersive horror shooter designed exclusively for VR.\n\nTPD contains :\nSuspenseful story\nInteresting and challenging achievements\nHigh quality sounds and voiceovers\nA large selection of weapons\nImmersive and not easy gameplay\nA large number of opponents\nEach chapter finishes with a powerful boss \nNo motion sickness\n\nController not required but supported.", "short_description": "The Purge Day is the first person narrative, immersive horror shooter designed exclusively for VR.\nChoose your weapon and fight against alien swarm in Asian agglomeration."}]}, "developer_name": null, "developer_privacy_policy_url": "http://redlimbstudio.com/privacy-policy.html", "developer_terms_of_service_url": "http://redlimbstudio.com/privacy-policy.html", "publisher_name": "Red Limb Studio", "support_website_url": null, "website_url": "http://redlimbstudio.com/tpd.html", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["SHOOTER", "HORROR", "ACTION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD", "TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1146167436151886"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/12138933_1103676193080769_1835948143645032448_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fVEqXSVIVrAQ7kNvwHhLVgx&_nc_oc=Ado_bLscpqIRMxCNwnTb0HZl-7OwmkVFdVWb0oaeB4b46htOI4pZkwntmpOmLZttfOs&_nc_zt=3&_nc
0hD4EysdKy3DbV8nXpcfNQhjIp2lxIQrz-L8YYx2G6zDGDQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afz8vLK-k1kiPjXunVXsFLccTuTOEEwOnYn6GcBOl_4bRg&oe=69AEAA31"}, {"file_name": "migrated_image.png", "id": "503915403849657", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12504647_1613397245621369_741789342199971840_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mc0N85vdI9kQ7kNvwEIC3KX&_nc_oc=AdnID-Q1tppSafqDTddckelkok-EEyrGJomHJUz9j3HqQjHLA0a_p17LjFUEocdPD5g&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfxZWxBiqpkiIidjg0mkG0dgYShNe7WsGI-R8mJREOpjaQ&oe=69AEC023"}, {"file_name": "migrated_image.png", "id": "214678446270570", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/11162678_367766243614273_8732669583745351680_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=smXzQfiCCSgQ7kNvwG-INYw&_nc_oc=AdnvGZ0Ixz54256X1eiVgfu4vxIWdeRfE0-2D9gB3Mp3LI0bAt5FddPBuXmgYTR9wk4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfxcayXaJdlR-4AyTE_DV4mlH6Q0q3fx4VzsAdSRRyZo2w&oe=69AEB4E8"}, {"file_name": "migrated_image.png", "id": "144304540242505", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12331050_329187584112763_4810020976727162880_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=X6dY2f1EMzkQ7kNvwFpKkv2&_nc_oc=AdluJAjAamMtq7HVJDJ6Jhur5ejcro3p-HNLlL6zI3th9Tr4JD6-ib2gbxFc8isJLU4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfzPMfm-IpfxN6HPxWT9lv61l6fXQCv0d_Gh1nsskUb8Vw&oe=69AEB60F"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "The Purge Day", "keywords": ["Horror", "Purge", "Day", "Shooter", "Aliens"], "long_description": "\u201cThe action is fast, the aliens look great and at times the immersion can be truly terrifying.\u201d - The VR Shop\n\n\u201cThis is fu*king horror shooter\u201d - Escape\n\nSomething strange has happened. No one knows what. It is unstoppable. Our civilization is almost dead but Jack Bowman has to save his wife. Do you want to know how this story finishes?\nChoose your weapon and fight against alien swarm in Asian agglomeration.\nThe Purge Day is the first person narrative, immersive horror shooter designed exclusively for VR.\n\nTPD contains :\nSuspenseful story\nInteresting and challenging achievements\nHigh quality sounds and voiceovers\nA large selection of weapons\nImmersive and not easy gameplay\nA large number of opponents\nEach chapter finishes with a powerful boss \nNo motion sickness\n\nController not required but supported.", "short_description": "The Purge Day is the first person narrative, immersive horror shooter designed exclusively for VR.\nChoose your weapon and fight against alien swarm in Asian agglomeration."}]}, "developer_name": null, "developer_privacy_policy_url": "http://redlimbstudio.com/privacy-policy.html", "developer_terms_of_service_url": "http://redlimbstudio.com/privacy-policy.html", "publisher_name": "Red Limb Studio", "support_website_url": null, "website_url": "http://redlimbstudio.com/tpd.html", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["SHOOTER", "HORROR", "ACTION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD", "TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1146167436151886"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12138933_1103676193080769_1835948143645032448_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LqXHUL522Q0Q7kNvwGKejeF&_nc_oc=AdmvxZeqcRWxEpuQn_rCwiWhSmfActeYhzk8AKcp73rwUCWDPraIFRr2O1hsOYrP6cs&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfwlH1FZx
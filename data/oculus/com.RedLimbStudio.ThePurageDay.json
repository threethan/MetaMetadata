nIIj&_nc_oc=Adq8tlmwJ6xQOPdFyyZuK0lm3cUN_qclRhx9QkNdRE3hvhRuvLPBb0vBXLh2yXYUvHs&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9Tw86N2mGm8h5KWQxanfgfrMYyuqK1SQwqGbSrh4Hp_w&oe=6A301571"}, {"file_name": "migrated_image.png", "id": "503915403849657", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/12504647_1613397245621369_741789342199971840_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wbWgc_VvgAUQ7kNvwEZjhGT&_nc_oc=AdrHJpjVxX_7d7Y1OZStaZcX6mvLlfkRJtRMT5tRZhrPFNRXrRvRxIwyt1IVOoCBz2E&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9Vs7yAtjsDvHOoL62bCdaemQ3EZqBaGDxdwMuKBaO7dw&oe=6A2FF323"}, {"file_name": "migrated_image.png", "id": "214678446270570", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/11162678_367766243614273_8732669583745351680_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LdUVTizeYKUQ7kNvwFhJ_B6&_nc_oc=Adp9BjXbJFWMmNS7cl9mFvANpjIZRAnjPNl_DB3fNCVylAMDLLMUw2KfUIFDcj_ORA0&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-LKbOIIhXxPhK_OWdQpIHJpYfrnE1u8Zrmw2QQt7Si-g&oe=6A302028"}, {"file_name": "migrated_image.png", "id": "144304540242505", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/12331050_329187584112763_4810020976727162880_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VnFeTkz7JcgQ7kNvwEr8WIL&_nc_oc=AdoyleTzb_e9miTOYPsPS3GkKJ3PTCwHm6PK_yievv3lahIKVHGZWti24cMjDBQQ3mQ&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9bI5s1LWpxc5v2p--2BkIJ65PDTapghBnvadI7Em68nA&oe=6A30214F"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "The Purge Day", "keywords": ["Horror", "Purge", "Day", "Shooter", "Aliens"], "long_description": "\u201cThe action is fast, the aliens look great and at times the immersion can be truly terrifying.\u201d - The VR Shop\n\n\u201cThis is fu*king horror shooter\u201d - Escape\n\nSomething strange has happened. No one knows what. It is unstoppable. Our civilization is almost dead but Jack Bowman has to save his wife. Do you want to know how this story finishes?\nChoose your weapon and fight against alien swarm in Asian agglomeration.\nThe Purge Day is the first person narrative, immersive horror shooter designed exclusively for VR.\n\nTPD contains :\nSuspenseful story\nInteresting and challenging achievements\nHigh quality sounds and voiceovers\nA large selection of weapons\nImmersive and not easy gameplay\nA large number of opponents\nEach chapter finishes with a powerful boss \nNo motion sickness\n\nController not required but supported.", "short_description": "The Purge Day is the first person narrative, immersive horror shooter designed exclusively for VR.\nChoose your weapon and fight against alien swarm in Asian agglomeration."}]}, "developer_name": null, "developer_privacy_policy_url": "http://redlimbstudio.com/privacy-policy.html", "developer_terms_of_service_url": "http://redlimbstudio.com/privacy-policy.html", "publisher_name": "Red Limb Studio", "support_website_url": null, "website_url": "http://redlimbstudio.com/tpd.html", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["SHOOTER", "HORROR", "ACTION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD", "TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1146167436151886"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/12138933_1103676193080769_1835948143645032448_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qVOjjQ3B9FEQ7kNvwEubjYG&_nc_oc=AdoKvz9XWDV9NELn-MHuP5RKhirFfOmWNZnu3z8ukoRhmeTxLbpfXonTM_1gTjpPY48&_nc_zt=3&_nc_ht=sconte
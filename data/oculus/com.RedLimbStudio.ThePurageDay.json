0X6U&_nc_oc=Adrm2hjdPgEYbsTCMwmxNGUHCBD-EJFDyv-geXelA5oXXFC4jQtjbfLBKq_cX57w0lg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_xuLcOYVZWTkpUuxl3WEyMaIwyrb7FHTBspde-vvOnog&oe=6A282C71"}, {"file_name": "migrated_image.png", "id": "503915403849657", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/12504647_1613397245621369_741789342199971840_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D2aCnlIGUY8Q7kNvwH-WJy3&_nc_oc=AdrLT2kffNwv85pP5HFrTrqQFXSet9lhhnT8W_IwTU0sTEhiCfk_BNLCFJrrg9BoueM&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8qaPs3mfRgkZL2r-FRqW23E0bXeqtIkiMkmZKb3ji5PA&oe=6A280A23"}, {"file_name": "migrated_image.png", "id": "214678446270570", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/11162678_367766243614273_8732669583745351680_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Vn77jp1HrugQ7kNvwHw9tA-&_nc_oc=Adq51BZYpeIkx9rB_iN_uhRwN2AMeoy-5eUk_W4vNX5hXu2bzAVOB3hgcXiueW0tnIU&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8zehZSFRVvrQqg8UDrJ_M_IaLWatyyO7vmxutwBV1Egg&oe=6A283728"}, {"file_name": "migrated_image.png", "id": "144304540242505", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/12331050_329187584112763_4810020976727162880_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vcQF0XVin7QQ7kNvwFOR3j3&_nc_oc=AdpiXJOkx2R7yv3ed-0BRx-EpNBWxcC1x6BKd3QlBx7rs315xaZI9tS8Xq0nLaibrX0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8tD1dr_RmGzuc9IBxaYXRCYDiI4uv2j5fvXM78rZeidg&oe=6A28384F"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "The Purge Day", "keywords": ["Horror", "Purge", "Day", "Shooter", "Aliens"], "long_description": "\u201cThe action is fast, the aliens look great and at times the immersion can be truly terrifying.\u201d - The VR Shop\n\n\u201cThis is fu*king horror shooter\u201d - Escape\n\nSomething strange has happened. No one knows what. It is unstoppable. Our civilization is almost dead but Jack Bowman has to save his wife. Do you want to know how this story finishes?\nChoose your weapon and fight against alien swarm in Asian agglomeration.\nThe Purge Day is the first person narrative, immersive horror shooter designed exclusively for VR.\n\nTPD contains :\nSuspenseful story\nInteresting and challenging achievements\nHigh quality sounds and voiceovers\nA large selection of weapons\nImmersive and not easy gameplay\nA large number of opponents\nEach chapter finishes with a powerful boss \nNo motion sickness\n\nController not required but supported.", "short_description": "The Purge Day is the first person narrative, immersive horror shooter designed exclusively for VR.\nChoose your weapon and fight against alien swarm in Asian agglomeration."}]}, "developer_name": null, "developer_privacy_policy_url": "http://redlimbstudio.com/privacy-policy.html", "developer_terms_of_service_url": "http://redlimbstudio.com/privacy-policy.html", "publisher_name": "Red Limb Studio", "support_website_url": null, "website_url": "http://redlimbstudio.com/tpd.html", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["SHOOTER", "HORROR", "ACTION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD", "TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1146167436151886"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/12138933_1103676193080769_1835948143645032448_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0zu7twrlu3sQ7kNvwFgzGtU&_nc_oc=AdqEBe2DRDKywx1VSsKNhD8vdp1JWAD0syinaml3rPjlVJ5arxy7bXVMCUlYR2LAnoo&_nc_zt=3&_nc_ht=sconte
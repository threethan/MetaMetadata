dQj&_nc_oc=AdpVfMxHAyDdXsvf5p5qYYR_DZDumd1mz3xToWGMhpaArZIhx5SbMshVQvhHUGYGZ9Q&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHOoOrJLZZFK1tG0ml6IFVO0DOHJFj68XSPB-V9JDWT-A&oe=6A92BDB1"}, {"file_name": "migrated_image.png", "id": "503915403849657", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/12504647_1613397245621369_741789342199971840_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3xIEDeowvr0Q7kNvwFV_hEC&_nc_oc=Adpg3ydL3oayXPrSXlz-EgaHcamqb-Itv_X7c6PL96En09Pta61JxQSsw3ZljGiTr1w&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHJY6uQaGDvkJ-A1kSqy0SlgXugF9a0216b5O9maG4KEg&oe=6A92D3A3"}, {"file_name": "migrated_image.png", "id": "214678446270570", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/11162678_367766243614273_8732669583745351680_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h_g8-A76PwsQ7kNvwGU6yBC&_nc_oc=AdoVwToY6gs446CF5qESHFst993DDji3fW1vHck6EL4XL6K0Mp6y5l-HlAheksz4NqY&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHAb98nv9ERbu0ihFY4WlFg-6ynrs1Yl07jtY9EuxH7hw&oe=6A92C868"}, {"file_name": "migrated_image.png", "id": "144304540242505", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/12331050_329187584112763_4810020976727162880_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dKJwsHnt5VcQ7kNvwGWL46B&_nc_oc=AdpJESpeVbKqggNjubgNF-rRRpYZ25xOVfOMwnjQfG2FgCoHKKkiF-Vkvur8VITo1pQ&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE8xaNszuqPXUQIwtcNQmJ295EzKtd8EvcnLl4w1F5a-Q&oe=6A92C98F"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "The Purge Day", "keywords": ["Horror", "Purge", "Day", "Shooter", "Aliens"], "long_description": "\u201cThe action is fast, the aliens look great and at times the immersion can be truly terrifying.\u201d - The VR Shop\n\n\u201cThis is fu*king horror shooter\u201d - Escape\n\nSomething strange has happened. No one knows what. It is unstoppable. Our civilization is almost dead but Jack Bowman has to save his wife. Do you want to know how this story finishes?\nChoose your weapon and fight against alien swarm in Asian agglomeration.\nThe Purge Day is the first person narrative, immersive horror shooter designed exclusively for VR.\n\nTPD contains :\nSuspenseful story\nInteresting and challenging achievements\nHigh quality sounds and voiceovers\nA large selection of weapons\nImmersive and not easy gameplay\nA large number of opponents\nEach chapter finishes with a powerful boss \nNo motion sickness\n\nController not required but supported.", "short_description": "The Purge Day is the first person narrative, immersive horror shooter designed exclusively for VR.\nChoose your weapon and fight against alien swarm in Asian agglomeration."}]}, "developer_name": null, "developer_privacy_policy_url": "http://redlimbstudio.com/privacy-policy.html", "developer_terms_of_service_url": "http://redlimbstudio.com/privacy-policy.html", "publisher_name": "Red Limb Studio", "support_website_url": null, "website_url": "http://redlimbstudio.com/tpd.html", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["SHOOTER", "HORROR", "ACTION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD", "TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1146167436151886"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/12138933_1103676193080769_1835948143645032448_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jE3GseoK2BMQ7kNvwGIFNp3&_nc_oc=Adp2-N_ruqXMK8oSk42Ouk7uav_grlOHi5nEQaofqFdiFBoXc8o1FicJPT8wBVITa2U&_nc_zt=3&_nc_ht=sconten
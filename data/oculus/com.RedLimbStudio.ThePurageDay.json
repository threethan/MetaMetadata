PCX&_nc_oc=Adp3KakPU9EQ2T21AjtyYbLprXmqu3bB_n6Ye1T05-Uvyi3a8rZugdVXi5uK5qMG_YU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSAbTz7UlvnFk44AIic9Hid4ZZuowRlQ0z40jvEtbykFA&oe=6AF1E1F1"}, {"file_name": "migrated_image.png", "id": "503915403849657", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/12504647_1613397245621369_741789342199971840_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E2zskJraABYQ7kNvwEt7-KQ&_nc_oc=AdrQCc87llTMOyJ08jDpro4U1TbvmoeQYSdt7cRqpr1NnS3rpoLQoaZa-Jt471dN2LE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSuN3Jff-wbUgkY4Z1ws1wHsI_OumKgjXzdrPQvD0ml1w&oe=6AF1F7E3"}, {"file_name": "migrated_image.png", "id": "214678446270570", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/11162678_367766243614273_8732669583745351680_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7E64Tg2xdqMQ7kNvwGUD0gt&_nc_oc=Adp5X0AJCCHQbeuKmCpSnbiEFmfd-7iTWP9BDwxV-yz0EEDlLhkPvW3by-BXT-A2NcA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRJyFdQjDwLsgk1h4SGjtRPfFx--hkxSZcY-v8yChGrxA&oe=6AF1ECA8"}, {"file_name": "migrated_image.png", "id": "144304540242505", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12331050_329187584112763_4810020976727162880_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hUdnIFHu87QQ7kNvwE4B6sV&_nc_oc=Ado2q8CJLj4tjkZU0lPmDJ5qLDnZPJuCfBcgstC0R7H0TmtL9jVxVHhLxlE5gDE6wCA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTHbItAt53Cv1qWn5dbDkAtSoMaUV68465mczD_tmlBZg&oe=6AF1EDCF"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "The Purge Day", "keywords": ["Horror", "Purge", "Day", "Shooter", "Aliens"], "long_description": "\u201cThe action is fast, the aliens look great and at times the immersion can be truly terrifying.\u201d - The VR Shop\n\n\u201cThis is fu*king horror shooter\u201d - Escape\n\nSomething strange has happened. No one knows what. It is unstoppable. Our civilization is almost dead but Jack Bowman has to save his wife. Do you want to know how this story finishes?\nChoose your weapon and fight against alien swarm in Asian agglomeration.\nThe Purge Day is the first person narrative, immersive horror shooter designed exclusively for VR.\n\nTPD contains :\nSuspenseful story\nInteresting and challenging achievements\nHigh quality sounds and voiceovers\nA large selection of weapons\nImmersive and not easy gameplay\nA large number of opponents\nEach chapter finishes with a powerful boss \nNo motion sickness\n\nController not required but supported.", "short_description": "The Purge Day is the first person narrative, immersive horror shooter designed exclusively for VR.\nChoose your weapon and fight against alien swarm in Asian agglomeration."}]}, "developer_name": null, "developer_privacy_policy_url": "http://redlimbstudio.com/privacy-policy.html", "developer_terms_of_service_url": "http://redlimbstudio.com/privacy-policy.html", "publisher_name": "Red Limb Studio", "support_website_url": null, "website_url": "http://redlimbstudio.com/tpd.html", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["SHOOTER", "HORROR", "ACTION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD", "TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1146167436151886"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/12138933_1103676193080769_1835948143645032448_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HCiCW2JaR2cQ7kNvwHh2mVg&_nc_oc=AdpGYsJmE4GwS_fJqR8tfkILq5h4oTTDTU9tGKrHWag1eNp38V7SwfkuyZyBbAMmP8Y&_nc_zt=3&_nc_ht=sconten
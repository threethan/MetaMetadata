uws9&_nc_oc=Adr1AtOVXhmPeKjet8Ga88M4uEo4XG_gXty8ZDYKpyjTUOZXud7EK51VPpboS_iGssQ&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDBaMBvDd5TFXwWU3kJbCTQ9w2ZdB1r6MpLx5CifxwB2A&oe=6A4E67F1"}, {"file_name": "migrated_image.png", "id": "503915403849657", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/12504647_1613397245621369_741789342199971840_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sespTgjGCjIQ7kNvwFqmnG0&_nc_oc=AdqeuWvgJaI9Z4Cpz9G5E60UWv2UZ7hd3FFqI6fHQIlBSHkFa_YiQ552EVDgjBNQbb4&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQABkunMcQXT_WLJOUmoeFfFWdiTu2hGkjJBhpCJ6PGpqQ&oe=6A4E45A3"}, {"file_name": "migrated_image.png", "id": "214678446270570", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/11162678_367766243614273_8732669583745351680_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2g87BEG4oqIQ7kNvwHbOprU&_nc_oc=AdpVb_ZC_6nJSahUFN5UHYdN8E0cZbnHgu4SywuEsNb5KCngM9Yw9Aie5B-o6uA4_qQ&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCk4Cx-5q-vMkUBx8GKNbBe0L-wx5d_OJoRgA8EKJhGWw&oe=6A4E3A68"}, {"file_name": "migrated_image.png", "id": "144304540242505", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/12331050_329187584112763_4810020976727162880_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e9uJU3WimoIQ7kNvwGMHrB8&_nc_oc=AdqJ7CzzqJsBeXB9e-AWXTaa382OQLrtXplfYwdrK4P8ZR9aXoD48KNBq5_I8oQvZYU&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAUIF04TY04DukrwrVhzbIEN8DvWkI135h26LLrpLUKlA&oe=6A4E3B8F"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "The Purge Day", "keywords": ["Horror", "Purge", "Day", "Shooter", "Aliens"], "long_description": "\u201cThe action is fast, the aliens look great and at times the immersion can be truly terrifying.\u201d - The VR Shop\n\n\u201cThis is fu*king horror shooter\u201d - Escape\n\nSomething strange has happened. No one knows what. It is unstoppable. Our civilization is almost dead but Jack Bowman has to save his wife. Do you want to know how this story finishes?\nChoose your weapon and fight against alien swarm in Asian agglomeration.\nThe Purge Day is the first person narrative, immersive horror shooter designed exclusively for VR.\n\nTPD contains :\nSuspenseful story\nInteresting and challenging achievements\nHigh quality sounds and voiceovers\nA large selection of weapons\nImmersive and not easy gameplay\nA large number of opponents\nEach chapter finishes with a powerful boss \nNo motion sickness\n\nController not required but supported.", "short_description": "The Purge Day is the first person narrative, immersive horror shooter designed exclusively for VR.\nChoose your weapon and fight against alien swarm in Asian agglomeration."}]}, "developer_name": null, "developer_privacy_policy_url": "http://redlimbstudio.com/privacy-policy.html", "developer_terms_of_service_url": "http://redlimbstudio.com/privacy-policy.html", "publisher_name": "Red Limb Studio", "support_website_url": null, "website_url": "http://redlimbstudio.com/tpd.html", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["SHOOTER", "HORROR", "ACTION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD", "TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1146167436151886"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/12138933_1103676193080769_1835948143645032448_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6NUEsD5BzasQ7kNvwFks2Ra&_nc_oc=AdpYLP39oSAseqg80iLAm_m6DH83h5KzaomTAxL5O-TPhubOmMaqy2Wj7Ps4sQejmJE&_nc_zt=3&_nc_ht=sconte
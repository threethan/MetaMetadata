.com/v/t64.5771-25/12504647_1613397245621369_741789342199971840_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-LCX66FeTJ0Q7kNvwFMB6v7&_nc_oc=AdpEpo5jwJNa9sjBBWnNo4XReqs5W2pbOSu8CSo20068fpqbOzC71FkzoIbMS21oVpE&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIW8tonzPbUodyufgXUga8V_2CBx8sSgKDGrL3qMyES-g&oe=6AB66C23"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VideCover.png", "id": "233807520367930", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/12410461_233807523701263_7900757851851718656_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KnBV24O7P_cQ7kNvwErgHWL&_nc_oc=Adq0gYmWAREsqMJ_vvFH5tNTSD6HRLM1twjmO86eV1km5X5G0OpruCxjL4cEAJTWVLM&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKImkqmX2dMPqPQkdnS-rb1Z3FbVmYqIV-JEaaqtbu7Ow&oe=6AB68380"}, "display_name": "The Purge Day", "keywords": ["Horror", "Purge", "Day", "Shooter", "Aliens"], "long_description": "Something strange has happened. No one knows what. It is unstoppable. Our civilization is almost dead but John Bowman has to save his wife. Do you want to know how this story finishes?\nChoose your weapon and fight against alien swarm in Asian agglomeration.\nThe Purge Day is the first person narrative, immersive horror shooter designed exclusively for VR.\n\nTPD contains :\nSuspenseful story\nInteresting and challenging achievements\nHigh quality sounds and voiceovers\nA large selection of weapons\nImmersive and not easy gameplay\nA large number of opponents\nEach chapter finishes with a powerful boss \nNo motion sickness\n\nController not required but supported.", "short_description": "The Purge Day is the first person narrative, immersive horror shooter designed exclusively for VR.\nChoose your weapon and fight against alien swarm in Asian agglomeration."}]}, "developer_name": null, "developer_privacy_policy_url": "http://redlimbstudio.com/privacy-policy.html", "developer_terms_of_service_url": "http://redlimbstudio.com/privacy-policy.html"
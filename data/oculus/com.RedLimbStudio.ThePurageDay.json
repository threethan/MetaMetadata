2tMP&_nc_oc=AdqbSNy4lbWm6Rf45IgglOR6kgzHR_uRPcq10N8DOmQy0libtJ-DXES208GwlqMCF9s&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af61Ck3Pf9Giz6c05otKDfoARAUSrUA_BZh8kYuuGGwaww&oe=6A15B771"}, {"file_name": "migrated_image.png", "id": "503915403849657", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/12504647_1613397245621369_741789342199971840_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9ZQUPx0IYK8Q7kNvwG0jgg0&_nc_oc=Adqn4KXNUMcNR0dWKZ4jmZRwj2-9beAmkvaAqVuGIcxKdAqj868YqGMxAZJ8l1te94Q&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4uNYRUfgWuD05BbVjIOfGLk3jGttEY-Bf5Md7PCn6ieQ&oe=6A159523"}, {"file_name": "migrated_image.png", "id": "214678446270570", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/11162678_367766243614273_8732669583745351680_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Vad_NmaO78MQ7kNvwFFTmZ3&_nc_oc=AdqilMRGKOuqqvfl6W3nkbIEZrvFQslOXUhk2HhZh9wkzYsKtylvjGSrhe4wpZ_cVFg&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af48-QTWlb0Neff7z130umgj7o5g0q7DdVpdzmbZgOG9yA&oe=6A15C228"}, {"file_name": "migrated_image.png", "id": "144304540242505", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/12331050_329187584112763_4810020976727162880_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fMjl0g704DAQ7kNvwESM076&_nc_oc=Adr366Ls3jAYY86oSJOtKfqk-FlIMCQ2NJBA1qniZwBsKVYtks1wVPPw7kXhmRJt2ss&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4Qr0bS8gFvakSaULzSX1AA-AGkFAYH4Xe9gklf38qQrQ&oe=6A15C34F"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "The Purge Day", "keywords": ["Horror", "Purge", "Day", "Shooter", "Aliens"], "long_description": "\u201cThe action is fast, the aliens look great and at times the immersion can be truly terrifying.\u201d - The VR Shop\n\n\u201cThis is fu*king horror shooter\u201d - Escape\n\nSomething strange has happened. No one knows what. It is unstoppable. Our civilization is almost dead but Jack Bowman has to save his wife. Do you want to know how this story finishes?\nChoose your weapon and fight against alien swarm in Asian agglomeration.\nThe Purge Day is the first person narrative, immersive horror shooter designed exclusively for VR.\n\nTPD contains :\nSuspenseful story\nInteresting and challenging achievements\nHigh quality sounds and voiceovers\nA large selection of weapons\nImmersive and not easy gameplay\nA large number of opponents\nEach chapter finishes with a powerful boss \nNo motion sickness\n\nController not required but supported.", "short_description": "The Purge Day is the first person narrative, immersive horror shooter designed exclusively for VR.\nChoose your weapon and fight against alien swarm in Asian agglomeration."}]}, "developer_name": null, "developer_privacy_policy_url": "http://redlimbstudio.com/privacy-policy.html", "developer_terms_of_service_url": "http://redlimbstudio.com/privacy-policy.html", "publisher_name": "Red Limb Studio", "support_website_url": null, "website_url": "http://redlimbstudio.com/tpd.html", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["SHOOTER", "HORROR", "ACTION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD", "TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1146167436151886"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/12138933_1103676193080769_1835948143645032448_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g1SOQnIdd8UQ7kNvwHXyJl2&_nc_oc=AdpbvYs5mmv9OWyJ17ZnyTPjW30fL3ll5GYtHimirwxqkaN0chHCVvM2KdyV7RO7i_0&_nc_zt=3&_nc_ht=sconte
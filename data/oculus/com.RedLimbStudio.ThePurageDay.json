uER&_nc_oc=AdqiLWtS7QbCM5n8kDuua1oQhkhgWR7IhhYF1cqgZk0wZ98t-5eNXKBVNko0yGAq4mo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRoOA4c0lr_sUHZyJjYmIoq-iu06MqdfF6CwDrPrqzTDw&oe=6AEB4A71"}, {"file_name": "migrated_image.png", "id": "503915403849657", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/12504647_1613397245621369_741789342199971840_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_3byRb_pAdUQ7kNvwFMIYfv&_nc_oc=AdreshERSYnn4vOdkmmy-_QAmXQDsn-95Q5z46lZlU6ApYhfiWG7ZggXqv6a8jFXuWg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ02uNYyB6hL-adY_G2RFqwbF0y5_DsEyaxFEEVvlvZ8A&oe=6AEB6063"}, {"file_name": "migrated_image.png", "id": "214678446270570", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/11162678_367766243614273_8732669583745351680_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VdJ-mGWJxcUQ7kNvwEVevuK&_nc_oc=AdrCDEyRvHHR3wL5KDz4uioAx_jIth7yzVCNJ5IhDlQIG3Qo1xkuhNxSjCN4kymf754&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS8k34lu_OohBOtpbKZ9m06_dqyXCXFhHX5POFOZK39RA&oe=6AEB5528"}, {"file_name": "migrated_image.png", "id": "144304540242505", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12331050_329187584112763_4810020976727162880_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s_qdj2oq08oQ7kNvwHOgdfC&_nc_oc=AdrIloCspCvkiznsvNYY7SGtPRUQV33yvUBpi2cXztxxIZO5dMBtRNTgjL8_P-wnzSQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSUg4ww-Ufv7ZzriYBmLazN8CZvcyz53IbXrKGS_X98Qw&oe=6AEB564F"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "The Purge Day", "keywords": ["Horror", "Purge", "Day", "Shooter", "Aliens"], "long_description": "\u201cThe action is fast, the aliens look great and at times the immersion can be truly terrifying.\u201d - The VR Shop\n\n\u201cThis is fu*king horror shooter\u201d - Escape\n\nSomething strange has happened. No one knows what. It is unstoppable. Our civilization is almost dead but Jack Bowman has to save his wife. Do you want to know how this story finishes?\nChoose your weapon and fight against alien swarm in Asian agglomeration.\nThe Purge Day is the first person narrative, immersive horror shooter designed exclusively for VR.\n\nTPD contains :\nSuspenseful story\nInteresting and challenging achievements\nHigh quality sounds and voiceovers\nA large selection of weapons\nImmersive and not easy gameplay\nA large number of opponents\nEach chapter finishes with a powerful boss \nNo motion sickness\n\nController not required but supported.", "short_description": "The Purge Day is the first person narrative, immersive horror shooter designed exclusively for VR.\nChoose your weapon and fight against alien swarm in Asian agglomeration."}]}, "developer_name": null, "developer_privacy_policy_url": "http://redlimbstudio.com/privacy-policy.html", "developer_terms_of_service_url": "http://redlimbstudio.com/privacy-policy.html", "publisher_name": "Red Limb Studio", "support_website_url": null, "website_url": "http://redlimbstudio.com/tpd.html", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["SHOOTER", "HORROR", "ACTION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD", "TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1146167436151886"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/12138933_1103676193080769_1835948143645032448_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3WhNsVl9T6YQ7kNvwFN4ROI&_nc_oc=Adqh2k8NI_n5M7HNGl4rNvTrXieQZHbp75aLpudIFk7yE8ZYlniWndETjFhUB_p3kXA&_nc_zt=3&_nc_ht=sconten
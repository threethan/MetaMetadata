FjLn&_nc_oc=AdqI8wdeVm5h8CbjTwtMh9ajBsNGJeTSVuGjZ8BhM1XNi7H8zFKlVpTxP3AkuBKPolA&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3hNRKahHJlzgT9-8NZ0OHiPTv3ptaKFarPvXc01YpUCw&oe=69EF7BF1"}, {"file_name": "migrated_image.png", "id": "503915403849657", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/12504647_1613397245621369_741789342199971840_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QfmStoT8UM0Q7kNvwGlW5KL&_nc_oc=AdrkseLyeGei9NX5T2M0F6nUFvD79Wp94vMuCxM1LknndsgDjO9t5zFx2OeEckImfdE&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af01JxSf8-MbVs2lpw4TsUrHcFXQdppGhlD4-Mq8neHGjg&oe=69EF59A3"}, {"file_name": "migrated_image.png", "id": "214678446270570", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/11162678_367766243614273_8732669583745351680_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8Kg1FoJRmHUQ7kNvwG5DbbJ&_nc_oc=Adoj_3vdPxVsRDFT6CpsniGbBj6Z9AIJCJaP0lgG-pftKxnqfMC2FBt1tZWeYnjL6Cw&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0PshxgSMQCnFbM5cDiOPL3DjGrxe6fZRktjEEet_5_7Q&oe=69EF4E68"}, {"file_name": "migrated_image.png", "id": "144304540242505", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/12331050_329187584112763_4810020976727162880_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3HM-SC5iyAIQ7kNvwGLhk_-&_nc_oc=AdqWt10EaVrkZuosJbr0WcjhIl5FCYCucQ5aYroVJvFcbefwAuAeTgxRJL-ey9yKSIE&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3b7mz8Ascn7NvrsEzX_0f7QRUocjuFojW9kkXsYOb5qg&oe=69EF4F8F"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "The Purge Day", "keywords": ["Horror", "Purge", "Day", "Shooter", "Aliens"], "long_description": "\u201cThe action is fast, the aliens look great and at times the immersion can be truly terrifying.\u201d - The VR Shop\n\n\u201cThis is fu*king horror shooter\u201d - Escape\n\nSomething strange has happened. No one knows what. It is unstoppable. Our civilization is almost dead but Jack Bowman has to save his wife. Do you want to know how this story finishes?\nChoose your weapon and fight against alien swarm in Asian agglomeration.\nThe Purge Day is the first person narrative, immersive horror shooter designed exclusively for VR.\n\nTPD contains :\nSuspenseful story\nInteresting and challenging achievements\nHigh quality sounds and voiceovers\nA large selection of weapons\nImmersive and not easy gameplay\nA large number of opponents\nEach chapter finishes with a powerful boss \nNo motion sickness\n\nController not required but supported.", "short_description": "The Purge Day is the first person narrative, immersive horror shooter designed exclusively for VR.\nChoose your weapon and fight against alien swarm in Asian agglomeration."}]}, "developer_name": null, "developer_privacy_policy_url": "http://redlimbstudio.com/privacy-policy.html", "developer_terms_of_service_url": "http://redlimbstudio.com/privacy-policy.html", "publisher_name": "Red Limb Studio", "support_website_url": null, "website_url": "http://redlimbstudio.com/tpd.html", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["SHOOTER", "HORROR", "ACTION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD", "TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1146167436151886"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/12138933_1103676193080769_1835948143645032448_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rPIoVpgGl5EQ7kNvwE4GZSE&_nc_oc=AdrKIlBxpJOoa99bVF7y-nH4xI9vYuOCPasdgg87YYLyrdXJb9Lq0jDPkonn60Rmq_8&_nc_zt=3&_nc_ht=sconte
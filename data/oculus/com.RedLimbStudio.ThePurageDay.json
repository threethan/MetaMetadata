-ams2-1.oculuscdn.com&oh=00_AfvaI7qN0pG8Hn6UODU0pA1lFj1K64U66ITxnpQBXilLcg&oe=699ED831"}, {"file_name": "migrated_image.png", "id": "503915403849657", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12504647_1613397245621369_741789342199971840_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uCP5ZR2pYVAQ7kNvwEmd05M&_nc_oc=AdkE7McbF5jrJ0blUTWEO7O38KeWjZuR5L5uU_ylvZntDRudw7S2Yqzl8yr8MZxIVBc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AfsGG8iHI4sGRrg3A085kXf6wM0KfEr3K4O5ElJyIosXdg&oe=699EEE23"}, {"file_name": "migrated_image.png", "id": "214678446270570", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/11162678_367766243614273_8732669583745351680_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PnVFo330HMAQ7kNvwHGnK6i&_nc_oc=AdnaRbeOOiNngYTqb3toyg6NplncS09MLoJbwUxjQbCWwOPIrc4buGJmVwe5uGQrQBA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AfvmnJozuhLE-QqLHQ1vQnAttn5XDGr1yWlAEf6nsXb1ZA&oe=699EE2E8"}, {"file_name": "migrated_image.png", "id": "144304540242505", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12331050_329187584112763_4810020976727162880_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MVyBsSRXgoYQ7kNvwGi2OSZ&_nc_oc=Adn7u_4Qy6_Un2Jjzr1Se2YY38yKZ1GvrCbVwreV5noL2h6NmUg2EPoiz0BLjvB1eU0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AftuWpOtOlCAiDBHxuU7gx2a4KB3R_OD0uJaRS6H8wH8HA&oe=699EE40F"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "The Purge Day", "keywords": ["Horror", "Purge", "Day", "Shooter", "Aliens"], "long_description": "\u201cThe action is fast, the aliens look great and at times the immersion can be truly terrifying.\u201d - The VR Shop\n\n\u201cThis is fu*king horror shooter\u201d - Escape\n\nSomething strange has happened. No one knows what. It is unstoppable. Our civilization is almost dead but Jack Bowman has to save his wife. Do you want to know how this story finishes?\nChoose your weapon and fight against alien swarm in Asian agglomeration.\nThe Purge Day is the first person narrative, immersive horror shooter designed exclusively for VR.\n\nTPD contains :\nSuspenseful story\nInteresting and challenging achievements\nHigh quality sounds and voiceovers\nA large selection of weapons\nImmersive and not easy gameplay\nA large number of opponents\nEach chapter finishes with a powerful boss \nNo motion sickness\n\nController not required but supported.", "short_description": "The Purge Day is the first person narrative, immersive horror shooter designed exclusively for VR.\nChoose your weapon and fight against alien swarm in Asian agglomeration."}]}, "developer_name": null, "developer_privacy_policy_url": "http://redlimbstudio.com/privacy-policy.html", "developer_terms_of_service_url": "http://redlimbstudio.com/privacy-policy.html", "publisher_name": "Red Limb Studio", "support_website_url": null, "website_url": "http://redlimbstudio.com/tpd.html", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["SHOOTER", "HORROR", "ACTION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD", "TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1146167436151886"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12138933_1103676193080769_1835948143645032448_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P1IOgB7KdNcQ7kNvwFcgJQI&_nc_oc=AdnhUdgoRU8L1sJ6fK4CFNwZ-ZE0Tyx0_FvixT1HuS7VB4ndxIUElwGKxGvn2rs4mtA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AfsGBVgJebPmrMIn76WbI7dQljGa4SDgldBI9nAD6KKvSg&oe=699EF82D"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": f
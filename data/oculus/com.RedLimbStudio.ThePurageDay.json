x_3W&_nc_oc=AdqKJyHliGdmq2Nx1yz7jbCgM3p1UY4TYiPI4dPFNSb_Vjr-tddxEpCwV6SIZJxd080&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af00kwC2ErthmWnkPcbs7soqzfq7dfblOm3YlaLUjyyWhg&oe=69DF71B1"}, {"file_name": "migrated_image.png", "id": "503915403849657", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12504647_1613397245621369_741789342199971840_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U3PMkOC2A7QQ7kNvwHTUcyy&_nc_oc=AdpmjK4IOw5V19i7roUVnSCut-YVAClCB8k3DQYiwMSJLZNjbJF2FceosP3B9NmBOqM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3bLS1QOIoE2puXCzWnsLBMLEA4b-lBw7zHj4VNgZpAlw&oe=69DF87A3"}, {"file_name": "migrated_image.png", "id": "214678446270570", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/11162678_367766243614273_8732669583745351680_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fTxi_CZEG7cQ7kNvwHdx656&_nc_oc=Ado8pCrXaL1oG9OMaGGjK3KFF_OK6lSjGoWFyMhOkaBkLyKau_F5bZDgKP2-Mf-TEl8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1rHfGPB-nFYtCcRBfmVh6Qqp3RDL2a3RPXgK1xWXDGzA&oe=69DF7C68"}, {"file_name": "migrated_image.png", "id": "144304540242505", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/12331050_329187584112763_4810020976727162880_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DFgvZ3AhaYcQ7kNvwGhP9pZ&_nc_oc=Ado6f4nm2lHOB0Ram7GjtwofpM_Qt_j5J3pqwoZhRcHwOSKDuox2VsEqp5fBJcHRCHA&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1Ng9YEIodL-FHgABRerztS_A9UsBwbetRzaDcNnwLyCQ&oe=69DF7D8F"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "The Purge Day", "keywords": ["Horror", "Purge", "Day", "Shooter", "Aliens"], "long_description": "\u201cThe action is fast, the aliens look great and at times the immersion can be truly terrifying.\u201d - The VR Shop\n\n\u201cThis is fu*king horror shooter\u201d - Escape\n\nSomething strange has happened. No one knows what. It is unstoppable. Our civilization is almost dead but Jack Bowman has to save his wife. Do you want to know how this story finishes?\nChoose your weapon and fight against alien swarm in Asian agglomeration.\nThe Purge Day is the first person narrative, immersive horror shooter designed exclusively for VR.\n\nTPD contains :\nSuspenseful story\nInteresting and challenging achievements\nHigh quality sounds and voiceovers\nA large selection of weapons\nImmersive and not easy gameplay\nA large number of opponents\nEach chapter finishes with a powerful boss \nNo motion sickness\n\nController not required but supported.", "short_description": "The Purge Day is the first person narrative, immersive horror shooter designed exclusively for VR.\nChoose your weapon and fight against alien swarm in Asian agglomeration."}]}, "developer_name": null, "developer_privacy_policy_url": "http://redlimbstudio.com/privacy-policy.html", "developer_terms_of_service_url": "http://redlimbstudio.com/privacy-policy.html", "publisher_name": "Red Limb Studio", "support_website_url": null, "website_url": "http://redlimbstudio.com/tpd.html", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["SHOOTER", "HORROR", "ACTION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD", "TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1146167436151886"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12138933_1103676193080769_1835948143645032448_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yJ3iF-Gkm5IQ7kNvwEUhOyH&_nc_oc=Adr9jVuI43GPdCRcbBGsxYvV0zTQCOdpJOt8nNw4An-iZBaoSofcjlfHRxbWY5qfi_c&_nc_zt=3&_nc_ht=sconte
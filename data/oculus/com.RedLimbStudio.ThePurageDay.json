nMa&_nc_oc=AdqKtOTydfeKAORcn8xbjhVz8eG7NbsldR0GHiwI5wMTP_wXxziZ9aNYyEcCPQEU574&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI_EHR53m1FgfZL0zQ44x-5ZmIEHJNQAWp5_NTISBGABg&oe=6A9ADEF1"}, {"file_name": "migrated_image.png", "id": "503915403849657", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/12504647_1613397245621369_741789342199971840_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7hDpxhhYsC0Q7kNvwH-KRcF&_nc_oc=AdqFfZKfriSnxTt7E8o1H3ykPPbWjYUYnl58R6Vl--tjsO6HKw3wzzkhfCMqwF8DxUE&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL90xDuETme2htV4Ck7D_gxQhcYDPJdTZVnp4hC_T5p6g&oe=6A9AF4E3"}, {"file_name": "migrated_image.png", "id": "214678446270570", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/11162678_367766243614273_8732669583745351680_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SWA12GoY9vsQ7kNvwFWmNyk&_nc_oc=Adr5-5BEaz__s-3-q6zdVB7xdSisfOs3prBB_jf2CDl6_JcQjk13p0AO79CBOHQWk-o&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJfpY5piuKsFScq4lhE2FJwghLJSk-B2JIhyIpfWxQzGA&oe=6A9AE9A8"}, {"file_name": "migrated_image.png", "id": "144304540242505", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/12331050_329187584112763_4810020976727162880_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8tmgqwxep3IQ7kNvwGQul6g&_nc_oc=AdqvZBKsBnbp_nNlsgbZcGs73yqK-QQo_F7JcPKDWi0j4c7qtIsUhSCxQNIDbmYi3zA&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL4jqnFgz9UsAnKkHAcbzcYIBkFX7VsMwn9VJFErNIjIw&oe=6A9AEACF"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "The Purge Day", "keywords": ["Horror", "Purge", "Day", "Shooter", "Aliens"], "long_description": "\u201cThe action is fast, the aliens look great and at times the immersion can be truly terrifying.\u201d - The VR Shop\n\n\u201cThis is fu*king horror shooter\u201d - Escape\n\nSomething strange has happened. No one knows what. It is unstoppable. Our civilization is almost dead but Jack Bowman has to save his wife. Do you want to know how this story finishes?\nChoose your weapon and fight against alien swarm in Asian agglomeration.\nThe Purge Day is the first person narrative, immersive horror shooter designed exclusively for VR.\n\nTPD contains :\nSuspenseful story\nInteresting and challenging achievements\nHigh quality sounds and voiceovers\nA large selection of weapons\nImmersive and not easy gameplay\nA large number of opponents\nEach chapter finishes with a powerful boss \nNo motion sickness\n\nController not required but supported.", "short_description": "The Purge Day is the first person narrative, immersive horror shooter designed exclusively for VR.\nChoose your weapon and fight against alien swarm in Asian agglomeration."}]}, "developer_name": null, "developer_privacy_policy_url": "http://redlimbstudio.com/privacy-policy.html", "developer_terms_of_service_url": "http://redlimbstudio.com/privacy-policy.html", "publisher_name": "Red Limb Studio", "support_website_url": null, "website_url": "http://redlimbstudio.com/tpd.html", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["SHOOTER", "HORROR", "ACTION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD", "TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1146167436151886"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/12138933_1103676193080769_1835948143645032448_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1gBJVbAp8HoQ7kNvwE_hYHW&_nc_oc=AdrcekpUQpQZ1eWGXwKbyRVPFO3AcZN0zwqZaONC98m2kJIpQjjpzzGTkbaHUN-IQRQ&_nc_zt=3&_nc_ht=sconten
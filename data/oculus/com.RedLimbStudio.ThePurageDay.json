-Aj&_nc_oc=Ador5Z-g4Uy0x_P_SNqTZs4mq9GZTs-1I1NZZdmwS8yoUCk6wkW-J89mxtVZ6amZHEE&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJQsxZluG8gFiwDVfsxxOc7mbvNh442UVWgw5oAOsrL8A&oe=6AA17671"}, {"file_name": "migrated_image.png", "id": "503915403849657", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/12504647_1613397245621369_741789342199971840_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AZ9Ux_OxAZIQ7kNvwFV8Qva&_nc_oc=AdrzoEMXtWkNZ-G-n2c8SLqV50sZNOQhwFazh2tYJBbrE1s1djPMBSv8vAdNe5tFi1M&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIb21eKU3VlKyZYOCvXtCtNKWeQJeYglEYkd-0OCor81w&oe=6AA15423"}, {"file_name": "migrated_image.png", "id": "214678446270570", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/11162678_367766243614273_8732669583745351680_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-APlSlNYNScQ7kNvwFjWM7m&_nc_oc=AdoI_AyFlxgnNLi9n63jPUVfE01uhiwpbzeuaRIod6zrPg84chnQHTds-_Bq5q9jRQ8&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKM77vz8C213-Tvd7CyNF9c-dTqGKbql10UVPoHGCAHyA&oe=6AA148E8"}, {"file_name": "migrated_image.png", "id": "144304540242505", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/12331050_329187584112763_4810020976727162880_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wGAbPLbYST4Q7kNvwGbnBFr&_nc_oc=AdrFusGINkfPNIJd85IZ9k4Uug1UeUadQleTL5xmVTNlhhPX5EX4E9CXxRgdFVfTB5s&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIZgIanK37GgRwSBblQjIrN-Ox95IfTeaQHrP-y4Cf5nA&oe=6AA14A0F"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "The Purge Day", "keywords": ["Horror", "Purge", "Day", "Shooter", "Aliens"], "long_description": "\u201cThe action is fast, the aliens look great and at times the immersion can be truly terrifying.\u201d - The VR Shop\n\n\u201cThis is fu*king horror shooter\u201d - Escape\n\nSomething strange has happened. No one knows what. It is unstoppable. Our civilization is almost dead but Jack Bowman has to save his wife. Do you want to know how this story finishes?\nChoose your weapon and fight against alien swarm in Asian agglomeration.\nThe Purge Day is the first person narrative, immersive horror shooter designed exclusively for VR.\n\nTPD contains :\nSuspenseful story\nInteresting and challenging achievements\nHigh quality sounds and voiceovers\nA large selection of weapons\nImmersive and not easy gameplay\nA large number of opponents\nEach chapter finishes with a powerful boss \nNo motion sickness\n\nController not required but supported.", "short_description": "The Purge Day is the first person narrative, immersive horror shooter designed exclusively for VR.\nChoose your weapon and fight against alien swarm in Asian agglomeration."}]}, "developer_name": null, "developer_privacy_policy_url": "http://redlimbstudio.com/privacy-policy.html", "developer_terms_of_service_url": "http://redlimbstudio.com/privacy-policy.html", "publisher_name": "Red Limb Studio", "support_website_url": null, "website_url": "http://redlimbstudio.com/tpd.html", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["SHOOTER", "HORROR", "ACTION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD", "TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1146167436151886"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/12138933_1103676193080769_1835948143645032448_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w_nxdlU6VjgQ7kNvwE0onVn&_nc_oc=AdocGEc36VhS_FFS0vuMddPm2NbVCd19XyEBDcOll_9wRh0s8H4q85M0etDBkuPV5kg&_nc_zt=3&_nc_ht=sconten
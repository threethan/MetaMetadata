i_xe&_nc_oc=AdoY1-dvH3RKzwmv_VgFRNSG_MYyGI-rP-D3Xz-1uYpTfyPD98tk1lv14HrlkxLkyJ4&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3CQBaG6x-o7J0BDtYJvcOv9tIQ2Js8rxaxwXSH7RyQDg&oe=69F37071"}, {"file_name": "migrated_image.png", "id": "503915403849657", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/12504647_1613397245621369_741789342199971840_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O9PEZGp2VCEQ7kNvwHL4hx6&_nc_oc=AdpBUtLD_0Li_9KRe8HDklsJeypE-3hPAFjeTcpUA6px0Sd7hvPwbxFV0jNJS6DS6OA&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af19A3acXDUHo1Iqor6aEX9AbfphfO2Wpnld1gwa2Q7acg&oe=69F34E23"}, {"file_name": "migrated_image.png", "id": "214678446270570", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/11162678_367766243614273_8732669583745351680_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ERnK9ySE-VIQ7kNvwHR9bcq&_nc_oc=AdoD6h-_EDv8FmpS97vM_k0L85lBxCOJk_xaUg6UG4Yd5vLmZmSx-eawF8Bav0ZO_PM&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2yrwp5cVlGkZ64Nu8DvXuX_a_aIKwx9mng0klz0aeZ4w&oe=69F342E8"}, {"file_name": "migrated_image.png", "id": "144304540242505", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/12331050_329187584112763_4810020976727162880_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YTNOeT20HCgQ7kNvwHNbYqx&_nc_oc=Ado6geBoE1ZuCD9U9RJ86GUZnl4cNwIjwL8J_2X6jXk-KwIoI2F-sdkZfxvEyU9VvNo&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1t7Vndrpuwd7LFGCfPbI4tt14f7E0evXSmamUw5rnoVA&oe=69F3440F"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "The Purge Day", "keywords": ["Horror", "Purge", "Day", "Shooter", "Aliens"], "long_description": "\u201cThe action is fast, the aliens look great and at times the immersion can be truly terrifying.\u201d - The VR Shop\n\n\u201cThis is fu*king horror shooter\u201d - Escape\n\nSomething strange has happened. No one knows what. It is unstoppable. Our civilization is almost dead but Jack Bowman has to save his wife. Do you want to know how this story finishes?\nChoose your weapon and fight against alien swarm in Asian agglomeration.\nThe Purge Day is the first person narrative, immersive horror shooter designed exclusively for VR.\n\nTPD contains :\nSuspenseful story\nInteresting and challenging achievements\nHigh quality sounds and voiceovers\nA large selection of weapons\nImmersive and not easy gameplay\nA large number of opponents\nEach chapter finishes with a powerful boss \nNo motion sickness\n\nController not required but supported.", "short_description": "The Purge Day is the first person narrative, immersive horror shooter designed exclusively for VR.\nChoose your weapon and fight against alien swarm in Asian agglomeration."}]}, "developer_name": null, "developer_privacy_policy_url": "http://redlimbstudio.com/privacy-policy.html", "developer_terms_of_service_url": "http://redlimbstudio.com/privacy-policy.html", "publisher_name": "Red Limb Studio", "support_website_url": null, "website_url": "http://redlimbstudio.com/tpd.html", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["SHOOTER", "HORROR", "ACTION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD", "TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1146167436151886"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/12138933_1103676193080769_1835948143645032448_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Whz76VqkKq0Q7kNvwH4Y3Cs&_nc_oc=Adr8Zi-4SIKd8-yZqyog-v7dSoNV4ffspULj1JeJQ6CVX69wt-7YjaWnf9bx-9NWD90&_nc_zt=3&_nc_ht=sconte
KU-P&_nc_oc=Adr6MZIL9RjQPrabhOMyftC3gOZ71L6wpbnkV1hw2xWiL_PaaOKDxIWI0l-mOfPQ8RM&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAKZRDKGrUrjMCnha4BMwdU31NF3vcX3WieBzs0Ua8Ahg&oe=6A65EAB1"}, {"file_name": "migrated_image.png", "id": "503915403849657", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/12504647_1613397245621369_741789342199971840_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2U7m6p1irjMQ7kNvwF_RmTC&_nc_oc=AdpJfUhA1vrm44K4r6IVPdPA5WATXWoJvfzwGw2Qw8q5xlhiov6ZL24m1rdPb3jm04s&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAUikf1pfIv7HeI6sSrW5u_zatsCxeo-QgZ6cr-XXlKpg&oe=6A6600A3"}, {"file_name": "migrated_image.png", "id": "214678446270570", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/11162678_367766243614273_8732669583745351680_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MKxioJiCs4YQ7kNvwHfiSSu&_nc_oc=AdoNd3Gjgi0JWTDbM74zkf0z6qE0kqBacuz-_bZvQvGQRwgidppZFrshtiUB_k8Ni5Q&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBtZwkTYbwgT3pJ6tsCl3UAxxZ_XAdnduXcS_aeJqKTFg&oe=6A65F568"}, {"file_name": "migrated_image.png", "id": "144304540242505", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/12331050_329187584112763_4810020976727162880_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PF1kEi2-qcgQ7kNvwG0h-vV&_nc_oc=AdpwwM1PXiHb_NYbKc4dxX0GABrd38Os57LwX00ln8uXUHpC0nMhX7rPeHsFlHUKN_8&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCjeZd8lGn5EDTp9M4N1rDRP8tHOBTBkHAzIZazUm9rsA&oe=6A65F68F"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "The Purge Day", "keywords": ["Horror", "Purge", "Day", "Shooter", "Aliens"], "long_description": "\u201cThe action is fast, the aliens look great and at times the immersion can be truly terrifying.\u201d - The VR Shop\n\n\u201cThis is fu*king horror shooter\u201d - Escape\n\nSomething strange has happened. No one knows what. It is unstoppable. Our civilization is almost dead but Jack Bowman has to save his wife. Do you want to know how this story finishes?\nChoose your weapon and fight against alien swarm in Asian agglomeration.\nThe Purge Day is the first person narrative, immersive horror shooter designed exclusively for VR.\n\nTPD contains :\nSuspenseful story\nInteresting and challenging achievements\nHigh quality sounds and voiceovers\nA large selection of weapons\nImmersive and not easy gameplay\nA large number of opponents\nEach chapter finishes with a powerful boss \nNo motion sickness\n\nController not required but supported.", "short_description": "The Purge Day is the first person narrative, immersive horror shooter designed exclusively for VR.\nChoose your weapon and fight against alien swarm in Asian agglomeration."}]}, "developer_name": null, "developer_privacy_policy_url": "http://redlimbstudio.com/privacy-policy.html", "developer_terms_of_service_url": "http://redlimbstudio.com/privacy-policy.html", "publisher_name": "Red Limb Studio", "support_website_url": null, "website_url": "http://redlimbstudio.com/tpd.html", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["SHOOTER", "HORROR", "ACTION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD", "TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1146167436151886"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/12138933_1103676193080769_1835948143645032448_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=83ZBkD7jx4EQ7kNvwHSJ1D9&_nc_oc=AdqF36qK85A36Y0Vr4w9BtoXQnbqGvvUbw6wuTfG75g-yNhkkDDagARVCMf0NezvhDs&_nc_zt=3&_nc_ht=sconte
Q5_&_nc_oc=AdobExK1uHHMVSmdlxxSBMv4op-eWmhnf3TUXUiV4ph-cCyZEn6jg0dzZMq2jxZxgSA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKRHas3YoC_pANFUQg2C9_ci69Qc8D1oKI7rsV6kOo73A&oe=6AB93171"}, {"file_name": "migrated_image.png", "id": "503915403849657", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12504647_1613397245621369_741789342199971840_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-LCX66FeTJ0Q7kNvwHUOoso&_nc_oc=AdrkAJ4fvD-MkpbdsmxIczAHnsUYWTw6fkOIwAhgeXMGCuK5rU8ZfcbK5QVI72uJj1I&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIP6Id7TUypxsjgGTrcz0LNFRl37t6iidc6QqX5bTEtlw&oe=6AB90F23"}, {"file_name": "migrated_image.png", "id": "214678446270570", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/11162678_367766243614273_8732669583745351680_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JBFNe91BJakQ7kNvwGiBsst&_nc_oc=AdpkuKYdC6m60W4MYpt_1g7vku2OAEERVflMwxUQgaVAe96pXL1Twc4BOT5eJAsow4U&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI3ubn5TpzMinyaWcX2BxKPXC9doLCQcmWjMyInwI0sVA&oe=6AB93C28"}, {"file_name": "migrated_image.png", "id": "144304540242505", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12331050_329187584112763_4810020976727162880_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JSnIMVdl0vIQ7kNvwHOoLEV&_nc_oc=AdreBoNzE6Db8YpGw1dDKhD8htye1kEuKw-B5hLheuItG2zef6ZUoDrdiJx3LOA-E5w&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKIiEtsrXhmPc85s0HFMl_5FDGbDT8zdXA_RlWBPntZ9w&oe=6AB93D4F"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "The Purge Day", "keywords": ["Horror", "Purge", "Day", "Shooter", "Aliens"], "long_description": "\u201cThe action is fast, the aliens look great and at times the immersion can be truly terrifying.\u201d - The VR Shop\n\n\u201cThis is fu*king horror shooter\u201d - Escape\n\nSomething strange has happened. No one knows what. It is unstoppable. Our civilization is almost dead but Jack Bowman has to save his wife. Do you want to know how this story finishes?\nChoose your weapon and fight against alien swarm in Asian agglomeration.\nThe Purge Day is the first person narrative, immersive horror shooter designed exclusively for VR.\n\nTPD contains :\nSuspenseful story\nInteresting and challenging achievements\nHigh quality sounds and voiceovers\nA large selection of weapons\nImmersive and not easy gameplay\nA large number of opponents\nEach chapter finishes with a powerful boss \nNo motion sickness\n\nController not required but supported.", "short_description": "The Purge Day is the first person narrative, immersive horror shooter designed exclusively for VR.\nChoose your weapon and fight against alien swarm in Asian agglomeration."}]}, "developer_name": null, "developer_privacy_policy_url": "http://redlimbstudio.com/privacy-policy.html", "developer_terms_of_service_url": "http://redlimbstudio.com/privacy-policy.html", "publisher_name": "Red Limb Studio", "support_website_url": null, "website_url": "http://redlimbstudio.com/tpd.html", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["SHOOTER", "HORROR", "ACTION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD", "TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1146167436151886"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12138933_1103676193080769_1835948143645032448_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=teFZqLatr48Q7kNvwGyxRx3&_nc_oc=AdoVaZGJcf65jdmEBXiemd5T8Nm3143Uzia1Eej5MU8--YYy1PMFc3s11SorNMiA1OM&_nc_zt=3&_nc_ht=sconten
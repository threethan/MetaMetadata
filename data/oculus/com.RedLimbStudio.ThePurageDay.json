GaI&_nc_oc=AdqV7ZOg3kKen5EWZI_e7G-uWVwkj-AUbLzq0lnfb8_aSFlvLL4pm1x6V2SrUTtMXsM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKUvs_IKPwd2d9N2MnOyxQHypCMRycl41SnKWSG7I_MOA&oe=6AAFF6F1"}, {"file_name": "migrated_image.png", "id": "503915403849657", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12504647_1613397245621369_741789342199971840_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bUcz_LVCObkQ7kNvwG89rIg&_nc_oc=AdrZOJ05u21IGl2WYYAEkBbIOYe4bbNw8T_lyNMsXrmFed2ynW7oVTN-cGj_c2ulQJo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLYMB1Fb9x-ImPiPshODrmeVY9oFP9kpPTITaszFzh9lA&oe=6AAFD4A3"}, {"file_name": "migrated_image.png", "id": "214678446270570", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/11162678_367766243614273_8732669583745351680_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o0WttUibKM4Q7kNvwGURt0L&_nc_oc=Adq314VpDGSHTmLqn4Dx59lNHsKLnrEW_uspZJHGYPY5O21dAsEe1YnZQgZJscW7vas&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ2vl7INH_-CkA75x54lUg_BlAFMesUNKc-pu50JKbMFw&oe=6AB001A8"}, {"file_name": "migrated_image.png", "id": "144304540242505", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12331050_329187584112763_4810020976727162880_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xdOTQvqQfrYQ7kNvwFzHtB9&_nc_oc=Adp-lXC3buw89SsSSqTjCX_d0_0b7iOjBTWTV78K_W8s4GkToeun3LF688ZouNV1wXg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIOjjtbTO6uyJlusVa85mWXfbGyD3spTAkTp19fHeULEQ&oe=6AB002CF"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "The Purge Day", "keywords": ["Horror", "Purge", "Day", "Shooter", "Aliens"], "long_description": "\u201cThe action is fast, the aliens look great and at times the immersion can be truly terrifying.\u201d - The VR Shop\n\n\u201cThis is fu*king horror shooter\u201d - Escape\n\nSomething strange has happened. No one knows what. It is unstoppable. Our civilization is almost dead but Jack Bowman has to save his wife. Do you want to know how this story finishes?\nChoose your weapon and fight against alien swarm in Asian agglomeration.\nThe Purge Day is the first person narrative, immersive horror shooter designed exclusively for VR.\n\nTPD contains :\nSuspenseful story\nInteresting and challenging achievements\nHigh quality sounds and voiceovers\nA large selection of weapons\nImmersive and not easy gameplay\nA large number of opponents\nEach chapter finishes with a powerful boss \nNo motion sickness\n\nController not required but supported.", "short_description": "The Purge Day is the first person narrative, immersive horror shooter designed exclusively for VR.\nChoose your weapon and fight against alien swarm in Asian agglomeration."}]}, "developer_name": null, "developer_privacy_policy_url": "http://redlimbstudio.com/privacy-policy.html", "developer_terms_of_service_url": "http://redlimbstudio.com/privacy-policy.html", "publisher_name": "Red Limb Studio", "support_website_url": null, "website_url": "http://redlimbstudio.com/tpd.html", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["SHOOTER", "HORROR", "ACTION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD", "TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1146167436151886"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12138933_1103676193080769_1835948143645032448_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ELhWIC1oJYoQ7kNvwG174wh&_nc_oc=AdrXf57aDnznZW-dXbUctj4qj1F6BonpWE0cn8YjFWJPZClBRoQxpaH23s0fW4VGq8M&_nc_zt=3&_nc_ht=sconten
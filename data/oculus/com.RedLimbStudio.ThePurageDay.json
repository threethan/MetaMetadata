7cK2&_nc_oc=AdpelEZMsm-qCLhVZGqN-fQuTLxdqwut4Solh2rcp-SrGiWmAgNUkpPnkZrEMqEGh1s&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCJ4LANQh2yr76l_s9j1-85MLAZOMmljJ2aIPMupUskfg&oe=6A510AF1"}, {"file_name": "migrated_image.png", "id": "503915403849657", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12504647_1613397245621369_741789342199971840_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IlArCPx0NFYQ7kNvwEq3YlD&_nc_oc=AdraxFfTYE_MaDlvJn7vWl22hTW695quboO79KtXojHqMRPopyjNmkxjmIrPLC2M3cg&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC5W4fmSM0AGHpwWp3zHN4L80Cp9ufXRVWgGTHMmicZfw&oe=6A50E8A3"}, {"file_name": "migrated_image.png", "id": "214678446270570", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/11162678_367766243614273_8732669583745351680_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fZ3yrnt77lEQ7kNvwEAf-eb&_nc_oc=AdqqO-Z6GcWPYX5_JbgdB3C5zGAeWNGzMJNhKahXBVhs-wF4CmOjVtY29yVoA2zZNhE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBfBcWbmTRGwD95doRk_ZX5bixk7pM3JYeXBfqPtVW22Q&oe=6A5115A8"}, {"file_name": "migrated_image.png", "id": "144304540242505", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12331050_329187584112763_4810020976727162880_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Hugr3aoVJvYQ7kNvwFG__7K&_nc_oc=Ado20NaC_aGpVin7lfOikSXqQFbR2K8y9MIokz_xjWMre8J6AtJ-tkpKqBtF5oe5RJY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDF20uVOcTgm_c3BK9u8HQJE9URTVao1B33hP2_XhX_ag&oe=6A5116CF"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "The Purge Day", "keywords": ["Horror", "Purge", "Day", "Shooter", "Aliens"], "long_description": "\u201cThe action is fast, the aliens look great and at times the immersion can be truly terrifying.\u201d - The VR Shop\n\n\u201cThis is fu*king horror shooter\u201d - Escape\n\nSomething strange has happened. No one knows what. It is unstoppable. Our civilization is almost dead but Jack Bowman has to save his wife. Do you want to know how this story finishes?\nChoose your weapon and fight against alien swarm in Asian agglomeration.\nThe Purge Day is the first person narrative, immersive horror shooter designed exclusively for VR.\n\nTPD contains :\nSuspenseful story\nInteresting and challenging achievements\nHigh quality sounds and voiceovers\nA large selection of weapons\nImmersive and not easy gameplay\nA large number of opponents\nEach chapter finishes with a powerful boss \nNo motion sickness\n\nController not required but supported.", "short_description": "The Purge Day is the first person narrative, immersive horror shooter designed exclusively for VR.\nChoose your weapon and fight against alien swarm in Asian agglomeration."}]}, "developer_name": null, "developer_privacy_policy_url": "http://redlimbstudio.com/privacy-policy.html", "developer_terms_of_service_url": "http://redlimbstudio.com/privacy-policy.html", "publisher_name": "Red Limb Studio", "support_website_url": null, "website_url": "http://redlimbstudio.com/tpd.html", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["SHOOTER", "HORROR", "ACTION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD", "TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1146167436151886"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12138933_1103676193080769_1835948143645032448_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6NUEsD5BzasQ7kNvwEIy6qj&_nc_oc=Adob2BCu-KDyNcexqdThOGRv5IX_eGlYsEVDUTpJ_9nB_BcFzsXeP4Hyxqz3KQ7sshE&_nc_zt=3&_nc_ht=sconte
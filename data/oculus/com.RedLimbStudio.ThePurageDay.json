Q7kNvwEJCZCc&_nc_oc=AdrCjrXN0PFrM_cHDT4Kuf8OBC-UH1sH2U1_D0OkruCjCbCsJeSuyobZoFsfX0Mc-FA&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEZOHNx9tWmrGMixoeh2B2g8oUaJHyfDy1kegCie9H7_g&oe=6A7DA5B1"}, {"file_name": "migrated_image.png", "id": "503915403849657", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/12504647_1613397245621369_741789342199971840_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ttRj5s0pW0wQ7kNvwE2T94s&_nc_oc=AdoVCABmDBUoyXdhrOnGoSDj683SDY8CPZdHyaPkiadbruHnD20z3jNKAuYm59dQKrg&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHhOw1EGttxN1SZUhwsFux8MlcSJz6ay71Wgs_nfu3Cuw&oe=6A7DBBA3"}, {"file_name": "migrated_image.png", "id": "214678446270570", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/11162678_367766243614273_8732669583745351680_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=npa4TV3W0uoQ7kNvwGccqwG&_nc_oc=Adr-0ToJ7vyLaQp9XcR455FVjv1AiuGUKpAnJTUgMBLMSu08dQOnQ3Mo5wjRQhHciLY&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGt5fJRG-3zqdWLzY0eHFZWzohUi_GA5vpYc2GNg9jIKQ&oe=6A7DB068"}, {"file_name": "migrated_image.png", "id": "144304540242505", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/12331050_329187584112763_4810020976727162880_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ylRRXep2VKEQ7kNvwGfT2WS&_nc_oc=Adp3VKiF_x1NnvEVr6lOpyFz9IzLacuEw30iTVSRlwPqwv8FYOjBzhaSb4UgUSdZs8w&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHW0BgcGn1FmVlvd3I1itkro9roCn_kY2qzjVkz3r0hBw&oe=6A7DB18F"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "The Purge Day", "keywords": ["Horror", "Purge", "Day", "Shooter", "Aliens"], "long_description": "\u201cThe action is fast, the aliens look great and at times the immersion can be truly terrifying.\u201d - The VR Shop\n\n\u201cThis is fu*king horror shooter\u201d - Escape\n\nSomething strange has happened. No one knows what. It is unstoppable. Our civilization is almost dead but Jack Bowman has to save his wife. Do you want to know how this story finishes?\nChoose your weapon and fight against alien swarm in Asian agglomeration.\nThe Purge Day is the first person narrative, immersive horror shooter designed exclusively for VR.\n\nTPD contains :\nSuspenseful story\nInteresting and challenging achievements\nHigh quality sounds and voiceovers\nA large selection of weapons\nImmersive and not easy gameplay\nA large number of opponents\nEach chapter finishes with a powerful boss \nNo motion sickness\n\nController not required but supported.", "short_description": "The Purge Day is the first person narrative, immersive horror shooter designed exclusively for VR.\nChoose your weapon and fight against alien swarm in Asian agglomeration."}]}, "developer_name": null, "developer_privacy_policy_url": "http://redlimbstudio.com/privacy-policy.html", "developer_terms_of_service_url": "http://redlimbstudio.com/privacy-policy.html", "publisher_name": "Red Limb Studio", "support_website_url": null, "website_url": "http://redlimbstudio.com/tpd.html", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["SHOOTER", "HORROR", "ACTION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD", "TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1146167436151886"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/12138933_1103676193080769_1835948143645032448_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BuhOM4W-uFQQ7kNvwEESuUA&_nc_oc=AdrgDBGS_CmLi_iu-GcRVJaYKoLS3kOIhwDYraxiclTZyIziL_gCt6u7uLKyeyPI-gw&_nc_zt=3&_nc
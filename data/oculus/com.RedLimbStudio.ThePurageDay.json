A55Dn3YBT0gaOSLNThUlIlP77tKVoDAfgIhM8hoei4Uo_tw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afx5dlzVuZQNdY8PlS7MsqEAwwkBcAeP2kCRHAkDlc7ZBw&oe=69AFFBB1"}, {"file_name": "migrated_image.png", "id": "503915403849657", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12504647_1613397245621369_741789342199971840_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mc0N85vdI9kQ7kNvwFgETdh&_nc_oc=Adm4EfdP9A_V8j87Ju4rqhXMb4QSwvcVZZlo2BH1vNpspye6PXmFPi1fSl3KzaqnsA0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfwMS59LkB2ek4aWM0bHskLmIzJpTzDzLrlzdXwR1coiEQ&oe=69B011A3"}, {"file_name": "migrated_image.png", "id": "214678446270570", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/11162678_367766243614273_8732669583745351680_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=smXzQfiCCSgQ7kNvwFM06v_&_nc_oc=AdmyPBm_uSiaQvV8rYvXcraHdfoIV4uZJneGFnpz2vm6qBgoA8pg7MnxKBiG_RzsdeE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfwfuSyMIeUJybsBlHion-IlMMPp_CGCthxyNKHWv1SqIQ&oe=69B00668"}, {"file_name": "migrated_image.png", "id": "144304540242505", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12331050_329187584112763_4810020976727162880_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=X6dY2f1EMzkQ7kNvwF5NCcD&_nc_oc=AdnEL2KNyHwFAkh-UtJq34bjmE0yBu84F3TjTuhLF6vyBqfd18494aTrm3k4Xiy4_mA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfwLQ-gUjmkzofiKEctkykmpxmGSSV5yOQv061mXU-NA9A&oe=69B0078F"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "The Purge Day", "keywords": ["Horror", "Purge", "Day", "Shooter", "Aliens"], "long_description": "\u201cThe action is fast, the aliens look great and at times the immersion can be truly terrifying.\u201d - The VR Shop\n\n\u201cThis is fu*king horror shooter\u201d - Escape\n\nSomething strange has happened. No one knows what. It is unstoppable. Our civilization is almost dead but Jack Bowman has to save his wife. Do you want to know how this story finishes?\nChoose your weapon and fight against alien swarm in Asian agglomeration.\nThe Purge Day is the first person narrative, immersive horror shooter designed exclusively for VR.\n\nTPD contains :\nSuspenseful story\nInteresting and challenging achievements\nHigh quality sounds and voiceovers\nA large selection of weapons\nImmersive and not easy gameplay\nA large number of opponents\nEach chapter finishes with a powerful boss \nNo motion sickness\n\nController not required but supported.", "short_description": "The Purge Day is the first person narrative, immersive horror shooter designed exclusively for VR.\nChoose your weapon and fight against alien swarm in Asian agglomeration."}]}, "developer_name": null, "developer_privacy_policy_url": "http://redlimbstudio.com/privacy-policy.html", "developer_terms_of_service_url": "http://redlimbstudio.com/privacy-policy.html", "publisher_name": "Red Limb Studio", "support_website_url": null, "website_url": "http://redlimbstudio.com/tpd.html", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["SHOOTER", "HORROR", "ACTION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD", "TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1146167436151886"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12138933_1103676193080769_1835948143645032448_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O6fZcRn-rVkQ7kNvwEMbZ1H&_nc_oc=Adn77J4X_on5YqE0vz81qrZI5Slq63iEBPoTTlNNhA3aTpV2YxyKaPFgW6M2PO8aCM8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfxC7HDiS
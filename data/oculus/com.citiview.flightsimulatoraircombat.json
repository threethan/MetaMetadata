81_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NcWsWBgsNokQ7kNvwHEfPfR&_nc_oc=AdoE6HhYkQdIF-IlWuH5pmnHlMR9lbXIcCLL5dZ2bF9kxewUmR6zSg8Axs960bBueD4&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT67CxthnB7imC1_BimRDF7AUNyDzbmnvaaLIrIWeVM5w&oe=6AFC8E4A"}, {"file_name": "screenshot_5.png", "id": "4097952683842962", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/756589809_4097952687176295_8705200252664406509_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Xhx9-TKQ59UQ7kNvwHnfnH4&_nc_oc=Adr3M5YX8Xv19usHEdYgg5QWOZ35XTwim1eRE1sYVcR8x50IIMFovd0gCvXEY_1GzXs&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSm6LY9uia9ZGlmnWjpMpaq1GU0oYz0odZf6-hsAY2ndg&oe=6AFC94AB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_cover.png", "id": "4317911248458924", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/595119480_4317911251792257_2571756213589004065_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H9ruoxbJr9wQ7kNvwHjPuwQ&_nc_oc=Adrkvbn3NfM_B0xLQIse1BBp8Nglzbuny4-qMQvlLALDrNqUVmlv2IBWg8kaKAZIUFI&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRUc7AiBSC9r6CVyjJgU8rqyQRAcDPtQw1VR5AzEmG9sg&oe=6AFC8962"}, "display_name": "Flight Simulator Air Combat", "keywords": ["flight", "simulator", "fighter", "jet", "dogfight"], "long_description": "Flight Simulator Air Combat puts you in the seat of a modern fighter jet, and this time you are armed.\n\nYOUR SQUADRON HANGAR\nStart on the hangar floor with your ground crew around the jet. The crew chief salutes, you climb the stairs, and on the runway the canopy closes over your head.\n\nLOCK ON. FIRE.\nHold a bandit in front of you until the diamond turns red, then let a heat-seeking missile go. Inside a kilometre, switch to the cannon: real tracer rounds, a gunsight and a lead ring that shows you where to aim.\n\nEIGHT SORTIES\nFirst Blood, Scramble, Escort Flight 417, Wolfpack, Bomber Raid, Ace of Aces, Night Raid and Last Stand. Each one scored with stars.\n\nPROTECT THE AIRLINER\nRide on a passenger jet's wing across the island while three waves of attackers come for it. Get between them and Flight 417.\n\nFIGHT BESIDE A WINGMAN\nIn Wolfpack your wingman takes on four bandits with you.\n\nWHEN YOU ARE HIT, EJECT\nHits are felt in your hands, the airframe smokes, an engine catches fire, and the jet's voice tells you to get out. Hold B: the seat fires, your jet explodes ahead of you and your parachute opens above your head.\n\nA WHOLE ISLAND\nMountains, a harbour city, seven airports and a tropical sea, by day, at sunset or at night.\n\nCOMFORT\nSmooth, eased controls. The cockpit never shakes. A comfort vignette in hard turns.", "short_description": "Strap into a modern fighter jet and fight for the skies over a whole island. Lock on and fire heat-seeking missiles, guns hot on bandits, escort a passenger jet through waves of attackers, and when your jet is going down, pull the handle, eject and drift home under your parachute."}]}, "developer_name": null, "developer_privacy_policy_url": "https://citiview-games.pages.dev/flightsimulatoraircombat/privacy", "developer_terms_of_service_url": null, "publisher_name": "Citiview Studios", "support_website_url": null, "website_url": "https://citiview-games.pages.dev/flightsimulatoraircombat/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "459781504968480"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_p
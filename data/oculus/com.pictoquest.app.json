g?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d0hp88njHZEQ7kNvwFAHXRi&_nc_oc=AdrRj7XGV5AcNOGhn9VUBP-Q4Ms6ehL1ZYU6zG2agVHM2mhrfXptHPXbRq2fZ5kwzqY&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOIzYHGuRE9W6avxGz-7-djAHjZIp4T7UFd0kTKl5vvuA&oe=6AE34475"}, {"file_name": "03_LRE_Spotlight.png", "id": "1159597516726958", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/596061819_1159597520060291_5441657162470100689_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PMUmO8DULmgQ7kNvwF_vL_p&_nc_oc=AdonYxWQSaZ7Ja6qp3g0qjPmBTOT6e6n9ETRknkybmudPyh5XkY035FzUaEFSBsy3qc&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNzq7uKuNhgR844oronGOvUBk3ZavtTZxZkZ0CeO2XnHA&oe=6AE368B4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "PictoQuest_Landscape_2560x1440.png", "id": "1298138225772353", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/673566767_1298138229105686_6059049652376816348_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2W8lwSqN440Q7kNvwHiSrAg&_nc_oc=AdqiFjV7yp9KU1wfwwy0XYzW1I6fDUmqBnstvBc9LToAJK2P4mT2mGn0ps_Fxr_z_9Y&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNUqzQMMN8yf7ksJxUTkhcm7XyYqkdLofs-khIli0sGow&oe=6AE3548C"}, "display_name": "PictoQuest", "keywords": [], "long_description": "PictoQuest helps you examine rock art where you stand. Look at a surface through Quest 3 or Quest 3S and switch among live color-enhancement recipes designed to make subtle pigment differences easier to see. Adjust strength, choose a central sampling area, or lock an enhancement while you look around.\n\nUse Spotlight to compare an enhanced area with the surrounding original colors. Move or hide the menu so it stays out of your way. Save enhanced JPEG photos and record 2D video after approving Quest's capture prompt. PictoQuest also offers paired-camera side-by-side 3D video for compatible stereo players.\n\nEnhancements are visual aids, not proof that a mark is pigment or that an image has a particular age or meaning. Respect site access rules and avoid touching fragile surfaces.", "short_description": "Explore prehistoric rock art in mixed reality. Apply live color enhancements to your surroundings, compare them with the original view, and capture photos or video on Quest 3 and Quest 3S."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/pictonomicon/meta-quest-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Mark Willis", "support_website_url": "https://sites.google.com/view/pictonomicon/support", "website_url": "https://sites.google.com/view/pictonomicon/pictoquest-for-meta-quest", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "393222478507326"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1399504969909979"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/604298355_1654580362936855_6484885767122554624_n.png?stp=dst-png_s360x360&_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=esqG9fgtmd0Q7kNvwEeNe5y&_nc_oc=Adp6_bqabFUhTxI6GZyZAgKCcfgWutc1DaL81F-q6nOmvZiWOYLIOr-bM_pDrQ2YGGs&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNjIPFsSDKX1Q0y_Xxd_g6D1UJ40Ju94B3Ydx90VVMH5Q&oe=6AE3675B"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "PictoQuest", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "3626922114428
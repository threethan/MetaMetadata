Cd9yJJBblERYTGqYJXFJ54QN3lL6lb5t8&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD8oymsxa8g0Dqmta4HdVt4pYMrFrLAbtjgMclfW2G0dQ&oe=6A5F6930"}, {"file_name": "AlienScreen2.png", "id": "639680378476804", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473391865_639680381810137_5095883913130682800_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7MTJzFHLqNAQ7kNvwHsog1r&_nc_oc=Ado9jozEC1sc7Vp1nXxauOflVMdQl2DlQs_IAQarRKFaQj9-aXlS77hLMZpye57FpJI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA39zXJt8NHBFAqRf0LnNIuLW8XYQ3pi1nMpR__lX3QWQ&oe=6A5F7C88"}, {"file_name": "SHARKS_05.png", "id": "2269242109942347", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75630191_2269242113275680_4646654512371818505_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_XAAqgYvqDMQ7kNvwHL6hV_&_nc_oc=AdpQw4u1nwtlVA-koRYMLE5wW4CxomFodEPo3odZOfwl0VFzEr_rRI2KzI1yEXo0NKE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBHBY2Uh2FrnEEqnyEz9Qw42qvtLcgbRAQ9dnvpukCDlA&oe=6A5F6018"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "UFOSharks_CoverArt_2560x1400.png", "id": "875858905145790", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499617831_875858908479123_2302596823570161005_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jTGXbZo0cMYQ7kNvwHRjzot&_nc_oc=Adrp_WFWNJnw8CQzR-rNFZzyeCcAgrJwPjHXM5N0Lp20pysEjlBTXdwdr3PdPEUM3Uw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCrJaSaQoUDPfqjNxquhtKGmltnRblvZawGyChwEdppxA&oe=6A5F841E"}, "display_name": "SHARKS", "keywords": ["sandbox", "physics", "multiplayer", "hangout", "survival"], "long_description": "**\u2764\ufe0fDOWNLOAD NOW to get your free RUBBER DUCKY! \ud83e\udd86**\n\n\u2705 You're a shark\n\n\u2705 Hang out with friends\n\n\u2705 Proximity voice chat\n\n\u2705 Public and Private lobbies/rooms\n\n\u2705 100's of cosmetics to express your true shark\n\n\ud83e\udd88 **You're a shark**: you don't have hands so use your mouth to bite, grab, carry, place, fling, build, open, activate, attack and (of course) eat with your friends in this multiplayer physics sandbox game. \ud83e\udd88\n\n\ud83d\udd79\ufe0f **Unique third-person VR locomotion system** that only needs your head and one controller, plus you can play sitting, standing or room-scale.\n\n\ud83e\ude99 **Swim around** to collect hidden treasures and send them up to the FIN-TASTIC SALVAGE COMPANY for a reward: will you work together, or make it every shark for themselves?\n\n\ud83e\uddd1\u200d\ud83e\udd1d\u200d\ud83e\uddd1 **Play with your non-VR friends** on the flat-screen version. Each game is a quick snack-sized round so it's perfect to just drop-in or -out whenever you've got a spare minute.\n\n\ud83c\udfea **Visit the Shark Shop**, with a rotating inventory of items to unlock and wear to express your true shark.\n\n\ud83d\udcac **Sharks is Early Access** which means we are constantly adding new updates based on your feedback. Visit our ezone.com/discord to connect with other players, influence the design of the final game and collect free in-game perks.", "short_description": "\u2764\ufe0fDOWNLOAD NOW to get your free RUBBER DUCKY! \ud83e\udd86\n\n\u2705 You're a shark\n\u2705 Hang out with friends\n\u2705 Proximity voice chat\n\u2705 Public and Private lobbies/rooms\n\u2705 100's of cosmetics to express your true shark\n\n\ud83e\udd88 **You're a shark**: you don't have hands so use your mouth to bite, grab, carry, place, fling, build, open, activate, attack and (of course) eat with your friends in this multiplayer physics sandbox game. \ud83e\udd88"}]}, "developer_name": null, "developer_privacy_policy_url": "https://apps.ezone.com/privacy-statement/", "developer_terms_of_service_url": null, "publisher_name": "Ezone PTY LTD", "support_website_url": "https://sharks.ezone.com/discord", "website_url": "https://ezone.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id"
M9bN3fe0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ5JAhAijPtQqfNnwRcjblFMWWJu1hG9jvf6XYJxppuQQ&oe=6ABE5C6B"}, {"file_name": "Screen04.png", "id": "1343419042888294", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/57566697_1343419046221627_7953970189567143758_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-qVYoPM4OqUQ7kNvwEvHEzg&_nc_oc=Ado9Lp4RNis6qRnhKJ7_3lI3tGJadM27rIbmG1IbqGqlUq4fYek5CRZGoVrVdR3dWoI&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIahFM-W4uQjpfkNj5IJyEdMkgvrH9xrmEwHbfQp_eexg&oe=6ABE8196"}, {"file_name": "Screen03.png", "id": "905660597203865", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/57566697_905660600537198_34404823879072796_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RVqCkCXdGlYQ7kNvwHlkC78&_nc_oc=AdoVryhyXc_KapWRpNkfKZd6Ak0mkFYAgy4MPfgDTXztZVyzG4RqxdycY9jNLZpun10&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLQVl1W92zZX5CbeM8H51iW7f9nqODWTXobpFAdq6YHzw&oe=6ABE7493"}, {"file_name": "Screen02.png", "id": "107434759034425", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974844_107434762367758_2961221435767143771_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LzDuPaBnhPQQ7kNvwEoRCEK&_nc_oc=Adqon7EC9Eti-Z7dMc2Jcg_d1kwxTTdysd5h_9t7456WhrbirWRp6Eo_Ty4PMDSv0P4&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJY_X3PtH_8asqa6KYryOfHo_JEBWhlb5AcmT39xm8Bmg&oe=6ABE5D3D"}, {"file_name": "Screen05_2560x1440.png", "id": "1547673899049640", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974535_1547673902382973_7505119238297113617_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BvpabtAdC3AQ7kNvwGIuvnG&_nc_oc=AdqNyjL3QLHhny3uNktF4WCSMPX2Hi34vFC8uYDMmWFyFdDk4-AHGYtKX2TuyohYwsk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKo9XqRFhamycvjEGKu-vt3FTwhl-b6PfyFUx6BUCh3iw&oe=6ABE73F3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VideoThumb_2560x1440.png", "id": "698638202067330", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982719_698638205400663_289794054610158311_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AGooCsYSNr0Q7kNvwFjsKXu&_nc_oc=Adrz50Bp-SViZuBbcCT8TtQgGYh07_CJR0Snk39Yge8FcEk0f5fNRUPRPo_9PYkjONg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKUWh1y0K_hNG50tYAknHK53PnuU34vz8ghLccdynUBgA&oe=6ABE7C1D"}, "display_name": "SHARKS", "keywords": [], "long_description": "Eat your friends in 'SHARKS' a cross-platform (PC and VR) multiplayer hunting game. Hunt with groups of up to 10 people online. Eat whatever you can to survive and avoid the zombie sharks: last player standing wins. It's like Gorilla Tag with sharks.\n\nThe VR controls are super responsive (it feels like a human-shark mind meld): simply look where you want the shark to swim. Pull the trigger to move forward, press the grip button to chomp/eat things.", "short_description": "Eat your friends in 'SHARKS' a cross-platform (PC and VR) multiplayer hunting game. Hunt with groups of up to 10 people online. Eat whatever you can to survive and avoid the zombie sharks: last player standing wins. It's like Gorilla Tag with sharks."}]}, "developer_name": null, "developer_privacy_policy_url": "https://ezone.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Ezone PTY LTD", "support_website_url": null, "website_url": "https://ezone.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "MULTI_USER", "CO_OP"], "id": "219944073774624"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PUBLISHED", "id": "245104471462418"}, {"status": "PUBLISHED", "id": "1006562187377203"}]}, "baseline_offer": {"id": "245104471462418"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1720481722, "status": "PUBLISHED", "id": "245104471462418"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "38491496860437273", "version": "0.1"}, "id": "601272338109301", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "9571468216200189", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "38491496860437273"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "601272338109301"}]}, "change_log": "Release Notes - v0.1.42 - \"#SharksTrickShot VIDEO COMPETITION\"\n\nWe can't believe how much you guys are loving playing hoops, so we've made it even better and added a video competition for the best weekly trick shots.\n\nJust post your best trick shot videos to Instagram or TikTok and tag them with #SharksTrickShot. We are looking for incredible long shots, insane dunks and crazy bank shots - every Friday we'll pick the 10 best videos to win a limited edition in-game team jersey*!\n\nNew:\n- #SharksTrickShot video competition\n- Hoops reward for first team to get 20 points\n- Hoops added to Original and Sandcastle maps\n- Food added near basketball courts\n- Player platform icons\n\nFixes:\n- Basketball court sounds made local\n- Basketball physics more arcade-y\n- Basketball icon tweak\n\n* #SharksTrickShot Video Competition Rules: Starts Saturday August 8th. To enter post a video to Instagram or TikTok with the #SharksTrickShot tag anytime Saturday-Thursday PST. 10 winners of the in-game Team Jerseys are announced every Friday 5pm PST. Winners are contacted via comment on their video.\n\nIf you love playing SHARKS then buy a season pass, some skins or get a goldfish pack to show your support. All proceeds go right back into the game: new game modes, customizable items, maps, interactable creatures and objects and multiplayer servers.\n\nThanks so much for playing and please tell your friends: word of mouth is the best way to get more players in the game!\n\nIf you have any feedback or comments, or want to find out how to get some VR goggles for your shark come chat in our Discord (https://ezone.com/discord). Cheers!\n\n- Simon and Jamie", "created_date": 1786070226, "id": "38491496860437273", "version": "0.1", "version_code": 42, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "9571468216200189", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "38491496860437273"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "601272338109301"}]}, "change_log": "Release Notes - v0.1.41 - \"HOOPS\"\n\nGrab your friends and play some hoops! Plus we've got Red and Blue Team jerseys and more quests and leaderboards.\n\nNew:\n- Hoops\n- Hoops in-game scoreboard\n- Red and Blue Team jerseys\n- Basketball quests\n- Topside quests\n- Meta Quest Leaderboard: Basketball scores\n- Meta Quest Leaderboard: Topside visits\n\nFixes:\n- Other player's season tiers update live\n- Renamed Shopping Cart\n- Meta Quest Leaderboards updated more frequently\n- Cheats only enabled for developer accounts\n\nIf you love playing SHARKS then buy a season pass, some skins or get a goldfish pack to show your support. All proceeds go right back into the game: new game modes, customizable items, maps, interactable creatures and objects and multiplayer servers.\n\nThanks so much for playing and please tell your friends: word of mouth is the best way to get more players in the game!\n\nIf you have any feedback or comments, or want to find out how to get some VR goggles for your shark come chat in our Discord (https://ezone.com/discord). Cheers!\n\n- Simon and Jamie", "created_date": 1785907399, "id": "38444950405091919", "version": "0.1", "version_code": 41, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "9571468216200189", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "38491496860437273"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "601272338109301"}]}, "change_log": "Release Notes - v0.1.40 - \"TOPSIDE\"\n\nHave you ever wanted to get in the salvage cage and see what's topside? Now you can. There's no need to close the salvage cage door anymore, so you can send up anything - even if it only kinda fits.\n\nNew:\n- Salvage Cage: no need to close the door\n- Shopping trolley\n- Basketball\n- Filmmaker Mode: Access from the OPTIONS menu (or press 'F' on the PC version) to face and talk to the camera\n\nFixes:\n- Moderator tools menu fix\n- Snap turn dead zone tweak\n\nIf you love playing SHARKS then buy a season pass, some skins or get a goldfish pack to show your support. All proceeds go right back into the game: new game modes, customizable items, maps, interactable creatures and objects and multiplayer servers.\n\nThanks so much for playing and please tell your friends: word of mouth is the best way to get more players in the game!\n\nIf you have any feedback or comments, or want to find out how to get some VR goggles for your shark come chat in our Discord (https://ezone.com/discord). Cheers!\n\n- Simon and Jamie", "created_date": 1785483583, "id": "38335696036017357", "version": "0.1", "version_code": 40, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "9571468216200189", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "38491496860437273"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "601272338109301"}]}, "change_log": "Release Notes - v0.1.39 - \"BLUE RUBBER PARROT\"\n\nGrab your free blue rubber parrot while stocks last, plus we've made a few fixes on the Pirate map and the Skull Rock Skeleton boss.\n\nNew:\n- Free Blue Rubber Parrot\n- Boss: add physics to sword for more accurate dodging\n\nFixes:\n- Pirate Map: Ghost ship collider\n- Pirate Map: Audio reverb location triggers\n- More accurate positioning for bitten objects\n- Boss: sword swing particle effects\n- Boss: scaling check\n- Boss: adjust recharge timing\n- Text more readable\n- Sandcastle map chest quest sync\n\nIf you love playing SHARKS then buy a season pass, some skins or get a goldfish pack to show your support. All proceeds go right back into the game: new game modes, customizable items, maps, interactable creatures and objects and multiplayer servers.\n\nThanks so much for playing and please tell your friends: word of mouth is the best way to get more players in the game!\n\nIf you have any feedback or comments, or want to find out how to get some VR goggles for your shark come chat in our Discord (https://ezone.com/discord). Cheers!\n\n- Simon and Jamie", "created_date": 1784791003, "id": "38159964626923833", "version": "0.1", "version_code": 39, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "9571468216200189", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "38491496860437273"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "601272338109301"}]}, "change_log": "Release Notes - v0.1.38 - \"PIRATE SEASON\"\n\nPirate Season is here! Complete quests to earn XP and unlock limited edition items. \n\nThere are big daily quests that earn you lots of XP, plus the chest quests now earn you XP too, so you'll be levelling up and unlocking sweet new items before you know it!\n\nNew:\n- Season Pass 1 - Pirate Season\n- In-game notification system\n- Gain XP from quests\n- Tons of new quests\n- New Daily quests worth big XP\n- New cosmetics, plus exclusive 'season only' ones\n- More info on other players: season level, wins, kills, goldfish eaten\n- Pinatas with prizes: the more sharks work together, the bigger the rewards\n- Skeleton boss with prizes: the more sharks work together, the bigger the rewards\n\nFixes:\n- Menu scrolling performance improved\n- Quiting while in a multiplayer game improved \n- Improved salvage door closing\n- Improved salvage items passing through to surface\n- Cannon angle locked when bitten (easier to aim)\n- Cannons fire at any moveable object in range (not just sharks)\n- Adjusted jellyfish damage\n- Recycle items needed for quests\n\nIf you love playing SHARKS then buy a season pass, some skins or get a goldfish pack to show your support. All proceeds go right back into the game: new game modes, customizable items, maps, interactable creatures and objects and multiplayer servers.\n\nThanks so much for playing and please tell your friends: word of mouth is the best way to get more players in the game!\n\nIf you have any feedback or comments, or want to find out how to get some VR goggles for your shark come chat in our Discord (https://ezone.com/discord). Cheers!\n\n- Simon and Jamie", "created_date": 1784184453, "id": "38008060135447617", "version": "0.1", "version_code": 38, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}]}}, "viewer": {"user": null}}}
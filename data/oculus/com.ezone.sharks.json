0851746520", "version": "0.1"}, "id": "601272338109301", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "9571468216200189", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "40545070851746520"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": []}, "change_log": null, "created_date": 1793091652, "id": "40548448968075375", "version": "0.1", "version_code": 48, "release_status": "PENDING", "status": "DRAFT", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "9571468216200189", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "40545070851746520"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": []}, "change_log": null, "created_date": 1793088205, "id": "40547496044837334", "version": "0.1", "version_code": 47, "release_status": "PENDING", "status": "DRAFT", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "9571468216200189", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "40545070851746520"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "601272338109301"}]}, "change_log": "Release Notes - v0.1.46 - \"Hand Tracking Updates\"\n\nFull hand tracking has been added so now you can play start to finish without controllers.\n\nNew:\n- Hand Tracking: Messaging about hand tracking support added\n- Hand Tracking: Menu location adjusted to make access more comfortable\n- Hand Tracking: Disabled UI interactions when palm facing up (so system interactions override)\n- Salvage Cage: Adds items collected on the way up\n- Salvage Cage: Goldfish rewards disappear after a while\n\nFixes:\n- Updated Meta XR SDKs v81\n\nIf you love playing SHARKS then buy a season pass, some skins or get a goldfish pack to show your support. All proceeds go right back into the game: new game modes, customizable items, maps, interactable creatures and objects and multiplayer servers.\n\nThanks so much for playing and please tell your friends: word of mouth is the best way to get more players in the game!\n\nIf you have any feedback or comments come chat in our Discord (https://ezone.com/discord). Cheers!\n\n- Simon and Jamie", "created_date": 1793079071, "id": "40545070851746520", "version": "0.1", "version_code": 46, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "9571468216200189", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "40545070851746520"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": []}, "change_log": null, "created_date": 1792994015, "id": "40519892724264333", "version": "0.1", "version_code": 45, "release_status": "PENDING", "status": "DRAFT", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "9571468216200189", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "40545070851746520"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "601272338109301"}]}, "change_log": "Release Notes - v0.1.44 - \"Hand Tracking\"\n\nFull hand tracking has been added so now you can play start to finish without controllers.\n\nNew:\n- Hand tracking: In-game hand representation\n- Hand tracking: Left hand pinch to move\n- Hand tracking: Right hand pinch to bite\n- Hand tracking: Left hand swipe to snap turn left\n- Hand tracking: Right hand swipe to snap turn right\n- Hand tracking: UI\n- Hand tracking: In-game instructions and messaging\n- Hand tracking: Menu integration\n- Hand Tracking: Reticle for pointer tracking\n- Hand Tracking: Hide hands in mirror\n- Salvage Cage: Top is open\n\nFixes:\n- Boss difficulty scaling adjustments\n- Snap turn: Flick sensitivity adjustment\n- Snap turn: Increased to 90 degrees\n- UI: Scrolling text raycast even with empty space\n- UI: Adjust pointer line rendering\n- Basketball: return to court if absent too long\n- Adjusted shark spawn locations\n- Exit Filmmaker mode with menu toggle\n- Player list: Zombie players have green background\n\nIf you love playing SHARKS then buy a season pass, some skins or get a goldfish pack to show your support. All proceeds go right back into the game: new game modes, customizable items, maps, interactable creatures and objects and multiplayer servers.\n\nThanks so much for playing and please tell your friends: word of mouth is the best way to get more players in the game!\n\nIf you have any feedback or comments come chat in our Discord (https://ezone.com/discord). Cheers!\n\n- Simon and Jamie", "created_date": 1792990482, "id": "40519024281017844", "version": "0.1", "version_code": 44, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}]}}, "viewer": {"user": null}}}
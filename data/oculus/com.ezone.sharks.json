330", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982719_698638205400663_289794054610158311_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7J31OOvfmJoQ7kNvwEo60IN&_nc_oc=AdpSRmd9NvqmypVvyczLfm59M0IRD9EY0d1don8c3zvhc3nKZNrRzqcH-QWwvLXyqLE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMwHGbcVQHaqeBCLX2sllncG-H0S67EfBf9ZGvnC74mDg&oe=6AE6091D"}, "display_name": "SHARKS", "keywords": [], "long_description": "Eat your friends in 'SHARKS' a cross-platform (PC and VR) multiplayer hunting game. Hunt with groups of up to 10 people online. Eat whatever you can to survive and avoid the zombie sharks: last player standing wins. It's like Gorilla Tag with sharks.\n\nThe VR controls are super responsive (it feels like a human-shark mind meld): simply look where you want the shark to swim. Pull the trigger to move forward, press the grip button to chomp/eat things.", "short_description": "Eat your friends in 'SHARKS' a cross-platform (PC and VR) multiplayer hunting game. Hunt with groups of up to 10 people online. Eat whatever you can to survive and avoid the zombie sharks: last player standing wins. It's like Gorilla Tag with sharks."}]}, "developer_name": null, "developer_privacy_policy_url": "https://ezone.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Ezone PTY LTD", "support_website_url": null, "website_url": "https://ezone.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "MULTI_USER", "CO_OP"], "id": "219944073774624"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PUBLISHED", "id": "245104471462418"}, {"status": "PUBLISHED", "id": "1006562187377203"}]}, "baseline_offer": {"id": "245104471462418"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1720481722, "status": "PUBLISHED", "id": "245104471462418"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "40519024281017844", "version": "0.1"}, "id": "601272338109301", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "9571468216200189", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "40519024281017844"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": []}, "change_log": null, "created_date": 1792994015, "id": "40519892724264333", "version": "0.1", "version_code": 45, "release_status": "PENDING", "status": "DRAFT", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "9571468216200189", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "40519024281017844"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "601272338109301"}]}, "change_log": "Release Notes - v0.1.44 - \"Hand Tracking\"\n\nFull hand tracking has been added so now you can play start to finish without controllers.\n\nNew:\n- Hand tracking: In-game hand representation\n- Hand tracking: Left hand pinch to move\n- Hand tracking: Right hand pinch to bite\n- Hand tracking: Left hand swipe to snap turn left\n- Hand tracking: Right hand swipe to snap turn right\n- Hand tracking: UI\n- Hand tracking: In-game instructions and messaging\n- Hand tracking: Menu integration\n- Hand Tracking: Reticle for pointer tracking\n- Hand Tracking: Hide hands in mirror\n- Salvage Cage: Top is open\n\nFixes:\n- Boss difficulty scaling adjustments\n- Snap turn: Flick sensitivity adjustment\n- Snap turn: Increased to 90 degrees\n- UI: Scrolling text raycast even with empty space\n- UI: Adjust pointer line rendering\n- Basketball: return to court if absent too long\n- Adjusted shark spawn locations\n- Exit Filmmaker mode with menu toggle\n- Player list: Zombie players have green background\n\nIf you love playing SHARKS then buy a season pass, some skins or get a goldfish pack to show your support. All proceeds go right back into the game: new game modes, customizable items, maps, interactable creatures and objects and multiplayer servers.\n\nThanks so much for playing and please tell your friends: word of mouth is the best way to get more players in the game!\n\nIf you have any feedback or comments come chat in our Discord (https://ezone.com/discord). Cheers!\n\n- Simon and Jamie", "created_date": 1792990482, "id": "40519024281017844", "version": "0.1", "version_code": 44, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "9571468216200189", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "40519024281017844"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "601272338109301"}]}, "change_log": "Release Notes - v0.1.43 - \"Pirate Season Extended\"\n\nPirate Season has been extended to give you an even better chance to unlock all the prizes!\n\nNew:\n- Pirate Season extended\n\nIf you love playing SHARKS then buy a season pass, some skins or get a goldfish pack to show your support. All proceeds go right back into the game: new game modes, customizable items, maps, interactable creatures and objects and multiplayer servers.\n\nThanks so much for playing and please tell your friends: word of mouth is the best way to get more players in the game!\n\nIf you have any feedback or comments, or want to find out how to get some VR goggles for your shark come chat in our Discord (https://ezone.com/discord). Cheers!\n\n- Simon and Jamie", "created_date": 1790842277, "id": "39861645870089025", "version": "0.1", "version_code": 43, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "9571468216200189", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "40519024281017844"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "601272338109301"}]}, "change_log": "Release Notes - v0.1.42 - \"#SharksTrickShot VIDEO COMPETITION\"\n\nWe can't believe how much you guys are loving playing hoops, so we've made it even better and added a video competition for the best weekly trick shots.\n\nJust post your best trick shot videos to Instagram or TikTok and tag them with #SharksTrickShot. We are looking for incredible long shots, insane dunks and crazy bank shots - every Friday we'll pick the 10 best videos to win a limited edition in-game team jersey*!\n\nNew:\n- #SharksTrickShot video competition\n- Hoops reward for first team to get 20 points\n- Hoops added to Original and Sandcastle maps\n- Food added near basketball courts\n- Player platform icons\n\nFixes:\n- Basketball court sounds made local\n- Basketball physics more arcade-y\n- Basketball icon tweak\n\n* #SharksTrickShot Video Competition Rules: Starts Saturday August 8th. To enter post a video to Instagram or TikTok with the #SharksTrickShot tag anytime Saturday-Thursday PST. 10 winners of the in-game Team Jerseys are announced every Friday 5pm PST. Winners are contacted via comment on their video.\n\nIf you love playing SHARKS then buy a season pass, some skins or get a goldfish pack to show your support. All proceeds go right back into the game: new game modes, customizable items, maps, interactable creatures and objects and multiplayer servers.\n\nThanks so much for playing and please tell your friends: word of mouth is the best way to get more players in the game!\n\nIf you have any feedback or comments, or want to find out how to get some VR goggles for your shark come chat in our Discord (https://ezone.com/discord). Cheers!\n\n- Simon and Jamie", "created_date": 1786070226, "id": "38491496860437273", "version": "0.1", "version_code": 42, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "9571468216200189", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "40519024281017844"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "601272338109301"}]}, "change_log": "Release Notes - v0.1.41 - \"HOOPS\"\n\nGrab your friends and play some hoops! Plus we've got Red and Blue Team jerseys and more quests and leaderboards.\n\nNew:\n- Hoops\n- Hoops in-game scoreboard\n- Red and Blue Team jerseys\n- Basketball quests\n- Topside quests\n- Meta Quest Leaderboard: Basketball scores\n- Meta Quest Leaderboard: Topside visits\n\nFixes:\n- Other player's season tiers update live\n- Renamed Shopping Cart\n- Meta Quest Leaderboards updated more frequently\n- Cheats only enabled for developer accounts\n\nIf you love playing SHARKS then buy a season pass, some skins or get a goldfish pack to show your support. All proceeds go right back into the game: new game modes, customizable items, maps, interactable creatures and objects and multiplayer servers.\n\nThanks so much for playing and please tell your friends: word of mouth is the best way to get more players in the game!\n\nIf you have any feedback or comments, or want to find out how to get some VR goggles for your shark come chat in our Discord (https://ezone.com/discord). Cheers!\n\n- Simon and Jamie", "created_date": 1785907399, "id": "38444950405091919", "version": "0.1", "version_code": 41, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}]}}, "viewer": {"user": null}}}
=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRLe-n96z8nUxX-qXxH_-dzII5-6aUBmewu2aYCkiU-Lg&oe=6AFC7E98"}, {"file_name": "Screenshot06.png", "id": "1454474640034793", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499619697_1454474646701459_2191563840414321388_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rEiTRWFpLXQQ7kNvwHbFtqN&_nc_oc=AdpPotbn4js3ZjLsfMK9QDrMGunq8IFJmonn0M8g4TTz1f1ZxEoT50w2CPZ2ZxZtxbI&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTxVHAm27mnV7B7-CIN6zoHtJlpiFXEJ9L7wcgDb3bAsw&oe=6AFC9702"}, {"file_name": "Salvage Update.png", "id": "1169281181898851", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499619704_1169281185232184_358389227043091305_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=72ePEzx8udEQ7kNvwHFz6ll&_nc_oc=AdommClInJ6T7T2E-dGCzCgApZsYzBFbJs85tWsNVpdR_L7JBT_AxNWh0b2KVyjO1hU&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ-QagpsQu5212zWa5WjXq9s03CoynmQO1DTLjxItoxKA&oe=6AFC8AFC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverArt_2560x1440.png", "id": "1562785672067106", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/595112037_1562785675400439_2492130118979516265_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JI1PybQhvO4Q7kNvwEMoR7J&_nc_oc=AdoKTKh4QpiJxqXY2TVMY_Lz_sftroMspy6Z4EEijB8i8cCbHGN118rI5JeBu6bPOhg&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTaU9t1-yNPHWpy-A6sTEx2nOuGfYh-rMa8ytCjtpg6dQ&oe=6AFC6D24"}, "display_name": "SHARKS", "keywords": ["sandbox", "physics", "multiplayer", "hangout", "handtracking"], "long_description": "# \ud83e\udd88\ud83e\udd1aHAND TRACKING UPDATE! \ud83e\udd1a\ud83e\udd88\n\nDive into SHARKS, the multiplayer VR game where you and your friends become sharks exploring a living, physics-driven ocean together. Swim, hunt, and team up - with controls so easy anyone can start chomping. You don't even need a controller - just use your hands!\n\n# \ud83c\udf0a A Living, Reactive Ocean\nIt's a full-on physics sandbox where everything reacts to everything else. Bite and throw an explosive near a mine, cannonball or other shark and watch the chaos unfold.\n{1043586188151841}\n# \ud83d\udc65 Multiplayer with Voice Chat \nJoin public rooms to meet new players, or create private ones for friends. Team up to take down challenges - like popping the pi\u00f1ata or battling the Skull Rock skeleton boss - for huge rewards for the whole crew.\n{1735211784153859}\n#  \ud83e\udd1aComfort-First Controls\nNo flapping arms, no complicated setup. Just look where you want to go, left pinch to swim, right pinch to bite. Smooth camera, responsive head-tracking, zero setup - perfect whether you're a VR first-timer or seasoned pro.\n{1942595149760184}\n# \ud83c\udff4\u200d\u2620\ufe0f Season 1: Pirates \u2014 Live Now\nComplete quests together, earn XP, and level up through the tiers for exclusive season only rewards.\n{1024595593835573}\n# \ud83d\udcb0 Collect, Salvage, Customize\nCarry loot in your mouth to the salvage cage, hoist it up for Goldfish, then trick out your shark to reflect your personality.\n{1947888362582245}\n# \ud83d\ude97 Play Anywhere\nComfy, low-motion controls make SHARKS a great pick for VR on the go \u2014 play as a passenger in a car, boat, or plane.\n{868171872678823}\n# Ready to explore the ocean's depths with friends? Grab your headset and dive in!", "short_description": "\ud83e\udd88\ud83e\udd1aHAND TRACKING UPDATE! \ud83e\udd1a\ud83e\udd88\n\nBecome a shark and rule a living, physics-driven ocean! Hunt, survive, and team up with friends to take down bosses, collect loot, and customize your look. Controls so simple, anyone can dive in instantly - no VR experience required. No controllers required - just use your hands!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://apps.ezone.com/privacy-statement/", "developer_terms_of_servic
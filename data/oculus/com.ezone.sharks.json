TLvZN7gE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEGyaxuZIcMmPFjMMJDvIPELuIUKRDs-Cr5XWOH8ugTLw&oe=6A787CEB"}, {"file_name": "Screen04.png", "id": "1343419042888294", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/57566697_1343419046221627_7953970189567143758_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qKOQGxvo0hcQ7kNvwFkcvOy&_nc_oc=Adpj7nmBuXllMn6kI58_4d-v1Mosc08Sry3i98z9DVtZUcC-nrssJd1qNvtSKIB3sOA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGiL8ZWtuXxV52WmU-QrFPmfGg-KAUY3IqkkETcecKnIQ&oe=6A7869D6"}, {"file_name": "Screen03.png", "id": "905660597203865", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/57566697_905660600537198_34404823879072796_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3qZkVunmfnMQ7kNvwGGWF2-&_nc_oc=AdqNmn0nvViHiSDLhdbUAd_f5Tge4Svvrqv8fv5mkUhbR6-l4dIz3PBqlhpFw9bhgPY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEdtQ12lmQYt_theQXLOhUVbPNFW6Tb-XxMiXvZt8eN5Q&oe=6A789513"}, {"file_name": "Screen02.png", "id": "107434759034425", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974844_107434762367758_2961221435767143771_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3GftONDtrJEQ7kNvwGEhbxq&_nc_oc=AdqhJ9R6PcNNze7lkVr0cotKR3JtccrfI0ar5-tspt2XM38gfz_XkaD6-q37stbPd1U&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFAXyu0rcjXOZwYrJnhcvR6yWG6-r6R6SkJPeJVZWnkRQ&oe=6A787DBD"}, {"file_name": "Screen05_2560x1440.png", "id": "1547673899049640", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974535_1547673902382973_7505119238297113617_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pAgXxGCf9vIQ7kNvwFzhSpb&_nc_oc=Adr_MjAvNe5ftilMlBm6A6noltv6OYZuQqugdRC3kYMLY6jfTNYmR8T2USzQDqRGFxc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFb0dVSEo8RhVbQJdq5sa3WgxiNbFB-2YXI_BLouCXNhg&oe=6A789473"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VideoThumb_2560x1440.png", "id": "698638202067330", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982719_698638205400663_289794054610158311_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hcy_OUMELUMQ7kNvwHxajmN&_nc_oc=AdoAKjTwbwGTHWpANdky8CxEQiqU7_U6WOXuampP-mkfoCEMafm9eRC3xH3UmCxSjPY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE2heFwuGaKcWthokwr9Coi-IyB-aw3rXyBDrLt0QD4qQ&oe=6A78645D"}, "display_name": "SHARKS", "keywords": [], "long_description": "Eat your friends in 'SHARKS' a cross-platform (PC and VR) multiplayer hunting game. Hunt with groups of up to 10 people online. Eat whatever you can to survive and avoid the zombie sharks: last player standing wins. It's like Gorilla Tag with sharks.\n\nThe VR controls are super responsive (it feels like a human-shark mind meld): simply look where you want the shark to swim. Pull the trigger to move forward, press the grip button to chomp/eat things.", "short_description": "Eat your friends in 'SHARKS' a cross-platform (PC and VR) multiplayer hunting game. Hunt with groups of up to 10 people online. Eat whatever you can to survive and avoid the zombie sharks: last player standing wins. It's like Gorilla Tag with sharks."}]}, "developer_name": null, "developer_privacy_policy_url": "https://ezone.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Ezone PTY LTD", "support_website_url": null, "website_url": "https://ezone.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "MULTI_USER", "CO_OP"], "id": "219944073774624"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PUBLISHED", "id": "245104471462418"}, {"status": "PUBLISHED", "id": "1006562187377203"}]}, "baseline_offer": {"id": "245104471462418"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1720481722, "status": "PUBLISHED", "id": "245104471462418"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "38335696036017357", "version": "0.1"}, "id": "601272338109301", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "9571468216200189", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "38335696036017357"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "601272338109301"}]}, "change_log": "Release Notes - v0.1.40 - \"TOPSIDE\"\n\nHave you ever wanted to get in the salvage cage and see what's topside? Now you can. There's no need to close the salvage cage door anymore, so you can send up anything - even if it only kinda fits.\n\nNew:\n- Salvage Cage: no need to close the door\n- Shopping trolley\n- Basketball\n- Filmmaker Mode: Access from the OPTIONS menu (or press 'F' on the PC version) to face and talk to the camera\n\nFixes:\n- Moderator tools menu fix\n- Snap turn dead zone tweak\n\nIf you love playing SHARKS then buy a season pass, some skins or get a goldfish pack to show your support. All proceeds go right back into the game: new game modes, customizable items, maps, interactable creatures and objects and multiplayer servers.\n\nThanks so much for playing and please tell your friends: word of mouth is the best way to get more players in the game!\n\nIf you have any feedback or comments, or want to find out how to get some VR goggles for your shark come chat in our Discord (https://ezone.com/discord). Cheers!\n\n- Simon and Jamie", "created_date": 1785483583, "id": "38335696036017357", "version": "0.1", "version_code": 40, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "9571468216200189", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "38335696036017357"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "601272338109301"}]}, "change_log": "Release Notes - v0.1.39 - \"BLUE RUBBER PARROT\"\n\nGrab your free blue rubber parrot while stocks last, plus we've made a few fixes on the Pirate map and the Skull Rock Skeleton boss.\n\nNew:\n- Free Blue Rubber Parrot\n- Boss: add physics to sword for more accurate dodging\n\nFixes:\n- Pirate Map: Ghost ship collider\n- Pirate Map: Audio reverb location triggers\n- More accurate positioning for bitten objects\n- Boss: sword swing particle effects\n- Boss: scaling check\n- Boss: adjust recharge timing\n- Text more readable\n- Sandcastle map chest quest sync\n\nIf you love playing SHARKS then buy a season pass, some skins or get a goldfish pack to show your support. All proceeds go right back into the game: new game modes, customizable items, maps, interactable creatures and objects and multiplayer servers.\n\nThanks so much for playing and please tell your friends: word of mouth is the best way to get more players in the game!\n\nIf you have any feedback or comments, or want to find out how to get some VR goggles for your shark come chat in our Discord (https://ezone.com/discord). Cheers!\n\n- Simon and Jamie", "created_date": 1784791003, "id": "38159964626923833", "version": "0.1", "version_code": 39, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "9571468216200189", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "38335696036017357"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "601272338109301"}]}, "change_log": "Release Notes - v0.1.38 - \"PIRATE SEASON\"\n\nPirate Season is here! Complete quests to earn XP and unlock limited edition items. \n\nThere are big daily quests that earn you lots of XP, plus the chest quests now earn you XP too, so you'll be levelling up and unlocking sweet new items before you know it!\n\nNew:\n- Season Pass 1 - Pirate Season\n- In-game notification system\n- Gain XP from quests\n- Tons of new quests\n- New Daily quests worth big XP\n- New cosmetics, plus exclusive 'season only' ones\n- More info on other players: season level, wins, kills, goldfish eaten\n- Pinatas with prizes: the more sharks work together, the bigger the rewards\n- Skeleton boss with prizes: the more sharks work together, the bigger the rewards\n\nFixes:\n- Menu scrolling performance improved\n- Quiting while in a multiplayer game improved \n- Improved salvage door closing\n- Improved salvage items passing through to surface\n- Cannon angle locked when bitten (easier to aim)\n- Cannons fire at any moveable object in range (not just sharks)\n- Adjusted jellyfish damage\n- Recycle items needed for quests\n\nIf you love playing SHARKS then buy a season pass, some skins or get a goldfish pack to show your support. All proceeds go right back into the game: new game modes, customizable items, maps, interactable creatures and objects and multiplayer servers.\n\nThanks so much for playing and please tell your friends: word of mouth is the best way to get more players in the game!\n\nIf you have any feedback or comments, or want to find out how to get some VR goggles for your shark come chat in our Discord (https://ezone.com/discord). Cheers!\n\n- Simon and Jamie", "created_date": 1784184453, "id": "38008060135447617", "version": "0.1", "version_code": 38, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "9571468216200189", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "38335696036017357"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "601272338109301"}]}, "change_log": "Release Notes - v0.1.37 - \"JOIN HOT FIX\"\n\nThis hot fix adds more variety to the rooms when joining a random room from the lobby.\n\nFixes:\n- Join multiplayer room\n\nIf you love playing SHARKS then buy some skins or get a goldfish pack to show your support. All proceeds go right back into the game: new game modes, customizable items, maps, interactable creatures and objects and multiplayer servers.\n\nThanks so much for playing and please tell your friends: word of mouth is the best way to get more players in the game!\n\nIf you have any feedback or comments, or want to find out how to get some VR goggles for your shark come chat in our Discord (https://ezone.com/discord). Cheers!\n\n- Simon and Jamie", "created_date": 1774921728, "id": "35611419478445040", "version": "0.1", "version_code": 37, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "9571468216200189", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "38335696036017357"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "601272338109301"}]}, "change_log": "Release Notes - v0.1.36 - \"NEW LOBBY\"\n\nThe lobby system has been improved to make it easier to meet up with other players and see available rooms without leaving your current game. Plus the starting hub is now multiplayer, so you'll never be lonely again!\n\nNew:\n- Multiplayer Lobby: faster and easier to check and move to other rooms\n- Game starts in a multiplayer room\n- New start menu screen\n- Player list icons (and colors for premium outfits)\n\nFixes:\n- Improved room creation menu\n- Increased length of room names\n- Updated reward double items for chest quests\n- Steam login check for voice chat\n- If platform login fails can still join rooms (but no voice chat)\n- Text on signs easier to read\n\nIf you love playing SHARKS then buy some skins or get a goldfish pack to show your support. All proceeds go right back into the game: new game modes, customizable items, maps, interactable creatures and objects and multiplayer servers.\n\nThanks so much for playing and please tell your friends: word of mouth is the best way to get more players in the game!\n\nIf you have any feedback or comments, or want to find out how to get some VR goggles for your shark come chat in our Discord (https://ezone.com/discord). Cheers!\n\n- Simon and Jamie", "created_date": 1774858953, "id": "35597399993180322", "version": "0.1", "version_code": 36, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}]}}, "viewer": {"user": null}}}
&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4C2XCrJns-0Q7kNvwHF4vnk&_nc_oc=Adr7iKvfs-aTU86ozP_zDaeq5aHmor2rM9dbcmIbM5Yekm-VJB584m3MUqZzoWu1KVE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTR3YioiqA0jLQvag-HWcV3AKGfcd2kjsTdU9fnp4U1KA&oe=6AFDBBF3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VideoThumb_2560x1440.png", "id": "698638202067330", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982719_698638205400663_289794054610158311_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nr9J54IHXF4Q7kNvwHmHwD9&_nc_oc=AdrlDss4AaXwVVdLsolV1KJsuZxfmhMmjqsPH4TPCHDo5nbEOYbm5atdIpCW23k1xAQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSCAp8FYeF9INXdXrictZg2YzfsLVbZOXq92_nLyskenw&oe=6AFDC41D"}, "display_name": "SHARKS", "keywords": [], "long_description": "Eat your friends in 'SHARKS' a cross-platform (PC and VR) multiplayer hunting game. Hunt with groups of up to 10 people online. Eat whatever you can to survive and avoid the zombie sharks: last player standing wins. It's like Gorilla Tag with sharks.\n\nThe VR controls are super responsive (it feels like a human-shark mind meld): simply look where you want the shark to swim. Pull the trigger to move forward, press the grip button to chomp/eat things.", "short_description": "Eat your friends in 'SHARKS' a cross-platform (PC and VR) multiplayer hunting game. Hunt with groups of up to 10 people online. Eat whatever you can to survive and avoid the zombie sharks: last player standing wins. It's like Gorilla Tag with sharks."}]}, "developer_name": null, "developer_privacy_policy_url": "https://ezone.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Ezone PTY LTD", "support_website_url": null, "website_url": "https://ezone.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "MULTI_USER", "CO_OP"], "id": "219944073774624"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PUBLISHED", "id": "245104471462418"}, {"status": "PUBLISHED", "id": "1006562187377203"}]}, "baseline_offer": {"id": "245104471462418"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1720481722, "status": "PUBLISHED", "id": "245104471462418"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "40982297334690534", "version": "0.1"}, "id": "601272338109301", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "9571468216200189", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "40982297334690534"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "601272338109301"}]}, "change_log": "Release Notes - v0.1.51 - \"Minor Update\"\n\nA tutorial for controllers and a few little hand tracking bug fixes.\n\nNew:\n- Controllers: Tutorial for new players (can also access from the menu)\n\nFixes:\n- Hand Tracking: Stop input when hand tracking is lost\n- Hand Tracking: Tweaked angle of left hand to activate game menu\n- Bosses: Adjusted reward items\n- Bosses: Damage effects visuals for multiplayer\n\nIf you love playing SHARKS then buy a season pass, some skins or get a goldfish pack to show your support. All proceeds go right back into the game: new game modes, customizable items, maps, interactable creatures and objects and multiplayer servers.\n\nThanks so much for playing and please tell your friends: word of mouth is the best way to get more players in the game!\n\nIf you have any feedback or comments come chat in our Discord (https://ezone.com/discord). Cheers!\n\n- Simon and Jamie", "created_date": 1794470499, "id": "40982297334690534", "version": "0.1", "version_code": 51, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "9571468216200189", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "40982297334690534"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "601272338109301"}]}, "change_log": "Release Notes - v0.1.50 - \"Hand Tracking Guide\"\n\nThere is now a controls guide/tutorial for the first time playing with hand tracking.\n\nNew:\n- Hand Tracking: Tutorial for new players (can also access from the menu)\n- Hand Tracking: Poke input added to menus if you get too close\n\nFixes:\n- Hand Tracking: Must be looking at left hand for palm-up pinch to activate game menu\n- Hand Tracking: Mouth disabled when over buttons on menus\n- Menus: Buttons feedback on hover and press\n- Loading: Practice biting on the loading menu\n- Loading: Scene orientation on load\n\nIf you love playing SHARKS then buy a season pass, some skins or get a goldfish pack to show your support. All proceeds go right back into the game: new game modes, customizable items, maps, interactable creatures and objects and multiplayer servers.\n\nThanks so much for playing and please tell your friends: word of mouth is the best way to get more players in the game!\n\nIf you have any feedback or comments come chat in our Discord (https://ezone.com/discord). Cheers!\n\n- Simon and Jamie", "created_date": 1794230122, "id": "40904815799105355", "version": "0.1", "version_code": 50, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "9571468216200189", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "40982297334690534"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "601272338109301"}]}, "change_log": "Release Notes - v0.1.49 - \"Try It On\"\n\nYou can now try on cosmetics in the Shark Shop.\n\nNew:\n- Try on cosmetics before buying\n- Add-On: 5,000 goldfish pack\n\nFixes:\n- Hand Tracking: Match system hand outline color on palm up\n- System Menu: Shark paused when system menu shown\n- Messages: Fixed message frequency after game pause\n- Original Map: Updated signs\n\nIf you love playing SHARKS then buy a season pass, some skins or get a goldfish pack to show your support. All proceeds go right back into the game: new game modes, customizable items, maps, interactable creatures and objects and multiplayer servers.\n\nThanks so much for playing and please tell your friends: word of mouth is the best way to get more players in the game!\n\nIf you have any feedback or comments come chat in our Discord (https://ezone.com/discord). Cheers!\n\n- Simon and Jamie", "created_date": 1793273714, "id": "40605756369011301", "version": "0.1", "version_code": 49, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "9571468216200189", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "40982297334690534"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": []}, "change_log": null, "created_date": 1793091652, "id": "40548448968075375", "version": "0.1", "version_code": 48, "release_status": "PENDING", "status": "DRAFT", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "9571468216200189", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "40982297334690534"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": []}, "change_log": null, "created_date": 1793088205, "id": "40547496044837334", "version": "0.1", "version_code": 47, "release_status": "PENDING", "status": "DRAFT", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}]}}, "viewer": {"user": null}}}
t=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL7v-sXbug2t3yeZwaHeyngSTCZmVZzFRNR_gQDG9cESw&oe=6ABE8818"}, {"file_name": "Screenshot06.png", "id": "1454474640034793", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499619697_1454474646701459_2191563840414321388_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Q9pPjzTEY3AQ7kNvwGFIrkP&_nc_oc=AdojvslTwNIXMDlMtq2MONQgKB0Glx9IPwfNOO1iL-38Cb5Qd7cgPMO3L6FAlRtJw2k&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL_oLkmmi1z4r8iV9O8HTPBpoovpvWUFXLcqvWv8OLf8w&oe=6ABE6842"}, {"file_name": "Salvage Update.png", "id": "1169281181898851", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499619704_1169281185232184_358389227043091305_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DunEkmUAiJUQ7kNvwHAubkX&_nc_oc=Ados-kSPL00b8yr-7o7uA75OKxK33U1hHilTbjkL8-1TvhoU8DwZxXYGKVo-eVmftzw&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJKor36AzYIM8TnK8CAS0K2XP4KLRLZB9BGjI-nxq_U1g&oe=6ABE5C3C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverArt_2560x1440.png", "id": "1562785672067106", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/595112037_1562785675400439_2492130118979516265_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C89eQElFhdwQ7kNvwFJYlVM&_nc_oc=Adpn9tc4sgPF-D5ltgx_RuD0bsXUn_jB9PtxpKHMw9u2CIZemURbNLvwUMT0UOUQXnE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJPmffyWOq-B0OyYSN7qk8PI0o-j5EpxTeJrIZCMM94xA&oe=6ABE76A4"}, "display_name": "SHARKS", "keywords": ["sandbox", "physics", "multiplayer", "hangout", "platformer"], "long_description": "# \ud83c\udff4\u200d\u2620\ufe0f\ud83e\udd9cSEASON 1 - PIRATES is OUT NOW! \ud83e\udd9c\ud83c\udff4\u200d\u2620\ufe0f\n\nDive into SHARKS, the multiplayer VR game where you and your friends become sharks exploring a living, physics-driven ocean together. Swim, hunt, and team up - with controls so easy, anyone can grab a controller and start chomping.\n\n# \ud83c\udf0a A Living, Reactive Ocean\n\nIt's a full-on physics sandbox where everything reacts to everything else. Bite and throw an explosive near a mine, cannonball or other shark and watch the chaos unfold.\n{1043586188151841}\n# \ud83d\udc65 Multiplayer with Voice Chat \nJoin public rooms to meet new players, or create private ones for friends. Team up to take down challenges - like popping the pi\u00f1ata or battling the Skull Rock skeleton boss - for huge rewards for the whole crew.\n{1735211784153859}\n# \ud83c\udfae Comfort-First Controls\nNo flapping arms, no complicated setup. Just look where you want to go, trigger to swim, grab to bite. Smooth camera, responsive head-tracking, zero setup - perfect whether you're a VR first-timer or seasoned pro.\n{1942595149760184}\n# \ud83c\udff4\u200d\u2620\ufe0f Season 1: Pirates \u2014 Live Now\nComplete quests together, earn XP, and level up through the tiers for exclusive season only rewards.\n{1024595593835573}\n# \ud83d\udcb0 Collect, Salvage, Customize\nCarry loot in your mouth to the salvage cage, hoist it up for Goldfish, then trick out your shark to reflect your personality.\n{1947888362582245}\n# \ud83d\ude97 Play Anywhere\nComfy, low-motion controls make SHARKS a great pick for VR on the go \u2014 play as a passenger in a car, boat, or plane.\n{868171872678823}\n# Ready to explore the ocean's depths with friends? Grab your headset and dive in!", "short_description": "\ud83c\udff4\u200d\u2620\ufe0f\ud83e\udd9cSEASON 1 - PIRATES is OUT NOW! \ud83e\udd9c\ud83c\udff4\u200d\u2620\ufe0f\n\nBecome a shark and rule a living, physics-driven ocean! Hunt, survive, and team up with friends to take down bosses, collect loot, and customize your look. Controls so simple, anyone can dive in instantly - no VR experience required. Season 1 - Pirates is live now - level up for exclusive rewards!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://apps.ezone.com/privacy-statement/", "developer_terms_of_service_url": null, "publisher_name": "Ezone PTY LTD", "support_website_url": "https://sharks.ezone.com/discord", "website_url": "https://ezone.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1990104051447093"}, {"id": "1023770785722696"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER", "CO_OP"], "id": "37966431552943809"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/593822060_1015675748030642_8450267045033883019_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b-kcWNDs7VsQ7kNvwGGWwio&_nc_oc=Adqn8mysX_KKJu6ren1HGAq-v9rs45B6EWqX-DNqBryQp4Cp67fGwXRH8-xIvca0B00&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLTVOW7FwKbRgER4-NM6qWjh7-LZXwANZj0QY9XVmffsg&oe=6ABE80E8"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "SHARKS", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Action", "id": "459781504968480"}, {"topic_name": "Sandbox", "id": "1990104051447093"}, {"topic_name": "Hangout", "id": "1023770785722696"}, {"topic_name": "Platformer", "id": "528142316460358"}], "release_date": 1720481711, "lastRevision": {"nodes": [{"id": "9571468226200188", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"def
t=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT1jmTyuCGmiDXQMoz73BBQj2x3m8QtlbYsZmyLr9H-LQ&oe=6AEF3F0C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TrailerCover_2560_1440.png", "id": "1777988152563190", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38984439_1777988155896523_7473550058146359760_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1g4iumt_MJ4Q7kNvwHpg1UP&_nc_oc=Adr0wVildh0aI1B7wlkPoIpImudGzqAusDPIuDClF4DCQ2P3Vw3-oLd_Zy_G6O6zRsQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTkI4ZOvl05GRrrCLDDj-Z1902kclRYggwce6x8cRVyNQ&oe=6AEF5AE6"}, "display_name": "NJP Virtual Club", "keywords": [], "long_description": "This app enables you to enjoy the performance of the New Japan Philharmonic and even play and practice with them!\nIn a collaboration with the Yamaha corporation\u2019s 3D sound technology called Sound xR and Crescent, Inc\u2019s Volumetrix technology, more immersive music experiences have been made possible.\nIt gives you full control while viewing the performance, such as pausing, seeking, and changing the playback speed. In addition, you can view the player(s) up close from any viewpoint using the \u201cteleport feature\u201d.\n\nFurthermore, you can play the instrument yourself by replacing one of the philharmonic members or choose any performer to practice with one-on-one at a slower tempo. An experience with professionals like this could be inspiring and life-changing.\nNow, you could be a member of the New Japan Philharmonic!", "short_description": "This app enables you to enjoy the performance of the New Japan Philharmonic and even play and practice with them!\nYou can view the performers up close from any viewpoint.\nMoreover, you can substitute for a player to experience their point of view or practice the performance with one of them one-on-one.\nAn experience with professionals like this could be inspiring and life-changing.\nNow you could be a member of the New Japan Philharmonic!"}]}, "developer_name": "Crescent,inc.", "developer_privacy_policy_url": "https://www.crescentinc.co.jp/privacypolicy/njpvirtualclub", "developer_terms_of_service_url": null, "publisher_name": "New Japan Philharmonic", "support_website_url": null, "website_url": "https://www.njp.or.jp/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "2687655338230691"}, {"id": "726368587961803"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": ["EDUCATIONAL", "MUSIC"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ja"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "27838031999128544"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39001683_912907043204436_3759642337850114429_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OF5_cFSVotQQ7kNvwGSlB_L&_nc_oc=AdrY8Z01940yCBDtkrB6WLrLYc0S7rLjVez-NdT4SAFK5V3hSOV8JRvs3AlIj9V35Bk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTneeHUzIVz4rafAkTJLo2JmKpEvHJpiptnq_H3c2tnlA&oe=6AEF3646"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "NJP Virtual Club", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_name": "Events", "id": "2687655338230691"}, {"topic_name": "Travel & Exploration", "id": "726368587961803"}], "release_date": 1676646000, "lastRevision": {"nodes": [{"id": "8624751077549924", "release_type": "SCHEDULED", "administration_status": "APPROV
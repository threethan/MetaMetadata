oculuscdn.com&_nc_ss=7f20f&oh=00_AQRIXaztRFYp2DE0Gi6tbEFN0JM8dooYGADDh0HkGcxlQA&oe=6B09B8E6"}, "display_name": "NJP Virtual Club", "keywords": [], "long_description": "This app enables you to enjoy the performance of the New Japan Philharmonic and even play and practice with them!\nIn a collaboration with the Yamaha corporation\u2019s 3D sound technology called Sound xR and Crescent, Inc\u2019s Volumetrix technology, more immersive music experiences have been made possible.\nIt gives you full control while viewing the performance, such as pausing, seeking, and changing the playback speed. In addition, you can view the player(s) up close from any viewpoint using the \u201cteleport feature\u201d.\n\nFurthermore, you can play the instrument yourself by replacing one of the philharmonic members or choose any performer to practice with one-on-one at a slower tempo. An experience with professionals like this could be inspiring and life-changing.\nNow, you could be a member of the New Japan Philharmonic!", "short_description": "This app enables you to enjoy the performance of the New Japan Philharmonic and even play and practice with them!\nYou can view the performers up close from any viewpoint.\nMoreover, you can substitute for a player to experience their point of view or practice the performance with one of them one-on-one.\nAn experience with professionals like this could be inspiring and life-changing.\nNow you could be a member of the New Japan Philharmonic!"}]}, "developer_name": "Crescent,inc.", "developer_privacy_policy_url": "https://www.crescentinc.co.jp/privacy/application/njpvirtualclub/", "developer_terms_of_service_url": null, "publisher_name": "New Japan Philharmonic", "support_website_url": null, "website_url": "https://www.njp.or.jp/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "2687655338230691"}, {"id": "726368587961
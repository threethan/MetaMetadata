_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7-RfnpMEvqwQ7kNvwFm9Mch&_nc_oc=AdpZZduqohWHEzV2_WwH3D-vDrFANjKcC7BXcZXhhbxrpQd0avYNOV9y76gBjIVAG6c&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ78rZrzLqq_U9ssS3OG5LPmCxOxm73cjOmdkwzYAC4fQ&oe=6A9AC25B"}, {"file_name": "thumbnailpicture5.png", "id": "1833962993958746", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/491819281_1833963000625412_4955805957549076297_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zkg8zBchGLYQ7kNvwH53SZf&_nc_oc=AdqKc-9c5dLSAV-L3PfFXs7yG1c2Y8e6jUxPXBFnq8cGe5aDTRG0ZahfR3mNBNn0g4M&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIpldj6Vl1wfNmGZDLFD84xUQXjfZbMZ7padgaX7Wz5Qw&oe=6A9AE047"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "thumbnailpicture.png", "id": "1255543309475465", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499312376_1255543312808798_5834936415181365025_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2vKTzloS2KAQ7kNvwHuQswA&_nc_oc=Ado6Vrf27Z9iW5n1Aro3Jr3r1Gel017-9WpUNhYb78TzaRdoyTSa_pi9C0pEljkT4PQ&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJTY19Xbcu_RowpsWx8dpR_vZpNLW0ZcCPWeCCpf6iAoQ&oe=6A9AD935"}, "display_name": "Kargil", "keywords": ["fps", "shooter", "history", "india", "pakistan"], "long_description": "Kargil VR is an immersive tactical first-person shooter inspired by the events in mid 1999. Set in rugged Himalayan terrain, it shows the war between Pakistan and India from a neutral point of view. The game places you in the role of a soldier tasked with advancing through hostile environments, securing strategic locations, and completing critical objectives while facing determined enemy forces.\n\nPlayers navigate steep mountains, rocky ridges, and remote outposts while engaging enemy soldiers in realistic firefights. A variety of weapons are available, including rifles, machine guns, sniper rifles, grenades, and other military equipment. Combat requires careful movement, use of cover, and accurate shooting to overcome enemy patrols and fortified positions.\n\nThe battlefield is dynamic and challenging, with enemy AI capable of detecting threats, taking cover, and coordinating attacks. Missions may involve defending key positions, capturing strategic areas, or eliminating hostile units. Players must adapt their tactics depending on the situation, whether advancing cautiously through enemy territory or responding to sudden attacks.\n\nKargil VR also features vehicles and support elements that add to the scale of combat. Helicopters and transport vehicles may appear during missions, delivering reinforcements or changing the flow of battle. ", "short_description": "Kargil VR is a tactical military shooter inspired by the Kargil conflict. Players fight through rugged mountain terrain, completing missions against enemy forces using realistic weapons, vehicles, and strategic combat. The game features intense battles, AI soldiers, helicopters, and immersive VR gameplay that challenges players to survive, advance, and complete objectives in a high-altitude warzone."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sandigital.ca/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "SanDigital", "support_website_url": null, "website_url": "https://sandigital.ca/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "2710427532541308"}, {"id": "459781504968480"}, {"id": "644354873106712"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SIT
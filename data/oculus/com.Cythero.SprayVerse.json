s": ["spray", "SprayVerse", "painting", "simulator", "paint"], "long_description": "SprayVerse is a standalone VR spray painting training simulator for Meta Quest that helps learners practice professional coating techniques using realistic virtual HVLP and Airless spray systems across automotive, aircraft, construction, and furniture applications. \nBuilt for vocational schools, industrial training, and workforce development, SprayVerse provides instant feedback on distance, speed, angle, and overlap while allowing trainees to develop precision, consistency, and muscle memory in a safe, clean, and cost-efficient environment \u2014 without using paint, materials, or protective equipment.", "short_description": "SprayVerse is a standalone VR spray painting training simulator for Meta Quest that helps learners practice professional coating techniques using realistic virtual HVLP and Airless spray systems across automotive, aircraft, construction, and furniture applications. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://sprayverse.com/privacy-policy-lite/", "developer_terms_of_service_url": null, "publisher_name": "Cythero", "support_website_url": null, "website_url": "https://sprayverse.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "1063584910766706"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": ["SIMULATION", "EDUCATIONAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25690584673902165"}, "review_messages": []}]}, "co
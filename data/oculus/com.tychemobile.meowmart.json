{"data": {"node": {"__typename": "Application", "id": "35200805829564974", "organization": {"id": "1830956387432244", "viewer_permissions": [], "application_groupings": {"nodes": [{"viewer_has_update_access": false, "full_applications": {"nodes": [{"id": "2379965699197974"}]}, "id": "1811728063572888"}, {"viewer_has_update_access": false, "full_applications": {"nodes": [{"id": "35200805829564974"}]}, "id": "1297412989148846"}, {"viewer_has_update_access": false, "full_applications": {"nodes": [{"id": "25523002804039908"}]}, "id": "3082006961992228"}, {"viewer_has_update_access": false, "full_applications": {"nodes": [{"id": "9580359878750111"}]}, "id": "1328927771674342"}, {"viewer_has_update_access": false, "full_applications": {"nodes": [{"id": "24457921513858122"}]}, "id": "1321516996432753"}, {"viewer_has_update_access": false, "full_applications": {"nodes": [{"id": "9550340751751147"}]}, "id": "1496135628354973"}, {"viewer_has_update_access": false, "full_applications": {"nodes": [{"id": "8200396593371560"}]}, "id": "1207455633628075"}]}}, "firstRevision": {"nodes": [{"application": {"id": "35200805829564974", "release_date": 1779329880, "is_concept": false, "platform": "ANDROID_6DOF", "scheduled_offers": {"count": 3}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "38342951512017041"}, "id": "1621061785855709"}]}}, "binary": null, "live_binary": null, "created_date": 1785467645, "id": "37331948526450683", "is_initial_release": false, "name_with_fallback": "v13", "pdp_metadata_with_fallback": {"version": 9, "application": {"is_concept": false, "latest_released_pdp_metadata": {"id": "37331961303116072"}, "release_status": "RELEASED", "id": "35200805829564974"}, "id": "37331961303116072", "release_status": "RELEASED", "status": "APPROVED"}, "release_date": null, "administration_status": "APPROVED", "is_first": false, "release_status": "RELEASED", "release_type": "SCHEDULED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "35200805829564974", "is_first_party": false, "enables_in_app_ads": false, "is_concept": false, "platform": "ANDROID_6DOF"}, "iarc_cert": {"id": "2171631483776672"}, "iarc_email": null, "msrp": null, "translations": {"nodes": [{"images": {"nodes": []}, "id": "2406905513132618", "locale": "en_GB", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Cat Shop Simulator: Meow Mart", "keywords": ["cat", "simulator", "sandbox", "supermarket"], "long_description": "# \ud83d\ude3a Run a Cat Supermarket\n\nOpen the doors, fill the shelves, scan the items, and take the money. Work fast, work slowly, run a tidy little shop, or turn it into a busy cat-powered supermarket. It is your shop.\n\n{1521424309722459}\n\n# \ud83d\ude3a Breed Cats\n\nPut two cats together and see what kind of kitten you get. Keep the cute ones, sell the valuable ones, or try again for a rare coat. Your cat family is your business.\n\n{1387190239965520}\n\n# \ud83d\ude3a Collect Every Coat\n\nEvery cat colour has a place in your Tablet. Find a new coat, light it up, and keep going until the whole page is full.\n\n# \ud83d\ude3a Hire Cat Employees\n\nCats can work too. Put them in your shop and let them help you earn money. But cats will not work for free forever. If they get too tired, they may run away.\n\n{1583969783255020}\n\n# \ud83d\ude3a Scratch Lottery Tickets\n\nSell tickets to customers, or scratch them yourself. Play it safe and make steady money, or chase the lucky ticket that could make your day.\n\n{1058881959910653}\n\n# \ud83d\ude3a Keep Your Favourite Cats\n\nKeep your favourite cats in special Cat Zones. Let them walk around, rest, and stay nearby while you work. Sell the others, keep the best, or try to collect them all.\n\n# \ud83d\ude3a Expand Your Supermarket\n\nBuy more products, make your shop bigger, and upgrade it. Build a small cosy shop, a busy supermarket, or the biggest Meow Mart in town.\n\nJoin our Discord and become a Shareholder \u2014 vote on what we build next! https://discord.gg/at5QaPDjvg\n", "short_description": "Run your own cat supermarket in VR!\n\nStock shelves, scan items, serve customers, and expand your shop.\n\nBreed cats, collect rare coats, hire cat employees, scratch lottery tickets, and build Cat Zones for your favourites.\n\nBuild your shop your way and create the ultimate Meow Mart!\n\nJoin our Discord and vote on what we build next:  \nhttps://discord.gg/at5QaPDjvg"}, {"images": {"nodes": [{"file_name": "3000-900.png", "id": "4288481024773015", "image_type": "APP_IMG_HERO", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499622211_4288481028106348_1970273291515195638_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yNdSmcY6TBcQ7kNvwEyHIRR&_nc_oc=AdoUMMpgTly6P1mKQKByhR2BZXYlaZG1QoSWq-fJyhfE6TSKs-253PVRexLiedchJJY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOYkgOtEh15WBjNtgYYHZAkACk1bj_eJlLVJ6qscplnBg&oe=6ACF9A59"}, {"file_name": "93d2b8839f1ff6e9c6a07fe8b1bff777.png", "id": "1566283315080924", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499622325_1566283318414257_3776358726076129942_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2vYAWo8iy3sQ7kNvwFd1wdk&_nc_oc=Adp5iVY7ipw2q7t2hZOWOON8G6s47GyHgPkm6c7PUB9rigJLXOOxvMi3b6mpfanpzZ4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN17fJegZpVz-N6yeg6sP1EIeC7zIGMRl8FcCLB3TjDpw&oe=6ACF909D"}, {"file_name": "1008-1440.png", "id": "1561676635634983", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499620403_1561676638968316_8599118513238270820_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B4MrzCvKUPUQ7kNvwHJr8-l&_nc_oc=Adogvx6wfWIbUHW1oV8dH7XfNGsSHOA8XN-WOPtBUzB-nCnLbPiorSbUf1dsGqhnlsA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNXKMSa4PzdLJeEC9ttdYmYvUpCiL6dlYF22tXezOzp0w&oe=6ACF82F6"}, {"f
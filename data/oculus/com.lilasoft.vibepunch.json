55_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ev1Q-v9g4zUQ7kNvwE60t3V&_nc_oc=AdmERYRYrb18je5aRZr5RDzRd_f--VUrXZ14sHw-8BVw4-NKEMCLnd0czNx3ZzhrDLw&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afx1rK0iYZQaxep0-kvJ7ls-LxJc3TrXtBZ_O1uQ7ZGExA&oe=69B2B77B"}]}, "id": "1140695997437318", "locale": "en_US", "screenshots": [{"file_name": "VibePunch_03.png", "id": "1943823312776448", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75500287_1943823316109781_7485139644051551876_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SVoZWuvcJtMQ7kNvwHTzSWR&_nc_oc=Adk1oebi6u-wlypl6Ux9W6dbrnUgi78S5fzGomsj8wh_8DyK77dHc6VRPm0Oazmc7GI&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfyFKK-lri9DwFgTGRw6ikf1pFNHL3-6GXzSnd2xWoPyTQ&oe=69B2C06E"}, {"file_name": "VibePunch_04.png", "id": "555948333924701", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75334067_555948337258034_8548928236663570279_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=owtMdAt-wMUQ7kNvwGtISJA&_nc_oc=AdnuFjZnKSUvX0voUxbYdOXBehtwV2CF3iLEnflBrQFPL7ywDtuh16Mno4k0oFfItao&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfzTnrgpKBukXrhVY4SJTaJbLnYNQfVh-KIh4PUfTxJ2Gw&oe=69B29B98"}, {"file_name": "VibePunch_02.png", "id": "967870801861786", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75404386_967870805195119_3009111221503024353_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2Vu18pePJ00Q7kNvwF5bC8m&_nc_oc=AdmCZqa9ehFn6_9M0hb0E7EMIBIvKMU5o5NG38e8KVzjv4zvaTI_XZvs4beHKb2HFWE&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfwXgNy1UCt05fEnHEU-RGwNVBmEj2uOOiZvY__2S4zkDQ&oe=69B2CE87"}, {"file_name": "VibePunch_05.png", "id": "953488666668632", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75240106_953488670001965_104767152738729320_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yL8cPXcVJl4Q7kNvwE6jrgx&_nc_oc=AdmTtubVs5i0OZQ9rCQJo_kxK9KLS6XcsJW72BgRnNfWmQlRzxtSAPr6dRlRR19uA7I&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_Afwg2if06n5v_uj6zs-PsTlpdqg56zper5Sr88xJQoD_Ag&oe=69B2C410"}, {"file_name": "VibePunch_01.png", "id": "1105543607400248", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75196220_1105543610733581_7640318672113608906_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N1B5mB5g39gQ7kNvwH2TSL5&_nc_oc=Adk9-rXeAFIaeAQpE_8SHl_7bE1G0c9a30d3qQAYc500-zR5RotKo7bHiJyCWAVYM24&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfyOYw-Kc95PB4P9tD7dYFDkSKzOgPj7xhGvD8_y79uE1Q&oe=69B2BC78"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Image.png", "id": "1169569534594635", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75411997_1169569537927968_7487193943941261023_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hUUvVYazihIQ7kNvwGKBBgr&_nc_oc=AdnIZDf6EzgrW-5Sh1dSf1yZlRpxSgbPdtGpvKVYVEeHFZ0CWUPhf3_deV33aDyUQN0&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfzOZldWjq3w3X3Fon9l9oIz_9e55NYfBwB6aLySUfMGzQ&oe=69B2AB1E"}, "display_name": "Vibe Punch", "keywords": ["rhythm", "punch", "fitness", "music", "boxing"], "long_description": "Thank you for choosing Vibe Punch! \nThis is a VR rhythm punch game that combines music and combat. Travel through vibrant worlds, punch incoming bullets in time with the beat, and defeat enemies to conquer a realm built entirely of music.\n\nVibe Punch is already near completion, and our goal for this Early Access period is to refine the finer details. Your feedback will be tremendously helpful in optimizing gameplay, improving features, and fixing any remaining bugs so we can deliver an experience close to perfection at launch.\n\nFeatures Available in Early Access\n- Core Gameplay : A rhythmic action experience where you punch bullets in sync with the music to ricochet and eliminate enemies  \n- Variety of Levels : Stages that feature unique soundtracks and rhythmic challenges  \n- Immersive Visuals : Stunning environments and effects that react to the beat  \n- Refined Game Mechanics : Balanced technical elements for a highly satisfying experience  \n- Regular Updates : Ongoing patches for performance optimization, gameplay improvements, and bug fixes  \n- Discounted Price : As a thank-you for joining Early Access, Vibe Punch is available at a discounted rate  \n\nWhat to Expect at Full Release\n- Expanded Track Lis t: Brand-new soundtracks to keep the experience fresh  \n- Enhanced Gameplay Features : Upgraded mechanics for an even more polished and engaging experience  \n- Improved Polish : Optimizations and refinements based on Early Access feedback  \n\nThank you for being part of this journey. ", "short_description": "Welcome to Vibe Punch, a thrilling VR rhythm-punch game where music meets precision combat! Step into a vibrant world where your punches sync perfectly with the beat, creating an electrifying gameplay experience that tests your rhythm, reflexes, and strategy."}, {"images": {"nodes": []}, "id": "622534220228353", "locale": "ko_KR", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Vibe Punch", "keywords": [], "long_description": "Vibe Punch\ub97c \uc120\ud0dd\ud574\uc8fc\uc154\uc11c \uac10\uc0ac\ud569\ub2c8\ub2e4! \uc774 \uac8c\uc784\uc740 \uc74c\uc545\uacfc \uc804\ud22c\uac00 \uacb0\ud569\ub41c \uc9dc\ub9bf\ud55c VR \ub9ac\ub4ec \ud380\uce58 \uac8c\uc784\uc785\ub2c8\ub2e4. \ub2e4\ucc44\ub85c\uc6b4 \uc138\uacc4\ub97c \ub204\ube44\uba70 \ubc15\uc790\uc640 \ub9ac\ub4ec\uc5d0 \ub9de\ucdb0 \ud380\uce58\ub97c \ub0a0\ub9ac\uace0, \ubc18\uc0ac \uc2e0\uacbd\uc744 \uc2dc\ud5d8\ud574 \ubcf4\uc138\uc694.\n\nVibe Punch\ub294 \uac70\uc758 \uc644\uc131\ub41c \uc0c1\ud0dc\uc774\uba70, \uc774\ubc88 \uc5bc\ub9ac \uc561\uc138\uc2a4 \uae30\uac04\uc744 \ud1b5\ud574 \uc138\ubd80 \uc694\uc18c\ub97c \ub354\uc6b1 \ub2e4\ub4ec\uace0\uc790 \ud569\ub2c8\ub2e4. \uc5ec\ub7ec\ubd84\uc758 \ud53c\ub4dc\ubc31\uc740 \uac8c\uc784\ud50c\ub808\uc774\ub97c \ucd5c\uc801\ud654\ud558\uace0, \uae30\ub2a5\uc744 \uac1c\uc120\ud558\uba70, \ub0a8\uc544 \uc788\ub294 \ubc84\uadf8\ub97c \ud574\uacb0\ud574 \uc815\uc2dd \ucd9c\uc2dc\uc5d0\uc11c \uc644\ubcbd\uc5d0 \uac00\uae4c\uc6b4 \uacbd\ud5d8\uc744 \uc81c\uacf5\ud558\ub294 \ub370 \ud070 \ub3c4\uc6c0\uc774 \ub420 \uac83\uc785\ub2c8\ub2e4.\n\n\uc5bc\ub9ac \uc561\uc138\uc2a4\uc5d0\uc11c \ub9cc\ub098\ubcfc \uc218 \uc788\ub294 \uac83\ub4e4\n\t\u2022\t\ud575\uc2ec \uac8c\uc784\ud50c\ub808\uc774 : \uc74c\uc545\uc5d0 \ub9de\ucdb0 \ub0a0\uc544\uc624\ub294 \ucd1d\uc54c\uc744 \ud380\uce58\ub85c \ub3c4\ud0c4\uc2dc\ucf1c \uc801\uc744 \uc81c\uac70\ud558\ub294 \ub9ac\ub4ec \uc561\uc158 \uacbd\ud5d8\n\t\u2022\t\ub2e4\uc591\ud55c \ub808\ubca8 : \ub3c5\ud2b9\ud55c \uc0ac\uc6b4\ub4dc \ud2b8\ub799\uacfc \ub9ac\ub4ec \ucc4c\ub9b0\uc9c0\ub97c \uac16\ucd98 \uc2a4\ud14c\uc774\uc9c0\n\t\u2022\t\ubab0\uc785\uac10 \ub118\uce58\ub294 \ube44\uc8fc\uc5bc : \ubc15\uc790\uc5d0 \ubc18\uc751\ud558\ub294 \uba4b\uc9c4 \ud658\uacbd\uacfc \uc774\ud399\ud2b8\n\t\u2022\t\uc815\uad50\ud55c \uac8c\uc784 \uba54\ucee4\ub2c8\uc998 : \ub9cc\uc871\ub3c4 \ub192\uc740 \ud50c\ub808\uc774\ub97c \uc704\ud55c \uade0\ud615 \uc7a1\ud78c \uae30\uc220 \uc694\uc18c\n\t\u2022\t\uc815\uae30\uc801 \uc5c5\ub370\uc774\ud2b8 : \uc131\ub2a5 \ucd5c\uc801\ud654, \uac8c\uc784\ud50c\ub808\uc774 \uac1c\uc120, \ubc84\uadf8 \uc218\uc815\uc744 \uc704\ud55c \uc9c0\uc18d\uc801\uc778 \ud328\uce58\n\t\u2022\t\ud560\uc778\ub41c \uac00\uaca9 : \uc5bc\ub9ac \uc561\uc138\uc2a4\uc5d0 \ucc38\uc5ec\ud574 \uc8fc\uc2dc\ub294 \uc5ec\ub7ec\ubd84\uaed8 \uac10\uc0ac\uc758 \uc758\ubbf8\ub85c, Vibe Punch\ub97c \ud560\uc778 \uac00\uaca9\uc73c\ub85c \uc81c\uacf5\ud569\ub2c8\ub2e4\n\n\uc815\uc2dd \ucd9c\uc2dc\uc5d0\uc11c \uae30\ub300\ud560 \uc810\n\t\u2022\t\ud655\uc7a5\ub41c \ud2b8\ub799 \ub9ac\uc2a4\ud2b8 : \uc2e0\uc120\ud568\uc744 \ub354\ud574 \uc904 \uc0c8\ub85c\uc6b4 \uc0ac\uc6b4\ub4dc\ud2b8\ub799\n\t\u2022\t\uac1c\uc120\ub41c \uac8c\uc784\ud50c\ub808\uc774 \uae30\ub2a5 : \ub354\uc6b1 \uc644\uc131\ub3c4 \ub192\uc740 \ud50c\ub808\uc774 \uacbd\ud5d8\uc744 \uc704\ud55c \uba54\ucee4\ub2c8\uc998 \uc5c5\uadf8\ub808\uc774\ub4dc\n\t\u2022\t\uac1c\uc120\ub41c \uc644\uc131\ub3c4 : \uc5bc\ub9ac \uc561\uc138\uc2a4 \ud53c\ub4dc\ubc31\uc744 \ubc18\uc601\ud574 \ucd5c\uc801\ud654\ub41c \uac8c\uc784\n\n\ud568\uaed8\ud574 \uc8fc\uc154\uc11c \uac10\uc0ac\ud569\ub2c8\ub2e4. \uc5ec\ub7ec\ubd84\uc758 \ud380\uce58\uac00 \ube44\ud2b8\ub97c \ub9cc\ub4e4\uace0, Vibe Punch\uc758 \ubbf8\ub798\ub97c \uacb0\uc815\ud560 \uac83\uc785\ub2c8\ub2e4!", "short_description": "Vibe Punch\uc5d0 \uc624\uc2e0 \uac83\uc744 \ud658\uc601\ud569\ub2c8\ub2e4. \uc74c\uc545\uacfc \uc804\ud22c\uac00 \uacb0\ud569\ub41c \uc2a4\ub9b4 \ub118\uce58\ub294 VR \ub9ac\ub4ec \ud380\uce58 \uac8c\uc784\uc785\ub2c8\ub2e4! \ud380\uce58\uac00 \ube44\ud2b8\uc640 \uc644\ubcbd\ud558\uac8c \ub3d9\uae30\ud654\ub418\ub294 \ud65c\uae30\ucc2c \uc138\uacc4\ub85c \ub4e4\uc5b4\uac00 \ub9ac\ub4ec, \ubc18\uc0ac \uc2e0\uacbd, \uc804\ub7b5\uc744 \uc2dc\ud5d8\ud558\ub294 \uac8c\uc784 \ud50c\ub808\uc774 \uacbd\ud5d8\uc744 \ub9cc\ub4e4\uc5b4 \ubcf4\uc138\uc694."}]}, "developer_name": null, "developer_privacy_policy_url": "https://vibepunch.com/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "LILASOFT", "support_website_url": null, "website_url": "https://vibepunch.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1672577396871977"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING"], "supported_tracking_modes": [], "user_inte
c_ht=scontent-hkg4-1.oculuscdn.com&oh=00_Afs25fMEyPzRuSiAerf0tnhhhSrigF1hM8ElHs0uKFB9TQ&oe=69A1889D"}, {"file_name": "migrated_image.png", "id": "883707535411417", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/12427636_434094226993882_2839419423599624192_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4sPbztceA94Q7kNvwFaqD7d&_nc_oc=Adl74sBDXm7tUFFjzjdXwL27cNrcSrBlRR2nQn1GIhfbTLHmSBiUwCEQ9LllWdhQ7_4&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&oh=00_AftNT_mocTAcTOA3T1IZs9ykwLSBRbe1W4Fe93jbhhBNIQ&oe=69A1A11B"}, {"file_name": "migrated_image.png", "id": "226254365164108", "uri": "https://scontent-hkg4-2.oculuscdn.com/v/t64.5771-25/12427537_133617190661829_8151054789082349568_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8oYlp4Xcj4gQ7kNvwGxfawR&_nc_oc=AdnE4DWpGxDfNIbmR1h2w8cRZZmAKByGj1psHdjsFVuLoM9SVVTS1MDThPLHkLLltnw&_nc_zt=3&_nc_ht=scontent-hkg4-2.oculuscdn.com&oh=00_AftpcNCW13y_MEDuaTnOOxK95LPPKvV7aUmd_NvqpYU5Jw&oe=69A18CBF"}, {"file_name": "migrated_image.png", "id": "624835518297809", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/11162763_1974970069442238_2892469021393813504_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I9NM2k5m0mAQ7kNvwEbQjrh&_nc_oc=Adl4d--qaeOY3FggeBfeqe-DLdbzBtzDWoxgvEhmIWaX6xeWLdGCOuvmHrr661MdEU4&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&oh=00_AfvsZdU97QlgcJOaPQsNsqQQI9hyerLqGUpQp67IT8Akeg&oe=69A17581"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "UNSW 360 VR Campus Tour", "keywords": ["Sydney", "University", "Australia", "Campus", "Education"], "long_description": "Welcome to UNSW Sydney in 360!\n\nExplore our beautiful campus and see your future at UNSW. \n\nCheck out your future campus and Sydney Harbour before you arrive. Meet some of our friendly students as they take you on a guided tour, and get access to information about our world-class Faculties, research labs, library and modern facilities. \n\nChoose your own way of exploring our campuses and Sydney Harbour in 360. Take the guided tour or jump to your favourite locations using the scene finder.\n\nTake the guided route starting with our famous University Mall. At the beginning of each location, one of our students will give you an introduction. Click on the icons to watch videos, find out more about our Faculties, read about buildings and who is inside. When you\u2019re ready to move on, click \u2018Next\u2019 to go to the next location. \n\nImagining yourself at UNSW has never been easier. Let\u2019s go!", "short_description": "Explore our beautiful campus in VR and see your future at UNSW."}]}, "developer_name": "Paper Moose", "developer_privacy_policy_url": "https://www.unsw.edu.au/privacy", "developer_terms_of_service_url": "http://www.international.unsw.edu.au/terms-and-conditions", "publisher_name": "UNSW Sydney", "support_website_url": null, "website_url": "http://www.360tour.unsw.edu.au/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["EDUCATIONAL", "CASUAL", "EXPLORATION", "SOCIAL", "UTILITY"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GEAR_VR_CONTROLLER", "TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "424106079502759"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/11162753_194082614474837_6397463592525889536_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d-wOPyVLmpgQ7kNvwEgDxNE&_nc_oc=AdmPq89bTAsbdHSfoyF_i0WiWjft2518MDsiP1Esvyn9rMcOMNjsPbH6Pt3j9S9y564&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&oh=00_AfseMgINSNuG559PhHhMoerM3NjEvwBwNVsdFkl2g3Q3EA&oe=69A175F9"}, "is_concept": fa
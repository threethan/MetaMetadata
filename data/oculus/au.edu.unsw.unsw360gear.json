h-1NkQ7kNvwHtKgb5&_nc_oc=AdqpgszbmS8FdAHrenfdEiPJG8O1h89dc8E23xGXE3KZDMAW4TFh-vj6ANLvkJ2qlBg&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7T4iVdX9tfFWw58tKHUUcl_q2VQNbzNw0P4Ly0p0XplA&oe=6A14735D"}, {"file_name": "migrated_image.png", "id": "883707535411417", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12427636_434094226993882_2839419423599624192_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NJA7iXSG5SEQ7kNvwE1TQqk&_nc_oc=AdoYsM5XFcsAFzr9l7xfYYBLqYTDAWZ97y1xWnkQHsNilM6qbAVy_cqT1tGOxK2kVJA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4W0xhLzEO5XOPxbUFffsPw2GSWYQ5vJbozn6bs9-3TgA&oe=6A14539B"}, {"file_name": "migrated_image.png", "id": "226254365164108", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12427537_133617190661829_8151054789082349568_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wkzyd4GzHSgQ7kNvwG8eceY&_nc_oc=Adqs26S7eOIdEy0bN9o0gpG8GaDYgqq7HDillQURksOBR8duaG2b0sIPohT6hcDPolI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4ARpgDgSfEMoqv0jBi1XI0jnfVKFVx3dT-lRfFp48xoQ&oe=6A143F3F"}, {"file_name": "migrated_image.png", "id": "624835518297809", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/11162763_1974970069442238_2892469021393813504_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PaIzvtZdox0Q7kNvwH5knpg&_nc_oc=AdotbshrbYfdomuPAdZoT8-9Z26jQRJ5YY9GL22zBse35HKm18bP9_7t00RcQMhDNUY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4YaO9C6KZDRwOg1Y0OScCUFcaXDgXZbVYZRuS7PB2B0Q&oe=6A146041"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "UNSW 360 VR Campus Tour", "keywords": ["Sydney", "University", "Australia", "Campus", "Education"], "long_description": "Welcome to UNSW Sydney in 360!\n\nExplore our beautiful campus and see your future at UNSW. \n\nCheck out your future campus and Sydney Harbour before you arrive. Meet some of our friendly students as they take you on a guided tour, and get access to information about our world-class Faculties, research labs, library and modern facilities. \n\nChoose your own way of exploring our campuses and Sydney Harbour in 360. Take the guided tour or jump to your favourite locations using the scene finder.\n\nTake the guided route starting with our famous University Mall. At the beginning of each location, one of our students will give you an introduction. Click on the icons to watch videos, find out more about our Faculties, read about buildings and who is inside. When you\u2019re ready to move on, click \u2018Next\u2019 to go to the next location. \n\nImagining yourself at UNSW has never been easier. Let\u2019s go!", "short_description": "Explore our beautiful campus in VR and see your future at UNSW."}]}, "developer_name": "Paper Moose", "developer_privacy_policy_url": "https://www.unsw.edu.au/privacy", "developer_terms_of_service_url": "http://www.international.unsw.edu.au/terms-and-conditions", "publisher_name": "UNSW Sydney", "support_website_url": null, "website_url": "http://www.360tour.unsw.edu.au/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["EDUCATIONAL", "CASUAL", "EXPLORATION", "SOCIAL", "UTILITY"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GEAR_VR_CONTROLLER", "TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "424106079502759"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/11162753_194082614474837_6397463592525889536_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L9It_kBzOTsQ7kNvwFwrKYv&_nc_oc=Adr7TgOtstVBA2EJ0u5Z8uxL-DSYumz1a5EhgJhv4e
1ciucQ7kNvwGZpnwe&_nc_oc=AdpllfqVys-HtABZMQNtTxtsK6rRN3X28calrwFZgPlTWw-zri3q3jgFuua4Y3AUyfk&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxR8SSEzLkp3iOp3DGaK7dBHRnCeH2awIpcIs0mZLlFOg&oe=69C6729D"}, {"file_name": "migrated_image.png", "id": "883707535411417", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/12427636_434094226993882_2839419423599624192_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d9wToi_r-GwQ7kNvwE4LHqY&_nc_oc=AdqPsBzDujv9JvBXcyy2niSl0Svu_d2GqQ5nXxciFBo4u6xZ6qZPRnUqQ5Kz31yKKHY&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwIYMSWt0e5sWmC-5RkxAoKBi6DaVB5IQwMX24E0FdE_w&oe=69C68B1B"}, {"file_name": "migrated_image.png", "id": "226254365164108", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/12427537_133617190661829_8151054789082349568_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k353199oMZoQ7kNvwFsqcBD&_nc_oc=Adpy4_OAjzWG2qlu8GSv3C2cFDeRxopFE_DlL6WJYzB20DZ47mJ88xBvgBwJ9ykb1ec&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Afxdr7uoHGwiLKpDbzGMeXWVJSiadEAtyIn-spj6Fm-Blw&oe=69C676BF"}, {"file_name": "migrated_image.png", "id": "624835518297809", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/11162763_1974970069442238_2892469021393813504_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=X6ufARtkXp0Q7kNvwFtd9j-&_nc_oc=AdoQBSMcgLom_QxgmlWulDiQhwfQOBeNgvJX4UGPpauPQf1xVzrKTbfZgI_tpISNtiY&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afz-79YDUND-7rpzMIkyEvRSclUmrpDzvkchTcqijQ3X9w&oe=69C697C1"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "UNSW 360 VR Campus Tour", "keywords": ["Sydney", "University", "Australia", "Campus", "Education"], "long_description": "Welcome to UNSW Sydney in 360!\n\nExplore our beautiful campus and see your future at UNSW. \n\nCheck out your future campus and Sydney Harbour before you arrive. Meet some of our friendly students as they take you on a guided tour, and get access to information about our world-class Faculties, research labs, library and modern facilities. \n\nChoose your own way of exploring our campuses and Sydney Harbour in 360. Take the guided tour or jump to your favourite locations using the scene finder.\n\nTake the guided route starting with our famous University Mall. At the beginning of each location, one of our students will give you an introduction. Click on the icons to watch videos, find out more about our Faculties, read about buildings and who is inside. When you\u2019re ready to move on, click \u2018Next\u2019 to go to the next location. \n\nImagining yourself at UNSW has never been easier. Let\u2019s go!", "short_description": "Explore our beautiful campus in VR and see your future at UNSW."}]}, "developer_name": "Paper Moose", "developer_privacy_policy_url": "https://www.unsw.edu.au/privacy", "developer_terms_of_service_url": "http://www.international.unsw.edu.au/terms-and-conditions", "publisher_name": "UNSW Sydney", "support_website_url": null, "website_url": "http://www.360tour.unsw.edu.au/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["EDUCATIONAL", "CASUAL", "EXPLORATION", "SOCIAL", "UTILITY"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GEAR_VR_CONTROLLER", "TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "424106079502759"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/11162753_194082614474837_6397463592525889536_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QVL7uWMSpAoQ7kNvwFbC8q0&_nc_oc=Adoi5DjCLrN8js9GTO1hx1_YYnFyV0oCyo8wXXt-aM
gr69cQ7kNvwGap_eP&_nc_oc=AdpnabRon4tl-0zQhiTtoK7EMsX3nqEiJ95nPngusYBxshXVmJE3G_kTKk_gShwsgnQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG2NhAIkuTsWvDr2tMelvl7PRuQk8j60VzS9Qqi6L8UuQ&oe=6A89909D"}, {"file_name": "migrated_image.png", "id": "883707535411417", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/12427636_434094226993882_2839419423599624192_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q3vCa0IjsE4Q7kNvwG60nye&_nc_oc=AdrwPQrTang08mVvTi8UGjm84JLxIMFUaU3esItgcm9ECcIfCXvsvAwueUt3cwA0E-s&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFen_n3lhGqvNlZdwaIErTaFIfb2OwZZRVvvg71lYjE7g&oe=6A8970DB"}, {"file_name": "migrated_image.png", "id": "226254365164108", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/12427537_133617190661829_8151054789082349568_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FzLG3pVpodYQ7kNvwF_xM17&_nc_oc=AdrxRTYqLY3SzUYIulLg-B201xoZ32xeuK7q-BxO1X7orqA74lSCkYqK7fGBbOXxsCM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQElDl1Wh5fZPGWvGKqWaC-sWJuhmdctBiPeruZINvl3IQ&oe=6A8994BF"}, {"file_name": "migrated_image.png", "id": "624835518297809", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/11162763_1974970069442238_2892469021393813504_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_2H4mK8m-zIQ7kNvwFyP2pr&_nc_oc=AdrAWb5Y2J0ciUd7GRJPizx3kQXkaSKq0txfRX77292vhOEimJ4voRCTRy0ymxlkGpM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGocluYnVHzWp7JxlR9oYX6QwRpK6RkGnHQSGATMLZjFg&oe=6A897D81"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "UNSW 360 VR Campus Tour", "keywords": ["Sydney", "University", "Australia", "Campus", "Education"], "long_description": "Welcome to UNSW Sydney in 360!\n\nExplore our beautiful campus and see your future at UNSW. \n\nCheck out your future campus and Sydney Harbour before you arrive. Meet some of our friendly students as they take you on a guided tour, and get access to information about our world-class Faculties, research labs, library and modern facilities. \n\nChoose your own way of exploring our campuses and Sydney Harbour in 360. Take the guided tour or jump to your favourite locations using the scene finder.\n\nTake the guided route starting with our famous University Mall. At the beginning of each location, one of our students will give you an introduction. Click on the icons to watch videos, find out more about our Faculties, read about buildings and who is inside. When you\u2019re ready to move on, click \u2018Next\u2019 to go to the next location. \n\nImagining yourself at UNSW has never been easier. Let\u2019s go!", "short_description": "Explore our beautiful campus in VR and see your future at UNSW."}]}, "developer_name": "Paper Moose", "developer_privacy_policy_url": "https://www.unsw.edu.au/privacy", "developer_terms_of_service_url": "http://www.international.unsw.edu.au/terms-and-conditions", "publisher_name": "UNSW Sydney", "support_website_url": null, "website_url": "http://www.360tour.unsw.edu.au/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["EDUCATIONAL", "CASUAL", "EXPLORATION", "SOCIAL", "UTILITY"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GEAR_VR_CONTROLLER", "TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "424106079502759"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/11162753_194082614474837_6397463592525889536_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pE1x6Mnz0ZcQ7kNvwEpHvMe&_nc_oc=AdoTrBevvJosAtnsGLDS8JSVkYPqUU-u98neNFfSlH
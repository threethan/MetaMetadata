UWAN4Q7kNvwHcuN8t&_nc_oc=AdrSCFqScjOwNF2IY6GHbfX0XyZ8X9tikJttC2aPEHHd2w8iaYSqU1qf3J1w77XyS3k&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAlCNvr-tq1vca1Vy9DzoUzYyqYbzsetf6HUuOS7dBbNA&oe=6A492F5D"}, {"file_name": "migrated_image.png", "id": "883707535411417", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/12427636_434094226993882_2839419423599624192_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ilhgSFYAsnQQ7kNvwHGSn_H&_nc_oc=AdoaQsimqEQ6GhfJFyvT7iL2ctLsuLNbhg_YpB8NqIE-ag9H-a-As9JCHGWufBpnst0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCT01yZveQ25fqH6_4dp2PeUDsFoQAzQ7l-odKQ7UJ62A&oe=6A490F9B"}, {"file_name": "migrated_image.png", "id": "226254365164108", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/12427537_133617190661829_8151054789082349568_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4NLuBi8zgH8Q7kNvwHs-Fnb&_nc_oc=AdqJRB0t96_sibezdwKC_xq6SS1x5cfKKndMotX7QZJQ6YxtRZNKYsnHo1AYTj0C0UA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAbUShjYwyKSzZcNkFNTjFAYMesF_U9dmIXZqak8GZcJQ&oe=6A49337F"}, {"file_name": "migrated_image.png", "id": "624835518297809", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/11162763_1974970069442238_2892469021393813504_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oVgNFuvwMn4Q7kNvwEfjX9O&_nc_oc=AdrJqrsr0TYgQUC3bU4SDh_pfEQy4eKxzHQuuzpp-CBY-FmfWqCjqcZL9U54FrwYV-Y&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQADgQYLuI04el6pNLUqoWMpIRrp6FyPF_ObXMeF5QBxKA&oe=6A491C41"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "UNSW 360 VR Campus Tour", "keywords": ["Sydney", "University", "Australia", "Campus", "Education"], "long_description": "Welcome to UNSW Sydney in 360!\n\nExplore our beautiful campus and see your future at UNSW. \n\nCheck out your future campus and Sydney Harbour before you arrive. Meet some of our friendly students as they take you on a guided tour, and get access to information about our world-class Faculties, research labs, library and modern facilities. \n\nChoose your own way of exploring our campuses and Sydney Harbour in 360. Take the guided tour or jump to your favourite locations using the scene finder.\n\nTake the guided route starting with our famous University Mall. At the beginning of each location, one of our students will give you an introduction. Click on the icons to watch videos, find out more about our Faculties, read about buildings and who is inside. When you\u2019re ready to move on, click \u2018Next\u2019 to go to the next location. \n\nImagining yourself at UNSW has never been easier. Let\u2019s go!", "short_description": "Explore our beautiful campus in VR and see your future at UNSW."}]}, "developer_name": "Paper Moose", "developer_privacy_policy_url": "https://www.unsw.edu.au/privacy", "developer_terms_of_service_url": "http://www.international.unsw.edu.au/terms-and-conditions", "publisher_name": "UNSW Sydney", "support_website_url": null, "website_url": "http://www.360tour.unsw.edu.au/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["EDUCATIONAL", "CASUAL", "EXPLORATION", "SOCIAL", "UTILITY"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GEAR_VR_CONTROLLER", "TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "424106079502759"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/11162753_194082614474837_6397463592525889536_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=maaVvly7AnsQ7kNvwENEcts&_nc_oc=AdqwnOu3DFmZz5dlynBiARG9hNb40c6aZupx07v6oS
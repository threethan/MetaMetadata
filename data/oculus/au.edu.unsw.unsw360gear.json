J3jp4Q7kNvwHsX2iY&_nc_oc=AdqjJ9dUQdHu2Z1xVsBpJe6As6-u4KXFo6lot-ubZpmtAgKCqpPpaz71G1vTkuVJMNM&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5SVe47QqbPTfL1eosO4ScBPB2yscn-6vmgqpOF3qNZAA&oe=6A0EF51D"}, {"file_name": "migrated_image.png", "id": "883707535411417", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/12427636_434094226993882_2839419423599624192_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=stzNUNMhNq8Q7kNvwGGpfhG&_nc_oc=AdrNLGz_WXV6zKfLYirYwoDIUQOfxRONHMGjWJzkt5tazmzajNfNsvcVkDHOvYR7C-E&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6pD5_rVncCrHtLdAS1iV_ByCeJkJBIfAxvQkUW5U41Ow&oe=6A0F0D9B"}, {"file_name": "migrated_image.png", "id": "226254365164108", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/12427537_133617190661829_8151054789082349568_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZV7u5I7jMpkQ7kNvwGkVGcR&_nc_oc=Adq4wRO_9ltuWYkesZ86cqy21pK72Ia54D4cVKCc81dx3JGNty061M8VtShaMf02FXg&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4kH0dK9JgvqCSFZZoo9ySnIGLpmeyzmFo_G3d4WBzXuw&oe=6A0EF93F"}, {"file_name": "migrated_image.png", "id": "624835518297809", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/11162763_1974970069442238_2892469021393813504_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fa-Ms2_GoYQQ7kNvwGv4RJt&_nc_oc=AdotoCetmwN9xEnubZZ8rv9yPFGVyU6mTEZFRDKLwe9u4NSt9PxesAMzTR03yKuE7Mo&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af79KM4aDHx7_HEDRlfkMMw9DSVwmKojh7foSwTEw1a77A&oe=6A0F1A41"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "UNSW 360 VR Campus Tour", "keywords": ["Sydney", "University", "Australia", "Campus", "Education"], "long_description": "Welcome to UNSW Sydney in 360!\n\nExplore our beautiful campus and see your future at UNSW. \n\nCheck out your future campus and Sydney Harbour before you arrive. Meet some of our friendly students as they take you on a guided tour, and get access to information about our world-class Faculties, research labs, library and modern facilities. \n\nChoose your own way of exploring our campuses and Sydney Harbour in 360. Take the guided tour or jump to your favourite locations using the scene finder.\n\nTake the guided route starting with our famous University Mall. At the beginning of each location, one of our students will give you an introduction. Click on the icons to watch videos, find out more about our Faculties, read about buildings and who is inside. When you\u2019re ready to move on, click \u2018Next\u2019 to go to the next location. \n\nImagining yourself at UNSW has never been easier. Let\u2019s go!", "short_description": "Explore our beautiful campus in VR and see your future at UNSW."}]}, "developer_name": "Paper Moose", "developer_privacy_policy_url": "https://www.unsw.edu.au/privacy", "developer_terms_of_service_url": "http://www.international.unsw.edu.au/terms-and-conditions", "publisher_name": "UNSW Sydney", "support_website_url": null, "website_url": "http://www.360tour.unsw.edu.au/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["EDUCATIONAL", "CASUAL", "EXPLORATION", "SOCIAL", "UTILITY"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GEAR_VR_CONTROLLER", "TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "424106079502759"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/11162753_194082614474837_6397463592525889536_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fW4s_DoDy_wQ7kNvwEMnycN&_nc_oc=AdpU_EY3qulGNa2q1FgXUJ2AW41tBbMujQHvPW4znI
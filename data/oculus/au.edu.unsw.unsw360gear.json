wT8jsQ7kNvwFkRAwo&_nc_oc=AdoJghHtWdbWlTyUvzJTiTkrTNC1sQ5h8dxgGSvViZEybQy_ZKioeKIC4zEEhyqFelo&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_anZpbta8hyl3iLDT2TaAhBRpsZ3P2a-2BTnVLFWGy2A&oe=6A24455D"}, {"file_name": "migrated_image.png", "id": "883707535411417", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/12427636_434094226993882_2839419423599624192_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5ETctdeuDi0Q7kNvwHrnNsl&_nc_oc=Adp4vZmWKR8YlWFEdugnTL0pf-S6YUvI0KUgT2HcB1aDEParsmKXgqCOG-7jisgoG3E&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9E6bWQwcGtxbh6jWpDKjYO6w766cOPzzJTCSQCL5pgOQ&oe=6A24259B"}, {"file_name": "migrated_image.png", "id": "226254365164108", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/12427537_133617190661829_8151054789082349568_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1jGRwa0PCFYQ7kNvwE_FbkQ&_nc_oc=Adpah1m0J-oXZVIVEbeJayoRetKfHzIBPLZxQmqBy_qRk1B_7e-LIkJAL1ngp0aUizA&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8clxQD0E2HNUOpk2r54kFVSC14EVSv-SUzn4qo04A64A&oe=6A24497F"}, {"file_name": "migrated_image.png", "id": "624835518297809", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/11162763_1974970069442238_2892469021393813504_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iYX-2kTldc8Q7kNvwGvC_IJ&_nc_oc=AdqScMKDkjz1Qo_oNDNJZ8d4Gtq6ZzHTfsbJz4yJoLGVKAf3nghV0LWbK1M7zVDIoOQ&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-h9C_lCB3cujXTFlqXJL0O29hJ9mS5brnobsuK0lGy8g&oe=6A243241"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "UNSW 360 VR Campus Tour", "keywords": ["Sydney", "University", "Australia", "Campus", "Education"], "long_description": "Welcome to UNSW Sydney in 360!\n\nExplore our beautiful campus and see your future at UNSW. \n\nCheck out your future campus and Sydney Harbour before you arrive. Meet some of our friendly students as they take you on a guided tour, and get access to information about our world-class Faculties, research labs, library and modern facilities. \n\nChoose your own way of exploring our campuses and Sydney Harbour in 360. Take the guided tour or jump to your favourite locations using the scene finder.\n\nTake the guided route starting with our famous University Mall. At the beginning of each location, one of our students will give you an introduction. Click on the icons to watch videos, find out more about our Faculties, read about buildings and who is inside. When you\u2019re ready to move on, click \u2018Next\u2019 to go to the next location. \n\nImagining yourself at UNSW has never been easier. Let\u2019s go!", "short_description": "Explore our beautiful campus in VR and see your future at UNSW."}]}, "developer_name": "Paper Moose", "developer_privacy_policy_url": "https://www.unsw.edu.au/privacy", "developer_terms_of_service_url": "http://www.international.unsw.edu.au/terms-and-conditions", "publisher_name": "UNSW Sydney", "support_website_url": null, "website_url": "http://www.360tour.unsw.edu.au/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["EDUCATIONAL", "CASUAL", "EXPLORATION", "SOCIAL", "UTILITY"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GEAR_VR_CONTROLLER", "TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "424106079502759"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/11162753_194082614474837_6397463592525889536_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sK4461g38CEQ7kNvwFnrayI&_nc_oc=AdqvfFdDDh9NMf022LeltaJ_puieOWHC8mk002b8SE
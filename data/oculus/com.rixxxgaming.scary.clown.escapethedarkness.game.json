5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTm80HH3vNelNDRWKbOK6n2FmRligd6bULa_yPpqMbtng&oe=6AF34077"}, {"file_name": "3[1].png", "id": "422892127307593", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39031516_422892130640926_70455962769635654_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EaTR9_ITXVEQ7kNvwHD9VPo&_nc_oc=AdpT_tpq3KLl8iHYaaqap0_M3Xepje0ZmVYHKp3G4l4DbQgYWwwdog4Xk_59B2spdTU&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRdujh0M8csXcT9mUhMLEpjVIyuoJwW_2MH2GWnV1Xq-Q&oe=6AF34B58"}, {"file_name": "4[1].png", "id": "1067201671447450", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982638_1067201674780783_7479875955684202805_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bZHJukhRR7QQ7kNvwFAG78G&_nc_oc=AdpPxGbyQ6nk01vTlqfEWH9o5_w8Zb2XOxdX5EDqP246ArnVJ1ByF50aPcZWWMtJSo0&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTBujPOofuKB1GqVS1Gk1Z20GrEK_ghpb4g6Xi7nGopqQ&oe=6AF32CF2"}, {"file_name": "5[1].png", "id": "8499174570163840", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982492_8499174576830506_7405952033321179654_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YGPWQoKGTfsQ7kNvwE3Ctfw&_nc_oc=AdprY2Cmy_vvisG_puy_C2Ms1mEm34sB8VOsvk8L3zNSBk7txHo3PEtaJlBrXcIe5SY&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS13yxuTSMgN7uPSGn0z8jc1I7wJHmQLmyS03wKyhUCxw&oe=6AF33CE0"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Scary Clown: Escape The Darkness", "keywords": ["ScaryClown", "Adventure", "Escape", "Stealth", "Puzzlesolving"], "long_description": "Enter a chilling world in Scary Clown: Escape The Darkness, where terror lurks around every corner. In this heart-pounding adventure, you must navigate through eerie environments while evading a sinister clown that relentlessly hunts you down. Your objective is clear: find the hidden emoji in each level and touch it to escape, but be warned\u2014if the clown catches you, it\u2019s game over.\n\nAs you explore the shadowy realms, solve puzzles and overcome obstacles to uncover the location of the emoji. Each level is a race against time, filled with suspense and unexpected challenges that will keep you on the edge of your seat. Utilize stealth, strategy, and quick reflexes to outsmart the clown and make it to safety.\n\nWith increasing difficulty and a gripping atmosphere, Scary Clown: Escape The Darkness combines thrilling gameplay with immersive graphics and sound design. Can you conquer your fears and complete the challenge, or will the darkness consume you?\n\nFeatures:\n\nSpine-chilling gameplay that tests your stealth and agility\nDiverse, haunting environments filled with traps and puzzles\nUnique hidden emojis to discover in each level\nIntense encounters with a menacing clown that adapts to your strategies\nFace your fears and escape the darkness\u2014your survival depends on it!", "short_description": "In Scary Clown: Escape The Darkness, you must navigate eerie levels while evading a terrifying clown. Your mission is to find and touch hidden emojis to escape, but beware\u2014the clown is always on your trail! Use stealth and quick reflexes to solve puzzles and outsmart your pursuer. Will you conquer your fears and survive the darkness, or will the clown catch you before you can escape?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/rixxxstudio/meta-quest-privacy-policies", "developer_terms_of_service_url": null, "publisher_name": "RexxxStudio", "support_website_url": null, "website_url": "https://sites.google.com/view/rixxxstudio/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_gra
pfhzKdAO8hag&oe=6B0F0DA2"}, {"file_name": "2[1].png", "id": "575083811576230", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031315_575083821576229_6314258275161780114_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WoCJSmketzIQ7kNvwESmBRD&_nc_oc=Adpf9DbHHrvEuryG5DPagKGRIhu_H_C6PFNOx8TCd-kgqTPx280UEb-kc0_vnhtCRRI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQUifz8DZyAuOPkfIUrAfGoiZ0Hl99jvmVBMSO8gVym0FQ&oe=6B0EEFF7"}, {"file_name": "3[1].png", "id": "422892127307593", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031516_422892130640926_70455962769635654_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Qq29CZjWGLEQ7kNvwH6mjFr&_nc_oc=AdqOf4UoFs78uoU6K8qAt6vwnv0bj4ZaQ5GRk01DmK5DM1oruVVV9PTi8qyoEW1lmf8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQUqjpoj3HtqkPzmsLwUx1SyubqAEBGkhfFkIQ0jLfLd_w&oe=6B0EFAD8"}, {"file_name": "4[1].png", "id": "1067201671447450", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982638_1067201674780783_7479875955684202805_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sBtW1-d9VJMQ7kNvwFFyy5e&_nc_oc=AdrthTPM9IN6uktm-vk0zoPmAST__z3jt73NFfSlBDep4ZfNggn1ykcxsjTOJ4J9__o&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQUAkAY4qdvm_GyJ49I6MBD_z4LdypxpbFtO9pxWGdYTjg&oe=6B0F14B2"}, {"file_name": "5[1].png", "id": "8499174570163840", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982492_8499174576830506_7405952033321179654_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VYxrfQuw9GMQ7kNvwEJ827w&_nc_oc=Adox7RvWbyPFN7GPbkrFdoVn5rRNKOp6wfbojxso2cb3__Vdl4RnVo_2Bka8Ef_o8M4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQUmhpFbG2iXwbIuCJT1q1fuKNU-UDNRKUZRjcDiYSVITw&oe=6B0EEC60"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Scary Clown: Escape The Darkness", "keywords": ["ScaryClown", "Adventure", "Escape", "Stealth", "Puzzlesolving"], "long_description": "Enter a chilling world in Scary Clown: Escape The Darkness, where terror lurks around every corner. In this heart-pounding adventure, you must navigate through eerie environments while evading a sinister clown that relentlessly hunts you down. Your objective is clear: find the hidden emoji in each level and touch it to escape, but be warned\u2014if the clown catches you, it\u2019s game over.\n\nAs you explore the shadowy realms, solve puzzles and overcome obstacles to uncover the location of the emoji. Each level is a race against time, filled with suspense and unexpected challenges that will keep you on the edge of your seat. Utilize stealth, strategy, and quick reflexes to outsmart the clown and make it to safety.\n\nWith increasing difficulty and a gripping atmosphere, Scary Clown: Escape The Darkness combines thrilling gameplay with immersive graphics and sound design. Can you conquer your fears and complete the challenge, or will the darkness consume you?\n\nFeatures:\n\nSpine-chilling gameplay that tests your stealth and agility\nDiverse, haunting environments filled with traps and puzzles\nUnique hidden emojis to discover in each level\nIntense encounters with a menacing clown that adapts to your strategies\nFace your fears and escape the darkness\u2014your survival depends on it!", "short_description": "In Scary Clown: Escape The Darkness, you must navigate eerie levels while evading a terrifying clown. Your mission is to find and touch hidden emojis to escape, but beware\u2014the clown is always on your trail! Use stealth and quick reflexes to solve puzzles and outsmart your pursuer. Will you conquer your fears and survive the darkness, or will the clown catch you before you can escape?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/rixxxstudio/meta-quest-privacy-policies", "developer_terms_of_service_url": null, "publisher_name": "RexxxStudio", "
LVc9xoyq4rKA&oe=6AFF0362"}, {"file_name": "2[1].png", "id": "575083811576230", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/39031315_575083821576229_6314258275161780114_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LE3jPvbnybQQ7kNvwF7CS2l&_nc_oc=AdooACcNABTxUs21qwdnYDuoBsW2LjHhVZmkGpstyzvfT6WIh808al-P0oraz6juJnU&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSluvABYHMDyQDL0vIkpA31c14nn_xF1Fmppzr9cMxDEA&oe=6AFF1DF7"}, {"file_name": "3[1].png", "id": "422892127307593", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39031516_422892130640926_70455962769635654_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=onuOtUCjD_EQ7kNvwEgHMUC&_nc_oc=AdpgDi_BFgPU7P1JV2BSS_rYerX-AMw57EZPbyOlPiU9s1S_L513Cq-PikExKUow5oM&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRmgt01I3ZdZkmDr78pQdpm2209V2HJK3r_zeylUlJDgQ&oe=6AFF28D8"}, {"file_name": "4[1].png", "id": "1067201671447450", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982638_1067201674780783_7479875955684202805_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AdRsL6cGQdgQ7kNvwFrbvM8&_nc_oc=AdqvhJsXS45FPQB0iTB4lA80fxESGuYUhEiOBQ8cckVwzzSugDeS7xBUgvVC_cKKWjU&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTz1uOfANU9VXPeE_9IB7vR3SQMWqE_HPoLoq2-sav48Q&oe=6AFF0A72"}, {"file_name": "5[1].png", "id": "8499174570163840", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982492_8499174576830506_7405952033321179654_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EvMn0s0KV38Q7kNvwHDLyFC&_nc_oc=Ado13siNUl8mWeXE_FCZ4BQmbnAOoKx9Oq7am4VMuT2E9XiZ8eGPZI8PJ8efUUFiEAg&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQy_5VzNYMN4dzF_B7yB2lq7YHmRG-2fwPsysP7hwl-9A&oe=6AFF1A60"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Scary Clown: Escape The Darkness", "keywords": ["ScaryClown", "Adventure", "Escape", "Stealth", "Puzzlesolving"], "long_description": "Enter a chilling world in Scary Clown: Escape The Darkness, where terror lurks around every corner. In this heart-pounding adventure, you must navigate through eerie environments while evading a sinister clown that relentlessly hunts you down. Your objective is clear: find the hidden emoji in each level and touch it to escape, but be warned\u2014if the clown catches you, it\u2019s game over.\n\nAs you explore the shadowy realms, solve puzzles and overcome obstacles to uncover the location of the emoji. Each level is a race against time, filled with suspense and unexpected challenges that will keep you on the edge of your seat. Utilize stealth, strategy, and quick reflexes to outsmart the clown and make it to safety.\n\nWith increasing difficulty and a gripping atmosphere, Scary Clown: Escape The Darkness combines thrilling gameplay with immersive graphics and sound design. Can you conquer your fears and complete the challenge, or will the darkness consume you?\n\nFeatures:\n\nSpine-chilling gameplay that tests your stealth and agility\nDiverse, haunting environments filled with traps and puzzles\nUnique hidden emojis to discover in each level\nIntense encounters with a menacing clown that adapts to your strategies\nFace your fears and escape the darkness\u2014your survival depends on it!", "short_description": "In Scary Clown: Escape The Darkness, you must navigate eerie levels while evading a terrifying clown. Your mission is to find and touch hidden emojis to escape, but beware\u2014the clown is always on your trail! Use stealth and quick reflexes to solve puzzles and outsmart your pursuer. Will you conquer your fears and survive the darkness, or will the clown catch you before you can escape?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/rixxxstudio/meta-quest-privacy-policies", "developer_terms_of_service_url": null, "publisher_name": "RexxxStudio", "
0_AQLUTD3B1MfMhCw1eTj9MjM3GOy5QCPvEGlSZEoA3DY16A&oe=6AB14A32"}, {"file_name": "004.png", "id": "35640799768867169", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499619805_35640799808867165_2268687801729741004_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FLUCWW4wC5UQ7kNvwEcmRoS&_nc_oc=AdpqGFJZhG2Mgtb9fJadNtRMsSGghtQ-OiTW0ahO8W47ol937ZFM8vxdy53gzY2NtkA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJhowuDmxsUfWQWo1WrRIk_zQ1tcgGMA6YNPRadgVeB7A&oe=6AB15533"}, {"file_name": "003.png", "id": "1734917834187750", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499617729_1734917837521083_6863574746949580292_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=p8WFzkjmDswQ7kNvwEHovnM&_nc_oc=Adr78Mtux1tU90ia_IJs-DyCU_1yt0sdRYv2egirpQuSqsICZEIP-D796WRFi8JJcao&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI9enzMXCgjeUWkUCMllRdKdGn0EoFTB8UXMmnoCyfNOA&oe=6AB154EF"}, {"file_name": "001.png", "id": "2024374425127983", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/595117516_2024374428461316_3747183630669007981_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H_IjHFoE5EEQ7kNvwHPPzOc&_nc_oc=AdpqGgb2X_9-1GtQkpi0rhKNtl2DJjhmVD-iZ3SEzqJ_ePvL7CKmkFmdt2Ph0bhna4I&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLEHSmuLjCDeGKKU6GT7baUxOmHw1sZsQ5RFuM_GgdNiQ&oe=6AB1394B"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VIRNECT View 3", "keywords": ["virnect", "\ubc84\ub125\ud2b8", "view", "ar", "virnectview"], "long_description": "[App Introduction]\n\nMaximize work efficiency with VIRNECT View 3.\n\nEasily augment manuals on actual equipment to confirm equipment usage.\n\nCheck real-time field data and operate processes efficiently.\n\nShorten training time for new employees by utilizing realistic educational content.\n\n[Main Features]\n\nSpatial-based AR Content Visualization\nAllows for more accurate problem confirmation than paper manuals\n\nOffline Environment Support\nDownload AR content to your device for easy access even in offline environments.\n\nReal-time Data Monitoring\nConnects data information to content for direct on-site viewing.\n\nImmersive Content\nProvides a more immersive content experience through various animations and interaction functions.\n\n[Access Permission Guide]\n\nIf necessary access is not allowed, there may be restrictions on service usage.\n\n[Open Source License Guide]\n\nIn-App Information Notification\n\n[Customer Support Center]\n\nhttps://virnect.com/support/inquiry\n\n[Website]\n\nhttps://virnect.com/\n\nThis is an enterprise app. Please purchase licenses from the payment center (web) to use.", "short_description": "[App Introduction]\n\nMaximize work efficiency by using VIRNECT View 3.\n\nYou can easily check how to use the equipment by augmenting the manual on the actual equipment.\n\nSee real-time field data and operate the process efficiently.\n\nTraining time for new employees can be shortened by using realistic educational content."}]}, "developer_name": null, "developer_privacy_policy_url": "https://console.virnect.com/legal?type=policy", "developer_terms_of_service_url": "https://console.virnect.com/legal?type=terms", "publisher_name": "VIRNECT CO., LTD", "support_website_url": null, "website_url": "https://virnect.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "1043107547362485"}, {"id": "1063584910766706"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ko"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "s
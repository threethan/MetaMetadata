dn.com/v/t64.5771-25/75441573_1567478917064821_580724821568617504_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d1W9XL2CfgAQ7kNvwEOK20M&_nc_oc=AdqIGN-DUX8qz4eqjU42SjQAEpN0LN8Q0fRmtDVEXX9m8OGv-sFdxwstGVwtb4-aNHA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR1wYX5c9H1yZTyY1SqxLHlQoiJk8kF2_WtncWUzUU-3A&oe=6AFDD1AB"}, {"file_name": "image_046.png", "id": "747769876626777", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75375752_747769879960110_6297187586802056547_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=X1BzVrZ7o8MQ7kNvwENnhZa&_nc_oc=Adp0UCx5xRyW4Lzwbf2MLVjulGEf4xpXBK8GS9O9Et_rPE_OI6F4mz79O53WwVsfK4w&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ5465iNKKYaq88VtisfQ3vdLcr7zox8VejcC4rdOpAwg&oe=6AFDB20F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Yoga VR_Cover Art_Landscape.png", "id": "589530863037457", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974824_589530866370790_1844954420968506899_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bmiXg5A4YAIQ7kNvwGkeQ8k&_nc_oc=AdryjjUTDXY8UVFOZalFvt0sFz51p15f2j_4Vo2a7Oxft5mbXrlQpuRpAIu0708u9tY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSo2DrJkrTNtThUKj-theskpwlGl1IcIRIHW00AVRHbog&oe=6AFDCE85"}, "display_name": "Yoga VR", "keywords": [], "long_description": "Introducing the ultimate yoga experience, now available in virtual reality! Our Yoga VR app is the perfect way to experience the benefits of yoga from the comfort of your own home. Whether you're a seasoned yogi or just starting out, our app provides everything you need to practice yoga and achieve a more mindful, peaceful state of mind.\n\nWith our Yoga VR app, you'll be transported to a beautiful and serene forest environment, complete with calming sounds and music to help you relax and focus on your practice. You'll have access to a variety of different yoga poses, with clear and detailed instructions provided by a virtual instructor.\n\nOur app also features a voice guide, so you can easily follow along with each pose without having to constantly look at your device. This makes it easier to get into a flow state and really let go of any distractions or stressors in your life.\n\nOverall, our Yoga VR app is a must-have for anyone looking to improve their physical and mental well-being. It's the perfect way to escape from the hustle and bustle of daily life, and focus on what really matters - your health and happiness.", "short_description": "Introducing the ultimate yoga experience, now available in virtual reality! Our Yoga VR app is the perfect way to experience the benefits of yoga from the comfort of your own home. Whether you're a seasoned yogi or just starting out, our app provides everything you need to practice yoga and achieve a more mindful, peaceful state of mind."}]}, "developer_name": null, "developer_privacy_policy_url": "https://xr-sweat.webnode.page/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "XR Sweat", "support_website_url": null, "website_url": "https://xr-sweat.webnode.page/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8803985002976363"}}]}, "scheduled_offers": {"count": 5, "nodes": [{"status": "PUBLISHED", "id": "351943254028343"}, {"status": "PENDING", "id": "1550832009007658"}, {"status": "PUBLISHED", "id":
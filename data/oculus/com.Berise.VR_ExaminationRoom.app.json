ontentExample002.png", "id": "2145444816271749", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/499619680_2145444819605082_8877081772720449482_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sk0rLTIzEGkQ7kNvwEtJEqs&_nc_oc=Adr61JIaEV42AzI1o96KQ3U1x2-9jlqeuwk4z2cFMYtqzzpbWpoy0cslBMzjb3U_b0s&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR-HsLCBbrQxjiE5kcLYDGG87WJIJbIUL0EGRmAaasZYg&oe=6B08572B"}, {"file_name": "ContentExample003.png", "id": "1358160026067580", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/499618103_1358160029400913_1252630352078287998_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w6rLNynBmoMQ7kNvwGd4r2s&_nc_oc=AdpkHHLSIxrRUQy0jW0-Ci9rJ3tjeD-yjbUi_CeNy1G_1wymUMhxxUxakpk4nkRCD9U&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSyCs7jowYT9ecX7tVArWGeJ3h6tAGGgHALv20tC6LXag&oe=6B087319"}, {"file_name": "ContentExample004.png", "id": "1269959681645928", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499622211_1269959684979261_1690046850707839490_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N2gkOI7XbZ4Q7kNvwGJvMdy&_nc_oc=AdrqTeyKpFXJVFpH0L_9bEykbz0lUC0Xa8827IwXMNMnQlDpzZL0bTO6GPok7gfCY9U&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTXNdyM_4F_p3RDjUFTxWxpL8Ne_BkPu_IG8BBux_VBtA&oe=6B086F7A"}, {"file_name": "ContentExample005.png", "id": "1564438541511920", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/499618499_1564438544845253_1350396422978818704_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=seIDnTrowkQQ7kNvwHPQcAl&_nc_oc=AdpeT4rrQsAvCxAGF6Jt8VK0XERPUQGkErCm2AhE8ZIG1M9s2NSQ83sTymx03RSbh28&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRyjbMY4Rx2tB-GQ9FI-2McuICb495-lidJxTH9lo1C6Q&oe=6B085B68"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VR Doctor's Office", "keywords": ["DoctorSimulator", "MedicalTraining", "KidsVR", "CareerExperience", "EducationalGame"], "long_description": "**\u201c**VR Doctor's Office**\u201d is a gentle, child-friendly VR game that lets kids experience what it\u2019s like to be a doctor.**\n\nYou listen to the patient, perform simple examinations, and think about what might be causing the symptoms.\n\nNo medical knowledge needed!\n\nThe adorable trainee doctor **Chiyo Kannagi** guides players with voice navigation, so even first-timers can enjoy the experience with confidence.\n\nThe game features three carefully selected, easy-to-understand cases.\n\nWith a soft, non-scary visual style and clear step-by-step guidance, children can have fun exploring **what a doctor\u2019s job is really like.**\n\n**\u201cSo this is what doctors do!\u201d**\n\nA new, exciting medical VR experience designed just for kids.", "short_description": "**\u201cVR Doctor's Office\u201d lets children experience what it\u2019s like to be a doctor in a friendly, hands-on VR setting.**\n\nKids call in patients, ask simple questions, perform basic exams, and learn to think about diagnoses \u2014 all guided by an adorable trainee doctor.\n\nWith three beginner-friendly cases, even first-time users can enjoy discovering\n\n**\u201cThis is what doctors do!\u201d**"}]}, "developer_name": null, "developer_privacy_policy_url": "https://app.berise.co.jp/vr-shisatsushitsu/privacy/", "developer_terms_of_service_url": null, "publisher_name": "\u682a\u5f0f\u4f1a\u793e\u30d3\u30fc\u30e9\u30a4\u30ba", "support_website_url": null, "website_url": "https://berise.co.jp/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_g
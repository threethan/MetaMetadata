ontentExample002.png", "id": "2145444816271749", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499619680_2145444819605082_8877081772720449482_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sk0rLTIzEGkQ7kNvwFHeDIZ&_nc_oc=AdoDBhZe0R8vLny8L1hjjZUZnXcjP9af7ItBNYusNcpeY-jj5LMEUJFimxZ1aySiAeE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT2GiNojv6QG6H4ccb9HgJkHmUDP0ZDcLeO1dCW96xNug&oe=6B0705AB"}, {"file_name": "ContentExample003.png", "id": "1358160026067580", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499618103_1358160029400913_1252630352078287998_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w6rLNynBmoMQ7kNvwHl8auf&_nc_oc=AdqPTEkKWD7Yxuh_4Pg7HZgHsKH8UUlZpjqbtKIhnAH-3Lj9E7tm9Vg6CWGF-0vrn1o&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTp9nHiw4DmjzwknVW9O83RiqmNNHhaeM4odw_2KcSU0Q&oe=6B072199"}, {"file_name": "ContentExample004.png", "id": "1269959681645928", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499622211_1269959684979261_1690046850707839490_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N2gkOI7XbZ4Q7kNvwF14Rg8&_nc_oc=Adptm28d4RJHsgRiFIftaMyfQxQBodannciXKchSe_U4kGMkuEIQynZVd1i46Nw0JU8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR-nHuJFeOKWhgBjCvTTY6zO3uFp2P2u3Pgo0G1CAZCRw&oe=6B071DFA"}, {"file_name": "ContentExample005.png", "id": "1564438541511920", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499618499_1564438544845253_1350396422978818704_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=seIDnTrowkQQ7kNvwGnM62n&_nc_oc=Adooaw5PPEwre_nkot9lyeN1eyJTj0J8fhDWa7r5uo4gwTw_WqAp6FaH_dRrarTOA7M&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTHi3f2mcoFTZ1C-Z8DAYEbpeNMQIqwG7OmVr27X-6vgw&oe=6B0709E8"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VR Doctor's Office", "keywords": ["DoctorSimulator", "MedicalTraining", "KidsVR", "CareerExperience", "EducationalGame"], "long_description": "**\u201c**VR Doctor's Office**\u201d is a gentle, child-friendly VR game that lets kids experience what it\u2019s like to be a doctor.**\n\nYou listen to the patient, perform simple examinations, and think about what might be causing the symptoms.\n\nNo medical knowledge needed!\n\nThe adorable trainee doctor **Chiyo Kannagi** guides players with voice navigation, so even first-timers can enjoy the experience with confidence.\n\nThe game features three carefully selected, easy-to-understand cases.\n\nWith a soft, non-scary visual style and clear step-by-step guidance, children can have fun exploring **what a doctor\u2019s job is really like.**\n\n**\u201cSo this is what doctors do!\u201d**\n\nA new, exciting medical VR experience designed just for kids.", "short_description": "**\u201cVR Doctor's Office\u201d lets children experience what it\u2019s like to be a doctor in a friendly, hands-on VR setting.**\n\nKids call in patients, ask simple questions, perform basic exams, and learn to think about diagnoses \u2014 all guided by an adorable trainee doctor.\n\nWith three beginner-friendly cases, even first-time users can enjoy discovering\n\n**\u201cThis is what doctors do!\u201d**"}]}, "developer_name": null, "developer_privacy_policy_url": "https://app.berise.co.jp/vr-shisatsushitsu/privacy/", "developer_terms_of_service_url": null, "publisher_name": "\u682a\u5f0f\u4f1a\u793e\u30d3\u30fc\u30e9\u30a4\u30ba", "support_website_url": null, "website_url": "https://berise.co.jp/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_g
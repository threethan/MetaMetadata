ontentExample002.png", "id": "2145444816271749", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499619680_2145444819605082_8877081772720449482_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BonILHE05NYQ7kNvwHkNumz&_nc_oc=AdoLy_Gwa2zxdV2amaxiOYgw8Xa1J1BQ73Gw-UL30AeGfGX7J1gGD0YoMSeR2usA_rc&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRi3r9V-JNRypXVPnAfAkLeuFwRuxxvCp2SfY_F2INdHg&oe=6AFF1CAB"}, {"file_name": "ContentExample003.png", "id": "1358160026067580", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/499618103_1358160029400913_1252630352078287998_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h2KjGUSgSVAQ7kNvwEnj_be&_nc_oc=AdrmJVVytHNKRAd4YxCeh60po_WFzcx6jMDKCZPix_vT_TdqNEDdO6b6Nw5QE-TF-GA&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR480-sw5nG1Ighj1b_MPqjIaWOfpFDKt2ZtI1MVIfE2w&oe=6AFF0059"}, {"file_name": "ContentExample004.png", "id": "1269959681645928", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499622211_1269959684979261_1690046850707839490_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vjSonzXmam0Q7kNvwG_xAnX&_nc_oc=Adp7C7FTtvoIRT-XZ5u6QsQUV6AHD0ROyIXme1_QM1RB2MAWvceN5VvoxQCUZMLrr5o&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTAoXOqOWHi_lLXgu0G3TckZanBGzo_yQuzcOFb83pHpg&oe=6AFF34FA"}, {"file_name": "ContentExample005.png", "id": "1564438541511920", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499618499_1564438544845253_1350396422978818704_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KqAALPRZpH4Q7kNvwHpJozI&_nc_oc=AdrSzrzBiJTrzoph6K43flqaEVrZpEdSy1SfeiQ1eur60SY_0FmjpC775am12zeSjAs&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQagTaMH1GdpSqGxX2anmz07iU-B8rgf3ZCY96ZQSwqeA&oe=6AFF20E8"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VR Doctor's Office", "keywords": ["DoctorSimulator", "MedicalTraining", "KidsVR", "CareerExperience", "EducationalGame"], "long_description": "**\u201c**VR Doctor's Office**\u201d is a gentle, child-friendly VR game that lets kids experience what it\u2019s like to be a doctor.**\n\nYou listen to the patient, perform simple examinations, and think about what might be causing the symptoms.\n\nNo medical knowledge needed!\n\nThe adorable trainee doctor **Chiyo Kannagi** guides players with voice navigation, so even first-timers can enjoy the experience with confidence.\n\nThe game features three carefully selected, easy-to-understand cases.\n\nWith a soft, non-scary visual style and clear step-by-step guidance, children can have fun exploring **what a doctor\u2019s job is really like.**\n\n**\u201cSo this is what doctors do!\u201d**\n\nA new, exciting medical VR experience designed just for kids.", "short_description": "**\u201cVR Doctor's Office\u201d lets children experience what it\u2019s like to be a doctor in a friendly, hands-on VR setting.**\n\nKids call in patients, ask simple questions, perform basic exams, and learn to think about diagnoses \u2014 all guided by an adorable trainee doctor.\n\nWith three beginner-friendly cases, even first-time users can enjoy discovering\n\n**\u201cThis is what doctors do!\u201d**"}]}, "developer_name": null, "developer_privacy_policy_url": "https://app.berise.co.jp/vr-shisatsushitsu/privacy/", "developer_terms_of_service_url": null, "publisher_name": "\u682a\u5f0f\u4f1a\u793e\u30d3\u30fc\u30e9\u30a4\u30ba", "support_website_url": null, "website_url": "https://berise.co.jp/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_g
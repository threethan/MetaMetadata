, "id": "1358160026067580", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499618103_1358160029400913_1252630352078287998_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1m-5SZzpkecQ7kNvwF4fYje&_nc_oc=Adrz7KlmhbboicoTJE9Wv9CcGIDDL4Y0CBzV2W17tyOI4ckzBZ3LYD2Cq6tN7C4h2IE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPVYp8NhzL7tmRzGFTFy-kIDwPoGnjbkA2tT45z2M1JYw&oe=6AC109D9"}, {"file_name": "ContentExample004.png", "id": "1269959681645928", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499622211_1269959684979261_1690046850707839490_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pzpBTGoqXBYQ7kNvwEMWjFM&_nc_oc=AdqACUOKBwtpdeMBm_zPanB4gr2y-m4-e9Ote_x4ivYebIkDJTbGgSu0sDK5n7LuU7k&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMCBSFI4uz2dVBNoGmvnoXijhtehGqBXvqxoVX_O0azGw&oe=6AC1063A"}, {"file_name": "ContentExample005.png", "id": "1564438541511920", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499618499_1564438544845253_1350396422978818704_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g7w7dlFDDIQQ7kNvwFJxlwq&_nc_oc=Adr3-xz687D4T9lIyXfgAH3fHZ791DeZcUvipgBONxuwktYg0WlmNIy2ggWqax3HmpE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPP6SxnXr0ZRx7BlynP0HDLmlOfv5I0JhsgtKcNwvbLlQ&oe=6AC12A68"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VR Doctor's Office", "keywords": ["DoctorSimulator", "MedicalTraining", "KidsVR", "CareerExperience", "EducationalGame"], "long_description": "**\u201c**VR Doctor's Office**\u201d is a gentle, child-friendly VR game that lets kids experience what it\u2019s like to be a doctor.**\n\nYou listen to the patient, perform simple examinations, and think about what might be causing the symptoms.\n\nNo medical knowledge needed!\n\nThe adorable trainee doctor **Chiyo Kannagi** guides players with voice navigation, so even first-timers can enjoy the experience with confidence.\n\nThe game features three carefully selected, easy-to-understand cases.\n\nWith a soft, non-scary visual style and clear step-by-step guidance, children can have fun exploring **what a doctor\u2019s job is really like.**\n\n**\u201cSo this is what doctors do!\u201d**\n\nA new, exciting medical VR experience designed just for kids.", "short_description": "**\u201cVR Doctor's Office\u201d lets children experience what it\u2019s like to be a doctor in a friendly, hands-on VR setting.**\n\nKids call in patients, ask simple questions, perform basic exams, and learn to think about diagnoses \u2014 all guided by an adorable trainee doctor.\n\nWith three beginner-friendly cases, even first-time users can enjoy discovering\n\n**\u201cThis is what doctors do!\u201d**"}]}, "developer_name": null, "developer_privacy_policy_url": "https://app.berise.co.jp/vr-shisatsushitsu/privacy/", "developer_terms_of_service_url": null, "publisher_name": "\u682a\u5f0f\u4f1a\u793e\u30d3\u30fc\u30e9\u30a4\u30ba", "support_website_url": null, "website_url": "https://berise.co.jp/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["ja"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "34025903973721404"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499619704_1101311488799179_2554201751419444220_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N5Y8E1VZYwkQ7kNvwFHxAFf&_nc_oc=AdpJJXUHOrvmmGAK5OiuwtjDnAXS8pyGwVddKnO8QpBLqmnDE
, "id": "1358160026067580", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499618103_1358160029400913_1252630352078287998_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=48iR091aIywQ7kNvwFQVpEd&_nc_oc=AdpPK8ER8DFGTnoZiLG0swSeX0etDyUUXcV54Lyd2tu-fRKqS9p6k3cHt8f5egNMcuI&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO9qnf_x6r3xJyIoNBG8-8A2MUXjyB-vsHbv9WwADfQlQ&oe=6AC7A159"}, {"file_name": "ContentExample004.png", "id": "1269959681645928", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/499622211_1269959684979261_1690046850707839490_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_FOVpB3GxGIQ7kNvwHHzKFh&_nc_oc=Adp0Y-BiUUGPSHe1djPLcbZoIMsCs3cwKa5BvEZ6yiRBOhP6uwhMcXBzhqXPBGnKYVE&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPalhSCWgF2x9xQHp0Cv5h6DGZarsnlrXh_EmZI5faBUQ&oe=6AC79DBA"}, {"file_name": "ContentExample005.png", "id": "1564438541511920", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/499618499_1564438544845253_1350396422978818704_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I9DcMy5C2wIQ7kNvwGhmXOo&_nc_oc=AdqDP5sRrFf-vG_-mhjvB3WY_iAKtIjSS7UUnRiEpdm7LlpV0zhmUJYADHThKM6r5XQ&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO8fs8s0IKM_isnBAtYHBhnAkd2UVbniiog3o9fpC154Q&oe=6AC7C1E8"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VR Doctor's Office", "keywords": ["DoctorSimulator", "MedicalTraining", "KidsVR", "CareerExperience", "EducationalGame"], "long_description": "**\u201c**VR Doctor's Office**\u201d is a gentle, child-friendly VR game that lets kids experience what it\u2019s like to be a doctor.**\n\nYou listen to the patient, perform simple examinations, and think about what might be causing the symptoms.\n\nNo medical knowledge needed!\n\nThe adorable trainee doctor **Chiyo Kannagi** guides players with voice navigation, so even first-timers can enjoy the experience with confidence.\n\nThe game features three carefully selected, easy-to-understand cases.\n\nWith a soft, non-scary visual style and clear step-by-step guidance, children can have fun exploring **what a doctor\u2019s job is really like.**\n\n**\u201cSo this is what doctors do!\u201d**\n\nA new, exciting medical VR experience designed just for kids.", "short_description": "**\u201cVR Doctor's Office\u201d lets children experience what it\u2019s like to be a doctor in a friendly, hands-on VR setting.**\n\nKids call in patients, ask simple questions, perform basic exams, and learn to think about diagnoses \u2014 all guided by an adorable trainee doctor.\n\nWith three beginner-friendly cases, even first-time users can enjoy discovering\n\n**\u201cThis is what doctors do!\u201d**"}]}, "developer_name": null, "developer_privacy_policy_url": "https://app.berise.co.jp/vr-shisatsushitsu/privacy/", "developer_terms_of_service_url": null, "publisher_name": "\u682a\u5f0f\u4f1a\u793e\u30d3\u30fc\u30e9\u30a4\u30ba", "support_website_url": null, "website_url": "https://berise.co.jp/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["ja"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "34025903973721404"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499619704_1101311488799179_2554201751419444220_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4l6SLzMRRSQQ7kNvwG09kqb&_nc_oc=AdqCdwc8S3u5Tvj64B6Hi6Vz9yJOrCAxdxKyN-abNX3WvDDOp
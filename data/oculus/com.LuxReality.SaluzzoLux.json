.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMuyXrvDDdund4oH1p8507QwoZHI_h8NgADhUAlrzGRzg&oe=6AE337D7"}, {"file_name": "3.png", "id": "512466804779680", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39003257_512466808113013_6351033040798227813_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2JLMzAz8UxUQ7kNvwGUVs7A&_nc_oc=AdrDlk7tMTMKdZpj3tIdzUd4IR5O7jVLlbfAgGeEL9UqLaDC3PLOx9Ncsw8aRUY7ezc&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNBVtSF381ClX8HgBXj4GwruWOJRfhGKd8oeS0zKS5WMg&oe=6AE347E4"}, {"file_name": "4.png", "id": "1180293233170834", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/38982479_1180293236504167_7498359435697667637_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fRqKlxltvjkQ7kNvwFQRMa0&_nc_oc=AdoS--ghIYRVanslGmgnNoWoarHrjEdkSLpSMZeEsAD1NrNne64f1odzPNblPta48ns&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOVs8MlMHXVM_1Kpwb_fcm80yC6l0s6W41qd5IgZOw-zg&oe=6AE36ADF"}, {"file_name": "5.png", "id": "1224976911991676", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/75556799_1224976915325009_155574893629184821_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YXjTC3bqYa4Q7kNvwFWGuWw&_nc_oc=AdrOtTwGhFW4cLf-7RA4lUvh0oWJb6CALbNzm3VWaTCJjktd0CDlR0rwgaKj2rt_9Q8&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQONnAFLraccHh3uJ_nnZBSbT5JHTGVZ2pphXJaz__8b8A&oe=6AE339CE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "palazzoSaluzzo2560.png", "id": "466758309676767", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/75549081_466758319676766_1845746528565488640_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Vt4M67ugVoUQ7kNvwF2f3yW&_nc_oc=AdrHRP1qIqwLxfIvLMXOhFjs7Hte5ZylPIkdCSZwZe3Drd82XFJlx35MfwsSi_kMYlc&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMm_FxYGDG6t_PVw4HxnRIWU60SYyNr-6TcDKOUqLsB5A&oe=6AE35FC8"}, "display_name": "Palazzo Saluzzo di Paesana Torino Italy 1722", "keywords": [], "long_description": "Immerse yourself in the historical magnificence of Turin with the Meta Quest app that lets you explore Palazzo Saluzzo di Paesana like never before. Thanks to advanced photogrammetry, you can virtually visit every corner of this extraordinary noble palace, built between 1715 and 1722 by Gian Giacomo Plantery for the Marquis Baldassarre Saluzzo di Paesana. The app, currently in beta, offers a multiplayer mode that allows you to connect with friends and other history enthusiasts for a shared virtual visit. Experience the 18th-century atmosphere with realistic reconstructions that transport you back in time, letting you walk through the halls and apartments as if you were really there. Delve into the history of the palace and its transformations over the centuries, with details about its inhabitants and architectural developments. Don\u2019t miss the opportunity to experience this unique journey and deepen your knowledge of one of Italy\u2019s most important noble buildings. Download the app now and start your virtual journey through centuries of history and architecture!", "short_description": "Immerse yourself in the history of Turin with the Meta Quest app that lets you explore Palazzo Saluzzo di Paesana. Thanks to advanced photogrammetry, virtually visit every corner of this extraordinary 18th-century noble palace. The app, currently in beta, offers a multiplayer mode for shared visits. Experience the atmosphere of the past and discover the history of the palace. Download the app now and start your virtual journey through centuries of history and architecture!"}, {"images": {"nodes": []}, "id": "817258543891897", "locale": "it_IT", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Palazzo Saluzzo di Paesana Torino Italy 1722", "keywords": [], "long_description": "Immergiti nella magnificenza storica di Torino con l'app per Meta Quest che ti permette di esplorare Palazzo Saluzzo di Paesana come mai prima d'ora. Grazie alla fotogrammetria avanzata, puoi visitare virtualmente ogni angolo di questo straordinario palazzo nobiliare, costruito tra il 1715 e il 1722 da Gian Giacomo Plantery per il Marchese Baldassarre Saluzzo di Paesana. L'app, attualmente in beta, offre una modalit\u00e0 multiplayer che ti consente di connetterti con amici e altri appassionati di storia per una visita virtuale condivisa. Vivi l'atmosfera del XVIII secolo grazie a ricostruzioni realistiche che ti trasportano indietro nel tempo, permettendoti di camminare attraverso le sale e gli appartamenti come se fossi davvero l\u00ec. Approfondisci la storia del palazzo e delle sue trasformazioni nel corso dei secoli, con dettagli sui suoi abitanti e sulle sue vicende architettoniche. Non perdere l'opportunit\u00e0 di vivere questa esperienza unica e approfondire la storia di uno dei pi\u00f9 importanti edifici nobiliari d'Italia. Scarica l'app ora e inizia il tuo viaggio virtuale attraverso secoli di storia e architettura!", "short_description": "Immergiti nella storia di Torino con l'app per Meta Quest che ti permette di esplorare Palazzo Saluzzo di Paesana. Grazie alla fotogrammetria avanzata, visita virtualmente ogni angolo di questo straordinario palazzo nobiliare del XVIII secolo. L'app, in beta, offre una modalit\u00e0 multiplayer per visite condivise. Vivi l'atmosfera del passato e scopri la storia del palazzo. Scarica l'app ora e inizia il tuo viaggio virtuale attraverso secoli di storia e architettura!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.luxreality.it/privacy-policy-cookie-policy/", "developer_terms_of_service_url": null, "publisher_name": "Meta Quest Developer Hub", "support_website_url": null, "website_url": "https://www.luxreality.it/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": 
tps://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491824292_1585735939925324_7328621151823152301_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7cV8URPNRCQQ7kNvwFsirps&_nc_oc=Adrgv2dGNobGtDDJrsGSat5usrKy0TubfiKPCEnzMrn3i4D6Q3TE1YVy6-hkk_EkT9g&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af2knz7dDBkzBkGl1Z-v6kHLRC1khcEttJmMD1HUqYtc5w&oe=69F0D0FD"}, {"file_name": "Screenshot2FIX.png", "id": "1695130834789518", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491819281_1695130838122851_4323601325483762319_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=80qHtt0bxy0Q7kNvwG4lquu&_nc_oc=AdoRGeKrd8AU-HffIutRRYHKVVWxhVQE61AG_0fQcGGUBD-Thdp9XOmV_Irecezu53s&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af1_RGxEFHi8UFQbWhHq0H3MbnnQl7rqSwRerEkqSfZVpg&oe=69F0C779"}, {"file_name": "SCREENSHOT 1 (FIXED).png", "id": "3827332124242672", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491821178_3827332127576005_5076595765115755861_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GuvCJD-As-wQ7kNvwHNW0t8&_nc_oc=Adq0SFOikEX5tdzi1jhxCx0RrhaIWJupyNutm5JGpE1Apan9R0s5_wJ-2Hg4Pi0ZKJY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af2kMk8MEFEd-zS8FLVOCgXNRzaQSzxLVqSMbEvmmrDamQ&oe=69F0AA95"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "project rust", "keywords": ["taggers", "project", "rust", "SWINGING"], "long_description": "Welcome to Project Rust \u2014 a fast-paced VR movement experience built around physical arm-swing locomotion.\n\nMove through the world by swinging your arms naturally. No joystick movement \u2014 your body is your controller. Master your momentum, explore the environment, and push your movement skills to the limit.\n\nProject Rust focuses on:\n\n\u2022 Immersive arm-based locomotion\n\u2022 Physical movement mechanics\n\u2022 Skill-based traversal\n\u2022 Fast and fluid VR gameplay\n\nEvery movement is powered by you. The more you move, the faster you go.\n\nStep into Project Rust and experience lo
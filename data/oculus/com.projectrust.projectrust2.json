=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_Afx9oirEw1j0fJY_if8iqrhAxFpBdP6LDd_lhhpZWM2svQ&oe=69BE83F1"}, {"file_name": "Screenshot5FIX.png", "id": "1585735936591991", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491824292_1585735939925324_7328621151823152301_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uN30eNyR0nUQ7kNvwGHBeBA&_nc_oc=AdmX_WFEWwN7h2yLNeR6bgW6pYqK_eLxmH8lMW3qWMQ9m-Nx_MSC71kX_NCMFDBPL0M&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_Afx7TlfjPUwcc3eot6rrbEvJXcMu02cR6Xh2RLZZBGiImA&oe=69BE7FBD"}, {"file_name": "Screenshot2FIX.png", "id": "1695130834789518", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491819281_1695130838122851_4323601325483762319_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xZIs94tVVfoQ7kNvwFr9fWB&_nc_oc=Adm6hUqNyjEtfINX2jdzsj6RBlxvQMBcPqO0wFx5hwTwxyOuT9iRgB301gUg--Jk2JA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfwmbeeXNnDKwDsy53WeW1FU5wzqEQJooYleYoEJCx85ow&oe=69BE7639"}, {"file_name": "SCREENSHOT 1 (FIXED).png", "id": "3827332124242672", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491821178_3827332127576005_5076595765115755861_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zrTSiM1uxSoQ7kNvwGl1Gzn&_nc_oc=AdnhPJNeW6i0FlBioZ2zAyFVGbCZ0-ICT8QAbEHQL7xYffjjsQbs3ON4xoPUbeppcOQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfzkVATj0pEXJleUmPiVuROB6r-gZoTIVPsQjAalq4tZYQ&oe=69BE9195"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "project rust", "keywords": ["taggers", "project", "rust", "SWINGING"], "long_description": "Welcome to Project Rust \u2014 a fast-paced VR movement experience built around physical arm-swing locomotion.\n\nMove through the world by swinging your arms naturally. No joystick movement \u2014 your body is your controller. Master your momentum, explore the environment, and push your movement skills to the limit.\n\nProject Rust focuses on:\n\n\u2022 Immersive arm-based locomotion\n\u2022 Physical movement mechanics\n\u2022 Skill-based traversal\n\u2022 Fast and fluid VR gameplay\n\nEvery movement is powered by you. The more you move, the faster you go.\n\nStep into Project Rust and experience locomotion in a whole new way.", "short_description": "Fast paced arm swing locomotion survival experience where you move using your real arms. Explore, survive, and test your movement skills in Project Rust."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/project-rust/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "project rust", "support_website_url": null, "website_url": "https://sites.google.com/view/project-rust/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "26471728352413452"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "753622490838988"}]}, "baseline_offer": {"id": "753622490838988"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1771850520, "status": "PUBLISHED", "id": "753622490838988"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "26462119476707673", "version": "AsteroidsFangameTemplate"}, "id": "1614752446234210", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename"
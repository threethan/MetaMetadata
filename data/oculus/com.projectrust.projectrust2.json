e7a0a&_nc_ohc=ggPP4BulnfEQ7kNvwHLJQ-C&_nc_oc=Adpjxy7UT_GzsQvjxcYPT8PY_yzXbWZwvF8oeY29o-YtnMgmWV2BzI-CUC19MJ0aAw4&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB_cd_6oNqBMhk9Knvt_YE6auirHxwDBC_X9TG8GF1K7g&oe=6A60A83D"}, {"file_name": "Screenshot2FIX.png", "id": "1695130834789518", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491819281_1695130838122851_4323601325483762319_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_V01Oc6EX-MQ7kNvwE_oNF9&_nc_oc=AdqVBql1i5Uxr9p--S-KTuBe631Mm9YL4Qdzn79Yx77WSAoGpCeuV1CFKWzEryDmDhw&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB2T649hblvLKTMbABl5tyIhLcXwTCaw6BrPC8SMTd2ng&oe=6A60D6F9"}, {"file_name": "SCREENSHOT 1 (FIXED).png", "id": "3827332124242672", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491821178_3827332127576005_5076595765115755861_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KNe-QBMMj7MQ7kNvwE_LLZk&_nc_oc=AdpFe1E9LeeCZN8BQH7Uc2ogEaFWhmWPIUy7wmbMY6Qno2a1wJu4vTqREZwlG9P08CE&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBm-WW59moxbPH2lTPBWeg-N8jCdouH80NHXwa3sXPSIg&oe=6A60BA15"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "project rust", "keywords": ["taggers", "project", "rust", "SWINGING"], "long_description": "Welcome to Project Rust \u2014 a fast-paced VR movement experience built around physical arm-swing locomotion.\n\nMove through the world by swinging your arms naturally. No joystick movement \u2014 your body is your controller. Master your momentum, explore the environment, and push your movement skills to the limit.\n\nProject Rust focuses on:\n\n\u2022 Immersive arm-based locomotion\n\u2022 Physical movement mechanics\n\u2022 Skill-based traversal\n\u2022 Fast and fluid VR gameplay\n\nEvery movement is powered by you. The more you move, the faster you go.\n\nStep into Project Rust and experience locomotion in a whole new way.", "short_description": "Fast paced arm swing locomotion survival experience where you move using your real arms. Explore, survive, and test your movement skills in Project Rust."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/project-rust/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "project rust", "support_website_url": null, "website_url": "https://sites.google.com/view/project-rust/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "26471728352413452"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491823802_1216521617356532_7076414209868789501_n.png?stp=dst-png_s360x360&_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YpMko9551vgQ7kNvwFW9rk7&_nc_oc=AdoNhxTLwXL1RvJsvf3HeFAUbbsouNInqmrCjwSI4cUkwKueHvuffigBOls96ej0vng&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDYHWDNjtA-IdL_HZve-pse8D8YQPnf30_iCz_nRmwvmw&oe=6A60D1D7"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "project rust", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Action", "id": "459781504968480"}, {"topic_name": "Platformer", "id": "528142316460358"}], "release_date": 1771850520, "lastRevision": {"nodes": [{"id": "26461255580127396", "release_type": "SCHE
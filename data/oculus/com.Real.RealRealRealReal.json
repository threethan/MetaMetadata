33333333333d.png", "id": "2363028937442589", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491830613_2363028940775922_3214516409249408237_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cGoiNI6_JWIQ7kNvwGiSDAZ&_nc_oc=AdrIO5hT0FIwHZvGJQHTn460uCCRVutrS6oJm0q7Xc72Mlb9YeCQm1muXjgXUi9o1f4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2FS-U13ao5iAP98Hfq4t9Ryo4EIg5WrmST8o6QZaEe1w&oe=69EE08D8"}, {"file_name": "Untitle333333333333d.png", "id": "1900279247280384", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499299365_1900279250613717_3999783246383052939_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AHULR1gywN0Q7kNvwGFqw2Q&_nc_oc=AdrLos-uB9sU-ilMTqeYk6MaLtxjZiSKwvgcfGB_69ih4HdUnoKGZmzgWd6aWCGbXa8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1-CgflItZ8z8yisbPN-K9Rpf3yalZmniLnOOuZ_DAQpg&oe=69EE14D0"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Monkey Tagging", "keywords": ["Tag", "Taggers", "Monkey", "Gorilla"], "long_description": "Monkey Tagging drops players into a flat, boxed-in forest where every tree is a platform and every branch is an opportunity. The environment is simple but vertical, letting you climb high, leap across gaps, and surprise opponents from above. Movement is fast and fluid, turning each chase into a creative parkour run through the trees. The open layout keeps the action constant, with clear visibility and plenty of routes to escape or ambush. It\u2019s a game of speed, strategy, monkeys, gorillas, and improvisation\u2014where the best taggers are the ones who master the forest\u2019s height and flow.\n", "short_description": "Monkey Tagging is a fast-paced tag game set in a flat, boxed-in forest. Tall, simple trees create a vertical playground you can climb and jump across. Players race through the woods, using height and movement to outsmart each other. The map is open, clean, and easy to read, keeping the focus on pure action. It\u2019s all about agility, creativity, and quick escapes."}]}, "developer_name": "Tuff Studios", "developer_privacy_policy_url": "https://docs.google.com/document/d/1NcqDTMDrqPeNOHE2RnGHFwQIGOlgdlc4piOnryqHd_Q/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Tuff Studios", "support_website_url": null, "website_url": "https://sites.google.com/view/monkey-tagging/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER"], "id": "25406013479074677"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491831968_34595824116732261_6113884928052156178_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cXl5zCwh2D8Q7kNvwH1YtO0&_nc_oc=AdqtxBpnWDo5rBtKCL6lRNb7Z-blfUzyuMGEsb8TdAE8Qr60fyaV1p41hILlBfKsGIc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3VDvQ0rn3GPEBYzY7WMfjoyla249sbgJJL2WtMaINfrw&oe=69EDF1B6"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Monkey Tagging", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Action", "id": "459781504968480"}, {"topic_name": "Platformer", "id": "528142316460358"}], "release_date": 1775503620, "lastRevision": {"nodes": [{"id": "24436844775991557", "release_type": "SCHED
33333333333d.png", "id": "2363028937442589", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491830613_2363028940775922_3214516409249408237_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8LKfEt6vg2oQ7kNvwHHiu9V&_nc_oc=Adp5o_7r37LwtCKtGi_XXAigrDhDrNa0ndwywqb3UOqIuQo7TpgHefQMeSo0E0Wsi7c&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4kN71W-YOOx-DT0EwEx8vAisCGVWiVVyxA5i0Xe4_ghA&oe=69F9E658"}, {"file_name": "Untitle333333333333d.png", "id": "1900279247280384", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499299365_1900279250613717_3999783246383052939_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mhqXhdeqA4UQ7kNvwEfIU3i&_nc_oc=AdpJ8voAbZFUg58oydqGH94sftPvKlfqca6ZhUsd78_w_TuVpDieLUJbf0K4Icfm8eA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7Nmn4C8EjQMaWuLKoLeSV6SNWSTOyUAHp5KAv6Fvnwlw&oe=69F9F250"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Monkey Tagging", "keywords": ["Tag", "Taggers", "Monkey", "Gorilla"], "long_description": "Monkey Tagging drops players into a flat, boxed-in forest where every tree is a platform and every branch is an opportunity. The environment is simple but vertical, letting you climb high, leap across gaps, and surprise opponents from above. Movement is fast and fluid, turning each chase into a creative parkour run through the trees. The open layout keeps the action constant, with clear visibility and plenty of routes to escape or ambush. It\u2019s a game of speed, strategy, monkeys, gorillas, and improvisation\u2014where the best taggers are the ones who master the forest\u2019s height and flow.\n", "short_description": "Monkey Tagging is a fast-paced tag game set in a flat, boxed-in forest. Tall, simple trees create a vertical playground you can climb and jump across. Players race through the woods, using height and movement to outsmart each other. The map is open, clean, and easy to read, keeping the focus on pure action. It\u2019s all about agility, creativity, and quick escapes."}]}, "developer_name": "Tuff Studios", "developer_privacy_policy_url": "https://docs.google.com/document/d/1NcqDTMDrqPeNOHE2RnGHFwQIGOlgdlc4piOnryqHd_Q/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Tuff Studios", "support_website_url": null, "website_url": "https://sites.google.com/view/monkey-tagging/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER"], "id": "25406013479074677"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491831968_34595824116732261_6113884928052156178_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1zQD7uV557gQ7kNvwG2g9tf&_nc_oc=AdpVy0lGD0obMh8kVBPScvZgibpqKaKHFG6nsS5NEvsaBfdOdep8gStXFGjur13ilL8&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7bMq5eV3X2BU8TbhCKj-akIKbjr-hnT_ta0JNZdZEzog&oe=69FA0776"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Monkey Tagging", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Action", "id": "459781504968480"}, {"topic_name": "Platformer", "id": "528142316460358"}], "release_date": 1775503620, "lastRevision": {"nodes": [{"id": "24436844775991557", "release_type": "SCHED
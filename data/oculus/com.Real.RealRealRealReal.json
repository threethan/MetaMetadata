33333333333d.png", "id": "2363028937442589", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/491830613_2363028940775922_3214516409249408237_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z92DqYnXcCoQ7kNvwFhwvD7&_nc_oc=AdpURuFWVNrD-7aIL39-hbQMe5hJ62TRn997shhZGNXeUoajExuh4I_4NGx6OcLKRLY&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_Q3BqzkDyYGY_k48j4-zNaT1739Zt6_P1bYtnLQl6jhg&oe=6A411758"}, {"file_name": "Untitle333333333333d.png", "id": "1900279247280384", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499299365_1900279250613717_3999783246383052939_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EHMGBBHBgioQ7kNvwHwwt-X&_nc_oc=Ado2LUBUYpIQjRlYA2u1_84xydJHo3BDzlErGfkFdNb86KhuIV52mcaLOkP6nWqXcD4&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9l8c1KHgPTWlneMCu61b2mESpG_8vaF5UgeOqf1FT1HA&oe=6A412350"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Monkey Tagging", "keywords": ["Tag", "Taggers", "Monkey", "Gorilla"], "long_description": "Monkey Tagging drops players into a flat, boxed-in forest where every tree is a platform and every branch is an opportunity. The environment is simple but vertical, letting you climb high, leap across gaps, and surprise opponents from above. Movement is fast and fluid, turning each chase into a creative parkour run through the trees. The open layout keeps the action constant, with clear visibility and plenty of routes to escape or ambush. It\u2019s a game of speed, strategy, monkeys, gorillas, and improvisation\u2014where the best taggers are the ones who master the forest\u2019s height and flow.\n", "short_description": "Monkey Tagging is a fast-paced tag game set in a flat, boxed-in forest. Tall, simple trees create a vertical playground you can climb and jump across. Players race through the woods, using height and movement to outsmart each other. The map is open, clean, and easy to read, keeping the focus on pure action. It\u2019s all about agility, creativity, and quick escapes."}]}, "developer_name": "Tuff Studios", "developer_privacy_policy_url": "https://docs.google.com/document/d/1NcqDTMDrqPeNOHE2RnGHFwQIGOlgdlc4piOnryqHd_Q/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Tuff Studios", "support_website_url": null, "website_url": "https://sites.google.com/view/monkey-tagging/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER"], "id": "25406013479074677"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/491831968_34595824116732261_6113884928052156178_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mbFys7SGLB8Q7kNvwH3CxY4&_nc_oc=AdrIRXn72pdVszPi1wSDiyaykwAoNmEeysYY34I2iAwpNsVYCQOgV49Pv3iuVXQ1D3s&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_BDSsQrId6pCsSDbnH4FnSMl6HIG5O1t0NDOqCdBrJ1Q&oe=6A413876"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Monkey Tagging", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Action", "id": "459781504968480"}, {"topic_name": "Platformer", "id": "528142316460358"}], "release_date": 1775503620, "lastRevision": {"nodes": [{"id": "24436844775991557", "release_type": "SCHED
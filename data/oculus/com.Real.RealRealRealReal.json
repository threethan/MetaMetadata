&oe=69F0B071"}, {"file_name": "Untitle333333333333d.png", "id": "2363028937442589", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491830613_2363028940775922_3214516409249408237_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-ypgR8VYSGkQ7kNvwHSXfsc&_nc_oc=AdowEA1jDLUrd5gUHU4xfUomdHNvI3hXYEI8qynW65NuPRPXio4woBj1yzApkzdRtRI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Af0YGJSJT5m5cV72_XCS-Hax1cQYXX2PHulCr-HKeSoXAw&oe=69F0ABD8"}, {"file_name": "Untitle333333333333d.png", "id": "1900279247280384", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499299365_1900279250613717_3999783246383052939_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Q7QniSMrvNEQ7kNvwFkoREK&_nc_oc=Adq3v7u15bnjYVBZrZu9Txs5ptYbMQLw1w2RcQ2BlUJ4k8aCpAyv8SOUsI5nuIpn4Co&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af3eje3uADjVYO3s2zTue__noQygulnt7HlkhzFR6FAIPw&oe=69F0B7D0"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Monkey Tagging", "keywords": ["Tag", "Taggers", "Monkey", "Gorilla"], "long_description": "Monkey Tagging drops players into a flat, boxed-in forest where every tree is a platform and every branch is an opportunity. The environment is simple but vertical, letting you climb high, leap across gaps, and surprise opponents from above. Movement is fast and fluid, turning each chase into a creative parkour run through the trees. The open layout keeps the action constant, with clear visibility and plenty of routes to escape or ambush. It\u2019s a game of speed, strategy, monkeys, gorillas, and improvisation\u2014where the best taggers are the ones who master the forest\u2019s height and flow.\n", "short_description": "Monkey Tagging is a fast-paced tag game set in a flat, boxed-in forest. Tall, simple trees create a vertical playground you can climb and jump across. Players race through the woods, using height and movement to outsmart each other. The map is open, clean, and easy to read, keeping the focus on pure action. It\u2019s all about agility, creativity, and quick escapes."}]}, "developer_name": "Tuff Studios", "developer_privacy_policy_url": "https://docs.google.com/document/d/1NcqDTMDrqPeNOHE2RnGHFwQIGOlgdlc4piOnryqHd_Q/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Tuff Studios", "support_website_url": null, "website_url": "https://sites.google.com/view/monkey-tagging/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER"], "id": "25406013479074677"}}]}, "scheduled_offers": {"count": 0, "nodes": []}, "baseline_offer": null, "is_approved": true, "firstOffer": {"nodes": []}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "25538505865825437", "version": "1.1.12"}, "id": "1935915007357559", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "24436844729324895", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "25538505865825437"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": []}, "change_log": null, "created_date": 1776634580, "id": "25539360399073317", "version": "1.1.12", "version_code": 159, "release_status": "RELE
IbVxnwUMEw_uyXk-cWPfxCYa0dFN52ZZYvG1WGU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM0zLxDXmgDPDHWmc0iD8Buy_nogdpu3VHaf5gvZ8Op3A&oe=6ABFBB10"}, {"file_name": "03-Locate-The-Direct-Hit-2560x1440.png", "id": "2024240268258978", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499312338_2024240278258977_2448722598463915175_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XOZGUv7EdP8Q7kNvwG3nUde&_nc_oc=Adobudc753sQneIWgudOOvDGFK3JqWBij83UA8Nt7nHJu77tfIbV0FcaU5BQaSVYoeU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP9JEmD4zmsPLqcMG54uWof9nA1ZHOfoqg2WYu2ifZHlQ&oe=6ABFA6D1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover-Landscape-2560x1440.png", "id": "2157580375141099", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499312310_2157580378474432_6059537525542650192_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6nvsVK-0qLgQ7kNvwHkrCk0&_nc_oc=AdobWb82cj0bVsvGOrVrjH6CA4kMabKZwgbbnmYHGnWkam7JVRSf_6-_94z5DLgtYwk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM5lZgy9qG922gHbnv2VY5hBj4eoE5kJLJL1Gf5IBkuXA&oe=6ABFAA13"}, "display_name": "Treasure Hunter: Metal Detector", "keywords": ["TreasureHunt", "MetalDetector", "TreasureHunter", "Digging", "Beach"], "long_description": "Welcome to Treasure Hunter: Metal Detector, a controller-first VR treasure hunt set on a sunny tropical beach.\n\nSweep the sand with your detector, listen and feel as the signal grows stronger, pinpoint the target, then switch to your shovel and dig up what is hidden. Every find goes into your bag\u2014sell it for money, invest in better equipment, and head back out with greater range and improved chances of rarer discoveries.\n\nFEATURES\n\u2022 A complete search, pinpoint, dig, collect, sell, and upgrade loop\n\u2022 40 unique treasures across five rarity tiers, from everyday finds to legendary rewards\n\u2022 Four detector levels with increasing range and rarity tuning\n\u2022 Collection book, inventory, lifetime statistics, and local progression\n\u2022 Guided tutorial plus standing or seated height, smooth or snap turning, dominant-hand selection, comfort vignette, audio controls, and recentering\n\u2022 Single-player, offline play with no account required\n\nSearch every stretch of sand, build a complete collection, and see what the next signal reveals.", "short_description": "Grab your metal detector and shovel, sweep a sunny tropical beach, follow audio and haptic signals, dig at the strongest hit, and uncover 40 unique treasures.\n\nSell your finds, upgrade through four detector levels, complete your collection, and track your stats in a relaxed, controller-first single-player VR treasure hunt with comfort options and local progression"}]}, "developer_name": null, "developer_privacy_policy_url": "https://faizanbashirarain.github.io/caffeinestudios/treasure-hunter-metal-detector-privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Caffeine Studios", "support_website_url": null, "website_url": "https://faizanbashirarain.github.io/caffeinestudios/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "821934236779161"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1297288726799737"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/507838217_1677084073362587_557
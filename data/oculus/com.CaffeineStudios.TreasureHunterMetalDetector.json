cm3CGgUbtcRGWcy-UgS-bZZYLiUeg&oe=6ABFB983"}, {"file_name": "01-Track-The-Signal-2560x1440.png", "id": "2972297383116808", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499313074_2972297386450141_498129575062485342_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z_uUGIYPIikQ7kNvwHSO9W-&_nc_oc=AdqiPcmbDz67RCkOtzYGzd7aJqSpQep8BMS_5KejUpCPFeX2ZsyOhxyp9Ba0NYg8AQ4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMR5KyQLgFgo1v657tHaRZRtVwq9mS8_R2rl6NA23S3Lg&oe=6ABFAA99"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover-Landscape-2560x1440.png", "id": "1018596740994185", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499617728_1018596744327518_2316697995978743104_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HzW8-vvts8IQ7kNvwEREPHU&_nc_oc=AdqgUUbTofHj0lDtUaqTFFcL2T8j1_zvRxudOQJfEoJR_7r5ZfWs1_TGKZL509Ij-I0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNqxwgFeRhaEtRMAfSLYqgx1VIgRTSnvSc5NetXOVH1FQ&oe=6ABFAD07"}, "display_name": "Treasure Hunter: Metal Detector", "keywords": ["TreasureHunt", "MetalDetector", "TreasureHunter", "Digging", "Beach"], "long_description": "Welcome to Treasure Hunter: Metal Detector, a controller-first VR treasure hunt set on a sunny tropical beach.\n\nSweep the sand with your detector, listen and feel as the signal grows stronger, pinpoint the target, then switch to your shovel and dig up what is hidden. Every find goes into your bag\u2014sell it for money, invest in better equipment, and head back out with greater range and improved chances of rarer discoveries.\n\nFEATURES\n\u2022 A complete search, pinpoint, dig, collect, sell, and upgrade loop\n\u2022 40 unique treasures across five rarity tiers, from everyday finds to legendary rewards\n\u2022 Four detector levels with increasing range and rarity tuning\n\u2022 Collection book, inventory, lifetime statistics, and local progression\n\u2022 Guided tutorial plus standing or seated height, smooth or snap turning, dominant-hand selection, comfort vignette, audio controls, and recentering\n\u2022 Single-player, offline play with no account required\n\nSearch every stretch of sand, build a complete collection, and see what the next signal reveals.", "short_description": "Grab your metal detector and shovel, sweep a sunny tropical beach, follow audio and haptic signals, dig at the strongest hit, and uncover 40 unique treasures.\n\nSell your finds, upgrade through four detector levels, complete your collection, and track your stats in a relaxed, controller-first single-player VR treasure hunt with comfort options and local progression"}]}, "developer_name": null, "developer_privacy_policy_url": "https://faizanbashirarain.github.io/caffeinestudios/treasure-hunter-metal-detector-privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Caffeine Studios", "support_website_url": null, "website_url": "https://faizanbashirarain.github.io/caffeinestudios/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "2691890164460465"}, {"id": "821934236779161"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1288572891004654"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PUBLISHED", "id": "1031756826335801"}, {"status": "PUBLISHED", "id": "2252353112185562"}]}, "baseline_offer": {"id": "2252353112185562"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1790096400
8120306385974_9028194835928966751_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nDU9RhmF10EQ7kNvwGLpACa&_nc_oc=AdoTk8NbzLcZUaBaACB9InyCaeofUfsjiFt6JokRQjQOglhBTAHbJcVQQ7ZWxto5SyM&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBD3dvA8JBwoGiNGnNcYBavaiN7NYESGIsSVUARGtCyYw&oe=6A539B30"}, {"file_name": "ScreenShot00002 1.png", "id": "1543337197527428", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/499619774_1543337204194094_8920049570072029410_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hPJYHJ89K5EQ7kNvwF3dIKa&_nc_oc=Adp3BxbF2vmGCXZ-No8RNpkmyv9BOeyPoG7PZ9MQkOJBSfLZwrH2eA65x6XxB7prBIY&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAP9QSj8jkKNfHB8o0S29F5wQRUon0yXYA9pPVHKyn3Aw&oe=6A537C8A"}, {"file_name": "ScreenShot00007.png", "id": "1534351615014947", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499299745_1534351621681613_1674887293769956231_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hd2cC5u6LWEQ7kNvwEfob0Y&_nc_oc=AdpTHdEZV1nyqSr2ebh5fdxjYxfx701dvsQeaWEAFCAmqiJhfg6HpgatDZpCmOJXYwY&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBG55eC3FNpQAjyYVTHCAESNZJmndxnWUmQcHuWT4ZR0w&oe=6A53B161"}, {"file_name": "ScreenShot00001 3.png", "id": "1317645549939218", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499300993_1317645553272551_896037553423099108_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DPtAcc-EySUQ7kNvwGWX1d2&_nc_oc=AdrP12a1T8DucZs_Y7d5pHhnNoNVwfGWb4-JuYzaF4SS4fiGwNGP49bosYiz24h78vg&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQATp8Hh1s1MJaCS_I-eRSR0fwrrWZ1piaPWl7STHi5cXg&oe=6A53807C"}, {"file_name": "ScreenShot00005 1.png", "id": "2045241163537524", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499294781_2045241170204190_512362044479697407_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5u2vPDKMOpYQ7kNvwF1cQw2&_nc_oc=Adp-za5BMf5z7NKpCKfZNSnlDFRmUuFfYnTlUEChoXKZeB5YUyv1W1uEoVDrNDBPae8&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB57ywAyk_ZpZ5cifLD19iosZgQWRpx3gGZvG703DwSug&oe=6A539988"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Nursing Assistant De-escalation", "keywords": [], "long_description": "Nursing Assistant De-escalation is an immersive VR training simulation that prepares learners to safely and effectively manage challenging patient interactions in healthcare environments. Through realistic scenarios, learners practice therapeutic communication, de-escalation techniques, patient-centered care, situational awareness, and safety-focused decision-making.\n\nThe simulation allows students to build confidence in recognizing signs of agitation, responding appropriately to escalating behaviors, maintaining a calm and professional approach, and supporting positive patient outcomes. Designed to complement classroom instruction, the experience provides a safe environment for repeated practice and skill development.\n\nThis application is part of the ImmerseLearn Nursing Assistant Certification Program and is not intended for general public use. Access is restricted to students officially enrolled in the certification program and is provided solely for hands-on training and educational purposes.", "short_description": "Nursing Assistant De-escalation is a VR training simulation designed to help learners develop effective de-escalation, communication, and patient safety skills in healthcare settings. This application is part of the ImmerseLearn Nursing Assistant Certification Program and is intended exclusively for enrolled students. Access is provided only to learners participating in the certification program for hands-on training."}]}, "developer_name": null, "developer_privacy_policy_url": "https://immerselearn.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "ImmerseLearn", "support_website_url": null, "website_url": "https://immerselearn.com/", "category": null, "comfort_rating": "COMFORTABLE
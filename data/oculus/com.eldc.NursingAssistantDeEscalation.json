28", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/499619774_1543337204194094_8920049570072029410_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-1fMfqYjMwUQ7kNvwFpnP5-&_nc_oc=AdrSYbu57pzVbmWVDWe8mTGXW35Kk0hmloPmIsK29J4Zy4d3ZMm0CiHXU-4kTTdnBjc&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8pKO_3GH-KCEB8_asWrVWcQfPExIQyReSdbCKiOqyRlQ&oe=6A4685CA"}, {"file_name": "ScreenShot00007.png", "id": "1534351615014947", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/499299745_1534351621681613_1674887293769956231_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ukYH8d8znZUQ7kNvwHPwMNc&_nc_oc=AdqyJ-rIQGagXKQmH5Pl3PpczWTPc2aNI-Wp_XvrjFJCW_w6pQCXpJggl-tyNQFwt3w&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8x4669HoDyV1xamZnU-7X0UVhMJoaVGGiMZRR7uQkgZQ&oe=6A468261"}, {"file_name": "ScreenShot00001 3.png", "id": "1317645549939218", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/499300993_1317645553272551_896037553423099108_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x01OKup8hdgQ7kNvwFvB1NR&_nc_oc=AdpOni9kWSaeu_OR0bWSiNZqLj0MTb_Z9H_1Zs6LhQi_YV9fgsQJL8jCZtIv9cuywVg&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8QPuTZCCtSphEN45mam3R7hcct5FOFsLQqCFvTXUoIgA&oe=6A4689BC"}, {"file_name": "ScreenShot00005 1.png", "id": "2045241163537524", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/499294781_2045241170204190_512362044479697407_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nqtyChVYmUkQ7kNvwHiYU2k&_nc_oc=AdrKufV44jXVQDG0P1CycGeywj2HATTTtCRpAnXAzFQKLbZaS9RNSz_t3-L0_c3n1aQ&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af97C1quJPxt6ZFHtZnGInrRvQ063RN-zkZExQxT6AcgpA&oe=6A466A88"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Nursing Assistant De-escalation", "keywords": [], "long_description": "Nursing Assistant De-escalation is an immersive VR training simulation that prepares learners to safely and effectively manage challenging patient interactions in healthcare environments. Through realistic scenarios, learners practice therapeutic communication, de-escalation techniques, patient-centered care, situational awareness, and safety-focused decision-making.\n\nThe simulation allows students to build confidence in recognizing signs of agitation, responding appropriately to escalating behaviors, maintaining a calm and professional approach, and supporting positive patient outcomes. Designed to complement classroom instruction, the experience provides a safe environment for repeated practice and skill development.\n\nThis application is part of the ImmerseLearn Nursing Assistant Certification Program and is not intended for general public use. Access is restricted to students officially enrolled in the certification program and is provided solely for hands-on training and educational purposes.", "short_description": "Nursing Assistant De-escalation is a VR training simulation designed to help learners develop effective de-escalation, communication, and patient safety skills in healthcare settings. This application is part of the ImmerseLearn Nursing Assistant Certification Program and is intended exclusively for enrolled students. Access is provided only to learners participating in the certification program for hands-on training."}]}, "developer_name": null, "developer_privacy_policy_url": "https://immerselearn.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "ImmerseLearn", "support_website_url": null, "website_url": "https://immerselearn.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recomme
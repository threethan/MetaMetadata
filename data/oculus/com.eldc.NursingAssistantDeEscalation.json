cdn.com/v/t64.5771-25/499294781_2045241170204190_512362044479697407_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZTpCOQwYgREQ7kNvwHYAW6T&_nc_oc=Adq45gEQIt9wdGqrArpurPQcygFGeBKtv8Q5exdZHJAnLy-j0TIsZ7ePEwYdoF_O9rg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLMmtwuvMzzbS2_TxO1vD_q9Oxl4Xk1HAX7EoN3wsM_7w&oe=6AAA9C88"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Nursing Assistant De-escalation", "keywords": [], "long_description": "Nursing Assistant De-escalation is an immersive VR training simulation that prepares learners to safely and effectively manage challenging patient interactions in healthcare environments. Through realistic scenarios, learners practice therapeutic communication, de-escalation techniques, patient-centered care, situational awareness, and safety-focused decision-making.\n\nThe simulation allows students to build confidence in recognizing signs of agitation, responding appropriately to escalating behaviors, maintaining a calm and professional approach, and supporting positive patient outcomes. Designed to complement classroom instruction, the experience provides a safe environment for repeated practice and skill development.\n\nThis application is part of the ImmerseLearn Nursing Assistant Certification Program and is not intended for general public use. Access is restricted to students officially enrolled in the certification program and is provided solely for hands-on training and educational purposes.", "short_description": "Nursing Assistant De-escalation is a VR training simulation designed to help learners develop effective de-escalation, communication, and patient safety skills in healthcare settings. This application is part of the ImmerseLearn Nursing Assistant Certification Program and is intended exclusively for enrolled students. Access is provided only to learners participating in the certification program for hands-on training."}]}, "developer_name": null, "developer_privacy_po
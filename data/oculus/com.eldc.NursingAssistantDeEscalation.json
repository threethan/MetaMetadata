5_1534351621681613_1674887293769956231_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zqVtZRAW8RgQ7kNvwFQfxcI&_nc_oc=AdrZ-9GAdJGSKuQpVQ2ca7b6pWDOUMrbpSvZjkmXIenDZUWbfflu02H0_Bl4yI5mjME&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHPhWP8A5SiFdFoHjqGrVhaOjdb75WY7EmJDIcAztrjXg&oe=6A883521"}, {"file_name": "ScreenShot00001 3.png", "id": "1317645549939218", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/499300993_1317645553272551_896037553423099108_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Et1-FVgNGd0Q7kNvwGOrOWM&_nc_oc=Adp9DWQVWTUHJ-zggoy7bz-TFlwJlvLLe1IGJpIw0CoNCLM2TtJoie09_MbUvhKYivM&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFIFV8NQxpweS__Vpx8hV1QocDHzdtxcUX5AuJW-RzQEQ&oe=6A883C7C"}, {"file_name": "ScreenShot00005 1.png", "id": "2045241163537524", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/499294781_2045241170204190_512362044479697407_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pwQtsLxNEwUQ7kNvwGU_Enl&_nc_oc=Adq9kQyPKyS0p5D_5y-DElb6bxx7lOGcBC2N5MQWKt2eqA2mLIrgLPD7M6u7crmN__U&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGFU-lpSA27Rw-gKwpxVuSDbEdxDOuA3pb4_5YVlLbeew&oe=6A881D48"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Nursing Assistant De-escalation", "keywords": [], "long_description": "Nursing Assistant De-escalation is an immersive VR training simulation that prepares learners to safely and effectively manage challenging patient interactions in healthcare environments. Through realistic scenarios, learners practice therapeutic communication, de-escalation techniques, patient-centered care, situational awareness, and safety-focused decision-making.\n\nThe simulation allows students to build confidence in recognizing signs of agitation, responding appropriately to escalating behaviors, maintaining a calm and professional approach, and supporting positive patient outcomes. Designed to complement classroom instruction, the experience provides a safe environment for repeated practice and skill development.\n\nThis application is part of the ImmerseLearn Nursing Assistant Certification Program and is not intended for general public use. Access is restricted to students officially enrolled in the certification program and is provided solely for hands-on training and educational purposes.", "short_description": "Nursing Assistant De-escalation is a VR training simulation designed to help learners develop effective de-escalation, communication, and patient safety skills in healthcare settings. This application is part of the ImmerseLearn Nursing Assistant Certification Program and is intended exclusively for enrolled students. Access is provided only to learners participating in the certification program for hands-on training."}]}, "developer_name": null, "developer_privacy_policy_url": "https://immerselearn.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "ImmerseLearn", "support_website_url": null, "website_url": "https://immerselearn.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1603525061774299"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1499558377732833"}]}, "baseline_offer": {"id": "1499558377732833"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1781506380, "status":
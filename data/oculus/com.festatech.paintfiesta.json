ow&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRUB9sXCKs0RkT2AVc5e97Rowsu3OSUKF3D12Mk4MSi2Q&oe=6B071634"}, {"file_name": "screenshot-3.png", "id": "1490346784704751", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031485_1490346788038084_7507991197771315481_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c83D6PmbcjUQ7kNvwG_lO6W&_nc_oc=AdrzFztB9uIRfENDLnmJx3T1jpeD914BIiuqurGeEy1oI8jatRFLuY281ySyOkxvJ4U&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR6g7br4LGLSaGPB6MZ-kDyr-XfhJZdZbqH2KJXS096iw&oe=6B0724B4"}, {"file_name": "screenshot-4.png", "id": "203387835888992", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982530_203387839222325_6934894423169291277_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ov92iaWD6u4Q7kNvwFnBM3L&_nc_oc=AdpJ-Wn5Ba_EE8hE5mqL_xvXenNN4NOkJpzGzZmO3WFG5BHDpJaDAt_66h_6XnFUpnw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQZH5CJ7ppTX-Hjt3lbJK586NhWJoP1toZ7341Z8dPU8A&oe=6B06F8AF"}, {"file_name": "screenshot-5.png", "id": "1271899597088655", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/86625130_1271899600421988_5037473839936376382_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l_AUbccZfMIQ7kNvwEJOLsF&_nc_oc=AdoIOUn-WHWX8CXijX_P7bn3xEgzx-AMZHIzPyGu_wfjza64UxmgoCHk1POC0Z3BpdM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTP4s4o0anYSD01yYMFvb_uXRGeBbMMe0HMu5X_ebHyog&oe=6B06FDB7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "video-thrumbnail.png", "id": "256542640244415", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75647711_256542643577748_8718635494303440535_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0Prn1N8T2q4Q7kNvwF_BpeD&_nc_oc=Adqwr09HEJz4netHZEyLTSOAgRt4v0jUTnQucsEUbOCqUo7Nw2MpZaRGlo5H2-9Wa7Y&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSYg5UCm6elHxdyWbJvPiCZjM1GWrVxsdknphidW-7B7w&oe=6B070EE0"}, "display_name": "Paint Fiesta", "keywords": [], "long_description": "Draw on your walls without getting in trouble! Throw on your headset and look at your hands - no controllers required (although they are supported) - your hands have all the power needed to transform your room into anything that you can imagine. Paint, stickers, rainbows, and even real world materials are at your fingertips. Spray, brush, stamp, bucket fill, and pixel paint the walls, ceilings and floors to your heart's desire.\n\nPaint Fiesta is currently early access and there are many additional features planed, based on your support.", "short_description": "Reality is your canvas! Paint on your walls, as seen through the passthrough camera, using just your hands. Let your imagination come to life as you experience the future of immersive digital content creation. This app is early access and your input can help shape its direction!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://paintfiesta.com/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Festa Tech LLC", "support_website_url": null, "website_url": "https://paintfiesta.com/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "7818006781585721"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculu
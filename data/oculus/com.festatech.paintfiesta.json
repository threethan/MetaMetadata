FU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ0cJCw0S58cFhe_Hwl5N2QH3moLvaN-QS9hCDo3KkU1A&oe=6AFDDBB4"}, {"file_name": "screenshot-3.png", "id": "1490346784704751", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031485_1490346788038084_7507991197771315481_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vbPz7gq_VQIQ7kNvwHf8x9F&_nc_oc=AdpubEMI-wNnSBWihoHu8qpmH-DVrXIi9wUUEHkyFYaugR3Q_dWH9vBc_mrqnhDKH4Q&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSShdExgqNEChGB9bZ6rMKv6zwG5XOhg4KDlWmpheTagw&oe=6AFDB1F4"}, {"file_name": "screenshot-4.png", "id": "203387835888992", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982530_203387839222325_6934894423169291277_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6c9HXvWLTAcQ7kNvwH6GluP&_nc_oc=Adr44CXvebpiWj4I1Lkoaot40YSUIacwyTXWdbN0B0UtENqIh9gY15WQ3vLO9p_QzNU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTLjvVw-915W2M94UIA36OkrI8qYcJp3HOs0JfyYWLVhA&oe=6AFDBE2F"}, {"file_name": "screenshot-5.png", "id": "1271899597088655", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/86625130_1271899600421988_5037473839936376382_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YsB2aZl6FJ0Q7kNvwFZBGYd&_nc_oc=Adp0ebRP-Qdp6WVHw65xkfhGU5MVm0rBHNBuEi6vMf4E6X3wEq7Wud5LJS53RLYQrsk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR1qXtzfbsSe_cXNDYmAmkSK-UtO3mOs0PzPMmAyI-Wwg&oe=6AFDC337"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "video-thrumbnail.png", "id": "256542640244415", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75647711_256542643577748_8718635494303440535_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m_Hh3tLTkBEQ7kNvwGDIoZ7&_nc_oc=Adq5L_BYbtjZ6Hap--evPVoc1_CQ_a-y7L6MiH36UDsmCJSamB8FHIl9LJUyiYxgzTs&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRl4uzlWWAXOh19i7p6syy2e0m2S9vZNeKNtfZdFMiK1g&oe=6AFDD460"}, "display_name": "Paint Fiesta", "keywords": [], "long_description": "Draw on your walls without getting in trouble! Throw on your headset and look at your hands - no controllers required (although they are supported) - your hands have all the power needed to transform your room into anything that you can imagine. Paint, stickers, rainbows, and even real world materials are at your fingertips. Spray, brush, stamp, bucket fill, and pixel paint the walls, ceilings and floors to your heart's desire.\n\nPaint Fiesta is currently early access and there are many additional features planed, based on your support.", "short_description": "Reality is your canvas! Paint on your walls, as seen through the passthrough camera, using just your hands. Let your imagination come to life as you experience the future of immersive digital content creation. This app is early access and your input can help shape its direction!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://paintfiesta.com/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Festa Tech LLC", "support_website_url": null, "website_url": "https://paintfiesta.com/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "7818006781585721"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculu
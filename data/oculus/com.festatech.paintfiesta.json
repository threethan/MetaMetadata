38084_7507991197771315481_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4m6exh1_8MgQ7kNvwGarAbV&_nc_oc=AdmxSu_CKHYwBuIQuXdYylW2f2ZhaZEWKUaVZu0p4m5Tw0ZxgldXtQmViAmhSsupork&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfzAgAMBav-O2CYDZVsoLiA1nUjpV7qDnszOw8bW_1-GSQ&oe=69BFF874"}, {"file_name": "screenshot-4.png", "id": "203387835888992", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982530_203387839222325_6934894423169291277_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cPZs5AekayMQ7kNvwG17-3R&_nc_oc=AdkncQekwySDVsFmaLEuFuUTk7p89O5oKM52qYmB5FgtRF4wlike8zqxvqgMopWQQhw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfxxkECFWzuaghsv9YDKPID0xqrGP1r8gvD9ZreFnVBoiw&oe=69BFCC6F"}, {"file_name": "screenshot-5.png", "id": "1271899597088655", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/86625130_1271899600421988_5037473839936376382_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z9fNBV28GvwQ7kNvwFOey4i&_nc_oc=AdmKyxR-mH7FK4zZ4HxXgOtFK6waBSK2HFjYDoeXc4sHyWaFYE9rZeT1mmmKrlyw0sc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfxidId7hNlp6TTs502E-IrQvEy6NQC3fqaptKkbab23TQ&oe=69BFD177"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "video-thrumbnail.png", "id": "256542640244415", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75647711_256542643577748_8718635494303440535_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k4dO5UTaXSsQ7kNvwHnyZ7j&_nc_oc=AdmWBjf_OcdTOETQFFxwrBJLvBWrvt13PNqtWDunJAp7H3C3OC2aze44bhUU6-KdB2A&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfxV9wA94CZSBduu91Uzvmnd8EC7tXgFtHnpc-H5tUzhlg&oe=69BFE2A0"}, "display_name": "Paint Fiesta", "keywords": [], "long_description": "Draw on your walls without getting in trouble! Throw on your headset and look at your hands - no controllers required (although they are supported) - your hands have all the power needed to transform your room into anything that you can imagine. Paint, stickers, rainbows, and even real world materials are at your fingertips. Spray, brush, stamp, bucket fill, and pixel paint the walls, ceilings and floors to your heart's desire.\n\nPaint Fiesta is currently early access and there are many additional features planed, based on your support.", "short_description": "Reality is your canvas! Paint on your walls, as seen through the passthrough camera, using just your hands. Let your imagination come to life as you experience the future of immersive digital content creation. This app is early access and your input can help shape its direction!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://paintfiesta.com/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Festa Tech LLC", "support_website_url": null, "website_url": "https://paintfiesta.com/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "7818006781585721"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974871_1366648700560089_5472636139232347723_n.png?stp=dst-png_s360x360&_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nbHerFwegZAQ7kNvwG_QwZl&_nc_oc=AdkMPweoUox5SZP21oHiUzHQlNV1TbrT4Giv1JO9jE5YkeyumKZp2LjZwRaITagheoQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfyeL1rFhZINBNAm7dHpgZq3PJPAyMXrOJ-vS1ZNSkwb5Q&oe=69BFCF1C"}, "is_concept": false, "is_test
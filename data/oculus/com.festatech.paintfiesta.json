38084_7507991197771315481_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lL8yiJSzVn8Q7kNvwGSLbro&_nc_oc=AdkuCW77SD7p14A_jAXAZPjUYm-ZMnfwnD-rPQRSuT--us-pWZM3t3EC4jiMt4oaplk&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=8&oh=00_Afw06W06PlVk19bzugHzrs5lGclGX79zGOGCQywz_zXh8w&oe=69BD5574"}, {"file_name": "screenshot-4.png", "id": "203387835888992", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38982530_203387839222325_6934894423169291277_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pMvZbkhVUFIQ7kNvwEKpGI8&_nc_oc=Adn_KJ1AMOVdKo9TFBVnsgLkXbKIRjKLcxgB7trdzAs0bLKIVzd_Hmib8terS-qv75k&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=8&oh=00_Afx1TO2Rb89XImWt-LHCdIPqRQ7G3JvONyJnVp8ys-wvFg&oe=69BD296F"}, {"file_name": "screenshot-5.png", "id": "1271899597088655", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/86625130_1271899600421988_5037473839936376382_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z9fNBV28GvwQ7kNvwEoG3P4&_nc_oc=Admb4QcPGXR1DYUvZ7P8pSTqnfRK2g8KTGxz8A9XKWwPMg_s3rR9m5lQyKzqhoc6Sg4&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=8&oh=00_AfwOFt_P0f-Gdm1a8oZOohsNZTc8_cVnC8wt37WW6s9Vug&oe=69BD2E77"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "video-thrumbnail.png", "id": "256542640244415", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/75647711_256542643577748_8718635494303440535_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k4dO5UTaXSsQ7kNvwE7v2oK&_nc_oc=AdkMnfsDfdd7NmXimg5jw0nw7irHqhy5Rkn5U29GSK1iCSPhTgQiyliH3bD5wuqLNMo&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=8&oh=00_Afwb_4dMTVHP3_2CYJpXIdcKEOCYyLCJRbxokAqsRmhcXQ&oe=69BD3FA0"}, "display_name": "Paint Fiesta", "keywords": [], "long_description": "Draw on your walls without getting in trouble! Throw on your headset and look at your hands - no controllers required (although they are supported) - your hands have all the power needed to transform your room into anything that you can imagine. Paint, stickers, rainbows, and even real world materials are at your fingertips. Spray, brush, stamp, bucket fill, and pixel paint the walls, ceilings and floors to your heart's desire.\n\nPaint Fiesta is currently early access and there are many additional features planed, based on your support.", "short_description": "Reality is your canvas! Paint on your walls, as seen through the passthrough camera, using just your hands. Let your imagination come to life as you experience the future of immersive digital content creation. This app is early access and your input can help shape its direction!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://paintfiesta.com/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Festa Tech LLC", "support_website_url": null, "website_url": "https://paintfiesta.com/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "7818006781585721"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974871_1366648700560089_5472636139232347723_n.png?stp=dst-png_s360x360&_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_Q9Z1AGpp60Q7kNvwGVn0v5&_nc_oc=Adk_K6iH5EjmaGy6nyAcRpIXIw7MOMx_DrtPptFVHDIJDHwCBOR8bbEb7XEYcXrnZzk&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=8&oh=00_Afz1YabdHFWz5J1kHHHsFBwQuNrOhC8Hx47tNb59jIWeNA&oe=69BD2C1C"}, "is_concept": false, "is_test
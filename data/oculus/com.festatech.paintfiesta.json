uscdn.com/v/t64.5771-25/39031485_1490346788038084_7507991197771315481_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Qd0Ttuwd6WQQ7kNvwHNoDtC&_nc_oc=AdpUDBAiXJefRZc1LP0RoOD0o7SQzCHk-Hs2LKmHmP3H4-Nlflk5IxdfAhEoq_B2hQo&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8rA3JFQr61yLNGUZIVQx6uVhN3tuAg-XDZNUC_Rr5YuA&oe=6A369F74"}, {"file_name": "screenshot-4.png", "id": "203387835888992", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/38982530_203387839222325_6934894423169291277_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MsxyHH6mmTcQ7kNvwG1iQo9&_nc_oc=Adq1lFluG0C6XIBTc8oERTixICt4t6KUJO61EEdrIqYsvA1xKCrKfdQeACmcinSUfew&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-B0FJ4AP0RgqshGio8bbdRTsbH5czTUFDgrQstQro8OA&oe=6A36ABAF"}, {"file_name": "screenshot-5.png", "id": "1271899597088655", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/86625130_1271899600421988_5037473839936376382_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g3Rdb4T9JFEQ7kNvwFzuLbL&_nc_oc=Adr7kjgwSsxb-6UY1tenhqYnNd979vzcOV3oIXmCzWbxXJcOiYoGZYgd_6wgFIkGU8E&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9w8WMMdmb4EowgzDdYF3kR1EcqBZwxaslTP406tBkwdA&oe=6A36B0B7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "video-thrumbnail.png", "id": "256542640244415", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/75647711_256542643577748_8718635494303440535_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MoUxaLxBrygQ7kNvwFKHRwG&_nc_oc=AdoMk-1FcGjcoi5Gml1Fpr0FxeMNALfW3d3SGKh6vVQnq0mcS9DsutlrGLkL8NAavJ0&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_foE09uzpltwikvkSMrT2Muj2l7XnlpXcLKArGN5gYNQ&oe=6A36C1E0"}, "display_name": "Paint Fiesta", "keywords": [], "long_description": "Draw on your walls without getting in trouble! Throw on your headset and look at your hands - no controllers required (although they are supported) - your hands have all the power needed to transform your room into anything that you can imagine. Paint, stickers, rainbows, and even real world materials are at your fingertips. Spray, brush, stamp, bucket fill, and pixel paint the walls, ceilings and floors to your heart's desire.\n\nPaint Fiesta is currently early access and there are many additional features planed, based on your support.", "short_description": "Reality is your canvas! Paint on your walls, as seen through the passthrough camera, using just your hands. Let your imagination come to life as you experience the future of immersive digital content creation. This app is early access and your input can help shape its direction!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://paintfiesta.com/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Festa Tech LLC", "support_website_url": null, "website_url": "https://paintfiesta.com/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "7818006781585721"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/38974871_1366648700560089_5472636139232347723_n.png?stp=dst-png_s360x360&_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gWLrcJw4N8cQ7kNvwFkhbyn&_nc_oc=AdpVlKZ3ZPuNL1lwYKc4GR_79eVBl5km0qzqEf5nFG-7vX5LVNQ6M11jq2VlFxvScwM&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-5xJw7qKsnO7yFfj3Mc
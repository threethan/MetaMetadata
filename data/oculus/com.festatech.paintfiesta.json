vXMOAQ7kNvwHh-H5f&_nc_oc=AdnL_4xF_a3V4eS91GzGxhg9aYbzWz9Qe52UapHT0WwxYIWs5xgLPPxZ2K-9Y_4qHfA&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&oh=00_AfvezhsvRHnlpIUCS0r4it0vc6H0HhwMEeumA5CZ7-nTSQ&oe=69A1A5F4"}, {"file_name": "screenshot-4.png", "id": "203387835888992", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/38982530_203387839222325_6934894423169291277_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CogsCUVzAWUQ7kNvwFRrbKj&_nc_oc=AdliWR42HXJyw2uhPN-QkGUY5p-mjv-B7hLDRz4d2c7ZbiFQdYzw09xbS4u3anIjhlA&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&oh=00_AfsDe1R9YRoVdbE60ni3Jsc9C5T9_0DGcrR7SCvWgBGKHQ&oe=69A179EF"}, {"file_name": "screenshot-5.png", "id": "1271899597088655", "uri": "https://scontent-hkg4-2.oculuscdn.com/v/t64.5771-25/86625130_1271899600421988_5037473839936376382_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=StrsfCzddZMQ7kNvwG6-Udx&_nc_oc=Adn4NXeuQ14_0IPYHJGhS4PObHjHV1hwGOKbzNjrPHHVyENKXrWBsLy_P1CAshJZjFQ&_nc_zt=3&_nc_ht=scontent-hkg4-2.oculuscdn.com&oh=00_AftnORumCCnTLDi8qmuHkOWK1I4iyOqGqfkNaDDoBls5FQ&oe=69A17EF7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "video-thrumbnail.png", "id": "256542640244415", "uri": "https://scontent-hkg1-1.oculuscdn.com/v/t64.5771-25/75647711_256542643577748_8718635494303440535_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UUQ4TIs4oIcQ7kNvwEWWPDS&_nc_oc=AdlX8ZOGe_tPNKq1OdXHNQhU-pFgHmf2rqe0Ne6JDBa_VyZGYz_615BTn1Fbkz6DW3s&_nc_zt=3&_nc_ht=scontent-hkg1-1.oculuscdn.com&oh=00_Aft1TktpFRJ87CHlch09JOJuzF-Y2lbo9F8ATYUp6b7QFA&oe=69A19020"}, "display_name": "Paint Fiesta", "keywords": [], "long_description": "Draw on your walls without getting in trouble! Throw on your headset and look at your hands - no controllers required (although they are supported) - your hands have all the power needed to transform your room into anything that you can imagine. Paint, stickers, rainbows, and even real world materials are at your fingertips. Spray, brush, stamp, bucket fill, and pixel paint the walls, ceilings and floors to your heart's desire.\n\nPaint Fiesta is currently early access and there are many additional features planed, based on your support.", "short_description": "Reality is your canvas! Paint on your walls, as seen through the passthrough camera, using just your hands. Let your imagination come to life as you experience the future of immersive digital content creation. This app is early access and your input can help shape its direction!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://paintfiesta.com/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Festa Tech LLC", "support_website_url": null, "website_url": "https://paintfiesta.com/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "7818006781585721"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-hkg1-1.oculuscdn.com/v/t64.5771-25/38974871_1366648700560089_5472636139232347723_n.png?stp=dst-png_s360x360&_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F2kLWhA3RvkQ7kNvwFcyZM9&_nc_oc=AdnnelR-TpZojP6O9sIscQWYmtcpRfkE4uD3dovKUuacW5HlSQTqQqfqp8s2fPpRvYw&_nc_zt=3&_nc_ht=scontent-hkg1-1.oculuscdn.com&oh=00_AfsSboLYBjsbGCJeqL5y-HrYKhE8NMixRCHXaZADzKKcyg&oe=69A17C9C"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Paint Fiesta", "platform": "ANDROID_6DOF", "context_category": {"con
ELewlf4Mel9EeLOEg&oe=6A8EC7EF"}, {"file_name": "screenshot-5.png", "id": "1271899597088655", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/86625130_1271899600421988_5037473839936376382_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Rwp6m7f85lMQ7kNvwGDB24U&_nc_oc=AdrPuotStAUG0naxf4zi_W1jq6brHgyH23CokfpvfGnNKjEYirAYIsGcYmUYKG8s9Ms&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHyYBQLGQyUPPQBiyTio1q5AuY-Jk_HlNtvCagFyM4dsA&oe=6A8ECCF7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "video-thrumbnail.png", "id": "256542640244415", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/75647711_256542643577748_8718635494303440535_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yPCz3n49HZkQ7kNvwFsvDWl&_nc_oc=AdqrsSy7AJfX5mDkEpIR1i1LwPEHXjs5xlHs3uUq8m2M3FMu_wDa8phmcJReTj1c5rQ&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQERyo2p2ouV7CTsQs5aoBn_Hahy1z4_v8-zOpwN6xzc5g&oe=6A8EDE20"}, "display_name": "Paint Fiesta", "keywords": [], "long_description": "Since the beginning of human history art and technology have come together to unleash our creativity. From cave art to computers, painting has allowed us to express ourselves while learning how to harness the power new technology. Just as paint programs inspired a generation of digital natives to embrace computers and tablets, Paint Fiesta brings that spark of magic to Augmented Reality.\n\nYou can finally draw on your walls without getting in trouble! Throw on your headset and look at your hands - no controllers required (although they are supported) - your hands have all the power needed to transform your room into anything that you can imagine. Paint, stickers, rainbows, and even real world materials are at your fingertips. Spray, brush, stamp, bucket fill, and pixel paint the walls, ceilings and floors to your heart's desire.\n\nPaint Fiesta is currently under active development and being provided for free on App Lab for a limited time. There are many exciting new features planned and your feedback will help determine how this app grows to unlock the full potential of your imagination!\n\nLearn more about how you can contribute at paintfiesta.com.", "short_description": "Reality is your canvas! Paint on your walls, as seen through the passthrough camera, using just your hands. Let your imagination come to life as you experience the future of immersive digital content creation. This app is under active development and your input can help shape its direction!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://paintfiesta.com/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Festa Tech LLC", "support_website_url": null, "website_url": "https://paintfiesta.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "972210250477036"}}]}, "scheduled_offers": {"count": 5, "nodes": [{"status": "PUBLISHED", "id": "982669987022358"}, {"status": "PUBLISHED", "id": "3804485953129131"}, {"status": "PUBLISHED", "id": "1029448702073599"}, {"status": "PUBLISHED", "id": "1360115387894321"}, {"status": "PUBLISHED", "id": "1019576239283366"}]}, "baseline_offer": {"id": "1029448702073599"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1737396000, "status": "PUBLISHED", "id": "982669987022358"}]}, "liveChannel": {"nodes": [{"latest_supported_bi
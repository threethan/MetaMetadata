m/v/t64.5771-25/39031485_1490346788038084_7507991197771315481_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iHYPZ9CrF5AQ7kNvwFI4nqw&_nc_oc=AdoUZdvxGhnK23bnN9f5KK5ak1vAm8WuXh7kXMse2xv0agsBPAph4P2zSg0y9f8ziiQ&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2A4bQfjua0l8ElQ1M8b33y9O2xaIw2b5yCtBN3TP5jUw&oe=69EF6E74"}, {"file_name": "screenshot-4.png", "id": "203387835888992", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38982530_203387839222325_6934894423169291277_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L8YedYXgHeIQ7kNvwFEvovu&_nc_oc=AdogkcfEMXZsPimCszmeoFTUktEIXCg-lyk0Bm9KGd9zoIGCZ26EXU0fjueIG0Pz_hY&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2d3mNmhjRiSLUOvPCFbSyxKMD4Wdw5xd7AkhyGmdhaDA&oe=69EF7AAF"}, {"file_name": "screenshot-5.png", "id": "1271899597088655", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/86625130_1271899600421988_5037473839936376382_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OZfI7f5BHfkQ7kNvwFRUGBL&_nc_oc=AdpgmweiqIiUhpzb2FfGSLeCpIvgc_22pA9LtzkmBYYYJLYTp4jFcUdAt5mVVo9NO-s&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af29_aTX05JK78Cwz6YjPjxWIkvxKRJ-rzsVbWjd1alyqA&oe=69EF4777"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "video-thrumbnail.png", "id": "256542640244415", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/75647711_256542643577748_8718635494303440535_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BX1iW-z5UAMQ7kNvwG1kyB2&_nc_oc=AdpHcV9lWGHPWefhSWKWr5N0Jcy0bPo90ZyXDgwIfYQXXudaY_BldJq8EC5sOhHii3w&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1nbyM5jA7bpdbiJRbyazKNKqhY6dUwWIHIt_3ram8Pfg&oe=69EF58A0"}, "display_name": "Paint Fiesta", "keywords": [], "long_description": "Draw on your walls without getting in trouble! Throw on your headset and look at your hands - no controllers required (although they are supported) - your hands have all the power needed to transform your room into anything that you can imagine. Paint, stickers, rainbows, and even real world materials are at your fingertips. Spray, brush, stamp, bucket fill, and pixel paint the walls, ceilings and floors to your heart's desire.\n\nPaint Fiesta is currently early access and there are many additional features planed, based on your support.", "short_description": "Reality is your canvas! Paint on your walls, as seen through the passthrough camera, using just your hands. Let your imagination come to life as you experience the future of immersive digital content creation. This app is early access and your input can help shape its direction!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://paintfiesta.com/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Festa Tech LLC", "support_website_url": null, "website_url": "https://paintfiesta.com/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "7818006781585721"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974871_1366648700560089_5472636139232347723_n.png?stp=dst-png_s360x360&_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FTp9cIioOVgQ7kNvwH9IT9I&_nc_oc=AdqBZAqf737TULy0VgRXTy7R8y_3f9nqZi5YfzdNNEB9vAXZbUZmr0E166RYZPul9ik&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0yfuww4gAsh85pLvtc0-Ko1KI7BCZrMCJ
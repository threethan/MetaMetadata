ZIA6iuedmwFuKXnxHsINasukF8Ujbx1y0Z8WhGC6piULzFmV5-00IxmTpQ&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT_Z4V_KCuOUmvD4NgPl0HIrU0doAGOzmr7zlsMpRHOwQ&oe=6AFF0374"}, {"file_name": "screenshot-4.png", "id": "203387835888992", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982530_203387839222325_6934894423169291277_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WyXJcW0Yw18Q7kNvwEZU-nK&_nc_oc=AdpxFvKBhj6jqebEj4Blz9MtaL80hP4rIGe6SnfdRMG_OGqZjQWYx_Druy06-5lDUQQ&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTRVX6uhjiGZ2wQ-nPEAS-yqh1djfyQOCMmZ7M7HIwX7w&oe=6AFF0FAF"}, {"file_name": "screenshot-5.png", "id": "1271899597088655", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/86625130_1271899600421988_5037473839936376382_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YsB2aZl6FJ0Q7kNvwFU0r8W&_nc_oc=AdqXy6XkMq0dJhSEpSslLr6lfMkVZgYg9L37efTtoIK0ZQoe_mqQVW9kpNCMGzdl5GE&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTMKQ6g1KFCDTohpIuk3EWzQrcyTUBG5PGo6hqbKCYf1A&oe=6AFF14B7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "video-thrumbnail.png", "id": "256542640244415", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75647711_256542643577748_8718635494303440535_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m_Hh3tLTkBEQ7kNvwHwoN2M&_nc_oc=AdpjIyOn24W1ixzQkQI6lDTuI-5ZNOIjWybOlig21FoIQH2R2gUWljbh1SR93D5L5Mc&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRg9UgqS26cYrgBDZNESj6U75WE2YPh7-GvUZtJrO402g&oe=6AFF25E0"}, "display_name": "Paint Fiesta", "keywords": [], "long_description": "Since the beginning of human history art and technology have come together to unleash our creativity. From cave art to computers, painting has allowed us to express ourselves while learning how to harness the power new technology. Just as paint programs inspired a generation of digital natives to embrace computers and tablets, Paint Fiesta brings that spark of magic to Augmented Reality.\n\nYou can finally draw on your walls without getting in trouble! Throw on your headset and look at your hands - no controllers required (although they are supported) - your hands have all the power needed to transform your room into anything that you can imagine. Paint, stickers, rainbows, and even real world materials are at your fingertips. Spray, brush, stamp, bucket fill, and pixel paint the walls, ceilings and floors to your heart's desire.\n\nPaint Fiesta is currently under active development and being provided for free on App Lab for a limited time. There are many exciting new features planned and your feedback will help determine how this app grows to unlock the full potential of your imagination!\n\nLearn more about how you can contribute at paintfiesta.com.", "short_description": "Reality is your canvas! Paint on your walls, as seen through the passthrough camera, using just your hands. Let your imagination come to life as you experience the future of immersive digital content creation. This app is under active development and your input can help shape its direction!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://paintfiesta.com/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Festa Tech LLC", "support_website_url": null, "website_url": "https://paintfiesta.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_m
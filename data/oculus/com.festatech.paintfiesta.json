m/v/t64.5771-25/39031485_1490346788038084_7507991197771315481_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4hEAmzRSzAUQ7kNvwE-rV0-&_nc_oc=AdpxYvk0jkmRnst0R3Yu592jlDGPYwkC-GkTtyr8Dpwd4peixg7-AyZw5hcjR_Fb6Ts&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGJGQVVCt6tbI2vG2xP6OiJu_8dkqM0dy2Setd1JkUP2g&oe=6A7738F4"}, {"file_name": "screenshot-4.png", "id": "203387835888992", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982530_203387839222325_6934894423169291277_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RDD4YkvWHygQ7kNvwFOc1m3&_nc_oc=Adpu6nn490iodfrZexExSXA_H8dTBD-e8-LUI9H5BcN4MPnmz9_2y46IXjhfE4RNw40&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEFhIN9hjf1VLqR5VnTXFob6cJ7jrw-sdIzAJZGlIKXKQ&oe=6A77452F"}, {"file_name": "screenshot-5.png", "id": "1271899597088655", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/86625130_1271899600421988_5037473839936376382_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oG7XMr0vA7UQ7kNvwFZ2Lxo&_nc_oc=Adqix2Tu5jR2XDfN8aWyOoDsbfEEQ8CbrtpbkYuzfNSM0a3KzHX1ShaPuD-os6vAlsQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHUdioCu2LVt-xkzBEXTi_l6MZKQWqScKciFc7BInVbTw&oe=6A7711F7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "video-thrumbnail.png", "id": "256542640244415", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75647711_256542643577748_8718635494303440535_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s0_GlYpPqCsQ7kNvwHRhNNw&_nc_oc=Adox0HOD7qu9NoPmVyPaGCHz9zmk4D-sNj5o6LorpKcyyD6ZUbbA2CDrUCeUr7-qKT8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEAZPaSA2lly8ooRYcRMtMXl_jp0nXaIL6j5ZqOQpdcVw&oe=6A772320"}, "display_name": "Paint Fiesta", "keywords": [], "long_description": "Draw on your walls without getting in trouble! Throw on your headset and look at your hands - no controllers required (although they are supported) - your hands have all the power needed to transform your room into anything that you can imagine. Paint, stickers, rainbows, and even real world materials are at your fingertips. Spray, brush, stamp, bucket fill, and pixel paint the walls, ceilings and floors to your heart's desire.\n\nPaint Fiesta is currently early access and there are many additional features planed, based on your support.", "short_description": "Reality is your canvas! Paint on your walls, as seen through the passthrough camera, using just your hands. Let your imagination come to life as you experience the future of immersive digital content creation. This app is early access and your input can help shape its direction!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://paintfiesta.com/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Festa Tech LLC", "support_website_url": null, "website_url": "https://paintfiesta.com/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "7818006781585721"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974871_1366648700560089_5472636139232347723_n.png?stp=dst-png_s360x360&_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6uFHHmO7m5AQ7kNvwGVkWi9&_nc_oc=AdqWVRMfRa2qvejDcdLNpTU5qRWQZu7-FVNRu01mhEKapg8d-rJUXFvtQBQjnRMrTDI&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFqczF3K0UUjtw3ChKHv5jyHqr_pI5CCFb
38084_7507991197771315481_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vpsSxgICLmUQ7kNvwHv_OIg&_nc_oc=AdlTfh-9EtDzBcaGRJbVUjQP_gsZ_VxLFmExgdWk16TGmz9DQWtOlCn6DDQMNS7OI8Y&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfxsCZG6BYwHkq7gOOGl6sv_lyeyxwfTA88wQLQUTK8qcg&oe=69B960F4"}, {"file_name": "screenshot-4.png", "id": "203387835888992", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982530_203387839222325_6934894423169291277_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xNUA6QQ7_s0Q7kNvwE0Vpxw&_nc_oc=Adly4sSQY1ZO0exwuymefpme0U4rjjRlyQR4f1DA9eLuGhnCPA_xRd6zeDyoheUnkGo&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfycV8n-lJUPzRohUa-PC8qzpN71_rX3NjFHYBkIeoXhiw&oe=69B934EF"}, {"file_name": "screenshot-5.png", "id": "1271899597088655", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/86625130_1271899600421988_5037473839936376382_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QwU0pWbjprEQ7kNvwEpgEQb&_nc_oc=AdkOxWh9GzG0ZE_-vTsQM8pX_dJ5ThtmbDx4Ji3jkzredheceL9meH2ZgOg3XqZyI24&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_Afw2wi2bzud-lkg3XdfO8j_ZyrpEnjFJo13Rxzm4PNTpPQ&oe=69B939F7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "video-thrumbnail.png", "id": "256542640244415", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75647711_256542643577748_8718635494303440535_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B4GF9nL3jm4Q7kNvwGW1JHe&_nc_oc=AdnwT_5cS6hmTaB4VZ2zfhPkwCxUe0f4zUYt46MRiu_AYl6ZAg_VRO0tM8-dteDx4_w&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_Afysh_nBNmTiuVKwU4TVeGJE8rc5MnGLVTYhcBUKbgD7Zw&oe=69B94B20"}, "display_name": "Paint Fiesta", "keywords": [], "long_description": "Draw on your walls without getting in trouble! Throw on your headset and look at your hands - no controllers required (although they are supported) - your hands have all the power needed to transform your room into anything that you can imagine. Paint, stickers, rainbows, and even real world materials are at your fingertips. Spray, brush, stamp, bucket fill, and pixel paint the walls, ceilings and floors to your heart's desire.\n\nPaint Fiesta is currently early access and there are many additional features planed, based on your support.", "short_description": "Reality is your canvas! Paint on your walls, as seen through the passthrough camera, using just your hands. Let your imagination come to life as you experience the future of immersive digital content creation. This app is early access and your input can help shape its direction!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://paintfiesta.com/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Festa Tech LLC", "support_website_url": null, "website_url": "https://paintfiesta.com/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "7818006781585721"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974871_1366648700560089_5472636139232347723_n.png?stp=dst-png_s360x360&_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IhTVzZ-Oy0UQ7kNvwHZVVjf&_nc_oc=Adl84EW0e0uBt-gbuutosua8vwB5G4Khy5yzdPttO6rhpjXs-EyJUXxVx9cSDEomyR4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfwXed3McMH-W4fPgqHG9HPjnQ4VdvueNXRcbIuCyEmFdg&oe=69B9379C"}, "is_concept": false, "is_test
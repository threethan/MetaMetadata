38084_7507991197771315481_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=COy04WqoFD8Q7kNvwGZ1VHG&_nc_oc=AdmrH7e5EtvAxfol9CNYzZNm6dZwrb5u0HDaskLimk7BNffGb1rEvbOoSmlMY5sMn9w&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_Afysri4eGh3RkcDsc5mjSAUlK1VWaa_wYFQx8hTQfMCjPg&oe=69AC31F4"}, {"file_name": "screenshot-4.png", "id": "203387835888992", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982530_203387839222325_6934894423169291277_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F2bEovEfq-IQ7kNvwEw4Dw8&_nc_oc=Adnan5wXZQF_T5Hg-4nl6s5XctfSnkodzFrKnuwZe1mwIuRgveh3MRtIIrrcjM8KSDg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_Afx887e0v4ZRoj2afvlf9I0YAj3fzXDKy1H3h7dlhhaQYA&oe=69AC05EF"}, {"file_name": "screenshot-5.png", "id": "1271899597088655", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/86625130_1271899600421988_5037473839936376382_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YdYLx7mi1nMQ7kNvwG-ToG-&_nc_oc=Adnfri6v21W5uAh3i1jvG8QKhFh3oI7XNXN0iNhacpXxelxO1c30lZA1uD1Vjpp9tTE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_Afx5bwcZTuhtGdZGGIFRFxdkZ2DXCBz1FuB1rPiCWcUNiQ&oe=69AC0AF7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "video-thrumbnail.png", "id": "256542640244415", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75647711_256542643577748_8718635494303440535_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g7-4mq6zoaoQ7kNvwFQFjfY&_nc_oc=Adm_SNpse_nLxk9WoI8eVummahEqWb7B8uo2vloIXBhYSzcT5jE9dPAHZbHpAGGRhZE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_Afz_rcymm1wFFc2-SwdZNQOFw4cnR2DY2MBY7AineRn2bg&oe=69AC1C20"}, "display_name": "Paint Fiesta", "keywords": [], "long_description": "Draw on your walls without getting in trouble! Throw on your headset and look at your hands - no controllers required (although they are supported) - your hands have all the power needed to transform your room into anything that you can imagine. Paint, stickers, rainbows, and even real world materials are at your fingertips. Spray, brush, stamp, bucket fill, and pixel paint the walls, ceilings and floors to your heart's desire.\n\nPaint Fiesta is currently early access and there are many additional features planed, based on your support.", "short_description": "Reality is your canvas! Paint on your walls, as seen through the passthrough camera, using just your hands. Let your imagination come to life as you experience the future of immersive digital content creation. This app is early access and your input can help shape its direction!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://paintfiesta.com/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Festa Tech LLC", "support_website_url": null, "website_url": "https://paintfiesta.com/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "7818006781585721"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974871_1366648700560089_5472636139232347723_n.png?stp=dst-png_s360x360&_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sSzgqOjH6iQQ7kNvwEqHzt6&_nc_oc=AdliWr0gco9ky0PGMHrO4yn94epPvqxWeh6BEw5gBMaAnsVMMx8rd67Qttv8hjk9nKU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_Afyhs2Pc_w0gqfQoO4Rrcyr4rvmPPbBZDx8lpetORBJcFA&oe=69AC089C"}, "is_concept": false, "is_test
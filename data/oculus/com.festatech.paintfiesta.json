m/v/t64.5771-25/39031485_1490346788038084_7507991197771315481_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O4UVdLm9YzIQ7kNvwFZ0475&_nc_oc=AdoZIrIkRTcO1OXpZpOw-H0Y-JkDpMshzf2iaV8pSH5qsOjdWkFj2Lweki-9b8oxpeY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3ksFjBjn1smtH58qcS24cIuFMWbsoqf4PCBAi-Nv1i6Q&oe=69DA5674"}, {"file_name": "screenshot-4.png", "id": "203387835888992", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982530_203387839222325_6934894423169291277_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kWPk_PkM4BkQ7kNvwFbe9lq&_nc_oc=AdqXJ197RhZeLBSa4-eHg47m38lWQHjT_-yjq3K-MrWkGNdXwJIdzuRZ6o6R57VA2O4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3kxymaU0ncBugBeA0MeajQk4F799_1-Z8ZxaudfzktUA&oe=69DA2A6F"}, {"file_name": "screenshot-5.png", "id": "1271899597088655", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/86625130_1271899600421988_5037473839936376382_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WcvB15wZkcYQ7kNvwHbj2QG&_nc_oc=Adp5PNze_68iXUVniT-tcEQMiCZlczf9YuDV5YZvDk2U7iOtn07KkIDO5hkbHCNY6W0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0_-a4PNH5gCz_RAFYsPfHoFi9Evz6M5fipxsOvFGyNew&oe=69DA2F77"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "video-thrumbnail.png", "id": "256542640244415", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75647711_256542643577748_8718635494303440535_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vbTcLd7DGg8Q7kNvwFCZki4&_nc_oc=Adq_TIvyLsZRbf1XBRmWilYNGYXLwVOKArvNohvZhxKJXmBu8gqgbt-wmoJXH8rppAg&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0CoAA2IA3m5VCLMGdFpTR4GZPbiFcGuuWvTWNaG8LP2w&oe=69DA40A0"}, "display_name": "Paint Fiesta", "keywords": [], "long_description": "Draw on your walls without getting in trouble! Throw on your headset and look at your hands - no controllers required (although they are supported) - your hands have all the power needed to transform your room into anything that you can imagine. Paint, stickers, rainbows, and even real world materials are at your fingertips. Spray, brush, stamp, bucket fill, and pixel paint the walls, ceilings and floors to your heart's desire.\n\nPaint Fiesta is currently early access and there are many additional features planed, based on your support.", "short_description": "Reality is your canvas! Paint on your walls, as seen through the passthrough camera, using just your hands. Let your imagination come to life as you experience the future of immersive digital content creation. This app is early access and your input can help shape its direction!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://paintfiesta.com/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Festa Tech LLC", "support_website_url": null, "website_url": "https://paintfiesta.com/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "7818006781585721"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974871_1366648700560089_5472636139232347723_n.png?stp=dst-png_s360x360&_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wPJ1fbaDiU8Q7kNvwEjv8Zw&_nc_oc=Adrv85Vn_QYKppKAmx4wtDyY8ouyv3aVeyKqdiWcqph67WhXpkTkWvxV1O2XUzDA41s&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af39ykMv79nSFX_CvsshhGIPG04IFA0027A
NIyrr4-As6g7Yfs8MIEs8URWtVVxlwPlg&oe=6AFB3160"}, "display_name": "Paint Fiesta", "keywords": [], "long_description": "Draw on your walls without getting in trouble! Throw on your headset and look at your hands - no controllers required (although they are supported) - your hands have all the power needed to transform your room into anything that you can imagine. Paint, stickers, rainbows, and even real world materials are at your fingertips. Spray, brush, stamp, bucket fill, and pixel paint the walls, ceilings and floors to your heart's desire.\n\nPaint Fiesta is currently early access and there are many additional features planed, based on your support.", "short_description": "Reality is your canvas! Paint on your walls, as seen through the passthrough camera, using just your hands. Let your imagination come to life as you experience the future of immersive digital content creation. This app is early access and your input can help shape its direction!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://paintfiesta.com/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Festa Tech LLC", "support_website_url": null, "website_url": "https://paintfiesta.com/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "7818006781585721"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lga3-3.oculu
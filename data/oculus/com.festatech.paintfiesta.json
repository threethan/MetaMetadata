38084_7507991197771315481_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4m6exh1_8MgQ7kNvwEvGxo1&_nc_oc=AdqVyZ0y8wGLmm7xHo0Gwbo0EMeF934cDGW_p1W9HKAPIDEegIdHP0ODAYeYl0MnekM&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=8&oh=00_Afw7Kij5iooYTGsIT25kQalIzLnTYYVppaDtfswLXCfiiA&oe=69C149F4"}, {"file_name": "screenshot-4.png", "id": "203387835888992", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38982530_203387839222325_6934894423169291277_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cPZs5AekayMQ7kNvwFUIySa&_nc_oc=AdqVN07wIV_MCsgpxYC6ygNWjGrx_9huBwrQNxAs75lj7DYxmA-OWJrgLQ6N_V8OzH8&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=8&oh=00_Afz4sSU5hqhaI6BoG_gHWT6rngwRxOSxiu_lt00U-6fOEA&oe=69C11DEF"}, {"file_name": "screenshot-5.png", "id": "1271899597088655", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/86625130_1271899600421988_5037473839936376382_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5iV_Zhe4QBoQ7kNvwEphP7x&_nc_oc=AdoEdPYTcPusc6I80XT2NZfezKP4fNpHWSJwdctax_XRiqumPlH2LZwx6lZ5k-LqEU8&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_Afx74SORILsJxHTr1TpyviVJVq-47V215M1-6vkTbcR6PA&oe=69C122F7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "video-thrumbnail.png", "id": "256542640244415", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75647711_256542643577748_8718635494303440535_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=X1LkecfdUpwQ7kNvwEnZ9pg&_nc_oc=AdrXyuL2TbaFviLzlMeAa6NZZkHaXm1nUqwBYm8238yOU1fMUO_JOI86g7dA4_cVppY&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=8&oh=00_AfwtuvzQZO9Niud3Zbm2j4uH2kYNUfmO4-LEiictv-Iedg&oe=69C13420"}, "display_name": "Paint Fiesta", "keywords": [], "long_description": "Draw on your walls without getting in trouble! Throw on your headset and look at your hands - no controllers required (although they are supported) - your hands have all the power needed to transform your room into anything that you can imagine. Paint, stickers, rainbows, and even real world materials are at your fingertips. Spray, brush, stamp, bucket fill, and pixel paint the walls, ceilings and floors to your heart's desire.\n\nPaint Fiesta is currently early access and there are many additional features planed, based on your support.", "short_description": "Reality is your canvas! Paint on your walls, as seen through the passthrough camera, using just your hands. Let your imagination come to life as you experience the future of immersive digital content creation. This app is early access and your input can help shape its direction!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://paintfiesta.com/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Festa Tech LLC", "support_website_url": null, "website_url": "https://paintfiesta.com/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "7818006781585721"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974871_1366648700560089_5472636139232347723_n.png?stp=dst-png_s360x360&_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nbHerFwegZAQ7kNvwHpUGpH&_nc_oc=AdoWfkJ9qu3NAQg_pnImoLGdYQIKp2zsehZT7pPHgQTrF2dB6oJI3iqtHzcKY4tx4pE&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=8&oh=00_Afy_EytWnjNZ3o282_KKIkTejsafdPVTpJkQyCHHl5tSqA&oe=69C1209C"}, "is_concept": false, "is_test
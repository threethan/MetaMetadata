38084_7507991197771315481_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xVkmc5qJRekQ7kNvwHH03_y&_nc_oc=Admz7uKvlnh14BIm1KLBa6N75Ysq0a7AJw3G7h7SC7JtmX1YxV9VLCl_kgS6n4ehWKM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfznXktuASPo6uHnpMNa4mSMdWNTbR7Bxd2jy4VJJn6sSA&oe=69B41AF4"}, {"file_name": "screenshot-4.png", "id": "203387835888992", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982530_203387839222325_6934894423169291277_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K0Fo6s9TJe8Q7kNvwGXftZo&_nc_oc=AdlbJhmmSMHqGTP564ehlJJBAPl8rGByTdxvYAESR8JWFIzAKzsZj4NxC4d4AZk6Sig&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_Afz8VE0dUjs3xitGF0bIPUsCtDy6ZhUCjhjni-8JdK4T4w&oe=69B3EEEF"}, {"file_name": "screenshot-5.png", "id": "1271899597088655", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/86625130_1271899600421988_5037473839936376382_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aQ-eGLXZkYIQ7kNvwEcit7X&_nc_oc=AdmlBbB4MOBFS0-yVX9A1Gt07c9AiwVhK8dX-eLbjc0-MTYCMnlsaggOXW2Epl0LiCU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfwAEm6ws1X25HuMBS86eMji_ylksbI8kL1hPnxsGibJgQ&oe=69B3F3F7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "video-thrumbnail.png", "id": "256542640244415", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75647711_256542643577748_8718635494303440535_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HHy8ifJw5k8Q7kNvwFiYfXC&_nc_oc=Adl2c2siPVGLog89wcszykP673lgNQNmjQW84cjGb9uZAtL-6O-JBNvN7X3EzEOK16A&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfwRpFDtGjMaSE8AvuDZcEqPuuBGfGfiYTXWZ2HTRrRiXQ&oe=69B40520"}, "display_name": "Paint Fiesta", "keywords": [], "long_description": "Draw on your walls without getting in trouble! Throw on your headset and look at your hands - no controllers required (although they are supported) - your hands have all the power needed to transform your room into anything that you can imagine. Paint, stickers, rainbows, and even real world materials are at your fingertips. Spray, brush, stamp, bucket fill, and pixel paint the walls, ceilings and floors to your heart's desire.\n\nPaint Fiesta is currently early access and there are many additional features planed, based on your support.", "short_description": "Reality is your canvas! Paint on your walls, as seen through the passthrough camera, using just your hands. Let your imagination come to life as you experience the future of immersive digital content creation. This app is early access and your input can help shape its direction!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://paintfiesta.com/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Festa Tech LLC", "support_website_url": null, "website_url": "https://paintfiesta.com/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "7818006781585721"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974871_1366648700560089_5472636139232347723_n.png?stp=dst-png_s360x360&_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8GK40Y3d4tgQ7kNvwEj1le8&_nc_oc=AdnY3Te8Q2uD_B2uv_EOLbbxqXEq3IhgNvtT0iCA3fTUAKJRWhJMF_n4zLzbGGuzzgc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_Afx8Gs-ZjhXFjGdP4L195-7Bdx3oUFLhzl-BWxMx6MPPjA&oe=69B3F19C"}, "is_concept": false, "is_test
m/v/t64.5771-25/39031485_1490346788038084_7507991197771315481_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lIY05r-ZUT4Q7kNvwH2iUup&_nc_oc=AdrV2RwyUpyPJXW2Gq0xJinzSqnMxA4dG7HOk8E8XiVnjtbz9yvaSEHP5NOLQJfxW78&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL6ZKT6HdfOVmRlhnJhYrN01UmEqkApjcu1zy2oK0arUA&oe=6ABBC6F4"}, {"file_name": "screenshot-4.png", "id": "203387835888992", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982530_203387839222325_6934894423169291277_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WM-ztMlI2QoQ7kNvwGU7DPD&_nc_oc=Adq9EvsHPCuVbXJWHNCzImMtL8z19pAY4cpSqv__i6kdMFNZ4XGx_c_gyLpBlTqQm0Y&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ_lVaTSsiLPHltGMkSlJQM2L-36J_5IBLzs6wwb3Qz9A&oe=6ABBD32F"}, {"file_name": "screenshot-5.png", "id": "1271899597088655", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/86625130_1271899600421988_5037473839936376382_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=omtqlK9ntIoQ7kNvwGjELXV&_nc_oc=AdpQIG6Ni-V0AFVCp3BUQ_DT0aNyIK3NSegf6C3rpuHprJVHySFU9D9m9s8VtGIZ4w8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIxs8OkhLwTrUUIkUULW32Hc28keOtuCH0DBbAUVHHn8A&oe=6ABBD837"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "video-thrumbnail.png", "id": "256542640244415", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75647711_256542643577748_8718635494303440535_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xiHONbiUx_4Q7kNvwFYnKb6&_nc_oc=Adr0xS4Twr1eYb0QVLoq6mWZ1N9bKj2lGPjND8JOhnxe1mHaFFa8A6HwLAd3vlwzGiE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLYgKbCWHWmw-rxlE3Ra_C6uDN-BERvzE-OWCVlKxo1dw&oe=6ABBB120"}, "display_name": "Paint Fiesta", "keywords": [], "long_description": "Draw on your walls without getting in trouble! Throw on your headset and look at your hands - no controllers required (although they are supported) - your hands have all the power needed to transform your room into anything that you can imagine. Paint, stickers, rainbows, and even real world materials are at your fingertips. Spray, brush, stamp, bucket fill, and pixel paint the walls, ceilings and floors to your heart's desire.\n\nPaint Fiesta is currently early access and there are many additional features planed, based on your support.", "short_description": "Reality is your canvas! Paint on your walls, as seen through the passthrough camera, using just your hands. Let your imagination come to life as you experience the future of immersive digital content creation. This app is early access and your input can help shape its direction!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://paintfiesta.com/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Festa Tech LLC", "support_website_url": null, "website_url": "https://paintfiesta.com/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "7818006781585721"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974871_1366648700560089_5472636139232347723_n.png?stp=dst-png_s360x360&_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Nbpve8XUUvYQ7kNvwFvGEmY&_nc_oc=Ado9e3tIJJyh5mJH-uXz_XkSVSmyIGeqtI5hBq-UD4Kno1mUgC8OVk07Dlw23XhOV7o&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ2jpAlhO92S0xGMsWklSlzXeP27gItzYk
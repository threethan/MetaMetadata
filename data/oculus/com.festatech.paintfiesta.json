dQZEYQ7kNvwFD7Qqt&_nc_oc=AdmPM-jaZAXvP63Zw7hku2y69LsM9C7oOKS-m4CtDMS0qi72sBqwXE-nJgIyE47QhcA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AftBXWdmr7grKdNcO-yc8SfD9O4RXnaibxsbevrA6CoM6w&oe=6999BCF4"}, {"file_name": "screenshot-4.png", "id": "203387835888992", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982530_203387839222325_6934894423169291277_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yQ-SuOJmoDQQ7kNvwHMhxAx&_nc_oc=AdmGXVbOHhtuxuFrU6OlbvQvrTAqbHgMOFnr49Rnh0cQ4sXlqKYi57L_IMOnqYr9V_g&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfuYH_3cyyz_9bl8eLTl17qgsGhiO5XefvTmLYaHLvDX7w&oe=699990EF"}, {"file_name": "screenshot-5.png", "id": "1271899597088655", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/86625130_1271899600421988_5037473839936376382_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=djQew9c16woQ7kNvwGYU9xd&_nc_oc=Adk30ETqTxlpbfn1SFABAREzkSKMueaw6WyjZNYlpWrYmIGp9kATH1NOBcBwBGEgCc8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfuLF_DNm9ONp2wFyRbkznZW7YSAApJlqivyhWpmuosYRg&oe=699995F7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "video-thrumbnail.png", "id": "256542640244415", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75647711_256542643577748_8718635494303440535_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PQcU6hMePusQ7kNvwE6EPxR&_nc_oc=AdnJyl3VdnLvuYd_iTyEpC1V5rrFYHkwdWzckScoEhAMe_Z91d9KRMJWdEu_Hik_9t4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfsQ09DZxUbucUHpxCyrqSxPTk-T57RIuS19vwl1LnpiKQ&oe=6999A720"}, "display_name": "Paint Fiesta", "keywords": [], "long_description": "Draw on your walls without getting in trouble! Throw on your headset and look at your hands - no controllers required (although they are supported) - your hands have all the power needed to transform your room into anything that you can imagine. Paint, stickers, rainbows, and even real world materials are at your fingertips. Spray, brush, stamp, bucket fill, and pixel paint the walls, ceilings and floors to your heart's desire.\n\nPaint Fiesta is currently early access and there are many additional features planed, based on your support.", "short_description": "Reality is your canvas! Paint on your walls, as seen through the passthrough camera, using just your hands. Let your imagination come to life as you experience the future of immersive digital content creation. This app is early access and your input can help shape its direction!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://paintfiesta.com/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Festa Tech LLC", "support_website_url": null, "website_url": "https://paintfiesta.com/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "7818006781585721"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974871_1366648700560089_5472636139232347723_n.png?stp=dst-png_s360x360&_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i5mRVFs6xW8Q7kNvwEaIFze&_nc_oc=AdmqfCpx-3VHsh_7glu6PElpZsn3yCCdGQL755vNUhMY1DDe0YB2fzFQTDtcKfKgb2g&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfuioZYfVZfrfl2mcbDdIfJNIES1DgRRCUD78_le_SE8pg&oe=6999939C"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Paint Fiesta", "platform": "ANDROID_6DOF", "context_category": {"con
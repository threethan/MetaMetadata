m/v/t64.5771-25/39031485_1490346788038084_7507991197771315481_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nUvAY2PsOkYQ7kNvwFiqDn2&_nc_oc=AdorDknT2fwF9w1ZSMWOKDvHm-6uDJh0-83n1WM1QGJW6vKzMWtHuAolpwGOPzHZBwU&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_Q_DrF5JcD2-bfT7b_g7R79nhkRV3LFkqiyhgojBUqjg&oe=6A412B74"}, {"file_name": "screenshot-4.png", "id": "203387835888992", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38982530_203387839222325_6934894423169291277_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oN0E2AQmWFAQ7kNvwEzdFny&_nc_oc=AdoxxT5urnxrL4Xgy3mH8fB7Geflrknl9yFY3iZFAwBUsvXsOvA_I_NCicLxH8h6iwQ&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8y8wwFOTOjU4SSvIyIabLQYZPbkF_D3D-WM5MZ37H5NQ&oe=6A4137AF"}, {"file_name": "screenshot-5.png", "id": "1271899597088655", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/86625130_1271899600421988_5037473839936376382_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aYm_BGbPTSYQ7kNvwHcIEiG&_nc_oc=AdobRoVmD3fQ6rAgF_11lTUF_TZ8BX6GfOu0UULC6GUqW7KHm-WO-ox7j2l4iI_xswg&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af98smjQRIzhCtBfzCTlhi9B4ZciRCsWbz5sdH8j4v9TmA&oe=6A413CB7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "video-thrumbnail.png", "id": "256542640244415", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75647711_256542643577748_8718635494303440535_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AmZUpQvzi0MQ7kNvwHGZAeD&_nc_oc=AdqwgrFrcsVYRoRqtdR6oAcBX2PvlvdfctYYyJiSBeCJhafR9LZjiqVeG7zVovzBYgQ&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-RZ3NyI1xzXNeHzWKv5duVYb7nnxhLLiw6zAaQFcDdOg&oe=6A4115A0"}, "display_name": "Paint Fiesta", "keywords": [], "long_description": "Draw on your walls without getting in trouble! Throw on your headset and look at your hands - no controllers required (although they are supported) - your hands have all the power needed to transform your room into anything that you can imagine. Paint, stickers, rainbows, and even real world materials are at your fingertips. Spray, brush, stamp, bucket fill, and pixel paint the walls, ceilings and floors to your heart's desire.\n\nPaint Fiesta is currently early access and there are many additional features planed, based on your support.", "short_description": "Reality is your canvas! Paint on your walls, as seen through the passthrough camera, using just your hands. Let your imagination come to life as you experience the future of immersive digital content creation. This app is early access and your input can help shape its direction!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://paintfiesta.com/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Festa Tech LLC", "support_website_url": null, "website_url": "https://paintfiesta.com/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "7818006781585721"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974871_1366648700560089_5472636139232347723_n.png?stp=dst-png_s360x360&_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pDmVqvakZqwQ7kNvwG6UAnx&_nc_oc=AdozZ21RhgmG4GPx8AayD0Rd-DkLGJxOCTS5KoyG0ytgrogz22TRwRJ_eRxxxLazlDk&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8IKp4adfrQjbZnT5nEdzetgrVtr24GJwS
38084_7507991197771315481_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xVkmc5qJRekQ7kNvwEoUArQ&_nc_oc=AdneVvs6vL7ZIQL6rjmvGswqEdSCNFPU8X0Tev8E0Kd64cNj_N6kytwaYGOWJ3zEkjI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfwQR_o2mePe0LL4sVUVKO7iuPX2yzyqY0PyHkxjmKGytg&oe=69B56C74"}, {"file_name": "screenshot-4.png", "id": "203387835888992", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982530_203387839222325_6934894423169291277_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K0Fo6s9TJe8Q7kNvwETu2SQ&_nc_oc=Adl6gWO2CZy8xU-ZZngypIkLyAlb-NuZuv2P7kU15SAXcuNOnmD7xORUPfGfJg6MN9s&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfyneXsXZyHwtq567WXx5rtKdQGPV3tLEJBDkl5swXHcaA&oe=69B5406F"}, {"file_name": "screenshot-5.png", "id": "1271899597088655", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/86625130_1271899600421988_5037473839936376382_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nd3XdMz94PwQ7kNvwHZTqUU&_nc_oc=AdlfyCC24hd5FRByo7mwYyti0agZIktEldwCk-JnBiGq5G8yDa9xCcJe0VbyIxEwbSg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfzNxVx9yds6BgoLy2kABfQfsU-QEWcXoSEVV-Y0Do2_Qg&oe=69B54577"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "video-thrumbnail.png", "id": "256542640244415", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75647711_256542643577748_8718635494303440535_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qn2fVaggPr4Q7kNvwHucu1M&_nc_oc=AdlIgIDenTdpAjbQ8TPAhKhDyF5YNNas9TRhhMFqWR6W-5W-wF1fFtFctBio5FYNOCc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfyS4eSyUaT6KzJZyUDeP2xVVTbHJUOznJXgEUA5d9dGFQ&oe=69B556A0"}, "display_name": "Paint Fiesta", "keywords": [], "long_description": "Draw on your walls without getting in trouble! Throw on your headset and look at your hands - no controllers required (although they are supported) - your hands have all the power needed to transform your room into anything that you can imagine. Paint, stickers, rainbows, and even real world materials are at your fingertips. Spray, brush, stamp, bucket fill, and pixel paint the walls, ceilings and floors to your heart's desire.\n\nPaint Fiesta is currently early access and there are many additional features planed, based on your support.", "short_description": "Reality is your canvas! Paint on your walls, as seen through the passthrough camera, using just your hands. Let your imagination come to life as you experience the future of immersive digital content creation. This app is early access and your input can help shape its direction!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://paintfiesta.com/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Festa Tech LLC", "support_website_url": null, "website_url": "https://paintfiesta.com/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "7818006781585721"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974871_1366648700560089_5472636139232347723_n.png?stp=dst-png_s360x360&_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8GK40Y3d4tgQ7kNvwE-gvS3&_nc_oc=AdkDzoVBqYqCJ5_3tvihRgvJs61rIoK8ZId4gYP48c0yMmFPvWKRq08bBnbJTZ-wCTg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfzC68JoevsrGbwhFOpFBtDDNTQcCGv5jF4xAfGeqizDVw&oe=69B5431C"}, "is_concept": false, "is_test
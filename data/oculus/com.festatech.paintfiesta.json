g", "id": "629429049225758", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031531_629429052559091_2267349147996250334_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6PGG7BDZ90YQ7kNvwHYWx4K&_nc_oc=Adqo-26_E-PK-i0RpUJwUTVXhkqbMByuqpKqRDdLwr_2YLNG3-owg--Ht_cnJt8BxMw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Af0j9UGM8V-aNvjp1FoOOUlrmvZbLFhdkpXo3sTh1m8heg&oe=69F0A399"}, {"file_name": "screenshot-2.png", "id": "562227746061571", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031523_562227749394904_3928510685327478795_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LiHkAw3lWiAQ7kNvwFMTZmY&_nc_oc=Ado9tIBkHIkyYsdwmCSodZ5vYVwUMW0X2zTILyZjl3ITxV6kjM_Zw9VoFKo7lXV5Ibs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af3nL5BaxLnakY03kEomQS6xSbZEsJKsM75oe9BmV9tnFA&oe=69F0B174"}, {"file_name": "screenshot-3.png", "id": "1490346784704751", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031485_1490346788038084_7507991197771315481_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iHYPZ9CrF5AQ7kNvwG2t-rD&_nc_oc=Adou9EaKEKq7UH9hV1qlXyJ_e_SHD0IqXClUcMMAV3pIIcYzm8VlS1Lqms20TJbYZbo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Af2OYDmu_FNJ2Su3BQC9XzjbDI-XXuETY170hqpov_svTA&oe=69F0BFF4"}, {"file_name": "screenshot-4.png", "id": "203387835888992", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982530_203387839222325_6934894423169291277_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L8YedYXgHeIQ7kNvwFAJE8D&_nc_oc=AdptvOf7iNLLeQHeio-3Ymrpor1vAMnCAnznApuwSJJes_y678uqQrhu_YahxusMXEI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Af1Odm7K7y-k5lbxHmxz4Q0BbVnfSC4Z-ikMxLgPOSC2zg&oe=69F0CC2F"}, {"file_name": "screenshot-5.png", "id": "1271899597088655", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/86625130_1271899600421988_5037473839936376382_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AGLUsfAYuXYQ7kNvwGNEZUN&_nc_oc=AdoaIr7Y0Ca99xW9HLpeaXij6XP7rQarpoTOCpatK0CklokJmjqgXHg-USf_F3WAsaE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Af2_x97_q2AB5DTt_9T-vKJUON0QK8cPq0UQItGmn2fOHg&oe=69F0D137"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "video-thrumbnail.png", "id": "256542640244415", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75647711_256542643577748_8718635494303440535_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y4UUIObDyT8Q7kNvwFtKqNc&_nc_oc=AdrCCF4i32cQxnjIWBvAgF4hadgdxtbwws6f1ST-Vl7v9P8DBxlr3RPIWuA3OB9QgD0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Af1erZ0Fb6DKSzkOywVZk5Ta3IerujnFx9Fp3bDJRHTPmg&oe=69F0AA20"}, "display_name": "Paint Fiesta", "keywords": [], "long_description": "Since the beginning of human history art and technology have come together to unleash our creativity. From cave art to computers, painting has allowed us to express ourselves while learning how to harness the power new technology. Just as paint programs inspired a generation of digital natives to embrace computers and tablets, Paint Fiesta brings that spark of magic to Augmented Reality.\n\nYou can finally draw on your walls without getting in trouble! Throw on your headset and look at your hands - no controllers required (although they are supported) - your hands have all the power needed to transform your room into anything that you can imagine. Paint, stickers, rainbows, and even real world materials are at your fingertips. Spray, brush, stamp, bucket fill, and pixel paint the walls, ceilings and floors to your heart's desire.\n\nPaint Fiesta is currently under active development and being provided for free on App Lab for a limited time. There are many exciting new features planned and your feedback will help determine how this app grows to unlock the full potential of your imagination!\n\nLearn more about how you can contribute at paintfiesta.com.", "short_description": "Reality is your canvas! Paint on your walls, as seen through the passthrough camera, using just your hands. Let your imagination come to life as you experience the future of immersive digital content creation. This app is under active development and your input can help shape its direction!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://paintfiesta.com/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Festa Tech LLC", "support_website_url": null, "website_url": "https://paintfiesta.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "972210250477036"}}]}, "scheduled_offers": {"count": 5, "nodes": [{"status": "PUBLISHED", "id": "982669987022358"}, {"status": "PUBLISHED", "id": "3804485953129131"}, {"status": "PUBLISHED", "id": "1029448702073599"}, {"status": "PUBLISHED", "id": "1360115387894321"}, {"status": "PUBLISHED", "id": "1019576239283366"}]}, "baseline_offer": {"id": "1029448702073599"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1737396000, "status": "PUBLISHED", "id": "982669987022358"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "6212757695443979", "version": "0.9.5"}, "id": "998895937745622", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "5965128760206875", "i
m/v/t64.5771-25/39031485_1490346788038084_7507991197771315481_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VTCgUhu3jqcQ7kNvwH45_R8&_nc_oc=AdpoyxAUCelrb8pWWdFItEyQMW2VLYy04bIqOoWUa7_NjIj4HgS32pIR-ySxidLFPXY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFULGcc0sSJ-hF2SUHoQpzEO34WzEZJv6kzzAi9DyoiDg&oe=6A734474"}, {"file_name": "screenshot-4.png", "id": "203387835888992", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982530_203387839222325_6934894423169291277_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8et0qJa_DKsQ7kNvwHJnirt&_nc_oc=Ado9Qpr7nUiCdcEFLDg_T4B5txSWCA-uh82opMobnVEAj9Lu7EqhLsh7DK-VMImZCX4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE8qFk-9nG4EzznZet7LCGdVkrm3F7w7JjbTVO2kLUGuA&oe=6A7350AF"}, {"file_name": "screenshot-5.png", "id": "1271899597088655", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/86625130_1271899600421988_5037473839936376382_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Q1jDqRR_788Q7kNvwEqNUJa&_nc_oc=AdrZip3Hm_S6hzISBsWhW1XbJSgrXoNbVxhnFn6JTF6HljkC6ierhhik5Gk34JWhjbU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHinbUupCD8dXcateHYwUgtSZRle4P4HHSrIJQgzxDW7g&oe=6A731D77"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "video-thrumbnail.png", "id": "256542640244415", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75647711_256542643577748_8718635494303440535_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T0UZ-p0_ZSMQ7kNvwFYNInZ&_nc_oc=AdoiB2uc7WA--TDtY4x7BQApk-oK7e4AfeFLFmwyaz6cLOQGWgHsqhkiiW7NUQWY3Jc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH_P1F0oCitBALi8211uHg1JM0f0-IKMn9rQHVgQt4JlQ&oe=6A732EA0"}, "display_name": "Paint Fiesta", "keywords": [], "long_description": "Draw on your walls without getting in trouble! Throw on your headset and look at your hands - no controllers required (although they are supported) - your hands have all the power needed to transform your room into anything that you can imagine. Paint, stickers, rainbows, and even real world materials are at your fingertips. Spray, brush, stamp, bucket fill, and pixel paint the walls, ceilings and floors to your heart's desire.\n\nPaint Fiesta is currently early access and there are many additional features planed, based on your support.", "short_description": "Reality is your canvas! Paint on your walls, as seen through the passthrough camera, using just your hands. Let your imagination come to life as you experience the future of immersive digital content creation. This app is early access and your input can help shape its direction!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://paintfiesta.com/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Festa Tech LLC", "support_website_url": null, "website_url": "https://paintfiesta.com/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "7818006781585721"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974871_1366648700560089_5472636139232347723_n.png?stp=dst-png_s360x360&_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yKZamGXE6IoQ7kNvwG4sLwf&_nc_oc=AdotR1xC9H0u9ZnJ32uiPZd1Qtfl2izgyh1zWdvA2dHshj4DNphrnmtX4L1RK4AULWc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEgmJFulNmt0XUpIYNBPrJYj4P7l3cVQXr
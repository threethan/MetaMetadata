m/v/t64.5771-25/39031485_1490346788038084_7507991197771315481_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EIZzIoIitNEQ7kNvwGRFrTz&_nc_oc=AdpZJp47LROBgp0YQLHF5swVeCF_L2tDMHYCAfmYHbhT4vStXVk0Fv3AxRc1fSzkFzs&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6bQrQkGqbTnx9AgMGTFSo-hxOe20MRarJmi_mQZtvDXw&oe=6A0B1DF4"}, {"file_name": "screenshot-4.png", "id": "203387835888992", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982530_203387839222325_6934894423169291277_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F-TF5-ojxS4Q7kNvwF0IWFo&_nc_oc=AdquCvSlIlmBkRVX8aQbAsqXt0QvCTTf7HnEiXy_Ngk2G8KEzSqeEC6j0SY7pmqxzd4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6OzYqhSohf15C2pO0B0iUMTujaSoDzo9RwoNuEsQmOrQ&oe=6A0B2A2F"}, {"file_name": "screenshot-5.png", "id": "1271899597088655", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/86625130_1271899600421988_5037473839936376382_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ru3RteunKC4Q7kNvwHaO3JG&_nc_oc=AdobE2m_ynu-J7oHve0h0ehAgNZOUpVOY7SZz15q_4E6pMP5NIhbJ6AYYHqknAesdQ0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4UVsoKCjl_hPoeN0Xe8K6wnRCclENLHuJVlF9UlUFSUw&oe=6A0B2F37"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "video-thrumbnail.png", "id": "256542640244415", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75647711_256542643577748_8718635494303440535_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KxEhEK0qizMQ7kNvwE6nEA0&_nc_oc=AdotaIFyApwF1Q8AXXdsFOzpEzWX5q2G6-kIVmASX2dB5z8kWnPz7tHW2iFPxP-7WwY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5R75M623ds2TBdUjZs5_poP2H8UAT8-hggPDXNdq-j3Q&oe=6A0B0820"}, "display_name": "Paint Fiesta", "keywords": [], "long_description": "Draw on your walls without getting in trouble! Throw on your headset and look at your hands - no controllers required (although they are supported) - your hands have all the power needed to transform your room into anything that you can imagine. Paint, stickers, rainbows, and even real world materials are at your fingertips. Spray, brush, stamp, bucket fill, and pixel paint the walls, ceilings and floors to your heart's desire.\n\nPaint Fiesta is currently early access and there are many additional features planed, based on your support.", "short_description": "Reality is your canvas! Paint on your walls, as seen through the passthrough camera, using just your hands. Let your imagination come to life as you experience the future of immersive digital content creation. This app is early access and your input can help shape its direction!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://paintfiesta.com/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Festa Tech LLC", "support_website_url": null, "website_url": "https://paintfiesta.com/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "7818006781585721"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974871_1366648700560089_5472636139232347723_n.png?stp=dst-png_s360x360&_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y0m53Z5hWjgQ7kNvwEgM0Go&_nc_oc=AdqMDcAihBXZi-dGkiGJM7Vq0TbLwk2CxvoPNM3aCnhQXAJGg_1OCfuKPU5I9rpCu-U&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4DC0U_Q42m8Vin_e_niX2jwVKX2rLwvzN
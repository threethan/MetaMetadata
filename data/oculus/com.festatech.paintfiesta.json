0346788038084_7507991197771315481_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=COy04WqoFD8Q7kNvwEt91C1&_nc_oc=AdkJ8lqSfHnLxoV-8sHvLUv3-qVmMtoBX-b7FK8XFUhzvrySWlnUZJsrh3nMJScilMk&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=8&oh=00_AfxmUASBlka6fLdCEdz7boPF4urlaQumNUPHdptLa-ZAkw&oe=69AAE074"}, {"file_name": "screenshot-4.png", "id": "203387835888992", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/38982530_203387839222325_6934894423169291277_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F2bEovEfq-IQ7kNvwGFmksh&_nc_oc=AdkjnRyXfKiB3BG_KF4g_c2LjSkBVi2NGYoOr8UCyzGl4QKEnoNypPjNzim1jJtZYkE&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=8&oh=00_AfzKivecbwAR3ypnl8S2bnblJyHt5k_CB_94wlXpo5PzqQ&oe=69AAB46F"}, {"file_name": "screenshot-5.png", "id": "1271899597088655", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/86625130_1271899600421988_5037473839936376382_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YdYLx7mi1nMQ7kNvwF9opoo&_nc_oc=AdkzYddJKwEKPwIAwnN2tzK1nUJee9Y5t10_A2prtokAblmTFt-iMTUBOgIMSGA1V-Y&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=8&oh=00_AfzSdwjg69HNiyU6-vYXjIj0ydkDpfGXVwgthESGR14hcg&oe=69AAB977"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "video-thrumbnail.png", "id": "256542640244415", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/75647711_256542643577748_8718635494303440535_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g7-4mq6zoaoQ7kNvwEyAYva&_nc_oc=AdlTjJKWvfKCEjnHpxa-b2ojZ-jJi2c14uJRUsmQ0O99fDg3LYbB7A2XsiDacMAlhBU&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=8&oh=00_Afz7egFA0XGBDFLeXuuRYhL2W7vQv6axDYwsv0j98rsbcA&oe=69AACAA0"}, "display_name": "Paint Fiesta", "keywords": [], "long_description": "Draw on your walls without getting in trouble! Throw on your headset and look at your hands - no controllers required (although they are supported) - your hands have all the power needed to transform your room into anything that you can imagine. Paint, stickers, rainbows, and even real world materials are at your fingertips. Spray, brush, stamp, bucket fill, and pixel paint the walls, ceilings and floors to your heart's desire.\n\nPaint Fiesta is currently early access and there are many additional features planed, based on your support.", "short_description": "Reality is your canvas! Paint on your walls, as seen through the passthrough camera, using just your hands. Let your imagination come to life as you experience the future of immersive digital content creation. This app is early access and your input can help shape its direction!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://paintfiesta.com/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Festa Tech LLC", "support_website_url": null, "website_url": "https://paintfiesta.com/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "7818006781585721"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/38974871_1366648700560089_5472636139232347723_n.png?stp=dst-png_s360x360&_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sSzgqOjH6iQQ7kNvwFPgzrt&_nc_oc=AdnemlwGtAVF_2Um7IT9Wq18hlFh42hBJMqDT1O-SF3_e9N7ZnyL0OXk6Qjo3rKu-9Y&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=8&oh=00_AfwIzzWUtAhuYp3iEdIcxEpquBXlCTUGWciczfncQio3Yw&oe=69AAB71C"}, "is_concept": f
m/v/t64.5771-25/39031485_1490346788038084_7507991197771315481_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Oz5u0YVF8iIQ7kNvwFKpq2t&_nc_oc=Adr3xERFUFVMh7q-9rapfr9KR2sbCIBjjUvVABVxVsD-av5YLADNYlxgBodREhbtXsk&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8zlCDMZrFoCOAEcBD_nw80r3H9c9L8HH7xLPcn8Lb35w&oe=6A242A74"}, {"file_name": "screenshot-4.png", "id": "203387835888992", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38982530_203387839222325_6934894423169291277_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Nw2UL3mlytwQ7kNvwExri5l&_nc_oc=Adp0wyFRxwieBw6W4qBjra4x4753W7s19LvbcWJAwcxKUz67VUQ8jJxvHTyuaiQxBAI&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_EZOrtXt_Ty6sulkrjbPcvg34CUO6NI1CQQcaUH9_xyw&oe=6A2436AF"}, {"file_name": "screenshot-5.png", "id": "1271899597088655", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/86625130_1271899600421988_5037473839936376382_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WHonccW-AGQQ7kNvwGUT6MN&_nc_oc=Adp_4QLCv3Verl2g-SFW7xgKbYjLVOFq1nIAl-jVp-MVITKt-WDw4Wc1UyDyakaqKg0&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_EwWHWe8aUVy2ToYm7Pv71Jj8mdcDp1MejIpBQwGWWiw&oe=6A243BB7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "video-thrumbnail.png", "id": "256542640244415", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/75647711_256542643577748_8718635494303440535_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dsFy5Gpa15AQ7kNvwE_NJk3&_nc_oc=AdrK2tE2ygMaLy89LgHChpQUVsoNsUuzalrXE6f43_1vKStitUAy1X4aL1OQMKNZjfg&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af96U1dOwrGf2ZpO49K7e7rVjc6WwqxhiRh_-cAK5agjkA&oe=6A2414A0"}, "display_name": "Paint Fiesta", "keywords": [], "long_description": "Draw on your walls without getting in trouble! Throw on your headset and look at your hands - no controllers required (although they are supported) - your hands have all the power needed to transform your room into anything that you can imagine. Paint, stickers, rainbows, and even real world materials are at your fingertips. Spray, brush, stamp, bucket fill, and pixel paint the walls, ceilings and floors to your heart's desire.\n\nPaint Fiesta is currently early access and there are many additional features planed, based on your support.", "short_description": "Reality is your canvas! Paint on your walls, as seen through the passthrough camera, using just your hands. Let your imagination come to life as you experience the future of immersive digital content creation. This app is early access and your input can help shape its direction!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://paintfiesta.com/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Festa Tech LLC", "support_website_url": null, "website_url": "https://paintfiesta.com/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "7818006781585721"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974871_1366648700560089_5472636139232347723_n.png?stp=dst-png_s360x360&_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5n3sZ0WuRbwQ7kNvwGPLhcv&_nc_oc=AdpO8uhgvXh1dmK1Kj69VOQf94IDWoQgoHGdKHTBolLv73YMZbOK60HPeJ-mLOYYg5w&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af87S8s8or61Lv4sE7gg1fDmBgxgayTY-On
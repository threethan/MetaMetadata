m/v/t64.5771-25/39031485_1490346788038084_7507991197771315481_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zMRE1Ql8UMkQ7kNvwHnlExR&_nc_oc=Adqtv7bLLOZYUFyb5soe057DMdJ82rUfmIR8TkGz8GubOGSt9vcTgC0C_3R-gizH2vk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIcAGswYG71uIveEaYkxKwcxlNvs2AO655aEJI8RJCDNw&oe=6AB3DDF4"}, {"file_name": "screenshot-4.png", "id": "203387835888992", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982530_203387839222325_6934894423169291277_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6PRF_XMSAHEQ7kNvwGQED3O&_nc_oc=Adrv5rK2-KzyaNk_OZ471py2rQkQD7zwhTMKwEvZ2ej44WRAy8H8oMBYdL30-IbL4Jc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIR7_rrVQ56Zog95LwRwCOgi7b3l-DpvBOW5t1nQAu1zQ&oe=6AB3EA2F"}, {"file_name": "screenshot-5.png", "id": "1271899597088655", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/86625130_1271899600421988_5037473839936376382_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XJjG8zczznMQ7kNvwHnqADD&_nc_oc=Adr3jmDmR2DE6gZ-1vFOeK7CvFkFfqUaNN1G6aU0klfLFCzLPqxtLVmrHOMqkIhS-2M&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL_LgIw-0r7e4AHKDGJDRywhQ3G2Dgb8nvPqRbraD39Yw&oe=6AB3EF37"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "video-thrumbnail.png", "id": "256542640244415", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75647711_256542643577748_8718635494303440535_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fqUaH97E_7MQ7kNvwG7YENs&_nc_oc=AdromhQqB7Tp1RV0vIYJl_VsoMGlwV91deMVnXSFtuEesV3YNchJT4vzS5MBNd7RHJk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJxnll9vV1JqsVfGTIYcQVUrvJplMmYWBX6uEaeL2IoWQ&oe=6AB3C820"}, "display_name": "Paint Fiesta", "keywords": [], "long_description": "Draw on your walls without getting in trouble! Throw on your headset and look at your hands - no controllers required (although they are supported) - your hands have all the power needed to transform your room into anything that you can imagine. Paint, stickers, rainbows, and even real world materials are at your fingertips. Spray, brush, stamp, bucket fill, and pixel paint the walls, ceilings and floors to your heart's desire.\n\nPaint Fiesta is currently early access and there are many additional features planed, based on your support.", "short_description": "Reality is your canvas! Paint on your walls, as seen through the passthrough camera, using just your hands. Let your imagination come to life as you experience the future of immersive digital content creation. This app is early access and your input can help shape its direction!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://paintfiesta.com/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Festa Tech LLC", "support_website_url": null, "website_url": "https://paintfiesta.com/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "7818006781585721"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974871_1366648700560089_5472636139232347723_n.png?stp=dst-png_s360x360&_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vmge0pooIHQQ7kNvwHAJNfs&_nc_oc=AdqUo74Fc1BymqPAaQXptpaPJJcUzoH_QNq75ZkXVbp8sFo4W1FaESaoKsZfXKqfRsM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLPARvGiSvDZP8q8WW3MgzzD38o7FlZCVB
m/v/t64.5771-25/39031485_1490346788038084_7507991197771315481_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9E1s3NIIBxIQ7kNvwEHVR5H&_nc_oc=AdrYXsV80pK72zCWXTRkvpOBkEGRuq0CWugOz9w0IyOSqhQAt_woz1bUmdq89-E41wc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIxNlcOS44j3vxTO8ZjFZnY-w3LtSz6Wn2vonNqb7gOdA&oe=6AABF4F4"}, {"file_name": "screenshot-4.png", "id": "203387835888992", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982530_203387839222325_6934894423169291277_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=afc3sypwgxIQ7kNvwGw2qNW&_nc_oc=Adq_OoQ7MjFx-lI3PdrEQRSNnmkbiZABiOFIDv3rJuNCEis3JtrhbxAFrrg_ZTvQ6yY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKD2fNxlkU3r-2nPE3Zikock2wjpIJGjScOo7hdktr5yQ&oe=6AAC012F"}, {"file_name": "screenshot-5.png", "id": "1271899597088655", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/86625130_1271899600421988_5037473839936376382_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mVESNb6a25QQ7kNvwF3q_lx&_nc_oc=AdrvktgIBjO1VZJTMBOFVFh3wnNYE5Ynez80S_00nkE1Mmh2iTTgB5Wxo_Rwx19lQJc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKL8IDkOvkygyPf2LULN7Ku-WPaGrQWnUAKnVlo6Z-wiA&oe=6AAC0637"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "video-thrumbnail.png", "id": "256542640244415", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75647711_256542643577748_8718635494303440535_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PX8Qnz5pQ-gQ7kNvwEymgtR&_nc_oc=AdqMwF_0RMThmIjNgENEFysBx5GuPGyMukHHJsAci9RnuFePhJ1dhZJKu7jP-gzUly8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ5Lr-eeffKCRWw68l7wNq9bcr5dsEcNUGwijINsRmCmA&oe=6AABDF20"}, "display_name": "Paint Fiesta", "keywords": [], "long_description": "Draw on your walls without getting in trouble! Throw on your headset and look at your hands - no controllers required (although they are supported) - your hands have all the power needed to transform your room into anything that you can imagine. Paint, stickers, rainbows, and even real world materials are at your fingertips. Spray, brush, stamp, bucket fill, and pixel paint the walls, ceilings and floors to your heart's desire.\n\nPaint Fiesta is currently early access and there are many additional features planed, based on your support.", "short_description": "Reality is your canvas! Paint on your walls, as seen through the passthrough camera, using just your hands. Let your imagination come to life as you experience the future of immersive digital content creation. This app is early access and your input can help shape its direction!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://paintfiesta.com/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Festa Tech LLC", "support_website_url": null, "website_url": "https://paintfiesta.com/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "7818006781585721"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974871_1366648700560089_5472636139232347723_n.png?stp=dst-png_s360x360&_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gPVHOS1rnGQQ7kNvwGwr3Xg&_nc_oc=AdrVyRUXAYcSbbAbBGNwwHqxQdboPfQ8lqj6YQLUHx7ZIDPeBTuGgUD9hfqAVDSf-tE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLIRH0TAVGXAjhZ_bOgauuv3i47KJowaT3
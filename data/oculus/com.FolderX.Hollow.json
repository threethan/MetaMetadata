7&_nc_sid=6e7a0a&_nc_ohc=0eAMpKow8nUQ7kNvwHnOC4V&_nc_oc=AdrWSo5U8aeo_pu7euqdT0TEXte8QNe1E8M0-IoOud94aU23BUa2PaJHZISclMzjEGw&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNx0kojgGdCPwy-ykGsm2zGdeRLnrFeeDTQHGDnEwcAfw&oe=6AE0B0F3"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Scary monke horror", "keywords": ["scary", "horror", "tag", "monke", "gorilla"], "long_description": "Step into the paws of a gorilla and crawl through dark, twisting air ducts in search of scrap and forgotten garbage. The deeper you go, the more you will find and the more dangerous it becomes.\n\nHunt with your friends or go it alone as you scavenge, burn, and upgrade your gear. Customize your gorilla with cosmetics, improve your tools, and watch your stash grow.\n\nEvery run is tense, every corner holds something unexpected, and every decision matters. Work together, compete for resources, or just cause chaos in the ducts. Survival is messy, rewarding, and never the same twice.", "short_description": "Scavenge. Incinerate. Survive."}]}, "developer_name": "FolderX", "developer_privacy_policy_url": "https://www.folderx.studio/privacy-policy", "developer_terms_of_service_url": "https://www.folderx.studio/terms-of-service", "publisher_name": "FolderX", "support_website_url": "https://www.folderx.studio/contact", "website_url": "https://www.folderx.studio/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "644354873106712"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes"
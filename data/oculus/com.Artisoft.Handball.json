FiqSyvg&oe=6A3FCB50"}, {"file_name": "sc4.png", "id": "1778143396304572", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473393195_1778143399637905_71706981749229773_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fRiNj9PIb6AQ7kNvwEssfOr&_nc_oc=AdqtKcqXxMiuvUgTjbojiN-PtJzECTOnkKrivTPLi5QxfKnIAzQHBMtXb0rbpgMJEZQ&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9lb1spGoa-G_tlhtxV0Gis_LV_y1l0mDVup5Ms3r7ATQ&oe=6A3FC393"}, {"file_name": "sc5.png", "id": "623207280347042", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473393688_623207283680375_5410828332966287806_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OOqRZhdC9G0Q7kNvwFcJeAy&_nc_oc=AdqYrz5u625e_2_QT9TI8rQqKJpZyA_tgz_O7-45k1c96NeHU2BSz3-nfJ-yOMofSvw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-AQE0iA9DUxcP-JwWwXfeiVr9JtMpq-O7tkWFjVFhg8g&oe=6A3FC3D9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440 bas(1).png", "id": "600881659598219", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473391837_600881662931552_4021032978577639936_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x8RW1GzDOOkQ7kNvwFChBog&_nc_oc=Adq6meAljPMAL0t2E9Y_EPv-UW-ROT1SqfAREkzyDr3WpTxTeyxaH1WWEstVVI_QqPo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_2qLATh1JKzRn7Jm5IpAmEyE9U60seP1UmhGhyKrX2-Q&oe=6A3FD063"}, "display_name": "Handball Thrill", "keywords": ["handball", "basketball", "football", "soccer", "baseball"], "long_description": "**Immerse Yourself in Virtual Handball: A Casual, Accessible Experience. No internet connection required.**\n\n**Engage in exhilarating competition or refine your skills in a serene environment.** This innovative VR handball simulation caters to players, fostering an inclusive and enjoyable experience. Build your team and start playing today.\n\n**Unparalleled Comfort:** Optimized movement mechanics minimize the potential for VR-induced discomfort. Adjustable difficulty allows you to tailor the pace to your preference, ensuring a smooth and immersive gameplay experience.\n\n**Tailored Gameplay:** Hone your technique in training modules or challenge yourself in dynamic 7v7 matches. If you love basketball or football (soccer) then you will love handball.\n\n**Freedom on the Court:**  Embrace a gameplay style that suits you.  This simulation prioritizes enjoyment over rigid rules, empowering you to define your own handball journey.\n\n**Prepare for Victory:**  Before entering the virtual court, we recommend familiarizing yourself with our comprehensive Tips & Tricks and Tutorial resources.\n\n**Embrace the Future of Handball: Immerse yourself today!**\n\n**DISCLAIMER**\n\n- Game prioritizes enjoyment over rigid rules and we value user voice. You can suggest improvements in our Discord channel or discuss settings\n- Look into settings if something is too easy or difficult", "short_description": "Step onto the handball court in VR and dominate the game! Experience thrilling 7v7 matches or refine your skills in training. With adjustable difficulty and movement settings, every match is tailored to your style. Play as a field player or step into the goal for intense action. It's your court, your rules \u2013 the ultimate handball experience awaits!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://artisoft.pl/policies/ht_v1.html", "developer_terms_of_service_url": null, "publisher_name": "Artisoft", "support_website_url": "https://handball.artisoft.pl/support.html", "website_url": "https://handball.artisoft.pl/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics
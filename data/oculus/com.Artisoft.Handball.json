0_4476043883057501834_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nbYgXt3YQ9oQ7kNvwFeIPcF&_nc_oc=AdroYXeifauVk7T5SDTMZ5pVU6U9bNzoDnk7VI-e8kkLp65MrRqKqqCjn8ENBg6grBE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8VFi3bajW0V4kU3CgRgmqwdrhLiH1RZGMNrHbv9e8WVg&oe=6A3FF272"}, {"file_name": "sc5.png", "id": "1581355933150987", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491823351_1581355936484320_3691472641947998222_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jBy-8pwiCLQQ7kNvwEC5fXz&_nc_oc=AdoV3FkqrKJrk-_kW-M6y0ZocICy19XtYyrhFO2bJPp4bni4yjNJGicA_Hlergm28b0&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-_0ydgSSX8W_m7o0GJ_evKuDvDk-Km9fk84l5qeu3hlg&oe=6A3FE456"}, {"file_name": "sc3.png", "id": "1176303094204448", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473393188_1176303097537781_3914224270669347590_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EgVAIEZ_x00Q7kNvwFfehUH&_nc_oc=AdoWCX2RIkC612wVKLfZgKxgPTJFSA4FrXoSjtllTY5T_PeEbRXWk1LqIjSA289RKFA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8lMKnA3dyycKHEvUjahXyDVzc8x5S1ja6-2P2FiqSyvg&oe=6A3FCB50"}, {"file_name": "sc2.png", "id": "1425869748677133", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/507823854_1425869752010466_7335698731169056883_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nSHmMmidmQAQ7kNvwFm9PPu&_nc_oc=AdpkGIazrPy1dziIYrVjqhk-Gg9VrMMQ488u90EA_f4ViaeQ4BMNLIDYvuoPmKp9Uk4&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9ZvSI5NhIMVCU97oynRZIshGjgWv1NLC8lx94WGEEWPg&oe=6A3FBFEE"}, {"file_name": "sc4.png", "id": "1778143396304572", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473393195_1778143399637905_71706981749229773_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fRiNj9PIb6AQ7kNvwEssfOr&_nc_oc=AdqtKcqXxMiuvUgTjbojiN-PtJzECTOnkKrivTPLi5QxfKnIAzQHBMtXb0rbpgMJEZQ&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9lb1spGoa-G_tlhtxV0Gis_LV_y1l0mDVup5Ms3r7ATQ&oe=6A3FC393"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440 bas(1).png", "id": "600881659598219", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473391837_600881662931552_4021032978577639936_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x8RW1GzDOOkQ7kNvwFChBog&_nc_oc=Adq6meAljPMAL0t2E9Y_EPv-UW-ROT1SqfAREkzyDr3WpTxTeyxaH1WWEstVVI_QqPo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_2qLATh1JKzRn7Jm5IpAmEyE9U60seP1UmhGhyKrX2-Q&oe=6A3FD063"}, "display_name": "Handball Thrill", "keywords": ["handball", "goalkeeper", "reflex", "goal"], "long_description": "\ud83e\udd3e **The Ultimate VR Handball Experience**\n\nStep onto the court and take full control of your team in a fast-paced, immersive VR handball experience. Play completely offline, master your skills, customize every detail, and lead your squad to victory.\n\nWhether you want competitive league action or arcade-style fun, Handball Thrill delivers intense gameplay, full team management, and total control in virtual reality.\n\n---\n\n\ud83d\udd25 **Game Modes**\n\n- **Quick Match** \u2013 Jump straight into action by selecting home and visiting teams  \n- **League** \u2013 Compete across a season and win prestigious trophies  \n- **Tournament** \u2013 Face selected teams and fight for championship glory  \n- **Training** \u2013 Practice dribbling, throwing, movement, and goalkeeping at your own pace  \n- **Ball Smasher** \u2013 A fast, action-packed arcade mini-game  \n\n---\n\n\ud83c\udfae **Deep Gameplay & Customization**\n\n- Full **team and player management** - edit outfits, logos, team names, player names, body types, faces, and hairstyles  \n- Customize **all 50 teams** in the game \u2014 create dream matchups  \n- Extensive **gameplay settings** to tailor the experience your way  \n- Add **fun hats** and visual flair to players  \n- Choose between **manual or automatic dribbling**  \n- Activate **slow motion** for dramatic moments  \n- Dynamic **commentary**, explosive **fire balls**, and flashy **score effects**  \n\n---\n\n\ud83c\udfc6 **Progress & Achievements**\n\n- Unlock **20+ achievements** with stylish collectible badges  \n\n---\n\n\ud83c\udf0d **Locations**\n\n- **Arena** \u2013 Classic indoor stadium atmosphere for major matches  \n- **City Court** \u2013 Outdoor games with optional rain effects  ", "short_description": "Take full control of your team in Handball Thrill, an immersive VR handball experience you can play completely offline. Jump into quick matches, compete in leagues and tournaments, train your throwing and goalkeeping skills, or enjoy arcade-style action. Customize your players, manage all 50 teams, unlock achievements, and experience dynamic gameplay with slow motion, commentary, fire balls, and score effects. Lead your team to victory and feel the thrill on the court."}]}, "developer_name": null, "developer_privacy_policy_url": "https://artisoft.pl/policies/ht_v1.html", "developer_terms_of_service_url": null, "publisher_name": "Artisoft", "support_website_url": "https://handball.artisoft.pl/support.html", "website_url": "https://handball.artisoft.pl/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "459781504968480"}, {"id": "331529188132278"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26020025280943624"}, "review_messages": []}]}, "cover_square_image":
a0a&_nc_ohc=RccMo8j7-RwQ7kNvwF0fhMP&_nc_oc=AdoEsj-e_35yugmPgvFKOhzxGR-zswAo17ihT3FDBQ4nq1Dws456i70-4PFJvVKPpm8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIHYuduWvRP5nVA1PKRfZBn8PGkD50nd4m2m9HJDI4gCQ&oe=6A9D5E13"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscaoe.png", "id": "1659507709034199", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491825257_1659507715700865_3440877122692244920_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gXhhE_Kx3v4Q7kNvwF06_Gx&_nc_oc=AdqrCS8UuC2BGoiNrM72fLvs1dxzbLixzyk1ESasRK4pxfqQbIN29NAC3AeDhcCU-c4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKtQZXWlcRdhhXwc0TJ4pbmTQk4lgRMQDy9Xr2d0dy-_g&oe=6A9D78DA"}, "display_name": "Handball Thrill", "keywords": ["handball", "goalkeeper", "reflex", "goal"], "long_description": "\ud83e\udd3e **The Ultimate VR Handball Experience**\n\nStep onto the court and take full control of your team in a fast-paced, immersive VR handball experience. Play completely offline, master your skills, customize every detail, and lead your squad to victory.\n\n\ud83c\udfc6 **LIVE THROUGH HANDBALL HISTORY \u2014 PAST AND FUTURE!**\n\nRelive real tournaments starting with the **2007 World Cup**, or jump ahead and play events that haven't happened yet, like the **2027 Handball World Cup**\u2014 real teams, real groups, before the world sees them!\n\n\ud83d\udd25 **Game Modes**\n\n- **Quick Match** \u2013 Jump straight into action by selecting home and visiting teams  \n- **League** \u2013 Compete across a season and win prestigious trophies  \n- **Tournament** \u2013 Face selected teams and fight for championship glory  \n- **Training** \u2013 Practice dribbling, throwing, movement, and goalkeeping at your own pace  \n- **Real-World Tournaments** \u2013 Play through actual tournaments like World Cups and other major competitions, starting in 2007 \u2014 and get ahead of the game with future events like the 2027 World Cup before they're even played!\n\n\ud83c\udfc6 **Progress & Achievements**\n- Unlock **20+ achievements** with stylish collectible badges  \n\n\ud83c\udf0d **Locations**\n\n- **Arena** \u2013 Classic indoor stadium atmosphere for major matches  \n- **City Court** \u2013 Outdoor games with optional rain effects  \n\n**Note:** Due to licensing restrictions, player names used in the game are fictitious and do not represent real athletes.", "short_description": "Take full control of your team in Handball Thrill, an immersive VR handball experience you can play completely offline. Jump into quick matches, compete in leagues and tournaments (including real-world), train your throwing and goalkeeping skills, or enjoy arcade-style action. Customize your players, unlock achievements, and experience dynamic gameplay with slow motion, commentary, fire balls, and score effects. Lead your team to victory and feel the thrill on the court."}]}, "developer_name": null, "developer_privacy_policy_url": "https://artisoft.pl/policies/ht_v1.html", "developer_terms_of_service_url": null, "publisher_name": "Artisoft", "support_website_url": "https://handball.artisoft.pl/support.html", "website_url": "https://handball.artisoft.pl/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "459781504968480"}, {"id": "331529188132278"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "28190334753912655"}, "review_messa
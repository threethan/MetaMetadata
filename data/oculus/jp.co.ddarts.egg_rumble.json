57_695411926206846_5597374202719421701_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5qLnjqSOvHcQ7kNvwFt0NhB&_nc_oc=AdrB06LEwY3b-ja9B31EJ76FT8Zl4JzvP4goIAt8JDzfUrEl-uwer3XkTYp1JuvoAdA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af13rEW-H1VuTcDgtqrQHooOCZXl4M1PmQ9IGOcJNWJs6Q&oe=69DCE7C0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_landscape.png", "id": "1185343359802583", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473394196_1185343363135916_772303995862070572_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ecLq_1YUrZcQ7kNvwFTta8e&_nc_oc=Adr1ajYjIxT03gMscjrpA2R3s2u0GoVwF7laa5Sl2emuDy9E2NAPeqpiuEKZLzO_lxg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0hnNVN6Eeuiw2aksivToTCgF_LOXGaxxbkItuvmArxsA&oe=69DCE01D"}, "display_name": "Egg Rumble", "keywords": ["Puzzle", "Multiplayer", "Casual"], "long_description": "# Description\n\nRolling eggs, overflowing monsters! Dive into the fast-paced puzzle action of \"Egg Rumble\"\u2014fun for everyone!\n\nEgg Rumble is a casual versus puzzle game with simple, intuitive controls. Match four eggs of the same pattern to hatch monsters. Your monsters push the flag into your opponent\u2019s base, but your rival will hatch their own monsters to push back! Every match is a dynamic and thrilling tug-of-war.\n\nEach egg pattern creates a unique monster, and combos unleash even stronger monsters! Outsmart your opponent with strategy and enjoy exciting real-time battles.\n\nGames are quick and easy, perfect for a short break or playing with friends. Battle online against friends or players worldwide.\n\nExperience a new style of puzzle action, where easy controls and lively battles make every game fresh and fun!\n\n# Key Features\n\n- Simple controls anyone can enjoy\n- Unique monsters with special abilities\n- Stronger monsters through combo chains\n- Online battles with friends and global players\n- Short, fast-paced matches\n- Colorful graphics and cheerful sounds\n\n# About Early Access\n\nEgg Rumble is available as an Early Access release.\nWe are updating the game to improve balance, fix bugs, and enhance the experience. Feedback is welcome, though we may not respond to every request.\nThank you for supporting Egg Rumble as we continue development!\n", "short_description": "Rolling eggs, overflowing monsters! A frantic puzzle game anyone can enjoy!  \nMatch four eggs to hatch monsters and push the flag into your opponent\u2019s base!\n\nEgg Rumble is a casual, easy-to-play puzzle game. Match four eggs of the same pattern to hatch monsters that push the flag forward, while your opponent tries to push back! Different egg patterns create unique monsters, and combos make them even stronger.\n\nPerfect for a quick break or a fun match with friends!\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.hatchpotvr.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "https://share.hsforms.com/1o1_VrrjtQw6PFKmxZ_n3awccliw", "support_website_url": null, "website_url": "https://www.ddarts.co.jp/egg_rumble", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "1700921480735423"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ja"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "29992832660315068"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PUBLISHED", "id": "693419670277527"}, {"status": "PUBLISHED", "id": "8209370312520850"}]}, "baseline_offer": {"id": 
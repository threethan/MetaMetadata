.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSXKGaP35DNsgqDVzv5Cc4Gt88_WqItoDLn7-DUzPPIZg&oe=6B084DA6"}, {"file_name": "mathstarvr_screenshot_t43.png", "id": "1568369594761550", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/491830576_1568369598094883_7655560659407911836_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sl8Cuj6KiAcQ7kNvwHMMkag&_nc_oc=AdrlR8wzw5adJ8yWAjQSbL48fdt8jRVZMjV4mGmudndaux2bkfHrRtxRalEI2YCA7bA&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTLH3Ui65pBYQ6kOnfPxQQC4r-HhAqw7LPFgmyntd6c3w&oe=6B086524"}, {"file_name": "mathstarvr_screenshot_t50.png", "id": "1428276405834494", "uri": "https://scontent-dfw5-3.oculuscdn.com/v/t64.5771-25/673716021_1428276409167827_8509181504050287336_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kWeMcM5q9XwQ7kNvwH73Cye&_nc_oc=AdqPnovZ7GpeVFNV3-UZXl_soXHVFCRtr9I_Fo_OmvLYg6U77jZWswO-uCzXPLMQ7LA&_nc_zt=3&_nc_ht=scontent-dfw5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQdGx31oPzOiGCQ39x0998qUTi96jaztpyYcJ3pxK4yBA&oe=6B083D86"}, {"file_name": "mathstarvr_screenshot_t34.png", "id": "1097002509436459", "uri": "https://scontent-dfw5-3.oculuscdn.com/v/t64.5771-25/673525341_1097002512769792_1697302956376564066_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XMyUkLsnx2wQ7kNvwG1PT_D&_nc_oc=Ado74viwbhNu7gf05jlIS_C9Ow20u9Vg76_liqJB1Qj_N2dRsNsoPSW8S8mXPbHJIS0&_nc_zt=3&_nc_ht=scontent-dfw5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ2UDBxNhlGpHXDV19iO_JDdJVqk_vcJVqKt68f3PRPxQ&oe=6B0854F6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "mathstarvr_screenshot_t50.png", "id": "3183987471794894", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/491831569_3183987475128227_2918180018398440237_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tAM_AN8mjS0Q7kNvwGAIhJg&_nc_oc=AdrNY6vtewlETHchktNTluYTq6NnLzKLUm_aYAbLwC9T-x1bHF8m6ipL_XOUU5UaeVc&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTqOWZmkZkYrExCksGTAsLMsAoS_vqzPj1ui-b0HKV-hA&oe=6B085FD8"}, "display_name": "MathStarVR", "keywords": [], "long_description": "MathStarVR reimagines math as something you do with your hands, not just your head.\n\nDive into an underwater world where equations float in front of you as physical objects. Using natural hand gestures, no controllers required, you raise, squash, expand, and rearrange terms to solve for the unknown. Every gesture mirrors a real arithmetic or algebraic operation, so the math you're doing with your hands is the same math you'd write on paper, just made visible.\n\nBuilt for students and the adults who wished algebra felt like this the first time. Designed for classrooms, libraries, and anyone who's ever frozen up at the sight of x.\n\nNo accounts. No ads. No data collected. Just equations, your hands, and the ocean.", "short_description": "Solve arithmetic and algebra with your hands, underwater. MathStarVR turns equations into physical puzzles you raise, squash, expand, and rearrange through natural hand gestures, no controllers needed. The math you write on paper, made visible and physical."}]}, "developer_name": null, "developer_privacy_policy_url": "https://shepherdxr.org/mathstarvr-privacy.html", "developer_terms_of_service_url": null, "publisher_name": "ShepherdXR", "support_website_url": "https://shepherdxr.org/contact", "website_url": "https://shepherdxr.org/mathstar", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["SITTIN
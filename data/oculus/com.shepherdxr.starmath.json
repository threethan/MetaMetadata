09181504050287336_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IuK0-WwJSwMQ7kNvwER6ovD&_nc_oc=Adqi8N5ShR-Ig0TGfxe3S-iU4DoUWDRXGM92OJdzeFNhIg6R-F6a6gn1zVzHfkSMVys&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQub2jDKcNfQCw0Sy-_X2r-SxHl8L3thm1TvH8GLvi21A&oe=6AE9EB06"}, {"file_name": "mathstarvr_screenshot_t34.png", "id": "1097002509436459", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/673525341_1097002512769792_1697302956376564066_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UikdZWDPK4wQ7kNvwFy0uFt&_nc_oc=Ado_nIqDM1RFTBjdu8lyTs3vx7TOkAfIi--vnGVxbn266jLGLzrwmHHAgXgRGcZdS7M&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTxptMsRChUXaXsYujUNFVG--JWdQNYnz37nejTqOSLmQ&oe=6AEA0276"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "mathstarvr_screenshot_t50.png", "id": "3183987471794894", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491831569_3183987475128227_2918180018398440237_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KxuYmS_2A5QQ7kNvwH7-keO&_nc_oc=Adof7_3coyvbpesLajXQYCjU6BABu1S9UEg5-qhzKNFQnJtI1UxaNh0WLR43I4JMTDE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQc675kzlAPk004EJLttffi9_HoABwlTgrPIuWbxR3hUg&oe=6AEA0D58"}, "display_name": "MathStarVR", "keywords": [], "long_description": "MathStarVR reimagines math as something you do with your hands, not just your head.\n\nDive into an underwater world where equations float in front of you as physical objects. Using natural hand gestures, no controllers required, you raise, squash, expand, and rearrange terms to solve for the unknown. Every gesture mirrors a real arithmetic or algebraic operation, so the math you're doing with your hands is the same math you'd write on paper, just made visible.\n\nBuilt for students and the adults who wished algebra felt like this the first time. Designed for classrooms, libraries, and anyone who's ever frozen up at the sight of x.\n\nNo accounts. No ads. No data collected. Just equations, your hands, and the ocean.", "short_description": "Solve arithmetic and algebra with your hands, underwater. MathStarVR turns equations into physical puzzles you raise, squash, expand, and rearrange through natural hand gestures, no controllers needed. The math you write on paper, made visible and physical."}]}, "developer_name": null, "developer_privacy_policy_url": "https://shepherdxr.org/mathstarvr-privacy.html", "developer_terms_of_service_url": null, "publisher_name": "ShepherdXR", "support_website_url": "https://shepherdxr.org/contact", "website_url": "https://shepherdxr.org/mathstar", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26537623372534436"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/604385997_1393207735576736_529944752238026899_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gyuVF_PIdl0Q7kNvwGvFiaQ&_nc_oc=Ado1WFYHz1g2924Oa1zxuBNQC4_KLtXy5xcxi_EruOeF0s8Qy4oQUdIAhrqtvOP2ks8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ7xY_Jkq6nLL7-JbZFU3xsGYAHM_ZVbUbryAMQkI4lcw&oe=6AE9E333"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "MathStarVR", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_name": "Learning
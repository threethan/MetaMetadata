09181504050287336_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kQ4CohoI930Q7kNvwE8U_Ga&_nc_oc=AdrP0TlZTbrtMvTCo_LShXdUp0cdI9Z9ASBtuXxa8pDIWHF2jcdUUCqMPIfXTBMVxQM&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQuWsZEcsM0hNaBiOBR8KS8j7urb3EDPKxdL259JBwHYw&oe=6AF08286"}, {"file_name": "mathstarvr_screenshot_t34.png", "id": "1097002509436459", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/673525341_1097002512769792_1697302956376564066_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NYmdHcROnkcQ7kNvwHjqFUW&_nc_oc=AdrjMMLM8XJubbdcKNnYvbQ1_vXFt5ZZ4TiP9FpZOFZbqRF63eChHgqHBjYSWtCqGMw&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ3QsmA45VeTOBCgGV2rCNMyixnJIvgup2t56R1tSwjdg&oe=6AF099F6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "mathstarvr_screenshot_t50.png", "id": "3183987471794894", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491831569_3183987475128227_2918180018398440237_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ku3hviTvKA4Q7kNvwEjeW0X&_nc_oc=AdrAdh_D47yrbgW0esAJtlrjTDJA_X9ibleYR6XuWSsB5YnSds8pVk5Pjhvus0REBek&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQrTFXxW8DHgOmQMCqWl6dN3OJjU8WEFnTF8UZ5JKerqg&oe=6AF0A4D8"}, "display_name": "MathStarVR", "keywords": [], "long_description": "MathStarVR reimagines math as something you do with your hands, not just your head.\n\nDive into an underwater world where equations float in front of you as physical objects. Using natural hand gestures, no controllers required, you raise, squash, expand, and rearrange terms to solve for the unknown. Every gesture mirrors a real arithmetic or algebraic operation, so the math you're doing with your hands is the same math you'd write on paper, just made visible.\n\nBuilt for students and the adults who wished algebra felt like this the first time. Designed for classrooms, libraries, and anyone who's ever frozen up at the sight of x.\n\nNo accounts. No ads. No data collected. Just equations, your hands, and the ocean.", "short_description": "Solve arithmetic and algebra with your hands, underwater. MathStarVR turns equations into physical puzzles you raise, squash, expand, and rearrange through natural hand gestures, no controllers needed. The math you write on paper, made visible and physical."}]}, "developer_name": null, "developer_privacy_policy_url": "https://shepherdxr.org/mathstarvr-privacy.html", "developer_terms_of_service_url": null, "publisher_name": "ShepherdXR", "support_website_url": "https://shepherdxr.org/contact", "website_url": "https://shepherdxr.org/mathstar", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26537623372534436"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/604385997_1393207735576736_529944752238026899_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j_TngNhDWGoQ7kNvwFmR7Hq&_nc_oc=AdpDJ8yfvakXpDz-y6LhnMctQbS7Am5lnjHBEiWpdHyd9ARX9bPZgNKWZl1BD3K9ac8&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRaRr_Z6F7h7wSIJ_4fZ8teMdFyWOjukYGO6pe904gt8Q&oe=6AF0B2F3"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "MathStarVR", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_name": "Learning
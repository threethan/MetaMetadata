09181504050287336_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pOJ59OsWNN4Q7kNvwEAGVku&_nc_oc=AdrhnruJWTjtOritn2bTL8FpFVRtvczxYAANj9RIcx6FrCX6jTNyPV24_bwXvGDjm4o&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSl2-eudnGdKbSWUQFyPC-d0YK-ihsB8XvqF74uZBLKOg&oe=6AF71A06"}, {"file_name": "mathstarvr_screenshot_t34.png", "id": "1097002509436459", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/673525341_1097002512769792_1697302956376564066_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Vk13suxC6JAQ7kNvwG7tSVI&_nc_oc=Adq1U4vl6KoF3oIaeCaArcaeK3R2a-H3ek55ysBFL2u78NuNTCoLzpuVvQM7wwLXesM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTHd8szM1W3EFiKeYZGBobfvWL7GgCTs86-EO_GrL-Kqg&oe=6AF73176"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "mathstarvr_screenshot_t50.png", "id": "3183987471794894", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491831569_3183987475128227_2918180018398440237_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sbR12KgMJc0Q7kNvwF2VbDx&_nc_oc=AdqDItK68i8LL84699Z02gfsY823SBKHgIcXqVf1xLIbXj823VAauLtSjnMGCFqbofg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTrySApDpv9gOOaJ3n9MTi77Gvos4yWq8wzJs8Pp7V4Og&oe=6AF73C58"}, "display_name": "MathStarVR", "keywords": [], "long_description": "MathStarVR reimagines math as something you do with your hands, not just your head.\n\nDive into an underwater world where equations float in front of you as physical objects. Using natural hand gestures, no controllers required, you raise, squash, expand, and rearrange terms to solve for the unknown. Every gesture mirrors a real arithmetic or algebraic operation, so the math you're doing with your hands is the same math you'd write on paper, just made visible.\n\nBuilt for students and the adults who wished algebra felt like this the first time. Designed for classrooms, libraries, and anyone who's ever frozen up at the sight of x.\n\nNo accounts. No ads. No data collected. Just equations, your hands, and the ocean.", "short_description": "Solve arithmetic and algebra with your hands, underwater. MathStarVR turns equations into physical puzzles you raise, squash, expand, and rearrange through natural hand gestures, no controllers needed. The math you write on paper, made visible and physical."}]}, "developer_name": null, "developer_privacy_policy_url": "https://shepherdxr.org/mathstarvr-privacy.html", "developer_terms_of_service_url": null, "publisher_name": "ShepherdXR", "support_website_url": "https://shepherdxr.org/contact", "website_url": "https://shepherdxr.org/mathstar", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26537623372534436"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/604385997_1393207735576736_529944752238026899_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jGWWyVFIcGUQ7kNvwHNQoRq&_nc_oc=AdrCe92xpNOVveSc3qTMV5aM6JXTZp6flaDssUMzxTRZdAbMOTQ3HKSvLtkPrxVPUvk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTVnlKjwqvLj-7kr72iejDxx6Z8HFY5wiOMTCRTa8kc9A&oe=6AF74A73"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "MathStarVR", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_name": "Learning
.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQkF9qoys7eGH1e1BUyZ2PQBxukgKmzQY0rmhnbFlTcaw&oe=6B0C7A66"}, {"file_name": "mathstarvr_screenshot_t43.png", "id": "1568369594761550", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491830576_1568369598094883_7655560659407911836_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FwvJZ0D5mXcQ7kNvwFPW7fc&_nc_oc=AdqdXTBcdXzEitGWFzlg0oIXDxR2ZoNH6jZ6Yu_skt_vyB1OflHDuYTMJT_T8fNd5ug&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQs9BCSDPcY8-WhNvaYOiDX_nc8dUfZY8BcZT7ukglM1w&oe=6B0C59A4"}, {"file_name": "mathstarvr_screenshot_t50.png", "id": "1428276405834494", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/673716021_1428276409167827_8509181504050287336_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=icddbUXvj14Q7kNvwGCgK0k&_nc_oc=Adoy-LEGcYsU3MTaQUxW27aJoIGP8vmTLXCbMADO_rz8VSGbIzdu0iP-wHEZQBHMo1M&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRrexgsafXph8I9a-0nr6kcPUpWE94PxGLPGrOVzYHTzQ&oe=6B0C6A46"}, {"file_name": "mathstarvr_screenshot_t34.png", "id": "1097002509436459", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/673525341_1097002512769792_1697302956376564066_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2olbRE8uhR0Q7kNvwFPLtOT&_nc_oc=AdrAeH591_qWAA0GGAClBWmVsO0NwdqNCWKn7xCYaKS0nUwJOuAhIWAdLf1096yH9TA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQ-EM2m5leb2h6p2pwRP25p3r3SjPrzrLXwAQSoOq1BVQ&oe=6B0C81B6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "mathstarvr_screenshot_t50.png", "id": "3183987471794894", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491831569_3183987475128227_2918180018398440237_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m7fZw02RTOUQ7kNvwEoYIrL&_nc_oc=AdoPHGDmbC3Q_jK2kixxFqMpEMJNTI6gxaq5tqaZ0rJkPDOw4Z2vVtin-8IwguTOpvQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQWXNZz0moUuJ2wPKYBruKHMMyX-Be6x0xB0QtUBAYFXQ&oe=6B0C5458"}, "display_name": "MathStarVR", "keywords": [], "long_description": "MathStarVR reimagines math as something you do with your hands, not just your head.\n\nDive into an underwater world where equations float in front of you as physical objects. Using natural hand gestures, no controllers required, you raise, squash, expand, and rearrange terms to solve for the unknown. Every gesture mirrors a real arithmetic or algebraic operation, so the math you're doing with your hands is the same math you'd write on paper, just made visible.\n\nBuilt for students and the adults who wished algebra felt like this the first time. Designed for classrooms, libraries, and anyone who's ever frozen up at the sight of x.\n\nNo accounts. No ads. No data collected. Just equations, your hands, and the ocean.", "short_description": "Solve arithmetic and algebra with your hands, underwater. MathStarVR turns equations into physical puzzles you raise, squash, expand, and rearrange through natural hand gestures, no controllers needed. The math you write on paper, made visible and physical."}]}, "developer_name": null, "developer_privacy_policy_url": "https://shepherdxr.org/mathstarvr-privacy.html", "developer_terms_of_service_url": null, "publisher_name": "ShepherdXR", "support_website_url": "https://shepherdxr.org/contact", "website_url": "https://shepherdxr.org/mathstar", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["SITTIN
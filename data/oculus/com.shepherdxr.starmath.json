EAq4_VuvQWbdrjunzas3Vdb0hw2ooQ&oe=6AFDD924"}, {"file_name": "mathstarvr_screenshot_t50.png", "id": "1428276405834494", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/673716021_1428276409167827_8509181504050287336_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3lFkAMa41VgQ7kNvwF-H_12&_nc_oc=AdoPNGiIwqdY9UflYxd5VIZmsLDS6zki5EWyNQT7AQj3PKsFI8A36453ubbbst9kqSw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQStk_hyK2vSET7cqa6YmtCPWxErTO5CbSF7ZcidFWpatg&oe=6AFDB186"}, {"file_name": "mathstarvr_screenshot_t34.png", "id": "1097002509436459", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/673525341_1097002512769792_1697302956376564066_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8KVfBYwXwtMQ7kNvwE9oiiR&_nc_oc=Adr5AsZ7JjgJpluEYG1IjaYWNre7O1VPtlsnou5xmejAYEoQ_wPl83mnMTJd-izXj90&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRPb5AeZPaHy_7MvV3a7x2sKvxWYHQ95RF_tNkcMY6nvA&oe=6AFDC8F6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "mathstarvr_screenshot_t50.png", "id": "3183987471794894", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491831569_3183987475128227_2918180018398440237_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oH4doyasxW8Q7kNvwFI3y88&_nc_oc=Adq3q-Yq07aEmLOZhCgCDY5-VnEvoAeRPmEPPWS3NsVfSWtV_VecnvWqvYet9JoUh7M&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTiDHiGkmLp4ZwX1IHhEov_hsHF2hwavGIfNl_HVtfgRw&oe=6AFDD3D8"}, "display_name": "MathStarVR", "keywords": [], "long_description": "MathStarVR reimagines math as something you do with your hands, not just your head.\n\nDive into an underwater world where equations float in front of you as physical objects. Using natural hand gestures, no controllers required, you raise, squash, expand, and rearrange terms to solve for the unknown. Every gesture mirrors a real arithmetic or algebraic operation, so the math you're doing with your hands is the same math you'd write on paper, just made visible.\n\nBuilt for students and the adults who wished algebra felt like this the first time. Designed for classrooms, libraries, and anyone who's ever frozen up at the sight of x.\n\nNo accounts. No ads. No data collected. Just equations, your hands, and the ocean.", "short_description": "Solve arithmetic and algebra with your hands, underwater. MathStarVR turns equations into physical puzzles you raise, squash, expand, and rearrange through natural hand gestures, no controllers needed. The math you write on paper, made visible and physical."}]}, "developer_name": null, "developer_privacy_policy_url": "https://shepherdxr.org/mathstarvr-privacy.html", "developer_terms_of_service_url": null, "publisher_name": "ShepherdXR", "support_website_url": "https://shepherdxr.org/contact", "website_url": "https://shepherdxr.org/mathstar", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26537623372534436"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/604385997_1393207735576736_529944752238026899_n.png?stp=dst-png_s360x360&_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SGlBn6l9lzoQ7kNvwEEgfEb&_nc_oc=AdpE8LSojXDOSS9AFwn8woyInrKO_wOsofLBgJlU6tzpKGGF3ubN7KmhVaYRcvC4MpI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh
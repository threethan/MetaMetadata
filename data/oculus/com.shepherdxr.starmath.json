.oculuscdn.com&_nc_ss=7f30f&oh=00_AQV4d1WMsRGm8W1el1AnXFoQnciAu9MD8wzr52PyUYgYQQ&oe=6B1036A6"}, {"file_name": "mathstarvr_screenshot_t43.png", "id": "1568369594761550", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491830576_1568369598094883_7655560659407911836_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m2w3P7C83p4Q7kNvwHCzosM&_nc_oc=AdpezxMI1uuP_ihEchwQN8VtKjv5bMoJRH4ccH2n1GAKTYrWUl9A3vr9ttEcyCzx1tw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWKFflYausyiwno2HQSY2_VKlNtOJqtJ6AsEYc5JhHTLA&oe=6B104E24"}, {"file_name": "mathstarvr_screenshot_t50.png", "id": "1428276405834494", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/673716021_1428276409167827_8509181504050287336_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4TaoicTI920Q7kNvwGFRarq&_nc_oc=Ado2x7ZalcUc6m0bEX4E4Ow0jMNC5mG6csJ36vC2VoSigWO6sj5DOpBXdns9SpkeaCo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVrIXoyJGwKmqT9boNUqhHO5OeIf_VBd_P8GBWoi8HvWg&oe=6B105EC6"}, {"file_name": "mathstarvr_screenshot_t34.png", "id": "1097002509436459", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/673525341_1097002512769792_1697302956376564066_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ThxI-HYI_8wQ7kNvwEb6r3s&_nc_oc=AdoyYt4b0pdzf4KDQHUrgguFMEEc1-IGkCEu-7bnFgQcdAM5UjdPPDy2mvvGl_2Lofc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWuJe4VLizQxerFrUIMtAUgt2aanOc6YfM0kccy9emgEw&oe=6B103DF6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "mathstarvr_screenshot_t50.png", "id": "3183987471794894", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491831569_3183987475128227_2918180018398440237_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4NdP6AjLkyMQ7kNvwHUwV-D&_nc_oc=AdoHDaZBC3Dw9cpxirihpLXS7mQMmow484LL0HblKb8vHcMbpYyBtB_ZGWB-03Uvajo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVrqdaAM9bR_GXbeHL70GHvsf9kykKgM2SS3JkCV08UtQ&oe=6B1048D8"}, "display_name": "MathStarVR", "keywords": [], "long_description": "MathStarVR reimagines math as something you do with your hands, not just your head.\n\nDive into an underwater world where equations float in front of you as physical objects. Using natural hand gestures, no controllers required, you raise, squash, expand, and rearrange terms to solve for the unknown. Every gesture mirrors a real arithmetic or algebraic operation, so the math you're doing with your hands is the same math you'd write on paper, just made visible.\n\nBuilt for students and the adults who wished algebra felt like this the first time. Designed for classrooms, libraries, and anyone who's ever frozen up at the sight of x.\n\nNo accounts. No ads. No data collected. Just equations, your hands, and the ocean.", "short_description": "Solve arithmetic and algebra with your hands, underwater. MathStarVR turns equations into physical puzzles you raise, squash, expand, and rearrange through natural hand gestures, no controllers needed. The math you write on paper, made visible and physical."}]}, "developer_name": null, "developer_privacy_policy_url": "https://shepherdxr.org/mathstarvr-privacy.html", "developer_terms_of_service_url": null, "publisher_name": "ShepherdXR", "support_website_url": "https://shepherdxr.org/contact", "website_url": "https://shepherdxr.org/mathstar", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["SITTIN
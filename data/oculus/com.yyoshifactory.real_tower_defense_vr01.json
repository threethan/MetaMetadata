railer_thumbnail": {"file_name": "SnapShot001_BattleScene.png", "id": "904108159095942", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499623131_904108162429275_3727550554271843465_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n6C8tYr-6g4Q7kNvwG15OsY&_nc_oc=AdqVn8EiZ-j9xQjRbHwohPLbE-HLDYRSwtcVaBOaEA-AFuUJaeJOESF-Fls5XiCHOFY&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQs4WXyeA9iWa2Z7yBPImsgWvQ7xASxs3cFFNBkvVOoqw&oe=6AFC736B"}, "display_name": "Real Tower Defense", "keywords": [], "long_description": "Real Tower Defense is an immersive VR tower defense game where you defend your castle from waves of invading monsters.\n\nStand atop defensive towers and use powerful magic such as Fire, Ice, Thunder, and Poison to stop your enemies. Teleport between towers to find the best position, summon allied warriors to fight on the battlefield, and strengthen your abilities as you progress.\n\nThis is an early version of Real Tower Defense. New features, balance improvements, and other updates are planned based on player feedback.", "short_description": "Defend your castle from waves of monsters using powerful magic and allied warriors in an immersive VR tower defense experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/yyoshi-studio-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Yoshiyoshi Studio", "support_website_url": null, "website_url": "https://sites.google.com/view/yoshiyoshistudio/%E3%83%9B%E3%83%BC%E3%83%A0", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}, {"id": "275629210202852"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphi
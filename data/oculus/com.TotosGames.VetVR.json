e=6ACA6D41"}, {"file_name": "SS_5.png", "id": "1139063410942735", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982697_1139063414276068_3789776855005767638_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eUCO-PNqLjgQ7kNvwEQp2Hg&_nc_oc=AdoR4y9QEqvK1ozElJKcWLmLDCWg_GUzgJaFHJ_rGv-6THJlFBqLOCtLL0dMoXL0tV0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNNKMVn1JmnZEhZl76VMPE4fQNb3eB2VmoRfS-pGz3Juw&oe=6ACA57BA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover_Image.png", "id": "603562315537430", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39036658_603562318870763_6098372891852445163_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gy2CqklWkJwQ7kNvwF0JXcc&_nc_oc=AdpKvyFngqJW65HuOjZcSnkY-ssZcBIMkzcWd_SsFVFcdynoke-tPMMlazdvDkJrtKw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPgQM38CVzi-xnCjSJmhjBpd4R6SJI2feHbN2EtTU7fLw&oe=6ACA701E"}, "display_name": "VetVR", "keywords": ["Pet", "Vet", "Game"], "long_description": "Step into the world of veterinary care with Vet VR, an engaging and interactive virtual reality experience. As a skilled veterinarian, you'll welcome a variety of sick or dirty animals into your clinic. It's your job to identify their problems, apply the right treatments, and ensure they leave in perfect health. With its hands-on gameplay and realistic scenarios, Vet VR offers an exciting way to care for animals while testing your problem-solving skills in a fun and heartwarming environment.", "short_description": "Vet VR is a fun and immersive VR game where players become veterinarians, treat sick or dirty animals, and send them back happy and healthy!"}]}, "developer_name": "Esti Digital", "developer_privacy_policy_url": "https://estidigital.com/PrivacyPolicy.html", "developer_terms_of_service_url": null, "publisher_name": "Esti Digital", "support_website_url": null, "website_url": "https://estidigital.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST
g", "id": "479115548127096", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031549_479115551460429_7742756488870031714_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cFAl48Xk1iQQ7kNvwHvH2aU&_nc_oc=AdropXyBAatwlS47LUYw_BW0uzPFlXHfMG8_nh2WV526e0xE2dpIHV8iruR0EjfQRZ4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIM7SNeGARwW1N3dpAg0I9FpD0BIcXbH9FP95Empqj6Tw&oe=6AB7C001"}, {"file_name": "SS_5.png", "id": "1139063410942735", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982697_1139063414276068_3789776855005767638_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v2zEYWqzKUoQ7kNvwGFzjcQ&_nc_oc=AdpJrz8IZFAekx91wEx2ITgwJE0FTfC4jOecN_4QM6BCEhu6aNbvSrPvZ6GG6L4L26M&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKuQmUrsEWz5zmQwV2CN8WGshiKtYkK9ur5Ql-oi5EFog&oe=6AB7E2BA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover_Image.png", "id": "603562315537430", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39036658_603562318870763_6098372891852445163_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gyWOrUvEQtIQ7kNvwGs32Yu&_nc_oc=AdruPTP0COCCu4LDcJAFYvpDTvxhrG8g83Z9uMpFJUWvnO0EbAKTkWhDlF21if4Gizw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLAcwi9BO49SUtIxmgkf2WnRu7HzQ4IuMjPWse2EdXm_Q&oe=6AB7C2DE"}, "display_name": "VetVR", "keywords": ["Pet", "Vet", "Game"], "long_description": "Step into the world of veterinary care with Vet VR, an engaging and interactive virtual reality experience. As a skilled veterinarian, you'll welcome a variety of sick or dirty animals into your clinic. It's your job to identify their problems, apply the right treatments, and ensure they leave in perfect health. With its hands-on gameplay and realistic scenarios, Vet VR offers an exciting way to care for animals while testing your problem-solving skills in a fun and heartwarming environment.", "short_description": "Vet VR is a fun and immersive VR game where players become veterinarians, treat sick or dirty animals, and send them back happy and healthy!"}]}, "developer_name": "Esti Digital", "developer_privacy_policy_url": "https://estidigital.com/PrivacyPolicy.html", "developer_terms_of_service_url": null, "publisher_name": "Esti Digital", "support_website_url": null, "website_url": "https://estidigital.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "528142316460358"}, {"id": "331529188132278"}, {"id": "275629210202852"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD", "OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "27887869184193694"}}]}, "scheduled_offers": {"count": 0, "nodes": []}, "baseline_offer": null, "is_approved": true, "firstOffer": {"nodes": []}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "32951224457858116", "version": "5.1"}, "id": "1319317939199784", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "27771386402508640", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "32951224457858116"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1319317939199784"}]}, "change_log": null, "created_date": 1766697128, "id": "32951224457858116", "version": "5.1", "version_code": 6, 
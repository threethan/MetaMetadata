_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BNdPfUbCrCAQ7kNvwE37F-H&_nc_oc=AdkFVvM-8oZqRc4aCuerCs9-LTYsp9TBErwPciRBwrvAwpFjv82E8ik1kN3R3xIrk-g&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AfvNrFL5q96YaV7j2vHucNINlV5qp4jKo2WkIHv6k7LfOw&oe=699EF081"}, {"file_name": "SS_5.png", "id": "1139063410942735", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982697_1139063414276068_3789776855005767638_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eM68EQHZqYcQ7kNvwHEgHQ2&_nc_oc=AdnJOJJdgCa0XOln8ZivlPgo-7W9R0jVdYhWY_4CxXeBiq-o-3yy-a0vKgislOp3OmE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AfuHyvlKW7lmly3IWt6FedEtkBAV4u75Lh5qQwfAGg68Aw&oe=699EDAFA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover_Image.png", "id": "603562315537430", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39036658_603562318870763_6098372891852445163_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W1gK7tVVpwIQ7kNvwFNieFK&_nc_oc=AdlC2BH59NeBuwlv3dEEN7BhbXOWHxzTTrQBTETYKNnnj6VRgDhhTMYAcjVUHmcau-Q&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_Afsht9mXR1rPMxIPfiVRZjLONDzAIhisDPsdF0jIccTc4A&oe=699EF35E"}, "display_name": "VetVR", "keywords": ["Pet", "Vet", "Game"], "long_description": "Step into the world of veterinary care with Vet VR, an engaging and interactive virtual reality experience. As a skilled veterinarian, you'll welcome a variety of sick or dirty animals into your clinic. It's your job to identify their problems, apply the right treatments, and ensure they leave in perfect health. With its hands-on gameplay and realistic scenarios, Vet VR offers an exciting way to care for animals while testing your problem-solving skills in a fun and heartwarming environment.", "short_description": "Vet VR is a fun and immersive VR game where players become veterinarians, treat sick or dirty animals, and send them back happy and healthy!"}]}, "developer_name": "Esti Digital", "developer_privacy_policy_url": "https://estidigital.com/PrivacyPoli
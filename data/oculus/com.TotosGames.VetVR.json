_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BNdPfUbCrCAQ7kNvwEeE5P9&_nc_oc=AdkX-_8wIQ5D-LRu_p_XJN6aSzWAf3WdMbSuYNHjBGv80MjR-hN-oTiYsmVgaCeZJRM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfuZjkc4dKJZreEVZ5qR9gHBMgo0I8yLykk2c6RgWJ9aEQ&oe=69A04201"}, {"file_name": "SS_5.png", "id": "1139063410942735", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982697_1139063414276068_3789776855005767638_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eM68EQHZqYcQ7kNvwG9D-iN&_nc_oc=AdnOtpiRlF3w26wX0_fS4qXXn5utuKP9QocWwH-aDl-u-EFR3yZ_MCFg_CxongGGalk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AftwRgyDh1VO5Enmo39AJFyAELQsPDacGu-C2RPXDEPDQw&oe=69A02C7A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover_Image.png", "id": "603562315537430", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39036658_603562318870763_6098372891852445163_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_VoO-sKSZqMQ7kNvwFpai2M&_nc_oc=AdkGbjeFmDyIetnY49Lnm7jM0kZ5V5TG75-ASIgjNKTXev9MSPc4zdw-cjZynzdPnpQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Afv1ulew7hr0dkTI4b8ndcKDvIT94jSCzpu2LfO8zewU8w&oe=69A044DE"}, "display_name": "VetVR", "keywords": ["Pet", "Vet", "Game"], "long_description": "Step into the world of veterinary care with Vet VR, an engaging and interactive virtual reality experience. As a skilled veterinarian, you'll welcome a variety of sick or dirty animals into your clinic. It's your job to identify their problems, apply the right treatments, and ensure they leave in perfect health. With its hands-on gameplay and realistic scenarios, Vet VR offers an exciting way to care for animals while testing your problem-solving skills in a fun and heartwarming environment.", "short_description": "Vet VR is a fun and immersive VR game where players become veterinarians, treat sick or dirty animals, and send them back happy and healthy!"}]}, "developer_name": "Esti Digital", "developer_privacy_policy_url": "https://estidigital.com/PrivacyPoli
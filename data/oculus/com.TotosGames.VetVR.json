_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KBJy36XaMdcQ7kNvwGhab97&_nc_oc=AdkyEFXvOa3Vh6meJwP5Peo34fLR1KmdPpyzYdcNunNAIxn7cFoeOLm9ezjvQ_ie8Kw&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_Afu-MUyaRa1ItCAwQkgktZRTrix-24Pfikm4yBn1Wa2oIQ&oe=699C4D81"}, {"file_name": "SS_5.png", "id": "1139063410942735", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982697_1139063414276068_3789776855005767638_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uip2dWWs-HAQ7kNvwHBWl5O&_nc_oc=AdlJlEySqOl26d1lGFMTAezLzgshhlCmgV04QSe_OWDbRWJrZtQWoc8J5rQ5tWJicIQ&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_Afsw8XBpU1JANPNOVU61boNS-czSUDBGd0gGXQ2CxKDQeg&oe=699C37FA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover_Image.png", "id": "603562315537430", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39036658_603562318870763_6098372891852445163_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W1gK7tVVpwIQ7kNvwHqCzak&_nc_oc=AdlaMAyyK475E_-qdt-BTC1Jp-_yl91PNIyB3PGXAG7iDkCgLUWEzyQ9UVdQS59ufoE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AfvnLt2zPgZWarHT7G1ozqMXqsxJBzkRs5bVkElXLi5AsQ&oe=699C505E"}, "display_name": "VetVR", "keywords": ["Pet", "Vet", "Game"], "long_description": "Step into the world of veterinary care with Vet VR, an engaging and interactive virtual reality experience. As a skilled veterinarian, you'll welcome a variety of sick or dirty animals into your clinic. It's your job to identify their problems, apply the right treatments, and ensure they leave in perfect health. With its hands-on gameplay and realistic scenarios, Vet VR offers an exciting way to care for animals while testing your problem-solving skills in a fun and heartwarming environment.", "short_description": "Vet VR is a fun and immersive VR game where players become veterinarians, treat sick or dirty animals, and send them back happy and healthy!"}]}, "developer_name": "Esti Digital", "developer_privacy_policy_url": "https://estidigital.com/PrivacyPoli
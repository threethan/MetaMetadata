g", "id": "479115548127096", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/39031549_479115551460429_7742756488870031714_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zNQgJyWIPNMQ7kNvwGCKP1w&_nc_oc=AdrCCAuG06cFq_LvNKHDoRVCCMXu2G8Q1h__DIkgfLjs3VsF46w7JwO4FgNP5VVN3cc&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4nzpInEb2NI898HGQWaTOM7luaro30M65LVeMN02JoAA&oe=6A12F481"}, {"file_name": "SS_5.png", "id": "1139063410942735", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38982697_1139063414276068_3789776855005767638_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YCXsoW9WdIQQ7kNvwH3-U7z&_nc_oc=AdpTUq_fLiUpFfjDUrbhIn_4eO3N4hjO1ZdyzAJzdgamxQYb0T7gFFf7_xSlCvO0fqg&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af46wI8g1dp32K16W_sF7AoSy_HuOxGBjzDjoUb65aANyA&oe=6A13173A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover_Image.png", "id": "603562315537430", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/39036658_603562318870763_6098372891852445163_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8uqsrqB3SiMQ7kNvwFwclpe&_nc_oc=Ado8SHy0wVqIw3TYIqb85oxyUubDGqUERSo-hyZslPkoR-ZfUiciHZmMVBu0eccD_cA&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af48ak76Uqc3ySc_ag5hJJa0lUQQBeWOlTaEF6NrOkFNdw&oe=6A12F75E"}, "display_name": "VetVR", "keywords": ["Pet", "Vet", "Game"], "long_description": "Step into the world of veterinary care with Vet VR, an engaging and interactive virtual reality experience. As a skilled veterinarian, you'll welcome a variety of sick or dirty animals into your clinic. It's your job to identify their problems, apply the right treatments, and ensure they leave in perfect health. With its hands-on gameplay and realistic scenarios, Vet VR offers an exciting way to care for animals while testing your problem-solving skills in a fun and heartwarming environment.", "short_description": "Vet VR is a fun and immersive VR game where players become veterinarians, treat sick or dirty animals, and send them back happy and healthy!"}]}, "developer_name": "Esti Digital", "developer_privacy_policy_url": "https://estidigital.com/PrivacyPolicy.html", "developer_terms_of_service_url": null, "publisher_name": "Esti Digital", "support_website_url": null, "website_url": "https://estidigital.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "528142316460358"}, {"id": "331529188132278"}, {"id": "275629210202852"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD", "OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "27887869184193694"}}]}, "scheduled_offers": {"count": 8, "nodes": [{"status": "PUBLISHED", "id": "1438598954339480"}, {"status": "PUBLISHED", "id": "33579271545020023"}, {"status": "PUBLISHED", "id": "2008440233339162"}, {"status": "PUBLISHED", "id": "830198646288597"}, {"status": "PUBLISHED", "id": "1006849791557495"}, {"status": "PUBLISHED", "id": "1907466249994800"}, {"status": "PUBLISHED", "id": "1392061308343927"}, {"status": "PUBLISHED", "id": "497711026010301"}]}, "baseline_offer": {"id": "497711026010301"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1773421200, "status": "PUBLISHED", "id": "1438598954339480"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "32951224457858116", "version": "5.1"}, "id": "1319317939199784", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries
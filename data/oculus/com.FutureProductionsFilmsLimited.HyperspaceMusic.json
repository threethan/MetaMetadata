aRn7rM3ymTIbYmDg&oe=6A05D0BE"}, {"file_name": "SCEENSHOT1.png", "id": "584973727731676", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38984470_584973731065009_2349542524217100829_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F7MUAt1lDEUQ7kNvwEHNJmp&_nc_oc=Adq4QD_h8feqKikGOCh1u9x27JYuxcfaV29cvxbKoIpDE41kjfFnhHCE5SzaXMo7_NI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5xiMe4N4YGyxMIuPtjgr__7yfgN07UM_5tLEnz9hTxLw&oe=6A05CD0F"}, {"file_name": "SCEENSHOT5.png", "id": "1605552597054011", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982709_1605552600387344_7796101218617982424_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8J8rVo4Lqf0Q7kNvwEJCsVJ&_nc_oc=AdpTAUNhfHmLFyWJrQX5CuJ7a5t81FH4jd6zSFlKUILTQI11h5f1gFPK-M6dVm3bn-0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af76I9AF0DoNfCviZ0YRFCA1E2gBtoo9LbJ4Cde0nGHW9w&oe=6A05D63B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "PDP-COVER-ART.png", "id": "2491317877739513", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75195904_2491317881072846_1268051824993313382_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XbEIHMkebxUQ7kNvwEZqseG&_nc_oc=Adqu03zkEHGLzvTPDoDP5RMf4H0dP53cjshxeO4J0stN7RjQSPpRg_-c3Bjn3s35684&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af51wZ7IRWsoJOtbKjB24sL9CBLIpXKeOAsDWqfhbfd1Zw&oe=6A05DAF9"}, "display_name": "Hyperspace Music", "keywords": ["music", "visualizer", "Mp3"], "long_description": "Discover a new world of music with Hyperspace Music, the ultimate VR app for Oculus headsets. Hyperspace Music revolutionizes your auditory experience by transforming your favorite MP3 tracks into breathtaking visual masterpieces.\n\nINSTRUCTIONS\n\n1) Simply load your MP3 files into the default \"Music\" folder on your headset\n \n2) Open the app settings and allow the required permissions for the best experience, then launch Hyperspace Music and scan your tracks.\n\nEach song is brought to life through stunning, real-time visualizers that respond dynamically to the beats, rhythms, and melodies of your music. \n\nWhether you're vibing to rap, rocking out to metal, or relaxing with classical tunes, Hyperspace Music creates an immersive visual landscape that complements every genre.\n\nHyperspace Music now includes supported camera passthrough features for compatible headsets. Camera passthrough data is never recorded, stored, transmitted, uploaded, or shared by Hyperspace Music. Passthrough is used only on-device through the headset system while you use the app.\n\nHyperspace Music is designed mainly for local/offline use with music files stored on your headset. Core music playback and visualizer features do not require an internet connection. The app does not upload your MP3 files, music library, or passthrough camera imagery.\n\nDive into a vibrant universe where sound and sight merge, offering an unparalleled sensory adventure!", "short_description": "Hyperspace Music is a VR app for Oculus headsets that lets you discover a new world of music through stunning visualizers. Load your favorite MP3 tracks into the music folder on your headset, and watch as Hyperspace Music transforms each song into an immersive visual experience, with vibrant, dynamic landscapes reacting in real-time to the beats and rhythms of your music."}]}, "developer_name": null, "developer_privacy_policy_url": "https://future-productions.co.uk/privacy-policy-for-hyperspace-music-vr-application/", "developer_terms_of_service_url": null, "publisher_name": "Future Productions Films Ltd", "support_website_url": null, "website_url": "http://www.future-productions.co.uk/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRE
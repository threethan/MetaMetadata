nc_sid=6e7a0a&_nc_ohc=m_Hle318ABYQ7kNvwHOITDF&_nc_oc=Adq18_kccuhzUa-AfeGFsI1cnyGehc8UFwV57NVOFvIm6WdgyDk9d0kY_8ZxM7mNim0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4pjhf_Zfc6GFz8N3Y9qA0FBatLaapWZJ-OtP1tdC4UIg&oe=6A05D31B"}, {"file_name": "4.png", "id": "460035023578152", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974548_460035026911485_5406757983494996757_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=btcbAmjgcFwQ7kNvwFtF1xO&_nc_oc=AdqKVt8JQ9qdardo8VIDLlRFhpgYw84cNr-urNndGWgjic7DJPo8o_JgJFUdNWjYSkM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5ysKRrg4tvB2a0-M-Axv7NfxDDfIhXfein2_PBSSVGmw&oe=6A05D4B1"}, {"file_name": "5.png", "id": "803323975305349", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/57566690_803323978638682_6374794764864814850_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5gDnzSXOY_kQ7kNvwHVrB52&_nc_oc=AdpmBNVcb_Rujj3b7zLk2CFrJkwmRv5O05H8oS33TTg85VO_jPLqcSOD8VaUEtxIwG4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5dAf5S775IAMYgFzouhhYMp2mPVMAds0ncjPEGmGIzvw&oe=6A05E300"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TRAILER-COVER.png", "id": "1218679169290308", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982480_1218679172623641_6223996276826998637_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NlTCpwxMWMcQ7kNvwHaseU9&_nc_oc=Ado-GuhdaHxHtho_SvgtViLnPNUVS5vWFWQsZdZXfkIbUnahk96cQ3t4IN6glG0V0WE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6n4CYncMI2UNuptCT4buPms1XiiCoYu2bKv7rLgf4xRQ&oe=6A05D4D2"}, "display_name": "Hyperspace Music", "keywords": [], "long_description": "Discover a new world of music with HyperSpace Music, the ultimate VR app for Oculus headsets. HyperSpace Music revolutionizes your auditory experience by transforming your favorite MP3 tracks into breathtaking visual masterpieces.\n\nSimply load your MP3 files into the default \"music\" folder on your headset, and let HyperSpace Music do the rest. Each song is brought to life through stunning, real-time visualizers that respond dynamically to the beats, rhythms, and melodies of your music. Whether you're grooving to pop, rocking out to metal, or relaxing with classical tunes, HyperSpace Music creates an immersive visual landscape that complements every genre.\n\nDive into a vibrant universe where sound and sight merge, offering an unparalleled sensory adventure. Customize your experience with various visual themes and effects, ensuring that no two journeys are ever the same. HyperSpace Music is perfect for music lovers, VR enthusiasts, and anyone looking to elevate their listening experience.\n\nApp Created by Krish T & Vicente M - Future Productions Films\nVideo Backgrounds - Bj\u00f6rn Richter & TellSoto\nSpace Cover Art - Photo by Felix Mittermeier\n\nLINKS:\nhttp://www.future-productions.co.uk\nhttps://dietechrecruiter.de/author/bj%C3%B6rn-richter/ \nhttps://www.pexels.com/photo/blue-universe-956981/", "short_description": "HyperSpace Music is a VR app for Oculus headsets that lets you discover a new world of music through stunning visualizers. Load your favorite MP3 tracks into the music folder on your headset, and watch as HyperSpace Music transforms each song into an immersive visual experience, with vibrant, dynamic landscapes reacting in real-time to the beats and rhythms of your music."}]}, "developer_name": null, "developer_privacy_policy_url": "https://future-productions.co.uk/privacy-policy-for-hyperspace-music-vr-application/", "developer_terms_of_service_url": null, "publisher_name": "Future Productions Films Ltd", "support_website_url": null, "website_url": "http://www.future-productions.co.uk/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8244448688912468"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1239348220764120"}]}, "baseline_offer": {"id": "1239348220764120"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1722399746, "status": "PUBLISHED", "id": "1239348220764120"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "27299826946281356", "version": "2.1.7"}, "id": "1845929692484603", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "8244448648912472", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "27299826946281356"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1845929692484603"}]}, "change_log": "HYPERSPACE MUSIC VR 2.1.6 UPDATE\n\n- Major passthrough breakthrough update for Quest users.\n- Passthrough mode is now tested and working on Quest 2.\n- New overlay shader system added for mixed reality visuals.\n- Passthrough cameras are now active in supported modes.\n- See your room transformed with predator-style colours while your music visuals play on top.\n- New haptics mode lets you feel the bass through your controllers.\n- Improved MP3 detection and music folder scanning.\n- Improved setup flow for users adding their own music.\n- Performance and stability improvements across the app.\n\nINSTALL INSTRUCTIONS\n\n1. Add your MP3 files to the default Music folder on your Meta Quest headset.\n2. Open the app settings on your headset and allow all requested permissions for the best experience.\n3. Restart Hyperspace Music VR after adding music or changing permissions.\n4. Open the app, scan your music, then try passthrough mode and haptics mode.\n5. For best results, use standard MP3 files and make sure they are stored directly inside the headset\u2019s Music folder.\n\nThanks for supporting the development of this app! - Hyperspace Music Team", "created_date": 1778067738, "id": "27299826946281356", "version": "2.1.7", "version_code": 38, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": {"id": "27299820686281982"}, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "8244448648912472", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "27299826946281356"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1845929692484603"}]}, "change_log": "HYPERSPACE MUSIC VR 2.1.6 UPDATE\n\nMajor passthrough breakthrough update for Quest users.\n\n - Passthrough mode is now tested and working on Quest 2.\n\n- New overlay shader system added for mixed reality visuals.\n\n- Passthrough cameras are now active in supported modes.\n\n- See your room transformed with predator-style colours while your music visuals play on top.\n\n- New haptics mode lets you feel the bass through your controllers.\n\n- Improved MP3 detection and music folder scanning.\n\n- Improved setup flow for users adding their own music.\n\n- Performance and stability improvements across the app.\n\nINSTALL INSTRUCTIONS\n\n1) Add your MP3 files to the default Music folder on your Meta Quest headset.\n\n2) Open the app settings on your headset and allow all requested permissions for the best experience.\n\n3) Restart Hyperspace Music VR after adding music or changing permissions.\n\n4) Open the app, scan your music, then try passthrough mode and haptics mode.\n\nFor best results, use standard MP3 files and make sure they are stored directly inside the headset\u2019s Music folder.\n\n- Hyperspace Music Team", "created_date": 1778062851, "id": "27299140366350014", "version": "2.1.6", "version_code": 37, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": {"id": "27299134356350615"}, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "8244448648912472", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "27299826946281356"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1845929692484603"}]}, "change_log": "Version 2.1.5 - MAJOR UPDATE\n\nMajor breakthrough update for mixed reality mode\n\nOverlay shader now working correctly\n\nPassthrough cameras are now active and supported (Tested on Quest 2)\n\nImproved overall stability and immersion\n\nFor the best experience, please check app permissions in your headset settings and allow all requested permissions\n\nThank you for your support and feedback!", "created_date": 1777380464, "id": "27209285662002152", "version": "2.1.5", "version_code": 36, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": {"id": "27209280412002677"}, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "8244448648912472", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "27299826946281356"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1845929692484603"}]}, "change_log": "Release Note 2.1.4\n\nControllers now vibrate in sync with the bass line of the music. This feature can be toggled on or off using the X button on the left controller.\n\nTo ensure your music plays correctly:\n\nStore your MP3s in the default Music folder located at the root of your Android headset.\n\nOpen the app Settings menu and grant the necessary file access permissions.", "created_date": 1772461681, "id": "26602330009364390", "version": "2.1.4", "version_code": 35, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": {"id": "26602325092698215"}, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "8244448648912472", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "27299826946281356"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1845929692484603"}]}, "change_log": "Version 2.1.3 \u2013 Critical Security Update\nThis release includes a critical security patch for Unity-related vulnerabilities.\n\n\ufffd Important: Users must ensure the app has permission to access the music folder on the headset via the Apps Settings tab to maintain proper functionality.", "created_date": 1759674528, "id": "25258495500414521", "version": "2.1.3", "version_code": 34, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": {"id": "25258489097081828"}, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}]}}, "viewer": {"user": null}}}
ng?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6mofdrzUjCYQ7kNvwFl2Vb0&_nc_oc=Adp4gQGiyZxmVUCplbHx6TpZFKOau0D1nrSufe7gfCSsdC2T6KapQE1BLMmd1E6Wxvs&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIshzKSr4FrAZ6WEMcpuEPJOWhWtID3alsZ6-qsjYGtjQ&oe=6ABE849C"}, {"file_name": "WhatsApp Image 2026-09-01 at 9.14.43 PM.png", "id": "1386352416936050", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/596061819_1386352420269383_9041265796904521622_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VM-5rnzefSUQ7kNvwHNXu7f&_nc_oc=AdpKsPT0Xhj8DKi7wkDsYD6jnpiAIMnxIYmw4a91OkVFpBRa1mXU8lyvGWLX6mcaa4A&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIWX3jCA_7C42rXobktvbe953Pn-X0IGX_elzCd6L3fAg&oe=6ABE7B8D"}, {"file_name": "screenshot 6.png", "id": "1060152673187646", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499312236_1060152676520979_1686616888163796990_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Sb0aJLyawjcQ7kNvwHMED7D&_nc_oc=Adq5U5E78cBsU1CSZwZfCeuBVtaNmesaEocAXRCbgQaj7Ol35E7l8-kptvmXM09ok5E&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKhmfNqWsWbNiLfKgjlCna2dBZy98a4318ceOnjDRShPQ&oe=6ABE6C93"}, {"file_name": "screenshot 4.png", "id": "2934967820198071", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499312338_2934967826864737_2206108979709931335_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=59bHDN0rcyEQ7kNvwEfXWzA&_nc_oc=AdoFBFAM8xU1yW5EjP3XoAf0WPWipSaz5J-XLptoQND-qTXOMrtxoyLhy9tvJtKnX60&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLXAq97UscBa5RC5MEBzYMNMJBeohKJmPqB5NhHInc9OQ&oe=6ABE8D57"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "URview", "keywords": [], "long_description": "Welcome to URview, a curated VR steaming platform with a variety of amazing immersive experiences from creators around the world.   Like the best flat content streaming platform URview carefully selects and approves the Films and Series  so you get high quality immersive content how you want it. \n\nFrom Documentaries, the Spy thrillers, to Kids Shows to Theatre and Concerts,  URview has a diverse catalogue of immersive entertainment to keep you enthralled. Want more? Our creators are working with us to add more to the content library every week so you'll have more of the content you love. \n\nWe are so excited to be bringing audiences greater access to VR content across the platform and applications. \n\nSwim with Humpback Whales in French Polynesia\nWatch Concerts from the front row\nBecome a Spy tasked with saving the world\nSit in the Theatre and watch award winning shows\nGet the best Virtual Tickets to Sports you love\n\nURview has dedicated sections for Kids and Education, keeping those users contained so they aren't watching the entertainment content designed for the rest of the family. \n\nReady to try? You can watch out Demo Content for FREE! Want more?  We have Subscription options, Free Memberships and PPV for Premier Titles. \n\nImmerse yourself now.", "short_description": "URview is the home of Immersive Entertainment Streaming. Watch Series and Films in full immersive environments right in the headset in full 360 3D and 2D.  With a range of shows for all kinds of audiences we have something for everyone! Want to watch a concert or an espionage thriller or dive deep beneath the surface on a history documentary or to discover wildlife from around the world. Whether it is entertainment, education or kids shows, you can experience it all on URview.   "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.urview.com/privacy/", "developer_terms_of_service_url": "https://www.urview.com/terms", "publisher_name": "URview", "support_website_url": null, "website_url": "https://www.urview.com/browse", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1343323908864248"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "4621519484841102"}]}, "baseline_offer": {"id": "4621519484841102"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1790005320, "status": "PUBLISHED", "id": "4621519484841102"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1329659846897321", "version": "1.0.1"}, "id": "1045372994531761", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1254723591057614", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1329659846897321"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1045372994531761"}]}, "change_log": "# Release Notes \u2014 Version 1.0.1 (Build 2)\n\n### \ud83d\udccc Highlights\nThis update transitions the URview native mobile & Meta Quest VR application to a **Store-Compliant Reader / Multiplatform App Mode**, resolving store review submission feedback regarding platform In-App Purchase policies.\n\n---\n\n### \ud83c\udfdb Store Policy & Compliance Updates\n* **Removed External Payment Links**: Eliminated all external web checkout links, direct pricing URLs, and `Linking.openURL()` calls to external payment pages (`/pricing/`) within the native app.\n* **Eliminated Direct Purchasing & Pricing Cards**: Removed numeric price tags (`$`, `\u00a3`, `\u20ac`), plan duration details, and direct buy buttons from native screens, complying with Apple App Store Guideline 3.1.3(a), Google Play Payments Policy, and Meta Horizon OS Monetization Terms.\n\n---\n\n### \ud83c\udfa8 User Interface & Experience Improvements\n* **New \"About & Access\" Screen**: Transformed the public pricing screen into a clean feature tier overview highlighting:\n  * **Standard Access**: Up to 2 concurrent devices, Full HD (1080p) streaming, full movie & series catalog.\n  * **Premium 4K & VR Access**: Up to 4 concurrent devices, 4K HDR quality, exclusive 360\u00b0 VR experience support for Meta Quest headset.\n* **Informational Account Notice**: Added multiplatform account notices explaining that URview content requires an active account, prompting users to sign in to start streaming.\n* **Updated Public Navigation Bar**: Renamed the top public tab bar label from **Pricing** to **About**.\n* **Streamlined Profile Subscription Tab**: Updated the user profile screen to display active subscription status clearly without external checkout buttons.\n\n---\n\n### \ud83d\udee0 Technical & Build Specifications\n* **Version Name**: `1.0.1`\n* **Android versionCode**: `2`\n* **iOS buildNumber**: `23`\n* **Target Package**: `com.urview.mobileapp`\n* **Release Artifact**: `app-release.apk` (Generated successfully)\n* **Code Verification**: Passed TypeScript compilation with 0 errors.", "created_date": 1788618002, "id": "1329659846897321", "version": "1.0.1", "version_code": 2, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1254723591057614", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1329659846897321"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1045372994531761"}]}, "change_log": null, "created_date": 1784738806, "id": "1254867951043178", "version": "1.0.0", "version_code": 1, "release_status": "PENDING", "status": "CHANGES_REQUESTED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}]}}, "viewer": {"user": null}}}
://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499312236_1060152676520979_1686616888163796990_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Sb0aJLyawjcQ7kNvwHMED7D&_nc_oc=Adq5U5E78cBsU1CSZwZfCeuBVtaNmesaEocAXRCbgQaj7Ol35E7l8-kptvmXM09ok5E&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKhmfNqWsWbNiLfKgjlCna2dBZy98a4318ceOnjDRShPQ&oe=6ABE6C93"}, {"file_name": "screenshot 4.png", "id": "2934967820198071", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499312338_2934967826864737_2206108979709931335_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=59bHDN0rcyEQ7kNvwEfXWzA&_nc_oc=AdoFBFAM8xU1yW5EjP3XoAf0WPWipSaz5J-XLptoQND-qTXOMrtxoyLhy9tvJtKnX60&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLXAq97UscBa5RC5MEBzYMNMJBeohKJmPqB5NhHInc9OQ&oe=6ABE8D57"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "URview", "keywords": [], "long_description": "Welcome to URview, a curated VR steaming platform with a variety of amazing immersive experiences from creators around the world.   Like the best flat content streaming platform URview carefully selects and approves the Films and Series  so you get high quality immersive content how you want it. \n\nFrom Documentaries, the Spy thrillers, to Kids Shows to Theatre and Concerts,  URview has a diverse catalogue of immersive entertainment to keep you enthralled. Want more? Our creators are working with us to add more to the content library every week so you'll have more of the content you love. \n\nWe are so excited to be bringing audiences greater access to VR content across the platform and applications. \n\nSwim with Humpback Whales in French Polynesia\nWatch Concerts from the front row\nBecome a Spy tasked with saving the world\nSit in the Theatre and watch award winning shows\nGet the best Virtual Tickets to Sports you love\n\nURview has dedicated sections for Kids and Education, keeping those users contained so they aren't watching the entertainment content designed for the rest of the family. \n\nReady to try? You can watch out Demo Content for FREE! Want more?  We have Subscription options, Free Memberships and PPV for Premier Titles. \n\nImmerse yourself now.", "short_description": "URview is the home of Immersive Entertainment Streaming. Watch Series and Films in full immersive environments right in the headset in full 360 3D and 2D.  With a range of shows for all kinds of audiences we have something for everyone! Want to watch a concert or an espionage thriller or dive deep beneath the surface on a history documentary or to discover wildlife from around the world. Whether it is entertainment, education or kids shows, you can experience it all on URview.   "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.urview.com/privacy/", "developer_terms_of_service_url": "https://www.urview.com/terms", "publisher_name": "URview", "support_website_url": null, "website_url": "https://www.urview.com/browse", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1343323908864248"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499312422_1050378307723612_12541929929131317_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OFavt5gCIbEQ7kNvwFxK_bX&_nc_oc=Adpkeqz0wXG2h9f6xb0_YUh8B62kwXvBLXYfwaH-xae-yll
a&_nc_ohc=-e53TwMDqMYQ7kNvwG2-VXx&_nc_oc=Adr4Ig5MFznVy_jSQQ7GXmvbZxvgWVd5noTLb4DKA0G2m7I1o-JRBl-XDKpm2zez_to&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTwIKFYFLzj0L2BHy0s5RJ39sbW5FgSpeeY-XRXS1tJjw&oe=6AE76D7E"}, {"file_name": "Screenshots_005.png", "id": "486141502473830", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75222941_486141505807163_3127839383345353654_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jePOtSagEIMQ7kNvwHkrn2R&_nc_oc=AdqdcqLc557DnvDdqYZ_FxsUvxyfqKNOZQJQpqximfpKP_p-sS1EK_eVyPN8Xy3_8-4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRH6pOvWM0_T1SvGQ3Igb_wC_icXWfGszY4x5M-pCFj4w&oe=6AE74F4D"}, {"file_name": "Screenshots_004.png", "id": "126125999624615", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974608_126126002957948_8632638290137506975_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I8w78VyyIlYQ7kNvwGxOLWY&_nc_oc=AdpFEBwBGxD7SbFy45UZngSITYyyXkD5YGqlrO9R_x6iWQXbNrNifvdSOXoKwkW4vaM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR_w2LhM3JDypUl20nIpsAczHVAM7owp6WG9h1LQiEKIA&oe=6AE75107"}, {"file_name": "Screenshots_007.png", "id": "545909776817911", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/86659754_545909780151244_4010903981250884421_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IDDSuoNX1NsQ7kNvwH5wOJQ&_nc_oc=Adpy7Z9AbBs0x6aWel63eUSN-qtiTSE7ly-EZ7isZAkwHG1zAgh75YyI4EGwewLT4Yg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ-G9C6wgPVOwYICicfsr0oGQoZ0AT2SVUHgMFtefpBxQ&oe=6AE7546E"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Gamerz Lab", "keywords": [], "long_description": "Gamerz Lab is a multi-activity, sci-fi themed playground designed to give the users a holistic gaming experience like never before.\n\nThere are two separate zones. The Game Zone offers a virtual game booth featuring a wave based shooting game. Over time more and more game booths will be added, each with exciting new games. With every new game Gamerz Lab will become a completely new experience to explore!\n\nWhenever you want to take a break from Game Zone you can move over to the Relax Zone and chill out. With amazing visuals and micro-activity corners like boxing corner and many more to come with every update will make the Gamerz Lab an unforgettable gaming experience for gamers.\nRelax in the lobby or use the boxing corner to release your inner Mike Tyson.\nGame booths offering different experiences (Shooters etc)\nBreathtaking visuals and amazing gameplay.\n", "short_description": "A multi-activity playground designed to immerse you into a sci-fi world of shooting games along with many more to come!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://dreamerzlab.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Dreamerz Lab Ltd", "support_website_url": null, "website_url": "https://dreamerzlab.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "ARCADE", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "641853910228653"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982468_1389650384737085_6124558328110054823_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vEW8NdDqiEgQ7kNvwH7oGIZ&_nc_oc=Adqj08kGRZ6ZgdYfsC_Fu4GYi0bAGNNSxt7QoX6qD3RG0nu7TBiB6IMxhqxh7T1hpuI&_nc_zt=3&_
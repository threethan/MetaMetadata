a&_nc_ohc=wiJWQkHV9gEQ7kNvwESLTd7&_nc_oc=AdqX2teA4-uv2jh4ApCJ24RIPnqciJP2EAIx0Jd3Sn-q1igvHghLGeNj-6yDt2WovGE&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOJwM0a2LrQcWGea15uwn8qRPFDE-8lJ1BwTxY8WREyzA&oe=6AD3A6FE"}, {"file_name": "Screenshots_005.png", "id": "486141502473830", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/75222941_486141505807163_3127839383345353654_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_K8RB5pCMMkQ7kNvwGbjoks&_nc_oc=Ado4gpifUxv2IYCkrpJfBzm-PiGuLjCbbkGWBSFwQNgy5QUUbbZC7oyzbeWMzaUg16A&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOAPeZge5ICD4H7ZU37CzugIBtCezoHqmc5jOQ8gw89BA&oe=6AD388CD"}, {"file_name": "Screenshots_004.png", "id": "126125999624615", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974608_126126002957948_8632638290137506975_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OAsedCXWDS4Q7kNvwGHO0QC&_nc_oc=Adr3nd9j4vTMd_C6iOVudh6aKHZN5e-_cZzKka-5HD97tvcqNigdorRGS8zdRcewnJQ&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOAHgp9cFD36KYQfxS9HAetd6VBmEsDEBigslTAyKFpbw&oe=6AD38A87"}, {"file_name": "Screenshots_007.png", "id": "545909776817911", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/86659754_545909780151244_4010903981250884421_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9U7VYxB4HnsQ7kNvwGyGD64&_nc_oc=AdqCWm628tPzhrbYIuSSOtm7wm-afDA52WRJ9eidPVtKa0Bjd5cja7Nr65z8qS1Tzco&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNj0e_TM3vKVOQPDdnD_klfMnzXicgmAmn4ux5AO2Bmbw&oe=6AD38DEE"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Gamerz Lab", "keywords": [], "long_description": "Gamerz Lab is a multi-activity, sci-fi themed playground designed to give the users a holistic gaming experience like never before.\n\nThere are two separate zones. The Game Zone offers a virtual game booth featuring a wave based shooting game. Over time more and more game booths will be added, each with exciting new games. With every new game Gamerz Lab will become a completely new experience to explore!\n\nWhenever you want to take a break from Game Zone you can move over to the Relax Zone and chill out. With amazing visuals and micro-activity corners like boxing corner and many more to come with every update will make the Gamerz Lab an unforgettable gaming experience for gamers.\nRelax in the lobby or use the boxing corner to release your inner Mike Tyson.\nGame booths offering different experiences (Shooters etc)\nBreathtaking visuals and amazing gameplay.\n", "short_description": "A multi-activity playground designed to immerse you into a sci-fi world of shooting games along with many more to come!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://dreamerzlab.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Dreamerz Lab Ltd", "support_website_url": null, "website_url": "https://dreamerzlab.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "ARCADE", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "641853910228653"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38982468_1389650384737085_6124558328110054823_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tF6qX4D-SKYQ7kNvwF__bDt&_nc_oc=AdrgSV8HD6OLO-PSO-hRkctFY8JllP0sQ9WeGu5_GyIbFcZyN3L9wasX1CSMnQxG4iQ&_nc_zt=3&_
a&_nc_ohc=36iHIWzpnG8Q7kNvwFUGk5D&_nc_oc=Adqafhf2sHIk5VwZ1DtsZSDZiA3RZ059luoxXU9Y8YyCzWka81snzZu1XKRNoZl2KOQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQID6BLT3Ob618atSZ4p5p6ZBGrkCer_9aeMxS4qx7yMdg&oe=6ABA623E"}, {"file_name": "Screenshots_005.png", "id": "486141502473830", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75222941_486141505807163_3127839383345353654_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-viqgmrAsaIQ7kNvwEaIJYI&_nc_oc=AdpHhR7EAmvq7ZpiNW9w4t8YEIT7Jr6z6__S0O1tlxDI1oiUfOkNHh8h0lf5rFS3XtU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ42syEA5o3C5smzyTqKaKD6mQ7OfHbnALM3Gnu5JXtzA&oe=6ABA7C4D"}, {"file_name": "Screenshots_004.png", "id": "126125999624615", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974608_126126002957948_8632638290137506975_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KT_8uB0DzqwQ7kNvwHcJ0x6&_nc_oc=AdqJILBS6EbEMf6ndPQy5AXD5kAnP7087x7ivHVXPdRdQ28hjIHZ99ue_wf_QLyDb1A&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJqyPl5YFcqF-HaAwPvDCoOCX7JjbXC9xKt3XSGlOyNTQ&oe=6ABA7E07"}, {"file_name": "Screenshots_007.png", "id": "545909776817911", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/86659754_545909780151244_4010903981250884421_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9OMBTVvpaboQ7kNvwGQfPvm&_nc_oc=Adri7mq75C2xfdrHnvk1g2HWwXga8JNNnZhk3Zl9pDbEcKRfThb1NuraBmLyHSlg8JI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLdmHFChJteHv5NbK1AaqCBYibqMsNFsdNz_kBx-PlS-A&oe=6ABA816E"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Gamerz Lab", "keywords": [], "long_description": "Gamerz Lab is a multi-activity, sci-fi themed playground designed to give the users a holistic gaming experience like never before.\n\nThere are two separate zones. The Game Zone offers a virtual game booth featuring a wave based shooting game. Over time more and more game booths will be added, each with exciting new games. With every new game Gamerz Lab will become a completely new experience to explore!\n\nWhenever you want to take a break from Game Zone you can move over to the Relax Zone and chill out. With amazing visuals and micro-activity corners like boxing corner and many more to come with every update will make the Gamerz Lab an unforgettable gaming experience for gamers.\nRelax in the lobby or use the boxing corner to release your inner Mike Tyson.\nGame booths offering different experiences (Shooters etc)\nBreathtaking visuals and amazing gameplay.\n", "short_description": "A multi-activity playground designed to immerse you into a sci-fi world of shooting games along with many more to come!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://dreamerzlab.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Dreamerz Lab Ltd", "support_website_url": null, "website_url": "https://dreamerzlab.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "ARCADE", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "641853910228653"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982468_1389650384737085_6124558328110054823_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m24AZLgrgDEQ7kNvwFqplZR&_nc_oc=AdrFverTi9xE8lGOJO-7_ZhIiLANsS_S7Th_zgWFEjxbL-n0A-heZPv3_1fX7c8ulcI&_nc_zt=3&_
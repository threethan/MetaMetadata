a&_nc_ohc=HQzXJZC66lQQ7kNvwEmWU6o&_nc_oc=Ado9qAGT0eLSAt8sfNKfuwb27ionJBVy48aj1y4tszfE_5_e1IutXr4c8OtUA2eug9g&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS_X_gbJgdOU-fOYxO_m8n7tPwSZU8H7cftuHbpb3fTUA&oe=6AF1F97E"}, {"file_name": "Screenshots_005.png", "id": "486141502473830", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75222941_486141505807163_3127839383345353654_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wdCez11uYT0Q7kNvwGAWSHK&_nc_oc=AdpShqB1UFlH55j6GVXBkh_4Tlp_-qJZtrv-FdhKAA4fVN2tFolBXHjMA5u9JFlOlxc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ1m17Gc7T3a9gzv9PTrrJeEOlSHMPiGvvzP5GJShs02A&oe=6AF1DB4D"}, {"file_name": "Screenshots_004.png", "id": "126125999624615", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974608_126126002957948_8632638290137506975_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Kfmf806Yla4Q7kNvwH5IzxO&_nc_oc=Adq7RRN3shblhB8qYra82QVwzWCFupfH5i_WQajlyKliU3BroCid76AsVfQG7t_kUgQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT9F4ROsgeu9rA6GGd4Hpo8JZlYyCbO6pQ_ErcuHVv5cA&oe=6AF1DD07"}, {"file_name": "Screenshots_007.png", "id": "545909776817911", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/86659754_545909780151244_4010903981250884421_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VaNJpkzL4t4Q7kNvwGap4KB&_nc_oc=AdrxtINXqK95VVf7g9f4x_rjBlYePzq9x3aF5IX2HImEKkC30kjZlIL_PNqBcNS760k&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSp-YsJC71nVueWIAbc7nq-rMc1l-BvjXYIDA_u6bkxsg&oe=6AF1E06E"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Gamerz Lab", "keywords": [], "long_description": "Gamerz Lab is a multi-activity, sci-fi themed playground designed to give the users a holistic gaming experience like never before.\n\nThere are two separate zones. The Game Zone offers a virtual game booth featuring a wave based shooting game. Over time more and more game booths will be added, each with exciting new games. With every new game Gamerz Lab will become a completely new experience to explore!\n\nWhenever you want to take a break from Game Zone you can move over to the Relax Zone and chill out. With amazing visuals and micro-activity corners like boxing corner and many more to come with every update will make the Gamerz Lab an unforgettable gaming experience for gamers.\nRelax in the lobby or use the boxing corner to release your inner Mike Tyson.\nGame booths offering different experiences (Shooters etc)\nBreathtaking visuals and amazing gameplay.\n", "short_description": "A multi-activity playground designed to immerse you into a sci-fi world of shooting games along with many more to come!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://dreamerzlab.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Dreamerz Lab Ltd", "support_website_url": null, "website_url": "https://dreamerzlab.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "ARCADE", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "641853910228653"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982468_1389650384737085_6124558328110054823_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4dwT6i3aAgUQ7kNvwH1sYPM&_nc_oc=AdpEeNkPR-FX4Mvi0-p8WRVpWPBSq2oknGrr_HOWc9QLS26hZYYEkZU915tRV8_PDCM&_nc_zt=3&_
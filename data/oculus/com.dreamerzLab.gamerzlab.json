gP6Q&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&oh=00_AfshIB_2sfZlXCNCWLHTp6yGEb9gnIwvXJwsRAPrgZgvmQ&oe=69A192BE"}, {"file_name": "Screenshots_005.png", "id": "486141502473830", "uri": "https://scontent-hkg1-1.oculuscdn.com/v/t64.5771-25/75222941_486141505807163_3127839383345353654_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=694OTVWGUDkQ7kNvwEwbkaB&_nc_oc=AdlJpEqNey_q8OKKtQuugFpNvMe3PmCKaDytQSyddO-ogO4SX6Wsa4Sg5vmcGBCSqLA&_nc_zt=3&_nc_ht=scontent-hkg1-1.oculuscdn.com&oh=00_AfvH1MSD5rqe_hSOihpLSMY9EzcqlUIbD6OTPwJZbNNpkw&oe=69A1ACCD"}, {"file_name": "Screenshots_004.png", "id": "126125999624615", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/38974608_126126002957948_8632638290137506975_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nqJAGeag47UQ7kNvwHe5YB7&_nc_oc=AdmkfyIcb1lmn3J084xUmPQzwHX9qtMBExzHz-E-UN-fwYk-Elavs3WtxHKyx-9Et-c&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&oh=00_AfufvcsJkcJLQECzegbYJGSLi8uX1eM08a6i_ds2IeOGkQ&oe=69A17647"}, {"file_name": "Screenshots_007.png", "id": "545909776817911", "uri": "https://scontent-hkg1-1.oculuscdn.com/v/t64.5771-25/86659754_545909780151244_4010903981250884421_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jj8pn3d9et0Q7kNvwHnOyFE&_nc_oc=Admn4Ym76SYzAShhXRPkrSC3WzJYHp4XcRffK7wR_MWnzRfhaOZ5HWZG2ZLY95IpgcU&_nc_zt=3&_nc_ht=scontent-hkg1-1.oculuscdn.com&oh=00_AfvehKlLZsKkwGZOaEmYbxqtMnCBNnclE7Hsa8SwR4Qoqg&oe=69A179AE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "527712595035285", "uri": "https://scontent-hkg4-2.oculuscdn.com/v/t64.5771-25/38974729_527712598368618_6616314205426690112_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JFq28Q6FotoQ7kNvwFsc7Iy&_nc_oc=Adlrz-5gsDo_V2eoZjfZbkc08DYJ5XnZvSm95q6KCod1yTVxn4f2hPGdyyUkxwLWev0&_nc_zt=3&_nc_ht=scontent-hkg4-2.oculuscdn.com&oh=00_Afs_3LeaQqVI2kASwBHM8x5Zx7Nj3_1z-y26mpsiQTwThA&oe=69A19F6B"}, "display_name": "Gamerz Lab", "keywords": [], "long_description": "Gamerz Lab is a multi-activity, sci-fi themed playground designed to give the users a holistic gaming experience like never before.\n\nThere are two separate zones. The Game Zone offers a virtual game booth featuring a wave based shooting game. Over time more and more game booths will be added, each with exciting new games. With every new game Gamerz Lab will become a completely new experience to explore!\n\nWhenever you want to take a break from Game Zone you can move over to the Relax Zone and chill out. With amazing visuals and micro-activity corners like boxing corner and many more to come with every update will make the Gamerz Lab an unforgettable gaming experience for gamers.\nRelax in the lobby or use the boxing corner to release your inner Mike Tyson.\nGame booths offering different experiences (Shooters etc)\nBreathtaking visuals and amazing gameplay.\n", "short_description": "A multi-activity playground designed to immerse you into a sci-fi world of shooting games along with many more to come!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://dreamerzlab.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Dreamerz Lab Ltd", "support_website_url": null, "website_url": "https://dreamerzlab.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "ARCADE", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "641853910228653"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://sco
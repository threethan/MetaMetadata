Z&_nc_oc=AdlKzQ0kNH8JgVX-J8Nc5VviKIn2crbeiFdEVTEeoEoDutbaW6HayRRCCjO836OYW4o&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfwV0lqGdWl7pBKDjSsF0-kdJrpuqbWPxB74LAIlfXJtyg&oe=69B407BE"}, {"file_name": "Screenshots_005.png", "id": "486141502473830", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75222941_486141505807163_3127839383345353654_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qa78aIWVnOgQ7kNvwEVS1c8&_nc_oc=AdnB-FANw57lgt2WqBb1cfia1H2KlOcfn97ldlul0LRkcr8Y9UGS__wBMeQf6MceBIY&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afwlw--WRALfBK_ZlJx8CFbGYRTZ-OXQkHxmQFZzCRGbQw&oe=69B421CD"}, {"file_name": "Screenshots_004.png", "id": "126125999624615", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974608_126126002957948_8632638290137506975_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=of_apGfsPIkQ7kNvwGDXXHw&_nc_oc=AdnhawmVv93AkSbrYo6TEghXc4nCdqjObXA2oLERFSaUVDcgkGS9B8GRkfjpB4o-t_o&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfwmDTmUz-ZCC31rBRq1FKmNymg_w7-eGodBoHXuRa-Lbw&oe=69B3EB47"}, {"file_name": "Screenshots_007.png", "id": "545909776817911", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/86659754_545909780151244_4010903981250884421_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NJWhsLznrCUQ7kNvwFEy9aZ&_nc_oc=AdnuQyxzUeyK23t-o0g0F8Uw33Z0fVZynhldr-l6VrRwnfhfIitMC9eWtNthtFYtN1s&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfwwBV0zofm0UsKvmbvmK_VorYddrF9Ylr7LhQzCENE7Ww&oe=69B3EEAE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "527712595035285", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974729_527712598368618_6616314205426690112_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Nd6XCmlcr78Q7kNvwHl2fwh&_nc_oc=AdmN7kJrLRL96qzO01Th7EZNb1VtQeR7MERc3oOWuJ9BhykhZmbQrq3IbCcgcyCTDtk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfycMVUfFnlyuI0ppNm68wbSUYer_Vr-9ip8bVifuV1KVA&oe=69B4146B"}, "display_name": "Gamerz Lab", "keywords": [], "long_description": "Gamerz Lab is a multi-activity, sci-fi themed playground designed to give the users a holistic gaming experience like never before.\n\nThere are two separate zones. The Game Zone offers a virtual game booth featuring a wave based shooting game. Over time more and more game booths will be added, each with exciting new games. With every new game Gamerz Lab will become a completely new experience to explore!\n\nWhenever you want to take a break from Game Zone you can move over to the Relax Zone and chill out. With amazing visuals and micro-activity corners like boxing corner and many more to come with every update will make the Gamerz Lab an unforgettable gaming experience for gamers.\nRelax in the lobby or use the boxing corner to release your inner Mike Tyson.\nGame booths offering different experiences (Shooters etc)\nBreathtaking visuals and amazing gameplay.\n", "short_description": "A multi-activity playground designed to immerse you into a sci-fi world of shooting games along with many more to come!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://dreamerzlab.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Dreamerz Lab Ltd", "support_website_url": null, "website_url": "https://dreamerzlab.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "ARCADE", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_mo
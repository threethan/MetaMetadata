a&_nc_ohc=SmbFtOhi4sYQ7kNvwFVayxf&_nc_oc=AdqVL4sczLs-M6bte3y5Ei0tqQFMbfN_OExQ7m4IO10TzFaTgs5fYqSBgnfveNbZaPQ&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNQ-aX2Zhdy6vIpX8lMRE_lrM-jmhF8JRzrIPW6_s53TQ&oe=6ADCA93E"}, {"file_name": "Screenshots_005.png", "id": "486141502473830", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/75222941_486141505807163_3127839383345353654_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FSQcX543YMYQ7kNvwHcLS9z&_nc_oc=AdokZZIPpJicYj3Tbgaatwpr6pAZBkdtemnmE_tzQa5_lh8Ocx_IVz3DZsMEehl7flQ&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNQVMIaV_BlWQCbeAqtQiysYVDEJbcp2sFWc5fJZSLt4g&oe=6ADCC34D"}, {"file_name": "Screenshots_004.png", "id": "126125999624615", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974608_126126002957948_8632638290137506975_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=X8vUP2SJWFMQ7kNvwGpnZ9P&_nc_oc=AdqJhbpXhxdxyTDKdgXaUo34L_z_Ei9jZUDEbSF8eRky8hwtagl0tPGkrFzcxdHatuw&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOVM5COXpiT4desYCQqU12UqihfFrA2iYZILZ5_Dfkt6Q&oe=6ADCC507"}, {"file_name": "Screenshots_007.png", "id": "545909776817911", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/86659754_545909780151244_4010903981250884421_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zroRAdIMkOAQ7kNvwFR3mPi&_nc_oc=AdpNO_xKtnbvgIDtwc8En2jQtY3yaSHSaHerXHZU-CWB-RmH4Jv6Lpi4uwg9sN1Vszk&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOkrtUZivOaimp_pFIueAc4c1VPMRCAtTJ6hVqT9kow0Q&oe=6ADCC86E"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Gamerz Lab", "keywords": [], "long_description": "Gamerz Lab is a multi-activity, sci-fi themed playground designed to give the users a holistic gaming experience like never before.\n\nThere are two separate zones. The Game Zone offers a virtual game booth featuring a wave based shooting game. Over time more and more game booths will be added, each with exciting new games. With every new game Gamerz Lab will become a completely new experience to explore!\n\nWhenever you want to take a break from Game Zone you can move over to the Relax Zone and chill out. With amazing visuals and micro-activity corners like boxing corner and many more to come with every update will make the Gamerz Lab an unforgettable gaming experience for gamers.\nRelax in the lobby or use the boxing corner to release your inner Mike Tyson.\nGame booths offering different experiences (Shooters etc)\nBreathtaking visuals and amazing gameplay.\n", "short_description": "A multi-activity playground designed to immerse you into a sci-fi world of shooting games along with many more to come!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://dreamerzlab.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Dreamerz Lab Ltd", "support_website_url": null, "website_url": "https://dreamerzlab.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "ARCADE", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "641853910228653"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38982468_1389650384737085_6124558328110054823_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UzjPOXl55XAQ7kNvwGf_Pnl&_nc_oc=Adqt6Bn2egIbhcfwQsDBfU9v9I2_SiNbglvXda-aWSoWlHxK38_S0vVammH5ZUl6rYI&_nc_zt=3&_
7&_nc_sid=6e7a0a&_nc_ohc=h8LAbL5VQd4Q7kNvwFDPnR3&_nc_oc=AdpX-t3RUqGRnpqct9o4To0VZEEHUaUIpoa9G20bbG2mXZ1bWiRv12bNVEx4nR6tVos&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEqJw7tAj421_xPkGjc5NNb-xY4DTFhXh3Egk2nQfJ8-Q&oe=6A8D8F3E"}, {"file_name": "Screenshots_005.png", "id": "486141502473830", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/75222941_486141505807163_3127839383345353654_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XHybNYb9digQ7kNvwFKluIn&_nc_oc=AdrEBDcRS-pf0dR75msJCTOq_4GK-avmoYnYwUzHd_e1K7MwkISBu72noJHbG3y0XeM&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHOmMovBvScUpPWheR3IVpqCaAuqpjhTIWxF3BvW30JOw&oe=6A8D710D"}, {"file_name": "Screenshots_004.png", "id": "126125999624615", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/38974608_126126002957948_8632638290137506975_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=09M8Gpy6IjwQ7kNvwHdsVbM&_nc_oc=Adqm5NrYZQDeYts0dm37_ffkMxzl-qWtvUezecxbsdkKwiWIORrFFLcXKk3DktavekY&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHYx0bUPmSFAGlwL8XA6pogfV4wqsh7TeekDjaZfd9vSg&oe=6A8D72C7"}, {"file_name": "Screenshots_007.png", "id": "545909776817911", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/86659754_545909780151244_4010903981250884421_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GoZIFfu4L5kQ7kNvwFKEf2R&_nc_oc=Adoxl7l9uUgv61WNzrxcU9mrhbrZxz9sz8WBnjBhzRBL1CsKldg9pCn3QfVg5YS-isY&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFUrtJLgngNqKZJ3apZTPauzFFDUT--_WQVPHCrk2O2Uw&oe=6A8D762E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "527712595035285", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/38974729_527712598368618_6616314205426690112_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zLhm4JxT0FAQ7kNvwFzY_5x&_nc_oc=AdpGk_bmJSptLjCMCXgB_Nkj_n3IToKTVpea_f-7HC5zS1CD5N8SlPjeqipZQqgizW8&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFUGzroDWRYhnBThdcDs5jZkMhc5Jm28XUD1D-QNXOB6A&oe=6A8D9BEB"}, "display_name": "Gamerz Lab", "keywords": [], "long_description": "Gamerz Lab is a multi-activity, sci-fi themed playground designed to give the users a holistic gaming experience like never before.\n\nThere are two separate zones. The Game Zone offers a virtual game booth featuring a wave based shooting game. Over time more and more game booths will be added, each with exciting new games. With every new game Gamerz Lab will become a completely new experience to explore!\n\nWhenever you want to take a break from Game Zone you can move over to the Relax Zone and chill out. With amazing visuals and micro-activity corners like boxing corner and many more to come with every update will make the Gamerz Lab an unforgettable gaming experience for gamers.\nRelax in the lobby or use the boxing corner to release your inner Mike Tyson.\nGame booths offering different experiences (Shooters etc)\nBreathtaking visuals and amazing gameplay.\n", "short_description": "A multi-activity playground designed to immerse you into a sci-fi world of shooting games along with many more to come!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://dreamerzlab.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Dreamerz Lab Ltd", "support_website_url": null, "website_url": "https://dreamerzlab.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "ARCADE", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDI
d&_nc_oc=AdmuNEjkfCJykcDq7k0FodvdBzkd7hPXWv0bCjtWPnfUcCTLEdqSfg-rf2AATF5Aa88&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=8&oh=00_AfyBNyJ8LZzMbMOOP-OON5EE3tCnxmpjH-44yk7aYshMdw&oe=69BD423E"}, {"file_name": "Screenshots_005.png", "id": "486141502473830", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/75222941_486141505807163_3127839383345353654_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5oPIYi19qp0Q7kNvwHrxMfI&_nc_oc=AdlAE4jXIkKsG9DOy_19_4o8qrJ0DnczxNGyZga7GcOc-PVlIwQYwZnUSFBhLUzABuE&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=8&oh=00_Afz-oTlvf0DI1AuivhNeiBoW1uBuspsd909h6vkV1Po5uA&oe=69BD5C4D"}, {"file_name": "Screenshots_004.png", "id": "126125999624615", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974608_126126002957948_8632638290137506975_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HLOWsPqQUqIQ7kNvwEUuBJ-&_nc_oc=AdleYdHRPwtPl6N4DwQSlhYyH9y8QkvuqkzGwPRJxr7GYJLVKR20VBbe8qBAw6yToKA&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=8&oh=00_AfyV9jPUKJ2hzlFpWs0uutjibRJAvrzExWFBR47h8e3Ngg&oe=69BD5E07"}, {"file_name": "Screenshots_007.png", "id": "545909776817911", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/86659754_545909780151244_4010903981250884421_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n7To-Jex7dIQ7kNvwHsZ9PO&_nc_oc=Adk3vsvXB8wZ0VSlI0-l6kHaWRhmTmHTheVetYGA0GKVxZJVLO6jPIzXEwvbzhSC_9A&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=8&oh=00_Afzqmcz6xAePXJ1b-4j9hImZy6v8OVUETiJwoErcX5YZwQ&oe=69BD292E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "527712595035285", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974729_527712598368618_6616314205426690112_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kT_nzjY5rs0Q7kNvwFo2iNZ&_nc_oc=Admzb5fJ_WNhLCfegqWvWcIcep4-5A7oEEDIwRnLV2S_oP2Vvtmwg6QfMThwxBgRC4M&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=8&oh=00_Afw4sxn15annrjTdp-9mU6krRDa9PUzqQ_3XGOcThuIrcw&oe=69BD4EEB"}, "display_name": "Gamerz Lab", "keywords": [], "long_description": "Gamerz Lab is a multi-activity, sci-fi themed playground designed to give the users a holistic gaming experience like never before.\n\nThere are two separate zones. The Game Zone offers a virtual game booth featuring a wave based shooting game. Over time more and more game booths will be added, each with exciting new games. With every new game Gamerz Lab will become a completely new experience to explore!\n\nWhenever you want to take a break from Game Zone you can move over to the Relax Zone and chill out. With amazing visuals and micro-activity corners like boxing corner and many more to come with every update will make the Gamerz Lab an unforgettable gaming experience for gamers.\nRelax in the lobby or use the boxing corner to release your inner Mike Tyson.\nGame booths offering different experiences (Shooters etc)\nBreathtaking visuals and amazing gameplay.\n", "short_description": "A multi-activity playground designed to immerse you into a sci-fi world of shooting games along with many more to come!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://dreamerzlab.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Dreamerz Lab Ltd", "support_website_url": null, "website_url": "https://dreamerzlab.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "ARCADE", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_mo
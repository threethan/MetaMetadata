A&_nc_oc=AdkG3tTGSuHBpi2FLLyV26vyuaKrx286MDYX5me7hXhO0weaKDKovRoAR7H1Qe3-3UU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfwLv4bdzfm-b-X80ooUH83WdG26Bjsp3_40tfMLWijRUA&oe=69AD703E"}, {"file_name": "Screenshots_005.png", "id": "486141502473830", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75222941_486141505807163_3127839383345353654_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rgOCNcE82mYQ7kNvwFfaD7s&_nc_oc=AdkSZlbiaRolCiaT-WG-uNiLXv1jAh1HEIUZ7SlASB5pJV7Xb0XbtGMwAxaRG01WhQ4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfwPNBTJKRiZwDI5wohrxTfBt5s_gD9fni622KFn6QeEzA&oe=69AD8A4D"}, {"file_name": "Screenshots_004.png", "id": "126125999624615", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974608_126126002957948_8632638290137506975_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wYO8wI4WsCsQ7kNvwGoxlKO&_nc_oc=AdkEBwR85Xdl2QlWWlxE-_b4hWuuwWxvwY1SniGVatgVfWpybq64rLchRLp-xj-pGEg&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfxEIJpoHWB055XwZgJImex6DHDnimDdR2t62TKAfYK2rg&oe=69AD53C7"}, {"file_name": "Screenshots_007.png", "id": "545909776817911", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/86659754_545909780151244_4010903981250884421_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s1UyqJaFWOoQ7kNvwHxcJ9H&_nc_oc=AdmmIUV_ipXRl4j22fRHhROQJMzuASZI2fp2lnQjoo-e6A8zMWTcJwXEQrXxgW5ozDw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afy_PCG_JeovwrqFVR0USCyvvt-l86azi5U0vaXZSpPI4Q&oe=69AD572E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "527712595035285", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974729_527712598368618_6616314205426690112_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MlyqLnTU7zoQ7kNvwGSDBIL&_nc_oc=AdlZJqShu9QCM4dlgCU45QHGn4Zna7lplzEC68gYhBxv9ZdCsBYZlm_aIHWWaC0LuvU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afwdg6qT1ydHQ7s3ubevcBGAvTNvuH_sJPA1uvGG-6lXWw&oe=69AD7CEB"}, "display_name": "Gamerz Lab", "keywords": [], "long_description": "Gamerz Lab is a multi-activity, sci-fi themed playground designed to give the users a holistic gaming experience like never before.\n\nThere are two separate zones. The Game Zone offers a virtual game booth featuring a wave based shooting game. Over time more and more game booths will be added, each with exciting new games. With every new game Gamerz Lab will become a completely new experience to explore!\n\nWhenever you want to take a break from Game Zone you can move over to the Relax Zone and chill out. With amazing visuals and micro-activity corners like boxing corner and many more to come with every update will make the Gamerz Lab an unforgettable gaming experience for gamers.\nRelax in the lobby or use the boxing corner to release your inner Mike Tyson.\nGame booths offering different experiences (Shooters etc)\nBreathtaking visuals and amazing gameplay.\n", "short_description": "A multi-activity playground designed to immerse you into a sci-fi world of shooting games along with many more to come!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://dreamerzlab.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Dreamerz Lab Ltd", "support_website_url": null, "website_url": "https://dreamerzlab.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "ARCADE", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_mo
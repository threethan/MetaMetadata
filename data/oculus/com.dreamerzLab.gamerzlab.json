L&_nc_oc=AdnEWYcSUiG8MAOFz2bx6CXNHld3LF4YhrbrfORz1iD4IX4jMclOcGMORommxrI51YA&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfzyeSDYPSEcasuotuGgxaeJy6prgbr-5lxUgwsgrgqxsw&oe=69B2B63E"}, {"file_name": "Screenshots_005.png", "id": "486141502473830", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75222941_486141505807163_3127839383345353654_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qa78aIWVnOgQ7kNvwGfP7-f&_nc_oc=AdnqiZ7xxk1PHXAE67V5E6rKTdOmvqiObeUTejL5XVWEbs-Y_2NHJ7wPpKOiKN7mAEE&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfwSD0oprPY0Mj64dF0gdXYEfMaQumfNO35cmADW7sj6Dw&oe=69B2D04D"}, {"file_name": "Screenshots_004.png", "id": "126125999624615", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974608_126126002957948_8632638290137506975_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lCJfCFGZePkQ7kNvwFe-w1W&_nc_oc=Adkv0I1iMgNirMB1UTXJeZm3dGybWZuXuPNrc7J3yR3_wud5pHryKC6u_sgrCe8GUEA&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfwSyFXtRZiRst7wmYwx9cD7aTnOAk3A9fkZqz-rFm5H-g&oe=69B299C7"}, {"file_name": "Screenshots_007.png", "id": "545909776817911", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/86659754_545909780151244_4010903981250884421_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NJWhsLznrCUQ7kNvwF2I-Ne&_nc_oc=AdlLeGQpbt2Plvq5cqbl9Gpax5iOqcc_2TPn4WMLNJtFGk_j2odcsBfSs2WcZBpUUCQ&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfzMjSHBn65yhUZyPt9QZYWcTYwP0P3iM9nnlIaSL-du_Q&oe=69B29D2E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "527712595035285", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974729_527712598368618_6616314205426690112_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Nd6XCmlcr78Q7kNvwE-3wA6&_nc_oc=AdlFTLZnZiI7HOOycZrpUQcI7q8Z1YLjul6r-Q7NBA3I4QHA-971Stc99vbFt-6xAXM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfyWme7f2HPZANBM45kOjwBIobhrHDCnL8rXIPHKrP9tzg&oe=69B2C2EB"}, "display_name": "Gamerz Lab", "keywords": [], "long_description": "Gamerz Lab is a multi-activity, sci-fi themed playground designed to give the users a holistic gaming experience like never before.\n\nThere are two separate zones. The Game Zone offers a virtual game booth featuring a wave based shooting game. Over time more and more game booths will be added, each with exciting new games. With every new game Gamerz Lab will become a completely new experience to explore!\n\nWhenever you want to take a break from Game Zone you can move over to the Relax Zone and chill out. With amazing visuals and micro-activity corners like boxing corner and many more to come with every update will make the Gamerz Lab an unforgettable gaming experience for gamers.\nRelax in the lobby or use the boxing corner to release your inner Mike Tyson.\nGame booths offering different experiences (Shooters etc)\nBreathtaking visuals and amazing gameplay.\n", "short_description": "A multi-activity playground designed to immerse you into a sci-fi world of shooting games along with many more to come!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://dreamerzlab.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Dreamerz Lab Ltd", "support_website_url": null, "website_url": "https://dreamerzlab.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "ARCADE", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_mo
a&_nc_ohc=WFJlwr6fP9wQ7kNvwHmgA2Q&_nc_oc=Ado2eeMkkqwTyNtDPaXC59DFIjcKy8WJ0k65NYNSejpgDYaMYhNbNi7iL-pHlWn_AmE&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOpca8Qql5RjPow0LXg59SyYBMYvhZ1Oa3yFIqMqC0v0Q&oe=6AE1EF3E"}, {"file_name": "Screenshots_005.png", "id": "486141502473830", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75222941_486141505807163_3127839383345353654_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IkVLAPqMlTUQ7kNvwEvR0Xk&_nc_oc=AdqQoK8zcCSQvMKzXIQ5R9R2tSiTHo5e-6O2TRPjAb0yZGjUsWoV9CBlfXXwyVrY-1Y&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOLzSIwxVr2Vwb-3YbYQ5NIN47Z2cuGSkVp6pBPSodi4A&oe=6AE2094D"}, {"file_name": "Screenshots_004.png", "id": "126125999624615", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974608_126126002957948_8632638290137506975_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nUp6edkkv9oQ7kNvwEh7fGy&_nc_oc=Adr5bEaKVsnsXMQFkEU0wxFJf99bq78qlKukP3EsDLy4dwitVPD-5Oi7EG3fDy54F_I&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNngKUxNhJeNkF9vXVC_NvcdX4cmfo-zfeXUZy4Fff-ZQ&oe=6AE20B07"}, {"file_name": "Screenshots_007.png", "id": "545909776817911", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/86659754_545909780151244_4010903981250884421_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yUHb4rWWWZkQ7kNvwFRZHYQ&_nc_oc=AdrsoyZ2yzAO49SbW-wMLfI7I01M0Ea06z3r1YARQJdnULckWRHs7tZ-bPrssCviiKs&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOrAEeaibpHyMBbnd9o0AGz4Uvm0YwvZnm-vnNuhjYCBQ&oe=6AE20E6E"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Gamerz Lab", "keywords": [], "long_description": "Gamerz Lab is a multi-activity, sci-fi themed playground designed to give the users a holistic gaming experience like never before.\n\nThere are two separate zones. The Game Zone offers a virtual game booth featuring a wave based shooting game. Over time more and more game booths will be added, each with exciting new games. With every new game Gamerz Lab will become a completely new experience to explore!\n\nWhenever you want to take a break from Game Zone you can move over to the Relax Zone and chill out. With amazing visuals and micro-activity corners like boxing corner and many more to come with every update will make the Gamerz Lab an unforgettable gaming experience for gamers.\nRelax in the lobby or use the boxing corner to release your inner Mike Tyson.\nGame booths offering different experiences (Shooters etc)\nBreathtaking visuals and amazing gameplay.\n", "short_description": "A multi-activity playground designed to immerse you into a sci-fi world of shooting games along with many more to come!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://dreamerzlab.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Dreamerz Lab Ltd", "support_website_url": null, "website_url": "https://dreamerzlab.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "ARCADE", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "641853910228653"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982468_1389650384737085_6124558328110054823_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CjtF_Y7VmWAQ7kNvwHOIlYx&_nc_oc=Adpon21MBGdD0ENid6M7dw1mEDtM4SGd385yvPVdrWGMW3GY48edqv2NGp7qEa2eVug&_nc_zt=3&_
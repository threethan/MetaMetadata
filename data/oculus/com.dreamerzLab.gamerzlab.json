=6e7a0a&_nc_ohc=BIEHj7EvpmYQ7kNvwFedc6P&_nc_oc=AdoFrFSJYtu81mOwVHDLmu57-i8_Qy8gKzHhb75ftBF40rsHXKzzGaCc0MVign9Kckg&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7K_jjBnIOEwblTZWbHaF6smKYog97YOlJjGQPxkNS9FQ&oe=6A11A23E"}, {"file_name": "Screenshots_005.png", "id": "486141502473830", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/75222941_486141505807163_3127839383345353654_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cqzlmt9xAYUQ7kNvwFAr40z&_nc_oc=AdoWePZ0doJBRW3WIQqbQl8yN47ed5jbDboN3n_RtiPSJezMcCsaHWExScnZYjWoRus&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4esTwcdBu6uMP5BzK76Q9-eKmZ_Qe6ipTfUTe6_LZW3A&oe=6A11BC4D"}, {"file_name": "Screenshots_004.png", "id": "126125999624615", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/38974608_126126002957948_8632638290137506975_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OlO2dUNErxQQ7kNvwFJScMm&_nc_oc=AdoBLt80ps5H2EhYANZm19vKDxXoq6Xujc6Rq3EQOzRXq7rY_KNEDQVcNgAwUl7zvJM&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5CUJJv-MkPqXj1SHmQP8Y338U3h9mN_490JGsdI2UupQ&oe=6A11BE07"}, {"file_name": "Screenshots_007.png", "id": "545909776817911", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/86659754_545909780151244_4010903981250884421_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2YzSnyseAyIQ7kNvwFE54jg&_nc_oc=AdoSXN0z_ad7sZuTjpcYPsUA65m9KjfkqQ08-5W2e6i5kw-r7lqKvEiVdfaDHAzdO0I&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5ji_kjLVLlbyz-cGjp-R-8Xi59lHTEKbVnSRg1n3At0A&oe=6A11C16E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "527712595035285", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/38974729_527712598368618_6616314205426690112_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EWZ8Y_P3dp8Q7kNvwHYdZBs&_nc_oc=AdroeMd6FaUK88U0EEa7gpPBIc6QNpV7TlJgrwIvPup9N60cFIFHMguqLuirMR8jVkc&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4LEUGbgAO49OopplSPfJjhqqPLE2WDIK2QHtNwU2LM8g&oe=6A11AEEB"}, "display_name": "Gamerz Lab", "keywords": [], "long_description": "Gamerz Lab is a multi-activity, sci-fi themed playground designed to give the users a holistic gaming experience like never before.\n\nThere are two separate zones. The Game Zone offers a virtual game booth featuring a wave based shooting game. Over time more and more game booths will be added, each with exciting new games. With every new game Gamerz Lab will become a completely new experience to explore!\n\nWhenever you want to take a break from Game Zone you can move over to the Relax Zone and chill out. With amazing visuals and micro-activity corners like boxing corner and many more to come with every update will make the Gamerz Lab an unforgettable gaming experience for gamers.\nRelax in the lobby or use the boxing corner to release your inner Mike Tyson.\nGame booths offering different experiences (Shooters etc)\nBreathtaking visuals and amazing gameplay.\n", "short_description": "A multi-activity playground designed to immerse you into a sci-fi world of shooting games along with many more to come!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://dreamerzlab.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Dreamerz Lab Ltd", "support_website_url": null, "website_url": "https://dreamerzlab.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "ARCADE", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCA
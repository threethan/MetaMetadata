Q7RQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfuEI_2H-rEuClN9g9Y_pi61Evl0TVFSkVm1CxGEG9f3Pg&oe=699D9E3E"}, {"file_name": "Screenshots_005.png", "id": "486141502473830", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75222941_486141505807163_3127839383345353654_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TJrbGCrkr24Q7kNvwE7zrbW&_nc_oc=Adnmc3vcFIl8Ctbc23yqQlxUyVao0Q5CA0ISgbdYRMp3Y4SRFaMlkN_HU1xn5j5HoTU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfvE3XnzgewSKh2vuHd8YKlYXGyNBqKOnoehuhgO4E8XoQ&oe=699D800D"}, {"file_name": "Screenshots_004.png", "id": "126125999624615", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974608_126126002957948_8632638290137506975_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QwAPZ9GWnMoQ7kNvwFckemI&_nc_oc=AdmilJ-H_NtkqYISAOFuKLry-DhF-K81_h6Gu_SKCpEsYnL1ZB8WlqhI4pXTMikzFuE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Aft3Y4tfOUEiuOY9OFernMohqO7cCMWljt70tAjILv79ow&oe=699D81C7"}, {"file_name": "Screenshots_007.png", "id": "545909776817911", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/86659754_545909780151244_4010903981250884421_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=t5_jeG0a1EIQ7kNvwErdlIC&_nc_oc=AdkJI-glN1ezYy3zQakxJVQmQVjrFM9nZYeGdelxeUlAmVFbvyHdlfHTokaBAEd9GWI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfvSctoe3jlHa4236g9JBmUFaxidOhqsyq1avTIjMENs9w&oe=699D852E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "527712595035285", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974729_527712598368618_6616314205426690112_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x8Vfim3Pd5AQ7kNvwGGcrKx&_nc_oc=Adl2dDbLtyN9-5zbhraR0zCmTV3EbDMgTVUyVdHvFidiOz3GotV91umDwjtyQupxO58&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfuCtQAM0YEdw_qUus3rls0exyOC9yvzLrpVAPzgjBUHIw&oe=699DAAEB"}, "display_name": "Gamerz Lab", "keywords": [], "long_description": "Gamerz Lab is a multi-activity, sci-fi themed playground designed to give the users a holistic gaming experience like never before.\n\nThere are two separate zones. The Game Zone offers a virtual game booth featuring a wave based shooting game. Over time more and more game booths will be added, each with exciting new games. With every new game Gamerz Lab will become a completely new experience to explore!\n\nWhenever you want to take a break from Game Zone you can move over to the Relax Zone and chill out. With amazing visuals and micro-activity corners like boxing corner and many more to come with every update will make the Gamerz Lab an unforgettable gaming experience for gamers.\nRelax in the lobby or use the boxing corner to release your inner Mike Tyson.\nGame booths offering different experiences (Shooters etc)\nBreathtaking visuals and amazing gameplay.\n", "short_description": "A multi-activity playground designed to immerse you into a sci-fi world of shooting games along with many more to come!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://dreamerzlab.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Dreamerz Lab Ltd", "support_website_url": null, "website_url": "https://dreamerzlab.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "ARCADE", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "641853910228653"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://sco
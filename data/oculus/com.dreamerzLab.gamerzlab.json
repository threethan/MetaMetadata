8&_nc_oc=AdmI7JAZll8wpXigurSZuid-zCKMwhtQduJ6euV7cDgV7ovOYxqUD2q1XULwkWPP_tE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfzgQc6Q7-ilTwU81HllSkXSmkKY0F23lj1vYdk2jpXZ6A&oe=69B5593E"}, {"file_name": "Screenshots_005.png", "id": "486141502473830", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75222941_486141505807163_3127839383345353654_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qa78aIWVnOgQ7kNvwGPWujU&_nc_oc=Adl2pWrtPh20Bqm5CHieRP3eI02_G0Qq0rQ19MWutXabgLx7v5SFn8NZ6GnIRaMrTAc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfzbP2arWwt--HQiPZScGGCL7Mm9-Ylk9VxqDHu-MkJhwQ&oe=69B53B0D"}, {"file_name": "Screenshots_004.png", "id": "126125999624615", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974608_126126002957948_8632638290137506975_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=of_apGfsPIkQ7kNvwEZ_n4w&_nc_oc=Adkj7hE69OMsfcD7eD7pZuVVt05asn1vq-rb_Aw3qdxwCfUYn2nJQ89EaNBS2SsFLFE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfyMxhLyYO5vPfV8AP__dbHX1dUX4FJ2b0WySJvALa9gLw&oe=69B53CC7"}, {"file_name": "Screenshots_007.png", "id": "545909776817911", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/86659754_545909780151244_4010903981250884421_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dPmRUncZX-oQ7kNvwFc9bnQ&_nc_oc=AdkucwAJn5Jq6Xd_awocaKQ5wkgIIkC9YaWGlPVfpK8ZSftPvfACV-p2SeI-Haa2ksY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfxuLNdFSII3bD-h7aYZi1zrJGpoQAtgqCSPnETnoqJyGw&oe=69B5402E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "527712595035285", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974729_527712598368618_6616314205426690112_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bGEHTdkD_koQ7kNvwGtFhoW&_nc_oc=AdmYNvyZJWWTm5KVAqn45BUqv4pTPyuO-IbtgeHU4teING9ABEvCfFhEflydZqySS4I&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_Afw9OLI8lWlP-odSs7VxcK_Q1KLbj1YHIgZ8dAVbpONcNg&oe=69B565EB"}, "display_name": "Gamerz Lab", "keywords": [], "long_description": "Gamerz Lab is a multi-activity, sci-fi themed playground designed to give the users a holistic gaming experience like never before.\n\nThere are two separate zones. The Game Zone offers a virtual game booth featuring a wave based shooting game. Over time more and more game booths will be added, each with exciting new games. With every new game Gamerz Lab will become a completely new experience to explore!\n\nWhenever you want to take a break from Game Zone you can move over to the Relax Zone and chill out. With amazing visuals and micro-activity corners like boxing corner and many more to come with every update will make the Gamerz Lab an unforgettable gaming experience for gamers.\nRelax in the lobby or use the boxing corner to release your inner Mike Tyson.\nGame booths offering different experiences (Shooters etc)\nBreathtaking visuals and amazing gameplay.\n", "short_description": "A multi-activity playground designed to immerse you into a sci-fi world of shooting games along with many more to come!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://dreamerzlab.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Dreamerz Lab Ltd", "support_website_url": null, "website_url": "https://dreamerzlab.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "ARCADE", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_mo
a&_nc_ohc=2z63NsahyCEQ7kNvwG6h-V0&_nc_oc=Ado19NAvOBAGilAKrNKPvDwyMInJ2jDVr8WQ0XyjJ27us4f52UF-tulWx4D_9r7h46Q&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTdNmcWG9KGP_mIjwh6YDB4zAM2B-btVisLIyQuqBUKjA&oe=6AF73F7E"}, {"file_name": "Screenshots_005.png", "id": "486141502473830", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75222941_486141505807163_3127839383345353654_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n1Gaj9_s4PEQ7kNvwENn5mD&_nc_oc=AdpisJ6-ZdaYxtU_EUD4Bdy3Q9W5c7Kz-4_9onhRYGDSQ7ArY4F06XusQDAaPugQoRE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQIWp5kbTk3naBA6X8eDhOvzMe_wD4CHzp-pKtN8Kny3w&oe=6AF7214D"}, {"file_name": "Screenshots_004.png", "id": "126125999624615", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974608_126126002957948_8632638290137506975_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0diZMOv4tQgQ7kNvwGTAXfT&_nc_oc=AdrtsFWdZd4g_HjFxqqcm6F0e7J5kvYTa_gRmk_AQVLjDE1mV3setV9FKHf9XoCcn8A&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRxNUYng1wDXnM-EY0biAn60K-QoZz6Jf8OWWtlMjVDXg&oe=6AF72307"}, {"file_name": "Screenshots_007.png", "id": "545909776817911", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/86659754_545909780151244_4010903981250884421_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Zw94zYl5SHsQ7kNvwHlR5x9&_nc_oc=AdoZ3fJd4SlmjKBctb9QCowhOUOjwtUWy60MZF8xjNRjUiH6THWjVMTDf0UxcjWqiNQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT0C1zZoFc0gBl6RyDGX81OGivz-XHmvyjpBR9fCUVpxw&oe=6AF7266E"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Gamerz Lab", "keywords": [], "long_description": "Gamerz Lab is a multi-activity, sci-fi themed playground designed to give the users a holistic gaming experience like never before.\n\nThere are two separate zones. The Game Zone offers a virtual game booth featuring a wave based shooting game. Over time more and more game booths will be added, each with exciting new games. With every new game Gamerz Lab will become a completely new experience to explore!\n\nWhenever you want to take a break from Game Zone you can move over to the Relax Zone and chill out. With amazing visuals and micro-activity corners like boxing corner and many more to come with every update will make the Gamerz Lab an unforgettable gaming experience for gamers.\nRelax in the lobby or use the boxing corner to release your inner Mike Tyson.\nGame booths offering different experiences (Shooters etc)\nBreathtaking visuals and amazing gameplay.\n", "short_description": "A multi-activity playground designed to immerse you into a sci-fi world of shooting games along with many more to come!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://dreamerzlab.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Dreamerz Lab Ltd", "support_website_url": null, "website_url": "https://dreamerzlab.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "ARCADE", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "641853910228653"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982468_1389650384737085_6124558328110054823_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D1yJcFVPhIMQ7kNvwGpb2H0&_nc_oc=AdocGeKGu_LYVpooskGc_MVOkWmU40HPy14yGDuXDLyvQfsYbemNptM18K6rbkJKoVQ&_nc_zt=3&_
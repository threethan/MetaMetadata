a&_nc_ohc=eTZDdt96vTMQ7kNvwG0Ve-H&_nc_oc=Adpj-jWNJdL5-emRhSvhgtHc9W5tnqk9PMhY7lQK9d_sS2G3SE68J7wMCSy2nkINJjg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP0OhixozdSwaZ8W2e9kLIc52rkYMTZ-9zxtOJbGNRwAw&oe=6ADDFABE"}, {"file_name": "Screenshots_005.png", "id": "486141502473830", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75222941_486141505807163_3127839383345353654_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FSQcX543YMYQ7kNvwGJcGqm&_nc_oc=AdpLgMbOqKS9oWs02MBEJe0cQuYaHo7Opg8i7UXuxRKbtHPE9Sjl3y2TRKWbs-obySM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM3GzAr7fUzx2hFtNKdyoXIsEElvaAO4p87cWPqj5nUjw&oe=6ADE14CD"}, {"file_name": "Screenshots_004.png", "id": "126125999624615", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974608_126126002957948_8632638290137506975_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=X8vUP2SJWFMQ7kNvwGimetN&_nc_oc=AdqCEeXvHRpRF8Qyd--5qozsWKHvZ_SC1rXMWV7NF8np9qfosHVRIhPnwbPFC8GcgsQ&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNlULzxCfbfFIV0tNr-l15wO0lPPh7kFYGtE5hoYbmtWw&oe=6ADE1687"}, {"file_name": "Screenshots_007.png", "id": "545909776817911", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/86659754_545909780151244_4010903981250884421_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RDO2-uKhIE0Q7kNvwF9cSZH&_nc_oc=AdqAFcxjJEbGik1v8brohwGd46uRN9LTu8YqFDzlGopnkPspLwR-KUMqCZ3xpRafmXo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNV7RzLIroCGjE4OpxSQtz8zycpG0K-UZtDO3ObvjG8tQ&oe=6ADE19EE"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Gamerz Lab", "keywords": [], "long_description": "Gamerz Lab is a multi-activity, sci-fi themed playground designed to give the users a holistic gaming experience like never before.\n\nThere are two separate zones. The Game Zone offers a virtual game booth featuring a wave based shooting game. Over time more and more game booths will be added, each with exciting new games. With every new game Gamerz Lab will become a completely new experience to explore!\n\nWhenever you want to take a break from Game Zone you can move over to the Relax Zone and chill out. With amazing visuals and micro-activity corners like boxing corner and many more to come with every update will make the Gamerz Lab an unforgettable gaming experience for gamers.\nRelax in the lobby or use the boxing corner to release your inner Mike Tyson.\nGame booths offering different experiences (Shooters etc)\nBreathtaking visuals and amazing gameplay.\n", "short_description": "A multi-activity playground designed to immerse you into a sci-fi world of shooting games along with many more to come!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://dreamerzlab.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Dreamerz Lab Ltd", "support_website_url": null, "website_url": "https://dreamerzlab.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "ARCADE", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "641853910228653"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982468_1389650384737085_6124558328110054823_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UzjPOXl55XAQ7kNvwHEtOdM&_nc_oc=Ado48eXLgNnBmO-ta7UY-tuI5JoEjVGK3WAWSX4W0caWgHfBsXSTYxMGJidxlJxj1hk&_nc_zt=3&_
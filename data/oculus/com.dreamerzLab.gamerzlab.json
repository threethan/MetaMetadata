_&_nc_oc=AdlKmrVyv0cgZYTRKOFUQ1hwTnUm4iE6Bl33aEAE-zKeiYIZtEXr-gYRMqW8UMKa_Ek&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfzgHwrm9KfuOC49_smsjyM5Ui8xSq0c2kmCdDzFxvhzaQ&oe=69B164BE"}, {"file_name": "Screenshots_005.png", "id": "486141502473830", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75222941_486141505807163_3127839383345353654_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2UcZdn5D5CUQ7kNvwGDkBob&_nc_oc=AdnN0v6Ir7oIaEhIq9QX-dCKfrHJU1LvvivIQVIPWGPQ3P_CscE0EaNpLbKHIYxV_F8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfwwfNh84wwiFe3Ausc9MmH9GpJ5NIQrOY2UhUtGhTdv2w&oe=69B1468D"}, {"file_name": "Screenshots_004.png", "id": "126125999624615", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974608_126126002957948_8632638290137506975_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lCJfCFGZePkQ7kNvwHSx_3P&_nc_oc=AdnmRmdXoyX0pOK1yRxuBkfBltrd1768gEHMFY2oDl-zOHtm6p45O6NFtflHuxRO7t4&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfzbAppSDtr3N2qR4mI1GLUXfFCiHvVGthUrvTDu0pKvXA&oe=69B14847"}, {"file_name": "Screenshots_007.png", "id": "545909776817911", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/86659754_545909780151244_4010903981250884421_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NJWhsLznrCUQ7kNvwGI89mK&_nc_oc=AdkZvJ5_NsVx1yJqFWPjRp2oRACU8uVj0yJEbDNo62C2RndYnpP1m8vHncTEEoaoYHQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfwEvGPo9zy18o7AdY9IoMRgOb-QbcVuXS1WUcPhBE0rPQ&oe=69B14BAE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "527712595035285", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974729_527712598368618_6616314205426690112_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Nd6XCmlcr78Q7kNvwFxOgOH&_nc_oc=AdkBqDg2NXqf3dgkksvAI6xivFQChsS8MMb2Y8V0ysPSXeNXOU0SqeMEQ-nw9rMj8gk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfyB_MdTqVp-gQQKzJ4dSiWE-D4jZWD24nWYEziwC5zydg&oe=69B1716B"}, "display_name": "Gamerz Lab", "keywords": [], "long_description": "Gamerz Lab is a multi-activity, sci-fi themed playground designed to give the users a holistic gaming experience like never before.\n\nThere are two separate zones. The Game Zone offers a virtual game booth featuring a wave based shooting game. Over time more and more game booths will be added, each with exciting new games. With every new game Gamerz Lab will become a completely new experience to explore!\n\nWhenever you want to take a break from Game Zone you can move over to the Relax Zone and chill out. With amazing visuals and micro-activity corners like boxing corner and many more to come with every update will make the Gamerz Lab an unforgettable gaming experience for gamers.\nRelax in the lobby or use the boxing corner to release your inner Mike Tyson.\nGame booths offering different experiences (Shooters etc)\nBreathtaking visuals and amazing gameplay.\n", "short_description": "A multi-activity playground designed to immerse you into a sci-fi world of shooting games along with many more to come!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://dreamerzlab.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Dreamerz Lab Ltd", "support_website_url": null, "website_url": "https://dreamerzlab.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "ARCADE", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_mo
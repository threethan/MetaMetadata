2&_nc_oc=Adlnuf4rdqzyxF9YS5EZQ6aT2lgP-ut6EUaDApoT9Ckejy1UtJP2jVJoxX0Hoe4bUvg&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=8&oh=00_Afz7AknyPJq94KwOQgl2H2jsf4j7JLAf1QkIyQ2Jt1M2cg&oe=69BA9F3E"}, {"file_name": "Screenshots_005.png", "id": "486141502473830", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/75222941_486141505807163_3127839383345353654_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5oPIYi19qp0Q7kNvwHvpDa2&_nc_oc=AdmRBShvxgf6mEgKDQkjRonjXjETPdVPkZHtEKz-34oF9ZiTPQ1Tki3z6vuKcPRdU3I&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_AfwMRlcnzEysoC-vMhUqAd-I_txnQ4HkziDG7JVnNZfboQ&oe=69BAB94D"}, {"file_name": "Screenshots_004.png", "id": "126125999624615", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974608_126126002957948_8632638290137506975_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4qLsdOah_zUQ7kNvwH9is4j&_nc_oc=Adk0gyplHZCccRTq7zY7-yFlYd5jM8gUuu9EyZuQWP1sSyFZXYYa2LbcjeP4SSWRUdw&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=8&oh=00_AfzmJSqsG_YIKCNJUKsxq9OMwMiaYwK-nCvBKH94SNGjgQ&oe=69BA82C7"}, {"file_name": "Screenshots_007.png", "id": "545909776817911", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/86659754_545909780151244_4010903981250884421_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x_UMV4UwaY4Q7kNvwGKkXcE&_nc_oc=Adk_iexjogwSQ8wpiVvGuSn8hZtbKpnGjauRuTFuODMDBNkegy-ao85kNeHG9JYiRcQ&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_AfxnxWQRSdcoDC0vtY6QMIkl9JKPt3be6rGcM1z1iTP1lw&oe=69BA862E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "527712595035285", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974729_527712598368618_6616314205426690112_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1qRBxUpXqHoQ7kNvwHSBKcY&_nc_oc=Adn3q3qJC6afQesb8zMwMOSDwITbwh0011W2LyMw1S4Bl6p7aLzIGxmDLKHiLqXbU8A&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_AfxstSBNw2t0cDJvFWBPn0nHsMsM-iu_XziK0cfb-08l9Q&oe=69BAABEB"}, "display_name": "Gamerz Lab", "keywords": [], "long_description": "Gamerz Lab is a multi-activity, sci-fi themed playground designed to give the users a holistic gaming experience like never before.\n\nThere are two separate zones. The Game Zone offers a virtual game booth featuring a wave based shooting game. Over time more and more game booths will be added, each with exciting new games. With every new game Gamerz Lab will become a completely new experience to explore!\n\nWhenever you want to take a break from Game Zone you can move over to the Relax Zone and chill out. With amazing visuals and micro-activity corners like boxing corner and many more to come with every update will make the Gamerz Lab an unforgettable gaming experience for gamers.\nRelax in the lobby or use the boxing corner to release your inner Mike Tyson.\nGame booths offering different experiences (Shooters etc)\nBreathtaking visuals and amazing gameplay.\n", "short_description": "A multi-activity playground designed to immerse you into a sci-fi world of shooting games along with many more to come!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://dreamerzlab.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Dreamerz Lab Ltd", "support_website_url": null, "website_url": "https://dreamerzlab.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "ARCADE", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_mo
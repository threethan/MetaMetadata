Bjzk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfvuklNJfPzcZVbr8B0epsitCGl9TLBCbkgMX8lYn_ObnA&oe=6999A9BE"}, {"file_name": "Screenshots_005.png", "id": "486141502473830", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75222941_486141505807163_3127839383345353654_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i5uK9aPn6QsQ7kNvwGlVPeC&_nc_oc=Admcw0sFOxI6Jb2eUsN0IL2qj2mlVmz1yXiFoGvgyCSFynkHrWOH2QEkkwPUTufavsY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfsibyOzNet9nwRX1sNyATIn4MmYKhqYbJ8paEqUMMH_JA&oe=6999C3CD"}, {"file_name": "Screenshots_004.png", "id": "126125999624615", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974608_126126002957948_8632638290137506975_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7nNn-h5prvMQ7kNvwGuXEED&_nc_oc=Admv829GA_p4pQXsC2ET4IS-9XfznrfMVGLnLntu8ZoOo0vDFMCZ69NHRlL5r9J-TyY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AftHETnvIuKj0utq_lW42KCS6Jdplef5MRzMACaclkMroA&oe=69998D47"}, {"file_name": "Screenshots_007.png", "id": "545909776817911", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/86659754_545909780151244_4010903981250884421_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8-WPFO1pWrEQ7kNvwE55JC1&_nc_oc=AdlvG0Q6S6I1eqQ08NOk3-oHYMSEq8xD8WmMBpMe4AOpen9vRuSf9wPZtMGbbJldXKw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfvoIySQ4wx7AQoeKD_o3a_hR9UXcxLE047ieirX0UFuqw&oe=699990AE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "527712595035285", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974729_527712598368618_6616314205426690112_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s8fzqkRw0iUQ7kNvwHGKPM_&_nc_oc=AdmwAa-Akxh4TbP2Ot_40nfcVzUFmIJSsBgGp0kjzy302NS2aEautZYHPO5HDLrpB7s&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Afv_AHaGpwzSN-jbXO1RUsf6PYVxYceAm6_iufFWfS50-Q&oe=6999B66B"}, "display_name": "Gamerz Lab", "keywords": [], "long_description": "Gamerz Lab is a multi-activity, sci-fi themed playground designed to give the users a holistic gaming experience like never before.\n\nThere are two separate zones. The Game Zone offers a virtual game booth featuring a wave based shooting game. Over time more and more game booths will be added, each with exciting new games. With every new game Gamerz Lab will become a completely new experience to explore!\n\nWhenever you want to take a break from Game Zone you can move over to the Relax Zone and chill out. With amazing visuals and micro-activity corners like boxing corner and many more to come with every update will make the Gamerz Lab an unforgettable gaming experience for gamers.\nRelax in the lobby or use the boxing corner to release your inner Mike Tyson.\nGame booths offering different experiences (Shooters etc)\nBreathtaking visuals and amazing gameplay.\n", "short_description": "A multi-activity playground designed to immerse you into a sci-fi world of shooting games along with many more to come!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://dreamerzlab.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Dreamerz Lab Ltd", "support_website_url": null, "website_url": "https://dreamerzlab.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "ARCADE", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "641853910228653"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://sco
a&_nc_ohc=WFJlwr6fP9wQ7kNvwHdkfTx&_nc_oc=AdqQLoJAynaVa9VRlOwYFSCWKy8RU_YkCcCGKk_BLibh5m8na0I9_8kgeED5XsklbjA&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNwSMoO_vVqDV0gn1z7qBZmgeFhxN9NViB-iFYsplAhJQ&oe=6AE340BE"}, {"file_name": "Screenshots_005.png", "id": "486141502473830", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/75222941_486141505807163_3127839383345353654_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OvJAEt41XmAQ7kNvwGx7OEt&_nc_oc=Adoxdhxgis6CvyrHO_iyO74LbkFlEV_ACpn11c8fqCIEP_trzRCrRedP_PdgCkECQIk&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQORwd8vsKTIk0zAAQbC0RMbCpb2dCYQTRcn85YjURRQJA&oe=6AE35ACD"}, {"file_name": "Screenshots_004.png", "id": "126125999624615", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974608_126126002957948_8632638290137506975_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nUp6edkkv9oQ7kNvwHiNsxN&_nc_oc=AdrbYOeQIx253uY9aopjMZ1w-iSAdtBH4BGCgUJS91AipLJVSeY5cBzinOvwTaQgYaE&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNrTOekYZcAOgxeqf2437GjibaBAcHBxdIxCO58PzGpqw&oe=6AE35C87"}, {"file_name": "Screenshots_007.png", "id": "545909776817911", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/86659754_545909780151244_4010903981250884421_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yUHb4rWWWZkQ7kNvwGNDLN3&_nc_oc=Adpv8Gd3BJtYL17nTL1S1hiHtCanWnbyGGZnMpvO12_sbSGWFUR7XIF7l1gspCAspQk&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPLIcfbeCbe8SGzEUvyizWoRIip2xKNU0_sNsxs6X5GCQ&oe=6AE35FEE"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Gamerz Lab", "keywords": [], "long_description": "Gamerz Lab is a multi-activity, sci-fi themed playground designed to give the users a holistic gaming experience like never before.\n\nThere are two separate zones. The Game Zone offers a virtual game booth featuring a wave based shooting game. Over time more and more game booths will be added, each with exciting new games. With every new game Gamerz Lab will become a completely new experience to explore!\n\nWhenever you want to take a break from Game Zone you can move over to the Relax Zone and chill out. With amazing visuals and micro-activity corners like boxing corner and many more to come with every update will make the Gamerz Lab an unforgettable gaming experience for gamers.\nRelax in the lobby or use the boxing corner to release your inner Mike Tyson.\nGame booths offering different experiences (Shooters etc)\nBreathtaking visuals and amazing gameplay.\n", "short_description": "A multi-activity playground designed to immerse you into a sci-fi world of shooting games along with many more to come!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://dreamerzlab.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Dreamerz Lab Ltd", "support_website_url": null, "website_url": "https://dreamerzlab.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "ARCADE", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "641853910228653"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38982468_1389650384737085_6124558328110054823_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CjtF_Y7VmWAQ7kNvwFk4wZ4&_nc_oc=Adoy29jN_9PkFcpdCNjcAEyE4zKQr453OLqwbIMEmeiXUDq7rI-oQwW_HFhU3F94FW0&_nc_zt=3&_
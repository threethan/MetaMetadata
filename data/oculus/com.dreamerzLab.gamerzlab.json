tViI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AfuuW_Abu3EHE9X0lvHCcZHCg-YjnCAPyYho2QQrJS4h8g&oe=699EEFBE"}, {"file_name": "Screenshots_005.png", "id": "486141502473830", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75222941_486141505807163_3127839383345353654_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=694OTVWGUDkQ7kNvwEPyZzo&_nc_oc=AdkoSwXgxpxTUbPnuSxRCl5OKAUVF9XlxbxBhMzaxgnH1heSGe4r7KChXouiRMvM7qQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_Afu5DgziJh5R3HJfw-v5v4fI-NeGj-KJjSWwVlIA7f-ZpQ&oe=699F09CD"}, {"file_name": "Screenshots_004.png", "id": "126125999624615", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974608_126126002957948_8632638290137506975_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QwAPZ9GWnMoQ7kNvwHQIxLp&_nc_oc=AdmwAUOZN4tM8QdrooaiLJQTwdFilAl9bs0cNuC48joCgjd8lnSJtIMTdc5usxUxUyI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AfsQ2ey_T5SG74rv7EXLDUDMvViCYEh0eJXVpNfoY2j6mQ&oe=699ED347"}, {"file_name": "Screenshots_007.png", "id": "545909776817911", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/86659754_545909780151244_4010903981250884421_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=t5_jeG0a1EIQ7kNvwEu0Jfb&_nc_oc=Adnd_3_sNTc7Td-YVLCQdGHAO5QMeENF9OCtx19gyul-3jc2axngixz_VVNxL1p__fw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_Aft-9j5dyWZvjZp0iGqOLg3Q7jZuwznZHUz_pKf0pfG6Sw&oe=699ED6AE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "527712595035285", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974729_527712598368618_6616314205426690112_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x8Vfim3Pd5AQ7kNvwHRt87Z&_nc_oc=Adl4saLHfGSi-PHgQH0dWKa4Y1w7wULZ5voVR20J2V4S36JBPwEXvxvk3i17IaFVAO0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AfvtnpqjxSrbh90Uf1e5zMCOPV5Smd8EQa4T-26zK6lIFA&oe=699EFC6B"}, "display_name": "Gamerz Lab", "keywords": [], "long_description": "Gamerz Lab is a multi-activity, sci-fi themed playground designed to give the users a holistic gaming experience like never before.\n\nThere are two separate zones. The Game Zone offers a virtual game booth featuring a wave based shooting game. Over time more and more game booths will be added, each with exciting new games. With every new game Gamerz Lab will become a completely new experience to explore!\n\nWhenever you want to take a break from Game Zone you can move over to the Relax Zone and chill out. With amazing visuals and micro-activity corners like boxing corner and many more to come with every update will make the Gamerz Lab an unforgettable gaming experience for gamers.\nRelax in the lobby or use the boxing corner to release your inner Mike Tyson.\nGame booths offering different experiences (Shooters etc)\nBreathtaking visuals and amazing gameplay.\n", "short_description": "A multi-activity playground designed to immerse you into a sci-fi world of shooting games along with many more to come!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://dreamerzlab.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Dreamerz Lab Ltd", "support_website_url": null, "website_url": "https://dreamerzlab.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "ARCADE", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "641853910228653"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://sco
Gs5o&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfuNfeBBoa2SEZfy0-CRQMDSnMOhFQMurw67HdO9NC0c5A&oe=699C4CBE"}, {"file_name": "Screenshots_005.png", "id": "486141502473830", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75222941_486141505807163_3127839383345353654_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TJrbGCrkr24Q7kNvwEUlHzv&_nc_oc=AdmRLUT8-V90YF1T8N81R-j0ObdXRcgIcZiH8T0SNaby0qdKIbHOopdgnF92fdgWZNA&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_Afud8lZeR1_jfoPRqgeBoAA3jd4cdhhdlHXccvg-ERHKRw&oe=699C66CD"}, {"file_name": "Screenshots_004.png", "id": "126125999624615", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974608_126126002957948_8632638290137506975_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QwAPZ9GWnMoQ7kNvwF90on7&_nc_oc=Adk3GxuAeqjpSRRhfaiAxJHFAgk6PseDHf2FerUCvrcZwYAkyNcMzh9nLAmkitPqTPk&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_Afvo_stU6BRmQX9pQlHLxUzLcotN4JUKSMjiU45Tz4rrEQ&oe=699C3047"}, {"file_name": "Screenshots_007.png", "id": "545909776817911", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/86659754_545909780151244_4010903981250884421_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8-WPFO1pWrEQ7kNvwHoaoFo&_nc_oc=AdkhkV9rOm0sJfK9SzhBJ9V3ZxAd56o_mAz4WkYS8IpBpiquEVSVvYV6Mv1SqJPqXBg&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfttU4Q-uaQkKvn2iAMfhQhOHUrPuEpS5foJQp0aQxmDPA&oe=699C33AE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "527712595035285", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974729_527712598368618_6616314205426690112_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s8fzqkRw0iUQ7kNvwFbbGI3&_nc_oc=AdnzTCHaeIwShTnbjY3nc2onSXD_Zc1ZlvbomoDNO5ssDn2uLIa9K3rC4CgSn407EaM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_Afun5yz8zOiyn2vaDAsHf3yYKWPikf0V-Z10-6s-ovlZ0A&oe=699C596B"}, "display_name": "Gamerz Lab", "keywords": [], "long_description": "Gamerz Lab is a multi-activity, sci-fi themed playground designed to give the users a holistic gaming experience like never before.\n\nThere are two separate zones. The Game Zone offers a virtual game booth featuring a wave based shooting game. Over time more and more game booths will be added, each with exciting new games. With every new game Gamerz Lab will become a completely new experience to explore!\n\nWhenever you want to take a break from Game Zone you can move over to the Relax Zone and chill out. With amazing visuals and micro-activity corners like boxing corner and many more to come with every update will make the Gamerz Lab an unforgettable gaming experience for gamers.\nRelax in the lobby or use the boxing corner to release your inner Mike Tyson.\nGame booths offering different experiences (Shooters etc)\nBreathtaking visuals and amazing gameplay.\n", "short_description": "A multi-activity playground designed to immerse you into a sci-fi world of shooting games along with many more to come!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://dreamerzlab.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Dreamerz Lab Ltd", "support_website_url": null, "website_url": "https://dreamerzlab.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "ARCADE", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "641853910228653"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://sco
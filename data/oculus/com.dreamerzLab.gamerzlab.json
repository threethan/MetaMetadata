O&_nc_oc=AdnkiX_M4URqPYGM64tyPy6sLDLAHk2CtDHdkYTO2gwHrDN8xNLkDJn93pQvqxhNfio&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfwSqxwSfAr61ReIR7Bvtr_6Wz2aUp7SKVDpWKBFUSrHrA&oe=69BE93BE"}, {"file_name": "Screenshots_005.png", "id": "486141502473830", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75222941_486141505807163_3127839383345353654_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DTH1c8Xe8hYQ7kNvwH0bWj0&_nc_oc=AdloP8IL1nTVnYEfWesckioPCWHGIcp6XIXpUi6mnl37X0g2k0_U5IXLAggiJbwWfG4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfxNUIEJAJjAL8NuCQbBRzv8Y0P3l3fKeBB-Rr_b-KRL7Q&oe=69BEADCD"}, {"file_name": "Screenshots_004.png", "id": "126125999624615", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974608_126126002957948_8632638290137506975_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HLOWsPqQUqIQ7kNvwF6TB9M&_nc_oc=AdnaneW7NBKTPWRX1W97OXFjCr_inX1zQAhDxdrkwsMS3S-TjbFwMGX0vAF0RE1U-TE&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_Afx_zpvUfDad6dB09mbTWMv8OaWeeIqTUDLrSy3UrYnAdA&oe=69BE7747"}, {"file_name": "Screenshots_007.png", "id": "545909776817911", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/86659754_545909780151244_4010903981250884421_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n7To-Jex7dIQ7kNvwGabA7A&_nc_oc=AdnWn7HA6RBGjp2RNsDzBEHieFlJEdrhHWrVMMY__VcQptZWtZIJh1pV5__radmMEuE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfxdRvCOrt0_yhwIawQ7Sn9H3xdDNa8dGvDMqHXjp0pX8g&oe=69BE7AAE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "527712595035285", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974729_527712598368618_6616314205426690112_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kT_nzjY5rs0Q7kNvwGCYeDC&_nc_oc=AdmvAxSbMwYQCMiPzVly0BjKRU_HsUf6H-y4JFhMJwkPj5APsbDdeTkUasecvTK8Jp8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_Afz11SMBxP7gQwYUjl09bP3kMBMUfX692Y1dcQD4gSGqVQ&oe=69BEA06B"}, "display_name": "Gamerz Lab", "keywords": [], "long_description": "Gamerz Lab is a multi-activity, sci-fi themed playground designed to give the users a holistic gaming experience like never before.\n\nThere are two separate zones. The Game Zone offers a virtual game booth featuring a wave based shooting game. Over time more and more game booths will be added, each with exciting new games. With every new game Gamerz Lab will become a completely new experience to explore!\n\nWhenever you want to take a break from Game Zone you can move over to the Relax Zone and chill out. With amazing visuals and micro-activity corners like boxing corner and many more to come with every update will make the Gamerz Lab an unforgettable gaming experience for gamers.\nRelax in the lobby or use the boxing corner to release your inner Mike Tyson.\nGame booths offering different experiences (Shooters etc)\nBreathtaking visuals and amazing gameplay.\n", "short_description": "A multi-activity playground designed to immerse you into a sci-fi world of shooting games along with many more to come!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://dreamerzlab.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Dreamerz Lab Ltd", "support_website_url": null, "website_url": "https://dreamerzlab.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "ARCADE", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_mo
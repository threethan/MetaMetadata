a&_nc_ohc=_QoTpqt91VgQ7kNvwFBCg2x&_nc_oc=Adrn6Py5TMlWh9LQcOLaORoR6rzLYPhqDpV2ysFPDE2_qfabFTQfkmJhCo7-hXYAYxY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOh3HKRmVdHtY7ReK-7YAwnOGtr5G60ir5mqYKioRQcsA&oe=6AC3D4FE"}, {"file_name": "Screenshots_005.png", "id": "486141502473830", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75222941_486141505807163_3127839383345353654_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WmDDD6XBeLoQ7kNvwFnZEwJ&_nc_oc=Adrlrl7lavgM59LiD-Bw-QGIncb0tWC09iGyYYm76KnlRWNNoIB-u72NSANSWG8n4Lo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNI79DvW4cUaBzjiHAiz3vNpbmzKrB6XJUHSlEAY5E4gA&oe=6AC3B6CD"}, {"file_name": "Screenshots_004.png", "id": "126125999624615", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974608_126126002957948_8632638290137506975_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9f_yUqrz2HIQ7kNvwG0orFI&_nc_oc=AdrTgo62K0qw1vH9CqsYsKAguNouXWf1hlMRgpN6Knk676ONa2QHwqjeVBdDXsWstfE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPLj-v5Wm7tu1a2693CllRiETrz1c27DgaJ3u7zF5cj6w&oe=6AC3B887"}, {"file_name": "Screenshots_007.png", "id": "545909776817911", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/86659754_545909780151244_4010903981250884421_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gnaupUue1G8Q7kNvwEfe7rq&_nc_oc=AdoN9d0aSBYq2x8K9nBwpllzkbWiOyw-xebGIhBovkWpILJoyYhEylkYAw1kgTG4bdk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOgNmLXjMyaFfDFk8VS2204Il40ZRFs67Zu51wJ_mSSMQ&oe=6AC3BBEE"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Gamerz Lab", "keywords": [], "long_description": "Gamerz Lab is a multi-activity, sci-fi themed playground designed to give the users a holistic gaming experience like never before.\n\nThere are two separate zones. The Game Zone offers a virtual game booth featuring a wave based shooting game. Over time more and more game booths will be added, each with exciting new games. With every new game Gamerz Lab will become a completely new experience to explore!\n\nWhenever you want to take a break from Game Zone you can move over to the Relax Zone and chill out. With amazing visuals and micro-activity corners like boxing corner and many more to come with every update will make the Gamerz Lab an unforgettable gaming experience for gamers.\nRelax in the lobby or use the boxing corner to release your inner Mike Tyson.\nGame booths offering different experiences (Shooters etc)\nBreathtaking visuals and amazing gameplay.\n", "short_description": "A multi-activity playground designed to immerse you into a sci-fi world of shooting games along with many more to come!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://dreamerzlab.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Dreamerz Lab Ltd", "support_website_url": null, "website_url": "https://dreamerzlab.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "ARCADE", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "641853910228653"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982468_1389650384737085_6124558328110054823_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UB-8fFPAfa4Q7kNvwFlr9N_&_nc_oc=AdqKE3lPVCixCngM1N7T8CEXA_HQVD3vmOKYWS9OLLuENN84A-7iDCj1ghAFEf0VRsw&_nc_zt=3&_
a&_nc_ohc=PKSwWXvUV08Q7kNvwGwoGIY&_nc_oc=AdrbWRPHDJ2o84VCgoSIlR-AYZMCoGChCPWaTDzAGpSL03HPUoXN6F4jmCZDFo2Cytk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOjRnMo4UgQA5ByDSU2vRj97PJSVYoKeuhH-8CVFeCvZQ&oe=6AC131FE"}, {"file_name": "Screenshots_005.png", "id": "486141502473830", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75222941_486141505807163_3127839383345353654_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7vd2lBtSl4cQ7kNvwGaGcb_&_nc_oc=AdppNRD_IzN6QtQ3_WTBbAxszjYOaa3FIqAwizsQO6vsGNEtcPXu_rS449I4_hwxWb4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPBstgzIfuQaNlgyTZL1tn8BEhHNj0-Ksf-A4LOXBceoQ&oe=6AC113CD"}, {"file_name": "Screenshots_004.png", "id": "126125999624615", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974608_126126002957948_8632638290137506975_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9f_yUqrz2HIQ7kNvwElr1_Y&_nc_oc=AdpEX1zQe6V3z3xi-e_yoJgRovvevFp_l4aPA7FzB872Pa-RKRrAMNmHu_-aYfHFTLk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMsbFQ_u9v-PrpalPKolfpo-tm9eRNo54WLkZ_LzEKfjA&oe=6AC11587"}, {"file_name": "Screenshots_007.png", "id": "545909776817911", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/86659754_545909780151244_4010903981250884421_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=39B0Ri834QcQ7kNvwE2VSEX&_nc_oc=Adr7KmEF4UiAOM4W1q8hZyK86Rg2s_cBGDJoJoIiA4QPDmv48CbOx0rlfPzBGKfrEYw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNYiWdk3cLKxnxN6u9yGJ6TWliQy8vM1I3ECbGcm92jTw&oe=6AC118EE"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Gamerz Lab", "keywords": [], "long_description": "Gamerz Lab is a multi-activity, sci-fi themed playground designed to give the users a holistic gaming experience like never before.\n\nThere are two separate zones. The Game Zone offers a virtual game booth featuring a wave based shooting game. Over time more and more game booths will be added, each with exciting new games. With every new game Gamerz Lab will become a completely new experience to explore!\n\nWhenever you want to take a break from Game Zone you can move over to the Relax Zone and chill out. With amazing visuals and micro-activity corners like boxing corner and many more to come with every update will make the Gamerz Lab an unforgettable gaming experience for gamers.\nRelax in the lobby or use the boxing corner to release your inner Mike Tyson.\nGame booths offering different experiences (Shooters etc)\nBreathtaking visuals and amazing gameplay.\n", "short_description": "A multi-activity playground designed to immerse you into a sci-fi world of shooting games along with many more to come!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://dreamerzlab.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Dreamerz Lab Ltd", "support_website_url": null, "website_url": "https://dreamerzlab.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "ARCADE", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "641853910228653"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982468_1389650384737085_6124558328110054823_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UB-8fFPAfa4Q7kNvwEIjgLW&_nc_oc=AdqT7M5WmzNi6grurPV4bQKd1pDEc64ajD_q5N_eFMkkaXMXQ0SNg1ENFsvtPXyYY8g&_nc_zt=3&_
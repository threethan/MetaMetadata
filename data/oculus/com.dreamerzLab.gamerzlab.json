=6e7a0a&_nc_ohc=UT8RxXdzcs8Q7kNvwGhK7Y4&_nc_oc=Adqxl-65J_5ahqtAZfb_PyQvXeah3SC-rHR963__rJAnNn6qu57TFpKf1uGmB9xJMSA&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKvaQ-Hc5w4O3-ppM_YSoUXmQVKoPZS7SCtV7JttZIAVg&oe=6AA93EBE"}, {"file_name": "Screenshots_005.png", "id": "486141502473830", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/75222941_486141505807163_3127839383345353654_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D9QMIr8DCbkQ7kNvwH6_CqQ&_nc_oc=AdrPx-d4QujP_oG8Eop8gMFeH3ZAvd-K6GnnCIN70qV0gwSExOdFhOiA75cVyjHRouM&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIDpmT6TpXt4YFL0jZnUmJ3vbT16z_XVzSR7-TkHOCI7w&oe=6AA958CD"}, {"file_name": "Screenshots_004.png", "id": "126125999624615", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/38974608_126126002957948_8632638290137506975_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lHk36TIFyboQ7kNvwFH4LtK&_nc_oc=AdoIpBUrgRH_ifkyjIA67DMp6JUFh49U3QKwBRg4QETgCOR6838CacnONy0oFsNz3Ug&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIR8Z82eSeuZ4epCGB5JCFoNm_1iyS_1wHYjFCUNFBh7A&oe=6AA95A87"}, {"file_name": "Screenshots_007.png", "id": "545909776817911", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/86659754_545909780151244_4010903981250884421_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=17booddkv8EQ7kNvwGcdnvq&_nc_oc=AdoIj8KUioZEV95PaKSb-zG5Ue2HIUlABvePcaEVYBYtI71gIMX-yUaoJbwMVmumbSQ&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLKfuKqVrOnKN4EWt6zWaa383fW2e8bbOHSr54We2trZA&oe=6AA95DEE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "527712595035285", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/38974729_527712598368618_6616314205426690112_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tya6FXhOiSQQ7kNvwH3sqs9&_nc_oc=Adp8ilv60r77HF7tERdCRlfmHxZlBhvextmaMwjmdpZ-kCbabTWqqCW7rT7lL3Dg_5g&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKUCRcR9vo8185mjtR3VjFLdVM5owcM382bLOpYycUYbg&oe=6AA94B6B"}, "display_name": "Gamerz Lab", "keywords": [], "long_description": "Gamerz Lab is a multi-activity, sci-fi themed playground designed to give the users a holistic gaming experience like never before.\n\nThere are two separate zones. The Game Zone offers a virtual game booth featuring a wave based shooting game. Over time more and more game booths will be added, each with exciting new games. With every new game Gamerz Lab will become a completely new experience to explore!\n\nWhenever you want to take a break from Game Zone you can move over to the Relax Zone and chill out. With amazing visuals and micro-activity corners like boxing corner and many more to come with every update will make the Gamerz Lab an unforgettable gaming experience for gamers.\nRelax in the lobby or use the boxing corner to release your inner Mike Tyson.\nGame booths offering different experiences (Shooters etc)\nBreathtaking visuals and amazing gameplay.\n", "short_description": "A multi-activity playground designed to immerse you into a sci-fi world of shooting games along with many more to come!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://dreamerzlab.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Dreamerz Lab Ltd", "support_website_url": null, "website_url": "https://dreamerzlab.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "ARCADE", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCA
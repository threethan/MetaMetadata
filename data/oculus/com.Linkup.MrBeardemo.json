I9cYOUzjx4Q-MOWsUqx-dj7i_wGybN8GOnbDw0om8&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8-Z_PPXAkyaxYO4k0PvULEZmIsGZxX2ps6vpUhSKyf6w&oe=6A3D51E7"}, {"file_name": "6.png", "id": "1554215455404395", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75223476_1554215458737728_3126569158777550704_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PpzzIKRRdy8Q7kNvwFuilPs&_nc_oc=AdouQOBcc27vqvNt6SXHPxFF6F4BMB5QpMZG8zRLSWpMV7WY3x3RmL-4ZkFcDdg0p9I&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-xcxQIQGqZc1RMJBwKJNzTtm_9jT2Kw4tl-v9g3grnoA&oe=6A3D5814"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u82f1\u6587demo_cover_2560x1440.png", "id": "365783149234537", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974709_365783152567870_1527010217848546644_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AD7k4wKb2XAQ7kNvwEqzzPH&_nc_oc=AdohVGZL_jsakSAWsqJUjvEtKoEkXVOnP1Ge0iXd7pqV645lVOsMpEnEaLmlwwWRLm8&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9nD6JlFoKAuVIG2xtvBzfUEQqi5mb3wt21PTFYpRJUmg&oe=6A3D5007"}, "display_name": "Mr Bear's Bizarre Adventure DEMO", "keywords": [], "long_description": "This is the legendary about Mr. Bear, who challenging skilled opponents from various countries: \nthe guardian warrior at the Inari Shrine, the skeleton king in the dark dungeon and the pirate captain from the Caribbean sea....\nWe even adapted different music styles for each themed level: traditional Japanese sounds, Shamisen music, Lo-Fi, HipHop, Trap, and Reggae!\n\n----------------Game Introduction-----------------\nPlayers need to use different tactics to counter various enemy attack patterns. Engage in close combat, deflect projectiles from a distance, knock away explosives with both hands, and dodge bombs by sidestepping....\nBy the way, pay more attention to the corresponding colors and the direction of slashes. The color determines which sword you need to use.\n", "short_description
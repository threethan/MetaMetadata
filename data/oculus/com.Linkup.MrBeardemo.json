o use different tactics to counter various enemy attack patterns. Engage in close combat, deflect projectiles from a distance, knock away explosives with both hands, and dodge bombs by sidestepping....\nBy the way, pay more attention to the corresponding colors and the direction of slashes. The color determines which sword you need to use.\n", "short_description": "This is a paradise for  rhythm and ACT lover. (It's a one level DEMO of Mr Bear's Bizarre Adventure.)\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://linkupxr.oss-cn-shenzhen.aliyuncs.com/Common/PrivacyPolicyofLinkupLLC.pdf", "developer_terms_of_service_url": null, "publisher_name": "LINK-UP IMMERSIVE", "support_website_url": null, "website_url": "https://smallpdf.com/cn/file#s=8e7b33c1-0816-4520-b58e-db7628037da0", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1672577396871977"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "zh_CN"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "6816984311710838"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "276692785372465"}]}, "baseline_offer": {"id": "276692785372465"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1701313200, "status": "PUBLISHED", "id": "276692785372465"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "6817270718348864", "version": "1.0.5"}, "id": "740685
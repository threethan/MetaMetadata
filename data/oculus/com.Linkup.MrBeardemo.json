zOEuusElOkc2W0ztqBiT5HHYZbfAGwm3PSoGuHoSc&_nc_zt=3&_nc_ht=scontent-lhr8-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4TwFp0PyyEiQWEbLhA0J0dGLeQy34i-spuxJOdyNeTkw&oe=6A107EE7"}, {"file_name": "6.png", "id": "1554215455404395", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/75223476_1554215458737728_3126569158777550704_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mFRr6qxjI-IQ7kNvwFxgcC0&_nc_oc=AdrEEG3VX1E-6WkBBdVhr5IVf-Fr0IDPcGvxRfKknstSeL0H8MqP4sXYR0_JC8QRgqE&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4PZtJWidhOVr8gbK3XzvogP8NQTPBwF5pMtJuLcfSm0Q&oe=6A104CD4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u82f1\u6587demo_cover_2560x1440.png", "id": "365783149234537", "uri": "https://scontent-lhr8-2.oculuscdn.com/v/t64.5771-25/38974709_365783152567870_1527010217848546644_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jov72GOhi4cQ7kNvwFwves4&_nc_oc=AdoUd6VPBNvhes5aoecjMlo2bYDtsKC6by-y0F4k8qADKrEQgD4asL994u25_msG47s&_nc_zt=3&_nc_ht=scontent-lhr8-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6NqeBxFL2brVB5YQaNfzkVlpKsw-j3OjkER5Mj5ocwzA&oe=6A107D07"}, "display_name": "Mr Bear's Bizarre Adventure DEMO", "keywords": [], "long_description": "This is the legendary about Mr. Bear, who challenging skilled opponents from various countries: \nthe guardian warrior at the Inari Shrine, the skeleton king in the dark dungeon and the pirate captain from the Caribbean sea....\nWe even adapted different music styles for each themed level: traditional Japanese sounds, Shamisen music, Lo-Fi, HipHop, Trap, and Reggae!\n\n----------------Game Introduction-----------------\nPlayers need to use different tactics to counter various enemy attack patterns. Engage in close combat, deflect projectiles from a distance, knock away explosives with both hands, and dodge bombs by sidestepping....\nBy the way, pay more attention to the corresponding colors and the direction of slashes. The color determines which sword you need to use.\n", "short_description": "This is a paradise for  rhythm and ACT lover. (It's a one level DEMO of Mr Bear's Bizarre Adventure.)\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://linkupxr.oss-cn-shenzhen.aliyuncs.com/Common/PrivacyPolicyofLinkupLLC.pdf", "developer_terms_of_service_url": null, "publisher_name": "LINK-UP IMMERSIVE", "support_website_url": null, "website_url": "https://smallpdf.com/cn/file#s=8e7b33c1-0816-4520-b58e-db7628037da0", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1672577396871977"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "zh_CN"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "6816984311710838"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "276692785372465"}]}, "baseline_offer": {"id": "276692785372465"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1701313200, "status": "PUBLISHED", "id": "276692785372465"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "6817270718348864", "version": "1.0.5"}, "id": "740685514580383", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "6816984305044172", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "6817270718348864"}, "release_s
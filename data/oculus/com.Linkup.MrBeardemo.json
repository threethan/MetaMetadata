GLY7mCt4ruI3GvzRMcRL75-KyzzdDpuCQPHn79Trk&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af46VoevvefYeptlwt97rTEdGooZaBi0Ut7rVE6FbwN05w&oe=69FF2327"}, {"file_name": "6.png", "id": "1554215455404395", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75223476_1554215458737728_3126569158777550704_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=trZ9yDzybLIQ7kNvwFOM_fb&_nc_oc=AdqE5O8y4SX9WeN0BliF6dlz0KKQMkJqrsay3bCPmUIl_emv2AQs6HD7QGjieaZcwUA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4A9KVzehbBXRe2gTNG1b2s5Xs2Z-8UNayKHOoXH8_33g&oe=69FF2954"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u82f1\u6587demo_cover_2560x1440.png", "id": "365783149234537", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974709_365783152567870_1527010217848546644_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AuvdWC2aszcQ7kNvwG-VNPX&_nc_oc=Adom0tvE5CWE_e06dVaeTySseFid-3cMoLdNCMz8IR48ahWqgNQ6ifCph4MPAuzTz10&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6Wu9H2nff_b6j1s15txhuvRY51d-xzs6R1Hh-i2EqEdw&oe=69FF2147"}, "display_name": "Mr Bear's Bizarre Adventure DEMO", "keywords": [], "long_description": "This is the legendary about Mr. Bear, who challenging skilled opponents from various countries: \nthe guardian warrior at the Inari Shrine, the skeleton king in the dark dungeon and the pirate captain from the Caribbean sea....\nWe even adapted different music styles for each themed level: traditional Japanese sounds, Shamisen music, Lo-Fi, HipHop, Trap, and Reggae!\n\n----------------Game Introduction-----------------\nPlayers need to use different tactics to counter various enemy attack patterns. Engage in close combat, deflect projectiles from a distance, knock away explosives with both hands, and dodge bombs by sidestepping....\nBy the way, pay more attention to the corresponding colors and the direction of slashes. The color determines which sword you need to use.\n", "short_description
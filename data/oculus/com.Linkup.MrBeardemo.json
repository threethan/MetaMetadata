cC8vjh2RlcQT7IcyXxlRHczel1_rrV0o-oDp3Z9c8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCeNiKcGJBEhUeodyC0fvcYO3bWxQhVTwUgzAU9ZZFWUg&oe=6A64A6A7"}, {"file_name": "6.png", "id": "1554215455404395", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75223476_1554215458737728_3126569158777550704_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_NUhWw_xg3YQ7kNvwGieNFU&_nc_oc=AdoajxNILNJKKHP0AU3iOySeLcW1wXL-uHqR7j3x1Cs-yeaSwpQECy8AfE-dKejTx94&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCA4Tg_7PHrv1ybRkJ0koZyzpE5dirlMBaeZwFQMLwzHw&oe=6A64ACD4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u82f1\u6587demo_cover_2560x1440.png", "id": "365783149234537", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974709_365783152567870_1527010217848546644_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NZKzNEaHFEUQ7kNvwHrNhRo&_nc_oc=Adqk-FOA-F0tYJWZ1oXbWuY4roZOn0s9FyFPMYiQAkhGfrWvgsapgR7cz4Y4MepKb7s&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBNVN-mVzDtpu-SRC-ZZMf593Q3-IaSkggSNsXFFwbQGA&oe=6A64A4C7"}, "display_name": "Mr Bear's Bizarre Adventure DEMO", "keywords": [], "long_description": "This is the legendary about Mr. Bear, who challenging skilled opponents from various countries: \nthe guardian warrior at the Inari Shrine, the skeleton king in the dark dungeon and the pirate captain from the Caribbean sea....\nWe even adapted different music styles for each themed level: traditional Japanese sounds, Shamisen music, Lo-Fi, HipHop, Trap, and Reggae!\n\n----------------Game Introduction-----------------\nPlayers need to use different tactics to counter various enemy attack patterns. Engage in close combat, deflect projectiles from a distance, knock away explosives with both hands, and dodge bombs by sidestepping....\nBy the way, pay more attention to the corresponding colors and the direction of slashes. The color determines which sword you need to use.\n", "short_description
wWhw0LasAQKZcX7T-doYHsQBuwi-DqkRIeuHYjltg&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_QG30TdeNKzuOlB5crqouX0k5R5Pi4y7w3NVG52lPajg&oe=6A32C5E7"}, {"file_name": "6.png", "id": "1554215455404395", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/75223476_1554215458737728_3126569158777550704_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vdIAZA4YwYUQ7kNvwGzve-q&_nc_oc=AdomGX9LkunX2mWAIityrNMOShuydqzlTCW8S58W8m3MLbQ2ixHOk0XuFFXOTmoqT3s&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9vEkIpLW1jjGl-FdLFpaoHp8aj2ljT8CsvA_0Gy4Xjrw&oe=6A3293D4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u82f1\u6587demo_cover_2560x1440.png", "id": "365783149234537", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38974709_365783152567870_1527010217848546644_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9HLInErgDSgQ7kNvwG8-NXr&_nc_oc=Adr_KJNKYrYZPj0nSfChNcI-xOwC3Xqydj48SR0i71ztIzO5tQvQtOso1CqgYnUmrXY&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8HEkuJebw9HL9ljRogIgWv_DNauj44y-R-TXuLEQVK-Q&oe=6A32C407"}, "display_name": "Mr Bear's Bizarre Adventure DEMO", "keywords": [], "long_description": "This is the legendary about Mr. Bear, who challenging skilled opponents from various countries: \nthe guardian warrior at the Inari Shrine, the skeleton king in the dark dungeon and the pirate captain from the Caribbean sea....\nWe even adapted different music styles for each themed level: traditional Japanese sounds, Shamisen music, Lo-Fi, HipHop, Trap, and Reggae!\n\n----------------Game Introduction-----------------\nPlayers need to use different tactics to counter various enemy attack patterns. Engage in close combat, deflect projectiles from a distance, knock away explosives with both hands, and dodge bombs by sidestepping....\nBy the way, pay more attention to the corresponding colors and the direction of slashes. The color determines which sword you need to use.\n", "short_description
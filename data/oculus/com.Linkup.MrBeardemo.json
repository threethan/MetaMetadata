7vGt9nxVZtyHka7VFpU4HALh3MHLOBJCTnhxlqocw&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2H4xpAPe78zVthD5C52Ms-BweehsJceaXDTyAkC48K9w&oe=69D4F327"}, {"file_name": "6.png", "id": "1554215455404395", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75223476_1554215458737728_3126569158777550704_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=26m1FcsdhJ4Q7kNvwH9vofX&_nc_oc=AdqtgH_1tkN7ABJ1vLebFAiPsemhpPrzISluzLFkCgRHeo_QZ8MDz3Vc6RE9p754o24&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3B7ukX0uJYvpY3qLOhtYBZF_FBn-rj6uFRAaNuCK7KhA&oe=69D4F954"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u82f1\u6587demo_cover_2560x1440.png", "id": "365783149234537", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974709_365783152567870_1527010217848546644_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0sx6-AQc-BIQ7kNvwEIlDiq&_nc_oc=Adr5nMp9OTLcPusZt5beT1rC3i8hqnyc0amkYBaT1gVFPpsqvnOMa4xD5p-cwfzMpXY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0V_VJxdl_a7KdENCKGT9IPfsXX6vJ6hHXxeP0Tq7Dl1Q&oe=69D4F147"}, "display_name": "Mr Bear's Bizarre Adventure DEMO", "keywords": [], "long_description": "This is the legendary about Mr. Bear, who challenging skilled opponents from various countries: \nthe guardian warrior at the Inari Shrine, the skeleton king in the dark dungeon and the pirate captain from the Caribbean sea....\nWe even adapted different music styles for each themed level: traditional Japanese sounds, Shamisen music, Lo-Fi, HipHop, Trap, and Reggae!\n\n----------------Game Introduction-----------------\nPlayers need to use different tactics to counter various enemy attack patterns. Engage in close combat, deflect projectiles from a distance, knock away explosives with both hands, and dodge bombs by sidestepping....\nBy the way, pay more attention to the corresponding colors and the direction of slashes. The color determines which sword you need to use.\n", "short_description
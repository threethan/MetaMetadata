ds": ["DinosaurShooting", "JurassicGame", "DinoHunter", "VRShootingGame", "DinosaurSurvival"], "long_description": "Jurassic Dinosaur Shooting: Dino Hunter throws you into a dangerous prehistoric world where survival depends on your aim, reflexes, and courage. Explore vast Jurassic environments filled with aggressive and unpredictable dinosaurs, each with unique behaviors and attack patterns. Armed with powerful weapons, you must track, shoot, and survive against some of the deadliest creatures to ever walk the earth.\nExperience intense shooting combat as dinosaurs charge, hunt, and ambush you from every direction. From dense jungles to open wildlands, every mission challenges your skills and pushes you closer to becoming the ultimate dino hunter. Whether you prefer fast-paced action or tactical encounters, the game delivers nonstop adrenaline and immersive gameplay.\nFeatures:\nRealistic and action-packed dinosaur shooting\n\n\nMultiple deadly dinosaur species\n\n\nPowerful weapons and intense combat\n\n\nImmersive Jurassic environments\n\n\nThrilling survival-focused gameplay\n\n\nStep into the Jurassic era, lock and load, and prove you have what it takes to dominate the wild.\n", "short_description": "Shoot ferocious dinosaurs in a deadly Jurassic world. Become the ultimate dino hunter."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/horizonsgames-privacy-policy/home", "developer_terms_of_service_url": null, "publisher_name": "HorizonsGames", "support_website_url": null, "website_url": "https://sites.google.com/view/horizonsgames-com/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "459781504968480"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "p
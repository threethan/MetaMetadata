ntent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_loNSEAxm4QEmL41UY5j8dHonvjVGcjhNLJoRSp1zWOg&oe=6A4529B5"}, {"file_name": "SampleScene_1440p_14.09.2025_20-25-08.png", "id": "1969771883774355", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491820558_1969771887107688_5366948344961662546_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xRK5YSLXjyEQ7kNvwEZY1X4&_nc_oc=AdqOcZ4lfC-_uoYfHWNGa_5YuWRhw780xElQqCvl8tMP9am7-vpSuCIYPZ2Gfqgdq3Y&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_DOYDLfFrYcJSkYV_k77d0P1xvzbjDoQlRHe1SzakW3Q&oe=6A45311C"}, {"file_name": "SampleScene_1440p_14.09.2025_20-25-25.png", "id": "2029113514568988", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491822931_2029113517902321_9093124804286802751_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S2993lpWZ3YQ7kNvwFEx0S-&_nc_oc=AdrYL__cTUeCeOnyA7YNOwzNJjl08LcdA9xSGl_z8XgNpMM0FdR43E05H6JW4FmP6Rc&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-New5TSSPmNi3_QxF076PnT_ewEr3gUrqt6Z9BQHMi_w&oe=6A451828"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Spot Runners", "keywords": ["spot", "runners"], "long_description": "Spot Runners is a fun and fast fan game inspired by Gorilla Tag. Run, jump, and explore different game modes with friends. Whether you're relaxing, solving puzzles, or getting a little scared, there's always something exciting to do.\n\n\ud83c\udfec The Mall\nEarn Spotty Coins by playing and visit the Mall to grab awesome cosmetics! Try on new skins and outfits to show off your style. New items drop often, so there\u2019s always something fresh to check out.\n\n\ud83c\udfae Game Modes\n\u2022 \t\ud83c\udf34 Islands \u2013 A sunny place to climb, chat, and explore. Just chill and have fun.\n\u2022 \t\ud83c\udfe6 Robbery \u2013 Grab the loot and sneak out before anyone catches you!\n\u2022 \t\ud83d\udc7b Horror \u2013 Spooky maps with creepy sounds and surprises. Stay brave and keep moving!\n\u2022 \t\ud83d\udd10 Find the Code \u2013 Search for hidden numbers and unlock the next levels!\n\u2022 \t\ud83d\udd75\ufe0f Spot Search \u2013 Explore the map and find special hidden spots. No timer, just a relaxing search.\n\nAre you ready to hop into a wonderful world? Spot Runners is the place for you! \ud83d\ude80", "short_description": "Become a Spot!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/17zlNBy5FmIi13ruTxEAeZd0jXJNZMo4hs_cle37A3BI/edit?usp=drivesdk", "developer_terms_of_service_url": null, "publisher_name": "Spot The Cat", "support_website_url": null, "website_url": "https://sites.google.com/view/spot-runners-meta?usp=sharing", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24304992429172663"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "655497163840462"}]}, "baseline_offer": {"id": "655497163840462"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1759600800, "status": "PUBLISHED", "id": "655497163840462"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "24773700385635196", "version": "0.2.1"}, "id": "3942712749301172", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "Android
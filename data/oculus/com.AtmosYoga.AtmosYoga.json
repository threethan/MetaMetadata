QT2T-VJOmJo157DwOaiUfNXTxv3DKjoyRCESWi3TpPwOc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPqoWLIPGieSeDTQMoO3RzztqcUgNRX-KDJtqXqE4kd7A&oe=6ADE0213"}, {"file_name": "4.png", "id": "652314943841424", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473391749_652314950508090_4180483691639325521_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oXP3KAQzCmsQ7kNvwHrStQS&_nc_oc=Adrm0AM3TqXe086LwrAvUV0RhO6OoB3I7NASyXRra1uhiHObAtweLTqh9pjLg_mIKM4&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNhu6euEDIDQEGNfI3LPCicLq4CU9t5aCGryLL7Pe4S6g&oe=6ADDF764"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Feature-IMAGES.png", "id": "1816441682447965", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391837_1816441685781298_4377169359903712780_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m5RWxthUU9UQ7kNvwF7JbOj&_nc_oc=AdqB5szzsdSxWS2hGgT1mWTszNpwN-G2Jkvzivc0fnm_GZSEEmBcyJIsidtcOIBXDoU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOG-bRRKg9d-ImScnZ9LtwRVghfZyeoTs1GkKHwGNBCoA&oe=6ADE07A9"}, "display_name": "Atmos Yoga", "keywords": ["Yoga", "Meditation", "Fitness", "Wellness", "Mindfulness"], "long_description": "Immerse yourself in the ultimate yoga experience with Atmos Yoga, a VR app designed to bring peace, mindfulness, and well-being into your life. Whether you\u2019re looking to unwind, improve flexibility, or simply escape into a serene environment, our collection of high-quality 360\u00b0 yoga videos will guide you on a journey of relaxation and self-care.\n\nWith a simple and intuitive interface, getting started is effortless. Just log in or register, and you'll gain access to a curated library of immersive yoga sessions, each set in breathtaking virtual environments. These guided practices are perfect for all skill levels, whether you're a beginner exploring the basics or an experienced yogi deepening your practice.\n\nAtmos Yoga offers a unique blend of mindfulness and technology, allowing you to disconnect from stress and reconnect with your inner self. Transport yourself to stunning landscapes, follow expert-led instructions, and embrace a truly immersive way to practice yoga\u2014all within the comfort of your VR headset.\n\nStep into a new world of tranquility and wellness. Download Atmos Yoga today and start your VR yoga journey!\n\n", "short_description": "Immerse yourself in a peaceful yoga journey with Atmos Yoga, featuring a collection of 360\u00b0 yoga videos designed to help you relax, meditate, and improve flexibility in a stunning virtual environment."}]}, "developer_name": null, "developer_privacy_policy_url": "https://lnk.bio/AtmosYoga", "developer_terms_of_service_url": null, "publisher_name": "Rcade LLC", "support_website_url": null, "website_url": "https://lnk.bio/AtmosYoga", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}, {"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9848138545231927"}}]}, "scheduled_offers": {"count": 4, "nodes": [{"status": "PUBLISHED", "id": "983939207579966"}, {"status": "PUBLISHED", "id": "2078603352701082"}, {"status": "PUBLISHED", "id": "1003144861884798"}, {"status": "PUBLISHED", "id": "689673156824835"}]}, "baseline_offer": {"id": "983939207579966"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1780565760, "status": "PUBLISHED", "id": "983939207579966"}]}, "liveChannel": {"nodes": [{"lat
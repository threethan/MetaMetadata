p73qXazj7Ang&oe=6B0852F8"}, {"file_name": "5.png", "id": "1580535289257373", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/473393158_1580535292590706_1501570922151070051_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qWSNcluhU9sQ7kNvwFxL3qJ&_nc_oc=Adp27jFOgyEiRZbj_Pk5jtiihvTdW4UP1qHL9RXf8MiM95XDuAcHxeqnGvdoJD_tAMU&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRGMos99iN3OV9zl0Y9tPutIjqYzFF4QBzl7q-40n-gAw&oe=6B086A53"}, {"file_name": "4.png", "id": "652314943841424", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/473391749_652314950508090_4180483691639325521_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vA1nDcDR73EQ7kNvwHCw8SL&_nc_oc=Ado71W_VxqwNSIgiwUMhsfNStkSH1LwqfoAt2Ov5fyt-LHLNXu6fPf5bbXKfSPXBbK0&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQkZ8LB0sBXm5m99dlz-fDNFB0fHgJifkAfCFRmS7gmTA&oe=6B085FA4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Feature-IMAGES.png", "id": "1816441682447965", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/473391837_1816441685781298_4377169359903712780_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9-xJbNjS70QQ7kNvwHdzCHS&_nc_oc=AdpM6Z8vR7S8EvvMpxoJNknXG1f9vb7uiHv8lBtNa1iZIYc2nPPjZwCH7ZSwVnJ34aQ&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRT_MCTmDZM9cTnIsa8523Hb32ASdICOQ6oOtaJ5746fw&oe=6B086FE9"}, "display_name": "Atmos Yoga", "keywords": ["Yoga", "Meditation", "Fitness", "Wellness", "Mindfulness"], "long_description": "Immerse yourself in the ultimate yoga experience with Atmos Yoga, a VR app designed to bring peace, mindfulness, and well-being into your life. Whether you\u2019re looking to unwind, improve flexibility, or simply escape into a serene environment, our collection of high-quality 360\u00b0 yoga videos will guide you on a journey of relaxation and self-care.\n\nWith a simple and intuitive interface, getting started is effortless. Just log in or register, and you'll gain access to a curated library of immersive yoga sessions, each set in breathtaking virtual environments. These guided practices are perfect for all skill levels, whether you're a beginner exploring the basics or an experienced yogi deepening your practice.\n\nAtmos Yoga offers a unique blend of mindfulness and technology, allowing you to disconnect from stress and reconnect with your inner self. Transport yourself to stunning landscapes, follow expert-led instructions, and embrace a truly immersive way to practice yoga\u2014all within the comfort of your VR headset.\n\nStep into a new world of tranquility and wellness. Download Atmos Yoga today and start your VR yoga journey!\n\n", "short_description": "Immerse yourself in a peaceful yoga journey with Atmos Yoga, featuring a collection of 360\u00b0 yoga videos designed to help you relax, meditate, and improve flexibility in a stunning virtual environment."}]}, "developer_name": null, "developer_privacy_policy_url": "https://lnk.bio/AtmosYoga", "developer_terms_of_service_url": null, "publisher_name": "Rcade LLC", "support_website_url": null, "website_url": "https://lnk.bio/AtmosYoga", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}, {"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9848138545231927"}}]}, "scheduled_offers": {"count": 4, "nodes": [{"status": "PUBLISHED", "id": "983939207
qav89IQ7kNvwEMCjP3&_nc_oc=AdpS6t-hRDkQI7ZHc7aZCZ7D-JmVR_luz7-1QwkuU5z6-WBUjSPqsbuiwcrIKHcb30I&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQMTQsnA2FrjueBjeLlTTzwlurGOzdVz_f-lMMVYAYQyA&oe=6AF748CF"}, {"file_name": "Timeline 1_01_00_23_05.png", "id": "1049531741413429", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491823802_1049531744746762_2903260908017452096_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ybrnaZlBSqgQ7kNvwGQt-QI&_nc_oc=AdpHpEnQTIDKmcywae-3v1tahIDyDtPi--sgIKcCaPu2utUfCUpqzIzqnAqWhxPQcqw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQcaeDK59kRRE45a4ed9STQyxQjBz9O2-KelT-dQTH_9Q&oe=6AF716FD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Main.png", "id": "1307133664740293", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491824671_1307133668073626_4351051376452849843_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I5qx51Sf-tUQ7kNvwE3DPSD&_nc_oc=AdpdhcOAbrFGbSEokI7prhDScRBVUnyZTHy-G5wIxlas4mG9F8BeSCTcvWEfK65QRV8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQsYeCNElowTsekNVjRxP0VPijUGNaDH8iB_T04BsocnA&oe=6AF717A0"}, "display_name": "WASTE", "keywords": ["psychological", "roguelite", "indie"], "long_description": "# DEMO RELEASE\n\n**WASTE** is a blend of \"Operation Blockade\", uncomfortable thoughts, confusion and existential dread.\n\nMake your own gun, shoot the planes down and most importantly: **absolutely don't think about anything else**. \n\nIt doesn't matter if you understand what is going on ~~inside~~ around you after all.\n\n\n# DISCLAIMER\n\nDo you feel like the game is hard, unfair or too vague and you just don't know what you are supposed to do?\n\nGood.\n\nRemember - it's your choice. You **can always** just keep your brain turned off and scroll the feed instead. Who cares?\n\n-\n\n# A few words that most will skip\n\nIt took me 360 days to make this demo.\n\nI worked alone, mostly offline. I did not want to use ready assets and I have serious, visceral reaction to anything AI, so I made everything myself.\nThat means:\n- I drew every picture and texture\n- I wrote every shader\n- I wrote every line of code\n- I wrote every line of text\n- I designed and recorded every sound\n- I played, composed and recorded every note\n- I modeled and animated every 3D asset\n- I designed and drew each font, letter by letter\n\nand did absolutely everything else with my own hands.\n\nAnd it was significantly more draining than I anticipated, but here is the fruit, for better or for worse.", "short_description": "Do you ever ask yourself if something you did was a waste?\nA waste of time?\nOr a waste of money?\nAre you sure you missed these shots?\nDid you even pull the trigger?\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://policy.rivers-of.ink/", "developer_terms_of_service_url": null, "publisher_name": "Rivers of Ink", "support_website_url": null, "website_url": "https://rivers-of.ink/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}, {"id": "275629210202852"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1347084428491476"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491825546_1848095739541202_7728540669594447014_n.png?stp=dst-png_s360x360&_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zMNu0ehfq3
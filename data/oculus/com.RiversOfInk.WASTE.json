.5771-25/491824671_1307133668073626_4351051376452849843_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I5qx51Sf-tUQ7kNvwE3DPSD&_nc_oc=AdpdhcOAbrFGbSEokI7prhDScRBVUnyZTHy-G5wIxlas4mG9F8BeSCTcvWEfK65QRV8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQsYeCNElowTsekNVjRxP0VPijUGNaDH8iB_T04BsocnA&oe=6AF717A0"}, "display_name": "WASTE", "keywords": ["psychological", "roguelite", "indie"], "long_description": "# DEMO RELEASE\n\n**WASTE** is a blend of \"Operation Blockade\", uncomfortable thoughts, confusion and existential dread.\n\nMake your own gun, shoot the planes down and most importantly: **absolutely don't think about anything else**. \n\nIt doesn't matter if you understand what is going on ~~inside~~ around you after all.\n\n\n# DISCLAIMER\n\nDo you feel like the game is hard, unfair or too vague and you just don't know what you are supposed to do?\n\nGood.\n\nRemember - it's your choice. You **can always** just keep your brain turned off and scroll the feed instead. Who cares?\n\n-\n\n# A few words that most will skip\n\nIt took me 360 days to make this demo.\n\nI worked alone, mostly offline. I did not want to use ready assets and I have serious, visceral reaction to anything AI, so I made everything myself.\nThat means:\n- I drew every picture and texture\n- I wrote every shader\n- I wrote every line of code\n- I wrote every line of text\n- I designed and recorded every sound\n- I played, composed and recorded every note\n- I modeled and animated every 3D asset\n- I designed and drew each font, letter by letter\n\nand did absolutely everything else with my own hands.\n\nAnd it was significantly more draining than I anticipated, but here is the fruit, for better or for worse.", "short_description": "Do you ever ask yourself if something you did was a waste?\nA waste of time?\nOr a waste of money?\nAre you sure you missed these shots?\nDid you even pull the trigger?\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://policy.rivers-of.ink/", "developer_terms_of_service_url": null, "publisher_name": "Rivers of Ink", "support_website_url": null, "website_url": "https://rivers-of.ink/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}, {"id": "275629210202852"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1347084428491476"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1119033467126538"}]}, "baseline_offer": {"id": "1119033467126538"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1791303360, "status": "PUBLISHED", "id": "1119033467126538"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1338800412653211", "version": "1.1"}, "id": "1620886029821588", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1324302867436299", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1338800412653211"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1620886029821588"}]}, "change_log": null, "created_date": 1790676484, "id": "1338800412653211", "version": "1.1", "version_code": 14, "release_status": "RE
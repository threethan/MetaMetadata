U7TUmbrCIVyX5LFzPiCMuDq31RSyNr2A&oe=6B0C80C3"}, {"file_name": "Screenshot_4_vendor.png", "id": "1781908172855329", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491821704_1781908176188662_5050244316243648891_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NX5YAz3jLYkQ7kNvwF9BwEw&_nc_oc=AdqLst2IetSrqs0NVzHYeTIulcaPWyjoaTM2Ut_A7N7myVV3fmXJ7ZVIabunJ2KYlbg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQRfMwO84laJCjMt_YarEdygYGU9YjL_JoIFF_LoDCxIA&oe=6B0C7C6E"}, {"file_name": "Screenshot_5_shark.png", "id": "854458867728962", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823783_854458874395628_2464021885547419386_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WGGawzvQtf4Q7kNvwEfO4yq&_nc_oc=Ado0jxLFFTeV_4YPhq8Pfx01__pmOH1RRoWOWS7quTxobO6idAprzN11NttdGHgfKog&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRR_MeghWIVRQWN56pjIDGChWD94cYtsvUzeo70GRpWYw&oe=6B0C576E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TrailerCover_2560x1440.png", "id": "1770635870886824", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491828008_1770635874220157_6445692976293732098_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hNx2sEN96WMQ7kNvwGqEFuW&_nc_oc=Adp86qtSfAZ_cG_-6ZDtEBMd_XzfoO3IKRNBy2Dr2I63Lwc0ADJG-yuqfyue9hf-gkk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSbGfETG4tZ9jbu_GqRtVgy9elPyZsyCx_I5YYX9cTQ-w&oe=6B0C747B"}, "display_name": "Lifeguard Simulator VR", "keywords": ["Lifeguard", "Beach", "Rescue", "Simulator", "Swimming"], "long_description": "Welcome to your beach. You are the lifeguard, and every visitor is your responsibility.\n\nEYES ON THE WATER\nVisitors swim, sunbathe, party and get into trouble on their own. Watch the sea from your tower, check them with binoculars and set the beach flags as the waves grow. Blow your whistle or grab the megaphone when someone swims too far.\n\nSAVE LIVES WITH YOUR HANDS\nSwim out with your own arm strokes or race there on a jet ski, throw a ring buoy and tow the swimmer back to the sand. Kneel down and give real CPR: rescue breaths, then compressions in rhythm. Clear a choking airway with the Heimlich manoeuvre, treat jellyfish stings and punch a shark on the nose to send it away.\n\nKEEP THE PEACE\nReunite lost children with their parents, pick up litter and catch pickpockets by grabbing and shaking them until the stolen wallet drops.\n\nBUILD YOUR BEACH\nEarn money from every shift. Rent out sun loungers, put up trash bins, hire helper lifeguards and open a beach bar and a DJ booth. Upgrade your swimming, your jet ski and your staff. Each day ends with a report of your rescues, earnings and reputation.\n\nMADE FOR VR\nPhysics-based hands, a smart watch on your wrist for tips and settings, a guided first shift, and comfort options: snap or smooth turning and a comfort vignette. English and Turkish.", "short_description": "Grab your whistle and run the beach in VR! Spot drowning swimmers, swim or race out on a jet ski, tow them ashore and bring them back with real CPR. Scare off sharks, treat jellyfish stings, find lost kids and catch pickpockets with your own hands. Earn money, rent out sun loungers, hire helper lifeguards, open a beach bar and a DJ booth, and keep your beach safe from morning to sunset."}]}, "developer_name": null, "developer_privacy_policy_url": "https://tolgakalaycioglu.com/totosgame/PrivacyPolicy.html", "developer_terms_of_service_url": null, "publisher_name": "Totos Games", "support_website_url": null, "website_url": "https://tolgakalaycioglu.com/totosgame/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "1990104051447093"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "interne
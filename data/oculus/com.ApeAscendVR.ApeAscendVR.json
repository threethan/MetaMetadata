ng", "id": "880520681489847", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/499304938_880520684823180_6767530358724916088_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Qk2leoXDbNEQ7kNvwFWU5F5&_nc_oc=AdoYjv2pBKeuGevobOA8oMenbWN1eJdY0mPWM3L0XS1FPgor9IQv5VohDAUtqLxCuL0&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH4OmQ2FOuKrHgsZm29UYdNBzM1S0StNWXCG0n5_NiIvw&oe=6A859727"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Ape Ascend VR", "keywords": ["fangame", "vr", "ape", "ascend"], "long_description": "Ape Ascend VR is a fast, energetic VR movement game where your arms are your only way to move. Push off surfaces, swing through the air, and chain powerful movements as you explore a growing set of dynamic environments.\n\nDash through lush forest maps, launch yourself across wide canyons, and master momentum-based traversal designed to feel fluid, physical, and incredibly fun. Every jump, climb, and launch rewards skill and creativity, making each run feel different from the last.\n\nBuilt for players who love freedom of movement and expressive gameplay, Ape Ascend VR focuses on smooth physics-based locomotion, replayable spaces, and pure movement fun.\n\nApe Ascend VR is a fan-made VR experience inspired by arm-powered locomotion mechanics. It is not affiliated with or endorsed by any official brand or developer.", "short_description": "Leap, swing, and launch yourself through forests, canyons, and more in this fast-paced, arm-powered VR movement game."}]}, "developer_name": "Ape Ascend Official", "developer_privacy_policy_url": "https://sites.google.com/view/gorilliusvr/home", "developer_terms_of_service_url": null, "publisher_name": "Ape Ascend Official", "support_website_url": null, "website_url": "https://sites.google.com/view/gorillius-vr/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}
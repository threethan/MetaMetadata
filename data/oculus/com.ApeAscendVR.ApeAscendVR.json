b49lH5CTNkh-1PVBU9lupzSdebGxGFRHzdFDaY8aINuuBzQ8ESq7SFatr_kxA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWW0MDXiBVT4BqrXDLflo882RYEES-9sKP4xRWTEMnfuw&oe=6B1054E5"}, {"file_name": "Ape Ascend_Custom..._19.02.2026_15-44-04.png", "id": "880520681489847", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499304938_880520684823180_6767530358724916088_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hh2qm5hVZ_kQ7kNvwF_N7AD&_nc_oc=AdqOONIT2RbHscgnY2NYwk23ZB8k--IQaCCknF5Gksk2O984zUm1zMpPREj0pV8ujE4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWMyvYo6W9_BlZEtzk7zOFAQC36The2cSghMVh5moVAqw&oe=6B103CE7"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Ape Ascend VR", "keywords": ["fangame", "vr", "ape", "ascend"], "long_description": "Ape Ascend VR is a fast, energetic VR movement game where your arms are your only way to move. Push off surfaces, swing through the air, and chain powerful movements as you explore a growing set of dynamic environments.\n\nDash through lush forest maps, launch yourself across wide canyons, and master momentum-based traversal designed to feel fluid, physical, and incredibly fun. Every jump, climb, and launch rewards skill and creativity, making each run feel different from the last.\n\nBuilt for players who love freedom of movement and expressive gameplay, Ape Ascend VR focuses on smooth physics-based locomotion, replayable spaces, and pure movement fun.\n\nApe Ascend VR is a fan-made VR experience inspired by arm-powered locomotion mechanics. It is not affiliated with or endorsed by any official brand or developer.", "short_description": "Leap, swing, and launch yourself through forests, canyons, and more in this fast-paced, arm-powered VR movement game."}]}, "developer_name": "Ape Ascend Official", "developer_privacy_policy_url": "https://sites.google.com/view/gorilliusvr/home", "developer_terms_of_service_url": null, "publisher_name": "Ap
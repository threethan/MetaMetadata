_ohc=_mpAAhuTuv4Q7kNvwG2ZDGz&_nc_oc=AdozyFSbK7rw2rMFC24YSpolKeXD4KF7Z5wdAydeOR2atM9nC3Mm0Jx1ejW05I6U6UU&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=8&oh=00_Afzhjawy3FVyJaSfzlyj_MGasmlq7p8jk_8BGK-wUVyuYg&oe=69C127A7"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Ape Ascend VR", "keywords": ["fangame", "vr", "ape", "ascend"], "long_description": "Ape Ascend VR is a fast, energetic VR movement game where your arms are your only way to move. Push off surfaces, swing through the air, and chain powerful movements as you explore a growing set of dynamic environments.\n\nDash through lush forest maps, launch yourself across wide canyons, and master momentum-based traversal designed to feel fluid, physical, and incredibly fun. Every jump, climb, and launch rewards skill and creativity, making each run feel different from the last.\n\nBuilt for players who love freedom of movement and expressive gameplay, Ape Ascend VR focuses on smooth physics-based locomotion, replayable spaces, and pure movement fun.\n\nApe Ascend VR is a fan-made VR experience inspired by arm-powered locomotion mechanics. It is not affiliated with or endorsed by any official brand or developer.", "short_description": "Leap, swing, and launch yourself through forests, canyons, and more in this fast-paced, arm-powered VR movement game."}]}, "developer_name": "Ape Ascend Official", "developer_privacy_policy_url": "https://sites.google.com/view/gorilliusvr/home", "developer_terms_of_service_url": null, "publisher_name": "Ape Ascend Official", "support_website_url": null, "website_url": "https://sites.google.com/view/gorillius-vr/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null
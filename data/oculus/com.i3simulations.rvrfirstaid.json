il": {"file_name": "landscape.png", "id": "2281582042331229", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491823351_2281582045664562_575662638644256904_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=91jjT5YYpnMQ7kNvwFzI3TV&_nc_oc=AdppK_YlLoC5aagRqu_qmKdgqneRCy16l7oQ3d2o-y-8PdMHrUSzMT3_phQfuzC9oi0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQpIHzuwGtfbws8Yma2LC_-rBcfxZSb-JXJtdVlc16Lag&oe=6AFDC0C2"}, "display_name": "Resuscitation VR for First Aid", "keywords": [], "long_description": "SUBSCRIPTION REQUIRED\nThis app requires an i3 Connect subscription to use, which is only available to registered medical professionals. Ensure you have i3 Connect credentials before use. Use the contact form at i3simulations.com for details.\n\nResuscitation VR for First Aid allows various professions or bystanders to practice first aid skills in a context and environment relatable to them. Practice life saving skills such as CPR and anaphylaxis response while acting under pressure.", "short_description": "SUBSCRIPTION REQUIRED\nThis app requires an i3 Connect subscription to use, which is only available to registered medical professionals. Ensure you have i3 Connect credentials before use. Use the contact form at i3simulations.com for details.\n\nResuscitation VR for First Aid allows various professions or bystanders to practice first aid skills in a context and environment relatable to them. Practice life saving skills such as CPR and anaphylaxis response while acting under pressure."}]}, "developer_name": "i3 Simulations", "developer_privacy_policy_url": "https://i3simulations.com/privacy-policy-i3-connect/", "developer_terms_of_service_url": null, "publisher_name": "i3 Simulations", "support_website_url": "https://i3simulations.freshdesk.com/", "website_url": "https://i3simulations.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "co
-25/75210394_1318878445387274_6176980718200868564_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=paqI3y21Y4UQ7kNvwHllNtI&_nc_oc=Adr8IjT5EUmr4Iq92WNM84mHPoZhQlzjXwtG9j1DytKqzVG59VbN_X4pVcDI0yqG1DU&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7CZGXFQr07SZ6LVs-Yw-US7SzZEZzQDc97Y_tpvo4DRA&oe=6A1707F7"}, {"file_name": "2560x1440 Scav.png", "id": "1162782191780296", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75222943_1162782195113629_7416011512675274723_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PEsdnd4mfZcQ7kNvwH05Y6V&_nc_oc=AdqTI6vcZzUDczW-XexB9LWdOMWpuYapTHY6PzEGbgJHznsn1Y78McCWqBK0xAIdips&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af66b5Y0wrCgb1dpydtd9pB7gRtp_b5pmfn4zrXElVL9Ew&oe=6A16F9A5"}, {"file_name": "2560x1440 Tutorial.png", "id": "654280353253476", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/86631741_654280356586809_6153754460625730001_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hdvZOQgSdQQQ7kNvwEXLjqV&_nc_oc=AdqTL6FslvgXkAfC-cEKaHzM8iDblJZPhDl1wXl0SGmFKFmeWo1m2lNSOmiRNsbMopg&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6yf9cumrURNdof9ZVsQ4Rqlr4pRB6vbFLrz0YSalv4BQ&oe=6A16EB84"}, {"file_name": "2560x1440 Pomeline.png", "id": "272026032126611", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/57566679_272026035459944_1201933327488969144_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xK1g1VTSf88Q7kNvwG1noRh&_nc_oc=AdqOIwtDdIP9DtoFq2UgKSRZLNzzzc_hisiAv5qXlJgGSGtoT0haD-hOroomk69vQL0&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5SAU7eEs8gquW3qRvoHnTmbwl-AX59eSTBoSz8_j4yNQ&oe=6A16F711"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Space Salvage Teaser Video Thumbnail.png", "id": "1438772683523307", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38984446_1438772686856640_8300171731412456751_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A9NR4ab1jd4Q7kNvwEyLmRL&_nc_oc=AdoQBdG0pUNDokHX-WNICTsfv8EMh1HF0SS_Xp45X0rle1KjQKgNbhoRC4-pExnDMC8&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4h0yZ5qjoOz1LnAO2KlLtshbGSO0d9c-sI715oKjqjMg&oe=6A16ECCB"}, "display_name": "Space Salvage", "keywords": ["space", "scifi", "star", "funny", "laser"], "long_description": "Space Salvage is a darkly comic, 80's sci-fi themed, VR space flight, combat and refuse collection game.\n\nSkilfully manoeuver your space-pod through 30 beautifully rendered, dynamic, inter-planetary crash sites.\n\nParticipate in races, help factions reclaim what is theirs, and explore the galaxy to earn credits.  Use your credits to upgrade your pod with new weapons, such as the rail gun, or fancy gadgets, to make it stand out from the rest.\n\nNavigate the colorful and varied environments with the advice of your enthusiastic but amoral ship computer. Destroy lurking mines and fight angry drones, evil corporate stooges, and space pirates.\n\nAnd remember: in space, no one can hear you clean", "short_description": "Space Salvage is a darkly comic, 80's sci-fi themed, VR space flight, combat and refuse collection game.\n\nSkilfully manoeuver your space-pod through 30 beautifully rendered, dynamic, inter-planetary crash sites.\n\nEarn credits and upgrade your pod with new weapons and gadgets.\n\nUse your laser to destroy lurking mines and fight angry drones, evil corporate stooges and space pirates - all the while following the advice of your enthusiastic but amoral ship computer."}]}, "developer_name": null, "developer_privacy_policy_url": "https://fruitysystems.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Fruity Systems", "support_website_url": "https://fruitysystems.com/support/", "website_url": "https://fruitysystems.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "82193423677916
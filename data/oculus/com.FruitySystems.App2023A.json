-25/75210394_1318878445387274_6176980718200868564_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=t5fbslBfOW4Q7kNvwFDjR4U&_nc_oc=AdoRJM5pl5Kp86eRi_TZkfmf0G2XxYgA8qWTff8L-J1cm5n8YjRTRvsvwxL3QEyjXEA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAsxtmrhgW82IoJHh_7wnjbN_AEY15Ewss1D-X18aRJgA&oe=6A5E00B7"}, {"file_name": "2560x1440 Scav.png", "id": "1162782191780296", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75222943_1162782195113629_7416011512675274723_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZswtsU07XW4Q7kNvwF_jk9-&_nc_oc=Adr-mdy-OjmpM467rd22GKd2aaup32hJATDRIp8JsxPD-b6M7SlU7vCo94P4W26XEPY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDS8bZY9OWEGcUq80LwbRol_IgVgs_HoxbdPvJ-eXjgUA&oe=6A5E2AA5"}, {"file_name": "2560x1440 Tutorial.png", "id": "654280353253476", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/86631741_654280356586809_6153754460625730001_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yPlmZ44AiPAQ7kNvwHnbsbr&_nc_oc=AdpJ6XgmexcJiO1FvA1LE9R04UXO5Fh-fGw6BIzKl-4URs5uSMj2KwLidO7dSo65e-E&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAToMOvTU-_RbCs7X0z5k1K5dgwDJf3wfnKr1VRPzC7pQ&oe=6A5E1C84"}, {"file_name": "2560x1440 Pomeline.png", "id": "272026032126611", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/57566679_272026035459944_1201933327488969144_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LsDVdFZVFMoQ7kNvwHsqkmp&_nc_oc=Ado1x375LFJFGOy7RRPlDT5GEuhj6LUqPL8h5IA-BB4tW_s4lTahL10ikDmALVhDYgg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD4sFnOkV6r6BflERb-GtkYZCPLYd1GHaM_7iCvIx2iCA&oe=6A5E2811"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Space Salvage Teaser Video Thumbnail.png", "id": "1438772683523307", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38984446_1438772686856640_8300171731412456751_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gepFSNm5iwAQ7kNvwG-n1Yr&_nc_oc=AdrH2Taj45rGNNKSxhbmpN1R7IPG9WWQwt-ML2Fhstdl-JPdDi4zS-ryihs4xbLUbYQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAuzPGpeVZVYdOpg4Nkz2CgQ_zCtVl3wqlJkMPc3ZtEXQ&oe=6A5E1DCB"}, "display_name": "Space Salvage", "keywords": ["space", "scifi", "star", "funny", "laser"], "long_description": "Space Salvage is a darkly comic, 80's sci-fi themed, VR space flight, combat and refuse collection game.\n\nSkilfully manoeuver your space-pod through 30 beautifully rendered, dynamic, inter-planetary crash sites.\n\nParticipate in races, help factions reclaim what is theirs, and explore the galaxy to earn credits.  Use your credits to upgrade your pod with new weapons, such as the rail gun, or fancy gadgets, to make it stand out from the rest.\n\nNavigate the colorful and varied environments with the advice of your enthusiastic but amoral ship computer. Destroy lurking mines and fight angry drones, evil corporate stooges, and space pirates.\n\nAnd remember: in space, no one can hear you clean", "short_description": "Space Salvage is a darkly comic, 80's sci-fi themed, VR space flight, combat and refuse collection game.\n\nSkilfully manoeuver your space-pod through 30 beautifully rendered, dynamic, inter-planetary crash sites.\n\nEarn credits and upgrade your pod with new weapons and gadgets.\n\nUse your laser to destroy lurking mines and fight angry drones, evil corporate stooges and space pirates - all the while following the advice of your enthusiastic but amoral ship computer."}]}, "developer_name": null, "developer_privacy_policy_url": "https://fruitysystems.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Fruity Systems", "support_website_url": "https://fruitysystems.com/support/", "website_url": "https://fruitysystems.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "82193423677916
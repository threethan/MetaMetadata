-25/75210394_1318878445387274_6176980718200868564_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B0OP7Aygl-QQ7kNvwHkK8NQ&_nc_oc=AdpCaTGZdMilq1fbqibDahEWAmvRLfvpbeth_UxbaRPmKBCMrEKCWHu0aDKQIHKGadc&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9ZSjhUpevBdLDmZDNHPIj7U9kyywaoiEq_8ol70TKsTQ&oe=6A3408F7"}, {"file_name": "2560x1440 Scav.png", "id": "1162782191780296", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75222943_1162782195113629_7416011512675274723_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SoH2qSB_DUoQ7kNvwFJnaHw&_nc_oc=AdpfLVo4dMxraFMABUeXae3F4meW7d8tnrCi4KjSGBnfnDaM3X8qY6e2_Frc5gpfiQQ&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_c4hZc4kFTg6iovlJvja40PegBlA8toNmJhXee6q2Xuw&oe=6A33FAA5"}, {"file_name": "2560x1440 Tutorial.png", "id": "654280353253476", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/86631741_654280356586809_6153754460625730001_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NM-AyN6HHPEQ7kNvwG_JCMk&_nc_oc=AdqRH4SUhQ4oJIGY5m6qxMOno99b19VClKg49oDchmGODg3hegnB0lkbS4yx6z3Ukts&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-tBjLybW7PscKKZ4F4mSb7ecNJmIlpgW5FhHGdcut1Og&oe=6A33EC84"}, {"file_name": "2560x1440 Pomeline.png", "id": "272026032126611", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/57566679_272026035459944_1201933327488969144_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WB8DQnejeIUQ7kNvwEWlgAO&_nc_oc=AdoYIKVKrd8Uhm1bBGS4o1d74eHvjThTyNOdIpH0rJ0J72Iitm3H8SsqzEBCjkYjGTc&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_NhXBCn2sMRwKs7yNSGFGq9boldR7Zzj0BbXMSNoheTQ&oe=6A33F811"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Space Salvage Teaser Video Thumbnail.png", "id": "1438772683523307", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38984446_1438772686856640_8300171731412456751_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i7KaR9gyLG0Q7kNvwEzYccK&_nc_oc=AdpWaWDf0JGwu2danhKDoZXbB92CUlgu5xOaWTvzBIkZOJggs3SzH7zrYPb6828sWTQ&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8hrNJsqHHpOre51PeWOYodjZtCOQSJK7L3US5ufx2tkw&oe=6A33EDCB"}, "display_name": "Space Salvage", "keywords": ["space", "scifi", "star", "funny", "laser"], "long_description": "Space Salvage is a darkly comic, 80's sci-fi themed, VR space flight, combat and refuse collection game.\n\nSkilfully manoeuver your space-pod through 30 beautifully rendered, dynamic, inter-planetary crash sites.\n\nParticipate in races, help factions reclaim what is theirs, and explore the galaxy to earn credits.  Use your credits to upgrade your pod with new weapons, such as the rail gun, or fancy gadgets, to make it stand out from the rest.\n\nNavigate the colorful and varied environments with the advice of your enthusiastic but amoral ship computer. Destroy lurking mines and fight angry drones, evil corporate stooges, and space pirates.\n\nAnd remember: in space, no one can hear you clean", "short_description": "Space Salvage is a darkly comic, 80's sci-fi themed, VR space flight, combat and refuse collection game.\n\nSkilfully manoeuver your space-pod through 30 beautifully rendered, dynamic, inter-planetary crash sites.\n\nEarn credits and upgrade your pod with new weapons and gadgets.\n\nUse your laser to destroy lurking mines and fight angry drones, evil corporate stooges and space pirates - all the while following the advice of your enthusiastic but amoral ship computer."}]}, "developer_name": null, "developer_privacy_policy_url": "https://fruitysystems.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Fruity Systems", "support_website_url": "https://fruitysystems.com/support/", "website_url": "https://fruitysystems.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "82193423677916
-25/75210394_1318878445387274_6176980718200868564_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ap3VcNQXEOYQ7kNvwHlBb92&_nc_oc=AdpI6bLWETnFb1fD3cxI9ycFOpzoIKI7Rqfb4uIvb_Gq7B3gI5V_H9Zhpm-lxQOGkDE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJl9sbLzYvx_UiMV8EmkHTiJm7Rysg4_rd2aDXRRefAvQ&oe=6ABBD377"}, {"file_name": "2560x1440 Scav.png", "id": "1162782191780296", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75222943_1162782195113629_7416011512675274723_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EVuf-pup1MMQ7kNvwGJcjjc&_nc_oc=Ado16GyV-K87qc9jC4pd7axm3KzI2y2_ZMGMhPzKAPyH7FvY65alMTB0oIWcgw1u9x4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL9ICaB0TD_0iXxoZf1w42UuRhmVhQF9Q4_aB9YTlmxfg&oe=6ABBC525"}, {"file_name": "2560x1440 Tutorial.png", "id": "654280353253476", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/86631741_654280356586809_6153754460625730001_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ezUFj5Kf_GYQ7kNvwFr8qgq&_nc_oc=Adpnvg_hY8jd1aVTjw4-FOGm1nmID3xcVe1Y4AbzntBJR6HFwn09vPGCJmpz8Zk1meQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI2U5lVkFfAOVVp42y0c2QuAxKrdn2nhzpcz0RLfY7n3w&oe=6ABBB704"}, {"file_name": "2560x1440 Pomeline.png", "id": "272026032126611", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/57566679_272026035459944_1201933327488969144_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IGfoTzWNKhYQ7kNvwGNo9iW&_nc_oc=Adp8lppHZ4U2bATc8urmKvEESBp5GfTXXW9yxolmDgf24r6pFSp8HjLY8ZJuh84HOB8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIGU2YzScfX3zMbRhIjlDyIoGpG9nLAIEOnlTh0yDVNpg&oe=6ABBC291"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Space Salvage Teaser Video Thumbnail.png", "id": "1438772683523307", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38984446_1438772686856640_8300171731412456751_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ms9sChOScpwQ7kNvwEYgL4s&_nc_oc=Adp2GcnnE08Nh-VDKgC5to56C0psLMer0-094egQ41KAGYqpRcN04Mi2UI-2vjj7Hm0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKf5xOzF2vQ2wCj1SsrLq2IiTVQIA5XSZe8gM3_QlZicw&oe=6ABBB84B"}, "display_name": "Space Salvage", "keywords": ["space", "scifi", "star", "funny", "laser"], "long_description": "Space Salvage is a darkly comic, 80's sci-fi themed, VR space flight, combat and refuse collection game.\n\nSkilfully manoeuver your space-pod through 30 beautifully rendered, dynamic, inter-planetary crash sites.\n\nParticipate in races, help factions reclaim what is theirs, and explore the galaxy to earn credits.  Use your credits to upgrade your pod with new weapons, such as the rail gun, or fancy gadgets, to make it stand out from the rest.\n\nNavigate the colorful and varied environments with the advice of your enthusiastic but amoral ship computer. Destroy lurking mines and fight angry drones, evil corporate stooges, and space pirates.\n\nAnd remember: in space, no one can hear you clean", "short_description": "Space Salvage is a darkly comic, 80's sci-fi themed, VR space flight, combat and refuse collection game.\n\nSkilfully manoeuver your space-pod through 30 beautifully rendered, dynamic, inter-planetary crash sites.\n\nEarn credits and upgrade your pod with new weapons and gadgets.\n\nUse your laser to destroy lurking mines and fight angry drones, evil corporate stooges and space pirates - all the while following the advice of your enthusiastic but amoral ship computer."}]}, "developer_name": null, "developer_privacy_policy_url": "https://fruitysystems.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Fruity Systems", "support_website_url": "https://fruitysystems.com/support/", "website_url": "https://fruitysystems.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "82193423677916
-25/75210394_1318878445387274_6176980718200868564_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9VFTlIY3l5kQ7kNvwFeO0xK&_nc_oc=AdpCGHKENTF_m4NbHcfTRzhC5PVfNV9_ar7QU2sYBAFaNKIO88Y9ovrj2FJIR20ZuTA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6MiaoaOud9e4sXXQJo6AI3b_vgC9lUB-ckuBAM9bZDXg&oe=6A05E477"}, {"file_name": "2560x1440 Scav.png", "id": "1162782191780296", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75222943_1162782195113629_7416011512675274723_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LB4wAKZpMakQ7kNvwHPtSLu&_nc_oc=Adq0hQfdMDuiApl2XSAKucLunKTw_TLPdUxfGkDlPQP-N6pEbNXtZcyLz3adQb-tTkg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6ZISNwHyeePDW8eb6L_heRsuWZDp9N9Q_zgn0Od-wDmA&oe=6A05D625"}, {"file_name": "2560x1440 Tutorial.png", "id": "654280353253476", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/86631741_654280356586809_6153754460625730001_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rBN9RPU0oggQ7kNvwFAe4zo&_nc_oc=Adojejx6mmxPwy7RmyfkbIfTuEe2NaRi7QV-RHHFzUi7MhXVNubNpEr8pDieZ1e2xx8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6GoPUtSkDKEcGaqh4xGhPDteff75xygcmN8kZ9RCoE-Q&oe=6A05C804"}, {"file_name": "2560x1440 Pomeline.png", "id": "272026032126611", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/57566679_272026035459944_1201933327488969144_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S1qAARhKhjAQ7kNvwENq1J2&_nc_oc=AdpwbraA2DZLpp7F2UkU2-XldYI9iKxrg4-HIlwvX5rkKA2GrJ1n1NOiD7fcQOJ6aM0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5iIiAQkuNqrWk8mbKotzbA5rjG7YDWqNzLVT1mArLwzA&oe=6A05D391"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Space Salvage Teaser Video Thumbnail.png", "id": "1438772683523307", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38984446_1438772686856640_8300171731412456751_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oH-dcOywvEMQ7kNvwHsRDg4&_nc_oc=AdqAUHPiBohjVnDlfe2KMyGMkAyjqG3o_Nj72s84tkJbLIw8MEfSi7KAz14pVjekq18&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5Ob_Kz2h4IvFkPNS0hI4dzjHuWxwZhWklwV_M_m1z_lQ&oe=6A05C94B"}, "display_name": "Space Salvage", "keywords": ["space", "scifi", "star", "funny", "laser"], "long_description": "Space Salvage is a darkly comic, 80's sci-fi themed, VR space flight, combat and refuse collection game.\n\nSkilfully manoeuver your space-pod through 30 beautifully rendered, dynamic, inter-planetary crash sites.\n\nParticipate in races, help factions reclaim what is theirs, and explore the galaxy to earn credits.  Use your credits to upgrade your pod with new weapons, such as the rail gun, or fancy gadgets, to make it stand out from the rest.\n\nNavigate the colorful and varied environments with the advice of your enthusiastic but amoral ship computer. Destroy lurking mines and fight angry drones, evil corporate stooges, and space pirates.\n\nAnd remember: in space, no one can hear you clean", "short_description": "Space Salvage is a darkly comic, 80's sci-fi themed, VR space flight, combat and refuse collection game.\n\nSkilfully manoeuver your space-pod through 30 beautifully rendered, dynamic, inter-planetary crash sites.\n\nEarn credits and upgrade your pod with new weapons and gadgets.\n\nUse your laser to destroy lurking mines and fight angry drones, evil corporate stooges and space pirates - all the while following the advice of your enthusiastic but amoral ship computer."}]}, "developer_name": null, "developer_privacy_policy_url": "https://fruitysystems.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Fruity Systems", "support_website_url": "https://fruitysystems.com/support/", "website_url": "https://fruitysystems.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "82193423677916